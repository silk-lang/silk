import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.fiber { Fiber, Cancelled, Failure, Outcome, Success }
import silk.local_scheduler { LocalScheduler, StalledError }
import silk.monotonic_clock { MonotonicClock }
import silk.ownership { Drop }
import silk.scheduler { Scheduler, TaskIdExhaustedError }
import silk.shared { Shared }
import silk.system_clock { SystemClock }
import silk.system_clock { Instant }

struct ParentClock { mark: Instant }
effect fn parentNow(self: &mut ParentClock) -> Instant {
  return SystemClock.make(SystemClock.seconds(&self.mark), SystemClock.nanoseconds(&self.mark))
}
effect fn parentResolution(self: &mut ParentClock) -> u64 { return 1 }
effect fn parentWaitUntil(self: &mut ParentClock, deadline: Instant) -> () {
  self.mark = move deadline
  return ()
}
effect fn parentWaitFor(self: &mut ParentClock, duration: u64) -> () {
  let deadline = MonotonicClock.deadlineAfter(&self.mark, duration)
  return run parentWaitUntil(move self, move deadline)
}
impl MonotonicClock for ParentClock {
  now: ParentClock.parentNow
  getResolution: ParentClock.parentResolution
  waitUntil: ParentClock.parentWaitUntil
  waitFor: ParentClock.parentWaitFor
}

struct NoNestedFiber {}
struct StoredNestedFiber { fiber: Fiber<i32, never> }
struct NestedFiberSlot { phase: NoNestedFiber | StoredNestedFiber }
struct Audit { released: i32 }
fn release(audit: &mut Audit) -> i32 {
  audit.released = audit.released + 1
  return audit.released
}
fn released(audit: &Audit) -> i32 { return audit.released }
struct NestedTimerLifetime { kind: i32 audit: Shared<Audit> }

fn nestedTimerActivated() -> () { return () }
fn nestedTimerReleased() -> () { return () }
fn nestedFiberPublished() -> () { return () }
fn nestedOuterTerminating() -> () { return () }
fn nestedOuterReturned() -> () { return () }
fn nestedCancellationObserved() -> () { return () }
fn resumedUnexpectedly() -> () { return () }

impl Drop for NestedTimerLifetime {
  fn drop(self: &mut NestedTimerLifetime) -> () {
    if self.kind == 1 {
      let count = Shared<Audit>.withMut<i32>(&self.audit, release)
      nestedTimerReleased()
    }
    return ()
  }
}

fn installNestedFiber(
  self: &mut NestedFiberSlot,
  fiber: Fiber<i32, never>,
) -> () {
  let previous = Intrinsic.replace(self.phase, StoredNestedFiber { fiber: move fiber })
  drop previous
  nestedFiberPublished()
  return ()
}

fn takeNestedFiber(self: &mut NestedFiberSlot) -> NoNestedFiber | StoredNestedFiber {
  return Intrinsic.replace(self.phase, NoNestedFiber {})
}

fn requireNestedFiber(selected: NoNestedFiber | StoredNestedFiber) -> Fiber<i32, never> {
  return match move selected {
    NoNestedFiber {} => missingNestedFiber()
    StoredNestedFiber { fiber } => move fiber
  }
}

fn missingNestedFiber() -> Fiber<i32, never> {
  let invalid = 1 / 0
  return missingNestedFiber()
}

effect fn nestedTimer(audit: Shared<Audit>) -> i32
? &mut Scheduler | &mut MonotonicClock {
  let lifetime = NestedTimerLifetime { kind: 1, audit: move audit }
  nestedTimerActivated()
  run MonotonicClock.waitFor(1000000000000)
  drop lifetime
  resumedUnexpectedly()
  return -1
}

effect fn innerRoot(slot: Shared<NestedFiberSlot>, audit: Shared<Audit>) -> i32
! OutOfMemoryError | TaskIdExhaustedError
? &mut Scheduler | &mut MonotonicClock {
  let timer = run Fiber<i32, never>.forkChild(nestedTimer(move audit))
  let published = Shared.withMut(&slot, installNestedFiber(move timer))
  run Fiber.yieldNow()
  drop slot
  return 0
}

effect fn nestedSchedulerTask(slot: Shared<NestedFiberSlot>, audit: Shared<Audit>) -> i32
! OutOfMemoryError | TaskIdExhaustedError | StalledError
? &mut MonotonicClock {
  let mut inner = LocalScheduler.make()
  return run LocalScheduler.execute(&mut inner, innerRoot(move slot, move audit))
}

effect fn outerRoot(slot: Shared<NestedFiberSlot>, audit: Shared<Audit>) -> i32
! OutOfMemoryError | TaskIdExhaustedError | StalledError
? &mut Scheduler | &mut MonotonicClock {
  let inner = run Fiber<
    i32,
    OutOfMemoryError | TaskIdExhaustedError | StalledError,
  >.forkChild(nestedSchedulerTask(move slot, move audit))
  drop inner
  run Fiber.yieldNow()
  nestedOuterTerminating()
  return 13
}

fn observeCancellation(outcome: Outcome<i32, never>) -> bool {
  let Outcome<i32, never> { value } = move outcome
  return match move value {
    Success<i32> { value: success } => false
    Failure<never> { error } => move error
    Cancelled {} => recordCancellation()
  }
}

fn recordCancellation() -> bool {
  nestedCancellationObserved()
  return true
}

effect fn observeRoot(fiber: Fiber<i32, never>) -> bool
? &mut Scheduler | &mut MonotonicClock {
  return observeCancellation(run Fiber<i32, never>.await(move fiber))
}

effect fn scenario() -> i32
! OutOfMemoryError | TaskIdExhaustedError | StalledError
? &mut MonotonicClock {
  let mut scheduler = LocalScheduler.make()
  let mut allocator = Allocator.systemAllocatorProvider()
  let slot = run Shared<NestedFiberSlot>.make(NestedFiberSlot {
    phase: NoNestedFiber {},
  }) |> Effect.provideMut<Allocator>(&mut allocator)
  let audit = run Shared<Audit>.make(Audit { released: 0 })
    |> Effect.provideMut<Allocator>(&mut allocator)
  let nested = run LocalScheduler.execute(
    &mut scheduler,
    outerRoot(
      Shared<NestedFiberSlot>.clone(&slot),
      Shared<Audit>.clone(&audit),
    ),
  )
  nestedOuterReturned()
  let nestedFiber = requireNestedFiber(Shared.withMut(&slot, takeNestedFiber))
  drop slot
  let cancelled = run LocalScheduler.execute(
    &mut scheduler,
    observeRoot(move nestedFiber),
  )
  let releaseCount = Shared<Audit>.with<i32>(&audit, released)
  drop audit
  if nested != 13 { return 1 }
  if !cancelled { return 2 }
  if releaseCount != 1 { return 3 }
  return 42
}

effect fn recover(
  error: OutOfMemoryError | TaskIdExhaustedError | StalledError,
) -> i32 {
  return match move error {
    OutOfMemoryError {} => -91
    TaskIdExhaustedError {} => -92
    StalledError {} => -93
  }
}

pub fn main() -> i32 {
  let mut clock = ParentClock { mark: SystemClock.make(0, 0) }
  return run Effect.catchAll(
    scenario() |> Effect.provideMut<MonotonicClock>(&mut clock),
    recover,
  )
}
