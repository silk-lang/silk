import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.fiber { Fiber, Cancelled }
import silk.local_scheduler { LocalScheduler, StalledError }
import silk.monotonic_clock { MonotonicClock }
import silk.os_monotonic_clock { OsMonotonicClock }
import silk.scheduler { Scheduler, TaskIdExhaustedError }
import silk.shared { Shared }

struct Audit {
  nextEvent: i32
  siblingEvent: i32
  timerEvent: i32
}

fn recordSibling(self: &mut Audit) -> () {
  self.nextEvent = self.nextEvent + 1
  self.siblingEvent = self.nextEvent
  return ()
}

fn recordTimer(self: &mut Audit) -> () {
  self.nextEvent = self.nextEvent + 1
  self.timerEvent = self.nextEvent
  return ()
}

fn isOrdered(self: &Audit) -> bool {
  return self.siblingEvent == 1 && self.timerEvent == 2
}

effect fn timer(audit: Shared<Audit>) -> i32
? &mut Scheduler | &mut MonotonicClock {
  run MonotonicClock.waitFor(1)
  let recorded = Shared.withMut(&audit, recordTimer)
  drop recorded
  drop audit
  return 41
}

effect fn sibling(audit: Shared<Audit>) -> i32 {
  let recorded = Shared.withMut(&audit, recordSibling)
  drop recorded
  drop audit
  return 1
}

effect fn root(audit: Shared<Audit>) -> i32
! OutOfMemoryError | TaskIdExhaustedError | Cancelled
? &mut Scheduler | &mut MonotonicClock {
  let sleeping = run Fiber<i32, never>.forkChild(timer(Shared<Audit>.clone(&audit)))
  let ready = run Fiber<i32, never>.forkChild(sibling(Shared<Audit>.clone(&audit)))
  let readyValue = run Fiber<i32, never>.join(move ready)
  let timerValue = run Fiber<i32, never>.join(move sleeping)
  let ordered = Shared<Audit>.with<bool>(&audit, isOrdered)
  drop audit
  if !ordered { return -1 }
  return readyValue + timerValue
}

effect fn scenario() -> i32
! OutOfMemoryError
  | TaskIdExhaustedError
  | Cancelled
  | StalledError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let audit = run Shared<Audit>.make(Audit {
    nextEvent: 0,
    siblingEvent: 0,
    timerEvent: 0,
  }) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut scheduler = LocalScheduler.make()
  let mut clock = OsMonotonicClock.make()
  let program = LocalScheduler.execute(&mut scheduler, root(move audit))
    |> Effect.provideMut<MonotonicClock>(&mut clock)
  return run move program
}

effect fn recover(
  error: OutOfMemoryError
    | TaskIdExhaustedError
    | Cancelled
    | StalledError,
) -> i32 {
  drop error
  return -99
}

pub fn main() -> i32 { return run Effect.catchAll(scenario(), recover) }
