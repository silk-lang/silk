// Compiler fixture: one owner stores distinct exact bodies homogeneously before first drive.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.execution { Execution }
import silk.shared { Shared }

struct Marker { value: i32 callbacks: i32 }
fn mark(self: &mut Marker, value: i32) -> () { self.value = value return () }
fn recordCallback(self: &mut Marker) -> () {
  self.callbacks = self.callbacks + 1
  return ()
}
fn fingerprint(self: &Marker) -> i32 { return self.value * 10 + self.callbacks }

struct TaskOutput {}
struct Empty {}
struct Stored { execution: Intrinsic.Execution<TaskOutput> }
struct Owner { first: Empty | Stored second: Empty | Stored }

effect fn firstBody(marker: Shared<Marker>) -> TaskOutput {
  let changed = Shared.withMut(&marker, mark(1))
  drop marker
  return TaskOutput {}
}

effect fn secondBody(marker: Shared<Marker>, selected: i32) -> TaskOutput {
  let changed = Shared.withMut(&marker, mark(selected))
  drop marker
  return TaskOutput {}
}

fn ready(marker: &Shared<Marker>) -> () {
  return Shared.withMut(marker, recordCallback)
}

fn complete(owner: &mut Owner, output: TaskOutput) -> () {
  drop output
  return ()
}

fn suspend(owner: &mut Owner, execution: Intrinsic.Execution<TaskOutput>) -> () {
  drop execution
  return ()
}

effect fn driveSelected(execution: Intrinsic.Execution<TaskOutput>, owner: &mut Owner) -> () {
  return run Execution.drive(move execution, move owner, complete, suspend)
}

fn notifySecond(owner: &mut Owner) -> () {
  return match &mut owner.second {
    Empty {} => ()
    Stored { execution } => Execution.notifyInitial(&mut execution)
  }
}

effect fn program() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let marker = run Shared<Marker>.make(Marker { value: 0, callbacks: 0 })
    |> Effect.provideMut<Allocator>(&mut allocator)
  let firstMarker = Shared<Marker>.clone(&marker)
  let secondMarker = Shared<Marker>.clone(&marker)
  let firstEndpoint = Shared<Marker>.clone(&marker)
  let secondEndpoint = Shared<Marker>.clone(&marker)
  let first = run Execution.make(firstBody(move firstMarker), move firstEndpoint, ready)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run Execution.make(secondBody(move secondMarker, 2), move secondEndpoint, ready)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut owner = Owner {
    first: Stored { execution: move first },
    second: Stored { execution: move second },
  }
  notifySecond(&mut owner)
  let selected = Intrinsic.replace(owner.second, Empty {})
  match move selected {
    Empty {} => ()
    Stored { execution } => run driveSelected(move execution, &mut owner)
  }
  let observed = Shared<Marker>.with<i32>(&marker, fingerprint)
  drop owner
  drop marker
  return observed
}

effect fn recover(error: OutOfMemoryError) -> i32 { return -1 }
pub fn main() -> i32 { return run Effect.catchAll(program(), recover) }
