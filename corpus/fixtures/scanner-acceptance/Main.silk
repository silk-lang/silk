import silk.mem.allocator {Allocator}
import silk.core.ownership {Copy}

import silk.mem.allocator {OutOfMemoryError}

import silk.mem.allocator {SystemAllocator}

import silk.core.effect {Effect}

import silk.num.usize

import silk.collections.list {List}

struct U8 {
  value: i32,
}

struct Token {
  kind: i32,
}

impl Copy for Token {}

fn observe(kind: i32) -> i32 {
  return kind
}

effect fn scan(source: &[U8]) -> List<Token> ! OutOfMemoryError ? &mut Allocator {
  let mut tokens = List<Token>.make()
  let mut index = usize.add(0, 0)
  while index < source.length {
    let byte = source[index].value
    let mut kind = 3
    if byte == 1 {
      kind = 1
    }
    if byte == 2 {
      kind = 2
    }
    let token = Token {kind: kind}
    let appended = run List<Token>.append(&mut tokens, move token)
    index = index + 1
  }
  return move tokens
}

effect fn build() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let source = [
    U8 {value: 1},
    U8 {value: 2},
    U8 {value: 3},
    U8 {value: 1},
    U8 {value: 2},
    U8 {value: 3},
    U8 {value: 1},
    U8 {value: 2},
    U8 {value: 3},
    U8 {value: 1},
  ]
  let mut pending = scan(&source)
    |> Effect.provideMut(&mut allocator)
  let mut tokens = run pending
  if List<Token>.length(&tokens) == 10 {} else {
    return 0
  }
  if List<Token>.capacity(&tokens) == 16 {} else {
    return 1
  }
  let token0 = List<Token>.get(&tokens, 0)
  let token1 = List<Token>.get(&tokens, 1)
  let token2 = List<Token>.get(&tokens, 2)
  let token3 = List<Token>.get(&tokens, 3)
  let token4 = List<Token>.get(&tokens, 4)
  let token5 = List<Token>.get(&tokens, 5)
  let token6 = List<Token>.get(&tokens, 6)
  let token7 = List<Token>.get(&tokens, 7)
  let token8 = List<Token>.get(&tokens, 8)
  let token9 = List<Token>.get(&tokens, 9)
  let kind0 = observe(token0.kind)
  let kind1 = observe(token1.kind)
  let kind2 = observe(token2.kind)
  let kind3 = observe(token3.kind)
  let kind4 = observe(token4.kind)
  let kind5 = observe(token5.kind)
  let kind6 = observe(token6.kind)
  let kind7 = observe(token7.kind)
  let kind8 = observe(token8.kind)
  let kind9 = observe(token9.kind)
  return kind0 + kind1 + kind2 + kind3 + kind4 + kind5 + kind6 + kind7 + kind8 + kind9 + 23
}

effect fn recover(error: OutOfMemoryError) -> i32 {
  return 7
}

pub fn main() -> i32 {
  return run Effect.catchAll(build(), recover)
}
