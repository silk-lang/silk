//! Static functions build union variants and tuples, select match arms by pattern and guard,
//! leave from a branch with `return`, and assign to parts of a `let mut` local. A variant computed
//! statically reaches runtime code as an embedded value.
import silk.core.option {Option}
import silk.num.u32

union Shape { Dot, Circle {pub r: u32}, Rect {pub w: u32, pub h: u32} }

enum Color { Red, Green, Blue }

tuple Pair(i32, i32)

struct Inner { pub a: u32, pub b: u32 }

struct Outer { pub inner: Inner, pub items: [u32; 3], pub n: u32 }

static fn find(x: u32) -> Shape {
  if x > 10 { return Shape.Rect {w: x, h: 2} }
  if x > 3 { return Shape.Circle {r: x} }
  return Shape.Dot
}

static fn area(shape: Shape) -> u32 {
  return match move shape {
    Shape.Dot => 0
    Shape.Circle {r} if r > 100 => 1
    Shape.Circle {r} => r * r * 3
    Shape.Rect {w, h} => w * h
  }
}

static fn early(shape: Shape) -> u32 {
  let base: u32 = match move shape {
    Shape.Dot => { return 7 }
    _ => 1
  }
  return base + 1
}

static fn positive(x: i32) -> Option<i32> {
  if x > 0 { return Option<i32>.Some {value: x} }
  return Option<i32>.None
}

static fn unwrapOr(value: Option<i32>, fallback: i32) -> i32 {
  if let Option<i32>.Some {value: held} = value { return held }
  return fallback
}

static fn pick(color: Color) -> u32 {
  let base: u32 = if color == Color.Red { 10 } else { 20 }
  return match color {
    Color.Red => base + 1
    Color.Green => base + 2
    Color.Blue => base + 3
  }
}

static fn digit(x: i32) -> i32 {
  return match x {
    0 => 100
    -1 => 200
    _ => x
  }
}

static fn swap(pair: Pair) -> Pair { return Pair(pair.1, pair.0) }

static fn build() -> Outer {
  let mut outer = Outer {inner: Inner {a: 1, b: 2}, items: [0, 0, 0], n: 0}
  outer.n = 5
  outer.inner.b = 7
  let mut at: usize = 0
  while at < 3 {
    outer.items[at] = outer.n + outer.inner.b
    at = at + 1
  }
  outer.items[1] = 100
  return outer
}

pub fn main() -> i32 {
  static if area(find(5)) != 75 { compileError("area of a circle") }
  static if area(find(1)) != 0 { compileError("area of a dot") }
  static if area(find(12)) != 24 { compileError("area of a rectangle") }
  static if early(find(1)) != 7 { compileError("early return") }
  static if early(find(5)) != 2 { compileError("no early return") }
  static if unwrapOr(positive(4), 9) != 4 { compileError("if let some") }
  static if unwrapOr(positive(-4), 9) != 9 { compileError("if let none") }
  static if pick(Color.Green) != 22 { compileError("enum arm") }
  static if pick(Color.Red) != 11 { compileError("if value") }
  static if digit(0) != 100 { compileError("integer arm") }
  static if digit(-1) != 200 { compileError("negative integer arm") }
  static if digit(5) != 5 { compileError("universal arm") }
  static if swap(Pair(3, 4)).0 != 4 { compileError("tuple") }
  static if build().inner.b != 7 { compileError("nested field assignment") }
  static if build().items[0] != 12 { compileError("element assignment") }
  static if build().items[1] != 100 { compileError("element replacement") }
  static if build().inner.a != 1 { compileError("untouched field") }
  let static shape = find(5)
  let static pair = swap(Pair(1, 9))
  let radius = match shape {
    Shape.Circle {r} => u32.toI32(r)
    _ => 0
  }
  return radius + pair.0 + 90
}
