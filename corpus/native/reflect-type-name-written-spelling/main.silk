// `Reflect.typeName` names a type as a program writes it: a lifetime other than `'static` is
// elided, as in `&u32`, and a function passed as a value is named by the contract it satisfies,
// as in `fn(&u32) -> bool`, so a static function can test what kind of value it received.
import silk.core.reflect { Reflect }

struct Guard {}

static fn named<G>(guard: G) -> string<'static> {
  return Reflect.typeName<G>()
}

static fn fromGuard<G>(guard: G) -> u8 {
  static if Reflect.typeName<G>() == "Guard" {
    return 1
  } else {
    return 0
  }
}

fn big(n: &u32) -> bool {
  return n.* > 3
}

fn reset(n: &mut u32) -> () {
  n.* = 0
}

pub fn main() -> i32 {
  let static guarded = fromGuard(Guard {})
  if guarded != 1 {
    return 1
  }
  let static function = fromGuard(big)
  if function != 0 {
    return 2
  }
  let static contract = named(big)
  if contract != "fn(&u32) -> bool" {
    return 3
  }
  let static unit = named(reset)
  if unit != "fn(&mut u32)" {
    return 4
  }
  let static borrowed = Reflect.typeName<&u32>()
  if borrowed != "&u32" {
    return 5
  }
  let static written = Reflect.typeName<once fn(u32) -> u32>()
  if written != "once fn(u32) -> u32" {
    return 6
  }
  return 0
}
