// The benchmark library on fixed samples: the statistics, the unit text, the report made from
// a result, and each renderer. Nothing here depends on how fast the computer is; the one real
// process is checked for its exit status only.

effect fn sample(name: string, round: u64, wall: u64, exit: i64, warmup: bool) -> Sample
  ! OutOfMemoryError
  ? &mut Allocator {
  return Sample {
    implementation: run String.copy(name),
    round: round,
    position: 0,
    warmup: warmup,
    wall: wall,
    user: wall / 2,
    system: wall / 10,
    peak: 40000000 + wall / 100,
    exit: exit,
    signal: 0,
  }
}

effect fn benchmark(name: string, scale: u64) -> Measured
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut samples = List<Sample>.make()

  // A warm-up far from the measured runs: it must not move any statistic.
  run samples.append(run sample("silk", 0, 900000000, 0, true))
  run samples.append(run sample("rust", 0, 900000000, 0, true))
  run samples.append(run sample("go", 0, 900000000, 0, true))
  let mut round: u64 = 0
  while round < 10 {
    run samples.append(run sample("silk", round, scale * (100 + round), 0, false))
    run samples.append(run sample("rust", round, scale * (200 + round * 3), 0, false))

    // Within the noise of rust: no difference to call.
    run samples.append(run sample("go", round, scale * (201 + round * 3), 0, false))
    round = round + 1
  }

  // One failed run: counted, in no statistic.
  run samples.append(run sample("go", 10, scale, 3, false))
  let mut parameters = List<Pair>.make()
  run parameters.append(Pair { name: run String.copy("file"), value: run String.copy(name) })
  let mut full = run String.copy("parse/file=")
  run full.append(name)
  return Measured { name: move full, parameters: move parameters, samples: move samples }
}

effect fn subject(name: string, command: string, revision: Option<String>) -> Subject
  ! OutOfMemoryError
  ? &mut Allocator {
  return Subject {
    name: run String.copy(name),
    command: run String.copy(command),
    revision: move revision,
  }
}

effect fn fixture() -> RunResult
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut benchmarks = List<Measured>.make()
  run benchmarks.append(run benchmark("twitter", 1000000))
  run benchmarks.append(run benchmark("canada", 4000))
  let mut subjects = List<Subject>.make()
  run subjects.append(
    run subject(
      "silk",
      "build/parse data/{file}.json",
      Option<String>.Some { value: run String.copy("17606e32") },
    ),
  )
  run subjects.append(
    run subject("rust", "rust/target/release/parse data/{file}.json", Option<String>.None),
  )
  run subjects.append(run subject("go", "go/parse <data/{file}.json>", Option<String>.None))
  let mut variables = List<Pair>.make()
  run variables.append(Pair { name: run String.copy("GOMAXPROCS"), value: run String.copy("1") })
  let mut notes = List<String>.make()
  run notes.append(run String.copy("laptop on battery & <unplugged>"))
  return RunResult {
    protocol: PROTOCOL,
    suite: run String.copy("parse"),
    id: run String.copy("20261119T140322Z-481"),
    label: Option<String>.Some { value: run String.copy("after") },
    started: run String.copy("2026-11-19T14:03:22Z"),
    ended: run String.copy("2026-11-19T14:03:29Z"),
    notes: move notes,
    environment: Environment {
      system: run String.copy("Linux"),
      release: run String.copy("6.8.0"),
      machine: run String.copy("x86_64"),
      processor: run String.copy("Example CPU"),
      processors: 8,
      usable: 4,
      memory: 16000000000,
      load: 0.25,
      variables: move variables,
    },
    implementations: move subjects,
    reference: run String.copy("rust"),
    runs: 10,
    warmups: 1,
    floor: 17000000,
    benchmarks: move benchmarks,
  }
}

fn has(text: string, part: string) -> string<'static> {
  if String.contains(text, part) {
    return "yes"
  }
  return "NO"
}

fn lacks(text: string, part: string) -> string<'static> {
  if String.contains(text, part) {
    return "NO"
  }
  return "yes"
}

effect fn statistics() -> ()
  ! OutOfMemoryError | WriterError
  ? &mut Allocator | &mut Writer {
  let mut fast = List<f64>.make()
  let mut slow = List<f64>.make()
  let mut near = List<f64>.make()
  let mut at: usize = 0
  while at < 10 {
    run fast.append(100.0 + usize.toF64(at))
    run slow.append(200.0 + usize.toF64(at) * 3.0)
    run near.append(201.0 + usize.toF64(at) * 3.0)
    at = at + 1
  }

  // An outlier is counted and stays in the summary.
  run fast.append(400.0)
  let summary = run Statistics.summary(fast.asSlice())
  run Format.format(
    "summary {} {:.1} {:.1} {:.1} {:.1} {:.1} {}\n",
    &(
      summary.count,
      summary.median,
      summary.minimum,
      summary.maximum,
      summary.low,
      summary.high,
      summary.outliers
    ),
  )
  let faster = run Statistics.ratio(fast.asSlice(), slow.asSlice(), 0.01)
  let slower = run Statistics.ratio(slow.asSlice(), fast.asSlice(), 0.01)
  let same = run Statistics.ratio(near.asSlice(), slow.asSlice(), 0.01)
  let wide = run Statistics.ratio(fast.asSlice(), slow.asSlice(), 0.6)
  run Format.format(
    "ratio {:.3} [{:.3}, {:.3}] {} {} {} {}\n",
    &(
      faster.value,
      faster.low,
      faster.high,
      faster.verdict == Verdict.Faster,
      slower.verdict == Verdict.Slower,
      same.verdict == Verdict.Same,
      wide.verdict == Verdict.Same,
    ),
  )
  let empty = run Statistics.summary(&[])
  let none = run Statistics.ratio(&[], slow.asSlice(), 0.01)
  run Format.format(
    "empty {} {:.1} {:.1} {} {:.2}\n",
    &(
      empty.count,
      empty.median,
      none.value,
      none.verdict == Verdict.Same,
      Statistics.geometricMean(&[])
    ),
  )
  run Format.format(
    "geometric {:.3} {:.3}\n",
    &(Statistics.geometricMean(&[2.0, 0.5]), Statistics.geometricMean(&[0.5, 0.25, 0.0])),
  )
}

effect fn units() -> ()
  ! OutOfMemoryError | WriterError
  ? &mut Allocator | &mut Writer {
  let values = [0.0, 999.0, 1000.0, 12345.0, 123456789.0, 59900000000.0]
  let mut at: usize = 0
  while at < values.length {
    let text = run Units.duration(values[at])
    run Format.format("[{}] ", &.(text.view()))
    at = at + 1
  }
  let sizes = [512.0, 2048.0, 4404019.0, 3221225472.0]
  at = 0
  while at < sizes.length {
    let text = run Units.memory(sizes[at])
    run Format.format("[{}] ", &.(text.view()))
    at = at + 1
  }
  let mut fixed = String.make()
  run Units.appendFixed(&mut fixed, -1.005, 2)
  run fixed.append(" ")
  run Units.appendFixed(&mut fixed, 0.999, 1)
  run fixed.append(" ")
  run Units.appendFixed(&mut fixed, 12.5, 0)
  let ratio = run Units.ratio(0.4894)
  run Format.format("[{}] [{}] {}\n", &(fixed.view(), ratio.view(), Units.width("12.3 µs ≤")))
}

effect fn process() -> bool
  ! TaskError | FileError | OutOfMemoryError
  ? &mut Allocator | &mut MonotonicClock {
  if !Process.supported() {
    return true
  }
  let mut arguments = List<String>.make()
  run arguments.append(run String.copy("-c"))
  run arguments.append(run String.copy("test \"$BENCH_CHECK\" = set && exit 3"))
  let mut variables = List<Pair>.make()
  run variables.append(Pair { name: run String.copy("BENCH_CHECK"), value: run String.copy("set") })
  let launch = Launch {
    program: run Path.make("/bin/sh"),
    arguments: move arguments,
    directory: Option<Path>.Some { value: run Path.make("/") },
    variables: move variables,
  }
  let timed = run Process.time(&launch, 0)
  if timed.exit != 3 || timed.signal != 0 || timed.wall == 0 || timed.peak == 0 {
    return false
  }

  // A hook that fails is an error with the program's status.
  let failed = match move run Effect.result(Process.perform(&launch)) {
    Result<(), TaskError | OutOfMemoryError>.Success { .. } => false
    Result<(), TaskError | OutOfMemoryError>.Failure { error } => match move error {
      TaskError failure => failure.status == 3
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let missing = Launch {
    program: run Path.make("/no/such/program"),
    arguments: List<String>.make(),
    directory: Option<Path>.None,
    variables: List<Pair>.make(),
  }
  let refused = match move run Effect.result(Process.time(&missing, 0)) {
    Result<Timed, TaskError | OutOfMemoryError>.Success { .. } => false
    Result<Timed, TaskError | OutOfMemoryError>.Failure { error } => match move error {
      TaskError failure => failure.status == 127
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  return failed && refused
}

effect fn program() -> i32
  ! OutOfMemoryError | WriterError | SchemaError | TaskError | FileError
  ? &mut Allocator | &mut Writer | &mut MonotonicClock {
  run statistics()
  run units()
  let result = run fixture()
  let report = run Reports.make(&result, 0.01)
  let table = run Render.terminal(&report, false)
  run Writer.writeAll(String.utf8Bytes(table.view()))
  let colored = run Render.terminal(&report, true)
  run Format.format(
    "color: green {} warning {} dim {}\n",
    &(
      has(colored.view(), "\x1b[32m0.49x [0.47, 0.51] faster\x1b[0m"),
      has(colored.view(), "\x1b[33mgo: 1 of 11 runs failed"),
      has(colored.view(), "\x1b[2m1.00x [0.95, 1.06] no difference\x1b[0m"),
    ),
  )
  let markdown = run Render.markdown(&report)
  run Writer.writeAll(String.utf8Bytes(markdown.view()))
  let page = run Html.page(&report)
  run Format.format(
    "html: document {} escaped {} chart {} static {} offline {}\n",
    &(
      has(page.view(), "<!doctype html>"),
      has(page.view(), "battery &amp; &lt;unplugged&gt;"),
      has(page.view(), "<svg viewBox=\"0 0 928.0 128.0\""),
      lacks(page.view(), "<script"),
      lacks(page.view(), "http"),
    ),
  )

  // The report survives its JSON form.
  let encoded = run Encoding.json<Report>(&report)
  let decoded = run SchemaJson.decode<Report>(encoded.asSlice())
  let again = run Render.terminal(&decoded, false)
  let raw = run Encoding.json<RunResult>(&result)
  let samples = run SchemaJson.decode<RunResult>(raw.asSlice())
  run Format.format(
    "json: report {} result {} samples {}\n",
    &(
      again.view() == table.view(),
      samples.benchmarks.asSlice()[1].name.view(),
      samples.benchmarks.asSlice()[0].samples.length(),
    ),
  )
  if !run process() {
    run Format.format("process: FAILED\n", &())
    return 1
  }
  run Format.format("process: ok\n", &())
  return 0
}

pub effect fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut out = StdoutWriter.make()
  let mut clock = OsMonotonicClock.make()
  let outcome = run Effect.result(program())
    |> Effect.provideMut<Allocator>(&mut allocator)
    |> Effect.provideMut<Writer>(&mut out)
    |> Effect.provideMut<MonotonicClock>(&mut clock)
  return match move outcome {
    Result<i32, OutOfMemoryError | WriterError | SchemaError | TaskError | FileError>.Success {
      value
    } => value
    Result<i32, OutOfMemoryError | WriterError | SchemaError | TaskError | FileError>.Failure {
      ..
    } => 2
  }
}
