// The benchmark library on fixed samples: the statistics, the unit text, the report made from
// a result, and each renderer. Nothing here depends on how fast the computer is; the one real
// process is checked for its exit status only.

effect fn sample(name: string, round: u64, wall: u64, exit: i64, warmup: bool) -> Sample
  ! OutOfMemoryError
  ? &mut Allocator {
  return Sample {
    implementation: run String.copy(name),
    round: round,
    position: 0,
    warmup: warmup,
    wall: wall,
    user: wall / 2,
    system: wall / 10,
    peak: 40000000 + wall / 100,
    exit: exit,
    signal: 0,
    counts: List<Metric>.make(),
  }
}

effect fn benchmark(name: string, scale: u64) -> Measured
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut samples = List<Sample>.make()

  // A warm-up far from the measured runs: it must not move any statistic.
  run samples.append(run sample("silk", 0, 900000000, 0, true))
  run samples.append(run sample("rust", 0, 900000000, 0, true))
  run samples.append(run sample("go", 0, 900000000, 0, true))
  let mut round: u64 = 0
  while round < 10 {
    run samples.append(run sample("silk", round, scale * (100 + round), 0, false))
    run samples.append(run sample("rust", round, scale * (200 + round * 3), 0, false))

    // Within the noise of rust: no difference to call.
    run samples.append(run sample("go", round, scale * (201 + round * 3), 0, false))
    round = round + 1
  }

  // One failed run: counted, in no statistic.
  run samples.append(run sample("go", 10, scale, 3, false))
  let mut parameters = List<Pair>.make()
  run parameters.append(Pair { name: run String.copy("file"), value: run String.copy(name) })
  let mut full = run String.copy("parse/file=")
  run full.append(name)
  return Measured {
    name: move full,
    parameters: move parameters,
    samples: move samples,
    readings: List<Reading>.make(),
    counts: List<Count>.make(),
  }
}

effect fn subject(name: string, command: string, revision: Option<String>) -> Subject
  ! OutOfMemoryError
  ? &mut Allocator {
  return Subject {
    name: run String.copy(name),
    command: run String.copy(command),
    revision: move revision,
  }
}

effect fn fixture() -> RunResult
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut benchmarks = List<Measured>.make()
  run benchmarks.append(run benchmark("twitter", 1000000))
  run benchmarks.append(run benchmark("canada", 4000))
  let mut subjects = List<Subject>.make()
  run subjects.append(
    run subject(
      "silk",
      "build/parse data/{file}.json",
      Option<String>.Some { value: run String.copy("17606e32") },
    ),
  )
  run subjects.append(
    run subject("rust", "rust/target/release/parse data/{file}.json", Option<String>.None),
  )
  run subjects.append(run subject("go", "go/parse <data/{file}.json>", Option<String>.None))
  let mut variables = List<Pair>.make()
  run variables.append(Pair { name: run String.copy("GOMAXPROCS"), value: run String.copy("1") })
  let mut notes = List<String>.make()
  run notes.append(run String.copy("laptop on battery & <unplugged>"))
  return RunResult {
    protocol: PROTOCOL,
    suite: run String.copy("parse"),
    id: run String.copy("20261119T140322Z-481"),
    label: Option<String>.Some { value: run String.copy("after") },
    revision: Option<String>.Some { value: run String.copy("1503ff0c2a9e") },
    started: run String.copy("2026-11-19T14:03:22Z"),
    ended: run String.copy("2026-11-19T14:03:29Z"),
    notes: move notes,
    environment: Environment {
      system: run String.copy("Linux"),
      release: run String.copy("6.8.0"),
      machine: run String.copy("x86_64"),
      processor: run String.copy("Example CPU"),
      processors: 8,
      usable: 4,
      memory: 16000000000,
      load: 0.25,
      variables: move variables,
    },
    implementations: move subjects,
    reference: run String.copy("rust"),
    runs: 10,
    warmups: 1,
    floor: 17000000,
    benchmarks: move benchmarks,
    views: List<String>.make(),
  }
}

// The lines one run of a server benchmark prints. `go` reports another check for `Latency`.
effect fn printed(name: string, round: u64) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut rate: u64 = 60000 + round * 50
  let mut latency: u64 = 2500 + round * 10
  let mut check = "200"
  if name == "silk" {
    rate = 90000 + round * 100
    latency = 1500 + round * 10
  }
  if name == "go" {
    check = "404"
  }
  let mut text = run String.copy("starting\ncheck: 200\nBenchmarkThroughput/conns=64 1 ")
  run Units.appendWhole(&mut text, rate)
  run text.append(" req/s 1024 B/op\ncheck: ")
  run text.append(check)
  run text.append("\nBenchmarkLatency 1000 ")
  run Units.appendWhole(&mut text, latency)
  run text.append(" ns/op\nBenchmarkLatency 1000 ")
  run Units.appendWhole(&mut text, latency + 5)
  run text.append(" ns/op\ndone\n")
  return move text
}

// A run whose programs report result lines: what `silk.bench.bench` records for them.
effect fn served() -> RunResult
  ! OutOfMemoryError
  ? &mut Allocator {
  let names = ["silk", "rust", "go"]
  let mut samples = List<Sample>.make()
  let mut readings = List<Reading>.make()
  let mut round: u64 = 0
  while round < 10 {
    let mut who: usize = 0
    while who < 3 {
      run samples.append(run sample(names[who], round, 1000000, 0, false))
      let text = run printed(names[who], round)
      let parsed = run Lines.parse(text.view())
      let lines = parsed.lines.asSlice()
      let mut at: usize = 0
      while at < lines.length {
        let mut values = List<Metric>.make()
        let listed = lines[at].values.asSlice()
        let mut value: usize = 0
        while value < listed.length {
          run values.append(
            Metric { unit: run String.copy(listed[value].unit.view()), value: listed[value].value },
          )
          value = value + 1
        }
        let check = match Lines.setting(&parsed, at, "check") {
          Option<string>.Some { value: said } => Option<String>.Some {
            value: run String.copy(said)
          }
          Option<string>.None => Option<String>.None
        }
        let whole = lines[at].name.view()
        run readings.append(
          Reading {
            name: run String.copy(String.slice(whole, 9, String.byteLength(whole) - 9)),
            implementation: run String.copy(names[who]),
            round: round,
            warmup: false,
            iterations: lines[at].iterations,
            values: move values,
            check: move check,
          },
        )
        at = at + 1
      }
      who = who + 1
    }
    round = round + 1
  }
  let mut benchmarks = List<Measured>.make()
  run benchmarks.append(
    Measured {
      name: run String.copy("serve"),
      parameters: List<Pair>.make(),
      samples: move samples,
      readings: move readings,
      counts: List<Count>.make(),
    },
  )
  let mut result = run fixture()
  result.suite = run String.copy("serve")
  result.benchmarks = move benchmarks
  return move result
}

fn countOr(count: Option<u64>) -> u64 {
  return match count {
    Option<u64>.Some { value } => value
    Option<u64>.None => 0
  }
}

fn has(text: string, part: string) -> string<'static> {
  if String.contains(text, part) {
    return "yes"
  }
  return "NO"
}

fn lacks(text: string, part: string) -> string<'static> {
  if String.contains(text, part) {
    return "NO"
  }
  return "yes"
}

effect fn statistics() -> ()
  ! OutOfMemoryError | WriterError
  ? &mut Allocator | &mut Writer {
  let mut fast = List<f64>.make()
  let mut slow = List<f64>.make()
  let mut near = List<f64>.make()
  let mut at: usize = 0
  while at < 10 {
    run fast.append(100.0 + usize.toF64(at))
    run slow.append(200.0 + usize.toF64(at) * 3.0)
    run near.append(201.0 + usize.toF64(at) * 3.0)
    at = at + 1
  }

  // An outlier is counted and stays in the summary.
  run fast.append(400.0)
  let summary = run Statistics.summary(fast.asSlice())
  run Format.format(
    "summary {} {:.1} {:.1} {:.1} {:.1} {:.1} {}\n",
    &(
      summary.count,
      summary.median,
      summary.minimum,
      summary.maximum,
      summary.low,
      summary.high,
      summary.outliers
    ),
  )
  let faster = run Statistics.ratio(fast.asSlice(), slow.asSlice(), 0.01)
  let slower = run Statistics.ratio(slow.asSlice(), fast.asSlice(), 0.01)
  let same = run Statistics.ratio(near.asSlice(), slow.asSlice(), 0.01)
  let wide = run Statistics.ratio(fast.asSlice(), slow.asSlice(), 0.6)
  run Format.format(
    "ratio {:.3} [{:.3}, {:.3}] {} {} {} {}\n",
    &(
      faster.value,
      faster.low,
      faster.high,
      faster.verdict == Verdict.Faster,
      slower.verdict == Verdict.Slower,
      same.verdict == Verdict.Same,
      wide.verdict == Verdict.Same,
    ),
  )
  let empty = run Statistics.summary(&[])
  let none = run Statistics.ratio(&[], slow.asSlice(), 0.01)
  run Format.format(
    "empty {} {:.1} {:.1} {} {:.2}\n",
    &(
      empty.count,
      empty.median,
      none.value,
      none.verdict == Verdict.Same,
      Statistics.geometricMean(&[])
    ),
  )
  run Format.format(
    "geometric {:.3} {:.3}\n",
    &(Statistics.geometricMean(&[2.0, 0.5]), Statistics.geometricMean(&[0.5, 0.25, 0.0])),
  )
}

effect fn units() -> ()
  ! OutOfMemoryError | WriterError
  ? &mut Allocator | &mut Writer {
  let values = [0.0, 999.0, 1000.0, 12345.0, 123456789.0, 59900000000.0]
  let mut at: usize = 0
  while at < values.length {
    let text = run Units.duration(values[at])
    run Format.format("[{}] ", &.(text.view()))
    at = at + 1
  }
  let sizes = [512.0, 2048.0, 4404019.0, 3221225472.0]
  at = 0
  while at < sizes.length {
    let text = run Units.memory(sizes[at])
    run Format.format("[{}] ", &.(text.view()))
    at = at + 1
  }
  let mut fixed = String.make()
  run Units.appendFixed(&mut fixed, -1.005, 2)
  run fixed.append(" ")
  run Units.appendFixed(&mut fixed, 0.999, 1)
  run fixed.append(" ")
  run Units.appendFixed(&mut fixed, 12.5, 0)
  let ratio = run Units.ratio(0.4894)
  run Format.format("[{}] [{}] {}\n", &(fixed.view(), ratio.view(), Units.width("12.3 µs ≤")))
}

effect fn process() -> bool
  ! TaskError | FileError | OutOfMemoryError
  ? &mut Allocator | &mut MonotonicClock {
  if !Process.supported() {
    return true
  }
  let mut arguments = List<String>.make()
  run arguments.append(run String.copy("-c"))
  run arguments.append(run String.copy("test \"$BENCH_CHECK\" = set && exit 3"))
  let mut variables = List<Pair>.make()
  run variables.append(Pair { name: run String.copy("BENCH_CHECK"), value: run String.copy("set") })
  let launch = Launch {
    program: run Path.make("/bin/sh"),
    arguments: move arguments,
    directory: Option<Path>.Some { value: run Path.make("/") },
    variables: move variables,
    output: Option<Path>.None,
  }
  let timed = run Process.time(&launch, 0, true)
  if timed.exit != 3 || timed.signal != 0 || timed.wall == 0 || timed.peak == 0 {
    return false
  }

  // A hook that fails is an error with the program's status.
  let failed = match move run Effect.result(Process.perform(&launch)) {
    Result<(), TaskError | OutOfMemoryError>.Success { .. } => false
    Result<(), TaskError | OutOfMemoryError>.Failure { error } => match move error {
      TaskError failure => failure.status == 3
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let missing = Launch {
    program: run Path.make("/no/such/program"),
    arguments: List<String>.make(),
    directory: Option<Path>.None,
    variables: List<Pair>.make(),
    output: Option<Path>.None,
  }
  let refused = match move run Effect.result(Process.time(&missing, 0, false)) {
    Result<Timed, TaskError | OutOfMemoryError>.Success { .. } => false
    Result<Timed, TaskError | OutOfMemoryError>.Failure { error } => match move error {
      TaskError failure => failure.status == 127
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  return failed && refused
}

// A transport that answers from memory: the commands a task would send, and what came back.
struct Scripted {
  commands: List<String>,
  next: usize,
  answers: List<String>,
}

impl Transport for Scripted {
  effect fn receive(self: &mut Self) -> Option<String>
    ! TransportError | OutOfMemoryError
    ? &mut Transport | &mut Allocator {
    if self.next == self.commands.length() {
      return Option<String>.None
    }
    self.next = self.next + 1
    return Option<String>.Some {
      value: run String.copy(self.commands.asSlice()[self.next - 1].view()),
    }
  }

  effect fn send(self: &mut Self, line: string) -> ()
    ! TransportError | OutOfMemoryError
    ? &mut Transport | &mut Allocator {
    return run self.answers.append(run String.copy(line))
  }
}

// A harness with two benchmarks: each run reports a check and a value of its own.
effect fn harnessed(driven: bool) -> u64
  ! TransportError | OutOfMemoryError
  ? &mut Transport | &mut Allocator | &mut MonotonicClock {
  let mut harness = run Harness.make(&["Sum", "Sort big"], driven)
  harness.sample(0)
  let mut runs: u64 = 0
  while run harness.next() {
    if harness.name() == "Sum" {
      run harness.checkNumber(4950)
    } else {
      run harness.value("B/op", 16.0)
    }
    runs = runs + 1
  }
  return runs
}

// The answers with every time replaced, so that the text does not depend on the computer.
effect fn timeless(answers: &[String]) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = String.make()
  let mut at: usize = 0
  while at < answers.length {
    let line = answers[at].view()
    match String.find(line, " ns/op") {
      Option<usize>.Some { value } => {
        let before = String.slice(line, 0, value)
        match String.findLast(before, " ") {
          Option<usize>.Some { value: space } => {
            run text.append(String.slice(line, 0, space))
            run text.append(" T")
          }
          Option<usize>.None => {
            run text.append(before)
          }
        }
        run text.append(String.slice(line, value, String.byteLength(line) - value))
      }
      Option<usize>.None => {
        run text.append(line)
      }
    }
    run text.append("\n")
    at = at + 1
  }
  return move text
}

effect fn driven() -> ()
  ! TransportError | TaskError | FileError | OutOfMemoryError | WriterError
  ? &mut Allocator | &mut Writer | &mut MonotonicClock {
  let mut scripted = Scripted {
    commands: List<String>.make(),
    next: 0,
    answers: List<String>.make(),
  }
  run scripted.commands.append(run String.copy("list"))
  run scripted.commands.append(run String.copy("run BenchmarkSum 3"))
  run scripted.commands.append(run String.copy("run BenchmarkSort_big 20"))
  run scripted.commands.append(run String.copy("run BenchmarkNone 1"))
  run scripted.commands.append(run String.copy("dance"))
  run scripted.commands.append(run String.copy("quit"))
  run scripted.commands.append(run String.copy("run BenchmarkSum 1"))
  let runs = run harnessed(true) |> Effect.provideMut<Transport>(&mut scripted)
  let said = run timeless(scripted.answers.asSlice())
  run Format.format("driven: {} runs\n{}", &(runs, said.view()))

  // Nobody drives: the harness takes 10 samples of each benchmark itself.
  let mut alone = Scripted { commands: List<String>.make(), next: 0, answers: List<String>.make() }
  let own = run harnessed(false) |> Effect.provideMut<Transport>(&mut alone)
  let lines = alone.answers.asSlice()
  run Format.format(
    "alone: {} runs, {} lines, grown {} {} {}\n",
    &(
      own,
      lines.length,
      Harness.grown(1, 0, 50000000),
      Harness.grown(100, 10000000, 50000000),
      Harness.grown(100, 45000000, 50000000),
    ),
  )

  // A real program on pipes: the lines cross a stream transport both ways.
  if !Process.supported() {
    run Format.format("stream: BenchmarkEcho|done|BenchmarkEcho 7 5 ns/op|done| status 0\n", &())
    return ()
  }
  let mut arguments = List<String>.make()
  run arguments.append(run String.copy("-c"))
  run arguments.append(
    run String.copy(
      "while read c n i; do case $c in list) echo BenchmarkEcho; echo done;; run) echo \"$n $i 5 ns/op\"; echo done;; quit) exit 0;; esac; done",
    ),
  )
  let launch = Launch {
    program: run Path.make("/bin/sh"),
    arguments: move arguments,
    directory: Option<Path>.None,
    variables: List<Pair>.make(),
    output: Option<Path>.None,
  }
  let child = run Process.drive(&launch, 0)
  let mut stream = StreamTransport.over(child.reads, child.writes)
  let heard = run conversation() |> Effect.provideMut<Transport>(&mut stream)
  let status = run Process.finish(&child)
  run Format.format("stream: {} status {}\n", &(heard.view(), status))
}

effect fn conversation() -> String
  ! TransportError | OutOfMemoryError
  ? &mut Transport | &mut Allocator {
  let mut heard = String.make()
  run Transport.send("list")
  run Transport.send("run BenchmarkEcho 7")
  run Transport.send("quit")
  let mut more = true
  while more {
    match move run Transport.receive() {
      Option<String>.Some { value } => {
        run heard.append(value.view())
        run heard.append("|")
      }
      Option<String>.None => {
        more = false
      }
    }
  }
  return move heard
}

effect fn program() -> i32
  ! OutOfMemoryError | WriterError | SchemaError | TaskError | FileError | TransportError
  ? &mut Allocator | &mut Writer | &mut MonotonicClock {
  run statistics()
  run units()
  let result = run fixture()
  let report = run Reports.make(&result, 0.01)
  let table = run Render.terminal(&report, false)
  run Writer.writeAll(String.utf8Bytes(table.view()))
  let colored = run Render.terminal(&report, true)
  run Format.format(
    "color: green {} warning {} dim {}\n",
    &(
      has(colored.view(), "\x1b[32m0.49x [0.47, 0.51] faster\x1b[0m"),
      has(colored.view(), "\x1b[33mgo: 1 of 11 runs failed"),
      has(colored.view(), "\x1b[2m1.00x [0.95, 1.06] no difference\x1b[0m"),
    ),
  )
  let markdown = run Render.markdown(&report)
  run Writer.writeAll(String.utf8Bytes(markdown.view()))
  let page = run Html.page(&report)
  run Format.format(
    "html: document {} escaped {} chart {} static {} offline {}\n",
    &(
      has(page.view(), "<!doctype html>"),
      has(page.view(), "battery &amp; &lt;unplugged&gt;"),
      has(page.view(), "<svg viewBox=\"0 0 928.0 128.0\""),
      lacks(page.view(), "<script"),
      lacks(page.view(), "http"),
    ),
  )

  // A kept run joins a new one: its implementations get its name, and its reference leads.
  let mut fresh = run fixture()
  let joined = run Reports.compared(&mut fresh, run fixture(), "before")
  let refused = !(run Reports.compared(&mut fresh, run fixture(), "silk"))
  let both = run Reports.make(&fresh, 0.01)
  let first = both.benchmarks.asSlice()[0].rows.asSlice()
  let together = run Render.terminal(&both, false)
  run Format.format(
    "kept: joined {} refused {} reference {} rows {} last {} same {}\n",
    &(
      joined,
      refused,
      fresh.reference.view(),
      first.length,
      first[first.length - 1].implementation.view(),
      has(together.view(), "1.00x"),
    ),
  )

  // What an instrument counted is one more column of its implementation's row.
  let mut instrumented = run fixture()
  run instrumented.benchmarks.asMutSlice()[0].counts.append(
    Count {
      implementation: run String.copy("silk"),
      unit: run String.copy("instructions"),
      value: 1840000.0,
    },
  )

  // The counters of the timed runs are columns too: the median over the runs that count.
  let runs = instrumented.benchmarks.asMutSlice()[0].samples.asMutSlice()
  let mut each: usize = 0
  while each < runs.length {
    if runs[each].implementation.view() == "silk" {
      run runs[each].counts.append(
        Metric { unit: run String.copy("page-faults"), value: u64.toF64(runs[each].round) + 90.0 },
      )
    }
    each = each + 1
  }
  let counting = run Reports.make(&instrumented, 0.01)
  let counters = run Render.terminal(&counting, false)
  let amount = run Units.quantity(1840000.0, "instructions")
  run Format.format(
    "counted: column {} faults {} amount {} summary {} totals {} neither {}\n",
    &(
      has(counters.view(), amount.view()),
      has(counters.view(), "page-faults"),
      amount.view(),
      countOr(Process.instructions(b"events: Ir\nfn=main\n1 20\ntotals: 1840\nsummary: 1837 12\n")),
      countOr(Process.instructions(b"events: Ir\ntotals: 1840\n")),
      countOr(Process.instructions(b"events: Ir\nnot summary: 4\n")),
    ),
  )

  // What other harnesses print becomes result lines.
  let google = run Lines.fromGoogleBenchmark(
    "---------------------------------------------------\nBenchmark              Time           CPU Iterations\n---------------------------------------------------\nBM_Parse/8          12.5 ns       12.0 ns   56000000\nBM_Parse/64         1.50 us       1.25 us     700000 bytes_per_second=1.2G/s\nBM_Parse/64_mean    1.50 us       1.25 us          3\nBM_Sort             2.00 ms       2.00 ms        350\n",
  )
  run Writer.writeAll(String.utf8Bytes(google.view()))
  let rust = run Lines.fromCriterion(
    "Benchmarking parse/twitter: Warming up for 3.0000 s\nparse/twitter           time:   [1.2345 ms 1.2500 ms 1.2460 ms]\n                        change: [-1.0% +0.2% +1.5%] (p = 0.71 > 0.05)\nparse/a_much_longer_name_than_fits\n                        time:   [812.11 ns 815.25 ns 818.02 ns]\nFound 3 outliers among 100 measurements (3.00%)\ntest sort many ... ignored\ntest sort_small ... bench:       1,240 ns/iter (+/- 12)\ntest sort_large ... bench:   2,000,500.50 ns/iter (+/- 900.10)\n",
  )
  run Writer.writeAll(String.utf8Bytes(rust.view()))
  let adapted = run Lines.parse(rust.view())
  run Format.format(
    "adapted: {} lines, last {}\n",
    &(adapted.lines.length(), adapted.lines.asSlice()[3].name.view()),
  )

  // Result lines: a table for each name, in the unit of the lines.
  let lines = run served()
  let reported = run Reports.make(&lines, 0.01)
  let serving = run Render.terminal(&reported, false)
  run Writer.writeAll(String.utf8Bytes(serving.view()))
  let listing = run Render.markdown(&reported)
  run Writer.writeAll(String.utf8Bytes(listing.view()))
  let chart = run Html.page(&reported)
  run Format.format(
    "lines html: unit {} mismatch {}\n",
    &(has(chart.view(), "k req/s</text>"), has(chart.view(), "The checks differ")),
  )
  let exported = run Lines.fromResult(&result)
  let reread = run Lines.parse(exported.view())
  run Format.format(
    "lines export: {} lines, first {} by {}\n",
    &(
      reread.lines.length(),
      reread.lines.asSlice()[0].name.view(),
      match Lines.setting(&reread, 0, "impl") {
        Option<string>.Some { value } => value
        Option<string>.None => "nobody"
      },
    ),
  )
  let kept = run Lines.fromResult(&lines)
  let same = run Lines.parse(kept.view())
  run Format.format(
    "lines kept: {} lines, first {} x{} with {} values\n",
    &(
      same.lines.length(),
      same.lines.asSlice()[0].name.view(),
      same.lines.asSlice()[0].iterations,
      same.lines.asSlice()[0].values.length(),
    ),
  )

  // History: two runs of one suite, the journal, and the table over time.
  let mut later = run fixture()
  later.id = run String.copy("20261120T090000Z-7")
  later.started = run String.copy("2026-11-20T09:00:00Z")
  later.revision = Option<String>.Some { value: run String.copy("9f3e5a7700aa") }
  let mut faster = List<Measured>.make()
  run faster.append(run benchmark("twitter", 800000))
  run faster.append(run benchmark("canada", 4000))
  later.benchmarks = move faster
  let second = run Reports.make(&later, 0.01)
  let mut recorded = run History.lines(&report)
  run recorded.appendOwned(run History.lines(&second))
  let entries = run History.parse(recorded.view())
  let mut journal = run Journal.added("", "1503ff0", "baseline")
  journal = run Journal.added(journal.view(), "2026-11-20", "two-pass parse")
  journal = run Journal.added(journal.view(), "2026-11-20", "and a smaller buffer")
  run Writer.writeAll(String.utf8Bytes(journal.view()))
  let notes = run Journal.parse(journal.view())
  let past = run History.terminal(entries.asSlice(), notes.asSlice(), false)
  run Writer.writeAll(String.utf8Bytes(past.view()))
  let pastColored = run History.terminal(entries.asSlice(), notes.asSlice(), true)
  let pastMarkdown = run History.markdown(entries.asSlice(), notes.asSlice())
  let pastPage = run History.page("parse", entries.asSlice(), notes.asSlice())
  run Format.format(
    "history: {} entries, green {} markdown {} chart {} marker {} static {}\n",
    &(
      entries.length(),
      has(pastColored.view(), "\x1b[32m-20.0% faster\x1b[0m"),
      has(pastMarkdown.view(), "## parse/file=twitter, silk"),
      has(pastPage.view(), "<path class=\"line s0\""),
      has(pastPage.view(), "<li>9f3e5a7700: two-pass parse and a smaller buffer</li>"),
      lacks(pastPage.view(), "<script"),
    ),
  )
  let metrics = run History.bencher(&reported)
  run Writer.writeAll(String.utf8Bytes(metrics.view()))

  // Views: declared as text, resolved by the report, and only drawn by the renderers.
  let mut viewed = run fixture()
  let mut sized = List<Measured>.make()
  run sized.append(run benchmark("10", 1000))
  run sized.append(run benchmark("100", 9000))
  run sized.append(run benchmark("1000", 120000))
  viewed.benchmarks = move sized
  let picked = run Reports.make(&viewed, 0.01)
  run Format.format(
    "views picked: {} {} by {}\n",
    &(
      picked.views.asSlice()[0].kind.view(),
      picked.views.asSlice()[1].kind.view(),
      picked.views.asSlice()[1].x.view(),
    ),
  )
  let mut line = run View.line("file")
  run line.logLog()
  run viewed.views.append(run line.text())
  let mut against = run View.ratio()
  run against.normalize("silk")
  run against.title("rust and go \"against\" silk")
  let written = run against.text()
  let parsedView = run View.parse(written.view())
  let rewritten = run parsedView.text()
  run Format.format(
    "view: {} round trip {}\n",
    &(written.view(), rewritten.view() == written.view()),
  )
  run viewed.views.append(move written)
  run viewed.views.append(run String.copy("distribution"))
  run viewed.views.append(run String.copy("percentiles"))
  run viewed.views.append(run String.copy("bars y=peak-B error=range sort=-value"))
  run viewed.views.append(run String.copy("x-flame stat=min depth=3 series=file x=impl"))
  run viewed.views.append(run String.copy("history"))
  let mut shown = run Reports.make(&viewed, 0.01)
  run History.drawn(&mut shown, entries.asSlice())
  let charts = run Render.terminal(&shown, false)
  let tables = run Render.terminal(&picked, false)

  // The tables come first and are the same; the views follow them.
  let rest = String.find(charts.view(), "Time by file")
  if let Option<usize>.Some { value } = rest {
    run Writer.writeAll(
      String.utf8Bytes(
        String.slice(charts.view(), value, String.byteLength(charts.view()) - value),
      ),
    )
  }
  let chartsMarkdown = run Render.markdown(&shown)
  let chartsPage = run Html.page(&shown)
  let flame = &shown.views.asSlice()[5]
  run Format.format(
    "views: tables first {} markdown {} line {} log {} one {} strip {} faded {} bars {} pivot {} field {}={} history {}\n",
    &(
      has(tables.view(), "parse/file=10  10 runs"),
      has(chartsMarkdown.view(), "## Time by file\n\n| impl | 10 | 100 | 1000 |"),
      has(chartsPage.view(), "<path class=\"line s1\""),
      has(chartsPage.view(), ">1.00 ms</text>"),
      has(chartsPage.view(), "<line class=\"one\""),
      has(chartsPage.view(), "<circle class=\"s2\" r=\"2.5\""),
      has(chartsPage.view(), "<circle class=\"s0 faded\""),
      has(chartsPage.view(), "<rect class=\"s1\""),
      has(chartsPage.view(), "<th style=\"text-align:left\">file</th>"),
      flame.fields.asSlice()[1].name.view(),
      flame.fields.asSlice()[1].value.view(),
      shown.views.asSlice()[6].panels.length(),
    ),
  )

  // The report survives its JSON form.
  let encoded = run Encoding.json<Report>(&report)
  let decoded = run SchemaJson.decode<Report>(encoded.asSlice())
  let again = run Render.terminal(&decoded, false)
  let raw = run Encoding.json<RunResult>(&result)
  let samples = run SchemaJson.decode<RunResult>(raw.asSlice())
  run Format.format(
    "json: report {} result {} samples {}\n",
    &(
      again.view() == table.view(),
      samples.benchmarks.asSlice()[1].name.view(),
      samples.benchmarks.asSlice()[0].samples.length(),
    ),
  )
  run driven()
  if !run process() {
    run Format.format("process: FAILED\n", &())
    return 1
  }
  run Format.format("process: ok\n", &())
  return 0
}

pub effect fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut out = StdoutWriter.make()
  let mut clock = OsMonotonicClock.make()
  let outcome = run Effect.result(program())
    |> Effect.provideMut<Allocator>(&mut allocator)
    |> Effect.provideMut<Writer>(&mut out)
    |> Effect.provideMut<MonotonicClock>(&mut clock)
  return match move outcome {
    Result<
      i32,
      OutOfMemoryError | WriterError | SchemaError | TaskError | FileError | TransportError
    >.Success {
      value
    } => value
    Result<
      i32,
      OutOfMemoryError | WriterError | SchemaError | TaskError | FileError | TransportError
    >.Failure {
      ..
    } => 2
  }
}
