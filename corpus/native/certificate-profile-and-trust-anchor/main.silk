  let leafResult = run decoded(b"\x30\x82\x01\xa3\x30\x82\x01\x49\xa0\x03\x02\x01\x02\x02\x14\x07\x23\xdb\xda\x34\x1a\x99\xcb\x73\xab\x95\xd8\xa0\x9a\x48\xf6\x34\x05\x6d\xcd\x30\x0a\x06\x08\x2a\x86\x48\xce\x3d\x04\x03\x02\x30\x1a\x31\x18\x30\x16\x06\x03\x55\x04\x03\x0c\x0f\x78\x35\x30\x39\x2d\x6c\x69\x6d\x62\x6f\x2d\x72\x6f\x6f\x74\x30\x20\x17\x0d\x37\x30\x30\x31\x30\x31\x30\x30\x30\x30\x30\x31\x5a\x18\x0f\x32\x39\x36\x39\x30\x35\x30\x33\x30\x30\x30\x30\x30\x31\x5a\x30\x16\x31\x14\x30\x12\x06\x03\x55\x04\x03\x0c\x0b\x65\x78\x61\x6d\x70\x6c\x65\x2e\x63\x6f\x6d\x30\x59\x30\x13\x06\x07\x2a\x86\x48\xce\x3d\x02\x01\x06\x08\x2a\x86\x48\xce\x3d\x03\x01\x07\x03\x42\x00\x04\x2c\x05\xc7\x18\x22\x45\x35\xc0\xc1\x9d\x7d\xd7\x6c\xac\xd9\x87\x60\xe1\xa6\x5b\xa7\xa7\x6b\xff\xe4\xfe\x9a\x99\x81\xe2\x61\x5f\x93\xe5\x14\x5a\xf3\x17\x2c\x65\xdb\x29\xfe\x66\xff\x47\x90\xb9\x60\xb0\xfe\x98\xdd\x99\xa3\x32\x7f\x20\xee\x14\xea\xde\x6b\xc6\xa3\x6f\x30\x6d\x30\x1d\x06\x03\x55\x1d\x0e\x04\x16\x04\x14\x56\xaf\x1e\xba\xe0\x60\x6c\x3e\x04\x07\x24\xda\x8a\xb1\x27\x73\x66\xbf\x8e\x90\x30\x1f\x06\x03\x55\x1d\x23\x04\x18\x30\x16\x80\x14\xd4\x68\x31\x6b\x88\x2d\x9b\x65\xf0\x7b\x9f\xbe\x9f\x8a\x70\x2a\xd8\xd5\x56\xd7\x30\x13\x06\x03\x55\x1d\x25\x04\x0c\x30\x0a\x06\x08\x2b\x06\x01\x05\x05\x07\x03\x01\x30\x16\x06\x03\x55\x1d\x11\x04\x0f\x30\x0d\x82\x0b\x65\x78\x61\x6d\x70\x6c\x65\x2e\x63\x6f\x6d\x30\x0a\x06\x08\x2a\x86\x48\xce\x3d\x04\x03\x02\x03\x48\x00\x30\x45\x02\x21\x00\xe1\xcb\xb7\x23\x5c\x55\xd9\x1a\xff\xea\xf7\xc8\xa5\xf6\xb6\x5f\xd2\x96\xf7\xac\x96\x9f\x84\xd4\x0e\xab\x6c\xfa\x20\x3a\x7b\x81\x02\x20\x1b\x30\x11\xeb\x7e\xeb\x1a\x45\x61\xef\x55\x2f\xcc\x1e\x0c\xed\x07\xc3\xa4\xba\x41\x04\xec\xb4\x4a\xa4\x00\x6b\x1c\xcf\xc2\x67")
  let leafCertificate = match move leafResult {
    Result<Certificate, DecodeError>.Failure {error} => { return 1 }
    Result<Certificate, DecodeError>.Success {value} => move value
  }
  let rootResult = run decoded(b"\x30\x82\x01\x90\x30\x82\x01\x35\xa0\x03\x02\x01\x02\x02\x14\x03\x3b\xbd\xe3\x66\x0d\xa6\xde\x1f\xc2\x5b\x33\x63\x0d\xc9\x8d\xcc\xd6\x19\x45\x30\x0a\x06\x08\x2a\x86\x48\xce\x3d\x04\x03\x02\x30\x1a\x31\x18\x30\x16\x06\x03\x55\x04\x03\x0c\x0f\x78\x35\x30\x39\x2d\x6c\x69\x6d\x62\x6f\x2d\x72\x6f\x6f\x74\x30\x20\x17\x0d\x37\x30\x30\x31\x30\x31\x30\x30\x30\x30\x30\x31\x5a\x18\x0f\x32\x39\x36\x39\x30\x35\x30\x33\x30\x30\x30\x30\x30\x31\x5a\x30\x1a\x31\x18\x30\x16\x06\x03\x55\x04\x03\x0c\x0f\x78\x35\x30\x39\x2d\x6c\x69\x6d\x62\x6f\x2d\x72\x6f\x6f\x74\x30\x59\x30\x13\x06\x07\x2a\x86\x48\xce\x3d\x02\x01\x06\x08\x2a\x86\x48\xce\x3d\x03\x01\x07\x03\x42\x00\x04\x0d\xe7\xe2\x78\x28\xff\xe1\x23\x33\x09\x8f\xe1\xaf\x15\x50\xb5\x04\x45\x09\xfb\xb5\x1f\xe0\x40\xa9\xea\x77\x4b\xf4\x43\x91\x4f\x28\xc8\xa8\x65\x38\x71\x44\xac\xf7\x06\x99\xdc\x49\x64\x11\xf7\x58\x52\x2a\xa1\x26\x75\x07\x0e\xd6\x27\x0a\x15\xe1\xf4\x0c\x62\xa3\x57\x30\x55\x30\x0f\x06\x03\x55\x1d\x13\x01\x01\xff\x04\x05\x30\x03\x01\x01\xff\x30\x0b\x06\x03\x55\x1d\x0f\x04\x04\x03\x02\x01\x06\x30\x16\x06\x03\x55\x1d\x11\x04\x0f\x30\x0d\x82\x0b\x65\x78\x61\x6d\x70\x6c\x65\x2e\x63\x6f\x6d\x30\x1d\x06\x03\x55\x1d\x0e\x04\x16\x04\x14\xd4\x68\x31\x6b\x88\x2d\x9b\x65\xf0\x7b\x9f\xbe\x9f\x8a\x70\x2a\xd8\xd5\x56\xd7\x30\x0a\x06\x08\x2a\x86\x48\xce\x3d\x04\x03\x02\x03\x49\x00\x30\x46\x02\x21\x00\x8a\x62\x18\xc3\x9e\xb2\x6a\xaa\x73\x82\x8d\x43\x75\x00\xa9\x05\x64\x01\x17\x59\xfd\xc7\xcd\xc0\x48\x49\x65\x03\x51\x9d\x24\x68\x02\x21\x00\xa8\xd8\x73\xca\x56\x7b\xb1\x2d\x77\x21\x86\x11\xc4\x92\x7c\xac\xc0\xc4\xe6\x86\x28\xe8\x99\xc5\x2b\x88\xb3\x63\x7c\x22\x9f\xa4")
  let rootCertificate = match move rootResult {
    Result<Certificate, DecodeError>.Failure {error} => { return 2 }
    Result<Certificate, DecodeError>.Success {value} => move value
  }
  if !leafGetters(
    CertificateProfile.inspect(
      &leafCertificate,
      CertificateRole.ServerLeaf,
      ProfileLimits.defaults(),
    ),
    &leafCertificate,
  ) { return 3 }
  if !rootGetters(
    CertificateProfile.inspect(
      &rootCertificate,
      CertificateRole.Anchor,
      ProfileLimits.defaults(),
    ),
