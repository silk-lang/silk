import silk.core.result { Result }
import silk.crypto.modular { ModularError, Modulus, Natural }
import silk.collections.slice { Slice }

fn nat(bytes: &[u8]) -> Natural {
  return match Natural.fromBytes(bytes) {
    Result<Natural, ModularError>.Success { value } => value
    Result<Natural, ModularError>.Failure { error: _ } => Natural.zero()
  }
}

fn modulus(bytes: &[u8]) -> Modulus {
  return match Modulus.make(&nat(bytes)) {
    Result<Modulus, ModularError>.Success { value } => move value
    Result<Modulus, ModularError>.Failure { error: _ } => {
      Intrinsic.trap("modulus")
    }
  }
}

fn same(value: &Natural, expected: &[u8]) -> bool {
  let mut buffer: [u8; 1024] = [0; 1024]
  let view = Slice.viewMut<u8>(&mut buffer, 0, expected.length)
  match value.writeBytes(move view) {
    Result<(), ModularError>.Success { value: _ } => {}
    Result<(), ModularError>.Failure { error: _ } => {
      return false
    }
  }
  let mut i: usize = 0
  while i < expected.length {
    if buffer[i] != expected[i] {
      return false
    }
    i = i + 1
  }
  return true
}

fn powerCase(m: &[u8], b: &[u8], e: &[u8], expected: &[u8]) -> i32 {
  let modulus = modulus(m)
  let base = nat(b)
  let exponent = nat(e)
  if !same(&modulus.power(&base, &exponent), expected) {
    return 1
  }
  if !same(&modulus.powerPublic(&base, &exponent), expected) {
    return 2
  }
  return 0
}

