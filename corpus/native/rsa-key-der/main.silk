import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.crypto.rsa { RsaError, RsaPrivateKey, RsaPublicKey }

fn equal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut i: usize = 0
  while i < left.length {
    if left[i] != right[i] {
      return false
    }
    i = i + 1
  }
  return true
}

// Reads the four encodings and writes each back, which must give the same bytes.
fn roundTrip(pkcs1: &[u8], pkcs8: &[u8], public: &[u8], spki: &[u8]) -> i32 {
  let mut buffer: [u8; 4096] = [0; 4096]
  let fromPkcs1 = match RsaPrivateKey.fromPkcs1Der(pkcs1) {
    Result<RsaPrivateKey, RsaError>.Success { value } => move value
    Result<RsaPrivateKey, RsaError>.Failure { error: _ } => {
      return 1
    }
  }
  if fromPkcs1.pkcs1DerLength() != pkcs1.length {
    return 2
  }
  match fromPkcs1.writePkcs1Der(&mut buffer) {
    Result<usize, RsaError>.Success { value } => {
      if !equal(Slice.view<u8>(&buffer, 0, value), pkcs1) {
        return 3
      }
    }
    Result<usize, RsaError>.Failure { error: _ } => {
      return 3
    }
  }
  let fromPkcs8 = match RsaPrivateKey.fromPkcs8Der(pkcs8) {
    Result<RsaPrivateKey, RsaError>.Success { value } => move value
    Result<RsaPrivateKey, RsaError>.Failure { error: _ } => {
      return 4
    }
  }
  if fromPkcs8.pkcs8DerLength() != pkcs8.length {
    return 5
  }
  match fromPkcs8.writePkcs8Der(&mut buffer) {
    Result<usize, RsaError>.Success { value } => {
      if !equal(Slice.view<u8>(&buffer, 0, value), pkcs8) {
        return 6
      }
    }
    Result<usize, RsaError>.Failure { error: _ } => {
      return 6
    }
  }
  let derived = fromPkcs8.publicKey()
  match derived.writePkcs1Der(&mut buffer) {
    Result<usize, RsaError>.Success { value } => {
      if !equal(Slice.view<u8>(&buffer, 0, value), public) {
        return 7
      }
    }
    Result<usize, RsaError>.Failure { error: _ } => {
      return 7
    }
  }
  match derived.writeSpkiDer(&mut buffer) {
    Result<usize, RsaError>.Success { value } => {
      if !equal(Slice.view<u8>(&buffer, 0, value), spki) || derived.spkiDerLength() != spki.length {
        return 8
      }
    }
    Result<usize, RsaError>.Failure { error: _ } => {
      return 8
    }
  }
  let fromSpki = match RsaPublicKey.fromSpkiDer(spki) {
    Result<RsaPublicKey, RsaError>.Success { value } => move value
    Result<RsaPublicKey, RsaError>.Failure { error: _ } => {
      return 9
    }
  }
  let fromPublic = match RsaPublicKey.fromPkcs1Der(public) {
    Result<RsaPublicKey, RsaError>.Success { value } => move value
    Result<RsaPublicKey, RsaError>.Failure { error: _ } => {
      return 10
    }
  }
  if !fromSpki.modulus().equals(&fromPublic.modulus())
    || !fromSpki.exponent().equals(&derived.exponent()) {
    return 11
  }
  match derived.writeSpkiDer(Slice.viewMut<u8>(&mut buffer, 0, spki.length - 1)) {
    Result<usize, RsaError>.Failure { error: RsaError.InvalidLength } => {}
    _ => {
      return 12
    }
  }
  return 0
}

fn privateFails(result: Result<RsaPrivateKey, RsaError>, expected: RsaError) -> bool {
  return match move result {
    Result<RsaPrivateKey, RsaError>.Success { value: _ } => false
    Result<RsaPrivateKey, RsaError>.Failure { error } => error == expected
  }
}

fn publicFails(result: Result<RsaPublicKey, RsaError>, expected: RsaError) -> bool {
  return match move result {
    Result<RsaPublicKey, RsaError>.Success { value: _ } => false
    Result<RsaPublicKey, RsaError>.Failure { error } => error == expected
  }
}

fn decryptCase(key: &RsaPrivateKey, ciphertext: &[u8], expected: &[u8]) -> bool {
  let mut output: [u8; 512] = [255; 512]
  let width = key.publicKey().byteLength()
  return match key.decryptPkcs1(ciphertext, Slice.viewMut<u8>(&mut output, 0, width)) {
    Result<usize, RsaError>.Success { value } => {
      let mut zeros = true
      let mut i = value
      while i < width {
        if output[i] != 0 {
          zeros = false
        }
        i = i + 1
      }
      zeros && equal(Slice.view<u8>(&output, 0, value), expected)
    }
    Result<usize, RsaError>.Failure { error: _ } => false
  }
}

fn parsed(der: &[u8]) -> RsaPrivateKey {
  return match RsaPrivateKey.fromPkcs1Der(der) {
    Result<RsaPrivateKey, RsaError>.Success { value } => move value
    Result<RsaPrivateKey, RsaError>.Failure { error: _ } => Intrinsic.trap("key")
  }
}

