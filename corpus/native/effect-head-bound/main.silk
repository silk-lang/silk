// A conditional conformance whose bound names the error type inside an `Effect` provider: the
// error type is a structural part of the provider, so the bound descends (IMPL-008).
import silk.core.effect { Effect }
import silk.text.format { Debug, Format, Formatter }
import silk.io.writer { Writer, WriterError }
import silk.num.usize

pub struct Oops {
  pub code: i32,
}

impl Debug for Oops {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return run Format.debugFields(self, "Oops", &mut formatter)
  }
}

struct Counter {
  count: i32,
}

impl Writer for Counter {
  effect fn writeAll(self: &mut Self, bytes: &[u8]) -> ()
    ! WriterError
    ? &mut Writer {
    self.count = self.count + usize.toI32(bytes.length)
    return ()
  }

  effect fn flush(self: &mut Self) -> ()
    ! WriterError
    ? &mut Writer {
    return ()
  }
}

effect fn ignored(error: WriterError) -> () {
  drop error
  return ()
}

// The status is 26 plus the length of the error's `Debug` form.
effect<'env> fn failed<E: Debug + 'env, 'env>(error: E) -> i32 {
  let mut counter = Counter { count: 0 }
  let written = Format.debug<E>(&error) |> Effect.provideMut<Writer>(&mut counter)
  run Effect.catchAll(move written, ignored)
  drop error
  return 26 + counter.count
}

struct Runner<T> {}

interface Outcome<T> {
  fn status(value: T) -> i32
}

impl<'env, E: Debug> Outcome<Effect<'env; i32 ! E>> for Runner<Effect<'env; i32 ! E>> {
  fn status(value: Effect<'env; i32 ! E>) -> i32 {
    return run Effect.catchAll(move value, failed)
  }
}

fn select<T>(value: &T) -> Runner<T> {
  return Runner<T> {}
}

fn adapt<T, P: Outcome<T>>(value: T, provider: P) -> i32 {
  return Outcome<T>.status(move value)
}

effect fn attempt() -> i32
  ! Oops {
  fail Oops { code: 2 }
}

pub fn main() -> i32 {
  let value = attempt()
  let provider = select(&value)
  return adapt(move value, move provider)
}
