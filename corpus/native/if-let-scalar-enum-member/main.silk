enum Color { Red, Green, Blue }
fn pick(c: Color) -> i32 {
  if let Color.Green = c { return 10 }
  if let Color.Blue = c {
    return 20
  } else {
    return 1
  }
}
pub fn main() -> i32 {
  if pick(Color.Green) != 10 { return 2 }
  if pick(Color.Blue) != 20 { return 3 }
  if pick(Color.Red) != 1 { return 4 }
  return 42
}
