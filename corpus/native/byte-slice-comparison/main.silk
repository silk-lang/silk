import silk.core.equal { Equal }
import silk.core.order { Order, Ordering }

struct Value<T> {
  value: T,
}

impl<T: Equal> Equal for Value<T> {
  fn equals(left: &Self, right: &Self) -> bool {
    return &left.value == &right.value
  }
}

fn before<T: Order>(left: &T, right: &T) -> bool { return Order.compare(left, right) == Ordering.Less }

// `==` and `!=` compare two byte slices by their bytes, as they compare two `string` values.
fn same(left: &[u8], right: &[u8]) -> bool { return left == right }
fn other(left: &mut [u8], right: &[u8]) -> bool { return left != right }

pub fn main() -> i32 {
  if !same(b"abc", b"abc") || same(b"abc", b"abd") || same(b"ab", b"abc") || !same(b"", b"") { return 1 }
  let mut buffer: [u8; 2] = [97, 98]
  if other(&mut buffer, b"ab") || !other(&mut buffer, b"ba") { return 2 }
  // A shared slice conforms to `Equal` and `Order` when its element does, element by element.
  let short: &[u8] = b"ab"
  let long: &[u8] = b"abc"
  if Order.compare(&short, &long) != Ordering.Less || Order.compare(&long, &short) != Ordering.Greater { return 3 }
  if Order.compare(&short, &short) != Ordering.Equal { return 4 }
  let numbers: [i32; 2] = [1, 2]
  let others: [i32; 2] = [1, 3]
  let left: &[i32] = &numbers
  let right: &[i32] = &others
  if Equal.equals(&left, &right) || !Equal.equals(&left, &left) { return 5 }
  let first = Value<&[u8]> { value: b"x" }
  let second = Value<&[u8]> { value: b"x" }
  if !(&first == &second) { return 6 }
  if !before(&short, &long) || before(&long, &short) { return 7 }
  return 42
}
