import silk.core.effect { Effect }
import silk.num.usize

pub struct NotFoundError {}

effect fn load() -> i32 ! NotFoundError {
  fail NotFoundError {}
}

effect fn lookup() -> i32 ! NotFoundError {
  return run load()
}

// A handler that reports the failure itself asks the observer for the call path only.
effect fn recover(error: NotFoundError) -> i32 {
  drop error
  let status = Intrinsic.observeHandled()
  return usize.toI32(status) + 6
}

pub effect fn main() -> i32 {
  return run Effect.catch<NotFoundError>(lookup(), recover)
}
