//! A package fingerprint skips `node_modules` at the package root, and names a link that leaves
//! the package by its target instead of failing, as pnpm's `node_modules` links and a workspace
//! link to a sibling package need.

import silk.build.fingerprint as Fingerprint
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.crypto.sha2 { Sha256 }
import silk.io.writer_native { StderrWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.num.usize
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.system.filesystem_native { OsFileSystem }
import silk.text.string { String }

static if Intrinsic.targetOperatingSystem() != "windows" {
  @foreign(noCapture: ("target", "path"))
  unsafe extern "C" fn symlink(target: ?[*]const u8, path: ?[*]const u8) -> i32
}

// Build steps fingerprint host paths, so the provider is rooted at `/`. On macOS `/tmp` is a link
// to `/private/tmp`.
static if Intrinsic.targetOperatingSystem() == "darwin" {
  const TEMPORARY: string = "/private/tmp"
} else {
  const TEMPORARY: string = "/tmp"
}

// A failed expectation, reported on standard error before the program exits with 1.
struct Failed {
  message: string<'static>,
}

effect fn expect(holds: bool, message: string<'static>) -> ()
  ! Failed {
  if !holds {
    fail Failed { message: message }
  }
}

// The digest of the files below `tree`.
effect fn digest(tree: &Path, output: &Path) -> [u8; 32]
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut hash = Sha256.make()
  run Fingerprint.package(&mut hash, tree, output)
  return hash.finish()
}

fn same(left: &[u8; 32], right: &[u8; 32]) -> bool {
  let mut at = usize.ZERO
  while at < 32 {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// Links `path` below `tree` to `target`.
effect fn link(tree: &Path, path: string, target: &Path) -> ()
  ! Failed | OutOfMemoryError
  ? &mut Allocator {
  static if Intrinsic.targetOperatingSystem() != "windows" {
    let mut at = run Bytes.copy(Path.rawBytes(tree))
    run Bytes.append(&mut at, b"/")
    run Bytes.append(&mut at, String.utf8Bytes(path))
    run Bytes.append(&mut at, b"\0")
    let mut to = run Bytes.copy(Path.rawBytes(target))
    run Bytes.append(&mut to, b"\0")
    let made = unsafe symlink(
      Pointer.fromSlice(Bytes.asSlice(&to)),
      Pointer.fromSlice(Bytes.asSlice(&at)),
    )
    run expect(made == 0, "the fixture link is made")
  }
}

effect fn cases(scratch: &Path) -> ()
  ! Failed | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let tree = run Path.join(scratch, "tree")
  let output = run Path.join(scratch, "output")
  let first = run Path.join(scratch, "first")
  let second = run Path.join(scratch, "second")
  run FileSystem.writeFileWithParents(&run Path.join(&tree, "src/main.silk"), b"main")
  run FileSystem.writeFileWithParents(&run Path.join(&first, "index.js"), b"one")
  run FileSystem.writeFileWithParents(&run Path.join(&second, "index.js"), b"two")
  let installed = run Path.join(&tree, "node_modules/local/index.js")
  run FileSystem.writeFileWithParents(&installed, b"one")
  run link(&tree, "node_modules/react", &first)
  run link(&tree, "vendor", &first)

  let start = run digest(&tree, &output)
  let again = run digest(&tree, &output)
  run expect(same(&start, &again), "a package with links out of it has one digest")
  run FileSystem.writeFile(&installed, b"two")
  run expect(same(&start, &run digest(&tree, &output)), "node_modules does not count")
  run FileSystem.writeFile(&run Path.join(&first, "index.js"), b"three")
  run expect(same(&start, &run digest(&tree, &output)), "files outside the package do not count")
  run FileSystem.removeFile(&run Path.join(&tree, "vendor"))
  run link(&tree, "vendor", &second)
  run expect(!same(&start, &run digest(&tree, &output)), "a link's target counts")
}

effect fn program() -> i32
  ! Failed | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let parent = run Path.make(TEMPORARY)
  let scratch = run FileSystem.temporaryDirectory(&parent, "silk-fingerprint-links-")
  let outcome = run Effect.result(cases(&scratch.path))
  run FileSystem.release(move scratch)
  return match move outcome {
    Result<(), Failed | FileError | OutOfMemoryError>.Success { .. } => 0
    Result<(), Failed | FileError | OutOfMemoryError>.Failure { error } => {
      fail move error
    }
  }
}

effect fn failed(error: Failed | FileError | OutOfMemoryError) -> i32 {
  return match move error {
    Failed failure => {
      StderrWriter.print("failed: {}\n", &.(failure.message))
      return 1
    }
    FileError file => {
      drop file
      return 2
    }
    OutOfMemoryError exhausted => {
      drop exhausted
      return 3
    }
  }
}

effect fn withFiles() -> i32
  ! Failed | FileError | OutOfMemoryError
  ? &mut Allocator {
  let mut files = run OsFileSystem.makeBytes(b"/")
  return run program() |> Effect.provideMut<FileSystem>(&mut files)
}

pub fn main() -> i32 {
  // Windows links need a privilege the test host may lack, and its paths are not rooted at `/`.
  static if Intrinsic.targetOperatingSystem() == "windows" {
    return 0
  } else {
    let mut allocator = Allocator.systemAllocatorProvider()
    return run Effect.catchAll(withFiles(), failed) |> Effect.provideMut<Allocator>(&mut allocator)
  }
}
