fn extras() -> i32 {
  // Wrong key and IV lengths.
  if let Result.Success { value: _ } = Sm4.make(b"short") { return 1 }
  if let Result.Success { value: _ } = TripleDes.make(b"0123456789abcdef01234567x") { return 2 }
  if let Result.Success { value: _ } = Camellia.make(b"0123456789abcdef0") { return 9 }
  if let Result.Success { value: _ } = Aria.make(b"0123456789abcdef0123456789abcdef0") { return 10 }
  if let Result.Success { value: _ } = Cbc<Sm4>.encryptor(sm4(b"0123456789abcdef"), b"01234567", true) { return 3 }
  if let Result.Success { value: _ } = Ctr<TripleDes>.make(tripleDes(b"0123456789abcdef"), b"0123456789abcdef") { return 4 }
  // A bad padding byte fails.
  let mut opened: [u8; 96] = [0; 96]
  let garbage: [u8; 16] = [9; 16]
  if runCbcDecryptor(sm4(b"0123456789abcdef"), b"0123456789abcdef", &garbage, true, &mut opened) != 1000 { return 5 }
  // Without padding a partial block fails at finish.
  let partial: [u8; 5] = [1; 5]
  if runEcbEncryptor(tripleDes(b"0123456789abcdef"), &partial, false, &mut opened) != 1000 { return 6 }
  // Too small output.
  let mut stream = match Ofb<Sm4>.make(sm4(b"0123456789abcdef"), b"0123456789abcdef") {
    Result<Ofb<Sm4>, BlockCipherError>.Success { value } => move value
    Result<Ofb<Sm4>, BlockCipherError>.Failure { error: _ } => {
      return 7
    }
  }
  let mut small: [u8; 2] = [0; 2]
  if let Result.Success { value: _ } = stream.apply(b"abc", &mut small) { return 8 }
  return 0
}

pub fn main() -> i32 {
  let failed = vectors()
  if failed != 0 { return failed }
  let extra = extras()
  if extra != 0 { return 500 + extra }
  return 42
}
