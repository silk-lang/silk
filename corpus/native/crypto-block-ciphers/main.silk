import silk.crypto.block_cipher { BlockCipher, BlockCipherError, Cbc, Cfb, Cfb1, Cfb8, Ctr, Ecb, Ofb }
import silk.crypto.sm4 { Sm4 }
import silk.crypto.des { TripleDes }
import silk.crypto.camellia { Camellia }
import silk.crypto.aria { Aria }
import silk.collections.slice { Slice }
import silk.core.result { Result }

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut index: usize = 0
  while index < left.length {
    if left[index] != right[index] { return false }
    index = index + 1
  }
  return true
}

fn written(result: Result<usize, BlockCipherError>) -> usize {
  return match move result {
    Result<usize, BlockCipherError>.Success { value } => value
    Result<usize, BlockCipherError>.Failure { error: _ } => 1000
  }
}

fn sm4(key: &[u8]) -> Sm4 {
  return match Sm4.make(key) {
    Result<Sm4, BlockCipherError>.Success { value } => move value
    Result<Sm4, BlockCipherError>.Failure { error: _ } => Intrinsic.trap("test key")
  }
}

fn tripleDes(key: &[u8]) -> TripleDes {
  return match TripleDes.make(key) {
    Result<TripleDes, BlockCipherError>.Success { value } => move value
    Result<TripleDes, BlockCipherError>.Failure { error: _ } => Intrinsic.trap("test key")
  }
}

fn camellia(key: &[u8]) -> Camellia {
  return match Camellia.make(key) {
    Result<Camellia, BlockCipherError>.Success { value } => move value
    Result<Camellia, BlockCipherError>.Failure { error: _ } => Intrinsic.trap("test key")
  }
}

fn aria(key: &[u8]) -> Aria {
  return match Aria.make(key) {
    Result<Aria, BlockCipherError>.Success { value } => move value
    Result<Aria, BlockCipherError>.Failure { error: _ } => Intrinsic.trap("test key")
  }
}

fn runEcbEncryptor<C: BlockCipher>(cipher: C, input: &[u8], padding: bool, output: &mut [u8]) -> usize {
  let mut state = Ecb<C>.encryptor(move cipher, padding)
  let split = input.length / 2 + 1
  let mut first = split
  if first > input.length {
    first = input.length
  }
  let one = written(state.update(Slice.view<u8>(input, 0, first), Slice.viewMut<u8>(&mut output, 0, 96)))
  if one > 96 { return 1000 }
  let rest = 96 - one
  let two = written(state.update(Slice.view<u8>(input, first, input.length - first), Slice.viewMut<u8>(&mut output, one, rest)))
  if two > rest { return 1000 }
  let left = rest - two
  let three = written(state.finish(Slice.viewMut<u8>(&mut output, one + two, left)))
  if three > left { return 1000 }
  return one + two + three
}

fn runEcbDecryptor<C: BlockCipher>(cipher: C, input: &[u8], padding: bool, output: &mut [u8]) -> usize {
  let mut state = Ecb<C>.decryptor(move cipher, padding)
  let split = input.length / 2 + 1
  let mut first = split
  if first > input.length {
    first = input.length
  }
  let one = written(state.update(Slice.view<u8>(input, 0, first), Slice.viewMut<u8>(&mut output, 0, 96)))
  if one > 96 { return 1000 }
  let rest = 96 - one
  let two = written(state.update(Slice.view<u8>(input, first, input.length - first), Slice.viewMut<u8>(&mut output, one, rest)))
  if two > rest { return 1000 }
  let left = rest - two
  let three = written(state.finish(Slice.viewMut<u8>(&mut output, one + two, left)))
  if three > left { return 1000 }
  return one + two + three
}

fn checkEcb<C: BlockCipher>(encrypting: C, decrypting: C, plain: &[u8], expected: &[u8], padding: bool) -> bool {
  let mut sealed: [u8; 96] = [0; 96]
  let length = runEcbEncryptor(move encrypting, plain, padding, &mut sealed)
  if length != expected.length || same(Slice.view<u8>(&sealed, 0, length), expected) == false { return false }
  let mut opened: [u8; 96] = [0; 96]
  let back = runEcbDecryptor(move decrypting, expected, padding, &mut opened)
  return back == plain.length && same(Slice.view<u8>(&opened, 0, back), plain)
}

fn runCbcEncryptor<C: BlockCipher>(cipher: C, iv: &[u8], input: &[u8], padding: bool, output: &mut [u8]) -> usize {
  let mut state = match Cbc<C>.encryptor(move cipher, iv, padding) {
    Result<Cbc<C>, BlockCipherError>.Success { value } => move value
    Result<Cbc<C>, BlockCipherError>.Failure { error: _ } => {
      return 1000
    }
  }
  let split = input.length / 2 + 1
  let mut first = split
  if first > input.length {
    first = input.length
  }
  let one = written(state.update(Slice.view<u8>(input, 0, first), Slice.viewMut<u8>(&mut output, 0, 96)))
  if one > 96 { return 1000 }
  let rest = 96 - one
  let two = written(state.update(Slice.view<u8>(input, first, input.length - first), Slice.viewMut<u8>(&mut output, one, rest)))
  if two > rest { return 1000 }
  let left = rest - two
  let three = written(state.finish(Slice.viewMut<u8>(&mut output, one + two, left)))
  if three > left { return 1000 }
  return one + two + three
}

fn runCbcDecryptor<C: BlockCipher>(cipher: C, iv: &[u8], input: &[u8], padding: bool, output: &mut [u8]) -> usize {
  let mut state = match Cbc<C>.decryptor(move cipher, iv, padding) {
    Result<Cbc<C>, BlockCipherError>.Success { value } => move value
    Result<Cbc<C>, BlockCipherError>.Failure { error: _ } => {
      return 1000
    }
  }
  let split = input.length / 2 + 1
  let mut first = split
  if first > input.length {
    first = input.length
  }
  let one = written(state.update(Slice.view<u8>(input, 0, first), Slice.viewMut<u8>(&mut output, 0, 96)))
  if one > 96 { return 1000 }
  let rest = 96 - one
  let two = written(state.update(Slice.view<u8>(input, first, input.length - first), Slice.viewMut<u8>(&mut output, one, rest)))
  if two > rest { return 1000 }
  let left = rest - two
  let three = written(state.finish(Slice.viewMut<u8>(&mut output, one + two, left)))
  if three > left { return 1000 }
  return one + two + three
}

fn checkCbc<C: BlockCipher>(encrypting: C, decrypting: C, iv: &[u8], plain: &[u8], expected: &[u8], padding: bool) -> bool {
  let mut sealed: [u8; 96] = [0; 96]
  let length = runCbcEncryptor(move encrypting, iv, plain, padding, &mut sealed)
  if length != expected.length || same(Slice.view<u8>(&sealed, 0, length), expected) == false { return false }
  let mut opened: [u8; 96] = [0; 96]
  let back = runCbcDecryptor(move decrypting, iv, expected, padding, &mut opened)
  return back == plain.length && same(Slice.view<u8>(&opened, 0, back), plain)
}

fn runCtrEncryptor<C: BlockCipher>(cipher: C, iv: &[u8], input: &[u8], output: &mut [u8]) -> bool {
  let mut state = match Ctr<C>.make(move cipher, iv) {
    Result<Ctr<C>, BlockCipherError>.Success { value } => move value
    Result<Ctr<C>, BlockCipherError>.Failure { error: _ } => {
      return false
    }
  }
  let first = input.length / 3
  if let Result.Failure { error: _ } = state.apply(Slice.view<u8>(input, 0, first), Slice.viewMut<u8>(&mut output, 0, first)) { return false }
  let rest = input.length - first
  if let Result.Failure { error: _ } = state.apply(Slice.view<u8>(input, first, rest), Slice.viewMut<u8>(&mut output, first, rest)) { return false }
  return true
}

fn runCtrDecryptor<C: BlockCipher>(cipher: C, iv: &[u8], input: &[u8], output: &mut [u8]) -> bool {
  let mut state = match Ctr<C>.make(move cipher, iv) {
    Result<Ctr<C>, BlockCipherError>.Success { value } => move value
    Result<Ctr<C>, BlockCipherError>.Failure { error: _ } => {
      return false
    }
  }
  let first = input.length / 3
  if let Result.Failure { error: _ } = state.apply(Slice.view<u8>(input, 0, first), Slice.viewMut<u8>(&mut output, 0, first)) { return false }
  let rest = input.length - first
  if let Result.Failure { error: _ } = state.apply(Slice.view<u8>(input, first, rest), Slice.viewMut<u8>(&mut output, first, rest)) { return false }
  return true
}

fn checkCtr<C: BlockCipher>(encrypting: C, decrypting: C, iv: &[u8], plain: &[u8], expected: &[u8]) -> bool {
  let mut sealed: [u8; 96] = [0; 96]
  if runCtrEncryptor(move encrypting, iv, plain, &mut sealed) == false { return false }
  if same(Slice.view<u8>(&sealed, 0, plain.length), expected) == false { return false }
  let mut opened: [u8; 96] = [0; 96]
  if runCtrDecryptor(move decrypting, iv, expected, &mut opened) == false { return false }
  return same(Slice.view<u8>(&opened, 0, plain.length), plain)
}

