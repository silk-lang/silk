}

fn vectors() -> i32 {
  // sm4-ecb, 0 bytes
  if checkEcb<Sm4>(sm4(&[82, 242, 38, 101, 166, 12, 18, 210, 137, 24, 93, 149, 14, 232, 129, 54]), sm4(&[82, 242, 38, 101, 166, 12, 18, 210, 137, 24, 93, 149, 14, 232, 129, 54]), b"", &[56, 238, 213, 39, 207, 68, 46, 203, 142, 211, 25, 206, 76, 227, 200, 158], true) == false { return 1 }
  // sm4-ecb, 16 bytes
  if checkEcb<Sm4>(sm4(&[9, 22, 111, 107, 17, 61, 23, 141, 108, 15, 211, 144, 31, 242, 57, 161]), sm4(&[9, 22, 111, 107, 17, 61, 23, 141, 108, 15, 211, 144, 31, 242, 57, 161]), &[160, 149, 242, 15, 147, 149, 101, 12, 249, 56, 11, 142, 219, 34, 74, 107], &[67, 44, 241, 156, 208, 32, 179, 218, 245, 174, 152, 56, 46, 234, 63, 212], false) == false { return 2 }
  // sm4-ecb, 48 bytes
  if checkEcb<Sm4>(sm4(&[36, 138, 30, 146, 78, 143, 208, 174, 46, 26, 148, 146, 163, 48, 95, 24]), sm4(&[36, 138, 30, 146, 78, 143, 208, 174, 46, 26, 148, 146, 163, 48, 95, 24]), &[140, 182, 16, 144, 15, 158, 52, 127, 174, 136, 109, 198, 80, 119, 149, 236, 116, 92, 76, 63, 203, 46, 178, 199, 62, 20, 147, 76, 134, 126, 224, 87, 186, 114, 73, 155, 250, 18, 30, 131, 107, 42, 193, 87, 38, 238, 125, 107], &[127, 26, 72, 234, 117, 1, 238, 118, 130, 110, 73, 238, 3, 123, 41, 59, 77, 235, 2, 162, 116, 68, 175, 51, 221, 57, 175, 230, 198, 200, 155, 247, 66, 38, 26, 14, 55, 46, 177, 51, 172, 2, 32, 234, 212, 136, 78, 135, 2, 97, 187, 240, 214, 228, 146, 28, 51, 17, 114, 206, 151, 66, 20, 70], true) == false { return 3 }
  // sm4-ecb, 37 bytes
  if checkEcb<Sm4>(sm4(&[10, 246, 171, 19, 195, 142, 146, 202, 224, 209, 80, 87, 177, 89, 152, 127]), sm4(&[10, 246, 171, 19, 195, 142, 146, 202, 224, 209, 80, 87, 177, 89, 152, 127]), &[148, 204, 116, 17, 215, 23, 241, 69, 121, 178, 170, 16, 15, 187, 179, 79, 165, 147, 254, 174, 210, 114, 72, 183, 98, 227, 171, 88, 5, 240, 118, 90, 43, 156, 29, 126, 15], &[108, 10, 150, 37, 76, 68, 228, 225, 219, 140, 180, 136, 216, 221, 187, 127, 219, 237, 27, 132, 126, 184, 190, 167, 233, 132, 94, 26, 191, 113, 74, 202, 138, 22, 124, 9, 55, 44, 87, 95, 157, 247, 3, 19, 163, 33, 192, 202], true) == false { return 4 }
  // sm4-ecb, 61 bytes
  if checkEcb<Sm4>(sm4(&[55, 196, 73, 33, 189, 63, 101, 100, 234, 223, 127, 20, 42, 114, 102, 140]), sm4(&[55, 196, 73, 33, 189, 63, 101, 100, 234, 223, 127, 20, 42, 114, 102, 140]), &[71, 226, 35, 209, 110, 221, 140, 71, 180, 106, 252, 91, 174, 226, 97, 245, 59, 38, 21, 45, 38, 59, 168, 59, 3, 124, 212, 150, 46, 67, 72, 1, 37, 107, 136, 94, 156, 144, 81, 243, 32, 176, 219, 131, 243, 158, 167, 173, 189, 13, 116, 230, 222, 199, 243, 223, 174, 204, 143, 100, 101], &[68, 212, 226, 227, 79, 166, 178, 248, 119, 218, 34, 210, 124, 128, 177, 184, 24, 169, 186, 171, 156, 169, 150, 178, 117, 169, 254, 9, 127, 38, 186, 160, 40, 42, 109, 178, 195, 47, 146, 255, 59, 158, 167, 105, 228, 206, 187, 118, 148, 24, 225, 190, 177, 244, 18, 68, 204, 102, 218, 181, 249, 108, 164, 200], true) == false { return 5 }
  // sm4-cbc, 0 bytes
  if checkCbc<Sm4>(sm4(&[102, 100, 26, 123, 162, 102, 15, 48, 17, 252, 53, 112, 41, 28, 87, 153]), sm4(&[102, 100, 26, 123, 162, 102, 15, 48, 17, 252, 53, 112, 41, 28, 87, 153]), &[13, 26, 0, 145, 38, 137, 25, 242, 93, 157, 6, 18, 223, 53, 157, 96], b"", &[171, 222, 49, 121, 26, 125, 56, 170, 241, 206, 8, 194, 12, 74, 50, 162], true) == false { return 6 }
  // sm4-cbc, 16 bytes
  if checkCbc<Sm4>(sm4(&[38, 162, 64, 244, 88, 154, 93, 121, 31, 29, 217, 124, 254, 250, 119, 122]), sm4(&[38, 162, 64, 244, 88, 154, 93, 121, 31, 29, 217, 124, 254, 250, 119, 122]), &[123, 79, 21, 36, 26, 191, 87, 189, 67, 122, 212, 177, 41, 132, 5, 52], &[243, 243, 135, 92, 37, 176, 139, 234, 6, 194, 135, 76, 250, 164, 221, 23], &[242, 162, 202, 92, 239, 215, 240, 53, 163, 213, 127, 96, 19, 190, 25, 29], false) == false { return 7 }
  // sm4-cbc, 48 bytes
