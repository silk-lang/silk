// Consecutive calls put each result in a distinct MIR successor block. Check both the
// direct result ABI and later value consumers, including a pointer whose address never escapes.
fn flag(value: bool) -> bool { return value }
fn narrow(value: i8) -> i8 { return value }
fn number(value: i32) -> i32 { return value }
fn floating(value: f64) -> f64 { return value }
fn pointer<'a>(value: &'a i32) -> &'a i32 { return value }
fn read(value: &i32) -> i32 { return value.* }

struct Pair { left: i32, right: i32 }
fn pair(value: Pair) -> Pair { return move value }
fn pairValue(value: Pair) -> i32 { return value.left + value.right }

pub fn main() -> i32 {
  if !flag(flag(true)) { return 1 }
  if flag(flag(false)) { return 2 }
  if narrow(narrow(-5)) != -5 { return 3 }
  if number(number(42)) != 42 { return 4 }
  if floating(floating(1.25)) != 1.25 { return 5 }
  let held = 42
  if read(pointer(pointer(&held))) != 42 { return 6 }
  // Aggregate results and addressable named locals retain their storage obligations.
  if pairValue(pair(Pair {left: 19, right: 23})) != 42 { return 7 }
  let mut count = 0
  while flag(count < 3) { count = number(count + 1) }
  if count != 3 { return 8 }
  return 42
}
