import silk.tls.certificate { Certificate, CertificateVersion, DecodeLimits, DecodeError, DecodeClass, DecodeReason, DecodeOffsetSpace, AlgorithmView, BitStringView, ExtensionView }
import silk.tls.certificate_bundle { CertificateBundle }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.collections.bytes { Bytes }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.layout { Layout }
import silk.num.usize

fn equal(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length { return false }
  let mut index = usize.ZERO
  while index < a.length {
    if a[index] != b[index] { return false }
    index = index + usize.ONE
  }
  return true
}
fn optionalBytes(value: Option<&[u8]>, expected: &[u8]) -> bool {
  return match move value {
    Option<&[u8]>.None => false
    Option<&[u8]>.Some { value: bytes } => equal(bytes, expected)
  }
}
fn missingBytes(value: Option<&[u8]>) -> bool {
  return match move value {
    Option<&[u8]>.None => true
    Option<&[u8]>.Some { value: bytes } => false
  }
}
fn absentBits<'a>(value: Option<BitStringView<'a>>) -> bool {
  return match move value {
    Option<BitStringView<'a>>.None => true
    Option<BitStringView<'a>>.Some { value: bits } => false
  }
}
fn extension<'a>(value: Option<ExtensionView<'a>>, der: &[u8], oid: &[u8], critical: bool, raw: &[u8]) -> bool {
  return match move value {
    Option<ExtensionView<'a>>.None => false
    Option<ExtensionView<'a>>.Some { value: found } => equal(found.der, der) && equal(found.oid, oid) && found.critical == critical && equal(found.value, raw)
  }
}
fn absentExtension<'a>(value: Option<ExtensionView<'a>>) -> bool {
  return match move value {
    Option<ExtensionView<'a>>.None => true
    Option<ExtensionView<'a>>.Some { value: found } => false
  }
}
fn absentCertificate(value: Option<&Certificate>) -> bool {
  return match move value {
    Option<&Certificate>.None => true
    Option<&Certificate>.Some { value: found } => false
  }
}

fn retained(value: &Certificate) -> bool {
  let expected = b"\x30\x82\x02\x2c\x30\x82\x01\xd2\xa0\x03\x02\x01\x02\x02\x01\x00\x30\x0a\x06\x08\x2a\x86\x48\xce\x3d\x04\x03\x02\x30\x7d\x31\x0b\x30\x09\x06\x03\x55\x04\x06\x13\x02\x42\x45\x31\x0f\x30\x0d\x06\x03\x55\x04\x0a\x13\x06\x47\x6e\x75\x54\x4c\x53\x31\x25\x30\x23\x06\x03\x55\x04\x0b\x13\x1c\x47\x6e\x75\x54\x4c\x53\x20\x63\x65\x72\x74\x69\x66\x69\x63\x61\x74\x65\x20\x61\x75\x74\x68\x6f\x72\x69\x74\x79\x31\x0f\x30\x0d\x06\x03\x55\x04\x08\x13\x06\x4c\x65\x75\x76\x65\x6e\x31\x25\x30\x23\x06\x03\x55\x04\x03\x13\x1c\x47\x6e\x75\x54\x4c\x53\x20\x63\x65\x72\x74\x69\x66\x69\x63\x61\x74\x65\x20\x61\x75\x74\x68\x6f\x72\x69\x74\x79\x30\x1e\x17\x0d\x31\x31\x30\x35\x32\x33\x32\x30\x33\x38\x32\x31\x5a\x17\x0d\x31\x32\x31\x32\x32\x32\x30\x37\x34\x31\x35\x31\x5a\x30\x7d\x31\x0b\x30\x09\x06\x03\x55\x04\x06\x13\x02\x42\x45\x31\x0f\x30\x0d\x06\x03\x55\x04\x0a\x13\x06\x47\x6e\x75\x54\x4c\x53\x31\x25\x30\x23\x06\x03\x55\x04\x0b\x13\x1c\x47\x6e\x75\x54\x4c\x53\x20\x63\x65\x72\x74\x69\x66\x69\x63\x61\x74\x65\x20\x61\x75\x74\x68\x6f\x72\x69\x74\x79\x31\x0f\x30\x0d\x06\x03\x55\x04\x08\x13\x06\x4c\x65\x75\x76\x65\x6e\x31\x25\x30\x23\x06\x03\x55\x04\x03\x13\x1c\x47\x6e\x75\x54\x4c\x53\x20\x63\x65\x72\x74\x69\x66\x69\x63\x61\x74\x65\x20\x61\x75\x74\x68\x6f\x72\x69\x74\x79\x30\x59\x30\x13\x06\x07\x2a\x86\x48\xce\x3d\x02\x01\x06\x08\x2a\x86\x48\xce\x3d\x03\x01\x07\x03\x42\x00\x04\x52\xd8\x8d\x23\x8a\xe3\x67\xd7\x86\x36\xb1\x20\x0b\x09\x7d\xc8\xc9\xba\xa2\x20\x95\x2f\xc5\x4a\x63\xfa\x83\x5f\xce\x78\x2f\x8f\xf3\x62\xca\xfd\xb7\xf7\x80\x56\x9d\x6e\x17\xb9\x0e\x11\x4c\x48\xb2\xc0\xaf\x3b\x59\x17\x16\x30\x68\x09\x07\x99\x17\xfe\xdd\xa7\xa3\x43\x30\x41\x30\x0f\x06\x03\x55\x1d\x13\x01\x01\xff\x04\x05\x30\x03\x01\x01\xff\x30\x0f\x06\x03\x55\x1d\x0f\x01\x01\xff\x04\x05\x03\x03\x07\x06\x00\x30\x1d\x06\x03\x55\x1d\x0e\x04\x16\x04\x14\xf0\xb4\x81\xfe\x98\x12\xbf\xb5\x28\xb9\x64\x40\x03\xcb\xcc\x1f\x66\x4e\x28\x03\x30\x0a\x06\x08\x2a\x86\x48\xce\x3d\x04\x03\x02\x03\x48\x00\x30\x45\x02\x20\x31\xae\xc0\x3d\x4a\x3f\x21\xbe\x85\x17\xfc\xf0\xc7\xb2\x31\x07\x2a\x38\x56\x43\xd1\x36\xd5\x95\xe1\x7e\x52\xc0\x06\x43\x87\xa7\x02\x21\x00\x97\x8c\x0e\xb8\x3c\x0a\x41\xaf\xae\xa5\xcf\x06\x7e\xd5\xc4\xd8\x2f\xff\xe2\x62\x80\x34\x10\xba\x22\xdd\x35\x81\x46\x93\x22\x9a"
  if !equal(Certificate.der(value), expected) { return false }
  if !equal(Certificate.tbsDer(value), Slice.view<u8>(expected, 4, 470)) { return false }
  if Certificate.version(value) != CertificateVersion.V3 { return false }
  if !equal(Certificate.serial(value), Slice.view<u8>(expected, 15, 1)) { return false }
  if !equal(Certificate.issuerDer(value), Slice.view<u8>(expected, 28, 127)) { return false }
  if !equal(Certificate.subjectDer(value), Slice.view<u8>(expected, 187, 127)) { return false }
  if !equal(Certificate.validityDer(value), Slice.view<u8>(expected, 155, 32)) { return false }
  let before = Certificate.notBefore(value)
  let after = Certificate.notAfter(value)
  if before.year != 2011 || before.month != 5 || before.day != 23 || before.hour != 20 || before.minute != 38 || before.second != 21 { return false }
  if after.year != 2012 || after.month != 12 || after.day != 22 || after.hour != 7 || after.minute != 41 || after.second != 51 { return false }
  if !equal(Certificate.spkiDer(value), Slice.view<u8>(expected, 314, 91)) { return false }
  let key = Certificate.publicKey(value)
  if key.unusedBits != 0 || !equal(key.bytes, Slice.view<u8>(expected, 340, 65)) { return false }
  let keyAlgorithm = Certificate.publicKeyAlgorithm(value)
  if !equal(keyAlgorithm.der, Slice.view<u8>(expected, 316, 21)) || !equal(keyAlgorithm.oid, Slice.view<u8>(expected, 320, 7)) { return false }
  if !optionalBytes(move keyAlgorithm.parametersDer, Slice.view<u8>(expected, 327, 10)) { return false }
  let inner = Certificate.tbsSignatureAlgorithm(value)
  if !equal(inner.der, Slice.view<u8>(expected, 16, 12)) || !equal(inner.oid, Slice.view<u8>(expected, 20, 8)) || !missingBytes(move inner.parametersDer) { return false }
  let outer = Certificate.signatureAlgorithm(value)
  if !equal(outer.der, Slice.view<u8>(expected, 474, 12)) || !equal(outer.oid, Slice.view<u8>(expected, 478, 8)) || !missingBytes(move outer.parametersDer) { return false }
  let signature = Certificate.signature(value)
  if signature.unusedBits != 0 || !equal(signature.bytes, Slice.view<u8>(expected, 489, 71)) { return false }
  if !absentBits(Certificate.issuerUniqueId(value)) || !absentBits(Certificate.subjectUniqueId(value)) { return false }
  if Certificate.extensionCount(value) != 3 { return false }
  if !extension(Certificate.extension(value, 0), Slice.view<u8>(expected, 409, 17), Slice.view<u8>(expected, 413, 3), true, Slice.view<u8>(expected, 421, 5)) { return false }
  if !extension(Certificate.extension(value, 1), Slice.view<u8>(expected, 426, 17), Slice.view<u8>(expected, 430, 3), true, Slice.view<u8>(expected, 438, 5)) { return false }
  if !extension(Certificate.extension(value, 2), Slice.view<u8>(expected, 443, 31), Slice.view<u8>(expected, 447, 3), false, Slice.view<u8>(expected, 452, 22)) { return false }
  return absentExtension(Certificate.extension(value, 3))
}

effect fn copiedInput() -> Result<Certificate, DecodeError> ! OutOfMemoryError ? &mut Allocator {
  let mut input = run Bytes.copy(b"\x30\x82\x02\x2c\x30\x82\x01\xd2\xa0\x03\x02\x01\x02\x02\x01\x00\x30\x0a\x06\x08\x2a\x86\x48\xce\x3d\x04\x03\x02\x30\x7d\x31\x0b\x30\x09\x06\x03\x55\x04\x06\x13\x02\x42\x45\x31\x0f\x30\x0d\x06\x03\x55\x04\x0a\x13\x06\x47\x6e\x75\x54\x4c\x53\x31\x25\x30\x23\x06\x03\x55\x04\x0b\x13\x1c\x47\x6e\x75\x54\x4c\x53\x20\x63\x65\x72\x74\x69\x66\x69\x63\x61\x74\x65\x20\x61\x75\x74\x68\x6f\x72\x69\x74\x79\x31\x0f\x30\x0d\x06\x03\x55\x04\x08\x13\x06\x4c\x65\x75\x76\x65\x6e\x31\x25\x30\x23\x06\x03\x55\x04\x03\x13\x1c\x47\x6e\x75\x54\x4c\x53\x20\x63\x65\x72\x74\x69\x66\x69\x63\x61\x74\x65\x20\x61\x75\x74\x68\x6f\x72\x69\x74\x79\x30\x1e\x17\x0d\x31\x31\x30\x35\x32\x33\x32\x30\x33\x38\x32\x31\x5a\x17\x0d\x31\x32\x31\x32\x32\x32\x30\x37\x34\x31\x35\x31\x5a\x30\x7d\x31\x0b\x30\x09\x06\x03\x55\x04\x06\x13\x02\x42\x45\x31\x0f\x30\x0d\x06\x03\x55\x04\x0a\x13\x06\x47\x6e\x75\x54\x4c\x53\x31\x25\x30\x23\x06\x03\x55\x04\x0b\x13\x1c\x47\x6e\x75\x54\x4c\x53\x20\x63\x65\x72\x74\x69\x66\x69\x63\x61\x74\x65\x20\x61\x75\x74\x68\x6f\x72\x69\x74\x79\x31\x0f\x30\x0d\x06\x03\x55\x04\x08\x13\x06\x4c\x65\x75\x76\x65\x6e\x31\x25\x30\x23\x06\x03\x55\x04\x03\x13\x1c\x47\x6e\x75\x54\x4c\x53\x20\x63\x65\x72\x74\x69\x66\x69\x63\x61\x74\x65\x20\x61\x75\x74\x68\x6f\x72\x69\x74\x79\x30\x59\x30\x13\x06\x07\x2a\x86\x48\xce\x3d\x02\x01\x06\x08\x2a\x86\x48\xce\x3d\x03\x01\x07\x03\x42\x00\x04\x52\xd8\x8d\x23\x8a\xe3\x67\xd7\x86\x36\xb1\x20\x0b\x09\x7d\xc8\xc9\xba\xa2\x20\x95\x2f\xc5\x4a\x63\xfa\x83\x5f\xce\x78\x2f\x8f\xf3\x62\xca\xfd\xb7\xf7\x80\x56\x9d\x6e\x17\xb9\x0e\x11\x4c\x48\xb2\xc0\xaf\x3b\x59\x17\x16\x30\x68\x09\x07\x99\x17\xfe\xdd\xa7\xa3\x43\x30\x41\x30\x0f\x06\x03\x55\x1d\x13\x01\x01\xff\x04\x05\x30\x03\x01\x01\xff\x30\x0f\x06\x03\x55\x1d\x0f\x01\x01\xff\x04\x05\x03\x03\x07\x06\x00\x30\x1d\x06\x03\x55\x1d\x0e\x04\x16\x04\x14\xf0\xb4\x81\xfe\x98\x12\xbf\xb5\x28\xb9\x64\x40\x03\xcb\xcc\x1f\x66\x4e\x28\x03\x30\x0a\x06\x08\x2a\x86\x48\xce\x3d\x04\x03\x02\x03\x48\x00\x30\x45\x02\x20\x31\xae\xc0\x3d\x4a\x3f\x21\xbe\x85\x17\xfc\xf0\xc7\xb2\x31\x07\x2a\x38\x56\x43\xd1\x36\xd5\x95\xe1\x7e\x52\xc0\x06\x43\x87\xa7\x02\x21\x00\x97\x8c\x0e\xb8\x3c\x0a\x41\xaf\xae\xa5\xcf\x06\x7e\xd5\xc4\xd8\x2f\xff\xe2\x62\x80\x34\x10\xba\x22\xdd\x35\x81\x46\x93\x22\x9a")
  let decoded = run Certificate.decodeDer(Bytes.asSlice(&input), DecodeLimits.defaults())
  Bytes.clear(&mut input)
  return move decoded
}

effect fn ownership() -> bool ! OutOfMemoryError ? &mut Allocator {
  return match move (run copiedInput()) {
    Result<Certificate, DecodeError>.Failure { error } => false
    Result<Certificate, DecodeError>.Success { value } => retained(&value)
  }
}

fn bitsEqual<'a>(value: Option<BitStringView<'a>>, unused: u8, byte: u8) -> bool {
  return match move value {
    Option<BitStringView<'a>>.None => false
    Option<BitStringView<'a>>.Some { value: bits } => bits.unusedBits == unused && bits.bytes.length == 1 && bits.bytes[0] == byte
  }
}
effect fn malformedAt(bytes: &[u8], reason: DecodeReason, offset: usize) -> bool ! OutOfMemoryError ? &mut Allocator {
  let result = run Certificate.decodeDer(bytes, DecodeLimits.defaults())
  return match move result {
    Result<Certificate, DecodeError>.Success { value } => false
    Result<Certificate, DecodeError>.Failure { error } => error.kind == DecodeClass.Malformed && error.reason == reason && error.offsetSpace == DecodeOffsetSpace.Input && error.offset == offset && error.certificateIndex == 0
  }
}
fn inputLimitError(error: DecodeError) -> bool {
  return error.kind == DecodeClass.ResourceLimit && error.reason == DecodeReason.InputBytes && error.offsetSpace == DecodeOffsetSpace.Input && error.offset == 1 && error.certificateIndex == 0
}
effect fn inputLimits() -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut limits = DecodeLimits.defaults()
  limits.inputBytes = 1
  let mut api = 0
  while api < 3 {
    let mut good = false
    if api == 2 {
      let result = run CertificateBundle.decodePem(b"12", limits)
      good = match move result {
        Result<CertificateBundle, DecodeError>.Success { value } => false
        Result<CertificateBundle, DecodeError>.Failure { error } => inputLimitError(move error)
      }
    } else if api == 0 {
      let result = run Certificate.decodeDer(b"12", limits)
      good = match move result {
        Result<Certificate, DecodeError>.Success { value } => false
        Result<Certificate, DecodeError>.Failure { error } => inputLimitError(move error)
      }
    } else {
      let result = run Certificate.decodePem(b"12", limits)
      good = match move result {
        Result<Certificate, DecodeError>.Success { value } => false
        Result<Certificate, DecodeError>.Failure { error } => inputLimitError(move error)
      }
    }
    if !good { return false }
    api = api + 1
  }
  let emptyLabel = run Certificate.decodePem(b"-----BEGIN -----\nAA==\n-----END -----", DecodeLimits.defaults())
  return match move emptyLabel {
    Result<Certificate, DecodeError>.Success { value } => false
    Result<Certificate, DecodeError>.Failure { error } => error.kind == DecodeClass.Unsupported && error.reason == DecodeReason.PemLabel && error.offsetSpace == DecodeOffsetSpace.Input && error.offset == 0
  }
}
effect fn uniqueIds() -> bool ! OutOfMemoryError ? &mut Allocator {
  let result = run Certificate.decodeDer(b"\x30\x53\x30\x46\xa0\x03\x02\x01\x01\x02\x01\x01\x30\x03\x06\x01\x2a\x30\x00\x30\x1e\x17\x0d\x35\x30\x30\x31\x30\x31\x30\x30\x30\x30\x30\x30\x5a\x17\x0d\x34\x39\x31\x32\x33\x31\x32\x33\x35\x39\x35\x39\x5a\x30\x00\x30\x0b\x30\x05\x06\x01\x2a\x05\x00\x03\x02\x03\xa0\x81\x02\x07\x80\x82\x02\x01\xfe\x30\x05\x06\x01\x2b\x05\x00\x03\x02\x02\xfc", DecodeLimits.defaults())
  return match move result {
    Result<Certificate, DecodeError>.Failure { error } => false
    Result<Certificate, DecodeError>.Success { value } => {
      let inner = Certificate.tbsSignatureAlgorithm(&value)
      let outer = Certificate.signatureAlgorithm(&value)
      let publicAlgorithm = Certificate.publicKeyAlgorithm(&value)
      let key = Certificate.publicKey(&value)
      let signature = Certificate.signature(&value)
      return Certificate.version(&value) == CertificateVersion.V2
        && bitsEqual(Certificate.issuerUniqueId(&value), 7, 128)
        && bitsEqual(Certificate.subjectUniqueId(&value), 1, 254)
        && missingBytes(move inner.parametersDer)
        && optionalBytes(move outer.parametersDer, b"\x05\x00")
        && optionalBytes(move publicAlgorithm.parametersDer, b"\x05\x00")
        && inner.oid[0] == 42 && outer.oid[0] == 43
        && key.unusedBits == 3 && key.bytes[0] == 160
        && signature.unusedBits == 2 && signature.bytes[0] == 252
        && Certificate.notBefore(&value).year == 1950 && Certificate.notAfter(&value).year == 2049
    }
  }
}
struct RefusingAllocator { calls: usize, failAt: usize }
effect fn allocate(self: &mut RefusingAllocator, layout: Layout) -> Intrinsic.Allocation ! OutOfMemoryError {
  self.calls = self.calls + usize.ONE
  if self.calls == self.failAt { return run Allocator.outOfMemory() }
  let mut system = Allocator.systemAllocatorProvider()
  return run Allocator.allocate(move layout) |> Effect.provideMut<Allocator>(&mut system)
}
