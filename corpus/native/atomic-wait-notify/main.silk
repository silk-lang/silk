import silk.concurrency.atomic { Atomic }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }

// A wait returns at once when the word differs, reports an elapsed timeout, and a notify with
// no waiter returns.
pub fn main() -> i32 {
  let mut word: u32 = 3
  let cell = Pointer.fromRef(&word)
  let mut failures = 0
  unsafe {
    if !Atomic.wait(cell, 4, Option<u64>.none()) { failures = failures + 1 }
    if Atomic.wait(cell, 3, Option<u64>.some(1000000)) { failures = failures + 1 }
    Atomic.notifyOne(cell)
    Atomic.notifyAll(cell)
  }
  if failures != 0 { return failures }
  return 42
}
