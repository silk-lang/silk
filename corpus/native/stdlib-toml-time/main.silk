import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StdoutWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.format { Format }
import silk.time.instant { Instant }
import silk.time.plain_date { PlainDate }
import silk.time.plain_date_time { PlainDateTime }
import silk.time.plain_time { PlainTime }
import silk.toml.codec { Decode, Serialize, TomlCodec }
import silk.toml.scanner { TomlError }
import silk.toml.value { Toml, Value }

// TOML dates and times as the types of `silk.time`: each key of the document is read as each of
// the four types and written back. Hand-written expectations.

effect fn shown<T: Decode + Serialize>(label: string, value: &Value) -> () ! WriterError ? &mut Writer {
  match TomlCodec.decodeOne<T>(value) {
    Result<T, TomlError>.Success { value: decoded } => {
      run Format.format(" {}=", &.(label))
      let written = run Effect.result(TomlCodec.writeOne<T>(&decoded))
      match move written {
        Result<(), TomlError | WriterError>.Success {..} => {}
        Result<(), TomlError | WriterError>.Failure { error } => match move error {
          TomlError failure => {
            run Format.format("{:?}", &.(failure.reason))
          }
          WriterError failure => {
            fail move failure
          }
        }
      }
    }
    Result<T, TomlError>.Failure { error } => {
      run Format.format(" {}={:?}", &(label, error.reason))
    }
  }
  return ()
}

effect fn row(document: &Value, key: string) -> () ! WriterError ? &mut Writer {
  run Format.format("{}:", &.(key))
  match Toml.field(document, key) {
    Option<&Value>.Some { value } => {
      run shown<Instant>("instant", value)
      run shown<PlainDateTime>("datetime", value)
      run shown<PlainDate>("date", value)
      run shown<PlainTime>("time", value)
    }
    Option<&Value>.None => {
      run Format.format(" missing", &())
    }
  }
  run Format.format("\n", &())
  return ()
}

effect fn program() -> i32 ! WriterError | TomlError | OutOfMemoryError ? &mut Writer | &mut Allocator {
  let document = run Toml.parse(
    b"utc = 1979-05-27T07:32:00Z\noffset = 1979-05-27 00:32:00.999999-07:00\nlower = 1979-05-27t07:32:00z\nlocal = 1979-05-27T07:32:00.5\nshort = 1979-05-27 07:32\nday = 2024-02-29\nclock = 07:32:00.123456789123\nleap = 2016-12-31T23:59:60Z\nfirst = 0000-01-01T00:00:00Z\nlast = 9999-12-31T23:59:59.999999999\ntext = \"1979-05-27\"\nnumber = 1979\n",
  )
  run row(&document, "utc")
  run row(&document, "offset")
  run row(&document, "lower")
  run row(&document, "local")
  run row(&document, "short")
  run row(&document, "day")
  run row(&document, "clock")
  run row(&document, "leap")
  run row(&document, "first")
  run row(&document, "last")
  run row(&document, "text")
  run row(&document, "number")
  // A date that TOML cannot hold is not written.
  let far = PlainDate.make(10000, 1, 1)
  let written = run Effect.result(TomlCodec.writeOne<PlainDate>(&far))
  match move written {
    Result<(), TomlError | WriterError>.Success {..} => {
      run Format.format(" written\n", &())
    }
    Result<(), TomlError | WriterError>.Failure { error } => match move error {
      TomlError failure => {
        run Format.format("year 10000: {:?}\n", &.(failure.reason))
      }
      WriterError failure => {
        fail move failure
      }
    }
  }
  return 0
}

effect fn failed(error: WriterError | TomlError | OutOfMemoryError) -> i32 {
  return 2
}

pub effect fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut out = StdoutWriter.make()
  return run Effect.catchAll(program(), failed)
    |> Effect.provideMut<Writer>(&mut out)
    |> Effect.provideMut<Allocator>(&mut allocator)
}
