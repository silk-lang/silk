// Static data viewed through shared borrows: constants holding `&'static [T]` and
// `&'static T` trees, static functions building and walking them, and runtime code reading them.
import silk.num.usize

pub struct Command {
  pub name: string<'static>,
  pub subcommands: &'static [&'static Command],
}

struct Leaf {
  pub value: i32,
  pub children: &'static [i32],
}

const NUMBERS: [i32; 3] = [1, 2, 3]

const LEAF: Leaf = Leaf { value: 4, children: &NUMBERS }

const EMPTY: [Leaf; 1] = [Leaf { value: 5, children: &[] }]

static fn leaf(name: string<'static>) -> Command {
  return Command { name: name, subcommands: &[] }
}

static fn depth(command: &Command) -> usize {
  let mut deepest = usize.ZERO
  let mut at = usize.ZERO
  while at < command.subcommands.length {
    let below = depth(command.subcommands[at])
    if below > deepest {
      deepest = below
    }
    at = at + usize.ONE
  }
  return deepest + usize.ONE
}

static fn made() -> Leaf {
  return Leaf { value: 6, children: &[7, 8] }
}

// A borrowed array returned where a slice is declared is that slice.
static fn view() -> &'static [i32] {
  let numbers = &NUMBERS
  return numbers
}

const VIEWED: Leaf = Leaf { value: 0, children: view() }

const ADD: Command = leaf("add")

const SUB: Command = leaf("sub")

const MATH: Command = Command { name: "math", subcommands: &[&ADD, &SUB] }

const ROOT: Command = Command { name: "calc", subcommands: &[&MATH, &leaf("version")] }

fn count(command: &Command) -> usize {
  let mut total = usize.ONE
  let children = command.subcommands
  let mut at = usize.ZERO
  while at < children.length {
    total = total + count(children[at])
    at = at + usize.ONE
  }
  return total
}

pub fn main() -> i32 {
  // 3 levels and 5 commands.
  let static levels = depth(&ROOT)
  let static math = ROOT.subcommands[0]
  let static built = made()
  let nodes = count(&ROOT)
  let total = usize.toI32(levels * 10 + nodes + math.subcommands.length)

  // 37 + 4 + 3 + 3 + 5 + 0 + 6 + 8 + 2 + 2 = 70
  return total + LEAF.value + LEAF.children[2] + usize.toI32(LEAF.children.length) + EMPTY[0].value
    + usize.toI32(EMPTY[0].children.length)
    + built.value
    + built.children[1]
    + usize.toI32(built.children.length)
    + VIEWED.children[1]
}
