import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.crypto.ml_kem { MlKem, MlKemError, MlKemParameters }
import silk.crypto.sha3 { Sha3_256 }
import silk.io.writer_native { StderrWriter }
import silk.num.u8

fn equal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut i: usize = 0
  while i < left.length {
    if left[i] != right[i] {
      return false
    }
    i = i + 1
  }
  return true
}

fn parameters(rank: i32) -> MlKemParameters {
  if rank == 2 {
    return MlKemParameters.MlKem512
  }
  if rank == 3 {
    return MlKemParameters.MlKem768
  }
  return MlKemParameters.MlKem1024
}

// Wycheproof keygen_seed: the key pair of the seed, compared by SHA3-256.
fn keygen(id: i32, rank: i32, seed: &[u8], encapsulationHash: &[u8], decapsulationHash: &[u8]) -> i32 {
  let set = parameters(rank)
  let mut ek: [u8; 1568] = [0; 1568]
  let mut dk: [u8; 3168] = [0; 3168]
  let mut ekView = Slice.viewMut<u8>(&mut ek, 0, set.encapsulationKeyLength())
  let mut dkView = Slice.viewMut<u8>(&mut dk, 0, set.decapsulationKeyLength())
  let ok = match MlKem.keyPairFromSeed(set, seed, &mut ekView, &mut dkView) {
    Result<(), MlKemError>.Success { .. } => true
    Result<(), MlKemError>.Failure { error: _ } => false
  }
  if !ok || !equal(&Sha3_256.hash(Slice.view<u8>(&ek, 0, set.encapsulationKeyLength())), encapsulationHash)
    || !equal(&Sha3_256.hash(Slice.view<u8>(&dk, 0, set.decapsulationKeyLength())), decapsulationHash) {
    StderrWriter.print("keygen failed {}\n", &.(id))
    return 1
  }
  return 0
}

// Wycheproof encaps: the ciphertext (by SHA3-256) and secret, or a refusal for an invalid key.
fn encaps(id: i32, rank: i32, ek: &[u8], message: &[u8], ciphertextHash: &[u8], secret: &[u8], valid: bool) -> i32 {
  let set = parameters(rank)
  let mut ct: [u8; 1568] = [0; 1568]
  let length = set.ciphertextLength()
  let got = match MlKem.encapsulateWith(set, ek, message, Slice.viewMut<u8>(&mut ct, 0, length)) {
    Result<[u8; 32], MlKemError>.Success { value } => {
      if valid && equal(&value, secret) && equal(&Sha3_256.hash(Slice.view<u8>(&ct, 0, length)), ciphertextHash) {
        0
      } else {
        1
      }
    }
    Result<[u8; 32], MlKemError>.Failure { error: _ } => {
      if valid {
        1
      } else {
        0
      }
    }
  }
  if got != 0 {
    StderrWriter.print("encaps failed {}\n", &.(id))
  }
  return got
}

fn decapsWith(id: i32, rank: i32, dk: &[u8], ciphertext: &[u8], secret: &[u8], valid: bool) -> i32 {
  let set = parameters(rank)
  let got = match MlKem.decapsulate(set, dk, ciphertext) {
    Result<[u8; 32], MlKemError>.Success { value } => {
      if valid && equal(&value, secret) {
        0
      } else {
        1
      }
    }
    Result<[u8; 32], MlKemError>.Failure { error: _ } => {
      if valid {
        1
      } else {
        0
      }
    }
  }
  if got != 0 {
    StderrWriter.print("decaps failed {}\n", &.(id))
  }
  return got
}

// Wycheproof mlkem_test: the key pair of the seed, then the decapsulation of the ciphertext.
fn decapsSeed(id: i32, rank: i32, seed: &[u8], encapsulationHash: &[u8], ciphertext: &[u8], secret: &[u8], valid: bool) -> i32 {
  let set = parameters(rank)
  let mut ek: [u8; 1568] = [0; 1568]
  let mut dk: [u8; 3168] = [0; 3168]
  let mut ekView = Slice.viewMut<u8>(&mut ek, 0, set.encapsulationKeyLength())
  let mut dkView = Slice.viewMut<u8>(&mut dk, 0, set.decapsulationKeyLength())
  match MlKem.keyPairFromSeed(set, seed, &mut ekView, &mut dkView) {
    Result<(), MlKemError>.Success { .. } => {}
    Result<(), MlKemError>.Failure { error: _ } => {
      if valid {
        StderrWriter.print("seed refused {}\n", &.(id))
        return 1
      }
      return 0
    }
  }
  if encapsulationHash.length != 0 && !equal(&Sha3_256.hash(Slice.view<u8>(&ek, 0, set.encapsulationKeyLength())), encapsulationHash) {
    StderrWriter.print("ek mismatch {}\n", &.(id))
    return 1
  }
  return decapsWith(id, rank, Slice.view<u8>(&dk, 0, set.decapsulationKeyLength()), ciphertext, secret, valid)
}

fn nibble(c: u8) -> u8 {
  if c >= 97 {
    return c - 87
  }
  return c - 48
}

// Writes the bytes of the hex digits `text` into `output` and returns their count.
fn hex(text: &[u8], output: &mut [u8; 3200]) -> usize {
  let length = text.length / 2
  let mut i: usize = 0
  while i < length {
    output[i] = u8.bitOr(u8.shiftLeft(nibble(text[2 * i]), 4), nibble(text[2 * i + 1]))
    i = i + 1
  }
  return length
}

