import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.msgpack.scanner { MsgpackError, MsgpackReason }
import silk.msgpack.value { Msgpack, MsgpackEntry, Value }
import silk.text.string { String }

struct Capture {
  bytes: [u8; 256],
  length: usize
}

impl Writer for Capture {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> ()
    ! WriterError
    ? &mut Writer {
    if self.length + value.length > 256 {
      fail Writer.failure()
    }
    Slice.copyInto<u8>(&mut self.bytes, self.length, value)
    self.length = self.length + value.length
    return ()
  }

  effect fn flush(self: &mut Self) -> ()
    ! WriterError
    ? &mut Writer {
    return ()
  }
}

// Whether `input` parses and writes back as `expected`.
effect fn rewrites(input: &[u8], expected: &[u8]) -> bool
  ! MsgpackError | WriterError | OutOfMemoryError
  ? &mut Allocator {
  let document = run Msgpack.parse(input)
  let mut capture = Capture { bytes: [0; 256], length: 0 }
  run Msgpack.write(&document) |> Effect.provideMut<Writer>(&mut capture)
  return Slice.view<u8>(&capture.bytes, 0, capture.length) == expected
}

effect fn rejected(input: &[u8], reason: MsgpackReason, offset: usize) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  return match move run Effect.result(Msgpack.parse(input)) {
    Result<Value, MsgpackError | OutOfMemoryError>.Success { .. } => false
    Result<Value, MsgpackError | OutOfMemoryError>.Failure { error } => match move error {
      MsgpackError { reason: found, offset: at } => found == reason && at == offset
      OutOfMemoryError {} => {
        fail OutOfMemoryError {}
      }
    }
  }
}

// {"name": "silk", "ports": [80, -1, 2^63], "raw": bin(ff 00), 7: nil, "when": ext(-1, 4 bytes),
//  "ratio": 0.5, "on": true}
const DOCUMENT: &[u8] = b"\x87\xa4name\xa4silk\xa5ports\x93\x50\xff\xcf\x80\x00\x00\x00\x00\x00\x00\x00\xa3raw\xc4\x02\xff\x00\x07\xc0\xa4when\xd6\xff\x00\x00\x00\x01\xa5ratio\xcb\x3f\xe0\x00\x00\x00\x00\x00\x00\xa2on\xc3"

effect fn reads() -> i32
  ! MsgpackError | OutOfMemoryError
  ? &mut Allocator {
  let document = run Msgpack.parse(DOCUMENT)
  let root = Option<&Value>.some(&document)
  if (Msgpack.fieldAt(root, "name") |> Msgpack.asString()).unwrapOr("") != "silk" {
    return 1
  }
  let ports = match Msgpack.field(&document, "ports") {
    Option<&Value>.Some { value } => value
    Option<&Value>.None => {
      return 2
    }
  }
  if Msgpack.asI64(Msgpack.item(ports, 0)).unwrapOr(0) != 80
    || Msgpack.asI64(Msgpack.item(ports, 1)).unwrapOr(0) != -1 {
    return 3
  }
  if Msgpack.asU64(Msgpack.item(ports, 0)).unwrapOr(0) != 80
    || Msgpack.asU64(Msgpack.item(ports, 1)).isSome() {
    return 4
  }

  // Only an integer above the largest `i64` is `Unsigned`, and it has no `i64`.
  match Msgpack.item(ports, 2) {
    Option<&Value>.Some { value } => match &value.* {
      Value.Unsigned { value: number } => {
        if number != 9223372036854775808 {
          return 5
        }
      }
      _ => {
        return 6
      }
    }
    Option<&Value>.None => {
      return 7
    }
  }
  if Msgpack.asI64(Msgpack.item(ports, 2)).isSome()
    || Msgpack.asU64(Msgpack.item(ports, 2)).unwrapOr(0) != 9223372036854775808
    || Msgpack.asF64(Msgpack.item(ports, 0)).unwrapOr(0.0) != 80.0 {
    return 8
  }
  if Msgpack.item(ports, 3).isSome() || Msgpack.item(&document, 0).isSome() {
    return 10
  }
  if Msgpack.asBinary(Msgpack.field(&document, "raw")).unwrapOr(b"") != b"\xff\x00" {
    return 11
  }

  // Text and binary data are different kinds.
  if Msgpack.asString(Msgpack.field(&document, "raw")).isSome()
    || Msgpack.asBinary(Msgpack.field(&document, "name")).isSome() {
    return 12
  }
  match Msgpack.field(&document, "when") {
    Option<&Value>.Some { value } => match &value.* {
      Value.Extension { kind, data } => {
        if kind != -1 || data.asSlice() != b"\x00\x00\x00\x01" {
          return 13
        }
      }
      _ => {
        return 14
      }
    }
    Option<&Value>.None => {
      return 15
    }
  }
  if Msgpack.asF64(Msgpack.field(&document, "ratio")).unwrapOr(0.0) != 0.5
    || Msgpack.asI64(Msgpack.field(&document, "ratio")).isSome() {
    return 16
  }
  if !Msgpack.asBool(Msgpack.field(&document, "on")).unwrapOr(false)
    || Msgpack.asBool(Msgpack.field(&document, "name")).isSome() {
    return 17
  }
  if Msgpack.field(&document, "missing").isSome() || Msgpack.field(ports, "name").isSome()
    || Msgpack.fieldAt(Msgpack.field(&document, "missing"), "name").isSome() {
    return 19
  }

  // A key that is not text is kept, with its value, in its place.
  match &document {
    Value.Map { entries } => {
      let members = entries.asSlice()
      if members.length != 7 {
        return 20
      }
      match &members[3].key {
        Value.Integer { value } => {
          if value != 7 {
            return 21
          }
        }
        _ => {
          return 22
        }
      }
      match &members[3].value {
        Value.Nil => {}
        _ => {
          return 23
        }
      }
    }
    _ => {
      return 24
    }
  }
  return 0
}

effect fn writes() -> i32
  ! MsgpackError | WriterError | OutOfMemoryError
  ? &mut Allocator {
  if !(run rewrites(DOCUMENT, DOCUMENT)) {
    return 30
  }

  // Wider formats than a value needs are read, and written back in the shortest: `uint 16` 5,
  // `int 32` -1, `str 8` "a", `float 32` 1.5, `array 16` and `map 16` headers.
  if !(run rewrites(
    b"\xdc\x00\x05\xcd\x00\x05\xd2\xff\xff\xff\xff\xd9\x01a\xca\x3f\xc0\x00\x00\xde\x00\x01\xa1k\xc7\x01\x05\x09",
    b"\x95\x05\xff\xa1a\xcb\x3f\xf8\x00\x00\x00\x00\x00\x00\x81\xa1k\xd4\x05\x09",
  )) {
    return 31
  }

  // A tree built by hand: a small `Unsigned` writes the bytes of the `Integer`.
  let mut values = List<Value>.make()
  run values.append(Value.Unsigned { value: 7 })
  run values.append(Value.String { text: run String.copy("ok") })
  run values.append(Value.Binary { bytes: run Bytes.copy(b"\x01") })
  let mut entries = List<MsgpackEntry>.make()
  run entries.append(
    MsgpackEntry { key: Value.Bool { value: false }, value: Value.Array { values: move values } },
  )
  let built = Value.Map { entries: move entries }
  let mut capture = Capture { bytes: [0; 256], length: 0 }
  run Msgpack.write(&built) |> Effect.provideMut<Writer>(&mut capture)
  if Slice.view<u8>(&capture.bytes, 0, capture.length) != b"\x81\xc2\x93\x07\xa2ok\xc4\x01\x01" {
    return 32
  }
  return 0
}

effect fn rejections() -> i32
  ! MsgpackError | OutOfMemoryError
  ? &mut Allocator {
  if !(run rejected(b"", MsgpackReason.UnexpectedEnd, 0)) {
    return 40
  }
  if !(run rejected(b"\x01\x02", MsgpackReason.TrailingBytes, 1)) {
    return 41
  }
  if !(run rejected(b"\x92\x01\xc1", MsgpackReason.ReservedByte, 2)) {
    return 42
  }
  if !(run rejected(b"\x81\xa1k", MsgpackReason.UnexpectedEnd, 3)) {
    return 43
  }
  if !(run rejected(b"\x91\xa1\xff", MsgpackReason.InvalidUtf8, 2)) {
    return 44
  }

  // 64 arrays around a value are accepted; the 65th is refused where it starts.
  let mut nested: [u8; 66] = [145; 66]
  nested[64] = 192
  if run rejected(Slice.view<u8>(&nested, 0, 65), MsgpackReason.DepthExceeded, 64) {
    return 45
  }
  drop run Msgpack.parse(Slice.view<u8>(&nested, 0, 65))
  nested[64] = 145
  nested[65] = 192
  if !(run rejected(&nested, MsgpackReason.DepthExceeded, 64)) {
    return 46
  }
  return 0
}

pub effect fn main() -> i32
  ! MsgpackError | WriterError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let first = run reads() |> Effect.provideMut<Allocator>(&mut allocator)
  if first != 0 {
    return first
  }
  let second = run writes() |> Effect.provideMut<Allocator>(&mut allocator)
  if second != 0 {
    return second
  }
  return run rejections() |> Effect.provideMut<Allocator>(&mut allocator)
}
