struct Weight {
  pub grams: i32,
}

static fn add(a: i32, b: i32) -> i32 {
  return a + b
}

static fn double(value: i32) -> i32 {
  return value * 2
}

static fn second<T>(first: T, last: T) -> T {
  return last
}

static fn heavier(weight: Weight, extra: Weight) -> Weight {
  return Weight {grams: weight.grams + extra.grams}
}

static fn apply(transform: fn(i32) -> i32, value: i32) -> i32 {
  return transform(value)
}

static fn twice(transform: fn(i32) -> i32, value: i32) -> i32 {
  return value |> transform |> transform
}

static fn total() -> i32 {
  // A section and a named function are values.
  let addTen = add(10)
  let doubled = double
  // Calls through them, directly and in a pipeline.
  let direct = addTen(1) + doubled(2)
  let piped = 1 |> addTen |> doubled
  // Passed to a static fn's callable parameter.
  let passed = apply(addTen, 3) + twice(double, 1)
  // A generic section fixes its type from the supplied argument.
  let last = second(5)
  // A section that captured a non-Copy value can be called again.
  let addKilo = heavier(Weight {grams: 1000})
  let first = Weight {grams: 1} |> addKilo
  let again = Weight {grams: 2} |> addKilo
  return direct + piped + passed + last(0) + first.grams + again.grams - 2000
}

pub fn main() -> i32 {
  let static value = total()
  // A `let static` binding can hold a section for later static initializers.
  let static addOne = add(1)
  let static next = 41 |> addOne
  return value + next
}
