// Reads and writes a union whose variants have fields as tagged JSON objects, and one variant named apart from its fields.
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.schema.issue { IssueReason, SchemaError, SchemaErrors }
import silk.schema.json { SchemaJson }
import silk.schema.schema { Schema, Spec }
import silk.text.string { String }

struct Capture {
  bytes: [u8; 256],
  length: usize,
}

impl Writer for Capture {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> () ! WriterError ? &mut Writer {
    let mut index: usize = 0
    while index < value.length {
      self.bytes[self.length] = value[index]
      self.length = self.length + 1
      index = index + 1
    }
    return ()
  }

  effect fn flush(self: &mut Self) -> () ! WriterError ? &mut Writer {
    return ()
  }
}

fn holds(capture: &Capture, expected: &[u8]) -> bool {
  if capture.length != expected.length { return false }
  let mut index: usize = 0
  while index < expected.length {
    if capture.bytes[index] != expected[index] { return false }
    index = index + 1
  }
  return true
}

union Auth {
  Anonymous,
  Token { pub value: String },
  Basic { pub user: String, pub password: Option<String> },
}

impl Schema for Auth {}

/// A shape tagged by `kind` instead of `type`.
union Shape {
  Circle { pub radius: u32 },
  Square { pub side: u32 },
}

impl Schema for Shape {
  static fn spec() -> Spec<Shape> {
    return Spec<Shape>.of() |> Spec<Shape>.tag("kind")
  }
}

effect fn decodeAuth(text: &[u8]) -> Auth ! SchemaError | OutOfMemoryError ? &mut Allocator {
  return run SchemaJson.decode<Auth>(text)
}

effect fn failure(text: &[u8]) -> Option<SchemaError> ! OutOfMemoryError ? &mut Allocator {
  let result = run Effect.result(decodeAuth(text))
  return match move result {
    Result<Auth, SchemaError | OutOfMemoryError>.Success {..} => Option<SchemaError>.none()
    Result<Auth, SchemaError | OutOfMemoryError>.Failure {error} => match move error {
      SchemaError {path, issue} => Option<SchemaError>.some(SchemaError {path: move path, issue: issue})
      OutOfMemoryError {} => { fail OutOfMemoryError {} }
    }
  }
}

fn failedAt(found: &Option<SchemaError>, path: string, reason: IssueReason) -> bool {
  return match &found.* {
    Option<SchemaError>.Some {value} => value.path.matchesText(path) && value.issue.reason == reason
    Option<SchemaError>.None => false
  }
}

effect fn encodes<T: Schema>(value: &T, expected: &[u8]) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut capture = Capture {bytes: [0; 256], length: 0}
  let encoded = run Effect.result(SchemaJson.encode<T>(value)) |> Effect.provideMut<Writer>(&mut capture)
  return match move encoded {
    Result<(), SchemaError | WriterError | OutOfMemoryError>.Success {..} => holds(&capture, expected)
    Result<(), SchemaError | WriterError | OutOfMemoryError>.Failure {..} => false
  }
}

effect fn checks() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let basic = match run Effect.result(decodeAuth(b"{\"user\": \"ada\", \"type\": \"Basic\"}")) {
    Result<Auth, SchemaError | OutOfMemoryError>.Success {value} => move value
    Result<Auth, SchemaError | OutOfMemoryError>.Failure {..} => { return 1 }
  }
  let named = match &basic {
    Auth.Basic {user, password} => user.view() == "ada" && password.isNone()
    _ => false
  }
  if !named { return 2 }
  if !run encodes<Auth>(&basic, b"{\"type\":\"Basic\",\"user\":\"ada\"}") { return 3 }

  let token = match run Effect.result(decodeAuth(b"{\"type\": \"Token\", \"value\": \"t1\"}")) {
    Result<Auth, SchemaError | OutOfMemoryError>.Success {value} => move value
    Result<Auth, SchemaError | OutOfMemoryError>.Failure {..} => { return 4 }
  }
  if !run encodes<Auth>(&token, b"{\"type\":\"Token\",\"value\":\"t1\"}") { return 5 }

  let anonymous = match run Effect.result(decodeAuth(b"{\"type\": \"Anonymous\"}")) {
    Result<Auth, SchemaError | OutOfMemoryError>.Success {value} => move value
    Result<Auth, SchemaError | OutOfMemoryError>.Failure {..} => { return 6 }
  }
  if !run encodes<Auth>(&anonymous, b"{\"type\":\"Anonymous\"}") { return 7 }

  let unknown = run failure(b"{\"type\": \"Root\"}")
  if !failedAt(&unknown, "type", IssueReason.UnknownVariant) { return 8 }
  let untagged = run failure(b"{\"value\": \"t1\"}")
  if !failedAt(&untagged, "type", IssueReason.MissingKey) { return 9 }
  let missing = run failure(b"{\"type\": \"Token\"}")
  if !failedAt(&missing, "Token.value", IssueReason.MissingKey) { return 10 }

  let circle = match run Effect.result(SchemaJson.decode<Shape>(b"{\"kind\": \"Circle\", \"radius\": 2}")) {
    Result<Shape, SchemaError | OutOfMemoryError>.Success {value} => move value
    Result<Shape, SchemaError | OutOfMemoryError>.Failure {..} => { return 11 }
  }
  if !run encodes<Shape>(&circle, b"{\"kind\":\"Circle\",\"radius\":2}") { return 12 }

  // A tool call names the variant apart from its fields.
  let called = match run Effect.result(SchemaJson.decodeVariant<Auth>("Basic", b"{\"user\": \"ada\"}")) {
    Result<Auth, SchemaErrors | OutOfMemoryError>.Success {value} => move value
    Result<Auth, SchemaErrors | OutOfMemoryError>.Failure {..} => { return 13 }
  }
  if !run encodes<Auth>(&called, b"{\"type\":\"Basic\",\"user\":\"ada\"}") { return 14 }
  let wrong = match run Effect.result(SchemaJson.decodeVariant<Auth>("Basic", b"{\"user\": 3}")) {
    Result<Auth, SchemaErrors | OutOfMemoryError>.Failure {error: SchemaErrors {errors, ..}} => {
      let found = List<SchemaError>.asSlice(&errors)
      found.length == 1 && found[0].path.matchesText("Basic.user") && found[0].issue.reason == IssueReason.InvalidType
    }
    _ => false
  }
  if !wrong { return 15 }
  let unnamed = match run Effect.result(SchemaJson.decodeVariant<Auth>("Root", b"{}")) {
    Result<Auth, SchemaErrors | OutOfMemoryError>.Failure {error: SchemaErrors {errors, ..}} => {
      let found = List<SchemaError>.asSlice(&errors)
      found.length == 1 && found[0].issue.reason == IssueReason.UnknownVariant
    }
    _ => false
  }
  if !unnamed { return 16 }
  return 0
}

pub effect fn main() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checks() |> Effect.provideMut<Allocator>(&mut allocator)
}
