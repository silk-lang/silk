import silk.collections.list { List }
import silk.mem.pointer { Pointer }
import silk.concurrency.thread { Concurrent, Transferable }
struct Buffer { base: *mut i32, count: usize }
impl Transferable for Buffer {}
impl Concurrent for Buffer {}
struct Pair<T> { left: T, right: i32 }
enum Color { Red, Green }
struct Holder<T> { inner: T }
impl<T: Transferable> Transferable for Holder<*const T> {}
fn send<T: Transferable>(value: T) -> i32 {
  drop value
  return 3
}
fn share<T: Concurrent>(value: &T) -> i32 { return 4 }
fn forward<T: Transferable>(value: T) -> i32 { return send(move value) }
fn lend<T: Concurrent>(value: &T) -> i32 { return send(value) }
pub fn main() -> i32 {
  let mut total = 0
  let mut slot = 1
  total = total + send(7)
  total = total + send(Color.Green)
  total = total + send("text")
  let items = List<i32>.make()
  total = total + share(&items)
  total = total + lend(&items)
  total = total + forward(Pair<List<i32>> { left: move items, right: 1 })
  let buffer = Buffer { base: Pointer.fromMutRef(&mut slot), count: 1 }
  total = total + share(&buffer)
  total = total + send(move buffer)
  let base = 5
  let add = fn(value: i32) -> i32 { return value + base }
  total = total + send(add)
  let held = Holder<*const i32> { inner: Pointer.fromRef(&base) }
  total = total + send(move held)
  return total + 10
}
