fn rejects() -> bool {
  let key: [u8; 32] = [1; 32]
  let short: [u8; 31] = [1; 31]
  let nonce: [u8; 12] = [2; 12]
  let longNonce: [u8; 16] = [2; 16]
  let keyRejected = match ChaCha20Poly1305Encryptor.make(&short, &nonce, b"") {
    Result<ChaCha20Poly1305Encryptor, AeadError>.Failure {error: AeadError.InvalidKey} => true
    _ => false
  }
  if !keyRejected { return false }
  let nonceRejected = match ChaCha20.make(&key, &longNonce, 0) {
    Result<ChaCha20, ChaCha20Error>.Failure {error: ChaCha20Error.InvalidNonce} => true
    _ => false
  }
  if !nonceRejected { return false }
  let encryptor = match ChaCha20Poly1305Encryptor.make(&key, &nonce, b"") {
    Result<ChaCha20Poly1305Encryptor, AeadError>.Success {value} => move value
    Result<ChaCha20Poly1305Encryptor, AeadError>.Failure {error: _} => { return false }
  }
  let mut tooLong: [u8; 17] = [0; 17]
  return match encryptor.finish(&mut tooLong) {
    Result<(), AeadError>.Failure {error: AeadError.InvalidTag} => true
    _ => false
  }
}

pub fn main() -> i32 {
  if !aead0() { return 1 }
  if !aead1() { return 2 }
  if !aead2() { return 3 }
  if !aead3() { return 4 }
  if !aead4() { return 5 }
  if !aead5() { return 6 }
  if !aead6() { return 7 }
  if !aead7() { return 8 }
  if !aead8() { return 9 }
  if !raw0() { return 10 }
  if !raw1() { return 11 }
  if !raw2() { return 12 }
  if !raw3() { return 13 }
  if !raw4() { return 14 }
  if !raw5() { return 15 }
  if !raw6() { return 16 }
  if !rejects() { return 17 }
  return 42
}
