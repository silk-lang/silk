import silk.crypto.chacha20_poly1305 {AeadError, ChaCha20, ChaCha20Error, ChaCha20Poly1305Decryptor, ChaCha20Poly1305Encryptor}
import silk.collections.slice {Slice}
import silk.core.result {Result}
import silk.num.u8

fn equal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut index: usize = 0
  while index < left.length {
    if left[index] != right[index] { return false }
    index = index + 1
  }
  return true
}

fn ok(result: Result<(), AeadError>) -> bool {
  return match move result {
    Result<(), AeadError>.Success {value: _} => true
    Result<(), AeadError>.Failure {error: _} => false
  }
}

fn streamOk(result: Result<(), ChaCha20Error>) -> bool {
  return match move result {
    Result<(), ChaCha20Error>.Success {value: _} => true
    Result<(), ChaCha20Error>.Failure {error: _} => false
  }
}

// Encrypts in pieces of `step`, checks ciphertext and tag, then decrypts in pieces of `step` and
// checks the plaintext and that a flipped tag fails.
fn aead(key: &[u8], nonce: &[u8], aad: &[u8], plaintext: &[u8], ciphertext: &[u8], tag: &[u8], step: usize, output: &mut [u8]) -> bool {
  let mut encryptor = match ChaCha20Poly1305Encryptor.make(key, nonce, aad) {
    Result<ChaCha20Poly1305Encryptor, AeadError>.Success {value} => move value
    Result<ChaCha20Poly1305Encryptor, AeadError>.Failure {error: _} => { return false }
  }
  let mut offset: usize = 0
  while offset < plaintext.length {
    let mut length = step
    if plaintext.length - offset < length { length = plaintext.length - offset }
    if !ok(encryptor.update(Slice.view<u8>(plaintext, offset, length), Slice.viewMut<u8>(&mut output, offset, length))) { return false }
    offset = offset + length
  }
  if !equal(Slice.view<u8>(&output, 0, plaintext.length), ciphertext) { return false }
  let mut computed: [u8; 16] = [0; 16]
  if !ok(encryptor.finish(Slice.viewMut<u8>(&mut computed, 0, tag.length))) { return false }
  if !equal(Slice.view<u8>(&computed, 0, tag.length), tag) { return false }
  let mut decryptor = match ChaCha20Poly1305Decryptor.make(key, nonce, aad) {
    Result<ChaCha20Poly1305Decryptor, AeadError>.Success {value} => move value
    Result<ChaCha20Poly1305Decryptor, AeadError>.Failure {error: _} => { return false }
  }
  let mut bad = match ChaCha20Poly1305Decryptor.make(key, nonce, aad) {
    Result<ChaCha20Poly1305Decryptor, AeadError>.Success {value} => move value
    Result<ChaCha20Poly1305Decryptor, AeadError>.Failure {error: _} => { return false }
  }
  offset = 0
  while offset < ciphertext.length {
    let mut length = step
    if ciphertext.length - offset < length { length = ciphertext.length - offset }
    if !ok(decryptor.update(Slice.view<u8>(ciphertext, offset, length), Slice.viewMut<u8>(&mut output, offset, length))) { return false }
    if !ok(bad.update(Slice.view<u8>(ciphertext, offset, length), Slice.viewMut<u8>(&mut output, offset, length))) { return false }
    offset = offset + length
  }
  if !equal(Slice.view<u8>(&output, 0, ciphertext.length), plaintext) { return false }
  if !ok(decryptor.finish(tag)) { return false }
  let mut flipped: [u8; 16] = [0; 16]
  let mut index: usize = 0
  while index < tag.length {
    flipped[index] = tag[index]
    index = index + 1
  }
  flipped[tag.length - 1] = u8.bitXor(flipped[tag.length - 1], 1)
  return match bad.finish(Slice.view<u8>(&flipped, 0, tag.length)) {
    Result<(), AeadError>.Failure {error: AeadError.AuthenticationFailed} => true
    _ => false
  }
}

fn raw(key: &[u8], nonce: &[u8], counter: u32, input: &[u8], expected: &[u8], step: usize, output: &mut [u8]) -> bool {
  let mut cipher = match ChaCha20.make(key, nonce, counter) {
    Result<ChaCha20, ChaCha20Error>.Success {value} => move value
    Result<ChaCha20, ChaCha20Error>.Failure {error: _} => { return false }
  }
  let mut offset: usize = 0
  while offset < input.length {
    let mut length = step
    if input.length - offset < length { length = input.length - offset }
    if !streamOk(cipher.apply(Slice.view<u8>(input, offset, length), Slice.viewMut<u8>(&mut output, offset, length))) { return false }
    offset = offset + length
  }
  return equal(Slice.view<u8>(&output, 0, input.length), expected)
}

