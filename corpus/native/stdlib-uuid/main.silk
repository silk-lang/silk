import silk.encoding.uuid { Uuid, UuidError, UuidVariant }
import silk.core.result { Result }
import silk.option { Option }
import silk.core.effect { Effect }
import silk.system.random { Random }
import silk.text.string { String }
import silk.num.u8
import silk.collections.hash { Hash, HashKey }

fn ok(result: Result<Uuid, UuidError>) -> Uuid {
  return match move result {
    Result<Uuid, UuidError>.Success { value } => value
    Result<Uuid, UuidError>.Failure { error: _ } => Uuid.nil()
  }
}

fn text(value: &Uuid, expected: string) -> bool {
  let mut output: [u8; 46] = [42; 46]
  let matched = match Uuid.formatInto(value, &mut output) {
    Result<string, UuidError>.Success { value: rendered } => rendered == expected
    Result<string, UuidError>.Failure { error: _ } => false
  }
  return matched && output[36] == 42
}

fn bad(text: string) -> bool {
  return match Uuid.parse(text) {
    Result<Uuid, UuidError>.Failure { error: UuidError.InvalidText } => true
    _ => false
  }
}

struct Scripted {
  count: usize
}

impl Random for Scripted {
  effect fn fillBytes(self: &mut Self, output: &mut [u8]) -> () {
    let mut index: usize = 0
    while index < output.length {
      output[index] = 255
      index = index + 1
    }
    self.count = self.count + output.length
    return ()
  }
}

pub fn main() -> i32 {
  let node: [u8; 6] = [0x9f, 0x6b, 0xde, 0xce, 0xd8, 0x46]
  let first = ok(Uuid.v1(0x1ec9414c232ab00, 0x33c8, node))
  let sixth = ok(Uuid.v6(0x1ec9414c232ab00, 0x33c8, node))
  if !text(&first, "c232ab00-9414-11ec-b3c8-9f6bdeced846") {
    return 1
  }
  if !text(&sixth, "1ec9414c-232a-6b00-b3c8-9f6bdeced846") {
    return 2
  }
  if (Uuid.gregorianTimestamp(&first) |> Option<u64>.unwrapOr(0)) != 0x1ec9414c232ab00 {
    return 3
  }
  if (Uuid.gregorianTimestamp(&sixth) |> Option<u64>.unwrapOr(0)) != 0x1ec9414c232ab00 {
    return 4
  }
  if (Uuid.clockSequence(&first) |> Option<u16>.unwrapOr(0)) != 0x33c8 {
    return 5
  }
  let restoredNode = Uuid.node(&sixth) |> Option<[u8; 6]>.unwrapOr([0; 6])
  if restoredNode[0] != 0x9f || restoredNode[5] != 0x46 {
    return 6
  }
  let converted = Uuid.toV6(&first) |> Option<Uuid>.unwrapOr(Uuid.nil())
  let restored = Uuid.toV1(&sixth) |> Option<Uuid>.unwrapOr(Uuid.nil())
  if &converted != &sixth || &restored != &first {
    return 7
  }
  let dns = Uuid.namespaceDns()
  let third = Uuid.v3(&dns, "www.example.com")
  let fifth = Uuid.v5(&dns, "www.example.com")
  if !text(&third, "5df41881-3aed-3515-88a7-2f4a814cf09e") {
    return 8
  }
  if !text(&fifth, "2ed6657d-e927-568b-95e1-2665a8aea6a2") {
    return 9
  }
  let raw = ok(Uuid.parse("919108f7-52d1-3320-5bac-f847db4148a8"))
  let fourth = Uuid.v4FromRandom(Uuid.toBytes(&raw))
  if !text(&fourth, "919108f7-52d1-4320-9bac-f847db4148a8") {
    return 10
  }
  let seventh = ok(
    Uuid.v7FromRandom(1645557742000, [0x0c, 0xc3, 0x18, 0xc4, 0xdc, 0x0c, 0x0c, 0x07, 0x39, 0x8f])
  )
  if !text(&seventh, "017f22e2-79b0-7cc3-98c4-dc0c0c07398f") {
    return 11
  }
  if (Uuid.unixMilliseconds(&seventh) |> Option<u64>.unwrapOr(0)) != 1645557742000 {
    return 12
  }
  let custom = ok(Uuid.parse("2489e9ad-2ee2-0e00-0ec9-32d5f69181c0"))
  let eighth = Uuid.v8(Uuid.toBytes(&custom))
  if !text(&eighth, "2489e9ad-2ee2-8e00-8ec9-32d5f69181c0") {
    return 13
  }
  let second = ok(Uuid.v2(0x1ec9414c232ab00, 0x33, node, 1, 0x12345678))
  if !text(&second, "12345678-9414-21ec-b301-9f6bdeced846") {
    return 14
  }
  if (Uuid.localId(&second) |> Option<u32>.unwrapOr(0)) != 0x12345678 {
    return 15
  }
  if (Uuid.localDomain(&second) |> Option<u8>.unwrapOr(255)) != 1 {
    return 16
  }
  if (Uuid.clockSequence(&second) |> Option<u16>.unwrapOr(0)) != 0x33 {
    return 17
  }
  let nil = Uuid.nil()
  let max = Uuid.max()
  if !Uuid.isNil(&nil) || Uuid.isNil(&max) || !Uuid.isMax(&max) || Uuid.isMax(&nil) {
    return 18
  }
  if !text(&nil, "00000000-0000-0000-0000-000000000000")
    || !text(&max, "ffffffff-ffff-ffff-ffff-ffffffffffff") {
    return 19
  }
  let upper = ok(Uuid.parse("C232AB00-9414-11EC-B3C8-9F6BDECED846"))
  if &upper != &first {
    return 20
  }
  let mut output: [u8; 46] = [42; 46]
  let urn = match Uuid.formatUrnInto(&first, &mut output) {
    Result<string, UuidError>.Success { value } => ok(Uuid.parseUrn(value))
    _ => Uuid.nil()
  }
  if &urn != &first || output[45] != 42 {
    return 21
  }
  let upperUrn = ok(Uuid.parseUrn("URN:UUID:C232AB00-9414-11EC-B3C8-9F6BDECED846"))
  if &upperUrn != &first {
    return 22
  }
  let mut short: [u8; 35] = [42; 35]
  let small = match Uuid.formatInto(&first, &mut short) {
    Result<string, UuidError>.Failure { error: UuidError.BufferTooSmall } => true
    _ => false
  }
  if !small || short[0] != 42 || short[34] != 42 {
    return 23
  }
  let mut shortUrn: [u8; 44] = [42; 44]
  let smallUrn = match Uuid.formatUrnInto(&first, &mut shortUrn) {
    Result<string, UuidError>.Failure { error: UuidError.BufferTooSmall } => true
    _ => false
  }
  if !smallUrn || shortUrn[0] != 42 || shortUrn[43] != 42 {
    return 24
  }
  if !(match Uuid.variant(&nil) {
    UuidVariant.Ncs => true
    _ => false
  }) {
    return 25
  }
  if !(match Uuid.variant(&max) {
    UuidVariant.Reserved => true
    _ => false
  }) {
    return 26
  }
  let microsoft = ok(Uuid.parse("00000000-0000-4000-c000-000000000000"))
  if !(match Uuid.variant(&microsoft) {
    UuidVariant.Microsoft => true
    _ => false
  }) {
    return 27
  }
  if !(match Uuid.variant(&fourth) {
    UuidVariant.Rfc => true
    _ => false
  }) {
    return 28
  }
  if (Uuid.version(&nil) |> Option<u8>.unwrapOr(255)) != 255
    || (Uuid.version(&max) |> Option<u8>.unwrapOr(255)) != 255 {
    return 29
  }
  if (Uuid.version(&microsoft) |> Option<u8>.unwrapOr(255)) != 255 {
    return 30
  }
  let reserved = ok(Uuid.parse("00000000-0000-f000-8000-000000000000"))
  if (Uuid.version(&reserved) |> Option<u8>.unwrapOr(255)) != 15 {
    return 31
  }
  if (Uuid.gregorianTimestamp(&second) |> Option<u64>.unwrapOr(7)) != 7 {
    return 32
  }
  if (Uuid.unixMilliseconds(&first) |> Option<u64>.unwrapOr(7)) != 7 {
    return 33
  }
  if !(&nil < &first) || !(&first < &max) || &nil > &max {
    return 34
  }
  let seed = Hash.seed(123)
  if HashKey.hash(&first, &seed) != HashKey.hash(&upper, &seed) {
    return 35
  }
  let mut provider = Scripted { count: 0 }
  let random4 = run Uuid.v4() |> Effect.provideMut<Random>(&mut provider)
  let random7 = ok(run Uuid.v7(1) |> Effect.provideMut<Random>(&mut provider))
  if !text(&random4, "ffffffff-ffff-4fff-bfff-ffffffffffff") {
    return 36
  }
  if !text(&random7, "00000000-0001-7fff-bfff-ffffffffffff") || provider.count != 26 {
    return 37
  }
  let tooLarge = run Uuid.v7(0x1000000000000) |> Effect.provideMut<Random>(&mut provider)
  if !(match move tooLarge {
    Result<Uuid, UuidError>.Failure { error: UuidError.TimestampOutOfRange } => true
    _ => false
  })
    || provider.count != 26 {
    return 38
  }
  if !bad("") {
    return 39
  }
  if !bad("000000000000000000000000000000000000") {
    return 40
  }
  if !bad("c232ab00_9414-11ec-b3c8-9f6bdeced846") {
    return 41
  }
  if !bad("g232ab00-9414-11ec-b3c8-9f6bdeced846") {
    return 42
  }
  if !bad("c232ab00-9414-11ec-b3c8-9f6bdeced84") {
    return 43
  }
  if !bad("c232ab00-9414-11ec-b3c8-9f6bdeced846 ") {
    return 44
  }
  if !bad("{c232ab00-9414-11ec-b3c8-9f6bdeced846}") {
    return 45
  }
  if !bad("urn:uuid:c232ab00-9414-11ec-b3c8-9f6bdeced846") {
    return 46
  }
  if !bad("é232ab0-9414-11ec-b3c8-9f6bdeced846") {
    return 47
  }
  if !(match Uuid.v1(0x1000000000000000, 0, node) {
    Result<Uuid, UuidError>.Failure { error: UuidError.TimestampOutOfRange } => true
    _ => false
  }) {
    return 48
  }
  if !(match Uuid.v6(0, 16384, node) {
    Result<Uuid, UuidError>.Failure { error: UuidError.ClockSequenceOutOfRange } => true
    _ => false
  }) {
    return 49
  }
  if !(match Uuid.v6(0x1000000000000000, 0, node) {
    Result<Uuid, UuidError>.Failure { error: UuidError.TimestampOutOfRange } => true
    _ => false
  }) {
    return 50
  }
  if !(match Uuid.v1(0, 16384, node) {
    Result<Uuid, UuidError>.Failure { error: UuidError.ClockSequenceOutOfRange } => true
    _ => false
  }) {
    return 51
  }
  if !(match Uuid.v7FromRandom(0x1000000000000, [0; 10]) {
    Result<Uuid, UuidError>.Failure { error: UuidError.TimestampOutOfRange } => true
    _ => false
  }) {
    return 52
  }
  if !(match Uuid.v2(0, 64, node, 0, 0) {
    Result<Uuid, UuidError>.Failure { error: UuidError.ClockSequenceOutOfRange } => true
    _ => false
  }) {
    return 53
  }
  if !(match Uuid.v2(0, 0, node, 3, 0) {
    Result<Uuid, UuidError>.Failure { error: UuidError.InvalidDomain } => true
    _ => false
  }) {
    return 54
  }
  if !(match Uuid.v2(0x1000000000000000, 0, node, 0, 0) {
    Result<Uuid, UuidError>.Failure { error: UuidError.TimestampOutOfRange } => true
    _ => false
  }) {
    return 55
  }
  let limit1 = ok(Uuid.v1(0xfffffffffffffff, 16383, [255; 6]))
  if !text(&limit1, "ffffffff-ffff-1fff-bfff-ffffffffffff") {
    return 56
  }
  let limit6 = ok(Uuid.v6(0xfffffffffffffff, 16383, [255; 6]))
  if !text(&limit6, "ffffffff-ffff-6fff-bfff-ffffffffffff") {
    return 57
  }
  let limit7 = ok(Uuid.v7FromRandom(0xffffffffffff, [255; 10]))
  if !text(&limit7, "ffffffff-ffff-7fff-bfff-ffffffffffff") {
    return 60
  }
  let names: [string; 8] = [
    "",
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
    "é☃"
  ]
  let expected3: [string; 8] = [
    "c87ee674-4ddc-3efe-a74e-dfe25da5d7b3",
    "96cb729a-b665-38ba-b98f-a35a1d044728",
    "13c085b8-0e53-35ed-bd46-f814ae2cd6cf",
    "f41abfa0-01e6-34a5-ad0c-0c9835688c00",
    "12adee6c-b187-318d-82d2-f934bf55422b",
    "66d96f29-a22d-37a1-9666-8af5b81cf1f2",
    "1a2efcdb-449d-37aa-b4dd-9c81f7bd2447",
    "92563ac4-5ea6-3467-81b9-2db1930432f5"
  ]
  let expected5: [string; 8] = [
    "4ebd0208-8328-5d69-8c44-ec50939c0967",
    "5824f981-4282-59d4-9716-acb6d741350e",
    "39f39c20-db47-5131-8879-62f8f67f9014",
    "660c273c-8a00-5941-b6f4-8d0afed88966",
    "7280cc42-274a-5c4a-91fc-ae23f853eeb7",
    "69349718-028b-5ff0-a00f-c024ded6e6ee",
    "ab683ad5-4de4-5faf-bf37-0788e34176da",
    "557f8ace-4b8f-574c-a045-b570edd81773"
  ]
  let mut nameIndex: usize = 0
  while nameIndex < 8 {
    let named3 = Uuid.v3(&dns, names[nameIndex])
    let named5 = Uuid.v5(&dns, names[nameIndex])
    if !text(&named3, expected3[nameIndex]) {
      return 61
    }
    if !text(&named5, expected5[nameIndex]) {
      return 62
    }
    nameIndex = nameIndex + 1
  }
  let versions: [Uuid; 8] = [first, second, third, fourth, fifth, sixth, seventh, eighth]
  let mut index: usize = 0
  while index < 8 {
    let current = versions[index]
    if u8.toUsize(Uuid.version(&current) |> Option<u8>.unwrapOr(0)) != index + 1 {
      return 80
    }
    let roundTrip = Uuid.fromBytes(Uuid.toBytes(&current))
    if &current != &roundTrip {
      return 81
    }
    index = index + 1
  }
  let url = Uuid.namespaceUrl()
  let oid = Uuid.namespaceOid()
  let x500 = Uuid.namespaceX500()
  if !text(&url, "6ba7b811-9dad-11d1-80b4-00c04fd430c8") {
    return 82
  }
  if !text(&oid, "6ba7b812-9dad-11d1-80b4-00c04fd430c8") {
    return 83
  }
  if !text(&x500, "6ba7b814-9dad-11d1-80b4-00c04fd430c8") {
    return 84
  }
  if (Uuid.localId(&first) |> Option<u32>.unwrapOr(123)) != 123 {
    return 85
  }
  if (Uuid.localDomain(&first) |> Option<u8>.unwrapOr(123)) != 123 {
    return 86
  }
  if (Uuid.clockSequence(&fourth) |> Option<u16>.unwrapOr(123)) != 123 {
    return 87
  }
  let absentNode = Uuid.node(&fourth) |> Option<[u8; 6]>.unwrapOr([123; 6])
  if absentNode[0] != 123 {
    return 88
  }
  let absentConversion = Uuid.toV6(&fourth) |> Option<Uuid>.unwrapOr(Uuid.nil())
  if !Uuid.isNil(&absentConversion) {
    return 89
  }
  let limit2 = ok(Uuid.v2(0xfffffffffffffff, 63, [255; 6], 2, 0xffffffff))
  if !text(&limit2, "ffffffff-ffff-2fff-bf02-ffffffffffff") {
    return 90
  }
  let zero1 = ok(Uuid.v1(0, 0, [0; 6]))
  if !text(&zero1, "00000000-0000-1000-8000-000000000000") {
    return 91
  }
  let zero6 = ok(Uuid.v6(0, 0, [0; 6]))
  if !text(&zero6, "00000000-0000-6000-8000-000000000000") {
    return 92
  }
  let mut malformed: [u8; 45] = [0; 45]
  let source = b"urn:uuid:c232ab00-9414-11ec-b3c8-9f6bdeced846"
  index = 0
  while index < 45 {
    malformed[index] = source[index]
    index = index + 1
  }
  malformed[3] = 26
  let malformedText = unsafe String.fromUtf8Unchecked(&malformed)
  if !(match Uuid.parseUrn(malformedText) {
    Result<Uuid, UuidError>.Failure { error: UuidError.InvalidText } => true
    _ => false
  }) {
    return 93
  }
  if !(match Uuid.parseUrn("c232ab00-9414-11ec-b3c8-9f6bdeced846") {
    Result<Uuid, UuidError>.Failure { error: UuidError.InvalidText } => true
    _ => false
  }) {
    return 94
  }
  return 0
}
