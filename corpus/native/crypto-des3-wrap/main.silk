// Triple DES key wrap (RFC 3217) against OpenSSL's des3-wrap. Wrapping under a fixed IV is
// checked against a Python model of RFC 3217 that OpenSSL unwraps, and unwrapping against blobs
// that OpenSSL wrapped under its own random IV. Then: a changed byte in each block, a wrong key,
// and every length error. Exit code 42 is a pass.
import silk.crypto.des_wrap {TripleDesKeyWrap, TripleDesKeyWrapError}
import silk.core.result {Result}

fn same(a: &[u8], b: &[u8], length: usize) -> bool {
  if a.length < length || b.length < length {
    return false
  }
  let mut index: usize = 0
  while index < length {
    if a[index] != b[index] {
      return false
    }
    index = index + 1
  }
  return true
}

fn zero(a: &[u8], length: usize) -> bool {
  let mut index: usize = 0
  while index < length {
    if a[index] != 0 {
      return false
    }
    index = index + 1
  }
  return true
}

fn wrapped(key: &[u8], iv: &[u8], input: &[u8], expected: &[u8]) -> bool {
  let mut output: [u8; 96] = [0; 96]
  return match TripleDesKeyWrap.wrap(key, iv, input, &mut output) {
    Result<usize, TripleDesKeyWrapError>.Success { value } => value == expected.length && same(&output, expected, value)
    Result<usize, TripleDesKeyWrapError>.Failure { error: _ } => false
  }
}

fn unwrapped(key: &[u8], input: &[u8], expected: &[u8]) -> bool {
  let mut output: [u8; 96] = [0; 96]
  return match TripleDesKeyWrap.unwrap(key, input, &mut output) {
    Result<usize, TripleDesKeyWrapError>.Success { value } => value == expected.length && same(&output, expected, value)
    Result<usize, TripleDesKeyWrapError>.Failure { error: _ } => false
  }
}

fn rejected(key: &[u8], input: &[u8]) -> bool {
  let mut output: [u8; 96] = [0; 96]
  return match TripleDesKeyWrap.unwrap(key, input, &mut output) {
    Result<usize, TripleDesKeyWrapError>.Success { value: _ } => false
    Result<usize, TripleDesKeyWrapError>.Failure { error } => match error {
      TripleDesKeyWrapError.IntegrityCheckFailed => zero(&output, 96)
      _ => false
    }
  }
}

fn wrapError(key: &[u8], iv: &[u8], input: &[u8], output: &mut [u8]) -> u8 {
  return match TripleDesKeyWrap.wrap(key, iv, input, &mut output) {
    Result<usize, TripleDesKeyWrapError>.Success { value: _ } => 0
    Result<usize, TripleDesKeyWrapError>.Failure { error } => code(error)
  }
}

fn unwrapError(key: &[u8], input: &[u8], output: &mut [u8]) -> u8 {
  return match TripleDesKeyWrap.unwrap(key, input, &mut output) {
    Result<usize, TripleDesKeyWrapError>.Success { value: _ } => 0
    Result<usize, TripleDesKeyWrapError>.Failure { error } => code(error)
  }
}

fn code(error: TripleDesKeyWrapError) -> u8 {
  return match error {
    TripleDesKeyWrapError.InvalidKeyLength => 1
    TripleDesKeyWrapError.InvalidIvLength => 2
    TripleDesKeyWrapError.InvalidInputLength => 3
    TripleDesKeyWrapError.OutputTooSmall => 4
    TripleDesKeyWrapError.IntegrityCheckFailed => 5
  }
}

