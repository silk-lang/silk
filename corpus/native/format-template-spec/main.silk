import silk.os_writer { StdoutWriter }
import silk.effect { Effect }
import silk.format { Format }
import silk.writer { Writer, WriterError }

effect fn render() -> () ! WriterError ? &mut Writer {
  // Width, alignment, and fill, including a multi-byte fill.
  run Format.format("[{:>6}][{:<6}][{:^7}][{:*^7}][{:é>4}]\n", &(42, 42, "mid", "hi", 7))
  // Text defaults to the left and numbers to the right; precision cuts text.
  run Format.format("[{:5}][{:5}][{:.2}][{:>4.1}]\n", &("ab", 12, "héllo", "xyz"))
  // Sign, zero padding, and precision for integers and floats.
  run Format.format("[{:+}][{:+}][{:05}][{:+06}][{:.3}][{:08.2}][{:+.1}]\n", &(7, 0 - 7, 42, 42, 9, 0.0 - 3.14159, 2.25))
  // A fill of `0` with an alignment is ordinary fill, not zero padding.
  run Format.format("[{:0<5}][{:->5}]\n", &(42, 0 - 3))
  // Named placeholders take options too, and `-` changes nothing.
  let row = .{ name: "tea", cost: 2.5, count: 3 }
  run Format.format("{name:.<8}{cost:>7.2}{count:->4}|\n", &row)
  // Literal braces and colons stay text.
  return run Format.format("{{:>4}} a:b {:}\n", &(1, ))
}

effect fn build() -> i32 ! WriterError {
  let mut writer = StdoutWriter.make()
  run render() |> Effect.provideMut<Writer>(&mut writer)
  return 42
}
effect fn recover(error: WriterError) -> i32 { return 1 }
pub fn main() -> i32 { return run Effect.catchAll(build(), recover) }
