// A bare field name in a record literal reads the binding of that name: `Point {x, y}` is
// `Point {x: x, y: y}`, in struct, variant and contextual literals, from parameters, locals and
// constants, mixed with spelled-out fields.
struct Point {
  x: i32,
  y: i32,
}

union Shape {
  Circle { radius: i32 },
  Rect { width: i32, height: i32 },
}

const BASE: i32 = 5

struct Offset {
  BASE: i32,
}

fn make(x: i32, y: i32) -> Point {
  return Point {x, y}
}

fn area(shape: Shape) -> i32 {
  return match move shape {
    Shape.Circle {radius} => radius * 3
    Shape.Rect {width, height} => width * height
  }
}

fn shifted() -> Point {
  let offset: Offset = .{BASE}
  let y = 1
  return Point {y, x: offset.BASE}
}

pub fn main() -> i32 {
  let point = make(3, 4)
  let radius = 7
  let width = 2
  let circle = area(Shape.Circle {radius})
  let rect = area(Shape.Rect {width, height: 9,})
  let moved = shifted()
  return point.x + point.y + circle + rect + moved.x + moved.y
}
