// A generic function keeps any enum value by its member name or its discriminant and builds it back.
import silk.core.option { Option }
import silk.core.reflect { Reflect }

enum Tab { Home, Search, Settings }
enum(i16) Code { Low = -7, Mid, High = 300 }

fn byLabel<E>(value: E) -> Option<E> {
  return Reflect.enumFromLabel<E>(Reflect.enumLabelOf(move value))
}

fn total<E>() -> i16 {
  let mut sum: i16 = 0
  static for member in Reflect.enumMembers<E>() { sum = sum + Reflect.enumValue<E, i16>(member) }
  return sum
}

fn isTab(found: Option<Tab>, expected: Tab) -> bool {
  return match found {
    Option<Tab>.Some {value} => value == expected
    Option<Tab>.None => false
  }
}

fn isCode(found: Option<Code>, expected: Code) -> bool {
  return match found {
    Option<Code>.Some {value} => value == expected
    Option<Code>.None => false
  }
}

pub fn main() -> i32 {
  if !isTab(byLabel(Tab.Home), Tab.Home) || !isTab(byLabel(Tab.Settings), Tab.Settings) { return 1 }
  if !isCode(byLabel(Code.Low), Code.Low) || !isCode(byLabel(Code.High), Code.High) { return 2 }
  if Reflect.enumLabelOf(Code.Mid) != "Mid" { return 3 }
  if Reflect.enumFromLabel<Tab>("search").isSome() { return 4 }
  if !isCode(Reflect.enumFromValue<Code, i16>(-6), Code.Mid) { return 5 }
  if Reflect.enumFromValue<Code, i16>(299).isSome() { return 6 }
  if !isTab(Reflect.enumFromValue<Tab, u8>(2), Tab.Settings) { return 7 }
  if total<Code>() != 287 { return 8 }
  return 42
}
