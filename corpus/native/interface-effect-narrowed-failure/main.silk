import silk.core.effect { Effect }
import silk.core.result { Result }

struct First { value: i32 }
struct Second { value: i32 }

interface Work {
  effect fn perform(self: Self) -> i32 ! First | Second
}

struct Failing {}
impl Work for Failing {
  effect fn perform(self: Self) -> i32 ! Second { fail Second {value: 42} }
}

struct Ready {}
impl Work for Ready {
  effect fn perform(self: Self) -> i32 { return 7 }
}

effect fn evaluate<T: Work>(work: T) -> i32 {
  let pending = Work.perform(move work)
  let outcome = run Effect.result(move pending)
  return match move outcome {
    Result<i32, First | Second>.Success {value} => value
    Result<i32, First | Second>.Failure {error} => match move error {
      First value => value.value + 100
      Second value => value.value
    }
  }
}

pub effect fn main() -> i32 {
  if (run evaluate(Ready {})) != 7 { return 1 }
  return run evaluate(Failing {})
}
