// A request that arrives together with the client's FIN is answered, and then the server closes
// the connection instead of keeping it open.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.http.serve { Handler, Request, Response, Server }

unsafe extern "C" fn silk_start_half_close_client(port: i32) -> ()

struct Hello {}

impl Handler for Hello {
  effect fn handle(self: &Self, request: &Request<'_>, response: &mut Response<'_>) -> () ! OutOfMemoryError ? &mut Allocator {
    run response.text("hello")
    return ()
  }
}

effect fn failed<E>(error: E) -> i32 { drop error return 1 }

static if Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" {
  effect fn program() -> i32 ! OutOfMemoryError ? &mut Allocator {
    unsafe silk_start_half_close_client(18473)
    let _served = run Effect.result(Server.make(18473).workers(1).serve(Hello {}))
    // The client thread ends the process; reaching this line means the server stopped.
    return 8
  }
} else {
  // `silk.net.tcp_server` serves only on Linux with GNU libc.
  effect fn program() -> i32 ! OutOfMemoryError ? &mut Allocator { return 42 }
}

pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(program(), failed) |> Effect.provideMut<Allocator>(&mut allocator)
}
