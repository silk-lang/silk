import silk.i16
import silk.i32
import silk.i64
import silk.i8
import silk.isize
import silk.u16
import silk.u32
import silk.u64
import silk.u8
import silk.usize

fn conversions() -> i32 {
  // Same-width reinterpretation in both directions.
  if u16.wrappingToI16(65535) != -1 { return 1 }
  if u16.wrappingToI16(32768) != i16.MIN { return 2 }
  if u16.wrappingToI16(32767) != i16.MAX { return 3 }
  if i16.wrappingToU16(-2) != 65534 { return 4 }
  if i8.wrappingToU8(i8.MIN) != 128 { return 5 }
  if u8.wrappingToI8(200) != -56 { return 6 }
  if u32.wrappingToI32(4294967295) != -1 { return 7 }
  if i32.wrappingToU32(i32.MIN) != 2147483648 { return 8 }
  if u64.wrappingToI64(u64.MAX) != -1 { return 9 }
  if u64.wrappingToI64(9223372036854775808) != i64.MIN { return 10 }
  if i64.wrappingToU64(i64.MIN) != 9223372036854775808 { return 11 }
  // Truncation keeps the low bits.
  if u32.wrappingToU8(0x1234) != 0x34 { return 12 }
  if i32.wrappingToI16(65537) != 1 { return 13 }
  if i32.wrappingToI16(-65537) != -1 { return 14 }
  if i64.wrappingToI32(4294967296 + 5) != 5 { return 15 }
  if u64.wrappingToU32(u64.MAX) != u32.MAX { return 16 }
  if i64.wrappingToI8(-129) != 127 { return 17 }
  // Sign extension and zero extension.
  if i8.wrappingToI64(-3) != -3 { return 18 }
  if i8.wrappingToU32(-1) != u32.MAX { return 19 }
  if i16.wrappingToU64(-1) != u64.MAX { return 20 }
  if u8.wrappingToI32(255) != 255 { return 21 }
  // Pointer-sized types.
  if isize.wrappingToUsize(-1) != usize.MAX { return 22 }
  if usize.wrappingToIsize(usize.MAX) != -1 { return 23 }
  if i32.wrappingToIsize(-7) != -7 { return 24 }
  if usize.wrappingToU8(258) != 2 { return 25 }
  // Identity.
  if i32.wrappingToI32(i32.MIN) != i32.MIN { return 26 }
  return 0
}

fn bitCounts() -> i32 {
  if u64.countOnes(0) != 0 { return 31 }
  if u64.countOnes(u64.MAX) != 64 { return 32 }
  if u64.countOnes(0xF0F0) != 8 { return 33 }
  if u64.leadingZeros(0) != 64 { return 34 }
  if u64.leadingZeros(1) != 63 { return 35 }
  if u64.leadingZeros(9223372036854775808) != 0 { return 36 }
  if u64.trailingZeros(0) != 64 { return 37 }
  if u64.trailingZeros(9223372036854775808) != 63 { return 38 }
  if u64.trailingZeros(12) != 2 { return 39 }
  if u8.leadingZeros(1) != 7 { return 40 }
  if u8.leadingZeros(0) != 8 { return 41 }
  if u8.trailingZeros(0) != 8 { return 42 }
  if u16.countOnes(u16.MAX) != 16 { return 43 }
  if u32.leadingZeros(0x10000) != 15 { return 44 }
  if u32.trailingZeros(0) != 32 { return 45 }
  if i8.countOnes(-1) != 8 { return 46 }
  if i8.leadingZeros(-1) != 0 { return 47 }
  if i16.leadingZeros(1) != 15 { return 48 }
  if i32.trailingZeros(i32.MIN) != 31 { return 49 }
  if i64.countOnes(i64.MIN) != 1 { return 50 }
  if i64.trailingZeros(0) != 64 { return 51 }
  if usize.leadingZeros(0) != usize.BITS { return 52 }
  if usize.leadingZeros(1) != usize.BITS - 1 { return 53 }
  if isize.countOnes(-1) != isize.BITS { return 54 }
  return 0
}

pub fn main() -> i32 {
  let converted = conversions()
  if converted != 0 { return converted }
  let counted = bitCounts()
  if counted != 0 { return counted }
  return 42
}
