import silk.core.effect { Effect }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }

interface Read { fn read(self: &Self) -> i32 }
struct Letter { value: i32 }
struct Other {}
type Held<'a> = &'a any Read
impl Read for Letter { fn read(self: &Self) -> i32 { return self.value } }

fn wrap<'a>(value: &'a Letter) -> Held<'a> | Other { return value }
fn take<T>(value: T | Other, fallback: T) -> T {
  return match move value { Other _ => move fallback T held => move held }
}
effect fn total<'a>(letter: &'a Letter) -> i32 ! OutOfMemoryError ? &mut Allocator {
  let mut list = List<&'a any Read>.make()
  run List<&'a any Read>.append(&mut list, letter)
  let items = List<&'a any Read>.asSlice(&list)
  return items[0].read() + Read.read(take<Held<'a>>(wrap(letter), items[0]))
}
pub effect fn main() -> i32 ! OutOfMemoryError {
  let letter = Letter { value: 21 }
  let mut system = Allocator.systemAllocatorProvider()
  return run total(&letter) |> Effect.provideMut<Allocator>(&mut system)
}
