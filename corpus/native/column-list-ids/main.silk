import silk.collections.column_list { ColumnList, Rows, RowsMut }
import silk.collections.hash { Hash }
import silk.collections.hash_map { HashMap }
import silk.collections.id { Id }
import silk.core.effect { Effect }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }

// The links are one child struct, so they are one column: a row's links sit together.
struct Links {
  pub parent: Id<Node>,
  pub firstChild: Id<Node>,
  pub nextSibling: Id<Node>,
}

impl Copy for Links {}

struct Node {
  pub links: Links,
  pub depth: u32,
  pub weight: u32,
}

impl Copy for Node {}

fn leaf(parent: Id<Node>, weight: u32) -> Node {
  return Node {
    links: Links { parent, firstChild: Id<Node>.none(), nextSibling: Id<Node>.none() },
    depth: 0,
    weight,
  }
}

effect fn addChild(nodes: &mut ColumnList<Node>, parent: Id<Node>, weight: u32) -> Id<Node>
  ! OutOfMemoryError
  ? &mut Allocator {
  let child = run nodes.appendId(leaf(parent, weight))
  nodes[child].links.nextSibling = nodes[parent].links.firstChild
  nodes[parent].links.firstChild = child
  nodes[child].depth = nodes[parent].depth + 1
  return child
}

// The sum of the weights under `start`, following the links from row to row.
fn weightUnder(nodes: Rows<'_, Node>, start: Id<Node>) -> u32 {
  let mut total = nodes[start].weight
  let mut child = nodes[start].links.firstChild
  while !child.isNone() {
    total = total + weightUnder(nodes, child)
    child = nodes[child].links.nextSibling
  }
  return total
}

fn deepen(nodes: RowsMut<'_, Node>, start: Id<Node>) -> () {
  let mut nodes = move nodes
  let mut current = start
  while !current.isNone() {
    nodes[current].depth = nodes[current].depth + 10
    current = nodes[current].links.parent
  }
  return ()
}

effect fn build() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let mut nodes = ColumnList<Node>.make()
  let root = run nodes.appendId(leaf(Id<Node>.none(), 1))
  let left = run addChild(&mut nodes, root, 2)
  let right = run addChild(&mut nodes, root, 4)
  let deep = run addChild(&mut nodes, left, 8)
  if root.index() != 0 || deep.index() != 3 || root.isNone() { return 1 }
  if !nodes[root].links.parent.isNone() || &nodes[deep].links.parent != &left { return 2 }
  if &nodes[root].links.firstChild != &right || &nodes[right].links.nextSibling != &left { return 3 }
  if nodes[deep].depth != 2 || nodes[right].depth != 1 { return 4 }
  if weightUnder(nodes.rows(), root) != 15 || weightUnder(nodes.rows(), left) != 10 { return 5 }

  deepen(nodes.rowsMut(), deep)
  if nodes[deep].depth != 12 || nodes[left].depth != 11 || nodes[root].depth != 10 || nodes[right].depth != 1 { return 6 }

  // An id and a row number name the same row, and an id is a value: it compares, orders and
  // hashes by its number.
  if nodes[deep.index()].weight != 8 || nodes[Id<Node>.fromIndex(2)].weight != 4 { return 7 }
  if !(&left < &right) || &Id<Node>.fromRaw(3) != &deep || Id<Node>.none().raw() != 4294967295 { return 8 }
  let mut seen = HashMap<Id<Node>, u32>.make(Hash.seed(11))
  let _first = run seen.insert(left, 7)
  if !seen.contains(left) || seen.contains(right) { return 9 }

  // An id stays the row's number in the list on a handle for a part of the rows.
  let tail = nodes.rows().range(2, 4)
  if tail[deep].weight != 8 || tail[0].weight != 4 || tail[1].weight != 8 { return 10 }
  return 42
}

effect fn recover(error: OutOfMemoryError) -> i32 { return 99 }

pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(build() |> Effect.provideMut<Allocator>(&mut allocator), recover)
}
