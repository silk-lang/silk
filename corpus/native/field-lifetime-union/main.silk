// A union whose variant borrows declares the lifetime, like a struct, and its variants construct
// and match with the lifetime inferred in bodies.
import silk.text.string { String }
import silk.num.usize

union Command<'a> {
  List,
  Add { title: string<'a> },
}

fn weight<'a>(command: &Command<'a>) -> usize {
  return match &command.* {
    Command.List => 1
    Command.Add { title } => String.byteLength(title)
  }
}

pub fn main() -> i32 {
  let list = Command.List
  let add = Command.Add { title: "buy milk" }
  return usize.toI32(weight(&list) + weight(&add)) + 33
}
