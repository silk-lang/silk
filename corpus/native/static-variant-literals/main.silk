// Parses a small command line into a union of commands, building the variant whose kebab-case name
// matches the first word, with each field read from the following words.
import silk.core.option { Option }
import silk.core.reflect { Reflect }
import silk.text.string { String }
import silk.num.u8

union Command {
  Status,
  Add { pub count: u32 },
  Move { pub from: u32, pub to: u32 },
}

// The word that names a variant: its label with a lower-case first letter.
fn named(word: string, label: string) -> bool {
  if String.byteLength(word) != String.byteLength(label) || String.byteLength(word) == 0 {
    return false
  }
  let first = String.utf8Bytes(label)[0] + 32
  return String.utf8Bytes(word)[0] == first
    && String.slice(word, 1, String.byteLength(word) - 1)
      == String.slice(label, 1, String.byteLength(label) - 1)
}

fn digits(word: string) -> u32 {
  let mut value: u32 = 0
  let bytes = String.utf8Bytes(word)
  let mut at: usize = 0
  while at < bytes.length {
    value = value * 10 + u8.toU32(bytes[at] - 48)
    at = at + 1
  }
  return value
}

// Reads the field `field` from the word after the ones already used.
fn read<U>(static field: Intrinsic.Field<U, u32>, words: &[string], next: &mut usize) -> u32 {
  let value = digits(words[next.*])
  next.* = next.* + 1
  return value
}

fn parse<U>(words: &[string]) -> Option<U> {
  static for variant in Reflect.variants<U>() {
    if named(words[0], Reflect.variantLabel(variant)) {
      let mut next: usize = 1
      return Option<U>.some(
        U.[variant] {
          static for field in Reflect.variantFields(variant) { [field]: read(
            field,
            words,
            &mut next,
          ) },
        },
      )
    }
  }
  return Option<U>.none()
}

fn score(words: &[string]) -> u32 {
  return match parse<Command>(words) {
    Option.Some { value: Command.Status } => 1
    Option.Some { value: Command.Add { count } } => count
    Option.Some { value: Command.Move { from, to } } => from * 10 + to
    Option.None => 0
  }
}

pub fn main() -> i32 {
  let status = ["status"]
  let add = ["add", "7"]
  let shift = ["move", "3", "4"]
  let unknown = ["jump"]
  let total = score(&status) + score(&add) + score(&shift) + score(&unknown)

  // 1 + 7 + 34 + 0
  if total == 42 {
    return 42
  }
  return 1
}
