    if status != 200 {
      return 97
    }
    let read = run Client.readSome(&mut exchangeValue.*, &mut body)
    if read != 4 {
      return 98
    }
    run MonotonicClock.waitUntil(SystemClock.make(10, 0))
    stage = 1
  }
  while stage < 3 {
    let result = run Effect.result(deadlineOperation(&mut exchangeValue.*, stage, &mut body))
    match move result {
      Result.Success {value} => {
        drop value
        if stage == 0 {
          return 84
        }
        if stage == 1 {
          return 99
        }
        return 101
      }
      Result.Failure {error} => match move error {
        OutOfMemoryError allocation => {
          fail move allocation
        }
        ExchangeError cause => {
          let expected = match move cause {
            ExchangeError.Timeout => stage == 0 || stage == 1
            ExchangeError.InvalidState => stage == 2
            _ => false
          }
          if !expected {
            if stage == 0 {
              return 85
            }
            if stage == 1 {
              return 100
            }
            return 102
          }
        }
      }
    }
    if stage == 0 {
      return 0
    }
    stage = stage + 1
  }
  return 0
}

