import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.tls.server_protocol { TlsServerConfig, TlsConfigError }

// TlsServerConfig.fromPem takes P-256 and P-384 keys and refuses a key of any other named curve,
// such as secp256k1, with UnsupportedKey.

effect fn load(certificates: &[u8], key: &[u8]) -> i32 ! OutOfMemoryError ? &mut Allocator {
  let made = run Effect.result(TlsServerConfig.fromPem(certificates, key))
  return match move made {
    Result.Success { value } => { drop value 0 }
    Result.Failure { error } => match move error {
      TlsConfigError failure => match failure {
        TlsConfigError.UnsupportedKey => 1
        _ => 2
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

effect fn check() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let loaded1 = run load(b"-----BEGIN CERTIFICATE-----\nMIIBmDCCAT+gAwIBAgIUGhci8Q6H2nI4Bmf7kly5NCSqCycwCgYIKoZIzj0EAwIw\nFDESMBAGA1UEAwwJbG9jYWxob3N0MB4XDTI2MTEwNTAyMjk0NloXDTI3MTEwNTAy\nMjk0NlowFDESMBAGA1UEAwwJbG9jYWxob3N0MFkwEwYHKoZIzj0CAQYIKoZIzj0D\nAQcDQgAE99VvnEB4jfm/3BTuHLqlEniz9z+XYDh/yRIDYlB3ZBqf6/+wfICNaHd1\nbadU8jxUoJa4csFrX65h8h7SU55SgqNvMG0wHQYDVR0OBBYEFGum/p71+5lvblPl\nw+s6VdYNDjpVMB8GA1UdIwQYMBaAFGum/p71+5lvblPlw+s6VdYNDjpVMA8GA1Ud\nEwEB/wQFMAMBAf8wGgYDVR0RBBMwEYIJbG9jYWxob3N0hwR/AAABMAoGCCqGSM49\nBAMCA0cAMEQCIBCtw7LjeG62k1HlNNEdjX2PL0BTVJxaz/WkPtBQ7zZ0AiAH+uHB\nxDy7zMQnS0qNmbTuIGcbytZGyJWp6eG9GHQ2cQ==\n-----END CERTIFICATE-----\n", b"-----BEGIN PRIVATE KEY-----\nMIGHAgEAMBMGByqGSM49AgEGCCqGSM49AwEHBG0wawIBAQQgMfDv7EaI22SqNz9z\nx7Ut0xaaRv6cXgvEC22/gec58lGhRANCAAT31W+cQHiN+b/cFO4cuqUSeLP3P5dg\nOH/JEgNiUHdkGp/r/7B8gI1od3Vtp1TyPFSglrhywWtfrmHyHtJTnlKC\n-----END PRIVATE KEY-----\n")
  if loaded1 != 0 { return 1 }
  let loaded2 = run load(b"-----BEGIN CERTIFICATE-----\nMIIBujCCAUCgAwIBAgIUbM2LxGMKw9/EaNwzU8q7WBS1eCUwCgYIKoZIzj0EAwIw\nFDESMBAGA1UEAwwJbG9jYWxob3N0MB4XDTI2MTEwNzAzMjIyNFoXDTM2MTEwNDAz\nMjIyNFowFDESMBAGA1UEAwwJbG9jYWxob3N0MHYwEAYHKoZIzj0CAQYFK4EEACID\nYgAEoTfpKNQ9OSIsg9RZ9k6vL4WdP7XCrz6SO1X0QAOAvxb54UTnzCo4YhJkoicv\nZjt2FEGGxaDoOX+AzpCkZMNj2KrMYYYh5ZuFeHCicJcnirdr+EG3wmezfBX5xt/1\nlOOlo1MwUTAdBgNVHQ4EFgQUghLPbDEnkyB1MLH4HagwBQq2oJwwHwYDVR0jBBgw\nFoAUghLPbDEnkyB1MLH4HagwBQq2oJwwDwYDVR0TAQH/BAUwAwEB/zAKBggqhkjO\nPQQDAgNoADBlAjEAngVR1eBk69wG80iCwW2PQW8SYDnOSxYV01ajbjXVxOxGz45R\n4vAyAZyNQwRA4J7HAjB6yHFZJcTZ7cLBxS2w5DW0M6V6Ck+/pKo2C6LcuGN9L+tq\njxC/SQ1Tld7pqkVcGJ4=\n-----END CERTIFICATE-----\n", b"-----BEGIN PRIVATE KEY-----\nMIG2AgEAMBAGByqGSM49AgEGBSuBBAAiBIGeMIGbAgEBBDANsyBiVgOGyRQVW4UB\nMrfeqVkBKOA+Dqfyz1BahU3wVXkmWIIqySxW55wViNXgLjWhZANiAAShN+ko1D05\nIiyD1Fn2Tq8vhZ0/tcKvPpI7VfRAA4C/FvnhROfMKjhiEmSiJy9mO3YUQYbFoOg5\nf4DOkKRkw2PYqsxhhiHlm4V4cKJwlyeKt2v4QbfCZ7N8FfnG3/WU46U=\n-----END PRIVATE KEY-----\n")
  if loaded2 != 0 { return 2 }
  let loaded3 = run load(b"-----BEGIN CERTIFICATE-----\nMIIBejCCASCgAwIBAgIUCN+ZTaHVW2rXngkkuX722QcLmK0wCgYIKoZIzj0EAwIw\nFDESMBAGA1UEAwwJbG9jYWxob3N0MB4XDTI2MTEwNzAzMjIyNFoXDTM2MTEwNDAz\nMjIyNFowFDESMBAGA1UEAwwJbG9jYWxob3N0MFYwEAYHKoZIzj0CAQYFK4EEAAoD\nQgAEKLGOdLLErjmpS/EXITXUZ+9W1mR8fYg+hBD8JA9UO2Da+hqMWmzvS8AOtkbr\n01vdMxJbAFTjOm2bondfHzdVE6NTMFEwHQYDVR0OBBYEFMYvTdfrqdNnqhx2EGk5\nb0CHie9qMB8GA1UdIwQYMBaAFMYvTdfrqdNnqhx2EGk5b0CHie9qMA8GA1UdEwEB\n/wQFMAMBAf8wCgYIKoZIzj0EAwIDSAAwRQIhAJaVn+G0MAH8zTxPcNucdL4nSXIt\n9GBkfgvydxxao7i+AiBdqDJLGRCeB0t95pXvJyGhJW27gCSm3RUn+0HXJsixsQ==\n-----END CERTIFICATE-----\n", b"-----BEGIN PRIVATE KEY-----\nMIGEAgEAMBAGByqGSM49AgEGBSuBBAAKBG0wawIBAQQgdyF8WaPoq2Lra/dC3AtT\n3DZlEdHeQCG4p6gBnwOg0xChRANCAAQosY50ssSuOalL8RchNdRn71bWZHx9iD6E\nEPwkD1Q7YNr6GoxabO9LwA62RuvTW90zElsAVOM6bZuid18fN1UT\n-----END PRIVATE KEY-----\n")
  if loaded3 != 1 { return 3 }
  return 42
}

pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(check(), effect fn(error: OutOfMemoryError) -> i32 { drop error return 4 })
    |> Effect.provideMut<Allocator>(&mut allocator)
}
