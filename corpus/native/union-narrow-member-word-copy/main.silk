import silk.core.option { Option }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.num.u8
import silk.num.usize

enum Error {
  Malformed,
  Missing,
}

// Each failure stores a one-byte member at the payload of a union whose other member is a slice,
// and each success copies the whole payload; both must read back exactly.
@inlineNever
fn find<'a>(data: &'a [u8], index: usize) -> Option<&'a [u8]> {
  if index >= data.length { return Option<&'a [u8]>.None }
  return Option<&'a [u8]>.some(Slice.view<u8>(data, index, data.length - index))
}

@inlineNever
fn lookup<'a>(data: &'a [u8], index: usize) -> Result<&'a [u8], Error> {
  return match move find(data, index) {
    Option<&'a [u8]>.Some { value } => Result<&'a [u8], Error>.succeed(value)
    _ => Result<&'a [u8], Error>.failResult(Error.Missing)
  }
}

@inlineNever
fn flag(on: bool) -> bool | u64 {
  if on { return true }
  let seven: u64 = 7
  return seven
}

pub fn main() -> i32 {
  let data: [u8; 8] = [3; 8]
  let mut total: usize = 0
  let mut missing: usize = 0
  let mut i: usize = 0
  while i < 12 {
    match move lookup(&data, i) {
      Result<&[u8], Error>.Success { value } => { total = total + value.length + u8.toUsize(value[0]) }
      Result<&[u8], Error>.Failure { error } => {
        match error {
          Error.Missing => { missing = missing + 1 }
          Error.Malformed => {}
        }
      }
    }
    i = i + 1
  }
  if total != 36 + 24 || missing != 4 { return 1 }
  let widened = match flag(true) { bool value => value u64 value => false }
  let word = match flag(false) { bool value => 0 u64 value => value }
  if !widened || word != 7 { return 2 }
  return 42
}
