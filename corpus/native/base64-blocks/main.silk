import silk.encoding.base64 { Base64, Base64Error, Base64Reason }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.num.u32
import silk.num.u8

// Base64 can encode, check and decode in sixteen-character blocks; every length and every bad byte
// position must give the same text, bytes and errors as the byte-by-byte rules.
fn letter(value: u8) -> u8 {
  if value < 26 { return value + 65 }
  if value < 52 { return value + 71 }
  if value < 62 { return value - 4 }
  if value == 62 { return 43 }
  return 47
}

// Writes the reference encoding of `input` to `output` and returns its length.
fn reference(output: &mut [u8; 140], input: &[u8]) -> usize {
  let mut source: usize = 0
  let mut target: usize = 0
  while source < input.length {
    let a = input[source]
    let mut b: u8 = 0
    let mut c: u8 = 0
    if source + 1 < input.length { b = input[source + 1] }
    if source + 2 < input.length { c = input[source + 2] }
    output.*[target] = letter(u8.shiftRight(a, 2))
    output.*[target + 1] = letter(u8.bitOr(u8.shiftLeft(u8.bitAnd(a, 3), 4), u8.shiftRight(b, 4)))
    output.*[target + 2] = letter(u8.bitOr(u8.shiftLeft(u8.bitAnd(b, 15), 2), u8.shiftRight(c, 6)))
    output.*[target + 3] = letter(u8.bitAnd(c, 63))
    if source + 1 >= input.length { output.*[target + 2] = 61 }
    if source + 2 >= input.length { output.*[target + 3] = 61 }
    source = source + 3
    target = target + 4
  }
  return target
}

fn failure(result: Result<usize, Base64Error>) -> Option<Base64Error> {
  return match move result {
    Result<usize, Base64Error>.Success { value: _ } => Option<Base64Error>.none()
    Result<usize, Base64Error>.Failure { error } => Option<Base64Error>.some(move error)
  }
}

fn offsetOf(error: &Base64Error) -> usize {
  return match &error.offset {
    Option<usize>.Some { value } => value
    Option<usize>.None => 1000
  }
}

pub fn main() -> i32 {
  let mut input: [u8; 100] = [0; 100]
  let mut state: u32 = 7
  let mut fill: usize = 0
  while fill < 100 {
    state = u32.wrappingAdd(u32.wrappingMultiply(state, 1103515245), 12345)
    input[fill] = u32.toU8(u32.shiftRight(state, 24))
    fill = fill + 1
  }
  let mut expected: [u8; 140] = [0; 140]
  let mut length: usize = 0
  while length <= 100 {
    let size = reference(&mut expected, Slice.view(&input, 0, length))
    // Bytes past the written prefix keep their value.
    let mut encoded: [u8; 140] = [7; 140]
    let written = match move Base64.encodeInto(&mut encoded, Slice.view(&input, 0, length)) {
      Result<usize, Base64Error>.Success { value } => value
      Result<usize, Base64Error>.Failure { error: _ } => { return 1 }
    }
    if written != size { return 2 }
    let mut at: usize = 0
    while at < 140 {
      if at < size {
        if encoded[at] != expected[at] { return 3 }
      } else {
        if encoded[at] != 7 { return 4 }
      }
      at = at + 1
    }
    let mut decoded: [u8; 100] = [9; 100]
    let count = match move Base64.decodeInto(&mut decoded, Slice.view(&encoded, 0, size)) {
      Result<usize, Base64Error>.Success { value } => value
      Result<usize, Base64Error>.Failure { error: _ } => { return 5 }
    }
    if count != length { return 6 }
    at = 0
    while at < 100 {
      if at < length {
        if decoded[at] != input[at] { return 7 }
      } else {
        if decoded[at] != 9 { return 8 }
      }
      at = at + 1
    }
    // A bad byte before the final group is reported where it stands.
    let bad: [u8; 14] = [61, 45, 95, 32, 0, 200, 42, 44, 46, 58, 64, 91, 96, 123]
    let mut position: usize = 0
    while size >= 4 && position + 4 < size {
      let original = encoded[position]
      let mut pick: usize = 0
      while pick < 14 {
        encoded[position] = bad[pick]
        let found = match move failure(Base64.decodedLength(Slice.view(&encoded, 0, size))) {
          Option<Base64Error>.Some { value } => move value
          Option<Base64Error>.None => { return 9 }
        }
        if offsetOf(&found) != position { return 10 }
        let padding = match &found.reason {
          Base64Reason.InvalidPadding => true
          _ => false
        }
        if padding != (pick == 0) { return 11 }
        let mut out: [u8; 100] = [9; 100]
        match move failure(Base64.decodeInto(&mut out, Slice.view(&encoded, 0, size))) {
          Option<Base64Error>.Some { value: _ } => {}
          Option<Base64Error>.None => { return 12 }
        }
        if out[0] != 9 { return 13 }
        pick = pick + 1
      }
      encoded[position] = original
      position = position + 1
    }
    length = length + 1
  }
  return 0
}
