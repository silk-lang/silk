// `Intrinsic.processWord` answers one zero-initialized word per function instance, the same on
// every call of that instance and distinct from every other instance's word.
import silk.concurrency.atomic { Atomic, MemoryOrder }

fn counter() -> u64 {
  let word = Intrinsic.processWord()
  let seen = unsafe Atomic.load<u64>(word, MemoryOrder.Relaxed)
  unsafe Atomic.store<u64>(word, seen + 1, MemoryOrder.Relaxed)
  return seen
}

fn untouched() -> u64 {
  let word = Intrinsic.processWord()
  return unsafe Atomic.load<u64>(word, MemoryOrder.Relaxed)
}

// Each instance of a generic function has a word of its own.
fn tally<T>() -> u64 {
  let word = Intrinsic.processWord()
  return unsafe Atomic.fetchAdd<u64>(word, 1, MemoryOrder.Relaxed)
}

pub fn main() -> i32 {
  if counter() != 0 || counter() != 1 || counter() != 2 {
    return 1
  }
  if untouched() != 0 {
    return 2
  }
  if tally<u8>() != 0 || tally<u8>() != 1 || tally<u16>() != 0 {
    return 3
  }
  let first = Intrinsic.pointerAddress<*mut u64>(Intrinsic.processWord())
  let second = Intrinsic.pointerAddress<*mut u64>(Intrinsic.processWord())
  if first != second {
    return 4
  }
  return 0
}
