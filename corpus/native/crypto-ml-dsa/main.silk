import silk.collections.slice { Slice }
import silk.core.result { Result }
import silk.crypto.ml_dsa { MlDsa, MlDsaError, MlDsaParameters }
import silk.crypto.sha3 { Sha3_256 }
import silk.io.writer_native { StderrWriter }
import silk.num.u8

fn equal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut i: usize = 0
  while i < left.length {
    if left[i] != right[i] {
      return false
    }
    i = i + 1
  }
  return true
}

fn nibble(c: u8) -> u8 {
  if c >= 97 {
    return c - 87
  }
  return c - 48
}

// Writes the bytes of the hex digits `text` into `output` and returns their count.
fn hex(text: &[u8], output: &mut [u8; 5000]) -> usize {
  let length = text.length / 2
  let mut i: usize = 0
  while i < length {
    output[i] = u8.bitOr(u8.shiftLeft(nibble(text[2 * i]), 4), nibble(text[2 * i + 1]))
    i = i + 1
  }
  return length
}

fn parameters(level: i32) -> MlDsaParameters {
  if level == 44 {
    return MlDsaParameters.MlDsa44
  }
  if level == 65 {
    return MlDsaParameters.MlDsa65
  }
  return MlDsaParameters.MlDsa87
}

fn report(id: i32, what: i32) -> i32 {
  StderrWriter.print("case {} failed at {}\n", &.(id, what))
  return 1
}

// Wycheproof sign_seed: the key pair of the seed must have the public key (by SHA3-256).
fn keyPair(id: i32, level: i32, seed: &[u8], publicHash: &[u8], privateKey: &mut [u8; 5000]) -> i32 {
  let set = parameters(level)
  let mut publicKey: [u8; 2592] = [0; 2592]
  let ok = match MlDsa.keyPairFromSeed(set, seed, Slice.viewMut<u8>(&mut publicKey, 0, set.publicKeyLength()), Slice.viewMut<u8>(&mut privateKey, 0, set.privateKeyLength())) {
    Result<(), MlDsaError>.Success { .. } => true
    Result<(), MlDsaError>.Failure { error: _ } => false
  }
  if publicHash.length == 0 {
    if ok {
      return report(id, 1)
    }
    return 0
  }
  if !ok || !equal(&Sha3_256.hash(Slice.view<u8>(&publicKey, 0, set.publicKeyLength())), publicHash) {
    return report(id, 2)
  }
  return 0
}

// Wycheproof sign tests: mu of the message (when given) and the signature (by SHA3-256), or a
// refusal. `internal` cases give only mu.
fn signs(id: i32, level: i32, privateKey: &[u8], publicKey: &[u8], message: &[u8], context: &[u8], internal: bool, mu: &[u8], randomness: &[u8], signatureHash: &[u8], valid: bool) -> i32 {
  let set = parameters(level)
  let mut signature: [u8; 4627] = [0; 4627]
  let length = set.signatureLength()
  let mut ok = false
  if internal {
    ok = match MlDsa.signExternalMu(set, privateKey, mu, randomness, Slice.viewMut<u8>(&mut signature, 0, length)) {
      Result<(), MlDsaError>.Success { .. } => true
      Result<(), MlDsaError>.Failure { error: _ } => false
    }
  } else {
    if valid {
      let computed = match MlDsa.externalMu(set, publicKey, message, context) {
        Result<[u8; 64], MlDsaError>.Success { value } => value
        Result<[u8; 64], MlDsaError>.Failure { error: _ } => {
          return report(id, 3)
        }
      }
      if !equal(&computed, mu) {
        return report(id, 4)
      }
    }
    if randomness.length == 0 {
      ok = match MlDsa.signDeterministic(set, privateKey, message, context, Slice.viewMut<u8>(&mut signature, 0, length)) {
        Result<(), MlDsaError>.Success { .. } => true
        Result<(), MlDsaError>.Failure { error: _ } => false
      }
    } else {
      ok = match MlDsa.signExternalMu(set, privateKey, mu, randomness, Slice.viewMut<u8>(&mut signature, 0, length)) {
        Result<(), MlDsaError>.Success { .. } => true
        Result<(), MlDsaError>.Failure { error: _ } => false
      }
    }
  }
  if !valid {
    if ok {
      return report(id, 5)
    }
    return 0
  }
  if !ok {
    return report(id, 6)
  }
  if !equal(&Sha3_256.hash(Slice.view<u8>(&signature, 0, length)), signatureHash) {
    return report(id, 7)
  }
  if publicKey.length != 0 && !MlDsa.verify(set, publicKey, message, context, Slice.view<u8>(&signature, 0, length)) && !internal {
    return report(id, 8)
  }
  return 0
}

fn verifies(id: i32, level: i32, publicKey: &[u8], message: &[u8], context: &[u8], signature: &[u8], valid: bool) -> i32 {
  if MlDsa.verify(parameters(level), publicKey, message, context, signature) != valid {
    return report(id, 9)
  }
  return 0
}

