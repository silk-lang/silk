enum Mode { Fast, Slow }

fn echo(static mode: Mode) -> Mode {
  return mode
}

fn pick(static table: [i32; 3], index: usize) -> i32 {
  let local = table
  return local[index]
}

pub fn main() -> i32 {
  let mode = echo(Mode.Slow)
  if mode != Mode.Slow {
    return 1
  }
  return match mode {
    Mode.Fast => 2
    Mode.Slow => pick([5, 30, 7], 1) + 12
  }
}