import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.crypto.dh { DhError, DhGroup }
import silk.crypto.modular { ModularError, Natural }
import silk.crypto.prime { Prime, PrimeError, PrimeOptions }
import silk.num.u32
import silk.num.u64
import silk.system.random { Random }

struct Counter {
  state: u64,
}

impl Random for Counter {
  effect fn fillBytes(self: &mut Self, output: &mut [u8]) -> () {
    let mut index: usize = 0
    while index < output.length {
      self.state = u64.wrappingAdd(u64.wrappingMultiply(self.state, 6364136223846793005), 1)
      output[index] = u64.toU8(u64.shiftRight(self.state, 56))
      index = index + 1
    }
  }
}

fn number(bytes: &[u8]) -> Natural {
  return match Natural.fromBytes(bytes) {
    Result<Natural, ModularError>.Success { value } => value
    Result<Natural, ModularError>.Failure { error: _ } => Intrinsic.trap("number")
  }
}

fn options(safe: bool, add: &[u8], remainder: &[u8]) -> PrimeOptions {
  let mut addValue = Option<Natural>.none()
  if add.length > 0 {
    addValue = Option<Natural>.some(number(add))
  }
  let mut remainderValue = Option<Natural>.none()
  if remainder.length > 0 {
    remainderValue = Option<Natural>.some(number(remainder))
  }
  return PrimeOptions { safe: safe, add: addValue, remainder: remainderValue }
}

effect fn isPrime(bytes: &[u8]) -> bool
  ? &mut Random {
  return run Prime.isProbablePrime(&number(bytes), 64)
}

// A generated prime has the bit length, passes again, and meets the constraint.
effect fn generates(bits: usize, safe: bool, add: &[u8], remainder: &[u8], expected: u32) -> bool
  ? &mut Random {
  let wanted = options(safe, add, remainder)
  return match run Prime.generate(bits, &wanted) {
    Result<Natural, PrimeError>.Success { value } => {
      if value.bitLength() != bits || !run Prime.isProbablePrime(&value, 64) {
        return false
      }
      if safe && !run Prime.isProbablePrime(&value.shiftRight(1), 64) {
        return false
      }
      if add.length > 0 {
        let rest = match value.remainder(&number(add)) {
          Result<Natural, ModularError>.Success { value: found } => found
          Result<Natural, ModularError>.Failure { error: _ } => {
            return false
          }
        }
        return rest.equals(&Natural.fromU64(u32.toU64(expected)))
      }
      return true
    }
    Result<Natural, PrimeError>.Failure { error: _ } => false
  }
}

effect fn generateFails(
  bits: usize,
  safe: bool,
  add: &[u8],
  remainder: &[u8],
  expected: PrimeError,
) -> bool
  ? &mut Random {
  let wanted = options(safe, add, remainder)
  return match run Prime.generate(bits, &wanted) {
    Result<Natural, PrimeError>.Success { value: _ } => false
    Result<Natural, PrimeError>.Failure { error } => error == expected
  }
}

effect fn checks(prime: &[u8], expectPrime: bool, expectSafe: bool) -> bool
  ? &mut Random {
  return match DhGroup.make(prime, b"\x02") {
    Result<DhGroup, DhError>.Success { value } => {
      let result = run value.check()
      return result.prime == expectPrime && result.safePrime == expectSafe
    }
    Result<DhGroup, DhError>.Failure { error: _ } => false
  }
}

