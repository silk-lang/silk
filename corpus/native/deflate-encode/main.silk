import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.core.effect {Effect}
import silk.compress.deflate {Deflate, EncodeError}
import silk.compress.inflate {Decoder, Format, Limits, Status, Progress, DecodeError}
import silk.collections.list {List}
import silk.core.result {Result}
import silk.collections.slice {Slice}
import silk.core.option {Option}
import silk.num.u32
import silk.num.usize

effect fn roundtrip(input: &[u8], format: Format) -> bool
! OutOfMemoryError | EncodeError | DecodeError ? &mut Allocator {
  let mut encoded = List<u8>.make()
  let mut decoded = List<u8>.make()
  let mut index: usize = 0
  let bound = match move Deflate.encodedBound(input.length, format) {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return false }
  }
  run List<u8>.reserveExact(&mut encoded, bound + 1)
  run List<u8>.reserveExact(&mut decoded, input.length + 1)
  while index < bound + 1 { run List<u8>.append(&mut encoded, 165) index = index + 1 }
  index = 0
  while index < input.length + 1 { run List<u8>.append(&mut decoded, 165) index = index + 1 }
  let size = run Deflate.encode(input, List<u8>.asMutSlice(&mut encoded), format)
  if List<u8>.get(&encoded, size) != 165 { return false }
  let limits = Limits {maxInputBytes: usize.toU64(size), maxOutputBytes: usize.toU64(input.length), maxMembers: 1, maxHeaderBytes: 10, maxMemoryBytes: 65536}
  let mut decoder = run Decoder.make(format, move limits)
  let result = Decoder.step(&mut decoder, Slice.view<u8>(List<u8>.asSlice(&encoded), 0, size), List<u8>.asMutSlice(&mut decoded), true)
  let valid = match move result {
    Result<Progress, DecodeError>.Success {value} => value.status == Status.Finished && value.consumed == size && value.written == input.length
    Result<Progress, DecodeError>.Failure {error} => false
  }
  if !valid { return false }
  index = 0
  while index < input.length {
    if List<u8>.get(&decoded, index) != input[index] { return false }
    index = index + 1
  }
  return List<u8>.get(&decoded, input.length) == 165
}

effect fn bounds(format: Format) -> bool ! OutOfMemoryError | EncodeError ? &mut Allocator {
  let input = b"abracadabra abracadabra"
  let mut output: [u8; 128] = [165; 128]
  let size = run Deflate.encode(input, &mut output, format)
  let mut width: usize = 0
  while width < size {
    let mut small = List<u8>.make()
    run List<u8>.reserveExact(&mut small, width)
    let mut index: usize = 0
    while index < width { run List<u8>.append(&mut small, 165) index = index + 1 }
    let result = run Effect.result(Deflate.encode(input, List<u8>.asMutSlice(&mut small), format))
    let valid = match move result {
      Result<usize, OutOfMemoryError | EncodeError>.Success {value} => false
      Result<usize, OutOfMemoryError | EncodeError>.Failure {error} => match move error {
        EncodeError failure => failure.written == width
        OutOfMemoryError failure => false
      }
    }
    if !valid { return false }
    width = width + 1
  }
  let mut exact = List<u8>.make()
  run List<u8>.reserveExact(&mut exact, size)
  width = 0
  while width < size { run List<u8>.append(&mut exact, 0) width = width + 1 }
  let again = run Deflate.encode(input, List<u8>.asMutSlice(&mut exact), format)
  if again != size { return false }
  width = 0
  while width < size {
    if List<u8>.get(&exact, width) != output[width] { return false }
    width = width + 1
  }
  return true
}

effect fn program() -> i32 ! OutOfMemoryError | EncodeError | DecodeError ? &mut Allocator {
  let mut input = List<u8>.make()
  run List<u8>.reserveExact(&mut input, 90000)
  let mut index: usize = 0
  let mut random: u32 = 123456789
  while index < 90000 {
    let mut byte: u8 = 0
    if index < 30000 {
      random = u32.bitXor(random, u32.shiftLeft(random, 13))
      random = u32.bitXor(random, u32.shiftRight(random, 17))
      random = u32.bitXor(random, u32.shiftLeft(random, 5))
      byte = u32.toU8(u32.bitAnd(random, 255))
    } else { byte = List<u8>.get(&input, usize.remainder(index, 30000)) }
    run List<u8>.append(&mut input, byte)
    index = index + 1
  }
  let mut worst = List<u8>.make()
  run List<u8>.reserveExact(&mut worst, 112)
  index = 0
  while index < 112 { run List<u8>.append(&mut worst, usize.toU8(index + 144)) index = index + 1 }
  let mut tight: [u8; 128] = [0; 128]
  let tightSize = run Deflate.encode(List<u8>.asSlice(&worst), &mut tight, Format.Raw)
  if tightSize != 128 { return 7 }
  if let Option<usize>.Some {value} = Deflate.encodedBound(usize.MAX - 3, Format.Raw) { return 8 }
  let formats: [Format; 3] = [Format.Raw, Format.Zlib, Format.Gzip]
  index = 0
  while index < 3 {
    let format = formats[index]
    if !run roundtrip(List<u8>.asSlice(&worst), format) { return 9 }
    if !run roundtrip(b"", format) { return 1 }
    if !run roundtrip(b"a", format) { return 2 }
    if !run roundtrip(b"aaa", format) { return 3 }
    if !run roundtrip(b"abcabcabcabcabcabcabcabc", format) { return 4 }
    if !run roundtrip(List<u8>.asSlice(&input), format) { return 5 }
    if !run bounds(format) { return 6 }
    index = index + 1
  }
  return 42
}
pub effect fn main() -> i32 ! OutOfMemoryError | EncodeError | DecodeError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run program() |> Effect.provideMut<Allocator>(&mut allocator)
}
