import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.core.effect {Effect}
import silk.compress.deflate {EncodeError, EncodeErrorKind, EncodeProgress, EncodeStatus, Encoder, Flush, Options, Strategy}
import silk.compress.inflate {Decoder, Format, Limits, Status, Progress, DecodeError}
import silk.compress.checksum {CompressionChecksum}
import silk.collections.list {List}
import silk.core.result {Result}
import silk.collections.slice {Slice}
import silk.core.option {Option}
import silk.num.u32
import silk.num.usize

fn limits(size: usize, length: usize) -> Limits {
  return Limits {maxInputBytes: usize.toU64(size), maxOutputBytes: usize.toU64(length), maxMembers: 1, maxHeaderBytes: 10, maxMemoryBytes: 65536}
}

// Decodes `encoded` and checks that it is exactly `input`.
effect fn decodes(encoded: &[u8], input: &[u8], format: Format, dictionary: &[u8]) -> bool
! OutOfMemoryError | DecodeError ? &mut Allocator {
  let mut decoded = List<u8>.make()
  run List<u8>.appendRepeated(&mut decoded, 165, input.length + 1)
  let mut decoder = run Decoder.make(format, limits(encoded.length, input.length))
  if dictionary.length != 0 {
    if let Result<(), DecodeError>.Failure {..} = Decoder.setDictionary(&mut decoder, dictionary) { return false }
  }
  let valid = match move Decoder.step(&mut decoder, encoded, List<u8>.asMutSlice(&mut decoded), true) {
    Result<Progress, DecodeError>.Success {value} => value.status == Status.Finished && value.consumed == encoded.length && value.written == input.length
    Result<Progress, DecodeError>.Failure {..} => false
  }
  if !valid { return false }
  let mut index: usize = 0
  while index < input.length {
    if List<u8>.get(&decoded, index) != input[index] { return false }
    index = index + 1
  }
  return List<u8>.get(&decoded, input.length) == 165
}

// One-shot encoding within the bound, at the given options.
effect fn roundtrip(input: &[u8], format: Format, options: Options) -> bool
! OutOfMemoryError | EncodeError | DecodeError ? &mut Allocator {
  let bound = match move Encoder.encodedBound(input.length, format) {
    Option<usize>.Some {value} => value
    Option<usize>.None => { return false }
  }
  let mut encoded = List<u8>.make()
  run List<u8>.appendRepeated(&mut encoded, 165, bound + 1)
  let size = run Encoder.encode(input, List<u8>.asMutSlice(&mut encoded), format, move options)
  if List<u8>.get(&encoded, size) != 165 { return false }
  return run decodes(Slice.view<u8>(List<u8>.asSlice(&encoded), 0, size), input, format, b"")
}

// Streams `input` in 1000-byte parts with `flush` after each part and a 7-byte output buffer.
effect fn streamed(input: &[u8], format: Format, flush: Flush, dictionary: &[u8]) -> bool
! OutOfMemoryError | EncodeError | DecodeError ? &mut Allocator {
  let mut encoder = run Encoder.make(format, Options.make(6))
  if dictionary.length != 0 {
    if let Result<(), EncodeError>.Failure {..} = Encoder.setDictionary(&mut encoder, dictionary) { return false }
  }
  let mut encoded = List<u8>.make()
  let mut buffer: [u8; 7] = [0; 7]
  let mut position: usize = 0
  let mut round: u32 = 0
  while true {
    let mut end = position + 1000
    let mut mode = flush
    if end >= input.length {
      end = input.length
      mode = Flush.Finish
    }
    let mut part = Slice.view<u8>(input, position, end - position)
    while true {
      let progress = match move Encoder.step(&mut encoder, part, &mut buffer, mode) {
        Result<EncodeProgress, EncodeError>.Success {value} => move value
        Result<EncodeProgress, EncodeError>.Failure {..} => { return false }
      }
      run List<u8>.appendSlice(&mut encoded, Slice.view<u8>(&buffer, 0, progress.written))
      part = Slice.view<u8>(part, progress.consumed, part.length - progress.consumed)
      if progress.status == EncodeStatus.Finished {
        return run decodes(List<u8>.asSlice(&encoded), input, format, dictionary)
      }
      if progress.status == EncodeStatus.NeedInput || progress.status == EncodeStatus.Flushed { break }
    }
    if flush == Flush.Sync && List<u8>.length(&encoded) >= 4 {
      let length = List<u8>.length(&encoded)
      if List<u8>.get(&encoded, length - 1) != 255 || List<u8>.get(&encoded, length - 2) != 255
        || List<u8>.get(&encoded, length - 3) != 0 || List<u8>.get(&encoded, length - 4) != 0 {
        return false
      }
    }
    round = round + 1
    if flush == Flush.Block {
      let strategies: [Strategy; 5] = [Strategy.Default, Strategy.Filtered, Strategy.HuffmanOnly, Strategy.Rle, Strategy.Fixed]
      let level = u32.remainder(round * 7, 10)
      if let Result<(), EncodeError>.Failure {..} = Encoder.setParameters(&mut encoder, level, strategies[u32.toUsize(u32.remainder(round, 5))]) {
        return false
      }
    }
    position = end
  }
  return false
}

// A buffer one byte shorter than the stream fails with OutputFull after filling it completely.
effect fn bounds(format: Format) -> bool ! OutOfMemoryError | EncodeError ? &mut Allocator {
  let input = b"abracadabra abracadabra"
  let mut output: [u8; 128] = [165; 128]
  let size = run Encoder.encode(input, &mut output, format, Options.make(9))
  let mut small = List<u8>.make()
  run List<u8>.appendRepeated(&mut small, 165, size - 1)
  let result = run Effect.result(Encoder.encode(input, List<u8>.asMutSlice(&mut small), format, Options.make(9)))
  return match move result {
    Result<usize, OutOfMemoryError | EncodeError>.Success {..} => false
    Result<usize, OutOfMemoryError | EncodeError>.Failure {error} => match move error {
      EncodeError failure => failure.kind == EncodeErrorKind.OutputFull && failure.written == size - 1
        && List<u8>.get(&small, size - 2) == output[size - 2]
      OutOfMemoryError {..} => false
    }
  }
}

effect fn program() -> i32 ! OutOfMemoryError | EncodeError | DecodeError ? &mut Allocator {
  let mut input = List<u8>.make()
  run List<u8>.reserveExact(&mut input, 90000)
  let mut index: usize = 0
  let mut random: u32 = 123456789
  while index < 90000 {
    let mut byte: u8 = 0
    if index < 30000 {
      random = u32.bitXor(random, u32.shiftLeft(random, 13))
      random = u32.bitXor(random, u32.shiftRight(random, 17))
      random = u32.bitXor(random, u32.shiftLeft(random, 5))
      byte = u32.toU8(u32.bitAnd(random, 255))
    } else { byte = List<u8>.get(&input, usize.remainder(index, 30000)) }
    run List<u8>.append(&mut input, byte)
    index = index + 1
  }
  let data = List<u8>.asSlice(&input)
  if let Option<usize>.Some {..} = Encoder.encodedBound(usize.MAX - 3, Format.Raw) { return 8 }
  if CompressionChecksum.crc32Update(CompressionChecksum.crc32(b"abc"), b"def") != CompressionChecksum.crc32(b"abcdef") { return 10 }
  if CompressionChecksum.adler32(b"Wikipedia") != 0x11e60398 { return 11 }
  if CompressionChecksum.adler32Update(CompressionChecksum.adler32(b"Wiki"), b"pedia") != 0x11e60398 { return 12 }
  if CompressionChecksum.crc32(b"123456789") != 0xcbf43926 { return 13 }
  let formats: [Format; 3] = [Format.Raw, Format.Zlib, Format.Gzip]
  let strategies: [Strategy; 5] = [Strategy.Default, Strategy.Filtered, Strategy.HuffmanOnly, Strategy.Rle, Strategy.Fixed]
  index = 0
  while index < 3 {
    let format = formats[index]
    if !run roundtrip(b"", format, Options.make(6)) { return 1 }
    if !run roundtrip(b"a", format, Options.make(1)) { return 2 }
    if !run roundtrip(b"abcabcabcabcabcabcabcabc", format, Options.make(9)) { return 4 }
    let mut level: u32 = 0
    while level <= 9 {
      let options = Options {level: level, windowBits: 9 + u32.remainder(level, 7), memoryLevel: 1 + u32.remainder(level, 9), strategy: strategies[u32.toUsize(u32.remainder(level, 5))]}
      if !run roundtrip(data, format, move options) { return 5 }
      level = level + 3
    }
    if !run bounds(format) { return 6 }
    if !run streamed(data, format, Flush.Sync, b"") { return 14 }
    if !run streamed(data, format, Flush.Partial, b"") { return 15 }
    if !run streamed(data, format, Flush.Full, b"") { return 16 }
    if !run streamed(data, format, Flush.Block, b"") { return 17 }
    if format != Format.Gzip && !run streamed(Slice.view<u8>(data, 30000, 5000), format, Flush.None, Slice.view<u8>(data, 0, 40000)) { return 18 }
    index = index + 1
  }
  let mut gzip = run Encoder.make(Format.Gzip, Options.make(6))
  if let Result<(), EncodeError>.Success {..} = Encoder.setDictionary(&mut gzip, b"abc") { return 19 }
  if let Result<Encoder, OutOfMemoryError | EncodeError>.Success {..} = run Effect.result(Encoder.make(Format.Raw, Options {level: 6, windowBits: 8, memoryLevel: 8, strategy: Strategy.Default})) { return 20 }
  return 42
}

pub effect fn main() -> i32 ! OutOfMemoryError | EncodeError | DecodeError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run program() |> Effect.provideMut<Allocator>(&mut allocator)
}
