import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.list { List }
import silk.ownership { Copy }
import silk.usize

struct Big { a: u64, b: u64, c: u64, d: u64, e: u64, f: u64, g: u64, h: u64, i: u64, j: u64 }
impl Copy for Big {}

effect fn single(value: u8) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let mut values = List<u8>.make()
  run List<u8>.append(&mut values, value)
  return move values
}

effect fn work() -> u64 ! OutOfMemoryError ? &mut Allocator {
  let mut list = List<Big>.make()
  let mut n: u64 = 0
  while n < 200 {
    run List<Big>.append(&mut list, Big { a: n, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8, i: 9, j: 10 })
    n = n + 1
  }
  let mut k: u64 = 0
  while k < 1000 {
    run List<Big>.insert(&mut list, 0, Big { a: 999, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8, i: 9, j: 10 })
    drop List<Big>.remove(&mut list, 0)
    k = k + 1
  }
  // Insert in the middle and at the end, remove from the middle and the end.
  run List<Big>.insert(&mut list, 100, Big { a: 7000, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8, i: 9, j: 10 })
  let end = List<Big>.length(&list)
  run List<Big>.insert(&mut list, end, Big { a: 8000, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8, i: 9, j: 10 })
  if List<Big>.get(&list, 99).a != 99 || List<Big>.get(&list, 100).a != 7000 || List<Big>.get(&list, 101).a != 100 { return 1 }
  if List<Big>.get(&list, 201).a != 8000 { return 2 }
  let removed = List<Big>.remove(&mut list, 100)
  if removed.a != 7000 || List<Big>.get(&list, 100).a != 100 { return 3 }
  let last = List<Big>.remove(&mut list, 200)
  if last.a != 8000 || List<Big>.length(&list) != 200 { return 4 }
  // Owned elements with cleanup move without being dropped twice.
  let mut lists = List<List<u8>>.make()
  run List<List<u8>>.append(&mut lists, run single(2))
  run List<List<u8>>.insert(&mut lists, 0, run single(1))
  run List<List<u8>>.insert(&mut lists, 2, run single(3))
  let middle = List<List<u8>>.remove(&mut lists, 1)
  if List<u8>.get(&middle, 0) != 2 || List<List<u8>>.length(&lists) != 2 { return 5 }
  let rest = List<List<u8>>.asSlice(&lists)
  if List<u8>.get(&rest[1], 0) != 3 { return 6 }
  return List<Big>.get(&list, 5).a
}

pub effect fn main() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let result = run work() |> Effect.provideMut<Allocator>(&mut allocator)
  if result != 5 { return 1 }
  return 42
}
