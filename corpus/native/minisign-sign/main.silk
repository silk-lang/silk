// Signs with silk.crypto.minisign and checks every file against bytes computed independently:
// an unencrypted and an encrypted secret key file, the public key, and a signature that verifies.
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.core.result {Result}
import silk.collections.bytes {Bytes}
import silk.crypto.minisign as Minisign {MinisignError, MinisignKey, MinisignSecretKey}
import silk.system.random {Random}
import silk.num.u8
import silk.num.usize

// Fills with 0, 1, 2, ... so the key id is bytes 0 to 7 and the seed bytes 8 to 39.
struct Counting {
  next: u8,
}

impl Random for Counting {
  effect fn fillBytes(self: &mut Self, buffer: &mut [u8]) -> () {
    let mut at: usize = 0
    while at < buffer.length {
      buffer[at] = self.next
      self.next = u8.wrappingAdd(self.next, 1)
      at = at + 1
    }
  }
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at: usize = 0
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + 1
  }
  return true
}

const PLAIN: &[u8] = b"untrusted comment: minisign secret key\nRWQAAEIyAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAAECAwQFBgcICQoLDA0ODxAREhMUFRYXGBkaGxwdHh8gISIjJCUmJ0vd7lUO9zTK4E7uQq5jo3nTEStrpzr1NWiNcsmagoRgMaI2HR0ikGtv9dO3hFMAFdcXYT8xEA12wxpG5a+6yYE=\n"
// The same key encrypted with password `hunter2`, salt 100 to 131, opslimit 65536 and memlimit
// 64 MiB (scrypt N = 2048, r = 8, p = 1).
const ENCRYPTED: &[u8] = b"untrusted comment: minisign encrypted secret key\nRWRTY0IyZGVmZ2hpamtsbW5vcHFyc3R1dnd4eXp7fH1+f4CBgoMAAAEAAAAAAAAAAAQAAAAAPXnjnrgAW5msis0OA5NmitaAkKwBSIGpRukeldrVlQhDKEJst4+wnarZvUSmXz9lzFmnp6Q21cJRQJddpdPX6P9QsJdUhGTsEvX6deLFeBrsWV6T+TY4cXa4Jc9LBG8PRrQw0ZqQnLA=\n"
const SIGNATURE: &[u8] = b"untrusted comment: signature from minisign secret key\nRUQAAQIDBAUGB4rUap+FpmugdTJbWhxOoaPiRHtkqXrNl2nKv7fMNGKxb6nNcGvldfB5SgNzYSRRvcxmR411NDrHWYc5stOWbAQ=\ntrusted comment: demo 1.0.0 demo-1.0.0.tar.gz\nbh0QYkdF8kCbaOH1ICQDOQeikHa3gV76FZUavXJLzE5dMHiog0JCtnOHt9M8PDPM9OkkPEU1/dOekRe5IZ/ZAg==\n"
const PUBLIC: &[u8] = b"untrusted comment: minisign public key 0706050403020100\nRWQAAQIDBAUGB0vd7lUO9zTK4E7uQq5jo3nTEStrpzr1NWiNcsmagoRg\n"

effect fn signed(secret: &MinisignSecretKey) -> bool ! OutOfMemoryError ? &mut Allocator {
  return match run Minisign.sign(secret, b"silk pack", b"demo 1.0.0 demo-1.0.0.tar.gz") {
    Result<Bytes, MinisignError>.Success {value} => same(Bytes.asSlice(&value), SIGNATURE)
    Result<Bytes, MinisignError>.Failure {..} => false
  }
}

effect fn refused(text: &[u8], password: Option<&[u8]>, expected: MinisignError) -> bool ! OutOfMemoryError ? &mut Allocator {
  return match run Minisign.secretKey(text, password) {
    Result<MinisignSecretKey, MinisignError>.Success {..} => false
    Result<MinisignSecretKey, MinisignError>.Failure {error} => error == expected
  }
}

effect fn exercise() -> i32 ! OutOfMemoryError ? &mut Allocator | &mut Random {
  let generated = run MinisignSecretKey.generate()
  if !same(&generated.idText(), b"0706050403020100") { return 1 }
  if !same(Bytes.asSlice(&run Minisign.publicKeyFile(&generated)), PUBLIC) { return 2 }
  if !same(Bytes.asSlice(&run Minisign.secretKeyFile(&generated, Option<&[u8]>.none())), PLAIN) { return 3 }
  if !(run signed(&generated)) { return 4 }
  // The signature verifies with the public key.
  let public = match Minisign.key(&generated.publicKeyText()) {
    Result<MinisignKey, MinisignError>.Success {value} => move value
    Result<MinisignKey, MinisignError>.Failure {..} => { return 5 }
  }
  match Minisign.verify(&public, SIGNATURE, b"silk pack") {
    Result<&[u8], MinisignError>.Success {value} => {
      if !same(value, b"demo 1.0.0 demo-1.0.0.tar.gz") { return 6 }
    }
    Result<&[u8], MinisignError>.Failure {..} => { return 7 }
  }
  // Both key files read back to the same key.
  let plain = match run Minisign.secretKey(PLAIN, Option<&[u8]>.none()) {
    Result<MinisignSecretKey, MinisignError>.Success {value} => move value
    Result<MinisignSecretKey, MinisignError>.Failure {..} => { return 8 }
  }
  if !(run signed(&plain)) { return 9 }
  let password: &[u8] = b"hunter2"
  let decrypted = match run Minisign.secretKey(ENCRYPTED, Option<&[u8]>.some(password)) {
    Result<MinisignSecretKey, MinisignError>.Success {value} => move value
    Result<MinisignSecretKey, MinisignError>.Failure {..} => { return 10 }
  }
  if !(run signed(&decrypted)) { return 11 }
  if !(run refused(ENCRYPTED, Option<&[u8]>.none(), MinisignError.PasswordRequired)) { return 12 }
  let wrong: &[u8] = b"hunter3"
  if !(run refused(ENCRYPTED, Option<&[u8]>.some(wrong), MinisignError.WrongPassword)) { return 13 }
  if !(run refused(b"untrusted comment: x\nAAAA\n", Option<&[u8]>.none(), MinisignError.InvalidSecretKey)) { return 14 }
  match run Minisign.sign(&plain, b"x", b"two\nlines") {
    Result<Bytes, MinisignError>.Success {..} => { return 15 }
    Result<Bytes, MinisignError>.Failure {error} => {
      if error != MinisignError.InvalidComment { return 16 }
    }
  }
  return 42
}

pub effect fn main() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut random = Counting {next: 0}
  return run exercise()
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
}
