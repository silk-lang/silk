import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.concurrency.sync { Arc }
import silk.trace.record { Recorder, Config }
import silk.trace { Tracer, Trace }

import silk.core.option { Option }
import silk.trace.record { Span }
import silk.concurrency.execution { Execution }
fn ready(state: &()) -> () {}
effect fn child() -> i32 {
  let _local = Trace.span("child")
  return 42
}
effect fn fork() -> Intrinsic.Execution<i32> ! OutOfMemoryError ? &mut Allocator {
  let _parent = Trace.span("parent")
  return run Execution.make(child(), (), ready)
}
fn complete(result: &mut i32, value: i32) -> () { result.* = value }
fn parked(result: &mut i32, work: Intrinsic.Execution<i32>) -> () { drop work }
effect fn exercise() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let rec = run Arc<Recorder>.make(run Recorder.make(Config.make("fork")))
  let work = run fork() |> Effect.provideAmbient<Tracer>(&rec)
  // Closing and draining the parent can recycle its slot before the child starts.
  let parent = match rec.get().takeSpan() {
    Option<Span>.Some {value} => value
    Option<Span>.None => { return 1 }
  }
  let mut result: i32 = 0
  run Execution.drive(move work, &mut result, complete, parked)
  if result != 42 { return 2 }
  if let Option<Span>.Some {value} = rec.get().takeSpan() {
    if value.name == "child" && value.parent.span == parent.context.span && value.context.traceLow == parent.context.traceLow { return 0 }
  }
  return 3
}
effect fn failed(error: OutOfMemoryError) -> i32 { return 4 }
pub fn main() -> i32 {
  let mut alloc = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(exercise() |> Effect.provideMut<Allocator>(&mut alloc), failed)
}
