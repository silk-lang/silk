import silk.collections.bytes { Bytes }
import silk.core.bool
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u8
import silk.num.usize
import silk.text.glob {
  Dots,
  MatchResult,
  Pattern,
  Separators,
  matches,
  isGlob,
  detectGlobSyntax,
  hasExtglobPrefix,
  globParent,
  isGlobBytes
}
import silk.text.string { String }
import silk.io.writer_native { StderrWriter }

// A failed expectation, reported on standard error before the program exits with 1.
struct Failed {
  message: string<'static>,
}

effect fn expect(holds: bool, message: string<'static>) -> ()
  ! Failed {
  if !holds {
    fail Failed { message: message }
  }
}

// Expectations here follow matcher.rs (Dots/Sequence/UTF-8) and upstream match.test.ts:2093-2129.
effect fn check(pattern: string, path: string, expected: bool) -> ()
  ! OutOfMemoryError | Failed
  ? &mut Allocator {
  let result = run matches(pattern, path)
  run expect(result.matches == expected, "matcher contract")
}

effect fn ranges() -> ()
  ! OutOfMemoryError | Failed
  ? &mut Allocator {
  run check("{01..10}", "05", true)
  run check("{01..10}", "5", false)
  run check("{-02..2}", "-01", true)
  run check("{-02..2}", "001", true)
  run check("{-02..2}", "-00", false)
  run check("{9..1..-4}", "5", true)
  run check("{9..1..-4}", "7", false)
  run check("{1..3..0}", "2", true)
  run check("{a..g..3}", "d", true)
  run check("{a..g..3}", "e", false)
  run check("{A..z}", "", true)
  run check("{A..z}", "\\", false)
  run check("{A..z}", "[", true)
  run check("{-9223372036854775808..9223372036854775807..9223372036854775807}", "-1", true)
  run check(
    "{-9223372036854775808..9223372036854775807..9223372036854775807}",
    "9223372036854775806",
    true,
  )
  run check(
    "{-9223372036854775808..9223372036854775807..9223372036854775807}",
    "9223372036854775807",
    false,
  )
  run check("{1..9223372036854775808}", "1..9223372036854775808", true)
  run check("{1..3..-9223372036854775808}", "1..3..-9223372036854775808", true)
  run check("{{1..2},x}", "2", true)
  run check("{1..3,x}", "2", false)
}

// Compiles the byte pattern `pattern` and matches the bytes `path` with `Dots.Match`.
effect fn matchBytes(pattern: &[u8], path: &[u8]) -> MatchResult
  ! OutOfMemoryError
  ? &mut Allocator {
  let compiled = run Pattern.makeBytes(pattern)
  return run Pattern.matchesBytes(&compiled, path, Dots.Match)
}

effect fn modesAndReuse() -> ()
  ! OutOfMemoryError | Failed
  ? &mut Allocator {
  let compiled = run Pattern.make("**/*.ts")
  let first = run Pattern.matches(&compiled, "a/b.ts", Dots.Match)
  let hidden = run Pattern.matches(&compiled, ".cache/b.ts", Dots.Hide)
  let visible = run Pattern.matches(&compiled, ".cache/b.ts", Dots.SkipTraversal)
  let traversal = run Pattern.matches(&compiled, "a/../b.ts", Dots.SkipTraversal)
  let permissive = run Pattern.matches(&compiled, "a/../b.ts", Dots.Match)
  let last = run Pattern.matches(&compiled, "b.ts", Dots.Hide)
  run expect(
    first.matches && !hidden.matches && visible.matches && !traversal.matches && permissive.matches
      && last.matches,
    "compiled pattern reuses mode-independent program",
  )
  let source = Pattern.sourceBytes(&compiled)
  run expect(
    source.length == 7 && source[0] == 42 && source[6] == 115,
    "compiled pattern retains source",
  )
  let hiddenLiteral = run Pattern.make(".*/file")
  let literal = run Pattern.matches(&hiddenLiteral, ".git/file", Dots.Hide)
  run expect(literal.matches, "literal dot explicitly opens hidden segment")
  let windows = run Pattern.matchesWith(
    &compiled,
    "a\\b.ts",
    Dots.Match,
    Separators.SlashOrBackslash,
  )
  let plain = run Pattern.make("a/b")
  let posix = run Pattern.matchesWith(&plain, "a\\b", Dots.Match, Separators.Slash)
  let separators = run Pattern.matchesWith(&plain, "a\\b", Dots.Match, Separators.SlashOrBackslash)
  run expect(windows.matches && !posix.matches && separators.matches, "explicit separator platform")
  let odd = run matches("!*.ts", "x.js")
  let even = run matches("!!*.ts", "x.ts")
  let group = run matches("!(a)", "b")
  let both = run matches("!!(a)", "a")
  run expect(
    odd.matches && odd.negated && even.matches && !even.negated && group.matches && !group.negated
      && both.matches
      && both.negated,
    "leading negation bits remain independent from extglob",
  )
}

effect fn unicodeAndSuffixes() -> ()
  ! OutOfMemoryError | Failed
  ? &mut Allocator {
  run check("?", "😀", true)
  run check("??", "😀", false)
  run check("?", "é", false)
  run check("??", "é", true)
  run check("[α-ω]", "λ", true)
  run check("[α-ω]", "Ж", false)
  run check("[ω-α]", "λ", false)
  run check("[^α-ω]", "😀", true)
  run check("[😀-🙏]", "😁", true)
  run check("\\😀?", "😀λ", true)
  run check("!(a)b", "ab", false)
  run check("!(a)b", "aab", true)
  run check("!(!(a))", "a", true)
  run check("!(!(a))", "b", false)
  run check("*(?(a)|b)c", "ababc", true)
  run check("+(|a)b", "b", true)
  run check("@(a{b|c)", "a{b|c", true)
  run check("@(a{b|c)", "a{b", false)
  let malformed: [u8; 2] = [255, 254]
  let two = run matchBytes(b"??", &malformed)
  let one = run matchBytes(b"?", &malformed)
  run expect(two.matches && !one.matches, "invalid directory bytes each consume replacement scalar")
  let nul: [u8; 3] = [97, 0, 98]
  let binary = run matchBytes(b"a?b", &nul)
  run expect(binary.matches, "byte matcher does not truncate at NUL")
}

effect fn deepGroups() -> ()
  ! OutOfMemoryError | Failed
  ? &mut Allocator {
  let mut written = Bytes.make()
  let mut depth: usize = 0
  while depth < 200 {
    run Bytes.append(&mut written, b"+(")
    depth = depth + 1
  }
  run Bytes.append(&mut written, b"a|b")
  while depth > 0 {
    run Bytes.append(&mut written, b")")
    depth = depth - 1
  }
  let compiled = run Pattern.makeBytes(Bytes.asSlice(&written))
  let yes = run Pattern.matches(&compiled, "abab", Dots.Match)
  let no = run Pattern.matches(&compiled, "abc", Dots.Match)
  run expect(yes.matches && !no.matches, "200 nested repetition groups have no depth limit")
  let mut alternatives = Bytes.make()
  let mut path = Bytes.make()
  let mut count: usize = 0
  while count < 100 {
    run Bytes.append(&mut alternatives, b"{a,aa}")
    run Bytes.append(&mut path, b"aa")
    count = count + 1
  }
  run Bytes.append(&mut alternatives, b"b")
  let rejected = run matchBytes(Bytes.asSlice(&alternatives), Bytes.asSlice(&path))
  run expect(!rejected.matches, "alternatives are not expanded exponentially")
}

effect fn matcherRanges() -> ()
  ! OutOfMemoryError | Failed {
  let mut allocator = Allocator.systemAllocatorProvider()
  run ranges() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn matcherModesAndReuse() -> ()
  ! OutOfMemoryError | Failed {
  let mut allocator = Allocator.systemAllocatorProvider()
  run modesAndReuse() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn matcherUnicodeAndSuffixes() -> ()
  ! OutOfMemoryError | Failed {
  let mut allocator = Allocator.systemAllocatorProvider()
  run unicodeAndSuffixes() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn matcherDeepGroups() -> ()
  ! OutOfMemoryError | Failed {
  let mut allocator = Allocator.systemAllocatorProvider()
  run deepGroups() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn classification(text: string, strict: bool, broad: bool, prefix: bool) -> ()
  ! Failed {
  run expect(isGlob(text) == strict, "strict glob classification")
  run expect(detectGlobSyntax(text) == broad, "broad syntax classification")
  run expect(hasExtglobPrefix(text) == prefix, "extglob prefix classification")
}

effect fn strictAndBroadDetectionRemainDistinct() -> ()
  ! Failed {
  run classification("", false, false, false)
  run classification("dir/file.txt", false, false, false)
  run classification("*", true, true, false)
  run classification("?", false, true, false)
  run classification("file?.txt", false, true, false)
  run classification(".?", true, true, false)
  run classification("+?", true, true, false)
  run classification("]?", true, true, false)
  run classification(")?", true, true, false)
  run classification("!literal", true, true, false)
  run classification("dir/!literal", false, false, false)
  run classification("[abc]", true, true, false)
  run classification("[]", false, true, false)
  run classification("[", false, true, false)
  run classification("{abc}", true, true, false)
  run classification("{}", false, true, false)
  run classification("{", false, true, false)
  run classification("(a|b)", true, false, false)
  run classification("(|b)", false, false, false)
  run classification("(a|)", false, false, false)
  run classification("(a|b", false, false, false)
  run classification("(?:abc)", true, true, false)
  run classification("(?:)", false, true, false)
  run classification("(?=abc)", true, true, false)
  run classification("(?!abc)", true, true, false)
  run classification("(?<abc)", false, true, false)
  run classification("@(abc)", true, true, true)
  run classification("+(abc)", true, true, true)
  run classification("dir/!(abc)", true, true, true)
  run classification("@(abc", false, true, true)
  run classification("+(abc", false, true, true)
  run classification("dir/!(abc", false, true, true)
  run classification("?()", true, true, false)
  run classification("*()", true, true, false)
}

effect fn escapesPreserveParityAndEnclosureSkipping() -> ()
  ! Failed {
  run classification("\\*", false, false, false)
  run classification("\\\\*", true, true, false)
  run classification("\\\\\\*", false, false, false)
  run classification("\\\\\\\\*", true, true, false)
  run classification("\\@(x)", false, false, false)
  run classification("\\\\@(x)", true, true, true)
  run classification("\\\\\\@(x)", false, false, false)
  run classification("\\+(x)", false, false, false)
  run classification("\\!(x)", false, false, false)
  run classification("\\!literal", false, false, false)
  run classification("\\x!literal", true, false, false)
  run classification("\\[a*]", false, true, false)
  run classification("\\{a*}", false, true, false)
  run classification("\\(a*|b)", false, true, false)
  run classification("\\[a*", true, true, false)
  run classification("[a\\b]", false, true, false)
  run classification("{a\\b}", false, true, false)
  run classification("(a|b\\c)", false, false, false)
  run classification("[a\\b][c]", true, true, false)
  run classification("\\[a]!*", true, true, false)
}

effect fn extglobLineTerminatorsAndUnicodeEscapes() -> ()
  ! Failed {
  run classification("@(a\nb)", false, true, true)
  run classification("@(a\rb)", false, true, true)
  run classification("@(a\u{2028}b)", false, true, true)
  run classification("@(a\u{2029}b)", false, true, true)
  run classification("@(a\u{85}b)", true, true, true)
  run classification("@(a\nb)@(c)", true, true, true)
  run classification("\\\n@(a)", true, true, true)
  run classification("\\é!", true, false, false)
  run classification("\\界!", true, false, false)

  // The pinned strict scanner skips one UTF-16 unit, not a Unicode scalar.
  run classification("\\😀!", false, false, false)
  run classification("日本語/é.txt", false, false, false)
  run classification("界/*", true, true, false)
  let malformed: [u8; 4] = [92, 255, 33, 42]
  run expect(isGlobBytes(&malformed), "invalid UTF-8 remains byte-oriented")
}

effect fn parent(pattern: string, expected: string) -> ()
  ! OutOfMemoryError | Failed {
  let mut allocator = Allocator.systemAllocatorProvider()
  let result = run globParent(pattern) |> Effect.provideMut<Allocator>(&mut allocator)
  run expect(String.view(&result) == expected, "POSIX glob parent bytes")
}

effect fn globParentsPreservePosixDirnameAndEscapes() -> ()
  ! OutOfMemoryError | Failed {
  run parent("", ".")
  run parent("file", ".")
  run parent("file.txt", ".")
  run parent("/", "/")
  run parent("//", "//")
  run parent("///", "//")
  run parent("////", "///")
  run parent("//file", "//")
  run parent("/file", "/")
  run parent("dir/file", "dir")
  run parent("dir/", "dir")
  run parent("dir///", "dir//")
  run parent("a/../b/*.txt", "a/../b")
  run parent("a/**/*.txt", "a")
  run parent("/a/*/b", "/a")
  run parent("a/file?.txt", "a")
  run parent("a?/file", "a?")
  run parent("a/[broken/file", "a")
  run parent("a/{broken/file", "a")
  run parent("a/(broken/file", "a")
  run parent("a/(/file", "a/(")
  run parent("a/{b/c,d}", "a")
  run parent("a/[b/c]", "a")
  run parent("a/\\[b/c]", "a/[b/c]")
  run parent("a/\\*/file", "a/*")
  run parent("a/\\?/file", "a/?")
  run parent("a/\\!/file", "a/!")
  run parent("a/\\|/file", "a/|")
  run parent("a/\\[x\\]/file", "a/[x]")
  run parent("a/\\{x\\}/file", "a/{x}")
  run parent("a/\\(x\\)/file", "a/(x)")
  run parent("a/\\z/file", "a/\\z")
  run parent("a/\\\\/file", "a/\\\\")
  run parent("日本語/é/*.txt", "日本語/é")
  run parent("a\u{0}/b", "a\u{0}")
  run parent("C:\\dir\\file", ".")
}

effect fn cases() -> i32
  ! Failed | OutOfMemoryError {
  run matcherRanges()
  run matcherModesAndReuse()
  run matcherUnicodeAndSuffixes()
  run matcherDeepGroups()
  run strictAndBroadDetectionRemainDistinct()
  run escapesPreserveParityAndEnclosureSkipping()
  run extglobLineTerminatorsAndUnicodeEscapes()
  run globParentsPreservePosixDirnameAndEscapes()
  return 0
}

effect fn failed(error: Failed | OutOfMemoryError) -> i32 {
  return match move error {
    Failed failure => {
      StderrWriter.print("failed: {}\n", &(failure.message,))
      return 1
    }
    OutOfMemoryError exhausted => {
      drop exhausted
      return 2
    }
  }
}

pub fn main() -> i32 {
  return run Effect.catchAll(cases(), failed)
}
