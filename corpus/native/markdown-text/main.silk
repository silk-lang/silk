// Visible text, Unicode lowercase, unique slugs, heading outlines, and matching HTML ids.
import silk.markdown.document {
  MarkdownDocument,
  MarkdownNodeId,
  MarkdownOptions,
  MarkdownNodeKind
}
import silk.markdown.text { MarkdownText, MarkdownSlugger, MarkdownHeading }
import silk.markdown.html { MarkdownHtml, HtmlOptions }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }
import silk.num.usize

struct CheckFailed {
  code: i32
}

effect fn expect(ok: bool, code: i32) -> ()
  ! CheckFailed {
  if !ok {
    fail CheckFailed { code: code }
  }
}

effect fn slug(value: string, expected: string, code: i32) -> ()
  ! CheckFailed | OutOfMemoryError
  ? &mut Allocator {
  let result = run MarkdownText.slugOwned(value)
  run expect(String.view(&result) == expected, code)
}

effect fn checks() -> ()
  ! CheckFailed | OutOfMemoryError
  ? &mut Allocator {
  let source = "# *Hello* `Code` ![Alt](img) <i>Text</i>\n\n# Hello Code Alt Text\n\n## Hello Code Alt Text-1\n\n# Hello Code Alt Text\n\n- first\n- second\n\nsoft\nbreak  \nhard\n"
  let doc = run MarkdownDocument.parse(source)
  let headings = run MarkdownText.outline(&doc)
  let rows = List<MarkdownHeading>.asSlice(&headings)
  run expect(rows.length == 4, 1)
  run expect(
    rows[0].node.index == 1 && rows[0].level == 1
      && String.view(&rows[0].text) == "Hello Code Alt Text"
      && String.view(&rows[0].slug) == "hello-code-alt-text",
    2,
  )
  run expect(
    String.view(&rows[1].slug) == "hello-code-alt-text-1"
      && String.view(&rows[2].slug) == "hello-code-alt-text-1-1"
      && String.view(&rows[3].slug) == "hello-code-alt-text-2",
    3,
  )
  let text = run MarkdownText.plainTextOwned(&doc, MarkdownDocument.root(&doc))
  run expect(
    String.view(&text)
      == "Hello Code Alt Text\nHello Code Alt Text\nHello Code Alt Text-1\nHello Code Alt Text\nfirst\nsecond\nsoft\nbreak\nhard",
    4,
  )
  let mut output = run Bytes.copy(b"prefix:")
  run MarkdownText.plainTextInto(&doc, MarkdownNodeId { index: 1 }, &mut output)
  run expect(
    unsafe String.fromUtf8Unchecked(Bytes.asSlice(&output)) == "prefix:Hello Code Alt Text",
    5,
  )
  run MarkdownText.plainTextInto(&doc, MarkdownNodeId { index: usize.MAX }, &mut output)
  let invalid = run MarkdownText.plainTextOwned(&doc, MarkdownNodeId { index: usize.MAX })
  run expect(
    String.view(&invalid) == ""
      && unsafe String.fromUtf8Unchecked(Bytes.asSlice(&output)) == "prefix:Hello Code Alt Text",
    6,
  )
  run slug("Hello, WORLD! foo_bar a-b", "hello-world-foo_bar-a-b", 7)
  run slug("ÉCOLE Straße ẞ İ ΟΣ ΟΣΑ", "école-straße-ß-i̇-ος-οσα", 8)
  run slug("  A  B \tC\nD ", "--a--b-cd-", 9)
  run slug("東京 / Test 😀", "東京--test-", 10)
  run slug("Ꭰ ꭰ ﬀ", "ꭰ-ꭰ-ﬀ", 11)
  let mut state = MarkdownSlugger.make()
  let first = run MarkdownSlugger.slug(&mut state, "Name-1")
  let second = run MarkdownSlugger.slug(&mut state, "Name")
  let third = run MarkdownSlugger.slug(&mut state, "Name")
  let fourth = run MarkdownSlugger.slug(&mut state, "Name-2")
  run expect(
    String.view(&first) == "name-1" && String.view(&second) == "name"
      && String.view(&third) == "name-2"
      && String.view(&fourth) == "name-2-1",
    12,
  )
  MarkdownSlugger.clear(&mut state)
  let reset = run MarkdownSlugger.slug(&mut state, "Name")
  run expect(String.view(&reset) == "name", 13)
  let blank = run MarkdownSlugger.slug(&mut state, "?!")
  let blankAgain = run MarkdownSlugger.slug(&mut state, "!")
  run expect(String.view(&blank) == "" && String.view(&blankAgain) == "-1", 14)

  let mut options = HtmlOptions.make()
  options.headingIds = true
  let html = run MarkdownHtml.renderOwnedWithOptions(&doc, &options)
  run expect(
    String.contains(String.view(&html), "<h1 id=\"hello-code-alt-text\">")
      && String.contains(String.view(&html), "<h1 id=\"hello-code-alt-text-1\">")
      && String.contains(String.view(&html), "<h2 id=\"hello-code-alt-text-1-1\">")
      && String.contains(String.view(&html), "<h1 id=\"hello-code-alt-text-2\">"),
    15,
  )
  let plainHtml = run MarkdownHtml.renderOwned(&doc)
  run expect(!String.contains(String.view(&plainHtml), " id="), 16)
  let mut syntax = MarkdownOptions.gfm()
  syntax.footnotes = true
  syntax.frontmatter = true
  let extended = run MarkdownDocument.parseWithOptions(
    "---\nsecret: hidden\n---\n# ~~Visible~~\n\nA|B\n-|-\nx|y\n\nref[^a]\n\n[^a]: # Hidden\n",
    &syntax,
  )
  let outline = run MarkdownText.outline(&extended)
  run expect(List<MarkdownHeading>.length(&outline) == 1, 17)
  let plain = run MarkdownText.plainTextOwned(&extended, MarkdownDocument.root(&extended))
  run expect(String.view(&plain) == "Visible\nA\tB\nx\ty\nref1\n", 18)
  let nodes = MarkdownDocument.nodes(&extended)
  let mut i: usize = 0
  while i < nodes.length {
    if nodes[i].kind == MarkdownNodeKind.FootnoteDefinition {
      let note = run MarkdownText.plainTextOwned(&extended, MarkdownNodeId { index: i })
      run expect(String.view(&note) == "Hidden", 19)
    }
    i = i + 1
  }
}

effect fn failure(error: CheckFailed | OutOfMemoryError) -> i32 {
  return match move error {
    CheckFailed { code } => code
    OutOfMemoryError _ => 255
  }
}

pub effect fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(
    effect {
      run checks()
      return 0
    },
    failure,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
}
