import silk.text.format { Debug, Format, Formatter }
import silk.io.writer { Writer, WriterError }

pub struct NotFoundError {}

effect fn load() -> i32 ! NotFoundError {
  fail NotFoundError {}
}

effect fn middle() -> i32 ! NotFoundError {
  let v = run load()
  return v + 1
}

pub effect fn main() ! NotFoundError {
  let v = run middle()
  return ()
}

impl Debug for NotFoundError {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return run Format.debugFields(self, "NotFoundError", &mut formatter)
  }
}
