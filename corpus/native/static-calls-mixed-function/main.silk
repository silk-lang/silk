//! Static code calls ordinary functions whose bodies hold static work: a `static for` over enum
//! members, a `let static` and a `static if`. The same functions also run at runtime, and both
//! phases agree.
import silk.core.reflect { Reflect, enumKind }

enum Tab { Home, Search, Settings }

fn position(value: Tab) -> u32 {
  let mut at: u32 = 0
  static for member in Reflect.enumMembers<Tab>() {
    if member == value { return at }
    at = at + 1
  }
  return 99
}

fn count<E>() -> u32 {
  let static members = Reflect.enumMembers<E>()
  let mut total: u32 = 0
  static for _member in members { total = total + 1 }
  static if Reflect.typeKind(Reflect.typeOf<E>()) == enumKind {
    return total
  } else {
    return 0
  }
}

static fn labels() -> u32 {
  let mut total: u32 = 0
  static for member in Reflect.enumMembers<Tab>() {
    if Reflect.enumLabelOf(member) == "Search" { total = total + position(member) }
  }
  return total
}

const settings: u32 = position(Tab.Settings)

pub fn main() -> i32 {
  let static staticCount = count<Tab>()
  static if staticCount != 3 || settings != 2 || labels() != 1 { compileError("static calls disagree") }
  static if Reflect.enumLabelOf(Tab.Home) != "Home" { compileError("static label") }
  if position(Tab.Settings) != settings || count<Tab>() != staticCount { return 1 }
  if Reflect.enumLabelOf(Tab.Search) != "Search" { return 2 }
  return 42
}
