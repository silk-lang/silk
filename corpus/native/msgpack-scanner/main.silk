import silk.core.result { Result }
import silk.num.usize
import silk.msgpack.scanner {
  MsgpackError,
  MsgpackReason,
  MsgpackScanner,
  MsgpackSpan,
  MsgpackToken
}

fn sameBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at: usize = 0
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + 1
  }
  return true
}

// The one integer `input` holds, or `fallback` for anything else.
fn integer(input: &[u8], fallback: i64) -> i64 {
  let mut scanner = MsgpackScanner.make(input)
  let value = match move MsgpackScanner.next(&mut scanner) {
    Result<MsgpackToken, MsgpackError>.Success { value: MsgpackToken.Integer { value } } => value
    _ => {
      return fallback
    }
  }
  if MsgpackScanner.offset(&scanner) != 0 || MsgpackScanner.end(&scanner) != input.length {
    return fallback
  }
  return match move MsgpackScanner.next(&mut scanner) {
    Result<MsgpackToken, MsgpackError>.Success { value: MsgpackToken.EndOfInput } => value
    _ => fallback
  }
}

fn unsigned(input: &[u8]) -> u64 {
  let mut scanner = MsgpackScanner.make(input)
  return match move MsgpackScanner.next(&mut scanner) {
    Result<MsgpackToken, MsgpackError>.Success { value: MsgpackToken.Unsigned { value } } => value
    _ => 0
  }
}

fn float(input: &[u8]) -> f64 {
  let mut scanner = MsgpackScanner.make(input)
  return match move MsgpackScanner.next(&mut scanner) {
    Result<MsgpackToken, MsgpackError>.Success { value: MsgpackToken.Float { value } } => value
    _ => -1.0
  }
}

// Whether `input` is one string token whose text is `text`.
fn isText(input: &[u8], text: &[u8]) -> bool {
  let mut scanner = MsgpackScanner.make(input)
  return match move MsgpackScanner.next(&mut scanner) {
    Result<MsgpackToken, MsgpackError>.Success { value: MsgpackToken.String { span } } => sameBytes(
      MsgpackScanner.slice(&scanner, span),
      text,
    )
      && MsgpackScanner.end(&scanner) == input.length
    _ => false
  }
}

fn isBinary(input: &[u8], data: &[u8]) -> bool {
  let mut scanner = MsgpackScanner.make(input)
  return match move MsgpackScanner.next(&mut scanner) {
    Result<MsgpackToken, MsgpackError>.Success { value: MsgpackToken.Binary { span } } => sameBytes(
      MsgpackScanner.slice(&scanner, span),
      data,
    )
      && MsgpackScanner.end(&scanner) == input.length
    _ => false
  }
}

fn isExtension(input: &[u8], kind: i8, data: &[u8]) -> bool {
  let mut scanner = MsgpackScanner.make(input)
  return match move MsgpackScanner.next(&mut scanner) {
    Result<MsgpackToken, MsgpackError>.Success {
      value: MsgpackToken.Extension { kind: found, span }
    } => found == kind && sameBytes(MsgpackScanner.slice(&scanner, span), data)
      && MsgpackScanner.end(&scanner) == input.length
    _ => false
  }
}

// The element count of the array header `input` starts with, or -1; -2 for a map of that count.
fn container(input: &[u8], map: bool) -> i64 {
  let mut scanner = MsgpackScanner.make(input)
  return match move MsgpackScanner.next(&mut scanner) {
    Result<MsgpackToken, MsgpackError>.Success { value: MsgpackToken.Array { count } } => if map {
      -1
    } else {
      usize.toI64(count)
    }
    Result<MsgpackToken, MsgpackError>.Success { value: MsgpackToken.Map { count } } => if map {
      usize.toI64(count)
    } else {
      -1
    }
    _ => -1
  }
}

// Whether reading the first token of `input` fails with `reason` at `offset`.
fn fails(input: &[u8], reason: MsgpackReason, offset: usize) -> bool {
  let mut scanner = MsgpackScanner.make(input)
  return match move MsgpackScanner.next(&mut scanner) {
    Result<MsgpackToken, MsgpackError>.Failure { error } => error.reason == reason
      && error.offset == offset
    _ => false
  }
}

fn integers() -> i32 {
  if integer(b"\x00", -1) != 0 || integer(b"\x7f", -1) != 127 {
    return 1
  }
  if integer(b"\xff", 0) != -1 || integer(b"\xe0", 0) != -32 {
    return 2
  }
  if integer(b"\xcc\xff", -1) != 255 || integer(b"\xcd\x01\x00", -1) != 256 {
    return 3
  }
  if integer(b"\xce\xff\xff\xff\xff", -1) != 4294967295 {
    return 4
  }
  if integer(b"\xcf\x7f\xff\xff\xff\xff\xff\xff\xff", -1) != 9223372036854775807 {
    return 5
  }
  if unsigned(b"\xcf\x80\x00\x00\x00\x00\x00\x00\x00") != 9223372036854775808
    || unsigned(b"\xcf\xff\xff\xff\xff\xff\xff\xff\xff") != 18446744073709551615 {
    return 6
  }
  if integer(b"\xd0\x80", 0) != -128 || integer(b"\xd0\x7f", 0) != 127 {
    return 7
  }
  if integer(b"\xd1\x80\x00", 0) != -32768 || integer(b"\xd2\x80\x00\x00\x00", 0) != -2147483648 {
    return 8
  }
  if integer(b"\xd3\x80\x00\x00\x00\x00\x00\x00\x00", 0) != -9223372036854775807 - 1 {
    return 9
  }
  if integer(b"\xd3\xff\xff\xff\xff\xff\xff\xff\xfe", 0) != -2 {
    return 10
  }
  return 0
}

fn scalars() -> i32 {
  let mut scanner = MsgpackScanner.make(b"\xc0\xc2\xc3")
  match move MsgpackScanner.next(&mut scanner) {
    Result<MsgpackToken, MsgpackError>.Success { value: MsgpackToken.Nil } => {}
    _ => {
      return 20
    }
  }
  match move MsgpackScanner.next(&mut scanner) {
    Result<MsgpackToken, MsgpackError>.Success { value: MsgpackToken.Boolean { value } } => {
      if value {
        return 21
      }
    }
    _ => {
      return 22
    }
  }

  // `peek` does not consume: `next` returns the same token, at the same offset.
  match move MsgpackScanner.peek(&mut scanner) {
    Result<MsgpackToken, MsgpackError>.Success { value: MsgpackToken.Boolean { value } } => {
      if !value {
        return 23
      }
    }
    _ => {
      return 24
    }
  }
  let mut ahead = MsgpackScanner.fork(&scanner)
  match move MsgpackScanner.next(&mut scanner) {
    Result<MsgpackToken, MsgpackError>.Success { value: MsgpackToken.Boolean { value } } => {
      if !value || MsgpackScanner.offset(&scanner) != 2 {
        return 25
      }
    }
    _ => {
      return 26
    }
  }
  match move MsgpackScanner.next(&mut ahead) {
    Result<MsgpackToken, MsgpackError>.Success { value: MsgpackToken.Boolean { .. } } => {}
    _ => {
      return 27
    }
  }
  match move MsgpackScanner.next(&mut scanner) {
    Result<MsgpackToken, MsgpackError>.Success { value: MsgpackToken.EndOfInput } => {}
    _ => {
      return 28
    }
  }
  if float(b"\xca\x3f\xc0\x00\x00") != 1.5
    || float(b"\xcb\xc0\x09\x21\xfb\x54\x44\x2d\x18") != -3.141592653589793 {
    return 29
  }
  return 0
}

fn payloads() -> i32 {
  if !isText(b"\xa0", b"") || !isText(b"\xa2hi", b"hi") {
    return 40
  }
  if !isText(b"\xd9\x03abc", b"abc") || !isText(b"\xda\x00\x02\xc3\xa9", b"\xc3\xa9")
    || !isText(b"\xdb\x00\x00\x00\x01x", b"x") {
    return 41
  }
  if !isBinary(b"\xc4\x02\xff\x00", b"\xff\x00") || !isBinary(b"\xc5\x00\x01\x80", b"\x80")
    || !isBinary(b"\xc6\x00\x00\x00\x00", b"") {
    return 42
  }
  if !isExtension(b"\xd4\x05\xaa", 5, b"\xaa")
    || !isExtension(b"\xd5\xff\x01\x02", -1, b"\x01\x02") {
    return 43
  }
  if !isExtension(b"\xd6\x01\x01\x02\x03\x04", 1, b"\x01\x02\x03\x04")
    || !isExtension(
      b"\xd7\x02\x01\x02\x03\x04\x05\x06\x07\x08",
      2,
      b"\x01\x02\x03\x04\x05\x06\x07\x08",
    ) {
    return 44
  }
  if !isExtension(b"\xd8\x03abcdefghijklmnop", 3, b"abcdefghijklmnop") {
    return 45
  }
  if !isExtension(b"\xc7\x03\x80abc", -128, b"abc") || !isExtension(b"\xc8\x00\x01\x07z", 7, b"z")
    || !isExtension(b"\xc9\x00\x00\x00\x00\x09", 9, b"") {
    return 46
  }
  if container(b"\x90", false) != 0 || container(b"\x92\x01\x02", false) != 2 {
    return 47
  }
  if container(b"\xdc\x00\x01\xc0", false) != 1
    || container(b"\xdd\x00\x00\x00\x01\xc0", false) != 1 {
    return 48
  }
  if container(b"\x80", true) != 0 || container(b"\x81\x01\x02", true) != 1 {
    return 49
  }
  if container(b"\xde\x00\x01\x01\x02", true) != 1
    || container(b"\xdf\x00\x00\x00\x01\x01\x02", true) != 1 {
    return 50
  }
  return 0
}

fn failures() -> i32 {
  if !fails(b"\xc1", MsgpackReason.ReservedByte, 0) {
    return 60
  }
  if !fails(b"\xcd\x01", MsgpackReason.UnexpectedEnd, 2)
    || !fails(b"\xcb\x00", MsgpackReason.UnexpectedEnd, 2)
    || !fails(b"\xca", MsgpackReason.UnexpectedEnd, 1) {
    return 61
  }
  if !fails(b"\xa3hi", MsgpackReason.UnexpectedEnd, 3)
    || !fails(b"\xc4\x02\x00", MsgpackReason.UnexpectedEnd, 3)
    || !fails(b"\xd9", MsgpackReason.UnexpectedEnd, 1) {
    return 62
  }
  if !fails(b"\xd4", MsgpackReason.UnexpectedEnd, 1)
    || !fails(b"\xd5\x01\x00", MsgpackReason.UnexpectedEnd, 3)
    || !fails(b"\xc7\x01", MsgpackReason.UnexpectedEnd, 2) {
    return 63
  }
  if !fails(b"\xa2\xc3\x28", MsgpackReason.InvalidUtf8, 1) {
    return 64
  }

  // A count the input cannot hold is refused before anything is read for it: each element takes
  // at least one byte, and each map entry two.
  if !fails(b"\x92\x01", MsgpackReason.UnexpectedEnd, 2)
    || !fails(b"\x81\x01", MsgpackReason.UnexpectedEnd, 2) {
    return 65
  }
  if !fails(b"\xdd\xff\xff\xff\xff", MsgpackReason.UnexpectedEnd, 5)
    || !fails(b"\xdf\x80\x00\x00\x00\x00", MsgpackReason.UnexpectedEnd, 6)
    || !fails(b"\xc6\xff\xff\xff\xff", MsgpackReason.UnexpectedEnd, 5) {
    return 66
  }
  return 0
}

pub fn main() -> i32 {
  let first = integers()
  if first != 0 {
    return first
  }
  let second = scalars()
  if second != 0 {
    return second
  }
  let third = payloads()
  if third != 0 {
    return third
  }
  return failures()
}
