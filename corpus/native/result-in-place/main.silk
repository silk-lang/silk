// A struct, union or repeat literal is built in its destination, and an indirect result is
// built in the caller's slot (#2438). Each call below reads its argument while the result is
// being written, so a result that aliased an argument would read its own partial writes.
import silk.core.effect { Effect }
import silk.num.i64
import silk.num.usize

struct Big {
  values: [i64; 64],
  top: i64,
}

struct Holder {
  big: Big,
  count: i64,
}

union Shape {
  Dot,
  Line {length: i64, big: Big},
}

struct TooLarge {}

fn grow(from: &Big) -> Big {
  // Reads `from` after every write a result in place would have made.
  let mut next = Big { values: [0; 64], top: from.top + 1 }
  let mut at = usize.ZERO
  while at < 64 {
    next.values[at] = from.values[63 - at] + 1
    at = at + usize.ONE
  }
  return move next
}

fn swapped(from: &Big) -> Big {
  return Big { values: [from.top; 64], top: from.values[0] }
}

fn shape(length: i64) -> Shape {
  if length == 0 { return Shape.Dot }
  return Shape.Line { length: length, big: Big { values: [length; 64], top: length } }
}

effect fn checked(from: &Big) -> Big ! TooLarge {
  if from.top > 9 { fail TooLarge {} }
  return grow(from)
}

effect fn twice(from: &Big) -> Big ! TooLarge {
  let mut x = run checked(from)
  x = run checked(&x)
  return move x
}

effect fn succeeds() -> i64 ! TooLarge {
  let start = Big { values: [5; 64], top: 2 }
  let ok = run twice(&start)
  return ok.top * 10 + ok.values[1]
}

effect fn fails() -> i64 ! TooLarge {
  let high = Big { values: [5; 64], top: 9 }
  let never = run twice(&high)
  return never.top
}

effect fn recover(error: TooLarge) -> i64 { return -1 }

fn length(value: &Shape) -> i64 {
  return match &value.* {
    Shape.Dot => 0
    Shape.Line {length, ..} => length
  }
}

pub fn main() -> i32 {
  let mut x = Big { values: [1; 64], top: 0 }
  x.values[0] = 7
  x = grow(&x)
  // values[63] came from values[0] + 1.
  if x.values[63] != 8 || x.values[0] != 2 || x.top != 1 { return 1 }
  x = swapped(&x)
  if x.top != 2 || x.values[5] != 1 { return 2 }
  let mut h = Holder { big: Big { values: [3; 64], top: 4 }, count: 1 }
  h.big = grow(&h.big)
  if h.big.top != 5 || h.big.values[10] != 4 || h.count != 1 { return 3 }
  let s = shape(6)
  if length(&s) != 6 || length(&shape(0)) != 0 { return 4 }
  let succeeded = run Effect.catchAll(succeeds(), recover)
  if succeeded != 47 { return 5 }
  let failed = run Effect.catchAll(fails(), recover)
  if failed != -1 { return 6 }
  return 42
}
