struct Capture {
  bytes: [u8; 160],
  length: usize,
}

impl Writer for Capture {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> ()
    ! WriterError
    ? &mut Writer {
    let mut index: usize = 0
    while index < value.length {
      self.bytes[self.length] = value[index]
      self.length = self.length + 1
      index = index + 1
    }
    return ()
  }

  effect fn flush(self: &mut Self) -> ()
    ! WriterError
    ? &mut Writer {
    return ()
  }
}

fn holds(capture: &Capture, expected: string) -> bool {
  let bytes = String.utf8Bytes(expected)
  if capture.length != bytes.length {
    return false
  }
  let mut index: usize = 0
  while index < bytes.length {
    if capture.bytes[index] != bytes[index] {
      return false
    }
    index = index + 1
  }
  return true
}

fn fieldAt(line: string, wanted: usize) -> string {
  let bytes = String.utf8Bytes(line)
  let mut start: usize = 0
  let mut index: usize = 0
  let mut at: usize = 0
  while at <= bytes.length {
    if at == bytes.length || bytes[at] == 9 {
      if index == wanted {
        return String.slice(line, start, at - start)
      }
      index = index + 1
      start = at + 1
    }
    at = at + 1
  }
  return ""
}

fn number(text: string) -> i64 {
  let bytes = String.utf8Bytes(text)
  let mut value: i64 = 0
  let mut at: usize = 0
  let negative = bytes.length > 0 && bytes[0] == 45
  if negative {
    at = 1
  }
  while at < bytes.length {
    value = value * 10 + u8.toI64(bytes[at] - 48)
    at = at + 1
  }
  if negative {
    return -value
  }
  return value
}

fn unit(text: string) -> DateUnit {
  if text == "y" {
    return DateUnit.Year
  }
  if text == "m" {
    return DateUnit.Month
  }
  if text == "w" {
    return DateUnit.Week
  }
  return DateUnit.Day
}

fn overflow(text: string) -> Overflow {
  if text == "r" {
    return Overflow.Reject
  }
  return Overflow.Constrain
}

fn date(text: string) -> PlainDate {
  return match PlainDate.parse(text) {
    Result<PlainDate, TimeParseError>.Success { value } => value
    Result<PlainDate, TimeParseError>.Failure { error: _ } => Intrinsic.trap("a row has a bad date")
  }
}

// The first and the last date of the range have times that are outside it.
fn dateTime(text: string) -> Option<PlainDateTime> {
  return match PlainDateTime.parse(text) {
    Result<PlainDateTime, TimeParseError>.Success { value } => Option<PlainDateTime>.some(value)
    Result<PlainDateTime, TimeParseError>.Failure { error: _ } => Option<PlainDateTime>.none()
  }
}

fn period(text: string) -> Period {
  return match Period.parse(text) {
    Result<Period, TimeParseError>.Success { value } => value
    Result<Period, TimeParseError>.Failure { error: _ } => Intrinsic.trap("a row has a bad period")
  }
}

fn yearMonth(text: string) -> PlainYearMonth {
  return match PlainYearMonth.parse(text) {
    Result<PlainYearMonth, TimeParseError>.Success { value } => value
    Result<PlainYearMonth, TimeParseError>.Failure { error: _ } => Intrinsic.trap("a row has a bad month")
  }
}

fn same<T: Equal>(left: T, right: T) -> bool {
  return &left == &right
}

effect fn none() -> () ! WriterError ? &mut Writer {
  return run Writer.writeAll(b"!")
}

// Writes the answer of the row `line` of kind `kind`, with its input fields from `first`.
effect fn answer(kind: string, line: string, first: usize) -> () ! WriterError ? &mut Writer {
  let one = fieldAt(line, first)
  let two = fieldAt(line, first + 1)
  let three = fieldAt(line, first + 2)
  if kind == "p" {
    match Period.parse(one) {
      Result<Period, TimeParseError>.Success { value } => {
        // The text of a period reads back as the same period.
        if !same<Period>(period(one), value) {
          return run none()
        }
        run Format.format("{}", &.(value))
      }
      Result<Period, TimeParseError>.Failure { error: _ } => {
        run none()
      }
    }
  } else if kind == "a" {
    match date(one).checkedAddPeriod(period(two), overflow(three)) {
      Option<PlainDate>.Some { value } => {
        run Format.format("{}", &.(value))
      }
      Option<PlainDate>.None => {
        run none()
      }
    }
  } else if kind == "u" {
    let from = date(one)
    let to = date(two)
    let span = from.periodUntil(to, unit(three))
    // Adding the span to the first date gives the second.
    if !same(from.addPeriod(span), to) {
      return run none()
    }
    run Format.format("{}", &.(span))
  } else if kind == "A" {
    let mut reached = Option<PlainDateTime>.none()
    if let Option<PlainDateTime>.Some { value: from } = dateTime(one) {
      reached = from.checkedAddPeriod(period(two), overflow(three))
    }
    match reached {
      Option<PlainDateTime>.Some { value } => {
        run Format.format("{}", &.(value))
      }
      Option<PlainDateTime>.None => {
        run none()
      }
    }
  } else if kind == "U" {
    if let Option<PlainDateTime>.Some { value: from } = dateTime(one) {
      if let Option<PlainDateTime>.Some { value: to } = dateTime(two) {
        let span = from.periodUntil(to, unit(three))
        if !same(from.addPeriod(span), to) {
          return run none()
        }
        return run Format.format("{}", &.(span))
      }
    }
    run none()
  } else if kind == "y" {
    match PlainYearMonth.parse(one) {
      Result<PlainYearMonth, TimeParseError>.Success { value } => {
        run Format.format("{}", &.(value))
      }
      Result<PlainYearMonth, TimeParseError>.Failure { error: _ } => {
        run none()
      }
    }
  } else if kind == "Y" {
    match yearMonth(one).checkedAddMonths(number(two)) {
      Option<PlainYearMonth>.Some { value } => {
        run Format.format("{}", &.(value))
      }
      Option<PlainYearMonth>.None => {
        run none()
      }
    }
  } else if kind == "n" {
    run Format.format("{}", &.(yearMonth(one).monthsUntil(yearMonth(two))))
  } else if kind == "d" {
    match PlainMonthDay.parse(one) {
      Result<PlainMonthDay, TimeParseError>.Success { value } => {
        run Format.format("{}", &.(value))
      }
      Result<PlainMonthDay, TimeParseError>.Failure { error: _ } => {
        run none()
      }
    }
  } else if kind == "D" {
    match PlainMonthDay.parse(one) {
      Result<PlainMonthDay, TimeParseError>.Success { value } => {
        match value.atYear(i64.toI32(number(two)), Overflow.Constrain) {
          Option<PlainDate>.Some { value: found } => {
            run Format.format("{}", &.(found))
          }
          Option<PlainDate>.None => {
            run none()
          }
        }
      }
      Result<PlainMonthDay, TimeParseError>.Failure { error: _ } => {
        run none()
      }
    }
  }
  return ()
}

// Writes the `Debug` text of the answer of a hand-written row.
effect fn handAnswer(kind: string, line: string) -> () ! WriterError ? &mut Writer {
  let one = fieldAt(line, 2)
  if kind == "p" {
    run Format.format("{:?}", &.(Period.parse(one)))
  } else if kind == "y" {
    run Format.format("{:?}", &.(PlainYearMonth.parse(one)))
  } else if kind == "d" {
    run Format.format("{:?}", &.(PlainMonthDay.parse(one)))
  } else if kind == "D" {
    match PlainMonthDay.parse(one) {
      Result<PlainMonthDay, TimeParseError>.Success { value } => {
        run Format.format("{:?}", &.(value.atYear(i64.toI32(number(fieldAt(line, 3))), Overflow.Reject)))
      }
      Result<PlainMonthDay, TimeParseError>.Failure { error: _ } => {
        run none()
      }
    }
  }
  return ()
}

effect fn checkRows() -> usize ! WriterError ? &mut Writer {
  let table = rows()
  let mut failures: usize = 0
  let mut index: usize = 0
  while index < table.length {
    let line = table[index]
    let kind = fieldAt(line, 0)
    let mut capture = Capture { bytes: [0; 160], length: 0 }
    let mut expected = ""
    if kind == "h" {
      let inner = fieldAt(line, 1)
      run handAnswer(inner, line) |> Effect.provideMut<Writer>(&mut capture)
      expected = fieldAt(line, if inner == "D" { 4 } else { 3 })
    } else {
      run answer(kind, line, 1) |> Effect.provideMut<Writer>(&mut capture)
      let mut last: usize = 2
      if kind == "a" || kind == "u" || kind == "A" || kind == "U" {
        last = 4
      } else if kind == "Y" || kind == "n" || kind == "D" {
        last = 3
      }
      expected = fieldAt(line, last)
    }
    if !holds(&capture, expected) {
      failures = failures + 1
      run Format.format("FAIL {}\n", &.(line))
    }
    index = index + 1
  }
  run Format.format("{} rows, {} failures\n", &(table.length, failures))
  return failures
}

// Checks of the functions that the rows do not reach.
effect fn checkValues() -> usize ! WriterError ? &mut Writer {
  let mut failures: usize = 0
  let span = Period.make(1, 2, 3, 4, Duration.fromMinutes(90))
  if span.years() != 1 || span.months() != 2 || span.weeks() != 3 || span.days() != 4 || !same(span.time(), Duration.fromMinutes(90)) {
    failures = failures + 1
  }
  if span.sign() != 1 || span.negate().sign() != -1 || Period.zero().sign() != 0 || !Period.zero().isZero() || span.isZero() {
    failures = failures + 1
  }
  if !same(span.negate().absolute(), span) || !same(span.negate().negate(), span) {
    failures = failures + 1
  }
  if span.isTimeOnly() || !Period.ofTime(Duration.fromSeconds(-1)).isTimeOnly() || !same(span.dateOnly(), Period.make(1, 2, 3, 4, Duration.zero())) {
    failures = failures + 1
  }
  if !same(Period.ofYears(2), period("P2Y")) || !same(Period.ofMonths(-3), period("-P3M")) || !same(Period.ofWeeks(4), period("P4W")) || !same(Period.ofDays(5), period("P5D")) {
    failures = failures + 1
  }
  // Parts with different signs, and parts outside the range, make no period.
  if !same(Period.checkedMake(1, -1, 0, 0, Duration.zero()), Option<Period>.none())
    || !same(Period.checkedMake(0, 0, 0, 1, Duration.fromSeconds(-1)), Option<Period>.none())
    || !same(Period.checkedMake(4294967296, 0, 0, 0, Duration.zero()), Option<Period>.none())
    || !same(Period.checkedMake(0, 0, 0, 104249991375, Duration.zero()), Option<Period>.none())
    || !same(Period.checkedMake(0, 0, 0, -104249991374, Duration.fromSeconds(-27392)), Option<Period>.none())
    || same(Period.checkedMake(0, 0, 0, -104249991374, Duration.fromSeconds(-27391)), Option<Period>.none()) {
    failures = failures + 1
  }
  // The sum is part by part, and has no result when its parts have different signs.
  if !same(period("P1M").checkedAdd(period("P20DT1H")), Option<Period>.some(period("P1M20DT1H")))
    || !same(period("P1M").checkedAdd(period("-P1D")), Option<Period>.none())
    || !same(period("P1M3D").checkedAdd(period("-P1M3D")), Option<Period>.some(Period.zero()))
    || !same(period("P4294967295Y").checkedAdd(period("P1Y")), Option<Period>.none()) {
    failures = failures + 1
  }
  // One month later and one day earlier, which a period cannot say.
  if !same(date("2024-01-31").checkedAddParts(0, 1, -1, Overflow.Constrain), Option<PlainDate>.some(date("2024-02-28")))
    || !same(date("2024-01-31").checkedAddParts(0, 1, -1, Overflow.Reject), Option<PlainDate>.none())
    || !same(date("2024-01-31").checkedAddParts(300000001, 0, 0, Overflow.Constrain), Option<PlainDate>.none()) {
    failures = failures + 1
  }
  let month = PlainYearMonth.make(2024, 2)
  if month.year() != 2024 || month.month() != 2 || month.daysInMonth() != 29 || month.daysInYear() != 366 || !month.inLeapYear() {
    failures = failures + 1
  }
  if !same(month.atDay(29), Option<PlainDate>.some(date("2024-02-29"))) || !same(month.atDay(30), Option<PlainDate>.none())
    || !same(PlainYearMonth.make(-271821, 4).atDay(18), Option<PlainDate>.none())
    || !same(PlainYearMonth.fromDate(date("2024-02-29")), month) {
    failures = failures + 1
  }
  let march = PlainYearMonth.make(2024, 3)
  let december = PlainYearMonth.make(2023, 12)
  if !(&month < &march) || !(&month > &december) || !same(month.addMonths(11), PlainYearMonth.make(2025, 1)) {
    failures = failures + 1
  }
  if !same(PlainYearMonth.checkedMake(2024, 13), Option<PlainYearMonth>.none()) || !same(PlainYearMonth.checkedMake(275760, 10), Option<PlainYearMonth>.none()) {
    failures = failures + 1
  }
  let day = PlainMonthDay.make(2, 29)
  if day.month() != 2 || day.day() != 29 || !same(PlainMonthDay.fromDate(date("2024-02-29")), day)
    || !same(PlainMonthDay.checkedMake(2, 30), Option<PlainMonthDay>.none()) || !same(PlainMonthDay.checkedMake(0, 1), Option<PlainMonthDay>.none()) {
    failures = failures + 1
  }
  run Format.format("{} value failures\n", &.(failures))
  return failures
}

effect fn program() -> i32 ! WriterError ? &mut Writer {
  let rowFailures = run checkRows()
  let valueFailures = run checkValues()
  if rowFailures != 0 || valueFailures != 0 {
    return 1
  }
  return 0
}

effect fn failed(error: WriterError) -> i32 {
  return 2
}

pub effect fn main() -> i32 {
  let mut out = StdoutWriter.make()
  return run Effect.catchAll(program(), failed) |> Effect.provideMut<Writer>(&mut out)
}
