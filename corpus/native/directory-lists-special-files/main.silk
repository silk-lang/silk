//! `FileSystem.listDirectory` lists a Unix socket in the directory as a special file, beside the
//! files, instead of failing the whole listing, and removing the directory removes the socket too,
//! as a socket a stopped server left behind needs.

import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.io.writer_native { StderrWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.net.socket_native { ListenOptions, NativeSocketError }
import silk.net.socket_native
import silk.system.filesystem { DirectoryEntry, FileError, FileSystem, Path }
import silk.system.filesystem_native { OsFileSystem }

static if Intrinsic.targetOperatingSystem() == "darwin" {
  const TEMPORARY: string = "/private/tmp"
} else {
  const TEMPORARY: string = "/tmp"
}

// A failed expectation, reported on standard error before the program exits with 1.
struct Failed {
  message: string<'static>,
}

effect fn expect(holds: bool, message: string<'static>) -> ()
  ! Failed {
  if !holds {
    fail Failed { message: message }
  }
}

effect fn cases(scratch: &Path) -> ()
  ! Failed | FileError | NativeSocketError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let file = run Path.join(scratch, "a.txt")
  run FileSystem.writeFile(&file, b"a")
  let socket = run Path.join(scratch, "b.sock")
  let mut listener = run socket_native.listenUnix(Path.rawBytes(&socket), ListenOptions.defaults())
  let listed = run FileSystem.listDirectory(scratch)
  run listener.close()
  let entries = List<DirectoryEntry>.asSlice(&listed)
  run expect(entries.length == 2, "the file and the socket are both listed")
  run expect(entries[0].kind.code == FileSystem.file().code, "the file is a file")
  run expect(entries[1].kind.code == FileSystem.specialFile().code, "the socket is a special file")
}

effect fn program() -> i32
  ! Failed | FileError | NativeSocketError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let parent = run Path.make(TEMPORARY)
  let scratch = run FileSystem.temporaryDirectory(&parent, "silk-list-special-")
  let outcome = run Effect.result(cases(&scratch.path))
  run FileSystem.release(move scratch)
  return match move outcome {
    Result<(), Failed | FileError | NativeSocketError | OutOfMemoryError>.Success { .. } => 0
    Result<(), Failed | FileError | NativeSocketError | OutOfMemoryError>.Failure { error } => {
      fail move error
    }
  }
}

effect fn failed(error: Failed | FileError | NativeSocketError | OutOfMemoryError) -> i32 {
  return match move error {
    Failed failure => {
      StderrWriter.print("failed: {}\n", &.(failure.message))
      return 1
    }
    FileError file => {
      drop file
      return 2
    }
    NativeSocketError socket => {
      drop socket
      return 4
    }
    OutOfMemoryError exhausted => {
      drop exhausted
      return 3
    }
  }
}

effect fn withFiles() -> i32
  ! Failed | FileError | NativeSocketError | OutOfMemoryError
  ? &mut Allocator {
  let mut files = run OsFileSystem.makeBytes(b"/")
  return run program() |> Effect.provideMut<FileSystem>(&mut files)
}

pub effect fn main() -> i32 {
  // Windows lists no Unix sockets in its directories.
  static if Intrinsic.targetOperatingSystem() == "windows" {
    return 0
  } else {
    let mut allocator = Allocator.systemAllocatorProvider()
    return run Effect.catchAll(withFiles(), failed) |> Effect.provideMut<Allocator>(&mut allocator)
  }
}
