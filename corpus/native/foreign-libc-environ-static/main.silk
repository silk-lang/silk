import silk.mem.pointer { Pointer }
static if Intrinsic.targetOperatingSystem() == "windows" {
  unsafe extern "C" static environment: ?[*]const ?[*]const u8 as "silk_test_environment"
  unsafe extern "C" fn silk_test_initialize_environment() -> ()
} else {
  unsafe extern "C" static environment: ?[*]const ?[*]const u8 as "environ"
}
pub fn main() -> i32 {
  static if Intrinsic.targetOperatingSystem() == "windows" { unsafe silk_test_initialize_environment() }
  unsafe { if Pointer.isNullMany(environment) { return 1 } }
  return 42
}
