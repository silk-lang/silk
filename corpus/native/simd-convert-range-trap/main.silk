// A lane conversion traps when any lane does not fit the target lane type (SIMD-005).
pub fn main() -> i32 {
  let wide = Intrinsic.simdFromArray<simd<u16, 4>>([1, 2, 300, 4])
  let narrow = Intrinsic.simdConvert<simd<u16, 4>, simd<u8, 4>>(wide)
  if Intrinsic.simdExtract<simd<u8, 4>>(narrow, 0) == 1 { return 1 }
  return 0
}
