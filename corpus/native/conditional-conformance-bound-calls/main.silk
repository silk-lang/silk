// Calls through the bounds of a conditional conformance: the first operand selects among the
// caller's bounds on one interface, a concrete operand takes its own conformance beside a bound,
// and a head's parameters that only its bounds fix (`R`, `Q` and the outputs below) are solved
// through those bounds at every use.
import silk.core.effect { Pair }

pub interface Delay {
  fn next(schedule: &mut Self) -> u64
}

struct Spaced { delay: u64 }

impl Delay for Spaced {
  fn next(schedule: &mut Self) -> u64 { return schedule.delay }
}

struct Longer<A, B> { left: A, right: B }

impl<A: Delay, B: Delay> Delay for Longer<A, B> {
  fn next(schedule: &mut Self) -> u64 {
    let left = Delay.next(&mut schedule.left)
    let right = Delay.next(&mut schedule.right)
    if left > right { return left }
    return right
  }
}

struct Offset<A> { inner: A, base: Spaced }

impl<A: Delay> Delay for Offset<A> {
  fn next(schedule: &mut Self) -> u64 {
    return Delay.next(&mut schedule.inner) + Delay.next(&mut schedule.base)
  }
}

fn first<S: Delay>(schedule: &mut S) -> u64 {
  return Delay.next(&mut schedule.*)
}

pub interface Step<In, Out, ?R> {
  effect fn step(schedule: &mut Self, input: &In) -> Out ? R
}

struct Fixed { delay: u64 }

impl<In> Step<In, u64 ? never> for Fixed {
  effect fn step(schedule: &mut Self, input: &In) -> u64 {
    drop input
    return schedule.delay
  }
}

struct Both<A, B> { left: A, right: B }

impl<In, OutA, OutB, ?R, ?Q, A: Step<In, OutA ? R>, B: Step<In, OutB ? Q>> Step<In, Pair<OutA, OutB> ? R | Q>
for Both<A, B> {
  effect fn step(schedule: &mut Self, input: &In) -> Pair<OutA, OutB> ? R | Q {
    let left = run Step<In, OutA ? R>.step(&mut schedule.left, input)
    let right = run Step<In, OutB ? Q>.step(&mut schedule.right, input)
    return Pair<OutA, OutB> { first: move left, second: move right }
  }
}

effect fn stepOnce<In, Out, ?R, S: Step<In, Out ? R>>(schedule: &mut S, input: &In) -> Out ? R {
  return run Step<In, Out ? R>.step(&mut schedule.*, input)
}

pub fn main() -> i32 {
  let mut longer = Longer<Spaced, Spaced> { left: Spaced { delay: 1 }, right: Spaced { delay: 2 } }
  if first(&mut longer) != 2 { return 1 }
  let mut offset = Offset<Longer<Spaced, Spaced>> { inner: move longer, base: Spaced { delay: 40 } }
  if first(&mut offset) != 42 { return 2 }
  let mut both = Both<Fixed, Fixed> { left: Fixed { delay: 3 }, right: Fixed { delay: 4 } }
  let inferred = run stepOnce(&mut both, &7)
  if inferred.first != 3 || inferred.second != 4 { return 3 }
  let explicit = run Step<i32, Pair<u64, u64> ? never>.step(&mut both, &7)
  if explicit.first + explicit.second != 7 { return 4 }
  let mut nested = Both<Both<Fixed, Fixed>, Fixed> { left: move both, right: Fixed { delay: 5 } }
  let deep = run stepOnce(&mut nested, &7)
  if deep.first.second != 4 || deep.second != 5 { return 5 }
  return 0
}
