import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.collections.list { List }
import silk.collections.slice { Slice }

// Generic bulk appends: a repeated fill and a slice copy for element types other than u8, each
// after existing elements so the list grows and keeps them.
effect fn check() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let mut levels = List<u16>.make()
  run levels.append(1)
  run levels.appendRepeated(65535, 100)
  run levels.appendRepeated(9, 0)
  if levels.length() != 101 || levels.get(0) != 1 || levels.get(1) != 65535 || levels.get(100) != 65535 {
    return 1
  }
  let mut catches = List<i64>.make()
  run catches.appendRepeated(-1, 37)
  let more: [i64; 3] = [5, 6, 7]
  run catches.appendSlice(&more)
  run catches.appendSlice(Slice.view<i64>(&more, 3, 0))
  if catches.length() != 40 || catches.get(0) != -1 || catches.get(36) != -1 || catches.get(37) != 5 || catches.get(39) != 7 {
    return 2
  }
  let mut bytes = List<u8>.make()
  run bytes.appendRepeated(7, 3)
  run bytes.appendBytes(b"ab")
  if bytes.length() != 5 || bytes.get(2) != 7 || bytes.get(4) != 98 {
    return 3
  }
  return 42
}

pub effect fn main() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run check() |> Effect.provideMut<Allocator>(&mut allocator)
}
