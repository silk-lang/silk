import silk.text.regex { Match, Pattern, Regex, RegexError, RegexReason }
import silk.text.string { String }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }

effect fn repeated(unit: string, count: usize, tail: string) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = String.make()
  let mut i: usize = 0
  while i < count {
    run text.append(unit)
    i = i + 1
  }
  run text.append(tail)
  return move text
}

// The reason a pattern fails to compile, or Syntax with offset 99999 when it compiles.
effect fn compileFailure(pattern: string) -> RegexError
  ! OutOfMemoryError
  ? &mut Allocator {
  let result = run Effect.result(Regex.validate(pattern))
  match move result {
    Result<(), RegexError | OutOfMemoryError>.Success { value: _ } => {
      return RegexError { reason: RegexReason.Syntax, message: "", offset: 99999 }
    }
    Result<(), RegexError | OutOfMemoryError>.Failure { error } => match move error {
      RegexError problem => {
        return move problem
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

effect fn checks() -> i32
  ! RegexError | OutOfMemoryError
  ? &mut Allocator {
  // ASCII text is searched in place.
  if !run Regex.matches("^\\d{4}-\\d{2}-\\d{2}$", "2026-11-07") {
    return 1
  }
  if run Regex.matches("^\\d{4}-\\d{2}-\\d{2}$", "2026-11-07x") {
    return 2
  }
  if !run Regex.matches("needle", "hay needle hay") {
    return 3
  }
  if !run Regex.matches("^(?i:abc)$", "ABC") {
    return 4
  }
  if !run Regex.matches("(?<=\\$)\\d+", "costs $42") {
    return 5
  }
  if !run Regex.matches("^(?<word>[a-z]+) \\k<word>$", "silk silk") {
    return 6
  }
  if run Regex.matches("^(?<word>[a-z]+) \\k<word>$", "silk wool") {
    return 7
  }

  // Other text is converted to UTF-16, and a surrogate pair is one character.
  if !run Regex.matches("^\\p{L}+$", "日本語") {
    return 10
  }
  if run Regex.matches("^\\p{L}+$", "日本1") {
    return 11
  }
  if !run Regex.matches("^.$", "😀") {
    return 12
  }
  if run Regex.matches("^..$", "😀") {
    return 13
  }
  if !run Regex.matches("^\\u{1F600}$", "😀") {
    return 14
  }
  if run Regex.matches("^\\d$", "٣") {
    return 15
  }
  if !run Regex.matches("^(?i:ΣΑΣ)$", "σας") {
    return 16
  }

  // Long text never exhausts a recursion bound.
  let long = run repeated("lorem ipsum dolor ", 6000, "")
  if !run Regex.matches("^[a-z ]+$", long.view()) {
    return 20
  }
  if !run Regex.matches("^.*$", long.view()) {
    return 21
  }
  let wide = run repeated("é", 20000, "z")
  if !run Regex.matches("^é+z$", wide.view()) {
    return 22
  }

  // Exponential backtracking stops with MatchLimit, never false.
  let pathological = run repeated("a", 40, "!")
  let pattern = run Regex.compile("^(a+)+$")
  let searched = run Effect.result(Regex.test(&pattern, pathological.view()))
  match move searched {
    Result<bool, RegexError | OutOfMemoryError>.Success { value: _ } => {
      return 30
    }
    Result<bool, RegexError | OutOfMemoryError>.Failure { error } => match move error {
      RegexError problem => {
        if problem.reason != RegexReason.MatchLimit {
          return 31
        }
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }

  // Syntax errors carry an offset; size and nesting bounds are PatternLimit.
  let unclosed = run compileFailure("ab(c")
  if unclosed.reason != RegexReason.Syntax || unclosed.offset == 99999 {
    return 40
  }
  if (run compileFailure("\\-")).reason != RegexReason.Syntax {
    return 41
  }
  if (run compileFailure("\\p{Letter}")).offset != 99999 {
    return 42
  }
  if (run compileFailure("\\p{letter}")).reason != RegexReason.Syntax {
    return 43
  }
  let deep = run repeated("(?:", 300, "")
  let mut nested = run String.copy(deep.view())
  let closing = run repeated(")", 300, "")
  run nested.append(closing.view())
  if (run compileFailure(nested.view())).reason != RegexReason.PatternLimit {
    return 44
  }
  let huge = run repeated("a", 65537, "")
  if (run compileFailure(huge.view())).reason != RegexReason.PatternLimit {
    return 45
  }
  let captures = run repeated("(a)", 300, "")
  if (run compileFailure(captures.view())).reason != RegexReason.PatternLimit {
    return 46
  }

  // A program longer than 65,535 bytecode bytes searches without a hint.
  let digits = run repeated("\\d", 2000, "ab")
  let classes = run Regex.compile(digits.view())
  let matching = run repeated("7", 2000, "ab")
  if !run Regex.test(&classes, matching.view()) {
    return 50
  }
  if run Regex.test(&classes, "77ab") {
    return 51
  }
  return run captureChecks()
}

// The text of group index of the first match, or "<none>" for no match or an unset group.
effect fn groupOf<'a>(pattern: &Pattern, text: string<'a>, index: usize) -> string<'a>
  ! RegexError | OutOfMemoryError
  ? &mut Allocator {
  let found = run Regex.find(pattern, text)
  match move found {
    Option<Match>.Some { value: hit } => match hit.group(index) {
      Option<string>.Some { value } => {
        return value
      }
      Option<string>.None => {
        return "<none>"
      }
    }
    Option<Match>.None => {
      return "<none>"
    }
  }
}

effect fn captureChecks() -> i32
  ! RegexError | OutOfMemoryError
  ? &mut Allocator {
  let version = run Regex.compile("v(?<major>\\d+)\\.(?<minor>\\d+)(-(?<pre>[a-z.0-9]+))?")
  if Regex.groupCount(&version) != 5 {
    return 60
  }
  if &Regex.groupIndex(&version, "minor") != &Option<usize>.some(2) {
    return 61
  }
  if &Regex.groupIndex(&version, "pre") != &Option<usize>.some(4) {
    return 62
  }
  if Regex.groupIndex(&version, "build").isSome() {
    return 63
  }
  if (run groupOf(&version, "tag v0.12-dev.3 here", 0)) != "v0.12-dev.3" {
    return 64
  }
  if (run groupOf(&version, "tag v0.12-dev.3 here", 2)) != "12" {
    return 65
  }
  if (run groupOf(&version, "tag v0.12 here", 4)) != "<none>" {
    return 66
  }
  if (run groupOf(&version, "no tag", 0)) != "<none>" {
    return 67
  }
  let found = run Regex.find(&version, "x v1.2")
  match move found {
    Option<Match>.Some { value: hit } => {
      if hit.start() != 2 || hit.end() != 6 || hit.text() != "v1.2" || hit.groupCount() != 5 {
        return 68
      }
    }
    Option<Match>.None => {
      return 69
    }
  }

  // Offsets found on UTF-16 come back as UTF-8 byte offsets.
  let word = run Regex.compile("(?<first>\\p{L}+) (?<second>\\p{L}+)")
  if (run groupOf(&word, "😀 日本 語です", 2)) != "語です" {
    return 70
  }
  let emoji = run Regex.compile("(.)(b)")
  let wide = run Regex.find(&emoji, "a😀b")
  match move wide {
    Option<Match>.Some { value: hit } => {
      if hit.start() != 1 || hit.end() != 6 || &hit.group(1) != &Option<string>.some("😀") {
        return 71
      }
    }
    Option<Match>.None => {
      return 72
    }
  }
  return 0
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  return 100
}

pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(checks(), failed) |> Effect.provideMut<Allocator>(&mut allocator)
}
