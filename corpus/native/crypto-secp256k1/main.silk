import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.crypto.secp256k1 { EcdsaSecp256k1, Secp256k1, Secp256k1Error, Secp256k1SignatureError }
import silk.crypto.sha2 { Sha256, Sha384, Sha512 }

fn equal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut i: usize = 0
  while i < left.length {
    if left[i] != right[i] {
      return false
    }
    i = i + 1
  }
  return true
}

fn key(secret: &[u8]) -> Secp256k1 {
  return match Secp256k1.fromBytes(secret) {
    Result<Secp256k1, Secp256k1Error>.Success { value } => move value
    Result<Secp256k1, Secp256k1Error>.Failure { error: _ } => {
      Intrinsic.trap("bad secret")
    }
  }
}

fn verified(result: Result<(), Secp256k1SignatureError>) -> bool {
  return match move result {
    Result<(), Secp256k1SignatureError>.Success { .. } => true
    Result<(), Secp256k1SignatureError>.Failure { error: _ } => false
  }
}

fn mismatched(result: Result<(), Secp256k1SignatureError>) -> bool {
  return match move result {
    Result<(), Secp256k1SignatureError>.Failure { error: Secp256k1SignatureError.AuthenticationFailed } => true
    _ => false
  }
}

// Checks the key, its public forms, deterministic signatures with three hashes, the DER form, and
// a signature that another program made with a random nonce.
fn keyCase(
  secret: &[u8],
  publicKey: &[u8],
  compressed: &[u8],
  message: &[u8],
  sha512: &[u8],
  sha256: &[u8],
  sha384: &[u8],
  der512: &[u8],
  random512: &[u8],
  random256: &[u8],
) -> i32 {
  let signer = key(secret)
  if !equal(&signer.publicKey(), publicKey) {
    return 1
  }
  match Secp256k1.compressPublicKey(publicKey) {
    Result<[u8; 33], Secp256k1Error>.Success { value } => {
      if !equal(&value, compressed) {
        return 2
      }
    }
    Result<[u8; 33], Secp256k1Error>.Failure { error: _ } => {
      return 2
    }
  }
  match Secp256k1.decompressPublicKey(compressed) {
    Result<[u8; 65], Secp256k1Error>.Success { value } => {
      if !equal(&value, publicKey) {
        return 3
      }
    }
    Result<[u8; 65], Secp256k1Error>.Failure { error: _ } => {
      return 3
    }
  }
  let signed512 = signer.sign<Sha512>(message)
  if !equal(&signed512, sha512) {
    return 4
  }
  if !equal(&signer.sign<Sha256>(message), sha256) || !equal(&signer.sign<Sha384>(message), sha384) {
    return 5
  }
  let mut der: [u8; 72] = [0; 72]
  let length = EcdsaSecp256k1.toDer(sha512, &mut der)
  if !equal(Slice.view<u8>(&der, 0, length), der512) {
    return 6
  }
  match EcdsaSecp256k1.fromDer(der512) {
    Result<[u8; 64], Secp256k1SignatureError>.Success { value } => {
      if !equal(&value, sha512) {
        return 7
      }
    }
    Result<[u8; 64], Secp256k1SignatureError>.Failure { error: _ } => {
      return 7
    }
  }
  let fixed512 = match EcdsaSecp256k1.fromDer(random512) {
    Result<[u8; 64], Secp256k1SignatureError>.Success { value } => value
    Result<[u8; 64], Secp256k1SignatureError>.Failure { error: _ } => {
      return 8
    }
  }
  if !verified(EcdsaSecp256k1.verify<Sha512>(publicKey, message, sha512))
    || !verified(EcdsaSecp256k1.verify<Sha512>(publicKey, message, &fixed512)) {
    return 8
  }
  if !verified(EcdsaSecp256k1.verify<Sha256>(publicKey, message, sha256))
    || !verified(EcdsaSecp256k1.verify<Sha384>(publicKey, message, sha384)) {
    return 9
  }
  let fixed = match EcdsaSecp256k1.fromDer(random256) {
    Result<[u8; 64], Secp256k1SignatureError>.Success { value } => value
    Result<[u8; 64], Secp256k1SignatureError>.Failure { error: _ } => {
      return 10
    }
  }
  if !verified(EcdsaSecp256k1.verify<Sha256>(publicKey, message, &fixed)) {
    return 10
  }
  if !mismatched(EcdsaSecp256k1.verify<Sha512>(publicKey, b"other", &fixed512))
    || !mismatched(EcdsaSecp256k1.verify<Sha512>(publicKey, message, sha256)) {
    return 11
  }
  return 0
}

fn agreeCase(secret: &[u8], peer: &[u8], shared: &[u8]) -> bool {
  return match key(secret).agree(peer) {
    Result<[u8; 32], Secp256k1Error>.Success { value } => equal(&value, shared)
    Result<[u8; 32], Secp256k1Error>.Failure { error: _ } => false
  }
}

