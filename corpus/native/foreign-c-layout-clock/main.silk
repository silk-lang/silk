import silk.mem.pointer { Pointer }
static if Intrinsic.targetOperatingSystem() == "windows" {
  extern "C" struct FileTime { low: u32, high: u32 }
  @foreign(noCapture: ("value",))
  unsafe extern "C" fn GetSystemTimePreciseAsFileTime(value: *mut FileTime) -> ()
  pub fn main() -> i32 {
    let mut value = FileTime {low: 4294967295, high: 4294967295}
    unsafe GetSystemTimePreciseAsFileTime(Pointer.fromMutRef(&mut value))
    // FILETIME's 100-nanosecond timestamp is positive and fits a signed 64-bit integer.
    if value.high == 0 || value.high >= 2147483648 { return 1 }
    return 0
  }
} else {
extern "C" struct Timespec {
  seconds: i64,
  nanoseconds: i64,
}
unsafe extern "C" fn clock_gettime(clock: i32, value: *mut Timespec) -> i32
pub fn main() -> i32 {
  let mut value = Timespec { seconds: -1, nanoseconds: -1 }
  if unsafe clock_gettime(0, Pointer.fromMutRef(&mut value)) != 0 { return 1 }
  if value.seconds < 0 { return 2 }
  if value.nanoseconds < 0 { return 3 }
  if value.nanoseconds >= 1000000000 { return 4 }
  return 0
}
}
