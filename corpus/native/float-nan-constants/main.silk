import silk.num.f32
import silk.num.f64

// A constant folded from infinity minus infinity holds the canonical quiet NaN on every host.
const FOLDED: f64 = f64.INFINITY - f64.INFINITY

pub fn main() -> i32 {
  if !f64.isNaN(f64.NAN) { return 1 }
  if f64.toBits(f64.NAN) != 0x7FF8000000000000 { return 2 }
  if f64.NAN == f64.NAN { return 3 }
  if !f32.isNaN(f32.NAN) { return 4 }
  if f32.toBits(f32.NAN) != 0x7FC00000 { return 5 }
  if f32.NAN == f32.NAN { return 6 }
  if f64.toBits(FOLDED) != 0x7FF8000000000000 { return 7 }
  return 42
}
