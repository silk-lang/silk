import silk.system.glob_scan { ScanOptions, Walker, scan }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.system.filesystem_native { OsFileSystem }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.io.writer_native { StderrWriter }
import silk.num.usize
import silk.text.string { String, InvalidUtf8 }

@foreign(noCapture: ("target", "path"))
unsafe extern "C" fn symlink(target: ?[*]const u8, path: ?[*]const u8) -> i32

// The host directory the file system provider is rooted at.
const HOST_ROOT: string = "/tmp"

// A failed expectation, reported on standard error before the program exits with 1.
struct Failed {
  message: string<'static>,
}

effect fn expect(holds: bool, message: string<'static>) -> ()
  ! Failed {
  if !holds {
    fail Failed { message: message }
  }
}

effect fn file(base: &Path, name: &[u8]) -> ()
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let path = run Path.joinBytes(base, name)
  return run FileSystem.writeFileWithParents(&path, b"")
}

effect fn directory(base: &Path, name: &[u8]) -> ()
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let path = run Path.joinBytes(base, name)
  return run FileSystem.createDirectoriesRecursively(&path)
}

// Makes a symbolic link at `name` below `base` that points to `target`, through the host.
effect fn link(base: &Path, name: &[u8], target: &[u8]) -> ()
  ! Failed | OutOfMemoryError
  ? &mut Allocator {
  let mut host = run Bytes.copy(String.utf8Bytes(HOST_ROOT))
  run Bytes.append(&mut host, Path.rawBytes(base))
  run Bytes.append(&mut host, b"/")
  run Bytes.append(&mut host, name)
  run Bytes.append(&mut host, b"\0")
  let mut destination = run Bytes.copy(target)
  run Bytes.append(&mut destination, b"\0")
  let status = unsafe symlink(
    Pointer.fromSlice(Bytes.asSlice(&destination)),
    Pointer.fromSlice(Bytes.asSlice(&host)),
  )
  run expect(status == 0, "the fixture creates a symbolic link")
}

fn equal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut index = usize.ZERO
  while index < left.length {
    if left[index] != right[index] {
      return false
    }
    index = index + usize.ONE
  }
  return true
}

fn contains(values: &List<Bytes>, expected: &[u8]) -> bool {
  let entries = List<Bytes>.asSlice(values)
  let mut index = usize.ZERO
  while index < entries.length {
    if equal(Bytes.asSlice(&entries[index]), expected) {
      return true
    }
    index = index + usize.ONE
  }
  return false
}

effect fn collect(base: &Path, pattern: string, dot: bool, onlyFiles: bool) -> List<Bytes>
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut options = run ScanOptions.make(base)
  options.dot = dot
  options.onlyFiles = onlyFiles
  return run scan(pattern, move options)
}

effect fn cases(tree: &Path) -> ()
  ! Failed | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  run directory(tree, b"a/nested")
  run file(tree, b"a/one.txt")
  run file(tree, b"a/nested/two.txt")
  run file(tree, b"a/nested/other.rs")
  run file(tree, b"root.txt")
  run file(tree, b".hidden.txt")
  run file(tree, b".secret/visible.txt")
  run link(tree, b"link", b"a")
  run link(tree, b"dangling", b"absent")
  run link(tree, b"filelink", b"root.txt")
  run link(tree, b"a/loop", b".")
  let invalid: [u8; 5] = [255, 46, 98, 105, 110]
  run file(tree, &invalid)

  let basic = run scan("**/*.txt", run ScanOptions.make(tree))
  run expect(
    List<Bytes>.length(&basic) == 3 && contains(&basic, b"root.txt")
      && contains(&basic, b"a/one.txt")
      && contains(&basic, b"a/nested/two.txt"),
    "globstar matches zero and more directories; hidden names and links are left out",
  )
  let hidden = run collect(tree, "**/*.txt", true, true)
  run expect(
    List<Bytes>.length(&hidden) == 5 && contains(&hidden, b".hidden.txt")
      && contains(&hidden, b".secret/visible.txt"),
    "the dot option enters hidden directories",
  )
  let explicitDot = run collect(tree, "**/.secret/*.txt", false, true)
  run expect(
    List<Bytes>.length(&explicitDot) == 1 && contains(&explicitDot, b".secret/visible.txt"),
    "a literal dot segment opens a hidden directory",
  )
  let trailing = run collect(tree, "a/*/", false, false)
  run expect(
    List<Bytes>.length(&trailing) == 1 && contains(&trailing, b"a/nested"),
    "a trailing slash reports directories only",
  )
  let filesWithSlash = run collect(tree, "a/*/", false, true)
  run expect(
    List<Bytes>.length(&filesWithSlash) == 0,
    "a trailing slash with onlyFiles reports nothing",
  )

  let literal = run collect(tree, "link/nested/*.txt", false, true)
  run expect(
    List<Bytes>.length(&literal) == 1 && contains(&literal, b"link/nested/two.txt"),
    "a literal segment follows a symbolic link",
  )
  let wildcard = run collect(tree, "*/one.txt", false, true)
  run expect(
    List<Bytes>.length(&wildcard) == 1 && contains(&wildcard, b"a/one.txt"),
    "a wildcard does not enter a symbolic link",
  )
  let loops = run collect(tree, "a/**/*.txt", false, true)
  run expect(List<Bytes>.length(&loops) == 2, "a link back to its own directory is not entered")
  let links = run collect(tree, "*", false, false)
  run expect(
    contains(&links, b"dangling") && contains(&links, b"filelink") && contains(&links, b"link")
      && contains(&links, b"a"),
    "links and directories are reported when onlyFiles is false",
  )
  let fileLinks = run collect(tree, "file*", false, true)
  run expect(List<Bytes>.length(&fileLinks) == 0, "a link that a wildcard matched is not a file")
  let named = run collect(tree, "filelink", false, true)
  run expect(
    List<Bytes>.length(&named) == 1 && contains(&named, b"filelink"),
    "a literal link to a file is a file",
  )
  let dangling = run collect(tree, "dangling", false, false)
  run expect(List<Bytes>.length(&dangling) == 0, "a literal broken link names nothing")

  let braces = run collect(tree, "a/{one.txt,one.txt}", false, true)
  run expect(
    List<Bytes>.length(&braces) == 1 && contains(&braces, b"a/one.txt"),
    "overlapping alternatives report a path once",
  )
  let repeated = run collect(tree, "**/**/**/*.txt", false, true)
  run expect(List<Bytes>.length(&repeated) == 3, "successive globstars report each path once")
  let dotback = run collect(tree, "a/nested/../*.txt", false, true)
  run expect(
    List<Bytes>.length(&dotback) == 1 && contains(&dotback, b"a/one.txt"),
    "a parent segment is resolved in the result",
  )
  let binary = run collect(tree, "*.bin", false, true)
  run expect(
    List<Bytes>.length(&binary) == 1 && contains(&binary, &invalid),
    "names that are not UTF-8 are reported as they are",
  )
  let absent = run collect(tree, "missing/literal/**/*.txt", false, true)
  run expect(List<Bytes>.length(&absent) == 0, "a missing literal prefix reports nothing")

  let mut absolute = run Bytes.copy(Path.rawBytes(tree))
  run Bytes.append(&mut absolute, b"/root.txt")
  let rooted = run Bytes.copy(Bytes.asSlice(&absolute))
  let absoluteResults = match move String.fromBytes(move rooted) {
    Result<String, InvalidUtf8>.Success { value } => run scan(
      String.view(&value),
      run ScanOptions.make(tree),
    )
    Result<String, InvalidUtf8>.Failure { error } => {
      drop error
      List<Bytes>.make()
    }
  }
  run expect(
    List<Bytes>.length(&absoluteResults) == 1
      && contains(&absoluteResults, Bytes.asSlice(&absolute)),
    "an absolute pattern reports absolute paths",
  )

  let mut walker = run Walker.make("root.txt", run ScanOptions.make(tree))
  let first = match move run Walker.next(&mut walker) {
    Option<Bytes>.Some { value } => equal(Bytes.asSlice(&value), b"root.txt")
    Option<Bytes>.None => false
  }
  run expect(first, "the walker returns an owned path")
  let second = match move run Walker.next(&mut walker) {
    Option<Bytes>.Some { value } => false
    Option<Bytes>.None => true
  }
  let third = match move run Walker.next(&mut walker) {
    Option<Bytes>.Some { value } => false
    Option<Bytes>.None => true
  }
  run expect(second && third, "an exhausted walker keeps returning none")
  let empty = run scan("", run ScanOptions.make(tree))
  run expect(List<Bytes>.length(&empty) == 0, "an empty pattern reports nothing")

  let missing = run Path.joinBytes(tree, b"absent")
  let refused = match move run Effect.result(Walker.make("*", run ScanOptions.make(&missing))) {
    Result<Walker, FileError | OutOfMemoryError>.Success { value } => false
    Result<Walker, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError failure => failure.reason.code == FileSystem.notFound().code
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  run expect(refused, "a missing base directory fails with NotFound")
}

effect fn program() -> i32
  ! Failed | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let root = run Path.root()
  let scratch = run FileSystem.temporaryDirectory(&root, "silk-glob-scan-")
  let tree = run Path.fromBytes(Path.rawBytes(&scratch.path))
  let outcome = run Effect.result(cases(&tree))
  run FileSystem.release(move scratch)
  return match move outcome {
    Result<(), Failed | FileError | OutOfMemoryError>.Success { value } => 0
    Result<(), Failed | FileError | OutOfMemoryError>.Failure { error } => {
      fail move error
    }
  }
}

effect fn failed(error: Failed | FileError | OutOfMemoryError) -> i32 {
  return match move error {
    Failed failure => {
      StderrWriter.print("failed: {}\n", &(failure.message,))
      return 1
    }
    FileError file => {
      drop file
      return 2
    }
    OutOfMemoryError exhausted => {
      drop exhausted
      return 3
    }
  }
}

effect fn withFiles() -> i32
  ! Failed | FileError | OutOfMemoryError
  ? &mut Allocator {
  let mut files = run OsFileSystem.make(HOST_ROOT)
  return run program() |> Effect.provideMut<FileSystem>(&mut files)
}

pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(withFiles(), failed) |> Effect.provideMut<Allocator>(&mut allocator)
}
