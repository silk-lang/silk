// ChaCha20 and ChaCha20-Poly1305 on long messages in uneven parts: the eight- and four-block
// paths, single blocks, partial blocks across calls, a counter that carries into the nonce, and
// all-ones messages, AAD and keys for the Poly1305 carries. Outputs go into SHA-256 digests
// checked against Python's `cryptography` (OpenSSL), and for the counter carry, which it refuses,
// against a Python model of OpenSSL's carry that matches it elsewhere. Exit code 42 is a pass.
import silk.crypto.chacha20_poly1305 {AeadError, ChaCha20, ChaCha20Error, ChaCha20Poly1305, ChaCha20Poly1305Decryptor, ChaCha20Poly1305Encryptor}
import silk.crypto.sha2 {Sha256}
import silk.collections.slice {Slice}
import silk.core.result {Result}
import silk.num.usize

fn lengths() -> [usize; 17] {
  return [0, 1, 15, 16, 17, 63, 64, 65, 255, 256, 257, 511, 512, 513, 1000, 1100, 4099]
}

fn message(length: usize, fill: bool, output: &mut [u8; 4128]) -> () {
  let mut index: usize = 0
  while index < length {
    if fill {
      output[index] = 255
    } else {
      output[index] = usize.toU8((index * 31 + length * 7 + 5) % 256)
    }
    index = index + 1
  }
}

fn key(variant: usize) -> [u8; 32] {
  let mut bytes: [u8; 32] = [255; 32]
  if variant < 3 {
    let mut index: usize = 0
    while index < 32 {
      bytes[index] = usize.toU8((index * 13 + variant * 71) % 256)
      index = index + 1
    }
  }
  return bytes
}

fn nonce(variant: usize) -> [u8; 12] {
  let mut bytes: [u8; 12] = [0; 12]
  let mut index: usize = 0
  while index < 12 {
    bytes[index] = usize.toU8((index * 29 + variant) % 256)
    index = index + 1
  }
  return bytes
}

fn equal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut index: usize = 0
  while index < left.length {
    if left[index] != right[index] { return false }
    index = index + 1
  }
  return true
}

// An uneven first part, then parts of 517 or 129 bytes.
fn part(length: usize, offset: usize) -> usize {
  let mut size: usize = 129
  if offset == 0 {
    size = length % 37
  } else if offset % 2 == 1 {
    size = 517
  }
  if size > length - offset {
    size = length - offset
  }
  return size
}

fn streamOk(result: Result<(), ChaCha20Error>) -> bool {
  return match move result {
    Result<(), ChaCha20Error>.Success { value: _ } => true
    Result<(), ChaCha20Error>.Failure { error: _ } => false
  }
}

fn aeadOk(result: Result<(), AeadError>) -> bool {
  return match move result {
    Result<(), AeadError>.Success { value: _ } => true
    Result<(), AeadError>.Failure { error: _ } => false
  }
}

fn checkStream(expected: &[u8; 32]) -> bool {
  let mut digest = Sha256.make()
  let counters: [u32; 4] = [0, 1, 4294967290, 4294967295]
  let mut plain: [u8; 4128] = [0; 4128]
  let mut cipher: [u8; 4128] = [0; 4128]
  let mut variant: usize = 0
  while variant < 4 {
    let keyBytes = key(variant)
    let nonceBytes = nonce(variant)
    let mut counterIndex: usize = 0
    while counterIndex < 4 {
      let all = lengths()
      let mut lengthIndex: usize = 0
      while lengthIndex < all.length {
        let length = all[lengthIndex]
        message(length, false, &mut plain)
        if let Result.Success { value } = ChaCha20.make(&keyBytes, &nonceBytes, counters[counterIndex]) {
          let mut state = move value
          let mut offset: usize = 0
          while offset < length {
            let size = part(length, offset)
            if !streamOk(state.apply(Slice.view<u8>(&plain, offset, size), Slice.viewMut<u8>(&mut cipher, offset, 4128 - offset))) { return false }
            offset = offset + size
          }
        } else {
          return false
        }
        digest.update(Slice.view<u8>(&cipher, 0, length))
        lengthIndex = lengthIndex + 1
      }
      counterIndex = counterIndex + 1
    }
    variant = variant + 1
  }
  let computed = digest.finish()
  return equal(&computed, expected)
}

// Each message is sealed in parts and in one call, opened in parts with the full tag and with a
// 5-byte prefix, and opened in one call.
fn checkAead(expected: &[u8; 32]) -> bool {
  let mut digest = Sha256.make()
  let aadLengths: [usize; 3] = [0, 13, 64]
  let mut plain: [u8; 4128] = [0; 4128]
  let mut cipher: [u8; 4128] = [0; 4128]
  let mut whole: [u8; 4128] = [0; 4128]
  let mut back: [u8; 4128] = [0; 4128]
  let mut variant: usize = 0
  while variant < 4 {
    let keyBytes = key(variant)
    let nonceBytes = nonce(variant)
    let mut aadIndex: usize = 0
    while aadIndex < 3 {
      let mut fillIndex: usize = 0
      while fillIndex < 2 {
        let fill = fillIndex == 1
        let mut aadBytes: [u8; 64] = [0; 64]
        let aadLength = aadLengths[aadIndex]
        let mut index: usize = 0
        while index < aadLength {
          if fill {
            aadBytes[index] = 255
          } else {
            aadBytes[index] = usize.toU8((index * 5 + aadLength) % 256)
          }
          index = index + 1
        }
        let aad = Slice.view<u8>(&aadBytes, 0, aadLength)
        let all = lengths()
        let mut lengthIndex: usize = 0
        while lengthIndex < all.length {
          let length = all[lengthIndex]
          message(length, fill, &mut plain)
          let input = Slice.view<u8>(&plain, 0, length)
          let mut tag: [u8; 16] = [0; 16]
          if let Result.Success { value } = ChaCha20Poly1305Encryptor.make(&keyBytes, &nonceBytes, aad) {
            let mut state = move value
            let mut offset: usize = 0
            while offset < length {
              let size = part(length, offset)
              if !aeadOk(state.update(Slice.view<u8>(&plain, offset, size), Slice.viewMut<u8>(&mut cipher, offset, 4128 - offset))) { return false }
              offset = offset + size
            }
            if !aeadOk(state.finish(&mut tag)) { return false }
          } else {
            return false
          }
          let mut wholeTag: [u8; 16] = [0; 16]
          if !aeadOk(ChaCha20Poly1305.seal(&keyBytes, &nonceBytes, aad, input, &mut whole, &mut wholeTag)) { return false }
          if !equal(Slice.view<u8>(&whole, 0, length), Slice.view<u8>(&cipher, 0, length)) { return false }
          if !equal(&wholeTag, &tag) { return false }
          digest.update(Slice.view<u8>(&cipher, 0, length))
          digest.update(&tag)
          let mut cut: usize = 0
          while cut < 2 {
            let mut tagLength: usize = 16
            if cut == 1 {
              tagLength = 5
            }
            if let Result.Success { value } = ChaCha20Poly1305Decryptor.make(&keyBytes, &nonceBytes, aad) {
              let mut state = move value
              let mut offset: usize = 0
              while offset < length {
                let size = part(length, offset)
                if !aeadOk(state.update(Slice.view<u8>(&cipher, offset, size), Slice.viewMut<u8>(&mut back, offset, 4128 - offset))) { return false }
                offset = offset + size
              }
              if !aeadOk(state.finish(Slice.view<u8>(&tag, 0, tagLength))) { return false }
            } else {
              return false
            }
            if !equal(Slice.view<u8>(&back, 0, length), input) { return false }
            cut = cut + 1
          }
          if !aeadOk(ChaCha20Poly1305.open(&keyBytes, &nonceBytes, aad, Slice.view<u8>(&cipher, 0, length), &tag, &mut back)) { return false }
          if !equal(Slice.view<u8>(&back, 0, length), input) { return false }
          lengthIndex = lengthIndex + 1
        }
        fillIndex = fillIndex + 1
      }
      aadIndex = aadIndex + 1
    }
    variant = variant + 1
  }
  let computed = digest.finish()
  return equal(&computed, expected)
}

pub fn main() -> i32 {
  let stream: [u8; 32] = [187, 203, 72, 233, 96, 17, 135, 67, 22, 226, 27, 45, 119, 227, 74, 21, 244, 37, 240, 207, 187, 103, 9, 0, 48, 152, 186, 103, 190, 244, 88, 177]
  let aead: [u8; 32] = [120, 95, 164, 116, 4, 49, 169, 22, 66, 159, 190, 32, 7, 67, 94, 27, 114, 69, 244, 133, 115, 191, 54, 197, 46, 38, 212, 205, 76, 24, 117, 199]
  if !checkStream(&stream) { return 1 }
  if !checkAead(&aead) { return 2 }
  return 42
}
