import silk.core.effect { Effect }
import silk.io.logger { Logger, InMemoryLogger }
import silk.concurrency.execution { Execution }
import silk.concurrency.sync { Arc }
import silk.mem.allocator { Allocator, OutOfMemoryError }

fn leaf() -> () { run Effect.logInfo("child", &.{}) }
effect fn child() -> i32 { leaf() return 42 }
fn ready(data: &()) -> () {}
fn complete(result: &mut i32, value: i32) -> () { result.* = value leaf() }
fn parked(result: &mut i32, task: Intrinsic.Execution<i32>) -> () { drop task }
effect fn make() -> Intrinsic.Execution<i32> ! OutOfMemoryError ? &mut Allocator {
  return run Execution.make(child(), (), ready)
}
effect fn test() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let handle = run Arc<InMemoryLogger>.make(run Logger.inMemoryProvider())
  let task = run make() |> Effect.provideAmbient<Logger>(&handle)
  if handle.count() != 2 { return 1 }
  let mut result = 0
  run Execution.drive(move task, &mut result, complete, parked)
  if handle.count() != 1 || result != 42 { return 2 }
  if Logger.length(handle.get()) != 1 { return 3 }
  let unused = run make() |> Effect.provideAmbient<Logger>(&handle)
  drop unused
  if handle.count() != 1 { return 4 }
  return 0
}
effect fn failed(error: OutOfMemoryError) -> i32 { return 9 }
pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(test() |> Effect.provideMut<Allocator>(&mut allocator), failed)
}
