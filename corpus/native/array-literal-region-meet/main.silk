import silk.num.u8
import silk.num.usize

struct Header<'v> {
  name: string<'static>,
  value: &'v [u8],
}

fn header<'v>(name: string<'static>, value: &'v [u8]) -> Header<'v> {
  return Header { name: name, value: value }
}

// The first element is a `Header<'static>` and the second borrows a local: the array takes the
// shorter region of its elements instead of the first element's.
fn total(extra: &[u8]) -> i32 {
  let length: [u8; 2] = ['4', '2']
  let headers = [header("Content-Type", b"text/plain"), header("Content-Length", &length), header("X-Extra", extra)]
  let first = headers[0].value.length + headers[1].value.length + headers[2].value.length
  // 10 + 2 + 3 bytes, and the local's first byte '4' (52) less 25.
  return usize.toI32(first) + u8.toI32(headers[1].value[0]) - 25
}

pub fn main() -> i32 {
  let extra: [u8; 3] = ['a', 'b', 'c']
  return total(&extra)
}
