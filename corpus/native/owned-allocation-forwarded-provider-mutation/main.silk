import silk.mem.pointer { Pointer }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.mem.layout { Layout }
struct CountingAllocator { hits: i32 }
effect fn allocate(self: &mut CountingAllocator, layout: Layout) -> Intrinsic.Allocation ! OutOfMemoryError {
  self.hits = self.hits + 1
  let mut inner = Allocator.systemAllocatorProvider()
  return run Allocator.allocate(move layout) |> Effect.provideMut(&mut inner)
}
impl Allocator for CountingAllocator {
  allocate: CountingAllocator.allocate
  /// Keeps no ready blocks.
  unsafe effect fn takeBlock(self: &mut Self, layout: Layout) -> ?*mut u8 { drop layout return Pointer.null<u8>() }
}
effect fn forwarded(layout: Layout) -> Intrinsic.Allocation ! OutOfMemoryError ? &mut Allocator {
  return run Allocator.allocate(move layout)
}
effect fn build() -> i32 ! OutOfMemoryError {
  let mut allocator = CountingAllocator { hits: 0 }
  let block = run forwarded(Layout.of<[i32; 2]>()) |> Effect.provideMut(&mut allocator)
  drop block
  if allocator.hits != 1 { return 2 }
  return 42
}
effect fn recover(error: OutOfMemoryError) -> i32 { return 3 }
pub fn main() -> i32 { return run Effect.catchAll(build(), recover) }