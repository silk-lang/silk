// An operation with a body declares a default: a conformance that omits the operation uses it, and
// one that writes the operation replaces it.
import silk.core.effect { Effect }
import silk.format { Debug, Format, Formatter }
import silk.io.writer { Writer, WriterError }

pub struct SinkError {
  code: i32,
}

impl Debug for SinkError {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return run Format.debugFields(self, "SinkError", &mut formatter)
  }
}

// A service default reaches its provider through the Effect environment its operation requires.
service Sink<T> {
  effect fn put(value: T) -> () ! SinkError ? &mut Sink<T>

  effect fn putPair(first: T, second: T) -> ()
    ! SinkError
    ? &mut Sink<T> {
    run Sink<T>.put(move first)
    run Sink<T>.put(move second)
    return ()
  }

  // A default may call another default.
  effect fn putFour(a: T, b: T, c: T, d: T) -> ()
    ! SinkError
    ? &mut Sink<T> {
    run Sink<T>.putPair(move a, move b)
    run Sink<T>.putPair(move c, move d)
    return ()
  }
}

// A provider with a lifetime parameter uses the defaults too.
struct Summer<'a> {
  total: &'a mut i64,
  puts: usize,
}

impl<'a> Sink<i64> for Summer<'a> {
  effect fn put(self: &mut Self, value: i64) -> ()
    ! SinkError
    ? &mut Sink<i64> {
    self.total.* = self.total.* + value
    self.puts = self.puts + 1
    return ()
  }
}

// A provider that writes `putPair` replaces that default, and the `putFour` default calls it.
struct Batched {
  total: i64,
  pairs: usize,
}

impl Sink<i64> for Batched {
  effect fn put(self: &mut Self, value: i64) -> ()
    ! SinkError
    ? &mut Sink<i64> {
    self.total = self.total + value
    return ()
  }

  effect fn putPair(self: &mut Self, first: i64, second: i64) -> ()
    ! SinkError
    ? &mut Sink<i64> {
    self.total = self.total + first + second
    self.pairs = self.pairs + 1
    return ()
  }
}

// An interface default may call the interface's operations on `Self`.
interface Shape {
  fn area(self: &Self) -> i32

  fn doubled(self: &Self) -> i32 {
    return Shape.area(self) * 2
  }
}

struct Square {
  side: i32,
}

impl Shape for Square {
  fn area(self: &Self) -> i32 {
    return self.side * self.side
  }
}

struct Pair<T> {
  left: T,
  right: T,
}

impl<T: Shape> Shape for Pair<T> {
  fn area(self: &Self) -> i32 {
    return Shape.area(&self.left) + Shape.area(&self.right)
  }
}

fn doubledThrough<T: Shape>(value: &T) -> i32 {
  return Shape.doubled(value)
}

pub effect fn main() -> i32
  ! SinkError {
  let mut total: i64 = 0
  let mut summer = Summer { total: &mut total, puts: 0 }
  run Sink<i64>.putFour(1, 2, 3, 4) |> Effect.provideMut<Sink<i64>>(&mut summer)
  if summer.puts != 4 {
    return 1
  }
  if total != 10 {
    return 2
  }
  let mut batched = Batched { total: 0, pairs: 0 }
  run Sink<i64>.putFour(5, 6, 7, 8) |> Effect.provideMut<Sink<i64>>(&mut batched)
  if batched.total != 26 || batched.pairs != 2 {
    return 3
  }
  let square = Square { side: 3 }
  if Shape.doubled(&square) != 18 {
    return 4
  }
  let pair = Pair<Square> { left: Square { side: 1 }, right: Square { side: 2 } }
  if doubledThrough<Pair<Square>>(&pair) != 10 {
    return 5
  }
  return 42
}
