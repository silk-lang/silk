import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.concurrency.thread_native { JoinHandle, NativeThread, SpawnError }
import silk.concurrency.sync { Arc, Condition, Mutex }

// Workers hand turns back and forth with the main thread through one mutex and condition;
// a timed wait with no notifier reports its timeout and still holds the lock.
struct Shared {
  turn: Mutex<i32>,
  changed: Condition,
}

fn worker(shared: Arc<Shared>, mine: i32) -> i32 {
  let state = shared.get()
  let mut guard = state.turn.lock()
  let mut round = 0
  while round < 100 {
    while guard.get().* != mine { state.changed.wait(&mut guard) }
    let value = guard.getMut()
    value.* = 0
    state.changed.notifyAll()
    round = round + 1
  }
  return mine
}

effect fn spawnWorker(shared: &Arc<Shared>, mine: i32) -> JoinHandle<i32> ! OutOfMemoryError | SpawnError ? &mut Allocator {
  let handle = shared.clone()
  return run NativeThread.spawn(fn() -> i32 { return worker(move handle, mine) })
}

// Hands out 200 turns, alternating between the workers, then waits for the last to finish.
fn drive(state: &Shared) -> () {
  let mut guard = state.turn.lock()
  let mut handed = 0
  while handed < 200 {
    while guard.get().* != 0 { state.changed.wait(&mut guard) }
    let value = guard.getMut()
    value.* = 1 + handed % 2
    state.changed.notifyAll()
    handed = handed + 1
  }
  while guard.get().* != 0 { state.changed.wait(&mut guard) }
  return ()
}

effect fn program() -> i32 ! OutOfMemoryError | SpawnError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let turn = run Mutex<i32>.make(0) |> Effect.provideMut<Allocator>(&mut allocator)
  let changed = run Condition.make() |> Effect.provideMut<Allocator>(&mut allocator)
  let shared = run Arc<Shared>.make(Shared { turn: move turn, changed: move changed }) |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run spawnWorker(&shared, 1) |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run spawnWorker(&shared, 2) |> Effect.provideMut<Allocator>(&mut allocator)
  let state = shared.get()
  drive(state)
  let joined = first.join() + second.join()
  let mut guard = state.turn.lock()
  // Nobody notifies, so the bounded wait times out with the lock held again.
  let mut timedOut = 0
  if !state.changed.waitTimeout(&mut guard, 1000000) { timedOut = 1 }
  let value = guard.getMut()
  value.* = 39
  return guard.get().* + joined * timedOut
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  return 1
}

pub fn main() -> i32 {
  return run Effect.catchAll(program(), failed)
}
