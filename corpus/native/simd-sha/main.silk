import silk.arch.aarch64
import silk.arch.x86
import silk.cpu { CpuFeatures }
import silk.simd.u32x4
import silk.u32

// FIPS 180-4: the SHA-256 round constants, four to a vector.
fn roundConstants() -> [simd<u32, 4>; 16] {
  return [
    u32x4.fromArray([0x428a2f98, 0x71374491, 0xb5c0fbcf, 0xe9b5dba5]),
    u32x4.fromArray([0x3956c25b, 0x59f111f1, 0x923f82a4, 0xab1c5ed5]),
    u32x4.fromArray([0xd807aa98, 0x12835b01, 0x243185be, 0x550c7dc3]),
    u32x4.fromArray([0x72be5d74, 0x80deb1fe, 0x9bdc06a7, 0xc19bf174]),
    u32x4.fromArray([0xe49b69c1, 0xefbe4786, 0x0fc19dc6, 0x240ca1cc]),
    u32x4.fromArray([0x2de92c6f, 0x4a7484aa, 0x5cb0a9dc, 0x76f988da]),
    u32x4.fromArray([0x983e5152, 0xa831c66d, 0xb00327c8, 0xbf597fc7]),
    u32x4.fromArray([0xc6e00bf3, 0xd5a79147, 0x06ca6351, 0x14292967]),
    u32x4.fromArray([0x27b70a85, 0x2e1b2138, 0x4d2c6dfc, 0x53380d13]),
    u32x4.fromArray([0x650a7354, 0x766a0abb, 0x81c2c92e, 0x92722c85]),
    u32x4.fromArray([0xa2bfe8a1, 0xa81a664b, 0xc24b8b70, 0xc76c51a3]),
    u32x4.fromArray([0xd192e819, 0xd6990624, 0xf40e3585, 0x106aa070]),
    u32x4.fromArray([0x19a4c116, 0x1e376c08, 0x2748774c, 0x34b0bcb5]),
    u32x4.fromArray([0x391c0cb3, 0x4ed8aa4a, 0x5b9cca4f, 0x682e6ff3]),
    u32x4.fromArray([0x748f82ee, 0x78a5636f, 0x84c87814, 0x8cc70208]),
    u32x4.fromArray([0x90befffa, 0xa4506ceb, 0xbef9a3f7, 0xc67178f2]),
  ]
}

// The one padded block of the message "abc", as big-endian words.
fn message() -> [simd<u32, 4>; 4] {
  return [
    u32x4.fromArray([0x61626380, 0, 0, 0]),
    u32x4.splat(0),
    u32x4.splat(0),
    u32x4.fromArray([0, 0, 0, 0x18]),
  ]
}

fn initial() -> [u32; 8] {
  return [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]
}

fn expected() -> [u32; 8] {
  return [0xba7816bf, 0x8f01cfea, 0x414140de, 0x5dae2223, 0xb00361a3, 0x96177a9c, 0xb410ff61, 0xf20015ad]
}

// The x86 flow: A, B, E and F in one vector and C, D, G and H in the other, two rounds per
// `sha256rnds2`.
fn digestX86(block: &[simd<u32, 4>; 4], constants: &[simd<u32, 4>; 16]) -> [u32; 8] {
  let h = initial()
  let mut abef = u32x4.fromArray([h[5], h[4], h[1], h[0]])
  let mut cdgh = u32x4.fromArray([h[7], h[6], h[3], h[2]])
  let mut schedule = [block[0], block[1], block[2], block[3], u32x4.splat(0), u32x4.splat(0), u32x4.splat(0), u32x4.splat(0), u32x4.splat(0), u32x4.splat(0), u32x4.splat(0), u32x4.splat(0), u32x4.splat(0), u32x4.splat(0), u32x4.splat(0), u32x4.splat(0)]
  let mut group: usize = 0
  while group < 16 {
    if group >= 4 {
      let partial = x86.sha256Message1(schedule[group - 4], schedule[group - 3])
      let aligned = u32x4.shuffle(schedule[group - 2], schedule[group - 1], [1, 2, 3, 4])
      schedule[group] = x86.sha256Message2(u32x4.wrappingAdd(partial, aligned), schedule[group - 1])
    }
    let wk = u32x4.wrappingAdd(schedule[group], constants[group])
    let next = x86.sha256Rounds2(cdgh, abef, wk)
    cdgh = abef
    abef = next
    let upper = u32x4.shuffle(wk, wk, [2, 3, 0, 1])
    let after = x86.sha256Rounds2(cdgh, abef, upper)
    cdgh = abef
    abef = after
    group = group + 1
  }
  let s = u32x4.toArray(abef)
  let t = u32x4.toArray(cdgh)
  let rounds = [s[3], s[2], t[3], t[2], s[1], s[0], t[1], t[0]]
  return add(h, rounds)
}

// The AArch64 flow: A to D and E to H in lane order, four rounds per `sha256h` and `sha256h2`.
fn digestAarch64(block: &[simd<u32, 4>; 4], constants: &[simd<u32, 4>; 16]) -> [u32; 8] {
  let h = initial()
  let mut abcd = u32x4.fromArray([h[0], h[1], h[2], h[3]])
  let mut efgh = u32x4.fromArray([h[4], h[5], h[6], h[7]])
  let mut schedule = [block[0], block[1], block[2], block[3], u32x4.splat(0), u32x4.splat(0), u32x4.splat(0), u32x4.splat(0), u32x4.splat(0), u32x4.splat(0), u32x4.splat(0), u32x4.splat(0), u32x4.splat(0), u32x4.splat(0), u32x4.splat(0), u32x4.splat(0)]
  let mut group: usize = 0
  while group < 16 {
    if group >= 4 {
      let partial = aarch64.sha256ScheduleUpdate0(schedule[group - 4], schedule[group - 3])
      schedule[group] = aarch64.sha256ScheduleUpdate1(partial, schedule[group - 2], schedule[group - 1])
    }
    let wk = u32x4.wrappingAdd(schedule[group], constants[group])
    let next = aarch64.sha256Hash(abcd, efgh, wk)
    efgh = aarch64.sha256Hash2(efgh, abcd, wk)
    abcd = next
    group = group + 1
  }
  let s = u32x4.toArray(abcd)
  let t = u32x4.toArray(efgh)
  return add(h, [s[0], s[1], s[2], s[3], t[0], t[1], t[2], t[3]])
}

fn add(left: [u32; 8], right: [u32; 8]) -> [u32; 8] {
  let mut result = left
  let mut at: usize = 0
  while at < 8 {
    result[at] = u32.wrappingAdd(left[at], right[at])
    at = at + 1
  }
  return result
}

fn same(left: [u32; 8], right: [u32; 8]) -> bool {
  let mut at: usize = 0
  while at < 8 {
    if left[at] != right[at] { return false }
    at = at + 1
  }
  return true
}

static if Intrinsic.targetArchitecture() == "x86_64" {
  // The instructions themselves, for a machine that has them.
  @features("sha")
  unsafe fn roundsSha(cdgh: simd<u32, 4>, abef: simd<u32, 4>, wk: simd<u32, 4>) -> simd<u32, 4> {
    return Intrinsic.x86Sha256Rounds2<simd<u32, 4>>(cdgh, abef, wk)
  }

  @features("sha")
  unsafe fn scheduleSha(left: simd<u32, 4>, right: simd<u32, 4>) -> simd<u32, 4> {
    return Intrinsic.x86Sha256Message2<simd<u32, 4>>(Intrinsic.x86Sha256Message1<simd<u32, 4>>(left, right), right)
  }
}

pub fn main() -> i32 {
  let block = message()
  let constants = roundConstants()
  if !same(digestX86(&block, &constants), expected()) { return 1 }
  if !same(digestAarch64(&block, &constants), expected()) { return 2 }
  static if Intrinsic.targetArchitecture() == "x86_64" {
    let machine = CpuFeatures.detect()
    let a = constants[0]
    let b = constants[1]
    let c = constants[2]
    if CpuFeatures.has(&machine, "sha") && unsafe roundsSha(a, b, c) != x86.sha256Rounds2(a, b, c) { return 3 }
    if CpuFeatures.has(&machine, "sha") && unsafe scheduleSha(a, b) != x86.sha256Message2(x86.sha256Message1(a, b), b) { return 4 }
  }
  return 0
}
