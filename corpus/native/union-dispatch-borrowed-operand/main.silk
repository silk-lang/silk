import silk.core.ownership { Drop }
import silk.mem.pointer { Pointer }
import silk.core.effect { Effect }
struct Bonus { v: i32, drops: *mut i32 }
impl Drop for Bonus {
  fn drop(self: &mut Bonus) -> () { unsafe { Pointer.write(self.drops, Pointer.read(self.drops) + 1) } }
}
struct Refused {}
interface Score {
  fn score(self: &Self, bonus: Bonus) -> i32
  effect fn check(self: &Self, bonus: Bonus) -> i32 ! Refused
}
struct A { v: i32 }
struct B { w: i32 }
impl Score for A {
  fn score(self: &A, bonus: &Bonus) -> i32 { return self.v + bonus.v }
  effect fn check(self: &A, bonus: &Bonus) -> i32 ! Refused {
    if bonus.v < 0 { fail Refused {} }
    return self.v
  }
}
impl Score for B {
  fn score(self: &B, bonus: Bonus) -> i32 { return self.w + bonus.v }
  effect fn check(self: &B, bonus: Bonus) -> i32 ! Refused { return self.w }
}
fn pick(flag: bool) -> A | B {
  if flag { return A { v: 10 } }
  return B { w: 20 }
}
effect fn refused(error: Refused) -> i32 { return -1 }
pub fn main() -> i32 {
  let mut drops = 0
  let counter = Pointer.fromMutRef<i32>(&mut drops)
  let a = pick(true)
  let b = pick(false)
  let first = a.score(Bonus { v: 1, drops: counter })
  let second = b.score(Bonus { v: 11, drops: counter })
  if drops != 2 { return 100 + drops }
  let checked = run Effect.catchAll(a.check(Bonus { v: 1, drops: counter }), refused)
  let failed = run Effect.catchAll(a.check(Bonus { v: -1, drops: counter }), refused)
  if drops != 4 { return 110 + drops }
  if checked != 10 || failed != -1 { return 120 }
  return first + second
}
