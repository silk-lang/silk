import silk.core.option { Option }
import silk.core.effect { Effect }
import silk.system.monotonic_clock { MonotonicClock }
import silk.system.monotonic_clock_native { OsMonotonicClock }
import silk.core.ownership { Copy }
interface Stream<A, E, ?R> { effect fn take(self: &mut Self) -> Option<A> ! E ? R }
pub struct SliceStream<'s, A> { slice: &'s [A], index: usize }
impl<'s, A> SliceStream<'s, A> {
  pub fn make(slice: &'s [A]) -> SliceStream<'s, A> { return SliceStream<'s, A> { slice: slice, index: 0 } }
}
impl<'s, A: Copy> Stream<A, never ? never> for SliceStream<'s, A> {
  effect fn take(self: &mut Self) -> Option<A> {
    if self.index >= self.slice.length { return Option<A>.none() }
    let i = self.index
    self.index = self.index + 1
    return Option.some(self.slice[i])
  }
}
effect fn consume() -> i32 ? &mut MonotonicClock {
  let mut stream = SliceStream.make(&[10, 20, 12])
  let mut result = 0
  let mut count = 0
  while true {
    run Effect.sleep(1ns)
    let taken = run stream.take()
    if let Option.Some { value } = move taken {
      result = result + value
      count = count + 1
    } else { break }
  }
  if count != 3 { return 0 }
  return result
}
pub fn main() -> i32 {
  let mut clock = OsMonotonicClock.make()
  return run consume() |> Effect.provideMut(&mut clock)
}