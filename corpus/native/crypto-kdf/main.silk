fn scryptOdd() -> [u8; 37] { return [7, 29, 190, 147, 4, 228, 40, 209, 249, 58, 12, 65, 4, 186, 31, 6, 138, 162, 153, 222, 125, 232, 90, 154, 197, 61, 235, 29, 75, 148, 160, 47, 124, 237, 13, 120, 2] }

effect fn program() -> i32 ! OutOfMemoryError | ScryptError ? &mut Allocator {
  if hmacSweep<Md5>(&hmacDigestMd5()) == false { return 1 }
  if hmacSweep<Sha1>(&hmacDigestSha1()) == false { return 2 }
  if hmacSweep<Sha224>(&hmacDigestSha224()) == false { return 3 }
  if hmacSweep<Sha256>(&hmacDigestSha256()) == false { return 4 }
  if hmacSweep<Sha384>(&hmacDigestSha384()) == false { return 5 }
  if hmacSweep<Sha512>(&hmacDigestSha512()) == false { return 6 }
  if hmacSweep<Sha512_224>(&hmacDigestSha512_224()) == false { return 7 }
  if hmacSweep<Sha512_256>(&hmacDigestSha512_256()) == false { return 8 }
  if hmacSweep<Sha3_224>(&hmacDigestSha3_224()) == false { return 9 }
  if hmacSweep<Sha3_256>(&hmacDigestSha3_256()) == false { return 10 }
  if hmacSweep<Sha3_384>(&hmacDigestSha3_384()) == false { return 11 }
  if hmacSweep<Sha3_512>(&hmacDigestSha3_512()) == false { return 12 }
  if hmacSweep<Blake2b512>(&hmacDigestBlake2b512()) == false { return 13 }
  if pbkdf2Check<Md5>(&pbkdf2Md5()) == false { return 14 }
  if pbkdf2Check<Sha1>(&pbkdf2Sha1()) == false { return 15 }
  if pbkdf2Check<Sha224>(&pbkdf2Sha224()) == false { return 16 }
  if pbkdf2Check<Sha256>(&pbkdf2Sha256()) == false { return 17 }
  if pbkdf2Check<Sha384>(&pbkdf2Sha384()) == false { return 18 }
  if pbkdf2Check<Sha512>(&pbkdf2Sha512()) == false { return 19 }
  if pbkdf2Check<Sha512_224>(&pbkdf2Sha512_224()) == false { return 20 }
  if pbkdf2Check<Sha512_256>(&pbkdf2Sha512_256()) == false { return 21 }
  if pbkdf2Check<Sha3_224>(&pbkdf2Sha3_224()) == false { return 22 }
  if pbkdf2Check<Sha3_256>(&pbkdf2Sha3_256()) == false { return 23 }
  if pbkdf2Check<Sha3_384>(&pbkdf2Sha3_384()) == false { return 24 }
  if pbkdf2Check<Sha3_512>(&pbkdf2Sha3_512()) == false { return 25 }
  if pbkdf2Check<Blake2b512>(&pbkdf2Blake2b512()) == false { return 26 }
  if rfc6070() == false { return 27 }
  if pbkdf2Errors() == false { return 28 }
  // HmacSha256 is Hmac<Sha256> with an array tag.
  let fixed = HmacSha256.authenticate(b"key", b"The quick brown fox jumps over the lazy dog")
  if fixed[0] != 0xf7 || fixed[31] != 0xd8 { return 29 }
  if hkdfChecks() == false { return 30 }
  let scrypted = run scryptChecks()
  if scrypted != 0 { return 50 + scrypted }
  return 42
}

pub effect fn main() -> i32 ! OutOfMemoryError | ScryptError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run program() |> Effect.provideMut<Allocator>(&mut allocator)
}
