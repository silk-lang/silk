// FFI-012: a generic export's address at written type arguments is the C thunk of that
// instantiation. Concrete code and generic code that name one instantiation share its thunk.
interface Scale {
  fn make() -> Self
  fn factor(self: &Self) -> i32
}
struct Two {}
struct Three {}
impl Scale for Two {
  fn make() -> Two { return Two {} }
  fn factor(self: &Two) -> i32 { return 2 }
}
impl Scale for Three {
  fn make() -> Three { return Three {} }
  fn factor(self: &Three) -> i32 { return 3 }
}
export "C" fn scaled<S: Scale>(value: i32) -> i32 {
  let scale: S = Scale.make()
  return value * Scale.factor(&scale)
}
// Only `main` names a concrete type: the instantiation is found when `through` is specialized.
fn through<S: Scale>(value: i32) -> i32 {
  let entry: extern "C" fn(i32) -> i32 = scaled<S>
  return unsafe entry(value)
}
pub fn main() -> i32 {
  let two: extern "C" fn(i32) -> i32 = scaled<Two>
  let three: extern "C" fn(i32) -> i32 = scaled<Three>
  if unsafe two(5) != 10 { return 1 }
  if unsafe three(5) != 15 { return 2 }
  if through<Two>(7) != 14 { return 3 }
  if through<Three>(7) != 21 { return 4 }
  // Silk code calls a generic export as the generic function it is.
  if scaled<Two>(21) != 42 { return 5 }
  return 42
}
