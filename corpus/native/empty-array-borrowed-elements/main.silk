// An empty array literal is accepted for any element type of length zero, including elements
// whose annotation elides a lifetime.
fn count(values: &[string]) -> usize { return values.length }

pub fn main() -> i32 {
  let none: [&[u8]; 0] = []
  let words: [string; 0] = []
  let numbers: [i32; 0] = []
  if none.length != 0 || numbers.length != 0 { return 1 }
  if count(&words) != 0 { return 2 }
  return 42
}
