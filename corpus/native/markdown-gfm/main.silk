// Safe defaults, independent policy switches, subtree output, writer parity, and hostile-input results.
import silk.markdown.document {
  MarkdownDocument,
  MarkdownNodeId,
  MarkdownNodeKind,
  MarkdownOptions,
  MarkdownAlignment,
  MarkdownTaskState,
  MarkdownFrontmatterKind,
  MarkdownAlertKind
}
import silk.markdown.html { MarkdownHtml, HtmlOptions }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.num.usize
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }

struct CheckFailed {
  code: i32
}

effect fn expect(ok: bool, code: i32) -> ()
  ! CheckFailed {
  if !ok {
    fail CheckFailed { code: code }
  }
}

fn index(value: Option<MarkdownNodeId>) -> usize {
  return match value {
    Option<MarkdownNodeId>.Some { value: id } => id.index
    _ => usize.MAX
  }
}

fn find(doc: &MarkdownDocument<'_>, kind: MarkdownNodeKind, occurrence: usize) -> MarkdownNodeId {
  let nodes = MarkdownDocument.nodes(doc)
  let mut i: usize = 0
  let mut count: usize = 0
  while i < nodes.length {
    if nodes[i].kind == kind {
      if count == occurrence {
        return MarkdownNodeId { index: i }
      }
      count = count + 1
    }
    i = i + 1
  }
  return MarkdownNodeId { index: usize.MAX }
}

effect fn invariants(doc: &MarkdownDocument<'_>, source: string) -> ()
  ! CheckFailed {
  let nodes = MarkdownDocument.nodes(doc)
  let mut i: usize = 0
  while i < nodes.length {
    let id = MarkdownNodeId { index: i }
    let span = MarkdownDocument.span(doc, id)
    run expect(span.start <= span.end && span.end <= String.byteLength(source), 200)
    if i > 0 {
      let parent = index(MarkdownDocument.parent(doc, id))
      run expect(parent < i, 201)
      let parentSpan = MarkdownDocument.span(doc, MarkdownNodeId { index: parent })
      run expect(parentSpan.start <= span.start && span.end <= parentSpan.end, 202)
    }
    let mut child = index(MarkdownDocument.firstChild(doc, id))
    let mut previous = usize.MAX
    let mut visits: usize = 0
    while child != usize.MAX {
      run expect(child > i && child < nodes.length && visits < nodes.length, 203)
      let key = MarkdownNodeId { index: child }
      run expect(index(MarkdownDocument.parent(doc, key)) == i, 204)
      run expect(index(MarkdownDocument.previousSibling(doc, key)) == previous, 205)
      previous = child
      child = index(MarkdownDocument.nextSibling(doc, key))
      visits = visits + 1
    }
    run expect(previous == index(MarkdownDocument.lastChild(doc, id)), 206)
    i = i + 1
  }
}

effect fn rendered(source: string, expected: string, options: &MarkdownOptions, code: i32) -> ()
  ! CheckFailed | OutOfMemoryError
  ? &mut Allocator {
  let doc = run MarkdownDocument.parseWithOptions(source, options)
  let mut policy = HtmlOptions.make()
  policy.rawHtml = true
  policy.unsafeLinks = true
  let html = run MarkdownHtml.renderOwnedWithOptions(&doc, &policy)
  run expect(String.view(&html) == expected, code)
  run invariants(&doc, source)
}

effect fn checks() -> ()
  ! CheckFailed | OutOfMemoryError
  ? &mut Allocator {
  let gfm = MarkdownOptions.gfm()
  let mut all = gfm
  all.footnotes = true
  all.frontmatter = true
  all.alerts = true
  let plain = MarkdownOptions.make()
  run expect(
    !plain.tables && !plain.strikethrough && !plain.taskLists && !plain.autolinkLiterals
      && !plain.footnotes
      && !plain.frontmatter
      && !plain.alerts
      && !gfm.footnotes
      && !gfm.frontmatter
      && !gfm.alerts,
    55,
  )
  run rendered(
    "| A | B | C | D |\n| - | :- | :-: | -: |\n| ~~a~~ | b | `c\\|d` | d |\n| short |\n| 1 | 2 | 3 | 4 | 5 |\n",
    "<table>\n<thead>\n<tr>\n<th>A</th>\n<th align=\"left\">B</th>\n<th align=\"center\">C</th>\n<th align=\"right\">D</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td><del>a</del></td>\n<td align=\"left\">b</td>\n<td align=\"center\"><code>c|d</code></td>\n<td align=\"right\">d</td>\n</tr>\n<tr>\n<td>short</td>\n<td align=\"left\"></td>\n<td align=\"center\"></td>\n<td align=\"right\"></td>\n</tr>\n<tr>\n<td>1</td>\n<td align=\"left\">2</td>\n<td align=\"center\">3</td>\n<td align=\"right\">4</td>\n</tr>\n</tbody>\n</table>\n",
    &gfm,
    1,
  )
  run rendered(
    "preceding\n|a|b|\n|-|-|\nx|y\n\nend\n",
    "<p>preceding</p>\n<table>\n<thead>\n<tr>\n<th>a</th>\n<th>b</th>\n</tr>\n</thead>\n<tbody>\n<tr>\n<td>x</td>\n<td>y</td>\n</tr>\n</tbody>\n</table>\n<p>end</p>\n",
    &gfm,
    2,
  )
  run rendered("| a | b |\n| - |\n", "<p>| a | b |\n| - |</p>\n", &gfm, 3)
  run rendered(
    "- a | b\n  - | -\n  x | y\n",
    "<ul>\n<li>a | b\n<ul>\n<li>| -\nx | y</li>\n</ul>\n</li>\n</ul>\n",
    &gfm,
    4,
  )
  run rendered(
    "> a | b\n> - | -\n> x | y\n>\n> end\n",
    "<blockquote>\n<p>a | b</p>\n<ul>\n<li>| -\nx | y</li>\n</ul>\n<p>end</p>\n</blockquote>\n",
    &gfm,
    5,
  )
  run rendered(
    "a | b\n- | -\n# end\n",
    "<p>a | b</p>\n<ul>\n<li>| -</li>\n</ul>\n<h1>end</h1>\n",
    &gfm,
    6,
  )
  run rendered(
    "a | b\n- | -\n> quote\n",
    "<p>a | b</p>\n<ul>\n<li>| -</li>\n</ul>\n<blockquote>\n<p>quote</p>\n</blockquote>\n",
    &gfm,
    7,
  )
  run rendered(
    "a | b\n- | -\n\nbody\n",
    "<p>a | b</p>\n<ul>\n<li>| -</li>\n</ul>\n<p>body</p>\n",
    &gfm,
    8,
  )
  run rendered("a | b\n- | -\n", "<p>a | b</p>\n<ul>\n<li>| -</li>\n</ul>\n", &gfm, 9)
  run rendered(
    "a | b\n- | -\nx | y | z\n",
    "<p>a | b</p>\n<ul>\n<li>| -\nx | y | z</li>\n</ul>\n",
    &gfm,
    10,
  )
  run rendered(
    "~one~ ~~two~~ ~~~three~~~ ~a~~ ~~b~ a~intra~word ~~a *b*~~\n",
    "<p><del>one</del> <del>two</del> ~~~three~~~ ~a~~ ~~b~ a<del>intra</del>word <del>a <em>b</em></del></p>\n",
    &gfm,
    11,
  )
  run rendered("~a *b~ c* ~~a~b~~\n", "<p><del>a *b</del> c* <del>a~b</del></p>\n", &gfm, 12)
  run rendered(
    "- [ ] unchecked\n- [x] checked\n  - [X] nested\n- [] none\n- [ ]\n",
    "<ul>\n<li><input type=\"checkbox\" disabled=\"\" /> unchecked</li>\n<li><input type=\"checkbox\" checked=\"\" disabled=\"\" /> checked\n<ul>\n<li><input type=\"checkbox\" checked=\"\" disabled=\"\" /> nested</li>\n</ul>\n</li>\n<li>[] none</li>\n<li>[ ]</li>\n</ul>\n",
    &gfm,
    13,
  )
  run rendered(
    "- [x] first\n\n  second\n\n  - nested\n",
    "<ul>\n<li><input type=\"checkbox\" checked=\"\" disabled=\"\" /> \n<p>first</p>\n<p>second</p>\n<ul>\n<li>nested</li>\n</ul>\n</li>\n</ul>\n",
    &gfm,
    14,
  )
  run rendered(
    "www.a.com, (https://a.com/p(q))) ftp://a.com. mailto:a@b.com xmpp:a@b.com/r\n",
    "<p><a href=\"http://www.a.com\">www.a.com</a>, (<a href=\"https://a.com/p(q)\">https://a.com/p(q)</a>)) <a href=\"ftp://a.com\">ftp://a.com</a>. <a href=\"mailto:a@b.com\">mailto:a@b.com</a> <a href=\"xmpp:a@b.com/r\">xmpp:a@b.com/r</a></p>\n",
    &gfm,
    15,
  )
  run rendered(
    "*www.a.com* **http://a.com** [www.a.com](u) `www.a.com` [a@b.com](u)\n",
    "<p><em><a href=\"http://www.a.com\">www.a.com</a></em> <strong><a href=\"http://a.com\">http://a.com</a></strong> <a href=\"u\">www.a.com</a> <code>www.a.com</code> <a href=\"u\">a@b.com</a></p>\n",
    &gfm,
    16,
  )
  run rendered(
    "www.a.com/?x=1&y=2 www.a.com/&name; www.a.com/x<y\n",
    "<p><a href=\"http://www.a.com/?x=1&amp;y=2\">www.a.com/?x=1&amp;y=2</a> <a href=\"http://www.a.com/\">www.a.com/</a>&amp;name; <a href=\"http://www.a.com/x\">www.a.com/x</a>&lt;y</p>\n",
    &gfm,
    17,
  )
  run rendered(
    "www.a_b.com www.a.b_c www.a_b.c.d http://localhost http://a_b.c\n",
    "<p>www.a_b.com www.a.b_c <a href=\"http://www.a_b.c.d\">www.a_b.c.d</a> <a href=\"http://localhost\">http://localhost</a> http://a_b.c</p>\n",
    &gfm,
    18,
  )
  run rendered(
    "a.b-c_d@a.b a@b.c. a@b.c- a@b.c_ a@mail+x.com a+x@mail.com\n",
    "<p><a href=\"mailto:a.b-c_d@a.b\">a.b-c_d@a.b</a> <a href=\"mailto:a@b.c\">a@b.c</a>. a@b.c- a@b.c_ a@mail+x.com <a href=\"mailto:a+x@mail.com\">a+x@mail.com</a></p>\n",
    &gfm,
    19,
  )
  run rendered(
    "&#97;@b.com \\_a@b.com a@a@a.b a-mailto:a@b.c __xmpp:a@b.c/r\n",
    "<p><a href=\"mailto:a@b.com\">a@b.com</a> <a href=\"mailto:_a@b.com\">_a@b.com</a> a@<a href=\"mailto:a@a.b\">a@a.b</a> <a href=\"a-mailto:a@b.c\">a-mailto:a@b.c</a> <a href=\"__xmpp:a@b.c/r\">__xmpp:a@b.c/r</a></p>\n",
    &gfm,
    20,
  )
  run rendered(
    "escaped \\``` b `` \\~~~ ~~x~~\n",
    "<p>escaped `<code>b</code> ~~~ <del>x</del></p>\n",
    &gfm,
    21,
  )
  run rendered("a|b\n-|-\nx|y\n", "<p>a|b\n-|-\nx|y</p>\n", &plain, 22)
  run rendered("~~x~~ www.a.com\n", "<p>~~x~~ www.a.com</p>\n", &plain, 23)
  run rendered("- [x] x\n", "<ul>\n<li>[x] x</li>\n</ul>\n", &plain, 24)
  run rendered("x[^a]\n\n[^a]: body\n", "<p>x<a href=\"body\">^a</a></p>\n", &plain, 25)
  run rendered("---\na: b\n---\n", "<hr />\n<h2>a: b</h2>\n", &plain, 26)
  run rendered(
    "> [!NOTE]\n> text\n",
    "<blockquote>\n<p>[!NOTE]\ntext</p>\n</blockquote>\n",
    &plain,
    27,
  )
  run rendered(
    "x[^a] x[^a] x[^b] [^missing]\n\n[^b]: Second\n[^a]: First\n[^unused]: hidden\n",
    "<p>x<sup class=\"footnote-ref\"><a href=\"#fn-a\" id=\"fnref-a\" data-footnote-ref>1</a></sup> x<sup class=\"footnote-ref\"><a href=\"#fn-a\" id=\"fnref-a-2\" data-footnote-ref>1</a></sup> x<sup class=\"footnote-ref\"><a href=\"#fn-b\" id=\"fnref-b\" data-footnote-ref>2</a></sup> [^missing]</p>\n<section class=\"footnotes\" data-footnotes>\n<ol>\n<li id=\"fn-a\">\n<p>First <a href=\"#fnref-a\" class=\"footnote-backref\" data-footnote-backref data-footnote-backref-idx=\"1\" aria-label=\"Back to reference 1\">↩</a> <a href=\"#fnref-a-2\" class=\"footnote-backref\" data-footnote-backref data-footnote-backref-idx=\"1-2\" aria-label=\"Back to reference 1-2\">↩<sup class=\"footnote-ref\">2</sup></a></p>\n</li>\n<li id=\"fn-b\">\n<p>Second <a href=\"#fnref-b\" class=\"footnote-backref\" data-footnote-backref data-footnote-backref-idx=\"2\" aria-label=\"Back to reference 2\">↩</a></p>\n</li>\n</ol>\n</section>\n",
    &all,
    28,
  )
  run rendered(
    "x[^a]\n\n[^a]:\n        code <b>\n",
    "<p>x<sup class=\"footnote-ref\"><a href=\"#fn-a\" id=\"fnref-a\" data-footnote-ref>1</a></sup></p>\n<section class=\"footnotes\" data-footnotes>\n<ol>\n<li id=\"fn-a\">\n<pre><code>code &lt;b&gt;\n</code></pre>\n<a href=\"#fnref-a\" class=\"footnote-backref\" data-footnote-backref data-footnote-backref-idx=\"1\" aria-label=\"Back to reference 1\">↩</a>\n</li>\n</ol>\n</section>\n",
    &all,
    29,
  )
  run rendered(
    "x[^a]\n\n[^a]: self[^a] other[^b]\n[^b]: B\n",
    "<p>x<sup class=\"footnote-ref\"><a href=\"#fn-a\" id=\"fnref-a\" data-footnote-ref>1</a></sup></p>\n<section class=\"footnotes\" data-footnotes>\n<ol>\n<li id=\"fn-a\">\n<p>self<sup class=\"footnote-ref\"><a href=\"#fn-a\" id=\"fnref-a-2\" data-footnote-ref>1</a></sup> other<sup class=\"footnote-ref\"><a href=\"#fn-b\" id=\"fnref-b\" data-footnote-ref>2</a></sup> <a href=\"#fnref-a\" class=\"footnote-backref\" data-footnote-backref data-footnote-backref-idx=\"1\" aria-label=\"Back to reference 1\">↩</a> <a href=\"#fnref-a-2\" class=\"footnote-backref\" data-footnote-backref data-footnote-backref-idx=\"1-2\" aria-label=\"Back to reference 1-2\">↩<sup class=\"footnote-ref\">2</sup></a></p>\n</li>\n<li id=\"fn-b\">\n<p>B <a href=\"#fnref-b\" class=\"footnote-backref\" data-footnote-backref data-footnote-backref-idx=\"2\" aria-label=\"Back to reference 2\">↩</a></p>\n</li>\n</ol>\n</section>\n",
    &all,
    30,
  )
  run rendered(
    "[^a]: first\n[^a]: duplicate\n\nx[^a]\n",
    "<p>x<sup class=\"footnote-ref\"><a href=\"#fn-a\" id=\"fnref-a\" data-footnote-ref>1</a></sup></p>\n<section class=\"footnotes\" data-footnotes>\n<ol>\n<li id=\"fn-a\">\n<p>first <a href=\"#fnref-a\" class=\"footnote-backref\" data-footnote-backref data-footnote-backref-idx=\"1\" aria-label=\"Back to reference 1\">↩</a></p>\n</li>\n</ol>\n</section>\n",
    &all,
    31,
  )
  run rendered(
    "- x[^a]\n\n[^a]: para\n\n    > quote\n\n    tail\n",
    "<ul>\n<li>x<sup class=\"footnote-ref\"><a href=\"#fn-a\" id=\"fnref-a\" data-footnote-ref>1</a></sup></li>\n</ul>\n<section class=\"footnotes\" data-footnotes>\n<ol>\n<li id=\"fn-a\">\n<p>para</p>\n<blockquote>\n<p>quote</p>\n</blockquote>\n<p>tail <a href=\"#fnref-a\" class=\"footnote-backref\" data-footnote-backref data-footnote-backref-idx=\"1\" aria-label=\"Back to reference 1\">↩</a></p>\n</li>\n</ol>\n</section>\n",
    &all,
    32,
  )
  run rendered(
    "![^a]\n\n[^a]: note\n",
    "<p>!<sup class=\"footnote-ref\"><a href=\"#fn-a\" id=\"fnref-a\" data-footnote-ref>1</a></sup></p>\n<section class=\"footnotes\" data-footnotes>\n<ol>\n<li id=\"fn-a\">\n<p>note <a href=\"#fnref-a\" class=\"footnote-backref\" data-footnote-backref data-footnote-backref-idx=\"1\" aria-label=\"Back to reference 1\">↩</a></p>\n</li>\n</ol>\n</section>\n",
    &all,
    33,
  )

  run rendered(
    "a\n:-\n",
    "<table>\n<thead>\n<tr>\n<th align=\"left\">a</th>\n</tr>\n</thead>\n</table>\n",
    &gfm,
    61,
  )
  run rendered(
    "a\n-:\n",
    "<table>\n<thead>\n<tr>\n<th align=\"right\">a</th>\n</tr>\n</thead>\n</table>\n",
    &gfm,
    62,
  )
  run rendered(
    "a\n:-:\n",
    "<table>\n<thead>\n<tr>\n<th align=\"center\">a</th>\n</tr>\n</thead>\n</table>\n",
    &gfm,
    63,
  )
  run rendered(
    "a|b\n-|-\n|\n",
    "<table>\n<thead>\n<tr>\n<th>a</th>\n<th>b</th>\n</tr>\n</thead>\n</table>\n<p>|</p>\n",
    &gfm,
    64,
  )
  run rendered("|\n|-|\n", "<p>|\n|-|</p>\n", &gfm, 65)
  run rendered(
    "x[^b] x[^a]\n\n[^a]: self[^a]\n[^unused]: ref[^b]\n[^b]: self[^b]\n",
    "<p>x<sup class=\"footnote-ref\"><a href=\"#fn-b\" id=\"fnref-b\" data-footnote-ref>1</a></sup> x<sup class=\"footnote-ref\"><a href=\"#fn-a\" id=\"fnref-a\" data-footnote-ref>2</a></sup></p>\n<section class=\"footnotes\" data-footnotes>\n<ol>\n<li id=\"fn-b\">\n<p>self<sup class=\"footnote-ref\"><a href=\"#fn-b\" id=\"fnref-b-3\" data-footnote-ref>1</a></sup> <a href=\"#fnref-b\" class=\"footnote-backref\" data-footnote-backref data-footnote-backref-idx=\"1\" aria-label=\"Back to reference 1\">↩</a> <a href=\"#fnref-b-2\" class=\"footnote-backref\" data-footnote-backref data-footnote-backref-idx=\"1-2\" aria-label=\"Back to reference 1-2\">↩<sup class=\"footnote-ref\">2</sup></a> <a href=\"#fnref-b-3\" class=\"footnote-backref\" data-footnote-backref data-footnote-backref-idx=\"1-3\" aria-label=\"Back to reference 1-3\">↩<sup class=\"footnote-ref\">3</sup></a></p>\n</li>\n<li id=\"fn-a\">\n<p>self<sup class=\"footnote-ref\"><a href=\"#fn-a\" id=\"fnref-a-2\" data-footnote-ref>2</a></sup> <a href=\"#fnref-a\" class=\"footnote-backref\" data-footnote-backref data-footnote-backref-idx=\"2\" aria-label=\"Back to reference 2\">↩</a> <a href=\"#fnref-a-2\" class=\"footnote-backref\" data-footnote-backref data-footnote-backref-idx=\"2-2\" aria-label=\"Back to reference 2-2\">↩<sup class=\"footnote-ref\">2</sup></a></p>\n</li>\n</ol>\n</section>\n",
    &all,
    66,
  )
  let source = "> - A | B\n>   :- | -:\n>   ~~x~~ | `a\\|b`\n\n- [X] done\n\nref[^Straße] [^STRASSE]\n\n[^straße]: text\n"
  let doc = run MarkdownDocument.parseWithOptions(source, &all)
  run invariants(&doc, source)
  let table = find(&doc, MarkdownNodeKind.Table, 0)
  run expect(
    MarkdownDocument.tableColumns(&doc, table) == 2
      && MarkdownDocument.columnAlignment(&doc, table, 0) == MarkdownAlignment.Left
      && MarkdownDocument.columnAlignment(&doc, table, 1) == MarkdownAlignment.Right
      && MarkdownDocument.columnAlignment(&doc, table, 2) == MarkdownAlignment.None,
    56,
  )
  let row = find(&doc, MarkdownNodeKind.TableRow, 0)
  let cell = find(&doc, MarkdownNodeKind.TableCell, 0)
  let right = find(&doc, MarkdownNodeKind.TableCell, 1)
  run expect(MarkdownDocument.isTableHeader(&doc, row) && !MarkdownDocument.ordered(&doc, row), 40)
  run expect(
    MarkdownDocument.alignment(&doc, cell) == MarkdownAlignment.Left
      && MarkdownDocument.alignment(&doc, right) == MarkdownAlignment.Right,
    41,
  )
  run expect(
    MarkdownDocument.taskState(&doc, find(&doc, MarkdownNodeKind.ListItem, 1))
      == MarkdownTaskState.Checked,
    42,
  )
  let reference = find(&doc, MarkdownNodeKind.FootnoteReference, 0)
  let repeated = find(&doc, MarkdownNodeKind.FootnoteReference, 1)
  let definition = find(&doc, MarkdownNodeKind.FootnoteDefinition, 0)
  run expect(
    index(MarkdownDocument.footnoteDefinition(&doc, reference)) == definition.index
      && index(MarkdownDocument.footnoteDefinition(&doc, repeated)) == definition.index,
    43,
  )
  run expect(
    MarkdownDocument.footnoteLabel(&doc, reference) == "Straße"
      && MarkdownDocument.footnoteNumber(&doc, definition) == 1
      && MarkdownDocument.footnoteReferences(&doc, definition) == 2
      && MarkdownDocument.footnoteReferences(&doc, repeated) == 2,
    44,
  )
  let code = find(&doc, MarkdownNodeKind.Code, 0)
  let codeSpan = MarkdownDocument.span(&doc, code)
  run expect(
    String.slice(source, codeSpan.start, codeSpan.end - codeSpan.start) == "`a\\|b`"
      && MarkdownDocument.literal(&doc, code) == "a|b",
    45,
  )

  let metadataSource = "---\r\na: <b>\r\n---\r\n# Body\n"
  let metadata = run MarkdownDocument.parseWithOptions(metadataSource, &all)
  run invariants(&metadata, metadataSource)
  let frontmatter = find(&metadata, MarkdownNodeKind.Frontmatter, 0)
  run expect(
    index(MarkdownDocument.firstChild(&metadata, MarkdownDocument.root(&metadata)))
      == frontmatter.index
      && MarkdownDocument.frontmatterKind(&metadata, frontmatter) == MarkdownFrontmatterKind.Yaml
      && MarkdownDocument.frontmatterBody(&metadata, frontmatter) == "a: <b>\r\n",
    46,
  )
  let bodyPointer = Pointer.addressMany<u8>(
    Pointer.fromSlice<u8>(
      String.utf8Bytes(MarkdownDocument.frontmatterBody(&metadata, frontmatter)),
    ),
  )
  let sourcePointer = Pointer.addressMany<u8>(
    Pointer.fromSlice<u8>(String.utf8Bytes(String.slice(metadataSource, 5, 8))),
  )
  run expect(bodyPointer == sourcePointer, 57)
  run rendered("---\n---\n", "", &all, 58)
  run rendered(
    "> [!TIP]\n",
    "<div class=\"markdown-alert markdown-alert-tip\"><p class=\"markdown-alert-title\">Tip</p>\n</div>\n",
    &all,
    59,
  )
  let emailSource = "&#97;@b.&#99;"
  let email = run MarkdownDocument.parseWithOptions(emailSource, &gfm)
  run invariants(&email, emailSource)
  let emailSpan = MarkdownDocument.span(&email, find(&email, MarkdownNodeKind.Link, 0))
  run expect(
    String.slice(emailSource, emailSpan.start, emailSpan.end - emailSpan.start) == emailSource,
    60,
  )
  run rendered("+++\nname = 'x'\n+++\nbody\n", "<p>body</p>\n", &all, 47)
  run rendered("---\nname: x\n", "<hr />\n<p>name: x</p>\n", &all, 48)
  run rendered(" ---\nname: x\n---\n", "<hr />\n<h2>name: x</h2>\n", &all, 49)
  let alert = run MarkdownDocument.parseWithOptions("> [!wArNiNg]  \n> careful *now*\n", &all)
  run expect(
    MarkdownDocument.alertKind(&alert, find(&alert, MarkdownNodeKind.Alert, 0))
      == MarkdownAlertKind.Warning,
    50,
  )
  run rendered(
    "> [!NOTE]\n> words\n",
    "<div class=\"markdown-alert markdown-alert-note\"><p class=\"markdown-alert-title\">Note</p>\n<p>words</p>\n</div>\n",
    &all,
    51,
  )
  run rendered(
    "> [!note] extra\n> words\n",
    "<blockquote>\n<p>[!note] extra\nwords</p>\n</blockquote>\n",
    &all,
    52,
  )
  let safeSource = "| A |\n| - |\n| <i>x</i> [bad](javascript:evil) |\n\n- [x] <b>done</b>\n\n> [!TIP]\n> <i>tip</i>\n\nnote[^a]\n\n[^a]: [bad](data:x)\n"
  let safe = run MarkdownDocument.parseWithOptions(safeSource, &all)
  run invariants(&safe, safeSource)
  let safeHtml = run MarkdownHtml.renderOwned(&safe)
  run expect(
    String.contains(String.view(&safeHtml), "&lt;i&gt;x&lt;/i&gt;")
      && String.contains(String.view(&safeHtml), "href=\"\">bad")
      && !String.contains(String.view(&safeHtml), "href=\"javascript:")
      && !String.contains(String.view(&safeHtml), "href=\"data:"),
    53,
  )
  let invalid = MarkdownNodeId { index: usize.MAX }
  run expect(
    MarkdownDocument.alignment(&safe, invalid) == MarkdownAlignment.None
      && MarkdownDocument.taskState(&safe, invalid) == MarkdownTaskState.None
      && MarkdownDocument.frontmatterKind(&safe, invalid) == MarkdownFrontmatterKind.None
      && MarkdownDocument.alertKind(&safe, invalid) == MarkdownAlertKind.None
      && index(MarkdownDocument.footnoteDefinition(&safe, invalid)) == usize.MAX,
    54,
  )
}

effect fn failure(error: CheckFailed | OutOfMemoryError) -> i32 {
  return match move error {
    CheckFailed { code } => code
    OutOfMemoryError _ => 255
  }
}

pub effect fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(
    effect {
      run checks()
      return 0
    },
    failure,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
}
