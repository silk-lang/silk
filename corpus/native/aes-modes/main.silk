fn ctrSweepDigest() -> [u8; 32] { return [212, 36, 234, 95, 24, 191, 250, 221, 19, 42, 187, 161, 64, 130, 204, 33, 166, 232, 68, 255, 109, 186, 5, 78, 231, 112, 182, 146, 16, 90, 108, 178] }

pub fn main() -> i32 {
  if vector0() == false { return 1 }
  if vector1() == false { return 2 }
  if vector2() == false { return 3 }
  if vector3() == false { return 4 }
  if vector4() == false { return 5 }
  if vector5() == false { return 6 }
  if vector6() == false { return 7 }
  if vector7() == false { return 8 }
  if vector8() == false { return 9 }
  if paddingSweep() == false { return 10 }
  if ctrSweep() == false { return 11 }
  if ctrWrap() == false { return 12 }
  if rejections() == false { return 13 }
  return 42
}
