fn plaintext() -> [u8; 64] { return [107, 193, 190, 226, 46, 64, 159, 150, 233, 61, 126, 17, 115, 147, 23, 42, 174, 45, 138, 87, 30, 3, 172, 156, 158, 183, 111, 172, 69, 175, 142, 81, 48, 200, 28, 70, 163, 92, 228, 17, 229, 251, 193, 25, 26, 10, 82, 239, 246, 159, 36, 69, 223, 79, 155, 23, 173, 43, 65, 123, 230, 108, 55, 16] }
fn cbcSweepDigest() -> [u8; 32] { return [18, 118, 92, 99, 198, 117, 110, 39, 104, 235, 246, 227, 154, 22, 223, 55, 173, 34, 146, 182, 181, 41, 99, 146, 200, 168, 84, 190, 19, 148, 231, 17] }
