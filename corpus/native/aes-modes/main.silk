import silk.crypto.aes { Aes, AesCbc, AesCtr, AesEcb, AesError }
import silk.crypto.sha2 { Sha256 }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.num.u8
import silk.num.usize
import silk.num.i32

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut index: usize = 0
  while index < left.length {
    if left[index] != right[index] { return false }
    index = index + 1
  }
  return true
}

fn code(error: AesError) -> i32 {
  return match move error {
    AesError.InvalidKeyLength => 1
    AesError.InvalidIvLength => 2
    AesError.OutputTooSmall => 3
    AesError.InvalidInputLength => 4
    AesError.InvalidPadding => 5
  }
}

// Runs `input` through a CBC state in parts of `step` bytes and returns the bytes written.
fn runCbc(mut state: AesCbc, input: &[u8], step: usize, output: &mut [u8]) -> i64 {
  let capacity = output.length
  let mut offset: usize = 0
  let mut written: usize = 0
  while offset < input.length {
    let mut end = offset + step
    if end > input.length { end = input.length }
    let expected = state.updateLength(end - offset)
    match state.update(Slice.view<u8>(input, offset, end - offset), Slice.viewMut<u8>(&mut output, written, capacity - written)) {
      Result<usize, AesError>.Success { value } => {
        if value != expected { return -100 }
        written = written + value
      }
      Result<usize, AesError>.Failure { error } => { return i32.toI64(0 - code(move error)) }
    }
    offset = end
  }
  return match state.finish(Slice.viewMut<u8>(&mut output, written, capacity - written)) {
    Result<usize, AesError>.Success { value } => usize.toI64(written + value)
    Result<usize, AesError>.Failure { error } => i32.toI64(0 - code(move error))
  }
}

fn runEcb(mut state: AesEcb, input: &[u8], step: usize, output: &mut [u8]) -> i64 {
  let capacity = output.length
  let mut offset: usize = 0
  let mut written: usize = 0
  while offset < input.length {
    let mut end = offset + step
    if end > input.length { end = input.length }
    match state.update(Slice.view<u8>(input, offset, end - offset), Slice.viewMut<u8>(&mut output, written, capacity - written)) {
      Result<usize, AesError>.Success { value } => { written = written + value }
      Result<usize, AesError>.Failure { error } => { return i32.toI64(0 - code(move error)) }
    }
    offset = end
  }
  return match state.finish(Slice.viewMut<u8>(&mut output, written, capacity - written)) {
    Result<usize, AesError>.Success { value } => usize.toI64(written + value)
    Result<usize, AesError>.Failure { error } => i32.toI64(0 - code(move error))
  }
}

fn cbcEncryptor(key: &[u8], iv: &[u8], padding: bool) -> AesCbc {
  return match AesCbc.encryptor(key, iv, padding) {
    Result<AesCbc, AesError>.Success { value } => move value
    Result<AesCbc, AesError>.Failure { error: _ } => Intrinsic.trap("unexpected AES error")
  }
}

fn cbcDecryptor(key: &[u8], iv: &[u8], padding: bool) -> AesCbc {
  return match AesCbc.decryptor(key, iv, padding) {
    Result<AesCbc, AesError>.Success { value } => move value
    Result<AesCbc, AesError>.Failure { error: _ } => Intrinsic.trap("unexpected AES error")
  }
}

fn ecbEncryptor(key: &[u8], padding: bool) -> AesEcb {
  return match AesEcb.encryptor(key, padding) {
    Result<AesEcb, AesError>.Success { value } => move value
    Result<AesEcb, AesError>.Failure { error: _ } => Intrinsic.trap("unexpected AES error")
  }
}

fn ecbDecryptor(key: &[u8], padding: bool) -> AesEcb {
  return match AesEcb.decryptor(key, padding) {
    Result<AesEcb, AesError>.Success { value } => move value
    Result<AesEcb, AesError>.Failure { error: _ } => Intrinsic.trap("unexpected AES error")
  }
}

fn ctr(key: &[u8], iv: &[u8]) -> AesCtr {
  return match AesCtr.make(key, iv) {
    Result<AesCtr, AesError>.Success { value } => move value
    Result<AesCtr, AesError>.Failure { error: _ } => Intrinsic.trap("unexpected AES error")
  }
}

fn block(key: &[u8]) -> Aes {
  return match Aes.make(key) {
    Result<Aes, AesError>.Success { value } => move value
    Result<Aes, AesError>.Failure { error: _ } => Intrinsic.trap("unexpected AES error")
  }
}

fn checkEcb(key: &[u8], iv: &[u8], expected: &[u8; 64]) -> bool {
  let plain = plaintext()
  // The raw block function.
  let aes = block(key)
  let mut index: usize = 0
  while index < 64 {
    let mut input: [u8; 16] = [0; 16]
    let mut lane: usize = 0
    while lane < 16 { input[lane] = plain[index + lane] lane = lane + 1 }
    let encrypted = aes.encryptBlock(&input)
    if same(&encrypted, Slice.view<u8>(expected, index, 16)) == false { return false }
    let decrypted = aes.decryptBlock(&encrypted)
    if same(&decrypted, &input) == false { return false }
    index = index + 16
  }
  let mut step: usize = 1
  while step <= 64 {
    let mut output: [u8; 64] = [0; 64]
    if runEcb(ecbEncryptor(key, false), &plain, step, &mut output) != 64 { return false }
    if same(&output, expected) == false { return false }
    let mut back: [u8; 64] = [0; 64]
    if runEcb(ecbDecryptor(key, false), expected, step, &mut back) != 64 { return false }
    if same(&back, &plain) == false { return false }
    step = step + 9
  }
  return iv.length == 0
}

fn checkCbc(key: &[u8], iv: &[u8], expected: &[u8; 64]) -> bool {
  let plain = plaintext()
  let mut step: usize = 1
  while step <= 64 {
    let mut output: [u8; 64] = [0; 64]
    if runCbc(cbcEncryptor(key, iv, false), &plain, step, &mut output) != 64 { return false }
    if same(&output, expected) == false { return false }
    let mut back: [u8; 64] = [0; 64]
    if runCbc(cbcDecryptor(key, iv, false), expected, step, &mut back) != 64 { return false }
    if same(&back, &plain) == false { return false }
    step = step + 5
  }
  return true
}

fn checkCtr(key: &[u8], iv: &[u8], expected: &[u8; 64]) -> bool {
  let plain = plaintext()
  let mut step: usize = 1
  while step <= 64 {
    let mut stream = ctr(key, iv)
    let mut output: [u8; 64] = [0; 64]
    let mut offset: usize = 0
    while offset < 64 {
      let mut end = offset + step
      if end > 64 { end = 64 }
      if let Result.Failure { error: _ } = stream.apply(Slice.view<u8>(&plain, offset, end - offset), Slice.viewMut<u8>(&mut output, offset, 64 - offset)) { return false }
      offset = end
    }
    if same(&output, expected) == false { return false }
    step = step + 3
  }
  return true
}

fn message(length: usize, multiplier: usize, offset: usize) -> [u8; 128] {
  let mut bytes: [u8; 128] = [0; 128]
  let mut index: usize = 0
  while index < length {
    bytes[index] = usize.toU8((index * multiplier + offset) % 256)
    index = index + 1
  }
  return bytes
}

fn counting(start: usize, length: usize) -> [u8; 32] {
  let mut bytes: [u8; 32] = [0; 32]
  let mut index: usize = 0
  while index < length {
    bytes[index] = usize.toU8(start + index)
    index = index + 1
  }
  return bytes
}

// PKCS #7 round trips for every length from 0 to 47, checked against a digest of the ciphertexts.
fn paddingSweep() -> bool {
  let keyBytes = counting(0, 32)
  let ivBytes = counting(100, 16)
  let key = Slice.view<u8>(&keyBytes, 0, 32)
  let iv = Slice.view<u8>(&ivBytes, 0, 16)
  let ecbKeyBytes = counting(50, 24)
  let ecbKey = Slice.view<u8>(&ecbKeyBytes, 0, 24)
  let mut cbcHash = Sha256.make()
  let mut ecbHash = Sha256.make()
  let mut length: usize = 0
  while length < 48 {
    let bytes = message(length, 7, 3)
    let plain = Slice.view<u8>(&bytes, 0, length)
    let padded = (length / 16 + 1) * 16
    let mut cipher: [u8; 64] = [0; 64]
    if runCbc(cbcEncryptor(key, iv, true), plain, 5, &mut cipher) != usize.toI64(padded) { return false }
    cbcHash.update(Slice.view<u8>(&cipher, 0, padded))
    let mut back: [u8; 64] = [0; 64]
    if runCbc(cbcDecryptor(key, iv, true), Slice.view<u8>(&cipher, 0, padded), 3, &mut back) != usize.toI64(length) { return false }
    if same(Slice.view<u8>(&back, 0, length), plain) == false { return false }
    let mut ecbCipher: [u8; 64] = [0; 64]
    if runEcb(ecbEncryptor(ecbKey, true), plain, 16, &mut ecbCipher) != usize.toI64(padded) { return false }
    ecbHash.update(Slice.view<u8>(&ecbCipher, 0, padded))
    let mut ecbBack: [u8; 64] = [0; 64]
    if runEcb(ecbDecryptor(ecbKey, true), Slice.view<u8>(&ecbCipher, 0, padded), 64, &mut ecbBack) != usize.toI64(length) { return false }
    if same(Slice.view<u8>(&ecbBack, 0, length), plain) == false { return false }
    length = length + 1
  }
  let cbcDigest = cbcHash.finish()
  let ecbDigest = ecbHash.finish()
  return same(&cbcDigest, &cbcSweepDigest()) && same(&ecbDigest, &ecbSweepDigest())
}

fn ctrSweep() -> bool {
  let keyBytes = counting(0, 32)
  let ivBytes = counting(100, 16)
  let mut hash = Sha256.make()
  let mut length: usize = 0
  while length < 100 {
    let bytes = message(length, 13, 1)
    let mut stream = ctr(&keyBytes, Slice.view<u8>(&ivBytes, 0, 16))
    let mut output: [u8; 128] = [0; 128]
    if let Result.Failure { error: _ } = stream.apply(Slice.view<u8>(&bytes, 0, length), &mut output) { return false }
    hash.update(Slice.view<u8>(&output, 0, length))
    length = length + 7
  }
  let digest = hash.finish()
  return same(&digest, &ctrSweepDigest())
}

// The counter wraps from all ones to zero, as OpenSSL does.
fn ctrWrap() -> bool {
  let key: [u8; 16] = [43, 126, 21, 22, 40, 174, 210, 166, 171, 247, 21, 136, 9, 207, 79, 60]
  let iv: [u8; 16] = [255; 16]
  let zero: [u8; 40] = [0; 40]
  let mut stream = ctr(&key, &iv)
  let mut output: [u8; 40] = [0; 40]
  if let Result.Failure { error: _ } = stream.apply(&zero, &mut output) { return false }
  return same(&output, &ctrWrapExpected())
}

fn rejections() -> bool {
  let short: [u8; 15] = [0; 15]
  let key: [u8; 16] = [0; 16]
  let iv: [u8; 16] = [0; 16]
  if let Result.Failure { error } = Aes.make(&short) { if code(move error) != 1 { return false } } else { return false }
  if let Result.Failure { error } = AesCbc.encryptor(&key, &short, true) { if code(move error) != 2 { return false } } else { return false }
  if let Result.Failure { error } = AesCtr.make(&short, &iv) { if code(move error) != 1 { return false } } else { return false }
  if let Result.Failure { error } = AesCtr.make(&key, &short) { if code(move error) != 2 { return false } } else { return false }
  // A message that is not whole blocks without padding.
  let mut out: [u8; 32] = [7; 32]
  if runCbc(cbcEncryptor(&key, &iv, false), &short, 4, &mut out) != -4 { return false }
  if runEcb(ecbDecryptor(&key, true), &short, 15, &mut out) != -4 { return false }
  // Output too small: the state and the buffer do not change.
  let mut state = cbcEncryptor(&key, &iv, true)
  let input: [u8; 20] = [1; 20]
  let mut tiny: [u8; 15] = [9; 15]
  if let Result.Failure { error } = state.update(&input, &mut tiny) { if code(move error) != 3 { return false } } else { return false }
  if tiny[0] != 9 || tiny[14] != 9 { return false }
  let mut stream = ctr(&key, &iv)
  if let Result.Failure { error } = stream.apply(&input, &mut tiny) { if code(move error) != 3 { return false } } else { return false }
  // A wrong key gives bad padding: the last byte of the zero block's decryption is not valid.
  let mut cipher: [u8; 16] = [0; 16]
  if runCbc(cbcEncryptor(&key, &iv, true), &short, 15, &mut cipher) != 16 { return false }
  let other: [u8; 16] = [1; 16]
  let mut back: [u8; 16] = [3; 16]
  let opened = runCbc(cbcDecryptor(&other, &iv, true), &cipher, 16, &mut back)
  if opened != -5 { return false }
  if back[0] != 3 { return false }
  // A fill byte of 0 and one of 17 are both invalid.
  let aes = block(&key)
  let mut zeroFill: [u8; 16] = [0; 16]
  let encryptedZero = aes.encryptBlock(&zeroFill)
  if runEcb(ecbDecryptor(&key, true), &encryptedZero, 16, &mut back) != -5 { return false }
  zeroFill[15] = 17
  let encryptedLarge = aes.encryptBlock(&zeroFill)
  if runEcb(ecbDecryptor(&key, true), &encryptedLarge, 16, &mut back) != -5 { return false }
  // A full padding block (sixteen bytes of 16) decrypts to nothing.
  let full: [u8; 16] = [16; 16]
  let encryptedFull = aes.encryptBlock(&full)
  if runEcb(ecbDecryptor(&key, true), &encryptedFull, 16, &mut back) != 0 { return false }
  // A wrong byte inside a fill of 2.
  let mut two: [u8; 16] = [2; 16]
  two[14] = 3
  let encryptedTwo = aes.encryptBlock(&two)
  if runEcb(ecbDecryptor(&key, true), &encryptedTwo, 16, &mut back) != -5 { return false }
  return true
}

fn vector0() -> bool {
  let key: [u8; 16] = [43, 126, 21, 22, 40, 174, 210, 166, 171, 247, 21, 136, 9, 207, 79, 60]
  let iv: [u8; 0] = []
  let expected: [u8; 64] = [58, 215, 123, 180, 13, 122, 54, 96, 168, 158, 202, 243, 36, 102, 239, 151, 245, 211, 213, 133, 3, 185, 105, 157, 231, 133, 137, 90, 150, 253, 186, 175, 67, 177, 205, 127, 89, 142, 206, 35, 136, 27, 0, 227, 237, 3, 6, 136, 123, 12, 120, 94, 39, 232, 173, 63, 130, 35, 32, 113, 4, 114, 93, 212]
  return checkEcb(&key, &iv, &expected)
}
