fn add(left: i32, right: i32) -> i32 { return left + right }
fn selectedCallable() -> typeof(add) | i32 { return add }
fn selectedEffect() -> some<F: Effect<'static; i32>> F | i32 {
  return effect { return 42 }
}
pub fn main() -> i32 {
  drop selectedCallable()
  drop selectedEffect()
  return 42
}