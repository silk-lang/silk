// Reads a config whose fields have rules: the first broken rule, then every problem with decodeAll.
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.schema.issue { IssueReason, SchemaError, SchemaErrors, Span }
import silk.schema.json { SchemaJson }
import silk.schema.schema { Schema, Spec }
import silk.text.string { String }

// Declare your types; reading and writing are derived from them.
union Auth {
  Anonymous,
  Token { pub value: String },
  Basic { pub user: String, pub password: Option<String> },
}
impl Schema for Auth {}

struct Server {
  pub host: String,
  pub port: u16,
  pub idleSeconds: u32,
  pub tags: List<String>,
  pub auth: Auth,
}

impl Schema for Server {
  static fn spec() -> Spec<Server> {
    return Spec<Server>.of()
      |> Spec<Server>.rename("idleSeconds", "idle_seconds")
      |> Spec<Server>.strict()
      |> Spec<Server>.length("host", 1, 253)
      |> Spec<Server>.between("port", 1, 65535)
      |> Spec<Server>.expected("port", "a port")
      |> Spec<Server>.between("idleSeconds", 1, 3600)
      |> Spec<Server>.items("tags", 1, 8)
  }
}

const CONFIG: &[u8] = b"{\"host\": \"silk.dev\", \"port\": 8080, \"idle_seconds\": 30, \"tags\": [\"edge\"], \"auth\": {\"type\": \"Basic\", \"user\": \"ada\"}}"

// The same config with port 0, two hours idle and no tags.
const OUT_OF_RANGE: &[u8] = b"{\"host\": \"silk.dev\", \"port\": 0, \"idle_seconds\": 7200, \"tags\": [], \"auth\": {\"type\": \"Anonymous\"}}"

// The same config with a misspelled key, port 0 and an auth type no variant has.
const THREE_PROBLEMS: &[u8] = b"{\"host\": \"silk.dev\", \"prot\": 1, \"port\": 0, \"idle_seconds\": 30, \"tags\": [\"edge\"], \"auth\": {\"type\": \"Bearer\"}}"

// The same config with port 0.
const BAD_PORT: &[u8] = b"{\"host\": \"silk.dev\", \"port\": 0, \"idle_seconds\": 30, \"tags\": [\"edge\"], \"auth\": {\"type\": \"Token\", \"value\": \"t1\"}}"

// Port 0, and a Basic auth whose user and password are numbers: a failure inside a part read
// after an earlier failure still reports every problem in that part.
const NESTED: &[u8] = b"{\"host\": \"silk.dev\", \"port\": 0, \"idle_seconds\": 30, \"tags\": [\"edge\"], \"auth\": {\"type\": \"Basic\", \"user\": 1, \"password\": 2}}"

effect fn load(text: &[u8]) -> Server ! SchemaError | OutOfMemoryError ? &mut Allocator {
  return run SchemaJson.decode<Server>(text)
}

effect fn checks() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let server = match run Effect.result(load(CONFIG)) {
    Result<Server, SchemaError | OutOfMemoryError>.Success {value} => move value
    Result<Server, SchemaError | OutOfMemoryError>.Failure {..} => { return 1 }
  }
  if server.port != 8080 { return 2 }
  // A broken rule names the field, what it expected and the bytes it is about:
  // SchemaError { path: "port", issue: CheckFailed, expected: "a port", span: 29..30 }
  let first = match run Effect.result(load(BAD_PORT)) {
    Result<Server, SchemaError | OutOfMemoryError>.Failure {error: SchemaError {path, issue}} =>
      path.matchesText("port") && issue.reason == IssueReason.CheckFailed && issue.expected == "a port" && spans(issue.span, 29, 30)
    _ => false
  }
  if !first { return 3 }
  // `decodeAll` reports every broken rule at once: port, idle_seconds and tags.
  let all = match run Effect.result(SchemaJson.decodeAll<Server>(OUT_OF_RANGE)) {
    Result<Server, SchemaErrors | OutOfMemoryError>.Failure {error: SchemaErrors {errors, dropped}} => {
      let found = List<SchemaError>.asSlice(&errors)
      if found.length != 3 || dropped != 0 { return 5 }
      if !found[0].path.matchesText("port") || !found[1].path.matchesText("idle_seconds") || !found[2].path.matchesText("tags") { return 6 }
      if found[1].issue.expected != "an integer from 1 to 3600" || found[2].issue.expected != "a list of 1 to 8 elements" { return 7 }
      0
    }
    _ => 4
  }
  if all != 0 { return all }
  let nested = match run Effect.result(SchemaJson.decodeAll<Server>(NESTED)) {
    Result<Server, SchemaErrors | OutOfMemoryError>.Failure {error: SchemaErrors {errors, ..}} => {
      let found = List<SchemaError>.asSlice(&errors)
      if found.length != 3 { return 14 }
      if !found[0].path.matchesText("port") || !found[1].path.matchesText("auth.Basic.user") || !found[2].path.matchesText("auth.Basic.password") { return 15 }
      if found[1].issue.reason != IssueReason.InvalidType || found[2].issue.reason != IssueReason.InvalidType { return 16 }
      0
    }
    _ => 13
  }
  if nested != 0 { return nested }
  // Problems of different kinds in one input are all reported, in input order.
  return match run Effect.result(SchemaJson.decodeAll<Server>(THREE_PROBLEMS)) {
    Result<Server, SchemaErrors | OutOfMemoryError>.Failure {error: SchemaErrors {errors, ..}} => {
      let found = List<SchemaError>.asSlice(&errors)
      if found.length != 3 { return 9 }
      if !found[0].path.matchesText("") || found[0].issue.reason != IssueReason.UnexpectedKey || !spans(found[0].issue.span, 21, 27) { return 10 }
      if !found[1].path.matchesText("port") || found[1].issue.reason != IssueReason.CheckFailed { return 11 }
      if !found[2].path.matchesText("auth.type") || found[2].issue.reason != IssueReason.UnknownVariant { return 12 }
      0
    }
    _ => 8
  }
}

fn spans(span: Option<Span>, start: usize, end: usize) -> bool {
  return match span {
    Option<Span>.Some {value} => value.start == start && value.end == end
    Option<Span>.None => false
  }
}

pub effect fn main() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checks() |> Effect.provideMut<Allocator>(&mut allocator)
}
