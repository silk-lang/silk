// Reads a config whose fields are checked after decoding: the first failed check, then every one with decodeAll.
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.schema.issue { SchemaError, SchemaErrors }
import silk.schema.json { SchemaJson }
import silk.schema.codec { Between, Items, Length }
import silk.schema.schema { Checks, Schema, Spec }
import silk.text.string { String }

// Declare your types; reading and writing are derived from them.
union Auth {
  Anonymous,
  Token { pub value: String },
  Basic { pub user: String, pub password: Option<String> },
}
impl Schema for Auth {}

struct Server {
  pub host: String,
  pub port: u16,
  pub idleSeconds: u32,
  pub tags: List<String>,
  pub auth: Auth,
}

impl Schema for Server {
  static fn spec() -> Spec<Server> {
    return Spec<Server>.of() |> Spec<Server>.rename("idleSeconds", "idle_seconds")
  }

  fn check(self: &Self, checks: &mut Checks<Server>) -> () {
    checks.field(self, "host", Length {min: 1, max: 253, message: "a host name"})
    checks.field(self, "port", Between<u16> {low: 1, high: 65535, message: "a port"})
    checks.field(self, "idleSeconds", Between<u32> {low: 1, high: 3600, message: "at most an hour"})
    checks.field(self, "tags", Items<String>.between(1, 8, "1 to 8 tags"))
  }
}

const CONFIG: &[u8] = b"{\"host\": \"silk.dev\", \"port\": 8080, \"idle_seconds\": 30, \"tags\": [\"edge\"], \"auth\": {\"type\": \"Basic\", \"user\": \"ada\"}}"

// The same config with port 0, two hours idle and no tags.
const OUT_OF_RANGE: &[u8] = b"{\"host\": \"silk.dev\", \"port\": 0, \"idle_seconds\": 7200, \"tags\": [], \"auth\": {\"type\": \"Anonymous\"}}"

// The same config with port 0.
const BAD_PORT: &[u8] = b"{\"host\": \"silk.dev\", \"port\": 0, \"idle_seconds\": 30, \"tags\": [\"edge\"], \"auth\": {\"type\": \"Token\", \"value\": \"t1\"}}"

effect fn load(text: &[u8]) -> Server ! SchemaError | OutOfMemoryError ? &mut Allocator {
  return run SchemaJson.decode<Server>(text)
}

effect fn checks() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let server = match run Effect.result(load(CONFIG)) {
    Result<Server, SchemaError | OutOfMemoryError>.Success {value} => move value
    Result<Server, SchemaError | OutOfMemoryError>.Failure {..} => { return 1 }
  }
  if server.port != 8080 { return 2 }
  // A failed check names the field and what it expected:
  // SchemaError { path: "port", issue: CheckFailed, expected: "a port" }
  let first = match run Effect.result(load(BAD_PORT)) {
    Result<Server, SchemaError | OutOfMemoryError>.Failure {error: SchemaError {path, issue}} =>
      path.view() == "port" && issue.expected == "a port"
    _ => false
  }
  if !first { return 3 }
  // `decodeAll` reports every failed check at once: port, idleSeconds and tags.
  return match run Effect.result(SchemaJson.decodeAll<Server>(OUT_OF_RANGE)) {
    Result<Server, SchemaErrors | OutOfMemoryError>.Failure {error: SchemaErrors {errors}} => {
      let found = List<SchemaError>.asSlice(&errors)
      if found.length != 3 { return 5 }
      if found[0].path.view() != "port" || found[1].path.view() != "idleSeconds" || found[2].path.view() != "tags" { return 6 }
      0
    }
    _ => 4
  }
}

pub effect fn main() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checks() |> Effect.provideMut<Allocator>(&mut allocator)
}
