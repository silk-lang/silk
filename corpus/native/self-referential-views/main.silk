// Records and unions that hold a slice of their own type, directly or through references.
// A slice is an address and a length, so its layout never waits on its element's; indexing
// strides by the element's own layout. Exits 105: the node sum (10) times ten plus the tree count (5).

import silk.num.usize

// A record whose children are a slice of itself.
struct Node<'a> {
  value: i32,
  children: &'a [Node<'a>],
}

// A record whose children are references to itself, through a slice.
struct Tree<'a> {
  label: u8,
  kids: &'a [&'a Tree<'a>],
}

// A union that holds a view of itself in one variant.
union Value<'a> {
  Number { value: i32 },
  List { items: &'a [Value<'a>] },
}

// A record that refers to itself through a `'static` slice.
struct Command {
  name: u8,
  subcommands: &'static [Command],
}

fn total(value: &Value<'_>) -> i32 {
  return match &value.* {
    Value.Number { value: number } => number
    Value.List { items } => {
      let mut sum = 0
      let mut at = usize.ZERO
      while at < items.length {
        sum = sum + total(&items[at])
        at = at + usize.ONE
      }
      return sum
    }
  }
}

fn list<'a>(items: &'a [Value<'a>]) -> Value<'a> {
  return Value.List { items: items }
}

fn node<'a>(value: i32, children: &'a [Node<'a>]) -> Node<'a> {
  return Node { value: value, children: children }
}

fn tree<'a>(label: u8, kids: &'a [&'a Tree<'a>]) -> Tree<'a> {
  return Tree { label: label, kids: kids }
}

fn leafNode(value: i32) -> Node<'static> {
  let none: &'static [Node<'static>] = &[]
  return Node { value: value, children: none }
}

fn leafTree(label: u8) -> Tree<'static> {
  let none: &'static [&'static Tree<'static>] = &[]
  return Tree { label: label, kids: none }
}

fn sum(node: &Node<'_>) -> i32 {
  let mut total = node.value
  let mut at = usize.ZERO
  while at < node.children.length {
    total = total + sum(&node.children[at])
    at = at + usize.ONE
  }
  return total
}

fn count(tree: &Tree<'_>) -> i32 {
  let mut total = 1
  let mut at = usize.ZERO
  while at < tree.kids.length {
    total = total + count(tree.kids[at])
    at = at + usize.ONE
  }
  return total
}

pub fn main() -> i32 {
  let leaves = [leafNode(4)]
  let middle = [leafNode(2), node(3, &leaves)]
  let root = node(1, &middle)
  let leaf = leafTree(1)
  let branch = tree(2, &[&leaf, &leaf])
  let top = tree(3, &[&branch, &leaf])
  let numbers = [Value.Number { value: 7 }, Value.Number { value: 8 }]
  let nested = [list(&numbers), Value.Number { value: 9 }]
  let list = list(&nested)
  let command = Command { name: 1, subcommands: &[] }
  if total(&list) != 24 || command.subcommands.length != usize.ZERO {
    return 1
  }
  return sum(&root) * 10 + count(&top)
}
