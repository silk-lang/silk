// The bytes of field `index` of a row, counted from 0. Fields are separated by one space.
fn field(line: string, index: usize) -> &[u8] {
  let bytes = String.utf8Bytes(line)
  let mut start: usize = 0
  let mut seen: usize = 0
  let mut at: usize = 0
  while at <= bytes.length {
    if at == bytes.length || bytes[at] == 32 {
      if seen == index {
        return Slice.view<u8>(bytes, start, at - start)
      }
      seen = seen + 1
      start = at + 1
    }
    at = at + 1
  }
  return Slice.view<u8>(bytes, 0, 0)
}

fn number(line: string, index: usize) -> i64 {
  let bytes = field(line, index)
  let mut value: i64 = 0
  let mut at: usize = 0
  let negative = bytes.length > 0 && bytes[0] == 45
  if negative {
    at = 1
  }
  while at < bytes.length {
    value = value * 10 + u8.toI64(bytes[at] - 48)
    at = at + 1
  }
  if negative {
    return -value
  }
  return value
}

fn small(line: string, index: usize) -> i32 {
  return i64.toI32(number(line, index))
}

fn byte(line: string, index: usize) -> u8 {
  return i64.toU8(number(line, index))
}

fn calendarOf(line: string) -> Calendar {
  return match Calendar.namedBytes(field(line, 1)) {
    Option<Calendar>.Some { value } => value
    Option<Calendar>.None => Intrinsic.trap("row with an unknown calendar")
  }
}

fn isoDate(line: string, index: usize) -> PlainDate {
  return PlainDate.make(small(line, index), byte(line, index + 1), byte(line, index + 2))
}

fn sameBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at: usize = 0
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + 1
  }
  return true
}

fn same(left: PlainDate, right: PlainDate) -> bool {
  return &left == &right
}

fn overflowOf(constrain: bool) -> Overflow {
  if constrain {
    return Overflow.Constrain
  }
  return Overflow.Reject
}

// `true` when the fields of `date` are the given ones.
fn hasFields(date: CalendarDate, year: i64, month: i64, day: i64) -> bool {
  return i32.toI64(date.year()) == year && u8.toI64(date.month()) == month && u8.toI64(date.day()) == day
}

fn checkYear(line: string) -> bool {
  let calendar = calendarOf(line)
  let year = small(line, 2)
  let leap = match calendar.isLeapYear(year) {
    Option<bool>.Some { value } => value
    Option<bool>.None => {
      return false
    }
  }
  let days = match calendar.daysInYear(year) {
    Option<u16>.Some { value } => value
    Option<u16>.None => {
      return false
    }
  }
  let months = match calendar.monthsInYear(year) {
    Option<u8>.Some { value } => value
    Option<u8>.None => {
      return false
    }
  }
  return leap == (number(line, 3) != 0) && u16.toI64(days) == number(line, 4) && u8.toI64(months) == number(line, 5)
}

fn checkMonth(line: string) -> bool {
  let calendar = calendarOf(line)
  let year = small(line, 2)
  let month = byte(line, 3)
  let days = match calendar.daysInMonth(year, month) {
    Option<u8>.Some { value } => value
    Option<u8>.None => {
      return false
    }
  }
  let code = match calendar.monthCode(year, month) {
    Option<MonthCode>.Some { value } => value
    Option<MonthCode>.None => {
      return false
    }
  }
  if u8.toI64(days) != number(line, 4) || u8.toI64(code.number) != number(line, 5) || code.leap != (number(line, 6) != 0) {
    return false
  }
  // The code leads back to the month.
  return match calendar.monthOfCode(year, code) {
    Option<u8>.Some { value } => value == month
    Option<u8>.None => false
  }
}

fn checkDay(line: string) -> bool {
  let calendar = calendarOf(line)
  let iso = isoDate(line, 5)
  let made = match CalendarDate.fromFields(calendar, small(line, 2), byte(line, 3), byte(line, 4), Overflow.Reject) {
    Result<CalendarDate, CalendarError>.Success { value } => value
    Result<CalendarDate, CalendarError>.Failure {..} => {
      return false
    }
  }
  let seen = match CalendarDate.of(calendar, iso) {
    Result<CalendarDate, CalendarError>.Success { value } => value
    Result<CalendarDate, CalendarError>.Failure {..} => {
      return false
    }
  }
  let back = made.date()
  return &back == &iso && &made == &seen && hasFields(seen, number(line, 2), number(line, 3), number(line, 4))
    && u16.toI64(seen.dayOfYear()) == number(line, 8)
}

fn checkCode(line: string) -> bool {
  let calendar = calendarOf(line)
  let code = MonthCode.make(byte(line, 3), number(line, 4) != 0)
  let expected = number(line, 5)
  return match calendar.monthOfCode(small(line, 2), code) {
    Option<u8>.Some { value } => u8.toI64(value) == expected
    Option<u8>.None => expected <= 0
  }
}

fn checkIso(line: string) -> bool {
  let calendar = calendarOf(line)
  let seen = match CalendarDate.of(calendar, isoDate(line, 2)) {
    Result<CalendarDate, CalendarError>.Success { value } => value
    Result<CalendarDate, CalendarError>.Failure {..} => {
      return false
    }
  }
  if !hasFields(seen, number(line, 5), number(line, 6), number(line, 7)) {
    return false
  }
  let wanted = field(line, 8)
  match seen.era() {
    Option<Era>.Some { value } => {
      if !sameBytes(String.utf8Bytes(value.name()), wanted) {
        return false
      }
      // The era and its year lead back to the year.
      match calendar.yearOfEra(value, small(line, 9)) {
        Option<i32>.Some { value: back } => {
          if back != seen.year() {
            return false
          }
        }
        Option<i32>.None => {
          return false
        }
      }
    }
    Option<Era>.None => {
      return sameBytes(wanted, b"-")
    }
  }
  return match seen.eraYear() {
    Option<i32>.Some { value } => i32.toI64(value) == number(line, 9)
    Option<i32>.None => false
  }
}

fn checkEra(line: string) -> bool {
  let calendar = calendarOf(line)
  let era = match Era.named(unsafe Intrinsic.stringFromUtf8Unchecked(field(line, 2))) {
    Option<Era>.Some { value } => value
    Option<Era>.None => {
      return false
    }
  }
  return match calendar.yearOfEra(era, small(line, 3)) {
    Option<i32>.Some { value } => number(line, 4) == 0 && i32.toI64(value) == number(line, 5)
    Option<i32>.None => number(line, 4) != 0
  }
}

fn checkReference(line: string) -> bool {
  let calendar = calendarOf(line)
  let code = MonthCode.make(byte(line, 2), number(line, 3) != 0)
  return match calendar.monthDayReference(code, byte(line, 4), overflowOf(number(line, 5) != 0)) {
    Option<PlainDate>.Some { value } => number(line, 6) == 0 && same(value, isoDate(line, 7))
    Option<PlainDate>.None => number(line, 6) != 0
  }
}

fn unitOf(code: i64) -> DateUnit {
  return match code {
    4 => DateUnit.Year
    3 => DateUnit.Month
    2 => DateUnit.Week
    _ => DateUnit.Day
  }
}

fn checkUntil(line: string) -> bool {
  let calendar = calendarOf(line)
  let one = match CalendarDate.of(calendar, isoDate(line, 2)) {
    Result<CalendarDate, CalendarError>.Success { value } => value
    Result<CalendarDate, CalendarError>.Failure {..} => {
      return false
    }
  }
  let two = match CalendarDate.of(calendar, isoDate(line, 5)) {
    Result<CalendarDate, CalendarError>.Success { value } => value
    Result<CalendarDate, CalendarError>.Failure {..} => {
      return false
    }
  }
  let span = match one.until(two, unitOf(number(line, 8))) {
    Result<Period, CalendarError>.Success { value } => value
    Result<Period, CalendarError>.Failure {..} => {
      return false
    }
  }
  if span.years() != number(line, 9) || span.months() != number(line, 10) || span.weeks() != number(line, 11) || span.days() != number(line, 12) {
    return false
  }
  // Adding the span to the first date gives the second date.
  return match one.checkedAdd(span, Overflow.Constrain) {
    Result<CalendarDate, CalendarError>.Success { value } => &value == &two
    Result<CalendarDate, CalendarError>.Failure {..} => false
  }
}

effect fn checkRows() -> i32 ! WriterError ? &mut Writer {
  let all = rows()
  let mut failures: i32 = 0
  let mut index: usize = 0
  while index < all.length {
    let line = all[index]
    let kind = String.utf8Bytes(line)[0]
    let good = match kind {
      121 => checkYear(line)
      109 => checkMonth(line)
      100 => checkDay(line)
      99 => checkCode(line)
      105 => checkIso(line)
      101 => checkEra(line)
      114 => checkReference(line)
      117 => checkUntil(line)
      _ => false
    }
    if !good {
      failures = failures + 1
      if failures <= 400 {
        run Format.format("row {}: {}\n", &.(index, line))
      }
    }
    index = index + 1
  }
  run Format.format("{} rows, {} failures\n", &.(all.length, failures))
  return failures
}

struct Capture {
  bytes: [u8; 64],
  length: usize,
}

impl Writer for Capture {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> () ! WriterError ? &mut Writer {
    let mut index: usize = 0
    while index < value.length && self.length < 64 {
      self.bytes[self.length] = value[index]
      self.length = self.length + 1
      index = index + 1
    }
    return ()
  }

  effect fn flush(self: &mut Self) -> () ! WriterError ? &mut Writer {
    return ()
  }
}

fn of(calendar: Calendar, year: i32, month: u8, day: u8) -> CalendarDate {
  return match CalendarDate.fromFields(calendar, year, month, day, Overflow.Reject) {
    Result<CalendarDate, CalendarError>.Success { value } => value
    Result<CalendarDate, CalendarError>.Failure {..} => Intrinsic.trap("a date of the test does not exist")
  }
}

fn coded(calendar: Calendar, year: i32, number: u8, leap: bool, day: u8) -> CalendarDate {
  return match CalendarDate.fromMonthCode(calendar, year, MonthCode.make(number, leap), day, Overflow.Reject) {
    Result<CalendarDate, CalendarError>.Success { value } => value
    Result<CalendarDate, CalendarError>.Failure {..} => Intrinsic.trap("a date of the test does not exist")
  }
}

fn errorCode(error: CalendarError) -> i32 {
  return match error {
    CalendarError.OutOfRange => 1
    CalendarError.NoSuchMonth => 2
    CalendarError.NoSuchDay => 3
    CalendarError.NoSuchEra => 4
    CalendarError.CalendarMismatch => 5
  }
}

// `true` when `result` is the date with these fields.
fn gives(result: Result<CalendarDate, CalendarError>, year: i32, number: u8, leap: bool, day: u8) -> bool {
  return match move result {
    Result<CalendarDate, CalendarError>.Success { value } => {
      let code = value.monthCode()
      return value.year() == year && code.number == number && code.leap == leap && value.day() == day
    }
    Result<CalendarDate, CalendarError>.Failure {..} => false
  }
}

// `true` when `result` is the error with this code.
fn refuses(result: Result<CalendarDate, CalendarError>, code: i32) -> bool {
  return match move result {
    Result<CalendarDate, CalendarError>.Success {..} => false
    Result<CalendarDate, CalendarError>.Failure { error } => errorCode(error) == code
  }
}

fn parseReason(text: string) -> i32 {
  return match CalendarDate.parse(text) {
    Result<CalendarDate, TimeParseError>.Success {..} => 0
    Result<CalendarDate, TimeParseError>.Failure { error } => match error.reason {
      TimeParseReason.UnsupportedCalendar => 1
      TimeParseReason.OutOfRange => 2
      TimeParseReason.UtcNotAllowed => 3
      _ => 4
    }
  }
}

effect fn shows(text: string, expected: string) -> bool ! WriterError ? &mut Writer {
  match CalendarDate.parse(text) {
    Result<CalendarDate, TimeParseError>.Success { value } => {
      let mut capture = Capture { bytes: [0; 64], length: 0 }
      run Format.format("{}", &.(value)) |> Effect.provideMut<Writer>(&mut capture)
      return sameBytes(Slice.view<u8>(&capture.bytes, 0, capture.length), String.utf8Bytes(expected))
    }
    Result<CalendarDate, TimeParseError>.Failure {..} => {
      return false
    }
  }
}

effect fn checkValues() -> i32 ! WriterError ? &mut Writer {
  let mut failures: i32 = 0
  let one = Period.ofYears(1)
  // Hebrew: 30 Adar I 5784 is 2024-03-10. The next year has no Adar I.
  let adar = coded(Calendar.Hebrew, 5784, 5, true, 30)
  let adarIso = adar.date()
  let adarExpected = PlainDate.make(2024, 3, 10)
  if &adarIso != &adarExpected || adar.month() != 6 || !adar.inLeapYear() || adar.monthsInYear() != 13 {
    failures = failures + 1
  }
  if !gives(adar.checkedAdd(one, Overflow.Constrain), 5785, 6, false, 29) || !refuses(adar.checkedAdd(one, Overflow.Reject), 2) {
    failures = failures + 1
  }
  // A year keeps the month code: Adar of a common year leads to Adar II, and Nisan to Nisan.
  if !gives(coded(Calendar.Hebrew, 5783, 6, false, 15).checkedAdd(one, Overflow.Reject), 5784, 6, false, 15)
    || !gives(coded(Calendar.Hebrew, 5783, 7, false, 15).checkedAdd(one, Overflow.Reject), 5784, 7, false, 15)
    || coded(Calendar.Hebrew, 5784, 7, false, 15).month() != 8 {
    failures = failures + 1
  }
  // Months count the months of the calendar: Shevat, Adar I, Adar II, and Elul to Tishri.
  if !gives(coded(Calendar.Hebrew, 5784, 5, false, 10).checkedAdd(Period.ofMonths(2), Overflow.Reject), 5784, 6, false, 10)
    || !gives(coded(Calendar.Hebrew, 5784, 5, false, 10).checkedAdd(Period.ofMonths(1), Overflow.Reject), 5784, 5, true, 10)
    || !gives(coded(Calendar.Hebrew, 5784, 12, false, 29).checkedAdd(Period.ofMonths(1), Overflow.Reject), 5785, 1, false, 29)
    || !gives(coded(Calendar.Hebrew, 5785, 1, false, 30).checkedAdd(Period.ofMonths(-1), Overflow.Constrain), 5784, 12, false, 29)
    || !refuses(coded(Calendar.Hebrew, 5785, 1, false, 30).checkedAdd(Period.ofMonths(-1), Overflow.Reject), 3) {
    failures = failures + 1
  }
  // Chinese: 2023 repeats month 2, and 2024 has no leap month.
  let leapMonth = coded(Calendar.Chinese, 2023, 2, true, 1)
  if leapMonth.month() != 3 || !gives(leapMonth.checkedAdd(one, Overflow.Constrain), 2024, 2, false, 1)
    || !refuses(leapMonth.checkedAdd(one, Overflow.Reject), 2)
    || !refuses(CalendarDate.fromMonthCode(Calendar.Chinese, 2024, MonthCode.make(2, true), 1, Overflow.Reject), 2)
    || !gives(CalendarDate.fromMonthCode(Calendar.Chinese, 2024, MonthCode.make(2, true), 1, Overflow.Constrain), 2024, 2, false, 1) {
    failures = failures + 1
  }
  // The new years that ICU 78 has one day off: 1954-02-03, 2027-02-06, and 2030-02-03.
  if !gives(CalendarDate.of(Calendar.Chinese, PlainDate.make(1954, 2, 3)), 1954, 1, false, 1)
    || !gives(CalendarDate.of(Calendar.Chinese, PlainDate.make(2027, 2, 6)), 2027, 1, false, 1)
    || !gives(CalendarDate.of(Calendar.Chinese, PlainDate.make(2030, 2, 3)), 2030, 1, false, 1)
    || !gives(CalendarDate.of(Calendar.Chinese, PlainDate.make(2025, 7, 30)), 2025, 6, true, 6) {
    failures = failures + 1
  }
  // The limits of the lunar tables.
  if !gives(CalendarDate.of(Calendar.Chinese, PlainDate.make(1800, 1, 25)), 1800, 1, false, 1)
    || !refuses(CalendarDate.of(Calendar.Chinese, PlainDate.make(1800, 1, 24)), 1)
    || !refuses(CalendarDate.of(Calendar.Dangi, PlainDate.make(1800, 1, 24)), 1)
    || !gives(CalendarDate.of(Calendar.Dangi, PlainDate.make(2201, 2, 3)), 2200, 12, false, 29)
    || !refuses(CalendarDate.of(Calendar.Chinese, PlainDate.make(2201, 2, 4)), 1)
    || !refuses(CalendarDate.fromFields(Calendar.Chinese, 2201, 1, 1, Overflow.Constrain), 1)
    || !refuses(of(Calendar.Chinese, 2200, 12, 1).checkedAdd(Period.ofMonths(2), Overflow.Constrain), 1)
    || !refuses(of(Calendar.Chinese, 2200, 12, 1).checkedAdd(Period.ofDays(40), Overflow.Constrain), 1) {
    failures = failures + 1
  }
  // A leap day that the year reached does not have.
  if !gives(of(Calendar.IslamicCivil, 1445, 12, 30).checkedAdd(one, Overflow.Constrain), 1446, 12, false, 29)
    || !refuses(of(Calendar.IslamicCivil, 1445, 12, 30).checkedAdd(one, Overflow.Reject), 3)
    || !gives(of(Calendar.Persian, 1403, 12, 30).checkedAdd(one, Overflow.Constrain), 1404, 12, false, 29)
    || !gives(of(Calendar.Coptic, 1739, 13, 6).checkedAdd(one, Overflow.Constrain), 1740, 13, false, 5)
    || !gives(of(Calendar.Gregory, 2024, 2, 29).checkedAdd(one, Overflow.Constrain), 2025, 2, false, 28)
    || !refuses(of(Calendar.Buddhist, 2567, 2, 29).checkedAdd(one, Overflow.Reject), 3)
    || !gives(of(Calendar.Roc, 113, 2, 29).checkedAdd(Period.make(4, 0, 1, 1, Duration.fromSeconds(86400)), Overflow.Reject), 117, 3, false, 9) {
    failures = failures + 1
  }
  // Fields that do not exist.
  if !refuses(CalendarDate.fromFields(Calendar.Hebrew, 5785, 13, 1, Overflow.Reject), 2)
    || !gives(CalendarDate.fromFields(Calendar.Hebrew, 5785, 13, 1, Overflow.Constrain), 5785, 12, false, 1)
    || !refuses(CalendarDate.fromFields(Calendar.Hebrew, 5785, 0, 1, Overflow.Constrain), 2)
    || !refuses(CalendarDate.fromFields(Calendar.Hebrew, 5785, 1, 0, Overflow.Constrain), 3)
    || !refuses(CalendarDate.fromFields(Calendar.Hebrew, 5785, 1, 31, Overflow.Reject), 3)
    || !gives(CalendarDate.fromFields(Calendar.Hebrew, 5785, 1, 31, Overflow.Constrain), 5785, 1, false, 30)
    || !refuses(CalendarDate.fromMonthCode(Calendar.Hebrew, 5784, MonthCode.make(6, true), 1, Overflow.Constrain), 2)
    || !refuses(CalendarDate.fromMonthCode(Calendar.Persian, 1403, MonthCode.make(13, false), 1, Overflow.Constrain), 2)
    || !gives(CalendarDate.fromMonthCode(Calendar.Ethiopic, 2016, MonthCode.make(13, false), 9, Overflow.Constrain), 2016, 13, false, 5)
    || !refuses(CalendarDate.fromFields(Calendar.Persian, 400000, 1, 1, Overflow.Constrain), 1)
    || !refuses(CalendarDate.fromFields(Calendar.Gregory, 275760, 9, 14, Overflow.Reject), 1)
    || !gives(CalendarDate.fromFields(Calendar.Gregory, 275760, 9, 13, Overflow.Reject), 275760, 9, false, 13)
    || !refuses(of(Calendar.Hebrew, 5785, 1, 1).checkedAdd(Period.ofYears(900000), Overflow.Constrain), 1) {
    failures = failures + 1
  }
  // The first and the last day of the range in every calendar but the lunar ones.
  let mut kind: i32 = 0
  let names = ["iso8601", "gregory", "buddhist", "roc", "japanese", "coptic", "ethiopic", "ethioaa", "hebrew", "indian", "persian", "islamic-civil", "islamic-tbla", "islamic-umalqura"]
  while i32.toUsize(kind) < names.length {
    let calendar = match Calendar.named(names[i32.toUsize(kind)]) {
      Option<Calendar>.Some { value } => value
      Option<Calendar>.None => Intrinsic.trap("unknown calendar name")
    }
    let mut pick: i32 = 0
    while pick < 2 {
      let date = if pick == 0 { PlainDate.min() } else { PlainDate.max() }
      match CalendarDate.of(calendar, date) {
        Result<CalendarDate, CalendarError>.Success { value } => {
          let back = CalendarDate.fromFields(calendar, value.year(), value.month(), value.day(), Overflow.Reject)
          let code = value.monthCode()
          if !gives(move back, value.year(), code.number, code.leap, value.day()) {
            failures = failures + 1
          }
          let step = if pick == 0 { Period.ofDays(-1) } else { Period.ofDays(1) }
          if !refuses(value.checkedAdd(step, Overflow.Constrain), 1) {
            failures = failures + 1
          }
        }
        Result<CalendarDate, CalendarError>.Failure {..} => {
          failures = failures + 1
        }
      }
      pick = pick + 1
    }
    kind = kind + 1
  }
  // Dates of two calendars.
  let hebrew = of(Calendar.Hebrew, 5785, 1, 1)
  match hebrew.until(of(Calendar.Gregory, 2025, 1, 1), DateUnit.Day) {
    Result<Period, CalendarError>.Success {..} => {
      failures = failures + 1
    }
    Result<Period, CalendarError>.Failure { error } => {
      if errorCode(error) != 5 {
        failures = failures + 1
      }
    }
  }
  if !gives(hebrew.withCalendar(Calendar.Japanese), 2024, 10, false, 3) || !refuses(of(Calendar.Gregory, 1700, 1, 1).withCalendar(Calendar.Dangi), 1) {
    failures = failures + 1
  }
  // Eras.
  let japan = of(Calendar.Japanese, 2019, 4, 30)
  match japan.era() {
    Option<Era>.Some { value } => {
      if !sameBytes(String.utf8Bytes(value.name()), b"heisei") {
        failures = failures + 1
      }
    }
    Option<Era>.None => {
      failures = failures + 1
    }
  }
  match of(Calendar.Chinese, 2024, 1, 1).era() {
    Option<Era>.Some {..} => {
      failures = failures + 1
    }
    Option<Era>.None => {}
  }
  if Calendar.Iso8601.hasEras() || Calendar.Dangi.hasEras() || !Calendar.Japanese.hasEras() {
    failures = failures + 1
  }
  // Names.
  let known = match Calendar.named("ISLAMICC") {
    Option<Calendar>.Some { value } => sameBytes(String.utf8Bytes(value.name()), b"islamic-civil")
    Option<Calendar>.None => false
  }
  let alias = match Calendar.named("ethiopic-amete-alem") {
    Option<Calendar>.Some { value } => sameBytes(String.utf8Bytes(value.name()), b"ethioaa")
    Option<Calendar>.None => false
  }
  let unknown = match Calendar.named("martian") {
    Option<Calendar>.Some {..} => false
    Option<Calendar>.None => true
  }
  let empty = match Calendar.named("") {
    Option<Calendar>.Some {..} => false
    Option<Calendar>.None => true
  }
  let anno = match Era.named("AD") {
    Option<Era>.Some { value } => sameBytes(String.utf8Bytes(value.name()), b"ce")
    Option<Era>.None => false
  }
  let noEra = match Era.named("martian") {
    Option<Era>.Some {..} => false
    Option<Era>.None => true
  }
  if !known || !alias || !unknown || !empty || !anno || !noEra {
    failures = failures + 1
  }
  // Month codes.
  let code = match MonthCode.parse("M05L") {
    Option<MonthCode>.Some { value } => value.number == 5 && value.leap
    Option<MonthCode>.None => false
  }
  let plain = match MonthCode.parse("M13") {
    Option<MonthCode>.Some { value } => value.number == 13 && !value.leap
    Option<MonthCode>.None => false
  }
  let mut badCodes: i32 = 0
  let bad = ["M00", "m05", "M5", "M05l", "M05LL", "", "MAB", "M1L"]
  let mut at: usize = 0
  while at < bad.length {
    match MonthCode.parse(bad[at]) {
      Option<MonthCode>.Some {..} => {
        badCodes = badCodes + 1
      }
      Option<MonthCode>.None => {}
    }
    at = at + 1
  }
  if !code || !plain || badCodes != 0 {
    failures = failures + 1
  }
  // Text.
  let hebrewText = run shows("2026-11-19[u-ca=hebrew]", "2026-11-19[u-ca=hebrew]")
  let isoText = run shows("2026-11-19", "2026-11-19")
  let isoNamed = run shows("2026-11-19[u-ca=iso8601]", "2026-11-19")
  let upper = run shows("2026-11-19[u-ca=HEBREW]", "2026-11-19[u-ca=hebrew]")
  let zoned = run shows("2026-11-19T10:00+01:00[Europe/Rome][u-ca=japanese]", "2026-11-19[u-ca=japanese]")
  let old = run shows("-000044-03-15[u-ca=gregory]", "-000044-03-15[u-ca=gregory]")
  if !hebrewText || !isoText || !isoNamed || !upper || !zoned || !old {
    failures = failures + 1
  }
  if parseReason("2026-11-19[u-ca=martian]") != 1 || parseReason("1700-01-01[u-ca=chinese]") != 2
    || parseReason("2026-11-19T10:00Z[u-ca=hebrew]") != 3
    || parseReason("2026-13-19[u-ca=hebrew]") != 2
    || parseReason("2026-11-19[u-ca=hebrew") != 4
    || parseReason("2026-11-19[u-ca=hebrew]") != 0 {
    failures = failures + 1
  }
  // The other parsers still take only the ISO 8601 calendar.
  match PlainDate.parse("2026-11-19[u-ca=hebrew]") {
    Result<PlainDate, TimeParseError>.Success {..} => {
      failures = failures + 1
    }
    Result<PlainDate, TimeParseError>.Failure {..} => {}
  }
  run Format.format("{} value failures\n", &.(failures))
  return failures
}

effect fn program() -> i32 ! WriterError ? &mut Writer {
  let rowFailures = run checkRows()
  let valueFailures = run checkValues()
  if rowFailures != 0 || valueFailures != 0 {
    return 1
  }
  return 0
}

effect fn failed(error: WriterError) -> i32 {
  return 2
}

pub effect fn main() -> i32 {
  let mut out = StdoutWriter.make()
  return run Effect.catchAll(program(), failed) |> Effect.provideMut<Writer>(&mut out)
}
