import silk.concurrency.sync { Arc }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.trace { Trace, Tracer }
import silk.trace.record { Config, Recorder }

effect fn closeParentFirst() -> () {
  let parent = Trace.span("parent")
  let child = Trace.span("child")
  drop parent
  drop child
}

effect fn check() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let recorder = run Arc<Recorder>.make(run Recorder.make(Config.make("order")))
  run closeParentFirst() |> Effect.provideAmbient<Tracer>(&recorder)
  return 0
}

effect fn failed(error: OutOfMemoryError) -> i32 { return 1 }

pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(check() |> Effect.provideMut<Allocator>(&mut allocator), failed)
}
