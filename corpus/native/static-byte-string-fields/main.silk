// Byte-string literals are static values: a constant can hold one directly, in a struct field or
// in an array element, and the bytes stay exact, escapes and non-UTF-8 bytes included. A
// constant's `&[u8]` is `&'static [u8]`, as its `string` is `string<'static>`.
struct Command {
  name: &'static [u8],
  code: u8,
}

const COMMANDS: [Command; 3] = [
  Command { name: b"build", code: 1 },
  Command { name: b"run", code: 2 },
  Command { name: b"\xff\n", code: 3 },
]

const MAGIC: &[u8] = b"\x00asm"

fn find(name: &[u8]) -> u8 {
  let mut at: usize = 0
  while at < COMMANDS.length {
    let candidate = COMMANDS[at].name
    if candidate.length == name.length {
      let mut same = true
      let mut index: usize = 0
      while index < name.length {
        if candidate[index] != name[index] { same = false }
        index = index + 1
      }
      if same { return COMMANDS[at].code }
    }
    at = at + 1
  }
  return 0
}

pub fn main() -> i32 {
  if find(b"run") != 2 { return 1 }
  if find(b"\xff\n") != 3 { return 2 }
  if find(b"test") != 0 { return 3 }
  if MAGIC.length != 4 || MAGIC[0] != 0 || MAGIC[1] != 97 { return 4 }
  return 42
}
