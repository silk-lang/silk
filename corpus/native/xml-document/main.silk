// The silk.xml.document module: parsing, namespaces, text and attribute normalization, internal
// entities and attribute defaults, UTF-16 input, limits, pseudo-attributes, and attribute
// snapshots. Cases follow the XML 1.0 Fifth Edition and Namespaces in XML 1.0 specifications and
// the xml-stylesheet Second Edition recommendation; each test names its sections. A failure returns
// the number of the failed check; 254 means an unexpected XmlError and 255 an OutOfMemoryError.
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }
import silk.xml.document {
  XmlDocument,
  XmlEncoding,
  XmlError,
  XmlLimits,
  XmlNodeId,
  XmlNodeKind,
  XmlPseudoAttributes,
  XmlReason
}

struct CheckFailed {
  code: i32
}

effect fn expect(ok: bool, code: i32) -> ()
  ! CheckFailed {
  if !ok {
    fail CheckFailed { code: code }
  }
}

fn equal(actual: string, expected: string) -> bool {
  return actual == expected
}

fn attribute(
  doc: &XmlDocument,
  node: XmlNodeId,
  uri: string,
  name: string,
  expected: string,
) -> bool {
  return match XmlDocument.attribute(doc, node, uri, name) {
    Option<string>.Some { value } => value == expected
    _ => false
  }
}

effect fn rejected(data: &[u8], code: i32) -> ()
  ! CheckFailed | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let result = run Effect.result(
    XmlDocument.parse(data) |> Effect.provideMut<Allocator>(&mut allocator),
  )
  run expect(
    match &result {
      Result<XmlDocument, XmlError | OutOfMemoryError>.Failure { error } => match &error {
        XmlError _problem => true
        OutOfMemoryError _problem => {
          fail OutOfMemoryError {}
        }
      }
      _ => false
    },
    code,
  )
}

// https://www.w3.org/TR/xml-names/#defaulting
// https://www.w3.org/TR/xml/#sec-starttags
effect fn expandedNamesAndForeignMetadata() -> ()
  ! CheckFailed | XmlError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let doc = run XmlDocument.parse(
    b"<svg xmlns='urn:svg' xmlns:p='urn:private' id='x' p:id='y'><p:meta>value</p:meta><g xmlns=''/></svg>",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let root = XmlDocument.root(&doc)

  // default element namespace
  run expect(equal(XmlDocument.namespaceUri(&doc, root), "urn:svg"), 2)

  // unprefixed attribute has no namespace
  run expect(attribute(&doc, root, "", "id", "x"), 3)

  // foreign attribute retained
  run expect(attribute(&doc, root, "urn:private", "id", "y"), 4)

  // foreign element retained
  run expect(equal(XmlDocument.localName(&doc, XmlNodeId { index: 1 }), "meta"), 5)

  // foreign content retained
  run expect(equal(XmlDocument.text(&doc, XmlNodeId { index: 2 }), "value"), 6)

  // default namespace undeclaration
  run expect(equal(XmlDocument.namespaceUri(&doc, XmlNodeId { index: 3 }), ""), 7)
}

// https://www.w3.org/TR/xml/#sec-line-ends
// https://www.w3.org/TR/xml/#AVNormalize
// https://www.w3.org/TR/xml/#sec-cdata-sect
// https://www.w3.org/TR/xml/#sec-pi
effect fn textNormalizationAndRetainedMisc() -> ()
  ! CheckFailed | XmlError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let doc = run XmlDocument.parse(
    b"<?xml version='1.0'?><?style yes?><r a='a\r\nb\tc&#xA;d'><!--keep--><![CDATA[<x>\r\ny]]>&lt;&amp;&#x1F600;</r>",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)

  // literal whitespace normalized, reference preserved
  run expect(attribute(&doc, XmlDocument.root(&doc), "", "a", "a b c\nd"), 8)

  // PI data retained
  run expect(equal(XmlDocument.text(&doc, XmlNodeId { index: 0 }), "yes"), 9)

  // comment retained
  run expect(equal(XmlDocument.text(&doc, XmlNodeId { index: 2 }), "keep"), 10)

  // CDATA and newlines
  run expect(equal(XmlDocument.text(&doc, XmlNodeId { index: 3 }), "<x>\ny"), 11)
}

// https://www.w3.org/TR/xml/#sec-internal-ent
// https://www.w3.org/TR/xml/#sec-entexpand
// https://www.w3.org/TR/xml/#sec-attr-defaults
effect fn internalEntitiesAndAttributeDefaults() -> ()
  ! CheckFailed | XmlError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let doc = run XmlDocument.parse(
    b"<!DOCTYPE r [<!ENTITY word 'hello'><!ENTITY markup '<child a=\"&word;\"/>'><!ATTLIST r tokens NMTOKENS '  a   b  '>]><r>&markup;</r>",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)

  // tokenized DTD default normalization
  run expect(attribute(&doc, XmlDocument.root(&doc), "", "tokens", "a b"), 12)

  // entity markup parsed
  run expect(equal(XmlDocument.localName(&doc, XmlNodeId { index: 1 }), "child"), 13)

  // entity references in replacement attributes
  run expect(attribute(&doc, XmlNodeId { index: 1 }, "", "a", "hello"), 14)
}

// https://www.w3.org/TR/xml/#as-PE
// https://www.w3.org/TR/xml/#proc-types
effect fn parameterEntitiesAndUnfetchedExternalSubset() -> ()
  ! CheckFailed | XmlError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let doc = run XmlDocument.parse(
    b"<!DOCTYPE r SYSTEM 'https://invalid.example/never-fetch' [<!ENTITY % defs \"<!ENTITY x 'ok'>\">%defs;]><r>&x;</r>",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)

  // internal parameter entity declaration
  run expect(equal(XmlDocument.text(&doc, XmlNodeId { index: 1 }), "ok"), 15)
}

// https://www.w3.org/TR/xml/#sec-guessing
// https://www.w3.org/TR/xml/#charencoding
effect fn utf16DetectionAndSupplementaryCharacters() -> ()
  ! CheckFailed | XmlError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let le: [u8; 18] = [255, 254, 60, 0, 114, 0, 62, 0, 61, 216, 0, 222, 60, 0, 47, 0, 114, 0]
  let mut data = run Bytes.copy(&le) |> Effect.provideMut<Allocator>(&mut allocator)
  run Bytes.append(&mut data, &[62, 0]) |> Effect.provideMut<Allocator>(&mut allocator)
  let doc = run XmlDocument.parse(Bytes.asSlice(&data))
    |> Effect.provideMut<Allocator>(&mut allocator)

  // surrogate pair becomes UTF8
  run expect(String.byteLength(XmlDocument.text(&doc, XmlNodeId { index: 1 })) == 4, 16)
  let be: [u8; 8] = [0, 60, 0, 114, 0, 47, 0, 62]
  let other = run XmlDocument.parse(&be) |> Effect.provideMut<Allocator>(&mut allocator)

  // UTF16 byte pattern
  run expect(equal(XmlDocument.localName(&other, XmlDocument.root(&other)), "r"), 17)
}

// https://www.w3.org/TR/xml/#sec-well-formed
// https://www.w3.org/TR/xml/#NT-Name
// https://www.w3.org/TR/xml/#NT-Comment
effect fn malformedStructureAndCharacters() -> ()
  ! CheckFailed | OutOfMemoryError {
  run rejected(b"", 18)
  run rejected(b"<a/><b/>", 19)
  run rejected(b"<a><b></a></b>", 20)
  run rejected(b"<a>", 21)
  run rejected(b"<1a/>", 22)
  run rejected(b"<a x='1'x='2'/>", 23)
  run rejected(b"<a x='1' x='2'/>", 24)
  run rejected(b"<a><!--a--b--></a>", 25)
  run rejected(b"<a>]]></a>", 26)
  run rejected(b"<a>&#0;</a>", 27)
  run rejected(b"<a>&unknown;</a>", 28)
  run rejected(b"<?XML data?><a/>", 29)
  run rejected(b" <?xml version='1.0'?><a/>", 30)
  run rejected(b"<?xml version='2.0'?><a/>", 31)
  run rejected(b"<?xml version='1.'?><a/>", 32)
  run rejected(b"<a x='<bad'/>", 33)
  run rejected(&[60, 97, 62, 192, 128, 60, 47, 97, 62], 34)
}

// https://www.w3.org/TR/xml/#sec-versioning (any 1.x document is processed as 1.0)
// https://www.w3.org/TR/xml/#wf-entdeclared (a parameter entity reference in the
// internal subset makes an undeclared entity a validity error, not a fatal one)
effect fn laterVersionsAndUndeclaredAfterParameterEntities() -> ()
  ! CheckFailed | XmlError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let later = run XmlDocument.parse(b"<?xml version='1.7'?><a/>")
    |> Effect.provideMut<Allocator>(&mut allocator)

  // 1.x accepted
  run expect(equal(XmlDocument.localName(&later, XmlDocument.root(&later)), "a"), 35)
  let referenced = run XmlDocument.parse(
    b"<!DOCTYPE a [<!ENTITY % pe \"<!ENTITY one 'text'>\">%pe;]><a missing='&two;'>&two;</a>",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)

  // Unread attribute and content references remain visible even when the parameter entity was read.
  let skipped = XmlDocument.skippedEntities(&referenced)
  run expect(
    skipped.length == 2 && referenced.skippedExternalContent()
      && String.view(&skipped[0].name) == "two"
      && !skipped[0].parameter
      && String.view(&skipped[1].name) == "two"
      && !skipped[1].parameter,
    133,
  )

  // undeclared entity after a parameter entity reference
  run expect(equal(XmlDocument.localName(&referenced, XmlDocument.root(&referenced)), "a"), 36)
  run rejected(
    b"<?xml version='1.0' standalone='yes'?><!DOCTYPE a [<!ENTITY % pe ''>%pe;]><a>&two;</a>",
    37,
  )
  run rejected(b"<!DOCTYPE a [<!ENTITY one 'text'>]><a>&two;</a>", 38)
}

// https://www.w3.org/TR/xml-names/#nsc-NSDeclared
// https://www.w3.org/TR/xml-names/#nsc-AttrsUnique
// https://www.w3.org/TR/xml-names/#xmlReserved
effect fn namespaceConstraints() -> ()
  ! CheckFailed | OutOfMemoryError {
  run rejected(b"<p:r/>", 39)
  run rejected(b"<a p:x='1'/>", 40)
  run rejected(b"<a xmlns:p=''/>", 41)
  run rejected(b"<a xmlns:xml='wrong'/>", 42)
  run rejected(b"<a xmlns:p='http://www.w3.org/XML/1998/namespace'/>", 43)
  run rejected(b"<a xmlns='http://www.w3.org/2000/xmlns/'/>", 44)
  run rejected(b"<a xmlns:xmlns='urn:x'/>", 45)
  run rejected(b"<xmlns:r/>", 46)
  run rejected(b"<a:b:c/>", 47)
  run rejected(b"<a xmlns:p='u' xmlns:q='u' p:x='1' q:x='2'/>", 48)
}

// https://www.w3.org/TR/xml/#norecursion
// https://www.w3.org/TR/xml/#wf-entdeclared
// https://www.w3.org/TR/xml/#CleanAttrVals
effect fn malformedEntityReplacement() -> ()
  ! CheckFailed | OutOfMemoryError {
  run rejected(b"<!DOCTYPE r [<!ENTITY x '&x;'>]><r>&x;</r>", 49)
  run rejected(b"<!DOCTYPE r [<!ENTITY x '<a>'>]><r>&x;</a></r>", 50)
  run rejected(b"<!DOCTYPE r [<!ENTITY x '<'>]><r a='&x;'/>", 51)
  run rejected(b"<!DOCTYPE r [<!ENTITY x SYSTEM 'file:///private'>]><r a='&x;'/>", 52)
  run rejected(b"<!DOCTYPE r [<!ENTITY x SYSTEM 'x' NDATA n>]><r>&x;</r>", 53)
  run rejected(b"<!DOCTYPE r [<!ENTITY % x 'a'><!ENTITY y '%x;'>]><r/>", 54)
}

// https://www.w3.org/TR/xml/#sec-entexpand (host resource bounds are parser policy).
effect fn hostLimitsAreEnforced() -> ()
  ! CheckFailed | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut limits = XmlLimits.make()
  limits.maxDepth = 2
  let result = run Effect.result(
    XmlDocument.parseWithLimits(b"<r><a><b/></a></r>", &limits)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )

  // nesting bound is checked before recursion
  run expect(
    match &result {
      Result<XmlDocument, XmlError | OutOfMemoryError>.Failure { error } => match &error {
        XmlError problem => match &problem.reason {
          XmlReason.Limit => true
          _ => false
        }
        OutOfMemoryError _problem => {
          fail OutOfMemoryError {}
        }
      }
      _ => false
    },
    55,
  )
}

// https://www.w3.org/TR/xml/#sec-prolog-dtd
// https://www.w3.org/TR/xml/#wf-entdeclared
// https://www.w3.org/TR/xml-names/#Conformance
effect fn declarationsAreCheckedEvenWhenUnused() -> ()
  ! CheckFailed | OutOfMemoryError {
  run rejected(b"<!DOCTYPE r [<!ATTLIST unused x CDATA '&;'>]><r/>", 56)
  run rejected(b"<!DOCTYPE r [<!ATTLIST unused x CDATA '&later;'><!ENTITY later 'x'>]><r/>", 57)
  run rejected(b"<!DOCTYPE r [<!ELEMENT unused (a|b,c)>]><r/>", 58)
  run rejected(b"<!DOCTYPE r [<!ENTITY a:b 'x'>]><r/>", 59)
  run rejected(b"<?a:b x?><r/>", 60)
  run rejected(b"<!DOCTYPE r [<!ATTLIST a:b:c x CDATA #IMPLIED>]><r/>", 61)
}

// https://www.w3.org/TR/xml/#sec-predefined-ent
// https://www.w3.org/TR/xml/#sec-attr-defaults
effect fn predefinedDeclarationsAndDefaultFirstBinding() -> ()
  ! CheckFailed | XmlError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let doc = run XmlDocument.parse(
    b"<!DOCTYPE r [<!ENTITY lt '&#38;#60;'><!ENTITY amp '&#38;#38;'><!ATTLIST r a CDATA '&amp;'><!ATTLIST r a CDATA 'second'>]><r/>",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)

  // default values are expanded once and first declaration wins
  run expect(attribute(&doc, XmlDocument.root(&doc), "", "a", "&"), 62)
}

// https://www.w3.org/TR/xml/#sec-entexpand
effect fn entityBudgetCountsRepeatedReferences() -> ()
  ! CheckFailed | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut limits = XmlLimits.make()
  limits.maxExpandedBytes = 3
  let result = run Effect.result(
    XmlDocument.parseWithLimits(b"<!DOCTYPE r [<!ENTITY x 'ab'>]><r>&x;&x;</r>", &limits)
      |> Effect.provideMut<Allocator>(&mut allocator),
  )

  // cumulative expansion budget
  run expect(
    match &result {
      Result<XmlDocument, XmlError | OutOfMemoryError>.Failure { error } => match &error {
        XmlError problem => match &problem.reason {
          XmlReason.Limit => true
          _ => false
        }
        OutOfMemoryError _problem => {
          fail OutOfMemoryError {}
        }
      }
      _ => false
    },
    63,
  )
}

// https://www.w3.org/TR/xml/#include-if-valid
// https://www.w3.org/TR/xml/#proc-types
effect fn skippedExternalContentIsReported() -> ()
  ! CheckFailed | XmlError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let doc = run XmlDocument.parse(
    b"<!DOCTYPE r [<!ENTITY external SYSTEM 'file:///not-opened'>]><r>&external;</r>",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)

  // nonvalidating application notification
  run expect(XmlDocument.skippedExternalContent(&doc), 64)
  let skipped = XmlDocument.skippedEntities(&doc)
  run expect(
    skipped.length == 1 && String.view(&skipped[0].name) == "external" && !skipped[0].parameter
      && skipped[0].offset == 64,
    134,
  )
}

// https://www.w3.org/TR/xml/#proc-types
effect fn standaloneProcessesDeclarationsAfterSkippedParameterEntity() -> ()
  ! CheckFailed | XmlError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let doc = run XmlDocument.parse(
    b"<?xml version='1.0' standalone='yes'?><!DOCTYPE r [<!ENTITY % external SYSTEM 'not-opened'>%external;<!ATTLIST r a CDATA 'kept'>]><r/>",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)

  let skipped = doc.skippedEntities()
  run expect(
    skipped.length == 1 && skipped[0].parameter && String.view(&skipped[0].name) == "external",
    135,
  )

  // standalone exception to skipped declaration rule
  run expect(attribute(&doc, XmlDocument.root(&doc), "", "a", "kept"), 65)
}

// https://www.w3.org/TR/xml/#sec-attribute-types
// https://www.w3.org/TR/xml/#AVNormalize
effect fn declaredIdTypeSurvivesNormalization() -> ()
  ! CheckFailed | XmlError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let doc = run XmlDocument.parse(
    b"<!DOCTYPE r [<!ATTLIST r key ID #IMPLIED ref IDREF #IMPLIED id CDATA #IMPLIED>]><r key='  chosen  ' ref='chosen' id='other'/>",
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let attrs = XmlDocument.attributes(&doc, XmlDocument.root(&doc))

  // ID typing follows the declaration, not the attribute name or an IDREF value
  run expect(
    XmlDocument.attributeIsId(&doc, attrs[0])
      && equal(XmlDocument.attributeValue(&doc, attrs[0]), "chosen")
      && !XmlDocument.attributeIsId(&doc, attrs[1])
      && !XmlDocument.attributeIsId(&doc, attrs[2]),
    66,
  )
}

fn pseudoValue(attrs: &XmlPseudoAttributes, name: string, expected: string) -> bool {
  return match XmlPseudoAttributes.get(attrs, name) {
    Option<string>.Some { value } => value == expected
    _ => false
  }
}

effect fn pseudoRejected(data: string, limits: &XmlLimits, expected: XmlReason, code: i32) -> ()
  ! CheckFailed | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let result = run Effect.result(
    XmlPseudoAttributes.parse(data, limits) |> Effect.provideMut<Allocator>(&mut allocator),
  )
  run expect(
    match &result {
      Result<XmlPseudoAttributes, XmlError | OutOfMemoryError>.Failure { error } => match &error {
        XmlError problem => problem.reason == expected
        OutOfMemoryError _problem => {
          fail OutOfMemoryError {}
        }
      }
      _ => false
    },
    code,
  )
}

// https://www.w3.org/TR/2010/REC-xml-stylesheet-20101028/#NT-PseudoAtts
// https://www.w3.org/TR/2010/REC-xml-stylesheet-20101028/#NT-PseudoAtt
effect fn pseudoAttributeSeparatorsAndXmlNames() -> ()
  ! CheckFailed | XmlError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let limits = XmlLimits.make()
  let attrs = run XmlPseudoAttributes.parse(
    " \t\r\nhref \t= \n'a.css'\r\n::a:b='colon' é='unicode' A='' a='lower' ",
    &limits,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)

  // XML Name is Unicode and is not namespace-restricted
  run expect(
    pseudoValue(&attrs, "href", "a.css") && pseudoValue(&attrs, "::a:b", "colon")
      && pseudoValue(&attrs, "é", "unicode")
      && pseudoValue(&attrs, "A", "")
      && pseudoValue(&attrs, "a", "lower"),
    68,
  )
  let emptyAttrs = run XmlPseudoAttributes.parse("", &limits)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let spaceAttrs = run XmlPseudoAttributes.parse(" \t\r\n", &limits)
    |> Effect.provideMut<Allocator>(&mut allocator)

  // empty input has no attributes
  run expect(
    match &XmlPseudoAttributes.get(&emptyAttrs, "missing") {
      Option<string>.None => true
      _ => false
    },
    69,
  )

  // whitespace input is empty
  run expect(!pseudoValue(&spaceAttrs, "missing", ""), 70)
  run pseudoRejected("a='x'b='y'", &limits, XmlReason.Syntax, 71)
  run pseudoRejected("a='x'\x0bb='y'", &limits, XmlReason.Syntax, 72)
  run pseudoRejected("a x='y'", &limits, XmlReason.Syntax, 73)
  run pseudoRejected("1a='x'", &limits, XmlReason.InvalidName, 74)
  run pseudoRejected("a=x", &limits, XmlReason.Syntax, 75)
  run pseudoRejected("a='x", &limits, XmlReason.UnexpectedEnd, 76)
}

// https://www.w3.org/TR/2010/REC-xml-stylesheet-20101028/#dt-value
// https://www.w3.org/TR/2010/REC-xml-stylesheet-20101028/#NT-PredefEntityRef
effect fn pseudoAttributeReferencesAndLiteralWhitespace() -> ()
  ! CheckFailed | XmlError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let limits = XmlLimits.make()
  let attrs = run XmlPseudoAttributes.parse(
    "a=\"&lt;&gt;&amp;&quot;&apos;&#65;&#x1F600;\" b='\"\t\r\n &#9;&#13;&#10;&amp;lt;'",
    &limits,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)

  // only references and enclosing quotes change; literal whitespace is not normalized
  run expect(
    pseudoValue(&attrs, "a", "<>&\"'A😀") && pseudoValue(&attrs, "b", "\"\t\r\n \t\r\n&lt;"),
    77,
  )
}

// https://www.w3.org/TR/2010/REC-xml-stylesheet-20101028/#pseudo-attributes
// https://www.w3.org/TR/2010/REC-xml-stylesheet-20101028/#NT-PseudoAttValue
// https://www.w3.org/TR/xml/#wf-Legalchar
effect fn pseudoAttributeMalformedValuesAndDuplicates() -> ()
  ! CheckFailed | OutOfMemoryError {
  let limits = XmlLimits.make()
  run pseudoRejected("a='1' a='2'", &limits, XmlReason.DuplicateAttribute, 78)
  run pseudoRejected("a='&custom;'", &limits, XmlReason.UndeclaredEntity, 79)
  run pseudoRejected("a='&AMP;'", &limits, XmlReason.UndeclaredEntity, 80)
  run pseudoRejected("a='&amp'", &limits, XmlReason.Syntax, 81)
  run pseudoRejected("a='<'", &limits, XmlReason.Syntax, 82)
  run pseudoRejected("a='&#0;'", &limits, XmlReason.InvalidCharacter, 83)
  run pseudoRejected("a='&#xD800;'", &limits, XmlReason.InvalidCharacter, 84)
  run pseudoRejected("a='&#x110000;'", &limits, XmlReason.InvalidCharacter, 85)
  run pseudoRejected("a='&#;'", &limits, XmlReason.InvalidCharacter, 86)
}

// https://www.w3.org/TR/2010/REC-xml-stylesheet-20101028/#pseudo-attributes
// Host resource limits bound the retained set independently of grammar errors.
effect fn pseudoAttributeLimitsRemainDistinguishable() -> ()
  ! CheckFailed | XmlError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut limits = XmlLimits.make()
  limits.maxInputBytes = 4
  run pseudoRejected("a='x'", &limits, XmlReason.Limit, 88)
  limits = XmlLimits.make()
  limits.maxAttributes = 1
  run pseudoRejected("a='' b=''", &limits, XmlReason.Limit, 89)
  limits = XmlLimits.make()
  limits.maxStorageBytes = 1
  run pseudoRejected("a='x'", &limits, XmlReason.Limit, 90)
  limits = XmlLimits.make()
  limits.maxExpandedBytes = 3
  run pseudoRejected("a='&#x1F600;'", &limits, XmlReason.Limit, 91)
  run pseudoRejected("a='&amp;&amp;' b='&amp;&amp;'", &limits, XmlReason.Limit, 92)
  limits.maxExpandedBytes = 4
  limits.maxStorageBytes = 5
  let attrs = run XmlPseudoAttributes.parse("a='&#x1F600;'", &limits)
    |> Effect.provideMut<Allocator>(&mut allocator)

  // exact storage and expanded-byte limits are accepted
  run expect(pseudoValue(&attrs, "a", "😀"), 93)
}

// https://www.w3.org/TR/xml/#sec-guessing
// https://www.w3.org/TR/xml/#charencoding
effect fn documentRetainsDetectedEncoding() -> ()
  ! CheckFailed | XmlError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let utf8 = run XmlDocument.parse(b"<r/>") |> Effect.provideMut<Allocator>(&mut allocator)
  let utf8Bom = run XmlDocument.parse(b"\xef\xbb\xbf<r/>")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let le = run XmlDocument.parse(&[60, 0, 114, 0, 47, 0, 62, 0])
    |> Effect.provideMut<Allocator>(&mut allocator)
  let leBom = run XmlDocument.parse(&[255, 254, 60, 0, 114, 0, 47, 0, 62, 0])
    |> Effect.provideMut<Allocator>(&mut allocator)
  let be = run XmlDocument.parse(&[0, 60, 0, 114, 0, 47, 0, 62])
    |> Effect.provideMut<Allocator>(&mut allocator)
  let beBom = run XmlDocument.parse(&[254, 255, 0, 60, 0, 114, 0, 47, 0, 62])
    |> Effect.provideMut<Allocator>(&mut allocator)

  // detected byte encoding survives normalized UTF8 document storage
  run expect(
    XmlDocument.encoding(&utf8) == XmlEncoding.Utf8
      && XmlDocument.encoding(&utf8Bom) == XmlEncoding.Utf8
      && XmlDocument.encoding(&le) == XmlEncoding.Utf16Le
      && XmlDocument.encoding(&leBom) == XmlEncoding.Utf16Le
      && XmlDocument.encoding(&be) == XmlEncoding.Utf16Be
      && XmlDocument.encoding(&beBom) == XmlEncoding.Utf16Be,
    94,
  )
}

// Hosts that sample animations change attribute values after parsing.
effect fn setAttributeReplacesAndAdds() -> ()
  ! CheckFailed | XmlError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut doc = run XmlDocument.parse(b"<svg xmlns='urn:svg'><rect x='1' y='2'/><g a='3'/></svg>")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let rect = XmlNodeId { index: 1 }
  run XmlDocument.setAttribute(&mut doc, rect, "", "x", "10")
    |> Effect.provideMut<Allocator>(&mut allocator)

  // an existing value is replaced
  run expect(attribute(&doc, rect, "", "x", "10"), 95)
  run XmlDocument.setAttribute(&mut doc, rect, "urn:other", "x", "20")
    |> Effect.provideMut<Allocator>(&mut allocator)

  // a new attribute is added
  run expect(attribute(&doc, rect, "urn:other", "x", "20"), 96)

  // other attributes stay
  run expect(attribute(&doc, rect, "", "x", "10"), 97)

  // attributes after it stay
  run expect(attribute(&doc, rect, "", "y", "2"), 98)

  // one attribute was added
  run expect(XmlDocument.attributes(&doc, rect).length == 3, 99)

  // other elements keep theirs
  run expect(attribute(&doc, XmlNodeId { index: 2 }, "", "a", "3"), 100)
}

// Animation hosts write each frame's values with setAttribute and restore the parsed
// attributes before the next frame.
effect fn restoreUndoesSetAttribute() -> ()
  ! CheckFailed | XmlError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut doc = run XmlDocument.parse(b"<r a='1'><e b='2' c='3'/></r>")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let root = XmlDocument.root(&doc)
  let child = match XmlDocument.firstChild(&doc, root) {
    Option<XmlNodeId>.Some { value } => value
    _ => root
  }
  let snapshot = run XmlDocument.snapshot(&doc) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut round: usize = 0
  while round < 3 {
    run XmlDocument.setAttribute(&mut doc, root, "", "a", "changed")
      |> Effect.provideMut<Allocator>(&mut allocator)
    run XmlDocument.setAttribute(&mut doc, child, "urn:x", "added", "new")
      |> Effect.provideMut<Allocator>(&mut allocator)

    // value replaced
    run expect(attribute(&doc, root, "", "a", "changed"), 101)

    // attribute added
    run expect(attribute(&doc, child, "urn:x", "added", "new"), 102)
    let storage = XmlDocument.attributeCount(&doc)

    // snapshot matches
    run expect(
      run XmlDocument.restore(&mut doc, &snapshot) |> Effect.provideMut<Allocator>(&mut allocator),
      103,
    )

    // value restored
    run expect(attribute(&doc, root, "", "a", "1"), 104)

    // sibling attribute kept
    run expect(attribute(&doc, child, "", "b", "2"), 105)

    // moved attributes restored
    run expect(attribute(&doc, child, "", "c", "3"), 106)

    // added attribute removed
    run expect(XmlDocument.attribute(&doc, child, "urn:x", "added").isNone(), 107)

    // attribute list shrinks
    run expect(XmlDocument.attributeCount(&doc) < storage, 108)

    // parsed attribute count
    run expect(XmlDocument.attributeCount(&doc) == 3, 109)
    round = round + 1
  }
}

// https://www.w3.org/TR/xml/#sec-documents
// https://www.w3.org/TR/xml/#sec-pi
effect fn treeLinksAndKinds() -> ()
  ! CheckFailed | XmlError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let doc = run XmlDocument.parse(b"<?first a?><x:r xmlns:x='urn:x'>t<e/><!--c--></x:r><?last?>")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let root = doc.root()

  // the root follows the leading processing instruction
  run expect(root.index == 1 && doc.kind(root) == XmlNodeKind.Element, 120)

  // qualified and local names and the namespace of a prefixed element
  run expect(
    doc.qualifiedName(root) == "x:r" && doc.localName(root) == "r"
      && doc.namespaceUri(root) == "urn:x",
    121,
  )

  // processing instructions outside the root have no parent and no sibling links
  run expect(
    doc.kind(XmlNodeId { index: 0 }) == XmlNodeKind.ProcessingInstruction
      && doc.localName(XmlNodeId { index: 0 }) == "first"
      && doc.text(XmlNodeId { index: 0 }) == "a"
      && doc.parent(XmlNodeId { index: 0 }).isNone()
      && doc.nextSibling(XmlNodeId { index: 0 }).isNone()
      && doc.parent(root).isNone(),
    122,
  )

  // children are linked in document order with their kinds and parent
  let mut kinds: i32 = 0
  let mut child = doc.firstChild(root)
  while let Option<XmlNodeId>.Some { value } = child {
    let parentIsRoot = match doc.parent(value) {
      Option<XmlNodeId>.Some { value: parent } => parent.index == root.index
      _ => false
    }
    if !parentIsRoot {
      kinds = 100
    }
    if doc.kind(value) == XmlNodeKind.Text {
      kinds = kinds + 1
    } else if doc.kind(value) == XmlNodeKind.Element {
      kinds = kinds + 10
    } else if doc.kind(value) == XmlNodeKind.Comment {
      kinds = kinds + 20
    }
    child = doc.nextSibling(value)
  }
  run expect(kinds == 31 && doc.nodes().length == 6, 123)

  // out-of-range ids read as empty
  let outside = XmlNodeId { index: 99 }
  run expect(
    doc.localName(outside) == "" && doc.text(outside) == "" && doc.firstChild(outside).isNone()
      && doc.attributes(outside).length == 0,
    124,
  )
}

// XML 4.7 requires notation identifiers to reach the application; 4.2.2 exposes unparsed entities.
fn optionalText(value: &Option<String>, expected: string) -> bool {
  return match &value.* {
    Option<String>.Some { value: text } => String.view(&text) == expected
    _ => false
  }
}

effect fn dtdMetadataIsRetained() -> ()
  ! CheckFailed | XmlError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let source = r"""
<!DOCTYPE r [
<!NOTATION image PUBLIC '  image
 format  ' 'image.format'>
<!NOTATION publicOnly PUBLIC 'public'>
<!ENTITY logo SYSTEM 'logo.bin' NDATA image>
<!ENTITY logo SYSTEM 'ignored.bin' NDATA publicOnly>
<!ATTLIST r data ENTITY 'logo'>
]><r/>
"""
  let doc = run XmlDocument.parse(String.utf8Bytes(source))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let notations = XmlDocument.notations(&doc)
  run expect(notations.length == 2, 125)
  run expect(
    String.view(&notations[0].name) == "image"
      && optionalText(&notations[0].externalId.publicId, "image format")
      && optionalText(&notations[0].externalId.systemId, "image.format"),
    126,
  )
  run expect(
    optionalText(&notations[1].externalId.publicId, "public")
      && notations[1].externalId.systemId.isNone(),
    127,
  )
  let entities = XmlDocument.unparsedEntities(&doc)
  run expect(
    entities.length == 1 && String.view(&entities[0].name) == "logo"
      && String.view(&entities[0].notation) == "image"
      && entities[0].externalId.publicId.isNone()
      && optionalText(&entities[0].externalId.systemId, "logo.bin"),
    128,
  )
  run expect(attribute(&doc, doc.root(), "", "data", "logo"), 129)
}

// XML 2.8 and 3.4: parameter entities use the external-subset grammar, including conditional
// sections and parameter references inside declarations. IGNORE text is not interpreted.
effect fn parameterEntityDeclarationGrammar() -> ()
  ! CheckFailed | XmlError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let source = r"""
<!DOCTYPE r [
<!ENTITY % choice 'INCLUDE'>
<!ENTITY % type 'NMTOKENS'>
<!ENTITY % word 'ok'>
<!ENTITY % declarations "<![&#37;choice;[<!ATTLIST r a &#37;type; ' a   b '><!ENTITY value '&#37;word;'>]]><![IGNORE[ bad &#37;notDeclared; <![nested junk]]> ]]>">
%declarations;
]><r>&value;</r>
"""
  let doc = run XmlDocument.parse(String.utf8Bytes(source))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run expect(
    attribute(&doc, doc.root(), "", "a", "a b") && doc.text(XmlNodeId { index: 1 }) == "ok",
    130,
  )
  run expect(!doc.skippedExternalContent() && doc.skippedEntities().length == 0, 131)
}

// Fatal declaration errors stay typed and point at the offending normalized byte.
effect fn conditionalOnlyInParameterEntity() -> ()
  ! CheckFailed | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let result = run Effect.result(
    XmlDocument.parse(b"<!DOCTYPE r [<![INCLUDE[<!ELEMENT r EMPTY>]]>]><r/>")
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  run expect(
    match &result {
      Result<XmlDocument, XmlError | OutOfMemoryError>.Failure { error } => match &error {
        XmlError problem => problem.reason == XmlReason.Declaration && problem.offset == 13
        OutOfMemoryError _problem => {
          fail OutOfMemoryError {}
        }
      }
      _ => false
    },
    132,
  )
}

effect fn all() -> ()
  ! CheckFailed | XmlError | OutOfMemoryError {
  run dtdMetadataIsRetained()
  run parameterEntityDeclarationGrammar()
  run conditionalOnlyInParameterEntity()
  run expandedNamesAndForeignMetadata()
  run treeLinksAndKinds()
  run textNormalizationAndRetainedMisc()
  run internalEntitiesAndAttributeDefaults()
  run parameterEntitiesAndUnfetchedExternalSubset()
  run utf16DetectionAndSupplementaryCharacters()
  run malformedStructureAndCharacters()
  run laterVersionsAndUndeclaredAfterParameterEntities()
  run namespaceConstraints()
  run malformedEntityReplacement()
  run hostLimitsAreEnforced()
  run declarationsAreCheckedEvenWhenUnused()
  run predefinedDeclarationsAndDefaultFirstBinding()
  run entityBudgetCountsRepeatedReferences()
  run skippedExternalContentIsReported()
  run standaloneProcessesDeclarationsAfterSkippedParameterEntity()
  run declaredIdTypeSurvivesNormalization()
  run pseudoAttributeSeparatorsAndXmlNames()
  run pseudoAttributeReferencesAndLiteralWhitespace()
  run pseudoAttributeMalformedValuesAndDuplicates()
  run pseudoAttributeLimitsRemainDistinguishable()
  run documentRetainsDetectedEncoding()
  run setAttributeReplacesAndAdds()
  run restoreUndoesSetAttribute()
}

pub effect fn main() -> i32 {
  let result = run Effect.result(all())
  return match &result {
    Result<(), CheckFailed | XmlError | OutOfMemoryError>.Failure { error } => match &error {
      CheckFailed failure => failure.code
      XmlError _problem => 254
      OutOfMemoryError _problem => 255
    }
    _ => 0
  }
}
