import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.schedule { Schedule }
import silk.system.insecure_random { InsecureRandom }
import silk.system.monotonic_clock { MonotonicClock }
import silk.system.monotonic_clock_native { OsMonotonicClock }
import silk.core.ownership { Drop }
import silk.mem.shared { Shared }
struct Problem { code: i32 }
struct Counter { value: i32 }
struct Owner { counter: Shared<Counter> }
fn increment(counter: &mut Counter) -> i32 {
  counter.value = counter.value + 1
  return counter.value
}
fn read(counter: &Counter) -> i32 { return counter.value }
impl Drop for Owner {
  fn drop(self: &mut Owner) -> () {
    let changed = Shared<Counter>.withMut<i32>(&self.counter, increment)
    return ()
  }
}
fn owner(counter: &Shared<Counter>) -> Owner {
  return Owner { counter: Shared<Counter>.clone(counter) }
}
effect fn acquiring<A, E>(self: once Effect<A ! E>, counter: &Shared<Counter>) -> A ! E {
  let held = owner(counter)
  let value = run move self
  drop held
  return move value
}
effect fn holding<A, E>(self: once Effect<A ! E>, held: Owner) -> A ! E {
  let value = run move self
  drop held
  return move value
}
effect fn failing() -> i32 ! Problem { fail Problem { code: 7 } }
effect fn succeeding() -> i32 ! Problem { return 7 }
effect fn recover(error: Problem) -> i32 { return error.code }
effect fn build() -> i32 ! OutOfMemoryError ? &mut MonotonicClock | &mut InsecureRandom {
  let mut allocator = Allocator.systemAllocatorProvider()
  let counter = run Shared<Counter>.make(Counter { value: 0 })
    |> Effect.provideMut<Allocator>(&mut allocator)
  let a = run Effect.catchAll(acquiring(failing(), &counter), recover)
  let b = run Effect.catchAll(acquiring(succeeding(), &counter), recover)
  let c = run Effect.catchAll(holding(failing(), owner(&counter)), recover)
  let d = run Effect.catchAll(holding(succeeding(), owner(&counter)), recover)
  let twice = Schedule.recurs(2)
  let retried = acquiring(failing(), &counter) |> Effect.retry(&twice)
  let e = run Effect.catchAll(move retried, recover)
  let count = Shared<Counter>.with<i32>(&counter, read)
  drop counter
  if a + b + c + d + e != 35 { return 1 }
  if count != 7 { return 2 }
  return 42
}
effect fn recoverAllocation(error: OutOfMemoryError) -> i32 { return -1 }
pub fn main() -> i32 {
  let mut random = InsecureRandom.seeded(1)
  let mut clock = OsMonotonicClock.make()
  return run Effect.catchAll(build(), recoverAllocation)
    |> Effect.provideMut<InsecureRandom>(&mut random)
    |> Effect.provideMut<MonotonicClock>(&mut clock)
}