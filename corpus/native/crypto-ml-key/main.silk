import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.crypto.ml_dsa { MlDsa, MlDsaError, MlDsaParameters }
import silk.crypto.ml_kem { MlKem, MlKemError, MlKemParameters }
import silk.crypto.ml_key { MlKeyAlgorithm, MlKeyDer, MlKeyError, MlPrivateKeyDer, MlPublicKeyDer }
import silk.crypto.sha3 { Sha3_256 }

fn equal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut i: usize = 0
  while i < left.length {
    if left[i] != right[i] {
      return false
    }
    i = i + 1
  }
  return true
}

// `whole` is `first` followed by `second` from `offset` on.
fn joined(whole: &[u8], offset: usize, part: &[u8]) -> bool {
  if offset + part.length > whole.length {
    return false
  }
  return equal(Slice.view<u8>(whole, offset, part.length), part)
}

fn parameters(rank: i32) -> MlKemParameters {
  if rank == 2 {
    return MlKemParameters.MlKem512
  }
  if rank == 3 {
    return MlKemParameters.MlKem768
  }
  return MlKemParameters.MlKem1024
}

fn dsaParameters(level: i32) -> MlDsaParameters {
  if level == 44 {
    return MlDsaParameters.MlDsa44
  }
  if level == 65 {
    return MlDsaParameters.MlDsa65
  }
  return MlDsaParameters.MlDsa87
}

// The algorithm of a test case: 2, 3, and 4 are the ML-KEM ranks, 44, 65, and 87 the ML-DSA levels.
fn algorithmOf(code: i32) -> MlKeyAlgorithm {
  if code < 10 {
    return MlKeyAlgorithm.fromMlKem(parameters(code))
  }
  return MlKeyAlgorithm.fromMlDsa(dsaParameters(code))
}

// Writes the key pair of `seed` and returns whether it was made.
fn keyPair(code: i32, seed: &[u8], publicKey: &mut [u8], privateKey: &mut [u8]) -> bool {
  if code < 10 {
    return match MlKem.keyPairFromSeed(parameters(code), seed, &mut publicKey, &mut privateKey) {
      Result<(), MlKemError>.Success { .. } => true
      Result<(), MlKemError>.Failure { error: _ } => false
    }
  }
  return match MlDsa.keyPairFromSeed(dsaParameters(code), seed, &mut publicKey, &mut privateKey) {
    Result<(), MlDsaError>.Success { .. } => true
    Result<(), MlDsaError>.Failure { error: _ } => false
  }
}

fn written(result: Result<usize, MlKeyError>) -> usize {
  return match move result {
    Result<usize, MlKeyError>.Success { value } => value
    Result<usize, MlKeyError>.Failure { error: _ } => 0
  }
}

fn view(value: &Option<&[u8]>) -> &[u8] {
  return match &value.* {
    Option<&[u8]>.Some { value: inner } => inner
    Option<&[u8]>.None => b""
  }
}

fn present(value: &Option<&[u8]>) -> bool {
  return match &value.* {
    Option<&[u8]>.Some { .. } => true
    Option<&[u8]>.None => false
  }
}

// Reads `der` and compares the forms with `seed` and `expanded`; an empty one must be absent.
fn readsBack(der: &[u8], algorithm: MlKeyAlgorithm, seed: &[u8], expanded: &[u8]) -> bool {
  return match MlKeyDer.readPkcs8(der) {
    Result<MlPrivateKeyDer, MlKeyError>.Success { value } => {
      value.algorithm == algorithm && present(&value.seed) == (seed.length != 0)
        && present(&value.expandedKey) == (expanded.length != 0) && equal(view(&value.seed), seed)
        && equal(view(&value.expandedKey), expanded)
    }
    Result<MlPrivateKeyDer, MlKeyError>.Failure { error: _ } => false
  }
}

// A key from pyca/cryptography (OpenSSL 4.0): the seed form and the public key must match its DER
// byte for byte, the expanded forms must match the prefixes built in Python, and all must read back.
fn pyca(code: i32, seed: &[u8], seedDer: &[u8], spkiHash: &[u8], expandedPrefix: &[u8], bothPrefix: &[u8], bothMiddle: &[u8]) -> i32 {
  let algorithm = algorithmOf(code)
  let mut ek: [u8; 2592] = [0; 2592]
  let mut dk: [u8; 4896] = [0; 4896]
  let ekLength = algorithm.publicKeyLength()
  let dkLength = algorithm.expandedKeyLength()
  let seedLength = algorithm.seedLength()
  let mut ekView = Slice.viewMut<u8>(&mut ek, 0, ekLength)
  let mut dkView = Slice.viewMut<u8>(&mut dk, 0, dkLength)
  if !keyPair(code, seed, &mut ekView, &mut dkView) {
    return 1
  }
  let publicKey = Slice.view<u8>(&ek, 0, ekLength)
  let decapsulationKey = Slice.view<u8>(&dk, 0, dkLength)
  let mut der: [u8; 5000] = [0; 5000]
  let none = Option<&[u8]>.none()
  let length = written(MlKeyDer.writePkcs8(algorithm, Option<&[u8]>.some(seed), none, &mut der))
  if length != MlKeyDer.pkcs8Length(algorithm, true, false) || !equal(Slice.view<u8>(&der, 0, length), seedDer) {
    return 1
  }
  if !readsBack(Slice.view<u8>(&der, 0, length), algorithm, seed, b"") {
    return 1
  }
  let none2 = Option<&[u8]>.none()
  let expandedLength = written(MlKeyDer.writePkcs8(algorithm, none2, Option<&[u8]>.some(decapsulationKey), &mut der))
  if expandedLength != MlKeyDer.pkcs8Length(algorithm, false, true)
    || expandedLength != expandedPrefix.length + dkLength
    || !joined(Slice.view<u8>(&der, 0, expandedLength), 0, expandedPrefix)
    || !joined(Slice.view<u8>(&der, 0, expandedLength), expandedPrefix.length, decapsulationKey) {
    return 1
  }
  if !readsBack(Slice.view<u8>(&der, 0, expandedLength), algorithm, b"", decapsulationKey) {
    return 1
  }
  let bothLength = written(MlKeyDer.writePkcs8(algorithm, Option<&[u8]>.some(seed), Option<&[u8]>.some(decapsulationKey), &mut der))
  let both = Slice.view<u8>(&der, 0, bothLength)
  if bothLength != MlKeyDer.pkcs8Length(algorithm, true, true)
    || bothLength != bothPrefix.length + seedLength + bothMiddle.length + dkLength || !joined(both, 0, bothPrefix)
    || !joined(both, bothPrefix.length, seed) || !joined(both, bothPrefix.length + seedLength, bothMiddle)
    || !joined(both, bothPrefix.length + seedLength + bothMiddle.length, decapsulationKey) {
    return 1
  }
  if !readsBack(both, algorithm, seed, decapsulationKey) {
    return 1
  }
  // A buffer one byte short is refused.
  let short = MlKeyDer.writePkcs8(algorithm, Option<&[u8]>.some(seed), none, Slice.viewMut<u8>(&mut der, 0, length - 1))
  if written(move short) != 0 {
    return 1
  }
  let mut spki: [u8; 2700] = [0; 2700]
  let spkiLength = written(MlKeyDer.writeSpki(algorithm, publicKey, &mut spki))
  if spkiLength != MlKeyDer.spkiLength(algorithm) {
    return 1
  }
  if spkiHash.length != 0 && !equal(&Sha3_256.hash(Slice.view<u8>(&spki, 0, spkiLength)), spkiHash) {
    return 1
  }
  return match MlKeyDer.readSpki(Slice.view<u8>(&spki, 0, spkiLength)) {
    Result<MlPublicKeyDer, MlKeyError>.Success { value } => {
      if value.algorithm == algorithm && equal(value.publicKey, publicKey) {
        0
      } else {
        1
      }
    }
    Result<MlPublicKeyDer, MlKeyError>.Failure { error: _ } => 1
  }
}

fn refusesPkcs8(der: &[u8], expected: MlKeyError) -> i32 {
  return match MlKeyDer.readPkcs8(der) {
    Result<MlPrivateKeyDer, MlKeyError>.Success { .. } => 1
    Result<MlPrivateKeyDer, MlKeyError>.Failure { error } => {
      if error == expected {
        0
      } else {
        1
      }
    }
  }
}

fn refusesSpki(der: &[u8], expected: MlKeyError) -> i32 {
  return match MlKeyDer.readSpki(der) {
    Result<MlPublicKeyDer, MlKeyError>.Success { .. } => 1
    Result<MlPublicKeyDer, MlKeyError>.Failure { error } => {
      if error == expected {
        0
      } else {
        1
      }
    }
  }
}

fn readsSeed(der: &[u8]) -> i32 {
  let seed: [u8; 64] = [0; 64]
  if readsBack(der, MlKeyAlgorithm.MlKem768, &seed, b"") {
    return 0
  }
  return 1
}

// Writers refuse keys of the wrong length and a private key with neither form.
fn writerRefusals() -> i32 {
  let mut der: [u8; 3300] = [0; 3300]
  let seed: [u8; 63] = [0; 63]
  let none = Option<&[u8]>.none()
  let none2 = Option<&[u8]>.none()
  if written(MlKeyDer.writePkcs8(MlKeyAlgorithm.MlKem768, Option<&[u8]>.some(&seed), none, &mut der)) != 0 {
    return 1
  }
  if written(MlKeyDer.writePkcs8(MlKeyAlgorithm.MlKem768, none2, Option<&[u8]>.none(), &mut der)) != 0 {
    return 1
  }
  let key: [u8; 1183] = [0; 1183]
  if written(MlKeyDer.writeSpki(MlKeyAlgorithm.MlKem768, &key, &mut der)) != 0 {
    return 1
  }
  return 0
}

