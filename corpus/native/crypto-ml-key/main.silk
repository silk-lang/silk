  let mut failures: i32 = 0
  failures = failures + pyca(3, b"\x1b\xab\xbc\x6e\x02\x1e\x34\xfe\xdb\x40\x8d\x39\x42\x18\x4c\xe8\x27\x70\x3d\x05\x68\x8f\xf5\xaa\xbd\x67\xda\xa2\xba\xd0\x6e\x6c\x43\xf4\x57\x88\x3d\x49\xae\xc2\x33\xcc\x7d\x1b\xba\x1e\x63\x1a\xdd\xe2\x8a\x48\x6d\xde\x23\x97\x5b\xb5\x8d\xa4\x84\xda\xff\x82", b"\x30\x54\x02\x01\x00\x30\x0b\x06\x09\x60\x86\x48\x01\x65\x03\x04\x04\x02\x04\x42\x80\x40\x1b\xab\xbc\x6e\x02\x1e\x34\xfe\xdb\x40\x8d\x39\x42\x18\x4c\xe8\x27\x70\x3d\x05\x68\x8f\xf5\xaa\xbd\x67\xda\xa2\xba\xd0\x6e\x6c\x43\xf4\x57\x88\x3d\x49\xae\xc2\x33\xcc\x7d\x1b\xba\x1e\x63\x1a\xdd\xe2\x8a\x48\x6d\xde\x23\x97\x5b\xb5\x8d\xa4\x84\xda\xff\x82", b"\x73\x86\x13\xa5\x47\x58\x3e\xf2\x18\x61\x7a\xf7\x2b\xea\xfb\xa0\x3d\xba\x9d\xfe\xdd\xdc\x6b\x06\xd2\xf6\x76\xa3\x48\x55\xc7\xd3", b"\x30\x82\x09\x78\x02\x01\x00\x30\x0b\x06\x09\x60\x86\x48\x01\x65\x03\x04\x04\x02\x04\x82\x09\x64\x04\x82\x09\x60", b"\x30\x82\x09\xbe\x02\x01\x00\x30\x0b\x06\x09\x60\x86\x48\x01\x65\x03\x04\x04\x02\x04\x82\x09\xaa\x30\x82\x09\xa6\x04\x40", b"\x04\x82\x09\x60")
  failures = failures + pyca(3, b"\x40\x1f\x80\x7e\x9f\xc0\x27\x4d\x72\x06\xd5\xec\x1d\xeb\x0c\x34\x04\xac\x14\x5f\x2d\xbd\xa6\xdd\x2f\x65\x65\xda\x35\x9c\xc0\xd9\xee\xd9\xc8\x3e\x1d\xd0\xd4\x22\x19\x18\x64\x39\x5a\xaa\xbd\x6e\xea\x73\x61\x9a\xf9\x55\x76\x64\x75\x94\x9e\xd5\x6a\xa1\x72\x49", b"\x30\x54\x02\x01\x00\x30\x0b\x06\x09\x60\x86\x48\x01\x65\x03\x04\x04\x02\x04\x42\x80\x40\x40\x1f\x80\x7e\x9f\xc0\x27\x4d\x72\x06\xd5\xec\x1d\xeb\x0c\x34\x04\xac\x14\x5f\x2d\xbd\xa6\xdd\x2f\x65\x65\xda\x35\x9c\xc0\xd9\xee\xd9\xc8\x3e\x1d\xd0\xd4\x22\x19\x18\x64\x39\x5a\xaa\xbd\x6e\xea\x73\x61\x9a\xf9\x55\x76\x64\x75\x94\x9e\xd5\x6a\xa1\x72\x49", b"\xed\x08\xc5\xe3\x1c\xff\x7c\x85\x84\xa5\xca\xbd\xc5\xea\xf8\x36\xa0\xd5\xbc\x1b\x3c\x8f\xf8\xf4\x44\x8f\x7b\xe5\xec\x69\xe0\xce", b"\x30\x82\x09\x78\x02\x01\x00\x30\x0b\x06\x09\x60\x86\x48\x01\x65\x03\x04\x04\x02\x04\x82\x09\x64\x04\x82\x09\x60", b"\x30\x82\x09\xbe\x02\x01\x00\x30\x0b\x06\x09\x60\x86\x48\x01\x65\x03\x04\x04\x02\x04\x82\x09\xaa\x30\x82\x09\xa6\x04\x40", b"\x04\x82\x09\x60")
  failures = failures + pyca(4, b"\xe7\x9d\xbb\x61\x57\x26\xf4\x60\x47\x1d\x4d\xa7\xf8\xd2\x37\x30\x13\xfd\x6c\x54\x89\xaa\xa3\x0f\xfa\x30\x76\x95\xc2\x5b\x7f\x13\xed\x86\x45\x78\xd0\xc3\xaf\x52\xe8\xf9\x39\x20\x71\x27\x31\xbe\x4b\xf1\x72\x08\xf3\x37\x8f\x62\x97\x18\x3d\x20\x69\x77\xbf\x0c", b"\x30\x54\x02\x01\x00\x30\x0b\x06\x09\x60\x86\x48\x01\x65\x03\x04\x04\x03\x04\x42\x80\x40\xe7\x9d\xbb\x61\x57\x26\xf4\x60\x47\x1d\x4d\xa7\xf8\xd2\x37\x30\x13\xfd\x6c\x54\x89\xaa\xa3\x0f\xfa\x30\x76\x95\xc2\x5b\x7f\x13\xed\x86\x45\x78\xd0\xc3\xaf\x52\xe8\xf9\x39\x20\x71\x27\x31\xbe\x4b\xf1\x72\x08\xf3\x37\x8f\x62\x97\x18\x3d\x20\x69\x77\xbf\x0c", b"\xc7\x5b\xdf\x2e\x08\x9f\x9a\x97\x0a\xbc\x14\x06\x47\xe5\xa0\xcb\xa9\xbf\x69\x39\xce\x12\x5a\xec\x14\xb7\xb9\xf1\x05\xe6\x6c\xe1", b"\x30\x82\x0c\x78\x02\x01\x00\x30\x0b\x06\x09\x60\x86\x48\x01\x65\x03\x04\x04\x03\x04\x82\x0c\x64\x04\x82\x0c\x60", b"\x30\x82\x0c\xbe\x02\x01\x00\x30\x0b\x06\x09\x60\x86\x48\x01\x65\x03\x04\x04\x03\x04\x82\x0c\xaa\x30\x82\x0c\xa6\x04\x40", b"\x04\x82\x0c\x60")
