import silk.core.effect { Effect }

pub enum Problem {
  TooSmall,
}

pub service Source {
  effect fn next() -> i32 ? &Source
}

pub struct Fixed {
  value: i32,
}

impl Source for Fixed {
  effect fn next(self: &Self) -> i32
    ? &Source {
    return self.value
  }
}

effect fn read() -> i32
  ? &Source {
  return run Source.next()
}

effect fn checked(value: i32) -> i32
  ! Problem {
  if value < 10 {
    fail Problem.TooSmall
  }
  return value
}

effect fn start(value: i32) -> i32 {
  return value
}

// An `effect` lambda takes its parameter from the Effect it continues and derives its own
// success, failure and requirements from its body.
effect fn doubled() -> i32
  ! Problem
  ? &Source {
  return run read()
    |> Effect.flatMap(
      effect |x| {
        let y = run checked(x)
        let z = run read()
        return y + z
      },
    )
}

effect fn small() -> i32
  ! Problem {
  return run start(3) |> Effect.flatMap(effect |x| run checked(x))
}

effect fn typed() -> i32 {
  return run start(20) |> Effect.flatMap(effect |x: i32| x + 1)
}

effect fn recovered(problem: Problem) -> i32 {
  return 100
}

pub fn main() -> i32 {
  let source = Fixed { value: 10 }
  let first = run Effect.catchAll(doubled() |> Effect.provide(&source), recovered)
  let second = run Effect.catchAll(small(), recovered)
  let third = run typed()
  if first != 20 {
    return 1
  }
  if second != 100 {
    return 2
  }
  if third != 21 {
    return 3
  }
  return first + third + 1
}
