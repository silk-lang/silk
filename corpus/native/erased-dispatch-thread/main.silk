import silk.concurrency.thread { Concurrent }
import silk.concurrency.thread_native { NativeThread, SpawnError }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }

interface Read { fn read(self: &Self) -> i32 }
struct Letter { value: i32 }
impl Read for Letter { fn read(self: &Self) -> i32 { return self.value } }
const LETTER: Letter = Letter { value: 21 }

effect fn share(letter: &'static any Read + Concurrent) -> i32 ! OutOfMemoryError | SpawnError ? &mut Allocator {
  let worker = run NativeThread.spawn(|| -> i32 { return letter.read() })
  return letter.read() + worker.join()
}
effect fn program() -> i32 ! OutOfMemoryError | SpawnError {
  let mut system = Allocator.systemAllocatorProvider()
  return run share(&LETTER) |> Effect.provideMut<Allocator>(&mut system)
}
effect fn recover(error: OutOfMemoryError | SpawnError) -> i32 { return -1 }
pub fn main() -> i32 { return run Effect.catchAll(program(), recover) }
