//! A shared borrow of a constant addresses its static image, so union values inside it,
//! nested in a struct or held directly, keep their tag and payload.

import silk.core.option { Option }

union Shape {
  Dot,
  Square { side: i32 },
  Rect { width: i32, height: i32 },
}

struct Config {
  name: i32,
  port: Option<i32>,
  shape: Shape,
}

const DEFAULTS: Config = Config { name: 1, port: Option<i32>.None, shape: Shape.Rect { width: 3, height: 4 } }
const PORTED: Config = Config { name: 2, port: Option<i32>.Some { value: 20 }, shape: Shape.Dot }
const SIDE: Shape = Shape.Square { side: 5 }

fn portOf(config: &Config) -> i32 {
  return match &config.port {
    Option<i32>.Some { value } => value
    Option<i32>.None => 0
  }
}

fn area(shape: &Shape) -> i32 {
  return match &shape.* {
    Shape.Dot => 1
    Shape.Square { side } => side * side
    Shape.Rect { width, height } => width * height
  }
}

pub fn main() -> i32 {
  // 0 + 12 + 20 + 1 + 25 - 16 = 42
  return portOf(&DEFAULTS) + area(&DEFAULTS.shape) + portOf(&PORTED) + area(&PORTED.shape) + area(&SIDE) - 16
}
