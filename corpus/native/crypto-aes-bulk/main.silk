// AES modes and streaming AES-GCM on long messages in uneven parts: every bulk path (eight blocks at a time), the
// one-block tail, partial blocks across calls, and the CTR counter carry. Each mode's outputs go
// into one SHA-256, checked against Python's `cryptography` (OpenSSL). Exit code 42 is a pass.
import silk.crypto.aes {AesCbc, AesCfb, AesCtr, AesEcb, AesError, AesOfb}
import silk.crypto.aes_gcm {AesGcmDecryptor, AesGcmEncryptor, AesGcmError}
import silk.crypto.sha2 {Sha256}
import silk.collections.slice {Slice}
import silk.core.result {Result}
import silk.num.u8
import silk.num.usize

fn lengths() -> [usize; 16] {
  return [0, 1, 15, 16, 17, 31, 32, 127, 128, 129, 143, 255, 256, 257, 1000, 4099]
}

fn message(length: usize, output: &mut [u8; 4128]) -> () {
  let mut index: usize = 0
  while index < length {
    output[index] = usize.toU8((index * 31 + length * 7 + 5) % 256)
    index = index + 1
  }
}

fn key(length: usize) -> [u8; 32] {
  let mut bytes: [u8; 32] = [0; 32]
  let mut index: usize = 0
  while index < length {
    bytes[index] = usize.toU8((index * 13 + length) % 256)
    index = index + 1
  }
  return bytes
}

fn iv(variant: usize) -> [u8; 16] {
  let mut bytes: [u8; 16] = [0; 16]
  let mut index: usize = 0
  while index < 16 {
    if variant == 0 {
      bytes[index] = usize.toU8((index * 29 + 1) % 256)
    } else if variant == 1 {
      if index < 8 {
        bytes[index] = 9
      } else {
        bytes[index] = 255
      }
    } else {
      bytes[index] = 255
    }
    index = index + 1
  }
  if variant == 1 {
    bytes[15] = 250
  } else if variant == 2 {
    bytes[15] = 252
  }
  return bytes
}

fn equal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut index: usize = 0
  while index < left.length {
    if left[index] != right[index] { return false }
    index = index + 1
  }
  return true
}

// The size of part `index` of a message of `length` bytes: an uneven first part, then
// parts of 517 or 129 bytes.
fn part(length: usize, offset: usize) -> usize {
  let mut size: usize = 129
  if offset == 0 {
    size = length % 37
  } else if offset % 2 == 1 {
    size = 517
  }
  if size > length - offset {
    size = length - offset
  }
  return size
}

fn written(result: Result<usize, AesError>) -> usize {
  return match move result {
    Result<usize, AesError>.Success { value } => value
    Result<usize, AesError>.Failure { error: _ } => 100000
  }
}

fn applied(result: Result<(), AesError>) -> bool {
  return match move result {
    Result<(), AesError>.Success { value: _ } => true
    Result<(), AesError>.Failure { error: _ } => false
  }
}

// Runs a padded CBC or ECB encryptor over the message in parts, then the decryptor over the
// ciphertext in parts, and checks the round trip. Returns the ciphertext length, or 100000.
fn blockMode(chained: bool, keyBytes: &[u8], ivBytes: &[u8], plain: &[u8], cipher: &mut [u8; 4128], back: &mut [u8; 4128]) -> usize {
  let mut total: usize = 0
  let mut offset: usize = 0
  if chained {
    if let Result.Success { value } = AesCbc.encryptor(keyBytes, ivBytes, true) {
      let mut state = move value
      while offset < plain.length {
        let size = part(plain.length, offset)
        total = total + written(state.update(Slice.view<u8>(plain, offset, size), Slice.viewMut<u8>(&mut cipher, total, 4128 - total)))
        offset = offset + size
      }
      total = total + written(state.finish(Slice.viewMut<u8>(&mut cipher, total, 4128 - total)))
    }
  } else {
    if let Result.Success { value } = AesEcb.encryptor(keyBytes, true) {
      let mut state = move value
      while offset < plain.length {
        let size = part(plain.length, offset)
        total = total + written(state.update(Slice.view<u8>(plain, offset, size), Slice.viewMut<u8>(&mut cipher, total, 4128 - total)))
        offset = offset + size
      }
      total = total + written(state.finish(Slice.viewMut<u8>(&mut cipher, total, 4128 - total)))
    }
  }
  if total > 4128 { return 100000 }
  let mut recovered: usize = 0
  offset = 0
  if chained {
    if let Result.Success { value } = AesCbc.decryptor(keyBytes, ivBytes, true) {
      let mut state = move value
      while offset < total {
        let size = part(total, offset)
        recovered = recovered + written(state.update(Slice.view<u8>(&cipher, offset, size), Slice.viewMut<u8>(&mut back, recovered, 4128 - recovered)))
        offset = offset + size
      }
      recovered = recovered + written(state.finish(Slice.viewMut<u8>(&mut back, recovered, 4128 - recovered)))
    }
  } else {
    if let Result.Success { value } = AesEcb.decryptor(keyBytes, true) {
      let mut state = move value
      while offset < total {
        let size = part(total, offset)
        recovered = recovered + written(state.update(Slice.view<u8>(&cipher, offset, size), Slice.viewMut<u8>(&mut back, recovered, 4128 - recovered)))
        offset = offset + size
      }
      recovered = recovered + written(state.finish(Slice.viewMut<u8>(&mut back, recovered, 4128 - recovered)))
    }
  }
  if recovered != plain.length { return 100000 }
  if !equal(Slice.view<u8>(&back, 0, recovered), plain) { return 100000 }
  return total
}

// Runs a stream mode (0 CTR, 1 CFB, 2 OFB) over the message in parts, then the decrypting
// direction over the ciphertext, and checks the round trip.
fn streamMode(kind: usize, keyBytes: &[u8], ivBytes: &[u8], plain: &[u8], cipher: &mut [u8; 4128], back: &mut [u8; 4128]) -> bool {
  let mut pass: usize = 0
  while pass < 2 {
    let mut offset: usize = 0
    let length = plain.length
    if kind == 0 {
      if let Result.Success { value } = AesCtr.make(keyBytes, ivBytes) {
        let mut state = move value
        while offset < length {
          let size = part(length, offset)
          if pass == 0 {
            if !applied(state.apply(Slice.view<u8>(plain, offset, size), Slice.viewMut<u8>(&mut cipher, offset, 4128 - offset))) { return false }
          } else {
            if !applied(state.apply(Slice.view<u8>(&cipher, offset, size), Slice.viewMut<u8>(&mut back, offset, 4128 - offset))) { return false }
          }
          offset = offset + size
        }
      }
    } else if kind == 1 {
      let mut made = AesCfb.encryptor(keyBytes, ivBytes)
      if pass == 1 {
        made = AesCfb.decryptor(keyBytes, ivBytes)
      }
      if let Result.Success { value } = move made {
        let mut state = move value
        while offset < length {
          let size = part(length, offset)
          if pass == 0 {
            if !applied(state.apply(Slice.view<u8>(plain, offset, size), Slice.viewMut<u8>(&mut cipher, offset, 4128 - offset))) { return false }
          } else {
            if !applied(state.apply(Slice.view<u8>(&cipher, offset, size), Slice.viewMut<u8>(&mut back, offset, 4128 - offset))) { return false }
          }
          offset = offset + size
        }
      }
    } else {
      if let Result.Success { value } = AesOfb.make(keyBytes, ivBytes) {
        let mut state = move value
        while offset < length {
          let size = part(length, offset)
          if pass == 0 {
            if !applied(state.apply(Slice.view<u8>(plain, offset, size), Slice.viewMut<u8>(&mut cipher, offset, 4128 - offset))) { return false }
          } else {
            if !applied(state.apply(Slice.view<u8>(&cipher, offset, size), Slice.viewMut<u8>(&mut back, offset, 4128 - offset))) { return false }
          }
          offset = offset + size
        }
      }
    }
    pass = pass + 1
  }
  return equal(Slice.view<u8>(&back, 0, plain.length), plain)
}

fn gcmOk(result: Result<(), AesGcmError>) -> bool {
  return match move result {
    Result<(), AesGcmError>.Success { value: _ } => true
    Result<(), AesGcmError>.Failure { error: _ } => false
  }
}

fn pattern(length: usize, step: usize) -> [u8; 64] {
  let mut bytes: [u8; 64] = [0; 64]
  let mut index: usize = 0
  while index < length {
    bytes[index] = usize.toU8((index * step + length) % 256)
    index = index + 1
  }
  return bytes
}

// Streaming AES-GCM over the message in parts, with 12-, 8- and 60-byte nonces and with and
// without AAD: the ciphertext and tag go into one SHA-256. Each message also decrypts in parts and
// verifies with the full tag and with a 12-byte prefix of it.
fn checkGcm(expected: &[u8; 32]) -> bool {
  let mut digest = Sha256.make()
  let sizes: [usize; 3] = [16, 24, 32]
  let nonceLengths: [usize; 3] = [12, 8, 60]
  let aadLengths: [usize; 2] = [0, 21]
  let mut plain: [u8; 4128] = [0; 4128]
  let mut cipher: [u8; 4128] = [0; 4128]
  let mut back: [u8; 4128] = [0; 4128]
  let mut sizeIndex: usize = 0
  while sizeIndex < 3 {
    let keyBytes = key(sizes[sizeIndex])
    let keyView = Slice.view<u8>(&keyBytes, 0, sizes[sizeIndex])
    let mut nonceIndex: usize = 0
    while nonceIndex < 3 {
      let nonceBytes = pattern(nonceLengths[nonceIndex], 11)
      let nonce = Slice.view<u8>(&nonceBytes, 0, nonceLengths[nonceIndex])
      let mut aadIndex: usize = 0
      while aadIndex < 2 {
        let aadBytes = pattern(aadLengths[aadIndex], 5)
        let aad = Slice.view<u8>(&aadBytes, 0, aadLengths[aadIndex])
        let all = lengths()
        let mut lengthIndex: usize = 0
        while lengthIndex < all.length {
          let length = all[lengthIndex]
          message(length, &mut plain)
          let mut tag: [u8; 16] = [0; 16]
          if let Result.Success { value } = AesGcmEncryptor.make(keyView, nonce, aad) {
            let mut state = move value
            let mut offset: usize = 0
            while offset < length {
              let size = part(length, offset)
              if !gcmOk(state.update(Slice.view<u8>(&plain, offset, size), Slice.viewMut<u8>(&mut cipher, offset, 4128 - offset))) { return false }
              offset = offset + size
            }
            if !gcmOk(state.finish(&mut tag)) { return false }
          } else {
            return false
          }
          digest.update(Slice.view<u8>(&cipher, 0, length))
          digest.update(&tag)
          let mut cut: usize = 0
          while cut < 2 {
            let mut tagLength: usize = 16
            if cut == 1 {
              tagLength = 12
            }
            if let Result.Success { value } = AesGcmDecryptor.make(keyView, nonce, aad) {
              let mut state = move value
              let mut offset: usize = 0
              while offset < length {
                let size = part(length, offset)
                if !gcmOk(state.update(Slice.view<u8>(&cipher, offset, size), Slice.viewMut<u8>(&mut back, offset, 4128 - offset))) { return false }
                offset = offset + size
              }
              if !gcmOk(state.finish(Slice.view<u8>(&tag, 0, tagLength))) { return false }
            } else {
              return false
            }
            if !equal(Slice.view<u8>(&back, 0, length), Slice.view<u8>(&plain, 0, length)) { return false }
            cut = cut + 1
          }
          lengthIndex = lengthIndex + 1
        }
        aadIndex = aadIndex + 1
      }
      nonceIndex = nonceIndex + 1
    }
    sizeIndex = sizeIndex + 1
  }
  let computed = digest.finish()
  return equal(&computed, expected)
}

// Mode 0 CBC, 1 ECB, 2 CTR, 3 CFB, 4 OFB. Returns false on a failed round trip or digest.
fn checkMode(mode: usize, expected: &[u8; 32]) -> bool {
  let mut digest = Sha256.make()
  let sizes: [usize; 3] = [16, 24, 32]
  let mut plain: [u8; 4128] = [0; 4128]
  let mut cipher: [u8; 4128] = [0; 4128]
  let mut back: [u8; 4128] = [0; 4128]
  let mut variants: usize = 1
  if mode == 2 {
    variants = 3
  }
  let mut sizeIndex: usize = 0
  while sizeIndex < 3 {
    let keyBytes = key(sizes[sizeIndex])
    let keyView = Slice.view<u8>(&keyBytes, 0, sizes[sizeIndex])
    let mut variant: usize = 0
    while variant < variants {
      let ivBytes = iv(variant)
      let all = lengths()
      let mut lengthIndex: usize = 0
      while lengthIndex < all.length {
        let length = all[lengthIndex]
        message(length, &mut plain)
        let input = Slice.view<u8>(&plain, 0, length)
        if mode < 2 {
          let total = blockMode(mode == 0, keyView, &ivBytes, input, &mut cipher, &mut back)
          if total > 4128 { return false }
          digest.update(Slice.view<u8>(&cipher, 0, total))
        } else {
          if !streamMode(mode - 2, keyView, &ivBytes, input, &mut cipher, &mut back) { return false }
          digest.update(Slice.view<u8>(&cipher, 0, length))
        }
        lengthIndex = lengthIndex + 1
      }
      variant = variant + 1
    }
    sizeIndex = sizeIndex + 1
  }
  let computed = digest.finish()
  return equal(&computed, expected)
}

pub fn main() -> i32 {
  let cbc: [u8; 32] = [48, 66, 172, 167, 64, 114, 69, 15, 18, 245, 130, 177, 183, 167, 66, 167, 93, 192, 96, 47, 16, 88, 121, 196, 90, 167, 63, 204, 177, 238, 243, 55]
  let ecb: [u8; 32] = [209, 36, 71, 231, 129, 163, 234, 51, 249, 85, 39, 252, 135, 125, 32, 230, 192, 34, 217, 205, 12, 142, 161, 162, 201, 246, 112, 241, 238, 157, 247, 125]
  let ctr: [u8; 32] = [229, 23, 105, 84, 52, 18, 22, 175, 142, 242, 77, 173, 130, 83, 20, 95, 125, 207, 18, 105, 201, 83, 198, 229, 119, 135, 43, 64, 30, 124, 74, 181]
  let cfb: [u8; 32] = [139, 123, 229, 174, 73, 114, 216, 188, 237, 80, 231, 52, 192, 0, 191, 173, 155, 98, 155, 66, 239, 138, 108, 6, 26, 26, 142, 199, 46, 123, 245, 29]
  let ofb: [u8; 32] = [248, 114, 109, 187, 220, 58, 147, 28, 4, 27, 183, 65, 58, 85, 199, 164, 107, 3, 150, 79, 148, 56, 60, 236, 141, 27, 45, 134, 83, 115, 175, 25]
  let gcm: [u8; 32] = [251, 39, 36, 45, 240, 176, 97, 172, 232, 25, 248, 163, 212, 189, 8, 53, 121, 248, 129, 189, 130, 70, 172, 246, 225, 192, 41, 44, 160, 158, 174, 217]
  if !checkMode(0, &cbc) { return 1 }
  if !checkMode(1, &ecb) { return 2 }
  if !checkMode(2, &ctr) { return 3 }
  if !checkMode(3, &cfb) { return 4 }
  if !checkMode(4, &ofb) { return 5 }
  if !checkGcm(&gcm) { return 6 }
  return 42
}
