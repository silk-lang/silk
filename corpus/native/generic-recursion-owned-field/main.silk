// Plain generic recursion into a field's payload type (GEN-006): `count<Root>` reaches
// `count<Branch>` and `count<Leaf>` through `visit`, because each lies within the owned structure
// of the type before it. A recursive type stops when the path would return to a type it holds.
import silk.mem.box {Box}
import silk.core.option {Option}
import silk.core.reflect {Reflect}

pub struct Leaf {}

pub struct Branch {
  pub child: Option<Leaf>,
}

pub struct Root {
  pub branch: Option<Branch>,
}

pub struct Node {
  pub next: Option<Box<Node>>,
}

fn count<T>() -> i32 {
  let mut total = 1
  static for field in Reflect.fields<T>() {
    total = total + visit(field)
  }
  return total
}

fn visit<Owner, Sub>(static field: Intrinsic.Field<Owner, Option<Sub>>) -> i32 {
  return count<Sub>()
}

pub fn main() -> i32 {
  if count<Root>() != 3 { return 1 }
  if count<Node>() != 2 { return 2 }
  return 0
}
