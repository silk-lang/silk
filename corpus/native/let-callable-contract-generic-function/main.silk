// A written callable contract fixes the binders a named generic function leaves open, as a
// parameter of that contract does.
fn same<T>(value: T) -> T {
  return move value
}

fn pair<A, B>(left: A, right: B) -> B {
  return move right
}

pub fn main() -> i32 {
  let identity: fn(i32) -> i32 = same
  let second: fn(u8, i32) -> i32 = pair
  return identity(40) + second(1, 2) - 42
}
