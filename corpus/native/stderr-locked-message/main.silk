import silk.core.effect { Effect }
import silk.text.format { Format }
import silk.io.writer_native { StderrWriter, StdoutWriter }
import silk.io.writer { Writer, WriterError }

effect fn report(count: i32) -> () ! WriterError ? &mut Writer {
  run Writer.writeString("worker: ")
  run Format.format("{} jobs left, then a tail that does not fit in the small buffer", &(count,))
  return run Writer.writeString("\n")
}

pub effect fn main() -> i32 ! WriterError {
  StderrWriter.print("width = {}\n", &(80,))
  let mut buffer: [u8; 16] = [0; 16]
  let mut stderr = StderrWriter.lock(&mut buffer)
  run Writer.writeString("held ") |> Effect.provideMut<Writer>(&mut stderr)
  // The lock is recursive, and the nested message goes out before the held bytes.
  StderrWriter.print("nested\n", &())
  let mut plain = StderrWriter.make()
  run Writer.writeString("plain\n") |> Effect.provideMut<Writer>(&mut plain)
  run report(3) |> Effect.provideMut<Writer>(&mut stderr)
  run Writer.writeString("tail\n") |> Effect.provideMut<Writer>(&mut stderr)
  run Writer.flush() |> Effect.provideMut<Writer>(&mut stderr)
  run Writer.writeString("dropped\n") |> Effect.provideMut<Writer>(&mut stderr)
  drop stderr
  let mut empty: [u8; 0] = []
  let mut unbuffered = StderrWriter.lock(&mut empty)
  run Writer.writeString("unbuffered\n") |> Effect.provideMut<Writer>(&mut unbuffered)
  drop unbuffered
  let mut out = StdoutWriter.make()
  run Writer.writeString("done\n") |> Effect.provideMut<Writer>(&mut out)
  return 0
}
