const PRIMES: [i32; 3] = [2, 3, 5]

// A borrow of a constant that fills no inferred binder keeps its local region, so a binding or
// slot that starts on a constant can later hold a shorter local loan.
fn put<'a>(values: &'a [i32], slot: &mut &'a [i32]) -> () {
  slot.* = values
  return ()
}

fn annotated() -> i32 {
  let local = [7, 8]
  let mut view: &[i32] = &PRIMES
  let shorter: &[i32] = &local
  view = shorter
  return view[0]
}

fn inferred() -> i32 {
  let local = [9, 0, 0]
  let mut view = &PRIMES
  view = &local
  return view[0]
}

fn stored() -> i32 {
  let local = [4]
  let mut slot: &[i32] = &local
  put(&PRIMES, &mut slot)
  return slot[2]
}

pub fn main() -> i32 {
  // 7 + 9 + 5 = 21.
  return annotated() + inferred() + stored() + 21
}
