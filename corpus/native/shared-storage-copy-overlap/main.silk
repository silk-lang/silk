import silk.mem.pointer { Pointer }
import silk.mem.raw_buffer { RawBuffer }

// The C fixture supplies a valid sealed header over its live allocation. Only the header is
// exclusively borrowed; RawBuffer.copy explicitly admits overlapping initialized ranges.
export "C" fn storage_copy_probe(raw: *mut u8, offset: usize, source: [*]const i32, available: usize, count: usize) -> () {
  let mut headerAnchor = ()
  let sourceAnchor = ()
  unsafe {
    let pointer = Intrinsic.pointerReinterpret<*mut u8, *mut Intrinsic.RawBuffer<i32>>(raw)
    let destination = Pointer.borrowMut<(), Intrinsic.RawBuffer<i32>>(&mut headerAnchor, pointer)
    let values = Pointer.borrowMany<(), i32>(&sourceAnchor, source, available)
    RawBuffer.copy<i32>(&mut destination, offset, values, count)
  }
  return ()
}
unsafe extern "C" fn storage_copy_exercise() -> i32
pub fn main() -> i32 { return unsafe storage_copy_exercise() }
