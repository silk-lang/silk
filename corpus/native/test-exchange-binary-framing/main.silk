import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.crypto.sha2 { Sha256 }
import silk.testing.exchange as TestExchange
import silk.num.usize

effect fn verify() -> i32 ! OutOfMemoryError {
  // The plan of an empty catalog: magic, version 1, mode 2, a zero nonce, the digest, count 0.
  let digest = Sha256.make().finish()
  let mut plan: [u8; 256] = [0; 256]
  let header: [u8; 16] = [83, 76, 75, 84, 80, 76, 78, 49, 1, 0, 0, 0, 2, 0, 0, 0]
  let mut at: usize = 0
  while at < 16 {
    plan[at] = header[at]
    at = at + 1
  }
  at = 0
  while at < 32 {
    plan[48 + at] = digest[at]
    at = at + 1
  }
  let mut parsed = TestExchange.openPlan(&plan)
  if !TestExchange.validate(&mut parsed, &digest, 0) { return 1 }
  let mut counted = TestExchange.openPlan(&plan)
  if TestExchange.validate(&mut counted, &digest, 1) { return 2 }

  let mut malformed = plan
  malformed[0] = 0
  let rejected = TestExchange.openPlan(&malformed)
  if !TestExchange.failed(&rejected) { return 3 }

  let mut allocator = Allocator.systemAllocatorProvider()
  let receipt = run TestExchange.beginReceipt(&plan)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let bytes = run TestExchange.finishReceipt(move receipt, 2, 2, 1, 1, 2, 0, 0)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if Bytes.length(&bytes) != 256 { return 4 }
  let view = Bytes.asSlice(&bytes)
  if view[0] != 83 || view[7] != 49 || view[8] != 1 || view[12] != 2 || view[96] != 1 || view[255] != 0 { return 5 }
  return 42
}

effect fn recover(error: OutOfMemoryError) -> i32 { return 6 }

pub fn main() -> i32 { return run Effect.catchAll(verify(), recover) }
