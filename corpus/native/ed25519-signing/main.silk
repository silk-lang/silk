import silk.crypto.ed25519 {Ed25519Error, Ed25519PrivateKey, Ed25519PublicKey}
import silk.core.effect {Effect}
import silk.core.result {Result}
import silk.system.random {Random}
import silk.num.usize

// Deterministic test double only. Production code must supply a CSPRNG implementation.
struct ScriptedRandom {
  next: u8,
}

impl Random for ScriptedRandom {
  effect fn fillBytes(self: &mut Self, output: &mut [u8]) -> () {
    let mut index = usize.ZERO
    while index < output.length {
      output[index] = self.next
      index = index + usize.ONE
    }
    return ()
  }
}

fn sameBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut index = usize.ZERO
  while index < left.length {
    if left[index] != right[index] { return false }
    index = index + usize.ONE
  }
  return true
}

fn verifies(publicKey: &[u8], message: &[u8], signature: &[u8]) -> bool {
  return match Ed25519PublicKey.fromBytes(publicKey) {
    Result<Ed25519PublicKey, Ed25519Error>.Failure {..} => false
    Result<Ed25519PublicKey, Ed25519Error>.Success {value} => match value.verify(message, signature) {
      Result<(), Ed25519Error>.Success {..} => true
      Result<(), Ed25519Error>.Failure {..} => false
    }
  }
}

// Returns 0, or `code` plus the failing step. The signature must match OpenSSL byte for byte.
fn check(seed: &[u8], publicKey: &[u8], message: &[u8], expected: &[u8], code: i32) -> i32 {
  let key = match Ed25519PrivateKey.fromSeed(seed) {
    Result<Ed25519PrivateKey, Ed25519Error>.Success {value} => move value
    Result<Ed25519PrivateKey, Ed25519Error>.Failure {..} => {
      return code + 1
    }
  }
  if !sameBytes(&key.seed(), seed) { return code + 2 }
  if !sameBytes(&key.publicKey(), publicKey) { return code + 3 }
  let signature = key.sign(message)
  if !sameBytes(&signature, expected) { return code + 4 }
  if !verifies(publicKey, message, &signature) { return code + 5 }
  let mut tampered = signature
  tampered[63] = tampered[63] ^ 1
  if verifies(publicKey, message, &tampered) { return code + 6 }
  return 0
}

effect fn generated() -> i32 ? &mut Random {
  let key = run Ed25519PrivateKey.generate()
  let seed: [u8; 32] = [7; 32]
  if !sameBytes(&key.seed(), &seed) { return 1 }
  let again = match Ed25519PrivateKey.fromSeed(&seed) {
    Result<Ed25519PrivateKey, Ed25519Error>.Success {value} => move value
    Result<Ed25519PrivateKey, Ed25519Error>.Failure {..} => {
      return 2
    }
  }
  if !sameBytes(&key.publicKey(), &again.publicKey()) { return 3 }
  if !verifies(&key.publicKey(), b"generated", &key.sign(b"generated")) { return 4 }
  return 0
}

