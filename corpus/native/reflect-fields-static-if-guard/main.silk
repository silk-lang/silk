// A `static if` on the type's kind keeps `Reflect.fields` away from a union: only the selected arm
// of a static fn expands its `static for`.
import silk.core.reflect { Reflect, namedKind }

struct Pair {
  pub a: i32,
  pub b: i32,
}

union Report {
  ReachedTen,
}

static fn fieldCount<O>() -> usize {
  static if Reflect.typeKind(Reflect.typeOf<O>()) != namedKind {
    return 100
  } else {
    let mut fields: usize = 0
    static for _field in Reflect.fields<O>() {
      fields = fields + 1
    }
    return fields
  }
}

pub fn main() -> i32 {
  static if fieldCount<Pair>() == 2 && fieldCount<Report>() == 100 {
    return 42
  }
  return 1
}
