import silk.core.effect { Effect }
import silk.encoding.uuid { UuidError }
import silk.http.hpack { HpackError }
import silk.http.http2_frame { ProtocolError }
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StdoutWriter }
import silk.text.format { Format }

// Each public std error formats with Debug, so a `main` that can fail with it reports it.
pub effect fn main() -> () ! WriterError {
  let mut out = StdoutWriter.make()
  let uuid = UuidError.ClockSequenceOutOfRange
  let hpack = HpackError { offset: 3, limit: true }
  let frame = ProtocolError { code: 1, stream: 5 }
  run Format.format("{:?}\n{:?}\n{:?}\n", &(uuid, move hpack, frame)) |> Effect.provideMut<Writer>(&mut out)
}
