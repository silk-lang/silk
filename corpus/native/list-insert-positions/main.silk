import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.collections.list { List }

// insert accepts every index from 0 through the length; the length appends.
effect fn build() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut values = List<i32>.make()
  run List<i32>.reserveExact(&mut values, 8) |> Effect.provideMut(&mut allocator)
  run List<i32>.insert(&mut values, 0, 20) |> Effect.provideMut(&mut allocator)
  run List<i32>.insert(&mut values, 0, 10) |> Effect.provideMut(&mut allocator)
  run List<i32>.insert(&mut values, 2, 40) |> Effect.provideMut(&mut allocator)
  run List<i32>.insert(&mut values, 2, 30) |> Effect.provideMut(&mut allocator)
  if List<i32>.length(&values) != 4 { return 1 }
  if List<i32>.get(&values, 0) != 10 { return 2 }
  if List<i32>.get(&values, 1) != 20 { return 3 }
  if List<i32>.get(&values, 2) != 30 { return 4 }
  if List<i32>.get(&values, 3) != 40 { return 5 }
  return 42
}
effect fn recover(error: OutOfMemoryError) -> i32 { return 99 }
pub fn main() -> i32 { return run Effect.catchAll(build(), recover) }
