import silk.core.effect { Effect }
import silk.text.format { Format }
import silk.encoding.uuid { Uuid }
import silk.io.writer { Writer, WriterError }
import silk.num.usize

struct Capture {
  index: usize,
  valid: bool
}

impl Writer for Capture {
  effect fn writeAll(self: &mut Self, bytes: &[u8]) -> () {
    let expected = b"2ed6657d-e927-568b-95e1-2665a8aea6a2"
    let mut offset: usize = 0
    while offset < bytes.length {
      if bytes[offset] != expected[usize.remainder(self.index, 36)] {
        self.valid = false
      }
      self.index = self.index + 1
      offset = offset + 1
    }
    return ()
  }

  effect fn flush(self: &mut Self) -> () {
    return ()
  }
}

effect fn render() -> i32
  ! WriterError {
  let mut capture = Capture { index: 0, valid: true }
  let namespace = Uuid.namespaceDns()
  let value = Uuid.v5(&namespace, "www.example.com")
  run Format.display(&value) |> Effect.provideMut<Writer>(&mut capture)
  run Format.debug(&value) |> Effect.provideMut<Writer>(&mut capture)
  if !capture.valid || capture.index != 72 {
    return 1
  }
  return 0
}

effect fn recover(error: WriterError) -> i32 {
  return 2
}

pub fn main() -> i32 {
  return run Effect.catchAll(render(), recover)
}
