import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.hash { Hash }
import silk.collections.hash_map { HashMap }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.reflect { Reflect, TypeId }
import silk.testing.testing { AssertionError, Testing }

struct Box<T> {
  pub value: T,
}

struct Pair<A, B> {
  pub first: A,
  pub second: B,
}

struct AllPubStruct {
  pub x: i32,
  pub y: bool,
}

struct PrivateStruct {
  pub x: i32,
  hidden: i32,
}

union AllPubUnion {
  One { pub x: i32 },
  Two { pub y: bool },
}

union PrivateUnion {
  One { pub x: i32 },
  Two { pub x: i32, secret: u8 },
}

const i32Id: TypeId = Reflect.typeId<i32>()

fn genericIdOf<T>() -> TypeId {
  return Reflect.typeId<T>()
}

fn refId<'a>(_: &'a i32) -> TypeId {
  return Reflect.typeId<&'a i32>()
}

effect fn reflectTypeIdAtStaticAndRuntimeAndInHashMap() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let runtimeI32 = Reflect.typeId<i32>()
  run Testing.expect(&i32Id == &runtimeI32, "const TypeId equals runtime TypeId")
  run Testing.expect(&genericIdOf<i32>() == &i32Id, "generic helper preserves TypeId")
  run Testing.expect(&genericIdOf<Box<i32>>() != &genericIdOf<Box<u64>>(), "Box<i32> != Box<u64>")
  run Testing.expect(&genericIdOf<Pair<i32, bool>>() != &genericIdOf<Pair<bool, i32>>(), "Pair arg order matters")
  run Testing.expect(&genericIdOf<Pair<i32, bool>>() == &Reflect.typeId<Pair<i32, bool>>(), "identical Pairs match")

  let localValue: i32 = 9
  let borrowedId = refId(&localValue)
  let staticRefId = Reflect.typeId<&'static i32>()
  run Testing.expect(&borrowedId == &staticRefId, "lifetimes are erased in TypeId")

  let copyId: TypeId = runtimeI32
  run Testing.expect(TypeId.equals(&copyId, i32Id), "TypeId is Copy and equals works")

  let mut allocator = Allocator.systemAllocatorProvider()
  let mut table = HashMap<TypeId, i32>.make(Hash.seed(11))
  drop run HashMap<TypeId, i32>.insert(&mut table, Reflect.typeId<Box<i32>>(), 101)
    |> Effect.provideMut<Allocator>(&mut allocator)
  drop run HashMap<TypeId, i32>.insert(&mut table, Reflect.typeId<Box<u64>>(), 202)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let hit1 = HashMap<TypeId, i32>.get(&table, genericIdOf<Box<i32>>()) |> Option<i32>.unwrapOr(0)
  let hit2 = HashMap<TypeId, i32>.get(&table, genericIdOf<Box<u64>>()) |> Option<i32>.unwrapOr(0)
  let miss = HashMap<TypeId, i32>.get(&table, Reflect.typeId<i32>()) |> Option<i32>.unwrapOr(0)
  run Testing.expect(hit1 == 101 && hit2 == 202 && miss == 0, "HashMap<TypeId, i32> distinguishes TypeIds")
}

effect fn reflectPrivateFieldSupportsStructsAndUnions() -> ()
! AssertionError<'static> {
  let static sPub = Reflect.privateField<AllPubStruct>()
  let static sPriv = Reflect.privateField<PrivateStruct>()
  let static uPub = Reflect.privateField<AllPubUnion>()
  let static uPriv = Reflect.privateField<PrivateUnion>()
  run Testing.expect(sPub == "", "all-pub struct returns empty")
  run Testing.expect(sPriv == "hidden", "struct private field returns hidden")
  run Testing.expect(uPub == "", "all-pub union returns empty")
  run Testing.expect(uPriv == "secret", "union private field returns secret")
}

effect fn runAll() -> i32 ! OutOfMemoryError | AssertionError<'static> {
  run reflectTypeIdAtStaticAndRuntimeAndInHashMap()
  run reflectPrivateFieldSupportsStructsAndUnions()
  return 0
}

effect fn failed(error: OutOfMemoryError | AssertionError<'static>) -> i32 {
  drop error
  return 1
}

pub fn main() -> i32 {
  return run Effect.catchAll(runAll(), failed)
}
