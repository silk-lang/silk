// CALLABLE-001: a named generic function written with its type arguments and no argument list is
// that function's value at those arguments.
fn same<T>(value: T) -> T { return move value }
fn pick<A, B>(first: A, second: B) -> A { return move first }
fn apply(transform: fn(i32) -> i32, value: i32) -> i32 { return transform(value) }
fn generic<T, F: fn(T) -> T>(transform: F, value: T) -> T { return transform(move value) }
// A static body evaluates an instantiated function value as it does a named one.
static fn evaluated() -> i32 {
  let chosen = same<i32>
  return chosen(0)
}
pub fn main() -> i32 {
  let static zero = evaluated()
  if zero != 0 { return 2 }
  let annotated: fn(i32) -> i32 = same<i32>
  let inferred = same<i32>
  let section = pick<i32, bool>
  let a = annotated(10)
  let b = inferred(10)
  let c = apply(same<i32>, 10)
  let d = generic(same<i32>, 10)
  let e = section(2, true)
  // Angles followed by an operand, or a comparison on each of two lines, stay comparisons.
  let below = a < b
  let above = c > d
  if below || above { return 1 }
  return a + b + c + d + e
}
