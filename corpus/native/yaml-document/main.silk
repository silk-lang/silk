// Parses YAML with silk.yaml.document: block and flow collections, core-schema resolution, quoted
// and block scalars, anchors and aliases, document streams, and the offsets of errors.
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.usize
import silk.yaml.document { YamlDocument, YamlError, YamlKind, YamlNode, YamlReason }

effect fn parse(text: &[u8]) -> Option<YamlDocument> ! OutOfMemoryError ? &mut Allocator {
  return match move run Effect.result(YamlDocument.parseAll(text)) {
    Result<YamlDocument, YamlError | OutOfMemoryError>.Success {value} => Option<YamlDocument>.some(move value)
    Result<YamlDocument, YamlError | OutOfMemoryError>.Failure {error} => match move error {
      YamlError {..} => Option<YamlDocument>.none()
      OutOfMemoryError {} => { fail OutOfMemoryError {} }
    }
  }
}

// `true` if parsing `text` fails with `reason` at `offset`.
effect fn failsAt(text: &[u8], reason: YamlReason, offset: usize) -> bool ! OutOfMemoryError ? &mut Allocator {
  return match move run Effect.result(YamlDocument.parseAll(text)) {
    Result<YamlDocument, YamlError | OutOfMemoryError>.Success {..} => false
    Result<YamlDocument, YamlError | OutOfMemoryError>.Failure {error} => match move error {
      YamlError found => found.reason == reason && found.offset == offset
      OutOfMemoryError {} => { fail OutOfMemoryError {} }
    }
  }
}

fn text(document: &YamlDocument, node: Option<YamlNode>) -> string {
  return YamlDocument.stringAt(node, document) |> Option<string>.unwrapOr("<none>")
}

fn isKind(document: &YamlDocument, node: Option<YamlNode>, kind: YamlKind) -> bool {
  return match node {
    Option<YamlNode>.Some {value} => YamlDocument.kind(document, value) == kind
    Option<YamlNode>.None => false
  }
}

fn number(document: &YamlDocument, node: Option<YamlNode>) -> i64 {
  return YamlDocument.i64At(node, document) |> Option<i64>.unwrapOr(-1)
}

effect fn checks() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let source = b"name: Ada\nage: 36\nratio: 1.5e3\nhex: 0xff\nempty:\nnull: ~\non: yes\nflag: true\ninf: -.inf\nquoted: \"a\\tb\\u00e9\"\nsingle: 'it''s'\nlist:\n  - one\n  - [two, {three: 3}]\nliteral: |\n  line 1\n  line 2\nfolded: >-\n  a\n  b\nbase: &b {x: 1}\ncopy: *b\n"
  let document = match move run parse(source) {
    Option<YamlDocument>.Some {value} => move value
    Option<YamlDocument>.None => { return 1 }
  }
  let root = Option<YamlNode>.some(YamlDocument.root(&document))
  if text(&document, YamlDocument.fieldAt(root, &document, "name")) != "Ada" { return 2 }
  if number(&document, YamlDocument.fieldAt(root, &document, "age")) != 36 { return 3 }
  if !isKind(&document, YamlDocument.fieldAt(root, &document, "ratio"), YamlKind.Float) { return 4 }
  if number(&document, YamlDocument.fieldAt(root, &document, "hex")) != 255 { return 5 }
  if !isKind(&document, YamlDocument.fieldAt(root, &document, "empty"), YamlKind.Null) { return 6 }
  if !isKind(&document, YamlDocument.fieldAt(root, &document, "null"), YamlKind.Null) { return 7 }
  // YAML 1.2 reads `yes` as a string.
  if text(&document, YamlDocument.fieldAt(root, &document, "on")) != "yes" { return 8 }
  if !isKind(&document, YamlDocument.fieldAt(root, &document, "flag"), YamlKind.Bool) { return 9 }
  if text(&document, YamlDocument.fieldAt(root, &document, "quoted")) != "a\tb\u{e9}" { return 10 }
  if text(&document, YamlDocument.fieldAt(root, &document, "single")) != "it's" { return 11 }
  let list = YamlDocument.fieldAt(root, &document, "list")
  let inner = YamlDocument.fieldAt(root, &document, "list") |> itemAt(&document, 1)
  if text(&document, inner |> itemAt(&document, 0)) != "two" { return 12 }
  if number(&document, inner |> itemAt(&document, 1) |> YamlDocument.fieldAt(&document, "three")) != 3 { return 13 }
  if text(&document, list |> itemAt(&document, 0)) != "one" { return 14 }
  if text(&document, YamlDocument.fieldAt(root, &document, "literal")) != "line 1\nline 2\n" { return 15 }
  if text(&document, YamlDocument.fieldAt(root, &document, "folded")) != "a b" { return 16 }
  if number(&document, YamlDocument.fieldAt(root, &document, "copy") |> YamlDocument.fieldAt(&document, "x")) != 1 { return 17 }
  // The source spelling of a scalar that resolved to a number.
  let version = match move run parse(b"version: 1.10\n") {
    Option<YamlDocument>.Some {value} => move value
    Option<YamlDocument>.None => { return 18 }
  }
  let versionNode = YamlDocument.field(&version, YamlDocument.root(&version), "version")
  match versionNode {
    Option<YamlNode>.Some {value} => { if (YamlDocument.scalarText(&version, value) |> Option<string>.unwrapOr("")) != "1.10" { return 19 } }
    Option<YamlNode>.None => { return 19 }
  }

  let stream = match move run parse(b"--- a\n--- [b]\n...\n---\nc: d\n") {
    Option<YamlDocument>.Some {value} => move value
    Option<YamlDocument>.None => { return 20 }
  }
  if YamlDocument.documentCount(&stream) != 3 { return 21 }
  if YamlDocument.kind(&stream, YamlDocument.documentAt(&stream, 2)) != YamlKind.Mapping { return 22 }

  if !run failsAt(b"a: 1\na: 2\n", YamlReason.DuplicateKey, 5) { return 23 }
  // Mappings with many keys index them; a repeat is still found.
  let mut many = Bytes.make()
  let mut index = usize.ZERO
  while index < 40 {
    let key: [u8; 6] = [107, 65 + usize.toU8(index), 58, 32, 49, 10]
    run Bytes.append(&mut many, &key)
    index = index + usize.ONE
  }
  run Bytes.append(&mut many, b"kB: 2\n")
  if !run failsAt(Bytes.asSlice(&many), YamlReason.DuplicateKey, 240) { return 24 }
  if !run failsAt(b"a: *missing\n", YamlReason.UnknownAlias, 3) { return 25 }
  if !run failsAt(b"a:\n\t- b\n", YamlReason.TabIndentation, 4) { return 26 }
  if !run failsAt(b"a: [b\n", YamlReason.UnexpectedEnd, 3) { return 27 }
  match move run Effect.result(YamlDocument.parse(b"a\n---\nb\n")) {
    Result<YamlDocument, YamlError | OutOfMemoryError>.Success {..} => { return 28 }
    Result<YamlDocument, YamlError | OutOfMemoryError>.Failure {error} => match move error {
      YamlError found => { if found.reason != YamlReason.MultipleDocuments { return 29 } }
      OutOfMemoryError {} => { fail OutOfMemoryError {} }
    }
  }
  return 0
}

fn itemAt(node: Option<YamlNode>, document: &YamlDocument, index: usize) -> Option<YamlNode> {
  return match node {
    Option<YamlNode>.Some {value} => YamlDocument.item(document, value, index)
    Option<YamlNode>.None => Option<YamlNode>.none()
  }
}

pub effect fn main() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checks() |> Effect.provideMut<Allocator>(&mut allocator)
}
