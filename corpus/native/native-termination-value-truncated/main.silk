// The report keeps at most 1024 bytes of the error's `Debug` form, cut at a character boundary.
import silk.format { Debug, Format, Formatter }
import silk.io.writer { Writer, WriterError }

pub struct LongError {}

impl Debug for LongError {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    // One ASCII byte puts each two-byte character at an odd offset, so the 1024th byte starts one.
    run Format.write(&mut formatter, b"a")
    let mut count = 0
    while count < 600 {
      run Format.write(&mut formatter, b"\xc3\xa9")
      count = count + 1
    }
    return ()
  }
}

pub effect fn main() ! LongError {
  fail LongError {}
}
