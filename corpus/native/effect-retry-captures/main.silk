import silk.core.effect { Effect }
import silk.core.schedule { Schedule }
import silk.system.insecure_random { InsecureRandom }
import silk.system.monotonic_clock { MonotonicClock }
import silk.system.monotonic_clock_native { OsMonotonicClock }
struct Problem { code: i32 }
effect fn retrying() -> i32 ! Problem ? &mut MonotonicClock | &mut InsecureRandom {
  let mut counter = 0
  let work = effect {
    counter = counter + 1
    if counter < 3 { fail Problem { code: counter } }
    return counter
  }
  let twice = Schedule.recurs(2)
  let mut retried = move work |> Effect.retry(&twice)
  return run retried
}
effect fn recover(problem: Problem) -> i32 { return 99 }
pub fn main() -> i32 {
  let mut random = InsecureRandom.seeded(1)
  let mut clock = OsMonotonicClock.make()
  let handled = retrying() |> Effect.catchAll(recover)
  return run handled
    |> Effect.provideMut<InsecureRandom>(&mut random)
    |> Effect.provideMut<MonotonicClock>(&mut clock)
}