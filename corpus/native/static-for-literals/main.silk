import silk.core.reflect { Reflect }

struct Pair {
  pub left: i32,
  pub right: i32,
}

effect fn one() -> i32 {
  return 1
}

// Each unrolled iteration builds its own literal: this one reads the iteration's field.
fn sum<T>(value: &T) -> i32 {
  let mut total = 0
  static for field in Reflect.fields<T>() {
    let read = fn(owner: &T) -> i32 { return Intrinsic.borrowField(owner, field).* }
    total = total + read(value)
  }
  return total
}

// An `effect {}` block in a `static for` body runs once per iteration.
effect fn count() -> i32 {
  let mut total = 0
  static for _field in Reflect.fields<Pair>() {
    let got = run effect { return run one() }
    total = total + got
  }
  return total
}

pub fn main() -> i32 {
  let pair = Pair {left: 38, right: 2}
  return sum(&pair) + (run count())
}
