import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.layout { Layout }
import silk.mem.raw_buffer { RawBuffer }
import silk.core.effect { Effect }
import silk.collections.list { List }
import silk.num.usize

// A list that grows through sizes the system provider serves in different ways (on macOS,
// requests of 256 KB and more take pages of their own): every element survives each growth,
// and a large zeroed allocation reads as zero.
effect fn build() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let mut values = List<u64>.make()
  let mut index: u64 = 0
  while index < 300000 {
    run values.append(index * 3 + 1)
    index = index + 1
  }
  if values.length() != 300000 { return 1 }
  let mut at: usize = 0
  let mut sum: u64 = 0
  while at < values.length() {
    if values.get(at) != usize.toU64(at) * 3 + 1 { return 2 }
    sum = sum + values.get(at)
    at = at + 7919
  }
  // Shrinking and growing again moves between the two kinds of storage.
  values.truncate(1000)
  run values.shrinkToFit()
  if values.get(999) != 2998 { return 3 }
  run values.reserveExact(400000)
  if values.get(999) != 2998 || values.capacity() < 401000 { return 4 }

  let allocation = run Allocator.allocateZeroed(Layout { bytes: 1048576 * 8, alignment: 8 })
  let counters = unsafe RawBuffer.from<u64>(move allocation, 1048576)
  if unsafe RawBuffer.read<u64>(&counters, 0) != 0 { return 5 }
  if unsafe RawBuffer.read<u64>(&counters, 1048575) != 0 { return 6 }
  if sum == 0 { return 7 }
  return 42
}

effect fn refused(error: OutOfMemoryError) -> i32 { return 9 }

effect fn program() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run build() |> Effect.provideMut<Allocator>(&mut allocator)
}

pub fn main() -> i32 { return run Effect.catchAll(program(), refused) }
