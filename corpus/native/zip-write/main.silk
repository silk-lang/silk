// Writes a ZIP archive with ZipWriter and reads it back with ZipReader: a directory, a short file
// that is stored, an executable file, a long file that is deflated, an empty file, refused paths,
// the same members giving the same bytes, and the member count that needs ZIP64.
import silk.mem.allocator {Allocator, OutOfMemoryError, SystemAllocator}
import silk.core.effect {Effect}
import silk.compress.zip {ZipError, ZipKind, ZipMember, ZipReader, ZipWriter}
import silk.collections.bytes {Bytes}
import silk.core.option {Option}
import silk.core.result {Result}
import silk.io.writer {Writer, WriterError}
import silk.num.usize

// A `Writer` that keeps every byte in memory.
struct Collected {
  bytes: Bytes,
  allocator: SystemAllocator,
}

impl Writer for Collected {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> () ! WriterError ? &mut Writer {
    let appended = run Effect.result(Bytes.append(&mut self.bytes, value) |> Effect.provideMut<Allocator>(&mut self.allocator))
    match move appended {
      Result<(), OutOfMemoryError>.Success {..} => ()
      Result<(), OutOfMemoryError>.Failure {..} => { fail Writer.failure() }
    }
  }

  effect fn flush(self: &mut Self) -> () ! WriterError ? &mut Writer { return () }
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at: usize = 0
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + 1
  }
  return true
}

effect fn members(long: &[u8]) -> () ! ZipError | WriterError | OutOfMemoryError ? &mut Writer | &mut Allocator {
  let mut writer = ZipWriter.make()
  run ZipWriter.directory(&mut writer, b"tool-1.0.0")
  run ZipWriter.file(&mut writer, b"tool-1.0.0/README.md", b"# tool\n", false)
  run ZipWriter.file(&mut writer, b"tool-1.0.0/tool.exe", b"MZ\x90\x00", true)
  run ZipWriter.file(&mut writer, b"tool-1.0.0/LICENSE", long, false)
  run ZipWriter.file(&mut writer, b"tool-1.0.0/empty", b"", false)
  return run ZipWriter.finish(move writer)
}

effect fn archive(long: &[u8]) -> Bytes ! ZipError | WriterError | OutOfMemoryError ? &mut Allocator {
  let mut output = Collected {bytes: Bytes.make(), allocator: Allocator.systemAllocatorProvider()}
  run members(long) |> Effect.provideMut<Writer>(&mut output)
  return move output.bytes
}

// Whether adding the file `path` is refused as unsafe, with nothing written.
effect fn refused(path: &[u8]) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut output = Collected {bytes: Bytes.make(), allocator: Allocator.systemAllocatorProvider()}
  let mut writer = ZipWriter.make()
  let added = run Effect.result(ZipWriter.file(&mut writer, path, b"x", false) |> Effect.provideMut<Writer>(&mut output))
  let unsafePath = match move added {
    Result<(), ZipError | WriterError | OutOfMemoryError>.Success {..} => false
    Result<(), ZipError | WriterError | OutOfMemoryError>.Failure {error} => match move error {
      ZipError reason => reason == ZipError.UnsafePath
      WriterError _failed => false
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  return unsafePath && Bytes.length(&output.bytes) == 0
}

fn succeeded(result: Result<(), ZipError | WriterError | OutOfMemoryError>) -> bool {
  return match move result {
    Result<(), ZipError | WriterError | OutOfMemoryError>.Success {..} => true
    Result<(), ZipError | WriterError | OutOfMemoryError>.Failure {..} => false
  }
}

// Whether the writer takes 65534 members, refuses one more as needing ZIP64, and still ends an
// archive the reader opens.
effect fn limited() -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut output = Collected {bytes: Bytes.make(), allocator: Allocator.systemAllocatorProvider()}
  let mut writer = ZipWriter.make()
  let mut count: usize = 0
  while count < 65534 {
    let added = run Effect.result(ZipWriter.file(&mut writer, b"f", b"", false) |> Effect.provideMut<Writer>(&mut output))
    if !succeeded(move added) { return false }
    count = count + 1
  }
  let extra = run Effect.result(ZipWriter.file(&mut writer, b"f", b"", false) |> Effect.provideMut<Writer>(&mut output))
  let tooLarge = match move extra {
    Result<(), ZipError | WriterError | OutOfMemoryError>.Success {..} => false
    Result<(), ZipError | WriterError | OutOfMemoryError>.Failure {error} => match move error {
      ZipError reason => reason == ZipError.TooLarge
      WriterError _failed => false
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  let ended = run Effect.result(ZipWriter.finish(move writer) |> Effect.provideMut<Writer>(&mut output))
  if !succeeded(move ended) { return false }
  return match ZipReader.open(Bytes.asSlice(&output.bytes), 1048576) {
    Result<ZipReader, ZipError>.Success {..} => tooLarge
    Result<ZipReader, ZipError>.Failure {..} => false
  }
}

// The next member of `reader`, checked against what was written; 0 when it matches.
effect fn expect(reader: &mut ZipReader<'_>, name: &[u8], kind: ZipKind, executable: bool, deflated: bool, content: &[u8]) -> i32
  ! OutOfMemoryError
  ? &mut Allocator {
  let member = match ZipReader.next(&mut reader.*) {
    Result<Option<ZipMember>, ZipError>.Success {value} => match move value {
      Option<ZipMember>.Some {value: found} => move found
      Option<ZipMember>.None => { return 1 }
    }
    Result<Option<ZipMember>, ZipError>.Failure {..} => { return 2 }
  }
  if !same(member.name, name) { return 3 }
  if member.kind != kind { return 4 }
  if member.executable != executable { return 5 }
  if member.deflated != deflated { return 6 }
  if member.length != usize.toU64(content.length) { return 7 }
  let decoded = match move run Effect.result(ZipMember.content(&member)) {
    Result<Bytes, ZipError | OutOfMemoryError>.Success {value} => move value
    Result<Bytes, ZipError | OutOfMemoryError>.Failure {error} => match move error {
      ZipError _invalid => { return 8 }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  if !same(Bytes.asSlice(&decoded), content) { return 9 }
  return 0
}

effect fn check() -> i32 ! ZipError | WriterError | OutOfMemoryError ? &mut Allocator {
  let mut long = Bytes.make()
  let mut line: usize = 0
  while line < 200 {
    run Bytes.append(&mut long, b"Permission is hereby granted, free of charge.\n")
    line = line + 1
  }
  let text = Bytes.asSlice(&long)
  let written = run archive(text)
  // The long file is deflated, so the archive is far smaller than its content.
  if Bytes.length(&written) >= text.length { return 10 }
  let again = run archive(text)
  if !same(Bytes.asSlice(&written), Bytes.asSlice(&again)) { return 11 }
  let mut reader = match ZipReader.open(Bytes.asSlice(&written), 1048576) {
    Result<ZipReader, ZipError>.Success {value} => move value
    Result<ZipReader, ZipError>.Failure {..} => { return 12 }
  }
  let directory = run expect(&mut reader, b"tool-1.0.0", ZipKind.Directory, false, false, b"")
  if directory != 0 { return 20 + directory }
  let readme = run expect(&mut reader, b"tool-1.0.0/README.md", ZipKind.File, false, false, b"# tool\n")
  if readme != 0 { return 40 + readme }
  let program = run expect(&mut reader, b"tool-1.0.0/tool.exe", ZipKind.File, true, false, b"MZ\x90\x00")
  if program != 0 { return 60 + program }
  let license = run expect(&mut reader, b"tool-1.0.0/LICENSE", ZipKind.File, false, true, text)
  if license != 0 { return 80 + license }
  let empty = run expect(&mut reader, b"tool-1.0.0/empty", ZipKind.File, false, false, b"")
  if empty != 0 { return 100 + empty }
  match ZipReader.next(&mut reader) {
    Result<Option<ZipMember>, ZipError>.Success {value} => { if Option<ZipMember>.isSome(&value) { return 13 } }
    Result<Option<ZipMember>, ZipError>.Failure {..} => { return 14 }
  }
  if !(run refused(b"/absolute")) || !(run refused(b"a/../b")) || !(run refused(b"a\\b")) || !(run refused(b"dir/")) || !(run refused(b"")) { return 15 }
  if !(run limited()) { return 16 }
  return 42
}

pub effect fn main() -> i32 ! ZipError | WriterError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run check() |> Effect.provideMut<Allocator>(&mut allocator)
}
