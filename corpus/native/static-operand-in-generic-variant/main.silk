// A static value written directly as a field of a generic union's variant literal, nested or not,
// and a `run` beside it, in a body with static work.
import silk.text.string { String }

union Failure {
  Missing { option: string<'static> },
}

union Parsed<T> {
  Run { value: T },
  Failed { error: Failure },
}

static fn flag(name: string<'static>) -> string<'static> { return name }

effect fn seven() -> i64 { return 7 }

fn missing() -> Parsed<i64> {
  let static long = flag("--name")
  return Parsed<i64>.Failed { error: Failure.Missing { option: long } }
}

pub fn main() -> i32 {
  let static short = flag("-n")
  let direct = Parsed<string<'static>>.Run { value: short }
  let called = Parsed<string<'static>>.Run { value: flag("-xy") }
  let computed = Parsed<i64>.Run { value: run seven() }
  let mut total: usize = 0
  if let Parsed<string<'static>>.Run { value } = move direct { total = total + String.byteLength(value) }
  if let Parsed<string<'static>>.Run { value } = move called { total = total + String.byteLength(value) }
  if let Parsed<i64>.Run { value } = move computed { if value == 7 { total = total + 1 } }
  if let Parsed<i64>.Failed { error: Failure.Missing { option } } = missing() { total = total + String.byteLength(option) }
  if total != 12 { return 1 }
  return 0
}
