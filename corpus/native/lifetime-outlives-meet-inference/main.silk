// A result-only binder under several outlives bounds is inferred as the meet of their regions.
fn pick<'a: 'c, 'b: 'c, 'c>(x: &'a i32, y: &'b i32, first: bool) -> &'c i32 {
  if first {
    return x
  }
  return y
}

pub fn main() -> i32 {
  let a = 40
  let b = 2
  let view = &b
  let r = pick(&a, &a, false)
  let s = pick(&a, view, false)
  return r.* + s.*
}
