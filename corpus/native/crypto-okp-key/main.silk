import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.crypto.okp_key { OkpAlgorithm, OkpKeyDer, OkpKeyError, OkpPrivateKeyDer, OkpPublicKeyDer }

fn equal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut i: usize = 0
  while i < left.length {
    if left[i] != right[i] {
      return false
    }
    i = i + 1
  }
  return true
}

// A key that OpenSSL wrote: the writers give its bytes, and the readers give back the key.
fn roundTrip(algorithm: OkpAlgorithm, secret: &[u8], publicKey: &[u8], pkcs8: &[u8], spki: &[u8]) -> i32 {
  let mut buffer: [u8; 80] = [0; 80]
  let written = match OkpKeyDer.writePkcs8(algorithm, secret, &mut buffer) {
    Result<usize, OkpKeyError>.Success { value } => value
    Result<usize, OkpKeyError>.Failure {..} => {
      return 1
    }
  }
  if !equal(Slice.view<u8>(&buffer, 0, written), pkcs8) {
    return 1
  }
  let spkiWritten = match OkpKeyDer.writeSpki(algorithm, publicKey, &mut buffer) {
    Result<usize, OkpKeyError>.Success { value } => value
    Result<usize, OkpKeyError>.Failure {..} => {
      return 1
    }
  }
  if !equal(Slice.view<u8>(&buffer, 0, spkiWritten), spki) {
    return 1
  }
  let privateOk = match OkpKeyDer.readPkcs8(pkcs8) {
    Result<OkpPrivateKeyDer, OkpKeyError>.Success { value } => {
      let noPublic = match &value.publicKey {
        Option<&[u8]>.Some { .. } => false
        Option<&[u8]>.None => true
      }
      value.algorithm == algorithm && equal(value.secret, secret) && noPublic
    }
    Result<OkpPrivateKeyDer, OkpKeyError>.Failure {..} => false
  }
  let publicOk = match OkpKeyDer.readSpki(spki) {
    Result<OkpPublicKeyDer, OkpKeyError>.Success { value } => value.algorithm == algorithm && equal(value.publicKey, publicKey)
    Result<OkpPublicKeyDer, OkpKeyError>.Failure {..} => false
  }
  if !privateOk || !publicOk {
    return 1
  }
  // A secret or a key of another length is refused.
  let wrongSecret = match OkpKeyDer.writePkcs8(algorithm, Slice.view<u8>(secret, 0, secret.length - 1), &mut buffer) {
    Result<usize, OkpKeyError>.Failure { error: OkpKeyError.InvalidLength } => true
    _ => false
  }
  let wrongPublic = match OkpKeyDer.writeSpki(algorithm, Slice.view<u8>(publicKey, 1, publicKey.length - 1), &mut buffer) {
    Result<usize, OkpKeyError>.Failure { error: OkpKeyError.InvalidLength } => true
    _ => false
  }
  if !wrongSecret || !wrongPublic {
    return 1
  }
  // Every shorter prefix is refused.
  let mut cut: usize = 0
  while cut < pkcs8.length {
    let prefixOk = match OkpKeyDer.readPkcs8(Slice.view<u8>(pkcs8, 0, cut)) {
      Result<OkpPrivateKeyDer, OkpKeyError>.Failure {..} => true
      _ => false
    }
    if !prefixOk {
      return 1
    }
    cut = cut + 1
  }
  return 0
}

fn privateFails(der: &[u8], expected: OkpKeyError) -> i32 {
  return match OkpKeyDer.readPkcs8(der) {
    Result<OkpPrivateKeyDer, OkpKeyError>.Failure { error } => {
      if error == expected {
        return 0
      }
      return 1
    }
    Result<OkpPrivateKeyDer, OkpKeyError>.Success {..} => 1
  }
}

fn publicFails(der: &[u8], expected: OkpKeyError) -> i32 {
  return match OkpKeyDer.readSpki(der) {
    Result<OkpPublicKeyDer, OkpKeyError>.Failure { error } => {
      if error == expected {
        return 0
      }
      return 1
    }
    Result<OkpPublicKeyDer, OkpKeyError>.Success {..} => 1
  }
}

pub fn main() -> i32 {
  let mut failures: i32 = 0
  failures = failures + roundTrip(OkpAlgorithm.X25519, b"\xe4\xa4\x7f\xac\x6f\x81\xd1\x09\xd2\xe3\x74\xc5\xb5\x76\x2d\x87\x92\x09\x94\x53\xd7\xa3\xd8\xf8\xe3\x4d\xf7\x94\x3e\x6e\xe0\x29", b"\xb5\x9b\x6a\xae\x67\xd1\xab\x45\xec\x28\xa1\xe1\x5d\x2a\x80\xd3\xc3\xc0\x9c\x25\xbe\x08\x9a\xd2\xe3\xc1\x62\x9f\x6a\x22\x2c\x20", b"\x30\x2e\x02\x01\x00\x30\x05\x06\x03\x2b\x65\x6e\x04\x22\x04\x20\xe4\xa4\x7f\xac\x6f\x81\xd1\x09\xd2\xe3\x74\xc5\xb5\x76\x2d\x87\x92\x09\x94\x53\xd7\xa3\xd8\xf8\xe3\x4d\xf7\x94\x3e\x6e\xe0\x29", b"\x30\x2a\x30\x05\x06\x03\x2b\x65\x6e\x03\x21\x00\xb5\x9b\x6a\xae\x67\xd1\xab\x45\xec\x28\xa1\xe1\x5d\x2a\x80\xd3\xc3\xc0\x9c\x25\xbe\x08\x9a\xd2\xe3\xc1\x62\x9f\x6a\x22\x2c\x20")
  failures = failures + roundTrip(OkpAlgorithm.X25519, b"\x44\x0f\xe0\x32\x62\x1a\xc9\x20\xaa\x1f\x75\x21\x4e\x76\x6d\x55\x37\x3c\xa1\xfb\xd6\xfc\x41\xbf\x6c\xbd\x33\xae\xd0\x52\xa4\xd0", b"\xbe\xd8\xde\xab\xc6\xbc\xf7\x25\xec\xba\x50\x0c\xf3\x6f\xe3\x1f\x66\xbd\xfe\xa2\xbc\xc1\x40\x04\xb6\x25\xd3\x22\xfc\x2f\x73\x0b", b"\x30\x2e\x02\x01\x00\x30\x05\x06\x03\x2b\x65\x6e\x04\x22\x04\x20\x44\x0f\xe0\x32\x62\x1a\xc9\x20\xaa\x1f\x75\x21\x4e\x76\x6d\x55\x37\x3c\xa1\xfb\xd6\xfc\x41\xbf\x6c\xbd\x33\xae\xd0\x52\xa4\xd0", b"\x30\x2a\x30\x05\x06\x03\x2b\x65\x6e\x03\x21\x00\xbe\xd8\xde\xab\xc6\xbc\xf7\x25\xec\xba\x50\x0c\xf3\x6f\xe3\x1f\x66\xbd\xfe\xa2\xbc\xc1\x40\x04\xb6\x25\xd3\x22\xfc\x2f\x73\x0b")
  failures = failures + roundTrip(OkpAlgorithm.X448, b"\xa9\x40\xd8\xc7\x91\x4a\x84\xb4\xf7\x1e\x6f\x46\xf4\x35\xc3\x4a\x51\x55\x6c\x5f\x18\x25\x93\x27\x8b\x30\x84\xb4\x7b\x27\x7d\xd3\x9c\xa4\x19\x34\xb4\xb4\x15\x2a\x99\x5a\xd2\xcf\xe8\xf2\xe1\xfd\x65\xb8\xfe\xf3\x0f\x4c\x63\xba", b"\x9d\x6b\xe2\x28\x4d\x6a\x89\x65\x73\xad\x94\x71\x87\x49\xc7\x1d\xd5\x8b\xc5\x7d\xd6\x55\xb4\x47\x2d\x8e\x37\x9c\x25\xb0\x76\xc4\x27\xfa\x7a\x40\xf1\x9d\x99\x11\x73\xab\xd6\x07\xea\xe7\x24\xdd\x20\x1e\x3f\xd5\x28\x78\x62\xc8", b"\x30\x46\x02\x01\x00\x30\x05\x06\x03\x2b\x65\x6f\x04\x3a\x04\x38\xa9\x40\xd8\xc7\x91\x4a\x84\xb4\xf7\x1e\x6f\x46\xf4\x35\xc3\x4a\x51\x55\x6c\x5f\x18\x25\x93\x27\x8b\x30\x84\xb4\x7b\x27\x7d\xd3\x9c\xa4\x19\x34\xb4\xb4\x15\x2a\x99\x5a\xd2\xcf\xe8\xf2\xe1\xfd\x65\xb8\xfe\xf3\x0f\x4c\x63\xba", b"\x30\x42\x30\x05\x06\x03\x2b\x65\x6f\x03\x39\x00\x9d\x6b\xe2\x28\x4d\x6a\x89\x65\x73\xad\x94\x71\x87\x49\xc7\x1d\xd5\x8b\xc5\x7d\xd6\x55\xb4\x47\x2d\x8e\x37\x9c\x25\xb0\x76\xc4\x27\xfa\x7a\x40\xf1\x9d\x99\x11\x73\xab\xd6\x07\xea\xe7\x24\xdd\x20\x1e\x3f\xd5\x28\x78\x62\xc8")
  failures = failures + roundTrip(OkpAlgorithm.X448, b"\x73\xe5\xab\x1b\x0b\xcc\x84\x01\xc2\x98\x98\xe7\x6a\x60\xbb\xfa\xa3\x76\x55\xee\x89\x79\xa6\x8b\x04\x1e\x78\x2d\x66\x1e\x7a\xb5\x96\x4d\x41\x3a\x73\x0f\x04\x0d\x9e\x44\xba\x3c\xc9\xd8\x97\xae\xee\x0e\x1f\xef\xa1\x72\xc3\x28", b"\x38\xd5\x46\x36\xec\xe0\x34\xfc\xcf\x51\x3e\x5f\xee\xd3\x38\x82\x41\xb2\x4f\xae\x8a\xae\x41\xcc\x43\x83\x97\xee\x51\x4c\x97\xd5\xfa\xa3\xf1\xb2\xc1\x74\xc1\x3d\xeb\x39\xef\x73\xf0\x80\xfd\x8c\x80\x8f\xb6\xa9\x4c\x7b\xc3\x3a", b"\x30\x46\x02\x01\x00\x30\x05\x06\x03\x2b\x65\x6f\x04\x3a\x04\x38\x73\xe5\xab\x1b\x0b\xcc\x84\x01\xc2\x98\x98\xe7\x6a\x60\xbb\xfa\xa3\x76\x55\xee\x89\x79\xa6\x8b\x04\x1e\x78\x2d\x66\x1e\x7a\xb5\x96\x4d\x41\x3a\x73\x0f\x04\x0d\x9e\x44\xba\x3c\xc9\xd8\x97\xae\xee\x0e\x1f\xef\xa1\x72\xc3\x28", b"\x30\x42\x30\x05\x06\x03\x2b\x65\x6f\x03\x39\x00\x38\xd5\x46\x36\xec\xe0\x34\xfc\xcf\x51\x3e\x5f\xee\xd3\x38\x82\x41\xb2\x4f\xae\x8a\xae\x41\xcc\x43\x83\x97\xee\x51\x4c\x97\xd5\xfa\xa3\xf1\xb2\xc1\x74\xc1\x3d\xeb\x39\xef\x73\xf0\x80\xfd\x8c\x80\x8f\xb6\xa9\x4c\x7b\xc3\x3a")
  failures = failures + roundTrip(OkpAlgorithm.Ed25519, b"\x8d\x89\xac\x39\x61\xc7\xd2\x27\x2b\x9e\x99\x9c\x6b\x3d\x88\x5f\xde\xdb\x1c\x2e\xbb\x56\x07\x79\x96\x52\x1d\x1e\xb1\x22\xec\xc1", b"\x46\x70\x6a\xbe\x64\xd8\xaa\xec\x77\x18\x56\xe5\xfc\xe5\x0c\xf1\x9f\x8e\x03\x31\x90\x2e\x45\xa1\x26\x21\x2a\x79\xbd\x36\x58\x4a", b"\x30\x2e\x02\x01\x00\x30\x05\x06\x03\x2b\x65\x70\x04\x22\x04\x20\x8d\x89\xac\x39\x61\xc7\xd2\x27\x2b\x9e\x99\x9c\x6b\x3d\x88\x5f\xde\xdb\x1c\x2e\xbb\x56\x07\x79\x96\x52\x1d\x1e\xb1\x22\xec\xc1", b"\x30\x2a\x30\x05\x06\x03\x2b\x65\x70\x03\x21\x00\x46\x70\x6a\xbe\x64\xd8\xaa\xec\x77\x18\x56\xe5\xfc\xe5\x0c\xf1\x9f\x8e\x03\x31\x90\x2e\x45\xa1\x26\x21\x2a\x79\xbd\x36\x58\x4a")
  failures = failures + roundTrip(OkpAlgorithm.Ed25519, b"\x39\x84\xb4\x3e\xa9\x0d\x96\xf4\x96\x6a\x64\xe8\xea\xb0\x55\x0d\xef\x3f\xcd\xf2\xe9\x17\x5e\x88\x03\x50\xb9\x75\x9b\x3e\x49\x16", b"\x0e\xad\xd9\xf4\xbf\x35\x4b\xda\x07\xfa\x28\xd8\x3d\xec\xae\x2e\x83\x90\x08\xe9\xad\x55\x63\xda\x45\x77\x3f\x2b\x11\x6c\x6d\xf3", b"\x30\x2e\x02\x01\x00\x30\x05\x06\x03\x2b\x65\x70\x04\x22\x04\x20\x39\x84\xb4\x3e\xa9\x0d\x96\xf4\x96\x6a\x64\xe8\xea\xb0\x55\x0d\xef\x3f\xcd\xf2\xe9\x17\x5e\x88\x03\x50\xb9\x75\x9b\x3e\x49\x16", b"\x30\x2a\x30\x05\x06\x03\x2b\x65\x70\x03\x21\x00\x0e\xad\xd9\xf4\xbf\x35\x4b\xda\x07\xfa\x28\xd8\x3d\xec\xae\x2e\x83\x90\x08\xe9\xad\x55\x63\xda\x45\x77\x3f\x2b\x11\x6c\x6d\xf3")
  failures = failures + roundTrip(OkpAlgorithm.Ed448, b"\xc6\x7d\x68\x73\x90\x7b\xbd\x50\xa3\x87\xf6\x44\xb0\x44\xdc\x31\x08\x25\xfa\x8e\x89\x92\x76\xa1\x68\x66\x94\xe4\x1f\xec\x13\xb6\x66\x37\x0f\xa9\x52\x20\x92\xb2\x8f\x1d\xbf\x9f\x91\x5a\x5b\x24\xf4\x48\x96\x36\x1e\xff\xa8\xcf\xf0", b"\xb2\x9c\xf9\x7f\x50\x20\x60\x33\x4d\xce\xad\x30\xe6\x7a\xf4\xaf\x9a\x84\x89\x89\x35\x22\x16\xb7\xba\x56\xc3\x83\x63\x37\x9d\xd8\xdf\x83\xdf\x64\x6d\x9b\xd3\xb2\xf0\xf9\x02\x89\x94\x80\x71\x2b\x4c\x8c\xd3\xad\xac\x0e\x52\x33\x00", b"\x30\x47\x02\x01\x00\x30\x05\x06\x03\x2b\x65\x71\x04\x3b\x04\x39\xc6\x7d\x68\x73\x90\x7b\xbd\x50\xa3\x87\xf6\x44\xb0\x44\xdc\x31\x08\x25\xfa\x8e\x89\x92\x76\xa1\x68\x66\x94\xe4\x1f\xec\x13\xb6\x66\x37\x0f\xa9\x52\x20\x92\xb2\x8f\x1d\xbf\x9f\x91\x5a\x5b\x24\xf4\x48\x96\x36\x1e\xff\xa8\xcf\xf0", b"\x30\x43\x30\x05\x06\x03\x2b\x65\x71\x03\x3a\x00\xb2\x9c\xf9\x7f\x50\x20\x60\x33\x4d\xce\xad\x30\xe6\x7a\xf4\xaf\x9a\x84\x89\x89\x35\x22\x16\xb7\xba\x56\xc3\x83\x63\x37\x9d\xd8\xdf\x83\xdf\x64\x6d\x9b\xd3\xb2\xf0\xf9\x02\x89\x94\x80\x71\x2b\x4c\x8c\xd3\xad\xac\x0e\x52\x33\x00")
  failures = failures + roundTrip(OkpAlgorithm.Ed448, b"\x84\x60\x0d\x85\x71\xff\xda\x9c\x59\xbb\x08\x9f\xe2\x3a\x92\x55\xc6\x50\xdb\x1e\xaa\xaa\x49\x76\xb7\x6c\xb3\x92\xd0\x72\xe8\xb5\x56\xbe\x23\x25\x55\x71\x72\xca\x2d\xa0\x9f\x5a\x24\x4c\x92\xa9\x71\x0a\x53\x87\x1f\x31\xc4\x65\xf6", b"\xaa\x4d\x77\x60\x2c\x93\x94\xf3\x42\x7e\xd2\xf2\x5a\x9a\x73\xda\xd6\x0d\x60\xf4\x42\x22\x21\xc3\xa1\x73\xac\x8a\xc0\x87\x84\xa9\x47\xde\x10\x7c\x39\x3d\xa2\x4c\xe0\x5e\xd6\xed\xf8\x96\x01\x1b\xeb\x9c\xf0\xe0\x24\xcd\xef\x7b\x00", b"\x30\x47\x02\x01\x00\x30\x05\x06\x03\x2b\x65\x71\x04\x3b\x04\x39\x84\x60\x0d\x85\x71\xff\xda\x9c\x59\xbb\x08\x9f\xe2\x3a\x92\x55\xc6\x50\xdb\x1e\xaa\xaa\x49\x76\xb7\x6c\xb3\x92\xd0\x72\xe8\xb5\x56\xbe\x23\x25\x55\x71\x72\xca\x2d\xa0\x9f\x5a\x24\x4c\x92\xa9\x71\x0a\x53\x87\x1f\x31\xc4\x65\xf6", b"\x30\x43\x30\x05\x06\x03\x2b\x65\x71\x03\x3a\x00\xaa\x4d\x77\x60\x2c\x93\x94\xf3\x42\x7e\xd2\xf2\x5a\x9a\x73\xda\xd6\x0d\x60\xf4\x42\x22\x21\xc3\xa1\x73\xac\x8a\xc0\x87\x84\xa9\x47\xde\x10\x7c\x39\x3d\xa2\x4c\xe0\x5e\xd6\xed\xf8\x96\x01\x1b\xeb\x9c\xf0\xe0\x24\xcd\xef\x7b\x00")
  // RFC 8410 section 10.3: version 1 with an attribute and the public key.
  let rfc = b"\x30\x72\x02\x01\x01\x30\x05\x06\x03\x2b\x65\x70\x04\x22\x04\x20\xd4\xee\x72\xdb\xf9\x13\x58\x4a\xd5\xb6\xd8\xf1\xf7\x69\xf8\xad\x3a\xfe\x7c\x28\xcb\xf1\xd4\xfb\xe0\x97\xa8\x8f\x44\x75\x58\x42\xa0\x1f\x30\x1d\x06\x0a\x2a\x86\x48\x86\xf7\x0d\x01\x09\x09\x14\x31\x0f\x0c\x0d\x43\x75\x72\x64\x6c\x65\x20\x43\x68\x61\x69\x72\x73\x81\x21\x00\x19\xbf\x44\x09\x69\x84\xcd\xfe\x85\x41\xba\xc1\x67\xdc\x3b\x96\xc8\x50\x86\xaa\x30\xb6\xb6\xcb\x0c\x5c\x38\xad\x70\x31\x66\xe1"
  let rfcOk = match OkpKeyDer.readPkcs8(rfc) {
    Result<OkpPrivateKeyDer, OkpKeyError>.Success { value } => {
      let publicOk = match &value.publicKey {
        Option<&[u8]>.Some { value: key } => key.length == 32 && key[0] == 0x19 && key[31] == 0xe1
        Option<&[u8]>.None => false
      }
      value.algorithm == OkpAlgorithm.Ed25519 && value.secret[0] == 0xd4 && publicOk
    }
    Result<OkpPrivateKeyDer, OkpKeyError>.Failure {..} => false
  }
  if !rfcOk {
    failures = failures + 1
  }
  // The same key with version 0 may not hold a public key.
  failures = failures + privateFails(b"\x30\x72\x02\x01\x00\x30\x05\x06\x03\x2b\x65\x70\x04\x22\x04\x20\xd4\xee\x72\xdb\xf9\x13\x58\x4a\xd5\xb6\xd8\xf1\xf7\x69\xf8\xad\x3a\xfe\x7c\x28\xcb\xf1\xd4\xfb\xe0\x97\xa8\x8f\x44\x75\x58\x42\xa0\x1f\x30\x1d\x06\x0a\x2a\x86\x48\x86\xf7\x0d\x01\x09\x09\x14\x31\x0f\x0c\x0d\x43\x75\x72\x64\x6c\x65\x20\x43\x68\x61\x69\x72\x73\x81\x21\x00\x19\xbf\x44\x09\x69\x84\xcd\xfe\x85\x41\xba\xc1\x67\xdc\x3b\x96\xc8\x50\x86\xaa\x30\xb6\xb6\xcb\x0c\x5c\x38\xad\x70\x31\x66\xe1", OkpKeyError.InvalidEncoding)
  // Parameters after the identifier, NULL here, are refused.
  failures = failures + publicFails(
    b"\x30\x2c\x30\x07\x06\x03\x2b\x65\x70\x05\x00\x03\x21\x00\x19\xbf\x44\x09\x69\x84\xcd\xfe\x85\x41\xba\xc1\x67\xdc\x3b\x96\xc8\x50\x86\xaa\x30\xb6\xb6\xcb\x0c\x5c\x38\xad\x70\x31\x66\xe1",
    OkpKeyError.InvalidEncoding,
  )
  // A P-256 key is another algorithm.
  failures = failures + publicFails(
    b"\x30\x13\x30\x09\x06\x07\x2a\x86\x48\xce\x3d\x02\x01\x03\x06\x00\x04\x01\x02\x03\x04",
    OkpKeyError.UnsupportedAlgorithm,
  )
  // An Ed448 identifier with an Ed25519-sized key.
  failures = failures + publicFails(
    b"\x30\x2a\x30\x05\x06\x03\x2b\x65\x71\x03\x21\x00\x19\xbf\x44\x09\x69\x84\xcd\xfe\x85\x41\xba\xc1\x67\xdc\x3b\x96\xc8\x50\x86\xaa\x30\xb6\xb6\xcb\x0c\x5c\x38\xad\x70\x31\x66\xe1",
    OkpKeyError.InvalidLength,
  )
  // Bytes after the key.
  failures = failures + privateFails(
    b"\x30\x2e\x02\x01\x00\x30\x05\x06\x03\x2b\x65\x70\x04\x22\x04\x20\xd4\xee\x72\xdb\xf9\x13\x58\x4a\xd5\xb6\xd8\xf1\xf7\x69\xf8\xad\x3a\xfe\x7c\x28\xcb\xf1\xd4\xfb\xe0\x97\xa8\x8f\x44\x75\x58\x42\x00",
    OkpKeyError.InvalidEncoding,
  )
  if failures != 0 {
    return failures
  }
  return 42
}
