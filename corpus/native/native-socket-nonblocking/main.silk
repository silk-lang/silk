import silk.core.effect { Effect }
import silk.io.writer { Writer }
import silk.io.writer_native { StdoutWriter }
import silk.text.format { Format }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.net.address { Endpoint, IpAddress, Ipv4Address, Port }
import silk.net.socket_native {
  Accepted,
  BoundAddress,
  ConnectOptions,
  ConnectProgress,
  Connection,
  Incoming,
  ListenOptions,
  Listener,
  NativeSocketError,
  RawSocket,
  Received,
  Sent,
  listen,
  startConnect,
  startConnectUnix,
}
import silk.system.monotonic_clock { MonotonicClock }
import silk.system.monotonic_clock_native { OsMonotonicClock }
import silk.num.usize

// The descriptor of a closed socket: -1, or INVALID_SOCKET on Windows.
fn invalidDescriptor() -> RawSocket {
  static if Intrinsic.targetOperatingSystem() == "windows" { return usize.MAX } else { return -1 }
}

// The nonblocking calls never wait, so the test pauses 1 ms between tries, at most 5000 times.
const TRIES: usize = 5000

effect fn pause() -> () ? &mut MonotonicClock {
  return run MonotonicClock.waitFor(1000000)
}

effect fn connected(connection: &mut Connection) -> bool ! NativeSocketError ? &mut MonotonicClock {
  let mut tries: usize = 0
  while tries < TRIES {
    let progress = run Connection.finishConnect(&mut connection.*)
    if progress == ConnectProgress.Connected { return true }
    run pause()
    tries = tries + 1
  }
  return false
}

effect fn acceptOne(listener: &mut Listener) -> Option<Accepted> ! NativeSocketError ? &mut MonotonicClock {
  let mut tries: usize = 0
  while tries < TRIES {
    match move run Listener.tryAccept(&mut listener.*) {
      Incoming.Client { accepted } => { return Option<Accepted>.some(move accepted) }
      Incoming.WouldBlock => {}
    }
    run pause()
    tries = tries + 1
  }
  return Option<Accepted>.none()
}

// Reads until `expected.length` bytes came, and compares them. Returns false on a mismatch, an
// early end, or too many tries.
effect fn readExactly(connection: &mut Connection, expected: &[u8]) -> bool
  ! NativeSocketError
  ? &mut MonotonicClock {
  let mut received: [u8; 16] = [0; 16]
  let mut length: usize = 0
  let mut tries: usize = 0
  while length < expected.length && tries < TRIES {
    let mut chunk: [u8; 16] = [0; 16]
    match move run Connection.tryRead(&mut connection.*, &mut chunk) {
      Received.Data { count } => {
        let mut index: usize = 0
        while index < count {
          if length == 16 { return false }
          received[length] = chunk[index]
          length = length + 1
          index = index + 1
        }
      }
      Received.End => { return false }
      Received.WouldBlock => {
        run pause()
        tries = tries + 1
      }
    }
  }
  if length != expected.length { return false }
  let mut at: usize = 0
  while at < length {
    if received[at] != expected[at] { return false }
    at = at + 1
  }
  return true
}

effect fn readsEnd(connection: &mut Connection) -> bool ! NativeSocketError ? &mut MonotonicClock {
  let mut tries: usize = 0
  while tries < TRIES {
    let mut chunk: [u8; 4] = [0; 4]
    match move run Connection.tryRead(&mut connection.*, &mut chunk) {
      Received.End => { return true }
      Received.Data { .. } => { return false }
      Received.WouldBlock => {}
    }
    run pause()
    tries = tries + 1
  }
  return false
}

effect fn isWriteClosed(attempt: Result<Sent, NativeSocketError>) -> bool {
  return match move attempt {
    Result<Sent, NativeSocketError>.Failure { error } => match move error {
      NativeSocketError.WriteClosed => true
      _ => false
    }
    _ => false
  }
}

effect fn isClosed(attempt: Result<Received, NativeSocketError>) -> bool {
  return match move attempt {
    Result<Received, NativeSocketError>.Failure { error } => match move error {
      NativeSocketError.Closed => true
      _ => false
    }
    _ => false
  }
}

// A connect to a port without a listener fails at once, or later in `finishConnect`.
effect fn refused(endpoint: Endpoint) -> bool ? &mut MonotonicClock {
  let started = run Effect.result(startConnect(endpoint, ConnectOptions.defaults()))
  let mut connection = match move started {
    Result<Connection, NativeSocketError>.Success { value } => move value
    Result<Connection, NativeSocketError>.Failure { error } => {
      return match move error {
        NativeSocketError.ConnectionRefused => true
        _ => false
      }
    }
  }
  let mut tries: usize = 0
  while tries < TRIES {
    match move run Effect.result(Connection.finishConnect(&mut connection)) {
      Result<ConnectProgress, NativeSocketError>.Success { value } => {
        if value == ConnectProgress.Connected { return false }
      }
      Result<ConnectProgress, NativeSocketError>.Failure { error } => {
        return match move error {
          NativeSocketError.ConnectionRefused => true
          _ => false
        }
      }
    }
    run pause()
    tries = tries + 1
  }
  return false
}

effect fn program() -> i32 ! NativeSocketError ? &mut MonotonicClock {
  let local = Endpoint.make(
    IpAddress.V4 { value: Ipv4Address.fromOctets([127, 0, 0, 1]) },
    Port.fromU16(0)
  )
  let mut listener = run listen(local, ListenOptions.defaults())
  let bound = match Listener.boundAddress(&listener) {
    BoundAddress.Tcp { endpoint } => endpoint
    _ => { return 10 }
  }
  if Listener.rawDescriptor(&listener) == invalidDescriptor() { return 11 }
  // No client yet.
  match move run Listener.tryAccept(&mut listener) {
    Incoming.WouldBlock => {}
    Incoming.Client { .. } => { return 12 }
  }

  let mut client = run startConnect(bound, ConnectOptions.defaults())
  if !run connected(&mut client) { return 13 }
  let accepted = match move run acceptOne(&mut listener) {
    Option<Accepted>.Some { value } => move value
    Option<Accepted>.None => { return 14 }
  }
  let mut server = Accepted.intoConnection(move accepted)
  if Connection.rawDescriptor(&client) == invalidDescriptor()
    || Connection.rawDescriptor(&server) == invalidDescriptor() { return 15 }
  if Connection.rawDescriptor(&client) == Connection.rawDescriptor(&server) { return 16 }

  // Both ends see the same pair of endpoints.
  let clientLocal = run Connection.localEndpoint(&client)
  let serverPeer = run Connection.peerEndpoint(&server)
  if Port.value(&Endpoint.port(&clientLocal)) != Port.value(&Endpoint.port(&serverPeer)) { return 17 }
  let clientPeer = run Connection.peerEndpoint(&client)
  if Port.value(&Endpoint.port(&clientPeer)) != Port.value(&Endpoint.port(&bound)) { return 18 }

  run Connection.setNoDelay(&mut client, true)
  run Connection.setNoDelay(&mut client, false)
  run Connection.setKeepAlive(&mut client, true, 30)
  run Connection.setKeepAlive(&mut client, true, 0)
  run Connection.setKeepAlive(&mut client, false, 0)

  // Nothing was sent yet.
  let mut empty: [u8; 4] = [0; 4]
  match move run Connection.tryRead(&mut server, &mut empty) {
    Received.WouldBlock => {}
    _ => { return 19 }
  }

  match move run Connection.tryWrite(&mut client, b"hello") {
    Sent.Count { count } => { if count != 5 { return 20 } }
    Sent.WouldBlock => { return 21 }
  }
  let parts: [&[u8]; 3] = [b"ab", b"", b"cd"]
  match move run Connection.tryWriteVectored(&mut client, &parts) {
    Sent.Count { count } => { if count != 4 { return 22 } }
    Sent.WouldBlock => { return 23 }
  }
  let nothing: [&[u8]; 1] = [b""]
  match move run Connection.tryWriteVectored(&mut client, &nothing) {
    Sent.Count { count } => { if count != 0 { return 24 } }
    Sent.WouldBlock => { return 25 }
  }
  if !run readExactly(&mut server, b"helloabcd") { return 26 }

  // After the client shuts down its write side, the server reads the end, and the client can
  // still read.
  run Connection.shutdownWrite(&mut client)
  run Connection.shutdownWrite(&mut client)
  if !run isWriteClosed(run Effect.result(Connection.tryWrite(&mut client, b"x"))) { return 27 }
  if !run readsEnd(&mut server) { return 28 }
  if !run readsEnd(&mut server) { return 29 }
  match move run Connection.tryWrite(&mut server, b"bye") {
    Sent.Count { count } => { if count != 3 { return 30 } }
    Sent.WouldBlock => { return 31 }
  }
  if !run readExactly(&mut client, b"bye") { return 32 }

  // The client does not read, so the server's send buffer fills.
  let block: [u8; 65536] = [7; 65536]
  let mut filled = false
  let mut writes: usize = 0
  while !filled && writes < 100000 {
    match move run Connection.tryWrite(&mut server, &block) {
      Sent.Count { .. } => { writes = writes + 1 }
      Sent.WouldBlock => { filled = true }
    }
  }
  if !filled { return 33 }

  run Connection.close(&mut client)
  if Connection.rawDescriptor(&client) != invalidDescriptor() { return 34 }
  let mut after: [u8; 4] = [0; 4]
  if !run isClosed(run Effect.result(Connection.tryRead(&mut client, &mut after))) { return 35 }
  run Connection.close(&mut server)

  // The listener's port is free after close, so a connect to it is refused.
  run Listener.close(&mut listener)
  if !run refused(bound) { return 36 }

  // A relative Unix path reaches `connect`: with no listener there, the connect fails with a
  // native error, not an invalid endpoint. Windows has no Unix sockets.
  match move run Effect.result(startConnectUnix(b"silk-corpus-missing.sock", ConnectOptions.defaults())) {
    Result<Connection, NativeSocketError>.Failure { error } => match move error {
      NativeSocketError.NativeFailure { .. } => {
        static if Intrinsic.targetOperatingSystem() == "windows" { return 37 }
      }
      NativeSocketError.FamilyUnsupported => {
        static if Intrinsic.targetOperatingSystem() != "windows" { return 38 }
      }
      _ => { return 38 }
    }
    Result<Connection, NativeSocketError>.Success { .. } => { return 39 }
  }
  return 0
}

// Prints the error, so a failed run shows it as unexpected output.
effect fn failed(error: NativeSocketError) -> i32 {
  let mut out = StdoutWriter.make()
  let printed = run Effect.result(Format.format("{:?}\n", &.(error)) |> Effect.provideMut<Writer>(&mut out))
  drop printed
  return 1
}

pub fn main() -> i32 {
  let mut clock = OsMonotonicClock.make()
  return run Effect.catchAll(program(), failed) |> Effect.provideMut<MonotonicClock>(&mut clock)
}
