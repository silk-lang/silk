import silk.concurrency.sync { Arc }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.io.logger { InMemoryLogger, LogLevel, Logger }
import silk.io.logger_native { StdoutLogger }
effect fn logAndKeep(value: i32) -> i32 {
  run Effect.logDebug("d{}", &.(value))
  return value
}
effect fn storedLog() -> i32 {
  run Effect.log("s", &())
  return 1
}
effect fn value(number: i32) -> i32 { return number }
effect fn composed() -> i32 {
  run Effect.logTrace("t", &())
  run Effect.log("i{}", &.(2))
  run Effect.logInfo("n{name}", &.{ name: "amed" })
  run Effect.logWarning("w", &())
  run Effect.logError("e", &())
  let level = LogLevel.Warning
  run Effect.logAt(level, "a", &())
  let stored = storedLog()
  let storedValue = run stored
  let tapped = run (value(20) |> Effect.tap(logAndKeep))
  if storedValue != 1 || tapped != 20 { return 2 }
  return 42
}
effect fn program() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let loggerProvider = run Logger.inMemoryProvider() |> Effect.provideMut<Allocator>(&mut allocator)
  let logger = run Arc<InMemoryLogger>.make(move loggerProvider) |> Effect.provideMut<Allocator>(&mut allocator)
  let result = run composed() |> Effect.provideAmbient<Logger>(&logger)
  if Logger.length(logger.get()) != 8 { return 1 }
  if Logger.levelAt(logger.get(), 0) != LogLevel.Trace { return 3 }
  if Logger.levelAt(logger.get(), 1) != LogLevel.Info { return 4 }
  if Logger.levelAt(logger.get(), 2) != LogLevel.Info { return 5 }
  if Logger.levelAt(logger.get(), 3) != LogLevel.Warning { return 6 }
  if Logger.levelAt(logger.get(), 4) != LogLevel.Error { return 7 }
  if Logger.levelAt(logger.get(), 5) != LogLevel.Warning { return 8 }
  if Logger.levelAt(logger.get(), 6) != LogLevel.Info { return 9 }
  if Logger.levelAt(logger.get(), 7) != LogLevel.Debug { return 10 }
  if Logger.messageLengthAt(logger.get(), 0) != 1 || Logger.messageByteAt(logger.get(), 0, 0) != 116 { return 11 }
  if Logger.messageLengthAt(logger.get(), 1) != 2 { return 12 }
  if Logger.messageByteAt(logger.get(), 1, 0) != 105 || Logger.messageByteAt(logger.get(), 1, 1) != 50 { return 13 }
  if Logger.messageLengthAt(logger.get(), 2) != 5 { return 14 }
  if Logger.messageByteAt(logger.get(), 2, 0) != 110 || Logger.messageByteAt(logger.get(), 2, 1) != 97 { return 15 }
  if Logger.messageByteAt(logger.get(), 2, 2) != 109 || Logger.messageByteAt(logger.get(), 2, 3) != 101 { return 16 }
  if Logger.messageByteAt(logger.get(), 2, 4) != 100 { return 17 }
  if Logger.messageLengthAt(logger.get(), 3) != 1 || Logger.messageByteAt(logger.get(), 3, 0) != 119 { return 18 }
  if Logger.messageLengthAt(logger.get(), 4) != 1 || Logger.messageByteAt(logger.get(), 4, 0) != 101 { return 19 }
  if Logger.messageLengthAt(logger.get(), 5) != 1 || Logger.messageByteAt(logger.get(), 5, 0) != 97 { return 20 }
  if Logger.messageLengthAt(logger.get(), 6) != 1 || Logger.messageByteAt(logger.get(), 6, 0) != 115 { return 21 }
  if Logger.messageLengthAt(logger.get(), 7) != 3 { return 22 }
  if Logger.messageByteAt(logger.get(), 7, 0) != 100 || Logger.messageByteAt(logger.get(), 7, 1) != 50 { return 23 }
  if Logger.messageByteAt(logger.get(), 7, 2) != 48 { return 24 }

  let configuredProvider = run Logger.inMemoryProviderFailAt(0) |> Effect.provideMut<Allocator>(&mut allocator)
  let configured = run Arc<InMemoryLogger>.make(move configuredProvider) |> Effect.provideMut<Allocator>(&mut allocator)
  run Effect.log("rejected {}", &.(1)) |> Effect.provideAmbient<Logger>(&configured)
  run Effect.logWarning("ok", &())
    |> Effect.provideAmbient<Logger>(&configured)
  if Logger.attempts(configured.get()) != 2 || Logger.length(configured.get()) != 1 { return 25 }
  if Logger.levelAt(configured.get(), 0) != LogLevel.Warning { return 26 }
  if Logger.messageLengthAt(configured.get(), 0) != 2 { return 27 }
  if Logger.messageByteAt(configured.get(), 0, 0) != 111 { return 28 }
  if Logger.messageByteAt(configured.get(), 0, 1) != 107 { return 29 }

  let boundedProvider = run Logger.inMemoryProvider() |> Effect.provideMut<Allocator>(&mut allocator)
  let bounded = run Arc<InMemoryLogger>.make(move boundedProvider) |> Effect.provideMut<Allocator>(&mut allocator)
  run Effect.log("xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx{}", &.(1))
      |> Effect.provideAmbient<Logger>(&bounded)
  run Effect.logError("ok", &())
    |> Effect.provideAmbient<Logger>(&bounded)
  if Logger.attempts(bounded.get()) != 2 || Logger.length(bounded.get()) != 1 { return 30 }
  if Logger.levelAt(bounded.get(), 0) != LogLevel.Error { return 31 }
  if Logger.messageLengthAt(bounded.get(), 0) != 2 { return 32 }
  if Logger.messageByteAt(bounded.get(), 0, 0) != 111 { return 33 }
  if Logger.messageByteAt(bounded.get(), 0, 1) != 107 { return 34 }
  let stdout = run Arc<StdoutLogger>.make(StdoutLogger.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  run Effect.logInfo("stdout {value}", &.{ value: 42 })
    |> Effect.provideAmbient<Logger>(&stdout)
  return result
}
effect fn recover(error: OutOfMemoryError) -> i32 { return 3 }
pub fn main() -> i32 { return run Effect.catchAll(program(), recover) }