fn select<U>(value: U, enabled: bool) -> U { return move value }
fn forward<F>(value: F) -> F { return move value }
pub fn main() -> i32 {
  let unused = forward(select(false))
  drop unused
  let pick = forward(select(true))
  let number = pick(40)
  let flag = pick(true)
  if flag { return number + 2 }
  return 0
}