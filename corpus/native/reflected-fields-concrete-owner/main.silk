// A `static for` over the fields of a concrete struct with `string` fields, outside any generic
// function. Each field capability reaches the owner's regions through the call's runtime operand.
import silk.core.reflect { Reflect }
import silk.text.string { String }
import silk.num.usize

struct Entry {
  pub name: string,
  pub count: i64,
  pub label: string,
}

fn borrowed<Owner, Value>(owner: &Owner, static field: Intrinsic.Field<Owner, Value>) -> &Value {
  return Reflect.borrowField(owner, field)
}

pub fn main() -> i32 {
  let entry = Entry { name: "abc", count: 35, label: "defg" }
  let mut total: i64 = 0
  static for field in Reflect.fields<Entry>() {
    static if Reflect.fieldLabel(field) == "count" {
      total = total + Reflect.borrowField(&entry, field).*
    } else {
      total = total + usize.toI64(String.byteLength(borrowed(&entry, field).*))
    }
  }
  if total != 42 { return 1 }
  return 0
}
