import silk.core.effect { Effect }
import silk.option { Option }
import silk.core.result { Result }

pub struct Late {}
pub struct Broken {}
pub struct Lost {}

// A failure binder instantiated with a union is widened member by member into the wider row.
effect fn race<A: 'static, E: 'static>(outcome: Result<A, E>) -> Option<A> ! E | Late {
  match move outcome {
    Result<A, E>.Success { value } => { return Option<A>.some(move value) }
    Result<A, E>.Failure { error } => { fail move error }
  }
}

effect fn attempt(failing: bool) -> i32 ! Broken | Lost | Late {
  let mut outcome = Result<i32, Broken | Lost>.succeed(40)
  if failing { outcome = Result<i32, Broken | Lost>.failResult(Lost {}) }
  let got = run race<i32, Broken | Lost>(move outcome)
  return got.unwrapOr(0)
}

effect fn classify(error: Broken | Lost | Late) -> i32 {
  match move error {
    Lost {} => { return 2 }
    _ => { return 100 }
  }
}

pub effect fn main() -> i32 {
  let succeeded = run Effect.catchAll(attempt(false), classify)
  let failed = run Effect.catchAll(attempt(true), classify)
  return succeeded + failed
}
