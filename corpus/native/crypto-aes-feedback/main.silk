import silk.crypto.aes {AesCfb, AesCfb1, AesCfb8, AesError, AesOfb}
import silk.crypto.aes_xts {AesXts, AesXtsError}
import silk.collections.slice {Slice}
import silk.core.result {Result}

fn equal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut index: usize = 0
  while index < left.length {
    if left[index] != right[index] { return false }
    index = index + 1
  }
  return true
}

fn ok(result: Result<(), AesError>) -> bool {
  return match move result {
    Result<(), AesError>.Success {value: _} => true
    Result<(), AesError>.Failure {error: _} => false
  }
}

fn xtsOk(result: Result<(), AesXtsError>) -> bool {
  return match move result {
    Result<(), AesXtsError>.Success {value: _} => true
    Result<(), AesXtsError>.Failure {error: _} => false
  }
}


// Runs `input` through a Cfb encryptor or decryptor in pieces of `step` bytes.
fn runCfb(key: &[u8], iv: &[u8], decrypting: bool, input: &[u8], step: usize, output: &mut [u8]) -> bool {
  let made = if decrypting { AesCfb.decryptor(key, iv) } else { AesCfb.encryptor(key, iv) }
  let mut cipher = match move made {
    Result<AesCfb, AesError>.Success {value} => move value
    Result<AesCfb, AesError>.Failure {error: _} => { return false }
  }
  let mut offset: usize = 0
  while offset < input.length {
    let mut length = step
    if input.length - offset < length { length = input.length - offset }
    if !ok(cipher.apply(Slice.view<u8>(input, offset, length), Slice.viewMut<u8>(&mut output, offset, length))) { return false }
    offset = offset + length
  }
  return true
}


// Runs `input` through a Cfb8 encryptor or decryptor in pieces of `step` bytes.
fn runCfb8(key: &[u8], iv: &[u8], decrypting: bool, input: &[u8], step: usize, output: &mut [u8]) -> bool {
  let made = if decrypting { AesCfb8.decryptor(key, iv) } else { AesCfb8.encryptor(key, iv) }
  let mut cipher = match move made {
    Result<AesCfb8, AesError>.Success {value} => move value
    Result<AesCfb8, AesError>.Failure {error: _} => { return false }
  }
  let mut offset: usize = 0
  while offset < input.length {
    let mut length = step
    if input.length - offset < length { length = input.length - offset }
    if !ok(cipher.apply(Slice.view<u8>(input, offset, length), Slice.viewMut<u8>(&mut output, offset, length))) { return false }
    offset = offset + length
  }
  return true
}


// Runs `input` through a Cfb1 encryptor or decryptor in pieces of `step` bytes.
fn runCfb1(key: &[u8], iv: &[u8], decrypting: bool, input: &[u8], step: usize, output: &mut [u8]) -> bool {
  let made = if decrypting { AesCfb1.decryptor(key, iv) } else { AesCfb1.encryptor(key, iv) }
  let mut cipher = match move made {
    Result<AesCfb1, AesError>.Success {value} => move value
    Result<AesCfb1, AesError>.Failure {error: _} => { return false }
  }
  let mut offset: usize = 0
  while offset < input.length {
    let mut length = step
    if input.length - offset < length { length = input.length - offset }
    if !ok(cipher.apply(Slice.view<u8>(input, offset, length), Slice.viewMut<u8>(&mut output, offset, length))) { return false }
    offset = offset + length
  }
  return true
}


fn runOfb(key: &[u8], iv: &[u8], input: &[u8], step: usize, output: &mut [u8]) -> bool {
  let mut cipher = match AesOfb.make(key, iv) {
    Result<AesOfb, AesError>.Success {value} => move value
    Result<AesOfb, AesError>.Failure {error: _} => { return false }
  }
  let mut offset: usize = 0
  while offset < input.length {
    let mut length = step
    if input.length - offset < length { length = input.length - offset }
    if !ok(cipher.apply(Slice.view<u8>(input, offset, length), Slice.viewMut<u8>(&mut output, offset, length))) { return false }
    offset = offset + length
  }
  return true
}

fn mode0() -> bool {
  let key: [u8; 16] = [3, 32, 61, 90, 119, 148, 177, 206, 235, 8, 37, 66, 95, 124, 153, 182]
  let iv: [u8; 16] = [187, 216, 245, 18, 47, 76, 105, 134, 163, 192, 221, 250, 23, 52, 81, 110]
  let plaintext: [u8; 0] = []
  let ciphertext: [u8; 0] = []
  let mut output: [u8; 0] = [0; 0]
  if !runCfb(&key, &iv, false, &plaintext, 1, &mut output) { return false }
  if !equal(&output, &ciphertext) { return false }
  if !runCfb(&key, &iv, true, &ciphertext, 1, &mut output) { return false }
  return equal(&output, &plaintext)
}

