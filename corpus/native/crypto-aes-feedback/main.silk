fn xtsRejects() -> bool {
  let same: [u8; 32] = [5; 32]
  let tweak: [u8; 16] = [0; 16]
  let input: [u8; 16] = [0; 16]
  let short: [u8; 15] = [0; 15]
  let mut output: [u8; 16] = [0; 16]
  let duplicate = match AesXts.encrypt(&same, &tweak, &input, &mut output) {
    Result<(), AesXtsError>.Failure {error: AesXtsError.DuplicateKeyHalves} => true
    _ => false
  }
  if !duplicate { return false }
  let mut key: [u8; 32] = [5; 32]
  key[31] = 6
  return match AesXts.encrypt(&key, &tweak, &short, &mut output) {
    Result<(), AesXtsError>.Failure {error: AesXtsError.InvalidInputLength} => true
    _ => false
  }
}

