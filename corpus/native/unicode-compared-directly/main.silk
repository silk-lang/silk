import silk.mem.allocator { OutOfMemoryError }
import silk.mem.allocator { Allocator }
import silk.mem.allocator { SystemAllocator }
import silk.core.effect { Effect }
import silk.text.string { String }
import silk.text.unicode { Unicode }
import silk.text.unicode_properties { CanonicalCombiningClass }

effect fn build() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let left = run Unicode.normalizeNfc("\u{e9}") |> Effect.provideMut(&mut allocator)
  let right = run Unicode.normalizeNfc("e\u{301}") |> Effect.provideMut(&mut allocator)
  if String.view(&left) == String.view(&right) {} else { return 1 }
  // U+1ACF (class 230) and U+1E6E3 (class 230) were added in Unicode 17; U+0316 has class 220.
  if CanonicalCombiningClass.of(0x1acf).number() != 230 { return 2 }
  if CanonicalCombiningClass.of(0x1e6e3).number() != 230 { return 3 }
  let decomposed = run Unicode.normalizeNfd("a\u{1acf}\u{316}") |> Effect.provideMut(&mut allocator)
  if String.view(&decomposed) != "a\u{316}\u{1acf}" { return 4 }
  let composed = run Unicode.normalizeNfc("a\u{1e6e3}\u{316}") |> Effect.provideMut(&mut allocator)
  if String.view(&composed) != "a\u{316}\u{1e6e3}" { return 5 }
  return 42
}

effect fn recover(error: OutOfMemoryError) -> i32 { return 0 }

pub fn main() -> i32 { return run Effect.catchAll(build(), recover) }