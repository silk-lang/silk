  let binaryOk = run check(
    &mut binary,
    b"\x40\x86\xf2\xb4\x66\xa8\x76\x7a\xff\xc8\x03\xff\xc7\xff\xfd\x8f\xff\xff\xe2\xff\xff\xfe\x3f\xff\xff\xe4\xff\xff\xfe\x5f\xff\xff\xe6\xff\xff\xfe\x7f\xff\xff\xe8\xff\xff\xea\xff\xff\xff\xf3\xff\xff\xfa\x7f\xff\xff\xab\xff\xff\xff\xdf\xff\xff\xeb\xff\xff\xfe\xcf\xff\xff\xed\xff\xff\xfe\xef\xff\xff\xef\xff\xff\xff\x0f\xff\xff\xf1\xff\xff\xff\x2f\xff\xff\xff\xbf\xff\xff\xcf\xff\xff\xfd\x3f\xff\xff\xd7\xff\xff\xfd\xbf\xff\xff\xdf\xff\xff\xfe\x3f\xff\xff\xe7\xff\xff\xfe\xbf\xff\xff\xed\x4f\xe3\xf9\xff\xaf\xfc\xab\xf1\xfe\xbf\xaf\xef\xe7\xfd\xfd\x2c\xbb\x00\x08\x99\x69\xb7\x1d\x79\xfb\x9f\x7f\xff\x20\xff\xbf\xf3\xff\x50\xdd\xbd\x7f\x06\x1c\x58\xf2\x65\xcd\x9f\x46\x9d\x5a\xf6\x6d\xdd\xbf\x87\x1e\x5f\x9c\xff\x7f\xf7\xff\xfc\x3f\xf9\xff\xe4\x5f\xff\x47\x19\x24\x2c\xb3\x4e\x6e\x9d\x68\xa6\xa3\xd7\xda\xc4\x26\xde\xfe\x3c\xfa\xf7\xff\xfb\xfe\x7f\xfb\xff\xdf\xff\xff\xfc\xff\xfe\x6f\xff\xf4\xbf\xff\x9f\xff\xfa\x3f\xff\xd3\xff\xff\x53\xff\xfd\x5f\xff\xfb\x3f\xff\xeb\x7f\xff\xda\xff\xff\xb7\xff\xff\x73\xff\xfe\xef\xff\xfd\xef\xff\xfe\xbf\xff\xfb\xff\xff\xfd\x9f\xff\xfd\xbf\xff\xeb\xff\xff\xe0\xff\xff\xee\xff\xff\xc3\xff\xff\x8b\xff\xff\x1f\xff\xfe\x4f\xff\xee\x7f\xff\xb1\xff\xff\x97\xff\xfd\x9f\xff\xfc\xdf\xff\xf9\xff\xff\xfb\xff\xff\xda\xff\xfe\xef\xff\xf4\xff\xff\xb7\xff\xfe\xe7\xff\xfe\x8f\xff\xfd\x3f\xff\xde\xff\xff\xd5\xff\xfe\xef\xff\xfb\xdf\xff\xfe\x1f\xff\xdf\xff\xff\x7f\xff\xff\x5f\xff\xfe\xcf\xff\xf0\x7f\xff\x87\xff\xfe\x0f\xff\xf1\x7f\xff\xed\xff\xff\x87\xff\xff\x77\xff\xfe\xff\xff\xea\xff\xff\x8b\xff\xfe\x3f\xff\xf9\x3f\xff\xf8\x7f\xff\xcb\xff\xff\x37\xff\xff\x1f\xff\xff\x83\xff\xff\xe1\xff\xfe\xbf\xff\xe3\xff\xff\x3f\xff\xff\x2f\xff\xfa\x3f\xff\xfd\x9f\xff\xff\x17\xff\xff\xc7\xff\xff\xf2\x7f\xff\xfd\xef\xff\xff\xbf\xff\xff\xf2\xff\xff\xf8\xff\xff\xfb\x7f\xff\x97\xff\xf8\xff\xff\xfe\x6f\xff\xff\xc1\xff\xff\xf8\x7f\xff\xfe\x7f\xff\xff\xc5\xff\xff\xe5\xff\xfe\x4f\xff\xf2\xff\xff\xfd\x1f\xff\xff\x4f\xff\xff\xfe\xff\xff\xfe\x3f\xff\xff\xc9\xff\xff\xf9\x7f\xff\xb3\xff\xff\xcf\xff\xfb\x7f\xff\xcd\xff\xff\x4f\xff\xf9\xff\xff\xd1\xff\xff\xcf\xff\xfe\xaf\xff\xfa\xff\xff\xfd\xdf\xff\xfe\xff\xff\xff\x4f\xff\xff\x5f\xff\xff\xab\xff\xff\xa7\xff\xff\xd7\xff\xff\xf9\xbf\xff\xfe\xcf\xff\xff\xb7\xff\xff\xf3\xff\xff\xfe\x8f\xff\xff\xd3\xff\xff\xfa\xbf\xff\xff\x5f\xff\xff\xff\x7f\xff\xfe\xcf\xff\xff\xdb\xff\xff\xfb\xbf\xff\xff\x7f\xff\xff\xf0\xff\xff\xfb\xbf",
    &allBytes
  )
  if !binaryOk {
    return 13
  }
  let bad14 = run bad(b"\x80", 4096, 10, 1000, false)
  if !bad14 {
    return 14
  }
  let bad15 = run bad(b"\xff", 4096, 10, 1000, false)
  if !bad15 {
    return 15
  }
  let bad16 = run bad(
    b"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff",
    4096,
    10,
    1000,
    false
  )
  if !bad16 {
    return 16
  }
  let bad17 = run bad(b"\x82\x20", 4096, 10, 1000, false)
  if !bad17 {
    return 17
  }
  let bad18 = run bad(b"\x3f\xe2\x1f", 4096, 10, 1000, false)
  if !bad18 {
    return 18
  }
  let bad19 = run bad(b"\x40\x81\xff\x00", 4096, 10, 1000, false)
  if !bad19 {
    return 19
  }
  let bad20 = run bad(b"\x40\x84\xff\xff\xff\xff\x00", 4096, 10, 1000, false)
  if !bad20 {
    return 20
  }
  let bad21 = run bad(b"\x40\x81\x18\x00", 4096, 10, 1000, false)
  if !bad21 {
    return 21
  }
  let bad22 = run bad(b"\x40\x05\x61\x62\x63", 4096, 10, 1000, false)
  if !bad22 {
    return 22
  }
  let bad23 = run bad(b"\x82", 4096, 0, 1000, true)
  if !bad23 {
    return 23
  }
  let bad24 = run bad(b"\x82", 4096, 10, 32, true)
  if !bad24 {
    return 24
  }
  let mut encoder = Encoder.make(4096)
  let mut decoder = Decoder.make(4096, 16, 4096)
  let sensitive = [Field { name: b"authorization", value: b"secret", sensitive: true }]
  let encoded = run Encoder.encode(&mut encoder, &sensitive)
  let wire = Bytes.asSlice(&encoded)
  if wire[0] != 31 {
    return 40
  }
  let decoded = run Decoder.decode(&mut decoder, wire)
  let entries = List.asSlice(&decoded)
  if entries.length != 1 || !entries[0].sensitive {
    return 41
  }
  Encoder.setMaximum(&mut encoder, 0)
  Encoder.setMaximum(&mut encoder, 128)
  Decoder.setMaximum(&mut decoder, 128)
  let updated = run Encoder.encode(&mut encoder, &sensitive)
  let updatedWire = Bytes.asSlice(&updated)
  if updatedWire[0] != 32 || updatedWire[1] != 63 {
    return 42
  }
  let updateOk = run check(&mut decoder, updatedWire, &sensitive)
  if !updateOk {
    return 43
  }

  // A required table reduction cannot be skipped.
  Decoder.setMaximum(&mut decoder, 0)
  let rejected = run Effect.result(Decoder.decode(&mut decoder, b"\x82"))
  match move rejected {
    Result.Success { value } => {
      return 44
    }
    Result.Failure { error } => match move error {
      HpackError failure => {}
      OutOfMemoryError failure => {
        fail move failure
      }
    }
  }
  let mut minimum = Decoder.make(4096, 16, 4096)
  Decoder.setMaximum(&mut minimum, 0)
  Decoder.setMaximum(&mut minimum, 128)
  let skippedMinimum = run Effect.result(Decoder.decode(&mut minimum, b"\x3f\x61\x82"))
  match move skippedMinimum {
    Result.Success { value } => {
      return 45
    }
    Result.Failure { error } => match move error {
      HpackError failure => {}
      OutOfMemoryError failure => {
        fail move failure
      }
    }
  }
  return 0
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  return 99
}

pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(test(), failed) |> Effect.provideMut<Allocator>(&mut allocator)
}
