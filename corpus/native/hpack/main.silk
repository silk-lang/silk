import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.http.hpack { Decoder, Encoder, Field, Header, HpackError }
import silk.collections.list { List }
import silk.core.result { Result }
import silk.num.usize

fn equal(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length {
    return false
  }
  let mut i: usize = 0
  while i < a.length {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  return true
}

effect fn check(decoder: &mut Decoder, wire: &[u8], expected: &[Field]) -> bool
  ! HpackError | OutOfMemoryError
  ? &mut Allocator {
  let result = run Decoder.decode(&mut decoder.*, wire)
  let fields = List.asSlice(&result)
  if fields.length != expected.length {
    return false
  }
  let mut i: usize = 0
  while i < fields.length {
    if !equal(Bytes.asSlice(&fields[i].name), expected[i].name)
      || !equal(Bytes.asSlice(&fields[i].value), expected[i].value) {
      return false
    }
    i = i + 1
  }
  return true
}

effect fn bad(wire: &[u8], table: usize, fields: usize, size: usize, limit: bool) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut decoder = Decoder.make(table, fields, size)
  let result = run Effect.result(Decoder.decode(&mut decoder, wire))
  return match move result {
    Result.Success { value } => false
    Result.Failure { error } => match move error {
      HpackError failure => failure.limit == limit
      OutOfMemoryError failure => {
        fail move failure
      }
    }
  }
}

