// Mutually recursive declared types read and write as JSON (GEN-006): `encode<Tree>` reaches
// `encode<Branch>` through `List<Branch>`, and `Branch` returns to `Tree`, an application still
// active on the path, which the cycle reuses instead of refusing as growth.
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.schema.issue { SchemaError }
import silk.schema.json { SchemaJson }
import silk.schema.schema { Schema }

pub struct Tree {
  pub name: u32,
  pub children: List<Branch>,
}

pub struct Branch {
  pub label: u32,
  pub tree: Tree,
}

impl Schema for Tree {}

impl Schema for Branch {}

struct Capture {
  bytes: [u8; 256],
  length: usize,
}

impl Writer for Capture {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> ()
    ! WriterError
    ? &mut Writer {
    let mut index: usize = 0
    while index < value.length {
      self.bytes[self.length] = value[index]
      self.length = self.length + 1
      index = index + 1
    }
    return ()
  }

  effect fn flush(self: &mut Self) -> ()
    ! WriterError
    ? &mut Writer {
    return ()
  }
}

fn holds(capture: &Capture, expected: &[u8]) -> bool {
  if capture.length != expected.length {
    return false
  }
  let mut index: usize = 0
  while index < expected.length {
    if capture.bytes[index] != expected[index] {
      return false
    }
    index = index + 1
  }
  return true
}

effect fn checks() -> i32
  ! OutOfMemoryError
  ? &mut Allocator {
  let text = b"{\"name\":1,\"children\":[{\"label\":2,\"tree\":{\"name\":3,\"children\":[]}}]}"
  let tree = match run Effect.result(SchemaJson.decode<Tree>(text)) {
    Result<Tree, SchemaError | OutOfMemoryError>.Success { value } => move value
    Result<Tree, SchemaError | OutOfMemoryError>.Failure { .. } => {
      return 1
    }
  }
  if tree.name != 1 || List<Branch>.length(&tree.children) != 1 {
    return 2
  }
  let mut capture = Capture { bytes: [0; 256], length: 0 }
  let encoded = run Effect.result(SchemaJson.encode<Tree>(&tree))
    |> Effect.provideMut<Writer>(&mut capture)
  let wrote = match move encoded {
    Result<(), SchemaError | WriterError | OutOfMemoryError>.Success { .. } => true
    Result<(), SchemaError | WriterError | OutOfMemoryError>.Failure { .. } => false
  }
  if !wrote {
    return 3
  }
  if !holds(&capture, text) {
    return 4
  }
  return 0
}

pub effect fn main() -> i32
  ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checks() |> Effect.provideMut<Allocator>(&mut allocator)
}
