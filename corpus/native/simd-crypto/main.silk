import silk.simd.aarch64
import silk.simd.x86
import silk.simd.cpu { CpuFeatures }
import silk.simd.u8x16
import silk.simd.u64x2

// The FIPS 197 appendix B example: one AES-128 block, its key schedule and its ciphertext.
fn roundKeys() -> [simd<u8, 16>; 11] {
  return [
    u8x16.fromArray([43, 126, 21, 22, 40, 174, 210, 166, 171, 247, 21, 136, 9, 207, 79, 60]),
    u8x16.fromArray([160, 250, 254, 23, 136, 84, 44, 177, 35, 163, 57, 57, 42, 108, 118, 5]),
    u8x16.fromArray([242, 194, 149, 242, 122, 150, 185, 67, 89, 53, 128, 122, 115, 89, 246, 127]),
    u8x16.fromArray([61, 128, 71, 125, 71, 22, 254, 62, 30, 35, 126, 68, 109, 122, 136, 59]),
    u8x16.fromArray([239, 68, 165, 65, 168, 82, 91, 127, 182, 113, 37, 59, 219, 11, 173, 0]),
    u8x16.fromArray([212, 209, 198, 248, 124, 131, 157, 135, 202, 242, 184, 188, 17, 249, 21, 188]),
    u8x16.fromArray([109, 136, 163, 122, 17, 11, 62, 253, 219, 249, 134, 65, 202, 0, 147, 253]),
    u8x16.fromArray([78, 84, 247, 14, 95, 95, 201, 243, 132, 166, 79, 178, 78, 166, 220, 79]),
    u8x16.fromArray([234, 210, 115, 33, 181, 141, 186, 210, 49, 43, 245, 96, 127, 141, 41, 47]),
    u8x16.fromArray([172, 119, 102, 243, 25, 250, 220, 33, 40, 209, 41, 65, 87, 92, 0, 110]),
    u8x16.fromArray([208, 20, 249, 168, 201, 238, 37, 137, 225, 63, 12, 200, 182, 99, 12, 166]),
  ]
}

fn plaintext() -> simd<u8, 16> {
  return u8x16.fromArray([50, 67, 246, 168, 136, 90, 48, 141, 49, 49, 152, 162, 224, 55, 7, 52])
}

fn ciphertext() -> simd<u8, 16> {
  return u8x16.fromArray([57, 37, 132, 29, 2, 220, 9, 251, 220, 17, 133, 151, 25, 106, 11, 50])
}

// The x86 rounds: whitening, nine full rounds and the last round.
fn encryptX86(block: simd<u8, 16>, keys: &[simd<u8, 16>; 11]) -> simd<u8, 16> {
  let mut state = block ^ keys[0]
  let mut round: usize = 1
  while round < 10 {
    state = x86.aesEncrypt(state, keys[round])
    round = round + 1
  }
  return x86.aesEncryptLast(state, keys[10])
}

// The equivalent inverse cipher, whose middle round keys pass through InvMixColumns.
fn decryptX86(block: simd<u8, 16>, keys: &[simd<u8, 16>; 11]) -> simd<u8, 16> {
  let mut state = block ^ keys[10]
  let mut round: usize = 9
  while round > 0 {
    state = x86.aesDecrypt(state, x86.aesInverseMixColumns(keys[round]))
    round = round - 1
  }
  return x86.aesDecryptLast(state, keys[0])
}

// The AArch64 steps: `aese` adds the key before substituting, so the last key is added alone.
fn encryptAarch64(block: simd<u8, 16>, keys: &[simd<u8, 16>; 11]) -> simd<u8, 16> {
  let mut state = block
  let mut round: usize = 0
  while round < 9 {
    state = aarch64.aesMixColumns(aarch64.aesEncrypt(state, keys[round]))
    round = round + 1
  }
  return aarch64.aesEncrypt(state, keys[9]) ^ keys[10]
}

fn decryptAarch64(block: simd<u8, 16>, keys: &[simd<u8, 16>; 11]) -> simd<u8, 16> {
  let mut state = aarch64.aesDecrypt(block, keys[10])
  let mut round: usize = 9
  while round > 0 {
    state = aarch64.aesDecrypt(aarch64.aesInverseMixColumns(state), aarch64.aesInverseMixColumns(keys[round]))
    round = round - 1
  }
  return state ^ keys[0]
}

static if Intrinsic.targetArchitecture() == "x86_64" {
  // The instructions themselves, for a machine that has them.
  @features("aes")
  unsafe fn encryptAesNi(block: simd<u8, 16>, keys: &[simd<u8, 16>; 11]) -> simd<u8, 16> {
    let mut state = u8x16.bitcastToU64x2(block ^ keys[0])
    let mut round: usize = 1
    while round < 10 {
      state = Intrinsic.x86AesEncrypt<simd<u64, 2>>(state, u8x16.bitcastToU64x2(keys[round]))
      round = round + 1
    }
    return u64x2.bitcastToU8x16(Intrinsic.x86AesEncryptLast<simd<u64, 2>>(state, u8x16.bitcastToU64x2(keys[10])))
  }

  @features("pclmul")
  unsafe fn multiplyPclmul(left: simd<u64, 2>, right: simd<u64, 2>) -> simd<u64, 2> {
    return Intrinsic.x86CarrylessMultiply<simd<u64, 2>>(left, right)
  }
}

pub fn main() -> i32 {
  let keys = roundKeys()
  if encryptX86(plaintext(), &keys) != ciphertext() { return 1 }
  if decryptX86(ciphertext(), &keys) != plaintext() { return 2 }
  if encryptAarch64(plaintext(), &keys) != ciphertext() { return 3 }
  if decryptAarch64(ciphertext(), &keys) != plaintext() { return 4 }
  let left = u64x2.fromArray([0x8000000000000001, 7])
  let right = u64x2.fromArray([0x0123456789abcdef, 9])
  if x86.carrylessMultiply(left, right) != u64x2.fromArray([0x8123456789abcdef, 0x0091a2b3c4d5e6f7]) { return 5 }
  let reduced = x86.carrylessMultiply(u64x2.fromArray([0xfedcba9876543210, 0]), u64x2.fromArray([0x87, 0]))
  if reduced != u64x2.fromArray([0x964a69f269b59670, 0x7d]) { return 6 }
  static if Intrinsic.targetArchitecture() == "x86_64" {
    let machine = CpuFeatures.detect()
    if CpuFeatures.has(&machine, "aes") && unsafe encryptAesNi(plaintext(), &keys) != ciphertext() { return 7 }
    if CpuFeatures.has(&machine, "pclmul") && unsafe multiplyPclmul(left, right) != x86.carrylessMultiply(left, right) { return 8 }
  }
  return 0
}
