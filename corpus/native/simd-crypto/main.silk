import silk.crypto.aes_round
import silk.num.u8
import silk.num.usize
import silk.simd.aarch64
import silk.simd.x86
import silk.simd.cpu { CpuFeatures }
import silk.simd.u8x16
import silk.simd.u64x2

// The FIPS 197 appendix B example: one AES-128 block, its key schedule and its ciphertext.
fn roundKeys() -> [simd<u8, 16>; 11] {
  return [
    u8x16.fromArray([43, 126, 21, 22, 40, 174, 210, 166, 171, 247, 21, 136, 9, 207, 79, 60]),
    u8x16.fromArray([160, 250, 254, 23, 136, 84, 44, 177, 35, 163, 57, 57, 42, 108, 118, 5]),
    u8x16.fromArray([242, 194, 149, 242, 122, 150, 185, 67, 89, 53, 128, 122, 115, 89, 246, 127]),
    u8x16.fromArray([61, 128, 71, 125, 71, 22, 254, 62, 30, 35, 126, 68, 109, 122, 136, 59]),
    u8x16.fromArray([239, 68, 165, 65, 168, 82, 91, 127, 182, 113, 37, 59, 219, 11, 173, 0]),
    u8x16.fromArray([212, 209, 198, 248, 124, 131, 157, 135, 202, 242, 184, 188, 17, 249, 21, 188]),
    u8x16.fromArray([109, 136, 163, 122, 17, 11, 62, 253, 219, 249, 134, 65, 202, 0, 147, 253]),
    u8x16.fromArray([78, 84, 247, 14, 95, 95, 201, 243, 132, 166, 79, 178, 78, 166, 220, 79]),
    u8x16.fromArray([234, 210, 115, 33, 181, 141, 186, 210, 49, 43, 245, 96, 127, 141, 41, 47]),
    u8x16.fromArray([172, 119, 102, 243, 25, 250, 220, 33, 40, 209, 41, 65, 87, 92, 0, 110]),
    u8x16.fromArray([208, 20, 249, 168, 201, 238, 37, 137, 225, 63, 12, 200, 182, 99, 12, 166]),
  ]
}

fn plaintext() -> simd<u8, 16> {
  return u8x16.fromArray([50, 67, 246, 168, 136, 90, 48, 141, 49, 49, 152, 162, 224, 55, 7, 52])
}

fn ciphertext() -> simd<u8, 16> {
  return u8x16.fromArray([57, 37, 132, 29, 2, 220, 9, 251, 220, 17, 133, 151, 25, 106, 11, 50])
}

// The x86 rounds: whitening, nine full rounds and the last round.
fn encryptX86(block: simd<u8, 16>, keys: &[simd<u8, 16>; 11]) -> simd<u8, 16> {
  let mut state = block ^ keys[0]
  let mut round: usize = 1
  while round < 10 {
    state = x86.aesEncrypt(state, keys[round])
    round = round + 1
  }
  return x86.aesEncryptLast(state, keys[10])
}

// The equivalent inverse cipher, whose middle round keys pass through InvMixColumns.
fn decryptX86(block: simd<u8, 16>, keys: &[simd<u8, 16>; 11]) -> simd<u8, 16> {
  let mut state = block ^ keys[10]
  let mut round: usize = 9
  while round > 0 {
    state = x86.aesDecrypt(state, x86.aesInverseMixColumns(keys[round]))
    round = round - 1
  }
  return x86.aesDecryptLast(state, keys[0])
}

// The AArch64 steps: `aese` adds the key before substituting, so the last key is added alone.
fn encryptAarch64(block: simd<u8, 16>, keys: &[simd<u8, 16>; 11]) -> simd<u8, 16> {
  let mut state = block
  let mut round: usize = 0
  while round < 9 {
    state = aarch64.aesMixColumns(aarch64.aesEncrypt(state, keys[round]))
    round = round + 1
  }
  return aarch64.aesEncrypt(state, keys[9]) ^ keys[10]
}

fn decryptAarch64(block: simd<u8, 16>, keys: &[simd<u8, 16>; 11]) -> simd<u8, 16> {
  let mut state = aarch64.aesDecrypt(block, keys[10])
  let mut round: usize = 9
  while round > 0 {
    state = aarch64.aesDecrypt(aarch64.aesInverseMixColumns(state), aarch64.aesInverseMixColumns(keys[round]))
    round = round - 1
  }
  return state ^ keys[0]
}

static if Intrinsic.targetArchitecture() == "x86_64" {
  // The instructions themselves, for a machine that has them.
  @features("aes")
  unsafe fn encryptAesNi(block: simd<u8, 16>, keys: &[simd<u8, 16>; 11]) -> simd<u8, 16> {
    let mut state = u8x16.bitcastToU64x2(block ^ keys[0])
    let mut round: usize = 1
    while round < 10 {
      state = Intrinsic.x86AesEncrypt<simd<u64, 2>>(state, u8x16.bitcastToU64x2(keys[round]))
      round = round + 1
    }
    return u64x2.bitcastToU8x16(Intrinsic.x86AesEncryptLast<simd<u64, 2>>(state, u8x16.bitcastToU64x2(keys[10])))
  }

  @features("pclmul")
  unsafe fn multiplyPclmul(left: simd<u64, 2>, right: simd<u64, 2>) -> simd<u64, 2> {
    return Intrinsic.x86CarrylessMultiply<simd<u64, 2>>(left, right)
  }
}

static if Intrinsic.targetArchitecture() == "aarch64" {
  @features("aes")
  unsafe fn multiplyPmull(left: simd<u64, 2>, right: simd<u64, 2>) -> [simd<u64, 2>; 2] {
    return [
      Intrinsic.aarch64PolynomialMultiply<simd<u64, 2>>(left, right),
      Intrinsic.aarch64PolynomialMultiplyHigh<simd<u64, 2>>(left, right),
    ]
  }
}

// FIPS 197, Table 4. A permutation of the input bytes puts distinct values in
// adjacent lanes and exercises every forward and inverse substitution.
const AES_SBOX: [u8; 256] = [
  0x63, 0x7c, 0x77, 0x7b, 0xf2, 0x6b, 0x6f, 0xc5, 0x30, 0x01, 0x67, 0x2b, 0xfe, 0xd7, 0xab, 0x76,
  0xca, 0x82, 0xc9, 0x7d, 0xfa, 0x59, 0x47, 0xf0, 0xad, 0xd4, 0xa2, 0xaf, 0x9c, 0xa4, 0x72, 0xc0,
  0xb7, 0xfd, 0x93, 0x26, 0x36, 0x3f, 0xf7, 0xcc, 0x34, 0xa5, 0xe5, 0xf1, 0x71, 0xd8, 0x31, 0x15,
  0x04, 0xc7, 0x23, 0xc3, 0x18, 0x96, 0x05, 0x9a, 0x07, 0x12, 0x80, 0xe2, 0xeb, 0x27, 0xb2, 0x75,
  0x09, 0x83, 0x2c, 0x1a, 0x1b, 0x6e, 0x5a, 0xa0, 0x52, 0x3b, 0xd6, 0xb3, 0x29, 0xe3, 0x2f, 0x84,
  0x53, 0xd1, 0x00, 0xed, 0x20, 0xfc, 0xb1, 0x5b, 0x6a, 0xcb, 0xbe, 0x39, 0x4a, 0x4c, 0x58, 0xcf,
  0xd0, 0xef, 0xaa, 0xfb, 0x43, 0x4d, 0x33, 0x85, 0x45, 0xf9, 0x02, 0x7f, 0x50, 0x3c, 0x9f, 0xa8,
  0x51, 0xa3, 0x40, 0x8f, 0x92, 0x9d, 0x38, 0xf5, 0xbc, 0xb6, 0xda, 0x21, 0x10, 0xff, 0xf3, 0xd2,
  0xcd, 0x0c, 0x13, 0xec, 0x5f, 0x97, 0x44, 0x17, 0xc4, 0xa7, 0x7e, 0x3d, 0x64, 0x5d, 0x19, 0x73,
  0x60, 0x81, 0x4f, 0xdc, 0x22, 0x2a, 0x90, 0x88, 0x46, 0xee, 0xb8, 0x14, 0xde, 0x5e, 0x0b, 0xdb,
  0xe0, 0x32, 0x3a, 0x0a, 0x49, 0x06, 0x24, 0x5c, 0xc2, 0xd3, 0xac, 0x62, 0x91, 0x95, 0xe4, 0x79,
  0xe7, 0xc8, 0x37, 0x6d, 0x8d, 0xd5, 0x4e, 0xa9, 0x6c, 0x56, 0xf4, 0xea, 0x65, 0x7a, 0xae, 0x08,
  0xba, 0x78, 0x25, 0x2e, 0x1c, 0xa6, 0xb4, 0xc6, 0xe8, 0xdd, 0x74, 0x1f, 0x4b, 0xbd, 0x8b, 0x8a,
  0x70, 0x3e, 0xb5, 0x66, 0x48, 0x03, 0xf6, 0x0e, 0x61, 0x35, 0x57, 0xb9, 0x86, 0xc1, 0x1d, 0x9e,
  0xe1, 0xf8, 0x98, 0x11, 0x69, 0xd9, 0x8e, 0x94, 0x9b, 0x1e, 0x87, 0xe9, 0xce, 0x55, 0x28, 0xdf,
  0x8c, 0xa1, 0x89, 0x0d, 0xbf, 0xe6, 0x42, 0x68, 0x41, 0x99, 0x2d, 0x0f, 0xb0, 0x54, 0xbb, 0x16,
]

fn substitutions() -> bool {
  let mut first = usize.ZERO
  while first < 256 {
    let mut input = u8x16.toArray(u8x16.splat(0))
    let mut expected = u8x16.toArray(u8x16.splat(0))
    let mut lane = usize.ZERO
    while lane < 16 {
      let index = ((first + lane) * 73) & 255
      input[lane] = usize.toU8(index)
      expected[lane] = AES_SBOX[index]
      lane = lane + usize.ONE
    }
    let before = u8x16.fromArray(input)
    let after = u8x16.fromArray(expected)
    if aes_round.subBytes(before) != after || aes_round.inverseSubBytes(after) != before { return false }
    first = first + 16
  }
  return true
}

// Each column of the MixColumns matrix is a rotation of [2, 1, 1, 3].
// Testing the 128 basis bits also checks that columns stay independent.
fn columns() -> bool {
  let mut bit = usize.ZERO
  while bit < 128 {
    let byte = bit / 8
    let row = byte % 4
    let base = byte - row
    let value = u8.shiftLeft(1, usize.toU8(bit % 8))
    let mut twice = u8.shiftLeft(value, 1)
    if value == 128 { twice = 27 }
    let mut input = u8x16.toArray(u8x16.splat(0))
    let mut expected = u8x16.toArray(u8x16.splat(0))
    input[byte] = value
    expected[byte] = twice
    expected[base + (row + 1) % 4] = value
    expected[base + (row + 2) % 4] = value
    expected[base + (row + 3) % 4] = twice ^ value
    let before = u8x16.fromArray(input)
    let after = u8x16.fromArray(expected)
    if aes_round.mixColumns(before) != after || aes_round.inverseMixColumns(after) != before { return false }
    bit = bit + usize.ONE
  }
  return true
}

pub fn main() -> i32 {
  if !columns() { return 14 }
  if !substitutions() { return 13 }
  let keys = roundKeys()
  if encryptX86(plaintext(), &keys) != ciphertext() { return 1 }
  if decryptX86(ciphertext(), &keys) != plaintext() { return 2 }
  if encryptAarch64(plaintext(), &keys) != ciphertext() { return 3 }
  if decryptAarch64(ciphertext(), &keys) != plaintext() { return 4 }
  let left = u64x2.fromArray([0x8000000000000001, 7])
  let right = u64x2.fromArray([0x0123456789abcdef, 9])
  if x86.carrylessMultiply(left, right) != u64x2.fromArray([0x8123456789abcdef, 0x0091a2b3c4d5e6f7]) { return 5 }
  let reduced = x86.carrylessMultiply(u64x2.fromArray([0xfedcba9876543210, 0]), u64x2.fromArray([0x87, 0]))
  if reduced != u64x2.fromArray([0x964a69f269b59670, 0x7d]) { return 6 }
  // The same products from lane 0 (`pmull`) and from lane 1 (`pmull2`).
  if aarch64.polynomialMultiply(left, right) != x86.carrylessMultiply(left, right) { return 9 }
  let swapped = aarch64.polynomialMultiplyHigh(u64x2.shuffle(left, left, [1, 0]), u64x2.shuffle(right, right, [1, 0]))
  if swapped != x86.carrylessMultiply(left, right) { return 10 }
  static if Intrinsic.targetArchitecture() == "aarch64" {
    if CpuFeatures.available("aes") {
      let products = unsafe multiplyPmull(left, right)
      if products[0] != aarch64.polynomialMultiply(left, right) { return 11 }
      if products[1] != aarch64.polynomialMultiplyHigh(left, right) { return 12 }
    }
  }
  static if Intrinsic.targetArchitecture() == "x86_64" {
    let machine = CpuFeatures.detect()
    if CpuFeatures.has(&machine, "aes") && unsafe encryptAesNi(plaintext(), &keys) != ciphertext() { return 7 }
    if CpuFeatures.has(&machine, "pclmul") && unsafe multiplyPclmul(left, right) != x86.carrylessMultiply(left, right) { return 8 }
  }
  return 0
}
