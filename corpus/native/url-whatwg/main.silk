// silk.url against representative web-platform-tests cases; integration/url-conformance runs
// the full pinned WPT data.
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.idna { Idna, IdnaOptions, Punycode }
import silk.text.string { String }
import silk.url.form { UrlForm, UrlFormPair }
import silk.url.host { UrlHost, UrlHostKind }
import silk.url.url { Url }
import silk.io.writer_native { StderrWriter }

struct Failed {
  message: string<'static>,
}

effect fn expect(holds: bool, message: string<'static>) -> ()
  ! Failed {
  if !holds {
    fail Failed { message: message }
  }
}

effect fn href(input: string, base: string, expected: string) -> ()
  ! OutOfMemoryError | Failed
  ? &mut Allocator {
  let parsedBase = run Url.parse(base, Option<&Url>.none())
  let parsed = match move parsedBase {
    Option<Url>.Some { value } => run Url.parse(input, Option<&Url>.some(&value))
    Option<Url>.None => run Url.parse(input, Option<&Url>.none())
  }
  match move parsed {
    Option<Url>.Some { value } => {
      if Url.href(&value) != expected {
        StderrWriter.print("{} -> {}\n", &(input, Url.href(&value)))
      }
      run expect(Url.href(&value) == expected, "href")
    }
    Option<Url>.None => {
      if String.byteLength(expected) != 0 {
        StderrWriter.print("{} failed\n", &.(input))
      }
      run expect(String.byteLength(expected) == 0, "failure")
    }
  }
}

effect fn parsing() -> ()
  ! OutOfMemoryError | Failed
  ? &mut Allocator {
  run href("http://example\t.\norg", "http://example.org/foo/bar", "http://example.org/")
  run href("  :foo.com   \n", "http://example.org/foo/bar", "http://example.org/foo/:foo.com")
  run href(
    "http://f:21/ b ? d # e ",
    "http://example.org/foo/bar",
    "http://f:21/%20b%20?%20d%20#%20e",
  )
  run href("http://f:00000000000000/c", "http://example.org/foo/bar", "http://f:0/c")
  run href("http://f:999999/c", "http://example.org/foo/bar", "")
  run href("../i", "http://example.org/foo/bar", "http://example.org/i")
  run href("/./.././..//a/%2e%2E/b", "http://h/x", "http://h//b")
  run href("\\\\server\\file", "http://example.org/foo/bar", "http://server/file")
  run href("http://user:pa:ss@host@x.y/", "about:blank", "http://user:pa%3Ass%40host@x.y/")
  run href("http://[1:0::]", "http://example.net/", "http://[1::]/")
  run href("http://[::127.0.0.1]/", "about:blank", "http://[::7f00:1]/")
  run href("http://0x7F.1/", "about:blank", "http://127.0.0.1/")
  run href("http://1.2.3.4.5/", "about:blank", "")
  run href("http://ExAmPlE.CoM/", "about:blank", "http://example.com/")
  run href("http://Bücher.example/", "about:blank", "http://xn--bcher-kva.example/")
  run href("http://%zz%66%a.com", "about:blank", "")
  run href("non-spec:/.//p", "about:blank", "non-spec:/.//p")
  run href("web+demo:/..//x", "about:blank", "web+demo:/.//x")
  run href("sc: x ?y", "about:blank", "sc: x%20?y")
  run href("#frag", "mailto:a@b", "mailto:a@b#frag")
  run href("x", "mailto:a@b", "")
  run href("file:///C|/a/../..", "about:blank", "file:///C:/")
  run href("//localhost/x", "file:///tmp/a", "file:///x")
  run href("/C:/x", "file:///D:/y", "file:///C:/x")
  run href("?q", "file:///a/b?old", "file:///a/b?q")
}

effect fn setters() -> ()
  ! OutOfMemoryError | Failed
  ? &mut Allocator {
  let parsed = run Url.parse("https://user@example.com:8080/a?b#c", Option<&Url>.none())
  let mut url = match move parsed {
    Option<Url>.Some { value } => move value
    Option<Url>.None => {
      fail Failed { message: "base" }
    }
  }
  run Url.setProtocol(&mut url, "wss:x")
  run expect(Url.href(&url) == "wss://user@example.com:8080/a?b#c", "protocol")
  run Url.setProtocol(&mut url, "mailto")
  run expect(Url.protocol(&url) == "wss:", "special stays special")
  run Url.setPort(&mut url, "443abc")
  run expect(Url.port(&url) == "" && Url.host(&url) == "example.com", "default port")
  run Url.setHost(&mut url, "[::1]:99")
  run expect(Url.host(&url) == "[::1]:99" && Url.hostname(&url) == "[::1]", "host")
  run Url.setHostname(&mut url, "a:1")
  run expect(Url.hostname(&url) == "[::1]", "hostname with port")
  run Url.setPassword(&mut url, "p@ss")
  run expect(Url.password(&url) == "p%40ss", "password")
  run Url.setPathname(&mut url, "/x/../y z")
  run expect(Url.pathname(&url) == "/y%20z", "pathname")
  run Url.setSearch(&mut url, "?q='1'")
  run expect(Url.search(&url) == "?q=%271%27", "search")
  run Url.setHash(&mut url, "")
  run expect(Url.href(&url) == "wss://user:p%40ss@[::1]:99/y%20z?q=%271%27", "hash")
  let opaque = run Url.parse("data:space ?query#f", Option<&Url>.none())
  let mut data = match move opaque {
    Option<Url>.Some { value } => move value
    Option<Url>.None => {
      fail Failed { message: "opaque" }
    }
  }
  run Url.setHash(&mut data, "")
  run expect(Url.href(&data) == "data:space%20?query", "opaque hash")
  run Url.setSearch(&mut data, "")
  run expect(Url.href(&data) == "data:space%20", "opaque search")
  let ok = run Url.setHref(&mut data, "not a url")
  run expect(!ok && Url.pathname(&data) == "space%20", "href failure")
  let mut origin = String.make()
  run Url.appendOrigin(&url, &mut origin)
  run expect(String.view(&origin) == "wss://[::1]:99", "origin")
}

// `Absent` stands for a failed parse.
fn isKind(kind: Option<UrlHostKind>, want: UrlHostKind) -> bool {
  return match kind {
    Option<UrlHostKind>.Some { value } => value == want
    Option<UrlHostKind>.None => want == UrlHostKind.Absent
  }
}

effect fn hosts() -> ()
  ! OutOfMemoryError | Failed
  ? &mut Allocator {
  let mut out = Bytes.make()
  let kind = run UrlHost.parse(b"0300.0250.0x1", false, &mut out)
  run expect(isKind(kind, UrlHostKind.Ipv4) && Bytes.asSlice(&out) == b"192.168.0.1", "ipv4")
  Bytes.clear(&mut out)
  let opaque = run UrlHost.parse(b"a b", true, &mut out)
  run expect(isKind(opaque, UrlHostKind.Absent), "opaque forbidden")
  Bytes.clear(&mut out)
  let six = run UrlHost.parse(b"[0:0:0:0:0:ffff:7f00:1]", false, &mut out)
  run expect(isKind(six, UrlHostKind.Ipv6) && Bytes.asSlice(&out) == b"[::ffff:7f00:1]", "ipv6")
  let mut ascii = String.make()
  let valid = run Idna.toAscii("Faß.ExAmple", IdnaOptions.lenient(), &mut ascii)
  run expect(valid && String.view(&ascii) == "xn--fa-hia.example", "idna")
  let mut bidi = String.make()
  let rtl = run Idna.toAscii("0à.\u{5d0}", IdnaOptions.lenient(), &mut bidi)
  run expect(!rtl, "bidi rule")
  let mut unicode = String.make()
  let back = run Idna.toUnicode("xn--fa-hia.example", IdnaOptions.lenient(), &mut unicode)
  run expect(back && String.view(&unicode) == "faß.example", "to unicode")
  let mut strict = String.make()
  let hyphen = run Idna.toAscii("-a.example", IdnaOptions.strict(), &mut strict)
  run expect(!hyphen, "strict hyphen")
  let mut points = List<u32>.make()
  let decoded = run Punycode.decode(b"bcher-kva", &mut points)
  run expect(
    decoded && List<u32>.length(&points) == 6 && List<u32>.get(&points, 1) == 0xFC,
    "punycode",
  )
}

effect fn forms() -> ()
  ! OutOfMemoryError | Failed
  ? &mut Allocator {
  let pairs = run UrlForm.parse("&a=b+c&%zz=%C2&=x&a&")
  let list = List<UrlFormPair>.asSlice(&pairs)
  run expect(list.length == 4, "pair count")
  run expect(
    String.view(&list[0].value) == "b c" && String.view(&list[1].name) == "%zz",
    "decoding",
  )
  run expect(
    String.view(&list[1].value) == "\u{fffd}" && String.view(&list[2].name) == "",
    "replacement",
  )
  let text = run UrlForm.serialize(list)
  run expect(String.view(&text) == "a=b+c&%25zz=%EF%BF%BD&=x&a=", "serialize")
}

effect fn cases() -> i32
  ! OutOfMemoryError | Failed {
  let mut allocator = Allocator.systemAllocatorProvider()
  run parsing() |> Effect.provideMut<Allocator>(&mut allocator)
  run setters() |> Effect.provideMut<Allocator>(&mut allocator)
  run hosts() |> Effect.provideMut<Allocator>(&mut allocator)
  run forms() |> Effect.provideMut<Allocator>(&mut allocator)
  return 0
}

effect fn failed(error: Failed | OutOfMemoryError) -> i32 {
  return match move error {
    Failed failure => {
      StderrWriter.print("failed: {}\n", &.(failure.message))
      return 1
    }
    OutOfMemoryError exhausted => {
      drop exhausted
      return 2
    }
  }
}

pub fn main() -> i32 {
  return run Effect.catchAll(cases(), failed)
}
