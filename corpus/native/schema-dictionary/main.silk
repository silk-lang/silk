import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.schema.issue { SchemaError, SchemaErrors, IssueReason }
import silk.schema.json { SchemaJson }
import silk.schema.json_schema { JsonSchemas, JsonSchemaDialect, JsonSchemaOptions, JsonSchemaError, JsonSchemaProblem }
import silk.schema.toml { SchemaToml }
import silk.schema.yaml { SchemaYaml }
import silk.schema.schema { Dictionary, Schema, Schemas, Spec }
import silk.text.string { String, InvalidUtf8 }

struct Config {pub dependencies: Dictionary<u32>}
impl Schema for Config {
  static fn spec() -> Spec<Config> { return Spec<Config>.of() |> Spec<Config>.strict() }
}

struct Capture {bytes: [u8; 1024], length: usize}
impl Writer for Capture {
  effect fn writeAll(self: &mut Self, bytes: &[u8]) -> () ! WriterError ? &mut Writer {
    if self.length + bytes.length > 1024 { fail Writer.failure() }
    Slice.copyInto<u8>(&mut self.bytes, self.length, bytes)
    self.length = self.length + bytes.length
  }
  effect fn flush(self: &mut Self) -> () ! WriterError ? &mut Writer { return () }
}

fn value(config: &Config, key: string) -> u32 {
  return match move config.dependencies.find(key) {
    Option<&u32>.Some {value} => value.*
    Option<&u32>.None => 0
  }
}

effect fn checks() -> i32 ! SchemaError | JsonSchemaError | WriterError | OutOfMemoryError ? &mut Allocator {
  let shape = run Schemas.shape<Config>()
  let mut standard = Capture {bytes: [0; 1024], length: 0}
  let exact = run JsonSchemas.write(&shape, JsonSchemaOptions.of(JsonSchemaDialect.Standard)) |> Effect.provideMut<Writer>(&mut standard)
  let schema = match move String.fromUtf8(Slice.view<u8>(&standard.bytes, 0, standard.length)) {
    Result<string, InvalidUtf8>.Success {value} => value
    Result<string, InvalidUtf8>.Failure {..} => { return 10 }
  }
  if !exact || !String.contains(schema, "\"additionalProperties\":{\"type\":\"integer\"") { return 11 }
  let mut strict = Capture {bytes: [0; 1024], length: 0}
  let unsupported = run Effect.result(JsonSchemas.write(&shape, JsonSchemaOptions.of(JsonSchemaDialect.OpenAiStrict)) |> Effect.provideMut<Writer>(&mut strict))
  let rejected = match move unsupported {
    Result<bool, JsonSchemaError | WriterError | OutOfMemoryError>.Failure {error} => match move error {
      JsonSchemaError {problem, ..} => problem == JsonSchemaProblem.DynamicKeys
      _ => false
    }
    Result<bool, JsonSchemaError | WriterError | OutOfMemoryError>.Success {..} => false
  }
  if !rejected || strict.length != 0 { return 12 }
  let toml = run SchemaToml.decode<Config>(b"[dependencies]\nalpha = 7\n\"x/y~z\" = 9\n")
  if value(&toml, "alpha") != 7 || value(&toml, "x/y~z") != 9 { return 1 }
  let mut capture = Capture {bytes: [0; 1024], length: 0}
  run SchemaToml.encode<Config>(&toml) |> Effect.provideMut<Writer>(&mut capture)
  let roundtrip = run SchemaToml.decode<Config>(Slice.view<u8>(&capture.bytes, 0, capture.length))
  if value(&roundtrip, "alpha") != 7 || value(&roundtrip, "x/y~z") != 9 { return 2 }
  let json = run SchemaJson.decode<Config>(b"{\"dependencies\":{\"alpha\":7,\"\\u03bb\":11}}")
  if value(&json, "alpha") != 7 || value(&json, "λ") != 11 { return 3 }
  let yaml = run SchemaYaml.decode<Config>(b"dependencies:\n  alpha: 7\n  beta: 13\n")
  if value(&yaml, "alpha") != 7 || value(&yaml, "beta") != 13 { return 4 }
  let absent = run SchemaToml.decode<Config>(b"")
  if absent.dependencies.entries().length != 0 { return 5 }
  let duplicate = run Effect.result(SchemaJson.decode<Config>(b"{\"dependencies\":{\"alpha\":1,\"alpha\":2}}"))
  let refused = match move duplicate {
    Result<Config, SchemaError | OutOfMemoryError>.Success {..} => false
    Result<Config, SchemaError | OutOfMemoryError>.Failure {error} => match move error {
      SchemaError {path, issue, ..} => path.matchesText("dependencies.alpha") && issue.reason == IssueReason.InvalidValue
      OutOfMemoryError {} => { fail OutOfMemoryError {} }
    }
  }
  if !refused { return 6 }
  let collected = run Effect.result(SchemaToml.decodeAll<Config>(b"[dependencies]\n\"x/y~z\" = \"wrong\"\nsecond = -1\n"))
  return match move collected {
    Result<Config, SchemaErrors | OutOfMemoryError>.Success {..} => 7
    Result<Config, SchemaErrors | OutOfMemoryError>.Failure {error} => match move error {
      SchemaErrors {errors, ..} => {
        if errors.length() != 2 { return 8 }
        let pointer = run errors.asSlice()[0].path.pointer()
        if pointer.view() != "/dependencies/x~1y~0z" { return 9 }
        0
      }
      OutOfMemoryError {} => { fail OutOfMemoryError {} }
    }
  }
}

pub effect fn main() -> i32 ! SchemaError | JsonSchemaError | WriterError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checks() |> Effect.provideMut<Allocator>(&mut allocator)
}
