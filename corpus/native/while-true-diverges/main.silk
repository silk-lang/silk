// `while true` without its own `break` never completes: a `never` function may end in one, and a
// function whose only exit is inside such a loop needs no trailing return.
fn spin() -> never { while true { } }
fn firstAbove(limit: i32) -> i32 {
  let mut value = 0
  while true {
    value = value + 7
    if value > limit { return value }
    // A `break` of a nested loop does not leave the outer one.
    while true { break }
  }
}
fn counted() -> i32 {
  let mut count = 0
  while true {
    count = count + 1
    if count == 2 { break }
  }
  return count
}
pub fn main() -> i32 {
  if firstAbove(30) == 35 { return 40 + counted() }
  return spin()
}
