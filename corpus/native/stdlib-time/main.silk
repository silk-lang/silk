struct Capture {
  bytes: [u8; 96],
  length: usize,
}

impl Writer for Capture {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> ()
    ! WriterError
    ? &mut Writer {
    let mut index: usize = 0
    while index < value.length {
      self.bytes[self.length] = value[index]
      self.length = self.length + 1
      index = index + 1
    }
    return ()
  }

  effect fn flush(self: &mut Self) -> ()
    ! WriterError
    ? &mut Writer {
    return ()
  }
}

fn holds(capture: &Capture, expected: string) -> bool {
  let bytes = String.utf8Bytes(expected)
  if capture.length != bytes.length {
    return false
  }
  let mut index: usize = 0
  while index < bytes.length {
    if capture.bytes[index] != bytes[index] {
      return false
    }
    index = index + 1
  }
  return true
}

// True if `Display` writes `expected` for `value`.
effect fn shows<T: Display>(value: &T, expected: string) -> bool
  ! WriterError {
  let mut capture = Capture { bytes: [0; 96], length: 0 }
  run Format.display<T>(value) |> Effect.provideMut<Writer>(&mut capture)
  return holds(&capture, expected)
}

// True if `error` has the reason named `reason` and the offset `offset`.
effect fn isError(error: TimeParseError, reason: string, offset: i64) -> bool
  ! WriterError {
  let mut capture = Capture { bytes: [0; 96], length: 0 }
  run Format.debug<TimeParseReason>(&error.reason) |> Effect.provideMut<Writer>(&mut capture)
  return holds(&capture, reason) && usize.toI64(error.offset) == offset
}

fn sameBytes(output: &[u8], length: usize, expected: string) -> bool {
  let bytes = String.utf8Bytes(expected)
  if length != bytes.length {
    return false
  }
  let mut index: usize = 0
  while index < length {
    if output[index] != bytes[index] {
      return false
    }
    index = index + 1
  }
  return true
}

fn fieldAt(line: string, wanted: usize) -> string {
  let bytes = String.utf8Bytes(line)
  let mut start: usize = 0
  let mut index: usize = 0
  let mut at: usize = 0
  while at <= bytes.length {
    if at == bytes.length || bytes[at] == 9 {
      if index == wanted {
        return String.slice(line, start, at - start)
      }
      index = index + 1
      start = at + 1
    }
    at = at + 1
  }
  return ""
}

fn number(text: string) -> i64 {
  let bytes = String.utf8Bytes(text)
  let mut value: i64 = 0
  let mut at: usize = 0
  let negative = bytes.length > 0 && bytes[0] == 45
  if negative {
    at = 1
  }
  while at < bytes.length {
    value = value * 10 + u8.toI64(bytes[at] - 48)
    at = at + 1
  }
  if negative {
    return -value
  }
  return value
}

effect fn checkDate(line: string) -> bool
  ! WriterError {
  let days = number(fieldAt(line, 1))
  let text = fieldAt(line, 2)
  let date = match PlainDate.fromEpochDays(days) {
    Option<PlainDate>.Some { value } => value
    Option<PlainDate>.None => {
      return false
    }
  }
  if !(run shows<PlainDate>(&date, text)) {
    return false
  }
  let reread = match PlainDate.parse(text) {
    Result<PlainDate, TimeParseError>.Success { value } => value
    Result<PlainDate, TimeParseError>.Failure { error: _ } => {
      return false
    }
  }
  return &reread == &date && date.toEpochDays() == days
    && u8.toI64(date.weekday().number()) == number(fieldAt(line, 3))
    && u16.toI64(date.dayOfYear()) == number(fieldAt(line, 4))
    && u8.toI64(date.weekOfYear()) == number(fieldAt(line, 5))
    && i32.toI64(date.yearOfWeek()) == number(fieldAt(line, 6))
    && u8.toI64(date.daysInMonth()) == number(fieldAt(line, 7))
    && date.inLeapYear() == (fieldAt(line, 8) == "1")
}

effect fn checkInstant(line: string) -> bool
  ! WriterError {
  let seconds = number(fieldAt(line, 1))
  let instant = Instant.make(seconds, number(fieldAt(line, 2)))
  let utcText = fieldAt(line, 3)
  let offset = UtcOffset.fromSeconds(i64.toI32(number(fieldAt(line, 4))))
  let offsetText = fieldAt(line, 5)
  if !(run shows<Instant>(&instant, utcText)) || instant.unixSeconds() != seconds {
    return false
  }
  let mut output: [u8; 41] = [0; 41]
  let length = instant.writeWithOffset(offset, &mut output, 0)
  if !sameBytes(&output, length, offsetText) {
    return false
  }
  let fromUtc = match Instant.parse(utcText) {
    Result<Instant, TimeParseError>.Success { value } => value
    Result<Instant, TimeParseError>.Failure { error: _ } => {
      return false
    }
  }
  let fromOffset = match Instant.parse(offsetText) {
    Result<Instant, TimeParseError>.Success { value } => value
    Result<Instant, TimeParseError>.Failure { error: _ } => {
      return false
    }
  }
  let back = match Instant.fromLocal(instant.toOffset(offset), offset) {
    Option<Instant>.Some { value } => value
    Option<Instant>.None => {
      return false
    }
  }
  return &fromUtc == &instant && &fromOffset == &instant && &back == &instant
}

effect fn checkParse(line: string) -> bool
  ! WriterError {
  let kind = fieldAt(line, 1)
  let text = fieldAt(line, 2)
  let want = fieldAt(line, 3)
  if kind == "pd" {
    match PlainDate.parse(text) {
      Result<PlainDate, TimeParseError>.Success { value } => {
        return run shows<PlainDate>(&value, want)
      }
      Result<PlainDate, TimeParseError>.Failure { error: _ } => {
        return false
      }
    }
  }
  if kind == "pt" {
    match PlainTime.parse(text) {
      Result<PlainTime, TimeParseError>.Success { value } => {
        return run shows<PlainTime>(&value, want)
      }
      Result<PlainTime, TimeParseError>.Failure { error: _ } => {
        return false
      }
    }
  }
  if kind == "pdt" {
    match PlainDateTime.parse(text) {
      Result<PlainDateTime, TimeParseError>.Success { value } => {
        return run shows<PlainDateTime>(&value, want)
      }
      Result<PlainDateTime, TimeParseError>.Failure { error: _ } => {
        return false
      }
    }
  }
  match Instant.parse(text) {
    Result<Instant, TimeParseError>.Success { value } => {
      return run shows<Instant>(&value, want)
    }
    Result<Instant, TimeParseError>.Failure { error: _ } => {
      return false
    }
  }
}

effect fn checkReject(line: string) -> bool
  ! WriterError {
  let kind = fieldAt(line, 1)
  let text = fieldAt(line, 2)
  let reason = fieldAt(line, 3)
  let offset = number(fieldAt(line, 4))
  if kind == "pd" {
    match PlainDate.parse(text) {
      Result<PlainDate, TimeParseError>.Success { value: _ } => {
        return false
      }
      Result<PlainDate, TimeParseError>.Failure { error } => {
        return run isError(error, reason, offset)
      }
    }
  }
  if kind == "pt" {
    match PlainTime.parse(text) {
      Result<PlainTime, TimeParseError>.Success { value: _ } => {
        return false
      }
      Result<PlainTime, TimeParseError>.Failure { error } => {
        return run isError(error, reason, offset)
      }
    }
  }
  if kind == "pdt" {
    match PlainDateTime.parse(text) {
      Result<PlainDateTime, TimeParseError>.Success { value: _ } => {
        return false
      }
      Result<PlainDateTime, TimeParseError>.Failure { error } => {
        return run isError(error, reason, offset)
      }
    }
  }
  if kind == "of" {
    match UtcOffset.parse(text) {
      Result<UtcOffset, TimeParseError>.Success { value: _ } => {
        return false
      }
      Result<UtcOffset, TimeParseError>.Failure { error } => {
        return run isError(error, reason, offset)
      }
    }
  }
  let parsed = if kind == "h" {
    HttpDate.parse(text)
  } else if kind == "au" {
    Asn1Time.parseUtcTime(String.utf8Bytes(text))
  } else if kind == "ag" {
    Asn1Time.parseGeneralizedTime(String.utf8Bytes(text))
  } else {
    Instant.parse(text)
  }
  match move parsed {
    Result<Instant, TimeParseError>.Success { value: _ } => {
      return false
    }
    Result<Instant, TimeParseError>.Failure { error } => {
      return run isError(error, reason, offset)
    }
  }
}

// True if `parsed` is the instant `seconds` after the epoch.
fn isInstant(parsed: Result<Instant, TimeParseError>, seconds: i64) -> bool {
  match move parsed {
    Result<Instant, TimeParseError>.Success { value } => {
      return value.unixSeconds() == seconds && value.subsecondNanoseconds() == 0
    }
    Result<Instant, TimeParseError>.Failure { error: _ } => {
      return false
    }
  }
}

fn checkHttp(line: string) -> bool {
  let seconds = number(fieldAt(line, 1))
  let fixed = fieldAt(line, 2)
  let mut output: [u8; 32] = [0; 32]
  // The fraction of a second is dropped.
  let length = HttpDate.write(Instant.make(seconds, 999999999), &mut output, 3) - 3
  if !sameBytes(Slice.view<u8>(&output, 3, 29), length, fixed) {
    return false
  }
  if !isInstant(HttpDate.parse(fixed), seconds) || !isInstant(HttpDate.parse(fieldAt(line, 4)), seconds) {
    return false
  }
  let old = fieldAt(line, 3)
  return old == "-" || isInstant(HttpDate.parse(old), seconds)
}

fn checkHttpParse(line: string) -> bool {
  return isInstant(HttpDate.parse(fieldAt(line, 2)), number(fieldAt(line, 1)))
}

fn checkAsn1(line: string) -> bool {
  let seconds = number(fieldAt(line, 1))
  let short = fieldAt(line, 2)
  let long = fieldAt(line, 3)
  let instant = Instant.make(seconds, 999999999)
  let mut output: [u8; 16] = [0; 16]
  if short != "-" {
    if !isInstant(Asn1Time.parseUtcTime(String.utf8Bytes(short)), seconds) {
      return false
    }
    let length = Asn1Time.writeUtcTime(instant, &mut output, 1) - 1
    if !sameBytes(Slice.view<u8>(&output, 1, 15), length, short) {
      return false
    }
  }
  if !isInstant(Asn1Time.parseGeneralizedTime(String.utf8Bytes(long)), seconds) {
    return false
  }
  let length = Asn1Time.writeGeneralizedTime(instant, &mut output, 1) - 1
  return sameBytes(Slice.view<u8>(&output, 1, 15), length, long)
}

fn checkOffset(line: string) -> bool {
  match UtcOffset.parse(fieldAt(line, 1)) {
    Result<UtcOffset, TimeParseError>.Success { value } => {
      return i32.toI64(value.totalSeconds()) == number(fieldAt(line, 2))
    }
    Result<UtcOffset, TimeParseError>.Failure { error: _ } => {
      return false
    }
  }
}

effect fn checkDuration(line: string) -> bool
  ! WriterError {
  let a = Duration.make(number(fieldAt(line, 1)), number(fieldAt(line, 2)))
  let b = Duration.make(number(fieldAt(line, 3)), number(fieldAt(line, 4)))
  let factor = number(fieldAt(line, 5))
  let sum = a + b
  let difference = a - b
  if !(run shows<Duration>(&a, fieldAt(line, 6))) || !(run shows<Duration>(&sum, fieldAt(line, 7))) {
    return false
  }
  if !(run shows<Duration>(&difference, fieldAt(line, 8))) || !(run shows<Duration>(&(a * factor), fieldAt(line, 9))) {
    return false
  }
  // Identities that hold for every pair.
  return &(sum - b) == &a && &(difference + b) == &a && &(-(-a)) == &a && &(b + a) == &sum
    && (&a < &b) == (&difference < &Duration.zero())
    && (&a == &b) == difference.isZero()
    && a.sign() == -(-a).sign()
}

// Walks the calendar one day at a time and checks that each date follows the one before it.
// True if `made` is an identifier whose time is `expected`.
fn uuidInstantIs(made: Result<Uuid, UuidError>, expected: Instant) -> bool {
  match move made {
    Result<Uuid, UuidError>.Success { value } => {
      return &value.instant().unwrapOr(Instant.epoch()) == &expected
    }
    Result<Uuid, UuidError>.Failure { error: _ } => {
      return false
    }
  }
}

fn calendarSteps(from: i64, count: i64) -> i64 {
  let mut failures: i64 = 0
  let mut date = match PlainDate.fromEpochDays(from) {
    Option<PlainDate>.Some { value } => value
    Option<PlainDate>.None => {
      return 1
    }
  }
  let mut step: i64 = 0
  while step < count {
    let next = date.addDays(1)
    let mut follows = false
    if next.day() == date.day() + 1 {
      follows = next.month() == date.month() && next.year() == date.year()
    } else if next.day() == 1 && date.day() == date.daysInMonth() {
      if next.month() == date.month() + 1 {
        follows = next.year() == date.year()
      } else {
        follows = next.month() == 1 && date.month() == 12 && next.year() == date.year() + 1
      }
    }
    let weekday = date.weekday().number() % 7 + 1
    if !follows || next.weekday().number() != weekday || next.toEpochDays() != from + step + 1
      || !(&date < &next)
      || date.daysUntil(next) != 1 {
      failures = failures + 1
    }
    date = next
    step = step + 1
  }
  return failures
}

// Checks the limits of each range and the functions that the rows do not reach.
fn limits() -> i64 {
  let mut failures: i64 = 0
  let nanosecond = Duration.fromNanoseconds(1)
  let longest = Duration.make(i64.MAX, 999999999)
  let shortest = Duration.make(i64.MIN, 0)
  let checks = [
    PlainDate.fromEpochDays(100000001).isNone(),
    PlainDate.fromEpochDays(-100000002).isNone(),
    PlainDate.checkedMake(2026, 2, 29).isNone(),
    PlainDate.checkedMake(2026, 0, 1).isNone(),
    PlainDate.checkedMake(2026, 13, 1).isNone(),
    PlainDate.checkedMake(2026, 1, 0).isNone(),
    PlainDate.checkedMake(275760, 9, 14).isNone(),
    PlainDate.checkedMake(-271821, 4, 18).isNone(),
    PlainDate.max().checkedAddDays(1).isNone(),
    PlainDate.min().checkedAddDays(-1).isNone(),
    PlainDate.min().checkedAddDays(i64.MIN).isNone(),
    PlainDate.min().daysUntil(PlainDate.max()) == 200000001,
    PlainTime.checkedMake(24, 0, 0, 0).isNone(),
    PlainTime.checkedMake(0, 60, 0, 0).isNone(),
    PlainTime.checkedMake(0, 0, 60, 0).isNone(),
    PlainTime.checkedMake(0, 0, 0, 1000000000).isNone(),
    PlainTime.fromDayNanoseconds(86400000000000).isNone(),
    PlainTime.fromDayNanoseconds(-1).isNone(),
    PlainTime.make(23, 59, 59, 999999999).toDayNanoseconds() == 86399999999999,
    &PlainTime.midnight().addWrapping(-nanosecond) == &PlainTime.make(23, 59, 59, 999999999),
    &PlainTime.make(23, 30, 0, 0).addWrapping(Duration.fromHours(49)) == &PlainTime.make(0, 30, 0, 0),
    &PlainTime.make(1, 0, 0, 0).addWrapping(shortest) == &PlainTime.make(1, 0, 0, 0).addWrapping(Duration.fromSeconds(i64.MIN % 86400)),
    &PlainTime.make(9, 0, 0, 0).until(PlainTime.make(7, 30, 0, 0)) == &Duration.fromMinutes(-90),
    &PlainTime.make(7, 30, 0, 5).sinceMidnight() == &Duration.make(27000, 5),
    PlainDateTime.checkedMake(PlainDate.min(), PlainTime.midnight()).isNone(),
    PlainDateTime.checkedMake(PlainDate.min(), PlainTime.make(0, 0, 0, 1)).isSome(),
    PlainDateTime.make(PlainDate.max(), PlainTime.make(23, 59, 59, 999999999)).checkedAdd(nanosecond).isNone(),
    PlainDateTime.fromFields(2026, 12, 31, 23, 59, 59).checkedAdd(longest).isNone(),
    &PlainDateTime.fromFields(2026, 12, 31, 23, 59, 59).add(Duration.fromSeconds(1)) == &PlainDateTime.fromFields(2027, 1, 1, 0, 0, 0),
    &PlainDateTime.fromFields(2026, 3, 1, 0, 0, 0).add(-nanosecond) == &PlainDateTime.make(PlainDate.make(2026, 2, 28), PlainTime.make(23, 59, 59, 999999999)),
    &PlainDateTime.fromFields(2026, 3, 1, 0, 0, 0).until(PlainDateTime.fromFields(2024, 3, 1, 0, 0, 0)) == &Duration.fromHours(-730 * 24),
    &PlainDateTime.fromFields(2026, 3, 1, 0, 0, 0) < &PlainDateTime.fromFields(2026, 3, 1, 0, 0, 1),
    PlainDateTime.fromEpochSeconds(0, 1000000000).isNone(),
    Instant.checkedMake(8640000000000, 1).isNone(),
    Instant.checkedMake(-8640000000001, 999999999).isNone(),
    Instant.checkedMake(-8640000000001, 1000000000).isSome(),
    Instant.checkedMake(i64.MAX, 1000000000).isNone(),
    Instant.max().checkedAdd(nanosecond).isNone(),
    Instant.min().checkedSubtract(nanosecond).isNone(),
    Instant.max().checkedAdd(longest).isNone(),
    Instant.min().checkedSubtract(shortest).isNone(),
    &(Instant.max() - Instant.min()) == &Duration.fromSeconds(17280000000000),
    &(Instant.min() - Instant.max()) == &Duration.fromSeconds(-17280000000000),
    &Instant.epoch().until(Instant.make(-1, 999999999)) == &-nanosecond,
    &(Instant.epoch() - nanosecond) == &Instant.make(0, -1),
    &(Instant.make(5, 999999999) + nanosecond) == &Instant.fromUnixSeconds(6),
    Instant.make(-1, 999000000).unixMilliseconds() == -1,
    Instant.make(-1, 999000000).unixMicroseconds() == -1000,
    &Instant.fromUnixMilliseconds(-1) == &Instant.make(-1, 999000000),
    &Instant.fromUnixMicroseconds(-1) == &Instant.make(-1, 999999000),
    &Instant.fromUnixNanoseconds(i64.MIN) == &Instant.make(-9223372037, 145224192),
    Instant.fromUnixNanoseconds(i64.MIN).unixNanoseconds().unwrapOr(0) == i64.MIN,
    Instant.fromUnixNanoseconds(i64.MAX).unixNanoseconds().unwrapOr(0) == i64.MAX,
    Instant.max().unixNanoseconds().isNone(),
    Instant.fromUtc(PlainDateTime.make(PlainDate.max(), PlainTime.make(0, 0, 0, 1))).isNone(),
    Instant.fromLocal(PlainDateTime.make(PlainDate.max(), PlainTime.make(0, 0, 0, 1)), UtcOffset.fromSeconds(1)).isSome(),
    &Instant.min().toOffset(UtcOffset.fromSeconds(-86399)) == &PlainDateTime.make(PlainDate.min(), PlainTime.make(0, 0, 1, 0)),
    UtcOffset.checkedFromSeconds(86400).isNone(),
    UtcOffset.checkedFromSeconds(-86400).isNone(),
    UtcOffset.utc().isUtc() && !UtcOffset.fromMinutes(-90).isUtc(),
    &UtcOffset.fromMinutes(-90).toDuration() == &Duration.fromSeconds(-5400),
    &UtcOffset.fromMinutes(-90) < &UtcOffset.utc(),
    longest.checkedAdd(nanosecond).isNone(),
    longest.checkedAdd(-nanosecond).isSome(),
    shortest.checkedSubtract(nanosecond).isNone(),
    shortest.checkedAdd(-nanosecond).isNone(),
    shortest.checkedNegate().isNone(),
    shortest.checkedAbsolute().isNone(),
    Duration.make(i64.MIN, 1).checkedNegate().isSome(),
    &Duration.make(i64.MIN, 1).absolute() == &longest,
    Duration.make(-1, 1).checkedAdd(shortest).isNone(),
    &Duration.make(-1, 999999999).checkedAdd(Duration.make(i64.MIN, 1)).unwrapOr(Duration.zero()) == &shortest,
    &Duration.make(0, 999999999).checkedAdd(Duration.make(i64.MIN, 1)).unwrapOr(Duration.zero()) == &Duration.make(i64.MIN + 1, 0),
    &Duration.make(i64.MAX, 0).checkedSubtract(Duration.make(-1, 1)).unwrapOr(Duration.zero()) == &longest,
    Duration.make(i64.MAX, 0).checkedSubtract(Duration.make(-1, 0)).isNone(),
    Duration.checkedMake(i64.MAX, 1000000000).isNone(),
    Duration.checkedMake(i64.MIN, -1).isNone(),
    longest.checkedMultiply(2).isNone(),
    Duration.fromSeconds(4611686018427387904).checkedMultiply(2).isNone(),
    &Duration.fromSeconds(4611686018427387904).checkedMultiply(-2).unwrapOr(Duration.zero()) == &shortest,
    &Duration.fromNanoseconds(1).checkedMultiply(i64.MAX).unwrapOr(Duration.zero()) == &Duration.fromNanoseconds(i64.MAX),
    &Duration.fromNanoseconds(1).checkedMultiply(i64.MIN).unwrapOr(Duration.zero()) == &Duration.fromNanoseconds(i64.MIN),
    longest.toMilliseconds().isNone(),
    Duration.fromNanoseconds(i64.MIN).toNanoseconds().unwrapOr(0) == i64.MIN,
    Duration.fromMilliseconds(i64.MIN).toMilliseconds().unwrapOr(0) == i64.MIN,
    Duration.fromMicroseconds(i64.MAX).toMicroseconds().unwrapOr(0) == i64.MAX,
    Duration.make(-1, 500000000).toMilliseconds().unwrapOr(0) == -500,
    Duration.make(-2, 999999999).toMilliseconds().unwrapOr(0) == -1000,
    Duration.make(1, 999999999).toMilliseconds().unwrapOr(0) == 1999,
    Duration.make(-1, 500000000).toSecondsF64() == -0.5,
    Duration.make(-1, 500000000).isNegative() && !Duration.zero().isNegative(),
    Duration.zero().sign() == 0 && Duration.make(0, 1).sign() == 1 && Duration.make(-1, 999999999).sign() == -1,
    &Duration.fromHours(-2) == &Duration.fromMinutes(-120),
    Weekday.fromNumber(0).isNone() && Weekday.fromNumber(8).isNone() && Weekday.fromNumber(7).isSome(),
    Weekday.Sunday.name() == "Sunday" && Weekday.Monday.number() == 1,
    uuidInstantIs(Uuid.v7FromRandom(1763573782250, [0; 10]), Instant.make(1763573782, 250000000)),
    uuidInstantIs(Uuid.v1(139828665822500001, 0, [0; 6]), Instant.make(1763573782, 250000100)),
    uuidInstantIs(Uuid.v6(0, 0, [0; 6]), Instant.fromUnixSeconds(-12219292800)),
    Uuid.v4FromRandom([0; 16]).instant().isNone(),
  ]
  let mut index: usize = 0
  while index < checks.length {
    if !checks[index] {
      failures = failures + 1
    }
    index = index + 1
  }
  return failures
}

pub effect fn main() -> i32
  ! WriterError {
  let mut out = StdoutWriter.make()
  let table = rows()
  let mut failures: usize = 0
  let mut index: usize = 0
  while index < table.length {
    let line = table[index]
    let kind = fieldAt(line, 0)
    let mut passed = false
    if kind == "d" {
      passed = run checkDate(line)
    } else if kind == "i" {
      passed = run checkInstant(line)
    } else if kind == "p" {
      passed = run checkParse(line)
    } else if kind == "e" {
      passed = run checkReject(line)
    } else if kind == "o" {
      passed = checkOffset(line)
    } else if kind == "u" {
      passed = run checkDuration(line)
    } else if kind == "h" {
      passed = checkHttp(line)
    } else if kind == "hp" {
      passed = checkHttpParse(line)
    } else if kind == "a" {
      passed = checkAsn1(line)
    }
    if !passed {
      failures = failures + 1
      run Format.format("FAIL {}\n", &.(line)) |> Effect.provideMut<Writer>(&mut out)
    }
    index = index + 1
  }
  run Format.format("{} rows, {} failures\n", &(table.length, failures)) |> Effect.provideMut<Writer>(&mut out)
  // 1899-12-31 to 2100-03-02, across the century rule and the leap day of 2000, then the first
  // and the last days of the range.
  let steps = calendarSteps(-25568, 73110) + calendarSteps(-100000001, 800) + calendarSteps(99999200, 800)
  run Format.format("{} calendar step failures, {} limit failures\n", &(steps, limits()))
    |> Effect.provideMut<Writer>(&mut out)
  let moment = Instant.make(1795109782, 250000000)
  let local = moment.toOffset(UtcOffset.fromMinutes(-180))
  run Format.format(
    "{} {:?} {} {} {} {:?} {}\n",
    &(moment, local, local.date().weekday().name(), local.time(), UtcOffset.fromMinutes(-180), moment - Instant.epoch(), Duration.zero()),
  )
    |> Effect.provideMut<Writer>(&mut out)
  if failures > 0 || steps > 0 || limits() > 0 {
    return 1
  }
  return 0
}
