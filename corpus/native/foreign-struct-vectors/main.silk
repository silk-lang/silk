import silk.ownership {Copy}
extern "C" struct One { value: simd<f32, 4> }
extern "C" struct Pair { a: simd<f32, 4>, b: simd<f32, 4> }
extern "C" struct Quad { a: simd<f32, 4>, b: simd<f32, 4>, c: simd<f32, 4>, d: simd<f32, 4> }
extern "C" struct Bits { a: simd<f32, 4>, b: simd<u32, 4> }
impl Copy for Bits {}
impl Copy for One {}
impl Copy for Pair {}
impl Copy for Quad {}
unsafe extern "C" fn c_bits(value: Bits) -> Bits
unsafe extern "C" fn c_one(value: One) -> One
unsafe extern "C" fn c_pair(value: Pair) -> Pair
unsafe extern "C" fn c_quad(value: Quad) -> Quad
unsafe extern "C" fn c_vector_exports() -> i32
@callbacks("callback")
unsafe extern "C" fn c_vector_callback(callback: extern "C" fn(Pair) -> Pair, value: Pair) -> Pair
export "C" fn s_bits(value: Bits) -> Bits { return Bits { a: value.a + Intrinsic.simdSplat<simd<f32, 4>>(1.0), b: value.b + Intrinsic.simdSplat<simd<u32, 4>>(2) } }
export "C" fn s_one(value: One) -> One { return One { value: value.value + Intrinsic.simdSplat<simd<f32, 4>>(1.0) } }
export "C" fn s_pair(value: Pair) -> Pair { return Pair { a: value.b, b: value.a } }
export "C" fn s_quad(value: Quad) -> Quad { return Quad { a: value.d, b: value.c, c: value.b, d: value.a } }
fn indirect(callback: extern "C" fn(Pair) -> Pair, value: Pair) -> Pair { return unsafe callback(value) }
pub fn main() -> i32 {
  let a = Intrinsic.simdFromArray<simd<f32, 4>>([1.0, 2.0, 3.0, 4.0])
  let b = Intrinsic.simdFromArray<simd<f32, 4>>([5.0, 6.0, 7.0, 8.0])
  let one = unsafe c_one(One { value: a })
  if one.value != Intrinsic.simdFromArray<simd<f32, 4>>([2.0, 3.0, 4.0, 5.0]) { return 1 }
  let bits = unsafe c_bits(Bits { a: a, b: Intrinsic.simdFromArray<simd<u32, 4>>([10, 20, 30, 40]) })
  if bits.a != one.value || bits.b != Intrinsic.simdFromArray<simd<u32, 4>>([12, 22, 32, 42]) { return 7 }
  let pair = unsafe c_pair(Pair { a: a, b: b })
  if pair.a != b || pair.b != a { return 2 }
  let quad = unsafe c_quad(Quad { a: a, b: b, c: a, d: b })
  if quad.a != b || quad.b != a || quad.c != b || quad.d != a { return 3 }
  let callback = unsafe c_vector_callback(s_pair, Pair { a: a, b: b })
  if callback.a != b || callback.b != a { return 4 }
  let local = indirect(s_pair, Pair { a: a, b: b })
  if local.a != b || local.b != a { return 5 }
  if unsafe c_vector_exports() != 0 { return 6 }
  return 0
}
