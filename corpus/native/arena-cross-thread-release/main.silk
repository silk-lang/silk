import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.arena { Arena }
import silk.mem.box { Box }
import silk.core.effect { Effect }
import silk.num.i64
import silk.concurrency.thread_native { NativeThread, SpawnError }

fn finish(value: Box<i64>) -> i64 {
  let result = value.get()[0]
  drop value
  return result
}

// Allocations from an arena move to another thread and release their chunk there, after the
// arena itself is gone.
effect fn program() -> i32 ! OutOfMemoryError | SpawnError {
  let mut system = Allocator.systemAllocatorProvider()
  let mut arena = Arena.make(Allocator.systemAllocatorProvider())
  let first = run Box<i64>.make(40) |> Effect.provideMut<Allocator>(&mut arena)
  let second = run Box<i64>.make(2) |> Effect.provideMut<Allocator>(&mut arena)
  drop arena
  let left = run NativeThread.spawn(fn() -> i64 { return finish(move first) })
    |> Effect.provideMut<Allocator>(&mut system)
  let right = run NativeThread.spawn(fn() -> i64 { return finish(move second) })
    |> Effect.provideMut<Allocator>(&mut system)
  return i64.toI32(left.join() + right.join())
}

effect fn recover(error: OutOfMemoryError | SpawnError) -> i32 { return 9 }

pub fn main() -> i32 { return run Effect.catchAll(program(), recover) }
