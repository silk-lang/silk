import silk.core.option { Option }
import silk.mem.layout { Layout }

interface Unused { fn code(self: &Self) -> i32 }

fn absent(value: Option<&any Unused>) -> i32 {
  return match move value {
    Option<&any Unused>.Some { value: held } => Unused.code(held)
    Option<&any Unused>.None => 0
  }
}

interface Mark { fn mark(self: &Self) -> i32 }
struct Item { value: i32 }
struct Empty {}
impl Mark for Item { fn mark(self: &Self) -> i32 { return self.value } }
impl Mark for Empty { fn mark(self: &Self) -> i32 { return 2 } }

struct Expected<'a> { tag: u64, address: &'a Item }
union Choice<'a> { Present { value: &'a any Mark }, Missing }

fn selected(value: Option<&any Mark>) -> i32 {
  return match move value {
    Option<&any Mark>.Some { value: held } => held.mark()
    Option<&any Mark>.None => 0
  }
}

fn reverse(value: Choice<'_>) -> i32 {
  return match move value {
    Choice.Missing => 0
    Choice.Present { value: held } => held.mark()
  }
}

pub fn main() -> i32 {
  if absent(Option<&any Unused>.none()) != 0 { return 5 }
  let item = Item { value: 20 }
  let empty = Empty {}
  let shared: &any Mark = &item
  let other: &any Mark = &empty
  let expected = Layout.of<Expected<'static>>()
  let exclusive = Layout.of<&'static mut any Mark>()
  let optional = Layout.of<Option<&'static any Mark>>()
  if exclusive.bytes != expected.bytes || exclusive.alignment != expected.alignment { return 1 }
  if optional.bytes != expected.bytes || optional.alignment != expected.alignment { return 2 }
  if Layout.of<Choice<'static>>().bytes != expected.bytes { return 3 }
  if selected(Option<&any Mark>.none()) != 0 || reverse(Choice.Missing) != 0 { return 4 }
  return selected(Option<&any Mark>.some(shared)) + selected(Option<&any Mark>.some(other)) + reverse(Choice.Present { value: shared })
}
