static if (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText("libc") == "gnu") {
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.net.address { IpAddress }
import silk.system.system_info {
  NetworkInterface,
  ProcessorInfo,
  SystemInfo,
  SystemInfoError,
  SystemInfoOperation,
  UsageScope,
  UserInfo,
}
import silk.system.system_info_native { OsSystemInfo }

fn operationIndex(operation: SystemInfoOperation) -> i32 {
  return match operation {
    SystemInfoOperation.User => 1
    SystemInfoOperation.Priority => 2
    _ => 0
  }
}

fn sameBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut index: usize = 0
  while index < left.length {
    if left[index] != right[index] { return false }
    index = index + 1
  }
  return true
}

fn sameFamily(left: &IpAddress, right: &IpAddress) -> bool {
  return IpAddress.isV4(left) == IpAddress.isV4(right)
}

effect fn program() -> i32 ! SystemInfoError | OutOfMemoryError ? &mut SystemInfo | &mut Allocator {
  let host = run SystemInfo.hostName()
  if Bytes.length(&host) == 0 { return 1 }

  let kernel = run SystemInfo.kernel()
  let name = Bytes.asSlice(&kernel.name)
  if !sameBytes(name, b"Linux") && !sameBytes(name, b"Darwin") { return 2 }
  if Bytes.length(&kernel.release) == 0 || Bytes.length(&kernel.machine) == 0 { return 3 }

  let uptime = run SystemInfo.uptime()
  if uptime == 0 { return 4 }
  let load = run SystemInfo.loadAverage()
  if load[0] < 0.0 || load[1] < 0.0 || load[2] < 0.0 { return 5 }

  let memory = run SystemInfo.memory()
  if memory.total == 0 || memory.free > memory.total || memory.available > memory.total { return 6 }

  // Each processor has a model text, and the affinity mask is not larger than the system.
  let processors = run SystemInfo.processors()
  let count = List<ProcessorInfo>.length(&processors)
  if count == 0 { return 7 }
  let mut index: usize = 0
  while index < count {
    if Bytes.length(&List<ProcessorInfo>.asSlice(&processors)[index].model) == 0 { return 8 }
    index = index + 1
  }
  let parallelism = run SystemInfo.availableParallelism()
  if parallelism == 0 || parallelism > 1024 { return 9 }

  // Each address has a netmask of its family, and each loopback IPv4 address is internal.
  let interfaces = run SystemInfo.networkInterfaces()
  index = 0
  while index < List<NetworkInterface>.length(&interfaces) {
    let entry = &List<NetworkInterface>.asSlice(&interfaces)[index]
    if Bytes.length(&entry.name) == 0 || !sameFamily(&entry.address, &entry.netmask) { return 10 }
    let loopback = match entry.address {
      IpAddress.V4 { value } => value.octets()[0] == 127
      IpAddress.V6 { .. } => false
    }
    if loopback && !entry.internal { return 11 }
    index = index + 1
  }

  // The current user is the account of its own id, and an id with no account fails.
  let current = run SystemInfo.currentUser()
  if Bytes.length(&current.name) == 0 { return 12 }
  let again = run SystemInfo.user(current.uid)
  if !sameBytes(Bytes.asSlice(&again.name), Bytes.asSlice(&current.name)) || again.gid != current.gid { return 13 }
  let missing = run Effect.result(SystemInfo.user(4000000123))
  let missingOperation = match move missing {
    Result<UserInfo, SystemInfoError | OutOfMemoryError>.Success { .. } => 0
    Result<UserInfo, SystemInfoError | OutOfMemoryError>.Failure { error } => match move error {
      SystemInfoError { operation, .. } => operationIndex(operation)
      OutOfMemoryError { .. } => 0
    }
  }
  if missingOperation != 1 { return 14 }

  // Setting the priority that the process has is allowed. No process has the largest id.
  let priority = run SystemInfo.priority(0)
  if priority < -20 || priority > 19 { return 15 }
  run SystemInfo.setPriority(0, priority)
  let absent = run Effect.result(SystemInfo.priority(2147483647))
  let absentCode = match move absent {
    Result<i32, SystemInfoError>.Success { .. } => 0
    Result<i32, SystemInfoError>.Failure { error } => {
      if operationIndex(error.operation) == 2 { error.code } else { -1 }
    }
  }
  if absentCode != 3 { return 16 }

  let usage = run SystemInfo.resourceUsage(UsageScope.Process)
  if usage.maxResidentBytes == 0 { return 17 }
  let _thread = run SystemInfo.resourceUsage(UsageScope.Thread)
  let resident = run SystemInfo.residentSetSize()
  if resident == 0 { return 18 }

  let path = run SystemInfo.executablePath()
  if Bytes.length(&path) == 0 || Bytes.asSlice(&path)[0] != 47 { return 19 }
  let pid = run SystemInfo.processId()
  let parent = run SystemInfo.parentProcessId()
  if pid <= 0 || parent < 0 { return 20 }
  return 42
}

pub effect fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut provider = OsSystemInfo.make()
  let result = run Effect.result(program()) |> Effect.provideMut<SystemInfo>(&mut provider)
    |> Effect.provideMut<Allocator>(&mut allocator)
  return match move result {
    Result<i32, SystemInfoError | OutOfMemoryError>.Success { value } => value
    Result<i32, SystemInfoError | OutOfMemoryError>.Failure { .. } => 100
  }
}
} else {
pub fn main() -> i32 { return 42 }
}
