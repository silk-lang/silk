// Reads and writes declared types as JSON with silk.schema: renamed fields, optional fields,
// lists, unions of unit variants, and a newtype whose wire form is text decoded by a codec chain.
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.schema.codec { Between, Chain3, Codec, Codecs, NumberText, Refine, Trim }
import silk.schema.issue { Issue, IssueReason, SchemaError, Span }
import silk.schema.json { SchemaJson }
import silk.schema.schema { Schema, SchemaReader, SchemaWriter, Schemas, Spec }
import silk.text.string { String }
import silk.num.usize
import silk.num.u16

struct Capture {
  bytes: [u8; 256],
  length: usize,
}

impl Writer for Capture {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> () ! WriterError ? &mut Writer {
    let mut index: usize = 0
    while index < value.length {
      self.bytes[self.length] = value[index]
      self.length = self.length + 1
      index = index + 1
    }
    return ()
  }

  effect fn flush(self: &mut Self) -> () ! WriterError ? &mut Writer {
    return ()
  }
}

fn holds(capture: &Capture, expected: &[u8]) -> bool {
  if capture.length != expected.length { return false }
  let mut index: usize = 0
  while index < expected.length {
    if capture.bytes[index] != expected[index] { return false }
    index = index + 1
  }
  return true
}

/// A TCP port, written as text such as `" 8080 "`.
struct Port {
  pub value: u16,
}

// " 8080 " -> "8080" -> 8080, checked -> Port
fn portText() -> Chain3<Trim, Refine<NumberText<u16>, Between<u16>, u16, String>, PortOf, Port, String, u16, String> {
  return Codecs.chain3(Trim {},
    Codecs.check(NumberText<u16>.make(), Between<u16> {low: 1, high: 65535, message: "between 1 and 65535"}),
    PortOf {})
}

// Wraps a checked number in a `Port`.
struct PortOf {}

impl Codec<Port, u16> for PortOf {
  effect fn decode(self: &Self, input: u16) -> Port ! Issue | OutOfMemoryError ? &mut Allocator {
    return Port {value: input}
  }

  effect fn encode(self: &Self, value: &Port) -> u16 ! OutOfMemoryError ? &mut Allocator {
    return value.value
  }
}

impl Schema for Port {
  effect fn read<R: SchemaReader>(reader: &mut R) -> Port ! Issue | OutOfMemoryError ? &mut Allocator {
    return run Schemas.readVia<Port, String>(&portText(), &mut reader.*)
  }

  effect fn write<W: SchemaWriter>(self: &Self, writer: &mut W)
    -> () ! Issue | WriterError | OutOfMemoryError ? &mut Writer | &mut Allocator {
    return run Schemas.writeVia<Port, String>(&portText(), self, &mut writer.*)
  }
}

union Access { Guest, Member, Admin }
impl Schema for Access {}

struct Server {
  pub host: String,
  pub port: Port,
  pub access: Access,
  pub idleSeconds: u32,
  pub tags: List<String>,
  pub proxy: Option<String>,
}

impl Schema for Server {
  static fn spec() -> Spec<Server> {
    return Spec<Server>.of() |> Spec<Server>.rename("idleSeconds", "idle_seconds")
  }
}

effect fn decodeServer(text: &[u8]) -> Server ! SchemaError | OutOfMemoryError ? &mut Allocator {
  return run SchemaJson.decode<Server>(text)
}

effect fn failure(text: &[u8]) -> Option<SchemaError> ! OutOfMemoryError ? &mut Allocator {
  let result = run Effect.result(decodeServer(text))
  return match move result {
    Result<Server, SchemaError | OutOfMemoryError>.Success {..} => Option<SchemaError>.none()
    Result<Server, SchemaError | OutOfMemoryError>.Failure {error} => match move error {
      SchemaError {path, issue} => Option<SchemaError>.some(SchemaError {path: move path, issue: issue})
      OutOfMemoryError {} => { fail OutOfMemoryError {} }
    }
  }
}

fn failedAt(found: &Option<SchemaError>, path: string, reason: IssueReason) -> bool {
  return match &found.* {
    Option<SchemaError>.Some {value} => value.path.matchesText(path) && value.issue.reason == reason
    Option<SchemaError>.None => false
  }
}

fn spannedAt(found: &Option<SchemaError>, start: usize, end: usize) -> bool {
  return match &found.* {
    Option<SchemaError>.Some {value} => match value.issue.span {
      Option<Span>.Some {value: span} => span.start == start && span.end == end
      Option<Span>.None => false
    }
    Option<SchemaError>.None => false
  }
}

effect fn encodes(server: &Server, capture: &mut Capture) -> bool ! OutOfMemoryError ? &mut Allocator {
  let encoded = run Effect.result(SchemaJson.encode<Server>(server)) |> Effect.provideMut<Writer>(&mut capture.*)
  return match move encoded {
    Result<(), SchemaError | WriterError | OutOfMemoryError>.Success {..} => true
    Result<(), SchemaError | WriterError | OutOfMemoryError>.Failure {..} => false
  }
}

effect fn checks() -> i32 ! OutOfMemoryError | WriterError ? &mut Allocator {
  let server = match run Effect.result(decodeServer(
    b"{\"tags\": [\"a\", \"b\"], \"port\": \" 8080 \", \"host\": \"silk\", \"idle_seconds\": 30, \"access\": \"Member\", \"proxy\": null}")) {
    Result<Server, SchemaError | OutOfMemoryError>.Success {value} => move value
    Result<Server, SchemaError | OutOfMemoryError>.Failure {..} => { return 1 }
  }
  if server.port.value != 8080 { return 2 }
  if server.idleSeconds != 30 { return 3 }
  if List<String>.length(&server.tags) != 2 { return 4 }
  if server.proxy.isSome() { return 5 }

  let mut capture = Capture {bytes: [0; 256], length: 0}
  if !run encodes(&server, &mut capture) { return 6 }
  if !holds(&capture, b"{\"host\":\"silk\",\"port\":\"8080\",\"access\":\"Member\",\"idle_seconds\":30,\"tags\":[\"a\",\"b\"]}") { return 7 }

  let range = run failure(b"{\"host\": \"h\", \"port\": \"0\", \"access\": \"Guest\", \"idle_seconds\": 1, \"tags\": []}")
  if !failedAt(&range, "port", IssueReason.CheckFailed) || !spannedAt(&range, 22, 25) { return 8 }
  let missing = run failure(b"{\"host\": \"h\", \"port\": \"1\", \"access\": \"Guest\", \"tags\": []}")
  if !failedAt(&missing, "idle_seconds", IssueReason.MissingKey) { return 9 }
  let element = run failure(b"{\"host\": \"h\", \"port\": \"1\", \"access\": \"Guest\", \"idle_seconds\": 1, \"tags\": [\"x\", 3]}")
  if !failedAt(&element, "tags[1]", IssueReason.InvalidType) || !spannedAt(&element, 79, 80) { return 10 }
  let variant = run failure(b"{\"host\": \"h\", \"port\": \"1\", \"access\": \"Root\", \"idle_seconds\": 1, \"tags\": []}")
  if !failedAt(&variant, "access", IssueReason.UnknownVariant) { return 11 }
  let syntax = run failure(b"{\"host\": \"h\" \"port\"}")
  if !failedAt(&syntax, "", IssueReason.InvalidSyntax) || !spannedAt(&syntax, 13, 14) { return 12 }
  let trailing = run failure(b"{\"host\": \"h\", \"port\": \"1\", \"access\": \"Guest\", \"idle_seconds\": 1, \"tags\": []} 5")
  if !failedAt(&trailing, "", IssueReason.InvalidSyntax) { return 13 }
  return 0
}

pub effect fn main() -> i32 ! OutOfMemoryError | WriterError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checks() |> Effect.provideMut<Allocator>(&mut allocator)
}
