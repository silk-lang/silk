import silk.text.byte_search
import silk.option { Option }
import silk.collections.slice { Slice }
import silk.num.usize

// Every function against a byte-by-byte answer, over lengths that cover no vector, exactly one,
// several, and a tail, with the wanted byte at every position.
fn naiveFind(haystack: &[u8], wanted: u8) -> Option<usize> {
  let mut at: usize = 0
  while at < haystack.length {
    if haystack[at] == wanted { return Option<usize>.some(at) }
    at = at + 1
  }
  return Option<usize>.none()
}

fn naiveFindLast(haystack: &[u8], wanted: u8) -> Option<usize> {
  let mut end = haystack.length
  while end > 0 {
    end = end - 1
    if haystack[end] == wanted { return Option<usize>.some(end) }
  }
  return Option<usize>.none()
}

fn naiveFindSlice(haystack: &[u8], needle: &[u8]) -> Option<usize> {
  if needle.length > haystack.length { return Option<usize>.none() }
  let mut at: usize = 0
  while at + needle.length <= haystack.length {
    let mut offset: usize = 0
    while offset < needle.length && haystack[at + offset] == needle[offset] {
      offset = offset + 1
    }
    if offset == needle.length { return Option<usize>.some(at) }
    at = at + 1
  }
  return Option<usize>.none()
}

fn same(left: Option<usize>, right: Option<usize>) -> bool {
  return match move left {
    Option<usize>.Some { value: a } => match move right {
      Option<usize>.Some { value: b } => a == b
      Option<usize>.None => false
    }
    Option<usize>.None => match move right {
      Option<usize>.Some { value: _ } => false
      Option<usize>.None => true
    }
  }
}

pub fn main() -> i32 {
  let mut buffer: [u8; 80] = [0; 80]
  let mut length: usize = 0
  while length <= 80 {
    let mut position: usize = 0
    while position <= length {
      // Bytes 1 to 7 repeat; 9 appears once at `position`, and 10 at the end when there is room.
      let mut at: usize = 0
      while at < length {
        buffer[at] = usize.toU8(at % 7 + 1)
        at = at + 1
      }
      if position < length { buffer[position] = 9 }
      let haystack = Slice.view(&buffer, 0, length)
      if !same(byte_search.find(haystack, 9), naiveFind(haystack, 9)) { return 1 }
      if !same(byte_search.findLast(haystack, 3), naiveFindLast(haystack, 3)) { return 2 }
      if !same(byte_search.findLast(haystack, 9), naiveFindLast(haystack, 9)) { return 3 }
      if !same(byte_search.find2(haystack, 9, 11), naiveFind(haystack, 9)) { return 4 }
      if !same(byte_search.find3(haystack, 12, 11, 9), naiveFind(haystack, 9)) { return 5 }
      let mut nines: usize = 0
      if position < length { nines = 1 }
      if byte_search.count(haystack, 9) != nines { return 6 }
      let pair: [u8; 2] = [9, usize.toU8((position + 1) % 7 + 1)]
      if !same(byte_search.findSlice(haystack, &pair), naiveFindSlice(haystack, &pair)) { return 7 }
      let sequence: [u8; 5] = [3, 4, 5, 6, 7]
      if !same(byte_search.findSlice(haystack, &sequence), naiveFindSlice(haystack, &sequence)) { return 8 }
      position = position + 1
    }
    length = length + 1
  }
  if !same(byte_search.findSlice(b"abc", b""), Option<usize>.some(0)) { return 9 }
  if !same(byte_search.findSlice(b"ab", b"abc"), Option<usize>.none()) { return 10 }
  return 0
}
