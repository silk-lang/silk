interface Counter<T> {
  fn add(self: &mut Self, by: T) -> ()
  fn get(self: &Self) -> T
  fn initial(self: &Self) -> i32 { return 1 }
}

struct Plain { value: i32 }
struct Double { value: i32 }
impl Counter<i32> for Plain {
  fn add(self: &mut Self, by: i32) -> () { self.value = self.value + by }
  fn get(self: &Self) -> i32 { return self.value }
}
impl Counter<i32> for Double {
  fn add(self: &mut Self, by: i32) -> () { self.value = self.value + by * 2 }
  fn get(self: &Self) -> i32 { return self.value }
  fn initial(self: &Self) -> i32 { return 2 }
}

struct Slot<'a> { value: &'a any Counter<i32> }

fn inspect(x: &any Counter<i32>) -> i32 { return Counter.get(x) + x.initial() }
fn update(x: &mut any Counter<i32>, by: i32) -> () {
  Counter.add(&mut x.*, by)
  drop inspect(&x.*)
}

fn both(a: &mut Plain, b: &mut Double) -> () {
  let mut counters: [&mut any Counter<i32>; 2] = [move a, move b]
  update(&mut counters[0], 3)
  update(&mut counters[1], 3)
}

pub fn main() -> i32 {
  let mut a = Plain { value: 10 }
  let mut b = Double { value: 20 }
  both(&mut a, &mut b)
  let slot = Slot { value: &a }
  return inspect(slot.value) + inspect(&b)
}
