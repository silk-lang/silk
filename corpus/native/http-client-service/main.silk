//! An application written against the `Http` service runs unchanged on a scripted provider.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.http.client { Http, HttpError, HttpErrorKind, Request, Response }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.text.string { String }

struct Scripted {
  calls: i32,
}

impl Http for Scripted {
  effect fn send(self: &mut Self, request: Request) -> Response ! HttpError | OutOfMemoryError ? &mut Allocator {
    self.calls = self.calls + 1
    let url = run request.resolveUrl("https://example.com")
    if String.view(&url) == "https://example.com/get?language=Silk&q=a%20b" {
      return run Response.make(404, b"missing")
    }
    if String.view(&url) == "https://example.com/post" && request.hasBody() {
      return run Response.make(201, request.bodyBytes())
    }
    return run Response.make(500, String.utf8Bytes(String.view(&url)))
  }
}

effect fn app() -> i32 ! HttpError | OutOfMemoryError ? &mut Http | &mut Allocator {
  let got = run Http.send(Request.get("/get").query("language", "Silk").query("q", "a b"))
  if got.status() != 404 || got.ok() { return 1 }
  let posted = run Http.postJson("/post", &.{ language: "Silk", count: 3 })
  if posted.status() != 201 { return 2 }
  let text = run posted.text()
  if text != "{\"language\":\"Silk\",\"count\":3}" { return 3 }
  let checked = run Effect.result(got.expectOk())
  return match move checked {
    Result.Success { value: response } => 4
    Result.Failure { error } => {
      if error.kind != HttpErrorKind.Status { return 5 }
      return 0
    }
  }
}

pub effect fn main() -> i32 ! HttpError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut scripted = Scripted { calls: 0 }
  let code = run app() |> Effect.provideMut<Http>(&mut scripted) |> Effect.provideMut<Allocator>(&mut allocator)
  if scripted.calls != 2 { return 6 }
  return code
}
