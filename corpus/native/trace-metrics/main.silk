import silk.num.i64
import silk.num.u64
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.concurrency.sync { Arc }
import silk.trace { Meter, Metric }
import silk.trace.record { Config, Recorder }
import silk.trace.signals { MetricPoint, InstrumentKind }
import silk.trace.values { Value }

effect fn measure() -> () {
  Metric.countWith("visits", 4, &.{ region: "west", shard: 2 })
  Metric.countWith("visits", 3, &.{ shard: 2, region: "west" })
  Metric.adjustWith("active", -3, &.{ route: "index" })
  Metric.adjustWith("active", 1, &.{ route: "index" })
  Metric.gaugeWith("load", 4.5, &.{ warm: true })
  Metric.gaugeWith("load", 2.25, &.{ warm: true })
  Metric.recordWith("latency", 5.0, &.{ path: "/v1" })
  Metric.recordWith("latency", 10001.0, &.{ path: "/v1" })
  Metric.count("large", u64.MAX)
  Metric.count("large", 1)
  Metric.adjust("lower", i64.MIN)
  Metric.adjust("lower", -1)
  Metric.adjust("lower", 1)
  Metric.adjust("upper", i64.MAX)
  Metric.adjust("upper", 1)
  let mut i: i32 = 0
  while i < 11 {
    Metric.countWith("users", 1, &.{ user: i })
    i = i + 1
  }
}

fn check(recorder: &Recorder) -> i32 {
  let mut index: usize = 0
  let mut instruments: i32 = 0
  let mut users: i32 = 0
  let mut overflow: i32 = 0
  while index < recorder.signals.metricCapacity() {
    if let Option<MetricPoint>.Some {value: point} = recorder.signals.metricAt(index, recorder.now()) {
      if point.start > point.time { return 1 }
      if point.name == "visits" {
        if point.kind != InstrumentKind.Counter || point.count != 7 || point.attributes.count != 2 { return 2 }
        if let Value.Integer {value} = point.attributes.items[1].value {
          if value != 2 { return 3 }
        } else { return 4 }
        instruments = instruments + 1
      } else if point.name == "active" {
        if point.kind != InstrumentKind.UpDownCounter || point.adjustment != -2 { return 5 }
        instruments = instruments + 1
      } else if point.name == "load" {
        if point.kind != InstrumentKind.Gauge || point.value != 2.25 || point.attributes.count != 1 { return 6 }
        if let Value.Bool {value} = point.attributes.items[0].value {
          if !value { return 13 }
        } else { return 14 }
        instruments = instruments + 1
      } else if point.name == "latency" {
        if point.kind != InstrumentKind.Histogram || point.count != 2 || point.value != 10006.0
          || point.buckets[1] != 1 || point.buckets[15] != 1 || point.attributes.count != 1 { return 7 }
        if let Value.Text {value} = &point.attributes.items[0].value {
          if value.view() != "/v1" { return 15 }
        } else { return 16 }
        instruments = instruments + 1
      } else if point.name == "large" {
        if point.count != u64.MAX { return 17 }
        instruments = instruments + 1
      } else if point.name == "lower" {
        if point.adjustment != i64.MIN + 1 { return 18 }
        instruments = instruments + 1
      } else if point.name == "upper" {
        if point.adjustment != i64.MAX { return 19 }
        instruments = instruments + 1
      } else if point.name == "users" {
        if point.overflow {
          if point.count != 3 || point.attributes.count != 0 { return 8 }
          overflow = overflow + 1
        } else {
          if point.count != 1 || point.attributes.count != 1 { return 9 }
          users = users + 1
        }
      } else { return 10 }
    }
    index = index + 1
  }
  if instruments != 7 || users != 8 || overflow != 1 { return 11 }
  return 0
}

effect fn exercise() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let recorder = run Arc<Recorder>.make(run Recorder.make(Config.make("metrics")))
  run measure() |> Effect.provideAmbient<Meter>(&recorder)
  let result = check(recorder.get())
  if result != 0 { return result }
  return check(recorder.get())
}
effect fn failed(error: OutOfMemoryError) -> i32 { return 12 }
pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(exercise() |> Effect.provideMut<Allocator>(&mut allocator), failed)
}
