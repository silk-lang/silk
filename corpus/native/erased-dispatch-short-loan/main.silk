interface Read { effect fn read(self: &mut Self) -> i32 }
interface Source<'data> { fn get(self: &Self) -> &'data i32 }

struct Cursor<'a> { source: &'a i32, reads: i32 }
impl<'a> Read for Cursor<'a> {
  effect fn read(self: &mut Self) -> i32 {
    self.reads = self.reads + 1
    return self.source.*
  }
}
impl<'a> Source<'a> for Cursor<'a> {
  fn get(self: &Self) -> &'a i32 { return self.source }
}

effect fn read(p: &mut any Read) -> i32 { return run p.read() }
effect fn twice(cursor: &mut Cursor<'_>) -> i32 {
  let first = run read(&mut cursor.*)
  let second = run read(&mut cursor.*)
  return first + second + cursor.reads
}
fn source<'a>(p: &any Source<'a>) -> &'a i32 { return p.get() }
fn forwarded<'a>(cursor: &Cursor<'a>) -> &'a i32 {
  let p: &any Source<'a> = cursor
  return source<'a>(p)
}

pub effect fn main() -> i32 {
  let n: i32 = 20
  let mut cursor = Cursor {source: &n, reads: 0}
  let total = run twice(&mut cursor)
  if forwarded(&cursor).* != n { return 1 }
  return total
}
