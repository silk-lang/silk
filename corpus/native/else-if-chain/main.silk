fn classify(value: i32) -> i32 {
  if value < 0 { return 0 }
  else if value < 10 { return 1 }
  else if value < 100 { return 2 }
  else { return 3 }
  return 4
}
pub fn main() -> i32 {
  if classify(0 - 5) != 0 { return 1 }
  if classify(5) != 1 { return 2 }
  if classify(50) != 2 { return 3 }
  if classify(500) != 3 { return 4 }
  return 42
}