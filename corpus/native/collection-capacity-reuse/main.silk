import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.collections.hash { Hash, Word }
import silk.collections.hash_map { HashMap }
import silk.collections.hash_set { HashSet }
import silk.collections.list { List }
import silk.core.ownership { Drop }
import silk.mem.shared { Shared }
import silk.text.string { String }

struct Counts { dropped: i32 }
fn countDrop(counts: &mut Counts) -> i32 {
  counts.dropped = counts.dropped + 1
  return 0
}
fn droppedOf(counts: &Counts) -> i32 { return counts.dropped }

struct Tracked { counts: Shared<Counts> }
impl Drop for Tracked {
  fn drop(self: &mut Tracked) -> () {
    let changed = Shared<Counts>.withMut<i32>(&self.counts, countDrop)
    return ()
  }
}
fn tracked(counts: &Shared<Counts>) -> Tracked {
  return Tracked { counts: Shared<Counts>.clone(counts) }
}
fn dropped(counts: &Shared<Counts>) -> i32 {
  return Shared<Counts>.with<i32>(counts, droppedOf)
}

effect fn lists(counts: &Shared<Counts>) -> i32 ! OutOfMemoryError ? &mut Allocator {
  let mut values = run List<i32>.makeWithCapacity(10)
  if List<i32>.capacity(&values) != 10 { return 1 }
  let mut index = 0
  while index < 10 {
    run List<i32>.append(&mut values, index)
    index = index + 1
  }
  if List<i32>.capacity(&values) != 10 { return 2 }
  List<i32>.clear(&mut values)
  if List<i32>.length(&values) != 0 || List<i32>.capacity(&values) != 10 { return 3 }
  run List<i32>.shrinkToFit(&mut values)
  if List<i32>.capacity(&values) != 0 { return 4 }
  run List<i32>.append(&mut values, 5)
  List<i32>.clearAndFree(&mut values)
  if List<i32>.length(&values) != 0 || List<i32>.capacity(&values) != 0 { return 5 }
  let empty = run List<i32>.makeWithCapacity(0)
  if List<i32>.capacity(&empty) != 0 { return 6 }

  let mut owned = run List<Tracked>.makeWithCapacity(3)
  run List<Tracked>.append(&mut owned, tracked(counts))
  run List<Tracked>.append(&mut owned, tracked(counts))
  List<Tracked>.clearAndFree(&mut owned)
  if dropped(counts) != 2 { return 7 }
  run List<Tracked>.append(&mut owned, tracked(counts))
  List<Tracked>.clear(&mut owned)
  if dropped(counts) != 3 || List<Tracked>.capacity(&owned) == 0 { return 8 }
  return 0
}

effect fn text() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let mut bytes = run Bytes.makeWithCapacity(8)
  run Bytes.append(&mut bytes, b"abcdefgh")
  if Bytes.capacity(&bytes) != 8 { return 11 }
  run Bytes.reserve(&mut bytes, 1)
  if Bytes.capacity(&bytes) != 16 { return 12 }
  run Bytes.shrinkToFit(&mut bytes)
  if Bytes.capacity(&bytes) != 8 { return 13 }
  Bytes.clear(&mut bytes)
  if Bytes.length(&bytes) != 0 || Bytes.capacity(&bytes) != 8 { return 14 }
  Bytes.clearAndFree(&mut bytes)
  if Bytes.capacity(&bytes) != 0 { return 15 }

  let mut line = run String.makeWithCapacity(4)
  run String.append(&mut line, "héllo")
  if String.capacity(&line) < 6 { return 16 }
  String.clear(&mut line)
  let kept = String.capacity(&line)
  if String.ownedByteLength(&line) != 0 || kept < 6 { return 17 }
  run String.append(&mut line, "hi")
  if String.capacity(&line) != kept || String.view(&line) != "hi" { return 18 }
  run String.reserveExact(&mut line, 100)
  if String.capacity(&line) != 102 { return 19 }
  run String.shrinkToFit(&mut line)
  if String.capacity(&line) != 2 { return 20 }
  String.clearAndFree(&mut line)
  if String.capacity(&line) != 0 || String.ownedByteLength(&line) != 0 { return 21 }
  return 0
}

effect fn maps(counts: &Shared<Counts>) -> i32 ! OutOfMemoryError ? &mut Allocator {
  let mut map = run HashMap<Word, Tracked>.makeWithCapacity(Hash.seed(4), 6)
  if HashMap<Word, Tracked>.bucketCount(&map) != 8 { return 31 }
  let mut key: u64 = 0
  while key < 6 {
    let previous = run HashMap<Word, Tracked>.insert(&mut map, Hash.word(key), tracked(counts))
    drop previous
    key = key + 1
  }
  if HashMap<Word, Tracked>.bucketCount(&map) != 8 { return 32 }
  let before = dropped(counts)
  HashMap<Word, Tracked>.clear(&mut map)
  if dropped(counts) != before + 6 { return 33 }
  if HashMap<Word, Tracked>.length(&map) != 0 || HashMap<Word, Tracked>.bucketCount(&map) != 8 {
    return 34
  }
  if HashMap<Word, Tracked>.contains(&map, Hash.word(3)) { return 35 }
  let again = run HashMap<Word, Tracked>.insert(&mut map, Hash.word(3), tracked(counts))
  drop again
  if !HashMap<Word, Tracked>.contains(&map, Hash.word(3)) { return 36 }
  run HashMap<Word, Tracked>.reserve(&mut map, 6)
  if HashMap<Word, Tracked>.bucketCount(&map) != 16 { return 37 }
  if !HashMap<Word, Tracked>.contains(&map, Hash.word(3)) { return 38 }
  HashMap<Word, Tracked>.clearAndFree(&mut map)
  if dropped(counts) != before + 7 { return 39 }
  if HashMap<Word, Tracked>.bucketCount(&map) != 0 || HashMap<Word, Tracked>.length(&map) != 0 {
    return 40
  }
  let refilled = run HashMap<Word, Tracked>.insert(&mut map, Hash.word(9), tracked(counts))
  drop refilled
  if HashMap<Word, Tracked>.bucketCount(&map) != 8 { return 41 }
  let unallocated = run HashMap<Word, i32>.makeWithCapacity(Hash.seed(4), 0)
  if HashMap<Word, i32>.bucketCount(&unallocated) != 0 { return 42 }
  let wide = run HashMap<Word, i32>.makeWithCapacity(Hash.seed(4), 7)
  if HashMap<Word, i32>.bucketCount(&wide) != 16 { return 43 }

  let mut set = run HashSet<Word>.makeWithCapacity(Hash.seed(5), 12)
  if HashSet<Word>.bucketCount(&set) != 16 { return 51 }
  let seen = run HashSet<Word>.insert(&mut set, Hash.word(1))
  HashSet<Word>.clear(&mut set)
  if HashSet<Word>.length(&set) != 0 || HashSet<Word>.bucketCount(&set) != 16 { return 52 }
  if HashSet<Word>.contains(&set, Hash.word(1)) { return 53 }
  HashSet<Word>.clearAndFree(&mut set)
  if HashSet<Word>.bucketCount(&set) != 0 { return 54 }
  run HashSet<Word>.reserve(&mut set, 0)
  if HashSet<Word>.bucketCount(&set) != 0 { return 55 }
  return 0
}

effect fn build() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let counts = run Shared<Counts>.make(Counts { dropped: 0 })
    |> Effect.provideMut<Allocator>(&mut allocator)
  let listed = run lists(&counts) |> Effect.provideMut<Allocator>(&mut allocator)
  if listed != 0 { return listed }
  let written = run text() |> Effect.provideMut<Allocator>(&mut allocator)
  if written != 0 { return written }
  let mapped = run maps(&counts) |> Effect.provideMut<Allocator>(&mut allocator)
  if mapped != 0 { return mapped }
  return 100
}
effect fn recover(error: OutOfMemoryError) -> i32 { return 99 }
pub fn main() -> i32 { return run Effect.catchAll(build(), recover) }
