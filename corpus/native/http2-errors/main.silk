  }
  let case22 = run check(b"", b"\x00\x00\x02\x01\x05\x00\x00\x00\x01\x82\x87", 1, 1)
  if !case22 {
    return 22
  }
  let case23 = run check(
    b"",
    b"\x00\x00\x11\x01\x05\x00\x00\x00\x01\x82\x87\x84\x40\x87\xfc\x5b\x86\xbd\x78\x36\xff\x84\xee\x3a\x2d\x2f",
    1,
