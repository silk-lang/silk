import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.http.http2 { Connection, Event, Limits, Role }
import silk.http.http2_frame { ProtocolError }
import silk.core.result { Result }
import silk.num.u32
import silk.num.usize

effect fn check(prefix: &[u8], wire: &[u8], code: u32, stream: u32) -> bool
  ! ProtocolError | OutOfMemoryError
  ? &mut Allocator {
  let mut conn = run Connection.make(Role.Server, Limits.defaults())
  drop run Connection.receive(
    &mut conn,
    b"PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n\x00\x00\x00\x04\x00\x00\x00\x00\x00"
  )
  let pending = Connection.output(&conn).length
  run Connection.consumeOutput(&mut conn, pending)
  if prefix.length > 0 {
    drop run Connection.receive(&mut conn, prefix)
  }
  let result = run Effect.result(Connection.receive(&mut conn, wire))
  match move result {
    Result.Success { value } => {
      if stream == 0 || value.consumed != wire.length || Connection.failed(&conn) {
        return false
      }
      match move value.event {
        Event.StreamError { stream: foundStream, code: foundCode } => {
          if stream != foundStream || code != foundCode {
            return false
          }
        }
        _ => {
          return false
        }
      }
      let queued = Connection.output(&conn)
      if queued.length < 13 {
        return false
      }

      // A stream error must leave the connection ready for another stream.
      let next = run Connection.receive(
        &mut conn,
        b"\x00\x00\x03\x01\x05\x00\x00\x00\x03\x82\x86\x84"
      )
      return match move next.event {
        Event.Headers { stream: foundStream, fields, endStream } => foundStream == 3
        _ => false
      }
    }
    Result.Failure { error } => match move error {
      ProtocolError failure => {
        let queued = Connection.output(&conn)
        return stream == 0 && failure.stream == 0 && failure.code == code
          && Connection.failed(&conn)
          && queued.length >= 17
          && queued[3] == 7
      }
      OutOfMemoryError failure => {
        fail move failure
      }
    }
  }
}

effect fn test() -> i32
  ! ProtocolError | OutOfMemoryError
  ? &mut Allocator {
  let case1 = run check(b"", b"\x00\x00\x00\x00\x00\x00\x00\x00\x00", 1, 0)
  if !case1 {
    return 1
  }
  let case2 = run check(b"", b"\x00\x00\x01\x00\x00\x00\x00\x00\x01\x78", 1, 0)
  if !case2 {
    return 2
  }
  let case3 = run check(b"", b"\x00\x00\x04\x02\x00\x00\x00\x00\x01\x31\x32\x33\x34", 6, 1)
  if !case3 {
    return 3
  }
  let case4 = run check(b"", b"\x00\x00\x05\x02\x00\x00\x00\x00\x01\x00\x00\x00\x01\x00", 1, 1)
  if !case4 {
    return 4
  }
  let case5 = run check(b"", b"\x00\x00\x04\x03\x00\x00\x00\x00\x01\x00\x00\x00\x00", 1, 0)
  if !case5 {
    return 5
  }
  let case6 = run check(b"", b"\x00\x00\x01\x04\x01\x00\x00\x00\x00\x78", 6, 0)
  if !case6 {
    return 6
  }
  let case7 = run check(b"", b"\x00\x00\x03\x04\x00\x00\x00\x00\x00\x61\x62\x63", 6, 0)
  if !case7 {
    return 7
  }
  let case8 = run check(b"", b"\x00\x00\x06\x04\x00\x00\x00\x00\x00\x00\x02\x00\x00\x00\x02", 1, 0)
  if !case8 {
    return 8
  }
  let case9 = run check(b"", b"\x00\x00\x06\x04\x00\x00\x00\x00\x00\x00\x04\x80\x00\x00\x00", 3, 0)
  if !case9 {
    return 9
  }
  let case10 = run check(b"", b"\x00\x00\x06\x04\x00\x00\x00\x00\x00\x00\x05\x00\x00\x3f\xff", 1, 0)
  if !case10 {
    return 10
  }
  let case11 = run check(
    b"",
    b"\x00\x00\x07\x06\x00\x00\x00\x00\x00\x31\x32\x33\x34\x35\x36\x37",
    6,
    0
  )
  if !case11 {
    return 11
  }
  let case12 = run check(
    b"",
    b"\x00\x00\x08\x06\x00\x00\x00\x00\x01\x31\x32\x33\x34\x35\x36\x37\x38",
    1,
    0
  )
  if !case12 {
    return 12
  }
  let case13 = run check(
    b"",
    b"\x00\x00\x07\x07\x00\x00\x00\x00\x00\x31\x32\x33\x34\x35\x36\x37",
    6,
    0
  )
  if !case13 {
    return 13
  }
  let case14 = run check(b"", b"\x00\x00\x04\x08\x00\x00\x00\x00\x00\x00\x00\x00\x00", 1, 0)
  if !case14 {
    return 14
  }
  let case15 = run check(b"", b"\x00\x00\x04\x08\x00\x00\x00\x00\x01\x00\x00\x00\x01", 1, 0)
  if !case15 {
    return 15
  }
  let case16 = run check(b"", b"\x00\x00\x04\x08\x00\x00\x00\x00\x00\x7f\xff\xff\xff", 3, 0)
  if !case16 {
    return 16
  }
  let case17 = run check(b"", b"\x00\x40\x01\xff\x00\x00\x00\x00\x00", 6, 0)
  if !case17 {
    return 17
  }
  let case18 = run check(
    b"\x00\x00\x01\x01\x00\x00\x00\x00\x01\x82",
