  )
  if !case26 {
    return 26
  }
  let case27 = run check(b"", b"\x00\x00\x06\x01\x05\x00\x00\x00\x01\x82\x87\x84\x5c\x81\x0f", 1, 1)
  if !case27 {
    return 27
  }
  let case28 = run check(
    b"",
    b"\x00\x00\x15\x01\x05\x00\x00\x00\x01\x42\x87\xbd\xab\x4e\x9c\x17\xb7\xff\x87\x41\x89\x2f\x91\xd3\x5d\x05\xb8\xd3\x4c\xff",
    1,
    1
  )
  if !case28 {
    return 28
  }
  let case29 = run check(
    b"",
    b"\x00\x00\x0c\x01\x05\x00\x00\x00\x01\x82\x87\x84\x41\x82\x3d\x45\x66\x83\x4f\x83\xff",
    1,
    1
  )
  if !case29 {
    return 29
  }
  let case30 = run check(
    b"\x00\x00\x03\x01\x05\x00\x00\x00\x01\x82\x86\x84",
    b"\x00\x00\x01\x00\x00\x00\x00\x00\x01\x78",
    5,
    1
  )
  if !case30 {
    return 30
  }
  let case31 = run check(
    b"\x00\x00\x03\x01\x04\x00\x00\x00\x01\x82\x86\x84",
    b"\x00\x00\x0f\x01\x04\x00\x00\x00\x01\x40\x87\xf2\xb2\x6c\x19\xa8\x2d\x9f\x85\xa8\xeb\x16\xa9\x3f",
    1,
    1
  )
  if !case31 {
    return 31
  }
  let case32 = run check(
    b"\x00\x00\x03\x01\x04\x00\x00\x00\x01\x82\x86\x84",
    b"\x00\x00\x04\x08\x00\x00\x00\x00\x01\x7f\xff\xff\xff",
    3,
    1
  )
  if !case32 {
    return 32
  }
  return 0
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  return 99
}

pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(test(), failed) |> Effect.provideMut<Allocator>(&mut allocator)
}
