// A named function or closure meets a written callable contract annotation as it meets a parameter
// of that contract.
fn inc(x: i32) -> i32 { return x + 1 }
fn apply(f: fn(i32) -> i32, value: i32) -> i32 { return f(value) }
pub fn main() -> i32 {
  let f: fn(i32) -> i32 = inc
  let g: fn<'static>(i32) -> i32 = inc
  let h: fn(i32) -> i32 = fn(x: i32) -> i32 { return x * 2 }
  return f(9) + g(9) + apply(h, 6) + apply(f, 9)
}
