import silk.text.script_itemization { ScriptRun }
import silk.text.script_itemization
import silk.text.unicode_script { Script }
import silk.core.result { Result }
import silk.text.string { InvalidUtf8 }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.collections.list { List }
import silk.text.string { String }
import silk.testing.testing { Testing, AssertionError }

// ICU reference algorithm:
// https://github.com/unicode-org/icu/blob/release-78.1/icu4c/source/extra/scrptrun/scrptrun.cpp
// ScriptRun::next assigns common punctuation to the prevailing script, pushes
// opening scripts, searches down the stack on a close and discards intervening
// openings. The ASCII bracket cases below exercise those same decisions, with
// UTF-8 byte offsets rather than ICU's UTF-16 offsets. Its sameScript only uses
// primary Script: the extension-intersection and cross-script-mark cases below
// deliberately follow UAX #24 §§5.2–5.3 instead of that old sample's behavior.
// Execute the separately pinned baseline comparison against actual Silk output:
// integration/unicode-conformance/check-script-itemization
// It reports linked ICU/UCD versions and checks intentional differences too.

effect fn expectRuns(text: string, ends: &[usize], tags: &[u32]) -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let bytes = String.utf8Bytes(text)
  let mut runs = List<ScriptRun>.make()
  run script_itemization.scripts(text, &mut runs)
  let actual = List<ScriptRun>.asSlice(&runs)
  run Testing.expect(actual.length == ends.length && ends.length == tags.length, "script run count")
  let mut start: usize = 0
  let mut i: usize = 0
  while i < actual.length {
    run Testing.expect(
      actual[i].start == start && actual[i].end == ends[i],
      "original UTF-8 byte range",
    )
    run Testing.expect(actual[i].script.value == tags[i], "contextual script")
    run Testing.expect(actual[i].start < actual[i].end, "nonempty script run")
    if i > 0 {
      run Testing.expect(
        actual[i - 1].script.value != actual[i].script.value,
        "no redundant script run",
      )
    }
    start = actual[i].end
    i = i + 1
  }
  run Testing.expect(start == bytes.length, "complete byte coverage")
}

effect fn contextualCases() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  run expectRuns("", &[], &[])
  run expectRuns(" ... ", &[5], &[0x5a797979])
  run expectRuns("  α!", &[5], &[0x4772656b])
  run expectRuns("a, Б!", &[3, 6], &[0x4c61746e, 0x4379726c])
  run expectRuns("é世界!", &[2, 9], &[0x4c61746e, 0x48616e69])
  run expectRuns("😀a😀", &[9], &[0x4c61746e])

  // Ordinary, leading, script-specific, and extension-restricted marks.
  run expectRuns("áБ", &[3, 5], &[0x4c61746e, 0x4379726c])
  run expectRuns("́α", &[4], &[0x4772656b])
  run expectRuns("aאְ", &[1, 5], &[0x4c61746e, 0x48656272])
  run expectRuns("aְב", &[3, 5], &[0x4c61746e, 0x48656272])
  run expectRuns("a゙ア", &[4, 7], &[0x4c61746e, 0x4b616e61])

  // U+30FC is Common but its extensions are only Hira/Kana.
  run expectRuns("Aーア", &[1, 7], &[0x4c61746e, 0x4b616e61])
  run expectRuns("ーあ", &[6], &[0x48697261])
  run expectRuns("ー、ア", &[9], &[0x4b616e61])
  run expectRuns("あーア", &[6, 9], &[0x48697261, 0x4b616e61])
  run expectRuns("ー", &[3], &[0x48697261])

  // U+0640 has nine extensions: context must pick Syriac, not the first.
  run expectRuns("ـܐ", &[4], &[0x53797263])
  run expectRuns("a(γ)b", &[2, 4, 6], &[0x4c61746e, 0x4772656b, 0x4c61746e])
  run expectRuns(
    "a(α[Б]β)c",
    &[2, 5, 7, 10, 12],
    &[0x4c61746e, 0x4772656b, 0x4379726c, 0x4772656b, 0x4c61746e],
  )

  // Openings before the first explicit script resolve retroactively.
  run expectRuns("((α)Б)", &[5, 7, 8], &[0x4772656b, 0x4379726c, 0x4772656b])
  run expectRuns("a([Б)γ]", &[3, 5, 6, 9], &[0x4c61746e, 0x4379726c, 0x4c61746e, 0x4772656b])
  run expectRuns("a(Б]γ)", &[2, 5, 8], &[0x4c61746e, 0x4379726c, 0x4772656b])

  // Canonical-equivalent angle brackets match across the two encodings.
  run expectRuns("あ〈a〉", &[6, 7, 10], &[0x48697261, 0x4c61746e, 0x48697261])
  run expectRuns("あ〈a〉", &[6, 7, 10], &[0x48697261, 0x4c61746e, 0x48697261])
}

effect fn storageCases() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut runs = List<ScriptRun>.make()
  run List<ScriptRun>.append(
    &mut runs,
    ScriptRun { start: 99, end: 100, script: Script { value: 0x48616e69 } },
  )
  run script_itemization.scripts("a(\u{3b1})", &mut runs)
  run Testing.expect(List<ScriptRun>.length(&runs) == 4, "append contract")
  run Testing.expect(
    List<ScriptRun>.asSlice(&runs)[3].script.value == 0x4c61746e,
    "bracket run indices include existing output",
  )

  // No fixed bracket-stack depth: all openings and closes survive 200 levels.
  let mut text = List<u8>.make()
  run List<u8>.append(&mut text, 97)
  let mut i: usize = 0
  while i < 200 {
    run List<u8>.append(&mut text, 40)
    i = i + 1
  }
  run List<u8>.append(&mut text, 0xce)
  run List<u8>.append(&mut text, 0xb1)
  i = 0
  while i < 200 {
    run List<u8>.append(&mut text, 41)
    i = i + 1
  }
  List<ScriptRun>.clear(&mut runs)
  let valid = match String.fromUtf8(List<u8>.asSlice(&text)) {
    Result<string, InvalidUtf8>.Success { value } => value
    Result<string, InvalidUtf8>.Failure { error } => ""
  }
  run script_itemization.scripts(valid, &mut runs)
  let deep = List<ScriptRun>.asSlice(&runs)
  run Testing.expect(deep.length == 3, "unbounded nested bracket stack")
  run Testing.expect(
    deep[0].end == 201 && deep[1].end == 203 && deep[2].end == 403,
    "deep nesting byte ranges",
  )
  run Testing.expect(
    deep[2].script.value == 0x4c61746e,
    "all closing brackets inherit outer script",
  )
}

effect fn contextualScriptItemization() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run contextualCases() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn scriptItemizationStorage() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run storageCases() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Each check above runs in order; the first failed assertion ends the program with its own code.
effect fn all() -> i32
  ! AssertionError<'static> | OutOfMemoryError {
  run contextualScriptItemization()
  run scriptItemizationStorage()
  return 42
}

effect fn assertionFailed(error: AssertionError<'static>) -> i32 {
  return 1
}

effect fn outOfMemory(error: OutOfMemoryError) -> i32 {
  return 2
}

pub fn main() -> i32 {
  return run Effect.catch(Effect.catch(all(), assertionFailed), outOfMemory)
}
