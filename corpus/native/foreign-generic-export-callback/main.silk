// FFI-012: C code calls back a generic export written once in a library and instantiated for
// the program's types, from concrete code and from code that is itself generic.
import silk.mem.pointer { Pointer }
import callbacks.scaling { Scale, Packet, scaled, entered }
import callbacks.scaling

@callbacks("visit")
unsafe extern "C" fn silk_test_apply(visit: extern "C" fn(i32) -> i32, value: i32) -> i32
@callbacks("visit")
unsafe extern "C" fn silk_test_apply_optional(visit: ?extern "C" fn(i32) -> i32, value: i32) -> i32
@callbacks("left", "right")
unsafe extern "C" fn silk_test_same(left: extern "C" fn(i32) -> i32, right: extern "C" fn(i32) -> i32) -> i32
@threadCallbacks("entry")
unsafe extern "C" fn silk_test_enter(entry: extern "C" fn(?*mut u8) -> ?*mut u8, packet: ?*mut u8) -> ?*mut u8
extern "C" struct Registration { visit: extern "C" fn(i32) -> i32, value: i32 }
@callbacks("registration.visit")
unsafe extern "C" fn silk_test_registered(registration: Registration) -> i32

struct Two {}
struct Three {}
impl Scale for Two {
  fn make() -> Two { return Two {} }
  fn factor(self: &Two) -> i32 { return 2 }
}
impl Scale for Three {
  fn make() -> Three { return Three {} }
  fn factor(self: &Three) -> i32 { return 3 }
}

// The instantiating code is itself generic: only `main` names a concrete type.
fn applied<S: Scale>(value: i32) -> i32 {
  return unsafe silk_test_apply(scaled<S>, value)
}

fn spawned<S: Scale>(scale: S, value: i32) -> i32 {
  let mut packet = Packet<S> { scale: move scale, value: value }
  let erased = unsafe Intrinsic.pointerReinterpret<*mut Packet<S>, *mut u8>(Pointer.fromMutRef(&mut packet))
  let raw = unsafe Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(erased)
  let entry: extern "C" fn(?*mut u8) -> ?*mut u8 = entered<S>
  drop unsafe silk_test_enter(entry, raw)
  return packet.value
}

pub fn main() -> i32 {
  let two: extern "C" fn(i32) -> i32 = scaled<Two>
  let three: extern "C" fn(i32) -> i32 = scaling.scaled<Three>
  if unsafe silk_test_apply(two, 5) != 10 { return 1 }
  if unsafe silk_test_apply(three, 5) != 15 { return 2 }
  if applied<Two>(7) != 14 { return 3 }
  if applied<Three>(7) != 21 { return 4 }
  // One instantiation is one thunk, wherever its address is taken; two are two.
  if unsafe silk_test_same(two, scaled<Two>) != 1 { return 5 }
  if unsafe silk_test_same(two, three) != 0 { return 6 }
  if unsafe silk_test_apply_optional(scaled<Three>, 4) != 12 { return 7 }
  if unsafe silk_test_registered(Registration { visit: scaled<Two>, value: 8 }) != 16 { return 8 }
  if spawned<Two>(Two {}, 9) != 18 { return 9 }
  if spawned<Three>(Three {}, 9) != 27 { return 10 }
  // Silk code calls a generic export as the generic function it is.
  if scaled<Two>(21) != 42 { return 11 }
  return 42
}
