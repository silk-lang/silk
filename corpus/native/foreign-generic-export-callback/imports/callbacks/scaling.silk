import silk.mem.pointer { Pointer }

pub interface Scale {
  fn make() -> Self
  fn factor(self: &Self) -> i32
}

/// A callback written once in a library and specialized for the program's `S`.
pub export "C" fn scaled<S: Scale>(value: i32) -> i32 {
  let scale: S = Scale.make()
  return value * Scale.factor(&scale)
}

pub struct Packet<S> { pub scale: S, pub value: i32 }

/// A thread-entry shaped callback: the userdata pointer carries the generic packet.
pub export "C" fn entered<S: Scale>(raw: ?*mut u8) -> ?*mut u8 {
  let present = unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(raw)
  let packet = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Packet<S>>(present)
  let mut anchor = ()
  let held = unsafe Pointer.borrowMut(&mut anchor, packet)
  held.value = held.value * Scale.factor(&held.scale)
  return raw
}
