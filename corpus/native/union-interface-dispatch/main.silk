import silk.mem.allocator { OutOfMemoryError }
import silk.core.effect { Effect }
import silk.format { Debug, Format, Formatter }
import silk.json.scanner { JsonError, JsonReason }
import silk.option { Option }
import silk.io.writer_native { StdoutWriter }
import silk.io.writer { Writer, WriterError }

// A union takes an interface whose operations receive `self` by reference when every member
// implements it; each call dispatches on the active member (UNION-003).
interface Describe {
  fn describe(self: &Self, scale: i32) -> i32
}

interface Counter {
  fn bump(self: &mut Self, by: i32) -> i32
}

struct Alpha { pub code: i32 }

impl Describe for Alpha {
  fn describe(self: &Self, scale: i32) -> i32 { return self.code * scale }
}

impl Counter for Alpha {
  fn bump(self: &mut Self, by: i32) -> i32 {
    self.code = self.code + by
    return self.code
  }
}

impl Debug for Alpha {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return run Format.debugFields(self, "Alpha", &mut formatter)
  }
}

struct Beta { pub hits: i32 }

impl Describe for Beta {
  fn describe(self: &Self, scale: i32) -> i32 { return 100 + scale }
}

impl Counter for Beta {
  fn bump(self: &mut Self, by: i32) -> i32 {
    self.hits = self.hits + 1
    return self.hits * 10
  }
}

impl Debug for Beta {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return run Format.write(&mut formatter, b"Beta")
  }
}

fn pick(flag: bool) -> Alpha | Beta {
  if flag { return Alpha { code: 7 } }
  return Beta { hits: 0 }
}

fn failure(flag: bool) -> JsonError | OutOfMemoryError {
  if flag { return JsonError.at(JsonReason.UnexpectedByte, 3) }
  return OutOfMemoryError {}
}

fn total<T: Describe>(value: &T) -> i32 { return Describe.describe(value, 2) }

effect fn render() -> () ! WriterError ? &mut Writer {
  run Format.format("{:?} | {:?}\n", &(failure(true), failure(false)))
  run Format.format("{:?} {:?}\n", &(pick(true), pick(false)))
  let nested = Option<JsonError | OutOfMemoryError>.some(failure(false))
  run Format.debug(&nested)
  return run Writer.writeAll(b"\n")
}

effect fn build() -> i32 ! WriterError {
  let mut writer = StdoutWriter.make()
  run render() |> Effect.provideMut<Writer>(&mut writer)
  // 14 + 102
  let generic = total(&pick(true)) + total(&pick(false))
  // 21
  let direct = Describe.describe(&pick(true), 3)
  // 28 + 104, through method syntax on the union
  let chosen = pick(true)
  let other = pick(false)
  let method = chosen.describe(4) + other.describe(4)
  let mut first = pick(true)
  let mut second = pick(false)
  // 12 + 13 + 10, then 14 + 20 through method syntax
  let counted = Counter.bump(&mut first, 5) + Counter.bump(&mut first, 1) + Counter.bump(&mut second, 1)
  let bumped = first.bump(1) + second.bump(1)
  if generic != 116 || direct != 21 || method != 132 || counted != 35 || bumped != 34 { return 1 }
  return 42
}

effect fn recover(error: WriterError) -> i32 { return 2 }

pub fn main() -> i32 { return run Effect.catchAll(build(), recover) }
