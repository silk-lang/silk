import silk.collections.column_list { ColumnList }
import silk.core.effect { Effect }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u64

struct Sample {
  pub at: u64,
  pub level: f32,
  pub channel: u16,
  pub clipped: bool,
}

impl Copy for Sample {}

// A list that grows past the size where the system gives storage pages of its own keeps every row
// (the growth rule of `List`, for columns).
effect fn build() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let mut samples = ColumnList<Sample>.make()
  let mut at: u64 = 0
  while at < 200000 {
    run samples.append(Sample { at, level: 0.5, channel: u64.wrappingToU16(at), clipped: u64.remainder(at, 3) == 0 })
    at = at + 1
  }
  if samples.length() != 200000 || samples.capacity() < 200000 { return 1 }
  let mut index: usize = 0
  let mut expected: u64 = 0
  while index < samples.length() {
    if samples[index].at != expected || samples[index].channel != u64.wrappingToU16(expected) { return 2 }
    if samples[index].clipped != (u64.remainder(expected, 3) == 0) || samples[index].level != 0.5 { return 3 }
    index = index + 1
    expected = expected + 1
  }
  // An exact capacity is exact at any size.
  run samples.shrinkToFit()
  if samples.capacity() != 200000 || samples[199999].at != 199999 { return 4 }
  run samples.reserveExact(1)
  if samples.capacity() != 200001 || samples[100000].at != 100000 { return 5 }
  return 42
}

effect fn recover(error: OutOfMemoryError) -> i32 { return 99 }

pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(build() |> Effect.provideMut<Allocator>(&mut allocator), recover)
}
