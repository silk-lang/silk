  let mut reads = Vector<MemoryReadEvent>.make()
  run Vector<MemoryReadEvent>.append(&mut reads, MemoryReadEvent.Data {
    readyAt: SystemClock.make(100, 0),
    bytes: move first,
  })
  run Vector<MemoryReadEvent>.append(&mut reads, MemoryReadEvent.Data {
    readyAt: SystemClock.make(100, 0),
    bytes: move second,
  })
  run Vector<MemoryReadEvent>.append(&mut reads, MemoryReadEvent.Data {
    readyAt: SystemClock.make(100, 0),
    bytes: move third,
