import silk.num.i32
import silk.num.usize

struct Flags {
  values: [i32; 513],
  flags: [bool; 513],
  marks: [u8; 40],
  signs: [i8; 7],
  top: usize,
}

@inlineNever
fn make() -> Flags {
  return Flags { values: [0; 513], flags: [false; 513], marks: [255; 40], signs: [-1; 7], top: 0 }
}

@inlineNever
fn lit() -> [bool; 9] {
  return [true; 9]
}

pub fn main() -> i32 {
  let f = make()
  let t = lit()
  if !t[8] || f.marks[39] != 255 || f.signs[6] != -1 { return 3 }
  return usize.toI32(f.top) + (if f.flags[3] { 1 } else { 0 }) + f.values[7] + 42
}
