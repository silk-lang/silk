static if (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText("libc") == "gnu") {
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.platform.native.file {
  CopyMethod,
  DirectoryEntry,
  EntryKind,
  NativeFile,
  NativeFileError,
  NativeFileOperation,
  OPEN_CREATE,
  OPEN_EXCLUSIVE,
  OPEN_READ_ONLY,
  OPEN_READ_WRITE,
  OPEN_WRITE_ONLY,
  OPEN_TRUNCATE,
  Timestamp,
  TYPE_DIRECTORY,
  TYPE_FILE,
  TYPE_MASK,
  TYPE_SYMBOLIC_LINK,
}

struct Paths {
  bytes: [u8; 1024],
  root: usize,
}

impl Paths {
  // Writes the root, a slash, and `name` at `slot * 128`, and returns the length.
  fn place(self: &mut Self, slot: usize, name: &[u8]) -> usize {
    let start = slot * 128
    let mut index: usize = 0
    while index < self.root {
      self.bytes[start + index] = self.bytes[index]
      index = index + 1
    }
    self.bytes[start + index] = 47
    index = index + 1
    let mut offset: usize = 0
    while offset < name.length {
      self.bytes[start + index + offset] = name[offset]
      offset = offset + 1
    }
    return index + offset
  }
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut index: usize = 0
  while index < left.length {
    if left[index] != right[index] { return false }
    index = index + 1
  }
  return true
}

fn failureCode(result: Result<(), NativeFileError>) -> i32 {
  return match move result {
    Result<(), NativeFileError>.Success { .. } => 0
    Result<(), NativeFileError>.Failure { error } => error.code
  }
}

effect fn removeQuietly(path: &[u8]) -> () {
  let _ignored = run Effect.result(NativeFile.remove(path))
  return ()
}

effect fn scatter(fd: i32, head: &mut [u8], tail: &mut [u8]) -> usize ! NativeFileError {
  let mut parts: [&mut [u8]; 2] = [move head, move tail]
  return run NativeFile.readScatter(fd, &mut parts, Option<u64>.some(0))
}

effect fn check(paths: &mut Paths) -> i32 ! NativeFileError {
  let fileLength = paths.place(1, b"data")
  let copyLength = paths.place(2, b"copy")
  let linkLength = paths.place(3, b"link")
  let hardLength = paths.place(4, b"hard")
  let movedLength = paths.place(5, b"moved")
  let innerLength = paths.place(6, b"inner")
  let root = Slice.view<u8>(&paths.bytes, 0, paths.root)
  let file = Slice.view<u8>(&paths.bytes, 128, fileLength)
  let copied = Slice.view<u8>(&paths.bytes, 256, copyLength)
  let link = Slice.view<u8>(&paths.bytes, 384, linkLength)
  let hard = Slice.view<u8>(&paths.bytes, 512, hardLength)
  let moved = Slice.view<u8>(&paths.bytes, 640, movedLength)
  let inner = Slice.view<u8>(&paths.bytes, 768, innerLength)

  // Positioned and sequential reads and writes.
  let fd = run NativeFile.open(file, OPEN_READ_WRITE | OPEN_CREATE | OPEN_EXCLUSIVE, 420)
  if (run NativeFile.write(fd, b"hello world", Option<u64>.none())) != 11 { return 1 }
  if (run NativeFile.write(fd, b"W", Option<u64>.some(6))) != 1 { return 2 }
  let mut head: [u8; 5] = [0; 5]
  let mut tail: [u8; 6] = [0; 6]
  if (run scatter(fd, &mut head, &mut tail)) != 11 { return 3 }
  if !same(&head, b"hello") || !same(&tail, b" World") { return 4 }
  let gathered: [&[u8]; 2] = [b"ab", b"cd"]
  if (run NativeFile.writeGather(fd, &gathered, Option<u64>.none())) != 4 { return 5 }
  run NativeFile.synchronize(fd, true)
  run NativeFile.synchronize(fd, false)
  let opened = run NativeFile.statusOf(fd)
  if opened.size != 15 || (opened.mode & TYPE_MASK) != TYPE_FILE { return 6 }
  run NativeFile.truncateOf(fd, 5)
  run NativeFile.changeModeOf(fd, 384)
  run NativeFile.setTimesOf(fd, Timestamp { seconds: 1000, nanoseconds: 5 }, Timestamp { seconds: 2000, nanoseconds: 7 })
  let changed = run NativeFile.statusOf(fd)
  if changed.size != 5 || (changed.mode & 4095) != 384 { return 7 }
  if changed.modified.seconds != 2000 || changed.accessed.seconds != 1000 { return 8 }
  run NativeFile.changeOwnerOf(fd, changed.user, changed.group)
  run NativeFile.close(fd)
  if failureCode(run Effect.result(NativeFile.close(fd))) != 9 { return 9 }

  // Path operations.
  run NativeFile.truncate(file, 3)
  run NativeFile.changeMode(file, 420, true)
  run NativeFile.changeOwner(file, changed.user, changed.group, true)
  run NativeFile.setTimes(file, Timestamp { seconds: 3000, nanoseconds: 0 }, Timestamp { seconds: 4000, nanoseconds: 0 }, true)
  let status = run NativeFile.status(file, true)
  if status.size != 3 || status.modified.seconds != 4000 || status.links != 1 { return 10 }
  run NativeFile.access(file, 4)
  run NativeFile.link(file, hard)
  if (run NativeFile.status(file, true)).links != 2 { return 11 }
  run NativeFile.symbolicLink(b"data", link)
  if ((run NativeFile.status(link, false)).mode & TYPE_MASK) != TYPE_SYMBOLIC_LINK { return 12 }
  if (run NativeFile.status(link, true)).inode != status.inode { return 13 }
  let mut target: [u8; 64] = [0; 64]
  let targetLength = run NativeFile.readLink(link, &mut target)
  if !same(Slice.view<u8>(&target, 0, targetLength), b"data") { return 14 }
  let mut resolved: [u8; 4096] = [0; 4096]
  let resolvedLength = run NativeFile.realPath(link, &mut resolved)
  let resolvedPath = Slice.view<u8>(&resolved, 0, resolvedLength)
  if (run NativeFile.status(resolvedPath, true)).inode != status.inode { return 15 }

  // Copies.
  run NativeFile.copy(file, copied, true, CopyMethod.CloneOrBytes)
  if failureCode(run Effect.result(NativeFile.copy(file, copied, true, CopyMethod.Bytes))) != 17 { return 16 }
  run NativeFile.copy(file, copied, false, CopyMethod.Bytes)
  let reader = run NativeFile.open(copied, OPEN_READ_ONLY, 0)
  let mut copy: [u8; 8] = [0; 8]
  let copyRead = run NativeFile.read(reader, &mut copy, Option<u64>.none())
  run NativeFile.close(reader)
  if !same(Slice.view<u8>(&copy, 0, copyRead), b"hel") { return 17 }

  run NativeFile.rename(hard, moved)
  if failureCode(run Effect.result(NativeFile.access(hard, 0))) != 2 { return 18 }
  run NativeFile.makeDirectory(inner, 493)
  if ((run NativeFile.status(inner, true)).mode & TYPE_MASK) != TYPE_DIRECTORY { return 19 }
  if failureCode(run Effect.result(NativeFile.makeDirectory(inner, 493))) != 17 { return 20 }
  let volume = run NativeFile.volumeStatus(root)
  if volume.blockSize == 0 || volume.blocks == 0 { return 21 }

  // Listing.
  let mut listing = run NativeFile.openDirectory(root)
  let mut name: [u8; 1024] = [0; 1024]
  let mut seen: u32 = 0
  let mut count: u32 = 0
  let mut more = true
  while more {
    match run listing.next(&mut name) {
      Option<DirectoryEntry>.Some { value } => {
        count = count + 1
        let entryName = Slice.view<u8>(&name, 0, value.length)
        if same(entryName, b"data") && value.kind == EntryKind.File { seen = seen | 1 }
        if same(entryName, b"link") && value.kind == EntryKind.SymbolicLink { seen = seen | 2 }
        if same(entryName, b"inner") && value.kind == EntryKind.Directory { seen = seen | 4 }
      }
      Option<DirectoryEntry>.None => { more = false }
    }
  }
  run listing.close()
  if seen != 7 || count != 7 { return 22 }

  // Writing to a read-only descriptor fails with EBADF.
  let readOnly = run NativeFile.open(file, OPEN_READ_ONLY, 0)
  let refused = run Effect.result(NativeFile.write(readOnly, b"x", Option<u64>.none()))
  run NativeFile.close(readOnly)
  match move refused {
    Result<usize, NativeFileError>.Success { .. } => { return 23 }
    Result<usize, NativeFileError>.Failure { error } => {
      if error.code != 9 || error.operation != NativeFileOperation.Write { return 24 }
    }
  }
  let truncating = run NativeFile.open(copied, OPEN_WRITE_ONLY | OPEN_TRUNCATE, 0)
  run NativeFile.close(truncating)
  if (run NativeFile.status(copied, true)).size != 0 { return 25 }

  run NativeFile.removeDirectory(inner)
  run NativeFile.remove(moved)
  run NativeFile.remove(link)
  run NativeFile.remove(copied)
  run NativeFile.remove(file)
  if failureCode(run Effect.result(NativeFile.remove(file))) != 2 { return 26 }
  return 42
}

effect fn program() -> i32 ! NativeFileError {
  let mut paths = Paths { bytes: [0; 1024], root: 0 }
  paths.root = run NativeFile.makeTemporaryDirectory(b"/tmp/silk-native-file-XXXXXX", &mut paths.bytes)
  let outcome = run Effect.result(check(&mut paths))
  run NativeFile.removeDirectory(Slice.view<u8>(&paths.bytes, 0, paths.root))
  return match move outcome {
    Result<i32, NativeFileError>.Success { value } => value
    Result<i32, NativeFileError>.Failure { error } => 100 + error.code
  }
}

pub effect fn main() -> i32 {
  return match run Effect.result(program()) {
    Result<i32, NativeFileError>.Success { value } => value
    Result<i32, NativeFileError>.Failure { error } => 200 + error.code
  }
}
} else {
pub fn main() -> i32 { return 42 }
}
