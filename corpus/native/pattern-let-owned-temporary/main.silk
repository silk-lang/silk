struct P {
  x: i32
  y: i32
}
union Shape {
  Circle { r: i32 },
  Square { side: i32 },
}
fn make(x: i32) -> P { return P { x: x, y: 2 } }
fn square(side: i32) -> Shape { return Shape.Square { side: side } }
pub fn main() -> i32 {
  let P { x, y } = P { x: 30, y: 2 }
  let P { x: a, .. } = make(8)
  if let Shape.Circle { r } = square(5) { return r }
  if let Shape.Square { side } = square(2) {
    return x + y + a + side
  }
  return 1
}
