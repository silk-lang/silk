import silk.mem.allocator { Allocator, OutOfMemoryError, SystemAllocator }
import silk.mem.arena { Arena, ArenaOptions }
import silk.mem.box { Box }
import silk.core.effect { Effect }
import silk.num.i64
import silk.mem.layout { Layout }
import silk.collections.list { List }

// A child that gives out a fixed number of chunks from the system allocator, then refuses.
struct Quota { remaining: usize, system: SystemAllocator }

effect fn allocate(self: &mut Quota, layout: Layout) -> Intrinsic.Allocation ! OutOfMemoryError {
  if self.remaining == 0 { fail OutOfMemoryError {} }
  self.remaining = self.remaining - 1
  return run Allocator.allocate(move layout) |> Effect.provideMut<Allocator>(&mut self.system)
}

impl Allocator for Quota { allocate: Quota.allocate }

// An arena whose chunks come from another arena, which takes its own chunks from a quota.
effect fn nested() -> i32 ! OutOfMemoryError {
  let quota = Quota { remaining: 64, system: Allocator.systemAllocatorProvider() }
  let outer = Arena.withOptions(move quota, ArenaOptions { firstChunkBytes: 4096, maximumChunkBytes: 4096 })
  let mut inner = Arena.withOptions(move outer, ArenaOptions { firstChunkBytes: 256, maximumChunkBytes: 1024 })
  let first = run Box<i64>.make(12) |> Effect.provideMut<Allocator>(&mut inner)
  let mut values = List<i64>.make()
  let mut at: i64 = 0
  while at < 200 {
    run List<i64>.append(&mut values, at) |> Effect.provideMut<Allocator>(&mut inner)
    at = at + 1
  }
  drop inner
  // Both arenas are gone; the list and the box still own their chunks.
  let sum = List<i64>.get(&values, 199) - List<i64>.get(&values, 189) + first.get()[0]
  return i64.toI32(sum)
}

// The quota refuses the third chunk, and the request that needed it fails.
effect fn refused() -> i32 ! OutOfMemoryError {
  let quota = Quota { remaining: 2, system: Allocator.systemAllocatorProvider() }
  let mut arena = Arena.withOptions(move quota, ArenaOptions { firstChunkBytes: 256, maximumChunkBytes: 256 })
  let mut values = List<i64>.make()
  let mut at: i64 = 0
  while at < 1000 {
    run List<i64>.append(&mut values, at) |> Effect.provideMut<Allocator>(&mut arena)
    at = at + 1
  }
  return 1
}

effect fn recoverNested(error: OutOfMemoryError) -> i32 { return 2 }
effect fn recoverRefused(error: OutOfMemoryError) -> i32 { return 20 }

pub fn main() -> i32 {
  let built = run Effect.catchAll(nested(), recoverNested)
  let failed = run Effect.catchAll(refused(), recoverRefused)
  return built + failed
}
