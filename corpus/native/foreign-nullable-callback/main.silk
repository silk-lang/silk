import silk.mem.pointer {Pointer}

// A C callback slot that may hold NULL, as in the callback-info structs of `webgpu.h`.
type Optional = ?extern "C" fn(u32, *mut u32) -> ()

extern "C" struct CallbackInfo {
  nextInChain: ?*mut u8,
  callback: ?extern "C" fn(u32, *mut u32) -> (),
  userdata: *mut u32,
}

@callbacks("info.callback")
unsafe extern "C" fn c_invoke(info: CallbackInfo) -> i32
@callbacks("optional")
unsafe extern "C" fn c_maybe(optional: Optional, userdata: *mut u32) -> i32

export "C" fn s_add(status: u32, userdata: *mut u32) -> () {
  unsafe { Pointer.write(userdata, Pointer.read(userdata) + status) }
}

// Refines a nullable address before calling it; a `?extern "C" fn` is never called directly.
fn invokeOptional(callback: Optional, userdata: *mut u32) -> bool {
  if Intrinsic.pointerIsNull<Optional>(callback) { return false }
  let present = unsafe Intrinsic.pointerRequalify<Optional, extern "C" fn(u32, *mut u32) -> ()>(callback)
  unsafe present(5, userdata)
  return true
}

pub fn main() -> i32 {
  let mut received: u32 = 0
  let userdata = Pointer.fromMutRef(&mut received)
  let none = Intrinsic.pointerNullFunction<Optional>()
  if !Intrinsic.pointerIsNull<Optional>(none) { return 1 }
  if unsafe c_invoke(CallbackInfo {nextInChain: Pointer.null<u8>(), callback: none, userdata: userdata}) != 0 { return 2 }
  if unsafe c_invoke(CallbackInfo {nextInChain: Pointer.null<u8>(), callback: s_add, userdata: userdata}) != 1 || received != 7 { return 3 }
  let direct: extern "C" fn(u32, *mut u32) -> () = s_add
  if unsafe c_maybe(direct, userdata) != 1 || received != 18 { return 4 }
  if unsafe c_maybe(none, userdata) != 0 || received != 18 { return 5 }
  if unsafe c_invoke(CallbackInfo {nextInChain: Pointer.null<u8>(), callback: direct, userdata: userdata}) != 1 || received != 25 { return 6 }
  if invokeOptional(none, userdata) || received != 25 { return 7 }
  if !invokeOptional(direct, userdata) || received != 30 { return 8 }
  return 0
}
