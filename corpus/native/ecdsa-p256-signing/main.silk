// RFC 6979 A.2.5: deterministic ECDSA P-256 with SHA-256 over "sample", with and without the
// precomputed signing key, verified with the public key.
import silk.crypto.p256 { EcdsaP256Sha256, P256, P256SigningKey }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }
import silk.num.usize

fn matches(signature: &[u8; 72], length: usize) -> bool {
  let expected: [u8; 71] = [48, 69, 2, 33, 0, 239, 212, 139, 42, 172, 182, 168, 253, 17, 64, 221, 156, 212, 94, 129, 214, 157, 44, 135, 123, 86, 170, 249, 145, 195, 77, 14, 168, 78, 175, 55, 22, 2, 32, 8, 52, 227, 106, 210, 154, 131, 191, 43, 201, 56, 94, 73, 29, 96, 153, 200, 253, 249, 209, 237, 103, 170, 126, 165, 245, 31, 147, 120, 40, 87, 169]
  if length != 71 { return false }
  let mut i: usize = 0
  while i < length {
    if signature[i] != expected[i] { return false }
    i = i + 1
  }
  return true
}

effect fn program() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let secret: [u8; 32] = [201, 175, 169, 216, 69, 186, 117, 22, 107, 92, 33, 87, 103, 177, 214, 147, 78, 80, 195, 219, 54, 232, 155, 18, 123, 138, 98, 43, 18, 15, 103, 33]
  let key = match P256.fromBytes(&secret) {
    Result.Success { value } => move value
    Result.Failure { error } => { drop error return 1 }
  }
  let publicKey = key.publicKey()
  let mut signature: [u8; 72] = [0; 72]
  let length = match EcdsaP256Sha256.sign(&secret, String.utf8Bytes("sample"), &mut signature) {
    Result.Success { value } => value
    Result.Failure { error } => { drop error return 2 }
  }
  if !matches(&signature, length) { return 3 }
  let signingKey = run P256SigningKey.make(&key)
  let mut again: [u8; 72] = [0; 72]
  let fast = match signingKey.sign(String.utf8Bytes("sample"), &mut again) {
    Result.Success { value } => value
    Result.Failure { error } => { drop error return 4 }
  }
  if !matches(&again, fast) { return 5 }
  return match EcdsaP256Sha256.verify(&publicKey, String.utf8Bytes("sample"), Slice.view<u8>(&again, 0, fast)) {
    Result.Success { value: _ } => 42
    Result.Failure { error } => { drop error 6 }
  }
}

effect fn failed<E>(error: E) -> i32 { drop error return 7 }

pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(program(), failed) |> Effect.provideMut<Allocator>(&mut allocator)
}
