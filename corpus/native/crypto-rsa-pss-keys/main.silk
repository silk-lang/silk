import silk.core.option { Option }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.crypto.rsa {
  RsaError,
  RsaPrivateKey,
  RsaPssHash,
  RsaPssPrivateKey,
  RsaPssPublicKey,
  RsaPssRestrictions,
  RsaPublicKey,
}

fn equal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut i: usize = 0
  while i < left.length {
    if left[i] != right[i] {
      return false
    }
    i = i + 1
  }
  return true
}

// Checks the parameters of a key: `hash` is 7 for a key without parameters.
fn restricted(restrictions: &Option<RsaPssRestrictions>, hash: RsaPssHash, maskHash: RsaPssHash, saltLength: u32) -> bool {
  return match &restrictions.* {
    Option<RsaPssRestrictions>.None => false
    Option<RsaPssRestrictions>.Some { value } => value.hash == hash && value.maskHash == maskHash && value.saltLength == saltLength
  }
}

fn unrestricted(restrictions: &Option<RsaPssRestrictions>) -> bool {
  return match &restrictions.* {
    Option<RsaPssRestrictions>.None => true
    Option<RsaPssRestrictions>.Some { .. } => false
  }
}

fn readPrivate(der: &[u8]) -> Option<RsaPssPrivateKey> {
  return match RsaPssPrivateKey.fromPkcs8Der(der) {
    Result<RsaPssPrivateKey, RsaError>.Success { value } => Option<RsaPssPrivateKey>.some(move value)
    Result<RsaPssPrivateKey, RsaError>.Failure { error: _ } => Option<RsaPssPrivateKey>.none()
  }
}

// Reads the private key, writes it back, and writes its public half, which must give `pkcs8` and
// `spki`. Reading `spki` must give the same parameters.
fn roundTrip(pkcs8: &[u8], spki: &[u8]) -> i32 {
  let mut buffer: [u8; 2048] = [0; 2048]
  let key = match RsaPssPrivateKey.fromPkcs8Der(pkcs8) {
    Result<RsaPssPrivateKey, RsaError>.Success { value } => move value
    Result<RsaPssPrivateKey, RsaError>.Failure { error: _ } => {
      return 1
    }
  }
  if key.pkcs8DerLength() != pkcs8.length {
    return 2
  }
  match key.writePkcs8Der(&mut buffer) {
    Result<usize, RsaError>.Success { value } => {
      if !equal(Slice.view<u8>(&buffer, 0, value), pkcs8) {
        return 3
      }
    }
    Result<usize, RsaError>.Failure { error: _ } => {
      return 3
    }
  }
  let public = key.publicKey()
  if public.spkiDerLength() != spki.length {
    return 4
  }
  match public.writeSpkiDer(&mut buffer) {
    Result<usize, RsaError>.Success { value } => {
      if !equal(Slice.view<u8>(&buffer, 0, value), spki) {
        return 5
      }
    }
    Result<usize, RsaError>.Failure { error: _ } => {
      return 5
    }
  }
  let read = match RsaPssPublicKey.fromSpkiDer(spki) {
    Result<RsaPssPublicKey, RsaError>.Success { value } => move value
    Result<RsaPssPublicKey, RsaError>.Failure { error: _ } => {
      return 6
    }
  }
  if read.key.byteLength() != key.key.publicKey().byteLength() {
    return 7
  }
  let same = match &read.restrictions {
    Option<RsaPssRestrictions>.None => unrestricted(&key.restrictions)
    Option<RsaPssRestrictions>.Some { value } => restricted(&key.restrictions, value.hash, value.maskHash, value.saltLength)
  }
  if !same {
    return 8
  }
  let shortLength = spki.length - 1
  match read.writeSpkiDer(Slice.viewMut<u8>(&mut buffer, 0, shortLength)) {
    Result<usize, RsaError>.Failure { error: RsaError.InvalidLength } => {}
    _ => {
      return 9
    }
  }
  return 0
}

fn privateFails(der: &[u8], expected: RsaError) -> bool {
  return match RsaPssPrivateKey.fromPkcs8Der(der) {
    Result<RsaPssPrivateKey, RsaError>.Success { .. } => false
    Result<RsaPssPrivateKey, RsaError>.Failure { error } => error == expected
  }
}

// Reads `der`, checks its parameters, and writes it back, which must give `canonical`.
fn rewrites(der: &[u8], canonical: &[u8], hash: RsaPssHash, maskHash: RsaPssHash, saltLength: u32) -> bool {
  let mut buffer: [u8; 2048] = [0; 2048]
  let key = match RsaPssPrivateKey.fromPkcs8Der(der) {
    Result<RsaPssPrivateKey, RsaError>.Success { value } => move value
    Result<RsaPssPrivateKey, RsaError>.Failure { error: _ } => {
      return false
    }
  }
  if !restricted(&key.restrictions, hash, maskHash, saltLength) {
    return false
  }
  return match key.writePkcs8Der(&mut buffer) {
    Result<usize, RsaError>.Success { value } => equal(Slice.view<u8>(&buffer, 0, value), canonical)
    Result<usize, RsaError>.Failure { error: _ } => false
  }
}

