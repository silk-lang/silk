// Compiler fixture: alternate owner pressure evidence, not a canonical Coroutine API.
import silk.mem.allocator { Allocator as StoragePolicy, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.concurrency.execution { Execution as ExecutionFacade, Wake }
import silk.mem.shared { Shared }

struct Empty {}
struct Yielded { value: i32, wake: Wake }
struct ChannelState {
  slot: Empty | Yielded,
  ready: i32,
  notifications: i32,
}
struct ChannelToken {}

fn install(self: &mut ChannelState, wake: Wake, value: i32) -> () {
  let previous = Intrinsic.replace(self.slot, Yielded { value: value, wake: move wake })
  drop previous
  self.ready = 0
  return ()
}

fn takeYield(self: &mut ChannelState) -> Empty | Yielded {
  return Intrinsic.replace(self.slot, Empty {})
}

fn markReady(self: &mut ChannelState) -> () {
  self.ready = 1
  self.notifications = self.notifications + 1
  return ()
}

fn readReady(self: &ChannelState) -> i32 { return self.ready }
fn readNotifications(self: &ChannelState) -> i32 { return self.notifications }

fn register(
  wake: Wake,
  port: Shared<ChannelState>,
  value: i32,
) -> ChannelToken {
  let installed = Shared.withMut(&port, install(move wake, value))
  drop port
  return ChannelToken {}
}

effect fn yieldValue(port: Shared<ChannelState>, value: i32) -> () {
  let registration = register(move port, value)
  return run ExecutionFacade.park(move registration)
}

effect fn body(port: Shared<ChannelState>) -> i32 {
  let first = Shared<ChannelState>.clone(&port)
  run yieldValue(move first, 1)
  let second = Shared<ChannelState>.clone(&port)
  run yieldValue(move second, 2)
  drop port
  return 3
}

fn ready(port: &Shared<ChannelState>) -> () {
  return Shared.withMut(port, markReady)
}

struct Stored { execution: Intrinsic.Execution<i32> }
struct Controller {
  slot: Empty | Stored,
  order: i32,
  result: i32,
}

fn complete(owner: &mut Controller, result: i32) -> () {
  owner.result = result
  return ()
}

fn suspend(owner: &mut Controller, execution: Intrinsic.Execution<i32>) -> () {
  let previous = Intrinsic.replace(owner.slot, Stored { execution: move execution })
  drop previous
  return ()
}

effect fn drive(execution: Intrinsic.Execution<i32>, owner: &mut Controller) -> () {
  return run ExecutionFacade.drive(move execution, move owner, complete, suspend)
}

effect fn driveStored(selected: Empty | Stored, owner: &mut Controller) -> () {
  return match move selected {
    Empty {} => ()
    Stored { execution } => run drive(move execution, move owner)
  }
}

effect fn resumeYield(value: i32, wake: Wake, owner: &mut Controller) -> () {
  owner.order = owner.order * 10 + value
  ExecutionFacade.wake(move wake)
  let execution = Intrinsic.replace(owner.slot, Empty {})
  return run driveStored(move execution, move owner)
}

effect fn resumeSelected(selected: Empty | Yielded, owner: &mut Controller) -> () {
  return match move selected {
    Empty {} => ()
    Yielded { value, wake } => run resumeYield(value, move wake, move owner)
  }
}

effect fn advancePort(port: &Shared<ChannelState>, owner: &mut Controller) -> () {
  let selected = Shared.withMut(port, takeYield)
  return run resumeSelected(move selected, move owner)
}

fn consumeLate(selected: Empty | Yielded) -> () {
  return match move selected {
    Empty {} => ()
    Yielded { value, wake } => ExecutionFacade.wake(move wake)
  }
}

effect fn program() -> i32 ! OutOfMemoryError {
  let mut allocator = StoragePolicy.systemAllocatorProvider()
  let port = run Shared<ChannelState>.make(ChannelState {
    slot: Empty {},
    ready: 0,
    notifications: 0,
  }) |> Effect.provideMut<StoragePolicy>(&mut allocator)
  let bodyPort = Shared<ChannelState>.clone(&port)
  let endpoint = Shared<ChannelState>.clone(&port)
  let execution = run ExecutionFacade.make(body(move bodyPort), move endpoint, ready)
    |> Effect.provideMut<StoragePolicy>(&mut allocator)
  let mut owner = Controller { slot: Empty {}, order: 0, result: 0 }
  run drive(move execution, &mut owner)
  run advancePort(&port, &mut owner)
  run advancePort(&port, &mut owner)
  let notifications = Shared<ChannelState>.with<i32>(&port, readNotifications)
  let result = owner.order * 10 + owner.result
  drop owner
  drop port

  let cancelledPort = run Shared<ChannelState>.make(ChannelState {
    slot: Empty {},
    ready: 0,
    notifications: 0,
  }) |> Effect.provideMut<StoragePolicy>(&mut allocator)
  let cancelledBodyPort = Shared<ChannelState>.clone(&cancelledPort)
  let cancelledEndpoint = Shared<ChannelState>.clone(&cancelledPort)
  let cancelled = run ExecutionFacade.make(body(move cancelledBodyPort), move cancelledEndpoint, ready)
    |> Effect.provideMut<StoragePolicy>(&mut allocator)
  let mut cancelledOwner = Controller { slot: Empty {}, order: 0, result: 0 }
  run drive(move cancelled, &mut cancelledOwner)
  let dormant = Intrinsic.replace(cancelledOwner.slot, Empty {})
  drop dormant
  let beforeLate = Shared<ChannelState>.with<i32>(&cancelledPort, readNotifications)
  let late = Shared.withMut(&cancelledPort, takeYield)
  consumeLate(move late)
  let cancelledNotifications = Shared<ChannelState>.with<i32>(&cancelledPort, readNotifications)
  drop cancelledOwner
  drop cancelledPort
  if notifications != 2 { return -1 }
  if beforeLate != 0 { return -3 }
  if cancelledNotifications != 0 { return -2 }
  return result
}

effect fn recover(error: OutOfMemoryError) -> i32 { return -100 }
pub fn main() -> i32 { return run Effect.catchAll(program(), recover) }
