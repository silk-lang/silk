import silk.core.ownership {Copy}
import silk.mem.pointer {Pointer}

// The lifetime ties a borrowed C handle to the bytes it points into. It has no representation,
// so the record keeps the C layout of its fields.
extern "C" struct BufferRef<'a> {
  data: ?[*]const u8,
  length: usize,
}
impl<'a> Copy for BufferRef<'a> {}

extern "C" struct Descriptor<'a> {
  label: BufferRef<'a>,
  count: u32,
}
impl<'a> Copy for Descriptor<'a> {}

fn borrowBytes<'a>(bytes: &'a [u8]) -> BufferRef<'a> {
  return BufferRef<'a> {data: Pointer.fromSlice<u8>(bytes), length: bytes.length}
}

unsafe extern "C" fn c_sum(descriptor: Descriptor) -> u32
unsafe extern "C" fn c_sum_at(descriptor: *const Descriptor) -> u32

pub fn main() -> i32 {
  let bytes: [u8; 4] = [1, 2, 3, 4]
  let descriptor = Descriptor {label: borrowBytes(&bytes), count: 2}
  if descriptor.label.length != 4 { return 1 }
  if unsafe c_sum(descriptor) != 20 { return 2 }
  if unsafe c_sum_at(Pointer.fromRef<Descriptor>(&descriptor)) != 21 { return 3 }
  return 0
}
