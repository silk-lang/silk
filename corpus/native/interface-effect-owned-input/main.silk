// An interface `effect fn` operation that takes an owned generic input, through a bound.
interface App<M> {
  effect fn update(self: &mut Self, message: M) -> ()
}

interface Perform {
  effect fn perform(self: Self) -> i32
}

struct Model { count: i32 }

impl App<i32> for Model {
  effect fn update(self: &mut Self, message: i32) -> () {
    self.count = self.count + message
  }
}

struct Command { value: i32 }

impl Perform for Command {
  effect fn perform(self: Self) -> i32 { return self.value }
}

effect fn step<A: App<M>, M>(model: &mut A, message: M) -> () {
  run model.update(move message)
}

effect fn performed<C: Perform>(command: C) -> i32 {
  return run command.perform()
}

pub effect fn main() -> i32 {
  let mut model = Model { count: 0 }
  run step(&mut model, 30)
  return model.count + run performed(Command { value: 12 })
}
