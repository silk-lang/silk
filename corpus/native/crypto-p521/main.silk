import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.crypto.p521 { EcdsaP521, EcdsaP521Sha512, P521, P521Error, P521SignatureError }
import silk.crypto.ec_key { EcCurve, EcKeyDer, EcKeyError, EcPrivateKeyDer, EcPublicKeyDer }
import silk.crypto.sha2 { Sha256, Sha384, Sha512 }

fn equal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut i: usize = 0
  while i < left.length {
    if left[i] != right[i] {
      return false
    }
    i = i + 1
  }
  return true
}

fn key(secret: &[u8]) -> P521 {
  return match P521.fromBytes(secret) {
    Result<P521, P521Error>.Success { value } => move value
    Result<P521, P521Error>.Failure { error: _ } => {
      Intrinsic.trap("bad secret")
    }
  }
}

fn verified(result: Result<(), P521SignatureError>) -> bool {
  return match move result {
    Result<(), P521SignatureError>.Success { .. } => true
    Result<(), P521SignatureError>.Failure { error: _ } => false
  }
}

fn mismatched(result: Result<(), P521SignatureError>) -> bool {
  return match move result {
    Result<(), P521SignatureError>.Failure { error: P521SignatureError.AuthenticationFailed } => true
    _ => false
  }
}

// Checks the key, its public forms, deterministic signatures with three hashes, the DER form, and
// a signature that another program made with a random nonce.
fn keyCase(
  secret: &[u8],
  publicKey: &[u8],
  compressed: &[u8],
  message: &[u8],
  sha512: &[u8],
  sha256: &[u8],
  sha384: &[u8],
  der512: &[u8],
  random512: &[u8],
  random256: &[u8],
) -> i32 {
  let signer = key(secret)
  if !equal(&signer.publicKey(), publicKey) {
    return 1
  }
  match P521.compressPublicKey(publicKey) {
    Result<[u8; 67], P521Error>.Success { value } => {
      if !equal(&value, compressed) {
        return 2
      }
    }
    Result<[u8; 67], P521Error>.Failure { error: _ } => {
      return 2
    }
  }
  match P521.decompressPublicKey(compressed) {
    Result<[u8; 133], P521Error>.Success { value } => {
      if !equal(&value, publicKey) {
        return 3
      }
    }
    Result<[u8; 133], P521Error>.Failure { error: _ } => {
      return 3
    }
  }
  let signed512 = signer.sign<Sha512>(message)
  if !equal(&signed512, sha512) {
    return 4
  }
  if !equal(&signer.sign<Sha256>(message), sha256) || !equal(&signer.sign<Sha384>(message), sha384) {
    return 5
  }
  let mut der: [u8; 139] = [0; 139]
  let length = EcdsaP521.toDer(sha512, &mut der)
  if !equal(Slice.view<u8>(&der, 0, length), der512) {
    return 6
  }
  match EcdsaP521.fromDer(der512) {
    Result<[u8; 132], P521SignatureError>.Success { value } => {
      if !equal(&value, sha512) {
        return 7
      }
    }
    Result<[u8; 132], P521SignatureError>.Failure { error: _ } => {
      return 7
    }
  }
  if !verified(EcdsaP521Sha512.verify(publicKey, message, der512))
    || !verified(EcdsaP521Sha512.verify(publicKey, message, random512)) {
    return 8
  }
  if !verified(EcdsaP521.verify<Sha256>(publicKey, message, sha256))
    || !verified(EcdsaP521.verify<Sha384>(publicKey, message, sha384)) {
    return 9
  }
  let fixed = match EcdsaP521.fromDer(random256) {
    Result<[u8; 132], P521SignatureError>.Success { value } => value
    Result<[u8; 132], P521SignatureError>.Failure { error: _ } => {
      return 10
    }
  }
  if !verified(EcdsaP521.verify<Sha256>(publicKey, message, &fixed)) {
    return 10
  }
  if !mismatched(EcdsaP521Sha512.verify(publicKey, b"other", random512))
    || !mismatched(EcdsaP521.verify<Sha512>(publicKey, message, sha256)) {
    return 11
  }
  return 0
}

fn agreeCase(secret: &[u8], peer: &[u8], shared: &[u8]) -> bool {
  return match key(secret).agree(peer) {
    Result<[u8; 66], P521Error>.Success { value } => equal(&value, shared)
    Result<[u8; 66], P521Error>.Failure { error: _ } => false
  }
}

// Reads and writes the three DER forms of a P-521 key, which use two-byte lengths.
fn derCase(secret: &[u8], publicKey: &[u8], sec1: &[u8], pkcs8: &[u8], spki: &[u8]) -> i32 {
  let mut output: [u8; 256] = [0; 256]
  match EcKeyDer.writeSec1(EcCurve.P521, secret, publicKey, &mut output) {
    Result<usize, EcKeyError>.Success { value } => {
      if !equal(Slice.view<u8>(&output, 0, value), sec1) {
        return 1
      }
    }
    Result<usize, EcKeyError>.Failure { error: _ } => {
      return 1
    }
  }
  match EcKeyDer.writePkcs8(EcCurve.P521, secret, publicKey, &mut output) {
    Result<usize, EcKeyError>.Success { value } => {
      if !equal(Slice.view<u8>(&output, 0, value), pkcs8) {
        return 2
      }
    }
    Result<usize, EcKeyError>.Failure { error: _ } => {
      return 2
    }
  }
  match EcKeyDer.writeSpki(EcCurve.P521, publicKey, &mut output) {
    Result<usize, EcKeyError>.Success { value } => {
      if !equal(Slice.view<u8>(&output, 0, value), spki) {
        return 3
      }
    }
    Result<usize, EcKeyError>.Failure { error: _ } => {
      return 3
    }
  }
  let fromSec1 = match EcKeyDer.readSec1(sec1) {
    Result<EcPrivateKeyDer, EcKeyError>.Success { value } => value.curve == EcCurve.P521 && equal(value.secret, secret)
    Result<EcPrivateKeyDer, EcKeyError>.Failure { error: _ } => false
  }
  let fromPkcs8 = match EcKeyDer.readPkcs8(pkcs8) {
    Result<EcPrivateKeyDer, EcKeyError>.Success { value } => value.curve == EcCurve.P521 && equal(value.secret, secret)
    Result<EcPrivateKeyDer, EcKeyError>.Failure { error: _ } => false
  }
  let fromSpki = match EcKeyDer.readSpki(spki) {
    Result<EcPublicKeyDer, EcKeyError>.Success { value } => value.curve == EcCurve.P521 && equal(value.publicKey, publicKey)
    Result<EcPublicKeyDer, EcKeyError>.Failure { error: _ } => false
  }
  if !fromSec1 || !fromPkcs8 || !fromSpki {
    return 4
  }
  return 0
}

