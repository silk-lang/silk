// Two fibers on one LocalScheduler talk over a loopback socket. Each socket wait parks only its
// fiber, and the driver waits for both sockets and the timer in one wait of the parent clock.
import silk.mem.allocator { OutOfMemoryError }
import silk.io.byte_duplex { ByteDuplex, ByteIoError, ReadTransfer }
import silk.core.effect { Effect }
import silk.concurrency.fiber { Cancelled, Fiber }
import silk.concurrency.local_scheduler { LocalScheduler, StalledError }
import silk.concurrency.scheduler { Scheduler, TaskIdExhaustedError }
import silk.system.monotonic_clock { MonotonicClock }
import silk.system.monotonic_clock_native { OsMonotonicClock }
import silk.net.socket_native {
  AcceptedView,
  BoundAddress,
  ConnectOptions,
  Connection,
  ListenOptions,
  Listener,
  NativeSocketError,
  accept,
  connectResolvedOwned,
  listen,
  withAccepted,
}
import silk.net.address { Endpoint, IpAddress, Ipv4Address, Port }
import silk.core.option { Option }
import silk.system.system_clock { Instant }

// Reads exactly `expected.length` bytes and compares them.
effect fn readExact(connection: &mut Connection, expected: &[u8]) -> i32
  ! ByteIoError
  ? &mut MonotonicClock {
  let mut received: [u8; 16] = [0; 16]
  let mut length: usize = 0
  while length < expected.length {
    let mut chunk: [u8; 16] = [0; 16]
    match move run ByteDuplex.readSome(&mut chunk, Option<Instant>.none())
      |> Effect.provideMut<ByteDuplex>(&mut connection.*) {
      ReadTransfer.Data { count } => {
        let mut index: usize = 0
        while index < count {
          if length == 16 { return 1 }
          received[length] = chunk[index]
          length = length + 1
          index = index + 1
        }
      }
      ReadTransfer.End => { return 2 }
    }
  }
  let mut at: usize = 0
  while at < expected.length {
    if received[at] != expected[at] { return 3 }
    at = at + 1
  }
  return 0
}

effect fn answer<'call>(view: &'call mut AcceptedView<'call>) -> i32
  ! ByteIoError
  ? &mut MonotonicClock {
  // The client writes only after its timer, so this read parks the server fiber.
  let read = run readExact(&mut view.connection.*, b"hello")
  if read != 0 { return 10 + read }
  let sent = run ByteDuplex.writeSome(b"world", Option<Instant>.none())
    |> Effect.provideMut<ByteDuplex>(&mut view.connection.*)
  if sent != 5 { return 20 }
  return 0
}

effect fn server(listener: Listener) -> i32
  ! NativeSocketError | ByteIoError
  ? &mut Scheduler | &mut MonotonicClock {
  let mut owned = move listener
  // The client has not connected yet, so accept parks the server fiber.
  let accepted = run accept(&mut owned, Option<Instant>.none())
  let result = run withAccepted(move accepted, answer)
  run Listener.close(&mut owned)
  return result
}

effect fn client(target: Endpoint) -> i32
  ! NativeSocketError | ByteIoError
  ? &mut Scheduler | &mut MonotonicClock {
  let targets = [target]
  let mut connection = run connectResolvedOwned(&targets, ConnectOptions.defaults(), Option<Instant>.none())
  run MonotonicClock.waitFor(5ms)
  let sent = run ByteDuplex.writeSome(b"hello", Option<Instant>.none())
    |> Effect.provideMut<ByteDuplex>(&mut connection)
  if sent != 5 { return 30 }
  // The server answers after its read, so this read parks the client fiber.
  let read = run readExact(&mut connection, b"world")
  run Connection.close(&mut connection)
  if read != 0 { return 40 + read }
  return 0
}

effect fn root() -> i32
  ! NativeSocketError | ByteIoError | OutOfMemoryError | TaskIdExhaustedError | Cancelled
  ? &mut Scheduler | &mut MonotonicClock {
  let local = Endpoint.make(
    IpAddress.V4 { value: Ipv4Address.fromOctets([127, 0, 0, 1]) },
    Port.fromU16(0)
  )
  let listener = run listen(local, ListenOptions.defaults())
  let bound = match Listener.boundAddress(&listener) {
    BoundAddress.Tcp { endpoint } => endpoint
    _ => { return 50 }
  }
  let serving = run Fiber<i32, NativeSocketError | ByteIoError>.forkChild(server(move listener))
  let asking = run Fiber<i32, NativeSocketError | ByteIoError>.forkChild(client(bound))
  let served = run serving.join()
  let asked = run asking.join()
  if served != 0 { return served }
  return asked
}

effect fn program() -> i32
  ! NativeSocketError | ByteIoError | OutOfMemoryError | TaskIdExhaustedError | Cancelled | StalledError {
  let mut clock = OsMonotonicClock.make()
  let mut scheduler = LocalScheduler.make()
  return run scheduler.execute<i32, NativeSocketError | ByteIoError | OutOfMemoryError | TaskIdExhaustedError | Cancelled>(root())
    |> Effect.provideMut<MonotonicClock>(&mut clock)
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  return 99
}

pub fn main() -> i32 {
  return run Effect.catchAll(program(), failed)
}
