// Static bodies pipe into call sections and call members with receiver syntax, as runtime code does.
struct Spec {
  count: u32,
}

impl Spec {
  static fn make() -> Spec { return Spec { count: 0 } }
  static fn bump(self: Spec) -> Spec { return Spec { count: self.count + 1 } }
  static fn add(self: Spec, by: u32) -> Spec { return Spec { count: self.count + by } }
}

static fn bump(spec: Spec) -> Spec {
  return Spec { count: spec.count + 1 }
}

static fn scaled(spec: Spec, by: u32) -> Spec {
  return Spec { count: spec.count * by }
}

// `|> bump` names a unary function, and `|> scaled(3)` supplies the rest of a call section.
static fn piped() -> Spec {
  return Spec { count: 1 } |> bump |> scaled(3) |> bump
}

static fn chained() -> Spec {
  return Spec.make().bump().add(4).bump()
}

static fn throughLocal() -> Spec {
  let made = Spec.make().add(2)
  return made.bump()
}

pub fn main() -> i32 {
  let static first = piped()
  let static second = chained()
  let static third = throughLocal()
  static if first.count != 7 { compileError("a static pipeline is wrong") }
  static if second.count != 6 { compileError("a static receiver chain is wrong") }
  static if third.count != 3 { compileError("a static receiver call on a local is wrong") }
  return 0
}
