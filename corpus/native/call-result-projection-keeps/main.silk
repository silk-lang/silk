import silk.core.option { Option }
struct Token { value: i32 }
struct Holder<'a> { inner: &'a Token }
struct Couple<'a, 'b> { left: &'a Token, right: &'b Token }
union Either<A, B> { Left { value: A }, Right { value: B } }
fn get<'a>(token: &'a Token) -> &'a Token {
  return token
}
fn hold<'a>(token: &'a Token) -> Holder<'a> {
  return Holder { inner: token }
}
fn pair<'a, 'b>(left: &'a Token, right: &'b Token) -> Couple<'a, 'b> {
  return Couple { left: left, right: right }
}
fn pick<'a, 'b>(left: &'a Token, right: &'b Token) -> Either<&'a Token, &'b Token> {
  if left.value > right.value {
    return Either<&'a Token, &'b Token>.Left { value: left }
  }
  return Either<&'a Token, &'b Token>.Right { value: right }
}
fn left<A, B>(value: A) -> Either<A, B> {
  return Either<A, B>.Left { value: move value }
}
// A projection of a call result returns only what the caller lent: the part typed by a body
// region stays in the body.
fn viaGet<'s>(x: &'s Token) -> &'s Token {
  let got = get(x)
  return got
}
fn viaHolder<'s>(x: &'s Token) -> &'s Token {
  let held = hold(x)
  return held.inner
}
fn viaPairLeft<'s>(x: &'s Token) -> &'s Token {
  let owner = Token { value: 3 }
  let both = pair(x, &owner)
  return both.left
}
fn viaPickLeft<'s>(x: &'s Token) -> &'s Token {
  let owner = Token { value: 0 }
  let chosen = pick(x, &owner)
  if let Either<&Token, &Token>.Left {value} = move chosen {
    return value
  }
  return x
}
fn viaLeft<'s>(x: &'s Token) -> &'s Token {
  let chosen = left<&Token, &Token>(x)
  return match move chosen {
    Either<&Token, &Token>.Left {value} => value
    Either<&Token, &Token>.Right {value} => x
  }
}
fn viaOption<'s>(x: &'s Token) -> &'s Token {
  let held = Option<&Token>.some(x)
  if let Option<&Token>.Some {value} = move held {
    return value
  }
  return x
}
fn viaLocalOption(x: &Token) -> i32 {
  let owner = Token { value: 4 }
  let held = Option<&Token>.some(&owner)
  if let Option<&Token>.Some {value} = move held {
    return value.value + x.value
  }
  return x.value
}
pub fn main() -> i32 {
  let token = Token { value: 1 }
  return viaGet(&token).value + viaHolder(&token).value + viaPairLeft(&token).value + viaPickLeft(&token).value
    + viaLeft(&token).value + viaOption(&token).value + viaLocalOption(&token)
}
