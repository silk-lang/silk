// Generated by compiler/fixtures/compression/tar.py from GNU tar and Python tarfile archives.
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.core.effect {Effect}
import silk.compress.tar {TarError, TarKind, TarProgress, TarReader, TarStatus}
import silk.collections.bytes {Bytes}
import silk.compress.checksum {CompressionChecksum}
import silk.collections.slice {Slice}
import silk.core.result {Result}
import silk.num.u32
import silk.num.usize

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at: usize = 0
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + 1
  }
  return true
}

effect fn appendHex(text: &mut Bytes, value: u32) -> () ! OutOfMemoryError ? &mut Allocator {
  let digits = b"0123456789abcdef"
  let mut shift: u32 = 28
  while true {
    let digit: [u8; 1] = [digits[u32.toUsize(u32.shiftRight(value, shift) & 15)]]
    run Bytes.append(&mut text.*, &digit)
    if shift == 0 { return }
    shift = shift - 4
  }
}

effect fn appendDecimal(text: &mut Bytes, value: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  if value >= 10 { run appendDecimal(&mut text.*, value / 10) }
  let digit: [u8; 1] = [usize.toU8(value % 10) + 48]
  run Bytes.append(&mut text.*, &digit)
}

// One line per member: its kind, whether it is executable, its path, and the length and CRC-32 of
// its content, or of its link target for a link. The reader gets `piece` bytes per step, or all
// of `archive` at once when `piece` is 0.
effect fn listing(archive: &[u8], piece: usize) -> Bytes ! OutOfMemoryError | TarError ? &mut Allocator {
  let mut reader = TarReader.make()
  let mut text = Bytes.make()
  let mut content = Bytes.make()
  let mut offset: usize = 0
  let mut open = false
  while true {
    let available = archive.length - offset
    let length = if piece == 0 || available < piece { available } else { piece }
    let input = Slice.view<u8>(archive, offset, length)
    let progress = match TarReader.step(&mut reader, input, offset + length == archive.length) {
      Result.Success {value} => value
      Result.Failure {error} => { fail error }
    }
    offset = offset + progress.consumed
    if progress.status == TarStatus.End { return move text }
    if progress.status == TarStatus.Content { run Bytes.append(&mut content, Slice.view<u8>(input, 0, progress.consumed)) }
    if progress.status == TarStatus.Member {
      let member = TarReader.member(&reader)
      let kind = match member.kind {
        TarKind.File => b"f"
        TarKind.Directory => b"d"
        TarKind.SymbolicLink => b"s"
        TarKind.HardLink => b"h"
        TarKind.Other => b"o"
      }
      run Bytes.append(&mut text, kind)
      run Bytes.append(&mut text, if member.executable { b"x " } else { b"- " })
      if member.prefix.length > 0 {
        run Bytes.append(&mut text, member.prefix)
        run Bytes.append(&mut text, b"/")
      }
      run Bytes.append(&mut text, member.name)
      run Bytes.append(&mut text, b" ")
      Bytes.clear(&mut content)
      if member.kind == TarKind.SymbolicLink || member.kind == TarKind.HardLink { run Bytes.append(&mut content, member.link) }
      open = true
    }
    if open && TarReader.remaining(&reader) == 0 {
      run appendDecimal(&mut text, Bytes.length(&content))
      run Bytes.append(&mut text, b" ")
      run appendHex(&mut text, CompressionChecksum.crc32(Bytes.asSlice(&content)))
      run Bytes.append(&mut text, b"\n")
      open = false
    }
  }
  return move text
}

// Whether reading all of `archive`, `piece` bytes per step, fails with `expected`.
effect fn refuses(archive: &[u8], piece: usize, expected: TarError) -> bool ! OutOfMemoryError ? &mut Allocator {
  return match move run Effect.result(listing(archive, piece)) {
    Result<Bytes, OutOfMemoryError | TarError>.Success {..} => false
    Result<Bytes, OutOfMemoryError | TarError>.Failure {error} => match move error {
      TarError refused => refused == expected
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

