import silk.io.writer_native { StdoutWriter }
import silk.core.effect { Effect }
import silk.format { Format }
import silk.num.i64
import silk.num.u64
import silk.io.writer { Writer, WriterError }

effect fn render() -> () ! WriterError ? &mut Writer {
  let byte: u8 = 255
  let small: i8 = 0 - 1
  let wide: i16 = 0 - 2
  // Each base, with and without the prefix of the alternate form.
  run Format.format("{:x} {:X} {:o} {:b}\n", &(255, 255, 8, 5))
  run Format.format("{:#x} {:#X} {:#o} {:#b}\n", &(255, 255, 8, 5))
  // Zero is one digit in every base.
  run Format.format("{:x} {:#b}\n", &(0, 0))
  // Negative values display as their two's complement bits at their own width.
  run Format.format("{:x} {:x} {:b} {:X}\n", &(small, wide, small, 0 - 1))
  run Format.format("{:x} {:x}\n", &(i64.MIN, u64.MAX))
  // Zero padding goes after the prefix, and the prefix counts toward the width.
  run Format.format("[{:#010x}] [{:08b}] [{:>#8x}] [{:<#6o}] [{:^#9X}]\n", &(255, 5, byte, 8, 171))
  // A precision is a minimum digit count, as for decimal.
  return run Format.format("[{:#.4x}] [{:6.3b}]\n", &(10, 1))
}

effect fn build() -> i32 ! WriterError {
  let mut writer = StdoutWriter.make()
  run render() |> Effect.provideMut<Writer>(&mut writer)
  return 42
}
effect fn recover(error: WriterError) -> i32 { return 1 }
pub fn main() -> i32 { return run Effect.catchAll(build(), recover) }
