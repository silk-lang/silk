import silk.crypto.aes_gcm { AesGcm, AesGcmDecryptor, AesGcmEncryptor, AesGcmError }
import silk.crypto.sha2 { Sha256 }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.num.usize

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut index: usize = 0
  while index < left.length {
    if left[index] != right[index] { return false }
    index = index + 1
  }
  return true
}

fn code(result: Result<(), AesGcmError>) -> i32 {
  return match move result {
    Result.Success { value: _ } => 0
    Result.Failure { error } => match move error {
      AesGcmError.InvalidKeyLength => 1
      AesGcmError.InvalidNonceLength => 2
      AesGcmError.InvalidTagLength => 3
      AesGcmError.OutputTooSmall => 4
      AesGcmError.LimitExceeded => 5
      AesGcmError.AuthenticationFailed => 6
    }
  }
}

fn encryptor(key: &[u8], nonce: &[u8], aad: &[u8]) -> AesGcmEncryptor {
  return match AesGcmEncryptor.make(key, nonce, aad) {
    Result<AesGcmEncryptor, AesGcmError>.Success { value } => move value
    Result<AesGcmEncryptor, AesGcmError>.Failure { error: _ } => Intrinsic.trap("encryptor")
  }
}

fn decryptor(key: &[u8], nonce: &[u8], aad: &[u8]) -> AesGcmDecryptor {
  return match AesGcmDecryptor.make(key, nonce, aad) {
    Result<AesGcmDecryptor, AesGcmError>.Success { value } => move value
    Result<AesGcmDecryptor, AesGcmError>.Failure { error: _ } => Intrinsic.trap("decryptor")
  }
}

// Encrypts the message in parts of `step` bytes and checks the result.
fn sealInParts(key: &[u8], nonce: &[u8], aad: &[u8], input: &[u8], step: usize, expected: &[u8], expectedTag: &[u8]) -> bool {
  let mut state = encryptor(key, nonce, aad)
  let mut offset: usize = 0
  let mut output: [u8; 200] = [0; 200]
  offset = 0
  while offset < input.length {
    let mut end = offset + step
    if end > input.length { end = input.length }
    if code(state.update(Slice.view<u8>(input, offset, end - offset), Slice.viewMut<u8>(&mut output, offset, 200 - offset))) != 0 { return false }
    offset = end
  }
  let mut tag: [u8; 16] = [0; 16]
  if code(state.finish(&mut tag)) != 0 { return false }
  return same(Slice.view<u8>(&output, 0, input.length), expected) && same(&tag, expectedTag)
}

fn openInParts(key: &[u8], nonce: &[u8], aad: &[u8], input: &[u8], step: usize, expected: &[u8], tag: &[u8]) -> i32 {
  let mut state = decryptor(key, nonce, aad)
  let mut offset: usize = 0
  let mut output: [u8; 200] = [0; 200]
  offset = 0
  while offset < input.length {
    let mut end = offset + step
    if end > input.length { end = input.length }
    if code(state.update(Slice.view<u8>(input, offset, end - offset), Slice.viewMut<u8>(&mut output, offset, 200 - offset))) != 0 { return 101 }
    offset = end
  }
  if same(Slice.view<u8>(&output, 0, input.length), expected) == false { return 102 }
  return code(state.finish(tag))
}

fn knownVectors() -> bool {
  let k = key()
  let p = plain()
  let a = aadBytes()
  let mut step: usize = 1
  while step <= 61 {
    if sealInParts(&k, &nonce5(), &a, &p, step, &cipher5(), &tag5()) == false { return false }
    if sealInParts(&k, &nonce6(), &a, &p, step, &cipher6(), &tag6()) == false { return false }
    if openInParts(&k, &nonce5(), &a, &cipher5(), step, &p, &tag5()) != 0 { return false }
    if openInParts(&k, &nonce6(), &a, &cipher6(), step, &p, &tag6()) != 0 { return false }
    step = step + 4
  }
  // Truncated tags are prefixes of the full tag.
  let full = tag6()
  let mut length: usize = 4
  while length <= 16 {
    let admitted = length == 4 || length == 8 || length >= 12
    let mut state = encryptor(&k, &nonce6(), &a)
    let mut output: [u8; 60] = [0; 60]
    if code(state.update(&p, &mut output)) != 0 { return false }
    let mut tag: [u8; 16] = [9; 16]
    let finished = code(state.finish(Slice.viewMut<u8>(&mut tag, 0, length)))
    if admitted {
      if finished != 0 || same(Slice.view<u8>(&tag, 0, length), Slice.view<u8>(&full, 0, length)) == false { return false }
      if openInParts(&k, &nonce6(), &a, &cipher6(), 60, &p, Slice.view<u8>(&full, 0, length)) != 0 { return false }
    } else {
      if finished != 3 || tag[0] != 9 { return false }
      if openInParts(&k, &nonce6(), &a, &cipher6(), 60, &p, Slice.view<u8>(&full, 0, length)) != 3 { return false }
    }
    length = length + 1
  }
  return true
}

// The streaming result for a 12-byte nonce equals the one-shot functions.
fn matchesOneShot() -> bool {
  let k = key()
  let p = plain()
  let a = aadBytes()
  let nonce: [u8; 12] = [202, 254, 186, 190, 250, 206, 219, 173, 222, 202, 248, 136]
  let mut cipher: [u8; 60] = [0; 60]
  let mut tag: [u8; 16] = [0; 16]
  if code(AesGcm.seal(&k, &nonce, &a, &p, &mut cipher, &mut tag)) != 0 { return false }
  return sealInParts(&k, &nonce, &a, &p, 7, &cipher, &tag) && openInParts(&k, &nonce, &a, &cipher, 13, &p, &tag) == 0
}

fn sweep() -> bool {
  let mut k: [u8; 32] = [0; 32]
  let mut index: usize = 0
  while index < 32 { k[index] = usize.toU8(index) index = index + 1 }
  let mut hash = Sha256.make()
  let mut n: usize = 8
  while n <= 64 {
    let mut nonce: [u8; 64] = [0; 64]
    let mut aad: [u8; 23] = [0; 23]
    let mut input: [u8; 192] = [0; 192]
    index = 0
    while index < n { nonce[index] = usize.toU8((index * 5 + n) % 256) index = index + 1 }
    index = 0
    while index < n % 23 { aad[index] = usize.toU8((index * 3 + 1) % 256) index = index + 1 }
    index = 0
    while index < n * 3 { input[index] = usize.toU8((index * 11 + 7) % 256) index = index + 1 }
    let mut state = encryptor(&k, Slice.view<u8>(&nonce, 0, n), Slice.view<u8>(&aad, 0, n % 23))
    let mut output: [u8; 192] = [0; 192]
    if code(state.update(Slice.view<u8>(&input, 0, n * 3), &mut output)) != 0 { return false }
    let mut tag: [u8; 16] = [0; 16]
    if code(state.finish(&mut tag)) != 0 { return false }
    hash.update(Slice.view<u8>(&output, 0, n * 3))
    hash.update(&tag)
    n = n + 7
  }
  let digest = hash.finish()
  return same(&digest, &sweepDigest())
}

fn rejections() -> bool {
  let k = key()
  let p = plain()
  let a = aadBytes()
  let empty: [u8; 0] = []
  let short: [u8; 15] = [0; 15]
  if let Result.Failure { error } = AesGcmEncryptor.make(&short, &nonce5(), &a) { if code(Result<(), AesGcmError>.failResult(move error)) != 1 { return false } } else { return false }
  if let Result.Failure { error } = AesGcmDecryptor.make(&k, &empty, &a) { if code(Result<(), AesGcmError>.failResult(move error)) != 2 { return false } } else { return false }
  let mut state = encryptor(&k, &nonce5(), &a)
  // Output too small leaves the output alone.
  let mut tiny: [u8; 3] = [5; 3]
  if code(state.update(&p, &mut tiny)) != 4 || tiny[0] != 5 { return false }
  // A wrong tag, wrong associated data, and a changed ciphertext all fail.
  let mut wrongTag = tag5()
  wrongTag[3] = wrongTag[3] ^ 128
  if openInParts(&k, &nonce5(), &a, &cipher5(), 16, &p, &wrongTag) != 6 { return false }
  let mut changed = cipher5()
  changed[59] = changed[59] ^ 1
  let mut decrypted = plain()
  decrypted[59] = decrypted[59] ^ 1
  if openInParts(&k, &nonce5(), &a, &changed, 16, &decrypted, &tag5()) != 6 { return false }
  if openInParts(&k, &nonce5(), &empty, &cipher5(), 16, &p, &tag5()) != 6 { return false }
  return true
}

fn key() -> [u8; 16] { return [254, 255, 233, 146, 134, 101, 115, 28, 109, 106, 143, 148, 103, 48, 131, 8] }
fn plain() -> [u8; 60] { return [217, 49, 50, 37, 248, 132, 6, 229, 165, 89, 9, 197, 175, 245, 38, 154, 134, 167, 169, 83, 21, 52, 247, 218, 46, 76, 48, 61, 138, 49, 138, 114, 28, 60, 12, 149, 149, 104, 9, 83, 47, 207, 14, 36, 73, 166, 181, 37, 177, 106, 237, 245, 170, 13, 230, 87, 186, 99, 123, 57] }
fn aadBytes() -> [u8; 20] { return [254, 237, 250, 206, 222, 173, 190, 239, 254, 237, 250, 206, 222, 173, 190, 239, 171, 173, 218, 210] }
fn nonce5() -> [u8; 8] { return [202, 254, 186, 190, 250, 206, 219, 173] }
fn cipher5() -> [u8; 60] { return [97, 53, 59, 76, 40, 6, 147, 74, 119, 127, 245, 31, 162, 42, 71, 85, 105, 155, 42, 113, 79, 205, 198, 248, 55, 102, 229, 249, 123, 108, 116, 35, 115, 128, 105, 0, 228, 159, 36, 178, 43, 9, 117, 68, 212, 137, 107, 66, 73, 137, 181, 225, 235, 172, 15, 7, 194, 63, 69, 152] }
fn tag5() -> [u8; 16] { return [54, 18, 210, 231, 158, 59, 7, 133, 86, 27, 225, 74, 172, 162, 252, 203] }
fn nonce6() -> [u8; 60] { return [147, 19, 34, 93, 248, 132, 6, 229, 85, 144, 156, 90, 255, 82, 105, 170, 106, 122, 149, 56, 83, 79, 125, 161, 228, 195, 3, 210, 163, 24, 167, 40, 195, 192, 201, 81, 86, 128, 149, 57, 252, 240, 226, 66, 154, 107, 82, 84, 22, 174, 219, 245, 160, 222, 106, 87, 166, 55, 179, 155] }
fn cipher6() -> [u8; 60] { return [140, 226, 73, 152, 98, 86, 21, 182, 3, 160, 51, 172, 161, 63, 184, 148, 190, 145, 18, 165, 195, 162, 17, 168, 186, 38, 42, 60, 202, 126, 44, 167, 1, 228, 169, 164, 251, 164, 60, 144, 204, 220, 178, 129, 212, 140, 124, 111, 214, 40, 117, 210, 172, 164, 23, 3, 76, 52, 174, 229] }
fn tag6() -> [u8; 16] { return [97, 156, 197, 174, 255, 254, 11, 250, 70, 42, 244, 60, 22, 153, 208, 80] }
fn sweepDigest() -> [u8; 32] { return [213, 215, 182, 207, 213, 110, 146, 65, 39, 161, 77, 127, 165, 153, 199, 61, 239, 216, 248, 218, 23, 198, 100, 129, 183, 113, 34, 145, 174, 128, 195, 26] }

pub fn main() -> i32 {
  if knownVectors() == false { return 1 }
  if matchesOneShot() == false { return 2 }
  if sweep() == false { return 3 }
  if rejections() == false { return 4 }
  return 42
}
