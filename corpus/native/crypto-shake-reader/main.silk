// SHAKE128 and SHAKE256 output read a part at a time through Shake128Reader and Shake256Reader,
// with part sizes that cross lane and block edges, against one finishInto of the same length and
// the SHA-256 of the output from Python's hashlib. Exit code 42 is a pass.
import silk.crypto.sha3 {Shake128, Shake128Reader, Shake256, Shake256Reader}
import silk.crypto.sha2 {Sha256}
import silk.collections.slice {Slice}
import silk.num.usize

fn message(length: usize, output: &mut [u8; 1000]) -> () {
  let mut index: usize = 0
  while index < length {
    output[index] = usize.toU8((index * 29 + length * 3 + 1) % 256)
    index = index + 1
  }
}

fn parts() -> [usize; 9] {
  return [1, 7, 8, 9, 135, 136, 168, 169, 500]
}

fn same(a: &[u8; 4000], b: &[u8; 4000]) -> bool {
  let mut index: usize = 0
  while index < 4000 {
    if a[index] != b[index] {
      return false
    }
    index = index + 1
  }
  return true
}

fn digestIs(bytes: &[u8; 4000], expected: &[u8; 32]) -> bool {
  let digest = Sha256.hash(bytes)
  let mut index: usize = 0
  while index < 32 {
    if digest[index] != expected[index] {
      return false
    }
    index = index + 1
  }
  return true
}

fn check128(length: usize, start: usize, expected: &[u8; 32]) -> bool {
  let mut input: [u8; 1000] = [0; 1000]
  message(length, &mut input)
  let mut whole: [u8; 4000] = [0; 4000]
  Shake128.hash(Slice.view<u8>(&input, 0, length), &mut whole)
  let mut state = Shake128.make()
  state.update(Slice.view<u8>(&input, 0, length))
  let mut reader = state.finish()
  let mut pieces: [u8; 4000] = [0; 4000]
  let sizes = parts()
  let mut at: usize = 0
  let mut which = start
  while at < 4000 {
    let mut size = sizes[which % 9]
    if size > 4000 - at {
      size = 4000 - at
    }
    reader.read(Slice.viewMut<u8>(&mut pieces, at, size))
    at = at + size
    which = which + 1
  }
  let mut empty: [u8; 0] = []
  reader.read(&mut empty)
  return same(&whole, &pieces) && digestIs(&whole, expected)
}

fn check256(length: usize, start: usize, expected: &[u8; 32]) -> bool {
  let mut input: [u8; 1000] = [0; 1000]
  message(length, &mut input)
  let mut whole: [u8; 4000] = [0; 4000]
  Shake256.hash(Slice.view<u8>(&input, 0, length), &mut whole)
  let mut state = Shake256.make()
  state.update(Slice.view<u8>(&input, 0, length))
  let mut reader = state.finish()
  let mut pieces: [u8; 4000] = [0; 4000]
  let sizes = parts()
  let mut at: usize = 0
  let mut which = start
  while at < 4000 {
    let mut size = sizes[which % 9]
    if size > 4000 - at {
      size = 4000 - at
    }
    reader.read(Slice.viewMut<u8>(&mut pieces, at, size))
    at = at + size
    which = which + 1
  }
  return same(&whole, &pieces) && digestIs(&whole, expected)
}

pub fn main() -> i32 {
  let a0: [u8; 32] = [150, 204, 201, 127, 163, 102, 166, 234, 41, 135, 82, 128, 75, 235, 165, 44, 131, 176, 185, 241, 114, 146, 79, 171, 245, 223, 217, 189, 130, 233, 83, 11]
  if !check128(0, 0, &a0) {
    return 1
  }
  let b0: [u8; 32] = [150, 121, 52, 142, 7, 125, 250, 251, 230, 6, 5, 21, 95, 237, 187, 227, 29, 126, 160, 183, 233, 164, 245, 87, 178, 100, 5, 24, 47, 24, 123, 121]
  if !check256(0, 0, &b0) {
    return 2
  }
  let a1: [u8; 32] = [70, 253, 204, 139, 72, 239, 85, 182, 136, 35, 201, 167, 217, 93, 251, 20, 19, 66, 152, 115, 165, 94, 229, 136, 115, 112, 44, 103, 195, 114, 185, 250]
  if !check128(1, 1, &a1) {
    return 3
  }
  let b1: [u8; 32] = [36, 47, 215, 62, 206, 8, 23, 141, 247, 107, 178, 15, 9, 70, 170, 52, 21, 36, 162, 52, 31, 178, 127, 172, 46, 183, 126, 143, 225, 234, 183, 39]
  if !check256(1, 1, &b1) {
    return 4
  }
  let a2: [u8; 32] = [107, 203, 9, 203, 13, 213, 220, 11, 17, 148, 243, 207, 165, 86, 30, 125, 226, 193, 101, 77, 13, 155, 213, 197, 18, 184, 206, 39, 51, 231, 103, 135]
  if !check128(135, 2, &a2) {
    return 5
  }
  let b2: [u8; 32] = [235, 248, 122, 250, 160, 52, 36, 48, 241, 46, 84, 9, 73, 242, 250, 121, 74, 19, 34, 162, 91, 155, 227, 221, 241, 105, 57, 6, 166, 80, 18, 203]
  if !check256(135, 2, &b2) {
    return 6
  }
  let a3: [u8; 32] = [90, 220, 111, 201, 135, 18, 119, 196, 33, 196, 142, 157, 12, 68, 111, 29, 225, 127, 80, 104, 246, 18, 46, 40, 64, 40, 126, 101, 54, 168, 238, 79]
  if !check128(136, 3, &a3) {
    return 7
  }
  let b3: [u8; 32] = [207, 72, 242, 25, 3, 163, 20, 80, 22, 239, 118, 186, 251, 31, 240, 207, 183, 232, 212, 8, 50, 243, 248, 151, 85, 185, 62, 34, 187, 238, 0, 20]
  if !check256(136, 3, &b3) {
    return 8
  }
  let a4: [u8; 32] = [6, 8, 148, 41, 149, 204, 29, 140, 145, 125, 189, 216, 72, 192, 185, 38, 25, 43, 157, 110, 135, 123, 76, 84, 48, 159, 219, 133, 123, 24, 199, 118]
  if !check128(167, 4, &a4) {
    return 9
  }
  let b4: [u8; 32] = [118, 43, 5, 97, 21, 69, 191, 104, 84, 152, 151, 128, 56, 6, 200, 127, 73, 96, 26, 24, 73, 3, 10, 172, 161, 45, 30, 209, 85, 92, 201, 154]
  if !check256(167, 4, &b4) {
    return 10
  }
  let a5: [u8; 32] = [88, 69, 88, 228, 8, 180, 217, 17, 253, 63, 107, 61, 48, 80, 207, 107, 87, 227, 146, 40, 237, 241, 94, 110, 251, 93, 94, 18, 58, 170, 112, 183]
  if !check128(168, 5, &a5) {
    return 11
  }
  let b5: [u8; 32] = [69, 246, 165, 100, 192, 200, 113, 100, 72, 89, 244, 74, 63, 188, 203, 158, 191, 220, 187, 209, 207, 52, 133, 11, 32, 31, 105, 81, 178, 56, 12, 141]
  if !check256(168, 5, &b5) {
    return 12
  }
  let a6: [u8; 32] = [74, 11, 80, 121, 16, 93, 244, 142, 63, 143, 90, 225, 189, 21, 17, 47, 242, 196, 76, 150, 169, 178, 241, 233, 89, 155, 183, 223, 61, 223, 107, 59]
  if !check128(169, 6, &a6) {
    return 13
  }
  let b6: [u8; 32] = [9, 104, 1, 209, 167, 30, 2, 67, 98, 80, 41, 204, 202, 193, 67, 184, 146, 206, 237, 220, 65, 179, 227, 92, 211, 182, 131, 68, 253, 99, 15, 120]
  if !check256(169, 6, &b6) {
    return 14
  }
  let a7: [u8; 32] = [1, 166, 113, 182, 5, 237, 88, 3, 159, 59, 54, 99, 176, 142, 90, 20, 90, 212, 175, 107, 85, 58, 250, 77, 96, 91, 22, 252, 182, 233, 21, 112]
  if !check128(1000, 7, &a7) {
    return 15
  }
  let b7: [u8; 32] = [154, 143, 74, 173, 83, 172, 63, 33, 191, 193, 154, 17, 112, 49, 176, 225, 225, 144, 70, 163, 80, 6, 156, 186, 28, 88, 75, 192, 7, 47, 167, 225]
  if !check256(1000, 7, &b7) {
    return 16
  }
  return 42
}
