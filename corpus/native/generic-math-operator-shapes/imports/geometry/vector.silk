//! A generic two-dimensional vector whose operations need only what each one uses.
import silk.core.ownership { Copy }
import silk.core.ops { Add, Multiply, Subtract }

pub struct Vector2<T> {
  pub x: T,
  pub y: T,
}

impl<T: Copy> Copy for Vector2<T> {}

// Every member of an unbounded block exists for every `T`.
impl<T: Copy> Vector2<T> {
  pub fn swapped(self: Self) -> Self { return Vector2<T> { x: self.y, y: self.x } }
}

// A bounded inherent block (IMPL-006): `dot` exists where `T` adds and multiplies.
impl<T: Copy + Add<T, T> + Multiply<T, T>> Vector2<T> {
  pub fn dot(self: Self, other: Self) -> T { return self.x * other.x + self.y * other.y }
}

// A second bounded block with its own bounds.
impl<T: Copy + Subtract<T, T>> Vector2<T> {
  pub fn difference(self: Self, other: Self) -> Self { return Vector2<T> { x: self.x - other.x, y: self.y - other.y } }
}

/// The sum of a value's components.
pub interface Total<S> {
  fn total(self: Self) -> S
}

// The bound repeats `T` in its interface arguments and still descends through the provider (IMPL-008).
impl<T: Copy + Add<T, T>> Total<T> for Vector2<T> {
  fn total(self: Self) -> T { return self.x + self.y }
}

// The vector's module owns `f64 * Vector2<f64>`, because `Vector2` is the first type argument (IMPL-004).
impl Multiply<Vector2<f64>, Vector2<f64>> for f64 {
  fn multiply(left: f64, right: Vector2<f64>) -> Vector2<f64> {
    return Vector2<f64> { x: left * right.x, y: left * right.y }
  }
}

impl Multiply<f64, Vector2<f64>> for Vector2<f64> {
  fn multiply(left: Vector2<f64>, right: f64) -> Vector2<f64> {
    return Vector2<f64> { x: left.x * right, y: left.y * right }
  }
}
