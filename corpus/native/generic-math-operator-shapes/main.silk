// Generic math types: bounded inherent blocks, operator-bounded conformances and a scalar on the
// left of an operator whose conformance lives with the vector type.
import geometry.vector { Total, Vector2 }

pub fn main() -> i32 {
  let a = Vector2<i32> { x: 3, y: 4 }
  let b = a.swapped()
  let dot = a.dot(b)
  let gap = a.difference(b)
  let total = a.total()
  let scaled = 2.0 * Vector2<f64> { x: 1.5, y: 2.0 }
  let back = scaled * 0.5
  if scaled.x != 3.0 || scaled.y != 4.0 || back.y != 2.0 { return 1 }
  return dot + gap.x + total
}
