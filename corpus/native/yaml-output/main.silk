// Writes YAML with silk.yaml.output: plain, quoted, and literal strings, numbers, empty and nested
// collections, long keys, document streams, and a parsed document written back.
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f64
import silk.num.usize
import silk.yaml.document { YamlDocument, YamlError }
import silk.yaml.output { YamlEmitter, YamlOutput }

struct Capture {
  bytes: [u8; 4096],
  length: usize,
}

impl Writer for Capture {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> () ! WriterError ? &mut Writer {
    Slice.copyInto<u8>(&mut self.bytes, self.length, value)
    self.length = self.length + value.length
    return ()
  }

  effect fn flush(self: &mut Self) -> () ! WriterError ? &mut Writer {
    return ()
  }
}

fn holds(capture: &Capture, expected: &[u8]) -> bool {
  return Slice.view<u8>(&capture.bytes, 0, capture.length) == expected
}

effect fn strings() -> () ! YamlError | WriterError ? &mut Writer {
  let mut emitter = YamlEmitter.make()
  run emitter.beginMapping()
  run emitter.key("plain")
  run emitter.text("hello world")
  run emitter.key("number")
  run emitter.text("12")
  run emitter.key("keyword")
  run emitter.text("null")
  run emitter.key("old")
  run emitter.text("off")
  run emitter.key("date")
  run emitter.text("2001-12-14")
  run emitter.key("colon")
  run emitter.text("a: b")
  run emitter.key("comment")
  run emitter.text("a #b")
  run emitter.key("dash")
  run emitter.text("-x")
  run emitter.key("indicator")
  run emitter.text("*star")
  run emitter.key("empty")
  run emitter.text("")
  run emitter.key("escapes")
  run emitter.text("tab\there \"q\" \\ \u{85}\u{2028}")
  run emitter.key("lines")
  run emitter.text("one\n\ntwo")
  run emitter.key("kept")
  run emitter.text("end\n\n")
  run emitter.key("indented")
  run emitter.text(" lead\nnext")
  run emitter.key("two words")
  run emitter.null()
  run emitter.key("")
  run emitter.boolean(false)
  run emitter.endMapping()
  return run emitter.finish()
}

effect fn numbers() -> () ! YamlError | WriterError ? &mut Writer {
  let mut emitter = YamlEmitter.make()
  run emitter.beginSequence()
  run emitter.element()
  run emitter.signed(-7)
  run emitter.element()
  run emitter.unsigned(18446744073709551615)
  run emitter.element()
  run emitter.float(2.0)
  run emitter.element()
  run emitter.float(0.25)
  run emitter.element()
  run emitter.float(1e300)
  run emitter.element()
  run emitter.float(f64.NAN)
  run emitter.element()
  run emitter.float(-f64.INFINITY)
  run emitter.endSequence()
  return run emitter.finish()
}

effect fn nested() -> () ! YamlError | WriterError ? &mut Writer {
  let mut emitter = YamlEmitter.make()
  run emitter.beginSequence()
  run emitter.element()
  run emitter.beginMapping()
  run emitter.key("a")
  run emitter.beginMapping()
  run emitter.endMapping()
  run emitter.key("b")
  run emitter.beginSequence()
  run emitter.endSequence()
  run emitter.key("c")
  run emitter.beginSequence()
  run emitter.element()
  run emitter.beginSequence()
  run emitter.element()
  run emitter.signed(1)
  run emitter.endSequence()
  run emitter.endSequence()
  run emitter.endMapping()
  run emitter.element()
  run emitter.text("x")
  run emitter.endSequence()
  run emitter.nextDocument()
  run emitter.text("second")
  run emitter.nextDocument()
  return run emitter.finish()
}

effect fn emitted(capture: &mut Capture, which: usize) -> bool {
  capture.length = 0
  let result = if which == 0 {
    run Effect.result(strings()) |> Effect.provideMut<Writer>(&mut capture.*)
  } else if which == 1 {
    run Effect.result(numbers()) |> Effect.provideMut<Writer>(&mut capture.*)
  } else {
    run Effect.result(nested()) |> Effect.provideMut<Writer>(&mut capture.*)
  }
  return match move result {
    Result<(), YamlError | WriterError>.Success {..} => true
    Result<(), YamlError | WriterError>.Failure {..} => false
  }
}

effect fn rewritten(capture: &mut Capture, text: &[u8]) -> bool ! OutOfMemoryError ? &mut Allocator {
  capture.length = 0
  let document = match move run Effect.result(YamlDocument.parseAll(text)) {
    Result<YamlDocument, YamlError | OutOfMemoryError>.Success {value} => move value
    Result<YamlDocument, YamlError | OutOfMemoryError>.Failure {..} => { return false }
  }
  return match move run Effect.result(YamlOutput.write(&document)) |> Effect.provideMut<Writer>(&mut capture.*) {
    Result<(), YamlError | WriterError>.Success {..} => true
    Result<(), YamlError | WriterError>.Failure {..} => false
  }
}

effect fn checks() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let mut capture = Capture {bytes: [0; 4096], length: 0}
  if !run emitted(&mut capture, 0) { return 1 }
  if !holds(&capture, b"plain: hello world\nnumber: \"12\"\nkeyword: \"null\"\nold: \"off\"\ndate: \"2001-12-14\"\ncolon: \"a: b\"\ncomment: \"a #b\"\ndash: -x\nindicator: \"*star\"\nempty: \"\"\nescapes: \"tab\\there \\\"q\\\" \\\\ \\N\\L\"\nlines: |-\n  one\n\n  two\nkept: |+\n  end\n\nindented: \" lead\\nnext\"\ntwo words: null\n\"\": false\n") { return 2 }
  if !run emitted(&mut capture, 1) { return 3 }
  if !holds(&capture, b"- -7\n- 18446744073709551615\n- 2.0\n- 0.25\n- 1.0e+300\n- .nan\n- -.inf\n") { return 4 }
  if !run emitted(&mut capture, 2) { return 5 }
  if !holds(&capture, b"- a: {}\n  b: []\n  c:\n    - - 1\n- x\n---\nsecond\n---\nnull\n") { return 6 }
  if !run rewritten(&mut capture, b"{a: [1, {b: 'c d'}], e: &x [f], g: *x}\n--- text\n") { return 7 }
  if !holds(&capture, b"a:\n  - 1\n  - b: c d\ne:\n  - f\ng:\n  - f\n---\ntext\n") { return 8 }
  // The written text parses back to the same values.
  let mut first = Capture {bytes: [0; 4096], length: 0}
  if !run emitted(&mut first, 0) { return 9 }
  if !run rewritten(&mut capture, Slice.view<u8>(&first.bytes, 0, first.length)) { return 10 }
  if !holds(&capture, Slice.view<u8>(&first.bytes, 0, first.length)) { return 11 }
  return 0
}

pub effect fn main() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checks() |> Effect.provideMut<Allocator>(&mut allocator)
}
