// Edge cases from Project Wycheproof, ecdsa_secp256r1_sha256_test.json (Apache License 2.0): every
// valid signature of the key groups after the first, which cover arithmetic corner cases such as
// edge values of u1 and u2, Shamir multiplication, and large x-coordinates, and every eighth invalid
// one. Hex text keeps the table small.
fn hexDigit(c: u8) -> u8 {
  if c >= 97 { return c - 87 }
  return c - 48
}

fn unhex(text: &[u8], output: &mut [u8; 256]) -> usize {
  let mut i: usize = 0
  while i * 2 < text.length {
    output[i] = hexDigit(text[i * 2]) * 16 + hexDigit(text[i * 2 + 1])
    i = i + 1
  }
  return i
}

fn wycheproofCase(key: &[u8], message: &[u8], signature: &[u8], valid: bool) -> bool {
  let mut keyBytes: [u8; 256] = [0; 256]
  let mut messageBytes: [u8; 256] = [0; 256]
  let mut signatureBytes: [u8; 256] = [0; 256]
  let keyLength = unhex(key, &mut keyBytes)
  let messageLength = unhex(message, &mut messageBytes)
  let signatureLength = unhex(signature, &mut signatureBytes)
  let verified = ecdsaOk(EcdsaP256Sha256.verify(
    Slice.view<u8>(&keyBytes, 0, keyLength),
    Slice.view<u8>(&messageBytes, 0, messageLength),
    Slice.view<u8>(&signatureBytes, 0, signatureLength),
  ))
  return verified == valid
}

// Returns 0, or the Wycheproof test number that disagrees.
