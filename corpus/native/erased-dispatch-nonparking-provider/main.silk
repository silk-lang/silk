import silk.core.effect { Effect }

interface Read { fn read(self: &Self) -> i32 }
struct Counter { value: i32 }
impl Read for Counter { fn read(self: &Self) -> i32 { return self.value } }
service Port { effect fn close() -> () ? &mut Port }
effect fn shut(self: &mut Counter) -> () { self.value = self.value + 2 }
impl Port for Counter { close: Counter.shut }
effect fn closing() -> () ? &mut Port { run Port.close() }
effect fn work() -> () {}
pub fn main() -> i32 {
  let mut port = Counter { value: 40 }
  run Effect.ensuringNonParking(work(), closing()) |> Effect.provideMut<Port>(&mut port)
  let reader: &any Read = &port
  return reader.read()
}
