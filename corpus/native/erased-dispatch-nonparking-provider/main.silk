import silk.core.effect { Effect }

interface Read { fn read(self: &Self) -> i32 }
struct Counter { value: i32 }
impl Read for Counter { fn read(self: &Self) -> i32 { return self.value } }
service Port { effect fn close() -> () ? &mut Port }
effect fn shut(self: &mut Counter) -> () { self.value = self.value + 2 }
impl Port for Counter { close: Counter.shut }
effect fn closing() -> () ? &mut Port { run Port.close() }
effect fn work() -> () {}

struct Other { value: i32 }
effect fn closeOther(self: &mut Other) -> () { self.value = 7 }
impl Port for Other { close: Other.closeOther }
fn hold<'a, ?R, F: once Effect<'a; () ? R> + Intrinsic.NonParking>(value: F) -> F { return move value }
effect fn quiet() -> () ? &mut Port {}

pub fn main() -> i32 {
  let mut port = Counter { value: 40 }
  run Effect.ensuringNonParking(work(), closing()) |> Effect.provideMut<Port>(&mut port)
  let mut other = Other { value: 0 }
  let second = hold(closing())
  run move second |> Effect.provideMut<Port>(&mut other)
  if other.value != 7 { return 1 }
  // The unused Effect never consults its declared provider, so its body can still be proved.
  let neverRun = hold(quiet())
  drop neverRun
  let reader: &any Read = &port
  return reader.read()
}
