// A struct with an elided `string` lifetime, kept in a List or HashMap a body makes and binds to
// a local, returns as the declared result (finding 167). The local's element region is inferred to
// equal the result's, though both collections are invariant in their elements.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.collections.hash { Hash, HashKey, Word }
import silk.collections.hash_map { HashMap }
import silk.collections.list { List }

struct Name {
  text: string,
}

effect fn build(text: string) -> List<Name> ! OutOfMemoryError ? &mut Allocator {
  let mut names = List<Name>.make()
  run List<Name>.append(&mut names, Name { text: text })
  return move names
}

effect fn index(text: string) -> HashMap<Word, Name> ! OutOfMemoryError ? &mut Allocator {
  let mut names = HashMap<Word, Name>.make(Hash.seed(7))
  let previous = run names.insert(Word { value: 1 }, Name { text: text })
  drop previous
  return move names
}

effect fn cases() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let names = run build("a")
  if names.length() != 1 { return 1 }
  let map = run index("b")
  if map.length() != 1 { return 2 }
  return 0
}

effect fn recover(error: OutOfMemoryError) -> i32 { return 98 }

pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(cases(), recover) |> Effect.provideMut<Allocator>(&mut allocator)
}
