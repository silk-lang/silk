import silk.core.ownership { Drop }
struct Token<'data> { drops: &'data mut i32 }
impl<'data> Drop for Token<'data> {
  fn drop(self: &mut Token<'data>) -> () {
    self.drops.* = self.drops.* + 1
    return ()
  }
}
struct A { v: i32 }
struct B { w: i32 }
struct C { x: i32 }

// Members that substitution makes equal share one stored member (UNION-001): the first arm wins.
fn pick<T>(value: T | A) -> i32 {
  return match move value { T _ => 1 A a => a.v }
}
fn either<T, U>(left: bool, t: T, u: U) -> T | U {
  if left { return move t }
  return move u
}
fn side<T, U>(value: T | U) -> i32 { return match move value { T _ => 1 U _ => 2 } }

// A member instantiated with a union spreads over that union's members.
fn kind<T>(value: T | C) -> i32 { return match move value { T _ => 1 C c => c.x } }
fn keep<T>(value: T | C) -> T | C { return match move value { T t => move t C c => move c } }
fn make(flag: bool) -> A | B {
  if flag { return A { v: 1 } }
  return B { w: 2 }
}
fn score(value: A | B | C) -> i32 { return match move value { A a => a.v B b => b.w C c => c.x } }

// A spread binding moves its payload exactly once.
fn hold<'data, T>(value: T | i32) -> i32 { return match move value { T t => { drop t return 1 } i32 n => n } }
fn tokens<'data>(drops: &'data mut i32, flag: bool) -> Token<'data> | bool {
  if flag { return Token { drops: move drops } }
  return false
}

fn spend<'data>(drops: &'data mut i32) -> i32 { return hold<Token<'data> | bool>(tokens(move drops, true)) }

pub fn main() -> i32 {
  if pick<A>(A { v: 5 }) != 1 { return 1 }
  if side<A, A>(either<A, A>(false, A { v: 1 }, A { v: 2 })) != 1 { return 2 }
  if kind<A | B>(make(true)) != 1 { return 3 }
  if score(keep<A | B>(make(false))) != 2 { return 4 }
  if score(keep<A | B>(C { x: 3 })) != 3 { return 5 }
  let mut drops = 0
  if spend(&mut drops) != 1 { return 6 }
  if drops != 1 { return 7 }
  return 42
}
