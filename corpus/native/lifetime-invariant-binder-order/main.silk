// Inference does not depend on whether the invariant position of a binder comes first.
struct Holder<'h> {
  view: &'h i32
}

fn stash<'a>(src: &'a i32, out: &mut Holder<'a>) -> () {
  out.view = src
}

fn stashLast<'a>(out: &mut Holder<'a>, src: &'a i32) -> () {
  out.view = src
}

pub fn main() -> i32 {
  let a = 40
  let b = 2
  let c = 0
  let mut h = Holder {view: &c}
  let mut g = Holder {view: &c}
  stash(&a, &mut h)
  stashLast(&mut g, &b)
  return h.view.* + g.view.*
}
