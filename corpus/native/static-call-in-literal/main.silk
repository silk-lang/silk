import silk.concurrency.sync { Arc }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.io.logger { InMemoryLogger, Logger }

// Anonymous functions and `effect {}` blocks call functions with `static` parameters: the
// enclosing body's selection pass supplies their static arguments, as it does for its own calls.
fn labeled(static label: string<'static>, value: i32) -> i32 {
  if label == "add" { return value + 1 }
  return value
}

static fn base() -> i32 {
  return 10
}

effect fn twenty() -> i32 {
  return 20
}

effect fn program() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let loggerProvider = run Logger.inMemoryProvider() |> Effect.provideMut<Allocator>(&mut allocator)
  let logger = run Arc<InMemoryLogger>.make(move loggerProvider) |> Effect.provideMut<Allocator>(&mut allocator)
  let add = |value: i32| -> i32 { return labeled("add", value) + base() }
  if add(1) != 12 { return 1 }
  let block = effect { return labeled("keep", 5) }
  let kept = run block
  if kept != 5 { return 2 }
  let nested = |value: i32| -> i32 {
    let inner = |other: i32| -> i32 { return labeled("add", other) }
    return inner(value)
  }
  if nested(2) != 3 { return 3 }
  run twenty()
    |> Effect.flatMap(effect |value: i32| -> () {
      return run Effect.log("got {}", &.(value))
    })
    |> Effect.provideAmbient<Logger>(&logger)
  if Logger.length(logger.get()) != 1 || Logger.messageLengthAt(logger.get(), 0) != 6 { return 4 }
  if Logger.messageByteAt(logger.get(), 0, 4) != '2' || Logger.messageByteAt(logger.get(), 0, 5) != '0' { return 5 }
  return 42
}

effect fn failed(error: OutOfMemoryError) -> i32 { return 6 }

pub fn main() -> i32 {
  return run Effect.catchAll(program(), failed)
}
