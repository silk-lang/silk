import silk.core.effect { Effect }
import silk.io.logger { LogError, Logger }

// Anonymous functions and `effect {}` blocks call functions with `static` parameters: the
// enclosing body's selection pass supplies their static arguments, as it does for its own calls.
fn labeled(static label: string<'static>, value: i32) -> i32 {
  if label == "add" { return value + 1 }
  return value
}

static fn base() -> i32 {
  return 10
}

effect fn twenty() -> i32 {
  return 20
}

effect fn program() -> i32 ! LogError {
  let mut logger = Logger.inMemoryProvider()
  let add = fn(value: i32) -> i32 { return labeled("add", value) + base() }
  if add(1) != 12 { return 1 }
  let block = effect { return labeled("keep", 5) }
  let kept = run block
  if kept != 5 { return 2 }
  let nested = fn(value: i32) -> i32 {
    let inner = fn(other: i32) -> i32 { return labeled("add", other) }
    return inner(value)
  }
  if nested(2) != 3 { return 3 }
  run twenty()
    |> Effect.flatMap(effect fn(value: i32) -> () ! LogError ? &mut Logger {
      return run Effect.log("got {}", &(value,))
    })
    |> Effect.provideMut<Logger>(&mut logger)
  if Logger.length(&logger) != 1 || Logger.messageLengthAt(&logger, 0) != 6 { return 4 }
  if Logger.messageByteAt(&logger, 0, 4) != '2' || Logger.messageByteAt(&logger, 0, 5) != '0' { return 5 }
  return 42
}

effect fn failed(error: LogError) -> i32 { return 6 }

pub fn main() -> i32 {
  return run Effect.catchAll(program(), failed)
}
