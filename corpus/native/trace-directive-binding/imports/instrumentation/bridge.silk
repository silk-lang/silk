unsafe extern "C" fn trace_value(value: i32) -> ()
pub fn begin<Args>(static name: string<'static>, static kind: string<'static>, static function: string<'static>,
  static file: string<'static>, static packageName: string<'static>, static packageVersion: string<'static>, args: &Args) -> i32 {
  if name != "custom" || kind != "producer" || function != "memory/driver.marked" { return 1 }
  if file != "memory/driver.silk" || packageName != "corpus" || packageVersion != "0.1.0" { return 2 }
  unsafe trace_value(1)
  return 42
}
pub fn end(guard: i32) -> () { unsafe trace_value(guard) }
pub fn error(static name: string<'static>) -> () { unsafe trace_value(-1) }
pub fn abandon(guard: i32) -> () { unsafe trace_value(-1) }
