import silk.core.effect { Effect }
import silk.io.logger { LogError, Logger }

// A generic runner given an `effect {}` block, in a body that also calls a function with a static
// template, runs the block: the block reads its body from the caller's selected application.
effect fn again<'env, A, E, ?R>(mut action: mut Effect<'env; A ! E ? R>) -> A ! E ? R {
  return run action
}

effect fn runOnce<'env, A, E, ?R>(action: once Effect<'env; A ! E ? R>) -> A ! E ? R {
  return run action
}

effect fn one() -> i32 {
  return 1
}

effect fn program() -> i32 ! LogError {
  let mut logger = Logger.inMemoryProvider()
  let value = run again(effect { return run one() })
  let other = run runOnce(effect {
    let first = run one()
    return first + 1
  })
  run Effect.log("{v} {o}", &.{ v: value, o: other }) |> Effect.provideMut<Logger>(&mut logger)
  if Logger.length(&logger) != 1 || Logger.messageLengthAt(&logger, 0) != 3 { return 1 }
  if Logger.messageByteAt(&logger, 0, 0) != '1' || Logger.messageByteAt(&logger, 0, 2) != '2' { return 2 }
  return 40 + value + other - 1
}

effect fn failed(error: LogError) -> i32 { return 3 }

pub fn main() -> i32 {
  return run Effect.catchAll(program(), failed)
}
