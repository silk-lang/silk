import silk.concurrency.sync { Arc }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.io.logger { InMemoryLogger, Logger }

// A generic runner given an `effect {}` block, in a body that also calls a function with a static
// template, runs the block: the block reads its body from the caller's selected application.
effect fn again<'env, A, E, ?R>(mut action: mut Effect<'env; A ! E ? R>) -> A ! E ? R {
  return run action
}

effect fn runOnce<'env, A, E, ?R>(action: once Effect<'env; A ! E ? R>) -> A ! E ? R {
  return run action
}

effect fn one() -> i32 {
  return 1
}

effect fn program() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let loggerProvider = run Logger.inMemoryProvider() |> Effect.provideMut<Allocator>(&mut allocator)
  let logger = run Arc<InMemoryLogger>.make(move loggerProvider) |> Effect.provideMut<Allocator>(&mut allocator)
  let value = run again(effect { return run one() })
  let other = run runOnce(effect {
    let first = run one()
    return first + 1
  })
  run Effect.log("{v} {o}", &.{ v: value, o: other }) |> Effect.provideAmbient<Logger>(&logger)
  if Logger.length(logger.get()) != 1 || Logger.messageLengthAt(logger.get(), 0) != 3 { return 1 }
  if Logger.messageByteAt(logger.get(), 0, 0) != '1' || Logger.messageByteAt(logger.get(), 0, 2) != '2' { return 2 }
  return 40 + value + other - 1
}

effect fn failed(error: OutOfMemoryError) -> i32 { return 3 }

pub fn main() -> i32 {
  return run Effect.catchAll(program(), failed)
}
