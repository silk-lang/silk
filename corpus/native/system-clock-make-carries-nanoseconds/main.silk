import silk.system.system_clock { SystemClock }
import silk.platform.windows.time { WindowsTime }

pub fn main() -> i32 {
  let whole = SystemClock.make(0, 5000000000)
  if SystemClock.seconds(&whole) != 5 || SystemClock.nanoseconds(&whole) != 0 {
    return 1
  }
  let before = SystemClock.make(0, -1)
  if SystemClock.seconds(&before) != -1 || SystemClock.nanoseconds(&before) != 999999999 {
    return 2
  }
  let back = SystemClock.make(10, -2500000000)
  if SystemClock.seconds(&back) != 7 || SystemClock.nanoseconds(&back) != 500000000 {
    return 3
  }
  // FILETIME epoch and its unsigned range are independent of the host running this corpus.
  let epoch = WindowsTime.fileTime(116444736000000000)
  if SystemClock.seconds(&epoch) != 0 || SystemClock.nanoseconds(&epoch) != 0 { return 4 }
  let preEpoch = WindowsTime.fileTime(116444735999999999)
  if SystemClock.seconds(&preEpoch) != -1 || SystemClock.nanoseconds(&preEpoch) != 999999900 { return 5 }
  let first = WindowsTime.fileTime(0)
  if SystemClock.seconds(&first) != -11644473600 || SystemClock.nanoseconds(&first) != 0 { return 6 }
  let last = WindowsTime.fileTime(18446744073709551615)
  if SystemClock.seconds(&last) != 1833029933770 || SystemClock.nanoseconds(&last) != 955161500 { return 7 }
  // Fractional ticks round down; a large counter must not first become total nanoseconds.
  let third = WindowsTime.counter(5, 3)
  if SystemClock.seconds(&third) != 1 || SystemClock.nanoseconds(&third) != 666666666 { return 8 }
  let longRun = WindowsTime.counter(9223372036854775807, 1)
  if SystemClock.seconds(&longRun) != 9223372036854775807 || SystemClock.nanoseconds(&longRun) != 0 { return 9 }
  let highFrequency = WindowsTime.counter(9223372036854775806, 9223372036854775807)
  if SystemClock.seconds(&highFrequency) != 0 || SystemClock.nanoseconds(&highFrequency) != 999999999 { return 10 }
  let half = WindowsTime.counter(4611686018427387903, 9223372036854775807)
  if SystemClock.nanoseconds(&half) != 499999999 { return 11 }
  if WindowsTime.counterResolution(3) != 333333334 || WindowsTime.counterResolution(2000000000) != 1 { return 12 }
  if WindowsTime.sleepMilliseconds(0, 0) != 0 || WindowsTime.sleepMilliseconds(0, 1) != 1 { return 13 }
  if WindowsTime.sleepMilliseconds(1, 999999999) != 2000 { return 14 }
  if WindowsTime.sleepMilliseconds(4294967, 294000000) != 4294967294 { return 15 }
  if WindowsTime.sleepMilliseconds(4294967, 294000001) != 4294967294 { return 16 }
  if WindowsTime.sleepMilliseconds(9223372036854775807, 999999999) != 4294967294 { return 17 }
  return 0
}
