//! A field owns only a `///` block on the lines directly above it, so a struct's own comment or a
//! neighbouring field's comment never becomes its documentation.

import silk.core.reflect { Reflect }
import silk.core.static_text { StaticText }

/// A point.
struct Point { pub x: u32, pub y: u32 }

struct Pair {
  /// First.
  pub first: u32, pub second: u32,
}

static fn docs() -> string<'static> {
  let mut all = ""
  static for field in Reflect.fields<Point>() {
    all = StaticText.concat(StaticText.concat(all, Reflect.fieldDoc(field)), "|")
  }
  static for field in Reflect.fields<Pair>() {
    all = StaticText.concat(StaticText.concat(all, Reflect.fieldDoc(field)), "|")
  }
  return all
}

pub fn main() -> i32 {
  static if docs() != "||First.||" { compileError("field documentation attachment") }
  return 12
}
