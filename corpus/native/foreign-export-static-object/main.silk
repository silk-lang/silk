export "C" static exported: i32 = 40
export "C" static scale: f64 as "silk_test_export_scale" = 0.5
unsafe extern "C" static seen: i32 as "exported"
unsafe extern "C" static half: f64 as "silk_test_export_scale"
pub fn main() -> i32 {
  unsafe {
    if exported != 40 { return 1 }
    if half != 0.5 { return 2 }
    return seen + 2
  }
}
