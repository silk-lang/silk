// `while let P = e { body }` repeats `body` while `e` matches `P`, and ends at the first mismatch.
import silk.core.option {Option}
struct Token { value: i32 }
union Step { Take { amount: i32 }, Skip, Done }
enum Light { Red, Green }
struct Counter { left: i32 }
fn countdown(counter: &mut Counter) -> Option<i32> {
  if counter.*.left == 0 { return Option<i32>.none() }
  counter.*.left = counter.*.left - 1
  return Option<i32>.some(counter.*.left)
}
// The subject is evaluated again before every iteration; the owned result is consumed each time.
fn drained(start: i32) -> i32 {
  let mut counter = Counter { left: start }
  let mut total = 0
  while let Option<i32>.Some { value } = move countdown(&mut counter) {
    total = total + value
  }
  return total
}
// A consuming subject must be restored before the next iteration (LOOP-001).
fn consumed(steps: i32) -> i32 {
  let mut current = Option<Token>.some(Token { value: steps })
  let mut seen = 0
  while let Option<Token>.Some { value: token } = move current {
    seen = seen + token.value
    current = Option<Token>.none()
    if token.value > 1 { current = Option<Token>.some(Token { value: token.value - 1 }) }
  }
  return seen
}
// A shared subject preserves its owner; each iteration's bindings are new loans.
fn shared(step: Step) -> i32 {
  let mut rounds = 0
  while let Step.Take { amount } = &step {
    rounds = rounds + amount
    if rounds > 20 { break }
  }
  return rounds
}
// `continue` re-tests the subject; `break` leaves the loop.
fn transfers(limit: i32) -> i32 {
  let mut counter = Counter { left: limit }
  let mut odd = 0
  while let Option<i32>.Some { value } = move countdown(&mut counter) {
    if value == 1 { break }
    if value % 2 == 0 { continue }
    odd = odd + 1
  }
  return odd
}
// An exclusive subject lets the body write through the binding.
fn exclusive() -> i32 {
  let mut held = Step.Take { amount: 3 }
  let mut writes = 0
  while let Step.Take { amount } = &mut held {
    amount = amount - 1
    writes = writes + 1
    if amount == 0 { held = Step.Done }
  }
  return writes
}
// A scalar enum subject selects members like the equivalent `if let`.
fn lights() -> i32 {
  let mut light = Light.Green
  let mut changes = 0
  while let Light.Green = light {
    changes = changes + 1
    light = Light.Red
  }
  return changes
}
// Nested pattern loops each end at their own mismatch.
fn nested(outer: i32) -> i32 {
  let mut rows = Counter { left: outer }
  let mut cells = 0
  while let Option<i32>.Some { value: row } = move countdown(&mut rows) {
    let mut columns = Counter { left: row }
    while let Option<i32>.Some { .. } = move countdown(&mut columns) { cells = cells + 1 }
  }
  return cells
}
pub fn main() -> i32 {
  if drained(4) != 6 { return 1 }
  if consumed(3) != 6 { return 2 }
  if shared(Step.Take { amount: 7 }) != 21 || shared(Step.Skip) != 0 { return 3 }
  if transfers(8) != 3 { return 4 }
  if exclusive() != 3 { return 5 }
  if lights() != 1 { return 6 }
  if nested(4) != 6 { return 7 }
  return 42
}
