// Tree payloads, original-source spans, borrowing, normalization, limits, and bounded hostile input.
import silk.markdown.document {
  MarkdownDocument,
  MarkdownNodeId,
  MarkdownNodeKind,
  MarkdownOptions
}
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.collections.bytes { Bytes }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.text.string { String }

struct CheckFailed {
  code: i32
}

effect fn expect(ok: bool, code: i32) -> ()
  ! CheckFailed {
  if !ok {
    fail CheckFailed { code: code }
  }
}

fn index(id: Option<MarkdownNodeId>) -> usize {
  return match id {
    Option<MarkdownNodeId>.Some { value } => value.index
    _ => 999999
  }
}

fn find(doc: &MarkdownDocument<'_>, kind: MarkdownNodeKind, occurrence: usize) -> MarkdownNodeId {
  let nodes = MarkdownDocument.nodes(doc)
  let mut count: usize = 0
  let mut i: usize = 0
  while i < nodes.length {
    if nodes[i].kind == kind {
      if count == occurrence {
        return MarkdownNodeId { index: i }
      }
      count = count + 1
    }
    i = i + 1
  }
  return MarkdownNodeId { index: 999999 }
}

fn spelling<'a>(doc: &MarkdownDocument<'_>, id: MarkdownNodeId, source: string<'a>) -> string<'a> {
  let span = MarkdownDocument.span(doc, id)
  return String.slice(source, span.start, span.end - span.start)
}

fn address(value: string) -> usize {
  return Pointer.addressMany<u8>(Pointer.fromSlice<u8>(String.utf8Bytes(value)))
}

effect fn checks() -> ()
  ! CheckFailed | OutOfMemoryError
  ? &mut Allocator {
  let source = "# Heading\n\n> - quote *em*\n>   continuation\nlazy\n\n---\n\n3) first\n\n4) second\n\n``` lang&amp; meta\ncode\n```\n\n    indent\n\n<div>raw</div>\n\ntext **strong** ` code ` [link](/target \"title\") ![alt](img) <i>x</i>\nsoft  \nhard\n\n[a]: /ref 'reference'\n\n[a] &amp;&#x1f600; \\* \u{0}\n"
  let doc = run MarkdownDocument.parse(source)
  let expected: [MarkdownNodeKind; 18] = [
    MarkdownNodeKind.Document,
    MarkdownNodeKind.Paragraph,
    MarkdownNodeKind.Heading,
    MarkdownNodeKind.ThematicBreak,
    MarkdownNodeKind.BlockQuote,
    MarkdownNodeKind.List,
    MarkdownNodeKind.ListItem,
    MarkdownNodeKind.CodeBlock,
    MarkdownNodeKind.HtmlBlock,
    MarkdownNodeKind.Text,
    MarkdownNodeKind.SoftBreak,
    MarkdownNodeKind.HardBreak,
    MarkdownNodeKind.Code,
    MarkdownNodeKind.Emphasis,
    MarkdownNodeKind.Strong,
    MarkdownNodeKind.Link,
    MarkdownNodeKind.Image,
    MarkdownNodeKind.HtmlInline,
  ]
  let mut i: usize = 0
  while i < 18 {
    run expect(find(&doc, expected[i], 0).index < MarkdownDocument.nodes(&doc).length, 1)
    i = i + 1
  }
  let root = MarkdownDocument.root(&doc)
  let heading = find(&doc, MarkdownNodeKind.Heading, 0)
  run expect(
    index(MarkdownDocument.firstChild(&doc, root)) == heading.index
      && MarkdownDocument.headingLevel(&doc, heading) == 1,
    2,
  )
  let quote = find(&doc, MarkdownNodeKind.BlockQuote, 0)
  run expect(
    index(MarkdownDocument.nextSibling(&doc, heading)) == quote.index
      && index(MarkdownDocument.previousSibling(&doc, quote)) == heading.index
      && index(MarkdownDocument.parent(&doc, quote)) == root.index,
    3,
  )
  let quoteParagraph = find(&doc, MarkdownNodeKind.Paragraph, 0)
  run expect(spelling(&doc, quoteParagraph, source) == "quote *em*\n>   continuation\nlazy\n", 4)
  let emphasis = find(&doc, MarkdownNodeKind.Emphasis, 0)
  run expect(spelling(&doc, emphasis, source) == "*em*", 5)
  run expect(spelling(&doc, quote, source) == "> - quote *em*\n>   continuation\nlazy\n", 6)
  let list = find(&doc, MarkdownNodeKind.List, 0)
  let loose = find(&doc, MarkdownNodeKind.List, 1)
  run expect(
    !MarkdownDocument.ordered(&doc, list) && MarkdownDocument.tight(&doc, list)
      && MarkdownDocument.marker(&doc, list) == 45,
    7,
  )
  run expect(
    MarkdownDocument.ordered(&doc, loose) && MarkdownDocument.start(&doc, loose) == 3
      && !MarkdownDocument.tight(&doc, loose)
      && MarkdownDocument.marker(&doc, loose) == 41,
    8,
  )
  let code = find(&doc, MarkdownNodeKind.CodeBlock, 0)
  let indented = find(&doc, MarkdownNodeKind.CodeBlock, 1)
  run expect(
    MarkdownDocument.isFenced(&doc, code) && MarkdownDocument.info(&doc, code) == "lang& meta"
      && MarkdownDocument.literal(&doc, code) == "code\n",
    9,
  )
  run expect(
    !MarkdownDocument.isFenced(&doc, indented)
      && MarkdownDocument.literal(&doc, indented) == "indent\n",
    10,
  )
  let link = find(&doc, MarkdownNodeKind.Link, 0)
  run expect(
    MarkdownDocument.destination(&doc, link) == "/target"
      && match MarkdownDocument.title(&doc, link) {
        Option<string>.Some { value } => value == "title"
        _ => false
      },
    11,
  )
  let reference = find(&doc, MarkdownNodeKind.Link, 1)
  run expect(
    MarkdownDocument.destination(&doc, reference) == "/ref"
      && match MarkdownDocument.title(&doc, reference) {
        Option<string>.Some { value } => value == "reference"
        _ => false
      },
    12,
  )
  let invalid = MarkdownNodeId { index: 999999 }
  run expect(
    MarkdownDocument.headingLevel(&doc, root) == 0 && MarkdownDocument.info(&doc, link) == ""
      && MarkdownDocument.marker(&doc, code) == 0
      && MarkdownDocument.literal(&doc, root) == ""
      && MarkdownDocument.destination(&doc, root) == ""
      && index(MarkdownDocument.parent(&doc, root)) == 999999
      && index(MarkdownDocument.lastChild(&doc, invalid)) == 999999
      && MarkdownDocument.span(&doc, invalid).end == 0,
    13,
  )

  // A plain node points into the caller's source; trimmed code can retain a source view too.
  let owned = run String.copy("plain ` code `")
  let plainSource = String.view(&owned)
  let plain = run MarkdownDocument.parse(plainSource)
  let first = find(&plain, MarkdownNodeKind.Text, 0)
  run expect(address(MarkdownDocument.literal(&plain, first)) == address(plainSource), 14)
  let inlineCode = find(&plain, MarkdownNodeKind.Code, 0)
  run expect(
    MarkdownDocument.literal(&plain, inlineCode) == "code"
      && address(MarkdownDocument.literal(&plain, inlineCode))
        == address(String.slice(plainSource, 8, 4)),
    15,
  )
  let normalized = run MarkdownDocument.parse("a\\*b &amp;&#0; ` x\ny `")
  run expect(
    MarkdownDocument.literal(&normalized, find(&normalized, MarkdownNodeKind.Code, 0)) == "x y",
    16,
  )
  let mut literal = Bytes.make()
  i = 0
  while i < MarkdownDocument.nodes(&normalized).length {
    let id = MarkdownNodeId { index: i }
    if MarkdownDocument.kind(&normalized, id) == MarkdownNodeKind.Text {
      run Bytes.append(&mut literal, String.utf8Bytes(MarkdownDocument.literal(&normalized, id)))
    }
    i = i + 1
  }
  run expect(unsafe String.fromUtf8Unchecked(Bytes.asSlice(&literal)) == "a*b &\u{fffd} ", 17)
  let mut options = MarkdownOptions.make()
  options.maxNesting = 1
  let bounded = run MarkdownDocument.parseWithOptions("> > literal\n\n***nested***", &options)
  run expect(
    find(&bounded, MarkdownNodeKind.BlockQuote, 1).index == 999999
      && find(&bounded, MarkdownNodeKind.Strong, 0).index < 999999
      && find(&bounded, MarkdownNodeKind.Emphasis, 0).index == 999999,
    18,
  )

  options.maxNesting = 0
  let flat = run MarkdownDocument.parseWithOptions("<http://a> [x](b) *x*", &options)
  run expect(
    find(&flat, MarkdownNodeKind.Link, 0).index == 999999
      && find(&flat, MarkdownNodeKind.Emphasis, 0).index == 999999,
    23,
  )
  let splitSource = "> *a\r\n> b*\r\n"
  let split = run MarkdownDocument.parse(splitSource)
  run expect(
    spelling(&split, find(&split, MarkdownNodeKind.Emphasis, 0), splitSource) == "*a\r\n> b*",
    20,
  )
  let references = run MarkdownDocument.parse("[a]: /x\ntext\n")
  run expect(
    spelling(&references, find(&references, MarkdownNodeKind.Paragraph, 0), "[a]: /x\ntext\n")
      == "text\n",
    21,
  )
  i = 1
  while i < MarkdownDocument.nodes(&doc).length {
    let id = MarkdownNodeId { index: i }
    run expect(index(MarkdownDocument.parent(&doc, id)) < i, 22)
    i = i + 1
  }

  // Repeated special bytes and unmatched backtick lengths terminate without syntax errors.
  let mut hostile = Bytes.make()
  i = 0
  while i < 4096 {
    run Bytes.append(&mut hostile, b"[")
    i = i + 1
  }
  let hostileDocument = run MarkdownDocument.parse(
    unsafe String.fromUtf8Unchecked(Bytes.asSlice(&hostile)),
  )
  run expect(
    MarkdownDocument.nodes(&hostileDocument).length == 3
      && MarkdownDocument.literal(&hostileDocument, MarkdownNodeId { index: 2 })
        == unsafe String.fromUtf8Unchecked(Bytes.asSlice(&hostile)),
    19,
  )
}

effect fn failure(error: CheckFailed | OutOfMemoryError) -> i32 {
  return match move error {
    CheckFailed { code } => code
    OutOfMemoryError _ => 255
  }
}

pub effect fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(
    effect {
      run checks()
      return 0
    },
    failure,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
}
