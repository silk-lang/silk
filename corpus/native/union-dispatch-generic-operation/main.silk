interface Select {
  fn choose<T>(self: &Self, static before: bool, left: T, right: T) -> T
}

struct First {}
struct Last {}

impl Select for First {
  fn choose<T>(self: &Self, static before: bool, left: T, right: T) -> T {
    if before { return move left }
    return move right
  }
}

impl Select for Last {
  fn choose<T>(self: &Self, static before: bool, left: T, right: T) -> T {
    if before { return move right }
    return move left
  }
}

fn exercise(value: &(First | Last)) -> i32 {
  let number = Select.choose(value, true, 10, 30)
  let other = Select.choose(value, false, 10, 30)
  if number == other { return 0 }
  if Select.choose(value, false, false, true) { return number + 2 }
  return number
}

pub fn main() -> i32 {
  let first: First | Last = First {}
  let last: First | Last = Last {}
  if exercise(&first) != 12 || exercise(&last) != 30 { return 1 }
  return 42
}
