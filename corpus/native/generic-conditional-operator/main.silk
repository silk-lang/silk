// A generic body uses an operator whose conformance holds only under the body's own bounds, in a
// bounded generic function and in a bounded inherent block alike.
import silk.core.ownership { Copy }
import silk.core.ops { Add, Multiply }

struct Point<T> {
  x: T,
  y: T,
}

impl<T: Copy> Copy for Point<T> {}

impl<T: Copy + Add<T, T>> Add<Point<T>, Point<T>> for Point<T> {
  fn add(left: Self, right: Point<T>) -> Point<T> { return Point<T> { x: left.x + right.x, y: left.y + right.y } }
}

struct Scale<T> {
  k: T,
}

impl<T: Copy> Copy for Scale<T> {}

impl<T: Copy + Multiply<T, T>> Multiply<Point<T>, Point<T>> for Scale<T> {
  fn multiply(left: Self, right: Point<T>) -> Point<T> { return Point<T> { x: left.k * right.x, y: left.k * right.y } }
}

fn lerp<T: Copy + Add<T, T> + Multiply<T, T>>(a: Point<T>, b: Point<T>, s: T, t: T) -> Point<T> {
  return Scale<T> { k: s } * a + Scale<T> { k: t } * b
}

impl<T: Copy + Multiply<T, T>> Scale<T> {
  fn apply(self: Self, point: Point<T>) -> Point<T> { return self * point }
}

pub fn main() -> i32 {
  let mixed = lerp<i32>(Point<i32> { x: 1, y: 2 }, Point<i32> { x: 10, y: 20 }, 2, 3)
  let scaled = Scale<i32> { k: 3 }.apply(Point<i32> { x: 1, y: 2 })
  return mixed.x + mixed.y - scaled.x - scaled.y
}
