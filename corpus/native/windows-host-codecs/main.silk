import silk.platform.windows.wtf8 { Wtf8, Wtf8Point, InvalidWtf8 }
import silk.platform.windows.command_line { CommandLine }
import silk.platform.windows.environment { EnvironmentEntry }
import silk.platform.windows.path { WindowsPath }
import silk.system.filesystem { Path, FileError, FileSystem }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.host_input { HostInputError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.text.string { String }
import silk.core.result { Result }
import silk.text.string { InvalidUtf8 }

fn equal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at: usize = 0
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + 1
  }
  return true
}

effect fn codec(units: &[u16], expected: &[u8]) -> bool
  ! InvalidWtf8 | OutOfMemoryError ? &mut Allocator {
  let encoded = run Wtf8.encode(units)
  if !equal(Bytes.asSlice(&encoded), expected) { return false }
  // Decode the independently specified bytes, not the encoder's result.
  let decoded = run Wtf8.decodeBytes(expected)
  let actual = List<u16>.asSlice(&decoded)
  if actual.length != units.length { return false }
  let mut at: usize = 0
  while at < units.length {
    if actual[at] != units[at] { return false }
    at = at + 1
  }
  return true
}

fn rejected(bytes: &[u8]) -> bool {
  return match move Wtf8.pointBytes(bytes, 0) {
    Option<Wtf8Point>.None => true
    Option<Wtf8Point>.Some { value } => false
  }
}

fn delimiter(units: &[u16], expected: usize) -> bool {
  return match move EnvironmentEntry.separator(units) {
    Option<usize>.Some { value } => value == expected
    Option<usize>.None => false
  }
}

fn malformedEntry(units: &[u16]) -> bool {
  return match move EnvironmentEntry.separator(units) {
    Option<usize>.Some { value } => false
    Option<usize>.None => true
  }
}

effect fn parsed(units: &[u16], expected: &[&[u8]]) -> bool
  ! HostInputError | OutOfMemoryError ? &mut Allocator {
  let args = run CommandLine.parse(units)
  let values = List<Bytes>.asSlice(&args)
  if values.length != expected.length { return false }
  let mut at: usize = 0
  while at < values.length {
    if !equal(Bytes.asSlice(&values[at]), expected[at]) { return false }
    at = at + 1
  }
  return true
}

effect fn nulRejected(error: HostInputError) -> bool { return true }
effect fn encoded(program: &[u16], arguments: &[u16], expected: &[u16]) -> bool
  ! HostInputError | OutOfMemoryError ? &mut Allocator {
  let result = run CommandLine.encode(program, arguments)
  let actual = List<u16>.asSlice(&result)
  if actual.length != expected.length { return false }
  let mut at: usize = 0
  while at < actual.length {
    if actual[at] != expected[at] { return false }
    at = at + 1
  }
  return true
}

effect fn invalidProgram() -> bool ! HostInputError | OutOfMemoryError ? &mut Allocator {
  let result = run CommandLine.encode(&[69, 34], &[])
  return false
}

effect fn unterminatedArguments() -> bool ! HostInputError | OutOfMemoryError ? &mut Allocator {
  let result = run CommandLine.encode(&[69], &[65])
  return false
}

effect fn oversizedCommand() -> bool ! HostInputError | OutOfMemoryError ? &mut Allocator {
  let program: [u16; 32765] = [65; 32765]
  let result = run CommandLine.encode(&program, &[])
  return false
}

effect fn commandLimit() -> bool ! HostInputError | OutOfMemoryError ? &mut Allocator {
  let program: [u16; 32764] = [65; 32764]
  let result = run CommandLine.encode(&program, &[])
  let units = List<u16>.asSlice(&result)
  return units.length == 32767 && units[32764] == 65 && units[32765] == 34 && units[32766] == 0
}

effect fn parseNul() -> bool ! HostInputError | OutOfMemoryError ? &mut Allocator {
  let args = run CommandLine.parse(&[65, 0, 66])
  return false
}

effect fn pathSpelling(native: string, portable: string, extended: string) -> bool
! FileError | OutOfMemoryError ? &mut Allocator {
  let converted = run WindowsPath.fromNative(native)
  if !equal(Path.rawBytes(&converted), String.utf8Bytes(portable)) { return false }
  // Encode an independently authored portable path, not the previous conversion's result.
  let specified = run Path.make(portable)
  let result = run WindowsPath.toNativeBytes(&specified)
  return equal(Bytes.asSlice(&result), String.utf8Bytes(extended))
}

effect fn rejectedPath(error: FileError) -> bool { return true }
effect fn relativeDrive() -> bool ! FileError | OutOfMemoryError ? &mut Allocator {
  let path = run WindowsPath.fromNative("C:relative")
  return false
}
effect fn devicePath() -> bool ! FileError | OutOfMemoryError ? &mut Allocator {
  let path = run WindowsPath.fromNative("\\\\.\\pipe\\silk")
  return false
}

effect fn resolvesPath(base: string, argument: string, expected: string) -> bool
! FileError | OutOfMemoryError ? &mut Allocator {
  let working = run Path.make(base)
  let result = run WindowsPath.resolve(&working, argument)
  return equal(Path.rawBytes(&result), String.utf8Bytes(expected))
}

effect fn refusesResolution(base: string, argument: string) -> bool
! FileError | OutOfMemoryError ? &mut Allocator {
  let working = run Path.make(base)
  return match move run Effect.result(WindowsPath.resolve(&working, argument)) {
    Result<Path, FileError | OutOfMemoryError>.Success {value} => false
    Result<Path, FileError | OutOfMemoryError>.Failure {error} => match move error {
      FileError failure => failure.reason.code == FileSystem.invalidPath().code
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

effect fn check() -> i32 ! FileError | HostInputError | InvalidWtf8 | OutOfMemoryError ? &mut Allocator {
  // Literal UTF-16/code-point boundaries, independently specified bytes.
  if !(run codec(&[0, 127, 128, 2047, 2048, 65535], &[0, 127, 194, 128, 223, 191, 224, 160, 128, 239, 191, 191])) { return 1 }
  if !(run codec(&[55296, 56320, 56319, 57343], &[240, 144, 128, 128, 244, 143, 191, 191])) { return 2 }
  if !(run codec(&[55296, 65, 57343, 55296], &[237, 160, 128, 65, 237, 191, 191, 237, 160, 128])) { return 3 }
  if !(run codec(&[56320, 55296], &[237, 176, 128, 237, 160, 128])) { return 4 }
  // Zig 0.15.2's noncanonical surrogate-pair example must be rejected, not silently normalized.
  if !rejected(&[237, 160, 189, 237, 178, 169]) { return 5 }
  if !rejected(&[192, 128]) || !rejected(&[224, 128, 128]) || !rejected(&[240, 128, 128, 128]) { return 6 }
  if !rejected(&[244, 144, 128, 128]) || !rejected(&[245, 128, 128, 128]) { return 7 }
  if !rejected(&[128]) || !rejected(&[226, 65, 128]) || !rejected(&[240, 144, 128]) { return 8 }
  let lone = run Wtf8.encode(&[55296])
  let invalidText = match move String.fromUtf8(Bytes.asSlice(&lone)) {
    Result<string, InvalidUtf8>.Failure { error } => true
    Result<string, InvalidUtf8>.Success { value } => false
  }
  if !invalidText { return 9 }
  // Literal UTF-16 inputs: no argument encoder supplies these expected parse results.
  if !(run parsed(&[], &[b""])) { return 10 }
  if !(run parsed(&[32, 9, 65, 32], &[b"", b"A"])) { return 11 }
  // argv[0]: quotes toggle even after a backslash; doubled quotes do not emit a quote.
  if !(run parsed(&[34, 69, 92, 34, 32, 65], &[b"E\\", b"A"])) { return 12 }
  if !(run parsed(&[69, 34, 34, 88, 69, 32, 34, 34], &[b"EXE", b""])) { return 13 }
  // Odd slash parity escapes the quote; even parity opens a quoted span.
  if !(run parsed(&[69, 32, 97, 92, 92, 92, 34, 98, 32, 99], &[b"E", b"a\\\"b", b"c"])) { return 14 }
  if !(run parsed(&[69, 32, 97, 92, 92, 34, 98, 32, 99, 34], &[b"E", b"a\\b c"])) { return 15 }
  // Doubled quote in a quoted argument, unmatched quote, and non-separator newline.
  if !(run parsed(&[69, 32, 34, 97, 34, 34, 32, 98], &[b"E", b"a\" b"])) { return 16 }
  if !(run parsed(&[69, 32, 97, 10, 98, 9, 34], &[b"E", b"a\nb", b""])) { return 17 }
  // Literal backslashes without a following quote and raw surrogate arguments.
  if !(run parsed(&[69, 32, 92, 92, 32, 55296, 32, 55357, 56489], &[b"E", b"\\\\", b"\xed\xa0\x80", b"\xf0\x9f\x92\xa9"])) { return 18 }
  if !(run Intrinsic.catchFailure<HostInputError>(parseNul(), nulRejected)) { return 19 }
  // The initial equals sign is part of a hidden drive name, not its separator.
  if !delimiter(&[61, 67, 58, 61, 67, 58, 92], 3) { return 20 }
  if !delimiter(&[65, 61], 1) || !delimiter(&[65, 61, 66, 61, 67], 1) { return 21 }
  if !malformedEntry(&[61, 65]) || !malformedEntry(&[65, 61, 0]) || !malformedEntry(&[]) { return 22 }
  // Rust's fixed from_wide table: a lone high surrogate immediately before a valid pair.
  if !(run codec(&[55357, 55357, 56489], &[237, 160, 189, 240, 159, 146, 169])) { return 23 }
  // Literal command-line oracles, independent of CommandLine.parse.
  if !(run encoded(&[69, 32, 92], &[], &[34, 69, 32, 92, 34, 0])) { return 24 }
  if !(run encoded(&[69], &[0, 65, 32, 66, 0], &[34, 69, 34, 32, 34, 34, 32, 34, 65, 32, 66, 34, 0])) { return 25 }
  if !(run encoded(&[69], &[92, 34, 92, 0], &[34, 69, 34, 32, 34, 92, 92, 92, 34, 92, 92, 34, 0])) { return 26 }
  if !(run encoded(&[69], &[55296, 9, 10, 38, 124, 37, 0], &[34, 69, 34, 32, 34, 55296, 9, 10, 38, 124, 37, 34, 0])) { return 27 }
  if !(run Intrinsic.catchFailure<HostInputError>(invalidProgram(), nulRejected)) { return 28 }
  if !(run Intrinsic.catchFailure<HostInputError>(unterminatedArguments(), nulRejected)) { return 29 }
  if !(run commandLimit()) { return 30 }
  if !(run Intrinsic.catchFailure<HostInputError>(oversizedCommand(), nulRejected)) { return 31 }
  if !(run pathSpelling("C:\\", "/C:", "\\\\?\\C:\\")) { return 32 }
  if !(run pathSpelling("c:\\Name\\name. ", "/c:/Name/name. ", "\\\\?\\c:\\Name\\name. ")) { return 33 }
  if !(run pathSpelling("\\\\Server\\Share\\file", "/UNC/Server/Share/file", "\\\\?\\UNC\\Server\\Share\\file")) { return 34 }
  if !(run pathSpelling("\\\\?\\UNC\\Server\\Share\\", "/UNC/Server/Share", "\\\\?\\UNC\\Server\\Share")) { return 35 }
  if !(run Intrinsic.catchFailure<FileError>(relativeDrive(), rejectedPath)) { return 36 }
  if !(run Intrinsic.catchFailure<FileError>(devicePath(), rejectedPath)) { return 37 }
  let rawPath = run WindowsPath.fromNativeBytes(&[67, 58, 92, 237, 160, 128])
  if !equal(Path.rawBytes(&rawPath), &[47, 67, 58, 47, 237, 160, 128]) { return 38 }
  if !(run resolvesPath("/C:/work/src", "..\\out\\.\\main.exe", "/C:/work/out/main.exe")) { return 39 }
  if !(run resolvesPath("/C:/work", "D:/one/../two", "/D:/two")) { return 40 }
  if !(run resolvesPath("/C:/work", "\\top", "/C:/top")) { return 41 }
  if !(run resolvesPath("/C:/work", "\\\\server\\share\\one\\..\\two", "/UNC/server/share/two")) { return 42 }
  if !(run resolvesPath("/UNC/server/share/work", "../", "/UNC/server/share")) { return 43 }
  if !(run refusesResolution("/C:", "../D:/escape")) { return 44 }
  if !(run refusesResolution("/UNC/server/share", "../escape")) { return 45 }
  if !(run refusesResolution("/C:/work", "D:relative")) { return 46 }
  if !(run refusesResolution("/C:/work", "\\\\.\\pipe\\name")) { return 47 }
  let rawResolved = run WindowsPath.resolveBytes(&rawPath, &[46, 46, 92, 237, 176, 128])
  if !equal(Path.rawBytes(&rawResolved), &[47, 67, 58, 47, 237, 176, 128]) { return 48 }
  let rawRelative = run Path.resolveBytes(&rawPath, &[46, 46, 47, 255])
  if !equal(Path.rawBytes(&rawRelative), &[47, 67, 58, 47, 255]) { return 49 }
  let driveRoot = run Path.make("/C:")
  if let Option<Path>.Some {value} = move run WindowsPath.parent(&driveRoot) { return 50 }
  let shareRoot = run Path.make("/UNC/server/share")
  if let Option<Path>.Some {value} = move run WindowsPath.parent(&shareRoot) { return 51 }
  let child = run Path.make("/C:/child")
  match move run WindowsPath.parent(&child) {
    Option<Path>.Some {value} => { if !equal(Path.rawBytes(&value), b"/C:") { return 52 } }
    Option<Path>.None => { return 53 }
  }
  return 0
}

pub effect fn main() -> i32 ! FileError | HostInputError | InvalidWtf8 | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run check() |> Effect.provideMut<Allocator>(&mut allocator)
}
