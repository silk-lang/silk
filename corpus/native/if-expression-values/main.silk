import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.ownership { Drop }
import silk.core.option { Option }
import silk.mem.shared { Shared }
import silk.text.string { String }

// `if` with a final `else` is a value (IF-002), and value blocks yield their last expression
// (BLOCK-001). Each check adds its weight to the exit code only when it holds.

struct Audit { dropped: i32, order: i32 }
struct Node { id: i32, audit: Shared<Audit> }

fn dropped(audit: &Audit) -> i32 { return audit.dropped }
fn order(audit: &Audit) -> i32 { return audit.order }

impl Drop for Node {
  fn drop(self: &mut Node) -> () {
    let id = self.id
    let record = fn(audit: &mut Audit) -> () {
      audit.dropped = audit.dropped + 1
      audit.order = audit.order * 10 + id
    }
    Shared<Audit>.withMut<()>(&self.audit, record)
  }
}

fn sign(n: i32) -> i32 {
  return if n > 0 { 1 } else if n < 0 { -1 } else { 0 }
}

fn orZero(input: Option<i32>) -> i32 {
  return if let Option<i32>.Some { value } = move input { value } else { 0 }
}

fn scaled(n: i32) -> i32 {
  return match n {
    0 => 0
    _ => {
      let doubled = n * 2
      if doubled > 10 { doubled - 10 } else { doubled + 1 }
    }
  }
}

fn label(flag: bool) -> string<'static> {
  let text = if flag { "yes" } else { "no" }
  return text
}

fn widened(flag: bool) -> i32 | bool {
  return if flag { 7 } else { false }
}

fn twice(value: i32) -> i32 { return value * 2 }

// An `if` value is a call argument and an array element like any other expression.
fn positions(flag: bool) -> i32 {
  let doubled = twice(if flag { 3 } else { 4 })
  let values = [if flag { 5 } else { 6 }, 7]
  return doubled + values[0]
}

fn small(flag: bool) -> u8 {
  let value: u8 = if flag { 200 } else { 2 }
  return value
}

effect fn half(n: i32) -> i32 ! OutOfMemoryError { return n / 2 }

effect fn work(n: i32) -> i32 ! OutOfMemoryError {
  let a = if n > 10 { run half(n) } else { n }
  let b = match n {
    0 => { return 7 }
    1 => {
      let t = run half(40)
      t + 1
    }
    _ => n
  }
  let mut total = 0
  let mut i = 0
  while i < 5 {
    let step = if i == 3 { break } else { i * 2 }
    total = total + step
    i = i + 1
  }
  return a + b + total
}

// Locals of a value block are cleaned at its end; the yielded owner survives the block.
effect fn ownership() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let audit = run Shared<Audit>.make(Audit { dropped: 0, order: 0 })
  let kept = if Shared<Audit>.with<i32>(&audit, dropped) == 0 {
    let scratch = Node { id: 1, audit: Shared<Audit>.clone(&audit) }
    let chosen = Node { id: 2, audit: Shared<Audit>.clone(&audit) }
    drop scratch
    move chosen
  } else {
    Node { id: 3, audit: Shared<Audit>.clone(&audit) }
  }
  let afterBlock = Shared<Audit>.with<i32>(&audit, order) == 1 && kept.id == 2
  drop kept
  let afterDrop = Shared<Audit>.with<i32>(&audit, dropped) == 2 && Shared<Audit>.with<i32>(&audit, order) == 12
  if afterBlock && afterDrop { return 1 }
  return 0
}

effect fn recover(error: OutOfMemoryError) -> i32 { return -1000 }

effect fn checks() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let mut score = 0
  if sign(5) == 1 && sign(-5) == -1 && sign(0) == 0 { score = score + 1 }
  if orZero(Option<i32>.some(4)) == 4 && orZero(Option<i32>.none()) == 0 { score = score + 2 }
  if scaled(0) == 0 && scaled(3) == 7 && scaled(8) == 6 { score = score + 4 }
  if String.utf8Bytes(label(true)).length == 3 && String.utf8Bytes(label(false)).length == 2 { score = score + 8 }
  let joined = match widened(true) {
    i32 number => number == 7
    bool flag => false
  }
  if joined { score = score + 16 }
  if small(true) == 200 && small(false) == 2 && positions(true) == 11 && positions(false) == 14 { score = score + 32 }
  let high = run Effect.catchAll(work(20), recover)
  let one = run Effect.catchAll(work(1), recover)
  let zero = run Effect.catchAll(work(0), recover)
  if high + one + zero == 71 { score = score + 64 }
  score = score + 128 * run ownership()
  return score
}

effect fn fallback(error: OutOfMemoryError) -> i32 { return 0 }

pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  let score = run Effect.catchAll(checks(), fallback) |> Effect.provideMut<Allocator>(&mut allocator)
  if score == 255 { return 42 }
  return score
}
