// An `effect fn` capturing a generic input elaborates its environment binder (`A: 'env`).
effect fn keep<A>(value: A) -> A {
  return move value
}

struct Pair<A> {
  first: A
  second: A
}

effect fn first<A>(value: Pair<A>, extra: &i32) -> A {
  return move value.first
}

effect fn wrap<B>(value: B) -> B {
  return run keep(move value)
}

pub fn main() -> i32 {
  let x = 30
  let y = 2
  let r = run keep(&x)
  let s = run first(Pair<i32> {first: 1, second: 2}, &y)
  let t = run keep(r.* + s)
  let u = run wrap(&y)
  let v = run wrap(9)
  return t + u.* + v
}
