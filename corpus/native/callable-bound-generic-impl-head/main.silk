// A generic caller proves an impl head's callable representation bound from its own declared bound.
interface Receive { fn receive(self: &Self) -> i32 }

struct Holder<'e, H: fn<'e>(i32) -> i32> { handler: H }

impl<'e, H: fn<'e>(i32) -> i32> Receive for Holder<'e, H> {
  fn receive(self: &Self) -> i32 { return self.handler(2) }
}

fn next(x: i32) -> i32 { return x + 40 }

fn go<Q: Receive>(q: &Q) -> i32 { return Receive.receive(q) }

fn take<'e, H: fn<'e>(i32) -> i32>(handler: H) -> i32 {
  let holder = Holder<'e, H> { handler: move handler }
  return go<Holder<'e, H>>(&holder)
}

pub fn main() -> i32 { return take(next) }
