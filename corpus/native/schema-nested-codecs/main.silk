import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.schema.codec { Between, Codec, Codecs, NumberText, Trim }
import silk.schema.issue { Issue }
import silk.text.string { String }

// Both a chain used as a chain step and a checked chain close finite specialization graphs.
effect fn verify() -> i32 ! Issue | OutOfMemoryError ? &mut Allocator {
  let nested = Codecs.chain2(Trim {}, Codecs.chain2(Trim {}, NumberText<i32>.make()))
  let checked = Codecs.check(move nested, Between<i32> {low: 1, high: 100, message: "between 1 and 100"})
  let value = run Codec.decode(&checked, run String.copy(" 42 "))
  if value != 42 { return 1 }
  let encoded = run Codec.encode(&checked, &value)
  return if String.view(&encoded) == "42" { 0 } else { 2 }
}

pub effect fn main() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let result = run Effect.result(verify()) |> Effect.provideMut<Allocator>(&mut allocator)
  return match move result {
    Result<i32, Issue | OutOfMemoryError>.Success {value} => value
    Result<i32, Issue | OutOfMemoryError>.Failure {..} => 3
  }
}
