// `C.m()` on a constant `C` calls the method on the constant's value, as `C.field` reads its
// field: by reference, by value, with arguments, and through a type with its own namespace.
pub struct Limits {
  pub low: i32,
  pub high: i32,
}

impl Limits {
  pub fn span(self: &Self) -> i32 {
    return self.high - self.low
  }

  pub fn clamp(self: &Self, value: i32) -> i32 {
    if value < self.low {
      return self.low
    }
    if value > self.high {
      return self.high
    }
    return value
  }

  pub fn widened(self: Self, by: i32) -> Limits {
    return Limits { low: self.low - by, high: self.high + by }
  }
}

const LIMITS: Limits = Limits { low: 2, high: 9 }

pub fn main() -> i32 {
  if LIMITS.span() != 7 {
    return 1
  }
  if LIMITS.clamp(40) != 9 || LIMITS.clamp(-1) != 2 || LIMITS.clamp(5) != 5 {
    return 2
  }
  let wide = LIMITS.widened(1)
  if wide.low != 1 || wide.high != 10 || LIMITS.low != 2 {
    return 3
  }
  return 0
}
