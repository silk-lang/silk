// A method of a generic implementation reflects over the implementation's type parameter, both in
// its own `static for` and by passing its `static` parameter on to a generic function.
import silk.core.reflect { Reflect }

union Mode { Fast, Steady, Slow }

struct Table<M> { pub base: u32 }

// The position of the variant named `label` among `U`'s variants.
fn ordinalOf<U>(static label: string<'static>) -> u32 {
  let mut at: u32 = 0
  static for variant in Reflect.variants<U>() {
    if Reflect.variantLabel(variant) == label { return at }
    at = at + 1
  }
  return 99
}

impl<M> Table<M> {
  fn position(self: &Self, static label: string<'static>) -> u32 {
    let mut at: u32 = 0
    static for variant in Reflect.variants<M>() {
      if Reflect.variantLabel(variant) == label { return self.base + at }
      at = at + 1
    }
    return 99
  }

  fn forwarded(self: &Self, static label: string<'static>) -> u32 {
    return self.base + ordinalOf<M>(label)
  }
}

pub fn main() -> i32 {
  let table = Table<Mode> { base: 10 }
  // (10 + 2) + (10 + 1) + 19
  if table.position("Slow") + table.forwarded("Steady") + ordinalOf<Mode>("Fast") + 19 == 42 {
    return 42
  }
  return 1
}
