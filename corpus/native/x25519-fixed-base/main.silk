// X25519Base gives the same public keys as the Montgomery ladder for pseudo-random secrets.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.crypto.x25519 { X25519, X25519Base, X25519Error }
import silk.num.u64

effect fn program() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let base = run X25519Base.make()
  let mut state: u64 = 88172645463325252
  let mut round = 0
  while round < 32 {
    let mut secret: [u8; 32] = [0; 32]
    let mut i: usize = 0
    while i < 32 {
      state = u64.bitXor(state, u64.shiftLeft(state, 13))
      state = u64.bitXor(state, u64.shiftRight(state, 7))
      state = u64.bitXor(state, u64.shiftLeft(state, 17))
      secret[i] = u64.wrappingToU8(state)
      i = i + 1
    }
    let slow = match X25519.fromSecret(&secret) { Result.Success {value} => move value Result.Failure {..} => { return 2 } }
    let fast = match X25519.fromSecretWith(&secret, &base) { Result.Success {value} => move value Result.Failure {..} => { return 3 } }
    let a = slow.publicKey()
    let b = fast.publicKey()
    i = 0
    while i < 32 {
      if a[i] != b[i] { return 4 }
      i = i + 1
    }
    round = round + 1
  }
  return 42
}

effect fn failed<E>(error: E) -> i32 { drop error return 1 }

pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(program(), failed) |> Effect.provideMut<Allocator>(&mut allocator)
}
