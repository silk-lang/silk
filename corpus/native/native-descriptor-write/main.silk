static if Intrinsic.targetOperatingSystem() == "windows" {
  import silk.num.u32
  import silk.num.usize
  unsafe extern "C" fn GetStdHandle(selector: u32) -> ?*mut u8
  @foreign(noCapture: ("bytes", "written", "overlapped"))
  unsafe extern "C" fn WriteFile(handle: ?*mut u8, bytes: ?[*]const u8, length: u32, written: *mut u32, overlapped: ?*mut u8) -> i32
  unsafe fn write(descriptor: i32, bytes: ?[*]const u8, length: usize) -> isize {
    let mut written: u32 = 0
    let handle = unsafe GetStdHandle(4294967285)
    if unsafe WriteFile(handle, bytes, usize.toU32(length), Pointer.fromMutRef(&mut written), Pointer.null<u8>()) == 0 { return -1 }
    return u32.toIsize(written)
  }
} else {
  import silk.platform.native.descriptor { write }
}
import silk.mem.pointer { Pointer }
import silk.num.isize

fn emitTail(message: &[u8], offset: usize) -> i32 {
  let mut transferred: isize = 0
  unsafe {
    let base = Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(Pointer.fromSlice<u8>(message))
    let next = Pointer.assumeMany<u8>(Pointer.at<u8>(base, offset))
    transferred = write(1, next, message.length - offset)
  }
  if transferred < 0 { return 1 }
  if isize.toUsize(transferred) != message.length - offset { return 2 }
  return 42
}

pub fn main() -> i32 {
  let message: [u8; 3] = [104, 105, 10]
  return emitTail(&message, 1)
}
