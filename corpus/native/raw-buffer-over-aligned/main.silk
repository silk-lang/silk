import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.mem.layout { Layout, InvalidAlignment }
import silk.mem.raw_buffer { RawBuffer }
import silk.mem.slot { Slot }

// An allocation aligned more strictly than its element is aligned for it, so the buffer adopts it.
effect fn store() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let plan = Layout.make(8, 64)
  let layout = match move plan {
    Layout ready => move ready
    InvalidAlignment invalid => { return 1 }
  }
  let allocation = run Allocator.allocate(move layout) |> Effect.provideMut(&mut allocator)
  unsafe {
    let mut buffer = RawBuffer.from<i32>(move allocation, 2)
    Slot.write(RawBuffer.slot(&mut buffer, 0), 40)
    Slot.write(RawBuffer.slot(&mut buffer, 1), 2)
    let first = Slot.take(RawBuffer.slot(&mut buffer, 0))
    let second = Slot.take(RawBuffer.slot(&mut buffer, 1))
    drop buffer
    return first + second
  }
  return 0
}
effect fn recover(error: OutOfMemoryError) -> i32 { return 7 }
pub fn main() -> i32 { return run Effect.catchAll(store(), recover) }
