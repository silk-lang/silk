import silk.core.effect { Effect }
import silk.text.format { Debug, Format, Formatter }
import silk.io.writer { Writer, WriterError }

pub struct NotFoundError {}
pub struct OfflineError {}

effect fn load() -> i32 ! NotFoundError {
  fail NotFoundError {}
}

effect fn recover(error: NotFoundError) -> i32 ! OfflineError {
  fail OfflineError {}
}

pub effect fn main() ! OfflineError {
  let v = run Effect.catch<NotFoundError>(load(), recover)
  return ()
}

impl Debug for OfflineError {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return run Format.debugFields(self, "OfflineError", &mut formatter)
  }
}
