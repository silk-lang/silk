import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.crypto.digest { Digest }
import silk.crypto.md5 { Md5 }
import silk.crypto.modular { ModularError, Natural }
import silk.crypto.rsa { RsaError, RsaPrivateKey, RsaPublicKey }
import silk.crypto.sha1 { Sha1 }
import silk.crypto.sha2 { Sha224, Sha256, Sha384, Sha512, Sha512_256 }
import silk.crypto.sha3 { Sha3_256 }
import silk.num.u32
import silk.num.u64
import silk.system.random { Random }

struct Counter {
  state: u64,
}

impl Random for Counter {
  effect fn fillBytes(self: &mut Self, output: &mut [u8]) -> () {
    let mut index: usize = 0
    while index < output.length {
      self.state = u64.wrappingAdd(u64.wrappingMultiply(self.state, 6364136223846793005), 1)
      output[index] = u64.toU8(u64.shiftRight(self.state, 56))
      index = index + 1
    }
  }
}

fn privateKey(
  n: &[u8],
  e: &[u8],
  d: &[u8],
  p: &[u8],
  q: &[u8],
  dp: &[u8],
  dq: &[u8],
  qi: &[u8],
) -> RsaPrivateKey {
  return match RsaPrivateKey.fromComponents(n, e, d, p, q, dp, dq, qi) {
    Result<RsaPrivateKey, RsaError>.Success { value } => move value
    Result<RsaPrivateKey, RsaError>.Failure { error: _ } => Intrinsic.trap("key")
  }
}

fn hash<H: Digest>(message: &[u8], output: &mut [u8]) -> () {
  let mut state: H = Digest.make()
  state.update(message)
  state.finishInto(move output)
}

fn equal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut i: usize = 0
  while i < left.length {
    if left[i] != right[i] {
      return false
    }
    i = i + 1
  }
  return true
}

fn sameNatural(value: &Natural, expected: &[u8]) -> bool {
  let mut buffer: [u8; 1024] = [0; 1024]
  let view = Slice.viewMut<u8>(&mut buffer, 0, expected.length)
  if let Result<(), ModularError>.Failure { error: _ } = value.writeBytes(move view) {
    return false
  }
  return equal(Slice.view<u8>(&buffer, 0, expected.length), expected)
}

fn ok(result: Result<(), RsaError>) -> bool {
  return match move result {
    Result<(), RsaError>.Success { value: _ } => true
    Result<(), RsaError>.Failure { error: _ } => false
  }
}

fn failsWith(result: Result<(), RsaError>, expected: RsaError) -> bool {
  return match move result {
    Result<(), RsaError>.Success { value: _ } => false
    Result<(), RsaError>.Failure { error } => error == expected
  }
}

fn keyFailsWith(result: Result<RsaPrivateKey, RsaError>, expected: RsaError) -> bool {
  return match move result {
    Result<RsaPrivateKey, RsaError>.Success { value: _ } => false
    Result<RsaPrivateKey, RsaError>.Failure { error } => error == expected
  }
}

// Signs with PKCS #1 v1.5 and compares with OpenSSL, then verifies and rejects a changed byte.
fn pkcs1Case<H: Digest>(key: &RsaPrivateKey, message: &[u8], expected: &[u8]) -> bool {
  let mut digest: [u8; 64] = [0; 64]
  let state: H = Digest.make()
  let length = state.digestLength()
  hash<H>(message, &mut digest)
  let view = Slice.view<u8>(&digest, 0, length)
  let mut signature: [u8; 1024] = [0; 1024]
  let width = expected.length
  if !ok(key.signPkcs1<H>(view, Slice.viewMut<u8>(&mut signature, 0, width))) {
    return false
  }
  if !equal(Slice.view<u8>(&signature, 0, width), expected) {
    return false
  }
  let public = key.publicKey()
  if !ok(public.verifyPkcs1<H>(view, expected)) {
    return false
  }
  signature[width / 2] = signature[width / 2] ^ 1
  return failsWith(
    public.verifyPkcs1<H>(view, Slice.view<u8>(&signature, 0, width)),
    RsaError.InvalidSignature,
  )
}

fn pssVerifyCase<H: Digest>(
  public: &RsaPublicKey,
  message: &[u8],
  signature: &[u8],
  salt: usize,
) -> bool {
  let mut digest: [u8; 64] = [0; 64]
  let state: H = Digest.make()
  let length = state.digestLength()
  hash<H>(message, &mut digest)
  let view = Slice.view<u8>(&digest, 0, length)
  if !ok(public.verifyPss<H>(view, signature, Option<usize>.some(salt))) {
    return false
  }
  if !ok(public.verifyPss<H>(view, signature, Option<usize>.none())) {
    return false
  }
  if !failsWith(
    public.verifyPss<H>(view, signature, Option<usize>.some(salt + 1)),
    RsaError.InvalidSignature,
  ) {
    return false
  }
  return !ok(
    public.verifyPss<H>(
      view,
      Slice.view<u8>(signature, 0, signature.length - 1),
      Option<usize>.none(),
    ),
  )
}

effect fn pssSignCase<H: Digest>(
  key: &RsaPrivateKey,
  message: &[u8],
  salt: usize,
  expected: &[u8],
) -> bool
  ! RsaError
  ? &mut Random {
  let mut digest: [u8; 64] = [0; 64]
  let state: H = Digest.make()
  let length = state.digestLength()
  hash<H>(message, &mut digest)
  let view = Slice.view<u8>(&digest, 0, length)
  let mut signature: [u8; 1024] = [0; 1024]
  run key.signPss<H>(view, salt, Slice.viewMut<u8>(&mut signature, 0, expected.length))
  if !equal(Slice.view<u8>(&signature, 0, expected.length), expected) {
    return false
  }
  return ok(key.publicKey().verifyPss<H>(view, expected, Option<usize>.some(salt)))
}

fn oaepDecryptCase<H: Digest>(
  key: &RsaPrivateKey,
  label: &[u8],
  ciphertext: &[u8],
  expected: &[u8],
) -> bool {
  let mut output: [u8; 1024] = [0; 1024]
  let opened = key.decryptOaep<H>(label, ciphertext, &mut output)
  return match move opened {
    Result<usize, RsaError>.Success { value } => equal(Slice.view<u8>(&output, 0, value), expected)
    Result<usize, RsaError>.Failure { error: _ } => false
  }
}

fn oaepRejects<H: Digest>(key: &RsaPrivateKey, label: &[u8], ciphertext: &[u8]) -> bool {
  let mut output: [u8; 1024] = [0; 1024]
  let opened = key.decryptOaep<H>(label, ciphertext, &mut output)
  return match move opened {
    Result<usize, RsaError>.Success { value: _ } => false
    Result<usize, RsaError>.Failure { error } => error == RsaError.InvalidCiphertext
  }
}

effect fn oaepEncryptCase<H: Digest>(
  key: &RsaPrivateKey,
  label: &[u8],
  message: &[u8],
  expected: &[u8],
) -> bool
  ! RsaError
  ? &mut Random {
  let mut ciphertext: [u8; 1024] = [0; 1024]
  let public = key.publicKey()
  run public.encryptOaep<H>(label, message, Slice.viewMut<u8>(&mut ciphertext, 0, expected.length))
  if !equal(Slice.view<u8>(&ciphertext, 0, expected.length), expected) {
    return false
  }
  return oaepDecryptCase<H>(key, label, expected, message)
}

effect fn pkcs1EncryptCase(key: &RsaPrivateKey, message: &[u8], expected: &[u8]) -> bool
  ! RsaError
  ? &mut Random {
  let mut ciphertext: [u8; 1024] = [0; 1024]
  let public = key.publicKey()
  run public.encryptPkcs1(message, Slice.viewMut<u8>(&mut ciphertext, 0, expected.length))
  return equal(Slice.view<u8>(&ciphertext, 0, expected.length), expected)
}

fn effectFailsWith(result: Result<bool, RsaError>, expected: RsaError) -> bool {
  return match move result {
    Result<bool, RsaError>.Success { value: _ } => false
    Result<bool, RsaError>.Failure { error } => error == expected
  }
}

fn effectPassed(result: Result<bool, RsaError>) -> bool {
  return match move result {
    Result<bool, RsaError>.Success { value } => value
    Result<bool, RsaError>.Failure { error: _ } => false
  }
}

// Generates a key and checks it: its size, its parts, a signature, and an OAEP round trip.
effect fn generatedCase(bits: usize, exponent: u32) -> bool
  ! RsaError
  ? &mut Random {
  let key = run RsaPrivateKey.generate(bits, exponent)
  let public = key.publicKey()
  if public.bitLength() != bits || public.byteLength() != (bits + 7) / 8 {
    return false
  }
  if key.firstPrime().bitLength() != (bits + 1) / 2 || key.secondPrime().bitLength() != bits / 2 {
    return false
  }
  if key.firstPrime().lessThan(&key.secondPrime()) {
    return false
  }
  if !sameNatural(
    &public.exponent(),
    &[
      u32.toU8(exponent / 16777216),
      u32.toU8(exponent / 65536 % 256),
      u32.toU8(exponent / 256 % 256),
      u32.toU8(exponent % 256),
    ],
  ) {
    return false
  }

  // Rebuild the key from its parts, which checks n = p * q and the coefficient.
  let mut parts: [u8; 8192] = [0; 8192]
  let width = public.byteLength()
  let half = width / 2 + 1
  let values: [Natural; 8] = [
    public.modulus(),
    public.exponent(),
    key.privateExponent(),
    key.firstPrime(),
    key.secondPrime(),
    key.firstExponent(),
    key.secondExponent(),
    key.coefficient(),
  ]
  let lengths: [usize; 8] = [width, 4, width, half, half, half, half, half]
  let mut offset: usize = 0
  let mut i: usize = 0
  while i < 8 {
    if let Result<(), ModularError>.Failure { error: _ } = values[i].writeBytes(
      Slice.viewMut<u8>(&mut parts, offset, lengths[i]),
    ) {
      return false
    }
    offset = offset + lengths[i]
    i = i + 1
  }
  let rebuilt = RsaPrivateKey.fromComponents(
    Slice.view<u8>(&parts, 0, width),
    Slice.view<u8>(&parts, width, 4),
    Slice.view<u8>(&parts, width + 4, width),
    Slice.view<u8>(&parts, 2 * width + 4, half),
    Slice.view<u8>(&parts, 2 * width + 4 + half, half),
    Slice.view<u8>(&parts, 2 * width + 4 + 2 * half, half),
    Slice.view<u8>(&parts, 2 * width + 4 + 3 * half, half),
    Slice.view<u8>(&parts, 2 * width + 4 + 4 * half, half),
  )
  let copy = match move rebuilt {
    Result<RsaPrivateKey, RsaError>.Success { value } => move value
    Result<RsaPrivateKey, RsaError>.Failure { error: _ } => {
      return false
    }
  }
  let digest = Sha256.hash(b"generated")
  let mut signature: [u8; 1024] = [0; 1024]
  if !ok(copy.signPkcs1<Sha256>(&digest, Slice.viewMut<u8>(&mut signature, 0, width))) {
    return false
  }
  if !ok(public.verifyPkcs1<Sha256>(&digest, Slice.view<u8>(&signature, 0, width))) {
    return false
  }

  // The private exponent alone must invert the public one: s^d = (m^e)^d.
  let mut ciphertext: [u8; 1024] = [0; 1024]
  run public.encryptOaep<Sha1>(b"", b"round trip", Slice.viewMut<u8>(&mut ciphertext, 0, width))
  return oaepDecryptCase<Sha1>(&key, b"", Slice.view<u8>(&ciphertext, 0, width), b"round trip")
}

