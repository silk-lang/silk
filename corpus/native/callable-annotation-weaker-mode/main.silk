// A written `mut fn` or `once fn` annotation admits a shared callable, as a parameter of that
// contract does.
fn inc(x: i32) -> i32 { return x + 1 }
pub fn main() -> i32 {
  let m: mut fn(i32) -> i32 = inc
  let o: once fn(i32) -> i32 = fn(x: i32) -> i32 { return x + 2 }
  let a = m(1)
  let b = m(a)
  return o(b) + 37
}
