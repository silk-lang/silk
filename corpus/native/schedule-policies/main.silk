import silk.core.effect { Effect }
import silk.core.schedule { Schedule }
import silk.system.insecure_random { InsecureRandom }
import silk.system.monotonic_clock { MonotonicClock }
import silk.system.system_clock { Instant, SystemClock }

// A clock that records each wait and moves forward without sleeping.
struct VirtualClock {
  mark: Instant,
  waits: [u64; 8],
  count: usize,
}

impl MonotonicClock for VirtualClock {
  effect fn now(self: &mut Self) -> Instant {
    return SystemClock.make(SystemClock.seconds(&self.mark), SystemClock.nanoseconds(&self.mark))
  }

  effect fn getResolution(self: &mut Self) -> u64 {
    return 1
  }

  effect fn waitUntil(self: &mut Self, when: Instant) -> () {
    self.mark = move when
    return ()
  }

  effect fn waitFor(self: &mut Self, howLong: u64) -> () {
    if self.count < 8 {
      self.waits[self.count] = howLong
    }
    self.count = self.count + 1
    self.mark = MonotonicClock.deadlineAfter(&self.mark, howLong)
    return ()
  }
}

fn fresh() -> VirtualClock {
  return VirtualClock { mark: SystemClock.make(0, 0), waits: [0, 0, 0, 0, 0, 0, 0, 0], count: 0 }
}

struct Problem {
  code: i32,
}

struct Calls {
  count: i32,
  // The attempt that succeeds, or 0 for none.
  succeedAt: i32,
  // Virtual work each call takes.
  work: u64,
}

effect fn call(calls: &mut Calls) -> i32
  ! Problem
  ? &mut MonotonicClock {
  calls.count = calls.count + 1
  if calls.work > 0 {
    run MonotonicClock.waitFor(calls.work)
  }
  if calls.count == calls.succeedAt {
    return calls.count
  }
  fail Problem { code: calls.count }
}

effect fn negate(problem: Problem) -> i32 {
  return 0 - problem.code
}

fn belowThree(problem: &Problem) -> bool {
  return problem.code < 3
}

// Runs `schedule` with Effect.retry against calls that never succeed, and returns the clock.
fn retried(schedule: &Schedule, attempts: i32) -> VirtualClock {
  let mut clock = fresh()
  let mut random = InsecureRandom.seeded(7)
  let mut calls = Calls { count: 0, succeedAt: 0, work: 0 }
  let last = run Effect.retry(call(&mut calls), schedule) |> Effect.catchAll(negate)
    |> Effect.provideMut<InsecureRandom>(&mut random)
    |> Effect.provideMut<MonotonicClock>(&mut clock)
  if last != 0 - attempts {
    clock.count = 99
  }
  return move clock
}

fn waits(clock: &VirtualClock, expected: &[u64]) -> bool {
  if clock.count != expected.length {
    return false
  }
  let mut index: usize = 0
  while index < expected.length {
    if clock.waits[index] != expected[index] {
      return false
    }
    index = index + 1
  }
  return true
}

pub fn main() -> i32 {
  if !waits(&retried(&Schedule.recurs(2), 3), &[0, 0]) {
    return 1
  }
  if !waits(&retried(&(Schedule.spaced(5ms) |> Schedule.limit(3)), 4), &[5ms, 5ms, 5ms]) {
    return 2
  }
  let exponential = Schedule.exponential(10ms) |> Schedule.limit(4)
  if !waits(&retried(&exponential, 5), &[10ms, 20ms, 40ms, 80ms]) {
    return 3
  }
  let fibonacci = Schedule.fibonacci(1ms) |> Schedule.limit(6)
  if !waits(&retried(&fibonacci, 7), &[1ms, 1ms, 2ms, 3ms, 5ms, 8ms]) {
    return 4
  }
  let linear = Schedule.linear(3ms) |> Schedule.limit(3)
  if !waits(&retried(&linear, 4), &[3ms, 6ms, 9ms]) {
    return 5
  }

  // The smaller limit and cap stay.
  let capped = Schedule.exponential(10ms) |> Schedule.capDelay(25ms) |> Schedule.capDelay(50ms)
    |> Schedule.limit(4)
    |> Schedule.limit(9)
  if !waits(&retried(&capped, 5), &[10ms, 20ms, 25ms, 25ms]) {
    return 6
  }
  let shrinking = Schedule.exponentialBy(80ms, 0.5) |> Schedule.limit(3)
  if !waits(&retried(&shrinking, 4), &[80ms, 40ms, 20ms]) {
    return 7
  }

  // upTo stops before a recurrence once the time has passed.
  let bounded = Schedule.spaced(40ms) |> Schedule.upTo(100ms)
  if !waits(&retried(&bounded, 4), &[40ms, 40ms, 40ms]) {
    return 8
  }

  // Jitter stays between the bounds and repeats for the same seed.
  let jittered = Schedule.spaced(100ms) |> Schedule.jitteredBetween(0.5, 1.5) |> Schedule.limit(8)
  let first = retried(&jittered, 9)
  let second = retried(&jittered, 9)
  if first.count != 8 {
    return 9
  }
  let mut index: usize = 0
  let mut varied = false
  while index < 8 {
    let delay = first.waits[index]
    if delay < 50ms || delay >= 150ms || delay != second.waits[index] {
      return 10
    }
    if delay != first.waits[0] {
      varied = true
    }
    index = index + 1
  }
  if !varied {
    return 11
  }

  // retry returns the first success.
  let mut retryClock = fresh()
  let mut random = InsecureRandom.seeded(1)
  let mut calls = Calls { count: 0, succeedAt: 3, work: 0 }
  let success = run Effect.retry(call(&mut calls), &(Schedule.spaced(1ms) |> Schedule.limit(5)))
    |> Effect.catchAll(negate)
    |> Effect.provideMut<InsecureRandom>(&mut random)
    |> Effect.provideMut<MonotonicClock>(&mut retryClock)
  if success != 3 || retryClock.count != 2 {
    return 12
  }

  // retryWhile stops at the first failure it rejects.
  let mut whileClock = fresh()
  calls = Calls { count: 0, succeedAt: 0, work: 0 }
  let rejected = run Effect.retryWhile(call(&mut calls), &Schedule.forever(), belowThree)
    |> Effect.catchAll(negate)
    |> Effect.provideMut<InsecureRandom>(&mut random)
    |> Effect.provideMut<MonotonicClock>(&mut whileClock)
  if rejected != -3 || whileClock.count != 2 {
    return 13
  }

  // repeat runs once, then once for each recurrence, and a failure stops it.
  let mut repeatClock = fresh()
  calls = Calls { count: 0, succeedAt: 0, work: 0 }
  let failed = run Effect.repeat(call(&mut calls), &Schedule.recurs(5)) |> Effect.catchAll(negate)
    |> Effect.provideMut<InsecureRandom>(&mut random)
    |> Effect.provideMut<MonotonicClock>(&mut repeatClock)
  if failed != -1 || repeatClock.count != 0 {
    return 14
  }

  // fixed keeps the beat: each run takes 30ms of a 100ms interval, so each wait is 70ms. A run
  // that takes 130ms skips to the next multiple.
  let mut beatClock = fresh()
  calls = Calls { count: 0, succeedAt: 0, work: 30ms }
  let beat = Schedule.fixed(100ms) |> Schedule.limit(3)
  let mut runs = 0
  let ticked = run Effect.repeat(tick(&mut runs, &mut calls), &beat)
    |> Effect.provideMut<InsecureRandom>(&mut random)
    |> Effect.provideMut<MonotonicClock>(&mut beatClock)

  // Waits: 30 work, 70, 30, 70, 30, 70, 30.
  if ticked != 4 || !waits(&beatClock, &[30ms, 70ms, 30ms, 70ms, 30ms, 70ms, 30ms]) {
    return 15
  }
  let mut slowClock = fresh()
  calls = Calls { count: 0, succeedAt: 0, work: 130ms }
  runs = 0
  let slow = run Effect.repeat(tick(&mut runs, &mut calls), &beat)
    |> Effect.provideMut<InsecureRandom>(&mut random)
    |> Effect.provideMut<MonotonicClock>(&mut slowClock)

  // Waits: 130 work, 70 to reach 200, 130, 70 to reach 400, 130.
  if slow != 4 || slowClock.count != 7 || slowClock.waits[1] != 70ms || slowClock.waits[3] != 70ms {
    return 16
  }
  // A run that ends exactly on a beat recurs at once.
  let mut exactClock = fresh()
  calls = Calls { count: 0, succeedAt: 0, work: 100ms }
  runs = 0
  let exact = run Effect.repeat(tick(&mut runs, &mut calls), &beat)
    |> Effect.provideMut<InsecureRandom>(&mut random)
    |> Effect.provideMut<MonotonicClock>(&mut exactClock)
  if exact != 4 || !waits(&exactClock, &[100ms, 0, 100ms, 0, 100ms, 0, 100ms]) {
    return 17
  }
  return 0
}

// One beat: counts the run and does the virtual work of one call.
effect fn tick(runs: &mut i32, calls: &mut Calls) -> i32
  ? &mut MonotonicClock {
  runs.* = runs.* + 1
  run MonotonicClock.waitFor(calls.work)
  return runs.*
}
