struct A { value: i32 }
struct B { value: i32 }
struct C {}

fn wide(input: A | B) -> i32 {
  return match move input {
    A {value} => value + 1
    B {value} => value + 2
  }
}

fn wider(input: A | B | C) -> i32 {
  return match move input {
    A {value} => value + 10
    B {value} => value + 20
    C {} => 30
  }
}

fn apply(f: fn(A) -> i32) -> i32 {
  return f(A { value: 5 })
}

fn applyBoth(f: fn(A | B) -> i32) -> i32 {
  return f(B { value: 7 })
}

fn applyRef(f: &fn(A) -> i32) -> i32 {
  return f.*(A { value: 9 })
}

pub fn main() -> i32 {
  if apply(wide) != 6 { return 1 }
  if apply(wider) != 15 { return 2 }
  // A union operand widens member by member into the wider union.
  if applyBoth(wider) != 27 { return 3 }
  if applyRef(&wide) != 10 { return 4 }
  // An anonymous function with a wider parameter.
  if apply(fn(input: A | B) -> i32 { return wide(move input) + 100 }) != 106 { return 5 }
  return 42
}
