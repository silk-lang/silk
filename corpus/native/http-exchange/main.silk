  let mut overall = Option<Instant>.none()
  if scenario == 8 {
    overall = Option<Instant>.some(SystemClock.make(0, 0))
  }
  return run Client.withOwned(
    move transport,
    origin,
    Version.Http11,
    selectedLimits,
