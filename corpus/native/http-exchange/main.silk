    let closed = run Effect.result(Client.close(&mut owner))
    drop closed
    return match move result {
      Result.Success {value} => value
      Result.Failure {error} => {
        fail move error
      }
    }
  }
  let mut selectedLimits = limits()
  if scenario == 6 {
    selectedLimits.maxInformationalResponses = usize.ONE
  }
  if scenario == 12 {
    selectedLimits.maxInformationalWireBytes = 10
  }
  let mut overall = Option<Instant>.none()
  if scenario == 8 {
    overall = Option<Instant>.some(SystemClock.make(0, 0))
  }
  return run Client.withOwned(
    move transport,
    origin,
    Version.Http11,
    selectedLimits,
    move overall,
    move handler,
