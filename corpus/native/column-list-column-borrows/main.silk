import silk.collections.column_list { ColumnList, Rows, RowsMut }
import silk.core.effect { Effect }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }

struct Point {
  pub x: f32,
  pub y: f32,
}

impl Copy for Point {}

struct Particle {
  pub position: Point,
  pub speed: f32,
  pub alive: bool,
  pub id: u64,
}

impl Copy for Particle {}

fn particle(id: u64, x: f32) -> Particle {
  return Particle { position: Point { x, y: 0.0 }, speed: 2.0, alive: true, id }
}

fn advance(x: &mut [Point], speed: &[f32], seconds: f32) -> () {
  let mut at: usize = 0
  while at < x.length {
    x[at].x = x[at].x + speed[at] * seconds
    at = at + 1
  }
  return ()
}

fn total(ids: &[u64]) -> u64 {
  let mut sum: u64 = 0
  let mut at: usize = 0
  while at < ids.length {
    sum = sum + ids[at]
    at = at + 1
  }
  return sum
}

// A handle takes the place of a slice of rows. Its indexes start at its first row.
fn sumIds(rows: Rows<'_, Particle>) -> u64 {
  let mut sum: u64 = 0
  let mut at: usize = 0
  while at < rows.length() {
    sum = sum + rows[at].id
    at = at + 1
  }
  return sum
}

fn stop(rows: RowsMut<'_, Particle>) -> () {
  let mut rows = move rows
  let speeds = &mut rows[..].speed
  let mut at: usize = 0
  while at < speeds.length {
    speeds[at] = 0.0
    at = at + 1
  }
  return ()
}

effect fn build() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let mut particles = ColumnList<Particle>.make()
  if particles[..].id.length != 0 { return 1 }
  let mut id: u64 = 0
  let mut x: f32 = 0.0
  while id < 10 {
    run particles.append(particle(id, x))
    id = id + 1
    x = x + 1.0
  }

  // `..` stands for every row: one field of all rows is a slice, shared or exclusive.
  let ids = particles[..].id
  if ids.length != 10 || ids[9] != 9 || total(&particles[..].id) != 45 { return 2 }

  // One column is written while another one is read.
  advance(&mut particles[..].position, &particles[..].speed, 0.5)
  if particles[3].position.x != 4.0 { return 3 }
  let positions = &mut particles[..].position
  let speeds = &particles[..].speed
  positions[0].y = speeds[0]
  // A field of another column is free while those two are borrowed.
  particles[0].alive = false
  positions[1].y = 7.0
  if particles[0].position.y != 2.0 || particles[1].position.y != 7.0 || particles[0].alive { return 4 }

  // Handles: all rows, a range of them, and a range of a range.
  if sumIds(particles.rows()) != 45 { return 5 }
  let middle = particles.rows().range(2, 6)
  if middle.length() != 4 || sumIds(middle) != 14 || middle[0].id != 2 { return 6 }
  if sumIds(middle.range(1, 3)) != 7 || middle.range(4, 4).length() != 0 { return 7 }
  if middle[..].id.length != 4 || middle[..].id[3] != 5 || middle.get(1).id != 3 { return 8 }

  // An exclusive handle lends a range, and the rows outside it keep their values.
  let mut all = particles.rowsMut()
  stop(all.range(4, 8))
  all[9].speed = 9.0
  if all.rows()[4].speed != 0.0 || all.get(9).speed != 9.0 { return 9 }
  all.set(0, particle(100, 0.0))
  if particles[3].speed != 2.0 || particles[4].speed != 0.0 || particles[7].speed != 0.0 || particles[8].speed != 2.0 { return 10 }
  if particles[0].id != 100 { return 11 }

  // `splitAt` gives two handles that are written at the same time.
  let pair = particles.rowsMut().splitAt(5)
  let mut head = move pair.left
  let mut tail = move pair.right
  if head.length() != 5 || tail.length() != 5 { return 12 }
  let headIds = &mut head[..].id
  let tailIds = &mut tail[..].id
  headIds[4] = 40
  tailIds[0] = 50
  tail[4].id = 90
  if particles[4].id != 40 || particles[5].id != 50 || particles[9].id != 90 { return 13 }
  return 42
}

effect fn recover(error: OutOfMemoryError) -> i32 { return 99 }

pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(build() |> Effect.provideMut<Allocator>(&mut allocator), recover)
}
