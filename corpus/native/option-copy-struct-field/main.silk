import silk.core.option { Option }
import silk.core.ownership { Copy }

struct Font {
  units: u16,
  top: Option<u32>,
}

impl Copy for Font {}

fn units(font: Font) -> u16 { return font.units }

pub fn main() -> i32 {
  let font = Font { units: 40, top: Option<u32>.some(2) }
  let first = units(font)
  let copied = font
  let maybe = Option<u32>.some(0)
  let again = maybe
  let total = first + units(copied) + 0
  if total != 80 { return 1 }
  return match again { Option<u32>.Some {value} => 42 Option<u32>.None => 2 }
}
