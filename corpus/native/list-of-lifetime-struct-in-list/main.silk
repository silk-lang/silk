import silk.core.effect { Effect }
import silk.collections.list { List }
import silk.num.usize
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }

struct View<'a> {
  bytes: &'a [u8],
}

impl<'a> Copy for View<'a> {}

struct Item<'a> {
  view: View<'a>,
}

impl<'a> Copy for Item<'a> {}

struct Plan<'a> {
  view: View<'a>,
  items: List<Item<'a>>,
}

effect fn makePlan<'a>(bytes: &'a [u8]) -> Plan<'a>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut plan = Plan { view: View { bytes: bytes }, items: List<Item<'a>>.make() }
  run List<Item<'a>>.append(&mut plan.items, Item { view: plan.view })
  return move plan
}

effect fn collect() -> usize
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut owned = List<u8>.make()
  run List<u8>.append(&mut owned, 1)
  let bytes = List<u8>.asSlice(&owned)
  let mut plans = List<Plan>.make()
  let plan = run makePlan(bytes)
  run List<Plan>.append(&mut plans, move plan)
  return List<Plan>.length(&plans)
}

pub effect fn main() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let count = run collect() |> Effect.provideMut<Allocator>(&mut allocator)
  return usize.toI32(count) + 41
}
