import silk.core.option { Option }
import silk.trace.context { SpanContext, parseTraceparent, traceparent }

pub fn main() -> i32 {
  let text = "00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01"
  let context = match parseTraceparent(text) {
    Option<SpanContext>.Some {value} => value
    Option<SpanContext>.None => { return 1 }
  }
  if context.flags != 1 || traceparent(&context).view() != text { return 2 }
  if parseTraceparent("01-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-00-future").isNone() { return 3 }
  if parseTraceparent("00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01-").isSome() { return 4 }
  if parseTraceparent("00-00000000000000000000000000000000-00f067aa0ba902b7-01").isSome() { return 5 }
  if parseTraceparent("00-4bf92f3577b34da6a3ce929d0e0e4736-0000000000000000-01").isSome() { return 6 }
  if parseTraceparent("ff-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-01").isSome() { return 7 }
  if parseTraceparent("00-4BF92F3577B34DA6A3CE929D0E0E4736-00f067aa0ba902b7-01").isSome() { return 8 }
  if parseTraceparent("00").isSome() { return 9 }
  if parseTraceparent("00-4bf92f3577b34da6a3ce929d0e0e4736-00f067aa0ba902b7-0g").isSome() { return 10 }
  return 0
}
