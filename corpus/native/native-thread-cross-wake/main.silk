import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.concurrency.atomic { Atomic, MemoryOrder }
import silk.mem.box { Box }
import silk.core.effect { Effect }
import silk.concurrency.execution { Execution, TransferableExecution, TransferableWake }
import silk.concurrency.thread_native { NativeThread, SpawnError }
import silk.option { Option }
import silk.mem.pointer { Pointer }
import silk.concurrency.thread { Concurrent, Transferable }
// The endpoint's flag: written atomically by whichever thread signals the Wake.
struct Flag { pointer: *mut u32 }
impl Transferable for Flag {}
impl Concurrent for Flag {}
// Where the body leaves its Wake for the owner to hand to another thread.
struct WakeCell { wake: Option<TransferableWake> }
struct WakeSlot { pointer: *mut WakeCell }
impl Transferable for WakeSlot {}
struct Empty {}
struct Stored { execution: TransferableExecution<i32> }
struct Owner { slot: Empty | Stored, result: i32 }
struct Guard {}
fn ready(flag: &Flag) -> () {
  unsafe {
    Atomic.store<u32>(flag.pointer, 1, MemoryOrder.Release)
    Atomic.notifyOne(flag.pointer)
  }
  return ()
}
effect fn body(slot: WakeSlot) -> i32 {
  run Execution.parkTransferable(fn(wake: TransferableWake) -> Guard {
    unsafe { Pointer.put<WakeCell>(slot.pointer, WakeCell { wake: Option<TransferableWake>.some(move wake) }) }
    return Guard {}
  })
  return 42
}
fn complete(owner: &mut Owner, result: i32) -> () {
  owner.result = result
  return ()
}
fn suspend(owner: &mut Owner, execution: Intrinsic.Execution<i32>) -> () {
  let previous = Intrinsic.replace(owner.slot, Stored { execution: TransferableExecution<i32>.adopt(move execution) })
  drop previous
  return ()
}
effect fn driveOnce(execution: TransferableExecution<i32>, owner: &mut Owner) -> () {
  return run Execution.drive(execution.local(), move owner, complete, suspend)
}
fn signal(wake: TransferableWake) -> i32 {
  Execution.wakeTransferable(move wake)
  return 1
}
// Signals the Wake from a second native thread, which runs the endpoint there.
effect fn signalOnThread(wake: TransferableWake) -> i32 ! OutOfMemoryError | SpawnError ? &mut Allocator {
  let thread = run NativeThread.spawn(fn() -> i32 { return signal(move wake) })
  return thread.join()
}
effect fn program() -> i32 ! OutOfMemoryError | SpawnError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut flagStorage = run Box<u32>.make(0) |> Effect.provideMut<Allocator>(&mut allocator)
  let flagPointer = Pointer.fromMutRef(&mut flagStorage.getMut()[0])
  let mut cell = run Box<WakeCell>.make(WakeCell { wake: Option<TransferableWake>.none() })
    |> Effect.provideMut<Allocator>(&mut allocator)
  let slot = WakeSlot { pointer: Pointer.fromMutRef(&mut cell.getMut()[0]) }
  let mut owner = Owner { slot: Empty {}, result: 0 }
  let mut execution = run Execution.makeTransferable(body(move slot), Flag { pointer: flagPointer }, ready)
    |> Effect.provideMut<Allocator>(&mut allocator)
  execution.notifyInitial()
  run driveOnce(move execution, &mut owner)
  let parked = Intrinsic.replace(cell.getMut()[0].wake, Option<TransferableWake>.none())
  let signaled = match move parked {
    Option<TransferableWake>.Some { value: wake } => run signalOnThread(move wake)
      |> Effect.provideMut<Allocator>(&mut allocator)
    Option<TransferableWake>.None => 0
  }
  let flagged = unsafe Atomic.load<u32>(flagPointer, MemoryOrder.Acquire)
  if signaled != 1 || flagged != 1 { return 3 }
  let selected = Intrinsic.replace(owner.slot, Empty {})
  match move selected {
    Empty {} => { return 4 }
    Stored { execution: next } => run driveOnce(move next, &mut owner)
  }
  return owner.result
}
effect fn recover(error: OutOfMemoryError | SpawnError) -> i32 { return -2 }
pub fn main() -> i32 { return run Effect.catchAll(program(), recover) }
