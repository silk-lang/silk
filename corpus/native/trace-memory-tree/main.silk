import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.concurrency.sync { Arc }
import silk.trace.record { Recorder, Config, Memory }
import silk.trace { SpanKind, Tracer, Trace }
import silk.trace.values { Value }

fn plain() -> () {
  let _outer = Trace.span("outer")
  Trace.set("answer", &42)
  let _inner = Trace.spanOf("inner", SpanKind.Client)
  Trace.eventWith("event", &.{ ok: true })
}
effect fn exercise() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let recorder = run Arc<Recorder>.make(run Recorder.make(Config.make("test")))
  run Effect.provideAmbient<Tracer>(effect { plain() }, &recorder)
  let mut memory = Memory.make()
  run memory.drain(recorder.get())
  let spans = memory.spans()
  if spans.length != 2 { return 1 }
  if spans[0].name != "inner" || spans[1].name != "outer" { return 2 }
  if spans[0].kind != SpanKind.Client || spans[1].kind != SpanKind.Internal { return 3 }
  if spans[0].eventCount != 1 || spans[0].events[0].name != "event" { return 4 }
  if spans[0].events[0].attributes.count != 1 || spans[1].attributes.count != 1 { return 5 }
  if let Value.Integer {value} = &spans[1].attributes.items[0].value {
    if value != 42 || spans[1].attributes.items[0].key != "answer" { return 6 }
  } else { return 7 }
  if spans[1].parent.span != 0 || spans[1].end < spans[0].start { return 8 }
  if spans[0].parent.span != spans[1].context.span { return 3 }
  return 0
}
effect fn failed(error: OutOfMemoryError) -> i32 { return 4 }
pub fn main() -> i32 {
  let mut alloc = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(exercise() |> Effect.provideMut<Allocator>(&mut alloc), failed)
}
