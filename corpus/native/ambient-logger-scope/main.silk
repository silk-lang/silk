import silk.core.effect { Effect }
import silk.io.logger { Logger, InMemoryLogger, LogLevel }
import silk.concurrency.sync { Arc }
import silk.mem.allocator { Allocator, OutOfMemoryError }

fn leaf(value: i32) -> () { run Effect.logInfo("value {value}", &.{ value: value }) }
effect fn inner() -> () { leaf(2) }
effect fn outer(second: &Arc<InMemoryLogger>) -> () {
  leaf(1)
  run inner() |> Effect.provideAmbient<Logger>(second)
  leaf(3)
}
effect fn exercise() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let first = run Arc<InMemoryLogger>.make(run Logger.inMemoryProvider())
  let second = run Arc<InMemoryLogger>.make(run Logger.inMemoryProvider())
  run outer(&second) |> Effect.provideAmbient<Logger>(&first)
  leaf(4)
  if Logger.length(first.get()) != 2 || Logger.length(second.get()) != 1 { return 1 }
  if Logger.messageByteAt(first.get(), 0, 6) != 49 || Logger.messageByteAt(first.get(), 1, 6) != 51 { return 2 }
  if Logger.messageByteAt(second.get(), 0, 6) != 50 { return 3 }
  if Logger.levelAt(second.get(), 0) != LogLevel.Info { return 4 }
  return 0
}
effect fn failed(error: OutOfMemoryError) -> i32 { return 5 }
pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(exercise() |> Effect.provideMut<Allocator>(&mut allocator), failed)
}
