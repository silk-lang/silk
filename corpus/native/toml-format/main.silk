import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }
import silk.toml.format { TomlFormat }
import silk.toml.scanner { TomlError, TomlReason }
import silk.num.usize

effect fn formatted(source: string, expected: string) -> bool
  ! TomlError | OutOfMemoryError
  ? &mut Allocator {
  let output = run TomlFormat.format(source)
  if String.view(&output) != expected {
    return false
  }
  let again = run TomlFormat.format(String.view(&output))
  return String.view(&again) == expected
}

effect fn refused(source: &[u8], reason: TomlReason, offset: usize) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  return match move run Effect.result(TomlFormat.formatBytes(source)) {
    Result<Bytes, TomlError | OutOfMemoryError>.Success { value: _ } => false
    Result<Bytes, TomlError | OutOfMemoryError>.Failure { error } => match move error {
      TomlError invalid => invalid.reason == reason && invalid.offset == offset
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

effect fn cases() -> i32
  ! TomlError | OutOfMemoryError
  ? &mut Allocator {
  if !run formatted(
    """    # configuration
  [  "table.name"  . child ]  # section
  name='keep = # [ ]'
  "quoted" . key= {path='../lib',options=[1,2 ,3],empty={ }}
  date = 1979-05-27 07:32:00Z
  number=+1_000.00e-2
  [[ products ]]
  title="hello" # keep
""",
    """# configuration
["table.name".child] # section
name = 'keep = # [ ]'
"quoted".key = { path = '../lib', options = [1, 2, 3], empty = {} }
date = 1979-05-27 07:32:00Z
number = +1_000.00e-2
[[products]]
title = "hello" # keep
""",
  ) {
    return 1
  }
  if !run formatted(
    """items=[
       # first
         {x=1,y=[2,3]}, # kept
   [
9,
    10,
],
 ]
inline={
x=1,
child={y=2},
}
""",
    """items = [
  # first
  { x = 1, y = [2, 3] }, # kept
  [
    9,
    10,
  ],
]
inline = {
  x = 1,
  child = { y = 2 },
}
""",
  ) {
    return 2
  }
  if !run formatted(
    "\r\n\r\n [x]\r\n value=\"\"\"\r\n  keep  \r\n# data\r\n\"\"\"   # end\t\r\n\r\n\r\nother='''literal\n  unchanged '''\t\r\n\r\n",
    "[x]\nvalue = \"\"\"\r\n  keep  \r\n# data\r\n\"\"\" # end\n\nother = '''literal\n  unchanged '''\n",
  ) {
    return 3
  }
  if !run formatted("\t \r\n\n", "") {
    return 4
  }
  if !run formatted("  # only  \t", "# only\n") {
    return 5
  }
  if !run formatted("x=[1,2,] # eof", "x = [1, 2,] # eof\n") {
    return 6
  }
  if !run refused(b"x=1\nx=2\n", TomlReason.DuplicateKey, 4) {
    return 8
  }
  if !run refused(b"x=[", TomlReason.UnexpectedEnd, 3) {
    return 9
  }
  return 42
}

pub effect fn main() -> i32
  ! TomlError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run cases() |> Effect.provideMut<Allocator>(&mut allocator)
}
