import silk.core.effect { Effect }

pub enum Problem {
  Bad,
}

struct Box {
  value: i32,
}

effect fn apply<'env, E, ? R>(value: Box, transform: once effect fn<'env>(Box) -> Box ! E ? R) -> Box
  ! E
  ? R {
  return run transform(move value)
}

// The parameter states the success while its failure row is still inferred, so a lambda whose
// body only fails still succeeds with `Box` and derives its failure from the `fail`.
effect fn failing() -> Box
  ! Problem {
  return run apply(Box { value: 1 }, effect |b| {
    drop b
    fail Problem.Bad
  })
}

effect fn incremented(flag: bool) -> Box
  ! Problem {
  return run apply(Box { value: 2 }, effect |b| {
    if flag {
      fail Problem.Bad
    }
    return Box { value: b.value + 1 }
  })
}

effect fn recovered(problem: Problem) -> Box {
  drop problem
  return Box { value: 39 }
}

pub fn main() -> i32 {
  let first = run Effect.catchAll(failing(), recovered)
  let second = run Effect.catchAll(incremented(false), recovered)
  return first.value + second.value
}
