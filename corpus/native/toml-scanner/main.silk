  let e8: [u8; 26] = [120, 32, 61, 32, 49, 57, 55, 57, 45, 48, 53, 45, 50, 55, 84, 48, 55, 58, 51, 50, 43, 50, 52, 58, 48, 48]
  if !rejects(&e8, TomlReason.InvalidDateTime, 4) { return 38 }
  let e9: [u8; 8] = [120, 32, 61, 32, 34, 92, 113, 34]
