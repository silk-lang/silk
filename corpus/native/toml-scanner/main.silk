  let v6: [u8; 82] = [116, 105, 109, 101, 115, 32, 61, 32, 91, 48, 55, 58, 51, 50, 44, 32, 48, 55, 58, 51, 50, 58, 48, 48, 46, 57, 57, 57, 57, 57, 57, 44, 32, 49, 57, 55, 57, 45, 48, 53, 45, 50, 55, 44, 32, 49, 57, 55, 57, 45, 48, 53, 45, 50, 55, 84, 48, 55, 58, 51, 50, 44, 32, 49, 57, 55, 57, 45, 48, 53, 45, 50, 55, 32, 48, 55, 58, 51, 50, 90, 93, 10]
  if !accepts(&v6) { return 8 }
  let v7: [u8; 50] = [113, 117, 111, 116, 101, 100, 46, 34, 117, 116, 102, 56, 45, 226, 130, 172, 34, 32, 61, 32, 34, 104, 101, 108, 108, 111, 92, 101, 92, 120, 49, 66, 92, 117, 50, 48, 65, 67, 92, 85, 48, 48, 48, 49, 70, 52, 65, 57, 34, 10]
  if !accepts(&v7) { return 9 }
  let v8: [u8; 29] = [108, 105, 116, 101, 114, 97, 108, 32, 61, 32, 39, 39, 39, 10, 104, 101, 108, 108, 111, 10, 119, 111, 114, 108, 100, 39, 39, 39, 10]
  if !accepts(&v8) { return 10 }
  let v9: [u8; 27] = [97, 114, 114, 97, 121, 32, 61, 32, 91, 49, 44, 32, 35, 32, 99, 111, 109, 109, 101, 110, 116, 10, 32, 50, 44, 93, 10]
  if !accepts(&v9) { return 11 }
  let v10: [u8; 39] = [105, 110, 108, 105, 110, 101, 32, 61, 32, 123, 10, 32, 97, 32, 61, 32, 49, 44, 10, 32, 98, 32, 61, 32, 123, 99, 32, 61, 32, 116, 114, 117, 101, 44, 125, 44, 10, 125, 10]
  if !accepts(&v10) { return 12 }
  let v11: [u8; 52] = [91, 91, 112, 114, 111, 100, 117, 99, 116, 115, 93, 93, 10, 110, 97, 109, 101, 32, 61, 32, 34, 111, 110, 101, 34, 10, 91, 91, 112, 114, 111, 100, 117, 99, 116, 115, 93, 93, 10, 110, 97, 109, 101, 32, 61, 32, 34, 116, 119, 111, 34, 10]
  if !accepts(&v11) { return 13 }
  let v12: [u8; 35] = [116, 101, 120, 116, 32, 61, 32, 34, 34, 34, 10, 76, 105, 110, 101, 32, 111, 110, 101, 32, 92, 10, 32, 108, 105, 110, 101, 32, 116, 119, 111, 34, 34, 34, 10]
  if !accepts(&v12) { return 14 }
  let v13: [u8; 18] = [108, 101, 97, 112, 32, 61, 32, 50, 48, 48, 48, 45, 48, 50, 45, 50, 57, 10]
  if !accepts(&v13) { return 15 }
  let e0: [u8; 5] = [107, 101, 121, 32, 61]
  if !rejects(&e0, TomlReason.UnexpectedEnd, 5) { return 30 }
  let e1: [u8; 6] = [120, 32, 61, 32, 48, 49]
