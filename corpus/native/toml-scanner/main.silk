  let e5: [u8; 6] = [120, 32, 61, 32, 55, 46]
  if !rejects(&e5, TomlReason.InvalidNumber, 4) { return 35 }
  let e6: [u8; 14] = [120, 32, 61, 32, 50, 48, 50, 51, 45, 48, 50, 45, 50, 57]
  if !rejects(&e6, TomlReason.InvalidDateTime, 4) { return 36 }
  let e7: [u8; 9] = [120, 32, 61, 32, 50, 53, 58, 48, 48]
