  let e2: [u8; 8] = [120, 32, 61, 32, 49, 95, 95, 48]
  if !rejects(&e2, TomlReason.InvalidNumber, 4) { return 32 }
  let e3: [u8; 6] = [120, 32, 61, 32, 48, 120]
