import silk.num.i32
import silk.num.i8
import silk.num.f64

struct Pair { left: i32, right: i32 }

fn arithmetic(a: i32, b: i32) -> i32 {
  return (a + b) * (a - b)
}

fn narrow(a: i8, b: i8) -> i8 {
  return (a + b) * (a - b)
}

fn floating(a: f64, b: f64) -> f64 {
  return (a + b) * (b - a)
}

fn boolean(a: bool, b: bool) -> bool {
  return !(a == b)
}

fn borrowed(value: &mut i32) -> i32 {
  value.* = value.* + 3
  return value.*
}

fn branching(flag: bool, value: i32) -> i32 {
  let selected = if flag { value + 2 } else { value - 2 }
  return selected * 2
}

fn aggregated(value: Pair) -> i32 {
  return value.left + value.right
}

pub fn main() -> i32 {
  let mut changing = 4
  let mut total = 0
  while changing < 7 {
    total = total + arithmetic(changing, 2)
    changing = changing + 1
  }
  if total != 65 { return 1 }
  if borrowed(&mut changing) != 10 || changing != 10 { return 2 }
  if branching(true, changing) != 24 || branching(false, changing) != 16 { return 3 }
  if aggregated(Pair {left: changing + 1, right: changing - 1}) != 20 { return 4 }
  if narrow(-3, 2) != 5 { return 5 }
  if floating(1.5, 2.5) != 4.0 { return 6 }
  if !boolean(true, false) || boolean(true, true) { return 7 }
  return 42
}
