// A copying match of `r.*` reads the referent in place, and an arm that reassigns `r` still binds
// the value it matched.
import silk.core.ownership { Copy }
import silk.num.u64

struct Big { a: [u64; 28], }
impl Copy for Big {}

union Shape {
  Small { value: u64 },
  Large { value: Big },
}
impl Copy for Shape {}

@inlineNever
fn small(value: &u64) -> u64 { return value.* }
@inlineNever
fn large(value: &Big) -> u64 { return value.a[1] }

@inlineNever
fn byValue(shape: &Shape) -> u64 {
  return match shape.* {
    Shape.Small { value } => small(&value)
    Shape.Large { value } => large(&value)
  }
}

@inlineNever
fn reassigned(shape: &Shape, other: &Shape) -> u64 {
  let mut current = shape
  return match current.* {
    Shape.Small { value } => {
      current = other
      value + small(&value)
    }
    Shape.Large { value } => large(&value)
  }
}

pub fn main() -> i32 {
  let shape = Shape.Small { value: 7 }
  let other = Shape.Small { value: 100 }
  let mut big = Big { a: [0; 28] }
  big.a[1] = 5
  let large = Shape.Large { value: big }
  return u64.toI32(byValue(&shape) + byValue(&large) + reassigned(&shape, &other))
}
