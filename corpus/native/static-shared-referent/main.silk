import silk.collections.list { List }

union Data {
  Text {value: string<'static>},
  Dynamic {value: List<i32>},
}

static fn read(data: &Data) -> string<'static> {
  return match &data.* {
    Data.Text {value} => value
    Data.Dynamic {..} => compileError("a static value cannot own a runtime list")
  }
}

static fn selected() -> string<'static> {
  let value = Data.Text {value: "shared static referent"}
  return read(&value)
}

const TEXT: string<'static> = selected()
pub fn main() -> i32 { return if TEXT == "shared static referent" {42} else {1} }
