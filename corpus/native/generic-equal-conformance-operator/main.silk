import silk.core.equal { Equal }
import silk.core.order { Order, Ordering }

struct Value<T> {
  value: T,
}

// A generic comparison conformance applies at a concrete use site, as a generic arithmetic one does.
impl<T: Equal> Equal for Value<T> {
  fn equals(left: &Self, right: &Self) -> bool {
    return &left.value == &right.value
  }
}

impl<T: Order> Order for Value<T> {
  fn compare(left: &Self, right: &Self) -> Ordering {
    return Order.compare(&left.value, &right.value)
  }
}

pub fn main() -> i32 {
  let a = Value<i32> { value: 42 }
  let b = Value<i32> { value: 42 }
  let c = Value<i32> { value: 7 }
  if !(&a == &b) || &a == &c { return 1 }
  if !(&c < &a) || &a < &c { return 2 }
  let s = Value<string> { value: "x" }
  let t = Value<string> { value: "x" }
  if !(&s == &t) { return 3 }
  return 42
}
