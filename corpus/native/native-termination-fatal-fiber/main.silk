import silk.allocator {OutOfMemoryError}
import silk.effect {Effect}
import silk.fiber {Cancelled, Fiber}
import silk.local_scheduler {LocalScheduler, StalledError}
import silk.monotonic_clock {MonotonicClock}
import silk.os_monotonic_clock {OsMonotonicClock}
import silk.scheduler {Scheduler, TaskIdExhaustedError}

fn pick(values: &[i32], at: usize) -> i32 {
  return values[at]
}

// The trap happens after a resume, in a grandchild of the root task.
effect fn grandchild(at: usize) -> i32 {
  run Fiber.yieldNow()
  let values = [1, 2, 3]
  return pick(&values, at)
}

effect fn child(at: usize) -> i32 ! OutOfMemoryError | TaskIdExhaustedError | Cancelled ? &mut Scheduler | &mut MonotonicClock {
  let task = run Fiber<i32, never>.forkChild(grandchild(at))
  return run task.join()
}

effect fn root() -> i32 ! OutOfMemoryError | TaskIdExhaustedError | Cancelled ? &mut Scheduler | &mut MonotonicClock {
  let task = run Fiber<i32, OutOfMemoryError | TaskIdExhaustedError | Cancelled>.forkChild(child(5))
  return run task.join()
}

pub effect fn main() -> i32 ! OutOfMemoryError | TaskIdExhaustedError | Cancelled | StalledError {
  let mut clock = OsMonotonicClock.make()
  let mut scheduler = LocalScheduler.make()
  return run scheduler.execute<i32, OutOfMemoryError | TaskIdExhaustedError | Cancelled>(root())
    |> Effect.provideMut<MonotonicClock>(&mut clock)
}
