// A bounded inherent block calls its bounds' operations as a bounded generic function does:
// qualified (`Zero.zero()`, `Twice.twice(value)`) and as receiver methods (`value.twice()`).
pub interface Zero {
  fn zero() -> Self
}

impl Zero for i32 {
  fn zero() -> i32 { return 0 }
}

pub interface Twice {
  fn twice(value: Self) -> Self
}

impl Twice for i32 {
  fn twice(value: i32) -> i32 { return value * 2 }
}

struct Pair<T> {
  x: T,
  y: T,
}

impl<T: Zero + Twice> Pair<T> {
  fn zero() -> Pair<T> { return Pair<T> { x: Zero.zero(), y: Zero.zero() } }

  fn doubled(self: Self) -> Pair<T> {
    return Pair<T> { x: Twice.twice(move self.x), y: Twice.twice(move self.y) }
  }

  fn quadrupled(self: Self) -> Pair<T> {
    let twice = self.doubled()
    return Pair<T> { x: twice.x.twice(), y: twice.y.twice() }
  }
}

pub fn main() -> i32 {
  let zero = Pair<i32>.zero()
  let doubled = Pair<i32> { x: 1, y: 2 }.doubled()
  let quadrupled = Pair<i32> { x: 3, y: 4 }.quadrupled()
  return zero.x + zero.y + doubled.x + doubled.y + quadrupled.x + quadrupled.y
}
