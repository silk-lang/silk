// `Slice.copyInto` copies at an offset, and plain integer placeholders write the same text as
// formatted ones.
import silk.effect { Effect }
import silk.format { Format }
import silk.i64
import silk.slice { Slice }
import silk.u64
import silk.writer { Writer, WriterError }

struct Capture { bytes: [u8; 256], length: usize, }

impl Writer for Capture {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> () ! WriterError ? &mut Writer {
    Slice.copyInto<u8>(&mut self.bytes, self.length, value)
    self.length = self.length + value.length
    return ()
  }
  effect fn flush(self: &mut Self) -> () ! WriterError ? &mut Writer { return () }
}

effect fn lines() -> () ! WriterError ? &mut Writer {
  run Format.format("{a}|{b}|{c}|{d}|{e}|{f}|", &.{ a: 0, b: 7, c: -45, d: i64.MIN, e: u64.MAX, f: 1234567 })
  run Format.format("{a:>4}|{b:+}|{c:.3}|{d:05}", &.{ a: 12, b: 9, c: 5, d: -42 })
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut index: usize = 0
  while index < left.length {
    if left[index] != right[index] { return false }
    index = index + 1
  }
  return true
}

pub effect fn main() -> i32 ! WriterError {
  let mut capture = Capture { bytes: [0; 256], length: 0 }
  run lines() |> Effect.provideMut<Writer>(&mut capture)
  let expected = b"0|7|-45|-9223372036854775808|18446744073709551615|1234567|  12|+9|005|-0042"
  if !same(Slice.view<u8>(&capture.bytes, 0, capture.length), expected) { return 1 }
  let mut words: [u64; 5] = [1; 5]
  let source: [u64; 2] = [8, 9]
  Slice.copyInto<u64>(&mut words, 3, &source)
  Slice.copyInto<u64>(&mut words, 5, Slice.view<u64>(&source, 0, 0))
  if words[2] != 1 || words[3] != 8 || words[4] != 9 { return 2 }
  return 42
}
