import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u8

fn sum(bytes: &[u8]) -> usize {
  let mut total: usize = 0
  let mut index: usize = 0
  while index < bytes.length {
    total = total + u8.toUsize(bytes[index])
    index = index + 1
  }
  return total
}

effect fn listBytes() -> usize ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut words = List<u32>.make()
  if Slice.asBytes<u32>(List<u32>.asSlice(&words)).length != 0 { return 0 }
  run List<u32>.append(&mut words, 0x01010101) |> Effect.provideMut(&mut allocator)
  run List<u32>.append(&mut words, 0x02020202) |> Effect.provideMut(&mut allocator)
  return sum(Slice.asBytes<u32>(List<u32>.asSlice(&words)))
}

effect fn recover(error: OutOfMemoryError) -> usize { return 0 }

pub fn main() -> i32 {
  let words: [u32; 2] = [0x04030201, 0x08070605]
  let bytes = Slice.asBytes<u32>(&words)
  if bytes.length != 8 || bytes[0] != 1 || bytes[3] != 4 || bytes[4] != 5 || bytes[7] != 8 { return 1 }
  let signed: [i16; 2] = [-1, 2]
  let signedBytes = Slice.asBytes<i16>(&signed)
  if signedBytes.length != 4 || signedBytes[0] != 0xff || signedBytes[1] != 0xff || signedBytes[2] != 2 { return 2 }
  let floats: [f32; 1] = [1.0]
  let floatBytes = Slice.asBytes<f32>(&floats)
  if floatBytes.length != 4 || floatBytes[2] != 0x80 || floatBytes[3] != 0x3f { return 3 }
  let mut halves: [u16; 3] = [0, 0, 0]
  let raw = Slice.asMutBytes<u16>(&mut halves)
  raw[2] = 0x34
  raw[3] = 0x12
  if halves[0] != 0 || halves[1] != 0x1234 || halves[2] != 0 { return 4 }
  let mut doubles: [f64; 1] = [0.0]
  let doubleBytes = Slice.asMutBytes<f64>(&mut doubles)
  doubleBytes[6] = 0xf0
  doubleBytes[7] = 0x3f
  if doubles[0] != 1.0 { return 5 }
  let mut none: [u64; 0] = []
  if Slice.asBytes<u64>(&none).length != 0 || Slice.asMutBytes<u64>(&mut none).length != 0 { return 6 }
  let total = run Effect.catchAll(listBytes(), recover)
  if total != 12 { return 7 }
  return 42
}
