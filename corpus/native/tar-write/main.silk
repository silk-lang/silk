// Writes a tar archive with TarWriter and reads it back with TarReader: short paths, a path split
// into the ustar prefix, a path only a pax record holds, an executable file, a directory, and
// refused paths.
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.core.effect {Effect}
import silk.compress.tar {TarError, TarKind, TarMember, TarReader, TarWriter}
import silk.collections.bytes {Bytes}
import silk.collections.slice {Slice}
import silk.core.option {Option}
import silk.core.result {Result}
import silk.num.usize

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at: usize = 0
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + 1
  }
  return true
}

// `count` copies of `part`, joined by `/`.
effect fn repeated(part: &[u8], count: usize) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut text = Bytes.make()
  let mut at: usize = 0
  while at < count {
    if at > 0 { run Bytes.append(&mut text, b"/") }
    run Bytes.append(&mut text, part)
    at = at + 1
  }
  return move text
}

effect fn archive(split: &[u8], long: &[u8]) -> Bytes ! TarError | OutOfMemoryError ? &mut Allocator {
  let mut writer = TarWriter.make()
  run TarWriter.directory(&mut writer, b"pkg-1.0.0")
  run TarWriter.file(&mut writer, b"pkg-1.0.0/silk.toml", b"[package]\nname = \"pkg\"\n", false)
  run TarWriter.file(&mut writer, b"pkg-1.0.0/bin/tool", b"\x7fELF", true)
  run TarWriter.file(&mut writer, split, b"split", false)
  run TarWriter.file(&mut writer, long, b"", false)
  return run TarWriter.finish(move writer)
}

// The member's whole path, `prefix/name` or `name`.
effect fn path(member: &TarMember<'_>) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut text = Bytes.make()
  if member.prefix.length > 0 {
    run Bytes.append(&mut text, member.prefix)
    run Bytes.append(&mut text, b"/")
  }
  run Bytes.append(&mut text, member.name)
  return move text
}

effect fn refused(path: &[u8]) -> bool ! OutOfMemoryError ? &mut Allocator {
  let mut writer = TarWriter.make()
  let added = run Effect.result(TarWriter.file(&mut writer, path, b"x", false))
  return match move added {
    Result<(), TarError | OutOfMemoryError>.Success {..} => false
    Result<(), TarError | OutOfMemoryError>.Failure {error} => match move error {
      TarError reason => reason == TarError.UnsafePath
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

effect fn check() -> i32 ! TarError | OutOfMemoryError ? &mut Allocator {
  // 120 bytes: too long for the name field, but it splits at a `/` into prefix and name.
  let split = run repeated(b"segment-0123456789", 6)
  // 300 bytes in segments of 9: no prefix of 155 and name of 100 fit, so a pax record holds it.
  let long = run repeated(b"abcdefgh", 33)
  let first = run archive(Bytes.asSlice(&split), Bytes.asSlice(&long))
  let second = run archive(Bytes.asSlice(&split), Bytes.asSlice(&long))
  if !same(Bytes.asSlice(&first), Bytes.asSlice(&second)) { return 1 }
  let bytes = Bytes.asSlice(&first)
  if bytes.length % 512 != 0 { return 2 }
  // The first header's modification time is zero.
  if !same(Slice.view<u8>(bytes, 136, 12), b"00000000000\x00") { return 3 }
  let mut reader = TarReader.open(bytes)
  let mut seen: usize = 0
  while true {
    let next = match TarReader.next(&mut reader) {
      Result.Success {value} => move value
      Result.Failure {error} => { fail error }
    }
    let member = match move next {
      Option<TarMember>.Some {value} => move value
      Option<TarMember>.None => { break }
    }
    let whole = run path(&member)
    let name = Bytes.asSlice(&whole)
    if seen == 0 && !(same(name, b"pkg-1.0.0") && member.kind == TarKind.Directory) { return 10 }
    if seen == 1 && !(same(name, b"pkg-1.0.0/silk.toml") && !member.executable && same(member.content, b"[package]\nname = \"pkg\"\n")) { return 11 }
    if seen == 2 && !(same(name, b"pkg-1.0.0/bin/tool") && member.executable && same(member.content, b"\x7fELF")) { return 12 }
    if seen == 3 && !(same(name, Bytes.asSlice(&split)) && member.prefix.length > 0 && same(member.content, b"split")) { return 13 }
    if seen == 4 && !(same(name, Bytes.asSlice(&long)) && member.prefix.length == 0 && member.content.length == 0) { return 14 }
    seen = seen + 1
  }
  if seen != 5 { return 4 }
  let refusedPaths: [&[u8]; 5] = [b"", b"/etc/passwd", b"a/../b", b"dir/", b"a\\b"]
  let mut at: usize = 0
  while at < refusedPaths.length {
    let refusedPath = run refused(refusedPaths[at])
    if !refusedPath { return 5 }
    at = at + 1
  }
  return 42
}

pub effect fn main() -> i32 ! TarError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run check() |> Effect.provideMut<Allocator>(&mut allocator)
}
