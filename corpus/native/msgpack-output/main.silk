import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.msgpack.output { MsgpackOutput }
import silk.msgpack.scanner { MsgpackError }
import silk.text.string { InvalidUtf8, String }

// Keeps the first 64 bytes written and counts all of them.
struct Capture {
  bytes: [u8; 64],
  kept: usize,
  total: usize
}

impl Writer for Capture {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> ()
    ! WriterError
    ? &mut Writer {
    let mut at: usize = 0
    while at < value.length && self.kept < 64 {
      self.bytes[self.kept] = value[at]
      self.kept = self.kept + 1
      at = at + 1
    }
    self.total = self.total + value.length
    return ()
  }

  effect fn flush(self: &mut Self) -> ()
    ! WriterError
    ? &mut Writer {
    return ()
  }
}

impl Capture {
  fn make() -> Capture {
    return Capture { bytes: [0; 64], kept: 0, total: 0 }
  }

  // Whether exactly `expected` was written.
  fn wrote(self: &Self, expected: &[u8]) -> bool {
    return self.total == expected.length && Slice.view<u8>(&self.bytes, 0, self.kept) == expected
  }

  // Whether `header` was written and then `length` bytes that start with `fill`.
  fn started(self: &Self, header: &[u8], length: usize, fill: u8) -> bool {
    if self.total != header.length + length
      || Slice.view<u8>(&self.bytes, 0, header.length) != header {
      return false
    }
    return length == 0 || self.bytes[header.length] == fill
  }
}

effect fn unsigned(value: u64, expected: &[u8]) -> bool
  ! WriterError {
  let mut capture = Capture.make()
  run MsgpackOutput.writeUnsigned(value) |> Effect.provideMut<Writer>(&mut capture)
  return capture.wrote(expected)
}

effect fn signed(value: i64, expected: &[u8]) -> bool
  ! WriterError {
  let mut capture = Capture.make()
  run MsgpackOutput.writeSigned(value) |> Effect.provideMut<Writer>(&mut capture)
  return capture.wrote(expected)
}

// Writes a string of `length` letters and checks the header and the total length.
effect fn text(length: usize, header: &[u8]) -> bool
  ! MsgpackError | WriterError {
  let letters: [u8; 65536] = [97; 65536]
  let value = match String.fromUtf8(Slice.view<u8>(&letters, 0, length)) {
    Result<string, InvalidUtf8>.Success { value } => value
    Result<string, InvalidUtf8>.Failure { .. } => {
      return false
    }
  }
  let mut capture = Capture.make()
  run MsgpackOutput.writeString(value) |> Effect.provideMut<Writer>(&mut capture)
  return capture.started(header, length, 97)
}

effect fn binary(length: usize, header: &[u8]) -> bool
  ! MsgpackError | WriterError {
  let data: [u8; 65536] = [7; 65536]
  let mut capture = Capture.make()
  run MsgpackOutput.writeBinary(Slice.view<u8>(&data, 0, length))
    |> Effect.provideMut<Writer>(&mut capture)
  return capture.started(header, length, 7)
}

effect fn extension(kind: i8, length: usize, header: &[u8]) -> bool
  ! MsgpackError | WriterError {
  let data: [u8; 65536] = [7; 65536]
  let mut capture = Capture.make()
  run MsgpackOutput.writeExtension(kind, Slice.view<u8>(&data, 0, length))
    |> Effect.provideMut<Writer>(&mut capture)
  return capture.started(header, length, 7)
}

effect fn array(count: usize, expected: &[u8]) -> bool
  ! MsgpackError | WriterError {
  let mut capture = Capture.make()
  run MsgpackOutput.writeArrayHeader(count) |> Effect.provideMut<Writer>(&mut capture)
  return capture.wrote(expected)
}

effect fn map(count: usize, expected: &[u8]) -> bool
  ! MsgpackError | WriterError {
  let mut capture = Capture.make()
  run MsgpackOutput.writeMapHeader(count) |> Effect.provideMut<Writer>(&mut capture)
  return capture.wrote(expected)
}

effect fn scalars() -> i32
  ! WriterError {
  let mut capture = Capture.make()
  run MsgpackOutput.writeNil() |> Effect.provideMut<Writer>(&mut capture)
  run MsgpackOutput.writeBool(false) |> Effect.provideMut<Writer>(&mut capture)
  run MsgpackOutput.writeBool(true) |> Effect.provideMut<Writer>(&mut capture)
  run MsgpackOutput.writeFloat(1.5) |> Effect.provideMut<Writer>(&mut capture)
  if !capture.wrote(b"\xc0\xc2\xc3\xcb\x3f\xf8\x00\x00\x00\x00\x00\x00") {
    return 1
  }

  // Each width is used from the first value the shorter one cannot hold.
  if !(run unsigned(0, b"\x00")) || !(run unsigned(127, b"\x7f"))
    || !(run unsigned(128, b"\xcc\x80"))
    || !(run unsigned(255, b"\xcc\xff")) {
    return 2
  }
  if !(run unsigned(256, b"\xcd\x01\x00")) || !(run unsigned(65535, b"\xcd\xff\xff"))
    || !(run unsigned(65536, b"\xce\x00\x01\x00\x00"))
    || !(run unsigned(4294967295, b"\xce\xff\xff\xff\xff")) {
    return 3
  }
  if !(run unsigned(4294967296, b"\xcf\x00\x00\x00\x01\x00\x00\x00\x00"))
    || !(run unsigned(18446744073709551615, b"\xcf\xff\xff\xff\xff\xff\xff\xff\xff")) {
    return 4
  }

  // A value of 0 or more has the bytes `writeUnsigned` gives it.
  if !(run signed(0, b"\x00")) || !(run signed(200, b"\xcc\xc8"))
    || !(run signed(9223372036854775807, b"\xcf\x7f\xff\xff\xff\xff\xff\xff\xff")) {
    return 5
  }
  if !(run signed(-1, b"\xff")) || !(run signed(-32, b"\xe0")) || !(run signed(-33, b"\xd0\xdf"))
    || !(run signed(-128, b"\xd0\x80")) {
    return 6
  }
  if !(run signed(-129, b"\xd1\xff\x7f")) || !(run signed(-32768, b"\xd1\x80\x00"))
    || !(run signed(-32769, b"\xd2\xff\xff\x7f\xff"))
    || !(run signed(-2147483648, b"\xd2\x80\x00\x00\x00")) {
    return 7
  }
  if !(run signed(-2147483649, b"\xd3\xff\xff\xff\xff\x7f\xff\xff\xff"))
    || !(run signed(-9223372036854775807 - 1, b"\xd3\x80\x00\x00\x00\x00\x00\x00\x00")) {
    return 8
  }
  return 0
}

effect fn lengths() -> i32
  ! MsgpackError | WriterError {
  let mut capture = Capture.make()
  run MsgpackOutput.writeString("h\u{e9}") |> Effect.provideMut<Writer>(&mut capture)
  if !capture.wrote(b"\xa3h\xc3\xa9") {
    return 20
  }
  if !(run text(0, b"\xa0")) || !(run text(31, b"\xbf")) || !(run text(32, b"\xd9\x20"))
    || !(run text(255, b"\xd9\xff")) {
    return 21
  }
  if !(run text(256, b"\xda\x01\x00")) || !(run text(65535, b"\xda\xff\xff"))
    || !(run text(65536, b"\xdb\x00\x01\x00\x00")) {
    return 22
  }
  if !(run binary(0, b"\xc4\x00")) || !(run binary(255, b"\xc4\xff"))
    || !(run binary(256, b"\xc5\x01\x00"))
    || !(run binary(65535, b"\xc5\xff\xff"))
    || !(run binary(65536, b"\xc6\x00\x01\x00\x00")) {
    return 23
  }

  // 1, 2, 4, 8 and 16 bytes have a header of their own; every other length says its length.
  if !(run extension(5, 1, b"\xd4\x05")) || !(run extension(-1, 2, b"\xd5\xff"))
    || !(run extension(1, 4, b"\xd6\x01"))
    || !(run extension(1, 8, b"\xd7\x01"))
    || !(run extension(-128, 16, b"\xd8\x80")) {
    return 24
  }
  if !(run extension(9, 0, b"\xc7\x00\x09")) || !(run extension(9, 3, b"\xc7\x03\x09"))
    || !(run extension(9, 17, b"\xc7\x11\x09"))
    || !(run extension(9, 256, b"\xc8\x01\x00\x09"))
    || !(run extension(9, 65536, b"\xc9\x00\x01\x00\x00\x09")) {
    return 25
  }
  if !(run array(0, b"\x90")) || !(run array(15, b"\x9f")) || !(run array(16, b"\xdc\x00\x10"))
    || !(run array(65535, b"\xdc\xff\xff"))
    || !(run array(65536, b"\xdd\x00\x01\x00\x00")) {
    return 26
  }
  if !(run map(0, b"\x80")) || !(run map(15, b"\x8f")) || !(run map(16, b"\xde\x00\x10"))
    || !(run map(65535, b"\xde\xff\xff"))
    || !(run map(65536, b"\xdf\x00\x01\x00\x00")) {
    return 27
  }
  return 0
}

pub effect fn main() -> i32
  ! MsgpackError | WriterError {
  let first = run scalars()
  if first != 0 {
    return first
  }
  return run lengths()
}
