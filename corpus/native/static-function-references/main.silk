// A static description holds checks of different contracts as erased function references, and
// the code that reads one restores its contract and calls it directly (STATIC-021).

struct Rule {
  pub label: string<'static>,
  pub check: Intrinsic.FunctionRef,
}

fn positive(value: &u32) -> bool {
  return value.* > 0
}

fn short(text: &string<'static>) -> bool {
  return text.* != "too long"
}

static fn rules() -> [Rule; 2] {
  return [
    Rule {label: "count", check: Intrinsic.functionRef<fn<'static>(&u32) -> bool>(positive)},
    Rule {label: "name", check: Intrinsic.functionRef<fn<'static>(&string<'static>) -> bool>(short)},
  ]
}

static fn checkAt<V>(at: usize) -> fn<'static>(&V) -> bool {
  let listed = rules()
  return Intrinsic.functionAs<fn<'static>(&V) -> bool>(listed[at].check)
}

fn valid<V>(static at: usize, value: &V) -> bool {
  let static check = checkAt<V>(at)
  return check(value)
}

pub fn main() -> i32 {
  let mut score = 0
  let three: u32 = 3
  let zero: u32 = 0
  let name: string<'static> = "silk"
  if valid<u32>(0, &three) { score = score + 1 }
  if !valid<u32>(0, &zero) { score = score + 2 }
  if valid<string<'static>>(1, &name) { score = score + 4 }
  return score
}
