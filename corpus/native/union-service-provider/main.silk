import silk.core.ownership { Drop }
import silk.mem.pointer { Pointer }
import silk.core.effect { Effect }
// A union serves a service when every member does: each operation receives the active member.
struct Step { by: i32, drops: *mut i32 }
impl Drop for Step {
  fn drop(self: &mut Step) -> () { unsafe { Pointer.write(self.drops, Pointer.read(self.drops) + 1) } }
}
service Input { effect fn count(step: Step) -> i32 ? &mut Input }
struct First { value: i32 }
struct Second { value: i32 }
impl Input for First {
  effect fn count(self: &mut First, step: &Step) -> i32 {
    self.value = self.value + step.by
    return self.value
  }
}
impl Input for Second {
  effect fn count(self: &mut Second, step: Step) -> i32 { return self.value * step.by }
}
effect fn twice(drops: *mut i32) -> i32 ? &mut Input {
  let a = run Input.count(Step { by: 1, drops: drops })
  let b = run Input.count(Step { by: 2, drops: drops })
  return a + b
}
fn pick(flag: bool) -> First | Second {
  if flag { return First { value: 4 } }
  return Second { value: 8 }
}
pub fn main() -> i32 {
  let mut drops = 0
  let counter = Pointer.fromMutRef<i32>(&mut drops)
  let mut left = pick(true)
  let mut right = pick(false)
  let a = run twice(counter) |> Effect.provideMut<Input>(&mut left)
  let b = run twice(counter) |> Effect.provideMut<Input>(&mut right)
  if drops != 4 { return 100 + drops }
  let kept = match move left { First first => first.value Second _ => 0 }
  if kept != 7 { return 110 }
  return a + b + 6
}
