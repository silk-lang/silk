import silk.core.reflect { Reflect, arrayKind, otherKind, anonymousPositionalKind }

// A slice can provide an interface, as `string` and the scalars do. `&[T]` and `&mut [T]` are
// separate providers.
interface Measure {
  fn measure(self: &Self) -> usize
}

impl<'a, T> Measure for &'a [T] {
  fn measure(self: &Self) -> usize { return self.*.length }
}

impl<'a, T> Measure for &'a mut [T] {
  fn measure(self: &Self) -> usize { return self.*.length * 10 }
}

impl Measure for i32 {
  fn measure(self: &Self) -> usize { return 100 }
}

struct Wrap<T> { value: T }

impl<T: Measure> Measure for Wrap<T> {
  fn measure(self: &Self) -> usize { return Measure.measure(&self.value) + 1000 }
}

fn generic<T: Measure>(value: &T) -> usize { return Measure.measure(value) }

// Every type has a reflected kind, so one generic body can branch on arrays and scalars.
fn kindOf<T>(value: &T) -> u8 {
  static if Reflect.typeKind(Reflect.typeOf<T>()) == arrayKind { return arrayKind }
  static if Reflect.typeKind(Reflect.typeOf<T>()) == anonymousPositionalKind { return anonymousPositionalKind }
  return otherKind
}

pub fn main() -> i32 {
  let mut values = [1, 2, 3]
  let shared: &[i32] = &values
  // `&shared` borrows the slice itself where a reference is expected.
  if Measure.measure(&shared) != 3 { return 1 }
  if generic(&shared) != 3 { return 2 }
  let wrapped = Wrap<&[i32]> { value: shared }
  if generic(&wrapped) != 1003 { return 3 }
  let number: i32 = 7
  if generic(&number) != 100 { return 4 }
  let exclusive: &mut [i32] = &mut values
  if Measure.measure(&exclusive) != 30 { return 5 }
  if kindOf(&values) != arrayKind || kindOf(&number) != otherKind || kindOf(&(1, 2)) != anonymousPositionalKind {
    return 6
  }
  return 42
}
