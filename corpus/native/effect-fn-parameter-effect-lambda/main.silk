struct Config {
  level: i32,
}

effect fn when<'env>(config: Config, enabled: bool, transform: once effect fn<'env>(Config) -> Config) -> Config {
  if enabled { return run transform(move config) }
  return move config
}

effect fn raise(config: Config) -> Config {
  return Config { level: config.level + 1 }
}

pub effect fn main() -> i32 {
  let base = Config { level: 1 }
  let raised = run when(move base, true, effect |c: Config| -> Config { return Config { level: c.level + 20 } })
  let kept = run when(move raised, false, effect |c| { return Config { level: c.level + 100 } })
  // A plain lambda that returns the Effect without running it is an `effect fn` value too.
  let stepped = run when(move kept, true, |c| raise(move c))
  let last = run when(move stepped, true, effect |c| { return Config { level: c.level + 20 } })
  return last.level
}
