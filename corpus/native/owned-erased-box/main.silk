import silk.collections.list { List }
import silk.concurrency.thread { Concurrent, Transferable }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.ownership { Drop }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.any_box { AnyBox }
import silk.mem.shared { Shared }
import silk.testing.testing { AssertionError, Testing }
import silk.num.i64

struct DropLog {
  pub offsetDrops: i32,
  pub pairDrops: i32,
  pub checksum: i32,
}

fn recordOffset(log: &mut DropLog) -> () {
  log.offsetDrops = log.offsetDrops + 1
  log.checksum = log.checksum + 10
  return ()
}

fn recordPair(log: &mut DropLog) -> () {
  log.pairDrops = log.pairDrops + 1
  log.checksum = log.checksum + 100
  return ()
}

fn readOffsetDrops(log: &DropLog) -> i32 {
  return log.offsetDrops
}

fn readPairDrops(log: &DropLog) -> i32 {
  return log.pairDrops
}

fn readChecksum(log: &DropLog) -> i32 {
  return log.checksum
}

interface Counter {
  fn read(self: &Self) -> i32
  fn bump(self: &mut Self, delta: i32) -> i32
}

struct ZeroCounter {}

impl Counter for ZeroCounter {
  fn read(self: &Self) -> i32 {
    return 7
  }

  fn bump(self: &mut Self, delta: i32) -> i32 {
    return 7 + delta
  }
}

struct OffsetCounter {
  value: i32,
  log: Shared<DropLog>,
}

impl Counter for OffsetCounter {
  fn read(self: &Self) -> i32 {
    return self.value
  }

  fn bump(self: &mut Self, delta: i32) -> i32 {
    self.value = self.value + delta
    return self.value
  }
}

impl Drop for OffsetCounter {
  fn drop(self: &mut Self) -> () {
    Shared<DropLog>.withMut(&self.log, recordOffset)
    return ()
  }
}

struct PairCounter {
  left: i64,
  right: i32,
  log: Shared<DropLog>,
}

impl Counter for PairCounter {
  fn read(self: &Self) -> i32 {
    return i64.toI32(self.left) + self.right
  }

  fn bump(self: &mut Self, delta: i32) -> i32 {
    self.right = self.right + delta
    return i64.toI32(self.left) + self.right
  }
}

impl Drop for PairCounter {
  fn drop(self: &mut Self) -> () {
    Shared<DropLog>.withMut(&self.log, recordPair)
    return ()
  }
}

interface Tagged {
  fn tag(self: &Self) -> i32
}

struct SafeWorker {
  id: i32,
  scale: i32,
}

impl Counter for SafeWorker {
  fn read(self: &Self) -> i32 {
    return self.id * self.scale
  }

  fn bump(self: &mut Self, delta: i32) -> i32 {
    self.id = self.id + delta
    return self.id * self.scale
  }
}

impl Tagged for SafeWorker {
  fn tag(self: &Self) -> i32 {
    return self.id + 1000
  }
}

fn requireTransferable<T: Intrinsic.Transferable>(value: &T) -> bool {
  return true
}

fn requireConcurrent<T: Intrinsic.Concurrent>(value: &T) -> bool {
  return true
}

struct Holder {
  pub boxed: AnyBox<any Counter>,
}

effect fn makePairBox(left: i64, right: i32, log: Shared<DropLog>) -> AnyBox<any Counter>
! OutOfMemoryError ? &mut Allocator {
  return run AnyBox<any Counter>.make(PairCounter { left: left, right: right, log: move log })
}

effect fn exerciseZeroSizedAndOverwrite(log: Shared<DropLog>) -> ()
! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut zst = run AnyBox<any Counter>.make(ZeroCounter {})
  run Testing.expect(zst.get().read() == 7, "ZeroCounter read returns 7")
  run Testing.expect(zst.getMut().bump(5) == 12, "ZeroCounter bump returns 12")
  drop zst

  let mut slot = run AnyBox<any Counter>.make(OffsetCounter { value: 10, log: Shared<DropLog>.clone(&log) })
  run Testing.expect(slot.get().read() == 10, "initial OffsetCounter value is 10")
  run Testing.expect(slot.getMut().bump(3) == 13, "mutated OffsetCounter value is 13")
  slot = run makePairBox(20, 2, Shared<DropLog>.clone(&log))
  run Testing.expect(Shared<DropLog>.with(&log, readOffsetDrops) == 1, "reassignment dropped OffsetCounter")
  run Testing.expect(Shared<DropLog>.with(&log, readPairDrops) == 0, "PairCounter still live")
  run Testing.expect(slot.getMut().bump(8) == 30, "mutated PairCounter value is 30")
  return ()
}

effect fn exerciseHeterogeneousList(log: Shared<DropLog>) -> ()
! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut list = List<AnyBox<any Counter>>.make()
  run List<AnyBox<any Counter>>.append(
    &mut list,
    run AnyBox<any Counter>.make(OffsetCounter { value: 1, log: Shared<DropLog>.clone(&log) }),
  )
  run List<AnyBox<any Counter>>.append(
    &mut list,
    run makePairBox(100, 5, Shared<DropLog>.clone(&log)),
  )
  run List<AnyBox<any Counter>>.append(
    &mut list,
    run AnyBox<any Counter>.make(ZeroCounter {}),
  )

  let mutableSlice = List<AnyBox<any Counter>>.asMutSlice(&mut list)
  run Testing.expect(mutableSlice[0].getMut().bump(4) == 5, "list[0] OffsetCounter mutates to 5")
  run Testing.expect(mutableSlice[1].getMut().bump(10) == 115, "list[1] PairCounter mutates to 115")
  run Testing.expect(mutableSlice[2].get().read() == 7, "list[2] ZeroCounter reads 7")

  let removed = List<AnyBox<any Counter>>.remove(&mut list, 0)
  run Testing.expect(removed.get().read() == 5, "removed element kept state")
  drop removed
  run Testing.expect(Shared<DropLog>.with(&log, readOffsetDrops) == 2, "dropping removed element dropped OffsetCounter")
  run Testing.expect(Shared<DropLog>.with(&log, readPairDrops) == 1, "PairCounter still live in list")
  return ()
}

effect fn ownedErasedBoxDispatchesDropsAndSupportsZeroSizedTypes() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let log = run Shared<DropLog>.make(DropLog { offsetDrops: 0, pairDrops: 0, checksum: 0 })
    |> Effect.provideMut<Allocator>(&mut allocator)

  run exerciseZeroSizedAndOverwrite(Shared<DropLog>.clone(&log))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared<DropLog>.with(&log, readPairDrops) == 1, "scope exit dropped PairCounter")

  run exerciseHeterogeneousList(Shared<DropLog>.clone(&log))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared<DropLog>.with(&log, readPairDrops) == 2, "dropping list dropped remaining PairCounter")

  let mut maybe: Option<AnyBox<any Counter>> = Option<AnyBox<any Counter>>.some(
    run AnyBox<any Counter>.make(OffsetCounter { value: 40, log: Shared<DropLog>.clone(&log) })
      |> Effect.provideMut<Allocator>(&mut allocator),
  )
  let holder = match move maybe {
    Option<AnyBox<any Counter>>.Some { value } => Holder { boxed: move value }
    Option<AnyBox<any Counter>>.None => Holder {
      boxed: run AnyBox<any Counter>.make(ZeroCounter {}) |> Effect.provideMut<Allocator>(&mut allocator),
    }
  }
  run Testing.expect(holder.boxed.get().read() == 40, "Option unwrap moved AnyBox into struct field")
  drop holder
  run Testing.expect(Shared<DropLog>.with(&log, readOffsetDrops) == 3, "dropping struct field dropped OffsetCounter")
  run Testing.expect(Shared<DropLog>.with(&log, readChecksum) == 230, "all concrete Drop hooks ran once each")
}

effect fn ownedErasedBoxSupportsTransferableConcurrentAndNarrowing() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let transferOnly = run AnyBox<any Counter + Transferable>.make(SafeWorker { id: 3, scale: 4 })
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(requireTransferable(&transferOnly), "Transferable propagates from E")
  run Testing.expect(transferOnly.get().read() == 12, "Transferable AnyBox dispatches")

  let full: AnyBox<any Counter + Tagged + Transferable + Concurrent> = run AnyBox<any Counter + Tagged + Transferable + Concurrent>.make(
    SafeWorker { id: 5, scale: 6 },
  ) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(requireTransferable(&full), "Transferable + Concurrent is Transferable")
  run Testing.expect(requireConcurrent(&full), "Transferable + Concurrent propagates Concurrent")
  run Testing.expect(full.get().tag() == 1005, "joined interface method dispatches")

  let narrowed = full.narrow<any Counter + Transferable>()
  run Testing.expect(requireTransferable(&narrowed), "narrowed contract preserves Transferable")
  run Testing.expect(narrowed.get().read() == 30, "narrowed AnyBox preserves concrete value")

  let erasedCounter = narrowed.narrow<any Counter>()
  run Testing.expect(erasedCounter.get().read() == 30, "narrowing to single interface preserves value")
}

effect fn runAll() -> i32 ! OutOfMemoryError | AssertionError<'static> {
  run ownedErasedBoxDispatchesDropsAndSupportsZeroSizedTypes()
  run ownedErasedBoxSupportsTransferableConcurrentAndNarrowing()
  return 0
}

effect fn failed(error: OutOfMemoryError | AssertionError<'static>) -> i32 {
  drop error
  return 1
}

pub fn main() -> i32 {
  return run Effect.catchAll(runAll(), failed)
}
