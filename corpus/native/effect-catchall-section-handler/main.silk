// A section supplies trailing arguments, so a handler section leaves its leading failure open.
import silk.core.effect { Effect }

struct Problem {
  code: i32,
}

effect fn load() -> i32
! Problem {
  fail Problem {code: 2}
}

effect fn recover(error: Problem, fallback: i32) -> i32 {
  return fallback + error.code
}

pub fn main() -> i32 {
  return run Effect.catchAll(load(), recover(40))
}
