import silk.core.effect { Effect }

pub enum Problem {
  TooSmall,
}

pub service Source {
  effect fn next() -> i32 ? &Source
}

pub struct Fixed {
  value: i32,
}

impl Source for Fixed {
  effect fn next(self: &Self) -> i32
    ? &Source {
    return self.value
  }
}

effect fn checked(value: i32) -> i32
  ! Problem {
  if value < 10 {
    fail Problem.TooSmall
  }
  return value
}

effect fn recovered(problem: Problem) -> i32 {
  return 0
}

// A lambda that writes its result may write its failure and requirement rows after it, as an
// `effect fn` declaration does; the binding takes exactly that contract.
pub fn main() -> i32 {
  let read = effect |offset: i32| -> i32
    ! Problem
    ? &Source {
    let value = run Source.next()
    return run checked(value + offset)
  }
  let source = Fixed { value: 30 }
  let total = run Effect.catchAll(read(12) |> Effect.provide(&source), recovered)
  let small = run Effect.catchAll(read(-25) |> Effect.provide(&source), recovered)
  if small != 0 {
    return 1
  }
  return total
}
