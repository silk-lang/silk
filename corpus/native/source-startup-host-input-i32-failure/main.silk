import silk.system.host_input { HostInput, HostInputError }
import silk.format { Debug, Format, Formatter }
import silk.io.writer { Writer, WriterError }
pub struct StartupProblem {}
pub effect fn main() -> i32 ! StartupProblem | HostInputError ? &mut HostInput {
  let count = run HostInput.argumentCount()
  fail StartupProblem {}
}

impl Debug for StartupProblem {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return run Format.debugFields(self, "StartupProblem", &mut formatter)
  }
}
