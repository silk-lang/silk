import silk.num.i8
import silk.num.f64

struct Record { signed: i8, real: f64, flag: bool }
fn matches(record: &Record) -> bool {
  return record.signed < 0 && record.real > 1.5 && record.flag
}
fn update(record: &mut Record) -> i32 {
  let prior = record.signed
  record.signed = 7
  if prior >= 0 || record.signed != 7 { return 1 }
  record.flag = false
  if record.flag { return 2 }
  return 42
}
pub fn main() -> i32 {
  let mut record = Record {signed: -5, real: 2.5, flag: true}
  if !matches(&record) { return 3 }
  return update(&mut record)
}
