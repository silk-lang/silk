import silk.core.effect { Effect }
import silk.text.utf8_scan
import silk.text.utf8_scan { Decoded }
import silk.testing.testing { Testing, AssertionError }
import silk.core.option { Option }
import silk.text.utf8_decoder { Utf8Decoder, Utf8Step }
import silk.collections.slice { Slice }
import silk.num.u8
import silk.num.usize

effect fn scalarByteOffsets() -> ()
  ! AssertionError<'static> {
  let bytes = b"A\xc3\xa9\xe0\xa4\x95\xf0\x9f\x98\x80"
  let ascii = utf8_scan.decode(bytes, 0)
  let latin = utf8_scan.decode(bytes, ascii.next)
  let indic = utf8_scan.decode(bytes, latin.next)
  let emoji = utf8_scan.decode(bytes, indic.next)
  run Testing.expect(ascii.scalar == 0x41 && ascii.next == 1, "ASCII byte range")
  run Testing.expect(latin.scalar == 0xe9 && latin.next == 3, "two-byte scalar range")
  run Testing.expect(indic.scalar == 0x915 && indic.next == 6, "three-byte scalar range")
  run Testing.expect(emoji.scalar == 0x1f600 && emoji.next == 10, "four-byte scalar range")
}

effect fn invalidUtf8PreservesByteProgress() -> ()
  ! AssertionError<'static> {
  let bad = b"\xc0\xaf\xed\xa0\x80\xf4\x90\x80\x80\xe2\x82"
  let mut at: usize = 0
  while at < bad.length {
    let decoded = utf8_scan.decode(bad, at)
    run Testing.expect(
      decoded.scalar == 0xfffd && decoded.next == at + 1,
      "one replacement per invalid byte",
    )
    at = decoded.next
  }
  let eof = utf8_scan.decode(bad, bad.length)
  run Testing.expect(eof.next == bad.length, "EOF does not advance")
  let mixed = utf8_scan.decode(b"\xe2A", 0)
  let following = utf8_scan.decode(b"\xe2A", mixed.next)
  run Testing.expect(
    following.scalar == 0x41 && following.next == 2,
    "invalid prefix preserves following ASCII",
  )
}

// The previous stdlib-decoder implementation, kept as a differential oracle.
fn referenceDecode(bytes: &[u8], at: usize) -> Decoded {
  if at >= bytes.length {
    return Decoded { scalar: 0xfffd, next: bytes.length }
  }
  if bytes[at] < 128 {
    return Decoded { scalar: u8.toU32(bytes[at]), next: at + 1 }
  }
  let mut decoder = Utf8Decoder.make()
  let mut cursor = at
  while cursor < bytes.length && cursor - at < 4 {
    let step = Utf8Decoder.step(&mut decoder, bytes[cursor], cursor)
    cursor = cursor + 1
    match &step {
      Utf8Step.Scalar { value } => {
        return Decoded { scalar: value, next: cursor }
      }
      Utf8Step.Invalid { offset: _ } => {
        return Decoded { scalar: 0xfffd, next: at + 1 }
      }
      Utf8Step.NeedMore => {}
    }
  }
  return Decoded { scalar: 0xfffd, next: at + 1 }
}

effect fn decoderMatchesStdlibDecoder() -> ()
  ! AssertionError<'static> {
  let tails: [u8; 4] = [0x80, 0xbf, 0x41, 0xc3]
  let mut buffer: [u8; 4] = [0; 4]
  let mut mismatches: usize = 0
  let mut lead: usize = 0
  while lead < 256 {
    let mut second: usize = 0
    while second < 256 {
      let mut third: usize = 0
      while third < 4 {
        let mut fourth: usize = 0
        while fourth < 4 {
          buffer[0] = usize.wrappingToU8(lead)
          buffer[1] = usize.wrappingToU8(second)
          buffer[2] = tails[third]
          buffer[3] = tails[fourth]
          let mut length: usize = 1
          while length <= 4 {
            let slice = Slice.view<u8>(&buffer, 0, length)
            let actual = utf8_scan.decode(slice, 0)
            let expected = referenceDecode(slice, 0)
            if actual.scalar != expected.scalar || actual.next != expected.next {
              mismatches = mismatches + 1
            }
            length = length + 1
          }
          fourth = fourth + 1
        }
        third = third + 1
      }
      second = second + 1
    }
    lead = lead + 1
  }
  run Testing.expect(mismatches == 0, "decoder agrees with the stdlib UTF-8 decoder")
}

// Each check above runs in order; the first failed assertion ends the program with its own code.
effect fn all() -> i32
  ! AssertionError<'static> {
  run scalarByteOffsets()
  run invalidUtf8PreservesByteProgress()
  run decoderMatchesStdlibDecoder()
  return 42
}

effect fn assertionFailed(error: AssertionError<'static>) -> i32 {
  return 1
}

pub fn main() -> i32 {
  return run Effect.catch(all(), assertionFailed)
}
