// A connection taken out of `Accepted` stays open after the accept, like one served across frames.
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.io.byte_duplex {ByteDuplex, ByteIoError, ReadTransfer}
import silk.net.address {Endpoint, IpAddress, Ipv4Address, Port}
import silk.net.socket_native {BoundAddress, Connection, ConnectionPhase, ConnectOptions, ListenOptions, NativeSocketError, accept, connectResolvedOwned, listen}
import silk.system.monotonic_clock {MonotonicClock}
import silk.system.monotonic_clock_native {OsMonotonicClock}
import silk.system.system_clock {Instant}
import silk.num.u8
import silk.num.usize

fn loopback() -> Endpoint {
  return Endpoint.make(IpAddress.V4 {value: Ipv4Address.fromOctets([127, 0, 0, 1])}, Port.fromU16(0))
}

// Writes `byte` on `from` and returns the byte `to` reads, or -1.
effect fn relay(from: &mut Connection, to: &mut Connection, byte: u8) -> i32 ! ByteIoError ? &mut MonotonicClock {
  let written = run ByteDuplex.writeSome(&[byte], Option<Instant>.none()) |> Effect.provideMut<ByteDuplex>(&mut from.*)
  if written != usize.ONE { return -1 }
  let mut input: [u8; 1] = [0]
  let read = run ByteDuplex.readSome(&mut input, Option<Instant>.none()) |> Effect.provideMut<ByteDuplex>(&mut to.*)
  return match move read {
    ReadTransfer.Data {count} => if count == usize.ONE { u8.toI32(input[0]) } else { -1 }
    ReadTransfer.End => -1
  }
}

effect fn program() -> i32 ! NativeSocketError | ByteIoError ? &mut MonotonicClock {
  let mut listener = run listen(loopback(), ListenOptions.defaults())
  let bound = match listener.boundAddress() {
    BoundAddress.Tcp {endpoint} => endpoint
    _ => { return 1 }
  }
  let mut client = run connectResolvedOwned(&[bound], ConnectOptions.defaults(), Option<Instant>.none())
  let accepted = run accept(&mut listener, Option<Instant>.none())
  let mut served = accepted.intoConnection()
  if served.phase() != ConnectionPhase.Open { return 2 }
  // Two exchanges in separate calls: the connection outlives the accept.
  if (run relay(&mut client, &mut served, 20)) != 20 { return 3 }
  if (run relay(&mut served, &mut client, 22)) != 22 { return 4 }
  run served.close()
  run client.close()
  return 42
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  return 100
}

pub fn main() -> i32 {
  let mut clock = OsMonotonicClock.make()
  return run Effect.catchAll(program(), failed) |> Effect.provideMut<MonotonicClock>(&mut clock)
}
