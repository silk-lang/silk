import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.concurrency.sync { Arc }
import silk.trace.record { Recorder, Config, Memory }
import silk.trace { SpanKind, Tracer }
import silk.trace.values { Value }
import silk.core.reflect { Reflect }

struct Item { value: i32 }
impl Item {
  @trace
  fn count(self: &Self) -> i32 { return self.value }
}
@trace(args: .("value", "tag", "borrowed", "nested"), kind: "client")
fn generic<T>(static tag: i32, value: T, borrowed: &mut i32, nested: & &i32) -> T {
  borrowed.* = 13
  return move value
}
fn call<R>(borrowed: &mut i32, input: &R) -> i32 {
  static for field in Reflect.fields<R>() {
    return generic<i32>(7, Item {value: 42}.count(), &mut borrowed, Reflect.borrowField(input, field))
  }
  return -1
}
@trace
fn plain() -> i32 {
  let mut borrowed = 5
  let nested = 6
  let result = call(&mut borrowed, &.{p: &nested})
  if borrowed != 13 { return -2 }
  return result
}
@trace(name: "work", kind: "server")
effect fn traced() -> i32 { return plain() }

effect fn exercise() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let recorder = run Arc<Recorder>.make(run Recorder.make(Config.make("test")))
  let answer = run traced() |> Effect.provideAmbient<Tracer>(&recorder)
  if answer != 42 { return 1 }
  let mut memory = Memory.make()
  run memory.drain(recorder.get())
  let spans = memory.spans()
  if spans.length != 4 { return 2 }
  if spans[0].name != spans[0].place.function || spans[0].name != "memory/driver.Item.count" { return 3 }
  if spans[1].name != "memory/driver.generic" || spans[1].kind != SpanKind.Client { return 4 }
  if spans[1].attributes.count != 4 || spans[1].attributes.items[0].key != "value" { return 5 }
  if let Value.Integer {value} = &spans[1].attributes.items[0].value { if value != 42 { return 6 } } else { return 7 }
  if spans[1].attributes.items[1].key != "tag" { return 11 }
  if let Value.Integer {value} = &spans[1].attributes.items[1].value { if value != 7 { return 12 } } else { return 13 }
  if let Value.Integer {value} = &spans[1].attributes.items[2].value { if value != 5 { return 14 } } else { return 15 }
  if let Value.Integer {value} = &spans[1].attributes.items[3].value { if value != 6 { return 16 } } else { return 17 }
  if spans[2].name != "memory/driver.plain" || spans[3].name != "work" || spans[3].kind != SpanKind.Server { return 8 }
  if spans[3].place.function != "memory/driver.traced" || spans[3].place.file != "memory/driver.silk" { return 9 }
  if spans[0].parent.span != spans[2].context.span || spans[2].parent.span != spans[3].context.span { return 10 }
  return 0
}
effect fn failed(error: OutOfMemoryError) -> i32 { return 99 }
pub fn main() -> i32 {
  let mut alloc = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(exercise() |> Effect.provideMut<Allocator>(&mut alloc), failed)
}
