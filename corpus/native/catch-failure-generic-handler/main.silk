struct OutOfRange { code: i32 }
struct Rejected { code: i32 }
pub struct Caught<E> { pub error: E }

// One generic handler serves every selection: the selected failure type picks its instance.
effect fn caught<E>(error: E) -> Caught<E> {
  return Caught<E> { error: move error }
}

effect fn check(x: i32) -> i32 ! OutOfRange | Rejected {
  if x > 100 { fail OutOfRange { code: x } }
  if x > 50 { fail Rejected { code: x } }
  return x + 1
}

fn both(x: i32) -> i32 {
  let result = run Intrinsic.catchFailure<OutOfRange | Rejected>(check(x), caught)
  return match move result {
    i32 value => value
    Caught<OutOfRange | Rejected> {error} => match move error {
      OutOfRange {code} => code - 100
      Rejected {code} => code - 50
    }
  }
}

effect fn one(x: i32) -> i32 ! Rejected {
  let result = run Intrinsic.catchFailure<OutOfRange>(check(x), caught)
  return match move result {
    i32 value => value
    Caught<OutOfRange> {error} => error.code - 100
  }
}

fn recovered(x: i32) -> i32 {
  return match move run Intrinsic.catchFailure<Rejected>(one(x), caught) {
    i32 value => value
    Caught<Rejected> {error} => error.code - 50
  }
}

pub fn main() -> i32 {
  // 4 + 7 + 3 + 21 + 10 = 45
  return both(3) + both(107) + both(53) + recovered(20) + recovered(60) - 3
}
