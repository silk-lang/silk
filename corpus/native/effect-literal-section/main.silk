// Sectioning an `effect fn` literal stores its environment like sectioning a `fn` literal does.
fn plain() -> i32 {
  let f = effect fn(a: i32, b: i32) -> i32 { return a * 10 + b }
  let g = f(2)
  return run g(3)
}

fn captured() -> i32 {
  let base = 100
  let f = effect fn(a: i32, b: i32) -> i32 { return base + a * 10 + b }
  let g = f(2)
  return run g(3)
}

pub fn main() -> i32 {
  if plain() != 32 { return 1 }
  if captured() != 132 { return 2 }
  return 42
}
