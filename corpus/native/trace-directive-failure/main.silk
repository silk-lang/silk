import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.concurrency.sync { Arc }
import silk.trace.record { Recorder, Config, Memory }
import silk.trace { Tracer }
struct First {}
struct Other {}
@trace
effect fn fall(first: bool) -> () ! First | Other {
  if first { fail First {} }
  fail Other {}
}
@trace
effect fn recover() -> () { drop run Effect.result(fall(true)) }
effect fn cases() -> () {
  run recover()
  drop run Effect.result(fall(false))
}
effect fn exercise() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let recorder = run Arc<Recorder>.make(run Recorder.make(Config.make("test")))
  run cases() |> Effect.provideAmbient<Tracer>(&recorder)
  let mut memory = Memory.make()
  run memory.drain(recorder.get())
  let spans = memory.spans()
  if spans.length != 3 { return 1 }
  if !spans[0].error || spans[0].errorType != "memory/driver.First" { return 2 }
  if spans[1].error || spans[1].name != "memory/driver.recover" { return 3 }
  if !spans[2].error || spans[2].errorType != "memory/driver.Other" { return 4 }
  return 0
}
effect fn failed(error: OutOfMemoryError) -> i32 { return 99 }
pub fn main() -> i32 {
  let mut alloc = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(exercise() |> Effect.provideMut<Allocator>(&mut alloc), failed)
}
