import silk.mem.pointer { Pointer }
import silk.mem.va_list { VaList }
import silk.num.i32

unsafe extern "C" fn silk_test_call_variadic_exports() -> i32
unsafe extern "C" fn silk_test_marker() -> *mut u8

// The shape of libuv's `uv_loop_configure`: one `int` follows only when `option` asks for it.
pub unsafe export "C" fn configure(target: *mut u8, option: i32, ...) -> i32 as "silk_test_configure" {
  unsafe {
    if Pointer.isNull<u8>(target) || option != 0 { return -1 }
    let mut arguments = VaList.of(Intrinsic.variadicArguments())
    return arguments.next<i32>()
  }
}

pub unsafe export "C" fn sumVariadic(count: i32, ...) -> i64 as "silk_test_sum_variadic" {
  unsafe {
    let mut arguments = VaList.of(Intrinsic.variadicArguments())
    let mut total: i64 = 0
    let mut at = 0
    while at < count {
      total = total + i32.toI64(arguments.next<i32>())
      at = at + 1
    }
    return total
  }
}

pub unsafe export "C" fn sumDoubles(count: i32, ...) -> f64 as "silk_test_sum_doubles" {
  unsafe {
    let mut arguments = VaList.of(Intrinsic.variadicArguments())
    let mut total = 0.0
    let mut at = 0
    while at < count {
      total = total + arguments.next<f64>()
      at = at + 1
    }
    return total
  }
}

// Promoted narrow integers and floats, pointers, and integer and float tails long enough to leave
// the registers on every target.
pub unsafe export "C" fn mixedVariadic(tag: i32, ...) -> i32 as "silk_test_mixed_variadic" {
  unsafe {
    if tag != 42 { return 1 }
    let mut arguments = VaList.of(Intrinsic.variadicArguments())
    if arguments.next<i32>() != -3 { return 2 }
    if arguments.next<i64>() != -5000000000 { return 3 }
    if arguments.next<f64>() != 0.25 { return 4 }
    let pointer = arguments.nextPointer<u8>()
    if Pointer.address<u8>(pointer) != Pointer.address<u8>(silk_test_marker()) { return 5 }
    if arguments.next<i32>() != 300 { return 6 }
    if arguments.next<u32>() != 4000000000 { return 7 }
    let mut expected: i64 = 1
    while expected <= 4 {
      if arguments.next<i64>() != expected { return 8 }
      expected = expected + 1
    }
    let mut double = 2.0
    while double <= 9.0 {
      if arguments.next<f64>() != double { return 9 }
      double = double + 1.0
    }
    if arguments.next<i64>() != 99 { return 10 }
    return 0
  }
}

pub fn main() -> i32 {
  if unsafe silk_test_call_variadic_exports() != 0 { return 1 }
  return 42
}
