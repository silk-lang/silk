import silk.io.writer_native { StdoutWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.text.format { Debug, Format, Formatter }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }

struct Point { pub x: i32, pub y: i32 }

impl Debug for Point {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return run Format.debugFields(self, "Point", &mut formatter)
  }
}

struct Line { pub start: Point, pub end: Point, pub weight: Option<i32> }

impl Debug for Line {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return run Format.debugFields(self, "Line", &mut formatter)
  }
}

tuple Pair(i32, bool)

impl Debug for Pair {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return run Format.debugFields(self, "Pair", &mut formatter)
  }
}

struct Path { pub steps: [i32; 3] }

impl Debug for Path {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    run Format.writeText(&mut formatter, "Path ")
    return run Format.debugList(&self.steps, &mut formatter)
  }
}

tuple Lists(List<i32>, List<i32>)

effect fn render(lists: &Lists) -> () ! WriterError ? &mut Writer {
  // Strings and chars are quoted and escaped; numbers and bool match Display.
  run Format.format("{:?} {:?} {:?} {:?}\n", &("tab\there \"q\" back\\slash é", 'x', '\'', "\u{1b}[0m"))
  run Format.format("{:?} {:?} {:?} {:?}\n", &(42, 0.0 - 2.5, true, '\n'))
  // Option and Result name the variant.
  let variants = (Option<i32>.some(3), Option<i32>.none(), Result<i32, string>.failResult("bad"))
  run Format.format("{:?} {:?} {:?}\n", &variants)
  // Structs through debugFields, labeled and positional, and lists through debugList.
  let shapes = (
    Line { start: Point { x: 1, y: 2 }, end: Point { x: 0 - 3, y: 4 }, weight: Option<i32>.some(9) },
    Pair(7, false),
    Path { steps: [1, 2, 3] },
  )
  run Format.format("{:?}\n{:?}\n{:?}\n", &shapes)
  // The pretty form puts each field on its own line and indents each level.
  let pretty = (Line { start: Point { x: 1, y: 2 }, end: Point { x: 3, y: 4 }, weight: Option<i32>.none() }, )
  run Format.format("{:#?}\n", &pretty)
  // Options apply to the numbers inside.
  run Format.format("{:>3?}\n", &(Point { x: 1, y: 22 }, ))
  // A whole float ends in `.0`, unless a precision is set; Display leaves it as it is.
  let small: f32 = 4.0
  run Format.format("{:?} {:?} {:?} {:?} {:?} {:>6?} {:.2?} {}\n", &(1.0, 0.0, 0.0 - 2.0, 1.0e20, small, 3.0, 1.0, 1.0))
  // A List writes its elements, compact or pretty.
  run Format.format("{:?} {:?}\n", lists)
  return run Format.format("{0:#?} {1:#?}\n", lists)
}

effect fn build() -> i32 ! WriterError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut values = List<i32>.make()
  run List<i32>.append(&mut values, 4) |> Effect.provideMut<Allocator>(&mut allocator)
  run List<i32>.append(&mut values, 0 - 5) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut writer = StdoutWriter.make()
  let lists = Lists(move values, List<i32>.make())
  run render(&lists) |> Effect.provideMut<Writer>(&mut writer)
  return 42
}
effect fn recover(error: WriterError | OutOfMemoryError) -> i32 { return 1 }
pub fn main() -> i32 { return run Effect.catchAll(build(), recover) }
