import silk.num.f64

fn notANumber(zero: f64) -> f64 { return zero / zero }

pub fn main() -> i32 {
  let missing = notANumber(0.0)
  // Signed zero passes through, NaN and infinity give the canonical NaN, and the largest arguments
  // reduce exactly.
  if f64.toBits(f64.tan(-0.0)) != 9223372036854775808 { return 100 }
  if f64.toBits(f64.tan(f64.INFINITY)) != 9221120237041090560 { return 101 }
  if f64.toBits(f64.tan(missing)) != 9221120237041090560 { return 102 }
  if f64.toBits(f64.tan(1.0)) != 4609692760021066662 { return 103 }
  if f64.toBits(f64.tan(1e300)) != 4609080455566175351 { return 104 }
  if f64.toBits(f64.tan(f64.fromBits(9218868437227405311))) != 13795742873816306820 { return 105 }
  if f64.toBits(f64.tan(1.5707963267948966)) != 4849535219099880885 { return 106 }
  // Infinity gives pi/2 and a signed zero passes through.
  if f64.toBits(f64.atan(f64.INFINITY)) != 4609753056924675352 { return 107 }
  if f64.toBits(f64.atan(-0.0)) != 9223372036854775808 { return 108 }
  if f64.toBits(f64.atan(1.0)) != 4605249457297304856 { return 109 }
  if f64.toBits(f64.atan(-1e300)) != 13833125093779451160 { return 110 }
  if f64.toBits(f64.atan(missing)) != 9221120237041090560 { return 111 }
  // The signs of both operands select the quadrant, signed zeros included.
  if f64.toBits(f64.atan2(0.0, -0.0)) != 4614256656552045848 { return 112 }
  if f64.toBits(f64.atan2(-0.0, -1.0)) != 13837628693406821656 { return 113 }
  if f64.toBits(f64.atan2(-0.0, 1.0)) != 9223372036854775808 { return 114 }
  if f64.toBits(f64.atan2(1.0, 0.0)) != 4609753056924675352 { return 115 }
  if f64.toBits(f64.atan2(f64.INFINITY, -f64.INFINITY)) != 4612488097114038738 { return 116 }
  if f64.toBits(f64.atan2(-1.0, -1.0)) != 13835860133968814546 { return 117 }
  if f64.toBits(f64.atan2(1.0, f64.INFINITY)) != 0 { return 118 }
  if f64.toBits(f64.atan2(-1.0, -f64.INFINITY)) != 13837628693406821656 { return 119 }
  if f64.toBits(f64.atan2(missing, 1.0)) != 9221120237041090560 { return 120 }
  // Arguments outside [-1, 1] give the canonical NaN.
  if f64.toBits(f64.asin(1.0)) != 4609753056924675352 { return 121 }
  if f64.toBits(f64.asin(-0.0)) != 9223372036854775808 { return 122 }
  if f64.toBits(f64.asin(2.0)) != 9221120237041090560 { return 123 }
  if f64.toBits(f64.asin(0.5)) != 4602891378046628710 { return 124 }
  // One gives positive zero and negative one gives pi.
  if f64.toBits(f64.acos(-1.0)) != 4614256656552045848 { return 125 }
  if f64.toBits(f64.acos(1.0)) != 0 { return 126 }
  if f64.toBits(f64.acos(0.0)) != 4609753056924675352 { return 127 }
  if f64.toBits(f64.acos(-1.5)) != 9221120237041090560 { return 128 }
  // Overflow gives infinity, and underflow rounds once into the subnormal range.
  if f64.toBits(f64.exp(0.0)) != 4607182418800017408 { return 129 }
  if f64.toBits(f64.exp(-0.0)) != 4607182418800017408 { return 130 }
  if f64.toBits(f64.exp(1.0)) != 4613303445314885481 { return 131 }
  if f64.toBits(f64.exp(-f64.INFINITY)) != 0 { return 132 }
  if f64.toBits(f64.exp(f64.INFINITY)) != 9218868437227405312 { return 133 }
  if f64.toBits(f64.exp(710.0)) != 9218868437227405312 { return 134 }
  if f64.toBits(f64.exp(-746.0)) != 0 { return 135 }
  if f64.toBits(f64.exp(-740.0)) != 85 { return 136 }
  if f64.toBits(f64.exp(missing)) != 9221120237041090560 { return 137 }
  // Zero gives negative infinity and a negative argument the canonical NaN.
  if f64.toBits(f64.log(1.0)) != 0 { return 138 }
  if f64.toBits(f64.log(0.0)) != 18442240474082181120 { return 139 }
  if f64.toBits(f64.log(-0.0)) != 18442240474082181120 { return 140 }
  if f64.toBits(f64.log(-1.0)) != 9221120237041090560 { return 141 }
  if f64.toBits(f64.log(f64.INFINITY)) != 9218868437227405312 { return 142 }
  if f64.toBits(f64.log(2.718281828459045)) != 4607182418800017408 { return 143 }
  if f64.toBits(f64.log(f64.fromBits(1))) != 13873131416795836867 { return 144 }
  if f64.toBits(f64.log(10.0)) != 4612367379483415830 { return 145 }
  // The IEEE-754 special cases, and results that overflow or reach the subnormal range.
  if f64.toBits(f64.pow(2.0, 10.0)) != 4652218415073722368 { return 146 }
  if f64.toBits(f64.pow(-2.0, 3.0)) != 13844065254536904704 { return 147 }
  if f64.toBits(f64.pow(-8.0, 0.3333333333333333)) != 9221120237041090560 { return 148 }
  if f64.toBits(f64.pow(missing, 0.0)) != 4607182418800017408 { return 149 }
  if f64.toBits(f64.pow(1.0, missing)) != 4607182418800017408 { return 150 }
  if f64.toBits(f64.pow(-1.0, f64.INFINITY)) != 4607182418800017408 { return 151 }
  if f64.toBits(f64.pow(-0.0, -3.0)) != 18442240474082181120 { return 152 }
  if f64.toBits(f64.pow(0.0, -2.0)) != 9218868437227405312 { return 153 }
  if f64.toBits(f64.pow(-0.0, 3.0)) != 9223372036854775808 { return 154 }
  if f64.toBits(f64.pow(0.5, f64.INFINITY)) != 0 { return 155 }
  if f64.toBits(f64.pow(2.0, -1075.0)) != 0 { return 156 }
  if f64.toBits(f64.pow(2.0, -1074.0)) != 1 { return 157 }
  if f64.toBits(f64.pow(10.0, 308.5)) != 9218868437227405312 { return 158 }
  if f64.toBits(f64.pow(2.0, 0.5)) != 4609047870845172685 { return 159 }
  if f64.toBits(f64.pow(-3.0, -1e300)) != 0 { return 160 }
  // Exact cubes give exact roots, and the sign of the argument carries over.
  if f64.toBits(f64.cbrt(27.0)) != 4613937818241073152 { return 161 }
  if f64.toBits(f64.cbrt(-8.0)) != 13835058055282163712 { return 162 }
  if f64.toBits(f64.cbrt(-0.0)) != 9223372036854775808 { return 163 }
  if f64.toBits(f64.cbrt(-f64.INFINITY)) != 18442240474082181120 { return 164 }
  if f64.toBits(f64.cbrt(2.0)) != 4608352999143469707 { return 165 }
  if f64.toBits(f64.cbrt(missing)) != 9221120237041090560 { return 166 }
  // Infinity wins over NaN, and neither the squares nor the sum overflow.
  if f64.toBits(f64.hypot(3.0, 4.0)) != 4617315517961601024 { return 167 }
  if f64.toBits(f64.hypot(f64.INFINITY, missing)) != 9218868437227405312 { return 168 }
  if f64.toBits(f64.hypot(missing, -f64.INFINITY)) != 9218868437227405312 { return 169 }
  if f64.toBits(f64.hypot(missing, 1.0)) != 9221120237041090560 { return 170 }
  if f64.toBits(f64.hypot(1e300, 1e300)) != 9097522851029299729 { return 171 }
  if f64.toBits(f64.hypot(-0.0, -0.0)) != 0 { return 172 }
  if f64.toBits(f64.hypot(f64.fromBits(1), f64.fromBits(1))) != 1 { return 173 }
  // One rounding: the residual of 0.1 * 10, a sign kept through underflow, and no intermediate
  // overflow.
  if f64.toBits(f64.fma(0.1, 10.0, -1.0)) != 4363988038922010624 { return 174 }
  if f64.toBits(f64.fma(f64.INFINITY, 0.0, 1.0)) != 9221120237041090560 { return 175 }
  if f64.toBits(f64.fma(-f64.fromBits(1905022642377719808), f64.fromBits(1905022642377719808), 0.0)) != 9223372036854775808 { return 176 }
  if f64.toBits(f64.fma(f64.fromBits(9218868437227405311), 2.0, -f64.fromBits(9218868437227405311))) != 9218868437227405311 { return 177 }
  if f64.toBits(f64.fma(f64.fromBits(4607182418800017409), f64.fromBits(4607182418800017407), -1.0)) != 4368491638549381118 { return 178 }
  if f64.toBits(f64.fma(f64.INFINITY, 1.0, -f64.INFINITY)) != 9221120237041090560 { return 179 }
  if f64.toBits(f64.fma(f64.fromBits(4503599627370496), f64.fromBits(4372995238176751616), 0.0)) != 1 { return 180 }
  if f64.toBits(f64.fma(f64.fromBits(24), 0.5, 0.0)) != 12 { return 181 }
  return 42
}
