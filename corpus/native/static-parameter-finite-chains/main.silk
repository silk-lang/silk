fn countdown(static n: i32) -> i32 {
  static if n == 0 {
    return 0
  } else {
    return countdown(n - 1) + 2
  }
}

fn ping(static n: i32) -> i32 {
  static if n == 0 {
    return 10
  } else {
    return pong(n - 1) + 1
  }
}

fn pong(static n: i32) -> i32 {
  static if n == 0 {
    return 20
  } else {
    return ping(n - 1) + 1
  }
}

fn toggle(static flag: i32, depth: i32) -> i32 {
  if depth == 0 {
    return flag
  }
  return toggle(1 - flag, depth - 1)
}

pub fn main() -> i32 {
  return countdown(5) + ping(3) + toggle(0, 5) + 8
}