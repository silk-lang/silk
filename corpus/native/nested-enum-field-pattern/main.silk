enum Color { Red, Green }
struct Paint {
  color: Color
  amount: i32
}
fn f(p: Paint) -> i32 {
  return match move p {
    Paint { color: Color.Red, amount } => amount
    Paint { color: Color.Green, amount } => amount + 100
  }
}
pub fn main() -> i32 {
  if f(Paint { color: Color.Green, amount: 1 }) != 101 { return 1 }
  return f(Paint { color: Color.Red, amount: 42 })
}
