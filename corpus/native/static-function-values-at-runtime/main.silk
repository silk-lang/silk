// A static function value that names an ordinary function is called by runtime code as that
// function, with its captured static values as the trailing arguments (STATIC-020).

fn between(value: u32, low: u32, high: u32) -> bool {
  return value >= low && value <= high
}

fn twice(value: u32) -> u32 {
  return value * 2
}

fn over<T>(value: u32, other: T) -> bool {
  return value > 3
}

static fn range(low: u32, high: u32) -> fn<'static>(u32) -> bool {
  return between(low, high)
}

static fn doubling() -> fn<'static>(u32) -> u32 {
  return twice
}

static fn big() -> fn<'static>(u32) -> bool {
  return over<bool>(true)
}

fn score(value: u32) -> i32 {
  let static check = range(1, 5)
  let static double = doubling()
  let static large = big()
  let mut total = 0
  if check(value) { total = total + 1 }
  if value |> check() { total = total + 2 }
  let kept = check
  if kept(value) { total = total + 4 }
  if double(value) == 8 { total = total + 8 }
  if large(value) { total = total + 16 }
  return total
}

pub fn main() -> i32 {
  return score(4) + score(9) * 2
}
