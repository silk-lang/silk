// A default operation's body may do static work on `Self`: each provider that inherits it selects
// it for its own type, so `Pair` counts two fields and `Triple` three.
import silk.core.reflect { Reflect, namedKind }

static fn bonus<T>() -> i32 {
  return 100
}

interface Counted {
  fn base(self: &Self) -> i32

  fn total(self: &Self) -> i32 {
    let mut sum = self.base()
    static for _field in Reflect.fields<Self>() {
      sum = sum + 1
    }
    static if Reflect.typeKind(Reflect.typeOf<Self>()) == namedKind {
      sum = sum + 10
    }
    static if bonus<Self>() == 100 {
      sum = sum + 100
    }
    return sum
  }
}

struct Pair {
  pub a: i32,
  pub b: i32,
}

struct Triple {
  pub a: i32,
  pub b: i32,
  pub c: i32,
}

impl Counted for Pair {
  fn base(self: &Self) -> i32 { return 0 }
}

impl Counted for Triple {
  fn base(self: &Self) -> i32 { return 1000 }
}

pub fn main() -> i32 {
  let pair = Pair { a: 1, b: 2 }
  let triple = Triple { a: 1, b: 2, c: 3 }
  // 112 and 1113.
  return pair.total() + triple.total() - 1183
}
