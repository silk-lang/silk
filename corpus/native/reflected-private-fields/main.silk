// `Reflect.fields` lists the fields its caller can see, so a module reflects its own private
// fields through the standard library's wrapper too.
import silk.reflect { Reflect }
struct Pair { first: i32, second: i32, }
fn total<T>(value: &T) -> i32 {
  let mut sum = 0
  static for field in Reflect.fields<T>() {
    sum = sum + Reflect.borrowField<T, i32>(value, field).*
  }
  return sum
}
pub fn main() -> i32 {
  let value = Pair { first: 20, second: 22 }
  return total<Pair>(&value)
}
