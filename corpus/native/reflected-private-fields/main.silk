// `Reflect.fields` lists only `pub` fields, even in the module that declares the type, while a
// direct `Intrinsic.reflectFields` call lists every field its caller can see.
import silk.core.reflect { Reflect }
struct Pair { pub first: i32, second: i32, }
fn publicTotal<T>(value: &T) -> i32 {
  let mut sum = 0
  static for field in Reflect.fields<T>() {
    sum = sum + Reflect.borrowField<T, i32>(value, field).*
  }
  return sum
}
fn visibleTotal(value: &Pair) -> i32 {
  let mut sum = 0
  static for field in Intrinsic.reflectFields<Pair>() {
    sum = sum + Intrinsic.borrowField<Pair, i32>(value, field).*
  }
  return sum
}
pub fn main() -> i32 {
  let value = Pair { first: 20, second: 22 }
  return publicTotal<Pair>(&value) * 10 + visibleTotal(&value) - 160
}
