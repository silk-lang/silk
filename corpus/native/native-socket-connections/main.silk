    &orderedEndpoints,
    ConnectOptions.defaults(),
    Option<Instant>.none(),
    noTransfer,
  ) |> Effect.provideMut<MonotonicClock>(&mut clock)
  if ordered != 42 || unsafe silk_socket_stub_first_close_event() <= 0
