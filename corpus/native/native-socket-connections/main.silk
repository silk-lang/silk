static if Intrinsic.targetOperatingSystem() == "windows" {
  const IO_FAILURE: i32 = 10014
  const CONNECTION_RESET: i32 = 10054
  const INVALID_DESCRIPTOR: i32 = 10038
  const BROKEN_PIPE: i32 = 10058
} else {
  const IO_FAILURE: i32 = 5
  const INVALID_DESCRIPTOR: i32 = 9
  const BROKEN_PIPE: i32 = 32
  static if Intrinsic.targetOperatingSystem() == "darwin" { const CONNECTION_RESET: i32 = 54 }
  else { const CONNECTION_RESET: i32 = 104 }
}

