fn defaults() -> bool {
  let iv = AesKeyWrap.defaultIv()
  let padded = AesKeyWrap.defaultPaddedIv()
  return iv[0] == 0xa6 && iv[7] == 0xa6 && padded[1] == 0x59 && padded[3] == 0xa6
}

pub fn main() -> i32 {
  if !ccm0() { return 1 }
  if !ccm1() { return 2 }
  if !ccm2() { return 3 }
