import silk.crypto.aes_ccm {AesCcm, AesCcmError}
import silk.crypto.aes_ocb {AesOcbDecryptor, AesOcbEncryptor, AesOcbError}
import silk.crypto.aes_wrap {AesKeyWrap, AesKeyWrapError}
import silk.collections.slice {Slice}
import silk.core.result {Result}
import silk.num.u8

fn equal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut index: usize = 0
  while index < left.length {
    if left[index] != right[index] { return false }
    index = index + 1
  }
  return true
}

fn ccmOk(result: Result<(), AesCcmError>) -> bool {
  return match move result {
    Result<(), AesCcmError>.Success {value: _} => true
    Result<(), AesCcmError>.Failure {error: _} => false
  }
}

fn ccm(key: &[u8], nonce: &[u8], aad: &[u8], plaintext: &[u8], ciphertext: &[u8], tag: &[u8], output: &mut [u8], computed: &mut [u8]) -> bool {
  if !ccmOk(AesCcm.seal(key, nonce, aad, plaintext, &mut output, &mut computed)) { return false }
  if !equal(Slice.view<u8>(&output, 0, plaintext.length), ciphertext) || !equal(&computed, tag) { return false }
  if !ccmOk(AesCcm.open(key, nonce, aad, ciphertext, tag, &mut output)) { return false }
  if !equal(Slice.view<u8>(&output, 0, plaintext.length), plaintext) { return false }
  computed[0] = u8.bitXor(computed[0], 1)
  return match AesCcm.open(key, nonce, aad, ciphertext, &computed, &mut output) {
    Result<(), AesCcmError>.Failure {error: AesCcmError.AuthenticationFailed} => true
    _ => false
  }
}

fn countOf(result: Result<usize, AesOcbError>) -> usize {
  return match move result {
    Result<usize, AesOcbError>.Success {value} => value
    Result<usize, AesOcbError>.Failure {error: _} => 1000000
  }
}

fn ocb(key: &[u8], nonce: &[u8], aad: &[u8], plaintext: &[u8], ciphertext: &[u8], tag: &[u8], step: usize, output: &mut [u8], computed: &mut [u8]) -> bool {
  let mut encryptor = match AesOcbEncryptor.make(key, nonce, aad, tag.length) {
    Result<AesOcbEncryptor, AesOcbError>.Success {value} => move value
    Result<AesOcbEncryptor, AesOcbError>.Failure {error: _} => { return false }
  }
  let total = output.length
  let mut offset: usize = 0
  let mut written: usize = 0
  while offset < plaintext.length {
    let mut length = step
    if plaintext.length - offset < length { length = plaintext.length - offset }
    let expected = encryptor.updateLength(length)
    let count = countOf(encryptor.update(Slice.view<u8>(plaintext, offset, length), Slice.viewMut<u8>(&mut output, written, total - written)))
    if count != expected { return false }
    written = written + count
    offset = offset + length
  }
  written = written + countOf(encryptor.finish(Slice.viewMut<u8>(&mut output, written, total - written), &mut computed))
  if written != plaintext.length { return false }
  if !equal(Slice.view<u8>(&output, 0, written), ciphertext) || !equal(&computed, tag) { return false }
  let mut decryptor = match AesOcbDecryptor.make(key, nonce, aad, tag.length) {
    Result<AesOcbDecryptor, AesOcbError>.Success {value} => move value
    Result<AesOcbDecryptor, AesOcbError>.Failure {error: _} => { return false }
  }
  offset = 0
  written = 0
  while offset < ciphertext.length {
    let mut length = step
    if ciphertext.length - offset < length { length = ciphertext.length - offset }
    written = written + countOf(decryptor.update(Slice.view<u8>(ciphertext, offset, length), Slice.viewMut<u8>(&mut output, written, total - written)))
    offset = offset + length
  }
  written = written + countOf(decryptor.finish(Slice.viewMut<u8>(&mut output, written, total - written), tag))
  if written != plaintext.length { return false }
  if !equal(Slice.view<u8>(&output, 0, written), plaintext) { return false }
  let mut bad = match AesOcbDecryptor.make(key, nonce, aad, tag.length) {
    Result<AesOcbDecryptor, AesOcbError>.Success {value} => move value
    Result<AesOcbDecryptor, AesOcbError>.Failure {error: _} => { return false }
  }
  let used = countOf(bad.update(ciphertext, &mut output))
  if used > total { return false }
  computed[0] = u8.bitXor(computed[0], 1)
  return match bad.finish(Slice.viewMut<u8>(&mut output, used, total - used), &computed) {
    Result<usize, AesOcbError>.Failure {error: AesOcbError.AuthenticationFailed} => true
    _ => false
  }
}

fn wrapCount(result: Result<usize, AesKeyWrapError>) -> usize {
  return match move result {
    Result<usize, AesKeyWrapError>.Success {value} => value
    Result<usize, AesKeyWrapError>.Failure {error: _} => 1000000
  }
}

fn keyWrap(key: &[u8], iv: &[u8], padded: bool, input: &[u8], wrapped: &[u8], output: &mut [u8], back: &mut [u8]) -> bool {
  let made = if padded { AesKeyWrap.wrapPadded(key, iv, input, &mut output) } else { AesKeyWrap.wrap(key, iv, input, &mut output) }
  if wrapCount(move made) != wrapped.length { return false }
  if !equal(Slice.view<u8>(&output, 0, wrapped.length), wrapped) { return false }
  let opened = if padded { AesKeyWrap.unwrapPadded(key, iv, wrapped, &mut back) } else { AesKeyWrap.unwrap(key, iv, wrapped, &mut back) }
  if wrapCount(move opened) != input.length { return false }
  if !equal(Slice.view<u8>(&back, 0, input.length), input) { return false }
  output[wrapped.length - 1] = u8.bitXor(output[wrapped.length - 1], 1)
  let broken = if padded { AesKeyWrap.unwrapPadded(key, iv, Slice.view<u8>(&output, 0, wrapped.length), &mut back) } else { AesKeyWrap.unwrap(key, iv, Slice.view<u8>(&output, 0, wrapped.length), &mut back) }
  return match move broken {
    Result<usize, AesKeyWrapError>.Failure {error: AesKeyWrapError.IntegrityCheckFailed} => true
    _ => false
  }
}

fn ccm0() -> bool {
  let key: [u8; 16] = [1, 38, 75, 112, 149, 186, 223, 4, 41, 78, 115, 152, 189, 226, 7, 44]
  let nonce: [u8; 7] = [5, 42, 79, 116, 153, 190, 227]
  let aad: [u8; 0] = []
  let plaintext: [u8; 0] = []
  let ciphertext: [u8; 0] = []
  let tag: [u8; 4] = [113, 42, 132, 72]
  let mut output: [u8; 0] = [0; 0]
  let mut computed: [u8; 4] = [0; 4]
  return ccm(&key, &nonce, &aad, &plaintext, &ciphertext, &tag, &mut output, &mut computed)
}

