import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.collections.hash { Hash, HashKey, HashSeed, Word }
import silk.collections.hash_map { HashMap }
import silk.collections.hash_set { HashSet }
import silk.num.i32
import silk.option { Option }
import silk.core.ownership { Copy }

// Probes can skip sixteen slots at a time by the hash bits kept in each state byte. Long runs of
// colliding keys, removed slots and runs that wrap past the last bucket must still find exactly
// the keys that are present.
struct Clustered { value: i32 }
impl Copy for Clustered {}
fn clusteredEquals(left: &Clustered, right: &Clustered) -> bool { return left.value == right.value }
// Few distinct hashes, with distinct top bits, so that runs are long and the stored tag both matches
// and differs inside one run.
fn clusteredHash(value: &Clustered, seed: &HashSeed) -> u64 {
  return i32.toU64(value.value % 5) * 2305843009213693951 + i32.toU64(value.value % 3)
}
impl HashKey for Clustered { equals: Clustered.clusteredEquals hash: Clustered.clusteredHash }

fn present(key: i32) -> bool {
  return key % 4 != 1 && key < 600
}

effect fn build() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut clustered = HashMap<Clustered, i32>.make(Hash.seed(1))
  let mut spread = HashMap<Word, i32>.make(Hash.seed(99))
  let mut members = HashSet<Clustered>.make(Hash.seed(5))
  let mut key = 0
  while key < 600 {
    let a = run HashMap<Clustered, i32>.insert(&mut clustered, Clustered { value: key }, key * 2) |> Effect.provideMut(&mut allocator)
    drop a
    let b = run HashMap<Word, i32>.insert(&mut spread, Hash.word(i32.toU64(key)), key * 2) |> Effect.provideMut(&mut allocator)
    drop b
    let c = run HashSet<Clustered>.insert(&mut members, Clustered { value: key }) |> Effect.provideMut(&mut allocator)
    drop c
    key = key + 1
  }
  // Remove every key that leaves 1 modulo 4, leaving removed marks inside the runs.
  key = 1
  while key < 600 {
    if Option<i32>.unwrapOr(HashMap<Clustered, i32>.remove(&mut clustered, Clustered { value: key }), -1) != key * 2 { return 1 }
    if Option<i32>.unwrapOr(HashMap<Word, i32>.remove(&mut spread, Hash.word(i32.toU64(key))), -1) != key * 2 { return 2 }
    match HashSet<Clustered>.remove(&mut members, Clustered { value: key }) {
      Option<Clustered>.Some { value: _ } => {}
      Option<Clustered>.None => { return 3 }
    }
    key = key + 4
  }
  key = 0
  while key < 700 {
    let wanted = present(key)
    if HashMap<Clustered, i32>.contains(&clustered, Clustered { value: key }) != wanted { return 4 }
    if HashMap<Word, i32>.contains(&spread, Hash.word(i32.toU64(key))) != wanted { return 5 }
    if HashSet<Clustered>.contains(&members, Clustered { value: key }) != wanted { return 6 }
    let mut expected = -1
    if wanted {
      expected = key * 2
    }
    if Option<i32>.unwrapOr(HashMap<Clustered, i32>.get(&clustered, Clustered { value: key }), -1) != expected { return 7 }
    if Option<i32>.unwrapOr(HashMap<Word, i32>.get(&spread, Hash.word(i32.toU64(key))), -1) != expected { return 8 }
    let found = match HashMap<Clustered, i32>.indexOf(&clustered, Clustered { value: key }) {
      Option<usize>.Some { value } => HashMap<Clustered, i32>.keyAt(&clustered, value).value == key
      Option<usize>.None => false
    }
    if found != wanted { return 9 }
    key = key + 1
  }
  // Reinserting a removed key reuses its run and replaces nothing.
  key = 1
  while key < 600 {
    match run HashMap<Clustered, i32>.insert(&mut clustered, Clustered { value: key }, key) |> Effect.provideMut(&mut allocator) {
      Option<i32>.Some { value: _ } => { return 10 }
      Option<i32>.None => {}
    }
    key = key + 8
  }
  if HashMap<Clustered, i32>.length(&clustered) != 450 + 75 { return 11 }
  // Every occupied bucket holds a key that lookup finds at that bucket.
  let mut index: usize = 0
  let mut seen: usize = 0
  while index < HashMap<Clustered, i32>.bucketCount(&clustered) {
    if HashMap<Clustered, i32>.occupiedAt(&clustered, index) {
      let held = HashMap<Clustered, i32>.keyAt(&clustered, index)
      match HashMap<Clustered, i32>.indexOf(&clustered, held) {
        Option<usize>.Some { value } => { if value != index { return 12 } }
        Option<usize>.None => { return 13 }
      }
      seen = seen + 1
    }
    index = index + 1
  }
  if seen != 525 { return 14 }
  return 0
}

effect fn recover(error: OutOfMemoryError) -> i32 { return 99 }

pub fn main() -> i32 { return run Effect.catchAll(build(), recover) }
