// An anonymous callable body may hold another; the retired SEM0199 never rejects nesting.
fn apply(f: fn(i32) -> i32, v: i32) -> i32 { return f(v) }
pub fn main() -> i32 {
  let base = 2
  let outer = fn(x: i32) -> i32 {
    let inner = fn(y: i32) -> i32 { return y + base }
    return apply(inner, x) * 2
  }
  return apply(outer, 19)
}
