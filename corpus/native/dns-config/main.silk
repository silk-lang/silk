import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.net.address { Endpoint, IpAddress, Ipv4Address, Ipv6Address, Port }
import silk.net.dns.config { ResolverConfig }
import silk.net.dns.message { MessageError, Name }
import silk.text.string { String }

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut index: usize = 0
  while index < left.length {
    if left[index] != right[index] {
      return false
    }
    index = index + 1
  }
  return true
}

effect fn textIs(value: &Name, expected: string) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut output = Bytes.make()
  run Name.appendText(value, &mut output)
  return same(Bytes.asSlice(&output), String.utf8Bytes(expected))
}

effect fn parsed() -> i32
  ! OutOfMemoryError
  ? &mut Allocator {
  let text = b"# generated\n; comment\nnameserver 192.0.2.53\nnameserver   2001:db8::1%eth0 # trailing\nnameserver bogus\n\tnameserver 192.0.2.54\ndomain old.example\nsearch corp.example. example.net\noptions ndots:3 timeout:7 attempts:9 rotate edns0 unknown:1\nsortlist 130.155.160.0\n"
  let config = run ResolverConfig.parse(text)
  let servers = List<Endpoint>.asSlice(&config.servers)
  if servers.length != 3 {
    return 1
  }
  let first = IpAddress.V4 { value: Ipv4Address.fromOctets([192, 0, 2, 53]) }
  if !Endpoint.equals(&servers[0], &Endpoint.make(first, Port.fromU16(53))) {
    return 2
  }
  match Endpoint.address(&servers[1]) {
    IpAddress.V6 { value } => {
      let octets = Ipv6Address.octets(&value)
      if octets[0] != 32 || octets[1] != 1 || octets[15] != 1 {
        return 3
      }
    }
    IpAddress.V4 { .. } => {
      return 3
    }
  }
  let search = List<Name>.asSlice(&config.search)
  if search.length != 2 {
    return 4
  }
  if !(run textIs(&search[0], "corp.example")) || !(run textIs(&search[1], "example.net")) {
    return 5
  }
  if config.ndots != 3 || config.timeout != 7000000000 || config.attempts != 5 {
    return 6
  }
  if !config.rotate || !config.edns || config.useTcp {
    return 7
  }
  return 0
}

effect fn empty() -> i32
  ! OutOfMemoryError
  ? &mut Allocator {
  let config = run ResolverConfig.parse(
    b"options use-vc timeout:0\ndomain only.example extra.example\n",
  )
  let servers = List<Endpoint>.asSlice(&config.servers)
  let loopback = IpAddress.V4 { value: Ipv4Address.fromOctets([127, 0, 0, 1]) }
  if servers.length != 1
    || !Endpoint.equals(&servers[0], &Endpoint.make(loopback, Port.fromU16(53))) {
    return 1
  }
  if !config.useTcp || config.timeout != 5000000000 || config.attempts != 2 || config.ndots != 1 {
    return 2
  }
  let search = List<Name>.asSlice(&config.search)
  if search.length != 1 || !(run textIs(&search[0], "only.example")) {
    return 3
  }
  return 0
}

effect fn candidates() -> i32
  ! MessageError | OutOfMemoryError
  ? &mut Allocator {
  let mut config = run ResolverConfig.parse(b"search a.example b.example\noptions ndots:2\n")
  let short = run ResolverConfig.candidates(&config, "host")
  let names = List<Name>.asSlice(&short)
  if names.length != 3 {
    return 1
  }
  if !(run textIs(&names[0], "host.a.example")) || !(run textIs(&names[1], "host.b.example")) {
    return 2
  }
  if !(run textIs(&names[2], "host")) {
    return 3
  }
  let dotted = run ResolverConfig.candidates(&config, "www.host.org")
  let tried = List<Name>.asSlice(&dotted)
  if tried.length != 3 || !(run textIs(&tried[0], "www.host.org"))
    || !(run textIs(&tried[1], "www.host.org.a.example")) {
    return 4
  }
  let absolute = run ResolverConfig.candidates(&config, "host.")
  if List<Name>.length(&absolute) != 1 || !(run textIs(&List<Name>.asSlice(&absolute)[0], "host")) {
    return 5
  }
  config.search = List<Name>.make()
  let alone = run ResolverConfig.candidates(&config, "host")
  if List<Name>.length(&alone) != 1 {
    return 6
  }
  return 0
}

effect fn program() -> i32
  ! MessageError | OutOfMemoryError
  ? &mut Allocator {
  let first = run parsed()
  if first != 0 {
    return 10 + first
  }
  let second = run empty()
  if second != 0 {
    return 20 + second
  }
  let third = run candidates()
  if third != 0 {
    return 30 + third
  }
  return 42
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  return 1
}

pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(program(), failed) |> Effect.provideMut<Allocator>(&mut allocator)
}
