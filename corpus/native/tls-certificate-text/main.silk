import silk.core.option { Option }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.tls.certificate { CertificateTime }
import silk.tls.certificate_text { CertificateText, CertificateTextError, NameTextFormat, ObjectName }

fn equal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut i: usize = 0
  while i < left.length {
    if left[i] != right[i] {
      return false
    }
    i = i + 1
  }
  return true
}

fn nameIs(der: &[u8], format: NameTextFormat, expected: &[u8]) -> bool {
  let mut text: [u8; 1024] = [0; 1024]
  let measured = match CertificateText.nameLength(der, format) {
    Result<usize, CertificateTextError>.Success { value } => value
    Result<usize, CertificateTextError>.Failure { error: _ } => {
      return false
    }
  }
  if measured != expected.length {
    return false
  }
  if expected.length > 0 {
    let short = expected.length - 1
    match CertificateText.writeName(der, format, Slice.viewMut<u8>(&mut text, 0, short)) {
      Result<usize, CertificateTextError>.Failure { error: CertificateTextError.OutputTooSmall } => {}
      _ => {
        return false
      }
    }
  }
  return match CertificateText.writeName(der, format, &mut text) {
    Result<usize, CertificateTextError>.Success { value } => equal(Slice.view<u8>(&text, 0, value), expected)
    Result<usize, CertificateTextError>.Failure { error: _ } => false
  }
}

fn nameFails(der: &[u8]) -> bool {
  let mut text: [u8; 256] = [0; 256]
  let multiline = match CertificateText.writeName(der, NameTextFormat.Multiline, &mut text) {
    Result<usize, CertificateTextError>.Failure { error: CertificateTextError.InvalidEncoding } => true
    _ => false
  }
  return multiline && match CertificateText.nameLength(der, NameTextFormat.Rfc2253) {
    Result<usize, CertificateTextError>.Failure { error: CertificateTextError.InvalidEncoding } => true
    _ => false
  }
}

fn identifierIs(identifier: &[u8], expected: &[u8]) -> bool {
  let mut text: [u8; 256] = [0; 256]
  let measured = match CertificateText.objectIdentifierLength(identifier) {
    Result<usize, CertificateTextError>.Success { value } => value
    Result<usize, CertificateTextError>.Failure { error: _ } => {
      return false
    }
  }
  if measured != expected.length {
    return false
  }
  return match CertificateText.writeObjectIdentifier(identifier, &mut text) {
    Result<usize, CertificateTextError>.Success { value } => equal(Slice.view<u8>(&text, 0, value), expected)
    Result<usize, CertificateTextError>.Failure { error: _ } => false
  }
}

fn identifierFails(identifier: &[u8]) -> bool {
  return match CertificateText.objectIdentifierLength(identifier) {
    Result<usize, CertificateTextError>.Failure { error: CertificateTextError.InvalidEncoding } => true
    _ => false
  }
}

fn serialIs(serial: &[u8], expected: &[u8]) -> bool {
  let mut text: [u8; 128] = [0; 128]
  let measured = match CertificateText.serialLength(serial) {
    Result<usize, CertificateTextError>.Success { value } => value
    Result<usize, CertificateTextError>.Failure { error: _ } => {
      return false
    }
  }
  if measured != expected.length {
    return false
  }
  return match CertificateText.writeSerial(serial, &mut text) {
    Result<usize, CertificateTextError>.Success { value } => equal(Slice.view<u8>(&text, 0, value), expected)
    Result<usize, CertificateTextError>.Failure { error: _ } => false
  }
}

fn timeIs(year: u16, month: u8, day: u8, hour: u8, minute: u8, second: u8, expected: &[u8]) -> bool {
  let mut text: [u8; 24] = [0; 24]
  let time = CertificateTime { year: year, month: month, day: day, hour: hour, minute: minute, second: second }
  let length = CertificateText.writeTime(time, &mut text)
  return equal(Slice.view<u8>(&text, 0, length), expected)
}

fn namesAre(identifier: &[u8], shortName: &[u8], longName: &[u8]) -> bool {
  let found = match CertificateText.objectName(identifier) {
    Option<ObjectName>.Some { value } => value
    Option<ObjectName>.None => {
      return false
    }
  }
  if !equal(found.shortName, shortName) || !equal(found.longName, longName) {
    return false
  }
  let byShort = match CertificateText.namedObject(shortName) {
    Option<ObjectName>.Some { value } => equal(value.identifier, identifier)
    Option<ObjectName>.None => false
  }
  let byLong = match CertificateText.namedObject(longName) {
    Option<ObjectName>.Some { value } => equal(value.identifier, identifier)
    Option<ObjectName>.None => false
  }
  return byShort && byLong
}

