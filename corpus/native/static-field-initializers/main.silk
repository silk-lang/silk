// A struct literal's `static for` initializes fields from static field descriptors, in concrete
// and generic literals, with effectful values and written initializers mixed in.
import silk.core.effect {Effect}
import silk.core.reflect {Reflect}
import silk.core.result {Result}
import silk.core.static_sequence {StaticSequence}

struct Point {
  pub x: i32,
  pub y: i32,
}

struct Settings {
  pub depth: i32,
  pub width: i32,
  pub verbose: bool,
  pub name: string<'static>,
}

struct Exhausted {}

effect fn next<V>(counter: &mut i32, static field: Intrinsic.Field<Point, V>) -> i32 ! Exhausted {
  counter.* = counter.* + 1
  if counter.* > 3 { fail Exhausted {} }
  return counter.*
}

effect fn counted(counter: &mut i32) -> Point ! Exhausted {
  return Point {static for field in Reflect.fields<Point>() { [field]: run next(&mut counter.*, field) }}
}

fn copied<T>(source: &T) -> T {
  return T {static for field in Reflect.fields<T>() { [field]: Reflect.borrowField(source, field).* }}
}

// The numeric fields, chosen by name during static evaluation.
static fn numeric() -> Intrinsic.StaticSequence<Intrinsic.Field<Settings, i32>> {
  let fields = StaticSequence.empty<Intrinsic.Field<Settings, i32>>()
  let depth = StaticSequence.append(fields, Reflect.field<Settings, i32>("depth"))
  return StaticSequence.append(depth, Reflect.field<Settings, i32>("width"))
}

fn renamed(source: &Settings, name: string<'static>) -> Settings {
  return Settings {
    name: name,
    verbose: !source.verbose,
    static for field in numeric() { [field]: Reflect.borrowField(source, field).* + 1 },
  }
}

pub fn main() -> i32 {
  let mut counter = 0
  let first = match run Effect.result(counted(&mut counter)) {
    Result<Point, Exhausted>.Success {value} => move value
    Result<Point, Exhausted>.Failure {..} => { return 1 }
  }
  let failed = match run Effect.result(counted(&mut counter)) {
    Result<Point, Exhausted>.Success {..} => false
    Result<Point, Exhausted>.Failure {..} => true
  }
  if !failed { return 2 }
  let point = copied<Point>(&first)
  let settings = copied<Settings>(&Settings {depth: 3, width: 8, verbose: true, name: "silk"})
  let changed = renamed(&settings, "warp")
  if changed.verbose { return 3 }
  if changed.name != "warp" { return 4 }
  if changed.width != 9 { return 5 }
  return point.x * 10 + point.y + changed.depth * 10
}
