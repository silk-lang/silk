import silk.text.segmentation
import silk.text.segmentation { GraphemeCursor }
import silk.core.result { Result }
import silk.text.string { InvalidUtf8 }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.text.string { String }
import silk.testing.testing { Testing, AssertionError }
import silk.core.effect { Effect }

effect fn expectOffsets(actual: &[usize], expected: &[usize]) -> ()
  ! AssertionError<'static> {
  run Testing.expect(actual.length == expected.length, "boundary count")
  let mut i: usize = 0
  while i < expected.length {
    run Testing.expect(actual[i] == expected[i], "UTF-8 byte boundary")
    i = i + 1
  }
}

effect fn check(kind: u8, text: string, expected: &[usize]) -> ()
  ! OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let bytes = String.utf8Bytes(text)
  let mut actual = List<usize>.make()
  if kind == 0 {
    run segmentation.graphemes(text, &mut actual)

    // Cursor and random-access cluster traversal share the same rule engine.
    let mut cursor = GraphemeCursor.make()
    let mut start: usize = 0
    let mut i: usize = 1
    while i < expected.length {
      run Testing.expect(GraphemeCursor.next(&mut cursor, text) == expected[i], "grapheme cursor")
      run Testing.expect(segmentation.nextGrapheme(text, start) == expected[i], "next grapheme")
      start = expected[i]
      i = i + 1
    }
    run Testing.expect(GraphemeCursor.next(&mut cursor, text) == bytes.length, "cursor EOF")
    run Testing.expect(segmentation.nextGrapheme(text, bytes.length) == bytes.length, "next EOF")
  } else if kind == 1 {
    run segmentation.words(text, &mut actual)
  } else {
    run segmentation.sentences(text, &mut actual)
  }
  run expectOffsets(List<usize>.asSlice(&actual), expected)
}

effect fn emptyAndSingleCases() -> ()
  ! OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  run check(0, "", &[0])
  run check(1, "", &[0])
  run check(2, "", &[0])
  run check(0, "é", &[0, 2])
  run check(1, "é", &[0, 2])
  run check(2, "é", &[0, 2])
}

effect fn controlsAndHangulCases() -> ()
  ! OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  run check(0, "\r\n\u{0308}a", &[0, 2, 4, 5])
  run check(0, "\u{0600}a\u{0903}\u{0308}b", &[0, 8, 9])
  run check(0, "\u{1100}\u{1161}\u{11a8}\u{ac00}\u{11a8}x", &[0, 9, 15, 16])
}

effect fn emojiAndRegionalCases() -> ()
  ! OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  run check(0, "\u{1f469}\u{1f3fd}\u{200d}\u{1f4bb}x", &[0, 15, 16])
  run check(0, "a\u{200d}\u{1f4bb}", &[0, 4, 8])
  run check(0, "\u{1f1e6}\u{1f1e7}\u{1f1e8}\u{1f1e9}\u{1f1ea}", &[0, 8, 16, 20])
  run check(0, "\u{1f1e6}\u{0308}\u{1f1e7}\u{1f1e8}", &[0, 6, 14])
  run check(0, "\u{1f469}\u{200d}\u{0308}\u{1f4bb}", &[0, 9, 13])
}

effect fn indicLinkerCases() -> ()
  ! OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  // Rev49 GB9c deliberately joins even a leading linker to its consonant.
  run check(0, "\u{094d}\u{0915}", &[0, 6])
  run check(0, "\u{094d}\u{0308}\u{0915}", &[0, 8])
  run check(0, "\u{0915}\u{094d}\u{0915}\u{094d}\u{0915}", &[0, 15])
  run check(0, "\u{094d}a\u{0915}", &[0, 3, 4, 7])
  run check(0, "\u{0915}\u{0308}\u{0915}", &[0, 5, 8])
}

effect fn contextualPunctuationCases() -> ()
  ! OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  run check(1, "can't 3,456.7 A3_a", &[0, 5, 6, 13, 14, 18])
  run check(1, "a:\u{0308}b a:\u{0308}!", &[0, 5, 6, 7, 10, 11])
  run check(1, "\u{05d0}' \u{05d0}\"\u{05d1}", &[0, 3, 4, 9])
  run check(1, "\u{05d0}\"x", &[0, 2, 3, 4])
  run check(1, "\u{30ab}\u{30bf}_x", &[0, 8])
}

effect fn ignoreRuleCases() -> ()
  ! OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  run check(1, "  ", &[0, 2])
  run check(1, " \u{0308} ", &[0, 3, 4])
  run check(1, "\r\n\u{0308}a", &[0, 2, 4, 5])
  run check(1, "\r\u{0308}\na", &[0, 1, 3, 4, 5])
  run check(1, "\u{0308}\u{200e}a", &[0, 5, 6])
  run check(1, "a\u{200e}b", &[0, 5])
  run check(1, "\u{200d}\u{1f4bb}", &[0, 7])
  run check(1, "\u{200d}\u{0308}\u{1f4bb}", &[0, 5, 9])
  run check(1, "\u{1f1e6}\u{0308}\u{1f1e7}\u{1f1e8}", &[0, 10, 14])
}

effect fn terminatorAndParagraphCases() -> ()
  ! OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  run check(2, "Hi!\" \r\nNext.", &[0, 7, 12])
  run check(2, "A.B 3.4 a. A", &[0, 11, 12])
  run check(2, "1.A", &[0, 2, 3])
  run check(2, "Go!?! Next", &[0, 6, 10])
  run check(2, "Hi! , still.", &[0, 12])
  run check(2, "\r\u{200e}A", &[0, 1, 5])
  run check(2, "x\u{2029}y", &[0, 4, 5])
  run check(2, "A.\u{0308}B", &[0, 5])
}

effect fn lowercaseLookaheadCases() -> ()
  ! OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  run check(2, ".(1) a", &[0, 6])
  run check(2, ".(1) A", &[0, 2, 6])
  run check(2, ".  )a", &[0, 5])
  run check(2, ".  )A", &[0, 3, 5])
  run check(2, ".  \u{200e}a", &[0, 7])
  let mut text = List<u8>.make()
  run List<u8>.append(&mut text, 46)
  let mut i: usize = 0
  while i < 4096 {
    run List<u8>.append(&mut text, 41)
    i = i + 1
  }
  run List<u8>.append(&mut text, 32)
  run List<u8>.append(&mut text, 97)
  let mut output = List<usize>.make()
  let valid = match String.fromUtf8(List<u8>.asSlice(&text)) {
    Result<string, InvalidUtf8>.Success { value } => value
    Result<string, InvalidUtf8>.Failure { error } => ""
  }
  run segmentation.sentences(valid, &mut output)
  run expectOffsets(List<usize>.asSlice(&output), &[0, 4099])
}

effect fn outputReuseCases() -> ()
  ! OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator {
  let mut output = List<usize>.make()
  run segmentation.graphemes("a", &mut output)
  run segmentation.words("b", &mut output)
  run segmentation.sentences("c", &mut output)
  run expectOffsets(List<usize>.asSlice(&output), &[0, 1, 0, 1, 0, 1])
}

effect fn emptyAndSingleBoundaries() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run emptyAndSingleCases() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn graphemeControlsAndHangul() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run controlsAndHangulCases() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn graphemeEmojiAndRegionalParity() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run emojiAndRegionalCases() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn unicode18IndicLinkerContext() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run indicLinkerCases() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn wordContextualPunctuation() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run contextualPunctuationCases() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn wordIgnoreRulePrecedence() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run ignoreRuleCases() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn sentenceTerminatorsAndParagraphs() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run terminatorAndParagraphCases() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn sentenceLowercaseLookahead() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run lowercaseLookaheadCases() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn outputReuse() -> ()
  ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run outputReuseCases() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Each check above runs in order; the first failed assertion ends the program with its own code.
effect fn all() -> i32
  ! AssertionError<'static> | OutOfMemoryError {
  run emptyAndSingleBoundaries()
  run graphemeControlsAndHangul()
  run graphemeEmojiAndRegionalParity()
  run unicode18IndicLinkerContext()
  run wordContextualPunctuation()
  run wordIgnoreRulePrecedence()
  run sentenceTerminatorsAndParagraphs()
  run sentenceLowercaseLookahead()
  run outputReuse()
  return 42
}

effect fn assertionFailed(error: AssertionError<'static>) -> i32 {
  return 1
}

effect fn outOfMemory(error: OutOfMemoryError) -> i32 {
  return 2
}

pub fn main() -> i32 {
  return run Effect.catch(Effect.catch(all(), assertionFailed), outOfMemory)
}
