import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.mem.layout { Layout }
import silk.mem.raw_buffer { RawBuffer }
import silk.mem.slot { Slot }
import silk.num.usize

effect fn exercise() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let allocation = run Allocator.allocate(Layout.of<[i32; 2]>()) |> Effect.provideMut(&mut allocator)
  unsafe {
    let mut buffer = RawBuffer.from<i32>(move allocation, 2)
    Slot.write(RawBuffer.slot(&mut buffer, 0), 17)
    Slot.write(RawBuffer.slot(&mut buffer, 1), 25)
    if RawBuffer.resize<i32>(&mut buffer, 1) { return 1 }
    if RawBuffer.resize<i32>(&mut buffer, usize.MAX) { return 2 }
    if RawBuffer.count(&buffer) != 2 { return 3 }
    if RawBuffer.read<i32>(&buffer, 0) != 17 || RawBuffer.read<i32>(&buffer, 1) != 25 { return 4 }
    if !RawBuffer.resize<i32>(&mut buffer, 8) { return 5 }
    if RawBuffer.count(&buffer) != 8 { return 6 }
    let first = Slot.take(RawBuffer.slot(&mut buffer, 0))
    let second = Slot.take(RawBuffer.slot(&mut buffer, 1))
    drop buffer
    return first + second
  }
  return 0
}
effect fn recover(error: OutOfMemoryError) -> i32 { return 7 }
pub fn main() -> i32 { return run Effect.catchAll(exercise(), recover) }
