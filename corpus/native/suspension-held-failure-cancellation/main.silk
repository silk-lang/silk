import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.concurrency.execution { Execution, Wake }
import silk.core.ownership { Drop }
unsafe extern "C" fn silk_record_drop(value: i32) -> ()
unsafe extern "C" fn silk_mark(value: i32) -> ()
unsafe extern "C" fn silk_verify_drops() -> i32
struct Token { value: i32 }
impl Drop for Token {
  fn drop(self: &mut Token) -> () { unsafe { silk_record_drop(self.value) } return () }
}
struct Pair { left: Token, right: Token }
struct Owned { token: Token }
struct Endpoint {}
fn ready(endpoint: &Endpoint) -> () { return () }
struct Guard { wake: Wake }
fn register(wake: Wake) -> Guard { return Guard { wake: move wake } }
fn mark(value: i32) -> () { unsafe { silk_mark(value) } return () }
effect fn failing() -> i32 ! Owned { fail Owned { token: Token { value: 6 } } }
effect fn succeeding() -> i32 ! Owned { return 5 }
// The finalizer parks while the protected part's owned failure waits for it.
effect fn parked() -> () {
  let local = Token { value: 7 }
  run Execution.park(register)
  return ()
}
effect fn delayed() -> () {
  let local = run Intrinsic.suspendEffect(effect { return Token { value: 7 } })
  return ()
}
effect fn recoverOwned(error: Owned) -> i32 { return error.token.value }
effect fn note() -> () { mark(90) return () }
// A nonparking finalizer nested inside the parking finalizer that holds the failure, in one frame:
// cancellation runs it before the held failure is dropped, as a completing exit does.
effect fn nested() -> i32 ! Owned {
  return run Intrinsic.finalizeEffect(failing(), Intrinsic.finalizeEffectNonParking(parked(), note()))
}
// A partial owner of the same frame is cleaned after the held failure.
effect fn heldWithOwner(flag: bool) -> i32 {
  let mut pair = Pair { left: Token { value: 1 }, right: Token { value: 2 } }
  if flag { let left = move pair.left drop left }
  let value = run Effect.ensuring(failing(), parked()) |> Effect.catchAll(recoverOwned)
  return value + pair.right.value
}
effect fn selected(which: i32) -> i32 {
  if which == 72 { return run Effect.catchAll(nested(), recoverOwned) }
  if which == 65 { return run Effect.ensuring(failing(), parked()) |> Effect.catchAll(recoverOwned) }
  if which == 66 { return run Effect.ensuring(succeeding(), parked()) |> Effect.catchAll(recoverOwned) }
  if which == 67 { return run heldWithOwner(true) }
  if which == 69 { return run Effect.ensuring(Effect.catchAll(failing(), recoverOwned), parked()) }
  return run heldWithOwner(false)
}
struct Empty {}
struct Stored { execution: Intrinsic.Execution<i32> }
struct Owner { slot: Empty | Stored }
fn complete(owner: &mut Owner, value: i32) -> () { return () }
fn suspend(owner: &mut Owner, execution: Intrinsic.Execution<i32>) -> () {
  let previous = Intrinsic.replace(owner.slot, Stored { execution: move execution })
  drop previous
  return ()
}
// Drops the parked Execution, cancelling its frames.
effect fn cancel(which: i32) -> () ! OutOfMemoryError {
  mark(which)
  let mut allocator = Allocator.systemAllocatorProvider()
  let execution = run Execution.make(selected(which), Endpoint {}, ready)
    |> Effect.provideMut(&mut allocator)
  let mut owner = Owner { slot: Empty {} }
  run Execution.drive(move execution, &mut owner, complete, suspend)
  drop owner
  return ()
}
effect fn program() -> i32 ! OutOfMemoryError {
  run cancel(65)
  run cancel(66)
  run cancel(67)
  run cancel(68)
  run cancel(69)
  run cancel(72)
  mark(70)
  let resumed = run Effect.ensuring(failing(), delayed()) |> Effect.catchAll(recoverOwned)
  mark(71)
  if resumed != 6 { return 1 }
  unsafe { return silk_verify_drops() }
}
effect fn recover(error: OutOfMemoryError) -> i32 { return 0 }
pub fn main() -> i32 { return run Effect.catchAll(program(), recover) }
