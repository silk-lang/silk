import silk.io.byte_duplex { ByteDuplex, ByteIoError, ReadTransfer }
import silk.core.effect { Effect }
import silk.system.monotonic_clock { MonotonicClock }
import silk.net.socket_native {
  AcceptedView,
  BoundAddress,
  ConnectOptions,
  Connection,
  ListenOptions,
  Listener,
  NativeSocketError,
  accept,
  connectResolvedOwned,
  listen,
  withAccepted,
}
import silk.net.address { Endpoint, IpAddress, Ipv4Address, Port }
import silk.option { Option }
import silk.system.monotonic_clock_native { OsMonotonicClock }
import silk.system.system_clock { Instant }

// Reads the 15 bytes that the client sent in three vectored writes.
effect fn receive<'call>(view: &'call mut AcceptedView<'call>) -> i32
  ! ByteIoError
  ? &mut MonotonicClock {
  let mut received: [u8; 15] = [0; 15]
  let mut length: usize = 0
  while length < 15 {
    let mut chunk: [u8; 15] = [0; 15]
    match move run ByteDuplex.readSome(&mut chunk, Option<Instant>.none())
      |> Effect.provideMut<ByteDuplex>(&mut view.connection.*) {
      ReadTransfer.Data { count } => {
        let mut index: usize = 0
        while index < count {
          if length == 15 { return 1 }
          received[length] = chunk[index]
          length = length + 1
          index = index + 1
        }
      }
      ReadTransfer.End => { return 2 }
    }
  }
  let expected = b"abcdefghijklmno"
  let mut at: usize = 0
  while at < 15 {
    if received[at] != expected[at] { return 3 }
    at = at + 1
  }
  return 0
}

effect fn program() -> i32
  ! NativeSocketError | ByteIoError
  ? &mut MonotonicClock {
  let local = Endpoint.make(
    IpAddress.V4 { value: Ipv4Address.fromOctets([127, 0, 0, 1]) },
    Port.fromU16(0)
  )
  let mut listener = run listen(local, ListenOptions.defaults())
  let bound = match Listener.boundAddress(&listener) {
    BoundAddress.Tcp { endpoint } => endpoint
    _ => { return 10 }
  }
  let targets = [bound]
  let mut client = run connectResolvedOwned(
    &targets,
    ConnectOptions.defaults(),
    Option<Instant>.none()
  )
  // Three slices, one empty, go in one gathered send.
  let opening: [&[u8]; 3] = [b"ab", b"", b"cde"]
  let sentFirst = run ByteDuplex.writeSomeVectored(&opening, Option<Instant>.none())
    |> Effect.provideMut<ByteDuplex>(&mut client)
  if sentFirst != 5 { return 11 }
  // One system call takes at most eight slices.
  let many: [&[u8]; 10] = [b"f", b"g", b"h", b"i", b"j", b"k", b"l", b"m", b"x", b"y"]
  let sentSecond = run ByteDuplex.writeSomeVectored(&many, Option<Instant>.none())
    |> Effect.provideMut<ByteDuplex>(&mut client)
  if sentSecond != 8 { return 12 }
  // One slice uses a plain send.
  let single: [&[u8]; 1] = [b"no"]
  let sentThird = run ByteDuplex.writeSomeVectored(&single, Option<Instant>.none())
    |> Effect.provideMut<ByteDuplex>(&mut client)
  if sentThird != 2 { return 13 }
  let accepted = run accept(&mut listener, Option<Instant>.none())
  run Listener.close(&mut listener)
  let served = run withAccepted<i32, ByteIoError>(move accepted, receive)
  run Connection.close(&mut client)
  return served
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  return 20
}

pub fn main() -> i32 {
  let mut clock = OsMonotonicClock.make()
  return run Effect.catchAll(program(), failed) |> Effect.provideMut<MonotonicClock>(&mut clock)
}
