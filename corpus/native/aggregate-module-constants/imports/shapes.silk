pub enum Mode { Fast, Slow }

pub struct Limits {
  pub steps: u32,
  pub mode: Mode,
  pub names: [string; 2],
}

pub struct Point {
  pub x: i32,
  pub y: i32,
}

static fn squares() -> [u32; 4] {
  return [0, 1, 4, 9]
}

pub const LIMITS: Limits = Limits {steps: 64, mode: Mode.Slow, names: ["low", "high"]}
pub const SQUARES: [u32; 4] = squares()
pub const ORIGIN: Point = Point {x: 3, y: 4}
pub const POINTS: [Point; 2] = [Point {x: 1, y: 2}, Point {x: 5, y: 6}]
pub const DEFAULT_MODE: Mode = Mode.Fast
