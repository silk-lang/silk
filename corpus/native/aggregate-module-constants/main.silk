import shapes { DEFAULT_MODE, LIMITS, Mode, ORIGIN, POINTS, Point, SQUARES }

fn last(table: &[u32; 4]) -> u32 { return table[3] }

fn sum(point: Point) -> i32 { return point.x + point.y }

pub fn main() -> i32 {
  let mut local = LIMITS
  local.steps = 1
  if LIMITS.steps != 64 || local.steps != 1 { return 1 }
  let table = &SQUARES
  if last(table) + SQUARES[2] != 13 { return 2 }
  let mut index: usize = 0
  let mut total: u32 = 0
  while index < 4 {
    total = total + SQUARES[index]
    index = index + 1
  }
  if total != 14 { return 3 }
  if sum(ORIGIN) + sum(ORIGIN) != 14 { return 4 }
  let points = POINTS
  if points[1].x + POINTS[0].y != 7 { return 5 }
  if let Mode.Fast = LIMITS.mode { return 6 }
  if let Mode.Slow = DEFAULT_MODE { return 7 }
  return 42
}
