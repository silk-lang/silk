import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.mem.layout { Layout }
import silk.collections.list { List }
import silk.num.usize
struct QuotaAllocator { remaining: i32 }
effect fn allocate(self: &mut QuotaAllocator, layout: Layout) -> Intrinsic.Allocation ! OutOfMemoryError {
  if self.remaining == 0 { fail OutOfMemoryError {} }
  self.remaining = self.remaining - 1
  let mut inner = Allocator.systemAllocatorProvider()
  return run Allocator.allocate(move layout) |> Effect.provideMut(&mut inner)
}
impl Allocator for QuotaAllocator { allocate: QuotaAllocator.allocate }
effect fn append(values: &mut List<i32>, value: i32) -> () ! OutOfMemoryError ? &mut Allocator {
  return run List<i32>.append(move values, value)
}
effect fn reserve(values: &mut List<i32>) -> () ! OutOfMemoryError ? &mut Allocator {
  return run List<i32>.reserve(move values, 100)
}
effect fn reserveAll(values: &mut List<i32>) -> () ! OutOfMemoryError ? &mut Allocator {
  return run List<i32>.reserve(move values, usize.MAX)
}
effect fn rejected(error: OutOfMemoryError) -> () { return () }
effect fn build() -> i32 ! OutOfMemoryError {
  let mut allocator = QuotaAllocator { remaining: 1 }
  let mut values = List<i32>.make()
  let a = run append(&mut values, 10) |> Effect.provideMut(&mut allocator)
  let b = run append(&mut values, 11) |> Effect.provideMut(&mut allocator)
  let c = run append(&mut values, 12) |> Effect.provideMut(&mut allocator)
  let d = run append(&mut values, 13) |> Effect.provideMut(&mut allocator)
  let growth = run Effect.catchAll(
    append(&mut values, 14) |> Effect.provideMut(&mut allocator),
    rejected,
  )
  drop growth
  if List<i32>.length(&values) != 4 || List<i32>.capacity(&values) != 4 { return 2 }
  if List<i32>.get(&values, 0) != 10 || List<i32>.get(&values, 3) != 13 { return 3 }
  let reserved = run Effect.catchAll(
    reserve(&mut values) |> Effect.provideMut(&mut allocator),
    rejected,
  )
  drop reserved
  if List<i32>.length(&values) != 4 || List<i32>.capacity(&values) != 4 { return 5 }
  if List<i32>.get(&values, 0) != 10 || List<i32>.get(&values, 3) != 13 { return 6 }
  // A length past `usize.MAX` is reported as OutOfMemoryError, not as an overflow trap.
  let mut unlimited = Allocator.systemAllocatorProvider()
  let overflowing = run Effect.catchAll(
    reserveAll(&mut values) |> Effect.provideMut(&mut unlimited),
    rejected,
  )
  drop overflowing
  if List<i32>.length(&values) != 4 || List<i32>.capacity(&values) != 4 { return 7 }
  return 42
}
effect fn outer(error: OutOfMemoryError) -> i32 { return 0 }
pub fn main() -> i32 { return run Effect.catchAll(build(), outer) }