import silk.concurrency.thread_native {NativeThread}
import silk.mem.pointer {Pointer}
import silk.num.u64

static if Intrinsic.targetOperatingSystem() == "linux" {
  import silk.core.effect {Effect}
  import silk.core.result {Result}
  import silk.system.system_info {SystemInfo, SystemInfoError}
  import silk.system.system_info_native {OsSystemInfo}
  @foreign(noCapture: .("mask"))
  unsafe extern "C" fn sched_getaffinity(pid: i32, size: usize, mask: ?[*]mut u64) -> i32
  unsafe extern "C" fn sched_setaffinity(pid: i32, size: usize, mask: ?[*]const u64) -> i32
}

pub effect fn main() -> i32 {
  static if Intrinsic.targetOperatingSystem() == "linux" {
    let mut original: [u64; 16] = [0; 16]
    if unsafe sched_getaffinity(0, 128, Pointer.fromMutSlice<u64>(&mut original)) != 0 {
      return if NativeThread.processorCount() == 1 { 42 } else { 1 }
    }
    let mut selected: [u64; 16] = [0; 16]
    let mut count: usize = 0
    let mut word: usize = 0
    let mut valid = true
    // Start with one CPU, then grow up to four without depending on the host's CPU numbering.
    while word < 16 && count < 4 {
      let mut bit: u64 = 0
      while bit < 64 && count < 4 {
        let flag = u64.shiftLeft(1, bit)
        if u64.bitAnd(original[word], flag) != 0 {
          selected[word] = u64.bitOr(selected[word], flag)
          count = count + 1
          if unsafe sched_setaffinity(0, 128, Pointer.fromSlice<u64>(&selected)) != 0 {
            valid = false
          } else {
            if NativeThread.processorCount() != count { valid = false }
            let mut provider = OsSystemInfo.make()
            let reported = run Effect.result(SystemInfo.availableParallelism())
              |> Effect.provideMut<SystemInfo>(&mut provider)
            match move reported {
              Result<usize, SystemInfoError>.Success {value} => { if value != count { valid = false } }
              Result<usize, SystemInfoError>.Failure {..} => { valid = false }
            }
          }
        }
        bit = bit + 1
      }
      word = word + 1
    }
    if unsafe sched_setaffinity(0, 128, Pointer.fromSlice<u64>(&original)) != 0 { return 2 }
    return if valid && count > 0 { 42 } else { 3 }
  } else {
    return if NativeThread.processorCount() >= 1 { 42 } else { 4 }
  }
}
