import silk.io.writer_native { StdoutWriter }
import silk.core.effect { Effect }
import silk.format { Debug, Format, Formatter }
import silk.option { Option }
import silk.io.writer { Writer, WriterError }

struct Path { pub steps: [i32; 3], pub flags: [Option<i32>; 2] }

impl Debug for Path {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return run Format.debugFields(self, "Path", &mut formatter)
  }
}

effect fn render() -> () ! WriterError ? &mut Writer {
  let values = [1, 2, 3]
  let view: &[i32] = &values
  // Arrays, anonymous tuples and records as `{:?}` arguments, and slices anywhere.
  run Format.format("{:?} {:?} {:?} {:?}\n", &(values, (1, "x"), .{ x: 1.5, y: 'c' }, [view, view]))
  // Arrays as struct fields.
  let path = Path { steps: values, flags: [Option<i32>.some(1), Option<i32>.none()] }
  run Format.format("{:?}\n", &(move path, ))
  // The pretty form of nested anonymous tuples and arrays.
  run Format.format("{:#?}\n", &((view, [true]), ))
  // Slices implement Debug, so Format.debug and Option accept them.
  run Format.debug(&view)
  let mut buffer = [4, 5]
  let mutable: &mut [i32] = &mut buffer
  run Format.debug(&mutable)
  let empty: [i32; 0] = []
  run Format.format("\n{:?} {:?}\n", &(empty, Option<&[i32]>.some(view)))
  return ()
}

effect fn build() -> i32 ! WriterError {
  let mut writer = StdoutWriter.make()
  run render() |> Effect.provideMut<Writer>(&mut writer)
  return 42
}

effect fn recover(error: WriterError) -> i32 { return 1 }

pub fn main() -> i32 { return run Effect.catchAll(build(), recover) }
