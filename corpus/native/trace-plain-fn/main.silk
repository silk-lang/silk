import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.concurrency.sync { Arc }
import silk.trace.record { Recorder, Config }
import silk.trace { Tracer, Trace }
import silk.io.logger { InMemoryLogger, Logger }

import silk.core.option { Option }
import silk.trace.record { Span }
fn parse(value: i32) -> i32 {
  let _guard = Trace.span("parse")
  Trace.set("input", &value)
  return value + 1
}
effect fn exercise() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let logger = run Arc<InMemoryLogger>.make(run Logger.inMemoryProvider())
  let quiet = run Effect.provideAmbient<Logger>(effect {
    run Effect.logInfo("starting", &())
    return Trace.span("off")
  }, &logger)
  // This guard observed Off under an unrelated ambient table.
  drop quiet
  if Logger.length(logger.get()) != 1 { return 3 }
  let rec = run Arc<Recorder>.make(run Recorder.make(Config.make("plain")))
  let result = run Effect.provideAmbient<Tracer>(effect { return parse(41) }, &rec)
  if result != 42 { return 1 }
  if let Option<Span>.Some {value} = rec.get().takeSpan() {
    if value.name == "parse" && value.attributes.count == 1 { return 0 }
  }
  return 2
}
effect fn failed(error: OutOfMemoryError) -> i32 { return 4 }
pub fn main() -> i32 {
  let mut alloc = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(exercise() |> Effect.provideMut<Allocator>(&mut alloc), failed)
}
