//! Range, literal and alternative patterns select integer, `char`, `bool` and enum values at
//! runtime and in static functions. A match that names every value of its scrutinee needs no `_`.
import silk.num.u8

enum Light { Red, Amber, Green, Off }

union Reading { Missing, Value {pub amount: i32} }

fn classify(c: char) -> i32 {
  return match c {
    '0'..='9' => 1
    'a'..='z' | 'A'..='Z' => 2
    ' ' | '\t' | '\n' => 3
    'é' => 4
    _ => 0
  }
}

fn band(value: u8) -> i32 {
  return match value {
    0 => 0
    1..10 => 1
    10..=99 => 2
    100.. => 3
  }
}

fn sign(value: i64) -> i32 {
  return match value {
    ..=-1 => -1
    0 => 0
    1.. => 1
  }
}

fn flag(value: bool) -> i32 {
  return match value {
    true => 10
    false => 20
  }
}

fn moving(light: Light) -> bool {
  return match light {
    Light.Green | Light.Amber => true
    Light.Red | Light.Off => false
  }
}

fn present(reading: Reading) -> i32 {
  return match move reading {
    Reading.Missing | Reading.Value {..} if false => 0
    Reading.Value {amount} => amount
    _ => -1
  }
}

fn guarded(value: i32) -> i32 {
  return match value {
    1 | 2 | 3 if value != 2 => 1
    1..=5 => 2
    _ => 3
  }
}

static fn weekday(day: u8) -> u8 {
  return match day {
    1..=5 => 1
    6 | 7 => 2
    _ => 0
  }
}

pub fn main() -> i32 {
  static if weekday(3) != 1 { compileError("a static range arm") }
  static if weekday(7) != 2 { compileError("a static alternative") }
  static if weekday(9) != 0 { compileError("a static universal arm") }
  if classify('7') != 1 { return 1 }
  if classify('q') != 2 || classify('Q') != 2 { return 2 }
  if classify('\t') != 3 { return 3 }
  if classify('é') != 4 || classify('#') != 0 { return 4 }
  if band(0) != 0 || band(9) != 1 || band(10) != 2 || band(99) != 2 || band(100) != 3 || band(255) != 3 { return 5 }
  if sign(-9223372036854775807) != -1 || sign(0) != 0 || sign(42) != 1 { return 6 }
  if flag(true) != 10 || flag(false) != 20 { return 7 }
  if !moving(Light.Amber) || moving(Light.Off) { return 8 }
  if present(Reading.Value {amount: 5}) != 5 || present(Reading.Missing) != -1 { return 9 }
  if guarded(1) != 1 || guarded(2) != 2 || guarded(3) != 1 || guarded(5) != 2 || guarded(9) != 3 { return 10 }
  let static day = weekday(6)
  return u8.toI32(day) + 40
}
