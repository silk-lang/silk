// A declared `?S in R` premise lets an Effect requiring `S` run inside `? R`.
import silk.core.effect { Effect }

service Clock {
  effect fn now() -> i32 ? &Clock
}

struct Fixed {
  value: i32,
}

impl Clock for Fixed {
  effect fn now(self: &Self) -> i32 {
    return self.value
  }
}

effect fn inner<?S>(work: once Effect<i32 ? S>) -> i32
? S {
  return run move work
}

effect fn outer<?R, ?S>(work: once Effect<i32 ? S>) -> i32
? R
where S in R {
  return run inner(move work)
}

effect fn read() -> i32
? &Clock {
  return run Clock.now()
}

pub fn main() -> i32 {
  let clock = Fixed {value: 42}
  return run Effect.provide(outer<&Clock, &Clock>(read()), &clock)
}
