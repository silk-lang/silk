// Socket controls that a runtime such as Node needs: UDP options, multicast groups, buffer sizes,
// a connected peer and its removal, an adopted descriptor, and a TCP connect from a chosen local port. Each failing check
// returns its own exit code.
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.net.address { Endpoint, IpAddress, Ipv4Address, Ipv6Address, Port }
import silk.net.datagram_native { DatagramError, Family, MulticastInterface, NativeUdpSocket, Received, Sent }
import silk.net.socket_native {
  BoundAddress,
  ConnectOptions,
  ConnectProgress,
  Connection,
  Incoming,
  ListenOptions,
  ListenOptionsError,
  Listener,
  NativeSocketError,
  PeerAddress,
  listen,
  startConnectFrom,
}

static if Intrinsic.targetOperatingSystem() != "windows" {
  unsafe extern "C" fn dup(fd: i32) -> i32
}

effect fn datagrams() -> i32 ! DatagramError {
  let loopback = Ipv4Address.fromOctets([127, 0, 0, 1])
  let local = IpAddress.V4 { value: loopback }
  let mut receiver = run NativeUdpSocket.open(Family.V4)
  run receiver.setReuseAddress(true)
  run receiver.bind(Endpoint.make(local, Port.fromU16(0)))
  let port = Endpoint.port(&run receiver.localEndpoint())
  // An adopted copy of the receiver's descriptor is the same bound socket.
  static if Intrinsic.targetOperatingSystem() != "windows" {
    let copy = unsafe dup(NativeUdpSocket.rawDescriptor(&receiver))
    if copy < 0 {
      return 50
    }
    let adopted = run unsafe NativeUdpSocket.adopt(copy, Family.V4)
    if Port.value(&Endpoint.port(&run adopted.localEndpoint())) != Port.value(&port) {
      return 51
    }
    drop adopted
  }
  let mut sender = run NativeUdpSocket.open(Family.V4)
  run sender.setBroadcast(true)
  run sender.setTtl(7)
  run sender.setMulticastTtl(3)
  run sender.setMulticastLoopback(true)
  run sender.setMulticastInterface(MulticastInterface.Default)
  run sender.setReceiveBufferSize(65536)
  run sender.setSendBufferSize(32768)
  if (run sender.receiveBufferSize()) < 32768 {
    return 1
  }
  if (run sender.sendBufferSize()) < 16384 {
    return 2
  }
  run sender.connect(Endpoint.make(local, port))
  let peer = run sender.peerEndpoint()
  if Port.value(&Endpoint.port(&peer)) != Port.value(&port) {
    return 3
  }
  let sent = run sender.send(b"hi")
  match move sent {
    Sent.Count { count } => {
      if count != 2 {
        return 4
      }
    }
    Sent.WouldBlock => {
      return 5
    }
  }
  let mut buffer: [u8; 64] = [0; 64]
  let mut waiting = true
  let mut tries = 0
  while waiting && tries < 10000000 {
    let got = run receiver.receive(&mut buffer)
    match move got {
      Received.Datagram { count, .. } => {
        if count != 2 {
          return 6
        }
        waiting = false
      }
      Received.WouldBlock => {
        tries = tries + 1
      }
    }
  }
  if waiting {
    return 7
  }
  run sender.disconnect()
  let gone = run Effect.result(sender.peerEndpoint())
  match move gone {
    Result<Endpoint, DatagramError>.Success { .. } => {
      return 8
    }
    Result<Endpoint, DatagramError>.Failure { error } => {
      drop error
    }
  }
  let wrong = run Effect.result(sender.setIpv6Only(true))
  match move wrong {
    Result<(), DatagramError>.Success { .. } => {
      return 9
    }
    Result<(), DatagramError>.Failure { error } => {
      match move error {
        DatagramError.FamilyUnsupported => {}
        DatagramError other => {
          drop other
          return 10
        }
      }
    }
  }
  let mismatched = run Effect.result(sender.setMulticastInterface(MulticastInterface.V6 { index: 0 }))
  match move mismatched {
    Result<(), DatagramError>.Success { .. } => {
      return 11
    }
    Result<(), DatagramError>.Failure { error } => {
      drop error
    }
  }
  let group = IpAddress.V4 { value: Ipv4Address.fromOctets([239, 1, 2, 3]) }
  run receiver.joinGroup(group, MulticastInterface.Default)
  run receiver.leaveGroup(group, MulticastInterface.Default)
  let left = run Effect.result(receiver.leaveGroup(group, MulticastInterface.Default))
  match move left {
    Result<(), DatagramError>.Success { .. } => {
      return 12
    }
    Result<(), DatagramError>.Failure { error } => {
      drop error
    }
  }
  let sourced = IpAddress.V4 { value: Ipv4Address.fromOctets([232, 1, 2, 3]) }
  run receiver.joinSourceGroup(sourced, local, MulticastInterface.Default)
  run receiver.leaveSourceGroup(sourced, local, MulticastInterface.Default)
  let crossed = run Effect.result(receiver.joinGroup(group, MulticastInterface.V6 { index: 1 }))
  match move crossed {
    Result<(), DatagramError>.Success { .. } => {
      return 13
    }
    Result<(), DatagramError>.Failure { error } => {
      match move error {
        DatagramError.FamilyUnsupported => {}
        DatagramError other => {
          drop other
          return 14
        }
      }
    }
  }
  return 0
}

effect fn connectFrom() -> i32 ! NativeSocketError {
  let local = IpAddress.V4 { value: Ipv4Address.fromOctets([127, 0, 0, 1]) }
  let options = match ListenOptions.make(16, false, false, 1000000) {
    Result<ListenOptions, ListenOptionsError>.Success { value } => value
    Result<ListenOptions, ListenOptionsError>.Failure { .. } => {
      return 20
    }
  }
  if ListenOptions.ipv6Only(&options) || !ListenOptions.ipv6Only(&ListenOptions.defaults()) {
    return 21
  }
  let mut listener = run listen(Endpoint.make(local, Port.fromU16(0)), options)
  let target = match Listener.boundAddress(&listener) {
    BoundAddress.Tcp { endpoint } => endpoint
    _ => {
      return 22
    }
  }
  // A free port to connect from: one that a second listener got, then gave back.
  let mut probe = run listen(Endpoint.make(local, Port.fromU16(0)), ListenOptions.defaults())
  let wanted = match Listener.boundAddress(&probe) {
    BoundAddress.Tcp { endpoint } => endpoint
    _ => {
      return 23
    }
  }
  run Listener.close(&mut probe)
  let mut client = run startConnectFrom(wanted, target, ConnectOptions.defaults())
  let mut connecting = true
  let mut tries = 0
  while connecting && tries < 10000000 {
    let progress = run client.finishConnect()
    match progress {
      ConnectProgress.Connected => {
        connecting = false
      }
      _ => {
        tries = tries + 1
      }
    }
  }
  if connecting {
    return 24
  }
  let bound = run client.localEndpoint()
  if Port.value(&Endpoint.port(&bound)) != Port.value(&Endpoint.port(&wanted)) {
    return 25
  }
  let mut waiting = true
  tries = 0
  while waiting && tries < 10000000 {
    let incoming = run listener.tryAccept()
    match move incoming {
      Incoming.Client { accepted } => {
        match accepted.peer() {
          PeerAddress.Tcp { endpoint } => {
            if Port.value(&Endpoint.port(&endpoint)) != Port.value(&Endpoint.port(&wanted)) {
              return 26
            }
          }
          _ => {
            return 27
          }
        }
        drop accepted
        waiting = false
      }
      Incoming.WouldBlock => {
        tries = tries + 1
      }
    }
  }
  if waiting {
    return 28
  }
  let six = Endpoint.make(IpAddress.V6 { value: Ipv6Address.fromOctets([0; 16]) }, Port.fromU16(0))
  let mixed = run Effect.result(startConnectFrom(six, target, ConnectOptions.defaults()))
  match move mixed {
    Result<Connection, NativeSocketError>.Success { value } => {
      drop value
      return 29
    }
    Result<Connection, NativeSocketError>.Failure { error } => {
      match move error {
        NativeSocketError.FamilyUnsupported => {}
        NativeSocketError other => {
          drop other
          return 30
        }
      }
    }
  }
  drop client
  return 0
}

pub effect fn main() -> i32 {
  let udp = run Effect.result(datagrams())
  let first = match move udp {
    Result<i32, DatagramError>.Success { value } => value
    Result<i32, DatagramError>.Failure { error } => {
      drop error
      return 40
    }
  }
  if first != 0 {
    return first
  }
  let tcp = run Effect.result(connectFrom())
  return match move tcp {
    Result<i32, NativeSocketError>.Success { value } => value
    Result<i32, NativeSocketError>.Failure { error } => {
      drop error
      41
    }
  }
}
