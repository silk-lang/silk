import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.compress.brotli_encode {
  BrotliEncodeError,
  BrotliEncodeErrorKind,
  BrotliEncodeProgress,
  BrotliEncodeStatus,
  BrotliEncoder,
  BrotliFlush,
  BrotliOptions
}
import silk.compress.brotli { Brotli, BrotliError, BrotliLimits, BrotliProgress, BrotliStatus }
import silk.collections.list { List }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.num.u32
import silk.num.usize

// Decodes `encoded` with the Silk decoder and checks that it is exactly `input`.
effect fn decodes(encoded: &[u8], input: &[u8]) -> bool
  ! OutOfMemoryError | BrotliError
  ? &mut Allocator {
  let mut decoded = List<u8>.make()
  run List<u8>.appendRepeated(&mut decoded, 165, input.length + 1)
  let mut decoder = run Brotli.make(BrotliLimits.make())
  let valid = match move Brotli.step(
    &mut decoder,
    encoded,
    List<u8>.asMutSlice(&mut decoded),
    true,
  ) {
    Result<BrotliProgress, BrotliError>.Success { value } => value.status == BrotliStatus.Finished
      && value.consumed == encoded.length
      && value.written == input.length
    Result<BrotliProgress, BrotliError>.Failure { .. } => false
  }
  if !valid {
    return false
  }
  let mut index: usize = 0
  while index < input.length {
    if List<u8>.get(&decoded, index) != input[index] {
      return false
    }
    index = index + 1
  }
  return List<u8>.get(&decoded, input.length) == 165
}

// One-shot encoding within the bound.
effect fn roundtrip(input: &[u8], options: BrotliOptions) -> bool
  ! OutOfMemoryError | BrotliEncodeError | BrotliError
  ? &mut Allocator {
  let bound = match move BrotliEncoder.encodedBound(input.length) {
    Option<usize>.Some { value } => value
    Option<usize>.None => {
      return false
    }
  }
  let mut encoded = List<u8>.make()
  run List<u8>.appendRepeated(&mut encoded, 165, bound + 1)
  let size = run BrotliEncoder.encode(input, List<u8>.asMutSlice(&mut encoded), move options)
  if List<u8>.get(&encoded, size) != 165 {
    return false
  }
  return run decodes(Slice.view<u8>(List<u8>.asSlice(&encoded), 0, size), input)
}

// Streams `input` in 1000-byte parts with `flush` after each part and a 7-byte output buffer.
effect fn streamed(input: &[u8], quality: u32, flush: BrotliFlush) -> bool
  ! OutOfMemoryError | BrotliEncodeError | BrotliError
  ? &mut Allocator {
  let mut options = BrotliOptions.make(quality)
  options.windowBits = 16
  let mut encoder = run BrotliEncoder.make(move options)
  let mut encoded = List<u8>.make()
  let mut buffer: [u8; 7] = [0; 7]
  let mut position: usize = 0
  while true {
    let mut end = position + 1000
    let mut mode = flush
    if end >= input.length {
      end = input.length
      mode = BrotliFlush.End
    }
    let mut part = Slice.view<u8>(input, position, end - position)
    while true {
      let progress = match move BrotliEncoder.step(&mut encoder, part, &mut buffer, mode) {
        Result<BrotliEncodeProgress, BrotliEncodeError>.Success { value } => move value
        Result<BrotliEncodeProgress, BrotliEncodeError>.Failure { .. } => {
          return false
        }
      }
      run List<u8>.appendSlice(&mut encoded, Slice.view<u8>(&buffer, 0, progress.written))
      part = Slice.view<u8>(part, progress.consumed, part.length - progress.consumed)
      if progress.status == BrotliEncodeStatus.Finished {
        return run decodes(List<u8>.asSlice(&encoded), input)
      }
      if progress.status == BrotliEncodeStatus.NeedInput
        || progress.status == BrotliEncodeStatus.Flushed {
        break
      }
    }
    if flush == BrotliFlush.Flush {
      // Everything so far ends on a whole byte, so a decoder can decode all of it now.
      let mut decoded = List<u8>.make()
      run List<u8>.appendRepeated(&mut decoded, 0, end)
      let mut decoder = run Brotli.make(BrotliLimits.make())
      let complete = match move Brotli.step(
        &mut decoder,
        List<u8>.asSlice(&encoded),
        List<u8>.asMutSlice(&mut decoded),
        false,
      ) {
        Result<BrotliProgress, BrotliError>.Success { value } => value.written == end
        Result<BrotliProgress, BrotliError>.Failure { .. } => false
      }
      if !complete {
        return false
      }
    }
    position = end
  }
  return false
}

// A buffer one byte shorter than the stream fails with OutputFull after filling it completely.
effect fn bounds() -> bool
  ! OutOfMemoryError | BrotliEncodeError
  ? &mut Allocator {
  let input = b"abracadabra abracadabra abracadabra"
  let mut output: [u8; 128] = [165; 128]
  let size = run BrotliEncoder.encode(input, &mut output, BrotliOptions.make(5))
  let mut small = List<u8>.make()
  run List<u8>.appendRepeated(&mut small, 165, size - 1)
  let result = run Effect.result(
    BrotliEncoder.encode(input, List<u8>.asMutSlice(&mut small), BrotliOptions.make(5)),
  )
  return match move result {
    Result<usize, OutOfMemoryError | BrotliEncodeError>.Success { .. } => false
    Result<usize, OutOfMemoryError | BrotliEncodeError>.Failure { error } => match move error {
      BrotliEncodeError failure => failure.kind == BrotliEncodeErrorKind.OutputFull
        && failure.written == size - 1
        && List<u8>.get(&small, size - 2) == output[size - 2]
      OutOfMemoryError { .. } => false
    }
  }
}

// Invalid options fail before allocating, and input after the end fails.
effect fn misuse() -> bool
  ! OutOfMemoryError | BrotliEncodeError
  ? &mut Allocator {
  let invalid = run Effect.result(BrotliEncoder.make(BrotliOptions.make(12)))
  let rejected = match move invalid {
    Result<BrotliEncoder, OutOfMemoryError | BrotliEncodeError>.Success { .. } => false
    Result<BrotliEncoder, OutOfMemoryError | BrotliEncodeError>.Failure {
      error
    } => match move error {
      BrotliEncodeError failure => failure.kind == BrotliEncodeErrorKind.InvalidOptions
      OutOfMemoryError { .. } => false
    }
  }
  if !rejected {
    return false
  }
  let mut options = BrotliOptions.make(1)
  options.windowBits = 10
  let mut encoder = run BrotliEncoder.make(move options)
  let mut output: [u8; 64] = [0; 64]
  let size = match move BrotliEncoder.step(&mut encoder, b"four", &mut output, BrotliFlush.End) {
    Result<BrotliEncodeProgress, BrotliEncodeError>.Success { value } => value.written
    Result<BrotliEncodeProgress, BrotliEncodeError>.Failure { .. } => {
      return false
    }
  }
  let late = match move BrotliEncoder.step(&mut encoder, b"more", &mut output, BrotliFlush.End) {
    Result<BrotliEncodeProgress, BrotliEncodeError>.Success { .. } => false
    Result<BrotliEncodeProgress, BrotliEncodeError>.Failure { error } => error.kind
      == BrotliEncodeErrorKind.InvalidUse
  }
  if !late || size == 0 {
    return false
  }
  BrotliEncoder.reset(&mut encoder)
  return match move BrotliEncoder.step(&mut encoder, b"four", &mut output, BrotliFlush.End) {
    Result<BrotliEncodeProgress, BrotliEncodeError>.Success { value } => value.written == size
      && value.status == BrotliEncodeStatus.Finished
    Result<BrotliEncodeProgress, BrotliEncodeError>.Failure { .. } => false
  }
}

effect fn program() -> i32
  ! OutOfMemoryError | BrotliEncodeError | BrotliError
  ? &mut Allocator {
  let mut text = List<u8>.make()
  let mut index: usize = 0
  while index < 20000 {
    let word = usize.remainder(index * 2654435761, 977)
    run List<u8>.appendSlice(&mut text, b"brotli ")
    run List<u8>.append(&mut text, usize.toU8(97 + usize.remainder(word, 26)))
    run List<u8>.append(&mut text, usize.toU8(97 + usize.remainder(word / 26, 26)))
    if usize.remainder(index, 11) == 0 {
      run List<u8>.append(&mut text, 10)
    }
    index = index + 1
  }
  let mut noise = List<u8>.make()
  let mut seed: u32 = 1
  index = 0
  while index < 30000 {
    seed = u32.wrappingAdd(u32.wrappingMultiply(seed, 1103515245), 12345)
    run List<u8>.append(&mut noise, u32.toU8(u32.shiftRight(seed, 16) & 255))
    index = index + 1
  }
  let mut same = List<u8>.make()
  run List<u8>.appendRepeated(&mut same, 120, 150000)
  let inputs: [&[u8]; 6] = [
    b"",
    b"a",
    b"abcabcabcabcabcabcabc",
    List<u8>.asSlice(&text),
    List<u8>.asSlice(&noise),
    List<u8>.asSlice(&same),
  ]
  let qualities: [u32; 6] = [0, 2, 4, 6, 9, 11]
  let mut input: usize = 0
  while input < 6 {
    let mut quality: usize = 0
    while quality < 6 {
      let mut options = BrotliOptions.make(qualities[quality])
      if usize.remainder(quality, 2) == 1 {
        options.windowBits = 18
      }
      if !run roundtrip(inputs[input], move options) {
        return 1
      }
      quality = quality + 1
    }
    input = input + 1
  }
  let textSlice = List<u8>.asSlice(&text)
  if !run streamed(textSlice, 5, BrotliFlush.Flush) {
    return 2
  }
  if !run streamed(textSlice, 9, BrotliFlush.Continue) {
    return 3
  }
  if !run streamed(List<u8>.asSlice(&noise), 1, BrotliFlush.Flush) {
    return 4
  }
  if !run streamed(b"", 3, BrotliFlush.Flush) {
    return 5
  }
  if !run bounds() {
    return 6
  }
  if !run misuse() {
    return 7
  }
  return 42
}

pub effect fn main() -> i32
  ! OutOfMemoryError | BrotliEncodeError | BrotliError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run program() |> Effect.provideMut<Allocator>(&mut allocator)
}
