// Typed regex captures: Regex.typed checks a pattern against a declared struct at compile time,
// and a search returns that struct with fields borrowing the searched text.
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.regex { Matcher, Regex, RegexError, Typed }

/// A Silk release version, as in v0.1.0-dev.58+fb6ce3a.
struct Version<'a> {
  pub major: string<'a>,
  pub minor: string<'a>,
  pub patch: string<'a>,
  pub pre: Option<string<'a>>,
  pub build: Option<string<'a>>,
}

const VERSION: Typed<Version<'static>> = Regex.typed<Version<'static>>(
  "^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(-(?<pre>[0-9A-Za-z.]+))?(\\+(?<build>[0-9a-f]+))?$",
)

/// A word on either side of an `=` or a `:`.
struct Pair<'a> {
  pub key: string<'a>,
  pub value: Option<string<'a>>,
}

const PAIR: Typed<Pair<'static>> = Regex.typed<Pair<'static>>(
  "(?<key>\\w+)(?:=(?<value>\\w+)|:(?<value>\\w+))?",
)

/// Either branch of an alternation: `whole` must try the second when the first stops short.
struct Short<'a> {
  pub word: string<'a>,
}

const SHORT: Typed<Short<'static>> = Regex.typed<Short<'static>>("(?<word>a|ab)")

effect fn pairOf<'a>(pairs: &Matcher<Pair<'static>>, text: string<'a>) -> Option<Pair<'a>>
  ! RegexError | OutOfMemoryError
  ? &mut Allocator {
  return run pairs.find<Pair<'a>>(text)
}

effect fn shortOf<'a>(shorts: &Matcher<Short<'static>>, text: string<'a>, whole: bool) -> Option<
  Short<'a>
>
  ! RegexError | OutOfMemoryError
  ? &mut Allocator {
  if whole {
    return run shorts.whole<Short<'a>>(text)
  }
  return run shorts.find<Short<'a>>(text)
}

effect fn parse<'a>(versions: &Matcher<Version<'static>>, tag: string<'a>) -> Option<Version<'a>>
  ! RegexError | OutOfMemoryError
  ? &mut Allocator {
  return run versions.whole<Version<'a>>(tag)
}

effect fn check() -> i32
  ! RegexError | OutOfMemoryError
  ? &mut Allocator {
  let versions = run VERSION.compile()
  let found = run parse(&versions, "v0.1.0-dev.58+fb6ce3a")
  match move found {
    Option<Version>.Some { value: v } => {
      if v.major != "0" || v.minor != "1" || v.patch != "0" {
        return 1
      }
      if &v.pre != &Option<string>.some("dev.58") {
        return 2
      }
      if &v.build != &Option<string>.some("fb6ce3a") {
        return 3
      }
    }
    Option<Version>.None => {
      return 4
    }
  }
  let plain = run parse(&versions, "v12.3.4")
  match move plain {
    Option<Version>.Some { value: v } => {
      if v.major != "12" || v.pre.isSome() || v.build.isSome() {
        return 5
      }
    }
    Option<Version>.None => {
      return 6
    }
  }
  let none = run parse(&versions, "12.3.4")
  if none.isSome() {
    return 7
  }

  // A name two alternatives share fills one field from whichever took part, after non-ASCII text.
  let pairs = run PAIR.compile()
  let colon = run pairOf(&pairs, "é → size:large")
  match move colon {
    Option<Pair>.Some { value: p } => {
      if p.key != "size" || &p.value != &Option<string>.some("large") {
        return 8
      }
    }
    Option<Pair>.None => {
      return 9
    }
  }
  let equals = run pairOf(&pairs, "mode=fast")
  match move equals {
    Option<Pair>.Some { value: p } => {
      if &p.value != &Option<string>.some("fast") {
        return 10
      }
    }
    Option<Pair>.None => {
      return 11
    }
  }
  let bare = run pairOf(&pairs, "  alone")
  match move bare {
    Option<Pair>.Some { value: p } => {
      if p.key != "alone" || p.value.isSome() {
        return 12
      }
    }
    Option<Pair>.None => {
      return 13
    }
  }

  let shorts = run SHORT.compile()
  let first = run shortOf(&shorts, "ab", false)
  match move first {
    Option<Short>.Some { value: w } => {
      if w.word != "a" {
        return 14
      }
    }
    Option<Short>.None => {
      return 15
    }
  }
  let spanning = run shortOf(&shorts, "ab", true)
  match move spanning {
    Option<Short>.Some { value: w } => {
      if w.word != "ab" {
        return 16
      }
    }
    Option<Short>.None => {
      return 17
    }
  }
  let inner = run shortOf(&shorts, "xab", true)
  if inner.isSome() {
    return 18
  }
  return 0
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  return 99
}

pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(check(), failed) |> Effect.provideMut<Allocator>(&mut allocator)
}
