// Writes the problems decodeAll found as snippets, lines and JSON, and redacted.
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.schema.issue { SchemaError, SchemaErrors }
import silk.schema.json { SchemaJson }
import silk.schema.report { ReportOptions, SchemaReport }
import silk.schema.schema { Schema, Spec }
import silk.text.string { String }

union Auth {
  Anonymous,
  Token { pub value: String },
  Basic { pub user: String },
}
impl Schema for Auth {}

struct Server {
  pub port: u16,
  pub idleSeconds: u32,
  pub auth: Auth,
}

impl Schema for Server {
  static fn spec() -> Spec<Server> {
    return Spec<Server>.of()
      |> Spec<Server>.rename("idleSeconds", "idle_seconds")
      |> Spec<Server>.between("port", 1, 65535)
      |> Spec<Server>.atMost("idleSeconds", 3600)
      |> Spec<Server>.expected("idleSeconds", "at most an hour")
  }
}

const INPUT: &[u8] = b"{\n  \"port\": 0,\n  \"idle_seconds\": 7200,\n  \"auth\": {\n    \"type\": \"Bsic\"\n  }\n}\n"

const SNIPPET: &[u8] = b" --> server.json:2:11 at port\n  |\n2 |   \"port\": 0,\n  |           ^ expected an integer from 1 to 65535, got 0\n --> server.json:3:19 at idle_seconds\n  |\n3 |   \"idle_seconds\": 7200,\n  |                   ^^^^ expected at most an hour, got 7200\n --> server.json:5:13 at auth.type\n  |\n5 |     \"type\": \"Bsic\"\n  |             ^^^^^^ expected one of \"Anonymous\", \"Token\", \"Basic\", got \"Bsic\"\n"

const LINES: &[u8] = b"server.json:2:11: port: expected an integer from 1 to 65535, got 0\nserver.json:3:19: idle_seconds: expected at most an hour, got 7200\nserver.json:5:13: auth.type: expected one of \"Anonymous\", \"Token\", \"Basic\", got \"Bsic\"\n"

const REDACTED: &[u8] = b"server.json:2:11: port: expected an integer from 1 to 65535, got a number\nserver.json:3:19: idle_seconds: expected at most an hour, got a number\nserver.json:5:13: auth.type: expected one of \"Anonymous\", \"Token\", \"Basic\", got text\n"

const JSON: &[u8] = b"{\"problems\":[{\"path\":\"/port\",\"reason\":\"CheckFailed\",\"expected\":\"an integer from 1 to 65535\",\"found\":\"a number\",\"value\":\"0\",\"line\":2,\"column\":11,\"start\":12,\"end\":13},{\"path\":\"/idle_seconds\",\"reason\":\"CheckFailed\",\"expected\":\"at most an hour\",\"found\":\"a number\",\"value\":\"7200\",\"line\":3,\"column\":19,\"start\":33,\"end\":37},{\"path\":\"/auth/type\",\"reason\":\"UnknownVariant\",\"expected\":\"one of \\\"Anonymous\\\", \\\"Token\\\", \\\"Basic\\\"\",\"found\":\"text\",\"value\":\"\\\"Bsic\\\"\",\"line\":5,\"column\":13,\"start\":63,\"end\":69}],\"dropped\":0}\n"

// One long line: the snippet shows the part around the problem.
const LONG: &[u8] = b"{\"auth\": {\"type\": \"Anonymous\"}, \"idle_seconds\": 1, \"padding_one\": \"aaaaaaaaaaaaaaaa\", \"port\": 70000, \"padding_two\": \"bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb\"}"

const LONG_SNIPPET: &[u8] = b" --> line.json:1:95 at port\n  |\n1 | ...dding_one\": \"aaaaaaaaaaaaaaaa\", \"port\": 70000, \"padding_two\": \"bbbbbbbbbbbbbbbbb...\n  |                                            ^^^^^ expected an integer from 0 to 65535, got 70000\n"

struct Capture {
  bytes: [u8; 2048],
  length: usize,
}

impl Writer for Capture {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> () ! WriterError ? &mut Writer {
    let mut index: usize = 0
    while index < value.length {
      if self.length < 2048 { self.bytes[self.length] = value[index] }
      self.length = self.length + 1
      index = index + 1
    }
    return ()
  }

  effect fn flush(self: &mut Self) -> () ! WriterError ? &mut Writer {
    return ()
  }
}

fn holds(capture: &Capture, expected: &[u8]) -> bool {
  if capture.length != expected.length { return false }
  let mut index: usize = 0
  while index < expected.length {
    if capture.bytes[index] != expected[index] { return false }
    index = index + 1
  }
  return true
}

effect fn problems(input: &[u8]) -> SchemaErrors ! OutOfMemoryError ? &mut Allocator {
  return match move run Effect.result(SchemaJson.decodeAll<Server>(input)) {
    Result<Server, SchemaErrors | OutOfMemoryError>.Failure {error} => match move error {
      SchemaErrors found => move found
      OutOfMemoryError {} => { fail OutOfMemoryError {} }
    }
    Result<Server, SchemaErrors | OutOfMemoryError>.Success {..} => SchemaErrors {errors: List<SchemaError>.make(), dropped: 0}
  }
}

effect fn written(errors: &SchemaErrors, input: &[u8], source: string, options: ReportOptions, expected: &[u8]) -> bool ! WriterError {
  let mut capture = Capture {bytes: [0; 2048], length: 0}
  run SchemaReport.write(errors, input, source, options) |> Effect.provideMut<Writer>(&mut capture)
  return holds(&capture, expected)
}

effect fn checks() -> i32 ! OutOfMemoryError | WriterError ? &mut Allocator {
  let found = run problems(INPUT)
  if List<SchemaError>.length(&found.errors) != 3 { return 1 }
  if !run written(&found, INPUT, "server.json", ReportOptions.snippet(), SNIPPET) { return 2 }
  if !run written(&found, INPUT, "server.json", ReportOptions.line(), LINES) { return 3 }
  if !run written(&found, INPUT, "server.json", ReportOptions.line().redacted(), REDACTED) { return 4 }
  if !run written(&found, INPUT, "server.json", ReportOptions.json(), JSON) { return 5 }
  let long = run problems(LONG)
  if !run written(&long, LONG, "line.json", ReportOptions.snippet(), LONG_SNIPPET) { return 6 }
  return 0
}

pub effect fn main() -> i32 ! OutOfMemoryError | WriterError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checks() |> Effect.provideMut<Allocator>(&mut allocator)
}
