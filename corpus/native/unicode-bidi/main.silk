import silk.text.bidi {
  BidiAnalysis,
  BidiParagraph,
  BidiRun,
  BidiWorkspace,
  ParagraphDirection,
  analyzeClasses,
  analyzeCodepoints,
  reorder
}
import silk.text.unicode_properties { BidiClass }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { Testing, AssertionError }
import silk.core.effect { Effect }

fn runAt(analysis: &BidiAnalysis, offset: usize) -> BidiRun {
  return analysis.runAt(offset)
    |> Option<BidiRun>.unwrapOr(
      BidiRun { start: 0, end: 0, level: 255, unwrappedLevel: 255, removed: false },
    )
}

fn paragraphAt(analysis: &BidiAnalysis, offset: usize) -> BidiParagraph {
  return analysis.paragraphAt(offset)
    |> Option<BidiParagraph>.unwrapOr(
      BidiParagraph { start: 0, end: 0, level: 255, hasStrong: false },
    )
}

effect fn sourceRangesAndX9AffinityCase() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut result = BidiAnalysis.make()

  // Alef, BN soft hyphen, Latin: both multibyte scalars retain exact ranges.
  run result.analyze("\u{5d0}\u{ad}a", ParagraphDirection.Ltr)
  run Testing.expect(runAt(&result, 0).level == 1 && runAt(&result, 4).level == 0, "scalar levels")
  run Testing.expect(
    runAt(&result, 2).removed && !runAt(&result, 4).removed,
    "BN is removed without removing bytes",
  )
  run Testing.expect(runAt(&result, 2).level == 1, "X9 inherits preceding resolved affinity")
  let runs = result.runs()
  run Testing.expect(runs.length == 3, "three runs")
  run Testing.expect(runs[0].start == 0 && runs[0].end == 2, "two-byte Hebrew range")
  run Testing.expect(runs[1].end == 4 && runs[2].end == 5, "two-byte BN range")
  run Testing.expect(result.runAt(5).isNone(), "no run past the end")
}

effect fn l1DoesNotDestroyShapingLevelsCase() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut result = BidiAnalysis.make()

  // RLE + Latin + space + PDF: the trailing suffix resets only unwrapped levels.
  run result.analyze("\u{202b}a \u{202c}", ParagraphDirection.Ltr)
  run Testing.expect(
    runAt(&result, 3).level == 2 && runAt(&result, 3).unwrappedLevel == 2,
    "Latin embedding",
  )
  run Testing.expect(
    runAt(&result, 4).level == 1 && runAt(&result, 4).unwrappedLevel == 0,
    "L1 preserves pre-reset space level",
  )
  run Testing.expect(
    runAt(&result, 0).removed && runAt(&result, 5).removed,
    "explicit controls retain coverage",
  )
  run Testing.expect(
    runAt(&result, 5).level == 1 && runAt(&result, 5).unwrappedLevel == 0,
    "PDF affinity and trailing reset",
  )
  let runs = result.runs()
  run Testing.expect(runs[runs.length - 1].end == 8, "removed suffix ends at the end of text")
}

effect fn paragraphDefaultsAndReuseCase() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut result = BidiAnalysis.make()
  run result.analyze("\u{5d0}\na", ParagraphDirection.Auto)
  run Testing.expect(
    paragraphAt(&result, 0).level == 1 && paragraphAt(&result, 0).hasStrong,
    "first paragraph summary",
  )
  run Testing.expect(result.paragraphs().length == 2, "all paragraph descriptors")
  run Testing.expect(
    result.paragraphs()[0].end == 3 && result.paragraphs()[1].start == 3,
    "separator belongs to preceding paragraph",
  )
  run Testing.expect(
    paragraphAt(&result, 3).level == 0,
    "second paragraph independent first strong",
  )
  run Testing.expect(runAt(&result, 3).level == 0, "second paragraph level")
  run Testing.expect(runAt(&result, 2).level == 1, "separator takes the paragraph level")
  run result.analyze("", ParagraphDirection.Rtl)
  run Testing.expect(
    result.paragraphs().length == 1 && result.paragraphs()[0].level == 1
      && !result.paragraphs()[0].hasStrong,
    "empty explicit RTL paragraph",
  )
  run Testing.expect(result.runs().length == 0, "reuse has no stale runs")
  run result.analyze("123", ParagraphDirection.Auto)
  run Testing.expect(
    paragraphAt(&result, 0).level == 0 && !paragraphAt(&result, 0).hasStrong,
    "auto defaults LTR without a strong scalar",
  )
  run Testing.expect(
    result.runs().length == 1 && result.runs()[0].level == 0,
    "European numbers in LTR stay at level 0",
  )
}

effect fn plainTextFastPathCase() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut result = BidiAnalysis.make()

  // Latin, a soft hyphen (BN), digits and CRLF: no RTL, so one run per kind.
  run result.analyze("ab\u{ad}c 12.\r\nd", ParagraphDirection.Auto)
  let runs = result.runs()
  run Testing.expect(runs.length == 5, "plain, removed, plain, then one run per paragraph")
  run Testing.expect(runs[1].removed && runs[1].start == 2 && runs[1].end == 4, "BN run")
  run Testing.expect(runs[2].end == 10 && runs[3].end == 11, "CR and LF end paragraphs")
  run Testing.expect(result.paragraphs().length == 3, "CR, LF and the rest")
  run Testing.expect(!result.paragraphs()[1].hasStrong, "LF paragraph has no strong")
  run Testing.expect(runs[4].level == 0 && runs[4].unwrappedLevel == 0, "last paragraph is LTR")
}

effect fn allWeakClassesAndCanonicalBracketsCase() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut workspace = BidiWorkspace.make()
  let weak = [
    BidiClass.AL,
    BidiClass.EN,
    BidiClass.ES,
    BidiClass.EN,
    BidiClass.CS,
    BidiClass.AN,
    BidiClass.ET,
    BidiClass.EN,
    BidiClass.NSM,
  ]
  let expected: [u8; 9] = [1, 2, 1, 2, 2, 2, 1, 2, 2]
  let base = run analyzeClasses(&weak, ParagraphDirection.Ltr, &mut workspace)
  run Testing.expect(base == 0, "explicit base")
  let mut i: usize = 0
  while i < expected.length {
    run Testing.expect(workspace.unwrappedLevel(i) == expected[i], "W1 through W7")
    i = i + 1
  }

  // Canonically equivalent opening/closing angle brackets, with an NSM after
  // the closing bracket. N0c inherits preceding R rather than following L.
  let scalars: [u32; 6] = [0x5d0, 0x2329, 0x5d1, 0x3009, 0x300, 0x61]
  let bracketBase = run analyzeCodepoints(&scalars, ParagraphDirection.Ltr, &mut workspace)
  run Testing.expect(bracketBase == 0, "bracket paragraph base")
  run Testing.expect(
    workspace.level(1) == 1 && workspace.level(3) == 1 && workspace.level(4) == 1,
    "N0 canonical pair and following original NSM",
  )
}

effect fn isolateOverflowAndFirstStrongCase() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut workspace = BidiWorkspace.make()
  let mut classes = List<BidiClass>.make()
  let mut i: usize = 0
  while i < 130 {
    run classes.append(BidiClass.RLI)
    i = i + 1
  }
  run classes.append(BidiClass.L)
  i = 0
  while i < 130 {
    run classes.append(BidiClass.PDI)
    i = i + 1
  }
  let base = run analyzeClasses(
    List<BidiClass>.asSlice(&classes),
    ParagraphDirection.Auto,
    &mut workspace,
  )
  run Testing.expect(base == 0, "P2 ignores isolated strong characters")
  run Testing.expect(
    workspace.level(130) == 126,
    "overflow isolates preserve maximum valid embedding",
  )
  run Testing.expect(
    workspace.unwrappedLevel(260) == 0,
    "matching PDI returns to paragraph and L1 resets",
  )
  let fsi = [
    BidiClass.R,
    BidiClass.FSI,
    BidiClass.LRI,
    BidiClass.R,
    BidiClass.PDI,
    BidiClass.EN,
    BidiClass.PDI,
  ]
  let fsiBase = run analyzeClasses(&fsi, ParagraphDirection.Auto, &mut workspace)
  run Testing.expect(
    fsiBase == 1 && workspace.level(5) == 2,
    "FSI defaults LTR when only nested strong text exists",
  )
}

effect fn l2AppendsVisualPermutationCase() -> ()
  ! AssertionError<'static> | OutOfMemoryError
  ? &mut Allocator {
  let mut order = List<usize>.make()
  run order.append(99)
  let levels: [u8; 5] = [0, 1, 2, 2, 1]
  run reorder(&levels, &mut order)
  let expected: [usize; 6] = [99, 0, 4, 2, 3, 1]
  let mut i: usize = 0
  while i < expected.length {
    run Testing.expect(
      order.get(i) == expected[i],
      "L2 preserves caller prefix and nested even run order",
    )
    i = i + 1
  }
}

effect fn sourceRangesAndX9Affinity() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run sourceRangesAndX9AffinityCase() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn l1DoesNotDestroyShapingLevels() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run l1DoesNotDestroyShapingLevelsCase() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn paragraphDefaultsAndReuse() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run paragraphDefaultsAndReuseCase() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn allWeakClassesAndCanonicalBrackets() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run allWeakClassesAndCanonicalBracketsCase() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn isolateOverflowAndFirstStrong() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run isolateOverflowAndFirstStrongCase() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn l2AppendsVisualPermutation() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run l2AppendsVisualPermutationCase() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn plainTextFastPath() -> ()
  ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run plainTextFastPathCase() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Each check above runs in order; the first failed assertion ends the program with its own code.
effect fn all() -> i32
  ! AssertionError<'static> | OutOfMemoryError {
  run sourceRangesAndX9Affinity()
  run l1DoesNotDestroyShapingLevels()
  run paragraphDefaultsAndReuse()
  run allWeakClassesAndCanonicalBrackets()
  run isolateOverflowAndFirstStrong()
  run l2AppendsVisualPermutation()
  run plainTextFastPath()
  return 42
}

effect fn assertionFailed(error: AssertionError<'static>) -> i32 {
  return 1
}

effect fn outOfMemory(error: OutOfMemoryError) -> i32 {
  return 2
}

pub fn main() -> i32 {
  return run Effect.catch(Effect.catch(all(), assertionFailed), outOfMemory)
}
