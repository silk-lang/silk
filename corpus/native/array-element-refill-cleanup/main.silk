import silk.core.ownership { Drop }
unsafe extern "C" fn silk_record_event(value: i32) -> ()
unsafe extern "C" fn silk_finish_events() -> i32
struct Recorder { value: i32 }
impl Drop for Recorder {
  fn drop(self: &mut Recorder) -> () { unsafe { silk_record_event(self.value) } return () }
}
fn straight() -> () {
  let mut items = [Recorder { value: 1 }, Recorder { value: 2 }, Recorder { value: 3 }]
  let first = move items[0]
  items[0] = Recorder { value: 4 }
  items[2] = Recorder { value: 5 }
  drop first
  items[0] = Recorder { value: 6 }
  return ()
}
fn conditional(flag: bool) -> () {
  let mut items = [Recorder { value: 7 }, Recorder { value: 8 }]
  if flag {
    let taken = move items[1]
    items[1] = Recorder { value: taken.value + 10 }
  }
  items[0] = Recorder { value: 9 }
  return ()
}
pub fn main() -> i32 {
  straight()
  unsafe { silk_record_event(90) }
  conditional(true)
  unsafe { silk_record_event(91) }
  conditional(false)
  unsafe { return silk_finish_events() }
}