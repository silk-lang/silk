import silk.core.effect { Effect }
import silk.text.format { Format }
import silk.text.string { String }
import silk.num.usize
import silk.io.writer { Writer, WriterError }

struct Capture { bytes: [u8; 32], length: usize }

effect fn writeAll(self: &mut Capture, bytes: &[u8]) -> () {
  let mut offset = usize.ZERO
  while offset < bytes.length && self.length < 32 {
    self.bytes[self.length] = bytes[offset]
    self.length = self.length + usize.ONE
    offset = offset + usize.ONE
  }
  return ()
}

effect fn flush(self: &mut Capture) -> () { return () }

impl Writer for Capture {
  writeAll: Capture.writeAll
  flush: Capture.flush
}

// `bool` and `char` display through `Format.format` like the other primitives: `true`/`false`
// and the character's UTF-8 encoding.
effect fn render() -> i32 ! WriterError {
  let mut capture = Capture { bytes: [0; 32], length: usize.ZERO }
  let letter = 'é'
  run Format.format("{yes}|{no}|{letter}|{plain}", &.{ yes: true, no: false, letter: letter, plain: 'x' })
    |> Effect.provideMut<Writer>(&mut capture)
  let expected = "true|false|\u{e9}|x"
  let wanted = String.utf8Bytes(expected)
  if capture.length != wanted.length { return 1 }
  let mut at = usize.ZERO
  while at < wanted.length {
    if capture.bytes[at] != wanted[at] { return 2 }
    at = at + usize.ONE
  }
  return 42
}

effect fn recover(error: WriterError) -> i32 { return 3 }

pub fn main() -> i32 {
  return run Effect.catchAll(render(), recover)
}
