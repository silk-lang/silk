import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.schema.issue { IssueReason, SchemaError, SchemaErrors }
import silk.schema.schema { Schema, Spec }
import silk.schema.toml { SchemaToml }
import silk.text.string { String }

struct Capture {
  bytes: [u8; 4096],
  length: usize
}

impl Writer for Capture {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> ()
    ! WriterError
    ? &mut Writer {
    if self.length + value.length > 4096 {
      fail Writer.failure()
    }
    Slice.copyInto<u8>(&mut self.bytes, self.length, value)
    self.length = self.length + value.length
    return ()
  }

  effect fn flush(self: &mut Self) -> ()
    ! WriterError
    ? &mut Writer {
    return ()
  }
}

struct Package {
  pub name: String,
  pub debug: bool
}

impl Schema for Package {
  static fn spec() -> Spec<Package> {
    return Spec<Package>.of() |> Spec<Package>.strict()
  }
}

struct Request {
  pub name: String,
  pub packages: List<Package>,
  pub count: u64,
  pub optional: Option<String>
}

impl Schema for Request {
  static fn spec() -> Spec<Request> {
    return Spec<Request>.of() |> Spec<Request>.strict()
  }
}

effect fn rejected(bytes: &[u8], path: string, reason: IssueReason) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  return match move run Effect.result(SchemaToml.decode<Request>(bytes)) {
    Result<Request, SchemaError | OutOfMemoryError>.Success { .. } => false
    Result<Request, SchemaError | OutOfMemoryError>.Failure { error } => match move error {
      SchemaError { path: found, issue, .. } => found.matchesText(path) && issue.reason == reason
      OutOfMemoryError {} => {
        fail OutOfMemoryError {}
      }
    }
  }
}

effect fn checks() -> i32
  ! SchemaError | WriterError | OutOfMemoryError
  ? &mut Allocator {
  let request = run SchemaToml.decode<Request>(
    b"name = 'editor'\ncount = 0xffff_ffff_ffff_ffff\n[[packages]]\nname = 'root'\ndebug = true\n[[packages]]\nname = 'lib'\ndebug = false\n",
  )
  if request.name.view() != "editor" || request.optional.isSome()
    || request.count != 18446744073709551615 {
    return 1
  }
  if request.packages.length() != 2 || request.packages.asSlice()[1].name.view() != "lib" {
    return 2
  }
  let mut capture = Capture { bytes: [0; 4096], length: 0 }
  run SchemaToml.encode<Request>(&request) |> Effect.provideMut<Writer>(&mut capture)
  let again = run SchemaToml.decode<Request>(Slice.view<u8>(&capture.bytes, 0, capture.length))
  if again.packages.length() != 2 || again.count != request.count
    || again.packages.asSlice()[1].debug {
    return 3
  }
  if !run rejected(b"name = 1\ncount = 1\npackages = []", "name", IssueReason.InvalidType) {
    return 4
  }
  if !run rejected(b"name = 'x'\ncount = -1\npackages = []", "count", IssueReason.InvalidValue) {
    return 5
  }
  if !run rejected(
    b"name = 'x'\ncount = 18446744073709551616\npackages = []",
    "count",
    IssueReason.InvalidValue,
  ) {
    return 6
  }
  if !run rejected(
    b"name = 'x'\ncount = 1\npackages = [{name = 'p', debug = 1}]",
    "packages[0].debug",
    IssueReason.InvalidType,
  ) {
    return 7
  }
  if !run rejected(
    b"name = 'x'\ncount = 1\npackages = []\nextra = 1",
    "",
    IssueReason.UnexpectedKey,
  ) {
    return 8
  }
  if !run rejected(b"name = 'x'\npackages = []", "count", IssueReason.MissingKey) {
    return 9
  }
  if !run rejected(b"name = 'x'\nname = 'y'", "", IssueReason.InvalidSyntax) {
    return 10
  }
  let errors = match move run Effect.result(
    SchemaToml.decodeAll<Request>(
      b"name = false\ncount = -1\npackages = [{name = 3, debug = true}, {name = 'ok', debug = 'bad'}]",
    ),
  ) {
    Result<Request, SchemaErrors | OutOfMemoryError>.Success { .. } => 0
    Result<Request, SchemaErrors | OutOfMemoryError>.Failure { error } => match move error {
      SchemaErrors { errors, .. } => errors.length()
      OutOfMemoryError {} => {
        fail OutOfMemoryError {}
      }
    }
  }
  if errors != 4 {
    return 11
  }
  return 0
}

pub effect fn main() -> i32
  ! SchemaError | WriterError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checks() |> Effect.provideMut<Allocator>(&mut allocator)
}
