// A struct that borrows declares the lifetime and its field writes it. `impl<'a> Row<'a>`
// covers rows of every lifetime; `impl Row<'static>` adds members only for program-long rows.
import silk.text.string { String }
import silk.num.usize

struct Row<'a> {
  title: string<'a>,
  done: bool,
}

impl<'a> Row<'a> {
  fn make(title: string<'a>) -> Row<'a> { return Row { title: title, done: false } }
  fn width(self: &Self) -> usize { return String.byteLength(self.title) }
  fn finish(self: &mut Self) -> () { self.done = true }
}

impl Row<'static> {
  fn inbox() -> Row<'static> { return Row<'static>.make("inbox") }
  fn label(self: &Self) -> string<'static> { return self.title }
}

pub fn main() -> i32 {
  let mut row = Row.make("write the silk book")
  row.finish()
  if !row.done { return 1 }
  let inbox = Row<'static>.inbox()
  return usize.toI32(row.width() + String.byteLength(inbox.label())) + 18
}
