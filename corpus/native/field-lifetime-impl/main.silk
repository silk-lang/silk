// A struct that borrows declares the lifetime and its field writes it. `impl<'a> Row<'a>`
// covers rows of every lifetime; `impl Row<'static>` adds members only for program-long rows,
// and `impl<T> Tagged<'static, T>` does the same for every payload type.
import silk.text.string { String }
import silk.num.usize

struct Row<'a> {
  title: string<'a>,
  done: bool,
}

impl<'a> Row<'a> {
  fn make(title: string<'a>) -> Row<'a> { return Row { title: title, done: false } }
  fn width(self: &Self) -> usize { return String.byteLength(self.title) }
  fn finish(self: &mut Self) -> () { self.done = true }
}

impl Row<'static> {
  fn inbox() -> Row<'static> { return Row<'static>.make("inbox") }
  fn label(self: &Self) -> string<'static> { return self.title }
}

struct Tagged<'a, T> {
  label: string<'a>,
  payload: T,
}

impl<T> Tagged<'static, T> {
  fn make(label: string<'static>, payload: T) -> Self { return Tagged<'static, T> { label: label, payload: move payload } }
  fn title(self: &Self) -> string<'static> { return self.label }
  fn held(self: &Self) -> &T { return &self.payload }
}

pub fn main() -> i32 {
  let mut row = Row.make("write the silk book")
  row.finish()
  if !row.done { return 1 }
  let inbox = Row<'static>.inbox()
  let tagged = Tagged { label: "two", payload: 7 }
  let made = Tagged<'static, i32>.make("four", 4)
  let tags = String.byteLength(tagged.title()) + String.byteLength(made.title())
  return usize.toI32(row.width() + String.byteLength(inbox.label()) + tags) + tagged.held().* + made.held().*
}
