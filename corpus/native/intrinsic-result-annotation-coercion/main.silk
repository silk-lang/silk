// An intrinsic result meets a binding annotation, an argument and a return with the conversions any
// other value of its type has: `?*mut T` weakens to `?*const T`.
fn isNull(pointer: ?*const i32) -> bool { return Intrinsic.pointerIsNull<?*const i32>(pointer) }
fn none() -> ?*const i32 { return Intrinsic.pointerNull<i32>() }
pub fn main() -> i32 {
  let p: ?*const i32 = Intrinsic.pointerNull<i32>()
  if isNull(p) && isNull(Intrinsic.pointerNull<i32>()) && isNull(none()) { return 1 }
  return 0
}
