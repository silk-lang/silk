import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.equal { Equal }
import silk.num.f32
import silk.num.f64
import silk.collections.hash { Hash, HashKey }
import silk.collections.hash_map { HashMap }
import silk.collections.hash_set { HashSet }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.order { Order, Ordering }
import silk.num.usize

fn same<T: Equal>(left: &T, right: &T) -> bool {
  return left == right
}

fn before<T: Order>(left: &T, right: &T) -> bool {
  return left < right
}

effect fn strings() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut words = List<string>.make()
  let w0 = run List<string>.append(&mut words, "pear") |> Effect.provideMut(&mut allocator)
  let w1 = run List<string>.append(&mut words, "apple") |> Effect.provideMut(&mut allocator)
  let w2 = run List<string>.append(&mut words, "") |> Effect.provideMut(&mut allocator)
  let w3 = run List<string>.append(&mut words, "épée") |> Effect.provideMut(&mut allocator)
  let w4 = run List<string>.append(&mut words, "app") |> Effect.provideMut(&mut allocator)
  let w5 = run List<string>.append(&mut words, "Zebra") |> Effect.provideMut(&mut allocator)
  let sorted = run List<string>.sort(&mut words) |> Effect.provideMut(&mut allocator)
  let view = List<string>.asSlice(&words)
  if view[0] != "" || view[1] != "Zebra" || view[2] != "app" || view[3] != "apple" { return 10 }
  if view[4] != "pear" || view[5] != "épée" { return 11 }
  let found = List<string>.binarySearch(&words, "apple") |> Option<usize>.unwrapOr(99)
  if found != 3 { return 12 }
  if !before<string>(&"a", &"b") || before<string>(&"b", &"b") || !same<string>(&"b", &"b") {
    return 13
  }
  if Order.compare(&"abc", &"abd") != Ordering.Less || Order.compare(&"ab", &"ab") != Ordering.Equal {
    return 14
  }

  let mut counts = HashMap<string, i32>.make(Hash.seed(7))
  let text = List<string>.asSlice(&words)
  let mut index = usize.ZERO
  while index < text.length {
    let previous = run HashMap<string, i32>.insert(&mut counts, text[index], 1)
      |> Effect.provideMut(&mut allocator)
    index = index + usize.ONE
  }
  let again = run HashMap<string, i32>.insert(&mut counts, "pear", 2) |> Effect.provideMut(&mut allocator)
  if Option<i32>.isNone(&again) { return 15 }
  if (HashMap<string, i32>.get(&counts, "pear") |> Option<i32>.unwrapOr(0)) != 2 { return 16 }
  if (HashMap<string, i32>.get(&counts, "épée") |> Option<i32>.unwrapOr(0)) != 1 { return 17 }
  if HashMap<string, i32>.contains(&counts, "pea") { return 18 }
  if HashMap<string, i32>.length(&counts) != 6 { return 19 }
  let seed = Hash.seed(3)
  if HashKey.hash(&"a long text over eight bytes", &seed) == HashKey.hash(&"a long text over eight byte", &seed) {
    return 20
  }
  if HashKey.hash(&"", &seed) == HashKey.hash(&"\0", &seed) { return 21 }
  return 0
}

effect fn integers() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut signed = HashSet<i64>.make(Hash.seed(11))
  let s0 = run HashSet<i64>.insert(&mut signed, -1) |> Effect.provideMut(&mut allocator)
  let s1 = run HashSet<i64>.insert(&mut signed, 1) |> Effect.provideMut(&mut allocator)
  let s2 = run HashSet<i64>.insert(&mut signed, -9223372036854775807 - 1) |> Effect.provideMut(&mut allocator)
  let s3 = run HashSet<i64>.insert(&mut signed, -1) |> Effect.provideMut(&mut allocator)
  if HashSet<i64>.length(&signed) != 3 { return 30 }
  if !HashSet<i64>.contains(&signed, -9223372036854775807 - 1) || HashSet<i64>.contains(&signed, 0) {
    return 31
  }
  let mut small = HashMap<i8, u8>.make(Hash.seed(5))
  let m0 = run HashMap<i8, u8>.insert(&mut small, -128, 1) |> Effect.provideMut(&mut allocator)
  let m1 = run HashMap<i8, u8>.insert(&mut small, 127, 2) |> Effect.provideMut(&mut allocator)
  if (HashMap<i8, u8>.get(&small, -128) |> Option<u8>.unwrapOr(0)) != 1 { return 32 }
  let seed = Hash.seed(0)
  let minusOne: i32 = -1
  let one: i32 = 1
  let narrowSeven: u16 = 7
  let wideSeven: u64 = 7
  let sizeSeven: usize = 7
  if HashKey.hash(&minusOne, &seed) == HashKey.hash(&one, &seed) { return 33 }
  if HashKey.hash(&narrowSeven, &seed) != HashKey.hash(&wideSeven, &seed) { return 34 }
  if HashKey.hash(&sizeSeven, &seed) != Hash.mix(&seed, 7) { return 35 }
  return 0
}

effect fn floats() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let nan = f64.fromBits(9221120237041090560)
  let negativeNan = f64.fromBits(18444492273895866368)
  let mut values = List<f64>.make()
  let v0 = run List<f64>.append(&mut values, nan) |> Effect.provideMut(&mut allocator)
  let v1 = run List<f64>.append(&mut values, 0.0) |> Effect.provideMut(&mut allocator)
  let v2 = run List<f64>.append(&mut values, f64.INFINITY) |> Effect.provideMut(&mut allocator)
  let v3 = run List<f64>.append(&mut values, -0.0) |> Effect.provideMut(&mut allocator)
  let v4 = run List<f64>.append(&mut values, negativeNan) |> Effect.provideMut(&mut allocator)
  let v5 = run List<f64>.append(&mut values, -2.5) |> Effect.provideMut(&mut allocator)
  let v6 = run List<f64>.append(&mut values, 1.5) |> Effect.provideMut(&mut allocator)
  let sorted = run List<f64>.sort(&mut values) |> Effect.provideMut(&mut allocator)
  let view = List<f64>.asSlice(&values)
  if f64.toBits(view[0]) != f64.toBits(negativeNan) { return 40 }
  if view[1] != -2.5 || f64.toBits(view[2]) != f64.toBits(-0.0) || f64.toBits(view[3]) != 0 { return 41 }
  if view[4] != 1.5 || view[5] != f64.INFINITY || f64.toBits(view[6]) != f64.toBits(nan) { return 42 }
  if !before<f64>(&-0.0, &0.0) || before<f64>(&nan, &nan) { return 43 }
  if Order.compare(&nan, &nan) != Ordering.Equal { return 44 }

  let mut narrow = List<f32>.make()
  let n0 = run List<f32>.append(&mut narrow, 2.0) |> Effect.provideMut(&mut allocator)
  let n1 = run List<f32>.append(&mut narrow, f32.fromBits(2143289344)) |> Effect.provideMut(&mut allocator)
  let n2 = run List<f32>.append(&mut narrow, -1.0) |> Effect.provideMut(&mut allocator)
  let narrowed = run List<f32>.sort(&mut narrow) |> Effect.provideMut(&mut allocator)
  let small = List<f32>.asSlice(&narrow)
  if small[0] != -1.0 || small[1] != 2.0 || !f32.isNaN(small[2]) { return 45 }
  return 0
}

fn options() -> i32 {
  let present = Option<i32>.some(4)
  let absent = Option<i32>.none()
  if !Option<i32>.isSome(&present) || Option<i32>.isNone(&present) { return 50 }
  if Option<i32>.isSome(&absent) || !Option<i32>.isNone(&absent) { return 51 }
  if (move present |> Option<i32>.unwrapOr(0)) != 4 { return 52 }
  return 0
}

pub effect fn main() -> i32 ! OutOfMemoryError {
  let text = run strings()
  if text != 0 { return text }
  let whole = run integers()
  if whole != 0 { return whole }
  let real = run floats()
  if real != 0 { return real }
  return options()
}
