static fn shapeOf(pattern: string<'static>) -> RegexShape {
  return RegexShape.of(pattern)
}

static fn validOf(pattern: string<'static>) -> bool {
  return RegexShape.of(pattern).valid
}

static fn limitOf(pattern: string<'static>) -> bool {
  return RegexShape.of(pattern).limit
}

static fn messageOf(pattern: string<'static>) -> string<'static> {
  return RegexShape.of(pattern).message
}

static fn offsetOf(pattern: string<'static>) -> usize {
  return RegexShape.of(pattern).offset
}

static fn groupsOf(pattern: string<'static>) -> Intrinsic.StaticSequence<RegexGroup> {
  return RegexShape.of(pattern).groups
}

static fn countOf(pattern: string<'static>) -> usize {
  return StaticSequence.length<RegexGroup>(RegexShape.of(pattern).groups) + 1
}

// Whether both readings of pattern agree.
effect fn agree(static pattern: string<'static>) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let result = run Effect.result(Regex.compile(pattern))
  match move result {
    Result<Pattern, RegexError | OutOfMemoryError>.Success { value: compiled } => {
      if !validOf(pattern) || Regex.groupCount(&compiled) != countOf(pattern) {
        return false
      }
      static for group in groupsOf(pattern) {
        static if group.name != "" {
          match Regex.groupIndex(&compiled, group.name) {
            Option<usize>.Some { value } => {
              if value > group.number {
                return false
              }
            }
            Option<usize>.None => {
              return false
            }
          }
        }
      }
      return true
    }
    Result<Pattern, RegexError | OutOfMemoryError>.Failure { error } => match move error {
      RegexError problem => {
        if validOf(pattern) {
          return false
        }
        if limitOf(pattern) {
          return problem.reason == RegexReason.PatternLimit && problem.message == messageOf(pattern)
        }
        return problem.reason == RegexReason.Syntax && problem.message == messageOf(pattern)
          && problem.offset == offsetOf(pattern)
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// The groups a match can leave unset, as RegexShape.of reports them.
static fn optionalNames(pattern: string<'static>) -> string<'static> {
  let groups = RegexShape.of(pattern).groups
  let mut names = ""
  let mut index: usize = 0
  while index < StaticSequence.length<RegexGroup>(groups) {
    let group = StaticSequence.at<RegexGroup>(groups, index)
    if group.optional {
      names = StaticText.concat(StaticText.concat(names, group.name), " ")
    }
    index = index + 1
  }
  return names
}

effect fn checks() -> i32
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut index: i32 = 0
  static for pattern in cases() {
    index = index + 1
    if !run agree(pattern) {
      return index
    }
  }
  if optionalNames("(?<a>x)(?<b>y)?(?<c>z)*(?<d>w)+(?<e>v){0,3}(?<f>u){2}") != "b c e " {
    return 201
  }
  if optionalNames("(?<a>x)|(?<b>y)") != "a b " {
    return 202
  }
  if optionalNames("(?<a>(?<b>x)|y)") != "b " {
    return 203
  }
  if optionalNames("(?!(?<a>x))(?=(?<b>y))(?<!(?<c>z))(?<=(?<d>w))") != "a c " {
    return 204
  }
  if optionalNames("(?:(?<a>x)(?<b>y))?(?<c>(?<d>z))") != "a b " {
    return 205
  }
  if optionalNames("(?:(?<a>x)|(?<b>y))+") != "a b " {
    return 206
  }
  if optionalNames("(?<a>x(?<b>y)?)") != "b " {
    return 207
  }
  return 0
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  return 250
}

pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(checks(), failed) |> Effect.provideMut<Allocator>(&mut allocator)
}
