import silk.core.effect { Effect }

// `Intrinsic.catchFailure` in generic code, where the caught failure has a `'static` lifetime and
// the residual failures are a type parameter: each operand relates to its own part, and the
// composition stands for its Effect contract when passed on.
struct Expected<'m> { message: string<'m> }
struct Missing {}

effect fn expected(error: Expected<'static>) -> i32 { return 2 }

effect<'env> fn general<E: 'env, 'env>(error: E) -> i32 {
  drop error
  return 3
}

effect<'env> fn attempted<E: 'env, 'env>(value: Effect<'env; i32 ! E>, check: bool) -> i32 ! E | Expected<'static> {
  let found = run value
  if check { fail Expected<'static> { message: "checked" } }
  return found
}

fn outcome<'env, E>(value: Effect<'env; i32 ! E>, check: bool) -> i32 {
  let caught = Intrinsic.catchFailure<Expected<'static>>(attempted(move value, check), expected)
  return run Effect.catchAll(move caught, general)
}

effect fn found() -> i32 ! Missing { return 1 }
effect fn missing() -> i32 ! Missing { fail Missing {} }

pub fn main() -> i32 {
  return outcome(found(), false) * 100 + outcome(found(), true) * 10 + outcome(missing(), false)
}
