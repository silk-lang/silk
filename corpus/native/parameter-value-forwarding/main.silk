import silk.mem.pointer {Pointer}

// Ordinary scalar incoming values can be reused while their real debug slots remain present.
fn flag(value: bool) -> bool { if value { return value } return !(!value) }
fn narrow(value: i8) -> i8 { return value + 1 }
fn floating(value: f64) -> f64 { return value + 0.25 }
fn ownWrite(mut value: i32) -> i32 { value = value + 1 return value }
fn set(value: &mut i32) -> () { value.* = 42 }
fn exposedOwnSlot(mut value: i32) -> i32 { set(&mut value) return value }

// Mutating the pointee leaves the pointer parameter's own spill slot unchanged.
fn pointeeWrite(value: &mut i32) -> i32 {
  let before = value.*
  set(&mut value.*)
  return before + value.*
}
fn redirect(slot: &mut *const i32, replacement: *const i32) -> () { slot.* = replacement }
fn exposedPointer(mut value: *const i32, replacement: *const i32) -> i32 {
  redirect(&mut value, replacement)
  unsafe { return Pointer.read(value) }
}
fn reboundPointer(mut value: *const i32, replacement: *const i32) -> i32 {
  value = replacement
  unsafe { return Pointer.read(value) }
}
struct ReferenceSlot<'a> { value: &'a i32 }
// Only the first dereference can use the incoming argument. The pointer stored in the
// pointee changes between the two reads, so caching that later load would be wrong.
fn secondDereference<'a>(slot: &mut ReferenceSlot<'a>, replacement: &'a i32) -> i32 {
  let before = slot.value.*
  slot.value = replacement
  return before + slot.value.*
}
struct Pair { left: i32, right: i32 }
fn aggregate(mut value: Pair) -> i32 { value.right = value.right + 1 return value.left + value.right }

pub fn main() -> i32 {
  if !flag(true) || flag(false) { return 1 }
  if narrow(-6) != -5 { return 2 }
  if floating(1.0) != 1.25 { return 3 }
  if ownWrite(41) != 42 { return 4 }
  if exposedOwnSlot(1) != 42 { return 5 }
  let mut pointee = 1
  if pointeeWrite(&mut pointee) != 43 || pointee != 42 { return 6 }
  let first = 1
  let second = 42
  if exposedPointer(Pointer.fromRef(&first), Pointer.fromRef(&second)) != 42 { return 7 }
  if reboundPointer(Pointer.fromRef(&first), Pointer.fromRef(&second)) != 42 { return 8 }
  let mut pointer = ReferenceSlot {value: &first}
  if secondDereference(&mut pointer, &second) != 43 || pointer.value.* != 42 { return 9 }
  if aggregate(Pair {left: 19, right: 22}) != 42 { return 10 }
  return 42
}
