import silk.num.usize
import silk.text.string { String }

struct Leaf<'a> {
  name: string<'a>,
}

struct Holder<'a> {
  items: &'a [Leaf<'a>],
}

struct Names<'a> {
  names: &'a [string<'a>],
}

struct Pinned<'a> {
  leaf: &'a Leaf<'a>,
}

struct Numbers<'a> {
  values: &'a [i32],
}

const PRIMES: [i32; 3] = [2, 3, 5]

// Every lifetime named, as a command tree would write it. The first argument fixes `'a` to
// 'static before the second offers a local loan of `Subcommand<'static>` values.
struct Subcommand<'a> {
  name: string<'a>,
  aliases: &'a [string<'a>],
}

struct Command<'a> {
  name: string<'a>,
  subcommands: &'a [Subcommand<'a>],
}

fn leaf(name: string<'static>) -> Subcommand<'static> {
  return Subcommand { name: name, aliases: &[] }
}

fn tree<'a>(name: string<'a>, subcommands: &'a [Subcommand<'a>]) -> Command<'a> {
  return Command { name: name, subcommands: subcommands }
}

// A literal's lifetime comes from the outer loan of its field even when the elements it views hold
// longer regions: `&list` is a local loan of `Leaf<'static>` values.
fn holders() -> usize {
  let list = [Leaf { name: "a" }, Leaf { name: "bc" }]
  let held = Holder { items: &list }
  let words = ["x", "yz", "w"]
  let names = Names { names: &words }
  let single = Leaf { name: "pin" }
  let pinned = Pinned { leaf: &single }
  return held.items.length + String.byteLength(held.items[1].name) + names.names.length + String.byteLength(pinned.leaf.name)
}

// A borrowed parameter's region meets the local loan the same way.
fn local<'b>(name: string<'b>) -> usize {
  let list = [Leaf { name: name }]
  let held = Holder { items: &list }
  return String.byteLength(held.items[0].name)
}

// `&[]` and a shared borrow of a constant are valid for 'static in a field, as they are anywhere.
fn empty() -> Numbers<'static> {
  return Numbers { values: &[] }
}

fn primes() -> Numbers<'static> {
  return Numbers { values: &PRIMES }
}

// `&[]` for a field or parameter whose element holds the literal's own lifetime fills it with 'static.
fn group<'a>(leaves: &'a [Leaf<'a>]) -> Holder<'a> {
  return Holder { items: leaves }
}

fn empties() -> usize {
  let held = Holder { items: &[] }
  let grouped = [group(&[]), group(&[])]
  return held.items.length + grouped[1].items.length
}

pub fn main() -> i32 {
  let add = leaf("add")
  let sub = leaf("sub")
  let subcommands = [move add, move sub]
  let root = tree("calc", &subcommands)
  let commands = root.subcommands.length + root.subcommands[1].aliases.length + String.byteLength(root.name)
  // 2 + 0 + 4 = 6 commands, 2 + 2 + 3 + 3 = 10 holders, 4 local and 0 + 3 numbers make 23.
  let numbers = empty().values.length + primes().values.length
  return usize.toI32(commands + holders() + local("four") + numbers + empties()) + 19
}
