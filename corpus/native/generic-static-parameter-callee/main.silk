import silk.core.effect { Effect }
import silk.text.format { Format }
import silk.io.logger { LogError, Logger }

// A generic body may call a function with `static` parameters: each reached instance evaluates them.
fn width(static text: string<'static>) -> usize { return 2 }

fn kept<A>(value: A) -> A {
  let measured = width("ab")
  return move value
}

effect fn noisy<A>(value: A) -> A ! LogError ? &mut Logger {
  run Effect.log("v{}\n", &(1,))
  return move value
}

effect fn program() -> i32 ! LogError {
  let mut logger = Logger.inMemoryProvider()
  let first = kept<i32>(40)
  let second = run noisy<i32>(first + 2) |> Effect.provideMut(&mut logger)
  if Logger.length(&logger) != 1 { return 1 }
  return second
}

effect fn fallback(error: LogError) -> i32 { return 3 }

pub effect fn main() -> i32 {
  return run Effect.catchAll(program(), fallback)
}
