import silk.concurrency.sync { Arc }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.io.logger { InMemoryLogger, Logger }

// A generic body may call a function with `static` parameters: each reached instance evaluates them.
fn width(static text: string<'static>) -> usize { return 2 }

fn kept<A>(value: A) -> A {
  drop width("ab")
  return move value
}

effect fn noisy<A>(value: A) -> A {
  run Effect.log("v{}\n", &.(1))
  return move value
}

effect fn program() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let loggerProvider = run Logger.inMemoryProvider() |> Effect.provideMut<Allocator>(&mut allocator)
  let logger = run Arc<InMemoryLogger>.make(move loggerProvider) |> Effect.provideMut<Allocator>(&mut allocator)
  let first = kept<i32>(40)
  let second = run noisy<i32>(first + 2) |> Effect.provideAmbient<Logger>(&logger)
  if Logger.length(logger.get()) != 1 { return 1 }
  return second
}

effect fn fallback(error: OutOfMemoryError) -> i32 { return 3 }

pub effect fn main() -> i32 {
  return run Effect.catchAll(program(), fallback)
}
