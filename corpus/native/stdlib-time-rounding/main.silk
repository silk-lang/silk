}

struct Capture {
  bytes: [u8; 160],
  length: usize,
}

impl Writer for Capture {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> ()
    ! WriterError
    ? &mut Writer {
    let mut index: usize = 0
    while index < value.length {
      self.bytes[self.length] = value[index]
      self.length = self.length + 1
      index = index + 1
    }
    return ()
  }

  effect fn flush(self: &mut Self) -> ()
    ! WriterError
    ? &mut Writer {
    return ()
  }
}

fn holds(capture: &Capture, expected: string) -> bool {
  let bytes = String.utf8Bytes(expected)
  if capture.length != bytes.length {
    return false
  }
  let mut index: usize = 0
  while index < bytes.length {
    if capture.bytes[index] != bytes[index] {
      return false
    }
    index = index + 1
  }
  return true
}

fn fieldAt(line: string, wanted: usize) -> string {
  let bytes = String.utf8Bytes(line)
  let mut start: usize = 0
  let mut index: usize = 0
  let mut at: usize = 0
  while at <= bytes.length {
    if at == bytes.length || bytes[at] == 9 {
      if index == wanted {
        return String.slice(line, start, at - start)
      }
      index = index + 1
      start = at + 1
    }
    at = at + 1
  }
  return ""
}

fn number(text: string) -> i64 {
  let bytes = String.utf8Bytes(text)
  let mut value: i64 = 0
  let mut at: usize = 0
  let negative = bytes.length > 0 && bytes[0] == 45
  if negative {
    at = 1
  }
  // The digits are taken away, so that the lowest `i64` reads without an overflow.
  while at < bytes.length {
    value = value * 10 - u8.toI64(bytes[at] - 48)
    at = at + 1
  }
  if negative {
    return value
  }
  return -value
}

fn step(count: string, unit: string) -> TimeIncrement {
  let mut of = TimeUnit.Nanosecond
  if unit == "d" {
    of = TimeUnit.Day
  } else if unit == "h" {
    of = TimeUnit.Hour
  } else if unit == "m" {
    of = TimeUnit.Minute
  } else if unit == "s" {
    of = TimeUnit.Second
  } else if unit == "ms" {
    of = TimeUnit.Millisecond
  } else if unit == "us" {
    of = TimeUnit.Microsecond
  }
  return TimeIncrement.of(i64.toU32(number(count)), of)
}

fn mode(text: string) -> RoundingMode {
  if text == "ceil" {
    return RoundingMode.Ceil
  }
  if text == "floor" {
    return RoundingMode.Floor
  }
  if text == "expand" {
    return RoundingMode.Expand
  }
  if text == "trunc" {
    return RoundingMode.Trunc
  }
  if text == "halfCeil" {
    return RoundingMode.HalfCeil
  }
  if text == "halfFloor" {
    return RoundingMode.HalfFloor
  }
  if text == "halfExpand" {
    return RoundingMode.HalfExpand
  }
  if text == "halfTrunc" {
    return RoundingMode.HalfTrunc
  }
  return RoundingMode.HalfEven
}

fn unit(text: string) -> DateUnit {
  if text == "y" {
    return DateUnit.Year
  }
  if text == "m" {
    return DateUnit.Month
  }
  if text == "w" {
    return DateUnit.Week
  }
  return DateUnit.Day
}

fn period(text: string) -> Period {
  return match Period.parse(text) {
    Result<Period, TimeParseError>.Success { value } => value
    Result<Period, TimeParseError>.Failure { error: _ } => Intrinsic.trap("a row has a bad period")
  }
}

fn same<T: Equal>(left: T, right: T) -> bool {
  return &left == &right
}

effect fn none() -> () ! WriterError ? &mut Writer {
  return run Writer.writeAll(b"!")
}

// Writes the answer of the row `line`, which has no zone.
effect fn plainAnswer(kind: string, line: string) -> () ! WriterError ? &mut Writer {
  if kind == "D" {
    let span = Duration.make(number(fieldAt(line, 1)), number(fieldAt(line, 2)))
    match span.checkedRound(step(fieldAt(line, 3), fieldAt(line, 4)), mode(fieldAt(line, 5))) {
      Option<Duration>.Some { value } => {
        run Format.format("{} {}", &(value.wholeSeconds(), value.subsecondNanoseconds()))
      }
      Option<Duration>.None => {
        run none()
      }
    }
  } else if kind == "I" {
    let at = Instant.make(number(fieldAt(line, 1)), number(fieldAt(line, 2)))
    match at.checkedRound(step(fieldAt(line, 3), fieldAt(line, 4)), mode(fieldAt(line, 5))) {
      Option<Instant>.Some { value } => {
        run Format.format("{} {}", &(value.unixSeconds(), value.subsecondNanoseconds()))
      }
      Option<Instant>.None => {
        run none()
      }
    }
  } else if kind == "T" {
    match PlainTime.parse(fieldAt(line, 1)) {
      Result<PlainTime, TimeParseError>.Success { value } => {
        run Format.format("{}", &.(value.round(step(fieldAt(line, 2), fieldAt(line, 3)), mode(fieldAt(line, 4)))))
      }
      Result<PlainTime, TimeParseError>.Failure { error: _ } => {
        run none()
      }
    }
  } else {
    let mut rounded = Option<PlainDateTime>.none()
    if let Result<PlainDateTime, TimeParseError>.Success { value: from } = PlainDateTime.parse(fieldAt(line, 1)) {
      rounded = from.checkedRound(step(fieldAt(line, 2), fieldAt(line, 3)), mode(fieldAt(line, 4)))
    }
    match rounded {
      Option<PlainDateTime>.Some { value } => {
        run Format.format("{}", &.(value))
      }
      Option<PlainDateTime>.None => {
        run none()
      }
    }
  }
  return ()
}

// Writes the answer of the row `line`, which is in `zone`.
effect fn zonedAnswer(kind: string, line: string, zone: &Zone) -> () ! WriterError ? &mut Writer {
  let from = ZonedDateTime.make(Instant.make(number(fieldAt(line, 2)), number(fieldAt(line, 3))), zone)
  if kind == "Z" {
    match from.checkedRound(step(fieldAt(line, 4), fieldAt(line, 5)), mode(fieldAt(line, 6))) {
      Option<ZonedDateTime>.Some { value } => {
        run Format.format("{}", &.(value))
      }
      Option<ZonedDateTime>.None => {
        run none()
      }
    }
  } else if kind == "A" {
    let overflow = if fieldAt(line, 5) == "r" { Overflow.Reject } else { Overflow.Constrain }
    match from.checkedAddPeriod(period(fieldAt(line, 4)), overflow) {
      Option<ZonedDateTime>.Some { value } => {
        run Format.format("{}", &.(value))
      }
      Option<ZonedDateTime>.None => {
        run none()
      }
    }
  } else {
    let to = ZonedDateTime.make(Instant.make(number(fieldAt(line, 4)), number(fieldAt(line, 5))), zone)
    let span = from.periodUntil(to, unit(fieldAt(line, 6)))
    // Adding the period to the first value gives the second.
    if !same(from.addPeriod(span).instant(), to.instant()) {
      return run none()
    }
    run Format.format("{}", &.(span))
  }
  return ()
}

fn lastField(kind: string) -> usize {
  if kind == "T" || kind == "P" {
    return 5
  }
  if kind == "Z" || kind == "U" {
    return 7
  }
  return 6
}

effect fn report(line: string, capture: &Capture, failures: &mut usize) -> () ! WriterError ? &mut Writer {
  if !holds(capture, fieldAt(line, lastField(fieldAt(line, 0)))) {
    failures.* = failures.* + 1
    run Format.format("FAIL {}\n", &.(line))
  }
  return ()
}

effect fn checkRows() -> usize
  ! WriterError | ZoneLookupError | OutOfMemoryError
  ? &mut Writer | &mut TimeZones | &mut Allocator {
  let table = rows()
  let mut failures: usize = 0
  let mut checked: usize = 0
  let mut index: usize = 0
  while index < table.length {
    let line = table[index]
    let kind = fieldAt(line, 0)
    if kind == "D" || kind == "I" || kind == "T" || kind == "P" {
      let mut capture = Capture { bytes: [0; 160], length: 0 }
      run plainAnswer(kind, line) |> Effect.provideMut<Writer>(&mut capture)
      run report(line, &capture, &mut failures)
      checked = checked + 1
    }
    index = index + 1
  }
  let names = [
    "America/Sao_Paulo", "America/New_York", "Europe/London", "Australia/Lord_Howe", "Pacific/Apia", "Asia/Kathmandu",
    "America/St_Johns", "Africa/Casablanca", "Asia/Tehran", "Antarctica/Troll", "America/Havana", "UTC",
  ]
  let mut which: usize = 0
  while which < names.length {
    let zone = run TimeZones.zone(names[which])
    index = 0
    while index < table.length {
      let line = table[index]
      let kind = fieldAt(line, 0)
      if (kind == "Z" || kind == "A" || kind == "U") && fieldAt(line, 1) == names[which] {
        let mut capture = Capture { bytes: [0; 160], length: 0 }
        run zonedAnswer(kind, line, &zone) |> Effect.provideMut<Writer>(&mut capture)
        run report(line, &capture, &mut failures)
        checked = checked + 1
      }
      index = index + 1
    }
    which = which + 1
  }
  run Format.format("{} of {} rows, {} failures\n", &(checked, table.length, failures))
  return failures
}

// Checks of the functions that the rows do not reach.
effect fn checkValues() -> usize ! WriterError ? &mut Writer {
  let mut failures: usize = 0
  // A step is a count of one unit that divides one day.
  if !same(TimeIncrement.checkedOf(0, TimeUnit.Minute).isNone(), true)
    || !same(TimeIncrement.checkedOf(7, TimeUnit.Hour).isNone(), true)
    || !same(TimeIncrement.checkedOf(2, TimeUnit.Day).isNone(), true)
    || !same(TimeIncrement.checkedOf(4294967295, TimeUnit.Day).isNone(), true)
    || !same(TimeIncrement.checkedOf(4294967295, TimeUnit.Nanosecond).isNone(), true)
    || !same(TimeIncrement.checkedOf(86401, TimeUnit.Second).isNone(), true) {
    failures = failures + 1
  }
  if TimeIncrement.of(90, TimeUnit.Minute).nanoseconds() != 5400000000000
    || TimeIncrement.of(86400, TimeUnit.Second).nanoseconds() != TimeIncrement.one(TimeUnit.Day).nanoseconds()
    || TimeIncrement.of(1953125, TimeUnit.Nanosecond).nanoseconds() != 1953125
    || TimeUnit.Hour.nanoseconds() != 3600000000000 {
    failures = failures + 1
  }
  // A multiple of any step, for counts that are not times.
  if !same(RoundingMode.HalfEven.roundToMultiple(25, 10), Option<i64>.some(20))
    || !same(RoundingMode.HalfEven.roundToMultiple(35, 10), Option<i64>.some(40))
    || !same(RoundingMode.HalfEven.roundToMultiple(-25, 10), Option<i64>.some(-20))
    || !same(RoundingMode.HalfExpand.roundToMultiple(-25, 10), Option<i64>.some(-30))
    || !same(RoundingMode.HalfTrunc.roundToMultiple(-25, 10), Option<i64>.some(-20))
    || !same(RoundingMode.Floor.roundToMultiple(-21, 10), Option<i64>.some(-30))
    || !same(RoundingMode.Trunc.roundToMultiple(-21, 10), Option<i64>.some(-20))
    || !same(RoundingMode.Expand.roundToMultiple(21, 10), Option<i64>.some(30))
    || !same(RoundingMode.Ceil.roundToMultiple(30, 10), Option<i64>.some(30))
    || !same(RoundingMode.Ceil.roundToMultiple(9223372036854775801, 10), Option<i64>.none())
    || !same(RoundingMode.Floor.roundToMultiple(-9223372036854775807, 10), Option<i64>.none())
    || !same(RoundingMode.Ceil.roundToMultiple(5, 0), Option<i64>.none())
    || !same(RoundingMode.Ceil.roundToMultiple(5, -2), Option<i64>.none()) {
    failures = failures + 1
  }
  run Format.format("{} value failures\n", &.(failures))
  return failures
}

effect fn program() -> i32
  ! WriterError | ZoneLookupError | OutOfMemoryError
  ? &mut Writer | &mut TimeZones | &mut Allocator {
  let rowFailures = run checkRows()
  let valueFailures = run checkValues()
  if rowFailures != 0 || valueFailures != 0 {
    return 1
  }
  return 0
}

effect fn failed(error: WriterError | ZoneLookupError | OutOfMemoryError) -> i32 {
  return 2
}

pub effect fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut bundled = BundledTimeZones.make()
  let mut out = StdoutWriter.make()
  return run Effect.catchAll(program(), failed)
    |> Effect.provideMut<Writer>(&mut out)
    |> Effect.provideMut<TimeZones>(&mut bundled)
    |> Effect.provideMut<Allocator>(&mut allocator)
}
