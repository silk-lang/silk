import silk.crypto.pkcs8 { EncryptedPkcs8, Pbes2Cipher, Pbes2Parameters, Pbes2Prf, Pkcs8Error }
import silk.encoding.pem { Pem, PemError, PemSection }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.core.result { Result }

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut index: usize = 0
  while index < left.length {
    if left[index] != right[index] { return false }
    index = index + 1
  }
  return true
}

fn checkDecrypt(text: &[u8], expected: &[u8], password: &[u8]) -> bool {
  let section = match Pem.find(text, 0) {
    Result<PemSection, PemError>.Success { value } => move value
    Result<PemSection, PemError>.Failure { error: _ } => {
      return false
    }
  }
  if same(Pem.label(text, &section), b"ENCRYPTED PRIVATE KEY") == false { return false }
  let mut der: [u8; 1200] = [0; 1200]
  let length = match Pem.decode(text, &section, &mut der) {
    Result<usize, PemError>.Success { value } => value
    Result<usize, PemError>.Failure { error: _ } => {
      return false
    }
  }
  let encrypted = Slice.view<u8>(&der, 0, length)
  let mut plain: [u8; 1200] = [0; 1200]
  if EncryptedPkcs8.decryptedLength(encrypted) < expected.length { return false }
  let opened = match EncryptedPkcs8.decrypt(encrypted, password, &mut plain) {
    Result<usize, Pkcs8Error>.Success { value } => value
    Result<usize, Pkcs8Error>.Failure { error: _ } => {
      return false
    }
  }
  if same(Slice.view<u8>(&plain, 0, opened), expected) == false { return false }
  // A wrong password fails, and leaves the output alone.
  let mut untouched: [u8; 1200] = [7; 1200]
  if let Result.Success { value: _ } = EncryptedPkcs8.decrypt(encrypted, b"wrong", &mut untouched) {
    // About one wrong password in 256 passes the padding check; the vectors avoid that.
    return false
  }
  return untouched[0] == 7
}

fn checkEncrypt(der: &[u8], password: &[u8], cipher: Pbes2Cipher, prf: Pbes2Prf, iterations: u32, salt: &[u8], iv: &[u8], expected: &[u8]) -> bool {
  let parameters = Pbes2Parameters { cipher: cipher, prf: prf, iterations: iterations, salt: salt, iv: iv }
  if EncryptedPkcs8.encryptedLength(der.length, &parameters) != expected.length { return false }
  let mut sealed: [u8; 1200] = [0; 1200]
  let length = match EncryptedPkcs8.encrypt(der, password, &parameters, &mut sealed) {
    Result<usize, Pkcs8Error>.Success { value } => value
    Result<usize, Pkcs8Error>.Failure { error: _ } => {
      return false
    }
  }
  if same(Slice.view<u8>(&sealed, 0, length), expected) == false { return false }
  let mut plain: [u8; 1200] = [0; 1200]
  let opened = match EncryptedPkcs8.decrypt(Slice.view<u8>(&sealed, 0, length), password, &mut plain) {
    Result<usize, Pkcs8Error>.Success { value } => value
    Result<usize, Pkcs8Error>.Failure { error: _ } => {
      return false
    }
  }
  return same(Slice.view<u8>(&plain, 0, opened), der)
}

