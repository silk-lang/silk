fn pemChecks() -> i32 {
  // Text around blocks, CRLF lines, odd wrapping, and headers.
  let text = b"junk\r\n-----BEGIN A B-----\r\nProc-Type: 4,ENCRYPTED\r\nDEK-Info: AES-128-CBC,00FF\r\n\r\naGVs\r\n bG8=\r\n-----END A B-----\r\nmore\n-----BEGIN X-----\nAA==\n-----END X-----"
  let first = match Pem.find(text, 0) {
    Result<PemSection, PemError>.Success { value } => move value
    Result<PemSection, PemError>.Failure { error: _ } => {
      return 1
    }
  }
  if same(Pem.label(text, &first), b"A B") == false { return 2 }
  if let Option.Some { value } = Pem.header(text, &first, b"DEK-Info") {
    if same(value, b"AES-128-CBC,00FF") == false { return 3 }
  } else {
    return 3
  }
  if let Option.Some { value: _ } = Pem.header(text, &first, b"Missing") { return 4 }
  let mut out: [u8; 8] = [0; 8]
  let length = match Pem.decode(text, &first, &mut out) {
    Result<usize, PemError>.Success { value } => value
    Result<usize, PemError>.Failure { error: _ } => {
      return 5
    }
  }
  if same(Slice.view<u8>(&out, 0, length), b"hello") == false { return 6 }
  let second = match Pem.find(text, first.end) {
    Result<PemSection, PemError>.Success { value } => move value
    Result<PemSection, PemError>.Failure { error: _ } => {
      return 7
    }
  }
  if same(Pem.label(text, &second), b"X") == false { return 8 }
  if let Result.Success { value: _ } = Pem.find(text, second.end) { return 9 }
  // Mismatched labels, a missing END, data after padding, and a short output.
  if let Result.Success { value: _ } = Pem.find(b"-----BEGIN A-----\nAA==\n-----END B-----\n", 0) { return 10 }
  if let Result.Success { value: _ } = Pem.find(b"-----BEGIN A-----\nAA==\n", 0) { return 11 }
  let bad = b"-----BEGIN A-----\nAA==AA==\n-----END A-----\n"
  let badSection = match Pem.find(bad, 0) {
    Result<PemSection, PemError>.Success { value } => move value
    Result<PemSection, PemError>.Failure { error: _ } => {
      return 12
    }
  }
  if let Result.Success { value: _ } = Pem.decode(bad, &badSection, &mut out) { return 13 }
  let mut tiny: [u8; 2] = [9; 2]
  if let Result.Success { value: _ } = Pem.decode(text, &first, &mut tiny) { return 14 }
  if tiny[0] != 9 { return 15 }
  // Encoding wraps at 64 characters and round trips.
  let data: [u8; 100] = [200; 100]
  let mut encoded: [u8; 300] = [0; 300]
  let written = match Pem.encode(b"DATA", b"", &data, &mut encoded) {
    Result<usize, PemError>.Success { value } => value
    Result<usize, PemError>.Failure { error: _ } => {
      return 16
    }
  }
  if written != Pem.encodedLength(4, 0, 100) || encoded[21 + 64] != 10 { return 17 }
  let section = match Pem.find(Slice.view<u8>(&encoded, 0, written), 0) {
    Result<PemSection, PemError>.Success { value } => move value
    Result<PemSection, PemError>.Failure { error: _ } => {
      return 18
    }
  }
  let mut back: [u8; 100] = [0; 100]
  if let Result.Failure { error: _ } = Pem.decode(Slice.view<u8>(&encoded, 0, written), &section, &mut back) { return 19 }
  if same(&back, &data) == false { return 20 }
  if let Result.Success { value: _ } = Pem.encode(b"BAD-LABEL", b"", &data, &mut encoded) { return 21 }
  return 0
}

fn pkcs8Checks() -> i32 {
  let mut out: [u8; 64] = [0; 64]
  let bad = Pbes2Parameters { cipher: Pbes2Cipher.Aes128Cbc, prf: Pbes2Prf.HmacSha256, iterations: 1, salt: b"salt", iv: b"short" }
  if let Result.Success { value: _ } = EncryptedPkcs8.encrypt(b"x", b"p", &bad, &mut out) { return 1 }
  let zero = Pbes2Parameters { cipher: Pbes2Cipher.TripleDesCbc, prf: Pbes2Prf.HmacSha1, iterations: 0, salt: b"salt", iv: b"12345678" }
  if let Result.Success { value: _ } = EncryptedPkcs8.encrypt(b"x", b"p", &zero, &mut out) { return 2 }
  if let Result.Success { value: _ } = EncryptedPkcs8.decrypt(b"\x30\x00", b"p", &mut out) { return 3 }
  if EncryptedPkcs8.decryptedLength(b"\x30\x00") != 0 { return 4 }
  return 0
}

fn checkLegacy(text: &[u8], expected: &[u8], password: &[u8]) -> bool {
  let section = match Pem.find(text, 0) {
    Result<PemSection, PemError>.Success { value } => move value
    Result<PemSection, PemError>.Failure { error: _ } => {
      return false
    }
  }
  if let Option.Some { value } = Pem.header(text, &section, b"Proc-Type") {
    if same(value, b"4,ENCRYPTED") == false { return false }
  } else {
    return false
  }
  let dekInfo = match Pem.header(text, &section, b"DEK-Info") {
    Option<&[u8]>.Some { value } => value
    Option<&[u8]>.None => {
      return false
    }
  }
  let mut body: [u8; 1200] = [0; 1200]
  let length = match Pem.decode(text, &section, &mut body) {
    Result<usize, PemError>.Success { value } => value
    Result<usize, PemError>.Failure { error: _ } => {
      return false
    }
  }
  let mut plain: [u8; 1200] = [0; 1200]
  let opened = match LegacyPem.decrypt(dekInfo, password, Slice.view<u8>(&body, 0, length), &mut plain) {
    Result<usize, LegacyPemError>.Success { value } => value
    Result<usize, LegacyPemError>.Failure { error: _ } => {
      return false
    }
  }
  if same(Slice.view<u8>(&plain, 0, opened), expected) == false { return false }
  let mut untouched: [u8; 1200] = [7; 1200]
  if let Result.Success { value: _ } = LegacyPem.decrypt(dekInfo, b"wrong!", Slice.view<u8>(&body, 0, length), &mut untouched) { return false }
  return untouched[0] == 7
}

fn checkLegacyEncrypt(cipher: LegacyPemCipher, iv: &[u8], der: &[u8], password: &[u8], expected: &[u8]) -> bool {
  let found = match Pem.find(expected, 0) {
    Result<PemSection, PemError>.Success { value } => move value
    Result<PemSection, PemError>.Failure { error: _ } => {
      return false
    }
  }
  let label = Pem.label(expected, &found)
  let mut headers: [u8; 96] = [0; 96]
  let headersLength = LegacyPem.writeHeaders(cipher, iv, &mut headers)
  if headersLength != LegacyPem.headersLength(cipher) { return false }
  let mut sealed: [u8; 1200] = [0; 1200]
  let length = match LegacyPem.encrypt(cipher, password, iv, der, &mut sealed) {
    Result<usize, LegacyPemError>.Success { value } => value
    Result<usize, LegacyPemError>.Failure { error: _ } => {
      return false
    }
  }
  if length != LegacyPem.encryptedLength(cipher, der.length) { return false }
  let mut text: [u8; 2000] = [0; 2000]
  let written = match Pem.encode(label, Slice.view<u8>(&headers, 0, headersLength), Slice.view<u8>(&sealed, 0, length), &mut text) {
    Result<usize, PemError>.Success { value } => value
    Result<usize, PemError>.Failure { error: _ } => {
      return false
    }
  }
  return written == Pem.encodedLength(label.length, headersLength, length) && same(Slice.view<u8>(&text, 0, written), expected)
}

