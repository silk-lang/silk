pub fn main() -> i32 {
  let failed = vectors()
  if failed != 0 { return failed }
  let pem = pemChecks()
  if pem != 0 { return 100 + pem }
  let legacy = legacyVectors()
  if legacy != 0 { return legacy }
  let pkcs8 = pkcs8Checks()
  if pkcs8 != 0 { return 200 + pkcs8 }
  return 42
}
