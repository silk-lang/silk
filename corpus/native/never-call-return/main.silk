import silk.num.usize
import silk.num.i32

struct Tally { count: usize, flag: bool, total: i32 }

fn stop(code: i32) -> never { return stop(code) }

// A multi-field result returned through a call of a `never` function inside a loop.
fn tally(values: [i32; 3], limit: i32) -> Tally {
  let mut at = usize.ZERO
  let mut total = 0
  while at < 3 {
    if values[at] > limit { return stop(values[at]) }
    total = total + values[at]
    at = at + usize.ONE
  }
  return Tally {count: at, flag: true, total: total}
}

// A scalar result returned through the same call outside a loop.
fn bounded(limit: i32) -> i32 {
  if limit > 100 { return stop(limit) }
  return limit
}

pub fn main() -> i32 {
  let tallied = tally([10, 12, 13], 50)
  if !tallied.flag || tallied.count != 3 { return 1 }
  return tallied.total + bounded(7)
}
