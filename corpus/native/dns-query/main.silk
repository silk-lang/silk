import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.net.address { Endpoint, IpAddress, Ipv4Address, Port }
import silk.net.dns.config { ResolverConfig }
import silk.net.dns.message {
  CLASS_IN,
  Edns,
  Message,
  MessageError,
  MessageReason,
  Name,
  Question,
  RCODE_FORMAT_ERROR,
  RCODE_NAME_ERROR,
  RCODE_SERVER_FAILURE,
  Record,
  RecordData,
  TYPE_A,
}
import silk.net.dns.query { Exchange, QueryError, Receipt, Reply, Step, Transport }
import silk.system.system_clock { Instant, SystemClock }
import silk.num.usize

fn at(seconds: i64) -> Instant {
  return SystemClock.make(seconds, 0)
}

fn serverAt(last: u8) -> Endpoint {
  return Endpoint.make(
    IpAddress.V4 { value: Ipv4Address.fromOctets([192, 0, 2, last]) },
    Port.fromU16(53),
  )
}

effect fn config(count: u8, attempts: usize) -> ResolverConfig
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut servers = List<Endpoint>.make()
  let mut index: u8 = 0
  while index < count {
    run List<Endpoint>.append(&mut servers, serverAt(index + 1))
    index = index + 1
  }
  let mut result = ResolverConfig.make(move servers)
  result.attempts = attempts
  return move result
}

fn question() -> Question {
  let name = match Name.parse("example.com") {
    Result<Name, MessageError>.Success { value } => value
    Result<Name, MessageError>.Failure { .. } => Intrinsic.trap("name")
  }
  return Question { name: name, kind: TYPE_A, class: CLASS_IN }
}

// Returns an answer to the UDP packet of `exchange`, with `code`, and the TC bit when `truncated`.
effect fn answer(exchange: &Exchange, code: u16, truncated: bool, id: u16) -> Bytes
  ! MessageError | OutOfMemoryError
  ? &mut Allocator {
  let mut message = run Message.parse(Exchange.packet(exchange, Transport.Udp))
  message.header.id = id
  message.header.response = true
  message.header.truncated = truncated
  message.header.responseCode = code
  message.edns = Option<Edns>.none()
  let name = question().name
  run List<Record>.append(
    &mut message.answers,
    Record {
      name: name,
      class: CLASS_IN,
      ttl: 60,
      data: RecordData.A { address: Ipv4Address.fromOctets([198, 51, 100, 7]) },
    },
  )
  let mut output = Bytes.make()
  run Message.encode(&message, &mut output)
  return move output
}

fn sends(step: Step, index: usize, transport: Transport) -> bool {
  return match move step {
    Step.Send { server, transport: kind, endpoint } => server == index && kind == transport
      && Endpoint.equals(&endpoint, &serverAt(usize.toU8(index) + 1))
    _ => false
  }
}

fn waits(step: Step, seconds: i64) -> bool {
  return match move step {
    Step.Wait { until } => SystemClock.seconds(&until) == seconds
      && SystemClock.nanoseconds(&until) == 0
    _ => false
  }
}

fn done(step: Step) -> bool {
  return match move step {
    Step.Done => true
    _ => false
  }
}

fn failsWith(exchange: Exchange, expected: QueryError) -> bool {
  return match Exchange.finish(move exchange) {
    Result<Reply, QueryError>.Success { .. } => false
    Result<Reply, QueryError>.Failure { error } => match error {
      QueryError.Timeout => match expected {
        QueryError.Timeout => true
        _ => false
      }
      QueryError.NoServers => match expected {
        QueryError.NoServers => true
        _ => false
      }
      QueryError.Rejected { responseCode, server } => match expected {
        QueryError.Rejected { responseCode: code, server: index } => code == responseCode
          && index == server
        _ => false
      }
      QueryError.Unreachable { server } => match expected {
        QueryError.Unreachable { server: index } => index == server
        _ => false
      }
      QueryError.BadResponse { server, .. } => match expected {
        QueryError.BadResponse { server: index, .. } => index == server
        _ => false
      }
    }
  }
}

effect fn timeoutThenAnswer() -> i32
  ! MessageError | OutOfMemoryError
  ? &mut Allocator {
  let settings = run config(2, 2)
  let mut exchange = run Exchange.make(&settings, question(), 4242, 0)
  if !sends(Exchange.poll(&mut exchange, &at(100)), 0, Transport.Udp) {
    return 1
  }
  if !waits(Exchange.poll(&mut exchange, &at(100)), 105) {
    return 2
  }
  if !waits(Exchange.poll(&mut exchange, &at(104)), 105) {
    return 3
  }
  if !sends(Exchange.poll(&mut exchange, &at(105)), 1, Transport.Udp) {
    return 4
  }

  // A reply with another identifier, and one from a server that was never asked, are ignored.
  let wrong = run answer(&exchange, 0, false, 4243)
  if (run Exchange.receive(&mut exchange, 1, Transport.Udp, Bytes.asSlice(&wrong)))
    != Receipt.Ignored {
    return 5
  }
  let good = run answer(&exchange, 0, false, 4242)

  if (run Exchange.receive(&mut exchange, 1, Transport.Tcp, Bytes.asSlice(&good)))
    != Receipt.Ignored {
    return 6
  }
  if (run Exchange.receive(&mut exchange, 1, Transport.Udp, b"\x10\x92\x81")) != Receipt.Ignored {
    return 7
  }

  // The first server answers late; its answer counts.
  if (run Exchange.receive(&mut exchange, 0, Transport.Udp, Bytes.asSlice(&good)))
    != Receipt.Answer {
    return 8
  }
  if !done(Exchange.poll(&mut exchange, &at(106))) || !Exchange.isDone(&exchange) {
    return 9
  }
  return match Exchange.finish(move exchange) {
    Result<Reply, QueryError>.Failure { .. } => 10
    Result<Reply, QueryError>.Success { value } => {
      if value.server != 0 || value.transport != Transport.Udp {
        return 11
      }
      if List<Record>.length(&value.message.answers) != 1 {
        return 12
      }
      if Bytes.length(&value.bytes) != Bytes.length(&good) {
        return 13
      }
      return 0
    }
  }
}

effect fn truncatedGoesTcp() -> i32
  ! MessageError | OutOfMemoryError
  ? &mut Allocator {
  let settings = run config(2, 1)
  let mut exchange = run Exchange.make(&settings, question(), 7, 1)
  if !sends(Exchange.poll(&mut exchange, &at(0)), 1, Transport.Udp) {
    return 1
  }
  let cut = run answer(&exchange, 0, true, 7)
  if (run Exchange.receive(&mut exchange, 1, Transport.Udp, Bytes.asSlice(&cut))) != Receipt.Retry {
    return 2
  }
  if !sends(Exchange.poll(&mut exchange, &at(1)), 1, Transport.Tcp) {
    return 3
  }
  let framed = Exchange.packet(&exchange, Transport.Tcp)
  let plain = Exchange.packet(&exchange, Transport.Udp)
  if framed.length != plain.length + 2 || framed[0] != 0 || usize.toU8(plain.length) != framed[1] {
    return 4
  }
  if framed[2] != 0 || framed[3] != 7 {
    return 5
  }
  let whole = run answer(&exchange, 0, false, 7)
  if (run Exchange.receive(&mut exchange, 1, Transport.Tcp, Bytes.asSlice(&whole)))
    != Receipt.Answer {
    return 6
  }
  return match Exchange.finish(move exchange) {
    Result<Reply, QueryError>.Failure { .. } => 7
    Result<Reply, QueryError>.Success { value } => {
      if value.transport != Transport.Tcp || value.server != 1 {
        return 8
      }
      return 0
    }
  }
}

effect fn rejectedAndFailed() -> i32
  ! MessageError | OutOfMemoryError
  ? &mut Allocator {
  let settings = run config(2, 1)
  let mut exchange = run Exchange.make(&settings, question(), 9, 0)
  if !sends(Exchange.poll(&mut exchange, &at(0)), 0, Transport.Udp) {
    return 1
  }
  let failure = run answer(&exchange, RCODE_SERVER_FAILURE, false, 9)
  if (run Exchange.receive(&mut exchange, 0, Transport.Udp, Bytes.asSlice(&failure)))
    != Receipt.Retry {
    return 2
  }
  if !sends(Exchange.poll(&mut exchange, &at(0)), 1, Transport.Udp) {
    return 3
  }
  Exchange.transportFailed(&mut exchange, 0, Transport.Udp)
  if !waits(Exchange.poll(&mut exchange, &at(0)), 5) {
    return 4
  }
  Exchange.transportFailed(&mut exchange, 1, Transport.Udp)
  if !done(Exchange.poll(&mut exchange, &at(0))) {
    return 5
  }
  if !failsWith(move exchange, QueryError.Unreachable { server: 1 }) {
    return 6
  }

  let mut second = run Exchange.make(&settings, question(), 9, 0)
  let ignored = Exchange.poll(&mut second, &at(0))
  drop ignored
  let refusal = run answer(&second, RCODE_SERVER_FAILURE, false, 9)
  let ignoredReceipt = run Exchange.receive(&mut second, 0, Transport.Udp, Bytes.asSlice(&refusal))
  drop ignoredReceipt
  if !sends(Exchange.poll(&mut second, &at(0)), 1, Transport.Udp) {
    return 7
  }
  if (run Exchange.receive(&mut second, 1, Transport.Udp, Bytes.asSlice(&refusal)))
    != Receipt.Retry {
    return 8
  }
  if !done(Exchange.poll(&mut second, &at(0))) {
    return 9
  }
  if !failsWith(
    move second,
    QueryError.Rejected { responseCode: RCODE_SERVER_FAILURE, server: 1 },
  ) {
    return 10
  }

  // NXDOMAIN is an answer.
  let mut third = run Exchange.make(&settings, question(), 11, 0)
  let started = Exchange.poll(&mut third, &at(0))
  drop started
  let missing = run answer(&third, RCODE_NAME_ERROR, false, 11)
  if (run Exchange.receive(&mut third, 0, Transport.Udp, Bytes.asSlice(&missing)))
    != Receipt.Answer {
    return 11
  }
  return match Exchange.finish(move third) {
    Result<Reply, QueryError>.Failure { .. } => 12
    Result<Reply, QueryError>.Success { value } => {
      if value.message.header.responseCode != RCODE_NAME_ERROR {
        return 13
      }
      return 0
    }
  }
}

effect fn allTimeOut() -> i32
  ! MessageError | OutOfMemoryError
  ? &mut Allocator {
  let settings = run config(2, 2)
  let mut exchange = run Exchange.make(&settings, question(), 1, 3)
  if !sends(Exchange.poll(&mut exchange, &at(0)), 1, Transport.Udp) {
    return 1
  }
  if !sends(Exchange.poll(&mut exchange, &at(5)), 0, Transport.Udp) {
    return 2
  }
  if !sends(Exchange.poll(&mut exchange, &at(10)), 1, Transport.Udp) {
    return 3
  }

  // The second round waits twice as long.
  if !waits(Exchange.poll(&mut exchange, &at(10)), 20) {
    return 4
  }
  if !sends(Exchange.poll(&mut exchange, &at(20)), 0, Transport.Udp) {
    return 5
  }
  if !done(Exchange.poll(&mut exchange, &at(30))) {
    return 6
  }
  if !failsWith(move exchange, QueryError.Timeout) {
    return 7
  }
  let empty = ResolverConfig.make(List<Endpoint>.make())
  let mut none = run Exchange.make(&empty, question(), 1, 0)
  if !done(Exchange.poll(&mut none, &at(0))) {
    return 8
  }
  if !failsWith(move none, QueryError.NoServers) {
    return 9
  }
  return 0
}

effect fn ednsFallback() -> i32
  ! MessageError | OutOfMemoryError
  ? &mut Allocator {
  let mut settings = run config(1, 1)
  settings.edns = true
  settings.useTcp = true
  let mut exchange = run Exchange.make(&settings, question(), 5, 0)
  if !sends(Exchange.poll(&mut exchange, &at(0)), 0, Transport.Tcp) {
    return 1
  }
  let withOpt = Exchange.packet(&exchange, Transport.Udp)
  if withOpt[11] != 1 {
    return 2
  }
  let formerr = run answer(&exchange, RCODE_FORMAT_ERROR, false, 5)
  if (run Exchange.receive(&mut exchange, 0, Transport.Tcp, Bytes.asSlice(&formerr)))
    != Receipt.Retry {
    return 3
  }
  if Exchange.packet(&exchange, Transport.Udp)[11] != 0 {
    return 4
  }
  if !sends(Exchange.poll(&mut exchange, &at(0)), 0, Transport.Tcp) {
    return 5
  }

  // A TCP message that cannot be read ends the try.
  if (run Exchange.receive(&mut exchange, 0, Transport.Tcp, b"\x00\x05\x81\x80\x00\x01"))
    != Receipt.Retry {
    return 6
  }
  if !done(Exchange.poll(&mut exchange, &at(0))) {
    return 7
  }
  if !failsWith(
    move exchange,
    QueryError.BadResponse { reason: MessageReason.Truncated, server: 0 },
  ) {
    return 8
  }
  return 0
}

effect fn program() -> i32
  ! MessageError | OutOfMemoryError
  ? &mut Allocator {
  let first = run timeoutThenAnswer()
  if first != 0 {
    return 10 + first
  }
  let second = run truncatedGoesTcp()
  if second != 0 {
    return 30 + second
  }
  let third = run rejectedAndFailed()
  if third != 0 {
    return 50 + third
  }
  let fourth = run allTimeOut()
  if fourth != 0 {
    return 70 + fourth
  }
  let fifth = run ednsFallback()
  if fifth != 0 {
    return 90 + fifth
  }
  return 42
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  return 1
}

pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(program(), failed) |> Effect.provideMut<Allocator>(&mut allocator)
}
