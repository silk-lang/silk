// Moving overlapping slices has the same result as copying through a temporary.
import silk.mem.pointer { Pointer }

unsafe fn copyRange(destination: [*]mut u8, source: [*]const u8, length: usize) -> () {
  let mut toAnchor: u8 = 0
  let fromAnchor: u8 = 0
  unsafe {
    let mut to = Pointer.borrowManyMut<u8, u8>(&mut toAnchor, destination, length)
    let from = Pointer.borrowMany<u8, u8>(&fromAnchor, source, length)
    Intrinsic.sliceCopy<u8>(&mut to, 0, from)
  }
}

pub fn main() -> i32 {
  let mut bytes: [u8; 5] = [1, 2, 3, 4, 5]
  unsafe {
    let base = Intrinsic.pointerRequalify<?[*]mut u8, [*]mut u8>(Pointer.fromMutSlice<u8>(&mut bytes))
    let next = Intrinsic.pointerRequalify<*mut u8, [*]mut u8>(Pointer.atMut<u8>(base, 1))
    copyRange(next, base, 4)
    if bytes[0] != 1 || bytes[1] != 1 || bytes[2] != 2 || bytes[3] != 3 || bytes[4] != 4 { return 1 }
    copyRange(base, next, 4)
    copyRange(base, next, 0)
  }
  if bytes[0] != 1 || bytes[1] != 2 || bytes[2] != 3 || bytes[3] != 4 || bytes[4] != 4 { return 2 }
  return 42
}
