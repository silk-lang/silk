import silk.core.effect { Effect }
import silk.core.result { Result }
// An erased operation's implementations may fail with less than the interface names: one never
// fails, one fails with a single member, one with a smaller union. The dispatcher widens each.
struct AError { code: i32 }
struct BError { code: i32 }
struct CError { code: i32 }

interface Step {
  effect fn step(self: &mut Self, value: i32) -> i32 ! AError | BError | CError
}

struct Never { seen: i32 }
struct OnlyB { limit: i32 }
struct AOrC { limit: i32 }
struct Full { limit: i32 }

impl Step for Never {
  effect fn step(self: &mut Self, value: i32) -> i32 {
    self.seen = self.seen + 1
    return value + 1
  }
}

impl Step for OnlyB {
  effect fn step(self: &mut Self, value: i32) -> i32 ! BError {
    if value > self.limit { fail BError {code: value} }
    return value + 2
  }
}

impl Step for AOrC {
  effect fn step(self: &mut Self, value: i32) -> i32 ! AError | CError {
    if value > self.limit { fail CError {code: value} }
    if value < 0 { fail AError {code: value} }
    return value + 3
  }
}

impl Step for Full {
  effect fn step(self: &mut Self, value: i32) -> i32 ! AError | BError | CError {
    if value > self.limit { fail AError {code: value} }
    return value + 4
  }
}

effect fn through(step: &mut any Step, value: i32) -> i32 ! AError | BError | CError {
  return run step.step(value)
}

// 1000s digit names the failure (1 A, 2 B, 3 C); the rest carries its code.
fn observe(attempt: Result<i32, AError | BError | CError>) -> i32 {
  return match move attempt {
    Result<i32, AError | BError | CError>.Success {value} => value
    Result<i32, AError | BError | CError>.Failure {error} => match move error {
      AError failed => 1000 + failed.code
      BError failed => 2000 + failed.code
      CError failed => 3000 + failed.code
    }
  }
}

pub fn main() -> i32 {
  let mut never = Never {seen: 0}
  let mut onlyB = OnlyB {limit: 10}
  let mut aOrC = AOrC {limit: 10}
  let mut full = Full {limit: 10}
  if observe(run Effect.result(through(&mut never, 5))) != 6 { return 1 }
  if observe(run Effect.result(through(&mut onlyB, 5))) != 7 { return 2 }
  if observe(run Effect.result(through(&mut onlyB, 20))) != 2020 { return 3 }
  if observe(run Effect.result(through(&mut aOrC, 5))) != 8 { return 4 }
  if observe(run Effect.result(through(&mut aOrC, 30))) != 3030 { return 5 }
  if observe(run Effect.result(through(&mut aOrC, -7))) != 993 { return 6 }
  if observe(run Effect.result(through(&mut full, 40))) != 1040 { return 7 }
  if observe(run Effect.result(through(&mut full, 1))) != 5 { return 8 }
  if never.seen != 1 { return 9 }
  return 42
}
