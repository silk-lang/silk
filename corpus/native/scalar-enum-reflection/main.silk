// A reflected constant and an authored type binder denote the same specialized enum.
enum(i16) Mode { Low = -7, High = 300 }
fn ordinal<T>(value: &T) -> i32 {
  let mut index = 0
  static for member in Intrinsic.reflectEnumMembers<T>() {
    if member == value.* { return index }
    index = index + 1
  }
  return -1
}
pub fn main() -> i32 {
  let first = Mode.Low
  let last = Mode.High
  if ordinal(&first) != 0 { return 1 }
  if ordinal(&last) != 1 { return 2 }
  return 42
}
