import silk.concurrency.atomic { Atomic, CompareExchange, MemoryOrder }
import silk.mem.pointer { Pointer }
import silk.num.u32

// Each atomic operation returns the previous value and leaves the documented result in place.
pub fn main() -> i32 {
  let mut word: u32 = 5
  let cell = Pointer.fromMutRef(&mut word)
  let mut failures = 0
  unsafe {
    if Atomic.fetchAdd<u32>(cell, 10, MemoryOrder.AcquireRelease) != 5 { failures = failures + 1 }
    if Atomic.fetchSubtract<u32>(cell, 3, MemoryOrder.Relaxed) != 15 { failures = failures + 1 }
    if Atomic.fetchBitOr<u32>(cell, 64, MemoryOrder.Release) != 12 { failures = failures + 1 }
    if Atomic.fetchBitAnd<u32>(cell, 72, MemoryOrder.Acquire) != 76 { failures = failures + 1 }
    if Atomic.fetchBitXor<u32>(cell, 1, MemoryOrder.SequentiallyConsistent) != 72 { failures = failures + 1 }
    if Atomic.fetchMaximum<u32>(cell, 100, MemoryOrder.Relaxed) != 73 { failures = failures + 1 }
    if Atomic.fetchMinimum<u32>(cell, 9, MemoryOrder.Relaxed) != 100 { failures = failures + 1 }
    if Atomic.swap<u32>(cell, 7, MemoryOrder.AcquireRelease) != 9 { failures = failures + 1 }
    Atomic.store<u32>(cell, 8, MemoryOrder.Release)
    if Atomic.load<u32>(cell, MemoryOrder.Acquire) != 8 { failures = failures + 1 }
    match Atomic.compareExchange<u32>(cell, 3, 4, MemoryOrder.AcquireRelease, MemoryOrder.Acquire) {
      CompareExchange<u32>.Exchanged => { failures = failures + 1 }
      CompareExchange<u32>.Observed {value} => { if value != 8 { failures = failures + 1 } }
    }
    match Atomic.compareExchange<u32>(cell, 8, 42, MemoryOrder.SequentiallyConsistent, MemoryOrder.Relaxed) {
      CompareExchange<u32>.Exchanged => {}
      CompareExchange<u32>.Observed {..} => { failures = failures + 1 }
    }
  }
  // Signed minimum and maximum compare as signed values.
  let mut signed: i64 = -4
  let signedCell = Pointer.fromMutRef(&mut signed)
  unsafe {
    if Atomic.fetchMinimum<i64>(signedCell, 3, MemoryOrder.Relaxed) != -4 { failures = failures + 1 }
    if Atomic.fetchMaximum<i64>(signedCell, -9, MemoryOrder.Relaxed) != -4 { failures = failures + 1 }
  }
  Atomic.fence(MemoryOrder.SequentiallyConsistent)
  if failures != 0 { return 100 + failures }
  if signed != -4 { return 99 }
  return u32.toI32(word)
}
