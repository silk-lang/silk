import silk.core.reflect { Reflect }

/// A block of a tree, with the message type `M` its own conformance fixes.
pub interface Block<M> {
  fn weight(self: &Self) -> i32
}

/// Sums the weights of `value` and of every block below it in a field named `child`. Each call
/// reaches `walk` again at the child's type and at the message type the child's conformance fixes.
pub fn walk<B: Block<M>, M>(value: &B) -> i32 {
  let mut total = value.weight()
  static for field in Reflect.fields<B>() {
    static if Reflect.fieldLabel(field) == "child" {
      total = total + walk(Reflect.borrowField(value, field))
    }
  }
  return total
}
