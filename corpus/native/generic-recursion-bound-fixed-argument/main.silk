// A generic function may call itself at a field's type even when another type argument changes to
// one outside the first's owned structure, as long as a bound on the descending argument names it:
// `walk<Root, RootMessage>` reaches `walk<Middle, MiddleMessage>` and `walk<Leaf, LeafMessage>`
// (GEN-006).
import blocks { Block, walk }

pub union RootMessage { Started, Stopped { pub code: u64 } }
pub union MiddleMessage { Opened, Closed }
pub struct LeafMessage { pub count: i64 }

pub struct Leaf { pub value: i32 }
pub struct Middle { pub child: Leaf, pub extra: i32 }
pub struct Root { pub child: Middle, pub label: i32 }

impl Block<LeafMessage> for Leaf {
  fn weight(self: &Self) -> i32 { return self.value }
}

impl Block<MiddleMessage> for Middle {
  fn weight(self: &Self) -> i32 { return self.extra }
}

impl Block<RootMessage> for Root {
  fn weight(self: &Self) -> i32 { return self.label }
}

pub fn main() -> i32 {
  let root = Root { child: Middle { child: Leaf { value: 2 }, extra: 10 }, label: 30 }
  return walk(&root)
}
