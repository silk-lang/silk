import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.ownership { Copy, Drop }
import silk.mem.shared { Shared }
// Struct literals with many fields store each field as soon as it is evaluated when no field
// needs cleanup, and gather every field first otherwise. Both must evaluate fields in source
// order, map them to their declared fields, and leave nothing behind when a later field fails.
struct Problem {}
struct Wide { a: i64, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64, i: i64, j: i64 }
impl Copy for Wide {}
struct Counts { drops: i32 }
struct Token { counts: Shared<Counts> }
impl Drop for Token {
  fn drop(self: &mut Token) -> () {
    let changed = Shared<Counts>.withMut<i32>(&self.counts, dropped)
    return ()
  }
}
fn dropped(counts: &mut Counts) -> i32 {
  counts.drops = counts.drops + 1
  return counts.drops
}
fn drops(counts: &Counts) -> i32 { return counts.drops }
struct Held { token: Token, b: i64, c: i64, d: i64, e: i64, f: i64, g: i64, h: i64, i: i64 }
fn next(counter: &mut i64) -> i64 {
  counter.* = counter.* + 1
  return counter.*
}
effect fn step(value: i64, failing: bool) -> i64 ! Problem {
  if failing { fail Problem {} }
  return value
}
fn written(counter: &mut i64) -> Wide {
  // Written out of declaration order: each field takes the value of its position in the source.
  return Wide {
    j: next(&mut counter), c: next(&mut counter), a: next(&mut counter), h: next(&mut counter), b: next(&mut counter),
    i: next(&mut counter), d: next(&mut counter), g: next(&mut counter), e: next(&mut counter), f: next(&mut counter),
  }
}
fn reversed(w: Wide) -> Wide {
  let w = Wide { a: w.j, b: w.i, c: w.h, d: w.g, e: w.f, f: w.e, g: w.d, h: w.c, i: w.b, j: w.a }
  return w
}
effect fn fallible(failing: bool) -> Wide ! Problem {
  return Wide { a: 1, b: 2, c: 3, d: 4, e: 5, f: run step(6, failing), g: 7, h: 8, i: 9, j: 10 }
}
effect fn bound(failing: bool) -> i64 ! Problem {
  let w = Wide { a: 1, b: 2, c: 3, d: 4, e: run step(5, false), f: 6, g: 7, h: 8, i: run step(9, failing), j: 10 }
  return w.a + w.e + w.i + w.j
}
effect fn holding(counts: &Shared<Counts>, failing: bool) -> i64 ! Problem {
  let token = Token { counts: Shared<Counts>.clone(counts) }
  let held = Held { token: move token, b: 2, c: 3, d: 4, e: 5, f: 6, g: 7, h: 8, i: run step(9, failing) }
  return held.b + held.i
}
effect fn recoverWide(error: Problem) -> Wide {
  return Wide { a: -1, b: -1, c: -1, d: -1, e: -1, f: -1, g: -1, h: -1, i: -1, j: -1 }
}
effect fn recoverValue(error: Problem) -> i64 { return -1 }
fn sum(w: &Wide) -> i64 {
  return w.a + 2 * w.b + 3 * w.c + 4 * w.d + 5 * w.e + 6 * w.f + 7 * w.g + 8 * w.h + 9 * w.i + 10 * w.j
}
effect fn check() -> i32 ! OutOfMemoryError {
  let mut counter: i64 = 0
  let w = written(&mut counter)
  if w.j != 1 || w.c != 2 || w.a != 3 || w.h != 4 || w.b != 5 || w.i != 6 || w.d != 7 || w.g != 8 || w.e != 9 || w.f != 10 { return 1 }
  let r = reversed(w)
  if r.a != w.j || r.j != w.a || r.e != w.f || r.f != w.e { return 2 }
  let good = run Effect.catchAll(fallible(false), recoverWide)
  if sum(&good) != 385 { return 3 }
  let bad = run Effect.catchAll(fallible(true), recoverWide)
  if bad.f != -1 || bad.a != -1 { return 4 }
  let boundGood = run Effect.catchAll(bound(false), recoverValue)
  if boundGood != 25 { return 5 }
  let boundBad = run Effect.catchAll(bound(true), recoverValue)
  if boundBad != -1 { return 6 }
  let mut allocator = Allocator.systemAllocatorProvider()
  let counts = run Shared<Counts>.make(Counts { drops: 0 }) |> Effect.provideMut<Allocator>(&mut allocator)
  let heldGood = run Effect.catchAll(holding(&counts, false), recoverValue)
  if heldGood != 11 { return 7 }
  if Shared<Counts>.with<i32>(&counts, drops) != 1 { return 8 }
  let heldBad = run Effect.catchAll(holding(&counts, true), recoverValue)
  if heldBad != -1 { return 9 }
  if Shared<Counts>.with<i32>(&counts, drops) != 2 { return 10 }
  drop counts
  return 42
}
effect fn recoverAllocation(error: OutOfMemoryError) -> i32 { return -1 }
pub fn main() -> i32 { return run Effect.catchAll(check(), recoverAllocation) }
