effect fn windowsSeparatorsAreExplicit() -> ()
  ! OutOfMemoryError | Failed {
  let mut allocator = Allocator.systemAllocatorProvider()
  let compiled = run Pattern.make("foo/**") |> Effect.provideMut(&mut allocator)
  let windows = run Pattern.matchesWith(
    &compiled,
    "foo\\bar",
    Dots.Match,
    Separators.SlashOrBackslash,
  )
    |> Effect.provideMut(&mut allocator)
  let posix = run Pattern.matchesWith(&compiled, "foo\\bar", Dots.Match, Separators.Slash)
    |> Effect.provideMut(&mut allocator)
  run expect(windows.matches, "Windows mode recognizes backslash separators")
  run expect(!posix.matches, "POSIX mode preserves literal backslashes")
}

