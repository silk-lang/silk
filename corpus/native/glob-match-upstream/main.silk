effect fn checkLong(pattern: string, prefix: string, expected: bool, message: string<'static>) -> ()
  ! OutOfMemoryError | Failed
  ? &mut Allocator {
  let mut path = run Bytes.copy(String.utf8Bytes(prefix))
  let mut at = usize.ZERO
  while at < 32768 {
    run Bytes.append(&mut path, b"ab")
    at = at + usize.ONE
  }
  let compiled = run Pattern.make(pattern)
  let result = run Pattern.matchesBytes(&compiled, Bytes.asSlice(&path), Dots.Match)
  run expect(result.matches == expected, message)
}

