import silk.collections.bytes { Bytes }
import silk.core.bool
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.usize
import silk.text.glob { Dots, Pattern, Separators, matches }
import silk.text.string { String }
import silk.io.writer_native { StderrWriter }

// A failed expectation, reported on standard error before the program exits with 1.
struct Failed {
  message: string<'static>,
}

effect fn expect(holds: bool, message: string<'static>) -> ()
  ! Failed {
  if !holds {
    fail Failed { message: message }
  }
}

effect fn check(pattern: string, path: string, expected: bool, message: string<'static>) -> ()
  ! OutOfMemoryError | Failed
  ? &mut Allocator {
  let result = run matches(pattern, path)
  if result.matches != expected {
    StderrWriter.print("{} against {}\n", &(pattern, path))
  }
  run expect(result.matches == expected, message)
}

effect fn cases1() -> ()
  ! OutOfMemoryError | Failed
  ? &mut Allocator {
  run check("x.{ts,[,]foo}", "x.,foo", true, "Failed test for x.,foo")
  run check("x.{ts,[,]foo}", "x.]foo", false, "Failed test for x.]foo")
  run check("x.{ts,[,]foo}", "x.ts", true, "Failed test for x.ts")
  run check("/**/*a", "/a/a", true, "Failed test for /a/a")
  run check("**/*.js", "a/b.c/c.js", true, "Failed test for a/b.c/c.js")
  run check("**/**/*.js", "a/b.c/c.js", true, "Failed test for a/b.c/c.js")
  run check("a/**/*.d", "a/b/c.d", true, "Failed test for a/b/c.d")
  run check("a/**/*.d", "a/.b/c.d", true, "Failed test for a/.b/c.d")
  run check("**/*/**", "a/b/c", true, "Failed test for a/b/c")
  run check("**/*/c.js", "a/b/c.js", true, "Failed test for a/b/c.js")
  run check("{a,b}{c,d},x", "ac,x", true, "Failed test for ac,x")
  run check("{a,b}{c,d},x", "bd,x", true, "Failed test for bd,x")
  run check("{a,b}{c,d},x", "ac", false, "Failed test for ac")
  run check("{a,b}{c,d}}x", "ac}x", true, "Failed test for ac}x")
  run check("{a,b}/{c,d},x", "a/c,x", true, "Failed test for a/c,x")
  run check("{a,b}/{c,d},x", "b/d,x", true, "Failed test for b/d,x")
  run check("{a,b}/{c,d},x", "a/c", false, "Failed test for a/c")
  run check("{a,b},x", "a,x", true, "Failed test for a,x")
  run check("{a,b},x", "b,x", true, "Failed test for b,x")
  run check("abc", "abc", true, "Failed test for abc")
  run check("*", "abc", true, "Failed test for abc")
  run check("*", "", true, "Failed test for ")
  run check("**", "", true, "Failed test for ")
  run check("*c", "abc", true, "Failed test for abc")
  run check("*b", "abc", false, "Failed test for abc")
  run check("a*", "abc", true, "Failed test for abc")
  run check("b*", "abc", false, "Failed test for abc")
  run check("a*", "a", true, "Failed test for a")
  run check("*a", "a", true, "Failed test for a")
  run check("a*b*c*d*e*", "axbxcxdxe", true, "Failed test for axbxcxdxe")
  run check("a*b*c*d*e*", "axbxcxdxexxx", true, "Failed test for axbxcxdxexxx")
  run check("a*b?c*x", "abxbbxdbxebxczzx", true, "Failed test for abxbbxdbxebxczzx")
  run check("a*b?c*x", "abxbbxdbxebxczzy", false, "Failed test for abxbbxdbxebxczzy")
  run check("a/*/test", "a/foo/test", true, "Failed test for a/foo/test")
  run check("a/*/test", "a/foo/bar/test", false, "Failed test for a/foo/bar/test")
  run check("a/**/test", "a/foo/test", true, "Failed test for a/foo/test")
  run check("a/**/test", "a/foo/bar/test", true, "Failed test for a/foo/bar/test")
  run check("a/**/b/c", "a/foo/bar/b/c", true, "Failed test for a/foo/bar/b/c")
  run check("a\\*b", "a*b", true, "Failed test for a*b")
  run check("a\\*b", "axb", false, "Failed test for axb")
  run check("[abc]", "a", true, "Failed test for a")
  run check("[abc]", "b", true, "Failed test for b")
  run check("[abc]", "c", true, "Failed test for c")
  run check("[abc]", "d", false, "Failed test for d")
  run check("x[abc]x", "xax", true, "Failed test for xax")
  run check("x[abc]x", "xbx", true, "Failed test for xbx")
  run check("x[abc]x", "xcx", true, "Failed test for xcx")
  run check("x[abc]x", "xdx", false, "Failed test for xdx")
  run check("x[abc]x", "xay", false, "Failed test for xay")
  run check("[?]", "?", true, "Failed test for ?")
}

effect fn upstreamMatch1() -> ()
  ! OutOfMemoryError | Failed {
  let mut allocator = Allocator.systemAllocatorProvider()
  run cases1() |> Effect.provideMut(&mut allocator)
}

effect fn cases2() -> ()
  ! OutOfMemoryError | Failed
  ? &mut Allocator {
  run check("[?]", "a", false, "Failed test for a")
  run check("[*]", "*", true, "Failed test for *")
  run check("[*]", "a", false, "Failed test for a")
  run check("[a-cx]", "a", true, "Failed test for a")
  run check("[a-cx]", "b", true, "Failed test for b")
  run check("[a-cx]", "c", true, "Failed test for c")
  run check("[a-cx]", "d", false, "Failed test for d")
  run check("[a-cx]", "x", true, "Failed test for x")
  run check("[^abc]", "a", false, "Failed test for a")
  run check("[^abc]", "b", false, "Failed test for b")
  run check("[^abc]", "c", false, "Failed test for c")
  run check("[^abc]", "d", true, "Failed test for d")
  run check("[!abc]", "a", false, "Failed test for a")
  run check("[!abc]", "b", false, "Failed test for b")
  run check("[!abc]", "c", false, "Failed test for c")
  run check("[!abc]", "d", true, "Failed test for d")
  run check("[\\!]", "!", true, "Failed test for !")
  run check("a*b*[cy]*d*e*", "axbxcxdxexxx", true, "Failed test for axbxcxdxexxx")
  run check("a*b*[cy]*d*e*", "axbxyxdxexxx", true, "Failed test for axbxyxdxexxx")
  run check("a*b*[cy]*d*e*", "axbxxxyxdxexxx", true, "Failed test for axbxxxyxdxexxx")
  run check("test.{jpg,png}", "test.jpg", true, "Failed test for test.jpg")
  run check("test.{jpg,png}", "test.png", true, "Failed test for test.png")
  run check("test.{j*g,p*g}", "test.jpg", true, "Failed test for test.jpg")
  run check("test.{j*g,p*g}", "test.jpxxxg", true, "Failed test for test.jpxxxg")
  run check("test.{j*g,p*g}", "test.jxg", true, "Failed test for test.jxg")
  run check("test.{j*g,p*g}", "test.jnt", false, "Failed test for test.jnt")
  run check("test.{j*g,j*c}", "test.jnc", true, "Failed test for test.jnc")
  run check("test.{jpg,p*g}", "test.png", true, "Failed test for test.png")
  run check("test.{jpg,p*g}", "test.pxg", true, "Failed test for test.pxg")
  run check("test.{jpg,p*g}", "test.pnt", false, "Failed test for test.pnt")
  run check("test.{jpeg,png}", "test.jpeg", true, "Failed test for test.jpeg")
  run check("test.{jpeg,png}", "test.jpg", false, "Failed test for test.jpg")
  run check("test.{jpeg,png}", "test.png", true, "Failed test for test.png")
  run check("test.{jp\\,g,png}", "test.jp,g", true, "Failed test for test.jp,g")
  run check("test.{jp\\,g,png}", "test.jxg", false, "Failed test for test.jxg")
  run check("test/{foo,bar}/baz", "test/foo/baz", true, "Failed test for test/foo/baz")
  run check("test/{foo,bar}/baz", "test/bar/baz", true, "Failed test for test/bar/baz")
  run check("test/{foo,bar}/baz", "test/baz/baz", false, "Failed test for test/baz/baz")
  run check("test/{foo*,bar*}/baz", "test/foooooo/baz", true, "Failed test for test/foooooo/baz")
  run check("test/{foo*,bar*}/baz", "test/barrrrr/baz", true, "Failed test for test/barrrrr/baz")
  run check("test/{*foo,*bar}/baz", "test/xxxxfoo/baz", true, "Failed test for test/xxxxfoo/baz")
  run check("test/{*foo,*bar}/baz", "test/xxxxbar/baz", true, "Failed test for test/xxxxbar/baz")
  run check("test/{foo/**,bar}/baz", "test/bar/baz", true, "Failed test for test/bar/baz")
  run check(
    "test/{foo/**,bar}/baz",
    "test/bar/test/baz",
    false,
    "Failed test for test/bar/test/baz",
  )
  run check(
    "*.txt",
    "some/big/path/to/the/needle.txt",
    false,
    "Failed test for some/big/path/to/the/needle.txt",
  )
  run check("a/{a{a,b},b}", "a/aa", true, "Failed test for a/aa")
  run check("a/{a{a,b},b}", "a/ab", true, "Failed test for a/ab")
  run check("a/{a{a,b},b}", "a/ac", false, "Failed test for a/ac")
  run check("a/{a{a,b},b}", "a/b", true, "Failed test for a/b")
  run check("a/{a{a,b},b}", "a/c", false, "Failed test for a/c")
}

effect fn upstreamMatch2() -> ()
  ! OutOfMemoryError | Failed {
  let mut allocator = Allocator.systemAllocatorProvider()
  run cases2() |> Effect.provideMut(&mut allocator)
}

