// A mutable reflected projection writes each field in place through the owner's mutable borrow.
import silk.reflect { Reflect }

struct Counters {
  pub hits: i32,
  pub misses: i32,
}

fn bump<Owner>(owner: &mut Owner, amount: i32) -> () {
  static for field in Reflect.fields<Owner>() {
    let place = Reflect.borrowFieldMut(&mut owner.*, field)
    place.* = place.* + amount
  }
  return ()
}

pub fn main() -> i32 {
  let mut counters = Counters { hits: 10, misses: 12 }
  bump<Counters>(&mut counters, 10)
  return counters.hits + counters.misses
}
