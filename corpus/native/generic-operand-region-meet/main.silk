import silk.core.order { Order, Ordering }

// Each parameter below has its own elided lifetime. The first operand of a call fixes `T` (or the
// interface's provider) with its region, and a later operand with another region meets it: both
// reach the type whose region is the meet of the two (LIFE-002).
fn same<T>(left: T, right: T) -> bool { return true }
fn refs<T>(left: &T, right: &T) -> bool { return true }
fn first<T>(left: T, right: T) -> T { return move left }

struct Pair<'a> { text: &'a [u8] }

fn byValue(left: string, right: string) -> bool { return same(left, right) }
fn byReference(left: string, right: string) -> bool { return refs(&left, &right) }
fn pairs(left: Pair, right: Pair) -> bool { return refs(&left, &right) }
fn ordered(left: string, right: string) -> bool { return Order.compare(&left, &right) == Ordering.Less }
fn shared<'a>(left: string<'a>, right: string<'a>) -> string<'a> { return first(left, right) }

// An operand the operation does not take as `Self` leaves the provider's region alone.
interface Keep {
  fn keep<'a>(self: &'a Self, other: string) -> &'a Self
}
impl Keep for string {
  fn keep<'a>(self: &'a Self, other: string) -> &'a Self { return self }
}
fn kept<'t, 's>(table: &'t string<'s>, other: string) -> &'t string<'s> { return Keep.keep(table, other) }

pub fn main() -> i32 {
  let apple = "apple"
  let banana = "banana"
  if !byValue(apple, banana) || !byReference(apple, banana) { return 1 }
  if !pairs(Pair {text: b"a"}, Pair {text: b"b"}) { return 2 }
  if !ordered(apple, banana) || ordered(banana, apple) { return 3 }
  if shared(apple, banana) != "apple" { return 4 }
  if kept(&apple, banana).* != "apple" { return 5 }
  return 42
}
