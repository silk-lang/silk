fn equal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut index: usize = 0
  while index < left.length {
    if left[index] != right[index] { return false }
    index = index + 1
  }
  return true
}

// Hashes `message` in pieces of `step` bytes through `Digest`, copies the state halfway, feeds
// the rest to both, and checks both against `expected`.
fn check<H: Digest>(message: &[u8], expected: &[u8], step: usize) -> bool {
  let mut state: H = Digest.make()
  let mut offset: usize = 0
  let half = message.length / 2
  let mut copied = false
  let mut twin: H = Digest.make()
  while offset < message.length {
    let mut length = step
    if message.length - offset < length { length = message.length - offset }
    state.update(Slice.view<u8>(message, offset, length))
    if copied { twin.update(Slice.view<u8>(message, offset, length)) }
    offset = offset + length
    if !copied && offset >= half {
      twin = state.copy()
      copied = true
    }
  }
  if !copied { twin = state.copy() }
  if offset < message.length { return false }
  if state.digestLength() != expected.length { return false }
  let mut digest: [u8; 64] = [0; 64]
  state.finishInto(&mut digest)
  if !equal(Slice.view<u8>(&digest, 0, expected.length), expected) { return false }
  let mut again: [u8; 64] = [0; 64]
  twin.finishInto(&mut again)
  return equal(Slice.view<u8>(&again, 0, expected.length), expected)
}

