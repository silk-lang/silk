fn shake1280() -> bool {
  let message: [u8; 0] = []
  let expected: [u8; 0] = []
  let mut state = Shake128.make()
  let mut offset: usize = 0
  while offset < message.length {
    let mut length: usize = 1
    if message.length - offset < length { length = message.length - offset }
    state.update(Slice.view<u8>(&message, offset, length))
    offset = offset + length
  }
  let twin = state.copy()
