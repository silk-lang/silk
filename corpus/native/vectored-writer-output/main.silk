import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.io.buffered_input { BufferError }
import silk.io.buffered_output { BufferedOutput }
import silk.core.effect { Effect }
import silk.io.writer_native { StderrWriter, StdoutWriter }
import silk.num.usize
import silk.io.writer { Writer, WriterError }

// Records each call, so the test can see which operation BufferedOutput used.
struct RecordingWriter {
  bytes: [u8; 32],
  length: usize,
  writes: usize,
  vectored: usize,
  parts: usize,
}

impl RecordingWriter {
  fn keep(self: &mut Self, val: &[u8]) -> () {
    let mut index = usize.ZERO
    while index < val.length {
      self.bytes[self.length] = val[index]
      self.length = self.length + usize.ONE
      index = index + usize.ONE
    }
    return ()
  }
}

impl Writer for RecordingWriter {
  effect fn writeAll(self: &mut Self, val: &[u8]) -> () ! WriterError ? &mut Writer {
    self.writes = self.writes + usize.ONE
    self.keep(val)
    return ()
  }

  effect fn writeVectored(self: &mut Self, vals: &[&[u8]]) -> () ! WriterError ? &mut Writer {
    self.vectored = self.vectored + usize.ONE
    self.parts = self.parts + vals.length
    let mut index = usize.ZERO
    while index < vals.length {
      self.keep(vals[index])
      index = index + usize.ONE
    }
    return ()
  }

  effect fn flush(self: &mut Self) -> () ! WriterError ? &mut Writer {
    return ()
  }
}

fn same(actual: &[u8], length: usize, expected: &[u8]) -> bool {
  if length != expected.length { return false }
  let mut index = usize.ZERO
  while index < length {
    if actual[index] != expected[index] { return false }
    index = index + usize.ONE
  }
  return true
}

effect fn buffered() -> i32 ! BufferError | OutOfMemoryError {
  let mut recorder = RecordingWriter { bytes: [0; 32], length: 0, writes: 0, vectored: 0, parts: 0 }
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut output = run BufferedOutput.make(4) |> Effect.provideMut<Allocator>(&mut allocator)
  // Two bytes fit and are copied.
  run BufferedOutput.writeAllWriter(&mut output, b"ab") |> Effect.provideMut<Writer>(&mut recorder)
  if recorder.writes + recorder.vectored != 0 { return 11 }
  // Four bytes do not fit in the two free bytes: the pending bytes and the input go out together.
  run BufferedOutput.writeAllWriter(&mut output, b"cdef") |> Effect.provideMut<Writer>(&mut recorder)
  if recorder.vectored != 1 || recorder.parts != 2 || recorder.writes != 0 { return 12 }
  if BufferedOutput.pending(&output) != 0 { return 13 }
  // Into an empty buffer, a long input is one plain write.
  run BufferedOutput.writeAllWriter(&mut output, b"ghijk") |> Effect.provideMut<Writer>(&mut recorder)
  if recorder.writes != 1 || recorder.vectored != 1 { return 14 }
  run BufferedOutput.writeAllWriter(&mut output, b"l") |> Effect.provideMut<Writer>(&mut recorder)
  run BufferedOutput.flushWriter(&mut output) |> Effect.provideMut<Writer>(&mut recorder)
  if recorder.writes != 2 { return 15 }
  if !same(&recorder.bytes, recorder.length, b"abcdefghijkl") { return 16 }
  return 0
}

pub effect fn main() -> i32 ! WriterError | BufferError | OutOfMemoryError {
  let code = run buffered()
  if code != 0 { return code }

  let mut out = StdoutWriter.make()
  let words: [&[u8]; 4] = [b"one ", b"", b"two ", b"three\n"]
  run Writer.writeVectored(&words) |> Effect.provideMut<Writer>(&mut out)
  // More parts than one system call takes.
  let letters: [&[u8]; 11] = [b"a", b"b", b"c", b"d", b"e", b"f", b"g", b"h", b"i", b"j", b"\n"]
  run Writer.writeVectored(&letters) |> Effect.provideMut<Writer>(&mut out)
  let none: [&[u8]; 0] = []
  run Writer.writeVectored(&none) |> Effect.provideMut<Writer>(&mut out)

  let mut err = StderrWriter.make()
  let line: [&[u8]; 2] = [b"plain ", b"vectored\n"]
  run Writer.writeVectored(&line) |> Effect.provideMut<Writer>(&mut err)

  let mut buffer: [u8; 8] = [0; 8]
  let mut locked = StderrWriter.lock(&mut buffer)
  let small: [&[u8]; 2] = [b"fits", b" "]
  run Writer.writeVectored(&small) |> Effect.provideMut<Writer>(&mut locked)
  let large: [&[u8]; 2] = [b"does not fit", b" in the buffer\n"]
  run Writer.writeVectored(&large) |> Effect.provideMut<Writer>(&mut locked)
  run Writer.writeVectored(&small) |> Effect.provideMut<Writer>(&mut locked)
  drop locked
  run Writer.writeString("\n") |> Effect.provideMut<Writer>(&mut err)
  return 0
}
