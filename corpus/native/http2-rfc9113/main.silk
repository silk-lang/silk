import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.http.hpack { Encoder, Field }
import silk.http.http2 { Connection, Event, Limits, Role }
import silk.http.http2_frame { FrameHeader, ProtocolError, read32, write32 }
import silk.http.http2_headers { Section, validate }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.num.u32
import silk.num.usize

effect fn malformed(fields: &[Field], section: Section) -> bool {
  let result = run Effect.result(validate(fields, move section, 1))
  return match move result {
    Result.Success { value } => false
    Result.Failure { error } => error.stream == 1 && error.code == 1
  }
}

effect fn client() -> Connection
  ! ProtocolError | OutOfMemoryError
  ? &mut Allocator {
  let mut conn = run Connection.make(Role.Client, Limits.defaults())
  let initial = Connection.output(&conn).length
  run Connection.consumeOutput(&mut conn, initial)

  // RFC 9113 permits a server to send SETTINGS_ENABLE_PUSH = 0.
  let ready = run Connection.receive(
    &mut conn,
    b"\x00\x00\x06\x04\x00\x00\x00\x00\x00\x00\x02\x00\x00\x00\x00"
  )
  let pending = Connection.output(&conn).length
  run Connection.consumeOutput(&mut conn, pending)
  return move conn
}

effect fn test() -> i32
  ! ProtocolError | OutOfMemoryError
  ? &mut Allocator {
  let normalized = [
    Field { name: b":method", value: b"GET", sensitive: false },
    Field { name: b":scheme", value: b"https", sensitive: false },
    Field { name: b":path", value: b"/", sensitive: false },
    Field { name: b":authority", value: b"EXAMPLE.com:443", sensitive: false },
    Field { name: b"host", value: b"example.com", sensitive: false },
    Field { name: b"te", value: b"Trailers", sensitive: false }
  ]
  drop run validate(&normalized, Section.Request, 1)
  let missingPort = [
    Field { name: b":method", value: b"CONNECT", sensitive: false },
    Field { name: b":authority", value: b"example.com", sensitive: false }
  ]
  let noPort = run malformed(&missingPort, Section.Request)
  if !noPort {
    return 1
  }
  let responseTe = [
    Field { name: b":status", value: b"200", sensitive: false },
    Field { name: b"te", value: b"trailers", sensitive: false }
  ]
  let teRejected = run malformed(&responseTe, Section.Response)
  if !teRejected {
    return 2
  }
  let invalidControl = [
    Field { name: b":status", value: b"200", sensitive: false },
    Field { name: b"x-control", value: b"a\x01b", sensitive: false }
  ]
  let controlRejected = run malformed(&invalidControl, Section.Response)
  if !controlRejected {
    return 3
  }
  let mut conn = run client()
  let connect = [
    Field { name: b":method", value: b"CONNECT", sensitive: false },
    Field { name: b":authority", value: b"example.com:443", sensitive: false }
  ]
  let id = run Connection.open(&mut conn, &connect, false)
  if id != 1 {
    return 4
  }
  drop run Connection.receive(&mut conn, b"\x00\x00\x01\x01\x04\x00\x00\x00\x01\x88")
  let sent = run Connection.sendData(&mut conn, id, b"tunnel", false)
  if sent != 6 {
    return 5
  }

  // Successful CONNECT permits DATA and stream management, but no trailing field sections.
  let invalidTrailer = run Connection.receive(&mut conn, b"\x00\x00\x00\x01\x05\x00\x00\x00\x01")
  match move invalidTrailer.event {
    Event.StreamError { stream, code } => {
      if stream != 1 || code != 1 {
        return 6
      }
    }
    _ => {
      return 7
    }
  }
  if Connection.failed(&conn) {
    return 8
  }
  let get = [
    Field { name: b":method", value: b"GET", sensitive: false },
    Field { name: b":scheme", value: b"https", sensitive: false },
    Field { name: b":authority", value: b"example.com", sensitive: false },
    Field { name: b":path", value: b"/", sensitive: false }
  ]
  let cancelled = run Connection.open(&mut conn, &get, true)
  run Connection.reset(&mut conn, cancelled, 8)
  let raced = run Connection.receive(&mut conn, b"\x00\x00\x01\x01\x04\x00\x00\x00\x03\x88")
  match move raced.event {
    Event.None => {}
    _ => {
      return 9
    }
  }
  let lateData = run Connection.receive(&mut conn, b"\x00\x00\x01\x00\x01\x00\x00\x00\x03x")
  match move lateData.event {
    Event.None => {}
    _ => {
      return 10
    }
  }
  let fourth = run Connection.open(&mut conn, &get, true)
  if fourth != 5 {
    return 11
  }

  // A server cannot enable client push.
  let illegal = run Effect.result(
    Connection.receive(&mut conn, b"\x00\x00\x06\x04\x00\x00\x00\x00\x00\x00\x02\x00\x00\x00\x01")
  )
  match move illegal {
    Result.Success { value } => {
      return 12
    }
    Result.Failure { error } => match move error {
      ProtocolError failure => {
        if failure.code != 1 || failure.stream != 0 {
          return 13
        }
      }
      OutOfMemoryError failure => {
        fail move failure
      }
    }
  }

  // GOAWAY's last-stream identifier must never increase after shutdown starts.
  let mut server = run Connection.make(Role.Server, Limits.defaults())
  drop run Connection.receive(
    &mut server,
    b"PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n\x00\x00\x00\x04\x00\x00\x00\x00\x00"
  )
  let output = Connection.output(&server).length
  run Connection.consumeOutput(&mut server, output)
  run Connection.shutdown(&mut server, 0, b"")
  let first = Connection.output(&server)
  if read32(first, 9) != 0 {
    return 14
  }
  let count = first.length
  drop first
  run Connection.consumeOutput(&mut server, count)
  drop run Connection.receive(&mut server, b"\x00\x00\x03\x01\x05\x00\x00\x00\x01\x82\x86\x84")
  let reset = Connection.output(&server).length
  run Connection.consumeOutput(&mut server, reset)
  run Connection.shutdown(&mut server, 0, b"")
  if read32(Connection.output(&server), 9) != 0 {
    return 15
  }

  // Before SETTINGS acknowledgment, the peer can still use the default receive window.
  let mut limits = Limits.defaults()
  limits.windowBytes = 0
  let mut delayed = run Connection.make(Role.Server, limits)
  drop run Connection.receive(
    &mut delayed,
    b"PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n\x00\x00\x00\x04\x00\x00\x00\x00\x00"
  )
  drop run Connection.receive(&mut delayed, b"\x00\x00\x03\x01\x04\x00\x00\x00\x01\x82\x86\x84")
  let earlyData = run Connection.receive(&mut delayed, b"\x00\x00\x01\x00\x00\x00\x00\x00\x01x")
  match move earlyData.event {
    Event.Data { stream, bytes, endStream } => {}
    _ => {
      return 16
    }
  }
  drop run Connection.receive(&mut delayed, b"\x00\x00\x00\x04\x01\x00\x00\x00\x00")

  // An empty END_STREAM remains legal with a negative window after the SETTINGS reduction.
  let emptyEnd = run Connection.receive(&mut delayed, b"\x00\x00\x00\x00\x01\x00\x00\x00\x01")
  match move emptyEnd.event {
    Event.Data { stream, bytes, endStream } => {
      if !endStream {
        return 17
      }
    }
    _ => {
      return 18
    }
  }
  run Connection.release(&mut delayed, 1, 1)
  return run resetPush()
}

effect fn promise(
  conn: &mut Connection,
  encoder: &mut Encoder,
  promised: u32,
  fields: &[Field]
) -> Event
  ! ProtocolError | OutOfMemoryError
  ? &mut Allocator {
  let block = run Encoder.encode(&mut encoder.*, fields)
  let mut payload = Bytes.make()
  run write32(&mut payload, promised)
  run Bytes.append(&mut payload, Bytes.asSlice(&block))
  let header = FrameHeader { length: Bytes.length(&payload), kind: 5, flags: 4, stream: 1 }
  let mut wire = Bytes.make()
  run FrameHeader.write(&header, &mut wire, Bytes.asSlice(&payload))
  let received = run Connection.receive(&mut conn.*, Bytes.asSlice(&wire))
  return move received.event
}

effect fn resetPush() -> i32
  ! ProtocolError | OutOfMemoryError
  ? &mut Allocator {
  let mut limits = Limits.defaults()
  limits.push = true
  let mut conn = run Connection.make(Role.Client, limits)
  drop run Connection.receive(&mut conn, b"\x00\x00\x00\x04\x00\x00\x00\x00\x00")
  let get = [
    Field { name: b":method", value: b"GET", sensitive: false },
    Field { name: b":scheme", value: b"https", sensitive: false },
    Field { name: b":authority", value: b"example.com", sensitive: false },
    Field { name: b":path", value: b"/", sensitive: false }
  ]
  let id = run Connection.open(&mut conn, &get, true)
  run Connection.reset(&mut conn, id, 8)

  // An in-flight promise still reserves its stream after its parent was locally reset.
  let mut encoder = Encoder.make(4096)
  let pushed = run promise(&mut conn, &mut encoder, 2, &get)
  match move pushed {
    Event.Push { stream, promised, fields } => {
      if stream != 1 || promised != 2 {
        return 19
      }
    }
    _ => {
      return 20
    }
  }
  run Connection.reset(&mut conn, 2, 8)
  let late = run Connection.receive(&mut conn, b"\x00\x00\x01\x00\x01\x00\x00\x00\x02x")
  match move late.event {
    Event.None => {}
    _ => {
      return 21
    }
  }

  // Reject a foreign authority on the promised stream, then absorb its in-flight response.
  let foreign = [
    Field { name: b":method", value: b"GET", sensitive: false },
    Field { name: b":scheme", value: b"https", sensitive: false },
    Field { name: b":authority", value: b"other.example", sensitive: false },
    Field { name: b":path", value: b"/", sensitive: false }
  ]
  let rejected = run promise(&mut conn, &mut encoder, 4, &foreign)
  match move rejected {
    Event.StreamError { stream, code } => {
      if stream != 4 || code != 1 {
        return 22
      }
    }
    _ => {
      return 23
    }
  }
  let response = run Connection.receive(&mut conn, b"\x00\x00\x01\x01\x04\x00\x00\x00\x04\x88")
  match move response.event {
    Event.None => {}
    _ => {
      return 24
    }
  }
  let next = run Connection.open(&mut conn, &get, true)
  if next != 3 || Connection.failed(&conn) {
    return 25
  }
  drop run Connection.receive(&mut conn, b"\x00\x00\x01\x01\x05\x00\x00\x00\x03\x88")
  let closed = run Effect.result(
    Connection.receive(&mut conn, b"\x00\x00\x01\x00\x00\x00\x00\x00\x03x")
  )
  match move closed {
    Result.Success { value } => {
      return 26
    }
    Result.Failure { error } => match move error {
      ProtocolError failure => {
        if failure.code != 5 || failure.stream != 0 {
          return 27
        }
      }
      OutOfMemoryError failure => {
        fail move failure
      }
    }
  }
  let emptyPath = [
    Field { name: b":method", value: b"GET", sensitive: false },
    Field { name: b":scheme", value: b"custom", sensitive: false },
    Field { name: b":path", value: b"", sensitive: false }
  ]
  drop run validate(&emptyPath, Section.Request, 1)
  let duplicateEmpty = [
    Field { name: b":method", value: b"GET", sensitive: false },
    Field { name: b":scheme", value: b"custom", sensitive: false },
    Field { name: b":path", value: b"", sensitive: false },
    Field { name: b":path", value: b"/", sensitive: false }
  ]
  let duplicate = run malformed(&duplicateEmpty, Section.Request)
  if !duplicate {
    return 28
  }
  return 0
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  return 99
}

pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(test(), failed) |> Effect.provideMut<Allocator>(&mut allocator)
}
