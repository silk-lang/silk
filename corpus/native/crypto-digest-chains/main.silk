import silk.crypto.md5 {Md5}
import silk.crypto.sha1 {Sha1}
import silk.crypto.sha2 {Sha224, Sha256, Sha384, Sha512, Sha512_224, Sha512_256}
import silk.crypto.sha3 {Sha3_224, Sha3_256, Sha3_384, Sha3_512, Shake128, Shake256}
import silk.crypto.blake2b {Blake2b512}
import silk.crypto.blake2s {Blake2s256}
import silk.crypto.sm3 {Sm3}
import silk.crypto.ripemd160 {Ripemd160}
import silk.crypto.md5_sha1 {Md5Sha1}
import silk.crypto.digest {Digest}
import silk.collections.slice {Slice}
import silk.num.u8
import silk.num.usize

// Every message length from 0 to 699 bytes, split into a first piece of `length % 61`
// bytes and then pieces of 200 bytes, so both the buffered path and the whole-block path run at
// each block boundary. Each digest goes into an outer hash of the same kind, whose first 16 bytes
// must match Python's hashlib.
fn pattern() -> [u8; 700] {
  let mut bytes: [u8; 700] = [0; 700]
  let mut i: usize = 0
  while i < 700 {
    bytes[i] = usize.toU8((i * 131 + 7) % 256)
    i = i + 1
  }
  return bytes
}

fn same(left: &[u8], right: &[u8]) -> bool {
  let mut index: usize = 0
  while index < right.length {
    if left[index] != right[index] { return false }
    index = index + 1
  }
  return true
}

fn chain<H: Digest>(expected: &[u8]) -> bool {
  let bytes = pattern()
  let mut outer: H = Digest.make()
  let mut length: usize = 0
  while length < 700 {
    let mut inner: H = Digest.make()
    let mut offset = length % 61
    inner.update(Slice.view<u8>(&bytes, 0, offset))
    while offset < length {
      let mut take: usize = 200
      if length - offset < take { take = length - offset }
      inner.update(Slice.view<u8>(&bytes, offset, take))
      offset = offset + take
    }
    let mut digest: [u8; 64] = [0; 64]
    let size = inner.digestLength()
    inner.finishInto(&mut digest)
    outer.update(Slice.view<u8>(&digest, 0, size))
    length = length + 1
  }
  let mut result: [u8; 64] = [0; 64]
  outer.finishInto(&mut result)
  return same(&result, expected)
}

fn chainShake128(expected: &[u8]) -> bool {
  let bytes = pattern()
  let mut outer = Shake128.make()
  let mut length: usize = 0
  while length < 700 {
    let mut inner = Shake128.make()
    let mut offset = length % 61
    inner.update(Slice.view<u8>(&bytes, 0, offset))
    while offset < length {
      let mut take: usize = 200
      if length - offset < take { take = length - offset }
      inner.update(Slice.view<u8>(&bytes, offset, take))
      offset = offset + take
    }
    let mut digest: [u8; 300] = [0; 300]
    let size = length % 300
    inner.finishInto(Slice.viewMut<u8>(&mut digest, 0, size))
    outer.update(Slice.view<u8>(&digest, 0, size))
    length = length + 1
  }
  let mut result: [u8; 16] = [0; 16]
  outer.finishInto(&mut result)
  return same(&result, expected)
}

fn chainShake256(expected: &[u8]) -> bool {
  let bytes = pattern()
  let mut outer = Shake256.make()
  let mut length: usize = 0
  while length < 700 {
    let mut inner = Shake256.make()
    let mut offset = length % 61
    inner.update(Slice.view<u8>(&bytes, 0, offset))
    while offset < length {
      let mut take: usize = 200
      if length - offset < take { take = length - offset }
      inner.update(Slice.view<u8>(&bytes, offset, take))
      offset = offset + take
    }
    let mut digest: [u8; 300] = [0; 300]
    let size = length % 300
    inner.finishInto(Slice.viewMut<u8>(&mut digest, 0, size))
    outer.update(Slice.view<u8>(&digest, 0, size))
    length = length + 1
  }
  let mut result: [u8; 16] = [0; 16]
  outer.finishInto(&mut result)
  return same(&result, expected)
}

pub fn main() -> i32 {
  if !chain<Md5>(b"\xb9\x70\x96\x59\xd1\x08\x0c\x08\xfb\x29\xd6\x17\x7d\x62\x09\x46") { return 1 }
  if !chain<Sha1>(b"\xde\x68\x5f\xfc\x9a\xbd\xad\x93\xe4\xc5\x36\xcd\x39\x4d\x4a\xbe") { return 2 }
  if !chain<Sha224>(b"\xa7\x56\x36\x6a\x0d\x4b\x1e\x40\x7e\xc7\x0b\x7e\x75\xf9\xfc\x0d") { return 3 }
  if !chain<Sha256>(b"\xe9\xcc\xba\xce\xcb\xb4\x93\xa8\xd4\x29\xc8\x2f\xd7\xf0\x9e\x05") { return 4 }
  if !chain<Sha384>(b"\x2b\x2c\xa3\x89\x3a\xc4\x7c\x28\x02\x3f\xde\x16\x31\x4d\xf9\x20") { return 5 }
  if !chain<Sha512>(b"\x38\xd0\xff\xb7\x85\x62\x47\x2b\xc9\x4b\x3a\xba\x9d\xa7\xa9\xae") { return 6 }
  if !chain<Sha512_224>(b"\x41\x8e\x31\x19\x36\x2c\xf3\xe3\xc8\x2e\x96\x74\x35\x99\x66\xd5") { return 7 }
  if !chain<Sha512_256>(b"\x39\x91\x42\x7e\xa6\x10\x59\x01\x6d\xac\x25\x1e\x18\x71\x8e\xf1") { return 8 }
  if !chain<Sha3_224>(b"\x6c\x2a\xef\x0b\x74\x78\xde\x0a\x09\x00\x3e\xb8\xf6\x8f\xc0\x56") { return 9 }
  if !chain<Sha3_256>(b"\x36\x0d\xb9\xef\x8c\xfb\xeb\xbf\x7c\xd0\xd5\x68\x91\x37\x28\xe6") { return 10 }
  if !chain<Sha3_384>(b"\x91\x31\x9d\xc7\xde\x4d\xa2\x62\xf1\x9c\x50\xd9\x82\xe1\x68\x6a") { return 11 }
  if !chain<Sha3_512>(b"\xce\xb1\xb7\xcf\x3b\x22\xff\x69\x12\xee\x7e\x4f\x75\x71\x0c\x29") { return 12 }
  if !chain<Blake2b512>(b"\x0a\x7f\xf7\x63\xfa\xab\x2d\x15\x81\xa7\x69\xac\xef\x71\xae\xb3") { return 13 }
  if !chain<Blake2s256>(b"\x1e\xb7\xc8\xe9\xeb\x1b\x76\xc0\x3b\x1e\x40\xe2\x28\x51\x52\x97") { return 14 }
  if !chain<Sm3>(b"\x9c\xda\xdf\x53\x84\x14\xc4\x53\x6c\xcf\x99\xc3\x4b\xcb\xd3\x78") { return 15 }
  if !chain<Ripemd160>(b"\xd5\xa7\xa9\x9a\x9a\x09\xfb\x81\xb0\x86\x06\x46\x68\x5d\xb6\xce") { return 16 }
  if !chain<Md5Sha1>(b"\x5d\x8c\x11\x3f\xd5\x0c\xca\x70\x97\x91\xd6\xb4\x7f\x57\xb1\x9f") { return 17 }
  if !chainShake128(b"\x53\x9c\x4a\x52\xef\xe3\x41\x66\x6a\xfd\x74\x68\x8d\x83\x14\x01") { return 18 }
  if !chainShake256(b"\xc9\x1a\x39\x2c\x1b\x22\x25\x16\x60\xb0\x08\x34\x64\x0f\xce\x97") { return 19 }
  return 42
}
