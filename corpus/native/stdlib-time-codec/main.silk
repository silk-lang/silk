// Reads and writes the silk.time types with silk.schema: as fields of a declared type in JSON,
// through the TimeText codec directly, and an Instant as a Unix time through a wrapper type.
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.schema.codec { Codec }
import silk.schema.issue { Issue, IssueReason, SchemaError }
import silk.schema.json { SchemaJson }
import silk.schema.schema { Schema, SchemaReader, SchemaWriter, Schemas }
import silk.text.string { String }
import silk.time.codec { TimeText, UnixMilliseconds, UnixSeconds }
import silk.time.instant { Instant }
import silk.time.offset { UtcOffset }
import silk.time.period { Period }
import silk.time.plain_date { PlainDate }
import silk.time.plain_date_time { PlainDateTime }
import silk.time.plain_month_day { PlainMonthDay }
import silk.time.plain_time { PlainTime }
import silk.time.plain_year_month { PlainYearMonth }
import silk.num.usize

struct Capture {
  bytes: [u8; 512],
  length: usize,
}

impl Writer for Capture {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> () ! WriterError ? &mut Writer {
    let mut index: usize = 0
    while index < value.length {
      self.bytes[self.length] = value[index]
      self.length = self.length + 1
      index = index + 1
    }
    return ()
  }

  effect fn flush(self: &mut Self) -> () ! WriterError ? &mut Writer {
    return ()
  }
}

fn holds(capture: &Capture, expected: &[u8]) -> bool {
  if capture.length != expected.length { return false }
  let mut index: usize = 0
  while index < expected.length {
    if capture.bytes[index] != expected[index] { return false }
    index = index + 1
  }
  return true
}

/// An instant written as a count of seconds.
struct Seen {
  pub at: Instant,
}

impl Schema for Seen {
  effect fn read(reader: &mut any SchemaReader) -> Seen ! Issue | OutOfMemoryError ? &mut Allocator {
    return Seen {at: run Schemas.readVia<Instant, i64, UnixSeconds>(&UnixSeconds {}, &mut reader.*)}
  }

  effect fn write(self: &Self, writer: &mut any SchemaWriter)
    -> () ! Issue | WriterError | OutOfMemoryError ? &mut Writer | &mut Allocator {
    return run Schemas.writeVia<Instant, i64, UnixSeconds>(&UnixSeconds {}, &self.at, &mut writer.*)
  }
}

struct Event {
  pub created: Instant,
  pub day: PlainDate,
  pub opens: PlainTime,
  pub local: PlainDateTime,
  pub billing: PlainYearMonth,
  pub birthday: PlainMonthDay,
  pub notice: Period,
  pub offset: UtcOffset,
  pub seen: Seen,
  pub ends: Option<PlainDate>,
}

impl Schema for Event {}

effect fn decodeEvent(text: &[u8]) -> Event ! SchemaError | OutOfMemoryError ? &mut Allocator {
  return run SchemaJson.decode<Event>(text)
}

effect fn failure(text: &[u8]) -> Option<SchemaError> ! OutOfMemoryError ? &mut Allocator {
  let result = run Effect.result(decodeEvent(text))
  return match move result {
    Result<Event, SchemaError | OutOfMemoryError>.Success {..} => Option<SchemaError>.none()
    Result<Event, SchemaError | OutOfMemoryError>.Failure {error} => match move error {
      SchemaError found => Option<SchemaError>.some(move found)
      OutOfMemoryError {} => { fail OutOfMemoryError {} }
    }
  }
}

fn failedAt(found: &Option<SchemaError>, path: string, reason: IssueReason) -> bool {
  return match &found.* {
    Option<SchemaError>.Some {value} => value.path.matchesText(path) && value.issue.reason == reason
    Option<SchemaError>.None => false
  }
}

effect fn encodes(event: &Event, capture: &mut Capture) -> bool ! OutOfMemoryError ? &mut Allocator {
  let encoded = run Effect.result(SchemaJson.encode<Event>(event)) |> Effect.provideMut<Writer>(&mut capture.*)
  return match move encoded {
    Result<(), SchemaError | WriterError | OutOfMemoryError>.Success {..} => true
    Result<(), SchemaError | WriterError | OutOfMemoryError>.Failure {..} => false
  }
}

effect fn milliseconds(count: i64) -> Option<Instant> ! OutOfMemoryError ? &mut Allocator {
  return match move run Effect.result(Codec.decode(&UnixMilliseconds {}, count)) {
    Result<Instant, Issue | OutOfMemoryError>.Success {value} => Option<Instant>.some(value)
    Result<Instant, Issue | OutOfMemoryError>.Failure {error} => match move error {
      Issue {..} => Option<Instant>.none()
      OutOfMemoryError {} => { fail OutOfMemoryError {} }
    }
  }
}

effect fn offsetText(text: string) -> Option<String> ! OutOfMemoryError ? &mut Allocator {
  let codec = TimeText<UtcOffset>.make()
  let input = run String.copy(text)
  return match move run Effect.result(Codec.decode(&codec, move input)) {
    Result<UtcOffset, Issue | OutOfMemoryError>.Success {value} => Option<String>.some(run Codec.encode(&codec, &value))
    Result<UtcOffset, Issue | OutOfMemoryError>.Failure {error} => match move error {
      Issue {..} => Option<String>.none()
      OutOfMemoryError {} => { fail OutOfMemoryError {} }
    }
  }
}

effect fn checks() -> i32 ! OutOfMemoryError | WriterError ? &mut Allocator {
  let event = match run Effect.result(decodeEvent(
    b"{\"created\": \"2026-11-19T18:36:22.5+01:00\", \"day\": \"2026-11-19\", \"opens\": \"08:30\", \"local\": \"2026-11-19T18:36:22\", \"billing\": \"2026-11\", \"birthday\": \"--02-29\", \"notice\": \"P1M15DT12H\", \"offset\": \"-03:00\", \"seen\": -86400, \"ends\": null}")) {
    Result<Event, SchemaError | OutOfMemoryError>.Success {value} => move value
    Result<Event, SchemaError | OutOfMemoryError>.Failure {..} => { return 1 }
  }
  if event.created.unixMilliseconds() != 1795109782500 { return 2 }
  if event.day.year() != 2026 || event.day.month() != 11 || event.day.day() != 19 { return 3 }
  if event.opens.hour() != 8 || event.opens.minute() != 30 { return 4 }
  if event.local.time().hour() != 18 || event.local.time().second() != 22 { return 5 }
  if event.billing.month() != 11 { return 6 }
  if event.birthday.day() != 29 { return 7 }
  if event.notice.months() != 1 || event.notice.days() != 15 || event.notice.time().wholeSeconds() != 43200 { return 8 }
  if event.offset.totalSeconds() != -10800 { return 9 }
  if event.seen.at.unixSeconds() != -86400 { return 10 }
  if event.ends.isSome() { return 11 }

  let mut capture = Capture {bytes: [0; 512], length: 0}
  if !run encodes(&event, &mut capture) { return 12 }
  if !holds(&capture,
    b"{\"created\":\"2026-11-19T17:36:22.5Z\",\"day\":\"2026-11-19\",\"opens\":\"08:30:00\",\"local\":\"2026-11-19T18:36:22\",\"billing\":\"2026-11\",\"birthday\":\"02-29\",\"notice\":\"P1M15DT12H\",\"offset\":\"-03:00\",\"seen\":-86400}") {
    return 13
  }

  let month = run failure(
    b"{\"created\": \"2026-11-19T18:36:22Z\", \"day\": \"2026-13-19\", \"opens\": \"08:30\", \"local\": \"2026-11-19T18:36:22\", \"billing\": \"2026-11\", \"birthday\": \"02-29\", \"notice\": \"P1D\", \"offset\": \"Z\", \"seen\": 0}")
  if !failedAt(&month, "day", IssueReason.InvalidValue) { return 14 }
  let kind = run failure(
    b"{\"created\": 5, \"day\": \"2026-11-19\", \"opens\": \"08:30\", \"local\": \"2026-11-19T18:36:22\", \"billing\": \"2026-11\", \"birthday\": \"02-29\", \"notice\": \"P1D\", \"offset\": \"Z\", \"seen\": 0}")
  if !failedAt(&kind, "created", IssueReason.InvalidType) { return 15 }
  let zone = run failure(
    b"{\"created\": \"2026-11-19T18:36:22\", \"day\": \"2026-11-19\", \"opens\": \"08:30\", \"local\": \"2026-11-19T18:36:22\", \"billing\": \"2026-11\", \"birthday\": \"02-29\", \"notice\": \"P1D\", \"offset\": \"Z\", \"seen\": 0}")
  if !failedAt(&zone, "created", IssueReason.InvalidValue) { return 16 }
  let far = run failure(
    b"{\"created\": \"2026-11-19T18:36:22Z\", \"day\": \"2026-11-19\", \"opens\": \"08:30\", \"local\": \"2026-11-19T18:36:22\", \"billing\": \"2026-11\", \"birthday\": \"02-29\", \"notice\": \"P1D\", \"offset\": \"Z\", \"seen\": 9000000000000}")
  if !failedAt(&far, "seen", IssueReason.InvalidValue) { return 17 }

  match run milliseconds(-1) {
    Option<Instant>.Some {value} => {
      if value.unixSeconds() != -1 || value.subsecondNanoseconds() != 999000000 { return 18 }
      let back: i64 = run Codec.encode(&UnixMilliseconds {}, &value)
      if back != -1 { return 19 }
    }
    Option<Instant>.None => { return 20 }
  }
  if (run milliseconds(8640000000000001)).isSome() { return 21 }
  if !(run milliseconds(8640000000000000)).isSome() { return 22 }

  match move run offsetText("+0530") {
    Option<String>.Some {value} => { if value.view() != "+05:30" { return 23 } }
    Option<String>.None => { return 24 }
  }
  if (run offsetText("+25:00")).isSome() { return 25 }
  return 0
}

pub effect fn main() -> i32 ! OutOfMemoryError | WriterError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checks() |> Effect.provideMut<Allocator>(&mut allocator)
}
