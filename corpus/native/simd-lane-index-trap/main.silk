import silk.num.usize
import silk.num.u8

// A lane index past the last lane traps, as an array index does (SIMD-003).
pub fn main() -> i32 {
  let vector = Intrinsic.simdSplat<simd<u8, 16>>(7)
  let mut index = usize.ZERO
  while index < 16 { index = index + 1 }
  return u8.toI32(Intrinsic.simdExtract<simd<u8, 16>>(vector, index))
}
