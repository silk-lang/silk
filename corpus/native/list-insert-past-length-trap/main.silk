import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.collections.list { List }

// The capacity is 8 and the length is 1, so index 2 is inside the storage but past the elements.
// insert must trap instead of counting the uninitialized slot at index 1 as an element.
effect fn build() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut values = List<i32>.make()
  run List<i32>.reserveExact(&mut values, 8) |> Effect.provideMut(&mut allocator)
  run List<i32>.append(&mut values, 10) |> Effect.provideMut(&mut allocator)
  run List<i32>.insert(&mut values, 2, 30) |> Effect.provideMut(&mut allocator)
  return 0
}
effect fn recover(error: OutOfMemoryError) -> i32 { return 99 }
pub fn main() -> i32 { return run Effect.catchAll(build(), recover) }
