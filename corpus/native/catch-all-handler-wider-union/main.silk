import silk.core.effect { Effect }

struct Overdrawn { short: i32 }
struct Frozen { days: i32 }
struct Closed {}

effect fn withdraw(amount: i32) -> i32 ! Overdrawn | Frozen | Closed {
  if amount > 100 { fail Overdrawn { short: amount - 100 } }
  if amount < 0 { fail Frozen { days: 0 - amount } }
  if amount == 0 { fail Closed {} }
  return amount
}

effect fn onShort(failure: Overdrawn) -> i32 {
  return 1000 + failure.short
}

// One handler for the whole API, reused after `Overdrawn` is already handled.
effect fn onAny(failure: Overdrawn | Frozen | Closed) -> i32 {
  return match move failure {
    Overdrawn {short} => 2000 + short
    Frozen {days} => 3000 + days
    Closed {} => 4000
  }
}

effect fn onLeft(failure: Frozen | Closed) -> i32 {
  return match move failure {
    Frozen {days} => 5000 + days
    Closed {} => 6000
  }
}

fn piped(amount: i32) -> i32 {
  return run Effect.catch(withdraw(amount), onShort) |> Effect.catchAll(onAny)
}

fn separate(amount: i32) -> i32 {
  let caught = Effect.catch(withdraw(amount), onShort)
  return run Effect.catchAll(move caught, onAny)
}

// The remaining `Frozen | Closed` widens into the handler's three-member union.
fn whole(amount: i32) -> i32 {
  return run Effect.catchAll(withdraw(amount), onAny)
}

fn narrowed(amount: i32) -> i32 {
  return run Effect.catch(withdraw(amount), onShort) |> Effect.catchAll(onLeft)
}

struct Usage {}
struct Full {}

effect fn parse(fails: bool) -> i32 ! Usage {
  if fails { fail Usage {} }
  return 7
}

effect fn explain(failure: Usage | Full) -> i32 {
  return match move failure {
    Usage {} => 2
    Full {} => 1
  }
}

// One failure type, not a union, widens into the pipeline handler's union parameter.
fn single(fails: bool) -> i32 {
  return run parse(fails) |> Effect.catchAll(explain)
}

pub fn main() -> i32 {
  if piped(40) != 40 { return 1 }
  if piped(130) != 1030 { return 2 }
  if piped(-7) != 3007 { return 3 }
  if piped(0) != 4000 { return 4 }
  if separate(-2) != 3002 { return 5 }
  if separate(0) != 4000 { return 6 }
  if whole(120) != 2020 { return 7 }
  if whole(-3) != 3003 { return 8 }
  if narrowed(-4) != 5004 { return 9 }
  if narrowed(0) != 6000 { return 10 }
  if single(true) != 2 { return 11 }
  if single(false) != 7 { return 12 }
  return 42
}
