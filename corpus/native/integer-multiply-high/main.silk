import silk.i16
import silk.i32
import silk.i64
import silk.i8
import silk.isize
import silk.u16
import silk.u32
import silk.u64
import silk.u8
import silk.usize

// Each width keeps the upper half of the exact product; signed operands keep its sign.
pub fn main() -> i32 {
  if u8.multiplyHigh(200, 200) != 156 { return 1 }
  if u16.multiplyHigh(60000, 60000) != 54931 { return 2 }
  if u32.multiplyHigh(u32.MAX, u32.MAX) != 4294967294 { return 3 }
  if u64.multiplyHigh(u64.MAX, u64.MAX) != 0xFFFFFFFFFFFFFFFE { return 4 }
  if u64.multiplyHigh(0x123456789ABCDEF0, 0x0FEDCBA987654321) != 0x0121FA00AD77D742 { return 5 }
  if u64.wrappingMultiply(0x123456789ABCDEF0, 0x0FEDCBA987654321) != 0x2236D88FE5618CF0 { return 6 }
  if u64.multiplyHigh(u64.MAX, 0) != 0 { return 7 }
  if usize.multiplyHigh(usize.MAX, 2) != 1 { return 8 }
  if i8.multiplyHigh(-128, 127) != -64 { return 9 }
  if i16.multiplyHigh(-1, 1) != -1 { return 10 }
  if i32.multiplyHigh(i32.MIN, i32.MIN) != 1073741824 { return 11 }
  if i64.multiplyHigh(i64.MIN, i64.MIN) != 4611686018427387904 { return 12 }
  if i64.multiplyHigh(-0x0123456789ABCDEF, 0x0FEDCBA987654321) != -5101321817914741 { return 13 }
  if i64.multiplyHigh(-3, 5) != -1 { return 14 }
  if isize.multiplyHigh(-1, 1) != -1 { return 15 }
  return 42
}
