import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.crypto.curve448 { Ed448Error, Ed448PrivateKey, Ed448PublicKey }

fn equal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut i: usize = 0
  while i < left.length {
    if left[i] != right[i] {
      return false
    }
    i = i + 1
  }
  return true
}

fn passed(result: Result<(), Ed448Error>) -> bool {
  return match move result {
    Result<(), Ed448Error>.Success { .. } => true
    Result<(), Ed448Error>.Failure { error: _ } => false
  }
}

fn signature(result: Result<[u8; 114], Ed448Error>) -> [u8; 114] {
  return match move result {
    Result<[u8; 114], Ed448Error>.Success { value } => value
    Result<[u8; 114], Ed448Error>.Failure { error: _ } => [0; 114]
  }
}

fn publicKey(bytes: &[u8]) -> Ed448PublicKey {
  return match Ed448PublicKey.fromBytes(bytes) {
    Result<Ed448PublicKey, Ed448Error>.Success { value } => move value
    Result<Ed448PublicKey, Ed448Error>.Failure { error: _ } => {
      Intrinsic.trap("bad public key")
    }
  }
}

// A key from RFC 8032 or another program: its public key, its deterministic signature, and the
// verification of it, of a changed message, and of the other variants.
fn signs(seed: &[u8], expectedPublic: &[u8], message: &[u8], context: &[u8], prehashed: bool, expected: &[u8]) -> i32 {
  let key = match Ed448PrivateKey.fromSeed(seed) {
    Result<Ed448PrivateKey, Ed448Error>.Success { value } => move value
    Result<Ed448PrivateKey, Ed448Error>.Failure { error: _ } => {
      return 1
    }
  }
  if !equal(&key.publicKey(), expectedPublic) || !equal(&key.seed(), seed) {
    return 1
  }
  let mut signed: [u8; 114] = [0; 114]
  if prehashed {
    signed = signature(key.signPrehashed(message, context))
  } else if context.length == 0 {
    signed = key.sign(message)
  } else {
    signed = signature(key.signWithContext(message, context))
  }
  if !equal(&signed, expected) {
    return 1
  }
  let verifier = publicKey(expectedPublic)
  let mut good = false
  let mut other = false
  if prehashed {
    good = passed(verifier.verifyPrehashed(message, context, &signed))
    other = passed(verifier.verifyWithContext(message, context, &signed))
  } else {
    good = passed(verifier.verifyWithContext(message, context, &signed))
    other = passed(verifier.verifyPrehashed(message, context, &signed))
  }
  if !good || other {
    return 1
  }
  if passed(verifier.verifyWithContext(message, b"bar", &signed)) {
    return 1
  }
  signed[3] = signed[3] ^ 1
  if passed(verifier.verifyWithContext(message, context, &signed)) || passed(verifier.verifyPrehashed(message, context, &signed)) {
    return 1
  }
  return 0
}

// Wycheproof ed448_test.json: the verification must give `valid`. Keys that do not decode count
// as failed verification.
fn wycheproof(id: i32, key: &[u8], message: &[u8], signed: &[u8], valid: bool) -> i32 {
  let verified = match Ed448PublicKey.fromBytes(key) {
    Result<Ed448PublicKey, Ed448Error>.Success { value } => passed(value.verify(message, signed))
    Result<Ed448PublicKey, Ed448Error>.Failure { error: _ } => false
  }
  if verified == valid {
    return 0
  }
  return 1
}

fn refuses(result: Result<[u8; 114], Ed448Error>) -> bool {
  return match move result {
    Result<[u8; 114], Ed448Error>.Failure { error: Ed448Error.ContextTooLong } => true
    _ => false
  }
}

