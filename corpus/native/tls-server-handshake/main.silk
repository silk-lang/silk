}


fn offeredAlpn<'a>(protocols: &'a [AlpnProtocol<'a>], required: bool) -> AlpnConfig<'a> {
  return AlpnConfig<'a>.Offered {protocols: protocols, required: required}
}

fn serverConfig<'a>(
  certificates: &'a [CertificateDer<'a>],
  alpn: AlpnConfig<'a>,
  groups: GroupPolicy,
) -> ServerConfig<'a> {
  return ServerConfig<'a> {
    certificates: certificates,
    alpn: alpn,
    groups: groups,
    limits: ServerLimits.defaults(),
  }
}

fn sameBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut index = usize.ZERO
  while index < left.length {
    if left[index] != right[index] { return false }
    index = index + usize.ONE
  }
  return true
}

fn p256Key(secret: &[u8]) -> ServerKey {
  return match P256.fromBytes(secret) {
    Result<P256, P256Error>.Success {value} => ServerKey.EcdsaP256 {key: move value}
    Result<P256, P256Error>.Failure {..} => {
      Intrinsic.trap("bad test key")
      return p256Key(secret)
    }
  }
}

fn p384Key(secret: &[u8]) -> ServerKey {
  return match P384.fromBytes(secret) {
    Result<P384, P384Error>.Success {value} => ServerKey.EcdsaP384 {key: move value}
    Result<P384, P384Error>.Failure {..} => {
      Intrinsic.trap("bad test key")
      return p384Key(secret)
    }
  }
}

fn edKey(seed: &[u8]) -> ServerKey {
  return match Ed25519PrivateKey.fromSeed(seed) {
    Result<Ed25519PrivateKey, Ed25519Error>.Success {value} => ServerKey.Ed25519 {key: move value}
    Result<Ed25519PrivateKey, Ed25519Error>.Failure {..} => {
      Intrinsic.trap("bad test key")
      return edKey(seed)
    }
  }
}

fn rsaKey(other: bool) -> ServerKey {
  let made = if other {
    RsaPrivateKey.fromComponents(
      otherRsaModulus(),
      otherRsaPublicExponent(),
      otherRsaPrivateExponent(),
      otherRsaFirstPrime(),
      otherRsaSecondPrime(),
      otherRsaFirstExponent(),
      otherRsaSecondExponent(),
      otherRsaCoefficient(),
    )
  } else {
    RsaPrivateKey.fromComponents(
      leafRsaModulus(),
      leafRsaPublicExponent(),
      leafRsaPrivateExponent(),
      leafRsaFirstPrime(),
      leafRsaSecondPrime(),
      leafRsaFirstExponent(),
      leafRsaSecondExponent(),
      leafRsaCoefficient(),
    )
  }
  return match move made {
    Result<RsaPrivateKey, RsaError>.Success {value} => ServerKey.RsaPss {key: move value}
    Result<RsaPrivateKey, RsaError>.Failure {..} => {
      Intrinsic.trap("bad test key")
      return rsaKey(other)
    }
  }
}

fn reference<'a>(bytes: &'a [u8]) -> ReferenceIdentity<'a> {
  return match HttpsIdentity.reference(OriginHost<'a>.Dns {bytes: bytes}) {
    Result<ReferenceIdentity<'a>, IdentityError>.Success {value} => value
    Result<ReferenceIdentity<'a>, IdentityError>.Failure {..} => {
      Intrinsic.trap("bad reference")
      return reference(bytes)
    }
  }
}

effect fn makeClient<'a>(alpn: AlpnConfig<'a>) -> Result<Client, TlsError>
! OutOfMemoryError
? &mut Allocator | &mut Random {
  let made = run TrustSnapshot.fromPem(rootPem(), TrustLoadLimits.defaults())
  let trust = match move made {
    Result<TrustSnapshot, TrustSourceError>.Success {value} => move value
    Result<TrustSnapshot, TrustSourceError>.Failure {..} => {
      Intrinsic.trap("bad trust")
      return run makeClient(alpn)
    }
  }
  let config = ClientConfig {
    reference: reference(b"example.com"),
    alpn: alpn,
    limits: ClientLimits.defaults(),
  }
  return run Client.make(&config, move trust, SystemClock.make(1789156800, 0))
}

fn serverCode(error: ServerError) -> i32 {
  return match error {
    ServerError.EmptyCertificateChain => 101
    ServerError.CertificateDecode {..} => 102
    ServerError.KeyMismatch => 103
    ServerError.PeerAlert {..} => 104
    ServerError.BadRecordMac => 105
    ServerError.ProtocolViolation {..} => 106
    ServerError.Negotiation {failure} => match failure {
      NegotiationFailure.Version => 107
      NegotiationFailure.CipherSuite => 108
      NegotiationFailure.Group => 109
      NegotiationFailure.SignatureScheme => 110
    }
    ServerError.InvalidKeyShare => 111
    ServerError.Finished => 112
    ServerError.LimitExceeded {..} => 113
    ServerError.InvalidState {..} => 114
    ServerError.EmptyBuffer => 115
    ServerError.HandshakeTruncated => 116
    ServerError.Truncated => 117
    ServerError.NoApplicationProtocol => 118
    ServerError.RsaSignature {..} => 119
  }
}

fn clientCode(error: TlsError) -> i32 {
  return match move error {
    TlsError.PeerAlert {..} => 130
    TlsError.BadRecordMac => 131
    TlsError.ProtocolViolation {..} => 132
    TlsError.CertificateDecode {..} => 133
    TlsError.CertificatePath {..} => 134
    TlsError.CertificateIdentity {..} => 135
    TlsError.CertificateVerify {..} => 136
    TlsError.Finished => 137
    TlsError.UnsupportedProfile => 138
    TlsError.LimitExceeded {..} => 139
    TlsError.InvalidState {..} => 140
    TlsError.EmptyBuffer => 141
    TlsError.HandshakeTruncated => 142
    TlsError.Truncated => 143
    TlsError.NoApplicationProtocol => 144
  }
}

// Moves bytes in both directions until neither side takes more. Returns 0, or an error code.
effect fn pump(client: &mut Client, server: &mut Server) -> i32
! OutOfMemoryError
? &mut Allocator | &mut Random {
  let mut rounds = usize.ZERO
  while rounds < 256 {
    let mut moved = false
    if Client.pendingOutput(&client.*).length > 0 {
      let fed = run Server.feedInput(&mut server.*, Client.pendingOutput(&client.*))
      let consumed = match move fed {
        Result<ServerProgress, ServerError>.Success {value} => value.consumed
        Result<ServerProgress, ServerError>.Failure {error} => {
          return serverCode(error)
        }
      }
      if consumed > 0 {
        moved = true
        if let Result<Progress, TlsError>.Failure {error} = move Client.ackWritten(&mut client.*, consumed) {
          return clientCode(move error)
        }
      }
    }
    if Server.pendingOutput(&server.*).length > 0 {
      let fed = run Client.feedInput(&mut client.*, Server.pendingOutput(&server.*))
      let consumed = match move fed {
        Result<Progress, TlsError>.Success {value} => value.consumed
        Result<Progress, TlsError>.Failure {error} => {
          return clientCode(move error)
        }
      }
      if consumed > 0 {
        moved = true
        if let Result<ServerProgress, ServerError>.Failure {error} = Server.ackWritten(&mut server.*, consumed) {
          return serverCode(error)
        }
      }
    }
    if !moved { return 0 }
    rounds = rounds + usize.ONE
  }
  return 99
}

// Returns whether pumping failed.
effect fn pumped(client: &mut Client, server: &mut Server) -> bool
! OutOfMemoryError
? &mut Allocator | &mut Random {
  let code = run pump(&mut client.*, &mut server.*)
  return code != 0
}

fn readServer(server: &mut Server, expected: &[u8]) -> bool {
  let mut buffer: [u8; 64] = [0; 64]
  return match Server.readPlaintext(&mut server.*, &mut buffer) {
    Result<ServerProgress, ServerError>.Success {value} => {
      sameBytes(Slice.view<u8>(&buffer, 0, value.written), expected)
    }
    Result<ServerProgress, ServerError>.Failure {..} => false
  }
}

fn readClient(client: &mut Client, expected: &[u8]) -> bool {
  let mut buffer: [u8; 64] = [0; 64]
  return match move Client.readPlaintext(&mut client.*, &mut buffer) {
    Result<Progress, TlsError>.Success {value} => {
      sameBytes(Slice.view<u8>(&buffer, 0, value.written), expected)
    }
    Result<Progress, TlsError>.Failure {..} => false
  }
}

fn writeServer(server: &mut Server, bytes: &[u8]) -> bool {
  return match Server.writePlaintext(&mut server.*, bytes) {
    Result<ServerProgress, ServerError>.Success {value} => value.consumed == bytes.length
    Result<ServerProgress, ServerError>.Failure {..} => false
  }
}

fn writeClient(client: &mut Client, bytes: &[u8]) -> bool {
  return match move Client.writePlaintext(&mut client.*, bytes) {
    Result<Progress, TlsError>.Success {value} => value.consumed == bytes.length
    Result<Progress, TlsError>.Failure {..} => false
  }
}

// Runs one full connection: handshake, data both ways, KeyUpdate both ways, and close.
effect fn connection<'a>(
  key: ServerKey,
  groups: GroupPolicy,
  serverAlpn: AlpnConfig<'a>,
  clientAlpn: AlpnConfig<'a>,
  leaf: &[u8],
  expectedGroup: ServerGroup,
  expectRetry: bool,
  expectedAlpn: &[u8],
) -> i32
! OutOfMemoryError
? &mut Allocator | &mut Random {
  let chain = [CertificateDer {bytes: leaf}, CertificateDer {bytes: rootDer()}]
  let config = serverConfig(&chain, serverAlpn, groups)
  let mut server = match run Server.make(&config, move key) {
    Result<Server, ServerError>.Success {value} => move value
    Result<Server, ServerError>.Failure {error} => {
      return serverCode(error)
    }
  }
  let mut client = match move run makeClient(clientAlpn) {
    Result<Client, TlsError>.Success {value} => move value
    Result<Client, TlsError>.Failure {error} => {
      return clientCode(move error)
    }
  }
  let pumped = run pump(&mut client, &mut server)
  if pumped != 0 { return pumped }
  let suite = match Server.cipherSuite(&server) {
    Option<CipherSuite>.Some {value} => value == CipherSuite.ChaCha20Poly1305Sha256
    Option<CipherSuite>.None => false
  }
  if !suite { return 2 }
  let group = match Server.group(&server) {
    Option<ServerGroup>.Some {value} => value == expectedGroup
    Option<ServerGroup>.None => false
  }
  if !group { return 3 }
  if Server.retried(&server) != expectRetry { return 4 }
  let name = match Server.serverName(&server) {
    Option<&[u8]>.Some {value} => sameBytes(value, b"example.com")
    Option<&[u8]>.None => false
  }
  if !name { return 5 }
  let alpn = match Server.selectedAlpn(&server) {
    Option<&[u8]>.Some {value} => sameBytes(value, expectedAlpn)
    Option<&[u8]>.None => expectedAlpn.length == 0
  }
  if !alpn { return 6 }
  let clientAlpnMatches = match Client.authentication(&client) {
    Option.Some {value} => match value.selectedAlpn() {
      Option<&[u8]>.Some {value: selected} => sameBytes(selected, expectedAlpn)
      Option<&[u8]>.None => expectedAlpn.length == 0
    }
    Option.None => false
  }
  if !clientAlpnMatches { return 7 }

  if !writeClient(&mut client, b"GET / HTTP/1.1") { return 10 }
  let pumped11 = run pump(&mut client, &mut server)
  if pumped11 != 0 { return 11 }
  if !readServer(&mut server, b"GET / HTTP/1.1") { return 12 }
  if !writeServer(&mut server, b"HTTP/1.1 200 OK") { return 13 }
  let pumped14 = run pump(&mut client, &mut server)
  if pumped14 != 0 { return 14 }
  if !readClient(&mut client, b"HTTP/1.1 200 OK") { return 15 }

  // The client asks for a KeyUpdate, and the server answers with its own.
  if let Result<Progress, TlsError>.Failure {error} = move Client.requestKeyUpdate(&mut client) {
    return clientCode(move error)
  }
  let pumped16 = run pump(&mut client, &mut server)
  if pumped16 != 0 { return 16 }
  if !writeClient(&mut client, b"after client update") { return 17 }
  let pumped18 = run pump(&mut client, &mut server)
  if pumped18 != 0 { return 18 }
  if !readServer(&mut server, b"after client update") { return 19 }
  if !writeServer(&mut server, b"after server answer") { return 20 }
  let pumped21 = run pump(&mut client, &mut server)
  if pumped21 != 0 { return 21 }
  if !readClient(&mut client, b"after server answer") { return 22 }

  // The server asks for a KeyUpdate.
  if let Result<ServerProgress, ServerError>.Failure {error} = Server.requestKeyUpdate(&mut server) {
    return serverCode(error)
  }
  let pumped23 = run pump(&mut client, &mut server)
  if pumped23 != 0 { return 23 }
  if !writeServer(&mut server, b"x") { return 24 }
  let pumped25 = run pump(&mut client, &mut server)
  if pumped25 != 0 { return 25 }
  if !readClient(&mut client, b"x") { return 251 }
  if !writeServer(&mut server, b"after server update") { return 26 }
  let pumped27 = run pump(&mut client, &mut server)
  if pumped27 != 0 { return 27 }
  if !readClient(&mut client, b"after server update") { return 28 }
  if !writeClient(&mut client, b"after client answer") { return 29 }
  let pumped30 = run pump(&mut client, &mut server)
  if pumped30 != 0 { return 30 }
  if !readServer(&mut server, b"after client answer") { return 31 }

  // Both sides close.
  if let Result<ServerProgress, ServerError>.Failure {error} = Server.closeWrite(&mut server) {
    return serverCode(error)
  }
  let pumped32 = run pump(&mut client, &mut server)
  if pumped32 != 0 { return 32 }
  if !Client.closeNotified(&client) { return 33 }
  if let Result<Progress, TlsError>.Failure {error} = move Client.closeWrite(&mut client) {
    return clientCode(move error)
  }
  let pumped34 = run pump(&mut client, &mut server)
  if pumped34 != 0 { return 34 }
  if !Server.closeNotified(&server) { return 35 }
  let closed = match run Server.progress(&mut server) {
    Result<ServerProgress, ServerError>.Success {value} => value.demand == ServerDemand.Closed
    Result<ServerProgress, ServerError>.Failure {..} => false
  }
  if !closed { return 36 }
  return 0
}

// Makes a server and a client and runs the handshake. Returns the server error code, or 0.
effect fn handshakeFailure<'a>(
  key: ServerKey,
  groups: GroupPolicy,
  serverAlpn: AlpnConfig<'a>,
  clientAlpn: AlpnConfig<'a>,
  leaf: &[u8],
) -> i32
! OutOfMemoryError
? &mut Allocator | &mut Random {
  let chain = [CertificateDer {bytes: leaf}]
  let config = serverConfig(&chain, serverAlpn, groups)
  let mut server = match run Server.make(&config, move key) {
    Result<Server, ServerError>.Success {value} => move value
    Result<Server, ServerError>.Failure {error} => {
      return serverCode(error)
    }
  }
  let mut client = match move run makeClient(clientAlpn) {
    Result<Client, TlsError>.Success {value} => move value
    Result<Client, TlsError>.Failure {error} => {
      return clientCode(move error)
    }
  }
  return run pump(&mut client, &mut server)
}

effect fn makeFailure(certificates: &[CertificateDer<'static>], key: ServerKey) -> i32
! OutOfMemoryError
? &mut Allocator {
  let config = serverConfig(certificates, AlpnConfig.defaults(), GroupPolicy.defaults())
  return match run Server.make(&config, move key) {
    Result<Server, ServerError>.Success {..} => 0
    Result<Server, ServerError>.Failure {error} => serverCode(error)
  }
}

// A raw ClientHello that offers only TLS 1.2.
effect fn tls12Only() -> i32 ! OutOfMemoryError ? &mut Allocator | &mut Random {
  let chain = [CertificateDer {bytes: leaf256Der()}]
  let config = serverConfig(&chain, AlpnConfig.defaults(), GroupPolicy.defaults())
  let mut server = match run Server.make(&config, p256Key(leaf256Secret())) {
    Result<Server, ServerError>.Success {value} => move value
    Result<Server, ServerError>.Failure {error} => {
      return serverCode(error)
    }
  }
  let hello = b"\x16\x03\x01\x00\x34\x01\x00\x00\x30\x03\x03\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f\x20\x00\x00\x02\xc0\x2b\x01\x00\x00\x05\xff\x01\x00\x01\x00"
  return match run Server.feedInput(&mut server, hello) {
    Result<ServerProgress, ServerError>.Success {..} => 1
    Result<ServerProgress, ServerError>.Failure {error} => serverCode(error)
  }
}

fn pendingIs(server: &Server, offset: usize, expected: &[u8]) -> bool {
  let pending = Server.pendingOutput(server)
  if pending.length < offset + expected.length { return false }
  return sameBytes(Slice.view<u8>(pending, offset, expected.length), expected)
}

fn ackAll(server: &mut Server) -> bool {
  let length = Server.pendingOutput(&server.*).length
  return match Server.ackWritten(&mut server.*, length) {
    Result<ServerProgress, ServerError>.Success {..} => true
    Result<ServerProgress, ServerError>.Failure {..} => false
  }
}

// A ClientHello recorded from OpenSSL 3.5: AES-256-GCM first, an X25519MLKEM768 share before the
// X25519 share, a 32-byte legacy session ID, SNI, and ALPN.
effect fn recordedHello(groups: GroupPolicy, key: ServerKey, leaf: &[u8]) -> i32
! OutOfMemoryError
? &mut Allocator | &mut Random {
  let chain = [CertificateDer {bytes: leaf}]
  let serverAlpn = [AlpnProtocol {bytes: b"http/1.1"}, AlpnProtocol {bytes: b"h2"}]
  let config = serverConfig(&chain, offeredAlpn(&serverAlpn, false), groups)
  let mut server = match run Server.make(&config, move key) {
    Result<Server, ServerError>.Success {value} => move value
    Result<Server, ServerError>.Failure {error} => {
      return serverCode(error)
    }
  }
  let hello = openSslHello()
  let fed = run Server.feedInput(&mut server, hello)
  let consumed = match move fed {
    Result<ServerProgress, ServerError>.Success {value} => value.consumed
    Result<ServerProgress, ServerError>.Failure {error} => {
      return serverCode(error)
    }
  }
  if consumed != hello.length { return 1 }
  let name = match Server.serverName(&server) {
    Option<&[u8]>.Some {value} => sameBytes(value, b"example.com")
    Option<&[u8]>.None => false
  }
  if !name { return 2 }
  let alpn = match Server.selectedAlpn(&server) {
    Option<&[u8]>.Some {value} => sameBytes(value, b"http/1.1")
    Option<&[u8]>.None => false
  }
  if !alpn { return 3 }
  // The reply echoes the 32-byte session ID, so the cipher suite sits at offset 76.
  if !pendingIs(&server, 0, b"\x16\x03\x03") { return 4 }
  if !pendingIs(&server, 5, b"\x02") { return 5 }
  if !pendingIs(&server, 43, b"\x20") { return 6 }
  if !pendingIs(&server, 76, b"\x13\x02\x00") { return 7 }
  if Server.retried(&server) {
    // HelloRetryRequest: the special random and a P-256 key share request.
    if !pendingIs(&server, 11, b"\xcf\x21\xad\x74\xe5\x9a\x61\x11") { return 8 }
    if !pendingIs(&server, 87, b"\x00\x33\x00\x02\x00\x17") { return 9 }
  } else {
    // ServerHello: supported_versions, then an X25519 key share.
    if !pendingIs(&server, 81, b"\x00\x2b\x00\x02\x03\x04\x00\x33\x00\x24\x00\x1d\x00\x20") { return 10 }
  }
  if !ackAll(&mut server) { return 11 }
  // The middlebox compatibility change_cipher_spec record follows the first handshake message.
  if !pendingIs(&server, 0, b"\x14\x03\x03\x00\x01\x01") { return 12 }
  if Server.pendingOutput(&server).length != 6 { return 13 }
  if !ackAll(&mut server) { return 14 }
  if Server.retried(&server) {
    if Server.pendingOutput(&server).length != 0 { return 15 }
    // The same ClientHello again has no P-256 share.
    return match run Server.feedInput(&mut server, hello) {
      Result<ServerProgress, ServerError>.Success {..} => 16
      Result<ServerProgress, ServerError>.Failure {error} => serverCode(error)
    }
  }
  // The encrypted flight, protected with the SHA-384 handshake keys.
  if !pendingIs(&server, 0, b"\x17\x03\x03") { return 17 }
  if !ackAll(&mut server) { return 18 }
  if Server.pendingOutput(&server).length != 0 { return 19 }
  return 0
}

effect fn cases() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut random = ScriptedRandom {filled: 0}
  let h2 = [AlpnProtocol {bytes: b"h2"}, AlpnProtocol {bytes: b"http/1.1"}]
  let serverAlpn = [AlpnProtocol {bytes: b"http/1.1"}, AlpnProtocol {bytes: b"h2"}]
  let spdy = [AlpnProtocol {bytes: b"spdy/3"}]
  let offered = offeredAlpn(&h2, true)

  // X25519 with the client's share, ECDSA P-256, and ALPN in server preference order.
  let first = run connection(
    p256Key(leaf256Secret()),
    GroupPolicy.defaults(),
    offeredAlpn(&serverAlpn, false),
    offered,
    leaf256Der(),
    ServerGroup.X25519,
    false,
    b"http/1.1",
  )
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if first != 0 { return 1000 + first }

  // A server without X25519 sends a HelloRetryRequest for P-256.
  let retry = run connection(
    p256Key(leaf256Secret()),
    GroupPolicy {x25519: false, p256: true, p384: true},
    AlpnConfig.defaults(),
    AlpnConfig.defaults(),
    leaf256Der(),
    ServerGroup.P256,
    true,
    b"",
  )
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if retry != 0 { return 2000 + retry }

  // An ECDSA P-384 leaf signs with ecdsa_secp384r1_sha384.
  let p384 = run connection(
    p384Key(leaf384Secret()),
    GroupPolicy.defaults(),
    offeredAlpn(&serverAlpn, true),
    offered,
    leaf384Der(),
    ServerGroup.X25519,
    false,
    b"http/1.1",
  )
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if p384 != 0 { return 3000 + p384 }

  // No shared ALPN protocol.
  let noAlpn = run handshakeFailure(
    p256Key(leaf256Secret()),
    GroupPolicy.defaults(),
    offeredAlpn(&spdy, false),
    offered,
    leaf256Der(),
  )
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if noAlpn != 118 { return 4000 + noAlpn }

  // ALPN required, but the client sends none.
  let missingAlpn = run handshakeFailure(
    p256Key(leaf256Secret()),
    GroupPolicy.defaults(),
    offeredAlpn(&spdy, true),
    AlpnConfig.defaults(),
    leaf256Der(),
  )
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if missingAlpn != 118 { return 5000 + missingAlpn }

  // Only P-384 is allowed, and the client does not support it.
  let noGroup = run handshakeFailure(
    p256Key(leaf256Secret()),
    GroupPolicy {x25519: false, p256: false, p384: true},
    AlpnConfig.defaults(),
    AlpnConfig.defaults(),
    leaf256Der(),
  )
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if noGroup != 109 { return 6000 + noGroup }

  // Configuration errors.
  let empty: [CertificateDer<'static>; 0] = []
  let emptyChain = run makeFailure(&empty, p256Key(leaf256Secret()))
    |> Effect.provideMut<Allocator>(&mut allocator)
  if emptyChain != 101 { return 7000 + emptyChain }
  let chain = [CertificateDer {bytes: leaf256Der()}]
  let mismatch = run makeFailure(&chain, p256Key(otherSecret()))
    |> Effect.provideMut<Allocator>(&mut allocator)
  if mismatch != 103 { return 7100 + mismatch }
  let wrongCurve = run makeFailure(&chain, p384Key(leaf384Secret()))
    |> Effect.provideMut<Allocator>(&mut allocator)
  if wrongCurve != 103 { return 7200 + wrongCurve }
  let garbage = [CertificateDer {bytes: b"\x30\x03\x02\x01\x01"}]
  let undecoded = run makeFailure(&garbage, p256Key(leaf256Secret()))
    |> Effect.provideMut<Allocator>(&mut allocator)
  if undecoded != 102 { return 7300 + undecoded }

  // A client that offers only TLS 1.2.
  let version = run tls12Only()
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if version != 107 { return 8000 + version }

  let recorded = run recordedHello(GroupPolicy.defaults(), p256Key(leaf256Secret()), leaf256Der())
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if recorded != 0 { return 9000 + recorded }
  let recordedRetry = run recordedHello(
    GroupPolicy {x25519: false, p256: true, p384: false},
    p256Key(leaf256Secret()),
    leaf256Der(),
  )
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if recordedRetry != 106 { return 9100 + recordedRetry }

  // An RSA leaf signs with rsa_pss_rsae_sha256, the only RSA scheme the Silk client offers.
  let rsa = run connection(
    rsaKey(false),
    GroupPolicy.defaults(),
    offeredAlpn(&serverAlpn, false),
    offered,
    leafRsaDer(),
    ServerGroup.X25519,
    false,
    b"http/1.1",
  )
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if rsa != 0 { return 10000 + rsa }

  // The Silk client does not offer ed25519, so an Ed25519 server has no scheme to sign with.
  let edScheme = run handshakeFailure(
    edKey(leafEdSeed()),
    GroupPolicy.defaults(),
    AlpnConfig.defaults(),
    AlpnConfig.defaults(),
    leafEdDer(),
  )
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if edScheme != 110 { return 11000 + edScheme }

  // OpenSSL 3.5 offers ed25519 and the RSA-PSS schemes; both keys build a flight for it.
  let recordedEd = run recordedHello(GroupPolicy.defaults(), edKey(leafEdSeed()), leafEdDer())
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if recordedEd != 0 { return 12000 + recordedEd }
  let recordedRsa = run recordedHello(GroupPolicy.defaults(), rsaKey(false), leafRsaDer())
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if recordedRsa != 0 { return 12100 + recordedRsa }

  // A key must match the leaf, within and across key types.
  let edChain = [CertificateDer {bytes: leafEdDer()}]
  let rsaChain = [CertificateDer {bytes: leafRsaDer()}]
  let edOther = run makeFailure(&edChain, edKey(otherEdSeed()))
    |> Effect.provideMut<Allocator>(&mut allocator)
  if edOther != 103 { return 13000 + edOther }
  let rsaOther = run makeFailure(&rsaChain, rsaKey(true))
    |> Effect.provideMut<Allocator>(&mut allocator)
  if rsaOther != 103 { return 13100 + rsaOther }
  let edOnRsa = run makeFailure(&rsaChain, edKey(leafEdSeed()))
    |> Effect.provideMut<Allocator>(&mut allocator)
  if edOnRsa != 103 { return 13200 + edOnRsa }
  let rsaOnEcdsa = run makeFailure(&chain, rsaKey(false))
    |> Effect.provideMut<Allocator>(&mut allocator)
  if rsaOnEcdsa != 103 { return 13300 + rsaOnEcdsa }
  let ecdsaOnEd = run makeFailure(&edChain, p256Key(leaf256Secret()))
    |> Effect.provideMut<Allocator>(&mut allocator)
  if ecdsaOnEd != 103 { return 13400 + ecdsaOnEd }
  let edMatches = run makeFailure(&edChain, edKey(leafEdSeed()))
    |> Effect.provideMut<Allocator>(&mut allocator)
  if edMatches != 0 { return 13500 + edMatches }
  let rsaMatches = run makeFailure(&rsaChain, rsaKey(false))
    |> Effect.provideMut<Allocator>(&mut allocator)
  if rsaMatches != 0 { return 13600 + rsaMatches }
  return 0
}

effect fn recover(error: OutOfMemoryError) -> i32 { return 98 }

pub fn main() -> i32 {
  return run Effect.catchAll(cases(), recover)
}
