  return b"\x16\x03\x01\x05\xcc\x01\x00\x05\xc8\x03\x03\xd2\x38\xa0\x24\xef\x54\x9b\xb1\xcc\x5b\xce\x7f\x93\xfb\x43\xbf\xf8\xbe\x2b\x1a\x6d\x91\x67\x37\x9e\x2c\xcd\x38\x3d\x3e\xe8\x4e\x20\x08\xe9\x6d\xbe\xba\x32\x98\x4d\x3d\xe3\x3d\x76\x08\x7d\x48\xd5\xe6\xd1\xd2\x45\x00\x7c\x35\x1c\x93\x14\xd0\x56\x93\x9a\x35\xe0\x00\x06\x13\x02\x13\x03\x13\x01\x01\x00\x05\x79\x00\x00\x00\x10\x00\x0e\x00\x00\x0b\x65\x78\x61\x6d\x70\x6c\x65\x2e\x63\x6f\x6d\x00\x0b\x00\x04\x03\x00\x01\x02\x00\x0a\x00\x12\x00\x10\x11\xec\x00\x1d\x00\x17\x00\x1e\x00\x18\x00\x19\x01\x00\x01\x01\x00\x23\x00\x00\x00\x10\x00\x0e\x00\x0c\x02\x68\x32\x08\x68\x74\x74\x70\x2f\x31\x2e\x31\x00\x16\x00\x00\x00\x17\x00\x00\x00\x0d\x00\x2a\x00\x28\x09\x05\x09\x06\x09\x04\x04\x03\x05\x03\x06\x03\x08\x07\x08\x08\x08\x1a\x08\x1b\x08\x1c\x08\x09\x08\x0a\x08\x0b\x08\x04\x08\x05\x08\x06\x04\x01\x05\x01\x06\x01\x00\x2b\x00\x03\x02\x03\x04\x00\x2d\x00\x02\x01\x01\x00\x33\x04\xea\x04\xe8\x11\xec\x04\xc0\x50\xeb\x65\x34\xf3\xb1\xf7\x83\x11\x62\x22\x26\x31\x27\x83\x1c\x98\xbb\x82\x64\x81\xe0\x16\x45\x11\x5a\x53\xc1\x70\x0c\x7a\x74\xbf\x1d\x96\x34\xbf\x72\x86\xe5\x4c\x93\xb4\x82\xc4\x45\xe7\xb5\x4c\xc7\x7b\x91\x1c\x44\xb2\x48\x1e\xb7\xe0\x8d\x06\xd7\x91\xdf\x53\x04\x1c\x16\xaa\x01\x0b\x3b\xc0\xe9\x1e\x3c\x66\x1d\x15\x60\x06\x7a\x94\xc1\xa6\xa7\xbd\xdd\xb6\x90\x90\xe5\x77\xce\xa3\xb3\x44\x5c\x4f\xcd\x88\x64\xb9\xf9\xba\x7b\x12\x71\xa1\xe6\x6c\xd2\x42\xb3\xa4\x44\x3a\xb1\xe1\xa0\x3e\x3b\xba\xc0\xd4\xa0\x1b\xe8\xc7\xf8\xc5\x65\xb9\x2c\x16\x3b\x91\x65\x6a\x43\x49\xa6\xfc\xcb\xed\x59\x29\x86\xe2\x3e\xfe\x99\x16\x63\x18\x5f\xd4\xb4\xcc\x8b\xa3\x8a\xfc\x52\x8a\x36\xba\x21\xfd\x9c\x09\x2c\xa1\x01\x06\x62\x25\x73\x97\x28\x99\xc2\x48\xed\x15\x00\x1c\x01\x21\xf5\xc3\x22\x1b\xfc\x69\x6c\xa4\x8b\x58\xa3\xc7\xe1\xb6\xc7\x48\x5a\x65\x5c\x37\x66\x9a\x0b\xa3\xd2\xa9\x79\xcf\xd1\x91\x90\x33\x14\xa4\xe7\x28\xcb\xf9\xcd\x61\x00\x51\x8a\xc5\x89\xb6\x3c\x39\x28\x30\x27\x2a\xa7\x22\xef\x14\x2a\x99\xaa\x94\xd1\x67\xac\x66\x7a\x01\x36\x64\x9e\xc2\xa3\