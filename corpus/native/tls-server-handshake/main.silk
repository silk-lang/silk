}


fn offeredAlpn<'a>(protocols: &'a [AlpnProtocol<'a>], required: bool) -> AlpnConfig<'a> {
  return AlpnConfig<'a>.Offered {protocols: protocols, required: required}
}

fn serverConfig<'a>(
  certificates: &'a [CertificateDer<'a>],
  alpn: AlpnConfig<'a>,
  groups: GroupPolicy,
) -> ServerConfig<'a> {
  return ServerConfig<'a> {
    certificates: certificates,
    alpn: alpn,
    groups: groups,
    clientAuth: ClientAuth<'a>.Off,
    tickets: TicketPolicy<'a>.Off,
    versions: VersionPolicy.tls13(),
    limits: ServerLimits.defaults(),
  }
}

fn sameBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut index = usize.ZERO
  while index < left.length {
    if left[index] != right[index] { return false }
    index = index + usize.ONE
  }
  return true
}

fn p256Key(secret: &[u8]) -> SigningKey {
  return match P256.fromBytes(secret) {
    Result<P256, P256Error>.Success {value} => SigningKey.EcdsaP256 {key: move value}
    Result<P256, P256Error>.Failure {..} => {
      Intrinsic.trap("bad test key")
      return p256Key(secret)
    }
  }
}

fn p384Key(secret: &[u8]) -> SigningKey {
  return match P384.fromBytes(secret) {
    Result<P384, P384Error>.Success {value} => SigningKey.EcdsaP384 {key: move value}
    Result<P384, P384Error>.Failure {..} => {
      Intrinsic.trap("bad test key")
      return p384Key(secret)
    }
  }
}

fn edKey(seed: &[u8]) -> SigningKey {
  return match Ed25519PrivateKey.fromSeed(seed) {
    Result<Ed25519PrivateKey, Ed25519Error>.Success {value} => SigningKey.Ed25519 {key: move value}
    Result<Ed25519PrivateKey, Ed25519Error>.Failure {..} => {
      Intrinsic.trap("bad test key")
      return edKey(seed)
    }
  }
}

fn rsaKey(other: bool) -> SigningKey {
  let made = if other {
    RsaPrivateKey.fromComponents(
      otherRsaModulus(),
      otherRsaPublicExponent(),
      otherRsaPrivateExponent(),
      otherRsaFirstPrime(),
      otherRsaSecondPrime(),
      otherRsaFirstExponent(),
      otherRsaSecondExponent(),
      otherRsaCoefficient(),
    )
  } else {
    RsaPrivateKey.fromComponents(
      leafRsaModulus(),
      leafRsaPublicExponent(),
      leafRsaPrivateExponent(),
      leafRsaFirstPrime(),
      leafRsaSecondPrime(),
      leafRsaFirstExponent(),
      leafRsaSecondExponent(),
      leafRsaCoefficient(),
    )
  }
  return match move made {
    Result<RsaPrivateKey, RsaError>.Success {value} => SigningKey.Rsa {key: move value}
    Result<RsaPrivateKey, RsaError>.Failure {..} => {
      Intrinsic.trap("bad test key")
      return rsaKey(other)
    }
  }
}

fn reference<'a>(bytes: &'a [u8]) -> ReferenceIdentity<'a> {
  return match HttpsIdentity.reference(OriginHost<'a>.Dns {bytes: bytes}) {
    Result<ReferenceIdentity<'a>, IdentityError>.Success {value} => value
    Result<ReferenceIdentity<'a>, IdentityError>.Failure {..} => {
      Intrinsic.trap("bad reference")
      return reference(bytes)
    }
  }
}

effect fn makeClient<'a>(alpn: AlpnConfig<'a>) -> Result<Client, TlsError>
! OutOfMemoryError
? &mut Allocator | &mut Random {
  return run makeClientWith(alpn, ClientCredential.None, VersionPolicy.tls13())
}

effect fn makeClientWith<'a>(
  alpn: AlpnConfig<'a>,
  credential: ClientCredential<'a>,
  versions: VersionPolicy,
) -> Result<
  Client,
  TlsError
>
! OutOfMemoryError
? &mut Allocator | &mut Random {
  let made = run TrustSnapshot.fromPem(rootPem(), TrustLoadLimits.defaults())
  let trust = match move made {
    Result<TrustSnapshot, TrustSourceError>.Success {value} => move value
    Result<TrustSnapshot, TrustSourceError>.Failure {..} => {
      Intrinsic.trap("bad trust")
      return run makeClientWith(alpn, move credential, versions)
    }
  }
  let config = ClientConfig {
    reference: reference(b"example.com"),
    alpn: alpn,
    resumption: Resumption<'a>.Disabled,
    versions: versions,
    limits: ClientLimits.defaults(),
  }
  return run Client.make(&config, move trust, SystemClock.make(1789156800, 0), move credential)
}

fn serverCode(error: ServerError) -> i32 {
  return match error {
    ServerError.EmptyCertificateChain => 101
    ServerError.CertificateDecode {..} => 102
    ServerError.KeyMismatch => 103
    ServerError.PeerAlert {..} => 104
    ServerError.BadRecordMac => 105
    ServerError.ProtocolViolation {..} => 106
    ServerError.Negotiation {failure} => match failure {
      NegotiationFailure.Version => 107
      NegotiationFailure.CipherSuite => 108
      NegotiationFailure.Group => 109
      NegotiationFailure.SignatureScheme => 110
      NegotiationFailure.ExtendedMasterSecret => 126
    }
    ServerError.InvalidKeyShare => 111
    ServerError.Finished => 112
    ServerError.LimitExceeded {..} => 113
    ServerError.InvalidState {..} => 114
    ServerError.EmptyBuffer => 115
    ServerError.HandshakeTruncated => 116
    ServerError.Truncated => 117
    ServerError.NoApplicationProtocol => 118
    ServerError.Signing {..} => 119
    ServerError.ClientCertificateRequired => 120
    ServerError.ClientCertificateDecode {..} => 121
    ServerError.ClientCertificateVerify {..} => 122
    ServerError.UntrustedClientCertificate {..} => 123
    ServerError.Binder => 124
    ServerError.InvalidTicketPolicy => 125
  }
}

fn clientCode(error: TlsError) -> i32 {
  return match move error {
    TlsError.PeerAlert {..} => 130
    TlsError.BadRecordMac => 131
    TlsError.ProtocolViolation {..} => 132
    TlsError.CertificateDecode {..} => 133
    TlsError.CertificatePath {..} => 134
    TlsError.CertificateIdentity {..} => 135
    TlsError.CertificateVerify {..} => 136
    TlsError.Finished => 137
    TlsError.UnsupportedProfile => 138
    TlsError.LimitExceeded {..} => 139
    TlsError.InvalidState {..} => 140
    TlsError.EmptyBuffer => 141
    TlsError.HandshakeTruncated => 142
    TlsError.Truncated => 143
    TlsError.NoApplicationProtocol => 144
    TlsError.EmptyCredential => 145
    TlsError.CredentialDecode {..} => 146
    TlsError.CredentialKeyMismatch => 147
    TlsError.Signing {..} => 148
  }
}

// Moves bytes in both directions until neither side takes more. Returns 0, or an error code.
effect fn pump(client: &mut Client, server: &mut Server) -> i32
! OutOfMemoryError
? &mut Allocator | &mut Random {
  let mut rounds = usize.ZERO
  while rounds < 256 {
    let mut moved = false
    if Client.pendingOutput(&client.*).length > 0 {
      let fed = run Server.feedInput(&mut server.*, Client.pendingOutput(&client.*))
      let consumed = match move fed {
        Result<ServerProgress, ServerError>.Success {value} => value.consumed
        Result<ServerProgress, ServerError>.Failure {error} => {
          return serverCode(error)
        }
      }
      if consumed > 0 {
        moved = true
        if let Result<Progress, TlsError>.Failure {error} = move Client.ackWritten(&mut client.*, consumed) {
          return clientCode(move error)
        }
      }
    }
    if Server.pendingOutput(&server.*).length > 0 {
      let fed = run Client.feedInput(&mut client.*, Server.pendingOutput(&server.*))
      let consumed = match move fed {
        Result<Progress, TlsError>.Success {value} => value.consumed
        Result<Progress, TlsError>.Failure {error} => {
          return clientCode(move error)
        }
      }
      if consumed > 0 {
        moved = true
        if let Result<ServerProgress, ServerError>.Failure {error} = Server.ackWritten(&mut server.*, consumed) {
          return serverCode(error)
        }
      }
    }
    if !moved { return 0 }
    rounds = rounds + usize.ONE
  }
  return 99
}

// Returns whether pumping failed.
effect fn pumped(client: &mut Client, server: &mut Server) -> bool
! OutOfMemoryError
? &mut Allocator | &mut Random {
  let code = run pump(&mut client.*, &mut server.*)
  return code != 0
}

fn readServer(server: &mut Server, expected: &[u8]) -> bool {
  let mut buffer: [u8; 64] = [0; 64]
  return match Server.readPlaintext(&mut server.*, &mut buffer) {
    Result<ServerProgress, ServerError>.Success {value} => {
      sameBytes(Slice.view<u8>(&buffer, 0, value.written), expected)
    }
    Result<ServerProgress, ServerError>.Failure {..} => false
  }
}

fn readClient(client: &mut Client, expected: &[u8]) -> bool {
  let mut buffer: [u8; 64] = [0; 64]
  return match move Client.readPlaintext(&mut client.*, &mut buffer) {
    Result<Progress, TlsError>.Success {value} => {
      sameBytes(Slice.view<u8>(&buffer, 0, value.written), expected)
    }
    Result<Progress, TlsError>.Failure {..} => false
  }
}

fn writeServer(server: &mut Server, bytes: &[u8]) -> bool {
  return match Server.writePlaintext(&mut server.*, bytes) {
    Result<ServerProgress, ServerError>.Success {value} => value.consumed == bytes.length
    Result<ServerProgress, ServerError>.Failure {..} => false
  }
}

fn writeClient(client: &mut Client, bytes: &[u8]) -> bool {
  return match move Client.writePlaintext(&mut client.*, bytes) {
    Result<Progress, TlsError>.Success {value} => value.consumed == bytes.length
    Result<Progress, TlsError>.Failure {..} => false
  }
}

// Runs one full connection: handshake, data both ways, KeyUpdate both ways, and close.
effect fn connection<'a>(
  key: SigningKey,
  groups: GroupPolicy,
  serverAlpn: AlpnConfig<'a>,
  clientAlpn: AlpnConfig<'a>,
  leaf: &[u8],
  expectedGroup: ServerGroup,
  expectRetry: bool,
  expectedAlpn: &[u8],
) -> i32
! OutOfMemoryError
? &mut Allocator | &mut Random {
  let chain = [CertificateDer {bytes: leaf}, CertificateDer {bytes: rootDer()}]
  let config = serverConfig(&chain, serverAlpn, groups)
  let mut server = match run Server.make(&config, move key) {
    Result<Server, ServerError>.Success {value} => move value
    Result<Server, ServerError>.Failure {error} => {
      return serverCode(error)
    }
  }
  let mut client = match move run makeClient(clientAlpn) {
    Result<Client, TlsError>.Success {value} => move value
    Result<Client, TlsError>.Failure {error} => {
      return clientCode(move error)
    }
  }
  let pumped = run pump(&mut client, &mut server)
  if pumped != 0 { return pumped }
  let suite = match Server.cipherSuite(&server) {
    Option<CipherSuite>.Some {value} => value == CipherSuite.ChaCha20Poly1305Sha256
    Option<CipherSuite>.None => false
  }
  if !suite { return 2 }
  let group = match Server.group(&server) {
    Option<ServerGroup>.Some {value} => value == expectedGroup
    Option<ServerGroup>.None => false
  }
  if !group { return 3 }
  if Server.retried(&server) != expectRetry { return 4 }
  let name = match Server.serverName(&server) {
    Option<&[u8]>.Some {value} => sameBytes(value, b"example.com")
    Option<&[u8]>.None => false
  }
  if !name { return 5 }
  let alpn = match Server.selectedAlpn(&server) {
    Option<&[u8]>.Some {value} => sameBytes(value, expectedAlpn)
    Option<&[u8]>.None => expectedAlpn.length == 0
  }
  if !alpn { return 6 }
  let clientAlpnMatches = match Client.authentication(&client) {
    Option.Some {value} => match value.selectedAlpn() {
      Option<&[u8]>.Some {value: selected} => sameBytes(selected, expectedAlpn)
      Option<&[u8]>.None => expectedAlpn.length == 0
    }
    Option.None => false
  }
  if !clientAlpnMatches { return 7 }

  if !writeClient(&mut client, b"GET / HTTP/1.1") { return 10 }
  let pumped11 = run pump(&mut client, &mut server)
  if pumped11 != 0 { return 11 }
  if !readServer(&mut server, b"GET / HTTP/1.1") { return 12 }
  if !writeServer(&mut server, b"HTTP/1.1 200 OK") { return 13 }
  let pumped14 = run pump(&mut client, &mut server)
  if pumped14 != 0 { return 14 }
  if !readClient(&mut client, b"HTTP/1.1 200 OK") { return 15 }

  // The client asks for a KeyUpdate, and the server answers with its own.
  if let Result<Progress, TlsError>.Failure {error} = move Client.requestKeyUpdate(&mut client) {
    return clientCode(move error)
  }
  let pumped16 = run pump(&mut client, &mut server)
  if pumped16 != 0 { return 16 }
  if !writeClient(&mut client, b"after client update") { return 17 }
  let pumped18 = run pump(&mut client, &mut server)
  if pumped18 != 0 { return 18 }
  if !readServer(&mut server, b"after client update") { return 19 }
  if !writeServer(&mut server, b"after server answer") { return 20 }
  let pumped21 = run pump(&mut client, &mut server)
  if pumped21 != 0 { return 21 }
  if !readClient(&mut client, b"after server answer") { return 22 }

  // The server asks for a KeyUpdate.
  if let Result<ServerProgress, ServerError>.Failure {error} = Server.requestKeyUpdate(&mut server) {
    return serverCode(error)
  }
  let pumped23 = run pump(&mut client, &mut server)
  if pumped23 != 0 { return 23 }
  if !writeServer(&mut server, b"x") { return 24 }
  let pumped25 = run pump(&mut client, &mut server)
  if pumped25 != 0 { return 25 }
  if !readClient(&mut client, b"x") { return 251 }
  if !writeServer(&mut server, b"after server update") { return 26 }
  let pumped27 = run pump(&mut client, &mut server)
  if pumped27 != 0 { return 27 }
  if !readClient(&mut client, b"after server update") { return 28 }
  if !writeClient(&mut client, b"after client answer") { return 29 }
  let pumped30 = run pump(&mut client, &mut server)
  if pumped30 != 0 { return 30 }
  if !readServer(&mut server, b"after client answer") { return 31 }

  // Both sides close.
  if let Result<ServerProgress, ServerError>.Failure {error} = Server.closeWrite(&mut server) {
    return serverCode(error)
  }
  let pumped32 = run pump(&mut client, &mut server)
  if pumped32 != 0 { return 32 }
  if !Client.closeNotified(&client) { return 33 }
  if let Result<Progress, TlsError>.Failure {error} = move Client.closeWrite(&mut client) {
    return clientCode(move error)
  }
  let pumped34 = run pump(&mut client, &mut server)
  if pumped34 != 0 { return 34 }
  if !Server.closeNotified(&server) { return 35 }
  let closed = match run Server.progress(&mut server) {
    Result<ServerProgress, ServerError>.Success {value} => value.demand == ServerDemand.Closed
    Result<ServerProgress, ServerError>.Failure {..} => false
  }
  if !closed { return 36 }
  return 0
}

// Makes a server and a client and runs the handshake. Returns the server error code, or 0.
effect fn handshakeFailure<'a>(
  key: SigningKey,
  groups: GroupPolicy,
  serverAlpn: AlpnConfig<'a>,
  clientAlpn: AlpnConfig<'a>,
  leaf: &[u8],
) -> i32
! OutOfMemoryError
? &mut Allocator | &mut Random {
  let chain = [CertificateDer {bytes: leaf}]
  let config = serverConfig(&chain, serverAlpn, groups)
  let mut server = match run Server.make(&config, move key) {
    Result<Server, ServerError>.Success {value} => move value
    Result<Server, ServerError>.Failure {error} => {
      return serverCode(error)
    }
  }
  let mut client = match move run makeClient(clientAlpn) {
    Result<Client, TlsError>.Success {value} => move value
    Result<Client, TlsError>.Failure {error} => {
      return clientCode(move error)
    }
  }
  return run pump(&mut client, &mut server)
}

effect fn makeClientVersions<'a>(alpn: AlpnConfig<'a>, versions: VersionPolicy) -> Result<
  Client,
  TlsError
>
! OutOfMemoryError
? &mut Allocator | &mut Random {
  let made = run TrustSnapshot.fromPem(rootPem(), TrustLoadLimits.defaults())
  let trust = match move made {
    Result<TrustSnapshot, TrustSourceError>.Success {value} => move value
    Result<TrustSnapshot, TrustSourceError>.Failure {..} => {
      Intrinsic.trap("bad trust")
      return run makeClientVersions(alpn, versions)
    }
  }
  let config = ClientConfig {
    reference: reference(b"example.com"),
    alpn: alpn,
    resumption: Resumption<'a>.Disabled,
    versions: versions,
    limits: ClientLimits.defaults(),
  }
  return run Client.make(&config, move trust, SystemClock.make(1789156800, 0), ClientCredential.None)
}

fn versionedConfig<'a>(
  certificates: &'a [CertificateDer<'a>],
  alpn: AlpnConfig<'a>,
  groups: GroupPolicy,
  versions: VersionPolicy,
) -> ServerConfig<'a> {
  return ServerConfig<'a> {
    certificates: certificates,
    alpn: alpn,
    groups: groups,
    clientAuth: ClientAuth<'a>.Off,
    tickets: TicketPolicy<'a>.Off,
    versions: versions,
    limits: ServerLimits.defaults(),
  }
}

// Runs one connection with the given version policies: handshake, data both ways, and close.
// Checks the negotiated version, suite, group, and ALPN on both sides.
effect fn versioned<'a>(
  key: SigningKey,
  leaf: &[u8],
  groups: GroupPolicy,
  serverVersions: VersionPolicy,
  clientVersions: VersionPolicy,
  serverAlpn: AlpnConfig<'a>,
  clientAlpn: AlpnConfig<'a>,
  expectedVersion: TlsVersion,
  expectedSuite: CipherSuite,
  expectedGroup: ServerGroup,
  expectedAlpn: &[u8],
) -> i32
! OutOfMemoryError
? &mut Allocator | &mut Random {
  let chain = [CertificateDer {bytes: leaf}, CertificateDer {bytes: rootDer()}]
  let config = versionedConfig(&chain, serverAlpn, groups, serverVersions)
  let mut server = match run Server.make(&config, move key) {
    Result<Server, ServerError>.Success {value} => move value
    Result<Server, ServerError>.Failure {error} => {
      return serverCode(error)
    }
  }
  let mut client = match move run makeClientVersions(clientAlpn, clientVersions) {
    Result<Client, TlsError>.Success {value} => move value
    Result<Client, TlsError>.Failure {error} => {
      return clientCode(move error)
    }
  }
  let pumped = run pump(&mut client, &mut server)
  if pumped != 0 { return pumped }
  let serverVersion = match Server.version(&server) {
    Option<TlsVersion>.Some {value} => value == expectedVersion
    Option<TlsVersion>.None => false
  }
  if !serverVersion { return 2 }
  let suite = match Server.cipherSuite(&server) {
    Option<CipherSuite>.Some {value} => value == expectedSuite
    Option<CipherSuite>.None => false
  }
  if !suite { return 3 }
  let group = match Server.group(&server) {
    Option<ServerGroup>.Some {value} => value == expectedGroup
    Option<ServerGroup>.None => false
  }
  if !group { return 4 }
  let name = match Server.serverName(&server) {
    Option<&[u8]>.Some {value} => sameBytes(value, b"example.com")
    Option<&[u8]>.None => false
  }
  if !name { return 5 }
  let alpn = match Server.selectedAlpn(&server) {
    Option<&[u8]>.Some {value} => sameBytes(value, expectedAlpn)
    Option<&[u8]>.None => expectedAlpn.length == 0
  }
  if !alpn { return 6 }
  let clientView = match Client.authentication(&client) {
    Option.Some {value} => {
      let selected = match value.selectedAlpn() {
        Option<&[u8]>.Some {value: bytes} => sameBytes(bytes, expectedAlpn)
        Option<&[u8]>.None => expectedAlpn.length == 0
      }
      selected && value.version() == expectedVersion && value.suite() == expectedSuite
    }
    Option.None => false
  }
  if !clientView { return 7 }

  if !writeClient(&mut client, b"GET / HTTP/1.1") { return 10 }
  let pumped11 = run pump(&mut client, &mut server)
  if pumped11 != 0 { return 11 }
  if !readServer(&mut server, b"GET / HTTP/1.1") { return 12 }
  if !writeServer(&mut server, b"HTTP/1.1 200 OK") { return 13 }
  let pumped14 = run pump(&mut client, &mut server)
  if pumped14 != 0 { return 14 }
  if !readClient(&mut client, b"HTTP/1.1 200 OK") { return 15 }
  if !writeClient(&mut client, b"second request") { return 16 }
  if !writeServer(&mut server, b"second answer") { return 17 }
  let pumped18 = run pump(&mut client, &mut server)
  if pumped18 != 0 { return 18 }
  if !readServer(&mut server, b"second request") { return 19 }
  if !readClient(&mut client, b"second answer") { return 20 }

  // TLS 1.2 has no KeyUpdate.
  if expectedVersion == TlsVersion.Tls12 {
    let clientUpdate = match move Client.requestKeyUpdate(&mut client) {
      Result<Progress, TlsError>.Success {..} => 0
      Result<Progress, TlsError>.Failure {error} => clientCode(move error)
    }
    if clientUpdate != 140 { return 21 }
    let serverUpdate = match Server.requestKeyUpdate(&mut server) {
      Result<ServerProgress, ServerError>.Success {..} => 0
      Result<ServerProgress, ServerError>.Failure {error} => serverCode(error)
    }
    if serverUpdate != 114 { return 22 }
  }

  if let Result<ServerProgress, ServerError>.Failure {error} = Server.closeWrite(&mut server) {
    return serverCode(error)
  }
  let pumped32 = run pump(&mut client, &mut server)
  if pumped32 != 0 { return 32 }
  if !Client.closeNotified(&client) { return 33 }
  if let Result<Progress, TlsError>.Failure {error} = move Client.closeWrite(&mut client) {
    return clientCode(move error)
  }
  let pumped34 = run pump(&mut client, &mut server)
  if pumped34 != 0 { return 34 }
  if !Server.closeNotified(&server) { return 35 }
  let closed = match run Server.progress(&mut server) {
    Result<ServerProgress, ServerError>.Success {value} => value.demand == ServerDemand.Closed
    Result<ServerProgress, ServerError>.Failure {..} => false
  }
  if !closed { return 36 }
  return 0
}

// Runs a handshake that should fail. Returns the first error code, or 0.
effect fn versionFailure(
  key: SigningKey,
  leaf: &[u8],
  groups: GroupPolicy,
  serverVersions: VersionPolicy,
  clientVersions: VersionPolicy,
) -> i32
! OutOfMemoryError
? &mut Allocator | &mut Random {
  let chain = [CertificateDer {bytes: leaf}]
  let config = versionedConfig(&chain, AlpnConfig.defaults(), groups, serverVersions)
  let mut server = match run Server.make(&config, move key) {
    Result<Server, ServerError>.Success {value} => move value
    Result<Server, ServerError>.Failure {error} => {
      return serverCode(error)
    }
  }
  let mut client = match move run makeClientVersions(AlpnConfig.defaults(), clientVersions) {
    Result<Client, TlsError>.Success {value} => move value
    Result<Client, TlsError>.Failure {error} => {
      return clientCode(move error)
    }
  }
  return run pump(&mut client, &mut server)
}

// Sends the server flight that answered a TLS 1.2 client to a second client that allows
// TLS 1.3. Returns the second client's error code, or 0.
effect fn replayedFlight(serverVersions: VersionPolicy) -> i32
! OutOfMemoryError
? &mut Allocator | &mut Random {
  let chain = [CertificateDer {bytes: leaf256Der()}]
  let config = versionedConfig(&chain, AlpnConfig.defaults(), GroupPolicy.defaults(), serverVersions)
  let mut server = match run Server.make(&config, p256Key(leaf256Secret())) {
    Result<Server, ServerError>.Success {value} => move value
    Result<Server, ServerError>.Failure {error} => {
      return serverCode(error)
    }
  }
  let mut legacy = match move run makeClientVersions(AlpnConfig.defaults(), VersionPolicy.tls12()) {
    Result<Client, TlsError>.Success {value} => move value
    Result<Client, TlsError>.Failure {error} => {
      return clientCode(move error)
    }
  }
  let mut modern = match move run makeClientVersions(AlpnConfig.defaults(), VersionPolicy.defaults()) {
    Result<Client, TlsError>.Success {value} => move value
    Result<Client, TlsError>.Failure {error} => {
      return clientCode(move error)
    }
  }
  let fed = run Server.feedInput(&mut server, Client.pendingOutput(&legacy))
  if let Result<ServerProgress, ServerError>.Failure {error} = move fed {
    return serverCode(error)
  }
  let hello = Client.pendingOutput(&modern).length
  if let Result<Progress, TlsError>.Failure {error} = move Client.ackWritten(&mut modern, hello) {
    return clientCode(move error)
  }
  let answered = run Client.feedInput(&mut modern, Server.pendingOutput(&server))
  return match move answered {
    Result<Progress, TlsError>.Success {..} => 0
    Result<Progress, TlsError>.Failure {error} => clientCode(move error)
  }
}

effect fn tls12Cases() -> i32
! OutOfMemoryError
? &mut Allocator | &mut Random {
  let h2 = [AlpnProtocol {bytes: b"h2"}, AlpnProtocol {bytes: b"http/1.1"}]
  let serverAlpn = [AlpnProtocol {bytes: b"http/1.1"}, AlpnProtocol {bytes: b"h2"}]
  let x25519 = GroupPolicy.defaults()
  let p256Only = GroupPolicy {x25519: false, p256: true, p384: false}
  let p384Only = GroupPolicy {x25519: false, p256: false, p384: true}

  // ECDSA P-256 over X25519, with ALPN in server preference order.
  let ecdsa = run versioned(
    p256Key(leaf256Secret()),
    leaf256Der(),
    x25519,
    VersionPolicy.tls12(),
    VersionPolicy.defaults(),
    offeredAlpn(&serverAlpn, false),
    offeredAlpn(&h2, true),
    TlsVersion.Tls12,
    CipherSuite.EcdheEcdsaChaCha20Poly1305Sha256,
    ServerGroup.X25519,
    b"http/1.1",
  )
  if ecdsa != 0 { return 100 + ecdsa }

  // ECDSA P-384 over P-256.
  let ecdsa384 = run versioned(
    p384Key(leaf384Secret()),
    leaf384Der(),
    p256Only,
    VersionPolicy.defaults(),
    VersionPolicy.tls12(),
    AlpnConfig.defaults(),
    AlpnConfig.defaults(),
    TlsVersion.Tls12,
    CipherSuite.EcdheEcdsaChaCha20Poly1305Sha256,
    ServerGroup.P256,
    b"",
  )
  if ecdsa384 != 0 { return 200 + ecdsa384 }

  // RSA over P-384.
  let rsa = run versioned(
    rsaKey(false),
    leafRsaDer(),
    p384Only,
    VersionPolicy.tls12(),
    VersionPolicy.tls12(),
    AlpnConfig.defaults(),
    AlpnConfig.defaults(),
    TlsVersion.Tls12,
    CipherSuite.EcdheRsaChaCha20Poly1305Sha256,
    ServerGroup.P384,
    b"",
  )
  if rsa != 0 { return 300 + rsa }

  // Both sides allow TLS 1.3, so they pick it.
  let both = run versioned(
    p256Key(leaf256Secret()),
    leaf256Der(),
    x25519,
    VersionPolicy.defaults(),
    VersionPolicy.defaults(),
    AlpnConfig.defaults(),
    AlpnConfig.defaults(),
    TlsVersion.Tls13,
    CipherSuite.ChaCha20Poly1305Sha256,
    ServerGroup.X25519,
    b"",
  )
  if both != 0 { return 400 + both }

  // No shared version.
  let oldClient = run versionFailure(
    p256Key(leaf256Secret()),
    leaf256Der(),
    x25519,
    VersionPolicy.tls13(),
    VersionPolicy.tls12(),
  )
  if oldClient != 107 { return 500 + oldClient }
  let oldServer = run versionFailure(
    p256Key(leaf256Secret()),
    leaf256Der(),
    x25519,
    VersionPolicy.tls12(),
    VersionPolicy.tls13(),
  )
  if oldServer != 107 { return 600 + oldServer }

  // An Ed25519 key serves no TLS 1.2 suite.
  let ed = run versionFailure(
    edKey(leafEdSeed()),
    leafEdDer(),
    x25519,
    VersionPolicy.tls12(),
    VersionPolicy.defaults(),
  )
  if ed != 108 { return 700 + ed }

  // A server that allows TLS 1.3 marks a TLS 1.2 ServerHello, and a client that allows TLS 1.3
  // rejects it. Without the mark, the same client gets past the ServerHello and fails on the
  // ServerKeyExchange signature, which covers the other client's random.
  let marked = run replayedFlight(VersionPolicy.defaults())
  if marked != 132 { return 800 + marked }
  let unmarked = run replayedFlight(VersionPolicy.tls12())
  if unmarked == 0 || unmarked == 132 { return 900 + unmarked }
  return 0
}

fn clientAuthConfig<'a>(
  certificates: &'a [CertificateDer<'a>],
  trust: &'a TrustSnapshot,
  at: &'a Instant,
  required: bool,
  rejectUntrusted: bool,
  versions: VersionPolicy,
) -> ServerConfig<'a> {
  return ServerConfig<'a> {
    certificates: certificates,
    alpn: AlpnConfig<'a>.Disabled,
    groups: GroupPolicy.defaults(),
    clientAuth: ClientAuth<'a>.Request {
      trust: trust,
      validationTime: at,
      required: required,
      rejectUntrusted: rejectUntrusted,
    },
    tickets: TicketPolicy<'a>.Off,
    versions: versions,
    limits: ServerLimits.defaults(),
  }
}

// A server that asks for a client certificate, against the Silk client, which sends none. Returns
// 0 when the handshake completes with an `Absent` status and data flows, or an error code.
effect fn clientAuthAbsent(required: bool, versions: VersionPolicy) -> i32
! OutOfMemoryError
? &mut Allocator | &mut Random {
  let made = run TrustSnapshot.fromPem(rootPem(), TrustLoadLimits.defaults())
  let trust = match move made {
    Result<TrustSnapshot, TrustSourceError>.Success {value} => move value
    Result<TrustSnapshot, TrustSourceError>.Failure {..} => { return 60 }
  }
  let at = SystemClock.make(1789156800, 0)
  let chain = [CertificateDer {bytes: leaf256Der()}, CertificateDer {bytes: rootDer()}]
  let config = clientAuthConfig(&chain, &trust, &at, required, true, VersionPolicy.defaults())
  let mut server = match run Server.make(&config, p256Key(leaf256Secret())) {
    Result<Server, ServerError>.Success {value} => move value
    Result<Server, ServerError>.Failure {error} => {
      return serverCode(error)
    }
  }
  let pending = match &Server.clientCertificateStatus(&server).* {
    ClientCertificateStatus.Pending => true
    _ => false
  }
  if !pending { return 61 }
  let mut client = match move run makeClientWith(AlpnConfig.defaults(), ClientCredential.None, versions) {
    Result<Client, TlsError>.Success {value} => move value
    Result<Client, TlsError>.Failure {error} => {
      return clientCode(move error)
    }
  }
  let pumpedCode = run pump(&mut client, &mut server)
  if pumpedCode != 0 { return pumpedCode }
  let negotiated = match Server.version(&server) {
    Option<TlsVersion>.Some {value} => value == versions.maximum()
    Option<TlsVersion>.None => false
  }
  if !negotiated { return 59 }
  let absent = match &Server.clientCertificateStatus(&server).* {
    ClientCertificateStatus.Absent => true
    _ => false
  }
  if !absent { return 62 }
  if Server.clientCertificates(&server).length != 0 { return 63 }
  if !writeClient(&mut client, b"no certificate") { return 64 }
  let moved = run pump(&mut client, &mut server)
  if moved != 0 { return moved }
  if !readServer(&mut server, b"no certificate") { return 65 }
  return 0
}

// A server that asks for a client certificate, against the Silk client presenting `certificates`
// with `key`. Returns 0 when the status is `Trusted` with the presented leaf and data flows, 1 when
// it is `Untrusted` and data flows, or an error code.
effect fn clientAuthPresented<'a>(
  certificates: &'a [CertificateDer<'a>],
  key: SigningKey,
  rejectUntrusted: bool,
  versions: VersionPolicy,
) -> i32
! OutOfMemoryError
? &mut Allocator | &mut Random {
  let made = run TrustSnapshot.fromPem(rootPem(), TrustLoadLimits.defaults())
  let trust = match move made {
    Result<TrustSnapshot, TrustSourceError>.Success {value} => move value
    Result<TrustSnapshot, TrustSourceError>.Failure {..} => { return 70 }
  }
  let at = SystemClock.make(1789156800, 0)
  let chain = [CertificateDer {bytes: leaf256Der()}, CertificateDer {bytes: rootDer()}]
  let config = clientAuthConfig(&chain, &trust, &at, true, rejectUntrusted, VersionPolicy.defaults())
  let mut server = match run Server.make(&config, p256Key(leaf256Secret())) {
    Result<Server, ServerError>.Success {value} => move value
    Result<Server, ServerError>.Failure {error} => {
      return serverCode(error)
    }
  }
  let credential = ClientCredential.Certificate {certificates: certificates, key: move key}
  let mut client = match move run makeClientWith(AlpnConfig.defaults(), move credential, versions) {
    Result<Client, TlsError>.Success {value} => move value
    Result<Client, TlsError>.Failure {error} => {
      return clientCode(move error)
    }
  }
  let pumpedCode = run pump(&mut client, &mut server)
  if pumpedCode != 0 { return pumpedCode }
  let negotiated = match Server.version(&server) {
    Option<TlsVersion>.Some {value} => value == versions.maximum()
    Option<TlsVersion>.None => false
  }
  if !negotiated { return 59 }
  let mut result: i32 = 0
  let status = match &Server.clientCertificateStatus(&server).* {
    ClientCertificateStatus.Trusted => 0
    ClientCertificateStatus.Untrusted {..} => 1
    _ => 2
  }
  if status == 2 { return 71 }
  result = status
  let received = Server.clientCertificates(&server)
  if received.length != certificates.length { return 72 }
  drop received
  if !writeClient(&mut client, b"with certificate") { return 73 }
  let moved = run pump(&mut client, &mut server)
  if moved != 0 { return moved }
  if !readServer(&mut server, b"with certificate") { return 74 }
  if !writeServer(&mut server, b"seen") { return 75 }
  let back = run pump(&mut client, &mut server)
  if back != 0 { return back }
  if !readClient(&mut client, b"seen") { return 76 }
  return result
}

fn presented<'a>(certificates: &'a [CertificateDer<'a>], key: SigningKey) -> ClientCredential<'a> {
  return ClientCredential<'a>.Certificate {certificates: certificates, key: move key}
}

// A client chain larger than one record, so the client sends its Certificate in two records.
// Returns 0 or 1 as `clientAuthPresented` does, or an error code.
effect fn largeCredential() -> i32
! OutOfMemoryError
? &mut Allocator | &mut Random {
  let made = run TrustSnapshot.fromPem(rootPem(), TrustLoadLimits.defaults())
  let trust = match move made {
    Result<TrustSnapshot, TrustSourceError>.Success {value} => move value
    Result<TrustSnapshot, TrustSourceError>.Failure {..} => { return 80 }
  }
  let clientTrust = match run TrustSnapshot.fromPem(rootPem(), TrustLoadLimits.defaults()) {
    Result<TrustSnapshot, TrustSourceError>.Success {value} => move value
    Result<TrustSnapshot, TrustSourceError>.Failure {..} => { return 81 }
  }
  let at = SystemClock.make(1789156800, 0)
  let serverChain = [CertificateDer {bytes: leaf256Der()}]
  let serverConfig = clientAuthConfig(&serverChain, &trust, &at, true, false, VersionPolicy.tls13())
  let mut server = match run Server.make(&serverConfig, p256Key(leaf256Secret())) {
    Result<Server, ServerError>.Success {value} => move value
    Result<Server, ServerError>.Failure {error} => {
      return serverCode(error)
    }
  }
  // The padding certificate carries a 17 KB extension, so the chain does not fit one record.
  let chain = [CertificateDer {bytes: client256Der()}, CertificateDer {bytes: paddingDer()}]
  let config = ClientConfig {
    reference: reference(b"example.com"),
    alpn: AlpnConfig.defaults(),
    resumption: Resumption.Disabled,
    versions: VersionPolicy.tls13(),
    limits: ClientLimits.defaults(),
  }
  let credential = presented(&chain, p256Key(client256Secret()))
  let mut client = match run Client.make(&config, move clientTrust, SystemClock.make(1789156800, 0), move credential) {
    Result<Client, TlsError>.Success {value} => move value
    Result<Client, TlsError>.Failure {error} => {
      return clientCode(move error)
    }
  }
  let pumpedCode = run pump(&mut client, &mut server)
  if pumpedCode != 0 { return pumpedCode }
  if Server.clientCertificates(&server).length != 2 { return 82 }
  let status = match &Server.clientCertificateStatus(&server).* {
    ClientCertificateStatus.Trusted => 0
    ClientCertificateStatus.Untrusted {..} => 1
    _ => 2
  }
  if status == 2 { return 83 }
  if !writeClient(&mut client, b"large") { return 84 }
  let moved = run pump(&mut client, &mut server)
  if moved != 0 { return moved }
  if !readServer(&mut server, b"large") { return 85 }
  return status
}

// Returns 0 when `Client.make` takes the credential, or the client error code.
effect fn credentialFailure<'a>(certificates: &'a [CertificateDer<'a>], key: SigningKey) -> i32
! OutOfMemoryError
? &mut Allocator | &mut Random {
  let credential = ClientCredential.Certificate {certificates: certificates, key: move key}
  return match move run makeClientWith(AlpnConfig.defaults(), move credential, VersionPolicy.tls13()) {
    Result<Client, TlsError>.Success {..} => 0
    Result<Client, TlsError>.Failure {error} => clientCode(move error)
  }
}

effect fn makeFailure(certificates: &[CertificateDer<'static>], key: SigningKey) -> i32
! OutOfMemoryError
? &mut Allocator {
  let config = serverConfig(certificates, AlpnConfig.defaults(), GroupPolicy.defaults())
  return match run Server.make(&config, move key) {
    Result<Server, ServerError>.Success {..} => 0
    Result<Server, ServerError>.Failure {error} => serverCode(error)
  }
}

// A raw ClientHello that offers only TLS 1.2.
effect fn tls12Only() -> i32 ! OutOfMemoryError ? &mut Allocator | &mut Random {
  let chain = [CertificateDer {bytes: leaf256Der()}]
  let config = serverConfig(&chain, AlpnConfig.defaults(), GroupPolicy.defaults())
  let mut server = match run Server.make(&config, p256Key(leaf256Secret())) {
    Result<Server, ServerError>.Success {value} => move value
    Result<Server, ServerError>.Failure {error} => {
      return serverCode(error)
    }
  }
  let hello = b"\x16\x03\x01\x00\x34\x01\x00\x00\x30\x03\x03\x01\x02\x03\x04\x05\x06\x07\x08\x09\x0a\x0b\x0c\x0d\x0e\x0f\x10\x11\x12\x13\x14\x15\x16\x17\x18\x19\x1a\x1b\x1c\x1d\x1e\x1f\x20\x00\x00\x02\xc0\x2b\x01\x00\x00\x05\xff\x01\x00\x01\x00"
  return match run Server.feedInput(&mut server, hello) {
    Result<ServerProgress, ServerError>.Success {..} => 1
    Result<ServerProgress, ServerError>.Failure {error} => serverCode(error)
  }
}

fn pendingIs(server: &Server, offset: usize, expected: &[u8]) -> bool {
  let pending = Server.pendingOutput(server)
  if pending.length < offset + expected.length { return false }
  return sameBytes(Slice.view<u8>(pending, offset, expected.length), expected)
}

fn ackAll(server: &mut Server) -> bool {
  let length = Server.pendingOutput(&server.*).length
  return match Server.ackWritten(&mut server.*, length) {
    Result<ServerProgress, ServerError>.Success {..} => true
    Result<ServerProgress, ServerError>.Failure {..} => false
  }
}

// A ClientHello recorded from OpenSSL 3.5: AES-256-GCM first, an X25519MLKEM768 share before the
// X25519 share, a 32-byte legacy session ID, SNI, and ALPN.
effect fn recordedHello(groups: GroupPolicy, key: SigningKey, leaf: &[u8]) -> i32
! OutOfMemoryError
? &mut Allocator | &mut Random {
  let chain = [CertificateDer {bytes: leaf}]
  let serverAlpn = [AlpnProtocol {bytes: b"http/1.1"}, AlpnProtocol {bytes: b"h2"}]
  let config = serverConfig(&chain, offeredAlpn(&serverAlpn, false), groups)
  let mut server = match run Server.make(&config, move key) {
    Result<Server, ServerError>.Success {value} => move value
    Result<Server, ServerError>.Failure {error} => {
      return serverCode(error)
    }
  }
  let hello = openSslHello()
  let fed = run Server.feedInput(&mut server, hello)
  let consumed = match move fed {
    Result<ServerProgress, ServerError>.Success {value} => value.consumed
    Result<ServerProgress, ServerError>.Failure {error} => {
      return serverCode(error)
    }
  }
  if consumed != hello.length { return 1 }
  let name = match Server.serverName(&server) {
    Option<&[u8]>.Some {value} => sameBytes(value, b"example.com")
    Option<&[u8]>.None => false
  }
  if !name { return 2 }
  let alpn = match Server.selectedAlpn(&server) {
    Option<&[u8]>.Some {value} => sameBytes(value, b"http/1.1")
    Option<&[u8]>.None => false
  }
  if !alpn { return 3 }
  // The reply echoes the 32-byte session ID, so the cipher suite sits at offset 76.
  if !pendingIs(&server, 0, b"\x16\x03\x03") { return 4 }
  if !pendingIs(&server, 5, b"\x02") { return 5 }
  if !pendingIs(&server, 43, b"\x20") { return 6 }
  if !pendingIs(&server, 76, b"\x13\x02\x00") { return 7 }
  if Server.retried(&server) {
    // HelloRetryRequest: the special random and a P-256 key share request.
    if !pendingIs(&server, 11, b"\xcf\x21\xad\x74\xe5\x9a\x61\x11") { return 8 }
    if !pendingIs(&server, 87, b"\x00\x33\x00\x02\x00\x17") { return 9 }
  } else {
    // ServerHello: supported_versions, then an X25519 key share.
    if !pendingIs(&server, 81, b"\x00\x2b\x00\x02\x03\x04\x00\x33\x00\x24\x00\x1d\x00\x20") { return 10 }
  }
  if !ackAll(&mut server) { return 11 }
  // The middlebox compatibility change_cipher_spec record follows the first handshake message.
  if !pendingIs(&server, 0, b"\x14\x03\x03\x00\x01\x01") { return 12 }
  if Server.pendingOutput(&server).length != 6 { return 13 }
  if !ackAll(&mut server) { return 14 }
  if Server.retried(&server) {
    if Server.pendingOutput(&server).length != 0 { return 15 }
    // The same ClientHello again has no P-256 share.
    return match run Server.feedInput(&mut server, hello) {
      Result<ServerProgress, ServerError>.Success {..} => 16
      Result<ServerProgress, ServerError>.Failure {error} => serverCode(error)
    }
  }
  // The encrypted flight, protected with the SHA-384 handshake keys.
  if !pendingIs(&server, 0, b"\x17\x03\x03") { return 17 }
  if !ackAll(&mut server) { return 18 }
  if Server.pendingOutput(&server).length != 0 { return 19 }
  return 0
}

fn ticketConfig<'a>(
  certificates: &'a [CertificateDer<'a>],
  groups: GroupPolicy,
  clientAuth: ClientAuth<'a>,
  key: &'a TicketKey,
  now: &'a Instant,
  count: usize,
) -> ServerConfig<'a> {
  return earlyConfig(certificates, groups, clientAuth, key, now, count, 0)
}

fn earlyConfig<'a>(
  certificates: &'a [CertificateDer<'a>],
  groups: GroupPolicy,
  clientAuth: ClientAuth<'a>,
  key: &'a TicketKey,
  now: &'a Instant,
  count: usize,
  maxEarlyData: usize,
) -> ServerConfig<'a> {
  return ServerConfig<'a> {
    certificates: certificates,
    alpn: AlpnConfig<'a>.Disabled,
    groups: groups,
    clientAuth: clientAuth,
    tickets: TicketPolicy<'a>.Issue {
      key: key,
      now: now,
      lifetime: 7200,
      count: count,
      maxEarlyData: maxEarlyData,
    },
    versions: VersionPolicy.tls13(),
    limits: ServerLimits.defaults(),
  }
}

// Bytes in flight between the client and the server, which acknowledge their output as soon as
// it is on the wire, as with a socket.
struct Wires {
  toServer: [u8; 16384],
  toServerLength: usize,
  toClient: [u8; 16384],
  toClientLength: usize,
}

fn wires() -> Wires {
  return Wires {toServer: [0; 16384], toServerLength: 0, toClient: [0; 16384], toClientLength: 0}
}

fn shiftWire(bytes: &mut [u8; 16384], length: usize, count: usize) -> () {
  let mut index = usize.ZERO
  while index + count < length {
    bytes[index] = bytes[index + count]
    index = index + usize.ONE
  }
  return ()
}

// Moves output onto the wires and feeds each side from its wire until nothing moves. Returns 0, or
// an error code.
effect fn wirePump(client: &mut Client, server: &mut Server, wire: &mut Wires) -> i32
! OutOfMemoryError
? &mut Allocator | &mut Random {
  let mut rounds = usize.ZERO
  while rounds < 256 {
    let mut moved = false
    let clientOut = Client.pendingOutput(&client.*).length
    if clientOut > 0 && clientOut <= 16384 - wire.toServerLength {
      let mut index = usize.ZERO
      while index < clientOut {
        wire.toServer[wire.toServerLength + index] = Client.pendingOutput(&client.*)[index]
        index = index + usize.ONE
      }
      wire.toServerLength = wire.toServerLength + clientOut
      if let Result<Progress, TlsError>.Failure {error} = move Client.ackWritten(&mut client.*, clientOut) {
        return clientCode(move error)
      }
      moved = true
    }
    let serverOut = Server.pendingOutput(&server.*).length
    if serverOut > 0 && serverOut <= 16384 - wire.toClientLength {
      let mut index = usize.ZERO
      while index < serverOut {
        wire.toClient[wire.toClientLength + index] = Server.pendingOutput(&server.*)[index]
        index = index + usize.ONE
      }
      wire.toClientLength = wire.toClientLength + serverOut
      if let Result<ServerProgress, ServerError>.Failure {error} = Server.ackWritten(&mut server.*, serverOut) {
        return serverCode(error)
      }
      moved = true
    }
    if wire.toServerLength > 0 {
      let fed = run Server.feedInput(&mut server.*, Slice.view<u8>(&wire.toServer, 0, wire.toServerLength))
      let consumed = match move fed {
        Result<ServerProgress, ServerError>.Success {value} => value.consumed
        Result<ServerProgress, ServerError>.Failure {error} => {
          return serverCode(error)
        }
      }
      if consumed > 0 {
        shiftWire(&mut wire.toServer, wire.toServerLength, consumed)
        wire.toServerLength = wire.toServerLength - consumed
        moved = true
      }
    }
    if wire.toClientLength > 0 {
      let fed = run Client.feedInput(&mut client.*, Slice.view<u8>(&wire.toClient, 0, wire.toClientLength))
      let consumed = match move fed {
        Result<Progress, TlsError>.Success {value} => value.consumed
        Result<Progress, TlsError>.Failure {error} => {
          return clientCode(move error)
        }
      }
      if consumed > 0 {
        shiftWire(&mut wire.toClient, wire.toClientLength, consumed)
        wire.toClientLength = wire.toClientLength - consumed
        moved = true
      }
    }
    if !moved { return 0 }
    rounds = rounds + usize.ONE
  }
  return 99
}

// One resumption of `session` that sends `early` as 0-RTT data. Returns 0 when the handshake
// completes with `status` on both sides, the server read the early data first if it accepted it,
// and data then flows both ways. Otherwise returns an error code.
effect fn earlyConnection<'a>(
  config: &ServerConfig<'a>,
  session: &'a Session,
  early: &'a [u8],
  status: EarlyDataStatus,
  resumed: bool,
) -> i32
! OutOfMemoryError
? &mut Allocator | &mut Random {
  let mut server = match run Server.make(config, p256Key(leaf256Secret())) {
    Result<Server, ServerError>.Success {value} => move value
    Result<Server, ServerError>.Failure {error} => {
      return serverCode(error)
    }
  }
  let mut client = match move run makeClientSession(Option<&Session>.some(session), early, ClientCredential.None) {
    Result<Client, TlsError>.Success {value} => move value
    Result<Client, TlsError>.Failure {error} => {
      return clientCode(move error)
    }
  }
  let offered = status != EarlyDataStatus.NotOffered
  if offered && Client.earlyData(&client) != EarlyDataStatus.Pending { return 80 }
  let mut wire = wires()
  let code = run wirePump(&mut client, &mut server, &mut wire)
  if code != 0 { return code }
  if Server.earlyData(&server) != status && (offered || Server.earlyData(&server) != EarlyDataStatus.NotOffered) {
    return 81
  }
  if status == EarlyDataStatus.Accepted {
    if !readServer(&mut server, early) { return 82 }
    let finished = run wirePump(&mut client, &mut server, &mut wire)
    if finished != 0 { return finished }
  }
  if Client.earlyData(&client) != status { return 83 }
  if Server.resumed(&server) != resumed { return 84 }
  if !writeClient(&mut client, b"after early") { return 85 }
  let moved = run wirePump(&mut client, &mut server, &mut wire)
  if moved != 0 { return moved }
  if !readServer(&mut server, b"after early") { return 86 }
  if !writeServer(&mut server, b"early pong") { return 87 }
  let back = run wirePump(&mut client, &mut server, &mut wire)
  if back != 0 { return back }
  if !readClient(&mut client, b"early pong") { return 88 }
  return 0
}

// 0-RTT data between the Silk client and server. Returns 0 or an error code.
effect fn earlyData() -> i32
! OutOfMemoryError
? &mut Allocator | &mut Random {
  let none: [u8; 0] = []
  let keyBytes: [u8; 48] = [7; 48]
  let key = TicketKey.make(&keyBytes)
  let otherBytes: [u8; 48] = [8; 48]
  let otherKey = TicketKey.make(&otherBytes)
  let at = SystemClock.make(1789156800, 0)
  let skewed = SystemClock.make(1789156800 + 30, 0)
  let chain = [CertificateDer {bytes: leaf256Der()}, CertificateDer {bytes: rootDer()}]
  let config = earlyConfig(&chain, GroupPolicy.defaults(), ClientAuth.Off, &key, &at, 1, 16)
  let mut taken = Option<Session>.none()
  let full = run ticketConnection(&config, Option<&Session>.none(), &none, ClientCredential.None, false, &mut taken)
  if full != 0 { return 100 + full }
  let session = match move taken {
    Option<Session>.Some {value} => move value
    Option<Session>.None => { return 1 }
  }
  if session.maxEarlyData() != 16 { return 2 }
  let ping: [u8; 10] = [101, 97, 114, 108, 121, 32, 112, 105, 110, 103]
  let long: [u8; 17] = [1; 17]

  let accepted = run earlyConnection(&config, &session, &ping, EarlyDataStatus.Accepted, true)
  if accepted != 0 { return 200 + accepted }
  // More than the ticket allows is not offered.
  let tooLong = run earlyConnection(&config, &session, &long, EarlyDataStatus.NotOffered, true)
  if tooLong != 0 { return 300 + tooLong }
  // A server that cannot open the ticket does a full handshake and skips the early data.
  let otherConfig = earlyConfig(&chain, GroupPolicy.defaults(), ClientAuth.Off, &otherKey, &at, 1, 16)
  let unknown = run earlyConnection(&otherConfig, &session, &ping, EarlyDataStatus.Rejected, false)
  if unknown != 0 { return 400 + unknown }
  // A HelloRetryRequest rejects the early data, and the session still resumes.
  let p256Only = GroupPolicy {x25519: false, p256: true, p384: false}
  let retryConfig = earlyConfig(&chain, p256Only, ClientAuth.Off, &key, &at, 1, 16)
  let retried = run earlyConnection(&retryConfig, &session, &ping, EarlyDataStatus.Rejected, true)
  if retried != 0 { return 500 + retried }
  // A ticket age 30 seconds off rejects the early data, and the session still resumes.
  let skewedConfig = earlyConfig(&chain, GroupPolicy.defaults(), ClientAuth.Off, &key, &skewed, 1, 16)
  let late = run earlyConnection(&skewedConfig, &session, &ping, EarlyDataStatus.Rejected, true)
  if late != 0 { return 600 + late }

  // A session without early data offers none, and make checks the early data length.
  let plainConfig = ticketConfig(&chain, GroupPolicy.defaults(), ClientAuth.Off, &key, &at, 1)
  let mut plainTaken = Option<Session>.none()
  let plainFull = run ticketConnection(&plainConfig, Option<&Session>.none(), &none, ClientCredential.None, false, &mut plainTaken)
  if plainFull != 0 { return 700 + plainFull }
  let plain = match move plainTaken {
    Option<Session>.Some {value} => move value
    Option<Session>.None => { return 3 }
  }
  let notOffered = run earlyConnection(&plainConfig, &plain, &ping, EarlyDataStatus.NotOffered, true)
  if notOffered != 0 { return 800 + notOffered }
  let huge: [u8; 16385] = [0; 16385]
  let refused = match move run makeClientSession(Option<&Session>.some(&session), &huge, ClientCredential.None) {
    Result<Client, TlsError>.Success {..} => 0
    Result<Client, TlsError>.Failure {error} => clientCode(move error)
  }
  if refused != 139 { return 900 + refused }
  let badPolicy = earlyConfig(&chain, GroupPolicy.defaults(), ClientAuth.Off, &key, &at, 1, 16777217)
  let invalid = match run Server.make(&badPolicy, p256Key(leaf256Secret())) {
    Result<Server, ServerError>.Success {..} => 0
    Result<Server, ServerError>.Failure {error} => serverCode(error)
  }
  if invalid != 125 { return 1000 + invalid }
  return 0
}

effect fn makeClientSession<'a>(
  session: Option<&'a Session>,
  early: &'a [u8],
  credential: ClientCredential<'a>,
) -> Result<
  Client,
  TlsError
>
! OutOfMemoryError
? &mut Allocator | &mut Random {
  let made = run TrustSnapshot.fromPem(rootPem(), TrustLoadLimits.defaults())
  let trust = match move made {
    Result<TrustSnapshot, TrustSourceError>.Success {value} => move value
    Result<TrustSnapshot, TrustSourceError>.Failure {..} => {
      Intrinsic.trap("bad trust")
      return run makeClientSession(session, early, move credential)
    }
  }
  let config = ClientConfig {
    reference: reference(b"example.com"),
    alpn: AlpnConfig.defaults(),
    resumption: Resumption<'a>.Enabled {session: session, earlyData: early},
    versions: VersionPolicy.tls13(),
    limits: ClientLimits.defaults(),
  }
  return run Client.make(&config, move trust, SystemClock.make(1789156800, 0), move credential)
}

// One connection between a server with `config` and a client that offers `session`. Returns 0
// when it completes, data flows both ways, and the server's and client's resumed flags are both
// `resumed`. Otherwise returns an error code. `out` gets the first session that the server
// issued, if any.
effect fn ticketConnection<'a>(
  config: &ServerConfig<'a>,
  session: Option<&'a Session>,
  early: &'a [u8],
  credential: ClientCredential<'a>,
  resumed: bool,
  out: &mut Option<Session>,
) -> i32
! OutOfMemoryError
? &mut Allocator | &mut Random {
  let mut server = match run Server.make(config, p256Key(leaf256Secret())) {
    Result<Server, ServerError>.Success {value} => move value
    Result<Server, ServerError>.Failure {error} => {
      return serverCode(error)
    }
  }
  let mut client = match move run makeClientSession(session, early, move credential) {
    Result<Client, TlsError>.Success {value} => move value
    Result<Client, TlsError>.Failure {error} => {
      return clientCode(move error)
    }
  }
  let code = run pump(&mut client, &mut server)
  if code != 0 { return code }
  if Server.resumed(&server) != resumed { return 70 }
  let authenticated = match Client.authentication(&client) {
    Option.Some {value} => value.resumed() == resumed
    Option.None => false
  }
  if !authenticated { return 72 }
  if !writeClient(&mut client, b"ticket ping") { return 73 }
  let moved = run pump(&mut client, &mut server)
  if moved != 0 { return moved }
  if !readServer(&mut server, b"ticket ping") { return 74 }
  if !writeServer(&mut server, b"ticket pong") { return 75 }
  let back = run pump(&mut client, &mut server)
  if back != 0 { return back }
  if !readClient(&mut client, b"ticket pong") { return 76 }
  out.* = Client.takeSession(&mut client)
  return 0
}

fn sessionCount(client: &mut Client) -> usize {
  let mut count = usize.ZERO
  while true {
    if let Option<Session>.None = Client.takeSession(&mut client.*) { return count }
    count = count + usize.ONE
  }
  return count
}

// Session resumption between the Silk client and server. Returns 0 or an error code.
effect fn resumption() -> i32
! OutOfMemoryError
? &mut Allocator | &mut Random {
  let none: [u8; 0] = []
  let keyBytes: [u8; 48] = [7; 48]
  let key = TicketKey.make(&keyBytes)
  let otherBytes: [u8; 48] = [8; 48]
  let otherKey = TicketKey.make(&otherBytes)
  let at = SystemClock.make(1789156800, 0)
  let later = SystemClock.make(1789156800 + 8000, 0)
  let chain = [CertificateDer {bytes: leaf256Der()}, CertificateDer {bytes: rootDer()}]
  let config = ticketConfig(&chain, GroupPolicy.defaults(), ClientAuth.Off, &key, &at, 2)

  // A full handshake issues two tickets.
  let mut server = match run Server.make(&config, p256Key(leaf256Secret())) {
    Result<Server, ServerError>.Success {value} => move value
    Result<Server, ServerError>.Failure {error} => {
      return serverCode(error)
    }
  }
  let mut client = match move run makeClientSession(Option<&Session>.none(), &none, ClientCredential.None) {
    Result<Client, TlsError>.Success {value} => move value
    Result<Client, TlsError>.Failure {error} => {
      return clientCode(move error)
    }
  }
  let code = run pump(&mut client, &mut server)
  if code != 0 { return code }
  if Server.resumed(&server) { return 1 }
  if sessionCount(&mut client) != 2 { return 2 }

  // The session survives encode and decode.
  let mut taken = Option<Session>.none()
  let full = run ticketConnection(&config, Option<&Session>.none(), &none, ClientCredential.None, false, &mut taken)
  if full != 0 { return 300 + full }
  let issued = match move taken {
    Option<Session>.Some {value} => move value
    Option<Session>.None => { return 3 }
  }
  let mut encoded: [u8; 2048] = [0; 2048]
  let length = match issued.encode(&mut encoded) {
    Result<usize, SessionError>.Success {value} => value
    Result<usize, SessionError>.Failure {..} => { return 4 }
  }
  if length != issued.encodedLength() { return 5 }
  let decoded = match move run Session.decode(Slice.view<u8>(&encoded, 0, length)) {
    Result<Session, SessionError>.Success {value} => move value
    Result<Session, SessionError>.Failure {..} => { return 6 }
  }

  // The decoded session resumes, and the resumed connection issues a new session.
  let mut again = Option<Session>.none()
  let resumedCode = run ticketConnection(&config, Option<&Session>.some(&decoded), &none, ClientCredential.None, true, &mut again)
  if resumedCode != 0 { return 400 + resumedCode }
  let renewed = match move again {
    Option<Session>.Some {value} => move value
    Option<Session>.None => { return 7 }
  }
  let mut ignored = Option<Session>.none()
  let renewedCode = run ticketConnection(&config, Option<&Session>.some(&renewed), &none, ClientCredential.None, true, &mut ignored)
  if renewedCode != 0 { return 500 + renewedCode }

  // A HelloRetryRequest keeps the offer, and the second ClientHello resumes.
  let p256Only = GroupPolicy {x25519: false, p256: true, p384: false}
  let retryConfig = ticketConfig(&chain, p256Only, ClientAuth.Off, &key, &at, 1)
  let retryCode = run ticketConnection(&retryConfig, Option<&Session>.some(&decoded), &none, ClientCredential.None, true, &mut ignored)
  if retryCode != 0 { return 600 + retryCode }

  // Another key, or a server clock past the lifetime, gives a full handshake.
  let otherConfig = ticketConfig(&chain, GroupPolicy.defaults(), ClientAuth.Off, &otherKey, &at, 1)
  let otherCode = run ticketConnection(&otherConfig, Option<&Session>.some(&decoded), &none, ClientCredential.None, false, &mut ignored)
  if otherCode != 0 { return 700 + otherCode }
  let laterConfig = ticketConfig(&chain, GroupPolicy.defaults(), ClientAuth.Off, &key, &later, 1)
  let laterCode = run ticketConnection(&laterConfig, Option<&Session>.some(&decoded), &none, ClientCredential.None, false, &mut ignored)
  if laterCode != 0 { return 800 + laterCode }

  // A server without tickets does a full handshake.
  let plainConfig = serverConfig(&chain, AlpnConfig.Disabled, GroupPolicy.defaults())
  let plainCode = run ticketConnection(&plainConfig, Option<&Session>.some(&decoded), &none, ClientCredential.None, false, &mut ignored)
  if plainCode != 0 { return 900 + plainCode }

  // Client certificates: a trusted session resumes as `Resumed`, and a session without a
  // certificate does not resume on a server that requires one.
  let made = run TrustSnapshot.fromPem(rootPem(), TrustLoadLimits.defaults())
  let trust = match move made {
    Result<TrustSnapshot, TrustSourceError>.Success {value} => move value
    Result<TrustSnapshot, TrustSourceError>.Failure {..} => { return 8 }
  }
  let optional = ClientAuth.Request {trust: &trust, validationTime: &at, required: false, rejectUntrusted: true}
  let required = ClientAuth.Request {trust: &trust, validationTime: &at, required: true, rejectUntrusted: true}
  let optionalConfig = ticketConfig(&chain, GroupPolicy.defaults(), optional, &key, &at, 1)
  let requiredConfig = ticketConfig(&chain, GroupPolicy.defaults(), required, &key, &at, 1)
  let clientChain = [CertificateDer {bytes: client256Der()}, CertificateDer {bytes: rootDer()}]
  let mut trustedSession = Option<Session>.none()
  let presentedCode = run ticketConnection(&optionalConfig, Option<&Session>.none(), &none, presented(&clientChain, p256Key(client256Secret())), false, &mut trustedSession)
  if presentedCode != 0 { return 1000 + presentedCode }
  let trusted = match move trustedSession {
    Option<Session>.Some {value} => move value
    Option<Session>.None => { return 9 }
  }
  let statusCode = run resumedStatus(&requiredConfig, &trusted)
  if statusCode != 0 { return 1100 + statusCode }
  let mut absentSession = Option<Session>.none()
  let absentCode = run ticketConnection(&optionalConfig, Option<&Session>.none(), &none, ClientCredential.None, false, &mut absentSession)
  if absentCode != 0 { return 1200 + absentCode }
  let absent = match move absentSession {
    Option<Session>.Some {value} => move value
    Option<Session>.None => { return 10 }
  }
  let absentResumed = run ticketConnection(&optionalConfig, Option<&Session>.some(&absent), &none, ClientCredential.None, true, &mut ignored)
  if absentResumed != 0 { return 1300 + absentResumed }
  // The client sends no certificate in the full handshake that replaces the session.
  let refused = run ticketConnection(&requiredConfig, Option<&Session>.some(&absent), &none, ClientCredential.None, false, &mut ignored)
  if refused != 120 { return 1400 + refused }

  // Make checks the policy.
  let zeroCount = ticketConfig(&chain, GroupPolicy.defaults(), ClientAuth.Off, &key, &at, 0)
  let invalid = match run Server.make(&zeroCount, p256Key(leaf256Secret())) {
    Result<Server, ServerError>.Success {..} => 0
    Result<Server, ServerError>.Failure {error} => serverCode(error)
  }
  if invalid != 125 { return 1500 + invalid }
  return 0
}

// Resumes `session` on a server that requires a client certificate. Returns 0 when the status is
// `Resumed` and trusted with no certificates, or an error code.
effect fn resumedStatus<'a>(config: &ServerConfig<'a>, session: &'a Session) -> i32
! OutOfMemoryError
? &mut Allocator | &mut Random {
  let mut server = match run Server.make(config, p256Key(leaf256Secret())) {
    Result<Server, ServerError>.Success {value} => move value
    Result<Server, ServerError>.Failure {error} => {
      return serverCode(error)
    }
  }
  let mut client = match move run makeClientSession(Option<&Session>.some(session), Slice.view<u8>(session.ticket(), 0, 0), ClientCredential.None) {
    Result<Client, TlsError>.Success {value} => move value
    Result<Client, TlsError>.Failure {error} => {
      return clientCode(move error)
    }
  }
  let code = run pump(&mut client, &mut server)
  if code != 0 { return code }
  if !Server.resumed(&server) { return 1 }
  let trusted = match &Server.clientCertificateStatus(&server).* {
    ClientCertificateStatus.Resumed {trusted} => trusted
    _ => false
  }
  if !trusted { return 2 }
  if Server.clientCertificates(&server).length != 0 { return 3 }
  return 0
}

effect fn cases() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut random = ScriptedRandom {filled: 0}
  let h2 = [AlpnProtocol {bytes: b"h2"}, AlpnProtocol {bytes: b"http/1.1"}]
  let serverAlpn = [AlpnProtocol {bytes: b"http/1.1"}, AlpnProtocol {bytes: b"h2"}]
  let spdy = [AlpnProtocol {bytes: b"spdy/3"}]
  let offered = offeredAlpn(&h2, true)

  // X25519 with the client's share, ECDSA P-256, and ALPN in server preference order.
  let first = run connection(
    p256Key(leaf256Secret()),
    GroupPolicy.defaults(),
    offeredAlpn(&serverAlpn, false),
    offered,
    leaf256Der(),
    ServerGroup.X25519,
    false,
    b"http/1.1",
  )
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if first != 0 { return 1000 + first }

  // A server without X25519 sends a HelloRetryRequest for P-256.
  let retry = run connection(
    p256Key(leaf256Secret()),
    GroupPolicy {x25519: false, p256: true, p384: true},
    AlpnConfig.defaults(),
    AlpnConfig.defaults(),
    leaf256Der(),
    ServerGroup.P256,
    true,
    b"",
  )
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if retry != 0 { return 2000 + retry }

  // An ECDSA P-384 leaf signs with ecdsa_secp384r1_sha384.
  let p384 = run connection(
    p384Key(leaf384Secret()),
    GroupPolicy.defaults(),
    offeredAlpn(&serverAlpn, true),
    offered,
    leaf384Der(),
    ServerGroup.X25519,
    false,
    b"http/1.1",
  )
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if p384 != 0 { return 3000 + p384 }

  // No shared ALPN protocol.
  let noAlpn = run handshakeFailure(
    p256Key(leaf256Secret()),
    GroupPolicy.defaults(),
    offeredAlpn(&spdy, false),
    offered,
    leaf256Der(),
  )
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if noAlpn != 118 { return 4000 + noAlpn }

  // ALPN required, but the client sends none.
  let missingAlpn = run handshakeFailure(
    p256Key(leaf256Secret()),
    GroupPolicy.defaults(),
    offeredAlpn(&spdy, true),
    AlpnConfig.defaults(),
    leaf256Der(),
  )
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if missingAlpn != 118 { return 5000 + missingAlpn }

  // Only P-384 is allowed, and the client does not support it.
  let noGroup = run handshakeFailure(
    p256Key(leaf256Secret()),
    GroupPolicy {x25519: false, p256: false, p384: true},
    AlpnConfig.defaults(),
    AlpnConfig.defaults(),
    leaf256Der(),
  )
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if noGroup != 109 { return 6000 + noGroup }

  // Configuration errors.
  let empty: [CertificateDer<'static>; 0] = []
  let emptyChain = run makeFailure(&empty, p256Key(leaf256Secret()))
    |> Effect.provideMut<Allocator>(&mut allocator)
  if emptyChain != 101 { return 7000 + emptyChain }
  let chain = [CertificateDer {bytes: leaf256Der()}]
  let mismatch = run makeFailure(&chain, p256Key(otherSecret()))
    |> Effect.provideMut<Allocator>(&mut allocator)
  if mismatch != 103 { return 7100 + mismatch }
  let wrongCurve = run makeFailure(&chain, p384Key(leaf384Secret()))
    |> Effect.provideMut<Allocator>(&mut allocator)
  if wrongCurve != 103 { return 7200 + wrongCurve }
  let garbage = [CertificateDer {bytes: b"\x30\x03\x02\x01\x01"}]
  let undecoded = run makeFailure(&garbage, p256Key(leaf256Secret()))
    |> Effect.provideMut<Allocator>(&mut allocator)
  if undecoded != 102 { return 7300 + undecoded }

  // A client that offers only TLS 1.2.
  let version = run tls12Only()
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if version != 107 { return 8000 + version }

  let recorded = run recordedHello(GroupPolicy.defaults(), p256Key(leaf256Secret()), leaf256Der())
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if recorded != 0 { return 9000 + recorded }
  let recordedRetry = run recordedHello(
    GroupPolicy {x25519: false, p256: true, p384: false},
    p256Key(leaf256Secret()),
    leaf256Der(),
  )
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if recordedRetry != 106 { return 9100 + recordedRetry }

  // An RSA leaf signs with rsa_pss_rsae_sha256, the only RSA scheme the Silk client offers.
  let rsa = run connection(
    rsaKey(false),
    GroupPolicy.defaults(),
    offeredAlpn(&serverAlpn, false),
    offered,
    leafRsaDer(),
    ServerGroup.X25519,
    false,
    b"http/1.1",
  )
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if rsa != 0 { return 10000 + rsa }

  // The Silk client does not offer ed25519, so an Ed25519 server has no scheme to sign with.
  let edScheme = run handshakeFailure(
    edKey(leafEdSeed()),
    GroupPolicy.defaults(),
    AlpnConfig.defaults(),
    AlpnConfig.defaults(),
    leafEdDer(),
  )
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if edScheme != 110 { return 11000 + edScheme }

  // OpenSSL 3.5 offers ed25519 and the RSA-PSS schemes; both keys build a flight for it.
  let recordedEd = run recordedHello(GroupPolicy.defaults(), edKey(leafEdSeed()), leafEdDer())
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if recordedEd != 0 { return 12000 + recordedEd }
  let recordedRsa = run recordedHello(GroupPolicy.defaults(), rsaKey(false), leafRsaDer())
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if recordedRsa != 0 { return 12100 + recordedRsa }

  // A key must match the leaf, within and across key types.
  let edChain = [CertificateDer {bytes: leafEdDer()}]
  let rsaChain = [CertificateDer {bytes: leafRsaDer()}]
  let edOther = run makeFailure(&edChain, edKey(otherEdSeed()))
    |> Effect.provideMut<Allocator>(&mut allocator)
  if edOther != 103 { return 13000 + edOther }
  let rsaOther = run makeFailure(&rsaChain, rsaKey(true))
    |> Effect.provideMut<Allocator>(&mut allocator)
  if rsaOther != 103 { return 13100 + rsaOther }
  let edOnRsa = run makeFailure(&rsaChain, edKey(leafEdSeed()))
    |> Effect.provideMut<Allocator>(&mut allocator)
  if edOnRsa != 103 { return 13200 + edOnRsa }
  let rsaOnEcdsa = run makeFailure(&chain, rsaKey(false))
    |> Effect.provideMut<Allocator>(&mut allocator)
  if rsaOnEcdsa != 103 { return 13300 + rsaOnEcdsa }
  let ecdsaOnEd = run makeFailure(&edChain, p256Key(leaf256Secret()))
    |> Effect.provideMut<Allocator>(&mut allocator)
  if ecdsaOnEd != 103 { return 13400 + ecdsaOnEd }
  let edMatches = run makeFailure(&edChain, edKey(leafEdSeed()))
    |> Effect.provideMut<Allocator>(&mut allocator)
  if edMatches != 0 { return 13500 + edMatches }
  let rsaMatches = run makeFailure(&rsaChain, rsaKey(false))
    |> Effect.provideMut<Allocator>(&mut allocator)
  if rsaMatches != 0 { return 13600 + rsaMatches }

  // Client certificates: the Silk client answers a CertificateRequest with an empty chain.
  let optionalAbsent = run clientAuthAbsent(false, VersionPolicy.tls13())
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if optionalAbsent != 0 { return 14000 + optionalAbsent }
  let requiredAbsent = run clientAuthAbsent(true, VersionPolicy.tls13())
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if requiredAbsent != 120 { return 14100 + requiredAbsent }

  // Without a CertificateRequest, the status stays NotRequested.
  let offChain = [CertificateDer {bytes: leaf256Der()}]
  let offConfig = serverConfig(&offChain, AlpnConfig.defaults(), GroupPolicy.defaults())
  let offServer = match run Server.make(&offConfig, p256Key(leaf256Secret()))
    |> Effect.provideMut<Allocator>(&mut allocator) {
    Result<Server, ServerError>.Success {value} => move value
    Result<Server, ServerError>.Failure {error} => { return 14200 + serverCode(error) }
  }
  let notRequested = match &Server.clientCertificateStatus(&offServer).* {
    ClientCertificateStatus.NotRequested => true
    _ => false
  }
  if !notRequested { return 14300 }

  // The Silk client presents a certificate when asked.
  let p256Client = [CertificateDer {bytes: client256Der()}]
  let p256Trusted = run clientAuthPresented(&p256Client, p256Key(client256Secret()), true, VersionPolicy.tls13())
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if p256Trusted != 0 { return 15000 + p256Trusted }
  let rsaClient = [CertificateDer {bytes: clientRsaDer()}, CertificateDer {bytes: rootDer()}]
  let rsaTrusted = run clientAuthPresented(&rsaClient, rsaKey(true), true, VersionPolicy.tls13())
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if rsaTrusted != 0 { return 15100 + rsaTrusted }
  let serverOnly = [CertificateDer {bytes: clientServerOnlyDer()}]
  let untrusted = run clientAuthPresented(&serverOnly, p256Key(otherSecret()), false, VersionPolicy.tls13())
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if untrusted != 1 { return 15200 + untrusted }
  let rejected = run clientAuthPresented(&serverOnly, p256Key(otherSecret()), true, VersionPolicy.tls13())
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if rejected != 123 { return 15300 + rejected }
  // The server does not ask for ed25519, so an Ed25519 credential sends an empty Certificate.
  let edClient = [CertificateDer {bytes: leafEdDer()}]
  let edAbsent = run clientAuthPresented(&edClient, edKey(leafEdSeed()), true, VersionPolicy.tls13())
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if edAbsent != 120 { return 15400 + edAbsent }

  // The same against a TLS 1.2 client, with a server that also allows TLS 1.3.
  let optional12 = run clientAuthAbsent(false, VersionPolicy.tls12())
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if optional12 != 0 { return 17000 + optional12 }
  let required12 = run clientAuthAbsent(true, VersionPolicy.tls12())
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if required12 != 120 { return 17100 + required12 }
  let p256Trusted12 = run clientAuthPresented(&p256Client, p256Key(client256Secret()), true, VersionPolicy.tls12())
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if p256Trusted12 != 0 { return 17200 + p256Trusted12 }
  let rsaTrusted12 = run clientAuthPresented(&rsaClient, rsaKey(true), true, VersionPolicy.tls12())
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if rsaTrusted12 != 0 { return 17300 + rsaTrusted12 }
  let untrusted12 = run clientAuthPresented(&serverOnly, p256Key(otherSecret()), false, VersionPolicy.tls12())
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if untrusted12 != 1 { return 17400 + untrusted12 }
  let rejected12 = run clientAuthPresented(&serverOnly, p256Key(otherSecret()), true, VersionPolicy.tls12())
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if rejected12 != 123 { return 17500 + rejected12 }
  // Ed25519 cannot sign a TLS 1.2 CertificateVerify by digest, so the client sends no certificate.
  let edAbsent12 = run clientAuthPresented(&edClient, edKey(leafEdSeed()), true, VersionPolicy.tls12())
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if edAbsent12 != 120 { return 17600 + edAbsent12 }

  let large = run largeCredential()
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if large != 0 && large != 1 { return 15450 + large }

  // Client.make checks the credential.
  let noCertificates: [CertificateDer<'static>; 0] = []
  let emptyCode = run credentialFailure(&noCertificates, p256Key(client256Secret()))
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if emptyCode != 145 { return 15500 + emptyCode }
  let undecodable = [CertificateDer {bytes: b"not a certificate"}]
  let decodeCode = run credentialFailure(&undecodable, p256Key(client256Secret()))
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if decodeCode != 146 { return 15600 + decodeCode }
  let mismatchCode = run credentialFailure(&p256Client, p256Key(otherSecret()))
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if mismatchCode != 147 { return 15700 + mismatchCode }
  let typeCode = run credentialFailure(&p256Client, rsaKey(true))
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if typeCode != 147 { return 15800 + typeCode }

  let resumed = run resumption()
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if resumed != 0 { return 16000 + resumed }

  let early = run earlyData()
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if early != 0 { return 18000 + early }

  let tls12 = run tls12Cases()
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Allocator>(&mut allocator)
  if tls12 != 0 { return 19000 + tls12 }
  return 0
}

effect fn recover(error: OutOfMemoryError) -> i32 { return 98 }

pub fn main() -> i32 {
  return run Effect.catchAll(cases(), recover)
}
