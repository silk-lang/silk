unsafe extern "C" fn silk_test_raise_unwind() -> i32
static if Intrinsic.targetOperatingSystem() == "windows" {
  @callbacks("entry")
  unsafe extern "C" fn silk_test_catch_unwind(entry: extern "C" fn() -> i32) -> i32
  export "C" fn guarded() -> i32 { return unsafe silk_test_raise_unwind() }
  pub fn main() -> i32 { return unsafe silk_test_catch_unwind(guarded) }
} else {
  pub fn main() -> i32 { return unsafe silk_test_raise_unwind() }
}
