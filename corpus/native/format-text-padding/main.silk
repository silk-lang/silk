import silk.io.writer_native { StdoutWriter }
import silk.core.effect { Effect }
import silk.format { Alignment, Display, Format, FormatOptions, Formatter, Sign, Style }
import silk.option { Option }
import silk.io.writer { Writer, WriterError }

struct Celsius { tenths: i32 }

// A user number type pads like the standard integers through padNumber.
impl Display for Celsius {
  effect fn display(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    if self.tenths < 0 { return run Format.padNumber(&mut formatter, true, "", "1.5") }
    return run Format.padNumber(&mut formatter, false, "", "2.5")
  }
}

struct Tag { name: string }

// A user text type pads and cuts like a string through padText.
impl Display for Tag {
  effect fn display(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return run Format.padText(&mut formatter, self.name)
  }
}

fn options(width: Option<usize>, alignment: Alignment, fill: char, precision: Option<usize>)
  -> FormatOptions {
  return FormatOptions {
    width: move width, alignment: alignment, fill: fill, sign: Sign.NegativeOnly,
    alternate: false, zeroPad: false, precision: move precision, color: false, style: Style.Default,
  }
}

fn signed(width: usize, sign: Sign, zeroPad: bool) -> FormatOptions {
  return FormatOptions {
    width: Option<usize>.some(width), alignment: Alignment.Default, fill: '.', sign: sign,
    alternate: false, zeroPad: zeroPad, precision: Option<usize>.none(), color: false,
    style: Style.Default,
  }
}

effect fn bar() -> () ! WriterError ? &mut Writer { return run Writer.writeAll(b"|") }

effect fn render() -> () ! WriterError ? &mut Writer {
  let word = "héllo"
  // Text aligns left by default and counts scalars, not bytes.
  run Format.displayWith(&word, options(Option<usize>.some(8), Alignment.Default, '.', Option<usize>.none()))
  run bar()
  run Format.displayWith(&word, options(Option<usize>.some(8), Alignment.Right, '.', Option<usize>.none()))
  run bar()
  run Format.displayWith(&word, options(Option<usize>.some(9), Alignment.Center, '·', Option<usize>.none()))
  run bar()
  // A precision cuts to that many scalars before the width applies.
  run Format.displayWith(&word, options(Option<usize>.some(4), Alignment.Right, '*', Option<usize>.some(2)))
  run bar()
  run Format.displayWith(&word, options(Option<usize>.none(), Alignment.Default, ' ', Option<usize>.some(0)))
  run bar()
  run Format.displayWith(&word, options(Option<usize>.some(2), Alignment.Default, ' ', Option<usize>.none()))
  run bar()
  let yes = true
  run Format.displayWith(&yes, options(Option<usize>.some(6), Alignment.Default, '_', Option<usize>.some(3)))
  run bar()
  let letter = 'ß'
  run Format.displayWith(&letter, options(Option<usize>.some(3), Alignment.Default, '-', Option<usize>.none()))
  run bar()
  let tag = Tag { name: "release" }
  run Format.displayWith(&tag, options(Option<usize>.some(5), Alignment.Right, '>', Option<usize>.some(3)))
  run bar()
  let warm = Celsius { tenths: 25 }
  run Format.displayWith(&warm, signed(6, Sign.Always, false))
  run bar()
  let cold = Celsius { tenths: 0 - 15 }
  run Format.displayWith(&cold, signed(6, Sign.NegativeOnly, true))
  run bar()
  return run Format.displayWith(&warm, signed(2, Sign.Space, true))
}

effect fn build() -> i32 ! WriterError {
  let mut writer = StdoutWriter.make()
  run render() |> Effect.provideMut<Writer>(&mut writer)
  return 42
}
effect fn recover(error: WriterError) -> i32 { return 1 }
pub fn main() -> i32 { return run Effect.catchAll(build(), recover) }
