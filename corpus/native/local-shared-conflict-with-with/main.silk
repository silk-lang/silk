import silk.mem.allocator { Allocator }
import silk.mem.allocator { Allocator, OutOfMemoryError, SystemAllocator }
import silk.core.effect { Effect }
import silk.mem.shared { Shared }
struct Counter { value: i32 }
fn read(value: &Counter) -> i32 { return value.value }
fn increment(value: &mut Counter) -> i32 {
  value.value = value.value + 1
  return value.value
}
fn nested(value: &Counter, alias: Shared<Counter>) -> i32 {
  return Shared<Counter>.with<i32>(&alias, read)
}
effect fn conflictCase() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let first = run (Shared<Counter>.make(Counter { value: 41 })
    |> Effect.provideMut<Allocator>(&mut allocator))
  let alias = Shared<Counter>.clone(&first)
  return Shared<Counter>.with<i32>(&first, nested(move alias))
}
effect fn recover(error: OutOfMemoryError) -> i32 { return 0 }
pub fn main() -> i32 {
  let observed = run Effect.catchAll(conflictCase(), recover)
  drop observed
  return 0
}