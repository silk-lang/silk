struct Token { value: i32 }
struct Pair<'a> { left: &'a Token, right: &'a Token }
struct Couple<'a, 'b> { left: &'a Token, right: &'b Token }
// Aggregates of several loans hold each one where it is placed: reading them in the body, or
// returning a part that only the caller's loans fill, stays checked.
fn sumLocal() -> i32 {
  let first = Token { value: 2 }
  let second = Token { value: 3 }
  let views = [&first, &second]
  let pair = Pair { left: &first, right: &second }
  return views[0].value + views[1].value + pair.left.value + pair.right.value
}
fn bothCaller<'s>(x: &'s Token, y: &'s Token) -> &'s Token {
  let pair = Pair { left: x, right: y }
  let views = [x, y]
  if views[1].value > pair.left.value {
    return pair.right
  }
  return views[0]
}
fn callerSide<'s>(x: &'s Token) -> &'s Token {
  let local = Token { value: 4 }
  let other = Token { value: 5 }
  let couple = Couple { left: x, right: &local }
  let spare = Couple { left: &other, right: &local }
  if couple.right.value + spare.left.value > 100 {
    return x
  }
  return couple.left
}
fn readAfterOverwrite() -> i32 {
  let first = Token { value: 6 }
  let second = Token { value: 7 }
  let mut views = [&first, &first]
  views[1] = &second
  return views[0].value + views[1].value
}
pub fn main() -> i32 {
  let token = Token { value: 1 }
  let other = Token { value: 8 }
  return sumLocal() + bothCaller(&token, &other).value + callerSide(&token).value + readAfterOverwrite()
}
