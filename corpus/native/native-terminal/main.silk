static if (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText("libc") == "gnu") {
import silk.mem.pointer { Pointer }
import silk.num.isize
import silk.num.usize
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.system.terminal { Terminal, TerminalError, WindowSize }

extern "C" struct PollFd { fd: i32, events: i16, revents: i16 }
extern "C" struct Winsize { rows: u16, columns: u16, width: u16, height: u16 }
static if Intrinsic.targetOperatingSystem() == "darwin" {
  @foreign(noCapture: .("fds"))
  unsafe extern "C" fn poll(fds: ?[*]mut PollFd, count: u32, timeout: i32) -> i32
} else {
  @foreign(noCapture: .("fds"))
  unsafe extern "C" fn poll(fds: ?[*]mut PollFd, count: usize, timeout: i32) -> i32
}
@foreign(noCapture: .("buffer"))
unsafe extern "C" fn write(fd: i32, buffer: ?[*]const u8, count: usize) -> isize
@foreign(noCapture: .("buffer"))
unsafe extern "C" fn read(fd: i32, buffer: ?[*]mut u8, count: usize) -> isize
@foreign(noCapture: .("path"))
unsafe extern "C" fn open(path: ?[*]const u8, flags: i32, ...) -> i32
unsafe extern "C" fn close(fd: i32) -> i32
unsafe extern "C" fn posix_openpt(flags: i32) -> i32
unsafe extern "C" fn grantpt(fd: i32) -> i32
unsafe extern "C" fn unlockpt(fd: i32) -> i32
unsafe extern "C" fn ptsname(fd: i32) -> ?[*]const u8
unsafe extern "C" fn ioctl(fd: i32, request: u64, ...) -> i32

static if Intrinsic.targetOperatingSystem() == "darwin" {
  const READ_WRITE_NO_TERMINAL: i32 = 131074
  const SET_WINDOW_SIZE: u64 = 2148037735
} else {
  const READ_WRITE_NO_TERMINAL: i32 = 258
  const SET_WINDOW_SIZE: u64 = 21524
}

fn readable(fd: i32, milliseconds: i32) -> bool {
  let mut watched = [PollFd { fd: fd, events: 1, revents: 0 }]
  return unsafe poll(Pointer.fromMutSlice<PollFd>(&mut watched), 1, milliseconds) == 1
}

// Reads what is ready on `fd` within `milliseconds`, at most 16 bytes.
fn readReady(fd: i32, buffer: &mut [u8; 16], milliseconds: i32) -> usize {
  if !readable(fd, milliseconds) { return 0 }
  let count = unsafe read(fd, Pointer.fromMutSlice<u8>(&mut buffer.*), 16)
  if count <= 0 { return 0 }
  return isize.toUsize(count)
}

fn sendBytes(fd: i32, bytes: &[u8]) -> bool {
  return unsafe write(fd, Pointer.fromSlice<u8>(bytes), bytes.length) == usize.toIsize(bytes.length)
}

effect fn program(primary: i32, secondary: i32) -> i32 ! TerminalError {
  if !Terminal.isTerminal(secondary) || Terminal.isTerminal(-1) { return 1 }

  // The size that the primary side sets is the size of the terminal.
  let size = Winsize { rows: 24, columns: 80, width: 0, height: 0 }
  if unsafe ioctl(primary, SET_WINDOW_SIZE, Pointer.fromRef<Winsize>(&size)) != 0 { return 2 }
  let measured = run Terminal.windowSize(secondary)
  if measured.columns != 80 || measured.rows != 24 { return 3 }

  // Normal mode: a line waits for its end, and a carriage return becomes a newline.
  let normal = run Terminal.mode(secondary)
  let mut buffer: [u8; 16] = [0; 16]
  if !sendBytes(primary, b"a") { return 4 }
  if readReady(secondary, &mut buffer, 100) != 0 { return 5 }
  if !sendBytes(primary, b"\r") { return 6 }
  let line = readReady(secondary, &mut buffer, 5000)
  if line != 2 || buffer[0] != 97 || buffer[1] != 10 { return 7 }
  // Drain the echo of the line.
  let _echo = readReady(primary, &mut buffer, 1000)

  // Raw mode: each byte arrives at once and unchanged, with no echo.
  run Terminal.setMode(secondary, &normal.raw())
  if !sendBytes(primary, b"b\r") { return 8 }
  let raw = readReady(secondary, &mut buffer, 5000)
  if raw != 2 || buffer[0] != 98 || buffer[1] != 13 { return 9 }
  if readReady(primary, &mut buffer, 100) != 0 { return 10 }

  // The mode that was read first gives back line editing.
  run Terminal.setMode(secondary, &normal)
  if !sendBytes(primary, b"c") { return 11 }
  if readReady(secondary, &mut buffer, 100) != 0 { return 12 }

  // A descriptor that is not open has no size.
  return match run Effect.result(Terminal.windowSize(-1)) {
    Result<WindowSize, TerminalError>.Success { .. } => 13
    Result<WindowSize, TerminalError>.Failure { error } => if error.code == 9 { 42 } else { 14 }
  }
}

pub effect fn main() -> i32 {
  let primary = unsafe posix_openpt(READ_WRITE_NO_TERMINAL)
  if primary < 0 { return 20 }
  if unsafe grantpt(primary) != 0 || unsafe unlockpt(primary) != 0 { return 21 }
  let secondary = unsafe open(unsafe ptsname(primary), READ_WRITE_NO_TERMINAL)
  if secondary < 0 { return 22 }
  let result = run Effect.result(program(primary, secondary))
  let _closedSecondary = unsafe close(secondary)
  let _closedPrimary = unsafe close(primary)
  return match move result {
    Result<i32, TerminalError>.Success { value } => value
    Result<i32, TerminalError>.Failure { error } => 100 + error.code
  }
}
} else {
pub fn main() -> i32 { return 42 }
}
