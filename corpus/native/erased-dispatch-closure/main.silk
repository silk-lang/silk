interface Read { fn read(self: &Self) -> i32 }
interface Mark { fn mark(self: &Self) -> i32 }

struct Early { amount: i32 }
struct Late { amount: i32 }

impl Read for Early {
  fn read(self: &Self) -> i32 {
    let late = Late { amount: self.amount + 2 }
    return through(&late)
  }
}
impl Mark for Early { fn mark(self: &Self) -> i32 { return 0 } }
impl Read for Late { fn read(self: &Self) -> i32 { return self.amount } }

fn through(value: &any Read) -> i32 { return value.read() }
fn narrow(value: &any Mark + Read) -> i32 { return through(value) }

pub fn main() -> i32 {
  let first = Early { amount: 40 }
  return narrow(&first)
}
