import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.layout { Layout }
import silk.mem.pointer { Pointer }

interface Read {
  effect fn read(self: &Self) -> i32 ! OutOfMemoryError ? &mut Allocator
}

struct Immediate { value: i32 }
struct Suspended { value: i32 }

effect fn allocate() -> () ! OutOfMemoryError ? &mut Allocator {
  let block = run Allocator.allocate(Layout.of<i32>())
  drop block
}

impl Read for Immediate {
  effect fn read(self: &Self) -> i32 ! OutOfMemoryError ? &mut Allocator {
    run allocate()
    return self.value
  }
}

impl Read for Suspended {
  effect fn read(self: &Self) -> i32 ! OutOfMemoryError ? &mut Allocator {
    let offset = run Effect.suspend(effect { return 2 })
    run allocate()
    return self.value + offset
  }
}

struct Refuse { calls: i32 }

impl Allocator for Refuse {
  effect fn allocate(self: &mut Self, layout: Layout) -> Intrinsic.Allocation ! OutOfMemoryError {
    self.calls = self.calls + 1
    fail OutOfMemoryError {}
  }

  effect fn allocateZeroed(self: &mut Self, layout: Layout) -> Intrinsic.Allocation ! OutOfMemoryError {
    fail OutOfMemoryError {}
  }

  unsafe effect fn takeBlock(self: &mut Self, layout: Layout) -> ?*mut u8 { return Pointer.null<u8>() }
}

effect fn refused(error: OutOfMemoryError) -> i32 { return 9 }

effect fn exercise(receiver: &(Immediate | Suspended)) -> i32 ! OutOfMemoryError {
  let mut system = Allocator.systemAllocatorProvider()
  let mut reject = Refuse { calls: 0 }
  let first = Read.read(receiver)
  let second = Read.read(receiver)
  let value = run first |> Effect.provideMut<Allocator>(&mut system)
  let failure = run Effect.catchAll(second |> Effect.provideMut<Allocator>(&mut reject), refused)
  if reject.calls != 1 || failure != 9 { return 0 }
  return value
}

effect fn both() -> i32 ! OutOfMemoryError {
  let left: Immediate | Suspended = Immediate { value: 13 }
  let right: Immediate | Suspended = Suspended { value: 27 }
  return (run exercise(&left)) + (run exercise(&right))
}

pub fn main() -> i32 { return run Effect.catchAll(both(), refused) }
