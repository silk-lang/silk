import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.concurrency.sync { Arc }
import silk.trace.record { Recorder, Config, Memory }
import silk.trace { Tracer }
import silk.concurrency.execution { Execution, Wake }
fn discard(wake: Wake) -> () { drop wake }
fn ready(state: &()) -> () {}
@trace
effect fn waiting() -> () { run Execution.park(discard) }
fn complete(state: &mut bool, result: ()) -> () { state.* = true }
fn cancel(state: &mut bool, work: Intrinsic.Execution<()>) -> () { drop work }
effect fn create() -> Intrinsic.Execution<()> ! OutOfMemoryError ? &mut Allocator {
  return run Execution.make(waiting(), (), ready)
}
effect fn exercise() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let recorder = run Arc<Recorder>.make(run Recorder.make(Config.make("test")))
  let work = run create() |> Effect.provideAmbient<Tracer>(&recorder)
  let mut completed = false
  run Execution.drive(move work, &mut completed, complete, cancel)
  if completed { return 1 }
  let mut memory = Memory.make()
  run memory.drain(recorder.get())
  let spans = memory.spans()
  if spans.length != 1 { return 2 }
  if spans[0].name != "memory/driver.waiting" || !spans[0].cancelled || !spans[0].error { return 3 }
  return 0
}
effect fn failed(error: OutOfMemoryError) -> i32 { return 99 }
pub fn main() -> i32 {
  let mut alloc = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(exercise() |> Effect.provideMut<Allocator>(&mut alloc), failed)
}
