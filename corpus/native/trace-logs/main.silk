import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.concurrency.sync { Arc }
import silk.io.logger { Logger, InMemoryLogger }
import silk.trace { Trace, Tracer, SpanContext }
import silk.trace.record { Config, Recorder }
import silk.trace.log { OtelLogger, ForwardingLogger }
import silk.trace.signals { LogRecord }
import silk.trace.values { Value }

effect fn inside() -> SpanContext {
  let _span = Trace.span("request")
  let context = match Trace.current() {
    Option<SpanContext>.Some {value} => value
    Option<SpanContext>.None => { Intrinsic.trap("missing span") }
  }
  run Effect.logWarning("retry {attempt}", &.{attempt: 2})
  return context
}
effect fn outside() -> () {
  run Effect.logInfo("ready", &())
}
effect fn fillQueue() -> () {
  run Effect.logDebug("one", &())
  run Effect.logError("two", &())
  run Effect.logTrace("full", &())
}
effect fn exercise() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let mut config = Config.make("logs")
  config.threadCapacity = 1
  config.bufferCapacity = 2
  let recorder = run Arc<Recorder>.make(run Recorder.make(config))
  let inner = run Arc<InMemoryLogger>.make(run Logger.inMemoryProvider())
  let logger = run Arc<ForwardingLogger<InMemoryLogger>>.make(OtelLogger.make(&recorder).forwarding(&inner))
  let current = run inside() |> Effect.provideAmbient<Logger>(&logger) |> Effect.provideAmbient<Tracer>(&recorder)
  run outside() |> Effect.provideAmbient<Logger>(&logger)
  if Logger.length(inner.get()) != 2 { return 1 }
  let first = match recorder.get().signals.takeLog() {
    Option<LogRecord>.Some {value} => value
    Option<LogRecord>.None => { return 2 }
  }
  if first.severity != 13 || first.template != "retry {attempt}" || first.body.view() != "retry 2" { return 3 }
  if first.attributes.count != 1 || first.attributes.items[0].key != "attempt" { return 4 }
  if let Value.Integer {value} = first.attributes.items[0].value {
    if value != 2 { return 5 }
  } else { return 6 }
  if let Option<SpanContext>.Some {value} = first.context {
    if value.traceHigh != current.traceHigh || value.traceLow != current.traceLow || value.span != current.span { return 7 }
  } else { return 8 }
  let second = match recorder.get().signals.takeLog() {
    Option<LogRecord>.Some {value} => value
    Option<LogRecord>.None => { return 9 }
  }
  if second.severity != 9 || second.context.isSome() || second.template != "ready" { return 10 }
  if recorder.get().signals.takeLog().isSome() { return 11 }
  let solo = run Arc<OtelLogger>.make(OtelLogger.make(&recorder))
  run fillQueue() |> Effect.provideAmbient<Logger>(&solo)
  if recorder.get().signals.droppedLogs() != 1 { return 12 }
  if let Option<LogRecord>.Some {value} = recorder.get().signals.takeLog() {
    if value.template != "one" || value.severity != 5 { return 13 }
  } else { return 14 }
  if let Option<LogRecord>.Some {value} = recorder.get().signals.takeLog() {
    if value.template != "two" || value.severity != 17 { return 15 }
  } else { return 16 }
  if recorder.get().signals.takeLog().isSome() { return 17 }
  return 0
}
effect fn failed(error: OutOfMemoryError) -> i32 { return 18 }
pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(exercise() |> Effect.provideMut<Allocator>(&mut allocator), failed)
}
