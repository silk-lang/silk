import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.crypto.dsa { DsaError, DsaParameters, DsaPrivateKey, DsaPublicKey, DsaSignature }
import silk.crypto.modular { ModularError, Natural }
import silk.num.u8
import silk.num.u64
import silk.system.random { Random }

struct Counter {
  state: u64,
}

impl Random for Counter {
  effect fn fillBytes(self: &mut Self, output: &mut [u8]) -> () {
    let mut index: usize = 0
    while index < output.length {
      self.state = u64.wrappingAdd(u64.wrappingMultiply(self.state, 6364136223846793005), 1)
      output[index] = u64.toU8(u64.shiftRight(self.state, 56))
      index = index + 1
    }
  }
}

fn equal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut i: usize = 0
  while i < left.length {
    if left[i] != right[i] {
      return false
    }
    i = i + 1
  }
  return true
}

fn sameNatural(value: &Natural, expected: &[u8]) -> bool {
  let mut bytes: [u8; 1024] = [0; 1024]
  let output = Slice.viewMut<u8>(&mut bytes, 0, expected.length)
  return match value.writeBytes(move output) {
    Result<(), ModularError>.Success { value: _ } => equal(Slice.view<u8>(&bytes, 0, expected.length), expected)
    Result<(), ModularError>.Failure { error: _ } => false
  }
}

fn ok(result: Result<(), DsaError>) -> bool {
  return match move result {
    Result<(), DsaError>.Success { value: _ } => true
    Result<(), DsaError>.Failure { error: _ } => false
  }
}

fn failsWith(result: Result<(), DsaError>, expected: DsaError) -> bool {
  return match move result {
    Result<(), DsaError>.Success { value: _ } => false
    Result<(), DsaError>.Failure { error } => error == expected
  }
}

fn parameters(p: &[u8], q: &[u8], g: &[u8]) -> DsaParameters {
  return match DsaParameters.fromComponents(p, q, g) {
    Result<DsaParameters, DsaError>.Success { value } => value
    Result<DsaParameters, DsaError>.Failure { error: _ } => Intrinsic.trap("parameters")
  }
}

fn privateKey(parameters: &DsaParameters, x: &[u8]) -> DsaPrivateKey {
  return match DsaPrivateKey.fromComponents(parameters, x) {
    Result<DsaPrivateKey, DsaError>.Success { value } => value
    Result<DsaPrivateKey, DsaError>.Failure { error: _ } => Intrinsic.trap("key")
  }
}

fn parametersFail(p: &[u8], q: &[u8], g: &[u8]) -> bool {
  return match DsaParameters.fromComponents(p, q, g) {
    Result<DsaParameters, DsaError>.Success { value: _ } => false
    Result<DsaParameters, DsaError>.Failure { error } => error == DsaError.InvalidParameters
  }
}

fn keyFails(parameters: &DsaParameters, x: &[u8]) -> bool {
  return match DsaPrivateKey.fromComponents(parameters, x) {
    Result<DsaPrivateKey, DsaError>.Success { value: _ } => false
    Result<DsaPrivateKey, DsaError>.Failure { error } => error == DsaError.InvalidKey
  }
}

fn fromDerEquals(der: &[u8], expected: &[u8]) -> bool {
  let mut output: [u8; 64] = [0; 64]
  let raw = Slice.viewMut<u8>(&mut output, 0, expected.length)
  if !ok(DsaSignature.fromDer(der, move raw)) {
    return false
  }
  return equal(Slice.view<u8>(&output, 0, expected.length), expected)
}

fn toDerEquals(raw: &[u8], expected: &[u8]) -> bool {
  let mut output: [u8; 80] = [0; 80]
  if DsaSignature.derLength(raw) != expected.length {
    return false
  }
  return match DsaSignature.toDer(raw, &mut output) {
    Result<usize, DsaError>.Success { value } => equal(Slice.view<u8>(&output, 0, value), expected)
    Result<usize, DsaError>.Failure { error: _ } => false
  }
}

fn written(result: Result<usize, DsaError>, output: &[u8], expected: &[u8]) -> bool {
  return match move result {
    Result<usize, DsaError>.Success { value } => equal(Slice.view<u8>(output, 0, value), expected)
    Result<usize, DsaError>.Failure { error: _ } => false
  }
}

fn spkiRoundTrip(der: &[u8], y: &[u8]) -> bool {
  let key = match DsaPublicKey.fromSpkiDer(der) {
    Result<DsaPublicKey, DsaError>.Success { value } => value
    Result<DsaPublicKey, DsaError>.Failure { error: _ } => {
      return false
    }
  }
  if !sameNatural(&key.publicValue(), y) || key.spkiDerLength() != der.length {
    return false
  }
  let mut output: [u8; 2048] = [0; 2048]
  return written(key.writeSpkiDer(&mut output), &output, der)
}

fn pkcs8RoundTrip(der: &[u8], x: &[u8]) -> bool {
  let key = match DsaPrivateKey.fromPkcs8Der(der) {
    Result<DsaPrivateKey, DsaError>.Success { value } => value
    Result<DsaPrivateKey, DsaError>.Failure { error: _ } => {
      return false
    }
  }
  if !sameNatural(&key.secret(), x) || key.pkcs8DerLength() != der.length {
    return false
  }
  let mut output: [u8; 2048] = [0; 2048]
  return written(key.writePkcs8Der(&mut output), &output, der)
}

fn traditionalRoundTrip(der: &[u8], x: &[u8]) -> bool {
  let key = match DsaPrivateKey.fromTraditionalDer(der) {
    Result<DsaPrivateKey, DsaError>.Success { value } => value
    Result<DsaPrivateKey, DsaError>.Failure { error: _ } => {
      return false
    }
  }
  if !sameNatural(&key.secret(), x) || key.traditionalDerLength() != der.length {
    return false
  }
  let mut output: [u8; 2048] = [0; 2048]
  return written(key.writeTraditionalDer(&mut output), &output, der)
}

fn parametersRoundTrip(der: &[u8]) -> bool {
  let value = match DsaParameters.fromDer(der) {
    Result<DsaParameters, DsaError>.Success { value } => value
    Result<DsaParameters, DsaError>.Failure { error: _ } => {
      return false
    }
  }
  if value.derLength() != der.length {
    return false
  }
  let mut output: [u8; 2048] = [0; 2048]
  return written(value.writeDer(&mut output), &output, der)
}

effect fn signCase(key: &DsaPrivateKey, digest: &[u8]) -> bool ! DsaError ? &mut Random {
  let mut signature: [u8; 64] = [0; 64]
  let length = key.parameters().signatureLength()
  run key.signDigest(digest, Slice.viewMut<u8>(&mut signature, 0, length))
  let publicKey = key.publicKey()
  if !ok(publicKey.verifyDigest(digest, Slice.view<u8>(&signature, 0, length))) {
    return false
  }
  signature[length - 1] = u8.bitXor(signature[length - 1], 1)
  return failsWith(publicKey.verifyDigest(digest, Slice.view<u8>(&signature, 0, length)), DsaError.InvalidSignature)
}

fn signsAndVerifies(key: &DsaPrivateKey, digest: &[u8], seed: u64) -> bool {
  let mut random = Counter { state: seed }
  return match run Effect.result(signCase(key, digest)) |> Effect.provideMut<Random>(&mut random) {
    Result<bool, DsaError>.Success { value } => value
    Result<bool, DsaError>.Failure { error: _ } => false
  }
}

effect fn generatedCase(pBits: usize, qBits: usize) -> bool ! DsaError ? &mut Random {
  let generated = run DsaParameters.generate(pBits, qBits)
  if generated.primeBits() != pBits || generated.divisorBits() != qBits {
    return false
  }
  let key = run DsaPrivateKey.generate(&generated)
  let digest: [u8; 32] = [9; 32]
  let mut signature: [u8; 64] = [0; 64]
  let length = generated.signatureLength()
  run key.signDigest(&digest, Slice.viewMut<u8>(&mut signature, 0, length))
  return ok(key.publicKey().verifyDigest(&digest, Slice.view<u8>(&signature, 0, length)))
}

fn generates(pBits: usize, qBits: usize, seed: u64) -> bool {
  let mut random = Counter { state: seed }
  return match run Effect.result(generatedCase(pBits, qBits)) |> Effect.provideMut<Random>(&mut random) {
    Result<bool, DsaError>.Success { value } => value
    Result<bool, DsaError>.Failure { error: _ } => false
  }
}

fn generateFails(pBits: usize, qBits: usize) -> bool {
  let mut random = Counter { state: 1 }
  return match run Effect.result(generatedCase(pBits, qBits)) |> Effect.provideMut<Random>(&mut random) {
    Result<bool, DsaError>.Success { value: _ } => false
    Result<bool, DsaError>.Failure { error } => error == DsaError.InvalidParameters
  }
}

