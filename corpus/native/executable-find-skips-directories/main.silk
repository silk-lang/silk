//! `Executable.find` passes over a directory on `PATH` that has the program's name, as Visual
//! Studio's `Team Explorer\git` does ahead of Git for Windows, and finds the file after it.

import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.io.writer_native { StderrWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.executable as Executable
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.system.filesystem_native { OsFileSystem }
import silk.system.host_input { HostInput, HostInputError }

static if Intrinsic.targetOperatingSystem() == "darwin" {
  const TEMPORARY: string = "/private/tmp"
} else {
  const TEMPORARY: string = "/tmp"
}

// A process whose `PATH` is `searched` and whose working directory is `/`.
struct FixedInput {
  searched: Bytes,
}

effect fn argumentCount(self: &mut FixedInput) -> usize
  ! HostInputError {
  return 0
}

effect fn argument(self: &mut FixedInput, index: usize) -> Option<Bytes>
  ! HostInputError | OutOfMemoryError
  ? &mut Allocator {
  return Option<Bytes>.none()
}

effect fn variable(self: &mut FixedInput, name: &[u8]) -> Option<Bytes>
  ! HostInputError | OutOfMemoryError
  ? &mut Allocator {
  if name == b"PATH" {
    return Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&self.searched)))
  }
  return Option<Bytes>.none()
}

effect fn variableNames(self: &mut FixedInput) -> List<Bytes>
  ! HostInputError | OutOfMemoryError
  ? &mut Allocator {
  return List<Bytes>.make()
}

effect fn workingDirectory(self: &mut FixedInput) -> Bytes
  ! HostInputError | OutOfMemoryError
  ? &mut Allocator {
  return run Bytes.copy(b"/")
}

impl HostInput for FixedInput {
  argumentCount: FixedInput.argumentCount

  argument: FixedInput.argument

  variable: FixedInput.variable

  variableNames: FixedInput.variableNames

  workingDirectory: FixedInput.workingDirectory
}

// A failed expectation, reported on standard error before the program exits with 1.
struct Failed {
  message: string<'static>,
}

effect fn expect(holds: bool, message: string<'static>) -> ()
  ! Failed {
  if !holds {
    fail Failed { message: message }
  }
}

effect fn cases(scratch: &Path) -> ()
  ! Failed | FileError | HostInputError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  // `first/tool` is a directory and `second/tool` is the program.
  let first = run Path.join(scratch, "first")
  let second = run Path.join(scratch, "second")
  let folder = run Path.join(&first, "tool")
  run FileSystem.createDirectoriesRecursively(&folder)
  let program = run Path.join(&second, "tool")
  run FileSystem.writeFileWithParents(&program, b"")
  let mut searched = run Bytes.copy(Path.rawBytes(&first))
  run Bytes.append(&mut searched, b":")
  run Bytes.append(&mut searched, Path.rawBytes(&second))
  let mut input = FixedInput { searched: move searched }
  let found = run Executable.find("tool") |> Effect.provideMut<HostInput>(&mut input)
  let path = match move found {
    Option<Path>.Some { value } => move value
    Option<Path>.None => {
      run expect(false, "the program after the directory is found")
      return ()
    }
  }
  run expect(Path.rawBytes(&path) == Path.rawBytes(&program), "the directory is passed over")
}

effect fn program() -> i32
  ! Failed | FileError | HostInputError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let parent = run Path.make(TEMPORARY)
  let scratch = run FileSystem.temporaryDirectory(&parent, "silk-executable-find-")
  let outcome = run Effect.result(cases(&scratch.path))
  run FileSystem.release(move scratch)
  return match move outcome {
    Result<(), Failed | FileError | HostInputError | OutOfMemoryError>.Success { .. } => 0
    Result<(), Failed | FileError | HostInputError | OutOfMemoryError>.Failure { error } => {
      fail move error
    }
  }
}

effect fn failed(error: Failed | FileError | HostInputError | OutOfMemoryError) -> i32 {
  return match move error {
    Failed failure => {
      StderrWriter.print("failed: {}\n", &.(failure.message))
      return 1
    }
    FileError file => {
      drop file
      return 2
    }
    HostInputError input => {
      drop input
      return 4
    }
    OutOfMemoryError exhausted => {
      drop exhausted
      return 3
    }
  }
}

effect fn withFiles() -> i32
  ! Failed | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator {
  let mut files = run OsFileSystem.makeBytes(b"/")
  return run program() |> Effect.provideMut<FileSystem>(&mut files)
}

pub effect fn main() -> i32 {
  // The search is the same on every host; the fixture's paths are rooted at `/`, which Windows
  // paths are not.
  static if Intrinsic.targetOperatingSystem() == "windows" {
    return 0
  } else {
    let mut allocator = Allocator.systemAllocatorProvider()
    return run Effect.catchAll(withFiles(), failed) |> Effect.provideMut<Allocator>(&mut allocator)
  }
}
