// Conformances held by the module of the interface's first type argument are found from a third
// module: through a function's bound and where a head's bound fixes one of its parameters, called
// through a bound and with method syntax. The argument is taken by value and by reference.
import convert.mix { Mix }
import geometry.right { Right }

interface Out<O> {
  fn out(value: Self) -> O
}

struct Box<T> {
  value: T,
}

impl<T: Mix<Right, O>, O> Out<O> for Box<T> {
  fn out(value: Box<T>) -> O {
    return Mix<Right, O>.mix(move value.value, Right { n: 2 })
  }
}

struct View<'a, T> {
  value: T,
  right: &'a Right,
}

impl<'a, T: Mix<&'a Right, O>, O> Out<O> for View<'a, T> {
  fn out(value: View<'a, T>) -> O {
    return Mix<&'a Right, O>.mix(move value.value, value.right)
  }
}

fn take<B: Out<O>, O>(value: B) -> O {
  return Out<O>.out(move value)
}

fn peek<'a, T: Mix<&'a Right, O>, O>(left: T, right: &'a Right) -> O {
  return Mix<&'a Right, O>.mix(move left, right)
}

pub fn main() -> i32 {
  let right = Right { n: 4 }
  let wide: i64 = 9
  let bound = peek(wide, &right)
  let small: i32 = 20
  let boxed = take(Box<i32> { value: small })
  let viewed = take(View<i64> { value: wide, right: &right })
  let called = Box<i32> { value: small }.out()
  let seen = View<i64> { value: wide, right: &right }.out()
  return bound + boxed + viewed + called + seen
}
