//! A type whose module owns scalar conformances that take it by value and by reference.
import convert.mix { Mix }

pub struct Right {
  pub n: i32,
}

impl Mix<Right, i32> for i32 {
  fn mix(left: i32, right: Right) -> i32 {
    return left + right.n
  }
}

impl<'a> Mix<&'a Right, i32> for i64 {
  fn mix(left: i64, right: &'a Right) -> i32 {
    return right.n + 1
  }
}
