import silk.core.ownership { Drop }
struct Token { value: i32 }
impl Drop for Token { fn drop(self: &mut Token) -> () { return () } }
union Packet { Empty, Ready { left: Token, right: Token } }
fn bump(token: &mut Token) -> () {
  token.value = token.value + 1
  return ()
}
fn ready(value: i32) -> Packet { return Packet.Ready { left: Token { value: value }, right: Token { value: 2 } } }
struct Holder {
  held: Packet,
  count: i32,
}
fn afterUse() -> i32 {
  let mut packet = ready(1)
  let mut out = 0
  match &packet {
    Packet.Ready { left, .. } => {
      out = left.value
      packet = Packet.Empty
    }
    Packet.Empty => {}
  }
  return out
}
fn otherPlace() -> i32 {
  let mut holder = Holder { held: ready(2), count: 0 }
  match &holder.held {
    Packet.Ready { left, .. } => {
      holder.count = left.value
      holder.count = holder.count + left.value
    }
    Packet.Empty => {}
  }
  return holder.count
}
fn unbound() -> i32 {
  let mut packet = ready(3)
  match &packet {
    Packet.Ready { .. } => { packet = ready(4) }
    Packet.Empty => {}
  }
  return match &packet {
    Packet.Ready { left, .. } => left.value
    Packet.Empty => 0
  }
}
fn throughBinding() -> i32 {
  let mut packet = ready(1)
  match &mut packet {
    Packet.Ready { left, .. } => {
      bump(&mut left)
      let view = &mut left
      bump(move view)
    }
    Packet.Empty => {}
  }
  let out = match &packet {
    Packet.Ready { left, .. } => left.value
    Packet.Empty => 0
  }
  packet = Packet.Empty
  return out
}
fn guarded() -> i32 {
  let mut packet = ready(5)
  return match &packet {
    Packet.Ready { left, .. } if left.value > 0 => {
      packet = Packet.Empty
      return 2
    }
    Packet.Ready { left, .. } => left.value
    Packet.Empty => 0
  }
}
pub fn main() -> i32 { return guarded() + afterUse() + otherPlace() * 10 + unbound() + throughBinding() * 50 }
