// A static call that names a generic function's own binder, written where a runtime value goes,
// such as `Reflect.typeName<S>()` passed to `String.copy`, has no value until `S` is bound. Its
// template is deferred like one whose written static work depends on the binder, and each
// instance a call reaches evaluates the call with its argument. `unused` is never instantiated.
import silk.core.effect { Effect }
import silk.core.reflect { Reflect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }

pub struct Named {
  pub name: String,
}

pub union Light {
  Green,
  Red,
}

pub struct Page<T> {
  pub item: T,
}

effect fn of<S>() -> Named
  ! OutOfMemoryError
  ? &mut Allocator {
  return Named { name: run String.copy(Reflect.typeName<S>()) }
}

effect fn unused<S>() -> Named
  ! OutOfMemoryError
  ? &mut Allocator {
  return Named { name: run String.copy(Reflect.typeName<Page<S>>()) }
}

effect fn checks() -> i32
  ! OutOfMemoryError
  ? &mut Allocator {
  let light = run of<Light>()
  if light.name.view() != "Light" {
    return 1
  }
  let page = run of<Page<Light>>()
  if page.name.view() != "Page<Light>" {
    return 2
  }
  return 0
}

pub effect fn main() -> i32
  ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checks() |> Effect.provideMut<Allocator>(&mut allocator)
}
