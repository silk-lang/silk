import silk.core.option { Omittable, Option }
import silk.num.u16
import silk.num.u8

struct Server {
  name: string<'static>,
  port: Option<u16>,
  retries: Option<i32>,
}

struct Pair<T> {
  first: T,
  second: Option<T>,
}

struct Window<'a> {
  title: Option<&'a [u8]>,
  width: i32,
}

union Event {
  Click { x: i32, button: Option<u8> },
  Key { code: u32 },
}

// A type of the program's own opts in with a conformance in its module.
struct Flags {
  bits: u8,
}

impl Omittable for Flags {
  fn omitted() -> Self {
    return Flags { bits: 7 }
  }
}

struct Job {
  id: i32,
  flags: Flags,
}

fn port(server: &Server) -> u16 {
  return match &server.port {
    Option<u16>.Some { value } => value
    Option<u16>.None => 0
  }
}

fn pair<T>(first: T) -> Pair<T> {
  return Pair<T> { first: move first }
}

fn take(server: Server) -> i32 {
  return u16.toI32(port(&server))
}

pub fn main() -> i32 {
  let bare = Server { name: "web" }
  let full = Server { port: Option<u16>.some(8080), name: "api" }
  if port(&bare) != 0 || port(&full) != 8080 { return 1 }
  if Option<i32>.isSome(&bare.retries) || Option<i32>.isSome(&full.retries) { return 2 }
  let inferred = Pair { first: 5 }
  let generic = pair<i32>(6)
  if Option<i32>.isSome(&inferred.second) || Option<i32>.isSome(&generic.second) { return 3 }
  if inferred.first + generic.first != 11 { return 4 }
  let window: Window<'static> = Window { width: 80 }
  if Option<&[u8]>.isSome(&window.title) || window.width != 80 { return 5 }
  let click = Event.Click { x: 3 }
  let pressed = match move click {
    Event.Click { x, button } => x + match move button {
      Option<u8>.Some { value } => u8.toI32(value)
      Option<u8>.None => 0
    }
    Event.Key { .. } => 100
  }
  if pressed != 3 { return 6 }
  if take(.{ name: "record" }) != 0 { return 7 }
  let job = Job { id: 1 }
  if job.flags.bits != 7 || job.id != 1 { return 8 }
  return 42
}
