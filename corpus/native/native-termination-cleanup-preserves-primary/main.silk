import silk.core.effect { Effect }
import silk.core.ownership { Drop }
import silk.format { Debug, Format, Formatter }
import silk.io.writer { Writer, WriterError }
pub struct Primary {}
struct Noise {}
struct Guard {}
effect fn primary() -> () ! Primary {
  fail Primary {}
}
effect fn noise() -> () ! Noise {
  fail Noise {}
}
effect fn recovered(error: Noise) -> () { return () }
impl Drop for Guard {
  fn drop(self: &mut Guard) -> () {
    run Effect.catchAll(noise(), recovered)
  }
}
impl Drop for Primary {
  fn drop(self: &mut Primary) -> () {
    run Effect.catchAll(noise(), recovered)
  }
}
pub effect fn main() ! Primary {
  let guard = Guard {}
  run primary()
}

impl Debug for Primary {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return run Format.debugFields(self, "Primary", &mut formatter)
  }
}
