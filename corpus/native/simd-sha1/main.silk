import silk.simd.x86
import silk.simd.cpu { CpuFeatures }
import silk.simd.u32x4
import silk.num.u32

// The one padded block of the message "abc", as big-endian words, W[0..3] in lanes 3 to 0.
fn message() -> [simd<u32, 4>; 4] {
  return [
    u32x4.fromArray([0, 0, 0, 0x61626380]),
    u32x4.splat(0),
    u32x4.splat(0),
    u32x4.fromArray([0x18, 0, 0, 0]),
  ]
}

fn initial() -> [u32; 5] {
  return [0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476, 0xc3d2e1f0]
}

// FIPS 180-4: SHA-1("abc").
fn expected() -> [u32; 5] {
  return [0xa9993e36, 0x4706816a, 0xba3e2571, 0x7850c26c, 0x9cd0d89d]
}

fn rounds(stage: usize, abcd: simd<u32, 4>, wk: simd<u32, 4>) -> simd<u32, 4> {
  if stage == 0 { return x86.sha1Rounds4Stage0(abcd, wk) }
  if stage == 1 { return x86.sha1Rounds4Stage1(abcd, wk) }
  if stage == 2 { return x86.sha1Rounds4Stage2(abcd, wk) }
  return x86.sha1Rounds4Stage3(abcd, wk)
}

// The x86 flow: A to D in lanes 3 to 0, E added to the first message word, four rounds per
// `sha1rnds4`. Group `g` of message words comes from groups g-4 (`sha1msg1` with g-3), g-2
// (exclusive or) and g-1 (`sha1msg2`).
fn digest(block: &[simd<u32, 4>; 4]) -> [u32; 5] {
  let h = initial()
  let start = u32x4.fromArray([h[3], h[2], h[1], h[0]])
  let mut abcd = start
  let mut schedule = [block[0], block[1], block[2], block[3], u32x4.splat(0), u32x4.splat(0), u32x4.splat(0), u32x4.splat(0), u32x4.splat(0), u32x4.splat(0), u32x4.splat(0), u32x4.splat(0), u32x4.splat(0), u32x4.splat(0), u32x4.splat(0), u32x4.splat(0), u32x4.splat(0), u32x4.splat(0), u32x4.splat(0), u32x4.splat(0)]
  let mut previous = abcd
  let mut group: usize = 0
  while group < 20 {
    if group >= 4 {
      let partial = x86.sha1Message1(schedule[group - 4], schedule[group - 3]) ^ schedule[group - 2]
      schedule[group] = x86.sha1Message2(partial, schedule[group - 1])
    }
    let mut wk = u32x4.wrappingAdd(schedule[group], u32x4.fromArray([0, 0, 0, h[4]]))
    if group > 0 {
      wk = x86.sha1NextE(previous, schedule[group])
    }
    previous = abcd
    abcd = rounds(group / 5, abcd, wk)
    group = group + 1
  }
  let e = u32x4.extract(x86.sha1NextE(previous, u32x4.splat(0)), 3)
  let s = u32x4.toArray(u32x4.wrappingAdd(abcd, start))
  return [s[3], s[2], s[1], s[0], u32.wrappingAdd(e, h[4])]
}

fn same(left: [u32; 5], right: [u32; 5]) -> bool {
  let mut at: usize = 0
  while at < 5 {
    if left[at] != right[at] { return false }
    at = at + 1
  }
  return true
}

static if Intrinsic.targetArchitecture() == "x86_64" {
  // The instructions themselves, for a machine that has them.
  @features("sha")
  unsafe fn stagesSha(abcd: simd<u32, 4>, wk: simd<u32, 4>) -> simd<u32, 4> {
    let first = Intrinsic.x86Sha1Rounds4Stage0<simd<u32, 4>>(abcd, wk)
    let second = Intrinsic.x86Sha1Rounds4Stage1<simd<u32, 4>>(first, wk)
    let third = Intrinsic.x86Sha1Rounds4Stage2<simd<u32, 4>>(second, wk)
    return Intrinsic.x86Sha1Rounds4Stage3<simd<u32, 4>>(third, wk)
  }

  @features("sha")
  unsafe fn scheduleSha(left: simd<u32, 4>, right: simd<u32, 4>) -> simd<u32, 4> {
    let partial = Intrinsic.x86Sha1Message1<simd<u32, 4>>(left, right)
    return Intrinsic.x86Sha1NextE<simd<u32, 4>>(left, Intrinsic.x86Sha1Message2<simd<u32, 4>>(partial, right))
  }
}

pub fn main() -> i32 {
  let block = message()
  if !same(digest(&block), expected()) { return 1 }
  static if Intrinsic.targetArchitecture() == "x86_64" {
    let machine = CpuFeatures.detect()
    let a = u32x4.fromArray([0x01234567, 0x89abcdef, 0xfedcba98, 0x76543210])
    let b = u32x4.fromArray([0xdeadbeef, 0x0badf00d, 0x13579bdf, 0x2468ace0])
    let portable = x86.sha1Rounds4Stage3(x86.sha1Rounds4Stage2(x86.sha1Rounds4Stage1(x86.sha1Rounds4Stage0(a, b), b), b), b)
    if CpuFeatures.has(&machine, "sha") && unsafe stagesSha(a, b) != portable { return 2 }
    let scheduled = x86.sha1NextE(a, x86.sha1Message2(x86.sha1Message1(a, b), b))
    if CpuFeatures.has(&machine, "sha") && unsafe scheduleSha(a, b) != scheduled { return 3 }
  }
  return 0
}
