// Benchmarks declared with `bench fn`: the catalog an ordinary program reads, the Bencher they
// loop on, and the harness that runs them for a benchmark task.
import silk.bench.bencher { Bencher, Benchmarks }
import silk.bench.transport { Transport, TransportError }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StdoutWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.usize
import silk.system.monotonic_clock { MonotonicClock }
import silk.system.monotonic_clock_native { OsMonotonicClock }
import silk.text.string { String }

fn squares(limit: u64) -> u64 {
  let mut total: u64 = 0
  let mut at: u64 = 0
  while at < limit {
    total = total + at * at
    at = at + 1
  }
  return total
}

// The setup before the loop and the check after it are outside the time.
bench fn sumOfSquares(b: Bencher) {
  let limit: u64 = 100
  let mut total: u64 = 0
  while b.next() {
    total = squares(limit)
    b.keep<u64>(&total)
  }
  b.check(total + b.iterations())
}

// Private, with a stretch left out of the time.
bench fn paused(b: Bencher) {
  let mut turns: u64 = 0
  while b.next() {
    b.stop()
    turns = turns + 1
    b.start()
  }
  b.check(turns)
}

struct Refused {}

// A benchmark may fail: its run is reported as failed.
bench effect fn failing(b: Bencher)
  ! Refused {
  while b.next() {
    fail Refused {}
  }
}

bench effect fn filling(b: Bencher)
  ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut longest: usize = 0
  while b.next() {
    let length = run filled(8) |> Effect.provideMut<Allocator>(&mut allocator)
    b.keep<usize>(&length)
    longest = length
  }
  b.check(usize.toU64(longest))
}

effect fn filled(count: usize) -> usize
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut list = List<u64>.make()
  let mut at: usize = 0
  while at < count {
    run list.append(1)
    at = at + 1
  }
  return list.length()
}

// A test is not a benchmark, and an ordinary function named like the marker is neither.
test fn notABenchmark() {}

fn bench() -> u64 {
  return 7
}

// A transport that answers from memory: the commands a task would send, and what came back.
struct Scripted {
  commands: List<String>,
  next: usize,
  answers: List<String>,
}

impl Transport for Scripted {
  effect fn receive(self: &mut Self) -> Option<String>
    ! TransportError | OutOfMemoryError
    ? &mut Transport | &mut Allocator {
    if self.next == self.commands.length() {
      return Option<String>.None
    }
    self.next = self.next + 1
    return Option<String>.Some {
      value: run String.copy(self.commands.asSlice()[self.next - 1].view()),
    }
  }

  effect fn send(self: &mut Self, line: string) -> ()
    ! TransportError | OutOfMemoryError
    ? &mut Transport | &mut Allocator {
    return run self.answers.append(run String.copy(line))
  }
}

// The answers with every time replaced, so that the text does not depend on the computer.
effect fn timeless(answers: &[String]) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = String.make()
  let mut at: usize = 0
  while at < answers.length {
    let line = answers[at].view()
    match String.find(line, " ns/op") {
      Option<usize>.Some { value } => {
        let before = String.slice(line, 0, value)
        match String.findLast(before, " ") {
          Option<usize>.Some { value: space } => {
            run text.append(String.slice(line, 0, space))
            run text.append(" T ns/op")
          }
          Option<usize>.None => {
            run text.append(line)
          }
        }
      }
      Option<usize>.None => {
        run text.append(line)
      }
    }
    run text.append("\n")
    at = at + 1
  }
  return move text
}

effect fn program() -> i32
  ! TransportError | WriterError | OutOfMemoryError
  ? &mut Allocator | &mut Writer | &mut MonotonicClock {
  let names = run Benchmarks.names()
  let listed = names.asSlice()
  let mut at: usize = 0
  while at < listed.length {
    run Writer.writeString("name: ")
    run Writer.writeString(listed[at].view())
    run Writer.writeString("\n")
    at = at + 1
  }

  let mut scripted = Scripted {
    commands: List<String>.make(),
    next: 0,
    answers: List<String>.make(),
  }
  run scripted.commands.append(run String.copy("list"))
  run scripted.commands.append(run String.copy("run BenchmarkSumOfSquares 3"))
  run scripted.commands.append(run String.copy("run BenchmarkPaused 5"))
  run scripted.commands.append(run String.copy("run BenchmarkFilling 2"))
  run scripted.commands.append(run String.copy("run BenchmarkFailing 2"))
  run scripted.commands.append(run String.copy("run BenchmarkNotABenchmark 2"))
  run scripted.commands.append(run String.copy("quit"))
  run Benchmarks.serve(true) |> Effect.provideMut<Transport>(&mut scripted)
  let text = run timeless(scripted.answers.asSlice())
  run Writer.writeString(text.view())

  if bench() != 7 {
    return 1
  }
  return 0
}

effect fn failed(error: TransportError | WriterError | OutOfMemoryError) -> i32 {
  drop error
  return 1
}

pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut out = StdoutWriter.make()
  let mut clock = OsMonotonicClock.make()
  return run Effect.catchAll(program(), failed)
    |> Effect.provideMut<Writer>(&mut out)
    |> Effect.provideMut<MonotonicClock>(&mut clock)
    |> Effect.provideMut<Allocator>(&mut allocator)
}
