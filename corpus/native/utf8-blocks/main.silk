import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.text.string { InvalidUtf8, String }
import silk.num.u32

// UTF-8 validation can check sixteen-byte blocks with table lookups; the reported offset must
// match a byte-by-byte decoder for every kind of error at every position.
fn offset(values: &[u8]) -> usize {
  return match move String.fromUtf8(values) {
    Result<string, InvalidUtf8>.Success { value: _ } => 1000
    Result<string, InvalidUtf8>.Failure { error } => error.offset
  }
}

fn inRange(value: u8, low: u8, high: u8) -> bool {
  return value >= low && value <= high
}

// The first offset where a byte-by-byte decoder following the Unicode well-formed byte table
// fails, reporting a truncated sequence at its lead byte.
fn expected(values: &[u8]) -> usize {
  let mut at: usize = 0
  while at < values.length {
    let first = values[at]
    let mut width: usize = 0
    let mut low: u8 = 128
    let mut high: u8 = 191
    if first < 128 {
      width = 1
    } else if inRange(first, 194, 223) {
      width = 2
    } else if first == 224 {
      width = 3
      low = 160
    } else if inRange(first, 225, 236) || inRange(first, 238, 239) {
      width = 3
    } else if first == 237 {
      width = 3
      high = 159
    } else if first == 240 {
      width = 4
      low = 144
    } else if inRange(first, 241, 243) {
      width = 4
    } else if first == 244 {
      width = 4
      high = 143
    } else {
      return at
    }
    if at + width > values.length {
      return at
    }
    // Every continuation is checked before the narrower range of the second byte.
    let mut next: usize = 1
    while next < width {
      if inRange(values[at + next], 128, 191) == false { return at + next }
      next = next + 1
    }
    if width > 1 {
      if inRange(values[at + 1], low, high) == false { return at + 1 }
    }
    at = at + width
  }
  return 1000
}

pub fn main() -> i32 {
  // Pieces that mix valid sequences of each width with every class of error byte.
  let pieces: [u8; 40] = [97, 32, 195, 169, 226, 130, 172, 240, 159, 152, 128, 128, 191, 192, 193, 224, 159, 237, 160, 244, 144, 245, 255, 239, 191, 191, 223, 194, 225, 236, 128, 128, 238, 243, 143, 244, 143, 191, 191, 65]
  let mut buffer: [u8; 96] = [97; 96]
  let mut state: u32 = 12345
  let mut round: usize = 0
  while round < 4000 {
    let length = round % 96 + 1
    let mut at: usize = 0
    while at < length {
      state = u32.wrappingAdd(u32.wrappingMultiply(state, 1103515245), 12345)
      let pick = u32.toUsize(u32.shiftRight(state, 16) % 64)
      if pick < 40 {
        buffer[at] = pieces[pick]
      } else {
        buffer[at] = 97
      }
      at = at + 1
    }
    let view = Slice.view(&buffer, 0, length)
    if offset(view) != expected(view) { return 1 }
    round = round + 1
  }
  // Valid characters of every width at every alignment against a block.
  let text: [u8; 10] = [97, 195, 169, 226, 130, 172, 240, 159, 152, 128]
  let mut shift: usize = 0
  while shift < 16 {
    let mut at: usize = 0
    while at < 96 {
      if at < shift {
        buffer[at] = 98
      } else {
        buffer[at] = text[(at - shift) % 10]
      }
      at = at + 1
    }
    let end = 96 - (96 - shift) % 10
    if offset(Slice.view(&buffer, 0, end)) != 1000 { return 2 }
    // One or two bytes overwritten inside otherwise valid text, so that a block holds a single
    // error.
    let mut position: usize = 0
    while position + 1 < end {
      let first = buffer[position]
      let second = buffer[position + 1]
      let mut pick: usize = 0
      while pick < 40 {
        buffer[position] = pieces[pick]
        let view = Slice.view(&buffer, 0, end)
        if offset(view) != expected(view) { return 3 }
        buffer[position + 1] = pieces[(pick * 7 + 3) % 40]
        let pair = Slice.view(&buffer, 0, end)
        if offset(pair) != expected(pair) { return 4 }
        buffer[position + 1] = second
        pick = pick + 1
      }
      buffer[position] = first
      position = position + 1
    }
    shift = shift + 1
  }
  // Short sequences after ASCII, placed so that they cross the first block boundary and so that a
  // truncated one ends a block before an ASCII block.
  let conts: [u8; 6] = [128, 143, 144, 159, 160, 191]
  let mut place: usize = 12
  while place < 17 {
    let mut a: usize = 0
    while a < 40 {
      let mut b: usize = 0
      while b < 40 {
        if check(&mut buffer, place, [pieces[a], pieces[b], 97, 97], 2) == false { return 5 }
        b = b + 1
      }
      if pieces[a] >= 224 {
        let mut c: usize = 0
        while c < 6 {
          let mut x: usize = 0
          while x < 40 {
            if check(&mut buffer, place, [pieces[a], conts[c], pieces[x], 97], 3) == false { return 6 }
            if pieces[a] >= 240 {
              let mut d: usize = 0
              while d < 6 {
                if check(&mut buffer, place, [pieces[a], conts[c], conts[d], pieces[x]], 4) == false { return 7 }
                d = d + 1
              }
            }
            x = x + 1
          }
          c = c + 1
        }
      }
      a = a + 1
    }
    place = place + 1
  }
  return 0
}

// Writes `count` bytes of `sequence` at `place` in ASCII text and compares both answers for the
// text cut right after the sequence and for 48 bytes.
fn check(buffer: &mut [u8; 96], place: usize, sequence: [u8; 4], count: usize) -> bool {
  let mut at: usize = 0
  while at < 96 {
    buffer.*[at] = 97
    at = at + 1
  }
  let mut k: usize = 0
  while k < count {
    buffer.*[place + k] = sequence[k]
    k = k + 1
  }
  let short = Slice.view(&buffer.*, 0, place + count)
  if offset(short) != expected(short) { return false }
  let long = Slice.view(&buffer.*, 0, 48)
  return offset(long) == expected(long)
}
