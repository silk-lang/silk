import silk.mem.layout { Layout }

struct Wrap<T> { value: T }

impl<T> Wrap<T> {
  // A receiver of a fixed instance takes the owner's `T` from the receiver's type alone.
  fn width(self: &Wrap<u8>) -> usize {
    let layout = Layout.of<T>()
    return layout.bytes
  }
}

pub fn main() -> i32 {
  let wrapped = Wrap<u8> {value: 3}
  if wrapped.width() == 1 { return 7 }
  return 1
}
