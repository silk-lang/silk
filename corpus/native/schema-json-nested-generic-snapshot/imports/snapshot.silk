import silk.collections.list { List }
import silk.schema.schema { Schema }
import silk.text.string { String }

pub union Status {
  Active,
  Done
}

impl Schema for Status {}

pub struct Timer {
  pub owner: String,
  pub deadline: u64,
}

impl Schema for Timer {}

pub struct Snapshot<S, E, C, X> {
  pub version: u32,
  pub status: Status,
  pub value: S,
  pub context: C,
  pub mailbox: List<E>,
  pub pending: List<X>,
  pub clock: u64,
  pub timers: List<Timer>,
}

impl<S: Schema, E: Schema, C: Schema, X: Schema> Schema for Snapshot<S, E, C, X> {}
