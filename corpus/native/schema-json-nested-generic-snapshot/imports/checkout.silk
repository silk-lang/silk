// A parent machine whose context holds a child's snapshot. The parent's field reads are the
// instances a build of this program reaches first.
import snapshot { Snapshot }
import child { Child }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.schema.issue { SchemaError }
import silk.schema.json { SchemaJson }
import silk.schema.schema { Schema }

union Payment {
  One,
  Two,
  Three
}

union PaymentEvent {
  Go,
  Stop
}

struct PaymentContext {
  pub amount: u32
}

union PaymentEffect {
  Do
}

impl Schema for Payment {}

impl Schema for PaymentEvent {}

impl Schema for PaymentContext {}

impl Schema for PaymentEffect {}

union Shop {
  One,
  Two,
  Three,
  Four
}

union ShopEvent {
  Buy { pub amount: u32 },
  Pay { pub event: PaymentEvent },
  Go
}

struct ShopContext {
  pub amount: u32,
  pub inner: Child<Payment, PaymentEvent, PaymentContext, PaymentEffect>
}

union ShopEffect {
  Inner { pub x: PaymentEffect },
  Receipt { pub amount: u32 }
}

impl Schema for Shop {}

impl Schema for ShopEvent {}

impl Schema for ShopContext {}

impl Schema for ShopEffect {}

/// Reads a shop snapshot whose context holds a running payment.
pub effect fn shopScenario() -> ()
  ! OutOfMemoryError | SchemaError
  ? &mut Allocator {
  let restored = run SchemaJson.decode<Snapshot<Shop, ShopEvent, ShopContext, ShopEffect>>(
    b"{\"version\":1,\"status\":\"Active\",\"value\":\"One\",\"context\":{\"amount\":3,\"inner\":{\"snapshot\":{\"version\":1,\"status\":\"Active\",\"value\":\"Two\",\"context\":{\"amount\":4},\"mailbox\":[\"Stop\"],\"pending\":[],\"clock\":0,\"timers\":[]}}},\"mailbox\":[],\"pending\":[],\"clock\":0,\"timers\":[]}",
  )
  drop restored
  return ()
}
