// A nested generic snapshot reads as JSON (GEN-006): decoding `Snapshot<Shop, ..>` reaches
// `Snapshot<Payment, ..>` through the shop's context. Each field read descends with its owner: a
// field descriptor's value type is fixed by the owner, and the Effect value of a field read
// descends with the call it holds. The build reaches the parent's field reads first.
import checkout { shopScenario }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.schema.issue { SchemaError }

pub effect fn main() -> i32
  ! OutOfMemoryError | SchemaError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run shopScenario() |> Effect.provideMut<Allocator>(&mut allocator)
  return 0
}
