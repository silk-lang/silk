// An `effect fn` taking an Effect and an owned value of a generic type: the environment lifetime
// elaborated for the generic input stays in the signature when a call applies it to a type that
// retains nothing.
import silk.core.effect { Effect }

pub interface Delay {
  fn next(schedule: &mut Self) -> i32
}

struct Count { calls: i32 }

impl Delay for Count {
  fn next(schedule: &mut Self) -> i32 {
    schedule.calls = schedule.calls + 1
    return schedule.calls
  }
}

effect fn after<A, S: Delay>(self: once Effect<A>, schedule: S) -> A {
  let mut owned = move schedule
  if Delay.next(&mut owned) != 1 { return run self }
  return run self
}

effect fn keep<A, S>(self: once Effect<A>, value: S) -> S {
  drop run self
  return move value
}

effect fn seven() -> i32 { return 7 }

pub fn main() -> i32 {
  let got = run after(seven(), Count { calls: 0 })
  if got != 7 { return 1 }
  let kept = run keep(seven(), 35)
  if kept + got != 42 { return 2 }
  return 0
}
