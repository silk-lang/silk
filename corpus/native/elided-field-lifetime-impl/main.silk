// An inherent `impl Row` for a struct whose field elides its `string` lifetime: the head's
// omitted lifetime is the implementation's own parameter, so receiver methods are callable.
import silk.text.string { String }
import silk.num.usize

struct Row {
  title: string,
  done: bool,
}

impl Row {
  fn make(title: string) -> Row { return Row { title: title, done: false } }
  fn width(self: &Self) -> usize { return String.byteLength(self.title) }
  fn finish(self: &mut Self) -> () { self.done = true }
}

pub fn main() -> i32 {
  let mut row = Row.make("write the silk book")
  row.finish()
  if !row.done { return 1 }
  return usize.toI32(row.width()) + 23
}
