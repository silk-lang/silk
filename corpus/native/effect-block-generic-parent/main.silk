import silk.concurrency.sync { Arc }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.io.logger { InMemoryLogger, Logger }

// An `effect {}` block in a generic body with static work, such as a call with a static template,
// reads that body selected over its own binders, as the declaration sweep checks it.
effect fn again<'env, A, E, ?R>(mut action: mut Effect<'env; A ! E ? R>) -> A ! E ? R {
  return run action
}

effect fn one() -> i32 {
  return 1
}

effect fn wrapped<T>(value: T) -> T {
  run Effect.log("start", &.{})
  let got = run again(effect { return run one() })
  run Effect.log("{v}", &.{ v: got })
  return move value
}

effect fn program() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let loggerProvider = run Logger.inMemoryProvider() |> Effect.provideMut<Allocator>(&mut allocator)
  let logger = run Arc<InMemoryLogger>.make(move loggerProvider) |> Effect.provideMut<Allocator>(&mut allocator)
  let value = run wrapped<i32>(40) |> Effect.provideAmbient<Logger>(&logger)
  let flag = run wrapped<bool>(true) |> Effect.provideAmbient<Logger>(&logger)
  if Logger.length(logger.get()) != 4 || Logger.messageLengthAt(logger.get(), 1) != 1 { return 1 }
  if Logger.messageByteAt(logger.get(), 1, 0) != '1' || !flag { return 2 }
  return value + 2
}

effect fn failed(error: OutOfMemoryError) -> i32 { return 3 }

pub fn main() -> i32 {
  return run Effect.catchAll(program(), failed)
}
