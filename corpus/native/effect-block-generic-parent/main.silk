import silk.core.effect { Effect }
import silk.io.logger { LogError, Logger }

// An `effect {}` block in a generic body with static work, such as a call with a static template,
// reads that body selected over its own binders, as the declaration sweep checks it.
effect fn again<'env, A, E, ?R>(mut action: mut Effect<'env; A ! E ? R>) -> A ! E ? R {
  return run action
}

effect fn one() -> i32 {
  return 1
}

effect fn wrapped<T>(value: T) -> T ! LogError ? &mut Logger {
  run Effect.log("start", &.{})
  let got = run again(effect { return run one() })
  run Effect.log("{v}", &.{ v: got })
  return move value
}

effect fn program() -> i32 ! LogError {
  let mut logger = Logger.inMemoryProvider()
  let value = run wrapped<i32>(40) |> Effect.provideMut<Logger>(&mut logger)
  let flag = run wrapped<bool>(true) |> Effect.provideMut<Logger>(&mut logger)
  if Logger.length(&logger) != 4 || Logger.messageLengthAt(&logger, 1) != 1 { return 1 }
  if Logger.messageByteAt(&logger, 1, 0) != '1' || !flag { return 2 }
  return value + 2
}

effect fn failed(error: LogError) -> i32 { return 3 }

pub fn main() -> i32 {
  return run Effect.catchAll(program(), failed)
}
