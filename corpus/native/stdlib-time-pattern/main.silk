// `silk.time.pattern` against reference data.
//
// `scripts` are not part of the repository: the rows come from a generator. GNU `date` in the C
// locale writes every text of the `F` rows and of the generated `P` rows, in a zone with a fixed
// offset, and Python's `datetime.strptime` reads back the texts whose directives it knows. The
// rows for `%f`, for years outside 1 to 9999, for lenient reading, for refused texts and for
// refused patterns are written by hand.
//
// Each row is tab-separated.
// - `F`: a pattern, a date and time (year, month, day, hour, minute, second, nanosecond), an
//   offset in seconds, an abbreviation, and the text that the pattern writes.
// - `P`: a pattern, a text, what to read (`d` date, `t` time, `dt` date and time, `i` instant),
//   and the fields of the value, or `!` and the reason of the failure.
// - `E`: what the pattern is for (`w` writes a date, `W` a date and time, `Z` a zoned value; `d`,
//   `t`, `D`, `i` read a date, a time, a date and time, an instant), a pattern, and `ok` or the
//   reason and the offset of the `PatternError`.
//
// After the rows, `checkConstants` runs constant patterns through the compile-time path and
// compares each with the same pattern at run time.
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StdoutWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.format { Format }
import silk.text.string { String }
import silk.time.instant { Instant }
import silk.time.offset { UtcOffset }
import silk.time.pattern {
  ParsedFields, PatternError, PatternParts, PatternSource, TimeFields, TimePattern
}
import silk.time.plain_date { PlainDate, Weekday }
import silk.time.plain_date_time { PlainDateTime }
import silk.time.plain_time { PlainTime }
import silk.time.text { TimeParseError, TimeParseReason }
import silk.num.i32
import silk.num.i64
import silk.num.u8
import silk.num.usize
import silk.collections.slice { Slice }

