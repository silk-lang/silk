effect fn checkConstants() -> usize ! WriterError | OutOfMemoryError ? &mut Writer | &mut Allocator {
  let mut failures: usize = 0
  let when = PlainDateTime.make(PlainDate.make(2026, 11, 9), PlainTime.make(18, 6, 2, 500000000))
  let stamp = Stamp {
    fields: TimeFields.ofDate(when.date()).withTime(when.time()).withZone(UtcOffset.fromSeconds(20700), "NPT"),
  }
  let instant = Instant.make(1794247562, 500000000)
  run constant0(&when, &mut failures)
  run constant1(&when, &mut failures)
  run constant2(&when, &mut failures)
  run constant3(&when, &mut failures)
  run constant4(&when, &mut failures)
  run constant5(&when, &mut failures)
  run constant6(&when, &mut failures)
  run constant7(&when, &mut failures)
  run constant8(&when, &mut failures)
  run constant9(&when, &mut failures)
  run constant10(&when, &mut failures)
  run constant11(&when, &mut failures)
  run constant12(&when, &mut failures)
  run constant13(&when, &mut failures)
  run constant14(&stamp, &mut failures)
  run constant15(&stamp, &mut failures)
  run constant16(&stamp, &mut failures)
  run constant17(&instant, &mut failures)
  // A date and a time of day alone.
  let day = run TimePattern.format("%a %-d %b %Y, day %j", &when.date())
  run expect(&day, "Mon 9 Nov 2026, day 313", &mut failures)
  let clock = run TimePattern.format("%-I:%M %P and %f", &when.time())
  run expect(&clock, "6:06 pm and 5", &mut failures)

  // Reading with constant patterns.
  let mut capture = Capture { bytes: [0; 512], length: 0 }
  run writeDate(TimePattern.parse<PlainDate>("%d/%m/%Y", "19/11/2026")) |> Effect.provideMut<Writer>(&mut capture)
  run Writer.writeAll(b"|") |> Effect.provideMut<Writer>(&mut capture)
  run writeDate(TimePattern.parse<PlainDate>("%A, %B %e, %Y", "thursday, november 19, 2026"))
    |> Effect.provideMut<Writer>(&mut capture)
  run Writer.writeAll(b"|") |> Effect.provideMut<Writer>(&mut capture)
  run writeDate(TimePattern.parse<PlainDate>("%G-W%V-%u", "2026-W53-5")) |> Effect.provideMut<Writer>(&mut capture)
  run Writer.writeAll(b"|") |> Effect.provideMut<Writer>(&mut capture)
  run writeDate(TimePattern.parse<PlainDate>("%F", "2026-02-30")) |> Effect.provideMut<Writer>(&mut capture)
  run Writer.writeAll(b"|") |> Effect.provideMut<Writer>(&mut capture)
  run writeTime(TimePattern.parse<PlainTime>("%I:%M:%S%.f %p", "06:36:22.25 PM")) |> Effect.provideMut<Writer>(&mut capture)
  run Writer.writeAll(b"|") |> Effect.provideMut<Writer>(&mut capture)
  run writeTime(TimePattern.parse<PlainTime>("%R", "18:3x")) |> Effect.provideMut<Writer>(&mut capture)
  run Writer.writeAll(b"|") |> Effect.provideMut<Writer>(&mut capture)
  run writeDateTime(TimePattern.parse<PlainDateTime>("%c", "Thu Nov 19 18:36:22 2026"))
    |> Effect.provideMut<Writer>(&mut capture)
  run Writer.writeAll(b"|") |> Effect.provideMut<Writer>(&mut capture)
  run writeDateTime(TimePattern.parse<PlainDateTime>("%Y%m%d", "20261119")) |> Effect.provideMut<Writer>(&mut capture)
  run Writer.writeAll(b"|") |> Effect.provideMut<Writer>(&mut capture)
  run writeInstant(TimePattern.parse<Instant>("%F %T %z", "2026-11-19 18:36:22 +01:00"))
    |> Effect.provideMut<Writer>(&mut capture)
  run Writer.writeAll(b"|") |> Effect.provideMut<Writer>(&mut capture)
  run writeInstant(TimePattern.parse<Instant>("%s.%N", "-1.500000000")) |> Effect.provideMut<Writer>(&mut capture)
  if !holds(
    &capture,
    "2026 11 19|2026 11 19|2027 1 1|!OutOfRange|18 36 22 250000000|!UnexpectedCharacter|2026 11 19 18 36 22 0|2026 11 19 0 0 0 0|1795109782 0|-1 500000000",
  ) {
    failures = failures + 1
    run Format.format("FAIL constant reads\n", &())
  }

  // The fields of a text with a local time and its offset.
  match TimePattern.parseFields("%a %F %R %:z", "Thu 2026-11-19 18:36 -03:00") {
    Result<ParsedFields, TimeParseError>.Success { value } => {
      let mut parts = Capture { bytes: [0; 512], length: 0 }
      run writeDateTime(value.dateTime()) |> Effect.provideMut<Writer>(&mut parts)
      run Writer.writeAll(b"|") |> Effect.provideMut<Writer>(&mut parts)
      run writeInstant(value.instant()) |> Effect.provideMut<Writer>(&mut parts)
      let offset = match value.offset() {
        Option<UtcOffset>.Some { value: found } => found.totalSeconds()
        Option<UtcOffset>.None => 1
      }
      let weekday = match value.weekday() {
        Option<Weekday>.Some { value: found } => found.number()
        Option<Weekday>.None => 0
      }
      if !holds(&parts, "2026 11 19 18 36 0 0|1795124160 0") || offset != -10800 || weekday != 4 {
        failures = failures + 1
        run Format.format("FAIL fields\n", &())
      }
    }
    Result<ParsedFields, TimeParseError>.Failure {..} => {
      failures = failures + 1
      run Format.format("FAIL fields are not read\n", &())
    }
  }
  match TimePattern.parseFields("%H:%M", "18:36") {
    Result<ParsedFields, TimeParseError>.Success { value } => {
      let mut parts = Capture { bytes: [0; 512], length: 0 }
      run writeDate(value.date()) |> Effect.provideMut<Writer>(&mut parts)
      run Writer.writeAll(b"|") |> Effect.provideMut<Writer>(&mut parts)
      run writeInstant(value.instant()) |> Effect.provideMut<Writer>(&mut parts)
      if !holds(&parts, "!MissingDate|!MissingDate") || value.offset().isSome() || value.weekday().isSome() {
        failures = failures + 1
        run Format.format("FAIL missing fields\n", &())
      }
    }
    Result<ParsedFields, TimeParseError>.Failure {..} => {
      failures = failures + 1
      run Format.format("FAIL fields are not read\n", &())
    }
  }
  run Format.format("{} constant failures\n", &.(failures))
  return failures
}

effect fn program() -> i32 ! WriterError | OutOfMemoryError ? &mut Writer | &mut Allocator {
  let rowFailures = run checkRows()
  let constantFailures = run checkConstants()
  if rowFailures + constantFailures != 0 {
    return 1
  }
  return 0
}

effect fn failed(error: WriterError | OutOfMemoryError) -> i32 {
  return 2
}

pub effect fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut out = StdoutWriter.make()
  return run Effect.catchAll(program(), failed)
    |> Effect.provideMut<Writer>(&mut out)
    |> Effect.provideMut<Allocator>(&mut allocator)
}
