struct Capture {
  bytes: [u8; 512],
  length: usize,
}

impl Writer for Capture {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> () ! WriterError ? &mut Writer {
    let mut index: usize = 0
    while index < value.length && self.length < 512 {
      self.bytes[self.length] = value[index]
      self.length = self.length + 1
      index = index + 1
    }
    return ()
  }

  effect fn flush(self: &mut Self) -> () ! WriterError ? &mut Writer {
    return ()
  }
}

fn holds(capture: &Capture, expected: string) -> bool {
  let bytes = String.utf8Bytes(expected)
  if capture.length != bytes.length {
    return false
  }
  let mut index: usize = 0
  while index < bytes.length {
    if capture.bytes[index] != bytes[index] {
      return false
    }
    index = index + 1
  }
  return true
}

fn fieldAt(line: string, wanted: usize) -> string {
  let bytes = String.utf8Bytes(line)
  let mut start: usize = 0
  let mut index: usize = 0
  let mut at: usize = 0
  while at <= bytes.length {
    if at == bytes.length || bytes[at] == 9 {
      if index == wanted {
        return String.slice(line, start, at - start)
      }
      index = index + 1
      start = at + 1
    }
    at = at + 1
  }
  return ""
}

// The number at word `wanted` of a text of numbers with spaces between them.
fn numberAt(text: string, wanted: usize) -> i64 {
  let bytes = String.utf8Bytes(text)
  let mut at: usize = 0
  let mut word: usize = 0
  while word < wanted && at < bytes.length {
    if bytes[at] == 32 {
      word = word + 1
    }
    at = at + 1
  }
  let negative = at < bytes.length && bytes[at] == 45
  if negative {
    at = at + 1
  }
  let mut value: i64 = 0
  while at < bytes.length && bytes[at] != 32 {
    value = value * 10 - u8.toI64(bytes[at] - 48)
    at = at + 1
  }
  if negative {
    return value
  }
  return -value
}

// The rows keep a line feed and a tab of a text as `\n` and `\t`.
fn unescape(text: string, into: &mut [u8; 512]) -> usize {
  let bytes = String.utf8Bytes(text)
  let mut length: usize = 0
  let mut at: usize = 0
  while at < bytes.length {
    if bytes[at] == 92 && at + 1 < bytes.length && (bytes[at + 1] == 110 || bytes[at + 1] == 116) {
      into[length] = if bytes[at + 1] == 110 { 10 } else { 9 }
      at = at + 2
    } else {
      into[length] = bytes[at]
      at = at + 1
    }
    length = length + 1
  }
  return length
}

// A value with every part, for the rows that write.
struct Stamp {
  fields: TimeFields,
}

impl PatternSource for Stamp {
  static fn parts() -> PatternParts {
    return PatternParts { date: true, time: true, offset: true, zone: true }
  }

  fn fields(self: &Self) -> TimeFields {
    return self.fields
  }
}

fn stampOf(line: string) -> Stamp {
  let when = fieldAt(line, 2)
  let date = PlainDate.make(i64.toI32(numberAt(when, 0)), i64.toU8(numberAt(when, 1)), i64.toU8(numberAt(when, 2)))
  let time = PlainTime.make(
    i64.toU8(numberAt(when, 3)), i64.toU8(numberAt(when, 4)), i64.toU8(numberAt(when, 5)), i64.toU32(numberAt(when, 6)),
  )
  let offset = UtcOffset.fromSeconds(i64.toI32(numberAt(fieldAt(line, 3), 0)))
  return Stamp { fields: TimeFields.ofDate(date).withTime(time).withZone(offset, fieldAt(line, 4)) }
}

effect fn reasonName(reason: TimeParseReason) -> () ! WriterError ? &mut Writer {
  return run Format.format("!{:?}", &.(reason))
}

effect fn writeDate(found: Result<PlainDate, TimeParseError>) -> () ! WriterError ? &mut Writer {
  return match move found {
    Result<PlainDate, TimeParseError>.Success { value } => run Format.format(
      "{} {} {}", &(value.year(), value.month(), value.day()),
    )
    Result<PlainDate, TimeParseError>.Failure { error } => run reasonName(error.reason)
  }
}

effect fn writeTime(found: Result<PlainTime, TimeParseError>) -> () ! WriterError ? &mut Writer {
  return match move found {
    Result<PlainTime, TimeParseError>.Success { value } => run Format.format(
      "{} {} {} {}", &(value.hour(), value.minute(), value.second(), value.subsecondNanoseconds()),
    )
    Result<PlainTime, TimeParseError>.Failure { error } => run reasonName(error.reason)
  }
}

effect fn writeDateTime(found: Result<PlainDateTime, TimeParseError>) -> () ! WriterError ? &mut Writer {
  return match move found {
    Result<PlainDateTime, TimeParseError>.Success { value } => run Format.format(
      "{} {} {} {} {} {} {}",
      &(
        value.date().year(), value.date().month(), value.date().day(), value.time().hour(), value.time().minute(),
        value.time().second(), value.time().subsecondNanoseconds(),
      ),
    )
    Result<PlainDateTime, TimeParseError>.Failure { error } => run reasonName(error.reason)
  }
}

effect fn writeInstant(found: Result<Instant, TimeParseError>) -> () ! WriterError ? &mut Writer {
  return match move found {
    Result<Instant, TimeParseError>.Success { value } => run Format.format(
      "{} {}", &(value.unixSeconds(), value.subsecondNanoseconds()),
    )
    Result<Instant, TimeParseError>.Failure { error } => run reasonName(error.reason)
  }
}

effect fn patternProblem(error: PatternError) -> () ! WriterError ? &mut Writer {
  return run Format.format("{:?} {}", &(error.reason, error.offset))
}

// Writes the answer of a `P` row through the type of the row, and returns the same answer
// through `parseFieldsDynamic`.
effect fn readAnswer(pattern: string, text: string, kind: string) -> () ! WriterError ? &mut Writer {
  if kind == "d" {
    return match TimePattern.parseDynamic<PlainDate>(pattern, text) {
      Result<Result<PlainDate, TimeParseError>, PatternError>.Success { value } => run writeDate(move value)
      Result<Result<PlainDate, TimeParseError>, PatternError>.Failure { error } => run patternProblem(error)
    }
  }
  if kind == "t" {
    return match TimePattern.parseDynamic<PlainTime>(pattern, text) {
      Result<Result<PlainTime, TimeParseError>, PatternError>.Success { value } => run writeTime(move value)
      Result<Result<PlainTime, TimeParseError>, PatternError>.Failure { error } => run patternProblem(error)
    }
  }
  if kind == "dt" {
    return match TimePattern.parseDynamic<PlainDateTime>(pattern, text) {
      Result<Result<PlainDateTime, TimeParseError>, PatternError>.Success { value } => run writeDateTime(move value)
      Result<Result<PlainDateTime, TimeParseError>, PatternError>.Failure { error } => run patternProblem(error)
    }
  }
  return match TimePattern.parseDynamic<Instant>(pattern, text) {
    Result<Result<Instant, TimeParseError>, PatternError>.Success { value } => run writeInstant(move value)
    Result<Result<Instant, TimeParseError>, PatternError>.Failure { error } => run patternProblem(error)
  }
}

effect fn fieldsAnswer(pattern: string, text: string, kind: string) -> () ! WriterError ? &mut Writer {
  let fields = match TimePattern.parseFieldsDynamic(pattern, text) {
    Result<Result<ParsedFields, TimeParseError>, PatternError>.Success { value } => match move value {
      Result<ParsedFields, TimeParseError>.Success { value: found } => found
      Result<ParsedFields, TimeParseError>.Failure { error } => {
        return run reasonName(error.reason)
      }
    }
    Result<Result<ParsedFields, TimeParseError>, PatternError>.Failure { error } => {
      return run patternProblem(error)
    }
  }
  if kind == "d" {
    return run writeDate(fields.date())
  }
  if kind == "t" {
    return run writeTime(fields.time())
  }
  if kind == "dt" {
    return run writeDateTime(fields.dateTime())
  }
  return run writeInstant(fields.instant())
}

effect fn errorAnswer(mode: string, pattern: string) -> () ! WriterError ? &mut Writer {
  let mut found = Result<(), PatternError>.succeed(())
  if mode == "w" {
    found = TimePattern.validate<PlainDate>(pattern)
  } else if mode == "W" {
    found = TimePattern.validate<PlainDateTime>(pattern)
  } else if mode == "Z" {
    found = TimePattern.validate<Stamp>(pattern)
  } else if mode == "d" {
    match move TimePattern.parseDynamic<PlainDate>(pattern, "") {
      Result<Result<PlainDate, TimeParseError>, PatternError>.Success {..} => {}
      Result<Result<PlainDate, TimeParseError>, PatternError>.Failure { error } => {
        found = Result<(), PatternError>.failResult(error)
      }
    }
  } else if mode == "t" {
    match move TimePattern.parseDynamic<PlainTime>(pattern, "") {
      Result<Result<PlainTime, TimeParseError>, PatternError>.Success {..} => {}
      Result<Result<PlainTime, TimeParseError>, PatternError>.Failure { error } => {
        found = Result<(), PatternError>.failResult(error)
      }
    }
  } else if mode == "D" {
    match move TimePattern.parseDynamic<PlainDateTime>(pattern, "") {
      Result<Result<PlainDateTime, TimeParseError>, PatternError>.Success {..} => {}
      Result<Result<PlainDateTime, TimeParseError>, PatternError>.Failure { error } => {
        found = Result<(), PatternError>.failResult(error)
      }
    }
  } else {
    match move TimePattern.parseDynamic<Instant>(pattern, "") {
      Result<Result<Instant, TimeParseError>, PatternError>.Success {..} => {}
      Result<Result<Instant, TimeParseError>, PatternError>.Failure { error } => {
        found = Result<(), PatternError>.failResult(error)
      }
    }
  }
  return match move found {
    Result<(), PatternError>.Success {..} => run Format.format("ok", &())
    Result<(), PatternError>.Failure { error } => run patternProblem(error)
  }
}

effect fn report(line: string, capture: &Capture, expected: string, failures: &mut usize) -> ()
  ! WriterError
  ? &mut Writer {
  if !holds(capture, expected) {
    failures.* = failures.* + 1
    run Format.format("FAIL {}\n", &.(line))
  }
  return ()
}

effect fn checkRows() -> usize ! WriterError | OutOfMemoryError ? &mut Writer | &mut Allocator {
  let table = rows()
  let mut failures: usize = 0
  let mut index: usize = 0
  while index < table.length {
    let line = table[index]
    let kind = fieldAt(line, 0)
    let mut capture = Capture { bytes: [0; 512], length: 0 }
    if kind == "F" {
      let stamp = stampOf(line)
      match run TimePattern.formatDynamic(fieldAt(line, 1), &stamp) {
        Result<String, PatternError>.Success { value } => {
          run Writer.writeAll(String.utf8Bytes(value.view())) |> Effect.provideMut<Writer>(&mut capture)
        }
        Result<String, PatternError>.Failure { error } => {
          run patternProblem(error) |> Effect.provideMut<Writer>(&mut capture)
        }
      }
      let mut wanted: [u8; 512] = [0; 512]
      let length = unescape(fieldAt(line, 5), &mut wanted)
      let mut same = capture.length == length
      let mut at: usize = 0
      while same && at < length {
        same = capture.bytes[at] == wanted[at]
        at = at + 1
      }
      if !same {
        failures = failures + 1
        run Format.format("FAIL {}\n", &.(line))
      }
    } else if kind == "P" {
      let mut text: [u8; 512] = [0; 512]
      let length = unescape(fieldAt(line, 2), &mut text)
      let input = unsafe Intrinsic.stringFromUtf8Unchecked(Slice.view<u8>(&text, usize.ZERO, length))
      run readAnswer(fieldAt(line, 1), input, fieldAt(line, 3)) |> Effect.provideMut<Writer>(&mut capture)
      run report(line, &capture, fieldAt(line, 4), &mut failures)
      let mut again = Capture { bytes: [0; 512], length: 0 }
      run fieldsAnswer(fieldAt(line, 1), input, fieldAt(line, 3)) |> Effect.provideMut<Writer>(&mut again)
      run report(line, &again, fieldAt(line, 4), &mut failures)
    } else {
      run errorAnswer(fieldAt(line, 1), fieldAt(line, 2)) |> Effect.provideMut<Writer>(&mut capture)
      run report(line, &capture, fieldAt(line, 3), &mut failures)
    }
    index = index + 1
  }
  run Format.format("{} rows, {} failures\n", &(table.length, failures))
  return failures
}

effect fn expect(found: &String, wanted: string, failures: &mut usize) -> () ! WriterError ? &mut Writer {
  if found.view() != wanted {
    failures.* = failures.* + 1
    run Format.format("FAIL constant: {} is not {}\n", &(found.view(), wanted))
  }
  return ()
}

effect fn expectDynamic(found: &String, again: Result<String, PatternError>, failures: &mut usize) -> ()
  ! WriterError
  ? &mut Writer {
  match &again {
    Result<String, PatternError>.Success { value } => {
      if value.view() == found.view() {
        return ()
      }
    }
    Result<String, PatternError>.Failure {..} => {}
  }
  failures.* = failures.* + 1
  return run Format.format("FAIL constant and dynamic differ: {}\n", &.(found.view()))
}

effect fn constant0(value: &PlainDateTime, failures: &mut usize) -> ()
  ! WriterError | OutOfMemoryError
  ? &mut Writer | &mut Allocator {
  let text = run TimePattern.format("%Y-%m-%d", value)
  run expect(&text, "2026-11-09", &mut failures.*)
  run expectDynamic(&text, run TimePattern.formatDynamic("%Y-%m-%d", value), &mut failures.*)
  let mut capture = Capture { bytes: [0; 512], length: 0 }
  run TimePattern.write("%Y-%m-%d", value) |> Effect.provideMut<Writer>(&mut capture)
  if !holds(&capture, text.view()) {
    failures.* = failures.* + 1
    run Format.format("FAIL write: {}\n", &.(text.view()))
  }
  return ()
}

