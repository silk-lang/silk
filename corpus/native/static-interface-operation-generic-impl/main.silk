// A `static` interface operation runs through a generic implementation, whose scope binds `T`
// (#2997), and through one that reads `T`'s own operation.
interface Arg {
  static fn weight() -> i32
}

impl Arg for i32 {
  static fn weight() -> i32 {
    return 1
  }
}

struct Box<T> { pub v: T }

impl<T: Arg> Arg for Box<T> {
  static fn weight() -> i32 {
    return 10 + weightOf<T>()
  }
}

struct Pair<T> { pub left: T, pub right: T }

impl<T> Arg for Pair<T> {
  static fn weight() -> i32 {
    return 100
  }
}

static fn weightOf<T: Arg>() -> i32 {
  return Arg.weight()
}

pub fn main() -> i32 {
  let static boxed = weightOf<Box<i32>>()
  let static nested = weightOf<Box<Box<i32>>>()
  let static paired = weightOf<Pair<i32>>()
  if boxed != 11 { return 1 }
  if nested != 21 { return 2 }
  if paired != 100 { return 3 }
  return 0
}
