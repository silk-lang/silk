import silk.core.effect { Effect }
import silk.core.option { Option, provideSome, withSome }

service Tracer {
  effect fn trace(value: i32) -> i32 ? &Tracer
}

service Base {
  effect fn base() -> i32 ? &Base
}

struct Offset {
  amount: i32,
}

impl Tracer for Offset {
  effect fn trace(self: &Self, value: i32) -> i32 {
    return value + self.amount
  }
}

struct Fixed {
  value: i32,
}

impl Base for Fixed {
  effect fn base(self: &Self) -> i32 {
    return self.value
  }
}

// Both branches share the `&Base` requirement; only the present one also uses `&Tracer`.
effect fn plain() -> i32 ? &Base {
  return run Base.base()
}

effect fn traced() -> i32 ? &Base | &Tracer {
  let start = run Base.base()
  return run Tracer.trace(start)
}

effect fn measure() -> i32 ? &Base | &Option<&Tracer> {
  return run withSome<&Tracer>(plain(), traced())
}

pub fn main() -> i32 {
  let fixed = Fixed {value: 1}
  let owned = Option<Offset>.some(Offset {amount: 10})
  let none = Option<never>.none()
  let offset = Offset {amount: 20}
  let fromOwned = run Effect.provide(Effect.provide(measure(), &owned), &fixed)
  let fromNone = run Effect.provide(Effect.provide(measure(), &none), &fixed)
  let fromBorrow = run Effect.provide(provideSome<&Tracer>(measure(), &offset), &fixed)
  if fromOwned != 11 || fromNone != 1 || fromBorrow != 21 {
    return 1
  }
  return 42
}
