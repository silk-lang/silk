import silk.core.ownership { Drop }
import silk.trace { Trace }

struct CountOnDrop<'a> { seen: &'a mut i32 }
impl<'a> Drop for CountOnDrop<'a> {
  fn drop(self: &mut Self) -> () { self.seen.* = self.seen.* + 1 }
}

fn nextValue(seen: &mut i32) -> i32 {
  seen.* = seen.* + 1
  return seen.*
}

pub fn main() -> i32 {
  let mut seen: i32 = 0
  Trace.set("value", &nextValue(&mut seen))
  Trace.eventWith("observed", &.{ field: nextValue(&mut seen) })
  Trace.set("temporary", &CountOnDrop { seen: &mut seen })
  return seen - 3
}
