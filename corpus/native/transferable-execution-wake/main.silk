import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.concurrency.execution { Execution, TransferableExecution, TransferableWake }
import silk.concurrency.thread { Transferable }
struct Empty {}
struct Stored { execution: TransferableExecution<i32> }
struct Owner { slot: Empty | Stored, result: i32 }
struct Pending { wake: TransferableWake }
struct Guard {}
fn send<T: Transferable>(value: T) -> T { return move value }
fn register(wake: TransferableWake) -> Guard {
  let pending = send(Pending { wake: move wake })
  Execution.wakeTransferable(move pending.wake)
  return Guard {}
}
effect fn body() -> i32 {
  run Execution.parkTransferable(register)
  return 42
}
fn complete(owner: &mut Owner, result: i32) -> () {
  owner.result = result
  return ()
}
fn suspend(owner: &mut Owner, execution: Intrinsic.Execution<i32>) -> () {
  let adopted = send(TransferableExecution<i32>.adopt(move execution))
  let previous = Intrinsic.replace(owner.slot, Stored { execution: move adopted })
  drop previous
  return ()
}
fn ready(state: &u32) -> () { return () }
effect fn driveOnce(execution: TransferableExecution<i32>, owner: &mut Owner) -> () {
  return run Execution.drive(execution.local(), move owner, complete, suspend)
}
effect fn finish(selected: Empty | Stored, owner: &mut Owner) -> () {
  return match move selected {
    Empty {} => ()
    Stored { execution: next } => run driveOnce(move next, move owner)
  }
}
effect fn program() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut owner = Owner { slot: Empty {}, result: 0 }
  let state: u32 = 7
  let mut execution = run Execution.makeTransferable(body(), state, ready)
    |> Effect.provideMut<Allocator>(&mut allocator)
  execution.notifyInitial()
  let moved = send(move execution)
  run driveOnce(move moved, &mut owner)
  let selected = Intrinsic.replace(owner.slot, Empty {})
  run finish(move selected, &mut owner)
  return owner.result
}
effect fn recover(error: OutOfMemoryError) -> i32 { return -2 }
pub fn main() -> i32 { return run Effect.catchAll(program(), recover) }
