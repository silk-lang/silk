// Borrowing a field of a variant the union does not hold traps.
import silk.core.reflect { Reflect }

union Shape {
  Dot,
  Line { pub length: u32, pub width: u32 },
}

fn firstLineField(shape: &Shape) -> u32 {
  static for variant in Reflect.variants<Shape>() {
    static for field in Reflect.variantFields(variant) {
      return Reflect.borrowVariantField<Shape, u32>(shape, variant, field).*
    }
  }
  return 0
}

pub fn main() -> i32 {
  if firstLineField(&Shape.Line {length: 3, width: 4}) != 3 {
    return 1
  }
  if firstLineField(&Shape.Dot) != 0 {
    return 2
  }
  return 0
}
