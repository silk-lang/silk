import silk.core.effect { Effect }
struct Token { value: i32 }
effect fn peek(value: &Token) -> i32 { return value.value }
effect fn probe(n: i32) -> i32 {
  let mut i = 0
  let mut t = Token { value: 1 }
  while i < n {
    let pending = effect { return t.value }
    t = Token { value: i }
    i = i + 1
  }
  return t.value
}
pub fn main() -> i32 { return run probe(3) }
