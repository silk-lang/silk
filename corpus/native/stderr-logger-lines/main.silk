import silk.effect { Effect }
import silk.logger { LogError, LogLevel, Logger }
import silk.os_logger { StderrLogger }

effect fn work() -> () ! LogError ? &mut Logger {
  run Effect.logTrace("t", &())
  run Effect.logDebug("d{}", &(1,))
  run Effect.logInfo("{name} started {count} workers", &.{ name: "silk", count: 3 })
  run Effect.logWarning("w", &())
  run Effect.logError("a much longer error message that will overflow the sixty four byte buffer {}", &(42,))
  return ()
}

pub effect fn main() -> i32 ! LogError {
  let mut logger = StderrLogger.make()
  run work() |> Effect.provideMut<Logger>(&mut logger)
  return 0
}
