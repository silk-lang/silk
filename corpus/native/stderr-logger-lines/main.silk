import silk.core.effect { Effect }
import silk.io.logger { LogError, LogLevel, Logger }
import silk.io.logger_native { StderrLogger }

effect fn work() -> () ! LogError ? &mut Logger {
  run Effect.logTrace("t", &())
  run Effect.logDebug("d{}", &(1,))
  run Effect.logInfo("{name} started {count} workers", &.{ name: "silk", count: 3 })
  run Effect.logWarning("w", &())
  run Effect.logError("a much longer error message that will overflow the sixty four byte buffer {}", &(42,))
  return ()
}

pub effect fn main() -> i32 ! LogError {
  // Standard error is not a terminal here, so the detected logger has no color.
  let mut logger = StderrLogger.make()
  run work() |> Effect.provideMut<Logger>(&mut logger)
  let mut colored = StderrLogger.withColor(true)
  run work() |> Effect.provideMut<Logger>(&mut colored)
  let mut plain = StderrLogger.withColor(false)
  run Effect.logWarning("plain", &()) |> Effect.provideMut<Logger>(&mut plain)
  return 0
}
