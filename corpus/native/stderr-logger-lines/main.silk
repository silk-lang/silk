import silk.concurrency.sync { Arc }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.io.logger { Logger }
import silk.io.logger_native { StderrLogger }

effect fn work() -> () {
  run Effect.logTrace("t", &())
  run Effect.logDebug("d{}", &.(1))
  run Effect.logInfo("{name} started {count} workers", &.{ name: "silk", count: 3 })
  run Effect.logWarning("w", &())
  run Effect.logError("a much longer error message that will overflow the sixty four byte buffer {}", &.(42))
  return ()
}

pub effect fn main() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  // Standard error is not a terminal here, so the detected logger has no color.
  let logger = run Arc<StderrLogger>.make(StderrLogger.make()) |> Effect.provideMut<Allocator>(&mut allocator)
  run work() |> Effect.provideAmbient<Logger>(&logger)
  let colored = run Arc<StderrLogger>.make(StderrLogger.withColor(true)) |> Effect.provideMut<Allocator>(&mut allocator)
  run work() |> Effect.provideAmbient<Logger>(&colored)
  let plain = run Arc<StderrLogger>.make(StderrLogger.withColor(false)) |> Effect.provideMut<Allocator>(&mut allocator)
  run Effect.logWarning("plain", &()) |> Effect.provideAmbient<Logger>(&plain)
  return 0
}
