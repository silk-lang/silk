import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.crypto.ec_key { EcCurve, EcKeyDer, EcKeyError, EcPrivateKeyDer, EcPublicKeyDer }
import silk.crypto.p256 { P256, P256Error }
import silk.crypto.p384 { P384, P384Error }
import silk.crypto.sha2 { Sha256 }

fn equal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut i: usize = 0
  while i < left.length {
    if left[i] != right[i] {
      return false
    }
    i = i + 1
  }
  return true
}

fn sameOption(value: &Option<&[u8]>, expected: &[u8]) -> bool {
  return match &value.* {
    Option<&[u8]>.Some { value: bytes } => equal(bytes, expected)
    Option<&[u8]>.None => expected.length == 0
  }
}

fn privateCase(
  result: Result<EcPrivateKeyDer, EcKeyError>,
  curve: EcCurve,
  secret: &[u8],
  publicKey: &[u8],
) -> bool {
  return match move result {
    Result<EcPrivateKeyDer, EcKeyError>.Success { value } => value.curve == curve
      && equal(value.secret, secret)
      && sameOption(&value.publicKey, publicKey)
    Result<EcPrivateKeyDer, EcKeyError>.Failure { error: _ } => false
  }
}

fn privateFails(result: Result<EcPrivateKeyDer, EcKeyError>, expected: EcKeyError) -> bool {
  return match move result {
    Result<EcPrivateKeyDer, EcKeyError>.Success { value: _ } => false
    Result<EcPrivateKeyDer, EcKeyError>.Failure { error } => error == expected
  }
}

fn publicCase(
  result: Result<EcPublicKeyDer, EcKeyError>,
  curve: EcCurve,
  publicKey: &[u8],
) -> bool {
  return match move result {
    Result<EcPublicKeyDer, EcKeyError>.Success { value } => value.curve == curve
      && equal(value.publicKey, publicKey)
    Result<EcPublicKeyDer, EcKeyError>.Failure { error: _ } => false
  }
}

fn publicFails(result: Result<EcPublicKeyDer, EcKeyError>, expected: EcKeyError) -> bool {
  return match move result {
    Result<EcPublicKeyDer, EcKeyError>.Success { value: _ } => false
    Result<EcPublicKeyDer, EcKeyError>.Failure { error } => error == expected
  }
}

fn written(result: Result<usize, EcKeyError>, output: &[u8], expected: &[u8]) -> bool {
  return match move result {
    Result<usize, EcKeyError>.Success { value } => value == expected.length
      && equal(Slice.view<u8>(output, 0, value), expected)
    Result<usize, EcKeyError>.Failure { error: _ } => false
  }
}

fn writeFails(result: Result<usize, EcKeyError>, expected: EcKeyError) -> bool {
  return match move result {
    Result<usize, EcKeyError>.Success { value: _ } => false
    Result<usize, EcKeyError>.Failure { error } => error == expected
  }
}

fn p256From(secret: &[u8]) -> P256 {
  return match P256.fromBytes(secret) {
    Result<P256, P256Error>.Success { value } => move value
    Result<P256, P256Error>.Failure { error: _ } => Intrinsic.trap("key")
  }
}

fn p384From(secret: &[u8]) -> P384 {
  return match P384.fromBytes(secret) {
    Result<P384, P384Error>.Success { value } => move value
    Result<P384, P384Error>.Failure { error: _ } => Intrinsic.trap("key")
  }
}

