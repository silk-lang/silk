//! Static code calls ordinary pure functions: a local helper, generic methods of a standard library
//! type, checked and plain integer conversions, and a function value passed to a pure function.
//! The same helpers also run at runtime, and both phases agree.
import silk.core.option {Option}
import silk.num.u32
import silk.num.u8

struct Box<T> { pub value: T }

impl<T> Box<T> {
  fn make(value: T) -> Self { return Box<T> {value: move value} }
}

fn clamp(value: u32, limit: u32) -> u32 {
  if value > limit { return limit }
  return value
}

fn narrow(value: u32) -> u8 {
  return match u32.checkedToU8(value) {
    Option<u8>.Some {value: small} => small
    Option<u8>.None => 255
  }
}

fn apply(f: fn(u8) -> Option<u8>, value: u8) -> Option<u8> { return f(value) }

static fn small(value: u32) -> bool {
  return u32.checkedToU8(clamp(value, 300)).isSome()
}

static fn score() -> u32 {
  let boxed = Box<u32>.make(clamp(40, 30))
  let mut total = boxed.value
  if small(100) { total = total + 1 }
  if !small(1000) { total = total + 1 }
  total = total + u8.toU32(narrow(70)) + u8.toU32(narrow(9000))
  if apply(Option.some, 3).isSome() { total = total + 1 }
  return total
}

pub fn main() -> i32 {
  static if score() != 358 { compileError("the static score differs") }
  let runtime = Box<u32>.make(clamp(40, 30)).value + u8.toU32(narrow(70)) + u8.toU32(narrow(9000)) + 3
  if runtime != score() { return 1 }
  return u32.toI32(score() - 254)
}
