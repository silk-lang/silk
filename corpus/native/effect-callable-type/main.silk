// `once effect fn(A) -> B ! F ? S` is a callable whose call returns an Effect. It is the same
// contract as `for<use 'call> once fn<'env>(A) -> once Effect<'call & 'env; B ! F ? S>`, so a
// callable passes between the two spellings.
struct Shortfall {}

effect fn twice(n: i32) -> i32 { return n * 2 }

effect fn halve(n: i32) -> i32 ! Shortfall {
  if n % 2 != 0 { fail Shortfall {} }
  return n / 2
}

fn spelledOut<'env, F: for<use 'call> once fn<'env>(i32) -> once Effect<'call & 'env; i32 ! Shortfall>>(f: F) -> F {
  return move f
}

fn shorthand<'env, G: once effect fn<'env>(i32) -> i32 ! Shortfall>(g: G) -> G {
  return spelledOut(move g)
}

effect fn apply<F: once effect fn(i32) -> i32>(f: F, n: i32) -> i32 {
  return run f(n)
}

pub effect fn main() -> i32 {
  let checked = shorthand(halve)
  drop checked
  return run apply(twice, 21)
}
