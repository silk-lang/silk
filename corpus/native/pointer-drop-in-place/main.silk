import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.list { List }
import silk.ownership { Drop }
import silk.pointer { Pointer }
import silk.u32

// Pointer.dropInPlace runs the drop on the pointee in place.

// A value large enough that a move out of its storage is a memcpy; its drop counts itself.
struct Probe {
  hits: *mut i32,
  pad: [u64; 20],
}

impl Drop for Probe {
  fn drop(self: &mut Probe) -> () {
    unsafe { Pointer.write<i32>(self.hits, Pointer.read<i32>(self.hits) + 1) }
  }
}

fn at(list: &List<u32>, i: usize) -> u32 { return list.get(i) }

unsafe fn destroy(p: *mut Probe) -> () {
  unsafe { Pointer.dropInPlace<Probe>(p) }
}

fn probes(hits: *mut i32) -> () {
  let mut probe = Probe {hits: hits, pad: [7; 20]}
  let slot = Pointer.fromMutRef<Probe>(&mut probe)
  unsafe {
    destroy(slot)
    Pointer.put<Probe>(slot, Probe {hits: hits, pad: [9; 20]})
  }
}

effect fn check() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let mut values = List<u32>.make()
  run values.append(5)
  run values.append(37)
  let mut hits: i32 = 0
  probes(Pointer.fromMutRef<i32>(&mut hits))
  if hits != 2 { return 1 }
  // A value with no cleanup: dropping it in place does nothing.
  unsafe { Pointer.dropInPlace<i32>(Pointer.fromMutRef<i32>(&mut hits)) }
  if hits != 2 { return 2 }
  return u32.toI32(at(&values, 0) + at(&values, 1))
}

pub effect fn main() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run check() |> Effect.provideMut<Allocator>(&mut allocator)
}
