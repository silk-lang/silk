import silk.mem.allocator { OutOfMemoryError }
import silk.mem.allocator { Allocator }
import silk.core.effect { Effect }
import silk.collections.list { List }

struct Slot {
  index: usize,
  weight: i32,
}
struct RawBuffer { bytes: i32 }
struct Allocation { granted: bool }

fn measure(buffer: &RawBuffer, allocation: &Allocation) -> i32 { // ordinary: user types
  if allocation.granted { return buffer.bytes }
  return 0
}

effect fn build() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut slots = List<Slot>.make()
  let first = List<Slot>.append(&mut slots, Slot { index: 0, weight: 20 }) |> Effect.provideMut(&mut allocator)
  let appendedFirst = run first
  let second = List<Slot>.append(&mut slots, Slot { index: 1, weight: 12 }) |> Effect.provideMut(&mut allocator)
  let appendedSecond = run second
  let view = List<Slot>.asSlice(&slots)
  let buffer = RawBuffer { bytes: 10 }
  let allocation = Allocation { granted: true }
  return view[0].weight + view[1].weight + measure(&buffer, &allocation)
}

effect fn recover(error: OutOfMemoryError) -> i32 { return 7 }

pub fn main() -> i32 { return run Effect.catchAll(build(), recover) }