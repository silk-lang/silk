import silk.core.ownership { Copy }
import silk.mem.pointer { Pointer }
import silk.concurrency.thread_native { NativeThread, SpawnError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }

// A process-wide cache wider than one word, read on every call.
struct Timebase { numer: u32, denom: u32, calls: u64 }
impl Copy for Timebase {}

fn timebase() -> *mut Timebase { return Intrinsic.processSlot<Timebase>() }
fn other() -> *mut Timebase { return Intrinsic.processSlot<Timebase>() }
fn counter() -> *mut u64 { return Intrinsic.threadSlot<u64>() }

// Two call sites in one function name two slots.
fn twoSites() -> bool {
  let first = Intrinsic.processSlot<u64>()
  let second = Intrinsic.processSlot<u64>()
  return Intrinsic.pointerAddress<*mut u64>(first) != Intrinsic.pointerAddress<*mut u64>(second)
}

fn bump() -> u64 {
  let slot = counter()
  unsafe { Pointer.write<u64>(slot, Pointer.read<u64>(slot) + 1) }
  return unsafe Pointer.read<u64>(slot)
}

effect fn program() -> i32 ! OutOfMemoryError | SpawnError {
  let first = timebase()
  let mut base = unsafe Pointer.read<Timebase>(first)
  if base.numer != 0 || base.calls != 0 { return 1 }
  base.numer = 10
  base.denom = 3
  unsafe Pointer.write<Timebase>(first, base)
  let again = unsafe Pointer.read<Timebase>(timebase())
  if again.numer != 10 { return 2 }
  let fresh = unsafe Pointer.read<Timebase>(other())
  if fresh.numer != 0 { return 3 }
  let _a = bump()
  let _b = bump()
  let mut system = Allocator.systemAllocatorProvider()
  let handle = run NativeThread.spawn(|| -> u64 { return bump() }) |> Effect.provideMut<Allocator>(&mut system)
  let theirs = handle.join()
  if theirs != 1 { return 4 }
  if bump() != 3 { return 5 }
  if !twoSites() { return 6 }
  return 42
}

effect fn recover(error: OutOfMemoryError | SpawnError) -> i32 { return 9 }

pub fn main() -> i32 { return run Effect.catchAll(program(), recover) }
