// Wrapping, saturating, shift, rotate, minimum, maximum, square root and fused lane arithmetic
// (SIMD-004); reductions, mask queries, slice and pointer memory, conversion and bit casts
// (SIMD-005).
import silk.num.usize

fn store(values: &mut [u32], offset: usize, vector: simd<u32, 4>) -> () {
  Intrinsic.simdStore<simd<u32, 4>>(&mut values, offset, vector)
  return ()
}

// Doubles four lanes in place through raw lane pointers.
fn doubled(values: &mut [u32]) -> bool {
  unsafe {
    let lanes = Intrinsic.pointerFromMutSlice<u32>(&mut values)
    let read = Intrinsic.simdPointerLoad<simd<u32, 4>>(Intrinsic.pointerRequalify<?[*]mut u32, [*]const u32>(lanes))
    let target = Intrinsic.pointerRequalify<?[*]mut u32, [*]mut u32>(lanes)
    Intrinsic.simdPointerStore<simd<u32, 4>>(target, read + read)
    return read == Intrinsic.simdFromArray<simd<u32, 4>>([5, 6, 7, 8])
  }
}

pub fn main() -> i32 {
  let mut failures = 0
  let big = Intrinsic.simdSplat<simd<u8, 16>>(250)
  let ten = Intrinsic.simdSplat<simd<u8, 16>>(10)
  if Intrinsic.simdWrappingAdd<simd<u8, 16>>(big, ten) != Intrinsic.simdSplat<simd<u8, 16>>(4) { failures = failures + 1 }
  if Intrinsic.simdSaturatingAdd<simd<u8, 16>>(big, ten) != Intrinsic.simdSplat<simd<u8, 16>>(255) { failures = failures + 1 }
  if Intrinsic.simdSaturatingSubtract<simd<u8, 16>>(ten, big) != Intrinsic.simdSplat<simd<u8, 16>>(0) { failures = failures + 1 }
  if Intrinsic.simdWrappingSubtract<simd<u8, 16>>(ten, big) != Intrinsic.simdSplat<simd<u8, 16>>(16) { failures = failures + 1 }
  if Intrinsic.simdWrappingMultiply<simd<u8, 16>>(big, ten) != Intrinsic.simdSplat<simd<u8, 16>>(196) { failures = failures + 1 }

  let words = Intrinsic.simdFromArray<simd<u32, 4>>([1, 2, 0x80000000, 7])
  let counts = Intrinsic.simdFromArray<simd<u32, 4>>([1, 4, 1, 0])
  if Intrinsic.simdShiftLeft<simd<u32, 4>>(words, counts) != Intrinsic.simdFromArray<simd<u32, 4>>([2, 32, 0, 7]) { failures = failures + 1 }
  if Intrinsic.simdShiftRight<simd<u32, 4>>(words, counts) != Intrinsic.simdFromArray<simd<u32, 4>>([0, 0, 0x40000000, 7]) { failures = failures + 1 }
  if Intrinsic.simdRotateLeft<simd<u32, 4>>(words, counts) != Intrinsic.simdFromArray<simd<u32, 4>>([2, 32, 1, 7]) { failures = failures + 1 }
  if Intrinsic.simdRotateRight<simd<u32, 4>>(words, counts) != Intrinsic.simdFromArray<simd<u32, 4>>([0x80000000, 0x20000000, 0x40000000, 7]) { failures = failures + 1 }
  let signed = Intrinsic.simdFromArray<simd<i32, 4>>([-8, 8, -1, 3])
  if Intrinsic.simdShiftRight<simd<i32, 4>>(signed, Intrinsic.simdSplat<simd<i32, 4>>(1)) != Intrinsic.simdFromArray<simd<i32, 4>>([-4, 4, -1, 1]) { failures = failures + 1 }
  if Intrinsic.simdMinimum<simd<i32, 4>>(signed, Intrinsic.simdSplat<simd<i32, 4>>(0)) != Intrinsic.simdFromArray<simd<i32, 4>>([-8, 0, -1, 0]) { failures = failures + 1 }
  if Intrinsic.simdMaximum<simd<u32, 4>>(words, counts) != Intrinsic.simdFromArray<simd<u32, 4>>([1, 4, 0x80000000, 7]) { failures = failures + 1 }

  let floats = Intrinsic.simdFromArray<simd<f64, 2>>([4.0, 9.0])
  if Intrinsic.simdSqrt<simd<f64, 2>>(floats) != Intrinsic.simdFromArray<simd<f64, 2>>([2.0, 3.0]) { failures = failures + 1 }
  let fused = Intrinsic.simdMulAdd<simd<f64, 2>>(floats, floats, Intrinsic.simdSplat<simd<f64, 2>>(1.0))
  if fused != Intrinsic.simdFromArray<simd<f64, 2>>([17.0, 82.0]) { failures = failures + 1 }
  let zero = Intrinsic.simdSplat<simd<f64, 2>>(0.0)
  let nan = zero / zero
  if Intrinsic.simdMinimum<simd<f64, 2>>(nan, floats) == Intrinsic.simdMinimum<simd<f64, 2>>(nan, floats) { failures = failures + 1 }

  let quarters = Intrinsic.simdFromArray<simd<f32, 4>>([0.25, 0.5, 1.0, 2.0])
  if Intrinsic.simdReduceAdd<simd<f32, 4>>(quarters) != 3.75 { failures = failures + 1 }
  if Intrinsic.simdReduceAddUnordered<simd<f32, 4>>(quarters) != 3.75 { failures = failures + 1 }
  if Intrinsic.simdReduceMinimum<simd<f32, 4>>(quarters) != 0.25 { failures = failures + 1 }
  if Intrinsic.simdReduceMaximum<simd<f32, 4>>(quarters) != 2.0 { failures = failures + 1 }
  if Intrinsic.simdReduceAdd<simd<u32, 4>>(words) != 0x8000000A { failures = failures + 1 }
  if Intrinsic.simdReduceWrappingAdd<simd<u8, 16>>(big) != 160 { failures = failures + 1 }
  if Intrinsic.simdReduceMinimum<simd<i32, 4>>(signed) != -8 { failures = failures + 1 }
  if Intrinsic.simdReduceMaximum<simd<i32, 4>>(signed) != 8 { failures = failures + 1 }
  if Intrinsic.simdReduceBitOr<simd<u32, 4>>(words) != 0x80000007 { failures = failures + 1 }
  if Intrinsic.simdReduceBitAnd<simd<u32, 4>>(counts) != 0 { failures = failures + 1 }
  if Intrinsic.simdReduceBitXor<simd<u32, 4>>(counts) != 4 { failures = failures + 1 }

  let set = Intrinsic.simdLanesGreater<simd<u32, 4>>(words, Intrinsic.simdSplat<simd<u32, 4>>(1))
  if !Intrinsic.simdMaskAny<mask<4>>(set) || Intrinsic.simdMaskAll<mask<4>>(set) { failures = failures + 1 }
  if !Intrinsic.simdMaskAll<mask<4>>(Intrinsic.simdSplat<mask<4>>(true)) { failures = failures + 1 }
  if Intrinsic.simdMaskAny<mask<4>>(Intrinsic.simdSplat<mask<4>>(false)) { failures = failures + 1 }
  if Intrinsic.simdMaskCount<mask<4>>(set) != 3 { failures = failures + 1 }
  if Intrinsic.simdMaskFirstSet<mask<4>>(set) != 1 { failures = failures + 1 }
  if Intrinsic.simdMaskFirstSet<mask<4>>(Intrinsic.simdSplat<mask<4>>(false)) != 4 { failures = failures + 1 }
  if Intrinsic.simdMaskToBits<mask<4>>(set) != 14 { failures = failures + 1 }
  if Intrinsic.simdMaskFromBits<mask<4>>(14) != set { failures = failures + 1 }
  let wide = Intrinsic.simdMaskFromBits<mask<64>>(0x8000000000000001)
  if Intrinsic.simdMaskCount<mask<64>>(wide) != 2 || Intrinsic.simdMaskToBits<mask<64>>(wide) != 0x8000000000000001 { failures = failures + 1 }

  let text = b"0123456789abcdefXYZ"
  let loaded = Intrinsic.simdLoad<simd<u8, 16>>(text, 3)
  if Intrinsic.simdExtract<simd<u8, 16>>(loaded, 0) != 51 || Intrinsic.simdExtract<simd<u8, 16>>(loaded, 15) != 90 { failures = failures + 1 }
  let mut buffer: [u32; 6] = [0, 0, 0, 0, 0, 0]
  store(&mut buffer, 1, words)
  if buffer[0] != 0 || buffer[1] != 1 || buffer[4] != 7 || buffer[5] != 0 { failures = failures + 1 }

  let mut lanes: [u32; 4] = [5, 6, 7, 8]
  if !doubled(&mut lanes) { failures = failures + 1 }
  if lanes[3] != 16 { failures = failures + 1 }

  let converted = Intrinsic.simdConvert<simd<i32, 4>, simd<f32, 4>>(signed)
  if converted != Intrinsic.simdFromArray<simd<f32, 4>>([-8.0, 8.0, -1.0, 3.0]) { failures = failures + 1 }
  let widened = Intrinsic.simdConvert<simd<u8, 16>, simd<u16, 16>>(big)
  if Intrinsic.simdExtract<simd<u16, 16>>(widened, 7) != 250 { failures = failures + 1 }
  let raw = Intrinsic.simdBitcast<simd<f32, 4>, simd<u32, 4>>(Intrinsic.simdSplat<simd<f32, 4>>(1.0))
  if raw != Intrinsic.simdSplat<simd<u32, 4>>(0x3F800000) { failures = failures + 1 }
  return failures
}
