import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.num.u32
import silk.core.effect { Effect }
import silk.concurrency.atomic { Atomic, MemoryOrder }
import silk.concurrency.thread { Transferable }
import silk.concurrency.thread_native { NativeThread, SpawnError }

// The address of a word in `main`'s frame, which outlives every thread here.
struct Signal { word: *mut u32 }
impl Transferable for Signal {}

fn raise(signal: Signal, value: u32) -> () {
  unsafe { Atomic.store<u32>(signal.word, value, MemoryOrder.Release) }
  return ()
}

// Detached threads run with nobody joining them, and each frees its own start storage.
effect fn program() -> i32 ! OutOfMemoryError | SpawnError {
  let mut system = Allocator.systemAllocatorProvider()
  let mut words: [u32; 8] = [0; 8]
  let mut index: usize = 0
  while index < 8 {
    let signal = Signal { word: Pointer.fromMutRef(&mut words[index]) }
    let value: u32 = 5
    run NativeThread.spawnDetached(|| -> () { raise(move signal, value) })
      |> Effect.provideMut<Allocator>(&mut system)
    index = index + 1
  }
  let mut total: u32 = 0
  index = 0
  while index < 8 {
    let word = Pointer.fromRef(&words[index])
    let mut seen: u32 = unsafe Atomic.load<u32>(word, MemoryOrder.Acquire)
    while seen == 0 {
      NativeThread.yieldNow()
      seen = unsafe Atomic.load<u32>(word, MemoryOrder.Acquire)
    }
    total = total + seen
    index = index + 1
  }
  return 2 + u32.toI32(total)
}

effect fn recover(error: OutOfMemoryError | SpawnError) -> i32 { return 9 }

pub fn main() -> i32 { return run Effect.catchAll(program(), recover) }
