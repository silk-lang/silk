static if (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText("libc") == "gnu") {
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.system.child_process { ChildProcess }
import silk.system.filesystem { FileError, Path }
import silk.system.signal_watch { SignalError, SignalOperation, SignalWatch }
import silk.system.subprocess { ExitWatch, SpawnOptions, Subprocess, SubprocessError }

extern "C" struct PollFd { fd: i32, events: i16, revents: i16 }
static if Intrinsic.targetOperatingSystem() == "darwin" {
  @foreign(noCapture: .("fds"))
  unsafe extern "C" fn poll(fds: ?[*]mut PollFd, count: u32, timeout: i32) -> i32
} else {
  @foreign(noCapture: .("fds"))
  unsafe extern "C" fn poll(fds: ?[*]mut PollFd, count: usize, timeout: i32) -> i32
}
unsafe extern "C" fn getpid() -> i32

fn readable(fd: i32, milliseconds: i32) -> bool {
  let mut watched = [PollFd { fd: fd, events: 1, revents: 0 }]
  return unsafe poll(Pointer.fromMutSlice<PollFd>(&mut watched), 1, milliseconds) == 1
}

fn raise(signal: i32) -> () {
  let _sent = run Effect.result(Subprocess.kill(unsafe getpid(), signal))
  return ()
}

fn contains(values: &[i32], count: usize, value: i32) -> bool {
  let mut index: usize = 0
  while index < count {
    if values[index] == value { return true }
    index = index + 1
  }
  return false
}

fn operationIndex(operation: SignalOperation) -> i32 {
  return match operation {
    SignalOperation.Open => 0
    SignalOperation.Add => 1
    SignalOperation.Remove => 2
    SignalOperation.Read => 3
  }
}

fn failureCode(result: Result<(), SignalError>, operation: SignalOperation) -> i32 {
  return match move result {
    Result<(), SignalError>.Success { .. } => -1
    Result<(), SignalError>.Failure { error } => if operationIndex(error.operation) == operationIndex(operation) { error.code } else { -2 }
  }
}

effect fn program() -> i32 ! SignalError | SubprocessError | FileError | OutOfMemoryError ? &mut Allocator {
  let mut watch = run SignalWatch.open()
  let one = SignalWatch.userOne()
  let two = SignalWatch.userTwo()
  let mut received: [i32; 8] = [0; 8]

  // Nothing arrived yet: the descriptor is quiet and a read returns 0.
  run watch.add(one)
  run watch.add(two)
  run watch.add(one)
  if !watch.contains(one) || !watch.contains(two) || watch.contains(SignalWatch.hangup()) { return 1 }
  if readable(watch.descriptor(), 0) { return 2 }
  let none = run watch.read(&mut received)
  if none != 0 { return 3 }

  // Two arrivals of one signal before a read are reported once, next to the other signal.
  raise(one)
  raise(one)
  raise(two)
  if !readable(watch.descriptor(), 5000) { return 4 }
  let count = run watch.read(&mut received)
  if count != 2 || !contains(&received, count, one) || !contains(&received, count, two) { return 5 }
  let after = run watch.read(&mut received)
  if after != 0 { return 6 }

  // A small buffer leaves the rest for the next read.
  raise(one)
  raise(two)
  let mut single: [i32; 1] = [0]
  let first = run watch.read(&mut single)
  let second = run watch.read(&mut single)
  if first != 1 || second != 1 { return 7 }

  // Removing a signal with an unread arrival discards it, so the default action does not end the
  // process.
  raise(two)
  run watch.remove(two)
  if watch.contains(two) { return 8 }
  run watch.remove(two)

  // A watched signal still reaches a child with its default action.
  let terminate = SignalWatch.terminate()
  run watch.add(terminate)
  let sleepPath = run Path.make("/bin/sleep")
  let mut sleeping = run ChildProcess.request(&sleepPath)
  run ChildProcess.addArgument(&mut sleeping, "30")
  let child = run Subprocess.spawn(&sleeping, &SpawnOptions.make())
  let exit = run ExitWatch.open(child.pid())
  run Subprocess.kill(child.pid(), terminate)
  if !readable(exit.descriptor(), 5000) { return 9 }
  let status = run exit.collect()
  if !status.signaled || status.signal != terminate { return 11 }

  // Signals that cannot be watched.
  if failureCode(run Effect.result(watch.add(9)), SignalOperation.Add) != 22 { return 12 }
  if failureCode(run Effect.result(watch.add(0)), SignalOperation.Add) != 22 { return 13 }
  if failureCode(run Effect.result(watch.remove(99)), SignalOperation.Remove) != 22 { return 14 }

  // Dropping the watch with an unread arrival discards it too.
  raise(one)
  drop watch
  return 42
}

pub effect fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  let result = run Effect.result(program()) |> Effect.provideMut<Allocator>(&mut allocator)
  return match move result {
    Result<i32, SignalError | SubprocessError | FileError | OutOfMemoryError>.Success { value } => value
    Result<i32, SignalError | SubprocessError | FileError | OutOfMemoryError>.Failure { .. } => 100
  }
}
} else {
pub fn main() -> i32 { return 42 }
}
