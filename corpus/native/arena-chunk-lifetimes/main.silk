import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.arena { Arena, ArenaOptions, ArenaReset }
import silk.mem.box { Box }
import silk.core.effect { Effect }
import silk.num.i64
import silk.mem.layout { Layout }
import silk.collections.list { List }
import silk.mem.pointer { Pointer }
import silk.mem.raw_buffer { RawBuffer }
import silk.mem.slot { Slot }

// The arena's child: hands out adopted chunks from one system block and counts, through two cells
// the program owns, every chunk it gives out and every chunk that comes back.
struct Counts { issued: usize, returned: usize }

export "C" fn chunkReturned(context: ?*mut u8) -> () {
  let present = unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(context)
  let counts = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut Counts>(present)
  let mut anchor = ()
  let held = unsafe Pointer.borrowMut(&mut anchor, counts)
  held.returned = held.returned + 1
  return ()
}

struct Pool { base: [*]mut u8, used: usize, counts: *mut Counts }

effect fn allocate(self: &mut Pool, layout: Layout) -> Intrinsic.Allocation ! OutOfMemoryError {
  let remainder = (Pointer.addressMany<u8>(self.base) + self.used) % layout.alignment
  if remainder != 0 { self.used = self.used + layout.alignment - remainder }
  if self.used + layout.bytes > 65536 { fail OutOfMemoryError {} }
  let at = unsafe Pointer.atMut<u8>(self.base, self.used)
  self.used = self.used + layout.bytes
  let mut anchor = ()
  let counts = unsafe Pointer.borrowMut(&mut anchor, self.counts)
  counts.issued = counts.issued + 1
  let reclaim: extern "C" fn(?*mut u8) -> () = chunkReturned
  let context = unsafe Intrinsic.pointerReinterpret<*mut Counts, *mut u8>(self.counts)
  return unsafe Intrinsic.allocationAdopt(at, move layout, reclaim, context)
}

impl Allocator for Pool { allocate: Pool.allocate }

fn read(counts: *mut Counts) -> Counts {
  let mut anchor = ()
  let held = unsafe Pointer.borrowMut(&mut anchor, counts)
  return Counts { issued: held.issued, returned: held.returned }
}

effect fn build() -> i32 ! OutOfMemoryError {
  let mut system = Allocator.systemAllocatorProvider()
  let block = run Allocator.allocate(Layout { bytes: 65536, alignment: 1 }) |> Effect.provideMut<Allocator>(&mut system)
  let mut bytes = unsafe RawBuffer.from<u8>(move block, 65536)
  let base = unsafe Pointer.assumeManyMut<u8>(Slot.address(RawBuffer.slot<u8>(&mut bytes, 0)))
  let mut cells = run Box<Counts>.make(Counts { issued: 0, returned: 0 }) |> Effect.provideMut<Allocator>(&mut system)
  let counts = Pointer.fromMutRef(&mut cells.getMut()[0])
  let pool = Pool { base: base, used: 0, counts: counts }
  let mut arena = Arena.withOptions(move pool, ArenaOptions { firstChunkBytes: 512, maximumChunkBytes: 1024 })

  // Nothing is acquired before the first request.
  if read(counts).issued != 0 { return 1 }
  let keep = run Box<i64>.make(30) |> Effect.provideMut<Allocator>(&mut arena)
  let mut values = List<i64>.make()
  let mut at: i64 = 0
  while at < 100 {
    run List<i64>.append(&mut values, at) |> Effect.provideMut<Allocator>(&mut arena)
    at = at + 1
  }
  // The list outgrew the first chunks while `keep` and the list's buffer kept theirs alive.
  let grown = read(counts)
  if grown.issued < 3 { return 2 }
  let total = List<i64>.get(&values, 99) - List<i64>.get(&values, 87)
  drop values

  // A request larger than half a chunk gets its own chunk, returned as soon as it drops.
  let before = read(counts)
  let mut large = List<u8>.make()
  run List<u8>.reserveExact(&mut large, 2000) |> Effect.provideMut<Allocator>(&mut arena)
  if read(counts).issued != before.issued + 1 { return 3 }
  drop large
  if read(counts).returned != before.returned + 1 { return 4 }

  // A reset that retains capacity keeps a chunk with no live allocation for the next requests.
  let small = run Box<i64>.make(1) |> Effect.provideMut<Allocator>(&mut arena)
  drop small
  arena.reset(ArenaReset.RetainCapacity)
  let retained = read(counts)
  let again = run Box<i64>.make(2) |> Effect.provideMut<Allocator>(&mut arena)
  if read(counts).issued != retained.issued { return 5 }
  drop again

  // Dropping the arena returns every chunk except the one `keep` still points into.
  drop arena
  let dropped = read(counts)
  if dropped.returned + 1 != dropped.issued { return 6 }
  let kept = keep.get()[0]
  drop keep
  let finished = read(counts)
  if finished.returned != finished.issued { return 7 }
  drop bytes
  return i64.toI32(kept + total)
}

effect fn recover(error: OutOfMemoryError) -> i32 { return 9 }

pub fn main() -> i32 {
  return run Effect.catchAll(build(), recover)
}
