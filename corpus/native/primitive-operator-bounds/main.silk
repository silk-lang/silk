import silk.core.equal { Equal }
import silk.core.ops { Add, BitAnd, BitNot, BitOr, BitXor, Divide, Multiply, Negate, Not, Remainder, Subtract }
import silk.core.order { Order }

// Every scalar satisfies each operator interface whose operator it has built in.
fn same<T: Equal>(left: &T, right: &T) -> bool { return left == right }
fn below<T: Order>(left: &T, right: &T) -> bool { return left < right }
fn difference<T: Subtract<T, T>>(left: T, right: T) -> T { return move left - move right }
fn product<T: Multiply<T, T>>(left: T, right: T) -> T { return move left * move right }
fn quotient<T: Divide<T, T>>(left: T, right: T) -> T { return move left / move right }
fn rest<T: Remainder<T, T>>(left: T, right: T) -> T { return move left % move right }
fn sum<T: Add<T, T>>(left: T, right: T) -> T { return move left + move right }
fn negated<T: Negate<T>>(value: T) -> T { return -(move value) }
fn masked<T: BitAnd<T, T>>(left: T, right: T) -> T { return move left & move right }
fn joined<T: BitOr<T, T>>(left: T, right: T) -> T { return move left | move right }
fn toggled<T: BitXor<T, T>>(left: T, right: T) -> T { return move left ^ move right }
fn complement<T: BitNot<T>>(value: T) -> T { return ~(move value) }
fn inverted<T: Not<T>>(value: T) -> T { return !(move value) }

pub fn main() -> i32 {
  let small: u8 = 7
  let twelve: u8 = 12
  let ten: u8 = 10
  let six: u16 = 6
  let seven: u16 = 7
  let wide: i64 = 84
  let two: i64 = 2
  let many: u32 = 47
  let five: u32 = 5
  let quarter: f32 = 1.25
  let rest32: f32 = 0.75
  let zero: i8 = 0
  if !same(&3, &3) || same(&3, &4) { return 1 }
  if !same(&1.5, &1.5) || !same(&true, &true) || !same(&'a', &'a') { return 2 }
  if !below(&'a', &'b') || below(&small, &small) { return 3 }
  if difference(10, 3) != 7 || difference(2.5, 0.5) != 2.0 { return 4 }
  if product(six, seven) != 42 || quotient(wide, two) != 42 { return 5 }
  if rest(many, five) != 2 || sum(quarter, rest32) != 2.0 { return 6 }
  if negated(5) != -5 || negated(2.0) != -2.0 { return 7 }
  if masked(twelve, ten) != 8 || joined(twelve, ten) != 14 || toggled(twelve, ten) != 6 { return 8 }
  if complement(zero) != -1 || inverted(false) != true { return 9 }
  return 42
}
