import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.concurrency.channel { Channel, Receiver, Sender, TryReceive, TrySend }
import silk.concurrency.fiber { Cancelled, Fiber }
import silk.concurrency.local_scheduler { LocalScheduler, StalledError }
import silk.concurrency.scheduler { Scheduler, TaskIdExhaustedError }
import silk.system.monotonic_clock { MonotonicClock }
import silk.system.monotonic_clock_native { OsMonotonicClock }

// Sends `count` values that start at `first`, then drops its handle.
effect fn produce(sender: Sender<i32>, first: i32, count: i32) -> i32 {
  let mut index = 0
  while index < count {
    match run sender.send(first + index) {
      Result.Success {..} => {}
      Result.Failure {..} => { return 1 }
    }
    index = index + 1
  }
  drop sender
  return 0
}

effect fn receiveOne(receiver: Receiver<i32>) -> i32 {
  return match run receiver.receive() {
    Option.Some {value} => value
    Option.None => -1
  }
}

// Two producers share a channel of one value with one consumer, and the channel closes when both
// senders are dropped.
effect fn manyProducers() -> i32
! OutOfMemoryError | TaskIdExhaustedError | Cancelled
? &mut Scheduler | &mut MonotonicClock {
  let mut allocator = Allocator.systemAllocatorProvider()
  let channel = run Channel<i32>.make(1) |> Effect.provideMut<Allocator>(&mut allocator)
  let Channel<i32> {sender, receiver} = move channel
  let second = run sender.clone() |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run Fiber<i32, never>.forkChild(produce(move sender, 1, 3))
  let other = run Fiber<i32, never>.forkChild(produce(move second, 10, 3))
  let mut total = 0
  let mut count = 0
  while true {
    match run receiver.receive() {
      Option.Some {value} => {
        total = total + value
        count = count + 1
      }
      Option.None => { break }
    }
  }
  if (run first.join()) != 0 || (run other.join()) != 0 { return 1 }
  if count != 6 || total != 39 { return 2 }
  return 0
}

// trySend and tryReceive do not wait, and a close gives values back to senders.
effect fn withoutWaiting() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let channel = run Channel<i32>.make(1)
  let Channel<i32> {sender, receiver} = move channel
  match sender.trySend(5) {
    TrySend.Sent => {}
    _ => { return 1 }
  }
  match sender.trySend(6) {
    TrySend.Full {value} => { if value != 6 { return 2 } }
    _ => { return 3 }
  }
  if receiver.length() != 1 { return 4 }
  receiver.close()
  if !sender.isClosed() { return 5 }
  match sender.trySend(7) {
    TrySend.Closed {value} => { if value != 7 { return 6 } }
    _ => { return 7 }
  }
  // The value that was in the channel before the close is still received.
  match receiver.tryReceive() {
    TryReceive.Received {value} => { if value != 5 { return 8 } }
    _ => { return 9 }
  }
  match receiver.tryReceive() {
    TryReceive.Closed => {}
    _ => { return 10 }
  }
  return 0
}

// A receiver that is cancelled while it waits leaves the channel usable for a new receiver.
effect fn cancelledWaiter() -> i32
! OutOfMemoryError | TaskIdExhaustedError | Cancelled
? &mut Scheduler | &mut MonotonicClock {
  let mut allocator = Allocator.systemAllocatorProvider()
  let channel = run Channel<i32>.make(2) |> Effect.provideMut<Allocator>(&mut allocator)
  let Channel<i32> {sender, receiver} = move channel
  let waiting = run receiver.clone() |> Effect.provideMut<Allocator>(&mut allocator)
  let blocked = run Fiber<i32, never>.forkChild(receiveOne(move waiting))
  run Fiber.yieldNow()
  let outcome = run blocked.interrupt()
  match move outcome.value {
    Cancelled {} => {}
    _ => { return 1 }
  }
  let later = run Fiber<i32, never>.forkChild(receiveOne(move receiver))
  run Fiber.yieldNow()
  match run sender.send(8) {
    Result.Success {..} => {}
    Result.Failure {..} => { return 2 }
  }
  if (run later.join()) != 8 { return 3 }
  return 0
}

effect fn root() -> i32
! OutOfMemoryError | TaskIdExhaustedError | Cancelled
? &mut Scheduler | &mut MonotonicClock {
  let many = run manyProducers()
  if many != 0 { return 10 + many }
  let mut allocator = Allocator.systemAllocatorProvider()
  let direct = run withoutWaiting() |> Effect.provideMut<Allocator>(&mut allocator)
  if direct != 0 { return 20 + direct }
  let cancelled = run cancelledWaiter()
  if cancelled != 0 { return 40 + cancelled }
  return 42
}

effect fn program() -> i32
! OutOfMemoryError | TaskIdExhaustedError | Cancelled | StalledError {
  let mut clock = OsMonotonicClock.make()
  let mut scheduler = LocalScheduler.make()
  return run scheduler.execute<i32, OutOfMemoryError | TaskIdExhaustedError | Cancelled>(root())
    |> Effect.provideMut<MonotonicClock>(&mut clock)
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  return 99
}

pub fn main() -> i32 {
  return run Effect.catchAll(program(), failed)
}
