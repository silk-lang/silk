// The schedulers trace what they do: a `fiber` span where a fiber starts, naming the scheduler,
// with the fiber's body in a `fiber.run` span under it, and `fiber.await` and `fiber.yield` where
// fibers wait for each other and give way.
import silk.trace { Trace, Tracer }
import silk.trace.record { Config, Recorder, Memory, Span }
import silk.trace.values { Value }
import silk.concurrency.fiber { Cancelled, Fiber }
import silk.concurrency.local_scheduler { LocalScheduler, StalledError }
import silk.concurrency.scheduler { Scheduler, TaskIdExhaustedError }
import silk.concurrency.thread_pool { Pool, ThreadPool }
import silk.concurrency.sync { Arc }
import silk.concurrency.thread_native { SpawnError }
import silk.system.monotonic_clock { MonotonicClock }
import silk.system.monotonic_clock_native { OsMonotonicClock }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }

effect fn square(value: i32) -> i32 {
  let _work = Trace.span("work")
  run Fiber.yieldNow()
  return value * value
}

effect fn root() -> i32 ! OutOfMemoryError | TaskIdExhaustedError | Cancelled ? &mut Scheduler | &mut MonotonicClock {
  let three = run Fiber<i32, never>.forkChild(square(3))
  let four = run Fiber<i32, never>.forkChild(square(4))
  let x = run three.join()
  let y = run four.join()
  return x + y
}

effect fn local() -> i32 ! OutOfMemoryError | TaskIdExhaustedError | Cancelled | StalledError {
  let _top = Trace.span("local")
  let mut clock = OsMonotonicClock.make()
  let mut scheduler = LocalScheduler.make()
  return run scheduler.execute<i32, OutOfMemoryError | TaskIdExhaustedError | Cancelled>(root())
    |> Effect.provideMut<MonotonicClock>(&mut clock)
}

effect fn pooled(value: i32) -> i32 {
  let _work = Trace.span("pooled")
  return value + 1
}

effect fn pool(handle: Pool) -> i32 ! OutOfMemoryError | Cancelled {
  let _top = Trace.span("pool")
  let a = run handle.fork(pooled(1))
  let b = run handle.fork(pooled(2))
  let x = run a.join()
  let y = run b.join()
  return x + y
}

fn text<'a>(span: &'a Span, key: string) -> string<'a> {
  let mut at: usize = 0
  while at < span.attributes.count {
    if span.attributes.items[at].key == key {
      if let Value.Text {value} = &span.attributes.items[at].value { return value.view() }
    }
    at = at + 1
  }
  return ""
}

fn named(spans: &[Span], id: u64) -> string<'static> {
  let mut at: usize = 0
  while at < spans.length {
    if spans[at].context.span == id { return spans[at].name }
    at = at + 1
  }
  return ""
}

fn check(spans: &[Span]) -> i32 {
  let mut localFibers: usize = 0
  let mut poolFibers: usize = 0
  let mut runs: usize = 0
  let mut awaits: usize = 0
  let mut yields: usize = 0
  let mut at: usize = 0
  while at < spans.length {
    let span = &spans[at]
    if span.thread == 0 { return 10 }
    if span.name == "fiber" {
      if text(span, "silk.scheduler") == "local" {
        localFibers = localFibers + 1
        if named(spans, span.parent.span) != "local" { return 11 }
      }
      if text(span, "silk.scheduler") == "thread_pool" {
        poolFibers = poolFibers + 1
      }
    }
    if span.name == "fiber.run" {
      runs = runs + 1
      if named(spans, span.parent.span) != "fiber" { return 12 }
    }
    if span.name == "work" || span.name == "pooled" {
      if named(spans, span.parent.span) != "fiber.run" { return 13 }
    }
    if span.name == "work" {
      if span.eventCount != 1 || span.events[0].name != "fiber.yield" { return 14 }
      yields = yields + 1
    }
    if span.name == "fiber.await" { awaits = awaits + 1 }
    at = at + 1
  }
  // The two local children; the pool's two forks and the fiber `block` started.
  if localFibers != 2 { return 15 }
  if poolFibers != 3 { return 16 }
  if runs != 5 { return 17 }
  if awaits != 4 { return 18 }
  if yields != 2 { return 19 }
  return 0
}

effect fn exercise() -> i32 ! OutOfMemoryError | TaskIdExhaustedError | Cancelled | StalledError | SpawnError ? &mut Allocator {
  let provider = run Arc<Recorder>.make(run Recorder.make(Config.make("scheduler")))
  let threads = run ThreadPool.make(2)
  let first = run local() |> Effect.provideAmbient<Tracer>(&provider)
  if first != 25 { return 1 }
  let handle = threads.pool()
  let second = run handle.block(pool(threads.pool())) |> Effect.provideAmbient<Tracer>(&provider)
  if second != 5 { return 2 }
  let mut memory = Memory.make()
  run memory.drain(provider.get())
  return check(memory.spans())
}

effect fn failed(error: OutOfMemoryError | TaskIdExhaustedError | Cancelled | StalledError | SpawnError) -> i32 {
  drop error
  return 3
}

pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(exercise() |> Effect.provideMut<Allocator>(&mut allocator), failed)
}
