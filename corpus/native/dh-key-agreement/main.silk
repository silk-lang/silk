import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.crypto.dh { DhError, DhGroup, DhNamedGroup, DhPrivateKey }
import silk.crypto.modular { ModularError, Natural }
import silk.num.u64
import silk.system.random { Random }

struct Counter {
  state: u64,
}

impl Random for Counter {
  effect fn fillBytes(self: &mut Self, output: &mut [u8]) -> () {
    let mut index: usize = 0
    while index < output.length {
      self.state = u64.wrappingAdd(u64.wrappingMultiply(self.state, 6364136223846793005), 1)
      output[index] = u64.toU8(u64.shiftRight(self.state, 56))
      index = index + 1
    }
  }
}

fn equal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut i: usize = 0
  while i < left.length {
    if left[i] != right[i] {
      return false
    }
    i = i + 1
  }
  return true
}

fn sameNatural(value: &Natural, expected: &[u8]) -> bool {
  let mut buffer: [u8; 1024] = [0; 1024]
  return match value.writeBytes(Slice.viewMut<u8>(&mut buffer, 0, expected.length)) {
    Result<(), ModularError>.Success { value: _ } => equal(
      Slice.view<u8>(&buffer, 0, expected.length),
      expected,
    )
    Result<(), ModularError>.Failure { error: _ } => false
  }
}

fn key(group: &DhGroup, secret: &[u8]) -> DhPrivateKey {
  return match DhPrivateKey.fromBytes(group, secret) {
    Result<DhPrivateKey, DhError>.Success { value } => value
    Result<DhPrivateKey, DhError>.Failure { error: _ } => Intrinsic.trap("key")
  }
}

fn group(prime: &[u8], generator: &[u8]) -> DhGroup {
  return match DhGroup.make(prime, generator) {
    Result<DhGroup, DhError>.Success { value } => value
    Result<DhGroup, DhError>.Failure { error: _ } => Intrinsic.trap("group")
  }
}

fn groupFails(prime: &[u8], generator: &[u8], expected: DhError) -> bool {
  return match DhGroup.make(prime, generator) {
    Result<DhGroup, DhError>.Success { value: _ } => false
    Result<DhGroup, DhError>.Failure { error } => error == expected
  }
}

fn secretFails(group: &DhGroup, secret: &[u8], expected: DhError) -> bool {
  return match DhPrivateKey.fromBytes(group, secret) {
    Result<DhPrivateKey, DhError>.Success { value: _ } => false
    Result<DhPrivateKey, DhError>.Failure { error } => error == expected
  }
}

// The public key and the shared secret with `peer` match OpenSSL.
fn exchange(key: &DhPrivateKey, publicKey: &[u8], peer: &[u8], shared: &[u8]) -> bool {
  let mut written: [u8; 1024] = [0; 1024]
  key.writePublicKey(Slice.viewMut<u8>(&mut written, 0, publicKey.length))
  if !equal(Slice.view<u8>(&written, 0, publicKey.length), publicKey)
    || !sameNatural(&key.publicKey(), publicKey) {
    return false
  }
  let mut secret: [u8; 1024] = [0; 1024]
  return match key.agree(peer, Slice.viewMut<u8>(&mut secret, 0, shared.length)) {
    Result<(), DhError>.Success { value: _ } => equal(
      Slice.view<u8>(&secret, 0, shared.length),
      shared,
    )
    Result<(), DhError>.Failure { error: _ } => false
  }
}

fn agreeFails(key: &DhPrivateKey, peer: &[u8], length: usize, expected: DhError) -> bool {
  let mut secret: [u8; 1024] = [0; 1024]
  return match key.agree(peer, Slice.viewMut<u8>(&mut secret, 0, length)) {
    Result<(), DhError>.Success { value: _ } => false
    Result<(), DhError>.Failure { error } => error == expected
  }
}

