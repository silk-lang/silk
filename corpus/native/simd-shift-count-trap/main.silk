// A shift count at or above the lane width traps as the scalar shift does (SIMD-004).
pub fn main() -> i32 {
  let lanes = Intrinsic.simdSplat<simd<u32, 4>>(1)
  let counts = Intrinsic.simdFromArray<simd<u32, 4>>([0, 1, 32, 2])
  let shifted = Intrinsic.simdShiftLeft<simd<u32, 4>>(lanes, counts)
  if Intrinsic.simdExtract<simd<u32, 4>>(shifted, 0) == 1 { return 1 }
  return 0
}
