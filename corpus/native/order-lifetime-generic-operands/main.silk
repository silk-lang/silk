import silk.core.order { Order, Ordering }
import silk.core.ops { Add }
import silk.core.ownership { Copy }

struct Span<'a> {
  start: &'a i32,
}

impl<'a> Copy for Span<'a> {}

impl<'a> Order for Span<'a> {
  fn compare(left: &Self, right: &Self) -> Ordering {
    return Order.compare(left.start, right.start)
  }
}

impl<'a> Add<Span<'a>, Span<'a>> for Span<'a> {
  fn add(left: Span<'a>, right: Span<'a>) -> Span<'a> {
    if left.start.* < right.start.* { return right }
    return left
  }
}

// `impl<'text> Order for string<'text>` takes the caller's own lifetime from its operands.
fn before<'a>(left: string<'a>, right: string<'a>) -> bool {
  return &left < &right
}

fn spanBefore<'a>(left: Span<'a>, right: Span<'a>) -> bool {
  return &left < &right
}

fn later<'a>(left: Span<'a>, right: Span<'a>) -> Span<'a> {
  return left + right
}

pub fn main() -> i32 {
  if !before("cat", "dog") { return 1 }
  if before("dog", "cat") { return 2 }
  if before("cat", "cat") { return 3 }
  let one = 1
  let two = 2
  let first = Span { start: &one }
  let second = Span { start: &two }
  if !spanBefore(first, second) { return 4 }
  if spanBefore(second, first) { return 5 }
  if later(first, second).start.* != 2 { return 6 }
  return 42
}
