import silk.trace { Trace, Tracer }
import silk.trace.record { Config, Recorder, Memory }
import silk.concurrency.execution { Execution, TransferableExecution, TransferableWake }
import silk.concurrency.thread_pool { Pool, ThreadPool }
import silk.concurrency.fiber { Cancelled }
import silk.concurrency.sync { Arc }
import silk.concurrency.thread_native { NativeThread, SpawnError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }

struct Slice { parked: Option<TransferableExecution<i32>>, result: i32 }
fn ready(state: &()) -> () {}
fn completed(slice: &mut Slice, value: i32) -> () { slice.result = value }
fn parked(slice: &mut Slice, work: Intrinsic.Execution<i32>) -> () {
  slice.parked = Option<TransferableExecution<i32>>.some(TransferableExecution<i32>.adopt(move work))
}
effect fn drive(work: TransferableExecution<i32>) -> Slice {
  let mut slice = Slice {parked: Option<TransferableExecution<i32>>.none(), result: -1}
  run Execution.drive(work.local(), &mut slice, completed, parked)
  return move slice
}
fn again(wake: TransferableWake) -> () { Execution.wakeTransferable(move wake) }
fn child() -> i32 {
  let _leaf = Trace.span("forked")
  return 0
}
effect fn body() -> i32 {
  let _guard = Trace.span("migrated")
  run Execution.parkTransferable(again)
  Trace.event("resumed")
  let mut allocator = Allocator.systemAllocatorProvider()
  let result = run Effect.catchAll(NativeThread.spawn(child) |> Effect.provideMut<Allocator>(&mut allocator)
    |> Effect.map(|thread| -> i32 { return thread.join() }), failed)
  let _sibling = Trace.span("sibling")
  return result
}
effect fn resume(work: TransferableExecution<i32>) -> i32 {
  let slice = run drive(move work)
  return slice.result
}
effect fn parent(firstWorker: Pool, nextWorker: Pool) -> i32 ! OutOfMemoryError | SpawnError | Cancelled ? &mut Allocator {
  let _guard = Trace.span("root")
  let work = run Execution.makeTransferable(body(), (), ready)
  let first = run firstWorker.block(drive(move work))
  Trace.event("suspended")
  match move first.parked {
    Option<TransferableExecution<i32>>.Some {value} => {
      return run nextWorker.block(resume(move value))
    }
    Option<TransferableExecution<i32>>.None => { return 8 }
  }
}
effect fn exercise() -> i32 ! OutOfMemoryError | SpawnError | Cancelled ? &mut Allocator {
  let provider = run Arc<Recorder>.make(run Recorder.make(Config.make("migration")))
  let first = run ThreadPool.make(1)
  let second = run ThreadPool.make(1)
  let code = run parent(first.pool(), second.pool()) |> Effect.provideAmbient<Tracer>(&provider)
  if code != 0 { return code }
  let mut memory = Memory.make()
  run memory.drain(provider.get())
  let spans = memory.spans()
  // Each `block` starts a pool fiber, which records a `fiber` span and its body's `fiber.run`.
  if spans.length != 8 { return 11 }
  let mut root: u64 = 0
  let mut migrated: u64 = 0
  let mut at: usize = 0
  while at < spans.length {
    if spans[at].name == "root" { root = spans[at].context.span }
    if spans[at].name == "migrated" {
      migrated = spans[at].context.span
      if spans[at].eventCount != 1 || spans[at].events[0].name != "resumed" { return 12 }
    }
    at = at + 1
  }
  if root == 0 || migrated == 0 { return 13 }
  at = 0
  while at < spans.length {
    if spans[at].name == "migrated" && spans[at].parent.span != root { return 14 }
    if (spans[at].name == "sibling" || spans[at].name == "forked") && spans[at].parent.span != migrated { return 15 }
    if spans[at].name == "fiber" && spans[at].parent.span != root { return 16 }
    at = at + 1
  }
  return 0
}
effect fn failed(error: OutOfMemoryError | SpawnError | Cancelled) -> i32 { return 9 }
pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(exercise() |> Effect.provideMut<Allocator>(&mut allocator), failed)
}
