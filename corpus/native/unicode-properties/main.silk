import silk.core.effect { Effect }
import silk.text.unicode { Unicode, Decomposed }
import silk.text.unicode_script { Script }
import silk.text.unicode_properties {
  GeneralCategory,
  CanonicalCombiningClass,
  JoiningType,
  JoiningGroup,
  BidiClass,
  BidiPairedBracketType,
  LineBreak,
  EastAsianWidth,
  GraphemeBreak,
  WordBreak,
  SentenceBreak,
  IndicConjunctBreak,
  VerticalOrientation,
}
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.testing.testing { Testing, AssertionError }

// One canonical decomposition step as a pair, with zeros for "none", so the checks below can
// compare both scalars at once.
struct Pair {
  first: u32,
  second: u32,
}

impl Copy for Pair {}

fn decomposeRaw(cp: u32) -> Pair {
  return match move Unicode.decompose(cp) {
    Option<Decomposed>.Some { value: Decomposed.Pair { first, second } } => Pair {
      first: first,
      second: second,
    }
    Option<Decomposed>.Some { value: Decomposed.Singleton { scalar } } => Pair {
      first: scalar,
      second: 0,
    }
    Option<Decomposed>.None => Pair { first: 0, second: 0 }
  }
}

fn composeRaw(first: u32, second: u32) -> u32 {
  return Unicode.compose(first, second) |> Option<u32>.unwrapOr(0)
}

effect fn categoriesAndScripts() -> ()
  ! AssertionError<'static> {
  run Testing.expect(GeneralCategory.of(0x41) == GeneralCategory.Lu, "uppercase category")
  run Testing.expect(GeneralCategory.of(0x301) == GeneralCategory.Mn, "nonspacing mark category")
  run Testing.expect(Script.of(0x41).value == 0x4c61746e, "Latin script")
  run Testing.expect(Script.of(0x18e00).value == 0x4a757263, "Unicode 18 Jurchen")
  run Testing.expect(Script.of(0x125a8).value == 0x5063756e, "Unicode 18 Proto-Cuneiform")
  run Testing.expect(Script.of(0x3d000).value == 0x5365616c, "Unicode 18 Seal")
  run Testing.expect(Unicode.isMark(0x301) && !Unicode.isMark(0x41), "mark predicate")
}

effect fn canonicalCombiningClasses() -> ()
  ! AssertionError<'static> {
  run Testing.expect(CanonicalCombiningClass.of(0x41).number() == 0, "starter class")
  run Testing.expect(CanonicalCombiningClass.of(0x301).number() == 230, "above class")
  run Testing.expect(CanonicalCombiningClass.of(0xc55).number() == 84, "unmodified Telugu class")
  run Testing.expect(
    CanonicalCombiningClass.of(0xc56).number() == 91,
    "unmodified Telugu length class",
  )
}

effect fn mirroringAndVerticalForms() -> ()
  ! AssertionError<'static> {
  run Testing.expect(Unicode.mirror(40) == 41 && Unicode.mirror(41) == 40, "signed mirror deltas")
  run Testing.expect(Unicode.mirror(65) == 65, "unmirrored identity")
  run Testing.expect(Unicode.verticalForm(0x2013) == 0xfe32, "vertical en dash")
  run Testing.expect(Unicode.verticalForm(0x3001) == 0xfe11, "vertical ideographic comma")
  run Testing.expect(Unicode.verticalForm(65) == 65, "vertical identity")
}

effect fn selectorsIgnorablesAndEmoji() -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    !Unicode.isVariationSelector(0xfdff) && Unicode.isVariationSelector(0xfe00)
      && Unicode.isVariationSelector(0xfe0f)
      && !Unicode.isVariationSelector(0xfe10)
      && !Unicode.isVariationSelector(0xe00ff)
      && Unicode.isVariationSelector(0xe0100)
      && Unicode.isVariationSelector(0xe01ef)
      && !Unicode.isVariationSelector(0xe01f0),
    "variation selector boundaries",
  )
  run Testing.expect(Unicode.isDefaultIgnorable(0xad), "soft hyphen ignorable")
  run Testing.expect(Unicode.isDefaultIgnorable(0x200d), "joiner ignorable")
  run Testing.expect(!Unicode.isDefaultIgnorable(0x41), "letter is visible")
  run Testing.expect(Unicode.isExtendedPictographic(0x1f600), "pictographic emoji")
  run Testing.expect(!Unicode.isExtendedPictographic(0x41), "letter is not pictographic")
}

effect fn arabicAndSyriacJoining() -> ()
  ! AssertionError<'static> {
  run Testing.expect(JoiningType.of(0x41) == JoiningType.U, "nonjoining Latin")
  run Testing.expect(JoiningType.of(0x627) == JoiningType.R, "right joining alef")
  run Testing.expect(JoiningType.of(0x628) == JoiningType.D, "dual joining beh")
  run Testing.expect(JoiningType.of(0x301) == JoiningType.T, "transparent mark")
  run Testing.expect(JoiningType.of(0x200c) == JoiningType.U, "nonjoining ZWNJ override")
  run Testing.expect(JoiningType.of(0x200d) == JoiningType.C, "join-causing ZWJ")
  run Testing.expect(JoiningGroup.of(0x710) == JoiningGroup.Alaph, "Syriac ALAPH group")
  run Testing.expect(JoiningGroup.of(0x715) == JoiningGroup.Dalath_Rish, "Syriac DALATH group")
  run Testing.expect(JoiningGroup.of(0x72a) == JoiningGroup.Dalath_Rish, "Syriac RISH group")
}

effect fn rawCanonicalComposition() -> ()
  ! AssertionError<'static> {
  run Testing.expect(composeRaw(0x41, 0x301) == 0xc1, "canonical pair")
  run Testing.expect(composeRaw(0x41, 0x41) == 0, "absent pair sentinel")
  run Testing.expect(composeRaw(0x41, 0x315) == 0, "noncomposing mark")
  run Testing.expect(Unicode.composesAsSecond(0x301), "composition second membership")
  run Testing.expect(!Unicode.composesAsSecond(0x41), "nonmember second")
  let pair = decomposeRaw(0xc1)
  run Testing.expect(pair.first == 0x41 && pair.second == 0x301, "pair decomposition")
  let singleton = decomposeRaw(0x212b)
  run Testing.expect(
    singleton.first == 0xc5 && singleton.second == 0,
    "raw singleton, not recursive",
  )
  let planeTwo = decomposeRaw(0x2f803)
  run Testing.expect(
    planeTwo.first == 0x20122 && planeTwo.second == 0,
    "plane-two singleton palette",
  )
  let absent = decomposeRaw(0x41)
  run Testing.expect(absent.first == 0 && absent.second == 0, "absent decomposition sentinel")
}

effect fn hangulCompositionBoundaries() -> ()
  ! AssertionError<'static> {
  run Testing.expect(composeRaw(0x1100, 0x1161) == 0xac00, "first Hangul LV")
  run Testing.expect(composeRaw(0x1112, 0x1175) == 0xd788, "last Hangul LV")
  run Testing.expect(composeRaw(0xac00, 0x11a8) == 0xac01, "first Hangul LVT")
  run Testing.expect(composeRaw(0xd788, 0x11c2) == 0xd7a3, "last Hangul LVT")
  run Testing.expect(composeRaw(0xac00, 0x11a7) == 0, "trailing-Jamo base excluded")
  run Testing.expect(composeRaw(0xac00, 0x11c3) == 0, "trailing-Jamo upper bound")
  run Testing.expect(composeRaw(0xac01, 0x11a8) == 0, "LVT does not accept trailing Jamo")
  run Testing.expect(composeRaw(0x1113, 0x1161) == 0, "leading-Jamo upper bound")
  run Testing.expect(composeRaw(0x1100, 0x1176) == 0, "vowel-Jamo upper bound")
  let lv = decomposeRaw(0xac00)
  let lvt = decomposeRaw(0xd7a3)
  let after = decomposeRaw(0xd7a4)
  run Testing.expect(lv.first == 0x1100 && lv.second == 0x1161, "LV decomposition")
  run Testing.expect(lvt.first == 0xd788 && lvt.second == 0x11c2, "LVT raw decomposition")
  run Testing.expect(after.first == 0 && after.second == 0, "Hangul upper bound")
}

effect fn optionalCompositionQueries() -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    (Unicode.compose(0x41, 0x30a) |> Option<u32>.unwrapOr(0)) == 0xc5,
    "optional pair",
  )
  run Testing.expect(
    match move Unicode.decompose(0xc5) {
      Option<Decomposed>.Some { value: Decomposed.Pair { first, second } } => first == 0x41
        && second == 0x30a
      _ => false
    },
    "optional decomposition pair",
  )
  run Testing.expect(
    match move Unicode.decompose(0x212b) {
      Option<Decomposed>.Some { value: Decomposed.Singleton { scalar } } => scalar == 0xc5
      _ => false
    },
    "optional singleton",
  )
  run Testing.expect(
    match move Unicode.decompose(0x41) {
      Option<Decomposed>.None => true
      _ => false
    },
    "optional absent decomposition",
  )
}

effect fn isoScriptNormalization() -> ()
  ! AssertionError<'static> {
  let unknown = Script { value: 0x5a7a7a7a }
  run Testing.expect(
    (Script.parse("lAtN") |> Option<Script>.unwrapOr(unknown)).value == 0x4c61746e,
    "case normalization",
  )
  run Testing.expect(
    (Script.parse("Hans") |> Option<Script>.unwrapOr(unknown)).value == 0x48616e69,
    "Han alias",
  )
  run Testing.expect(
    (Script.parse("Latf") |> Option<Script>.unwrapOr(unknown)).value == 0x4c61746e,
    "Latin alias",
  )
  run Testing.expect(
    (Script.parse("Syre") |> Option<Script>.unwrapOr(unknown)).value == 0x53797263,
    "Syriac alias",
  )
  run Testing.expect(
    (Script.parse("Latn-extra") |> Option<Script>.unwrapOr(unknown)).value == 0x4c61746e,
    "four-byte parsing",
  )
  run Testing.expect(
    (Script.parse("") |> Option<Script>.unwrapOr(unknown)).value == unknown.value,
    "short input retains unknown behavior",
  )
  run Testing.expect(
    match move Script.fromIso15924Tag(0) {
      Option<Script>.None => true
      _ => false
    },
    "zero tag is absent",
  )
  run Testing.expect(
    (Script.fromIso15924Tag(0xffffffff) |> Option<Script>.unwrapOr(unknown)).value == unknown.value,
    "malformed tag is unknown",
  )
}

effect fn invalidCodepointsAndLookupBoundaries() -> ()
  ! AssertionError<'static> {
  let invalid: [u32; 4] = [0x110000, 0x110001, 0x80000000, 0xffffffff]
  let mut i: usize = 0
  while i < invalid.length {
    let cp = invalid[i]
    run Testing.expect(
      GeneralCategory.of(cp) == GeneralCategory.Cn,
      "invalid category is unassigned",
    )
    run Testing.expect(CanonicalCombiningClass.of(cp).number() == 0, "invalid combining class")
    run Testing.expect(Script.of(cp).value == 0x5a7a7a7a, "invalid script is unknown")
    run Testing.expect(
      Unicode.mirror(cp) == cp && Unicode.verticalForm(cp) == cp,
      "invalid mapping identity",
    )
    run Testing.expect(JoiningType.of(cp) == JoiningType.U, "invalid joining is nonjoining")
    run Testing.expect(
      !Unicode.isMark(cp) && !Unicode.isVariationSelector(cp),
      "invalid mark and selector",
    )
    run Testing.expect(
      !Unicode.isDefaultIgnorable(cp) && !Unicode.isExtendedPictographic(cp),
      "invalid boolean properties",
    )
    run Testing.expect(!Unicode.composesAsSecond(cp), "invalid composition membership")
    run Testing.expect(
      composeRaw(cp, 0x301) == 0 && composeRaw(0x41, cp) == 0,
      "invalid composition inputs",
    )
    let parts = decomposeRaw(cp)
    run Testing.expect(parts.first == 0 && parts.second == 0, "invalid decomposition")
    run Testing.expect(
      (Unicode.compose(cp, cp) |> Option<u32>.unwrapOr(0)) == 0,
      "invalid optional composition",
    )
    run Testing.expect(
      match move Unicode.decompose(cp) {
        Option<Decomposed>.None => true
        _ => false
      },
      "invalid optional decomposition",
    )
    i = i + 1
  }
  let edges: [u32; 23] = [
    0,
    0xd7ff,
    0xd800,
    0xdfff,
    0xe000,
    121616,
    121617,
    121618,
    125258,
    125259,
    125260,
    131069,
    131070,
    131071,
    195101,
    195102,
    195103,
    917999,
    918000,
    918001,
    1114109,
    1114110,
    1114111,
  ]
  i = 0
  while i < edges.length {
    let cp = edges[i]
    run Testing.expect(
      Unicode.mirror(cp) <= 0x10ffff && Unicode.verticalForm(cp) <= 0x10ffff,
      "mapping boundary",
    )
    run Testing.expect(Script.of(cp).value != 0, "script boundary")
    run Testing.expect(CanonicalCombiningClass.of(cp).number() <= 254, "class boundary")
    let parts = decomposeRaw(cp)
    run Testing.expect(
      parts.first <= 0x10ffff && parts.second <= 0x10ffff,
      "decomposition boundary",
    )
    let pictographic = Unicode.isExtendedPictographic(cp)
    run Testing.expect(cp < 131070 || !pictographic, "emoji upper bound")
    i = i + 1
  }
}

effect fn typedUnicodeProperties() -> ()
  ! AssertionError<'static> {
  run Testing.expect(BidiClass.of(0x05d0) == BidiClass.R, "Hebrew bidi class")
  run Testing.expect(BidiClass.of(0x0608) == BidiClass.AL, "Arabic bidi class")
  run Testing.expect(BidiClass.of(0x0590) == BidiClass.R, "unassigned Hebrew missing default")
  run Testing.expect(BidiPairedBracketType.of(0x28) == BidiPairedBracketType.Open, "open bracket")
  run Testing.expect(BidiPairedBracketType.of(0x29) == BidiPairedBracketType.Close, "close bracket")
  run Testing.expect(Unicode.bidiPairedBracket(0x28) == 0x29, "bracket mate")
  run Testing.expect(Unicode.bidiPairedBracket(0x41) == 0x41, "nonbracket identity")
  run Testing.expect(LineBreak.of(0x0a) == LineBreak.LF, "line feed class")
  run Testing.expect(EastAsianWidth.of(0x3000) == EastAsianWidth.F, "fullwidth space")
  run Testing.expect(GraphemeBreak.of(0x301) == GraphemeBreak.Extend, "grapheme extend")
  run Testing.expect(WordBreak.of(0x05d0) == WordBreak.Hebrew_Letter, "Hebrew word class")
  run Testing.expect(
    SentenceBreak.of(0x2e) == SentenceBreak.ATerm,
    "sentence abbreviation terminator",
  )
  run Testing.expect(IndicConjunctBreak.of(0x094d) == IndicConjunctBreak.Linker, "Indic linker")
  run Testing.expect(VerticalOrientation.of(0x41) == VerticalOrientation.R, "rotated Latin")
  run Testing.expect(VerticalOrientation.of(0x4e00) == VerticalOrientation.U, "upright Han")
  run Testing.expect(
    Unicode.isEmoji(0x1f600) && Unicode.isEmojiPresentation(0x1f600),
    "emoji presentation",
  )
  run Testing.expect(
    Unicode.isEmojiModifier(0x1f3fb) && Unicode.isEmojiComponent(0x1f3fb),
    "emoji modifier",
  )
  run Testing.expect(Unicode.isEmojiModifierBase(0x1f44d), "emoji modifier base")
  run Testing.expect(Unicode.isRegionalIndicator(0x1f1e6), "regional indicator")
  run Testing.expect(
    !Unicode.isRegionalIndicator(0x1f1e5) && !Unicode.isRegionalIndicator(0x1f200),
    "regional indicator boundaries",
  )
  run Testing.expect(
    Unicode.isDefaultIgnorable(0x115f) && Unicode.isDefaultIgnorable(0x1bca0),
    "normative ignorables, not shaping exclusions",
  )
  run Testing.expect(
    Unicode.isVariationSelector(0x180b) && Unicode.isVariationSelector(0x180f),
    "Mongolian selectors",
  )
  run Testing.expect(
    !Unicode.isVariationSelector(0x180e),
    "Mongolian vowel separator is not selector",
  )
}

effect fn scriptExtensionSets() -> ()
  ! AssertionError<'static> {
  let latin = Script.extensions(0x41)
  run Testing.expect(
    latin.length() == 1 && latin.contains(Script { value: 0x4c61746e }),
    "default singleton",
  )
  run Testing.expect(
    (latin.get(0) |> Option<Script>.unwrapOr(Script { value: 0 })).value == 0x4c61746e,
    "indexed singleton",
  )
  run Testing.expect(
    match move latin.get(1) {
      Option<Script>.None => true
      _ => false
    },
    "set upper bound",
  )
  let prolonged = Script.extensions(0x30fc)
  run Testing.expect(
    prolonged.contains(Script { value: 0x48697261 })
      && prolonged.contains(Script { value: 0x4b616e61 }),
    "Hiragana and Katakana extensions",
  )
  run Testing.expect(!prolonged.contains(Script { value: 0x4c61746e }), "unrelated script absent")
  let invalid = Script.extensions(0xffffffff)
  run Testing.expect(
    invalid.length() == 1 && invalid.contains(Script { value: 0x5a7a7a7a }),
    "invalid default singleton",
  )
}

// Each check above runs in order; the first failed assertion ends the program with its own code.
effect fn all() -> i32
  ! AssertionError<'static> {
  run categoriesAndScripts()
  run canonicalCombiningClasses()
  run mirroringAndVerticalForms()
  run selectorsIgnorablesAndEmoji()
  run arabicAndSyriacJoining()
  run rawCanonicalComposition()
  run hangulCompositionBoundaries()
  run optionalCompositionQueries()
  run isoScriptNormalization()
  run invalidCodepointsAndLookupBoundaries()
  run typedUnicodeProperties()
  run scriptExtensionSets()
  return 42
}

effect fn assertionFailed(error: AssertionError<'static>) -> i32 {
  return 1
}

pub fn main() -> i32 {
  return run Effect.catch(all(), assertionFailed)
}
