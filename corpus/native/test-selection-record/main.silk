import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.testing.observation as Observation
import silk.testing.selection as Selection
import silk.testing.selection { Entry, Input, Previous, Table }

effect fn verify() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let table = Table.empty()
  if Table.length(&table) != 0 { return 1 }
  let mut inputs = List<Input>.make()
  run List<Input>.append(&mut inputs, Input {kind: Observation.VARIABLE, root: Bytes.make(), path: run Bytes.copy(b"HOME"), digest: [7; 32]})
  let mut entries = List<Entry>.make()
  run List<Entry>.append(&mut entries, Entry {identity: run Bytes.copy(b"first"), functions: List<u32>.make(), inputs: move inputs})
  let record = run Selection.record(&table, b"/work", List<Entry>.asSlice(&entries))
  let bytes = Bytes.asSlice(&record)

  // The record reads back in the same working directory.
  let mut previous = run Previous.read(bytes, &table, b"/work")
  let found = match move run Previous.find(&mut previous, b"first") {
    Option<Entry>.Some { value } => move value
    Option<Entry>.None => { return 2 }
  }
  let listed = List<Input>.asSlice(&found.inputs)
  if listed.length != 1 || listed[0].kind != Observation.VARIABLE || listed[0].digest[31] != 7 { return 3 }
  if let Option<Entry>.Some { value } = move run Previous.find(&mut previous, b"second") { drop value return 4 }

  // Another working directory, a cut record, or a changed magic holds no entries.
  let mut elsewhere = run Previous.read(bytes, &table, b"/other")
  if let Option<Entry>.Some { value } = move run Previous.find(&mut elsewhere, b"first") { drop value return 5 }
  let mut cut = run Previous.read(Slice.view<u8>(bytes, 0, bytes.length - 1), &table, b"/work")
  if let Option<Entry>.Some { value } = move run Previous.find(&mut cut, b"first") { drop value return 6 }
  let mut changed = run Bytes.copy(b"X")
  run Bytes.append(&mut changed, Slice.view<u8>(bytes, 1, bytes.length - 1))
  let mut renamed = run Previous.read(Bytes.asSlice(&changed), &table, b"/work")
  if let Option<Entry>.Some { value } = move run Previous.find(&mut renamed, b"first") { drop value return 7 }

  // Without a watch, a report does nothing.
  if Observation.watching() { return 8 }
  Observation.note(Observation.FILE, b"/", b"/absent")
  Observation.mark(Observation.CLOCK)
  return 42
}

effect fn recover(error: OutOfMemoryError) -> i32 { return 9 }

pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(verify(), recover) |> Effect.provideMut<Allocator>(&mut allocator)
}
