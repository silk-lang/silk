import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.num.u32
import silk.num.usize
import silk.testing.observation as Observation
import silk.testing.selection as Selection
import silk.testing.selection { Entry, Input, Previous, Table }
import silk.system.host_input { HostInput, HostInputError }
import silk.core.result { Result }

effect fn verify() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let table = Table.empty()
  if Table.length(&table) != 0 { return 1 }
  let mut inputs = List<Input>.make()
  run List<Input>.append(&mut inputs, Input {kind: Observation.VARIABLE, root: Bytes.make(), path: run Bytes.copy(b"HOME"), digest: [7; 32]})
  let mut entries = List<Entry>.make()
  run List<Entry>.append(&mut entries, Entry {identity: run Bytes.copy(b"first"), functions: List<u32>.make(), inputs: move inputs})
  let record = run Selection.record(&table, b"/work", List<Entry>.asSlice(&entries))
  let bytes = Bytes.asSlice(&record)

  // The record reads back in the same working directory.
  let mut previous = run Previous.read(bytes, &table, b"/work")
  let found = match move run Previous.find(&mut previous, b"first") {
    Option<Entry>.Some { value } => move value
    Option<Entry>.None => { return 2 }
  }
  let listed = List<Input>.asSlice(&found.inputs)
  if listed.length != 1 || listed[0].kind != Observation.VARIABLE || listed[0].digest[31] != 7 { return 3 }
  if let Option<Entry>.Some { value } = move run Previous.find(&mut previous, b"second") { drop value return 4 }

  // Another working directory, a cut record, or a changed magic holds no entries.
  let mut elsewhere = run Previous.read(bytes, &table, b"/other")
  if let Option<Entry>.Some { value } = move run Previous.find(&mut elsewhere, b"first") { drop value return 5 }
  let mut cut = run Previous.read(Slice.view<u8>(bytes, 0, bytes.length - 1), &table, b"/work")
  if let Option<Entry>.Some { value } = move run Previous.find(&mut cut, b"first") { drop value return 6 }
  let mut changed = run Bytes.copy(b"X")
  run Bytes.append(&mut changed, Slice.view<u8>(bytes, 1, bytes.length - 1))
  let mut renamed = run Previous.read(Bytes.asSlice(&changed), &table, b"/work")
  if let Option<Entry>.Some { value } = move run Previous.find(&mut renamed, b"first") { drop value return 7 }

  // Without a watch, a report does nothing.
  if Observation.watching() { return 8 }
  Observation.note(Observation.FILE, b"/", b"/absent")
  Observation.mark(Observation.CLOCK)
  return run notes()
}

// One note as the watch writes it: the kind, then the root and the path, each after its length as
// four little-endian bytes.
effect fn putNote(out: &mut Bytes, kind: u8, root: &[u8], path: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  run Bytes.append(&mut out.*, &[kind])
  run Bytes.append(&mut out.*, &[u32.toU8(usize.toU32(root.length)), 0, 0, 0])
  run Bytes.append(&mut out.*, root)
  run Bytes.append(&mut out.*, &[u32.toU8(usize.toU32(path.length)), 0, 0, 0])
  return run Bytes.append(&mut out.*, path)
}

// A host with no arguments and no environment, the same on every target.
struct NoHost {}

effect fn argumentCount(self: &mut NoHost) -> usize ! HostInputError { return 0 }

effect fn argument(self: &mut NoHost, index: usize) -> Option<Bytes> ! HostInputError | OutOfMemoryError ? &mut Allocator {
  return Option<Bytes>.none()
}

effect fn variable(self: &mut NoHost, name: &[u8]) -> Option<Bytes> ! HostInputError | OutOfMemoryError ? &mut Allocator {
  return Option<Bytes>.none()
}

effect fn variableNames(self: &mut NoHost) -> List<Bytes> ! HostInputError | OutOfMemoryError ? &mut Allocator {
  return List<Bytes>.make()
}

effect fn workingDirectory(self: &mut NoHost) -> Bytes ! HostInputError | OutOfMemoryError ? &mut Allocator {
  return run Bytes.copy(b"/")
}

impl HostInput for NoHost {
  argumentCount: NoHost.argumentCount
  argument: NoHost.argument
  variable: NoHost.variable
  variableNames: NoHost.variableNames
  workingDirectory: NoHost.workingDirectory
}

effect fn notes() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let mut host = NoHost {}
  let checked = run Effect.result(noted() |> Effect.provideMut<HostInput>(&mut host))
  return match move checked {
    Result<i32, HostInputError | OutOfMemoryError>.Success { value } => value
    Result<i32, HostInputError | OutOfMemoryError>.Failure { error } => {
      drop error
      16
    }
  }
}

effect fn noted() -> i32 ! HostInputError | OutOfMemoryError ? &mut Allocator | &mut HostInput {
  // What a test reads and writes in a directory it made is its own: no inputs.
  let mut own = Bytes.make()
  run putNote(&mut own, Observation.TEMPORARY, b"/", b"/tmp/run-1")
  run putNote(&mut own, Observation.WRITE, b"/", b"/tmp/run-1/data")
  run putNote(&mut own, Observation.FILE, b"/", b"/tmp/run-1/data")
  run putNote(&mut own, Observation.WRITE, b"/", b"/tmp/run-1")
  match move run Selection.inputs(Bytes.asSlice(&own)) {
    Option<List<Input>>.Some { value } => { if List<Input>.length(&value) != 0 { return 10 } }
    Option<List<Input>>.None => { return 11 }
  }
  // A write elsewhere, even beside the directory, keeps the test from being recorded.
  let mut outside = Bytes.make()
  run putNote(&mut outside, Observation.TEMPORARY, b"/", b"/tmp/run-1")
  run putNote(&mut outside, Observation.FILE, b"/", b"/tmp/run-10")
  run putNote(&mut outside, Observation.WRITE, b"/", b"/tmp/run-10")
  if let Option<List<Input>>.Some { value } = move run Selection.inputs(Bytes.asSlice(&outside)) { drop value return 12 }
  // So does a note cut short.
  let mut cut = Bytes.make()
  run putNote(&mut cut, Observation.ENTRY, b"/", b"/absent")
  if let Option<List<Input>>.Some { value } = move run Selection.inputs(Slice.view<u8>(Bytes.asSlice(&cut), 0, Bytes.length(&cut) - 1)) {
    drop value
    return 13
  }
  // A read outside it is an input, once.
  let mut read = Bytes.make()
  run putNote(&mut read, Observation.VARIABLE, b"", b"HOME")
  run putNote(&mut read, Observation.VARIABLE, b"", b"HOME")
  match move run Selection.inputs(Bytes.asSlice(&read)) {
    Option<List<Input>>.Some { value } => { if List<Input>.length(&value) != 1 { return 14 } }
    Option<List<Input>>.None => { return 15 }
  }
  return 42
}

effect fn recover(error: OutOfMemoryError) -> i32 { return 9 }

pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(verify(), recover) |> Effect.provideMut<Allocator>(&mut allocator)
}
