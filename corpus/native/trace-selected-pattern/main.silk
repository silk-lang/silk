import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.mem.allocator { Allocator }
import silk.trace { Trace }

// A Trace call makes `split` a body checked under each selected application, where the
// result of `make<A>()` carries the closed type while its patterns still name `A`.
struct Pair<A> { first: Option<A>, count: i32 }

effect fn make<A>(value: A) -> Pair<A> ? &mut Allocator {
  return Pair<A> { first: Option<A>.some(move value), count: 1 }
}

effect fn split<A>(value: A) -> i32 {
  Trace.set("count", &1)
  let mut allocator = Allocator.systemAllocatorProvider()
  let prepared = run make<A>(move value) |> Effect.provideMut<Allocator>(&mut allocator)
  let Pair<A> { first, count } = move prepared
  return match move first {
    Option<A>.Some {value: kept} => {
      drop kept
      count
    }
    Option<A>.None => 2
  }
}

pub fn main() -> i32 {
  let number = run split<i32>(7)
  if number != 1 { return 1 }
  let flag = run split<bool>(true)
  if flag != 1 { return 2 }
  return 0
}
