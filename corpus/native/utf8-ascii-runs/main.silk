import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.text.string { InvalidUtf8, String }

// UTF-8 validation skips ASCII runs in blocks; the reported offset must not depend on where a
// run ends relative to a block.
fn offset(values: &[u8]) -> usize {
  return match move String.fromUtf8(values) {
    Result<string, InvalidUtf8>.Success { value: _ } => 1000
    Result<string, InvalidUtf8>.Failure { error } => error.offset
  }
}

pub fn main() -> i32 {
  let mut buffer: [u8; 72] = [97; 72]
  let mut length: usize = 1
  while length <= 72 {
    let mut position: usize = 0
    while position < length {
      // A lone continuation byte is invalid where it stands.
      buffer[position] = 128
      if offset(Slice.view(&buffer, 0, length)) != position { return 1 }
      // A two-byte sequence is valid when it fits, else invalid at its start.
      buffer[position] = 195
      if position + 1 < length {
        buffer[position + 1] = 169
        if offset(Slice.view(&buffer, 0, length)) != 1000 { return 2 }
        // A bad continuation is reported at the continuation.
        buffer[position + 1] = 65
        if offset(Slice.view(&buffer, 0, length)) != position + 1 { return 3 }
        buffer[position + 1] = 97
      } else {
        if offset(Slice.view(&buffer, 0, length)) != position { return 4 }
      }
      buffer[position] = 97
      position = position + 1
    }
    if offset(Slice.view(&buffer, 0, length)) != 1000 { return 5 }
    length = length + 1
  }
  return 0
}
