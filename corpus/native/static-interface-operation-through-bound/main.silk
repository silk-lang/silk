// Static code in a generic body may call a `static` operation of a bound's interface without
// naming the bounded parameter: `Described.describe()` selects `B`'s operation, so the body's static
// work waits for `B`, whether the call is a `static if` condition or a `let static` read later.
struct Spec<T> {
  pub count: usize,
}

interface Described {
  static fn describe() -> Spec<Self>
}

struct Leaf {}

struct Tree {}

impl Described for Leaf {
  static fn describe() -> Spec<Leaf> {
    return Spec<Leaf> { count: 0 }
  }
}

impl Described for Tree {
  static fn describe() -> Spec<Tree> {
    return Spec<Tree> { count: 3 }
  }
}

fn children<B: Described>(value: &B) -> i32 {
  let static spec: Spec<B> = Described.describe()
  static if spec.count != 0 {
    return 10
  }
  return 1
}

fn direct<B: Described>(value: &B) -> i32 {
  static if Described.describe().count != 0 {
    return 20
  }
  return 2
}

pub fn main() -> i32 {
  let leaf = Leaf {}
  let tree = Tree {}
  // 1 + 10 + 2 + 20.
  return children(&leaf) + children(&tree) + direct(&leaf) + direct(&tree) + 9
}
