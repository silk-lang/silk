struct Token {
  value: i32,
}
union Reply {
  Value { amount: i32 },
  Empty,
}
fn make(value: i32) -> Token { return Token { value: value } }
fn reply(amount: i32) -> Reply { return Reply.Value { amount: amount } }
pub fn main() -> i32 {
  let first = match make(30) {
    Token { value } => value
  }
  let second = match reply(12) {
    Reply.Value { amount } => amount
    Reply.Empty => 0
  }
  return first + second
}
