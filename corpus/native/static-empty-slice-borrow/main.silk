import silk.usize
struct Point {
  x: i32,
}

const NONE: [Point; 0] = []

struct Holder<'s> {
  points: &'s [Point],
}

fn fromLiteral() -> &'static [Point] {
  return &[]
}

fn fromConst() -> &'static [Point] {
  return &NONE
}

fn bytes() -> &'static [u8] {
  return &[]
}

fn holder<'s>() -> Holder<'s> {
  return Holder { points: &[] }
}

pub fn main() -> i32 {
  let h = holder()
  return usize.toI32(fromLiteral().length + fromConst().length + bytes().length + h.points.length) + 42
}
