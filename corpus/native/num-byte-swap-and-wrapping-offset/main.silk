import silk.mem.pointer { Pointer }
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.usize

pub fn main() -> i32 {
  if u16.byteSwap(0x0102) != 0x0201 { return 1 }
  if u32.byteSwap(0x01020304) != 0x04030201 { return 2 }
  if u64.byteSwap(0x0102030405060708) != 0x0807060504030201 { return 3 }
  if usize.byteSwap(usize.byteSwap(0x1234)) != 0x1234 { return 4 }
  // Every Silk target is little-endian.
  if u32.fromLittleEndian(0x01020304) != 0x01020304 || u32.toLittleEndian(0x01020304) != 0x01020304 { return 5 }
  if u32.fromBigEndian(0x01020304) != 0x04030201 || u16.toBigEndian(0x0102) != 0x0201 { return 6 }
  let bytes: [u8; 8] = [1, 2, 3, 4, 5, 6, 7, 8]
  unsafe {
    let start = Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(Pointer.fromSlice<u8>(&bytes))
    let word = Pointer.readUnaligned<u32>(Pointer.castUnaligned<u8, u32>(Pointer.at<u8>(start, 1)))
    if u32.fromLittleEndian(word) != 0x05040302 { return 7 }
    // A base before the array, addressed back inside it.
    let before = Pointer.wrappingOffset<u8>(start, -100)
    if Pointer.read<u8>(Pointer.at<u8>(Pointer.wrappingOffset<u8>(before, 103), 0)) != 4 { return 8 }
  }
  let mut out: [u8; 4] = [0; 4]
  unsafe {
    let target = Intrinsic.pointerRequalify<?[*]mut u8, [*]mut u8>(Pointer.fromMutSlice<u8>(&mut out))
    Pointer.writeUnaligned<u16>(Pointer.castUnalignedMut<u8, u16>(Pointer.atMut<u8>(target, 1)), u16.toBigEndian(0x0a0b))
    let shifted = Pointer.wrappingOffsetMut<u8>(target, -7)
    Pointer.write<u8>(Pointer.atMut<u8>(shifted, 10), 9)
  }
  if out[1] != 0x0a || out[2] != 0x0b || out[3] != 9 { return 9 }
  return 42
}
