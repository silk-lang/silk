// An alias whose own parameters are lifetimes, used as a call qualifier without them, leaves
// them to the call to infer, as `Wrapped<i32>.new` does for the region it omits.
struct Wrapped<'a, T> { value: &'a T, }
impl<'a, T> Wrapped<'a, T> {
  fn new(value: &'a T) -> Self { return Self { value: value } }
  fn get(self: &Self) -> &'a T { return self.value }
}
type IntRef<'a> = Wrapped<'a, i32>
type Pair<'a, 'b> = Wrapped<'a, &'b i32>

fn wrap(value: &i32) -> i32 {
  let result = IntRef.new(value)
  return result.get().*
}

fn twice(first: &i32, second: &i32) -> i32 {
  let a = IntRef.new(first)
  let b = IntRef.new(second)
  return a.get().* + b.get().*
}

fn nested(value: &i32) -> i32 {
  let inner = &value
  let outer = Pair.new(inner)
  return outer.get().*.*
}

pub fn main() -> i32 {
  let value: i32 = 20
  let other: i32 = 1
  return wrap(&value) + twice(&value, &other) + nested(&other)
}
