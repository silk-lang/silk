import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.box { Box }
import silk.schema.issue { Issue, IssueReason, SchemaError, SchemaErrors, Span, ValueKind }
import silk.schema.msgpack { SchemaMsgpack }
import silk.schema.schema { Dictionary, Schema, Spec }
import silk.text.string { String }

struct Capture {
  bytes: [u8; 1024],
  length: usize
}

impl Writer for Capture {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> ()
    ! WriterError
    ? &mut Writer {
    if self.length + value.length > 1024 {
      fail Writer.failure()
    }
    Slice.copyInto<u8>(&mut self.bytes, self.length, value)
    self.length = self.length + value.length
    return ()
  }

  effect fn flush(self: &mut Self) -> ()
    ! WriterError
    ? &mut Writer {
    return ()
  }
}

impl Capture {
  fn make() -> Capture {
    return Capture { bytes: [0; 1024], length: 0 }
  }

  fn written(self: &Self) -> &[u8] {
    return Slice.view<u8>(&self.bytes, 0, self.length)
  }
}

union Shape {
  Circle { pub radius: u32 },
  Label { pub text: String, pub note: Option<String> },
}

impl Schema for Shape {}

union Level {
  Low,
  High,
}

impl Schema for Level {}

struct Item {
  pub id: u8,
  pub data: Bytes
}

impl Schema for Item {}

struct Record {
  pub on: bool,
  pub small: u8,
  pub signed: i64,
  pub wide: u64,
  pub ratio: f64,
  pub name: String,
  pub blob: Bytes,
  pub absent: Option<i32>,
  pub present: Option<i32>,
  pub items: List<Item>,
  pub counts: Dictionary<i32>,
  pub shape: Shape,
  pub level: Level
}

impl Schema for Record {
  static fn spec() -> Spec<Record> {
    return Spec<Record>.of() |> Spec<Record>.strict()
  }
}

struct Pair {
  pub left: i32,
  pub right: Option<i32>
}

impl Schema for Pair {}

struct Chain {
  pub next: Option<Box<Chain>>
}

impl Schema for Chain {}

effect fn record() -> Record
  ! SchemaError | OutOfMemoryError
  ? &mut Allocator {
  let mut items = List<Item>.make()
  run items.append(Item { id: 1, data: run Bytes.copy(b"\xff\x00") })
  run items.append(Item { id: 200, data: Bytes.make() })
  let mut counts = Dictionary<i32>.make()
  run Effect.catch<Issue>(
    counts.insert(run String.copy("a"), -1),
    effect |issue: Issue| -> ()
      ! OutOfMemoryError {
      return ()
    },
  )
  return Record {
    on: true,
    small: 255,
    signed: -129,
    wide: 18446744073709551615,
    ratio: 0.5,
    name: run String.copy("silk"),
    blob: run Bytes.copy(b"\x00\x01\x02"),
    absent: Option<i32>.none(),
    present: Option<i32>.some(7),
    items: move items,
    counts: move counts,
    shape: Shape.Label { text: run String.copy("x"), note: Option<String>.none() },
    level: Level.High,
  }
}

// The bytes `record()` writes: a map of the 12 fields that are not `None`, in declaration order.
const RECORD: &[u8] = b"\x8c\xa2on\xc3\xa5small\xcc\xff\xa6signed\xd1\xff\x7f\xa4wide\xcf\xff\xff\xff\xff\xff\xff\xff\xff\xa5ratio\xcb\x3f\xe0\x00\x00\x00\x00\x00\x00\xa4name\xa4silk\xa4blob\xc4\x03\x00\x01\x02\xa7present\x07\xa5items\x92\x82\xa2id\x01\xa4data\xc4\x02\xff\x00\x82\xa2id\xcc\xc8\xa4data\xc4\x00\xa6counts\x81\xa1a\xff\xa5shape\x82\xa4type\xa5Label\xa4text\xa1x\xa5level\xa4High"

effect fn roundTrip() -> i32
  ! SchemaError | WriterError | OutOfMemoryError
  ? &mut Allocator {
  let value = run record()
  let mut capture = Capture.make()
  run SchemaMsgpack.encode<Record>(&value) |> Effect.provideMut<Writer>(&mut capture)
  if capture.written() != RECORD {
    return 1
  }
  let again = run SchemaMsgpack.decode<Record>(capture.written())
  if !again.on || again.small != 255 || again.signed != -129 || again.wide != 18446744073709551615
    || again.ratio != 0.5 {
    return 2
  }
  if again.name.view() != "silk" || again.blob.asSlice() != b"\x00\x01\x02" || again.absent.isSome()
    || again.present.unwrapOr(0) != 7 {
    return 3
  }
  let items = again.items.asSlice()
  if items.length != 2 || items[0].data.asSlice() != b"\xff\x00" || items[1].id != 200
    || items[1].data.length() != 0 {
    return 4
  }
  match again.counts.find("a") {
    Option<&i32>.Some { value: count } => {
      if count.* != -1 {
        return 5
      }
    }
    Option<&i32>.None => {
      return 6
    }
  }
  match &again.shape {
    Shape.Label { text, note } => {
      if text.view() != "x" || note.isSome() {
        return 7
      }
    }
    _ => {
      return 8
    }
  }
  match &again.level {
    Level.High => {}
    Level.Low => {
      return 9
    }
  }
  return 0
}

effect fn pair(bytes: &[u8]) -> i32
  ! SchemaError | OutOfMemoryError
  ? &mut Allocator {
  let value = run SchemaMsgpack.decode<Pair>(bytes)
  return value.left * 100 + value.right.unwrapOr(-1)
}

effect fn lenient() -> i32
  ! SchemaError | OutOfMemoryError
  ? &mut Allocator {
  // Keys in any order, integers in wider formats than they need (`int 64` 3, `uint 16` 4).
  if (run pair(b"\x82\xa5right\xcd\x00\x04\xa4left\xd3\x00\x00\x00\x00\x00\x00\x00\x03")) != 304 {
    return 20
  }

  // `nil` and an absent key are both `None`.
  if (run pair(b"\x82\xa4left\x01\xa5right\xc0")) != 99 || (run pair(b"\x81\xa4left\x01")) != 99 {
    return 21
  }

  // Entries no field names are read past whatever they hold: here an array of a map, an
  // extension value and binary data, in a `map 16`.
  if (run pair(
    b"\xde\x00\x03\xa5extra\x93\x81\x01\xc0\xd4\x05\x00\xc4\x01\x00\xa4left\x02\xa5right\x03",
  ))
    != 203 {
    return 22
  }

  // The first of two entries with one key is read.
  if (run pair(b"\x82\xa4left\x05\xa4left\x06")) != 499 {
    return 23
  }

  // A float field reads an integer and a `float 32`.
  if (run SchemaMsgpack.decode<f64>(b"\x02")) != 2.0
    || (run SchemaMsgpack.decode<f64>(b"\xca\x3f\xc0\x00\x00")) != 1.5 {
    return 24
  }
  let shape = run SchemaMsgpack.decode<Shape>(b"\x82\xa6radius\x09\xa4type\xa6Circle")
  match &shape {
    Shape.Circle { radius } => {
      if radius != 9 {
        return 25
      }
    }
    _ => {
      return 26
    }
  }
  return 0
}

// Whether decoding `bytes` as a `Record`-like `T` fails at `path` with `reason`, over the bytes
// from `start` to `end`.
effect fn rejected<T: Schema>(
  bytes: &[u8],
  path: string,
  reason: IssueReason,
  start: usize,
  end: usize,
) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  return match move run Effect.result(SchemaMsgpack.decode<T>(bytes)) {
    Result<T, SchemaError | OutOfMemoryError>.Success { .. } => false
    Result<T, SchemaError | OutOfMemoryError>.Failure { error } => match move error {
      SchemaError { path: found, issue, .. } => found.matchesText(path) && issue.reason == reason
        && match issue.span {
          Option<Span>.Some { value } => value.start == start && value.end == end
          Option<Span>.None => false
        }
      OutOfMemoryError {} => {
        fail OutOfMemoryError {}
      }
    }
  }
}

effect fn rejections() -> i32
  ! OutOfMemoryError
  ? &mut Allocator {
  if !(run rejected<Pair>(b"\x81\xa4left\xa1x", "left", IssueReason.InvalidType, 6, 8)) {
    return 40
  }
  if !(run rejected<Pair>(
    b"\x81\xa4left\xce\x80\x00\x00\x00",
    "left",
    IssueReason.InvalidValue,
    6,
    11,
  )) {
    return 41
  }
  if !(run rejected<Pair>(b"\x81\xa5right\x01", "left", IssueReason.MissingKey, 0, 1)) {
    return 42
  }

  // A whole float is still not an integer.
  if !(run rejected<Pair>(
    b"\x81\xa4left\xcb\x40\x00\x00\x00\x00\x00\x00\x00",
    "left",
    IssueReason.InvalidType,
    6,
    15,
  )) {
    return 43
  }
  if !(run rejected<u64>(b"\xff", "", IssueReason.InvalidValue, 0, 1))
    || !(run rejected<i64>(
      b"\xcf\x80\x00\x00\x00\x00\x00\x00\x00",
      "",
      IssueReason.InvalidValue,
      0,
      9,
    ))
    || !(run rejected<u8>(b"\xcd\x01\x00", "", IssueReason.InvalidValue, 0, 3)) {
    return 44
  }

  // Text and binary data do not stand in for each other.
  if !(run rejected<Item>(b"\x82\xa2id\x01\xa4data\xa2hi", "data", IssueReason.InvalidType, 10, 13))
    || !(run rejected<String>(b"\xc4\x01a", "", IssueReason.InvalidType, 0, 3)) {
    return 45
  }

  // An extension value has no schema type; a map key must be text.
  if !(run rejected<Pair>(b"\x81\xa4left\xd4\x05\x00", "left", IssueReason.InvalidType, 6, 9))
    || !(run rejected<Pair>(b"\x81\x01\x02", "", IssueReason.InvalidType, 1, 2))
    || !(run rejected<Pair>(b"\x91\x01", "", IssueReason.InvalidType, 0, 1)) {
    return 46
  }
  if !(run rejected<List<Pair>>(
    b"\x92\x81\xa4left\x01\x81\xa4left\xc3",
    "[1].left",
    IssueReason.InvalidType,
    14,
    15,
  )) {
    return 47
  }

  // The input is exactly one value: no bytes after it, none missing, no reserved byte.
  if !(run rejected<Pair>(b"\x81\xa4left\x01\x00", "", IssueReason.InvalidSyntax, 7, 8))
    || !(run rejected<Pair>(b"\x81\xa4left", "", IssueReason.InvalidSyntax, 6, 6))
    || !(run rejected<Pair>(b"", "", IssueReason.InvalidSyntax, 0, 0))
    || !(run rejected<Pair>(b"\x81\xa4left\xc1", "", IssueReason.InvalidSyntax, 6, 7)) {
    return 48
  }
  if !(run rejected<Level>(b"\xa3Mid", "", IssueReason.UnknownVariant, 0, 4)) {
    return 49
  }
  return 0
}

effect fn strict() -> i32
  ! OutOfMemoryError
  ? &mut Allocator {
  // RECORD with one more entry, `"extra": 1`, after the 12 it has.
  let mut bytes: [u8; 512] = [0; 512]
  Slice.copyInto<u8>(&mut bytes, 0, RECORD)
  bytes[0] = 141
  Slice.copyInto<u8>(&mut bytes, RECORD.length, b"\xa5extra\x01")
  let input = Slice.view<u8>(&bytes, 0, RECORD.length + 7)
  if !(run rejected<Record>(
    input,
    "extra",
    IssueReason.UnexpectedKey,
    RECORD.length + 1,
    RECORD.length + 6,
  )) {
    return 60
  }
  return 0
}

effect fn collected() -> i32
  ! OutOfMemoryError
  ? &mut Allocator {
  // [{"left": "x"}, {"left": 1, "right": true}, {"right": 2}]
  let input = b"\x93\x81\xa4left\xa1x\x82\xa4left\x01\xa5right\xc3\x81\xa5right\x02"
  let errors = match move run Effect.result(SchemaMsgpack.decodeAll<List<Pair>>(input)) {
    Result<List<Pair>, SchemaErrors | OutOfMemoryError>.Success { .. } => {
      return 70
    }
    Result<List<Pair>, SchemaErrors | OutOfMemoryError>.Failure { error } => match move error {
      SchemaErrors { errors, .. } => move errors
      OutOfMemoryError {} => {
        fail OutOfMemoryError {}
      }
    }
  }
  let found = errors.asSlice()
  if found.length != 3 {
    return 71
  }
  if !found[0].path.matchesText("[0].left") || found[0].issue.reason != IssueReason.InvalidType
    || found[0].issue.found != ValueKind.Text {
    return 72
  }
  if !found[1].path.matchesText("[1].right") || found[1].issue.reason != IssueReason.InvalidType
    || found[1].issue.found != ValueKind.Boolean {
    return 73
  }
  if !found[2].path.matchesText("[2].left") || found[2].issue.reason != IssueReason.MissingKey {
    return 74
  }

  // Bytes that are not one MessagePack value are the one problem reported.
  let broken = match move run Effect.result(
    SchemaMsgpack.decodeAll<List<Pair>>(b"\x92\x81\xa4left\xa1x"),
  ) {
    Result<List<Pair>, SchemaErrors | OutOfMemoryError>.Success { .. } => {
      return 75
    }
    Result<List<Pair>, SchemaErrors | OutOfMemoryError>.Failure { error } => match move error {
      SchemaErrors { errors: only, .. } => move only
      OutOfMemoryError {} => {
        fail OutOfMemoryError {}
      }
    }
  }
  if broken.length() != 1 || broken.asSlice()[0].issue.reason != IssueReason.InvalidSyntax {
    return 76
  }
  let fine = match move run Effect.result(
    SchemaMsgpack.decodeAll<List<Pair>>(b"\x91\x81\xa4left\x04"),
  ) {
    Result<List<Pair>, SchemaErrors | OutOfMemoryError>.Success { value } => move value
    Result<List<Pair>, SchemaErrors | OutOfMemoryError>.Failure { .. } => {
      return 77
    }
  }
  if fine.length() != 1 || fine.asSlice()[0].left != 4 {
    return 78
  }
  return 0
}

// A chain of `links` values, each the `next` of the one before.
effect fn chain(links: usize) -> Chain
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut value = Chain { next: Option<Box<Chain>>.none() }
  let mut at: usize = 1
  while at < links {
    let inner = move value
    value = Chain { next: Option<Box<Chain>>.some(run Box<Chain>.make(move inner)) }
    at = at + 1
  }
  return move value
}

effect fn encodes(value: &Chain, capture: &mut Capture) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  return match move run Effect.result(
    SchemaMsgpack.encode<Chain>(value) |> Effect.provideMut<Writer>(&mut capture.*),
  ) {
    Result<(), SchemaError | WriterError | OutOfMemoryError>.Success { .. } => true
    Result<(), SchemaError | WriterError | OutOfMemoryError>.Failure { error } => match move error {
      OutOfMemoryError {} => {
        fail OutOfMemoryError {}
      }
      _ => false
    }
  }
}

effect fn depth() -> i32
  ! SchemaError | OutOfMemoryError
  ? &mut Allocator {
  // 64 maps nested in one another are written and read back; the 65th is refused both ways.
  let deepest = run chain(64)
  let mut capture = Capture.make()
  if !(run encodes(&deepest, &mut capture)) {
    return 90
  }
  if capture.length != 63 * 6 + 1 {
    return 91
  }
  drop run SchemaMsgpack.decode<Chain>(capture.written())
  let deeper = run chain(65)
  let mut refused = Capture.make()
  if run encodes(&deeper, &mut refused) {
    return 92
  }
  let mut bytes: [u8; 400] = [0; 400]
  let mut at: usize = 0
  while at < 64 {
    Slice.copyInto<u8>(&mut bytes, at * 6, b"\x81\xa4next")
    at = at + 1
  }
  bytes[64 * 6] = 128
  return match move run Effect.result(
    SchemaMsgpack.decode<Chain>(Slice.view<u8>(&bytes, 0, 64 * 6 + 1)),
  ) {
    Result<Chain, SchemaError | OutOfMemoryError>.Success { .. } => 93
    Result<Chain, SchemaError | OutOfMemoryError>.Failure { error } => match move error {
      SchemaError { path, issue, .. } => {
        // The 65th map is refused where it starts, 64 fields down.
        let start = match issue.span {
          Option<Span>.Some { value } => value.start
          Option<Span>.None => 0
        }
        if path.length() == 64 && issue.reason == IssueReason.InvalidValue && start == 64 * 6 {
          0
        } else {
          94
        }
      }
      OutOfMemoryError {} => {
        fail OutOfMemoryError {}
      }
    }
  }
}

pub effect fn main() -> i32
  ! SchemaError | WriterError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let first = run roundTrip() |> Effect.provideMut<Allocator>(&mut allocator)
  if first != 0 {
    return first
  }
  let second = run lenient() |> Effect.provideMut<Allocator>(&mut allocator)
  if second != 0 {
    return second
  }
  let third = run rejections() |> Effect.provideMut<Allocator>(&mut allocator)
  if third != 0 {
    return third
  }
  let fourth = run strict() |> Effect.provideMut<Allocator>(&mut allocator)
  if fourth != 0 {
    return fourth
  }
  let fifth = run collected() |> Effect.provideMut<Allocator>(&mut allocator)
  if fifth != 0 {
    return fifth
  }
  return run depth() |> Effect.provideMut<Allocator>(&mut allocator)
}
