  ]
  let digest14 = Md5.hash(message14)
  if !same(&digest14, &expected14) {
    return 15
  }
  let message = b"abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789abcdefghijklmnopqrstuvwxyz"
  let expected = Md5.hash(message)
  let mut split: usize = 0
  while split <= message.length {
    let mut state = Md5.make()
    state.update(Slice.view<u8>(message, 0, split))
    state.update(b"")
    state.update(Slice.view<u8>(message, split, message.length - split))
    let result = state.finish()
    if !same(&result, &expected) {
      return 40
    }
    split = split + 1
  }
  return 0
}
