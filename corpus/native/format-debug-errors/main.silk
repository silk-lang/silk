  run Format.debug(&Option<standard_input.StreamReadError>.none())
  run Format.debug(&Option<string.InvalidUtf8>.none())
  run Format.debug(&Option<string.String>.none())
  run Format.debug(&Option<testing.AssertionError<'static>>.none())
