  run Format.debug(&Option<tls_client.ProtocolReason>.none())
  run Format.debug(&Option<tls_client.CertificateIdentityFailure>.none())
  run Format.debug(&Option<tls_client.CertificateVerifyFailure>.none())
  run Format.debug(&Option<tls_client.TlsLimitKind>.none())
  run Format.debug(&Option<tls_client.ClientOperation>.none())
  run Format.debug(&Option<connection.ConnectionError>.none())
  run Format.debug(&Option<tls_hkdf.LabelError>.none())
  run Format.debug(&Option<tls_record.RecordError>.none())
  run Format.debug(&Option<toml_scanner.TomlError>.none())
  run Format.debug(&Option<toml_scanner.TomlReason>.none())
  run Format.debug(&Option<trust_snapshot.TrustSourceError>.none())
  run Format.debug(&Option<trust_snapshot.TrustLimitKind>.none())
  run Format.debug(&Option<trust_snapshot.TrustConfigurationReason>.none())
  run Format.debug(&Option<trust_snapshot.TrustFileOperation>.none())
  run Format.debug(&Option<uri.OwnedUri>.none())
  run Format.debug(&Option<percent.DecodeError>.none())
  run Format.debug(&Option<reference.ParseError>.none())
