effect fn build() -> i32 ! WriterError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let text = run String.copy("caf\u{e9}") |> Effect.provideMut<Allocator>(&mut allocator)
  let bytes = run Bytes.copy(b"hi") |> Effect.provideMut<Allocator>(&mut allocator)
  let mut writer = StdoutWriter.make()
  run render(&text, &bytes) |> Effect.provideMut<Writer>(&mut writer)
  if Bytes.length(&bytes) == 99 { run everyError() |> Effect.provideMut<Writer>(&mut writer) }
  return 42
}
effect fn recover(error: WriterError | OutOfMemoryError) -> i32 { return 1 }
pub fn main() -> i32 { return run Effect.catchAll(build(), recover) }
