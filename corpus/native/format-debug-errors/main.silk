// A struct with a private field writes its Debug form by hand, with a record.
struct Secret {
  pub visible: i32
  hidden: i32
}

impl Debug for Secret {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    let mut record = run Format.debugRecord("Secret", &mut formatter)
    run Format.debugField(&mut record, "visible", &self.visible, &mut formatter)
    return run Format.debugFinish(record, &mut formatter)
  }
}

// A record with no field writes only its name.
struct Marker {}

impl Debug for Marker {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    let record = run Format.debugRecord("Marker", &mut formatter)
    return run Format.debugFinish(record, &mut formatter)
  }
}

effect fn render(text: &String, bytes: &Bytes) -> () ! WriterError ? &mut Writer {
  let json = JsonError.at(JsonReason.UnexpectedByte, 3)
  run Format.format("{:?}\n", &(move json, ))
  let compact = FileSystem.errorWithCode(FileSystem.readFileOperation(), FileSystem.notFound(), 2)
  let pretty = FileSystem.errorWithCode(FileSystem.readFileOperation(), FileSystem.notFound(), 2)
  run Format.format("{:?}\n{:#?}\n", &(move compact, move pretty))
  run Format.format("{:?} {:?}\n", &(FileReason { code: 42 }, FileSystem.error(FileSystem.statOperation(), FileSystem.other())))
  let small: BufferError = BufferError.BufferTooSmall { requested: 8, capacity: 4 }
  let invalid: BufferError = BufferError.InvalidCapacity { capacity: 0 }
  run Format.format("{:?}\n{:#?}\n", &(move small, move invalid))
  run Format.format("{:?} {:?}\n", &(Writer.failure(), OutOfMemoryError {}))
  run Format.format("{:?} {:?}\n", &(Secret { visible: 1, hidden: 2 }, Marker {}))
  run Format.format("{:#?}\n", &(Secret { visible: 1, hidden: 2 }, ))
  run Format.debug(text)
  run Writer.writeAll(b" ")
  run Format.debug(bytes)
  return run Writer.writeAll(b"\n")
}

// Each error type of the standard library implements Debug. This function never runs; it makes
// the compiler check the Debug form of each one.
effect fn everyError() -> () ! WriterError ? &mut Writer {
  run Format.debug(&Option<aes_gcm.AesGcmError>.none())
  run Format.debug(&Option<allocator.OutOfMemoryError>.none())
  run Format.debug(&Option<base64.Base64Error>.none())
  run Format.debug(&Option<base64.Base64Reason>.none())
  run Format.debug(&Option<buffered_input.BufferError>.none())
  run Format.debug(&Option<byte_duplex.ByteIoError>.none())
