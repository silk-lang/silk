  run Format.debug(&Option<certificate.DecodeError>.none())
  run Format.debug(&Option<certificate.DecodeClass>.none())
  run Format.debug(&Option<certificate.DecodeReason>.none())
  run Format.debug(&Option<certificate.DecodeOffsetSpace>.none())
  run Format.debug(&Option<certificate_identities.SanDecodeError>.none())
  run Format.debug(&Option<certificate_identities.SanDecodeClass>.none())
  run Format.debug(&Option<certificate_identities.SanDecodeReason>.none())
  run Format.debug(&Option<certificate_path.ValidationError>.none())
  run Format.debug(&Option<certificate_path.ValidationClass>.none())
  run Format.debug(&Option<certificate_path.ValidationReason>.none())
  run Format.debug(&Option<certificate_path.ValidationLocation>.none())
  run Format.debug(&Option<certificate_path.ValidationLimit>.none())
  run Format.debug(&Option<certificate_profile.ProfileError>.none())
  run Format.debug(&Option<certificate_profile.ProfileClass>.none())
  run Format.debug(&Option<certificate_profile.ProfileReason>.none())
  run Format.debug(&Option<certificate_profile.ProfileOffsetSpace>.none())
  run Format.debug(&Option<chacha20_poly1305.AeadError>.none())
