// Method syntax supplies static arguments: the checker finds the method, and the caller's body is
// selected with the call's static slots, as for `Leaf.own(&leaf, spec)`.
struct Spec {
  size: i32,
}

struct Leaf {
  value: i32,
}

impl Leaf {
  fn own(self: &Leaf, static spec: Spec) -> i32 {
    return self.value + spec.size
  }

  fn scaled(self: Leaf, base: i32, static factor: i32, extra: i32) -> i32 {
    return (self.value + base) * factor + extra
  }
}

fn generic<T>(leaf: &Leaf, item: T) -> i32 {
  drop item
  let static spec = Spec {size: 10}
  return leaf.own(spec)
}

pub fn main() -> i32 {
  let leaf = Leaf {value: 3}
  let small = leaf.own(Spec {size: 2})
  let large = generic<bool>(&leaf, true)
  let mixed = Leaf {value: 1}.scaled(1, 4, 2)
  return small + large + mixed
}
