import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StdoutWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.system_clock { SystemClock }
import silk.text.format { Format }
import silk.text.string { String }
import silk.time.instant { Instant }
import silk.time.now { Now }
import silk.time.zone { Zone }
import silk.time.zoned { ZonedDateTime }
import silk.time.zones { FixedLocalZone, LocalZone, NoLocalZoneError, TimeZones, ZoneLookupError }
import silk.time.zones_bundle { ZoneBundle }
import silk.time.zones_bundled { BundledTimeZones }
import silk.time.zones_native { PreferSystemTimeZones }
import silk.num.i64
import silk.num.u64
import silk.num.usize

// The time zone database inside the program, the reader of a bundle, and the functions of `Now`.
//
// The `zone` lines of `expected.stdout` come from Python's `zoneinfo` over the files that
// `zic -b fat` writes for the same release, so they also check the transitions that
// `scripts/time/generate-tzdb` takes out of each file. America/Ojinaga at 1667116800 is the case
// that `zic -b slim` of glibc 2.39 gets wrong. The other lines are hand-written.

struct FixedClock {}

effect fn fixedNow(self: &mut FixedClock) -> Instant {
  return Instant.fromUnixSeconds(1795109782)
}

effect fn fixedResolution(self: &mut FixedClock) -> u64 {
  return 1
}

impl SystemClock for FixedClock {
  now: fixedNow
  getResolution: fixedResolution
}

effect fn zoneRow(name: string, at: i64) -> ()
  ! OutOfMemoryError | WriterError
  ? &mut TimeZones | &mut Allocator | &mut Writer {
  let found = run Effect.result(TimeZones.zone(name))
  match move found {
    Result<Zone, ZoneLookupError | OutOfMemoryError>.Success { value } => {
      let seen = ZonedDateTime.make(Instant.fromUnixSeconds(at), &value)
      let daylight = if seen.isDaylight() { "dst" } else { "std" }
      run Format.format("zone {} {} {} {} {}\n", &(name, at, seen, seen.abbreviation(), daylight))
    }
    Result<Zone, ZoneLookupError | OutOfMemoryError>.Failure { error } => match move error {
      ZoneLookupError failure => {
        run Format.format("zone {} {:?}\n", &(name, failure.reason))
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  return ()
}

effect fn zoneRows() -> () ! OutOfMemoryError | WriterError ? &mut TimeZones | &mut Allocator | &mut Writer {
  run zoneRow("America/Ojinaga", 1667116799)
  run zoneRow("America/Ojinaga", 1667116800)
  run zoneRow("America/Ojinaga", 1667120400)
  run zoneRow("America/Ojinaga", 1667718000)
  run zoneRow("America/Ojinaga", 1678608000)
  run zoneRow("America/Sao_Paulo", 1795109782)
  run zoneRow("america/sao_paulo", 1550368800)
  run zoneRow("Asia/Calcutta", 1795109782)
  run zoneRow("Europe/Rome", 1795109782)
  run zoneRow("Europe/Rome", 4117219200)
  run zoneRow("Europe/Rome", 4102444800)
  run zoneRow("Europe/Dublin", 1782864000)
  run zoneRow("Africa/Casablanca", 1795109782)
  run zoneRow("Australia/Lord_Howe", 1795109782)
  run zoneRow("Pacific/Apia", 1325239200)
  run zoneRow("Asia/Kathmandu", -1000000000)
  run zoneRow("EST5EDT", 1795109782)
  run zoneRow("UTC", 1795109782)
  run zoneRow("+05:30", 1795109782)
  run zoneRow("Mars/Olympus", 0)
  run zoneRow("Europe/Ro me", 0)
  return ()
}

effect fn listing() -> () ! ZoneLookupError | OutOfMemoryError | WriterError ? &mut TimeZones | &mut Allocator | &mut Writer {
  let version = run TimeZones.version()
  let names = run TimeZones.names()
  let all = List<Bytes>.asSlice(&names)
  let mut sorted = true
  let mut index: usize = 1
  while index < all.length {
    if !before(Bytes.asSlice(&all[index - 1]), Bytes.asSlice(&all[index])) {
      sorted = false
    }
    index = index + 1
  }
  run Format.format("release {} names {} sorted {}\n", &(unsafe String.fromUtf8Unchecked(Bytes.asSlice(&version)), all.length, sorted))
  if all.length > 0 {
    run Format.format("first {} last {}\n", &(
      unsafe String.fromUtf8Unchecked(Bytes.asSlice(&all[0])),
      unsafe String.fromUtf8Unchecked(Bytes.asSlice(&all[all.length - 1])),
    ))
  }
  return ()
}

fn before(left: &[u8], right: &[u8]) -> bool {
  let mut index = usize.ZERO
  while index < left.length && index < right.length {
    if left[index] != right[index] {
      return left[index] < right[index]
    }
    index = index + 1
  }
  return left.length < right.length
}

effect fn windowsRow(zones: &mut BundledTimeZones, name: string) -> ()
  ! ZoneLookupError | OutOfMemoryError | WriterError
  ? &mut Allocator | &mut Writer {
  match move run zones.windowsZone(String.utf8Bytes(name)) {
    Option<Bytes>.Some { value } => {
      run Format.format("windows {} = {}\n", &(name, unsafe String.fromUtf8Unchecked(Bytes.asSlice(&value))))
    }
    Option<Bytes>.None => {
      run Format.format("windows {} = none\n", &.(name))
    }
  }
  return ()
}

// A bundle with the release name `x`, `names` name entries that all name the bytes `Test/Zone`,
// and one data entry of four bytes that are not a TZif file. `dataIndex` is the data entry of
// each name.
effect fn handBundle(names: u8, dataIndex: u8) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut bytes: [u8; 74] = [0; 74]
  let magic = b"SILKTZ1\x00"
  let mut index = usize.ZERO
  while index < magic.length {
    bytes[index] = magic[index]
    index = index + 1
  }
  // Release: offset 60, length 1.
  bytes[11] = 60
  bytes[15] = 1
  // Names: the count, at 40.
  bytes[19] = names
  bytes[23] = 40
  // Data: one entry, at 52.
  bytes[27] = 1
  bytes[31] = 52
  // Windows names: none, at 60.
  bytes[39] = 60
  // The name entry: offset 61, length 9, and the data entry.
  bytes[43] = 61
  bytes[47] = 9
  bytes[51] = dataIndex
  // The data entry: offset 70, length 4.
  bytes[55] = 70
  bytes[59] = 4
  bytes[60] = 120
  let name = b"Test/Zone"
  index = 0
  while index < name.length {
    bytes[61 + index] = name[index]
    index = index + 1
  }
  return run Bytes.copy(&bytes)
}

effect fn bundleRow(label: string, data: &[u8]) -> () ! OutOfMemoryError | WriterError ? &mut Allocator | &mut Writer {
  let made = run Effect.result(ZoneBundle.fromBytes(data))
  match move made {
    Result<ZoneBundle, ZoneLookupError | OutOfMemoryError>.Success { value } => {
      let mut bundle = move value
      run Format.format("bundle {} release {} names {}\n", &(label, unsafe String.fromUtf8Unchecked(bundle.release()), bundle.nameCount()))
      run zoneRow("test/zone", 0) |> Effect.provideMut<TimeZones>(&mut bundle)
      run zoneRow("Europe/Rome", 0) |> Effect.provideMut<TimeZones>(&mut bundle)
      run zoneRow("-03:00", 0) |> Effect.provideMut<TimeZones>(&mut bundle)
    }
    Result<ZoneBundle, ZoneLookupError | OutOfMemoryError>.Failure { error } => match move error {
      ZoneLookupError failure => {
        run Format.format("bundle {} {:?}\n", &(label, failure.reason))
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  return ()
}

effect fn bundles() -> () ! OutOfMemoryError | WriterError ? &mut Allocator | &mut Writer {
  let good = run handBundle(1, 0)
  run bundleRow("hand", Bytes.asSlice(&good))
  let empty = run handBundle(0, 0)
  run bundleRow("no-names", Bytes.asSlice(&empty))
  run bundleRow("empty", b"")
  run bundleRow("magic", b"SILKTZ2\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00")
  let wrongData = run handBundle(1, 1)
  run bundleRow("data-index", Bytes.asSlice(&wrongData))
  let tooMany = run handBundle(200, 0)
  run bundleRow("name-count", Bytes.asSlice(&tooMany))
  let whole = Bytes.asSlice(&good)
  run bundleRow("cut", Slice.view<u8>(whole, 0, 72))
  run bundleRow("header-only", Slice.view<u8>(whole, 0, 39))
  return ()
}

effect fn present() -> ()
  ! ZoneLookupError | NoLocalZoneError | OutOfMemoryError | WriterError
  ? &mut TimeZones | &mut LocalZone | &mut SystemClock | &mut Allocator | &mut Writer {
  let here = run Now.localZone()
  let instant = run Now.instant()
  run Format.format("now {} {} {} {}\n", &(instant.unixSeconds(), run Now.zonedIn(&here), run Now.dateIn(&here), run Now.dateTimeIn(&here)))
  return ()
}

effect fn program() -> i32
  ! ZoneLookupError | NoLocalZoneError | OutOfMemoryError | WriterError
  ? &mut Allocator | &mut Writer {
  let mut bundled = BundledTimeZones.make()
  run zoneRows() |> Effect.provideMut<TimeZones>(&mut bundled)
  run listing() |> Effect.provideMut<TimeZones>(&mut bundled)
  run windowsRow(&mut bundled, "Tokyo Standard Time")
  run windowsRow(&mut bundled, "e. south america standard time")
  run windowsRow(&mut bundled, "W. Europe Standard Time")
  run windowsRow(&mut bundled, "UTC")
  run windowsRow(&mut bundled, "Middle Earth Standard Time")
  run bundles()

  // The system may have zone files or not; these answers are the same either way.
  let mut prefer = PreferSystemTimeZones.make()
  run Writer.writeAll(b"prefer\n")
  run zoneRow("Europe/Rome", 1795109782) |> Effect.provideMut<TimeZones>(&mut prefer)
  run zoneRow("UTC", 0) |> Effect.provideMut<TimeZones>(&mut prefer)
  run zoneRow("Mars/Olympus", 0) |> Effect.provideMut<TimeZones>(&mut prefer)
  run zoneRow("Europe/Ro me", 0) |> Effect.provideMut<TimeZones>(&mut prefer)

  let mut clock = FixedClock {}
  let mut here = run FixedLocalZone.make("Asia/Tokyo")
  run present()
    |> Effect.provideMut<TimeZones>(&mut bundled)
    |> Effect.provideMut<LocalZone>(&mut here)
    |> Effect.provideMut<SystemClock>(&mut clock)
  return 0
}

effect fn failed(error: ZoneLookupError | NoLocalZoneError | OutOfMemoryError | WriterError) -> i32 {
  return 3
}

pub effect fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut out = StdoutWriter.make()
  return run Effect.catchAll(program(), failed)
    |> Effect.provideMut<Writer>(&mut out)
    |> Effect.provideMut<Allocator>(&mut allocator)
}
