// Branch weights, stated facts and the unchecked conversions and shifts built on them compute
// exactly what their checked forms do for inputs in range, at run time and in static evaluation.
import silk.core.hint
import silk.num.f32
import silk.num.f64
import silk.num.i64
import silk.num.u32
import silk.num.u8

const RARE: bool = hint.unlikely(false)
const COMMON: bool = hint.likely(true)

fn halved(value: u32) -> u32 {
  return unsafe u32.shiftRightUnchecked(value, 1)
}

fn bounded(value: u32, shift: u32) -> u32 {
  unsafe { hint.assume(shift < 32) }
  return u32.shiftLeft(value, shift)
}

fn truncated(value: f64) -> u32 {
  return unsafe f64.toU32Unchecked(value)
}

fn signedTruncated(value: f32) -> i64 {
  return unsafe f32.toI64Unchecked(value)
}

fn digit(value: u8) -> u8 {
  if value < 10 {
    return value
  }
  unsafe { hint.unreachable() }
}

pub fn main() -> i32 {
  if RARE || !COMMON {
    return 1
  }
  if halved(10) != 5 || bounded(3, 31) != 2147483648 {
    return 2
  }
  if truncated(7.9) != 7 || truncated(4294967295.5) != 4294967295 || signedTruncated(-3.75) != -3 {
    return 3
  }
  if unsafe i64.shiftRightUnchecked(-8, 2) != -2 || unsafe u8.shiftLeftUnchecked(1, 7) != 128 {
    return 4
  }
  if hint.unlikely(digit(7) != 7) {
    return 5
  }
  return 42
}
