import silk.mem.allocator { OutOfMemoryError }
import silk.mem.allocator { Allocator }
import silk.mem.allocator { SystemAllocator }
import silk.core.effect { Effect }
import silk.num.i32
import silk.collections.hash { Hash }
import silk.collections.hash { HashKey, HashSeed, Word }
import silk.collections.hash_map { HashMap }
import silk.collections.hash_set { HashSet }
import silk.core.option { Option }

effect fn build() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut map = HashMap<Word, i32>.make(Hash.seed(4242))
  let mut key = 0
  while key < 40 {
    let previous = run HashMap<Word, i32>.insert(&mut map, Hash.word(i32.toU64(key)), key * 3)
      |> Effect.provideMut(&mut allocator)
    drop previous
    key = key + 1
  }
  if HashMap<Word, i32>.length(&map) != 40 { return 1 }
  if HashMap<Word, i32>.bucketCount(&map) <= 40 { return 2 }
  let mut probe = 0
  let mut total = 0
  while probe < 40 {
    let found = Option<i32>.unwrapOr(HashMap<Word, i32>.get(&map, Hash.word(i32.toU64(probe))), -1)
    if found != probe * 3 { return 3 }
    total = total + found
    probe = probe + 1
  }
  if total != 2340 { return 4 }
  // Insert and remove churn rebuilds the table at its width instead of doubling it.
  let mut churned = HashMap<Word, i32>.make(Hash.seed(7))
  let mut words = HashSet<Word>.make(Hash.seed(7))
  let mut round = 0
  while round < 5000 {
    let previous = run HashMap<Word, i32>.insert(&mut churned, Hash.word(i32.toU64(round)), round)
      |> Effect.provideMut(&mut allocator)
    drop previous
    let removed = HashMap<Word, i32>.remove(&mut churned, Hash.word(i32.toU64(round)))
    if Option<i32>.unwrapOr(move removed, -1) != round { return 5 }
    let added = run HashSet<Word>.insert(&mut words, Hash.word(i32.toU64(round)))
      |> Effect.provideMut(&mut allocator)
    drop added
    let taken = HashSet<Word>.remove(&mut words, Hash.word(i32.toU64(round)))
    drop taken
    round = round + 1
  }
  if HashMap<Word, i32>.length(&churned) != 0 || HashMap<Word, i32>.bucketCount(&churned) != 8 { return 6 }
  if HashSet<Word>.length(&words) != 0 || HashSet<Word>.bucketCount(&words) != 8 { return 7 }
  return 42
}

effect fn recover(error: OutOfMemoryError) -> i32 { return 99 }

pub fn main() -> i32 { return run Effect.catchAll(build(), recover) }