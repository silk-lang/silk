import silk.core.effect { Effect }
import silk.collections.slice { Slice }
import silk.core.result { Result }
import silk.crypto.digest { Digest }
import silk.crypto.p256 { EcdsaP256, EcdsaP256Sha256, P256, P256Error, P256SignatureError }
import silk.crypto.p384 { EcdsaP384, EcdsaP384Sha384, P384, P384Error, P384SignatureError }
import silk.crypto.sha1 { Sha1 }
import silk.crypto.sha2 { Sha224, Sha256, Sha384, Sha512 }
import silk.crypto.sha3 { Sha3_256 }
import silk.num.u64
import silk.system.random { Random }

struct Counter {
  state: u64,
}

impl Random for Counter {
  effect fn fillBytes(self: &mut Self, output: &mut [u8]) -> () {
    let mut index: usize = 0
    while index < output.length {
      self.state = u64.wrappingAdd(u64.wrappingMultiply(self.state, 6364136223846793005), 1)
      output[index] = u64.toU8(u64.shiftRight(self.state, 56))
      index = index + 1
    }
  }
}

fn equal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut i: usize = 0
  while i < left.length {
    if left[i] != right[i] {
      return false
    }
    i = i + 1
  }
  return true
}

fn p256Key(secret: &[u8]) -> P256 {
  return match P256.fromBytes(secret) {
    Result<P256, P256Error>.Success { value } => move value
    Result<P256, P256Error>.Failure { error: _ } => Intrinsic.trap("key")
  }
}

fn p256Ok(result: Result<(), P256SignatureError>) -> bool {
  return match move result {
    Result<(), P256SignatureError>.Success { value: _ } => true
    Result<(), P256SignatureError>.Failure { error: _ } => false
  }
}

fn p256Fails(result: Result<(), P256SignatureError>, expected: P256SignatureError) -> bool {
  return match move result {
    Result<(), P256SignatureError>.Success { value: _ } => false
    Result<(), P256SignatureError>.Failure { error } => error == expected
  }
}

fn p256SignCase<H: Digest>(
  key: &P256,
  publicKey: &[u8],
  message: &[u8],
  expected: &[u8],
  der: &[u8],
) -> bool {
  let signature = key.sign<H>(message)
  if !equal(&signature, expected) {
    return false
  }
  if !p256Ok(EcdsaP256.verify<H>(publicKey, message, &signature)) {
    return false
  }
  let mut encoded: [u8; 72] = [0; 72]
  let length = EcdsaP256.toDer(&signature, &mut encoded)
  if length != der.length {
    return false
  }
  let mut i: usize = 0
  while i < length {
    if encoded[i] != der[i] {
      return false
    }
    i = i + 1
  }
  let decoded = match EcdsaP256.fromDer(der) {
    Result<[u8; 64], P256SignatureError>.Success { value } => value
    Result<[u8; 64], P256SignatureError>.Failure { error: _ } => {
      return false
    }
  }
  return equal(&decoded, expected)
}

fn p384Key(secret: &[u8]) -> P384 {
  return match P384.fromBytes(secret) {
    Result<P384, P384Error>.Success { value } => move value
    Result<P384, P384Error>.Failure { error: _ } => Intrinsic.trap("key")
  }
}

fn p384Ok(result: Result<(), P384SignatureError>) -> bool {
  return match move result {
    Result<(), P384SignatureError>.Success { value: _ } => true
    Result<(), P384SignatureError>.Failure { error: _ } => false
  }
}

fn p384Fails(result: Result<(), P384SignatureError>, expected: P384SignatureError) -> bool {
  return match move result {
    Result<(), P384SignatureError>.Success { value: _ } => false
    Result<(), P384SignatureError>.Failure { error } => error == expected
  }
}

fn p384SignCase<H: Digest>(
  key: &P384,
  publicKey: &[u8],
  message: &[u8],
  expected: &[u8],
  der: &[u8],
) -> bool {
  let signature = key.sign<H>(message)
  if !equal(&signature, expected) {
    return false
  }
  if !p384Ok(EcdsaP384.verify<H>(publicKey, message, &signature)) {
    return false
  }
  let mut encoded: [u8; 104] = [0; 104]
  let length = EcdsaP384.toDer(&signature, &mut encoded)
  if length != der.length {
    return false
  }
  let mut i: usize = 0
  while i < length {
    if encoded[i] != der[i] {
      return false
    }
    i = i + 1
  }
  let decoded = match EcdsaP384.fromDer(der) {
    Result<[u8; 96], P384SignatureError>.Success { value } => value
    Result<[u8; 96], P384SignatureError>.Failure { error: _ } => {
      return false
    }
  }
  return equal(&decoded, expected)
}

