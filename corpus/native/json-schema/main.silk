import silk.json.schema { Schema, Draft, Options, Resource, SchemaError, SchemaReason }
import silk.json.schema_value { SchemaValue, ValueError }
import silk.json.value { Json, Value }
import silk.json.schema_number { SchemaNumber }
import silk.json.scanner { JsonError }
import silk.toml.scanner { TomlError }
import silk.text.regex { RegexError }
import silk.text.string { String }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }

effect fn accepts(schemaText: string, instanceText: string, draft: Draft) -> bool
  ! JsonError | SchemaError | RegexError | OutOfMemoryError ? &mut Allocator {
  let schema = run Json.parseExact(String.utf8Bytes(schemaText))
  let instance = run Json.parseExact(String.utf8Bytes(instanceText))
  let resources = List<Resource>.make()
  let compiled = run Schema.compile(&schema, "https://example.com/schema", List<Resource>.asSlice(&resources), Schema.options(draft))
  let output = run Schema.validate(&compiled, &instance)
  return output.valid
}

effect fn checks() -> i32
  ! JsonError | TomlError | ValueError | SchemaError | RegexError | OutOfMemoryError ? &mut Allocator {
  // Decimal divisibility and equality must not pass through binary floating-point.
  if !run accepts("""{"multipleOf":0.1}""", "0.3", Draft.Draft202012) { return 1 }
  if run accepts("""{"const":9007199254740993}""", "9007199254740992", Draft.Draft202012) { return 2 }
  if !run accepts("""{"type":"integer","const":123}""", "12300e-2", Draft.Draft6) { return 3 }
  if SchemaNumber.compare("1e999999999999999999999999", "9e999999999999999999999998") != 1 { return 4 }

  // Drafts before 2019-09 ignore siblings of $ref; the later drafts apply them.
  let reference = """{"definitions":{"n":{"type":"integer"}},"$ref":"#/definitions/n","maximum":2}"""
  if !run accepts(reference, "3", Draft.Draft4) { return 5 }
  if !run accepts(reference, "3", Draft.Draft7) { return 6 }
  if run accepts(reference, "3", Draft.Draft201909) { return 7 }

  // Patterns use Unicode scalar properties and capture/backreference semantics.
  let pattern = r"""{"type":"string","pattern":"^(?<word>\\p{L}+)\\s+\\k<word>$"}"""
  if !run accepts(pattern, "\"αβ αβ\"", Draft.Draft202012) { return 20 }
  if run accepts(pattern, "\"αβ α\"", Draft.Draft202012) { return 21 }

  // Successful alternatives contribute evaluated properties; failed alternatives do not.
  let branches = """
    {"anyOf":[{"properties":{"a":{"type":"integer"}},"required":["a"]},
              {"properties":{"b":{"type":"string"}},"required":["b"]}],
     "unevaluatedProperties":false}
    """
  if !run accepts(branches, """{"a":1,"b":"yes"}""", Draft.Draft202012) { return 8 }
  if run accepts(branches, """{"a":1,"b":2}""", Draft.Draft202012) { return 9 }

  // External references use the supplied registry and preserve escaped instance locations.
  let remote = run Json.parseExact(String.utf8Bytes("""{"type":"integer","minimum":1}"""))
  let referencing = run Json.parseExact(String.utf8Bytes("""
    {"properties":{"a/b":{"$ref":"types/count"}}}
    """))
  let remoteUri = run String.copy("https://example.com/types/count")
  let mut registry = List<Resource>.make()
  run List<Resource>.append(&mut registry, Resource {
    uri: String.view(&remoteUri), schema: &remote,
  })
  let linked = run Schema.compile(&referencing, "https://example.com/schema",
    List<Resource>.asSlice(&registry), Schema.options(Draft.Draft202012))
  let zero = run Json.parseExact(String.utf8Bytes("""{"a/b":0}"""))
  let linkedOutput = run Schema.validate(&linked, &zero)
  if linkedOutput.valid { return 15 }
  let errors = List.asSlice(&linkedOutput.errors)
  let mut found = false
  let mut errorIndex: usize = 0
  while errorIndex < errors.length {
    if String.view(&errors[errorIndex].instanceLocation) == "/a~1b" { found = true }
    errorIndex = errorIndex + 1
  }
  if !found { return 16 }

  // Invalid schemas are typed compile errors rather than invalid-instance results.
  let badSchema = run Json.parseExact(String.utf8Bytes("""{"required":"name"}"""))
  let bad = run Effect.result(Schema.compile(&badSchema, "https://example.com/bad",
    List<Resource>.asSlice(&registry), Schema.options(Draft.Draft202012)))
  match move bad {
    Result.Failure { error } => {
      match move error {
        SchemaError problem => {
          if problem.reason != SchemaReason.InvalidSchema { return 17 }
        }
        _ => { return 18 }
      }
    }
    _ => { return 19 }
  }

  // A TOML-authored schema validates both TOML and JSON inputs without a second evaluator.
  let schema = run SchemaValue.parseToml(String.utf8Bytes("""
    "$schema" = "https://json-schema.org/draft/2020-12/schema"
    type = "object"
    required = ["port", "hosts"]
    additionalProperties = false
    [properties.port]
    type = "integer"
    minimum = 1
    maximum = 65535
    [properties.hosts]
    type = "array"
    minItems = 1
    [properties.hosts.items]
    type = "string"
    minLength = 1
    format = "hostname"
    [properties.release]
    type = "string"
    format = "date"
    """))
  let resources = List<Resource>.make()
  let compiled = run Schema.compile(&schema, "https://example.com/config", List<Resource>.asSlice(&resources),
    Options { draft: Draft.Draft202012, assertFormats: true, assertContent: false })
  let toml = run SchemaValue.parseToml(String.utf8Bytes("""
    port = 0x1f90
    hosts = ["localhost"]
    release = 2024-02-29
    """))
  let valid = run Schema.validate(&compiled, &toml)
  if !valid.valid { return 10 }
  let json = run Json.parseExact(String.utf8Bytes("""{"port":8080,"hosts":["localhost"],"release":"2023-02-29"}"""))
  let invalid = run Schema.validate(&compiled, &json)
  if invalid.valid { return 11 }
  let extra = run SchemaValue.parseToml(String.utf8Bytes("""
    port = 8080
    hosts = ["localhost"]
    unexpected = true
    """))
  let rejected = run Schema.validate(&compiled, &extra)
  if rejected.valid { return 12 }
  let punycode = run Json.parseExact(String.utf8Bytes("""{"port":8080,"hosts":["xn--X"]}"""))
  let invalidHost = run Schema.validate(&compiled, &punycode)
  if invalidHost.valid { return 22 }

  // TOML's nonfinite values are conversion errors, not valid JSON Schema numbers.
  let nonfinite = run Effect.result(SchemaValue.parseToml(String.utf8Bytes("value = nan")))
  match move nonfinite {
    Result<Value, TomlError | ValueError | OutOfMemoryError>.Failure { error } => {
      match move error {
        ValueError problem => { drop problem }
        _ => { return 13 }
      }
    }
    _ => { return 14 }
  }
  return 0
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  return 99
}

pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(checks(), failed) |> Effect.provideMut<Allocator>(&mut allocator)
}
