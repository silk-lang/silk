import silk.json.schema { JsonSchema, Draft, Options, CompiledSchema, JsonSchemaError, SchemaReason }
import silk.json.schema_resolver { SchemaResolver, SchemaRegistry, SchemaResolutionError }
import silk.json.schema_value { SchemaValue, ValueError }
import silk.json.value { Json, Value }
import silk.json.schema_number { SchemaNumber }
import silk.json.scanner { JsonError }
import silk.toml.scanner { TomlError }
import silk.text.regex { RegexError }
import silk.text.string { String }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }

effect fn accepts(schemaText: string, instanceText: string, draft: Draft) -> bool
  ! JsonError | JsonSchemaError | SchemaResolutionError | RegexError | OutOfMemoryError ? &mut Allocator {
  let schema = run Json.parseExact(String.utf8Bytes(schemaText))
  let instance = run Json.parseExact(String.utf8Bytes(instanceText))
  let mut registry = SchemaRegistry.make()
  let compiled = run JsonSchema.compile(&schema, "https://example.com/schema", JsonSchema.options(draft))
    |> Effect.provideMut<SchemaResolver>(&mut registry)
  let output = run JsonSchema.validate(&compiled, &instance)
  return output.valid
}

effect fn checks() -> i32
  ! JsonError | TomlError | ValueError | JsonSchemaError | SchemaResolutionError | RegexError | OutOfMemoryError ? &mut Allocator {
  // Decimal divisibility and equality must not pass through binary floating-point.
  if !run accepts("""{"multipleOf":0.1}""", "0.3", Draft.Draft202012) { return 1 }
  if run accepts("""{"const":9007199254740993}""", "9007199254740992", Draft.Draft202012) { return 2 }
  if !run accepts("""{"type":"integer","const":123}""", "12300e-2", Draft.Draft6) { return 3 }
  if SchemaNumber.compare("1e999999999999999999999999", "9e999999999999999999999998") != 1 { return 4 }

  // Drafts before 2019-09 ignore siblings of $ref; the later drafts apply them.
  let reference = """{"definitions":{"n":{"type":"integer"}},"$ref":"#/definitions/n","maximum":2}"""
  if !run accepts(reference, "3", Draft.Draft4) { return 5 }
  if !run accepts(reference, "3", Draft.Draft7) { return 6 }
  if run accepts(reference, "3", Draft.Draft201909) { return 7 }

  // Patterns use Unicode scalar properties and capture/backreference semantics.
  let pattern = r"""{"type":"string","pattern":"^(?<word>\\p{L}+)\\s+\\k<word>$"}"""
  if !run accepts(pattern, "\"αβ αβ\"", Draft.Draft202012) { return 20 }
  if run accepts(pattern, "\"αβ α\"", Draft.Draft202012) { return 21 }

  // Successful alternatives contribute evaluated properties; failed alternatives do not.
  let branches = """
    {"anyOf":[{"properties":{"a":{"type":"integer"}},"required":["a"]},
              {"properties":{"b":{"type":"string"}},"required":["b"]}],
     "unevaluatedProperties":false}
    """
  if !run accepts(branches, """{"a":1,"b":"yes"}""", Draft.Draft202012) { return 8 }
  if run accepts(branches, """{"a":1,"b":2}""", Draft.Draft202012) { return 9 }

  // External references use the supplied registry and preserve escaped instance locations.
  let remote = run Json.parseExact(String.utf8Bytes("""{"type":"integer","minimum":1}"""))
  let referencing = run Json.parseExact(String.utf8Bytes("""
    {"properties":{"a/b":{"$ref":"types/count"}}}
    """))
  let mut registry = SchemaRegistry.make()
  run SchemaRegistry.add(&mut registry, "https://example.com/types/count", move remote)
  let linked = run JsonSchema.compile(&referencing, "https://example.com/schema", JsonSchema.options(Draft.Draft202012))
    |> Effect.provideMut<SchemaResolver>(&mut registry)
  let zero = run Json.parseExact(String.utf8Bytes("""{"a/b":0}"""))
  let linkedOutput = run JsonSchema.validate(&linked, &zero)
  if linkedOutput.valid { return 15 }
  let errors = List.asSlice(&linkedOutput.errors)
  let mut found = false
  let mut errorIndex: usize = 0
  while errorIndex < errors.length {
    if String.view(&errors[errorIndex].instanceLocation) == "/a~1b" { found = true }
    errorIndex = errorIndex + 1
  }
  if !found { return 16 }

  // Invalid schemas are typed compile errors rather than invalid-instance results.
  let badSchema = run Json.parseExact(String.utf8Bytes("""{"required":"name"}"""))
  let bad = run Effect.result(JsonSchema.compile(&badSchema, "https://example.com/bad",
    JsonSchema.options(Draft.Draft202012)) |> Effect.provideMut<SchemaResolver>(&mut registry))
  match move bad {
    Result.Failure { error } => {
      match move error {
        JsonSchemaError problem => {
          if problem.reason != SchemaReason.InvalidSchema { return 17 }
        }
        _ => { return 18 }
      }
    }
    _ => { return 19 }
  }

  // A TOML-authored schema validates both TOML and JSON inputs without a second evaluator.
  let schema = run SchemaValue.parseToml(String.utf8Bytes("""
    "$schema" = "https://json-schema.org/draft/2020-12/schema"
    type = "object"
    required = ["port", "hosts"]
    additionalProperties = false
    [properties.port]
    type = "integer"
    minimum = 1
    maximum = 65535
    [properties.hosts]
    type = "array"
    minItems = 1
    [properties.hosts.items]
    type = "string"
    minLength = 1
    format = "hostname"
    [properties.release]
    type = "string"
    format = "date"
    """))
  let mut empty = SchemaRegistry.make()
  let compiled = run JsonSchema.compile(&schema, "https://example.com/config",
    Options { draft: Draft.Draft202012, assertFormats: true, assertContent: false })
    |> Effect.provideMut<SchemaResolver>(&mut empty)
  let toml = run SchemaValue.parseToml(String.utf8Bytes("""
    port = 0x1f90
    hosts = ["localhost"]
    release = 2024-02-29
    """))
  let valid = run JsonSchema.validate(&compiled, &toml)
  if !valid.valid { return 10 }
  let json = run Json.parseExact(String.utf8Bytes("""{"port":8080,"hosts":["localhost"],"release":"2023-02-29"}"""))
  let invalid = run JsonSchema.validate(&compiled, &json)
  if invalid.valid { return 11 }
  let extra = run SchemaValue.parseToml(String.utf8Bytes("""
    port = 8080
    hosts = ["localhost"]
    unexpected = true
    """))
  let rejected = run JsonSchema.validate(&compiled, &extra)
  if rejected.valid { return 12 }
  let punycode = run Json.parseExact(String.utf8Bytes("""{"port":8080,"hosts":["xn--X"]}"""))
  let invalidHost = run JsonSchema.validate(&compiled, &punycode)
  if invalidHost.valid { return 22 }

  // TOML's nonfinite values are conversion errors, not valid JSON Schema numbers.
  let nonfinite = run Effect.result(SchemaValue.parseToml(String.utf8Bytes("value = nan")))
  match move nonfinite {
    Result<Value, TomlError | ValueError | OutOfMemoryError>.Failure { error } => {
      match move error {
        ValueError problem => { drop problem }
        _ => { return 13 }
      }
    }
    _ => { return 14 }
  }
  let owned = run transitiveDocumentsOutliveProvider()
  if owned != 0 { return owned }
  let mut outer = SchemaRegistry.make()
  run SchemaRegistry.add(&mut outer, "https://example.com/types/leaf.json",
    run Json.parseExact(String.utf8Bytes("""{"type":"integer","minimum":0}""")))
  let replacement = run lexicalResolverReplacement() |> Effect.provideMut<SchemaResolver>(&mut outer)
  if replacement != 0 { return replacement }
  let failures = run resolutionFailureIsNotMissing()
  if failures != 0 { return failures }
  return 0
}

// These documents can be retrieved only once. Repeated references must use the compiler cache,
// while relative references inside the first document must resolve against its retrieval URI.
struct RoutedDocuments {
  entry: List<Value>,
  leaf: List<Value>,
}

impl SchemaResolver for RoutedDocuments {
  effect fn resolve(self: &mut Self, uri: string) -> Option<Value> {
    if uri == "https://example.com/parts/entry.json" { return List<Value>.pop(&mut self.entry) }
    if uri == "https://example.com/types/leaf.json" { return List<Value>.pop(&mut self.leaf) }
    return Option<Value>.none()
  }
}

effect fn routedDocuments() -> RoutedDocuments ! JsonError | OutOfMemoryError ? &mut Allocator {
  let mut entry = List<Value>.make()
  run List<Value>.append(&mut entry, run Json.parseExact(String.utf8Bytes("""
    {"$defs":{"count":{"$ref":"../types/leaf.json"}}}
    """)))
  let mut leaf = List<Value>.make()
  run List<Value>.append(&mut leaf, run Json.parseExact(String.utf8Bytes("""{"type":"integer","minimum":2}""")))
  return RoutedDocuments { entry: move entry, leaf: move leaf }
}

effect fn compileWithTemporaryProvider<'a>(schema: &'a Value) -> CompiledSchema<'a>
  ! JsonError | JsonSchemaError | SchemaResolutionError | RegexError | OutOfMemoryError ? &mut Allocator {
  let mut provider = run routedDocuments()
  return run JsonSchema.compile(schema, "https://example.com/schema", JsonSchema.options(Draft.Draft202012))
    |> Effect.provideMut<SchemaResolver>(&mut provider)
}

effect fn transitiveDocumentsOutliveProvider() -> i32
  ! JsonError | JsonSchemaError | SchemaResolutionError | RegexError | OutOfMemoryError ? &mut Allocator {
  let schema = run Json.parseExact(String.utf8Bytes("""
    {"allOf":[{"$ref":"parts/entry.json#/$defs/count"},
              {"$ref":"parts/entry.json#/$defs/count"},
              {"$ref":"#/$defs/local"}],
     "$defs":{"local":{"maximum":5}}}
    """))
  let compiled = run compileWithTemporaryProvider(&schema)
  // No SchemaResolver is in scope during validation, and the provider has been dropped.
  let three = run Json.parseExact(String.utf8Bytes("3"))
  let accepted = run JsonSchema.validate(&compiled, &three)
  if !accepted.valid { return 30 }
  let one = run Json.parseExact(String.utf8Bytes("1"))
  let below = run JsonSchema.validate(&compiled, &one)
  if below.valid { return 31 }
  let six = run Json.parseExact(String.utf8Bytes("6"))
  let above = run JsonSchema.validate(&compiled, &six)
  if above.valid { return 32 }
  return 0
}

effect fn resolvedValidity(schema: &Value, instance: &Value) -> bool
  ! JsonSchemaError | SchemaResolutionError | RegexError | OutOfMemoryError
  ? &mut Allocator | &mut SchemaResolver {
  let compiled = run JsonSchema.compile(schema, "https://example.com/schema", JsonSchema.options(Draft.Draft202012))
  let output = run JsonSchema.validate(&compiled, instance)
  return output.valid
}

effect fn lexicalResolverReplacement() -> i32
  ! JsonError | JsonSchemaError | SchemaResolutionError | RegexError | OutOfMemoryError
  ? &mut Allocator | &mut SchemaResolver {
  let schema = run Json.parseExact(String.utf8Bytes("""{"$ref":"types/leaf.json"}"""))
  let one = run Json.parseExact(String.utf8Bytes("1"))
  if !run resolvedValidity(&schema, &one) { return 33 }
  let mut replacement = run routedDocuments()
  let inner = run resolvedValidity(&schema, &one) |> Effect.provideMut<SchemaResolver>(&mut replacement)
  if inner { return 34 }
  // The outer provider is restored and can resolve the same document in another compilation.
  if !run resolvedValidity(&schema, &one) { return 35 }
  return 0
}

struct UnavailableDocuments {}

impl SchemaResolver for UnavailableDocuments {
  effect fn resolve(self: &mut Self, uri: string) -> Option<Value>
    ! SchemaResolutionError | OutOfMemoryError ? &mut Allocator {
    fail SchemaResolutionError {
      uri: run String.copy(uri),
      detail: run String.copy("schema store unavailable"),
    }
  }
}

effect fn resolutionFailureIsNotMissing() -> i32
  ! JsonError | OutOfMemoryError ? &mut Allocator {
  let schema = run Json.parseExact(String.utf8Bytes("""{"$ref":"types/leaf.json#/$defs/count"}"""))
  let mut unavailable = UnavailableDocuments {}
  let failed = run Effect.result(JsonSchema.compile(&schema, "https://example.com/schema",
    JsonSchema.options(Draft.Draft202012)) |> Effect.provideMut<SchemaResolver>(&mut unavailable))
  match move failed {
    Result.Failure { error } => match move error {
      SchemaResolutionError problem => {
        if String.view(&problem.uri) != "https://example.com/types/leaf.json" { return 36 }
        if String.view(&problem.detail) != "schema store unavailable" { return 37 }
      }
      _ => { return 38 }
    }
    _ => { return 39 }
  }
  let mut empty = SchemaRegistry.make()
  let missing = run Effect.result(JsonSchema.compile(&schema, "https://example.com/schema",
    JsonSchema.options(Draft.Draft202012)) |> Effect.provideMut<SchemaResolver>(&mut empty))
  match move missing {
    Result.Failure { error } => match move error {
      JsonSchemaError problem => {
        if problem.reason != SchemaReason.UnresolvedReference { return 40 }
      }
      _ => { return 41 }
    }
    _ => { return 42 }
  }
  return 0
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  return 99
}

pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(checks(), failed) |> Effect.provideMut<Allocator>(&mut allocator)
}
