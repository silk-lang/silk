// An interface operation with a static parameter: the static operand selects the witness instance,
// through the interface, method syntax, and a generic bound alike.
struct Spec {
  size: i32,
}

interface Walk {
  fn walk(self: &Self, before: i32, static spec: Spec) -> i32
}

struct Leaf {
  value: i32,
}

impl Walk for Leaf {
  fn walk(self: &Leaf, before: i32, static spec: Spec) -> i32 {
    return (self.value + before) * spec.size
  }
}

struct Pair {
  left: i32,
  right: i32,
}

impl Walk for Pair {
  fn walk(self: &Pair, before: i32, static spec: Spec) -> i32 {
    return self.left + self.right + before + spec.size
  }
}

fn bounded<T: Walk>(item: &T) -> i32 {
  let static spec = Spec {size: 3}
  return item.walk(0, spec)
}

pub fn main() -> i32 {
  let leaf = Leaf {value: 3}
  let pair = Pair {left: 1, right: 2}
  let qualified = Walk.walk(&leaf, 1, Spec {size: 2})
  let method = pair.walk(0, Spec {size: 4})
  let generic = bounded<Leaf>(&leaf) + bounded<Pair>(&pair)
  return qualified + method + generic
}
