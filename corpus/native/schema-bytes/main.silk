// A `Bytes` field in the text formats: Base64 text, written and read by the schema's defaults.
import silk.collections.bytes { Bytes }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.schema.issue { IssueReason, SchemaError, ValueKind }
import silk.schema.json { SchemaJson }
import silk.schema.json_schema {
  JsonSchemaDialect,
  JsonSchemaError,
  JsonSchemaOptions,
  JsonSchemas
}
import silk.schema.schema { Schema, Schemas }
import silk.schema.toml { SchemaToml }
import silk.schema.yaml { SchemaYaml }

struct Capture {
  bytes: [u8; 512],
  length: usize
}

impl Writer for Capture {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> ()
    ! WriterError
    ? &mut Writer {
    if self.length + value.length > 512 {
      fail Writer.failure()
    }
    Slice.copyInto<u8>(&mut self.bytes, self.length, value)
    self.length = self.length + value.length
    return ()
  }

  effect fn flush(self: &mut Self) -> ()
    ! WriterError
    ? &mut Writer {
    return ()
  }
}

impl Capture {
  fn make() -> Capture {
    return Capture { bytes: [0; 512], length: 0 }
  }

  fn written(self: &Self) -> &[u8] {
    return Slice.view<u8>(&self.bytes, 0, self.length)
  }
}

struct Blob {
  pub data: Bytes
}

impl Schema for Blob {}

effect fn rejected(bytes: &[u8], reason: IssueReason) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  return match move run Effect.result(SchemaJson.decode<Blob>(bytes)) {
    Result<Blob, SchemaError | OutOfMemoryError>.Success { .. } => false
    Result<Blob, SchemaError | OutOfMemoryError>.Failure { error } => match move error {
      SchemaError { path, issue, .. } => path.matchesText("data") && issue.reason == reason
      OutOfMemoryError {} => {
        fail OutOfMemoryError {}
      }
    }
  }
}

effect fn checks() -> i32
  ! SchemaError | JsonSchemaError | WriterError | OutOfMemoryError
  ? &mut Allocator {
  // Bytes that are not UTF-8, and whose Base64 needs padding.
  let blob = Blob { data: run Bytes.copy(b"\xff\x00\xfe\x01") }
  let mut json = Capture.make()
  run SchemaJson.encode<Blob>(&blob) |> Effect.provideMut<Writer>(&mut json)
  if json.written() != b"{\"data\":\"/wD+AQ==\"}" {
    return 1
  }
  let fromJson = run SchemaJson.decode<Blob>(json.written())
  if fromJson.data.asSlice() != b"\xff\x00\xfe\x01" {
    return 2
  }
  let empty = run SchemaJson.decode<Blob>(b"{\"data\":\"\"}")
  if empty.data.length() != 0 {
    return 3
  }

  // Text that is not Base64 is a wrong value; a number is a wrong type.
  if !(run rejected(b"{\"data\":\"/wD+AQ\"}", IssueReason.InvalidValue))
    || !(run rejected(b"{\"data\":\"_w==\"}", IssueReason.InvalidValue))
    || !(run rejected(b"{\"data\":7}", IssueReason.InvalidType)) {
    return 4
  }
  let mut toml = Capture.make()
  run SchemaToml.encode<Blob>(&blob) |> Effect.provideMut<Writer>(&mut toml)
  if toml.written() != b"data = \"/wD+AQ==\"\n" {
    return 5
  }
  let fromToml = run SchemaToml.decode<Blob>(toml.written())
  if fromToml.data.asSlice() != b"\xff\x00\xfe\x01" {
    return 6
  }
  let mut yaml = Capture.make()
  run SchemaYaml.encode<Blob>(&blob) |> Effect.provideMut<Writer>(&mut yaml)
  let fromYaml = run SchemaYaml.decode<Blob>(yaml.written())
  if fromYaml.data.asSlice() != b"\xff\x00\xfe\x01" {
    return 7
  }

  // Base64 that reads as a number is still written so that it reads back as text.
  let digits = Blob { data: run Bytes.copy(b"\xd7\x6d\xf8") }
  let mut quoted = Capture.make()
  run SchemaYaml.encode<Blob>(&digits) |> Effect.provideMut<Writer>(&mut quoted)
  let again = run SchemaYaml.decode<Blob>(quoted.written())
  if again.data.asSlice() != b"\xd7\x6d\xf8" {
    return 8
  }

  // The standard dialect says the text is Base64; a strict dialect cannot, so it is not exact.
  let shapes = run Schemas.shape<Blob>()
  let mut standard = Capture.make()
  let exact = run JsonSchemas.write(&shapes, JsonSchemaOptions.of(JsonSchemaDialect.Standard))
    |> Effect.provideMut<Writer>(&mut standard)
  if !exact
    || !contains(
      standard.written(),
      b"\"data\":{\"type\":\"string\",\"contentEncoding\":\"base64\"}",
    ) {
    return 9
  }
  let mut strict = Capture.make()
  let approximate = run JsonSchemas.write(
    &shapes,
    JsonSchemaOptions.of(JsonSchemaDialect.OpenAiStrict),
  )
    |> Effect.provideMut<Writer>(&mut strict)
  if approximate || contains(strict.written(), b"contentEncoding")
    || !contains(strict.written(), b"\"data\":{\"type\":\"string\"}") {
    return 10
  }
  return 0
}

fn contains(text: &[u8], part: &[u8]) -> bool {
  let mut start: usize = 0
  while start + part.length <= text.length {
    if Slice.view<u8>(text, start, part.length) == part {
      return true
    }
    start = start + 1
  }
  return false
}

pub effect fn main() -> i32
  ! SchemaError | JsonSchemaError | WriterError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checks() |> Effect.provideMut<Allocator>(&mut allocator)
}
