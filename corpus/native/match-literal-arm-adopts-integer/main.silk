import silk.num.i64
import silk.num.u8

union Status {
  Open,
  Done { at: i64 },
}

enum Level { Low, High }

// An unsuffixed integer literal arm takes the integer type of the other arms.
fn seconds(status: &Status) -> i64 {
  let at = match &status.* {
    Status.Open => 0
    Status.Done { at } => at
  }
  return at
}

fn weight(level: Level, heavy: u8) -> u8 {
  let value = match level {
    Level.Low => heavy
    Level.High => 200
  }
  return value
}

pub fn main() -> i32 {
  let open = Status.Open
  let done = Status.Done { at: 40 }
  let total = seconds(&open) + seconds(&done)
  return i64.toI32(total) + u8.toI32(weight(Level.Low, 2)) - u8.toI32(weight(Level.High, 1)) + 200
}
