import silk.core.compilation { Compilation, Optimization }

fn level() -> i32 {
  static if Compilation.optimization() == Optimization.None {
    return 1
  }
  static if Compilation.optimization() == Optimization.Speed {
    return 2
  }
  static if Compilation.optimization() == Optimization.Size {
    return 3
  }
  return 0
}

pub fn main() -> i32 {
  if level() > 0 {
    return 0
  }
  return 1
}
