import silk.core.effect { Effect }

// A literal inside a function with a `static` parameter is specialized with each static argument,
// as the function's body is: each call below reads its own `factor`.
effect fn again<'env, A, E, ?R>(mut action: mut Effect<'env; A ! E ? R>) -> A ! E ? R {
  return run action
}

effect fn one() -> i32 {
  return 1
}

effect fn scaled(static factor: i32) -> i32 {
  let got = run again(effect {
    let unit = run one()
    return unit * factor
  })
  return got
}

fn offset(static base: i32, value: i32) -> i32 {
  let add = fn(x: i32) -> i32 { return x + base }
  return add(value)
}

pub fn main() -> i32 {
  let big = run scaled(40)
  let small = run scaled(2)
  if big != 40 || small != 2 { return 1 }
  if offset(100, 1) != 101 || offset(7, 1) != 8 { return 2 }
  return 42
}
