// The silk.color modules: the sRGB transfer function, straight and premultiplied RGBA, and Color
// conversion, gamut mapping, interpolation, adjustment, and contrast. Expected values come from the
// CSS Color 4 sample conversion code and the published examples of CSS Color 4 and 5. A failure
// returns 25 * group + case, with groups numbered from 1 in the order main runs them.
import silk.color.color { Color, ColorSpace, HueInterpolation, Interpolation }
import silk.color.rgba { PremultipliedRgba, Rgba }
import silk.color.srgb
import silk.core.option { Option }
import silk.num.f32
import silk.num.f64

fn near(actual: f64, expected: f64, tolerance: f64) -> bool {
  return f64.abs(actual - expected) <= tolerance
}

fn near3(actual: Color, a: f64, b: f64, c: f64, tolerance: f64) -> bool {
  return near(actual.components[0], a, tolerance) && near(actual.components[1], b, tolerance)
    && near(actual.components[2], c, tolerance)
}

fn checkTransfer() -> i32 {
  if srgb.toLinear(0.0) != 0.0 || srgb.toLinear(1.0) != 1.0
    || !near(srgb.fromLinear(1.0), 1.0, 1.0e-15) {
    return 1
  }
  if !near(srgb.toLinear(0.5), 0.21404114048223255, 1.0e-15) {
    return 2
  }
  if !near(srgb.fromLinear(0.5), 0.7353569830524495, 1.0e-15) {
    return 3
  }

  // The linear segment, and the mirror through zero for out-of-gamut channels.
  if srgb.toLinear(0.02) != 0.02 / 12.92 || srgb.fromLinear(-0.5) != -srgb.fromLinear(0.5) {
    return 4
  }
  let mut value = 0.0
  while value <= 1.0 {
    if !near(srgb.fromLinear(srgb.toLinear(value)), value, 1.0e-15) {
      return 5
    }
    value = value + 0.0625
  }
  if !near(f32.toF64(srgb.toLinearF32(0.5)), 0.21404114048223255, 1.0e-7) {
    return 6
  }
  let decoded = srgb.toLinearRgba(Rgba<f64>.new(0.5, 1.0, 0.0, 0.25))
  if !near(decoded.r, 0.21404114048223255, 1.0e-15) || decoded.g != 1.0 || decoded.a != 0.25 {
    return 7
  }
  let encoded = srgb.fromLinearRgba(decoded)
  if !near(encoded.r, 0.5, 1.0e-15) || encoded.a != 0.25 {
    return 8
  }
  return 0
}

fn checkRgba() -> i32 {
  let red = Rgba<f64>.new(1.0, 0.0, 0.0, 0.5).premultiply()
  if &red != &PremultipliedRgba<f64>.new(0.5, 0.0, 0.0, 0.5) {
    return 1
  }
  let blue = Rgba<f64>.opaque(0.0, 0.0, 1.0).premultiply()
  let over = red.over(blue)
  if &over != &PremultipliedRgba<f64>.new(0.5, 0.0, 0.5, 1.0) {
    return 2
  }
  if &over.unpremultiply() != &Rgba<f64>.new(0.5, 0.0, 0.5, 1.0) {
    return 3
  }

  // A transparent color loses its channels; unpremultiplying it does not divide by zero.
  let clear = Rgba<f64>.new(0.3, 0.6, 0.9, 0.0).premultiply().unpremultiply()
  if &clear != &Rgba<f64>.transparent() {
    return 4
  }

  // Premultiplied interpolation toward transparent keeps the opaque endpoint's hue.
  let half = blue.lerp(PremultipliedRgba<f64>.transparent(), 0.5).unpremultiply()
  if &half != &Rgba<f64>.new(0.0, 0.0, 1.0, 0.5) {
    return 5
  }
  let narrowed = Rgba<f64>.new(0.25, 0.5, 0.75, 1.0).map<f32>(f64.toF32)
  if narrowed.g != 0.5 || narrowed.channels()[2] != 0.75 || narrowed.withAlpha(0.5).a != 0.5 {
    return 6
  }
  if &blue.scale(0.5) != &PremultipliedRgba<f64>.new(0.0, 0.0, 0.5, 0.5) {
    return 7
  }
  return 0
}

fn checkConversion() -> i32 {
  let red = Color.srgb(1.0, 0.0, 0.0, 1.0)

  // Published CSS Color 4 values for sRGB red.
  if !near3(
    red.to(ColorSpace.Oklch),
    0.627955363921431,
    0.257683303805361,
    29.2338802796279,
    1.0e-9,
  ) {
    return 1
  }
  if !near3(red.to(ColorSpace.Lab), 54.2905414046719, 80.8049281704353, 69.8909647686243, 1.0e-9) {
    return 2
  }
  if !near3(red.to(ColorSpace.Lch), 54.2905414046719, 106.837181603215, 40.8576565050116, 1.0e-9) {
    return 3
  }
  if !near3(
    red.to(ColorSpace.DisplayP3),
    0.917487557325166,
    0.200286807740847,
    0.138560591211114,
    1.0e-9,
  ) {
    return 4
  }
  if !near3(
    red.to(ColorSpace.ProphotoRgb),
    0.702248075227668,
    0.275720531024922,
    0.103547664650196,
    1.0e-9,
  ) {
    return 5
  }
  if !near3(
    red.to(ColorSpace.Rec2020),
    0.823464101974503,
    0.328429446017081,
    0.180339328980547,
    1.0e-9,
  ) {
    return 6
  }
  if !near3(red.to(ColorSpace.A98Rgb), 0.858591602295442, 0.0, 0.0, 1.0e-7) {
    return 7
  }
  if !near3(
    red.to(ColorSpace.XyzD65),
    0.41239079926596,
    0.21263900587151,
    0.0193308187155918,
    1.0e-12,
  ) {
    return 8
  }
  if !near3(
    red.to(ColorSpace.XyzD50),
    0.43606574687427,
    0.222493177110565,
    0.0139239214631694,
    1.0e-12,
  ) {
    return 9
  }
  if !near3(
    red.to(ColorSpace.Oklab),
    0.627955363921431,
    0.224863068426274,
    0.125846277330585,
    1.0e-9,
  ) {
    return 10
  }
  let rebecca = Color.fromHex(0x663399).to(ColorSpace.Oklch)
  if !near3(rebecca, 0.4402717960022946, 0.1602959993810878, 303.37298848855636, 1.0e-9) {
    return 11
  }

  // Into sRGB from every other kind of space.
  if !near3(Color.hsl(120.0, 1.0, 0.25, 1.0).to(ColorSpace.Srgb), 0.0, 0.5, 0.0, 1.0e-12) {
    return 12
  }
  if !near3(Color.hwb(60.0, 0.2, 0.3, 1.0).to(ColorSpace.Srgb), 0.7, 0.7, 0.2, 1.0e-12) {
    return 13
  }
  if !near3(Color.hwb(200.0, 0.6, 0.6, 1.0).to(ColorSpace.Srgb), 0.5, 0.5, 0.5, 1.0e-12) {
    return 14
  }
  let fromOklch = Color.oklch(0.7, 0.1, 200.0, 1.0).to(ColorSpace.Srgb)
  if !near3(fromOklch, 0.25183094126627836, 0.6942495946215098, 0.717063688889149, 1.0e-9) {
    return 15
  }
  let fromLab = Color.lab(50.0, 20.0, -30.0, 1.0).to(ColorSpace.Srgb)
  if !near3(fromLab, 0.5211546420044167, 0.42365695312687185, 0.6685103406759236, 1.0e-9) {
    return 16
  }
  let wide = Color.new(ColorSpace.Rec2020, [0.2, 0.5, 0.8], 1.0).to(ColorSpace.Srgb)
  if !near3(wide, -0.37970976115726346, 0.492472644293575, 0.8183574814951434, 1.0e-9) {
    return 17
  }
  let photo = Color.new(ColorSpace.ProphotoRgb, [0.2, 0.5, 0.8], 1.0).to(ColorSpace.Srgb)
  if !near3(photo, -0.5855666415188105, 0.6173252906633965, 0.8719369166034827, 1.0e-9) {
    return 18
  }
  let adobe = Color.new(ColorSpace.A98Rgb, [0.2, 0.5, 0.8], 1.0).to(ColorSpace.Srgb)
  if !near3(adobe, -0.23786653922606427, 0.5039928957642428, 0.8147348592229483, 1.0e-9) {
    return 19
  }
  let hsl = Color.srgb(0.2, 0.5, 0.8, 0.5).to(ColorSpace.Hsl)
  if !near3(hsl, 210.0, 0.6, 0.5, 1.0e-12) || hsl.alpha != 0.5 {
    return 20
  }
  if !near3(Color.srgb(0.2, 0.5, 0.8, 1.0).to(ColorSpace.Hwb), 210.0, 0.2, 0.2, 1.0e-12) {
    return 21
  }
  return 0
}

fn checkRoundTrips() -> i32 {
  let spaces: [ColorSpace; 14] = [
    ColorSpace.Srgb,
    ColorSpace.SrgbLinear,
    ColorSpace.DisplayP3,
    ColorSpace.A98Rgb,
    ColorSpace.ProphotoRgb,
    ColorSpace.Rec2020,
    ColorSpace.XyzD50,
    ColorSpace.XyzD65,
    ColorSpace.Lab,
    ColorSpace.Lch,
    ColorSpace.Oklab,
    ColorSpace.Oklch,
    ColorSpace.Hsl,
    ColorSpace.Hwb,
  ]
  let samples: [Color; 6] = [
    Color.srgb(1.0, 0.0, 0.0, 1.0),
    Color.srgb(0.2, 0.5, 0.8, 1.0),
    Color.srgb(0.9, 0.85, 0.1, 1.0),
    Color.srgb(0.01, 0.02, 0.03, 1.0),
    Color.srgb(0.5, 0.5, 0.5, 1.0),
    Color.srgb(1.0, 1.0, 1.0, 1.0),
  ]
  let mut i: usize = 0
  while i < 14 {
    let mut j: usize = 0
    while j < 6 {
      let back = samples[j].to(spaces[i]).to(ColorSpace.Srgb)
      if !back.approxEquals(samples[j], 1.0e-9) {
        return 1
      }
      j = j + 1
    }
    i = i + 1
  }

  // Polar spaces mark the hue of an achromatic color missing.
  let white = Color.white()
  if !white.to(ColorSpace.Oklch).isMissing(2) || !white.to(ColorSpace.Lch).isMissing(2) {
    return 2
  }
  let gray = Color.srgb(0.5, 0.5, 0.5, 1.0)
  if !gray.to(ColorSpace.Hsl).isMissing(0) || !gray.to(ColorSpace.Hwb).isMissing(0) {
    return 3
  }
  if Color.fromHex(0x3366cc).to(ColorSpace.Oklch).isMissing(2) {
    return 4
  }

  // A missing component reads as zero in conversion; a missing alpha is kept.
  let missing = Color.new(ColorSpace.Oklch, [0.7, 0.1, f64.NAN], f64.NAN).to(ColorSpace.Oklab)
  if !near3(missing, 0.7, 0.1, 0.0, 1.0e-15) || !f64.isNaN(missing.alpha) {
    return 5
  }

  // An out-of-gamut sRGB color with negative HSL saturation flips to the opposite hue.
  let flipped = Color.srgb(-0.2, 0.5, 0.5, 1.0).to(ColorSpace.Hsl)
  if flipped.components[1] < 0.0
    || !flipped.to(ColorSpace.Srgb).approxEquals(Color.srgb(-0.2, 0.5, 0.5, 1.0), 1.0e-12) {
    return 6
  }
  return 0
}

fn checkHex() -> i32 {
  if !near3(Color.fromHex(0x3366cc), 0.2, 0.4, 0.8, 1.0e-15)
    || Color.fromHex(0x3366cc).alpha != 1.0 {
    return 1
  }
  let translucent = Color.fromHexAlpha(0x3366cc80)
  if !near3(translucent, 0.2, 0.4, 0.8, 1.0e-15) || translucent.alpha != 128.0 / 255.0 {
    return 2
  }
  let long = Color.parseHex("#3366CC") |> Option<Color>.unwrapOr(Color.black())
  if !long.approxEquals(Color.fromHex(0x3366cc), 0.0) {
    return 3
  }
  let short = Color.parseHex("f80") |> Option<Color>.unwrapOr(Color.black())
  if !short.approxEquals(Color.fromHex(0xff8800), 0.0) {
    return 4
  }
  let shortAlpha = Color.parseHex("#f808") |> Option<Color>.unwrapOr(Color.black())
  if !shortAlpha.approxEquals(Color.fromHexAlpha(0xff880088), 0.0) {
    return 5
  }
  let longAlpha = Color.parseHex("#3366cc80") |> Option<Color>.unwrapOr(Color.black())
  if !longAlpha.approxEquals(translucent, 0.0) {
    return 6
  }
  if Color.parseHex("#12345").isSome() || Color.parseHex("#ggg").isSome()
    || Color.parseHex("").isSome()
    || Color.parseHex("#").isSome() {
    return 7
  }
  return 0
}

fn checkGamut() -> i32 {
  let green = Color.displayP3(0.0, 1.0, 0.0, 1.0)
  if green.inGamut(ColorSpace.Srgb) || !green.inGamut(ColorSpace.DisplayP3)
    || !green.inGamut(ColorSpace.Oklab) {
    return 1
  }

  // CSS Color 4 gamut mapping keeps Oklch lightness and hue and reduces chroma.
  let mapped = green.toGamut(ColorSpace.Srgb)
  if !near3(mapped, 0.0, 0.9857637107710325, 0.1597424439734386, 1.0e-9) {
    return 2
  }
  let vivid = Color.oklch(0.7, 0.4, 30.0, 1.0).toRgba()
  if !near(vivid.r, 1.0, 1.0e-9) || !near(vivid.g, 0.34513507874832144, 1.0e-9)
    || !near(vivid.b, 0.2645751122517649, 1.0e-9) {
    return 3
  }
  let mint = Color.oklch(0.9, 0.3, 150.0, 1.0).toGamut(ColorSpace.Hsl).to(ColorSpace.Srgb)
  if !near3(mint, 0.2568124126580722, 1.0, 0.5282256015637681, 1.0e-9) {
    return 4
  }

  // Lightness at or beyond the ends maps to white and black.
  let bright = Color.oklch(1.2, 0.3, 150.0, 0.5).toRgba()
  if &bright != &Rgba<f64>.new(1.0, 1.0, 1.0, 0.5) {
    return 5
  }
  let dark = Color.lab(-5.0, 40.0, 0.0, f64.NAN).toRgba()
  if &dark != &Rgba<f64>.new(0.0, 0.0, 0.0, 1.0) {
    return 6
  }

  // An in-gamut color converts exactly.
  let inside = Color.fromHex(0x3366cc).to(ColorSpace.Oklch).toGamut(ColorSpace.Srgb)
  if !inside.approxEquals(Color.fromHex(0x3366cc), 1.0e-9) {
    return 7
  }
  let linear = Color.srgb(0.5, 1.0, 0.0, 1.0).toLinearRgba()
  if !near(linear.r, 0.21404114048223255, 1.0e-12) || !near(linear.g, 1.0, 1.0e-12) {
    return 8
  }
  if Color.lab(150.0, 0.0, 0.0, 1.0).toGamut(ColorSpace.Lab).components[0] != 150.0 {
    return 9
  }
  return 0
}

fn checkMix() -> i32 {
  let red = Color.srgb(1.0, 0.0, 0.0, 1.0)
  let blue = Color.srgb(0.0, 0.0, 1.0, 1.0)
  let purple = red.mix(blue, 0.5, Interpolation.new(ColorSpace.Srgb))
  if !purple.approxEquals(Color.srgb(0.5, 0.0, 0.5, 1.0), 1.0e-15) {
    return 1
  }

  // CSS Color 5: color-mix(in lch, peru 40%, palegoldenrod) is lch(79.7256 40.448 84.771).
  let peru = Color.fromHex(0xcd853f)
  let pale = Color.fromHex(0xeee8aa)
  let mixed = peru.mix(pale, 0.6, Interpolation.new(ColorSpace.Lch))
  if mixed.space != ColorSpace.Lch || !near3(mixed, 79.7256, 40.448, 84.771, 0.01) {
    return 2
  }

  // Interpolation is premultiplied: the translucent endpoint weighs less.
  let weighted = red.mix(blue.withAlpha(0.5), 0.5, Interpolation.new(ColorSpace.Srgb))
  if !weighted.approxEquals(Color.srgb(2.0 / 3.0, 0.0, 1.0 / 3.0, 0.75), 1.0e-15) {
    return 3
  }

  // Hue methods, between hues 30 and 300.
  let warm = Color.oklch(0.6, 0.1, 30.0, 1.0)
  let violet = Color.oklch(0.6, 0.1, 300.0, 1.0)
  let methods: [HueInterpolation; 4] = [
    HueInterpolation.Shorter,
    HueInterpolation.Longer,
    HueInterpolation.Increasing,
    HueInterpolation.Decreasing,
  ]
  let forward: [f64; 4] = [345.0, 165.0, 165.0, 345.0]
  let backward: [f64; 4] = [345.0, 165.0, 345.0, 165.0]
  let mut i: usize = 0
  while i < 4 {
    let method = Interpolation.withHue(ColorSpace.Oklch, methods[i])
    if !near(warm.mix(violet, 0.5, method).components[2], forward[i], 1.0e-9) {
      return 4
    }
    if !near(violet.mix(warm, 0.5, method).components[2], backward[i], 1.0e-9) {
      return 5
    }
    i = i + 1
  }

  // A missing hue (an achromatic color) takes the other color's hue instead of drifting to red.
  let toward = Color.white().mix(Color.fromHex(0x3366cc), 0.5, Interpolation.new(ColorSpace.Oklch))
  let brandHue = Color.fromHex(0x3366cc).to(ColorSpace.Oklch).components[2]
  if !near(toward.components[2], brandHue, 1.0e-9) {
    return 6
  }

  // A missing HSL hue carries into the analogous Oklch hue; both missing stays missing.
  let none = Color.hsl(f64.NAN, 0.0, 0.5, 1.0)
  if !none.mix(Color.white(), 0.5, Interpolation.new(ColorSpace.Oklch)).isMissing(2) {
    return 7
  }
  let missingAlpha = red.withAlpha(f64.NAN).mix(
    blue.withAlpha(0.5),
    0.5,
    Interpolation.new(ColorSpace.Srgb),
  )
  if missingAlpha.alpha != 0.5 {
    return 8
  }

  // Endpoints come back exactly, converted to the interpolation space.
  if !red.mix(blue, 0.0, Interpolation.new(ColorSpace.Oklab)).approxEquals(
    red.to(ColorSpace.Oklab),
    1.0e-15,
  ) {
    return 9
  }
  return 0
}

fn checkAdjust() -> i32 {
  let brand = Color.fromHex(0x3366cc)
  let lighter = brand.lighten(0.08)
  if lighter.space != ColorSpace.Srgb
    || !near3(lighter, 0.2893271450693208, 0.49768061061344254, 0.9069062965389361, 1.0e-9) {
    return 1
  }
  if !lighter.darken(0.08).approxEquals(brand, 1.0e-9) {
    return 2
  }
  let before = brand.to(ColorSpace.Oklch)
  let after = brand.saturate(0.02).to(ColorSpace.Oklch)
  if !near(after.components[1] - before.components[1], 0.02, 1.0e-9)
    || !near(after.components[0], before.components[0], 1.0e-9) {
    return 3
  }
  if brand.desaturate(1.0).to(ColorSpace.Oklch).components[1] > 0.000004 {
    return 4
  }
  if !brand.rotateHue(360.0).approxEquals(brand, 1.0e-9) {
    return 5
  }
  let turned = brand.rotateHue(90.0).to(ColorSpace.Oklch)
  if !near(turned.components[2], before.components[2] + 90.0, 1.0e-9) {
    return 6
  }
  let gray = brand.grayscale()
  if !near(gray.components[0], gray.components[1], 1.0e-9)
    || !near(gray.components[1], gray.components[2], 1.0e-9) {
    return 7
  }
  if !near(gray.to(ColorSpace.Oklch).components[0], before.components[0], 1.0e-9) {
    return 8
  }
  if !brand.invert().approxEquals(Color.srgb(0.8, 0.6, 0.2, 1.0), 1.0e-12) {
    return 9
  }

  // Adjustments keep the original space, alpha, and a lightness inside [0, 1].
  let hsl = Color.hsl(210.0, 0.5, 0.4, 0.3).lighten(2.0)
  if hsl.space != ColorSpace.Hsl || hsl.alpha != 0.3
    || !near(hsl.to(ColorSpace.Oklch).components[0], 1.0, 1.0e-9) {
    return 10
  }
  return 0
}

fn checkContrast() -> i32 {
  if Color.white().relativeLuminance() != 1.0 || Color.black().relativeLuminance() != 0.0 {
    return 1
  }
  if !near(Color.black().contrastRatio(Color.white()), 21.0, 1.0e-12) {
    return 2
  }
  let gray = Color.fromHex(0x777777)
  if !near(Color.white().contrastRatio(gray), 4.478089453577214, 1.0e-9)
    || gray.contrastRatio(Color.white()) != Color.white().contrastRatio(gray) {
    return 3
  }
  if Color.fromHex(0x767676).contrastRatio(Color.white()) < 4.5 {
    return 4
  }
  if !near(Color.white().deltaEOK(Color.black()), 1.0, 1.0e-12)
    || Color.fromHex(0x3366cc).deltaEOK(Color.fromHex(0x3366cc)) != 0.0 {
    return 5
  }

  // approxEquals wraps hues and treats two missing components as equal.
  if !Color.oklch(0.5, 0.1, 359.9, 1.0).approxEquals(Color.oklch(0.5, 0.1, 0.05, 1.0), 0.2) {
    return 6
  }
  let none = Color.oklch(0.5, 0.0, f64.NAN, 1.0)
  if !none.approxEquals(none, 0.0) || none.approxEquals(Color.oklch(0.5, 0.0, 0.0, 1.0), 1.0) {
    return 7
  }
  if Color.white().approxEquals(Color.white().to(ColorSpace.SrgbLinear), 1.0) {
    return 8
  }
  return 0
}

pub fn main() -> i32 {
  let transfer = checkTransfer()
  if transfer != 0 {
    return 25 + transfer
  }
  let rgba = checkRgba()
  if rgba != 0 {
    return 50 + rgba
  }
  let conversion = checkConversion()
  if conversion != 0 {
    return 75 + conversion
  }
  let roundTrips = checkRoundTrips()
  if roundTrips != 0 {
    return 100 + roundTrips
  }
  let hex = checkHex()
  if hex != 0 {
    return 125 + hex
  }
  let gamut = checkGamut()
  if gamut != 0 {
    return 150 + gamut
  }
  let mix = checkMix()
  if mix != 0 {
    return 175 + mix
  }
  let adjust = checkAdjust()
  if adjust != 0 {
    return 200 + adjust
  }
  let contrast = checkContrast()
  if contrast != 0 {
    return 225 + contrast
  }
  return 0
}
