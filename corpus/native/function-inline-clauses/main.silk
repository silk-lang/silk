fn isSmall(value: i64) -> bool with Intrinsic.inline() {
  return value >= -1024 && value < 1024
}

fn tag(value: i64) -> u8 with Intrinsic.inlineAlways() {
  if isSmall(value) { return 1 }
  return slowTag(value)
}

fn slowTag(value: i64) -> u8 with Intrinsic.inlineNever() {
  if value < 0 { return 2 }
  return 3
}

// A recursive function keeps its clause; the optimizer never inlines it into itself.
fn countdown(value: i64) -> i64 with Intrinsic.inlineAlways() {
  if value <= 0 { return 0 }
  return 1 + countdown(value - 1)
}

pub fn main() -> i32 {
  if tag(5) != 1 || tag(-5000) != 2 || tag(5000) != 3 || countdown(10) != 10 {
    return 1
  }
  return 0
}
