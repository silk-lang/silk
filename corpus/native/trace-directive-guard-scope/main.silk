import silk.concurrency.sync { Arc }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.trace { Tracer }
import silk.trace.hook { Guard, enter, cancelled }
import silk.trace.record { Config, Recorder }

effect fn close(guard: Guard) -> () { cancelled(move guard) }

effect fn switchProvider(inner: &Arc<Recorder>) -> () {
  let guard = enter("outer", "internal", "work", "worker.silk", "worker", "1.0.0", &())
  // The new scope inherits the same current span ID and record.
  run close(move guard) |> Effect.provideAmbient<Tracer>(inner)
}

effect fn check() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let outer = run Arc<Recorder>.make(run Recorder.make(Config.make("outer")))
  let inner = run Arc<Recorder>.make(run Recorder.make(Config.make("inner")))
  run switchProvider(&inner) |> Effect.provideAmbient<Tracer>(&outer)
  return 0
}

effect fn failed(error: OutOfMemoryError) -> i32 { return 1 }

pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(check() |> Effect.provideMut<Allocator>(&mut allocator), failed)
}
