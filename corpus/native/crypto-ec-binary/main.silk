import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.crypto.ec { EcError, EcGroup, EcPointFormat, EcPrivateKey, EcPublicKey, EcSignature }
import silk.crypto.ec_key { EcCurve, EcKeyDer, EcKeyError, EcPrivateKeyDer, EcPublicKeyDer }
import silk.num.u8
import silk.num.u64
import silk.system.random { Random }

struct Counter {
  state: u64,
}

impl Random for Counter {
  effect fn fillBytes(self: &mut Self, output: &mut [u8]) -> () {
    let mut index: usize = 0
    while index < output.length {
      self.state = u64.wrappingAdd(u64.wrappingMultiply(self.state, 6364136223846793005), 1)
      output[index] = u64.toU8(u64.shiftRight(self.state, 56))
      index = index + 1
    }
  }
}

fn equal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut i: usize = 0
  while i < left.length {
    if left[i] != right[i] {
      return false
    }
    i = i + 1
  }
  return true
}

fn ok(result: Result<(), EcError>) -> bool {
  return match move result {
    Result<(), EcError>.Success { value: _ } => true
    Result<(), EcError>.Failure { error: _ } => false
  }
}

fn failsWith(result: Result<(), EcError>, expected: EcError) -> bool {
  return match move result {
    Result<(), EcError>.Success { value: _ } => false
    Result<(), EcError>.Failure { error } => error == expected
  }
}

fn writes(key: &EcPublicKey, format: EcPointFormat, expected: &[u8]) -> bool {
  let mut output: [u8; 160] = [0; 160]
  if key.group().encodedLength(format) != expected.length {
    return false
  }
  return match key.write(format, &mut output) {
    Result<usize, EcError>.Success { value } => equal(Slice.view<u8>(&output, 0, value), expected)
    Result<usize, EcError>.Failure { error: _ } => false
  }
}

fn decodesTo(group: &EcGroup, encoded: &[u8], uncompressed: &[u8]) -> bool {
  return match EcPublicKey.fromBytes(group, encoded) {
    Result<EcPublicKey, EcError>.Success { value } => writes(&value, EcPointFormat.Uncompressed, uncompressed)
    Result<EcPublicKey, EcError>.Failure { error: _ } => false
  }
}

fn pointFails(group: &EcGroup, encoded: &[u8]) -> bool {
  return match EcPublicKey.fromBytes(group, encoded) {
    Result<EcPublicKey, EcError>.Success { value: _ } => false
    Result<EcPublicKey, EcError>.Failure { error } => error == EcError.InvalidPoint
  }
}

fn keyFails(group: &EcGroup, secret: &[u8]) -> bool {
  return match EcPrivateKey.fromBytes(group, secret) {
    Result<EcPrivateKey, EcError>.Success { value: _ } => false
    Result<EcPrivateKey, EcError>.Failure { error } => error == EcError.InvalidKey
  }
}

fn publicKey(group: &EcGroup, encoded: &[u8]) -> EcPublicKey {
  return match EcPublicKey.fromBytes(group, encoded) {
    Result<EcPublicKey, EcError>.Success { value } => value
    Result<EcPublicKey, EcError>.Failure { error: _ } => Intrinsic.trap("public key")
  }
}

fn privateKey(group: &EcGroup, secret: &[u8]) -> EcPrivateKey {
  return match EcPrivateKey.fromBytes(group, secret) {
    Result<EcPrivateKey, EcError>.Success { value } => value
    Result<EcPrivateKey, EcError>.Failure { error: _ } => Intrinsic.trap("private key")
  }
}

fn verifiesDer(curve: EcCurve, point: &[u8], digest: &[u8], der: &[u8]) -> bool {
  let group = EcGroup.named(curve)
  let key = publicKey(&group, point)
  let mut raw: [u8; 144] = [0; 144]
  let length = group.signatureLength()
  if !ok(EcSignature.fromDer(der, Slice.viewMut<u8>(&mut raw, 0, length))) {
    return false
  }
  if !ok(key.verifyDigest(digest, Slice.view<u8>(&raw, 0, length))) {
    return false
  }
  let mut back: [u8; 160] = [0; 160]
  if EcSignature.derLength(Slice.view<u8>(&raw, 0, length)) != der.length {
    return false
  }
  return match EcSignature.toDer(Slice.view<u8>(&raw, 0, length), &mut back) {
    Result<usize, EcError>.Success { value } => equal(Slice.view<u8>(&back, 0, value), der)
    Result<usize, EcError>.Failure { error: _ } => false
  }
}

effect fn signCase(key: &EcPrivateKey, digest: &[u8]) -> bool ! EcError ? &mut Random {
  let length = key.group().signatureLength()
  let mut signature: [u8; 144] = [0; 144]
  run key.signDigest(digest, Slice.viewMut<u8>(&mut signature, 0, length))
  let publicKey = key.publicKey()
  if !ok(publicKey.verifyDigest(digest, Slice.view<u8>(&signature, 0, length))) {
    return false
  }
  signature[length - 1] = u8.bitXor(signature[length - 1], 1)
  return failsWith(publicKey.verifyDigest(digest, Slice.view<u8>(&signature, 0, length)), EcError.InvalidSignature)
}

fn signsAndVerifies(key: &EcPrivateKey, digest: &[u8], seed: u64) -> bool {
  let mut random = Counter { state: seed }
  return match run Effect.result(signCase(key, digest)) |> Effect.provideMut<Random>(&mut random) {
    Result<bool, EcError>.Success { value } => value
    Result<bool, EcError>.Failure { error: _ } => false
  }
}

effect fn generatedCase(group: &EcGroup) -> bool ! EcError ? &mut Random {
  let first = run EcPrivateKey.generate(group)
  let second = run EcPrivateKey.generate(group)
  let mut left: [u8; 72] = [0; 72]
  let mut right: [u8; 72] = [0; 72]
  let length = group.fieldLength()
  if !ok(first.agree(&second.publicKey(), Slice.viewMut<u8>(&mut left, 0, length)))
    || !ok(second.agree(&first.publicKey(), Slice.viewMut<u8>(&mut right, 0, length))) {
    return false
  }
  let mut secret: [u8; 72] = [0; 72]
  if !ok(first.writeSecret(Slice.viewMut<u8>(&mut secret, 0, group.secretLength()))) {
    return false
  }
  let again = privateKey(group, Slice.view<u8>(&secret, 0, group.secretLength()))
  let mut point: [u8; 160] = [0; 160]
  let pointLength = match first.publicKey().write(EcPointFormat.Uncompressed, &mut point) {
    Result<usize, EcError>.Success { value } => value
    Result<usize, EcError>.Failure { error } => {
      fail error
    }
  }
  return equal(&left, &right) && writes(&again.publicKey(), EcPointFormat.Uncompressed, Slice.view<u8>(&point, 0, pointLength))
}

fn generates(curve: EcCurve, seed: u64) -> bool {
  let group = EcGroup.named(curve)
  let mut random = Counter { state: seed }
  return match run Effect.result(generatedCase(&group)) |> Effect.provideMut<Random>(&mut random) {
    Result<bool, EcError>.Success { value } => value
    Result<bool, EcError>.Failure { error: _ } => false
  }
}

fn derRoundTrips(curve: EcCurve, secret: &[u8], point: &[u8], pkcs8: &[u8], spki: &[u8], sec1: &[u8]) -> bool {
  let mut output: [u8; 512] = [0; 512]
  let readKey = match EcKeyDer.readPkcs8(pkcs8) {
    Result<EcPrivateKeyDer, EcKeyError>.Success { value } => value.curve == curve && equal(value.secret, secret)
    Result<EcPrivateKeyDer, EcKeyError>.Failure { error: _ } => false
  }
  if !readKey {
    return false
  }
  let wrote = match EcKeyDer.writePkcs8(curve, secret, point, &mut output) {
    Result<usize, EcKeyError>.Success { value } => equal(Slice.view<u8>(&output, 0, value), pkcs8)
    Result<usize, EcKeyError>.Failure { error: _ } => false
  }
  if !wrote {
    return false
  }
  let readPublic = match EcKeyDer.readSpki(spki) {
    Result<EcPublicKeyDer, EcKeyError>.Success { value } => value.curve == curve && equal(value.publicKey, point)
    Result<EcPublicKeyDer, EcKeyError>.Failure { error: _ } => false
  }
  if !readPublic {
    return false
  }
  let wrotePublic = match EcKeyDer.writeSpki(curve, point, &mut output) {
    Result<usize, EcKeyError>.Success { value } => equal(Slice.view<u8>(&output, 0, value), spki)
    Result<usize, EcKeyError>.Failure { error: _ } => false
  }
  if !wrotePublic {
    return false
  }
  if sec1.length == 0 {
    return true
  }
  let readSec1 = match EcKeyDer.readSec1(sec1) {
    Result<EcPrivateKeyDer, EcKeyError>.Success { value } => value.curve == curve && equal(value.secret, secret)
    Result<EcPrivateKeyDer, EcKeyError>.Failure { error: _ } => false
  }
  if !readSec1 {
    return false
  }
  return match EcKeyDer.writeSec1(curve, secret, point, &mut output) {
    Result<usize, EcKeyError>.Success { value } => equal(Slice.view<u8>(&output, 0, value), sec1)
    Result<usize, EcKeyError>.Failure { error: _ } => false
  }
}

effect fn unsupportedSign(key: &EcPrivateKey, digest: &[u8]) -> bool ! EcError ? &mut Random {
  let mut signature: [u8; 144] = [0; 144]
  run key.signDigest(digest, Slice.viewMut<u8>(&mut signature, 0, key.group().signatureLength()))
  return false
}

fn unsupportedDer(result: Result<usize, EcKeyError>) -> bool {
  return match move result {
    Result<usize, EcKeyError>.Success { value: _ } => false
    Result<usize, EcKeyError>.Failure { error } => error == EcKeyError.UnsupportedCurve
  }
}

// The checks of a curve without ECDSA or an object identifier.
fn keyAgreementOnly(key: &EcPrivateKey, digest: &[u8], secret: &[u8], point: &[u8]) -> i32 {
  let mut random = Counter { state: 3 }
  let signed = match run Effect.result(unsupportedSign(key, digest)) |> Effect.provideMut<Random>(&mut random) {
    Result<bool, EcError>.Success { value } => value
    Result<bool, EcError>.Failure { error } => error == EcError.UnsupportedCurve
  }
  let raw: [u8; 144] = [1; 144]
  if !signed || !failsWith(key.publicKey().verifyDigest(digest, Slice.view<u8>(&raw, 0, key.group().signatureLength())), EcError.UnsupportedCurve) {
    return 8
  }
  let curve = key.group().curve()
  let mut output: [u8; 512] = [0; 512]
  if curve.objectIdentifier().length != 0 || !unsupportedDer(EcKeyDer.writeSec1(curve, secret, point, &mut output))
    || !unsupportedDer(EcKeyDer.writePkcs8(curve, secret, point, &mut output))
    || !unsupportedDer(EcKeyDer.writeSpki(curve, point, &mut output)) {
    return 9
  }
  return 0
}

fn curveCase(
  curve: EcCurve,
  secret: &[u8],
  point: &[u8],
  compressed: &[u8],
  hybrid: &[u8],
  peer: &[u8],
  shared: &[u8],
  digest: &[u8],
  signature: &[u8],
  pkcs8: &[u8],
  spki: &[u8],
  sec1: &[u8],
  seed: u64,
) -> i32 {
  let group = EcGroup.named(curve)
  if group.curve() != curve || group.secretLength() != curve.secretLength() || group.fieldLength() != curve.fieldLength() {
    return 1
  }
  match EcCurve.fromName(curve.name()) {
    Option<EcCurve>.Some { value } => {
      if value != curve {
        return 1
      }
    }
    Option<EcCurve>.None => {
      return 1
    }
  }
  let key = privateKey(&group, secret)
  let own = key.publicKey()
  if !writes(&own, EcPointFormat.Uncompressed, point) || !writes(&own, EcPointFormat.Compressed, compressed)
    || !writes(&own, EcPointFormat.Hybrid, hybrid) {
    return 2
  }
  if !decodesTo(&group, compressed, point) || !decodesTo(&group, hybrid, point) || !decodesTo(&group, point, point) {
    return 3
  }
  let mut agreed: [u8; 72] = [0; 72]
  if !ok(key.agree(&publicKey(&group, peer), Slice.viewMut<u8>(&mut agreed, 0, shared.length)))
    || !equal(Slice.view<u8>(&agreed, 0, shared.length), shared) {
    return 4
  }
  if signature.length == 0 {
    return keyAgreementOnly(&key, digest, secret, point)
  }
  if !verifiesDer(curve, point, digest, signature) {
    return 5
  }
  if !signsAndVerifies(&key, digest, seed) {
    return 6
  }
  if !derRoundTrips(curve, secret, point, pkcs8, spki, sec1) {
    return 7
  }
  return 0
}

pub fn main() -> i32 {
  if curveCase(EcCurve.Sect113r1, b"\x00\x1a\xa9\xb6\x80\x52\xba\xd9\x26\x28\x25\xd6\xa9\x33\x20", b"\x04\x00\x05\x22\xcc\xd0\x47\x39\x18\x69\x17\x93\xd9\xc3\x11\xc5\x00\xcb\x81\xea\x13\x67\x29\xe9\x3c\x5f\x49\xd8\x80\xb9\x93", b"\x03\x00\x05\x22\xcc\xd0\x47\x39\x18\x69\x17\x93\xd9\xc3\x11\xc5", b"\x07\x00\x05\x22\xcc\xd0\x47\x39\x18\x69\x17\x93\xd9\xc3\x11\xc5\x00\xcb\x81\xea\x13\x67\x29\xe9\x3c\x5f\x49\xd8\x80\xb9\x93", b"\x04\x00\x68\x40\xc2\xdd\x30\x4d\x39\xa8\x5e\x8c\xa0\x69\xb0\x9f\x00\x52\x49\xf8\x46\xbd\x92\xbb\xce\x84\xa6\xe1\x73\x4a\x66", b"\x01\x1b\x48\x04\xde\xe9\xd7\xda\x8b\x62\x11\x0a\x3c\xea\xe7", b"\xaa\xf2\x08\xde\xe6\x2c\x13\x55\xac\x4f\x58\xbe\x77\x3e\xf6\xec\x64\x38\x87\x8a\x83\xc9\x29\xbc\xa1\xa9\xfb\x27\x31\x59\xee\xe8", b"\x30\x21\x02\x0e\x27\xa2\x81\xb5\xdc\x62\xe0\xf1\x23\x55\xb2\xe4\x38\x0f\x02\x0f\x00\x9d\xe4\x6b\x74\xe7\x2e\x29\x52\xbd\xf3\x38\x86\x57\x22", b"\x30\x51\x02\x01\x00\x30\x10\x06\x07\x2a\x86\x48\xce\x3d\x02\x01\x06\x05\x2b\x81\x04\x00\x04\x04\x3a\x30\x38\x02\x01\x01\x04\x0f\x00\x1a\xa9\xb6\x80\x52\xba\xd9\x26\x28\x25\xd6\xa9\x33\x20\xa1\x22\x03\x20\x00\x04\x00\x05\x22\xcc\xd0\x47\x39\x18\x69\x17\x93\xd9\xc3\x11\xc5\x00\xcb\x81\xea\x13\x67\x29\xe9\x3c\x5f\x49\xd8\x80\xb9\x93", b"\x30\x34\x30\x10\x06\x07\x2a\x86\x48\xce\x3d\x02\x01\x06\x05\x2b\x81\x04\x00\x04\x03\x20\x00\x04\x00\x05\x22\xcc\xd0\x47\x39\x18\x69\x17\x93\xd9\xc3\x11\xc5\x00\xcb\x81\xea\x13\x67\x29\xe9\x3c\x5f\x49\xd8\x80\xb9\x93", b"\x30\x41\x02\x01\x01\x04\x0f\x00\x1a\xa9\xb6\x80\x52\xba\xd9\x26\x28\x25\xd6\xa9\x33\x20\xa0\x07\x06\x05\x2b\x81\x04\x00\x04\xa1\x22\x03\x20\x00\x04\x00\x05\x22\xcc\xd0\x47\x39\x18\x69\x17\x93\xd9\xc3\x11\xc5\x00\xcb\x81\xea\x13\x67\x29\xe9\x3c\x5f\x49\xd8\x80\xb9\x93", 1) != 0 {
    return 100
  }
  if curveCase(EcCurve.Sect113r2, b"\x00\x13\x9e\xc7\xe9\x44\xc0\x24\x8c\xc3\x84\x4b\x77\xab\x3d", b"\x04\x01\x80\x2a\xa8\x2b\xe9\xa1\xe6\x81\x7c\xf1\xde\xc2\x2b\xb5\x00\xf3\x51\x13\x25\xfb\xf3\x10\xfc\xca\x11\xad\x29\x3d\xee", b"\x02\x01\x80\x2a\xa8\x2b\xe9\xa1\xe6\x81\x7c\xf1\xde\xc2\x2b\xb5", b"\x06\x01\x80\x2a\xa8\x2b\xe9\xa1\xe6\x81\x7c\xf1\xde\xc2\x2b\xb5\x00\xf3\x51\x13\x25\xfb\xf3\x10\xfc\xca\x11\xad\x29\x3d\xee", b"\x04\x00\xb9\x55\x0f\x16\x14\x1b\x06\x83\x8f\x6e\xe8\xd8\xfc\x97\x00\x82\xd1\x58\x60\x00\xd9\x68\x95\xff\x09\xd4\x80\xf7\xf6", b"\x00\x7f\x00\x7f\x46\xd0\x08\x61\x3a\x40\xb5\xb2\x33\x24\x05", b"\xa9\x62\x3f\xe5\x0d\x31\x73\xb3\xd3\xab\xc0\xfa\xb4\x1a\x06\xc7\x19\xf1\x76\xce\xae\x3b\x99\x19\x80\x66\xdd\xb8\xb7\xc4\x0d\x80", b"\x30\x22\x02\x0f\x00\x8b\xd1\xa3\xdc\x67\x92\xeb\x1c\x4c\x28\xb8\x08\xf1\x96\x02\x0f\x00\xc8\x0e\xce\x1f\xdd\xb4\xe8\xa0\xfb\x6a\x28\x53\xba\xf5", b"\x30\x51\x02\x01\x00\x30\x10\x06\x07\x2a\x86\x48\xce\x3d\x02\x01\x06\x05\x2b\x81\x04\x00\x05\x04\x3a\x30\x38\x02\x01\x01\x04\x0f\x00\x13\x9e\xc7\xe9\x44\xc0\x24\x8c\xc3\x84\x4b\x77\xab\x3d\xa1\x22\x03\x20\x00\x04\x01\x80\x2a\xa8\x2b\xe9\xa1\xe6\x81\x7c\xf1\xde\xc2\x2b\xb5\x00\xf3\x51\x13\x25\xfb\xf3\x10\xfc\xca\x11\xad\x29\x3d\xee", b"\x30\x34\x30\x10\x06\x07\x2a\x86\x48\xce\x3d\x02\x01\x06\x05\x2b\x81\x04\x00\x05\x03\x20\x00\x04\x01\x80\x2a\xa8\x2b\xe9\xa1\xe6\x81\x7c\xf1\xde\xc2\x2b\xb5\x00\xf3\x51\x13\x25\xfb\xf3\x10\xfc\xca\x11\xad\x29\x3d\xee", b"\x30\x41\x02\x01\x01\x04\x0f\x00\x13\x9e\xc7\xe9\x44\xc0\x24\x8c\xc3\x84\x4b\x77\xab\x3d\xa0\x07\x06\x05\x2b\x81\x04\x00\x05\xa1\x22\x03\x20\x00\x04\x01\x80\x2a\xa8\x2b\xe9\xa1\xe6\x81\x7c\xf1\xde\xc2\x2b\xb5\x00\xf3\x51\x13\x25\xfb\xf3\x10\xfc\xca\x11\xad\x29\x3d\xee", 2) != 0 {
