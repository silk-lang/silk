import silk.core.effect { Effect }

pub enum Problem {
  TooSmall,
}

pub service Source {
  effect fn next() -> i32 ? &Source
}

pub struct Fixed {
  value: i32,
}

impl Source for Fixed {
  effect fn next(self: &Self) -> i32
    ? &Source {
    return self.value
  }
}

effect fn start(value: i32) -> i32 {
  return value
}

effect fn checked(value: i32) -> i32
  ! Problem {
  if value < 10 {
    fail Problem.TooSmall
  }
  return value
}

effect fn plus(value: i32) -> i32
  ? &Source {
  let n = run Source.next()
  return value + n
}

// An ordinary function returns an Effect when called; it does not construct one.
fn next(value: i32) -> Effect<i32> {
  return start(value + 1)
}

effect fn apply<'env, B>(f: once fn<'env>(i32) -> once Effect<'env; B>) -> B {
  return run f(20)
}

// A lambda whose body returns an Effect continues as one written with `effect` and `run`.
effect fn lambda() -> i32
  ! Problem
  ? &Source {
  let a = run start(1) |> Effect.flatMap(|x| checked(x + 10))
  return run start(a) |> Effect.flatMap(|x| plus(x))
}

effect fn named() -> i32 {
  return run start(20) |> Effect.flatMap(next)
}

effect fn literal() -> i32 {
  let f = fn(x: i32) -> Effect<i32> { return start(x + 2) }
  return run f(19)
}

effect fn recovered(problem: Problem) -> i32 {
  return 100
}

pub fn main() -> i32 {
  let source = Fixed { value: 10 }
  let first = run Effect.catchAll(lambda() |> Effect.provide(&source), recovered)
  let second = run named()
  let third = run apply(next)
  let fourth = run literal()
  if first != 21 {
    return 1
  }
  if second != 21 {
    return 2
  }
  if third != 21 {
    return 3
  }
  if fourth != 21 {
    return 4
  }
  return first + second
}
