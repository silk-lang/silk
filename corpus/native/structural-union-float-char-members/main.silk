import silk.num.f32
import silk.num.f64
fn wideNan() -> f64 | bool { return f64.fromBits(9221120237041090851) }
fn smallNan() -> f32 | char { return f32.fromBits(2143289635) }
fn wideZero() -> f64 | i32 { return f64.fromBits(9223372036854775808) }
fn smallZero() -> f32 | u8 { return f32.fromBits(2147483648) }
fn wideNanBits(value: f64 | bool) -> u64 { return match value { f64 real => f64.toBits(real) bool _ => 0 } }
fn smallNanBits(value: f32 | char) -> u32 { return match value { f32 real => f32.toBits(real) char _ => 0 } }
fn wideZeroBits(value: f64 | i32) -> u64 { return match value { f64 real => f64.toBits(real) i32 _ => 0 } }
fn smallZeroBits(value: f32 | u8) -> u32 { return match value { f32 real => f32.toBits(real) u8 _ => 0 } }
fn pair(flag: bool) -> [f64; 2] | i32 {
  if flag { return [0.25, f64.fromBits(9223372036854775808)] }
  return 7
}
fn pairScore(value: [f64; 2] | i32) -> i32 {
  return match move value {
    [f64; 2] values => {
      if values[0] == 0.25 && f64.toBits(values[1]) == 9223372036854775808 { return 1 }
      return 100
    }
    i32 n => n
  }
}
fn narrow(k: i32) -> i32 | char {
  if k == 0 { return 'z' }
  return k
}
fn widen(value: i32 | char) -> i32 | char | f64 { return value }
fn wideScore(value: i32 | char | f64) -> i32 {
  return match value {
    i32 n => n
    char c => { if c == 'z' { return 10 } return 200 }
    f64 _ => 300
  }
}
fn relayInner(value: f64 | char) -> f64 | char { return value }
fn relayOuter(value: f64 | char) -> f64 | char { return relayInner(value) }
fn relayedBits(value: f64 | char) -> u64 { return match value { f64 real => f64.toBits(real) char _ => 0 } }
fn relayedLetter(value: f64 | char) -> i32 { return match value { f64 _ => 0 char c => { if c == 'k' { return 1 } return 2 } } }
fn slotBits(value: f64 | f32) -> u32 { return match value { f64 _ => 0 f32 small => f32.toBits(small) } }
pub fn main() -> i32 {
  if wideNanBits(wideNan()) != 9221120237041090851 { return 1 }
  if smallNanBits(smallNan()) != 2143289635 { return 2 }
  if wideZeroBits(wideZero()) != 9223372036854775808 { return 3 }
  if smallZeroBits(smallZero()) != 2147483648 { return 4 }
  if pairScore(pair(true)) != 1 { return 5 }
  if pairScore(pair(false)) != 7 { return 6 }
  if wideScore(widen(narrow(0))) != 10 { return 7 }
  if wideScore(widen(narrow(5))) != 5 { return 8 }
  if relayedBits(relayOuter(f64.fromBits(9221120237041090851))) != 9221120237041090851 { return 9 }
  let letter: f64 | char = 'k'
  if relayedLetter(relayOuter(letter)) != 1 { return 10 }
  let mut slot: f64 | f32 = f64.fromBits(18446744073709551615)
  slot = f32.fromBits(1078530011)
  if slotBits(slot) != 1078530011 { return 11 }
  return 42
}