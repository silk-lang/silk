//! A static function reads the `///` comments of a struct's fields.

import silk.core.reflect { Reflect }
import silk.core.static_text { StaticText }
import silk.text.string { String }

struct Flags {
  /// Say more.
  pub verbose: bool,
  /// How many times.
  /// At least one.
  pub times: u32,
  // An ordinary comment is not documentation.
  pub quiet: bool,
}

static fn docs() -> string<'static> {
  let mut all = ""
  static for field in Reflect.fields<Flags>() {
    all = StaticText.concat(StaticText.concat(all, Reflect.fieldDoc(field)), "|")
  }
  return all
}

pub fn main() -> i32 {
  static if docs() != "Say more.|How many times.\nAt least one.||" { compileError("field documentation") }
  if String.byteLength(docs()) == 41 { return 41 }
  return 1
}
