import silk.core.effect {Effect}

struct Empty {}
struct Missing {}
struct Payload { value: i32 }
struct Failure { value: i32 }

effect fn empty(depth: i32) -> Empty ! Missing {
  if depth < 0 { return Empty {} }
  if depth == 0 { fail Missing {} }
  return run empty(depth - 1)
}
effect fn scalar(failNow: bool) -> i32 ! Missing {
  if failNow { fail Missing {} }
  return 9
}
effect fn payload(failNow: bool) -> Payload ! Missing {
  if failNow { fail Missing {} }
  return Payload { value: 11 }
}
effect fn failedPayload(failNow: bool) -> Empty ! Failure {
  if failNow { fail Failure { value: 13 } }
  return Empty {}
}
effect fn recoverEmpty(error: Missing) -> Empty { drop error return Empty {} }
effect fn recoverScalar(error: Missing) -> i32 { drop error return 3 }
effect fn recoverPayload(error: Missing) -> Payload { drop error return Payload { value: 5 } }
effect fn recoverFailure(error: Failure) -> Empty {
  if error.value != 13 { Intrinsic.trap("nonempty failure payload changed") }
  return Empty {}
}
effect fn suspended() -> () {
  let value = run Intrinsic.suspendEffect(effect {
    return run Effect.catchAll(empty(2), recoverEmpty)
  })
  drop value
  return ()
}
pub fn main() -> i32 {
  drop run Effect.catchAll(empty(-1), recoverEmpty)
  drop run Effect.catchAll(empty(3), recoverEmpty)
  drop run Effect.catchAll(failedPayload(false), recoverFailure)
  drop run Effect.catchAll(failedPayload(true), recoverFailure)
  run suspended()
  let first = run Effect.catchAll(scalar(false), recoverScalar)
  let second = run Effect.catchAll(scalar(true), recoverScalar)
  let third = run Effect.catchAll(payload(false), recoverPayload)
  let fourth = run Effect.catchAll(payload(true), recoverPayload)
  return first + second + third.value + fourth.value + 14
}
