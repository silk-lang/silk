import silk.core.result { Result }
import silk.crypto.curve448 { X448, X448Error }

fn equal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut i: usize = 0
  while i < left.length {
    if left[i] != right[i] {
      return false
    }
    i = i + 1
  }
  return true
}

fn key(secret: &[u8]) -> X448 {
  return match X448.fromSecret(secret) {
    Result<X448, X448Error>.Success { value } => move value
    Result<X448, X448Error>.Failure { error: _ } => {
      Intrinsic.trap("bad secret")
    }
  }
}

fn agreed(result: Result<[u8; 56], X448Error>, expected: &[u8]) -> bool {
  return match move result {
    Result<[u8; 56], X448Error>.Success { value } => equal(&value, expected)
    Result<[u8; 56], X448Error>.Failure { error: _ } => false
  }
}

// A key from another program: its public key, and the secret it agrees on with a peer.
fn case(secret: &[u8], publicKey: &[u8], peer: &[u8], shared: &[u8]) -> i32 {
  let pair = key(secret)
  if !equal(&pair.publicKey(), publicKey) || !equal(&pair.secret(), secret) {
    return 1
  }
  if !agreed(pair.agreeWith(peer), shared) {
    return 1
  }
  if !agreed(pair.agree(peer), shared) {
    return 1
  }
  return 0
}

// Wycheproof x448_test.json: kind 0 agrees on `shared`, 1 gives an all-zero secret, 2 has a peer
// key of the wrong length.
fn wycheproof(id: i32, secret: &[u8], peer: &[u8], shared: &[u8], kind: i32) -> i32 {
  let result = key(secret).agree(peer)
  let passed = match move result {
    Result<[u8; 56], X448Error>.Success { value } => kind == 0 && equal(&value, shared)
    Result<[u8; 56], X448Error>.Failure { error: X448Error.AllZeroSharedSecret } => kind == 1
    Result<[u8; 56], X448Error>.Failure { error: X448Error.InvalidPeerLength } => kind == 2
    Result<[u8; 56], X448Error>.Failure { error: _ } => false
  }
  if passed {
    return 0
  }
  return 1
}

// RFC 7748 section 5.2: k = u = 5, then k, u = X448(k, u), k.
fn iterated(rounds: i32, expected: &[u8]) -> i32 {
  let mut k: [u8; 56] = [0; 56]
  let mut u: [u8; 56] = [0; 56]
  k[0] = 5
  u[0] = 5
  let mut round: i32 = 0
  while round < rounds {
    let next = match key(&k).agree(&u) {
      Result<[u8; 56], X448Error>.Success { value } => value
      Result<[u8; 56], X448Error>.Failure { error: _ } => {
        return 1
      }
    }
    u = k
    k = next
    round = round + 1
  }
  if equal(&k, expected) {
    return 0
  }
  return 1
}

