// Three locals rotate their values on every iteration, so each new value is another local's old
// one: when the locals live in registers, every assignment must read the values before any of
// them is overwritten.
fn rotations(count: i32) -> i32 {
  let mut a: i32 = 1
  let mut b: i32 = 2
  let mut c: i32 = 3
  let mut step: i32 = 0
  while step < count {
    let held = a
    a = b
    b = c
    c = held
    step = step + 1
  }
  return a * 100 + b * 10 + c
}

// Two locals swap, and one accumulates the old value of the other.
fn swaps(count: i32) -> i32 {
  let mut x: i32 = 5
  let mut y: i32 = 7
  let mut total: i32 = 0
  let mut step: i32 = 0
  while step < count {
    total = total + x
    let held = x
    x = y
    y = held
    step = step + 1
  }
  return total * 100 + x * 10 + y
}

pub fn main() -> i32 {
  if rotations(0) != 123 { return 1 }
  if rotations(1) != 231 { return 2 }
  if rotations(2) != 312 { return 3 }
  if rotations(7) != 231 { return 4 }
  if swaps(1) != 575 { return 5 }
  if swaps(4) != 2457 { return 6 }
  return 42
}
