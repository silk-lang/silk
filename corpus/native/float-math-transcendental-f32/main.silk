import silk.num.f32

fn notANumber(zero: f32) -> f32 { return zero / zero }

pub fn main() -> i32 {
  let missing = notANumber(0.0)
  // Signed zero passes through, NaN and infinity give the canonical NaN, and the largest arguments
  // reduce exactly.
  if f32.toBits(f32.tan(-0.0)) != 2147483648 { return 100 }
  if f32.toBits(f32.tan(f32.INFINITY)) != 2143289344 { return 101 }
  if f32.toBits(f32.tan(1.0)) != 1070029091 { return 102 }
  if f32.toBits(f32.tan(f32.fromBits(2139095039))) != 3206323914 { return 103 }
  if f32.toBits(f32.tan(1e30)) != 1067815995 { return 104 }
  // Infinity gives pi/2 and a signed zero passes through.
  if f32.toBits(f32.atan(f32.INFINITY)) != 1070141403 { return 105 }
  if f32.toBits(f32.atan(-1.0)) != 3209236443 { return 106 }
  // The signs of both operands select the quadrant, signed zeros included.
  if f32.toBits(f32.atan2(-0.0, -1.0)) != 3226013659 { return 107 }
  if f32.toBits(f32.atan2(1.0, -1.0)) != 1075235812 { return 108 }
  if f32.toBits(f32.atan2(missing, 0.0)) != 2143289344 { return 109 }
  // Arguments outside [-1, 1] give the canonical NaN.
  if f32.toBits(f32.asin(-1.0)) != 3217625051 { return 110 }
  if f32.toBits(f32.asin(1.5)) != 2143289344 { return 111 }
  // The result is in [0, pi].
  if f32.toBits(f32.acos(0.5)) != 1065749138 { return 112 }
  // Overflow gives infinity, and underflow rounds once into the subnormal range.
  if f32.toBits(f32.exp(1.0)) != 1076754516 { return 113 }
  if f32.toBits(f32.exp(89.0)) != 2139095040 { return 114 }
  if f32.toBits(f32.exp(-104.0)) != 0 { return 115 }
  if f32.toBits(f32.exp(-87.5)) != 7123644 { return 116 }
  // Zero gives negative infinity and a negative argument the canonical NaN.
  if f32.toBits(f32.log(0.0)) != 4286578688 { return 117 }
  if f32.toBits(f32.log(10.0)) != 1075010958 { return 118 }
  if f32.toBits(f32.log(f32.fromBits(1))) != 3268316880 { return 119 }
  if f32.toBits(f32.log(-2.0)) != 2143289344 { return 120 }
  // The IEEE-754 special cases, and results that overflow or reach the subnormal range.
  if f32.toBits(f32.pow(-2.0, 5.0)) != 3254779904 { return 121 }
  if f32.toBits(f32.pow(2.0, -149.0)) != 1 { return 122 }
  if f32.toBits(f32.pow(2.0, -150.0)) != 0 { return 123 }
  if f32.toBits(f32.pow(3.0, 0.5)) != 1071494103 { return 124 }
  if f32.toBits(f32.pow(-1.0, -f32.INFINITY)) != 1065353216 { return 125 }
  // Exact cubes give exact roots, and the sign of the argument carries over.
  if f32.toBits(f32.cbrt(-27.0)) != 3225419776 { return 126 }
  if f32.toBits(f32.cbrt(10.0)) != 1074389570 { return 127 }
  // Infinity wins over NaN, and neither the squares nor the sum overflow.
  if f32.toBits(f32.hypot(3.0, 4.0)) != 1084227584 { return 128 }
  if f32.toBits(f32.hypot(f32.fromBits(2139095039), f32.fromBits(2139095039))) != 2139095040 { return 129 }
  if f32.toBits(f32.hypot(missing, f32.INFINITY)) != 2139095040 { return 130 }
  // One rounding: the residual of 0.1 * 10, a sign kept through underflow, and no intermediate
  // overflow.
  if f32.toBits(f32.fma(0.1, 10.0, -1.0)) != 847249408 { return 131 }
  if f32.toBits(f32.fma(f32.fromBits(1065353217), f32.fromBits(1065353215), -1.0)) != 864026622 { return 132 }
  if f32.toBits(f32.fma(-f32.fromBits(226492416), f32.fromBits(226492416), 0.0)) != 2147483648 { return 133 }
  if f32.toBits(f32.fma(f32.fromBits(8388608), f32.fromBits(872415232), f32.fromBits(1))) != 2 { return 134 }
  if f32.toBits(f32.fma(f32.fromBits(2139095039), 2.0, -f32.fromBits(2139095039))) != 2139095039 { return 135 }
  if f32.toBits(f32.fma(f32.INFINITY, 0.0, 1.0)) != 2143289344 { return 136 }
  return 42
}
