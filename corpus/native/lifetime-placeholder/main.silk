// `'_` writes out an elided lifetime: the type has one, and elision chooses it as if it were
// omitted.
import silk.text.string { String }
import silk.num.usize

struct Span<'a> {
  text: string<'a>,
}

fn width(span: Span<'_>) -> usize { return String.byteLength(span.text) }

fn first(values: &'_ [i32]) -> &'_ i32 { return &values[0] }

pub fn main() -> i32 {
  let values = [40, 1]
  let span = Span { text: "ab" }
  return first(&values).* + usize.toI32(width(move span))
}
