import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.edit_distance
import silk.text.string { String, InvalidUtf8 }
import silk.num.u32
import silk.num.u64
import silk.num.usize

// Every distance against the full table, over pseudo-random inputs whose lengths cover the stack
// and heap rows, the single-word and multi-row alignment, and shared starts and ends.

// The true Damerau-Levenshtein distance with the whole table, after Lowrance and Wagner.
effect fn fullUnrestricted(left: &[u32], right: &[u32], alphabet: usize) -> usize
  ! OutOfMemoryError
  ? &mut Allocator {
  let width = right.length + 2
  let far = left.length + right.length
  let mut table = List<usize>.make()
  run List<usize>.appendRepeated(&mut table, 0, (left.length + 2) * width)
  let cells = List<usize>.asMutSlice(&mut table)
  let mut lastRow = List<usize>.make()
  run List<usize>.appendRepeated(&mut lastRow, 0, alphabet)
  let rows = List<usize>.asMutSlice(&mut lastRow)
  cells[0] = far
  let mut i: usize = 0
  while i <= left.length {
    cells[(i + 1) * width] = far
    cells[(i + 1) * width + 1] = i
    i = i + 1
  }
  let mut j: usize = 0
  while j <= right.length {
    cells[j + 1] = far
    cells[width + j + 1] = j
    j = j + 1
  }
  i = 1
  while i <= left.length {
    let mut lastColumn: usize = 0
    j = 1
    while j <= right.length {
      let k = rows[u32.toUsize(right[j - 1])]
      let l = lastColumn
      let mut cost: usize = 1
      if left[i - 1] == right[j - 1] {
        cost = 0
        lastColumn = j
      }
      let mut best = cells[i * width + j] + cost
      if cells[(i + 1) * width + j] + 1 < best {
        best = cells[(i + 1) * width + j] + 1
      }
      if cells[i * width + j + 1] + 1 < best {
        best = cells[i * width + j + 1] + 1
      }
      let swapped = cells[k * width + l] + (i - k - 1) + 1 + (j - l - 1)
      if swapped < best {
        best = swapped
      }
      cells[(i + 1) * width + j + 1] = best
      j = j + 1
    }
    rows[u32.toUsize(left[i - 1])] = i
    i = i + 1
  }
  return cells[(left.length + 1) * width + right.length + 1]
}

// The optimal string alignment distance with the whole table.
effect fn fullAlignment(left: &[u32], right: &[u32]) -> usize
  ! OutOfMemoryError
  ? &mut Allocator {
  let width = right.length + 1
  let mut table = List<usize>.make()
  run List<usize>.appendRepeated(&mut table, 0, (left.length + 1) * width)
  let cells = List<usize>.asMutSlice(&mut table)
  let mut i: usize = 0
  while i <= left.length {
    cells[i * width] = i
    i = i + 1
  }
  let mut j: usize = 0
  while j <= right.length {
    cells[j] = j
    j = j + 1
  }
  i = 1
  while i <= left.length {
    j = 1
    while j <= right.length {
      let mut cost: usize = 1
      if left[i - 1] == right[j - 1] {
        cost = 0
      }
      let mut best = cells[(i - 1) * width + j - 1] + cost
      if cells[(i - 1) * width + j] + 1 < best {
        best = cells[(i - 1) * width + j] + 1
      }
      if cells[i * width + j - 1] + 1 < best {
        best = cells[i * width + j - 1] + 1
      }
      if i > 1 && j > 1 && left[i - 1] == right[j - 2] && left[i - 2] == right[j - 1] {
        if cells[(i - 2) * width + j - 2] + 1 < best {
          best = cells[(i - 2) * width + j - 2] + 1
        }
      }
      cells[i * width + j] = best
      j = j + 1
    }
    i = i + 1
  }
  return cells[left.length * width + right.length]
}

// The UTF-8 encodings of the scalars that text inputs draw from: ASCII, two, three and four bytes.
const PIECES: usize = 6

fn piece(index: u32) -> &'static [u8] {
  if index == 0 {
    return b"a"
  }
  if index == 1 {
    return b"b"
  }
  if index == 2 {
    return b"\xc3\xa9"
  }
  if index == 3 {
    return b"c"
  }
  if index == 4 {
    return b"\xe4\xb8\xad"
  }
  return b"\xf0\x9f\x98\x80"
}

struct Random {
  state: u64,
}

fn next(random: &mut Random, below: usize) -> usize {
  random.state = u64.wrappingAdd(
    u64.wrappingMultiply(random.state, 6364136223846793005),
    1442695040888963407,
  )
  return u64.toUsize(u64.shiftRight(random.state, 33)) % below
}

// Fills `symbols` with `length` symbols below `alphabet`. Most inputs repeat a shared start and
// end, so the trimming before the main work is exercised.
effect fn generate(
  random: &mut Random,
  symbols: &mut List<u32>,
  length: usize,
  alphabet: usize,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  List<u32>.clear(&mut symbols.*)
  let mut at: usize = 0
  while at < length {
    run List<u32>.append(&mut symbols.*, usize.toU32(next(&mut random.*, alphabet)))
    at = at + 1
  }
}

// A copy of `base` with a few random edits, so the two inputs are close as typing errors are.
effect fn mutate(random: &mut Random, base: &[u32], out: &mut List<u32>, alphabet: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  List<u32>.clear(&mut out.*)
  run List<u32>.appendSlice(&mut out.*, base)
  let edits = next(&mut random.*, 4)
  let mut done: usize = 0
  while done < edits {
    let length = List<u32>.length(&out.*)
    let kind = next(&mut random.*, 4)
    if kind == 0 || length == 0 {
      let at = next(&mut random.*, length + 1)
      run List<u32>.insertRepeated(&mut out.*, at, usize.toU32(next(&mut random.*, alphabet)), 1)
    } else if kind == 1 {
      let removed = List<u32>.remove(&mut out.*, next(&mut random.*, length))
      if removed > 1000000 {
        return ()
      }
    } else if kind == 2 {
      List<u32>.set(
        &mut out.*,
        next(&mut random.*, length),
        usize.toU32(next(&mut random.*, alphabet)),
      )
    } else if length >= 2 {
      let at = next(&mut random.*, length - 1)
      let first = List<u32>.get(&out.*, at)
      let second = List<u32>.get(&out.*, at + 1)
      List<u32>.set(&mut out.*, at, second)
      List<u32>.set(&mut out.*, at + 1, first)
    }
    done = done + 1
  }
}

effect fn asBytes(symbols: &[u32], out: &mut Bytes) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  Bytes.clear(&mut out.*)
  let mut at: usize = 0
  while at < symbols.length {
    run Bytes.append(&mut out.*, &[u32.toU8(symbols[at])])
    at = at + 1
  }
}

effect fn asText(symbols: &[u32], out: &mut Bytes) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  Bytes.clear(&mut out.*)
  let mut at: usize = 0
  while at < symbols.length {
    run Bytes.append(&mut out.*, piece(symbols[at]))
    at = at + 1
  }
}

fn text(bytes: &Bytes) -> string {
  return String.fromUtf8(Bytes.asSlice(bytes)) |> Result<string, InvalidUtf8>.unwrapOr("")
}

// Compares every form on `left` and `right`, as bytes and, when `alphabet` fits the pieces, as text.
effect fn check(
  left: &[u32],
  right: &[u32],
  alphabet: usize,
  leftBytes: &mut Bytes,
  rightBytes: &mut Bytes,
) -> i32
  ! OutOfMemoryError
  ? &mut Allocator {
  let unrestricted = run fullUnrestricted(left, right, alphabet)
  let aligned = run fullAlignment(left, right)
  run asBytes(left, &mut leftBytes.*)
  run asBytes(right, &mut rightBytes.*)
  let l = Bytes.asSlice(&leftBytes.*)
  let r = Bytes.asSlice(&rightBytes.*)
  if (run edit_distance.damerauLevenshteinBytes(l, r)) != unrestricted {
    return 1
  }
  if (run edit_distance.damerauLevenshteinBytes(r, l)) != unrestricted {
    return 2
  }
  if (run edit_distance.optimalStringAlignmentBytes(l, r)) != aligned {
    return 3
  }
  if (run edit_distance.optimalStringAlignmentBytes(r, l)) != aligned {
    return 4
  }
  if alphabet <= PIECES {
    run asText(left, &mut leftBytes.*)
    run asText(right, &mut rightBytes.*)
    let lt = text(&leftBytes.*)
    let rt = text(&rightBytes.*)
    if (run edit_distance.damerauLevenshtein(lt, rt)) != unrestricted {
      return 5
    }
    if (run edit_distance.damerauLevenshtein(rt, lt)) != unrestricted {
      return 6
    }
    if (run edit_distance.optimalStringAlignment(lt, rt)) != aligned {
      return 7
    }
    if (run edit_distance.optimalStringAlignment(rt, lt)) != aligned {
      return 8
    }
  }
  return 0
}

effect fn cases() -> i32
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut random = Random { state: 12345 }
  let mut left = List<u32>.make()
  let mut right = List<u32>.make()
  let mut leftBytes = Bytes.make()
  let mut rightBytes = Bytes.make()
  let lengths: [usize; 12] = [0, 1, 2, 5, 13, 31, 62, 63, 64, 65, 66, 140]
  let alphabets: [usize; 3] = [2, 6, 256]
  let mut round: usize = 0
  while round < 600 {
    let alphabet = alphabets[round % 3]
    let leftLength = lengths[next(&mut random, 12)]
    run generate(&mut random, &mut left, leftLength, alphabet)
    if next(&mut random, 2) == 0 {
      run mutate(&mut random, List<u32>.asSlice(&left), &mut right, alphabet)
    } else {
      let rightLength = lengths[next(&mut random, 12)]
      run generate(&mut random, &mut right, rightLength, alphabet)
    }
    let failed = run check(
      List<u32>.asSlice(&left),
      List<u32>.asSlice(&right),
      alphabet,
      &mut leftBytes,
      &mut rightBytes,
    )
    if failed != 0 {
      return failed
    }
    round = round + 1
  }

  // The examples whose two variants differ, and text with more than 256 distinct scalars.
  if (run edit_distance.damerauLevenshtein("ca", "abc")) != 2 {
    return 20
  }
  if (run edit_distance.optimalStringAlignment("ca", "abc")) != 3 {
    return 21
  }
  if (run edit_distance.damerauLevenshtein("", "")) != 0 {
    return 22
  }
  if (run edit_distance.damerauLevenshtein("é", "è")) != 1 {
    return 23
  }
  if (run edit_distance.optimalStringAlignment("aé", "éa")) != 1 {
    return 24
  }
  let mut wide = Bytes.make()
  let mut reversed = Bytes.make()
  let mut scalar: u32 = 256
  while scalar < 556 {
    run Bytes.append(
      &mut wide,
      &[u32.toU8(192 | u32.shiftRight(scalar, 6)), u32.toU8(128 | (scalar & 63))],
    )
    scalar = scalar + 1
  }
  scalar = 556
  while scalar > 256 {
    scalar = scalar - 1
    run Bytes.append(
      &mut reversed,
      &[u32.toU8(192 | u32.shiftRight(scalar, 6)), u32.toU8(128 | (scalar & 63))],
    )
  }
  run generate(&mut random, &mut left, 0, 1)
  run generate(&mut random, &mut right, 0, 1)
  let mut id: u32 = 0
  while id < 300 {
    run List<u32>.append(&mut left, id)
    run List<u32>.append(&mut right, 299 - id)
    id = id + 1
  }
  let reversedUnrestricted = run fullUnrestricted(
    List<u32>.asSlice(&left),
    List<u32>.asSlice(&right),
    300,
  )
  let reversedAligned = run fullAlignment(List<u32>.asSlice(&left), List<u32>.asSlice(&right))
  if (run edit_distance.damerauLevenshtein(text(&wide), text(&reversed))) != reversedUnrestricted {
    return 25
  }
  if (run edit_distance.optimalStringAlignment(text(&wide), text(&reversed))) != reversedAligned {
    return 26
  }
  let tail = Slice.view<u8>(Bytes.asSlice(&wide), 0, 10)
  if (run edit_distance.damerauLevenshtein(
    text(&wide),
    String.fromUtf8(tail) |> Result<string, InvalidUtf8>.unwrapOr(""),
  ))
    != 295 {
    return 27
  }
  return 0
}

effect fn exhausted(error: OutOfMemoryError) -> i32 {
  drop error
  return 100
}

pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(cases(), exhausted) |> Effect.provideMut<Allocator>(&mut allocator)
}
