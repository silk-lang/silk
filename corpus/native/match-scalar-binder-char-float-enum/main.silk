enum Color { Red, Green }
fn letter(c: char) -> i32 {
  return match c {
    char v => {
      if v == 'a' { return 1 }
      return 2
    }
  }
}
fn half(x: f64) -> f64 {
  return match x {
    f64 v => v / 2.0
  }
}
fn shade(c: Color) -> i32 {
  return match c {
    Color.Red => 10
    Color v => {
      if v == Color.Green { return 20 }
      return 30
    }
  }
}
pub fn main() -> i32 {
  if letter('a') != 1 { return 1 }
  if letter('b') != 2 { return 2 }
  if half(4.0) != 2.0 { return 3 }
  if shade(Color.Red) != 10 { return 4 }
  if shade(Color.Green) != 20 { return 5 }
  return 42
}
