// A service operation's `self: &Self` or `self: &mut Self` receiver names the access its call needs
// from the Effect environment, as `? &Counter` or `? &mut Counter` would. The implementation writes
// the same receiver and no row; the call takes the provider from the environment.
import silk.core.effect { Effect }

service Counter {
  effect fn get(self: &Self) -> i32
  effect fn bump(self: &mut Self, by: i32) -> ()
  effect fn doubled(self: &Self) -> i32 {
    let value = run Counter.get()
    return value + value
  }
}

struct Tally { value: i32, }

impl Counter for Tally {
  effect fn get(self: &Self) -> i32 { return self.value }
  effect fn bump(self: &mut Self, by: i32) -> () { self.value = self.value + by }
}

effect fn read() -> i32 ? &Counter {
  return run Counter.get()
}

effect fn step() -> i32 ? &mut Counter {
  run Counter.bump(4)
  return run Counter.doubled()
}

pub effect fn main() -> i32 {
  let shared = Tally { value: 17 }
  let read = run read() |> Effect.provide(&shared)
  if read != 17 {
    return 1
  }
  let mut tally = Tally { value: 1 }
  let stepped = run step() |> Effect.provideMut(&mut tally)
  if stepped != 10 || tally.value != 5 {
    return 2
  }
  return 42
}
