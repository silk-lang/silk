import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.box { Box }
import silk.core.effect { Effect }
import silk.layout { Layout }
import silk.collections.list { List }
import silk.mem.pointer { Pointer }
import silk.mem.raw_buffer { RawBuffer }
import silk.mem.slot { Slot }

// Counts every reclaim through the context address, a `usize` the program owns.
export "C" fn countReclaim(context: ?*mut u8) -> () {
  let present = unsafe Intrinsic.pointerRequalify<?*mut u8, *mut u8>(context)
  let counter = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut usize>(present)
  unsafe { Pointer.write<usize>(counter, Pointer.read<usize>(counter) + 1) }
  return ()
}

// Hands out adopted allocations from one system chunk and never reuses a byte.
struct Pool { base: [*]mut u8, used: usize, issued: usize, counter: ?*mut u8 }

effect fn allocate(self: &mut Pool, layout: Layout) -> Intrinsic.Allocation ! OutOfMemoryError {
  let remainder = (Pointer.addressMany<u8>(self.base) + self.used) % layout.alignment
  if remainder != 0 { self.used = self.used + layout.alignment - remainder }
  if self.used + layout.bytes > 512 { fail OutOfMemoryError {} }
  let at = unsafe Pointer.atMut<u8>(self.base, self.used)
  self.used = self.used + layout.bytes
  self.issued = self.issued + 1
  let reclaim: extern "C" fn(?*mut u8) -> () = countReclaim
  return unsafe Intrinsic.allocationAdopt(at, move layout, reclaim, self.counter)
}

impl Allocator for Pool { allocate: Pool.allocate }

effect fn build() -> i32 ! OutOfMemoryError {
  let mut system = Allocator.systemAllocatorProvider()
  let chunk = run Allocator.allocate(Layout { bytes: 512, alignment: 1 }) |> Effect.provideMut<Allocator>(&mut system)
  let mut bytes = unsafe RawBuffer.from<u8>(move chunk, 512)
  let base = unsafe Pointer.assumeManyMut<u8>(Slot.address(RawBuffer.slot<u8>(&mut bytes, 0)))
  let mut count = run Box<usize>.make(0) |> Effect.provideMut<Allocator>(&mut system)
  let counter = Pointer.fromMutRef(&mut count.getMut()[0])
  let mut pool = Pool { base: base, used: 0, issued: 0, counter: unsafe Intrinsic.pointerReinterpret<*mut usize, *mut u8>(counter) }
  let boxed = run Box<i64>.make(40) |> Effect.provideMut<Allocator>(&mut pool)
  let mut values = List<i32>.make()
  let mut at = 0
  while at < 20 {
    run List<i32>.append(&mut values, at) |> Effect.provideMut<Allocator>(&mut pool)
    at = at + 1
  }
  // List growth already dropped every buffer but the last.
  let grown = unsafe Pointer.read<usize>(counter)
  let sum = List<i32>.get(&values, 19) + List<i32>.get(&values, 2)
  drop values
  drop boxed
  let total = unsafe Pointer.read<usize>(counter)
  drop bytes
  if grown + 2 != pool.issued || total != pool.issued || pool.issued < 4 { return 1 }
  return sum + 21
}

effect fn recover(error: OutOfMemoryError) -> i32 { return 2 }

pub fn main() -> i32 {
  return run Effect.catchAll(build(), recover)
}
