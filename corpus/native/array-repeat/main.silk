import silk.core.ownership {Copy, Drop}
import silk.num.usize

unsafe extern "C" fn silk_repeat_event(value: i32) -> ()
unsafe extern "C" fn silk_repeat_events() -> i32

struct Resource { value: i32 }
impl Drop for Resource {
  fn drop(self: &mut Resource) -> () {
    unsafe { silk_repeat_event(self.value) }
  }
}

fn next(counter: &mut i32) -> i32 {
  counter.* = counter.* + 1
  return counter.*
}

fn last(bytes: &[u8]) -> u8 { return bytes[3] }
fn inferred<T: Copy>(values: [T; 2]) -> T { return values[1] }

pub fn main() -> i32 {
  let mut calls = 0
  let empty: [i32; 0] = [next(&mut calls); 0]
  if calls != 1 { return 1 }
  let single = [next(&mut calls); 1]
  if calls != 2 || single[0] != 2 { return 2 }
  let mut values = [next(&mut calls); 2 + 2]
  if calls != 3 { return 3 }
  let mut index = usize.ZERO
  while index < 4 {
    if values[index] != 3 { return 4 }
    index = index + 1
  }
  values[1] = 9
  if values[0] != 3 || values[2] != 3 || values[3] != 3 { return 5 }
  let mut nested: [[u8; 3]; 2] = [[7; 3]; 2]
  nested[0][1] = 8
  if nested[1][1] != 7 || nested[0][0] != 7 { return 6 }
  if last(&[255; 4]) != 255 { return 7 }
  if inferred([17; 2]) != 17 { return 8 }
  let units = [(); 4]
  let unit = units[3]
  let discarded = [Resource {value: 1}; 0]
  unsafe { if silk_repeat_events() != 1 { return 9 } }
  let owned = [Resource {value: 2}; 1]
  let resource = move owned[0]
  drop resource
  unsafe { if silk_repeat_events() != 12 { return 10 } }
  return 42
}
