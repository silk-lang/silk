import silk.core.effect { Effect }
import silk.concurrency.sync { Arc }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.http.client { Request }
import silk.http.head { Limits, ParsedRequest, ParseError, RequestHead, parseRequest }
import silk.http.headers { Limits as ValueLimits }
import silk.http.trace { extract, inject, serverSpan }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.trace { Config, Recorder, SpanContext, SpanKind, Trace, Tracer }

effect fn parentOf(bytes: &[u8]) -> Option<SpanContext> ! OutOfMemoryError ? &mut Allocator {
  let limits = Limits {maxHeadBytes: 1024, maxStartLineBytes: 256, maxFieldLineBytes: 256, maxOwnedBytes: 2048,
    values: ValueLimits {maxMethodBytes: 16, maxTargetBytes: 256, maxNameBytes: 32, maxValueBytes: 256,
      maxFields: 8, maxFieldBytes: 512, maxOwnedBytes: 1024}}
  let head = match move run parseRequest(bytes, limits) {
    Result<ParsedRequest, ParseError>.Success {value} => move value
    Result<ParsedRequest, ParseError>.Failure {..} => { return Option<SpanContext>.none() }
  }
  let parsed = match head.parser.head() {
    Result<RequestHead<'_>, ParseError>.Success {value} => value
    Result<RequestHead<'_>, ParseError>.Failure {..} => { return Option<SpanContext>.none() }
  }
  let _span = serverSpan(&parsed, "GET /")
  return extract(&parsed)
}

effect fn forward(remote: &SpanContext) -> i32 ! OutOfMemoryError ? &mut Allocator {
  let _span = Trace.spanFrom(remote, "upstream")
  let mut outgoing = Request.get("http://example.test/")
  run outgoing.header("TraceParent", "stale")
  run inject(&mut outgoing)
  if outgoing.headerCount() != 1 { return 7 }
  let field = outgoing.headerAt(0)
  if field.name != "traceparent" { return 8 }
  let sent = match Trace.parseTraceparent(field.value) {
    Option<SpanContext>.Some {value} => value
    Option<SpanContext>.None => { return 9 }
  }
  let local = match Trace.current() {
    Option<SpanContext>.Some {value} => value
    Option<SpanContext>.None => { return 10 }
  }
  if sent.traceLow != remote.traceLow || sent.span != local.span || sent.span == remote.span || sent.flags != 1 { return 11 }
  return 0
}

effect fn exercise() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let remote = run parentOf(b"GET / HTTP/1.1\r\nHost: example.test\r\nTrAcEpArEnT: 00-0000000000000000000000000000002a-0000000000000007-01\r\n\r\n")
  if let Option<SpanContext>.Some {value} = remote {
    if value.traceLow != 42 || value.span != 7 || value.flags != 1 { return 2 }
    let recorder = run Arc<Recorder>.make(run Recorder.make(Config.make("http-test")))
    let code = run forward(&value) |> Effect.provideAmbient<Tracer>(&recorder)
    if code != 0 { return code }
    let recorded = recorder.get().takeSpan()
    if let Option.Some {value: span} = move recorded {
      if span.kind != SpanKind.Server || span.parent.span != value.span { return 12 }
    } else { return 13 }
  } else { return 1 }
  let duplicate = run parentOf(b"GET / HTTP/1.1\r\nHost: example.test\r\ntraceparent: 00-0000000000000000000000000000002a-0000000000000007-01\r\nTraceparent: invalid\r\n\r\n")
  if duplicate.isSome() { return 3 }
  let mut outgoing = Request.get("http://example.test/")
  run inject(&mut outgoing)
  if outgoing.headerCount() != 0 { return 4 }
  run outgoing.header("traceparent", "first")
  run outgoing.header("Accept", "application/json")
  run outgoing.header("Traceparent", "second")
  run outgoing.setHeader("traceparent", "current")
  if outgoing.headerCount() != 2 || outgoing.headerAt(0).name != "Accept" || outgoing.headerAt(1).value != "current" { return 5 }
  return 0
}

effect fn failed(error: OutOfMemoryError) -> i32 { return 6 }
pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(exercise() |> Effect.provideMut<Allocator>(&mut allocator), failed)
}
