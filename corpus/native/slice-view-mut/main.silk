import silk.collections.slice { Slice }

fn fill(values: &mut [i32], value: i32) -> () {
  let mut index: usize = 0
  while index < values.length {
    values[index] = value
    index = index + 1
  }
}

fn fillRange(values: &mut [i32], offset: usize, length: usize, value: i32) -> usize {
  let part = Slice.viewMut<i32>(move values, offset, length)
  let count = part.length
  fill(move part, value)
  return count
}

fn emptyView(values: &mut [i32]) -> usize {
  return Slice.viewMut<i32>(move values, 0, 0).length
}

pub fn main() -> i32 {
  let mut values = [1, 2, 3, 4, 5]
  if fillRange(&mut values, 1, 3, 9) != 3 { return 1 }
  if values[0] != 1 || values[1] != 9 || values[2] != 9 || values[3] != 9 || values[4] != 5 { return 2 }
  if fillRange(&mut values, 5, 0, 7) != 0 { return 3 }
  if fillRange(&mut values, 0, 5, 6) != 5 { return 4 }
  if values[0] != 6 || values[4] != 6 { return 5 }
  let mut none: [i32; 0] = []
  if emptyView(&mut none) != 0 { return 6 }
  return 42
}
