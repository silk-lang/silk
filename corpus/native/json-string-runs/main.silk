import silk.json.scanner { JsonError, JsonScanner, JsonToken }
import silk.option { Option }
import silk.core.result { Result }
import silk.collections.slice { Slice }

// The scanner skips plain string bytes in blocks; spans, escape flags and error offsets must not
// depend on where a special byte falls relative to a block.
// Returns the string token's length and escape flag as `length * 2 + escaped`, or `1000000 + offset`
// for an error.
fn scan(document: &[u8]) -> usize {
  let mut scanner = JsonScanner.make(document)
  return match move JsonScanner.next(&mut scanner) {
    Result<JsonToken, JsonError>.Failure { error } => match move error.offset {
      Option<usize>.Some { value } => 1000000 + value
      Option<usize>.None => 2000000
    }
    Result<JsonToken, JsonError>.Success { value } => match move value {
      JsonToken.String { span, escaped } => span.length * 2 + flag(escaped)
      _ => 3000000
    }
  }
}

fn flag(escaped: bool) -> usize {
  if escaped { return 1 }
  return 0
}

pub fn main() -> i32 {
  let mut buffer: [u8; 72] = [97; 72]
  let mut body: usize = 0
  while body <= 68 {
    let length = body + 2
    buffer[0] = 34
    let mut at: usize = 1
    while at <= body {
      buffer[at] = 97
      at = at + 1
    }
    buffer[body + 1] = 34
    let document = Slice.view(&buffer, 0, length)
    if scan(document) != length * 2 { return 1 }
    let mut position: usize = 1
    while position <= body {
      // A control byte is refused where it stands.
      buffer[position] = 10
      if scan(Slice.view(&buffer, 0, length)) != 1000000 + position { return 2 }
      // A byte that cannot start UTF-8 is refused where it stands.
      buffer[position] = 255
      if scan(Slice.view(&buffer, 0, length)) != 1000000 + position { return 3 }
      if position < body {
        // An escape marks the string as escaped.
        buffer[position] = 92
        buffer[position + 1] = 110
        if scan(Slice.view(&buffer, 0, length)) != length * 2 + 1 { return 4 }
        // An escaped quote does not end the string.
        buffer[position + 1] = 34
        if scan(Slice.view(&buffer, 0, length)) != length * 2 + 1 { return 5 }
        // A two-byte character keeps the span.
        buffer[position] = 195
        buffer[position + 1] = 169
        if scan(Slice.view(&buffer, 0, length)) != length * 2 { return 6 }
        buffer[position + 1] = 97
      }
      buffer[position] = 97
      position = position + 1
    }
    body = body + 1
  }
  return 0
}
