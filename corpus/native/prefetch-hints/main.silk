// A prefetch hint never reads memory, never faults and never changes what the program computes:
// for every access, locality and cache, at a live value, a slice, and null. A target without a
// prefetch instruction, such as WebAssembly, ignores it.
import silk.mem.pointer { Pointer }
import silk.mem.prefetch { Prefetch, PrefetchAccess, PrefetchCache, PrefetchLocality, PrefetchOptions }

// Hints every element of `values` one step ahead, with the selections `options`, and sums them.
fn sum(values: &[u32], static options: PrefetchOptions) -> u32 {
  let mut total: u32 = 0
  let mut at: usize = 0
  while at < values.length {
    if at + 1 < values.length { Prefetch.hint<u32>(Pointer.fromRef<u32>(&values[at + 1]), options) }
    total = total + values[at]
    at = at + 1
  }
  Prefetch.hintMany<u32>(Pointer.fromSlice<u32>(values), options)
  Prefetch.hint<u32>(Pointer.null<u32>(), options)
  return total
}

pub fn main() -> i32 {
  let values: [u32; 6] = [1, 2, 3, 5, 8, 13]
  let read = sum(&values, PrefetchOptions {access: PrefetchAccess.Read, locality: PrefetchLocality.High, cache: PrefetchCache.Data})
  let write = sum(&values, PrefetchOptions {access: PrefetchAccess.Write, locality: PrefetchLocality.NoReuse, cache: PrefetchCache.Data})
  let low = sum(&values, PrefetchOptions {access: PrefetchAccess.Read, locality: PrefetchLocality.Low, cache: PrefetchCache.Data})
  let code = sum(&values, PrefetchOptions {access: PrefetchAccess.Read, locality: PrefetchLocality.Moderate, cache: PrefetchCache.Instruction})
  if read != 32 || write != 32 || low != 32 || code != 32 {
    return 1
  }
  let empty: [u32; 0] = []
  if sum(&empty, PrefetchOptions {access: PrefetchAccess.Write, locality: PrefetchLocality.High, cache: PrefetchCache.Data}) != 0 {
    return 2
  }
  return 0
}
