import silk.core.effect { Effect }

// A generic bound that offers a provider infers its success and failure from an Effect that
// requires nothing, as well as from one that requires the provider.
pub service Probe {
  effect fn value() -> i32 ? &mut Probe
}

struct Client { base: i32 }

impl Probe for Client {
  effect fn value(self: &mut Self) -> i32 { return self.base }
}

struct Rejected { code: i32 }

effect fn withProbe<A, E, F: once Effect<'static; A ! E ? &mut Probe>>(task: F) -> A ! E {
  let mut client = Client { base: 30 }
  return run provide<A, E>(move task, &mut client)
}

effect<'env> fn provide<'env, A, E>(task: once Effect<'static; A ! E ? &mut Probe>, client: &'env mut Client) -> A ! E {
  let provided = Effect.provideMut<Probe>(move task, &mut client.*)
  return run provided
}

effect fn closed() -> i32 { return 2 }
effect fn failing(value: i32) -> i32 ! Rejected {
  if value < 0 { fail Rejected { code: 10 } }
  return value
}
effect fn open() -> i32 ? &mut Probe { return run Probe.value() }

effect fn recover(error: Rejected) -> i32 { return error.code }

pub fn main() -> i32 {
  let first = run withProbe(closed())
  let second = run withProbe(open())
  let third = run Effect.catchAll(withProbe(failing(-1)), recover)
  return first + second + third
}
