// A division that does not change across a loop's iterations, by a divisor that is zero, must
// trap only when an iteration reaches it: never in a loop that runs no iteration, and never in
// one whose iterations stop before the branch that guards it.

fn guarded(count: u32, divisor: u32) -> u32 {
  let mut sum: u32 = 0
  let mut i: u32 = 0
  while i < count {
    if i >= 3 {
      sum = sum + 1000 / divisor
    }
    sum = sum + i
    i = i + 1
  }
  return sum
}

fn every(count: u32, divisor: u32) -> u32 {
  let mut sum: u32 = 0
  let mut i: u32 = 0
  while i < count {
    sum = sum + 1000 / divisor
    i = i + 1
  }
  return sum
}

pub fn main() -> i32 {
  let early = guarded(3, 0)
  let late = guarded(6, 2)
  let none = every(0, 0)
  let some = every(4, 10)
  if early == 3 && late == 1515 && none == 0 && some == 400 {
    return 42
  }
  return 1
}
