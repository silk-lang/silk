import silk.crypto.ed25519 {Ed25519Error, Ed25519PublicKey}
import silk.core.result {Result}
import silk.num.u8

// 0 when the signature verifies, 1 when it is rejected as invalid, 2 for any other outcome.
fn outcome(key: &[u8], message: &[u8], signature: &[u8]) -> i32 {
  return match Ed25519PublicKey.fromBytes(key) {
    Result.Failure { error } => 2
    Result.Success { value: parsed } => match parsed.verify(message, signature) {
      Result.Success { value } => 0
      Result.Failure { error } => match error {
        Ed25519Error.InvalidSignature => 1
        Ed25519Error.InvalidSignatureLength => 2
        Ed25519Error.InvalidKey => 2
        Ed25519Error.InvalidKeyLength => 2
      }
    }
  }
}

fn keyError(key: &[u8]) -> i32 {
  return match Ed25519PublicKey.fromBytes(key) {
    Result.Success { value } => 0
    Result.Failure { error } => match error {
      Ed25519Error.InvalidKey => 1
      Ed25519Error.InvalidKeyLength => 2
      Ed25519Error.InvalidSignature => 3
      Ed25519Error.InvalidSignatureLength => 3
    }
  }
}

fn case0() -> bool {
  let key: [u8; 32] = [215, 90, 152, 1, 130, 177, 10, 183, 213, 75, 254, 211, 201, 100, 7, 58, 14, 225, 114, 243, 218, 166, 35, 37, 175, 2, 26, 104, 247, 7, 81, 26]
  let message: [u8; 0] = []
  let mut signature: [u8; 64] = [229, 86, 67, 0, 195, 96, 172, 114, 144, 134, 226, 204, 128, 110, 130, 138, 132, 135, 127, 30, 184, 229, 217, 116, 216, 115, 224, 101, 34, 73, 1, 85, 95, 184, 130, 21, 144, 163, 59, 172, 198, 30, 57, 112, 28, 249, 180, 107, 210, 91, 245, 240, 89, 91, 190, 36, 101, 81, 65, 67, 142, 122, 16, 11]
  if outcome(&key, &message, &signature) != 0 { return false }
  signature[0] = u8.bitXor(signature[0], 1)
  if outcome(&key, &message, &signature) != 1 { return false }
  signature[0] = u8.bitXor(signature[0], 1)
  signature[40] = u8.bitXor(signature[40], 4)
  if outcome(&key, &message, &signature) != 1 { return false }
  signature[40] = u8.bitXor(signature[40], 4)
  if outcome(&key, &message, &signature) != 0 { return false }
  return true
}

