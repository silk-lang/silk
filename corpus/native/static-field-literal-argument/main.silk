// A string literal in a field descriptor parameter names the field (STATIC-018), and a method call
// takes a static descriptor argument like the qualified call does (STATIC-002).
import silk.core.reflect { Reflect }
import silk.mem.layout { Layout }

struct Pair {
  pub first: i32,
  pub second: i64,
}

struct Plain {
  value: Pair,
}

static fn size<T, V>(field: Intrinsic.Field<T, V>) -> usize {
  return Layout.of<V>().bytes
}

impl Plain {
  fn width<V>(self: &Self, static field: Intrinsic.Field<Pair, V>) -> usize {
    return size(field)
  }
}

struct Holder<T> {
  value: T,
}

impl<T> Holder<T> {
  fn width<V>(self: &Self, static field: Intrinsic.Field<T, V>) -> usize {
    return size(field)
  }
}

pub fn main() -> i32 {
  let plain = Plain { value: Pair { first: 1, second: 2 } }
  let holder = Holder<Pair> { value: Pair { first: 3, second: 4 } }
  if Plain.width(&plain, Reflect.field<Pair, i64>("second")) != 8 { return 1 }
  if plain.width(Reflect.field<Pair, i32>("first")) != 4 { return 2 }
  if holder.width(Reflect.field<Pair, i64>("second")) != 8 { return 3 }
  if holder.width("first") != 4 { return 4 }
  if Holder<Pair>.width(&holder, "second") != 8 { return 5 }
  let static first = Reflect.field<Pair, i32>("first")
  if holder.width(first) != 4 { return 7 }
  return 42
}
