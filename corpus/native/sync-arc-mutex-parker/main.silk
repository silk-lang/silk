import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.concurrency.thread_native { JoinHandle, NativeThread, SpawnError }
import silk.core.option { Option }
import silk.concurrency.sync { Arc, Mutex, MutexGuard, Parker, Unparker }

// Four threads add to one locked counter; a fifth wakes the parked main thread.
fn addMany(total: Arc<Mutex<i32>>) -> i32 {
  let mut round = 0
  while round < 1000 {
    let mut guard = total.get().lock()
    let value = guard.getMut()
    value.* = value.* + 1
    round = round + 1
  }
  return 0
}

fn wake(unparker: Unparker) -> i32 {
  unparker.unpark()
  return 7
}

effect fn spawnAdder(total: &Arc<Mutex<i32>>) -> JoinHandle<i32> ! OutOfMemoryError | SpawnError ? &mut Allocator {
  let mine = total.clone()
  return run NativeThread.spawn(fn() -> i32 { return addMany(move mine) })
}

effect fn spawnWaker(parker: &Parker) -> JoinHandle<i32> ! OutOfMemoryError | SpawnError ? &mut Allocator {
  let unparker = parker.unparker()
  return run NativeThread.spawn(fn() -> i32 { return wake(move unparker) })
}

fn lockedElsewhere(total: &Arc<Mutex<i32>>) -> bool {
  let guard = total.get().lock()
  return match total.get().tryLock() {
    Option<MutexGuard<i32>>.Some {..} => false
    Option<MutexGuard<i32>>.None => true
  }
}

effect fn program() -> i32 ! OutOfMemoryError | SpawnError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mutex = run Mutex<i32>.make(0) |> Effect.provideMut<Allocator>(&mut allocator)
  let total = run Arc<Mutex<i32>>.make(move mutex) |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run spawnAdder(&total) |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run spawnAdder(&total) |> Effect.provideMut<Allocator>(&mut allocator)
  let third = run spawnAdder(&total) |> Effect.provideMut<Allocator>(&mut allocator)
  let fourth = run spawnAdder(&total) |> Effect.provideMut<Allocator>(&mut allocator)
  let joined = first.join() + second.join() + third.join() + fourth.join()
  if joined != 0 || total.get().lock().get().* != 4000 { return 1 }
  if total.count() != 1 { return 2 }
  if !lockedElsewhere(&total) { return 3 }
  let parker = run Parker.make() |> Effect.provideMut<Allocator>(&mut allocator)
  if parker.parkTimeout(1000000) { return 4 }
  let waker = run spawnWaker(&parker) |> Effect.provideMut<Allocator>(&mut allocator)
  parker.park()
  if waker.join() != 7 { return 5 }
  return 42
}

effect fn recover(error: OutOfMemoryError | SpawnError) -> i32 { return -2 }

pub fn main() -> i32 { return run Effect.catchAll(program(), recover) }
