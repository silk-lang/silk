import silk.mem.allocator { OutOfMemoryError }
import silk.core.effect { Effect }
import silk.concurrency.fiber { Cancelled, Failure, Fiber, Outcome, Success }
import silk.concurrency.local_scheduler { LocalScheduler, StalledError }
import silk.system.monotonic_clock { MonotonicClock }
import silk.system.monotonic_clock_native { OsMonotonicClock }
import silk.concurrency.scheduler { Scheduler, TaskIdExhaustedError }

struct Problem { code: i32 }

effect fn later(value: i32) -> i32 ! Problem {
  run Fiber.yieldNow()
  run Fiber.yieldNow()
  if value < 0 { fail Problem { code: 0 - value } }
  return value
}

effect fn sleeper() -> i32 ! Problem ? &mut MonotonicClock {
  run Effect.sleep(3600000000000)
  return 1
}

// The outcome's success value, its failure code negated, or -100 when cancelled.
fn valueOf(outcome: Outcome<i32, Problem>) -> i32 {
  let Outcome<i32, Problem> { value } = move outcome
  return match move value {
    Success<i32> { value: found } => found
    Failure<Problem> { error } => 0 - error.code
    Cancelled {} => -100
  }
}

// Checks `fiber` once per yield, the way a frame loop does, counting the checks that found it
// running, then awaits it, which no longer parks.
effect fn awaitWhenFinished(fiber: Fiber<i32, Problem>, pending: &mut i32) -> i32 {
  while !fiber.isFinished() {
    pending.* = pending.* + 1
    run Fiber.yieldNow()
  }
  return valueOf(run fiber.await())
}

effect fn root() -> i32
  ! OutOfMemoryError | TaskIdExhaustedError | Cancelled
  ? &mut Scheduler | &mut MonotonicClock {
  // A child that has not run yet is not finished.
  let mut pending = 0
  let first = run Fiber<i32, Problem>.forkChild(later(30))
  let value = run awaitWhenFinished(move first, &mut pending)
  if value != 30 { return 1 }
  if pending < 1 { return 2 }

  // A typed failure comes back as data.
  let failing = run Fiber<i32, Problem>.forkChild(later(-7))
  let failed = run awaitWhenFinished(move failing, &mut pending)
  if failed != -7 { return 3 }

  // A child parked on a timer is not finished until something ends it.
  let parked = run Fiber<i32, Problem>.forkChild(sleeper())
  run Fiber.yieldNow()
  if parked.isFinished() { return 4 }
  let interrupted = run parked.interrupt()
  if valueOf(move interrupted) != -100 { return 5 }
  return value + 12
}

effect fn program() -> i32
  ! OutOfMemoryError | TaskIdExhaustedError | Cancelled | StalledError {
  let mut clock = OsMonotonicClock.make()
  let mut scheduler = LocalScheduler.make()
  return run scheduler.execute<i32, OutOfMemoryError | TaskIdExhaustedError | Cancelled>(root())
    |> Effect.provideMut<MonotonicClock>(&mut clock)
}

effect fn failed<E>(error: E) -> i32 {
  drop error
  return 100
}

pub fn main() -> i32 {
  return run Effect.catchAll(program(), failed)
}
