import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.concurrency.sync { Arc }
import silk.concurrency.thread_native { NativeThread, SpawnError }
import silk.trace.record { Recorder, Config }
import silk.trace { Tracer, Trace }

import silk.core.option { Option }
import silk.trace.record { Span }
effect fn inside() -> () {
  let _inner = Trace.span("inner")
  Trace.event("from inner")
}
effect fn nested(second: &Arc<Recorder>) -> () {
  let _outer = Trace.span("outer")
  run inside() |> Effect.provideAmbient<Tracer>(second)
  Trace.event("from outer")
}
fn leftBranch() -> i32 { let _span = Trace.span("left branch") return 0 }
fn rightBranch() -> i32 { let _span = Trace.span("right branch") return 0 }
effect fn exercise() -> i32 ! SpawnError | OutOfMemoryError ? &mut Allocator {
  let first = run Arc<Recorder>.make(run Recorder.make(Config.make("first")))
  let second = run Arc<Recorder>.make(run Recorder.make(Config.make("second")))
  run nested(&second) |> Effect.provideAmbient<Tracer>(&first)
  let outer = match first.get().takeSpan() {
    Option<Span>.Some {value} => value
    Option<Span>.None => { return 1 }
  }
  let inner = match second.get().takeSpan() {
    Option<Span>.Some {value} => value
    Option<Span>.None => { return 2 }
  }
  if inner.name != "inner" || outer.name != "outer" { return 3 }
  if inner.parent.span != outer.context.span || inner.context.traceLow != outer.context.traceLow { return 4 }
  if inner.eventCount != 1 || outer.eventCount != 1 { return 5 }
  if first.get().takeSpan().isSome() || second.get().takeSpan().isSome() { return 6 }
  let left = run NativeThread.spawn(leftBranch) |> Effect.provideAmbient<Tracer>(&first)
  let right = run NativeThread.spawn(rightBranch) |> Effect.provideAmbient<Tracer>(&second)
  if left.join() != 0 || right.join() != 0 { return 7 }
  if let Option<Span>.Some {value} = first.get().takeSpan() {
    if value.name != "left branch" || value.parent.span != 0 { return 8 }
  } else { return 9 }
  if let Option<Span>.Some {value} = second.get().takeSpan() {
    if value.name != "right branch" || value.parent.span != 0 { return 10 }
  } else { return 11 }
  if first.get().takeSpan().isSome() || second.get().takeSpan().isSome() { return 12 }
  return 0
}
effect fn failed(error: SpawnError | OutOfMemoryError) -> i32 { return 4 }
pub fn main() -> i32 {
  let mut alloc = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(exercise() |> Effect.provideMut<Allocator>(&mut alloc), failed)
}
