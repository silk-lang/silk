import silk.core.reflect { Reflect }

struct Named { value: i32 }
tuple Pair(i32, i32)

fn weight<T>() -> i32 {
  static if Reflect.typeKind<T>(Reflect.typeOf<T>()) == Reflect.typeKind<Named>(Reflect.typeOf<Named>()) {
    return 40
  } else {
    return 2
  }
}

pub fn main() -> i32 {
  return weight<Named>() + weight<Pair>()
}