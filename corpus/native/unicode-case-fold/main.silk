// Full case folding must expand scalars, including capital sharp S through its lowercase mapping.
import silk.text.regex_unicode { UnicodeCase }

pub fn main() -> i32 {
  let sharp = UnicodeCase.fold(0x1e9e)
  let ligature = UnicodeCase.fold(0xfb03)
  let sigma = UnicodeCase.fold(0x3c2)
  let dotted = UnicodeCase.fold(0x130)
  let unchanged = UnicodeCase.fold(0x1f600)
  if sharp.length != 2 || sharp.points[0] != 115 || sharp.points[1] != 115 {
    return 1
  }
  if ligature.length != 3 || ligature.points[0] != 102 || ligature.points[1] != 102
    || ligature.points[2] != 105 {
    return 2
  }
  if sigma.length != 1 || sigma.points[0] != 0x3c3 {
    return 3
  }
  if dotted.length != 2 || dotted.points[0] != 105 || dotted.points[1] != 0x307 {
    return 4
  }
  if unchanged.length != 1 || unchanged.points[0] != 0x1f600 {
    return 5
  }
  return 0
}
