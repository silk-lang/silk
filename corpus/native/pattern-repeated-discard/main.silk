// Several `_` binders in one pattern discard their fields and never conflict with each other.
struct Triple {
  first: i32
  second: i32
  third: i32
}

union Shape {
  Point,
  Box { width: i32, height: i32, depth: i32 },
}

fn middle(triple: Triple) -> i32 {
  let Triple { first: _, second, third: _ } = move triple
  return second
}

fn depth(shape: Shape) -> i32 {
  return match move shape {
    Shape.Point => 0
    Shape.Box { width: _, height: _, depth } => depth
  }
}

fn last(shape: Shape) -> i32 {
  if let Shape.Box { width: _, height: _, depth: _ } = move shape {
    return 2
  }
  return 0
}

pub fn main() -> i32 {
  let triple = Triple { first: 1, second: 20, third: 2 }
  return middle(move triple) + depth(Shape.Box { width: 3, height: 4, depth: 20 }) + last(Shape.Box { width: 5, height: 6, depth: 7 })
}
