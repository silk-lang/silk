// The builtin test runner selects an assertion failure from any test's failure row by widening the
// row with `AssertionError` and catching that member, which reports its message; every other
// failure falls through to the generic handler.
import silk.core.effect { Effect }
import silk.testing.testing { AssertionError, Testing }

struct Other {}

effect fn mayAssert(value: ()) -> () ! AssertionError<'static> { return value }
effect fn succeeded(value: ()) -> i32 { return 0 }
effect fn asserted(error: AssertionError<'static>) -> i32 {
  if Testing.assertionMessage(&error) == "kept" { return 40 }
  return 10
}
effect<'env> fn otherwise<E: 'env, 'env>(error: E) -> i32 {
  drop error
  return 2
}

fn outcome<'env, E>(value: Effect<'env; () ! E>) -> i32 {
  let checked = Effect.flatMap(move value, mayAssert)
  let completed = Effect.flatMap(move checked, succeeded)
  let selected = Effect.catch<AssertionError<'static>>(move completed, asserted)
  return run Effect.catchAll(move selected, otherwise)
}

effect fn failsExpectation() -> () ! AssertionError<'static> | Other {
  run Testing.expect(false, "kept")
  return ()
}

effect fn failsOther() -> () ! Other { fail Other {} }

effect fn passes() -> () ! Other { return () }

pub fn main() -> i32 {
  return outcome(failsExpectation()) + outcome(failsOther()) + outcome(passes())
}
