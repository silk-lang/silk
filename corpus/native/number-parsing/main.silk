import silk.num.i8
import silk.num.i16
import silk.num.i32
import silk.num.i64
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.text.format { NotANumber, OutOfRange, ParseError }
import silk.core.result { Result }
import silk.num.usize

fn parsed<T>(result: Result<T, ParseError>) -> bool {
  return match move result {
    Result<T, ParseError>.Success { value } => true
    Result<T, ParseError>.Failure { error } => false
  }
}
fn outOfRange<T>(result: Result<T, ParseError>) -> bool {
  return match move result {
    Result<T, ParseError>.Success { value } => false
    Result<T, ParseError>.Failure { error } => match move error.reason {
      NotANumber { offset } => false
      OutOfRange nothing => true
    }
  }
}
fn notANumberAt<T>(result: Result<T, ParseError>, expected: usize) -> bool {
  return match move result {
    Result<T, ParseError>.Success { value } => false
    Result<T, ParseError>.Failure { error } => match move error.reason {
      NotANumber { offset } => offset == expected
      OutOfRange nothing => false
    }
  }
}
pub fn main() -> i32 {
  if !parsed<i8>(i8.parse("-128")) { return 1 }
  if !parsed<i8>(i8.parse("127")) { return 2 }
  if !outOfRange<i8>(i8.parse("128")) { return 3 }
  if !outOfRange<i8>(i8.parse("-129")) { return 4 }
  if !parsed<i16>(i16.parse("-32768")) { return 5 }
  if !parsed<i16>(i16.parse("32767")) { return 6 }
  if !outOfRange<i16>(i16.parse("32768")) { return 7 }
  if !outOfRange<i16>(i16.parse("-32769")) { return 8 }
  if !parsed<i32>(i32.parse("-2147483648")) { return 9 }
  if !parsed<i32>(i32.parse("2147483647")) { return 10 }
  if !outOfRange<i32>(i32.parse("2147483648")) { return 11 }
  if !outOfRange<i32>(i32.parse("-2147483649")) { return 12 }
  if !parsed<i64>(i64.parse("-9223372036854775808")) { return 13 }
  if !parsed<i64>(i64.parse("9223372036854775807")) { return 14 }
  if !outOfRange<i64>(i64.parse("9223372036854775808")) { return 15 }
  if !outOfRange<i64>(i64.parse("-9223372036854775809")) { return 16 }
  if !parsed<u8>(u8.parse("0")) { return 17 }
  if !parsed<u8>(u8.parse("255")) { return 18 }
  if !outOfRange<u8>(u8.parse("256")) { return 19 }
  if !notANumberAt<u8>(u8.parse("-1"), usize.ZERO) { return 20 }
  if !parsed<u16>(u16.parse("0")) { return 21 }
  if !parsed<u16>(u16.parse("65535")) { return 22 }
  if !outOfRange<u16>(u16.parse("65536")) { return 23 }
  if !notANumberAt<u16>(u16.parse("-1"), usize.ZERO) { return 24 }
  if !parsed<u32>(u32.parse("0")) { return 25 }
  if !parsed<u32>(u32.parse("4294967295")) { return 26 }
  if !outOfRange<u32>(u32.parse("4294967296")) { return 27 }
  if !notANumberAt<u32>(u32.parse("-1"), usize.ZERO) { return 28 }
  if !parsed<u64>(u64.parse("0")) { return 29 }
  if !parsed<u64>(u64.parse("18446744073709551615")) { return 30 }
  if !outOfRange<u64>(u64.parse("18446744073709551616")) { return 31 }
  if !notANumberAt<u64>(u64.parse("-1"), usize.ZERO) { return 32 }
  if !notANumberAt<u8>(u8.parse(""), usize.ZERO) { return 40 }
  if !notANumberAt<u8>(u8.parse("abc"), usize.ZERO) { return 41 }
  if !notANumberAt<u8>(u8.parse("12x"), 2) { return 42 }
  if !notANumberAt<u8>(u8.parse("1 2"), usize.ONE) { return 43 }
  if !notANumberAt<i32>(i32.parse("+1"), usize.ZERO) { return 44 }
  if !notANumberAt<i32>(i32.parse("-"), usize.ONE) { return 45 }
  if !notANumberAt<i32>(i32.parse("-x"), usize.ONE) { return 46 }
  if !parsed<u8>(u8.parse("007")) { return 47 }
  if !parsed<i32>(i32.parse("-0")) { return 48 }
  return 42
}