// A static interface operation answers a question about a type during static evaluation.
interface Arg {
  static fn takesValue() -> bool
}

struct Flag {}

struct Text {}

impl Arg for Flag {
  static fn takesValue() -> bool {
    return false
  }
}

impl Arg for Text {
  static fn takesValue() -> bool {
    return true
  }
}

static fn takes<T: Arg>() -> bool {
  return Arg.takesValue()
}

fn width<T: Arg>() -> i32 {
  static if takes<T>() {
    return 40
  } else {
    return 2
  }
}

pub fn main() -> i32 {
  return width<Text>() + width<Flag>()
}
