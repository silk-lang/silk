import silk.option { Option }
import silk.text.string { Split, String }
import silk.num.usize

// Search, split and trim on text with one-, two-, three- and four-byte scalars, with searches
// checked against a byte-by-byte answer at every length so vector and tail paths both run.
fn naiveFind(text: string, needle: string, last: bool) -> Option<usize> {
  let haystack = String.utf8Bytes(text)
  let wanted = String.utf8Bytes(needle)
  if wanted.length > haystack.length {
    return Option<usize>.none()
  }
  let mut found = Option<usize>.none()
  let mut at: usize = 0
  while at + wanted.length <= haystack.length {
    let mut offset: usize = 0
    while offset < wanted.length && haystack[at + offset] == wanted[offset] {
      offset = offset + 1
    }
    if offset == wanted.length {
      if !last {
        return Option<usize>.some(at)
      }
      found = Option<usize>.some(at)
    }
    at = at + 1
  }
  return move found
}

fn same(left: Option<usize>, right: Option<usize>) -> bool {
  return match move left {
    Option<usize>.Some { value: a } => match move right {
      Option<usize>.Some { value: b } => a == b
      Option<usize>.None => false
    }
    Option<usize>.None => match move right {
      Option<usize>.Some { value: b } => false
      Option<usize>.None => true
    }
  }
}

fn searches(text: string) -> i32 {
  let needles = ["é", "ab", "€x", "😀", "x", "aé€😀", "", "zz"]
  let mut index: usize = 0
  while index < 8 {
    let needle = needles[index]
    if !same(String.find(text, needle), naiveFind(text, needle, false)) {
      return 1
    }
    if !same(String.findLast(text, needle), naiveFind(text, needle, true)) {
      return 2
    }
    if String.contains(text, needle)
      != !same(naiveFind(text, needle, false), Option<usize>.none()) {
      return 3
    }
    index = index + 1
  }
  return 0
}

fn countPieces(text: string, separator: string) -> usize {
  let mut pieces = String.split(text, separator)
  let mut count: usize = 0
  while true {
    match Split.next(&mut pieces) {
      Option<string>.Some { value } => {
        count = count + 1
      }
      Option<string>.None => {
        break
      }
    }
  }
  return count
}

fn piece<'text>(text: string<'text>, separator: string, wanted: usize) -> string<'text> {
  let mut pieces = String.split(text, separator)
  let mut index: usize = 0
  while true {
    match Split.next(&mut pieces) {
      Option<string>.Some { value } => {
        if index == wanted {
          return value
        }
        index = index + 1
      }
      Option<string>.None => {
        break
      }
    }
  }
  return "missing"
}

pub fn main() -> i32 {
  // Lengths from 0 to 79 bytes cover no vector, one, several, and every tail.
  let unit = "aé€😀x"
  let full = "aé€😀xaé€😀xaé€😀xaé€😀xaé€😀xaé€😀xaé€😀xaé€😀xab"
  let mut end: usize = 0
  while end <= String.byteLength(full) {
    if String.isCharBoundary(full, end) {
      let result = searches(String.slice(full, 0, end))
      if result != 0 {
        return result
      }
    }
    end = end + 1
  }
  if (String.findLast("aaaa", "aa") |> Option<usize>.unwrapOr(9)) != 2 {
    return 4
  }
  if (String.findLast("abc", "") |> Option<usize>.unwrapOr(9)) != 3 {
    return 5
  }

  if !String.startsWith(unit, "aé") || String.startsWith(unit, "é")
    || !String.startsWith(unit, "") {
    return 10
  }
  if !String.endsWith(unit, "😀x") || String.endsWith("x", "xx") || !String.endsWith("", "") {
    return 11
  }
  if String.isCharBoundary(unit, 2) || !String.isCharBoundary(unit, 3)
    || String.isCharBoundary(unit, 99) {
    return 12
  }
  if String.slice(unit, 3, 3) != "€" || String.slice(unit, String.byteLength(unit), 0) != "" {
    return 13
  }

  if countPieces("a,,b,", ",") != 4 || countPieces("", ",") != 1 || countPieces("abc", "") != 1 {
    return 20
  }
  if piece("a,,b,", ",", 0) != "a" || piece("a,,b,", ",", 1) != ""
    || piece("a,,b,", ",", 2) != "b" {
    return 21
  }
  if piece("a,,b,", ",", 3) != "" || piece("a,,b,", ",", 4) != "missing" {
    return 22
  }
  if piece("x€€y€€z", "€€", 1) != "y" || piece("x€€y€€z", "€€", 2) != "z" {
    return 23
  }
  let mut parts = String.split("k=v=w", "=")
  let copy = parts
  if (Split.next(&mut parts) |> Option<string>.unwrapOr("")) != "k" {
    return 24
  }
  if (Split.remainder(&mut parts) |> Option<string>.unwrapOr("")) != "v=w" {
    return 25
  }
  if (Split.next(&mut parts) |> Option<string>.unwrapOr("end")) != "end" {
    return 26
  }
  if (Split.remainder(&mut parts) |> Option<string>.unwrapOr("end")) != "end" {
    return 27
  }

  // A copy made before reading starts again from the first piece.
  let mut again = copy
  if (Split.next(&mut again) |> Option<string>.unwrapOr("")) != "k" {
    return 28
  }

  if String.trim(" \t\n\u{a0}\u{3000}é x\u{2009}\r\n") != "é x" {
    return 30
  }
  if String.trim("\u{2028}\u{85}") != "" || String.trim("") != "" {
    return 31
  }

  // U+00A9 and U+2030 share lead bytes with whitespace and must stay.
  if String.trimStart("\u{a9} ") != "\u{a9} " || String.trimEnd(" \u{2030}") != " \u{2030}" {
    return 32
  }
  if String.trimStart("  a ") != "a " || String.trimEnd(" a  ") != " a" {
    return 33
  }
  return 0
}
