//! Static code reads the fields of a constant the way runtime code does.

struct Limits {
  pub low: i32,
  pub high: i32,
  pub name: string<'static>,
}

const LIMITS: Limits = Limits { low: 2, high: 9, name: "range" }

static fn span() -> i32 {
  return LIMITS.high - LIMITS.low
}

pub fn main() -> i32 {
  let static width = span()
  let static low = LIMITS.low
  static if LIMITS.name != "range" { compileError("name") }
  return width * 10 + low
}
