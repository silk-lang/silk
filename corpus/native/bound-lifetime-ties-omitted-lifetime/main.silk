struct Pair { pub first: i32, pub second: i32 }

struct Holder<T> { value: T }

struct View<'a> { pub first: &'a i32 }

struct Both<'a> { pub first: &'a mut i32, pub second: &'a mut i32 }

interface Lends<'s, T> {
  fn lend(source: &'s mut T) -> Self
}

impl<'a> Lends<'a, Pair> for View<'a> {
  fn lend(source: &'a mut Pair) -> View<'a> { return View { first: &source.first } }
}

impl<'a> Lends<'a, Pair> for Both<'a> {
  fn lend(source: &'a mut Pair) -> Both<'a> { return Both { first: &mut source.first, second: &mut source.second } }
}

impl<T> Holder<T> {
  // The bound gives the lifetime `<V>` omits at a call: the head of the conformance equates it
  // with `'s` (GEN-003).
  fn lend<'s, V: Lends<'s, T>>(self: &'s mut Self) -> V { return Lends.lend(&mut self.value) }
  fn touch(self: &mut Self) -> () { return () }
}

pub fn main() -> i32 {
  let mut holder = Holder<Pair> { value: Pair { first: 3, second: 4 } }
  let seen = holder.lend<View>()
  let total = seen.first.*
  holder.touch()
  let both = holder.lend<Both>()
  both.first.* = both.first.* + both.second.* + total
  holder.touch()
  return holder.value.first + 32
}
