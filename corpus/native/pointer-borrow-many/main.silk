import silk.core.option { Option }
import silk.mem.pointer { Pointer }

struct Inline {
  bytes: [u8; 4],
}

fn view<'a>(cell: &'a Inline) -> &'a [u8] {
  let first = match move Pointer.nonNullMany<u8>(Pointer.fromSlice<u8>(&cell.bytes)) {
    Option<[*]const u8>.Some { value } => value
    Option<[*]const u8>.None => Intrinsic.trap("an array is never at null")
  }
  unsafe { return Pointer.borrowMany<Inline, u8>(cell, first, 3) }
}

fn bump<'a>(cell: &'a mut Inline) -> &'a mut [u8] {
  let first = match move Pointer.nonNullManyMut<u8>(Pointer.fromMutSlice<u8>(&mut cell.bytes)) {
    Option<[*]mut u8>.Some { value } => value
    Option<[*]mut u8>.None => Intrinsic.trap("an array is never at null")
  }
  unsafe { return Pointer.borrowManyMut(&mut cell.*, first, 4) }
}

pub fn main() -> i32 {
  let mut cell = Inline { bytes: [1, 2, 3, 4] }
  let writable = bump(&mut cell)
  writable[3] = 40
  let bytes = view(&cell)
  if bytes.length != 3 || bytes[2] != 3 || cell.bytes[3] != 40 {
    return 1
  }
  return 0
}
