import silk.collections.column_list { ColumnList }
import silk.core.effect { Effect }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }

struct Point {
  pub x: f32,
  pub y: f32,
}

impl Copy for Point {}

struct Particle {
  pub position: Point,
  pub speed: f32,
  pub alive: bool,
  pub id: u64,
}

impl Copy for Particle {}

fn particle(id: u64, x: f32) -> Particle {
  return Particle { position: Point { x, y: 0.0 }, speed: 2.0, alive: true, id }
}

fn nudge(point: &mut Point, by: f32) -> () {
  point.x = point.x + by
  return ()
}

fn half(value: &f32) -> f32 {
  return value.* * 0.5
}

// A field of an indexed list is one place in that field's column (INDEX-002).
fn throughReference(particles: &mut ColumnList<Particle>) -> f32 {
  particles[1].speed = particles[1].speed + 1.0
  return particles[1].speed
}

fn readOnly(particles: &ColumnList<Particle>, index: usize) -> u64 {
  return particles[index].id
}

effect fn build() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let mut particles = ColumnList<Particle>.make()
  let mut id: u64 = 0
  let mut x: f32 = 0.0
  while id < 40 {
    run particles.append(particle(id, x))
    id = id + 1
    x = x + 1.0
  }

  // Reads, writes and a nested path. Only the first field goes to the list; `.x` is inside the
  // element of the `position` column.
  if particles[7].id != 7 || particles[7].position.x != 7.0 || !particles[7].alive { return 1 }
  particles[7].speed = 5.0
  particles[7].position.y = 3.0
  if particles[7].speed != 5.0 || particles[7].position.y != 3.0 || particles[7].position.x != 7.0 { return 2 }
  if particles[6].speed != 2.0 || particles[8].position.y != 0.0 { return 3 }

  // The replacement value reads the list, the same field included.
  particles[3].position.x = particles[3].position.x + particles[3].speed * 2.0
  if particles[3].position.x != 7.0 { return 4 }

  // A whole column element is a value and a place.
  let copied = particles[3].position
  if copied.x != 7.0 { return 5 }
  particles[4].position = Point { x: 1.5, y: 2.5 }
  if particles[4].position.y != 2.5 { return 6 }

  // Two fields of different rows, or of one row, are borrowed apart.
  let speed = &mut particles[0].speed
  let alive = &mut particles[1].alive
  let height = &mut particles[0].position.y
  let across = &particles[9].position.x
  speed.* = speed.* + across.*
  alive.* = false
  height.* = 4.0
  if particles[0].speed != 11.0 || particles[1].alive || particles[0].position.y != 4.0 { return 7 }

  // A borrowed field goes to a function as any reference does.
  nudge(&mut particles[2].position, 10.0)
  if particles[2].position.x != 12.0 { return 8 }
  if half(&particles[2].position.x) != 6.0 { return 9 }

  // Two columns written in one loop.
  let mut at: usize = 0
  while at < particles.length() {
    particles[at].position.x = particles[at].position.x + particles[at].speed
    particles[at].alive = particles[at].position.x < 20.0
    at = at + 1
  }
  if particles[10].position.x != 12.0 || !particles[10].alive || particles[30].alive { return 10 }

  // `Intrinsic.replace` swaps one field of one row.
  let old = Intrinsic.replace(particles[5].id, 500)
  if old != 5 || particles[5].id != 500 { return 11 }

  // A reference to the list reaches its rows.
  if throughReference(&mut particles) != 3.0 { return 12 }
  if readOnly(&particles, 39) != 39 { return 13 }

  // Whole rows stay explicit.
  let row = particles.get(7)
  if row.speed != 5.0 || row.id != 7 { return 14 }
  particles.set(7, particle(70, 0.0))
  if particles[7].id != 70 || particles[7].speed != 2.0 { return 15 }
  return 42
}

effect fn recover(error: OutOfMemoryError) -> i32 { return 99 }

pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(build() |> Effect.provideMut<Allocator>(&mut allocator), recover)
}
