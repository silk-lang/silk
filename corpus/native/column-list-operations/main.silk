import silk.collections.column_list { ColumnList, ColumnSort }
import silk.core.effect { Effect }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u32
import silk.core.option { Option }

struct Entry {
  pub key: u32,
  pub tag: u8,
  pub value: u64,
}

impl Copy for Entry {}

fn entry(key: u32) -> Entry {
  return Entry { key, tag: 1, value: 1000 + u32.toU64(key) }
}

// Whether the keys of `entries` are the digits of `keys`, in order, and each row kept its value.
fn holds(entries: &ColumnList<Entry>, keys: &[u32]) -> bool {
  if entries.length() != keys.length { return false }
  let mut at: usize = 0
  while at < keys.length {
    if entries[at].key != keys[at] || entries[at].value != 1000 + u32.toU64(keys[at]) { return false }
    at = at + 1
  }
  return true
}

effect fn build() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let mut entries = ColumnList<Entry>.make()
  let mut key: u32 = 0
  while key < 6 {
    run entries.append(entry(key))
    key = key + 1
  }
  if !holds(&entries, &[0, 1, 2, 3, 4, 5]) { return 1 }

  // insert, remove, swapRemove and pop move whole rows.
  run entries.insert(1, entry(9))
  if !holds(&entries, &[0, 9, 1, 2, 3, 4, 5]) { return 2 }
  if entries.remove(1).key != 9 || entries.swapRemove(0).key != 0 { return 3 }
  if !holds(&entries, &[5, 1, 2, 3, 4]) { return 4 }
  match entries.pop() {
    Option<Entry>.Some {value} => { if value.key != 4 { return 5 } }
    Option<Entry>.None => { return 6 }
  }

  // appendRepeated and insertRepeated fill rows with one value.
  run entries.appendRepeated(entry(7), 2)
  run entries.insertRepeated(1, entry(8), 3)
  run entries.insertRepeated(0, entry(6), 0)
  if !holds(&entries, &[5, 8, 8, 8, 1, 2, 3, 7, 7]) { return 7 }

  // removeRange closes the gap.
  entries.removeRange(1, 4)
  entries.removeRange(2, 2)
  if !holds(&entries, &[5, 1, 2, 3, 7, 7]) { return 8 }

  // appendSlice and insertSlice copy the rows of a handle of another list.
  let mut other = ColumnList<Entry>.make()
  run other.append(entry(20))
  run other.append(entry(21))
  run other.append(entry(22))
  run entries.appendSlice(other.rows())
  run entries.insertSlice(1, other.rows().range(1, 3))
  run entries.appendSlice(other.rows().range(0, 0))
  if !holds(&entries, &[5, 21, 22, 1, 2, 3, 7, 7, 20, 21, 22]) { return 9 }

  // moveRange copies a run of rows over another one. The runs can overlap in both directions.
  entries.moveRange(0, 2, 4)
  if !holds(&entries, &[5, 21, 5, 21, 22, 1, 7, 7, 20, 21, 22]) { return 10 }
  entries.moveRange(3, 1, 4)
  if !holds(&entries, &[5, 21, 22, 1, 7, 1, 7, 7, 20, 21, 22]) { return 11 }
  entries.moveRange(8, 0, 3)
  entries.moveRange(4, 4, 2)
  if !holds(&entries, &[20, 21, 22, 1, 7, 1, 7, 7, 20, 21, 22]) { return 12 }

  // splitOff moves the tail to a new list.
  let mut tail = run entries.splitOff(8)
  if !holds(&entries, &[20, 21, 22, 1, 7, 1, 7, 7]) || !holds(&tail, &[20, 21, 22]) { return 13 }
  if tail.capacity() != 3 { return 14 }
  let empty = run entries.splitOff(8)
  if empty.length() != 0 { return 15 }

  // sortBy orders every column by one key column and keeps equal keys in order.
  entries[4].tag = 2
  entries[6].tag = 3
  entries[7].tag = 4
  entries[3].tag = 5
  entries[5].tag = 6
  let mut scratch = ColumnSort.make()
  run entries.sortBy("key", &mut scratch)
  if !holds(&entries, &[1, 1, 7, 7, 7, 20, 21, 22]) { return 16 }
  if entries[0].tag != 5 || entries[1].tag != 6 || entries[2].tag != 2 || entries[3].tag != 3 || entries[4].tag != 4 { return 17 }
  // The same scratch sorts another list, by another column.
  run tail.append(entry(3))
  tail[0].tag = 9
  run tail.sortBy("tag", &mut scratch)
  if !holds(&tail, &[21, 22, 3, 20]) { return 18 }
  run tail.sortBy("value", &mut scratch)
  if !holds(&tail, &[3, 20, 21, 22]) { return 19 }

  // Capacity: reserveExact takes what it is asked for, and clearAndFree gives everything back.
  run tail.reserveExact(10)
  if tail.capacity() != 14 || !holds(&tail, &[3, 20, 21, 22]) { return 20 }
  run tail.reserveExact(2)
  if tail.capacity() != 14 { return 21 }
  run tail.reserve(40)
  if tail.capacity() < 44 { return 22 }
  if !tail.appendWithinCapacity(entry(30)) || tail.length() != 5 { return 23 }
  run tail.shrinkToFit()
  if tail.capacity() != 5 || tail.appendWithinCapacity(entry(31)) || !holds(&tail, &[3, 20, 21, 22, 30]) { return 24 }
  tail.truncate(2)
  tail.clearAndFree()
  if tail.length() != 0 || tail.capacity() != 0 { return 25 }
  run tail.append(entry(1))
  if !holds(&tail, &[1]) { return 26 }
  entries.clear()
  match entries.pop() {
    Option<Entry>.Some {..} => { return 27 }
    Option<Entry>.None => {}
  }
  let sized = run ColumnList<Entry>.makeWithCapacity(3)
  if sized.capacity() != 3 || sized.length() != 0 { return 28 }
  return 42
}

effect fn recover(error: OutOfMemoryError) -> i32 { return 99 }

pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(build() |> Effect.provideMut<Allocator>(&mut allocator), recover)
}
