import silk.build.manifest { Manifest, Package }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.schema.issue { SchemaError, IssueReason }
import silk.schema.toml { SchemaToml }

effect fn rejected(text: &[u8], path: string, reason: IssueReason) -> bool ! OutOfMemoryError ? &mut Allocator {
  return match move run Effect.result(SchemaToml.decode<Manifest>(text)) {
    Result<Manifest, SchemaError | OutOfMemoryError>.Success {..} => false
    Result<Manifest, SchemaError | OutOfMemoryError>.Failure {error} => match move error {
      SchemaError {path: found, issue, ..} => found.matchesText(path) && issue.reason == reason
      OutOfMemoryError {} => { fail OutOfMemoryError {} }
    }
  }
}

effect fn checks() -> i32 ! SchemaError | OutOfMemoryError ? &mut Allocator {
  let minimal = run SchemaToml.decode<Manifest>(b"[package]\nname = \"app\"\n[dependencies]\nlib = {path = \"../lib\", tools = true}\n[tool.example]\nopaque = 1979-05-27T07:32:00Z\n")
  if minimal.dependencies.entries().length != 1 || !minimal.dependencies.entries()[0].value.tools { return 1 }
  match &minimal.package {
    Option<Package>.Some {value} => {
      if value.source.view() != "src" || value.kind.view() != "executable" || value.version.view() != "0.0.0" || !value.publish { return 2 }
    }
    Option<Package>.None => { return 3 }
  }
  if !run rejected(b"[package]\nname = \"app\"\n[profiles.dev]\ndebug = true\n", "profiles", IssueReason.UnexpectedKey) { return 4 }
  if !run rejected(b"[package]\nname = \"app\"\n[dependencies]\nlib = {git = \"https://example.test/lib\"}\n", "dependencies.lib", IssueReason.CheckFailed) { return 5 }
  if !run rejected(b"[package]\nname = \"app\"\n[dependencies]\nlib = {workspace = false}\n", "dependencies.lib", IssueReason.CheckFailed) { return 6 }
  if !run rejected(b"[workspace]\nmembers = []\n[workspace.dependencies]\nlib = {workspace = true}\n", "workspace", IssueReason.CheckFailed) { return 7 }
  if !run rejected(b"[package]\nname = \"app\"\nversion = \"0.1\"\n", "package.version", IssueReason.CheckFailed) { return 8 }
  if !run rejected(b"[package]\nname = \"app\"\nkind = \"shared-library\"\n", "package.kind", IssueReason.CheckFailed) { return 9 }
  if !run rejected(b"[package]\nname = \"app\"\n[native]\nlink = []\n", "native.link", IssueReason.UnexpectedKey) { return 10 }
  let composed = run SchemaToml.decode<Manifest>(b"[package]\nname = \"app\"\n[component]\nwit = \"wit\"\nworld = \"app\"\n[unstable.composition]\nruntimes = [{name = \"custom\", module = \"runtime\"}]\ndefaults = [\"custom\"]\n")
  if !composed.component.isSome() || !composed.unstable.isSome() { return 11 }
  if !run rejected(b"[package]\nname = \"app\"\n[unstable.composition]\ndefaults = [\"missing\"]\n", "unstable.composition", IssueReason.CheckFailed) { return 12 }
  return 0
}

pub effect fn main() -> i32 ! SchemaError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checks() |> Effect.provideMut<Allocator>(&mut allocator)
}
