import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.option { Option }
import silk.order { Order, Ordering }
import silk.num.usize
import silk.collections.list { List }

struct Item { key: i32, tag: i32 }
fn itemCompare(left: &Item, right: &Item) -> Ordering {
  if left.key < right.key { return Ordering.Less }
  if right.key < left.key { return Ordering.Greater }
  return Ordering.Equal
}
impl Order for Item { compare: Item.itemCompare }

effect fn build() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut items = List<Item>.make()
  let a = run List<Item>.append(&mut items, Item { key: 1, tag: 1 }) |> Effect.provideMut(&mut allocator)
  let b = run List<Item>.append(&mut items, Item { key: 0, tag: 2 }) |> Effect.provideMut(&mut allocator)
  let c = run List<Item>.append(&mut items, Item { key: 1, tag: 3 }) |> Effect.provideMut(&mut allocator)
  let d = run List<Item>.append(&mut items, Item { key: 0, tag: 4 }) |> Effect.provideMut(&mut allocator)
  let ordered = run List<Item>.sort(&mut items) |> Effect.provideMut(&mut allocator)
  let view = List<Item>.asSlice(&items)
  let folded = view[usize.ZERO].tag * 1000 + view[usize.ONE].tag * 100
    + view[usize.ONE + usize.ONE].tag * 10 + view[usize.ONE + usize.ONE + usize.ONE].tag
  if folded != 2413 { return 1 }

  let mut numbers = List<i32>.make()
  let n0 = run List<i32>.append(&mut numbers, 9) |> Effect.provideMut(&mut allocator)
  let n1 = run List<i32>.append(&mut numbers, 2) |> Effect.provideMut(&mut allocator)
  let n2 = run List<i32>.append(&mut numbers, 7) |> Effect.provideMut(&mut allocator)
  let n3 = run List<i32>.append(&mut numbers, 2) |> Effect.provideMut(&mut allocator)
  let n4 = run List<i32>.append(&mut numbers, 5) |> Effect.provideMut(&mut allocator)
  let sorted = run List<i32>.sort(&mut numbers) |> Effect.provideMut(&mut allocator)
  let hit = List<i32>.binarySearch(&numbers, 7)
  let miss = List<i32>.binarySearch(&numbers, 4)
  let duplicate = List<i32>.binarySearch(&numbers, 2)
  let below = List<i32>.binarySearch(&numbers, -1)
  let above = List<i32>.binarySearch(&numbers, 10)
  let hitIndex = match move hit { Option<usize>.Some { value } => usize.toI32(value) _ => -1 }
  let missIndex = match move miss { Option<usize>.Some { value } => usize.toI32(value) _ => -1 }
  let duplicateIndex = match move duplicate { Option<usize>.Some { value } => usize.toI32(value) _ => -1 }
  if hitIndex != 3 { return 2 }
  if missIndex != -1 { return 3 }
  if duplicateIndex != 0 { return 4 }
  let belowIndex = match move below { Option<usize>.Some { value } => usize.toI32(value) _ => -1 }
  let aboveIndex = match move above { Option<usize>.Some { value } => usize.toI32(value) _ => -1 }
  if belowIndex != -1 || aboveIndex != -1 { return 6 }

  let mut already = List<i32>.make()
  let a0 = run List<i32>.append(&mut already, 1) |> Effect.provideMut(&mut allocator)
  let a1 = run List<i32>.append(&mut already, 2) |> Effect.provideMut(&mut allocator)
  let a2 = run List<i32>.append(&mut already, 3) |> Effect.provideMut(&mut allocator)
  let alreadySorted = run List<i32>.sort(&mut already) |> Effect.provideMut(&mut allocator)
  if List<i32>.get(&already, usize.ZERO) != 1 { return 7 }
  if List<i32>.get(&already, usize.ONE) != 2 { return 7 }
  if List<i32>.get(&already, usize.ONE + usize.ONE) != 3 { return 7 }

  let mut empty = List<i32>.make()
  let emptyMiss = List<i32>.binarySearch(&empty, 1)
  let emptySorted = run List<i32>.sort(&mut empty) |> Effect.provideMut(&mut allocator)
  let mut singleton = List<i32>.make()
  let one = run List<i32>.append(&mut singleton, 42) |> Effect.provideMut(&mut allocator)
  let singletonSorted = run List<i32>.sort(&mut singleton) |> Effect.provideMut(&mut allocator)
  if List<i32>.get(&singleton, usize.ZERO) != 42 { return 8 }
  return match move emptyMiss { Option<usize>.Some { value } => 5 _ => 42 }
}
effect fn recover(error: OutOfMemoryError) -> i32 { return 99 }
pub fn main() -> i32 { return run Effect.catchAll(build(), recover) }