const CASE_COUNT: usize = 10


struct Capture {
  bytes: [u8; 96],
  length: usize,
}

impl Writer for Capture {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> ()
    ! WriterError
    ? &mut Writer {
    let mut index: usize = 0
    while index < value.length {
      self.bytes[self.length] = value[index]
      self.length = self.length + 1
      index = index + 1
    }
    return ()
  }

  effect fn flush(self: &mut Self) -> ()
    ! WriterError
    ? &mut Writer {
    return ()
  }
}

fn holds(capture: &Capture, expected: string) -> bool {
  let bytes = String.utf8Bytes(expected)
  if capture.length != bytes.length {
    return false
  }
  let mut index: usize = 0
  while index < bytes.length {
    if capture.bytes[index] != bytes[index] {
      return false
    }
    index = index + 1
  }
  return true
}

fn fieldAt(line: string, wanted: usize) -> string {
  let bytes = String.utf8Bytes(line)
  let mut start: usize = 0
  let mut index: usize = 0
  let mut at: usize = 0
  while at <= bytes.length {
    if at == bytes.length || bytes[at] == 9 {
      if index == wanted {
        return String.slice(line, start, at - start)
      }
      index = index + 1
      start = at + 1
    }
    at = at + 1
  }
  return ""
}

fn number(text: string) -> i64 {
  let bytes = String.utf8Bytes(text)
  let mut value: i64 = 0
  let mut at: usize = 0
  let negative = bytes.length > 0 && bytes[0] == 45
  if negative {
    at = 1
  }
  while at < bytes.length {
    value = value * 10 + u8.toI64(bytes[at] - 48)
    at = at + 1
  }
  if negative {
    return -value
  }
  return value
}

// True if `Display` writes `expected` for `value`.
effect fn shows<T: Display>(value: &T, expected: string) -> bool
  ! WriterError {
  let mut capture = Capture { bytes: [0; 96], length: 0 }
  run Format.display<T>(value) |> Effect.provideMut<Writer>(&mut capture)
  return holds(&capture, expected)
}

// True if `Debug` writes `expected` for `value`.
effect fn named<T: Debug>(value: &T, expected: string) -> bool
  ! WriterError {
  let mut capture = Capture { bytes: [0; 96], length: 0 }
  run Format.debug<T>(value) |> Effect.provideMut<Writer>(&mut capture)
  return holds(&capture, expected)
}

fn isAt(found: Option<Instant>, expected: string) -> bool {
  return match found {
    Option<Instant>.Some { value } => expected != "-" && value.unixSeconds() == number(expected)
    Option<Instant>.None => expected == "-"
  }
}

fn localTime(text: string) -> PlainDateTime {
  return Instant.fromUnixSeconds(number(text)).toOffset(UtcOffset.utc())
}

fn choiceOf(text: string) -> Disambiguation {
  if text == "e" {
    return Disambiguation.Earlier
  }
  if text == "l" {
    return Disambiguation.Later
  }
  if text == "r" {
    return Disambiguation.Reject
  }
  return Disambiguation.Compatible
}

fn conflictOf(text: string) -> OffsetConflict {
  if text == "u" {
    return OffsetConflict.Use
  }
  if text == "i" {
    return OffsetConflict.Ignore
  }
  if text == "p" {
    return OffsetConflict.Prefer
  }
  return OffsetConflict.Reject
}

fn checkOffset(zone: &Zone, line: string) -> bool {
  let at = Instant.fromUnixSeconds(number(fieldAt(line, 2)))
  return i32.toI64(zone.offsetAt(at).totalSeconds()) == number(fieldAt(line, 3))
    && zone.isDaylightAt(at) == (fieldAt(line, 4) == "1")
    && zone.abbreviationAt(at) == fieldAt(line, 5)
}

fn checkChanges(zone: &Zone, line: string) -> bool {
  let at = Instant.fromUnixSeconds(number(fieldAt(line, 2)))
  return isAt(zone.nextTransition(at), fieldAt(line, 3)) && isAt(zone.previousTransition(at), fieldAt(line, 4))
}

fn checkCandidates(zone: &Zone, line: string) -> bool {
  let found = zone.candidates(localTime(fieldAt(line, 2)))
  let count = number(fieldAt(line, 3))
  if u8.toI64(found.count) != count || found.skipped != (fieldAt(line, 6) == "1") {
    return false
  }
  if count > 0 {
    return found.earlier.unixSeconds() == number(fieldAt(line, 4))
      && found.later.unixSeconds() == number(fieldAt(line, 5))
  }
  // The offsets on the two sides of the skip place the time on each side of it.
  let skip = number(fieldAt(line, 7))
  return found.transition.unixSeconds() == skip
    && &zone.offsetAt(Instant.fromUnixSeconds(skip - 1)) == &found.before
    && &zone.offsetAt(found.transition) == &found.after
}

effect fn checkResolve(zone: &Zone, line: string) -> bool
  ! WriterError {
  let expected = fieldAt(line, 4)
  return match zone.resolve(localTime(fieldAt(line, 2)), choiceOf(fieldAt(line, 3))) {
    Result<Instant, LocalTimeError>.Success { value } => expected != "Skipped" && expected != "Repeated" && value.unixSeconds() == number(expected)
    Result<Instant, LocalTimeError>.Failure { error } => run named(&error, expected)
  }
}

fn checkStartOfDay(zone: &Zone, line: string) -> bool {
  return match PlainDate.fromEpochDays(number(fieldAt(line, 2))) {
    Option<PlainDate>.Some { value } => isAt(zone.startOfDay(value), fieldAt(line, 3))
    Option<PlainDate>.None => false
  }
}

// The text of an instant in a zone, and the same instant back from that text.
effect fn checkText(zone: &Zone, line: string) -> bool
  ! WriterError {
  let at = Instant.make(number(fieldAt(line, 2)), number(fieldAt(line, 3)))
  let text = fieldAt(line, 4)
  let seen = ZonedDateTime.make(at, zone)
  if !(run shows(&seen, text)) {
    return false
  }
  let parsed = match ZonedText.parse(text) {
    Result<ZonedText, TimeParseError>.Success { value } => value
    Result<ZonedText, TimeParseError>.Failure { .. } => {
      return false
    }
  }
  if parsed.zoneName() != zone.name() {
    return false
  }
  return match ZonedDateTime.fromText(&parsed, zone, OffsetConflict.Reject, Disambiguation.Reject) {
    Result<ZonedDateTime, LocalTimeError>.Success { value } => &value == &seen && &value.instant() == &at
    Result<ZonedDateTime, LocalTimeError>.Failure { .. } => false
  }
}

effect fn checkRule(line: string) -> bool
  ! ZoneDataError | OutOfMemoryError
  ? &mut Allocator {
  let zone = run Zone.fromPosixRule(fieldAt(line, 1))
  let at = Instant.fromUnixSeconds(number(fieldAt(line, 2)))
  return i32.toI64(zone.offsetAt(at).totalSeconds()) == number(fieldAt(line, 3))
    && zone.abbreviationAt(at) == fieldAt(line, 4)
    && zone.name() == fieldAt(line, 1)
}

effect fn checkRead(zone: &Zone, line: string) -> bool
  ! WriterError {
  let parsed = match ZonedText.parse(fieldAt(line, 2)) {
    Result<ZonedText, TimeParseError>.Success { value } => value
    Result<ZonedText, TimeParseError>.Failure { .. } => {
      return false
    }
  }
  if !TimeZones.sameName(String.utf8Bytes(parsed.zoneName()), String.utf8Bytes(zone.name())) {
    return false
  }
  let expected = fieldAt(line, 5)
  return match ZonedDateTime.fromText(&parsed, zone, conflictOf(fieldAt(line, 3)), choiceOf(fieldAt(line, 4))) {
    Result<ZonedDateTime, LocalTimeError>.Success { value } => run shows(&value, expected)
    Result<ZonedDateTime, LocalTimeError>.Failure { error } => run named(&error, expected)
  }
}

effect fn checkReject(line: string) -> bool
  ! WriterError {
  return match ZonedText.parse(fieldAt(line, 1)) {
    Result<ZonedText, TimeParseError>.Success { .. } => false
    Result<ZonedText, TimeParseError>.Failure { error } => (run named(&error.reason, fieldAt(line, 2)))
      && usize.toI64(error.offset) == number(fieldAt(line, 3))
  }
}

effect fn checkRows(zones: &[Zone]) -> usize
  ! ZoneDataError | OutOfMemoryError | WriterError
  ? &mut Allocator | &mut Writer {
  let table = rows()
  let mut failures: usize = 0
  let mut index: usize = 0
  while index < table.length {
    let line = table[index]
    let kind = fieldAt(line, 0)
    let mut passed = false
    if kind == "q" {
      passed = run checkRule(line)
    } else if kind == "e" {
      passed = run checkReject(line)
    } else {
      let zone = &zones[i64.toUsize(number(fieldAt(line, 1)))]
      if kind == "o" {
        passed = checkOffset(zone, line)
      } else if kind == "n" {
        passed = checkChanges(zone, line)
      } else if kind == "l" {
        passed = checkCandidates(zone, line)
      } else if kind == "r" {
        passed = run checkResolve(zone, line)
      } else if kind == "s" {
        passed = checkStartOfDay(zone, line)
      } else if kind == "z" {
        passed = run checkText(zone, line)
      } else if kind == "t" {
        passed = run checkRead(zone, line)
      }
    }
    if !passed {
      failures = failures + 1
      run Format.format("FAIL {}\n", &.(line))
    }
    index = index + 1
  }
  run Format.format("{} rows, {} failures\n", &(table.length, failures))
  return failures
}

// The reason for which `data` is not a zone, or `-` if it is one.
effect fn dataFails(data: &[u8], reason: string) -> bool
  ! OutOfMemoryError | WriterError
  ? &mut Allocator {
  let made = run Effect.result(Zone.fromTzif("Test/Case", data))
  return match move made {
    Result<Zone, ZoneDataError | OutOfMemoryError>.Success { .. } => false
    Result<Zone, ZoneDataError | OutOfMemoryError>.Failure { error } => match move error {
      ZoneDataError found => run named(&found.reason, reason)
      OutOfMemoryError _ => false
    }
  }
}

effect fn ruleFails(rule: string) -> bool
  ! OutOfMemoryError | WriterError
  ? &mut Allocator {
  let made = run Effect.result(Zone.fromPosixRule(rule))
  return match move made {
    Result<Zone, ZoneDataError | OutOfMemoryError>.Success { .. } => false
    Result<Zone, ZoneDataError | OutOfMemoryError>.Failure { error } => match move error {
      ZoneDataError found => run named(&found.reason, "InvalidRule")
      OutOfMemoryError _ => false
    }
  }
}

// Hand-built files: what the two valid ones answer, and the reason of each bad one.
effect fn checkData() -> usize
  ! ZoneDataError | OutOfMemoryError | WriterError
  ? &mut Allocator {
  let mut failures: usize = 0
  let change = Instant.fromUnixSeconds(1000000000)
  // Version 1 has no rule: the last offset holds forever.
  let old = run Zone.fromTzif("Test/Old", caseData(0))
  if old.offsetAt(Instant.fromUnixSeconds(999999999)).totalSeconds() != 3600
    || old.offsetAt(change).totalSeconds() != 7200
    || old.abbreviationAt(Instant.fromUnixSeconds(4000000000)) != "CEST"
    || !old.isDaylightAt(change)
    || old.abbreviationAt(Instant.fromUnixSeconds(0)) != "CET"
    || !isAt(old.nextTransition(Instant.fromUnixSeconds(0)), "1000000000")
    || !isAt(old.nextTransition(change), "-")
    || !isAt(old.previousTransition(change), "-")
    || !isAt(old.previousTransition(Instant.fromUnixSeconds(1000000001)), "1000000000")
    || old.name() != "Test/Old" {
    failures = failures + 1
  }
  // Version 2 goes on with its rule: 2001-09-09 is in summer, and winter comes on 2001-10-28.
  let ruled = run Zone.fromTzif("Test/Ruled", caseData(1))
  if ruled.offsetAt(change).totalSeconds() != 7200
    || !isAt(ruled.nextTransition(change), "1004230800")
    || ruled.abbreviationAt(Instant.fromUnixSeconds(1004230800)) != "CET"
    || ruled.offsetAt(Instant.fromUnixSeconds(4102444800)).totalSeconds() != 3600 {
    failures = failures + 1
  }
  let mut index: usize = 2
  while index < CASE_COUNT {
    if !(run dataFails(caseData(index), caseReason(index))) {
      failures = failures + 1
    }
    index = index + 1
  }
  let rules: [string<'static>; 12] = [
    "",
    "ES5",
    "5",
    "EST",
    "EST5EDT",
    "EST5EDT,M3.2.0",
    "EST5EDT,M13.1.0,M11.1.0",
    "EST5EDT,M3.6.0,M11.1.0",
    "EST5EDT,M3.2.7,M11.1.0",
    "EST5EDT,J0,J365",
    "EST5EDT,M3.2.0,M11.1.0/168",
    "EST25",
  ]
  let mut rule: usize = 0
  while rule < rules.length {
    if !(run ruleFails(rules[rule])) {
      failures = failures + 1
    }
    rule = rule + 1
  }
  // Zones that need no data.
  let utc = Zone.utc()
  let fixed = Zone.fixed(UtcOffset.fromSeconds(-12345))
  let anywhere = Instant.fromUnixSeconds(1795109782)
  if utc.name() != "UTC" || utc.abbreviationAt(anywhere) != "UTC" || utc.offsetAt(anywhere).totalSeconds() != 0
    || fixed.name() != "-03:25:45" || fixed.offsetAt(anywhere).totalSeconds() != -12345
    || fixed.isDaylightAt(anywhere) || !isAt(fixed.nextTransition(anywhere), "-")
    || !isAt(fixed.previousTransition(anywhere), "-")
    || fixed.candidates(localTime("0")).count != 1 {
    failures = failures + 1
  }
  return failures
}

effect fn lookupFails(name: string, reason: string) -> bool
  ! OutOfMemoryError | WriterError
  ? &mut TimeZones | &mut Allocator {
  let found = run Effect.result(TimeZones.zone(name))
  return match move found {
    Result<Zone, ZoneLookupError | OutOfMemoryError>.Success { .. } => false
    Result<Zone, ZoneLookupError | OutOfMemoryError>.Failure { error } => match move error {
      ZoneLookupError failure => run named(&failure.reason, reason)
      OutOfMemoryError _ => false
    }
  }
}

// The services, with the providers that hold their data in memory.
effect fn checkServices() -> usize
  ! ZoneLookupError | NoLocalZoneError | OutOfMemoryError | WriterError
  ? &mut TimeZones | &mut LocalZone | &mut Allocator | &mut Writer {
  let mut failures: usize = 0
  let here = run LocalZone.name()
  let zone = run TimeZones.zoneBytes(Bytes.asSlice(&here))
  let at = Instant.make(1795109782, 250000000)
  let seen = ZonedDateTime.make(at, &zone)
  let rule = run TimeZones.zone("test/eastern")
  let east = seen.withZone(&rule)
  let offset = run TimeZones.zone("+05:45")
  let utc = run TimeZones.zone("utc")
  let later = seen + Duration.fromHours(24 * 120)
  run Format.format(
    "{} {} {} {} {}\n{} {} {} {:?} {}\n",
    &(
      seen,
      seen.abbreviation(),
      seen.isDaylight(),
      east,
      east.abbreviation(),
      seen.withZone(&offset),
      seen.withZone(&utc),
      later,
      later - seen,
      later.toPlainDateTime(),
    ),
  )
  // Values are equal only with the same zone.
  if &seen == &east || &seen != &seen.withZone(&zone) || &east.since(seen) != &Duration.zero() || &east.instant() != &at || zone.name() != "America/Sao_Paulo" || rule.name() != "Test/Eastern" {
    failures = failures + 1
  }
  let names = run TimeZones.names()
  let all = List<Bytes>.asSlice(&names)
  let version = run TimeZones.version()
  if all.length != 3
    || Bytes.asSlice(&all[0]) != b"America/Sao_Paulo"
    || Bytes.asSlice(&all[1]) != b"Europe/Dublin"
    || Bytes.asSlice(&all[2]) != b"Test/Eastern"
    || Bytes.asSlice(&version) != b"2026e" {
    failures = failures + 1
  }
  if !(run lookupFails("Mars/Olympus", "UnknownZone"))
    || !(run lookupFails("../etc/passwd", "InvalidName"))
    || !(run lookupFails("", "InvalidName"))
    || !(run lookupFails("+25:00", "InvalidName")) {
    failures = failures + 1
  }
  if !TimeZones.isValidName(b"America/Argentina/ComodRivadavia")
    || !TimeZones.isValidName(b"Etc/GMT+5")
    || TimeZones.isValidName(b"America//Sao_Paulo")
    || TimeZones.isValidName(b"/America")
    || TimeZones.isValidName(b"America/")
    || TimeZones.isValidName(b"America/./Sao_Paulo")
    || TimeZones.isValidName(b"America/Sao Paulo")
    || !TimeZones.sameName(b"america/sao_paulo", b"America/Sao_Paulo")
    || TimeZones.sameName(b"America/Sao_Paulo", b"America/Sao-Paulo") {
    failures = failures + 1
  }
  return failures
}

effect fn program() -> i32
  ! ZoneDataError | ZoneLookupError | NoLocalZoneError | OutOfMemoryError | WriterError
  ? &mut Allocator | &mut Writer {
  let mut zones = List<Zone>.make()
  let mut index: usize = 0
  while index < 8 {
    run zones.append(run Zone.fromTzif(fixtureName(index), fixture(index)))
    index = index + 1
  }
  let rowFailures = run checkRows(List<Zone>.asSlice(&zones))
  let dataFailures = run checkData()
  let mut known = FixedTimeZones.make()
  run known.addTzif(fixtureName(2), fixture(2))
  run known.addPosixRule("Test/Eastern", "EST5EDT,M3.2.0,M11.1.0")
  run known.addTzif(fixtureName(0), fixture(0))
  run known.setVersion("2026e")
  let mut here = run FixedLocalZone.make("america/sao_paulo")
  let serviceFailures = run checkServices()
    |> Effect.provideMut<TimeZones>(&mut known)
    |> Effect.provideMut<LocalZone>(&mut here)
  run Format.format("{} data failures, {} service failures\n", &(dataFailures, serviceFailures))
  if rowFailures + dataFailures + serviceFailures > 0 {
    return 1
  }
  return 0
}

effect fn failed(
  error: ZoneDataError | ZoneLookupError | NoLocalZoneError | OutOfMemoryError | WriterError
) -> i32 {
  return match move error {
    ZoneDataError _ => 3
    ZoneLookupError _ => 4
    NoLocalZoneError _ => 5
    OutOfMemoryError _ => 6
    WriterError _ => 7
  }
}

pub effect fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut out = StdoutWriter.make()
  return run Effect.catchAll(program(), failed)
    |> Effect.provideMut<Writer>(&mut out)
    |> Effect.provideMut<Allocator>(&mut allocator)
}
