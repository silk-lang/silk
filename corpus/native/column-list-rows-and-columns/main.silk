import silk.collections.column_list { ColumnList, ColumnView }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }

struct Particle {
  pub x: f32,
  pub alive: bool,
  pub id: u64,
  pub speed: f32,
}

impl Copy for Particle {}

// Reads two columns.
struct Moving<'a> {
  pub x: &'a [f32],
  pub speed: &'a [f32],
}

impl<'a> ColumnView<'a, Particle> for Moving<'a> {}

// Writes one column while it reads two others.
struct Step<'a> {
  pub x: &'a mut [f32],
  pub speed: &'a [f32],
  pub alive: &'a mut [bool],
}

impl<'a> ColumnView<'a, Particle> for Step<'a> {}

fn advance(step: Step<'_>, seconds: f32) -> () {
  let mut at: usize = 0
  while at < step.x.length {
    step.x[at] = step.x[at] + step.speed[at] * seconds
    step.alive[at] = step.x[at] < 10.0
    at = at + 1
  }
  return ()
}

fn particle(id: u64, x: f32) -> Particle {
  return Particle { x, alive: true, id, speed: 2.0 }
}

effect fn build() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let mut particles = ColumnList<Particle>.make()
  if particles.length() != 0 || particles.capacity() != 0 { return 1 }
  if particles.column("id").length != 0 { return 2 }

  // Rows survive four growths, and each column holds its own field in row order.
  let mut id: u64 = 0
  let mut x: f32 = 0.0
  while id < 40 {
    run particles.append(particle(id, x))
    id = id + 1
    x = x + 1.0
  }
  if particles.length() != 40 || particles.capacity() != 64 { return 3 }
  let ids = particles.column("id")
  let xs = particles.column("x")
  let mut at: usize = 0
  id = 0
  x = 0.0
  while at < 40 {
    if ids[at] != id || xs[at] != x { return 4 }
    at = at + 1
    id = id + 1
    x = x + 1.0
  }
  let seventh = particles.get(7)
  if seventh.id != 7 || seventh.x != 7.0 || !seventh.alive || seventh.speed != 2.0 { return 5 }

  // One column changes in place; the others stay.
  let speeds = particles.columnMut("speed")
  speeds[3] = 5.0
  if particles.get(3).speed != 5.0 || particles.get(3).id != 3 || particles.get(4).speed != 2.0 { return 6 }

  // A shared view and a view that writes.
  let moving = particles.columns<Moving>()
  if moving.x[3] + moving.speed[3] != 8.0 { return 7 }
  let step = particles.columnsMut<Step>()
  advance(move step, 2.0)
  if particles.get(3).x != 13.0 || particles.get(3).alive { return 8 }
  if particles.get(2).x != 6.0 || !particles.get(2).alive { return 9 }
  if particles.get(3).id != 3 || particles.get(39).id != 39 { return 10 }

  // set, insert, remove, swapRemove and pop move whole rows.
  particles.set(0, Particle { x: 0.5, alive: false, id: 100, speed: 0.25 })
  if particles.get(0).id != 100 || particles.get(1).id != 1 { return 11 }
  run particles.insert(1, particle(200, 0.0))
  if particles.length() != 41 || particles.get(1).id != 200 || particles.get(2).id != 1 || particles.get(40).id != 39 { return 12 }
  run particles.insert(41, particle(300, 0.0))
  if particles.get(41).id != 300 { return 13 }
  let removed = particles.remove(1)
  if removed.id != 200 || particles.get(1).id != 1 || particles.get(40).id != 300 || particles.length() != 41 { return 14 }
  let swapped = particles.swapRemove(0)
  if swapped.id != 100 || particles.get(0).id != 300 || particles.length() != 40 { return 15 }
  let last = particles.swapRemove(39)
  if last.id != 39 || particles.length() != 39 { return 16 }
  match particles.pop() {
    Option<Particle>.Some {value} => { if value.id != 38 { return 17 } }
    Option<Particle>.None => { return 18 }
  }

  // Capacity changes keep the rows.
  particles.truncate(100)
  if particles.length() != 38 { return 19 }
  particles.truncate(5)
  run particles.shrinkToFit()
  if particles.length() != 5 || particles.capacity() != 5 || particles.get(4).id != 4 { return 20 }
  run particles.reserve(3)
  if particles.capacity() < 8 || particles.get(0).id != 300 || particles.get(4).id != 4 { return 21 }
  particles.clear()
  if particles.length() != 0 { return 22 }
  match particles.pop() {
    Option<Particle>.Some {..} => { return 23 }
    Option<Particle>.None => {}
  }
  run particles.shrinkToFit()
  if particles.capacity() != 0 { return 24 }

  let mut sized = run ColumnList<Particle>.makeWithCapacity(3)
  if sized.capacity() != 3 || sized.length() != 0 { return 25 }
  run sized.append(particle(9, 0.0))
  if sized.capacity() != 3 || sized.column("id")[0] != 9 { return 26 }
  return 42
}

effect fn recover(error: OutOfMemoryError) -> i32 { return 99 }

pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(build() |> Effect.provideMut<Allocator>(&mut allocator), recover)
}
