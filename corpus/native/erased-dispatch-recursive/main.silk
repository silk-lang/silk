import silk.core.effect { Effect }

interface Countdown { effect fn count(self: &Self, n: i32) -> i32 }
struct Counter {}
impl Countdown for Counter {
  effect fn count(self: &Self, n: i32) -> i32 {
    if n == 0 { return 42 }
    let counter: &any Countdown = self
    return run Effect.suspend(counter.count(n - 1))
  }
}

pub effect fn main() -> i32 {
  let counter = Counter {}
  let initial: &any Countdown = &counter
  return run initial.count(5)
}
