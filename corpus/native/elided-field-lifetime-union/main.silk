// A union whose variant field elides its `string` lifetime gains that lifetime as a hidden
// parameter, as a struct does, so its variants construct and match without written arguments.
import silk.text.string { String }
import silk.num.usize

union Command {
  List,
  Add { title: string },
}

fn weight(command: &Command) -> usize {
  return match &command.* {
    Command.List => 1
    Command.Add { title } => String.byteLength(title)
  }
}

pub fn main() -> i32 {
  let list = Command.List
  let add = Command.Add { title: "buy milk" }
  return usize.toI32(weight(&list) + weight(&add)) + 33
}
