import silk.simd.cpu { CpuFeatures }
import silk.core.target { Arch, Target }

pub fn main() -> i32 {
  let machine = CpuFeatures.detect()
  let build = CpuFeatures.selected()
  if !CpuFeatures.containsAll(&machine, &build) {
    return 1
  }
  if !CpuFeatures.containsAll(&machine, &machine) {
    return 2
  }
  if CpuFeatures.has(&machine, "no-such-feature") || CpuFeatures.has(&machine, "") {
    return 3
  }
  static if Target.arch() == Arch.X86_64 {
    if !CpuFeatures.has(&build, "sse2") || !CpuFeatures.has(&machine, "sse2") {
      return 4
    }
    if CpuFeatures.has(&machine, "neon") || CpuFeatures.has(&machine, "simd128") {
      return 5
    }
    // AVX2 implies AVX on every machine that reports it.
    if CpuFeatures.has(&machine, "avx2") && !CpuFeatures.has(&machine, "avx") {
      return 6
    }
  }
  static if Target.arch() == Arch.Aarch64 {
    if !CpuFeatures.has(&machine, "neon") || CpuFeatures.has(&machine, "sse2") {
      return 7
    }
  }
  static if Target.arch() == Arch.Wasm32 {
    if CpuFeatures.has(&machine, "simd128") != Target.hasCpuFeature("simd128") {
      return 8
    }
  }
  return 0
}
