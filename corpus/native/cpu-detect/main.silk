import silk.simd.cpu { CpuFeatures }
import silk.core.target { Arch, Target }

pub fn main() -> i32 {
  let machine = CpuFeatures.machine()
  let build = CpuFeatures.selected()
  // The cached set is the set the machine reports when asked again.
  let asked = CpuFeatures.detect()
  if !CpuFeatures.containsAll(&machine, &asked) || !CpuFeatures.containsAll(&asked, &machine) {
    return 9
  }
  let again = CpuFeatures.machine()
  if !CpuFeatures.containsAll(&again, &machine) || !CpuFeatures.containsAll(&machine, &again) {
    return 10
  }
  if CpuFeatures.available("no-such-feature") {
    return 11
  }
  if !CpuFeatures.containsAll(&machine, &build) {
    return 1
  }
  if !CpuFeatures.containsAll(&machine, &machine) {
    return 2
  }
  if CpuFeatures.has(&machine, "no-such-feature") || CpuFeatures.has(&machine, "") {
    return 3
  }
  static if Target.arch() == Arch.X86_64 {
    if !CpuFeatures.has(&build, "sse2") || !CpuFeatures.has(&machine, "sse2") {
      return 4
    }
    if CpuFeatures.has(&machine, "neon") || CpuFeatures.has(&machine, "simd128") {
      return 5
    }
    if !CpuFeatures.available("sse2") || CpuFeatures.available("neon") {
      return 12
    }
    if CpuFeatures.available("avx2") != CpuFeatures.has(&machine, "avx2") || CpuFeatures.available("aes") != CpuFeatures.has(&machine, "aes") {
      return 13
    }
    // AVX2 implies AVX on every machine that reports it.
    if CpuFeatures.has(&machine, "avx2") && !CpuFeatures.has(&machine, "avx") {
      return 6
    }
  }
  static if Target.arch() == Arch.Aarch64 {
    if !CpuFeatures.has(&machine, "neon") || CpuFeatures.has(&machine, "sse2") {
      return 7
    }
    if !CpuFeatures.available("neon") || CpuFeatures.available("aes") != CpuFeatures.has(&machine, "aes") {
      return 14
    }
  }
  static if Target.arch() == Arch.Wasm32 {
    if CpuFeatures.has(&machine, "simd128") != Target.hasCpuFeature("simd128") || CpuFeatures.available("simd128") != Target.hasCpuFeature("simd128") {
      return 8
    }
  }
  return 0
}
