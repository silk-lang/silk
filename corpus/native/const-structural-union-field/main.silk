//! A constant's structural union field holds one member under that member's tag, whether the
//! constant is borrowed (its static image) or copied (built in place).

union Shape {
  Dot,
  Square { side: i32 },
}

struct Slot {
  held: Shape | i32 | bool,
}

const SQUARE: Slot = Slot { held: Shape.Square { side: 7 } }
const NUMBER: Slot = Slot { held: 20 }
const FLAG: Slot = Slot { held: true }

fn weigh(slot: &Slot) -> i32 {
  return match &slot.held {
    Shape shape => match &shape {
      Shape.Dot => 1
      Shape.Square { side } => side
    }
    i32 number => number
    bool flag => if flag { 3 } else { 0 }
  }
}

// The callee owns its parameter, so writing it must not reach the constant's image.
fn retag(mut slot: Slot) -> i32 {
  slot.held = false
  return weigh(&slot)
}

pub fn main() -> i32 {
  let mut copied = NUMBER
  copied.held = 20
  let mut index = 0
  while index < 2 {
    if retag(NUMBER) != 0 { return 1 }
    index = index + 1
  }
  // 7 + 20 + 3 + 7 + 20 - 15 = 42
  return weigh(&SQUARE) + weigh(&NUMBER) + weigh(&FLAG) + weigh(&SQUARE) + weigh(&copied) - 15
}
