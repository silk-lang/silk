import silk.core.option {Option}
import silk.mem.pointer {Pointer}

struct Missing { code: i32 }
struct Header { tag: i32 }
type Slot = *mut i32

// A raw pointer is a Copy address, so it is an ordinary structural union member.
fn find(values: &mut [i32; 3], at: usize) -> Slot | Missing {
  if at >= 3 { return Missing { code: 7 } }
  return Pointer.fromMutRef<i32>(&mut values[at])
}

fn nullable(values: &mut [i32; 3], at: usize) -> Missing | ?*mut i32 {
  if at == 0 { return Missing { code: 1 } }
  if at == 1 { return Pointer.null<i32>() }
  let slot: ?*mut i32 = Pointer.fromMutRef<i32>(&mut values[at])
  return slot
}

fn load(slot: *mut i32) -> i32 {
  let mut value = 0
  unsafe { value = Pointer.read<i32>(slot) }
  return value
}

fn read(found: Slot | Missing) -> i32 {
  return match move found {
    *mut i32 slot => load(slot)
    Missing {code} => code
  }
}

fn readAlias(found: Slot | Missing) -> i32 {
  return match move found {
    Slot slot => load(slot) * 2
    Missing {code} => code
  }
}

fn readNullable(found: Missing | ?*mut i32) -> i32 {
  return match move found {
    ?*mut i32 slot => match Pointer.nonNullMut<i32>(slot) {
      Option<*mut i32>.Some {value} => load(value)
      Option<*mut i32>.None => 30
    }
    Missing {code} => code
  }
}

// A pointer to a declared struct, as an interpreter's heap header.
fn header(value: &mut Header, present: bool) -> *mut Header | Missing {
  if !present { return Missing { code: 5 } }
  return Pointer.fromMutRef<Header>(&mut value.*)
}

fn tagAt(address: *mut Header) -> i32 {
  let mut anchor = 0
  let mut tag = 0
  unsafe { tag = Pointer.borrowMut<i32, Header>(&mut anchor, address).tag }
  return tag
}

fn tagOf(found: *mut Header | Missing) -> i32 {
  return match move found {
    *mut Header address => tagAt(address)
    Missing {code} => code
  }
}

pub fn main() -> i32 {
  let mut values = [10, 20, 4]
  let mut first = Header { tag: 3 }
  // 10 + 7 + 40 + 1 + 30 + 4 + 3 + 5 = 100
  return tagOf(header(&mut first, true)) + tagOf(header(&mut first, false)) +
    read(find(&mut values, 0)) + read(find(&mut values, 5)) + readAlias(find(&mut values, 1)) +
    readNullable(nullable(&mut values, 0)) + readNullable(nullable(&mut values, 1)) + readNullable(nullable(&mut values, 2))
}
