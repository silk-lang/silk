import silk.num.i8
import silk.num.u8

unsafe extern "C" fn abs(value: i32) -> i32
struct Pair { left: i32, right: i32 }
@inlineNever
fn signed(value: i8) -> i32 { return i8.toI32(value) }
@inlineNever
fn unsigned(value: u8) -> i32 { return u8.toI32(value) }
@inlineNever
fn boolean(value: bool) -> bool { return value }
@inlineNever
fn absent(value: ?*mut i32) -> bool { return Intrinsic.pointerIsNull<?*mut i32>(value) }
@inlineNever
fn aggregate(value: Pair) -> i32 { return value.left + value.right }

pub fn main() -> i32 {
  if signed(Intrinsic.i8Negate(3)) != -3 { return 1 }
  if unsigned(Intrinsic.u8WrappingAdd(250, 5)) != 255 { return 2 }
  if !boolean(Intrinsic.boolNot(false)) { return 3 }
  if !absent(Intrinsic.pointerNull<i32>()) { return 4 }
  if aggregate(Pair {left: 10, right: 20}) != 30 { return 5 }
  if unsafe abs(Intrinsic.i32Negate(42)) != 42 { return 6 }
  return 42
}
