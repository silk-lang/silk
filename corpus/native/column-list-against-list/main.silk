// Runs the same random operations on a `ColumnList` and on a `List` of structs, and compares every
// row after each one. The row has fields of four alignments, a child struct and an array, so the
// columns are not in declaration order. The lists grow, shrink and grow again, which covers a
// growth in place, a growth onto new storage and an exact capacity.
import silk.collections.column_list { ColumnList, ColumnSort }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u64
import silk.num.usize

struct Pair { pub x: f32, pub y: u32 }
impl Copy for Pair {}

struct Row {
  pub a: u8,
  pub b: u64,
  pub c: u16,
  pub d: Pair,
  pub e: bool,
  pub f: u32,
  pub g: [u8; 3],
}
impl Copy for Row {}

struct Random { state: u64 }

fn next(random: &mut Random) -> u64 {
  random.state = u64.wrappingAdd(u64.wrappingMultiply(random.state, 6364136223846793005), 1442695040888963407)
  return u64.shiftRight(random.state, 33)
}

fn below(random: &mut Random, limit: usize) -> usize {
  if limit == 0 { return 0 }
  return u64.toUsize(u64.remainder(next(&mut random.*), usize.toU64(limit)))
}

fn row(random: &mut Random) -> Row {
  let v = next(&mut random.*)
  return Row {
    a: u64.wrappingToU8(v),
    b: u64.wrappingMultiply(v, 2654435761),
    c: u64.wrappingToU16(u64.shiftRight(v, 3)),
    d: Pair { x: u64.toF32(u64.remainder(v, 1000)), y: u64.wrappingToU32(u64.shiftRight(v, 7)) },
    e: u64.remainder(v, 2) == 0,
    f: u64.toU32(u64.remainder(v, 17)),
    g: [u64.wrappingToU8(u64.shiftRight(v, 5)), u64.wrappingToU8(u64.shiftRight(v, 9)), u64.wrappingToU8(u64.shiftRight(v, 13))],
  }
}

fn same(l: &Row, r: &Row) -> bool {
  return l.a == r.a && l.b == r.b && l.c == r.c && l.d.x == r.d.x && l.d.y == r.d.y && l.e == r.e && l.f == r.f
    && l.g[0] == r.g[0] && l.g[1] == r.g[1] && l.g[2] == r.g[2]
}

fn agree(columns: &ColumnList<Row>, model: &List<Row>) -> bool {
  let rows = List<Row>.asSlice(model)
  if columns.length() != rows.length { return false }
  let bs = &columns[..].b
  let fs = &columns[..].f
  let es = &columns[..].e
  if bs.length != rows.length || fs.length != rows.length { return false }
  let mut i: usize = 0
  while i < rows.length {
    let got = columns.get(i)
    if !same(&got, &rows[i]) { return false }
    if columns[i].c != rows[i].c || columns[i].d.y != rows[i].d.y || columns[i].g[2] != rows[i].g[2] { return false }
    if bs[i] != rows[i].b || fs[i] != rows[i].f || es[i] != rows[i].e { return false }
    i = i + 1
  }
  return true
}

effect fn copyRange(target: &mut List<Row>, source: &[Row], start: usize, end: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut i = start
  while i < end {
    run target.append(source[i])
    i = i + 1
  }
  return ()
}

// Returns 0 if the two lists agree after each of `steps` operations.
effect fn compare(seed: u64, steps: usize) -> i32 ! OutOfMemoryError ? &mut Allocator {
  let mut random = Random { state: seed }
  let mut columns = ColumnList<Row>.make()
  let mut model = List<Row>.make()
  let mut other = ColumnList<Row>.make()
  let mut otherModel = List<Row>.make()
  let mut scratch = ColumnSort.make()
  let mut k: usize = 0
  while k < 40 {
    let r = row(&mut random)
    run other.append(r)
    run otherModel.append(r)
    k = k + 1
  }
  let mut step: usize = 0
  while step < steps {
    let op = below(&mut random, 22)
    let n = model.length()
    if op == 0 || op == 1 || op == 2 {
      let r = row(&mut random)
      run columns.append(r)
      run model.append(r)
    } else if op == 3 {
      let r = row(&mut random)
      let count = below(&mut random, 9)
      run columns.appendRepeated(r, count)
      run model.appendRepeated(r, count)
    } else if op == 4 {
      let r = row(&mut random)
      let at = below(&mut random, n + 1)
      run columns.insert(at, r)
      run model.insertRepeated(at, r, 1)
    } else if op == 5 {
      let r = row(&mut random)
      let at = below(&mut random, n + 1)
      let count = below(&mut random, 6)
      run columns.insertRepeated(at, r, count)
      run model.insertRepeated(at, r, count)
    } else if op == 6 {
      let at = below(&mut random, n + 1)
      let s = below(&mut random, 41)
      let e = s + below(&mut random, 41 - s)
      run columns.insertSlice(at, other.rows().range(s, e))
      let mut fresh = List<Row>.make()
      run copyRange(&mut fresh, List<Row>.asSlice(&model), 0, at)
      run copyRange(&mut fresh, List<Row>.asSlice(&otherModel), s, e)
      run copyRange(&mut fresh, List<Row>.asSlice(&model), at, n)
      model = move fresh
    } else if op == 7 {
      let s = below(&mut random, 41)
      let e = s + below(&mut random, 41 - s)
      run columns.appendSlice(other.rows().range(s, e))
      run copyRange(&mut model, List<Row>.asSlice(&otherModel), s, e)
    } else if op == 8 && n > 0 {
      let at = below(&mut random, n)
      let got = columns.remove(at)
      let want = model.remove(at)
      if !same(&got, &want) { return 10 }
    } else if op == 9 && n > 0 {
      let at = below(&mut random, n)
      let got = columns.swapRemove(at)
      let rows = List<Row>.asMutSlice(&mut model)
      let want = rows[at]
      rows[at] = rows[n - 1]
      let _last = model.pop()
      if !same(&got, &want) { return 11 }
    } else if op == 10 {
      let s = below(&mut random, n + 1)
      let e = s + below(&mut random, n + 1 - s)
      columns.removeRange(s, e)
      let mut fresh = List<Row>.make()
      run copyRange(&mut fresh, List<Row>.asSlice(&model), 0, s)
      run copyRange(&mut fresh, List<Row>.asSlice(&model), e, n)
      model = move fresh
    } else if op == 11 && n > 0 {
      let count = below(&mut random, n + 1)
      let from = below(&mut random, n - count + 1)
      let to = below(&mut random, n - count + 1)
      columns.moveRange(from, to, count)
      let mut held = List<Row>.make()
      run copyRange(&mut held, List<Row>.asSlice(&model), from, from + count)
      let rows = List<Row>.asMutSlice(&mut model)
      let mut i: usize = 0
      while i < count {
        rows[to + i] = List<Row>.asSlice(&held)[i]
        i = i + 1
      }
    } else if op == 12 {
      let at = below(&mut random, n + 1)
      let tail = run columns.splitOff(at)
      let mut tailModel = List<Row>.make()
      run copyRange(&mut tailModel, List<Row>.asSlice(&model), at, n)
      model.truncate(at)
      if !agree(&tail, &tailModel) { return 12 }
      if below(&mut random, 2) == 0 {
        run columns.appendSlice(tail.rows())
        run copyRange(&mut model, List<Row>.asSlice(&tailModel), 0, n - at)
      }
    } else if op == 13 {
      columns.truncate(below(&mut random, n + 30))
      model.truncate(columns.length())
    } else if op == 14 {
      let got = columns.pop()
      let want = model.pop()
      match move got {
        Option<Row>.Some { value } => {
          match move want {
            Option<Row>.Some { value: wanted } => { if !same(&value, &wanted) { return 13 } }
            Option<Row>.None => { return 14 }
          }
        }
        Option<Row>.None => { if n != 0 { return 15 } }
      }
    } else if op == 15 && n > 0 {
      let at = below(&mut random, n)
      let r = row(&mut random)
      if below(&mut random, 2) == 0 {
        columns.set(at, r)
      } else {
        columns[at].a = r.a
        columns[at].b = r.b
        columns[at].c = r.c
        columns[at].d = r.d
        columns[at].e = r.e
        columns[at].f = r.f
        columns[at].g = r.g
      }
      let rows = List<Row>.asMutSlice(&mut model)
      rows[at] = r
    } else if op == 16 {
      if below(&mut random, 2) == 0 {
        run columns.sortBy("f", &mut scratch)
        let rows = List<Row>.asMutSlice(&mut model)
        let mut i: usize = 1
        while i < rows.length {
          let held = rows[i]
          let mut j = i
          while j > 0 && rows[j - 1].f > held.f {
            rows[j] = rows[j - 1]
            j = j - 1
          }
          rows[j] = held
          i = i + 1
        }
      } else {
        run columns.sortBy("c", &mut scratch)
        let rows = List<Row>.asMutSlice(&mut model)
        let mut i: usize = 1
        while i < rows.length {
          let held = rows[i]
          let mut j = i
          while j > 0 && rows[j - 1].c > held.c {
            rows[j] = rows[j - 1]
            j = j - 1
          }
          rows[j] = held
          i = i + 1
        }
      }
    } else if op == 17 {
      run columns.reserve(below(&mut random, 50))
    } else if op == 18 {
      run columns.reserveExact(below(&mut random, 50))
    } else if op == 19 {
      run columns.shrinkToFit()
    } else if op == 20 && below(&mut random, 40) == 0 {
      columns.clearAndFree()
      model.clear()
    } else if op == 21 && n > 1 {
      // Write through two handles at once.
      let at = 1 + below(&mut random, n - 1)
      let r = row(&mut random)
      let pair = columns.rowsMut().splitAt(at)
      let mut left = move pair.left
      let mut right = move pair.right
      left[at - 1].b = r.b
      right[0].f = r.f
      let rows = List<Row>.asMutSlice(&mut model)
      rows[at - 1].b = r.b
      rows[at].f = r.f
    }
    if columns.length() > 600 {
      columns.truncate(100)
      model.truncate(100)
    }
    if !agree(&columns, &model) { return 100 + u64.wrappingToI32(usize.toU64(op)) }
    if !agree(&other, &otherModel) { return 99 }
    step = step + 1
  }
  return 0
}

effect fn recover(error: OutOfMemoryError) -> i32 { return 98 }

pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut seed: u64 = 1
  while seed < 5 {
    let code = run Effect.catchAll(compare(seed, 3000) |> Effect.provideMut<Allocator>(&mut allocator), recover)
    if code != 0 { return code }
    seed = seed + 1
  }
  return 42
}
