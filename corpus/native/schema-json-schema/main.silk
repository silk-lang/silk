// Writes the JSON Schema of a config in each dialect, and validates what the encoder writes against it.
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.json.schema { Draft, JsonSchema, JsonSchemaError as ValidatorError }
import silk.json.schema_resolver { SchemaRegistry, SchemaResolutionError, SchemaResolver }
import silk.json.scanner { JsonError }
import silk.json.value { Json }
import silk.text.regex { RegexError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.schema.json_schema { JsonSchemaDialect, JsonSchemaError, JsonSchemaOptions, JsonSchemaProblem, JsonSchemas }
import silk.schema.issue { SchemaError }
import silk.schema.json { SchemaJson }
import silk.schema.schema { Schema, Schemas, Spec }
import silk.schema.shape { Literal, Shape, VariantShape }
import silk.text.string { String }

/// How a client signs in.
union Auth {
  /// No credentials.
  Anonymous,
  /// A bearer token.
  Token {
    /// The token text.
    pub value: String,
  },
}
impl Schema for Auth {}

/// The log level.
union Level { Debug, Info }
impl Schema for Level {}

/// A server to start.
struct Server {
  /// The host name to bind.
  pub host: String,
  /// The port to listen on.
  pub port: u16,
  pub idleSeconds: u32,
  pub tags: List<String>,
  pub level: Level,
  pub proxy: Option<String>,
  pub auth: Auth,
}

impl Schema for Server {
  static fn spec() -> Spec<Server> {
    return Spec<Server>.of()
      |> Spec<Server>.rename("idleSeconds", "idle_seconds")
      |> Spec<Server>.length("host", 1, 253)
      |> Spec<Server>.between("port", 1, 65535)
      |> Spec<Server>.items("tags", 1, 8)
      |> Spec<Server>.default("idleSeconds", Literal.Integer {value: 30})
  }
}

/// A list of itself.
struct Tree {
  pub children: List<Tree>,
}
impl Schema for Tree {}

const STANDARD: &[u8] = b"{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"type\":\"object\",\"properties\":{\"host\":{\"type\":\"string\",\"minLength\":1,\"maxLength\":253,\"description\":\"The host name to bind.\"},\"port\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":65535,\"description\":\"The port to listen on.\"},\"idle_seconds\":{\"type\":\"integer\",\"minimum\":0,\"maximum\":4294967295,\"default\":30},\"tags\":{\"type\":\"array\",\"items\":{\"type\":\"string\"},\"minItems\":1,\"maxItems\":8},\"level\":{\"$ref\":\"#/$defs/Level\"},\"proxy\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"auth\":{\"$ref\":\"#/$defs/Auth\"}},\"required\":[\"host\",\"port\",\"tags\",\"level\",\"auth\"],\"description\":\"A server to start.\",\"$defs\":{\"Level\":{\"type\":\"string\",\"enum\":[\"Debug\",\"Info\"],\"description\":\"The log level.\"},\"Auth\":{\"oneOf\":[{\"type\":\"object\",\"properties\":{\"type\":{\"const\":\"Anonymous\"}},\"required\":[\"type\"],\"description\":\"No credentials.\"},{\"type\":\"object\",\"properties\":{\"type\":{\"const\":\"Token\"},\"value\":{\"type\":\"string\",\"description\":\"The token text.\"}},\"required\":[\"type\",\"value\"],\"description\":\"A bearer token.\"}],\"description\":\"How a client signs in.\"}}}\n"

const OPENAI: &[u8] = b"{\"type\":\"object\",\"properties\":{\"host\":{\"type\":\"string\",\"description\":\"The host name to bind.\\nExpected text of 1 to 253 characters.\"},\"port\":{\"type\":\"integer\",\"minimum\":1,\"maximum\":65535,\"description\":\"The port to listen on.\"},\"idle_seconds\":{\"anyOf\":[{\"type\":\"integer\",\"minimum\":0,\"maximum\":4294967295,\"description\":\"Default: 30.\"},{\"type\":\"null\"}]},\"tags\":{\"type\":\"array\",\"items\":{\"type\":\"string\"},\"minItems\":1,\"maxItems\":8},\"level\":{\"$ref\":\"#/$defs/Level\"},\"proxy\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"auth\":{\"$ref\":\"#/$defs/Auth\"}},\"required\":[\"host\",\"port\",\"idle_seconds\",\"tags\",\"level\",\"proxy\",\"auth\"],\"additionalProperties\":false,\"description\":\"A server to start.\",\"$defs\":{\"Level\":{\"type\":\"string\",\"enum\":[\"Debug\",\"Info\"],\"description\":\"The log level.\"},\"Auth\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"type\":{\"type\":\"string\",\"enum\":[\"Anonymous\"]}},\"required\":[\"type\"],\"additionalProperties\":false,\"description\":\"No credentials.\"},{\"type\":\"object\",\"properties\":{\"type\":{\"type\":\"string\",\"enum\":[\"Token\"]},\"value\":{\"type\":\"string\",\"description\":\"The token text.\"}},\"required\":[\"type\",\"value\"],\"additionalProperties\":false,\"description\":\"A bearer token.\"}],\"description\":\"How a client signs in.\"}}}\n"

const ANTHROPIC: &[u8] = b"{\"type\":\"object\",\"properties\":{\"host\":{\"type\":\"string\",\"description\":\"The host name to bind.\\nExpected text of 1 to 253 characters.\"},\"port\":{\"type\":\"integer\",\"description\":\"The port to listen on.\\nExpected an integer from 1 to 65535.\"},\"idle_seconds\":{\"type\":\"integer\",\"description\":\"Default: 30.\"},\"tags\":{\"type\":\"array\",\"items\":{\"type\":\"string\"},\"description\":\"Expected a list of 1 to 8 elements.\"},\"level\":{\"$ref\":\"#/$defs/Level\"},\"proxy\":{\"anyOf\":[{\"type\":\"string\"},{\"type\":\"null\"}]},\"auth\":{\"$ref\":\"#/$defs/Auth\"}},\"required\":[\"host\",\"port\",\"tags\",\"level\",\"auth\"],\"additionalProperties\":false,\"description\":\"A server to start.\",\"$defs\":{\"Level\":{\"type\":\"string\",\"enum\":[\"Debug\",\"Info\"],\"description\":\"The log level.\"},\"Auth\":{\"anyOf\":[{\"type\":\"object\",\"properties\":{\"type\":{\"const\":\"Anonymous\"}},\"required\":[\"type\"],\"additionalProperties\":false,\"description\":\"No credentials.\"},{\"type\":\"object\",\"properties\":{\"type\":{\"const\":\"Token\"},\"value\":{\"type\":\"string\",\"description\":\"The token text.\"}},\"required\":[\"type\",\"value\"],\"additionalProperties\":false,\"description\":\"A bearer token.\"}],\"description\":\"How a client signs in.\"}}}\n"

const TREE: &[u8] = b"{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"type\":\"object\",\"properties\":{\"children\":{\"type\":\"array\",\"items\":{\"$ref\":\"#\"}}},\"required\":[\"children\"],\"description\":\"A list of itself.\"}\n"

const TOKEN: &[u8] = b"{\"$schema\":\"https://json-schema.org/draft/2020-12/schema\",\"type\":\"object\",\"properties\":{\"value\":{\"type\":\"string\",\"description\":\"The token text.\"}},\"required\":[\"value\"],\"description\":\"A bearer token.\"}\n"

struct Capture {
  bytes: [u8; 4096],
  length: usize,
}

impl Writer for Capture {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> () ! WriterError ? &mut Writer {
    let mut index: usize = 0
    while index < value.length {
      if self.length < 4096 { self.bytes[self.length] = value[index] }
      self.length = self.length + 1
      index = index + 1
    }
    return ()
  }

  effect fn flush(self: &mut Self) -> () ! WriterError ? &mut Writer {
    return ()
  }
}

fn holds(capture: &Capture, expected: &[u8]) -> bool {
  if capture.length != expected.length { return false }
  let mut index: usize = 0
  while index < expected.length {
    if capture.bytes[index] != expected[index] { return false }
    index = index + 1
  }
  return true
}

effect fn written<T: Schema>(dialect: JsonSchemaDialect, capture: &mut Capture) -> bool ! JsonSchemaError | WriterError | OutOfMemoryError ? &mut Allocator {
  let shapes = run Schemas.shape<T>()
  capture.length = 0
  return run JsonSchemas.write(&shapes, JsonSchemaOptions.of(dialect)) |> Effect.provideMut<Writer>(&mut capture.*)
}

// Whether the dialect refuses `T` for `problem`.
effect fn refused<T: Schema>(dialect: JsonSchemaDialect, problem: JsonSchemaProblem) -> bool ! WriterError | OutOfMemoryError ? &mut Allocator {
  let mut capture = Capture {bytes: [0; 4096], length: 0}
  return match run Effect.result(written<T>(dialect, &mut capture)) {
    Result<bool, JsonSchemaError | WriterError | OutOfMemoryError>.Success {..} => false
    Result<bool, JsonSchemaError | WriterError | OutOfMemoryError>.Failure {error} => match move error {
      JsonSchemaError {problem: found, ..} => found == problem
      WriterError found => { fail move found }
      OutOfMemoryError {} => { fail OutOfMemoryError {} }
    }
  }
}

// Whether the schema in `schema` accepts the JSON in `instance`.
effect fn accepts(schema: &Capture, instance: &[u8]) -> bool
  ! JsonError | ValidatorError | SchemaResolutionError | RegexError | OutOfMemoryError ? &mut Allocator {
  let parsedSchema = run Json.parseExact(Slice.view<u8>(&schema.bytes, 0, schema.length))
  let parsedInstance = run Json.parseExact(instance)
  let mut registry = SchemaRegistry.make()
  let compiled = run JsonSchema.compile(&parsedSchema, "https://example.com/server", JsonSchema.options(Draft.Draft202012))
    |> Effect.provideMut<SchemaResolver>(&mut registry)
  let output = run JsonSchema.validate(&compiled, &parsedInstance)
  return output.valid
}

effect fn checks() -> i32
  ! JsonSchemaError | SchemaError | WriterError | JsonError | ValidatorError | SchemaResolutionError | RegexError | OutOfMemoryError ? &mut Allocator {
  let mut capture = Capture {bytes: [0; 4096], length: 0}
  if !run written<Server>(JsonSchemaDialect.Standard, &mut capture) { return 1 }
  if !holds(&capture, STANDARD) { return 2 }
  // OpenAI strict has no length keywords, so the host rule becomes text.
  if run written<Server>(JsonSchemaDialect.OpenAiStrict, &mut capture) { return 3 }
  if !holds(&capture, OPENAI) { return 4 }
  // Anthropic strict has no length or range keywords, so they become text and the schema is approximate.
  if run written<Server>(JsonSchemaDialect.AnthropicStrict, &mut capture) { return 5 }
  if !holds(&capture, ANTHROPIC) { return 6 }
  // A recursive type refers to the root as `#`.
  if !run written<Tree>(JsonSchemaDialect.Standard, &mut capture) { return 7 }
  if !holds(&capture, TREE) { return 8 }
  if !run refused<Tree>(JsonSchemaDialect.AnthropicStrict, JsonSchemaProblem.Recursive) { return 9 }
  if !run refused<Level>(JsonSchemaDialect.OpenAiStrict, JsonSchemaProblem.RootNotObject) { return 10 }
  if run refused<Level>(JsonSchemaDialect.Standard, JsonSchemaProblem.RootNotObject) { return 11 }

  // One variant's fields, as the parameters of a tool.
  let shapes = run Schemas.shape<Auth>()
  if let Shape.Tagged {variants, ..} = &shapes.get(shapes.root()).* {
    let token = &List<VariantShape>.asSlice(&variants)[1]
    capture.length = 0
    let exact = run JsonSchemas.writeVariant(&shapes, token, JsonSchemaOptions.of(JsonSchemaDialect.Standard))
      |> Effect.provideMut<Writer>(&mut capture)
    if !exact || !holds(&capture, TOKEN) { return 12 }
  } else {
    return 13
  }

  // What the encoder writes, the schema accepts; what the decoder rejects, the schema rejects too.
  if !run written<Server>(JsonSchemaDialect.Standard, &mut capture) { return 14 }
  let mut tags = List<String>.make()
  run List<String>.append(&mut tags, run String.copy("edge"))
  let server = Server {host: run String.copy("silk.dev"), port: 8080, idleSeconds: 30, tags: move tags, level: Level.Info,
    proxy: Option<String>.none(), auth: Auth.Token {value: run String.copy("t1")}}
  let mut encoded = Capture {bytes: [0; 4096], length: 0}
  run SchemaJson.encode<Server>(&server) |> Effect.provideMut<Writer>(&mut encoded)
  if !run accepts(&capture, Slice.view<u8>(&encoded.bytes, 0, encoded.length)) { return 15 }
  let badPort = b"{\"host\": \"silk.dev\", \"port\": 0, \"tags\": [\"edge\"], \"level\": \"Info\", \"auth\": {\"type\": \"Anonymous\"}}"
  if run accepts(&capture, badPort) { return 16 }
  let badAuth = b"{\"host\": \"silk.dev\", \"port\": 1, \"tags\": [\"edge\"], \"level\": \"Info\", \"auth\": {\"type\": \"Basic\"}}"
  if run accepts(&capture, badAuth) { return 17 }
  return 0
}

pub effect fn main() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let result = run Effect.result(checks()) |> Effect.provideMut<Allocator>(&mut allocator)
  return match move result {
    Result<i32, JsonSchemaError | SchemaError | WriterError | JsonError | ValidatorError | SchemaResolutionError | RegexError | OutOfMemoryError>.Success {value} => value
    _ => 99
  }
}
