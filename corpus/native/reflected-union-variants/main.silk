import silk.reflect { Reflect }
import silk.option { Option }
import silk.u32

struct CloneArgs {
  pub url: string,
  pub depth: u32,
}

union Command {
  Status,
  Clone { pub args: CloneArgs },
  Push { pub force: bool, pub count: u32 },
}

static fn fieldCount<U>(variant: Intrinsic.Variant<U>) -> usize {
  let mut count: usize = 0
  static for field in Reflect.variantFields(variant) { count = count + 1 }
  return count
}

fn parseArgs(rest: &[string]) -> CloneArgs {
  return CloneArgs {url: rest[0], depth: 1}
}

fn parseCommand<U>(word: string, rest: &[string]) -> Option<U> {
  static for variant in Reflect.variants<U>() {
    if word == Reflect.variantLabel(variant) {
      let static count = fieldCount(variant)
      static if count == 0 {
        return Option<U>.some(Reflect.makeVariant(variant, ()))
      }
      static if count == 1 {
        let parsed = parseArgs(rest)
        return Option<U>.some(Reflect.makeVariant(variant, (move parsed,)))
      }
      static if count == 2 {
        let n: u32 = 3
        return Option<U>.some(Reflect.makeVariant(variant, (true, n)))
      }
    }
  }
  return Option<U>.none()
}

fn score(command: &Command) -> i32 {
  return match &command.* {
    Command.Status => 1
    Command.Clone {args} => u32.toI32(args.depth) * 10
    Command.Push {force, count} => {
      if force { return u32.toI32(count) * 100 }
      return 0
    }
  }
}

pub fn main() -> i32 {
  let mut total = 0
  let words = ["x"]
  if let Option<Command>.Some {value} = parseCommand<Command>("Status", &words) { total = total + score(&value) }
  if let Option<Command>.Some {value} = parseCommand<Command>("Clone", &words) { total = total + score(&value) }
  if let Option<Command>.Some {value} = parseCommand<Command>("Push", &words) {
    total = total + score(&value)
    static for variant in Reflect.variants<Command>() {
      if Reflect.isVariant(&value, variant) { total = total + 1000 }
    }
  }
  static for variant in Reflect.variants<Command>() {
    static for field in Reflect.variantFields(variant) {
      static if Reflect.fieldKind(field) == 2 { total = total + 10000 }
    }
  }
  static if Reflect.typeKind(Reflect.typeOf<Command>()) == 6 { total = total + 100000 }
  return total - 131269
}
