import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.concurrency.thread_native { JoinHandle, NativeThread, SpawnError }
import silk.option { Option }
import silk.concurrency.sync { Arc }
import silk.concurrency.work_queue { Injector, Mailbox, MailboxReceiver, MailboxSender, Steal, Stealer, WorkDeque, Worker }

// Three thieves and the owner drain one deque; two threads feed one injector; four senders feed
// one mailbox. Every value arrives exactly once, and dropped queues drop what they still hold.
fn stealAll(stealer: Stealer<i64>) -> i64 {
  let mut sum: i64 = 0
  while true {
    match stealer.steal() {
      Steal<i64>.Success { value } => { sum = sum + value }
      Steal<i64>.Empty => { return sum }
      Steal<i64>.Retry => {}
    }
  }
  return sum
}

effect fn spawnThief(worker: &Worker<i64>) -> JoinHandle<i64> ! OutOfMemoryError | SpawnError ? &mut Allocator {
  let stealer = worker.stealer()
  return run NativeThread.spawn(fn() -> i64 { return stealAll(move stealer) })
}

effect fn deque() -> i64 ! OutOfMemoryError | SpawnError ? &mut Allocator {
  let mut worker = run WorkDeque.make<i64>()
  let mut value: i64 = 1
  while value <= 1000 {
    run worker.push(value)
    value = value + 1
  }
  let first = run spawnThief(&worker)
  let second = run spawnThief(&worker)
  let third = run spawnThief(&worker)
  let mut sum: i64 = 0
  while true {
    match worker.pop() {
      Option<i64>.Some { value: popped } => { sum = sum + popped }
      Option<i64>.None => { break }
    }
  }
  return sum + first.join() + second.join() + third.join()
}

effect fn feed(injector: Injector<i64>, start: i64) -> i64 ! OutOfMemoryError ? &mut Allocator {
  let mut value = start
  while value < start + 500 {
    run injector.push(value)
    value = value + 1
  }
  return 0
}

fn feedOnThread(injector: Injector<i64>, start: i64) -> i64 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(feed(move injector, start) |> Effect.provideMut<Allocator>(&mut allocator), lost)
}

effect fn lost(error: OutOfMemoryError) -> i64 { return -1 }

effect fn spawnFeeder(injector: &Injector<i64>, start: i64) -> JoinHandle<i64> ! OutOfMemoryError | SpawnError ? &mut Allocator {
  let mine = injector.clone()
  return run NativeThread.spawn(fn() -> i64 { return feedOnThread(move mine, start) })
}

effect fn injector() -> i64 ! OutOfMemoryError | SpawnError ? &mut Allocator {
  let queue = run Injector<i64>.make()
  let first = run spawnFeeder(&queue, 1)
  let second = run spawnFeeder(&queue, 501)
  if first.join() != 0 || second.join() != 0 { return -1 }
  let mut sum: i64 = 0
  let mut previous: i64 = 0
  while true {
    match queue.pop() {
      Option<i64>.Some { value } => { sum = sum + value }
      Option<i64>.None => { break }
    }
  }
  return sum
}

effect fn post(sender: MailboxSender<i64>, start: i64) -> i64 ! OutOfMemoryError ? &mut Allocator {
  let mut value = start
  while value < start + 250 {
    run sender.send(value)
    value = value + 1
  }
  return 0
}

fn postOnThread(sender: MailboxSender<i64>, start: i64) -> i64 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(post(move sender, start) |> Effect.provideMut<Allocator>(&mut allocator), lost)
}

effect fn spawnSender(receiver: &MailboxReceiver<i64>, start: i64) -> JoinHandle<i64> ! OutOfMemoryError | SpawnError ? &mut Allocator {
  let sender = receiver.sender()
  return run NativeThread.spawn(fn() -> i64 { return postOnThread(move sender, start) })
}

effect fn mailbox() -> i64 ! OutOfMemoryError | SpawnError ? &mut Allocator {
  let mut receiver = run Mailbox.make<i64>()
  let first = run spawnSender(&receiver, 1)
  let second = run spawnSender(&receiver, 251)
  let third = run spawnSender(&receiver, 501)
  let fourth = run spawnSender(&receiver, 751)
  let mut sum: i64 = 0
  let mut count = 0
  while count < 1000 {
    match receiver.receive() {
      Option<i64>.Some { value } => {
        sum = sum + value
        count = count + 1
      }
      Option<i64>.None => { NativeThread.yieldNow() }
    }
  }
  if first.join() + second.join() + third.join() + fourth.join() != 0 { return -1 }
  return sum
}

// Values left in a dropped queue are dropped with it.
effect fn leftovers() -> usize ! OutOfMemoryError ? &mut Allocator {
  let marker = run Arc<i32>.make(7)
  let mut worker = run WorkDeque.make<Arc<i32>>()
  let queue = run Injector<Arc<i32>>.make()
  let receiver = run Mailbox.make<Arc<i32>>()
  let sender = receiver.sender()
  let mut at = 0
  while at < 20 {
    run worker.push(marker.clone())
    run queue.push(marker.clone())
    run sender.send(marker.clone())
    at = at + 1
  }
  if marker.count() != 61 { return 0 }
  drop worker
  drop queue
  drop sender
  drop receiver
  return marker.count()
}

effect fn program() -> i32 ! OutOfMemoryError | SpawnError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let dequeResult = run deque() |> Effect.provideMut<Allocator>(&mut allocator)
  if dequeResult != 500500 { return 1 }
  let injectorResult = run injector() |> Effect.provideMut<Allocator>(&mut allocator)
  if injectorResult != 500500 { return 2 }
  let mailboxResult = run mailbox() |> Effect.provideMut<Allocator>(&mut allocator)
  if mailboxResult != 500500 { return 3 }
  let leftoversResult = run leftovers() |> Effect.provideMut<Allocator>(&mut allocator)
  if leftoversResult != 1 { return 4 }
  return 42
}

effect fn recover(error: OutOfMemoryError | SpawnError) -> i32 { return -2 }

pub fn main() -> i32 { return run Effect.catchAll(program(), recover) }
