import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.collections.list { List }
import silk.num.usize

// A list appended past the size the system provider serves on pages of its own (256 KB on
// macOS, where the list then leaves the heap and takes room for appends to come): every
// element survives each growth, and a request for an exact capacity is not given that room.
effect fn build() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let mut values = List<u64>.make()
  let mut index: u64 = 0
  while index < 300000 {
    run values.append(index * 5 + 2)
    index = index + 1
  }
  let mut at: usize = 0
  while at < values.length() {
    if values.get(at) != usize.toU64(at) * 5 + 2 { return 1 }
    at = at + 4099
  }
  // Appending left spare room; fitting gives it back.
  if values.capacity() < values.length() { return 2 }
  run values.shrinkToFit()
  if values.capacity() >= values.length() * 2 { return 3 }
  if values.get(299999) != 1499997 { return 4 }
  // An exact reservation of a large list is exact enough to plan with.
  run values.reserveExact(100000)
  if values.capacity() < 400000 || values.capacity() >= 800000 { return 5 }
  // A list inserted into and extended from a slice grows the same way.
  let mut more = List<u64>.make()
  while more.length() < 40000 {
    run more.insert(0, usize.toU64(more.length()))
  }
  if more.get(0) != 39999 || more.get(39999) != 0 { return 6 }
  let mut joined = List<u64>.make()
  let mut round: usize = 0
  while round < 10 {
    run joined.appendSlice(more.asSlice())
    round = round + 1
  }
  if joined.length() != 400000 || joined.get(399999) != 0 || joined.get(360000) != 39999 { return 7 }
  return 42
}

effect fn refused(error: OutOfMemoryError) -> i32 { return 9 }

effect fn program() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run build() |> Effect.provideMut<Allocator>(&mut allocator)
}

pub fn main() -> i32 { return run Effect.catchAll(program(), refused) }
