// Safe defaults, independent policy switches, subtree output, writer parity, and hostile-input results.
import silk.markdown.document { MarkdownDocument, MarkdownNodeId }
import silk.markdown.html { MarkdownHtml, HtmlOptions }
import silk.collections.bytes { Bytes }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.io.writer { Writer, WriterError }
import silk.text.string { String }

struct CheckFailed {
  code: i32
}

effect fn expect(ok: bool, code: i32) -> ()
  ! CheckFailed {
  if !ok {
    fail CheckFailed { code: code }
  }
}

effect fn rendered(source: string, expected: string, code: i32) -> ()
  ! CheckFailed | OutOfMemoryError
  ? &mut Allocator {
  let doc = run MarkdownDocument.parse(source)
  let output = run MarkdownHtml.renderOwned(&doc)
  run expect(String.view(&output) == expected, code)
}

struct Capture {
  data: [u8; 512],
  length: usize
}

impl Writer for Capture {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> ()
    ! WriterError {
    if value.length > 512 - self.length {
      fail Writer.failure()
    }
    let mut i: usize = 0
    while i < value.length {
      self.data[self.length] = value[i]
      self.length = self.length + 1
      i = i + 1
    }
  }

  effect fn flush(self: &mut Self) -> () {}
}

effect fn checks() -> ()
  ! CheckFailed | OutOfMemoryError | WriterError
  ? &mut Allocator {
  run rendered(
    "<div>x & y</div>\n\nA <i>word</i>.",
    "&lt;div&gt;x &amp; y&lt;/div&gt;\n<p>A &lt;i&gt;word&lt;/i&gt;.</p>\n",
    1,
  )
  run rendered("[x](JaVaScRiPt:alert)", "<p><a href=\"\">x</a></p>\n", 2)
  run rendered("![x](vbscript:evil)", "<p><img src=\"\" alt=\"x\" /></p>\n", 3)
  run rendered("[x](file:/secret)", "<p><a href=\"\">x</a></p>\n", 4)
  run rendered("[x](data:text/html,evil)", "<p><a href=\"\">x</a></p>\n", 5)
  run rendered("[x](&#x09;javaScript:evil)", "<p><a href=\"\">x</a></p>\n", 6)
  run rendered(
    "[x](https://example.test/a?x=1&y=2 \"a&b\\\"c\")",
    "<p><a href=\"https://example.test/a?x=1&amp;y=2\" title=\"a&amp;b&quot;c\">x</a></p>\n",
    7,
  )
  run rendered(
    "``` x&amp;y more\n<code>\n```",
    "<pre><code class=\"language-x&amp;y\">&lt;code&gt;\n</code></pre>\n",
    8,
  )
  run rendered("[x](</a b/é>)", "<p><a href=\"/a%20b/%C3%A9\">x</a></p>\n", 9)
  run rendered("[x](java&#x09;script:evil)", "<p><a href=\"\">x</a></p>\n", 19)
  run rendered("a\u{85}_b_ a\u{a0}_b_", "<p>a\u{85}_b_ a\u{a0}<em>b</em></p>\n", 20)
  run rendered(
    "[a b] [a\u{a0}b]\n\n[a b]: /space\n[a\u{a0}b]: /nbsp",
    "<p><a href=\"/space\">a b</a> <a href=\"/nbsp\">a\u{a0}b</a></p>\n",
    21,
  )

  // A backslash-escaped backtick shortens the run that follows it.
  run rendered("a\\``` b `` c", "<p>a`<code>b</code> c</p>\n", 24)
  run rendered("\\```", "<p>```</p>\n", 25)

  // A lazy continuation line may start any list; a matched paragraph only admits `1` and content.
  run rendered(
    "> a\n2) b\n\nc\n2) d",
    "<blockquote>\n<p>a</p>\n</blockquote>\n<ol start=\"2\">\n<li>b</li>\n</ol>\n<p>c\n2) d</p>\n",
    26,
  )
  run rendered("![a<b>c](/u)", "<p><img src=\"/u\" alt=\"a&lt;b&gt;c\" /></p>\n", 27)
  let mut longLabel = Bytes.make()
  let mut character: usize = 0
  while character < 999 {
    run Bytes.append(&mut longLabel, String.utf8Bytes("é"))
    character = character + 1
  }
  let mut referenceInput = run Bytes.copy(b"[")
  run Bytes.append(&mut referenceInput, Bytes.asSlice(&longLabel))
  run Bytes.append(&mut referenceInput, b"]\n\n[")
  run Bytes.append(&mut referenceInput, Bytes.asSlice(&longLabel))
  run Bytes.append(&mut referenceInput, b"]: /x")
  let mut referenceExpected = run Bytes.copy(b"<p><a href=\"/x\">")
  run Bytes.append(&mut referenceExpected, Bytes.asSlice(&longLabel))
  run Bytes.append(&mut referenceExpected, b"</a></p>\n")
  run rendered(
    unsafe String.fromUtf8Unchecked(Bytes.asSlice(&referenceInput)),
    unsafe String.fromUtf8Unchecked(Bytes.asSlice(&referenceExpected)),
    22,
  )
  run rendered(
    "a <i title=\"\u{0}\">b</i>",
    "<p>a &lt;i title=&quot;\u{fffd}&quot;&gt;b&lt;/i&gt;</p>\n",
    23,
  )
  let doc = run MarkdownDocument.parse("<b>x</b> [x](javascript:evil)")
  let mut options = HtmlOptions.make()
  options.rawHtml = true
  let raw = run MarkdownHtml.renderOwnedWithOptions(&doc, &options)
  run expect(String.view(&raw) == "<p><b>x</b> <a href=\"\">x</a></p>\n", 10)
  options.rawHtml = false
  options.unsafeLinks = true
  let unsafeLinks = run MarkdownHtml.renderOwnedWithOptions(&doc, &options)
  run expect(
    String.view(&unsafeLinks) == "<p>&lt;b&gt;x&lt;/b&gt; <a href=\"javascript:evil\">x</a></p>\n",
    11,
  )
  let subtree = run MarkdownDocument.parse("# One\n\nTwo")
  let mut bytes = run Bytes.copy(b"prefix:")
  run MarkdownHtml.renderNodeInto(&subtree, MarkdownNodeId { index: 1 }, &mut bytes)
  run expect(unsafe String.fromUtf8Unchecked(Bytes.asSlice(&bytes)) == "prefix:<h1>One</h1>\n", 12)
  run MarkdownHtml.renderInto(&subtree, &mut bytes)
  run expect(
    unsafe String.fromUtf8Unchecked(Bytes.asSlice(&bytes)) == "<h1>One</h1>\n<p>Two</p>\n",
    13,
  )

  // The writer path requires no allocator and emits the same document as buffered rendering.
  let mut writer = Capture { data: [0; 512], length: 0 }
  run MarkdownHtml.renderToWriter(&subtree) |> Effect.provideMut<Writer>(&mut writer)
  run expect(
    unsafe String.fromUtf8Unchecked(Slice.view<u8>(&writer.data, 0, writer.length))
      == "<h1>One</h1>\n<p>Two</p>\n",
    14,
  )
  Bytes.clear(&mut bytes)
  run MarkdownHtml.escapeTextInto(&mut bytes, "a&<>\"'")
  run MarkdownHtml.escapeAttributeInto(&mut bytes, "\"x\"")
  run expect(
    unsafe String.fromUtf8Unchecked(Bytes.asSlice(&bytes)) == "a&amp;&lt;&gt;&quot;'&quot;x&quot;",
    15,
  )
  let escaped = run MarkdownHtml.escapeAttributeOwned("<&\"")
  run expect(String.view(&escaped) == "&lt;&amp;&quot;", 16)

  // A large valid paragraph must keep resolving links after earlier links consume scan work.
  let mut input = Bytes.make()
  let mut expected = run Bytes.copy(b"<p>")
  let mut i: usize = 0
  while i < 2048 {
    run Bytes.append(&mut input, b"[a](b) ")
    run Bytes.append(&mut expected, b"<a href=\"b\">a</a> ")
    i = i + 1
  }
  run Bytes.append(&mut input, b"end")
  run Bytes.append(&mut expected, b"end</p>\n")
  let many = run MarkdownDocument.parse(unsafe String.fromUtf8Unchecked(Bytes.asSlice(&input)))
  run MarkdownHtml.renderInto(&many, &mut bytes)
  run expect(
    unsafe String.fromUtf8Unchecked(Bytes.asSlice(&bytes))
      == unsafe String.fromUtf8Unchecked(Bytes.asSlice(&expected)),
    17,
  )

  // Quote-heavy text exercises escaping without a suffix search at every quote.
  Bytes.clear(&mut input)
  Bytes.clear(&mut expected)
  run Bytes.append(&mut expected, b"<p>")
  i = 0
  while i < 4096 {
    run Bytes.append(&mut input, b"\"")
    run Bytes.append(&mut expected, b"&quot;")
    i = i + 1
  }
  run Bytes.append(&mut expected, b"</p>\n")
  let quotes = run MarkdownDocument.parse(unsafe String.fromUtf8Unchecked(Bytes.asSlice(&input)))
  run MarkdownHtml.renderInto(&quotes, &mut bytes)
  run expect(
    unsafe String.fromUtf8Unchecked(Bytes.asSlice(&bytes))
      == unsafe String.fromUtf8Unchecked(Bytes.asSlice(&expected)),
    18,
  )
}

effect fn failure(error: CheckFailed | OutOfMemoryError | WriterError) -> i32 {
  return match move error {
    CheckFailed { code } => code
    OutOfMemoryError _ => 255
    WriterError _ => 254
  }
}

pub effect fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(
    effect {
      run checks()
      return 0
    },
    failure,
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
}
