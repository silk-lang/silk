import ops { Close }

struct Parks {}

impl Close for Parks {
  effect fn close(self: &Self, static park: bool) -> () {
    static if park { return run Intrinsic.relinquish() }
  }
}

// Only this declaration reaches the conversion, and its call cannot park.
pub effect fn produce() -> () {
  let p = Parks {}
  let later: &any Close = &p
  run Close.close(later, false)
}

pub fn answer() -> i32 { return 42 }
