import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.io.buffered_input { BufferError }
import silk.io.buffered_output { BufferedWriter }
import silk.core.effect { Effect }
import silk.io.writer { Writer, WriterError }

// A destination that counts the writes and bytes it receives, and its flushes.
struct Counting {
  writes: usize,
  bytes: usize,
  flushes: usize,
}

impl Writer for Counting {
  effect fn writeAll(self: &mut Self, val: &[u8]) -> () ! WriterError ? &mut Writer {
    self.writes = self.writes + 1
    self.bytes = self.bytes + val.length
    return ()
  }

  effect fn flush(self: &mut Self) -> () ! WriterError ? &mut Writer {
    self.flushes = self.flushes + 1
    return ()
  }
}

// Writes through any Writer provider, as generic output code does.
effect fn fields<W: Writer>(output: &mut W, count: usize) -> () ! WriterError {
  let mut at: usize = 0
  while at < count {
    run Writer.writeString("ab") |> Effect.provideMut<Writer>(&mut output)
    at = at + 1
  }
}

pub effect fn main() -> i32 ! BufferError | OutOfMemoryError | WriterError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let destination = Counting { writes: 0, bytes: 0, flushes: 0 }
  let mut output = run BufferedWriter<Counting>.make(move destination, 16) |> Effect.provideMut<Allocator>(&mut allocator)
  // Eight two-byte writes fill the 16-byte buffer. The ninth sends those 16 bytes in one write and
  // then waits in the buffer, so 100 writes make 12 writes and leave 8 bytes pending.
  run fields<BufferedWriter<Counting>>(&mut output, 100)
  if BufferedWriter<Counting>.pending(&output) != 8 { return 1 }
  // A write longer than the buffer goes out with the pending bytes in one vectored call.
  run Writer.writeAll(b"0123456789abcdefXYZ") |> Effect.provideMut<Writer>(&mut output)
  if BufferedWriter<Counting>.pending(&output) != 0 { return 2 }
  let counted = run BufferedWriter<Counting>.finish(move output)
  if counted.bytes != 219 || counted.flushes != 1 { return 3 }
  // Counting has no vectored write, so the one vectored call is two writeAll calls.
  if counted.writes != 14 { return 4 }
  return 42
}
