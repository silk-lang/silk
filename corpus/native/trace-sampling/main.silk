import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.concurrency.sync { Arc }
import silk.trace.record { Recorder, Config }
import silk.trace { Tracer, Trace }

import silk.core.option { Option }
import silk.trace { SpanContext }
import silk.text.format { Display, Formatter }
import silk.io.writer { Writer, WriterError }

struct Expensive {}
impl Display for Expensive {
  effect fn display(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    Intrinsic.trap("unsampled span formatted an attribute")
  }
}

fn observe() -> i32 {
  let outer = Trace.span("outer")
  Trace.set("expensive", &Expensive {})
  Trace.eventWith("validation", &.{ ignored: Expensive {} })
  let parent = match Trace.current() {
    Option<SpanContext>.Some {value} => value
    Option<SpanContext>.None => { return 1 }
  }
  if parent.span == 0 || parent.flags != 0 { return 2 }
  let child = Trace.span("child")
  let nested = match Trace.current() {
    Option<SpanContext>.Some {value} => value
    Option<SpanContext>.None => { return 3 }
  }
  if nested.flags != 0 || nested.traceHigh != parent.traceHigh || nested.span == parent.span { return 4 }
  drop child
  if let Option<SpanContext>.Some {value} = Trace.current() {
    if value.span != parent.span { return 5 }
  } else { return 6 }
  drop outer
  if Trace.current().isSome() { return 7 }
  return 0
}
fn receive(remote: &SpanContext) -> i32 {
  let _server = Trace.spanFrom(remote, "request")
  let _child = Trace.span("child")
  if let Option<SpanContext>.Some {value} = Trace.current() {
    if value.flags == remote.flags && value.traceHigh == remote.traceHigh && value.traceLow == remote.traceLow { return 0 }
  }
  return 9
}
effect fn exercise() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let mut config = Config.make("unsampled")
  config.sampleRatio = 0.0
  let rec = run Arc<Recorder>.make(run Recorder.make(config))
  let result = run Effect.provideAmbient<Tracer>(effect { return observe() }, &rec)
  if rec.get().takeSpan().isSome() || rec.get().droppedSpans() != 0 { return 8 }
  if result != 0 { return result }
  // Both recorders honor a remote sampling decision even when it differs from their root policy.
  let remote = SpanContext {traceHigh: 1, traceLow: 2, span: 3, flags: 1}
  let kept = run Effect.provideAmbient<Tracer>(effect { return receive(&remote) }, &rec)
  if kept != 0 { return kept }
  if !rec.get().takeSpan().isSome() || !rec.get().takeSpan().isSome() { return 10 }
  config.sampleRatio = 1.0
  let all = run Arc<Recorder>.make(run Recorder.make(config))
  let quiet = SpanContext {traceHigh: 1, traceLow: 2, span: 3, flags: 0}
  let ignored = run Effect.provideAmbient<Tracer>(effect { return receive(&quiet) }, &all)
  if ignored != 0 || all.get().takeSpan().isSome() { return 11 }
  return 0
}
effect fn failed(error: OutOfMemoryError) -> i32 { return 4 }
pub fn main() -> i32 {
  let mut alloc = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(exercise() |> Effect.provideMut<Allocator>(&mut alloc), failed)
}
