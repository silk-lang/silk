import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.concurrency.sync { Arc }
import silk.trace.record { Recorder, Config }
import silk.trace { Tracer, Trace }

import silk.core.option { Option }
import silk.trace { SpanContext }
import silk.trace.record { Span }
fn recordThree() -> i32 {
  let root = Trace.span("root")
  let rootId = match Trace.current() {
    Option<SpanContext>.Some {value} => value.span
    Option<SpanContext>.None => { return 1 }
  }
  // There is only one open record. The overflow span has an ID but no record.
  let overflow = Trace.span("overflow")
  if let Option<SpanContext>.Some {value} = Trace.current() {
    if value.span == 0 || value.span == rootId { return 2 }
  } else { return 3 }
  drop overflow
  if let Option<SpanContext>.Some {value} = Trace.current() {
    if value.span != rootId { return 4 }
  } else { return 5 }
  drop root
  let third = Trace.span("third")
  drop third
  return 0
}
effect fn exercise() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let mut config = Config.make("limited")
  config.openCapacity = 1
  config.threadCapacity = 1
  config.bufferCapacity = 1
  let rec = run Arc<Recorder>.make(run Recorder.make(config))
  let result = run Effect.provideAmbient<Tracer>(effect { return recordThree() }, &rec)
  if result != 0 { return result }
  if rec.get().droppedSpans() != 2 { return 6 }
  if let Option<Span>.Some {value} = rec.get().takeSpan() {
    if value.name != "root" { return 7 }
  } else { return 8 }
  if rec.get().takeSpan().isSome() { return 9 }
  return 0
}
effect fn failed(error: OutOfMemoryError) -> i32 { return 4 }
pub fn main() -> i32 {
  let mut alloc = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(exercise() |> Effect.provideMut<Allocator>(&mut alloc), failed)
}
