// A callable value's result-only region binder is chosen as at a named call: the call leaves it
// 'static, then its `'b: 'a` bound shortens it to the region the operand lends.
fn same<'b>(value: &'b i32) -> &'b i32 { return value }

fn applyNamed(value: i32) -> i32 {
  let local = value
  let held = widen(&local)
  return held.*
}

fn widen<'a, 'b: 'a>(value: &'b i32) -> &'a i32 { return value }

fn applyValue(f: for<'a, 'b: 'a> fn(&'b i32) -> &'a i32, value: i32) -> i32 {
  let local = value
  let held = f(&local)
  return held.*
}

pub fn main() -> i32 {
  return applyNamed(20) + applyValue(same, 22)
}
