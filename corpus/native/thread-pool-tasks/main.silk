import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.collections.list { List }
import silk.concurrency.thread_native { SpawnError }
import silk.core.result { Result }
import silk.concurrency.sync { Arc }
import silk.concurrency.thread_pool { Pool, TaskHandle, ThreadPool }

effect fn sum(from: i64, to: i64) -> i64 {
  let mut total: i64 = 0
  let mut at = from
  while at < to {
    total = total + at
    at = at + 1
  }
  return total
}

// Many independent tasks joined in order.
effect fn fanOut(pool: Pool) -> i64 ! OutOfMemoryError {
  let mut handles = List<TaskHandle<i64>>.make()
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut at: i64 = 0
  while at < 1000 {
    let handle = run pool.spawn(sum(at * 100, at * 100 + 100))
    run List<TaskHandle<i64>>.append(&mut handles, move handle) |> Effect.provideMut<Allocator>(&mut allocator)
    at = at + 1
  }
  let mut total: i64 = 0
  while List<TaskHandle<i64>>.length(&handles) > 0 {
    let handle = List<TaskHandle<i64>>.remove(&mut handles, 0)
    let value = run handle.join()
    total = total + value
  }
  return total
}

// A chain of tasks, each joining the next, so every one parks.
effect fn chain(pool: Pool, depth: i64) -> i64 {
  if depth == 0 { return 1 }
  let next = run Effect.result(pool.spawn(chain(pool.clone(), depth - 1)))
  return match move next {
    Result<TaskHandle<i64>, OutOfMemoryError>.Success { value } => 1 + run value.join()
    Result<TaskHandle<i64>, OutOfMemoryError>.Failure { error } => -1000000
  }
}

// Detached tasks holding Arc markers, left for the pool's drop.
effect fn detach(pool: Pool, marker: Arc<i32>) -> i64 ! OutOfMemoryError {
  let mut at = 0
  while at < 50 {
    let copy = marker.clone()
    let handle = run pool.spawn(hold(move copy))
    drop handle
    at = at + 1
  }
  return 0
}

effect fn hold(marker: Arc<i32>) -> i64 {
  let value = marker.get()
  return 0
}

effect fn program() -> i32 ! OutOfMemoryError | SpawnError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let marker = run Arc<i32>.make(7) |> Effect.provideMut<Allocator>(&mut allocator)
  let threads = run ThreadPool.make(4) |> Effect.provideMut<Allocator>(&mut allocator)
  let pool = threads.pool()
  let fan = run pool.block(Effect.result(fanOut(pool.clone())))
  if !matches(move fan, 4999950000) { return 1 }
  let depth = run pool.block(chain(pool.clone(), 200))
  if depth != 201 { return 2 }
  let detached = run pool.block(Effect.result(detach(pool.clone(), marker.clone())))
  drop detached
  drop pool
  drop threads
  if marker.count() != 1 { return 4 }
  return 42
}

fn matches(outcome: Result<i64, OutOfMemoryError>, expected: i64) -> bool {
  return match move outcome {
    Result<i64, OutOfMemoryError>.Success { value } => value == expected
    Result<i64, OutOfMemoryError>.Failure { error } => false
  }
}

effect fn recover(error: OutOfMemoryError | SpawnError) -> i32 { return -2 }
pub fn main() -> i32 { return run Effect.catchAll(program(), recover) }
