import silk.io.writer_native { StdoutWriter }
import silk.core.effect { Effect }
import silk.num.f32
import silk.num.f64
import silk.text.format { Alignment, Format, FormatOptions, Sign, Style }
import silk.core.option { Option }
import silk.io.writer { Writer, WriterError }

effect fn render() -> () ! WriterError ? &mut Writer {
  // Shortest significands, with exponents above, at, and below zero.
  run Format.format("{:e} {:e} {:e} {:e} {:e}\n", &(1234.5, 1.0, 0.00125, 100.0, 0.0 - 2.5))
  run Format.format("{:E} {:e} {:e}\n", &(1234.5, 0.0, 1e300))
  // The extremes of f64 and an f32, whose digits come from the f32 value.
  let tiny = f64.fromBits(1)
  let small: f32 = 0.1
  run Format.format("{:e} {:e} {:e}\n", &(tiny, f64.fromBits(9218868437227405311), small))
  // A precision fixes the fractional digits and rounds half to even, carrying into the exponent.
  run Format.format("{:.2e} {:.0e} {:.1e} {:.3e} {:.2e}\n", &(1234.5, 2.5, 9.96, 0.0, 1.0))
  // Sign, width, alignment, and zero padding apply.
  run Format.format("[{:+e}] [{:>10e}] [{:<9.1E}] [{:010.2e}]\n", &(1.5, 1.5, 0.0 - 1.5, 0.0 - 1234.5))
  // NaN and infinity are the same in every style.
  run Format.format("{:e} {:E}\n", &(f64.fromBits(9221120237041090560), f64.fromBits(18442240474082181120)))
  // FormatOptions selects the style for Format.displayWith; integers ignore it.
  let options = FormatOptions {
    width: Option<usize>.none(), alignment: Alignment.Default, fill: ' ', sign: Sign.NegativeOnly,
    alternate: false, zeroPad: false, precision: Option<usize>.none(), color: false,
    style: Style.UpperExp,
  }
  run Format.displayWith(&0.5, move options)
  run Writer.writeAll(b" ")
  let integerOptions = FormatOptions {
    width: Option<usize>.none(), alignment: Alignment.Default, fill: ' ', sign: Sign.NegativeOnly,
    alternate: false, zeroPad: false, precision: Option<usize>.none(), color: false,
    style: Style.UpperExp,
  }
  run Format.displayWith(&42, move integerOptions)
  return run Writer.writeAll(b"\n")
}

effect fn build() -> i32 ! WriterError {
  let mut writer = StdoutWriter.make()
  run render() |> Effect.provideMut<Writer>(&mut writer)
  return 42
}
effect fn recover(error: WriterError) -> i32 { return 1 }
pub fn main() -> i32 { return run Effect.catchAll(build(), recover) }
