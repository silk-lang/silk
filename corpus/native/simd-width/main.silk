import silk.simd.simd
import silk.simd.u8x16
import silk.core.target {Arch, Target}

// The default profile selects only the architecture baseline, so the preferred width is one
// 128-bit vector and the CPU runs it in hardware.
pub fn main() -> i32 {
  static if Target.arch() == Arch.X86_64 {
    static if !Target.hasCpuFeature("sse2") || Target.hasCpuFeature("sse3") {
      return 1
    }
  }
  if simd.preferredBytes() != 16 || simd.preferredBytes() != u8x16.LANES {
    return 2
  }
  static if !simd.hardware() {
    return 3
  }
  return 0
}
