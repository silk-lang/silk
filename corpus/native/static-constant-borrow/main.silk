import silk.i32
import silk.u16
import silk.usize

enum Kind { Plain, Bold, Italic }

struct Glyph {
  code: u8,
  advance: i32,
  kind: Kind,
  wide: bool,
  scale: f32,
  name: string<'static>,
}

const GLYPHS: [Glyph; 3] = [
  Glyph { code: 65, advance: -7, kind: Kind.Bold, wide: true, scale: 1.5, name: "A" },
  Glyph { code: 66, advance: 600, kind: Kind.Plain, wide: false, scale: -0.25, name: "" },
  Glyph { code: 67, advance: 2147483647, kind: Kind.Italic, wide: true, scale: 3.0, name: "glyph C" },
]

const PRIMES: [u16; 5] = [2, 3, 5, 7, 11]

const GRID: [[i64; 2]; 2] = [[-1, 2], [3, -9223372036854775807]]

const ORIGIN: Glyph = Glyph { code: 0, advance: 0, kind: Kind.Plain, wide: false, scale: 0.0, name: "origin" }

struct Table<'s> {
  primes: &'s [u16],
  first: &'s Glyph,
}

fn glyphs() -> &'static [Glyph] {
  return &GLYPHS
}

fn primes() -> &'static [u16] {
  return &PRIMES
}

fn row(at: usize) -> &'static [i64; 2] {
  return &GRID[at]
}

fn named(at: usize) -> &'static string<'static> {
  return &GLYPHS[at].name
}

fn origin() -> &'static Glyph {
  return &ORIGIN
}

fn table<'s>() -> Table<'s> {
  return Table { primes: &PRIMES, first: &GLYPHS[0] }
}

fn sum(values: &[u16]) -> usize {
  let mut total: usize = 0
  let mut at: usize = 0
  while at < values.length {
    total = total + u16.toUsize(values[at])
    at = at + 1
  }
  return total
}

pub fn main() -> i32 {
  let all = glyphs()
  if all.length != 3 || all[0].code != 65 || all[1].advance != 600 || all[2].advance != 2147483647 { return 1 }
  if all[0].advance != -7 || !all[0].wide || all[1].wide || all[0].scale != 1.5 || all[1].scale != -0.25 { return 2 }
  if let Kind.Italic = all[2].kind {} else { return 3 }
  if all[0].name != "A" || all[1].name != "" || named(2).* != "glyph C" { return 4 }
  if sum(primes()) != 28 { return 5 }
  if row(0)[0] != -1 || row(1)[1] != -9223372036854775807 || row(1)[0] != 3 { return 6 }
  if origin().name != "origin" || origin().advance != 0 { return 7 }
  let t = table()
  if t.primes[4] != 11 || t.first.code != 65 { return 8 }
  // A mutable borrow still lends its own copy.
  let mut copy = PRIMES
  copy[0] = 9
  if PRIMES[0] != 2 || copy[0] != 9 { return 9 }
  return 42
}
