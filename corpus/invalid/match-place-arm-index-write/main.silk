struct Token { value: i32 }
union Packet { Empty, Ready { left: Token, right: Token } }
fn probe(at: usize) -> i32 {
  let mut packets = [Packet.Ready { left: Token { value: 1 }, right: Token { value: 2 } }, Packet.Ready { left: Token { value: 1 }, right: Token { value: 2 } }]
  let mut out = 0
  match place packets[0] {
    Packet.Ready { left, .. } => {
      packets[at] = Packet.Empty
      out = left.value
    }
    Packet.Empty => {}
  }
  return out
}
pub fn main() -> i32 { return probe(0) }