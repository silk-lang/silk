// A group under `?` can be unset, so its field must be an Option.
import silk.core.option { Option }
import silk.text.regex { Regex, Typed }

/// A Silk release version, as in v0.1.0-dev.58+fb6ce3a.
struct Version<'a> {
  pub major: string<'a>,
  pub minor: string<'a>,
  pub patch: string<'a>,
  pub pre: string<'a>,
  pub build: Option<string<'a>>,
}

const VERSION: Typed<Version<'static>> = Regex.typed<Version<'static>>(
  "^v(?<major>\\d+)\\.(?<minor>\\d+)\\.(?<patch>\\d+)(-(?<pre>[0-9A-Za-z.]+))?(\\+(?<build>[0-9a-f]+))?$",
)

pub fn main() -> i32 {
  if VERSION.pattern() == "" {
    return 1
  }
  return 0
}
