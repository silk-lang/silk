// A default operation body is checked where its contract is declared, even when no conformance
// uses it.
interface Shape {
  fn area(self: &Self) -> i32

  fn doubled(self: &Self) -> i32 {
    return true
  }
}

service Clock {
  effect fn now() -> i64 ? &Clock

  effect fn later() -> i64
    ? &Clock {
    return run Clock.missing()
  }
}

pub fn main() -> i32 {
  return 0
}
