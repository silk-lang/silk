import silk.core.option {Option}
struct Token { value: i32 }
fn take(token: Token) -> i32 { return token.value }
// A consuming subject that the body does not restore cannot repeat (LOOP-001).
fn unrestored(start: Option<Token>) -> i32 {
  let mut current = move start
  let mut seen = 0
  while let Option<Token>.Some { value: token } = move current {
    seen = seen + take(move token)
  }
  return seen
}
// A mismatch consumes the subject too, so it is unavailable after the loop (PATT-008).
fn usedAfter(start: Option<Token>) -> i32 {
  let mut current = move start
  while let Option<Token>.Some { value: token } = move current {
    current = Option<Token>.some(move token)
    break
  }
  let after = move current
  drop after
  return 0
}
// A borrowed binding cannot leave the iteration that tested it (PATT-009).
fn escaped(source: Option<Token>) -> i32 {
  let mut kept = Token { value: 0 }
  while let Option<Token>.Some { value: token } = &source {
    kept = move token
    break
  }
  return take(move kept)
}
pub fn main() -> i32 { return unrestored(Option<Token>.none()) + usedAfter(Option<Token>.none()) + escaped(Option<Token>.none()) }
