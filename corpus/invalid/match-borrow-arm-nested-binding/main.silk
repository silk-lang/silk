struct Token { value: i32 }
union Packet { Empty, Ready { left: Token, right: Token } }
struct Holder {
  held: Packet,
  count: i32,
}
fn ready() -> Packet { return Packet.Ready { left: Token { value: 1 }, right: Token { value: 2 } } }
fn clear(packet: &mut Packet) -> i32 { return 0 }
fn bump(token: &mut Token) -> () {
  token.value = token.value + 1
  return ()
}
fn probe() -> i32 {
  let mut h = Holder { held: ready(), count: 0 }
  let mut out = 0
  match &h {
    Holder { held, .. } => match &held {
      Packet.Ready { left, .. } => {
        h = Holder { held: Packet.Empty, count: 1 }
        out = left.value
      }
      Packet.Empty => {}
    }
  }
  return out
}
pub fn main() -> i32 { return probe() }
