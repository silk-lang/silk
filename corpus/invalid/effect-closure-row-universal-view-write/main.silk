struct Token { value: i32 }
struct Box1 { t: Token }
struct Holder<'h> { view: &'h Token }
service Keeper<'k> { effect fn put(v: &'k Token) -> () ? &mut Keeper<'k> }
effect fn probe<'a: 'b, 'b>(src: &'a mut Box1) -> () ? &mut Keeper<'b> {
  let held = Holder<'a> { view: &src.t }
  let view = held.view
  let mut work = effect fn() -> () ? &mut Keeper<'b> { run Keeper<'b>.put(view) }
  run work()
  src.t = Token { value: 9 }
  return ()
}
pub fn main() -> i32 { return 0 }
