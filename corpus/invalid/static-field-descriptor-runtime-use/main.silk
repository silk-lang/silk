import silk.core.reflect { Reflect }
import silk.mem.layout { Layout }

struct Pair {
  pub first: i32,
  pub second: i64,
}

struct Plain {
  value: Pair,
}

static fn size<T, V>(field: Intrinsic.Field<T, V>) -> usize {
  return Layout.of<V>().bytes
}

impl Plain {
  fn width<V>(self: &Self, static field: Intrinsic.Field<Pair, V>) -> usize {
    return size(field)
  }
}

struct Holder<T> {
  value: T,
}

impl<T> Holder<T> {
  fn width<V>(self: &Self, static field: Intrinsic.Field<T, V>) -> usize {
    return size(field)
  }
}

fn take<X>(value: X) -> i32 { return 0 }

// A descriptor is phase-only: a runtime binding or a runtime argument cannot hold one.
pub fn main() -> i32 {
  let first = Reflect.field<Pair, i32>("first")
  return take(Reflect.field<Pair, i64>("second"))
}
