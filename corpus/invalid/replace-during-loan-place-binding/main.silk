struct Token { value: i32 }
union Packet { Empty, Ready { left: Token, right: Token } }
fn make() -> Token { return Token { value: 9 } }
fn read(token: &Token) -> i32 { return token.value }
pub fn main() -> i32 {
  let mut packet = Packet.Ready { left: Token { value: 1 }, right: Token { value: 2 } }
  let mut out = 0
  match place packet {
    Packet.Ready { left, .. } => {
      let view = &left
      let old = Intrinsic.replace(left, make())
      out = read(view) + old.value
    }
    Packet.Empty => {}
  }
  return out
}