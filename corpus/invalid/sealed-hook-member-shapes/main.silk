import silk.core.ownership { Copy, Drop }

struct Owned { v: i32 }
impl Drop for Owned { fn drop(self: Owned) -> () { return () } }

struct Viewed { v: i32 }
impl Drop for Viewed { fn drop(self: &Viewed) -> () { return () } }

struct Valued { v: i32 }
impl Drop for Valued { fn drop(self: &mut Valued) -> i32 { return 0 } }

struct Extra { v: i32 }
impl Drop for Extra {
  fn drop(self: &mut Extra) -> () { return () }
  fn more(self: &Extra) -> i32 { return self.v }
}

struct Empty { v: i32 }
impl Drop for Empty {}

struct Plain { v: i32 }
impl Copy for Plain { fn copy() -> () { return () } }

pub fn main() -> i32 {
  let owned = Owned { v: 1 }
  let viewed = Viewed { v: 2 }
  let valued = Valued { v: 3 }
  let extra = Extra { v: 4 }
  let empty = Empty { v: 5 }
  let plain = Plain { v: 6 }
  return 0
}
