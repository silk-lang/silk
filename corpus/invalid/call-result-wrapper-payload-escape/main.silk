struct Token { value: i32 }
union Maybe<T> { Nothing, Just { value: T } }
fn wrap<T>(value: T) -> Maybe<T> {
  return Maybe<T>.Just { value: move value }
}
fn probe<'s>(x: &'s Token) -> &'s Token {
  let owner = Token { value: 3 }
  let held = wrap(&owner)
  if let Maybe<&Token>.Just {value} = move held {
    return value
  }
  return x
}
pub fn main() -> i32 {
  let token = Token { value: 1 }
  return probe(&token).value
}
