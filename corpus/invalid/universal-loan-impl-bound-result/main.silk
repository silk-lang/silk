struct Res {
  value: i32
}

impl Intrinsic.Drop for Res {
  fn drop(self: &mut Res) -> () {
    return ()
  }
}

fn make(value: i32) -> Res {
  return Res { value: value }
}

fn read(res: &[Res]) -> i32 {
  return res[0].value
}

struct Pick<'a, 'b> {
  long: &'a [Res]
  short: &'b [Res]
}

// The impl bound lets `pick` return its first argument at the second argument's region.
impl<'a: 'b, 'b> Pick<'a, 'b> {
  fn pick(first: &'a [Res], second: &'b [Res]) -> &'b [Res] {
    return first
  }
}

pub fn main() -> i32 {
  let kept = [make(5)]
  let mut view: &[Res] = &kept
  // The temporary array ends with this statement while `view` still refers to it.
  view = Pick.pick(&[make(4)], &kept)
  return read(view) - 4
}
