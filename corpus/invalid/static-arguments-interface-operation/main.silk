// An interface operation with a static parameter cannot be called yet.
struct Spec {
  size: i32,
}

interface Walk {
  fn walk(self: &Self, static spec: Spec) -> i32
}

struct Leaf {
  value: i32,
}

impl Walk for Leaf {
  fn walk(self: &Leaf, static spec: Spec) -> i32 {
    return self.value * spec.size
  }
}

pub fn main() -> i32 {
  let leaf = Leaf {value: 3}
  return Walk.walk(&leaf, Spec {size: 2})
}
