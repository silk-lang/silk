import silk.core.effect { Effect }
struct Token { value: i32 }
effect fn peek(value: &Token) -> i32 { return value.value }
effect fn probe() -> i32 {
  let mut t = Token { value: 1 }
  let e = peek(&t)
  let f = effect { return run e }
  t = Token { value: 2 }
  return run f
}
pub fn main() -> i32 { return run probe() }
