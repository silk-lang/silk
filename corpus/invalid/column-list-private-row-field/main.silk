import silk.collections.column_list { ColumnList }
import silk.core.ownership { Copy }

struct Hidden {
  pub x: f32,
  id: u64,
}

impl Copy for Hidden {}

// Each field is a column the list reads by reflection, which sees only `pub` fields.
pub fn main() -> i32 {
  let hidden = ColumnList<Hidden>.make()
  return 0
}
