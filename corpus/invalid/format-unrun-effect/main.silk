import silk.core.effect { Effect }
import silk.io.logger { LogError, Logger }

// A value built by an `effect fn` call without `run` is an Effect, which a template cannot format.
effect fn next() -> u32 {
  return 4
}

effect fn program() -> () ! LogError ? &mut Logger {
  let random = next()
  run Effect.log("Random number: {}", &(random,))
}

pub fn main() -> i32 {
  let mut logger = Logger.inMemoryProvider()
  let outcome = run Effect.result(program() |> Effect.provideMut<Logger>(&mut logger))
  drop outcome
  return 0
}
