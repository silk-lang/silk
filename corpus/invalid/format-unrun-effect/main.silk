import silk.core.effect { Effect }
import silk.io.logger { Logger, InMemoryLogger }
import silk.concurrency.sync { Arc }
import silk.mem.allocator { Allocator, OutOfMemoryError }

// A value built by an `effect fn` call without `run` is an Effect, which a template cannot format.
effect fn next() -> u32 {
  return 4
}

effect fn program() -> () {
  let random = next()
  run Effect.log("Random number: {}", &.(random))
}

pub effect fn main() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let sink = run Logger.inMemoryProvider() |> Effect.provideMut<Allocator>(&mut allocator)
  let logger = run Arc<InMemoryLogger>.make(move sink) |> Effect.provideMut<Allocator>(&mut allocator)
  run program() |> Effect.provideAmbient<Logger>(&logger)
  return 0
}
