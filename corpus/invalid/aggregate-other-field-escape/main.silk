struct Token { value: i32 }
struct Pair<'a> { left: &'a Token, right: &'a Token }
fn probe<'s>(x: &'s Token) -> &'s Token {
  let local = Token { value: 2 }
  let mut pair = Pair { left: &local, right: &local }
  pair.right = x
  return pair.left
}
pub fn main() -> i32 {
  let token = Token { value: 1 }
  return probe(&token).value
}
