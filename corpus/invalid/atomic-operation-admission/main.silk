unsafe fn acquireStore(pointer: *mut u32) -> () {
  unsafe { Intrinsic.atomicStore<u32>(pointer, 1, "acquire") }
}
unsafe fn floatingAdd(pointer: *mut f64) -> f64 {
  unsafe { return Intrinsic.atomicFetchAdd<f64>(pointer, 1.0, "relaxed") }
}
unsafe fn releasingFailure(pointer: *mut u32, expected: *mut u32) -> bool {
  unsafe { return Intrinsic.atomicCompareExchange<u32>(pointer, expected, 2, "sequentiallyConsistent", "release") }
}
pub fn main() -> i32 {
  Intrinsic.atomicFence("seqCst")
  return 0
}
