// Swapping two unrelated type arguments is not a descent: `B` does not lie within the owned
// structure of `A`, so the recursion is refused (GEN-006).
pub struct A {
  pub value: i32,
}

pub struct B {
  pub value: i64,
}

fn hop<T, U>(depth: i32) -> i32 {
  if depth == 0 { return 0 }
  return hop<U, T>(depth - 1)
}

pub fn main() -> i32 {
  return hop<A, B>(3)
}
