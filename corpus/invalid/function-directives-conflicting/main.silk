@inline
@inline
fn twice() -> i32 { return 1 }
@cold
@inlineNever
fn giveUp() -> i32 { return -1 }
pub fn main() -> i32 { return twice() + giveUp() }
@foreign(memory: "none")
@foreign(memory: "read")
unsafe extern "C" fn abs(value: i32) -> i32
@foreign(memory: "read")
@foreign(locality: "arguments")
unsafe extern "C" fn strlen(text: *const u8) -> usize
