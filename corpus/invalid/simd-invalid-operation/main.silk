// Lane operations admit only the lane classes and shapes their rules name (SIMD-004, SIMD-005).
pub fn main() -> i32 {
  let floats = Intrinsic.simdSplat<simd<f32, 4>>(1.0)
  let bytes = Intrinsic.simdSplat<simd<u8, 16>>(1)
  let a = Intrinsic.simdShiftLeft<simd<f32, 4>>(floats, floats)
  let b = Intrinsic.simdSqrt<simd<u8, 16>>(bytes)
  let c = Intrinsic.simdMaskAny<simd<u8, 16>>(bytes)
  let d = Intrinsic.simdConvert<simd<u8, 16>, simd<f32, 4>>(bytes)
  let e = Intrinsic.simdBitcast<simd<u8, 16>, simd<u64, 4>>(bytes)
  let f = Intrinsic.simdReduceAddUnordered<simd<u8, 16>>(bytes)
  return 0
}
