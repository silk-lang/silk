// Method syntax on a union finds the operation through the first member, then proves the union
// itself conforms. `twin` returns `Self`, so it cannot dispatch on the tag (UNION-003).
interface Twin {
  fn twin(self: &Self) -> Self
}

struct Alpha { pub code: i32 }

struct Beta { pub hits: i32 }

impl Twin for Alpha {
  fn twin(self: &Self) -> Self { return Alpha { code: self.code } }
}

impl Twin for Beta {
  fn twin(self: &Self) -> Self { return Beta { hits: self.hits } }
}

fn pick(flag: bool) -> Alpha | Beta {
  if flag { return Alpha { code: 7 } }
  return Beta { hits: 0 }
}

pub fn main() -> i32 {
  let value = pick(true)
  let copied = value.twin()
  return 0
}
