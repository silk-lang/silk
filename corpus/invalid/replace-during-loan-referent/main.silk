struct Token { value: i32 }
fn make() -> Token { return Token { value: 9 } }
fn read(token: &Token) -> i32 { return token.value }
fn probe(token: &mut Token) -> i32 {
  let view = &token.*
  let old = Intrinsic.replace(token.*, make())
  return read(view) + old.value
}
pub fn main() -> i32 { return 0 }