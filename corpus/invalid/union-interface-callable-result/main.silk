interface Factory {
  fn make(self: &Self) -> fn(i32) -> i32
}

struct Add {}
struct Scale {}

fn add(value: i32) -> i32 { return value + 1 }
fn scale(value: i32) -> i32 { return value * 2 }

impl Factory for Add {
  fn make(self: &Self) -> fn(i32) -> i32 { return add }
}

impl Factory for Scale {
  fn make(self: &Self) -> fn(i32) -> i32 { return scale }
}

fn use(value: &(Add | Scale)) -> i32 {
  let f = Factory.make(value)
  return f(10)
}

pub fn main() -> i32 {
  let left: Add | Scale = Add {}
  let right: Add | Scale = Scale {}
  return use(&left) + use(&right)
}
