// A `Without` row written as a nominal's row argument keeps every requirement it does not
// remove. `Task<'static, Without<&Clock | &Logger, Logger>>` still requires `Clock`, so it
// cannot hold an Effect that also requires `Logger`, and running its job needs `Clock`.
import silk.effect { Effect }

service Clock {}

service Logger {}

struct Task<'a, ?R> {
  job: once Effect<'a; i32 ? R>
}

effect fn work() -> i32 ? &Clock | &Logger {
  return 1
}

fn packed() -> Task<'static, Without<&Clock | &Logger, Logger>> {
  return Task { job: work() }
}

fn runsUnprovided(task: Task<'static, Without<&Clock | &Logger, Logger>>) -> i32 {
  return run task.job
}

pub fn main() -> i32 {
  return 0
}
