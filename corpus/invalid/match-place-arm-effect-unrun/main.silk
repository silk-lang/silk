import silk.core.effect { Effect }
struct Token { value: i32 }
union Packet { Empty, Ready { left: Token, right: Token } }
fn reset(packet: &mut Packet) -> () {
  packet.* = Packet.Empty
  return ()
}
effect fn probe() -> i32 {
  let mut packet = Packet.Ready { left: Token { value: 1 }, right: Token { value: 2 } }
  let mut out = 0
  match place packet {
    Packet.Ready { left, .. } => {
      let pending = effect {
        packet = Packet.Empty
        return ()
      }
      out = left.value
    }
    Packet.Empty => {}
  }
  return out
}
pub fn main() -> i32 { return run probe() }