import silk.core.ownership { Copy }
import silk.core.ops { Add }

struct Name {}
impl Copy for Name {}
struct Pair<T> { left: T, right: T }

// `sum` exists only where `T` adds; `swapped` exists for every `T` (IMPL-006).
impl<T: Copy + Add<T, T>> Pair<T> {
  fn sum(self: Self) -> T { return self.left + self.right }
}
impl<T: Copy> Pair<T> {
  fn swapped(self: Self) -> Self { return Pair<T> { left: self.right, right: self.left } }
}

fn names(pair: Pair<Name>) -> () {
  let swapped = pair.swapped()
  let viaMethod = swapped.sum()
  let viaOwner = Pair<Name>.sum(swapped)
}

pub fn main() -> i32 { return 0 }
