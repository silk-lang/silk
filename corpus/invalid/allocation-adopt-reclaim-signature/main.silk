import silk.mem.layout { Layout }

export "C" fn wrongReclaim(context: usize) -> () {
  return ()
}

fn adopt(base: *mut u8, context: ?*mut u8) -> Intrinsic.Allocation {
  let reclaim: extern "C" fn(usize) -> () = wrongReclaim
  return unsafe Intrinsic.allocationAdopt(base, Layout.of<u8>(), reclaim, context)
}

pub fn main() -> i32 {
  return 0
}
