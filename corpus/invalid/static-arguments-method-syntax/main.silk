// Method syntax cannot supply static arguments yet: write `Leaf.own(&leaf, spec)`.
struct Spec {
  size: i32,
}

struct Leaf {
  value: i32,
}

impl Leaf {
  fn own(self: &Leaf, static spec: Spec) -> i32 {
    return self.value + spec.size
  }
}

pub fn main() -> i32 {
  let leaf = Leaf {value: 3}
  return leaf.own(Spec {size: 2})
}
