// A constant pattern with a directive that the value cannot supply, an hour of a date, is refused
// where it is used.
import silk.core.effect { Effect }
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StdoutWriter }
import silk.time.pattern { TimePattern }
import silk.time.plain_date { PlainDate }

pub effect fn main() -> i32 ! WriterError {
  let mut out = StdoutWriter.make()
  let date = PlainDate.make(2026, 11, 19)
  run TimePattern.write("%Y-%m-%d %H:%M", &date)
    |> Effect.provideMut<Writer>(&mut out)
  return 0
}
