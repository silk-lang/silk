// `StaticText.errorAt` points inside the literal a static text came from, at the characters its
// bytes are written as: each escape before the reported byte counts as the source it spells.
import silk.core.static_text { StaticText }

static fn checked(template: string<'static>) -> string<'static> {
  let length = StaticText.byteLength(template)
  let mut at: usize = 0
  while at < length {
    // 37 is the byte of `%`.
    if StaticText.byteAt(template, at) == 37 {
      StaticText.errorAt(template, at, at + 2, "use {} instead of a % directive")
    }
    at = at + 1
  }
  return template
}

pub fn main() -> i32 {
  let text = checked("tab\t\u{e9}t\u{e9}\\ %d")
  return 0
}
