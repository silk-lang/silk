import silk.core.ownership { Drop }
struct Token { value: i32 }
impl Drop for Token { fn drop(self: &mut Token) -> () { self.value = 0  return () } }
union Slot { Full { token: Token }, Empty }
struct Carrier { slot: Slot, tag: Token }
fn carrier() -> Carrier { return Carrier { slot: Slot.Full { token: Token { value: 8 } }, tag: Token { value: 9 } } }
pub fn main() -> i32 {
  match move carrier().slot {
    Slot.Full { token } => { return token.value }
    Slot.Empty => { return 0 }
  }
}
