interface Step { fn step(self: &Self) -> i32 }
struct Wrapper<T> {}
impl<T> Step for Wrapper<T> { fn step(self: &Self) -> i32 { return nest<T>() } }
fn nest<T>() -> i32 { let next = Wrapper<Wrapper<T>> {} return call(&next) }
fn call(p: &any Step) -> i32 { return p.step() }
pub fn main() -> i32 { let start = Wrapper<i32> {} return call(&start) }
