// A constant pattern that does not give what the type needs, a date without a year, is refused
// where it is used.
import silk.core.result { Result }
import silk.time.pattern { TimePattern }
import silk.time.plain_date { PlainDate }
import silk.time.text { TimeParseError }

pub fn main() -> i32 {
  return match TimePattern.parse<PlainDate>("%m/%d", "11/19") {
    Result<PlainDate, TimeParseError>.Success {..} => 0
    Result<PlainDate, TimeParseError>.Failure {..} => 1
  }
}
