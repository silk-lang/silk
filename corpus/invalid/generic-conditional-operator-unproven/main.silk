// An operator whose conformance needs a bound the generic body does not declare is not selected
// through that conformance: its condition is reported unproved at the operator.
import silk.core.ownership { Copy }
import silk.core.ops { Multiply }

struct Point<T> {
  x: T,
}

impl<T: Copy> Copy for Point<T> {}

struct Scale<T> {
  k: T,
}

impl<T: Copy> Copy for Scale<T> {}

impl<T: Copy + Multiply<T, T>> Multiply<Point<T>, Point<T>> for Scale<T> {
  fn multiply(left: Self, right: Point<T>) -> Point<T> { return Point<T> { x: left.k * right.x } }
}

fn apply<T: Copy>(scale: Scale<T>, x: T) -> Point<T> {
  return scale * Point<T> { x: x }
}

pub fn main() -> i32 {
  return apply<i32>(Scale<i32> { k: 3 }, 2).x
}
