//! `functionRef<F>` takes only a function of exactly the contract `F` it erases.

fn isEven(value: u64) -> bool { return value % 2 == 0 }

static fn reference() -> Intrinsic.FunctionRef {
  return Intrinsic.functionRef<fn<'static>(&u32) -> bool>(isEven)
}

pub fn main() -> i32 {
  let static _held = reference()
  return 0
}
