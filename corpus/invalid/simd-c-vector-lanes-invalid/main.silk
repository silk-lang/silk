// A mask or pointer-sized lane has no C vector type, in an import or an export (SEM0187).
unsafe extern "C" fn flags(values: mask<4>) -> i32
unsafe extern "C" fn sizes(values: simd<usize, 2>) -> i32

export "C" fn selected(values: mask<4>) -> i32 { return 0 }

pub fn main() -> i32 {
  let first = unsafe flags(Intrinsic.simdSplat<mask<4>>(false))
  let second = unsafe sizes(Intrinsic.simdSplat<simd<usize, 2>>(1))
  return first + second
}
