import silk.core.ownership { Drop }
struct Token { value: i32 }
impl Drop for Token { fn drop(self: &mut Token) -> () { self.value = 0  return () } }
tuple Tokens(Token, Token)
fn tokens() -> Tokens { return (Token { value: 1 }, Token { value: 2 }) }
pub fn main() -> i32 {
  let second = tokens().1
  return second.value
}
