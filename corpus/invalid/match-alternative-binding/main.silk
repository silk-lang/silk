// Alternatives in one arm may not bind names, and a range must select at least one value.
union Shape { Dot, Circle {pub r: u32} }

fn size(shape: Shape) -> u32 {
  return match move shape {
    Shape.Dot | Shape.Circle {r} => 1
  }
}

fn digit(x: i32) -> i32 {
  return match x {
    5..5 => 1
    _ => 0
  }
}

pub fn main() -> i32 { return digit(1) }
