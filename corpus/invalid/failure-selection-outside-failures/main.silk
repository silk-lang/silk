import silk.core.effect { Effect }

pub struct Missing {}
pub struct Denied {}
struct Other {}

effect fn pick<'env, S, A, E>(work: once Effect<'env; A ! E>, fallback: A) -> A ! E
where S in E {
  return run move work
}

effect fn load() -> i32 ! Missing | Denied {
  fail Missing {}
}

pub effect fn main() -> i32 ! Missing | Denied {
  return run pick<Other>(load(), 1)
}
