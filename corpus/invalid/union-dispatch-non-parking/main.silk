import silk.concurrency.execution { Execution }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }

interface Close {
  @nonParking
  effect fn close(self: &Self) -> ()
}

struct Quiet {}
struct Parks {}

impl Close for Quiet {
  effect fn close(self: &Self) -> () {}
}

impl Close for Parks {
  effect fn close(self: &Self) -> () { return run Intrinsic.relinquish() }
}

effect fn work() -> i32 {
  let value: Quiet | Parks = Quiet {}
  run Close.close(&value)
  return 0
}

fn ready(state: &()) -> () {}

pub effect fn main() -> i32 ! OutOfMemoryError {
  let mut system = Allocator.systemAllocatorProvider()
  let package = run Execution.make(work(), (), ready) |> Effect.provideMut<Allocator>(&mut system)
  drop package
  return 0
}
