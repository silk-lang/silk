import silk.effect { Effect }

struct Overdrawn {}
struct Frozen {}

effect fn withdraw(amount: i32) -> i32 ! Overdrawn | Frozen {
  if amount > 100 { fail Overdrawn {} }
  if amount < 0 { fail Frozen {} }
  return amount
}

effect fn onShort(failure: Overdrawn) -> i32 {
  return 1
}

effect fn onAny(failure: Overdrawn | Frozen) -> i32 {
  return 2
}

pub effect fn main() -> i32 {
  return run Effect.catch(withdraw(50), onShort) |> Effect.catchAll(onAny)
}
