import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.mem.pointer { Pointer }

struct Task { id: i32 }

// `get` and `Pointer.read` copy their element out, so they need `T: Copy`.
effect fn first() -> () ! OutOfMemoryError ? &mut Allocator {
  let mut tasks = List<Task>.make()
  run tasks.append(Task { id: 1 })
  let found = tasks.get(0)
}

fn read(task: *const Task) -> i32 {
  let copied = unsafe Pointer.read(task)
  return 0
}

pub fn main() -> i32 { return 0 }
