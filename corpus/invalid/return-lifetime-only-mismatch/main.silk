// A List is invariant in its element, so a list of `Name<'b>` is not a list of `Name<'a>`. SEM0129
// names both types and notes that they differ only in their lifetimes.
import silk.collections.list { List }

struct Name {
  text: string,
}

fn pick<'a, 'b>(x: string<'a>, y: string<'b>) -> List<Name<'a>> {
  let names = List<Name<'b>>.make()
  return move names
}

pub fn main() -> i32 {
  return 0
}
