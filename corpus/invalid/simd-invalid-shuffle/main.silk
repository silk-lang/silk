// A shuffle index is below twice the operand lane count, and both vectors share one lane type
// (SIMD-006).
pub fn main() -> i32 {
  let a = Intrinsic.simdSplat<simd<u32, 4>>(1)
  let b = Intrinsic.simdShuffle<simd<u32, 4>, simd<u32, 4>>(a, a, [0, 1, 2, 8])
  let c = Intrinsic.simdShuffle<simd<u32, 4>, simd<i32, 4>>(a, a, [0, 1, 2, 3])
  return 0
}
