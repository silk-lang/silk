import silk.core.effect { Effect }
import silk.core.reflect { Reflect }

// An `effect {}` block in a `static for` body is refused at the block: every unrolled iteration
// would share its one declaration.
struct Pair {
  pub left: i32,
  pub right: i32,
}

effect fn again<'env, A, E, ?R>(mut action: mut Effect<'env; A ! E ? R>) -> A ! E ? R {
  return run action
}

effect fn one() -> i32 {
  return 1
}

effect fn count<T>() -> i32 {
  let mut total = 0
  static for field in Reflect.fields<T>() {
    let got = run again(effect { return run one() })
    total = total + got
  }
  return total
}

pub fn main() -> i32 {
  let total = run count<Pair>()
  return total + 40
}
