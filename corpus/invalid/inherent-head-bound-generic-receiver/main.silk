struct Token { value: i32 }
struct Boxed<A> { value: A }
impl<A: 'static> Boxed<A> {
  fn read(self: &Self, extra: &Token) -> i32 { return extra.value }
}
fn generic<T>(boxed: &Boxed<T>, extra: &Token) -> i32 {
  return boxed.read(extra)
}
pub fn main() -> i32 {
  let token = Token { value: 1 }
  let boxed = Boxed { value: &token }
  return generic(&boxed, &token)
}
