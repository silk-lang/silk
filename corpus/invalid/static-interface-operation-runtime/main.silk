// A static interface operation runs only during static evaluation.
interface Arg {
  static fn takesValue() -> bool
}

struct Flag {}

impl Arg for Flag {
  static fn takesValue() -> bool {
    return false
  }
}

fn takes<T: Arg>() -> bool {
  return Arg.takesValue()
}

pub fn main() -> i32 {
  if takes<Flag>() {
    return 1
  }
  return 0
}
