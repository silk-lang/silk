struct Token { value: i32 }
struct View<'a> { left: &'a Token }
struct Outer<'a> { inner: View<'a> }
union Slot<'a> { Vacant, Held { token: &'a Token } }
fn returned<'s>(x: &'s Token) -> View<'s> {
  let local = Token { value: 3 }
  return View { left: &local }
}
fn throughBinding<'s>(x: &'s Token) -> View<'s> {
  let local = Token { value: 3 }
  let r = &local
  return View { left: r }
}
fn stored<'s>(out: &mut View<'s>) -> () {
  let local = Token { value: 3 }
  out.* = View { left: &local }
}
fn storedBinding<'s>(out: &mut View<'s>) -> () {
  let local = Token { value: 3 }
  let view = View { left: &local }
  out.* = move view
}
fn nested<'s>(x: &'s Token) -> Outer<'s> {
  let local = Token { value: 3 }
  return Outer { inner: View { left: &local } }
}
fn parameter<'s>(owned: Token, x: &'s Token) -> View<'s> {
  return View { left: &owned }
}
fn variant<'s>(x: &'s Token) -> Slot<'s> {
  let local = Token { value: 3 }
  return Slot.Held { token: &local }
}
fn element<'s>(x: &'s Token) -> [&'s Token; 2] {
  let local = Token { value: 3 }
  return [x, &local]
}
pub fn main() -> i32 { return 0 }
