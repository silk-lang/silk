struct Token { value: i32 }
fn read(token: &Token) -> i32 { return token.value }
pub fn main() -> i32 {
  let mut tokens = [Token { value: 1 }, Token { value: 2 }]
  let first = &tokens[0]
  let old = Intrinsic.replace(tokens, [Token { value: 3 }, Token { value: 4 }])
  drop old
  return read(first)
}