// A method named with a reserved word is a parse error, as for a free function, and not an
// internal compiler error.
struct Kernel {
  n: u32,
}

impl Kernel {
  fn run(self: &Self) -> u32 {
    return self.n
  }

  fn match(self: &Self) -> u32 {
    return self.n
  }
}

pub fn main() -> i32 {
  return 0
}
