// Every C boundary rule the build relies on is a check-time error at the declaration.
export "C" fn sink(value: ()) -> () { return () }
export "C" fn logged(format: ?[*]const u8, ...) -> i32 { return 0 }
unsafe extern "C" fn noFixed(...) -> i32
fn silkVariadic(value: i32, ...) -> i32 { return value }
unsafe extern "C" fn defined(value: i32) -> i32 { return value }
extern "C" static errnoValue: i32 as "errno"

pub fn main() -> i32 { return 0 }
