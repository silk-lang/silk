import silk.core.ownership { Drop }
import silk.core.effect { Effect }
struct Tok { value: i32 }
impl Drop for Tok { fn drop(self: &mut Tok) -> () { self.value = 0  return () } }
struct Both { a: Tok, b: Tok }
fn mkBoth() -> Both { return Both { a: Tok { value: 1 }, b: Tok { value: 2 } } }
fn take(t: Tok) -> i32 { return t.value }
pub fn main() -> i32 {
  let both = mkBoth()
  let f = fn() -> i32 { let r = both.a  return r.value }
  return f()
}
