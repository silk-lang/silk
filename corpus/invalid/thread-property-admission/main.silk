import silk.mem.pointer { Pointer }
import silk.mem.shared { Shared }
import silk.concurrency.thread { Concurrent, Transferable }
struct Raw { base: *mut i32 }
struct Owned { base: *mut i32 }
impl Concurrent for Raw {
  fn touch(self: &Raw) -> () {}
}
fn send<T: Transferable>(value: T) -> () {}
fn share<T: Concurrent>(value: &T) -> () {}
fn widen<T>(value: T) -> () { send(move value) }
fn borrowAcross<T: Transferable>(value: &T) -> () { send(value) }
fn sendOwned(owned: Owned) -> () { send(move owned) }
fn sendShared(counter: Shared<i32>) -> () { send(move counter) }
pub fn main() -> i32 {
  let mut slot = 1
  send(Pointer.fromMutRef(&mut slot))
  return 0
}
