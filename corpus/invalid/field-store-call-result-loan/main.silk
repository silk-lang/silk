// A call result stored into caller-owned storage keeps the loans its arguments lend it. Each
// write below stores a borrow of `local` into storage that outlives its function, so each is
// rejected at the borrow, exactly where the let-bound form reports.
struct Token {
  value: i32
}

struct View<'a> {
  left: &'a Token
}

struct Pair<'a> {
  items: [&'a Token; 2]
}

fn widen<'a, 'b: 'a>(value: &'b Token) -> &'a Token {
  return value
}

fn same<'a>(value: &'a Token) -> &'a Token {
  return value
}

fn wrap<'a>(value: &'a Token) -> View<'a> {
  return View { left: value }
}

fn putWidened<'s>(out: &mut View<'s>) -> () {
  let local = Token { value: 3 }
  out.left = widen(&local)
}

fn putSame<'s>(out: &mut View<'s>) -> () {
  let local = Token { value: 3 }
  out.left = same(&local)
}

fn putBound<'s>(out: &mut View<'s>) -> () {
  let local = Token { value: 3 }
  let held = same(&local)
  out.left = held
}

fn putWrapped<'s>(out: &mut View<'s>) -> () {
  let local = Token { value: 3 }
  out.* = wrap(&local)
}

fn putIndexed<'s>(out: &mut Pair<'s>) -> () {
  let local = Token { value: 3 }
  out.items[0] = same(&local)
}

pub fn main() -> i32 {
  return 0
}
