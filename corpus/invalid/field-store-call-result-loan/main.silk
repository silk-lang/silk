// A call result stored into a caller-owned field keeps the loans its arguments lend it. Each
// write below stores a borrow of `local` into storage that outlives `put`, so each is rejected
// at the borrow, exactly where the let-bound form reports.
struct Token {
  value: i32
}

struct View<'a> {
  left: &'a Token
}

fn widen<'a, 'b: 'a>(value: &'b Token) -> &'a Token {
  return value
}

fn same<'a>(value: &'a Token) -> &'a Token {
  return value
}

fn putWidened<'s>(out: &mut View<'s>) -> () {
  let local = Token { value: 3 }
  out.left = widen(&local)
}

fn putSame<'s>(out: &mut View<'s>) -> () {
  let local = Token { value: 3 }
  out.left = same(&local)
}

fn putBound<'s>(out: &mut View<'s>) -> () {
  let local = Token { value: 3 }
  let held = same(&local)
  out.left = held
}

pub fn main() -> i32 {
  return 0
}
