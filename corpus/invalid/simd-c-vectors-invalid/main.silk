unsafe extern "C" fn wide(values: simd<f32, 8>) -> f32
unsafe extern "C" fn narrow(values: simd<u8, 8>) -> u8

pub fn main() -> i32 {
  let total = unsafe wide(Intrinsic.simdSplat<simd<f32, 8>>(1.0))
  let first = unsafe narrow(Intrinsic.simdSplat<simd<u8, 8>>(1))
  if total > 0.0 && first > 0 { return 1 }
  return 0
}
