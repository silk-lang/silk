// An invoked closure stores its captured loan of `count` in `slot`, which another capture reaches.
// Writing `count` while `slot` is still read conflicts with that loan (CAPTURE-002, ANON-OWN-001).
import silk.core.option {Option}

struct Slot<'a> {
  view: Option<&'a i32>,
}

fn read<'a>(slot: &Slot<'a>) -> i32 {
  if let Option<&'a i32>.Some {value} = &slot.view { return value.* }
  return 0
}

pub fn main() -> i32 {
  let mut count = 1
  let mut slot = Slot {view: Option<&i32>.none()}
  let mut store = fn() -> () { slot.view = Option<&i32>.some(&count) }
  store()
  count = 2
  return read(&slot)
}
