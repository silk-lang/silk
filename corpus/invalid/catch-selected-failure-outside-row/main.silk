import silk.core.effect { Effect }

struct Problem {
  code: i32,
}

struct Other {
  code: i32,
}

effect fn load() -> i32
  ! Problem {
  return 1
}

effect fn recover(error: Other) -> i32 {
  return error.code
}

pub fn main() -> i32 {
  let value = run Effect.catch<Other>(load(), recover)
  return value
}
