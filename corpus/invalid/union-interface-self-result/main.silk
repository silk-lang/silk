interface Remake {
  fn remake(self: &Self) -> Self
}

struct Alpha {}

impl Remake for Alpha {
  fn remake(self: &Self) -> Self { return Alpha {} }
}

struct Beta {}

impl Remake for Beta {
  fn remake(self: &Self) -> Self { return Beta {} }
}

fn again<T: Remake>(value: &T) -> T { return Remake.remake(value) }

fn pick(flag: bool) -> Alpha | Beta {
  if flag { return Alpha {} }
  return Beta {}
}

pub fn main() -> i32 {
  let value = again(&pick(true))
  return 0
}
