import silk.core.ownership { Drop }
struct Token { value: i32 }
impl Drop for Token { fn drop(self: &mut Token) -> () { self.value = 0  return () } }
struct Pair { kept: Token, lost: Token }
impl Pair { fn consume(self: Pair) -> i32 { let Pair { kept, lost } = move self  drop lost  return kept.value } }
struct Nest { pair: Pair, tag: Token }
fn nest() -> Nest { return Nest { pair: Pair { kept: Token { value: 1 }, lost: Token { value: 2 } }, tag: Token { value: 3 } } }
pub fn main() -> i32 {
  return nest().pair.consume()
}
