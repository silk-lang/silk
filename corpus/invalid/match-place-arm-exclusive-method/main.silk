struct Token { value: i32 }
union Packet { Empty, Ready { left: Token, right: Token } }
impl Packet {
  fn clear(self: &mut Self) -> () {
    self.* = Packet.Empty
    return ()
  }
}
fn probe() -> i32 {
  let mut packet = Packet.Ready { left: Token { value: 1 }, right: Token { value: 2 } }
  let mut out = 0
  match place packet {
    Packet.Ready { left, .. } => {
      packet.clear()
      out = left.value
    }
    Packet.Empty => {}
  }
  return out
}
pub fn main() -> i32 { return probe() }