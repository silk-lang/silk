struct Token { value: i32 }
struct Box1 { t: Token, u: Token }
service Keeper<'k> { effect fn put(v: &'k Token) -> () ? &mut Keeper<'k> }
fn keepCallable<'k>(v: &'k Token) -> fn<'k>() -> Effect<'k; () ? &mut Keeper<'k>> {
  return fn() -> Effect<'k; () ? &mut Keeper<'k>> { return Keeper<'k>.put(v) }
}
effect fn probe<'a: 'b, 'b>(src: &'a mut Box1) -> () ? &mut Keeper<'b> {
  let view: &'b Token = &src.t
  let later = keepCallable<'b>(view)
  run later()
  src.t = Token { value: 9 }
  return ()
}
pub fn main() -> i32 { return 0 }
