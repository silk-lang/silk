struct Token { value: i32 }
struct View<'a> { left: &'a Token }
fn probe(swap: bool) -> i32 {
  let base = Token { value: 42 }
  let mut out = View { left: &base }
  let mut second = View { left: &base }
  if swap {
    let owner = Token { value: 3 }
    out.left = &owner
    second.left = out.left
  }
  return second.left.value
}
pub fn main() -> i32 {
  return probe(true)
}
