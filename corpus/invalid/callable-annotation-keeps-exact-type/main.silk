// An annotated callable local keeps its exact function type, as a parameter of that contract
// does: it cannot later hold a different function.
fn inc(x: i32) -> i32 { return x + 1 }
fn dbl(x: i32) -> i32 { return x * 2 }
pub fn main() -> i32 {
  let mut h: fn(i32) -> i32 = inc
  h = dbl
  return h(1)
}
