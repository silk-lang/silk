// An invalid regex in `Spec.pattern` is reported once, at the literal, though two library reads evaluate the spec.
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.schema.issue { SchemaError, SchemaErrors }
import silk.schema.json { SchemaJson }
import silk.schema.schema { Schema, Schemas, Spec }
import silk.text.string { String }

struct Upstream {
  pub host: String,
}

impl Schema for Upstream {
  static fn spec() -> Spec<Upstream> {
    return Spec<Upstream>.of()
      |> Spec<Upstream>.pattern("host", "^[a-z")
  }
}

effect fn checks() -> i32 ! OutOfMemoryError ? &mut Allocator {
  return match move run Effect.result(SchemaJson.decode<Upstream>(b"{}")) {
    Result<Upstream, SchemaError | OutOfMemoryError>.Success {..} => 0
    Result<Upstream, SchemaError | OutOfMemoryError>.Failure {..} => 1
  }
}

effect fn more() -> i32 ! OutOfMemoryError ? &mut Allocator {
  return match move run Effect.result(SchemaJson.decodeAll<Upstream>(b"{}")) {
    Result<Upstream, SchemaErrors | OutOfMemoryError>.Success {..} => 0
    Result<Upstream, SchemaErrors | OutOfMemoryError>.Failure {..} => 1
  }
}

// Describing the type reads the spec in a third instance.
effect fn described() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let shapes = run Schemas.shape<Upstream>()
  drop shapes
  return 0
}

pub effect fn main() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let a = run checks() |> Effect.provideMut<Allocator>(&mut allocator)
  let b = run more() |> Effect.provideMut<Allocator>(&mut allocator)
  let c = run described() |> Effect.provideMut<Allocator>(&mut allocator)
  return a + b + c
}
