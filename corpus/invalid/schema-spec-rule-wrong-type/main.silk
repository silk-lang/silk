// A rule that the field's type cannot follow, `between` on text, is reported at the field's name.
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.schema.issue { SchemaError }
import silk.schema.json { SchemaJson }
import silk.schema.schema { Schema, Spec }
import silk.text.string { String }

struct Upstream {
  pub host: String,
}

impl Schema for Upstream {
  static fn spec() -> Spec<Upstream> {
    return Spec<Upstream>.of()
      |> Spec<Upstream>.between("host", 1, 10)
  }
}

effect fn checks() -> i32 ! OutOfMemoryError ? &mut Allocator {
  return match move run Effect.result(SchemaJson.decode<Upstream>(b"{}")) {
    Result<Upstream, SchemaError | OutOfMemoryError>.Success {..} => 0
    Result<Upstream, SchemaError | OutOfMemoryError>.Failure {..} => 1
  }
}

pub effect fn main() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checks() |> Effect.provideMut<Allocator>(&mut allocator)
}
