import silk.core.ownership { Drop }
struct Token { value: i32 }
impl Drop for Token { fn drop(self: &mut Token) -> () { return () } }
fn make() -> Token { return Token { value: 9 } }
union Packet { Empty, Ready { left: Token, right: Token } }
fn mkp() -> Packet { return Packet.Ready { left: make(), right: make() } }
struct Holder {
  held: Packet,
  count: i32,
}
fn same<'a>(p: &'a Packet) -> &'a Packet { return p }
fn heldOf<'a>(h: &'a Holder) -> &'a Packet { return &h.held }
fn probe() -> i32 {
  let mut packet = mkp()
  let mut out = 0
  match &same(&packet).* {
    Packet.Ready { left, .. } => {
      packet = Packet.Empty
      out = left.value
    }
    Packet.Empty => {}
  }
  return out
}
pub fn main() -> i32 { return probe() }
