import silk.core.reflect { Reflect }
import silk.mem.layout { Layout }

struct Pair {
  pub first: i32,
  pub second: i64,
}

struct Plain {
  value: Pair,
}

static fn size<T, V>(field: Intrinsic.Field<T, V>) -> usize {
  return Layout.of<V>().bytes
}

impl Plain {
  fn width<V>(self: &Self, static field: Intrinsic.Field<Pair, V>) -> usize {
    return size(field)
  }
}

struct Holder<T> {
  value: T,
}

impl<T> Holder<T> {
  fn width<V>(self: &Self, static field: Intrinsic.Field<T, V>) -> usize {
    return size(field)
  }
}

impl Plain {
  fn narrow(self: &Self, static field: Intrinsic.Field<Pair, i32>) -> usize { return size(field) }
}

// The named field must have the value type the parameter states.
pub fn main() -> i32 {
  let plain = Plain { value: Pair { first: 1, second: 2 } }
  if plain.narrow("second") != 4 { return 1 }
  return 0
}
