import silk.core.effect { Effect }

struct Ui { depth: i32 }

effect fn node(ui: &mut Ui, body: for<'call> fn(&'call mut Ui) -> Effect<'call; ()>) -> () {
  return run body(&mut ui.*)
}

pub effect fn main() -> i32 {
  let mut ui = Ui { depth: 0 }
  run node(&mut ui, effect |inner| { inner.depth = 1 })
  return ui.depth
}
