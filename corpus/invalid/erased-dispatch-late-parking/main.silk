import silk.concurrency.execution { Execution }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }

interface Close {
  @nonParking
  effect fn close(self: &Self, static park: bool) -> ()
}

struct Quiet {}
struct Parks {}

impl Close for Quiet {
  effect fn close(self: &Self, static park: bool) -> () {}
}

impl Close for Parks {
  effect fn close(self: &Self, static park: bool) -> () {
    static if park { return run Intrinsic.relinquish() }
  }
}

interface Discover { effect fn find(self: &Self) -> () }
struct Later {}
impl Discover for Later {
  effect fn find(self: &Self) -> () {
    let parks = Parks {}
    let value: &any Close = &parks
    run Close.close(value, false)
  }
}

effect fn work() -> i32 {
  let quiet = Quiet {}
  let first: &any Close = &quiet
  run Close.close(first, true)
  let later = Later {}
  let other: &any Discover = &later
  run Discover.find(other)
  return 0
}

fn ready(state: &()) -> () {}

pub effect fn main() -> i32 ! OutOfMemoryError {
  let mut system = Allocator.systemAllocatorProvider()
  let package = run Execution.make(work(), (), ready) |> Effect.provideMut<Allocator>(&mut system)
  drop package
  return 0
}
