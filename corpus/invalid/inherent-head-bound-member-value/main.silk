struct Token { value: i32 }
struct Boxed<A> { value: A }
impl<A: 'static> Boxed<A> {
  fn make(value: A) -> Boxed<A> { return Boxed<A> { value: move value } }
}
fn probe<'x>(short: &'x Token) -> i32 {
  let made = Boxed<&'x Token>.make
  let boxed = made(short)
  return 0
}
pub fn main() -> i32 {
  let token = Token { value: 1 }
  return probe(&token)
}
