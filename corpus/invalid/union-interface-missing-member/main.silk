interface Describe {
  fn describe(self: &Self) -> i32
}

struct Alpha {}

impl Describe for Alpha {
  fn describe(self: &Self) -> i32 { return 1 }
}

struct Gamma {}

fn total<T: Describe>(value: &T) -> i32 { return Describe.describe(value) }

fn pick(flag: bool) -> Alpha | Gamma {
  if flag { return Alpha {} }
  return Gamma {}
}

pub fn main() -> i32 {
  return total(&pick(true))
}
