struct Token { value: i32 }
struct Couple<'a, 'b> { left: &'a Token, right: &'b Token }
fn pair<'a, 'b>(left: &'a Token, right: &'b Token) -> Couple<'a, 'b> {
  return Couple { left: left, right: right }
}
fn probe<'s>(x: &'s Token) -> &'s Token {
  let owner = Token { value: 3 }
  let both = pair(x, &owner)
  return both.right
}
pub fn main() -> i32 {
  let token = Token { value: 1 }
  return probe(&token).value
}
