struct Token { value: i32 }
struct Left { value: i32 }
struct Empty {}
fn take(t: Token) -> i32 { return t.value }
fn accept(v: bool) -> bool { return v }
fn both(flag: bool, input: Left | Empty) -> i32 {
  let owned = Token { value: 1 }
  let a = take(move owned)
  if flag && accept(match &input { Left { .. } => { return 1 } _ => { return 2 } }) { }
  let b = take(move owned)
  return a + b
}
fn either(flag: bool, input: Left | Empty) -> i32 {
  let owned = Token { value: 2 }
  let a = take(move owned)
  if flag || accept(match &input { Left { .. } => { return 3 } _ => { return 4 } }) { }
  let b = take(move owned)
  return a + b
}
pub fn main() -> i32 { return both(false, Empty {}) + either(true, Empty {}) }