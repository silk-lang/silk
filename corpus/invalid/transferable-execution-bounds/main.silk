import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.concurrency.execution { Execution, Wake }
import silk.mem.shared { Shared }
import silk.concurrency.thread { Transferable }
fn send<T: Transferable>(value: T) -> () {}
fn sendWake(wake: Wake) -> () { send(move wake) }
fn sendLocal(execution: Intrinsic.Execution<i32>) -> () { send(move execution) }
effect fn counted(counter: Shared<i32>) -> i32 { return 1 }
fn ready(state: &()) -> () { return () }
fn readyShared(state: &Shared<i32>) -> () { return () }
effect fn body() -> i32 { return 1 }
effect fn localBody(counter: Shared<i32>) -> () ! OutOfMemoryError ? &mut Allocator {
  let first = run Execution.makeTransferable(counted(move counter), (), ready)
  return ()
}
effect fn localEndpoint(counter: Shared<i32>) -> () ! OutOfMemoryError ? &mut Allocator {
  let second = run Execution.makeTransferable(body(), move counter, readyShared)
  return ()
}
pub fn main() -> i32 { return 0 }
