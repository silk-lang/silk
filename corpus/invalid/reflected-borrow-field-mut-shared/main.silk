// A mutable reflected projection needs a mutable borrow of its owner.
import silk.core.reflect { Reflect }

struct Counters {
  pub hits: i32,
}

fn reset(owner: &Counters) -> () {
  static for field in Reflect.fields<Counters>() {
    Intrinsic.borrowFieldMut<Counters, i32>(owner, field).* = 0
  }
  return ()
}

pub fn main() -> i32 {
  let counters = Counters {hits: 1}
  reset(&counters)
  return counters.hits
}
