import silk.collections.column_list { ColumnList }
import silk.core.effect { Effect }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }

struct Point {
  pub x: f32,
  pub y: f32,
}

impl Copy for Point {}

struct Particle {
  pub position: Point,
  pub speed: f32,
  pub id: u64,
}

impl Copy for Particle {}

fn particle(id: u64) -> Particle {
  return Particle { position: Point { x: 0.0, y: 0.0 }, speed: 1.0, id }
}

// A shared handle lends the fields of its rows only for reading.
effect fn build() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let mut particles = ColumnList<Particle>.make()
  run particles.append(particle(1))
  run particles.append(particle(2))
  let mut rows = particles.rows()
  rows[0].speed = 2.0
  return 0
}

effect fn recover(error: OutOfMemoryError) -> i32 { return 99 }

pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(build() |> Effect.provideMut<Allocator>(&mut allocator), recover)
}
