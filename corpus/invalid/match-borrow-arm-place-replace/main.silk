import silk.core.ownership { Drop }
struct Token { value: i32 }
impl Drop for Token { fn drop(self: &mut Token) -> () { return () } }
union Packet { Empty, Ready { left: Token, right: Token } }
fn ready(value: i32) -> Packet { return Packet.Ready { left: Token { value: value }, right: Token { value: 2 } } }
fn make() -> Token { return Token { value: 9 } }
pub fn main() -> i32 {
  let mut packet = ready(1)
  let mut out = 0
  match &packet {
    Packet.Ready { left: seen, .. } => {
      match place packet {
        Packet.Ready { left, .. } => {
          let old = Intrinsic.replace(left, make())
          out = old.value
        }
        Packet.Empty => {}
      }
      out = out + seen.value
    }
    Packet.Empty => {}
  }
  return out
}