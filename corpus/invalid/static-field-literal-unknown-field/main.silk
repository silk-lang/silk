import silk.core.reflect { Reflect }
import silk.mem.layout { Layout }

struct Pair {
  pub first: i32,
  pub second: i64,
}

struct Plain {
  value: Pair,
}

static fn size<T, V>(field: Intrinsic.Field<T, V>) -> usize {
  return Layout.of<V>().bytes
}

impl Plain {
  fn width<V>(self: &Self, static field: Intrinsic.Field<Pair, V>) -> usize {
    return size(field)
  }
}

struct Holder<T> {
  value: T,
}

impl<T> Holder<T> {
  fn width<V>(self: &Self, static field: Intrinsic.Field<T, V>) -> usize {
    return size(field)
  }
}

// The literal must name a field of the descriptor's owner.
pub fn main() -> i32 {
  let holder = Holder<Pair> { value: Pair { first: 3, second: 4 } }
  if holder.width("third") != 4 { return 1 }
  return 0
}
