import silk.core.ownership { Drop }
struct Token { value: i32 }
impl Drop for Token { fn drop(self: &mut Token) -> () { self.value = 0  return () } }
struct Guarded { token: Token }
impl Drop for Guarded { fn drop(self: &mut Guarded) -> () { self.token.value = 0  return () } }
fn guarded() -> Guarded { return Guarded { token: Token { value: 4 } } }
pub fn main() -> i32 {
  let token = guarded().token
  return token.value
}
