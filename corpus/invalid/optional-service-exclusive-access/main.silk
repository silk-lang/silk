import silk.core.effect { Effect }
import silk.option { Option, withSome }

service Counter {
  effect fn next() -> i32 ? &mut Counter
}

struct Counting {
  value: i32,
}

impl Counter for Counting {
  effect fn next(self: &mut Self) -> i32 {
    self.value = self.value + 1
    return self.value
  }
}

effect fn plain() -> i32 {
  return 0
}

effect fn counted() -> i32 ? &mut Counter {
  return run Counter.next()
}

// An `Option` provider lends its service through a shared borrow, so an optional service takes
// shared access only.
effect fn measure() -> i32 ? &Option<&mut Counter> {
  return run withSome<&mut Counter>(plain(), counted())
}

pub fn main() -> i32 {
  let mut counting = Counting {value: 41}
  let present = Option<&mut Counting>.some(&mut counting)
  return run Effect.provide(measure(), &present)
}
