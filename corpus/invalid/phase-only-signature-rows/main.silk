// declaration below is rejected once.
service PhaseCapability<T> {}

service Other {}

struct PhaseRows<?R> {}

fn rowArgument(value: PhaseRows<&PhaseCapability<Intrinsic.StaticSequence<i32>>>) -> i32 {
  return 0
}

effect fn requirement() -> i32 ? &PhaseCapability<Intrinsic.StaticSequence<i32>> {
  return 0
}

effect fn narrowed() -> i32 ? Without<&PhaseCapability<Intrinsic.StaticSequence<i32>> | &Other, Other> {
  return 0
}

pub fn main() -> i32 {
  return 0
}
