// A value a later write installs into a local reference reaches caller-owned storage through
// every store of that local the write's installation can reach. Each function below stores a
// borrow of `local` that dies at return, so each is rejected at that borrow.
struct Token {
  value: i32
}

struct View<'a> {
  left: &'a Token
}

fn same<'a>(value: &'a Token) -> &'a Token {
  return value
}

fn keep<'s>(out: &mut View<'s>, value: &'s Token) -> () {
  out.left = value
}

fn storeCall<'s>(out: &mut View<'s>, token: &'s Token) -> () {
  let local = Token { value: 3 }
  let mut held = same(token)
  held = same(&local)
  out.left = held
}

fn storeBorrow<'s>(out: &mut View<'s>, token: &'s Token) -> () {
  let local = Token { value: 3 }
  let mut held = same(token)
  held = &local
  out.* = View { left: held }
}

fn passToCallee<'s>(out: &mut View<'s>, token: &'s Token) -> () {
  let local = Token { value: 3 }
  let mut held = same(token)
  let borrowed = same(&local)
  held = borrowed
  keep(&mut out.*, held)
}

pub fn main() -> i32 {
  return 0
}
