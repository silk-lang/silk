struct Token { value: i32 }
fn take(t: Token) -> i32 { return t.value }
fn before(flag: bool) -> i32 {
  let t = Token { value: 1 }
  let a = take(move t)
  let b = take(move t)
  if 3 { return 0 }
  return a + b
}
fn after(flag: bool) -> i32 {
  let t = Token { value: 2 }
  while 4 { }
  let a = take(move t)
  let b = take(move t)
  return a + b
}
