// A callable annotation still names the contract a function must meet, and an intrinsic result
// still meets only annotations its type converts to.
fn inc(x: i32) -> i32 { return x + 1 }
pub fn main() -> i32 {
  let f: fn(i32) -> bool = inc
  let g: fn<'static>(i64) -> i32 = inc
  let p: ?*const i64 = Intrinsic.pointerNull<i32>()
  return 0
}
