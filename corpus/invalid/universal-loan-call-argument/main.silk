import silk.core.option {Option}
struct Token { value: i32 }
struct Pair {
  t: Token,
  u: Token,
}
fn keep<'k>(out: &mut Option<&'k Token>, v: &'k Token) -> () {
  out.* = Option<&'k Token>.some(v)
  return ()
}
fn stash<'a: 'b, 'b>(src: &'a mut Pair, out: &mut Option<&'b Token>) -> () {
  keep<'b>(&mut out.*, &src.t)
  src.t = Token { value: 9 }
  return ()
}
pub fn main() -> i32 {
  let mut pair = Pair { t: Token { value: 1 }, u: Token { value: 2 } }
  let mut out = Option<&Token>.none()
  stash(&mut pair, &mut out)
  return pair.u.value
}
