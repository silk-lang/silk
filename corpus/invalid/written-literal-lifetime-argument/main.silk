struct Token { value: i32 }
struct Box1 { t: Token, u: Token }
struct Holder<'h> { view: &'h Token }
fn probe<'a: 'b, 'b>(src: &'a mut Box1) -> i32 {
  let held = Holder<'a> { view: &src.t }
  let seen = held.view.value
  src.t = Token { value: seen }
  return seen
}
pub fn main() -> i32 { return 0 }
