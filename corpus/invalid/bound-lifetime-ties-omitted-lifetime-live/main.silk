struct Pair { pub first: i32, pub second: i32 }

struct Holder<T> { value: T }

struct View<'a> { pub first: &'a i32 }

interface Lends<'s, T> {
  fn lend(source: &'s T) -> Self
}

impl<'a> Lends<'a, Pair> for View<'a> {
  fn lend(source: &'a Pair) -> View<'a> { return View { first: &source.first } }
}

impl<T> Holder<T> {
  fn lend<'s, V: Lends<'s, T>>(self: &'s Self) -> V { return Lends.lend(&self.value) }
  fn touch(self: &mut Self) -> () { return () }
}

// The view's omitted lifetime is the borrow of `holder`, so the borrow lasts while the view is used.
pub fn main() -> i32 {
  let mut holder = Holder<Pair> { value: Pair { first: 3, second: 4 } }
  let seen = holder.lend<View>()
  holder.touch()
  return seen.first.*
}
