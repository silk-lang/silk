import silk.core.ownership { Drop }
struct Token { value: i32 }
impl Drop for Token { fn drop(self: &mut Token) -> () { return () } }
fn make() -> Token { return Token { value: 1 } }
union Cell { Vacant, Held { token: Token } }
union Packet { Empty, Ready { left: Token, right: Token } }
fn isHeld(cell: &Cell) -> i32 { return 0 }
fn probe() -> i32 {
  let mut packet = Packet.Ready { left: make(), right: make() }
  let mut out = 0
  match &packet {
    Packet.Ready { left: seen, .. } => {
      match place packet {
        Packet.Ready { .. } => {}
        Packet.Empty => {}
      }
      out = seen.value
    }
    Packet.Empty => {}
  }
  return out
}
pub fn main() -> i32 { return probe() }
