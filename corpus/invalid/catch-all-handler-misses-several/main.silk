import silk.core.effect { Effect }

struct Found {}
struct Missing {}
struct Third {}

effect fn load() -> i32 ! Found | Missing | Third {
  fail Third {}
}

effect fn recover(error: Found) -> i32 {
  return 1
}

pub effect fn main() -> i32 {
  let handled = Effect.catchAll(load(), recover)
  return run move handled
}
