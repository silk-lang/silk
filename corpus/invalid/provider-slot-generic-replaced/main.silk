// A deferred Effect provides a generic provider's slot, so it holds an exclusive loan of that slot
// until it runs. Replacing the provider before the run conflicts with that loan.
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.core.effect {Effect}
import silk.mem.shared {Shared}

effect<'static> fn replaced<P: 'static>(first: P, second: P) -> usize ! OutOfMemoryError
where &mut P provides &mut Allocator from &mut Allocator {
  let mut slot = move first
  let pending = Shared<usize>.make(7) |> Effect.provideMut<Allocator>(&mut slot)
  slot = move second
  let made = run move pending
  return 0
}

pub fn main() -> i32 {
  return 0
}
