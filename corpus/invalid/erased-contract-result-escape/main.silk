interface Source<'data> { fn get(self: &Self) -> &'data i32 }
struct View<'a> { part: &'a i32 }
impl<'a> Source<'a> for View<'a> {
  fn get(self: &Self) -> &'a i32 { return self.part }
}
fn read<'a>(p: &any Source<'a>) -> &'a i32 { return p.get() }
fn escape<'a>(value: &'a i32) -> &'static i32 {
  let view = View {part: value}
  let p: &any Source<'a> = &view
  return read<'a>(p)
}
pub fn main() -> i32 { return 0 }
