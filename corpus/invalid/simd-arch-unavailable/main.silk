// An architecture operation needs its target and CPU feature: the default x86-64 profile has
// SSE2 but not SSSE3, and an AArch64 operation needs AArch64 (SIMD-007).
pub fn main() -> i32 {
  let a = Intrinsic.simdSplat<simd<u8, 16>>(1)
  let b = Intrinsic.x86ShuffleBytes<simd<u8, 16>>(a, a)
  let c = Intrinsic.aarch64TableLookup<simd<u8, 16>>(a, a)
  let d = Intrinsic.x86ShuffleBytes<simd<u16, 8>>(Intrinsic.simdSplat<simd<u16, 8>>(1), Intrinsic.simdSplat<simd<u16, 8>>(1))
  return 0
}
