// An ordinary `if` in a static fn runs after its `static for` loops have expanded, so it cannot keep
// `Reflect.fields` away from a union: the expansion for `Report` is rejected at the iterable.
import silk.core.reflect { Reflect, namedKind }

union Report {
  ReachedTen,
}

static fn fieldCount<O>() -> usize {
  if Reflect.typeKind(Reflect.typeOf<O>()) != namedKind {
    return 0
  }
  let mut fields: usize = 0
  static for _field in Reflect.fields<O>() {
    fields = fields + 1
  }
  return fields
}

pub fn main() -> i32 {
  static if fieldCount<Report>() == 0 {
    return 0
  }
  return 1
}
