struct Token { value: i32 }
union Packet { Empty, Ready { left: Token, right: Token } }
struct Holder {
  held: Packet,
  count: i32,
}
fn resetHolder(holder: &mut Holder) -> () {
  holder.held = Packet.Empty
  return ()
}
fn probe() -> i32 {
  let mut holder = Holder { held: Packet.Ready { left: Token { value: 1 }, right: Token { value: 2 } }, count: 0 }
  let mut out = 0
  match place holder.held {
    Packet.Ready { left, .. } => {
      resetHolder(&mut holder)
      out = left.value
    }
    Packet.Empty => {}
  }
  return out
}
pub fn main() -> i32 { return probe() }