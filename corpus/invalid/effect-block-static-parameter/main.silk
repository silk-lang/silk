import silk.core.effect { Effect }

// An `effect {}` block run from a function with a `static` parameter is refused at the block:
// native compilation reads it from the unspecialized body, not one per static argument.
effect fn again<'env, A, E, ?R>(mut action: mut Effect<'env; A ! E ? R>) -> A ! E ? R {
  return run action
}

effect fn one() -> i32 {
  return 1
}

effect fn scaled(static factor: i32) -> i32 {
  let got = run again(effect { return run one() })
  return got * factor
}

pub fn main() -> i32 {
  let big = run scaled(40)
  let small = run scaled(2)
  return big + small
}
