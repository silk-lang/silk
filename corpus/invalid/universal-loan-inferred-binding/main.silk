struct Token { value: i32 }
struct Pair {
  t: Token,
  u: Token,
}
struct Holder<'h> { view: &'h Token }
fn keep<'k>(out: &mut Holder<'k>, v: &'k Token) -> () {
  out.view = v
  return ()
}
fn stash<'a: 'b, 'b>(src: &'a mut Pair, out: &mut Holder<'b>) -> () {
  let mut view = &src.t
  keep<'b>(&mut out.*, view)
  src.t = Token { value: 9 }
  return ()
}
pub fn main() -> i32 {
  let mut pair = Pair { t: Token { value: 1 }, u: Token { value: 2 } }
  let other = Token { value: 3 }
  let mut out = Holder { view: &other }
  stash(&mut pair, &mut out)
  return out.view.value
}
