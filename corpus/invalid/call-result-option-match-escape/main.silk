import silk.core.option { Option }
struct Token { value: i32 }
fn probe<'s>(x: &'s Token) -> &'s Token {
  let owner = Token { value: 3 }
  let held = Option<&Token>.some(&owner)
  return match move held {
    Option<&Token>.Some {value} => value
    Option<&Token>.None => x
  }
}
pub fn main() -> i32 {
  let token = Token { value: 1 }
  return probe(&token).value
}
