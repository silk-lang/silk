import silk.core.effect { Effect }

struct Ticket { id: i32 }

effect fn use(ticket: Ticket) -> i32 {
  return ticket.id
}

effect fn twice<'env, A, E, ?R>(mut action: mut Effect<'env; A ! E ? R>) -> A ! E ? R {
  drop run action
  return run action
}

pub effect fn main() -> i32 {
  return run twice(use(Ticket { id: 3 }))
}
