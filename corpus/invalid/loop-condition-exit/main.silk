struct Token { value: i32 }
struct Left { value: i32 }
struct Empty {}
fn take(t: Token) -> i32 { return t.value }
fn accept(v: bool) -> bool { return v }
fn oneArmBreaks(flag: bool, input: Left | Empty) -> i32 {
  let mut owned = Token { value: 1 }
  while flag {
    while accept(match &input { Left { .. } => { let z = take(move owned) break } _ => false }) { }
    owned = Token { value: 2 }
  }
  let b = take(move owned)
  return b
}
fn everyArmBreaks(flag: bool, input: Left | Empty) -> i32 {
  let mut owned = Token { value: 1 }
  while flag {
    while accept(match &input { Left { .. } => { let z = take(move owned) break } _ => { break } }) { }
    owned = Token { value: 2 }
  }
  let b = take(move owned)
  return b
}
fn armContinues(flag: bool, input: Left | Empty) -> i32 {
  let mut owned = Token { value: 1 }
  while flag {
    while accept(match &input { Left { .. } => { let z = take(move owned) continue } _ => false }) { }
    owned = Token { value: 2 }
  }
  let b = take(move owned)
  return b
}
pub fn main() -> i32 { return oneArmBreaks(true, Empty {}) + everyArmBreaks(true, Empty {}) + armContinues(true, Empty {}) }