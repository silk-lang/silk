// A group name the engine refuses is reported over its whole character, not one byte of it.
import silk.text.regex { Regex, Typed }

struct Word<'a> {
  pub word: string<'a>,
}

const WORD: Typed<Word<'static>> = Regex.typed<Word<'static>>("(?<éword>\\w+)")

pub fn main() -> i32 {
  if WORD.pattern() == "" {
    return 1
  }
  return 0
}
