import silk.reflect { Reflect }

union Shape {
  Dot,
  Line { pub length: u32, pub width: u32 },
}

fn line<U>() -> U {
  static for variant in Reflect.variants<U>() {
    static if Reflect.variantLabel(variant) == "Line" {
      return Reflect.makeVariant(variant, (true, 2))
    }
  }
  return Intrinsic.trap("no line")
}

pub fn main() -> i32 {
  drop line<Shape>()
  return 0
}
