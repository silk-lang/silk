import silk.core.effect { Effect }

struct Oops {}
struct Refused {}

effect fn work(which: bool) -> i32 ! Oops | Refused {
  if which { fail Oops {} }
  fail Refused {}
}

effect fn explain(failure: Oops) -> i32 {
  return 1
}

pub fn main() -> i32 {
  return run Effect.catchAll(work(false), explain)
}
