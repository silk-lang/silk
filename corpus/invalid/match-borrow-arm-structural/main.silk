import silk.core.ownership { Drop }
struct Token { value: i32 }
impl Drop for Token { fn drop(self: &mut Token) -> () { return () } }
struct Box1 { item: Token }
struct Empty {}
fn filled() -> Box1 | Empty { return Box1 { item: Token { value: 1 } } }
pub fn main() -> i32 {
  let mut slot = filled()
  let mut out = 0
  match &slot {
    Box1 { item } => {
      slot = Empty {}
      out = item.value
    }
    Empty vacant => {}
  }
  return out
}
