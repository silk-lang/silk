// A callable contract written as a type argument names no function, so the parameter it types
// cannot hold `increment`; leaving `G` out lets the call infer the exact callable.
fn keep<G>(guard: G) -> i32 {
  return 0
}

fn increment(value: i32) -> i32 {
  return value + 1
}

pub fn main() -> i32 {
  return keep<fn(i32) -> i32>(increment) + keep(increment)
}
