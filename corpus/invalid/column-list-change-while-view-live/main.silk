import silk.collections.column_list { ColumnList, ColumnView }
import silk.core.effect { Effect }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }

struct Particle {
  pub x: f32,
  pub id: u64,
}

impl Copy for Particle {}

struct Step<'a> {
  pub x: &'a mut [f32],
  pub id: &'a [u64],
}

impl<'a> ColumnView<'a, Particle> for Step<'a> {}

struct Ids<'a> {
  pub id: &'a [u64],
}

impl<'a> ColumnView<'a, Particle> for Ids<'a> {}

// A view borrows the list for as long as the view is in use: exclusively from `columnsMut`, shared
// from `columns`.
effect fn build() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let mut particles = ColumnList<Particle>.make()
  run particles.append(Particle { x: 1.0, id: 1 })
  let step = particles.columnsMut<Step>()
  let count = particles.length()
  step.x[0] = 2.0
  let ids = particles.columns<Ids>()
  particles.clear()
  if ids.id[0] != 1 || count != 1 { return 1 }
  return 0
}

effect fn recover(error: OutOfMemoryError) -> i32 { return 99 }

pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(build() |> Effect.provideMut<Allocator>(&mut allocator), recover)
}
