fn naked() -> i32 with Intrinsic.machine(naked: true) { return 0 }
fn foreign() -> i32 with Intrinsic.foreign(memory: "none", locality: "arguments") { return 0 }
export "C" fn exported() -> i32 with Intrinsic.machine(noReturn: false) { return 0 }
pub fn main() -> i32 { return naked() + foreign() + exported() }
