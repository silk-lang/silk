// A field that borrows writes its lifetime, and an implementation head writes the lifetimes of
// the type it implements; the compiler never adds a hidden lifetime parameter.
struct Row {
  title: string,
}

struct Named<'a> {
  title: string<'a>,
}

impl Named {
  fn title(self: &Self) -> string { return self.title }
}

pub fn main() -> i32 { return 0 }
