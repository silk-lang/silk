// An export's shim is always built, so its vector lanes are checked where it is declared, by
// `silk check` as by `silk build` (SEM0244).
export "C" fn wide(values: simd<f32, 8>) -> f32 { return 1.0 }

export "C" fn narrow(values: simd<u8, 8>) -> u8 { return 1 }

export "C" fn widened() -> simd<f32, 8> { return Intrinsic.simdSplat<simd<f32, 8>>(1.0) }

pub fn main() -> i32 {
  return 0
}
