import silk.core.effect { Effect }

service Port { effect fn close() -> () ? &mut Port }
effect fn closing() -> () ? &mut Port { run Port.close() }

fn hold<'a, ?R, F: once Effect<'a; () ? R> + Intrinsic.NonParking>(value: F) -> F {
  return move value
}

pub fn main() -> i32 {
  let held = hold(closing())
  drop held
  return 0
}
