// A vector needs numeric lanes, a power-of-two lane count and 16 to 512 bits; a mask is never
// written as `simd<bool, N>` (SIMD-001).
fn odd(value: simd<u8, 3>) -> () {}
fn wide(value: simd<u64, 16>) -> () {}
fn boolean(value: simd<bool, 4>) -> () {}
fn huge(value: mask<128>) -> () {}

pub fn main() -> i32 {
  let scalar = Intrinsic.simdSplat<u8>(1)
  return 0
}
