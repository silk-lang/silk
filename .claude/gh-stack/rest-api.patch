+// restPR is the subset of the REST pull request object this package uses.
+type restPR struct {
+	NodeID   string  `json:"node_id"`
+	Number   int     `json:"number"`
+	State    string  `json:"state"`
+	HTMLURL  string  `json:"html_url"`
+	Title    string  `json:"title"`
+	Body     *string `json:"body"`
+	Draft    bool    `json:"draft"`
+	MergedAt *string `json:"merged_at"`
+	Head     struct {
+		Ref string `json:"ref"`
+	} `json:"head"`
+	Base struct {
+		Ref string `json:"ref"`
+	} `json:"base"`
+	AutoMerge *struct {
+		EnabledBy any `json:"enabled_by"`
+	} `json:"auto_merge"`
+}
+
+func (c *Client) toPullRequest(p *restPR) *PullRequest {
+	c.mu.Lock()
+	if c.numberByNodeID == nil {
+		c.numberByNodeID = map[string]int{}
+	}
+	c.numberByNodeID[p.NodeID] = p.Number
+	c.mu.Unlock()
+
+	merged := p.MergedAt != nil && *p.MergedAt != ""
+	state := "OPEN"
+	if merged {
+		state = "MERGED"
+	} else if p.State == "closed" {
+		state = "CLOSED"
+	}
+	body := ""
+	if p.Body != nil {
+		body = *p.Body
+	}
+	pr := &PullRequest{
+		ID:          p.NodeID,
+		Number:      p.Number,
+		State:       state,
+		URL:         p.HTMLURL,
+		Title:       p.Title,
+		Body:        body,
+		HeadRefName: p.Head.Ref,
+		BaseRefName: p.Base.Ref,
+		IsDraft:     p.Draft,
+		Merged:      merged,
+	}
+	if p.AutoMerge != nil {
+		pr.AutoMergeRequest = &AutoMergeRequest{}
+	}
+	return pr
+}
+
+func (c *Client) numberForNodeID(prID string) (int, error) {
+	c.mu.Lock()
+	defer c.mu.Unlock()
+	n, ok := c.numberByNodeID[prID]
+	if !ok {
+		return 0, fmt.Errorf("unknown pull request id %q", prID)
+	}
+	return n, nil
+}
