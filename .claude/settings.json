{
  "hooks": {
    "SessionStart": [
      {
        "matcher": "startup",
        "hooks": [
          {
            "type": "command",
            "command": "[ \"$CLAUDE_CODE_REMOTE\" != true ] || (cd \"$CLAUDE_PROJECT_DIR\" && CI=true pnpm install --frozen-lockfile)"
          }
        ]
      },
      {
        "hooks": [
          {
            "type": "command",
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/gh-stack/install.sh"
          }
        ]
      }
    ]
  }
}
