//! The `silk` tool as a machine: [`Silk`] is where one command stands, [`Typed`] is what the
//! user types and what the world answers, and the chart says what each of them does.
//!
//! The tool runs this machine. It fills a `Computer` from the real disk, sends the command, does
//! what each `Footprint` says, and while the machine waits for the world it does the work of the
//! state, such as a download, and sends the answer. So a row of the chart is not a description of
//! the tool: it is what the tool does.
//!
//! The rows of the commands that manage versions are in [`versions`], and the rows of a command
//! that goes to a compiler are in [`selection`].

import Computer { Age, Choice, Computer, Named, Pinned, Project, Store, Task, Verdict, Version, chosen }
import Footprint { Asset, Footprint, Message, Place, Program }
import silk.machine.chart { Chart, Enqueue, Guards, Machine, Next }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.schema.schema { Schema }

/// Where one command stands. Every state but `Idle` and `Ready` waits for the world.
pub union Silk {
  /// No command runs.
  Idle,
  /// The tool asks the release source whether the version is published.
  Resolving,
  /// The tool asks the release source for the newest release.
  Choosing,
  /// The tool works out the new text of the project's manifests.
  Editing,
  /// The archive and its signature are on their way.
  Downloading,
  /// The tool checks the signature of the archive.
  Verifying,
  /// The tool unpacks the archive and moves the toolchain into place.
  Unpacking,
  /// The version is in place, or was already: the command finishes.
  Ready,
  /// The tool becomes the compiler.
  Starting,
  /// The tool asks the release source for a newer tool.
  Checking,
  /// The tool replaces its own program.
  Replacing,
  /// The tool asks the selected compiler for its overview.
  Asking,
  /// The tool asks the selected compiler whether a mistyped word is one of its commands.
  Comparing,
}

/// What the user types, and what the world answers.
pub union Typed {
  /// Words that are no command of the tool: an unknown option, a missing version.
  Misuse,
  /// `silk use <version>`.
  Use { pub version: Version },
  /// `silk use latest`, or `silk use dev` when `stable` is false.
  UseNewest { pub stable: bool },
  /// `silk use`.
  UsePinned,
  /// `silk use list`.
  List,
  /// `silk use which`.
  Which,
  /// `silk use uninstall <version>`.
  Uninstall { pub version: Version },
  /// `silk set <version>`, with `--no-install` when `install` is false.
  Set { pub version: Version, pub install: bool },
  /// `silk set latest`, or `silk set dev` when `stable` is false.
  SetNewest { pub stable: bool, pub install: bool },
  /// `silk update self`.
  UpdateSelf,
  /// A command for the compiler, such as `silk build`, after what `+<version>` says.
  Run { pub asked: Named },
  /// `silk --help`, or `silk` alone when `bare` is true.
  Help { pub bare: bool },
  /// A first word that is one edit away from a command of the tool, such as `uze`.
  Near,

  /// The release source lists the version.
  Found,
  /// The release source does not list the version.
  Missing,
  /// The newest release is `version`.
  Newest { pub version: Version },
  /// Releases are published, and none is stable.
  NoStable,
  /// The release source lists no release.
  NoReleases,
  /// The release source did not answer.
  Unreachable,
  /// The manifests can be edited. `respells` says whether the manifest already pins the version in
  /// a spelling this tool does not write, which the tool then writes again.
  Edited { pub respells: bool },
  /// A manifest cannot be edited.
  Refused,
  /// The archive and its signature arrived.
  Arrived,
  /// The download stopped.
  Cut,
  /// The release key signed the archive for this release.
  Genuine,
  /// The signature is missing, wrong, or of another release.
  Forged,
  /// The toolchain is in its directory.
  Placed,
  /// The archive is not a release of Silk.
  Corrupt,
  /// The step cannot be done for a reason that is not the network or the release: a file of
  /// the home directory cannot be written or moved, or the release source lacks a file.
  Blocked,
  /// The compiler runs in place of the tool.
  Started,
  /// The compiler does not start.
  Stuck,
  /// A newer tool is published.
  Outdated,
  /// The tool is the newest release.
  Current,
  /// The new tool is in place.
  Replaced,
  /// The compiler gave its overview.
  Told,
  /// The compiler gave no overview.
  Silent,
  /// The compiler lists the word, or a word one edit away.
  Owned,
  /// The compiler does not list the word.
  Unowned,
}

impl Schema for Silk {}

impl Schema for Typed {}

// What `+<version>` says for `event`.
fn asked(event: &Typed) -> Named {
  return match &event.* {
    Typed.Run { asked } => asked
    _ => Named.Unset
  }
}

// The version `event` is about on `computer`.
fn subject(computer: &Computer, event: &Typed) -> Choice {
  return match &event.* {
    Typed.Use { version } => chosen(version)
    Typed.Uninstall { version } => chosen(version)
    Typed.Set { version, .. } => chosen(version)
    Typed.Newest { version } => chosen(version)
    Typed.UsePinned => computer.pinned()
    Typed.Run { asked } => computer.selects(asked).version
    Typed.Which => computer.selects(Named.Unset).version
    Typed.Help { .. } => computer.selects(Named.Unset).version
    Typed.Near => computer.selects(Named.Unset).version
    _ => Choice.Nothing
  }
}

// Guards of the rows that take a command. They see the computer before the tool noted the
// command, so they read the version from the event.

fn homeless(computer: &Computer, event: &Typed) -> bool {
  return !computer.home
}

fn pinBlocks(computer: &Computer, event: &Typed) -> bool {
  return computer.pinBlocks()
}

fn pinUnreadable(computer: &Computer, event: &Typed) -> bool {
  return computer.pin.state == Pinned.Unreadable
}

fn unpinned(computer: &Computer, event: &Typed) -> bool {
  return computer.pinned() == Choice.Nothing
}

fn projectless(computer: &Computer, event: &Typed) -> bool {
  return computer.project == Project.Absent
}

fn environmentMalformed(computer: &Computer, event: &Typed) -> bool {
  return computer.environment == Named.Malformed
}

fn selectionBlocked(computer: &Computer, event: &Typed) -> bool {
  return computer.selectionBlocked(asked(event))
}

fn nothingSelected(computer: &Computer, event: &Typed) -> bool {
  return subject(computer, event) == Choice.Nothing
}

fn subjectInstalled(computer: &Computer, event: &Typed) -> bool {
  return computer.installed(subject(computer, event))
}

fn subjectAbsent(computer: &Computer, event: &Typed) -> bool {
  return computer.store(subject(computer, event)) == Store.Absent
}

fn badRequest(computer: &Computer, event: &Typed) -> bool {
  return computer.verdict(asked(event)) == Verdict.BadRequest
}

fn badEnvironment(computer: &Computer, event: &Typed) -> bool {
  return computer.verdict(asked(event)) == Verdict.BadEnvironment
}

fn unknownPin(computer: &Computer, event: &Typed) -> bool {
  return computer.verdict(asked(event)) == Verdict.UnknownPin
}

fn runsBundled(computer: &Computer, event: &Typed) -> bool {
  return computer.verdict(asked(event)) == Verdict.Bundled
}

fn runsNothing(computer: &Computer, event: &Typed) -> bool {
  return computer.verdict(asked(event)) == Verdict.NothingSelected
}

fn runsHomeless(computer: &Computer, event: &Typed) -> bool {
  return computer.verdict(asked(event)) == Verdict.NoHome
}

fn runsCompiler(computer: &Computer, event: &Typed) -> bool {
  return computer.verdict(asked(event)) == Verdict.Compiler
}

fn runsInstall(computer: &Computer, event: &Typed) -> bool {
  return computer.verdict(asked(event)) == Verdict.Install
}

fn hasCompiler(computer: &Computer, event: &Typed) -> bool {
  let verdict = computer.verdict(Named.Unset)
  return verdict == Verdict.Bundled || verdict == Verdict.Compiler
}

// Guards of the rows that take an answer. The tool noted the command, so they read what the
// computer keeps in mind.

fn setting(computer: &Computer, event: &Typed) -> bool {
  return computer.task == Task.Setting || computer.task == Task.Pinning
}

fn onlyPinning(computer: &Computer, event: &Typed) -> bool {
  return computer.task == Task.Pinning
}

fn updating(computer: &Computer, event: &Typed) -> bool {
  return computer.task == Task.Updating
}

fn keptInstalled(computer: &Computer, event: &Typed) -> bool {
  return computer.installed(computer.subject)
}

// Guards of the rows that take no event, and of the effects a row leaves only sometimes.

fn usingVersion(computer: &Computer) -> bool {
  return computer.task == Task.Using
}

fn usingPinned(computer: &Computer) -> bool {
  return computer.task == Task.UsingPinned
}

fn settingPin(computer: &Computer) -> bool {
  return computer.task == Task.Setting || computer.task == Task.Pinning
}

fn running(computer: &Computer) -> bool {
  return computer.task == Task.Running
}

fn fresh(computer: &Computer) -> bool {
  return computer.fresh
}

fn stale(computer: &Computer) -> bool {
  return !computer.fresh
}

fn debris(computer: &Computer) -> bool {
  return computer.debris
}

fn damaged(computer: &Computer) -> bool {
  return computer.store(computer.subject) == Store.Damaged
}

fn pinnedElsewhere(computer: &Computer) -> bool {
  return computer.pinned() != Choice.Nothing && computer.pinned() != computer.subject
}

fn pinnedHere(computer: &Computer) -> bool {
  return computer.pinned() != Choice.Nothing && computer.pinned() == computer.subject
}

fn wasDefault(computer: &Computer) -> bool {
  return computer.standard != Choice.Nothing && computer.standard == computer.subject
}

fn pinMoves(computer: &Computer) -> bool {
  return computer.respells || !(computer.pin.state == Pinned.Own && computer.pin.version == computer.subject)
}

fn memberPins(computer: &Computer) -> bool {
  return computer.memberPins()
}

fn notInstalledYet(computer: &Computer) -> bool {
  return !computer.installed(computer.subject)
}

fn olderThanTool(computer: &Computer) -> bool {
  return computer.age(computer.subject) == Age.Older
}

fn ignoresMember(computer: &Computer) -> bool {
  return computer.ignoresMember()
}

fn bare(computer: &Computer) -> bool {
  return computer.bare
}

fn polite(computer: &Computer) -> bool {
  return !computer.bare
}

fn helpBadEnvironment(computer: &Computer) -> bool {
  return computer.verdict(Named.Unset) == Verdict.BadEnvironment
}

fn helpUnknownPin(computer: &Computer) -> bool {
  return computer.verdict(Named.Unset) == Verdict.UnknownPin
}

fn helpNothing(computer: &Computer) -> bool {
  return computer.verdict(Named.Unset) == Verdict.NothingSelected
}

fn helpHomeless(computer: &Computer) -> bool {
  return computer.verdict(Named.Unset) == Verdict.NoHome
}

fn helpMissing(computer: &Computer) -> bool {
  let verdict = computer.verdict(Named.Unset)
  return verdict == Verdict.NotInstalled || verdict == Verdict.Install
}

fn besideTool(computer: &Computer) -> bool {
  return computer.verdict(Named.Unset) == Verdict.Bundled
}

fn inStore(computer: &Computer) -> bool {
  return computer.verdict(Named.Unset) == Verdict.Compiler
}

type Rows = Chart<Silk, Typed, Computer, Footprint>

// What every row that starts the download of a toolchain leaves.
static fn fetching(chart: Rows) -> Rows {
  return chart
    |> Chart.leavesWhen(Guards.named("an interrupted install left its directory", debris), &[Footprint.Removes { place: Place.Staging }])
    |> Chart.leaves(
      &[
        Footprint.Creates { place: Place.Staging },
        Footprint.Downloads { asset: Asset.Archive },
        Footprint.Downloads { asset: Asset.Signature },
      ],
    )
}

// What every row leaves that ends an install after the download started.
static fn stopping(chart: Rows, message: Message, status: u8) -> Rows {
  return chart
    |> Chart.leaves(
      &[
        Footprint.Removes { place: Place.Staging },
        Footprint.Says { message: message },
        Footprint.Exits { status: status },
      ],
    )
}

// What a row leaves that ends the command with one message.
static fn ending(chart: Rows, message: Message, status: u8) -> Rows {
  return chart
    |> Chart.leaves(&[Footprint.Says { message: message }, Footprint.Exits { status: status }])
}

// The exit status of the help: 2 for `silk` alone, 0 when the user asked for it.
static fn helped(chart: Rows) -> Rows {
  return chart
    |> Chart.leaves(&[Footprint.Says { message: Message.OwnCommands }])
    |> Chart.leavesWhen(Guards.named("the user asked for the help", polite), &[Footprint.Exits { status: 0 }])
    |> Chart.leavesWhen(Guards.named("`silk` was typed alone", bare), &[Footprint.Exits { status: 2 }])
}

// What the tool says and starts when it runs the compiler of the selected version.
static fn starting(chart: Rows, program: Program) -> Rows {
  return chart
    |> Chart.leavesWhen(Guards.named("a member pins a version beside its workspace", ignoresMember), &[Footprint.Says { message: Message.IgnoredPin }])
    |> Chart.leaves(&[Footprint.Runs { program: program }])
}

/// The rows of the commands that manage versions: `silk use`, `silk set` and
/// `silk update self`, and the install they share.
pub static fn versions(chart: Rows) -> Rows {
  return chart
    // silk use <version>
    |> Chart.refuseWhen("Idle", "Use", Guards.named("no home directory is known", homeless), "there is no place for versions")
    |> ending(Message.NoHome, 1)
    |> Chart.refuseWhen("Idle", "Use", Guards.named("the project's pin is not one version", pinBlocks), "the project's pin cannot be read")
    |> ending(Message.UnknownPin, 2)
    |> Chart.onWhen("Idle", "Use", Silk.Ready, Guards.named("the version is installed", subjectInstalled))
    |> Chart.on("Idle", "Use", Silk.Resolving)
    |> Chart.leaves(&[Footprint.Downloads { asset: Asset.Listing }])

    // silk use latest, silk use dev
    |> Chart.refuseWhen("Idle", "UseNewest", Guards.named("no home directory is known", homeless), "there is no place for versions")
    |> ending(Message.NoHome, 1)
    |> Chart.refuseWhen("Idle", "UseNewest", Guards.named("the project's pin is not one version", pinBlocks), "the project's pin cannot be read")
    |> ending(Message.UnknownPin, 2)
    |> Chart.on("Idle", "UseNewest", Silk.Choosing)
    |> Chart.leaves(&[Footprint.Downloads { asset: Asset.Listing }])

    // silk use
    |> Chart.refuseWhen("Idle", "UsePinned", Guards.named("no home directory is known", homeless), "there is no place for versions")
    |> ending(Message.NoHome, 1)
    |> Chart.refuseWhen("Idle", "UsePinned", Guards.named("the project's pin is not one version", pinBlocks), "the project's pin cannot be read")
    |> ending(Message.UnknownPin, 2)
    |> Chart.refuseWhen("Idle", "UsePinned", Guards.named("no project pins a version here", unpinned), "there is no pin to install")
    |> ending(Message.NoPin, 2)
    |> Chart.onWhen("Idle", "UsePinned", Silk.Ready, Guards.named("the version is installed", subjectInstalled))
    |> Chart.on("Idle", "UsePinned", Silk.Resolving)
    |> Chart.leaves(&[Footprint.Downloads { asset: Asset.Listing }])

    // silk use list
    |> Chart.refuseWhen("Idle", "List", Guards.named("no home directory is known", homeless), "there is no place for versions")
    |> ending(Message.NoHome, 1)
    |> Chart.refuseWhen("Idle", "List", Guards.named("SILK_TOOLCHAIN is not a version", environmentMalformed), "the environment names no version")
    |> ending(Message.BadEnvironment, 2)
    |> Chart.refuseWhen("Idle", "List", Guards.named("the project's pin is not one version", pinBlocks), "the project's pin cannot be read")
    |> ending(Message.UnknownPin, 2)
    |> Chart.stay("Idle", "List")
    |> ending(Message.Versions, 0)

    // silk use which
    |> Chart.refuseWhen("Idle", "Which", Guards.named("SILK_TOOLCHAIN is not a version", environmentMalformed), "the environment names no version")
    |> ending(Message.BadEnvironment, 2)
    |> Chart.refuseWhen("Idle", "Which", Guards.named("the project's pin is not one version, and nothing overrides it", selectionBlocked), "the project's pin cannot be read")
    |> ending(Message.UnknownPin, 2)
    |> Chart.refuseWhen("Idle", "Which", Guards.named("nothing selects a version", nothingSelected), "there is no version to show")
    |> ending(Message.NothingSelected, 3)
    |> Chart.stayWhen("Idle", "Which", Guards.named("the version is installed", subjectInstalled))
    |> Chart.leaves(&[Footprint.Says { message: Message.Selected }])
    |> Chart.leavesWhen(Guards.named("a member pins a version beside its workspace", ignoresMember), &[Footprint.Says { message: Message.IgnoredPin }])
    |> Chart.leaves(&[Footprint.Exits { status: 0 }])
    |> Chart.stay("Idle", "Which")
    |> Chart.leaves(&[Footprint.Says { message: Message.Selected }])
    |> Chart.leavesWhen(Guards.named("a member pins a version beside its workspace", ignoresMember), &[Footprint.Says { message: Message.IgnoredPin }])
    |> ending(Message.NotInstalled, 3)

    // silk use uninstall <version>
    |> Chart.refuseWhen("Idle", "Uninstall", Guards.named("no home directory is known", homeless), "there is no place for versions")
    |> ending(Message.NoHome, 1)
    |> Chart.stayWhen("Idle", "Uninstall", Guards.named("the version has no directory", subjectAbsent))
    |> ending(Message.NothingToRemove, 0)
    |> Chart.stay("Idle", "Uninstall")
    |> Chart.leaves(&[Footprint.Removes { place: Place.Toolchain }, Footprint.Says { message: Message.Removed }])
    |> Chart.leavesWhen(Guards.named("the version was the default", wasDefault), &[Footprint.Says { message: Message.WasDefault }])
    |> Chart.leavesWhen(Guards.named("the project pins the version", pinnedHere), &[Footprint.Says { message: Message.PinnedHere }])
    |> Chart.leaves(&[Footprint.Exits { status: 0 }])

    // silk set <version>
    |> Chart.refuseWhen("Idle", "Set", Guards.named("there is no silk.toml here or above", projectless), "there is no project to pin")
    |> ending(Message.NoProject, 2)
    |> Chart.refuseWhen("Idle", "Set", Guards.named("the project's pin is no version", pinUnreadable), "the project's pin cannot be read")
    |> ending(Message.UnknownPin, 2)
    |> Chart.onWhen("Idle", "Set", Silk.Editing, Guards.named("the version is installed", subjectInstalled))
    |> Chart.on("Idle", "Set", Silk.Resolving)
    |> Chart.leaves(&[Footprint.Downloads { asset: Asset.Listing }])

    // silk set latest, silk set dev
    |> Chart.refuseWhen("Idle", "SetNewest", Guards.named("there is no silk.toml here or above", projectless), "there is no project to pin")
    |> ending(Message.NoProject, 2)
    |> Chart.refuseWhen("Idle", "SetNewest", Guards.named("the project's pin is no version", pinUnreadable), "the project's pin cannot be read")
    |> ending(Message.UnknownPin, 2)
    |> Chart.on("Idle", "SetNewest", Silk.Choosing)
    |> Chart.leaves(&[Footprint.Downloads { asset: Asset.Listing }])

    // silk update self
    |> Chart.refuseWhen("Idle", "UpdateSelf", Guards.named("no home directory is known", homeless), "there is no place for the tool")
    |> ending(Message.NoHome, 1)
    |> Chart.on("Idle", "UpdateSelf", Silk.Checking)
    |> Chart.leaves(&[Footprint.Downloads { asset: Asset.Listing }])

    // Is the version published?
    |> Chart.awaits("Resolving", "Found")
    |> Chart.awaits("Resolving", "Missing")
    |> Chart.awaits("Resolving", "Unreachable")
    |> Chart.awaits("Resolving", "Blocked")
    |> Chart.onWhen("Resolving", "Found", Silk.Editing, Guards.named("the command pins a project", setting))
    |> Chart.on("Resolving", "Found", Silk.Downloading)
    |> fetching()
    |> Chart.on("Resolving", "Missing", Silk.Idle)
    |> ending(Message.NotPublished, 1)
    |> Chart.on("Resolving", "Unreachable", Silk.Idle)
    |> ending(Message.Unreachable, 4)
    |> Chart.on("Resolving", "Blocked", Silk.Idle)
    |> ending(Message.Blocked, 1)

    // Which release is the newest?
    |> Chart.awaits("Choosing", "Newest")
    |> Chart.awaits("Choosing", "NoStable")
    |> Chart.awaits("Choosing", "NoReleases")
    |> Chart.awaits("Choosing", "Unreachable")
    |> Chart.awaits("Choosing", "Blocked")
    |> Chart.onWhen("Choosing", "Newest", Silk.Editing, Guards.named("the command pins a project", setting))
    |> Chart.onWhen("Choosing", "Newest", Silk.Ready, Guards.named("the version is installed", subjectInstalled))
    |> Chart.on("Choosing", "Newest", Silk.Downloading)
    |> fetching()
    |> Chart.on("Choosing", "NoStable", Silk.Idle)
    |> ending(Message.NoStable, 1)
    |> Chart.on("Choosing", "NoReleases", Silk.Idle)
    |> ending(Message.NoReleases, 4)
    |> Chart.on("Choosing", "Unreachable", Silk.Idle)
    |> ending(Message.Unreachable, 4)
    |> Chart.on("Choosing", "Blocked", Silk.Idle)
    |> ending(Message.Blocked, 1)

    // The edits are made before the download, and written after it, so a failed download
    // leaves the project as it was.
    |> Chart.awaits("Editing", "Edited")
    |> Chart.awaits("Editing", "Refused")
    |> Chart.onWhen("Editing", "Edited", Silk.Ready, Guards.named("the command only pins", onlyPinning))
    |> Chart.onWhen("Editing", "Edited", Silk.Idle, Guards.named("no home directory is known", homeless))
    |> ending(Message.NoHome, 1)
    |> Chart.onWhen("Editing", "Edited", Silk.Ready, Guards.named("the version is installed", keptInstalled))
    |> Chart.on("Editing", "Edited", Silk.Downloading)
    |> fetching()
    |> Chart.on("Editing", "Refused", Silk.Idle)
    |> ending(Message.CannotEdit, 1)

    // The download, for a toolchain and for the tool itself.
    |> Chart.awaits("Downloading", "Arrived")
    |> Chart.awaits("Downloading", "Cut")
    |> Chart.awaits("Downloading", "Blocked")
    |> Chart.on("Downloading", "Arrived", Silk.Verifying)
    |> Chart.onWhen("Downloading", "Cut", Silk.Idle, Guards.named("the tool updates itself", updating))
    |> ending(Message.DownloadFailed, 4)
    |> Chart.on("Downloading", "Cut", Silk.Idle)
    |> stopping(Message.DownloadFailed, 4)
    |> Chart.onWhen("Downloading", "Blocked", Silk.Idle, Guards.named("the tool updates itself", updating))
    |> ending(Message.Blocked, 1)
    |> Chart.on("Downloading", "Blocked", Silk.Idle)
    |> stopping(Message.Blocked, 1)

    |> Chart.awaits("Verifying", "Genuine")
    |> Chart.awaits("Verifying", "Forged")
    |> Chart.awaits("Verifying", "Blocked")
    |> Chart.onWhen("Verifying", "Genuine", Silk.Replacing, Guards.named("the tool updates itself", updating))
    |> Chart.on("Verifying", "Genuine", Silk.Unpacking)
    |> Chart.onWhen("Verifying", "Forged", Silk.Idle, Guards.named("the tool updates itself", updating))
    |> ending(Message.Forged, 5)
    |> Chart.on("Verifying", "Forged", Silk.Idle)
    |> stopping(Message.Forged, 5)
    |> Chart.onWhen("Verifying", "Blocked", Silk.Idle, Guards.named("the tool updates itself", updating))
    |> ending(Message.Blocked, 1)
    |> Chart.on("Verifying", "Blocked", Silk.Idle)
    |> stopping(Message.Blocked, 1)

    |> Chart.awaits("Unpacking", "Placed")
    |> Chart.awaits("Unpacking", "Corrupt")
    |> Chart.awaits("Unpacking", "Blocked")
    |> Chart.on("Unpacking", "Placed", Silk.Ready)
    |> Chart.leavesWhen(Guards.named("a directory without a compiler has the version's name", damaged), &[Footprint.Removes { place: Place.Toolchain }])
    |> Chart.leaves(&[Footprint.Creates { place: Place.Toolchain }])
    |> Chart.on("Unpacking", "Corrupt", Silk.Idle)
    |> stopping(Message.Corrupt, 5)
    |> Chart.on("Unpacking", "Blocked", Silk.Idle)
    |> stopping(Message.Blocked, 1)

    // The version is in place: each command finishes in its own way.
    |> Chart.alwaysWhen("Ready", Silk.Idle, Guards.named("the command is silk use <version>", usingVersion))
    |> Chart.leavesWhen(Guards.named("this command installed the version", fresh), &[Footprint.Says { message: Message.Installed }])
    |> Chart.leavesWhen(Guards.named("the version was installed before", stale), &[Footprint.Says { message: Message.AlreadyInstalled }])
    |> Chart.leaves(&[Footprint.Changes { place: Place.Settings }, Footprint.Says { message: Message.DefaultSet }])
    |> Chart.leavesWhen(Guards.named("the project pins another version", pinnedElsewhere), &[Footprint.Says { message: Message.StillPins }])
    |> Chart.leaves(&[Footprint.Exits { status: 0 }])

    |> Chart.alwaysWhen("Ready", Silk.Idle, Guards.named("the command is silk use", usingPinned))
    |> Chart.leavesWhen(Guards.named("this command installed the version", fresh), &[Footprint.Says { message: Message.Installed }])
    |> Chart.leavesWhen(Guards.named("the version was installed before", stale), &[Footprint.Says { message: Message.AlreadyInstalled }])
    |> Chart.leaves(&[Footprint.Exits { status: 0 }])

    |> Chart.alwaysWhen("Ready", Silk.Idle, Guards.named("the command is silk set", settingPin))
    |> Chart.leavesWhen(Guards.named("the project does not pin the version as this tool writes it", pinMoves), &[Footprint.Changes { place: Place.Manifest }])
    |> Chart.leavesWhen(Guards.named("members of the workspace pin a version themselves", memberPins), &[Footprint.Changes { place: Place.Members }])
    |> Chart.leaves(&[Footprint.Says { message: Message.Pinned }])
    |> Chart.leavesWhen(Guards.named("members of the workspace pin a version themselves", memberPins), &[Footprint.Says { message: Message.MembersUnpinned }])
    |> Chart.leavesWhen(Guards.named("this command installed the version", fresh), &[Footprint.Says { message: Message.Installed }])
    |> Chart.leavesWhen(Guards.named("the version is not installed", notInstalledYet), &[Footprint.Says { message: Message.NotInstalledYet }])
    |> Chart.leavesWhen(Guards.named("the version is older than the tool", olderThanTool), &[Footprint.Says { message: Message.OlderThanTool }])
    |> Chart.leaves(&[Footprint.Exits { status: 0 }])

    // silk update self
    |> Chart.awaits("Checking", "Outdated")
    |> Chart.awaits("Checking", "Current")
    |> Chart.awaits("Checking", "NoReleases")
    |> Chart.awaits("Checking", "Unreachable")
    |> Chart.awaits("Checking", "Blocked")
    |> Chart.on("Checking", "Outdated", Silk.Downloading)
    |> Chart.leaves(&[Footprint.Downloads { asset: Asset.Archive }, Footprint.Downloads { asset: Asset.Signature }])
    |> Chart.on("Checking", "Current", Silk.Idle)
    |> ending(Message.UpToDate, 0)
    |> Chart.on("Checking", "NoReleases", Silk.Idle)
    |> ending(Message.NoReleases, 4)
    |> Chart.on("Checking", "Unreachable", Silk.Idle)
    |> ending(Message.Unreachable, 4)
    |> Chart.on("Checking", "Blocked", Silk.Idle)
    |> ending(Message.Blocked, 1)

    |> Chart.awaits("Replacing", "Replaced")
    |> Chart.awaits("Replacing", "Corrupt")
    |> Chart.awaits("Replacing", "Blocked")
    |> Chart.on("Replacing", "Replaced", Silk.Idle)
    |> Chart.leaves(&[Footprint.Changes { place: Place.Tool }])
    |> ending(Message.Updated, 0)
    |> Chart.on("Replacing", "Corrupt", Silk.Idle)
    |> ending(Message.Corrupt, 5)
    |> Chart.on("Replacing", "Blocked", Silk.Idle)
    |> ending(Message.Blocked, 1)
}

/// The rows of a command that goes to a compiler, of the help, which asks the selected
/// compiler for its commands, and of words that are no command.
pub static fn selection(chart: Rows) -> Rows {
  return chart
    |> Chart.refuse("Idle", "Misuse", "the words are not a command")
    |> ending(Message.Usage, 2)

    // silk <command>, silk +<version> <command>
    |> Chart.refuseWhen("Idle", "Run", Guards.named("+<version> is not a version", badRequest), "the command line names no version")
    |> ending(Message.BadRequest, 2)
    |> Chart.refuseWhen("Idle", "Run", Guards.named("SILK_TOOLCHAIN is not a version", badEnvironment), "the environment names no version")
    |> ending(Message.BadEnvironment, 2)
    |> Chart.refuseWhen("Idle", "Run", Guards.named("the project's pin is not one version, and nothing overrides it", unknownPin), "the project's pin cannot be read")
    |> ending(Message.UnknownPin, 2)
    |> Chart.onWhen("Idle", "Run", Silk.Starting, Guards.named("the compiler beside the tool serves", runsBundled))
    |> starting(Program.Bundled)
    |> Chart.refuseWhen("Idle", "Run", Guards.named("nothing selects a version", runsNothing), "there is no version to run")
    |> ending(Message.NothingSelected, 3)
    |> Chart.refuseWhen("Idle", "Run", Guards.named("no home directory is known", runsHomeless), "there is no place for versions")
    |> ending(Message.NoHome, 1)
    |> Chart.onWhen("Idle", "Run", Silk.Starting, Guards.named("the selected version is installed", runsCompiler))
    |> starting(Program.Compiler)
    |> Chart.onWhen("Idle", "Run", Silk.Resolving, Guards.named("automatic installs are on", runsInstall))
    |> Chart.leaves(&[Footprint.Says { message: Message.Installing }, Footprint.Downloads { asset: Asset.Listing }])
    |> Chart.refuse("Idle", "Run", "the selected version is not installed")
    |> ending(Message.NotInstalled, 3)

    // The automatic install is done: the command goes on.
    |> Chart.alwaysWhen("Ready", Silk.Starting, Guards.named("the command goes to a compiler", running))
    |> Chart.leaves(&[Footprint.Says { message: Message.Installed }])
    |> starting(Program.Compiler)

    |> Chart.awaits("Starting", "Started")
    |> Chart.awaits("Starting", "Stuck")
    |> Chart.on("Starting", "Started", Silk.Idle)
    |> Chart.on("Starting", "Stuck", Silk.Idle)
    |> ending(Message.CannotRun, 1)

    // silk --help, and silk alone
    |> Chart.onWhen("Idle", "Help", Silk.Asking, Guards.named("a compiler can answer", hasCompiler))
    |> Chart.leavesWhen(Guards.named("a member pins a version beside its workspace", ignoresMember), &[Footprint.Says { message: Message.IgnoredPin }])
    |> Chart.leavesWhen(Guards.named("the compiler beside the tool serves", besideTool), &[Footprint.Runs { program: Program.Bundled }])
    |> Chart.leavesWhen(Guards.named("the selected version is installed", inStore), &[Footprint.Runs { program: Program.Compiler }])
    |> Chart.stay("Idle", "Help")
    |> Chart.leavesWhen(Guards.named("SILK_TOOLCHAIN is not a version", helpBadEnvironment), &[Footprint.Says { message: Message.BadEnvironment }])
    |> Chart.leavesWhen(Guards.named("the project's pin is not one version, and nothing overrides it", helpUnknownPin), &[Footprint.Says { message: Message.UnknownPin }])
    |> Chart.leavesWhen(Guards.named("nothing selects a version", helpNothing), &[Footprint.Says { message: Message.NothingSelected }])
    |> Chart.leavesWhen(Guards.named("no home directory is known", helpHomeless), &[Footprint.Says { message: Message.NoHome }])
    |> Chart.leavesWhen(Guards.named("the selected version is not installed", helpMissing), &[Footprint.Says { message: Message.NotInstalled }])
    |> helped()
    |> Chart.awaits("Asking", "Told")
    |> Chart.awaits("Asking", "Silent")
    |> Chart.on("Asking", "Told", Silk.Idle)
    |> Chart.leaves(&[Footprint.Says { message: Message.Overview }])
    |> helped()
    |> Chart.on("Asking", "Silent", Silk.Idle)
    |> Chart.leaves(&[Footprint.Says { message: Message.HelpFailed }])
    |> helped()

    // A word one edit away from a command of the tool. The selected compiler may have a
    // command that near too, and then the word is the compiler's.
    |> Chart.onWhen("Idle", "Near", Silk.Comparing, Guards.named("a compiler can answer", hasCompiler))
    |> Chart.leavesWhen(Guards.named("the compiler beside the tool serves", besideTool), &[Footprint.Runs { program: Program.Bundled }])
    |> Chart.leavesWhen(Guards.named("the selected version is installed", inStore), &[Footprint.Runs { program: Program.Compiler }])
    |> Chart.refuse("Idle", "Near", "the word is no command")
    |> ending(Message.UnknownCommand, 2)
    |> Chart.awaits("Comparing", "Owned")
    |> Chart.awaits("Comparing", "Unowned")
    |> Chart.on("Comparing", "Owned", Silk.Idle)
    |> Chart.on("Comparing", "Unowned", Silk.Idle)
    |> ending(Message.UnknownCommand, 2)
}

impl Machine<Typed, Computer, Footprint> for Silk {
  static fn chart() -> Chart<Silk, Typed, Computer, Footprint> {
    return Chart<Silk, Typed, Computer, Footprint>.of()
      |> Chart.initial(Silk.Idle)
      |> versions()
      |> selection()
  }

  // Notes the command, so the rows that follow know what it is about.
  effect fn handle(state: &Silk, context: &mut Computer, event: &Typed, enq: &mut Enqueue<Typed, Footprint>) -> Next<Silk>
    ! OutOfMemoryError
    ? &mut Allocator {
    let about = subject(&context.*, event)
    match &event.* {
      Typed.Use { .. } => {
        context.task = Task.Using
        context.subject = about
      }
      Typed.UseNewest { .. } => {
        context.task = Task.Using
      }
      Typed.UsePinned => {
        context.task = Task.UsingPinned
        context.subject = about
      }
      Typed.List => {
        context.task = Task.Asking
      }
      Typed.Which => {
        context.task = Task.Asking
        context.subject = about
        context.origin = context.selects(Named.Unset).origin
      }
      Typed.Uninstall { .. } => {
        context.task = Task.Asking
        context.subject = about
      }
      Typed.Set { install, .. } => {
        context.task = if install { Task.Setting } else { Task.Pinning }
        context.subject = about
      }
      Typed.SetNewest { install, .. } => {
        context.task = if install { Task.Setting } else { Task.Pinning }
      }
      Typed.UpdateSelf => {
        context.task = Task.Updating
      }
      Typed.Run { asked } => {
        context.task = Task.Running
        context.subject = about
        context.origin = context.selects(asked).origin
      }
      Typed.Help { bare } => {
        context.task = Task.Helping
        context.subject = about
        context.origin = context.selects(Named.Unset).origin
        context.bare = bare
      }
      Typed.Near => {
        context.task = Task.Guessing
        context.subject = about
        context.origin = context.selects(Named.Unset).origin
      }
      Typed.Edited { respells } => {
        context.respells = respells
      }
      Typed.Newest { .. } => {
        context.subject = about
      }

      // The tool is the compiler now, and the word is the compiler's.
      Typed.Started => {
        context.rest()
      }
      Typed.Owned => {
        context.rest()
        run enq.raise(Typed.Run { asked: Named.Unset })
      }
      _ => {}
    }
    return Next<Silk>.Pass
  }

  // The computer after one effect of a row.
  fn absorb(state: &Silk, context: &mut Computer, effect_: &Footprint) -> () {
    let about = context.subject
    match &effect_.* {
      Footprint.Creates { place } => {
        if place == Place.Toolchain {
          context.keep(about, Store.Installed)
          context.fresh = true
          context.debris = false
        }
        if place == Place.Staging {
          context.debris = true
        }
      }
      Footprint.Removes { place } => {
        if place == Place.Toolchain {
          context.keep(about, Store.Absent)
        }
        if place == Place.Staging {
          context.debris = false
        }
      }
      Footprint.Changes { place } => {
        if place == Place.Settings {
          context.standard = about
        }
        if place == Place.Manifest {
          context.pin.state = Pinned.Own
          context.pin.version = about
        }
        if place == Place.Members {
          context.strays = false
          context.ignored = false
        }
      }

      // The process ends, and what it kept in mind is gone.
      Footprint.Exits { .. } => {
        context.rest()
      }
      _ => {}
    }
    return ()
  }
}
