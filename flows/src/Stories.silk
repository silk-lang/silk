//! Stories: what a person does with `silk` from start to end, as the events of the machine.
//!
//! The model checks reach every state, and they do it in an order no person would. A story is
//! a path a person takes, such as a first install, written by hand. A test replays each story on
//! the machine, and the runner replays it on the real tool.

import Computer { Choice, Computer, Named, Pin, Pinned, Project, Version }
import Silk { Typed }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }

/// One path through the tool.
pub struct Story {
  /// A short name without spaces, such as `first-install`.
  pub name: string<'static>,
  /// What the person does, in one sentence.
  pub about: string<'static>,
  /// The computer the story starts on.
  pub start: Computer,
  /// What the person types and what the world answers, in order.
  pub events: List<Typed>,
}

effect fn told(name: string<'static>, about: string<'static>, start: Computer, events: &[Typed]) -> Story
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut listed = List<Typed>.make()
  let mut index: usize = 0
  while index < events.length {
    run List<Typed>.append(&mut listed, again(&events[index]))
    index = index + 1
  }
  return Story { name: name, about: about, start: move start, events: move listed }
}

// A second value of `event`.
fn again(event: &Typed) -> Typed {
  return match &event.* {
    Typed.Misuse => Typed.Misuse
    Typed.Use { version } => Typed.Use { version: version }
    Typed.UseNewest { stable } => Typed.UseNewest { stable: stable }
    Typed.UsePinned => Typed.UsePinned
    Typed.List => Typed.List
    Typed.Which => Typed.Which
    Typed.Uninstall { version } => Typed.Uninstall { version: version }
    Typed.Set { version, install } => Typed.Set { version: version, install: install }
    Typed.SetNewest { stable, install } => Typed.SetNewest { stable: stable, install: install }
    Typed.UpdateSelf => Typed.UpdateSelf
    Typed.Run { asked } => Typed.Run { asked: asked }
    Typed.Help { bare } => Typed.Help { bare: bare }
    Typed.Near => Typed.Near
    Typed.Found => Typed.Found
    Typed.Missing => Typed.Missing
    Typed.Newest { version } => Typed.Newest { version: version }
    Typed.NoStable => Typed.NoStable
    Typed.NoReleases => Typed.NoReleases
    Typed.Unreachable => Typed.Unreachable
    Typed.Edited { respells } => Typed.Edited { respells: respells }
    Typed.Refused => Typed.Refused
    Typed.Arrived => Typed.Arrived
    Typed.Cut => Typed.Cut
    Typed.Genuine => Typed.Genuine
    Typed.Forged => Typed.Forged
    Typed.Placed => Typed.Placed
    Typed.Corrupt => Typed.Corrupt
    Typed.Blocked => Typed.Blocked
    Typed.Started => Typed.Started
    Typed.Stuck => Typed.Stuck
    Typed.Outdated => Typed.Outdated
    Typed.Current => Typed.Current
    Typed.Replaced => Typed.Replaced
    Typed.Told => Typed.Told
    Typed.Silent => Typed.Silent
    Typed.Owned => Typed.Owned
    Typed.Unowned => Typed.Unowned
  }
}

/// The stories of the `silk` tool.
pub effect fn stories() -> List<Story>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut all = List<Story>.make()

  run List<Story>.append(
    &mut all,
    run told(
      "first-install",
      "On a new computer, a person installs the newest Silk, looks at what is selected, and builds.",
      Computer.empty(),
      &[
        Typed.Which,
        Typed.UseNewest { stable: true },
        Typed.Newest { version: Version.Second },
        Typed.Arrived,
        Typed.Genuine,
        Typed.Placed,
        Typed.Which,
        Typed.List,
        Typed.Run { asked: Named.Unset },
        Typed.Started,
      ],
    ),
  )

  let mut project = Computer.empty()
  project.project = Project.Package
  run List<Story>.append(
    &mut all,
    run told(
      "pin-a-project",
      "A person pins a project to a version, which installs it, and a second person who clones the project installs the pin.",
      move project,
      &[
        Typed.Set { version: Version.First, install: true },
        Typed.Found,
        Typed.Edited { respells: false },
        Typed.Arrived,
        Typed.Genuine,
        Typed.Placed,
        Typed.Run { asked: Named.Unset },
        Typed.Started,
        Typed.Uninstall { version: Version.First },
        Typed.Run { asked: Named.Unset },
        Typed.UsePinned,
        Typed.Found,
        Typed.Arrived,
        Typed.Genuine,
        Typed.Placed,
        Typed.Run { asked: Named.Unset },
        Typed.Started,
      ],
    ),
  )

  let mut cloned = Computer.empty()
  cloned.project = Project.Workspace
  cloned.pin = Pin { state: Pinned.Own, version: Choice.First }
  cloned.autoInstall = true
  run List<Story>.append(
    &mut all,
    run told(
      "automatic-install",
      "With automatic installs on, the first build in a pinned project installs the pin and goes on.",
      move cloned,
      &[
        Typed.Run { asked: Named.Unset },
        Typed.Found,
        Typed.Arrived,
        Typed.Genuine,
        Typed.Placed,
        Typed.Started,
        Typed.Run { asked: Named.Unset },
        Typed.Started,
      ],
    ),
  )

  run List<Story>.append(
    &mut all,
    run told(
      "bad-download",
      "A download is cut, the next one is not signed by the release key, and the third installs.",
      Computer.empty(),
      &[
        Typed.Use { version: Version.First },
        Typed.Found,
        Typed.Cut,
        Typed.Use { version: Version.First },
        Typed.Found,
        Typed.Arrived,
        Typed.Forged,
        Typed.List,
        Typed.Use { version: Version.First },
        Typed.Found,
        Typed.Arrived,
        Typed.Genuine,
        Typed.Placed,
        Typed.List,
      ],
    ),
  )

  let mut moving = Computer.empty()
  moving.project = Project.Workspace
  moving.pin = Pin { state: Pinned.Members, version: Choice.First }
  run List<Story>.append(
    &mut all,
    run told(
      "move-a-workspace",
      "A workspace whose members pin a version moves to the newest one without installing it, and the next command says how to install it.",
      move moving,
      &[
        Typed.SetNewest { stable: true, install: false },
        Typed.Newest { version: Version.Third },
        Typed.Edited { respells: false },
        Typed.Which,
        Typed.Run { asked: Named.Unset },
        Typed.Run { asked: Named.Fourth },
      ],
    ),
  )

  run List<Story>.append(
    &mut all,
    run told(
      "update-the-tool",
      "A person asks for the help, mistypes a command, and updates the tool.",
      Computer.empty(),
      &[
        Typed.Help { bare: true },
        Typed.Near,
        Typed.Misuse,
        Typed.UpdateSelf,
        Typed.Current,
        Typed.UpdateSelf,
        Typed.Outdated,
        Typed.Arrived,
        Typed.Genuine,
        Typed.Replaced,
      ],
    ),
  )
  return move all
}
