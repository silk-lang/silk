//! The trips of the compiler's reference machines: for each machine, every way a command of it
//! can go, as a path of commands from a directory a run can set up.
//!
//! `silk task cover` writes each list to a file below `flows/trips`, and `silk task drive`
//! takes each trip on a real toolchain.

import BuildFlow { Bay, Building, Make }
import BuildFlow as Builds
import DependencyFlow { Ask, Depending, Shelves }
import DependencyFlow as Dependencies
import ProjectFlow { Creating, Site, Start }
import ProjectFlow as Projects
import ServerFlow { Call, Desk, Serving }
import ServerFlow as Servers
import Trail { Trail }
import Trips { Trip, trips }
import silk.collections.list { List }
import silk.machine.explore { Explorer }
import silk.machine.snapshot { TransitionLoopError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.schema.issue { SchemaError }

/// The trips of `silk init`, named `project-001` and so on.
///
/// # Errors
/// `TransitionLoopError` when the machine does not settle. `SchemaError` when a context cannot
/// be compared. `OutOfMemoryError`.
pub effect fn projectTrips() -> List<Trip<Start, Site, Trail>>
  ! OutOfMemoryError | TransitionLoopError | SchemaError
  ? &mut Allocator {
  let tried = run Projects.events()
  let events = tried.asSlice()
  let walk = run Explorer.walk<Creating, Start, Site, Trail>(run Projects.starts(), events, 2000)
  return run trips<Creating, Start, Site, Trail>(&walk, events, 4, "project")
}

/// The trips of the dependency commands, named `dependency-001` and so on.
///
/// # Errors
/// `TransitionLoopError` when the machine does not settle. `SchemaError` when a context cannot
/// be compared. `OutOfMemoryError`.
pub effect fn dependencyTrips() -> List<Trip<Ask, Shelves, Trail>>
  ! OutOfMemoryError | TransitionLoopError | SchemaError
  ? &mut Allocator {
  let tried = run Dependencies.events()
  let events = tried.asSlice()
  let walk = run Explorer.walk<Depending, Ask, Shelves, Trail>(
    run Dependencies.starts(),
    events,
    2000,
  )
  return run trips<Depending, Ask, Shelves, Trail>(&walk, events, 1, "dependency")
}

