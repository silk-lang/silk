//! The binding of the machine of the dependency commands, `DependencyFlow`, to the local world.
//!
//! The package of a trip is the directory `app` below the work directory. The archive of the
//! library `shelf` is a file of the trip, `shop/shelf.tar.gz` beside the work directory, so
//! that a trip can take it away: that is how the world answers that the archive is lost.

import Bench { Bench, Binding, Stage }
import DependencyFlow { Ask, Listed, Shelves, Sum }
import World { Outcome }
import Trail { Trail }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.crypto.sha2 { Sha256 }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u8
import silk.num.usize
import silk.system.child_process { ChildProcess, ProcessError }
import silk.system.filesystem { DirectoryEntry, FileError, FileSystem, Path }

/// The binding of `DependencyFlow`. It has no fields, because a stage holds everything of a trip.
pub struct DependencyBinding {}

fn holds(text: &[u8], part: &[u8]) -> bool {
  let mut at: usize = 0
  while at + part.length <= text.length {
    if Slice.view<u8>(text, at, part.length) == part {
      return true
    }
    at = at + 1
  }
  return false
}

effect fn word(words: &mut List<Bytes>, text: &[u8]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  return run List<Bytes>.append(&mut words.*, run Bytes.copy(text))
}

fn digit(value: u8) -> u8 {
  if value < 10 {
    return value + 48
  }
  return value + 87
}

// The file of the archive of the trip.
effect fn shop(stage: &Stage) -> Path
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  return run Path.join(&stage.directory, "shop/shelf.tar.gz")
}

// Puts the archive of the trip where its URL names it when `there` is true, and takes it away
// otherwise.
effect fn stock(stage: &Stage, bench: &Bench, there: bool) -> ()
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let file = run shop(stage)
  let found = run FileSystem.exists(&file)
  if there && !found {
    let content = run FileSystem.readFile(&run bench.archiveFile())
    run FileSystem.createDirectoriesRecursively(&run Path.join(&stage.directory, "shop"))
    return run FileSystem.writeFile(&file, content.asSlice())
  }
  if !there && found {
    return run FileSystem.removeFile(&file)
  }
  return ()
}

// The words `add` and the URL of the archive of the trip.
effect fn adding(words: &mut List<Bytes>, stage: &Stage) -> ()
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  run word(&mut words.*, b"add")
  let mut url = run Bytes.copy(b"file://")
  run Bytes.append(&mut url, Path.rawBytes(&run shop(stage)))
  return run List<Bytes>.append(&mut words.*, move url)
}

impl Binding<Ask, Shelves> for DependencyBinding {
  /// Writes the package `app`, whose source imports the module `lib` of `shelf`. Every trip
  /// starts with no dependency and an empty store, so `start` adds nothing.
  effect fn arrange(self: &Self, stage: &mut Stage, bench: &Bench, start: &Shelves) -> ()
    ! FileError | ProcessError | OutOfMemoryError
    ? &mut FileSystem | &mut ChildProcess | &mut Allocator {
    stage.inside = b"app"
    let package = run Path.join(&stage.work, "app")
    run FileSystem.createDirectoriesRecursively(&run Path.join(&package, "src"))
    run FileSystem.writeFile(
      &run Path.join(&package, "silk.toml"),
      (run stage.manifest(b"[package]\nname = \"app\"\nversion = \"0.1.0\"\n")).asSlice(),
    )
    return run FileSystem.writeFile(
      &run Path.join(&package, "src/main.silk"),
      b"import shelf.lib { add }\n\npub fn main() -> i32 {\n  return add(1, 2) - 3\n}\n",
    )
  }

  /// The words of `command`. It first puts the archive where its URL names it, or takes it
  /// away when `answers` has `Ask.Lost`, and sets `SILK_OFFLINE` for the commands that have it.
  /// `Ask.Purge` empties the archive store and gives no word.
  effect fn act(
    self: &Self,
    stage: &mut Stage,
    bench: &Bench,
    command: &Ask,
    answers: &[Ask],
  ) -> List<Bytes>
    ! FileError | ProcessError | OutOfMemoryError
    ? &mut FileSystem | &mut ChildProcess | &mut Allocator {
    let mut words = List<Bytes>.make()
    let mut there = true
    let mut at: usize = 0
    while at < answers.length {
      if let Ask.Lost = &answers[at] {
        there = false
      }
      at = at + 1
    }
    run stock(&stage.*, bench, there)
    stage.offline = false
    match &command.* {
      Ask.AddPath => {
        run word(&mut words, b"add")
        run word(&mut words, Path.rawBytes(&run bench.library()))
      }
      Ask.AddMissing => {
        run word(&mut words, b"add")
        run word(&mut words, b"../nothing")
      }
      Ask.AddArchive { sum } => {
        run adding(&mut words, &stage.*)
        if sum != Sum.Unstated {
          run word(&mut words, b"--sha256")
          let content = run FileSystem.readFile(&run bench.archiveFile())
          let hash = Sha256.hash(content.asSlice())
          let mut text = Bytes.make()
          let mut each: usize = 0
          while each < 32 {
            let pair: [u8; 2] = if sum == Sum.Right {
              [digit(hash[each] / 16), digit(hash[each] % 16)]
            } else {
              [48, 48]
            }
            run Bytes.append(&mut text, &pair)
            each = each + 1
          }
          run List<Bytes>.append(&mut words, move text)
        }
      }
      Ask.AddOffline => {
        stage.offline = true
        run adding(&mut words, &stage.*)
      }
      Ask.Remove => {
        run word(&mut words, b"remove")
        run word(&mut words, b"shelf")
      }
      Ask.Fetch => {
        run word(&mut words, b"fetch")
      }
      Ask.FetchOffline => {
        stage.offline = true
        run word(&mut words, b"fetch")
      }
      Ask.Check => {
        run word(&mut words, b"check")
        run word(&mut words, b"--no-server")
      }
      Ask.CheckOffline => {
        stage.offline = true
        run word(&mut words, b"check")
        run word(&mut words, b"--no-server")
      }
      Ask.Purge => {
        let store = run Path.join(&stage.home, ".silk/archives")
        run FileSystem.removeDirectoryRecursively(&store)
        run FileSystem.createDirectoriesRecursively(&store)
      }
      _ => {}
    }
    return move words
  }

  /// What the manifest of the package lists for `shelf`, and whether the archive store holds
  /// anything.
  effect fn observed(self: &Self, stage: &Stage, bench: &Bench) -> Shelves
    ! FileError | OutOfMemoryError
    ? &mut FileSystem | &mut Allocator {
    let manifest = run FileSystem.readFile(&run Path.join(&stage.work, "app/silk.toml"))
    let mut listed = Listed.Nothing
    if holds(manifest.asSlice(), b"shelf = { path = ") {
      listed = Listed.Path
    } else if holds(manifest.asSlice(), b"shelf = { url = ") {
      listed = Listed.Archive
    }
    let kept = run FileSystem.listDirectory(&run Path.join(&stage.home, ".silk/archives"))
    return Shelves.of(listed, List<DirectoryEntry>.asSlice(&kept).length != 0)
  }

  /// The shelves without what only a running command knows.
  fn shown(self: &Self, context: &Shelves) -> Shelves {
    return Shelves.of(context.listed, context.stored)
  }

  /// The trail says everything of a dependency command, so nothing more is looked at.
  effect fn sound(
    self: &Self,
    stage: &Stage,
    bench: &Bench,
    command: &Ask,
    trail: &[Trail],
    outcome: &Outcome,
  ) -> List<Bytes>
    ! FileError | OutOfMemoryError
    ? &mut FileSystem | &mut Allocator {
    return List<Bytes>.make()
  }
}
