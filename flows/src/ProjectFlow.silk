//! `silk init` as a machine: [`Creating`] is where the command stands, [`Start`] is what the
//! user types and what the world answers, and [`Site`] is the directory the project goes to.
//!
//! This machine is a reference. The compiler does not run it: a run of the real compiler is
//! compared with it, and a disagreement is a bug in the compiler or a wrong row here.
//!
//! A package without `--template` comes from the official `default` template, which is fetched
//! with git. `--template minimal`, `--lib` and `--workspace` are written by the compiler itself,
//! with no network. A template may have `[[post-init]]` entries, which run after its files are
//! copied, and when one fails the project is removed again.

import Trail { Note, Spot, Trail }
import silk.build.events { Fetch }
import silk.collections.list { List }
import silk.machine.chart { Chart, Enqueue, Guards, Machine, Next }
import silk.machine.rules { Rules }
import silk.machine.snapshot { Snapshot, Steps, TransitionLoopError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.schema.schema { Schema }

/// Where one `silk init` stands. Every state but `Idle` waits for the world.
pub union Creating {
  /// No command runs.
  Idle,
  /// The compiler fetches the repository of the template.
  Fetching,
  /// The compiler fetches the repository of the templates to list them.
  Listing,
  /// The files of the template are copied, and its `[[post-init]]` entries run.
  Hooking,
}

/// What `silk init` is asked to create.
pub enum Kind {
  /// `silk init <path>`: a package from the official `default` template.
  Default,
  /// `silk init <path> --template minimal`: the package the compiler writes itself.
  Minimal,
  /// `silk init <path> --lib`: a library.
  Library,
  /// `silk init <path> --workspace`: a workspace with one starter package.
  Workspace,
  /// `silk init <path> --template <name>`: a package from a named template.
  Template,
}

/// What the user types, and what the world answers.
pub union Start {
  /// `silk init`, for one kind of project.
  Init { pub kind: Kind },
  /// `silk init --list`.
  Templates,
  /// `silk init --lib --workspace`.
  Clash,
  /// The world: the repository of the template cannot be fetched.
  Unreachable,
  /// The world: the repository arrived, and the template names no directory of it.
  Unlisted,
  /// The world: a template without `[[post-init]]` entries arrived.
  Plain,
  /// The world: a template with `[[post-init]]` entries arrived.
  Hooked,
  /// The world: every `[[post-init]]` entry ended with status 0.
  Passed,
  /// The world: a `[[post-init]]` entry failed. An entry that reaches outside the new project
  /// fails, because the entries run confined to it.
  Failed,
  /// The world: the repository of the templates arrived.
  Listed,
}

/// What the directory of the new project holds.
pub enum Target {
  /// There is no directory.
  Absent,
  /// A directory without a `silk.toml`.
  Plain,
  /// A directory with a `silk.toml`: a project.
  Taken,
}

/// The directory `silk init` creates a project in, and what is around it.
pub struct Site {
  pub target: Target,
  /// Whether the directory above is a workspace.
  pub around: bool,
  /// What the command that runs is asked to create. `Kind.Default` when none runs.
  pub kind: Kind,
  /// What the directory held when the command started, which a removed project leaves again.
  pub before: Target,
}

impl Schema for Creating {}

impl Schema for Kind {}

impl Schema for Start {}

impl Schema for Target {}

impl Schema for Site {}

impl Site {
  /// A directory that holds `target`, with a workspace above it when `around` is true, and no
  /// command running.
  pub fn of(target: Target, around: bool) -> Site {
    return Site { target: target, around: around, kind: Kind.Default, before: target }
  }
}

fn taken(site: &Site, event: &Start) -> bool {
  return site.target == Target.Taken
}

fn written(site: &Site, event: &Start) -> bool {
  return match &event.* {
    Start.Init { kind } => kind == Kind.Minimal || kind == Kind.Library || kind == Kind.Workspace
    _ => false
  }
}

fn joins(site: &Site) -> bool {
  return site.around && site.kind != Kind.Workspace
}

type Rows = Chart<Creating, Start, Site, Trail>

// What a row leaves that ends the command with one message.
static fn ending(chart: Rows, note: Note, status: u8) -> Rows {
  return chart |> Chart.leaves(&[Trail.Says { note: note }, Trail.Exits { status: status }])
}

// What a row leaves when the project is there to stay.
static fn created(chart: Rows) -> Rows {
  return chart
    |> Chart.leaves(&[Trail.Says { note: Note.Created }])
    |> Chart.leavesWhen(
      Guards.named("a workspace is around the new package", joins),
      &[Trail.Changes { spot: Spot.Workspace }, Trail.Says { note: Note.Joined }],
    )
    |> Chart.leaves(&[Trail.Exits { status: 0 }])
}

impl Machine<Start, Site, Trail> for Creating {
  static fn chart() -> Chart<Creating, Start, Site, Trail> {
    return Chart<Creating, Start, Site, Trail>.of()
      |> Chart.initial(Creating.Idle)

      // silk init --lib --workspace
      |> Chart.refuse("Idle", "Clash", "a project is a library or a workspace, not both")
      |> ending(Note.Clash, 2)

      // silk init
      |> Chart.refuseWhen(
        "Idle",
        "Init",
        Guards.named("the directory has a silk.toml", taken),
        "a project is never overwritten",
      )
      |> ending(Note.Taken, 2)
      |> Chart.stayWhen(
        "Idle",
        "Init",
        Guards.named("the compiler writes the project itself", written),
      )
      |> Chart.leaves(&[Trail.Creates { spot: Spot.Project }])
      |> created()
      |> Chart.on("Idle", "Init", Creating.Fetching)
      |> Chart.leaves(&[Trail.Fetches { source: Fetch.Template }])
      |> Chart.awaits("Fetching", "Unreachable")
      |> Chart.awaits("Fetching", "Unlisted")
      |> Chart.awaits("Fetching", "Plain")
      |> Chart.awaits("Fetching", "Hooked")
      |> Chart.on("Fetching", "Unreachable", Creating.Idle)
      |> ending(Note.Unfetched, 1)
      |> Chart.on("Fetching", "Unlisted", Creating.Idle)
      |> ending(Note.Unlisted, 1)
      |> Chart.on("Fetching", "Plain", Creating.Idle)
      |> Chart.leaves(&[Trail.Creates { spot: Spot.Project }])
      |> created()
      |> Chart.on("Fetching", "Hooked", Creating.Hooking)
      |> Chart.leaves(&[Trail.Creates { spot: Spot.Project }])
      |> Chart.awaits("Hooking", "Passed")
      |> Chart.awaits("Hooking", "Failed")
      |> Chart.on("Hooking", "Passed", Creating.Idle)
      |> created()
      |> Chart.on("Hooking", "Failed", Creating.Idle)
      |> Chart.leaves(
        &[
          Trail.Removes { spot: Spot.Project },
          Trail.Says { note: Note.HookFailed },
          Trail.Exits { status: 1 },
        ],
      )

      // silk init --list
      |> Chart.on("Idle", "Templates", Creating.Listing)
      |> Chart.leaves(&[Trail.Fetches { source: Fetch.Template }])
      |> Chart.awaits("Listing", "Unreachable")
      |> Chart.awaits("Listing", "Listed")
      |> Chart.on("Listing", "Unreachable", Creating.Idle)
      |> ending(Note.Unfetched, 1)
      |> Chart.on("Listing", "Listed", Creating.Idle)
      |> ending(Note.Templates, 0)
  }

  // Notes what the command is asked to create, so the rows that follow know.
  effect fn handle(
    state: &Creating,
    context: &mut Site,
    event: &Start,
    enq: &mut Enqueue<Start, Trail>,
  ) -> Next<Creating>
    ! OutOfMemoryError
    ? &mut Allocator {
    match &event.* {
      Start.Init { kind } => {
        context.kind = kind
        context.before = context.target
      }
      _ => {}
    }
    return Next<Creating>.Pass
  }

  // The directory after one effect of a row.
  fn absorb(state: &Creating, context: &mut Site, effect_: &Trail) -> () {
    match &effect_.* {
      Trail.Creates { spot } => {
        if spot == Spot.Project {
          context.target = Target.Taken
        }
      }
      Trail.Removes { spot } => {
        if spot == Spot.Project {
          context.target = context.before
        }
      }

      // The process ends, and what it kept in mind is gone.
      Trail.Exits { .. } => {
        context.kind = Kind.Default
        context.before = context.target
      }
      _ => {}
    }
    return ()
  }
}

type Laws = Rules<Start, Site, Trail>

// `event` creates no project and changes no workspace.
static fn createsNothing(
  laws: Laws,
  event: Intrinsic.VariantName<Start>,
  reason: string<'static>,
) -> Laws {
  return laws
    |> Rules.never(event, Trail.Creates { spot: Spot.Project }, reason)
    |> Rules.never(event, Trail.Changes { spot: Spot.Workspace }, reason)
}

/// The promises `silk init` keeps on every path, each with its reason.
pub static fn laws() -> Rules<Start, Site, Trail> {
  return Rules<Start, Site, Trail>.of()
    |> createsNothing("Clash", "a usage error changes nothing")
    |> createsNothing("Templates", "silk init --list only reads")
    |> Rules.always(
      "Clash",
      Trail.Exits { status: 2 },
      "words that cannot be combined are a usage error",
    )
    |> Rules.neverWhen(
      "Init",
      written,
      Trail.Fetches { source: Fetch.Template },
      "a project the compiler writes itself needs no network",
    )
    |> Rules.neverWhen(
      "Init",
      taken,
      Trail.Fetches { source: Fetch.Template },
      "a project is refused before anything is fetched",
    )
    |> Rules.neverWhen(
      "Init",
      taken,
      Trail.Creates { spot: Spot.Project },
      "a project is never overwritten",
    )
    |> Rules.neverAny(
      Trail.Changes { spot: Spot.Manifest },
      "silk init edits no project that is there",
    )
    |> Rules.neverAny(
      Trail.Changes { spot: Spot.Sources },
      "silk init edits no project that is there",
    )
}

type Shot = Snapshot<Creating, Start, Site, Trail>

/// The directories a walk starts from, and a run sets up: no directory, a directory with a
/// file, a project, and no directory below a workspace.
///
/// # Errors
/// `TransitionLoopError` as `Steps.begin` gives it. `OutOfMemoryError`.
pub effect fn starts() -> List<Shot>
  ! OutOfMemoryError | TransitionLoopError
  ? &mut Allocator {
  let mut shots = List<Shot>.make()
  run List<Shot>.append(
    &mut shots,
    run Steps.begin<Creating, Start, Site, Trail>(Site.of(Target.Absent, false), 0),
  )
  run List<Shot>.append(
    &mut shots,
    run Steps.begin<Creating, Start, Site, Trail>(Site.of(Target.Plain, false), 0),
  )
  run List<Shot>.append(
    &mut shots,
    run Steps.begin<Creating, Start, Site, Trail>(Site.of(Target.Taken, false), 0),
  )
  run List<Shot>.append(
    &mut shots,
    run Steps.begin<Creating, Start, Site, Trail>(Site.of(Target.Absent, true), 0),
  )
  return move shots
}

/// Everything a user can type and the world can answer.
///
/// # Errors
/// `OutOfMemoryError`.
pub effect fn events() -> List<Start>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut all = List<Start>.make()
  run List<Start>.append(&mut all, Start.Init { kind: Kind.Default })
  run List<Start>.append(&mut all, Start.Init { kind: Kind.Minimal })
  run List<Start>.append(&mut all, Start.Init { kind: Kind.Library })
  run List<Start>.append(&mut all, Start.Init { kind: Kind.Workspace })
  run List<Start>.append(&mut all, Start.Init { kind: Kind.Template })
  run List<Start>.append(&mut all, Start.Templates)
  run List<Start>.append(&mut all, Start.Clash)
  run List<Start>.append(&mut all, Start.Unreachable)
  run List<Start>.append(&mut all, Start.Unlisted)
  run List<Start>.append(&mut all, Start.Plain)
  run List<Start>.append(&mut all, Start.Hooked)
  run List<Start>.append(&mut all, Start.Passed)
  run List<Start>.append(&mut all, Start.Failed)
  run List<Start>.append(&mut all, Start.Listed)
  return move all
}
