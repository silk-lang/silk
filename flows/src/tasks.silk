//! The tasks of the `flows` package, run with `silk task <name>` from `flows/`.

import Bench { Bench, Binding }
import Bench as Benches
import Computer { Computer }
import Silk { Silk, Typed }
import Footprint { Footprint }
import Pages
import BuildBinding { BuildBinding }
import BuildFlow { Bay, Building, Make }
import DependencyBinding { DependencyBinding }
import DependencyFlow { Ask, Depending, Shelves }
import ProjectBinding { ProjectBinding }
import ProjectFlow { Creating, Site, Start }
import Reference
import ServerBinding { ServerBinding }
import ServerFlow { Call, Desk, Serving }
import Trail { Trail }
import Trips { Trip }
import Trips
import Plan { Route, json, planned, read, written }
import World { Outcome, Scene, World, compiler, judged, shown }
import silk.cli.command { Command, CommandLine, Opt }
import silk.cli.task { Task, TaskError, TaskSet }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.machine.definition { Definition, Definitions }
import silk.machine.snapshot { TransitionLoopError }
import silk.machine.xstate { Xstate }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.schema.issue { SchemaError }
import silk.schema.schema { Schema }
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StderrWriter, StdoutWriter }
import silk.num.usize
import silk.system.child_process { ChildProcess, ProcessError }
import silk.system.filesystem_machine { MachineFileSystem }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.system.host_input { HostInput, HostInputError }
import silk.text.format { Format }
import silk.text.string { String }

union Tasks {
  Cover { pub check: bool },
  Pages { pub check: bool },
  Trips,
  Chart { pub machine: String },
  Drive {
    pub silk: String,
    pub release: String,
    pub only: String,
    pub work: String,
    pub keep: bool,
    pub toolchain: String,
    pub clang: String
  },
}

impl CommandLine for Tasks {
  static fn command() -> Command<Tasks> {
    return Command<Tasks>.make("tasks", "The tasks of the flows package")
      |> Command.variant(
        "Cover",
        "Write flows.json, the plan of the paths a run of the real tool takes",
      )
      |> Command.option(
        "check",
        Opt.about("Change nothing, and fail when a file is not what the machine gives"),
      )
      |> Command.variant(
        "Pages",
        "Write the pages of reference/flows: what each command does, and the stories step by step",
      )
      |> Command.variant(
        "Trips",
        "Print the trips of the compiler's machines, the paths that drive takes with --toolchain, one JSON object on each line",
      )
      |> Command.variant(
        "Chart",
        "Print a machine as an xstate config in JSON, which Stately Studio draws",
      )
      |> Command.option(
        "machine",
        Opt.about(
          "The machine to print: Silk, ProjectFlow, DependencyFlow, BuildFlow or ServerFlow",
        )
          |> Opt.default("Silk"),
      )
      |> Command.variant(
        "Drive",
        "Type every command of flows.json into a real silk tool, and compare what each one leaves with its footprint",
      )
      |> Command.option(
        "silk",
        Opt.about("The silk tool to check, as a path from the directory the task was typed in"),
      )
      |> Command.option("release", Opt.about("The version of that tool") |> Opt.default("0.0.0"))
      |> Command.option("only", Opt.about("The one route to take, by its name") |> Opt.default(""))
      |> Command.option(
        "work",
        Opt.about("The directory to make the directory of the run in") |> Opt.default("/tmp"),
      )
      |> Command.option("keep", Opt.about("Keep the directory of the run when every route passed"))
      |> Command.option(
        "toolchain",
        Opt.about(
          "The toolchain to check with the tool, a directory with bin/silkc and lib/silk; without it no trip of the compiler is taken",
        )
          |> Opt.default(""),
      )
      |> Command.option(
        "clang",
        Opt.about("The Clang that toolchain uses, when it does not bring one") |> Opt.default(""),
      )
  }
}

impl TaskSet for Tasks {
  effect fn perform(self: Tasks) -> ()
    ! TaskError
    ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
    match move self {
      Tasks.Cover { check } => run Effect.catchAll(cover(check), unexpected)
      Tasks.Pages { check } => run Effect.catchAll(pages(check), unexpected)
      Tasks.Trips => run Effect.catchAll(trips(), unexpected)
      Tasks.Chart { machine } => run Effect.catchAll(
        chart(String.utf8Bytes(machine.view())),
        unexpected,
      )
      Tasks.Drive { silk, release, only, work, keep, toolchain, clang } => run Effect.catchAll(
        drive(
          String.utf8Bytes(silk.view()),
          String.utf8Bytes(release.view()),
          String.utf8Bytes(only.view()),
          String.utf8Bytes(work.view()),
          keep,
          String.utf8Bytes(toolchain.view()),
          String.utf8Bytes(clang.view()),
        ),
        unexpected,
      )
    }
  }
}

// A failure no task expects, as the error of the task.
effect fn unexpected(
  error: TaskError
    | FileError
    | HostInputError
    | OutOfMemoryError
    | TransitionLoopError
    | SchemaError
    | ProcessError
    | WriterError,
) -> ()
  ! TaskError
  ? &mut Allocator {
  let reason = match move error {
    TaskError failed => {
      fail move failed
    }
    FileError failed => {
      let mut err = StderrWriter.make()
      drop run Effect.result(Format.debug(&failed) |> Effect.provideMut<Writer>(&mut err))
      " is why a file could not be read or written"
    }
    HostInputError failed => {
      drop failed
      "the environment could not be read"
    }
    OutOfMemoryError failed => {
      drop failed
      "out of memory"
    }
    TransitionLoopError failed => {
      drop failed
      "the machine did not settle"
    }
    SchemaError failed => {
      drop failed
      "a value of the plan could not be read or written"
    }
    ProcessError failed => {
      drop failed
      "the silk tool could not be started"
    }
    WriterError failed => {
      drop failed
      "the report could not be written"
    }
  }
  match move run Effect.result(String.copy(reason)) {
    Result<String, OutOfMemoryError>.Success { value } => {
      fail TaskError { message: move value, status: 1 }
    }
    Result<String, OutOfMemoryError>.Failure { .. } => Intrinsic.trap("out of memory")
  }
}

effect fn cover(check: bool) -> ()
  ! TaskError | FileError | HostInputError | OutOfMemoryError | TransitionLoopError | SchemaError
  ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let root = run Task.root()
  let file = run Path.join(&root, "flows.json")
  let plan = run planned()
  let text = run written(&plan)
  if check {
    let now = run FileSystem.readFile(&file)
    if Bytes.asSlice(&now) != text.asSlice() {
      run Task.abort(
        "flows.json is not what the machine gives; write it again with `silk task cover`",
      )
    }
    return ()
  }
  return run FileSystem.writeFile(&file, text.asSlice())
}

// Writes the page `text` at `name` below `reference/flows`, or with `check` fails when the file
// there is another text.
effect fn page(root: &Path, name: string, text: &[u8], check: bool) -> ()
  ! TaskError | FileError | OutOfMemoryError
  ? &mut Allocator | &mut FileSystem {
  let directory = run Path.resolve(root, "../reference/flows")
  let file = run Path.join(&directory, name)
  if check {
    let now = run FileSystem.readFile(&file)
    if Bytes.asSlice(&now) != text {
      run Task.abort(
        "a page of reference/flows is not what the machine gives; write it again with `silk task pages`",
      )
    }
    return ()
  }
  run FileSystem.createDirectoriesRecursively(&directory)
  return run FileSystem.writeFile(&file, text)
}

effect fn pages(check: bool) -> ()
  ! TaskError | FileError | HostInputError | OutOfMemoryError | TransitionLoopError | SchemaError
  ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let root = run Task.root()
  let plan = run planned()
  let commands = run Pages.commands()
  run page(&root, "commands.md", commands.asSlice(), check)
  let stories = run Pages.walkthroughs(&plan)
  return run page(&root, "stories.md", stories.asSlice(), check)
}

effect fn say(text: &[u8]) -> ()
  ! WriterError {
  let mut out = StdoutWriter.make()
  return run Writer.writeAll(text) |> Effect.provideMut<Writer>(&mut out)
}

// Prints `definition` as an xstate config.
effect fn drawn(definition: &Definition) -> ()
  ! WriterError {
  let mut out = StdoutWriter.make()
  run Xstate.write(definition) |> Effect.provideMut<Writer>(&mut out)
  return run Writer.writeAll(b"\n") |> Effect.provideMut<Writer>(&mut out)
}

// Prints the machine called `machine` as an xstate config.
effect fn chart(machine: &[u8]) -> ()
  ! TaskError | OutOfMemoryError | WriterError
  ? &mut Allocator {
  if machine == b"Silk" {
    return run drawn(&run Definitions.of<Silk, Typed, Computer, Footprint>())
  }
  if machine == b"ProjectFlow" {
    return run drawn(&run Definitions.of<Creating, Start, Site, Trail>())
  }
  if machine == b"DependencyFlow" {
    return run drawn(&run Definitions.of<Depending, Ask, Shelves, Trail>())
  }
  if machine == b"BuildFlow" {
    return run drawn(&run Definitions.of<Building, Make, Bay, Trail>())
  }
  if machine == b"ServerFlow" {
    return run drawn(&run Definitions.of<Serving, Call, Desk, Trail>())
  }
  run Task.abort("--machine is one of Silk, ProjectFlow, DependencyFlow, BuildFlow and ServerFlow")
}

effect fn trips() -> ()
  ! OutOfMemoryError | TransitionLoopError | SchemaError | WriterError
  ? &mut Allocator {
  run say(
    (run Trips.written<Start, Site, Trail>((run Reference.projectTrips()).asSlice())).asSlice(),
  )
  run say(
    (run Trips.written<Ask, Shelves, Trail>((run Reference.dependencyTrips()).asSlice())).asSlice(),
  )
  run say((run Trips.written<Make, Bay, Trail>((run Reference.buildTrips()).asSlice())).asSlice())
  return run say(
    (run Trips.written<Call, Desk, Trail>((run Reference.serverTrips()).asSlice())).asSlice(),
  )
}

// The path `text` names: an absolute one, or one from `base`.
effect fn located(base: &Path, text: &[u8]) -> Path
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  if text.length != 0 && text[0] == 47 {
    return run Path.fromBytes(text)
  }
  return run Path.resolveBytes(base, text)
}

effect fn appendNumber(text: &mut Bytes, number: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if number >= 10 {
    run appendNumber(&mut text.*, number / 10)
  }
  let digit: [u8; 1] = [usize.toU8(number % 10) + 48]
  return run Bytes.append(&mut text.*, &digit)
}

// Whether the disk of `scene` shows the computer `expected`. When it does not, `wrong` gets a line.
effect fn shows(
  scene: &Scene,
  world: &World,
  expected: &Computer,
  when: &[u8],
  wrong: &mut List<Bytes>,
) -> ()
  ! FileError | OutOfMemoryError | SchemaError
  ? &mut FileSystem | &mut Allocator {
  let seen = run json<Computer>(&shown(&run scene.observed(world)))
  let said = run json<Computer>(&shown(expected))
  if seen.asSlice() != said.asSlice() {
    let mut line = run Bytes.copy(when)
    run Bytes.append(&mut line, b" the machine says the computer is ")
    run Bytes.append(&mut line, said.asSlice())
    run Bytes.append(&mut line, b" and the disk shows ")
    run Bytes.append(&mut line, seen.asSlice())
    run List<Bytes>.append(&mut wrong.*, move line)
  }
  return ()
}

// Takes `route` on a real tool. It gives what went wrong, with the command it went wrong at, or
// nothing.
effect fn taken(world: &World, route: &Route) -> List<Bytes>
  ! FileError | OutOfMemoryError | TransitionLoopError | SchemaError | ProcessError
  ? &mut Allocator | &mut ChildProcess | &mut FileSystem {
  let mut scene = run world.arrange(String.utf8Bytes(route.name.view()), &route.start)
  let moves = route.moves.asSlice()
  let mut at: usize = 0
  while at < moves.length {
    let before = if at == 0 {
      &route.start
    } else {
      &moves[at - 1].state
    }
    let words = run scene.prepare(world, before, &moves[at])
    let mut wrong = List<Bytes>.make()
    if at == 0 {
      run shows(&scene, world, before, b"before the first command", &mut wrong)
    }
    let mut ended = Option<Outcome>.none()
    if wrong.length() == 0 {
      let first = run scene.pictured()
      let outcome = run scene.typed(world, words.asSlice())
      let second = run scene.pictured()
      let differences = run first.differences(&second)
      let ran = run scene.ran()
      wrong = run judged(&moves[at], &outcome, differences.asSlice(), ran.asSlice())
      run shows(&scene, world, &moves[at].state, b"after the command", &mut wrong)
      ended = Option<Outcome>.some(move outcome)
    }
    if wrong.length() != 0 {
      let mut report = List<Bytes>.make()
      let mut line = run Bytes.copy(b"silk")
      let typed = words.asSlice()
      let mut word: usize = 0
      while word < typed.length {
        run Bytes.append(&mut line, b" ")
        run Bytes.append(&mut line, typed[word].asSlice())
        word = word + 1
      }
      run List<Bytes>.append(&mut report, move line)
      while wrong.length() != 0 {
        run List<Bytes>.append(&mut report, List<Bytes>.remove(&mut wrong, 0))
      }
      if let Option<Outcome>.Some { value } = &ended {
        let mut heard = run Bytes.copy(b"standard output: ")
        run Bytes.append(&mut heard, value.output.asSlice())
        run List<Bytes>.append(&mut report, move heard)
        heard = run Bytes.copy(b"standard error: ")
        run Bytes.append(&mut heard, value.errors.asSlice())
        run List<Bytes>.append(&mut report, move heard)
      }
      return move report
    }
    at = at + 1
  }
  return List<Bytes>.make()
}

// How many trips passed and failed.
struct Tally {
  passed: usize,
  failed: usize,
}

// Takes each of `trips` on the toolchain of `bench`, or only the one named `only`, and says what
// went wrong.
effect fn driven<B: Binding<E, C>, E: Schema, C: Schema>(
  binding: &B,
  bench: &Bench,
  trips: &[Trip<E, C, Trail>],
  only: &[u8],
  tally: &mut Tally,
) -> ()
  ! FileError | OutOfMemoryError | SchemaError | ProcessError | WriterError
  ? &mut Allocator | &mut ChildProcess | &mut FileSystem {
  let mut at: usize = 0
  while at < trips.length {
    let trip = &trips[at]
    at = at + 1
    let name = String.utf8Bytes(trip.name.view())
    if only.length != 0 && name != only {
      continue
    }
    let mut wrong = run Benches.taken<B, E, C>(binding, bench, trip)
    if wrong.length() == 0 {
      tally.passed = tally.passed + 1
      continue
    }
    tally.failed = tally.failed + 1
    let mut report = run Bytes.copy(name)
    run Bytes.append(&mut report, b": ")
    let mut first = true
    while wrong.length() != 0 {
      if !first {
        run Bytes.append(&mut report, b"  ")
      }
      first = false
      run Bytes.append(&mut report, List<Bytes>.remove(&mut wrong, 0).asSlice())
      run Bytes.append(&mut report, b"\n")
    }
    run say(report.asSlice())
  }
  return ()
}

effect fn drive(
  silk: &[u8],
  release: &[u8],
  only: &[u8],
  work: &[u8],
  keep: bool,
  toolchain: &[u8],
  clang: &[u8],
) -> ()
  ! TaskError
    | FileError
    | HostInputError
    | OutOfMemoryError
    | TransitionLoopError
    | SchemaError
    | ProcessError
    | WriterError
  ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
  if silk.length == 0 {
    run Task.abort("name the silk tool to check with --silk <path>")
  }
  let root = run Task.root()
  let tool = run FileSystem.readFile(&run located(&run Task.invocationDirectory(), silk))
  let all = run HostInput.arguments()
  let standin = run FileSystem.readFile(&run located(&root, all.asSlice()[0].asSlice()))
  let directory = run FileSystem.createTemporaryDirectory(&run Path.fromBytes(work), b"flows")
  let world = run World.made(&directory, tool.asSlice(), standin.asSlice(), release)
  let text = run FileSystem.readFile(&run Path.join(&root, "flows.json"))
  let plan = run read(text.asSlice())
  let routes = plan.routes.asSlice()
  let mut passed: usize = 0
  let mut failed: usize = 0
  let mut lacks = List<&'static [u8]>.make()
  let mut counts = List<usize>.make()
  let mut at: usize = 0
  while at < routes.length {
    let route = &routes[at]
    at = at + 1
    if only.length != 0 && String.utf8Bytes(route.name.view()) != only {
      continue
    }
    let lack = run world.lacks(&route.start, route.moves.asSlice())
    if lack.length != 0 {
      let known = lacks.asSlice()
      let mut which: usize = 0
      while which < known.length && known[which] != lack {
        which = which + 1
      }
      if which == known.length {
        run List<&'static [u8]>.append(&mut lacks, lack)
        run List<usize>.append(&mut counts, 0)
      }
      let mut slots = List<usize>.asMutSlice(&mut counts)
      slots[which] = slots[which] + 1
      continue
    }
    let mut wrong = run taken(&world, route)
    if wrong.length() == 0 {
      passed = passed + 1
      continue
    }
    failed = failed + 1
    let mut report = run Bytes.copy(String.utf8Bytes(route.name.view()))
    run Bytes.append(&mut report, b": ")
    let mut first = true
    while wrong.length() != 0 {
      if !first {
        run Bytes.append(&mut report, b"  ")
      }
      first = false
      run Bytes.append(&mut report, List<Bytes>.remove(&mut wrong, 0).asSlice())
      run Bytes.append(&mut report, b"\n")
    }
    run say(report.asSlice())
  }
  let mut summary = Bytes.make()
  run appendNumber(&mut summary, passed)
  run Bytes.append(&mut summary, b" routes passed, ")
  run appendNumber(&mut summary, failed)
  run Bytes.append(&mut summary, b" failed\n")
  let project = run Reference.projectTrips()
  let dependency = run Reference.dependencyTrips()
  let build = run Reference.buildTrips()
  let server = run Reference.serverTrips()
  if toolchain.length == 0 {
    run appendNumber(
      &mut summary,
      project.length() + dependency.length() + build.length() + server.length(),
    )
    run Bytes.append(
      &mut summary,
      b" trips of the compiler not taken: no toolchain was named with --toolchain\n",
    )
  } else {
    let programs = match move run HostInput.variableNamed("PATH") {
      Option<Bytes>.Some { value } => move value
      Option<Bytes>.None => run Bytes.copy(b"/usr/bin:/bin")
    }
    let bench = run Bench.made(
      &run Path.join(&directory, "bench"),
      tool.asSlice(),
      &run located(&run Task.invocationDirectory(), toolchain),
      release,
      clang,
      programs.asSlice(),
    )
    let mut tally = Tally { passed: 0, failed: 0 }
    run driven<ProjectBinding, Start, Site>(
      &ProjectBinding {},
      &bench,
      project.asSlice(),
      only,
      &mut tally,
    )
    run driven<DependencyBinding, Ask, Shelves>(
      &DependencyBinding {},
      &bench,
      dependency.asSlice(),
      only,
      &mut tally,
    )
    run driven<BuildBinding, Make, Bay>(&BuildBinding {}, &bench, build.asSlice(), only, &mut tally)
    run driven<ServerBinding, Call, Desk>(
      &ServerBinding {},
      &bench,
      server.asSlice(),
      only,
      &mut tally,
    )
    run appendNumber(&mut summary, tally.passed)
    run Bytes.append(&mut summary, b" trips of the compiler passed, ")
    run appendNumber(&mut summary, tally.failed)
    run Bytes.append(&mut summary, b" failed\n")
    failed = failed + tally.failed
  }
  let reasons = lacks.asSlice()
  let mut which: usize = 0
  while which < reasons.length {
    run appendNumber(&mut summary, counts.asSlice()[which])
    run Bytes.append(&mut summary, b" routes not taken: the local world lacks ")
    run Bytes.append(&mut summary, reasons[which])
    run Bytes.append(&mut summary, b"\n")
    which = which + 1
  }
  if failed != 0 || keep {
    run Bytes.append(&mut summary, b"The directory of the run is ")
    run Bytes.append(&mut summary, Path.rawBytes(&directory))
    run Bytes.append(&mut summary, b"\n")
  } else {
    run FileSystem.removeDirectoryRecursively(&directory)
  }
  run say(summary.asSlice())
  if failed != 0 {
    run Task.abort("the tool left something its footprint does not list, see above")
  }
  return ()
}

// Plays the compiler when the program is named `silkc`, which is how a scene of a run names it.
effect fn standin() -> Option<i32>
  ! HostInputError | FileError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator {
  let all = run HostInput.arguments()
  let listed = all.asSlice()
  if listed.length == 0 {
    return Option<i32>.none()
  }
  let name = listed[0].asSlice()
  if name.length < 6 || Slice.view<u8>(name, name.length - 6, 6) != b"/silkc" {
    return Option<i32>.none()
  }
  let mut files = run MachineFileSystem.make()
  let mut output = Bytes.make()
  let status = run compiler(listed, &mut output) |> Effect.provideMut<FileSystem>(&mut files)
  run say(output.asSlice())
  return Option<i32>.some(status)
}

pub effect fn main() -> i32
  ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let played = run Effect.result(standin()) |> Effect.provideMut<Allocator>(&mut allocator)
  match move played {
    Result<Option<i32>, HostInputError | FileError | OutOfMemoryError | WriterError>.Success {
      value
    } => {
      if let Option<i32>.Some { value: status } = move value {
        return status
      }
    }
    Result<Option<i32>, HostInputError | FileError | OutOfMemoryError | WriterError>.Failure {
      error
    } => {
      drop error
      return 97
    }
  }
  return run Task.main<Tasks>()
}
