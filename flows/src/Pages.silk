//! Pages for people, made from the machine: [`commands`] and [`walkthroughs`].
//!
//! [`commands`] is one table for each command of the `silk` tool, with a row for each row of
//! the chart in `Silk`: when it applies, what the tool then does, the exit status, and what
//! comes next. [`walkthroughs`] tells each story of `Stories` step by step, with what every
//! command leaves. Both are Markdown, and both are checked in below `reference/flows`.
//!
//! The words of a guard and of a refusal come from the chart. This module adds one phrase for
//! each event, state, message and place, and nothing about what a command does.

import Computer { Computer }
import Footprint { Footprint }
import Laws
import Plan { Kind, Plan }
import Silk { Silk, Typed }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.machine.definition { Definitions, StateDefinition, Values }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.usize
import silk.text.string { String }

fn startsWith(text: &[u8], prefix: &[u8]) -> bool {
  return text.length >= prefix.length && Slice.view<u8>(text, 0, prefix.length) == prefix
}

// The position of `part` in `text`, or the length of `text`.
fn position(text: &[u8], part: &[u8]) -> usize {
  let mut at: usize = 0
  while at + part.length <= text.length {
    if Slice.view<u8>(text, at, part.length) == part {
      return at
    }
    at = at + 1
  }
  return text.length
}

// The last name of `text`: what follows its last `.`.
fn named(text: &[u8]) -> &[u8] {
  let mut start = text.length
  while start > 0 && text[start - 1] != 46 {
    start = start - 1
  }
  return Slice.view<u8>(text, start, text.length - start)
}

// The first word of `text`: the name of a variant as a program writes its value.
fn word(text: &[u8]) -> &[u8] {
  let mut end: usize = 0
  while end < text.length && text[end] != 32 {
    end = end + 1
  }
  return Slice.view<u8>(text, 0, end)
}

// The value of the one field of a variant as a program writes it: `Listing` in
// `Downloads { asset: Listing }`.
fn field(text: &[u8]) -> &[u8] {
  let start = position(text, b": ")
  let end = position(text, b" }")
  if start >= end {
    return Slice.view<u8>(text, 0, 0)
  }
  return Slice.view<u8>(text, start + 2, end - start - 2)
}

// A command as a heading names it.
fn heading(event: &[u8]) -> &'static [u8] {
  if event == b"Misuse" { return b"Words that are no command" }
  if event == b"Use" { return b"`silk use <version>`" }
  if event == b"UseNewest" { return b"`silk use latest` and `silk use dev`" }
  if event == b"UsePinned" { return b"`silk use`" }
  if event == b"List" { return b"`silk use list`" }
  if event == b"Which" { return b"`silk use which`" }
  if event == b"Uninstall" { return b"`silk use uninstall <version>`" }
  if event == b"Set" { return b"`silk set <version>`" }
  if event == b"SetNewest" { return b"`silk set latest` and `silk set dev`" }
  if event == b"UpdateSelf" { return b"`silk update self`" }
  if event == b"Run" { return b"A command for the compiler, such as `silk build`" }
  if event == b"Help" { return b"`silk --help`, and `silk` alone" }
  if event == b"Near" { return b"A word one edit away from a command of the tool, such as `uze`" }
  return b""
}

// An answer of the world as a sentence says it.
fn answer(event: &[u8]) -> &'static [u8] {
  if event == b"Found" { return b"the release source lists the version" }
  if event == b"Missing" { return b"the release source does not list the version" }
  if event == b"Newest" { return b"the release source names the newest release" }
  if event == b"NoStable" { return b"releases are published, and none is stable" }
  if event == b"NoReleases" { return b"the release source lists no release" }
  if event == b"Unreachable" { return b"the release source does not answer" }
  if event == b"Edited" { return b"the manifests can be edited" }
  if event == b"Refused" { return b"a manifest cannot be edited" }
  if event == b"Arrived" { return b"the archive and its signature arrive" }
  if event == b"Cut" { return b"the download stops" }
  if event == b"Genuine" { return b"the release key signed the archive for this release" }
  if event == b"Forged" { return b"the signature is missing, wrong, or of another release" }
  if event == b"Placed" { return b"the toolchain is in its directory" }
  if event == b"Corrupt" { return b"the archive is not a release of Silk" }
  if event == b"Blocked" { return b"a file cannot be written or moved, or the release source lacks a file" }
  if event == b"Started" { return b"the compiler runs in place of the tool" }
  if event == b"Stuck" { return b"the compiler does not start" }
  if event == b"Outdated" { return b"a newer tool is published" }
  if event == b"Current" { return b"the tool is the newest release" }
  if event == b"Replaced" { return b"the new tool is in place" }
  if event == b"Told" { return b"the compiler gives its overview" }
  if event == b"Silent" { return b"the compiler gives no overview" }
  if event == b"Owned" { return b"the compiler lists the word, or a word one edit away" }
  if event == b"Unowned" { return b"the compiler does not list the word" }
  return b""
}

// What follows an answer after which the tool itself does nothing more.
fn handing(event: &[u8]) -> &'static [u8] {
  if event == b"Started" { return b"Nothing more: the compiler does the command, and its exit status is the command's" }
  if event == b"Owned" { return b"Hands the word to the compiler, whose exit status is the command's" }
  return b""
}

// What the tool does in a state, after `the tool `.
fn doing(state: &[u8]) -> &'static [u8] {
  if state == b"Resolving" { return b"asks the release source whether the version is published" }
  if state == b"Choosing" { return b"asks the release source for the newest release" }
  if state == b"Editing" { return b"works out the new text of the project's manifests" }
  if state == b"Downloading" { return b"waits for the archive and its signature" }
  if state == b"Verifying" { return b"checks the signature of the archive" }
  if state == b"Unpacking" { return b"unpacks the archive and moves the toolchain into place" }
  if state == b"Ready" { return b"finishes, now that the version is in place" }
  if state == b"Starting" { return b"becomes the compiler" }
  if state == b"Checking" { return b"asks the release source for a newer tool" }
  if state == b"Replacing" { return b"replaces its own program" }
  if state == b"Asking" { return b"asks the selected compiler for its overview" }
  if state == b"Comparing" { return b"asks the selected compiler whether the word is one of its commands" }
  return b""
}

// What the tool says for a message.
fn saying(message: &[u8]) -> &'static [u8] {
  if message == b"Usage" { return b"says that the words are not a command, with the way to the help" }
  if message == b"UnknownCommand" { return b"says that the word is no command, with the command it is one edit away from" }
  if message == b"NoHome" { return b"says that no home directory is known" }
  if message == b"BadEnvironment" { return b"says that `SILK_TOOLCHAIN` is not a version" }
  if message == b"BadRequest" { return b"says that the `+<version>` argument is not a version" }
  if message == b"UnknownPin" { return b"says that the pin of the project cannot be read as one version" }
  if message == b"Versions" { return b"prints the installed versions" }
  if message == b"Selected" { return b"prints the selected version, and why it is selected" }
  if message == b"NothingSelected" { return b"says that nothing selects a version here, with the command that installs one" }
  if message == b"NotInstalled" { return b"says that the selected version is not installed, with the command that installs it" }
  if message == b"IgnoredPin" { return b"notes that the member's own pin is passed over, because the pin of its workspace wins" }
  if message == b"NothingToRemove" { return b"prints that the version is not installed, so nothing is removed" }
  if message == b"Removed" { return b"prints that the version was removed" }
  if message == b"WasDefault" { return b"notes that the removed version was the default" }
  if message == b"PinnedHere" { return b"notes that the project pins the removed version" }
  if message == b"NoPin" { return b"says that `silk use` without a version needs a project that pins one" }
  if message == b"Installing" { return b"says that it installs the selected version first" }
  if message == b"Installed" { return b"prints that the version was installed" }
  if message == b"AlreadyInstalled" { return b"prints that the version is already installed" }
  if message == b"DefaultSet" { return b"prints the new default version" }
  if message == b"StillPins" { return b"notes that the project still pins another version" }
  if message == b"NoProject" { return b"says that there is no `silk.toml` here or above" }
  if message == b"CannotEdit" { return b"says why the manifest cannot be edited" }
  if message == b"Pinned" { return b"prints where the project is pinned" }
  if message == b"MembersUnpinned" { return b"prints the members whose own pins were removed" }
  if message == b"NotInstalledYet" { return b"notes that the pinned version is not installed yet" }
  if message == b"OlderThanTool" { return b"notes that the pinned version is older than the tool" }
  if message == b"NotPublished" { return b"says that no published release is the version" }
  if message == b"NoStable" { return b"says that no stable release is published yet" }
  if message == b"NoReleases" { return b"says that the release listing names no release" }
  if message == b"Unreachable" { return b"says that the release source did not answer" }
  if message == b"DownloadFailed" { return b"says that the download did not arrive whole" }
  if message == b"Forged" { return b"says that the release key did not sign the archive for this release" }
  if message == b"Corrupt" { return b"says that the archive is not a release of Silk" }
  if message == b"Blocked" { return b"says which step could not be done" }
  if message == b"CannotRun" { return b"says that the compiler does not start" }
  if message == b"UpToDate" { return b"prints that the tool is the newest release" }
  if message == b"Updated" { return b"prints that the tool was updated" }
  if message == b"Overview" { return b"prints the overview of the commands of the selected compiler" }
  if message == b"HelpFailed" { return b"says that the selected compiler gave no overview" }
  if message == b"OwnCommands" { return b"prints the commands of the tool itself" }
  return b""
}

// What one effect is, as a program writes it, in words. An exit status gives empty text.
fn leaving(effect_: &[u8]) -> &'static [u8] {
  let kind = word(effect_)
  let value = field(effect_)
  if kind == b"Says" {
    return saying(value)
  }
  if kind == b"Downloads" {
    if value == b"Listing" { return b"asks the release source for the list of releases" }
    if value == b"Archive" { return b"downloads the archive of the release" }
    return b"downloads the signature of the archive"
  }
  if kind == b"Creates" {
    if value == b"Toolchain" { return b"puts the version in its directory" }
    return b"makes a hidden directory to unpack the download in"
  }
  if kind == b"Removes" {
    if value == b"Toolchain" { return b"removes the directory of the version" }
    return b"removes the hidden directory of the download"
  }
  if kind == b"Changes" {
    if value == b"Settings" { return b"makes the version the default" }
    if value == b"Manifest" { return b"writes the pin to the manifest of the project" }
    if value == b"Members" { return b"removes the members' own pins" }
    return b"replaces the tool with the new one"
  }
  if kind == b"Runs" {
    if value == b"Bundled" { return b"runs the compiler beside the tool" }
    return b"runs the compiler of the selected version"
  }
  return b""
}

// The words a user types for a command, as a program writes the event.
fn typing(event: &[u8]) -> &'static [u8] {
  let kind = word(event)
  if kind == b"Misuse" { return b"silk use --no-such-option" }
  if kind == b"Use" { return b"silk use <version>" }
  if kind == b"UseNewest" { return b"silk use latest" }
  if kind == b"UsePinned" { return b"silk use" }
  if kind == b"List" { return b"silk use list" }
  if kind == b"Which" { return b"silk use which" }
  if kind == b"Uninstall" { return b"silk use uninstall <version>" }
  if kind == b"Set" {
    if position(event, b"install: false") < event.length { return b"silk set <version> --no-install" }
    return b"silk set <version>"
  }
  if kind == b"SetNewest" {
    if position(event, b"install: false") < event.length { return b"silk set latest --no-install" }
    return b"silk set latest"
  }
  if kind == b"UpdateSelf" { return b"silk update self" }
  if kind == b"Run" {
    if position(event, b"Unset") < event.length { return b"silk build" }
    return b"silk +<another version> build"
  }
  if kind == b"Help" {
    if position(event, b"true") < event.length { return b"silk" }
    return b"silk --help"
  }
  return b"silk uze"
}

effect fn add(page: &mut Bytes, parts: &[&[u8]]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut at: usize = 0
  while at < parts.length {
    run Bytes.append(&mut page.*, parts[at])
    at = at + 1
  }
  return ()
}

// `words`, or when a table of this module has no phrase for the name `raw`, text that says so.
// A test fails on a page with that text, so a new event, message or place needs its phrase.
effect fn phrased(words: &'static [u8], raw: &[u8]) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  if words.length != 0 {
    return run Bytes.copy(words)
  }
  let mut text = run Bytes.copy(b"a thing with no phrase in Pages.silk: ")
  run Bytes.append(&mut text, raw)
  return move text
}

// Adds `words` with a capital first letter.
effect fn capital(page: &mut Bytes, words: &[u8]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let first: [u8; 1] = [words[0] - 32]
  run Bytes.append(&mut page.*, Slice.view<u8>(&first, 0, 1))
  return run Bytes.append(&mut page.*, Slice.view<u8>(words, 1, words.length - 1))
}

// The cells of a row that say what the tool does, and its exit status: ` then | exit |`.
effect fn done(page: &mut Bytes, refused: &[u8], leaves: &[String]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut first = true
  if refused.length != 0 {
    run add(&mut page.*, &[b"Refuses the command, because ", refused, b"."])
    first = false
  }
  let mut exits = Bytes.make()
  let mut at: usize = 0
  while at < leaves.length {
    let whole = String.utf8Bytes(leaves[at].view())
    let split = position(whole, b" when ")
    let effect_ = Slice.view<u8>(whole, 0, split)
    let guard = if split < whole.length { Slice.view<u8>(whole, split + 6, whole.length - split - 6) } else { Slice.view<u8>(whole, 0, 0) }
    if word(effect_) == b"Exits" {
      if exits.length() != 0 {
        run Bytes.append(&mut exits, b", ")
      }
      run Bytes.append(&mut exits, field(effect_))
      if guard.length != 0 {
        run add(&mut exits, &[b" when ", guard])
      }
    } else {
      if !first {
        run Bytes.append(&mut page.*, b"<br>")
      }
      first = false
      run capital(&mut page.*, (run phrased(leaving(effect_), effect_)).asSlice())
      if guard.length != 0 {
        run add(&mut page.*, &[b", when ", guard])
      }
    }
    at = at + 1
  }
  return run add(&mut page.*, &[b" | ", exits.asSlice(), b" | "])
}

// The last cell of a row: what comes after it.
effect fn next(page: &mut Bytes, target: &[u8]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let state = named(target)
  if doing(state).length != 0 {
    run add(&mut page.*, &[b"The tool ", doing(state), b"."])
  }
  return run Bytes.append(&mut page.*, b" |\n")
}

// The reasons of the laws about `event`, as a list.
effect fn lawful(page: &mut Bytes, event: string) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut reasons = List<string<'static>>.make()
  static for rule in Laws.laws().items {
    if rule.event == event {
      let known = reasons.asSlice()
      let mut seen = false
      let mut at: usize = 0
      while at < known.length {
        if known[at] == rule.reason {
          seen = true
        }
        at = at + 1
      }
      if !seen {
        run List<string<'static>>.append(&mut reasons, rule.reason)
      }
    }
  }
  if reasons.length() == 0 {
    return ()
  }
  run Bytes.append(&mut page.*, b"\nOn every path:\n\n")
  let all = reasons.asSlice()
  let mut at: usize = 0
  while at < all.length {
    run add(&mut page.*, &[b"- ", String.utf8Bytes(all[at]), b"\n"])
    at = at + 1
  }
  return ()
}

// The state `name` of `states`.
fn stateNamed(states: &[StateDefinition], name: &[u8]) -> usize {
  let mut at: usize = 0
  while at < states.length {
    if named(String.utf8Bytes(states[at].name.view())) == name {
      return at
    }
    at = at + 1
  }
  return at
}

/// The page of the commands: for each command of the tool a table of the rows that take it,
/// then for each state that waits a table of the rows that take an answer of the world.
///
/// # Errors
/// `OutOfMemoryError`.
pub effect fn commands() -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let definition = run Definitions.of<Silk, Typed, Computer, Footprint>()
  let states = definition.charts.asSlice()[0].states.asSlice()
  let mut page = run Bytes.copy(
    b"# What each `silk` command does\n\nThis page is made from the machine that the `silk` tool runs, in `flows/src/Silk.silk`. Do not edit it: change the machine, and write the page again with `silk task pages` in `flows/`.\n\nA table has one row for each situation, and the first row that applies decides. A command that needs the network or a compiler goes on in a later table, which the last column names.\n",
  )

  // The commands, in the order the idle state lists them.
  let idle = &states[stateNamed(states, b"Idle")]
  let rows = idle.on.asSlice()
  let mut at: usize = 0
  while at < rows.length {
    let event = String.utf8Bytes(rows[at].event.view())
    let mut earlier = false
    let mut before: usize = 0
    while before < at {
      if String.utf8Bytes(rows[before].event.view()) == event {
        earlier = true
      }
      before = before + 1
    }
    if !earlier {
      run add(&mut page, &[b"\n## ", (run phrased(heading(event), event)).asSlice(), b"\n\n| When | Then the tool | Exit status | Next |\n|---|---|---|---|\n"])
      let mut each = at
      while each < rows.length {
        let row = &rows[each]
        if String.utf8Bytes(row.event.view()) == event {
          let guard = String.utf8Bytes(row.guard.view())
          let other: &[u8] = if each == at { b"always" } else { b"in every other case" }
          run add(&mut page, &[b"| ", if guard.length != 0 { guard } else { other }, b" | "])
          run done(&mut page, String.utf8Bytes(row.refused.view()), row.leaves.asSlice())
          run next(&mut page, String.utf8Bytes(row.target.view()))
        }
        each = each + 1
      }
      run lawful(&mut page, rows[at].event.view())
    }
    at = at + 1
  }

  // The states that wait, and the one that finishes.
  at = 0
  while at < states.length {
    let state = &states[at]
    let name = named(String.utf8Bytes(state.name.view()))
    if doing(name).length != 0 && state.on.length() != 0 {
      run add(&mut page, &[b"\n## When the tool ", doing(name), b"\n\n| The world answers | and | Then the tool | Exit status | Next |\n|---|---|---|---|---|\n"])
      let answers = state.on.asSlice()
      let mut each: usize = 0
      while each < answers.length {
        let row = &answers[each]
        run add(&mut page, &[b"| ", (run phrased(answer(String.utf8Bytes(row.event.view())), String.utf8Bytes(row.event.view()))).asSlice(), b" | ", String.utf8Bytes(row.guard.view()), b" | ", handing(String.utf8Bytes(row.event.view()))])
        run done(&mut page, String.utf8Bytes(row.refused.view()), row.leaves.asSlice())
        run next(&mut page, String.utf8Bytes(row.target.view()))
        each = each + 1
      }
    }
    if state.always.length() != 0 {
      run add(&mut page, &[b"\n## When the tool ", doing(name), b"\n\n| When | Then the tool | Exit status | Next |\n|---|---|---|---|\n"])
      let finishes = state.always.asSlice()
      let mut each: usize = 0
      while each < finishes.length {
        let row = &finishes[each]
        run add(&mut page, &[b"| ", String.utf8Bytes(row.guard.view()), b" | "])
        run done(&mut page, b"", row.leaves.asSlice())
        run next(&mut page, String.utf8Bytes(row.target.view()))
        each = each + 1
      }
    }
    at = at + 1
  }
  return move page
}

/// The page of the walkthroughs: each story of `plan`, command by command, with the answers
/// of the world and everything the command leaves.
///
/// # Errors
/// `OutOfMemoryError`.
pub effect fn walkthroughs(plan: &Plan) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut page = run Bytes.copy(
    b"# Walkthroughs of the `silk` tool\n\nThis page is made from the stories in `flows/src/Stories.silk` and the machine that the `silk` tool runs. Do not edit it: change the story or the machine, and write the page again with `silk task pages` in `flows/`.\n\nEach step is one command. Under it is what the world answers while the command runs, and then everything the command leaves, in order. A command leaves nothing else.\n",
  )
  let routes = plan.routes.asSlice()
  let mut at: usize = 0
  while at < routes.length {
    let route = &routes[at]
    at = at + 1
    if route.kind != Kind.Story {
      continue
    }
    run add(&mut page, &[b"\n## ", String.utf8Bytes(route.name.view()), b"\n\n", String.utf8Bytes(route.about.view()), b"\n"])
    let moves = route.moves.asSlice()
    let mut each: usize = 0
    while each < moves.length {
      let step = &moves[each]
      let mut text = String.make()
      run Values.write<Typed>(&step.command, &mut text)
      run add(&mut page, &[b"\n### `", typing(String.utf8Bytes(text.view())), b"`\n\n"])
      let answers = step.answers.asSlice()
      let mut which: usize = 0
      while which < answers.length {
        let mut said = String.make()
        run Values.write<Typed>(&answers[which], &mut said)
        if which != 0 {
          run Bytes.append(&mut page, b" ")
        }
        run capital(&mut page, (run phrased(answer(word(String.utf8Bytes(said.view()))), String.utf8Bytes(said.view()))).asSlice())
        run Bytes.append(&mut page, b".")
        which = which + 1
      }
      if answers.length != 0 {
        run Bytes.append(&mut page, b"\n\n")
      }
      let footprint = step.footprint.asSlice()
      which = 0
      while which < footprint.length {
        let mut left = String.make()
        run Values.write<Footprint>(&footprint[which], &mut left)
        let effect_ = String.utf8Bytes(left.view())
        if word(effect_) == b"Exits" {
          run add(&mut page, &[b"- Ends with exit status ", field(effect_), b".\n"])
        } else {
          run Bytes.append(&mut page, b"- ")
          run capital(&mut page, (run phrased(leaving(effect_), effect_)).asSlice())
          run Bytes.append(&mut page, b".\n")
        }
        which = which + 1
      }
      each = each + 1
    }
  }
  return move page
}
