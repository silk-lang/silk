//! The binding of the machine of `silk init`, `ProjectFlow`, to the local world: how its
//! commands are typed, how the answers of the world are arranged, and what context a disk shows.
//!
//! The project of a trip is the directory `new` below the work directory, and a workspace
//! around it is a `silk.toml` in the work directory itself.

import Bench { Bench, Binding, Stage }
import ProjectFlow { Kind, Site, Start, Target }
import World { Outcome }
import Trail { Spot, Trail }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.usize
import silk.system.child_process { ChildProcess, ProcessError }
import silk.system.filesystem { FileError, FileSystem, Path }

/// The binding of `ProjectFlow`. It has no fields, because a stage holds everything of a trip.
pub struct ProjectBinding {}

fn holds(text: &[u8], part: &[u8]) -> bool {
  let mut at: usize = 0
  while at + part.length <= text.length {
    if Slice.view<u8>(text, at, part.length) == part {
      return true
    }
    at = at + 1
  }
  return false
}

effect fn word(words: &mut List<Bytes>, text: &[u8]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  return run List<Bytes>.append(&mut words.*, run Bytes.copy(text))
}

// What the world answers after the fetch: 0 the host is unreachable, 1 the template is not
// listed, 2 a template without entries, 3 entries that pass, 4 an entry that fails.
fn answered(answers: &[Start]) -> usize {
  let mut answer: usize = 2
  let mut at: usize = 0
  while at < answers.length {
    match &answers[at] {
      Start.Unreachable => {
        answer = 0
      }
      Start.Unlisted => {
        answer = 1
      }
      Start.Plain => {
        answer = 2
      }
      Start.Passed => {
        answer = 3
      }
      Start.Failed => {
        answer = 4
      }
      _ => {}
    }
    at = at + 1
  }
  return answer
}

impl Binding<Start, Site> for ProjectBinding {
  /// Makes the directory `new` hold what `start.target` says, and writes the manifest of a
  /// workspace into the work directory when `start.around` is true.
  effect fn arrange(self: &Self, stage: &mut Stage, bench: &Bench, start: &Site) -> ()
    ! FileError | ProcessError | OutOfMemoryError
    ? &mut FileSystem | &mut ChildProcess | &mut Allocator {
    let project = run Path.join(&stage.work, "new")
    if start.target != Target.Absent {
      run FileSystem.createDirectoriesRecursively(&project)
      run FileSystem.writeFile(&run Path.join(&project, "notes.txt"), b"what was here before\n")
    }
    if start.target == Target.Taken {
      run FileSystem.writeFile(
        &run Path.join(&project, "silk.toml"),
        b"[package]\nname = \"earlier\"\nversion = \"0.1.0\"\n",
      )
    }
    if start.around {
      run FileSystem.writeFile(
        &run Path.join(&stage.work, "silk.toml"),
        b"[workspace]\nmembers = []\n",
      )
    }
    return ()
  }

  /// The words of `silk init` for `command`. It first points git at the host of the bench that
  /// gives `answers`: one that is not there, one without the template, or one whose template
  /// has no entries, entries that pass, or an entry that fails.
  effect fn act(
    self: &Self,
    stage: &mut Stage,
    bench: &Bench,
    command: &Start,
    answers: &[Start],
  ) -> List<Bytes>
    ! FileError | ProcessError | OutOfMemoryError
    ? &mut FileSystem | &mut ChildProcess | &mut Allocator {
    let mut words = List<Bytes>.make()
    let answer = answered(answers)
    match &command.* {
      Start.Init { kind } => {
        run word(&mut words, b"init")
        run word(&mut words, b"new")
        match kind {
          Kind.Default => {
            let hosts: [&'static [u8]; 5] = [b"none", b"d", b"a", b"b", b"c"]
            run stage.hosts(bench, hosts[answer])
          }
          Kind.Minimal => {
            run word(&mut words, b"--template")
            run word(&mut words, b"minimal")
          }
          Kind.Library => {
            run word(&mut words, b"--lib")
          }
          Kind.Workspace => {
            run word(&mut words, b"--workspace")
          }
          Kind.Template => {
            let names: [&'static [u8]; 5] = [b"plain", b"nosuch", b"plain", b"hooked", b"failing"]
            run stage.hosts(
              bench,
              if answer == 0 {
                b"none"
              } else {
                b"a"
              },
            )
            run word(&mut words, b"--template")
            run word(&mut words, names[answer])
          }
        }
      }
      Start.Templates => {
        run stage.hosts(
          bench,
          if answer == 0 {
            b"none"
          } else {
            b"a"
          },
        )
        run word(&mut words, b"init")
        run word(&mut words, b"--list")
      }
      Start.Clash => {
        run word(&mut words, b"init")
        run word(&mut words, b"new")
        run word(&mut words, b"--lib")
        run word(&mut words, b"--workspace")
      }
      _ => {}
    }
    return move words
  }

  /// The site the disk shows: whether `new` is there and has a `silk.toml`, and whether the
  /// work directory has one.
  effect fn observed(self: &Self, stage: &Stage, bench: &Bench) -> Site
    ! FileError | OutOfMemoryError
    ? &mut FileSystem | &mut Allocator {
    let project = run Path.join(&stage.work, "new")
    let mut target = Target.Absent
    if run FileSystem.exists(&project) {
      target = Target.Plain
      if run FileSystem.exists(&run Path.join(&project, "silk.toml")) {
        target = Target.Taken
      }
    }
    return Site.of(target, run FileSystem.exists(&run Path.join(&stage.work, "silk.toml")))
  }

  /// A site without what only a running command knows.
  fn shown(self: &Self, context: &Site) -> Site {
    return Site.of(context.target, context.around)
  }

  /// A project that was created must pin the version of the toolchain, and must carry nothing
  /// of its template: no `[[post-init]]` entry, no `[template]` table and no `.git` directory.
  effect fn sound(
    self: &Self,
    stage: &Stage,
    bench: &Bench,
    command: &Start,
    trail: &[Trail],
    outcome: &Outcome,
  ) -> List<Bytes>
    ! FileError | OutOfMemoryError
    ? &mut FileSystem | &mut Allocator {
    let mut wrong = List<Bytes>.make()
    let mut stays = false
    let mut at: usize = 0
    while at < trail.length {
      match &trail[at] {
        Trail.Creates { spot } => {
          if spot == Spot.Project {
            stays = true
          }
        }
        Trail.Removes { spot } => {
          if spot == Spot.Project {
            stays = false
          }
        }
        _ => {}
      }
      at = at + 1
    }
    if !stays {
      return move wrong
    }
    let project = run Path.join(&stage.work, "new")
    let manifest = run FileSystem.readFile(&run Path.join(&project, "silk.toml"))
    let mut pin = run Bytes.copy(b"silk-version = \"")
    run Bytes.append(&mut pin, bench.pinned())
    run Bytes.append(&mut pin, b"\"")
    let text = manifest.asSlice()
    if !holds(text, b"[workspace]") && !holds(text, pin.asSlice()) {
      run word(&mut wrong, b"the new manifest does not pin the version of the toolchain")
    }
    if holds(text, b"[[post-init]]") {
      run word(&mut wrong, b"the new manifest keeps a [[post-init]] entry of its template")
    }
    if holds(text, b"[template]") {
      run word(&mut wrong, b"the new manifest keeps the [template] table of its template")
    }
    if run FileSystem.exists(&run Path.join(&project, ".git")) {
      run word(&mut wrong, b"the new project keeps the .git directory of its template")
    }
    return move wrong
  }
}
