//! What one `silk` command leaves behind: [`Footprint`].
//!
//! A row of the chart in `Silk` lists every effect the command may have there, and nothing else
//! is allowed. A test that runs the real tool compares what it sees with this list: the exit
//! status, the messages, the downloads, and the files that appear, change or go away.

import silk.schema.schema { Schema }

/// Something on the computer that a command creates, changes or removes.
pub enum Place {
  /// The directory of one Silk version in `$SILK_HOME/toolchains`.
  Toolchain,
  /// The hidden directory `.install-*` beside the installed versions, where a download is
  /// unpacked before it is moved into place.
  Staging,
  /// `$SILK_HOME/settings.toml`, which names the default version.
  Settings,
  /// The `silk.toml` that pins the project: the workspace's, or the package's own.
  Manifest,
  /// The `silk.toml` files of the workspace members that pin a version themselves.
  Members,
  /// The tool itself, `$SILK_HOME/bin/silk`.
  Tool,
}

/// Something a command downloads from the release source.
pub enum Asset {
  /// The list of published releases.
  Listing,
  /// The archive of one release.
  Archive,
  /// The minisign signature of the archive.
  Signature,
}

/// A program the tool starts.
pub enum Program {
  /// The compiler `silkc` of an installed version.
  Compiler,
  /// The compiler `silkc` beside the tool, as a release archive, Homebrew or mise lays them out.
  Bundled,
}

/// What a command says. Each member is one kind of message. The tool writes the words, with
/// the versions and paths of the real computer.
pub enum Message {
  /// Standard error: the words are not a command, with the way to the help.
  Usage,
  /// Standard error: the word is no command, with the command it is one edit away from.
  UnknownCommand,
  /// Standard error: no home directory is known, so there is no place for versions.
  NoHome,
  /// Standard error: `SILK_TOOLCHAIN` is set and is not a version.
  BadEnvironment,
  /// Standard error: the `+<version>` argument is not a version.
  BadRequest,
  /// Standard error: the project pins something the tool cannot read as one version.
  UnknownPin,
  /// Standard output: the installed versions.
  Versions,
  /// Standard output: the version the directory selects, and why.
  Selected,
  /// Standard error: nothing selects a version here, with the command that installs one.
  NothingSelected,
  /// Standard error: the selected version is not installed, with the command that installs it.
  NotInstalled,
  /// Standard error: a member pins a version beside the pin of its workspace, which wins.
  IgnoredPin,
  /// Standard output: the version is not installed, so nothing is removed.
  NothingToRemove,
  /// Standard output: the version was removed.
  Removed,
  /// Standard error: the removed version was the default.
  WasDefault,
  /// Standard error: the project pins the removed version.
  PinnedHere,
  /// Standard error: `silk use` without a version needs a project that pins one.
  NoPin,
  /// Standard error: the tool installs the selected version first, because automatic installs
  /// are on.
  Installing,
  /// Standard output: the version was installed. Standard error when a forwarded command
  /// installed it, so the output of that command stays alone.
  Installed,
  /// Standard output: the version is already installed.
  AlreadyInstalled,
  /// Standard output: the version is now the default.
  DefaultSet,
  /// Standard error: the project still pins another version than the new default.
  StillPins,
  /// Standard error: there is no `silk.toml` here or above.
  NoProject,
  /// Standard error: the manifest cannot be edited.
  CannotEdit,
  /// Standard output: the project is pinned.
  Pinned,
  /// Standard output: the members' own pins were removed.
  MembersUnpinned,
  /// Standard error: the pinned version is not installed yet.
  NotInstalledYet,
  /// Standard error: the pinned version is older than the tool.
  OlderThanTool,
  /// Standard error: no published release is the version.
  NotPublished,
  /// Standard error: no stable release is published yet.
  NoStable,
  /// Standard error: the release listing names no release.
  NoReleases,
  /// Standard error: the release source did not answer.
  Unreachable,
  /// Standard error: the download did not arrive whole.
  DownloadFailed,
  /// Standard error: the archive is not signed by the release key for this release.
  Forged,
  /// Standard error: the archive is not a release of Silk.
  Corrupt,
  /// Standard error: a file of the home directory cannot be written or moved.
  Blocked,
  /// Standard error: the compiler does not start.
  CannotRun,
  /// Standard output: the tool is the newest release.
  UpToDate,
  /// Standard output: the tool was updated.
  Updated,
  /// The overview of the commands of the selected compiler.
  Overview,
  /// Standard error: the selected compiler did not give its overview.
  HelpFailed,
  /// The commands of the tool itself.
  OwnCommands,
}

/// One thing a command leaves behind.
pub union Footprint {
  /// The process ends with this exit status.
  Exits { pub status: u8 },
  /// A message on standard output or standard error.
  Says { pub message: Message },
  /// A download from the release source.
  Downloads { pub asset: Asset },
  /// A file or directory that was not there before.
  Creates { pub place: Place },
  /// A file whose content changed.
  Changes { pub place: Place },
  /// A file or directory that is gone.
  Removes { pub place: Place },
  /// A program the tool started. The tool becomes the compiler when it forwards a command, so
  /// the exit status is then the compiler's.
  Runs { pub program: Program },
}

impl Schema for Place {}

impl Schema for Asset {}

impl Schema for Program {}

impl Schema for Message {}

impl Schema for Footprint {}
