//! The computer as the `silk` tool sees it: [`Computer`].
//!
//! The chart in `Silk` decides everything from these facts, so a fact that is not here cannot
//! change what a command does. The tool fills a `Computer` from the real disk and environment
//! before it runs the machine. A test fills one by hand.
//!
//! Versions have no numbers here. A command names at most a few of them, so each one is a
//! [`Version`] by position, and what matters about it is in its [`Release`]: whether it is
//! installed, and how old it is next to the tool.

import silk.schema.schema { Schema }

/// One Silk version, by position. The tool gives the versions that one command meets the
/// positions in the order it meets them.
pub enum Version {
  First,
  Second,
  Third,
  Fourth,
}

/// A version, or none.
pub enum Choice {
  Nothing,
  First,
  Second,
  Third,
  Fourth,
}

/// What `+<version>` on the command line or `SILK_TOOLCHAIN` in the environment says.
pub enum Named {
  /// It is absent, or empty.
  Unset,
  /// It is there and is not a version.
  Malformed,
  First,
  Second,
  Third,
  Fourth,
}

/// What the directory of one version in `$SILK_HOME/toolchains` holds.
pub enum Store {
  /// There is no directory.
  Absent,
  /// There is a directory without a compiler: an interrupted copy, or what a disk cleaner left.
  Damaged,
  /// The whole toolchain.
  Installed,
}

/// How old a version is next to the running tool.
pub enum Age {
  /// Older than the tool.
  Older,
  /// The release the tool came with.
  Own,
  /// Newer than the tool.
  Newer,
}

/// One version on this computer.
pub struct Release {
  pub store: Store,
  pub age: Age,
}

/// The project around the working directory.
pub enum Project {
  /// No `silk.toml` here or above.
  Absent,
  /// A package that no workspace lists.
  Package,
  /// A workspace, or a package that a workspace lists.
  Workspace,
}

/// What the project says about its version.
pub enum Pinned {
  /// No `silk-version`, or `0.0.0`.
  Nothing,
  /// A `silk-version` that is no version. A newer tool may read it.
  Unreadable,
  /// A workspace without a pin whose members pin different versions.
  Split,
  /// The `silk-version` of the workspace, or of the package when no workspace covers it.
  Own,
  /// A workspace without a pin whose members pin one version.
  Members,
}

/// The pin of the project.
pub struct Pin {
  pub state: Pinned,
  /// The pinned version, for `Own` and `Members`.
  pub version: Choice,
}

/// Why a version is selected.
pub enum Origin {
  Nothing,
  /// `+<version>` on the command line.
  CommandLine,
  /// `SILK_TOOLCHAIN`.
  Environment,
  /// The pin of the project.
  Project,
  /// `default` in `settings.toml`.
  Default,
}

/// The version a command runs with, and why.
pub struct Selected {
  pub version: Choice,
  pub origin: Origin,
}

/// What a forwarded command does, before any download.
pub enum Verdict {
  /// `+<version>` is not a version.
  BadRequest,
  /// `SILK_TOOLCHAIN` is not a version.
  BadEnvironment,
  /// The pin of the project cannot be read as one version.
  UnknownPin,
  /// The compiler beside the tool runs.
  Bundled,
  /// Nothing selects a version.
  NothingSelected,
  /// No home directory is known.
  NoHome,
  /// The compiler of the selected version runs.
  Compiler,
  /// The selected version is not installed, and automatic installs are on.
  Install,
  /// The selected version is not installed.
  NotInstalled,
}

/// The command the tool is in the middle of.
pub enum Task {
  /// None: the tool is not running.
  Resting,
  /// `silk use <version>`.
  Using,
  /// `silk use`.
  UsingPinned,
  /// `silk set <version>`.
  Setting,
  /// `silk set <version> --no-install`.
  Pinning,
  /// A command for the compiler.
  Running,
  /// `silk --help`.
  Helping,
  /// A word that is one edit away from a command of the tool.
  Guessing,
  /// `silk update self`.
  Updating,
  /// A command that needs one step: `use list`, `use which`, `use uninstall`.
  Asking,
}

/// The computer as the tool sees it, and what the tool keeps in mind while one command runs.
pub struct Computer {
  /// Whether a home directory is known: `$SILK_HOME`, or `~/.silk`.
  pub home: bool,
  /// Whether a missing version installs itself: `SILK_AUTO_INSTALL=1`, or
  /// `auto-install = true` in `settings.toml`.
  pub autoInstall: bool,
  /// Whether a compiler lies beside the tool. It is the release the tool came with.
  pub bundled: bool,
  /// `SILK_TOOLCHAIN`.
  pub environment: Named,
  /// `default` in `settings.toml`.
  pub standard: Choice,
  pub project: Project,
  pub pin: Pin,
  /// Whether a member pins a version itself, beside the pin of its workspace.
  pub strays: bool,
  /// Whether an interrupted install left a hidden directory beside the installed versions.
  pub debris: bool,
  pub first: Release,
  pub second: Release,
  pub third: Release,
  pub fourth: Release,

  /// The command in progress. This and the fields below are what the tool keeps in mind. They
  /// go back to their first values when the process ends.
  pub task: Task,
  /// The version the command is about.
  pub subject: Choice,
  /// Why `subject` is selected, for a command that selects a version.
  pub origin: Origin,
  /// Whether the command was `silk` alone, which prints the help as an error.
  pub bare: bool,
  /// Whether this command installed `subject`.
  pub fresh: bool,
}

impl Schema for Version {}

impl Schema for Choice {}

impl Schema for Named {}

impl Schema for Store {}

impl Schema for Age {}

impl Schema for Release {}

impl Schema for Project {}

impl Schema for Pinned {}

impl Schema for Pin {}

impl Schema for Origin {}

impl Schema for Task {}

impl Schema for Computer {}

/// `version` as a choice.
pub fn chosen(version: Version) -> Choice {
  return match version {
    Version.First => Choice.First
    Version.Second => Choice.Second
    Version.Third => Choice.Third
    Version.Fourth => Choice.Fourth
  }
}

/// The version `named` names, or nothing when it is unset or malformed.
pub fn named(value: Named) -> Choice {
  return match value {
    Named.First => Choice.First
    Named.Second => Choice.Second
    Named.Third => Choice.Third
    Named.Fourth => Choice.Fourth
    _ => Choice.Nothing
  }
}

impl Computer {
  /// A computer with a home directory and nothing else: no version, no default, no project.
  /// `first` is older than the tool, `second` is the tool's own release, and the others are
  /// newer.
  pub fn empty() -> Computer {
    return Computer {
      home: true,
      autoInstall: false,
      bundled: false,
      environment: Named.Unset,
      standard: Choice.Nothing,
      project: Project.Absent,
      pin: Pin { state: Pinned.Nothing, version: Choice.Nothing },
      strays: false,
      debris: false,
      first: Release { store: Store.Absent, age: Age.Older },
      second: Release { store: Store.Absent, age: Age.Own },
      third: Release { store: Store.Absent, age: Age.Newer },
      fourth: Release { store: Store.Absent, age: Age.Newer },
      task: Task.Resting,
      subject: Choice.Nothing,
      origin: Origin.Nothing,
      bare: false,
      fresh: false,
    }
  }

  /// What the directory of `version` holds. Nothing has no directory.
  pub fn store(self: &Self, version: Choice) -> Store {
    return match version {
      Choice.Nothing => Store.Absent
      Choice.First => self.first.store
      Choice.Second => self.second.store
      Choice.Third => self.third.store
      Choice.Fourth => self.fourth.store
    }
  }

  /// How old `version` is next to the tool. Nothing counts as newer.
  pub fn age(self: &Self, version: Choice) -> Age {
    return match version {
      Choice.Nothing => Age.Newer
      Choice.First => self.first.age
      Choice.Second => self.second.age
      Choice.Third => self.third.age
      Choice.Fourth => self.fourth.age
    }
  }

  /// Makes the directory of `version` hold `store`.
  pub fn keep(self: &mut Self, version: Choice, store: Store) -> () {
    match version {
      Choice.Nothing => {}
      Choice.First => {
        self.first.store = store
      }
      Choice.Second => {
        self.second.store = store
      }
      Choice.Third => {
        self.third.store = store
      }
      Choice.Fourth => {
        self.fourth.store = store
      }
    }
    return ()
  }

  /// Whether a command can run the compiler of `version`: the home is known and holds the
  /// whole toolchain.
  pub fn installed(self: &Self, version: Choice) -> bool {
    return self.home && self.store(version) == Store.Installed
  }

  /// The version the project runs with, or nothing.
  pub fn pinned(self: &Self) -> Choice {
    if self.pin.state == Pinned.Own || self.pin.state == Pinned.Members {
      return self.pin.version
    }
    return Choice.Nothing
  }

  /// Whether the project pins something that is not one version.
  pub fn pinBlocks(self: &Self) -> bool {
    return self.pin.state == Pinned.Unreadable || self.pin.state == Pinned.Split
  }

  /// The version a command runs with when the command line says `asked`, and why. The first of
  /// these that names a version wins: `+<version>`, `SILK_TOOLCHAIN`, the pin of the project,
  /// and the default.
  pub fn selects(self: &Self, asked: Named) -> Selected {
    if named(asked) != Choice.Nothing {
      return Selected { version: named(asked), origin: Origin.CommandLine }
    }
    if named(self.environment) != Choice.Nothing {
      return Selected { version: named(self.environment), origin: Origin.Environment }
    }
    if self.pinned() != Choice.Nothing {
      return Selected { version: self.pinned(), origin: Origin.Project }
    }
    if self.home && self.standard != Choice.Nothing {
      return Selected { version: self.standard, origin: Origin.Default }
    }
    return Selected { version: Choice.Nothing, origin: Origin.Nothing }
  }

  /// Whether a command that selects a version cannot, when the command line says `asked`:
  /// neither it nor `SILK_TOOLCHAIN` names one, and the pin of the project is not one version.
  pub fn selectionBlocked(self: &Self, asked: Named) -> bool {
    return named(asked) == Choice.Nothing && named(self.environment) == Choice.Nothing
      && self.pinBlocks()
  }

  /// What a forwarded command does when the command line says `asked`.
  pub fn verdict(self: &Self, asked: Named) -> Verdict {
    if asked == Named.Malformed {
      return Verdict.BadRequest
    }
    if asked == Named.Unset && self.environment == Named.Malformed {
      return Verdict.BadEnvironment
    }
    if self.selectionBlocked(asked) {
      return Verdict.UnknownPin
    }
    let selected = self.selects(asked)
    let nothing = selected.version == Choice.Nothing

    // The compiler beside the tool serves when nothing selects a version, and when the
    // selected one is its release and is not installed.
    if self.bundled && (nothing || self.age(selected.version) == Age.Own)
      && !self.installed(selected.version) {
      return Verdict.Bundled
    }
    if nothing {
      return Verdict.NothingSelected
    }
    if !self.home {
      return Verdict.NoHome
    }
    if self.installed(selected.version) {
      return Verdict.Compiler
    }
    if self.autoInstall {
      return Verdict.Install
    }
    return Verdict.NotInstalled
  }

  /// Whether a member's own pin is passed over: the version comes from the pin of a workspace,
  /// and a member pins a version itself.
  pub fn ignoresMember(self: &Self) -> bool {
    return self.origin == Origin.Project && self.project == Project.Workspace
      && self.pin.state == Pinned.Own && self.strays
  }

  /// Whether `silk set` at a workspace has members' own pins to remove.
  pub fn memberPins(self: &Self) -> bool {
    return self.project == Project.Workspace
      && (self.strays || self.pin.state == Pinned.Members || self.pin.state == Pinned.Split)
  }

  /// Forgets the command in progress: the process ended.
  pub fn rest(self: &mut Self) -> () {
    self.task = Task.Resting
    self.subject = Choice.Nothing
    self.origin = Origin.Nothing
    self.bare = false
    self.fresh = false
    return ()
  }
}
