//! Promises the `silk` tool keeps on every path, each with its reason: [`laws`].
//!
//! A row of the chart says what one command leaves in one situation. A law says what a command
//! never leaves in any situation, so a new row cannot break the promise without a test saying
//! which one. The model checks walk every state of the machine and report each run that breaks
//! a law.

import Computer { Computer }
import Footprint { Asset, Footprint, Place }
import Silk { Typed }
import silk.machine.rules { Rules }

type Laws = Rules<Typed, Computer, Footprint>

fn noAutoInstall(computer: &Computer, event: &Typed) -> bool {
  return !computer.autoInstall
}

fn onlyPins(computer: &Computer, event: &Typed) -> bool {
  return match &event.* {
    Typed.Set { install, .. } => !install
    Typed.SetNewest { install, .. } => !install
    _ => false
  }
}

// `event` leaves the project as it is.
static fn keepsProject(laws: Laws, event: Intrinsic.VariantName<Typed>) -> Laws {
  return laws
    |> Rules.never(event, Footprint.Changes { place: Place.Manifest }, "only silk set edits a project")
    |> Rules.never(event, Footprint.Changes { place: Place.Members }, "only silk set edits a project")
}

// `event` leaves the default as it is.
static fn keepsDefault(laws: Laws, event: Intrinsic.VariantName<Typed>) -> Laws {
  return laws
    |> Rules.never(event, Footprint.Changes { place: Place.Settings }, "only silk use <version> moves the default")
}

// `event` installs and removes nothing.
static fn keepsVersions(laws: Laws, event: Intrinsic.VariantName<Typed>, reason: string<'static>) -> Laws {
  return laws
    |> Rules.never(event, Footprint.Downloads { asset: Asset.Archive }, reason)
    |> Rules.never(event, Footprint.Downloads { asset: Asset.Signature }, reason)
    |> Rules.never(event, Footprint.Creates { place: Place.Staging }, reason)
    |> Rules.never(event, Footprint.Creates { place: Place.Toolchain }, reason)
    |> Rules.never(event, Footprint.Removes { place: Place.Toolchain }, reason)
}

// `event` changes nothing at all and asks the network nothing.
static fn onlyReads(laws: Laws, event: Intrinsic.VariantName<Typed>, reason: string<'static>) -> Laws {
  return laws
    |> keepsProject(event)
    |> keepsDefault(event)
    |> keepsVersions(event, reason)
    |> Rules.never(event, Footprint.Downloads { asset: Asset.Listing }, reason)
    |> Rules.never(event, Footprint.Removes { place: Place.Staging }, reason)
}

/// The laws of the `silk` tool.
pub static fn laws() -> Rules<Typed, Computer, Footprint> {
  return Rules<Typed, Computer, Footprint>.of()
    |> Rules.neverAny(Footprint.Creates { place: Place.Settings }, "settings change in place")
    |> Rules.always("Misuse", Footprint.Exits { status: 2 }, "words that are no command are a usage error")
    |> onlyReads("Misuse", "a usage error changes nothing")
    |> onlyReads("List", "silk use list only reads")
    |> onlyReads("Which", "silk use which only reads")
    |> onlyReads("Help", "the help only reads")
    |> onlyReads("Near", "a mistyped word changes nothing")

    |> keepsProject("Use")
    |> keepsProject("UseNewest")
    |> keepsProject("UsePinned")
    |> keepsProject("Uninstall")
    |> keepsProject("UpdateSelf")
    |> keepsProject("Run")

    |> keepsDefault("UsePinned")
    |> keepsDefault("Uninstall")
    |> keepsDefault("Set")
    |> keepsDefault("SetNewest")
    |> keepsDefault("UpdateSelf")
    |> keepsDefault("Run")

    |> Rules.never("UpdateSelf", Footprint.Creates { place: Place.Staging }, "silk update self installs no Silk version")
    |> Rules.never("UpdateSelf", Footprint.Creates { place: Place.Toolchain }, "silk update self installs no Silk version")
    |> Rules.never("UpdateSelf", Footprint.Removes { place: Place.Toolchain }, "silk update self removes no Silk version")
    |> Rules.never("Uninstall", Footprint.Creates { place: Place.Toolchain }, "silk use uninstall installs nothing")
    |> Rules.never("Uninstall", Footprint.Downloads { asset: Asset.Listing }, "silk use uninstall needs no network")
    |> Rules.never("Uninstall", Footprint.Downloads { asset: Asset.Archive }, "silk use uninstall needs no network")
    |> Rules.neverWhen("Run", noAutoInstall, Footprint.Downloads { asset: Asset.Listing }, "a command for the compiler needs no network unless automatic installs are on")
    |> Rules.neverWhen("Run", noAutoInstall, Footprint.Downloads { asset: Asset.Archive }, "a command for the compiler needs no network unless automatic installs are on")
    |> Rules.neverWhen("Run", noAutoInstall, Footprint.Creates { place: Place.Toolchain }, "a command for the compiler installs nothing unless automatic installs are on")
    |> Rules.never("Run", Footprint.Removes { place: Place.Toolchain }, "a command for the compiler removes no version")
    |> Rules.neverWhen("Set", onlyPins, Footprint.Downloads { asset: Asset.Archive }, "silk set --no-install installs nothing")
    |> Rules.neverWhen("Set", onlyPins, Footprint.Creates { place: Place.Toolchain }, "silk set --no-install installs nothing")
    |> Rules.neverWhen("SetNewest", onlyPins, Footprint.Downloads { asset: Asset.Archive }, "silk set --no-install installs nothing")
    |> Rules.neverWhen("SetNewest", onlyPins, Footprint.Creates { place: Place.Toolchain }, "silk set --no-install installs nothing")
    |> Rules.never("Set", Footprint.Changes { place: Place.Tool }, "only silk update self replaces the tool")
    |> Rules.never("Use", Footprint.Changes { place: Place.Tool }, "only silk update self replaces the tool")
    |> Rules.never("Run", Footprint.Changes { place: Place.Tool }, "only silk update self replaces the tool")
}
