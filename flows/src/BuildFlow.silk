//! Checking, building, running, cleaning and formatting one package as a machine: [`Building`]
//! is where a command stands, [`Make`] is what the user types and does, and [`Bay`] is the
//! source of the package and what its build directory holds.
//!
//! This machine is a reference. The compiler does not run it: a run of the real compiler is
//! compared with it, and a disagreement is a bug in the compiler or a wrong row here.
//!
//! The package has one source and no dependency. A build writes one program, and keeps
//! everything else it makes in the build directory as a cache for the next check or build. A
//! build of a source that did not change since the last one does no work at all. A check never
//! writes a program, and a build that fails leaves the old program where it is.

import Trail { Note, Spot, Trail }
import silk.build.events { Fetch, Work }
import silk.collections.list { List }
import silk.machine.chart { Chart, Enqueue, Guards, Machine, Next }
import silk.machine.rules { Rules }
import silk.machine.snapshot { Snapshot, Steps, TransitionLoopError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.schema.schema { Schema }

/// Where one command stands. No command of this machine waits for the world, so there is one
/// state.
pub union Building {
  /// No command runs.
  Resting,
}

/// What the user types, and what the user does to the package between commands.
pub union Make {
  /// `silk check --no-server`.
  Check,
  /// `silk build`.
  Build,
  /// `silk run`.
  Run,
  /// `silk clean`.
  Clean,
  /// `silk format`.
  Format,
  /// `silk format --check`.
  FormatCheck,
  /// The user writes a new source that is right and formatted.
  Edit,
  /// The user writes a new source with a type error.
  Break,
  /// The user writes a new source that is right and not formatted.
  Untidy,
  /// Half of every file of the cache is lost, as when a disk fills up.
  Tear,
  /// The user gives the directory of the package another name.
  Move,
}

/// What the source of the package is.
pub enum Source {
  /// Right and formatted.
  Sound,
  /// Formatted, with a type error.
  Broken,
  /// Right and not formatted.
  Untidy,
}

/// What the program of the package is.
pub enum Output {
  /// There is no program.
  Missing,
  /// The program is the one of the source, built where the package is now.
  Current,
  /// The program is one of an earlier source, or of the package under its earlier name.
  Stale,
}

/// The package and its build directory.
pub struct Bay {
  pub source: Source,
  pub output: Output,
  /// Whether there is a build directory.
  pub built: bool,
  /// Whether half of the cache was lost since the last command that wrote it.
  pub torn: bool,
  /// Whether the directory of the package has its second name.
  pub moved: bool,
}

impl Schema for Building {}

impl Schema for Make {}

impl Schema for Source {}

impl Schema for Output {}

impl Schema for Bay {}

impl Bay {
  /// A package with a right and formatted source that was never checked or built.
  pub fn new() -> Bay {
    return Bay {
      source: Source.Sound,
      output: Output.Missing,
      built: false,
      torn: false,
      moved: false,
    }
  }
}

fn broken(bay: &Bay, event: &Make) -> bool {
  return bay.source == Source.Broken
}

fn untidy(bay: &Bay, event: &Make) -> bool {
  return bay.source == Source.Untidy
}

fn current(bay: &Bay, event: &Make) -> bool {
  return bay.output == Output.Current
}

fn missing(bay: &Bay, event: &Make) -> bool {
  return bay.output == Output.Missing
}

fn built(bay: &Bay, event: &Make) -> bool {
  return bay.built
}

fn programmed(bay: &Bay) -> bool {
  return bay.output != Output.Missing
}

type Rows = Chart<Building, Make, Bay, Trail>

// What a row leaves when the check finds the type error.
static fn failing(chart: Rows) -> Rows {
  return chart
    |> Chart.leaves(
      &[
        Trail.Does { work: Work.Check },
        Trail.Changes { spot: Spot.Cache },
        Trail.Says { note: Note.Diagnostic },
        Trail.Says { note: Note.Failed },
        Trail.Exits { status: 1 },
      ],
    )
}

// What a row leaves when a build does all its work. `first` is what it does to the program.
static fn working(chart: Rows, first: Trail) -> Rows {
  return chart
    |> Chart.leaves(
      &[
        Trail.Does { work: Work.Check },
        Trail.Does { work: Work.Codegen },
        Trail.Does { work: Work.Link },
        Trail.Changes { spot: Spot.Cache },
        first,
        Trail.Says { note: Note.Finished },
      ],
    )
}

// The rows of a build for the event `event`. `runs` is whether the program runs after it.
static fn builds(chart: Rows, event: Intrinsic.VariantName<Make>, runs: bool) -> Rows {
  let last: [Trail; 1] = [Trail.Exits { status: 0 }]
  let greeting: [Trail; 2] = [Trail.Says { note: Note.Greeting }, Trail.Exits { status: 0 }]
  let mut rows = chart
    |> Chart.stayWhen("Resting", event, Guards.named("the source has a type error", broken))
    |> failing()
    |> Chart.stayWhen(
      "Resting",
      event,
      Guards.named("the program is the one of the source", current),
    )
    |> Chart.leaves(&[Trail.Says { note: Note.Finished }])
  static if runs {
    rows = rows |> Chart.leaves(&greeting)
  } else {
    rows = rows |> Chart.leaves(&last)
  }
  rows = rows
    |> Chart.stayWhen("Resting", event, Guards.named("there is no program", missing))
    |> working(Trail.Creates { spot: Spot.Output })
  static if runs {
    rows = rows |> Chart.leaves(&greeting)
  } else {
    rows = rows |> Chart.leaves(&last)
  }
  rows = rows
    |> Chart.stay("Resting", event)
    |> working(Trail.Changes { spot: Spot.Output })
  static if runs {
    rows = rows |> Chart.leaves(&greeting)
  } else {
    rows = rows |> Chart.leaves(&last)
  }
  return rows
}

impl Machine<Make, Bay, Trail> for Building {
  static fn chart() -> Chart<Building, Make, Bay, Trail> {
    return Chart<Building, Make, Bay, Trail>.of()
      |> Chart.initial(Building.Resting)

      // silk check
      |> Chart.stayWhen("Resting", "Check", Guards.named("the source has a type error", broken))
      |> failing()
      |> Chart.stay("Resting", "Check")
      |> Chart.leaves(
        &[
          Trail.Does { work: Work.Check },
          Trail.Changes { spot: Spot.Cache },
          Trail.Says { note: Note.Finished },
          Trail.Exits { status: 0 },
        ],
      )

      // silk build, silk run
      |> builds("Build", false)
      |> builds("Run", true)

      // silk clean
      |> Chart.stayWhen("Resting", "Clean", Guards.named("there is a build directory", built))
      |> Chart.leaves(&[Trail.Removes { spot: Spot.Cache }])
      |> Chart.leavesWhen(
        Guards.named("there is a program", programmed),
        &[Trail.Removes { spot: Spot.Output }],
      )
      |> Chart.leaves(&[Trail.Says { note: Note.Cleaned }, Trail.Exits { status: 0 }])
      |> Chart.stay("Resting", "Clean")
      |> Chart.leaves(&[Trail.Says { note: Note.NothingToClean }, Trail.Exits { status: 0 }])

      // silk format. The manifest is a file it looks at too, and that one is always formatted.
      |> Chart.stayWhen("Resting", "Format", Guards.named("the source is not formatted", untidy))
      |> Chart.leaves(
        &[
          Trail.Changes { spot: Spot.Sources },
          Trail.Says { note: Note.Formatted },
          Trail.Says { note: Note.Unchanged },
          Trail.Exits { status: 0 },
        ],
      )
      |> Chart.stay("Resting", "Format")
      |> Chart.leaves(&[Trail.Says { note: Note.Unchanged }, Trail.Exits { status: 0 }])
      |> Chart.stayWhen(
        "Resting",
        "FormatCheck",
        Guards.named("the source is not formatted", untidy),
      )
      |> Chart.leaves(
        &[
          Trail.Says { note: Note.NeedsFormatting },
          Trail.Says { note: Note.Unchanged },
          Trail.Exits { status: 1 },
        ],
      )
      |> Chart.stay("Resting", "FormatCheck")
      |> Chart.leaves(&[Trail.Says { note: Note.Unchanged }, Trail.Exits { status: 0 }])

      // What the user does. `handle` changes the package, and no command runs.
      |> Chart.stay("Resting", "Edit")
      |> Chart.stay("Resting", "Break")
      |> Chart.stay("Resting", "Untidy")
      |> Chart.stay("Resting", "Tear")
      |> Chart.stay("Resting", "Move")
  }

  // What the user does to the package.
  effect fn handle(
    state: &Building,
    context: &mut Bay,
    event: &Make,
    enq: &mut Enqueue<Make, Trail>,
  ) -> Next<Building>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut changed = false
    match &event.* {
      Make.Edit => {
        context.source = Source.Sound
        changed = true
      }
      Make.Break => {
        context.source = Source.Broken
        changed = true
      }
      Make.Untidy => {
        context.source = Source.Untidy
        changed = true
      }
      Make.Tear => {
        context.torn = context.built
      }
      Make.Move => {
        if !context.moved && context.output == Output.Missing {
          context.built = false
        }
        changed = !context.moved
        context.moved = true
      }
      _ => {}
    }
    if changed && context.output == Output.Current {
      context.output = Output.Stale
    }
    return Next<Building>.Pass
  }

  // The package after one effect of a row.
  fn absorb(state: &Building, context: &mut Bay, effect_: &Trail) -> () {
    match &effect_.* {
      Trail.Creates { spot } => {
        if spot == Spot.Output {
          context.output = Output.Current
        }
      }
      Trail.Changes { spot } => {
        if spot == Spot.Output {
          context.output = Output.Current
        }
        if spot == Spot.Cache {
          context.built = true
          context.torn = false
        }

        // Only `silk format` leaves this, and what it writes is formatted.
        if spot == Spot.Sources {
          context.source = Source.Sound
          if context.output == Output.Current {
            context.output = Output.Stale
          }
        }
      }
      Trail.Removes { spot } => {
        if spot == Spot.Output {
          context.output = Output.Missing
        }
        if spot == Spot.Cache {
          context.built = false
          context.torn = false
        }
      }
      _ => {}
    }
    return ()
  }
}

type Laws = Rules<Make, Bay, Trail>

// `event` edits no source.
static fn reads(laws: Laws, event: Intrinsic.VariantName<Make>) -> Laws {
  return laws
    |> Rules.never(event, Trail.Changes { spot: Spot.Sources }, "only silk format edits a source")
}

// `event` writes no program when the source has a type error.
static fn keeps(laws: Laws, event: Intrinsic.VariantName<Make>) -> Laws {
  return laws
    |> Rules.neverWhen(
      event,
      broken,
      Trail.Creates { spot: Spot.Output },
      "a build that fails leaves the old program",
    )
    |> Rules.neverWhen(
      event,
      broken,
      Trail.Changes { spot: Spot.Output },
      "a build that fails leaves the old program",
    )
    |> Rules.neverWhen(
      event,
      broken,
      Trail.Removes { spot: Spot.Output },
      "a build that fails leaves the old program",
    )
    |> Rules.neverWhen(
      event,
      current,
      Trail.Does { work: Work.Check },
      "a build of a source that did not change does no work",
    )
    |> Rules.neverWhen(
      event,
      current,
      Trail.Does { work: Work.Codegen },
      "a build of a source that did not change does no work",
    )
    |> Rules.neverWhen(
      event,
      current,
      Trail.Does { work: Work.Link },
      "a build of a source that did not change does no work",
    )
}

/// The promises the commands keep on every path, each with its reason.
pub static fn laws() -> Rules<Make, Bay, Trail> {
  return Rules<Make, Bay, Trail>.of()
    |> reads("Check")
    |> reads("Build")
    |> reads("Run")
    |> reads("Clean")
    |> reads("FormatCheck")
    |> keeps("Build")
    |> keeps("Run")
    |> Rules.never("Check", Trail.Creates { spot: Spot.Output }, "a check writes no program")
    |> Rules.never("Check", Trail.Changes { spot: Spot.Output }, "a check writes no program")
    |> Rules.never("Check", Trail.Does { work: Work.Codegen }, "a check generates no code")
    |> Rules.neverWhen(
      "Run",
      broken,
      Trail.Says { note: Note.Greeting },
      "a program that does not build does not run",
    )
    |> Rules.neverAny(
      Trail.Changes { spot: Spot.Manifest },
      "no command of a build edits the manifest",
    )
    |> Rules.neverAny(
      Trail.Fetches { source: Fetch.Archive },
      "a package without dependencies needs no network",
    )
    |> Rules.neverAny(
      Trail.Fetches { source: Fetch.Checkout },
      "a package without dependencies needs no network",
    )
}

type Shot = Snapshot<Building, Make, Bay, Trail>

/// The package a walk starts from, and a run sets up: a right source, never checked or built.
///
/// # Errors
/// `TransitionLoopError` as `Steps.begin` gives it. `OutOfMemoryError`.
pub effect fn starts() -> List<Shot>
  ! OutOfMemoryError | TransitionLoopError
  ? &mut Allocator {
  let mut shots = List<Shot>.make()
  run List<Shot>.append(&mut shots, run Steps.begin<Building, Make, Bay, Trail>(Bay.new(), 0))
  return move shots
}

/// Everything a user can type or do.
///
/// # Errors
/// `OutOfMemoryError`.
pub effect fn events() -> List<Make>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut all = List<Make>.make()
  run List<Make>.append(&mut all, Make.Check)
  run List<Make>.append(&mut all, Make.Build)
  run List<Make>.append(&mut all, Make.Run)
  run List<Make>.append(&mut all, Make.Clean)
  run List<Make>.append(&mut all, Make.Format)
  run List<Make>.append(&mut all, Make.FormatCheck)
  run List<Make>.append(&mut all, Make.Edit)
  run List<Make>.append(&mut all, Make.Break)
  run List<Make>.append(&mut all, Make.Untidy)
  run List<Make>.append(&mut all, Make.Tear)
  run List<Make>.append(&mut all, Make.Move)
  return move all
}
