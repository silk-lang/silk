//! What one command of the compiler leaves behind: [`Trail`].
//!
//! The machines of the compiler's commands, `ProjectFlow`, `DependencyFlow`, `BuildFlow` and
//! `ServerFlow`, are references: the compiler does not run them, and a run of the real compiler
//! is compared with them. They share this one type for what a row leaves. A row lists every
//! effect the command may have there, and nothing else is allowed: the exit status, the
//! messages, the files that appear, change or go away, and what the compiler reports that it
//! did, as `silk.build.events` describes.
//!
//! The `silk` tool runs its own machine and has its own type, `Footprint`, because the tool does
//! each member of it. Nothing does a member of `Trail`: a run only looks for it.

import silk.build.events { Fetch, Work }
import silk.schema.schema { Schema }

/// Something on the computer that a command creates, changes or removes.
pub enum Spot {
  /// The project `silk init` makes: its directory and every file in it.
  Project,
  /// The `silk.toml` of the workspace around a new package.
  Workspace,
  /// The `silk.toml` of the project.
  Manifest,
  /// The sources of the project, below `src`.
  Sources,
  /// What a check or a build keeps for the next one: everything below `build` but the program.
  Cache,
  /// The program a build writes for its target.
  Output,
  /// The archive of a dependency in the archive store of the home directory.
  Archive,
  /// The socket of the check server of the project.
  Socket,
}

/// What a command says. Each member is one kind of message, and the compiler writes the words.
pub enum Note {
  /// `silk init`: the project was created.
  Created,
  /// `silk init`: the new package was added to the workspace around it.
  Joined,
  /// `silk init`: the directory already has a project, and nothing is overwritten.
  Taken,
  /// `silk init`: `--lib` and `--workspace` cannot be combined.
  Clash,
  /// `silk init`: the template cannot be fetched.
  Unfetched,
  /// `silk init`: the template names no directory of its repository.
  Unlisted,
  /// `silk init`: a `[[post-init]]` entry of the template failed, so the project was removed.
  HookFailed,
  /// `silk init --list`: the templates.
  Templates,
  /// `silk add`: the dependency was added.
  Added,
  /// `silk add`: the package already has a dependency of that name.
  Duplicate,
  /// `silk add`: the directory has no manifest that can be read.
  Unreadable,
  /// `silk add`: the archive is not the one `--sha256` expects.
  Mismatch,
  /// The archive of a dependency cannot be fetched.
  CannotFetch,
  /// The archive of a dependency is not in the store, and `SILK_OFFLINE` forbids fetching it.
  Offline,
  /// `silk remove`: the dependency was removed.
  Dropped,
  /// `silk remove`: the package has no dependency of that name.
  NoSuch,
  /// A check or a build ended without errors.
  Finished,
  /// A check or a build ended with errors.
  Failed,
  /// An error in a source, with its place.
  Diagnostic,
  /// `silk run`: what the program of the project prints.
  Greeting,
  /// `silk clean`: the build directory was removed.
  Cleaned,
  /// `silk clean`: there is no build directory.
  NothingToClean,
  /// `silk format`: a file was formatted.
  Formatted,
  /// `silk format --check`: a file needs formatting.
  NeedsFormatting,
  /// `silk format`: a file is formatted already.
  Unchanged,
}

/// One thing a command leaves behind.
pub union Trail {
  /// The process ends with this exit status.
  Exits { pub status: u8 },
  /// A message on standard output or standard error.
  Says { pub note: Note },
  /// Files or directories that were not there before.
  Creates { pub spot: Spot },
  /// Files whose content changed. For `Spot.Cache` it is any write to the cache, and for
  /// `Spot.Cache` and `Spot.Output` the write may leave the same bytes.
  Changes { pub spot: Spot },
  /// Files or directories that are gone.
  Removes { pub spot: Spot },
  /// The command asks the network, or a `file:` URL, for something. It is here whether or not
  /// the answer comes.
  Fetches { pub source: Fetch },
  /// The compiler does one kind of work for the project: `Work.Check`, `Work.Codegen` or
  /// `Work.Link`. The other kinds of work are not compared.
  Does { pub work: Work },
  /// A check server that an earlier check left behind answers the check.
  Asks,
  /// The check leaves a check server behind.
  Serves,
}

impl Schema for Spot {}

impl Schema for Note {}

impl Schema for Trail {}
