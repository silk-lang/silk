//! The binding of the machine of check, build, run, clean and format, `BuildFlow`, to the local
//! world.
//!
//! The package of a trip is the directory `app` below the work directory, and `moved` once the
//! user gave it another name. Its program prints `Hello, <n>!`, where `n` counts the sources
//! the trip wrote, so that a program of an earlier source can be told from the one of the
//! source that is there.

import Bench { Bench, Binding, Stage, joined }
import BuildFlow { Bay, Make, Output, Source }
import Trail { Note, Trail }
import World { Outcome }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u8
import silk.num.usize
import silk.system.child_process { ChildProcess, ProcessError }
import silk.system.filesystem { DirectoryEntry, FileError, FileSystem, Path }

/// The binding of `BuildFlow`. It has no fields, because a stage holds everything of a trip.
pub struct BuildBinding {}

fn holds(text: &[u8], part: &[u8]) -> bool {
  let mut at: usize = 0
  while at + part.length <= text.length {
    if Slice.view<u8>(text, at, part.length) == part {
      return true
    }
    at = at + 1
  }
  return false
}

effect fn word(words: &mut List<Bytes>, text: &[u8]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  return run List<Bytes>.append(&mut words.*, run Bytes.copy(text))
}

effect fn number(text: &mut Bytes, value: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if value >= 10 {
    run number(&mut text.*, value / 10)
  }
  let digit: [u8; 1] = [usize.toU8(value % 10) + 48]
  return run Bytes.append(&mut text.*, &digit)
}

// The directory of the package.
effect fn package(stage: &Stage) -> Path
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  return run Path.joinBytes(&stage.work, stage.inside)
}

// Writes the source number `stage.edits` of the trip as `kind` says.
effect fn write(stage: &Stage, kind: Source) -> ()
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut text = Bytes.make()
  if kind == Source.Broken {
    run Bytes.append(&mut text, b"pub fn main() -> i32 {\n  return \"source ")
    run number(&mut text, stage.edits)
    run Bytes.append(&mut text, b"\"\n}\n")
  } else {
    run Bytes.append(
      &mut text,
      b"import silk.core.effect { Effect }\nimport silk.io.writer { Writer, WriterError }\nimport silk.io.writer_native { StdoutWriter }\n\npub effect fn main() -> ()\n  ! WriterError {\n",
    )
    run Bytes.append(
      &mut text,
      if kind == Source.Untidy {
        b"      let mut"
      } else {
        b"  let mut"
      },
    )
    run Bytes.append(
      &mut text,
      b" stdout = StdoutWriter.make()\n  run Writer.writeString(\"Hello, ",
    )
    run number(&mut text, stage.edits)
    run Bytes.append(&mut text, b"!\\n\") |> Effect.provideMut<Writer>(&mut stdout)\n}\n")
  }
  return run FileSystem.writeFile(
    &run Path.join(&run package(stage), "src/main.silk"),
    text.asSlice(),
  )
}

// Cuts every file below `directory` to half its length.
effect fn tear(directory: &Path) -> ()
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  if !run FileSystem.exists(directory) {
    return ()
  }
  let listed = run FileSystem.listDirectory(directory)
  let children = List<DirectoryEntry>.asSlice(&listed)
  let mut at: usize = 0
  while at < children.length {
    let child = &children[at]
    at = at + 1
    if child.kind.code == 1 {
      run tear(&child.path)
    } else if child.kind.code == 0 {
      let content = run FileSystem.readFile(&child.path)
      let whole = content.asSlice()
      run FileSystem.writeFile(&child.path, Slice.view<u8>(whole, 0, whole.length / 2))
    }
  }
  return ()
}

// Whether the build directory `build` has a program: a file `app` two directories below it.
effect fn programmed(build: &Path) -> bool
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  if !run FileSystem.exists(build) {
    return false
  }
  let targets = run FileSystem.listDirectory(build)
  let each = List<DirectoryEntry>.asSlice(&targets)
  let mut at: usize = 0
  while at < each.length {
    if each[at].kind.code == 1 && run FileSystem.exists(&run Path.join(&each[at].path, "dev/app")) {
      return true
    }
    at = at + 1
  }
  return false
}

impl Binding<Make, Bay> for BuildBinding {
  /// Writes the package `app` with its first source. Every trip starts there, so `start` adds
  /// nothing.
  effect fn arrange(self: &Self, stage: &mut Stage, bench: &Bench, start: &Bay) -> ()
    ! FileError | ProcessError | OutOfMemoryError
    ? &mut FileSystem | &mut ChildProcess | &mut Allocator {
    stage.inside = b"app"
    let directory = run package(&stage.*)
    run FileSystem.createDirectoriesRecursively(&run Path.join(&directory, "src"))
    let pin = run bench.pin()
    run FileSystem.writeFile(
      &run Path.join(&directory, "silk.toml"),
      (run joined(&[b"[package]\nname = \"app\"\nversion = \"0.1.0\"\n", pin.asSlice()])).asSlice(),
    )
    return run write(&stage.*, Source.Sound)
  }

  /// The words of `command`, or what the user does: a new source for `Make.Edit`, `Make.Break`
  /// and `Make.Untidy`, half of every file of the cache for `Make.Tear`, and the name `moved`
  /// for the directory of the package for `Make.Move`.
  effect fn act(
    self: &Self,
    stage: &mut Stage,
    bench: &Bench,
    command: &Make,
    answers: &[Make],
  ) -> List<Bytes>
    ! FileError | ProcessError | OutOfMemoryError
    ? &mut FileSystem | &mut ChildProcess | &mut Allocator {
    let mut words = List<Bytes>.make()
    match &command.* {
      Make.Check => {
        run word(&mut words, b"check")
        run word(&mut words, b"--no-server")
      }
      Make.Build => {
        run word(&mut words, b"build")
      }
      Make.Run => {
        run word(&mut words, b"run")
      }
      Make.Clean => {
        run word(&mut words, b"clean")
      }
      Make.Format => {
        run word(&mut words, b"format")
      }
      Make.FormatCheck => {
        run word(&mut words, b"format")
        run word(&mut words, b"--check")
      }
      Make.Edit => {
        stage.edits = stage.edits + 1
        run write(&stage.*, Source.Sound)
      }
      Make.Break => {
        stage.edits = stage.edits + 1
        run write(&stage.*, Source.Broken)
      }
      Make.Untidy => {
        stage.edits = stage.edits + 1
        run write(&stage.*, Source.Untidy)
      }
      Make.Tear => {
        let directory = run package(&stage.*)
        run tear(&run Path.join(&directory, "build/cache"))
        run tear(&run Path.join(&directory, "build/requests"))
      }
      Make.Move => {
        if stage.inside == b"app" {
          let from = run package(&stage.*)
          stage.inside = b"moved"
          run stage.renamed(&from, &run package(&stage.*))
        }
      }
    }
    return move words
  }

  /// What the source of the package is, whether there is a program and a build directory, and
  /// whether the package has its second name.
  effect fn observed(self: &Self, stage: &Stage, bench: &Bench) -> Bay
    ! FileError | OutOfMemoryError
    ? &mut FileSystem | &mut Allocator {
    let moved = run FileSystem.exists(&run Path.join(&stage.work, "moved"))
    let directory = run Path.join(
      &stage.work,
      if moved {
        "moved"
      } else {
        "app"
      },
    )
    let text = run FileSystem.readFile(&run Path.join(&directory, "src/main.silk"))
    let mut source = Source.Sound
    if holds(text.asSlice(), b"return \"") {
      source = Source.Broken
    } else if holds(text.asSlice(), b"      let mut") {
      source = Source.Untidy
    }
    let build = run Path.join(&directory, "build")
    return Bay {
      source: source,
      output: if run programmed(&build) {
        Output.Current
      } else {
        Output.Missing
      },
      built: run FileSystem.exists(&build),
      torn: false,
      moved: moved,
    }
  }

  /// A bay with only what a disk shows: a program is there or not, and a torn cache looks
  /// like any other.
  fn shown(self: &Self, context: &Bay) -> Bay {
    return Bay {
      source: context.source,
      output: if context.output == Output.Missing {
        Output.Missing
      } else {
        Output.Current
      },
      built: context.built,
      torn: false,
      moved: context.moved,
    }
  }

  /// The program that `silk run` ran must be the one of the source that is there: it prints
  /// the number of that source.
  effect fn sound(
    self: &Self,
    stage: &Stage,
    bench: &Bench,
    command: &Make,
    trail: &[Trail],
    outcome: &Outcome,
  ) -> List<Bytes>
    ! FileError | OutOfMemoryError
    ? &mut FileSystem | &mut Allocator {
    let mut wrong = List<Bytes>.make()
    let mut greets = false
    let mut at: usize = 0
    while at < trail.length {
      if let Trail.Says { note } = &trail[at] {
        if note == Note.Greeting {
          greets = true
        }
      }
      at = at + 1
    }
    if greets {
      let mut greeting = run Bytes.copy(b"Hello, ")
      run number(&mut greeting, stage.edits)
      run Bytes.append(&mut greeting, b"!")
      if !holds(outcome.output.asSlice(), greeting.asSlice()) {
        run word(&mut wrong, b"the program that ran is not the one of the source that is there")
      }
    }
    return move wrong
  }
}
