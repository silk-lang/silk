//! The walk the model checks and the plan share: where it starts, and what it tries.
//!
//! [`starts`] are the computers a walk begins on, and [`events`] is everything a user can type
//! and the world can answer. [`walked`] sends each event to each computer the machine reaches.

import Computer { Choice, Computer, Named, Pin, Pinned, Project, Store, Version }
import Footprint { Footprint }
import Silk { Silk, Typed }
import silk.collections.list { List }
import silk.machine.explore { Explorer, Walk }
import silk.machine.snapshot { Snapshot, Steps, TransitionLoopError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.schema.issue { SchemaError }

type Shot = Snapshot<Silk, Typed, Computer, Footprint>

/// The computers the walk starts from. Commands change what is installed, the default and the
/// pin, so the walk reaches those by itself. A start sets what no command changes.
pub effect fn starts() -> List<Shot>
  ! OutOfMemoryError | TransitionLoopError
  ? &mut Allocator {
  let mut shots = List<Shot>.make()

  // A new computer: nothing installed, no project.
  run List<Shot>.append(&mut shots, run Steps.begin<Silk, Typed, Computer, Footprint>(Computer.empty(), 0))

  // A package, automatic installs, and a compiler beside the tool.
  let mut packaged = Computer.empty()
  packaged.project = Project.Package
  packaged.autoInstall = true
  packaged.bundled = true
  run List<Shot>.append(&mut shots, run Steps.begin<Silk, Typed, Computer, Footprint>(move packaged, 0))

  // A workspace whose members pin one version, what an interrupted install left, and a
  // directory without a compiler.
  let mut workspace = Computer.empty()
  workspace.project = Project.Workspace
  workspace.pin = Pin { state: Pinned.Members, version: Choice.First }
  workspace.strays = true
  workspace.ignored = true
  workspace.debris = true
  workspace.second.store = Store.Damaged
  run List<Shot>.append(&mut shots, run Steps.begin<Silk, Typed, Computer, Footprint>(move workspace, 0))

  // SILK_TOOLCHAIN names a version, in a workspace whose members disagree.
  let mut overridden = Computer.empty()
  overridden.environment = Named.Second
  overridden.project = Project.Workspace
  overridden.pin = Pin { state: Pinned.Split, version: Choice.Nothing }
  run List<Shot>.append(&mut shots, run Steps.begin<Silk, Typed, Computer, Footprint>(move overridden, 0))

  // What stops a command early: no home, a SILK_TOOLCHAIN that is no version, a pin that is
  // no version.
  let mut homeless = Computer.empty()
  homeless.home = false
  homeless.project = Project.Package
  run List<Shot>.append(&mut shots, run Steps.begin<Silk, Typed, Computer, Footprint>(move homeless, 0))
  let mut malformed = Computer.empty()
  malformed.environment = Named.Malformed
  run List<Shot>.append(&mut shots, run Steps.begin<Silk, Typed, Computer, Footprint>(move malformed, 0))
  let mut unreadable = Computer.empty()
  unreadable.project = Project.Package
  unreadable.pin = Pin { state: Pinned.Unreadable, version: Choice.Nothing }
  run List<Shot>.append(&mut shots, run Steps.begin<Silk, Typed, Computer, Footprint>(move unreadable, 0))
  return move shots
}

/// Everything a user can type and the world can answer, about two versions.
pub effect fn events() -> List<Typed>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut all = List<Typed>.make()
  run List<Typed>.append(&mut all, Typed.Misuse)
  run List<Typed>.append(&mut all, Typed.Use { version: Version.First })
  run List<Typed>.append(&mut all, Typed.Use { version: Version.Second })
  run List<Typed>.append(&mut all, Typed.UseNewest { stable: true })
  run List<Typed>.append(&mut all, Typed.UsePinned)
  run List<Typed>.append(&mut all, Typed.List)
  run List<Typed>.append(&mut all, Typed.Which)
  run List<Typed>.append(&mut all, Typed.Uninstall { version: Version.First })
  run List<Typed>.append(&mut all, Typed.Uninstall { version: Version.Second })
  run List<Typed>.append(&mut all, Typed.Set { version: Version.First, install: true })
  run List<Typed>.append(&mut all, Typed.Set { version: Version.Second, install: true })
  run List<Typed>.append(&mut all, Typed.Set { version: Version.First, install: false })
  run List<Typed>.append(&mut all, Typed.SetNewest { stable: true, install: true })
  run List<Typed>.append(&mut all, Typed.SetNewest { stable: true, install: false })
  run List<Typed>.append(&mut all, Typed.UpdateSelf)
  run List<Typed>.append(&mut all, Typed.Run { asked: Named.Unset })
  run List<Typed>.append(&mut all, Typed.Run { asked: Named.Malformed })
  run List<Typed>.append(&mut all, Typed.Run { asked: Named.First })
  run List<Typed>.append(&mut all, Typed.Help { bare: false })
  run List<Typed>.append(&mut all, Typed.Help { bare: true })
  run List<Typed>.append(&mut all, Typed.Near)
  run List<Typed>.append(&mut all, Typed.Found)
  run List<Typed>.append(&mut all, Typed.Missing)
  run List<Typed>.append(&mut all, Typed.Newest { version: Version.First })
  run List<Typed>.append(&mut all, Typed.Newest { version: Version.Second })
  run List<Typed>.append(&mut all, Typed.NoStable)
  run List<Typed>.append(&mut all, Typed.NoReleases)
  run List<Typed>.append(&mut all, Typed.Unreachable)
  run List<Typed>.append(&mut all, Typed.Edited { respells: false })
  run List<Typed>.append(&mut all, Typed.Edited { respells: true })
  run List<Typed>.append(&mut all, Typed.Refused)
  run List<Typed>.append(&mut all, Typed.Arrived)
  run List<Typed>.append(&mut all, Typed.Cut)
  run List<Typed>.append(&mut all, Typed.Genuine)
  run List<Typed>.append(&mut all, Typed.Forged)
  run List<Typed>.append(&mut all, Typed.Placed)
  run List<Typed>.append(&mut all, Typed.Corrupt)
  run List<Typed>.append(&mut all, Typed.Blocked)
  run List<Typed>.append(&mut all, Typed.Started)
  run List<Typed>.append(&mut all, Typed.Stuck)
  run List<Typed>.append(&mut all, Typed.Outdated)
  run List<Typed>.append(&mut all, Typed.Current)
  run List<Typed>.append(&mut all, Typed.Replaced)
  run List<Typed>.append(&mut all, Typed.Told)
  run List<Typed>.append(&mut all, Typed.Silent)
  run List<Typed>.append(&mut all, Typed.Owned)
  run List<Typed>.append(&mut all, Typed.Unowned)
  return move all
}

/// Every state the tool can reach from [`starts`] with `events`.
///
/// # Errors
/// `SchemaError` and `TransitionLoopError` as `Explorer.walk` gives them. `OutOfMemoryError`.
pub effect fn walked(events: &[Typed]) -> Walk<Silk, Typed, Computer, Footprint>
  ! OutOfMemoryError | TransitionLoopError | SchemaError
  ? &mut Allocator {
  return run Explorer.walk<Silk, Typed, Computer, Footprint>(run starts(), events, 20000)
}
