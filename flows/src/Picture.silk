//! Pictures of directories, and what changed between two of them: [`Picture`] and [`Difference`].
//!
//! A run of the real tool takes a picture of the home directory and the project before a
//! command and one after it. The differences are everything the command did to the disk, and the
//! run compares them with the footprint the machine gives. A file that is in no footprint shows
//! here with its path, which is how a write nobody declared is caught.

import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u64
import silk.num.u8
import silk.num.usize
import silk.system.filesystem { DirectoryEntry, FileError, FileSystem, Path }

/// What one entry of a directory is.
pub enum Sort {
  File,
  Directory,
  /// A symbolic link. A picture does not follow it.
  Link,
  /// A socket, a named pipe or a device.
  Special,
}

/// One file or directory of a picture.
pub struct Entry {
  /// The path, with `/` between the names. It starts with the name the picture gives its root.
  pub path: Bytes,
  pub sort: Sort,
  /// The length of a file in bytes.
  pub size: usize,
  /// A hash of the content of a file.
  pub hash: u64,
}

/// Every file and directory below some roots, at one moment.
pub struct Picture {
  pub entries: List<Entry>,
}

/// How an entry differs between two pictures.
pub enum Change {
  /// It is only in the second picture.
  Created,
  /// It is a file in both, with another content, or it is another sort of entry.
  Changed,
  /// It is only in the first picture.
  Removed,
}

/// One entry that differs between two pictures.
pub struct Difference {
  pub path: Bytes,
  pub change: Change,
  /// Whether the entry is a directory, in the picture that has it.
  pub directory: bool,
}

// A hash of `bytes`. A file over 64 KiB is a program, which no command edits in place, so only
// its first bytes and every 1021st byte after them count.
fn hashed(bytes: &[u8]) -> u64 {
  let mut hash: u64 = 14695981039346656037
  let mut index: usize = 0
  while index < bytes.length {
    hash = u64.wrappingMultiply(u64.bitXor(hash, u8.toU64(bytes[index])), 1099511628211)
    let pace: usize = if index < 65536 { 1 } else { 1021 }
    index = index + pace
  }
  return hash
}

fn sorted(code: i32) -> Sort {
  if code == 0 {
    return Sort.File
  }
  if code == 1 {
    return Sort.Directory
  }
  if code == 2 {
    return Sort.Link
  }
  return Sort.Special
}

// The last name of `path`.
fn last(path: &[u8]) -> &[u8] {
  let mut start = path.length
  while start > 0 && path[start - 1] != 47 {
    start = start - 1
  }
  return Slice.view<u8>(path, start, path.length - start)
}

impl Picture {
  /// A picture of nothing.
  pub fn empty() -> Picture {
    return Picture { entries: List<Entry>.make() }
  }

  /// Adds everything below the directory `root` to the picture, under the name `label`. A root
  /// that does not exist adds nothing.
  ///
  /// # Errors
  /// `FileError` when a directory cannot be listed or a file cannot be read. `OutOfMemoryError`.
  pub effect fn add(self: &mut Self, label: &[u8], root: &Path) -> ()
    ! FileError | OutOfMemoryError
    ? &mut FileSystem | &mut Allocator {
    if !run FileSystem.exists(root) {
      return ()
    }
    return run self.below(label, root)
  }

  effect fn below(self: &mut Self, label: &[u8], directory: &Path) -> ()
    ! FileError | OutOfMemoryError
    ? &mut FileSystem | &mut Allocator {
    let listed = run FileSystem.listDirectory(directory)
    let children = List<DirectoryEntry>.asSlice(&listed)
    let mut at: usize = 0
    while at < children.length {
      let child = &children[at]
      let mut path = run Bytes.copy(label)
      run Bytes.append(&mut path, b"/")
      run Bytes.append(&mut path, last(Path.rawBytes(&child.path)))
      let sort = sorted(child.kind.code)
      let mut size: usize = 0
      let mut hash: u64 = 0
      if sort == Sort.File {
        let content = run FileSystem.readFile(&child.path)
        size = content.length()
        hash = hashed(content.asSlice())
      }
      let name = run Bytes.copy(path.asSlice())
      run List<Entry>.append(&mut self.entries, Entry { path: move path, sort: sort, size: size, hash: hash })
      if sort == Sort.Directory {
        run self.below(name.asSlice(), &child.path)
      }
      at = at + 1
    }
    return ()
  }

  // The position of the entry at `path`, or the number of entries.
  fn find(self: &Self, path: &[u8]) -> usize {
    let entries = self.entries.asSlice()
    let mut at: usize = 0
    while at < entries.length {
      if entries[at].path.asSlice() == path {
        return at
      }
      at = at + 1
    }
    return at
  }

  /// Whether the picture has an entry at `path`.
  pub fn has(self: &Self, path: &[u8]) -> bool {
    return self.find(path) < self.entries.length()
  }

  /// What differs from this picture to `after`: the entries that went away, then the ones
  /// that changed or came, each list in the order of its picture.
  pub effect fn differences(self: &Self, after: &Picture) -> List<Difference>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut found = List<Difference>.make()
    let old = self.entries.asSlice()
    let new = after.entries.asSlice()
    let mut at: usize = 0
    while at < old.length {
      if !after.has(old[at].path.asSlice()) {
        run List<Difference>.append(
          &mut found,
          Difference {
            path: run Bytes.copy(old[at].path.asSlice()),
            change: Change.Removed,
            directory: old[at].sort == Sort.Directory,
          },
        )
      }
      at = at + 1
    }
    at = 0
    while at < new.length {
      let before = self.find(new[at].path.asSlice())
      let mut change = Change.Created
      let mut differs = true
      if before < old.length {
        change = Change.Changed
        differs = old[before].sort != new[at].sort || old[before].size != new[at].size
          || old[before].hash != new[at].hash
      }
      if differs {
        run List<Difference>.append(
          &mut found,
          Difference {
            path: run Bytes.copy(new[at].path.asSlice()),
            change: change,
            directory: new[at].sort == Sort.Directory,
          },
        )
      }
      at = at + 1
    }
    return move found
  }
}
