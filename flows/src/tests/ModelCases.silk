//! The model checks: a walk over every state the tool can reach from a few computers.

import Computer { Choice, Computer, Named, Pin, Pinned, Project, Store, Version }
import Footprint { Footprint }
import Laws
import Silk { Silk, Typed }
import Stories { Story, stories }
import silk.machine.chart { Machines }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.machine.explore { Explorer }
import silk.machine.rules { Rules }
import silk.machine.snapshot { Snapshot, Steps, TransitionLoopError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.schema.issue { SchemaError }

type Shot = Snapshot<Silk, Typed, Computer, Footprint>

// The computers the walk starts from. Commands change what is installed, the default and the
// pin, so the walk reaches those by itself. A start sets what no command changes.
effect fn starts() -> List<Shot>
  ! OutOfMemoryError | TransitionLoopError
  ? &mut Allocator {
  let mut shots = List<Shot>.make()

  // A new computer: nothing installed, no project.
  run List<Shot>.append(&mut shots, run Steps.begin<Silk, Typed, Computer, Footprint>(Computer.empty(), 0))

  // A package, automatic installs, and a compiler beside the tool.
  let mut packaged = Computer.empty()
  packaged.project = Project.Package
  packaged.autoInstall = true
  packaged.bundled = true
  run List<Shot>.append(&mut shots, run Steps.begin<Silk, Typed, Computer, Footprint>(move packaged, 0))

  // A workspace whose members pin one version, what an interrupted install left, and a
  // directory without a compiler.
  let mut workspace = Computer.empty()
  workspace.project = Project.Workspace
  workspace.pin = Pin { state: Pinned.Members, version: Choice.First }
  workspace.strays = true
  workspace.ignored = true
  workspace.debris = true
  workspace.second.store = Store.Damaged
  run List<Shot>.append(&mut shots, run Steps.begin<Silk, Typed, Computer, Footprint>(move workspace, 0))

  // SILK_TOOLCHAIN names a version, in a workspace whose members disagree.
  let mut overridden = Computer.empty()
  overridden.environment = Named.Second
  overridden.project = Project.Workspace
  overridden.pin = Pin { state: Pinned.Split, version: Choice.Nothing }
  run List<Shot>.append(&mut shots, run Steps.begin<Silk, Typed, Computer, Footprint>(move overridden, 0))

  // What stops a command early: no home, a SILK_TOOLCHAIN that is no version, a pin that is
  // no version.
  let mut homeless = Computer.empty()
  homeless.home = false
  homeless.project = Project.Package
  run List<Shot>.append(&mut shots, run Steps.begin<Silk, Typed, Computer, Footprint>(move homeless, 0))
  let mut malformed = Computer.empty()
  malformed.environment = Named.Malformed
  run List<Shot>.append(&mut shots, run Steps.begin<Silk, Typed, Computer, Footprint>(move malformed, 0))
  let mut unreadable = Computer.empty()
  unreadable.project = Project.Package
  unreadable.pin = Pin { state: Pinned.Unreadable, version: Choice.Nothing }
  run List<Shot>.append(&mut shots, run Steps.begin<Silk, Typed, Computer, Footprint>(move unreadable, 0))
  return move shots
}

effect fn checked() -> ()
  ! OutOfMemoryError | TransitionLoopError | SchemaError
  ? &mut Allocator {
  // Everything a user can type and the world can answer, about two versions.
  let events: [Typed; 47] = [
    Typed.Misuse,
    Typed.Use { version: Version.First },
    Typed.Use { version: Version.Second },
    Typed.UseNewest { stable: true },
    Typed.UsePinned,
    Typed.List,
    Typed.Which,
    Typed.Uninstall { version: Version.First },
    Typed.Uninstall { version: Version.Second },
    Typed.Set { version: Version.First, install: true },
    Typed.Set { version: Version.Second, install: true },
    Typed.Set { version: Version.First, install: false },
    Typed.SetNewest { stable: true, install: true },
    Typed.SetNewest { stable: true, install: false },
    Typed.UpdateSelf,
    Typed.Run { asked: Named.Unset },
    Typed.Run { asked: Named.Malformed },
    Typed.Run { asked: Named.First },
    Typed.Help { bare: false },
    Typed.Help { bare: true },
    Typed.Near,
    Typed.Found,
    Typed.Missing,
    Typed.Newest { version: Version.First },
    Typed.Newest { version: Version.Second },
    Typed.NoStable,
    Typed.NoReleases,
    Typed.Unreachable,
    Typed.Edited { respells: false },
    Typed.Edited { respells: true },
    Typed.Refused,
    Typed.Arrived,
    Typed.Cut,
    Typed.Genuine,
    Typed.Forged,
    Typed.Placed,
    Typed.Corrupt,
    Typed.Blocked,
    Typed.Started,
    Typed.Stuck,
    Typed.Outdated,
    Typed.Current,
    Typed.Replaced,
    Typed.Told,
    Typed.Silent,
    Typed.Owned,
    Typed.Unowned,
  ]
  let walk = run Explorer.walk<Silk, Typed, Computer, Footprint>(run starts(), &events, 20000)
  if !walk.complete {
    Intrinsic.trap("the walk ends")
  }

  // No state leaves a command or an answer without a row.
  let holes = run walk.holes()
  if holes.length() != 0 {
    Intrinsic.trap("no holes")
  }

  // `Ready` is passed through and never rested in, so no snapshot shows it.
  let unreached = run walk.unreached()
  if unreached.length() != 1 || unreached.asSlice()[0] != "Silk.Ready" {
    Intrinsic.trap("every state is reached")
  }
  let stuck = run walk.stuck()
  if stuck.length() != 0 {
    Intrinsic.trap("nothing is stuck")
  }

  // Every command ends, whatever the world answers.
  let runs = run walk.runs(12)
  let mut index: usize = 0
  while index < runs.length() {
    if !runs.asSlice()[index].settled {
      Intrinsic.trap("every command ends")
    }
    index = index + 1
  }
  let broken = run Rules<Typed, Computer, Footprint>.broken<Silk>(Laws.laws(), &walk, runs.asSlice(), &events)
  if broken.length() != 0 {
    Intrinsic.trap(broken.asSlice()[0].reason)
  }
  return ()
}

test effect fn everyStateKeepsTheLaws()
  ! OutOfMemoryError | TransitionLoopError | SchemaError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checked() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Every event of every story is one the machine takes where it stands, and the story ends with
// no command in progress.
effect fn replayed() -> ()
  ! OutOfMemoryError | TransitionLoopError
  ? &mut Allocator {
  let mut told = run stories()
  while told.length() != 0 {
    let mut story = List<Story>.remove(&mut told, 0)
    let mut shot = run Steps.begin<Silk, Typed, Computer, Footprint>(move story.start, 0)
    while story.events.length() != 0 {
      let event = List<Typed>.remove(&mut story.events, 0)
      let waits = Machines.awaiting<Silk, Typed, Computer, Footprint>(&shot.value)
      if waits != Machines.isAnswer<Silk, Typed, Computer, Footprint>(&event) {
        Intrinsic.trap(story.name)
      }
      if waits && !Machines.awaits<Silk, Typed, Computer, Footprint>(&shot.value, &event) {
        Intrinsic.trap(story.name)
      }
      if !run Steps.send<Silk, Typed, Computer, Footprint>(&mut shot, move event) {
        Intrinsic.trap(story.name)
      }
    }
    if Machines.awaiting<Silk, Typed, Computer, Footprint>(&shot.value) {
      Intrinsic.trap(story.name)
    }
  }
  return ()
}

test effect fn everyStoryIsAPathOfTheMachine()
  ! OutOfMemoryError | TransitionLoopError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run replayed() |> Effect.provideMut<Allocator>(&mut allocator)
}
