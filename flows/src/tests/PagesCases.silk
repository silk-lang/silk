//! The checks of the pages made from the machine.

import Pages
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }

// Every command, answer, message and place of the chart has its phrase in `Pages`: a new one
// without a phrase shows on the page as text that says so.
test effect fn everyRowOfTheChartHasItsWords()
  ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let page = run Pages.commands() |> Effect.provideMut<Allocator>(&mut allocator)
  let text = page.asSlice()
  let part = b"no phrase in Pages.silk"
  let mut at: usize = 0
  while at + part.length <= text.length {
    if Slice.view<u8>(text, at, part.length) == part {
      Intrinsic.trap("a row of the chart has no phrase in Pages.silk")
    }
    at = at + 1
  }
  if text.length < 10000 {
    Intrinsic.trap("the page has a table for each command")
  }
  return ()
}
