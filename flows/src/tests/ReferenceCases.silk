//! The model checks of the reference machines: a walk over every state each one can reach.

import ProjectFlow { Creating, Site, Start }
import ProjectFlow as Projects
import Trail { Trail }
import Trips { trips }
import silk.core.effect { Effect }
import silk.machine.explore { Explorer }
import silk.machine.rules { Rules }
import silk.machine.snapshot { TransitionLoopError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.schema.issue { SchemaError }

effect fn project() -> ()
  ! OutOfMemoryError | TransitionLoopError | SchemaError
  ? &mut Allocator {
  let tried = run Projects.events()
  let events = tried.asSlice()
  let walk = run Explorer.walk<Creating, Start, Site, Trail>(run Projects.starts(), events, 2000)
  if !walk.complete {
    Intrinsic.trap("the walk ends")
  }
  if (run walk.holes()).length() != 0 {
    Intrinsic.trap("no holes")
  }
  if (run walk.unreached()).length() != 0 {
    Intrinsic.trap("every state is reached")
  }
  if (run walk.stuck()).length() != 0 {
    Intrinsic.trap("nothing is stuck")
  }
  let runs = run walk.runs(12)
  let mut index: usize = 0
  while index < runs.length() {
    if !runs.asSlice()[index].settled {
      Intrinsic.trap("every command ends")
    }
    index = index + 1
  }
  let broken = run Rules<Start, Site, Trail>.broken<Creating>(Projects.laws(), &walk, runs.asSlice(), events)
  if broken.length() != 0 {
    Intrinsic.trap(broken.asSlice()[0].reason)
  }
  let paths = run trips<Creating, Start, Site, Trail>(&walk, events, 4, "project")
  if paths.length() < 10 {
    Intrinsic.trap("every way a command goes has a trip")
  }
  return ()
}

test effect fn silkInitKeepsItsLaws()
  ! OutOfMemoryError | TransitionLoopError | SchemaError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run project() |> Effect.provideMut<Allocator>(&mut allocator)
}
