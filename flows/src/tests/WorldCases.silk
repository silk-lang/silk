//! The checks of the local world: what a run of the real tool compares.

import Computer { Choice, Computer, Pin, Pinned, Project }
import Footprint { Footprint, Message }
import Picture { Picture }
import Plan { Move }
import Silk { Typed }
import World { Outcome, judged, shown }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.system.filesystem_machine { MachineFileSystem }
import silk.text.string { String }

fn holds(text: &[u8], part: &[u8]) -> bool {
  let mut at: usize = 0
  while at + part.length <= text.length {
    if Slice.view<u8>(text, at, part.length) == part {
      return true
    }
    at = at + 1
  }
  return false
}

// `silk use list` on a computer with nothing: it prints the versions and ends with 0.
effect fn listing() -> Move
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut footprint = List<Footprint>.make()
  run List<Footprint>.append(&mut footprint, Footprint.Says { message: Message.Versions })
  run List<Footprint>.append(&mut footprint, Footprint.Exits { status: 0 })
  return Move {
    command: Typed.List,
    answers: List<Typed>.make(),
    footprint: move footprint,
    state: Computer.empty(),
    reasons: List<String>.make(),
  }
}

// A command that leaves its footprint passes. The same command with one more file fails, and the
// line names the file.
effect fn planted() -> ()
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let directory = run FileSystem.createTemporaryDirectory(&run Path.make("/tmp"), b"flows-test")
  let home = run Path.join(&directory, "home")
  run FileSystem.createDirectoriesRecursively(&home)
  run FileSystem.writeFile(&run Path.join(&home, "settings.toml"), b"default = \"1.0.0\"\n")
  let step = run listing()
  let outcome = Outcome {
    status: 0,
    output: run Bytes.copy(b"No Silk versions are installed.\n"),
    errors: Bytes.make(),
  }
  let mut before = Picture.empty()
  run before.add(b"home", &home)
  let mut same = Picture.empty()
  run same.add(b"home", &home)
  let nothing = run before.differences(&same)
  let clean = run judged(&step, &outcome, nothing.asSlice(), &[])
  if clean.length() != 0 {
    Intrinsic.trap("a command that leaves its footprint passes")
  }

  run FileSystem.writeFile(&run Path.join(&home, "stray.txt"), b"nobody declared this file\n")
  let mut after = Picture.empty()
  run after.add(b"home", &home)
  let differences = run before.differences(&after)
  let wrong = run judged(&step, &outcome, differences.asSlice(), &[])
  run FileSystem.removeDirectoryRecursively(&directory)
  if wrong.length() != 1 || !holds(wrong.asSlice()[0].asSlice(), b"home/stray.txt") {
    Intrinsic.trap("a planted file fails the step with its path named")
  }

  // The default changed and no footprint lists it.
  let silent = Outcome { status: 3, output: Bytes.make(), errors: Bytes.make() }
  let loud = run judged(&step, &silent, nothing.asSlice(), &[])
  if loud.length() != 2 {
    Intrinsic.trap("another exit status and a missing message are two lines")
  }
  return ()
}

test effect fn aPlantedFileFailsTheStepWithItsPath()
  ! FileError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut files = run MachineFileSystem.make() |> Effect.provideMut<Allocator>(&mut allocator)
  return run planted()
    |> Effect.provideMut<FileSystem>(&mut files)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

// The machine keeps facts apart that one disk shows as one.
test fn aDiskShowsOneComputerForFactsItCannotTellApart() {
  let mut members = Computer.empty()
  members.project = Project.Workspace
  members.pin = Pin { state: Pinned.Members, version: Choice.First }
  members.ignored = true
  let plain = shown(&members)
  if !plain.strays || plain.ignored {
    Intrinsic.trap("members that pin a version have pins of their own, and none is passed over")
  }
  let mut homeless = Computer.empty()
  homeless.home = false
  homeless.standard = Choice.First
  if shown(&homeless).standard != Choice.Nothing {
    Intrinsic.trap("without a home directory there is no default")
  }
}
