//! The dependencies of a package as a machine: [`Depending`] is where a command stands,
//! [`Ask`] is what the user types and what the world answers, and [`Shelves`] is what the
//! package lists and what the archive store of the home directory holds.
//!
//! This machine is a reference. The compiler does not run it: a run of the real compiler is
//! compared with it, and a disagreement is a bug in the compiler or a wrong row here.
//!
//! The package of the machine is `app`, whose source imports a module of the library `shelf`.
//! `shelf` is a directory beside the package, and also an archive at a URL. A dependency on the
//! directory needs nothing else. A dependency on the archive needs the archive in the store,
//! and a command that needs it there fetches it, unless `SILK_OFFLINE` is set.

import Trail { Note, Spot, Trail }
import silk.build.events { Fetch, Work }
import silk.collections.list { List }
import silk.machine.chart { Chart, Enqueue, Guards, Machine, Next }
import silk.machine.rules { Rules }
import silk.machine.snapshot { Snapshot, Steps, TransitionLoopError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.schema.schema { Schema }

/// Where one command stands. Every state but `Settled` waits for the world.
pub union Depending {
  /// No command runs.
  Settled,
  /// `silk add` fetches the archive, to learn its name and its SHA-256.
  Adding,
  /// `silk fetch` fetches the archive.
  Fetching,
  /// `silk check` fetches the archive before it checks.
  Checking,
}

/// What `silk add <url>` says of the SHA-256 of the archive.
pub enum Sum {
  /// No `--sha256`.
  Unstated,
  /// `--sha256` with the SHA-256 the archive has.
  Right,
  /// `--sha256` with another one.
  Wrong,
}

/// What the user types, what the user does, and what the world answers.
pub union Ask {
  /// `silk add <directory>`, for the directory of `shelf`.
  AddPath,
  /// `silk add <directory>`, for a directory without a `silk.toml`.
  AddMissing,
  /// `silk add <url>`, for the archive of `shelf`.
  AddArchive { pub sum: Sum },
  /// `silk add <url>` with `SILK_OFFLINE` set.
  AddOffline,
  /// `silk remove shelf`.
  Remove,
  /// `silk fetch`.
  Fetch,
  /// `silk fetch` with `SILK_OFFLINE` set.
  FetchOffline,
  /// `silk check`.
  Check,
  /// `silk check` with `SILK_OFFLINE` set.
  CheckOffline,
  /// The user empties the archive store.
  Purge,
  /// The world: the archive arrived.
  Arrived,
  /// The world: the URL of the archive gives nothing.
  Lost,
}

/// What the package lists for `shelf`.
pub enum Listed {
  /// No dependency.
  Nothing,
  /// The directory.
  Path,
  /// The archive, with its URL and its SHA-256.
  Archive,
}

/// What a command that runs is going to list.
pub enum Asked {
  /// No command runs, or one that lists nothing new.
  Same,
  /// `silk add <directory>`.
  Path,
  /// `silk add <url>`.
  Archive,
  /// `silk remove`.
  Nothing,
}

/// The dependency of the package, and the archive store.
pub struct Shelves {
  pub listed: Listed,
  /// Whether the archive of `shelf` is in the archive store.
  pub stored: bool,
  /// What the command that runs is going to list. `Asked.Same` when none runs.
  pub asked: Asked,
  /// What the `silk add <url>` that runs says of the SHA-256. `Sum.Unstated` when none runs.
  pub sum: Sum,
}

impl Schema for Depending {}

impl Schema for Sum {}

impl Schema for Ask {}

impl Schema for Listed {}

impl Schema for Asked {}

impl Schema for Shelves {}

impl Shelves {
  /// A package that lists `listed`, with the archive in the store when `stored` is true, and
  /// no command running.
  pub fn of(listed: Listed, stored: bool) -> Shelves {
    return Shelves { listed: listed, stored: stored, asked: Asked.Same, sum: Sum.Unstated }
  }
}

fn has(shelves: &Shelves, event: &Ask) -> bool {
  return shelves.listed != Listed.Nothing
}

fn lacks(shelves: &Shelves, event: &Ask) -> bool {
  return shelves.listed == Listed.Nothing
}

fn needs(shelves: &Shelves, event: &Ask) -> bool {
  return shelves.listed == Listed.Archive && !shelves.stored
}

fn another(shelves: &Shelves, event: &Ask) -> bool {
  return shelves.sum == Sum.Wrong
}

fn stored(shelves: &Shelves, event: &Ask) -> bool {
  return shelves.stored
}

fn unstored(shelves: &Shelves) -> bool {
  return !shelves.stored
}

fn wrongSum(shelves: &Shelves, event: &Ask) -> bool {
  return match &event.* {
    Ask.AddArchive { sum } => sum == Sum.Wrong
    _ => false
  }
}

type Rows = Chart<Depending, Ask, Shelves, Trail>

// What a row leaves that ends the command with one message.
static fn ending(chart: Rows, note: Note, status: u8) -> Rows {
  return chart |> Chart.leaves(&[Trail.Says { note: note }, Trail.Exits { status: status }])
}

// What a row leaves when the check runs and the module of `shelf` is found.
static fn checked(chart: Rows) -> Rows {
  return chart
    |> Chart.leaves(
      &[
        Trail.Does { work: Work.Check },
        Trail.Changes { spot: Spot.Cache },
        Trail.Says { note: Note.Finished },
        Trail.Exits { status: 0 },
      ],
    )
}

// The rows of a check that needs no fetch, for the event `event`.
static fn checks(chart: Rows, event: Intrinsic.VariantName<Ask>) -> Rows {
  return chart
    |> Chart.stayWhen("Settled", event, Guards.named("the package lists no dependency", lacks))
    |> Chart.leaves(
      &[
        Trail.Does { work: Work.Check },
        Trail.Changes { spot: Spot.Cache },
        Trail.Says { note: Note.Diagnostic },
        Trail.Says { note: Note.Failed },
        Trail.Exits { status: 1 },
      ],
    )
    |> Chart.stay("Settled", event)
    |> checked()
}

// What a row leaves when the archive cannot be had and the command is a check.
static fn unchecked(chart: Rows, note: Note) -> Rows {
  return chart
    |> Chart.leaves(
      &[Trail.Says { note: note }, Trail.Says { note: Note.Failed }, Trail.Exits { status: 2 }],
    )
}

impl Machine<Ask, Shelves, Trail> for Depending {
  static fn chart() -> Chart<Depending, Ask, Shelves, Trail> {
    return Chart<Depending, Ask, Shelves, Trail>.of()
      |> Chart.initial(Depending.Settled)

      // silk add <directory>
      |> Chart.refuse("Settled", "AddMissing", "a directory without a manifest is no package")
      |> ending(Note.Unreadable, 2)
      |> Chart.refuseWhen(
        "Settled",
        "AddPath",
        Guards.named("the package lists the dependency", has),
        "a name is listed once",
      )
      |> ending(Note.Duplicate, 2)
      |> Chart.stay("Settled", "AddPath")
      |> Chart.leaves(&[Trail.Changes { spot: Spot.Manifest }])
      |> ending(Note.Added, 0)

      // silk add <url>
      |> Chart.refuse(
        "Settled",
        "AddOffline",
        "SILK_OFFLINE forbids the fetch that names the archive",
      )
      |> Chart.leaves(&[Trail.Says { note: Note.CannotFetch }])
      |> ending(Note.Offline, 2)
      |> Chart.on("Settled", "AddArchive", Depending.Adding)
      |> Chart.leaves(&[Trail.Fetches { source: Fetch.Archive }])
      |> Chart.awaits("Adding", "Arrived")
      |> Chart.awaits("Adding", "Lost")
      |> Chart.on("Adding", "Lost", Depending.Settled)
      |> ending(Note.CannotFetch, 2)
      |> Chart.onWhen(
        "Adding",
        "Arrived",
        Depending.Settled,
        Guards.named("the archive is not the one --sha256 names", another),
      )
      |> ending(Note.Mismatch, 2)
      |> Chart.onWhen(
        "Adding",
        "Arrived",
        Depending.Settled,
        Guards.named("the package lists the dependency", has),
      )
      |> Chart.leavesWhen(
        Guards.named("the archive is not in the store", unstored),
        &[Trail.Creates { spot: Spot.Archive }],
      )
      |> ending(Note.Duplicate, 2)
      |> Chart.on("Adding", "Arrived", Depending.Settled)
      |> Chart.leavesWhen(
        Guards.named("the archive is not in the store", unstored),
        &[Trail.Creates { spot: Spot.Archive }],
      )
      |> Chart.leaves(&[Trail.Changes { spot: Spot.Manifest }])
      |> ending(Note.Added, 0)

      // silk remove
      |> Chart.refuseWhen(
        "Settled",
        "Remove",
        Guards.named("the package lists no dependency", lacks),
        "there is nothing to remove",
      )
      |> ending(Note.NoSuch, 2)
      |> Chart.stay("Settled", "Remove")
      |> Chart.leaves(&[Trail.Changes { spot: Spot.Manifest }])
      |> ending(Note.Dropped, 0)

      // silk fetch
      |> Chart.onWhen(
        "Settled",
        "Fetch",
        Depending.Fetching,
        Guards.named("the archive is listed and not in the store", needs),
      )
      |> Chart.leaves(&[Trail.Fetches { source: Fetch.Archive }])
      |> Chart.stay("Settled", "Fetch")
      |> Chart.leaves(&[Trail.Exits { status: 0 }])
      |> Chart.awaits("Fetching", "Arrived")
      |> Chart.awaits("Fetching", "Lost")
      |> Chart.on("Fetching", "Arrived", Depending.Settled)
      |> Chart.leaves(&[Trail.Creates { spot: Spot.Archive }, Trail.Exits { status: 0 }])
      |> Chart.on("Fetching", "Lost", Depending.Settled)
      |> ending(Note.CannotFetch, 2)
      |> Chart.refuseWhen(
        "Settled",
        "FetchOffline",
        Guards.named("the archive is listed and not in the store", needs),
        "SILK_OFFLINE forbids the fetch",
      )
      |> ending(Note.Offline, 2)
      |> Chart.stay("Settled", "FetchOffline")
      |> Chart.leaves(&[Trail.Exits { status: 0 }])

      // silk check
      |> Chart.onWhen(
        "Settled",
        "Check",
        Depending.Checking,
        Guards.named("the archive is listed and not in the store", needs),
      )
      |> Chart.leaves(&[Trail.Fetches { source: Fetch.Archive }])
      |> checks("Check")
      |> Chart.awaits("Checking", "Arrived")
      |> Chart.awaits("Checking", "Lost")
      |> Chart.on("Checking", "Arrived", Depending.Settled)
      |> Chart.leaves(&[Trail.Creates { spot: Spot.Archive }])
      |> checked()
      |> Chart.on("Checking", "Lost", Depending.Settled)
      |> unchecked(Note.CannotFetch)
      |> Chart.refuseWhen(
        "Settled",
        "CheckOffline",
        Guards.named("the archive is listed and not in the store", needs),
        "SILK_OFFLINE forbids the fetch",
      )
      |> unchecked(Note.Offline)
      |> checks("CheckOffline")

      // The user empties the archive store.
      |> Chart.stayWhen("Settled", "Purge", Guards.named("the archive is in the store", stored))
      |> Chart.leaves(&[Trail.Removes { spot: Spot.Archive }])
      |> Chart.stay("Settled", "Purge")
  }

  // Notes what the command is going to list, so the rows that follow know.
  effect fn handle(
    state: &Depending,
    context: &mut Shelves,
    event: &Ask,
    enq: &mut Enqueue<Ask, Trail>,
  ) -> Next<Depending>
    ! OutOfMemoryError
    ? &mut Allocator {
    match &event.* {
      Ask.AddPath => {
        context.asked = Asked.Path
      }
      Ask.AddArchive { sum } => {
        context.asked = Asked.Archive
        context.sum = sum
      }
      Ask.Remove => {
        context.asked = Asked.Nothing
      }
      _ => {}
    }
    return Next<Depending>.Pass
  }

  // The package and the store after one effect of a row.
  fn absorb(state: &Depending, context: &mut Shelves, effect_: &Trail) -> () {
    match &effect_.* {
      Trail.Changes { spot } => {
        if spot == Spot.Manifest {
          context.listed = match context.asked {
            Asked.Same => context.listed
            Asked.Path => Listed.Path
            Asked.Archive => Listed.Archive
            Asked.Nothing => Listed.Nothing
          }
        }
      }
      Trail.Creates { spot } => {
        if spot == Spot.Archive {
          context.stored = true
        }
      }
      Trail.Removes { spot } => {
        if spot == Spot.Archive {
          context.stored = false
        }
      }

      // The process ends, and what it kept in mind is gone.
      Trail.Exits { .. } => {
        context.asked = Asked.Same
        context.sum = Sum.Unstated
      }
      _ => {}
    }
    return ()
  }
}

type Laws = Rules<Ask, Shelves, Trail>

// `event` fetches nothing.
static fn fetchesNothing(laws: Laws, event: Intrinsic.VariantName<Ask>) -> Laws {
  return laws
    |> Rules.never(
      event,
      Trail.Fetches { source: Fetch.Archive },
      "SILK_OFFLINE forbids every fetch",
    )
}

// `event` leaves the manifest as it is.
static fn keepsManifest(laws: Laws, event: Intrinsic.VariantName<Ask>) -> Laws {
  return laws
    |> Rules.never(
      event,
      Trail.Changes { spot: Spot.Manifest },
      "only silk add and silk remove edit the manifest",
    )
}

/// The promises the dependency commands keep on every path, each with its reason.
pub static fn laws() -> Rules<Ask, Shelves, Trail> {
  return Rules<Ask, Shelves, Trail>.of()
    |> fetchesNothing("AddOffline")
    |> fetchesNothing("FetchOffline")
    |> fetchesNothing("CheckOffline")
    |> keepsManifest("AddMissing")
    |> keepsManifest("AddOffline")
    |> keepsManifest("Fetch")
    |> keepsManifest("FetchOffline")
    |> keepsManifest("Check")
    |> keepsManifest("CheckOffline")
    |> Rules.neverWhen(
      "AddArchive",
      wrongSum,
      Trail.Changes { spot: Spot.Manifest },
      "an archive that is not the expected one is not listed",
    )
    |> Rules.neverWhen(
      "AddArchive",
      wrongSum,
      Trail.Creates { spot: Spot.Archive },
      "an archive that is not the expected one is not kept",
    )
    |> Rules.never(
      "Remove",
      Trail.Removes { spot: Spot.Archive },
      "the store keeps an archive for the next package that lists it",
    )
    |> Rules.neverAny(Trail.Changes { spot: Spot.Sources }, "no dependency command edits a source")
}

type Shot = Snapshot<Depending, Ask, Shelves, Trail>

/// The package a walk starts from, and a run sets up: no dependency, and an empty store.
///
/// # Errors
/// `TransitionLoopError` as `Steps.begin` gives it. `OutOfMemoryError`.
pub effect fn starts() -> List<Shot>
  ! OutOfMemoryError | TransitionLoopError
  ? &mut Allocator {
  let mut shots = List<Shot>.make()
  run List<Shot>.append(
    &mut shots,
    run Steps.begin<Depending, Ask, Shelves, Trail>(Shelves.of(Listed.Nothing, false), 0),
  )
  return move shots
}

/// Everything a user can type or do, and the world can answer.
///
/// # Errors
/// `OutOfMemoryError`.
pub effect fn events() -> List<Ask>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut all = List<Ask>.make()
  run List<Ask>.append(&mut all, Ask.AddPath)
  run List<Ask>.append(&mut all, Ask.AddMissing)
  run List<Ask>.append(&mut all, Ask.AddArchive { sum: Sum.Unstated })
  run List<Ask>.append(&mut all, Ask.AddArchive { sum: Sum.Right })
  run List<Ask>.append(&mut all, Ask.AddArchive { sum: Sum.Wrong })
  run List<Ask>.append(&mut all, Ask.AddOffline)
  run List<Ask>.append(&mut all, Ask.Remove)
  run List<Ask>.append(&mut all, Ask.Fetch)
  run List<Ask>.append(&mut all, Ask.FetchOffline)
  run List<Ask>.append(&mut all, Ask.Check)
  run List<Ask>.append(&mut all, Ask.CheckOffline)
  run List<Ask>.append(&mut all, Ask.Purge)
  run List<Ask>.append(&mut all, Ask.Arrived)
  run List<Ask>.append(&mut all, Ask.Lost)
  return move all
}
