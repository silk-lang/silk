//! The binding of the machine of the check server, `ServerFlow`, to the local world.
//!
//! The package of a trip is the directory `app` below the work directory. Every command of a
//! trip runs with `SILK_CHECK_SERVER_IDLE` set to eight seconds, so a check server leaves soon
//! after the last command asked it, and a trip can wait for that.

import Bench { Bench, Binding, Stage }
import ServerFlow { Call, Desk }
import Trail { Trail }
import World { Outcome }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u8
import silk.num.usize
import silk.system.child_process { ChildProcess, ProcessError }
import silk.system.filesystem { DirectoryEntry, FileError, FileSystem, Path }

/// The binding of `ServerFlow`. It has no fields, because a stage holds everything of a trip.
pub struct ServerBinding {}

fn holds(text: &[u8], part: &[u8]) -> bool {
  let mut at: usize = 0
  while at + part.length <= text.length {
    if Slice.view<u8>(text, at, part.length) == part {
      return true
    }
    at = at + 1
  }
  return false
}

effect fn word(words: &mut List<Bytes>, text: &[u8]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  return run List<Bytes>.append(&mut words.*, run Bytes.copy(text))
}

effect fn number(text: &mut Bytes, value: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if value >= 10 {
    run number(&mut text.*, value / 10)
  }
  let digit: [u8; 1] = [usize.toU8(value % 10) + 48]
  return run Bytes.append(&mut text.*, &digit)
}

// Writes the source number `stage.edits` of the trip, with a type error when `broken` is true.
effect fn write(stage: &Stage, broken: bool) -> ()
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut text = run Bytes.copy(b"pub fn main() -> i32 {\n  return ")
  if broken {
    run Bytes.append(&mut text, b"\"source ")
    run number(&mut text, stage.edits)
    run Bytes.append(&mut text, b"\"")
  } else {
    run number(&mut text, stage.edits)
    run Bytes.append(&mut text, b" - ")
    run number(&mut text, stage.edits)
  }
  run Bytes.append(&mut text, b"\n}\n")
  return run FileSystem.writeFile(&run Path.join(&stage.work, "app/src/main.silk"), text.asSlice())
}

// Writes the manifest of the package, with the description number `stage.edits`.
effect fn manifest(stage: &Stage, bench: &Bench) -> ()
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut text = run Bytes.copy(
    b"[package]\nname = \"app\"\nversion = \"0.1.0\"\ndescription = \"The package of a trip, shape ",
  )
  run number(&mut text, stage.edits)
  run Bytes.append(&mut text, b"\"\n")
  run Bytes.append(&mut text, (run bench.pin()).asSlice())
  return run FileSystem.writeFile(&run Path.join(&stage.work, "app/silk.toml"), text.asSlice())
}

impl Binding<Call, Desk> for ServerBinding {
  /// Writes the package `app` with its first source. Every trip starts there, so `start` adds
  /// nothing.
  effect fn arrange(self: &Self, stage: &mut Stage, bench: &Bench, start: &Desk) -> ()
    ! FileError | ProcessError | OutOfMemoryError
    ? &mut FileSystem | &mut ChildProcess | &mut Allocator {
    stage.inside = b"app"
    run FileSystem.createDirectoriesRecursively(&run Path.join(&stage.work, "app/src"))
    run manifest(&stage.*, bench)
    return run write(&stage.*, false)
  }

  /// The words of `command`, or what the user does: a new source for `Call.Edit` and
  /// `Call.Break`, a new manifest and nine seconds of nothing for `Call.Reshape`, and nine
  /// seconds of nothing for `Call.Wait`, which is longer than a check server of a trip stays.
  effect fn act(
    self: &Self,
    stage: &mut Stage,
    bench: &Bench,
    command: &Call,
    answers: &[Call],
  ) -> List<Bytes>
    ! FileError | ProcessError | OutOfMemoryError
    ? &mut FileSystem | &mut ChildProcess | &mut Allocator {
    let mut words = List<Bytes>.make()
    match &command.* {
      Call.Check => {
        run word(&mut words, b"check")
      }
      Call.CheckAlone => {
        run word(&mut words, b"check")
        run word(&mut words, b"--no-server")
      }
      Call.Clean => {
        run word(&mut words, b"clean")
      }
      Call.Edit => {
        stage.edits = stage.edits + 1
        run write(&stage.*, false)
      }
      Call.Break => {
        stage.edits = stage.edits + 1
        run write(&stage.*, true)
      }
      Call.Reshape => {
        stage.edits = stage.edits + 1
        run manifest(&stage.*, bench)
        run bench.pause(b"9")
        run stage.quiet()
      }
      Call.Wait => {
        run bench.pause(b"9")
        run stage.quiet()
      }
    }
    return move words
  }

  /// Whether the source has a type error, whether there is a build directory, and whether the
  /// directory of the socket holds one.
  effect fn observed(self: &Self, stage: &Stage, bench: &Bench) -> Desk
    ! FileError | OutOfMemoryError
    ? &mut FileSystem | &mut Allocator {
    let text = run FileSystem.readFile(&run Path.join(&stage.work, "app/src/main.silk"))
    let sockets = run FileSystem.listDirectory(&stage.runtime)
    return Desk {
      broken: holds(text.asSlice(), b"return \""),
      kept: run FileSystem.exists(&run Path.join(&stage.work, "app/build")),
      serving: List<DirectoryEntry>.asSlice(&sockets).length != 0,
      answered: false,
    }
  }

  /// A desk with only what a disk shows: a server that answered a check looks like any other.
  fn shown(self: &Self, context: &Desk) -> Desk {
    return Desk {
      broken: context.broken,
      kept: context.kept,
      serving: context.serving,
      answered: false,
    }
  }

  /// The trail says everything of a check, so nothing more is looked at.
  effect fn sound(
    self: &Self,
    stage: &Stage,
    bench: &Bench,
    command: &Call,
    trail: &[Trail],
    outcome: &Outcome,
  ) -> List<Bytes>
    ! FileError | OutOfMemoryError
    ? &mut FileSystem | &mut Allocator {
    return List<Bytes>.make()
  }
}
