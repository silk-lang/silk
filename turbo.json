{
  "$schema": "https://turborepo.com/schema.json",
  "globalPassThroughEnv": ["NODE_OPTIONS", "VITEST_MAX_WORKERS"],
  "tasks": {
    "bundle": {
      "dependsOn": ["build"],
      "outputs": ["dist/silk.mjs"]
    },
    "build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "!benchmarks/**",
        "!docs/**",
        "!fixtures/**",
        "!parity/**",
        "!scripts/**",
        "!test/**",
        "!*.md"
      ],
      "outputs": ["dist/**"]
    },
    "dev": {
      "dependsOn": ["^build", "build"],
      "cache": false,
      "persistent": true
    },
    "typecheck": {
      "dependsOn": ["^build"],
      "outputs": []
    },
    "@silklang/compiler#typecheck": {
      "dependsOn": ["build"],
      "outputs": []
    },
    "test": {
      "dependsOn": ["build"],
      "inputs": ["$TURBO_DEFAULT$", "$TURBO_ROOT$/vitest.shared.ts"],
      "outputs": []
    },
    "@silklang/compiler#test": {
      "dependsOn": ["build", "@silklang/docgen#build", "@silklang/cli#build"],
      "env": ["SILK_TEST_CLANG", "SILK_TEST_LLVM_AR"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/vitest.shared.ts",
        "$TURBO_ROOT$/apps/docs/content/language/diagnostics.md",
        "$TURBO_ROOT$/apps/docs/content/language/stdlib/**"
      ],
      "outputs": []
    },
    "@silklang/compiler#build": {
      "dependsOn": ["^build"],
      "inputs": [
        "$TURBO_DEFAULT$",
        "$TURBO_ROOT$/tsconfig.base.json",
        "!benchmarks/**",
        "!docs/**",
        "!fixtures/**",
        "!parity/**",
        "!test/**",
        "!*.md",
        "!src/ToolchainIntegrity.generated.ts"
      ],
      "outputs": ["dist/**", "src/ToolchainIntegrity.generated.ts"]
    }
  }
}
