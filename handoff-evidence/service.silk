import silk.concurrency.sync { Arc }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.http.serve { Server, Handler, Request, Response }
import silk.http.client { Http, HttpError }
import silk.http.client_native { NativeHttp }
import silk.io.writer { WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.monotonic_clock { MonotonicClock }
import silk.system.monotonic_clock_native { OsMonotonicClock }
import silk.trace { Config, Recorder, SpanContext, Trace, Tracer }
import silk.trace.sink { Otlp, OtlpResponseError, flush }

struct Checkout {}
effect fn serve(parent: &SpanContext) -> () {
  let _span = Trace.spanFrom(parent, "GET /shop")
  Trace.set("shop.checkout", &true)
}
effect fn emit(recorder: &Recorder) -> () ! OutOfMemoryError | WriterError | OtlpResponseError | HttpError ? &mut Allocator {
  let mut dest = Otlp.http("http://127.0.0.1:14318")
  let mut network = NativeHttp.make()
  let mut clock = OsMonotonicClock.make()
  run flush(recorder, &mut dest)
    |> Effect.provideMut<Http>(&mut network)
    |> Effect.provideMut<MonotonicClock>(&mut clock)
}
impl Handler for Checkout {
  effect fn handle(self: &Self, request: &Request<'_>, response: &mut Response<'_>) -> () ! OutOfMemoryError ? &mut Allocator {
    let incoming = Trace.parseTraceparent(request.header("traceparent").unwrapOr(""))
    match move incoming {
      Option<SpanContext>.None => { run response.text("missing traceparent") }
      Option<SpanContext>.Some {value} => {
        let recorder = run Arc<Recorder>.make(run Recorder.make(Config.make("silk-shop")))
        run serve(&value) |> Effect.provideAmbient<Tracer>(&recorder)
        let result = run Effect.result(emit(recorder.get()))
        match move result {
          Result.Success {..} => { run response.text("recorded") }
          Result.Failure {error} => { drop error run response.text("export failed") }
        }
      }
    }
  }
}
effect fn listen() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let result = run Effect.result(Server.make(18479).workers(1).serve(Checkout {}))
  drop result
  return 1
}
pub effect fn main() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run listen() |> Effect.provideMut<Allocator>(&mut allocator)
}
