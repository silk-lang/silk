//! sew hands a command to the toolchain the directory selects, drops a leading `+<version>`, and
//! exits 3 when the selected toolchain is not installed or nothing selects one.

import Command as Commands { Context }
import Forward as Forwards { Action, Forwarding }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.bytes { Bytes }
import silk.effect { Effect }
import silk.filesystem { FileError, FileSystem, Path }
import silk.list { List }
import silk.option { Option }
import silk.os_filesystem { OsFileSystem }
import silk.result { Result }
import silk.testing { AssertionError, Testing }
import silk.usize
import Toolchains

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn endsWith(text: &[u8], suffix: &[u8]) -> bool {
  if text.length < suffix.length {
    return false
  }
  let mut at = usize.ZERO
  while at < suffix.length {
    if text[text.length - suffix.length + at] != suffix[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn temporaryRoot() -> string<'static> {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    return "/private/tmp"
  } else {
    return "/tmp"
  }
}

effect fn write(root: &Path, relative: string, text: &[u8]) -> ()
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let path = run Path.join(root, relative)
  run FileSystem.writeFileWithParents(&path, text)
}

// The decision for `words` run in `working`, with `SILK_TOOLCHAIN` set to `environment` when it
// is not empty.
effect fn decided(working: &Path, home: &Path, environment: &[u8], words: &[&[u8]]) -> Forwarding
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut selected = Option<Bytes>.none()
  if environment.length > usize.ZERO {
    selected = Option<Bytes>.some(run Bytes.copy(environment))
  }
  let context = Context {
    working: run Path.fromBytes(Path.rawBytes(working)),
    home: Option<Path>.some(run Path.fromBytes(Path.rawBytes(home))),
    environment: move selected,
    target: b"test-target",
    releaseKey: b"",
    release: b"0.0.0",
  }
  let mut arguments = List<Bytes>.make()
  let mut at = usize.ZERO
  while at < words.length {
    run List<Bytes>.append(&mut arguments, run Bytes.copy(words[at]))
    at = at + usize.ONE
  }
  return run Forwards.decide(&context, List<Bytes>.asSlice(&arguments))
}

// Whether `decision` replaces the process with `home`'s toolchain `name`, skipping `skip` arguments.
effect fn replaces(decision: &Forwarding, home: &Path, name: &[u8], skip: usize) -> bool
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let mut expected = run Bytes.copy(Path.rawBytes(home))
  run Bytes.append(&mut expected, b"/toolchains/")
  run Bytes.append(&mut expected, name)
  run Bytes.append(&mut expected, b"/bin/silk")
  return decision.action == Action.Replace
    && same(Bytes.asSlice(&decision.executable), Bytes.asSlice(&expected))
    && same(Bytes.asSlice(&decision.version), name) && decision.skip == skip
}

effect fn dispatches(root: &Path) -> ()
  ! AssertionError<'static> | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let home = run Path.join(root, "home")
  run write(&home, "toolchains/0.1.0-dev.4+892d3bee6c53/bin/silk", b"")
  run write(&home, "toolchains/0.1.0-dev.6+1aed5da1a342/bin/silk", b"")
  run write(
    root,
    "app/silk.toml",
    b"[package]\nname = \"app\"\nversion = \"0.1.0\"\nsilk-version = \"0.1.0-dev.4\"\nroot = \"main.silk\"\n"
  )
  run write(
    root,
    "missing/silk.toml",
    b"[package]\nname = \"missing\"\nversion = \"0.1.0\"\nsilk-version = \"0.1.0-dev.5\"\nroot = \"main.silk\"\n"
  )
  let app = run Path.join(root, "app")
  let missing = run Path.join(root, "missing")
  let outside = run Path.join(root, "outside")
  run write(root, "outside/keep", b"")
  let pinned = run decided(&app, &home, b"", &[b"build"])
  run Testing.expect(
    run replaces(&pinned, &home, b"0.1.0-dev.4+892d3bee6c53", usize.ZERO),
    "a project's pin runs the installed toolchain it names, with the full version in SILK_TOOLCHAIN"
  )
  let environment = run decided(&app, &home, b"0.1.0-dev.6+1aed5da1a342", &[b"build"])
  run Testing.expect(
    run replaces(&environment, &home, b"0.1.0-dev.6+1aed5da1a342", usize.ZERO),
    "SILK_TOOLCHAIN overrides the pin"
  )
  let requested = run decided(&app, &home, b"0.1.0-dev.4", &[b"+0.1.0-dev.6", b"build"])
  run Testing.expect(
    run replaces(&requested, &home, b"0.1.0-dev.6+1aed5da1a342", usize.ONE),
    "+<version> overrides both, and the compiler does not see it"
  )
  let absent = run decided(&missing, &home, b"", &[b"build"])
  run Testing.expect(
    absent.action == Action.Exit && absent.status == Commands.NOT_INSTALLED
      && same(Bytes.asSlice(&absent.missing), b"0.1.0-dev.5")
      && endsWith(Bytes.asSlice(&absent.errors), b") is not installed.\nInstall it with: sew use\n"),
    "a missing pinned toolchain exits 3 and names the version to install"
  )
  let nothing = run decided(&outside, &home, b"", &[b"build"])
  run Testing.expect(
    nothing.action == Action.Exit && nothing.status == Commands.NOT_INSTALLED
      && Bytes.length(&nothing.missing) == usize.ZERO,
    "with no pin and no default, nothing is selected and nothing installs itself"
  )
  run Toolchains.setDefault(&home, b"0.1.0-dev.6+1aed5da1a342")
  let defaulted = run decided(&outside, &home, b"", &[b"lsp"])
  run Testing.expect(
    run replaces(&defaulted, &home, b"0.1.0-dev.6+1aed5da1a342", usize.ZERO),
    "outside a project the default runs"
  )
  let garbage = run decided(&app, &home, b"", &[b"+garbage", b"build"])
  run Testing.expect(
    garbage.action == Action.Exit && garbage.status == 2
      && same(
        Bytes.asSlice(&garbage.errors),
        b"sew: `+garbage` is not a Silk version; +<version> takes a semantic version such as +0.1.0-dev.11\n"
      ),
    "+<version> that is not a semantic version is a usage error, not a missing toolchain"
  )
  run write(
    root,
    "future/silk.toml",
    b"[package]\nname = \"future\"\nversion = \"0.1.0\"\nsilk-version = \"~1\"\nroot = \"main.silk\"\n"
  )
  let future = run Path.join(root, "future")
  let unknown = run decided(&future, &home, b"", &[b"build"])
  run Testing.expect(
    unknown.action == Action.Exit && unknown.status == 2,
    "a pin this sew cannot read stops with a configuration error"
  )
}

effect fn isolatedDispatches() -> ()
  ! AssertionError<'static> | FileError | OutOfMemoryError
  ? &mut Allocator {
  let mut files = run OsFileSystem.make(temporaryRoot())
  let parent = run Path.root()
  let root = run FileSystem.createTemporaryDirectory(&parent, b"sew-forward-")
    |> Effect.provideMut<FileSystem>(&mut files)
  let attempted = run Effect.result(dispatches(&root)) |> Effect.provideMut<FileSystem>(&mut files)
  let cleaned = run Effect.result(FileSystem.removeDirectoryRecursively(&root))
    |> Effect.provideMut<FileSystem>(&mut files)
  drop cleaned
  match move attempted {
    Result<(), AssertionError<'static> | FileError | OutOfMemoryError>.Success { value } => {}
    Result<(), AssertionError<'static> | FileError | OutOfMemoryError>.Failure { error } => {
      fail move error
    }
  }
}

test effect fn forwardingFollowsTheSelection() -> ()
  ! AssertionError<'static> | FileError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run isolatedDispatches() |> Effect.provideMut<Allocator>(&mut allocator)
}
