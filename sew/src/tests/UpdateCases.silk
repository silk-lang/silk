//! `sew update self` replaces `$SILK_HOME/bin/sew` and its `silk` twin with the `bin/sew` of the
//! newest signed release, installs no toolchain, and leaves an up-to-date sew alone.

import NativeHostFiles as HostFileAccess { NativeHostFiles }
import Install as ToolchainInstall { HostFiles, InstallError, ReleaseSource }
import Command as Commands { Context, Outcome }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.bytes { Bytes }
import silk.effect { Effect }
import silk.filesystem { FileError, FileSystem, Path }
import silk.list { List }
import silk.option { Option }
import silk.os_filesystem { OsFileSystem }
import silk.result { Result }
import silk.slice { Slice }
import silk.testing { AssertionError, Testing }
import silk.usize

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn contains(text: &[u8], part: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at + part.length <= text.length {
    if same(Slice.view<u8>(text, at, part.length), part) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

fn temporaryRoot() -> &'static [u8] {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    return b"/private/tmp"
  } else {
    return b"/tmp"
  }
}

// Releases `0.3.0+def` and `0.4.0-dev.1+ghi`, which carry `bin/sew`, and `0.2.0+old`, which does
// not, for `test-target`, signed by `updateKey()`. Generated by signing ustar archives with Ed25519
// over BLAKE2b-512, as `minisign -S` does, with the secret seed of 32 bytes of 0x2a and key id
// 0x11..0x18.
fn updateKey() -> &'static [u8] { return b"RWQREhMUFRYXGBl/ayPhbIUyxqvIOPrNXqeJvgx2spIDNAOb+os9No1h" }
fn stableArchive() -> &'static [u8] { return b"\x1f\x8b\x08\x00\x00\x00\x00\x00\x02\xff\xed\xd4\xc1\x0a\xc2 \x1c\x80q\xcf=\x85\xd11\xb6\xe9D\xf7<EV\xa3\xe8\x90\xc6^?+\xe8\xe0\xe8\xd6\xac\xe8\xfb]\x14<\x88|\xfc\x0d\xfd\xf1P\xa9\xda\xd4j\xb9\xf1\xdb*\xfa\x10\xab\xb8:\xef|l\xc4\xbb\xa8\xa4\xb3\xf6\xbe&\xf9:\xde\xeb\xd6\x18'\xa4\x15\x05\x5cBzn\xba^\xfc\xa7\xf0\xba\xff\xba?5\x1f\xeao\xb4\xa2\xff7\xf4\xbf\x1dO\xdf_\xb7y\xff\xceuB*\xfaOn1\x7ft\xde\xcf\x04\x98\xff\xd1\xfc\xfb\xa1\xc0\xff\xaf]>\xff\xaee\xfe\xcb\xf4\xf7\x83|\xe6\xe7\x0f\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x80\x9fu\x05\xe4\x81\xdb\xaa\x00(\x00\x00" }
fn stableSignature() -> &'static [u8] { return b"untrusted comment: signature from minisign secret key\x0aRUQREhMUFRYXGPpPUerKk0bPfYwcQftmwkmO9ORWg9VmkslOLONt7TBV9yMkdxjLkmhXB1k8cMCnPwc/J2HQpedEl3YYPK2IRwQ=\x0atrusted comment: silk v0.3.0+def silk-0.3.0+def-test-target.tar.gz\x0au5D5OpemH5ORKXc10Uixc9tTDeFviKQhWXGMdwdUuyZ4tAuZwnjcTyxRlkrFFYw5b4G5lbN8vI3rn0G9JaoDCw==\x0a" }
fn devArchive() -> &'static [u8] { return b"\x1f\x8b\x08\x00\x00\x00\x00\x00\x02\xff\xed\xd4\xc1\x0a\xc2 \x1c\x80q\xcf=\xc5\xa2c\xb8\xe9\xd4\xf6<E\xb2\x8d\xa2C\xda\xf6\xfaY\xdd\x8c\xe8\x10\x1bE\xdf\xef\xa2\x07A\xe4\xe3o\xe8\x8f\x07\xa9J[*\xb9\xf7C\xa9\xd7m\xd7\xcb\xe8C\x94q{n}\xac\xc4\xe7T\xd28w_\x93|}\xdekSo\x8c(\x9c\x98\xc1%\xa4\x87\xa6\xeb\xc5\x7f\x0a\xef\xfa\xef\xfaS5{\x7f\xab\x0c\xfd\xbf\xa7\xff\xed\xd0\x94\xfdu\x9d\xf7o\xb4\x15\x85\xa2\xff\xe4V\xcbG\xe1n!\xc0\xfc\xbf\x98\x7f?N\xfa\xff\xd76\x9f\x7f\xe7\x0c\xf3?K\x7f?\x16Y~~\x02\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xf8AW`\xb2L8\x00(\x00\x00" }
fn devSignature() -> &'static [u8] { return b"untrusted comment: signature from minisign secret key\x0aRUQREhMUFRYXGJnuoO7pYlRFPH/tLrTa1LKZnfkTAtp4pbhBy4uCNyuzKhImvlUpNGADZLUYraDHyWAWPbGWIHtPJZE4Gbo/Mws=\x0atrusted comment: silk v0.4.0-dev.1+ghi silk-0.4.0-dev.1+ghi-test-target.tar.gz\x0a+Ove0OO77lAH5BbHVSricD61FSvi+glVuWwZHqOGEOBgS3OnnC9b2jcA8Jhh6p9G7LU2qmBWa+BSJ+JChGQyCA==\x0a" }
fn earlyArchive() -> &'static [u8] { return b"\x1f\x8b\x08\x00\x00\x00\x00\x00\x02\xff\xed\xd1M\x0a\xc20\x10@\xe1Y{\x8a\x8aKI;I\x8d\x9eG\xb1h\xb1(\x98\xf4\xfe\x8e\xba\xab\xb8\xb3\xfe\xe0\xfb6\x13\x98@\x08/\xb5\xdd\xc1i\x19J\x9d\x9f\xba\xad\xcbM\xca.\xaf\xcf\xbb&W\xf2*jV1\xde\xa6\x19\xce\xc7\xb3\x0f\xb5]/\xa2\xbcA\x9f\xec\xbb\xf6\xbc\xfc\xa7\xf4\xbc\xff\xa6=V\x1f\xea_\xfb@\xffo\xe8\x7f]\x8f\xdf\xdf\x87A\xff\x85\xeaR\x0a\xa5\xff\xe8f\xd3{\xe7\xfdD\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xf0\x83.X\xa7\xdaV\x00(\x00\x00" }
fn earlySignature() -> &'static [u8] { return b"untrusted comment: signature from minisign secret key\x0aRUQREhMUFRYXGE7882qP1FECRthgpNK9C8Nk6jKTKwvx9qncyR0Ub45/4GKipALFvV4ksyB/ZiKI/lRkf83iFUtawjIFdRyQFgM=\x0atrusted comment: silk v0.2.0+old silk-0.2.0+old-test-target.tar.gz\x0agD4CYspweiTxFqfPF7euPEQeDZr8VYmxOYaUSFjLYikXf/ChwHjQ13DVB0VWs6WQJya+WSWDEzDVLJtdT0TTDA==\x0a" }

// Which releases the fake source lists.
enum Listing {
  WithSew,
  BeforeSew,
}

struct UpdateReleases {
  listing: Listing
}

impl UpdateReleases {
  effect fn releases(self: &mut Self) -> List<Bytes>
    ! InstallError | OutOfMemoryError
    ? &mut Allocator {
    let mut published = List<Bytes>.make()
    run List<Bytes>.append(&mut published, run Bytes.copy(b"0.2.0+old"))
    if self.listing == Listing.WithSew {
      run List<Bytes>.append(&mut published, run Bytes.copy(b"0.3.0+def"))
      run List<Bytes>.append(&mut published, run Bytes.copy(b"0.4.0-dev.1+ghi"))
    }
    return move published
  }

  effect fn asset(self: &mut Self, version: &[u8], name: &[u8]) -> Bytes
    ! InstallError | OutOfMemoryError
    ? &mut Allocator {
    if same(name, b"silk-0.3.0+def-test-target.tar.gz") {
      return run Bytes.copy(stableArchive())
    }
    if same(name, b"silk-0.3.0+def-test-target.tar.gz.minisig") {
      return run Bytes.copy(stableSignature())
    }
    if same(name, b"silk-0.4.0-dev.1+ghi-test-target.tar.gz") {
      return run Bytes.copy(devArchive())
    }
    if same(name, b"silk-0.4.0-dev.1+ghi-test-target.tar.gz.minisig") {
      return run Bytes.copy(devSignature())
    }
    if same(name, b"silk-0.2.0+old-test-target.tar.gz") {
      return run Bytes.copy(earlyArchive())
    }
    if same(name, b"silk-0.2.0+old-test-target.tar.gz.minisig") {
      return run Bytes.copy(earlySignature())
    }
    fail InstallError { status: 1, message: run Bytes.copy(b"no such asset") }
  }
}

impl ReleaseSource for UpdateReleases {
  releases: UpdateReleases.releases
  asset: UpdateReleases.asset
}

// Runs `sew update` with `words` as sew `running` would, against `listing`.
effect fn update(home: &Path, running: &'static [u8], listing: Listing, words: &[&[u8]]) -> Outcome
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let context = Context {
    working: run Path.fromBytes(Path.rawBytes(home)),
    home: Option<Path>.some(run Path.fromBytes(Path.rawBytes(home))),
    environment: Option<Bytes>.none(),
    target: b"test-target",
    releaseKey: updateKey(),
    release: running,
  }
  let mut arguments = List<Bytes>.make()
  run List<Bytes>.append(&mut arguments, run Bytes.copy(b"update"))
  let mut at = usize.ZERO
  while at < words.length {
    run List<Bytes>.append(&mut arguments, run Bytes.copy(words[at]))
    at = at + usize.ONE
  }
  let mut source = UpdateReleases { listing: listing }
  let mut host = NativeHostFiles.at(temporaryRoot())
  return run Commands.networked(&context, List<Bytes>.asSlice(&arguments))
    |> Effect.provideMut<ReleaseSource>(&mut source)
    |> Effect.provideMut<HostFiles>(&mut host)
}

// Whether `home/bin/<name>` holds `expected`.
effect fn holds(home: &Path, name: string, expected: &[u8]) -> bool
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let bin = run Path.join(home, "bin")
  let path = run Path.join(&bin, name)
  if !run FileSystem.exists(&path) {
    return false
  }
  let content = run FileSystem.readFile(&path)
  return same(Bytes.asSlice(&content), expected)
}

effect fn updates(root: &Path) -> ()
  ! AssertionError<'static> | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let home = run Path.join(root, "home")
  run FileSystem.createDirectoriesRecursively(&home)
  let stable = run update(&home, b"0.2.0+old", Listing.WithSew, &[b"self"])
  let store = run Path.join(&home, "toolchains")
  let front = run holds(&home, "sew", b"sew 0.3.0+def\n")
  let proxy = run holds(&home, "silk", b"sew 0.3.0+def\n")
  let stored = run FileSystem.exists(&store)
  run Testing.expect(
    stable.status == 0 && contains(Bytes.asSlice(&stable.output), b"Updated sew to 0.3.0+def")
      && front && proxy && !stored,
    "`sew update self` installs the newest stable release's sew as sew and silk, and no toolchain"
  )
  let current = run update(&home, b"0.3.0+def", Listing.WithSew, &[b"sew"])
  run Testing.expect(
    current.status == 0 && contains(Bytes.asSlice(&current.output), b"sew 0.3.0+def is up to date"),
    "`sew update sew` leaves an up-to-date sew alone"
  )
  let dev = run update(&home, b"0.3.0+def", Listing.WithSew, &[b"self", b"--dev"])
  let devFront = run holds(&home, "sew", b"sew 0.4.0-dev.1+ghi\n")
  let devProxy = run holds(&home, "silk", b"sew 0.4.0-dev.1+ghi\n")
  run Testing.expect(
    dev.status == 0 && devFront && devProxy,
    "`sew update self --dev` takes the newest release of any kind"
  )
  let older = run update(&home, b"0.0.0", Listing.BeforeSew, &[b"self"])
  let kept = run holds(&home, "sew", b"sew 0.4.0-dev.1+ghi\n")
  run Testing.expect(
    older.status == 1 && contains(Bytes.asSlice(&older.errors), b"released before sew") && kept,
    "a release without sew fails and keeps the installed sew"
  )
  let unknown = run update(&home, b"0.0.0", Listing.WithSew, &[b"self", b"--beta"])
  run Testing.expect(unknown.status == 2, "`sew update self` takes only --dev")
}

effect fn isolatedUpdates() -> ()
  ! AssertionError<'static> | FileError | OutOfMemoryError
  ? &mut Allocator {
  let mut files = run OsFileSystem.makeBytes(temporaryRoot())
  let parent = run Path.root()
  let root = run FileSystem.createTemporaryDirectory(&parent, b"sew-update-")
    |> Effect.provideMut<FileSystem>(&mut files)
  let attempted = run Effect.result(updates(&root)) |> Effect.provideMut<FileSystem>(&mut files)
  let cleaned = run Effect.result(FileSystem.removeDirectoryRecursively(&root))
    |> Effect.provideMut<FileSystem>(&mut files)
  drop cleaned
  match move attempted {
    Result<(), AssertionError<'static> | FileError | OutOfMemoryError>.Success { value } => {}
    Result<(), AssertionError<'static> | FileError | OutOfMemoryError>.Failure { error } => {
      fail move error
    }
  }
}

test effect fn updateSelfReplacesSewAndSilk() -> ()
  ! AssertionError<'static> | FileError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run isolatedUpdates() |> Effect.provideMut<Allocator>(&mut allocator)
}
