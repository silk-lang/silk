import silk.cli.command { Command, CommandLine, Opt }
import silk.cli.completion { Completion }
import silk.cli.parse { Cli }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.system.host_input { HostInput, HostInputError }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.io.writer_native { StdoutWriter }
import silk.text.string { String }
import silk.io.writer { Writer, WriterError }

struct Git {
  pub quiet: bool,
  pub command: GitCommand,
}

union GitCommand {
  Clone { pub url: String, pub depth: Option<u32> },
  Remote { pub verbose: bool, pub action: RemoteAction },
  Completions { pub shell: String },
}

union RemoteAction {
  List,
  Add { pub name: String, pub url: String },
}

impl CommandLine for Git {
  static fn command() -> Command<Git> {
    return Command<Git>.make("git", "A tiny git")
      |> Command.option("quiet", Opt.about("Say less") |> Opt.short("q"))
      |> Command.subcommand("command")
  }
}

impl CommandLine for GitCommand {
  static fn command() -> Command<GitCommand> {
    return Command<GitCommand>.make("", "")
      |> Command.variant("Clone", "Copy a repository")
      |> Command.variant("Remote", "Manage remotes")
      |> Command.variant("Completions", "Print a shell completion script")
      |> Command.arg("url", Opt.about("Where to copy from") |> Opt.required)
      |> Command.option("depth", Opt.about("How many commits"))
      |> Command.option("verbose", Opt.plain() |> Opt.short("v"))
      |> Command.subcommand("action")
      |> Command.arg(
        "shell",
        Opt.required(Opt.plain())
          |> Opt.choice("bash")
          |> Opt.choice("zsh")
          |> Opt.choice("fish"),
      )
  }
}

impl CommandLine for RemoteAction {
  static fn command() -> Command<RemoteAction> {
    return Command<RemoteAction>.make("", "")
      |> Command.variant("List", "List the remotes")
      |> Command.variant("Add", "Add a remote")
      |> Command.arg("name", Opt.plain() |> Opt.required)
      |> Command.arg("url", Opt.plain() |> Opt.required)
  }
}

effect fn report(git: &Git) -> ()
  ! WriterError
  ? &mut Writer {
  if git.quiet {
    return
  }
  match &git.command {
    GitCommand.Clone { url, depth: _ } => {
      run Writer.writeString("cloning ")
      run Writer.writeString(String.view(&url))
      run Writer.writeString("\n")
    }
    GitCommand.Remote { verbose: _, action: RemoteAction.List } => {
      run Writer.writeString("listing remotes\n")
    }
    GitCommand.Completions { shell: _ } => {}
    GitCommand.Remote { verbose: _, action: RemoteAction.Add { name, url } } => {
      run Writer.writeString("adding remote ")
      run Writer.writeString(String.view(&name))
      run Writer.writeString(" at ")
      run Writer.writeString(String.view(&url))
      run Writer.writeString("\n")
    }
  }
}

pub effect fn main() -> i32
  ! HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut out = StdoutWriter.make()
  let read = run Cli.read<Git>() |> Effect.provideMut<Allocator>(&mut allocator)
  match move read {
    Result.Success { value: git } => {
      match &git.command {
        GitCommand.Completions { shell } => {
          if String.view(&shell) == "zsh" {
            run Completion.writeZsh<Git>() |> Effect.provideMut<Writer>(&mut out)
          } else if String.view(&shell) == "fish" {
            run Completion.writeFish<Git>() |> Effect.provideMut<Writer>(&mut out)
          } else {
            run Completion.writeBash<Git>() |> Effect.provideMut<Writer>(&mut out)
          }
          return 0
        }
        _ => {}
      }
      run report(&git) |> Effect.provideMut<Writer>(&mut out)
      return 0
    }
    Result.Failure { error: code } => {
      return code
    }
  }
}
