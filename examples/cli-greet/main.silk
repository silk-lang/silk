import silk.cli.command { Command, CommandLine, Opt }
import silk.cli.parse { Cli }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.system.host_input { HostInput, HostInputError }
import silk.collections.list { List }
import silk.io.writer_native { StdoutWriter }
import silk.core.result { Result }
import silk.text.string { String }
import silk.io.writer { Writer, WriterError }

struct Greet {
  pub name: String,
  pub times: u32,
  /// Shout it
  pub loud: bool,
  pub files: List<String>,
}

impl CommandLine for Greet {
  static fn command() -> Command<Greet> {
    return Command<Greet>.make("greet", "Say hello to someone")
      |> Command.withVersion("0.1.0")
      |> Command.option(
        "name",
        Opt.about("Who to greet")
          |> Opt.short("n")
          |> Opt.default("world"),
      )
      |> Command.option("times", Opt.about("How many times") |> Opt.default("1"))
      |> Command.arg("files", Opt.about("Files to mention"))
  }
}

effect fn hello(args: &Greet) -> ()
  ! WriterError
  ? &mut Writer {
  let mut count: u32 = 0
  while count < args.times {
    if args.loud {
      run Writer.writeString("HELLO, ")
    } else {
      run Writer.writeString("Hello, ")
    }
    run Writer.writeString(String.view(&args.name))
    run Writer.writeString("!\n")
    count = count + 1
  }
  let files = List<String>.asSlice(&args.files)
  let mut index: usize = 0
  while index < files.length {
    run Writer.writeString("  and ")
    run Writer.writeString(String.view(&files[index]))
    run Writer.writeString("\n")
    index = index + 1
  }
}

pub effect fn main() -> i32
  ! HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut out = StdoutWriter.make()
  let read = run Cli.read<Greet>() |> Effect.provideMut<Allocator>(&mut allocator)
  match move read {
    Result.Success { value } => {
      run hello(&value) |> Effect.provideMut<Writer>(&mut out)
      return 0
    }
    Result.Failure { error: code } => {
      return code
    }
  }
}
