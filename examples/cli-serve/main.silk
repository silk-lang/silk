import silk.cli.command { Command, CommandLine, Opt }
import silk.cli.parse { Cli }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.system.host_input { HostInput, HostInputError }
import silk.io.writer_native { StdoutWriter }
import silk.core.result { Result }
import silk.text.string { String }
import silk.io.writer { Writer, WriterError }

// Try `serve -vp8080 prod`, `PORT=3000 serve`, `serve --port 0`, or `serve --format yaml`.
struct Serve {
  pub verbose: bool,
  pub quiet: bool,
  pub port: u16,
  pub format: String,
  pub mode: String,
}

// The check of `--port`: an ordinary function that the parser calls directly.
fn nonzero(port: &u16) -> bool {
  return port.* != 0
}

impl CommandLine for Serve {
  static fn command() -> Command<Serve> {
    return Command<Serve>.make("serve", "Serve files")
      |> Command.option(
        "verbose",
        Opt.plain()
          |> Opt.short("v")
          |> Opt.env("SERVE_VERBOSE"),
      )
      |> Command.option("quiet", Opt.plain() |> Opt.short("q"))
      |> Command.option(
        "port",
        Opt.plain()
          |> Opt.short("p")
          |> Opt.describe("Port")
          |> Opt.env("PORT")
          |> Opt.default("80")
          |> Opt.check<u16>(nonzero),
      )
      |> Command.option(
        "format",
        Opt.plain()
          |> Opt.short("f")
          |> Opt.choice("json")
          |> Opt.choice("text")
          |> Opt.default("text"),
      )
      |> Command.arg(
        "mode",
        Opt.about("How")
          |> Opt.choice("dev")
          |> Opt.choice("prod")
          |> Opt.default("dev"),
      )
  }
}

effect fn report(args: &Serve) -> ()
  ! WriterError
  ? &mut Writer {
  run Writer.writeString("mode ")
  run Writer.writeString(String.view(&args.mode))
  run Writer.writeString(", format ")
  run Writer.writeString(String.view(&args.format))
  if args.port == 80 {
    run Writer.writeString(", port 80")
  } else {
    run Writer.writeString(", custom port")
  }
  if args.verbose {
    run Writer.writeString(", verbose")
  }
  if args.quiet {
    run Writer.writeString(", quiet")
  }
  run Writer.writeString("\n")
}

pub effect fn main() -> i32
  ! HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut out = StdoutWriter.make()
  let read = run Cli.read<Serve>() |> Effect.provideMut<Allocator>(&mut allocator)
  match move read {
    Result.Success { value } => {
      run report(&value) |> Effect.provideMut<Writer>(&mut out)
      return 0
    }
    Result.Failure { error: code } => {
      return code
    }
  }
}
