import silk.allocator { Allocator, OutOfMemoryError, SystemAllocator }
import silk.effect { Effect }
import silk.layout { Layout }
import silk.shared { Shared }

struct Empty {}

pub struct ReadyInbox {
  first: i32
  second: i32
  third: i32
  length: i32
  callbackCleanups: i32
  payloadCleanups: i32
  cleanupFingerprint: i32
}

fn pushNoGrow(self: &mut ReadyInbox, identifier: i32) -> i32 {
  if self.length == 0 { self.first = identifier }
  if self.length == 1 { self.second = identifier }
  if self.length == 2 { self.third = identifier }
  self.length = self.length + 1
  return identifier
}

fn recordCallbackCleanup(self: &mut ReadyInbox) -> i32 {
  self.callbackCleanups = self.callbackCleanups + 1
  self.cleanupFingerprint = self.cleanupFingerprint * 2 + 1
  return self.callbackCleanups
}

fn recordPayloadCleanup(self: &mut ReadyInbox) -> i32 {
  self.payloadCleanups = self.payloadCleanups + 1
  self.cleanupFingerprint = self.cleanupFingerprint * 2
  return self.payloadCleanups
}

struct Payload {
  value: i32
  inbox: Shared<ReadyInbox>
}

impl Drop for Payload {
  fn drop(self: &mut Payload) -> () {
    let recorded = Shared<ReadyInbox>.withMut<i32>(&self.inbox, recordPayloadCleanup)
    self.value = 0
    return ()
  }
}

fn enqueue(payload: i32, inbox: Shared<ReadyInbox>, identifier: i32) -> i32 {
  let pushed = Shared<ReadyInbox>.withMut<i32>(&inbox, pushNoGrow(identifier))
  drop inbox
  return payload + pushed - identifier
}

struct Stored<F: once fn<'static>(i32) -> i32> {
  notify: F
}

pub struct CallbackCapture {
  inbox: Shared<ReadyInbox>
  identifier: i32
}

impl Drop for CallbackCapture {
  fn drop(self: &mut CallbackCapture) -> () {
    let recorded = Shared<ReadyInbox>.withMut<i32>(&self.inbox, recordCallbackCleanup)
    return ()
  }
}

fn enqueueCaptured(payload: i32, self: CallbackCapture) -> i32 {
  return enqueue(payload, Shared<ReadyInbox>.clone(&self.inbox), self.identifier)
}

pub fn notifyReady(payload: i32) -> i32 { return payload }

struct ReadyCallback<F: once fn<'static>(i32) -> i32> {
  notify: F
  capture: CallbackCapture
}

struct Published<A> {
  value: A
}

struct DeferredState<A, F: once fn<'static>(i32) -> i32> {
  publication: Published<A>
  first: ReadyCallback<F>
  second: ReadyCallback<F>
  third: ReadyCallback<F>
  dormant: ReadyCallback<F>
  registrations: i32
  publications: i32
}

struct Producer<F: once fn<'static>(i32) -> i32> {
  state: Shared<DeferredState<Payload, F>>
}

struct Waiter<T> {
  state: Shared<T>
}

struct Extracted<F: once fn<'static>(i32) -> i32> {
  first: ReadyCallback<F>
  second: ReadyCallback<F>
  third: ReadyCallback<F>
}

fn register<F: once fn<'static>(i32) -> i32>(
  self: &mut DeferredState<Payload, F>,
  callback: ReadyCallback<F>,
) -> ReadyCallback<F> {
  if self.registrations == 0 {
    self.registrations = self.registrations + 1
    return Intrinsic.replace(self.first, move callback)
  } else {
    if self.registrations == 1 {
      self.registrations = self.registrations + 1
      return Intrinsic.replace(self.second, move callback)
    } else {
      self.registrations = self.registrations + 1
      return Intrinsic.replace(self.third, move callback)
    }
  }
}

fn publishState<F: once fn<'static>(i32) -> i32>(
  self: &mut DeferredState<Payload, F>,
  value: Payload,
  firstReplacement: ReadyCallback<F>,
  secondReplacement: ReadyCallback<F>,
  thirdReplacement: ReadyCallback<F>,
) -> Extracted<F> {
  let previous = Intrinsic.replace(self.publication, Published<Payload> { value: move value })
  drop previous
  self.publications = self.publications + 1
  let first = Intrinsic.replace(self.first, move firstReplacement)
  let second = Intrinsic.replace(self.second, move secondReplacement)
  let third = Intrinsic.replace(self.third, move thirdReplacement)
  return Extracted { first: move first, second: move second, third: move third }
}

fn invoke<F: once fn<'static>(i32) -> i32>(pending: ReadyCallback<F>, value: i32) -> i32 {
  let ReadyCallback<F> { notify, capture } = move pending
  return enqueueCaptured(notify(value), move capture)
}

fn readPayload(value: &Payload) -> i32 { return value.value }

fn observePayload(
  self: &DeferredState<Payload, typeof(notifyReady)>,
) -> i32 {
  if self.publications == 0 { return 0 }
  return readPayload(&self.publication.value)
}

fn publish<F: once fn<'static>(i32) -> i32>(
  producer: Producer<F>,
  value: Payload,
  firstReplacement: ReadyCallback<F>,
  secondReplacement: ReadyCallback<F>,
  thirdReplacement: ReadyCallback<F>,
) -> i32 {
  let extracted = Shared<DeferredState<Payload, F>>.withMut<Extracted<F>>(
    &producer.state,
    publishState(
      move value,
      move firstReplacement,
      move secondReplacement,
      move thirdReplacement,
    ),
  )
  drop producer
  let Extracted<F> { first, second, third } = move extracted
  let firstResult = invoke(move first, 7)
  let secondResult = invoke(move second, 7)
  let thirdResult = invoke(move third, 7)
  return firstResult + secondResult + thirdResult
}

fn inboxFingerprint(self: &ReadyInbox) -> i32 {
  return self.first * 100 + self.second * 10 + self.third
}

fn lifecycleFingerprint(self: &ReadyInbox) -> i32 {
  if self.callbackCleanups != 11 { return 1 }
  if self.payloadCleanups != 3 { return 2 }
  return self.cleanupFingerprint
}

fn observeOwnedInbox(inbox: Shared<ReadyInbox>) -> i32 {
  let result = Shared<ReadyInbox>.with<i32>(&inbox, inboxFingerprint)
  drop inbox
  return result
}

struct ExhaustedAllocator {}

effect fn reject(
  self: &mut ExhaustedAllocator,
  layout: Layout,
) -> Allocation ! OutOfMemoryError {
  drop layout
  fail OutOfMemoryError {}
}

impl Allocator for ExhaustedAllocator { allocate: ExhaustedAllocator.reject }

fn connected(
  inbox: &Shared<ReadyInbox>,
  state: &Shared<DeferredState<Payload, typeof(notifyReady)>>,
  unusedPayload: Payload,
  firstCallback: ReadyCallback<typeof(notifyReady)>,
  secondCallback: ReadyCallback<typeof(notifyReady)>,
  thirdCallback: ReadyCallback<typeof(notifyReady)>,
  firstReplacement: ReadyCallback<typeof(notifyReady)>,
  secondReplacement: ReadyCallback<typeof(notifyReady)>,
  thirdReplacement: ReadyCallback<typeof(notifyReady)>,
) -> i32 {
  let producer = Producer {
    state: Shared.clone(state),
  }
  let firstWaiter = Waiter {
    state: Shared.clone(state),
  }
  let secondWaiter = Waiter {
    state: Shared.clone(state),
  }
  let thirdWaiter = Waiter {
    state: Shared.clone(state),
  }
  let replaced1 = Shared.withMut(
    state,
    register(move firstCallback),
  )
  drop replaced1
  let replaced2 = Shared.withMut(
    state,
    register(move secondCallback),
  )
  drop replaced2
  let replaced3 = Shared.withMut(
    state,
    register(move thirdCallback),
  )
  drop replaced3
  let unusedProducer = Producer {
    state: Shared.clone(state),
  }
  let secondUnusedProducer = Producer {
    state: Shared.clone(state),
  }
  let dormantPublication = effect {
    drop unusedProducer
    drop unusedPayload
    return 99
  }
  let pendingStateCleanup = effect {
    drop secondUnusedProducer
    return 98
  }
  drop dormantPublication
  drop pendingStateCleanup
  let observationHandle = Shared<ReadyInbox>.clone(inbox)
  let pendingObservation = effect {
    return observeOwnedInbox(move observationHandle)
  }
  drop pendingObservation
  let publishedPayload = Payload {
    value: 7,
    inbox: Shared<ReadyInbox>.clone(inbox),
  }
  let published = publish(
    move producer,
    move publishedPayload,
    move firstReplacement,
    move secondReplacement,
    move thirdReplacement,
  )
  let observed1 = Shared.with(
    &firstWaiter.state,
    observePayload,
  )
  let observed2 = Shared.with(
    &secondWaiter.state,
    observePayload,
  )
  let observed3 = Shared.with(
    &thirdWaiter.state,
    observePayload,
  )
  drop firstWaiter
  drop secondWaiter
  drop thirdWaiter
  return published + observed1 + observed2 + observed3
}

effect fn runWitness() -> i32 ! OutOfMemoryError {
  // PRESSURE_FIRST_PROVIDER
  let mut firstAllocator = Allocator.systemAllocatorProvider()
  // PRESSURE_SECOND_PROVIDER
  let mut secondAllocator = Allocator.systemAllocatorProvider()
  let inbox = run (Shared<ReadyInbox>.make(ReadyInbox {
    first: 0,
    second: 0,
    third: 0,
    length: 0,
    callbackCleanups: 0,
    payloadCleanups: 0,
    cleanupFingerprint: 0,
  }) |> Effect.provideMut<Allocator>(&mut firstAllocator))
  let unusedPayload = Payload {
    value: 99,
    inbox: Shared<ReadyInbox>.clone(&inbox),
  }
  let initialPayload = Payload {
    value: 0,
    inbox: Shared<ReadyInbox>.clone(&inbox),
  }
  let firstPlaceholderCapture = CallbackCapture {
    inbox: Shared<ReadyInbox>.clone(&inbox),
    identifier: 4,
  }
  let firstPlaceholder = ReadyCallback {
    notify: notifyReady,
    capture: move firstPlaceholderCapture,
  }
  let secondPlaceholderCapture = CallbackCapture {
    inbox: Shared<ReadyInbox>.clone(&inbox),
    identifier: 5,
  }
  let secondPlaceholder = ReadyCallback {
    notify: notifyReady,
    capture: move secondPlaceholderCapture,
  }
  let thirdPlaceholderCapture = CallbackCapture {
    inbox: Shared<ReadyInbox>.clone(&inbox),
    identifier: 6,
  }
  let thirdPlaceholder = ReadyCallback {
    notify: notifyReady,
    capture: move thirdPlaceholderCapture,
  }
  let dormantCapture = CallbackCapture {
    inbox: Shared<ReadyInbox>.clone(&inbox),
    identifier: 8,
  }
  let dormantCallback = ReadyCallback {
    notify: notifyReady,
    capture: move dormantCapture,
  }
  let firstCapture = CallbackCapture {
    inbox: Shared<ReadyInbox>.clone(&inbox),
    identifier: 1,
  }
  let firstCallback = ReadyCallback { notify: notifyReady, capture: move firstCapture }
  let secondCapture = CallbackCapture {
    inbox: Shared<ReadyInbox>.clone(&inbox),
    identifier: 2,
  }
  let secondCallback = ReadyCallback { notify: notifyReady, capture: move secondCapture }
  let thirdCapture = CallbackCapture {
    inbox: Shared<ReadyInbox>.clone(&inbox),
    identifier: 3,
  }
  let thirdCallback = ReadyCallback { notify: notifyReady, capture: move thirdCapture }
  let firstReplacementCapture = CallbackCapture {
    inbox: Shared<ReadyInbox>.clone(&inbox),
    identifier: 4,
  }
  let firstReplacement = ReadyCallback {
    notify: notifyReady,
    capture: move firstReplacementCapture,
  }
  let secondReplacementCapture = CallbackCapture {
    inbox: Shared<ReadyInbox>.clone(&inbox),
    identifier: 5,
  }
  let secondReplacement = ReadyCallback {
    notify: notifyReady,
    capture: move secondReplacementCapture,
  }
  let thirdReplacementCapture = CallbackCapture {
    inbox: Shared<ReadyInbox>.clone(&inbox),
    identifier: 6,
  }
  let thirdReplacement = ReadyCallback {
    notify: notifyReady,
    capture: move thirdReplacementCapture,
  }
  let sourceState = DeferredState {
    publication: Published { value: move initialPayload },
    first: move firstPlaceholder,
    second: move secondPlaceholder,
    third: move thirdPlaceholder,
    dormant: move dormantCallback,
    registrations: 0,
    publications: 0,
  }
  let state = run (Shared.make(move sourceState)
    |> Effect.provideMut<Allocator>(&mut secondAllocator))
  let result = connected(
    &inbox,
    &state,
    move unusedPayload,
    move firstCallback,
    move secondCallback,
    move thirdCallback,
    move firstReplacement,
    move secondReplacement,
    move thirdReplacement,
  )
  let storedCapture = CallbackCapture {
    inbox: Shared<ReadyInbox>.clone(&inbox),
    identifier: 9,
  }
  let dormantReady = enqueueCaptured(move storedCapture)
  let storedCallable = Stored { notify: move dormantReady }
  drop state
  drop storedCallable
  let order = Shared<ReadyInbox>.with<i32>(&inbox, inboxFingerprint)
  let lifecycle = Shared<ReadyInbox>.with<i32>(&inbox, lifecycleFingerprint)
  drop inbox
  if result != 42 { return 5 }
  if result != 42 { return 6 }
  if order != 123 { return 7 }
  // Dropping the unrun publication Effect cleans its captured producer and payload at that point
  // (an owned capture is consumed by the environment), which orders those cleanups earlier.
  if lifecycle != 14815 { return 8 }
  return 42
}

struct LaterValue { value: i32 }

fn readLater(value: &LaterValue) -> i32 { return value.value }

effect fn laterSuccess(error: OutOfMemoryError) -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let first = run (Shared<LaterValue>.make(LaterValue { value: 20 })
    |> Effect.provideMut<Allocator>(&mut allocator))
  let second = run (Shared<LaterValue>.make(LaterValue { value: 22 })
    |> Effect.provideMut<Allocator>(&mut allocator))
  let firstValue = Shared<LaterValue>.with<i32>(&first, readLater)
  let secondValue = Shared<LaterValue>.with<i32>(&second, readLater)
  drop first
  drop second
  return firstValue + secondValue + 100
}

effect fn finalRecovery(error: OutOfMemoryError) -> i32 { return -1 }

pub fn main() -> i32 {
  let attempted = Effect.catchAll(runWitness(), laterSuccess)
  return run Effect.catchAll(move attempted, finalRecovery)
}
