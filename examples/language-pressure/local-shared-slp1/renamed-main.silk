import silk.allocator { Allocator, OutOfMemoryError, SystemAllocator }
import silk.effect { Effect }
import silk.layout { Layout }
import silk.shared { Shared }

struct Empty {}

pub struct SignalBox {
  first: i32
  second: i32
  third: i32
  length: i32
  callbackCleanups: i32
  payloadCleanups: i32
  cleanupFingerprint: i32
}

fn appendFixed(self: &mut SignalBox, identifier: i32) -> i32 {
  if self.length == 0 { self.first = identifier }
  if self.length == 1 { self.second = identifier }
  if self.length == 2 { self.third = identifier }
  self.length = self.length + 1
  return identifier
}

fn recordSignalCleanup(self: &mut SignalBox) -> i32 {
  self.callbackCleanups = self.callbackCleanups + 1
  self.cleanupFingerprint = self.cleanupFingerprint * 2 + 1
  return self.callbackCleanups
}

fn recordParcelCleanup(self: &mut SignalBox) -> i32 {
  self.payloadCleanups = self.payloadCleanups + 1
  self.cleanupFingerprint = self.cleanupFingerprint * 2
  return self.payloadCleanups
}

struct Parcel {
  value: i32
  inbox: Shared<SignalBox>
}

impl Drop for Parcel {
  fn drop(self: &mut Parcel) -> () {
    let recorded = Shared<SignalBox>.withMut<i32>(&self.inbox, recordParcelCleanup)
    self.value = 0
    return ()
  }
}

fn signal(payload: i32, inbox: Shared<SignalBox>, identifier: i32) -> i32 {
  let pushed = Shared<SignalBox>.withMut<i32>(&inbox, appendFixed(identifier))
  drop inbox
  return payload + pushed - identifier
}

struct Retained<F: once fn<'static>(i32) -> i32> {
  notify: F
}

pub struct SignalCapture {
  inbox: Shared<SignalBox>
  identifier: i32
}

impl Drop for SignalCapture {
  fn drop(self: &mut SignalCapture) -> () {
    let recorded = Shared<SignalBox>.withMut<i32>(&self.inbox, recordSignalCleanup)
    return ()
  }
}

fn signalCaptured(payload: i32, self: SignalCapture) -> i32 {
  return signal(payload, Shared<SignalBox>.clone(&self.inbox), self.identifier)
}

pub fn markReady(payload: i32) -> i32 { return payload }

struct SignalCallback<F: once fn<'static>(i32) -> i32> {
  notify: F
  capture: SignalCapture
}

struct Delivered<A> {
  value: A
}

struct FutureCell<A, F: once fn<'static>(i32) -> i32> {
  publication: Delivered<A>
  first: SignalCallback<F>
  second: SignalCallback<F>
  third: SignalCallback<F>
  dormant: SignalCallback<F>
  registrations: i32
  publications: i32
}

struct Sender<F: once fn<'static>(i32) -> i32> {
  state: Shared<FutureCell<Parcel, F>>
}

struct Reader<T> {
  state: Shared<T>
}

struct Removed<F: once fn<'static>(i32) -> i32> {
  first: SignalCallback<F>
  second: SignalCallback<F>
  third: SignalCallback<F>
}

fn subscribe<F: once fn<'static>(i32) -> i32>(
  self: &mut FutureCell<Parcel, F>,
  callback: SignalCallback<F>,
) -> SignalCallback<F> {
  if self.registrations == 0 {
    self.registrations = self.registrations + 1
    return Intrinsic.replace(self.first, move callback)
  } else {
    if self.registrations == 1 {
      self.registrations = self.registrations + 1
      return Intrinsic.replace(self.second, move callback)
    } else {
      self.registrations = self.registrations + 1
      return Intrinsic.replace(self.third, move callback)
    }
  }
}

fn deliverState<F: once fn<'static>(i32) -> i32>(
  self: &mut FutureCell<Parcel, F>,
  value: Parcel,
  firstReplacement: SignalCallback<F>,
  secondReplacement: SignalCallback<F>,
  thirdReplacement: SignalCallback<F>,
) -> Removed<F> {
  let previous = Intrinsic.replace(self.publication, Delivered<Parcel> { value: move value })
  drop previous
  self.publications = self.publications + 1
  let first = Intrinsic.replace(self.first, move firstReplacement)
  let second = Intrinsic.replace(self.second, move secondReplacement)
  let third = Intrinsic.replace(self.third, move thirdReplacement)
  return Removed { first: move first, second: move second, third: move third }
}

fn notify<F: once fn<'static>(i32) -> i32>(pending: SignalCallback<F>, value: i32) -> i32 {
  let SignalCallback<F> { notify, capture } = move pending
  return signalCaptured(notify(value), move capture)
}

fn readParcel(value: &Parcel) -> i32 { return value.value }

fn observeParcel(
  self: &FutureCell<Parcel, typeof(markReady)>,
) -> i32 {
  if self.publications == 0 { return 0 }
  return readParcel(&self.publication.value)
}

fn deliver<F: once fn<'static>(i32) -> i32>(
  producer: Sender<F>,
  value: Parcel,
  firstReplacement: SignalCallback<F>,
  secondReplacement: SignalCallback<F>,
  thirdReplacement: SignalCallback<F>,
) -> i32 {
  let extracted = Shared<FutureCell<Parcel, F>>.withMut<Removed<F>>(
    &producer.state,
    deliverState(
      move value,
      move firstReplacement,
      move secondReplacement,
      move thirdReplacement,
    ),
  )
  drop producer
  let Removed<F> { first, second, third } = move extracted
  let firstResult = notify(move first, 7)
  let secondResult = notify(move second, 7)
  let thirdResult = notify(move third, 7)
  return firstResult + secondResult + thirdResult
}

fn signalFingerprint(self: &SignalBox) -> i32 {
  return self.first * 100 + self.second * 10 + self.third
}

fn lifecycleSignalFingerprint(self: &SignalBox) -> i32 {
  if self.callbackCleanups != 11 { return 1 }
  if self.payloadCleanups != 3 { return 2 }
  return self.cleanupFingerprint
}

fn observeOwnedSignals(inbox: Shared<SignalBox>) -> i32 {
  let result = Shared<SignalBox>.with<i32>(&inbox, signalFingerprint)
  drop inbox
  return result
}

struct EmptyAllocator {}

effect fn refuse(
  self: &mut EmptyAllocator,
  layout: Layout,
) -> Allocation ! OutOfMemoryError {
  drop layout
  fail OutOfMemoryError {}
}

impl Allocator for EmptyAllocator { allocate: EmptyAllocator.refuse }

fn linked(
  inbox: &Shared<SignalBox>,
  state: &Shared<FutureCell<Parcel, typeof(markReady)>>,
  unusedParcel: Parcel,
  firstCallback: SignalCallback<typeof(markReady)>,
  secondCallback: SignalCallback<typeof(markReady)>,
  thirdCallback: SignalCallback<typeof(markReady)>,
  firstReplacement: SignalCallback<typeof(markReady)>,
  secondReplacement: SignalCallback<typeof(markReady)>,
  thirdReplacement: SignalCallback<typeof(markReady)>,
) -> i32 {
  let producer = Sender {
    state: Shared.clone(state),
  }
  let firstReader = Reader {
    state: Shared.clone(state),
  }
  let secondReader = Reader {
    state: Shared.clone(state),
  }
  let thirdReader = Reader {
    state: Shared.clone(state),
  }
  let replaced1 = Shared.withMut(
    state,
    subscribe(move firstCallback),
  )
  drop replaced1
  let replaced2 = Shared.withMut(
    state,
    subscribe(move secondCallback),
  )
  drop replaced2
  let replaced3 = Shared.withMut(
    state,
    subscribe(move thirdCallback),
  )
  drop replaced3
  let unusedSender = Sender {
    state: Shared.clone(state),
  }
  let secondUnusedSender = Sender {
    state: Shared.clone(state),
  }
  let dormantPublication = effect {
    drop unusedSender
    drop unusedParcel
    return 99
  }
  let pendingStateCleanup = effect {
    drop secondUnusedSender
    return 98
  }
  drop dormantPublication
  drop pendingStateCleanup
  let observationHandle = Shared<SignalBox>.clone(inbox)
  let pendingObservation = effect {
    return observeOwnedSignals(move observationHandle)
  }
  drop pendingObservation
  let publishedParcel = Parcel {
    value: 7,
    inbox: Shared<SignalBox>.clone(inbox),
  }
  let published = deliver(
    move producer,
    move publishedParcel,
    move firstReplacement,
    move secondReplacement,
    move thirdReplacement,
  )
  let observed1 = Shared.with(
    &firstReader.state,
    observeParcel,
  )
  let observed2 = Shared.with(
    &secondReader.state,
    observeParcel,
  )
  let observed3 = Shared.with(
    &thirdReader.state,
    observeParcel,
  )
  drop firstReader
  drop secondReader
  drop thirdReader
  return published + observed1 + observed2 + observed3
}

effect fn runPressure() -> i32 ! OutOfMemoryError {
  // PRESSURE_FIRST_PROVIDER
  let mut firstAllocator = Allocator.systemAllocatorProvider()
  // PRESSURE_SECOND_PROVIDER
  let mut secondAllocator = Allocator.systemAllocatorProvider()
  let inbox = run (Shared<SignalBox>.make(SignalBox {
    first: 0,
    second: 0,
    third: 0,
    length: 0,
    callbackCleanups: 0,
    payloadCleanups: 0,
    cleanupFingerprint: 0,
  }) |> Effect.provideMut<Allocator>(&mut firstAllocator))
  let unusedParcel = Parcel {
    value: 99,
    inbox: Shared<SignalBox>.clone(&inbox),
  }
  let initialParcel = Parcel {
    value: 0,
    inbox: Shared<SignalBox>.clone(&inbox),
  }
  let firstPlaceholderCapture = SignalCapture {
    inbox: Shared<SignalBox>.clone(&inbox),
    identifier: 4,
  }
  let firstPlaceholder = SignalCallback {
    notify: markReady,
    capture: move firstPlaceholderCapture,
  }
  let secondPlaceholderCapture = SignalCapture {
    inbox: Shared<SignalBox>.clone(&inbox),
    identifier: 5,
  }
  let secondPlaceholder = SignalCallback {
    notify: markReady,
    capture: move secondPlaceholderCapture,
  }
  let thirdPlaceholderCapture = SignalCapture {
    inbox: Shared<SignalBox>.clone(&inbox),
    identifier: 6,
  }
  let thirdPlaceholder = SignalCallback {
    notify: markReady,
    capture: move thirdPlaceholderCapture,
  }
  let dormantCapture = SignalCapture {
    inbox: Shared<SignalBox>.clone(&inbox),
    identifier: 8,
  }
  let dormantCallback = SignalCallback {
    notify: markReady,
    capture: move dormantCapture,
  }
  let firstCapture = SignalCapture {
    inbox: Shared<SignalBox>.clone(&inbox),
    identifier: 1,
  }
  let firstCallback = SignalCallback { notify: markReady, capture: move firstCapture }
  let secondCapture = SignalCapture {
    inbox: Shared<SignalBox>.clone(&inbox),
    identifier: 2,
  }
  let secondCallback = SignalCallback { notify: markReady, capture: move secondCapture }
  let thirdCapture = SignalCapture {
    inbox: Shared<SignalBox>.clone(&inbox),
    identifier: 3,
  }
  let thirdCallback = SignalCallback { notify: markReady, capture: move thirdCapture }
  let firstReplacementCapture = SignalCapture {
    inbox: Shared<SignalBox>.clone(&inbox),
    identifier: 4,
  }
  let firstReplacement = SignalCallback {
    notify: markReady,
    capture: move firstReplacementCapture,
  }
  let secondReplacementCapture = SignalCapture {
    inbox: Shared<SignalBox>.clone(&inbox),
    identifier: 5,
  }
  let secondReplacement = SignalCallback {
    notify: markReady,
    capture: move secondReplacementCapture,
  }
  let thirdReplacementCapture = SignalCapture {
    inbox: Shared<SignalBox>.clone(&inbox),
    identifier: 6,
  }
  let thirdReplacement = SignalCallback {
    notify: markReady,
    capture: move thirdReplacementCapture,
  }
  let sourceState = FutureCell {
    publication: Delivered { value: move initialParcel },
    first: move firstPlaceholder,
    second: move secondPlaceholder,
    third: move thirdPlaceholder,
    dormant: move dormantCallback,
    registrations: 0,
    publications: 0,
  }
  let state = run (Shared.make(move sourceState)
    |> Effect.provideMut<Allocator>(&mut secondAllocator))
  let result = linked(
    &inbox,
    &state,
    move unusedParcel,
    move firstCallback,
    move secondCallback,
    move thirdCallback,
    move firstReplacement,
    move secondReplacement,
    move thirdReplacement,
  )
  let storedCapture = SignalCapture {
    inbox: Shared<SignalBox>.clone(&inbox),
    identifier: 9,
  }
  let dormantReady = signalCaptured(move storedCapture)
  let storedCallable = Retained { notify: move dormantReady }
  drop state
  drop storedCallable
  let order = Shared<SignalBox>.with<i32>(&inbox, signalFingerprint)
  let lifecycle = Shared<SignalBox>.with<i32>(&inbox, lifecycleSignalFingerprint)
  drop inbox
  if result != 42 { return 5 }
  if result != 42 { return 6 }
  if order != 123 { return 7 }
  // Dropping the unrun publication Effect cleans its captured producer and payload at that point
  // (an owned capture is consumed by the environment), which orders those cleanups earlier.
  if lifecycle != 14815 { return 8 }
  return 42
}

struct RecoveryValue { value: i32 }

fn readRecovery(value: &RecoveryValue) -> i32 { return value.value }

effect fn recoverLater(error: OutOfMemoryError) -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let first = run (Shared<RecoveryValue>.make(RecoveryValue { value: 20 })
    |> Effect.provideMut<Allocator>(&mut allocator))
  let second = run (Shared<RecoveryValue>.make(RecoveryValue { value: 22 })
    |> Effect.provideMut<Allocator>(&mut allocator))
  let firstValue = Shared<RecoveryValue>.with<i32>(&first, readRecovery)
  let secondValue = Shared<RecoveryValue>.with<i32>(&second, readRecovery)
  drop first
  drop second
  return firstValue + secondValue + 100
}

effect fn lastRecovery(error: OutOfMemoryError) -> i32 { return -1 }

pub fn main() -> i32 {
  let attempted = Effect.catchAll(runPressure(), recoverLater)
  return run Effect.catchAll(move attempted, lastRecovery)
}
