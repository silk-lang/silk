import silk.allocator { Allocator }
import silk.allocator { OutOfMemoryError }
import silk.allocator { SystemAllocator }
import silk.effect { Effect }
import silk.format { Format }
import silk.u8
import silk.usize
import silk.vector { Vector }
import silk.writer { Writer, WriterError }

const asciiSpace: u8 = 32
const asciiTab: u8 = 9
const asciiLineFeed: u8 = 10
const asciiCarriageReturn: u8 = 13
const tokenIdentifier: u8 = 4
const tokenConst: u8 = 67
const tokenInvalidStaticLiteral: u8 = 68
const tokenService: u8 = 69
const tokenInterface: u8 = 70
const tokenCaret: u8 = 71
const tokenTilde: u8 = 72
const tokenAmpersandAmpersand: u8 = 73
const tokenPipePipe: u8 = 74
const tokenCharLiteral: u8 = 75
const tokenRole: u8 = 76
const tokenEnum: u8 = 77
const tokenUnion: u8 = 78
const tokenDurationLiteral: u8 = 79
const tokenInvalidDurationLiteral: u8 = 80
const tokenTuple: u8 = 81
const tokenStatic: u8 = 82
const tokenCompileError: u8 = 83
const tokenType: u8 = 84
const tokenExtern: u8 = 85
const tokenExport: u8 = 86

struct Token {
  kind: u8
  start: usize
  end: usize
}

impl Copy for Token {}

struct LexicalDiagnostic {
  start: usize
  end: usize
}

impl Copy for LexicalDiagnostic {}

struct Lexed {
  tokens: Vector<Token>
  diagnostics: Vector<LexicalDiagnostic>
}

struct Decision {
  kind: u8
  end: usize
  invalid: bool
}

fn isWhitespace(byte: u8) -> bool {
  if byte == asciiSpace { return true }
  if byte == asciiTab { return true }
  if byte == asciiLineFeed { return true }
  return byte == asciiCarriageReturn
}

fn isAsciiLetter(byte: u8) -> bool {
  if byte >= 65 {
    if byte <= 90 { return true }
  }
  if byte >= 97 {
    if byte <= 122 { return true }
  }
  return false
}

fn isDecimalDigit(byte: u8) -> bool {
  if byte < 48 { return false }
  return byte <= 57
}

fn isIdentifierStart(byte: u8) -> bool {
  if byte == 95 { return true }
  return isAsciiLetter(byte)
}

fn isIdentifierContinue(byte: u8) -> bool {
  if isIdentifierStart(byte) { return true }
  return isDecimalDigit(byte)
}

fn byteAtOrZero(source: &[u8], index: usize) -> u8 {
  if index < source.length { return source[index] }
  return u8.add(0, 0)
}

fn hasPair(source: &[u8], index: usize, first: u8, second: u8) -> bool {
  if byteAtOrZero(source, index) != first { return false }
  return byteAtOrZero(source, index + 1) == second
}

fn isLineCommentStart(source: &[u8], index: usize) -> bool {
  return hasPair(source, index, 47, 47)
}

fn isLiteralStart(source: &[u8], index: usize) -> bool {
  if byteAtOrZero(source, index) == 34 { return true }
  if hasPair(source, index, 98, 34) { return true }
  return hasPair(source, index, 114, 34)
}

fn isCharLiteralStart(byte: u8) -> bool {
  return byte == 39
}

fn hasTripleQuote(source: &[u8], index: usize) -> bool {
  if byteAtOrZero(source, index) != 34 { return false }
  if byteAtOrZero(source, index + 1) != 34 { return false }
  return byteAtOrZero(source, index + 2) == 34
}

fn isPunctuation(byte: u8) -> bool {
  if byte == 40 { return true }
  if byte == 41 { return true }
  if byte == 123 { return true }
  if byte == 125 { return true }
  if byte == 91 { return true }
  if byte == 93 { return true }
  if byte == 58 { return true }
  if byte == 59 { return true }
  if byte == 44 { return true }
  if byte == 61 { return true }
  if byte == 45 { return true }
  if byte == 43 { return true }
  if byte == 42 { return true }
  if byte == 47 { return true }
  if byte == 37 { return true }
  if byte == 33 { return true }
  if byte == 63 { return true }
  if byte == 64 { return true }
  if byte == 60 { return true }
  if byte == 62 { return true }
  if byte == 124 { return true }
  if byte == 38 { return true }
  if byte == 94 { return true }
  if byte == 126 { return true }
  return byte == 46
}

fn isCompoundPunctuation(source: &[u8], index: usize) -> bool {
  if hasPair(source, index, 45, 62) { return true }
  if hasPair(source, index, 61, 61) { return true }
  if hasPair(source, index, 61, 62) { return true }
  if hasPair(source, index, 33, 61) { return true }
  if hasPair(source, index, 60, 61) { return true }
  if hasPair(source, index, 62, 61) { return true }
  if hasPair(source, index, 124, 62) { return true }
  if hasPair(source, index, 124, 124) { return true }
  if hasPair(source, index, 38, 38) { return true }
  return hasPair(source, index, 46, 46)
}

fn isSupportedTokenStart(source: &[u8], index: usize) -> bool {
  let byte = byteAtOrZero(source, index)
  if isWhitespace(byte) { return true }
  if isIdentifierStart(byte) { return true }
  if isDecimalDigit(byte) { return true }
  if isLiteralStart(source, index) { return true }
  if isCharLiteralStart(byte) { return true }
  if isLineCommentStart(source, index) { return true }
  if isCompoundPunctuation(source, index) { return true }
  return isPunctuation(byte)
}

fn matches(source: &[u8], start: usize, end: usize, spelling: &[u8]) -> bool {
  if end - start != spelling.length { return false }
  let mut index = usize.add(0, 0)
  while index < spelling.length {
    if source[start + index] != spelling[index] { return false }
    index = index + 1
  }
  return true
}

fn keywordKind(source: &[u8], start: usize, end: usize) -> u8 {
  if matches(source, start, end, b"pub") { return 9 }
  if matches(source, start, end, b"static") { return tokenStatic }
  if matches(source, start, end, b"compileError") { return tokenCompileError }
  if matches(source, start, end, b"struct") { return 10 }
  if matches(source, start, end, b"tuple") { return tokenTuple }
  if matches(source, start, end, b"effect") { return 11 }
  if matches(source, start, end, b"fn") { return 12 }
  if matches(source, start, end, b"run") { return 13 }
  if matches(source, start, end, b"fail") { return 14 }
  if matches(source, start, end, b"drop") { return 15 }
  if matches(source, start, end, b"unsafe") { return 16 }
  if matches(source, start, end, b"impl") { return 17 }
  if matches(source, start, end, b"for") { return 18 }
  if matches(source, start, end, b"return") { return 19 }
  if matches(source, start, end, b"import") { return 20 }
  if matches(source, start, end, b"as") { return 21 }
  if matches(source, start, end, b"let") { return 22 }
  if matches(source, start, end, b"mut") { return 23 }
  if matches(source, start, end, b"once") { return 24 }
  if matches(source, start, end, b"move") { return 25 }
  if matches(source, start, end, b"match") { return 26 }
  if matches(source, start, end, b"if") { return 27 }
  if matches(source, start, end, b"else") { return 28 }
  if matches(source, start, end, b"while") { return 29 }
  if matches(source, start, end, b"break") { return 30 }
  if matches(source, start, end, b"continue") { return 31 }
  if matches(source, start, end, b"true") { return 32 }
  if matches(source, start, end, b"false") { return 33 }
  if matches(source, start, end, b"const") { return tokenConst }
  if matches(source, start, end, b"service") { return tokenService }
  if matches(source, start, end, b"interface") { return tokenInterface }
  if matches(source, start, end, b"role") { return tokenRole }
  if matches(source, start, end, b"enum") { return tokenEnum }
  if matches(source, start, end, b"union") { return tokenUnion }
  if matches(source, start, end, b"type") { return tokenType }
  if matches(source, start, end, b"extern") { return tokenExtern }
  if matches(source, start, end, b"export") { return tokenExport }
  return tokenIdentifier
}

fn punctuationKind(byte: u8) -> u8 {
  if byte == 40 { return 34 }
  if byte == 41 { return 35 }
  if byte == 123 { return 36 }
  if byte == 125 { return 37 }
  if byte == 91 { return 38 }
  if byte == 93 { return 39 }
  if byte == 58 { return 40 }
  if byte == 59 { return 41 }
  if byte == 44 { return 42 }
  if byte == 61 { return 43 }
  if byte == 45 { return 46 }
  if byte == 43 { return 47 }
  if byte == 42 { return 48 }
  if byte == 47 { return 49 }
  if byte == 37 { return 50 }
  if byte == 33 { return 51 }
  if byte == 63 { return 53 }
  if byte == 64 { return 54 }
  if byte == 60 { return 55 }
  if byte == 62 { return 57 }
  if byte == 124 { return 59 }
  if byte == 38 { return 61 }
  if byte == 94 { return tokenCaret }
  if byte == 126 { return tokenTilde }
  if byte == 46 { return 62 }
  return 65
}

fn compoundPunctuationKind(source: &[u8], index: usize) -> u8 {
  if hasPair(source, index, 61, 61) { return 44 }
  if hasPair(source, index, 61, 62) { return 45 }
  if hasPair(source, index, 33, 61) { return 52 }
  if hasPair(source, index, 60, 61) { return 56 }
  if hasPair(source, index, 62, 61) { return 58 }
  if hasPair(source, index, 124, 62) { return 60 }
  if hasPair(source, index, 124, 124) { return tokenPipePipe }
  if hasPair(source, index, 38, 38) { return tokenAmpersandAmpersand }
  if hasPair(source, index, 46, 46) { return 63 }
  if hasPair(source, index, 45, 62) { return 64 }
  return 65
}

fn scanWhitespace(source: &[u8], start: usize) -> usize {
  let mut index = start + 1
  while index < source.length {
    if !isWhitespace(source[index]) { return index }
    index = index + 1
  }
  return index
}

fn scanComment(source: &[u8], start: usize) -> usize {
  let mut index = start + 2
  while index < source.length {
    let byte = source[index]
    if byte == 10 { return index }
    if byte == 13 { return index }
    index = index + 1
  }
  return index
}

fn commentKind(source: &[u8], start: usize) -> u8 {
  if byteAtOrZero(source, start + 2) == 33 { return 3 }
  if byteAtOrZero(source, start + 2) == 47 {
    if byteAtOrZero(source, start + 3) != 47 { return 2 }
  }
  return 1
}

fn scanLiteral(
  source: &[u8],
  start: usize,
  modifierWidth: usize,
  delimiterWidth: usize,
  kind: u8,
  alwaysInvalid: bool,
  raw: bool
) -> Decision {
  let mut index = start + modifierWidth + delimiterWidth
  while index < source.length {
    let byte = source[index]
    if delimiterWidth == 1 {
      if byte == 10 { return Decision { kind: tokenInvalidStaticLiteral, end: index, invalid: true } }
      if byte == 13 { return Decision { kind: tokenInvalidStaticLiteral, end: index, invalid: true } }
    }
    if byte == 34 {
      if delimiterWidth == 1 {
        if alwaysInvalid {
          return Decision { kind: tokenInvalidStaticLiteral, end: index + 1, invalid: true }
        }
        return Decision { kind: kind, end: index + 1, invalid: false }
      }
      if hasTripleQuote(source, index) {
        if alwaysInvalid {
          return Decision { kind: tokenInvalidStaticLiteral, end: index + 3, invalid: true }
        }
        return Decision { kind: kind, end: index + 3, invalid: false }
      }
    }
    let mut escaping = byte == 92
    if raw { escaping = false }
    if escaping {
      if index + 1 < source.length {
        let escaped = source[index + 1]
        if delimiterWidth == 1 {
          if escaped == 10 { index = index + 1 } else {
            if escaped == 13 { index = index + 1 } else { index = index + 2 }
          }
        } else { index = index + 2 }
      } else { index = index + 1 }
    } else {
      index = index + 1
    }
  }
  return Decision { kind: tokenInvalidStaticLiteral, end: index, invalid: true }
}

fn scalarCount(source: &[u8], contentStart: usize, end: usize) -> usize {
  let mut index = contentStart
  let mut scalars = usize.add(0, 0)
  while index < end {
    scalars = scalars + 1
    if source[index] != 92 {
      index = index + 1
      while index < end {
        let byte = source[index]
        if byte < 128 { break }
        if byte > 191 { break }
        index = index + 1
      }
    } else {
      let escaped = byteAtOrZero(source, index + 1)
      let opensBrace = byteAtOrZero(source, index + 2) == 123
      if escaped == 117 {
        if opensBrace {
          index = index + 3
          while index < end {
            if source[index] == 125 { break }
            index = index + 1
          }
          index = index + 1
        } else { index = index + 2 }
      } else {
        if escaped == 120 { index = index + 4 } else { index = index + 2 }
      }
    }
  }
  return scalars
}

fn scanCharLiteral(source: &[u8], start: usize) -> Decision {
  let mut index = start + 1
  while index < source.length {
    let byte = source[index]
    if byte == 10 { return Decision { kind: tokenInvalidStaticLiteral, end: index, invalid: true } }
    if byte == 13 { return Decision { kind: tokenInvalidStaticLiteral, end: index, invalid: true } }
    if byte == 39 {
      if scalarCount(source, start + 1, index) == 1 {
        return Decision { kind: tokenCharLiteral, end: index + 1, invalid: false }
      }
      return Decision { kind: tokenInvalidStaticLiteral, end: index + 1, invalid: true }
    }
    if byte == 92 {
      if index + 1 < source.length {
        let escaped = source[index + 1]
        if escaped == 10 { index = index + 1 } else {
          if escaped == 13 { index = index + 1 } else { index = index + 2 }
        }
      } else { index = index + 1 }
    } else {
      index = index + 1
    }
  }
  return Decision { kind: tokenInvalidStaticLiteral, end: index, invalid: true }
}

fn scanIdentifier(source: &[u8], start: usize) -> usize {
  let mut index = start + 1
  while index < source.length {
    if !isIdentifierContinue(source[index]) { return index }
    index = index + 1
  }
  return index
}

fn scanDurationCandidate(source: &[u8], start: usize) -> usize {
  let mut index = start
  while index < source.length {
    if !isIdentifierContinue(source[index]) { return index }
    index = index + 1
  }
  return index
}

fn durationUnitRank(source: &[u8], start: usize, end: usize) -> i32 {
  let width = end - start
  if width == 1 {
    let byte = source[start]
    if byte == 119 { return 0 }
    if byte == 100 { return 1 }
    if byte == 104 { return 2 }
    if byte == 109 { return 3 }
    if byte == 115 { return 4 }
    return -1
  }
  if width == 2 {
    if source[start + 1] != 115 { return -1 }
    let first = source[start]
    if first == 109 { return 5 }
    if first == 117 { return 6 }
    if first == 110 { return 7 }
  }
  return -1
}

fn subordinateAmountIsValid(
  source: &[u8],
  start: usize,
  end: usize,
  rank: i32
) -> bool {
  let mut significant = start
  while significant + 1 < end {
    if source[significant] != 48 { break }
    significant = significant + 1
  }
  let width = end - significant
  if rank == 1 {
    return width == 1 && source[significant] <= 54
  }
  if rank == 2 {
    if width < 2 { return true }
    if width > 2 { return false }
    if source[significant] < 50 { return true }
    return source[significant] == 50 && source[significant + 1] <= 51
  }
  if rank == 3 || rank == 4 {
    if width < 2 { return true }
    if width > 2 { return false }
    return source[significant] <= 53
  }
  if rank == 5 || rank == 6 || rank == 7 { return width <= 3 }
  return true
}

// Returns `end` for a valid literal, or the start of the first invalid component. Tokenization
// needs only the first lexical failure; the compiler owns the more specific diagnostic code.
fn invalidDurationStart(source: &[u8], start: usize, end: usize) -> usize {
  let mut index = start
  let mut previousRank = -1
  let mut component = 0
  while index < end {
    let componentStart = index
    while index < end {
      if !isDecimalDigit(source[index]) { break }
      index = index + 1
    }
    let amountEnd = index
    if amountEnd == componentStart { return componentStart }
    let unitStart = index
    while index < end {
      if !isAsciiLetter(source[index]) { break }
      index = index + 1
    }
    let rank = durationUnitRank(source, unitStart, index)
    if rank < 0 { return componentStart }
    if previousRank >= rank { return componentStart }
    if component > 0 {
      if !subordinateAmountIsValid(source, componentStart, amountEnd, rank) {
        return componentStart
      }
    }
    previousRank = rank
    component = component + 1
  }
  return end
}

fn scanNumber(source: &[u8], start: usize) -> Decision {
  let mut index = start + 1
  while index < source.length {
    if !isDecimalDigit(source[index]) { break }
    index = index + 1
  }
  let mut floating = false
  if byteAtOrZero(source, index) == 46 {
    if byteAtOrZero(source, index + 1) != 46 {
      if isDecimalDigit(byteAtOrZero(source, index + 1)) {
        floating = true
        index = index + 1
        while index < source.length {
          if !isDecimalDigit(source[index]) { break }
          index = index + 1
        }
      }
    }
  }
  let mut exponentDigits = true
  let exponent = byteAtOrZero(source, index)
  if exponent == 101 {
    floating = true
    index = index + 1
    let sign = byteAtOrZero(source, index)
    if sign == 43 { index = index + 1 }
    if sign == 45 { index = index + 1 }
    exponentDigits = isDecimalDigit(byteAtOrZero(source, index))
    while index < source.length {
      if !isDecimalDigit(source[index]) { break }
      index = index + 1
    }
  } else {
    if exponent == 69 {
      floating = true
      index = index + 1
      let sign = byteAtOrZero(source, index)
      if sign == 43 { index = index + 1 }
      if sign == 45 { index = index + 1 }
      exponentDigits = isDecimalDigit(byteAtOrZero(source, index))
      while index < source.length {
        if !isDecimalDigit(source[index]) { break }
        index = index + 1
      }
    }
  }
  if isAsciiLetter(byteAtOrZero(source, index)) {
    let end = scanDurationCandidate(source, index)
    let invalidStart = invalidDurationStart(source, start, end)
    if invalidStart == end {
      return Decision { kind: tokenDurationLiteral, end: end, invalid: false }
    }
    return Decision { kind: tokenInvalidDurationLiteral, end: end, invalid: true }
  }
  if !exponentDigits { return Decision { kind: 65, end: index, invalid: true } }
  if floating { return Decision { kind: 6, end: index, invalid: false } }
  return Decision { kind: 5, end: index, invalid: false }
}

fn nextToken(source: &[u8], start: usize) -> Decision {
  let byte = source[start]
  if isWhitespace(byte) {
    return Decision { kind: 0, end: scanWhitespace(source, start), invalid: false }
  }
  if isLineCommentStart(source, start) {
    return Decision { kind: commentKind(source, start), end: scanComment(source, start), invalid: false }
  }
  if isLiteralStart(source, start) {
    let mut kind = u8.add(7, 0)
    let mut modifierWidth = usize.add(0, 0)
    let mut raw = false
    if byte == 98 {
      kind = u8.add(8, 0)
      modifierWidth = usize.add(1, 0)
    }
    if byte == 114 {
      raw = true
      modifierWidth = usize.add(1, 0)
    }
    let quoteStart = start + modifierWidth
    let mut delimiterWidth = usize.add(1, 0)
    if hasTripleQuote(source, quoteStart) { delimiterWidth = usize.add(3, 0) }
    return scanLiteral(source, start, modifierWidth, delimiterWidth, kind, false, raw)
  }
  if isCharLiteralStart(byte) { return scanCharLiteral(source, start) }
  if isIdentifierStart(byte) {
    let end = scanIdentifier(source, start)
    if byteAtOrZero(source, end) == 34 {
      let mut delimiterWidth = usize.add(1, 0)
      if hasTripleQuote(source, end) { delimiterWidth = usize.add(3, 0) }
      return scanLiteral(
        source,
        start,
        end - start,
        delimiterWidth,
        tokenInvalidStaticLiteral,
        true,
        false
      )
    }
    return Decision { kind: keywordKind(source, start, end), end: end, invalid: false }
  }
  if isDecimalDigit(byte) { return scanNumber(source, start) }
  if isCompoundPunctuation(source, start) {
    return Decision { kind: compoundPunctuationKind(source, start), end: start + 2, invalid: false }
  }
  if isPunctuation(byte) {
    return Decision { kind: punctuationKind(byte), end: start + 1, invalid: false }
  }
  let mut end = start + 1
  while end < source.length {
    if isSupportedTokenStart(source, end) { break }
    end = end + 1
  }
  return Decision { kind: 65, end: end, invalid: true }
}

effect fn pushToken(
  tokens: &mut Vector<Token>,
  kind: u8,
  start: usize,
  end: usize
) -> () ! OutOfMemoryError ? &mut Allocator {
  let token = Token { kind: kind, start: start, end: end }
  return run Vector<Token>.append(move tokens, move token)
}

effect fn pushDiagnostic(
  diagnostics: &mut Vector<LexicalDiagnostic>,
  start: usize,
  end: usize
) -> () ! OutOfMemoryError ? &mut Allocator {
  let diagnostic = LexicalDiagnostic { start: start, end: end }
  return run Vector<LexicalDiagnostic>.append(move diagnostics, move diagnostic)
}

effect fn lex(source: &[u8]) -> Lexed ! OutOfMemoryError ? &mut Allocator {
  let mut tokens = Vector<Token>.make()
  let mut diagnostics = Vector<LexicalDiagnostic>.make()
  let mut index = usize.add(0, 0)
  while index < source.length {
    let decision = nextToken(source, index)
    let tokenAdded = run pushToken(&mut tokens, decision.kind, index, decision.end)
    if decision.invalid {
      let mut diagnosticStart = index
      if decision.kind == tokenInvalidDurationLiteral {
        diagnosticStart = invalidDurationStart(source, index, decision.end)
      }
      let diagnosticAdded = run pushDiagnostic(&mut diagnostics, diagnosticStart, decision.end)
    }
    index = decision.end
  }
  let eofAdded = run pushToken(&mut tokens, 66, source.length, source.length)
  return Lexed { tokens: move tokens, diagnostics: move diagnostics }
}

fn observeTokenKind(value: u8) -> u8 { return value }
fn observeTokenStart(value: usize) -> usize { return value }
fn observeTokenEnd(value: usize) -> usize { return value }
fn observeDiagnosticStart(value: usize) -> usize { return value }
fn observeDiagnosticEnd(value: usize) -> usize { return value }

fn fingerprintTokens(tokens: &Vector<Token>) -> i32 {
  let mut value = 0
  let mut index = usize.add(0, 0)
  while index < Vector<Token>.length(tokens) {
    let token = Vector<Token>.get(tokens, index)
    let kind = observeTokenKind(token.kind)
    let start = observeTokenStart(token.start)
    let end = observeTokenEnd(token.end)
    value = (value * 17 + u8.toI32(kind) + usize.toI32(start) * 3 + usize.toI32(end) * 5) % 197
    index = index + 1
  }
  return value
}

fn lineOf(source: &[u8], offset: usize) -> usize {
  let mut line = usize.add(0, 1)
  let mut index = usize.add(0, 0)
  while index < offset {
    if source[index] == asciiLineFeed { line = line + 1 }
    index = index + 1
  }
  return line
}

fn columnOf(source: &[u8], offset: usize) -> usize {
  let mut column = usize.add(0, 1)
  let mut index = usize.add(0, 0)
  while index < offset {
    column = column + 1
    if source[index] == asciiLineFeed { column = usize.add(0, 1) }
    index = index + 1
  }
  return column
}

struct DigestWriter { value: i32 }

effect fn digestWrite(self: &mut DigestWriter, bytes: &[u8]) -> () {
  let mut index = usize.add(0, 0)
  while index < bytes.length {
    self.value = (self.value * 19 + u8.toI32(bytes[index]) * 7) % 197
    index = index + 1
  }
  return ()
}

effect fn digestFlush(self: &mut DigestWriter) -> () { return () }

impl Writer for DigestWriter {
  writeAll: DigestWriter.digestWrite
  flush: DigestWriter.digestFlush
}

// Every number is a runtime value. Display streams it directly into the selected digest Writer,
// one line per diagnostic in lexical order, without allocating an intermediate String.
effect fn renderDiagnostics(
  source: &[u8],
  diagnostics: &Vector<LexicalDiagnostic>
) -> () ! WriterError ? &mut Writer {
  let mut index = usize.add(0, 0)
  while index < Vector<LexicalDiagnostic>.length(diagnostics) {
    let diagnostic = Vector<LexicalDiagnostic>.get(diagnostics, index)
    let start = observeDiagnosticStart(diagnostic.start)
    let end = observeDiagnosticEnd(diagnostic.end)
    run Writer.writeAll(b"LEX0001 at line ")
    let line = lineOf(source, start)
    run Format.display(&line)
    run Writer.writeAll(b" column ")
    let column = columnOf(source, start)
    run Format.display(&column)
    run Writer.writeAll(b"\n")
    index = index + 1
  }
  return ()
}

// The selected Writer folds each accepted byte, so a wrong line number remains a wrong answer on
// every supported target without materializing the rendered message.
effect fn digestVectors(
  source: &[u8],
  tokens: &Vector<Token>,
  diagnostics: &Vector<LexicalDiagnostic>
) -> i32 ! WriterError {
  let mut writer = DigestWriter { value: fingerprintTokens(tokens) }
  run renderDiagnostics(source, diagnostics) |> Effect.provideMut<Writer>(&mut writer)
  return writer.value
}

effect fn digest(
  source: &[u8],
  result: Lexed
) -> i32 ! OutOfMemoryError | WriterError ? &mut Allocator {
  return match &result {
    Lexed { tokens, diagnostics } => run digestVectors(source, &tokens, &diagnostics)
  }
}

fn verify(value: i32) -> () {
  // PRESSURE_EXPECTED: the harness replaces this literal only.
  if value != 83 { let mismatch = 1 / 0 }
  return ()
}

effect fn check(source: &[u8]) -> () ! OutOfMemoryError | WriterError ? &mut Allocator {
  let lexed = run lex(source)
  let value = run digest(source, move lexed)
  return verify(value)
}

pub effect fn main() -> () ! OutOfMemoryError | WriterError {
  let mut allocator = Allocator.systemAllocatorProvider()
  // PRESSURE_INPUT: the harness replaces this literal only.
  let source = b"pub fn main() -> i32 { return 42 }\n"
  return run check(source) |> Effect.provideMut(&mut allocator)
}
