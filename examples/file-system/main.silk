import silk.allocator { Allocator }
import silk.allocator { OutOfMemoryError }
import silk.allocator { SystemAllocator }
import silk.effect { Effect }
import silk.u8
import silk.usize
import silk.filesystem { DirectoryEntry, DirectoryInfo, FileError, FileInfo, FileSystem, Path }
import silk.bytes { Bytes }
import silk.vector { Vector }

/// A tiny application-owned provider. Browser code could replace this with a virtual filesystem.
struct MemoryFileSystem {
  bytes: [u8; 4]
  present: bool
}

fn emptyBytes() -> [u8; 4] {
  return [u8.toU8(0), u8.toU8(0), u8.toU8(0), u8.toU8(0)]
}

effect fn read(
  self: &mut MemoryFileSystem,
  target: &Path,
) -> Bytes ! FileError | OutOfMemoryError ? &mut Allocator {
  if self.present == false { fail FileSystem.error(FileSystem.readFileOperation(), FileSystem.notFound()) }
  let snapshot = self.bytes
  return run Bytes.copy(&snapshot)
}

effect fn write(
  self: &mut MemoryFileSystem,
  target: &Path,
  bytes: &[u8],
) -> () ! FileError {
  if bytes.length != usize.add(0, 4) { fail FileSystem.error(FileSystem.writeFileOperation(), FileSystem.notFound()) }
  let mut stored = Intrinsic.replace(self.bytes, emptyBytes())
  let mut index = usize.add(0, 0)
  while index < bytes.length {
    stored[index] = bytes[index]
    index = index + usize.add(0, 1)
  }
  self.bytes = move stored
  self.present = true
}

effect fn stat(
  self: &mut MemoryFileSystem,
  target: &Path,
) -> FileInfo | DirectoryInfo ! FileError {
  if self.present { return FileSystem.fileInfo(usize.add(0, 4)) }
  return FileSystem.directoryInfo()
}

effect fn list(
  self: &mut MemoryFileSystem,
  target: &Path,
) -> Vector<DirectoryEntry> ! FileError | OutOfMemoryError ? &mut Allocator {
  return Vector<DirectoryEntry>.make()
}

effect fn create(self: &mut MemoryFileSystem, target: &Path) -> () ! FileError { return () }

effect fn removeFile(self: &mut MemoryFileSystem, target: &Path) -> () ! FileError {
  if self.present == false { fail FileSystem.error(FileSystem.readFileOperation(), FileSystem.notFound()) }
  self.present = false
}

/// This example holds one file, so renaming it leaves that one file in place.
effect fn rename(self: &mut MemoryFileSystem, from: &Path, to: &Path) -> () ! FileError {
  if self.present == false { fail FileSystem.error(FileSystem.renameOperation(), FileSystem.notFound()) }
}

effect fn removeDirectory(self: &mut MemoryFileSystem, target: &Path) -> () ! FileError {
  return ()
}

/// This example holds one file, so there is no namespace to make a unique name in.
effect fn createTemporaryDirectory(
  self: &mut MemoryFileSystem,
  parent: &Path,
  prefix: &[u8],
) -> Path ! FileError | OutOfMemoryError ? &mut Allocator {
  fail FileSystem.error(FileSystem.createTemporaryDirectoryOperation(), FileSystem.unsupported())
}

impl FileSystem for MemoryFileSystem {
  readFile: MemoryFileSystem.read
  writeFile: MemoryFileSystem.write
  stat: MemoryFileSystem.stat
  listDirectory: MemoryFileSystem.list
  createDirectory: MemoryFileSystem.create
  removeFile: MemoryFileSystem.removeFile
  rename: MemoryFileSystem.rename
  removeDirectory: MemoryFileSystem.removeDirectory
  createTemporaryDirectory: MemoryFileSystem.createTemporaryDirectory
}

fn checksum(bytes: &[u8]) -> i32 {
  let mut total = 0
  let mut index = usize.add(0, 0)
  while index < bytes.length {
    total = total + u8.toI32(bytes[index])
    index = index + usize.add(0, 1)
  }
  return total
}

effect fn example() -> i32 ! FileError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut files = MemoryFileSystem {
    bytes: emptyBytes(),
    present: false,
  }
  let target = run Path.make("/notes/todo.bin") |> Effect.provideMut(&mut allocator)
  let message = [u8.toU8(10), u8.toU8(11), u8.toU8(12), u8.toU8(9)]
  let written = run Intrinsic.bindRequirementMut(
    Intrinsic.bindRequirementMut(FileSystem.writeFileWithParents(&target, &message), &mut files),
    &mut allocator,
  )
  if run FileSystem.exists(&target) |> Effect.provideMut(&mut files) {} else { return 1 }
  let owned = run Intrinsic.bindRequirementMut(
    Intrinsic.bindRequirementMut(FileSystem.readFile(&target), &mut files),
    &mut allocator,
  )
  return checksum(Bytes.asSlice(&owned))
}

effect fn recover(error: FileError | OutOfMemoryError) -> i32 { return 2 }

pub fn main() -> i32 { return run Effect.catchAll(example(), recover) }
