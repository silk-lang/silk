import silk.machine.actor { Signal }
import silk.machine.chart { Chart }
import silk.machine.simple { Simple, SimpleChart, SimpleMachine, SimpleSnapshot }
import silk.machine.snapshot { Status, TransitionLoopError }
import silk.concurrency.channel { Channel, Sender }
import silk.concurrency.fiber { Cancelled, Fiber }
import silk.concurrency.local_scheduler { LocalScheduler, StalledError }
import silk.concurrency.scheduler { Scheduler, TaskIdExhaustedError }
import silk.core.effect { Effect }
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StdoutWriter }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.monotonic_clock { MonotonicClock }
import silk.system.monotonic_clock_native { OsMonotonicClock }
import silk.system.system_clock { SystemClock }
import silk.system.system_clock_native { OsSystemClock }

union Lamp {
  Off,
  On
}

union LampEvent {
  Toggle,
}

// A lamp that a switch turns on and off, and that turns itself off after two seconds.
impl SimpleMachine<LampEvent> for Lamp {
  static fn chart() -> SimpleChart<Lamp, LampEvent> {
    return Simple.chart<Lamp, LampEvent>()
      |> Chart.initial(Lamp.Off)
      |> Chart.on("Off", "Toggle", Lamp.On)
      |> Chart.on("On", "Toggle", Lamp.Off)
      |> Chart.after("On", 2s, Lamp.Off)
  }
}

// Called with the lamp after every change.
effect fn show(lamp: &SimpleSnapshot<Lamp, LampEvent>) -> ()
  ! WriterError
  ? &mut Writer {
  match &lamp.status {
    Status.Stopped => {
      return run Writer.writeAll(b"stopped\n")
    }
    _ => {}
  }
  match &lamp.value {
    Lamp.Off => run Writer.writeAll(b"the lamp is off\n")
    Lamp.On => run Writer.writeAll(b"the lamp is on\n")
  }
  return ()
}

// Someone who presses the switch, waits, and leaves after three seconds.
effect fn person(switch: Sender<Signal<LampEvent>>) -> ()
  ? &mut MonotonicClock {
  drop run switch.send(Signal<LampEvent>.Event { event: LampEvent.Toggle })
  run MonotonicClock.waitFor(3s)
  drop run switch.send(Signal<LampEvent>.Stop)
  drop switch
  return ()
}

effect fn play() -> ()
  ! OutOfMemoryError | TransitionLoopError | TaskIdExhaustedError | WriterError | Cancelled
  ? &mut Scheduler | &mut MonotonicClock {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut clock = OsSystemClock.make()
  let mut out = StdoutWriter.make()
  let channel = run Channel<Signal<LampEvent>>.make(4)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let Channel<Signal<LampEvent>> { sender, receiver } = move channel
  let visitor = run Fiber<(), never>.forkChild(
    person(run sender.clone() |> Effect.provideMut<Allocator>(&mut allocator)),
  )

  // The lamp runs by itself from here: it takes the events the person sends, and the clock
  // turns it off two seconds after it was turned on.
  let mut lamp = run Simple.begin<Lamp, LampEvent>(0)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run show(&lamp) |> Effect.provideMut<Writer>(&mut out)
  run Simple.play(&mut lamp, &sender, &receiver, show)
    |> Effect.provideMut<Writer>(&mut out)
    |> Effect.provideMut<SystemClock>(&mut clock)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run visitor.join()
  return ()
}

pub effect fn main() -> i32
  ! OutOfMemoryError
    | TransitionLoopError
    | TaskIdExhaustedError
    | WriterError
    | Cancelled
    | StalledError {
  let mut clock = OsMonotonicClock.make()
  let mut scheduler = LocalScheduler.make()
  run scheduler.execute<
    (),
    OutOfMemoryError | TransitionLoopError | TaskIdExhaustedError | WriterError | Cancelled
  >(play())
    |> Effect.provideMut<MonotonicClock>(&mut clock)
  return 0
}
