import silk.mem.allocator { Allocator }
import silk.mem.allocator { OutOfMemoryError }
import silk.mem.allocator { SystemAllocator }
import silk.core.effect { Effect }
import silk.core.ownership { Copy }
import silk.num.usize
import silk.collections.list { List }

struct QueueEntry {
  cell: usize,
  distance: usize,
}

impl Copy for QueueEntry {}

effect fn search() -> usize ! OutOfMemoryError ? &mut Allocator {
  let mut visited = [
    false, false, false, false, false,
    false, false, false, false, false,
    false, false, false, false, false,
    false, false, false, false, false,
    false, false, false, false, false
  ]
  let mut queue = List<QueueEntry>.make()
  visited[0] = true
  let first = QueueEntry { cell: usize.add(0, 0), distance: usize.add(0, 0) }
  let started = run List<QueueEntry>.append(&mut queue, move first)
  let mut cursor = usize.add(0, 0)

  while cursor < List<QueueEntry>.length(&queue) {
    let current = List<QueueEntry>.get(&queue, cursor)
    cursor = cursor + 1
    if current.cell == 24 {
      return current.distance
    }
    let row = current.cell / 5
    let column = current.cell % 5
    let nextDistance = current.distance + 1

    if row > 0 {
      let neighbor = current.cell - 5
      if !visited[neighbor] {
        visited[neighbor] = true
        let entry = QueueEntry { cell: neighbor, distance: nextDistance }
        let appended = run List<QueueEntry>.append(&mut queue, move entry)
      }
    }
    if column > 0 {
      let neighbor = current.cell - 1
      if !visited[neighbor] {
        visited[neighbor] = true
        let entry = QueueEntry { cell: neighbor, distance: nextDistance }
        let appended = run List<QueueEntry>.append(&mut queue, move entry)
      }
    }
    if column < 4 {
      let neighbor = current.cell + 1
      if !visited[neighbor] {
        visited[neighbor] = true
        let entry = QueueEntry { cell: neighbor, distance: nextDistance }
        let appended = run List<QueueEntry>.append(&mut queue, move entry)
      }
    }
    if row < 4 {
      let neighbor = current.cell + 5
      if !visited[neighbor] {
        visited[neighbor] = true
        let entry = QueueEntry { cell: neighbor, distance: nextDistance }
        let appended = run List<QueueEntry>.append(&mut queue, move entry)
      }
    }
  }
  return usize.add(0, 0)
}

fn verifyShortestDistance(distance: usize) -> () {
  if distance != 8 {
    Intrinsic.trap("unexpected failure")
  }
  return ()
}

pub effect fn main() -> () ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run search()
    |> Effect.map(verifyShortestDistance)
    |> Effect.provideMut(&mut allocator)
}
