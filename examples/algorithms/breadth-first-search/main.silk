import silk.allocator { Allocator }
import silk.allocator { OutOfMemoryError }
import silk.allocator { SystemAllocator }
import silk.effect { Effect }
import silk.usize
import silk.vector { Vector }

struct QueueEntry {
  cell: usize
  distance: usize
}

impl Copy for QueueEntry {}

effect fn search() -> usize ! OutOfMemoryError ? &mut Allocator {
  let mut visited = [
    false, false, false, false, false,
    false, false, false, false, false,
    false, false, false, false, false,
    false, false, false, false, false,
    false, false, false, false, false
  ]
  let mut queue = Vector<QueueEntry>.make()
  visited[0] = true
  let first = QueueEntry { cell: usize.add(0, 0), distance: usize.add(0, 0) }
  let started = run Vector<QueueEntry>.append(&mut queue, move first)
  let mut cursor = usize.add(0, 0)

  while cursor < Vector<QueueEntry>.length(&queue) {
    let current = Vector<QueueEntry>.get(&queue, cursor)
    cursor = cursor + 1
    if current.cell == 24 {
      return current.distance
    }
    let row = current.cell / 5
    let column = current.cell % 5
    let nextDistance = current.distance + 1

    if row > 0 {
      let neighbor = current.cell - 5
      if !visited[neighbor] {
        visited[neighbor] = true
        let entry = QueueEntry { cell: neighbor, distance: nextDistance }
        let appended = run Vector<QueueEntry>.append(&mut queue, move entry)
      }
    }
    if column > 0 {
      let neighbor = current.cell - 1
      if !visited[neighbor] {
        visited[neighbor] = true
        let entry = QueueEntry { cell: neighbor, distance: nextDistance }
        let appended = run Vector<QueueEntry>.append(&mut queue, move entry)
      }
    }
    if column < 4 {
      let neighbor = current.cell + 1
      if !visited[neighbor] {
        visited[neighbor] = true
        let entry = QueueEntry { cell: neighbor, distance: nextDistance }
        let appended = run Vector<QueueEntry>.append(&mut queue, move entry)
      }
    }
    if row < 4 {
      let neighbor = current.cell + 5
      if !visited[neighbor] {
        visited[neighbor] = true
        let entry = QueueEntry { cell: neighbor, distance: nextDistance }
        let appended = run Vector<QueueEntry>.append(&mut queue, move entry)
      }
    }
  }
  return usize.add(0, 0)
}

fn verifyShortestDistance(distance: usize) -> () {
  if distance != 8 {
    let invalid = 1 / 0
  }
  return ()
}

pub effect fn main() -> () ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run search()
    |> Effect.map(verifyShortestDistance)
    |> Effect.provideMut(&mut allocator)
}
