import silk.num.usize
fn multiply(left: &[i32], right: &[i32]) -> [i32; 4] {
  let mut output = [0, 0, 0, 0]
  let mut row = usize.add(0, 0)
  while row < 2 {
    let mut column = usize.add(0, 0)
    while column < 2 {
      let mut inner = usize.add(0, 0)
      let mut cell = 0
      while inner < 3 {
        cell = cell + left[row * 3 + inner] * right[inner * 2 + column]
        inner = inner + 1
      }
      output[row * 2 + column] = cell
      column = column + 1
    }
    row = row + 1
  }
  return output
}

pub fn main() -> i32 {
  let left = [1, 2, 3, 4, 5, 6]
  let right = [7, 8, 9, 10, 11, 12]
  let product = multiply(&left, &right)
  return product[0] + product[1] - product[2] + product[3]
}
