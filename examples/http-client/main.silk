//! GET with a query, POST JSON, and a 404 through `silk.http.client`. Run all three: `silk run`
//! Select one with `silk run -- get`, `silk run -- post`, or `silk run -- status`.
//! Use another httpbingo-compatible server: `silk run -- all http://127.0.0.1:8080`
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.format { Debug, Format, Formatter }
import silk.system.host_input { HostInput, HostInputError }
import silk.http.client { Http, HttpError, Request, Response }
import silk.http.client_native { NativeHttp }
import silk.option { Option }
import silk.io.writer_native { StdoutWriter }
import silk.core.result { Result }
import silk.text.string { String }
import silk.io.writer { Writer, WriterError }

pub struct DemoError {
  pub message: string<'static>,
}

impl Debug for DemoError {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return run Format.debugFields(self, "DemoError", &mut formatter)
  }
}

effect fn show(name: string, response: &Response, expected: u16) -> () ! DemoError | WriterError ? &mut Writer {
  run Format.format("\n{name}: HTTP {status}\n", &.{ name: name, status: response.status() })
  run Writer.writeAll(response.body())
  run Writer.writeString("\n")
  if response.status() != expected {
    fail DemoError { message: "Unexpected HTTP status for this demo." }
  }
}

effect fn demos(mode: string, base: string) -> ()
  ! DemoError | HttpError | WriterError | OutOfMemoryError
  ? &mut Http | &mut Writer | &mut Allocator {
  if mode == "all" || mode == "get" {
    let response = run Http.send(Request.get(base).path("/get").query("language", "Silk"))
    run show("get", &response, 200)
  }
  if mode == "all" || mode == "post" {
    let request = run Request.post(base).path("/post").json(&.{ language: "Silk", message: "Hello over HTTP!" })
    let response = run Http.send(move request)
    run show("post", &response, 200)
  }
  if mode == "all" || mode == "status" {
    // A 404 is a response. `run response.expectOk()` turns it into a failure.
    let response = run Http.send(Request.get(base).path("/status/404"))
    run show("status", &response, 404)
  }
}

effect fn argument(index: usize, fallback: string) -> String
  ! DemoError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  return match move run HostInput.argument(index) {
    Option.None => run String.copy(fallback)
    Option.Some { value } => match move run String.copyUtf8(Bytes.asSlice(&value)) {
      Result.Success { value: text } => move text
      Result.Failure { error } => { fail DemoError { message: "Arguments must be UTF-8." } }
    }
  }
}

effect fn program() -> () ! DemoError | HttpError | HostInputError | WriterError | OutOfMemoryError ? &mut HostInput | &mut Allocator {
  let mode = run argument(1, "all")
  let base = run argument(2, "https://httpbingo.org")
  let mut writer = StdoutWriter.make()
  let mut http = run NativeHttp.fromEnvironment()
  run demos(String.view(&mode), String.view(&base))
    |> Effect.provideMut<Http>(&mut http)
    |> Effect.provideMut<Writer>(&mut writer)
}

pub effect fn main() -> () ! DemoError | HttpError | HostInputError | WriterError | OutOfMemoryError ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  run program() |> Effect.provideMut<Allocator>(&mut allocator)
}
