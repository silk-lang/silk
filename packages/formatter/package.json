{
  "name": "@silklang/formatter",
  "version": "0.0.0",
  "private": true,
  "description": "Canonical whole-source formatting for Silk, including active Silk examples in source documentation.",
  "keywords": [
    "documentation",
    "formatter",
    "silk"
  ],
  "homepage": "https://github.com/julia-script/silk#readme",
  "bugs": {
    "url": "https://github.com/julia-script/silk/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julia-script/silk.git",
    "directory": "packages/formatter"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./Formatter": {
      "types": "./dist/Formatter.d.ts",
      "import": "./dist/Formatter.js"
    },
    "./FormatterError": {
      "types": "./dist/FormatterError.d.ts",
      "import": "./dist/FormatterError.js"
    }
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@silklang/compiler": "workspace:*",
    "@silklang/docgen": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "^24.10.1"
  }
}
