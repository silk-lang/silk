//! IEEE binary32 values with deterministic representation, classification, and math operations.
//!
//! # When to use
//! Use `f32` when binary32 storage, interchange, or bandwidth is part of the contract. Use `f64`
//! for general floating-point work and unconstrained literals; it preserves substantially more
//! precision and is Silk's default floating type.
//!
//! # Details
//! Basic arithmetic rounds to nearest with ties to even and never enables implicit fast-math
//! assumptions. Division by zero and overflow produce IEEE infinities or NaNs rather than integer-
//! style traps. Ordinary ordered comparisons return false for NaN and treat both zeros as equal;
//! [`totalOrder`] distinguishes every encoding when deterministic ordering is required.
//!
//! [`toBits`] and [`fromBits`] expose the exact binary32 representation, including signed zero and
//! NaN payloads. The source-defined rounding, extrema, sign, and square-root helpers canonicalize
//! NaN results so native and WebAssembly execution agree on their bits.
//!
//! # Gotchas
//! Converting to an integer discards the fractional part and traps for NaN, infinity, or a value
//! outside the destination range. The `checkedTo*` counterparts return `None` on exactly those
//! inputs instead of trapping. Converting a large integer to f32 can round it.
//!
//! # Examples
//! ## Inspect a binary32 boundary by its bits
//! ```silk
//! import silk.f32
//!
//! pub fn main() -> i32 {
//!   let rounded = f32.round(-0.25)
//!   if f32.toBits(rounded) != f32.toBits(-0.0) {
//!     return 1
//!   }
//!   if !f32.isNaN(f32.sqrt(-1.0)) {
//!     return 2
//!   }
//!   return 42
//! }
//! ```

import silk.bool
import silk.f64
import silk.i16
import silk.i32
import silk.i64
import silk.i8
import silk.isize
import silk.option { Option }
import silk.target { pointerBits }
import silk.u16
import silk.u32
import silk.u64
import silk.u8
import silk.usize

/// The largest finite `f32` value.
pub const MAX: f32 = 3.4028235e38

/// The most negative finite `f32` value, which is the negation of [`MAX`].
pub const MIN: f32 = -3.4028235e38

/// The distance from `1.0` to the next larger `f32` value.
pub const EPSILON: f32 = 1.1920929e-7

/// Positive infinity with the binary32 bit pattern `0x7F800000`.
///
/// # Details
///
/// No source literal spells infinity directly. This initializer deliberately exceeds [`MAX`], and
/// decimal-to-binary32 rounding produces the infinity encoding.
pub const INFINITY: f32 = 1e999

/// The ratio of a circle's circumference to its diameter, rounded to the nearest `f32` value.
pub const PI: f32 = 3.1415927

/// Euler's number, rounded to the nearest `f32` value.
pub const E: f32 = 2.7182817

/// Returns `value` with its sign reversed.
pub fn negate(value: f32) -> f32 {
  return Intrinsic.f32Negate(value)
}

/// Returns `left + right`, rounded to nearest with ties to even. Overflow produces infinity; it
/// does not trap.
pub fn add(left: f32, right: f32) -> f32 {
  return Intrinsic.f32Add(left, right)
}

/// Returns `left - right`, rounded to nearest with ties to even. Overflow produces infinity; it
/// does not trap.
pub fn subtract(left: f32, right: f32) -> f32 {
  return Intrinsic.f32Subtract(left, right)
}

/// Returns `left * right`, rounded to nearest with ties to even. Overflow produces infinity; it
/// does not trap.
pub fn multiply(left: f32, right: f32) -> f32 {
  return Intrinsic.f32Multiply(left, right)
}

/// Returns `left / right`, rounded to nearest with ties to even. Division by zero produces
/// infinity or NaN; it does not trap.
pub fn divide(left: f32, right: f32) -> f32 {
  return Intrinsic.f32Divide(left, right)
}

/// Returns `left - trunc(left / right) * right`. A zero `right`, infinite `left`, or NaN operand
/// produces NaN; it does not trap.
pub fn remainder(left: f32, right: f32) -> f32 {
  return Intrinsic.f32Remainder(left, right)
}

/// Returns `true` when both values compare equal. Returns `false` if either value is NaN.
pub fn equals(left: f32, right: f32) -> bool {
  return Intrinsic.f32Equals(left, right)
}

/// Returns `true` when values do not compare equal, including when either value is NaN.
pub fn notEquals(left: f32, right: f32) -> bool {
  return Intrinsic.f32NotEquals(left, right)
}

/// Returns `true` when `left` is less than `right`. Returns `false` if either value is NaN.
pub fn lessThan(left: f32, right: f32) -> bool {
  return Intrinsic.f32LessThan(&left, &right)
}

/// Returns `true` when `left` is less than or equal to `right`. Returns `false` for NaN.
pub fn lessOrEqual(left: f32, right: f32) -> bool {
  return Intrinsic.f32LessOrEqual(left, right)
}

/// Returns `true` when `left` is greater than `right`. Returns `false` if either value is NaN.
pub fn greaterThan(left: f32, right: f32) -> bool {
  return Intrinsic.f32GreaterThan(left, right)
}

/// Returns `true` when `left` is greater than or equal to `right`. Returns `false` for NaN.
pub fn greaterOrEqual(left: f32, right: f32) -> bool {
  return Intrinsic.f32GreaterOrEqual(left, right)
}

/// Returns `true` when `value` is a NaN.
pub fn isNaN(value: f32) -> bool {
  return Intrinsic.f32IsNaN(value)
}

/// Returns `true` when `value` is positive or negative infinity.
pub fn isInfinite(value: f32) -> bool {
  return Intrinsic.f32IsInfinite(value)
}

/// Returns `true` when `value` is neither infinity nor NaN.
pub fn isFinite(value: f32) -> bool {
  return Intrinsic.f32IsFinite(value)
}

/// Returns `true` when `value` is finite, nonzero, and not subnormal.
pub fn isNormal(value: f32) -> bool {
  return Intrinsic.f32IsNormal(value)
}

/// Returns `true` when `value` is finite and has subnormal magnitude.
pub fn isSubnormal(value: f32) -> bool {
  return Intrinsic.f32IsSubnormal(value)
}

/// Returns `true` when the sign bit of `value` is set, including for zero and NaN.
pub fn isSignNegative(value: f32) -> bool {
  return Intrinsic.f32IsSignNegative(value)
}

/// Reports whether `left` precedes or equals `right` in the IEEE total order.
///
/// # When to use
///
/// Use this function for deterministic ordering that includes NaNs and distinguishes signed zero.
///
/// # Details
///
/// Unlike ordinary comparison, this order distinguishes negative and positive zero and provides a
/// deterministic position for NaN encodings.
pub fn totalOrder(left: f32, right: f32) -> bool {
  return Intrinsic.f32TotalOrder(left, right)
}

/// Reinterprets a value as its exact 32-bit IEEE representation.
///
/// # When to use
///
/// Use this function to inspect or preserve representation bits. It does not convert the number.
pub fn toBits(value: f32) -> u32 {
  return Intrinsic.f32ToBits(value)
}

/// Reinterprets an arbitrary 32-bit pattern as `f32` without numeric conversion.
///
/// # When to use
///
/// Use this function to construct a value from representation bits, including NaN and signed zero.
pub fn fromBits(value: u32) -> f32 {
  return Intrinsic.f32FromBits(value)
}

// One stable NaN result for source-defined operations whose public contract requires canonical
// bits across all execution engines.
fn canonicalNaN() -> f32 {
  return fromBits(2143289344)
}

/// Computes the correctly rounded square root and preserves either signed zero.
///
/// # Details
///
/// IEEE requires square root to be correctly rounded, so its native and WebAssembly instructions
/// have one admissible numeric result.
///
/// # Gotchas
///
/// NaN and negative nonzero inputs return the canonical quiet NaN. Negative zero is not treated as
/// negative and returns unchanged.
pub fn sqrt(value: f32) -> f32 {
  if Intrinsic.f32IsNaN(value) { return canonicalNaN() }
  // Negative zero compares equal to zero and so passes through to the primitive, which returns it
  // unchanged as IEEE-754 requires.
  if value < 0.0 { return canonicalNaN() }
  return Intrinsic.f32Sqrt(value)
}

/// Returns the magnitude of `value`, which clears the sign bit. A NaN input gives the canonical
/// NaN.
pub fn abs(value: f32) -> f32 {
  if Intrinsic.f32IsNaN(value) { return canonicalNaN() }
  return fromBits(u32.bitAnd(toBits(value), 2147483647))
}

/// Returns the magnitude of `magnitude` with the sign bit of `sign`. A NaN `magnitude` gives the
/// canonical NaN rather than a signed NaN.
pub fn copysign(magnitude: f32, sign: f32) -> f32 {
  if Intrinsic.f32IsNaN(magnitude) { return canonicalNaN() }
  let carried = u32.bitAnd(toBits(magnitude), 2147483647)
  let transferred = u32.bitAnd(toBits(sign), 2147483648)
  return fromBits(u32.bitOr(carried, transferred))
}

/// Rounds toward zero while preserving the sign of a zero result.
///
/// # Details
///
/// A value in `(-1.0, -0.0]` becomes negative zero. A NaN becomes the canonical quiet NaN, while
/// either infinity is already integral and returns unchanged.
pub fn trunc(value: f32) -> f32 {
  if Intrinsic.f32IsNaN(value) { return canonicalNaN() }
  let bits = toBits(value)
  let biased = u32.bitAnd(u32.shiftRight(bits, 23), 255)
  // Below 1.0 nothing integral survives, so only the sign is kept.
  if biased < 127 { return fromBits(u32.bitAnd(bits, 2147483648)) }
  // At or past 2^23 every representable value is already an integer, infinities included.
  if biased >= 150 { return value }
  let discarded = u32.subtract(150, biased)
  let kept = u32.bitNot(u32.shiftLeft(1, discarded) - 1)
  return fromBits(u32.bitAnd(bits, kept))
}

/// Returns the largest integral `f32` that is not greater than `value`. A NaN input gives the
/// canonical NaN.
pub fn floor(value: f32) -> f32 {
  if Intrinsic.f32IsNaN(value) { return canonicalNaN() }
  let truncated = trunc(value)
  // Only a negative non-integral value truncates upward, and it is always below 2^23, so the
  // subtraction is exact.
  if truncated > value { return truncated - 1.0 }
  return truncated
}

/// Returns the smallest integral `f32` that is not less than `value`. A NaN input gives the
/// canonical NaN.
pub fn ceil(value: f32) -> f32 {
  if Intrinsic.f32IsNaN(value) { return canonicalNaN() }
  let truncated = trunc(value)
  if truncated < value { return truncated + 1.0 }
  return truncated
}

/// Rounds to the nearest integral f32, with a half rounded away from zero.
///
/// # Details
///
/// This differs from the ties-to-even policy used by basic arithmetic. A zero result keeps its
/// input sign, and a NaN becomes the canonical quiet NaN.
pub fn round(value: f32) -> f32 {
  if Intrinsic.f32IsNaN(value) { return canonicalNaN() }
  let truncated = trunc(value)
  // Exact: below 2^23 the difference is representable, and at or past it the fraction is zero.
  // An infinity leaves a NaN here, whose comparison is false, so the truncated infinity stands.
  let fraction = value - truncated
  if abs(fraction) < 0.5 { return truncated }
  return truncated + copysign(1.0, value)
}

/// Returns the lesser value and orders negative zero below positive zero. If an operand is NaN,
/// returns the canonical NaN.
pub fn min(left: f32, right: f32) -> f32 {
  if Intrinsic.f32IsNaN(left) { return canonicalNaN() }
  if Intrinsic.f32IsNaN(right) { return canonicalNaN() }
  if left < right { return left }
  if right < left { return right }
  // The operands compare equal, so only a zero's sign is left to separate them.
  if Intrinsic.f32IsSignNegative(left) { return left }
  return right
}

/// Returns the greater value and orders positive zero above negative zero. If an operand is NaN,
/// returns the canonical NaN.
pub fn max(left: f32, right: f32) -> f32 {
  if Intrinsic.f32IsNaN(left) { return canonicalNaN() }
  if Intrinsic.f32IsNaN(right) { return canonicalNaN() }
  if left > right { return left }
  if right > left { return right }
  if Intrinsic.f32IsSignNegative(left) { return right }
  return left
}

/// Approximates sine within four units in the last place using deterministic result bits.
///
/// # Details
///
/// NaN and either infinity return the canonical quiet NaN. Either signed zero returns unchanged.
pub fn sin(value: f32) -> f32 {
  return Intrinsic.f32Sin(value)
}

/// Approximates cosine within four units in the last place using deterministic result bits.
///
/// # Details
///
/// NaN and either infinity return the canonical quiet NaN. Either signed zero returns positive one.
pub fn cos(value: f32) -> f32 {
  return Intrinsic.f32Cos(value)
}

/// Returns the same binary32 value unchanged.
pub fn toF32(value: f32) -> f32 {
  return Intrinsic.f32ToF32(value)
}

/// Converts binary32 to the exactly equivalent `f64` value.
pub fn toF64(value: f32) -> f64 {
  return Intrinsic.f32ToF64(value)
}

/// Converts `value` toward zero to `u8`. Traps for NaN, infinity, or a result
/// outside the `u8` range.
pub fn toU8(value: f32) -> u8 {
  return Intrinsic.f32ToU8(value)
}

// The pointer-width conversion bounds, as exact powers of two in binary32. They are
// selected from the target's pointer width rather than converted from `usize.MAX`/`isize.MAX`,
// which would round outward and admit an overflowing value.
fn usizeBound() -> f32 {
  if pointerBits == 32 { return 4294967296.0 }
  return 18446744073709551616.0
}

fn isizeUpperBound() -> f32 {
  if pointerBits == 32 { return 2147483648.0 }
  return 9223372036854775808.0
}

fn isizeLowerBound() -> f32 {
  if pointerBits == 32 { return -2147483648.0 }
  return -9223372036854775808.0
}

/// Converts `value` toward zero to `u8`, or returns `None` when the truncated result is out of
/// range.
///
/// # When to use
///
/// Use this function when a NaN, an infinity, or an out-of-range magnitude is input data rather
/// than a program error. [`toU8`] traps on exactly the inputs this function reports as `None`.
///
/// # Details
///
/// The fraction is discarded first, so the range test applies to the truncated value: a magnitude
/// below one is in range and yields zero. The truncated value is accepted when it is at least zero
/// and below `2^8`. Both bounds are powers of two and so are exact in binary32; a bound converted
/// from `u8.MAX` would round outward and wrongly admit an overflowing value.
///
/// # Gotchas
///
/// NaN and either infinity return `None`. A value in `(-1.0, -0.0]` truncates to negative zero and
/// converts to `0`, so its sign is discarded rather than rejected.
pub fn checkedToU8(value: f32) -> Option<u8> {
  if Intrinsic.f32IsNaN(value) { return Option<u8>.none() }
  if Intrinsic.f32IsInfinite(value) { return Option<u8>.none() }
  let truncated = trunc(value)
  if truncated < 0.0 { return Option<u8>.none() }
  if truncated >= 256.0 { return Option<u8>.none() }
  return Option<u8>.some(Intrinsic.f32ToU8(truncated))
}

/// Converts `value` toward zero to `u16`. Traps for NaN, infinity, or a result
/// outside the `u16` range.
pub fn toU16(value: f32) -> u16 {
  return Intrinsic.f32ToU16(value)
}

/// Converts `value` toward zero to `u16`, or returns `None` when the truncated result is out of
/// range.
///
/// # When to use
