pub fn checkedToU16(value: f32) -> Option<u16> {
  if Intrinsic.f32IsNaN(value) { return Option<u16>.none() }
  if Intrinsic.f32IsInfinite(value) { return Option<u16>.none() }
  let truncated = trunc(value)
  if truncated < 0.0 { return Option<u16>.none() }
  if truncated >= 65536.0 { return Option<u16>.none() }
  return Option<u16>.some(Intrinsic.f32ToU16(truncated))
}

/// Converts `value` toward zero to `u32`. Traps for NaN, infinity, or a result
/// outside the `u32` range.
pub fn toU32(value: f32) -> u32 {
  return Intrinsic.f32ToU32(value)
}

/// Converts `value` toward zero to `u32`, or returns `None` when the truncated result is out of
