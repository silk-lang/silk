}

/// Converts `value` toward zero to `u64`. Traps for NaN, infinity, or a result
/// outside the `u64` range.
pub fn toU64(value: f32) -> u64 {
  return Intrinsic.f32ToU64(value)
}

/// Converts `value` toward zero to `u64`, or returns `None` when the truncated result is out of
/// range.
///
/// # When to use
///
/// Use this function when a NaN, an infinity, or an out-of-range magnitude is input data rather
/// than a program error. [`toU64`] traps on exactly the inputs this function reports as `None`.
///
/// # Details
///
/// The fraction is discarded first, so the range test applies to the truncated value: a magnitude
/// below one is in range and yields zero. The truncated value is accepted when it is at least zero
/// and below `2^64`. Both bounds are powers of two and so are exact in binary32; a bound converted
/// from `u64.MAX` would round outward and wrongly admit an overflowing value.
///
/// # Gotchas
///
/// NaN and either infinity return `None`. A value in `(-1.0, -0.0]` truncates to negative zero and
/// converts to `0`, so its sign is discarded rather than rejected.
pub fn checkedToU64(value: f32) -> Option<u64> {
  if Intrinsic.f32IsNaN(value) { return Option<u64>.none() }
  if Intrinsic.f32IsInfinite(value) { return Option<u64>.none() }
  let truncated = trunc(value)
  if truncated < 0.0 { return Option<u64>.none() }
  if truncated >= 18446744073709551616.0 { return Option<u64>.none() }
  return Option<u64>.some(Intrinsic.f32ToU64(truncated))
}

/// Converts `value` toward zero to `usize`. Traps for NaN, infinity, or a result
/// outside the `usize` range.
pub fn toUsize(value: f32) -> usize {
  return Intrinsic.f32ToUsize(value)
}

/// Converts `value` toward zero to `usize`, or returns `None` when the truncated result is out of
/// range.
///
/// # When to use
///
/// Use this function when a NaN, an infinity, or an out-of-range magnitude is input data rather
/// than a program error. [`toUsize`] traps on exactly the inputs this function reports as `None`.
///
/// # Details
///
/// The fraction is discarded first, so the range test applies to the truncated value: a magnitude
/// below one is in range and yields zero. `usize` follows the selected target's pointer width, so
/// the bounds follow it too. The truncated value is accepted when it is at least zero and below
/// `2^32` on a 32-bit target or `2^64` on a 64-bit one.
///
/// Every bound is a power of two and so is exact in binary32. A bound converted from `usize.MAX`
/// would round outward and wrongly admit an overflowing value, and a bound fixed at 64-bit width
/// would admit values that trap on a 32-bit target.
///
/// # Gotchas
///
/// NaN and either infinity return `None`. A value in `(-1.0, -0.0]` truncates to negative zero and
/// converts to `0`, so its sign is discarded rather than rejected.
pub fn checkedToUsize(value: f32) -> Option<usize> {
  if Intrinsic.f32IsNaN(value) { return Option<usize>.none() }
  if Intrinsic.f32IsInfinite(value) { return Option<usize>.none() }
  let truncated = trunc(value)
  if truncated < 0.0 { return Option<usize>.none() }
  if truncated >= usizeBound() { return Option<usize>.none() }
  return Option<usize>.some(Intrinsic.f32ToUsize(truncated))
}

/// Converts `value` toward zero to `i8`. Traps for NaN, infinity, or a result
/// outside the `i8` range.
pub fn toI8(value: f32) -> i8 {
