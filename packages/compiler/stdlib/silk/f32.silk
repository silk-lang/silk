/// Use this function when a NaN, an infinity, or an out-of-range magnitude is input data rather
/// than a program error. [`toI8`] traps on exactly the inputs this function reports as `None`.
///
/// # Details
///
/// The fraction is discarded first, so the range test applies to the truncated value: a magnitude
/// below one is in range and yields zero. The truncated value is accepted when it is at least
/// `-2^7` and below `2^7`. Both bounds are powers of two and so are exact in binary32; a bound
/// converted from `i8.MAX` would round outward and wrongly admit an overflowing value.
///
/// # Gotchas
///
/// NaN and either infinity return `None`. A value in `(-1.0, -0.0]` truncates to negative zero and
/// converts to `0`, so its sign is discarded rather than rejected.
pub fn checkedToI8(value: f32) -> Option<i8> {
  if Intrinsic.f32IsNaN(value) { return Option<i8>.none() }
  if Intrinsic.f32IsInfinite(value) { return Option<i8>.none() }
  let truncated = trunc(value)
  if truncated < -128.0 { return Option<i8>.none() }
  if truncated >= 128.0 { return Option<i8>.none() }
  return Option<i8>.some(Intrinsic.f32ToI8(truncated))
}

