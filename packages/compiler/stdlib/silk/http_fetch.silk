    FetchResult,
    FactoryError,
    ProducerError,
    DestinationFailure<SinkError>,
    AcquisitionError,
    FactoryRequirements,
    ProducerRequirements,
    SinkRequirements,
    AcquisitionRequirements,
    Factory,
    Producer,
    SinkDestination<SinkError, SinkRequirements, S>,
    C,
  > {
    fetch: move fetch,
    factory: move factory,
    policyAnchor: [],
    options: move options,
    destination: SinkDestination<SinkError, SinkRequirements, S> {sink: move sink},
  }
  return run withSemanticRequest<RoutedP, DirectP>(move request, move operation)
}

