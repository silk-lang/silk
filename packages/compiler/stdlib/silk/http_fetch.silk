struct ReplayOperation<
  'fetch,
  'policy,
  RoutedP,
  DirectP,
  A,
  FactoryError,
  ProducerError,
  DestinationError,
  AcquisitionError,
  ?FactoryRequirements,
  ?ProducerRequirements,
  ?DestinationRequirements,
  ?AcquisitionRequirements,
  Factory,
  Producer,
  D,
  C,
> {
  fetch: &'fetch mut Fetch<C>
  factory: Factory
  policyAnchor: [&'policy (); 0]
  options: FetchOptions
  destination: D
}

impl<
  'fetch,
  'policy,
  RoutedP,
  DirectP,
  A,
  FactoryError,
  ProducerError,
  DestinationError,
  AcquisitionError,
  ?FactoryRequirements,
  ?ProducerRequirements,
  ?DestinationRequirements,
  ?AcquisitionRequirements,
  Factory: ReplayFactory<Producer, FactoryError, FactoryRequirements>,
  Producer: BodyProducer<ProducerError ? ProducerRequirements>,
  D: Destination<A, DestinationError ? DestinationRequirements>,
  C: FetchClient<
    'policy,
    RoutedP,
    DirectP,
    Redirect.AttemptStep<'policy, A>,
    RedirectError | FetchError | ValueError | BodyError | ProducerError | DestinationError | ClientError | OutOfMemoryError,
    AcquisitionError,
    ProducerRequirements | DestinationRequirements | &mut Redirect.SelectedBody<
      ProducerError,
      ProducerRequirements,
    > | &mut MonotonicClock | &mut Allocator | &mut Random,
    AcquisitionRequirements,
  >,
> SemanticRequestHandler<'policy, RoutedP, DirectP, A, RedirectError | FetchError | ValueError | BodyError | FactoryError | ProducerError | DestinationError | ClientError | OutOfMemoryError | AcquisitionError ? FactoryRequirements | ProducerRequirements | DestinationRequirements | AcquisitionRequirements | &mut MonotonicClock | &mut Allocator | &mut Random> for ReplayOperation<
  'fetch,
  'policy,
  RoutedP,
  DirectP,
  A,
  FactoryError,
  ProducerError,
  DestinationError,
  AcquisitionError,
  FactoryRequirements,
  ProducerRequirements,
  DestinationRequirements,
  AcquisitionRequirements,
  Factory,
  Producer,
  D,
  C,
> {
  effect<'call> fn handle<'call>(
    operation: Self,
    request: Redirect.Request<'call, 'call, 'call, 'policy>,
  ) -> A
  ! RedirectError | FetchError | ValueError | BodyError | FactoryError | ProducerError | DestinationError | ClientError | OutOfMemoryError | AcquisitionError
  ? FactoryRequirements | ProducerRequirements | DestinationRequirements | AcquisitionRequirements | &mut MonotonicClock | &mut Allocator | &mut Random
  where
    &mut RoutedP provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut RoutedP provides &HttpTransport from &mut HttpTransport,
    &mut RoutedP provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut RoutedP provides &ByteDuplex from &mut ByteDuplex,
    &mut DirectP provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut DirectP provides &HttpTransport from &mut HttpTransport,
    FactoryRequirements in Without<FactoryRequirements, ByteDuplex>,
    FactoryRequirements in Without<FactoryRequirements, HttpTransport>,
    ProducerRequirements in Without<ProducerRequirements, ByteDuplex>,
    ProducerRequirements in Without<ProducerRequirements, HttpTransport>,
    DestinationRequirements in Without<DestinationRequirements, ByteDuplex>,
    DestinationRequirements in Without<DestinationRequirements, HttpTransport>,
    AcquisitionRequirements in Without<AcquisitionRequirements, ByteDuplex>,
    AcquisitionRequirements in Without<AcquisitionRequirements, HttpTransport> {
    let ReplayOperation<
      'fetch,
      'policy,
      RoutedP,
      DirectP,
      A,
      FactoryError,
      ProducerError,
      DestinationError,
      AcquisitionError,
      FactoryRequirements,
      ProducerRequirements,
      DestinationRequirements,
      AcquisitionRequirements,
      Factory,
      Producer,
      D,
      C,
    > {fetch, factory, policyAnchor, options, destination} = move operation
    drop policyAnchor
    let FetchOptions {
      redirect,
      content,
      pool,
      proxy,
      deadline,
      http,
      contentLimits,
      maxEncodedBodyBytes,
      maxDeliveredBodyBytes,
      maxOwnedMetadataBytes,
      maxBufferedBytes,
    } = move options
    let mut selectedFetch = move fetch
    let mut adapter = FetchAttemptAdapter<
      'fetch,
      'policy,
      RoutedP,
      DirectP,
      Redirect.AttemptStep<'policy, A>,
      RedirectError | FetchError | ValueError | BodyError | ProducerError | DestinationError | ClientError | OutOfMemoryError,
      AcquisitionError,
      ProducerRequirements | DestinationRequirements | &mut Redirect.SelectedBody<
        ProducerError,
        ProducerRequirements,
      > | &mut MonotonicClock | &mut Allocator | &mut Random,
      AcquisitionRequirements,
      C,
    > {client: &mut selectedFetch.client, httpLimits: http, poolMode: pool, proxyMode: proxy}
    let mut scratch = run Bytes.zeroed(http.writeCapacity)
    let response = DeliveryResponseHandler<
      RoutedP,
      DirectP,
      A,
      DestinationError,
      DestinationRequirements,
      D,
    > {
      destination: Option.some<D>(move destination),
      content: content,
      contentLimits: move contentLimits,
      responseValueLimits: http.responseBody.trailerValues,
      maxEncodedBodyBytes: maxEncodedBodyBytes,
      maxDeliveredBodyBytes: maxDeliveredBodyBytes,
      maxOwnedMetadataBytes: maxOwnedMetadataBytes,
      maxBufferedBytes: maxBufferedBytes,
      deadline: copyDeadline(&deadline),
    }
    return run mapSwitching<
      A,
      FactoryError | ProducerError | RedirectError | FetchError | ValueError | BodyError | DestinationError | OutOfMemoryError | AcquisitionError,
      FactoryRequirements | ProducerRequirements | DestinationRequirements | AcquisitionRequirements | &mut MonotonicClock | &mut Allocator | &mut Random,
    >(
      Redirect.withReplayHybridResponse<
        RoutedP,
        DirectP,
        A,
        FactoryError,
        ProducerError,
        FetchError | ValueError | BodyError | DestinationError | ClientError | OutOfMemoryError,
        AcquisitionError,
        FactoryRequirements,
        ProducerRequirements,
        DestinationRequirements | &mut Allocator | &mut MonotonicClock | &mut Random,
        AcquisitionRequirements,
        Producer,
      >(
        &mut adapter,
        move request,
        &redirect,
        move factory,
        copyDeadline(&deadline),
        Bytes.asMutSlice(&mut scratch),
        move response,
      ),
    )
  }
}

