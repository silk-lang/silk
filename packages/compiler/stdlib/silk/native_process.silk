//! Source-owned native process resources and per-invocation capture policy.
//!
//! # Details
//!
//! Each invocation owns its descriptors, staged request bytes and child. Recoverable failures
//! release descriptors and resolve the child before propagating the original error.
//!
//! # Gotchas
//!
//! Foreign calls are blocking. Fatal traps do not promise cleanup or child termination.

static if (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.profileText(
  "libc",
) == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.profileText("libc") == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
  import silk.pointer {Pointer}
  import silk.bytes {Bytes}
  import silk.vector {Vector}
  import silk.allocator {Allocator, OutOfMemoryError}
  import silk.child_process {
    ChildProcess,
    ProcessRequest,
    ProcessOutcome,
    ProcessError,
    ProcessOperation,
    ProcessReason,
  }
  import silk.isize
  import silk.i32
  import silk.usize
  import silk.u8
  unsafe extern "C" fn close(fd: i32) -> i32
  unsafe extern "C" fn read(fd: i32, buffer: ?[*]mut u8, count: usize) -> isize with Intrinsic.foreign(
    noCapture: ("buffer",),
  )
  unsafe extern "C" fn write(fd: i32, buffer: ?[*]const u8, count: usize) -> isize with Intrinsic.foreign(
    noCapture: ("buffer",),
  )
  unsafe extern "C" fn waitpid(pid: i32, status: *mut i32, options: i32) -> i32 with Intrinsic.foreign(
    noCapture: ("status",),
  )
  unsafe extern "C" fn kill(pid: i32, signal: i32) -> i32
  unsafe extern "C" fn open(path: ?[*]const u8, flags: i32, ...) -> i32 with Intrinsic.foreign(
    noCapture: ("path",),
  )
  unsafe extern "C" fn fcntl(fd: i32, command: i32, ...) -> i32
  extern "C" struct PollFd {
    fd: i32
    events: i16
    revents: i16
  }
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    unsafe extern "C" fn __error() -> *mut i32
    unsafe fn currentError() -> i32 {
      unsafe {
        return Pointer.read<i32>(__error())
      }
    }
    unsafe extern "C" fn poll(fds: [*]mut PollFd, count: u32, timeout: i32) -> i32 with Intrinsic.foreign(
      noCapture: ("fds",),
    )
    unsafe extern "C" fn pipe(fds: [*]mut i32) -> i32 with Intrinsic.foreign(noCapture: ("fds",))
    const CLOEXEC: i32 = 16777216
    const DUP_CLOEXEC: i32 = 67
    const NOT_IMPLEMENTED: i32 = 78
    const NOT_SUPPORTED: i32 = 45
    const NAME_TOO_LONG: i32 = 63
    const SYMLINK_LOOP: i32 = 62
    const TRY_AGAIN: i32 = 35
  } else {
    unsafe extern "C" fn __errno_location() -> *mut i32
    unsafe fn currentError() -> i32 {
      unsafe {
        return Pointer.read<i32>(__errno_location())
      }
    }
    unsafe extern "C" fn poll(fds: [*]mut PollFd, count: usize, timeout: i32) -> i32 with Intrinsic.foreign(
      noCapture: ("fds",),
    )
    unsafe extern "C" fn pipe2(fds: [*]mut i32, flags: i32) -> i32 with Intrinsic.foreign(
      noCapture: ("fds",),
    )
    const CLOEXEC: i32 = 524288
    const DUP_CLOEXEC: i32 = 1030
    const NOT_IMPLEMENTED: i32 = 38
    const NOT_SUPPORTED: i32 = 95
    const NAME_TOO_LONG: i32 = 36
    const SYMLINK_LOOP: i32 = 40
    const TRY_AGAIN: i32 = 11
  }
  struct Descriptor {
    fd: i32
  }
  impl Drop for Descriptor {
    fn drop(self: &mut Descriptor) -> () {
      let fd = Intrinsic.replace(self.fd, -1)
      if fd >= 0 {
        let ignored = unsafe close(fd)
      }
    }
  }
  struct Pipe {
    input: Descriptor
    output: Descriptor
  }
  struct Child {
    pid: i32
  }
  impl Drop for Child {
    fn drop(self: &mut Child) -> () {
      let pid = Intrinsic.replace(self.pid, -1)
      if pid > 0 {
        let ignored = unsafe kill(pid, 9)
        let mut status = 0
        let mut waiting = true
        while waiting {
          let result = unsafe waitpid(pid, Pointer.fromMutRef<i32>(&mut status), 0)
          if result == pid {
            if terminal(status) {
              waiting = false
            }
          } else {
            let error = unsafe currentError()
            if error != 4 {
              waiting = false
            }
          }
        }
      }
    }
  }
  fn reason(code: i32) -> ProcessReason {
    if code == 2 {
      return ChildProcess.notFound()
    }
    if code == 1 || code == 13 {
      return ChildProcess.permissionDenied()
    }
    if code == 22 || code == 20 || code == 21 || code == 7 || code == NAME_TOO_LONG || code == SYMLINK_LOOP {
      return ChildProcess.invalidRequest()
    }
    if code == 12 || code == 28 || code == 24 || code == 23 || code == TRY_AGAIN {
      return ChildProcess.noSpace()
    }
    if code == NOT_IMPLEMENTED || code == NOT_SUPPORTED {
      return ChildProcess.unsupported()
    }
    return ChildProcess.other()
  }
  effect fn reject(operation: ProcessOperation, code: i32) -> never ! ProcessError {
    fail ChildProcess.failureWithCode(move operation, reason(code), code)
  }
  effect fn closeOwned(value: Descriptor, operation: ProcessOperation) -> () ! ProcessError {
    let mut owner = move value
    let fd = Intrinsic.replace(owner.fd, -1)
    let result = unsafe close(fd)
    if result != 0 {
      let error = unsafe currentError()
      return run reject(move operation, error)
    }
  }
  effect fn relocate(value: Descriptor) -> Descriptor ! ProcessError {
    let owner = move value
    let fd = unsafe fcntl(owner.fd, DUP_CLOEXEC, 4)
    if fd < 0 {
      let error = unsafe currentError()
      return run reject(ChildProcess.spawnOperation(), error)
    }
    let result = Descriptor {fd: fd}
    run closeOwned(move owner, ChildProcess.spawnOperation())
    return move result
  }
  effect fn makePipe() -> Pipe ! ProcessError {
    let mut pair: [i32; 2] = [-1, -1]
    let mut result = 0
    unsafe {
      let pointer = Intrinsic.pointerRequalify<?[*]mut i32, [*]mut i32>(
        Pointer.fromMutSlice<i32>(&mut pair),
      )
      static if Intrinsic.targetOperatingSystem() == "darwin" {
        result = pipe(pointer)
      } else {
        result = pipe2(pointer, CLOEXEC)
      }
    }
    if result != 0 {
      let error = unsafe currentError()
      return run reject(ChildProcess.spawnOperation(), error)
    }
    let first = Descriptor {fd: pair[0]}
    let second = Descriptor {fd: pair[1]}
    let input = run relocate(move first)
    let output = run relocate(move second)
    return Pipe {input: move input, output: move output}
  }
  effect fn nullInput() -> Descriptor ! ProcessError {
    let fd = unsafe open(Pointer.fromSlice<u8>(b"/dev/null\0"), CLOEXEC)
    if fd < 0 {
      let error = unsafe currentError()
      return run reject(ChildProcess.spawnOperation(), error)
    }
    return run relocate(Descriptor {fd: fd})
  }
  effect fn reap(child: &mut Child) -> i32 ! ProcessError {
    let mut status = 0
    while true {
      let result = unsafe waitpid(child.pid, Pointer.fromMutRef<i32>(&mut status), 0)
      if result == child.pid {
        if terminal(status) {
          child.pid = -1
          return status
        }
      } else {
        let error = unsafe currentError()
        if error != 4 {
          if error == 10 {
            child.pid = -1
          }
          return run reject(ChildProcess.waitOperation(), error)
        }
      }
    }
    return 0
  }
  struct Captures {
    output: Bytes
    errors: Bytes
  }
  effect fn receive(descriptor: &mut Descriptor, scratch: &mut Bytes, destination: &mut Bytes) -> ()
  ! ProcessError | OutOfMemoryError
  ? &mut Allocator {
    let view = Bytes.asMutSlice(&mut scratch.*)
    let capacity = view.length
    let pointer = Pointer.fromMutSlice<u8>(move view)
    let transferred = unsafe read(descriptor.fd, pointer, capacity)
    if transferred < 0 {
      let error = unsafe currentError()
      if error == 4 {
        return
      }
      return run reject(ChildProcess.captureOperation(), error)
    }
    if transferred == 0 {
      let fd = Intrinsic.replace(descriptor.fd, -1)
      return run closeOwned(Descriptor {fd: fd}, ChildProcess.captureOperation())
    }
    let received = isize.toUsize(transferred)
    if received > capacity {
      return run reject(ChildProcess.captureOperation(), 0)
    }
    let bytes = Bytes.asSlice(&scratch.*)
    let mut index: usize = 0
    while index < received {
      let one = [bytes[index]]
      run Bytes.append(&mut destination.*, &one)
      index = index + 1
    }
  }
  effect fn capture(output: &mut Descriptor, errors: &mut Descriptor) -> Captures
  ! ProcessError | OutOfMemoryError
  ? &mut Allocator {
    let mut stdout = Bytes.make()
    let mut stderr = Bytes.make()
    let mut scratch = run Bytes.zeroed(4096)
    while output.fd >= 0 || errors.fd >= 0 {
      let mut watched: [PollFd; 2] = [
        PollFd {fd: output.fd, events: 1, revents: 0},
        PollFd {fd: errors.fd, events: 1, revents: 0},
      ]
      let mut ready = 0
      unsafe {
        let pointer = Intrinsic.pointerRequalify<?[*]mut PollFd, [*]mut PollFd>(
          Pointer.fromMutSlice<PollFd>(&mut watched),
        )
        ready = poll(pointer, 2, -1)
      }
      if ready < 0 {
        let error = unsafe currentError()
        if error != 4 {
          return run reject(ChildProcess.captureOperation(), error)
        }
      } else {
        if output.fd >= 0 && watched[0].revents != 0 {
          run receive(&mut output.*, &mut scratch, &mut stdout)
        }
        if errors.fd >= 0 && watched[1].revents != 0 {
          run receive(&mut errors.*, &mut scratch, &mut stderr)
        }
      }
    }
    return Captures {output: move stdout, errors: move stderr}
  }
  fn validString(value: &[u8]) -> bool {
    let mut index: usize = 0
    while index < value.length {
      if value[index] == 0 {
        return false
      }
      index = index + 1
    }
    return true
  }
  fn validEntries(value: &[u8]) -> bool {
    if value.length == 0 {
      return true
    }
    return value[value.length - 1] == 0
  }
  effect fn terminated(value: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    let mut result = run Bytes.copy(value)
    let ending: [u8; 1] = [0]
    run Bytes.append(&mut result, &ending)
    return move result
  }
  fn nullBytes() -> ?[*]const u8 {
    unsafe {
      return Intrinsic.pointerRequalify<?*mut u8, ?[*]const u8>(Pointer.null<u8>())
    }
  }
  effect fn entries(value: &Bytes, first: ?[*]const u8) -> Vector<?[*]const u8>
  ! OutOfMemoryError
  ? &mut Allocator {
    let mut result = Vector<?[*]const u8>.make()
    if Pointer.isNullMany<u8>(first) == false {
      run Vector.append(&mut result, first)
    }
    let view = Bytes.asSlice(value)
    let mut offset: usize = 0
    while offset < view.length {
      unsafe {
        let base = Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(
          Pointer.fromSlice<u8>(view),
        )
        let next = Pointer.assumeMany<u8>(Pointer.at<u8>(base, offset))
        run Vector.append(&mut result, next)
      }
      while offset < view.length && view[offset] != 0 {
        offset = offset + 1
      }
      if offset < view.length {
        offset = offset + 1
      }
    }
    run Vector.append(&mut result, nullBytes())
    return move result
  }

  static if Intrinsic.targetOperatingSystem() == "linux" {
    unsafe extern "C" fn fork() -> i32
    unsafe extern "C" fn dup2(old: i32, new: i32) -> i32
    unsafe extern "C" fn closefrom(first: i32) -> ()
    unsafe extern "C" fn chdir(path: ?[*]const u8) -> i32 with Intrinsic.foreign(
      noCapture: ("path",),
    )
    unsafe extern "C" fn execve(
      path: ?[*]const u8,
      arguments: ?[*]const ?[*]const u8,
      environment: ?[*]const ?[*]const u8,
    ) -> i32 with Intrinsic.foreign(noCapture: ("path", "arguments", "environment"))
    unsafe extern "C" fn _exit(status: i32) -> ()
    unsafe fn childExit() -> () {
      unsafe {
        _exit(127)
      }
      static if Intrinsic.targetArchitecture() == "x86_64" {
        return unsafe Intrinsic.assembly<()>("ud2", "", "", "none", true, true, ())
      } else {
        return unsafe Intrinsic.assembly<()>("brk #0", "", "", "none", true, true, ())
      }
    }
    unsafe fn childFailure(fd: i32, error: i32) -> () {
      let packet: [u8; 4] = [
        i32.toU8(error % 256),
        i32.toU8((error / 256) % 256),
        i32.toU8((error / 65536) % 256),
        i32.toU8(error / 16777216),
      ]
      let mut sent: usize = 0
      let mut active = true
      while sent < 4 && active {
        let mut count: isize = 0
        unsafe {
          let base = Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(
            Pointer.fromSlice<u8>(&packet),
          )
          let next = Pointer.assumeMany<u8>(Pointer.at<u8>(base, sent))
          count = write(fd, next, 4 - sent)
        }
        if count < 0 {
          let code = unsafe currentError()
          if code != 4 {
            active = false
          }
        } else {
          if count == 0 {
            active = false
          } else {
            let written = isize.toUsize(count)
            if written > 4 - sent {
              active = false
            } else {
              sent = sent + written
            }
          }
        }
      }
      return unsafe childExit()
    }
    unsafe fn childInitialize(
      input: i32,
      output: i32,
      errors: i32,
      notice: i32,
      program: ?[*]const u8,
      arguments: ?[*]const ?[*]const u8,
      environment: ?[*]const ?[*]const u8,
      directory: ?[*]const u8,
    ) -> () {
      if unsafe dup2(notice, 3) < 0 {
        let code = unsafe currentError()
        return unsafe childFailure(notice, code)
      }
      if unsafe fcntl(3, 2, 1) < 0 {
        let code = unsafe currentError()
        return unsafe childFailure(3, code)
      }
      if unsafe dup2(input, 0) < 0 {
        let code = unsafe currentError()
        return unsafe childFailure(3, code)
      }
      if unsafe dup2(output, 1) < 0 {
        let code = unsafe currentError()
        return unsafe childFailure(3, code)
      }
      if unsafe dup2(errors, 2) < 0 {
        let code = unsafe currentError()
        return unsafe childFailure(3, code)
      }
      unsafe {
        closefrom(4)
      }
      if Pointer.isNullMany<u8>(directory) == false {
        if unsafe chdir(directory) != 0 {
          let code = unsafe currentError()
          return unsafe childFailure(3, code)
        }
      }
      let ignored = unsafe execve(program, arguments, environment)
      let code = unsafe currentError()
      return unsafe childFailure(3, code)
    }
    effect fn launch(
      input: &Descriptor,
      output: &Descriptor,
      errors: &Descriptor,
      program: ?[*]const u8,
      arguments: ?[*]const ?[*]const u8,
      environment: ?[*]const ?[*]const u8,
      directory: ?[*]const u8,
    ) -> Child ! ProcessError {
      let notice = run makePipe()
      let pid = unsafe fork()
      if pid < 0 {
        let code = unsafe currentError()
        return run reject(ChildProcess.spawnOperation(), code)
      }
      if pid == 0 {
        unsafe {
          childInitialize(
            input.fd,
            output.fd,
            errors.fd,
            notice.output.fd,
            program,
            arguments,
            environment,
            directory,
          )
        }
      }
      let child = Child {pid: pid}
      run closeOwned(move notice.output, ChildProcess.spawnOperation())
      let mut packet: [u8; 4] = [0, 0, 0, 0]
      let mut received: usize = 0
      let mut ended = false
      while received < 4 && ended == false {
        let mut transferred: isize = 0
        unsafe {
          let base = Intrinsic.pointerRequalify<?[*]mut u8, [*]mut u8>(
            Pointer.fromMutSlice<u8>(&mut packet),
          )
          let next = Pointer.assumeManyMut<u8>(Pointer.atMut<u8>(base, received))
          transferred = read(notice.input.fd, next, 4 - received)
        }
        if transferred < 0 {
          let code = unsafe currentError()
          if code != 4 {
            return run reject(ChildProcess.spawnOperation(), code)
          }
        } else {
          if transferred == 0 {
            ended = true
          } else {
            let count = isize.toUsize(transferred)
            if count > 4 - received {
              return run reject(ChildProcess.spawnOperation(), 0)
            }
            received = received + count
          }
        }
      }
      run closeOwned(move notice.input, ChildProcess.spawnOperation())
      if received == 0 {
        return move child
      }
      if received != 4 {
        return run reject(ChildProcess.spawnOperation(), 0)
      }
      let code = u8.toUsize(packet[0]) + u8.toUsize(packet[1]) * 256 + u8.toUsize(packet[2]) * 65536 + u8.toUsize(
        packet[3],
      ) * 16777216
      if code > 2147483647 {
        return run reject(ChildProcess.spawnOperation(), 0)
      }
      return run reject(ChildProcess.spawnOperation(), usize.toI32(code))
    }
  }
  fn terminal(status: i32) -> bool {
    return (status & 127) != 127
  }
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    extern "C" struct ActionsHandle {
      value: ?*mut u8
    }
    extern "C" struct AttributesHandle {
      value: ?*mut u8
    }
    unsafe extern "C" fn posix_spawn_file_actions_init(value: *mut ActionsHandle) -> i32 with Intrinsic.foreign(
      noCapture: ("value",),
    )
    unsafe extern "C" fn posix_spawn_file_actions_destroy(value: *mut ActionsHandle) -> i32 with Intrinsic.foreign(
      noCapture: ("value",),
    )
    unsafe extern "C" fn posix_spawn_file_actions_adddup2(
      value: *mut ActionsHandle,
      from: i32,
      to: i32,
    ) -> i32 with Intrinsic.foreign(noCapture: ("value",))
    unsafe extern "C" fn posix_spawn_file_actions_addclose(value: *mut ActionsHandle, fd: i32) -> i32 with Intrinsic.foreign(
      noCapture: ("value",),
    )
    unsafe extern "C" fn posix_spawn_file_actions_addchdir_np(
      value: *mut ActionsHandle,
      path: ?[*]const u8,
    ) -> i32 with Intrinsic.foreign(noCapture: ("value", "path"))
    unsafe extern "C" fn posix_spawnattr_init(value: *mut AttributesHandle) -> i32 with Intrinsic.foreign(
      noCapture: ("value",),
    )
    unsafe extern "C" fn posix_spawnattr_destroy(value: *mut AttributesHandle) -> i32 with Intrinsic.foreign(
      noCapture: ("value",),
    )
    unsafe extern "C" fn posix_spawnattr_setflags(value: *mut AttributesHandle, flags: i16) -> i32 with Intrinsic.foreign(
      noCapture: ("value",),
    )
    unsafe extern "C" fn posix_spawn(
      pid: *mut i32,
      path: ?[*]const u8,
      actions: *const ActionsHandle,
      attributes: *const AttributesHandle,
      arguments: ?[*]const ?[*]const u8,
      environment: ?[*]const ?[*]const u8,
    ) -> i32 with Intrinsic.foreign(
      noCapture: ("pid", "path", "actions", "attributes", "arguments", "environment"),
    )
    struct Actions {
      handle: ActionsHandle
    }
    impl Drop for Actions {
      fn drop(self: &mut Actions) -> () {
        let ignored = unsafe posix_spawn_file_actions_destroy(
          Pointer.fromMutRef<ActionsHandle>(&mut self.handle),
        )
      }
    }
    struct Attributes {
      handle: AttributesHandle
    }
    impl Drop for Attributes {
      fn drop(self: &mut Attributes) -> () {
        let ignored = unsafe posix_spawnattr_destroy(
          Pointer.fromMutRef<AttributesHandle>(&mut self.handle),
        )
      }
    }
    effect fn makeActions() -> Actions ! ProcessError {
      let mut value = ActionsHandle {value: Pointer.null<u8>()}
      let code = unsafe posix_spawn_file_actions_init(Pointer.fromMutRef<ActionsHandle>(&mut value))
      if code != 0 {
        return run reject(ChildProcess.spawnOperation(), code)
      }
      return Actions {handle: move value}
    }
    effect fn makeAttributes() -> Attributes ! ProcessError {
      let mut value = AttributesHandle {value: Pointer.null<u8>()}
      let code = unsafe posix_spawnattr_init(Pointer.fromMutRef<AttributesHandle>(&mut value))
      if code != 0 {
        return run reject(ChildProcess.spawnOperation(), code)
      }
      let mut result = Attributes {handle: move value}
      let flags = unsafe posix_spawnattr_setflags(
        Pointer.fromMutRef<AttributesHandle>(&mut result.handle),
        16384,
      )
      if flags != 0 {
        return run reject(ChildProcess.spawnOperation(), flags)
      }
      return move result
    }
    effect fn addDescriptor(actions: &mut Actions, from: i32, to: i32) -> () ! ProcessError {
      let duplicate = unsafe posix_spawn_file_actions_adddup2(
        Pointer.fromMutRef<ActionsHandle>(&mut actions.handle),
        from,
        to,
      )
      if duplicate != 0 {
        return run reject(ChildProcess.spawnOperation(), duplicate)
      }
      let closed = unsafe posix_spawn_file_actions_addclose(
        Pointer.fromMutRef<ActionsHandle>(&mut actions.handle),
        from,
      )
      if closed != 0 {
        return run reject(ChildProcess.spawnOperation(), closed)
      }
    }
    effect fn launch(
      input: &Descriptor,
      output: &Descriptor,
      errors: &Descriptor,
      program: ?[*]const u8,
      arguments: ?[*]const ?[*]const u8,
      environment: ?[*]const ?[*]const u8,
      directory: ?[*]const u8,
    ) -> Child ! ProcessError {
      let mut actions = run makeActions()
      let attributes = run makeAttributes()
      run addDescriptor(&mut actions, input.fd, 0)
      run addDescriptor(&mut actions, output.fd, 1)
      run addDescriptor(&mut actions, errors.fd, 2)
      if Pointer.isNullMany<u8>(directory) == false {
        let changed = unsafe posix_spawn_file_actions_addchdir_np(
          Pointer.fromMutRef<ActionsHandle>(&mut actions.handle),
          directory,
        )
        if changed != 0 {
          return run reject(ChildProcess.spawnOperation(), changed)
        }
      }
      let mut pid = -1
      let code = unsafe posix_spawn(
        Pointer.fromMutRef<i32>(&mut pid),
        program,
        Pointer.fromRef<ActionsHandle>(&actions.handle),
        Pointer.fromRef<AttributesHandle>(&attributes.handle),
        arguments,
        environment,
      )
      if code != 0 {
        return run reject(ChildProcess.spawnOperation(), code)
      }
      return Child {pid: pid}
    }
  }
  /// Blocking native process execution with per-call owned resources and captures.
  pub struct NativeProcess {}
  impl NativeProcess {
    /// Stages a request, starts its child and captures both streams to completion.
    ///
    /// # Details
    ///
    /// Arguments and environment are NUL-separated byte entries. Program and cwd contain no NUL;
    /// an empty cwd preserves the parent directory. The child receives EOF on stdin. Startup
    /// errors are distinct from nonzero exits and signals. Every returned capture owns its bytes.
    ///
    /// # Gotchas
    ///
    /// Calls block. Recoverable failure after spawning terminates and reaps the owned child before
    /// propagation. Fatal traps have no cleanup promise. The host must not reap this owned child.
    pub effect fn execute(request: &ProcessRequest) -> ProcessOutcome
    ! ProcessError | OutOfMemoryError
    ? &mut Allocator {
      let program = ChildProcess.program(request)
      let arguments = ChildProcess.arguments(request)
      let environment = ChildProcess.environment(request)
      let directory = ChildProcess.workingDirectory(request)
      if program.length == 0 || validString(program) == false || validString(directory) == false || validEntries(
        arguments,
      ) == false || validEntries(environment) == false {
        return run reject(ChildProcess.spawnOperation(), 22)
      }
      let programBytes = run terminated(program)
      let directoryBytes = run terminated(directory)
      let argumentBytes = run Bytes.copy(arguments)
      let environmentBytes = run Bytes.copy(environment)
      let programPointer = Pointer.fromSlice<u8>(Bytes.asSlice(&programBytes))
      let mut directoryPointer = nullBytes()
      if directory.length != 0 {
        directoryPointer = Pointer.fromSlice<u8>(Bytes.asSlice(&directoryBytes))
      }
      let argv = run entries(&argumentBytes, programPointer)
      let envp = run entries(&environmentBytes, nullBytes())
      let input = run nullInput()
      let outputPipe = run makePipe()
      let mut output = move outputPipe.input
      let outputWriter = move outputPipe.output
      let errorPipe = run makePipe()
      let mut errors = move errorPipe.input
      let errorWriter = move errorPipe.output
      let mut child = run launch(
        &input,
        &outputWriter,
        &errorWriter,
        programPointer,
        Pointer.fromSlice<?[*]const u8>(Vector.asSlice(&argv)),
        Pointer.fromSlice<?[*]const u8>(Vector.asSlice(&envp)),
        directoryPointer,
      )
      drop argv
      drop envp
      drop programBytes
      drop directoryBytes
      drop argumentBytes
      drop environmentBytes
      run closeOwned(move input, ChildProcess.spawnOperation())
      run closeOwned(move outputWriter, ChildProcess.spawnOperation())
      run closeOwned(move errorWriter, ChildProcess.spawnOperation())
      let captured = run capture(&mut output, &mut errors)
      let status = run reap(&mut child)
      if (status & 127) == 0 {
        return ChildProcess.exited((status / 256) % 256, move captured.output, move captured.errors)
      }
      return ChildProcess.signaled(status & 127, move captured.output, move captured.errors)
    }
  }
}
