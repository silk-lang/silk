fn routeReference<'host>(host: &Host, name: &'host [u8]) -> Result<
  ReferenceIdentity<'host>,
  IdentityError,
> {
  let selected = match & host.* {
    Host.Domain {value} => OriginHost<'host>.Dns {bytes: name}
    Host.Ipv4 {value} => OriginHost<'host>.Ipv4 {bytes: Ipv4Address.octets(&value)}
    Host.Ipv6 {value} => OriginHost<'host>.Ipv6 {bytes: Ipv6Address.octets(&value)}
  }
  return HttpsIdentity.reference(move selected)
}

fn admittedRouteReference<'host>(host: Host, name: &'host [u8]) -> ReferenceIdentity<'host> {
  return match host {
    Host.Domain {value} => ReferenceIdentity<'host>.Dns {bytes: name}
    Host.Ipv4 {value} => ReferenceIdentity<'host>.Ipv4 {bytes: Ipv4Address.octets(&value)}
    Host.Ipv6 {value} => ReferenceIdentity<'host>.Ipv6 {bytes: Ipv6Address.octets(&value)}
  }
}

effect fn selectedPeer<'configuration>(route: &Route<'configuration>) -> Origin ! ProxyError {
  if Route.mode(route) == RouteMode.Direct {
    return Route.originalOrigin(route)
  }
  return match move Route.physicalPeer(route) {
    Result<Origin, OriginError>.Success {value} => value
    Result<Origin, OriginError>.Failure {error} => {
      drop error
      fail ProxyError.invalidRoute()
    }
  }
}

fn requiresTrust<'configuration>(route: &Route<'configuration>) -> bool {
  if Route.mode(route) == RouteMode.Tunnel {
    return true
  }
  return Route.mode(route) == RouteMode.Direct && Origin.secure(&Route.originalOrigin(route))
}

fn preflightRouteIdentity<'configuration>(route: &Route<'configuration>) -> Result<
  (),
  IdentityError,
> {
  if !requiresTrust(route) {
    return Result.succeed<(), IdentityError>(())
  }
  let host = Origin.host(&Route.originalOrigin(route))
  let mut name = zeroRouteName()
  let nameLength = copyRouteDomain(&host, &mut name)
  let nameBytes = Slice.view<u8>(&name, usize.ZERO, nameLength)
  return match move routeReference(&host, nameBytes) {
    Result.Success {value} => {
      drop value
      return Result.succeed<(), IdentityError>(())
    }
    Result.Failure {error} => {
      return Result.failResult<(), IdentityError>(move error)
    }
  }
}

effect fn takeTrust(selected: Option<TrustSnapshot>) -> TrustSnapshot ! ProxyError {
  return match move selected {
    Option.Some {value} => move value
    Option.None => {
      fail ProxyError.invalidRoute()
    }
  }
}

effect fn prepareRouteConnect<'configuration>(
  route: &Route<'configuration>,
  settings: RouteSettings,
) -> PreparedRequest ! ProxyError | ClientError | OutOfMemoryError ? &mut Allocator {
  let attempted = run Effect.result(
    Request.prepareConnect(
      route,
      settings.request,
      settings.maxRequestHeadBytes,
      settings.maxProxyCredentialBytes,
    ),
  )
  return match move attempted {
    Result<PreparedRequest, ProxyError | RequestError | OutOfMemoryError>.Success {value} => move value
    Result<PreparedRequest, ProxyError | RequestError | OutOfMemoryError>.Failure {error} => match move error {
      ProxyError cause => {
        fail move cause
      }
      RequestError cause => {
        drop cause
        fail ClientError.InvalidRequest
      }
      OutOfMemoryError allocation => {
        fail move allocation
      }
    }
  }
}

fn directRouteTransport<'transport, 'provider: 'transport, P>(
  connection: &'transport mut OwnedConnection<Loan<'provider, P>>,
) -> RouteTransport<'transport, 'provider, 'provider, P> {
  return RouteTransport<'transport, 'provider, 'provider, P> {
    state: RouteTransportState<'transport, 'provider, 'provider, P>.SecuredDirect {
      provider: Transport.secured(move connection),
    },
  }
}

fn tunnelRouteTransport<'transport, 'provider: 'transport, 'tunnel: 'provider, P>(
  connection: &'transport mut OwnedConnection<Loan<'provider, TransferredTunnel<'tunnel, P>>>,
) -> RouteTransport<'transport, 'provider, 'tunnel, P> {
  return RouteTransport<'transport, 'provider, 'tunnel, P> {
    state: RouteTransportState<'transport, 'provider, 'tunnel, P>.SecuredTunnel {
      provider: Transport.secured(move connection),
    },
  }
}

effect<'transport & 'configuration> fn withFinalRoute<
  'configuration,
  'transport,
  'provider: 'transport,
  'tunnel: 'provider,
  P,
  A,
  E,
  ?R,
  H: RouteHandler<'configuration, P, A, E ? R>,
>(
  transport: RouteTransport<'transport, 'provider, 'tunnel, P>,
  origin: Origin,
  route: Route<'configuration>,
  settings: RouteSettings,
  deadline: Option<Instant>,
  handler: H,
) -> A
! E | ClientError | OutOfMemoryError
? R | &mut Allocator
where
  &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut P provides &HttpTransport from &mut HttpTransport,
  &mut P provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut P provides &ByteDuplex from &mut ByteDuplex {
  let connection = run makeOwned(
    move transport,
    origin,
    routeVersion(settings.protocol),
    settings.http,
    move deadline,
  )
  let lease = ConnectionLease<
    RouteTransport<'transport, 'provider, 'tunnel, P>,
    FinalRouteContext<'configuration, H>,
  > {
    connection: move connection,
    handler: Option.some<FinalRouteContext<'configuration, H>>(
      FinalRouteContext<'configuration, H> {route: route, handler: move handler},
    ),
  }
  let use = effect fn(
    owned: &mut ConnectionLease<
      RouteTransport<'transport, 'provider, 'tunnel, P>,
      FinalRouteContext<'configuration, H>,
    >,
  ) -> A ! E ? R {
    let context = match move Intrinsic.replace(
      owned.handler,
      Option.none<FinalRouteContext<'configuration, H>>(),
    ) {
      Option.Some {value} => move value
      Option.None => unavailable<FinalRouteContext<'configuration, H>>()
    }
    let FinalRouteContext<'configuration, H> {route: selectedRoute, handler: selectedHandler} = move context
    return run RouteHandler<'configuration, P, A, E ? R>.handle(
      move selectedHandler,
      selectedRoute,
      &mut owned.connection,
    )
  }
  let release = effect fn(
    owned: &mut ConnectionLease<
      RouteTransport<'transport, 'provider, 'tunnel, P>,
      FinalRouteContext<'configuration, H>,
    >,
  ) -> () {
    return run releaseConnectionLease(&mut owned.*)
  }
  return run Effect.useReleaseNonParking(move lease, move use, move release)
}

effect<'provider> fn withPlainRoute<
  'configuration: 'provider,
  'provider,
  P,
  A,
  E,
  ?R,
  H: RouteHandler<'configuration, P, A, E ? R>,
>(
  provider: &'provider mut P,
  peer: Origin,
  route: Route<'configuration>,
  settings: RouteSettings,
  deadline: Option<Instant>,
  handler: H,
) -> A
! E | ClientError | OutOfMemoryError
? R | &mut Allocator
where
  &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut P provides &HttpTransport from &mut HttpTransport,
  &mut P provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut P provides &ByteDuplex from &mut ByteDuplex,
  R in Without<R, ByteDuplex>,
  R in Without<R, HttpTransport> {
  let loan = Transport.borrow(move provider)
  let transport = RouteTransport<'provider, 'provider, 'provider, P> {
    state: RouteTransportState<'provider, 'provider, 'provider, P>.Plain {provider: move loan},
  }
  return run withFinalRoute<'configuration, 'provider, 'provider, 'provider, P, A, E, R, H>(
    move transport,
    peer,
    route,
    settings,
    move deadline,
    move handler,
  )
}

effect<'env> fn completeRouteConnect<
  'configuration,
  'view,
  P,
  A,
  E,
  ?R,
  H: RouteHandler<'configuration, P, A, E ? R> + 'env,
  'env,
>(
  exchange: &mut Exchange<'view, P>,
  route: Route<'configuration>,
  trust: TrustSnapshot,
  settings: RouteSettings,
  deadline: Option<Instant>,
  handler: H,
) -> A
! E | ProxyError | ClientError | Tls.ConnectionError | IdentityError | OutOfMemoryError
? R | &mut Allocator | &mut MonotonicClock | &mut SystemClock | &mut Random
where
  &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut P provides &HttpTransport from &mut HttpTransport,
  &mut P provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut P provides &ByteDuplex from &mut ByteDuplex,
  R in Without<R, ByteDuplex>,
  R in Without<R, HttpTransport> {
  let fields: [Header<'static>; 0] = []
  let trailers = match move Headers.make(&fields, settings.request) {
    Result.Success {value} => value
    Result.Failure {error} => {
      drop error
      fail ClientError.InvalidRequest
    }
  }
  run send(&mut exchange.*)
  run finishRequest(&mut exchange.*, &trailers)
  let status = run receiveFinal(&mut exchange.*)
  drop status
  let head = run Exchange.head(&exchange.*)
  run Proxy.classifyConnect(&head)
  drop head
  let useTunnel = effect fn(tunnel: &mut Tunnel<P>) -> A
  ! E | ProxyError | ClientError | Tls.ConnectionError | IdentityError | OutOfMemoryError
  ? R | &mut Allocator | &mut MonotonicClock | &mut SystemClock | &mut Random {
    return run transferRouteTunnel<'configuration, P, A, E, R, H>(
      move tunnel,
      route,
      move trust,
      settings,
      copyDeadline(&deadline),
      move handler,
    )
  }
  return run withTunnel(&mut exchange.*, move useTunnel)
}

effect<'env> fn transferRouteTunnel<
  'configuration,
  'view,
  P,
  A,
  E,
  ?R,
  H: RouteHandler<'configuration, P, A, E ? R> + 'env,
  'env,
>(
  tunnel: &mut Tunnel<'view, P>,
  route: Route<'configuration>,
  trust: TrustSnapshot,
  settings: RouteSettings,
  deadline: Option<Instant>,
  handler: H,
) -> A
! E | ProxyError | ClientError | Tls.ConnectionError | IdentityError | OutOfMemoryError
? R | &mut Allocator | &mut MonotonicClock | &mut SystemClock | &mut Random
where
  &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut P provides &HttpTransport from &mut HttpTransport,
  &mut P provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut P provides &ByteDuplex from &mut ByteDuplex,
  R in Without<R, ByteDuplex>,
  R in Without<R, HttpTransport> {
  let useTransferred = effect fn(transferred: &mut TransferredTunnel<P>) -> A
  ! E | ProxyError | ClientError | Tls.ConnectionError | IdentityError | OutOfMemoryError
  ? R | &mut Allocator | &mut MonotonicClock | &mut SystemClock | &mut Random {
    return run withTunnelTlsRoute<'configuration, P, A, E, R, H>(
      move transferred,
      route,
      move trust,
      settings,
      copyDeadline(&deadline),
      move handler,
    )
  }
  return run Tunnel.transferByteDuplex<
    P,
    A,
    E | ProxyError | ClientError | Tls.ConnectionError | IdentityError | OutOfMemoryError,
    R | &mut Allocator | &mut MonotonicClock | &mut SystemClock | &mut Random,
  >(&mut tunnel.*, move useTransferred)
}

effect<'provider> fn withDirectTlsRoute<
  'configuration: 'provider,
  'provider,
  P,
  A,
  E,
  ?R,
  H: RouteHandler<'configuration, P, A, E ? R>,
>(
  provider: &'provider mut P,
  origin: Origin,
  route: Route<'configuration>,
  trust: TrustSnapshot,
  settings: RouteSettings,
  deadline: Option<Instant>,
  handler: H,
) -> A
! E | ClientError | Tls.ConnectionError | IdentityError | OutOfMemoryError
? R | &mut Allocator | &mut MonotonicClock | &mut SystemClock | &mut Random
where
  &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut P provides &HttpTransport from &mut HttpTransport,
  &mut P provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut P provides &ByteDuplex from &mut ByteDuplex,
  R in Without<R, ByteDuplex>,
  R in Without<R, HttpTransport> {
  let host = Origin.host(&origin)
  let protocols = [AlpnProtocol {bytes: b"http/1.1"}]
  let mut name = zeroRouteName()
  let nameLength = copyRouteDomain(&host, &mut name)
  let nameBytes = Slice.view<u8>(&name, usize.ZERO, nameLength)
  let reference = admittedRouteReference(host, nameBytes)
  let config = ClientConfig {
    reference: reference,
    alpn: routeAlpn(&protocols, settings.protocol),
    limits: settings.tls,
  }
  let use = effect fn(connection: &mut OwnedConnection<Loan<'provider, P>>) -> A
  ! E | ClientError | OutOfMemoryError
  ? R | &mut Allocator {
    let transport = directRouteTransport(move connection)
    return run withFinalRoute<'configuration, P, A, E, R, H>(
      move transport,
      origin,
      route,
      settings,
      copyDeadline(&deadline),
      move handler,
    )
  }
  let loan = Transport.borrow(move provider)
  return run Tls.withClient<
    A,
    E | ClientError | OutOfMemoryError,
    R | &mut Allocator,
    Loan<'provider, P>,
  >(
    move loan,
    &config,
    move trust,
    ConnectionOptions {
      handshakeTimeoutNanoseconds: settings.handshakeDurationNanoseconds,
      externalDeadline: copyDeadline(&deadline),
    },
    move use,
  )
}

effect<'provider> fn withTunnelTlsRoute<
  'configuration: 'provider,
  'provider,
  'tunnel: 'provider,
  P,
  A,
  E,
  ?R,
  H: RouteHandler<'configuration, P, A, E ? R>,
>(
  provider: &'provider mut TransferredTunnel<'tunnel, P>,
  route: Route<'configuration>,
  trust: TrustSnapshot,
  settings: RouteSettings,
  deadline: Option<Instant>,
  handler: H,
) -> A
! E | ClientError | Tls.ConnectionError | IdentityError | OutOfMemoryError
? R | &mut Allocator | &mut MonotonicClock | &mut SystemClock | &mut Random
where
  &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut P provides &HttpTransport from &mut HttpTransport,
  &mut P provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut P provides &ByteDuplex from &mut ByteDuplex,
  R in Without<R, ByteDuplex>,
  R in Without<R, HttpTransport> {
  let origin = Route.originalOrigin(&route)
  let host = Origin.host(&origin)
  let protocols = [AlpnProtocol {bytes: b"http/1.1"}]
  let mut name = zeroRouteName()
  let nameLength = copyRouteDomain(&host, &mut name)
  let nameBytes = Slice.view<u8>(&name, usize.ZERO, nameLength)
  let reference = admittedRouteReference(host, nameBytes)
  let config = ClientConfig {
    reference: reference,
    alpn: routeAlpn(&protocols, settings.protocol),
    limits: settings.tls,
  }
  let use = effect fn(
    connection: &mut OwnedConnection<Loan<'provider, TransferredTunnel<'tunnel, P>>>,
  ) -> A ! E | ClientError | OutOfMemoryError ? R | &mut Allocator {
    let transport = tunnelRouteTransport(move connection)
    return run withFinalRoute<'configuration, P, A, E, R, H>(
      move transport,
      origin,
      route,
      settings,
      copyDeadline(&deadline),
      move handler,
    )
  }
  let loan = Transport.borrow(move provider)
  return run Tls.withClient<
    A,
    E | ClientError | OutOfMemoryError,
    R | &mut Allocator,
    Loan<'provider, TransferredTunnel<'tunnel, P>>,
  >(
    move loan,
    &config,
    move trust,
    ConnectionOptions {
      handshakeTimeoutNanoseconds: settings.handshakeDurationNanoseconds,
      externalDeadline: copyDeadline(&deadline),
    },
    move use,
  )
}

struct ConnectRouteHandler<
  'configuration,
  P,
  A,
  E,
  ?R,
  H: RouteHandler<'configuration, P, A, E ? R>,
> {
  route: Route<'configuration>
  request: PreparedRequest
  trust: Option<TrustSnapshot>
  settings: RouteSettings
  deadline: Option<Instant>
  handler: Option<H>
}

effect<'env> fn withConnectHandler<
  'configuration,
  P: 'env,
  A: 'env,
  E: 'env,
  ?R,
  H: RouteHandler<'configuration, P, A, E ? R> + 'env,
  'env,
>(
  transport: P,
  peer: Origin,
  limits: Limits,
  deadline: Option<Instant>,
  handler: ConnectRouteHandler<'configuration, P, A, E, R, H>,
) -> A
! E | ProxyError | ClientError | Tls.ConnectionError | IdentityError | OutOfMemoryError
? R | &mut Allocator | &mut MonotonicClock | &mut SystemClock | &mut Random
where
  &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut P provides &HttpTransport from &mut HttpTransport,
  &mut P provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut P provides &ByteDuplex from &mut ByteDuplex,
  R in Without<R, ByteDuplex>,
  R in Without<R, HttpTransport> {
  let connection = run makeOwned(move transport, peer, Version.Http11, limits, move deadline)
  let lease = ConnectionLease<P, ConnectRouteHandler<'configuration, P, A, E, R, H>> {
    connection: move connection,
    handler: Option.some<ConnectRouteHandler<'configuration, P, A, E, R, H>>(move handler),
  }
  let use = effect fn(
    owned: &mut ConnectionLease<P, ConnectRouteHandler<'configuration, P, A, E, R, H>>,
  ) -> A
  ! E | ProxyError | ClientError | Tls.ConnectionError | IdentityError | OutOfMemoryError
  ? R | &mut Allocator | &mut MonotonicClock | &mut SystemClock | &mut Random {
    let selected = match move Intrinsic.replace(
      owned.handler,
      Option.none<ConnectRouteHandler<'configuration, P, A, E, R, H>>(),
    ) {
      Option.Some {value} => move value
      Option.None => unavailable<ConnectRouteHandler<'configuration, P, A, E, R, H>>()
    }
    return run handleConnectRoute<'configuration, P, A, E, R, H>(
      move selected,
      &mut owned.connection,
    )
  }
  let release = effect fn(
    owned: &mut ConnectionLease<P, ConnectRouteHandler<'configuration, P, A, E, R, H>>,
  ) -> () {
    return run releaseConnectionLease(&mut owned.*)
  }
  return run Effect.useReleaseNonParking(move lease, move use, move release)
}

effect<'call> fn handleConnectRoute<
  'configuration,
  'call,
  P,
  A,
  E,
  ?R,
  H: RouteHandler<'configuration, P, A, E ? R>,
>(bridge: ConnectRouteHandler<'configuration, P, A, E, R, H>, connection: &'call mut Connection<P>) -> A
! E | ProxyError | ClientError | Tls.ConnectionError | IdentityError | OutOfMemoryError
? R | &mut Allocator | &mut MonotonicClock | &mut SystemClock | &mut Random
where
  &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut P provides &HttpTransport from &mut HttpTransport,
  &mut P provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut P provides &ByteDuplex from &mut ByteDuplex,
  R in Without<R, ByteDuplex>,
  R in Without<R, HttpTransport> {
  let ConnectRouteHandler<'configuration, P, A, E, R, H> {
    route,
    request,
    trust,
    settings,
    deadline,
    handler,
  } = move bridge
  let selectedTrust = run takeTrust(move trust)
  let selectedHandler = match move handler {
    Option.Some {value} => move value
    Option.None => unavailable<H>()
  }
  let useExchange = effect fn(exchange: &mut Exchange<P>) -> A
  ! E | ProxyError | ClientError | Tls.ConnectionError | IdentityError | OutOfMemoryError
  ? R | &mut Allocator | &mut MonotonicClock | &mut SystemClock | &mut Random {
    return run completeRouteConnect<'configuration, P, A, E, R, H>(
      move exchange,
      route,
      move selectedTrust,
      settings,
      copyDeadline(&deadline),
      move selectedHandler,
    )
  }
  return run withExchange(
    move connection,
    &request,
    RequestOptions {deadline: copyDeadline(&deadline), continuePolicy: ContinuePolicy.Disabled},
    move useExchange,
  )
}

struct RouteScope<'configuration, H> {
  route: Route<'configuration>
  peer: Origin
  settings: RouteSettings
  deadline: Option<Instant>
  handler: H
}

union RoutePlan<'configuration, H> {
  Plain {scope: RouteScope<'configuration, H>},
  DirectTls {scope: RouteScope<'configuration, H>, trust: TrustSnapshot},
  Tunnel {scope: RouteScope<'configuration, H>, trust: TrustSnapshot, request: PreparedRequest},
}

struct RouteUseContext<'configuration, P, A, E, ?R, H: RouteHandler<'configuration, P, A, E ? R>> {
  plan: Option<RoutePlan<'configuration, H>>
}

effect<'env> fn useRouteContext<
  'configuration,
  P: 'env,
  A,
  E,
  ?R,
  H: RouteHandler<'configuration, P, A, E ? R>,
  'env,
>(context: &mut RouteUseContext<'configuration, P, A, E, R, H>, mut provider: P) -> A
! E | ProxyError | ClientError | Tls.ConnectionError | IdentityError | OutOfMemoryError
? R | &mut Allocator | &mut MonotonicClock | &mut SystemClock | &mut Random
where
  &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut P provides &HttpTransport from &mut HttpTransport,
  &mut P provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut P provides &ByteDuplex from &mut ByteDuplex,
  R in Without<R, ByteDuplex>,
  R in Without<R, HttpTransport> {
  let selected = Intrinsic.replace(context.plan, Option.none<RoutePlan<'configuration, H>>())
  let plan = match move selected {
    Option.Some {value} => move value
    Option.None => unavailable<RoutePlan<'configuration, H>>()
  }
  return match move plan {
    RoutePlan<'configuration, H>.Plain {scope} => {
      let RouteScope<'configuration, H> {route, peer, settings, deadline, handler} = move scope
      return run withPlainRoute<'configuration, P, A, E, R, H>(
        &mut provider,
        peer,
        route,
        settings,
        move deadline,
        move handler,
      )
    }
    RoutePlan<'configuration, H>.DirectTls {scope, trust} => {
      let RouteScope<'configuration, H> {route, peer, settings, deadline, handler} = move scope
      return run withDirectTlsRoute<'configuration, P, A, E, R, H>(
        &mut provider,
        peer,
        route,
        move trust,
        settings,
        move deadline,
        move handler,
      )
    }
    RoutePlan<'configuration, H>.Tunnel {scope, trust, request} => {
      let RouteScope<'configuration, H> {route, peer, settings, deadline, handler} = move scope
      let tunnelHandler = ConnectRouteHandler<'configuration, P, A, E, R, H> {
        route: route,
        request: move request,
        trust: Option.some<TrustSnapshot>(move trust),
        settings: settings,
        deadline: copyDeadline(&deadline),
        handler: Option.some<H>(move handler),
      }
      return run withConnectHandler<'configuration, P, A, E, R, H>(
        move provider,
        peer,
        settings.http,
        move deadline,
        move tunnelHandler,
      )
    }
  }
}

impl<'configuration, P, A, E, ?R, H: RouteHandler<'configuration, P, A, E ? R>> AcquiredRouteContext<P, A, E | ProxyError | ClientError | Tls.ConnectionError | IdentityError | OutOfMemoryError ? R | &mut Allocator | &mut MonotonicClock | &mut SystemClock | &mut Random> for RouteUseContext<
  'configuration,
  P,
  A,
  E,
  R,
  H,
> {
  effect<'env> fn use<'env>(context: &mut Self, provider: P) -> A
  ! E | ProxyError | ClientError | Tls.ConnectionError | IdentityError | OutOfMemoryError
  ? R | &mut Allocator | &mut MonotonicClock | &mut SystemClock | &mut Random
  where
    &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut P provides &HttpTransport from &mut HttpTransport,
    &mut P provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut P provides &ByteDuplex from &mut ByteDuplex,
    R in Without<R, ByteDuplex>,
    R in Without<R, HttpTransport> {
    return run useRouteContext<'configuration, P, A, E, R, H>(move context, move provider)
  }
}

effect<'env> fn makeRoutePlan<'configuration, H: 'env, 'env>(
  route: Route<'configuration>,
  preparedTrust: Option<TrustSnapshot>,
  deadline: Option<Instant>,
  handler: H,
  peer: Origin,
  settings: RouteSettings,
) -> RoutePlan<'configuration, H> ! ProxyError | ClientError | OutOfMemoryError ? &mut Allocator {
  return match Route.mode(&route) {
    RouteMode.Direct => {
      if Origin.secure(&Route.originalOrigin(&route)) {
        let trust = run takeTrust(move preparedTrust)
        return RoutePlan<'configuration, H>.DirectTls {
          scope: RouteScope<'configuration, H> {
            route: route,
            peer: peer,
            settings: settings,
            deadline: copyDeadline(&deadline),
            handler: move handler,
          },
          trust: move trust,
        }
      }
      drop preparedTrust
      return RoutePlan<'configuration, H>.Plain {
        scope: RouteScope<'configuration, H> {
          route: route,
          peer: peer,
          settings: settings,
          deadline: copyDeadline(&deadline),
          handler: move handler,
        },
      }
    }
    RouteMode.Forward => {
      drop preparedTrust
      return RoutePlan<'configuration, H>.Plain {
        scope: RouteScope<'configuration, H> {
          route: route,
          peer: peer,
          settings: settings,
          deadline: copyDeadline(&deadline),
          handler: move handler,
        },
      }
    }
    RouteMode.Tunnel => {
      let trust = run takeTrust(move preparedTrust)
      let request = run prepareRouteConnect(&route, settings)
      return RoutePlan<'configuration, H>.Tunnel {
        scope: RouteScope<'configuration, H> {
          route: route,
          peer: peer,
          settings: settings,
          deadline: copyDeadline(&deadline),
          handler: move handler,
        },
        trust: move trust,
        request: move request,
      }
    }
  }
}

/// Acquires and lends one route-selected HTTP connection under one unchanged absolute deadline.
///
/// # Details
///
/// Trust presence is validated before acquisition. Forward uses the plain proxy connection. A
/// Tunnel sends CONNECT before it authenticates the original origin and lends the secured channel.
pub effect<'env> fn withRoute<
  'configuration,
  P,
  A,
  E,
  AcquisitionError,
  ?R,
  ?AcquisitionRequirements,
  H: RouteHandler<'configuration, P, A, E ? R> + 'env,
  C: RouteClient<P, A, E | ProxyError | ClientError | Tls.ConnectionError | IdentityError | OutOfMemoryError, AcquisitionError, AcquisitionRequirements ? R | &mut Allocator | &mut MonotonicClock | &mut SystemClock | &mut Random> + 'env,
  'env,
>(
  client: C,
  route: Route<'configuration>,
  preparedTrust: Option<TrustSnapshot>,
  deadline: Option<Instant>,
  handler: H,
) -> A
! E | AcquisitionError | ProxyError | ClientError | Tls.ConnectionError | IdentityError | OutOfMemoryError
? R | AcquisitionRequirements | &mut Allocator | &mut MonotonicClock | &mut SystemClock | &mut Random
where
  &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut P provides &HttpTransport from &mut HttpTransport,
  &mut P provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut P provides &ByteDuplex from &mut ByteDuplex,
  R in Without<R, ByteDuplex>,
  R in Without<R, HttpTransport> {
  let hasTrust = match & preparedTrust {
    Option.None => false
    Option.Some {value} => true
  }
  if hasTrust != requiresTrust(&route) {
    fail ProxyError.invalidRoute()
  }
  match move preflightRouteIdentity(&route) {
    Result<(), IdentityError>.Success {value} => {}
    Result<(), IdentityError>.Failure {error} => {
      fail move error
    }
  }
  let settings = RouteClient<P, A, E | ProxyError | ClientError | Tls.ConnectionError | IdentityError | OutOfMemoryError, AcquisitionError, AcquisitionRequirements ? R | &mut Allocator | &mut MonotonicClock | &mut SystemClock | &mut Random>.settings(
    &client,
  )
  let peer = run selectedPeer(&route)
  let plan = run makeRoutePlan(
    route,
    move preparedTrust,
    copyDeadline(&deadline),
    move handler,
    peer,
    settings,
  )
  let context = RouteUseContext<'configuration, P, A, E, R, H> {
    plan: Option.some<RoutePlan<'configuration, H>>(move plan),
  }
  let mut provider = move context
  return run RouteClient<P, A, E | ProxyError | ClientError | Tls.ConnectionError | IdentityError | OutOfMemoryError, AcquisitionError, AcquisitionRequirements ? R | &mut Allocator | &mut MonotonicClock | &mut SystemClock | &mut Random>.acquire(
    move client,
    peer,
    move deadline,
  )
    |> Effect.provideMut<
      AcquiredRouteContext<P, A, E | ProxyError | ClientError | Tls.ConnectionError | IdentityError | OutOfMemoryError ? R | &mut Allocator | &mut MonotonicClock | &mut SystemClock | &mut Random>,
    >(&mut provider)
}

/// Owns the transport and bounded parser state so a completed connection can be retained for later exchanges.
/// Allocation failure terminally closes the supplied transport without a hidden flush.
pub effect<'env> fn makeOwned<P: 'env, 'env>(
  transport: P,
  origin: Origin,
  version: Version,
  limits: Limits,
  overallDeadline: Option<Instant>,
) -> Connection<P>
! ClientError | OutOfMemoryError
? &mut Allocator
where &mut P provides &HttpTransport from &mut HttpTransport {
  let lease = Acquisition<P> {transport: Option.some<P>(move transport)}
  let use = effect fn(owned: &mut Acquisition<P>) -> Connection<P>
  ! ClientError | OutOfMemoryError
  ? &mut Allocator {
    let valid = validateLimits(&limits)
    if let Result<(), ClientError>.Failure {error} = move valid {
      fail move error
    }
    let requestParser = match move run RequestParser.make(limits.head) {
      Result.Failure {error} => {
        fail ClientError.Head {error: move error}
      }
      Result.Success {value} => move value
    }
    let responseParser = match move run ResponseParser.make(limits.head) {
      Result.Failure {error} => {
        fail ClientError.Head {error: move error}
      }
      Result.Success {value} => move value
    }
    let input = run Bytes.zeroed(limits.readCapacity)
    let scratch = run Bytes.zeroed(limits.writeCapacity)
    let provider = match move Intrinsic.replace(owned.transport, Option.none<P>()) {
      Option.Some {value} => move value
      Option.None => unavailable<P>()
    }
    let connection = Connection {
      transport: move provider,
      origin: origin,
      version: version,
      overallDeadline: move overallDeadline,
      input: move input,
      start: usize.ZERO,
      end: usize.ZERO,
      eof: false,
      scratch: move scratch,
      requestParser: move requestParser,
      responseParser: move responseParser,
      parserUsed: false,
      limits: limits,
      phaseValue: ConnectionPhase.Ready,
      closeAuthority: CloseAuthority.Armed,
      requests: usize.ZERO,
    }
    return move connection
  }
  let release = effect fn(owned: &mut Acquisition<P>) -> () {
    if let Option.Some {value} = &mut owned.transport {
      run closeProvider<P>(&mut value)
    }
    return ()
  }
  return run Effect.useReleaseNonParking(move lease, move use, move release)
}

/// Lends an owned connection for a callback, then closes it on every exit.
pub effect<'env> fn withOwned<P: 'env, A, E, ?R, H: ConnectionHandler<P, A, E ? R> + 'env, 'env>(
  transport: P,
  origin: Origin,
  version: Version,
  limits: Limits,
  overallDeadline: Option<Instant>,
  handler: H,
) -> A
! E | ClientError | OutOfMemoryError
? R | &mut Allocator
where
  &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut P provides &HttpTransport from &mut HttpTransport {
  let connection = run makeOwned(move transport, origin, version, limits, move overallDeadline)
  let lease = ConnectionLease<P, H> {
    connection: move connection,
    handler: Option.some<H>(move handler),
  }
  let use = effect fn(owned: &mut ConnectionLease<P, H>) -> A ! E ? R {
    let stored = Intrinsic.replace(owned.handler, Option.none<H>())
    let selected = match move stored {
      Option.Some {value} => move value
      Option.None => unavailable<H>()
    }
    return run ConnectionHandler<P, A, E ? R>.handle(move selected, &mut owned.connection)
  }
  let release = effect fn(owned: &mut ConnectionLease<P, H>) -> () {
    if owned.connection.closeAuthority != CloseAuthority.Armed {
      return ()
    }
    owned.connection.closeAuthority = CloseAuthority.Closed
    owned.connection.phaseValue = ConnectionPhase.Closed
    return run closeProvider<P>(&mut owned.connection.transport)
  }
  return run Effect.useReleaseNonParking(move lease, move use, move release)
}

/// Lends an explicit transport through one terminal connection scope while its physical owner stays outside.
pub effect<'env> fn withConnected<'env, P, A, E, ?R, H: ConnectionHandler<Loan<'env, P>, A, E ? R>>(
  transport: &'env mut P,
  origin: Origin,
  version: Version,
  limits: Limits,
  overallDeadline: Option<Instant>,
  handler: H,
) -> A
! E | ClientError | OutOfMemoryError
? R | &mut Allocator
where
  &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut P provides &HttpTransport from &mut HttpTransport {
  let loan = Transport.borrow(move transport)
  return run withOwned<Loan<'env, P>, A, E, R, H>(
    move loan,
    origin,
    version,
    limits,
    move overallDeadline,
    move handler,
  )
}

/// Closes an owned connection terminally without flushing or draining; repeated closure is local.
pub effect fn close<P>(connection: &mut Connection<P>) -> ()
! ClientError
where &mut P provides &HttpTransport from &mut HttpTransport {
  if connection.closeAuthority == CloseAuthority.Closed {
    return ()
  }
  if connection.closeAuthority == CloseAuthority.Transferred {
    return ()
  }
  connection.closeAuthority = CloseAuthority.Closed
  connection.phaseValue = ConnectionPhase.Closed
  let result = run Effect.result(HttpTransport.close())
    |> Effect.provideMut<HttpTransport>(&mut connection.transport)
  if let Result.Failure {error} = move result {
    fail ClientError.Transport {error: move error}
  }
  return ()
}

struct Acquisition<P> {
  transport: Option<P>
}

struct ConnectionLease<P, H> {
  connection: Connection<P>
  handler: Option<H>
}

effect fn releaseConnectionLease<P, H>(owned: &mut ConnectionLease<P, H>) -> ()
where &mut P provides &HttpTransport from &mut HttpTransport {
  if owned.connection.closeAuthority != CloseAuthority.Armed {
    return ()
  }
  owned.connection.closeAuthority = CloseAuthority.Closed
  owned.connection.phaseValue = ConnectionPhase.Closed
  return run closeProvider<P>(&mut owned.connection.transport)
}

fn unavailable<T>() -> T {
  let crash = 1 / 0
  return unavailable<T>()
}

effect fn closeProvider<P>(provider: &mut P) -> ()
where &mut P provides &HttpTransport from &mut HttpTransport {
  let closed = run Effect.result(HttpTransport.close())
    |> Effect.provideMut<HttpTransport>(&mut provider.*)
  drop closed
  return ()
}

/// Lends one prepared exchange. Incomplete or failed callbacks permanently remove reuse authority.
pub effect fn withExchange<'exchange, 'callback, P, A, E, ?R>(
  connection: &'exchange mut Connection<P>,
  request: &PreparedRequest,
  requestedOptions: RequestOptions,
  callback: for<'call, 'exchangeView: 'call> once fn<'callback>(
    &'call mut Exchange<'exchangeView, P>,
  ) -> once Effect<'call & 'callback; A ! E ? R>,
) -> A ! E | ClientError | OutOfMemoryError ? R | &mut Allocator {
  if connection.phaseValue != ConnectionPhase.Ready {
    fail ClientError.InvalidState
  }
  if PreparedRequest.version(request) != connection.version {
    fail ClientError.InvalidRequest
  }
  let physicalPeer = PreparedRequest.physicalPeer(request)
  if !Origin.equals(&connection.origin, &physicalPeer) {
    fail ClientError.InvalidRequest
  }
  if connection.requests >= connection.limits.maxRequests {
    fail ClientError.LimitExceeded
  }
  let RequestOptions {deadline: callerDeadline, continuePolicy} = move requestedOptions
  let options = RequestOptions {
    deadline: clampDeadline(&callerDeadline, &connection.overallDeadline),
    continuePolicy: move continuePolicy,
  }
  let required = match & options.continuePolicy {
    ContinuePolicy.Disabled => false
    ContinuePolicy.Require100 {deadline} => true
  }
  if required != PreparedRequest.require100(request) {
    fail ClientError.InvalidRequest
  }
  if connection.parserUsed {
    let reset = RequestParser.reset(&mut connection.requestParser)
    if let Result.Failure {error} = move reset {
      fail ClientError.Head {error: move error}
    }
  }
  connection.parserUsed = true
  let bytes = PreparedRequest.bytes(request)
  let progress = match move RequestParser.feed(&mut connection.requestParser, bytes, true) {
    Result.Failure {error} => {
      fail ClientError.Head {error: move error}
    }
    Result.Success {value} => value
  }
  if progress.state != HeadState.Complete || progress.consumed != bytes.length {
    fail ClientError.InvalidRequest
  }
  let head = match move RequestParser.head(&connection.requestParser) {
    Result.Failure {error} => {
      fail ClientError.Head {error: move error}
    }
    Result.Success {value} => value
  }
  if required && head.version() != Version.Http11 {
    fail ClientError.InvalidRequest
  }
  let policy = TrailerPolicy.defaultPolicy()
  let selection = match move Body.validateOutgoingRequest(head, policy) {
    Result.Failure {error} => {
      fail ClientError.Body {error: move error}
    }
    Result.Success {value} => move value
  }
  let encoder = match move run Encoder.make(move selection, connection.limits.requestBody, policy) {
    Result.Failure {error} => {
      fail ClientError.Body {error: move error}
    }
    Result.Success {value} => move value
  }
  drop head
  let headBytes = run Bytes.copy(bytes)
  drop bytes
  if connection.requests > usize.ZERO {
    let resetResponse = ResponseParser.reset(&mut connection.responseParser)
    if let Result.Failure {error} = move resetResponse {
      fail ClientError.Head {error: move error}
    }
  }
  connection.phaseValue = ConnectionPhase.Active
  connection.requests = connection.requests + usize.ONE
  let exchange = Exchange {
    connection: move connection,
    encoder: move encoder,
    decoder: Option.none<Decoder>(),
    contentDecoder: Option.none<Box<ContentDecoder>>(),
    bodySelected: false,
    contentSelected: false,
    options: move options,
    phaseValue: ExchangePhase.Prepared,
    headBytes: move headBytes,
    requestComplete: false,
    responseDelimited: false,
    responseWireTotal: u64.MIN,
    requestPayloadTotal: u64.MIN,
    requestWireTotal: u64.MIN,
    reusable: true,
    informationalCount: usize.ZERO,
    informationalWire: u64.MIN,
    responseHeadUsed: false,
    callbackSucceeded: false,
  }
  let use = effect fn(owned: &mut Exchange<'exchange, P>) -> A ! E ? R {
    let value = run callback(&mut owned.*)
    owned.callbackSucceeded = true
    return move value
  }
  let release = effect fn(owned: &mut Exchange<'exchange, P>) -> () {
    if owned.callbackSucceeded && owned.phaseValue == ExchangePhase.Finished && owned.reusable {
      owned.connection.phaseValue = ConnectionPhase.Ready
    } else {
      owned.connection.phaseValue = ConnectionPhase.Closed
      Encoder.abandon(&mut owned.encoder)
      if let Option.Some {value} = &mut owned.contentDecoder {
        abandonContentBox(&mut value)
      }
    }
    return ()
  }
  return run Effect.useReleaseNonParking(move exchange, move use, move release)
}

/// Sends the prepared head once; Require100 also flushes before waiting for response heads.
pub effect fn send<'exchange, P>(exchange: &mut Exchange<'exchange, P>) -> ()
! ClientError | OutOfMemoryError
? &mut MonotonicClock | &mut Allocator | &mut Random
where
  &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random {
  if exchange.phaseValue != ExchangePhase.Prepared {
    fail ClientError.InvalidState
  }
  exchange.phaseValue = ExchangePhase.Aborted
  run checkDeadline(&exchange.options.deadline, false)
  let bytes = Bytes.asSlice(&exchange.headBytes)
  run writeBytes(&mut exchange.connection.*, bytes, &exchange.options.deadline)
  let written = bytes.length
  drop bytes
  let required = match & exchange.options.continuePolicy {
    ContinuePolicy.Disabled => false
    ContinuePolicy.Require100 {deadline} => true
  }
  if required {
    run flushConnection(
      &mut exchange.connection.*,
      &exchange.options.deadline,
      WriteProgress {
        consumed: usize.ZERO,
        written: written,
        totalPayload: u64.MIN,
        totalWire: usize.toU64(written),
      },
    )
    exchange.phaseValue = ExchangePhase.AwaitContinue
  } else {
    exchange.phaseValue = ExchangePhase.Upload
  }
  return ()
}

/// Accepts one payload prefix and preserves exact payload and transport progress on failure.
pub effect fn writeSome<'exchange, P>(exchange: &mut Exchange<'exchange, P>, input: &[u8]) -> WriteProgress
! ClientError | OutOfMemoryError
? &mut MonotonicClock | &mut Allocator | &mut Random
where
  &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random {
  if exchange.phaseValue != ExchangePhase.Upload {
    fail ClientError.InvalidState
  }
  exchange.phaseValue = ExchangePhase.Aborted
  run checkDeadline(&exchange.options.deadline, false)
  let scratch = Bytes.asMutSlice(&mut exchange.connection.scratch)
  let stepped = Encoder.step(&mut exchange.encoder, input, &mut scratch)
  drop scratch
  let progress = match move stepped {
    Result.Failure {error} => {
      exchange.phaseValue = ExchangePhase.Aborted
      fail ClientError.Body {error: move error}
    }
    Result.Success {value} => value
  }
  exchange.requestPayloadTotal = progress.totalPayload
  exchange.requestWireTotal = progress.totalWire
  let readableScratch = Bytes.asSlice(&exchange.connection.scratch)
  let bytes = Slice.view<u8>(readableScratch, usize.ZERO, progress.written)
  let mut written = usize.ZERO
  exchange.phaseValue = ExchangePhase.Aborted
  while written < bytes.length {
    run checkOutputDeadline(
      &exchange.options.deadline,
      WriteProgress {
        consumed: progress.consumed,
        written: written,
        totalPayload: progress.totalPayload,
        totalWire: progress.totalWire,
      },
    )
    let remaining = Slice.view<u8>(bytes, written, bytes.length - written)
    let result = run Effect.result(
      HttpTransport.writeSome(remaining, copyDeadline(&exchange.options.deadline)),
    )
      |> Effect.provideMut<HttpTransport>(&mut exchange.connection.transport)
    drop remaining
    let count = match move result {
      Result.Failure {error} => {
        return match move error {
          TransportError cause => {
            fail ClientError.Output {
              error: move cause,
              progress: WriteProgress {
                consumed: progress.consumed,
                written: written,
                totalPayload: progress.totalPayload,
                totalWire: progress.totalWire,
              },
            }
          }
          OutOfMemoryError allocation => {
            fail ClientError.OutputAllocation {
              error: move allocation,
              progress: WriteProgress {
                consumed: progress.consumed,
                written: written,
                totalPayload: progress.totalPayload,
                totalWire: progress.totalWire,
              },
            }
          }
        }
      }
      Result.Success {value} => value
    }
    written = written + count
  }
  drop bytes
  drop readableScratch
  exchange.phaseValue = ExchangePhase.Upload
  return WriteProgress {
    consumed: progress.consumed,
    written: written,
    totalPayload: progress.totalPayload,
    totalWire: progress.totalWire,
  }
}

/// Completes bounded request trailers and flushes before response reads are permitted.
pub effect fn finishRequest<'exchange, P>(exchange: &mut Exchange<'exchange, P>, trailers: &Headers) -> ()
! ClientError | OutOfMemoryError
? &mut MonotonicClock | &mut Allocator | &mut Random
where
  &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random {
  if exchange.phaseValue != ExchangePhase.Upload {
    fail ClientError.InvalidState
  }
  exchange.phaseValue = ExchangePhase.Aborted
  run checkDeadline(&exchange.options.deadline, false)
  let begun = Encoder.beginFinish(&mut exchange.encoder, trailers)
  if let Result.Failure {error} = move begun {
    fail ClientError.Body {error: move error}
  }
  let mut written = usize.ZERO
  while !encoderComplete(&exchange.encoder) {
    let scratch = Bytes.asMutSlice(&mut exchange.connection.scratch)
    let stepped = Encoder.continueFinish(&mut exchange.encoder, &mut scratch)
    drop scratch
    let progress = match move stepped {
      Result.Failure {error} => {
        fail ClientError.Body {error: move error}
      }
      Result.Success {value} => value
    }
    exchange.requestPayloadTotal = progress.totalPayload
    exchange.requestWireTotal = progress.totalWire
    let readableScratch = Bytes.asSlice(&exchange.connection.scratch)
    let bytes = Slice.view<u8>(readableScratch, usize.ZERO, progress.written)
    run writeTransport(
      &mut exchange.connection.transport,
      bytes,
      &exchange.options.deadline,
      written,
      Option.some<WriteProgress>(
        WriteProgress {
          consumed: progress.consumed,
          written: progress.written,
          totalPayload: progress.totalPayload,
          totalWire: progress.totalWire,
        },
      ),
    )
    written = written + progress.written
    drop bytes
    drop readableScratch
  }
  let flushedProgress = WriteProgress {
    consumed: usize.ZERO,
    written: written,
    totalPayload: exchange.requestPayloadTotal,
    totalWire: exchange.requestWireTotal,
  }
  run flushConnection(&mut exchange.connection.*, &exchange.options.deadline, flushedProgress)
  exchange.requestComplete = true
  exchange.phaseValue = ExchangePhase.AwaitResponse
  return ()
}

/// Receives one bounded head; informational and final error statuses remain ordinary response values.
pub effect fn receive<'exchange, P>(exchange: &mut Exchange<'exchange, P>) -> u16
! ClientError | OutOfMemoryError
? &mut MonotonicClock | &mut Allocator | &mut Random
where
  &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random {
  if exchange.phaseValue != ExchangePhase.AwaitContinue && exchange.phaseValue != ExchangePhase.AwaitResponse {
    fail ClientError.InvalidState
  }
  let waiting = exchange.phaseValue == ExchangePhase.AwaitContinue
  let deadline = receiveDeadline(&exchange.options, waiting)
  exchange.phaseValue = ExchangePhase.Aborted
  run checkDeadline(&deadline, waiting)
  if exchange.responseHeadUsed {
    let reset = ResponseParser.reset(&mut exchange.connection.responseParser)
    if let Result.Failure {error} = move reset {
      fail ClientError.Head {error: move error}
    }
  }
  let mut wire = u64.MIN
  while true {
    let input = Bytes.asSlice(&exchange.connection.input)
    let bytes = Slice.view<u8>(
      input,
      exchange.connection.start,
      exchange.connection.end - exchange.connection.start,
    )
    let stepped = ResponseParser.feed(
      &mut exchange.connection.responseParser,
      bytes,
      exchange.connection.eof,
    )
    drop bytes
    drop input
    let progress = match move stepped {
      Result.Failure {error} => {
        fail ClientError.Head {error: move error}
      }
      Result.Success {value} => value
    }
    exchange.connection.start = exchange.connection.start + progress.consumed
    wire = wire + usize.toU64(progress.consumed)
    if progress.state == HeadState.Complete {
      break
    }
    if exchange.connection.eof {
      fail ClientError.TruncatedHead
    }
    let filled = run Effect.result(fill(&mut exchange.connection.*, &deadline))
    if let Result.Failure {error} = move filled {
      if waiting && inputTimedOut(&error) {
        drop error
        fail ClientError.ContinueTimeout
      }
      fail move error
    }
  }
  exchange.responseHeadUsed = true
  let head = match move ResponseParser.head(&exchange.connection.responseParser) {
    Result.Failure {error} => {
      fail ClientError.Head {error: move error}
    }
    Result.Success {value} => value
  }
  let status = head.status()
  let code = Status.code(&status)
  if code == 101 {
    fail ClientError.UnsupportedUpgrade
  }
  if code < 200 {
    if exchange.informationalCount >= exchange.connection.limits.maxInformationalResponses {
      fail ClientError.LimitExceeded
    }
    if wire > exchange.connection.limits.maxInformationalWireBytes - exchange.informationalWire {
      fail ClientError.LimitExceeded
    }
    exchange.informationalCount = exchange.informationalCount + usize.ONE
    exchange.informationalWire = exchange.informationalWire + wire
    if waiting && code == 100 {
      exchange.phaseValue = ExchangePhase.Upload
    } else if waiting {
      exchange.phaseValue = ExchangePhase.AwaitContinue
    } else {
      exchange.phaseValue = ExchangePhase.AwaitResponse
    }
    return code
  }
  if waiting {
    exchange.reusable = false
  }
  let requestHead = match move RequestParser.head(&exchange.connection.requestParser) {
    Result.Failure {error} => {
      fail ClientError.Head {error: move error}
    }
    Result.Success {value} => value
  }
  let method = requestHead.method()
  let policy = TrailerPolicy.defaultPolicy()
  let selection = match move Body.selectResponse(head, &method, policy) {
    Result.Failure {error} => {
      fail ClientError.Body {error: move error}
    }
    Result.Success {value} => move value
  }
  let framing = selection.framing()
  exchange.responseDelimited = match framing {
    Framing.Empty => true
    Framing.Fixed {length} => true
    Framing.Chunked => true
    _ => false
  }
  if selection.anomaly() != Anomaly.None || !exchange.responseDelimited {
    exchange.reusable = false
  }
  if responseCloses(head) || requestCloses(requestHead) {
    exchange.reusable = false
  }
  if head.version() == Version.Http10 || requestHead.version() == Version.Http10 {
    let mut responseFields = head.fields()
    let mut requestFields = requestHead.fields()
    if !fieldsHaveToken(&mut responseFields, b"keep-alive") || !fieldsHaveToken(
      &mut requestFields,
      b"keep-alive",
    ) {
      exchange.reusable = false
    }
  }
  let tunnel = match framing {
    Framing.Tunnel => true
    _ => false
  }
  let decoder = match move run Decoder.make(
    move selection,
    exchange.connection.limits.responseBody,
    policy,
  ) {
    Result.Failure {error} => {
      fail ClientError.Body {error: move error}
    }
    Result.Success {value} => move value
  }
  drop method
  drop requestHead
  drop head
  exchange.decoder = Option.some<Decoder>(move decoder)
  if tunnel {
    exchange.phaseValue = ExchangePhase.Tunnel
  } else {
    exchange.phaseValue = ExchangePhase.Response
  }
  return code
}

/// Receives bounded informational heads until the shared parser reaches one final response.
///
/// # Details
///
/// Parser, head, informational-budget, 101-upgrade, transport, and deadline failures remain the
/// original `ClientError`. This operation does not copy response metadata or consume a body.
pub effect fn receiveFinal<'exchange, P>(exchange: &mut Exchange<'exchange, P>) -> u16
! ClientError | OutOfMemoryError
? &mut MonotonicClock | &mut Allocator | &mut Random
where
  &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random {
  while true {
    let code = run receive(&mut exchange.*)
    if code >= 200 {
      return code
    }
  }
  return 200
}

/// Reads one framed payload prefix without consuming the next message suffix.
pub effect fn readSome<'exchange, P>(exchange: &mut Exchange<'exchange, P>, output: &mut [u8]) -> usize
! ClientError | OutOfMemoryError
? &mut MonotonicClock | &mut Allocator | &mut Random
where
  &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random {
  if exchange.phaseValue != ExchangePhase.Response {
    fail ClientError.InvalidState
  }
  if exchange.contentSelected {
    fail ClientError.InvalidState
  }
  if output.length == usize.ZERO {
    return usize.ZERO
  }
  exchange.bodySelected = true
  exchange.phaseValue = ExchangePhase.Aborted
  run checkDeadline(&exchange.options.deadline, false)
  while true {
    let input = Bytes.asSlice(&exchange.connection.input)
    let bytes = Slice.view<u8>(
      input,
      exchange.connection.start,
      exchange.connection.end - exchange.connection.start,
    )
    let stepped = match &mut exchange.decoder {
      Option.None => {
        fail ClientError.InvalidState
      }
      Option.Some {value} => Decoder.step(&mut value, bytes, &mut output, exchange.connection.eof)
    }
    drop bytes
    drop input
    let progress = match move stepped {
      Result.Failure {error} => {
        exchange.connection.start = exchange.connection.start + error.consumed
        exchange.responseWireTotal = error.totalWire
        exchange.phaseValue = ExchangePhase.Aborted
        fail ClientError.Body {error: move error}
      }
      Result.Success {value} => value
    }
    exchange.connection.start = exchange.connection.start + progress.consumed
    exchange.responseWireTotal = progress.totalWire
    if progress.written > usize.ZERO || progress.state == ProgressState.Complete {
      exchange.phaseValue = ExchangePhase.Response
      return progress.written
    }
    run fill(&mut exchange.connection.*, &exchange.options.deadline)
  }
  return usize.ZERO
}

union DiscardAttempt {
  Completed,
  CapReached {error: BodyError},
}

/// Discards response framing up to one aggregate wire-byte limit and reports whether it completed.
///
/// # When to use
///
/// Use this operation when a caller can continue after the discard reaches its cap.
///
/// # Details
///
/// The operation uses the smaller caller limit and `Limits.maxDiscardWireBytes`. The limit
/// includes payload and framing bytes. Its explicit cleanup deadline is clamped to the exchange's
/// unchanged operation deadline. `Completed` permits a later [`finishResponse`] call. `CapReached`
/// leaves the exchange incomplete and removes reuse authority.
///
/// # Gotchas
///
/// Malformed framing and read, deadline, allocation, or transport failures remain typed failures.
pub effect fn discardRemainingAtMost<'exchange, P>(
  exchange: &mut Exchange<'exchange, P>,
  maxWireBytes: u64,
  deadline: Option<Instant>,
) -> DiscardOutcome
! ClientError | OutOfMemoryError
? &mut MonotonicClock | &mut Allocator | &mut Random
where
  &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random {
  let selectedDeadline = clampDeadline(&deadline, &exchange.options.deadline)
  let attempted = run discardRemainingCore(&mut exchange.*, maxWireBytes, move selectedDeadline)
  return match move attempted {
    DiscardAttempt.Completed => DiscardOutcome.Completed
    DiscardAttempt.CapReached {error} => {
      drop error
      return DiscardOutcome.CapReached
    }
  }
}

/// Drains and finishes the selected response under one finite aggregate wire-byte limit.
///
/// # When to use
///
/// Use this operation inside the live exchange when a response must complete before connection
/// reuse. The standard client limit is 65536 bytes, and the maximum admitted limit is 1048576.
///
/// # Details
///
/// The operation uses the smaller caller limit and `Limits.maxDiscardWireBytes`. The limit counts
/// payload, framing, and trailers. The finite deadline is clamped to the request deadline. If a
/// content decoder was selected, the operation validates it before it calls [`finishResponse`].
///
/// # Gotchas
///
/// `CapReached` leaves the exchange incomplete. Timeout, malformed framing, read, allocation,
/// transport, and content-decoder failures remain their original typed failures.
pub effect fn drainAndFinishAtMost<'exchange, P>(
  exchange: &mut Exchange<'exchange, P>,
  maxWireBytes: u64,
  deadline: Instant,
) -> DiscardOutcome
! ClientError | OutOfMemoryError
? &mut MonotonicClock | &mut Allocator | &mut Random
where
  &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random {
  if maxWireBytes > MAX_DRAIN_WIRE_BYTES {
    fail ClientError.InvalidLimits
  }
  let requestedDeadline = Option.some<Instant>(move deadline)
  let selectedDeadline = clampDeadline(&requestedDeadline, &exchange.options.deadline)
  let mut outcome = DiscardOutcome.Completed
  if exchange.contentSelected {
    outcome = run drainSelectedContentAtMost(&mut exchange.*, maxWireBytes, move selectedDeadline)
  } else {
    let attempted = run discardRemainingCore(&mut exchange.*, maxWireBytes, move selectedDeadline)
    outcome = match move attempted {
      DiscardAttempt.Completed => DiscardOutcome.Completed
      DiscardAttempt.CapReached {error} => {
        drop error
        return DiscardOutcome.CapReached
      }
    }
  }
  return match move outcome {
    DiscardOutcome.CapReached => {
      exchange.reusable = false
      return DiscardOutcome.CapReached
    }
    DiscardOutcome.Completed => {
      run finishResponse(&mut exchange.*)
      return DiscardOutcome.Completed
    }
  }
}

/// Discards response framing under the smaller caller and client wire budget, without consuming a subsequent message.
/// A deadline, limit, framing, or transport failure permanently removes reuse authority.
pub effect fn discardRemaining<'exchange, P>(
  exchange: &mut Exchange<'exchange, P>,
  maxWireBytes: u64,
) -> ()
! ClientError | OutOfMemoryError
? &mut MonotonicClock | &mut Allocator | &mut Random
where
  &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random {
  let selectedDeadline = copyDeadline(&exchange.options.deadline)
  let attempted = run discardRemainingCore(&mut exchange.*, maxWireBytes, move selectedDeadline)
  return match move attempted {
    DiscardAttempt.Completed => ()
    DiscardAttempt.CapReached {error} => {
      fail ClientError.Body {error: move error}
    }
  }
}

effect fn discardRemainingCore<'exchange, P>(
  exchange: &mut Exchange<'exchange, P>,
  maxWireBytes: u64,
  deadline: Option<Instant>,
) -> DiscardAttempt
! ClientError | OutOfMemoryError
? &mut MonotonicClock | &mut Allocator | &mut Random
where
  &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random {
  if exchange.phaseValue != ExchangePhase.Response {
    fail ClientError.InvalidState
  }
  if exchange.contentSelected {
    fail ClientError.InvalidState
  }
  exchange.bodySelected = true
  exchange.phaseValue = ExchangePhase.Aborted
  run checkDeadline(&deadline, false)
  let mut budget = maxWireBytes
  if budget > exchange.connection.limits.maxDiscardWireBytes {
    budget = exchange.connection.limits.maxDiscardWireBytes
  }
  let absolute = match move u64.checkedAdd(exchange.responseWireTotal, budget) {
    Option.None => {
      fail ClientError.LimitExceeded
    }
    Option.Some {value} => value
  }
  while true {
    let input = Bytes.asSlice(&exchange.connection.input)
    let bytes = Slice.view<u8>(
      input,
      exchange.connection.start,
      exchange.connection.end - exchange.connection.start,
    )
    let stepped = match &mut exchange.decoder {
      Option.None => {
        fail ClientError.InvalidState
      }
      Option.Some {value} => Decoder.discard(&mut value, bytes, exchange.connection.eof, absolute)
    }
    drop bytes
    drop input
    let progress = match move stepped {
      Result.Failure {error} => {
        exchange.connection.start = exchange.connection.start + error.consumed
        exchange.responseWireTotal = error.totalWire
        if discardCapReached(&error) {
          return DiscardAttempt.CapReached {error: move error}
        }
        fail ClientError.Body {error: move error}
      }
      Result.Success {value} => value
    }
    exchange.connection.start = exchange.connection.start + progress.consumed
    exchange.responseWireTotal = progress.totalWire
    if progress.state == ProgressState.Complete {
      exchange.phaseValue = ExchangePhase.Response
      return DiscardAttempt.Completed
    }
    run fill(&mut exchange.connection.*, &deadline)
  }
  return DiscardAttempt.Completed
}

effect fn drainSelectedContentAtMost<'exchange, P>(
  exchange: &mut Exchange<'exchange, P>,
  maxWireBytes: u64,
  deadline: Option<Instant>,
) -> DiscardOutcome
! ClientError | OutOfMemoryError
? &mut MonotonicClock | &mut Allocator | &mut Random
where
  &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random {
  if exchange.phaseValue != ExchangePhase.Response || !exchange.contentSelected {
    fail ClientError.InvalidState
  }
  exchange.phaseValue = ExchangePhase.Aborted
  run checkDeadline(&deadline, false)
  let mut budget = maxWireBytes
  if budget > exchange.connection.limits.maxDiscardWireBytes {
    budget = exchange.connection.limits.maxDiscardWireBytes
  }
  let absolute = match move u64.checkedAdd(exchange.responseWireTotal, budget) {
    Option.None => {
      fail ClientError.LimitExceeded
    }
    Option.Some {value} => value
  }
  while true {
    run checkDeadline(&deadline, false)
    let input = Bytes.asSlice(&exchange.connection.input)
    let available = exchange.connection.end - exchange.connection.start
    let remaining = absolute - exchange.responseWireTotal
    let mut admitted = available
    if usize.toU64(admitted) > remaining {
      admitted = u64.toUsize(remaining)
    }
    let bytes = Slice.view<u8>(input, exchange.connection.start, admitted)
    let output = Bytes.asMutSlice(&mut exchange.connection.scratch)
    let stepped = match &mut exchange.contentDecoder {
      Option.None => {
        fail ClientError.InvalidState
      }
      Option.Some {value} => stepContentBox(&mut value, bytes, &mut output, exchange.connection.eof)
    }
    drop output
    drop bytes
    drop input
    let progress = match move stepped {
      Result.Failure {error} => {
        exchange.connection.start = exchange.connection.start + error.consumed
        exchange.responseWireTotal = exchange.responseWireTotal + usize.toU64(error.consumed)
        fail ClientError.Content {error: move error.error}
      }
      Result.Success {value} => value
    }
    exchange.connection.start = exchange.connection.start + progress.consumed
    exchange.responseWireTotal = exchange.responseWireTotal + usize.toU64(progress.consumed)
    if progress.progress.state == ContentProgressState.End {
      exchange.phaseValue = ExchangePhase.Response
      return DiscardOutcome.Completed
    }
    if progress.needsInput {
      if exchange.responseWireTotal == absolute {
        return DiscardOutcome.CapReached
      }
      run fill(&mut exchange.connection.*, &deadline)
    }
  }
  return DiscardOutcome.Completed
}

fn discardCapReached(error: &BodyError) -> bool {
  return match error.reason {
    BodyReason.DiscardLimit {allowed, attempted} => true
    _ => false
  }
}

/// Returns completed chunk trailers borrowed exclusively from the active exchange.
pub effect fn trailers<'head, 'exchange, P>(exchange: &'head Exchange<'exchange, P>) -> Option<
  Trailers<'head>,
> ! ClientError {
  if exchange.phaseValue != ExchangePhase.Response {
    fail ClientError.InvalidState
  }
  if exchange.contentSelected {
    return match & exchange.contentDecoder {
      Option.None => {
        fail ClientError.InvalidState
      }
      Option.Some {value} => {
        return match move contentBoxTrailers(&value) {
          Result.Failure {error} => {
            fail ClientError.Content {error: move error}
          }
          Result.Success {value: found} => move found
        }
      }
    }
  }
  return match & exchange.decoder {
    Option.None => {
      fail ClientError.InvalidState
    }
    Option.Some {value} => Decoder.trailers(&value)
  }
}

/// Completes the response only after framing proves its boundary; never drains unread bytes.
pub effect fn finishResponse<'exchange, P>(exchange: &mut Exchange<'exchange, P>) -> ()
! ClientError {
  if exchange.phaseValue != ExchangePhase.Response {
    fail ClientError.InvalidState
  }
  let mut complete = false
  if exchange.contentSelected {
    exchange.phaseValue = ExchangePhase.Aborted
    complete = match move contentComplete(&exchange.contentDecoder) {
      Result.Success {value} => value
      Result.Failure {error} => {
        fail move error
      }
    }
    exchange.phaseValue = ExchangePhase.Response
  } else {
    complete = match & exchange.decoder {
      Option.None => false
      Option.Some {value} => decoderComplete(&value)
    }
  }
  if !complete {
    fail ClientError.InvalidState
  }
  if !exchange.requestComplete || !exchange.responseDelimited {
    exchange.reusable = false
  }
  exchange.phaseValue = ExchangePhase.Finished
  return ()
}

/// Removes reuse authority immediately without transport output or a hidden drain.
pub fn abort<'exchange, P>(exchange: &mut Exchange<'exchange, P>) -> () {
  exchange.phaseValue = ExchangePhase.Aborted
  exchange.reusable = false
  exchange.connection.phaseValue = ConnectionPhase.Closed
  Encoder.abandon(&mut exchange.encoder)
  return ()
}

fn encoderComplete(encoder: &Encoder) -> bool {
  return match move Encoder.completion(encoder) {
    Option.None => false
    Option.Some {value} => {
      drop value
      return true
    }
  }
}

fn copyDeadline(value: &Option<Instant>) -> Option<Instant> {
  return match & value.* {
    Option.None => Option.none<Instant>()
    Option.Some {value: present} => Option.some<Instant>(copyInstant(&present))
  }
}

fn copyInstant(value: &Instant) -> Instant {
  return SystemClock.make(SystemClock.seconds(value), SystemClock.nanoseconds(value))
}

fn before(left: &Instant, right: &Instant) -> bool {
  return SystemClock.seconds(left) < SystemClock.seconds(right) || (SystemClock.seconds(left) == SystemClock.seconds(
    right,
  ) && SystemClock.nanoseconds(left) < SystemClock.nanoseconds(right))
}

fn receiveDeadline(options: &RequestOptions, waiting: bool) -> Option<Instant> {
  if !waiting {
    return copyDeadline(&options.deadline)
  }
  return match & options.continuePolicy {
    ContinuePolicy.Disabled => copyDeadline(&options.deadline)
    ContinuePolicy.Require100 {deadline} => match & options.deadline {
      Option.None => Option.some<Instant>(copyInstant(&deadline))
      Option.Some {value} => {
        if before(&value, &deadline) {
          return Option.some<Instant>(copyInstant(&value))
        }
        return Option.some<Instant>(copyInstant(&deadline))
      }
    }
  }
}

effect fn checkDeadline(deadline: &Option<Instant>, waiting: bool) -> ()
! ClientError
? &mut MonotonicClock {
  if let Option.Some {value} = &deadline.* {
    let now = run MonotonicClock.now()
    if !before(&now, &value) {
      if waiting {
        fail ClientError.ContinueTimeout
      }
      fail ClientError.Timeout
    }
  }
  return ()
}

effect fn checkOutputDeadline(deadline: &Option<Instant>, progress: WriteProgress) -> ()
! ClientError
? &mut MonotonicClock {
  if let Option.Some {value} = &deadline.* {
    let now = run MonotonicClock.now()
    if !before(&now, &value) {
      if progress.consumed > usize.ZERO || progress.written > usize.ZERO {
        fail ClientError.OutputTimeout {progress: progress}
      }
      fail ClientError.Timeout
    }
  }
  return ()
}

fn inputTimedOut(error: &(ClientError | OutOfMemoryError)) -> bool {
  return match & error.* {
    ClientError cause => match & cause {
      ClientError.Timeout => true
      ClientError.Transport {error: transport} => match & transport {
        TransportError.Plain {error: plain} => byteTimedOut(&plain)
        TransportError.Secured {error: secured} => match & secured {
          ConnectionError.Io {error: io} => byteTimedOut(&io)
          _ => false
        }
      }
      _ => false
    }
    _ => false
  }
}

fn byteTimedOut(error: &ByteIoError) -> bool {
  return match & error.* {
    ByteIoError.Timeout {operation} => true
    _ => false
  }
}

fn responseCloses(head: ResponseHead) -> bool {
  let mut fields = head.fields()
  return fieldsClose(&mut fields)
}

fn requestCloses(head: RequestHead) -> bool {
  let mut fields = head.fields()
  return fieldsClose(&mut fields)
}

fn fieldsClose(fields: &mut HeaderIterator) -> bool {
  return fieldsHaveToken(&mut fields.*, b"close")
}

fn fieldsHaveToken(fields: &mut HeaderIterator, sought: &[u8]) -> bool {
  while true {
    let next = HeaderIterator.next(&mut fields.*)
    match move next {
      Option.None => {
        return false
      }
      Option.Some {value} => {
        if asciiEqual(String.utf8Bytes(Header.name(&value)), b"connection") && containsToken(
          Header.value(&value),
          sought,
        ) {
          return true
        }
      }
    }
  }
  return false
}

fn containsToken(bytes: &[u8], sought: &[u8]) -> bool {
  let mut start = usize.ZERO
  while start < bytes.length {
    let mut end = start
    while end < bytes.length && bytes[end] != 44 {
      end = end + usize.ONE
    }
    let mut left = start
    let mut right = end
    while left < right && (bytes[left] == 32 || bytes[left] == 9) {
      left = left + usize.ONE
    }
    while right > left && (bytes[right - usize.ONE] == 32 || bytes[right - usize.ONE] == 9) {
      right = right - usize.ONE
    }
    let token = Slice.view<u8>(bytes, left, right - left)
    let found = asciiEqual(token, sought)
    drop token
    if found {
      return true
    }
    start = end + usize.ONE
  }
  return false
}

fn asciiEqual(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut index = usize.ZERO
  while index < left.length {
    let mut byte = left[index]
    if byte >= 65 && byte <= 90 {
      byte = byte + 32
    }
    if byte != right[index] {
      return false
    }
    index = index + usize.ONE
  }
  return true
}

effect fn fill<P>(connection: &mut Connection<P>, deadline: &Option<Instant>) -> ()
! ClientError | OutOfMemoryError
? &mut MonotonicClock | &mut Allocator | &mut Random
where
  &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random {
  if connection.start != connection.end {
    fail ClientError.InvalidState
  }
  run checkDeadline(deadline, false)
  connection.start = usize.ZERO
  connection.end = usize.ZERO
  let output = Bytes.asMutSlice(&mut connection.input)
  let result = run Effect.result(HttpTransport.readSome(&mut output, copyDeadline(deadline)))
    |> Effect.provideMut<HttpTransport>(&mut connection.transport)
  drop output
  let read = match move result {
    Result.Failure {error} => {
      return run transportFailure(move error)
    }
    Result.Success {value} => move value
  }
  match move read {
    ReadTransfer.End => {
      connection.eof = true
    }
    ReadTransfer.Data {count} => {
      connection.end = count
    }
  }
  return ()
}

effect fn writeBytes<P>(connection: &mut Connection<P>, bytes: &[u8], deadline: &Option<Instant>) -> ()
! ClientError | OutOfMemoryError
? &mut MonotonicClock | &mut Allocator | &mut Random
where
  &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random {
  return run writeTransport(
    &mut connection.transport,
    bytes,
    deadline,
    usize.ZERO,
    Option.none<WriteProgress>(),
  )
}

effect fn flushConnection<P>(
  connection: &mut Connection<P>,
  deadline: &Option<Instant>,
  progress: WriteProgress,
) -> ()
! ClientError | OutOfMemoryError
? &mut MonotonicClock | &mut Allocator | &mut Random
where
  &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random {
  run checkOutputDeadline(deadline, progress)
  let result = run Effect.result(HttpTransport.flush(copyDeadline(deadline)))
    |> Effect.provideMut<HttpTransport>(&mut connection.transport)
  if let Result.Failure {error} = move result {
    return match move error {
      TransportError cause => {
        fail ClientError.Output {error: move cause, progress: progress}
      }
      OutOfMemoryError allocation => {
        fail ClientError.OutputAllocation {error: move allocation, progress: progress}
      }
    }
  }
  return ()
}

fn outputProgress(written: usize, encoded: &Option<WriteProgress>) -> WriteProgress {
  return match & encoded.* {
    Option.Some {value} => WriteProgress {
      consumed: value.consumed,
      written: written,
      totalPayload: value.totalPayload,
      totalWire: value.totalWire,
    }
    Option.None => WriteProgress {
      consumed: usize.ZERO,
      written: written,
      totalPayload: u64.MIN,
      totalWire: usize.toU64(written),
    }
  }
}

effect fn writeTransport<P>(
  transport: &mut P,
  bytes: &[u8],
  deadline: &Option<Instant>,
  priorWritten: usize,
  encoderProgress: Option<WriteProgress>,
) -> ()
! ClientError | OutOfMemoryError
? &mut MonotonicClock | &mut Allocator | &mut Random
where
  &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random {
  let mut written = usize.ZERO
  while written < bytes.length {
    let progress = outputProgress(priorWritten + written, &encoderProgress)
    run checkOutputDeadline(deadline, progress)
    let remaining = Slice.view<u8>(bytes, written, bytes.length - written)
    let result = run Effect.result(HttpTransport.writeSome(remaining, copyDeadline(deadline)))
      |> Effect.provideMut<HttpTransport>(&mut transport)
    drop remaining
    let count = match move result {
      Result.Failure {error} => {
        return match move error {
          TransportError cause => {
            fail ClientError.Output {error: move cause, progress: progress}
          }
          OutOfMemoryError allocation => {
            fail ClientError.OutputAllocation {error: move allocation, progress: progress}
          }
        }
      }
      Result.Success {value} => value
    }
    written = written + count
  }
  return ()
}

/// An exclusive non-HTTP channel that reads the buffered response suffix first.
pub struct Tunnel<'tunnel, P> {
  connection: &'tunnel mut Connection<P>
  overallDeadline: Option<Instant>
}

/// One transferred tunnel that owns the connection's byte transport and retained input suffix.
///
/// # Details
///
/// Reads use the retained suffix before the provider. All deadlines are clamped to the exchange
/// deadline. Complete close is terminal and attempts the concrete provider close at most one time.
pub struct TransferredTunnel<'tunnel, P> {
  connection: &'tunnel mut Connection<P>
  overallDeadline: Option<Instant>
  writeShutdown: bool
}

/// Hands successful CONNECT to one scoped tunnel callback and permanently consumes HTTP reuse authority.
pub effect fn withTunnel<'tunnel, 'exchange: 'tunnel, 'callback, P, A, E, ?R>(
  exchange: &'tunnel mut Exchange<'exchange, P>,
  callback: for<'call, 'tunnelView: 'call> once fn<'callback>(&'call mut Tunnel<'tunnelView, P>) -> once Effect<'call & 'callback; A ! E ? R>,
) -> A ! E | ClientError ? R {
  if exchange.phaseValue != ExchangePhase.Tunnel {
    fail ClientError.InvalidState
  }
  exchange.phaseValue = ExchangePhase.Aborted
  exchange.reusable = false
  exchange.connection.phaseValue = ConnectionPhase.Closed
  let mut tunnel = Tunnel {
    connection: &mut exchange.connection.*,
    overallDeadline: copyDeadline(&exchange.options.deadline),
  }
  return run callback(&mut tunnel)
}

impl<'tunnel, P> Tunnel<'tunnel, P> {
  /// Transfers the exact tunnel provider and retained input suffix to one scoped byte duplex.
  ///
  /// # Details
  ///
  /// This operation allocates no memory. It constructs the complete duplex before the HTTP owner
  /// transfers its physical close authority. The callback owns that authority until cleanup.
  /// Cleanup closes the duplex after success, typed failure, or structured cancellation.
  ///
  /// # Gotchas
  ///
  /// After scoped finalization, a repeated transfer returns `InvalidState` and leaves the existing
  /// Closed authority unchanged.
  pub effect fn transferByteDuplex<'transfer, 'callback, A, E, ?CallbackRequirements>(
    self: &'transfer mut Self,
    callback: for<'call, 'duplexView: 'call> once fn<'callback>(
      &'call mut TransferredTunnel<'duplexView, P>,
    ) -> once Effect<'call & 'callback; A ! E ? CallbackRequirements>,
  ) -> A
  ! E | ClientError
  ? CallbackRequirements
  where
    &mut P provides &ByteDuplex from &mut ByteDuplex,
    CallbackRequirements in Without<CallbackRequirements, ByteDuplex> {
    if self.connection.closeAuthority != CloseAuthority.Armed {
      fail ClientError.InvalidState
    }
    let deadline = copyDeadline(&self.overallDeadline)
    let mut transferred = TransferredTunnel<'transfer, P> {
      connection: &mut self.connection.*,
      overallDeadline: move deadline,
      writeShutdown: false,
    }
    TransferredTunnel.publish(&mut transferred)
    let use = effect fn(owned: &mut TransferredTunnel<'transfer, P>) -> A ! E ? CallbackRequirements {
      return run move callback(&mut owned.*)
    }
    let release = effect fn(owned: &mut TransferredTunnel<'transfer, P>) -> () {
      let closed = ByteDuplex.close()
        |> Effect.provideMut<ByteDuplex>(&mut owned.*)
      return run Effect.catchAll(move closed, discardByteIoError)
    }
    return run Effect.useReleaseNonParking(move transferred, move use, move release)
  }
  /// Reads the retained tunnel suffix before asking the underlying transport for more input.
  pub effect fn readSome(self: &mut Self, output: &mut [u8], requestedDeadline: Option<Instant>) -> ReadTransfer
  ! ClientError | OutOfMemoryError
  ? &mut MonotonicClock | &mut Allocator | &mut Random
  where
    &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random {
    let deadline = clampDeadline(&requestedDeadline, &self.overallDeadline)
    run checkDeadline(&deadline, false)
    if output.length == usize.ZERO {
      return ReadTransfer.Data {count: usize.ZERO}
    }
    if self.connection.start < self.connection.end {
      let bytes = Bytes.asSlice(&self.connection.input)
      let mut count = usize.ZERO
      while count < output.length && self.connection.start + count < self.connection.end {
        output[count] = bytes[self.connection.start + count]
        count = count + usize.ONE
      }
      drop bytes
      self.connection.start = self.connection.start + count
      return ReadTransfer.Data {count: count}
    }
    let result = run Effect.result(HttpTransport.readSome(&mut output, move deadline))
      |> Effect.provideMut<HttpTransport>(&mut self.connection.transport)
    return match move result {
      Result.Success {value} => move value
      Result.Failure {error} => {
        return run transportFailure(move error)
      }
    }
  }
  /// Writes one tunnel prefix under the caller's absolute deadline.
  pub effect fn writeSome(self: &mut Self, input: &[u8], requestedDeadline: Option<Instant>) -> usize
  ! ClientError | OutOfMemoryError
  ? &mut MonotonicClock | &mut Allocator | &mut Random
  where
    &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random {
    let deadline = clampDeadline(&requestedDeadline, &self.overallDeadline)
    run checkDeadline(&deadline, false)
    let result = run Effect.result(HttpTransport.writeSome(input, move deadline))
      |> Effect.provideMut<HttpTransport>(&mut self.connection.transport)
    return match move result {
      Result.Success {value} => value
      Result.Failure {error} => {
        return run transportFailure(move error)
      }
    }
  }
}

impl<'tunnel, P> TransferredTunnel<'tunnel, P> {
  fn publish(self: &mut Self) -> () {
    self.connection.closeAuthority = CloseAuthority.Transferred
  }
  unsafe effect fn read(self: &mut Self, output: &mut [u8], requestedDeadline: Option<Instant>) -> ReadTransfer
  ! ByteIoError
  ? &mut MonotonicClock
  where &mut P provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock {
    if self.connection.closeAuthority != CloseAuthority.Transferred {
      fail ByteDuplex.closed(ByteIoOperation.Read)
    }
    let deadline = clampDeadline(&requestedDeadline, &self.overallDeadline)
    run checkByteDeadline(&deadline, ByteIoOperation.Read)
    if output.length == usize.ZERO {
      return ReadTransfer.Data {count: usize.ZERO}
    }
    if self.connection.start < self.connection.end {
      let bytes = Bytes.asSlice(&self.connection.input)
      let mut count = usize.ZERO
      while count < output.length && self.connection.start + count < self.connection.end {
        output[count] = bytes[self.connection.start + count]
        count = count + usize.ONE
      }
      drop bytes
      self.connection.start = self.connection.start + count
      return ReadTransfer.Data {count: count}
    }
    return run unsafe ByteDuplex.readSomeRaw(move output, move deadline)
      |> Effect.provideMut<ByteDuplex>(&mut self.connection.transport)
  }
  unsafe effect fn write(self: &mut Self, input: &[u8], requestedDeadline: Option<Instant>) -> usize
  ! ByteIoError
  ? &mut MonotonicClock
  where &mut P provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock {
    if self.connection.closeAuthority != CloseAuthority.Transferred || self.writeShutdown {
      fail ByteDuplex.closed(ByteIoOperation.Write)
    }
    let deadline = clampDeadline(&requestedDeadline, &self.overallDeadline)
    run checkByteDeadline(&deadline, ByteIoOperation.Write)
    return run unsafe ByteDuplex.writeSomeRaw(move input, move deadline)
      |> Effect.provideMut<ByteDuplex>(&mut self.connection.transport)
  }
  unsafe effect fn flushOutput(self: &mut Self, requestedDeadline: Option<Instant>) -> ()
  ! ByteIoError
  ? &mut MonotonicClock
  where &mut P provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock {
    if self.connection.closeAuthority != CloseAuthority.Transferred {
      fail ByteDuplex.closed(ByteIoOperation.Flush)
    }
    let deadline = clampDeadline(&requestedDeadline, &self.overallDeadline)
    run checkByteDeadline(&deadline, ByteIoOperation.Flush)
    return run unsafe ByteDuplex.flushRaw(move deadline)
      |> Effect.provideMut<ByteDuplex>(&mut self.connection.transport)
  }
  unsafe effect fn shutdownOutput(self: &mut Self, requestedDeadline: Option<Instant>) -> ()
  ! ByteIoError
  ? &mut MonotonicClock
  where &mut P provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock {
    if self.connection.closeAuthority != CloseAuthority.Transferred {
      fail ByteDuplex.closed(ByteIoOperation.ShutdownWrite)
    }
    if self.writeShutdown {
      return ()
    }
    let deadline = clampDeadline(&requestedDeadline, &self.overallDeadline)
    run checkByteDeadline(&deadline, ByteIoOperation.ShutdownWrite)
    self.writeShutdown = true
    return run unsafe ByteDuplex.shutdownWriteRaw(move deadline)
      |> Effect.provideMut<ByteDuplex>(&mut self.connection.transport)
  }
  unsafe effect fn closeTransport(self: &mut Self) -> ()
  ! ByteIoError
  where &mut P provides &ByteDuplex from &mut ByteDuplex {
    if self.connection.closeAuthority != CloseAuthority.Transferred {
      return ()
    }
    self.connection.closeAuthority = CloseAuthority.Closed
    self.connection.phaseValue = ConnectionPhase.Closed
    return run unsafe ByteDuplex.closeRaw()
      |> Effect.provideMut<ByteDuplex>(&mut self.connection.transport)
  }
}

impl<'tunnel, P> ByteDuplex for TransferredTunnel<'tunnel, P>
where
  &mut P provides &ByteDuplex from &mut ByteDuplex,
  &mut P provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock {
  readSomeRaw: TransferredTunnel.read
  writeSomeRaw: TransferredTunnel.write
  flushRaw: TransferredTunnel.flushOutput
  shutdownWriteRaw: TransferredTunnel.shutdownOutput
  closeRaw: TransferredTunnel.closeTransport
}

effect fn checkByteDeadline(deadline: &Option<Instant>, operation: ByteIoOperation) -> ()
! ByteIoError
? &mut MonotonicClock {
  let now = run MonotonicClock.now()
  if let Option.Some {value: limit} = &deadline.* {
    if !before(&now, &limit) {
      fail ByteDuplex.timeout(move operation)
    }
  }
  return ()
}

effect fn discardByteIoError(error: ByteIoError) -> () {
  drop error
  return ()
}

effect fn transportFailure(error: TransportError | OutOfMemoryError) -> never
! ClientError | OutOfMemoryError {
  return match move error {
    TransportError cause => {
      fail ClientError.Transport {error: move cause}
    }
    OutOfMemoryError allocation => {
      fail move allocation
    }
  }
}

fn decoderComplete(decoder: &Decoder) -> bool {
  return match move Decoder.completion(decoder) {
    Option.None => false
    Option.Some {value} => {
      drop value
      return true
    }
  }
}

fn clampDeadline(first: &Option<Instant>, second: &Option<Instant>) -> Option<Instant> {
  return match & first.* {
    Option.None => copyDeadline(second)
    Option.Some {value: left} => match & second.* {
      Option.None => copyDeadline(first)
      Option.Some {value: right} => {
        if before(&left, &right) {
          return copyDeadline(first)
        }
        return copyDeadline(second)
      }
    }
  }
}

/// Selects one content pipeline from this exchange's current head before a nonempty raw read or a discard.
///
/// # Details
///
/// Planning errors borrow the head and must be handled before the exchange is used again.
/// The returned copy records the applied representation policy without exposing the affine decoder.
pub effect fn beginContent<'head, 'exchange: 'head, P>(
  exchange: &'head mut Exchange<'exchange, P>,
  mode: ContentMode,
  limits: ContentLimits,
) -> AppliedPlan
! ClientError | ContentError<'head> | OutOfMemoryError
? &mut Allocator | &mut MonotonicClock {
  if exchange.phaseValue != ExchangePhase.Response || exchange.bodySelected {
    fail ClientError.InvalidState
  }
  exchange.phaseValue = ExchangePhase.Aborted
  exchange.bodySelected = true
  exchange.contentSelected = true
  run checkDeadline(&exchange.options.deadline, false)
  exchange.decoder = Option.none<Decoder>()
  let head = match move ResponseParser.head(&exchange.connection.responseParser) {
    Result.Failure {error} => {
      fail ClientError.Head {error: move error}
    }
    Result.Success {value} => value
  }
  let requestHead = match move RequestParser.head(&exchange.connection.requestParser) {
    Result.Failure {error} => {
      fail ClientError.Head {error: move error}
    }
    Result.Success {value} => value
  }
  let method = requestHead.method()
  let context = match move ResponseContext.make(head, method, TrailerPolicy.defaultPolicy()) {
    Result.Failure {error} => {
      fail ClientError.Body {error: move error}
    }
    Result.Success {value} => move value
  }
  let ownedLimit = limits.maxOwned
  let plan = match move CodingPlan.make(
    move context,
    mode,
    exchange.connection.limits.responseBody,
    move limits,
  ) {
    Result.Failure {error} => {
      fail move error
    }
    Result.Success {value} => move value
  }
  let reserved = match move usize.checkedAdd(
    plan.ownedBytes(),
    Layout.of<Box<ContentDecoder>>().bytes,
  ) {
    Option.None => {
      fail ContentError<'head> {
        reason: ContentReason<'head>.ArithmeticOverflow,
        written: usize.ZERO,
        totalEncoded: u64.MIN,
        totalIntermediate: u64.MIN,
        totalDecoded: u64.MIN,
      }
    }
    Option.Some {value} => value
  }
  if reserved > ownedLimit {
    fail ContentError<'head> {
      reason: ContentReason<'head>.InvalidLimit {
        limit: ContentLimitKind.OwnedBytes,
        allowed: usize.toU64(ownedLimit),
        attempted: usize.toU64(reserved),
      },
      written: usize.ZERO,
      totalEncoded: u64.MIN,
      totalIntermediate: u64.MIN,
      totalDecoded: u64.MIN,
    }
  }
  let applied = plan.applied()
  let decoder = run ContentDecoder.make(move plan)
  let boxed = run Box.make<ContentDecoder>(move decoder)
  run checkDeadline(&exchange.options.deadline, false)
  drop method
  drop requestHead
  drop head
  exchange.decoder = Option.none<Decoder>()
  exchange.contentDecoder = Option.some<Box<ContentDecoder>>(move boxed)
  exchange.phaseValue = ExchangePhase.Response
  return applied
}

/// Reads content-decoded bytes through the same rich transport and absolute deadline as the exchange.
/// Returned bytes remain provisional until successful content and framing completion.
pub effect fn readContentSome<'exchange, P>(
  exchange: &mut Exchange<'exchange, P>,
  output: &mut [u8],
) -> ContentProgress
! ClientError | OutOfMemoryError
? &mut MonotonicClock | &mut Allocator | &mut Random
where
  &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random {
  if exchange.phaseValue != ExchangePhase.Response || !exchange.contentSelected {
    fail ClientError.InvalidState
  }
  if output.length == usize.ZERO {
    let progress = match & exchange.contentDecoder {
      Option.None => {
        fail ClientError.InvalidState
      }
      Option.Some {value} => {
        let decoders = Box.get<ContentDecoder>(&value)
        return ContentDecoder.progress(&decoders[0])
      }
    }
    return move progress
  }
  exchange.phaseValue = ExchangePhase.Aborted
  while true {
    run checkDeadline(&exchange.options.deadline, false)
    let input = Bytes.asSlice(&exchange.connection.input)
    let bytes = Slice.view<u8>(
      input,
      exchange.connection.start,
      exchange.connection.end - exchange.connection.start,
    )
    let stepped = match &mut exchange.contentDecoder {
      Option.None => {
        fail ClientError.InvalidState
      }
      Option.Some {value} => stepContentBox(&mut value, bytes, &mut output, exchange.connection.eof)
    }
    drop bytes
    drop input
    let progress = match move stepped {
      Result.Failure {error} => {
        exchange.connection.start = exchange.connection.start + error.consumed
        exchange.responseWireTotal = exchange.responseWireTotal + usize.toU64(error.consumed)
        fail ClientError.Content {error: move error.error}
      }
      Result.Success {value} => value
    }
    exchange.connection.start = exchange.connection.start + progress.consumed
    exchange.responseWireTotal = exchange.responseWireTotal + usize.toU64(progress.consumed)
    if progress.progress.written > usize.ZERO || progress.progress.state == ContentProgressState.End || output.length == usize.ZERO {
      exchange.phaseValue = ExchangePhase.Response
      return move progress.progress
    }
    if progress.needsInput {
      run fill(&mut exchange.connection.*, &exchange.options.deadline)
    }
  }
  return unavailable<ContentProgress>()
}

fn contentComplete(decoder: &Option<Box<ContentDecoder>>) -> Result<bool, ClientError> {
  let completed = match & decoder.* {
    Option.None => {
      return Result.succeed<bool, ClientError>(false)
    }
    Option.Some {value} => contentBoxComplete(&value)
  }
  return match move completed {
    Result.Failure {error} => {
      return Result.failResult<bool, ClientError>(ClientError.Content {error: move error})
    }
    Result.Success {value} => Result.succeed<bool, ClientError>(value)
  }
}

fn contentBoxComplete(boxed: &Box<ContentDecoder>) -> Result<bool, ContentError<'static>> {
  let decoders = Box.get<ContentDecoder>(boxed)
  let completed = ContentDecoder.completion(&decoders[0])
  return match move completed {
    Result.Failure {error} => Result.failResult<bool, ContentError<'static>>(move error)
    Result.Success {value: evidence} => match move evidence {
      Option.None => Result.succeed<bool, ContentError<'static>>(false)
      Option.Some {value} => {
        drop value
        return Result.succeed<bool, ContentError<'static>>(true)
      }
    }
  }
}

fn abandonContentBox(boxed: &mut Box<ContentDecoder>) -> () {
  let mut decoders = Box.getMut<ContentDecoder>(move boxed)
  ContentDecoder.abandon(&mut decoders[0])
  return ()
}

fn stepContentBox(boxed: &mut Box<ContentDecoder>, input: &[u8], output: &mut [u8], ended: bool) -> Result<
  ContentDecodeProgress,
  ContentDecodeFailure,
> {
  let mut decoders = Box.getMut<ContentDecoder>(move boxed)
  return ContentDecoder.step(&mut decoders[0], input, move output, ended)
}

fn contentBoxTrailers<'view>(boxed: &'view Box<ContentDecoder>) -> Result<
  Option<Trailers<'view>>,
  ContentError<'static>,
> {
  let decoders = Box.get<ContentDecoder>(boxed)
  return ContentDecoder.trailers(&decoders[0])
}
