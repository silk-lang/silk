//! Independently owned, caller-funded lazy computations with explicit external parking.
//!
//! # When to use
//! Use [`make`] when a lazy Effect must outlive the caller which constructs it and be resumed by a
//! later owner. Use [`park`] inside the body when readiness comes from an external registration.
//! Use [`drive`] for the initial activation and each later eligible activation.
//!
//! # Details
//! Construction obtains one combined package from the selected `Allocator`
//! and does not start the Effect. The body representation, continuation, and fixed readiness
//! endpoint remain private. A nested `Effect.suspend` transfers execution
//! immediately. In contrast, [`park`] relinquishes the Execution until one [`Wake`] makes it
//! eligible. The readiness phase and the park generation are ordinary source policy kept in two
//! package control words; the compiler only stores them.
//!
//! # Gotchas
//! `Execution` is affine. The readiness callback must be detached and non-parking. [`make`] can
//! report package allocation refusal. Later private execution-stack growth is a fatal trap.
//! Dropping a dormant Execution cancels it. A retained Wake keeps the complete inert package alive
//! until the Wake is consumed or dropped. [`drive`] returns continued ownership only to
//! `onSuspend`.

import silk.allocator { Allocator, OutOfMemoryError }

// Control word 0 holds the readiness phase. Control word 1 holds the park generation.
const PHASE: usize = 0
const GENERATION: usize = 1

const INITIAL: usize = 0
const INITIAL_READY: usize = 1
const RUNNING: usize = 2
const REGISTERING: usize = 3
const LATCHED: usize = 4
const DORMANT: usize = 5
const ELIGIBLE: usize = 6
const NOTIFYING: usize = 7

/// The affine readiness authority for one parked generation of one Execution.
///
/// # Details
///
/// [`Execution.park`] passes the generation's only Wake to its registration callback.
/// [`Execution.wake`] consumes it and makes that generation eligible at most once.
///
/// # Gotchas
///
/// Dropping a Wake publishes nothing. A retained Wake keeps the inert package allocation alive
/// after the Execution is dropped, until the Wake is consumed or dropped.
pub struct Wake {
  reference: Intrinsic.ExecutionRef
  generation: usize
}

/// The owner of the execution lifecycle operations.
///
/// # Details
///
/// This struct carries no data and is never constructed by the library. Every operation is an
/// inherent member declared in `impl Execution`, so `import silk.execution { Execution }` is the
/// one import that reaches `Execution.make(...)` and the rest. It is unrelated to the builtin
/// `Intrinsic.Execution<A>` type.
pub struct Execution {}

impl Execution {
  /// Allocates one combined package and transfers the lazy body and fixed endpoint into it.
  ///
  /// # Details
  ///
  /// The returned Execution is `Initial`. The body does not start during this call. Allocation refusal
  /// produces no Execution and leaves every input under ordinary Effect cleanup. Later private stack
  /// growth is a fatal trap and is not a `OutOfMemoryError`.
  pub effect<'static> fn make<
    A,
    F: once Effect<'static; A> + Intrinsic.Detached,
    O: Intrinsic.Detached,
    R: fn<'static>(&O) -> () + Intrinsic.Detached + Intrinsic.NonParking
  >(body: F, readyState: O, onReady: R) -> Intrinsic.Execution<A>
  ! OutOfMemoryError
  ? &mut Allocator {
    let layout = Intrinsic.executionLayout<A, F, O, R>()
    let allocation = run Allocator.allocate(move layout)
    unsafe {
      return Intrinsic.executionFromAllocation<A, F, O, R>(
        move allocation,
        move body,
        move readyState,
        move onReady
      )
    }
    return absurd<Intrinsic.Execution<A>>()
  }

  /// Drives one `Initial`, `InitialReady`, or `Eligible` activation and transfers `branchState` to one outcome callback.
  ///
  /// # Details
  ///
  /// Completion calls `onComplete`. Relinquishment calls `onSuspend` with the dormant Execution.
  /// Each activation calls exactly one callback. Nested transfer can complete in the same drive.
  /// External parking relinquishes ownership until the fixed readiness endpoint reports eligibility.
  /// The body starts an independent diagnostic invocation. Install observation inside the body to
  /// retain it across parking. Outcome callbacks run in the driving caller's diagnostic context.
  ///
  /// # Gotchas
  ///
  /// Driving a dormant, notifying, completed, or destroyed Execution is a fatal state trap.
  pub effect<'env> fn drive<
    'env,
    A: 'env,
    D: 'env,
    C: once fn<'env>(D, A) -> () + Intrinsic.NonParking,
    S: once fn<'env>(D, Intrinsic.Execution<A>) -> () + Intrinsic.NonParking
  >(
    execution: Intrinsic.Execution<A>,
    branchState: D,
    onComplete: C,
    onSuspend: S
  ) -> () {
    let reference = Intrinsic.executionRefOf<A>(&execution)
    let phase = Intrinsic.executionLoad(&reference, PHASE)
    if phase != INITIAL && phase != INITIAL_READY && phase != ELIGIBLE { invalidState() }
    Intrinsic.executionStore(&reference, PHASE, RUNNING)
    run Intrinsic.executionDrive<A, D, C, S>(
      move execution,
      move branchState,
      move onComplete,
      move onSuspend
    )
    // A signal latched during registration notifies once the owner holds the Execution again.
    if Intrinsic.executionLive(&reference) && Intrinsic.executionLoad(&reference, PHASE) == LATCHED {
      notifyReady(&reference)
    }
    return ()
  }

  /// Notifies the fixed readiness endpoint for one `Initial` Execution exactly once.
  ///
  /// # Details
  ///
  /// This operation changes the package to `InitialReady` before it invokes the endpoint. It is
  /// synchronous, does not park, and does not run the body. A later [`drive`] starts the body.
  ///
  /// # Gotchas
  ///
  /// The Execution must still be `Initial`. Calling this operation again, or calling it after the
  /// Execution has been driven, parked, completed, or destroyed, is a fatal state trap.
  pub fn notifyInitial<A>(execution: &mut Intrinsic.Execution<A>) -> () {
    let reference = Intrinsic.executionRefOf<A>(&execution.*)
    if Intrinsic.executionLoad(&reference, PHASE) != INITIAL { invalidState() }
    Intrinsic.executionStore(&reference, PHASE, INITIAL_READY)
    Intrinsic.executionNotify(&reference)
    return ()
  }

  /// Relinquishes the currently Running Execution until one external readiness signal arrives.
  ///
  /// # Details
  ///
  /// The registration callback receives the generation's sole affine [`Wake`]. Its returned guard
  /// is retained while dormant and dropped immediately before source continues after this call.
  /// A Wake signaled during registration is latched until [`drive`] returns this Execution to its
  /// owner, which then notifies. The Wake invokes the fixed readiness endpoint at most one time.
  ///
  /// # Gotchas
  ///
  /// A caller that keeps a cancelled Wake also keeps the complete inert Execution package alive.
  /// Consuming or dropping that Wake releases the final package authority.
  pub effect fn park<
    'env,
    G,
    F: once fn<'env>(Wake) -> G + Intrinsic.NonParking
  >(register: F) -> () {
    let reference = run Intrinsic.executionCurrent()
    let generation = Intrinsic.executionLoad(&reference, GENERATION) + 1
    Intrinsic.executionStore(&reference, GENERATION, generation)
    Intrinsic.executionStore(&reference, PHASE, REGISTERING)
    let wakeReference = run Intrinsic.executionCurrent()
    let guard = register(Wake { reference: move wakeReference, generation: generation })
    // A latched signal stays latched until drive returns the Execution to its owner.
    if Intrinsic.executionLoad(&reference, PHASE) != LATCHED {
      Intrinsic.executionStore(&reference, PHASE, DORMANT)
    }
    drop reference
    run Intrinsic.relinquish()
    drop guard
    return ()
  }

  /// Consumes one Wake and makes its parked generation eligible.
  ///
  /// # Details
  ///
  /// A Wake signaled while its generation is still registering is latched until the owner receives
  /// the Execution back from [`drive`]. A Wake signaled while its generation is dormant makes the
  /// Execution eligible and synchronously invokes its fixed readiness endpoint. Signaling never
  /// drives the Execution.
  ///
  /// # Gotchas
  ///
  /// A Wake for a dropped or completed Execution, or for an earlier generation, publishes nothing
  /// and only releases its package authority.
  pub fn wake(wake: Wake) -> () {
    let Wake { reference, generation } = move wake
    if !Intrinsic.executionLive(&reference) { return () }
    if Intrinsic.executionLoad(&reference, GENERATION) != generation { return () }
    let phase = Intrinsic.executionLoad(&reference, PHASE)
    if phase == REGISTERING {
      Intrinsic.executionStore(&reference, PHASE, LATCHED)
    } else if phase == DORMANT {
      notifyReady(&reference)
    }
    return ()
  }
}

// Driving a Notifying Execution traps, so the endpoint cannot reenter its own activation.
fn notifyReady(reference: &Intrinsic.ExecutionRef) -> () {
  Intrinsic.executionStore(reference, PHASE, NOTIFYING)
  Intrinsic.executionNotify(reference)
  if Intrinsic.executionLive(reference) { Intrinsic.executionStore(reference, PHASE, ELIGIBLE) }
  return ()
}

fn invalidState() -> () {
  let invalid = 1 / 0
  return ()
}

fn absurd<T>() -> T {
  let boom = 1 / 0
  return absurd<T>()
}
