//! Native ownership context for one-shot HTTP fetch operations.
//!
//! # Details
//!
//! The context retains one immutable proxy policy through [`NativeRedirectClient`]. Fresh
//! attempts therefore recompute the sealed route for every current URI before contact. An
//! optional native pool handle is copied explicitly, sharing only its preallocated slot state and
//! bounded immutable direct-route context.
//!
//! # Gotchas
//!
//! The delivered native pool accepts direct TCP and Unix keys only. A fetch adapter must reject a
//! configured pool when proxy recomputation selects forwarding or tunneling; it must not silently
//! bypass the selected proxy or publish proxy credentials to a direct pool.

import silk.allocator {Allocator, OutOfMemoryError}
import silk.byte_duplex {ByteDuplex}
import silk.effect {Effect}
import silk.http_client as Client {
  ClientError,
  Connection,
  ConnectionHandler,
  ContinuePolicy,
  Exchange,
  Limits,
  RequestOptions,
  RouteTransport,
}
import silk.http_client_native as Native {
  NativeClientError,
  NativeRedirectClient,
  NativeRouteProvider,
  NativeTransport,
  Options,
}
import silk.http_connection_pool {CheckoutResult, ConnectionKey, Handle, PoolError}
import silk.http_connection_pool_native as NativePool
import silk.http_fetch {FetchClient, PoolMode, ProxyMode}
import silk.http_proxy {ProxyError, Route, RouteMode}
import silk.http_redirect as Redirect {
  Attempt,
  AttemptClient,
  AttemptRequest,
  HybridAttempt,
}
import silk.http_request as Request {PreparedRequest, RequestError}
import silk.http_transport {HttpTransport}
import silk.http_origin {Origin, OriginError}
import silk.http {Method, ValueError}
import silk.https_identity {IdentityError}
import silk.monotonic_clock {MonotonicClock}
import silk.option {Option}
import silk.random {Random}
import silk.resolver {ResolverError}
import silk.result {Result}
import silk.string {String}
import silk.system_clock {Instant, SystemClock}
import silk.tls_connection {ConnectionError}
import silk.trust_source {TrustSource}
import silk.trust_snapshot {TrustSourceError}

/// An immutable native route/acquisition context and optional compatible direct-pool capability.
///
/// # Details
///
/// [`make`] consumes all fresh-acquisition settings without allocation. [`makeWithPool`] first
/// constructs that exact fresh context, then fallibly copies the supplied pool handle. A failed
/// copy publishes no partially initialized context and leaves the source handle valid.
pub struct Context<'configuration> {
  routeValue: Route<'configuration>
  optionsValue: Options
  limitsValue: Limits
  poolValue: Option<
    Handle<ConnectionKey, NativeTransport, NativePool.Context>,
  >
}

impl<'configuration> Context<'configuration> {
  /// Owns one native fresh-acquisition context without a connection pool.
  pub fn make(
    route: Route<'configuration>,
    options: Options,
    limits: Limits,
  ) -> Context<'configuration> {
    return Context<'configuration> {
      routeValue: route,
      optionsValue: move options,
      limitsValue: limits,
      poolValue: Option.none<
        Handle<ConnectionKey, NativeTransport, NativePool.Context>,
      >(),
    }
  }

  /// Owns one native fresh-acquisition context and a copied direct-pool capability.
  ///
  /// # Details
  ///
  /// The copied handle retains the pool's already bounded immutable transport, HTTP, TLS, ALPN,
  /// and trust context. Route compatibility remains a per-attempt pre-contact admission check.
  pub effect fn makeWithPool(
    route: Route<'configuration>,
    options: Options,
    limits: Limits,
    pool: &Handle<ConnectionKey, NativeTransport, NativePool.Context>,
  ) -> Context<'configuration>
  ! PoolError | TrustSourceError | OutOfMemoryError
  ? &mut Allocator {
    if !NativePool.acceptsLimits(pool, limits) { fail PoolError.ContextMismatch }
    let copied = run NativePool.copyHandle(pool)
    return Context<'configuration> {
      routeValue: route,
      optionsValue: move options,
      limitsValue: limits,
      poolValue: Option.some<
        Handle<ConnectionKey, NativeTransport, NativePool.Context>,
      >(move copied),
    }
  }

  /// Returns whether this context owns an explicit direct native pool capability.
  pub fn hasPool(self: &Self) -> bool {
    return match & self.poolValue {
      Option.None => false
      Option.Some {value} => true
    }
  }
}

fn copyInstant(value: &Instant) -> Instant {
  return SystemClock.make(SystemClock.seconds(value), SystemClock.nanoseconds(value))
}

fn copyDeadline(value: &Option<Instant>) -> Option<Instant> {
  return match & value.* {
    Option.None => Option.none<Instant>()
    Option.Some {value: present} => Option.some<Instant>(copyInstant(&present))
  }
}

fn attemptOptions(options: &Options, deadline: &Option<Instant>) -> Options {
  return Options {
    maximumAddresses: options.maximumAddresses,
    family: options.family,
    noDelay: options.noDelay,
    pollIntervalNanoseconds: options.pollIntervalNanoseconds,
    maximumAttempts: options.maximumAttempts,
    deadline: copyDeadline(deadline),
    handshakeNanoseconds: options.handshakeNanoseconds,
    tls: options.tls,
    trust: options.trust,
    alpn: options.alpn,
  }
}

fn copyContinuePolicy(value: &ContinuePolicy) -> ContinuePolicy {
  return match &value.* {
    ContinuePolicy.Disabled => ContinuePolicy.Disabled
    ContinuePolicy.Require100 {deadline} => ContinuePolicy.Require100 {
      deadline: copyInstant(&deadline),
    }
  }
}

fn requiresContinue(value: &ContinuePolicy) -> bool {
  return match &value.* {
    ContinuePolicy.Disabled => false
    ContinuePolicy.Require100 {deadline} => true
  }
}

struct RoutedAttemptUse<'policy, A, HandlerError, ?HandlerRequirements> {}

impl<'policy, A, HandlerError, ?HandlerRequirements> RoutedAttemptUse<'policy, A, HandlerError, HandlerRequirements> {
  effect<'call> fn handle<
    'call,
    'exchangeView: 'call,
    'transport: 'exchangeView,
    'provider: 'transport,
    'tunnel: 'provider,
  >(
    use: &mut Self,
    request: &'call AttemptRequest<'policy>,
    method: Method<'call>,
    exchange: &'call mut Exchange<
      'exchangeView,
      RouteTransport<'transport, 'provider, 'tunnel, NativeRouteProvider>
    >,
  ) -> A
  ! HandlerError
  ? HandlerRequirements | &mut HybridAttempt<
    'policy,
    NativeRouteProvider,
    NativeTransport,
    A,
    HandlerError ? HandlerRequirements
  > {
    drop use
    return run HybridAttempt.handleRouted<
      'policy, NativeRouteProvider, NativeTransport, A, HandlerError, HandlerRequirements,
    >(request, method, move exchange)
  }
}

impl<
  'policy,
  A,
  HandlerError,
  ?HandlerRequirements,
> Attempt<
  'policy,
  NativeRouteProvider,
  A,
  HandlerError ? HandlerRequirements | &mut HybridAttempt<
    'policy,
    NativeRouteProvider,
    NativeTransport,
    A,
    HandlerError ? HandlerRequirements
  >
> for RoutedAttemptUse<'policy, A, HandlerError, HandlerRequirements> {
  handle: RoutedAttemptUse.handle
}

struct DirectAttemptUse<'policy, A, HandlerError, ?HandlerRequirements, 'request> {
  request: &'request AttemptRequest<'policy>
  method: Method<'request>
  prepared: PreparedRequest
  options: RequestOptions
}

impl<'policy, A, HandlerError, ?HandlerRequirements, 'request> DirectAttemptUse<'policy, A, HandlerError, HandlerRequirements, 'request> {
  effect<'call> fn handle<'call>(
    use: Self,
    connection: &'call mut Connection<NativeTransport>,
  ) -> A
  ! HandlerError | ClientError | OutOfMemoryError
  ? HandlerRequirements
    | &mut HybridAttempt<
      'policy,
      NativeRouteProvider,
      NativeTransport,
      A,
      HandlerError ? HandlerRequirements
    >
    | &mut Allocator {
    let DirectAttemptUse<'policy, A, HandlerError, HandlerRequirements, 'request> {request, method, prepared, options} = move use
    let handle = effect fn(
      exchange: &mut Exchange<NativeTransport>,
    ) -> A
    ! HandlerError
    ? HandlerRequirements | &mut HybridAttempt<
      'policy,
      NativeRouteProvider,
      NativeTransport,
      A,
      HandlerError ? HandlerRequirements
    > {
      return run HybridAttempt.handleDirect<
        'policy, NativeRouteProvider, NativeTransport, A, HandlerError, HandlerRequirements,
      >(request, method, move exchange)
    }
    return run Client.withExchange(move connection, &prepared, move options, move handle)
  }
}

impl<
  'request,
  'policy,
  A,
  HandlerError,
  ?HandlerRequirements,
> ConnectionHandler<
  NativeTransport,
  A,
  HandlerError | ClientError | OutOfMemoryError
  ? HandlerRequirements
    | &mut HybridAttempt<
      'policy,
      NativeRouteProvider,
      NativeTransport,
      A,
      HandlerError ? HandlerRequirements
    >
    | &mut Allocator
> for DirectAttemptUse<'policy, A, HandlerError, HandlerRequirements, 'request> {
  handle: DirectAttemptUse.handle
}

static if (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText(
  "libc",
) == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText(
  "libc",
) == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
  import silk.native_socket {NativeSocketError}

  effect fn withFreshRouted<
    'configuration,
    'policy,
    A,
    HandlerError,
    ?HandlerRequirements,
  >(
    route: Route<'configuration>,
    options: Options,
    limits: Limits,
    request: AttemptRequest<'policy>,
    deadline: Option<Instant>,
  ) -> A
  ! HandlerError
    | ProxyError
    | RequestError
    | ValueError
    | OriginError
    | ClientError
    | NativeClientError
    | ResolverError
    | NativeSocketError
    | ConnectionError
    | IdentityError
    | TrustSourceError
    | OutOfMemoryError
  ? HandlerRequirements
    | &mut HybridAttempt<
      'policy,
      NativeRouteProvider,
      NativeTransport,
      A,
      HandlerError ? HandlerRequirements
    >
    | &mut Allocator
    | &mut MonotonicClock
    | &mut SystemClock
    | &mut Random
    | &mut TrustSource
  where HandlerRequirements in Without<HandlerRequirements, ByteDuplex>,
    HandlerRequirements in Without<HandlerRequirements, HttpTransport> {
    let mut fresh = NativeRedirectClient<'configuration, 'policy, A, HandlerError,
      HandlerRequirements | &mut HybridAttempt<'policy, NativeRouteProvider, NativeTransport, A, HandlerError ? HandlerRequirements>
    >.make(route, move options, limits)
    let mut attempt = RoutedAttemptUse<'policy, A, HandlerError, HandlerRequirements> {}
    return run AttemptClient<
      'policy,
      NativeRouteProvider,
      A,
      HandlerError,
      ProxyError
        | RequestError
        | ValueError
        | OriginError
        | ClientError
        | NativeClientError
        | ResolverError
        | NativeSocketError
        | ConnectionError
        | IdentityError
        | TrustSourceError
        | OutOfMemoryError,
      &mut Allocator
        | &mut MonotonicClock
        | &mut SystemClock
        | &mut Random
        | &mut TrustSource
      ? HandlerRequirements | &mut HybridAttempt<
        'policy,
        NativeRouteProvider,
        NativeTransport,
        A,
        HandlerError ? HandlerRequirements
      >
    >.withAttempt(&mut fresh, move request, move deadline)
      |> Effect.provideMut<Attempt<
        'policy,
        NativeRouteProvider,
        A,
        HandlerError ? HandlerRequirements | &mut HybridAttempt<
          'policy,
          NativeRouteProvider,
          NativeTransport,
          A,
          HandlerError ? HandlerRequirements
        >
      >>(&mut attempt)
  }

  effect fn withDirect<
    'configuration,
    'policy,
    A,
    HandlerError,
    ?HandlerRequirements,
  >(
    client: &Context<'configuration>,
    pool: Option<&Handle<ConnectionKey, NativeTransport, NativePool.Context>>,
    origin: Origin,
    request: AttemptRequest<'policy>,
    limits: Limits,
    deadline: Option<Instant>,
  ) -> A
  ! HandlerError
    | RequestError
    | ValueError
    | ClientError
    | NativeClientError
    | ResolverError
    | NativeSocketError
    | ConnectionError
    | IdentityError
    | TrustSourceError
    | OutOfMemoryError
    | PoolError
  ? HandlerRequirements
    | &mut HybridAttempt<
      'policy,
      NativeRouteProvider,
      NativeTransport,
      A,
      HandlerError ? HandlerRequirements
    >
    | &mut Allocator
    | &mut MonotonicClock
    | &mut SystemClock
    | &mut Random
    | &mut TrustSource
  where HandlerRequirements in Without<HandlerRequirements, ByteDuplex>,
    HandlerRequirements in Without<HandlerRequirements, HttpTransport> {
    let uri = request.uri.view()
    let method = match move Method.parse(
      String.view(&request.method),
      request.requestLimits.maxMethodBytes,
    ) {
      Result.Failure {error} => { fail move error }
      Result.Success {value} => value
    }
    let prepared = run Request.fromUri(
      &uri,
      request.version,
      method,
      &request.headers.view(),
      &request.headerPolicy,
      request.bodyMode,
      requiresContinue(&request.continuePolicy),
      request.requestLimits,
      request.maxHeadBytes,
      request.maxCredentialBytes,
    )
    let use = DirectAttemptUse<'policy, A, HandlerError, HandlerRequirements> {
      request: &request,
      method: method,
      prepared: move prepared,
      options: RequestOptions {
        deadline: copyDeadline(&deadline),
        continuePolicy: copyContinuePolicy(&request.continuePolicy),
      },
    }
    return match move pool {
      Option.None => run Native.withConnection(
        origin,
        attemptOptions(&client.optionsValue, &deadline),
        limits,
        move use,
      )
      Option.Some {value} => {
        let checked = run NativePool.withConnection(
          value,
          origin,
          copyDeadline(&deadline),
          copyDeadline(&deadline),
          move use,
        )
        let CheckoutResult<A> {value: result, source} = move checked
        drop source
        return move result
      }
    }
  }

  impl<
    'configuration,
    'policy,
    A,
    HandlerError,
    ?HandlerRequirements,
  > FetchClient<
    'policy,
    NativeRouteProvider,
    NativeTransport,
    A,
    HandlerError,
    ProxyError
      | RequestError
      | ValueError
      | OriginError
      | ClientError
      | NativeClientError
      | ResolverError
      | NativeSocketError
      | ConnectionError
      | IdentityError
      | TrustSourceError
      | OutOfMemoryError
      | PoolError,
    HandlerRequirements,
    &mut Allocator
      | &mut MonotonicClock
      | &mut SystemClock
      | &mut Random
      | &mut TrustSource,
  > for Context<'configuration> {
    effect fn withAttempt(
      client: &mut Self,
      request: AttemptRequest<'policy>,
      httpLimits: Limits,
      poolMode: PoolMode,
      proxyMode: ProxyMode,
      deadline: Option<Instant>,
    ) -> A
    ! HandlerError
      | ProxyError
      | RequestError
      | ValueError
      | OriginError
      | ClientError
      | NativeClientError
      | ResolverError
      | NativeSocketError
      | ConnectionError
      | IdentityError
      | TrustSourceError
      | OutOfMemoryError
      | PoolError
    ? HandlerRequirements
      | &mut HybridAttempt<
        'policy,
        NativeRouteProvider,
        NativeTransport,
        A,
        HandlerError ? HandlerRequirements
      >
      | &mut Allocator
      | &mut MonotonicClock
      | &mut SystemClock
      | &mut Random
      | &mut TrustSource
    where HandlerRequirements in Without<HandlerRequirements, ByteDuplex>,
      HandlerRequirements in Without<HandlerRequirements, HttpTransport> {
      if !NativePool.limitsEqual(&client.limitsValue, &httpLimits) {
        fail PoolError.ContextMismatch
      }
      let uri = request.uri.view()
      let origin = match move Origin.fromUri(&uri) {
        Result.Failure {error} => { fail move error }
        Result.Success {value} => value
      }
      if proxyMode == ProxyMode.Direct {
        return match poolMode {
          PoolMode.Fresh => run withDirect<'configuration, 'policy, A, HandlerError, HandlerRequirements>(
            &client.*,
            Option.none<&Handle<ConnectionKey, NativeTransport, NativePool.Context>>(),
            origin,
            move request,
            httpLimits,
            move deadline,
          )
          PoolMode.UseContextPool => match & client.poolValue {
            Option.None => run withDirect<'configuration, 'policy, A, HandlerError, HandlerRequirements>(
              &client.*,
              Option.none<&Handle<ConnectionKey, NativeTransport, NativePool.Context>>(),
              origin,
              move request,
              httpLimits,
              move deadline,
            )
            Option.Some {value} => run withDirect<'configuration, 'policy, A, HandlerError, HandlerRequirements>(
              &client.*,
              Option.some<&Handle<ConnectionKey, NativeTransport, NativePool.Context>>(&value),
              origin,
              move request,
              httpLimits,
              move deadline,
            )
          }
        }
      }
      let route = Route.recompute(&client.routeValue, origin)
      return match poolMode {
        PoolMode.Fresh => run withFreshRouted<'configuration, 'policy, A, HandlerError, HandlerRequirements>(
          route,
          attemptOptions(&client.optionsValue, &deadline),
          httpLimits,
          move request,
          move deadline,
        )
        PoolMode.UseContextPool => match & client.poolValue {
          Option.None => run withFreshRouted<'configuration, 'policy, A, HandlerError, HandlerRequirements>(
            route,
            attemptOptions(&client.optionsValue, &deadline),
            httpLimits,
            move request,
            move deadline,
          )
          Option.Some {value} => {
            if Route.mode(&route) != RouteMode.Direct { fail PoolError.ContextMismatch }
            return run withDirect<'configuration, 'policy, A, HandlerError, HandlerRequirements>(
              &client.*,
              Option.some<&Handle<ConnectionKey, NativeTransport, NativePool.Context>>(&value),
              Route.originalOrigin(&route),
              move request,
              httpLimits,
              move deadline,
            )
          }
        }
      }
    }
  }
} else {
  impl<
    'configuration,
    'policy,
    A,
    HandlerError,
    ?HandlerRequirements,
  > FetchClient<
    'policy,
    NativeRouteProvider,
    NativeTransport,
    A,
    HandlerError,
    NativeClientError,
    HandlerRequirements,
    never,
  > for Context<'configuration> {
    effect fn withAttempt(
      client: &mut Self,
      request: AttemptRequest<'policy>,
      httpLimits: Limits,
      poolMode: PoolMode,
      proxyMode: ProxyMode,
      deadline: Option<Instant>,
    ) -> A
    ! HandlerError | NativeClientError
    ? HandlerRequirements | &mut HybridAttempt<
      'policy,
      NativeRouteProvider,
      NativeTransport,
      A,
      HandlerError ? HandlerRequirements
    >
    where HandlerRequirements in Without<HandlerRequirements, ByteDuplex>,
      HandlerRequirements in Without<HandlerRequirements, HttpTransport> {
      compileError("Native HTTP fetch requires a supported Darwin or GNU libc profile")
    }
  }
}
