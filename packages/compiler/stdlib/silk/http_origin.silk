//! Owned checked HTTP origins, separate from request paths and explicit Host fields.
//!
//! # Details
//!
//! An origin retains the checked host, effective port, and transport scheme without allocation.
//! Authority output uses lowercase domain bytes, canonical numeric addresses, and nondefault ports.
//! An explicit Host field never changes the origin used for TLS authentication.

import silk.network_address {Host, DomainHost, Ipv4Address, Ipv6Address, Port, AddressError}
import silk.option {Option}
import silk.ownership {Copy}
import silk.result {Result}
import silk.slice {Slice}
import silk.string {String}
import silk.uri {Uri}
import silk.u8
import silk.u16
import silk.usize

/// A rejected HTTP origin or insufficient authority output buffer.
pub enum OriginError {
  /// The URI scheme is neither HTTP nor HTTPS.
  InvalidScheme,
  /// User information is forbidden in an HTTP origin.
  UserInfo,
  /// The URI has no host.
  MissingHost,
  /// The host fails the checked network identity rules.
  InvalidHost,
  /// The port is empty, nondecimal, or outside 1 through 65535.
  InvalidPort,
  /// Output cannot hold the complete authority.
  OutputTooSmall,
}

/// An owned HTTP authority and secure-transport selection.
pub struct Origin {
  hostValue: Host
  portValue: Port
  secureValue: bool
}

impl Copy for Origin {}

impl Origin {
  /// Checks a host, a nonzero port, and an explicit transport-security selection.
  pub fn make(host: Host, port: Port, secure: bool) -> Result<Origin, OriginError> {
    if Port.value(&port) == 0 {
      return Result<Origin, OriginError>.failResult(OriginError.InvalidPort)
    }
    return Result<Origin, OriginError>.succeed(Origin {
      hostValue: host,
      portValue: port,
      secureValue: secure,
    })
  }

  /// Checks an HTTP or HTTPS URI and copies its host and effective port without allocation.
  ///
  /// # Details
  ///
  /// User information is rejected. Absent ports become 80 for HTTP and 443 for HTTPS.
  /// The path, query, and fragment do not contribute to this origin.
  pub fn fromUri(uri: &Uri) -> Result<Origin, OriginError> {
    let scheme = String.utf8Bytes(Uri.scheme(uri))
    let secure = foldedEqual(scheme, b"https")
    if !secure && !foldedEqual(scheme, b"http") {
      return Result<Origin, OriginError>.failResult(OriginError.InvalidScheme)
    }
    let checked1 = Uri.userinfo(uri)
    match move checked1 {
      Option<string>.Some {value} => {
        return Result<Origin, OriginError>.failResult(OriginError.UserInfo)
      }
      Option<string>.None => {}
    }
    let checked2 = Uri.host(uri)
    let text = match move checked2 {
      Option<string>.Some {value} => value
      Option<string>.None => {
        return Result<Origin, OriginError>.failResult(OriginError.MissingHost)
      }
    }
    let checked3 = Host.parse(String.utf8Bytes(text))
    let host = match move checked3 {
      Result<Host, AddressError>.Success {value} => value
      Result<Host, AddressError>.Failure {error} => {
        return Result<Origin, OriginError>.failResult(OriginError.InvalidHost)
      }
    }
    let mut defaultPort: usize = 80
    if secure {
      defaultPort = 443
    }
    let mut selectedPort = defaultPort
    let portOption = Uri.port(uri)
    match move portOption {
      Option<string>.Some {value: portText} => {
        let parsedPort = parsePort(String.utf8Bytes(portText))
        match move parsedPort {
          Result<Port, OriginError>.Success {value: admittedPort} => {
            selectedPort = u16.toUsize(Port.value(&admittedPort))
          }
          Result<Port, OriginError>.Failure {error} => {
            return Result<Origin, OriginError>.failResult(move error)
          }
        }
      }
      Option<string>.None => {}
    }
    let madePort = Port.make(selectedPort)
    let port = match move madePort {
      Result<Port, AddressError>.Success {value} => value
      Result<Port, AddressError>.Failure {error} => {
        return Result<Origin, OriginError>.failResult(OriginError.InvalidPort)
      }
    }
    return Result<Origin, OriginError>.succeed(
      Origin {hostValue: host, portValue: port, secureValue: secure},
    )
  }
  /// Returns the owned checked identity used for resolution and TLS authentication.
  pub fn host(self: &Self) -> Host {
    return self.hostValue
  }
  /// Returns the effective checked port, including a scheme default.
  pub fn port(self: &Self) -> Port {
    return self.portValue
  }
  /// Returns whether this origin requires authenticated TLS.
  pub fn secure(self: &Self) -> bool {
    return self.secureValue
  }
  /// Compares transport scheme, effective port, and case-insensitive checked host identity.
  pub fn equals(self: &Self, other: &Self) -> bool {
    return self.secureValue == other.secureValue && Port.value(&self.portValue) == Port.value(
      &other.portValue,
    ) && hostsEqual(&self.hostValue, &other.hostValue)
  }
  /// Writes the normalized authority and leaves output unchanged when capacity is insufficient.
  pub fn authorityInto(self: &Self, output: &mut [u8]) -> Result<usize, OriginError> {
