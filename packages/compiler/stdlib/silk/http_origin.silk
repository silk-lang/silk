    let madeLength = formatHost(&self.hostValue, &mut scratch)
    let mut length = match move madeLength {
      Result<usize, OriginError>.Success {value} => value
      Result<usize, OriginError>.Failure {error} => {
        return Result<usize, OriginError>.failResult(move error)
      }
    }
    let port = u16.toUsize(Port.value(&self.portValue))
    let mut defaultPort: usize = 80
    if self.secureValue {
      defaultPort = 443
    }
    if port != defaultPort {
      scratch[length] = 58
      length = length + usize.ONE
      let mut divisor: usize = 10000
      while divisor > usize.ONE && port / divisor == usize.ZERO {
        divisor = divisor / 10
      }
