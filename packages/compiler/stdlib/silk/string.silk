//! Valid UTF-8 text, including owned storage, byte validation, and scalar-by-scalar traversal.
//!
//! # When to use
//! Use the built-in `string` type for borrowed text and [`String`] when text must own its storage.
//! Use [`Bytes`] when arbitrary octets must survive without UTF-8 validation.
//!
//! # Details
//! [`fromUtf8`] validates and borrows existing bytes without allocating; [`copyUtf8`] validates and
//! owns a copy. [`fromBytes`] adopts owned bytes without copying; [`intoBytes`] transfers them back.
//! [`append`] and [`appendOwned`] leave the original value unchanged if growth cannot
//! allocate. Scalar cursors expose Unicode scalar values and byte offsets, not grapheme clusters.
//!
//! # Gotchas
//! A [`ScalarCursor`] is meaningful only for the same unchanged string from which its traversal
//! began. Start with [`scalarCursor`] and advance only with [`nextCursor`].
//!
//! # Examples
//! ## Validate borrowed UTF-8 bytes
//! ```silk
//! import silk.result { Result }
//!
//! import silk.string { String, ScalarStep, InvalidUtf8 }
//!
//! import silk.usize
//!
//! pub fn main() -> i32 {
//!   let valid = String.fromUtf8(b"Silk")
//!     |> Result.unwrapOr<string, InvalidUtf8>("")
//!   let rejected = String.fromUtf8(b"a\x80")
//!     |> Result.unwrapOr<string, InvalidUtf8>("")
//!   let length = String.byteLength(valid)
//!     |> usize.toI32
//!   let rejectedLength = String.byteLength(rejected)
//!     |> usize.toI32
//!   return length + rejectedLength + 38
//! }
//! ```
//!
//! ## Build owned text and read its first scalar
//! ```silk
//! import silk.char
//!
//! import silk.allocator { Allocator, OutOfMemoryError }
//!
//! import silk.effect { Effect }
//!
//! import silk.option { Option }
//!
//! import silk.string { String, ScalarStep, InvalidUtf8 }
//!
//! import silk.u32
//!
//! fn scalarCode(step: ScalarStep) -> i32 {
//!   return String.scalarValue(&step)
//!     |> char.toU32
//!     |> u32.toI32
//! }
//!
//! effect fn build() -> i32
//! ! OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let mut copying = String.copy("é")
//!     |> Effect.provideMut<Allocator>(&mut allocator)
//!   let mut text = run copying
//!   let mut appending = String.append(&mut text, "!")
//!     |> Effect.provideMut<Allocator>(&mut allocator)
//!   let appended = run appending
//!   let stepped = String.nextScalar(String.view(&text), String.scalarCursor())
//!   let mapped = Option.map<ScalarStep, i32>(move stepped, scalarCode)
//!   let scalar = Option.unwrapOr<i32>(move mapped, 0)
//!   return scalar - 191
//! }
//!
//! effect fn recover(error: OutOfMemoryError) -> i32 {
//!   return 0
//! }
//!
//! pub fn main() -> i32 {
//!   return run Effect.catchAll(build(), recover)
//! }
//! ```

import silk.bool
import silk.bytes { Bytes }
import silk.char
import silk.allocator { Allocator, OutOfMemoryError }
import silk.option { Option }
import silk.result { Result }
import silk.u32
import silk.u8
import silk.usize

/// An owned sequence of valid UTF-8 bytes that releases its storage on drop.
pub struct String {
  bytes: Bytes
}

impl String {
  /// Borrows caller-validated UTF-8 bytes as text without runtime validation.
  ///
  /// # When to use
  ///
  /// Use this function only when an earlier operation proves that the complete byte view is UTF-8.
  /// Use [`fromUtf8`] when the bytes have not been validated.
  ///
  /// # Gotchas
  ///
  /// The caller must guarantee that the complete byte view is valid UTF-8 for the lifetime of the
  /// returned string view. Invalid bytes violate the safety contract.
  pub unsafe fn fromUtf8Unchecked(values: &[u8]) -> string {
    unsafe { return Intrinsic.stringFromUtf8Unchecked(values) }
    return ""
  }

  /// Validates a complete byte view and borrows it as text without allocating.
  ///
  /// # Details
  ///
  /// Success returns a `string` view with the same lexical lifetime as `values`. Failure returns the
  /// first invalid byte offset in [`InvalidUtf8`].
  pub fn fromUtf8(values: &[u8]) -> Result<string, InvalidUtf8> {
    let failure = match move firstInvalidUtf8(values) {
      Option<usize>.Some { value } => move value
      Option<usize>.None => values.length + usize.ONE
    }
    if failure <= values.length {
      return Result.failResult<string, InvalidUtf8>(InvalidUtf8 { offset: failure })
    }
    let text = unsafe String.fromUtf8Unchecked(values)
    return Result.succeed<string, InvalidUtf8>(text)
    return Result.failResult<string, InvalidUtf8>(InvalidUtf8 { offset: usize.ZERO })
  }

  /// Constructs an empty owned String without allocating.
  pub fn make() -> String {
    return String { bytes: Bytes.make() }
  }

  /// Validates owned bytes and transfers their storage into a String without allocation or copying.
  ///
  /// # When to use
  ///
  /// Use when a byte buffer must become owned text. Use [`fromUtf8`] to borrow bytes without consuming them.
  ///
  /// # Details
  ///
  /// This function consumes `values`. Invalid UTF-8 returns the first invalid byte offset and releases
  /// the input storage. Success preserves the input allocation and its capacity.
  pub fn fromBytes(values: Bytes) -> Result<String, InvalidUtf8> {
    let failure = firstInvalidUtf8(Bytes.asSlice(&values))
    return match move failure {
      Option<usize>.Some {value} => Result.failResult<String, InvalidUtf8>(
        InvalidUtf8 {offset: value},
      )
      Option<usize>.None => Result.succeed<String, InvalidUtf8>(String {bytes: move values})
    }
  }
  /// Transfers caller-validated UTF-8 storage into a String without validation, allocation, or copying.
  ///
  /// # When to use
  ///
  /// Use when an earlier operation proves that every initialized byte forms valid UTF-8.
  /// Use [`fromBytes`] when that guarantee is not available.
  ///
  /// # Gotchas
  ///
  /// The complete initialized contents of `values` must be valid UTF-8. Invalid bytes violate the safety contract.
  /// This function consumes `values` and preserves its allocation and capacity.
  pub unsafe fn fromBytesUnchecked(values: Bytes) -> String {
    return String {bytes: move values}
  }
  /// Consumes the String and returns its bytes without allocation or copying.
  ///
  /// # Details
  ///
  /// The returned bytes retain the allocation, capacity, and complete UTF-8 contents.
  /// They can be modified as arbitrary bytes after this conversion.
  pub fn intoBytes(self: Self) -> Bytes {
    return match move self {
      String {bytes} => move bytes
    }
  }

  /// Copies valid borrowed text into independently owned storage.
  pub effect fn copy(value: string) -> String ! OutOfMemoryError ? &mut Allocator {
    let source = Intrinsic.stringUtf8Bytes(value)
    let bytes = run Bytes.copy(source)
    return String { bytes: move bytes }
  }

  /// Validates complete UTF-8 bytes and copies them into independently owned storage.
  ///
  /// # When to use
  ///
  /// Use this function when the bytes must outlive their current buffer. Use [`fromUtf8`] for a
  /// borrowed result without allocation.
  ///
  /// # Details
  ///
  /// Invalid input returns [`InvalidUtf8`] as ordinary result data. Allocation failure remains in the
  /// Effect failure channel. No owned string is returned in either failure case.
  pub effect fn copyUtf8(values: &[u8]) -> Result<String, InvalidUtf8> ! OutOfMemoryError ? &mut Allocator {
    let failure = match move firstInvalidUtf8(values) {
      Option<usize>.Some { value } => move value
      Option<usize>.None => values.length + usize.ONE
    }
    if failure <= values.length {
      return Result.failResult<String, InvalidUtf8>(InvalidUtf8 { offset: failure })
    }
    let bytes = run Bytes.copy(values)
    return Result.succeed<String, InvalidUtf8>(String { bytes: move bytes })
  }

  /// Appends complete valid text atomically with respect to allocation failure.
  ///
  /// # When to use
  ///
  /// Use this function for borrowed text. Use [`appendOwned`] when the suffix is an owned [`String`].
  ///
  /// # Details
  ///
  /// If growth fails, `self` keeps its prior contents and byte length.
  pub effect fn append(self: &mut Self, value: string) -> () ! OutOfMemoryError ? &mut Allocator {
    let suffix = Intrinsic.stringUtf8Bytes(value)
    return run Bytes.append(&mut self.bytes, suffix)
  }

  /// Appends another owned String atomically with respect to allocation failure.
  ///
  /// # When to use
  ///
  /// Use this function to consume an owned suffix. Use [`append`] when the suffix is borrowed text.
  ///
  /// # Details
  ///
  /// This function consumes `value`. If growth fails, `self` keeps its prior contents and byte length.
  pub effect fn appendOwned(self: &mut Self, value: String) -> () ! OutOfMemoryError ? &mut Allocator {
    let suffix = Bytes.asSlice(&value.bytes)
    return run Bytes.append(&mut self.bytes, suffix)
  }

  /// Borrows the complete owned contents as valid text without allocating or copying.
  pub fn view(self: &Self) -> string {
    let bytes = Bytes.asSlice(&self.bytes)
    return unsafe String.fromUtf8Unchecked(bytes)
  }

  /// Borrows a string's immutable UTF-8 encoding.
  pub fn utf8Bytes(value: string) -> &[u8] {
    return Intrinsic.stringUtf8Bytes(value)
  }

  /// Returns a string's UTF-8 byte length.
  pub fn byteLength(value: string) -> usize {
    return Intrinsic.stringByteLength(value)
  }

  /// Borrows an owned String's immutable UTF-8 encoding.
  pub fn ownedUtf8Bytes(self: &Self) -> &[u8] {
    return Bytes.asSlice(&self.bytes)
  }

  /// Returns an owned String's initialized UTF-8 byte length.
  pub fn ownedByteLength(self: &Self) -> usize {
    return Bytes.length(&self.bytes)
  }

  /// Creates a cursor at UTF-8 byte offset zero, before the first Unicode scalar.
  pub fn scalarCursor() -> ScalarCursor {
    return ScalarCursor { byteOffset: usize.ZERO }
  }

  /// Returns a cursor's explicit UTF-8 byte offset.
  pub fn cursorByteOffset(cursor: &ScalarCursor) -> usize {
    return cursor.byteOffset
  }

  /// Returns the decoded Unicode scalar value without consuming the step.
  pub fn scalarValue(step: &ScalarStep) -> char {
    return step.scalar
  }

  /// Returns the UTF-8 byte offset at which one step begins.
  pub fn scalarByteOffset(step: &ScalarStep) -> usize {
    return step.byteOffset
  }

  /// Consumes one scalar step and returns the cursor immediately after that scalar.
  pub fn nextCursor(step: ScalarStep) -> ScalarCursor {
    return match move step {
      ScalarStep { scalar, byteOffset, next } => move next
    }
  }

  /// Decodes the scalar at a cursor, or returns `None` at the end of the string.
  ///
  /// # Details
  ///
  /// A present step contains the scalar, its starting byte offset, and the next cursor. This function
  /// does not allocate.
  ///
  /// # Gotchas
  ///
  /// The cursor must come from [`scalarCursor`] or [`nextCursor`] for the same unchanged string.
  pub fn nextScalar(value: string, cursor: ScalarCursor) -> Option<ScalarStep> {
    let bytes = Intrinsic.stringUtf8Bytes(value)
    let offset = cursor.byteOffset
    if offset == bytes.length { return Option.none<ScalarStep>() }
    let first = bytes[offset]
    let mut scalar = scalar32(first)
    let mut width = usize.ONE
    if byte(194) <= first {
      if first <= byte(223) {
        scalar = (scalar32(first) - u32.toU32(192)) * u32.toU32(64)
          + (scalar32(bytes[offset + usize.ONE]) - u32.toU32(128))
        width = 2
      } else {
        if first <= byte(239) {
          scalar = (scalar32(first) - u32.toU32(224)) * u32.toU32(4096)
            + (scalar32(bytes[offset + usize.ONE]) - u32.toU32(128)) * u32.toU32(64)
            + (scalar32(bytes[offset + 2]) - u32.toU32(128))
          width = 3
        } else {
          scalar = (scalar32(first) - u32.toU32(240)) * u32.toU32(262144)
            + (scalar32(bytes[offset + usize.ONE]) - u32.toU32(128)) * u32.toU32(4096)
            + (scalar32(bytes[offset + 2]) - u32.toU32(128)) * u32.toU32(64)
            + (scalar32(bytes[offset + 3]) - u32.toU32(128))
          width = 4
        }
      }
    }
    return match move char.fromU32(scalar) {
      Option<char>.Some { value: decoded } => Option.some<ScalarStep>(ScalarStep {
        scalar: decoded,
        byteOffset: offset,
        next: ScalarCursor { byteOffset: offset + width }
      })
      Option<char>.None => Option.none<ScalarStep>()
    }
  }
}

/// The first byte offset at which UTF-8 validation failed.
pub struct InvalidUtf8 {
  /// The zero-based offset of the first byte that cannot continue a valid UTF-8 sequence.
  pub offset: usize
}

/// An opaque UTF-8 position used for scalar-by-scalar traversal.
pub struct ScalarCursor {
  byteOffset: usize
}

/// One decoded Unicode scalar, its byte offset, and the cursor after it.
pub struct ScalarStep {
  scalar: char
  byteOffset: usize
  next: ScalarCursor
}

fn byte(value: u8) -> u8 {
  return value
}

fn continuation(value: u8) -> bool {
  if value < byte(128) { return false }
  return value <= byte(191)
}

/// Returns the first byte offset at which UTF-8 validation fails, or None for complete valid text.
fn firstInvalidUtf8(values: &[u8]) -> Option<usize> {
  let mut index = usize.ZERO
  while index < values.length {
    let first = values[index]
    if first < byte(128) {
      index = index + usize.ONE
    } else {
      if first < byte(194) { return Option.some<usize>(index) }
      if first <= byte(223) {
        if values.length <= index + usize.ONE { return Option.some<usize>(index) }
        if continuation(values[index + usize.ONE]) == false {
          return Option.some<usize>(index + usize.ONE)
        }
        index = index + 2
      } else {
        if first <= byte(239) {
          if values.length <= index + 2 { return Option.some<usize>(index) }
          let second = values[index + usize.ONE]
          let third = values[index + 2]
          if continuation(second) == false { return Option.some<usize>(index + usize.ONE) }
          if continuation(third) == false { return Option.some<usize>(index + 2) }
          if first == byte(224) {
            if second < byte(160) { return Option.some<usize>(index + usize.ONE) }
          }
          if first == byte(237) {
            if byte(159) < second { return Option.some<usize>(index + usize.ONE) }
          }
          index = index + 3
        } else {
          if byte(244) < first { return Option.some<usize>(index) }
          if values.length <= index + 3 { return Option.some<usize>(index) }
          let second = values[index + usize.ONE]
          let third = values[index + 2]
          let fourth = values[index + 3]
          if continuation(second) == false { return Option.some<usize>(index + usize.ONE) }
          if continuation(third) == false { return Option.some<usize>(index + 2) }
          if continuation(fourth) == false { return Option.some<usize>(index + 3) }
          if first == byte(240) {
            if second < byte(144) { return Option.some<usize>(index + usize.ONE) }
          }
          if first == byte(244) {
            if byte(143) < second { return Option.some<usize>(index + usize.ONE) }
          }
          index = index + 4
        }
      }
    }
  }
  return Option.none<usize>()
}

// Appending grows the existing storage rather than copying the whole string into fresh storage
// first. The atomicity is the same either way — the underlying byte append builds its replacement
// buffer in full before committing, so a failed allocation leaves the original untouched — but the
// cost is not: composing a message from several pieces is what this API is for, and a copy per
// piece made that quadratic in the message and linear in allocations.

fn scalar32(value: u8) -> u32 {
  return u8.toU32(value)
}
