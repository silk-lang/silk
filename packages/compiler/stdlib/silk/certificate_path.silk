//! Deterministic bounded TLS-server certificate paths to explicit trust authority.
//!
//! # When to use
//!
//! Use [`CertificatePath.validate`] after certificate decoding and before HTTPS identity and TLS
//! CertificateVerify checks. Supply every trust candidate explicitly as a [`TrustAnchor`].
//!
//! # Details
//!
//! Validation borrows all certificate input. It searches anchors first and then intermediates in
//! caller order. All resource and work bounds are finite and inclusive. One caller-supplied
//! [`Instant`] controls every date check.
//!
//! # Gotchas
//!
//! A [`ValidatedPath`] does not authenticate a TLS connection. The caller must verify the service
//! identity, CertificateVerify, and Finished before it accepts application data. Revocation,
//! certificate transparency, network retrieval, and browser root policy are not checked.

import silk.allocator {Allocator, OutOfMemoryError}
import silk.certificate {Certificate, CertificateTime}
import silk.certificate_profile {
  CertificateProfile,
  CertificateRole,
  ProfileClass,
  ProfileError,
  ProfileLimits,
  ProfileOffsetSpace,
  ProfileReason,
}
import silk.i64
import silk.option {Option}
import silk.result {Result}
import silk.slice {Slice}
import silk.system_clock {Instant, SystemClock}
import silk.trust_anchor {TrustAnchor}
import silk.u16
import silk.u8
import silk.usize
import silk.vector {Vector}

/// Inclusive input and work limits for one path-validation call.
pub struct ValidationLimits {
  /// Maximum peer certificates, including the leaf.
  pub peerCertificates: usize
  /// Maximum DER bytes in each peer certificate.
  pub certificateBytes: usize
  /// Maximum aggregate peer certificate DER bytes.
  pub peerBytes: usize
  /// Maximum explicit trust-anchor candidates.
  pub anchors: usize
  /// Maximum aggregate encoded trust-anchor bytes.
  pub anchorBytes: usize
  /// Maximum selected path certificates, excluding the anchor and including the leaf.
  pub pathCertificates: usize
  /// Maximum issuer-candidate visits.
  pub issuerCandidates: usize
  /// Maximum primitive signature verifications.
  pub signatureVerifications: usize
  /// Maximum reached anchored candidate paths.
  pub completePaths: usize
  /// Maximum DNS or IP name/subtree comparisons.
  pub nameComparisons: usize
  /// Bounds for each semantic certificate-profile inspection.
  pub profile: ProfileLimits
}

impl Copy for ValidationLimits {}

impl ValidationLimits {
  /// Returns the fixed default input, search, signature, path, comparison, and profile bounds.
  pub fn defaults() -> ValidationLimits {
    return ValidationLimits {
      peerCertificates: 64,
      certificateBytes: 65536,
      peerBytes: 1048576,
      anchors: 1024,
      anchorBytes: 16777216,
      pathCertificates: 8,
      issuerCandidates: 4096,
      signatureVerifications: 100,
      completePaths: 100,
      nameComparisons: 250000,
      profile: ProfileLimits.defaults(),
    }
  }
}

/// The broad category of a path-validation failure.
pub enum ValidationClass {
  /// Caller input is invalid independently of trust-path selection.
  InvalidInput,
  /// The fixed certificate policy rejects all deterministic candidate paths.
  Rejected,
  /// An inclusive caller-supplied resource or work bound is exceeded.
  ResourceLimit,
}

/// Stable path-validation rejection reasons.
pub enum ValidationReason {
  /// The certificate version is outside the fixed role profile.
  UnsupportedVersion,
  /// A required signature or key algorithm is unsupported.
  UnsupportedAlgorithm,
  /// Algorithm parameters are unsupported or inconsistent.
  UnsupportedParameters,
  /// An extension needs unsupported processing.
  UnsupportedExtension,
  /// A NameConstraints form is outside the DNS/IP subset.
  UnsupportedConstraint,
  /// Certificate policy processing is required but not implemented.
  UnsupportedPolicy,
  /// A public key is malformed or outside the admitted profile.
  InvalidKey,
  /// A retained certificate signature does not verify.
  InvalidSignature,
  /// A path-certificate serial is invalid.
  InvalidSerial,
  /// KeyUsage or ExtendedKeyUsage rejects the selected role.
  InvalidUsage,
  /// BasicConstraints or CA-role policy rejects the certificate.
  InvalidBasicConstraints,
  /// A subject name or subjectAltName is invalid.
  InvalidName,
  /// A caller instant or certificate validity interval is invalid.
  InvalidTime,
  /// Two extensions contain the same OID.
  DuplicateExtension,
  /// Exact issuer and subject Name DER do not match.
  IssuerMismatch,
  /// A subordinate SAN violates cumulative NameConstraints.
  NameConstraintViolation,
  /// An embedded or configured path-length restriction is exceeded.
  PathLengthExceeded,
  /// A linked candidate repeats certificate DER already on the current path.
  Cycle,
  /// No supplied candidate has an exact linking subject Name.
  NoIssuer,
  /// Every deterministically visited linked path is rejected.
  NoValidPath,
  /// A checked length or counter sum is not representable.
  SizeOverflow,
}

/// The input position associated with one validation failure.
pub union ValidationLocation {
  /// The peer end-entity certificate.
  Leaf,
  /// One peer intermediate at its original caller index.
  Intermediate {
    /// The original caller index.
    pub index: usize
  },
  /// One explicit trust anchor at its original caller index.
  Anchor {
    /// The original caller index.
    pub index: usize
  },
  /// The validation call rather than one certificate.
  Call,
}

impl Copy for ValidationLocation {}

/// A named inclusive validation bound.
pub enum ValidationLimit {
  /// Total peer certificate count, including the leaf.
  PeerCertificates,
  /// DER bytes in one peer certificate.
  CertificateBytes,
  /// Aggregate peer certificate DER bytes.
  PeerBytes,
  /// Explicit trust-anchor count.
  Anchors,
  /// Aggregate encoded trust-anchor bytes.
  AnchorBytes,
  /// Selected path certificate count, excluding the anchor.
  PathCertificates,
  /// Issuer-candidate visits.
  IssuerCandidates,
  /// Primitive signature verifications.
  SignatureVerifications,
  /// Complete anchored candidate paths.
  CompletePaths,
  /// DNS or IP name/subtree comparisons.
  NameComparisons,
  /// Certificate-profile extension count.
  ProfileExtensions,
  /// One certificate-profile extension value size.
  ProfileExtensionBytes,
  /// Certificate-profile subjectAltName count.
  ProfileSanNames,
  /// Certificate-profile NameConstraints subtree count.
  ProfileConstraintSubtrees,
  /// Certificate-profile DER-node count.
  ProfileNodes,
  /// Certificate-profile DER nesting depth.
  ProfileDepth,
  /// Checked arithmetic representation.
  Arithmetic,
}

/// Owned scalar evidence for one failed validation call.
pub struct ValidationError {
  /// Broad failure category.
  pub kind: ValidationClass
  /// Stable primary reason.
  pub reason: ValidationReason
  /// First rejected-candidate detail when `reason` is `NoValidPath`.
  pub detailReason: Option<ValidationReason>
  /// Input position associated with the primary or retained detail.
  pub location: ValidationLocation
  /// Extension index when a profile failure belongs to an extension.
  pub extensionIndex: Option<usize>
  /// Named bound for a resource-limit failure.
  pub limit: Option<ValidationLimit>
  /// Byte offset in the relevant certificate or configured constraint input.
  pub offset: usize
}

/// Revocation evidence attached to a validated path.
pub enum RevocationStatus {
  /// No CRL, OCSP, must-staple, or other revocation check was performed.
  NotChecked,
}

/// One borrowed selected path plus owned caller-order intermediate indices.
pub struct ValidatedPath<'a> {
  leafValue: &'a Certificate
  intermediateIndices: Vector<usize>
  anchorIndexValue: usize
  validationTimeValue: Instant
}

impl<'a> ValidatedPath<'a> {
  /// Borrows the exact caller-supplied leaf certificate.
  pub fn leaf(self: &Self) -> &'a Certificate { return self.leafValue }

  /// Returns the selected trust anchor's original caller index.
  pub fn anchorIndex(self: &Self) -> usize { return self.anchorIndexValue }

  /// Returns the number of selected peer intermediate certificates.
  pub fn intermediateCount(self: &Self) -> usize {
    return Vector.length<usize>(&self.intermediateIndices)
  }

  /// Returns one selected intermediate's original caller index, in leaf-to-anchor order.
  pub fn intermediateIndex(self: &Self, index: usize) -> Option<usize> {
    if index >= Vector.length<usize>(&self.intermediateIndices) {
      return Option.none<usize>()
    }
    return Option.some<usize>(Vector.get<usize>(&self.intermediateIndices, index))
  }

  /// Returns the copied caller-supplied validation instant.
  pub fn validationTime(self: &Self) -> Instant {
    return SystemClock.make(
      SystemClock.seconds(&self.validationTimeValue),
      SystemClock.nanoseconds(&self.validationTimeValue),
    )
  }

  /// Returns `NotChecked` because path validation performs no revocation operation.
  pub fn revocationStatus(self: &Self) -> RevocationStatus {
    return RevocationStatus.NotChecked
  }
}

struct Frame {
  nextAnchor: usize
  nextIntermediate: usize
}

impl Copy for Frame {}

struct Counters {
  issuers: usize
  signatures: usize
  paths: usize
  comparisons: usize
}

union AnchorCandidate {
  Unlinked,
  Rejected { error: ValidationError },
  Accepted,
}

union IntermediateCandidate {
  Unlinked,
  Rejected { error: ValidationError },
  Descend,
}

fn noLimit() -> Option<ValidationLimit> { return Option.none<ValidationLimit>() }
fn noDetail() -> Option<ValidationReason> { return Option.none<ValidationReason>() }
fn noExtension() -> Option<usize> { return Option.none<usize>() }

fn validationError(
  kind: ValidationClass,
  reason: ValidationReason,
  location: ValidationLocation,
  extensionIndex: Option<usize>,
  limit: Option<ValidationLimit>,
  offset: usize,
) -> ValidationError {
  return ValidationError {
    kind: kind,
    reason: reason,
    detailReason: noDetail(),
    location: move location,
    extensionIndex: move extensionIndex,
    limit: move limit,
    offset: offset,
  }
}

fn limited(reason: ValidationReason, limit: ValidationLimit) -> ValidationError {
  return validationError(
    ValidationClass.ResourceLimit,
    reason,
    ValidationLocation.Call,
    noExtension(),
    Option.some<ValidationLimit>(limit),
    0,
  )
}

fn validationFailure<A>(error: ValidationError) -> Result<A, ValidationError> {
  return Result.failResult<A, ValidationError>(move error)
}

fn profileLimit(reason: ProfileReason) -> Option<ValidationLimit> {
  return match reason {
    ProfileReason.Extensions => Option.some<ValidationLimit>(ValidationLimit.ProfileExtensions)
    ProfileReason.ExtensionBytes => Option.some<ValidationLimit>(ValidationLimit.ProfileExtensionBytes)
    ProfileReason.SanNames => Option.some<ValidationLimit>(ValidationLimit.ProfileSanNames)
    ProfileReason.ConstraintSubtrees => Option.some<ValidationLimit>(ValidationLimit.ProfileConstraintSubtrees)
    ProfileReason.Nodes => Option.some<ValidationLimit>(ValidationLimit.ProfileNodes)
    ProfileReason.Depth => Option.some<ValidationLimit>(ValidationLimit.ProfileDepth)
    ProfileReason.NameComparisons => Option.some<ValidationLimit>(ValidationLimit.NameComparisons)
    ProfileReason.SizeOverflow => Option.some<ValidationLimit>(ValidationLimit.Arithmetic)
    _ => Option.none<ValidationLimit>()
  }
}

fn profileReason(reason: ProfileReason) -> ValidationReason {
  return match reason {
    ProfileReason.Version => ValidationReason.UnsupportedVersion
    ProfileReason.Serial => ValidationReason.InvalidSerial
    ProfileReason.UniqueIdentifier => ValidationReason.UnsupportedExtension
    ProfileReason.PublicKey => ValidationReason.InvalidKey
    ProfileReason.SignatureAlgorithm => ValidationReason.UnsupportedAlgorithm
    ProfileReason.SignatureParameters => ValidationReason.UnsupportedParameters
    ProfileReason.SignatureAlgorithmMismatch => ValidationReason.UnsupportedParameters
    ProfileReason.Extensions => ValidationReason.SizeOverflow
    ProfileReason.ExtensionBytes => ValidationReason.SizeOverflow
    ProfileReason.DuplicateExtension => ValidationReason.DuplicateExtension
    ProfileReason.UnknownCriticalExtension => ValidationReason.UnsupportedExtension
    ProfileReason.MalformedExtension => ValidationReason.UnsupportedExtension
    ProfileReason.BasicConstraints => ValidationReason.InvalidBasicConstraints
    ProfileReason.KeyUsage => ValidationReason.InvalidUsage
    ProfileReason.MissingKeyUsage => ValidationReason.InvalidUsage
    ProfileReason.ExtendedKeyUsage => ValidationReason.InvalidUsage
    ProfileReason.MissingServerAuth => ValidationReason.InvalidUsage
    ProfileReason.SubjectAltName => ValidationReason.InvalidName
    ProfileReason.EmptySubject => ValidationReason.InvalidName
    ProfileReason.UnsupportedCriticalName => ValidationReason.UnsupportedExtension
    ProfileReason.NameConstraints => ValidationReason.UnsupportedConstraint
    ProfileReason.UnsupportedNameConstraint => ValidationReason.UnsupportedConstraint
    ProfileReason.PolicyProcessing => ValidationReason.UnsupportedPolicy
    ProfileReason.TlsFeature => ValidationReason.UnsupportedExtension
    ProfileReason.Role => ValidationReason.InvalidBasicConstraints
    ProfileReason.SanNames => ValidationReason.SizeOverflow
    ProfileReason.ConstraintSubtrees => ValidationReason.SizeOverflow
    ProfileReason.Nodes => ValidationReason.SizeOverflow
    ProfileReason.Depth => ValidationReason.SizeOverflow
    ProfileReason.SizeOverflow => ValidationReason.SizeOverflow
    ProfileReason.IssuerName => ValidationReason.IssuerMismatch
    ProfileReason.SignatureRejected => ValidationReason.InvalidSignature
    ProfileReason.NameConstraintViolation => ValidationReason.NameConstraintViolation
    ProfileReason.NameComparisons => ValidationReason.SizeOverflow
  }
}

fn fromProfile(error: ProfileError, location: ValidationLocation) -> ValidationError {
  let mut kind = ValidationClass.Rejected
  if error.kind == ProfileClass.ResourceLimit { kind = ValidationClass.ResourceLimit }
  return validationError(
    kind,
    profileReason(error.reason),
    move location,
    move error.extensionIndex,
    profileLimit(error.reason),
    error.offset,
  )
}

fn sameDer(left: &Certificate, right: &Certificate) -> bool {
  let a = Certificate.der(left)
  let b = Certificate.der(right)
  if a.length != b.length { return false }
  let mut index = usize.ZERO
  while index < a.length {
    if a[index] != b[index] { return false }
    index = index + 1
  }
  return true
}

fn sameName(subject: &Certificate, issuer: &Certificate) -> bool {
  let a = Certificate.issuerDer(subject)
  let b = Certificate.subjectDer(issuer)
  if a.length != b.length { return false }
  let mut index = usize.ZERO
  while index < a.length {
    if a[index] != b[index] { return false }
    index = index + 1
  }
  return true
}

fn selfIssued(certificate: &Certificate) -> bool {
  let subject = Certificate.subjectDer(certificate)
  let issuer = Certificate.issuerDer(certificate)
  if subject.length != issuer.length { return false }
  let mut index = usize.ZERO
  while index < subject.length {
    if subject[index] != issuer[index] { return false }
    index = index + 1
  }
  return true
}

fn leap(year: usize) -> bool {
  return year % 4 == 0 && (year % 100 != 0 || year % 400 == 0)
}

fn monthDays(year: usize, month: usize) -> usize {
  if month == 2 {
    if leap(year) { return 29 }
    return 28
  }
  if month == 4 || month == 6 || month == 9 || month == 11 { return 30 }
  return 31
}

fn instantSeconds(time: CertificateTime) -> i64 {
  let year = u16.toUsize(time.year)
  let month = u8.toUsize(time.month)
  let mut days = usize.ZERO
  let mut selectedYear = usize.ONE
  while selectedYear < year {
    days = days + 365
    if leap(selectedYear) { days = days + 1 }
    selectedYear = selectedYear + 1
  }
  let mut selectedMonth = usize.ONE
  while selectedMonth < month {
    days = days + monthDays(year, selectedMonth)
    selectedMonth = selectedMonth + 1
  }
  days = days + u8.toUsize(time.day) - 1
  let daySeconds = usize.toI64(days) - 719162
  return daySeconds * 86400
    + u8.toI64(time.hour) * 3600
    + u8.toI64(time.minute) * 60
    + u8.toI64(time.second)
}

fn validCallerTime(at: &Instant) -> bool {
  let seconds = SystemClock.seconds(at)
  return seconds >= -62135596800 && seconds <= 253402300799
}

fn validCertificateTime(certificate: &Certificate, at: &Instant) -> bool {
  let before = instantSeconds(Certificate.notBefore(certificate))
  let after = instantSeconds(Certificate.notAfter(certificate))
  if after < before { return false }
  let current = SystemClock.seconds(at)
  if current < before || current > after { return false }
  if current == after && SystemClock.nanoseconds(at) > 0 { return false }
  return true
}

fn currentCertificate<'a>(
  leaf: &'a Certificate,
  intermediates: &'a [Certificate],
  path: &Vector<usize>,
) -> &'a Certificate {
  let count = Vector.length<usize>(path)
  if count == 0 { return leaf }
  return &intermediates[Vector.get<usize>(path, count - 1)]
}

fn onCurrentPath(
  candidateIndex: usize,
  leaf: &Certificate,
  intermediates: &[Certificate],
  path: &Vector<usize>,
) -> bool {
  if sameDer(&intermediates[candidateIndex], leaf) { return true }
  let mut index = usize.ZERO
  while index < Vector.length<usize>(path) {
    if sameDer(
      &intermediates[candidateIndex],
      &intermediates[Vector.get<usize>(path, index)],
    ) { return true }
    index = index + 1
  }
  return false
}

fn earlierDuplicate(candidate: usize, intermediates: &[Certificate]) -> bool {
  let mut index = usize.ZERO
  while index < candidate {
    if sameDer(&intermediates[index], &intermediates[candidate]) { return true }
    index = index + 1
  }
  return false
}

fn consume(
  value: &mut usize,
  maximum: usize,
  dimension: ValidationLimit,
) -> Result<(), ValidationError> {
  if value.* >= maximum {
    return validationFailure<()>(limited(ValidationReason.SizeOverflow, dimension))
  }
  value.* = value.* + 1
  return Result.succeed<(), ValidationError>(())
}

fn inspect<'a>(
  certificate: &'a Certificate,
  selectedRole: CertificateRole,
  limits: ProfileLimits,
  location: ValidationLocation,
) -> Result<CertificateProfile<'a>, ValidationError> {
  return match move CertificateProfile.inspect(certificate, selectedRole, limits) {
    Result<CertificateProfile<'a>, ProfileError>.Success {value} => {
      return Result.succeed<CertificateProfile<'a>, ValidationError>(value)
    }
    Result<CertificateProfile<'a>, ProfileError>.Failure {error} => {
      return validationFailure<CertificateProfile<'a>>(fromProfile(move error, move location))
    }
  }
}

fn verifyEdge(
  subject: &CertificateProfile,
  issuer: &CertificateProfile,
  counters: &mut Counters,
  limits: ValidationLimits,
  location: ValidationLocation,
) -> Result<(), ValidationError> {
  let budget = consume(
    &mut counters.signatures,
    limits.signatureVerifications,
    ValidationLimit.SignatureVerifications,
  )
  match move budget {
    Result<(), ValidationError>.Failure {error} => { return validationFailure<()>(move error) }
    Result<(), ValidationError>.Success {value: budgetAccepted} => {}
  }
  return match move CertificateProfile.verifyIssuedBy(subject, issuer) {
    Result<(), ProfileError>.Success {value} => Result.succeed<(), ValidationError>(())
    Result<(), ProfileError>.Failure {error} => validationFailure<()>(fromProfile(move error, move location))
  }
}

fn profileForPath<'a>(
  leaf: &'a Certificate,
  intermediates: &'a [Certificate],
  path: &Vector<usize>,
  position: usize,
  limits: ProfileLimits,
) -> Result<CertificateProfile<'a>, ValidationError> {
  if position == 0 {
    return inspect(leaf, CertificateRole.ServerLeaf, limits, ValidationLocation.Leaf)
  }
  let index = Vector.get<usize>(path, position - 1)
  return inspect(
    &intermediates[index],
    CertificateRole.Intermediate,
    limits,
    ValidationLocation.Intermediate {index: index},
  )
}

fn profileForSearch<'a>(
  leafProfile: CertificateProfile<'a>,
  intermediates: &'a [Certificate],
  path: &Vector<usize>,
  position: usize,
  limits: ProfileLimits,
) -> Result<CertificateProfile<'a>, ValidationError> {
  if position == 0 {
    return Result.succeed<CertificateProfile<'a>, ValidationError>(leafProfile)
  }
  let index = Vector.get<usize>(path, position - 1)
  return inspect(
    &intermediates[index],
    CertificateRole.Intermediate,
    limits,
    ValidationLocation.Intermediate {index: index},
  )
}

fn pathCertificate<'a>(
  leaf: &'a Certificate,
  intermediates: &'a [Certificate],
  path: &Vector<usize>,
  position: usize,
) -> &'a Certificate {
  if position == 0 { return leaf }
  return &intermediates[Vector.get<usize>(path, position - 1)]
}

fn pathLengthAllowed<'a>(
  leaf: &'a Certificate,
  intermediates: &'a [Certificate],
  path: &Vector<usize>,
  anchor: &TrustAnchor,
  anchorProfile: &CertificateProfile,
  limits: ProfileLimits,
  anchorIndex: usize,
) -> Result<(), ValidationError> {
  let pathCount = Vector.length<usize>(path) + 1
  let mut subordinateCas = usize.ZERO
  let mut position = usize.ONE
  while position < pathCount {
    let certificate = pathCertificate(leaf, intermediates, path, position)
    if !selfIssued(certificate) { subordinateCas = subordinateCas + 1 }
    position = position + 1
  }
  match move anchorProfile.pathLength() {
    Option<usize>.Some {value} => {
      if subordinateCas > value {
        return validationFailure<()>(validationError(
          ValidationClass.Rejected,
          ValidationReason.PathLengthExceeded,
          ValidationLocation.Anchor {index: anchorIndex},
          noExtension(),
          noLimit(),
          0,
        ))
      }
    }
    Option<usize>.None => {}
  }
  match move TrustAnchor.configuredPathLength(anchor) {
    Option<usize>.Some {value} => {
      if subordinateCas > value {
        return validationFailure<()>(validationError(
          ValidationClass.Rejected,
          ValidationReason.PathLengthExceeded,
          ValidationLocation.Anchor {index: anchorIndex},
          noExtension(),
          noLimit(),
          0,
        ))
      }
    }
    Option<usize>.None => {}
  }

  let mut source = usize.ONE
  while source < pathCount {
    let sourceProfileResult = profileForPath(leaf, intermediates, path, source, limits)
    let sourceProfile = match move sourceProfileResult {
      Result<CertificateProfile<'a>, ValidationError>.Failure {error} => {
        return validationFailure<()>(move error)
      }
      Result<CertificateProfile<'a>, ValidationError>.Success {value} => value
    }
    match move sourceProfile.pathLength() {
      Option<usize>.None => {}
      Option<usize>.Some {value: maximum} => {
        let mut below = usize.ZERO
        let mut position = usize.ONE
        while position < source {
          if !selfIssued(pathCertificate(leaf, intermediates, path, position)) {
            below = below + 1
          }
          position = position + 1
        }
        if below > maximum {
          let index = Vector.get<usize>(path, source - 1)
          return validationFailure<()>(validationError(
            ValidationClass.Rejected,
            ValidationReason.PathLengthExceeded,
            ValidationLocation.Intermediate {index: index},
            noExtension(),
            noLimit(),
            0,
          ))
        }
      }
    }
    source = source + 1
  }
  return Result.succeed<(), ValidationError>(())
}

fn applyConstraint(
  subject: &CertificateProfile,
  constraintDer: &[u8],
  configured: bool,
  counters: &mut Counters,
  limits: ValidationLimits,
  location: ValidationLocation,
) -> Result<(), ValidationError> {
  let mut offsetSpace = ProfileOffsetSpace.CertificateDer
  if configured { offsetSpace = ProfileOffsetSpace.ConfiguredConstraintDer }
  let checked = CertificateProfile.checkNameConstraints(
    subject,
    constraintDer,
    &mut counters.comparisons,
    limits.nameComparisons,
    offsetSpace,
  )
  return match move checked {
    Result<(), ProfileError>.Success {value} => Result.succeed<(), ValidationError>(())
    Result<(), ProfileError>.Failure {error} => {
      let mut mapped = fromProfile(move error, move location)
      if error.reason == ProfileReason.NameComparisons {
        mapped.kind = ValidationClass.ResourceLimit
        mapped.location = ValidationLocation.Call
        mapped.extensionIndex = noExtension()
        mapped.limit = Option.some<ValidationLimit>(ValidationLimit.NameComparisons)
        mapped.offset = 0
      }
      return validationFailure<()>(move mapped)
    }
  }
}

fn constrainSubordinates<'a>(
  leaf: &'a Certificate,
  leafProfile: CertificateProfile<'a>,
  intermediates: &'a [Certificate],
  path: &Vector<usize>,
  sourcePosition: usize,
  constraintDer: &[u8],
  configured: bool,
  counters: &mut Counters,
  limits: ValidationLimits,
) -> Result<(), ValidationError> {
  let mut position = sourcePosition
  while position > 0 {
    position = position - 1
    let certificate = pathCertificate(leaf, intermediates, path, position)
    if position == 0 || !selfIssued(certificate) {
      let subjectResult = profileForSearch(
        leafProfile,
        intermediates,
        path,
        position,
        limits.profile,
      )
      let subject = match move subjectResult {
        Result<CertificateProfile<'a>, ValidationError>.Failure {error} => {
          return validationFailure<()>(move error)
        }
        Result<CertificateProfile<'a>, ValidationError>.Success {value} => value
      }
      let mut location = ValidationLocation.Leaf
      if position > 0 {
        location = ValidationLocation.Intermediate {
          index: Vector.get<usize>(path, position - 1),
        }
      }
      let checked = applyConstraint(
        &subject, constraintDer, configured, &mut counters, limits, move location,
      )
      match move checked {
        Result<(), ValidationError>.Failure {error} => { return validationFailure<()>(move error) }
        Result<(), ValidationError>.Success {value: constraintAccepted} => {}
      }
    }
  }
  return Result.succeed<(), ValidationError>(())
}

fn completePath<'a>(
  leaf: &'a Certificate,
  leafProfile: CertificateProfile<'a>,
  intermediates: &'a [Certificate],
  path: &Vector<usize>,
  anchor: &TrustAnchor,
  anchorProfile: &CertificateProfile,
  anchorIndex: usize,
  counters: &mut Counters,
  limits: ValidationLimits,
) -> Result<(), ValidationError> {
  let lengths = pathLengthAllowed(
    leaf,
    intermediates,
    path,
    anchor,
    anchorProfile,
    limits.profile,
    anchorIndex,
  )
  match move lengths {
    Result<(), ValidationError>.Failure {error} => { return validationFailure<()>(move error) }
    Result<(), ValidationError>.Success {value: lengthsAccepted} => {}
  }
  let pathCount = Vector.length<usize>(path) + 1
  match move anchorProfile.nameConstraintsDer() {
    Option<&[u8]>.None => {}
    Option<&[u8]>.Some {value} => {
      let checked = constrainSubordinates(
        leaf, leafProfile, intermediates, path, pathCount, value, false, &mut counters, limits,
      )
      match move checked {
        Result<(), ValidationError>.Failure {error} => { return validationFailure<()>(move error) }
        Result<(), ValidationError>.Success {value: embeddedAnchorAccepted} => {}
      }
    }
  }
  match move TrustAnchor.configuredNameConstraints(anchor) {
    Option<&[u8]>.None => {}
    Option<&[u8]>.Some {value} => {
      let checked = constrainSubordinates(
        leaf, leafProfile, intermediates, path, pathCount, value, true, &mut counters, limits,
      )
      match move checked {
        Result<(), ValidationError>.Failure {error} => { return validationFailure<()>(move error) }
        Result<(), ValidationError>.Success {value: configuredAnchorAccepted} => {}
      }
    }
  }
  let mut source = pathCount
  while source > 1 {
    source = source - 1
    let sourceResult = profileForPath(leaf, intermediates, path, source, limits.profile)
    let sourceProfile = match move sourceResult {
      Result<CertificateProfile<'a>, ValidationError>.Failure {error} => {
        return validationFailure<()>(move error)
      }
      Result<CertificateProfile<'a>, ValidationError>.Success {value} => value
    }
    match move sourceProfile.nameConstraintsDer() {
      Option<&[u8]>.None => {}
      Option<&[u8]>.Some {value} => {
        let checked = constrainSubordinates(
          leaf, leafProfile, intermediates, path, source, value, false, &mut counters, limits,
        )
        match move checked {
          Result<(), ValidationError>.Failure {error} => { return validationFailure<()>(move error) }
          Result<(), ValidationError>.Success {value: intermediateConstraintAccepted} => {}
        }
      }
    }
  }
  return Result.succeed<(), ValidationError>(())
}

fn evaluateAnchor<'a>(
  subjectCertificate: &Certificate,
  subjectProfile: &CertificateProfile,
  leaf: &'a Certificate,
  leafProfile: CertificateProfile<'a>,
  intermediates: &'a [Certificate],
  path: &Vector<usize>,
  anchors: &'a [TrustAnchor],
  anchorIndex: usize,
  counters: &mut Counters,
  limits: ValidationLimits,
) -> AnchorCandidate {
  if !sameName(subjectCertificate, TrustAnchor.certificate(&anchors[anchorIndex])) {
    return AnchorCandidate.Unlinked
  }
  let budget = consume(&mut counters.paths, limits.completePaths, ValidationLimit.CompletePaths)
  match move budget {
    Result<(), ValidationError>.Failure {error} => {
      return AnchorCandidate.Rejected {error: move error}
    }
    Result<(), ValidationError>.Success {value: pathBudgetAccepted} => {}
  }
  let anchorResult = inspect(
    TrustAnchor.certificate(&anchors[anchorIndex]),
    CertificateRole.Anchor,
    limits.profile,
    ValidationLocation.Anchor {index: anchorIndex},
  )
  let anchorProfile = match move anchorResult {
    Result<CertificateProfile<'a>, ValidationError>.Failure {error} => {
      return AnchorCandidate.Rejected {error: move error}
    }
    Result<CertificateProfile<'a>, ValidationError>.Success {value} => value
  }
  let edge = verifyEdge(
    subjectProfile,
    &anchorProfile,
    &mut counters,
    limits,
    ValidationLocation.Anchor {index: anchorIndex},
  )
  match move edge {
    Result<(), ValidationError>.Failure {error} => {
      return AnchorCandidate.Rejected {error: move error}
    }
    Result<(), ValidationError>.Success {value: edgeAccepted} => {}
  }
  let complete = completePath(
    leaf,
    leafProfile,
    intermediates,
    path,
    &anchors[anchorIndex],
    &anchorProfile,
    anchorIndex,
    &mut counters,
    limits,
  )
  return match move complete {
    Result<(), ValidationError>.Failure {error} => {
      return AnchorCandidate.Rejected {error: move error}
    }
    Result<(), ValidationError>.Success {value: pathAccepted} => AnchorCandidate.Accepted
  }
}

fn evaluateIntermediate<'a>(
  subjectCertificate: &Certificate,
  subjectProfile: &CertificateProfile,
  leaf: &'a Certificate,
  intermediates: &'a [Certificate],
  path: &Vector<usize>,
  candidateIndex: usize,
  depth: usize,
  at: &Instant,
  counters: &mut Counters,
  limits: ValidationLimits,
) -> IntermediateCandidate {
  if earlierDuplicate(candidateIndex, intermediates) {
    return IntermediateCandidate.Unlinked
  }
  if !sameName(subjectCertificate, &intermediates[candidateIndex]) {
    return IntermediateCandidate.Unlinked
  }
  if onCurrentPath(candidateIndex, leaf, intermediates, path) {
    return IntermediateCandidate.Rejected {
      error: validationError(
        ValidationClass.Rejected,
        ValidationReason.Cycle,
        ValidationLocation.Intermediate {index: candidateIndex},
        noExtension(),
        noLimit(),
        0,
      ),
    }
  }
  if depth + 1 >= limits.pathCertificates {
    return IntermediateCandidate.Rejected {
      error: validationError(
        ValidationClass.Rejected,
        ValidationReason.PathLengthExceeded,
        ValidationLocation.Intermediate {index: candidateIndex},
        noExtension(),
        Option.some<ValidationLimit>(ValidationLimit.PathCertificates),
        0,
      ),
    }
  }
  let candidateResult = inspect(
    &intermediates[candidateIndex],
    CertificateRole.Intermediate,
    limits.profile,
    ValidationLocation.Intermediate {index: candidateIndex},
  )
  let candidateProfile = match move candidateResult {
    Result<CertificateProfile<'a>, ValidationError>.Failure {error} => {
      return IntermediateCandidate.Rejected {error: move error}
    }
    Result<CertificateProfile<'a>, ValidationError>.Success {value} => value
  }
  if !validCertificateTime(&intermediates[candidateIndex], at) {
    return IntermediateCandidate.Rejected {
      error: validationError(
        ValidationClass.Rejected,
        ValidationReason.InvalidTime,
        ValidationLocation.Intermediate {index: candidateIndex},
        noExtension(),
        noLimit(),
        0,
      ),
    }
  }
  let edge = verifyEdge(
    subjectProfile,
    &candidateProfile,
    &mut counters,
    limits,
    ValidationLocation.Intermediate {index: candidateIndex},
  )
  return match move edge {
    Result<(), ValidationError>.Failure {error} => {
      return IntermediateCandidate.Rejected {error: move error}
    }
    Result<(), ValidationError>.Success {value: edgeAccepted} => IntermediateCandidate.Descend
  }
}

fn rejected(first: ValidationError) -> ValidationError {
  return ValidationError {
    kind: ValidationClass.Rejected,
    reason: ValidationReason.NoValidPath,
    detailReason: Option.some<ValidationReason>(first.reason),
    location: first.location,
    extensionIndex: move first.extensionIndex,
    limit: noLimit(),
    offset: first.offset,
  }
}

fn remember(error: ValidationError, hasFirst: &mut bool, first: &mut ValidationError) -> () {
  if !hasFirst.* {
    first.* = move error
    hasFirst.* = true
  }
  return ()
}

fn blankError() -> ValidationError {
  return validationError(
    ValidationClass.Rejected,
    ValidationReason.NoIssuer,
    ValidationLocation.Call,
    noExtension(),
    noLimit(),
    0,
  )
}

/// The namespace for bounded deterministic certificate-path validation.
pub struct CertificatePath {}

impl CertificatePath {
  /// Builds and validates the first deterministic TLS-server path to explicit authority.
  ///
  /// # Details
  ///
  /// The result borrows `leaf`, `intermediates`, and `anchors` for `'a`. Search tries anchors in
  /// caller order before intermediates in caller order at each depth. Counters span the complete
  /// call and do not reset during backtracking.
  ///
  /// # Gotchas
  ///
  /// Zero permits no corresponding input or operation. Work-budget exhaustion is terminal. An
  /// ordinary candidate rejection does not stop a later alternate path.
  pub effect fn validate<'a>(
    leaf: &'a Certificate,
    intermediates: &'a [Certificate],
    anchors: &'a [TrustAnchor],
    at: &Instant,
    limits: ValidationLimits,
  ) -> Result<ValidatedPath<'a>, ValidationError>
  ! OutOfMemoryError
  ? &mut Allocator {
    if !validCallerTime(at) {
      return validationFailure<ValidatedPath<'a>>(validationError(
        ValidationClass.InvalidInput,
        ValidationReason.InvalidTime,
        ValidationLocation.Call,
        noExtension(),
        noLimit(),
        0,
      ))
    }
    let peerCount = match move usize.checkedAdd(intermediates.length, usize.ONE) {
      Option<usize>.None => { return validationFailure<ValidatedPath<'a>>(limited(
        ValidationReason.SizeOverflow,
        ValidationLimit.Arithmetic,
      )) }
      Option<usize>.Some {value} => value
    }
    if peerCount > limits.peerCertificates {
      return validationFailure<ValidatedPath<'a>>(limited(
        ValidationReason.SizeOverflow,
        ValidationLimit.PeerCertificates,
      ))
    }
    if Certificate.der(leaf).length > limits.certificateBytes {
      return validationFailure<ValidatedPath<'a>>(limited(
        ValidationReason.SizeOverflow,
        ValidationLimit.CertificateBytes,
      ))
    }
    let mut peerBytes = Certificate.der(leaf).length
    let mut index = usize.ZERO
    while index < intermediates.length {
      let length = Certificate.der(&intermediates[index]).length
      if length > limits.certificateBytes {
        return validationFailure<ValidatedPath<'a>>(limited(
          ValidationReason.SizeOverflow,
          ValidationLimit.CertificateBytes,
        ))
      }
      peerBytes = match move usize.checkedAdd(peerBytes, length) {
        Option<usize>.None => { return validationFailure<ValidatedPath<'a>>(limited(
          ValidationReason.SizeOverflow,
          ValidationLimit.Arithmetic,
        )) }
        Option<usize>.Some {value} => value
      }
      index = index + 1
    }
    if peerBytes > limits.peerBytes {
      return validationFailure<ValidatedPath<'a>>(limited(
        ValidationReason.SizeOverflow,
        ValidationLimit.PeerBytes,
      ))
    }
    if anchors.length > limits.anchors {
      return validationFailure<ValidatedPath<'a>>(limited(
        ValidationReason.SizeOverflow,
        ValidationLimit.Anchors,
      ))
    }
    let mut anchorBytes = usize.ZERO
    index = usize.ZERO
    while index < anchors.length {
      anchorBytes = match move usize.checkedAdd(anchorBytes, TrustAnchor.encodedBytes(&anchors[index])) {
        Option<usize>.None => { return validationFailure<ValidatedPath<'a>>(limited(
          ValidationReason.SizeOverflow,
          ValidationLimit.Arithmetic,
        )) }
        Option<usize>.Some {value} => value
      }
      index = index + 1
    }
    if anchorBytes > limits.anchorBytes {
      return validationFailure<ValidatedPath<'a>>(limited(
        ValidationReason.SizeOverflow,
        ValidationLimit.AnchorBytes,
      ))
    }
    if limits.pathCertificates == 0 {
      return validationFailure<ValidatedPath<'a>>(limited(
        ValidationReason.SizeOverflow,
        ValidationLimit.PathCertificates,
      ))
    }

    let leafResult = inspect(
      leaf,
      CertificateRole.ServerLeaf,
      limits.profile,
      ValidationLocation.Leaf,
    )
    let leafProfile = match move leafResult {
      Result<CertificateProfile<'a>, ValidationError>.Failure {error} => {
        return validationFailure<ValidatedPath<'a>>(move error)
      }
      Result<CertificateProfile<'a>, ValidationError>.Success {value} => value
    }
    if !validCertificateTime(leaf, at) {
      return validationFailure<ValidatedPath<'a>>(validationError(
        ValidationClass.Rejected,
        ValidationReason.InvalidTime,
        ValidationLocation.Leaf,
        noExtension(),
        noLimit(),
        0,
      ))
    }

    let mut path = Vector.make<usize>()
    let mut frames = Vector.make<Frame>()
    let reservedPath = run Vector.reserveExact<usize>(&mut path, limits.pathCertificates - 1)
    let reservedFrames = run Vector.reserveExact<Frame>(&mut frames, limits.pathCertificates)
    let initial = run Vector.append<Frame>(
      &mut frames,
      Frame {nextAnchor: usize.ZERO, nextIntermediate: usize.ZERO},
    )
    let mut counters = Counters {issuers: 0, signatures: 0, paths: 0, comparisons: 0}
    let mut hasLinked = false
    let mut hasFirst = false
    let mut first = blankError()

    while Vector.length<Frame>(&frames) > 0 {
      let depth = Vector.length<Frame>(&frames) - 1
      let mut frame = Vector.get<Frame>(&frames, depth)
      let subjectCertificate = currentCertificate(leaf, intermediates, &path)
      let subjectResult = profileForSearch(
        leafProfile,
        intermediates,
        &path,
        depth,
        limits.profile,
      )
      let subjectProfile = match move subjectResult {
        Result<CertificateProfile<'a>, ValidationError>.Failure {error} => {
          let ignored = remember(move error, &mut hasFirst, &mut first)
          let removedFrame = Vector.pop<Frame>(&mut frames)
          if Vector.length<usize>(&path) > 0 { let removedPath = Vector.pop<usize>(&mut path) }
          continue
        }
        Result<CertificateProfile<'a>, ValidationError>.Success {value} => value
      }

      let mut descended = false
      while frame.nextAnchor < anchors.length && !descended {
        let anchorIndex = frame.nextAnchor
        frame.nextAnchor = frame.nextAnchor + 1
        Vector.set<Frame>(&mut frames, depth, frame)
        let visited = consume(
          &mut counters.issuers,
          limits.issuerCandidates,
          ValidationLimit.IssuerCandidates,
        )
        match move visited {
          Result<(), ValidationError>.Failure {error} => {
            return validationFailure<ValidatedPath<'a>>(move error)
          }
          Result<(), ValidationError>.Success {value: anchorVisitAccepted} => {}
        }
        let evaluated = evaluateAnchor(
          subjectCertificate,
          &subjectProfile,
          leaf,
          leafProfile,
          intermediates,
          &path,
          anchors,
          anchorIndex,
          &mut counters,
          limits,
        )
        match move evaluated {
          AnchorCandidate.Unlinked => {}
          AnchorCandidate.Rejected {error} => {
            hasLinked = true
            if error.kind == ValidationClass.ResourceLimit {
              return validationFailure<ValidatedPath<'a>>(move error)
            }
            let ignored = remember(move error, &mut hasFirst, &mut first)
          }
          AnchorCandidate.Accepted => {
            return Result.succeed<ValidatedPath<'a>, ValidationError>(
              ValidatedPath<'a> {
                leafValue: leaf,
                intermediateIndices: move path,
                anchorIndexValue: anchorIndex,
                validationTimeValue: SystemClock.make(
                  SystemClock.seconds(at),
                  SystemClock.nanoseconds(at),
                ),
              },
            )
          }
        }
      }

      while frame.nextAnchor >= anchors.length
        && frame.nextIntermediate < intermediates.length
        && !descended {
        let candidateIndex = frame.nextIntermediate
        frame.nextIntermediate = frame.nextIntermediate + 1
        Vector.set<Frame>(&mut frames, depth, frame)
        let visited = consume(
          &mut counters.issuers,
          limits.issuerCandidates,
          ValidationLimit.IssuerCandidates,
        )
        match move visited {
          Result<(), ValidationError>.Failure {error} => {
            return validationFailure<ValidatedPath<'a>>(move error)
          }
          Result<(), ValidationError>.Success {value: intermediateVisitAccepted} => {}
        }
        let evaluated = evaluateIntermediate(
          subjectCertificate,
          &subjectProfile,
          leaf,
          intermediates,
          &path,
          candidateIndex,
          depth,
          at,
          &mut counters,
          limits,
        )
        match move evaluated {
          IntermediateCandidate.Unlinked => {}
          IntermediateCandidate.Rejected {error} => {
            hasLinked = true
            if error.kind == ValidationClass.ResourceLimit {
              return validationFailure<ValidatedPath<'a>>(move error)
            }
            let ignored = remember(move error, &mut hasFirst, &mut first)
          }
          IntermediateCandidate.Descend => {
            hasLinked = true
            let addedPath = run Vector.append<usize>(&mut path, candidateIndex)
            let addedFrame = run Vector.append<Frame>(
              &mut frames,
              Frame {nextAnchor: usize.ZERO, nextIntermediate: usize.ZERO},
            )
            descended = true
          }
        }
      }

      if !descended {
        let removedFrame = Vector.pop<Frame>(&mut frames)
        if Vector.length<usize>(&path) > 0 { let removedPath = Vector.pop<usize>(&mut path) }
      }
    }

    if hasFirst { return validationFailure<ValidatedPath<'a>>(rejected(move first)) }
    let mut reason = ValidationReason.NoIssuer
    if hasLinked { reason = ValidationReason.NoValidPath }
    return validationFailure<ValidatedPath<'a>>(validationError(
      ValidationClass.Rejected,
      reason,
      ValidationLocation.Call,
      noExtension(),
      noLimit(),
      0,
    ))
  }
}
