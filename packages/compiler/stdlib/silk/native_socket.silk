unsafe fn currentError() -> i32 {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    unsafe { return Pointer.read<i32>(__error()) }
  } else {
    unsafe { return Pointer.read<i32>(__errno_location()) }
  }
}
unsafe fn closeSocket(fd: i32) -> i32 {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    return unsafe darwinCloseSocket(fd)
  } else {
    return unsafe gnuCloseSocket(fd)
  }
}
fn socketType() -> i32 {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    return STREAM_SOCKET
  } else {
    return i32.bitOr(STREAM_SOCKET, i32.bitOr(nativeNonblock(), nativeCloseOnExec()))
  }
}
fn sendFlags() -> i32 {
  static if Intrinsic.targetOperatingSystem() == "darwin" { return 0 } else { return 16384 }
}
fn unixCapacity() -> usize {
  static if Intrinsic.targetOperatingSystem() == "darwin" { return 104 } else { return 108 }
}

