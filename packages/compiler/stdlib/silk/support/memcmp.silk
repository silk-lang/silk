//! Word-wise compiler support with explicit C linkage and no runtime services.

import silk.pointer { Pointer }

/// Compares unsigned bytes and returns zero, a negative value, or a positive value.
///
/// # Details
///
/// The first unequal byte determines the sign. Zero-length ranges compare equal. Equal leading
/// words are skipped eight bytes at a time; the remaining bytes, including any unequal word,
/// compare one at a time.
///
/// # Gotchas
///
/// The caller must provide live readable ranges of `count` bytes.
export "C" fn memcmp(left: ?[*]const u8, right: ?[*]const u8, count: usize) -> i32 {
  if count == 0 { return 0 }
  unsafe {
    let first = Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(left)
    let second = Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(right)
    let mut index: usize = 0
    while count - index >= 8 && Pointer.readUnaligned<u64>(wordAt(first, index)) == Pointer.readUnaligned<u64>(wordAt(second, index)) {
      index = index + 8
    }
    while index < count {
      let a = Pointer.read<u8>(Pointer.at<u8>(first, index))
      let b = Pointer.read<u8>(Pointer.at<u8>(second, index))
      if a < b { return -1 }
      if a > b { return 1 }
      index = index + 1
    }
    return 0
  }
}

unsafe fn wordAt(base: [*]const u8, index: usize) -> *const align(1) u64 {
  unsafe { return Intrinsic.pointerReinterpret<*const u8, *const align(1) u64>(Pointer.at<u8>(base, index)) }
}
