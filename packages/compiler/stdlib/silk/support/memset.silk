//! Word-wise compiler support with explicit C linkage and no runtime services.

import silk.pointer { Pointer }

/// Writes the low eight bits of `value` to `count` bytes and returns the destination.
///
/// # Details
///
/// The byte is repeated across a word and written eight bytes at a time through unaligned word
/// accesses, then one byte at a time for the tail.
///
/// # Gotchas
///
/// The caller must provide a live writable destination range of `count` bytes.
export "C" fn memset(destination: ?[*]mut u8, value: i32, count: usize) -> ?[*]mut u8 {
  if count == 0 { return destination }
  unsafe {
    let output = Intrinsic.pointerRequalify<?[*]mut u8, [*]mut u8>(destination)
    let byte = Intrinsic.i32ToU8(value & 255)
    // Every byte of 0x0101010101010101 is one, so the product repeats `byte` without overflow.
    let ones: u64 = 72340172838076673
    let word = Intrinsic.u8ToU64(byte) * ones
    let mut index: usize = 0
    while count - index >= 8 {
      Pointer.writeUnaligned<u64>(wordAtMut(output, index), word)
      index = index + 8
    }
    while index < count {
      Pointer.write<u8>(Pointer.atMut<u8>(output, index), byte)
      index = index + 1
    }
    return destination
  }
}

unsafe fn wordAtMut(base: [*]mut u8, index: usize) -> *mut align(1) u64 {
  unsafe { return Intrinsic.pointerReinterpret<*mut u8, *mut align(1) u64>(Pointer.atMut<u8>(base, index)) }
}
