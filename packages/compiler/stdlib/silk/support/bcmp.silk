//! Word-wise compiler support with explicit C linkage and no runtime services.

import silk.pointer { Pointer }

/// Returns zero for equal byte ranges and a nonzero value for unequal ranges.
///
/// # Details
///
/// The result has no promised ordering. Zero-length ranges compare equal. Bytes compare eight at
/// a time through unaligned word accesses, then one at a time for the tail.
///
/// # Gotchas
///
/// The caller must provide live readable ranges of `count` bytes.
export "C" fn bcmp(left: ?[*]const u8, right: ?[*]const u8, count: usize) -> i32 {
  if count == 0 { return 0 }
  unsafe {
    let first = Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(left)
    let second = Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(right)
    let mut index: usize = 0
    while count - index >= 8 {
      if Pointer.readUnaligned<u64>(wordAt(first, index)) != Pointer.readUnaligned<u64>(wordAt(second, index)) { return 1 }
      index = index + 8
    }
    while index < count {
      if Pointer.read<u8>(Pointer.at<u8>(first, index)) != Pointer.read<u8>(Pointer.at<u8>(second, index)) { return 1 }
      index = index + 1
    }
    return 0
  }
}

unsafe fn wordAt(base: [*]const u8, index: usize) -> *const align(1) u64 {
  unsafe { return Intrinsic.pointerReinterpret<*const u8, *const align(1) u64>(Pointer.at<u8>(base, index)) }
}
