//! Byte-wise compiler support with explicit C linkage and no runtime services.

import silk.pointer { Pointer }

/// Returns zero for equal byte ranges and a nonzero value for unequal ranges.
///
/// # Details
///
/// The result has no promised ordering. Zero-length ranges compare equal.
///
/// # Gotchas
///
/// The caller must provide live readable ranges of `count` bytes.
export "C" fn bcmp(left: ?[*]const u8, right: ?[*]const u8, count: usize) -> i32 {
  if count == 0 { return 0 }
  unsafe {
    let first = Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(left)
    let second = Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(right)
    let mut index: usize = 0
    while index < count {
      let a = Pointer.read<u8>(Pointer.at<u8>(first, index))
      let b = Pointer.read<u8>(Pointer.at<u8>(second, index))
      if a < b { return -1 }
      if a > b { return 1 }
      index = index + 1
    }
    return 0
  }
}
