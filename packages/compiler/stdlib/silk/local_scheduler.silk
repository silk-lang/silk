//! Deterministic single-threaded execution for structured Fibers.
//!
//! # When to use
//! Use [`execute`] at an application entry point to run one lazy program that uses the
//! `silk.scheduler.Scheduler` and `silk.monotonic_clock.MonotonicClock` services.
//!
//! # Details
//! Each call creates fresh task storage, a FIFO ready queue, and a private timer source. The root is
//! task zero and uses the same `Execution<()>` storage as every child. Task clock waits park only
//! their task; the driver uses the parent clock when its event sources need to wait. [`execute`]
//! returns only after the root terminates.

import silk.allocator { Allocator, OutOfMemoryError }
import silk.box { Box }
import silk.effect { Effect }
import silk.execution { Execution, Wake }
import silk.fiber { Fiber, CompletionCanceller, CompletionProducer, PreparedFiber }
import silk.hash { Hash }
import silk.hash_map { HashMap }
import silk.i64
import silk.monotonic_clock { MonotonicClock }
import silk.option { Option }
import silk.result { Result }
import silk.scheduler { Scheduler, NoRequest, NoSubmission, PendingPublication, PendingRequest, PendingSubmission, PreparedTask, PublicationResponse, ResponsePublished, ResponseRejected, ResponseWaiting, SubmissionSlot, TaskId, TaskIdExhaustedError, TaskMailbox }
import silk.shared { Shared }
import silk.system_clock { SystemClock }
import silk.system_clock { Instant }
import silk.u64
import silk.usize
import silk.vector { Vector }

/// A reusable deterministic single-threaded Scheduler provider.
///
/// # Details
///
/// Each call to [`execute`] creates fresh task storage and readiness state.
pub struct LocalScheduler {}

impl LocalScheduler {
  /// Constructs a reusable local Scheduler value.
  pub fn make() -> LocalScheduler {
    return LocalScheduler {}
  }

  /// Runs one lazy root program under this Scheduler and returns its typed outcome.
  ///
  /// # Details
  ///
  /// The root becomes task zero. This operation owns all per-run task and timer storage, provides
  /// distinct Scheduler and MonotonicClock clients to each task, and dispatches ready tasks in FIFO
  /// order. Task clock reads use one cached mark per driver turn. Future waits suspend their task and
  /// are resumed in deadline and registration order. When the ready queue is empty, the driver waits
  /// through its required parent MonotonicClock for the earliest timer; it raises [`StalledError`]
  /// only when no task is ready and no timer registration remains. Before any typed return or failure,
  /// it cancels every unfinished descendant and releases the complete run state.
  pub effect fn execute<A: 'static, E: 'static>(
    self: &mut Self,
    program: once Effect<'static;
      A
      ! E
      ? &mut Scheduler | &mut MonotonicClock
    >,
  ) -> A
  ! E | OutOfMemoryError | StalledError
  ? &mut MonotonicClock {
    let parentResolution = run MonotonicClock.getResolution()
    let resolution = requirePositiveResolution(parentResolution)
    let initialMark = run MonotonicClock.now()
    let initialSeconds = SystemClock.seconds(&initialMark)
    let initialNanoseconds = SystemClock.nanoseconds(&initialMark)
    drop initialMark
    let mut allocator = Allocator.systemAllocatorProvider()
    let queue = run Shared.make<ReadyQueue>(ReadyQueue {
      head: NoLink {},
      tail: NoLink {},
    }) |> Effect.provideMut<Allocator>(&mut allocator)
    let clock = run Shared.make<ClockState>(ClockState {
      seconds: initialSeconds,
      nanoseconds: initialNanoseconds,
      resolution: resolution,
    }) |> Effect.provideMut<Allocator>(&mut allocator)
    let timerInbox = run Shared.make<TimerRequestInbox>(TimerRequestInbox {
      request: NoTimerRequest {},
    }) |> Effect.provideMut<Allocator>(&mut allocator)
    let identities = TaskIdSource { next: 1, exhausted: false }
    let contextValue = TaskContext {
      identities: move identities,
      clock: Shared.clone<ClockState>(&clock),
      timerInbox: Shared.clone<TimerRequestInbox>(&timerInbox),
    }
    let context = run Shared.make<TaskContext>(move contextValue)
      |> Effect.provideMut<Allocator>(&mut allocator)
    let prepared = run Fiber.prepare<RootTaskCompleted, RootTaskNeverFailed>()
      |> Effect.provideMut<Allocator>(&mut allocator)
    let rootState = run Shared.make<RootState<A, E>>(RootState<A, E> {
      phase: RootPending {},
    }) |> Effect.provideMut<Allocator>(&mut allocator)
    let response = run Shared.make<PublicationResponse>(PublicationResponse {
      phase: ResponseWaiting {},
    }) |> Effect.provideMut<Allocator>(&mut allocator)
    let submission = run Shared.make<SubmissionSlot>(SubmissionSlot {
      phase: NoSubmission {},
    }) |> Effect.provideMut<Allocator>(&mut allocator)
    let mailboxResponse = Shared.clone<PublicationResponse>(&response)
    let mailbox = run Shared.make<TaskMailbox>(TaskMailbox {
      request: NoRequest {},
      response: move mailboxResponse,
    }) |> Effect.provideMut<Allocator>(&mut allocator)
    let root = TaskId { value: 0 }
    let node = run Shared.make<ReadyNode>(ReadyNode {
      identity: root,
      next: NoLink {},
      enqueued: false,
    }) |> Effect.provideMut<Allocator>(&mut allocator)
    let PreparedFiber<RootTaskCompleted, RootTaskNeverFailed> {
      producer,
      canceller,
      fiber: rootFiber,
    } = move prepared
    drop rootFiber
    let client = SchedulerClient {
      identity: root,
      mailbox: Shared.clone<TaskMailbox>(&mailbox),
      submission: Shared.clone<SubmissionSlot>(&submission),
      response: move response,
      context: move context,
      queue: Shared.clone<ReadyQueue>(&queue),
    }
    let rootClock = TaskClockClient {
      clock: Shared.clone<ClockState>(&clock),
      inbox: Shared.clone<TimerRequestInbox>(&timerInbox),
    }
    let endpoint = ReadyEndpoint {
      queue: Shared.clone<ReadyQueue>(&queue),
      node: move node,
    }
    let execution = run Execution.make(
      runRoot<A, E>(
        move program,
        move client,
        move rootClock,
        Shared.clone<RootState<A, E>>(&rootState),
        move producer,
      ),
      move endpoint,
      notifyReady,
    ) |> Effect.provideMut<Allocator>(&mut allocator)
    let entry = TaskEntry {
      parent: NoLink {},
      firstChild: NoLink {},
      nextSibling: NoLink {},
      cancellationNext: NoLink {},
      phase: Initial {},
      execution: StoredExecution { execution: move execution },
      cancellation: CompletionCancellation {
        phase: CancellationAvailable { canceller: move canceller },
      },
      mailbox: move mailbox,
      submission: move submission,
      nextRegistrationGeneration: u64.MIN,
      registrationGenerationExhausted: false,
      registration: RegistrationIdle {},
    }
    let driverValue = Driver {
      store: TaskStore {
        timers: Vector.make<TimerEntry>(),
        tasks: HashMap.make<TaskId, TaskEntry>(Hash.seed(0)),
        nextTimerOrder: u64.MIN,
        timerOrderExhausted: false,
      },
      queue: move queue,
      current: root,
      cancellationHead: NoLink {},
      rootComplete: false,
      clock: move clock,
      timerInbox: move timerInbox,
    }
    let mut boxedDriver = run Box.make<Driver>(move driverValue)
      |> Effect.provideMut<Allocator>(&mut allocator)
    let mut drivers = Box.getMut<Driver>(&mut boxedDriver)
    run initializeDriver(&mut drivers[0], root, move entry)
      |> Effect.provideMut<Allocator>(&mut allocator)
    run driveUntilRoot(move boxedDriver)
    let mut extraction = RootExtraction<A, E> { phase: RootPending {} }
    let extracted = Shared.withMut(&rootState, extractRoot<A, E>(&mut extraction))
    let RootExtraction<A, E> { phase: selected } = move extraction
    drop rootState
    return run finishRoot<A, E>(move selected)
  }
}

/// Reports that no task is ready and no event registration remains while the root is incomplete.
///
/// # Details
///
/// [`execute`] cancels and releases the incomplete task tree before it raises this error.
pub struct StalledError {}

struct NoLink {}
struct TaskLink { identity: TaskId }
impl Copy for NoLink {}
impl Copy for TaskLink {}

struct ReadyNode {
  identity: TaskId
  next: NoLink | ReadyNodeLink
  enqueued: bool
}

struct ReadyNodeLink { node: Shared<ReadyNode> }
struct ReadyQueue {
  head: NoLink | ReadyNodeLink
  tail: NoLink | ReadyNodeLink
}

struct ReadyEndpoint {
  queue: Shared<ReadyQueue>
  node: Shared<ReadyNode>
}

fn claimReady(node: &mut ReadyNode) -> bool {
  if node.enqueued { return false }
  node.enqueued = true
  return true
}

fn linkReady(node: &mut ReadyNode, next: Shared<ReadyNode>) -> () {
  let previous = Intrinsic.replace(node.next, ReadyNodeLink { node: move next })
  drop previous
  return ()
}

fn installFirst(queue: &mut ReadyQueue, node: Shared<ReadyNode>) -> () {
  queue.head = ReadyNodeLink { node: move node }
  return ()
}

fn installAfter(previous: Shared<ReadyNode>, node: Shared<ReadyNode>) -> () {
  let installed = Shared.withMut(&previous, linkReady(move node))
  drop previous
  return ()
}

fn appendReady(queue: &mut ReadyQueue, node: Shared<ReadyNode>) -> () {
  let accepted = Shared.withMut<ReadyNode, bool>(&node, claimReady)
  if !accepted { drop node return () }
  let retained = Shared.clone<ReadyNode>(&node)
  let previous = Intrinsic.replace(queue.tail, ReadyNodeLink { node: move retained })
  return match move previous {
    NoLink {} => installFirst(move queue, move node)
    ReadyNodeLink { node: tail } => installAfter(move tail, move node)
  }
}

fn notifyReady(endpoint: &ReadyEndpoint) -> () {
  let queue = Shared.clone<ReadyQueue>(&endpoint.queue)
  let node = Shared.clone<ReadyNode>(&endpoint.node)
  let appended = Shared.withMut(&queue, appendReady(move node))
  drop queue
  return ()
}

fn takeNext(node: &mut ReadyNode) -> NoLink | ReadyNodeLink {
  return Intrinsic.replace(node.next, NoLink {})
}

fn clearTail(queue: &mut ReadyQueue) -> () {
  let previous = Intrinsic.replace(queue.tail, NoLink {})
  drop previous
  return ()
}

fn advanceHead(queue: &mut ReadyQueue, next: NoLink | ReadyNodeLink) -> () {
  return match move next {
    NoLink {} => clearTail(move queue)
    ReadyNodeLink { node } => installFirst(move queue, move node)
  }
}

fn takeLinked(
  queue: &mut ReadyQueue,
  node: Shared<ReadyNode>,
) -> NoLink | ReadyNodeLink {
  let next = Shared.withMut(&node, takeNext)
  advanceHead(move queue, move next)
  return ReadyNodeLink { node: move node }
}

fn takeHead(queue: &mut ReadyQueue) -> NoLink | ReadyNodeLink {
  let selected = Intrinsic.replace(queue.head, NoLink {})
  return match move selected {
    NoLink {} => NoLink {}
    ReadyNodeLink { node } => takeLinked(move queue, move node)
  }
}

fn releaseReady(node: &mut ReadyNode) -> TaskId {
  node.enqueued = false
  return node.identity
}

struct QueueEmpty {}
struct ReadyIdentity { identity: TaskId }

fn releaseSelected(node: Shared<ReadyNode>) -> ReadyIdentity {
  let identity = Shared.withMut<ReadyNode, TaskId>(&node, releaseReady)
  drop node
  return ReadyIdentity { identity: identity }
}

fn takeReady(queue: &Shared<ReadyQueue>) -> QueueEmpty | ReadyIdentity {
  let selected = Shared.withMut(queue, takeHead)
  return match move selected {
    NoLink {} => QueueEmpty {}
    ReadyNodeLink { node } => releaseSelected(move node)
  }
}

struct TaskIdSource { next: u64 exhausted: bool }
struct TaskContext {
  identities: TaskIdSource
  clock: Shared<ClockState>
  timerInbox: Shared<TimerRequestInbox>
}
struct ReservedIdentity { identity: TaskId }
struct Reserved {
  identity: TaskId
  clock: Shared<ClockState>
  timerInbox: Shared<TimerRequestInbox>
}
struct Refused {}

fn reserveIdentityStep(source: &mut TaskIdSource) -> ReservedIdentity | Refused {
  if source.exhausted { return Refused {} }
  let selected = source.next
  if selected == u64.MAX { source.exhausted = true } else { source.next = selected + 1 }
  return ReservedIdentity { identity: TaskId { value: selected } }
}

fn reserveStep(source: &mut TaskContext) -> Reserved | Refused {
  let selected = reserveIdentityStep(&mut source.identities)
  return match move selected {
    Refused {} => Refused {}
    ReservedIdentity { identity } => Reserved {
      identity: identity,
      clock: Shared.clone<ClockState>(&source.clock),
      timerInbox: Shared.clone<TimerRequestInbox>(&source.timerInbox),
    }
  }
}

effect fn exhaustedReservation() -> Reserved ! TaskIdExhaustedError {
  fail TaskIdExhaustedError {}
}

effect fn reserve(source: &Shared<TaskContext>) -> Reserved
! TaskIdExhaustedError {
  let selected = Shared.withMut<TaskContext, Reserved | Refused>(source, reserveStep)
  return match move selected {
    Reserved { identity, clock, timerInbox } => Reserved {
      identity: identity,
      clock: move clock,
      timerInbox: move timerInbox,
    }
    Refused {} => run exhaustedReservation()
  }
}

struct ClockState {
  seconds: i64
  nanoseconds: i64
  resolution: u64
}

struct ClockSnapshot {
  seconds: i64
  nanoseconds: i64
  resolution: u64
}

impl Copy for ClockSnapshot {}

fn snapshotClock(state: &ClockState) -> ClockSnapshot {
  return ClockSnapshot {
    seconds: state.seconds,
    nanoseconds: state.nanoseconds,
    resolution: state.resolution,
  }
}

fn replaceClock(state: &mut ClockState, mark: &Instant) -> () {
  state.seconds = SystemClock.seconds(mark)
  state.nanoseconds = SystemClock.nanoseconds(mark)
  return ()
}

struct NoTimerRequest {}
struct AbsoluteTimerRequest { deadline: Instant wake: Wake }
struct RelativeTimerRequest { duration: u64 wake: Wake }

struct TimerRequestInbox {
  request: NoTimerRequest | AbsoluteTimerRequest | RelativeTimerRequest
}

struct TimerWaitGuard {}
struct AbsoluteWaitRegistration {
  inbox: Shared<TimerRequestInbox>
  deadline: Instant
}
struct RelativeWaitRegistration {
  inbox: Shared<TimerRequestInbox>
  duration: u64
}

fn installAbsoluteRequest(
  inbox: &mut TimerRequestInbox,
  deadline: Instant,
  wake: Wake,
) -> () {
  let previous = Intrinsic.replace(
    inbox.request,
    AbsoluteTimerRequest { deadline: move deadline, wake: move wake },
  )
  return match move previous {
    NoTimerRequest {} => ()
    AbsoluteTimerRequest { deadline: retainedDeadline, wake: retainedWake } =>
      duplicateTimerRequest(move retainedDeadline, move retainedWake)
    RelativeTimerRequest { duration: retainedDuration, wake: retainedWake } =>
      duplicateRelativeTimerRequest(retainedDuration, move retainedWake)
  }
}

fn installRelativeRequest(
  inbox: &mut TimerRequestInbox,
  duration: u64,
  wake: Wake,
) -> () {
  let previous = Intrinsic.replace(
    inbox.request,
    RelativeTimerRequest { duration: duration, wake: move wake },
  )
  return match move previous {
    NoTimerRequest {} => ()
    AbsoluteTimerRequest { deadline: retainedDeadline, wake: retainedWake } =>
      duplicateTimerRequest(move retainedDeadline, move retainedWake)
    RelativeTimerRequest { duration: retainedDuration, wake: retainedWake } =>
      duplicateRelativeTimerRequest(retainedDuration, move retainedWake)
  }
}

fn duplicateTimerRequest(deadline: Instant, wake: Wake) -> () {
  drop deadline
  drop wake
  let invalid = 1 / 0
  return ()
}

fn duplicateRelativeTimerRequest(duration: u64, wake: Wake) -> () {
  drop duration
  drop wake
  let invalid = 1 / 0
  return ()
}

fn registerAbsoluteWait(
  wake: Wake,
  registration: AbsoluteWaitRegistration,
) -> TimerWaitGuard {
  let AbsoluteWaitRegistration { inbox, deadline } = move registration
  let installed = Shared.withMut(&inbox, installAbsoluteRequest(move deadline, move wake))
  drop inbox
  return TimerWaitGuard {}
}

fn registerRelativeWait(
  wake: Wake,
  registration: RelativeWaitRegistration,
) -> TimerWaitGuard {
  let RelativeWaitRegistration { inbox, duration } = move registration
  let installed = Shared.withMut(&inbox, installRelativeRequest(duration, move wake))
  drop inbox
  return TimerWaitGuard {}
}

fn reached(state: &ClockState, deadline: &Instant) -> bool {
  let seconds = SystemClock.seconds(deadline)
  if seconds < state.seconds { return true }
  if seconds > state.seconds { return false }
  return SystemClock.nanoseconds(deadline) <= state.nanoseconds
}

struct TaskClockClient {
  clock: Shared<ClockState>
  inbox: Shared<TimerRequestInbox>
}

impl TaskClockClient {
  effect fn taskNow(self: &mut Self) -> Instant {
    let seen = Shared.with<ClockState, ClockSnapshot>(&self.clock, snapshotClock)
    return SystemClock.make(seen.seconds, seen.nanoseconds)
  }

  effect fn taskResolution(self: &mut Self) -> u64 {
    let seen = Shared.with<ClockState, ClockSnapshot>(&self.clock, snapshotClock)
    return seen.resolution
  }

  effect fn taskWaitUntil(self: &mut Self, deadline: Instant) -> () {
    let alreadyReached = Shared.with<ClockState, bool>(&self.clock, reached(&deadline))
    if alreadyReached { drop deadline return () }
    let registration = AbsoluteWaitRegistration {
      inbox: Shared.clone<TimerRequestInbox>(&self.inbox),
      deadline: move deadline,
    }
    return run Execution.park(registerAbsoluteWait(move registration))
  }

  effect fn taskWaitFor(self: &mut Self, duration: u64) -> () {
    if duration == u64.MIN { return () }
    let registration = RelativeWaitRegistration {
      inbox: Shared.clone<TimerRequestInbox>(&self.inbox),
      duration: duration,
    }
    return run Execution.park(registerRelativeWait(move registration))
  }
}

impl MonotonicClock for TaskClockClient {
  now: TaskClockClient.taskNow
  getResolution: TaskClockClient.taskResolution
  waitUntil: TaskClockClient.taskWaitUntil
  waitFor: TaskClockClient.taskWaitFor
}

struct SchedulerClient {
  identity: TaskId
  mailbox: Shared<TaskMailbox>
  submission: Shared<SubmissionSlot>
  response: Shared<PublicationResponse>
  context: Shared<TaskContext>
  queue: Shared<ReadyQueue>
}

fn publishTaskResult<A, E>(
  result: Result<A, E>,
  producer: CompletionProducer<A, E>,
) -> () {
  return match move result {
    Result<A, E>.Success { value: success } => Fiber.completeSuccess<A, E>(move producer, move success)
    Result<A, E>.Failure { error } => Fiber.completeFailure<A, E>(move producer, move error)
  }
}

effect<'static> fn runTask<A: 'static, E: 'static>(
  body: once Effect<'static;
    A
    ! E
    ? &mut Scheduler | &mut MonotonicClock
  >,
  client: SchedulerClient,
  clock: TaskClockClient,
  producer: CompletionProducer<A, E>,
) -> () {
  let mut scheduler = move client
  let mut taskClock = move clock
  let timed = Effect.provideMut<MonotonicClock>(
    move body,
    &mut taskClock,
  )
  let scheduled = Effect.provideMut<Scheduler>(
    Effect.result(move timed),
    &mut scheduler,
  )
  let result = run move scheduled
  drop scheduler
  drop taskClock
  publishTaskResult<A, E>(move result, move producer)
  return ()
}

struct RootPending {}
struct RootReady<A, E> { result: Result<A, E> }
struct RootState<A, E> { phase: RootPending | RootReady<A, E> }
struct RootTaskCompleted {}
struct RootTaskNeverFailed {}

fn storeRoot<A, E>(state: &mut RootState<A, E>, result: Result<A, E>) -> () {
  let previous = Intrinsic.replace(state.phase, RootReady<A, E> { result: move result })
  drop previous
  return ()
}

fn takeRoot<A, E>(state: &mut RootState<A, E>) -> RootPending | RootReady<A, E> {
  return Intrinsic.replace(state.phase, RootPending {})
}

struct RootExtraction<A, E> { phase: RootPending | RootReady<A, E> }

fn extractRoot<A, E>(state: &mut RootState<A, E>, output: &mut RootExtraction<A, E>) -> () {
  output.phase = Intrinsic.replace(state.phase, RootPending {})
  return ()
}

effect<'static> fn runRoot<A: 'static, E: 'static>(
  body: once Effect<'static;
    A
    ! E
    ? &mut Scheduler | &mut MonotonicClock
  >,
  client: SchedulerClient,
  clock: TaskClockClient,
  state: Shared<RootState<A, E>>,
  producer: CompletionProducer<RootTaskCompleted, RootTaskNeverFailed>,
) -> () {
  let mut scheduler = move client
  let mut taskClock = move clock
  let timed = Effect.provideMut<MonotonicClock>(
    move body,
    &mut taskClock,
  )
  let scheduled = Effect.provideMut<Scheduler>(
    Effect.result(move timed),
    &mut scheduler,
  )
  let result = run move scheduled
  drop scheduler
  drop taskClock
  let stored = Shared.withMut(&state, storeRoot<A, E>(move result))
  drop state
  Fiber.completeSuccess<RootTaskCompleted, RootTaskNeverFailed>(
    move producer,
    RootTaskCompleted {},
  )
  return ()
}

effect fn prepareChild<A: 'static, E: 'static>(
  self: &mut SchedulerClient,
  child: once Effect<'static;
    A
    ! E
    ? &mut Scheduler | &mut MonotonicClock
  >,
) -> PendingPublication<A, E>
! OutOfMemoryError | TaskIdExhaustedError {
  let reserved = run reserve(&self.context)
  let Reserved {
    identity,
    clock: childClock,
    timerInbox: childTimerInbox,
  } = move reserved
  let mut allocator = Allocator.systemAllocatorProvider()
  let prepared = run Fiber.prepare<A, E>() |> Effect.provideMut<Allocator>(&mut allocator)
  let response = run Shared.make<PublicationResponse>(PublicationResponse {
    phase: ResponseWaiting {},
  }) |> Effect.provideMut<Allocator>(&mut allocator)
  let childSubmission = run Shared.make<SubmissionSlot>(SubmissionSlot {
    phase: NoSubmission {},
  }) |> Effect.provideMut<Allocator>(&mut allocator)
  let mailboxResponse = Shared.clone<PublicationResponse>(&response)
  let childMailbox = run Shared.make<TaskMailbox>(TaskMailbox {
    request: NoRequest {},
    response: move mailboxResponse,
  }) |> Effect.provideMut<Allocator>(&mut allocator)
  let node = run Shared.make<ReadyNode>(ReadyNode {
    identity: identity,
    next: NoLink {},
    enqueued: false,
  }) |> Effect.provideMut<Allocator>(&mut allocator)
  let PreparedFiber<A, E> { producer, canceller, fiber } = move prepared
  let client = SchedulerClient {
    identity: identity,
    mailbox: Shared.clone<TaskMailbox>(&childMailbox),
    submission: Shared.clone<SubmissionSlot>(&childSubmission),
    response: move response,
    context: Shared.clone<TaskContext>(&self.context),
    queue: Shared.clone<ReadyQueue>(&self.queue),
  }
  let clock = TaskClockClient {
    clock: move childClock,
    inbox: move childTimerInbox,
  }
  let endpoint = ReadyEndpoint {
    queue: Shared.clone<ReadyQueue>(&self.queue),
    node: move node,
  }
  let execution = run Execution.make(
    runTask<A, E>(move child, move client, move clock, move producer),
    move endpoint,
    notifyReady,
  ) |> Effect.provideMut<Allocator>(&mut allocator)
  let task = PreparedTask {
    identity: identity,
    parent: self.identity,
    execution: move execution,
    canceller: move canceller,
    mailbox: move childMailbox,
    submission: move childSubmission,
  }
  return Scheduler.pending<A, E>(
    move fiber,
    Shared.clone<TaskMailbox>(&self.mailbox),
    Shared.clone<SubmissionSlot>(&self.submission),
    Shared.clone<PublicationResponse>(&self.response),
    move task,
  )
}

impl Scheduler for SchedulerClient { prepare: SchedulerClient.prepareChild }

struct Initial {}
struct Running {}
struct Dormant {}
struct Eligible {}
struct Completed {}
struct NoExecution {}
struct StoredExecution { execution: Intrinsic.Execution<()> }

struct NoTimerInterest {}
struct TimerInterest { index: usize }
struct EventInterests { timer: NoTimerInterest | TimerInterest }

struct RegistrationIdle {}
struct RegistrationArmed {
  generation: u64
  interests: EventInterests
  wake: Wake
}

struct CancellationConsumed {}
struct CancellationAvailable { canceller: CompletionCanceller }
struct CompletionCancellation {
  phase: CancellationConsumed | CancellationAvailable
}

impl Drop for CompletionCancellation {
  fn drop(self: &mut CompletionCancellation) -> () {
    let selected = Intrinsic.replace(self.phase, CancellationConsumed {})
    return finishCompletionCancellation(move selected)
  }
}

fn finishCompletionCancellation(
  selected: CancellationConsumed | CancellationAvailable,
) -> () {
  return match move selected {
    CancellationConsumed {} => ()
    CancellationAvailable { canceller } => Fiber.cancel(move canceller)
  }
}

struct TimerEntry {
  seconds: i64
  nanoseconds: i64
  order: u64
  identity: TaskId
  generation: u64
}

impl Copy for TimerEntry {}

struct TaskEntry {
  parent: NoLink | TaskLink
  firstChild: NoLink | TaskLink
  nextSibling: NoLink | TaskLink
  cancellationNext: NoLink | TaskLink
  phase: Initial | Running | Dormant | Eligible | Completed
  execution: NoExecution | StoredExecution
  cancellation: CompletionCancellation
  mailbox: Shared<TaskMailbox>
  submission: Shared<SubmissionSlot>
  nextRegistrationGeneration: u64
  registrationGenerationExhausted: bool
  registration: RegistrationIdle | RegistrationArmed
}

struct TaskStore {
  timers: Vector<TimerEntry>
  tasks: HashMap<TaskId, TaskEntry>
  nextTimerOrder: u64
  timerOrderExhausted: bool
}

struct Driver {
  store: TaskStore
  queue: Shared<ReadyQueue>
  current: TaskId
  cancellationHead: NoLink | TaskLink
  rootComplete: bool
  clock: Shared<ClockState>
  timerInbox: Shared<TimerRequestInbox>
}

struct DurableDriver { boxed: Box<Driver> }

struct NoGeneration {}
struct ReservedGeneration { value: u64 }
struct GenerationOutput { phase: NoGeneration | ReservedGeneration }

fn reserveRegistrationGeneration(entry: &mut TaskEntry, output: &mut GenerationOutput) -> () {
  if entry.registrationGenerationExhausted {
    let invalid = 1 / 0
    return ()
  }
  let selected = entry.nextRegistrationGeneration
  if selected == u64.MAX {
    entry.registrationGenerationExhausted = true
  } else {
    entry.nextRegistrationGeneration = selected + 1
  }
  output.phase = ReservedGeneration { value: selected }
  return ()
}

fn timerBefore(left: &TimerEntry, right: &TimerEntry) -> bool {
  if left.seconds < right.seconds { return true }
  if left.seconds > right.seconds { return false }
  if left.nanoseconds < right.nanoseconds { return true }
  if left.nanoseconds > right.nanoseconds { return false }
  return left.order < right.order
}

fn updateTimerIndex(entry: &mut TaskEntry, generation: u64, index: usize) -> () {
  let previous = Intrinsic.replace(entry.registration, RegistrationIdle {})
  return match move previous {
    RegistrationIdle {} => ()
    RegistrationArmed { generation: armed, interests, wake } => retainTimerIndex(
      move entry,
      generation,
      index,
      armed,
      move interests,
      move wake,
    )
  }
}

fn retainTimerIndex(
  entry: &mut TaskEntry,
  generation: u64,
  index: usize,
  armed: u64,
  interests: EventInterests,
  wake: Wake,
) -> () {
  let EventInterests { timer } = move interests
  let selected = match move timer {
    NoTimerInterest {} => missingTimerInterest()
    TimerInterest { index: oldIndex } => selectTimerIndex(
      generation,
      index,
      armed,
      oldIndex,
    )
  }
  entry.registration = RegistrationArmed {
    generation: armed,
    interests: EventInterests { timer: TimerInterest { index: selected } },
    wake: move wake,
  }
  return ()
}

fn selectTimerIndex(generation: u64, index: usize, armed: u64, oldIndex: usize) -> usize {
  if armed == generation { return index }
  return oldIndex
}

fn missingTimerInterest() -> usize {
  let invalid = 1 / 0
  return usize.ZERO
}

fn bubbleTimerUp(store: &mut TaskStore, start: usize) -> () {
  let mut index = start
  while index > usize.ZERO {
    let parent = (index - usize.ONE) / 2
    let selected = Vector.get<TimerEntry>(&store.timers, index)
    let previous = Vector.get<TimerEntry>(&store.timers, parent)
    if !timerBefore(&selected, &previous) { return () }
    Vector.set<TimerEntry>(&mut store.timers, index, previous)
    Vector.set<TimerEntry>(&mut store.timers, parent, selected)
    let previousUpdated = HashMap.withMut(
      &mut store.tasks,
      previous.identity,
      updateTimerIndex(previous.generation, index),
    )
    let selectedUpdated = HashMap.withMut(
      &mut store.tasks,
      selected.identity,
      updateTimerIndex(selected.generation, parent),
    )
    index = parent
  }
  return ()
}

fn sinkTimerDown(store: &mut TaskStore, start: usize) -> () {
  let mut index = start
  let length = Vector.length<TimerEntry>(&store.timers)
  let parents = length / 2
  while index < parents {
    let left = index + index + usize.ONE
    let right = left + usize.ONE
    let mut selected = left
    if right < length {
      let leftTimer = Vector.get<TimerEntry>(&store.timers, left)
      let rightTimer = Vector.get<TimerEntry>(&store.timers, right)
      if timerBefore(&rightTimer, &leftTimer) { selected = right }
    }
    let current = Vector.get<TimerEntry>(&store.timers, index)
    let child = Vector.get<TimerEntry>(&store.timers, selected)
    if !timerBefore(&child, &current) { return () }
    Vector.set<TimerEntry>(&mut store.timers, index, child)
    Vector.set<TimerEntry>(&mut store.timers, selected, current)
    let childUpdated = HashMap.withMut(
      &mut store.tasks,
      child.identity,
      updateTimerIndex(child.generation, index),
    )
    let currentUpdated = HashMap.withMut(
      &mut store.tasks,
      current.identity,
      updateTimerIndex(current.generation, selected),
    )
    index = selected
  }
  return ()
}

fn rebalanceTimer(store: &mut TaskStore, index: usize) -> () {
  if index > usize.ZERO {
    let parent = (index - usize.ONE) / 2
    let selected = Vector.get<TimerEntry>(&store.timers, index)
    let previous = Vector.get<TimerEntry>(&store.timers, parent)
    if timerBefore(&selected, &previous) {
      return bubbleTimerUp(move store, index)
    }
  }
  return sinkTimerDown(move store, index)
}

fn removeTimerAt(store: &mut TaskStore, index: usize) -> TimerEntry {
  let length = Vector.length<TimerEntry>(&store.timers)
  if length == usize.ZERO {
    let invalid = 1 / 0
  }
  if length <= index {
    let invalid = 1 / 0
  }
  let selected = Vector.get<TimerEntry>(&store.timers, index)
  let lastIndex = length - usize.ONE
  if index != lastIndex {
    let replacement = Vector.get<TimerEntry>(&store.timers, lastIndex)
    Vector.set<TimerEntry>(&mut store.timers, index, replacement)
    let updated = HashMap.withMut(
      &mut store.tasks,
      replacement.identity,
      updateTimerIndex(replacement.generation, index),
    )
  }
  let removed = Vector.pop<TimerEntry>(&mut store.timers)
  drop removed
  if index < Vector.length<TimerEntry>(&store.timers) {
    return finishRemovedTimer(move store, index, selected)
  }
  return selected
}

fn finishRemovedTimer(
  store: &mut TaskStore,
  index: usize,
  selected: TimerEntry,
) -> TimerEntry {
  rebalanceTimer(move store, index)
  return selected
}

effect fn reserveTimerSlot(store: &mut TaskStore) -> () ! OutOfMemoryError {
  let target = HashMap.length<TaskId, TaskEntry>(&store.tasks) + usize.ONE
  let initialized = Vector.length<TimerEntry>(&store.timers)
  let additional = target - initialized
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Vector.reserve<TimerEntry>(&mut store.timers, additional)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

fn impossibleTimerAllocation(error: OutOfMemoryError) -> () {
  drop error
  let invalid = 1 / 0
  return ()
}

effect fn appendTimerWithoutGrowth(
  timers: &mut Vector<TimerEntry>,
  entry: TimerEntry,
) -> () {
  let mut allocator = Allocator.systemAllocatorProvider()
  let appended = Vector.append<TimerEntry>(move timers, entry)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let outcome = run Effect.result(move appended)
  return match move outcome {
    Result<(), OutOfMemoryError>.Success { value } => finishTimerAppend(move value)
    Result<(), OutOfMemoryError>.Failure { error } => impossibleTimerAllocation(move error)
  }
}

fn finishTimerAppend(value: ()) -> () { drop value return () }

fn installArmedTimer(
  entry: &mut TaskEntry,
  generation: u64,
  index: usize,
  wake: Wake,
) -> () {
  let previous = Intrinsic.replace(entry.registration, RegistrationArmed {
    generation: generation,
    interests: EventInterests { timer: TimerInterest { index: index } },
    wake: move wake,
  })
  return match move previous {
    RegistrationIdle {} => ()
    RegistrationArmed {
      generation: retainedGeneration,
      interests: retainedInterests,
      wake: retainedWake,
    } => rejectDuplicateArmed(
      retainedGeneration,
      move retainedInterests,
      move retainedWake,
    )
  }
}

fn rejectDuplicateArmed(
  generation: u64,
  interests: EventInterests,
  wake: Wake,
) -> () {
  drop generation
  drop interests
  drop wake
  let invalid = 1 / 0
  return ()
}

effect fn armTimer(
  store: &mut TaskStore,
  identity: TaskId,
  deadline: Instant,
  wake: Wake,
) -> () {
  let mut generation = GenerationOutput { phase: NoGeneration {} }
  let found = HashMap.withMut(
    &mut store.tasks,
    identity,
    reserveRegistrationGeneration(&mut generation),
  )
  if !found {
    drop deadline
    drop wake
    return ()
  }
  let GenerationOutput { phase: generationPhase } = move generation
  let selectedGeneration = match move generationPhase {
    NoGeneration {} => missingTimerGeneration()
    ReservedGeneration { value } => value
  }
  if store.timerOrderExhausted {
    let invalid = 1 / 0
  }
  let order = store.nextTimerOrder
  if order == u64.MAX {
    store.timerOrderExhausted = true
  } else {
    store.nextTimerOrder = order + 1
  }
  let timer = TimerEntry {
    seconds: SystemClock.seconds(&deadline),
    nanoseconds: SystemClock.nanoseconds(&deadline),
    order: order,
    identity: identity,
    generation: selectedGeneration,
  }
  drop deadline
  let index = Vector.length<TimerEntry>(&store.timers)
  run appendTimerWithoutGrowth(&mut store.timers, timer)
  let installed = HashMap.withMut(
    &mut store.tasks,
    identity,
    installArmedTimer(selectedGeneration, index, move wake),
  )
  if !installed {
    let invalid = 1 / 0
    return ()
  }
  return bubbleTimerUp(move store, index)
}

fn missingTimerGeneration() -> u64 {
  let invalid = 1 / 0
  return u64.MIN
}

struct RegistrationStateOutput { phase: RegistrationIdle | RegistrationArmed }
struct NoDisarmedWake {}
struct DisarmedWake { wake: Wake }

fn takeRegistrationState(entry: &mut TaskEntry, output: &mut RegistrationStateOutput) -> () {
  output.phase = Intrinsic.replace(entry.registration, RegistrationIdle {})
  return ()
}

fn disarmRegistration(
  store: &mut TaskStore,
  identity: TaskId,
) -> NoDisarmedWake | DisarmedWake {
  let mut selected = RegistrationStateOutput { phase: RegistrationIdle {} }
  let found = HashMap.withMut(
    &mut store.tasks,
    identity,
    takeRegistrationState(&mut selected),
  )
  if !found { drop selected return NoDisarmedWake {} }
  let RegistrationStateOutput { phase } = move selected
  return match move phase {
    RegistrationIdle {} => NoDisarmedWake {}
    RegistrationArmed { generation, interests, wake } => finishDisarm(
      move store,
      identity,
      generation,
      move interests,
      move wake,
    )
  }
}

fn finishDisarm(
  store: &mut TaskStore,
  identity: TaskId,
  generation: u64,
  interests: EventInterests,
  wake: Wake,
) -> NoDisarmedWake | DisarmedWake {
  let EventInterests { timer } = move interests
  return match move timer {
    NoTimerInterest {} => DisarmedWake { wake: move wake }
    TimerInterest { index } => finishDisarmTimer(
      move store,
      identity,
      generation,
      index,
      move wake,
    )
  }
}

fn finishDisarmTimer(
  store: &mut TaskStore,
  identity: TaskId,
  generation: u64,
  index: usize,
  wake: Wake,
) -> NoDisarmedWake | DisarmedWake {
  let removed = removeTimerAt(move store, index)
  if removed.identity.value != identity.value {
    drop wake
    let invalid = 1 / 0
    return NoDisarmedWake {}
  }
  if removed.generation != generation {
    drop wake
    let invalid = 1 / 0
    return NoDisarmedWake {}
  }
  return DisarmedWake { wake: move wake }
}

struct NoClaimedWake {}
struct ClaimedWake { interests: EventInterests wake: Wake }
struct WakeClaim { phase: NoClaimedWake | ClaimedWake }

fn claimTimerWake(entry: &mut TaskEntry, generation: u64, output: &mut WakeClaim) -> () {
  let previous = Intrinsic.replace(entry.registration, RegistrationIdle {})
  return match move previous {
    RegistrationIdle {} => ()
    RegistrationArmed { generation: armed, interests, wake } => finishTimerClaim(
      move entry,
      generation,
      armed,
      move interests,
      move wake,
      move output,
    )
  }
}

fn finishTimerClaim(
  entry: &mut TaskEntry,
  generation: u64,
  armed: u64,
  interests: EventInterests,
  wake: Wake,
  output: &mut WakeClaim,
) -> () {
  if armed == generation {
    output.phase = ClaimedWake { interests: move interests, wake: move wake }
    return ()
  }
  entry.registration = RegistrationArmed {
    generation: armed,
    interests: move interests,
    wake: move wake,
  }
  return ()
}

fn completeTimer(store: &mut TaskStore, timer: TimerEntry) -> () {
  let mut claim = WakeClaim { phase: NoClaimedWake {} }
  let found = HashMap.withMut(
    &mut store.tasks,
    timer.identity,
    claimTimerWake(timer.generation, &mut claim),
  )
  let WakeClaim { phase } = move claim
  return match move phase {
    NoClaimedWake {} => ()
    ClaimedWake { interests, wake } => completeClaimedTimer(move interests, move wake)
  }
}

fn completeClaimedTimer(interests: EventInterests, wake: Wake) -> () {
  let EventInterests { timer } = move interests
  drop timer
  return Execution.wake(move wake)
}

fn dueAt(timer: &TimerEntry, mark: &ClockSnapshot) -> bool {
  if timer.seconds < mark.seconds { return true }
  if timer.seconds > mark.seconds { return false }
  return timer.nanoseconds <= mark.nanoseconds
}

fn drainDueTimers(driver: &mut Driver) -> () {
  let mark = Shared.with<ClockState, ClockSnapshot>(&driver.clock, snapshotClock)
  let mut collecting = true
  while collecting && Vector.length<TimerEntry>(&driver.store.timers) > usize.ZERO {
    let earliest = Vector.get<TimerEntry>(&driver.store.timers, usize.ZERO)
    if dueAt(&earliest, &mark) {
      let selected = removeTimerAt(&mut driver.store, usize.ZERO)
      completeTimer(&mut driver.store, selected)
    } else {
      collecting = false
    }
  }
  return ()
}

fn takeTimerRequest(
  inbox: &mut TimerRequestInbox,
) -> NoTimerRequest | AbsoluteTimerRequest | RelativeTimerRequest {
  return Intrinsic.replace(inbox.request, NoTimerRequest {})
}

effect fn processTimerRequest(
  store: &mut TaskStore,
  identity: TaskId,
  request: NoTimerRequest | AbsoluteTimerRequest | RelativeTimerRequest,
) -> ()
? &mut MonotonicClock {
  return match move request {
    NoTimerRequest {} => ()
    AbsoluteTimerRequest { deadline, wake } => run armTimer(
      move store,
      identity,
      move deadline,
      move wake,
    )
    RelativeTimerRequest { duration, wake } => run armRelativeTimer(
      move store,
      identity,
      duration,
      move wake,
    )
  }
}

effect fn armRelativeTimer(
  store: &mut TaskStore,
  identity: TaskId,
  duration: u64,
  wake: Wake,
) -> () ? &mut MonotonicClock {
  let start = run MonotonicClock.now()
  let deadline = MonotonicClock.deadlineAfter(&start, duration)
  return run armTimer(move store, identity, move deadline, move wake)
}

effect fn refreshClock(driver: &mut Driver) -> ()
? &mut MonotonicClock {
  let mark = run MonotonicClock.now()
  let refreshed = Shared.withMut(&driver.clock, replaceClock(&mark))
  drop mark
  return ()
}

struct NoTimerDeadline {}
struct TimerDeadline { value: Instant }

fn earliestTimer(driver: &Driver) -> NoTimerDeadline | TimerDeadline {
  if Vector.length<TimerEntry>(&driver.store.timers) == usize.ZERO {
    return NoTimerDeadline {}
  }
  let timer = Vector.get<TimerEntry>(&driver.store.timers, usize.ZERO)
  return TimerDeadline { value: SystemClock.make(timer.seconds, timer.nanoseconds) }
}

effect fn waitUntilTimer(value: Instant) -> ()
? &mut MonotonicClock {
  run MonotonicClock.waitUntil(move value)
  return ()
}

struct Extraction { slot: NoExecution | StoredExecution }

fn extract(entry: &mut TaskEntry, output: &mut Extraction) -> () {
  output.slot = Intrinsic.replace(entry.execution, NoExecution {})
  entry.phase = Running {}
  return ()
}

fn markEligible(entry: &mut TaskEntry) -> () {
  entry.phase = Eligible {}
  return ()
}

fn restore(entry: &mut TaskEntry, execution: Intrinsic.Execution<()>) -> () {
  entry.execution = StoredExecution { execution: move execution }
  entry.phase = Dormant {}
  return ()
}

fn notifyStoredInitial(
  entry: &mut TaskEntry,
  execution: Intrinsic.Execution<()>,
) -> () {
  let mut selected = move execution
  Execution.notifyInitial(&mut selected)
  entry.execution = StoredExecution { execution: move selected }
  entry.phase = Eligible {}
  return ()
}

fn notifyInitialEntry(entry: &mut TaskEntry) -> () {
  let selected = Intrinsic.replace(entry.execution, NoExecution {})
  return match move selected {
    NoExecution {} => missingInitialExecution()
    StoredExecution { execution } => notifyStoredInitial(move entry, move execution)
  }
}

fn missingInitialExecution() -> () {
  let invalid = 1 / 0
  return missingInitialExecution()
}

fn markCompleted(entry: &mut TaskEntry, result: ()) -> () {
  drop result
  entry.phase = Completed {}
  return ()
}

struct ActivationState {
  slot: NoExecution | StoredExecution
  completed: bool
}

fn suspended(state: &mut ActivationState, execution: Intrinsic.Execution<()>) -> () {
  state.slot = StoredExecution { execution: move execution }
  return ()
}

fn completed(state: &mut ActivationState, result: ()) -> () {
  drop result
  state.completed = true
  return ()
}

effect fn driveSelected(
  selected: NoExecution | StoredExecution,
  state: &mut ActivationState,
) -> () {
  return match move selected {
    NoExecution {} => ()
    StoredExecution { execution } => run Execution.drive(
      move execution,
      move state,
      completed,
      suspended,
    )
  }
}

fn takeRequest(
  mailbox: &mut TaskMailbox,
) -> NoRequest | PendingRequest {
  return Intrinsic.replace(mailbox.request, NoRequest {})
}

fn takeSubmission(
  slot: &mut SubmissionSlot,
) -> NoSubmission | PendingSubmission {
  return Intrinsic.replace(slot.phase, NoSubmission {})
}

struct NoMailbox {}
struct MailboxHandle { value: Shared<TaskMailbox> }
struct NoSubmissionHandle {}
struct SubmissionHandle { value: Shared<SubmissionSlot> }
struct EntryHandles {
  mailbox: NoMailbox | MailboxHandle
  submission: NoSubmissionHandle | SubmissionHandle
}

fn copyHandles(entry: &mut TaskEntry, output: &mut EntryHandles) -> () {
  output.mailbox = MailboxHandle {
    value: Shared.clone<TaskMailbox>(&entry.mailbox),
  }
  output.submission = SubmissionHandle {
    value: Shared.clone<SubmissionSlot>(&entry.submission),
  }
  return ()
}

fn markPublished(response: &mut PublicationResponse) -> () {
  response.phase = ResponsePublished {}
  return ()
}

fn markRejected(response: &mut PublicationResponse) -> () {
  response.phase = ResponseRejected {}
  return ()
}

fn setFirstChild(entry: &mut TaskEntry, child: TaskId) -> () {
  entry.firstChild = TaskLink { identity: child }
  return ()
}

fn makeEntry(task: PreparedTask, sibling: NoLink | TaskLink) -> TaskEntry {
  let PreparedTask {
    identity,
    parent,
    execution,
    canceller,
    mailbox,
    submission,
  } = move task
  return TaskEntry {
    parent: TaskLink { identity: parent },
    firstChild: NoLink {},
    nextSibling: move sibling,
    cancellationNext: NoLink {},
    phase: Initial {},
    execution: StoredExecution { execution: move execution },
    cancellation: CompletionCancellation {
      phase: CancellationAvailable { canceller: move canceller },
    },
    mailbox: move mailbox,
    submission: move submission,
    nextRegistrationGeneration: u64.MIN,
    registrationGenerationExhausted: false,
    registration: RegistrationIdle {},
  }
}

struct LinkOutput { link: NoLink | TaskLink }
fn copyFirstChild(entry: &mut TaskEntry, output: &mut LinkOutput) -> () {
  output.link = entry.firstChild
  return ()
}

effect fn adopt(
  driver: &mut Driver,
  parent: TaskId,
  wake: Wake,
  response: Shared<PublicationResponse>,
  task: PreparedTask,
) -> () {
  let reservation = run Effect.result(reserveTimerSlot(&mut driver.store))
  return match move reservation {
    Result<(), OutOfMemoryError>.Success { value } => run finishReservedAdoption(
      move driver,
      parent,
      move wake,
      move response,
      move task,
      move value,
    )
    Result<(), OutOfMemoryError>.Failure { error } => finishUnreservedAdoption(
      move wake,
      move response,
      move task,
      move error,
    )
  }
}

effect fn finishReservedAdoption(
  driver: &mut Driver,
  parent: TaskId,
  wake: Wake,
  response: Shared<PublicationResponse>,
  task: PreparedTask,
  reserved: (),
) -> () {
  drop reserved
  return run insertAdoptedTask(
    move driver,
    parent,
    move wake,
    move response,
    move task,
  )
}

fn finishUnreservedAdoption(
  wake: Wake,
  response: Shared<PublicationResponse>,
  task: PreparedTask,
  error: OutOfMemoryError,
) -> () {
  drop task
  return finishRejectedAdoption(move response, move wake, move error)
}

effect fn insertAdoptedTask(
  driver: &mut Driver,
  parent: TaskId,
  wake: Wake,
  response: Shared<PublicationResponse>,
  task: PreparedTask,
) -> () {
  let child = task.identity
  let mut links = LinkOutput { link: NoLink {} }
  let found = HashMap.withMut(&mut driver.store.tasks, parent, copyFirstChild(&mut links))
  let LinkOutput { link } = move links
  let entry = makeEntry(move task, move link)
  let mut allocator = Allocator.systemAllocatorProvider()
  let inserted = HashMap.insert<TaskId, TaskEntry>(&mut driver.store.tasks, child, move entry)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let outcome = run Effect.result(move inserted)
  return finishAdoption(
    move driver,
    parent,
    child,
    move wake,
    move response,
    move outcome,
  )
}

fn finishAdoption(
  driver: &mut Driver,
  parent: TaskId,
  child: TaskId,
  wake: Wake,
  response: Shared<PublicationResponse>,
  outcome: Result<Option<TaskEntry>, OutOfMemoryError>,
) -> () {
  return match move outcome {
    Result<Option<TaskEntry>, OutOfMemoryError>.Success { value: previous } => finishAcceptedAdoption(
      move driver,
      parent,
      child,
      move wake,
      move response,
      move previous,
    )
    Result<Option<TaskEntry>, OutOfMemoryError>.Failure { error } => finishRejectedAdoption(
      move response,
      move wake,
      move error,
    )
  }
}

fn finishAcceptedAdoption(
  driver: &mut Driver,
  parent: TaskId,
  child: TaskId,
  wake: Wake,
  response: Shared<PublicationResponse>,
  previous: Option<TaskEntry>,
) -> () {
  drop previous
  let linked = HashMap.withMut(&mut driver.store.tasks, parent, setFirstChild(child))
  let published = Shared.withMut(&response, markPublished)
  Execution.wake(move wake)
  let notified = HashMap.withMut(&mut driver.store.tasks, child, notifyInitialEntry)
  drop response
  return ()
}

fn finishRejectedAdoption(
  response: Shared<PublicationResponse>,
  wake: Wake,
  error: OutOfMemoryError,
) -> () {
  drop error
  let rejected = Shared.withMut(&response, markRejected)
  drop response
  Execution.wake(move wake)
  return ()
}

effect fn processPublication(driver: &mut Driver, identity: TaskId) -> () {
  let mut handles = EntryHandles {
    mailbox: NoMailbox {},
    submission: NoSubmissionHandle {},
  }
  let found = HashMap.withMut(&mut driver.store.tasks, identity, copyHandles(&mut handles))
  if !found { drop handles return () }
  let EntryHandles { mailbox: selectedMailbox, submission: selectedSubmission } = move handles
  let mailbox = match move selectedMailbox {
    NoMailbox {} => missingMailbox()
    MailboxHandle { value } => move value
  }
  let submission = match move selectedSubmission {
    NoSubmissionHandle {} => missingSubmission()
    SubmissionHandle { value } => move value
  }
  let response = Shared.with<
    TaskMailbox,
    Shared<PublicationResponse>,
  >(
    &mailbox,
    cloneResponse,
  )
  let request = Shared.withMut(&mailbox, takeRequest)
  let phase = Shared.withMut(&submission, takeSubmission)
  drop mailbox
  drop submission
  return match move request {
    NoRequest {} => finishNoRequest(move response, move phase)
    PendingRequest { wake } => match move phase {
      NoSubmission {} => finishMissingSubmission(move response, move wake)
      PendingSubmission { task } => run adopt(
        move driver,
        identity,
        move wake,
        move response,
        move task,
      )
    }
  }
}

fn cloneResponse(
  mailbox: &TaskMailbox,
) -> Shared<PublicationResponse> {
  return Shared.clone<PublicationResponse>(&mailbox.response)
}

fn missingMailbox() -> Shared<TaskMailbox> {
  let invalid = 1 / 0
  return missingMailbox()
}

fn missingSubmission() -> Shared<SubmissionSlot> {
  let invalid = 1 / 0
  return missingSubmission()
}

fn finishNoRequest(
  response: Shared<PublicationResponse>,
  phase: NoSubmission | PendingSubmission,
) -> () {
  drop response
  drop phase
  return ()
}

fn finishMissingSubmission(
  response: Shared<PublicationResponse>,
  wake: Wake,
) -> () {
  drop response
  Execution.wake(move wake)
  return ()
}

struct CompletionAudit { completed: bool }
fn phaseCompleted(entry: &mut TaskEntry, output: &mut CompletionAudit) -> () {
  output.completed = match &entry.phase { Completed {} => true _ => false }
  return ()
}

fn releaseEntry(entry: TaskEntry) -> () { drop entry return () }
fn releaseRemoved(selected: Option<TaskEntry>) -> () {
  return match move selected {
    Option<TaskEntry>.None => ()
    Option<TaskEntry>.Some { value } => releaseEntry(move value)
  }
}

struct TaskLinks {
  parent: NoLink | TaskLink
  firstChild: NoLink | TaskLink
  nextSibling: NoLink | TaskLink
}

fn copyTaskLinks(entry: &mut TaskEntry, output: &mut TaskLinks) -> () {
  output.parent = entry.parent
  output.firstChild = entry.firstChild
  output.nextSibling = entry.nextSibling
  return ()
}

fn readTaskLinks(
  tasks: &mut HashMap<TaskId, TaskEntry>,
  identity: TaskId,
  output: &mut TaskLinks,
) -> bool {
  return HashMap.withMut(move tasks, identity, copyTaskLinks(move output))
}

fn installCancellationLink(entry: &mut TaskEntry, next: NoLink | TaskLink) -> () {
  entry.cancellationNext = move next
  return ()
}

fn takeCancellationLink(entry: &mut TaskEntry, output: &mut LinkOutput) -> () {
  output.link = Intrinsic.replace(entry.cancellationNext, NoLink {})
  return ()
}

fn setFirstChildLink(entry: &mut TaskEntry, link: NoLink | TaskLink) -> () {
  entry.firstChild = move link
  return ()
}

fn setNextSiblingLink(entry: &mut TaskEntry, link: NoLink | TaskLink) -> () {
  entry.nextSibling = move link
  return ()
}

fn hasLink(link: NoLink | TaskLink) -> bool {
  return match move link { NoLink {} => false TaskLink { identity } => true }
}

fn requireIdentity(link: NoLink | TaskLink) -> TaskId {
  return match move link {
    NoLink {} => missingIdentity()
    TaskLink { identity } => identity
  }
}

fn missingIdentity() -> TaskId {
  let invalid = 1 / 0
  return missingIdentity()
}

fn cancelEntry(entry: TaskEntry) -> () {
  let TaskEntry {
    parent,
    firstChild,
    nextSibling,
    cancellationNext,
    phase,
    execution,
    cancellation,
    mailbox,
    submission,
    nextRegistrationGeneration,
    registrationGenerationExhausted,
    registration,
  } = move entry
  drop parent
  drop firstChild
  drop nextSibling
  drop cancellationNext
  drop phase
  drop execution
  drop cancellation
  drop mailbox
  drop submission
  drop nextRegistrationGeneration
  drop registrationGenerationExhausted
  drop registration
  return ()
}

fn cancelRemoved(selected: Option<TaskEntry>) -> () {
  return match move selected {
    Option<TaskEntry>.None => ()
    Option<TaskEntry>.Some { value } => cancelEntry(move value)
  }
}

fn finishCompletedTask(driver: &mut Driver, identity: TaskId) -> () {
  let mut links = TaskLinks {
    parent: NoLink {},
    firstChild: NoLink {},
    nextSibling: NoLink {},
  }
  let found = readTaskLinks(&mut driver.store.tasks, identity, &mut links)
  if !found { return () }

  let mut child = links.firstChild
  while hasLink(child) {
    let childIdentity = requireIdentity(child)
    let mut childLinks = TaskLinks {
      parent: NoLink {},
      firstChild: NoLink {},
      nextSibling: NoLink {},
    }
    let childFound = readTaskLinks(
      &mut driver.store.tasks,
      childIdentity,
      &mut childLinks,
    )
    if childFound {
      child = childLinks.nextSibling
      let nextWork = driver.cancellationHead
      let linked = HashMap.withMut(
        &mut driver.store.tasks,
        childIdentity,
        installCancellationLink(nextWork),
      )
      if linked { driver.cancellationHead = TaskLink { identity: childIdentity } }
    } else {
      child = NoLink {}
    }
  }

  let parent = links.parent
  if hasLink(parent) {
    let parentIdentity = requireIdentity(parent)
    let mut parentLinks = TaskLinks {
      parent: NoLink {},
      firstChild: NoLink {},
      nextSibling: NoLink {},
    }
    let parentFound = readTaskLinks(
      &mut driver.store.tasks,
      parentIdentity,
      &mut parentLinks,
    )
    if parentFound {
      let mut current = parentLinks.firstChild
      let mut previous = LinkOutput { link: NoLink {} }
      let mut unlinked = false
      while !unlinked && hasLink(current) {
        let currentIdentity = requireIdentity(current)
        let mut currentLinks = TaskLinks {
          parent: NoLink {},
          firstChild: NoLink {},
          nextSibling: NoLink {},
        }
        let currentFound = readTaskLinks(
          &mut driver.store.tasks,
          currentIdentity,
          &mut currentLinks,
        )
        if !currentFound {
          unlinked = true
        } else if currentIdentity.value == identity.value {
          let nextSibling = currentLinks.nextSibling
          let replaced = match previous.link {
            NoLink {} => HashMap.withMut(
              &mut driver.store.tasks,
              parentIdentity,
              setFirstChildLink(nextSibling),
            )
            TaskLink { identity: previousIdentity } => HashMap.withMut(
              &mut driver.store.tasks,
              previousIdentity,
              setNextSiblingLink(nextSibling),
            )
          }
          unlinked = true
        } else {
          previous.link = TaskLink { identity: currentIdentity }
          current = currentLinks.nextSibling
        }
      }
    }
  }

  let timerWake = disarmRegistration(&mut driver.store, identity)
  let removed = HashMap.remove<TaskId, TaskEntry>(&mut driver.store.tasks, identity)
  releaseRemoved(move removed)
  drop timerWake
  if identity.value == 0 { driver.rootComplete = true }

  while hasLink(driver.cancellationHead) {
    let selected = requireIdentity(driver.cancellationHead)
    let mut selectedLinks = TaskLinks {
      parent: NoLink {},
      firstChild: NoLink {},
      nextSibling: NoLink {},
    }
    let selectedFound = readTaskLinks(
      &mut driver.store.tasks,
      selected,
      &mut selectedLinks,
    )
    if !selectedFound {
      driver.cancellationHead = NoLink {}
    } else {
      let mut nextWork = LinkOutput { link: NoLink {} }
      let popped = HashMap.withMut(
        &mut driver.store.tasks,
        selected,
        takeCancellationLink(&mut nextWork),
      )
      driver.cancellationHead = nextWork.link
      let mut descendant = selectedLinks.firstChild
      while hasLink(descendant) {
        let descendantIdentity = requireIdentity(descendant)
        let mut descendantLinks = TaskLinks {
          parent: NoLink {},
          firstChild: NoLink {},
          nextSibling: NoLink {},
        }
        let descendantFound = readTaskLinks(
          &mut driver.store.tasks,
          descendantIdentity,
          &mut descendantLinks,
        )
        if descendantFound {
          descendant = descendantLinks.nextSibling
          let nextDescendant = driver.cancellationHead
          let linked = HashMap.withMut(
            &mut driver.store.tasks,
            descendantIdentity,
            installCancellationLink(nextDescendant),
          )
          if linked {
            driver.cancellationHead = TaskLink { identity: descendantIdentity }
          }
        } else {
          descendant = NoLink {}
        }
      }
      let selectedTimerWake = disarmRegistration(&mut driver.store, selected)
      let cancelled = HashMap.remove<TaskId, TaskEntry>(&mut driver.store.tasks, selected)
      cancelRemoved(move cancelled)
      drop selectedTimerWake
    }
  }
  return ()
}

fn durableRootComplete(owner: &DurableDriver) -> bool {
  let driver = Box.get<Driver>(&owner.boxed)
  return driver[0].rootComplete
}

fn durableEarliestTimer(owner: &DurableDriver) -> NoTimerDeadline | TimerDeadline {
  let driver = Box.get<Driver>(&owner.boxed)
  return earliestTimer(&driver[0])
}

effect fn refreshDurable(owner: &mut DurableDriver) -> ()
? &mut MonotonicClock {
  let mut drivers = Box.getMut<Driver>(&mut owner.boxed)
  run refreshClock(&mut drivers[0])
  return ()
}

fn drainDurableTimers(owner: &mut DurableDriver) -> () {
  let mut drivers = Box.getMut<Driver>(&mut owner.boxed)
  drainDueTimers(&mut drivers[0])
  return ()
}

fn takeDurableReady(owner: &mut DurableDriver) -> QueueEmpty | ReadyIdentity {
  let mut drivers = Box.getMut<Driver>(&mut owner.boxed)
  return takeDriverReady(&mut drivers[0])
}

fn takeDriverReady(driver: &mut Driver) -> QueueEmpty | ReadyIdentity {
  return takeReady(&driver.queue)
}

effect fn driveDurableSelected(
  owner: &mut DurableDriver,
  selected: QueueEmpty | ReadyIdentity,
) -> bool
! OutOfMemoryError
? &mut MonotonicClock {
  let mut drivers = Box.getMut<Driver>(&mut owner.boxed)
  return run driveReady(&mut drivers[0], move selected)
}

effect fn driveIdentity(driver: &mut Driver, identity: TaskId) -> ()
! OutOfMemoryError
? &mut MonotonicClock {
  let eligible = HashMap.withMut(&mut driver.store.tasks, identity, markEligible)
  if !eligible { return () }
  let mut extraction = Extraction { slot: NoExecution {} }
  let found = HashMap.withMut(&mut driver.store.tasks, identity, extract(&mut extraction))
  if !found { drop extraction return () }
  driver.current = identity
  let Extraction { slot } = move extraction
  let mut state = ActivationState { slot: NoExecution {}, completed: false }
  run driveSelected(move slot, &mut state)
  let ActivationState { slot: parked, completed: parkedComplete } = move state
  let restored = match move parked {
    NoExecution {} => false
    StoredExecution { execution } => HashMap.withMut(
      &mut driver.store.tasks,
      identity,
      restore(move execution),
    )
  }
  if parkedComplete {
    let marked = HashMap.withMut(&mut driver.store.tasks, identity, markCompleted(()))
  }
  let timerRequest = Shared.withMut(&driver.timerInbox, takeTimerRequest)
  run processTimerRequest(&mut driver.store, identity, move timerRequest)
  let mut terminal = CompletionAudit { completed: false }
  let inspected = HashMap.withMut(&mut driver.store.tasks, identity, phaseCompleted(&mut terminal))
  return run finishDrive(move driver, identity, terminal.completed)
}

effect fn finishDrive(
  driver: &mut Driver,
  identity: TaskId,
  terminal: bool,
) -> () ! OutOfMemoryError {
  if !terminal { return run processPublication(move driver, identity) }
  let cleaned = finishCompletedTask(move driver, identity)
  drop cleaned
  return ()
}

fn noReady() -> bool { return false }

effect fn drivePresent(driver: &mut Driver, identity: TaskId) -> bool
! OutOfMemoryError
? &mut MonotonicClock {
  run driveIdentity(move driver, identity)
  return true
}

effect fn driveReady(driver: &mut Driver, selected: QueueEmpty | ReadyIdentity) -> bool
! OutOfMemoryError
? &mut MonotonicClock {
  return match move selected {
    QueueEmpty {} => noReady()
    ReadyIdentity { identity } => run drivePresent(move driver, identity)
  }
}

effect fn driveUntilRoot(driver: Box<Driver>) -> ()
! OutOfMemoryError | StalledError
? &mut MonotonicClock {
  let mut owner = DurableDriver { boxed: move driver }
  while !durableRootComplete(&owner) {
    run refreshDurable(&mut owner)
    drainDurableTimers(&mut owner)
    let selected = takeDurableReady(&mut owner)
    let progressed = run driveDurableSelected(&mut owner, move selected)
    if !progressed {
      let deadline = durableEarliestTimer(&owner)
      run waitForDeadline(move deadline)
    }
  }
  return ()
}

effect fn waitForDeadline(deadline: NoTimerDeadline | TimerDeadline) -> ()
! StalledError
? &mut MonotonicClock {
  return match move deadline {
    NoTimerDeadline {} => run stalledWait()
    TimerDeadline { value } => run waitUntilTimer(move value)
  }
}

effect fn stalledWait() -> () ! StalledError { fail StalledError {} }

effect fn initializeDriver(
  driver: &mut Driver,
  root: TaskId,
  entry: TaskEntry,
) -> ()
! OutOfMemoryError
? &mut Allocator {
  run reserveTimerSlot(&mut driver.store)
  let inserted = run HashMap.insert<TaskId, TaskEntry>(
    &mut driver.store.tasks,
    root,
    move entry,
  )
  drop inserted
  let notified = HashMap.withMut(&mut driver.store.tasks, root, notifyInitialEntry)
  return ()
}

effect<'env> fn finishRoot<A: 'env, E: 'env, 'env>(selected: RootPending | RootReady<A, E>) -> A ! E {
  return match move selected {
    RootPending {} => missingRoot<A>()
    RootReady<A, E> { result } => run finishRootResult<A, E>(move result)
  }
}

effect<'env> fn finishRootResult<A: 'env, E: 'env, 'env>(result: Result<A, E>) -> A ! E {
  return match move result {
    Result<A, E>.Success { value: success } => move success
    Result<A, E>.Failure { error } => run raiseRoot<A, E>(move error)
  }
}

effect<'env> fn raiseRoot<A, E: 'env, 'env>(error: E) -> A ! E { fail move error }
fn missingRoot<A>() -> A { let invalid = 1 / 0 return missingRoot<A>() }

fn requirePositiveResolution(value: u64) -> u64 {
  if value == u64.MIN {
    let invalid = 1 / 0
  }
  return value
}

