//! Growable owned sequences with allocation-aware mutation, stable sorting, and checked indexing.
//!
//! # When to use
//! Use [`Vector`] when a sequence must grow or own a runtime-determined number of values. Use a
//! fixed array when the length is part of the type, and `silk.bytes.Bytes` for bulk byte storage.
//!
//! # Details
//! [`make`] is allocation-free. The first growth reserves four elements and later growth doubles
//! capacity; [`reserve`] can move that cost ahead of mutation. Growth completes in replacement
//! storage before committing, so [`append`] and [`reserve`] leave the vector unchanged on
//! [`OutOfMemoryError`]. Removing, clearing, and truncating drop exactly the elements they discard
//! while retaining capacity.
//!
//! [`sort`] is stable, deterministic, and supports move-only elements, but allocates scratch space.
//! [`binarySearch`] requires an already sorted vector and returns the lowest index among equal
//! matches.
//!
//! # Gotchas
//! [`get`], [`set`], and [`remove`] trap on an out-of-range index. An [`insert`] position must be at
//! or before the current length. Use [`asSlice`] to borrow move-only elements because [`get`]
//! produces a copied value.
//!
//! # Examples
//! ## Grow and edit an owned sequence
//! ```silk
//! import silk.allocator { Allocator, OutOfMemoryError }
//!
//! import silk.effect { Effect }
//!
//! import silk.vector { Vector }
//!
//! effect fn build() -> i32
//! ! OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let mut values = Vector.make<i32>()
//!   let first = run Vector.append<i32>(&mut values, 10)
//!     |> Effect.provideMut<Allocator>(&mut allocator)
//!   let second = run Vector.append<i32>(&mut values, 30)
//!     |> Effect.provideMut<Allocator>(&mut allocator)
//!   let middle = run Vector.insert<i32>(&mut values, 1, 20)
//!     |> Effect.provideMut<Allocator>(&mut allocator)
//!   let changed = Vector.set<i32>(&mut values, 2, 22)
//!   let removed = Vector.remove<i32>(&mut values, 0)
//!   return Vector.get<i32>(&values, 0) + Vector.get<i32>(&values, 1)
//! }
//!
//! effect fn recover(error: OutOfMemoryError) -> i32 {
//!   return 0
//! }
//!
//! pub fn main() -> i32 {
//!   return run Effect.catchAll(build(), recover)
//! }
//! ```
//!
//! ## Sort values and find the first equal value
//! ```silk
//! import silk.allocator { Allocator, OutOfMemoryError }
//!
//! import silk.effect { Effect }
//!
//! import silk.option { Option }
//!
//! import silk.usize
//!
//! import silk.vector { Vector }
//!
//! effect fn search() -> i32
//! ! OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let mut values = Vector.make<i32>()
//!   let first = run Vector.append<i32>(&mut values, 3)
//!     |> Effect.provideMut<Allocator>(&mut allocator)
//!   let second = run Vector.append<i32>(&mut values, 36)
//!     |> Effect.provideMut<Allocator>(&mut allocator)
//!   let third = run Vector.append<i32>(&mut values, 3)
//!     |> Effect.provideMut<Allocator>(&mut allocator)
//!   let mut sorting = Vector.sort<i32>(&mut values)
//!     |> Effect.provideMut<Allocator>(&mut allocator)
//!   let sorted = run sorting
//!   let found = Vector.binarySearch<i32>(&values, 3)
//!     |> Option.unwrapOr<usize>(99)
//!   if found != usize.ZERO {
//!     return 0
//!   }
//!   return Vector.get<i32>(&values, 0) + Vector.get<i32>(&values, 1) + Vector.get<i32>(&values, 2)
//! }
//!
//! effect fn recover(error: OutOfMemoryError) -> i32 {
//!   return 0
//! }
//!
//! pub fn main() -> i32 {
//!   return run Effect.catchAll(search(), recover)
//! }
//! ```

// A growable owned sequence over the allocation substrate. Ordinary Silk: no compiler phase
// knows this type, and every capability it uses is available to user code.
//
// The storage union keeps the empty vector allocation-free; Intrinsic.replace moves it out and back
// through &mut self without a partial move, and the Drop hook destroys exactly the
// initialized elements before the backing buffer releases.

import silk.allocator {Allocator, OutOfMemoryError}
import silk.allocator {OutOfMemoryError}
import silk.layout {Layout}
import silk.layout {LayoutOverflow}
import silk.option {Option}
import silk.order {Order}
import silk.raw_buffer {RawBuffer}
import silk.slot {Slot}
import silk.u8
import silk.usize

/// The allocation-free storage state of an empty [`Vector`].
pub struct Empty<T> {
  anchor: [T; 0]
}

/// The allocated storage state of a non-empty or reserved [`Vector`].
pub struct Full<T> {
  buffer: RawBuffer<T>
}

/// Owns an initialized prefix of a growable contiguous allocation.
///
/// # Details
///
/// The vector releases each initialized element and its storage on drop. Length counts initialized
/// elements. Capacity counts elements that fit without growth. Borrowed elements retain their
/// referent lifetimes through replacement, extraction, and required cleanup. An allocation does
/// not make its payload detached.
pub struct Vector<T> {
  storage: Empty<T> | Full<T>
  count: usize
  limit: usize
}

impl<T> Vector<T> {
  /// Creates an empty vector with zero capacity and no allocation.
  pub fn make() -> Vector<T> {
    return Vector<T> {storage: Empty<T> {anchor: []}, count: usize.ZERO, limit: usize.ZERO}
  }
  /// Returns the number of initialized elements.
  pub fn length(self: &Self) -> usize {
    return self.count
  }
  /// Returns the total number of elements that fit without another growth allocation.
  pub fn capacity(self: &Self) -> usize {
    return self.limit
  }
  /// Borrows the initialized elements as one shared lexical slice.
  ///
  /// # Gotchas
  ///
  /// Do not retain this slice across an operation that can grow the vector.
  pub fn asSlice(self: &Self) -> &[T] {
    return match & self.storage {
      Empty<T> {anchor} => emptySlice<T>(&anchor)
      Full<T> {buffer} => RawBuffer.view<T>(&buffer, usize.ZERO, self.count)
    }
  }
  /// Borrows all initialized elements as one exclusive lexical slice.
  ///
  /// # Gotchas
  ///
  /// Do not retain this slice across an operation that can grow the vector.
  pub fn asMutSlice(self: &mut Self) -> &mut [T] {
    return match &mut self.storage {
      Empty<T> {anchor} => emptyMutSlice<T>(&mut anchor)
      Full<T> {buffer} => RawBuffer.viewMut<T>(&mut buffer, usize.ZERO, self.count)
    }
  }
  /// Appends one owned value, growing geometrically when capacity is exhausted.
  ///
  /// # Details
  ///
  /// The vector takes ownership of `value`. If growth fails, the vector keeps its prior contents,
  /// length, and capacity.
  pub effect<'env> fn append<'env>(self: &mut Self, value: T) -> () ! OutOfMemoryError ? &mut Allocator {
    if self.count == self.limit {
      let mut next = self.limit + self.limit
      if self.limit == usize.ZERO {
        next = 4
      }
      let element = Layout.of<T>()
      let plan = Layout.repeat(move element, next)
      let layout = match move plan {
        Layout ready => move ready
        LayoutOverflow overflow => run overflowed()
      }
      let recipe = Allocator.allocate(move layout)
      let allocation = run recipe
      let storage = Intrinsic.replace(self.storage, Empty<T> {anchor: []})
      let moved = match move storage {
        Empty<T> nothing => Full<T> {buffer: freshBuffer<T>(move allocation, next)}
        Full<T> full => Full<T> {buffer: migrate<T>(move full, move allocation, self.count, next)}
      }
      self.storage = move moved
      self.limit = next
    }
    let storage = Intrinsic.replace(self.storage, Empty<T> {anchor: []})
    let stored = match move storage {
      Empty<T> nothing => absurd<Full<T>>()
      Full<T> full => writeAt<T>(move full, self.count, move value)
    }
    self.storage = move stored
    self.count = self.count + usize.ONE
    return ()
  }
  /// Inserts one owned value at an index, shifting later elements without requiring T to be Copy.
  ///
  /// # Details
  ///
  /// Existing elements from `index` onward move one position to the right. If growth fails, the
  /// vector keeps its prior contents, length, and capacity.
  ///
  /// # Gotchas
  ///
  /// `index` must be less than or equal to [`length`].
  pub effect<'env> fn insert<'env>(self: &mut Self, index: usize, value: T) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
    if self.count == self.limit {
      let mut next = self.limit + self.limit
      if self.limit == usize.ZERO {
        next = 4
      }
      let element = Layout.of<T>()
      let plan = Layout.repeat(move element, next)
      let layout = match move plan {
        Layout ready => move ready
        LayoutOverflow overflow => run overflowed()
      }
      let recipe = Allocator.allocate(move layout)
      let allocation = run recipe
      let storage = Intrinsic.replace(self.storage, Empty<T> {anchor: []})
      let moved = match move storage {
        Empty<T> nothing => Full<T> {buffer: freshBuffer<T>(move allocation, next)}
        Full<T> full => Full<T> {buffer: migrate<T>(move full, move allocation, self.count, next)}
      }
      self.storage = move moved
      self.limit = next
    }
    let storage = Intrinsic.replace(self.storage, Empty<T> {anchor: []})
    let stored = match move storage {
      Empty<T> nothing => absurd<Full<T>>()
      Full<T> full => insertInto<T>(move full, index, self.count, move value)
    }
    self.storage = move stored
    self.count = self.count + usize.ONE
    return ()
  }
  /// Copies the element at one index and traps when the index is out of range.
  ///
  /// # When to use
  ///
  /// Use this function for a `Copy` element. Use [`asSlice`] to borrow a move-only element.
  pub fn get<T: Copy>(self: &Self, index: usize) -> T {
    if self.count <= index {
      let boom = 1 / 0
    }
    let read = match & self.storage {
      Empty<T> nothing => absurd<Read<T>>()
      Full<T> {buffer} => Read<T> {value: readAt<T>(&buffer, index)}
    }
    return match move read {
      Read<T> {value} => move value
    }
  }
  /// Removes the last element and returns it. Returns an absent value for an empty vector.
  ///
  /// # Details
  ///
  /// A present result transfers ownership of the removed element. Capacity does not change.
  pub fn pop(self: &mut Self) -> Option<T> {
    if self.count == usize.ZERO {
      return Option.none<T>()
    }
    let storage = Intrinsic.replace(self.storage, Empty<T> {anchor: []})
    let taken = match move storage {
      Empty<T> nothing => absurd<Taken<T>>()
      Full<T> full => takeAt<T>(move full, self.count - usize.ONE)
    }
    self.count = self.count - usize.ONE
    return match move taken {
      Taken<T> {storage: kept, value} => finish<T>(move self, move kept, move value)
    }
  }
  /// Removes the element at one index, shifting the later elements down. Traps out of range.
  ///
  /// # Details
  ///
  /// Ownership of the removed element passes to the caller. Capacity does not change.
  pub fn remove(self: &mut Self, index: usize) -> T {
    if self.count <= index {
      let boom = 1 / 0
    }
    let storage = Intrinsic.replace(self.storage, Empty<T> {anchor: []})
    let taken = match move storage {
      Empty<T> nothing => absurd<Taken<T>>()
      Full<T> full => removeAt<T>(move full, index, self.count)
    }
    self.count = self.count - usize.ONE
    return match move taken {
      Taken<T> {storage: kept, value} => commit<T>(move self, move kept, move value)
    }
  }
  /// Drops every initialized element and sets the length to zero, keeping the capacity.
  pub fn clear(self: &mut Self) -> () {
    return Vector.truncate<T>(move self, usize.ZERO)
  }
  /// Drops every element past one length, keeping the capacity. Shorter lengths are left alone.
  ///
  /// # Details
  ///
  /// If `length` is not less than the current length, this function does nothing.
  pub fn truncate(self: &mut Self, length: usize) -> () {
    if self.count <= length {
      return ()
    }
    let storage = Intrinsic.replace(self.storage, Empty<T> {anchor: []})
    let kept = match move storage {
      Empty<T> nothing => absurd<Full<T>>()
      Full<T> full => dropRange<T>(move full, length, self.count)
    }
    self.storage = move kept
    self.count = length
    return ()
  }
  /// Overwrites the element at one index, dropping the old element first. Traps out of range.
  pub fn set(self: &mut Self, index: usize, value: T) -> () {
    if self.count <= index {
      let boom = 1 / 0
    }
    let storage = Intrinsic.replace(self.storage, Empty<T> {anchor: []})
    let stored = match move storage {
      Empty<T> nothing => absurd<Full<T>>()
      Full<T> full => replaceAt<T>(move full, index, move value)
    }
    self.storage = move stored
    return ()
  }
  /// Grows capacity to hold at least `additional` more elements without another allocation.
  ///
  /// # Details
  ///
  /// This function does not change the length. If allocation fails, contents, length, and capacity
  /// remain unchanged.
  pub effect fn reserve(self: &mut Self, additional: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
    let needed = self.count + additional
    if needed <= self.limit {
      return ()
    }
    let mut next = self.limit + self.limit
    if self.limit == usize.ZERO {
      next = 4
    }
    while next < needed {
      next = next + next
    }
    let element = Layout.of<T>()
    let plan = Layout.repeat(move element, next)
    let layout = match move plan {
      Layout ready => move ready
      LayoutOverflow overflow => run overflowed()
    }
    let recipe = Allocator.allocate(move layout)
    let allocation = run recipe
    let storage = Intrinsic.replace(self.storage, Empty<T> {anchor: []})
    let moved = match move storage {
      Empty<T> nothing => Full<T> {buffer: freshBuffer<T>(move allocation, next)}
      Full<T> full => Full<T> {buffer: migrate<T>(move full, move allocation, self.count, next)}
    }
    self.storage = move moved
    self.limit = next
    return ()
  }
  /// Reserves space for `additional` elements without geometric capacity growth.
  ///
  /// # When to use
  ///
  /// Use when the complete output length is known. Use [`reserve`] for repeated growth.
  ///
  /// # Details
  ///
  /// If the current capacity is sufficient, this function does not allocate or shrink storage.
  /// Otherwise, one allocation sets capacity to the current length plus `additional`.
  /// The length stays unchanged. Size overflow or allocation failure leaves all existing state unchanged.
  pub effect fn reserveExact(self: &mut Self, additional: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
    let needed = match move usize.checkedAdd(self.count, additional) {
      Option<usize>.Some {value} => value
      Option<usize>.None => run Allocator.outOfMemory()
    }
    if needed <= self.limit {
      return ()
    }
    let element = Layout.of<T>()
    let plan = Layout.repeat(move element, needed)
    let layout = match move plan {
      Layout ready => move ready
      LayoutOverflow overflow => run overflowed()
    }
    let allocation = run Allocator.allocate(move layout)
    let storage = Intrinsic.replace(self.storage, Empty<T> {anchor: []})
    let moved = match move storage {
      Empty<T> nothing => Full<T> {buffer: freshBuffer<T>(move allocation, needed)}
      Full<T> full => Full<T> {buffer: migrate<T>(move full, move allocation, self.count, needed)}
    }
    self.storage = move moved
    self.limit = needed
    return ()
  }
  /// Orders the elements in place. Equal elements keep their input order.
  ///
  /// # Details
  ///
  /// The sort is stable and deterministic. It supports move-only elements and allocates scratch
  /// storage. If allocation fails, the vector remains unchanged.
  pub effect fn sort<T: Order>(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    let count = self.count
    if count <= usize.ONE {
      return ()
    }
    let element = Layout.of<T>()
    let plan = Layout.repeat(move element, count)
    let layout = match move plan {
      Layout ready => move ready
      LayoutOverflow overflow => run overflowed()
    }
    let recipe = Allocator.allocate(move layout)
    let allocation = run recipe
    let scratch = freshBuffer<T>(move allocation, count)
    let mut order = Vector.make<usize>()
    let mut spare = Vector.make<usize>()
    let mut seed = usize.ZERO
    while seed < count {
      let placed = run Vector.append<usize>(&mut order, seed)
      let staged = run Vector.append<usize>(&mut spare, seed)
      seed = seed + usize.ONE
    }
    let storage = Intrinsic.replace(self.storage, Empty<T> {anchor: []})
    let mut owned = takeBuffer<T>(move storage)
    let mut width = usize.ONE
    while width < count {
      let mut low = usize.ZERO
      while low < count {
        let mut middle = low + width
        if count < middle {
          middle = count
        }
        let mut high = middle + width
        if count < high {
          high = count
        }
        let mut left = low
        let mut right = middle
        let mut cursor = low
        while cursor < high {
          // The right run wins a position only when it compares strictly less, so equal elements
          // leave the left run first and the sort is stable.
          let mut takeRight = true
          if left < middle {
            takeRight = false
            if right < high {
              let indices = Vector.asSlice<usize>(&order)
              let after = RawBuffer.view<T>(&owned, indices[right], usize.ONE)
              let before = RawBuffer.view<T>(&owned, indices[left], usize.ONE)
              takeRight = (&after[usize.ZERO]) < (&before[usize.ZERO])
            }
          }
          let mut picked = usize.ZERO
          if takeRight {
            let indices = Vector.asSlice<usize>(&order)
            picked = indices[right]
            right = right + usize.ONE
          } else {
            let indices = Vector.asSlice<usize>(&order)
            picked = indices[left]
            left = left + usize.ONE
          }
          let mut slots = Vector.asMutSlice<usize>(&mut spare)
          slots[cursor] = picked
          cursor = cursor + usize.ONE
        }
        low = high
      }
      let mut back = usize.ZERO
      while back < count {
        let staged = Vector.asSlice<usize>(&spare)
        let value = staged[back]
        let mut slots = Vector.asMutSlice<usize>(&mut order)
        slots[back] = value
        back = back + usize.ONE
      }
      width = width + width
    }
    let applied = applyOrder<T>(move owned, move scratch, Vector.asSlice<usize>(&order), count)
    let sorted = match move applied {
      Applied<T> {buffer, scratch: leftover} => releaseScratch<T>(move buffer, move leftover)
    }
    self.storage = Full<T> {buffer: move sorted}
    return ()
  }
  /// Returns the index of a matching element in a sorted vector, or an absent value when Option.none matches.
  ///
  /// # Details
  ///
  /// Returns the lowest matching index when a vector holds several equal elements, so a repeated
  /// search over one vector always answers with the same index.
  /// This function consumes `target` and does not change the vector.
  ///
  /// # Gotchas
  ///
  /// The vector must already be ordered by the same `Order` witness.
  pub fn binarySearch<T: Order>(self: &Self, target: T) -> Option<usize> {
    let two = usize.ONE + usize.ONE
    let values = Vector.asSlice<T>(self)
    let mut low = usize.ZERO
    let mut high = self.count
    while low < high {
      let middle = low + (high - low) / two
      if (&values[middle]) < (&target) {
        low = middle + usize.ONE
      } else {
        high = middle
      }
    }
    if low < self.count {
      if !((&target) < (&values[low])) {
        return Option.some<usize>(low)
      }
    }
    return Option.none<usize>()
  }
}

// Diverges on the arms the surrounding logic has already proven impossible.
fn absurd<T>() -> T {
  let boom = 1 / 0
  return absurd<T>()
}

fn emptySlice<T>(anchor: &[T]) -> &[T] {
  return anchor
}

fn emptyMutSlice<T>(anchor: &mut [T]) -> &mut [T] {
  return move anchor
}

impl<T> Drop for Vector<T> {
  fn drop(self: &mut Vector<T>) -> () {
    let storage = Intrinsic.replace(self.storage, Empty<T> {anchor: []})
    let count = Intrinsic.replace(self.count, usize.ZERO)
    return match move storage {
      Empty<T> nothing => ()
      Full<T> full => releaseFull<T>(move full, count)
    }
  }
}

fn releaseFull<T>(full: Full<T>, length: usize) -> () {
  return match move full {
    Full<T> {buffer} => releaseBuffer<T>(move buffer, length)
  }
}

fn releaseBuffer<T>(buffer: RawBuffer<T>, length: usize) -> () {
  unsafe {
    let mut owned = move buffer
    let mut index = usize.ZERO
    while index < length {
      let selected = RawBuffer.slot(&mut owned, index)
      let cleared = Slot.dropValue(move selected)
      index = index + usize.ONE
    }
    drop owned
  }
  return ()
}

// Growth is atomic: the replacement buffer exists and holds every element before the vector's
// storage commits, so a failed allocation leaves the original untouched.

// Bulk byte append. Concrete to u8 rather than generic over T: the copy moves the source range,
// and moving out of a borrowed slice is only a copy when the element type is Copy. Growth
// repeats the shape `append` uses, so a failed allocation leaves the original vector untouched.
impl<T> Vector<T> {
  /// Appends every byte of one borrowed sequence in source order with one bulk copy.
  ///
  /// # Details
  ///
  /// If growth fails, the vector keeps its prior contents, length, and capacity.
  pub effect fn appendBytes(self: &mut Vector<u8>, values: &[u8]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
    let count = values.length
    if count == usize.ZERO {
      return ()
    }
    let needed = self.count + count
    if self.limit < needed {
      let mut next = self.limit + self.limit
      if self.limit == usize.ZERO {
        next = 4
      }
      while next < needed {
        next = next + next
      }
      let element = Layout.of<u8>()
      let plan = Layout.repeat(move element, next)
      let layout = match move plan {
        Layout ready => move ready
        LayoutOverflow overflow => run overflowed()
      }
      let recipe = Allocator.allocate(move layout)
      let allocation = run recipe
      let storage = Intrinsic.replace(self.storage, Empty<u8> {anchor: []})
      let moved = match move storage {
        Empty<u8> nothing => Full<u8> {buffer: freshBuffer<u8>(move allocation, next)}
        Full<u8> full => Full<u8> {
          buffer: migrate<u8>(move full, move allocation, self.count, next),
        }
      }
      self.storage = move moved
      self.limit = next
    }
    let storage = Intrinsic.replace(self.storage, Empty<u8> {anchor: []})
    let stored = match move storage {
      Empty<u8> nothing => absurd<Full<u8>>()
      Full<u8> full => copyInto(move full, self.count, values, count)
    }
    self.storage = move stored
    self.count = needed
    return ()
  }
}

fn copyInto(full: Full<u8>, offset: usize, values: &[u8], count: usize) -> Full<u8> {
  return match move full {
    Full<u8> {buffer} => Full<u8> {buffer: copyBuffer(move buffer, offset, values, count)}
  }
}

fn copyBuffer(buffer: RawBuffer<u8>, offset: usize, values: &[u8], count: usize) -> RawBuffer<u8> {
  unsafe {
    let mut owned = move buffer
    let copied = RawBuffer.copy<u8>(&mut owned, offset, values, count)
    return move owned
  }
  return absurd<RawBuffer<u8>>()
}

fn insertInto<T>(full: Full<T>, index: usize, length: usize, value: T) -> Full<T> {
  return match move full {
    Full<T> {buffer} => Full<T> {buffer: insertBuffer<T>(move buffer, index, length, move value)}
  }
}

fn insertBuffer<T>(buffer: RawBuffer<T>, index: usize, length: usize, value: T) -> RawBuffer<T> {
  unsafe {
    let mut owned = move buffer
    let mut cursor = length
    while index < cursor {
      let source = RawBuffer.slot(&mut owned, cursor - usize.ONE)
      let shifted = Slot.take(move source)
      let target = RawBuffer.slot(&mut owned, cursor)
      let written = Slot.write(move target, move shifted)
      cursor = cursor - usize.ONE
    }
    let selected = RawBuffer.slot(&mut owned, index)
    let written = Slot.write(move selected, move value)
    return move owned
  }
  return absurd<RawBuffer<T>>()
}

effect fn overflowed() -> Layout ! OutOfMemoryError {
  return run Allocator.outOfMemory()
}

fn freshBuffer<T>(allocation: Allocation, count: usize) -> RawBuffer<T> {
  unsafe {
    let made = RawBuffer.from<T>(move allocation, count)
    return move made
  }
  return absurd<RawBuffer<T>>()
}

fn migrate<T>(full: Full<T>, allocation: Allocation, length: usize, count: usize) -> RawBuffer<T> {
  return match move full {
    Full<T> {buffer} => migrateBuffer<T>(move buffer, move allocation, length, count)
  }
}

// One bulk move replaces the element-by-element migration: the initialized prefix of the old
// buffer travels to the fresh buffer in a single copy, and the emptied source releases as before.
fn migrateBuffer<T>(old: RawBuffer<T>, allocation: Allocation, length: usize, count: usize) -> RawBuffer<
  T,
> {
  let mut target = freshBuffer<T>(move allocation, count)
  unsafe {
    let mut source = move old
    let initialized = RawBuffer.view<T>(&source, usize.ZERO, length)
    let migrated = RawBuffer.copy<T>(&mut target, usize.ZERO, initialized, length)
    drop source
  }
  return move target
}

fn writeAt<T>(full: Full<T>, index: usize, value: T) -> Full<T> {
  return match move full {
    Full<T> {buffer} => Full<T> {buffer: writeSlot<T>(move buffer, index, move value)}
  }
}

fn writeSlot<T>(buffer: RawBuffer<T>, index: usize, value: T) -> RawBuffer<T> {
  unsafe {
    let mut owned = move buffer
    let selected = RawBuffer.slot(&mut owned, index)
    let written = Slot.write(move selected, move value)
    return move owned
  }
  return absurd<RawBuffer<T>>()
}

struct Read<T> {
  value: T
}

impl<T: Copy> Copy for Read<T> {}

// Checked read for Copy element types: out-of-range access traps identically on every supported target.

fn readAt<T: Copy>(buffer: &RawBuffer<T>, index: usize) -> T {
  unsafe {
    return RawBuffer.read<T>(buffer, index)
  }
  return absurd<T>()
}

// Carries the storage back out alongside the element moved out of it, so a removal never leaves
// the union behind in `self` while the element travels.
struct Taken<T> {
  storage: Full<T>
  value: T
}

fn takeAt<T>(full: Full<T>, index: usize) -> Taken<T> {
  return match move full {
    Full<T> {buffer} => takeSlot<T>(move buffer, index)
  }
}

fn takeSlot<T>(buffer: RawBuffer<T>, index: usize) -> Taken<T> {
  unsafe {
    let mut owned = move buffer
    let selected = RawBuffer.slot(&mut owned, index)
    let value = Slot.take(move selected)
    return Taken<T> {storage: Full<T> {buffer: move owned}, value: move value}
  }
  return absurd<Taken<T>>()
}

// Commits the storage back into the vector and yields the removed element as a present optional.
fn finish<T>(self: &mut Vector<T>, storage: Full<T>, value: T) -> Option<T> {
  self.storage = move storage
  return Option.some<T>(move value)
}

// Commits the storage back into the vector and yields the removed element itself.
fn commit<T>(self: &mut Vector<T>, storage: Full<T>, value: T) -> T {
  self.storage = move storage
  return move value
}

fn removeAt<T>(full: Full<T>, index: usize, length: usize) -> Taken<T> {
  return match move full {
    Full<T> {buffer} => removeBuffer<T>(move buffer, index, length)
  }
}

// Rotates the removed element towards the end one swap at a time, then takes it out of the last
// slot. Keeping the take last means no element is held live across the loop, and every slot holds
// an initialized value at every step because each iteration swaps a pair rather than clearing one.
// Takes the element out first, then closes the hole by moving each later element down one slot,
// mirroring insertBuffer so every slot holds an initialized value at each step.
fn removeBuffer<T>(buffer: RawBuffer<T>, index: usize, length: usize) -> Taken<T> {
  unsafe {
    let mut owned = move buffer
    let selected = RawBuffer.slot(&mut owned, index)
    let value = Slot.take(move selected)
    let mut cursor = index + usize.ONE
    while cursor < length {
      let source = RawBuffer.slot(&mut owned, cursor)
      let shifted = Slot.take(move source)
      let target = RawBuffer.slot(&mut owned, cursor - usize.ONE)
      let written = Slot.write(move target, move shifted)
      cursor = cursor + usize.ONE
    }
    return Taken<T> {storage: Full<T> {buffer: move owned}, value: move value}
  }
  return absurd<Taken<T>>()
}

fn dropRange<T>(full: Full<T>, from: usize, to: usize) -> Full<T> {
  return match move full {
    Full<T> {buffer} => Full<T> {buffer: dropRangeBuffer<T>(move buffer, from, to)}
  }
}

fn dropRangeBuffer<T>(buffer: RawBuffer<T>, from: usize, to: usize) -> RawBuffer<T> {
  unsafe {
    let mut owned = move buffer
    let mut index = from
    while index < to {
      let selected = RawBuffer.slot(&mut owned, index)
      let cleared = Slot.dropValue(move selected)
      index = index + usize.ONE
    }
    return move owned
  }
  return absurd<RawBuffer<T>>()
}

fn replaceAt<T>(full: Full<T>, index: usize, value: T) -> Full<T> {
  return match move full {
    Full<T> {buffer} => Full<T> {buffer: replaceSlot<T>(move buffer, index, move value)}
  }
}

fn replaceSlot<T>(buffer: RawBuffer<T>, index: usize, value: T) -> RawBuffer<T> {
  unsafe {
    let mut owned = move buffer
    let selected = RawBuffer.slot(&mut owned, index)
    let cleared = Slot.dropValue(move selected)
    let target = RawBuffer.slot(&mut owned, index)
    let written = Slot.write(move target, move value)
    return move owned
  }
  return absurd<RawBuffer<T>>()
}

// Growth is atomic exactly as in append: the replacement buffer holds every element before the
// vector's storage commits, so a failed allocation leaves the original untouched.

// Ordering. A bottom-up merge sort over a permutation of the element indices, so it is stable, and
// deterministic because every comparison and every exchange is decided by the run boundaries alone
// and never by an address, a capacity, or a target detail. The same input therefore produces the
// same output for every LLVM target.
//
// Merging cannot happen in place, so the sort allocates and carries `! OutOfMemoryError ? &mut Allocator`.
// An insertion sort would need no allocation and no requirement, but it costs O(n^2), and the two
// signatures are not source-compatible, so the choice cannot be deferred to a later release.
//
// The sort orders indices first and moves elements only once, at the end: each element is taken from
// its old slot into the scratch buffer exactly once and the whole prefix travels back in one bulk
// move. An element is therefore never read out of a borrowed place, never duplicated, and never
// dropped twice, and the movement itself never requires the element type to be Copy.
//
// `sort` is one single body rather than the helper chain the rest of this file uses because a bound
// is not carried into a nested generic call: a `T: Order` body cannot pass its own `T` to another
// `T: Order` function. Every helper `sort` calls is therefore unbounded, and every comparison is
// written here.

struct Applied<T> {
  buffer: RawBuffer<T>
  scratch: RawBuffer<T>
}

fn takeBuffer<T>(storage: Empty<T> | Full<T>) -> RawBuffer<T> {
  return match move storage {
    Empty<T> nothing => absurd<RawBuffer<T>>()
    Full<T> full => unwrapFull<T>(move full)
  }
}

fn unwrapFull<T>(full: Full<T>) -> RawBuffer<T> {
  return match move full {
    Full<T> {buffer} => move buffer
  }
}

// Moves every element into the scratch buffer in the order the permutation names, then returns the
// whole prefix in one bulk move. Every source slot is taken exactly once because the permutation is
// a bijection, so nothing leaks and nothing is dropped twice.
fn applyOrder<T>(buffer: RawBuffer<T>, scratch: RawBuffer<T>, order: &[usize], count: usize) -> Applied<
  T,
> {
  let mut owned = move buffer
  let mut staging = move scratch
  unsafe {
    let mut index = usize.ZERO
    while index < count {
      let selected = RawBuffer.slot(&mut owned, order[index])
      let value = Slot.take(move selected)
      let destination = RawBuffer.slot(&mut staging, index)
      let written = Slot.write(move destination, move value)
      index = index + usize.ONE
    }
  }
  let merged = RawBuffer.view<T>(&staging, usize.ZERO, count)
  let moved = RawBuffer.copy<T>(&mut owned, usize.ZERO, merged, count)
  return Applied<T> {buffer: move owned, scratch: move staging}
}

// The scratch buffer holds no initialized element once the bulk move returns, so releasing it
// destroys nothing.
fn releaseScratch<T>(buffer: RawBuffer<T>, leftover: RawBuffer<T>) -> RawBuffer<T> {
  unsafe {
    let spent = move leftover
    drop spent
  }
  return move buffer
}
