impl<'a> Serialize for string<'a> {
  effect fn serialize(self: &Self, options: &JsonOptions)
    -> () ! JsonError | WriterError ? &mut Writer {
    return run JsonOutput.writeString(self.*)
  }
}

impl Serialize for String {
  effect fn serialize(self: &Self, options: &JsonOptions)
    -> () ! JsonError | WriterError ? &mut Writer {
    return run JsonOutput.writeString(String.view(self))
  }
}

impl Deserialize for String {
  effect fn deserialize(scanner: &mut JsonScanner)
    -> Self ! JsonError | OutOfMemoryError ? &mut Allocator {
    let token = JsonScanner.next(&mut scanner.*)
    return match move token {
      Result<JsonToken, JsonError>.Failure { error } => { fail move error }
      Result<JsonToken, JsonError>.Success { value } => match move value {
        JsonToken.String { span, escaped } => {
          let offset = span.offset
          let raw = JsonScanner.slice(&scanner.*, move span)
          let decoded = run JsonText.decode(raw, offset, escaped)
          return unsafe String.fromBytesUnchecked(move decoded)
        }
        _ => { fail JsonError.at(JsonReason.TypeMismatch, JsonScanner.offset(&scanner.*)) }
      }
    }
  }
}

effect fn jsonToken(scanner: &mut JsonScanner, lookAhead: bool) -> JsonToken ! JsonError {
  if lookAhead {
    return match move JsonScanner.peek(&mut scanner.*) {
      Result<JsonToken, JsonError>.Success { value } => move value
      Result<JsonToken, JsonError>.Failure { error } => { fail move error }
    }
  }
  return match move JsonScanner.next(&mut scanner.*) {
    Result<JsonToken, JsonError>.Success { value } => move value
    Result<JsonToken, JsonError>.Failure { error } => { fail move error }
  }
}

impl<T: Serialize> Serialize for Option<T> {
  effect fn serialize(self: &Self, options: &JsonOptions)
    -> () ! JsonError | WriterError ? &mut Writer {
    return match &self.* {
      Option<T>.None => run Writer.writeAll(b"null")
      Option<T>.Some { value } => run Serialize.serialize(&value, options)
    }
  }
}

impl<T: Decode> Decode for Option<T> {
  fn decode(scanner: &mut JsonScanner) -> Result<Self, JsonError> {
    let peeked = JsonScanner.peek(&mut scanner.*)
    return match move peeked {
      Result<JsonToken, JsonError>.Failure { error } =>
        Result<Option<T>, JsonError>.failResult(move error)
      Result<JsonToken, JsonError>.Success { value } => match move value {
        JsonToken.Null => {
          let consumed = JsonScanner.next(&mut scanner.*)
          return match move consumed {
            Result<JsonToken, JsonError>.Failure { error } =>
              Result<Option<T>, JsonError>.failResult(move error)
            Result<JsonToken, JsonError>.Success { value: _ } =>
              Result<Option<T>, JsonError>.succeed(Option<T>.none())
          }
        }
        _ => match move Decode.decode(&mut scanner.*) {
          Result<T, JsonError>.Success { value: decoded } =>
            Result<Option<T>, JsonError>.succeed(Option<T>.some(move decoded))
          Result<T, JsonError>.Failure { error } =>
            Result<Option<T>, JsonError>.failResult(move error)
        }
      }
    }
  }
}

impl<T: Deserialize> Deserialize for Option<T> {
  effect fn deserialize(scanner: &mut JsonScanner)
    -> Self ! JsonError | OutOfMemoryError ? &mut Allocator {
    let token = run jsonToken(&mut scanner.*, true)
    return match move token {
      JsonToken.Null => {
        let consumed = run jsonToken(&mut scanner.*, false)
        return Option<T>.none()
      }
      _ => Option<T>.some(run Deserialize.deserialize(&mut scanner.*))
    }
  }
}

effect fn jsonVectorToken(scanner: &mut JsonScanner, lookAhead: bool) -> JsonToken ! JsonError {
  if lookAhead {
    return match move JsonScanner.peek(&mut scanner.*) {
      Result<JsonToken, JsonError>.Success { value } => move value
      Result<JsonToken, JsonError>.Failure { error } => { fail move error }
    }
  }
  return match move JsonScanner.next(&mut scanner.*) {
    Result<JsonToken, JsonError>.Success { value } => move value
    Result<JsonToken, JsonError>.Failure { error } => { fail move error }
  }
}

impl<T: Serialize> Serialize for Vector<T> {
  effect fn serialize(self: &Self, options: &JsonOptions)
    -> () ! JsonError | WriterError ? &mut Writer {
    let child = run JsonOptions.child(options)
    let values = Vector<T>.asSlice(self)
    run Writer.writeAll(b"[")
    let mut index = usize.ZERO
    while index < values.length {
      run JsonOutput.separator(&child, index == usize.ZERO)
      run Serialize.serialize(&values[index], &child)
      index = index + usize.ONE
    }
    if values.length != usize.ZERO { run JsonOutput.line(options) }
    return run Writer.writeAll(b"]")
  }
}

impl<T: Deserialize> Deserialize for Vector<T> {
  effect fn deserialize(scanner: &mut JsonScanner)
    -> Self ! JsonError | OutOfMemoryError ? &mut Allocator {
    let opening = run jsonVectorToken(&mut scanner.*, false)
    match move opening {
      JsonToken.ArrayBegin => {}
      _ => { fail JsonError.at(JsonReason.TypeMismatch, JsonScanner.offset(&scanner.*)) }
    }
    let mut values = Vector<T>.make()
    let first = run jsonVectorToken(&mut scanner.*, true)
    match move first {
      JsonToken.ArrayEnd => {
        let closing = run jsonVectorToken(&mut scanner.*, false)
        return move values
      }
      _ => {}
    }
    while true {
      let value = run Deserialize.deserialize(&mut scanner.*)
      run Vector<T>.append(&mut values, move value)
      let separator = run jsonVectorToken(&mut scanner.*, false)
      match move separator {
        JsonToken.ArrayEnd => { return move values }
        JsonToken.ValueSeparator => {}
        _ => { fail JsonError.at(JsonReason.UnexpectedByte, JsonScanner.offset(&scanner.*)) }
      }
    }
    fail JsonError.at(JsonReason.UnexpectedEnd, JsonScanner.offset(&scanner.*))
  }
}
