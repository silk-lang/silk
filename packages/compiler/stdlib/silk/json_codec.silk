      Result<f64, JsonError>.Success { value } => {
        if !f64.isFinite(value) {
          return Result<f64, JsonError>.failResult(
            JsonError.at(JsonReason.NumberOutOfRange, JsonScanner.offset(&scanner.*)))
        }
        return Result<f64, JsonError>.succeed(value)
      }
    }
  }
}

