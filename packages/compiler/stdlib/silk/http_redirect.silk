  CallbackRequirements in Without<CallbackRequirements, ByteDuplex>,
  CallbackRequirements in Without<CallbackRequirements, HttpTransport>,
  AcquisitionRequirements in Without<AcquisitionRequirements, ByteDuplex>,
  AcquisitionRequirements in Without<AcquisitionRequirements, HttpTransport> {
  let hasScratch = scratch.length != usize.ZERO
  let mut callback = move handler
  let mut dispatch = RoutedAttemptDispatch<
    P,
    A,
    C,
    H,
    ProducerError,
    CallbackError,
    AcquisitionError,
    ProducerRequirements,
    CallbackRequirements,
    AcquisitionRequirements,
  > {policy: policy, client: &mut client.*, scratch: &mut scratch, callback: &mut callback}
  return run runResponseLoop<
    'policy,
    P,
    A,
    ProducerError,
    FactoryError,
    CallbackError,
    AcquisitionError,
    ProducerRequirements,
    FactoryRequirements,
    CallbackRequirements,
    AcquisitionRequirements,
  >(
    &mut dispatch,
    move request,
    policy,
    ReplayPlan<
      P,
      ProducerError,
      AttemptStep<'policy, A>,
      FactoryError,
      RedirectError | ValueError | ProducerError | CallbackError | ClientError | OutOfMemoryError | AcquisitionError,
      ProducerRequirements,
      FactoryRequirements,
      ProducerRequirements | CallbackRequirements | AcquisitionRequirements | &mut AttemptDispatch<'policy, RedirectAttemptHandler<
        'policy,
        ProducerError,
        ProducerRequirements,
      >, AttemptStep<'policy, A>, RedirectError | ValueError | ProducerError | CallbackError | ClientError | OutOfMemoryError | AcquisitionError ? ProducerRequirements | CallbackRequirements | AcquisitionRequirements | &mut SelectedBody<
        ProducerError,
        ProducerRequirements,
      > | &mut MonotonicClock | &mut Allocator | &mut Random> | &mut MonotonicClock | &mut Allocator | &mut Random,
      Factory,
      Producer,
      SelectedAttemptHandler<
        'policy,
        ProducerError,
        ProducerRequirements,
        P,
        A,
        CallbackError,
        AcquisitionError,
        CallbackRequirements,
        AcquisitionRequirements,
      >,
    > {factory: move factory, retained: true},
    move deadline,
    hasScratch,
  )
}

/// Follows replayable producer scopes through routed or direct acquisition.
///
/// # Details
///
/// Each retained-body attempt receives one fresh producer inside the factory scope. A dropped-body
/// transition stops factory acquisition. All source and acquisition channels remain direct.
pub effect<'env> fn withReplayHybridResponse<
  'client,
  'uri,
  'method,
  'headers,
  'policy,
  'scratch,
  RoutedP,
  DirectP,
  A,
  FactoryError,
  ProducerError,
  CallbackError,
  AcquisitionError,
  ?FactoryRequirements,
  ?ProducerRequirements,
  ?CallbackRequirements,
  ?AcquisitionRequirements,
  Producer: BodyProducer<ProducerError ? ProducerRequirements>,
  H: HybridResponseHandler<RoutedP, DirectP, A, CallbackError ? CallbackRequirements> + 'env,
  C: HybridAttemptClient<'policy, RoutedP, DirectP, AttemptStep<'policy, A>, RedirectError | ValueError | ProducerError | CallbackError | ClientError | OutOfMemoryError, AcquisitionError, AcquisitionRequirements ? ProducerRequirements | CallbackRequirements | &mut SelectedBody<
    ProducerError,
    ProducerRequirements,
  > | &mut MonotonicClock | &mut Allocator | &mut Random>,
  Factory: ReplayFactory<Producer, FactoryError, FactoryRequirements> + 'env,
  'env,
>(
  client: &'client mut C,
  request: Request<'uri, 'method, 'headers, 'policy>,
  policy: &'policy Policy,
  factory: Factory,
  deadline: Option<Instant>,
  scratch: &'scratch mut [u8],
  handler: H,
) -> A
! RedirectError | ValueError | FactoryError | ProducerError | CallbackError | ClientError | OutOfMemoryError | AcquisitionError
? FactoryRequirements | ProducerRequirements | CallbackRequirements | AcquisitionRequirements | &mut MonotonicClock | &mut Allocator | &mut Random
where
  &mut RoutedP provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut RoutedP provides &HttpTransport from &mut HttpTransport,
  &mut RoutedP provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut RoutedP provides &ByteDuplex from &mut ByteDuplex,
  &mut DirectP provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut DirectP provides &HttpTransport from &mut HttpTransport,
  FactoryRequirements in Without<FactoryRequirements, ByteDuplex>,
  FactoryRequirements in Without<FactoryRequirements, HttpTransport>,
  ProducerRequirements in Without<ProducerRequirements, ByteDuplex>,
  ProducerRequirements in Without<ProducerRequirements, HttpTransport>,
  CallbackRequirements in Without<CallbackRequirements, ByteDuplex>,
  CallbackRequirements in Without<CallbackRequirements, HttpTransport>,
  AcquisitionRequirements in Without<AcquisitionRequirements, ByteDuplex>,
  AcquisitionRequirements in Without<AcquisitionRequirements, HttpTransport> {
  let hasScratch = scratch.length != usize.ZERO
  let mut callback = move handler
  let mut dispatch = HybridAttemptDispatch<
    RoutedP,
    DirectP,
    A,
    C,
    H,
    ProducerError,
    CallbackError,
    AcquisitionError,
    ProducerRequirements,
    CallbackRequirements,
    AcquisitionRequirements,
  > {policy: policy, client: &mut client.*, scratch: &mut scratch, callback: &mut callback}
  return run runResponseLoop<
    'policy,
    RoutedP,
    A,
    ProducerError,
    FactoryError,
    CallbackError,
    AcquisitionError,
    ProducerRequirements,
    FactoryRequirements,
    CallbackRequirements,
    AcquisitionRequirements,
  >(
    &mut dispatch,
    move request,
    policy,
    ReplayPlan<
      RoutedP,
      ProducerError,
      AttemptStep<'policy, A>,
      FactoryError,
      RedirectError | ValueError | ProducerError | CallbackError | ClientError | OutOfMemoryError | AcquisitionError,
      ProducerRequirements,
      FactoryRequirements,
      ProducerRequirements | CallbackRequirements | AcquisitionRequirements | &mut AttemptDispatch<'policy, RedirectAttemptHandler<
        'policy,
        ProducerError,
        ProducerRequirements,
      >, AttemptStep<'policy, A>, RedirectError | ValueError | ProducerError | CallbackError | ClientError | OutOfMemoryError | AcquisitionError ? ProducerRequirements | CallbackRequirements | AcquisitionRequirements | &mut SelectedBody<
        ProducerError,
        ProducerRequirements,
      > | &mut MonotonicClock | &mut Allocator | &mut Random> | &mut MonotonicClock | &mut Allocator | &mut Random,
      Factory,
      Producer,
      SelectedAttemptHandler<
        'policy,
        ProducerError,
        ProducerRequirements,
        RoutedP,
        A,
        CallbackError,
        AcquisitionError,
        CallbackRequirements,
        AcquisitionRequirements,
      >,
    > {factory: move factory, retained: true},
    move deadline,
    hasScratch,
  )
}

fn attemptBodyMode<
  'bytes,
  'oneShot,
  'replay,
  OneShotError,
  ReplayError,
  ?OneShotRequirements,
  ?ReplayRequirements,
  OneShot: BodyProducer<OneShotError ? OneShotRequirements>,
  ReplayProducer: BodyProducer<ReplayError ? ReplayRequirements>,
>(body: &AttemptBody<'bytes, 'oneShot, 'replay, OneShot, ReplayProducer>) -> BodyMode {
  return match & body.* {
    AttemptBody.Empty => BodyMode.Empty
    AttemptBody.RepeatableBytes {bytes, offset} => {
      drop offset
      return BodyMode.KnownLength {length: usize.toU64(bytes.length)}
    }
    AttemptBody.OneShot {producer: oneShot} => BodyProducer<OneShotError ? OneShotRequirements>.mode(
      &oneShot,
    )
    AttemptBody.ReplayFactory {producer: replayProducer} => BodyProducer<ReplayError ? ReplayRequirements>.mode(
      &replayProducer,
    )
  }
}

struct AttemptBodyCursor<'bytes, 'oneShot, 'replay, OneShot, ReplayProducer> {
  body: AttemptBody<'bytes, 'oneShot, 'replay, OneShot, ReplayProducer>
  offset: usize
}

effect fn pullAttemptBody<
  'bytes,
  'oneShot,
  'replay,
  OneShotError,
  ReplayError,
  ?OneShotRequirements,
  ?ReplayRequirements,
  OneShot: BodyProducer<OneShotError ? OneShotRequirements>,
  ReplayProducer: BodyProducer<ReplayError ? ReplayRequirements>,
>(
  cursor: &mut AttemptBodyCursor<'bytes, 'oneShot, 'replay, OneShot, ReplayProducer>,
  output: &mut [u8],
) -> BodyChunk ! OneShotError | ReplayError ? OneShotRequirements | ReplayRequirements {
  return match &mut cursor.body {
    AttemptBody.Empty => BodyChunk {length: usize.ZERO, end: true}
    AttemptBody.RepeatableBytes {bytes, offset} => {
      drop offset
      let remaining = bytes.length - cursor.offset
      let mut length = remaining
      if output.length < length {
        length = output.length
      }
      let mut index = usize.ZERO
      while index < length {
        output[index] = bytes[cursor.offset + index]
        index = index + usize.ONE
      }
      cursor.offset = cursor.offset + length
      return BodyChunk {length: length, end: cursor.offset == bytes.length}
    }
    AttemptBody.OneShot {producer: oneShot} => run BodyProducer<OneShotError ? OneShotRequirements>.pull(
      &mut oneShot,
      move output,
    )
    AttemptBody.ReplayFactory {producer: replayProducer} => run BodyProducer<ReplayError ? ReplayRequirements>.pull(
      &mut replayProducer,
      move output,
    )
  }
}

fn bodyModesEqual(left: BodyMode, right: BodyMode) -> bool {
  return match move left {
    BodyMode.Empty => match move right {
      BodyMode.Empty => true
      _ => false
    }
    BodyMode.KnownLength {length} => match move right {
      BodyMode.KnownLength {length: other} => length == other
      _ => false
    }
    BodyMode.Chunked => match move right {
      BodyMode.Chunked => true
      _ => false
    }
  }
}

fn bodyModesEqualRef(left: &BodyMode, right: &BodyMode) -> bool {
  return match & left.* {
    BodyMode.Empty => match & right.* {
      BodyMode.Empty => true
      _ => false
    }
    BodyMode.KnownLength {length} => match & right.* {
      BodyMode.KnownLength {length: other} => length == other
      _ => false
    }
    BodyMode.Chunked => match & right.* {
      BodyMode.Chunked => true
      _ => false
    }
  }
}

fn bodyModeEmpty(mode: &BodyMode) -> bool {
  return match & mode.* {
    BodyMode.Empty => true
    _ => false
  }
}

fn bodyContractFailure(hop: usize) -> RedirectError {
  return failure(
    RedirectComponent.Body,
    RedirectReason.ReplayContractMismatch,
    hop,
    Option.none<Status>(),
  )
}

fn attemptBodyMatches<
  'bytes,
  'oneShot,
  'replay,
  OneShotError,
  ReplayError,
  ?OneShotRequirements,
  ?ReplayRequirements,
  OneShot: BodyProducer<OneShotError ? OneShotRequirements>,
  ReplayProducer: BodyProducer<ReplayError ? ReplayRequirements>,
>(expected: &BodyMode, body: &AttemptBody<'bytes, 'oneShot, 'replay, OneShot, ReplayProducer>) -> bool {
  return match & body.* {
    AttemptBody.Empty => bodyModeEmpty(expected)
    AttemptBody.RepeatableBytes {bytes, offset} => {
      drop offset
      let actual = BodyMode.KnownLength {length: usize.toU64(bytes.length)}
      return bodyModesEqualRef(expected, &actual)
    }
    AttemptBody.OneShot {producer: oneShot} => {
      if bodyModeEmpty(expected) {
        return false
      }
      let actual = BodyProducer<OneShotError ? OneShotRequirements>.mode(&oneShot)
      return bodyModesEqualRef(expected, &actual)
    }
    AttemptBody.ReplayFactory {producer: replayProducer} => {
      if bodyModeEmpty(expected) {
        return false
      }
      let actual = BodyProducer<ReplayError ? ReplayRequirements>.mode(&replayProducer)
      return bodyModesEqualRef(expected, &actual)
    }
  }
}

/// Drives one admitted attempt from prepared head through the first final response.
///
/// # When to use
///
/// Use inside an attempt client's exchange callback after selecting one [`AttemptBody`].
///
/// # Details
///
/// The operation validates the selected and produced framing before sending the head. Require100
/// informational responses are consumed until 100 permits upload or a final response returns
/// `EarlyFinal`. Redirect bodies do not admit trailers, so non-empty `trailers` are rejected before
/// the head is sent. Produced chunks must fit `scratch`; known-length excess is rejected before it
/// can be written, and every completed upload finishes exactly once before receiving its final
/// head. Empty attempts never inspect or pull a producer. Locally created body-contract failures
/// copy the already bounded `current` URI into their owned redirect context.
///
/// # Gotchas
///
/// `scratch` must be non-empty for KnownLength and Chunked bodies. A zero-length nonterminal pull
/// is a producer contract failure. An early final consumes the enclosing attempt's OneShot
/// authority even though this operation has not called `pull`.
pub effect<'env> fn writeBody<
  'bytes,
  'oneShot,
  'replay,
  'exchange,
  P,
  OneShotError,
  ReplayError,
  ?OneShotRequirements,
  ?ReplayRequirements,
  OneShot: BodyProducer<OneShotError ? OneShotRequirements> + 'env,
  ReplayProducer: BodyProducer<ReplayError ? ReplayRequirements> + 'env,
  'env,
>(
  exchange: &mut Exchange<'exchange, P>,
  current: &Uri,
  expected: BodyMode,
  body: AttemptBody<'bytes, 'oneShot, 'replay, OneShot, ReplayProducer>,
  scratch: &mut [u8],
  trailers: &Headers,
  hop: usize,
) -> BodyWriteOutcome
! RedirectError | OneShotError | ReplayError | ClientError | OutOfMemoryError
? OneShotRequirements | ReplayRequirements | &mut MonotonicClock | &mut Allocator | &mut Random
where
  &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random {
  if !attemptBodyMatches<
    'bytes,
    'oneShot,
    'replay,
    OneShotError,
    ReplayError,
    OneShotRequirements,
    ReplayRequirements,
    OneShot,
    ReplayProducer,
  >(&expected, &body) {
    let enriched = run enrichCurrent(bodyContractFailure(hop), current)
    fail move enriched
  }
  if Headers.count(trailers) != usize.ZERO {
    let enriched = run enrichCurrent(bodyContractFailure(hop), current)
    fail move enriched
  }
  let empty = bodyModeEmpty(&expected)
  if !empty && scratch.length == usize.ZERO {
    let enriched = run enrichCurrent(bodyContractFailure(hop), current)
    fail move enriched
  }

  let offset = match & body {
    AttemptBody.RepeatableBytes {offset, ..} => offset
    _ => usize.ZERO
  }
  let mut selectedBody = AttemptBodyCursor<'bytes, 'oneShot, 'replay, OneShot, ReplayProducer> {
    body: move body,
    offset: offset,
  }
  run Client.send(&mut exchange.*)
  while exchange.phase() == ExchangePhase.AwaitContinue {
    let status = run Client.receive(&mut exchange.*)
    if status >= 200 {
      if exchange.phase() != ExchangePhase.Response {
        Client.abort(&mut exchange.*)
        fail ClientError.InvalidState
      }
      return BodyWriteOutcome.EarlyFinal {status: status}
    }
  }

  let mut observed = u64.MIN
  if !empty {
    while true {
      let pulled = run Effect.result(
        pullAttemptBody<
          'bytes,
          'oneShot,
          'replay,
          OneShotError,
          ReplayError,
          OneShotRequirements,
          ReplayRequirements,
          OneShot,
          ReplayProducer,
        >(&mut selectedBody, &mut scratch),
      )
      let chunk = match move pulled {
        Result.Success {value} => move value
        Result.Failure {error} => {
          Client.abort(&mut exchange.*)
          fail move error
        }
      }
      if chunk.length > scratch.length || (chunk.length == usize.ZERO && !chunk.end) {
        Client.abort(&mut exchange.*)
        let enriched = run enrichCurrent(bodyContractFailure(hop), current)
        fail move enriched
      }
      let nextObserved = match move u64.checkedAdd(observed, usize.toU64(chunk.length)) {
        Option.None => {
          Client.abort(&mut exchange.*)
          let enriched = run enrichCurrent(bodyContractFailure(hop), current)
          fail move enriched
        }
        Option.Some {value} => value
      }
      if let BodyMode.KnownLength {length} = &expected {
        if nextObserved > length {
          Client.abort(&mut exchange.*)
          let enriched = run enrichCurrent(bodyContractFailure(hop), current)
          fail move enriched
        }
      }

      let input = Slice.view<u8>(&scratch, usize.ZERO, chunk.length)
      let mut consumed = usize.ZERO
      while consumed < input.length {
        let remaining = Slice.view<u8>(input, consumed, input.length - consumed)
        let progress = run Client.writeSome(&mut exchange.*, remaining)
        consumed = consumed + progress.consumed
        drop remaining
      }
      drop input
      observed = nextObserved
      if chunk.end {
        break
      }
    }
  }

  if let BodyMode.KnownLength {length} = &expected {
    if observed != length {
      Client.abort(&mut exchange.*)
      let enriched = run enrichCurrent(bodyContractFailure(hop), current)
      fail move enriched
    }
  }
  run Client.finishRequest(&mut exchange.*, trailers)
  let status = run Client.receiveFinal(&mut exchange.*)
  if exchange.phase() != ExchangePhase.Response {
    Client.abort(&mut exchange.*)
    fail ClientError.InvalidState
  }
  return BodyWriteOutcome.Completed {status: status}
}

/// Whether the current response is final or selects redirect transition processing.
pub enum StatusDecision {
  /// Returns the current response without inspecting `Location`.
  Final,
  /// Applies redirect transition processing.
  Redirect,
}

/// Whether the next attempt retains or drops the current body.
pub enum BodyDecision {
  /// Retains framing and requires repeatability for a later attempt.
  Retain,
  /// Drops the source and every content-associated field.
  Drop,
}

/// A selected next method and body disposition.
pub struct Transition<'method> {
  /// Exact next method, either preserved or the canonical GET/HEAD value.
  pub method: Method<'method>
  /// Whether content remains part of the next attempt.
  pub body: BodyDecision
}

impl<'method> Copy for Transition<'method> {}

fn emptyContext(hop: usize, status: Option<Status>) -> RedirectContext {
  return RedirectContext {
    hop: hop,
    status: move status,
    currentUri: Option.none<OwnedUri>(),
    nextUri: Option.none<OwnedUri>(),
  }
}

fn failure(component: RedirectComponent, reason: RedirectReason, hop: usize, status: Option<Status>) -> RedirectError {
  return RedirectError {
    component: component,
    reason: move reason,
    context: emptyContext(hop, move status),
  }
}

fn limitFailure(
  component: RedirectComponent,
  limit: RedirectLimit,
  allowed: usize,
  attempted: usize,
) -> RedirectError {
  return failure(
    component,
    RedirectReason.LimitExceeded {limit: limit, allowed: allowed, attempted: attempted},
    usize.ZERO,
    Option.none<Status>(),
  )
}

fn folded(value: u8) -> u8 {
  if value >= 65 && value <= 90 {
    return value + 32
  }
  return value
}

fn foldedEqual(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut index = usize.ZERO
  while index < left.length {
    if folded(left[index]) != folded(right[index]) {
      return false
    }
    index = index + usize.ONE
  }
  return true
}

fn tokenByte(value: u8) -> bool {
  if value >= 65 && value <= 90 {
    return true
  }
  if value >= 97 && value <= 122 {
    return true
  }
  if value >= 48 && value <= 57 {
    return true
  }
  return value == 33 || value == 35 || value == 36 || value == 37 || value == 38 || value == 39 || value == 42 || value == 43 || value == 45 || value == 46 || value == 94 || value == 95 || value == 96 || value == 124 || value == 126
}

fn validName(value: string) -> bool {
  let bytes = String.utf8Bytes(value)
  if bytes.length == usize.ZERO {
    return false
  }
  let mut index = usize.ZERO
  while index < bytes.length {
    if !tokenByte(bytes[index]) {
      return false
    }
    index = index + usize.ONE
  }
  return true
}

impl NameList {
  /// Creates an empty admitted list without allocating.
  pub fn empty() -> NameList {
    return NameList {values: Vector.make<String>(), ownedBytesValue: usize.ZERO}
  }
  /// Validates and copies field names under exact count, per-name, and owned-byte boundaries.
  pub effect fn copy(names: &[string], limits: NameListLimits) -> Result<NameList, RedirectError>
  ! OutOfMemoryError
  ? &mut Allocator {
    if names.length > limits.maxNames {
      return Result.failResult<NameList, RedirectError>(
        limitFailure(
          RedirectComponent.Policy,
          RedirectLimit.PolicyNames,
          limits.maxNames,
          names.length,
        ),
      )
    }
    let records = match move usize.checkedMultiply(Layout.of<String>().bytes, names.length) {
      Option.None => {
        return Result.failResult<NameList, RedirectError>(
          failure(
            RedirectComponent.Policy,
            RedirectReason.SizeOverflow,
            usize.ZERO,
            Option.none<Status>(),
          ),
        )
      }
      Option.Some {value} => value
    }
    let mut ownedBytes = records
    let mut index = usize.ZERO
    while index < names.length {
      let length = String.byteLength(names[index])
      if length > limits.maxNameBytes {
        return Result.failResult<NameList, RedirectError>(
          limitFailure(
            RedirectComponent.Policy,
            RedirectLimit.PolicyNameBytes,
            limits.maxNameBytes,
            length,
          ),
        )
      }
      if !validName(names[index]) {
        return Result.failResult<NameList, RedirectError>(
          failure(
            RedirectComponent.Policy,
            RedirectReason.InvalidPolicy,
            usize.ZERO,
            Option.none<Status>(),
          ),
        )
      }
      ownedBytes = match move usize.checkedAdd(ownedBytes, length) {
        Option.None => {
          return Result.failResult<NameList, RedirectError>(
            failure(
              RedirectComponent.Policy,
              RedirectReason.SizeOverflow,
              usize.ZERO,
              Option.none<Status>(),
            ),
          )
        }
        Option.Some {value} => value
      }
      if ownedBytes > limits.maxOwnedBytes {
        return Result.failResult<NameList, RedirectError>(
          limitFailure(
            RedirectComponent.Policy,
            RedirectLimit.PolicyOwnedBytes,
            limits.maxOwnedBytes,
            ownedBytes,
          ),
        )
      }
      index = index + usize.ONE
    }
    let mut copied = Vector.make<String>()
    let reserved = run Vector.reserveExact<String>(&mut copied, names.length)
    index = usize.ZERO
    while index < names.length {
      let value = run String.copy(names[index])
      let appended = run Vector.append<String>(&mut copied, move value)
      index = index + usize.ONE
    }
    return Result.succeed<NameList, RedirectError>(
      NameList {values: move copied, ownedBytesValue: ownedBytes},
    )
  }
  /// Reports ASCII case-insensitive membership without allocating.
  pub fn contains(self: &Self, name: string) -> bool {
    let names = Vector.asSlice<String>(&self.values)
    let sought = String.utf8Bytes(name)
    let mut index = usize.ZERO
    while index < names.length {
      if foldedEqual(String.ownedUtf8Bytes(&names[index]), sought) {
        return true
      }
      index = index + usize.ONE
    }
    return false
  }
  /// Returns the number of owned names.
  pub fn count(self: &Self) -> usize {
    return Vector.length<String>(&self.values)
  }
  /// Returns accounted payload plus index storage bytes.
  pub fn ownedBytes(self: &Self) -> usize {
    return self.ownedBytesValue
  }
}

fn listsOverlap(left: &NameList, right: &NameList) -> bool {
  let names = Vector.asSlice<String>(&left.values)
  let mut index = usize.ZERO
  while index < names.length {
    if NameList.contains(right, String.view(&names[index])) {
      return true
    }
    index = index + usize.ONE
  }
  return false
}

impl Policy {
  /// Returns Manual policy with the standard finite redirect limits and no admitted custom names.
  ///
  /// # Details
  ///
  /// The result permits 10 hops, 8192 URI bytes, and 90112 history bytes. It denies origin changes
  /// and downgrades, preserves POST for 301 and 302, and closes intermediate responses. Both owned
  /// name lists are empty.
  pub fn defaults() -> Policy {
    return Policy {
      modeValue: Mode.Manual,
      historyValue: HistoryLimits {maxHops: 10, maxUriBytes: 8192, maxHistoryBytes: 90112},
      crossOriginValue: CrossOriginPolicy.Deny,
      downgradeValue: DowngradePolicy.Deny,
      post301302Value: Post301302Policy.Preserve,
      previousResponseValue: PreviousResponsePolicy.Close,
      safeCustomValue: NameList.empty(),
      sensitiveValue: NameList.empty(),
    }
  }
  /// Admits an immutable policy, rejecting list overlap and hop-count overflow before I/O.
  pub fn make(
    mode: Mode,
    history: HistoryLimits,
    crossOrigin: CrossOriginPolicy,
    downgrade: DowngradePolicy,
    post301302: Post301302Policy,
    previousResponse: PreviousResponsePolicy,
    safeCustom: NameList,
    sensitive: NameList,
  ) -> Result<Policy, RedirectError> {
    let entries = match move usize.checkedAdd(history.maxHops, usize.ONE) {
      Option.None => {
        return Result.failResult<Policy, RedirectError>(
          failure(
            RedirectComponent.History,
            RedirectReason.SizeOverflow,
            usize.ZERO,
            Option.none<Status>(),
          ),
        )
      }
      Option.Some {value} => value
    }
    drop entries
    if listsOverlap(&safeCustom, &sensitive) {
      return Result.failResult<Policy, RedirectError>(
        failure(
          RedirectComponent.Policy,
          RedirectReason.NameListOverlap,
          usize.ZERO,
          Option.none<Status>(),
        ),
      )
    }
    return Result.succeed<Policy, RedirectError>(
      Policy {
        modeValue: mode,
        historyValue: history,
        crossOriginValue: crossOrigin,
        downgradeValue: downgrade,
        post301302Value: post301302,
        previousResponseValue: move previousResponse,
        safeCustomValue: move safeCustom,
        sensitiveValue: move sensitive,
      },
    )
  }
  /// Returns whether responses are returned manually or followed.
  pub fn mode(self: &Self) -> Mode {
    return self.modeValue
  }
  /// Returns admitted URI, history, and hop capacities.
  pub fn historyLimits(self: &Self) -> HistoryLimits {
    return self.historyValue
  }
  /// Returns cross-origin admission policy.
  pub fn crossOrigin(self: &Self) -> CrossOriginPolicy {
    return self.crossOriginValue
  }
  /// Returns HTTPS-to-HTTP downgrade policy.
  pub fn downgrade(self: &Self) -> DowngradePolicy {
    return self.downgradeValue
  }
  /// Returns exact POST behavior for 301 and 302.
  pub fn post301302(self: &Self) -> Post301302Policy {
    return self.post301302Value
  }
  /// Borrows intermediate-response cleanup policy.
  pub fn previousResponse(self: &Self) -> &PreviousResponsePolicy {
    return &self.previousResponseValue
  }
  /// Borrows the admitted cross-origin safe-custom field names.
  pub fn safeCustom(self: &Self) -> &NameList {
    return &self.safeCustomValue
  }
  /// Borrows the admitted always-sensitive field names.
  pub fn sensitive(self: &Self) -> &NameList {
    return &self.sensitiveValue
  }
}

fn redirectStatus(status: &Status) -> bool {
  let code = Status.code(status)
  return code == 301 || code == 302 || code == 303 || code == 307 || code == 308
}

/// Classifies a response status without inspecting `Location` and enforces selected-hop capacity.
pub fn statusDecision(policy: &Policy, status: Status, followedHops: usize) -> Result<
  StatusDecision,
  RedirectError,
> {
  if Policy.mode(policy) == Mode.Manual || !redirectStatus(&status) {
    return Result.succeed<StatusDecision, RedirectError>(StatusDecision.Final)
  }
  if followedHops >= Policy.historyLimits(policy).maxHops {
    return Result.failResult<StatusDecision, RedirectError>(
      failure(
        RedirectComponent.Policy,
        RedirectReason.HopLimit,
        followedHops,
        Option.some<Status>(status),
      ),
    )
  }
  return Result.succeed<StatusDecision, RedirectError>(StatusDecision.Redirect)
}

/// Computes the exact RFC redirect method and body transition for a selected status.
pub fn transition<'method>(policy: &Policy, status: Status, method: Method<'method>) -> Transition<
  'method,
> {
  let code = Status.code(&status)
  if code == 303 {
    if Method.equals(&method, &Method.head()) {
      return Transition<'method> {method: method, body: BodyDecision.Drop}
    }
    return Transition<'method> {method: Method.get(), body: BodyDecision.Drop}
  }
  if (code == 301 || code == 302) && Policy.post301302(policy) == Post301302Policy.ToGet && Method.equals(
    &method,
    &Method.post(),
  ) {
    return Transition<'method> {method: Method.get(), body: BodyDecision.Drop}
  }
  return Transition<'method> {method: method, body: BodyDecision.Retain}
}

fn optionalPresent<T>(value: Option<T>) -> bool {
  return match move value {
    Option.None => false
    Option.Some {value: present} => true
  }
}

fn extractLocation<'head>(headers: &Headers<'head>, maxUriBytes: usize, hop: usize, status: Status) -> Result<
  &'head [u8],
  RedirectError,
> {
  let mut selected = Option.none<&'head [u8]>()
  let mut count = usize.ZERO
  let mut iterator = Headers.getAll(headers, "location")
  while true {
    let next = HeaderIterator.next(&mut iterator)
    match move next {
      Option.None => {
        break
      }
      Option.Some {value} => {
        count = match move usize.checkedAdd(count, usize.ONE) {
          Option.None => {
            return Result.failResult<&'head [u8], RedirectError>(
              failure(
                RedirectComponent.Location,
                RedirectReason.SizeOverflow,
                hop,
                Option.some<Status>(status),
              ),
            )
          }
          Option.Some {value: incremented} => incremented
        }
        if count > usize.ONE {
          return Result.failResult<&'head [u8], RedirectError>(
            failure(
              RedirectComponent.Location,
              RedirectReason.LocationAmbiguous,
              hop,
              Option.some<Status>(status),
            ),
          )
        }
        selected = Option.some<&'head [u8]>(Header.value(&value))
      }
    }
  }
  let value = match move selected {
    Option.None => {
      return Result.failResult<&'head [u8], RedirectError>(
        failure(
          RedirectComponent.Location,
          RedirectReason.LocationMissing,
          hop,
          Option.some<Status>(status),
        ),
      )
    }
    Option.Some {value} => value
  }
  if value.length > maxUriBytes {
    return Result.failResult<&'head [u8], RedirectError>(
      RedirectError {
        component: RedirectComponent.Location,
        reason: RedirectReason.LimitExceeded {
          limit: RedirectLimit.UriBytes,
          allowed: maxUriBytes,
          attempted: value.length,
        },
        context: emptyContext(hop, Option.some<Status>(status)),
      },
    )
  }
  return Result.succeed<&'head [u8], RedirectError>(value)
}

effect fn appendInheritedFragment(
  output: &mut Bytes,
  base: &Uri,
  reference: &UriReference,
  maxUriBytes: usize,
  hop: usize,
  status: Status,
) -> Result<(), RedirectError> ! OutOfMemoryError ? &mut Allocator {
  if optionalPresent<string>(UriReference.fragment(reference)) {
    return Result.succeed<(), RedirectError>(())
  }
  let fragment = match move Uri.fragment(base) {
    Option.None => {
      return Result.succeed<(), RedirectError>(())
    }
    Option.Some {value} => value
  }
  let withMarker = match move usize.checkedAdd(Bytes.length(&output.*), usize.ONE) {
    Option.None => {
      return Result.failResult<(), RedirectError>(
        failure(
          RedirectComponent.Uri,
          RedirectReason.SizeOverflow,
          hop,
          Option.some<Status>(status),
        ),
      )
    }
    Option.Some {value} => value
  }
  let required = match move usize.checkedAdd(withMarker, String.byteLength(fragment)) {
    Option.None => {
      return Result.failResult<(), RedirectError>(
        failure(
          RedirectComponent.Uri,
          RedirectReason.SizeOverflow,
          hop,
          Option.some<Status>(status),
        ),
      )
    }
    Option.Some {value} => value
  }
  if required > maxUriBytes {
    return Result.failResult<(), RedirectError>(
      RedirectError {
        component: RedirectComponent.Uri,
        reason: RedirectReason.LimitExceeded {
          limit: RedirectLimit.UriBytes,
          allowed: maxUriBytes,
          attempted: required,
        },
        context: emptyContext(hop, Option.some<Status>(status)),
      },
    )
  }
  let marker = b"#"
  let wroteMarker = run Bytes.append(&mut output.*, marker)
  let wroteFragment = run Bytes.append(&mut output.*, String.utf8Bytes(fragment))
  return Result.succeed<(), RedirectError>(())
}

fn originFailure(error: OriginError) -> RedirectReason {
  return match move error {
    OriginError.InvalidScheme => RedirectReason.RedirectSchemeDenied
    _ => RedirectReason.LocationInvalid
  }
}

/// Returns one independently owned HTTP or HTTPS URI from the selected response `Location`.
///
/// # When to use
///
/// Use while the selected response head is live and before the next route is acquired.
///
/// # Details
///
/// The operation requires exactly one field and copies it under `maxUriBytes`. It applies RFC 3986
/// resolution, rejects a resolved serialization above the same bound, and admits only HTTP or
/// HTTPS origins with a host, effective port, and no user information. It inherits the current
/// fragment only when the reference has no fragment.
///
/// # Gotchas
///
/// A present empty fragment replaces the current fragment. The operation does not change `current`.
pub effect fn resolveLocation<'head>(
  current: &Uri,
  headers: &Headers<'head>,
  limits: HistoryLimits,
  hop: usize,
  status: Status,
) -> Result<OwnedUri, RedirectError> ! OutOfMemoryError ? &mut Allocator {
  let raw = match move extractLocation(headers, limits.maxUriBytes, hop, status) {
    Result.Failure {error} => {
      return Result.failResult<OwnedUri, RedirectError>(move error)
    }
    Result.Success {value} => value
  }
  let text = match move String.fromUtf8(raw) {
    Result.Failure {error} => {
      return Result.failResult<OwnedUri, RedirectError>(
        failure(
          RedirectComponent.Location,
          RedirectReason.LocationInvalid,
          hop,
          Option.some<Status>(status),
        ),
      )
    }
    Result.Success {value} => value
  }
  let rawOwned = run String.copy(text)
  let reference = match move UriReference.parse(String.view(&rawOwned)) {
    Result.Failure {error} => {
      return Result.failResult<OwnedUri, RedirectError>(
        failure(
          RedirectComponent.Location,
          RedirectReason.LocationInvalid,
          hop,
          Option.some<Status>(status),
        ),
      )
    }
    Result.Success {value} => value
  }
  let combinedBound = match move usize.checkedAdd(
    String.byteLength(Uri.format(current)),
    raw.length,
  ) {
    Option.None => {
      return Result.failResult<OwnedUri, RedirectError>(
        failure(
          RedirectComponent.Uri,
          RedirectReason.SizeOverflow,
          hop,
          Option.some<Status>(status),
        ),
      )
    }
    Option.Some {value} => value
  }
  match move usize.checkedAdd(combinedBound, usize.ONE) {
    Option.None => {
      return Result.failResult<OwnedUri, RedirectError>(
        failure(
          RedirectComponent.Uri,
          RedirectReason.SizeOverflow,
          hop,
          Option.some<Status>(status),
        ),
      )
    }
    Option.Some {value} => {
      drop value
    }
  }
  let mut output = Bytes.make()
  match move run Uri.resolveInto(&mut output, current, &reference) {
    Result.Failure {error} => {
      return Result.failResult<OwnedUri, RedirectError>(
        failure(
          RedirectComponent.Location,
          RedirectReason.LocationInvalid,
          hop,
          Option.some<Status>(status),
        ),
      )
    }
    Result.Success {value} => {}
  }
  let inherited = run appendInheritedFragment(
    &mut output,
    current,
    &reference,
    limits.maxUriBytes,
    hop,
    status,
  )
  match move inherited {
    Result.Failure {error} => {
      return Result.failResult<OwnedUri, RedirectError>(move error)
    }
    Result.Success {value} => {}
  }
  let resolvedLength = Bytes.length(&output)
  if resolvedLength > limits.maxUriBytes {
    return Result.failResult<OwnedUri, RedirectError>(
      RedirectError {
        component: RedirectComponent.Uri,
        reason: RedirectReason.LimitExceeded {
          limit: RedirectLimit.UriBytes,
          allowed: limits.maxUriBytes,
          attempted: resolvedLength,
        },
        context: emptyContext(hop, Option.some<Status>(status)),
      },
    )
  }
  let resolvedText = unsafe String.fromUtf8Unchecked(Bytes.asSlice(&output))
  let parsed = match move Uri.parse(resolvedText) {
    Result.Failure {error} => {
      return Result.failResult<OwnedUri, RedirectError>(
        failure(
          RedirectComponent.Uri,
          RedirectReason.LocationInvalid,
          hop,
          Option.some<Status>(status),
        ),
      )
    }
    Result.Success {value} => value
  }
  match move Origin.fromUri(&parsed) {
    Result.Failure {error} => {
      return Result.failResult<OwnedUri, RedirectError>(
        failure(RedirectComponent.Origin, originFailure(error), hop, Option.some<Status>(status)),
      )
    }
    Result.Success {value} => {
      drop value
    }
  }
  let ownedText = unsafe String.fromBytesUnchecked(move output)
  return match move OwnedUri.fromString(move ownedText) {
    Result.Failure {error} => Result.failResult<OwnedUri, RedirectError>(
      failure(
        RedirectComponent.Uri,
        RedirectReason.LocationInvalid,
        hop,
        Option.some<Status>(status),
      ),
    )
    Result.Success {value} => Result.succeed<OwnedUri, RedirectError>(move value)
  }
}

/// Validates cross-origin and downgrade policy and reports whether sanitization is cross-origin.
pub fn admitOrigin(policy: &Policy, current: &Origin, next: &Origin, hop: usize, status: Status) -> Result<
  bool,
  RedirectError,
> {
  if Origin.equals(current, next) {
    return Result.succeed<bool, RedirectError>(false)
  }
  if Policy.crossOrigin(policy) == CrossOriginPolicy.Deny {
    return Result.failResult<bool, RedirectError>(
      failure(
        RedirectComponent.Origin,
        RedirectReason.RedirectOriginDenied,
        hop,
        Option.some<Status>(status),
      ),
    )
  }
  if Origin.secure(current) && !Origin.secure(next) && Policy.downgrade(policy) == DowngradePolicy.Deny {
    return Result.failResult<bool, RedirectError>(
      failure(
        RedirectComponent.Origin,
        RedirectReason.DowngradeDenied,
        hop,
        Option.some<Status>(status),
      ),
    )
  }
  return Result.succeed<bool, RedirectError>(true)
}

/// Bounded method-aware redirect-loop history in one preallocated byte arena.
pub struct History {
  arena: Bytes
  limits: HistoryLimits
  maxEntriesValue: usize
  countValue: usize
}

fn targetLength(uri: &Uri) -> Result<usize, RedirectError> {
  let pathLength = String.byteLength(Uri.path(uri))
  let mut length = pathLength
  if pathLength == usize.ZERO {
    length = usize.ONE
  }
  return match move Uri.query(uri) {
    Option.None => Result.succeed<usize, RedirectError>(length)
    Option.Some {value} => {
      let marked = match move usize.checkedAdd(length, usize.ONE) {
        Option.None => {
          return Result.failResult<usize, RedirectError>(
            failure(
              RedirectComponent.History,
              RedirectReason.SizeOverflow,
              usize.ZERO,
              Option.none<Status>(),
            ),
          )
        }
        Option.Some {value: total} => total
      }
      return match move usize.checkedAdd(marked, String.byteLength(value)) {
        Option.None => Result.failResult<usize, RedirectError>(
          failure(
            RedirectComponent.History,
            RedirectReason.SizeOverflow,
            usize.ZERO,
            Option.none<Status>(),
          ),
        )
        Option.Some {value: total} => Result.succeed<usize, RedirectError>(total)
      }
    }
  }
}

fn targetRangeEqual(storage: &[u8], start: usize, end: usize, uri: &Uri) -> bool {
  let path = String.utf8Bytes(Uri.path(uri))
  if end < start {
    return false
  }
  let targetLength = end - start
  let mut cursor = usize.ZERO
  if path.length == usize.ZERO {
    if targetLength == usize.ZERO || storage[start] != 47 {
      return false
    }
    cursor = usize.ONE
  } else {
    if targetLength < path.length {
      return false
    }
    let mut index = usize.ZERO
    while index < path.length {
      if storage[start + index] != path[index] {
        return false
      }
      index = index + usize.ONE
    }
    cursor = path.length
  }
  return match move Uri.query(uri) {
    Option.None => cursor == targetLength
    Option.Some {value} => {
      let query = String.utf8Bytes(value)
      if cursor >= targetLength || storage[start + cursor] != 63 {
        return false
      }
      cursor = cursor + usize.ONE
      if targetLength - cursor != query.length {
        return false
      }
      let mut index = usize.ZERO
      while index < query.length {
        if storage[start + cursor + index] != query[index] {
          return false
        }
        index = index + usize.ONE
      }
      return true
    }
  }
}

effect fn writeTarget(output: &mut Bytes, uri: &Uri) -> () ! OutOfMemoryError ? &mut Allocator {
  let path = String.utf8Bytes(Uri.path(uri))
  if path.length == usize.ZERO {
    let wroteSlash = run Bytes.append(&mut output.*, b"/")
  } else {
    let wrotePath = run Bytes.append(&mut output.*, path)
  }
  match move Uri.query(uri) {
    Option.None => {}
    Option.Some {value} => {
      let wroteMarker = run Bytes.append(&mut output.*, b"?")
      let wroteQuery = run Bytes.append(&mut output.*, String.utf8Bytes(value))
    }
  }
  return ()
}

