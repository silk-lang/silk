//! Bounded, replay-aware HTTP redirect policy and scoped attempt orchestration.
//!
//! # When to use
//!
//! Use [`Policy`] to admit finite redirect authority before an HTTP attempt. Select
//! [`withEmptyResponse`], [`withBytesResponse`], [`withOneShotResponse`], or
//! [`withReplayResponse`] according to the request body's replay authority.
//!
//! # Details
//!
//! This actor owns policy names, bounded redirect history, independently owned next-attempt state,
//! replay-aware body writing, intermediate-response cleanup, and final callback dispatch. Routed
//! acquisition remains behind [`AttemptClient`]; final responses are lent only to a higher-ranked
//! [`ResponseHandler`].

import silk.allocator {Allocator, OutOfMemoryError}
import silk.byte_duplex {ByteDuplex}
import silk.bytes {Bytes}
import silk.effect {Effect}
import silk.http {Header, Method, Status, ValueError, Version}
import silk.http_client {
  ClientError,
  ContinuePolicy,
  DiscardOutcome,
  Exchange,
  ExchangePhase,
  RouteTransport,
}
import silk.http_client as Client
import silk.http_headers {
  HeaderIterator,
  Headers,
  Limits as HeaderLimits,
  MetadataIterator,
  MetadataToken,
  OwnedHeaders,
}
import silk.http_origin {Origin, OriginError}
import silk.http_request {Authorization, BodyMode, HeaderControl, HeaderPolicy}
import silk.http_transport {HttpTransport}
import silk.layout {Layout}
import silk.monotonic_clock {MonotonicClock}
import silk.option {Option}
import silk.random {Random}
import silk.result {Result}
import silk.slice {Slice}
import silk.string {String}
import silk.system_clock {Instant, SystemClock}
import silk.u64
import silk.u8
import silk.uri {OwnedUri, Uri}
import silk.uri_reference {UriReference}
import silk.usize
import silk.vector {Vector}

/// Whether a response is returned unchanged or eligible redirect statuses are followed.
pub enum Mode {
  /// Returns the first response without inspecting `Location`.
  Manual,
  /// Applies the admitted redirect policy.
  Follow,
}

/// Whether a cross-origin redirect is admitted.
pub enum CrossOriginPolicy {
  /// Rejects every normalized-origin change.
  Deny,
  /// Admits an origin change after deny-last header sanitization.
  Allow,
}

/// Whether an HTTPS-to-HTTP redirect is admitted after cross-origin admission.
pub enum DowngradePolicy {
  /// Rejects a secure-to-plaintext transition.
  Deny,
  /// Admits a secure-to-plaintext transition after cross-origin sanitization.
  Allow,
}

/// The special method rule for exact uppercase POST on status 301 or 302.
pub enum Post301302Policy {
  /// Preserves POST and its body.
  Preserve,
  /// Changes exact uppercase POST to GET and drops its body.
  ToGet,
}

/// How an intermediate response is handled before its attempt scope is released.
pub union PreviousResponsePolicy {
  /// Performs no drain and lets the attempt owner close an incomplete response.
  Close,
  /// Attempts a bounded discard under a finite absolute deadline.
  Drain {
    /// Maximum response wire bytes that may be discarded.
    pub maxDiscardWireBytes: u64,
    /// Absolute discard deadline, later clamped to the operation deadline.
    pub deadline: Instant,
  },
}

/// Finite admission limits for one owned case-insensitive field-name list.
pub struct NameListLimits {
  /// Maximum number of names, including duplicates.
  pub maxNames: usize
  /// Maximum bytes in any one name.
  pub maxNameBytes: usize
  /// Maximum aggregate name payload plus owned index storage.
  pub maxOwnedBytes: usize
}

impl Copy for NameListLimits {}

/// A bounded owned list of validated HTTP field names.
pub struct NameList {
  values: Vector<String>
  ownedBytesValue: usize
}

/// Finite URI, hop, and history capacities for one redirect operation.
pub struct HistoryLimits {
  /// Maximum followed redirects.
  pub maxHops: usize
  /// Maximum bytes in each raw or resolved URI serialization.
  pub maxUriBytes: usize
  /// Maximum serialized key bytes in the preallocated history arena.
  pub maxHistoryBytes: usize
}

impl Copy for HistoryLimits {}

/// An immutable admitted redirect policy with owned field-name lists.
pub struct Policy {
  modeValue: Mode
  historyValue: HistoryLimits
  crossOriginValue: CrossOriginPolicy
  downgradeValue: DowngradePolicy
  post301302Value: Post301302Policy
  previousResponseValue: PreviousResponsePolicy
  safeCustomValue: NameList
  sensitiveValue: NameList
}

/// The bounded value whose admission or transition failed.
pub enum RedirectComponent {
  /// The admitted policy and its owned lists.
  Policy,
  /// A response `Location` field.
  Location,
  /// The resolved next URI.
  Uri,
  /// The normalized destination origin.
  Origin,
  /// The method-aware redirect history.
  History,
  /// The current body replay authority.
  Body,
}

/// The finite redirect resource that exceeded its bound.
pub enum RedirectLimit {
  /// Owned policy-name count.
  PolicyNames,
  /// One policy-name byte count.
  PolicyNameBytes,
  /// Aggregate policy-name payload and index storage.
  PolicyOwnedBytes,
  /// Raw or resolved URI bytes.
  UriBytes,
  /// Method-aware history entries.
  HistoryEntries,
  /// Aggregate serialized history-key bytes.
  HistoryBytes,
}

/// A redirect-specific failure reason without response or credential borrows.
pub union RedirectReason {
  /// Policy arithmetic or values cannot be admitted.
  InvalidPolicy,
  /// A name appears in both the safe-custom and sensitive lists.
  NameListOverlap,
  /// Required finite storage does not fit in `usize`.
  SizeOverflow,
  /// A finite resource exceeds its inclusive bound.
  LimitExceeded {
    /// The resource whose limit was exceeded.
    pub limit: RedirectLimit,
    /// The inclusive admitted maximum.
    pub allowed: usize,
    /// The rejected resource value.
    pub attempted: usize,
  },
  /// A selected redirect has no `Location` field.
  LocationMissing,
  /// A selected redirect has more than one `Location` field.
  LocationAmbiguous,
  /// A `Location` field is not UTF-8 or is not a valid URI reference.
  LocationInvalid,
  /// The resolved URI is not an admitted HTTP or HTTPS origin.
  RedirectSchemeDenied,
  /// Policy rejects a normalized-origin change.
  RedirectOriginDenied,
  /// Policy rejects an HTTPS-to-HTTP transition.
  DowngradeDenied,
  /// A selected redirect has no remaining hop capacity.
  HopLimit,
  /// A transformed method and request target repeat an earlier history key.
  RedirectLoop,
  /// A retained body has no replay authority.
  ReplayUnavailable,
  /// A producer's framing or observed length violates its declared contract.
  ReplayContractMismatch,
}

impl Copy for RedirectReason {}

/// Independently owned, bounded context attached at the redirect boundary.
pub struct RedirectContext {
  /// Zero-based current attempt number.
  pub hop: usize
  /// Response status when one is relevant.
  pub status: Option<Status>
  /// Independently owned current URI when retained by the failure boundary.
  pub currentUri: Option<OwnedUri>
  /// Independently owned next URI when retained by the failure boundary.
  pub nextUri: Option<OwnedUri>
}

/// A redirect-specific failure with no response, credential, body, or proxy-token borrow.
pub struct RedirectError {
  /// The bounded value associated with the failure.
  pub component: RedirectComponent
  /// The stable machine-readable failure reason.
  pub reason: RedirectReason
  /// Independently owned bounded transition context.
  pub context: RedirectContext
}

/// A rebuildable semantic request, distinct from an owned serialized prepared request.
pub struct Request<'uri, 'method, 'headers, 'policy> {
  /// Caller-owned initial URI, including fragment metadata.
  pub uri: Uri<'uri>
  /// Caller-owned initial method with exact spelling.
  pub method: Method<'method>
  /// Caller-owned semantic fields, excluding generated framing and authority fields.
  pub headers: Headers<'headers>
  /// Caller-owned generated-field and credential policy.
  pub headerPolicy: HeaderPolicy<'policy>
  /// HTTP version used for every rebuilt attempt.
  pub version: Version
  /// Upload expectation policy used for every rebuilt attempt.
  pub continuePolicy: ContinuePolicy
  /// Shared request and owned-header value limits.
  pub limits: HeaderLimits
  /// Maximum bytes in each owned serialized request head.
  pub maxHeadBytes: usize
  /// Maximum generated credential bytes in each request head.
  pub maxCredentialBytes: usize
}

/// Owned semantic state for rebuilding exactly one redirect attempt.
///
/// # Details
///
/// The attempt client borrows views from these owners only inside its higher-ranked handler call.
/// It must rebuild a fresh prepared request after route selection rather than retaining serialized
/// bytes from an earlier origin.
pub struct AttemptRequest<'policy> {
  /// Independently owned current URI, including fragment metadata outside the wire target.
  pub uri: OwnedUri
  /// Independently owned exact method spelling.
  pub method: String
  /// Independently owned ordered semantic fields before generated-field preparation.
  pub headers: OwnedHeaders
  /// Generated-field and origin-credential policy borrowing caller-owned bytes.
  pub headerPolicy: HeaderPolicy<'policy>
  /// HTTP version selected for this attempt.
  pub version: Version
  /// Upload expectation policy paired with the prepared request.
  pub continuePolicy: ContinuePolicy
  /// Shared method, target, field, and owned-header bounds used during preparation.
  pub requestLimits: HeaderLimits
  /// Maximum bytes in the newly owned serialized request head.
  pub maxHeadBytes: usize
  /// Maximum generated origin or proxy credential bytes in the request head.
  pub maxCredentialBytes: usize
  /// Exact body delimiter that orchestration validates against its source before acquisition.
  pub bodyMode: BodyMode
}

/// Returns generated-field policy for a cross-origin attempt without origin credentials.
///
/// # When to use
///
/// Use before request preparation after [`admitOrigin`] reports an origin change.
///
/// # Details
///
/// The result selects the next normalized origin for Host and removes generated Authorization.
/// It preserves User-Agent, Accept, Basic security, and HTTP/1.0 persistence controls.
pub fn crossOriginHeaderPolicy<'value>(policy: HeaderPolicy<'value>) -> HeaderPolicy<'value> {
  return HeaderPolicy<'value> {
    host: HeaderControl<'value>.Default,
    userAgent: policy.userAgent,
    accept: policy.accept,
    authorization: Authorization<'value>.Absent,
    basicSecurity: policy.basicSecurity,
    http10KeepAlive: policy.http10KeepAlive,
  }
}

/// The result of pulling one bounded producer chunk into caller storage.
pub struct BodyChunk {
  /// Number of initialized bytes written at the start of caller storage.
  pub length: usize
  /// Whether no later pull may produce bytes.
  pub end: bool
}

impl Copy for BodyChunk {}

/// A scoped body source with explicit framing metadata and bounded pulls.
pub interface BodyProducer<E, ?R> {
  /// Returns framing metadata before an attempt writes its request head.
  fn mode(producer: &Self) -> BodyMode
  /// Initializes at most `output.length` bytes and reports progress without retaining `output`.
  effect fn pull(producer: &mut Self, output: &mut [u8]) -> BodyChunk ! E ? R
}

/// A reusable factory that lends one fresh scoped producer for each attempted request.
///
/// # Details
///
/// Redirect orchestration owns each acquired producer and brackets it through one complete
/// attempt. `release` is infallible and non-suspending, so cleanup cannot replace the attempt's
/// success or failure. Factory result and callback types remain outside this public contract.
pub interface ReplayFactory<P, FactoryError, ?FactoryRequirements> {
  /// Acquires one fresh owned producer for the next retained-body attempt.
  effect fn acquire(factory: &mut Self) -> P ! FactoryError ? FactoryRequirements
  /// Releases one acquired producer after success, failure, or structured cancellation.
  fn release(factory: &mut Self, producer: &mut P) -> ()
}

/// One attempt's uniform producer authority after replay selection.
///
/// # Details
///
/// Empty and repeatable-byte attempts are implemented inside this actor. Producer variants lend
/// the already-selected OneShot or factory producer without erasing either channel family.
pub union AttemptBody<'bytes, 'oneShot, 'replay, OneShot, ReplayProducer> {
  /// Completes one body-free attempt without consulting a producer.
  Empty,
  /// Reads one attempt from immutable caller bytes through a private cursor.
  RepeatableBytes {bytes: &'bytes [u8], offset: usize},
  /// Lends the affine producer consumed for this attempt.
  OneShot {producer: &'oneShot mut OneShot},
  /// Lends the fresh producer owned by the current replay-factory scope.
  ReplayFactory {producer: &'replay mut ReplayProducer},
}

/// Whether the shared writer completed upload or received a final response before pulling bytes.
pub union BodyWriteOutcome {
  /// Upload framing finished and one final response is ready for body handling.
  Completed {
    /// Final response status.
    pub status: u16,
  },
  /// Require100 received a final response before the first producer pull.
  EarlyFinal {
    /// Final response status.
    pub status: u16,
  },
}

/// A higher-ranked routed-attempt callback provided lexically by redirect orchestration.
///
/// # Details
///
/// Acquisition clients invoke this service once after request preparation and scoped connection
/// acquisition. Naming the service in a requirement row preserves exact handler channels without
/// exposing redirect's concrete callback adapter.
pub service Attempt<'policy, P, A, E, ?R> {
  /// Handles one live routed exchange inside its acquisition bracket.
  effect<'call> fn handle<
    'call,
    'exchangeView: 'call,
    'transport: 'exchangeView,
    'provider: 'transport,
    'tunnel: 'provider,
  >(
    request: &'call AttemptRequest<'policy>,
    method: Method<'call>,
    exchange: &'call mut Exchange<'exchangeView, RouteTransport<'transport, 'provider, 'tunnel, P>>,
  ) -> A ! E ? R | &mut Attempt<'policy, P, A, E, R> where
    &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut P provides &HttpTransport from &mut HttpTransport,
    &mut P provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut P provides &ByteDuplex from &mut ByteDuplex
}

/// A routed HTTP acquisition boundary for one rebuilt redirect attempt.
///
/// # When to use
///
/// Implement this interface beside routed connection acquisition, then pass it to redirect
/// orchestration without exposing sockets, TLS state, proxy credentials, or pooled leases.
///
/// # Details
///
/// `withAttempt` consumes and retains `request` through its complete bracket. It derives one
/// validated method and the URI/header views from that owner, selects the current route, prepares a
/// new origin- or absolute-form request, acquires its physical peer under the unchanged absolute
/// deadline, and invokes exactly one `http_client.withExchange`. The same method view, a fresh
/// request borrow, and the resulting exchange are lent only through [`Attempt`], so redirect
/// transition and sanitization do not copy semantic state or reparse the method. Handler and source
/// errors remain direct. `AcquisitionError` directly carries preparation, route, acquisition, and
/// exchange-admission failures without wrapping either channel family.
///
/// # Gotchas
///
/// The implementation must release its transport after handler success, typed failure, defect, or
/// cancellation. It must not return the fresh request borrow, method view, transport loan, or
/// exchange loan.
pub interface AttemptClient<
  'policy,
  P,
  A,
  HandlerError,
  AcquisitionError,
  ?AcquisitionRequirements,
  ?HandlerRequirements,
> {
  /// Rebuilds, acquires, and drives one scoped request while preserving both channel families.
  effect fn withAttempt(
    client: &mut Self,
    request: AttemptRequest<'policy>,
    deadline: Option<Instant>,
  ) -> A ! HandlerError | AcquisitionError ? HandlerRequirements | AcquisitionRequirements | &mut Attempt<'policy, P, A, HandlerError ? HandlerRequirements> where
    HandlerRequirements in Without<HandlerRequirements, ByteDuplex>,
    HandlerRequirements in Without<HandlerRequirements, HttpTransport>
}

/// A higher-ranked callback for one routed or direct redirect attempt.
///
/// # Details
///
/// A routed client calls `handleRouted` with its final routed transport. A direct client calls
/// `handleDirect` with its direct HTTP transport. Each operation lends the same owned request and
/// validated method only for its exchange scope. Neither exchange form can escape in `A`.
pub service HybridAttempt<'policy, RoutedP, DirectP, A, E, ?R> {
  /// Handles one routed exchange after route preparation and acquisition finish.
  effect<'call> fn handleRouted<
    'call,
    'exchangeView: 'call,
    'transport: 'exchangeView,
    'provider: 'transport,
    'tunnel: 'provider,
  >(
    request: &'call AttemptRequest<'policy>,
    method: Method<'call>,
    exchange: &'call mut Exchange<
      'exchangeView,
      RouteTransport<'transport, 'provider, 'tunnel, RoutedP>,
    >,
  ) -> A ! E ? R | &mut HybridAttempt<'policy, RoutedP, DirectP, A, E, R> where
    &mut RoutedP provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut RoutedP provides &HttpTransport from &mut HttpTransport,
    &mut RoutedP provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut RoutedP provides &ByteDuplex from &mut ByteDuplex
  /// Handles one direct exchange after direct request preparation and acquisition finish.
  effect<'call> fn handleDirect<'call, 'exchangeView: 'call>(
    request: &'call AttemptRequest<'policy>,
    method: Method<'call>,
    exchange: &'call mut Exchange<'exchangeView, DirectP>,
  ) -> A ! E ? R | &mut HybridAttempt<'policy, RoutedP, DirectP, A, E, R> where
    &mut DirectP provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut DirectP provides &HttpTransport from &mut HttpTransport
}

/// A routed-or-direct acquisition boundary for one rebuilt redirect attempt.
///
/// # Details
///
/// The client selects one acquisition form before contact and calls exactly one handler operation.
/// It preserves the unchanged deadline and both caller-defined channel families. The direct form
/// does not require duplex authority because it cannot establish a CONNECT tunnel.
pub interface HybridAttemptClient<
  'policy,
  RoutedP,
  DirectP,
  A,
  HandlerError,
  AcquisitionError,
  ?AcquisitionRequirements,
  ?HandlerRequirements,
> {
  /// Rebuilds, acquires, and drives one routed or direct scoped request.
  effect fn withAttempt(
    client: &mut Self,
    request: AttemptRequest<'policy>,
    deadline: Option<Instant>,
  ) -> A ! HandlerError | AcquisitionError ? HandlerRequirements | AcquisitionRequirements | &mut HybridAttempt<'policy, RoutedP, DirectP, A, HandlerError ? HandlerRequirements> where
    HandlerRequirements in Without<HandlerRequirements, ByteDuplex>,
    HandlerRequirements in Without<HandlerRequirements, HttpTransport>
}

/// A higher-ranked callback for the one final response selected by redirect orchestration.
///
/// # When to use
///
/// Pass an implementation to one of the four `with*Response` operations to consume the final
/// response while its routed exchange is live.
///
/// # Details
///
/// `uri` borrows the independently owned final URI only for `handle`. `hop` is the number of
/// redirects followed. Neither the URI nor exchange loan can escape in `A`.
pub interface ResponseHandler<P, A, E, ?R> {
  /// Handles exactly one selected final response.
  effect<'call> fn handle<
    'call,
    'exchangeView: 'call,
    'transport: 'exchangeView,
    'provider: 'transport,
    'tunnel: 'provider,
  >(
    handler: &mut Self,
    uri: Uri<'call>,
    hop: usize,
    exchange: &'call mut Exchange<'exchangeView, RouteTransport<'transport, 'provider, 'tunnel, P>>,
  ) -> A ! E ? R where
    &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut P provides &HttpTransport from &mut HttpTransport,
    &mut P provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut P provides &ByteDuplex from &mut ByteDuplex
}

/// A final-response callback that accepts either a routed or a direct exchange.
///
/// # When to use
///
/// Use with the four `with*HybridResponse` operations when one acquisition context can select a
/// proxy-aware route or a direct pooled connection.
///
/// # Details
///
/// The acquisition client calls exactly one operation. Each operation lends the independently
/// owned final URI and live exchange only for that call.
pub interface HybridResponseHandler<RoutedP, DirectP, A, E, ?R> {
  /// Handles exactly one final response on a routed transport.
  effect<'call> fn handleRouted<
    'call,
    'exchangeView: 'call,
    'transport: 'exchangeView,
    'provider: 'transport,
    'tunnel: 'provider,
  >(
    handler: &mut Self,
    uri: Uri<'call>,
    hop: usize,
    exchange: &'call mut Exchange<
      'exchangeView,
      RouteTransport<'transport, 'provider, 'tunnel, RoutedP>,
    >,
  ) -> A ! E ? R where
    &mut RoutedP provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut RoutedP provides &HttpTransport from &mut HttpTransport,
    &mut RoutedP provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut RoutedP provides &ByteDuplex from &mut ByteDuplex
  /// Handles exactly one final response on a direct HTTP transport.
  effect<'call> fn handleDirect<'call, 'exchangeView: 'call>(
    handler: &mut Self,
    uri: Uri<'call>,
    hop: usize,
    exchange: &'call mut Exchange<'exchangeView, DirectP>,
  ) -> A ! E ? R where
    &mut DirectP provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut DirectP provides &HttpTransport from &mut HttpTransport
}

/// Opaque selected request-body authority used while a redirect attempt is live.
///
/// # Details
///
/// Redirect orchestration provides this service only inside the scoped attempt callback. Clients
/// may name it to preserve exact requirement rows, but cannot retain its producer or body loan.
pub service SelectedBody<E, ?R> {
  /// Writes the next selected request-body chunk into `output` without retaining the buffer.
  effect fn pull(output: &mut [u8]) -> BodyChunk ! E ? R | &mut SelectedBody<E, R>
}

struct BytesSelected<'bytes, E, ?R> {
  bytes: &'bytes [u8]
  offset: usize
}

impl<'bytes, E, ?R> BytesSelected<'bytes, E, R> {
  effect fn pull(self: &mut Self, output: &mut [u8]) -> BodyChunk ! E ? R {
    let remaining = self.bytes.length - self.offset
    let mut length = remaining
    if output.length < length {
      length = output.length
    }
    let mut index = usize.ZERO
    while index < length {
      output[index] = self.bytes[self.offset + index]
      index = index + usize.ONE
    }
    self.offset = self.offset + length
    return BodyChunk {length: length, end: self.offset == self.bytes.length}
  }
}

impl<'bytes, E, ?R> SelectedBody<E, R> for BytesSelected<'bytes, E, R> {
  pull: BytesSelected.pull
}

struct ProducerSelected<'producer, Producer, E, ?R> {
  producer: &'producer mut Producer
}

impl<'producer, E, ?R, Producer: BodyProducer<E ? R>> SelectedBody<E, R> for ProducerSelected<
  'producer,
  Producer,
  E,
  R,
> {
  effect fn pull(self: &mut Self, output: &mut [u8]) -> BodyChunk ! E ? R {
    return run BodyProducer<E ? R>.pull(&mut self.producer.*, move output)
  }
}

struct ServiceBodyProducer<E, ?R> {
  modeValue: BodyMode
}

fn serviceAttemptBody<'scope, E, ?R>(producer: &'scope mut ServiceBodyProducer<E, R>, empty: bool) -> AttemptBody<
  'scope,
  'scope,
  'scope,
  ServiceBodyProducer<E, R>,
  ServiceBodyProducer<E, R>,
> {
  if empty {
    drop producer
    return AttemptBody<'scope, 'scope, 'scope, ServiceBodyProducer<E, R>, ServiceBodyProducer<E, R>>.Empty
  }
  return AttemptBody<'scope, 'scope, 'scope, ServiceBodyProducer<E, R>, ServiceBodyProducer<E, R>>.OneShot {
    producer: move producer,
  }
}

impl<E, ?R> BodyProducer<E ? R | &mut SelectedBody<E, R>> for ServiceBodyProducer<E, R> {
  fn mode(producer: &Self) -> BodyMode {
    return producer.modeValue
  }
  effect fn pull(producer: &mut Self, output: &mut [u8]) -> BodyChunk
  ! E
  ? R | &mut SelectedBody<E, R> {
    drop producer
    return run SelectedBody.pull<E, R>(move output)
  }
}

struct RedirectState<'policy> {
  uri: OwnedUri
  method: String
  headers: OwnedHeaders
  headerPolicy: HeaderPolicy<'policy>
  version: Version
  continuePolicy: ContinuePolicy
  requestLimits: HeaderLimits
  maxHeadBytes: usize
  maxCredentialBytes: usize
  expectedBodyMode: Option<BodyMode>
}

/// Opaque outcome of one redirect attempt.
///
/// # Details
///
/// Acquisition clients may name this result in exact conformance bounds. Redirect orchestration
/// alone constructs and consumes its state, history, and transition authority.
pub union AttemptStep<'policy, A> {
  Final {value: A},
  Redirect {state: RedirectState<'policy>, history: History, body: BodyDecision},
}

struct RedirectAttemptHandler<'policy, E, ?R> {
  policy: &'policy Policy
  history: History
  followedHops: usize
  replayable: bool
}

fn copyInstant(value: &Instant) -> Instant {
  return SystemClock.make(SystemClock.seconds(value), SystemClock.nanoseconds(value))
}

fn copyDeadline(value: &Option<Instant>) -> Option<Instant> {
  return match & value.* {
    Option.None => Option.none<Instant>()
    Option.Some {value: present} => Option.some<Instant>(copyInstant(&present))
  }
}

fn copyContinuePolicy(policy: &ContinuePolicy) -> ContinuePolicy {
  return match & policy.* {
    ContinuePolicy.Disabled => ContinuePolicy.Disabled
    ContinuePolicy.Require100 {deadline} => ContinuePolicy.Require100 {
      deadline: copyInstant(&deadline),
    }
  }
}

fn requiredOrigin(uri: &Uri, hop: usize, status: Option<Status>) -> Result<Origin, RedirectError> {
  return match move Origin.fromUri(uri) {
    Result.Failure {error} => Result.failResult<Origin, RedirectError>(
      failure(RedirectComponent.Origin, originFailure(error), hop, move status),
    )
    Result.Success {value} => Result.succeed<Origin, RedirectError>(value)
  }
}

effect fn enrichCurrent(error: RedirectError, current: &Uri) -> RedirectError
! OutOfMemoryError
? &mut Allocator {
  let mut enriched = move error
  enriched.context.currentUri = Option.some<OwnedUri>(run Uri.copy(current))
  return move enriched
}

effect fn enrichBoth(error: RedirectError, current: &Uri, next: &Uri) -> RedirectError
! OutOfMemoryError
? &mut Allocator {
  let mut enriched = run enrichCurrent(move error, current)
  enriched.context.nextUri = Option.some<OwnedUri>(run Uri.copy(next))
  return move enriched
}

effect fn cleanupIntermediate<'exchange, P>(
  exchange: &mut Exchange<'exchange, P>,
  policy: &PreviousResponsePolicy,
) -> ()
! ClientError | OutOfMemoryError
? &mut MonotonicClock | &mut Allocator | &mut Random
where
  &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random {
  return match & policy.* {
    PreviousResponsePolicy.Close => ()
    PreviousResponsePolicy.Drain {maxDiscardWireBytes, deadline} => {
      let outcome = run Client.discardRemainingAtMost(
        &mut exchange.*,
        maxDiscardWireBytes,
        Option.some<Instant>(copyInstant(&deadline)),
      )
      match move outcome {
        DiscardOutcome.Completed => run Client.finishResponse(&mut exchange.*)
        DiscardOutcome.CapReached => ()
      }
    }
  }
}

fn atResponse(error: RedirectError, hop: usize, status: Status) -> RedirectError {
  let mut contextual = move error
  contextual.context.hop = hop
  contextual.context.status = Option.some<Status>(move status)
  return move contextual
}

interface FinalResponse<T, H, A, E, ?R> {
  effect<'call> fn handle<'call, 'exchangeView: 'call>(
    adapter: Self,
    callback: &mut H,
    uri: Uri<'call>,
    hop: usize,
    exchange: &'call mut Exchange<'exchangeView, T>,
  ) -> A ! E ? R where
    &mut T provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut T provides &HttpTransport from &mut HttpTransport
}

struct RoutedFinalResponse<'transport, 'provider, 'tunnel, P, H, A, E, ?R> {}

impl<
  'transport,
  'provider: 'transport,
  'tunnel: 'provider,
  P,
  A,
  E,
  ?R,
  H: ResponseHandler<P, A, E ? R>,
> FinalResponse<RouteTransport<'transport, 'provider, 'tunnel, P>, H, A, E ? R> for RoutedFinalResponse<
  'transport,
  'provider,
  'tunnel,
  P,
  H,
  A,
  E,
  R,
>
where
  &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut P provides &HttpTransport from &mut HttpTransport,
  &mut P provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut P provides &ByteDuplex from &mut ByteDuplex {
  effect<'call> fn handle<'call, 'exchangeView: 'call>(
    adapter: Self,
    callback: &mut H,
    uri: Uri<'call>,
    hop: usize,
    exchange: &'call mut Exchange<'exchangeView, RouteTransport<'transport, 'provider, 'tunnel, P>>,
  ) -> A
  ! E
  ? R {
    drop adapter
    return run ResponseHandler<P, A, E ? R>.handle(callback, uri, hop, move exchange)
  }
}

effect<'env> fn handleAttemptCore<
  'policy,
  'call,
  'exchangeView: 'call,
  E: 'env,
  ?R,
  T,
  A,
  CallbackError,
  ?CallbackRequirements,
  H,
  Final: FinalResponse<T, H, A, CallbackError ? CallbackRequirements> + 'env,
  'env,
>(
  handler: RedirectAttemptHandler<'policy, E, R>,
  scratch: &mut [u8],
  callback: &mut H,
  request: &'call AttemptRequest<'policy>,
  method: Method<'call>,
  exchange: &'call mut Exchange<'exchangeView, T>,
  finalResponse: Final,
) -> AttemptStep<'policy, A>
! RedirectError | ValueError | E | CallbackError | ClientError | OutOfMemoryError
? R | CallbackRequirements | &mut SelectedBody<E, R> | &mut MonotonicClock | &mut Allocator | &mut Random
where
  &mut T provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut T provides &HttpTransport from &mut HttpTransport {
  let RedirectAttemptHandler<'policy, E, R> {policy, history, followedHops, replayable} = move handler
  let emptyFields: [Header<'static>; 0] = []
  let trailers = match move Headers.make(&emptyFields, request.requestLimits) {
    Result.Failure {error} => {
      fail move error
    }
    Result.Success {value} => value
  }
  let mut serviceProducer = ServiceBodyProducer<E, R> {modeValue: request.bodyMode}
  let selectedBody = serviceAttemptBody(&mut serviceProducer, bodyModeEmpty(&request.bodyMode))
  let written = run writeBody(
    &mut exchange.*,
    &request.uri.view(),
    request.bodyMode,
    move selectedBody,
    &mut scratch,
    &trailers,
    followedHops,
  )
  drop written
  let head = run Exchange.head(&exchange.*)
  let status = head.status()
  let decision = match move statusDecision(policy, status, followedHops) {
    Result.Failure {error} => {
      let enriched = run enrichCurrent(move error, &request.uri.view())
      fail move enriched
    }
    Result.Success {value} => value
  }
  if decision == StatusDecision.Final {
    let value = run FinalResponse<T, H, A, CallbackError ? CallbackRequirements>.handle(
      move finalResponse,
      move callback,
      request.uri.view(),
      followedHops,
      move exchange,
    )
    return AttemptStep<'policy, A>.Final {value: move value}
  }
  let currentUri = request.uri.view()
  let locationHead = match move run head.copyMatchingHeaders("Location", request.requestLimits) {
    Result.Failure {error} => {
      fail move error
    }
    Result.Success {value} => move value
  }
  let locationView = locationHead.view()
  let responseHeaders = locationView.headers()
  let nextUri = match move run resolveLocation(
    &currentUri,
    &responseHeaders,
    Policy.historyLimits(policy),
    followedHops,
    status,
  ) {
    Result.Failure {error} => {
      let enriched = run enrichCurrent(move error, &currentUri)
      fail move enriched
    }
    Result.Success {value} => move value
  }
  drop responseHeaders
  drop head
  let nextView = nextUri.view()
  let currentOrigin = match move requiredOrigin(
    &currentUri,
    followedHops,
    Option.some<Status>(status),
  ) {
    Result.Failure {error} => {
      let enriched = run enrichBoth(move error, &currentUri, &nextView)
      fail move enriched
    }
    Result.Success {value} => value
  }
  let nextOrigin = match move requiredOrigin(&nextView, followedHops, Option.some<Status>(status)) {
    Result.Failure {error} => {
      let enriched = run enrichBoth(move error, &currentUri, &nextView)
      fail move enriched
    }
    Result.Success {value} => value
  }
  let crossOrigin = match move admitOrigin(
    policy,
    &currentOrigin,
    &nextOrigin,
    followedHops,
    status,
  ) {
    Result.Failure {error} => {
      let enriched = run enrichBoth(move error, &currentUri, &nextView)
      fail move enriched
    }
    Result.Success {value} => value
  }
  let transitioned = transition(policy, status, method)
  if transitioned.body == BodyDecision.Retain && !replayable {
    let error = failure(
      RedirectComponent.Body,
      RedirectReason.ReplayUnavailable,
      followedHops,
      Option.some<Status>(status),
    )
    let enriched = run enrichBoth(move error, &currentUri, &nextView)
    fail move enriched
  }
  let nextHeaders = match move run sanitizeHeaders(
    &request.headers.view(),
    policy,
    crossOrigin,
    transitioned.body,
    request.requestLimits,
  ) {
    Result.Failure {error} => {
      fail move error
    }
    Result.Success {value} => move value
  }
  let nextMethod = run String.copy(Method.format(&transitioned.method))
  let mut nextHistory = move history
  match move run History.insert(&mut nextHistory, transitioned.method, nextOrigin, &nextView) {
    Result.Failure {error} => {
      let contextual = atResponse(move error, followedHops, status)
      let enriched = run enrichBoth(move contextual, &currentUri, &nextView)
      fail move enriched
    }
    Result.Success {value} => {}
  }
  let mut nextHeaderPolicy = request.headerPolicy
  if crossOrigin {
    nextHeaderPolicy = crossOriginHeaderPolicy(request.headerPolicy)
  }
  let nextBodyMode = match transitioned.body {
    BodyDecision.Drop => BodyMode.Empty
    BodyDecision.Retain => request.bodyMode
  }
  let nextState = RedirectState<'policy> {
    uri: move nextUri,
    method: move nextMethod,
    headers: move nextHeaders,
    headerPolicy: nextHeaderPolicy,
    version: request.version,
    continuePolicy: copyContinuePolicy(&request.continuePolicy),
    requestLimits: request.requestLimits,
    maxHeadBytes: request.maxHeadBytes,
    maxCredentialBytes: request.maxCredentialBytes,
    expectedBodyMode: Option.some<BodyMode>(nextBodyMode),
  }
  run cleanupIntermediate(&mut exchange.*, Policy.previousResponse(policy))
  return AttemptStep<'policy, A>.Redirect {
    state: move nextState,
    history: move nextHistory,
    body: transitioned.body,
  }
}

struct RedirectRoutedAttempt<
  'attempt,
  'callback,
  'policy,
  P,
  A,
  E,
  ?R,
  CallbackError,
  ?CallbackRequirements,
  H,
> {
  handler: Option<RedirectAttemptHandler<'policy, E, R>>
  scratch: &'attempt mut [u8]
  callback: &'callback mut H
}

struct RedirectHybridAttempt<
  'attempt,
  'callback,
  'policy,
  RoutedP,
  DirectP,
  A,
  E,
  ?R,
  CallbackError,
  ?CallbackRequirements,
  H,
> {
  handler: Option<RedirectAttemptHandler<'policy, E, R>>
  scratch: &'attempt mut [u8]
  callback: &'callback mut H
}

fn unavailableHybrid<T>() -> T {
  return unavailableHybrid<T>()
}

impl<
  'attempt,
  'callback,
  'policy,
  E,
  ?R,
  P,
  A,
  CallbackError,
  ?CallbackRequirements,
  H: ResponseHandler<P, A, CallbackError ? CallbackRequirements>,
> Attempt<'policy, P, AttemptStep<'policy, A>, RedirectError | ValueError | E | CallbackError | ClientError | OutOfMemoryError ? R | CallbackRequirements | &mut SelectedBody<
  E,
  R,
> | &mut MonotonicClock | &mut Allocator | &mut Random> for RedirectRoutedAttempt<
  'attempt,
  'callback,
  'policy,
  P,
  A,
  E,
  R,
  CallbackError,
  CallbackRequirements,
  H,
> {
  effect<'call> fn handle<
    'call,
    'exchangeView: 'call,
    'transport: 'exchangeView,
    'provider: 'transport,
    'tunnel: 'provider,
  >(
    provider: &mut Self,
    request: &'call AttemptRequest<'policy>,
    method: Method<'call>,
    exchange: &'call mut Exchange<'exchangeView, RouteTransport<'transport, 'provider, 'tunnel, P>>,
  ) -> AttemptStep<'policy, A>
  ! RedirectError | ValueError | E | CallbackError | ClientError | OutOfMemoryError
  ? R | CallbackRequirements | &mut SelectedBody<E, R> | &mut MonotonicClock | &mut Allocator | &mut Random
  where
    &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut P provides &HttpTransport from &mut HttpTransport,
    &mut P provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut P provides &ByteDuplex from &mut ByteDuplex {
    let stored = Intrinsic.replace(
      provider.handler,
      Option.none<RedirectAttemptHandler<'policy, E, R>>(),
    )
    let handler = match move stored {
      Option.Some {value} => move value
      Option.None => unavailableHybrid<RedirectAttemptHandler<'policy, E, R>>()
    }
    return run handleAttemptCore(
      move handler,
      &mut provider.scratch,
      &mut provider.callback.*,
      request,
      method,
      move exchange,
      RoutedFinalResponse<
        'transport,
        'provider,
        'tunnel,
        P,
        H,
        A,
        CallbackError,
        CallbackRequirements,
      > {},
    )
  }
}

struct HybridRoutedFinalResponse<'transport, 'provider, 'tunnel, RoutedP, DirectP, H, A, E, ?R> {}

impl<
  'transport,
  'provider: 'transport,
  'tunnel: 'provider,
  RoutedP,
  DirectP,
  A,
  E,
  ?R,
  H: HybridResponseHandler<RoutedP, DirectP, A, E ? R>,
> FinalResponse<RouteTransport<'transport, 'provider, 'tunnel, RoutedP>, H, A, E ? R> for HybridRoutedFinalResponse<
  'transport,
  'provider,
  'tunnel,
  RoutedP,
  DirectP,
  H,
  A,
  E,
  R,
>
where
  &mut RoutedP provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut RoutedP provides &HttpTransport from &mut HttpTransport,
  &mut RoutedP provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut RoutedP provides &ByteDuplex from &mut ByteDuplex {
  effect<'call> fn handle<'call, 'exchangeView: 'call>(
    adapter: Self,
    callback: &mut H,
    uri: Uri<'call>,
    hop: usize,
    exchange: &'call mut Exchange<
      'exchangeView,
      RouteTransport<'transport, 'provider, 'tunnel, RoutedP>,
    >,
  ) -> A
  ! E
  ? R {
    drop adapter
    return run HybridResponseHandler<RoutedP, DirectP, A, E ? R>.handleRouted(
      callback,
      uri,
      hop,
      move exchange,
    )
  }
}

struct HybridDirectFinalResponse<RoutedP, DirectP, H, A, E, ?R> {}

impl<RoutedP, DirectP, A, E, ?R, H: HybridResponseHandler<RoutedP, DirectP, A, E ? R>> FinalResponse<DirectP, H, A, E ? R> for HybridDirectFinalResponse<
  RoutedP,
  DirectP,
  H,
  A,
  E,
  R,
> {
  effect<'call> fn handle<'call, 'exchangeView: 'call>(
    adapter: Self,
    callback: &mut H,
    uri: Uri<'call>,
    hop: usize,
    exchange: &'call mut Exchange<'exchangeView, DirectP>,
  ) -> A
  ! E
  ? R
  where
    &mut DirectP provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut DirectP provides &HttpTransport from &mut HttpTransport {
    drop adapter
    return run HybridResponseHandler<RoutedP, DirectP, A, E ? R>.handleDirect(
      callback,
      uri,
      hop,
      move exchange,
    )
  }
}

impl<'policy, E, ?R> RedirectAttemptHandler<'policy, E, R> {
  effect<'env> fn handleHybridRouted<
    'call,
    'exchangeView: 'call,
    'transport: 'exchangeView,
    'provider: 'transport,
    'tunnel: 'provider,
    RoutedP,
    DirectP,
    A,
    CallbackError,
    ?CallbackRequirements,
    H: HybridResponseHandler<RoutedP, DirectP, A, CallbackError ? CallbackRequirements>,
    'env,
  >(
    handler: Self,
    scratch: &mut [u8],
    callback: &mut H,
    request: &'call AttemptRequest<'policy>,
    method: Method<'call>,
    exchange: &'call mut Exchange<
      'exchangeView,
      RouteTransport<'transport, 'provider, 'tunnel, RoutedP>,
    >,
  ) -> AttemptStep<'policy, A>
  ! RedirectError | ValueError | E | CallbackError | ClientError | OutOfMemoryError
  ? R | CallbackRequirements | &mut SelectedBody<E, R> | &mut MonotonicClock | &mut Allocator | &mut Random
  where
    &mut RoutedP provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut RoutedP provides &HttpTransport from &mut HttpTransport,
    &mut RoutedP provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut RoutedP provides &ByteDuplex from &mut ByteDuplex {
    return run handleAttemptCore(
      move handler,
      move scratch,
      move callback,
      request,
      method,
      move exchange,
      HybridRoutedFinalResponse<
        'transport,
        'provider,
        'tunnel,
        RoutedP,
        DirectP,
        H,
        A,
        CallbackError,
        CallbackRequirements,
      > {},
    )
  }
  effect<'env> fn handleHybridDirect<
    'call,
    'exchangeView: 'call,
    RoutedP,
    DirectP,
    A,
    CallbackError,
    ?CallbackRequirements,
    H: HybridResponseHandler<RoutedP, DirectP, A, CallbackError ? CallbackRequirements>,
    'env,
  >(
    handler: Self,
    scratch: &mut [u8],
    callback: &mut H,
    request: &'call AttemptRequest<'policy>,
    method: Method<'call>,
    exchange: &'call mut Exchange<'exchangeView, DirectP>,
  ) -> AttemptStep<'policy, A>
  ! RedirectError | ValueError | E | CallbackError | ClientError | OutOfMemoryError
  ? R | CallbackRequirements | &mut SelectedBody<E, R> | &mut MonotonicClock | &mut Allocator | &mut Random
  where
    &mut DirectP provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut DirectP provides &HttpTransport from &mut HttpTransport {
    return run handleAttemptCore(
      move handler,
      move scratch,
      move callback,
      request,
      method,
      move exchange,
      HybridDirectFinalResponse<RoutedP, DirectP, H, A, CallbackError, CallbackRequirements> {},
    )
  }
}

impl<
  'attempt,
  'callback,
  'policy,
  E,
  ?R,
  RoutedP,
  DirectP,
  A,
  CallbackError,
  ?CallbackRequirements,
  H: HybridResponseHandler<RoutedP, DirectP, A, CallbackError ? CallbackRequirements>,
> HybridAttempt<'policy, RoutedP, DirectP, AttemptStep<'policy, A>, RedirectError | ValueError | E | CallbackError | ClientError | OutOfMemoryError ? R | CallbackRequirements | &mut SelectedBody<
  E,
  R,
> | &mut MonotonicClock | &mut Allocator | &mut Random> for RedirectHybridAttempt<
  'attempt,
  'callback,
  'policy,
  RoutedP,
  DirectP,
  A,
  E,
  R,
  CallbackError,
  CallbackRequirements,
  H,
> {
  effect<'call> fn handleRouted<
    'call,
    'exchangeView: 'call,
    'transport: 'exchangeView,
    'provider: 'transport,
    'tunnel: 'provider,
  >(
    provider: &mut Self,
    request: &'call AttemptRequest<'policy>,
    method: Method<'call>,
    exchange: &'call mut Exchange<
      'exchangeView,
      RouteTransport<'transport, 'provider, 'tunnel, RoutedP>,
    >,
  ) -> AttemptStep<'policy, A>
  ! RedirectError | ValueError | E | CallbackError | ClientError | OutOfMemoryError
  ? R | CallbackRequirements | &mut SelectedBody<E, R> | &mut MonotonicClock | &mut Allocator | &mut Random
  where
    &mut RoutedP provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut RoutedP provides &HttpTransport from &mut HttpTransport,
    &mut RoutedP provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut RoutedP provides &ByteDuplex from &mut ByteDuplex {
    let stored = Intrinsic.replace(
      provider.handler,
      Option.none<RedirectAttemptHandler<'policy, E, R>>(),
    )
    let handler = match move stored {
      Option.Some {value} => move value
      Option.None => unavailableHybrid<RedirectAttemptHandler<'policy, E, R>>()
    }
    return run RedirectAttemptHandler.handleHybridRouted<
      E,
      R,
      RoutedP,
      DirectP,
      A,
      CallbackError,
      CallbackRequirements,
      H,
    >(move handler, &mut provider.scratch, &mut provider.callback.*, request, method, move exchange)
  }
  effect<'call> fn handleDirect<'call, 'exchangeView: 'call>(
    provider: &mut Self,
    request: &'call AttemptRequest<'policy>,
    method: Method<'call>,
    exchange: &'call mut Exchange<'exchangeView, DirectP>,
  ) -> AttemptStep<'policy, A>
  ! RedirectError | ValueError | E | CallbackError | ClientError | OutOfMemoryError
  ? R | CallbackRequirements | &mut SelectedBody<E, R> | &mut MonotonicClock | &mut Allocator | &mut Random
  where
    &mut DirectP provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut DirectP provides &HttpTransport from &mut HttpTransport {
    let stored = Intrinsic.replace(
      provider.handler,
      Option.none<RedirectAttemptHandler<'policy, E, R>>(),
    )
    let handler = match move stored {
      Option.Some {value} => move value
      Option.None => unavailableHybrid<RedirectAttemptHandler<'policy, E, R>>()
    }
    return run RedirectAttemptHandler.handleHybridDirect<
      E,
      R,
      RoutedP,
      DirectP,
      A,
      CallbackError,
      CallbackRequirements,
      H,
    >(move handler, &mut provider.scratch, &mut provider.callback.*, request, method, move exchange)
  }
}

fn intoAttemptRequest<'policy>(state: RedirectState<'policy>, mode: BodyMode) -> AttemptRequest<
  'policy,
> {
  let RedirectState<'policy> {
    uri,
    method,
    headers,
    headerPolicy,
    version,
    continuePolicy,
    requestLimits,
    maxHeadBytes,
    maxCredentialBytes,
    expectedBodyMode,
  } = move state
  drop expectedBodyMode
  return AttemptRequest<'policy> {
    uri: move uri,
    method: move method,
    headers: move headers,
    headerPolicy: headerPolicy,
    version: version,
    continuePolicy: move continuePolicy,
    requestLimits: requestLimits,
    maxHeadBytes: maxHeadBytes,
    maxCredentialBytes: maxCredentialBytes,
    bodyMode: mode,
  }
}

struct InitialRedirect<'policy> {
  state: RedirectState<'policy>
  history: History
}

effect fn initialize<'uri, 'method, 'headers, 'policy>(
  request: Request<'uri, 'method, 'headers, 'policy>,
  policy: &'policy Policy,
) -> InitialRedirect<'policy> ! RedirectError | ValueError | OutOfMemoryError ? &mut Allocator {
  let limits = Policy.historyLimits(policy)
  let uriLength = String.byteLength(Uri.format(&request.uri))
  if uriLength > limits.maxUriBytes {
    fail RedirectError {
      component: RedirectComponent.Uri,
      reason: RedirectReason.LimitExceeded {
        limit: RedirectLimit.UriBytes,
        allowed: limits.maxUriBytes,
        attempted: uriLength,
      },
      context: emptyContext(usize.ZERO, Option.none<Status>()),
    }
  }
  let origin = match move requiredOrigin(&request.uri, usize.ZERO, Option.none<Status>()) {
    Result.Failure {error} => {
      let enriched = run enrichCurrent(move error, &request.uri)
      fail move enriched
    }
    Result.Success {value} => value
  }
  let mut history = match move run History.make(limits) {
    Result.Failure {error} => {
      let enriched = run enrichCurrent(move error, &request.uri)
      fail move enriched
    }
    Result.Success {value} => move value
  }
  match move run History.insert(&mut history, request.method, origin, &request.uri) {
    Result.Failure {error} => {
      let enriched = run enrichCurrent(move error, &request.uri)
      fail move enriched
    }
    Result.Success {value} => {}
  }
  let headers = match move run sanitizeHeaders(
    &request.headers,
    policy,
    false,
    BodyDecision.Retain,
    request.limits,
  ) {
    Result.Failure {error} => {
      fail move error
    }
    Result.Success {value} => move value
  }
  let uri = run Uri.copy(&request.uri)
  let method = run String.copy(Method.format(&request.method))
  return InitialRedirect<'policy> {
    state: RedirectState<'policy> {
      uri: move uri,
      method: move method,
      headers: move headers,
      headerPolicy: request.headerPolicy,
      version: request.version,
      continuePolicy: move request.continuePolicy,
      requestLimits: request.limits,
      maxHeadBytes: request.maxHeadBytes,
      maxCredentialBytes: request.maxCredentialBytes,
      expectedBodyMode: Option.none<BodyMode>(),
    },
    history: move history,
  }
}

service AttemptDispatch<'policy, H, A, E, ?R> {
  effect<'env> fn withAttempt<'env>(
    request: AttemptRequest<'policy>,
    deadline: Option<Instant>,
    handler: H,
  ) -> A ! E ? R | &mut AttemptDispatch<'policy, H, A, E, R>
}

struct RoutedAttemptDispatch<
  'client,
  'resources,
  'callback,
  'policy,
  P,
  A,
  C,
  H,
  BodyError,
  CallbackError,
  AcquisitionError,
  ?BodyRequirements,
  ?CallbackRequirements,
  ?AcquisitionRequirements,
> {
  policy: &'policy Policy
  client: &'client mut C
  scratch: &'resources mut [u8]
  callback: &'callback mut H
}

impl<
  'client,
  'resources,
  'callback,
  'policy,
  P,
  A,
  BodyError,
  CallbackError,
  AcquisitionError,
  ?BodyRequirements,
  ?CallbackRequirements,
  ?AcquisitionRequirements,
  H: ResponseHandler<P, A, CallbackError ? CallbackRequirements>,
  C: AttemptClient<'policy, P, AttemptStep<'policy, A>, RedirectError | ValueError | BodyError | CallbackError | ClientError | OutOfMemoryError, AcquisitionError, AcquisitionRequirements ? BodyRequirements | CallbackRequirements | &mut SelectedBody<
    BodyError,
    BodyRequirements,
  > | &mut MonotonicClock | &mut Allocator | &mut Random>,
> AttemptDispatch<'policy, RedirectAttemptHandler<'policy, BodyError, BodyRequirements>, AttemptStep<
  'policy,
  A,
>, RedirectError | ValueError | BodyError | CallbackError | ClientError | OutOfMemoryError | AcquisitionError ? BodyRequirements | CallbackRequirements | AcquisitionRequirements | &mut SelectedBody<
  BodyError,
  BodyRequirements,
> | &mut MonotonicClock | &mut Allocator | &mut Random> for RoutedAttemptDispatch<
  'client,
  'resources,
  'callback,
  'policy,
  P,
  A,
  C,
  H,
  BodyError,
  CallbackError,
  AcquisitionError,
  BodyRequirements,
  CallbackRequirements,
  AcquisitionRequirements,
> {
  effect<'env> fn withAttempt<'env>(
    dispatch: &mut Self,
    request: AttemptRequest<'policy>,
    deadline: Option<Instant>,
    handler: RedirectAttemptHandler<'policy, BodyError, BodyRequirements>,
  ) -> AttemptStep<'policy, A>
  ! RedirectError | ValueError | BodyError | CallbackError | ClientError | OutOfMemoryError | AcquisitionError
  ? BodyRequirements | CallbackRequirements | AcquisitionRequirements | &mut SelectedBody<
    BodyError,
    BodyRequirements,
  > | &mut MonotonicClock | &mut Allocator | &mut Random {
    let mut provider = RedirectRoutedAttempt<
      P,
      A,
      BodyError,
      BodyRequirements,
      CallbackError,
      CallbackRequirements,
      H,
    > {
      handler: Option.some<RedirectAttemptHandler<'policy, BodyError, BodyRequirements>>(
        move handler,
      ),
      scratch: &mut dispatch.scratch,
      callback: &mut dispatch.callback.*,
    }
    return run AttemptClient<'policy, P, AttemptStep<'policy, A>, RedirectError | ValueError | BodyError | CallbackError | ClientError | OutOfMemoryError, AcquisitionError, AcquisitionRequirements ? BodyRequirements | CallbackRequirements | &mut SelectedBody<
      BodyError,
      BodyRequirements,
    > | &mut MonotonicClock | &mut Allocator | &mut Random>.withAttempt(
      &mut dispatch.client.*,
      move request,
      move deadline,
    )
      |> Effect.provideMut<
        Attempt<'policy, P, AttemptStep<'policy, A>, RedirectError | ValueError | BodyError | CallbackError | ClientError | OutOfMemoryError ? BodyRequirements | CallbackRequirements | &mut SelectedBody<
          BodyError,
          BodyRequirements,
        > | &mut MonotonicClock | &mut Allocator | &mut Random>,
      >(&mut provider)
  }
}

struct HybridAttemptDispatch<
  'client,
  'resources,
  'callback,
  'policy,
  RoutedP,
  DirectP,
  A,
  C,
  H,
  BodyError,
  CallbackError,
  AcquisitionError,
  ?BodyRequirements,
  ?CallbackRequirements,
  ?AcquisitionRequirements,
> {
  policy: &'policy Policy
  client: &'client mut C
  scratch: &'resources mut [u8]
  callback: &'callback mut H
}

impl<
  'client,
  'resources,
  'callback,
  'policy,
  RoutedP,
  DirectP,
  A,
  BodyError,
  CallbackError,
  AcquisitionError,
  ?BodyRequirements,
  ?CallbackRequirements,
  ?AcquisitionRequirements,
  H: HybridResponseHandler<RoutedP, DirectP, A, CallbackError ? CallbackRequirements>,
  C: HybridAttemptClient<'policy, RoutedP, DirectP, AttemptStep<'policy, A>, RedirectError | ValueError | BodyError | CallbackError | ClientError | OutOfMemoryError, AcquisitionError, AcquisitionRequirements ? BodyRequirements | CallbackRequirements | &mut SelectedBody<
    BodyError,
    BodyRequirements,
  > | &mut MonotonicClock | &mut Allocator | &mut Random>,
> AttemptDispatch<'policy, RedirectAttemptHandler<'policy, BodyError, BodyRequirements>, AttemptStep<
  'policy,
  A,
>, RedirectError | ValueError | BodyError | CallbackError | ClientError | OutOfMemoryError | AcquisitionError ? BodyRequirements | CallbackRequirements | AcquisitionRequirements | &mut SelectedBody<
  BodyError,
  BodyRequirements,
> | &mut MonotonicClock | &mut Allocator | &mut Random> for HybridAttemptDispatch<
  'client,
  'resources,
  'callback,
  'policy,
  RoutedP,
  DirectP,
  A,
  C,
  H,
  BodyError,
  CallbackError,
  AcquisitionError,
  BodyRequirements,
  CallbackRequirements,
  AcquisitionRequirements,
> {
  effect<'env> fn withAttempt<'env>(
    dispatch: &mut Self,
    request: AttemptRequest<'policy>,
    deadline: Option<Instant>,
    handler: RedirectAttemptHandler<'policy, BodyError, BodyRequirements>,
  ) -> AttemptStep<'policy, A>
  ! RedirectError | ValueError | BodyError | CallbackError | ClientError | OutOfMemoryError | AcquisitionError
  ? BodyRequirements | CallbackRequirements | AcquisitionRequirements | &mut SelectedBody<
    BodyError,
    BodyRequirements,
  > | &mut MonotonicClock | &mut Allocator | &mut Random {
    let mut provider = RedirectHybridAttempt<
      RoutedP,
      DirectP,
      A,
      BodyError,
      BodyRequirements,
      CallbackError,
      CallbackRequirements,
      H,
    > {
      handler: Option.some<RedirectAttemptHandler<'policy, BodyError, BodyRequirements>>(
        move handler,
      ),
      scratch: &mut dispatch.scratch,
      callback: &mut dispatch.callback.*,
    }
    return run HybridAttemptClient<'policy, RoutedP, DirectP, AttemptStep<'policy, A>, RedirectError | ValueError | BodyError | CallbackError | ClientError | OutOfMemoryError, AcquisitionError, AcquisitionRequirements ? BodyRequirements | CallbackRequirements | &mut SelectedBody<
      BodyError,
      BodyRequirements,
    > | &mut MonotonicClock | &mut Allocator | &mut Random>.withAttempt(
      &mut dispatch.client.*,
      move request,
      move deadline,
    )
      |> Effect.provideMut<
        HybridAttempt<'policy, RoutedP, DirectP, AttemptStep<'policy, A>, RedirectError | ValueError | BodyError | CallbackError | ClientError | OutOfMemoryError ? BodyRequirements | CallbackRequirements | &mut SelectedBody<
          BodyError,
          BodyRequirements,
        > | &mut MonotonicClock | &mut Allocator | &mut Random>,
      >(&mut provider)
  }
}

interface SelectedAttempt<P, A, E, ?R> {
  effect<'env> fn handle<'env>(handler: Self, mode: BodyMode, replayable: bool) -> A ! E ? R
}

struct SelectedAttemptHandler<
  'policy,
  E,
  ?R,
  P,
  A,
  CallbackError,
  AcquisitionError,
  ?CallbackRequirements,
  ?AcquisitionRequirements,
> {
  state: RedirectState<'policy>
  policy: &'policy Policy
  history: History
  followedHops: usize
  hasScratch: bool
  deadline: Option<Instant>
}

impl<
  'policy,
  E,
  ?R,
  P,
  A,
  CallbackError,
  AcquisitionError,
  ?CallbackRequirements,
  ?AcquisitionRequirements,
> SelectedAttempt<P, AttemptStep<'policy, A>, RedirectError | ValueError | E | CallbackError | ClientError | OutOfMemoryError | AcquisitionError ? R | CallbackRequirements | AcquisitionRequirements | &mut SelectedBody<
  E,
  R,
> | &mut AttemptDispatch<'policy, RedirectAttemptHandler<'policy, E, R>, AttemptStep<'policy, A>, RedirectError | ValueError | E | CallbackError | ClientError | OutOfMemoryError | AcquisitionError ? R | CallbackRequirements | AcquisitionRequirements | &mut SelectedBody<
  E,
  R,
> | &mut MonotonicClock | &mut Allocator | &mut Random> | &mut MonotonicClock | &mut Allocator | &mut Random> for SelectedAttemptHandler<
  'policy,
  E,
  R,
  P,
  A,
  CallbackError,
  AcquisitionError,
  CallbackRequirements,
  AcquisitionRequirements,
>
where
  R in Without<R, ByteDuplex>,
  R in Without<R, HttpTransport>,
  CallbackRequirements in Without<CallbackRequirements, ByteDuplex>,
  CallbackRequirements in Without<CallbackRequirements, HttpTransport> {
  effect<'env> fn handle<'env>(self: Self, mode: BodyMode, replayable: bool) -> AttemptStep<
    'policy,
    A,
  >
  ! RedirectError | ValueError | E | CallbackError | ClientError | OutOfMemoryError | AcquisitionError
  ? R | CallbackRequirements | AcquisitionRequirements | &mut SelectedBody<E, R> | &mut AttemptDispatch<'policy, RedirectAttemptHandler<
    'policy,
    E,
    R,
  >, AttemptStep<'policy, A>, RedirectError | ValueError | E | CallbackError | ClientError | OutOfMemoryError | AcquisitionError ? R | CallbackRequirements | AcquisitionRequirements | &mut SelectedBody<
    E,
    R,
  > | &mut MonotonicClock | &mut Allocator | &mut Random> | &mut MonotonicClock | &mut Allocator | &mut Random {
    let SelectedAttemptHandler<
      'policy,
      E,
      R,
      P,
      A,
      CallbackError,
      AcquisitionError,
      CallbackRequirements,
      AcquisitionRequirements,
    > {state, policy, history, followedHops, hasScratch, deadline} = move self
    if let Option.Some {value} = &state.expectedBodyMode {
      if !bodyModesEqual(value, mode) {
        let enriched = run enrichCurrent(bodyContractFailure(followedHops), &state.uri.view())
        fail move enriched
      }
    }
    let nonempty = match mode {
      BodyMode.Empty => false
      _ => true
    }
    if nonempty && !hasScratch {
      let enriched = run enrichCurrent(bodyContractFailure(followedHops), &state.uri.view())
      fail move enriched
    }
    let request = intoAttemptRequest(move state, mode)
    let attemptHandler = RedirectAttemptHandler<'policy, E, R> {
      policy: policy,
      history: move history,
      followedHops: followedHops,
      replayable: replayable,
    }
    return run AttemptDispatch.withAttempt<
      'policy,
      RedirectAttemptHandler<'policy, E, R>,
      AttemptStep<'policy, A>,
      RedirectError | ValueError | E | CallbackError | ClientError | OutOfMemoryError | AcquisitionError,
      R | CallbackRequirements | AcquisitionRequirements | &mut SelectedBody<E, R> | &mut MonotonicClock | &mut Allocator | &mut Random,
    >(move request, move deadline, move attemptHandler)
  }
}

interface SourcePlan<
  P,
  BodyError,
  A,
  SourceError,
  HandlerError,
  ?BodyRequirements,
  ?SourceRequirements,
  ?HandlerRequirements,
  H: SelectedAttempt<P, A, HandlerError ? HandlerRequirements | &mut SelectedBody<
    BodyError,
    BodyRequirements,
  >>,
> {
  effect<'env> fn withSelected<'env>(plan: &mut Self, handler: H) -> A ! SourceError | HandlerError ? SourceRequirements | HandlerRequirements
  fn applyRedirect(plan: &mut Self, body: BodyDecision) -> ()
}

effect<'env> fn runEmptySelected<
  P,
  BodyError,
  A,
  HandlerError,
  ?BodyRequirements,
  ?HandlerRequirements,
  H: SelectedAttempt<P, A, HandlerError ? HandlerRequirements | &mut SelectedBody<
    BodyError,
    BodyRequirements,
  >> + 'env,
  'env,
>(handler: H) -> A ! HandlerError ? HandlerRequirements {
  let mut provider = BytesSelected<'static, BodyError, BodyRequirements> {
    bytes: b"",
    offset: usize.ZERO,
  }
  return run SelectedAttempt<P, A, HandlerError ? HandlerRequirements | &mut SelectedBody<
    BodyError,
    BodyRequirements,
  >>.handle(move handler, BodyMode.Empty, true)
    |> Effect.provideMut<SelectedBody<BodyError, BodyRequirements>>(&mut provider)
}

struct RepeatablePlan<
  'bytes,
  P,
  BodyError,
  A,
  HandlerError,
  ?BodyRequirements,
  ?HandlerRequirements,
  H,
> {
  bytes: &'bytes [u8]
  retained: bool
}

impl<
  'bytes,
  P,
  BodyError,
  A,
  HandlerError,
  ?BodyRequirements,
  ?HandlerRequirements,
  H: SelectedAttempt<P, A, HandlerError ? HandlerRequirements | &mut SelectedBody<
    BodyError,
    BodyRequirements,
  >>,
> SourcePlan<P, BodyError, A, never, HandlerError, BodyRequirements, never, HandlerRequirements, H> for RepeatablePlan<
  'bytes,
  P,
  BodyError,
  A,
  HandlerError,
  BodyRequirements,
  HandlerRequirements,
  H,
> {
  effect<'env> fn withSelected<'env>(plan: &mut Self, handler: H) -> A
  ! HandlerError
  ? HandlerRequirements {
    if plan.retained && plan.bytes.length != usize.ZERO {
      let mut provider = BytesSelected<'bytes, BodyError, BodyRequirements> {
        bytes: plan.bytes,
        offset: usize.ZERO,
      }
      return run SelectedAttempt<P, A, HandlerError ? HandlerRequirements | &mut SelectedBody<
        BodyError,
        BodyRequirements,
      >>.handle(move handler, BodyMode.KnownLength {length: usize.toU64(plan.bytes.length)}, true)
        |> Effect.provideMut<SelectedBody<BodyError, BodyRequirements>>(&mut provider)
    }
    return run runEmptySelected<
      P,
      BodyError,
      A,
      HandlerError,
      BodyRequirements,
      HandlerRequirements,
      H,
    >(move handler)
  }
  fn applyRedirect(plan: &mut Self, body: BodyDecision) -> () {
    if body == BodyDecision.Drop {
      plan.retained = false
    }
    return ()
  }
}

union OneShotState<Producer> {
  Fresh {producer: Producer},
  Spent,
}

struct OneShotPlan<
  P,
  BodyError,
  A,
  HandlerError,
  ?BodyRequirements,
  ?HandlerRequirements,
  Producer,
  H,
> {
  state: OneShotState<Producer>
}

impl<
  P,
  BodyError,
  A,
  HandlerError,
  ?BodyRequirements,
  ?HandlerRequirements,
  Producer: BodyProducer<BodyError ? BodyRequirements>,
  H: SelectedAttempt<P, A, HandlerError ? HandlerRequirements | &mut SelectedBody<
    BodyError,
    BodyRequirements,
  >>,
> SourcePlan<P, BodyError, A, never, HandlerError, BodyRequirements, never, HandlerRequirements, H> for OneShotPlan<
  P,
  BodyError,
  A,
  HandlerError,
  BodyRequirements,
  HandlerRequirements,
  Producer,
  H,
> {
  effect<'env> fn withSelected<'env>(plan: &mut Self, handler: H) -> A
  ! HandlerError
  ? HandlerRequirements {
    let state = Intrinsic.replace(plan.state, OneShotState<Producer>.Spent)
    return match move state {
      OneShotState.Spent => {
        return run runEmptySelected<
          P,
          BodyError,
          A,
          HandlerError,
          BodyRequirements,
          HandlerRequirements,
          H,
        >(move handler)
      }
      OneShotState.Fresh {producer} => {
        let mode = BodyProducer<BodyError ? BodyRequirements>.mode(&producer)
        let mut owned = move producer
        let mut provider = ProducerSelected<Producer, BodyError, BodyRequirements> {
          producer: &mut owned,
        }
        return run SelectedAttempt<P, A, HandlerError ? HandlerRequirements | &mut SelectedBody<
          BodyError,
          BodyRequirements,
        >>.handle(move handler, mode, false)
          |> Effect.provideMut<SelectedBody<BodyError, BodyRequirements>>(&mut provider)
      }
    }
  }
  fn applyRedirect(plan: &mut Self, body: BodyDecision) -> () {
    drop plan
    drop body
    return ()
  }
}

struct ReplayPlan<
  P,
  BodyError,
  A,
  FactoryError,
  HandlerError,
  ?BodyRequirements,
  ?FactoryRequirements,
  ?HandlerRequirements,
  Factory,
  Producer,
  H,
> {
  factory: Factory
  retained: bool
}

impl<
  P,
  BodyError,
  A,
  FactoryError,
  HandlerError,
  ?BodyRequirements,
  ?FactoryRequirements,
  ?HandlerRequirements,
  Producer: BodyProducer<BodyError ? BodyRequirements>,
  H: SelectedAttempt<P, A, HandlerError ? HandlerRequirements | &mut SelectedBody<
    BodyError,
    BodyRequirements,
  >>,
  Factory: ReplayFactory<Producer, FactoryError, FactoryRequirements>,
> SourcePlan<
  P,
  BodyError,
  A,
  FactoryError,
  HandlerError,
  BodyRequirements,
  FactoryRequirements,
  HandlerRequirements,
  H,
> for ReplayPlan<
  P,
  BodyError,
  A,
  FactoryError,
  HandlerError,
  BodyRequirements,
  FactoryRequirements,
  HandlerRequirements,
  Factory,
  Producer,
  H,
> {
  effect<'env> fn withSelected<'env>(plan: &mut Self, handler: H) -> A
  ! FactoryError | HandlerError
  ? FactoryRequirements | HandlerRequirements {
    if plan.retained {
      let producer = run ReplayFactory<Producer, FactoryError, FactoryRequirements>.acquire(
        &mut plan.factory,
      )
      let use = effect fn(owned: &mut Producer) -> A ! HandlerError ? HandlerRequirements {
        let mode = BodyProducer<BodyError ? BodyRequirements>.mode(&owned)
        let mut provider = ProducerSelected<Producer, BodyError, BodyRequirements> {
          producer: move owned,
        }
        return run SelectedAttempt<P, A, HandlerError ? HandlerRequirements | &mut SelectedBody<
          BodyError,
          BodyRequirements,
        >>.handle(move handler, mode, true)
          |> Effect.provideMut<SelectedBody<BodyError, BodyRequirements>>(&mut provider)
      }
      let release = effect fn(owned: &mut Producer) -> () {
        return ReplayFactory<Producer, FactoryError, FactoryRequirements>.release(
          &mut plan.factory,
          owned,
        )
      }
      return run Effect.useReleaseNonParking(move producer, move use, move release)
    }
    return run runEmptySelected<
      P,
      BodyError,
      A,
      HandlerError,
      BodyRequirements,
      HandlerRequirements,
      H,
    >(move handler)
  }
  fn applyRedirect(plan: &mut Self, body: BodyDecision) -> () {
    if body == BodyDecision.Drop {
      plan.retained = false
    }
    return ()
  }
}

effect<'env> fn runResponseLoop<
  'policy,
  'client,
  'uri,
  'method,
  'headers,
  P,
  A,
  BodyError,
  SourceError,
  CallbackError,
  AcquisitionError,
  ?BodyRequirements,
  ?SourceRequirements,
  ?CallbackRequirements,
  ?AcquisitionRequirements,
  D,
  Plan: SourcePlan<
    P,
    BodyError,
    AttemptStep<'policy, A>,
    SourceError,
    RedirectError | ValueError | BodyError | CallbackError | ClientError | OutOfMemoryError | AcquisitionError,
    BodyRequirements,
    SourceRequirements,
    BodyRequirements | CallbackRequirements | AcquisitionRequirements | &mut AttemptDispatch<'policy, RedirectAttemptHandler<
      'policy,
      BodyError,
      BodyRequirements,
    >, AttemptStep<'policy, A>, RedirectError | ValueError | BodyError | CallbackError | ClientError | OutOfMemoryError | AcquisitionError ? BodyRequirements | CallbackRequirements | AcquisitionRequirements | &mut SelectedBody<
      BodyError,
      BodyRequirements,
    > | &mut MonotonicClock | &mut Allocator | &mut Random> | &mut MonotonicClock | &mut Allocator | &mut Random,
    SelectedAttemptHandler<
      'policy,
      BodyError,
      BodyRequirements,
      P,
      A,
      CallbackError,
      AcquisitionError,
      CallbackRequirements,
      AcquisitionRequirements,
    >,
  > + 'env,
  'env,
>(
  dispatch: &'client mut D,
  request: Request<'uri, 'method, 'headers, 'policy>,
  policy: &'policy Policy,
  plan: Plan,
  deadline: Option<Instant>,
  hasScratch: bool,
) -> A
! RedirectError | ValueError | BodyError | SourceError | CallbackError | ClientError | OutOfMemoryError | AcquisitionError
? BodyRequirements | SourceRequirements | CallbackRequirements | AcquisitionRequirements | &mut MonotonicClock | &mut Allocator | &mut Random
where
  &mut D provides &AttemptDispatch<'policy, RedirectAttemptHandler<
    'policy,
    BodyError,
    BodyRequirements,
  >, AttemptStep<'policy, A>, RedirectError | ValueError | BodyError | CallbackError | ClientError | OutOfMemoryError | AcquisitionError ? BodyRequirements | CallbackRequirements | AcquisitionRequirements | &mut SelectedBody<
    BodyError,
    BodyRequirements,
  > | &mut MonotonicClock | &mut Allocator | &mut Random> from BodyRequirements | SourceRequirements | CallbackRequirements | AcquisitionRequirements | &mut AttemptDispatch<'policy, RedirectAttemptHandler<
    'policy,
    BodyError,
    BodyRequirements,
  >, AttemptStep<'policy, A>, RedirectError | ValueError | BodyError | CallbackError | ClientError | OutOfMemoryError | AcquisitionError ? BodyRequirements | CallbackRequirements | AcquisitionRequirements | &mut SelectedBody<
    BodyError,
    BodyRequirements,
  > | &mut MonotonicClock | &mut Allocator | &mut Random> | &mut MonotonicClock | &mut Allocator | &mut Random,
  BodyRequirements in Without<BodyRequirements, ByteDuplex>,
  BodyRequirements in Without<BodyRequirements, HttpTransport>,
  SourceRequirements in Without<SourceRequirements, ByteDuplex>,
  SourceRequirements in Without<SourceRequirements, HttpTransport>,
  CallbackRequirements in Without<CallbackRequirements, ByteDuplex>,
  CallbackRequirements in Without<CallbackRequirements, HttpTransport>,
  AcquisitionRequirements in Without<AcquisitionRequirements, ByteDuplex>,
  AcquisitionRequirements in Without<AcquisitionRequirements, HttpTransport> {
  let initial = run initialize(move request, policy)
  let InitialRedirect<'policy> {state: initialState, history: initialHistory} = move initial
  let mut currentState = move initialState
  let mut currentHistory = move initialHistory
  let mut selectedPlan = move plan
  let mut followedHops = usize.ZERO
  while true {
    let selected = SelectedAttemptHandler<
      'policy,
      BodyError,
      BodyRequirements,
      P,
      A,
      CallbackError,
      AcquisitionError,
      CallbackRequirements,
      AcquisitionRequirements,
    > {
      state: move currentState,
      policy: policy,
      history: move currentHistory,
      followedHops: followedHops,
      hasScratch: hasScratch,
      deadline: copyDeadline(&deadline),
    }
    let outcome = run SourcePlan<
      P,
      BodyError,
      AttemptStep<'policy, A>,
      SourceError,
      RedirectError | ValueError | BodyError | CallbackError | ClientError | OutOfMemoryError | AcquisitionError,
      BodyRequirements,
      SourceRequirements,
      BodyRequirements | CallbackRequirements | AcquisitionRequirements | &mut AttemptDispatch<'policy, RedirectAttemptHandler<
        'policy,
        BodyError,
        BodyRequirements,
      >, AttemptStep<'policy, A>, RedirectError | ValueError | BodyError | CallbackError | ClientError | OutOfMemoryError | AcquisitionError ? BodyRequirements | CallbackRequirements | AcquisitionRequirements | &mut SelectedBody<
        BodyError,
        BodyRequirements,
      > | &mut MonotonicClock | &mut Allocator | &mut Random> | &mut MonotonicClock | &mut Allocator | &mut Random,
      SelectedAttemptHandler<
        'policy,
        BodyError,
        BodyRequirements,
        P,
        A,
        CallbackError,
        AcquisitionError,
        CallbackRequirements,
        AcquisitionRequirements,
      >,
    >.withSelected(&mut selectedPlan, move selected)
      |> Effect.provideMut<
        AttemptDispatch<'policy, RedirectAttemptHandler<'policy, BodyError, BodyRequirements>, AttemptStep<
          'policy,
          A,
        >, RedirectError | ValueError | BodyError | CallbackError | ClientError | OutOfMemoryError | AcquisitionError ? BodyRequirements | CallbackRequirements | AcquisitionRequirements | &mut SelectedBody<
          BodyError,
          BodyRequirements,
        > | &mut MonotonicClock | &mut Allocator | &mut Random>,
      >(&mut dispatch.*)
    match move outcome {
      AttemptStep<'policy, A>.Final {value} => {
        return move value
      }
      AttemptStep<'policy, A>.Redirect {state, history, body} => {
        SourcePlan<
          P,
          BodyError,
          AttemptStep<'policy, A>,
          SourceError,
          RedirectError | ValueError | BodyError | CallbackError | ClientError | OutOfMemoryError | AcquisitionError,
          BodyRequirements,
          SourceRequirements,
          BodyRequirements | CallbackRequirements | AcquisitionRequirements | &mut AttemptDispatch<'policy, RedirectAttemptHandler<
            'policy,
            BodyError,
            BodyRequirements,
          >, AttemptStep<'policy, A>, RedirectError | ValueError | BodyError | CallbackError | ClientError | OutOfMemoryError | AcquisitionError ? BodyRequirements | CallbackRequirements | AcquisitionRequirements | &mut SelectedBody<
            BodyError,
            BodyRequirements,
          > | &mut MonotonicClock | &mut Allocator | &mut Random> | &mut MonotonicClock | &mut Allocator | &mut Random,
          SelectedAttemptHandler<
            'policy,
            BodyError,
            BodyRequirements,
            P,
            A,
            CallbackError,
            AcquisitionError,
            CallbackRequirements,
            AcquisitionRequirements,
          >,
        >.applyRedirect(&mut selectedPlan, body)
        currentState = move state
        currentHistory = move history
        followedHops = followedHops + usize.ONE
      }
    }
  }
  return impossible<A>()
}

fn impossible<T>() -> T {
  return impossible<T>()
}

/// Follows a body-free request and lends exactly one final response.
///
/// # When to use
///
/// Use when every retained redirect can repeat an empty request without source authority.
///
/// # Details
///
/// Each attempt is rebuilt under the unchanged caller deadline. Intermediate responses are closed
/// or boundedly drained according to `policy`. If orchestration reaches a final response,
/// `handler` runs exactly once; an earlier failure does not invoke it.
pub effect<'env> fn withEmptyResponse<
  'client,
  'uri,
  'method,
  'headers,
  'policy,
  'scratch,
  P,
  A,
  CallbackError,
  AcquisitionError,
  ?CallbackRequirements,
  ?AcquisitionRequirements,
  H: ResponseHandler<P, A, CallbackError ? CallbackRequirements> + 'env,
  C: AttemptClient<'policy, P, AttemptStep<'policy, A>, RedirectError | ValueError | CallbackError | ClientError | OutOfMemoryError, AcquisitionError, AcquisitionRequirements ? CallbackRequirements | &mut SelectedBody<
    never,
    never,
  > | &mut MonotonicClock | &mut Allocator | &mut Random>,
  'env,
>(
  client: &'client mut C,
  request: Request<'uri, 'method, 'headers, 'policy>,
  policy: &'policy Policy,
  deadline: Option<Instant>,
  scratch: &'scratch mut [u8],
  handler: H,
) -> A
! RedirectError | ValueError | CallbackError | ClientError | OutOfMemoryError | AcquisitionError
