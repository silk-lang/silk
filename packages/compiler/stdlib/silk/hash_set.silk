//! Owned unique elements with deterministic seeded hashing and open-addressed membership lookup.
//!
//! # When to use
//! Use [`HashSet`] when equivalence and fast membership are central and an element has a [`HashKey`]
//! witness. Use `silk.vector.Vector` when order or duplicate values are part of the data.
//!
//! # Details
//! The set starts allocation-free, first allocates eight buckets, and grows before used buckets
//! exceed three quarters of the table. Linear probing crosses removal markers; growth doubles the
//! table, moves every live element, and discards those markers. Allocation completes before commit,
//! so failed growth leaves prior membership, length, and bucket count unchanged.
//!
//! One [`HashSeed`] plus the same operation sequence fixes bucket presentation order on every
//! engine. Iterate deterministically by scanning `0..bucketCount`, testing [`occupiedAt`], and then
//! calling [`elementAt`]. This is bucket order, not insertion order.
//!
//! # Gotchas
//! Probes are consumed. Inserting an equivalent element keeps the element already stored and drops
//! the arrival; [`remove`] instead transfers the stored element to the caller. [`elementAt`] copies
//! and therefore requires a `Copy` element; [`contains`] and [`indexOf`] can inspect membership for
//! move-only elements without taking them out.
//!
//! # Examples
//! ## Insert one unique element and remove it
//! ```silk
//! import silk.allocator { Allocator, OutOfMemoryError }
//!
//! import silk.effect { Effect }
//!
//! import silk.hash { Hash, Word }
//!
//! import silk.hash_set { HashSet }
//!
//! import silk.option { Option }
//!
//! import silk.u64
//!
//! effect fn build() -> i32
//! ! OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let mut set = HashSet.make<Word>(Hash.seed(17))
//!   let mut inserting = HashSet.insert<Word>(&mut set, Hash.word(42))
//!     |> Effect.provideMut<Allocator>(&mut allocator)
//!   let existed = run inserting
//!   if existed || !HashSet.contains<Word>(&set, Hash.word(42)) {
//!     return 0
//!   }
//!   let removed = HashSet.remove<Word>(&mut set, Hash.word(42))
//!     |> Option.unwrapOr<Word>(Hash.word(0))
//!   return u64.toI32(removed.value)
//! }
//!
//! effect fn recover(error: OutOfMemoryError) -> i32 {
//!   return 0
//! }
//!
//! pub fn main() -> i32 {
//!   return run Effect.catchAll(build(), recover)
//! }
//! ```

// A hashed set over the allocation substrate, on the same table `hash_map.silk` describes: open
// addressing with linear probing over an element buffer and a state buffer of one width, each
// element carrying the hash it was placed under, and every bucket index reduced in u64 arithmetic
// before it narrows to `usize`.
//
// The table is written out again rather than reached for, because a bound is not carried into a
// nested generic call: a `T: HashKey` body cannot hand its own `T` to a `K: HashKey` function, so a
// set cannot be a map whose values are empty. What the two share is the shape, not the code.

import silk.bool
import silk.allocator { Allocator, OutOfMemoryError }
import silk.allocator { OutOfMemoryError }
import silk.hash { HashKey, HashSeed }
import silk.layout { Layout }
import silk.layout { LayoutOverflow }
import silk.option { Option }
import silk.raw_buffer { RawBuffer }
import silk.slot { Slot }
import silk.u64
import silk.u8
import silk.usize

/// A slot is vacant, and no element was ever placed here.
const VACANT: u8 = 0

/// A slot holds an initialized element.
const OCCUPIED: u8 = 1

/// A slot held an element that was removed. Probing continues through it.
const REMOVED: u8 = 2

/// The width a set takes when it first allocates.
const INITIAL_WIDTH: usize = 8

/// Internal hashed element record exposed by the current table representation.
pub struct Member<T> {
  hash: u64
  value: T
}

impl<T: Copy> Copy for Member<T> {}

/// Allocation-free storage state used before the set creates its first table.
pub struct Unseeded<T> {
  anchor: [Member<T>; 0]
}

/// Allocated element and occupancy buffers used by [`HashSet`].
pub struct Slots<T> {
  members: RawBuffer<Member<T>>
  states: RawBuffer<u8>
}

/// Owns one representative of each equivalence class under one hash witness and seed.
///
/// # Details
///
/// An equivalent insertion keeps the representative already stored. The seed and operation
/// sequence determine bucket presentation order, which is not insertion order.
pub struct HashSet<T> {
  storage: Unseeded<T> | Slots<T>
  seed: HashSeed
  count: usize
  used: usize
  capacity: usize
}

impl<T> HashSet<T> {
  /// Creates an empty set whose every hash is computed under one seed.
  ///
  /// # Details
  ///
  /// An empty set allocates no storage. The seed fixes bucket order for the same operation sequence.
  pub fn make(seed: HashSeed) -> HashSet<T> {
    return HashSet<T> {
      storage: Unseeded<T> { anchor: [] },
      seed: move seed,
      count: usize.ZERO,
      used: usize.ZERO,
      capacity: usize.ZERO,
    }
  }

  /// Returns the number of elements the set holds.
  pub fn length(self: &Self) -> usize {
    return self.count
  }

  /// Returns the number of buckets the set presents, which is the range `occupiedAt` accepts.
  pub fn bucketCount(self: &Self) -> usize {
    return self.capacity
  }

  /// Reports whether one bucket holds an element. Out-of-range buckets hold nothing.
  pub fn occupiedAt(self: &Self, index: usize) -> bool {
    if self.capacity <= index {
      return false
    }
    return stateAt<T>(self, index) == OCCUPIED
  }

  /// Inserts one owned element, reporting whether an equivalent element was already held.
  ///
  /// # Details
  ///
  /// A set never holds two equivalent elements. When one is already held the set is unchanged and the
  /// arriving element is released, so the element that survives is the one the set already had.
  ///
  /// Fails only with `OutOfMemoryError`, and only from the growth this insert needed. A failed insert
  /// leaves every prior element present, and leaves the length and the bucket count unchanged.
  pub effect<'env> fn insert<T: HashKey + 'env, 'env>(
    self: &mut Self,
    value: T
  ) -> bool ! OutOfMemoryError ? &mut Allocator {
    let hashed = HashKey.hash(&value, &self.seed)
    if usize.ZERO < self.capacity {
      let storage = Intrinsic.replace(self.storage, Unseeded<T> { anchor: [] })
      let mut owned = openStorage<T>(move storage)
      let mut found = false
      let mut index = bucketOf(hashed, self.capacity)
      let mut scanned = usize.ZERO
      while scanned < self.capacity {
        let seen = RawBuffer.view<u8>(&owned.states, usize.ZERO, self.capacity)
        let state = seen[index]
        if state == VACANT {
          break
        }
        if state == OCCUPIED {
          let held = RawBuffer.view<Member<T>>(&owned.members, index, usize.ONE)
          if held[usize.ZERO].hash == hashed {
            if (&held[usize.ZERO].value) == (&value) {
              found = true
              break
            }
          }
        }
        index = advance(index, self.capacity)
        scanned = scanned + usize.ONE
      }
      self.storage = move owned
      if found {
        let released = release<T>(move value)
        return true
      }
    }
    // The element is absent. Growth is allocated before the storage is opened, so a failure here
    // never observes the set with its buffers taken out.
    if needsRoom(self.used, self.capacity) {
      let next = grownWidth(self.capacity)
      let fresh = run allocateSlots<T>(next)
      let storage = Intrinsic.replace(self.storage, Unseeded<T> { anchor: [] })
      self.storage = migrate<T>(move storage, self.capacity, move fresh, next)
      self.capacity = next
      self.used = self.count
    }
    let storage = Intrinsic.replace(self.storage, Unseeded<T> { anchor: [] })
    let mut owned = openStorage<T>(move storage)
    let mut index = bucketOf(hashed, self.capacity)
    let mut searching = true
    while searching {
      let seen = RawBuffer.view<u8>(&owned.states, usize.ZERO, self.capacity)
      if seen[index] == OCCUPIED {
        index = advance(index, self.capacity)
      } else {
        searching = false
      }
    }
    let fresh = vacantAt<T>(&owned, index)
    let written = writeMember<T>(&mut owned, index, Member<T> { hash: hashed, value: move value })
    self.storage = move owned
    self.count = self.count + usize.ONE
    if fresh {
      self.used = self.used + usize.ONE
    }
    return false
  }

  /// Reports whether the set holds an element equivalent to one probe element.
  ///
  /// # Details
  ///
  /// This function consumes the probe element. It does not change the set or move a stored element.
  pub fn contains<T: HashKey>(self: &Self, value: T) -> bool {
    if self.capacity == usize.ZERO {
      return false
    }
    let hashed = HashKey.hash(&value, &self.seed)
    let mut index = bucketOf(hashed, self.capacity)
    let mut scanned = usize.ZERO
    while scanned < self.capacity {
      let state = stateAt<T>(self, index)
      if state == VACANT {
        return false
      }
      if state == OCCUPIED {
        let held = memberAt<T>(self, index)
        if held[usize.ZERO].hash == hashed {
          if (&held[usize.ZERO].value) == (&value) {
            return true
          }
        }
      }
      index = advance(index, self.capacity)
      scanned = scanned + usize.ONE
    }
    return false
  }

  /// Returns the bucket holding an element equivalent to one probe element, or an absent value.
  ///
  /// # Details
  ///
  /// This is the membership question a set of move-only elements answers without moving anything.
  /// This function consumes the probe element.
  pub fn indexOf<T: HashKey>(self: &Self, value: T) -> Option<usize> {
    if self.capacity == usize.ZERO {
      return Option.none<usize>()
    }
    let hashed = HashKey.hash(&value, &self.seed)
    let mut index = bucketOf(hashed, self.capacity)
    let mut scanned = usize.ZERO
    while scanned < self.capacity {
      let state = stateAt<T>(self, index)
      if state == VACANT {
        return Option.none<usize>()
      }
      if state == OCCUPIED {
        let held = memberAt<T>(self, index)
        if held[usize.ZERO].hash == hashed {
          if (&held[usize.ZERO].value) == (&value) {
            return Option.some<usize>(index)
          }
        }
      }
      index = advance(index, self.capacity)
      scanned = scanned + usize.ONE
    }
    return Option.none<usize>()
  }

  /// Removes the element equivalent to one probe element and answers with it.
  ///
  /// # Details
  ///
  /// Ownership passes to the caller; the set does not also release it. The probe element is released.
  pub fn remove<T: HashKey>(self: &mut Self, value: T) -> Option<T> {
    if self.capacity == usize.ZERO {
      return Option.none<T>()
    }
    let hashed = HashKey.hash(&value, &self.seed)
    let storage = Intrinsic.replace(self.storage, Unseeded<T> { anchor: [] })
    let mut owned = openStorage<T>(move storage)
    let mut found = self.capacity
    let mut index = bucketOf(hashed, self.capacity)
    let mut scanned = usize.ZERO
    while scanned < self.capacity {
      let seen = RawBuffer.view<u8>(&owned.states, usize.ZERO, self.capacity)
      let state = seen[index]
      if state == VACANT {
        break
      }
      if state == OCCUPIED {
        let held = RawBuffer.view<Member<T>>(&owned.members, index, usize.ONE)
        if held[usize.ZERO].hash == hashed {
          if (&held[usize.ZERO].value) == (&value) {
            found = index
            break
          }
        }
      }
      index = advance(index, self.capacity)
      scanned = scanned + usize.ONE
    }
    if self.capacity <= found {
      self.storage = move owned
      return Option.none<T>()
    }
    let carried = evict<T>(&mut owned, found)
    let marked = markRemoved<T>(&mut owned, found)
    self.storage = move owned
    self.count = self.count - usize.ONE
    return Option.some<T>(move carried)
  }

  /// Returns the element held in one bucket. Traps on a bucket that holds no element.
  ///
  /// # Details
  ///
  /// Reads a copy out of the set, so it answers for a set whose element type is `Copy`.
  ///
  /// # Gotchas
  ///
  /// If `index` is out of range or [`occupiedAt`] returns `false`, the program traps.
  pub fn elementAt<T: Copy>(self: &Self, index: usize) -> T {
    if !HashSet.occupiedAt<T>(self, index) {
      let boom = 1 / 0
    }
    return keep<T>(readMember<T>(self, index))
  }
}

// Diverges on the arms the surrounding logic has already proven impossible.
fn absurd<T>() -> T {
  let boom = 1 / 0
  return absurd<T>()
}

fn stateAt<T>(self: &HashSet<T>, index: usize) -> u8 {
  return match &self.storage {
    Unseeded<T> nothing => VACANT
    Slots<T> { members, states } => firstByte(RawBuffer.view<u8>(&states, index, usize.ONE))
  }
}

fn firstByte(seen: &[u8]) -> u8 {
  return seen[usize.ZERO]
}

fn memberAt<T>(self: &HashSet<T>, index: usize) -> &[Member<T>] {
  return match &self.storage {
    Unseeded<T> { anchor } => emptySlice<T>(&anchor)
    Slots<T> { members, states } => RawBuffer.view<Member<T>>(&members, index, usize.ONE)
  }
}

fn emptySlice<T>(anchor: &[Member<T>]) -> &[Member<T>] {
  return anchor
}

/// Reduces a hash to a bucket index in u64 arithmetic, so the index does not depend on the width of
/// `usize` and one seed therefore fixes one order on every supported target.
fn bucketOf(hashed: u64, width: usize) -> usize {
  return u64.toUsize(u64.remainder(hashed, usize.toU64(width)))
}

fn advance(index: usize, width: usize) -> usize {
  let next = index + usize.ONE
  if next == width {
    return usize.ZERO
  }
  return next
}

impl<T> Drop for HashSet<T> {
  fn drop(self: &mut HashSet<T>) -> () {
    let storage = Intrinsic.replace(self.storage, Unseeded<T> { anchor: [] })
    let width = Intrinsic.replace(self.capacity, usize.ZERO)
    let emptied = Intrinsic.replace(self.count, usize.ZERO)
    return match move storage {
      Unseeded<T> nothing => ()
      Slots<T> held => releaseSlots<T>(move held, width)
    }
  }
}

// Releases every occupied element exactly once and then both buffers, so a set dropped while
// non-empty destroys what it still owns rather than leaking it.
fn releaseSlots<T>(held: Slots<T>, width: usize) -> () {
  let mut owned = move held
  unsafe {
    let mut index = usize.ZERO
    while index < width {
      let seen = RawBuffer.view<u8>(&owned.states, usize.ZERO, width)
      if seen[index] == OCCUPIED {
        let selected = RawBuffer.slot(&mut owned.members, index)
        let cleared = Slot.dropValue(move selected)
      }
      index = index + usize.ONE
    }
    drop owned
  }
  return ()
}

fn openStorage<T>(storage: Unseeded<T> | Slots<T>) -> Slots<T> {
  return match move storage {
    Unseeded<T> nothing => absurd<Slots<T>>()
    Slots<T> held => move held
  }
}

effect fn overflowed() -> Layout ! OutOfMemoryError {
  return run Allocator.outOfMemory()
}

// Both buffers exist before either is installed, so an allocation that fails releases the one
// already taken and leaves the caller's set exactly as it was.
effect fn allocateSlots<T>(count: usize) -> Slots<T> ! OutOfMemoryError ? &mut Allocator {
  let states = run vacantStates(count)
  let members = run memberStorage<T>(count)
  return Slots<T> { members: move members, states: move states }
}

effect fn vacantStates(count: usize) -> RawBuffer<u8> ! OutOfMemoryError ? &mut Allocator {
  let element = Layout.of<u8>()
  let plan = Layout.repeat(move element, count)
  let layout = match move plan {
    Layout ready => move ready
    LayoutOverflow overflow => run overflowed()
  }
  let recipe = Allocator.allocate(move layout)
  let allocation = run recipe
  return markVacant(move allocation, count)
}

fn markVacant(allocation: Allocation, count: usize) -> RawBuffer<u8> {
  unsafe {
    let mut made = RawBuffer.from<u8>(move allocation, count)
    let mut index = usize.ZERO
    while index < count {
      let selected = RawBuffer.slot(&mut made, index)
      let written = Slot.write<u8>(move selected, VACANT)
      index = index + usize.ONE
    }
    return move made
  }
  return absurd<RawBuffer<u8>>()
}

effect fn memberStorage<T>(count: usize) -> RawBuffer<Member<T>> ! OutOfMemoryError ? &mut Allocator {
  let element = Layout.of<Member<T>>()
  let plan = Layout.repeat(move element, count)
  let layout = match move plan {
    Layout ready => move ready
    LayoutOverflow overflow => run overflowed()
  }
  let recipe = Allocator.allocate(move layout)
  let allocation = run recipe
  return adopt<T>(move allocation, count)
}

fn adopt<T>(allocation: Allocation, count: usize) -> RawBuffer<Member<T>> {
  unsafe {
    return RawBuffer.from<Member<T>>(move allocation, count)
  }
  return absurd<RawBuffer<Member<T>>>()
}

/// Reports whether one more element would take the set past three quarters of its buckets.
fn needsRoom(used: usize, width: usize) -> bool {
  if width == usize.ZERO {
    return true
  }
  let quarter = width / (usize.ONE + usize.ONE + usize.ONE + usize.ONE)
  return width - quarter < used + usize.ONE
}

fn grownWidth(width: usize) -> usize {
  if width == usize.ZERO {
    return INITIAL_WIDTH
  }
  return width + width
}

// Rehomes every occupied element into the replacement table under the hash it was placed with, then
// releases the old buffers. The removed marks do not travel, so growth reclaims them.
fn migrate<T>(
  storage: Unseeded<T> | Slots<T>,
  width: usize,
  fresh: Slots<T>,
  next: usize
) -> Slots<T> {
  return match move storage {
    Unseeded<T> nothing => move fresh
    Slots<T> held => rehome<T>(move held, width, move fresh, next)
  }
}

fn rehome<T>(old: Slots<T>, width: usize, fresh: Slots<T>, next: usize) -> Slots<T> {
  let mut source = move old
  let mut target = move fresh
  unsafe {
    let mut index = usize.ZERO
    while index < width {
      let seen = RawBuffer.view<u8>(&source.states, usize.ZERO, width)
      if seen[index] == OCCUPIED {
        let selected = RawBuffer.slot(&mut source.members, index)
        let carried = Slot.take(move selected)
        let placed = settle<T>(&mut target, move carried, next)
      }
      index = index + usize.ONE
    }
    drop source
  }
  return move target
}

// Places one element at the first slot its own probe run does not already occupy. Every slot of a
// replacement table is vacant, so the run always ends.
fn settle<T>(target: &mut Slots<T>, carried: Member<T>, next: usize) -> () {
  let hashed = memberHash<T>(&carried)
  let mut index = bucketOf(hashed, next)
  let mut searching = true
  while searching {
    let seen = RawBuffer.view<u8>(&target.states, usize.ZERO, next)
    if seen[index] == OCCUPIED {
      index = advance(index, next)
    } else {
      searching = false
    }
  }
  let written = writeMember<T>(move target, index, move carried)
  return ()
}

fn memberHash<T>(member: &Member<T>) -> u64 {
  return member.hash
}

fn writeMember<T>(owned: &mut Slots<T>, index: usize, member: Member<T>) -> () {
  unsafe {
    let selected = RawBuffer.slot(&mut owned.members, index)
    let written = Slot.write<Member<T>>(move selected, move member)
  }
  let mut states = RawBuffer.viewMut<u8>(&mut owned.states, index, usize.ONE)
  states[usize.ZERO] = OCCUPIED
  return ()
}

fn vacantAt<T>(owned: &Slots<T>, index: usize) -> bool {
  let seen = RawBuffer.view<u8>(&owned.states, index, usize.ONE)
  return seen[usize.ZERO] == VACANT
}

fn markRemoved<T>(owned: &mut Slots<T>, index: usize) -> () {
  let mut states = RawBuffer.viewMut<u8>(&mut owned.states, index, usize.ONE)
  states[usize.ZERO] = REMOVED
  return ()
}

fn release<T>(value: T) -> () {
  drop value
  return ()
}

fn keep<T>(member: Member<T>) -> T {
  return match move member {
    Member<T> { hash, value } => move value
  }
}

fn evict<T>(owned: &mut Slots<T>, index: usize) -> T {
  unsafe {
    let selected = RawBuffer.slot(&mut owned.members, index)
    let taken = Slot.take(move selected)
    return keep<T>(move taken)
  }
  return absurd<T>()
}

fn readMember<T: Copy>(self: &HashSet<T>, index: usize) -> Member<T> {
  return match &self.storage {
    Unseeded<T> nothing => absurd<Member<T>>()
    Slots<T> { members, states } => readAt<T>(&members, index)
  }
}

fn readAt<T: Copy>(members: &RawBuffer<Member<T>>, index: usize) -> Member<T> {
  unsafe {
    return RawBuffer.read<Member<T>>(members, index)
  }
  return absurd<Member<T>>()
}
