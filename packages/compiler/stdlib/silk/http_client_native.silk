effect fn securePrepared(
  owned: &mut OwnedPublication,
  origin: &Origin,
  options: &Options,
  route: NativeRoute,
  trust: TrustSnapshot,
) -> ()
! NativeClientError | ConnectionError | IdentityError | OutOfMemoryError
? &mut Allocator | &mut MonotonicClock | &mut SystemClock | &mut Random {
  let host = Origin.host(origin)
  let mut name = emptyDomainName()
  let nameLength = copyDomain(&host, &mut name)
  let nameBytes = Slice.view<u8>(&name, usize.ZERO, nameLength)
  let protocols = [AlpnProtocol {bytes: b"http/1.1"}]
  let transport = run authenticatePrepared(
    &mut owned.*,
    &host,
    nameBytes,
    &protocols,
    move trust,
    options,
    route,
  )
  owned.transport = Option.some<NativeTransport>(move transport)
  return ()
}

effect fn authenticatePrepared<'a>(
  owned: &mut OwnedPublication,
  host: &Host,
  nameBytes: &'a [u8],
  protocols: &'a [AlpnProtocol<'a>],
  trust: TrustSnapshot,
  options: &Options,
  route: NativeRoute,
) -> NativeTransport
! NativeClientError | ConnectionError | IdentityError | OutOfMemoryError
? &mut Allocator | &mut MonotonicClock | &mut SystemClock | &mut Random {
  let reference: ReferenceIdentity<'a> = match move referenceFor(host, nameBytes) {
    Result<ReferenceIdentity<'a>, IdentityError>.Success {value} => value
    Result<ReferenceIdentity<'a>, IdentityError>.Failure {error} => {
      fail move error
    }
  }
  let alpn = selectAlpn(protocols, options.alpn)
  let config = ClientConfig<'a> {reference: reference, alpn: alpn, limits: options.tls}
  let stored = Intrinsic.replace(owned.socket, Option.none<NativeConnection>())
  let provider = match move stored {
    Option.Some {value} => move value
    Option.None => unavailable<NativeConnection>()
  }
  let attempted = run Effect.result(
    Tls.authenticateOwned<NativeConnection>(
      move provider,
      &config,
      move trust,
      ConnectionOptions {
        handshakeTimeoutNanoseconds: options.handshakeNanoseconds,
        externalDeadline: copyDeadline(&options.deadline),
      },
    ),
  )
  let connection = match move attempted {
    Result<OwnedConnection<NativeConnection>, ConnectionError | OutOfMemoryError>.Success {value} => move value
    Result<OwnedConnection<NativeConnection>, ConnectionError | OutOfMemoryError>.Failure {error} => match move error {
      ConnectionError cause => {
        if alpnMismatch(&cause) {
          fail NativeClientError.AlpnMismatch {error: move cause}
        }
        fail move cause
      }
      OutOfMemoryError allocation => {
        fail move allocation
      }
    }
  }
  return NativeTransport {
    state: State.Secured {connection: move connection},
    terminal: false,
    routeValue: route,
  }
}

fn alpnMismatch(error: &ConnectionError) -> bool {
  return match & error.* {
    ConnectionError.Tls {error: tlsError} => match & tlsError {
      TlsError.NoApplicationProtocol => true
      _ => false
    }
    _ => false
  }
}

fn selectAlpn<'a>(protocols: &'a [AlpnProtocol<'a>], policy: AlpnPolicy) -> AlpnConfig<'a> {
  return match policy {
    AlpnPolicy.Http10 => AlpnConfig<'a>.Disabled
    AlpnPolicy.OptionalHttp11 => AlpnConfig<'a>.Offered {protocols: protocols, required: false}
    AlpnPolicy.RequiredHttp11 => AlpnConfig<'a>.Offered {protocols: protocols, required: true}
  }
}

fn copyDomain(host: &Host, output: &mut [u8]) -> usize {
  match & host.* {
    Host.Domain {value} => {
      let bytes = DomainHost.bytes(&value)
      let mut index = usize.ZERO
      while index < bytes.length {
        output[index] = bytes[index]
        index = index + usize.ONE
      }
      return bytes.length
    }
    Host.Ipv4 {value} => {
      return usize.ZERO
    }
    Host.Ipv6 {value} => {
      return usize.ZERO
    }
  }
  return usize.ZERO
}

fn referenceFor<'host>(host: &Host, name: &'host [u8]) -> Result<
  ReferenceIdentity<'host>,
  IdentityError,
> {
  let selected = match & host.* {
    Host.Domain {value} => OriginHost<'host>.Dns {bytes: name}
    Host.Ipv4 {value} => OriginHost<'host>.Ipv4 {bytes: Ipv4Address.octets(&value)}
    Host.Ipv6 {value} => OriginHost<'host>.Ipv6 {bytes: Ipv6Address.octets(&value)}
  }
  return HttpsIdentity.reference(move selected)
}

fn copyDeadline(deadline: &Option<Instant>) -> Option<Instant> {
  return match & deadline.* {
    Option.None => Option.none<Instant>()
    Option.Some {value} => Option.some<Instant>(
      SystemClock.make(SystemClock.seconds(&value), SystemClock.nanoseconds(&value)),
    )
  }
}

fn unavailable<A>() -> A {
  let invalid = 1 / 0
  return unavailable<A>()
}

impl NativeTransport {
  /// Returns owned immutable route metadata while leaving the transport exclusively inside its session.
  pub fn route(self: &Self) -> NativeRoute {
    return self.routeValue
  }
  effect fn read(self: &mut Self, output: &mut [u8], deadline: Option<Instant>) -> ReadTransfer
  ! TransportError | OutOfMemoryError
  ? &mut Allocator | &mut MonotonicClock | &mut Random {
    static if (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText(
      "libc",
    ) == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText(
      "libc",
    ) == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
      if self.terminal {
        fail TransportError.Plain {error: ByteDuplex.closed(ByteIoOperation.Read)}
      }
      return match &mut self.state {
        State.Plain {connection} => {
          let mut adapter = Transport.plain<NativeConnection>(&mut connection)
          return run HttpTransport.readSome(move output, move deadline)
            |> Effect.provideMut<HttpTransport>(&mut adapter)
        }
        State.Secured {connection} => {
          let mut adapter = Transport.secured<NativeConnection>(&mut connection)
          return run HttpTransport.readSome(move output, move deadline)
            |> Effect.provideMut<HttpTransport>(&mut adapter)
        }
      }
    } else {
      compileError("Native HTTP acquisition requires a supported Darwin or GNU libc profile")
    }
  }
  effect fn write(self: &mut Self, input: &[u8], deadline: Option<Instant>) -> usize
  ! TransportError | OutOfMemoryError
  ? &mut Allocator | &mut MonotonicClock | &mut Random {
    static if (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText(
      "libc",
    ) == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText(
      "libc",
    ) == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
      if self.terminal {
        fail TransportError.Plain {error: ByteDuplex.closed(ByteIoOperation.Write)}
      }
      return match &mut self.state {
        State.Plain {connection} => {
          let mut adapter = Transport.plain<NativeConnection>(&mut connection)
          return run HttpTransport.writeSome(move input, move deadline)
            |> Effect.provideMut<HttpTransport>(&mut adapter)
        }
        State.Secured {connection} => {
          let mut adapter = Transport.secured<NativeConnection>(&mut connection)
          return run HttpTransport.writeSome(move input, move deadline)
            |> Effect.provideMut<HttpTransport>(&mut adapter)
        }
      }
    } else {
      compileError("Native HTTP acquisition requires a supported Darwin or GNU libc profile")
    }
  }
  effect fn flushOutput(self: &mut Self, deadline: Option<Instant>) -> ()
  ! TransportError | OutOfMemoryError
  ? &mut Allocator | &mut MonotonicClock | &mut Random {
    static if (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText(
      "libc",
    ) == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText(
      "libc",
    ) == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
      if self.terminal {
        fail TransportError.Plain {error: ByteDuplex.closed(ByteIoOperation.Flush)}
      }
      return match &mut self.state {
        State.Plain {connection} => {
          let mut adapter = Transport.plain<NativeConnection>(&mut connection)
          return run HttpTransport.flush(move deadline)
            |> Effect.provideMut<HttpTransport>(&mut adapter)
        }
        State.Secured {connection} => {
          let mut adapter = Transport.secured<NativeConnection>(&mut connection)
          return run HttpTransport.flush(move deadline)
            |> Effect.provideMut<HttpTransport>(&mut adapter)
        }
      }
    } else {
      compileError("Native HTTP acquisition requires a supported Darwin or GNU libc profile")
    }
  }
  effect fn closeLease(self: &mut Self) -> () ! TransportError {
    static if (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText(
      "libc",
    ) == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText(
      "libc",
    ) == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
      if self.terminal {
        return ()
      }
      self.terminal = true
      return match &mut self.state {
        State.Plain {connection} => {
          let mut adapter = Transport.plain<NativeConnection>(&mut connection)
          return run HttpTransport.close()
            |> Effect.provideMut<HttpTransport>(&mut adapter)
        }
        State.Secured {connection} => {
          let mut adapter = Transport.secured<NativeConnection>(&mut connection)
          return run HttpTransport.close()
            |> Effect.provideMut<HttpTransport>(&mut adapter)
        }
      }
    } else {
      compileError("Native HTTP acquisition requires a supported Darwin or GNU libc profile")
    }
  }
}

impl HttpTransport for NativeTransport {
  readSomeRaw: NativeTransport.read
  writeSomeRaw: NativeTransport.write
  flush: NativeTransport.flushOutput
  close: NativeTransport.closeLease
}

fn preflightDeadline(origin: &Origin, deadline: &Option<Instant>) -> Result<(), NativeClientError> {
  let host = Origin.host(origin)
  match host {
    Host.Domain {value} => {
      if let Option.Some {value: mark} = &deadline.* {
        return Result.failResult<(), NativeClientError>(NativeClientError.UnsupportedDeadline)
      }
    }
    Host.Ipv4 {value} => {}
    Host.Ipv6 {value} => {}
  }
  return Result.succeed<(), NativeClientError>(())
}

/// Checks native TCP support and rejects a hostname deadline before resolver dispatch.
///
/// # Gotchas
///
/// On unsupported targets or no-libc profiles, a reached call produces a compile-time error.
pub fn preflight(origin: &Origin, options: &Options) -> Result<(), NativeClientError> {
  static if (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText(
    "libc",
  ) == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText(
    "libc",
  ) == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
    return preflightDeadline(origin, &options.deadline)
  } else {
    compileError("Native HTTP acquisition requires a supported Darwin or GNU libc profile")
  }
}

/// Returns the exact route-selected native peer after target and deadline preflight.
///
/// # Details
///
/// Direct returns the original origin; Forward and Tunnel return the sealed plain proxy origin.
/// A finite deadline with either selected domain fails before synchronous resolver dispatch.
///
/// # Gotchas
///
/// On unsupported targets or no-libc profiles, a reached call produces a compile-time error.
pub fn preflightProxyRoute<'configuration>(route: &Route<'configuration>, options: &Options) -> Result<
  Origin,
  ProxyError | NativeClientError,
> {
  static if (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText(
    "libc",
  ) == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText(
    "libc",
  ) == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
    let peer = match move proxyPeer(route) {
      Result<Origin, ProxyError>.Success {value} => value
      Result<Origin, ProxyError>.Failure {error} => {
        return Result.failResult<Origin, ProxyError | NativeClientError>(move error)
      }
    }
    return match move preflight(&peer, options) {
      Result<(), NativeClientError>.Success {value} => {
        return Result.succeed<Origin, ProxyError | NativeClientError>(peer)
      }
      Result<(), NativeClientError>.Failure {error} => {
        return Result.failResult<Origin, ProxyError | NativeClientError>(move error)
      }
    }
  } else {
    compileError("Native HTTP acquisition requires a supported Darwin or GNU libc profile")
  }
}

/// Rebuildable native route acquisition for bounded redirect operations.
///
/// # Details
///
/// The initial sealed route retains the immutable proxy configuration. On supported native
/// targets, every attempt recomputes policy for its current URI, completes method, target, header,
/// and native-route preflight before destination contact, and replaces the stored option deadline
/// with the operation's unchanged absolute deadline. Secure attempts load a fresh trust snapshot
/// before acquisition; tunneled TLS continues to authenticate the original origin through
/// [`withProxyRoute`]. On unsupported targets or no-libc profiles, reached acquisition produces a
/// compile-time error.
pub struct NativeRedirectClient<'configuration, 'policy, A, HandlerError, ?HandlerRequirements> {
  routeValue: Route<'configuration>
  optionsValue: Options
  limitsValue: Limits
}

impl<'configuration, 'policy, A, HandlerError, ?HandlerRequirements> NativeRedirectClient<
  'configuration,
  'policy,
  A,
  HandlerError,
  HandlerRequirements,
> {
  /// Creates a reusable redirect attempt client from one policy-selected route.
  ///
  /// # Gotchas
  ///
  /// Construction on unsupported targets or no-libc profiles produces a compile-time error.
  pub fn make(route: Route<'configuration>, options: Options, limits: Limits) -> NativeRedirectClient<
    'configuration,
    'policy,
    A,
    HandlerError,
    HandlerRequirements,
  > {
    static if (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText(
      "libc",
    ) == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText(
      "libc",
    ) == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
      return NativeRedirectClient<'configuration, 'policy, A, HandlerError, HandlerRequirements> {
        routeValue: route,
        optionsValue: move options,
        limitsValue: limits,
      }
    } else {
      compileError("Native HTTP acquisition requires a supported Darwin or GNU libc profile")
    }
  }
}

fn copyRedirectInstant(value: &Instant) -> Instant {
  return SystemClock.make(SystemClock.seconds(value), SystemClock.nanoseconds(value))
}

fn copyRedirectDeadline(value: &Option<Instant>) -> Option<Instant> {
  return match & value.* {
    Option.None => Option.none<Instant>()
    Option.Some {value: present} => Option.some<Instant>(copyRedirectInstant(&present))
  }
}

fn copyRedirectContinuePolicy(value: &ContinuePolicy) -> ContinuePolicy {
  return match & value.* {
    ContinuePolicy.Disabled => ContinuePolicy.Disabled
    ContinuePolicy.Require100 {deadline} => ContinuePolicy.Require100 {
      deadline: copyRedirectInstant(&deadline),
    }
  }
}

fn redirectRequiresContinue(value: &ContinuePolicy) -> bool {
  return match & value.* {
    ContinuePolicy.Disabled => false
    ContinuePolicy.Require100 {deadline} => true
  }
}

fn redirectOptions(options: &Options, deadline: &Option<Instant>) -> Options {
  return Options {
    maximumAddresses: options.maximumAddresses,
    family: options.family,
    noDelay: options.noDelay,
    pollIntervalNanoseconds: options.pollIntervalNanoseconds,
    maximumAttempts: options.maximumAttempts,
    deadline: copyRedirectDeadline(deadline),
    handshakeNanoseconds: options.handshakeNanoseconds,
    tls: options.tls,
    trust: options.trust,
    alpn: options.alpn,
  }
}

struct NativeRedirectRouteHandler<
  'configuration,
  'request,
  'policy,
  A,
  HandlerError,
  ?HandlerRequirements,
> {
  routeWitness: Route<'configuration>
  request: &'request AttemptRequest<'policy>
  method: Method<'request>
  prepared: PreparedRequest
  options: RequestOptions
}

impl<'configuration, 'request, 'policy, A, HandlerError, ?HandlerRequirements> NativeRedirectRouteHandler<
  'configuration,
  'request,
  'policy,
  A,
  HandlerError,
  HandlerRequirements,
> {
  effect<'call> fn handle<'call, 'transport: 'call, 'provider: 'transport, 'tunnel: 'provider>(
    bridge: Self,
    route: Route<'configuration>,
    connection: &'call mut Connection<
      RouteTransport<'transport, 'provider, 'tunnel, NativeRouteProvider>,
    >,
  ) -> A
  ! HandlerError | ClientError | OutOfMemoryError
  ? HandlerRequirements | &mut Attempt<'policy, NativeRouteProvider, A, HandlerError ? HandlerRequirements> | &mut Allocator {
    let NativeRedirectRouteHandler<
      'configuration,
      'request,
      'policy,
      A,
      HandlerError,
      HandlerRequirements,
    > {routeWitness, request, method, prepared, options} = move bridge
    drop routeWitness
    drop route
    let use = effect fn(
      exchange: &mut Exchange<RouteTransport<'transport, 'provider, 'tunnel, NativeRouteProvider>>,
    ) -> A
    ! HandlerError
    ? HandlerRequirements | &mut Attempt<'policy, NativeRouteProvider, A, HandlerError ? HandlerRequirements> {
      return run Attempt.handle<'policy, NativeRouteProvider, A, HandlerError, HandlerRequirements>(
        request,
        method,
        move exchange,
      )
    }
    return run withExchange(move connection, &prepared, move options, move use)
  }
}

impl<'configuration, 'request, 'policy, A, HandlerError, ?HandlerRequirements> RouteHandler<'configuration, NativeRouteProvider, A, HandlerError | ClientError | OutOfMemoryError ? HandlerRequirements | &mut Attempt<'policy, NativeRouteProvider, A, HandlerError ? HandlerRequirements> | &mut Allocator> for NativeRedirectRouteHandler<
  'configuration,
  'request,
  'policy,
  A,
  HandlerError,
  HandlerRequirements,
> {
  handle: NativeRedirectRouteHandler.handle
}

impl<'configuration, 'policy, A, HandlerError, ?HandlerRequirements> NativeRedirectClient<
  'configuration,
  'policy,
  A,
  HandlerError,
  HandlerRequirements,
> {
  effect fn withAttempt(
    client: &mut Self,
    request: AttemptRequest<'policy>,
    deadline: Option<Instant>,
  ) -> A
  ! HandlerError | ProxyError | RequestError | ValueError | OriginError | ClientError | NativeClientError | ResolverError | NativeSocketError | ConnectionError | IdentityError | TrustSourceError | OutOfMemoryError
  ? HandlerRequirements | &mut Attempt<'policy, NativeRouteProvider, A, HandlerError ? HandlerRequirements> | &mut Allocator | &mut MonotonicClock | &mut SystemClock | &mut Random | &mut TrustSource
  where
    HandlerRequirements in Without<HandlerRequirements, ByteDuplex>,
    HandlerRequirements in Without<HandlerRequirements, HttpTransport> {
    let uri = request.uri.view()
    let origin = match move Origin.fromUri(&uri) {
      Result.Failure {error} => {
        fail move error
      }
      Result.Success {value} => value
    }
    let secure = Origin.secure(&origin)
    let route = Route.recompute(&client.routeValue, origin)
    let options = redirectOptions(&client.optionsValue, &deadline)
    match move preflightProxyRoute(&route, &options) {
      Result.Failure {error} => {
        fail move error
      }
      Result.Success {value} => {
        drop value
      }
    }
    let method = match move Method.parse(
      String.view(&request.method),
      request.requestLimits.maxMethodBytes,
    ) {
      Result.Failure {error} => {
        fail move error
      }
      Result.Success {value} => value
    }
    let headers = request.headers.view()
    let require100 = redirectRequiresContinue(&request.continuePolicy)
    let prepared = match Route.mode(&route) {
      RouteMode.Forward => run Request.prepareForward(
        &route,
        &uri,
        request.version,
        method,
        &headers,
        &request.headerPolicy,
        request.bodyMode,
        require100,
        request.requestLimits,
        request.maxHeadBytes,
        request.maxCredentialBytes,
      )
      RouteMode.Direct => run Request.fromUri(
        &uri,
        request.version,
        method,
        &headers,
        &request.headerPolicy,
        request.bodyMode,
        require100,
        request.requestLimits,
        request.maxHeadBytes,
        request.maxCredentialBytes,
      )
      RouteMode.Tunnel => run Request.fromUri(
        &uri,
        request.version,
        method,
        &headers,
        &request.headerPolicy,
        request.bodyMode,
        require100,
        request.requestLimits,
        request.maxHeadBytes,
        request.maxCredentialBytes,
      )
    }
    let mut trust = Option.none<TrustSnapshot>()
    if secure {
      trust = Option.some<TrustSnapshot>(run TrustSource.load(options.trust))
    }
    let requestOptions = RequestOptions {
      deadline: copyRedirectDeadline(&deadline),
      continuePolicy: copyRedirectContinuePolicy(&request.continuePolicy),
    }
    let bridge = NativeRedirectRouteHandler<A, HandlerError, HandlerRequirements> {
      routeWitness: route,
      request: &request,
      method: method,
      prepared: move prepared,
      options: move requestOptions,
    }
    return run withProxyRoute<
      'configuration,
      A,
      HandlerError | ClientError | OutOfMemoryError,
      HandlerRequirements | &mut Attempt<
        'policy,
        NativeRouteProvider,
        A,
        HandlerError,
        HandlerRequirements,
      > | &mut Allocator,
    >(route, move options, client.limitsValue, move trust, move bridge)
  }
}

impl<'configuration, 'policy, A, HandlerError, ?HandlerRequirements> AttemptClient<
  'policy,
  NativeRouteProvider,
  A,
  HandlerError,
  ProxyError | RequestError | ValueError | OriginError | ClientError | NativeClientError | ResolverError | NativeSocketError | ConnectionError | IdentityError | TrustSourceError | OutOfMemoryError,
  &mut Allocator | &mut MonotonicClock | &mut SystemClock | &mut Random | &mut TrustSource,
  HandlerRequirements,
> for NativeRedirectClient<'configuration, 'policy, A, HandlerError, HandlerRequirements> {
  withAttempt: NativeRedirectClient.withAttempt
}

/// Returns immutable native route metadata from an owned HTTP session without lending its transport mutably.
pub fn route(connection: &Connection<NativeTransport>) -> NativeRoute {
  let context = connection.transportContext()
  return NativeTransport.route(&context.transport.*)
}
