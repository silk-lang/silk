//! Portable normalized paths, whole-file operations, directory traversal, and explicit temp scopes.
//!
//! # When to use
//! Build provider-absolute [`Path`] values with [`make`] or [`fromBytes`], then run operations
//! through a supplied [`FileSystem`]. Use [`rawBytes`] for platform values that must round-trip even
//! when they are not UTF-8, and [`resolve`] for lexical relative-path resolution.
//!
//! # Details
//! Paths are absolute and normalized: they reject NUL, empty components, trailing separators, and
//! embedded `.` or `..`. Resolution handles relative dot components but rejects escape above root.
//! Directory listings return independently owned child paths in deterministic path-byte order.
//! Portable [`FileError`] data names both the operation and a closed recovery reason, with an
//! optional provider code for diagnostics.
//!
//! Temporary directories have an explicit lifecycle because removal can fail and needs services.
//! Use [`release`] when cleanup failure matters, or [`releaseIgnored`] as an infallible finalizer
//! only after deliberately accepting that loss.
//!
//! # Gotchas
//! A path created from arbitrary bytes may not have a valid text view. Keep using [`rawBytes`] unless
//! the bytes were validated as UTF-8; [`view`] and [`name`] rely on that caller knowledge.
//!
//! # Examples
//! ## Construct and inspect a portable path
//! ```silk
//! import silk.allocator { Allocator, OutOfMemoryError }
//!
//! import silk.effect { Effect }
//!
//! import silk.filesystem { FileSystem, FileError, Path }
//!
//! import silk.option { Option }
//!
//! effect fn example() -> i32
//! ! FileError | OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let path = run Path.make("/workspace")
//!     |> Effect.provideMut(&mut allocator)
//!   if let Option<string>.Some {value: name} = move Path.name(&path) {
//!     if name == "workspace" { return 42 }
//!   }
//!   return 0
//! }
//!
//! effect fn recover(error: FileError | OutOfMemoryError) -> i32 {
//!   return 0
//! }
//!
//! pub fn main() -> i32 {
//!   return run Effect.catchAll(example(), recover)
//! }
//! ```

import silk.bool
import silk.bytes { Bytes }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.allocator { OutOfMemoryError }
import silk.effect { Effect }
import silk.i32
import silk.option { Option }
import silk.result { Result }
import silk.string { InvalidUtf8, String }
import silk.u8
import silk.usize
import silk.vector { Vector }

/// An owned, normalized absolute path in a [`FileSystem`] provider's portable namespace.
///
/// # Details
///
/// Portable `/` means the selected provider's root, not necessarily the host operating system's
/// root. Construct paths through [`make`], [`fromBytes`], [`root`], [`join`], or [`resolve`]; the
/// representation is private so every `Path` satisfies the normalization rules.
pub struct Path {
  bytes: Bytes
  nameBytes: Bytes
}

impl Path {
  /// Copies UTF-8 text into an owned, normalized provider-absolute [`Path`].
  ///
  /// # Details
  ///
  /// The text must begin with `/`. Root is valid; every other path must have nonempty components and
  /// no trailing slash, NUL, `.` component, or `..` component. Invalid input fails with
  /// `FileError(FileSystem.pathOperation(), FileSystem.invalidPath())`; copying can fail with [`OutOfMemoryError`].
  pub effect fn make(value: string) -> Path ! FileError | OutOfMemoryError ? &mut Allocator {
    let values = String.utf8Bytes(value)
    if validAbsolute(values) == false { return run rejectPath() }
    let copied = run appendRange(Bytes.make(), values, usize.ZERO, values.length)
    return run finishPath(move copied)
  }

  /// Constructs an owned normalized provider-absolute Path from exact platform bytes.
  ///
  /// # Details
  ///
  /// Platform paths are byte sequences, and a caller that received one from the platform — a
  /// directory entry, an argument, an environment value — must be able to hand it back unchanged.
  /// The same normalization applies as for textual construction: the value is absolute, rejects NUL,
  /// and rejects `.`, `..`, empty components, and trailing separators. Well-formed text is not
  /// required, so a Path built this way may have no `string` view.
  pub effect fn fromBytes(values: &[u8]) -> Path ! FileError | OutOfMemoryError ? &mut Allocator {
    if validAbsolute(values) == false { return run rejectPath() }
    let copied = run appendRange(Bytes.make(), values, usize.ZERO, values.length)
    return run finishPath(move copied)
  }

  /// Allocates the portable root path `/` in the selected allocator.
  pub effect fn root() -> Path ! OutOfMemoryError ? &mut Allocator {
    let mut copied = Bytes.make()
    let appended = run Bytes.append(&mut copied, String.utf8Bytes("/"))
    return run finishPath(move copied)
  }

  /// Borrows the complete normalized path as exact platform bytes.
  ///
  /// # Details
  ///
  /// This is the lossless view. It round-trips a Path built from platform bytes even when those
  /// bytes are not well-formed text, which the `string` view cannot promise.
  pub fn rawBytes(self: &Self) -> &[u8] {
    return pathBytes(self)
  }

  /// Borrows the complete path as text, or answers `None` when its bytes are not valid UTF-8.
  ///
  /// # Details
  ///
  /// Paths from [`make`], [`join`], [`joinUtf8`], and [`resolve`] are always valid UTF-8. A path
  /// created with [`fromBytes`] or [`joinBytes`] may not be; [`rawBytes`] is the lossless view.
  pub fn view(self: &Self) -> Option<string> {
    return utf8View(pathBytes(self))
  }

  /// Returns `true` exactly when this path is the portable root `/`.
  pub fn isRoot(self: &Self) -> bool { return Bytes.asSlice(&self.bytes).length == usize.ONE }

  /// Borrows the final component as text, or answers `None` when its bytes are not valid UTF-8.
  ///
  /// # Details
  ///
  /// Root answers empty text. The component never includes a separator, and borrowing it does not
  /// allocate.
  pub fn name(self: &Self) -> Option<string> {
    return utf8View(Bytes.asSlice(&self.nameBytes))
  }

  /// Appends one normalized relative text fragment to an absolute base path.
  ///
  /// # Details
  ///
  /// `fragment` must be nonempty and relative, with no NUL, empty, `.`, or `..` component and no
  /// trailing slash. Use [`resolve`] when dot components should be interpreted instead of rejected.
  pub effect fn join(
    base: &Path,
    fragment: string
  ) -> Path ! FileError | OutOfMemoryError ? &mut Allocator {
    return run Path.joinBytes(base, String.utf8Bytes(fragment))
  }

  /// Validates UTF-8 bytes as one normalized relative fragment and appends them to `base`.
  ///
  /// # Details
  ///
  /// This is useful for a child name returned as bytes by another portable API. Invalid UTF-8 and the
  /// same malformed components rejected by [`join`] fail with the `InvalidPath` reason.
  pub effect fn joinUtf8(
    base: &Path,
    fragment: &[u8]
  ) -> Path ! FileError | OutOfMemoryError ? &mut Allocator {
    if validUtf8(fragment) == false { return run rejectPath() }
    return run Path.joinBytes(base, fragment)
  }

  /// Appends one normalized relative byte fragment while preserving non-UTF-8 names.
  ///
  /// # Details
  ///
  /// The fragment must be nonempty and contain no NUL, empty, dot or dot-dot component.
  /// This is the byte-preserving operation for native directory names; use [`joinUtf8`]
  /// when the caller also requires valid UTF-8.
  pub effect fn joinBytes(
    base: &Path,
    fragment: &[u8]
  ) -> Path ! FileError | OutOfMemoryError ? &mut Allocator {
    if validRelativeFragment(fragment) == false { return run rejectPath() }
    let baseBytes = pathBytes(base)
    let mut combined = run appendRange(Bytes.make(), baseBytes, usize.ZERO, baseBytes.length)
    if Path.isRoot(base) == false {
      let slash = run Bytes.append(&mut combined, String.utf8Bytes("/"))
    }
    let beforeChild = Intrinsic.replace(combined, Bytes.make())
    combined = run appendRange(move beforeChild, fragment, usize.ZERO, fragment.length)
    return run finishPath(move combined)
  }

  /// Resolves relative text lexically against an explicit absolute base.
  ///
  /// # Details
  ///
  /// Empty text and `.` keep the base; `..` removes components; ordinary components append. An
  /// absolute relative value, an empty interior component, NUL, or any attempt to escape above root
  /// fails with the `InvalidPath` reason. Resolution is lexical and never accesses the filesystem.
  pub effect fn resolve(
    base: &Path,
    relativeText: string
  ) -> Path ! FileError | OutOfMemoryError ? &mut Allocator {
    let relative = String.utf8Bytes(relativeText)
    if containsNul(relative) { return run rejectPath() }
    if usize.ZERO < relative.length {
      if byte(relative[usize.ZERO]) == 47 { return run rejectPath() }
    }
    let baseBytes = pathBytes(base)
    let mut keptBase = componentCount(baseBytes)
    let mut relativeDepth = usize.ZERO
    let mut start = usize.ZERO
    let mut index = usize.ZERO
    while index <= relative.length {
      let mut boundary = false
      if index == relative.length {
        boundary = true
      } else {
        if byte(relative[index]) == 47 { boundary = true }
      }
      if boundary {
        if start == index {
          if index != relative.length { return run rejectPath() }
        } else {
          if isDotDot(relative, start, index) {
            if usize.ZERO < relativeDepth {
              relativeDepth = relativeDepth - usize.ONE
            } else {
              if keptBase == usize.ZERO { return run rejectPath() }
              keptBase = keptBase - usize.ONE
            }
          } else {
            if isDot(relative, start, index) == false {
              relativeDepth = relativeDepth + usize.ONE
            }
          }
        }
        start = index + usize.ONE
      }
      index = index + usize.ONE
    }

    let mut combined = Bytes.make()
    let rooted = run Bytes.append(&mut combined, String.utf8Bytes("/"))
    let mut included = usize.ZERO
    start = usize.ONE
    index = usize.ONE
    while index <= baseBytes.length {
      let mut boundary = false
      if index == baseBytes.length {
        boundary = true
      } else {
        if byte(baseBytes[index]) == 47 { boundary = true }
      }
      if boundary {
        if included < keptBase {
          if usize.ZERO < included {
            let slash = run Bytes.append(&mut combined, String.utf8Bytes("/"))
          }
          let beforeBaseComponent = Intrinsic.replace(combined, Bytes.make())
          combined = run appendRange(move beforeBaseComponent, baseBytes, start, index)
          included = included + usize.ONE
        }
        start = index + usize.ONE
      }
      index = index + usize.ONE
    }

    start = usize.ZERO
    index = usize.ZERO
    while index <= relative.length {
      let mut boundary = false
      if index == relative.length {
        boundary = true
      } else {
        if byte(relative[index]) == 47 { boundary = true }
      }
      if boundary {
        if start < index {
          if isDot(relative, start, index) == false {
            if isDotDot(relative, start, index) == false {
              if survivingRelative(relative, index + usize.ONE) {
                if usize.ZERO < included {
                  let slash = run Bytes.append(&mut combined, String.utf8Bytes("/"))
                }
                let beforeRelativeComponent = Intrinsic.replace(combined, Bytes.make())
                combined = run appendRange(move beforeRelativeComponent, relative, start, index)
                included = included + usize.ONE
              }
            }
          }
        }
        start = index + usize.ONE
      }
      index = index + usize.ONE
    }
    return run finishPath(move combined)
  }

  /// Allocates an independently owned parent path, or [`None`] when `self` is root.
  ///
  /// # Details
  ///
  /// The result does not borrow `self`. A direct child of root has root as its parent.
  pub effect fn parent(
    self: &Self
  ) -> Option<Path> ! OutOfMemoryError ? &mut Allocator {
    if Path.isRoot(self) { return Option<Path>.none() }
    let values = pathBytes(self)
    let nameStart = finalNameStart(values)
    let mut end = usize.ONE
    if nameStart != usize.ONE { end = nameStart - usize.ONE }
    let copied = run appendRange(Bytes.make(), values, usize.ZERO, end)
    let owned = run finishPath(move copied)
    return Option<Path>.some(move owned)
  }
}

/// Minimal portable metadata for one regular file.
pub struct FileInfo {
  /// Complete file length in bytes.
  pub byteLength: usize
}

/// Portable metadata identifying a directory; no platform-specific fields are exposed.
pub struct DirectoryInfo {}

/// The closed portable kind of one directory entry.
pub struct DirectoryEntryKind {
  /// Stable portable kind code selected by [`file`] or [`directory`].
  pub code: i32
}

/// One immediate directory child with an independently owned complete [`Path`].
pub struct DirectoryEntry {
  /// Independently owned complete path to the child.
  pub path: Path
  /// Portable kind reported for the child.
  pub kind: DirectoryEntryKind
}

/// The stable portable operation category stored in a [`FileError`].
pub struct FileOperation {
  /// Stable code identifying the attempted portable operation.
  pub code: i32
}

/// A stable portable recovery category stored in a [`FileError`].
pub struct FileReason {
  /// Stable code identifying the portable recovery reason.
  pub code: i32
}

/// An allocation-free portable failure naming the attempted operation and recovery reason.
///
/// # Details
///
/// Match or compare [`operationCode`] and [`reasonCode`] for portable recovery. [`providerCode`]
/// may retain an OS or provider-specific numeric detail for diagnostics, but portable decisions
/// must not depend on it.
pub struct FileError {
  /// The operation that failed.
  pub operation: FileOperation
  /// The portable reason callers can recover by.
  pub reason: FileReason
  providerCodeValue: i32
  hasProviderCode: bool
}

/// Reads the stable directory-entry kind code through a borrow.
fn borrowedKindCode(kind: &DirectoryEntryKind) -> i32 { return kind.code }

effect fn raise(error: FileError) -> never ! FileError { fail move error }

effect fn rejectPath() -> never ! FileError {
  fail FileSystem.error(FileSystem.pathOperation(), FileSystem.invalidPath())
}

fn byte(value: u8) -> i32 { return u8.toI32(value) }

fn containsNul(values: &[u8]) -> bool {
  let mut index = usize.ZERO
  while index < values.length {
    if values[index] == u8.toU8(0) { return true }
    index = index + usize.ONE
  }
  return false
}

// Borrows bytes as text when they are valid UTF-8.
fn utf8View(values: &[u8]) -> Option<string> {
  return match move String.fromUtf8(values) {
    Result<string, InvalidUtf8>.Success { value: text } => Option<string>.some(text)
    Result<string, InvalidUtf8>.Failure { error: invalid } => Option<string>.none()
  }
}

fn validUtf8(values: &[u8]) -> bool {
  let decoded = String.fromUtf8(values)
  return match move decoded {
    Result<string, InvalidUtf8>.Success { value: text } => true
    Result<string, InvalidUtf8>.Failure { error: invalid } => false
  }
}

fn isDot(values: &[u8], start: usize, end: usize) -> bool {
  if end - start != usize.ONE { return false }
  return byte(values[start]) == 46
}

fn isDotDot(values: &[u8], start: usize, end: usize) -> bool {
  if end - start != 2 { return false }
  if byte(values[start]) != 46 { return false }
  return byte(values[start + usize.ONE]) == 46
}

fn validAbsolute(values: &[u8]) -> bool {
  if values.length == usize.ZERO { return false }
  if byte(values[usize.ZERO]) != 47 { return false }
  if containsNul(values) { return false }
  if values.length == usize.ONE { return true }
  let mut start = usize.ONE
  let mut index = usize.ONE
  while index <= values.length {
    if index == values.length {
      if start == index { return false }
      if isDot(values, start, index) { return false }
      if isDotDot(values, start, index) { return false }
      return true
    }
    if byte(values[index]) == 47 {
      if start == index { return false }
      if isDot(values, start, index) { return false }
      if isDotDot(values, start, index) { return false }
      start = index + usize.ONE
    }
    index = index + usize.ONE
  }
  return false
}

fn validRelativeFragment(values: &[u8]) -> bool {
  if values.length == usize.ZERO { return false }
  if byte(values[usize.ZERO]) == 47 { return false }
  if containsNul(values) { return false }
  let mut start = usize.ZERO
  let mut index = usize.ZERO
  while index <= values.length {
    if index == values.length {
      if start == index { return false }
      if isDot(values, start, index) { return false }
      if isDotDot(values, start, index) { return false }
      return true
    }
    if byte(values[index]) == 47 {
      if start == index { return false }
      if isDot(values, start, index) { return false }
      if isDotDot(values, start, index) { return false }
      start = index + usize.ONE
    }
    index = index + usize.ONE
  }
  return false
}

effect fn appendRange(
  target: Bytes,
  source: &[u8],
  start: usize,
  end: usize
) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut result = move target
  let mut index = start
  while index < end {
    let one = [source[index]]
    let appended = run Bytes.append(&mut result, &one)
    index = index + usize.ONE
  }
  return move result
}

fn finalNameStart(values: &[u8]) -> usize {
  if values.length == usize.ONE { return usize.ONE }
  let mut index = values.length
  while usize.ZERO < index {
    index = index - usize.ONE
    if byte(values[index]) == 47 { return index + usize.ONE }
  }
  return usize.ZERO
}

effect fn finishPath(bytes: Bytes) -> Path ! OutOfMemoryError ? &mut Allocator {
  let view = Bytes.asSlice(&bytes)
  let start = finalNameStart(view)
  let nameBytes = run appendRange(Bytes.make(), view, start, view.length)
  return Path { bytes: move bytes, nameBytes: move nameBytes }
}

fn pathBytes(self: &Path) -> &[u8] { return Bytes.asSlice(&self.bytes) }

fn componentCount(values: &[u8]) -> usize {
  if values.length == usize.ONE { return usize.ZERO }
  let mut count = usize.ONE
  let mut index = usize.ONE
  while index < values.length {
    if byte(values[index]) == 47 { count = count + usize.ONE }
    index = index + usize.ONE
  }
  return count
}

fn survivingRelative(values: &[u8], after: usize) -> bool {
  let mut depth = usize.ONE
  let mut start = after
  let mut index = after
  while index <= values.length {
    let mut boundary = false
    if index == values.length {
      boundary = true
    } else {
      if byte(values[index]) == 47 { boundary = true }
    }
    if boundary {
      if start < index {
        if isDotDot(values, start, index) {
          depth = depth - usize.ONE
          if depth == usize.ZERO { return false }
        } else {
          if isDot(values, start, index) == false { depth = depth + usize.ONE }
        }
      }
      start = index + usize.ONE
    }
    index = index + usize.ONE
  }
  return true
}

/// Portable mutable service for normalized paths and whole-file operations.
///
/// # Details
///
/// Application code supplies one provider lexically with `Effect.provideMut`; tests can implement
/// this service in memory, while native applications can use `silk.os_filesystem`. The service owns
/// platform policy, but every implementation must preserve the portable error categories,
/// create-or-truncate writes, and deterministic listing order described here.
///
/// [`writeFileWithParents`] composes parent creation and the final write using the same lexical
/// provider. Supply both `&mut FileSystem` and `&mut Allocator` for this operation. Its directory
/// creation is not transactional: a failed final write may leave newly created parents behind.
pub service FileSystem {
  /// Reads one complete regular file into independently owned bytes.
  ///
  /// # Details
  ///
  /// Reading a directory fails with `WrongType`. Allocation of the returned [`Bytes`] may fail
  /// independently of the provider read.
  effect fn readFile(
    path: &Path
  ) -> Bytes ! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator
  /// Writes one complete byte view with create-or-truncate semantics.
  ///
  /// # Details
  ///
  /// A missing file is created; an existing regular file is replaced by exactly `bytes`. The call
  /// does not create missing parent directories—use [`writeFileWithParents`] for that workflow.
  effect fn writeFile(path: &Path, bytes: &[u8]) -> () ! FileError ? &mut FileSystem
  /// Returns [`FileInfo`] or [`DirectoryInfo`] for the path without opening file contents.
  ///
  /// # Details
  ///
  /// Missing paths fail with `NotFound`; providers use `WrongType` only when an operation requires a
  /// particular kind, not for this discriminating query.
  effect fn stat(path: &Path) -> FileInfo | DirectoryInfo ! FileError ? &mut FileSystem
  /// Returns immediate owned children in deterministic complete-path byte order.
  ///
  /// # Details
  ///
  /// The result is not recursive. Each `DirectoryEntry.path` is independently owned and may be
  /// retained after the listing vector is released.
  effect fn listDirectory(
    path: &Path
  ) -> Vector<DirectoryEntry> ! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator
  /// Creates exactly one missing directory whose parent already exists.
  ///
  /// # Details
  ///
  /// Existing paths fail with `AlreadyExists`; use [`createDirectoriesRecursively`] to ensure every
  /// missing component.
  effect fn createDirectory(path: &Path) -> () ! FileError ? &mut FileSystem
  /// Removes exactly one regular file and fails with `WrongType` for a directory.
  effect fn removeFile(path: &Path) -> () ! FileError ? &mut FileSystem
  /// Atomically moves one regular file to `to`, replacing a regular file already there.
  ///
  /// # Details
  ///
  /// Observers see either the previous `to` or the complete moved file, never a partial one, so a
  /// writer can publish a file by writing a temporary sibling and renaming it into place. `from`
  /// must name a regular file (`WrongType` otherwise); `to` replaces only a regular file. Both
  /// paths must lie on the same provider volume; a provider that cannot move between them fails
  /// with its reason rather than copying.
  effect fn rename(from: &Path, to: &Path) -> () ! FileError ? &mut FileSystem
  /// Removes exactly one empty directory.
  ///
  /// # Details
  ///
  /// A nonempty directory fails with `NotEmpty`; use [`removeDirectoryRecursively`] only when all
  /// descendants are intentionally in scope for removal.
  effect fn removeDirectory(path: &Path) -> () ! FileError ? &mut FileSystem
  /// Creates one directory under an existing parent under a name no other caller holds.
  ///
  /// # Details
  ///
  /// The provider chooses the name's unique part and returns the complete Path, because only the
  /// provider can create and claim a name in one step. A caller that supplied the name would have
  /// to check-then-create, and the gap between those two is exactly the race this avoids.
  /// `prefix` is a byte prefix for the provider-chosen child name, not a complete path. The returned
  /// directory already exists and is an immediate child of `parent`.
  effect fn createTemporaryDirectory(
    parent: &Path,
    prefix: &[u8]
  ) -> Path ! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator
}

impl FileSystem {
  /// Constructs the regular-file [`DirectoryEntryKind`].
  pub fn file() -> DirectoryEntryKind { return DirectoryEntryKind { code: 0 } }

  /// Constructs the directory [`DirectoryEntryKind`].
  pub fn directory() -> DirectoryEntryKind { return DirectoryEntryKind { code: 1 } }

  /// Returns the stable code for a consumed [`DirectoryEntryKind`]: `0` for file, `1` for directory.
  pub fn entryKindCode(kind: DirectoryEntryKind) -> i32 { return kind.code }

  /// Constructs regular-file metadata with the complete length in bytes.
  pub fn fileInfo(byteLength: usize) -> FileInfo {
    return FileInfo { byteLength: byteLength }
  }

  /// Constructs the fieldless portable directory metadata value.
  pub fn directoryInfo() -> DirectoryInfo { return DirectoryInfo {} }

  /// Constructs a directory entry by taking ownership of its complete child `path` and `kind`.
  pub fn directoryEntry(path: Path, kind: DirectoryEntryKind) -> DirectoryEntry {
    return DirectoryEntry { path: move path, kind: move kind }
  }

  /// Selects the read-file operation.
  pub fn readFileOperation() -> FileOperation { return FileOperation { code: 0 } }

  /// Selects the write-file operation.
  pub fn writeFileOperation() -> FileOperation { return FileOperation { code: 1 } }

  /// Selects the stat operation.
  pub fn statOperation() -> FileOperation { return FileOperation { code: 2 } }

  /// Selects the list-directory operation.
  pub fn listDirectoryOperation() -> FileOperation { return FileOperation { code: 3 } }

  /// Selects the create-directory operation.
  pub fn createDirectoryOperation() -> FileOperation { return FileOperation { code: 4 } }

  /// Selects the remove-file operation.
  pub fn removeFileOperation() -> FileOperation { return FileOperation { code: 5 } }

  /// Selects the remove-directory operation.
  pub fn removeDirectoryOperation() -> FileOperation { return FileOperation { code: 6 } }

  /// Selects path construction and resolution.
  pub fn pathOperation() -> FileOperation { return FileOperation { code: 7 } }

  /// Selects the create-temporary-directory operation.
  pub fn createTemporaryDirectoryOperation() -> FileOperation { return FileOperation { code: 8 } }

  /// Selects the rename operation.
  pub fn renameOperation() -> FileOperation { return FileOperation { code: 9 } }

  /// Returns the stable numeric code of a consumed [`FileOperation`].
  pub fn operationCode(operation: FileOperation) -> i32 { return operation.code }

  /// Constructs the `NotFound` recovery reason.
  pub fn notFound() -> FileReason { return FileReason { code: 0 } }

  /// Constructs the `AlreadyExists` recovery reason.
  pub fn alreadyExists() -> FileReason { return FileReason { code: 1 } }

  /// Constructs the `PermissionDenied` recovery reason.
  pub fn permissionDenied() -> FileReason { return FileReason { code: 2 } }

  /// Constructs the `InvalidPath` recovery reason.
  pub fn invalidPath() -> FileReason { return FileReason { code: 3 } }

  /// Constructs the `WrongType` recovery reason.
  pub fn wrongType() -> FileReason { return FileReason { code: 4 } }

  /// Constructs the `NotEmpty` recovery reason.
  pub fn notEmpty() -> FileReason { return FileReason { code: 5 } }

  /// Constructs the `NoSpace` recovery reason.
  pub fn noSpace() -> FileReason { return FileReason { code: 6 } }

  /// Constructs the `TooLarge` recovery reason.
  pub fn tooLarge() -> FileReason { return FileReason { code: 7 } }

  /// Constructs the `Unsupported` recovery reason.
  pub fn unsupported() -> FileReason { return FileReason { code: 8 } }

  /// Constructs the catch-all `Other` recovery reason.
  pub fn other() -> FileReason { return FileReason { code: 9 } }

  /// Returns the stable numeric code of a consumed [`FileReason`].
  pub fn reasonCode(reason: FileReason) -> i32 { return reason.code }

  /// Constructs a portable [`FileError`] without a provider-specific numeric detail.
  pub fn error(operation: FileOperation, reason: FileReason) -> FileError {
    return FileError {
      operation: move operation,
      reason: move reason,
      providerCodeValue: 0,
      hasProviderCode: false,
    }
  }

  /// Constructs a portable [`FileError`] while retaining one provider-specific diagnostic code.
  ///
  /// # Details
  ///
  /// The numeric `code` is opaque outside that provider. The portable `operation` and `reason` remain
  /// the fields callers should use for recovery.
  pub fn errorWithCode(operation: FileOperation, reason: FileReason, code: i32) -> FileError {
    return FileError {
      operation: move operation,
      reason: move reason,
      providerCodeValue: code,
      hasProviderCode: true,
    }
  }

  /// Borrows an error and returns its provider-specific numeric detail, if one was retained.
  pub fn providerCode(error: &FileError) -> Option<i32> {
    if error.hasProviderCode { return Option<i32>.some(error.providerCodeValue) }
    return Option<i32>.none()
  }

  /// Creates an explicitly owned temporary directory under `parent` with a name beginning in `prefix`.
  ///
  /// # Details
  ///
  /// The result is owned. Nothing removes it until a caller runs [`release`] or [`releaseIgnored`].
  /// The prefix is encoded as UTF-8 and the provider chooses and claims the remaining unique name in
  /// one operation.
  pub effect fn temporaryDirectory(
    parent: &Path,
    prefix: string
  ) -> TemporaryDirectory ! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
    let created = run FileSystem.createTemporaryDirectory(parent, String.utf8Bytes(prefix))
    return TemporaryDirectory { path: move created }
  }

  /// Consumes one TemporaryDirectory and removes it together with everything inside it.
  ///
  /// # Details
  ///
  /// Both rows are stated rather than hidden. Removal reaches the provider, so it can fail; walking the
  /// tree to find what to remove allocates, so it can exhaust memory. A caller that must observe a
  /// failed cleanup uses this operation and handles the failure. The owner is consumed even when
  /// removal fails, so copy any diagnostic path information needed before calling.
  pub effect fn release(
    self: TemporaryDirectory
  ) -> () ! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
    let owned = move self
    let removed = run FileSystem.removeDirectoryRecursively(&owned.path)
    drop owned
    return ()
  }

  /// Consumes one TemporaryDirectory, removes it, and discards a failed removal.
  ///
  /// # Details
  ///
  /// This exists because `Effect.ensuring` types its finalizer `! never`, so a fallible release has
  /// to be recovered before it can be a finalizer. The recovery is deliberate and it is named: a
  /// caller reading `releaseIgnored` at the call site can see that a failed removal is being
  /// dropped, which a hook doing the same thing invisibly could not show. What is lost is bounded —
  /// a directory the host will reap — and what is kept is the protected Effect's own outcome, which
  /// is the answer the program was computing.
  ///
  /// A caller who needs the failure uses `release` instead and does not compose it with `ensuring`.
  ///
  /// The finalizer consumes the directory. The protected Effect cannot borrow it when the finalizer
  /// starts. Derive the required paths before you give the owner to the finalizer.
  pub effect fn releaseIgnored(
    self: TemporaryDirectory
  ) -> () ? &mut FileSystem | &mut Allocator {
    return run Effect.catchAll(FileSystem.release(move self), discardReleaseFailure)
  }

  /// Removes a directory, every descendant file, and every descendant directory.
  ///
  /// # Details
  ///
  /// Two passes, because the portable primitive removes exactly one *empty* directory. The first
  /// pass walks the tree front to back, unlinking every file it meets and recording every directory
  /// it meets; the second removes the recorded directories back to front. That order is
  /// child-before-parent for free: a directory is always recorded before the children found inside
  /// it, so reversing the record reverses the containment. Neither pass recurses, so depth costs
  /// vector capacity rather than stack.
  ///
  /// This operation is destructive and not transactional. If a provider or allocation failure occurs,
  /// removals already completed remain completed and the remaining tree is left in place.
  pub effect fn removeDirectoryRecursively(
    path: &Path
  ) -> () ! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
    let mut recorded = Vector<Path>.make()
    let seed = run Path.fromBytes(Path.rawBytes(path))
    let noted = run Vector<Path>.append(&mut recorded, move seed)
    let mut index = usize.ZERO
    while index < Vector<Path>.length(&recorded) {
      let current = run recordedCopy(&recorded, index)
      let entries = run FileSystem.listDirectory(&current)
      let listed = Vector<DirectoryEntry>.asSlice(&entries)
      let mut cursor = usize.ZERO
      while cursor < listed.length {
        let childKind = match &listed[cursor] {
          DirectoryEntry { path: childPath, kind: childEntryKind } => borrowedKindCode(&childEntryKind)
        }
        if childKind == 0 {
          let unlinked = match &listed[cursor] {
            DirectoryEntry { path: childPath, kind: childEntryKind } =>
              run FileSystem.removeFile(&childPath)
          }
        } else {
          let toRemove = match &listed[cursor] {
            DirectoryEntry { path: childPath, kind: childEntryKind } =>
              run Path.fromBytes(Path.rawBytes(&childPath))
          }
          let notedChild = run Vector<Path>.append(&mut recorded, move toRemove)
        }
        cursor = cursor + usize.ONE
      }
      index = index + usize.ONE
    }
    while usize.ZERO < Vector<Path>.length(&recorded) {
      let taken = Vector<Path>.pop(&mut recorded)
      let emptied = match move taken {
        Option<Path>.Some { value: selected } => move selected
        Option<Path>.None => run Path.fromBytes(Path.rawBytes(path))
      }
      let removed = run FileSystem.removeDirectory(&emptied)
    }
    return ()
  }

  /// Ensures that `path` and every missing ancestor exist as directories.
  ///
  /// # Details
  ///
  /// Existing directories are kept. An existing regular file at any component fails with
  /// `WrongType`; failures other than `NotFound` propagate. This is ordinary stat-then-create
  /// composition, so concurrent namespace changes may still race according to provider policy.
  pub effect fn createDirectoriesRecursively(
    path: &Path
  ) -> () ! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
    let values = pathBytes(path)
    let mut index = usize.ONE
    while index <= values.length {
      let mut boundary = false
      if index == values.length {
        boundary = true
      } else {
        if byte(values[index]) == 47 { boundary = true }
      }
      if boundary {
        let prefixBytes = run appendRange(Bytes.make(), values, usize.ZERO, index)
        let prefix = run finishPath(move prefixBytes)
        let completed = run Effect.result(statForResult(&prefix))
        let decision = classifyDirectory(move completed)
        let ensured = match move decision {
          DirectoryPresent {} => ()
          DirectoryMissing {} => run FileSystem.createDirectory(&prefix)
          DirectoryWrongType {} => run raise(FileSystem.error(FileSystem.statOperation(), FileSystem.wrongType()))
          DirectoryStatFailure { error: failure } => run raise(move failure)
        }
      }
      index = index + usize.ONE
    }
    return ()
  }

  /// Ensures every parent directory exists, then writes the complete byte view to `path`.
  ///
  /// # Details
  ///
  /// The final write uses `FileSystem.writeFile` create-or-truncate semantics. Passing root delegates
  /// directly to the provider and normally fails with `WrongType`. Directory creation and writing are
  /// not transactional, so a later failure may leave newly created parents behind.
  pub effect fn writeFileWithParents(
    path: &Path,
    bytes: &[u8]
  ) -> () ! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
    if Path.isRoot(path) { return run FileSystem.writeFile(path, bytes) }
    let pathValues = pathBytes(path)
    let nameStart = finalNameStart(pathValues)
    let mut parentEnd = usize.ONE
    if nameStart != usize.ONE { parentEnd = nameStart - usize.ONE }
    let parentBytes = run appendRange(Bytes.make(), pathValues, usize.ZERO, parentEnd)
    let ownedParent = run finishPath(move parentBytes)
    let values = pathBytes(&ownedParent)
    let mut index = usize.ONE
    while index <= values.length {
      let mut boundary = false
      if index == values.length {
        boundary = true
      } else {
        if byte(values[index]) == 47 { boundary = true }
      }
      if boundary {
        let prefixBytes = run appendRange(Bytes.make(), values, usize.ZERO, index)
        let prefix = run finishPath(move prefixBytes)
        let completed = run Effect.result(statForResult(&prefix))
        let decision = classifyDirectory(move completed)
        let ensured = match move decision {
          DirectoryPresent {} => ()
          DirectoryMissing {} => run FileSystem.createDirectory(&prefix)
          DirectoryWrongType {} => run raise(FileSystem.error(FileSystem.statOperation(), FileSystem.wrongType()))
          DirectoryStatFailure { error: failure } => run raise(move failure)
        }
      }
      index = index + usize.ONE
    }
    return run FileSystem.writeFile(path, bytes)
  }

  /// Returns whether a file or directory exists at `path`.
  ///
  /// # Details
  ///
  /// Only the portable `NotFound` reason becomes `false`. Permission, I/O, and every other provider
  /// failure propagate so callers cannot mistake an inaccessible path for an absent one.
  pub effect fn exists(path: &Path) -> bool ! FileError ? &mut FileSystem {
    let completed = run Effect.result(statForResult(path))
    return match move completed {
      Result<FileInfo | DirectoryInfo, FileError>.Success { value: info } => true
      Result<FileInfo | DirectoryInfo, FileError>.Failure { error: failure } => run existsFailure(move failure)
    }
  }
}

/// A directory a caller owns outright, together with everything written inside it.
///
/// # Details
///
/// Ownership is affine: `TemporaryDirectory` holds an owned `Path`, so exactly one binding holds
/// it and the compiler rejects a second use of a moved one. Ownership is not, however, a `Drop`
/// hook. Removing a directory is a fallible operation that requires the `FileSystem` capability,
/// and a `Drop` hook may carry neither a failure row nor a requirement row, so a hook here could
/// only be written by inventing an infallible intrinsic over a fallible syscall. Release is
/// therefore explicit and honest about both rows — see `release`.
///
/// Scope ownership comes from composition rather than from a hook: `Effect.ensuring(release)`
/// runs the release whatever the protected Effect's outcome. Because `ensuring` types its
/// finalizer `! never`, that composition has to say what a failed removal means; `releaseIgnored`
/// is the stdlib's answer and names the loss at the call site.
pub struct TemporaryDirectory {
  /// The complete owned path callers use while the scope remains live.
  pub path: Path
}

effect fn discardReleaseFailure(error: FileError | OutOfMemoryError) -> () { return () }

/// Copies one recorded Path out of the walk's own record.
///
/// The walk appends to the same record it is reading, so it reads through a copy rather than
/// through a borrow that the next append would invalidate.
effect fn recordedCopy(
  recorded: &Vector<Path>,
  index: usize
) -> Path ! FileError | OutOfMemoryError ? &mut Allocator {
  return match &Vector<Path>.asSlice(recorded)[index] {
    Path { bytes, nameBytes } => run Path.fromBytes(Bytes.asSlice(&bytes))
  }
}

struct DirectoryPresent {}
struct DirectoryMissing {}
struct DirectoryWrongType {}
struct DirectoryStatFailure { error: FileError }

fn classifyStatFailure(
  failure: FileError
) -> DirectoryMissing | DirectoryStatFailure {
  if failure.reason.code == 0 { return DirectoryMissing {} }
  return DirectoryStatFailure { error: move failure }
}

fn classifyDirectory(
  outcome: Result<FileInfo | DirectoryInfo, FileError>
) -> DirectoryPresent | DirectoryMissing | DirectoryWrongType | DirectoryStatFailure {
  return match move outcome {
    Result<FileInfo | DirectoryInfo, FileError>.Success { value: info } => match move info {
      DirectoryInfo {} => DirectoryPresent {}
      FileInfo { byteLength } => DirectoryWrongType {}
    }
    Result<FileInfo | DirectoryInfo, FileError>.Failure { error: failure } => classifyStatFailure(move failure)
  }
}

fn retainStatInfo(info: FileInfo | DirectoryInfo) -> FileInfo | DirectoryInfo {
  return move info
}

effect fn statForResult(
  path: &Path
) -> FileInfo | DirectoryInfo ! FileError ? &mut FileSystem {
  let info = run FileSystem.stat(path)
  return retainStatInfo(move info)
}

effect fn existsFailure(failure: FileError) -> bool ! FileError {
  if failure.reason.code == 0 { return false }
  return run raise(move failure)
}

