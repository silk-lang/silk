//! Bounded immutable owners for explicit trust-anchor sequences.
//!
//! # When to use
//!
//! Use [`fromAnchors`] when the application already owns explicit authorities. Use [`fromPem`] to
//! import strict certificate PEM as unconstrained anchors. Use [`copy`] or [`combine`] when a new
//! owner must survive release of its source snapshots.
//!
//! # Details
//!
//! A snapshot preserves every anchor, restriction, duplicate, and input position. All limits are
//! inclusive. Zero permits no corresponding resource. An empty anchor vector is valid explicit
//! trust that authenticates no peer.
//!
//! # Gotchas
//!
//! A snapshot stores explicit authority only. It does not validate a path, identity, time,
//! revocation state, or OS trust policy. Empty or whitespace-only PEM remains invalid.

import silk.allocator {Allocator, OutOfMemoryError}
import silk.certificate {Certificate, DecodeError, DecodeLimits}
import silk.certificate_bundle {CertificateBundle}
import silk.filesystem {FileError}
import silk.layout {Layout, LayoutOverflow}
import silk.option {Option}
import silk.ownership { Copy }
import silk.result {Result}
import silk.trust_anchor {TrustAnchor}
import silk.usize
import silk.vector {Vector}

/// Inclusive budgets for one complete trust snapshot.
pub struct SnapshotLimits {
  /// Maximum anchor count, including duplicate certificate values.
  pub anchors: usize
  /// Maximum aggregate certificate and configured-constraint bytes.
  pub encodedBytes: usize
}

impl Copy for SnapshotLimits {}

impl SnapshotLimits {
  /// Returns finite defaults of 1024 anchors and 8 MiB of retained encoded data.
  pub fn defaults() -> SnapshotLimits {
    return SnapshotLimits {anchors: 1024, encodedBytes: 8388608}
  }
}

/// Inclusive strict-decoder and snapshot budgets for one trust-source load.
pub struct TrustLoadLimits {
  /// Bounds used by strict PEM, DER, and certificate decoding.
  pub decode: DecodeLimits
  /// Bounds used by the complete returned snapshot.
  pub snapshot: SnapshotLimits
}

impl Copy for TrustLoadLimits {}

impl TrustLoadLimits {
  /// Returns the finite certificate-decoder and snapshot defaults.
  pub fn defaults() -> TrustLoadLimits {
    return TrustLoadLimits {decode: DecodeLimits.defaults(), snapshot: SnapshotLimits.defaults()}
  }
}

/// A bounded trust-source resource category.
pub enum TrustLimitKind {
  /// The complete snapshot has too many anchors, including duplicates.
  AnchorCount,
  /// The aggregate certificate and configured-constraint bytes exceed the budget.
  EncodedBytes,
  /// A native provider input exceeds its acquisition budget.
  InputBytes
}

/// A rejected native trust-source configuration rule.
pub enum TrustConfigurationReason {
  /// An explicit native root path has no bytes.
  EmptyRoot,
  /// An explicit native root path is not absolute.
  NonAbsoluteRoot,
  /// An explicit native root path contains a zero byte.
  NulRoot,
  /// A native root path exceeds its byte budget.
  PathBytes
}

/// A native trust-source file stage.
pub enum TrustFileOperation {
  /// Opening the configured trust file failed.
  Open,
  /// Reading the configured trust file failed.
  Read,
  /// Closing the configured trust file failed.
  Close
}

/// A semantic trust-source failure that does not include allocation refusal.
pub union TrustSourceError {
  /// Strict PEM, DER, or certificate decoding failed at the retained decoder location.
  Decode {
    /// The complete structured decoder failure.
    pub error: DecodeError,
  },
  /// A finite trust-source budget was exceeded.
  LimitExceeded {
    /// The exhausted resource category.
    pub kind: TrustLimitKind,
    /// The inclusive configured budget.
    pub limit: usize,
  },
  /// A native provider configuration is invalid.
  InvalidConfiguration {
    /// The rejected configuration rule.
    pub reason: TrustConfigurationReason,
  },
  /// A native provider file operation failed.
  File {
    /// The failed file stage.
    pub operation: TrustFileOperation,
    /// The complete portable file failure with its provider code.
    pub error: FileError,
  }
}

/// One immutable independently owned sequence of explicit trust authorities.
///
/// # Details
///
/// The snapshot preserves input order and duplicates. Each borrowed anchor remains valid only
/// while this snapshot remains valid. Construction does not inspect certificate semantics.
pub struct TrustSnapshot {
  anchorsValue: Vector<TrustAnchor>
}

impl TrustSnapshot {
  /// Consumes a complete anchor vector after allocation-free count and byte-budget validation.
  ///
  /// # Details
  ///
  /// Success preserves the vector allocation, order, duplicates, and configured restrictions.
  /// Failure releases the consumed input and publishes no snapshot. Empty explicit trust is valid.
  pub fn fromAnchors(
    anchors: Vector<TrustAnchor>,
    limits: SnapshotLimits,
  ) -> Result<TrustSnapshot, TrustSourceError> {
    let exceeded = validateAnchors(Vector<TrustAnchor>.asSlice(&anchors), limits)
    return match move exceeded {
      Option<TrustLimitKind>.Some {value: kind} => {
        return limitFailure(kind, selectedLimit(kind, limits))
      }
      Option<TrustLimitKind>.None => {
        return Result<TrustSnapshot, TrustSourceError>.succeed(
          TrustSnapshot {anchorsValue: move anchors},
        )
      }
    }
  }

  /// Strictly decodes certificate PEM and moves each certificate into an unconstrained anchor.
  ///
  /// # Details
  ///
  /// The result preserves order and duplicates. It reparses no DER and copies no certificate after
  /// decoding. Decoder failures retain their structured locations. Allocation refusal remains an
  /// `OutOfMemoryError` Effect failure. Every failure publishes no snapshot.
  ///
  /// # Gotchas
  ///
  /// Empty or whitespace-only PEM is invalid. Import assigns explicit authority but does not
  /// authenticate a path or reproduce OS trust policy.
  pub effect fn fromPem(
    input: &[u8],
    limits: TrustLoadLimits,
  ) -> Result<TrustSnapshot, TrustSourceError>
  ! OutOfMemoryError
  ? &mut Allocator {
    let decoded = run CertificateBundle.decodePem(input, limits.decode)
    let bundle = match move decoded {
      Result<CertificateBundle, DecodeError>.Failure {error} => {
        return Result<TrustSnapshot, TrustSourceError>.failResult(
          TrustSourceError.Decode {error: move error},
        )
      }
      Result<CertificateBundle, DecodeError>.Success {value} => move value
    }
    let mut certificates = CertificateBundle.intoCertificates(move bundle)
    let total = Vector<Certificate>.length(&certificates)
    if total > limits.snapshot.anchors {
      return limitFailure(TrustLimitKind.AnchorCount, limits.snapshot.anchors)
    }
    if !validateAnchorLayout(total) {
      return limitFailure(TrustLimitKind.AnchorCount, limits.snapshot.anchors)
    }
    if !validateCertificateBytes(&certificates, limits.snapshot.encodedBytes) {
      return limitFailure(TrustLimitKind.EncodedBytes, limits.snapshot.encodedBytes)
    }
    let mut anchors = Vector<TrustAnchor>.make()
    let reserved = run Vector<TrustAnchor>.reserveExact(&mut anchors, total)
    let mut moved = usize.ZERO
    while moved < total {
      let certificate = Vector<Certificate>.remove(&mut certificates, usize.ZERO)
      let anchor = TrustAnchor.fromCertificate(move certificate)
      let appended = run Vector<TrustAnchor>.append(&mut anchors, move anchor)
      moved = moved + usize.ONE
    }
    return TrustSnapshot.fromAnchors(move anchors, limits.snapshot)
  }

  /// Borrows all anchors in their original order, including every duplicate.
  pub fn anchors(self: &Self) -> &[TrustAnchor] {
    return Vector<TrustAnchor>.asSlice(&self.anchorsValue)
  }

  /// Creates an independently owned copy under the supplied inclusive limits.
  ///
  /// # Details
  ///
  /// Every certificate and configured constraint is copied. Allocation refusal releases partial
  /// output and leaves this snapshot unchanged.
  pub effect fn copy(
    self: &Self,
    limits: SnapshotLimits,
  ) -> Result<TrustSnapshot, TrustSourceError>
  ! OutOfMemoryError
  ? &mut Allocator {
    let values = TrustSnapshot.anchors(self)
    let exceeded = validateAnchors(values, limits)
    match move exceeded {
      Option<TrustLimitKind>.Some {value: kind} => {
        return limitFailure(kind, selectedLimit(kind, limits))
      }
      Option<TrustLimitKind>.None => {}
    }
    if !validateAnchorLayout(values.length) {
      return limitFailure(TrustLimitKind.AnchorCount, limits.anchors)
    }
    let mut copied = Vector<TrustAnchor>.make()
    let reserved = run Vector<TrustAnchor>.reserveExact(&mut copied, values.length)
    let mut index = usize.ZERO
    while index < values.length {
      let anchor = run TrustAnchor.clone(&values[index])
      let appended = run Vector<TrustAnchor>.append(&mut copied, move anchor)
      index = index + usize.ONE
    }
    return Result<TrustSnapshot, TrustSourceError>.succeed(
      TrustSnapshot {anchorsValue: move copied},
    )
  }

  /// Copies `primary` anchors, then `additional` anchors, into one independent owner.
  ///
  /// # Details
  ///
  /// The operation preserves every duplicate and configured restriction. It does not merge equal
  /// certificate DER. A less-restricted additional authority can therefore widen trust.
  pub effect fn combine(
    primary: &TrustSnapshot,
    additional: &TrustSnapshot,
    limits: SnapshotLimits,
  ) -> Result<TrustSnapshot, TrustSourceError>
  ! OutOfMemoryError
  ? &mut Allocator {
    let first = TrustSnapshot.anchors(primary)
    let second = TrustSnapshot.anchors(additional)
    let count = match move usize.checkedAdd(first.length, second.length) {
      Option<usize>.Some {value} => value
      Option<usize>.None => {
        return limitFailure(TrustLimitKind.AnchorCount, limits.anchors)
      }
    }
    if count > limits.anchors {
      return limitFailure(TrustLimitKind.AnchorCount, limits.anchors)
    }
    if !validateAnchorLayout(count) {
      return limitFailure(TrustLimitKind.AnchorCount, limits.anchors)
    }
    if !validateCombined(first, second, limits.encodedBytes) {
      return limitFailure(TrustLimitKind.EncodedBytes, limits.encodedBytes)
    }
    let mut combined = Vector<TrustAnchor>.make()
    let reserved = run Vector<TrustAnchor>.reserveExact(&mut combined, count)
    let mut firstIndex = usize.ZERO
    while firstIndex < first.length {
      let anchor = run TrustAnchor.clone(&first[firstIndex])
      let appended = run Vector<TrustAnchor>.append(&mut combined, move anchor)
      firstIndex = firstIndex + usize.ONE
    }
    let mut secondIndex = usize.ZERO
    while secondIndex < second.length {
      let anchor = run TrustAnchor.clone(&second[secondIndex])
      let appended = run Vector<TrustAnchor>.append(&mut combined, move anchor)
      secondIndex = secondIndex + usize.ONE
    }
    return Result<TrustSnapshot, TrustSourceError>.succeed(
      TrustSnapshot {anchorsValue: move combined},
    )
  }
}

fn validateAnchors(
  anchors: &[TrustAnchor],
  limits: SnapshotLimits,
) -> Option<TrustLimitKind> {
  if anchors.length > limits.anchors {
    return Option<TrustLimitKind>.some(TrustLimitKind.AnchorCount)
  }
  let encoded = validateEncoded(anchors, limits.encodedBytes, usize.ZERO)
  return match move encoded {
    Result<usize, TrustLimitKind>.Failure {error: kind} => {
      return Option<TrustLimitKind>.some(kind)
    }
    Result<usize, TrustLimitKind>.Success {value: ignored} => {
      return Option<TrustLimitKind>.none()
    }
  }
}

fn validateAnchorLayout(count: usize) -> bool {
  let planned = Layout.repeat(Layout.of<TrustAnchor>(), count)
  return match move planned {
    Layout ready => true
    LayoutOverflow overflow => false
  }
}

fn validateCertificateBytes(
  certificates: &Vector<Certificate>,
  limit: usize,
) -> bool {
  let values = Vector<Certificate>.asSlice(certificates)
  let mut total = usize.ZERO
  let mut index = usize.ZERO
  while index < values.length {
    let size = Certificate.der(&values[index]).length
    total = match move usize.checkedAdd(total, size) {
      Option<usize>.Some {value} => value
      Option<usize>.None => { return false }
    }
    if total > limit {
      return false
    }
    index = index + usize.ONE
  }
  return true
}

fn validateCombined(
  primary: &[TrustAnchor],
  additional: &[TrustAnchor],
  limit: usize,
) -> bool {
  let first = validateEncoded(primary, limit, usize.ZERO)
  let subtotal = match move first {
    Result<usize, TrustLimitKind>.Failure {error} => { return false }
    Result<usize, TrustLimitKind>.Success {value} => value
  }
  let second = validateEncoded(additional, limit, subtotal)
  return match move second {
    Result<usize, TrustLimitKind>.Failure {error} => false
    Result<usize, TrustLimitKind>.Success {value: ignored} => true
  }
}

fn validateEncoded(
  anchors: &[TrustAnchor],
  limit: usize,
  initial: usize,
) -> Result<usize, TrustLimitKind> {
  let mut total = initial
  let mut index = usize.ZERO
  while index < anchors.length {
    total = match move usize.checkedAdd(total, TrustAnchor.encodedBytes(&anchors[index])) {
      Option<usize>.Some {value} => value
      Option<usize>.None => {
        return Result<usize, TrustLimitKind>.failResult(TrustLimitKind.EncodedBytes)
      }
    }
    if total > limit {
      return Result<usize, TrustLimitKind>.failResult(TrustLimitKind.EncodedBytes)
    }
    index = index + usize.ONE
  }
  return Result<usize, TrustLimitKind>.succeed(total)
}

fn selectedLimit(kind: TrustLimitKind, limits: SnapshotLimits) -> usize {
  if kind == TrustLimitKind.AnchorCount { return limits.anchors }
  return limits.encodedBytes
}

fn limitFailure(
  kind: TrustLimitKind,
  limit: usize,
) -> Result<TrustSnapshot, TrustSourceError> {
  return Result<TrustSnapshot, TrustSourceError>.failResult(
    TrustSourceError.LimitExceeded {kind: kind, limit: limit},
  )
}
