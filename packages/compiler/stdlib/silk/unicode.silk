//! Explicit Unicode canonical normalization backed by the pinned Unicode 17.0.0 data set.
//!
//! # When to use
//! Normalize text at a boundary where canonically equivalent spellings must compare alike. Use
//! [`normalizeNfc`] for ordinary storage and comparison, or [`normalizeNfd`] when a decomposed,
//! canonically ordered sequence is the desired representation.
//!
//! # Details
//! Normalization is opt-in: `string` equality continues to compare exact UTF-8 bytes. Both forms
//! allocate a fresh owned [`String`], handle Hangul composition algorithmically, and use the same
//! generated tables on every target. [`dataVersion`] reports which Unicode database defines those
//! results.
//!
//! # Gotchas
//! This module implements canonical NFC and NFD, not compatibility normalization (NFKC or NFKD),
//! locale-sensitive comparison, grapheme segmentation, or case folding.
//!
//! # Examples
//! ## Make canonically equivalent text compare equal
//! ```silk
//! import silk.allocator { Allocator, OutOfMemoryError }
//!
//! import silk.effect { Effect }
//!
//! import silk.string { String }
//!
//! import silk.unicode { Unicode }
//!
//! effect fn normalize() -> i32
//! ! OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let mut composing = Unicode.normalizeNfc("e\u{301}")
//!     |> Effect.provideMut<Allocator>(&mut allocator)
//!   let composed = run composing
//!   let mut decomposing = Unicode.normalizeNfd("é")
//!     |> Effect.provideMut<Allocator>(&mut allocator)
//!   let decomposed = run decomposing
//!   if String.view(&composed) != "é" {
//!     return 0
//!   }
//!   if String.view(&decomposed) != "e\u{301}" {
//!     return 0
//!   }
//!   return 42
//! }
//!
//! effect fn recover(error: OutOfMemoryError) -> i32 {
//!   return 0
//! }
//!
//! pub fn main() -> i32 {
//!   return run Effect.catchAll(normalize(), recover)
//! }
//! ```

// Unicode policy lives here rather than in the compiler, and it is explicitly invoked. Nothing on
// this path runs unless a program calls it: ordinary `string` equality still compares exact bytes,
// so a precomposed `é` and a decomposed `é` stay unequal until source normalizes them.
//
// The data these algorithms read is generated into `silk/unicode_tables` from a pinned Unicode
// database. A later Unicode version regenerates that module and nothing else: no compiler type
// identity and no target ABI mentions it.
//
// The scalar buffers move through the helpers rather than being borrowed into them, because a
// borrow has to come from a direct binding and a reference parameter cannot be reborrowed. Moving
// a Vector is a move of its three fields, not a copy of its storage, so the buffer is built once
// and handed along.

import silk.bool
import silk.allocator { Allocator, OutOfMemoryError }
import silk.allocator { OutOfMemoryError }
import silk.result { Result }
import silk.string { String, InvalidUtf8 }
import silk.u32
import silk.u8
import silk.unicode_tables { Decomposition, UnicodeTables }
import silk.usize
import silk.vector { Vector }

/// The owner of the normalization and Unicode-data operations.
///
/// # Details
///
/// This struct carries no data and is never constructed by the library. Every operation is an
/// inherent member declared in `impl Unicode`, reached through `import silk.unicode { Unicode }`.
pub struct Unicode {}

impl Unicode {
  /// Returns the Unicode version that defines this module's normalization results.
  ///
  /// # Details
  ///
  /// The version is data, not identity: a later database changes what this returns and what the
  /// tables contain, and changes neither a compiler type nor a target ABI.
  pub fn dataVersion() -> string<'static> {
    return UnicodeTables.dataVersion()
  }

  /// Returns the longest full canonical decomposition of one scalar in the active Unicode data.
  pub fn longestDecomposition() -> usize {
    return UnicodeTables.maximumDecompositionLength()
  }

  /// Returns a Unicode scalar's canonical combining class, or zero for a starter or unknown value.
  pub fn canonicalCombiningClass(
    /// Unicode scalar value represented as its unsigned code point.
    scalar: u32,
  ) -> u32 {
    return UnicodeTables.combiningClass(scalar)
  }

  /// Returns the Normalization Form D of text: fully decomposed, in canonical order.
  ///
  /// # When to use
  ///
  /// Use this function when consumers require decomposed scalars in canonical combining-class order.
  /// Use [`normalizeNfc`] for ordinary normalized storage and comparison.
  ///
  /// # Details
  ///
  /// The function does not change `value`. It returns freshly owned UTF-8 text and can allocate.
  /// Canonically equivalent inputs produce equal NFD text under the same Unicode data version.
  pub effect fn normalizeNfd(value: string) -> String ! OutOfMemoryError ? &mut Allocator {
    let scalars = run decomposedScalars(value)
    return run encodeOwned(move scalars)
  }

  /// Returns the Normalization Form C of text: decomposed, canonically ordered, then recomposed.
  ///
  /// # When to use
  ///
  /// Use this function for ordinary normalized storage and canonical-equivalence comparison. Use
  /// [`normalizeNfd`] when a consumer requires decomposed scalars.
  ///
  /// # Details
  ///
  /// The function does not change `value`. It returns freshly owned UTF-8 text and can allocate.
  /// Canonically equivalent inputs produce equal NFC text under the same Unicode data version.
  pub effect fn normalizeNfc(value: string) -> String ! OutOfMemoryError ? &mut Allocator {
    let scalars = run decomposedScalars(value)
    let composed = composeInPlace(move scalars)
    return run encodeOwned(move composed)
  }
}

/// Hangul syllables decompose and compose arithmetically rather than through a table, so UAX #15
/// names these constants instead of tabulating eleven thousand rows.
const HANGUL_SYLLABLE_BASE: u32 = 44032
const HANGUL_LEADING_BASE: u32 = 4352
const HANGUL_VOWEL_BASE: u32 = 4449
const HANGUL_TRAILING_BASE: u32 = 4519
const HANGUL_LEADING_COUNT: u32 = 19
const HANGUL_VOWEL_COUNT: u32 = 21
const HANGUL_TRAILING_COUNT: u32 = 28
const HANGUL_SYLLABLE_COUNT: u32 = 11172

/// A combining class no scalar carries. Composition uses it for "the starter is still untouched".
const NO_COMBINING_CLASS: u32 = 256

/// Room for the trailing components a full decomposition can stack up.
///
/// A decomposition recurses through its first component only, so the stack holds one fewer entry
/// than the longest full decomposition. `namesLongestDecomposition` in the test suite pins the
/// generated bound against this constant, so a Unicode version that decomposes more deeply fails
/// loudly rather than silently overrunning.
const PENDING_CAPACITY: usize = 4

fn isHangulSyllable(scalar: u32) -> bool {
  if scalar < HANGUL_SYLLABLE_BASE { return false }
  return scalar < HANGUL_SYLLABLE_BASE + HANGUL_SYLLABLE_COUNT
}

/// Appends one scalar, then moves it back past any preceding mark of a higher combining class.
///
/// Canonical ordering is a stable sort by combining class. Doing it as each scalar arrives keeps
/// the buffer behind the cursor always in order, so no separate ordering pass is needed.
effect fn appendOrdered(
  buffer: Vector<u32>,
  scalar: u32,
) -> Vector<u32> ! OutOfMemoryError ? &mut Allocator {
  let mut ordered = move buffer
  let appended = run Vector.append<u32>(&mut ordered, scalar)
  let class = UnicodeTables.combiningClass(scalar)
  if class == 0 { return move ordered }
  let mut index = Vector.length<u32>(&ordered) - usize.ONE
  while usize.ZERO < index {
    let previous = Vector.get<u32>(&ordered, index - usize.ONE)
    let previousClass = UnicodeTables.combiningClass(previous)
    if previousClass == 0 { return move ordered }
    if previousClass <= class { return move ordered }
    Vector.set<u32>(&mut ordered, index - usize.ONE, scalar)
    Vector.set<u32>(&mut ordered, index, previous)
    index = index - usize.ONE
  }
  return move ordered
}

/// Appends a Hangul syllable's canonical decomposition, which is arithmetic rather than tabulated.
effect fn decomposeHangul(
  buffer: Vector<u32>,
  scalar: u32,
) -> Vector<u32> ! OutOfMemoryError ? &mut Allocator {
  let index = scalar - HANGUL_SYLLABLE_BASE
  let leading = HANGUL_LEADING_BASE + index / (HANGUL_VOWEL_COUNT * HANGUL_TRAILING_COUNT)
  let vowel = HANGUL_VOWEL_BASE
    + (index % (HANGUL_VOWEL_COUNT * HANGUL_TRAILING_COUNT)) / HANGUL_TRAILING_COUNT
  let trailing = index % HANGUL_TRAILING_COUNT
  let withLeading = run appendOrdered(move buffer, leading)
  let withVowel = run appendOrdered(move withLeading, vowel)
  if trailing == 0 { return move withVowel }
  return run appendOrdered(move withVowel, HANGUL_TRAILING_BASE + trailing)
}

/// Appends one scalar's full canonical decomposition in canonical order.
///
/// Decomposition recurses through a mapping's first component only. The generator proves no second
/// component decomposes further, so the trailing components collect on a small stack and unwind
/// once the innermost starter is emitted.
effect fn decomposeInto(
  buffer: Vector<u32>,
  scalar: u32,
) -> Vector<u32> ! OutOfMemoryError ? &mut Allocator {
  if isHangulSyllable(scalar) { return run decomposeHangul(move buffer, scalar) }
  let mut pending = [scalar, scalar, scalar, scalar]
  let mut depth = usize.ZERO
  let mut current = scalar
  while true {
    let mapping = UnicodeTables.canonicalDecomposition(current)
    if mapping.first == 0 { break }
    if mapping.second != 0 {
      pending[depth] = mapping.second
      depth = depth + usize.ONE
    }
    current = mapping.first
  }
  let mut decomposed = run appendOrdered(move buffer, current)
  while usize.ZERO < depth {
    depth = depth - usize.ONE
    let extended = run appendOrdered(move decomposed, pending[depth])
    decomposed = move extended
  }
  return move decomposed
}

/// Composes a starter with the scalar following it, or returns zero when they do not compose.
fn composePair(starter: u32, following: u32) -> u32 {
  if HANGUL_LEADING_BASE <= starter {
    if starter < HANGUL_LEADING_BASE + HANGUL_LEADING_COUNT {
      if HANGUL_VOWEL_BASE <= following {
        if following < HANGUL_VOWEL_BASE + HANGUL_VOWEL_COUNT {
          let leading = starter - HANGUL_LEADING_BASE
          let vowel = following - HANGUL_VOWEL_BASE
          return HANGUL_SYLLABLE_BASE
            + (leading * HANGUL_VOWEL_COUNT + vowel) * HANGUL_TRAILING_COUNT
        }
      }
    }
  }
  if isHangulSyllable(starter) {
    if (starter - HANGUL_SYLLABLE_BASE) % HANGUL_TRAILING_COUNT == 0 {
      if HANGUL_TRAILING_BASE < following {
        if following < HANGUL_TRAILING_BASE + HANGUL_TRAILING_COUNT {
          return starter + (following - HANGUL_TRAILING_BASE)
        }
      }
    }
  }
  return UnicodeTables.canonicalComposition(starter, following)
}

/// Rewrites a canonically ordered buffer as its canonical composition.
///
/// This is the UAX #15 composition pass. A starter absorbs each following scalar it composes with,
/// and a scalar blocked from its starter by an equal or higher combining class is kept as written.
fn composeInPlace(buffer: Vector<u32>) -> Vector<u32> {
  let mut composed = move buffer
  if Vector.length<u32>(&composed) == usize.ZERO { return move composed }
  let mut starterIndex = usize.ZERO
  let mut starter = Vector.get<u32>(&composed, usize.ZERO)
  let mut written = usize.ONE
  let mut lastClass = UnicodeTables.combiningClass(starter)
  if lastClass != 0 { lastClass = NO_COMBINING_CLASS }
  let mut index = usize.ONE
  while index < Vector.length<u32>(&composed) {
    let scalar = Vector.get<u32>(&composed, index)
    let class = UnicodeTables.combiningClass(scalar)
    let composite = composePair(starter, scalar)
    let mut absorbed = false
    if composite != 0 {
      if lastClass < class { absorbed = true }
      if lastClass == 0 { absorbed = true }
    }
    if absorbed {
      Vector.set<u32>(&mut composed, starterIndex, composite)
      starter = composite
    } else {
      if class == 0 {
        starterIndex = written
        starter = scalar
      }
      lastClass = class
      Vector.set<u32>(&mut composed, written, scalar)
      written = written + usize.ONE
    }
    index = index + usize.ONE
  }
  Vector.truncate<u32>(&mut composed, written)
  return move composed
}

/// Appends one scalar's UTF-8 encoding to a buffer the caller owns directly.
///
/// This is written against a local binding rather than as a helper taking the buffer, because a
/// reference parameter cannot be reborrowed and threading the buffer through by move hit a native
/// backend defect: a vector rebound by `buffer = move helper(move buffer)` inside a loop reads
/// stale once the loop ends and the buffer is borrowed. See the note in the pull request.
/// Decodes valid UTF-8 into scalars, decomposing and canonically ordering as it goes.
///
/// The input is a `string`, so it is already valid UTF-8 and the decode needs no validation; the
/// safe validating decoder is `silk/string`'s `fromUtf8`.
effect fn decomposedScalars(value: string) -> Vector<u32> ! OutOfMemoryError ? &mut Allocator {
  let bytes = String.utf8Bytes(value)
  let mut buffer = Vector.make<u32>()
  let mut offset = usize.ZERO
  while offset < bytes.length {
    let first = u8.toU32(bytes[offset])
    let mut scalar = first
    let mut width = usize.ONE
    if first > 193 {
      if first <= 223 {
        scalar = (first - 192) * 64 + u8.toU32(bytes[offset + usize.ONE]) - 128
        width = 2
      } else {
        if first <= 239 {
          scalar = (first - 224) * 4096
            + (u8.toU32(bytes[offset + usize.ONE]) - 128) * 64
            + u8.toU32(bytes[offset + 2]) - 128
          width = 3
        } else {
          scalar = (first - 240) * 262144
            + (u8.toU32(bytes[offset + usize.ONE]) - 128) * 4096
            + (u8.toU32(bytes[offset + 2]) - 128) * 64
            + u8.toU32(bytes[offset + 3]) - 128
          width = 4
        }
      }
    }
    let extended = run decomposeInto(move buffer, scalar)
    buffer = move extended
    offset = offset + width
  }
  return move buffer
}

/// Copies a scalar sequence into owned text.
///
/// The encoder only ever writes well-formed UTF-8, so the validation inside `String.copyUtf8` cannot fail
/// here; the failing arm returns empty text because this module has no reason to reach for the
/// unchecked constructor to save a scan it is not paying much for.
effect fn encodeOwned(scalars: Vector<u32>) -> String ! OutOfMemoryError ? &mut Allocator {
  let source = move scalars
  let mut bytes = Vector.make<u8>()
  let mut index = usize.ZERO
  while index < Vector.length<u32>(&source) {
    let scalar = Vector.get<u32>(&source, index)
    if scalar < 128 {
      let only = run Vector.append<u8>(&mut bytes, u32.toU8(scalar))
    } else {
      if scalar < 2048 {
        let lead = run Vector.append<u8>(&mut bytes, u32.toU8(192 + scalar / 64))
        let last = run Vector.append<u8>(&mut bytes, u32.toU8(128 + scalar % 64))
      } else {
        if scalar < 65536 {
          let lead = run Vector.append<u8>(&mut bytes, u32.toU8(224 + scalar / 4096))
          let middle = run Vector.append<u8>(&mut bytes, u32.toU8(128 + (scalar / 64) % 64))
          let last = run Vector.append<u8>(&mut bytes, u32.toU8(128 + scalar % 64))
        } else {
          let lead = run Vector.append<u8>(&mut bytes, u32.toU8(240 + scalar / 262144))
          let second = run Vector.append<u8>(&mut bytes, u32.toU8(128 + (scalar / 4096) % 64))
          let third = run Vector.append<u8>(&mut bytes, u32.toU8(128 + (scalar / 64) % 64))
          let last = run Vector.append<u8>(&mut bytes, u32.toU8(128 + scalar % 64))
        }
      }
    }
    index = index + usize.ONE
  }
  let owned = run String.copyUtf8(Vector.asSlice<u8>(&bytes))
  return match move owned {
    Result<String, InvalidUtf8>.Success { value } => move value
    Result<String, InvalidUtf8>.Failure { error } => String.make()
  }
}

