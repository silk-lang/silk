//! Checked construction, integer inspection, equality, and ordering for Unicode scalar `char`
//! values.
//!
//! # When to use
//! Prefer comparison operators in direct expressions. Import these functions when comparison must
//! be passed by name or when the Unicode scalar ordering should be explicit at a call site.
//!
//! # Details
//! Ordering compares scalar values, not locale collation, normalization, grapheme clusters, or UTF-8
//! byte sequences. These functions allocate no storage and add no Effect channels.
//!
//! # Gotchas
//! Integer construction rejects `0xD800` through `0xDFFF` and values above `0x10FFFF`. It returns
//! `None`; it does not truncate or trap.
//!
//! # Examples
//! ## Validate a Unicode scalar integer
//! ```silk
//! import silk.char
//!
//! import silk.option { Option }
//!
//! pub fn main() -> i32 {
//!   let scalar = char.fromU32(0x2603)
//!   let value = move scalar
//!     |> Option<char>.unwrapOr('?')
//!   if char.toU32(value) != 0x2603 {
//!     return 1
//!   }
//!   let surrogate = char.fromU32(0xD800)
//!   let replacement = move surrogate
//!     |> Option<char>.unwrapOr('?')
//!   if replacement != '?' {
//!     return 2
//!   }
//!   return 42
//! }
//! ```

import silk.bool
import silk.option { Option }
import silk.u32

/// Converts an integer to a Unicode scalar. Returns `None` for `0xD800` through `0xDFFF` and values
/// above `0x10FFFF`.
pub fn fromU32(value: u32) -> Option<char> {
  return Intrinsic.charFromU32<Option<char>>(value, Option.some, Option.none)
}

/// Returns the exact integer value of an already valid Unicode scalar.
pub fn toU32(value: char) -> u32 {
  return Intrinsic.charToU32(value)
}

/// Returns `true` when `left` and `right` are the same Unicode scalar value.
pub fn equals(left: char, right: char) -> bool {
  return Intrinsic.charEquals(left, right)
}

/// Returns `true` when `left` and `right` are different Unicode scalar values.
pub fn notEquals(left: char, right: char) -> bool {
  return Intrinsic.charNotEquals(left, right)
}

/// Returns `true` when the Unicode scalar value of `left` is less than `right`.
pub fn lessThan(left: char, right: char) -> bool {
  return Intrinsic.charLessThan(&left, &right)
}

/// Returns `true` when the Unicode scalar value of `left` is less than or equal to `right`.
pub fn lessOrEqual(left: char, right: char) -> bool {
  return Intrinsic.charLessOrEqual(left, right)
}

/// Returns `true` when the Unicode scalar value of `left` is greater than `right`.
pub fn greaterThan(left: char, right: char) -> bool {
  return Intrinsic.charGreaterThan(left, right)
}

/// Returns `true` when the Unicode scalar value of `left` is greater than or equal to `right`.
pub fn greaterOrEqual(left: char, right: char) -> bool {
  return Intrinsic.charGreaterOrEqual(left, right)
}
