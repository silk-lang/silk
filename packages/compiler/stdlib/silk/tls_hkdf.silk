//! TLS 1.3 key expansion and transcript-bound secret derivation.
//!
//! # When to use
//! Use [`TlsHkdfSha256`] or [`TlsHkdfSha384`] for TLS labels under RFC 8446 section 7.1.
//! Use `silk.hkdf` for generic HKDF with caller-defined context bytes.
//!
//! # Details
//! Operations borrow secrets and inputs without retaining them. Expansion fills caller-owned output.
//! Label bytes are preserved exactly and receive the fixed `tls13 ` prefix.
//! These operations require no allocator or provider.
//!
//! # Gotchas
//! These operations do not select protocol labels, serialize transcripts, authenticate peers, or implement TLS.
//! Secret copies are not guaranteed to be erased. Functional correctness does not establish constant-time execution.

import silk.hkdf {HkdfSha256, HkdfSha384, OutputTooLongError}
import silk.result {Result}
import silk.sha2 {Sha256, Sha384}
import silk.slice {Slice}
import silk.usize
import silk.u64

/// A rejected public length; no variant contains secret or transcript bytes.
pub union LabelError {
  /// A raw label outside the inclusive range 1 through 249 bytes.
  LabelLength {
    /// The requested length in bytes.
    pub requested: usize,
    /// The largest accepted length in bytes.
    pub maximum: usize,
  },
  /// A context longer than 255 bytes.
  ContextLength {
    /// The requested length in bytes.
    pub requested: usize,
    /// The largest accepted length in bytes.
    pub maximum: usize,
  },
  /// An output longer than 255 digest blocks.
  OutputLength {
    /// The requested length in bytes.
    pub requested: usize,
    /// The largest accepted length in bytes.
    pub maximum: usize,
  },
  /// A message longer than the SHA-256 byte-aligned input domain.
  MessageTooLong {
    /// The requested length in bytes.
    pub requested: u64,
    /// The largest accepted length in bytes.
    pub maximum: u64,
  },
}

// Admission uses a numeric boundary so it can be checked without constructing impossible slices.
fn sha256MessageLengthAdmitted(length: u64) -> bool {
  return length <= u64.shiftRight(u64.MAX, 3)
}

fn validate(label: &[u8], contextLength: usize, outputLength: usize, maximum: usize) -> Result<
  (),
  LabelError,
> {
  if label.length == 0 || label.length > 249 {
    return Result<(), LabelError>.failResult(
      LabelError.LabelLength {requested: label.length, maximum: 249},
    )
  }
  if contextLength > 255 {
    return Result<(), LabelError>.failResult(
      LabelError.ContextLength {requested: contextLength, maximum: 255},
    )
  }
  if outputLength > maximum {
    return Result<(), LabelError>.failResult(
      LabelError.OutputLength {requested: outputLength, maximum: maximum},
    )
  }
  return Result<(), LabelError>.succeed(())
}

// Length validation precedes every call. All offsets fit in the fixed framing buffer.
fn frame(label: &[u8], context: &[u8], outputLength: usize, info: &mut [u8]) -> usize {
  info[0] = usize.toU8(outputLength / 256)
  info[1] = usize.toU8(outputLength % 256)
  info[2] = usize.toU8(6 + label.length)
  info[3] = 116
  info[4] = 108
  info[5] = 115
  info[6] = 49
  info[7] = 51
  info[8] = 32
  let mut index: usize = 0
  while index < label.length {
    info[9 + index] = label[index]
    index = index + 1
  }
  let contextOffset = 9 + label.length
  info[contextOffset] = usize.toU8(context.length)
  index = 0
  while index < context.length {
    info[contextOffset + 1 + index] = context[index]
    index = index + 1
  }
  return contextOffset + 1 + context.length
}

/// TLS label operations with SHA-256 and 32-byte secrets and transcript hashes.
pub struct TlsHkdfSha256 {}

impl TlsHkdfSha256 {
  /// Writes TLS-labeled key material, or returns a length error without changing output.
  ///
  /// # Details
