//! The sealed operator interfaces of the `Intrinsic` namespace (INTR-007, INTR-008).
//!
//! # Details
//! The compiler embeds this file. It is not a module path: the compiler rejects an import of
//! it, and its public declarations are named only as `Intrinsic.<Name>`. It holds only the operator
//! interfaces, `Ordering`, and the sealed scalar conformances.

pub interface Add<Right, Output> {
  fn add(left: Self, right: Right) -> Output
}

pub interface Subtract<Right, Output> {
  fn subtract(left: Self, right: Right) -> Output
}

pub interface Multiply<Right, Output> {
  fn multiply(left: Self, right: Right) -> Output
}

pub interface Divide<Right, Output> {
  fn divide(left: Self, right: Right) -> Output
}

pub interface Remainder<Right, Output> {
  fn remainder(left: Self, right: Right) -> Output
}

pub interface Negate<Output> {
  fn negate(value: Self) -> Output
}

pub interface BitAnd<Right, Output> {
  fn bitAnd(left: Self, right: Right) -> Output
}

pub interface BitOr<Right, Output> {
  fn bitOr(left: Self, right: Right) -> Output
}

pub interface BitXor<Right, Output> {
  fn bitXor(left: Self, right: Right) -> Output
}

pub interface BitNot<Output> {
  fn bitNot(value: Self) -> Output
}

pub interface Not<Output> {
  fn not(value: Self) -> Output
}

pub interface Equal {
  fn equals(left: &Self, right: &Self) -> bool
}

pub enum Ordering {
  Less,
  Equal,
  Greater,
}

pub interface Order {
  fn compare(left: &Self, right: &Self) -> Ordering
}

impl Add<u8, u8> for u8 { add: Intrinsic.u8Add }
impl Add<u16, u16> for u16 { add: Intrinsic.u16Add }
impl Add<u32, u32> for u32 { add: Intrinsic.u32Add }
impl Add<u64, u64> for u64 { add: Intrinsic.u64Add }
impl Add<usize, usize> for usize { add: Intrinsic.usizeAdd }
impl Add<i8, i8> for i8 { add: Intrinsic.i8Add }
impl Add<i16, i16> for i16 { add: Intrinsic.i16Add }
impl Add<i32, i32> for i32 { add: Intrinsic.i32Add }
impl Add<i64, i64> for i64 { add: Intrinsic.i64Add }
impl Add<isize, isize> for isize { add: Intrinsic.isizeAdd }

impl Order for u8 {
  fn compare(left: &Self, right: &Self) -> Ordering {
    if left.* < right.* { return Ordering.Less }
    if right.* < left.* { return Ordering.Greater }
    return Ordering.Equal
  }
}

impl Order for u16 {
  fn compare(left: &Self, right: &Self) -> Ordering {
    if left.* < right.* { return Ordering.Less }
    if right.* < left.* { return Ordering.Greater }
    return Ordering.Equal
  }
}

