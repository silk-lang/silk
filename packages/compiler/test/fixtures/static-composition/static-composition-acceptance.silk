import silk.allocator {Allocator}
import silk.allocator {OutOfMemoryError}
import silk.allocator {SystemAllocator}
import silk.effect {Effect}
import silk.layout {Layout}

struct SelectionProblem {
  code: i32
}

struct DecodeProblem {
  code: i32
}

service Clock {
  effect fn tick() -> i32 ? &Clock
}

struct FixedClock {}

effect fn fixedTick(self: &FixedClock) -> i32 {
  return 0
}

impl Clock for FixedClock {
  tick: FixedClock.fixedTick
}

interface Decoder<T> {
  fn decode(value: &T) -> i32
}

interface CompleteDecoder<S, Arguments, A, E, ?R> {
  effect<'env> fn decode<'env>(self: &S, arguments: Arguments) -> A ! E ? R
}

struct NumberSchema {
  value: i32
}

fn numberDecode(value: &NumberSchema) -> i32 {
  return value.value
}

effect fn completeNumberDecode(self: &NumberSchema, encoded: i32) -> i32 ! DecodeProblem ? &Clock {
  return self.value + encoded + run Clock.tick()
}

impl Decoder<NumberSchema> for NumberSchema {
  decode: NumberSchema.numberDecode
}

impl CompleteDecoder<NumberSchema, i32, i32, DecodeProblem ? &Clock> for NumberSchema {
  decode: NumberSchema.completeNumberDecode
}

fn pendingComplete<T: CompleteDecoder<T, i32, i32, DecodeProblem ? &Clock>>(value: &T) -> Effect<i32 ! DecodeProblem ? &Clock> {
  return CompleteDecoder.decode(value, 0)
}

struct MappedSchema<S, F: fn<'static>(i32) -> i32> {
  source: S
  transform: F
}

fn mappedDecode<S: Decoder<S>, F: fn<'static>(i32) -> i32>(value: &MappedSchema<S, F>) -> i32 {
  return value.transform(Decoder.decode(&value.source))
}

impl<S: Decoder<S>, F: fn<'static>(i32) -> i32> Decoder<MappedSchema<S, F>> for MappedSchema<S, F> {
  decode: MappedSchema.mappedDecode
}

fn add(value: i32, amount: i32) -> i32 {
  return value + amount
}

fn makeTransform(amount: i32) -> some<F: fn<'static>(i32) -> i32> F {
  return add(amount)
}

fn exactTransform() -> typeof(add) {
  return add
}

struct Guard {
  value: i32
  storage: Allocation
}

impl Drop for Guard {
  fn drop(self: &mut Guard) -> () {
    if self.value == 0 {
      let boom = 1 / 0
      return ()
    }
    self.value = 0
    return ()
  }
}

struct Deferred<A, E, ?R, F: once Effect<'static; A ! E ? R>> {
  operation: F
}

fn defer<A, E, ?R, F: once Effect<'static; A ! E ? R>>(operation: F) -> Deferred<A, E, R, F> {
  return Deferred<A, E, R> {operation: move operation}
}

effect fn guarded(guard: Guard) -> i32 {
  return guard.value
}

effect fn delayed(guard: Guard) -> i32 {
  let base = run Effect.suspend(
    effect {
      return 0
    },
  )
  return base + guard.value
}

effect fn selectionFailure() -> i32 ! SelectionProblem {
  fail SelectionProblem {code: 20}
}

effect fn recoverSelection(problem: SelectionProblem) -> i32 {
  return problem.code
}

effect fn decodeFailure() -> i32 ! DecodeProblem {
  fail DecodeProblem {code: 30}
}

effect fn recoverDecode(problem: DecodeProblem) -> i32 {
  return problem.code
}

struct RunRequest {
  value: i32
}

struct HelpRequest {}

struct SelectionFailureRequest {}

struct DecodeFailureRequest {}

struct UncalledCleanupRequest {
  value: i32
}

struct CalledCleanupRequest {
  value: i32
}

struct SuspensionRequest {
  value: i32
}

struct ExecuteAction {
  value: i32
}

struct InspectAction {
  value: i32
}

struct FirstRoute {}

struct SecondRoute {}

struct RouteLeaf {
  help: i32
  choice: i32
}

struct RouteBranch<L, R> {
  left: L
  right: R
}

fn routes() -> RouteBranch<RouteLeaf, RouteBranch<RouteLeaf, RouteLeaf>> {
  return RouteBranch<RouteLeaf, RouteBranch<RouteLeaf, RouteLeaf>> {
    left: RouteLeaf {help: 4, choice: 0},
    right: RouteBranch<RouteLeaf, RouteLeaf> {
      left: RouteLeaf {help: 3, choice: 1},
      right: RouteLeaf {help: 3, choice: 2},
    },
  }
}

fn routeHelp(tree: &RouteBranch<RouteLeaf, RouteBranch<RouteLeaf, RouteLeaf>>) -> i32 {
  return tree.left.help + tree.right.left.help + tree.right.right.help
}

fn selectSuccess() -> RunRequest | HelpRequest | SelectionFailureRequest | DecodeFailureRequest | UncalledCleanupRequest | CalledCleanupRequest | SuspensionRequest {
  return RunRequest {value: 40}
}

fn applicationHandler(action: ExecuteAction | InspectAction) -> i32 {
  return match move action {
    ExecuteAction {value} => value
    InspectAction {value} => value
  }
}

fn chooseRoute(choice: i32) -> FirstRoute | SecondRoute {
  if choice == 0 {
    return FirstRoute {}
  }
  return SecondRoute {}
}

fn executeMapped<S: Decoder<S>, F: fn<'static>(i32) -> i32>(schema: &MappedSchema<S, F>) -> ExecuteAction {
  return ExecuteAction {value: schema.transform(Decoder.decode(&schema.source))}
}

fn inspectMapped<S: Decoder<S>, F: fn<'static>(i32) -> i32>(schema: &MappedSchema<S, F>) -> InspectAction {
  return InspectAction {value: schema.transform(Decoder.decode(&schema.source))}
}

fn helpCase() -> i32 {
  let tree = routes()
  return routeHelp(&tree)
}

fn runCase(value: i32) -> i32 {
  let tree = routes()
  let leftSchema = MappedSchema<NumberSchema> {
    source: NumberSchema {value: value},
    transform: add(2),
  }
  let rightSchema = MappedSchema<NumberSchema> {
    source: NumberSchema {value: value},
    transform: add(3),
  }
  let opaque = makeTransform(1)
  let exact = exactTransform()
  let clock = FixedClock {}
  let complete = run Effect.catchAll(
    pendingComplete<NumberSchema>(&leftSchema.source)
      |> Effect.provide(&clock),
    recoverDecode,
  )
  let action = match move chooseRoute(tree.left.choice) {
    FirstRoute {} => executeMapped(&leftSchema)
    SecondRoute {} => inspectMapped(&rightSchema)
  }
  let handled = applicationHandler(move action)
  return opaque(exact(handled, complete - value) - 1)
}

effect fn uncalledCleanupCase(value: i32) -> i32 ! OutOfMemoryError ? &mut Allocator {
  let storage = run Allocator.allocate(Layout.of<i32>())
  let guard = Guard {value: value, storage: move storage}
  let deferred = defer(guarded(move guard))
  return 40
}

effect fn calledCleanupCase(value: i32) -> i32 ! OutOfMemoryError ? &mut Allocator {
  let storage = run Allocator.allocate(Layout.of<i32>())
  let guard = Guard {value: value, storage: move storage}
  let deferred = defer(guarded(move guard))
  return run deferred.operation
}

effect fn suspensionCase(value: i32) -> i32 ! OutOfMemoryError ? &mut Allocator {
  let storage = run Allocator.allocate(Layout.of<i32>())
  let guard = Guard {value: value, storage: move storage}
  let deferred = defer(delayed(move guard))
  return run deferred.operation
}

effect fn dispatch(
  request: RunRequest | HelpRequest | SelectionFailureRequest | DecodeFailureRequest | UncalledCleanupRequest | CalledCleanupRequest | SuspensionRequest,
) -> i32 ! OutOfMemoryError ? &mut Allocator {
  return match move request {
    RunRequest {value} => runCase(value)
    HelpRequest {} => helpCase()
    SelectionFailureRequest {} => run Effect.catchAll(selectionFailure(), recoverSelection)
    DecodeFailureRequest {} => run Effect.catchAll(decodeFailure(), recoverDecode)
    UncalledCleanupRequest {value} => run uncalledCleanupCase(value)
    CalledCleanupRequest {value} => run calledCleanupCase(value)
    SuspensionRequest {value} => run suspensionCase(value)
  }
}

effect fn recoverOutOfMemory(error: OutOfMemoryError) -> i32 {
  return 0
}

pub fn main() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run Effect.catchAll(
    dispatch(selectSuccess())
      |> Effect.provideMut(&mut allocator),
    recoverOutOfMemory,
  )
}
