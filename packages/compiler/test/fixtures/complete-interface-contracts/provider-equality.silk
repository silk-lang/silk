struct DecodeError {}
service Clock {}
struct Schema {}
struct Other {}

interface Decoder<Arguments, A, E, ?R> {
  effect<'env> fn decode<'env>(self: &Self, encoded: Arguments) -> A ! E ? R
}

fn matching<T: Decoder<i32, bool, DecodeError ? &Clock>>(value: T) -> T {
  return move value
}

fn main() -> Other {
  return matching<Other>(Other {})
}
