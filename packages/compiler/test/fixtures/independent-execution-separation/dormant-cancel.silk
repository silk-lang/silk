// Compiler fixture: cancellation after onSuspend returns and before a retained Wake.
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.execution { Execution, Wake }
import silk.shared { Shared }

struct Empty {}
struct Armed { wake: Wake }
struct State {
  slot: Empty | Armed
  ready: i32
  bodyDrops: i32
  guardDrops: i32
  frameDrops: i32
  endpointDrops: i32
  cleanupOrder: i32
}
struct Guard { state: Shared<State> }
struct BodyToken { state: Shared<State> }
struct FrameToken { state: Shared<State> }
struct Endpoint { state: Shared<State> }

fn install(self: &mut State, wake: Wake) -> () {
  let previous = Intrinsic.replace(self.slot, Armed { wake: move wake })
  drop previous
  return ()
}
fn take(self: &mut State) -> Empty | Armed {
  return Intrinsic.replace(self.slot, Empty {})
}
fn mark(self: &mut State) -> () { self.ready = self.ready + 1 return () }
fn markBody(self: &mut State) -> () {
  self.bodyDrops = self.bodyDrops + 1
  self.cleanupOrder = self.cleanupOrder * 4
  return ()
}
fn markFrame(self: &mut State) -> () {
  self.frameDrops = self.frameDrops + 1
  self.cleanupOrder = self.cleanupOrder * 4 + 1
  return ()
}
fn markGuard(self: &mut State) -> () {
  self.guardDrops = self.guardDrops + 1
  self.cleanupOrder = self.cleanupOrder * 4 + 2
  return ()
}
fn markEndpoint(self: &mut State) -> () {
  self.endpointDrops = self.endpointDrops + 1
  self.cleanupOrder = self.cleanupOrder * 4 + 3
  return ()
}
fn read(self: &State) -> i32 {
  // The four two-bit event codes make every permutation distinct in a native exit status.
  if self.cleanupOrder != 147 { return self.cleanupOrder }
  return self.ready * 10000 + self.bodyDrops * 1000 + self.guardDrops * 100 + self.frameDrops * 10 + self.endpointDrops
}

impl Drop for Guard {
  fn drop(self: &mut Guard) -> () {
    let recorded = Shared.withMut(&self.state, markGuard)
    return ()
  }
}
impl Drop for FrameToken {
  fn drop(self: &mut FrameToken) -> () {
    let recorded = Shared.withMut(&self.state, markFrame)
    return ()
  }
}
impl Drop for BodyToken {
  fn drop(self: &mut BodyToken) -> () {
    let recorded = Shared.withMut(&self.state, markBody)
    return ()
  }
}
impl Drop for Endpoint {
  fn drop(self: &mut Endpoint) -> () {
    let recorded = Shared.withMut(&self.state, markEndpoint)
    return ()
  }
}

fn register(wake: Wake, state: Shared<State>) -> Guard {
  let installed = Shared.withMut(&state, install(move wake))
  return Guard { state: move state }
}
effect fn body(state: Shared<State>, bodyToken: BodyToken) -> i32 {
  let frameState = Shared.clone<State>(&state)
  let frame = FrameToken { state: move frameState }
  let registrationState = Shared.clone<State>(&state)
  let registration = register(move registrationState)
  run Execution.park(move registration)
  drop frame
  drop bodyToken
  drop state
  return 1
}
fn ready(endpoint: &Endpoint) -> () { return Shared.withMut(&endpoint.state, mark) }

struct Stored { execution: Intrinsic.Execution<i32> }
struct Owner { slot: Empty | Stored }
fn complete(owner: &mut Owner, value: i32) -> () { return () }
fn suspend(owner: &mut Owner, execution: Intrinsic.Execution<i32>) -> () {
  let previous = Intrinsic.replace(owner.slot, Stored { execution: move execution })
  drop previous
  return ()
}
effect fn drive(execution: Intrinsic.Execution<i32>, owner: &mut Owner) -> () {
  return run Execution.drive(move execution, move owner, complete, suspend)
}
fn signal(selected: Empty | Armed) -> () {
  return match move selected {
    Empty {} => ()
    Armed { wake } => Execution.wake(move wake)
  }
}

effect fn program() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let state = run Shared.make<State>(State {
    slot: Empty {},
    ready: 0,
    bodyDrops: 0,
    guardDrops: 0,
    frameDrops: 0,
    endpointDrops: 0,
    cleanupOrder: 0
  })
    |> Effect.provideMut<Allocator>(&mut allocator)
  let bodyState = Shared.clone<State>(&state)
  let endpointState = Shared.clone<State>(&state)
  let bodyTokenState = Shared.clone<State>(&state)
  let bodyToken = BodyToken { state: move bodyTokenState }
  let endpoint = Endpoint { state: move endpointState }
  let execution = run Execution.make(body(move bodyState, move bodyToken), move endpoint, ready)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut owner = Owner { slot: Empty {} }
  run drive(move execution, &mut owner)
  let dormant = Intrinsic.replace(owner.slot, Empty {})
  drop dormant
  let retained = Shared.withMut(&state, take)
  signal(move retained)
  let observed = Shared.with<State, i32>(&state, read)
  drop owner
  drop state
  return observed
}
effect fn recover(error: OutOfMemoryError) -> i32 { return -1 }
pub fn main() -> i32 { return run Effect.catchAll(program(), recover) }
