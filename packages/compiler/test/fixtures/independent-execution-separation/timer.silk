// Compiler fixture: same-thread Timer/Scheduler pressure, not a canonical public API.
import silk.allocator { Allocator, OutOfMemoryError, SystemAllocator }
import silk.effect { Effect }
import silk.execution { Execution, Wake }
import silk.layout { Layout }
import silk.shared { Shared }

struct Empty {}
struct Armed { wake: Wake }
struct TimerReactor { slot: Empty | Armed fires: i32 }
struct TimerGuard { reactor: Shared<TimerReactor> }
struct ChildResult { value: i32 }
fn install(self: &mut TimerReactor, wake: Wake) -> () {
  let previous = Intrinsic.replace(self.slot, Armed { wake: move wake })
  drop previous
  return ()
}
fn extract(self: &mut TimerReactor) -> Empty | Armed {
  self.fires = self.fires + 1
  return Intrinsic.replace(self.slot, Empty {})
}
fn registerTimer(wake: Wake, reactor: Shared<TimerReactor>) -> TimerGuard {
  let installed = Shared.withMut(&reactor, install(move wake))
  return TimerGuard { reactor: move reactor }
}
effect fn timerChild(reactor: Shared<TimerReactor>) -> ChildResult {
  let registration = registerTimer(move reactor)
  run Execution.park(move registration)
  return ChildResult { value: 40 }
}
fn poll(reactor: &Shared<TimerReactor>) -> () {
  let selected = Shared.withMut(reactor, extract)
  return match move selected {
    Empty {} => ()
    Armed { wake } => Execution.wake(move wake)
  }
}

struct OuterEmpty {}
struct OuterArmed { wake: Wake }
struct WakeSlot { slot: OuterEmpty | OuterArmed childSignals: i32 }
struct SchedulerEndpoint { wakeSlot: Shared<WakeSlot> }
struct SchedulerGuard { wakeSlot: Shared<WakeSlot> }
fn installOuter(self: &mut WakeSlot, wake: Wake) -> () {
  let previous = Intrinsic.replace(self.slot, OuterArmed { wake: move wake })
  drop previous
  return ()
}
fn takeOuter(self: &mut WakeSlot) -> OuterEmpty | OuterArmed {
  self.childSignals = self.childSignals + 1
  return Intrinsic.replace(self.slot, OuterEmpty {})
}
fn childReady(endpoint: &SchedulerEndpoint) -> () {
  let selected = Shared.withMut(&endpoint.wakeSlot, takeOuter)
  return match move selected {
    OuterEmpty {} => ()
    OuterArmed { wake } => Execution.wake(move wake)
  }
}
fn registerOuter(wake: Wake, wakeSlot: Shared<WakeSlot>) -> SchedulerGuard {
  let installed = Shared.withMut(&wakeSlot, installOuter(move wake))
  return SchedulerGuard { wakeSlot: move wakeSlot }
}
struct ChildStored { execution: Intrinsic.Execution<ChildResult> }
struct SchedulerState {
  child: Empty | ChildStored
  result: i32
  sibling: i32
  wakeSlot: Shared<WakeSlot>
}
fn childComplete(owner: &mut SchedulerState, result: ChildResult) -> () {
  let ChildResult { value } = move result
  owner.result = value
  return ()
}
fn childSuspend(
  owner: &mut SchedulerState,
  execution: Intrinsic.Execution<ChildResult>
) -> () {
  let previous = Intrinsic.replace(owner.child, ChildStored { execution: move execution })
  drop previous
  return ()
}
fn completeShared(owner: &mut Shared<SchedulerState>, result: ChildResult) -> () {
  return Shared.withMut(&owner.*, childComplete(move result))
}
fn suspendShared(
  owner: &mut Shared<SchedulerState>,
  execution: Intrinsic.Execution<ChildResult>
) -> () {
  return Shared.withMut(&owner.*, childSuspend(move execution))
}
fn takeChild(owner: &mut SchedulerState) -> Empty | ChildStored {
  return Intrinsic.replace(owner.child, Empty {})
}
fn progressSibling(owner: &mut SchedulerState) -> () { owner.sibling = 2 return () }
fn readScheduler(owner: &SchedulerState) -> i32 { return owner.result + owner.sibling }
effect fn finishScheduler(owner: Shared<SchedulerState>, result: i32) -> i32 {
  drop owner
  return result
}
effect fn driveChild(
  execution: Intrinsic.Execution<ChildResult>,
  owner: &mut Shared<SchedulerState>
) -> () {
  return run Execution.drive(move execution, move owner, completeShared, suspendShared)
}
effect fn driveSelected(
  selected: Empty | ChildStored,
  owner: &mut Shared<SchedulerState>
) -> () {
  return match move selected {
    Empty {} => ()
    ChildStored { execution } => run driveChild(move execution, move owner)
  }
}
effect fn schedulerOuter(
  scheduler: Shared<SchedulerState>,
  wakeSlot: Shared<WakeSlot>
) -> i32 {
  let mut state = move scheduler
  let progressed = Shared.withMut(&state, progressSibling)
  let registration = registerOuter(move wakeSlot)
  run Execution.park(move registration)
  let result = Shared.with(&state, readScheduler)
  return run finishScheduler(move state, result)
}

struct OuterReady { notifications: i32 }
fn markOuterReady(self: &mut OuterReady) -> () {
  self.notifications = self.notifications + 1
  return ()
}
fn outerReady(state: &Shared<OuterReady>) -> () {
  return Shared.withMut(state, markOuterReady)
}
fn readOuterReady(self: &OuterReady) -> i32 { return self.notifications }
fn readChildSignals(self: &WakeSlot) -> i32 { return self.childSignals }

struct OuterStored { execution: Intrinsic.Execution<i32> }
struct ResultOwner { slot: Empty | OuterStored result: i32 }
fn outerComplete(owner: &mut ResultOwner, result: i32) -> () {
  owner.result = result
  return ()
}
fn outerSuspend(owner: &mut ResultOwner, execution: Intrinsic.Execution<i32>) -> () {
  let previous = Intrinsic.replace(owner.slot, OuterStored { execution: move execution })
  drop previous
  return ()
}
effect fn driveOuter(execution: Intrinsic.Execution<i32>, owner: &mut ResultOwner) -> () {
  return run Execution.drive(move execution, move owner, outerComplete, outerSuspend)
}
effect fn driveOuterStored(selected: Empty | OuterStored, owner: &mut ResultOwner) -> () {
  return match move selected {
    Empty {} => ()
    OuterStored { execution } => run driveOuter(move execution, move owner)
  }
}

struct Prepared {
  reactor: Shared<TimerReactor>
  wakeSlot: Shared<WakeSlot>
  readiness: Shared<OuterReady>
  scheduler: Shared<SchedulerState>
  outer: Intrinsic.Execution<i32>
}
effect fn prepare() -> Prepared ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let reactor = run Shared.make<TimerReactor>(TimerReactor { slot: Empty {}, fires: 0 })
    |> Effect.provideMut<Allocator>(&mut allocator)
  let wakeSlot = run Shared.make<WakeSlot>(WakeSlot { slot: OuterEmpty {}, childSignals: 0 })
    |> Effect.provideMut<Allocator>(&mut allocator)
  let readiness = run Shared.make<OuterReady>(OuterReady { notifications: 0 })
    |> Effect.provideMut<Allocator>(&mut allocator)
  let childEndpoint = SchedulerEndpoint { wakeSlot: Shared.clone(&wakeSlot) }
  let childReactor = Shared.clone(&reactor)
  let childBody = timerChild(move childReactor)
  let child = run Execution.make(move childBody, move childEndpoint, childReady)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let schedulerState = SchedulerState {
    child: Empty {},
    result: 0,
    sibling: 0,
    wakeSlot: Shared.clone(&wakeSlot)
  }
  let scheduler = run Shared.make<SchedulerState>(move schedulerState)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut schedulerOwner = Shared.clone(&scheduler)
  run driveChild(move child, &mut schedulerOwner)
  drop schedulerOwner
  let outerBody = schedulerOuter(Shared.clone(&scheduler), Shared.clone(&wakeSlot))
  let outer = run Execution.make(move outerBody, Shared.clone(&readiness), outerReady)
    |> Effect.provideMut<Allocator>(&mut allocator)
  return Prepared {
    reactor: move reactor,
    wakeSlot: move wakeSlot,
    readiness: move readiness,
    scheduler: move scheduler,
    outer: move outer
  }
}

effect fn successfulTimer() -> i32 ! OutOfMemoryError {
  let prepared = run prepare()
  return match move prepared {
    Prepared { reactor, wakeSlot, readiness, scheduler, outer } => run successfulPrepared(
      move reactor, move wakeSlot, move readiness, move scheduler, move outer
    )
  }
}
effect fn successfulPrepared(
  reactor: Shared<TimerReactor>,
  wakeSlot: Shared<WakeSlot>,
  readiness: Shared<OuterReady>,
  scheduler: Shared<SchedulerState>,
  outer: Intrinsic.Execution<i32>
) -> i32 {
  let mut owner = ResultOwner { slot: Empty {}, result: 0 }
  run driveOuter(move outer, &mut owner)
  poll(&reactor)
  let child = Shared.withMut(&scheduler, takeChild)
  let mut schedulerOwner = move scheduler
  run driveSelected(move child, &mut schedulerOwner)
  drop schedulerOwner
  let selected = Intrinsic.replace(owner.slot, Empty {})
  run driveOuterStored(move selected, &mut owner)
  let outerNotifications = Shared.with(&readiness, readOuterReady)
  let childSignals = Shared.with(&wakeSlot, readChildSignals)
  drop readiness
  drop wakeSlot
  drop reactor
  if outerNotifications != 1 { return -10 }
  if childSignals != 1 { return -11 }
  return owner.result
}

effect fn cancelledTimer() -> i32 ! OutOfMemoryError {
  let prepared = run prepare()
  return match move prepared {
    Prepared { reactor, wakeSlot, readiness, scheduler, outer } => run cancelledPrepared(
      move reactor, move wakeSlot, move readiness, move scheduler, move outer
    )
  }
}
effect fn cancelledPrepared(
  reactor: Shared<TimerReactor>,
  wakeSlot: Shared<WakeSlot>,
  readiness: Shared<OuterReady>,
  scheduler: Shared<SchedulerState>,
  outer: Intrinsic.Execution<i32>
) -> i32 {
  let mut owner = ResultOwner { slot: Empty {}, result: 0 }
  run driveOuter(move outer, &mut owner)
  drop scheduler
  drop wakeSlot
  let dormant = Intrinsic.replace(owner.slot, Empty {})
  drop dormant
  poll(&reactor)
  let outerNotifications = Shared.with(&readiness, readOuterReady)
  drop readiness
  drop reactor
  if outerNotifications != 0 { return -20 }
  return owner.result
}

struct ExhaustedAllocator {}
effect fn refuse(self: &mut ExhaustedAllocator, layout: Layout) -> Allocation ! OutOfMemoryError {
  drop layout
  fail OutOfMemoryError {}
}
impl Allocator for ExhaustedAllocator { allocate: ExhaustedAllocator.refuse }
effect fn failedPreparation() -> i32 ! OutOfMemoryError {
  let mut allocator = ExhaustedAllocator {}
  let reactor = run Shared.make<TimerReactor>(TimerReactor { slot: Empty {}, fires: 0 })
    |> Effect.provideMut<Allocator>(&mut allocator)
  drop reactor
  return 1
}
effect fn preparationFailed(error: OutOfMemoryError) -> i32 { return 7 }
effect fn recover(error: OutOfMemoryError) -> i32 { return -100 }
effect fn program() -> i32 ! OutOfMemoryError {
  let success = run successfulTimer()
  let cancelled = run cancelledTimer()
  let preparation = run Effect.catchAll(failedPreparation(), preparationFailed)
  if cancelled != 0 { return -20 }
  if preparation != 7 { return -30 }
  return success
}
pub fn main() -> i32 { return run Effect.catchAll(program(), recover) }
