import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.effect {Effect}
import silk.host_input {HostInput, HostInputError}
import silk.layout {Layout}
import silk.option {Option}

unsafe extern "C" fn audit_body() -> i32

unsafe extern "C" fn audit_drop() -> ()

pub struct AuditError {
  storage: Allocation
}

impl Drop for AuditError {
  fn drop(self: &mut AuditError) -> () {
    unsafe audit_drop()
  }
}

fn ownedInput(value: Option<Bytes>) -> bool {
  return match move value {
    Option<Bytes>.None => false
    Option<Bytes>.Some {value: bytes} => {
      let view = Bytes.asSlice(&bytes)
      return view.length == 5 && view[0] == 111 && view[4] == 100
    }
  }
}

pub effect fn main() -> i32 ! AuditError | HostInputError | OutOfMemoryError ? &mut HostInput {
  let failing = unsafe audit_body()
  let count = run HostInput.argumentCount()
  if count != 2 {
    return 3
  }
  let mut allocator = Allocator.systemAllocatorProvider()
  let argument = run HostInput.argument(1)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let variable = run HostInput.variableNamed("AUDIT")
    |> Effect.provideMut<Allocator>(&mut allocator)
  if !ownedInput(move argument) || !ownedInput(move variable) {
    return 4
  }
  let first = run HostInput.workingDirectory()
    |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run HostInput.workingDirectory()
    |> Effect.provideMut<Allocator>(&mut allocator)
  if Bytes.length(&first) != 7 || Bytes.length(&second) != 6 {
    return 5
  }
  if failing != 0 {
    let storage = run Allocator.allocate(Layout.of<i32>())
      |> Effect.provideMut<Allocator>(&mut allocator)
    fail AuditError {storage: move storage}
  }
  return 17
}
