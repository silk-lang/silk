import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.fiber { Fiber, Cancelled, Failure, Outcome, Success }
import silk.local_scheduler { LocalScheduler, StalledError }
import silk.monotonic_clock { MonotonicClock }
import silk.scheduler { Scheduler, TaskIdExhaustedError }
import silk.shared { Shared }
import silk.system_clock { SystemClock }
import silk.system_clock { Instant }

struct ParentClock { mark: Instant }
effect fn parentNow(self: &mut ParentClock) -> Instant {
  return SystemClock.make(SystemClock.seconds(&self.mark), SystemClock.nanoseconds(&self.mark))
}
effect fn parentResolution(self: &mut ParentClock) -> u64 { return 1 }
effect fn parentWaitUntil(self: &mut ParentClock, deadline: Instant) -> () {
  self.mark = move deadline
  return ()
}
effect fn parentWaitFor(self: &mut ParentClock, duration: u64) -> () {
  let deadline = MonotonicClock.deadlineAfter(&self.mark, duration)
  return run parentWaitUntil(move self, move deadline)
}
impl MonotonicClock for ParentClock {
  now: ParentClock.parentNow
  getResolution: ParentClock.parentResolution
  waitUntil: ParentClock.parentWaitUntil
  waitFor: ParentClock.parentWaitFor
}

struct ChildProblem { code: i32 }

struct Trace { next: i32 valid: bool }

fn record(trace: &mut Trace, expected: i32) -> i32 {
  if trace.next != expected { trace.valid = false }
  trace.next = trace.next + 1
  return 0
}

fn mark(trace: &Shared<Trace>, expected: i32) -> () {
  let changed = Shared<Trace>.withMut<i32>(trace, record(expected))
  return ()
}

fn firstForkReturned(trace: &Shared<Trace>) -> () { return mark(trace, 1) }
fn firstSiblingActivated(trace: &Shared<Trace>) -> () { return mark(trace, 2) }
fn secondForkReturned(trace: &Shared<Trace>) -> () { return mark(trace, 3) }
fn secondSiblingActivated(trace: &Shared<Trace>) -> () { return mark(trace, 4) }
fn thirdForkReturned(trace: &Shared<Trace>) -> () { return mark(trace, 5) }
fn thirdSiblingActivated(trace: &Shared<Trace>) -> () { return mark(trace, 6) }
fn fifoRootTerminating(trace: &Shared<Trace>) -> () { return mark(trace, 7) }

fn rootBeforeYield(trace: &Shared<Trace>) -> () { return mark(trace, 8) }
fn yieldingChildStarted(trace: &Shared<Trace>) -> () { return mark(trace, 9) }
fn rootBetweenYields(trace: &Shared<Trace>) -> () { return mark(trace, 10) }
fn yieldingChildResumedOnce(trace: &Shared<Trace>) -> () { return mark(trace, 11) }
fn rootAfterYields(trace: &Shared<Trace>) -> () { return mark(trace, 12) }
fn yieldingChildResumedTwice(trace: &Shared<Trace>) -> () { return mark(trace, 13) }
fn yieldingChildJoined(trace: &Shared<Trace>) -> () { return mark(trace, 14) }

fn completedChildStarted(trace: &Shared<Trace>) -> () { return mark(trace, 15) }
fn beforeCompletedJoin(trace: &Shared<Trace>) -> () { return mark(trace, 16) }
fn afterCompletedJoin(trace: &Shared<Trace>) -> () { return mark(trace, 17) }

fn nestedStarted(trace: &Shared<Trace>) -> () { return mark(trace, 18) }
fn nestedForkReturned(trace: &Shared<Trace>) -> () { return mark(trace, 19) }
fn nestedLeafStarted(trace: &Shared<Trace>) -> () { return mark(trace, 20) }
fn nestedLeafJoined(trace: &Shared<Trace>) -> () { return mark(trace, 21) }
fn nestedFailureObserved(trace: &Shared<Trace>) -> () { return mark(trace, 22) }
fn cancelledChildActivated(trace: &Shared<Trace>) -> () {
  traceFailure(trace)
  return ()
}
fn cancelledOutcomeObserved(trace: &Shared<Trace>) -> () { return mark(trace, 23) }

fn traceFailure(trace: &Shared<Trace>) -> () {
  let changed = Shared<Trace>.withMut<i32>(trace, invalidate)
  return ()
}

fn invalidate(trace: &mut Trace) -> i32 {
  trace.valid = false
  return 0
}

fn traceAccepted(trace: &Trace) -> bool { return trace.valid && trace.next == 24 }

effect fn firstSibling(trace: Shared<Trace>) -> i32 {
  firstSiblingActivated(&trace)
  drop trace
  return 1
}

effect fn secondSibling(trace: Shared<Trace>) -> i32 {
  secondSiblingActivated(&trace)
  drop trace
  return 2
}

effect fn thirdSibling(trace: Shared<Trace>) -> i32 {
  thirdSiblingActivated(&trace)
  drop trace
  return 3
}

effect fn fifoRoot(trace: Shared<Trace>) -> i32
! OutOfMemoryError | TaskIdExhaustedError
? &mut Scheduler | &mut MonotonicClock {
  let firstTrace = Shared<Trace>.clone(&trace)
  let first = run Fiber<i32, never>.forkChild(firstSibling(move firstTrace))
  drop first
  firstForkReturned(&trace)
  let secondTrace = Shared<Trace>.clone(&trace)
  let second = run Fiber<i32, never>.forkChild(secondSibling(move secondTrace))
  drop second
  secondForkReturned(&trace)
  let thirdTrace = Shared<Trace>.clone(&trace)
  let third = run Fiber<i32, never>.forkChild(thirdSibling(move thirdTrace))
  drop third
  thirdForkReturned(&trace)
  run Fiber.yieldNow()
  fifoRootTerminating(&trace)
  drop trace
  return 6
}

effect fn yieldingChild(trace: Shared<Trace>) -> i32 {
  yieldingChildStarted(&trace)
  run Fiber.yieldNow()
  yieldingChildResumedOnce(&trace)
  run Fiber.yieldNow()
  yieldingChildResumedTwice(&trace)
  drop trace
  return 20
}

effect fn yieldingRoot(trace: Shared<Trace>) -> i32
! OutOfMemoryError | TaskIdExhaustedError | Cancelled
? &mut Scheduler | &mut MonotonicClock {
  let childTrace = Shared<Trace>.clone(&trace)
  let child = run Fiber<i32, never>.forkChild(yieldingChild(move childTrace))
  rootBeforeYield(&trace)
  run Fiber.yieldNow()
  rootBetweenYields(&trace)
  run Fiber.yieldNow()
  rootAfterYields(&trace)
  let value = run Fiber<i32, never>.join(move child)
  yieldingChildJoined(&trace)
  drop trace
  return value
}

effect fn completedChild(trace: Shared<Trace>) -> i32 {
  completedChildStarted(&trace)
  drop trace
  return 9
}

effect fn completionBeforeJoinRoot(trace: Shared<Trace>) -> i32
! OutOfMemoryError | TaskIdExhaustedError | Cancelled
? &mut Scheduler | &mut MonotonicClock {
  let childTrace = Shared<Trace>.clone(&trace)
  let child = run Fiber<i32, never>.forkChild(completedChild(move childTrace))
  run Fiber.yieldNow()
  beforeCompletedJoin(&trace)
  let value = run Fiber<i32, never>.join(move child)
  afterCompletedJoin(&trace)
  drop trace
  return value
}

effect fn nestedLeaf(trace: Shared<Trace>) -> i32 {
  nestedLeafStarted(&trace)
  drop trace
  return 7
}

effect fn nestedFailure(trace: Shared<Trace>) -> i32
! ChildProblem | OutOfMemoryError | TaskIdExhaustedError | Cancelled
? &mut Scheduler | &mut MonotonicClock {
  nestedStarted(&trace)
  let childTrace = Shared<Trace>.clone(&trace)
  let child = run Fiber<i32, never>.forkChild(nestedLeaf(move childTrace))
  nestedForkReturned(&trace)
  let value = run Fiber<i32, never>.join(move child)
  nestedLeafJoined(&trace)
  drop trace
  fail ChildProblem { code: value }
}

effect fn recoverNestedFailure(
  error: ChildProblem
    | OutOfMemoryError
    | TaskIdExhaustedError
    | Cancelled,
  trace: Shared<Trace>,
) -> i32 {
  return match move error {
    ChildProblem { code } => observeNestedFailure(code, move trace)
    OutOfMemoryError {} => dropTraceAndReturn(move trace, -1)
    TaskIdExhaustedError {} => dropTraceAndReturn(move trace, -2)
    Cancelled {} => dropTraceAndReturn(move trace, -3)
  }
}

fn dropTraceAndReturn(trace: Shared<Trace>, value: i32) -> i32 { drop trace return value }

fn observeNestedFailure(code: i32, trace: Shared<Trace>) -> i32 {
  nestedFailureObserved(&trace)
  drop trace
  return code
}

effect fn nestedRoot(trace: Shared<Trace>) -> i32
! OutOfMemoryError | TaskIdExhaustedError
? &mut Scheduler | &mut MonotonicClock {
  let failureTrace = Shared<Trace>.clone(&trace)
  let child = run Fiber<
    i32,
    ChildProblem
      | OutOfMemoryError
      | TaskIdExhaustedError
      | Cancelled,
  >.forkChild(nestedFailure(move failureTrace))
  return run Effect.catchAll(
    Fiber<
      i32,
      ChildProblem
        | OutOfMemoryError
        | TaskIdExhaustedError
        | Cancelled,
    >.join(move child),
    recoverNestedFailure(move trace),
  )
}

effect fn cancelledChild(trace: Shared<Trace>) -> i32 {
  cancelledChildActivated(&trace)
  drop trace
  return 5
}

effect fn escapeCancelledChild(trace: Shared<Trace>) -> Fiber<i32, never>
! OutOfMemoryError | TaskIdExhaustedError
? &mut Scheduler | &mut MonotonicClock {
  return run Fiber<i32, never>.forkChild(cancelledChild(move trace))
}

fn isCancelled(outcome: Outcome<i32, never>, trace: Shared<Trace>) -> bool {
  let Outcome<i32, never> { value } = move outcome
  return match move value {
    Success<i32> { value: success } => dropTraceAndFalse(move trace)
    Failure<never> { error } => move error
    Cancelled {} => recordCancellation(move trace)
  }
}

fn dropTraceAndFalse(trace: Shared<Trace>) -> bool { drop trace return false }

fn recordCancellation(trace: Shared<Trace>) -> bool {
  cancelledOutcomeObserved(&trace)
  drop trace
  return true
}

effect fn observeCancelled(fiber: Fiber<i32, never>, trace: Shared<Trace>) -> bool
? &mut Scheduler | &mut MonotonicClock {
  return isCancelled(run Fiber<i32, never>.await(move fiber), move trace)
}

effect fn scenario() -> i32
! OutOfMemoryError | TaskIdExhaustedError | Cancelled | StalledError
? &mut MonotonicClock {
  let mut scheduler = LocalScheduler.make()
  let mut allocator = Allocator.systemAllocatorProvider()
  let trace = run Shared<Trace>.make(Trace { next: 1, valid: true })
    |> Effect.provideMut<Allocator>(&mut allocator)
  let fifoTrace = Shared<Trace>.clone(&trace)
  let fifo = run LocalScheduler.execute(&mut scheduler, fifoRoot(move fifoTrace))
  let yieldingTrace = Shared<Trace>.clone(&trace)
  let yielded = run LocalScheduler.execute(&mut scheduler, yieldingRoot(move yieldingTrace))
  let completedTrace = Shared<Trace>.clone(&trace)
  let completed = run LocalScheduler.execute(
    &mut scheduler,
    completionBeforeJoinRoot(move completedTrace),
  )
  let nestedTrace = Shared<Trace>.clone(&trace)
  let nested = run LocalScheduler.execute(&mut scheduler, nestedRoot(move nestedTrace))
  let cancelledTrace = Shared<Trace>.clone(&trace)
  let escaped = run LocalScheduler.execute(
    &mut scheduler,
    escapeCancelledChild(move cancelledTrace),
  )
  let observedTrace = Shared<Trace>.clone(&trace)
  let cancelled = run LocalScheduler.execute(
    &mut scheduler,
    observeCancelled(move escaped, move observedTrace),
  )
  let accepted = Shared<Trace>.with<bool>(&trace, traceAccepted)
  drop trace
  if fifo == 6
    && yielded == 20
    && completed == 9
    && nested == 7
    && cancelled
    && accepted { return 42 }
  return -42
}

effect fn recoverScenario(
  error: OutOfMemoryError
    | TaskIdExhaustedError
    | Cancelled
    | StalledError,
) -> i32 {
  drop error
  return -99
}

pub fn main() -> i32 {
  let mut clock = ParentClock { mark: SystemClock.make(0, 0) }
  let program = Effect.catchAll(scenario(), recoverScenario)
    |> Effect.provideMut<MonotonicClock>(&mut clock)
  return run move program
}
