import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.execution { Execution, Wake }
import silk.fiber { Fiber, Cancelled, Failure, Outcome, Success }
import silk.local_scheduler { LocalScheduler, StalledError }
import silk.monotonic_clock { MonotonicClock }
import silk.scheduler { Scheduler, TaskIdExhaustedError }
import silk.shared { Shared }
import silk.system_clock { SystemClock }
import silk.system_clock { Instant }

struct ParentClock { mark: Instant }
effect fn parentNow(self: &mut ParentClock) -> Instant {
  return SystemClock.make(SystemClock.seconds(&self.mark), SystemClock.nanoseconds(&self.mark))
}
effect fn parentResolution(self: &mut ParentClock) -> u64 { return 1 }
effect fn parentWaitUntil(self: &mut ParentClock, deadline: Instant) -> () {
  self.mark = move deadline
  return ()
}
effect fn parentWaitFor(self: &mut ParentClock, duration: u64) -> () {
  let deadline = MonotonicClock.deadlineAfter(&self.mark, duration)
  return run parentWaitUntil(move self, move deadline)
}
impl MonotonicClock for ParentClock {
  now: ParentClock.parentNow
  getResolution: ParentClock.parentResolution
  waitUntil: ParentClock.parentWaitUntil
  waitFor: ParentClock.parentWaitFor
}

struct RootProblem { code: i32 }
struct ParkGuard {}

fn successHandleDropped() -> () { return () }
fn completedSiblingHandleDropped() -> () { return () }
fn completedSiblingActivated() -> () { return () }
fn completedSiblingReleased() -> () { return () }
fn successChildActivated() -> () { return () }
fn successLeafActivated() -> () { return () }
fn successChildReleased() -> () { return () }
fn successLeafReleased() -> () { return () }
fn successTerminating() -> () { return () }
fn successReturned() -> () { return () }

fn failureHandleDropped() -> () { return () }
fn failureChildActivated() -> () { return () }
fn failureChildReleased() -> () { return () }
fn failureTerminating() -> () { return () }
fn failureRecovered() -> () { return () }

fn escapedChildActivated() -> () { return () }
fn escapeTerminating() -> () { return () }
fn escapedReturned() -> () { return () }
fn escapedCancelled() -> () { return () }

fn stalledRegistered() -> () { return () }
fn stalledRootReleased() -> () { return () }
fn stalledRecovered() -> () { return () }

fn freshStarted() -> () { return () }
fn freshReturned() -> () { return () }
fn resumedUnexpectedly() -> () { return () }

struct Audit { trace: i32 }

fn record(audit: &mut Audit, kind: i32) -> i32 {
  audit.trace = audit.trace * 10 + kind
  return audit.trace
}

fn read(audit: &Audit) -> i32 { return audit.trace }

struct Lifetime { kind: i32 audit: Shared<Audit> }

impl Drop for Lifetime {
  fn drop(self: &mut Lifetime) -> () {
    let kind = self.kind
    let recorded = Shared.withMut<Audit, i32>(&self.audit, record(kind))
    if self.kind == 1 { successChildReleased() return () }
    if self.kind == 2 { successLeafReleased() return () }
    if self.kind == 3 { failureChildReleased() return () }
    if self.kind == 6 { completedSiblingReleased() return () }
    stalledRootReleased()
    return ()
  }
}

fn neverWake(wake: Wake) -> ParkGuard {
  drop wake
  return ParkGuard {}
}

effect fn parkedLeaf(lifetime: Lifetime) -> i32 {
  successLeafActivated()
  run Execution.park(neverWake)
  drop lifetime
  resumedUnexpectedly()
  return -1
}

effect fn nestedSuccessChild(audit: Shared<Audit>) -> i32
! OutOfMemoryError | TaskIdExhaustedError
? &mut Scheduler | &mut MonotonicClock {
  let lifetime = Lifetime { kind: 1, audit: Shared.clone(&audit) }
  successChildActivated()
  let leaf = run Fiber.forkChild<i32, never>(parkedLeaf(Lifetime {
    kind: 2,
    audit: Shared.clone(&audit),
  }))
  drop leaf
  run MonotonicClock.waitFor(1000000000000)
  drop lifetime
  resumedUnexpectedly()
  return -2
}

effect fn completedSibling(audit: Shared<Audit>) -> i32 {
  let lifetime = Lifetime { kind: 6, audit: move audit }
  completedSiblingActivated()
  drop lifetime
  return 7
}

effect fn failureChild(audit: Shared<Audit>) -> i32
? &mut Scheduler | &mut MonotonicClock {
  let lifetime = Lifetime { kind: 3, audit: move audit }
  failureChildActivated()
  run MonotonicClock.waitFor(1000000000000)
  drop lifetime
  resumedUnexpectedly()
  return -3
}

effect fn escapedChild(audit: Shared<Audit>) -> i32 {
  let lifetime = Lifetime { kind: 4, audit: move audit }
  escapedChildActivated()
  run Execution.park(neverWake)
  drop lifetime
  resumedUnexpectedly()
  return -4
}

effect fn successRoot(audit: Shared<Audit>) -> i32
! OutOfMemoryError | TaskIdExhaustedError
? &mut Scheduler | &mut MonotonicClock {
  let child = run Fiber.forkChild<
    i32,
    OutOfMemoryError | TaskIdExhaustedError,
  >(nestedSuccessChild(Shared.clone(&audit)))
  drop child
  successHandleDropped()
  let completed = run Fiber.forkChild<i32, never>(completedSibling(move audit))
  drop completed
  completedSiblingHandleDropped()
  run Fiber.yieldNow()
  successTerminating()
  return 11
}

effect fn failureRoot(audit: Shared<Audit>) -> i32
! RootProblem | OutOfMemoryError | TaskIdExhaustedError
? &mut Scheduler | &mut MonotonicClock {
  let child = run Fiber.forkChild<i32, never>(failureChild(move audit))
  drop child
  failureHandleDropped()
  run Fiber.yieldNow()
  failureTerminating()
  fail RootProblem { code: 7 }
}

effect fn escapeRoot(audit: Shared<Audit>) -> Fiber<i32, never>
! OutOfMemoryError | TaskIdExhaustedError
? &mut Scheduler | &mut MonotonicClock {
  let child = run Fiber.forkChild<i32, never>(escapedChild(move audit))
  escapeTerminating()
  return move child
}

effect fn stalledRoot(audit: Shared<Audit>) -> i32 ? &mut Scheduler | &mut MonotonicClock {
  let lifetime = Lifetime { kind: 5, audit: move audit }
  stalledRegistered()
  run Execution.park(neverWake)
  drop lifetime
  resumedUnexpectedly()
  return -5
}

effect fn freshRoot() -> i32 ? &mut Scheduler | &mut MonotonicClock {
  freshStarted()
  return 42
}

effect fn recoverFailure(
  error: RootProblem
    | OutOfMemoryError
    | TaskIdExhaustedError
    | StalledError,
) -> i32 {
  return match move error {
    RootProblem { code } => recoverRootProblem(code)
    OutOfMemoryError {} => 0
    TaskIdExhaustedError {} => 0
    StalledError {} => 0
  }
}

fn recoverRootProblem(code: i32) -> i32 {
  if code == 7 { return 1 }
  return 0
}

effect fn recoverStalled(
  error: OutOfMemoryError | StalledError,
) -> i32 {
  return match move error {
    OutOfMemoryError {} => 0
    StalledError {} => 1
  }
}

fn observeEscaped(outcome: Outcome<i32, never>) -> bool {
  let Outcome<i32, never> { value } = move outcome
  return match move value {
    Success<i32> { value: success } => false
    Failure<never> { error } => move error
    Cancelled {} => observeCancelled()
  }
}

fn observeCancelled() -> bool {
  escapedCancelled()
  return true
}

effect fn observeEscapedRoot(fiber: Fiber<i32, never>) -> bool
? &mut Scheduler | &mut MonotonicClock {
  return observeEscaped(run Fiber.await<i32, never>(move fiber))
}

effect fn scenario() -> i32
! OutOfMemoryError | TaskIdExhaustedError | StalledError
? &mut MonotonicClock {
  let mut scheduler = LocalScheduler.make()
  let mut allocator = Allocator.systemAllocatorProvider()
  let audit = run Shared.make<Audit>(Audit { trace: 0 })
    |> Effect.provideMut<Allocator>(&mut allocator)

  let success = run LocalScheduler.execute(
    &mut scheduler,
    successRoot(Shared.clone(&audit)),
  )
  successReturned()

  let failure = run Effect.catchAll(
    LocalScheduler.execute(&mut scheduler, failureRoot(Shared.clone(&audit))),
    recoverFailure,
  )
  failureRecovered()

  let escaped = run LocalScheduler.execute(
    &mut scheduler,
    escapeRoot(Shared.clone(&audit)),
  )
  escapedReturned()
  let cancelled = run LocalScheduler.execute(
    &mut scheduler,
    observeEscapedRoot(move escaped),
  )

  let stalled = run Effect.catchAll(
    LocalScheduler.execute(&mut scheduler, stalledRoot(Shared.clone(&audit))),
    recoverStalled,
  )
  stalledRecovered()

  let fresh = run LocalScheduler.execute(&mut scheduler, freshRoot())
  freshReturned()
  let trace = Shared.with<Audit, i32>(&audit, read)
  drop audit

  if success == 11
    && failure == 1
    && cancelled
    && stalled == 1
    && fresh == 42
    && trace == 61235 { return 42 }
  return -42
}

effect fn recoverScenario(
  error: OutOfMemoryError | TaskIdExhaustedError | StalledError,
) -> i32 {
  drop error
  return -99
}

pub fn main() -> i32 {
  let mut clock = ParentClock { mark: SystemClock.make(0, 0) }
  let program = Effect.catchAll(scenario(), recoverScenario)
    |> Effect.provideMut<MonotonicClock>(&mut clock)
  return run move program
}
