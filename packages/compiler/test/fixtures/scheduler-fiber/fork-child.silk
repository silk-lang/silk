import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.execution { Execution, Wake }
import silk.fiber { Fiber, Cancelled, CompletionCanceller, CompletionProducer, Failure, Outcome, PreparedFiber, Success }
import silk.monotonic_clock { MonotonicClock }
import silk.result { Result }
import silk.scheduler { Scheduler, NoRequest, NoSubmission, PendingPublication, PendingRequest, PendingSubmission, PreparedTask, PublicationResponse, ResponsePublished, ResponseRejected, ResponseWaiting, SubmissionSlot, TaskId, TaskIdExhaustedError, TaskMailbox }
import silk.shared { Shared }
import silk.system_clock { SystemClock }
import silk.system_clock { Instant }

struct TaskClock {}
effect fn taskNow(self: &mut TaskClock) -> Instant {
  return SystemClock.make(0, 0)
}
effect fn taskResolution(self: &mut TaskClock) -> u64 { return 1 }
effect fn taskWaitUntil(self: &mut TaskClock, deadline: Instant) -> () {
  drop deadline
  return ()
}
effect fn taskWaitFor(self: &mut TaskClock, duration: u64) -> () {
  drop duration
  return ()
}
impl MonotonicClock for TaskClock {
  now: TaskClock.taskNow
  getResolution: TaskClock.taskResolution
  waitUntil: TaskClock.taskWaitUntil
  waitFor: TaskClock.taskWaitFor
}

struct Audit {
  rootPreparations: i32
  nestedPreparations: i32
  publications: i32
  rejections: i32
  rejectedReleases: i32
  result: i32
}

fn recordPreparation(self: &mut Audit, owner: TaskId) -> () {
  if owner.value == 0 {
    self.rootPreparations = self.rootPreparations + 1
    return ()
  }
  self.nestedPreparations = self.nestedPreparations + 1
  return ()
}

fn recordPublication(self: &mut Audit) -> () {
  self.publications = self.publications + 1
  return ()
}

fn recordRejection(self: &mut Audit) -> () {
  self.rejections = self.rejections + 1
  return ()
}

fn recordRejectedRelease(self: &mut Audit) -> () {
  self.rejectedReleases = self.rejectedReleases + 1
  return ()
}

fn recordResult(self: &mut Audit, value: i32) -> () {
  self.result = value
  return ()
}

fn rootForkReturned() -> () { return () }
fn nestedBodyActivated() -> () { return () }
fn nestedForkReturned() -> () { return () }
fn closedBodyActivated() -> () { return () }
fn rejectedBodyActivated() -> () { return () }
fn rejectedTaskReleased() -> () { return () }
fn rejectionObserved() -> () { return () }
fn wrongRejectionFailure() -> () { return () }
fn providerPreparationFinished() -> () { return () }

struct TaskIdentitySource { next: u64 }

fn reserveIdentity(self: &mut TaskIdentitySource) -> TaskId {
  let selected = self.next
  self.next = selected + 1
  return TaskId { value: selected }
}

struct ExecutionEmpty {}
struct ExecutionStored { execution: Intrinsic.Execution<()> }
struct TaskRunState {
  phase: ExecutionEmpty | ExecutionStored
  completed: bool
}

struct RejectedLifetime {
  identity: TaskId
  audit: Shared<Audit>
}

impl Drop for RejectedLifetime {
  fn drop(self: &mut RejectedLifetime) -> () {
    if self.identity.value == 3 {
      rejectedTaskReleased()
      let recorded = Shared.withMut(&self.audit, recordRejectedRelease)
    }
    return ()
  }
}

struct ClientEndpoints {
  mailbox: Shared<TaskMailbox>
  submission: Shared<SubmissionSlot>
  response: Shared<PublicationResponse>
}

struct MailboxPair {
  client: ClientEndpoints
  driverMailbox: Shared<TaskMailbox>
  driverSubmission: Shared<SubmissionSlot>
}

effect fn makeMailbox(audit: &Shared<Audit>) -> MailboxPair
! OutOfMemoryError
? &mut Allocator {
  let response = run Shared.make<PublicationResponse>(PublicationResponse {
    phase: ResponseWaiting {},
  })
  let submission = run Shared.make<SubmissionSlot>(SubmissionSlot {
    phase: NoSubmission {},
  })
  let mailboxResponse = Shared.clone<PublicationResponse>(&response)
  let mailbox = run Shared.make<TaskMailbox>(TaskMailbox {
    request: NoRequest {},
    response: move mailboxResponse,
  })
  return MailboxPair {
    client: ClientEndpoints {
      mailbox: Shared.clone<TaskMailbox>(&mailbox),
      submission: Shared.clone<SubmissionSlot>(&submission),
      response: move response,
    },
    driverMailbox: move mailbox,
    driverSubmission: move submission,
  }
}

struct RenamedDispatcher {
  identity: TaskId
  endpoints: ClientEndpoints
  identities: Shared<TaskIdentitySource>
  audit: Shared<Audit>
}

fn ready(endpoint: &()) -> () { return () }

fn completeRun(self: &mut TaskRunState, output: ()) -> () {
  drop output
  self.completed = true
  return ()
}

fn suspendRun(
  self: &mut TaskRunState,
  execution: Intrinsic.Execution<()>,
) -> () {
  let previous = Intrinsic.replace(
    self.phase,
    ExecutionStored { execution: move execution },
  )
  drop previous
  return ()
}

fn takeExecution(self: &mut TaskRunState) -> ExecutionEmpty | ExecutionStored {
  return Intrinsic.replace(self.phase, ExecutionEmpty {})
}

effect fn driveExecution(
  execution: Intrinsic.Execution<()>,
  state: &mut TaskRunState,
) -> () {
  return run Execution.drive(move execution, move state, completeRun, suspendRun)
}

effect fn driveStored(state: &mut TaskRunState) -> () {
  let selected = Intrinsic.replace(state.phase, ExecutionEmpty {})
  return match move selected {
    ExecutionEmpty {} => ()
    ExecutionStored { execution } => run driveExecution(move execution, move state)
  }
}

fn completeChild<A, E>(
  completed: Result<A, E>,
  producer: CompletionProducer<A, E>,
) -> () {
  return match move completed {
    Result<A, E>.Success { value: success } => Fiber.completeSuccess<A, E>(
      move producer,
      move success,
    )
    Result<A, E>.Failure { error } => Fiber.completeFailure<A, E>(move producer, move error)
  }
}

effect fn runChild<A, E>(
  child: once Effect<
    A
    ! E
    ? &mut Scheduler | &mut MonotonicClock
  >,
  provider: RenamedDispatcher,
  clock: TaskClock,
  producer: CompletionProducer<A, E>,
  lifetime: RejectedLifetime,
) -> () {
  let bound = Effect.bindRequirementOwned<Scheduler>(move child, move provider)
  let timed = Effect.bindRequirementOwned<MonotonicClock>(move bound, move clock)
  let completed = run Effect.result(move timed)
  drop lifetime
  completeChild<A, E>(move completed, move producer)
  return ()
}

effect fn prepare<A, E>(
  self: &mut RenamedDispatcher,
  child: once Effect<
    A
    ! E
    ? &mut Scheduler | &mut MonotonicClock
  >,
) -> PendingPublication<A, E>
! OutOfMemoryError | TaskIdExhaustedError {
  let owner = self.identity
  let preparationRecorded = Shared.withMut(&self.audit, recordPreparation(owner))
  let identity = Shared.withMut(&self.identities, reserveIdentity)
  let mut allocator = Allocator.systemAllocatorProvider()
  let preparedFiber = run Fiber.prepare<A, E>()
    |> Effect.provideMut<Allocator>(&mut allocator)
  let PreparedFiber<A, E> { producer, canceller, fiber } = move preparedFiber
  let childMailbox = run makeMailbox(&self.audit)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let MailboxPair {
    client: childEndpoints,
    driverMailbox,
    driverSubmission,
  } = move childMailbox
  let childProvider = RenamedDispatcher {
    identity: identity,
    endpoints: move childEndpoints,
    identities: Shared.clone<TaskIdentitySource>(&self.identities),
    audit: Shared.clone<Audit>(&self.audit),
  }
  let lifetime = RejectedLifetime {
    identity: identity,
    audit: Shared.clone<Audit>(&self.audit),
  }
  let execution = run Execution.make(
    runChild<A, E>(
      move child,
      move childProvider,
      TaskClock {},
      move producer,
      move lifetime,
    ),
    (),
    ready,
  ) |> Effect.provideMut<Allocator>(&mut allocator)
  let task = PreparedTask {
    identity: identity,
    parent: self.identity,
    execution: move execution,
    canceller: move canceller,
    mailbox: move driverMailbox,
    submission: move driverSubmission,
  }
  let pending = Scheduler.pending<A, E>(
    move fiber,
    Shared.clone<TaskMailbox>(&self.endpoints.mailbox),
    Shared.clone<SubmissionSlot>(&self.endpoints.submission),
    Shared.clone<PublicationResponse>(&self.endpoints.response),
    move task,
  )
  providerPreparationFinished()
  return move pending
}

impl Scheduler for RenamedDispatcher {
  prepare: RenamedDispatcher.prepare
}

fn takeRequest(
  self: &mut TaskMailbox,
) -> NoRequest | PendingRequest {
  return Intrinsic.replace(self.request, NoRequest {})
}

fn takeSubmission(
  self: &mut SubmissionSlot,
) -> NoSubmission | PendingSubmission {
  return Intrinsic.replace(self.phase, NoSubmission {})
}

fn publishResponse(self: &mut PublicationResponse) -> () {
  let previous = Intrinsic.replace(self.phase, ResponsePublished {})
  drop previous
  return ()
}

fn rejectResponse(self: &mut PublicationResponse) -> () {
  let previous = Intrinsic.replace(self.phase, ResponseRejected {})
  drop previous
  return ()
}

fn responseHandle(
  self: &TaskMailbox,
) -> Shared<PublicationResponse> {
  return Shared.clone<PublicationResponse>(&self.response)
}

fn selectPrepared(
  request: NoRequest | PendingRequest,
  submission: NoSubmission | PendingSubmission,
) -> PreparedSelection {
  return match move request {
    NoRequest {} => missingPreparedSelection(move submission)
    PendingRequest { wake } => match move submission {
      NoSubmission {} => missingPreparedSelection(NoSubmission {})
      PendingSubmission { task } => PreparedSelection {
        task: move task,
        wake: move wake,
      }
    }
  }
}

struct PreparedSelection {
  task: PreparedTask
  wake: Wake
}

fn missingPreparedSelection(
  submission: NoSubmission | PendingSubmission,
) -> PreparedSelection {
  drop submission
  return missingPreparedSelection(NoSubmission {})
}

fn finishAccepted(
  response: Shared<PublicationResponse>,
  audit: Shared<Audit>,
  wake: Wake,
) -> () {
  let published = Shared.withMut(&response, publishResponse)
  let recorded = Shared.withMut(&audit, recordPublication)
  drop response
  drop audit
  Execution.wake(move wake)
  return ()
}

fn acceptPrepared(
  mailbox: &Shared<TaskMailbox>,
  submission: &Shared<SubmissionSlot>,
  audit: &Shared<Audit>,
) -> PreparedTask {
  let response = Shared.with<
    TaskMailbox,
    Shared<PublicationResponse>
  >(
    mailbox,
    responseHandle,
  )
  let request = Shared.withMut(mailbox, takeRequest)
  let prepared = Shared.withMut(submission, takeSubmission)
  let PreparedSelection { task, wake } = move selectPrepared(move request, move prepared)
  finishAccepted(move response, Shared.clone<Audit>(audit), move wake)
  let mut ready = move task
  Execution.notifyInitial(&mut ready.execution)
  return move ready
}

fn finishRejected(
  selected: PreparedSelection,
  response: Shared<PublicationResponse>,
  audit: Shared<Audit>,
) -> () {
  let PreparedSelection { task, wake } = move selected
  drop task
  let rejected = Shared.withMut(&response, rejectResponse)
  let recorded = Shared.withMut(&audit, recordRejection)
  drop response
  drop audit
  Execution.wake(move wake)
  return ()
}

fn rejectPrepared(
  mailbox: &Shared<TaskMailbox>,
  submission: &Shared<SubmissionSlot>,
  audit: &Shared<Audit>,
) -> () {
  let response = Shared.with<
    TaskMailbox,
    Shared<PublicationResponse>
  >(
    mailbox,
    responseHandle,
  )
  let request = Shared.withMut(mailbox, takeRequest)
  let prepared = Shared.withMut(submission, takeSubmission)
  let selected = selectPrepared(move request, move prepared)
  finishRejected(move selected, move response, Shared.clone<Audit>(audit))
  return ()
}

struct AdoptedTask {
  identity: TaskId
  runState: TaskRunState
  mailbox: Shared<TaskMailbox>
  submission: Shared<SubmissionSlot>
  canceller: CompletionCanceller
}

effect fn startPrepared(task: PreparedTask) -> AdoptedTask {
  let PreparedTask {
    identity,
    parent,
    execution,
    mailbox,
    submission,
    canceller,
  } = move task
  drop parent
  let mut runState = TaskRunState {
    phase: ExecutionEmpty {},
    completed: false,
  }
  run driveExecution(move execution, &mut runState)
  return AdoptedTask {
    identity: identity,
    runState: move runState,
    mailbox: move mailbox,
    submission: move submission,
    canceller: move canceller,
  }
}

fn outcomeValue(outcome: Outcome<i32, never>) -> i32 {
  let Outcome<i32, never> { value } = move outcome
  return match move value {
    Success<i32> { value: success } => success
    Failure<never> { error } => move error
    Cancelled {} => -100
  }
}

effect fn closedWork() -> i32 {
  closedBodyActivated()
  return 40
}

effect fn nestedWork() -> i32
! OutOfMemoryError | TaskIdExhaustedError
? &mut Scheduler | &mut MonotonicClock {
  nestedBodyActivated()
  let child = run Fiber.forkChild<i32, never>(closedWork())
  nestedForkReturned()
  let outcome = run Fiber.await<i32, never>(move child)
  return outcomeValue(move outcome) + 1
}

effect fn rejectedWork() -> i32 {
  rejectedBodyActivated()
  return 100
}

effect fn forkRejected() -> i32
! OutOfMemoryError | TaskIdExhaustedError
? &mut Scheduler | &mut MonotonicClock {
  let child = run Fiber.forkChild<i32, never>(rejectedWork())
  drop child
  return -100
}

effect fn recoverRejected(
  error: OutOfMemoryError | TaskIdExhaustedError,
) -> i32 {
  return match move error {
    OutOfMemoryError {} => observePublicationRejection()
    TaskIdExhaustedError {} => observeWrongRejectionFailure()
  }
}

fn observePublicationRejection() -> i32 {
  rejectionObserved()
  return 1
}

fn observeWrongRejectionFailure() -> i32 {
  wrongRejectionFailure()
  return -10
}

effect fn rootWork(audit: Shared<Audit>) -> ()
! OutOfMemoryError | TaskIdExhaustedError
? &mut Scheduler | &mut MonotonicClock {
  let child = run Fiber.forkChild<
    i32,
    OutOfMemoryError | TaskIdExhaustedError,
  >(nestedWork())
  rootForkReturned()
  let outcome = run Fiber.await<
    i32,
    OutOfMemoryError | TaskIdExhaustedError,
  >(move child)
  let nested = match move outcome {
    Outcome<
      i32,
      OutOfMemoryError | TaskIdExhaustedError,
    > { value } => match move value {
      Success<i32> { value: success } => success
      Failure<OutOfMemoryError | TaskIdExhaustedError> { error } => -200
      Cancelled {} => -300
    }
  }
  let rejected = run Effect.catchAll(forkRejected(), recoverRejected)
  let stored = Shared.withMut(&audit, recordResult(nested + rejected))
  drop audit
  return ()
}

effect fn recoverRoot(
  error: OutOfMemoryError | TaskIdExhaustedError,
) -> () {
  drop error
  return ()
}

fn auditResult(self: &Audit) -> i32 {
  if self.rootPreparations != 2 { return -1 }
  if self.nestedPreparations != 1 { return -2 }
  if self.publications != 2 { return -3 }
  if self.rejections != 1 { return -4 }
  if self.rejectedReleases != 1 { return -5 }
  return self.result
}

effect fn scenario() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let audit = run Shared.make<Audit>(Audit {
    rootPreparations: 0,
    nestedPreparations: 0,
    publications: 0,
    rejections: 0,
    rejectedReleases: 0,
    result: 0,
  }) |> Effect.provideMut<Allocator>(&mut allocator)
  let identities = run Shared.make<TaskIdentitySource>(TaskIdentitySource { next: 1 })
    |> Effect.provideMut<Allocator>(&mut allocator)
  let rootMailbox = run makeMailbox(&audit)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let MailboxPair {
    client: rootEndpoints,
    driverMailbox: rootDriverMailbox,
    driverSubmission: rootDriverSubmission,
  } = move rootMailbox
  let rootProvider = RenamedDispatcher {
    identity: TaskId { value: 0 },
    endpoints: move rootEndpoints,
    identities: move identities,
    audit: Shared.clone<Audit>(&audit),
  }
  let mut rootState = TaskRunState {
    phase: ExecutionEmpty {},
    completed: false,
  }
  let rootProgram = Effect.catchAll(
    rootWork(Shared.clone<Audit>(&audit)),
    recoverRoot,
  )
  let root = Effect.bindRequirementOwned<Scheduler>(
    move rootProgram,
    move rootProvider,
  )
  let timedRoot = Effect.bindRequirementOwned<MonotonicClock>(
    move root,
    TaskClock {},
  )
  let mut rootExecution = run Execution.make(move timedRoot, (), ready)
    |> Effect.provideMut<Allocator>(&mut allocator)
  Execution.notifyInitial(&mut rootExecution)

  run driveExecution(move rootExecution, &mut rootState)
  let nestedPrepared = acceptPrepared(&rootDriverMailbox, &rootDriverSubmission, &audit)
  run driveStored(&mut rootState)
  let mut nested = run startPrepared(move nestedPrepared)

  let leafPrepared = acceptPrepared(&nested.mailbox, &nested.submission, &audit)
  run driveStored(&mut nested.runState)
  let leaf = run startPrepared(move leafPrepared)
  run driveStored(&mut nested.runState)
  run driveStored(&mut rootState)

  rejectPrepared(&rootDriverMailbox, &rootDriverSubmission, &audit)
  run driveStored(&mut rootState)

  drop leaf
  drop nested
  drop rootState
  drop rootDriverMailbox
  drop rootDriverSubmission
  let result = Shared.with<Audit, i32>(&audit, auditResult)
  drop audit
  return result
}

effect fn recover(error: OutOfMemoryError) -> i32 {
  drop error
  return -99
}

pub fn main() -> i32 {
  return run Effect.catchAll(scenario(), recover)
}
