import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.execution { Execution, Wake }
import silk.fiber { Fiber, Cancelled }
import silk.local_scheduler { LocalScheduler, StalledError }
import silk.monotonic_clock { MonotonicClock }
import silk.scheduler { Scheduler, TaskIdExhaustedError }
import silk.shared { Shared }
import silk.system_clock { SystemClock }
import silk.system_clock { Instant }

struct ParentClock { mark: Instant }
effect fn parentNow(self: &mut ParentClock) -> Instant {
  return SystemClock.make(SystemClock.seconds(&self.mark), SystemClock.nanoseconds(&self.mark))
}
effect fn parentResolution(self: &mut ParentClock) -> u64 { return 1 }
effect fn parentWaitUntil(self: &mut ParentClock, deadline: Instant) -> () {
  self.mark = move deadline
  return ()
}
effect fn parentWaitFor(self: &mut ParentClock, duration: u64) -> () {
  let deadline = MonotonicClock.deadlineAfter(&self.mark, duration)
  return run parentWaitUntil(move self, move deadline)
}
impl MonotonicClock for ParentClock {
  now: ParentClock.parentNow
  getResolution: ParentClock.parentResolution
  waitUntil: ParentClock.parentWaitUntil
  waitFor: ParentClock.parentWaitFor
}

struct WakeEmpty {}
struct WakeArmed { wake: Wake }
struct RetainedWake { slot: WakeEmpty | WakeArmed }
struct ParkGuard {}
struct RetainedRootFailure {}

fn retainedWakeInstalled() -> () { return () }
fn retainedGuardReleased() -> () { return () }
fn retainedRunRecovered() -> () { return () }
fn staleRootTerminating() -> () { return () }
fn staleRunReturned() -> () { return () }
fn staleChildActivated() -> () { return () }
fn freshStarted() -> () { return () }
fn cancelledWakeConsumed() -> () { return () }
fn currentChildActivated() -> () { return () }
fn freshReturned() -> () { return () }
fn resumedUnexpectedly() -> () { return () }

impl Drop for ParkGuard {
  fn drop(self: &mut ParkGuard) -> () {
    retainedGuardReleased()
    return ()
  }
}

fn installWake(self: &mut RetainedWake, wake: Wake) -> () {
  let previous = Intrinsic.replace(self.slot, WakeArmed { wake: move wake })
  drop previous
  return ()
}

fn takeWake(self: &mut RetainedWake) -> WakeEmpty | WakeArmed {
  return Intrinsic.replace(self.slot, WakeEmpty {})
}

fn retainWake(wake: Wake, state: Shared<RetainedWake>) -> ParkGuard {
  let installed = Shared.withMut(&state, installWake(move wake))
  drop state
  retainedWakeInstalled()
  return ParkGuard {}
}

fn consumeRetainedWake(state: &Shared<RetainedWake>) -> () {
  let selected = Shared.withMut(state, takeWake)
  return match move selected {
    WakeEmpty {} => ()
    WakeArmed { wake } => Execution.wake(move wake)
  }
}

effect fn retainedWakeRoot(state: Shared<RetainedWake>) -> i32
! RetainedRootFailure
? &mut Scheduler | &mut MonotonicClock {
  let registration = retainWake(move state)
  run Execution.park(move registration)
  resumedUnexpectedly()
  return -1
}

effect fn staleChild() -> i32 {
  staleChildActivated()
  return -2
}

effect fn staleReadyRoot() -> i32
! OutOfMemoryError | TaskIdExhaustedError
? &mut Scheduler | &mut MonotonicClock {
  let child = run Fiber.forkChild<i32, never>(staleChild())
  drop child
  staleRootTerminating()
  return 1
}

effect fn currentChild() -> i32 {
  currentChildActivated()
  return 42
}

effect fn freshRoot(state: Shared<RetainedWake>) -> i32
! OutOfMemoryError | TaskIdExhaustedError | Cancelled
? &mut Scheduler | &mut MonotonicClock {
  freshStarted()
  consumeRetainedWake(&state)
  cancelledWakeConsumed()
  drop state
  let child = run Fiber.forkChild<i32, never>(currentChild())
  return run Fiber.join<i32, never>(move child)
}

effect fn recoverRetainedRun(
  error: RetainedRootFailure | OutOfMemoryError | StalledError,
) -> i32 {
  return match move error {
    RetainedRootFailure {} => 0
    OutOfMemoryError {} => 0
    StalledError {} => markRetainedRecovery()
  }
}

fn markRetainedRecovery() -> i32 {
  retainedRunRecovered()
  return 1
}

effect fn scenario() -> i32
! OutOfMemoryError
  | TaskIdExhaustedError
  | Cancelled
  | StalledError
? &mut MonotonicClock {
  let mut allocator = Allocator.systemAllocatorProvider()
  let state = run Shared.make<RetainedWake>(RetainedWake { slot: WakeEmpty {} })
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut scheduler = LocalScheduler.make()

  let firstState = Shared.clone<RetainedWake>(&state)
  let retainedRecovered = run Effect.catchAll(
    LocalScheduler.execute(&mut scheduler, retainedWakeRoot(move firstState)),
    recoverRetainedRun,
  )

  let stale = run LocalScheduler.execute(&mut scheduler, staleReadyRoot())
  staleRunReturned()

  let freshState = Shared.clone<RetainedWake>(&state)
  let fresh = run LocalScheduler.execute(&mut scheduler, freshRoot(move freshState))
  freshReturned()

  drop state
  if retainedRecovered == 1 && stale == 1 && fresh == 42 { return 42 }
  return -42
}

effect fn recoverScenario(
  error: OutOfMemoryError
    | TaskIdExhaustedError
    | Cancelled
    | StalledError,
) -> i32 {
  drop error
  return -99
}

pub fn main() -> i32 {
  let mut clock = ParentClock { mark: SystemClock.make(0, 0) }
  let program = Effect.catchAll(scenario(), recoverScenario)
    |> Effect.provideMut<MonotonicClock>(&mut clock)
  return run move program
}
