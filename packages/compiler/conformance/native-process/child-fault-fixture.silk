import silk.child_process {ChildProcess, ProcessError}

import silk.os_child_process {OsChildProcess}

import silk.allocator {Allocator, OutOfMemoryError}

import silk.filesystem {Path, FileError}

import silk.effect {Effect}

import silk.option {Option}

import silk.layout {Layout}

unsafe extern "C" fn fixture_allocation() -> i32

struct FaultAllocator {}

effect fn allocate(self: &mut FaultAllocator, layout: Layout) -> Intrinsic.Allocation ! OutOfMemoryError {
  if unsafe fixture_allocation() != 0 {
    fail OutOfMemoryError {}
  }
  let mut inner = Allocator.systemAllocatorProvider()
  return run Allocator.allocate(move layout)
    |> Effect.provideMut<Allocator>(&mut inner)
}

impl Allocator for FaultAllocator {
  allocate: FaultAllocator.allocate
}

effect fn exercise() -> i32 ! FileError | OutOfMemoryError | ProcessError ? &mut Allocator {
  let path = run Path.make("/fixture")
  let directory = run Path.make("/")
  let mut request = run ChildProcess.requestWithin(&path, &directory)
  run ChildProcess.addArgument(&mut request, b"argument")
  run ChildProcess.setVariable(&mut request, b"name", b"value")
  let mut provider = OsChildProcess.make()
  let outcome = run ChildProcess.submit(&request)
    |> Effect.provideMut<ChildProcess>(&mut provider)
  if ChildProcess.outputBytes(&outcome).length != 0 || ChildProcess.errorBytes(&outcome).length != 0 {
    return 90
  }
  return match move ChildProcess.exitCode(&outcome) {
    Option<i32>.Some {value} => value
    Option<i32>.None => 91
  }
}

effect fn processFailure(error: ProcessError) -> i32 {
  return match move ChildProcess.providerCode(&error) {
    Option<i32>.Some {value} => value
    Option<i32>.None => 91
  }
}

effect fn program() -> i32 ! FileError | OutOfMemoryError {
  let mut allocator = FaultAllocator {}
  return run Effect.catch<ProcessError>(exercise(), processFailure)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn memoryFailure(error: OutOfMemoryError) -> i32 {
  return 93
}

effect fn unexpected(error: FileError) -> i32 {
  return 92
}

export "C" fn process_fixture() -> i32 {
  return run Effect.catchAll(Effect.catch<OutOfMemoryError>(program(), memoryFailure), unexpected)
}
