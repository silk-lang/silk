import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.execution { Execution, Wake }
import silk.shared { Shared }

struct State {
  started: i32
  dropped: i32
  finished: i32
  rejected: bool
  live: i32
  produced: usize
  bad: i32
  observers: i32
  sequence: i32
  expectedSequence: i32
}
struct Payload { state: Shared<State> }
fn recordDrop(state: &mut State) -> () {
  if state.rejected && state.live <= 0 { state.bad = state.bad + 1 }
  state.dropped = state.dropped + 1
  return ()
}
impl Drop for Payload {
  fn drop(self: &mut Payload) -> () { Shared.withMut(&self.state, recordDrop) return () }
}
struct Guard { wake: Wake }
fn register(wake: Wake) -> Guard { return Guard { wake: move wake } }
fn started(state: &mut State) -> () {
  if state.rejected && state.live <= 0 { state.bad = state.bad + 1 }
  state.started = state.started + 1
  return ()
}
fn finished(state: &mut State) -> () { state.finished = state.finished + 1 return () }
fn inspect(state: &mut State) -> i32 {
  if state.bad != 0 || state.live != 0 || state.observers != 1 || state.sequence != state.expectedSequence { return -1 }
  return state.started * 100 + state.dropped * 10 + state.finished
}
struct Observer { state: Shared<State> }
fn closeObserver(state: &mut State) -> () {
  if state.live != 0 { state.bad = state.bad + 1 }
  state.observers = state.observers + 1
  return ()
}
impl Drop for Observer {
  fn drop(self: &mut Observer) -> () { Shared.withMut(&self.state, closeObserver) return () }
}
fn event(state: &mut State, event: u8, first: usize) -> usize {
  if event == 0 || event == 1 || event == 2 {
    if event == 2 { state.bad = state.bad + 1 }
    state.live = state.live + 1
    state.produced = state.produced + 1
    return state.produced
  }
  if event == 3 { if first != 0 { state.live = state.live + 1 } return first }
  if event == 4 { if first != 0 { state.live = state.live - 1 } return 0 }
  state.bad = state.bad + 1
  return 0
}
fn observe(state: &mut Observer, operation: u8, first: usize, second: usize, identity: string<'static>, origin: string<'static>) -> usize {
  return Shared.withMut(&state.state, event(operation, first))
}
fn observing<'env, S: 'env, A, ?R, F: fn<'static>(&mut S, u8, usize, usize, string<'static>, string<'static>) -> usize + Intrinsic.NonParking>(state: S, observer: F, body: once Effect<'env; A ? R>) -> once Effect<'env; A ? R> {
  return Intrinsic.observeDiagnostics<S, A, R, F>(move state, move observer, move body)
}
struct Noise {}
effect fn noise() -> () ! Noise { fail Noise {} }
effect fn ignoreNoise(error: Noise) -> () { return () }
fn ready(state: &Shared<State>) -> () { Shared.withMut(state, finished) return () }
effect fn protected(state: Shared<State>, rejected: bool, parkBefore: bool) -> Payload ! Payload {
  if parkBefore { run Execution.park(register) }
  if rejected { fail Payload { state: move state } }
  return Payload { state: move state }
}
fn orderedOne(state: &mut State) -> () { state.sequence = state.sequence * 10 + 1 return () }
fn orderedTwo(state: &mut State) -> () { state.sequence = state.sequence * 10 + 2 return () }
effect fn finalizer(state: Shared<State>, id: i32) -> () {
  Shared.withMut(&state, started)
  if id == 1 { Shared.withMut(&state, orderedOne) } else { Shared.withMut(&state, orderedTwo) }
  run Effect.catchAll(noise(), ignoreNoise)
  run Effect.suspend(effect { return () })
  Shared.withMut(&state, finished)
  return ()
}
fn consume(value: Payload) -> i32 { drop move value return 99 }
effect fn recover(error: Payload) -> i32 { drop move error return 99 }
effect fn observed(state: Shared<State>, rejected: bool, parkBefore: bool, nested: bool) -> i32 {
  if nested {
    let inner = Effect.ensuringNonParking(protected(Shared.clone(&state), rejected, parkBefore), finalizer(Shared.clone(&state), 1))
    let guarded = Effect.ensuringNonParking(move inner, finalizer(Shared.clone(&state), 2))
    let body = Effect.catchAll(Effect.map(move guarded, consume), recover)
    return run observing(Observer { state: move state }, observe, move body)
  }
  let guarded = Effect.ensuringNonParking(protected(Shared.clone(&state), rejected, parkBefore), finalizer(Shared.clone(&state), 1))
  let body = Effect.catchAll(Effect.map(move guarded, consume), recover)
  return run observing(Observer { state: move state }, observe, move body)
}
fn complete(state: &mut (), value: i32) -> () { return () }
fn suspend(state: &mut (), execution: Intrinsic.Execution<i32>) -> () { drop move execution return () }
struct ResourceAudit {
  capturedDropped: i32
  released: i32
  dropped: i32
  bad: i32
}
struct Resource { audit: Shared<ResourceAudit> }
struct ResourceFailure {}
fn recordResourceDrop(audit: &mut ResourceAudit) -> () {
  if audit.released != 1 { audit.bad = audit.bad + 1 }
  audit.dropped = audit.dropped + 1
  return ()
}
impl Drop for Resource {
  fn drop(self: &mut Resource) -> () {
    Shared.withMut(&self.audit, recordResourceDrop)
    return ()
  }
}
fn recordResourceUse(audit: &mut ResourceAudit) -> () {
  if audit.released != 0 || audit.dropped != 0 { audit.bad = audit.bad + 1 }
  return ()
}
effect fn useResource(resource: &mut Resource) -> i32 {
  Shared.withMut(&resource.audit, recordResourceUse)
  run Execution.park(register)
  return 1
}
effect fn useResourceSuccess(resource: &mut Resource) -> i32 {
  Shared.withMut(&resource.audit, recordResourceUse)
  return 17
}
effect fn useResourceFailure(resource: &mut Resource) -> i32 ! ResourceFailure {
  Shared.withMut(&resource.audit, recordResourceUse)
  fail ResourceFailure {}
}
fn recordResourceRelease(audit: &mut ResourceAudit) -> () {
  audit.released = audit.released + 1
  if audit.released != 1 || audit.dropped != 0 { audit.bad = audit.bad + 1 }
  return ()
}
effect fn releaseResource(resource: &mut Resource) -> () {
  Shared.withMut(&resource.audit, recordResourceRelease)
  return ()
}
fn resourceReady(audit: &Shared<ResourceAudit>) -> () { return () }
fn inspectResource(audit: &mut ResourceAudit) -> i32 {
  if audit.released != 1 || audit.dropped != 1 || audit.bad != 0 { return -1 }
  return 42
}
effect fn recoverResource(error: ResourceFailure) -> i32 { return 23 }
effect fn exerciseResourceSuccess() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let audit = run Shared.make<ResourceAudit>(ResourceAudit { released: 0, dropped: 0, bad: 0, capturedDropped: 0 })
    |> Effect.provideMut<Allocator>(&mut allocator)
  let value = run Effect.useReleaseNonParking(
    Resource { audit: Shared.clone(&audit) },
    useResourceSuccess,
    releaseResource,
  )
  if Shared.withMut(&audit, inspectResource) != 42 { return -1 }
  return value
}
effect fn exerciseResourceFailure() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let audit = run Shared.make<ResourceAudit>(ResourceAudit { released: 0, dropped: 0, bad: 0, capturedDropped: 0 })
    |> Effect.provideMut<Allocator>(&mut allocator)
  let body = Effect.useReleaseNonParking(
    Resource { audit: Shared.clone(&audit) },
    useResourceFailure,
    releaseResource,
  )
  let value = run Effect.catchAll(move body, recoverResource)
  if Shared.withMut(&audit, inspectResource) != 42 { return -1 }
  return value
}
struct CapturedResourceAudit { audit: Shared<ResourceAudit> }
fn recordCapturedDrop(audit: &mut ResourceAudit) -> () {
  audit.capturedDropped = audit.capturedDropped + 1
  if audit.released != 0 || audit.dropped != 0 { audit.bad = audit.bad + 1 }
  return ()
}
impl Drop for CapturedResourceAudit {
  fn drop(self: &mut CapturedResourceAudit) -> () { Shared.withMut(&self.audit, recordCapturedDrop) return () }
}
fn inspectCapturedResource(audit: &mut ResourceAudit) -> i32 {
  if audit.capturedDropped != 1 { return -1 }
  return inspectResource(move audit)
}
effect fn exerciseResourceCancellation() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let audit = run Shared.make<ResourceAudit>(ResourceAudit { released: 0, dropped: 0, bad: 0, capturedDropped: 0 })
    |> Effect.provideMut<Allocator>(&mut allocator)
  let capture = CapturedResourceAudit { audit: Shared.clone(&audit) }
  let use = effect fn(resource: &mut Resource) -> i32 {
    let result = run useResource(move resource)
    drop capture
    return result
  }
  let body = Effect.useReleaseNonParking(
    Resource { audit: Shared.clone(&audit) },
    move use,
    releaseResource,
  )
  let execution = run Execution.make(move body, Shared.clone(&audit), resourceReady)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut branch = ()
  run Execution.drive(move execution, &mut branch, complete, suspend)
  return Shared.withMut(&audit, inspectCapturedResource)
}
effect fn exercise(rejected: bool, parkBefore: bool, nested: bool) -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut expectedSequence = 1
  if nested { expectedSequence = 12 }
  let state = run Shared.make<State>(State { started: 0, dropped: 0, finished: 0, rejected: rejected, live: 0, produced: 0, bad: 0, observers: 0, sequence: 0, expectedSequence: expectedSequence })
    |> Effect.provideMut<Allocator>(&mut allocator)
  let execution = run Execution.make(observed(Shared.clone(&state), rejected, parkBefore, nested), Shared.clone(&state), ready)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut branch = ()
  run Execution.drive(move execution, &mut branch, complete, suspend)
  return Shared.withMut(&state, inspect)
}
effect fn program() -> i32 ! OutOfMemoryError {
  if (run exercise(false, false, false)) != 111 { return 1 }
  if (run exercise(true, false, false)) != 111 { return 2 }
  if (run exercise(false, true, false)) != 101 { return 3 }
  if (run exercise(false, true, true)) != 202 { return 4 }
  if (run exerciseResourceSuccess()) != 17 { return 5 }
  if (run exerciseResourceFailure()) != 23 { return 6 }
  if (run exerciseResourceCancellation()) != 42 { return 7 }
  return 42
}
effect fn noMemory(error: OutOfMemoryError) -> i32 { return -2 }
pub fn main() -> i32 { return run Effect.catchAll(program(), noMemory) }
