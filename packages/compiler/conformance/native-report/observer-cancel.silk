import silk.effect { Effect }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.execution { Execution, Wake }
import silk.native_report { NativeReport }
unsafe extern "C" fn cancel_drop(which: i32) -> ()
unsafe extern "C" fn cancel_event(mode: i32) -> ()
struct State {
  report: NativeReport
  mode: i32
}
impl Drop for State {
  fn drop(self: &mut State) -> () {
    unsafe { cancel_drop(2) }
    if self.mode == 2 { let invalid = 42 / (self.mode - 2) }
    return ()
  }
}
struct Guard {
  wake: Wake
  mode: i32
}
impl Drop for Guard {
  fn drop(self: &mut Guard) -> () {
    unsafe { cancel_drop(1) }
    if self.mode == 1 { let invalid = 42 / (self.mode - 1) }
    return ()
  }
}
fn register(wake: Wake, mode: i32) -> Guard { return Guard { wake: move wake, mode: mode } }
fn observer(state: &mut State, event: u8, first: usize, second: usize, identity: string<'static>, origin: string<'static>) -> usize {
  unsafe { cancel_event(state.mode) }
  let reported = run NativeReport.fatal(&mut state.report, identity, origin)
  return 0
}
fn observing<'env, S: 'env, A, ?R, F: fn<'static>(&mut S, u8, usize, usize, string<'static>, string<'static>) -> usize + Intrinsic.NonParking>(state: S, observer: F, body: once Effect<'env; A ? R>) -> once Effect<'env; A ? R> {
  return Intrinsic.observeDiagnostics<S, A, R, F>(move state, move observer, move body)
}
effect fn body(mode: i32) -> i32 { run Execution.park(register(mode)) return 42 }
effect fn observed(mode: i32) -> i32 {
  if mode == 3 {
    return run observing(State { report: NativeReport.make(2, 1024, 4), mode: 3 }, observer, observed(2))
  }
  return run observing(State { report: NativeReport.make(2, 1024, 4), mode: mode }, observer, body(mode))
}
struct Status { code: i32 }
fn ready(state: &()) -> () {}
fn complete(state: &mut Status, code: i32) -> () { state.code = code }
fn suspended(state: &mut Status, execution: Intrinsic.Execution<i32>) -> () { drop execution state.code = 42 }
effect fn start(mode: i32) -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let execution = run Execution.make(observed(mode), (), ready)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut state = Status { code: 91 }
  run Execution.drive(move execution, &mut state, complete, suspended)
  return state.code
}
effect fn noStorage(error: OutOfMemoryError) -> i32 { return 92 }
export "C" fn cancel_probe(mode: i32) -> i32 {
  if mode >= 4 { return run Effect.catchAll(independent(mode), noStorage) }
  return run Effect.catchAll(start(mode), noStorage)
}

// Driving an independent execution must not lend it the driver's observer lifetime.
struct Empty {}
struct Stored { execution: Intrinsic.Execution<i32> }
struct Owner { slot: Empty | Stored callbackTrap: bool }
fn finish(owner: &mut Owner, result: i32) -> () {
  if owner.callbackTrap { let invalid = 42 / (result - 42) }
  return ()
}
fn retain(owner: &mut Owner, execution: Intrinsic.Execution<i32>) -> () {
  let previous = Intrinsic.replace(owner.slot, Stored { execution: move execution })
  drop previous
  return ()
}
effect fn driveIndependent(execution: Intrinsic.Execution<i32>, owner: &mut Owner) -> i32 {
  run Execution.drive(move execution, move owner, finish, retain)
  return 42
}
effect fn directBody(divisor: i32) -> i32 { return 42 / divisor }
effect fn independent(mode: i32) -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut owner = Owner { slot: Empty {}, callbackTrap: mode == 6 }
  if mode == 5 {
    let execution = run Execution.make(body(1), (), ready)
      |> Effect.provideMut<Allocator>(&mut allocator)
    let driven = run observing(State { report: NativeReport.make(2, 1024, 4), mode: mode }, observer, driveIndependent(move execution, &mut owner))
    // State has been destroyed; cancelling the retained execution must remain safe.
    let parked = Intrinsic.replace(owner.slot, Empty {})
    drop parked
    return driven
  }
  let mut divisor = 0
  if mode == 6 { divisor = 1 }
  let execution = run Execution.make(directBody(divisor), (), ready)
    |> Effect.provideMut<Allocator>(&mut allocator)
  return run observing(State { report: NativeReport.make(2, 1024, 4), mode: mode }, observer, driveIndependent(move execution, &mut owner))
}
