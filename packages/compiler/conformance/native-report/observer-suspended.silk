import silk.native_report { NativeReport }
import silk.layout { Layout }
import silk.usize

unsafe extern "C" fn observer_event(event: u8, first: usize, second: usize, salt: i32) -> ()
unsafe extern "C" fn observer_drop() -> ()
unsafe extern "C" fn observer_context(live: usize, produced: usize) -> ()
unsafe extern "C" fn observer_live(live: usize, produced: usize) -> ()
unsafe extern "C" fn observer_checkpoint() -> ()
unsafe extern "C" fn observer_payload_drop() -> ()
unsafe extern "C" fn observer_unhandled(handle: usize, salt: i32) -> ()
unsafe extern "C" fn observer_absent(policy: usize, mode: i32) -> ()
unsafe extern "C" fn observer_empty_drop() -> ()

fn terminalPolicy() -> usize { return Intrinsic.observeUnhandled() }
struct EmptyObserver {}
impl Drop for EmptyObserver {
  fn drop(self: &mut EmptyObserver) -> () { unsafe { observer_empty_drop() } return () }
}
fn emptyObserver(state: &mut EmptyObserver, event: u8, first: usize, second: usize, identity: string<'static>, origin: string<'static>) -> usize {
  unsafe { observer_event(249, first, second, 0) }
  return 0
}
effect fn absentBody(mode: i32) -> i32 {
  let resumed = run Intrinsic.suspendEffect(effect { return mode })
  unsafe { observer_absent(terminalPolicy(), resumed) }
  return 42
}

struct State {
  report: NativeReport
  live: usize
  produced: usize
}
impl Drop for State {
  fn drop(self: &mut State) -> () { unsafe { observer_context(self.live, self.produced) observer_drop() } return () }
}
fn observing<'env, S: 'env, A, ?R, F: fn<'static>(&mut S, u8, usize, usize, string<'static>, string<'static>) -> usize + Intrinsic.NonParking>(state: S, observer: F, body: once Effect<'env; A ? R>) -> once Effect<'env; A ? R> {
  return Intrinsic.observeDiagnostics<S, A, R, F>(move state, move observer, move body)
}
fn observer(state: &mut State, event: u8, first: usize, second: usize, identity: string<'static>, origin: string<'static>, salt: i32) -> usize {
  if event == 0 && salt == 20 && identity != "Intrinsic.StorageFailure" {
    unsafe { observer_event(202, first, second, salt) }
  }
  if event == 0 && (salt == 21 || salt == 23 || salt == 24) {
    if state.produced == 0 {
      if identity != "report-conformance/root.CleanupPrimary" { unsafe { observer_event(202, first, second, salt) } }
    } else {
      if identity != "report-conformance/root.CleanupNoise" { unsafe { observer_event(202, first, second, salt) } }
    }
  }
  if event == 2 && (first != 2 || second != 1) {
    unsafe { observer_event(200, first, second, salt) }
  }
  if event == 1 {
    let written = run NativeReport.frame(&mut state.report, identity)
  }
  if event == 0 || event == 1 || event == 2 {
    state.live = state.live + 1
    state.produced = state.produced + 1
    if salt == 20 || salt == 21 || salt == 23 || salt == 24 { unsafe { observer_live(state.live, state.produced) } }
    return state.produced
  }
  if event == 3 { if first != 0 { state.live = state.live + 1 } return first }
  if event == 4 {
    if first != 0 { state.live = state.live - 1 }
    if salt == 20 || salt == 21 || salt == 23 || salt == 24 { unsafe { observer_live(state.live, state.produced) } }
    return 0
  }
  if first == 0 {
    if state.live != 0 { unsafe { observer_event(201, state.live, first, salt) } }
  } else {
    if state.live != 1 { unsafe { observer_event(201, state.live, first, salt) } }
  }
  if event == 5 {
    if salt == 24 { unsafe { observer_absent(terminalPolicy(), 20) } }
    if identity != "report-conformance/root.CleanupPrimary" { unsafe { observer_event(202, first, second, salt) } }
    unsafe { observer_unhandled(first, salt) }
    let reported = run NativeReport.unhandled(&mut state.report, identity, origin)
    return 42
  }
  unsafe { observer_event(event, first, second, salt) }
  if salt == 11 { let invalid = 42 / (salt - 11) }
  let reported = run NativeReport.fatal(&mut state.report, identity, origin)
  return 0
}
struct RecoveredInput { divisor: i32 }
effect fn input(divisor: i32) -> i32 ! RecoveredInput {
  let resumed = run Intrinsic.suspendEffect(effect { return divisor })
  fail RecoveredInput { divisor: resumed }
}
struct Retry { divisor: i32 }
struct OtherRetry { divisor: i32 }
effect fn failRetry(problem: Retry | OtherRetry) -> i32 ! Retry | OtherRetry {
  fail move problem
}
effect fn recoverRetryOnly(problem: Retry) -> i32 { return problem.divisor }
effect fn selectiveFailure(problem: Retry | OtherRetry) -> i32 ! OtherRetry {
  return run Effect.catch<Retry>(failRetry(move problem), recoverRetryOnly)
}
effect fn recoverInput(problem: RecoveredInput) -> i32 ! Retry | OtherRetry {
  if problem.divisor == 8 { return run failRetry(Retry { divisor: problem.divisor }) }
  if problem.divisor == 9 { return run failRetry(OtherRetry { divisor: 8 }) }
  if problem.divisor == 10 { return run selectiveFailure(OtherRetry { divisor: 8 }) }
  if problem.divisor == 7 {
    return run Intrinsic.suspendEffect(effect { return 42 / (problem.divisor - 7) })
  }
  return run Intrinsic.suspendEffect(effect { return problem.divisor })
}
effect fn terminalRecovery(problem: Retry | OtherRetry) -> i32 {
  let divisor = match move problem {
    Retry { divisor } => divisor
    OtherRetry { divisor } => divisor
  }
  return run Intrinsic.suspendEffect(effect { return 42 / (divisor - 8) })
}
effect fn application(divisor: i32) -> i32 {
  let recovered = run Effect.catchAll(Effect.catchAll(input(divisor), recoverInput), terminalRecovery)
  let wrapped = run Effect.suspend(effect { return recovered })
  let resumed = run Intrinsic.suspendEffect(effect { return wrapped })
  return 42 / resumed
}
effect fn nestedApplication() -> i32 {
  let inner = run observing(State { report: NativeReport.make(2, 1024, 4), live: 0, produced: 0 }, observer(99), application(1))
  return run application(0)
}
effect fn allocationFailure() -> i32 ! Intrinsic.StorageFailure {
  let allocation = run Intrinsic.systemAllocationAcquire(Layout { bytes: usize.MAX, alignment: 2 })
  drop allocation
  return 42
}
effect fn allocationRecovery(error: Intrinsic.StorageFailure, mode: i32) -> i32 {
  drop error
  return run Intrinsic.suspendEffect(effect { return 42 / (mode - 11) })
}
effect fn allocationApplication(mode: i32) -> i32 {
  let recovered = run Intrinsic.catchFailure<Intrinsic.StorageFailure>(allocationFailure(), allocationRecovery(mode))
  unsafe { observer_checkpoint() }
  return recovered
}
struct CleanupNoise {}
effect fn cleanupNoise() -> () ! CleanupNoise { fail CleanupNoise {} }
effect fn quietCleanup(error: CleanupNoise) -> () { drop error return () }
struct CleanupPrimary { divisor: i32 }
impl Drop for CleanupPrimary {
  fn drop(self: &mut CleanupPrimary) -> () {
    let recovered = run Intrinsic.catchFailure<CleanupNoise>(cleanupNoise(), quietCleanup)
    unsafe { observer_payload_drop() }
    return ()
  }
}
effect fn cleanupPrimary() -> i32 ! CleanupPrimary { fail CleanupPrimary { divisor: 13 } }
effect fn cleanupRecovery(problem: CleanupPrimary, mode: i32) -> i32 {
  let divisor = problem.divisor
  drop problem
  if mode == 18 {
    let empty = run observing(EmptyObserver {}, emptyObserver, absentBody(18))
  }
  if mode == 21 {
    let independent = run Intrinsic.catchFailure<OutOfMemoryError>(independentTerminal(), noStorage)
    if independent != 42 { return independent }
  }
  if mode >= 15 {
    let resumed = run Intrinsic.suspendEffect(effect { return mode })
    return usize.toI32(terminalPolicy())
  }
  return run Intrinsic.suspendEffect(effect { return 42 / (mode - divisor) })
}
effect fn cleanupApplication(mode: i32) -> i32 {
  let recovered = run Intrinsic.catchFailure<CleanupPrimary>(cleanupPrimary(), cleanupRecovery(mode))
  unsafe { observer_checkpoint() }
  if mode == 17 { unsafe { observer_absent(terminalPolicy(), 17) } }
  return recovered
}
export "C" fn bare_probe(divisor: i32) -> i32 { return 42 / divisor }
effect fn observed(mode: i32) -> i32 {
  if mode == 20 {
    return run observing(State { report: NativeReport.make(2, 1024, 4), live: 0, produced: 0 }, observer(24), cleanupApplication(mode))
  }
  if mode == 16 {
    return run observing(State { report: NativeReport.make(2, 1024, 4), live: 0, produced: 0 }, observer(23), cleanupApplication(mode))
  }
  if mode == 13 || mode == 14 || mode == 15 || mode == 17 || mode == 18 || mode == 21 {
    return run observing(State { report: NativeReport.make(2, 1024, 4), live: 0, produced: 0 }, observer(21), cleanupApplication(mode))
  }
  if mode == 11 || mode == 12 {
    return run observing(State { report: NativeReport.make(2, 1024, 4), live: 0, produced: 0 }, observer(20), allocationApplication(mode))
  }
  if mode == 5 {
    return run observing(State { report: NativeReport.make(2, 1024, 4), live: 0, produced: 0 }, observer(14), nestedApplication())
  }
  let mut divisor = 0
  if mode == 1 { divisor = 1 }
  if mode == 7 { divisor = 7 }
  if mode == 8 { divisor = 8 }
  if mode == 9 { divisor = 9 }
  if mode == 10 { divisor = 10 }
  return run observing(State { report: NativeReport.make(2, 1024, 4), live: 0, produced: 0 }, observer(mode + 9), application(divisor))
}

import silk.effect { Effect }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.execution { Execution }
struct Status { code: i32 }
fn ready(state: &()) -> () {}
fn complete(state: &mut Status, code: i32) -> () { state.code = code }
fn suspended(state: &mut Status, execution: Intrinsic.Execution<i32>) -> () {
  drop execution
  state.code = 90
}
effect fn start(mode: i32) -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let execution = run Execution.make(observed(mode), (), ready)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut status = Status { code: 91 }
  run Execution.drive(move execution, &mut status, complete, suspended)
  return status.code
}
effect fn noStorage(error: OutOfMemoryError) -> i32 { return 92 }
effect fn independentTerminal() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let execution = run Execution.make(absentBody(21), (), ready)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut status = Status { code: 91 }
  run Execution.drive(move execution, &mut status, complete, suspended)
  return status.code
}
export "C" fn observer_probe(mode: i32) -> i32 {
  if mode == 19 { unsafe { observer_absent(terminalPolicy(), 19) } return 42 }
  return run Effect.catchAll(start(mode), noStorage)
}

export "C" fn observer_has_context() -> i32 { return 1 }
