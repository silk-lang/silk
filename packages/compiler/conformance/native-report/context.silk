import silk.native_diagnostics {NativeDiagnostics}

import silk.native_report {NativeReport}

import silk.usize

struct Primary {}

struct Secondary {}

effect fn primary() -> i32 ! Primary {
  fail Primary {}
}

effect fn relay() -> i32 ! Primary {
  return run primary()
}

effect fn replace(error: Primary) -> i32 ! Secondary {
  drop error
  fail Secondary {}
}

effect fn replacement() -> i32 ! Secondary {
  return run Intrinsic.catchFailure<Primary>(relay(), replace)
}

effect fn quiet(error: Secondary) -> i32 {
  drop error
  return 42
}

effect fn terminal(error: Secondary) -> i32 {
  drop error
  return usize.toI32(Intrinsic.observeUnhandled())
}

effect fn application(iterations: i32) -> i32 {
  let mut index = 0
  let mut total = 0
  while index < iterations {
    let value = run Intrinsic.catchFailure<Secondary>(replacement(), quiet)
    total = total + value
    index = index + 1
  }
  if total != iterations * 42 {
    return 94
  }
  return run Intrinsic.catchFailure<Secondary>(replacement(), terminal)
}

effect fn probe(mode: i32) -> i32 {
  let mut capacity: usize = 8
  let mut bytes: usize = 2048
  let mut frames: usize = 8
  let mut iterations = 0
  if mode == 1 {
    capacity = 0
  }
  if mode == 2 {
    capacity = 1
  }
  if mode == 3 {
    capacity = 2
  }
  if mode == 4 {
    bytes = 10
  }
  if mode == 5 {
    frames = 1
  }
  if mode == 9 {
    iterations = 64
  }
  let observer = run NativeDiagnostics.make(NativeReport.make(2, bytes, frames), capacity)
  let observed = NativeDiagnostics.observe(move observer, application(iterations))
  if mode == 10 {
    drop observed
    return 42
  }
  return run move observed
}

export "C" fn context_render_probe(mode: i32) -> i32 {
  return run probe(mode)
}

import silk.allocator {OutOfMemoryError, Allocator}

import silk.effect {Effect}

import silk.execution { Execution, Wake }

struct EmptyWake {}

struct OwnedWake {
  wake: Wake
}

struct Guard {
  wake: EmptyWake | OwnedWake
  notify: bool
}

impl Drop for Guard {
  fn drop(self: &mut Guard) -> () {
    if self.notify {
      let previous = Intrinsic.replace(self.wake, EmptyWake {})
      return match move previous {
        EmptyWake {} => ()
        OwnedWake {wake} => Execution.wake(move wake)
      }
    }
    return ()
  }
}

fn register(wake: Wake, notify: bool) -> Guard {
  return Guard {wake: OwnedWake {wake: move wake}, notify: notify}
}

effect fn parked(error: Primary, notify: bool) -> i32 {
  drop error
  run Execution.park(register(notify))
  return 93
}

effect fn observedParking(notify: bool) -> i32 {
  let observer = run NativeDiagnostics.make(NativeReport.make(2, 2048, 8), 8)
  return run NativeDiagnostics.observe(
    move observer,
    Intrinsic.catchFailure<Primary>(relay(), parked(notify)),
  )
}

struct Status {
  code: i32
}

fn ready(state: &()) -> () {}

fn completed(status: &mut Status, value: i32) -> () {
  status.code = 94
}

fn cancelled(status: &mut Status, execution: Intrinsic.Execution<i32>) -> () {
  drop execution
  status.code = 42
}

effect fn cancellation(notify: bool) -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let execution = run Execution.make(observedParking(notify), (), ready)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut status = Status {code: 95}
  run Execution.drive(move execution, &mut status, completed, cancelled)
  return status.code
}

effect fn noStorage(error: OutOfMemoryError) -> i32 {
  drop error
  return 96
}

export "C" fn context_cancel_probe(mode: i32) -> i32 {
  return run Intrinsic.catchFailure<OutOfMemoryError>(cancellation(mode == 1), noStorage)
}

effect fn fatalRecovery(error: Secondary, divisor: i32) -> i32 {
  drop error
  return 42 / divisor
}

effect fn fatalBody(mode: i32) -> i32 {
  if mode == 0 {
    return run Intrinsic.catchFailure<Secondary>(replacement(), fatalRecovery(mode))
  }
  return 42 / (mode - 1)
}

effect fn fatalProbe(mode: i32) -> i32 {
  let observer = run NativeDiagnostics.make(NativeReport.make(2, 2048, 8), 8)
  return run NativeDiagnostics.observe(move observer, fatalBody(mode))
}

export "C" fn context_fatal_probe(mode: i32) -> i32 {
  return run fatalProbe(mode)
}
