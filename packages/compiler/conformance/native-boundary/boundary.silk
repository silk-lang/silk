import silk.pointer { Pointer }
import silk.layout { Layout }
import silk.output { Uninitialized, Initialized }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.effect { Effect }
import silk.option { Option }

unsafe extern "C" fn c_i8() -> i8
unsafe extern "C" fn c_u16() -> u16
export "C" fn silk_i8() -> i8 { return unsafe c_i8() }
export "C" fn silk_u16() -> u16 { return unsafe c_u16() }

unsafe extern "C" fn c_scalars(a: i8, b: u8, c: i16, d: u16, e: i32, f: u32, g: i64, h: u64, i: isize, j: usize, k: f32, l: f64) -> i32
unsafe extern "C" fn c_nested(values: ?[*]const ?[*]const u8) -> i32
unsafe extern "C" fn c_initialize(value: *mut i32) -> ()

export "C" fn silk_scalars(a: i8, b: u8, c: i16, d: u16, e: i32, f: u32, g: i64, h: u64, i: isize, j: usize, k: f32, l: f64) -> i32 {
  if a != -7 || b != 250 || c != -300 || d != 60000 { return 1 }
  if e != -70000 || f != 4000000000 || g != -4294967297 || h != 18446744073709551614 { return 2 }
  if i != -19 || j != 5000000000 || k != 1.5 || l != -2.25 { return 3 }
  return unsafe c_scalars(a, b, c, d, e, f, g, h, i, j, k, l)
}

unsafe extern "C" fn c_invoke(callback: extern "C" fn(*const i32) -> i32, value: *const i32) -> i32
  with Intrinsic.foreign(callbacks: ("callback",))
export "C" fn silk_invoke(value: *const i32) -> i32 {
  return unsafe c_invoke(silk_callback, value)
}

export "C" fn silk_callback(value: *const i32) -> i32 {
  return unsafe Pointer.read(value)
}

export "C" fn silk_pointers(out: *mut i32, bytes: ?[*]mut u8, count: usize, nested: ?[*]const ?[*]const u8, unaligned: *mut align(1) i32) -> i32 {
  if Pointer.isNullMany(bytes) || count == 0 { return 4 }
  unsafe {
    Pointer.write(out, 42)
    let many = Intrinsic.pointerRequalify<?[*]mut u8, [*]mut u8>(bytes)
    let last = Pointer.atMut(many, count - 1)
    Pointer.write(last, 91)
    Pointer.writeUnaligned(unaligned, 1234567)
    if Pointer.readUnaligned(unaligned) != 1234567 { return 5 }
    return c_nested(nested)
  }
}

extern "C" struct Packet {
  lead: u8
  wide: u64
  tail: [u16; 3]
}
impl Copy for Packet {}

export "C" fn silk_packet(value: *const Packet, size: usize, alignment: usize) -> i32 {
  let layout = Layout.of<Packet>()
  if layout.bytes != size || layout.alignment != alignment { return 6 }
  let packet = unsafe Pointer.read(value)
  if packet.lead != 7 || packet.wide != 4294967297 || packet.tail[2] != 60000 { return 7 }
  return 42
}

effect fn fill() -> i32 ! OutOfMemoryError ? &mut Allocator {
  let mut output = run Uninitialized<i32>.make()
  let address = Uninitialized<i32>.address(&mut output)
  unsafe {
    c_initialize(address)
    let initialized = Uninitialized<i32>.assumeInitialized(move output)
    return Initialized<i32>.into(move initialized)
  }
}
effect fn recover(error: OutOfMemoryError) -> i32 { return 8 }
export "C" fn silk_output() -> i32 {
  let mut allocator = Allocator.systemAllocatorProvider()
  let filling = fill() |> Effect.provideMut<Allocator>(&mut allocator)
  return run Effect.catchAll(move filling, recover)
}


unsafe extern "C" fn c_empty(bytes: ?[*]const u8, length: usize) -> i32
export "C" fn silk_empty() -> i32 {
  let empty: [u8; 0] = []
  let checked = Pointer.nonNull<i32>(Pointer.null<i32>())
  let nullResult = match move checked {
    Option<*const i32>.Some { value } => 1
    Option<*const i32>.None => 42
  }
  if nullResult != 42 { return 18 }
  return unsafe c_empty(Pointer.fromSlice(&empty), 0)
}
