import silk.allocator { Allocator, OutOfMemoryError }
import silk.bytes { Bytes }
import silk.effect { Effect }
import silk.filesystem { FileError, FileSystem, Path }
import silk.layout { Layout }
import silk.native_file_trust_source { NativeFileTrustSource }
import silk.option { Option }
import silk.result { Result }
import silk.trust_snapshot {
  TrustFileOperation,
  TrustConfigurationReason,
  TrustLimitKind,
  TrustLoadLimits,
  TrustSnapshot,
  TrustSourceError,
}
import silk.trust_source { TrustSource }
import silk.u8
import silk.usize

fn fileCode(error: &FileError) -> i32 {
  let code = FileSystem.providerCode(error)
  return match move code {
    Option<i32>.Some { value } => value
    Option<i32>.None => 50
  }
}

effect fn rejected(failure: TrustSourceError) -> i32 {
  return match move failure {
    TrustSourceError.File { operation, error: file } => {
      let native = fileCode(&file)
      let reason = FileSystem.reasonCode(move file.reason)
      if operation == TrustFileOperation.Open {
        if native == 0 && reason != FileSystem.reasonCode(FileSystem.wrongType()) { return 199 }
        return 100 + native
      }
      if operation == TrustFileOperation.Read { return 120 + native }
      return 140 + native
    }
    TrustSourceError.InvalidConfiguration { reason } => 160
    TrustSourceError.LimitExceeded { kind, limit } => {
      if kind == TrustLimitKind.InputBytes { return 170 }
      return 171
    }
    TrustSourceError.Decode { error: decode } => 180
  }
}

fn limits(inputBytes: usize) -> TrustLoadLimits {
  let mut value = TrustLoadLimits.defaults()
  value.decode.inputBytes = inputBytes
  return value
}

effect fn load(
  source: &mut NativeFileTrustSource,
  inputBytes: usize,
) -> TrustSnapshot
! TrustSourceError | OutOfMemoryError
? &mut Allocator {
  return run TrustSource.load(limits(inputBytes))
    |> Effect.provideMut<TrustSource>(move source)
}

effect fn attempt(root: &[u8], inputBytes: usize) -> i32
! FileError | TrustSourceError | OutOfMemoryError
? &mut Allocator {
  let path = run Path.fromBytes(b"/file")
  let mut source = run NativeFileTrustSource.make(root, &path)
  let snapshot = run load(&mut source, inputBytes)
  drop source
  let anchors = TrustSnapshot.anchors(&snapshot)
  return usize.toI32(anchors.length)
}

effect fn loadOnce(root: &[u8], inputBytes: usize) -> i32
! FileError | OutOfMemoryError
? &mut Allocator {
  return run Effect.catch<TrustSourceError>(attempt(root, inputBytes), rejected)
}

effect fn reload(root: &[u8], failSecond: bool) -> i32
! FileError | TrustSourceError | OutOfMemoryError
? &mut Allocator {
  let path = run Path.fromBytes(b"/file")
  let mut source = run NativeFileTrustSource.make(root, &path)
  let first = run TrustSource.load(limits(603))
    |> Effect.provideMut<TrustSource>(&mut source)
  let mut secondLimit: usize = 603
  if !failSecond { secondLimit = 1206 }
  let second: Result<TrustSnapshot, TrustSourceError | OutOfMemoryError> = run Effect.result(
    TrustSource.load(limits(secondLimit))
      |> Effect.provideMut<TrustSource>(&mut source),
  )
  drop source
  let firstAnchors = TrustSnapshot.anchors(&first)
  if firstAnchors.length != usize.ONE { return 1 }
  return match move second {
    Result<TrustSnapshot, TrustSourceError | OutOfMemoryError>.Success { value } => {
      let secondAnchors = TrustSnapshot.anchors(&value)
      if !failSecond && secondAnchors.length == usize.ONE + usize.ONE { return 42 }
      return 2
    }
    Result<TrustSnapshot, TrustSourceError | OutOfMemoryError>.Failure { error: failure } => match move failure {
      TrustSourceError trust => {
        if failSecond { return run rejected(move trust) }
        return 3
      }
      OutOfMemoryError memory => 4
    }
  }
}

struct RefusingAllocator {}

effect fn refuse(self: &mut RefusingAllocator, layout: Layout) -> Intrinsic.Allocation ! OutOfMemoryError {
  return run Allocator.outOfMemory()
}

impl Allocator for RefusingAllocator { allocate: RefusingAllocator.refuse }

effect fn refused() -> i32 ! FileError | TrustSourceError | OutOfMemoryError {
  let mut system = Allocator.systemAllocatorProvider()
  let path = run Path.fromBytes(b"/file") |> Effect.provideMut<Allocator>(&mut system)
  let mut source = run NativeFileTrustSource.make(b"/case12", &path)
    |> Effect.provideMut<Allocator>(&mut system)
  let mut allocator = RefusingAllocator {}
  let snapshot = run load(&mut source, 603) |> Effect.provideMut<Allocator>(&mut allocator)
  drop snapshot
  return 1
}

effect fn constructionRefused() -> i32 ! FileError | TrustSourceError | OutOfMemoryError {
  let mut system = Allocator.systemAllocatorProvider()
  let path = run Path.fromBytes(b"/file") |> Effect.provideMut<Allocator>(&mut system)
  let mut allocator = RefusingAllocator {}
  let source = run NativeFileTrustSource.make(b"/never-opened", &path)
    |> Effect.provideMut<Allocator>(&mut allocator)
  drop source
  return 1
}

effect fn ownedInputs() -> i32 ! FileError | TrustSourceError | OutOfMemoryError
? &mut Allocator {
  let mut root = run Bytes.copy(b"/case16")
  let path = run Path.fromBytes(b"/file")
  let mut source = run NativeFileTrustSource.make(Bytes.asSlice(&root), &path)
  let mut changed = Bytes.asMutSlice(&mut root)
  changed[usize.ONE] = u8.toU8(120)
  drop changed
  drop root
  drop path
  let snapshot = run load(&mut source, 603)
  drop source
  let anchors = TrustSnapshot.anchors(&snapshot)
  return usize.toI32(anchors.length)
}

effect fn rejectsConfiguration(
  root: &[u8],
  path: &Path,
  expected: TrustConfigurationReason,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  let result = run Effect.result(NativeFileTrustSource.make(root, path))
  return match move result {
    Result<NativeFileTrustSource, TrustSourceError | OutOfMemoryError>.Success { value } => false
    Result<NativeFileTrustSource, TrustSourceError | OutOfMemoryError>.Failure { error: failure } => match move failure {
      TrustSourceError.InvalidConfiguration { reason } => reason == expected
      TrustSourceError other => false
      OutOfMemoryError memory => { fail move memory }
    }
  }
}

effect fn suite() -> i32 ! FileError | TrustSourceError | OutOfMemoryError ? &mut Allocator {
  let configurationPath = run Path.fromBytes(b"/file")
  if !(run rejectsConfiguration(b"", &configurationPath, TrustConfigurationReason.EmptyRoot)) {
    return 5
  }
  if !(run rejectsConfiguration(b"relative", &configurationPath, TrustConfigurationReason.NonAbsoluteRoot)) {
    return 6
  }
  if !(run rejectsConfiguration(b"/\x00root", &configurationPath, TrustConfigurationReason.NulRoot)) {
    return 7
  }
  let mut oversized = run Bytes.zeroed(4096)
  let mut oversizedBytes = Bytes.asMutSlice(&mut oversized)
  let mut oversizedIndex = usize.ZERO
  while oversizedIndex < oversizedBytes.length {
    oversizedBytes[oversizedIndex] = u8.toU8(97)
    oversizedIndex = oversizedIndex + usize.ONE
  }
  oversizedBytes[usize.ZERO] = u8.toU8(47)
  drop oversizedBytes
  if !(run rejectsConfiguration(Bytes.asSlice(&oversized), &configurationPath, TrustConfigurationReason.PathBytes)) {
    return 8
  }
  let case0 = run loadOnce(b"/case0", 1206)
  if case0 != 2 { return 10 }
  let case1 = run loadOnce(b"/case1", 1206)
  if case1 != 2 { return 11 }
  let case2 = run loadOnce(b"/case2", 603)
  if case2 != 1 { return 12 }
  let case3 = run loadOnce(b"/case3", 602)
  if case3 != 170 { return 13 }
  let case4 = run loadOnce(b"/case4", usize.ZERO)
  if case4 != 170 { return 14 }
  let case5 = run loadOnce(b"/case5", 603)
  if case5 != 125 { return 15 }
  let case6 = run loadOnce(b"/case6", 603)
  if case6 != 149 { return 16 }
  let case7 = run loadOnce(b"/case7", 603)
  if case7 != 113 { return 17 }
  let case8 = run loadOnce(b"/case8", 1206)
  if case8 != 180 { return 18 }
  let case9 = run loadOnce(b"/case9", 1206)
  if case9 != 180 { return 19 }
  let case10 = run reload(b"/case10", false)
  if case10 != 42 { return 20 }
  let case11 = run reload(b"/case11", true)
  if case11 != 125 { return 21 }
  let refusedResult = run Effect.result(refused())
  let refusedCode = match move refusedResult {
    Result<i32, FileError | TrustSourceError | OutOfMemoryError>.Success { value } => value
    Result<i32, FileError | TrustSourceError | OutOfMemoryError>.Failure { error: failure } => match move failure {
      FileError file => 191
      TrustSourceError trust => run rejected(move trust)
      OutOfMemoryError memory => 190
    }
  }
  if refusedCode != 190 { return 22 }
  let constructionResult = run Effect.result(constructionRefused())
  let constructionCode = match move constructionResult {
    Result<i32, FileError | TrustSourceError | OutOfMemoryError>.Success { value } => value
    Result<i32, FileError | TrustSourceError | OutOfMemoryError>.Failure { error: failure } => match move failure {
      FileError file => 191
      TrustSourceError trust => run rejected(move trust)
      OutOfMemoryError memory => 190
    }
  }
  if constructionCode != 190 { return 27 }
  let case13 = run loadOnce(b"/case13", 603)
  if case13 != 100 { return 23 }
  let case14 = run loadOnce(b"/case14", 603)
  if case14 != 140 && case14 != 162 { return 24 }
  let case15 = run loadOnce(b"/case15", 603)
  if case15 != 102 { return 25 }
  let case16 = run ownedInputs()
  if case16 != 1 { return 26 }
  let case17 = run loadOnce(b"/case17", 602)
  if case17 != 170 { return 28 }
  return 42
}

effect fn fileExit(error: FileError) -> i32 { return 191 }
effect fn trustExit(error: TrustSourceError) -> i32 { return run rejected(move error) }
effect fn memoryExit(error: OutOfMemoryError) -> i32 { return 190 }

effect fn allocated() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run suite()
    |> Effect.provideMut<Allocator>(&mut allocator)
    |> Effect.catch<FileError>(fileExit)
    |> Effect.catch<TrustSourceError>(trustExit)
}

export "C" fn trust_fixture() -> i32 as "trust_fixture" {
  return run Effect.catchAll(allocated(), memoryExit)
}
