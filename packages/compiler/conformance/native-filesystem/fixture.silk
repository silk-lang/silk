import silk.native_filesystem { NativeFileSystem, FileHandle }
import silk.filesystem { FileSystem, FileError }
import silk.effect { Effect }
import silk.result { Result }
import silk.option { Option }
import silk.u8
import silk.u64
import silk.allocator { Allocator, OutOfMemoryError }
import silk.execution { Execution, Wake }

effect fn failed(error: FileError) -> i32 {
  let native = FileSystem.providerCode(&error)
  return match move native {
    Option<i32>.Some { value } => 100 + value
    Option<i32>.None => 199
  }
}
effect fn transfer(writing: bool, empty: bool) -> i32 ! FileError {
  let mut handle = run NativeFileSystem.openFile(b"/sandbox", b"/file", writing, 0)
  let attempted = run Effect.result(transfers(&mut handle, writing, empty))
  let closed = run Effect.result(NativeFileSystem.closeFile(move handle, FileSystem.readFileOperation()))
  return match move attempted {
    Result<i32, FileError>.Failure { error } => run failed(move error)
    Result<i32, FileError>.Success { value } => match move closed {
      Result<(), FileError>.Failure { error } => run failed(move error)
      Result<(), FileError>.Success { value: ignored } => value
    }
  }
}
effect fn transfers(handle: &mut FileHandle, writing: bool, empty: bool) -> i32 ! FileError {
  if writing {
    if empty { run NativeFileSystem.writeFile(move handle, b"", 0) } else {
      run NativeFileSystem.writeFile(move handle, b"abcdef", 0)
    }
  } else {
    let mut buffer: [u8; 4] = [9, 9, 9, 9]
    if empty {
      let mut none: [u8; 0] = []
      let received = run NativeFileSystem.readFile(move handle, &mut none, 0)
      if received != 0 { return 1 }
    } else {
      let received = run NativeFileSystem.readFile(move handle, &mut buffer, 0)
      if received != 0 && received != 2 { return 2 }
      if received == 2 && (buffer[0] != u8.toU8(1) || buffer[1] != u8.toU8(2)) { return 3 }
      if buffer[2] != u8.toU8(9) || buffer[3] != u8.toU8(9) { return 4 }
    }
  }
  return 42
}
export "C" fn transfer_fixture(writing: i32, empty: i32) -> i32 {
  return run Effect.catchAll(transfer(writing != 0, empty != 0), failed)
}
effect fn listing() -> i32 ! FileError {
  let mut handle = run NativeFileSystem.openDirectory(b"/sandbox", b"/dir", 3)
  let mut small: [u8; 1] = [9]
  let mut large: [u8; 8] = [9,9,9,9,9,9,9,9]
  let mut count: usize = 0
  let mut required: usize = 0
  let mut kind = 0
  let first = run NativeFileSystem.next(&mut handle, &mut small, &mut count, &mut required, &mut kind, 3)
  if first || count != 0 || required != 4 || small[0] != u8.toU8(9) { return 5 }
  let second = run NativeFileSystem.next(&mut handle, &mut large, &mut count, &mut required, &mut kind, 3)
  if second == false || count != 4 || kind != 0 { return 6 }
  if large[0] != u8.toU8(255) || large[1] != u8.toU8(97) || large[4] != u8.toU8(9) { return 7 }
  let end = run NativeFileSystem.next(&mut handle, &mut large, &mut count, &mut required, &mut kind, 3)
  if end == false || count != 0 { return 8 }
  let latched = run NativeFileSystem.next(&mut handle, &mut large, &mut count, &mut required, &mut kind, 3)
  if latched == false || count != 0 { return 9 }
  run NativeFileSystem.closeDirectory(move handle, FileSystem.listDirectoryOperation())
  return 42
}
export "C" fn list_fixture() -> i32 { return run Effect.catchAll(listing(), failed) }
effect fn inspect(path: &[u8]) -> i32 ! FileError {
  let mut kind = 0
  let mut size: usize = 0
  run NativeFileSystem.inspect(b"/sandbox", path, &mut kind, &mut size, 2)
  if kind != 0 || size != 123 { return 10 }
  return 42
}
export "C" fn inspect_fixture(invalid: i32) -> i32 {
  if invalid == 1 { return run Effect.catchAll(inspect(b"/../outside"), failed) }
  if invalid == 2 { return run Effect.catchAll(inspect(b"/a//b"), failed) }
  if invalid == 3 { return run Effect.catchAll(inspect(b"/a/./b"), failed) }
  if invalid == 4 { let bytes: [u8; 3] = [47,0,97]
    return run Effect.catchAll(inspect(&bytes), failed) }
  if invalid == 5 { let bytes: [u8; 2] = [47,255]
    return run Effect.catchAll(inspect(&bytes), failed) }
  return run Effect.catchAll(inspect(b"/nested/file"), failed)
}
