effect fn unique() -> i32 ! FileError {
  let mut counter: u64 = 0
  let mut output: [u8; 32] = [9,9,9,9,9,9,9,9,9,9,9,9,9,9,9,9,9,9,9,9,9,9,9,9,9,9,9,9,9,9,9,9]
  let mut small: [u8; 1] = [9]
  let mut count: usize = 0
  let mut required: usize = 0
  let first = run NativeFileSystem.createUnique(b"/sandbox", b"/dir", b"tmp", &mut counter, &mut small, &mut count, &mut required, 8)
  if first || required != 20 || counter != u64.toU64(0) { return 11 }
  let second = run NativeFileSystem.createUnique(b"/sandbox", b"/dir", b"tmp", &mut counter, &mut output, &mut count, &mut required, 8)
  if second == false || count != 20 { return 12 }
  return 42
}
export "C" fn unique_fixture() -> i32 { return run Effect.catchAll(unique(), failed) }
struct Endpoint {}
struct Guard { wake: Wake }
fn register(wake: Wake) -> Guard { return Guard { wake: move wake } }
fn ready(endpoint: &Endpoint) -> () { return () }
effect fn parked() -> i32 ! FileError {
  let handle = run NativeFileSystem.openFile(b"/sandbox", b"/file", false, 0)
  run Execution.park(register)
  run NativeFileSystem.closeFile(move handle, FileSystem.readFileOperation())
  return 42
}
effect fn parkedHandled() -> i32 { return run Effect.catchAll(parked(), failed) }
fn complete(state: &mut (), value: i32) -> () { return () }
fn cancel(state: &mut (), execution: Intrinsic.Execution<i32>) -> () { drop execution }
effect fn cancellation() -> i32 ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let execution = run Execution.make(parkedHandled(), Endpoint {}, ready) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut state = ()
  run Execution.drive(move execution, &mut state, complete, cancel)
  return 42
}
effect fn exhausted(error: OutOfMemoryError) -> i32 { return 250 }
export "C" fn cancellation_fixture() -> i32 { return run Effect.catchAll(cancellation(), exhausted) }
