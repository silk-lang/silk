{
  "name": "@silklang/editor-support",
  "version": "0.0.0",
  "private": true,
  "description": "Portable Silk editor support: CodeMirror integration, TextMate grammar, protocol projections, and the <silk-snippet> custom element.",
  "keywords": [
    "codemirror",
    "silk",
    "syntax-highlighting",
    "textmate"
  ],
  "homepage": "https://github.com/julia-script/silk#readme",
  "bugs": {
    "url": "https://github.com/julia-script/silk/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julia-script/silk.git",
    "directory": "packages/editor-support"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./CodeMirror": {
      "types": "./dist/CodeMirror.d.ts",
      "import": "./dist/CodeMirror.js"
    },
    "./TextMate": {
      "types": "./dist/TextMate.d.ts",
      "import": "./dist/TextMate.js"
    },
    "./Editor": {
      "types": "./dist/Editor.d.ts",
      "import": "./dist/Editor.js"
    },
    "./Element": {
      "types": "./dist/Element.d.ts",
      "import": "./dist/Element.js"
    },
    "./HoverContent": {
      "types": "./dist/HoverContent.d.ts",
      "import": "./dist/HoverContent.js"
    },
    "./register": {
      "types": "./dist/register.d.ts",
      "import": "./dist/register.js"
    },
    "./bundle": "./dist/silk-snippet.bundle.js"
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.json && node scripts/bundle.mjs",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "sync:vscode": "node scripts/sync-vscode.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@codemirror/commands": "^6.10.4",
    "@codemirror/language": "^6.12.4",
    "@codemirror/lint": "^6.9.1",
    "@codemirror/state": "^6.7.1",
    "@codemirror/view": "^6.43.8",
    "@lezer/highlight": "^1.2.3",
    "@silklang/compiler": "workspace:*",
    "@silklang/docgen": "workspace:*",
    "@silklang/lsp": "workspace:*",
    "effect": "catalog:",
    "mdast-util-from-markdown": "^2.0.3",
    "vscode-languageserver-types": "3.17.5"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.10.1",
    "esbuild": "^0.28.2",
    "jsdom": "^30.0.1",
    "shiki": "^4.4.2"
  }
}
