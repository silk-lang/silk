{
  "name": "@silklang/cli",
  "version": "0.0.0",
  "description": "Command line interface for the Silk bootstrap compiler.",
  "keywords": [
    "cli",
    "compiler",
    "effect",
    "typescript"
  ],
  "homepage": "https://github.com/julia-script/silk#readme",
  "bugs": {
    "url": "https://github.com/julia-script/silk/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julia-script/silk.git",
    "directory": "packages/cli"
  },
  "bin": {
    "silk": "./dist/bin.js"
  },
  "files": [
    "dist",
    "README.md",
    "LICENSE"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./Cli": {
      "types": "./dist/Cli.d.ts",
      "import": "./dist/Cli.js"
    },
    "./BuildCommand": {
      "types": "./dist/BuildCommand.d.ts",
      "import": "./dist/BuildCommand.js"
    },
    "./BuildBatch": {
      "types": "./dist/BuildBatch.d.ts",
      "import": "./dist/BuildBatch.js"
    },
    "./BuildExeCommand": {
      "types": "./dist/BuildExeCommand.d.ts",
      "import": "./dist/BuildExeCommand.js"
    },
    "./BuildPlan": {
      "types": "./dist/BuildPlan.d.ts",
      "import": "./dist/BuildPlan.js"
    },
    "./CheckCommand": {
      "types": "./dist/CheckCommand.d.ts",
      "import": "./dist/CheckCommand.js"
    },
    "./DocCommand": {
      "types": "./dist/DocCommand.d.ts",
      "import": "./dist/DocCommand.js"
    },
    "./DocumentationWorkflow": {
      "types": "./dist/DocumentationWorkflow.d.ts",
      "import": "./dist/DocumentationWorkflow.js"
    },
    "./DocumentationSiteCommand": {
      "types": "./dist/DocumentationSiteCommand.d.ts",
      "import": "./dist/DocumentationSiteCommand.js"
    },
    "./DoctestCommand": {
      "types": "./dist/DoctestCommand.d.ts",
      "import": "./dist/DoctestCommand.js"
    },
    "./FormatCommand": {
      "types": "./dist/FormatCommand.d.ts",
      "import": "./dist/FormatCommand.js"
    },
    "./FormatWorkflow": {
      "types": "./dist/FormatWorkflow.d.ts",
      "import": "./dist/FormatWorkflow.js"
    },
    "./InitCommand": {
      "types": "./dist/InitCommand.d.ts",
      "import": "./dist/InitCommand.js"
    },
    "./Program": {
      "types": "./dist/Program.d.ts",
      "import": "./dist/Program.js"
    },
    "./ProjectOptions": {
      "types": "./dist/ProjectOptions.d.ts",
      "import": "./dist/ProjectOptions.js"
    },
    "./ProjectInitializer": {
      "types": "./dist/ProjectInitializer.d.ts",
      "import": "./dist/ProjectInitializer.js"
    },
    "./Report": {
      "types": "./dist/Report.d.ts",
      "import": "./dist/Report.js"
    },
    "./RunCommand": {
      "types": "./dist/RunCommand.d.ts",
      "import": "./dist/RunCommand.js"
    },
    "./TestCommand": {
      "types": "./dist/TestCommand.d.ts",
      "import": "./dist/TestCommand.js"
    },
    "./TestExchange": {
      "types": "./dist/TestExchange.d.ts",
      "import": "./dist/TestExchange.js"
    },
    "./TestResult": {
      "types": "./dist/TestResult.d.ts",
      "import": "./dist/TestResult.js"
    },
    "./Workflow": {
      "types": "./dist/Workflow.d.ts",
      "import": "./dist/Workflow.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "doctest:stdlib": "node dist/bin.js doctest --stdlib",
    "stdlib:docs:check": "node scripts/format-stdlib-docs.mjs --check",
    "stdlib:docs:format": "node scripts/format-stdlib-docs.mjs",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.117",
    "@silklang/compiler": "workspace:*",
    "@silklang/docgen": "workspace:*",
    "@silklang/formatter": "workspace:*",
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "^24.10.1",
    "effect-inspect": "catalog:"
  },
  "peerDependencies": {
    "effect-inspect": "catalog:"
  },
  "peerDependenciesMeta": {
    "effect-inspect": {
      "optional": true
    }
  }
}
