{
  "name": "@silklang/llvm",
  "version": "0.0.0",
  "description": "LLVM integration primitives for Silk.",
  "keywords": [
    "effect",
    "llvm",
    "typescript"
  ],
  "homepage": "https://github.com/julia-script/silk#readme",
  "bugs": {
    "url": "https://github.com/julia-script/silk/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julia-script/silk.git",
    "directory": "packages/llvm"
  },
  "files": [
    "dist",
    "docs",
    "README.md",
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
    "UPSTREAM.md"
  ],
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./AddrSpace": {
      "types": "./dist/AddrSpace.d.ts",
      "import": "./dist/AddrSpace.js"
    },
    "./Alias": {
      "types": "./dist/Alias.d.ts",
      "import": "./dist/Alias.js"
    },
    "./Alignment": {
      "types": "./dist/Alignment.d.ts",
      "import": "./dist/Alignment.js"
    },
    "./Attribute": {
      "types": "./dist/Attribute.d.ts",
      "import": "./dist/Attribute.js"
    },
    "./Bitcode": {
      "types": "./dist/Bitcode.d.ts",
      "import": "./dist/Bitcode.js"
    },
    "./Block": {
      "types": "./dist/Block.d.ts",
      "import": "./dist/Block.js"
    },
    "./Builder": {
      "types": "./dist/Builder.d.ts",
      "import": "./dist/Builder.js"
    },
    "./ByteString": {
      "types": "./dist/ByteString.d.ts",
      "import": "./dist/ByteString.js"
    },
    "./Constant": {
      "types": "./dist/Constant.d.ts",
      "import": "./dist/Constant.js"
    },
    "./DataLayout": {
      "types": "./dist/DataLayout.d.ts",
      "import": "./dist/DataLayout.js"
    },
    "./DIFlags": {
      "types": "./dist/DIFlags.d.ts",
      "import": "./dist/DIFlags.js"
    },
    "./DISPFlags": {
      "types": "./dist/DISPFlags.d.ts",
      "import": "./dist/DISPFlags.js"
    },
    "./Function": {
      "types": "./dist/Function.d.ts",
      "import": "./dist/Function.js"
    },
    "./FunctionBody": {
      "types": "./dist/FunctionBody.d.ts",
      "import": "./dist/FunctionBody.js"
    },
    "./Emitter": {
      "types": "./dist/Emitter.d.ts",
      "import": "./dist/Emitter.js"
    },
    "./FastMath": {
      "types": "./dist/FastMath.d.ts",
      "import": "./dist/FastMath.js"
    },
    "./Global": {
      "types": "./dist/Global.d.ts",
      "import": "./dist/Global.js"
    },
    "./IrText": {
      "types": "./dist/IrText.d.ts",
      "import": "./dist/IrText.js"
    },
    "./Intrinsic": {
      "types": "./dist/Intrinsic.d.ts",
      "import": "./dist/Intrinsic.js"
    },
    "./IntegerMath": {
      "types": "./dist/IntegerMath.d.ts",
      "import": "./dist/IntegerMath.js"
    },
    "./MemoryAccess": {
      "types": "./dist/MemoryAccess.d.ts",
      "import": "./dist/MemoryAccess.js"
    },
    "./Metadata": {
      "types": "./dist/Metadata.d.ts",
      "import": "./dist/Metadata.js"
    },
    "./LlvmError": {
      "types": "./dist/LlvmError.d.ts",
      "import": "./dist/LlvmError.js"
    },
    "./Type": {
      "types": "./dist/Type.d.ts",
      "import": "./dist/Type.js"
    },
    "./Variable": {
      "types": "./dist/Variable.d.ts",
      "import": "./dist/Variable.js"
    },
    "./Value": {
      "types": "./dist/Value.d.ts",
      "import": "./dist/Value.js"
    },
    "./Verify": {
      "types": "./dist/Verify.d.ts",
      "import": "./dist/Verify.js"
    }
  },
  "publishConfig": {
    "access": "public",
    "provenance": true
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "fixtures:regenerate": "node scripts/foundation-fixtures.mjs regenerate && pnpm build && node scripts/declaration-fixtures.mjs regenerate && node scripts/core-fixtures.mjs regenerate && node scripts/advanced-fixtures.mjs regenerate && node scripts/metadata-fixtures.mjs regenerate",
    "fixtures:verify": "node scripts/foundation-fixtures.mjs verify && node scripts/declaration-fixtures.mjs verify && node scripts/core-fixtures.mjs verify && node scripts/advanced-fixtures.mjs verify && node scripts/metadata-fixtures.mjs verify",
    "parity:corpus": "node scripts/parity-corpus.mjs",
    "parity:bench": "pnpm build && node scripts/parity-benchmark.mjs --write",
    "parity:determinism": "node scripts/parity-determinism.mjs",
    "parity:report": "node scripts/parity-validate.mjs --write-report",
    "parity:stress": "pnpm build && node scripts/parity-stress.mjs",
    "parity:validate": "node scripts/parity-validate.mjs",
    "runtime:smoke": "node scripts/runtime-smoke.mjs",
    "test": "vitest run --passWithNoTests && node scripts/parity-validate.mjs",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json",
    "upstream:candidate": "node scripts/upstream-candidate.mjs"
  },
  "dependencies": {
    "effect": "catalog:"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "^24.10.1"
  }
}
