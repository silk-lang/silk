{
  "name": "@silklang/lsp",
  "version": "0.0.0",
  "private": true,
  "description": "Language Server Protocol server for Silk, powered by the bootstrap compiler analysis snapshot.",
  "keywords": [
    "effect",
    "language-server",
    "lsp",
    "silk"
  ],
  "homepage": "https://github.com/julia-script/silk#readme",
  "bugs": {
    "url": "https://github.com/julia-script/silk/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julia-script/silk.git",
    "directory": "packages/lsp"
  },
  "bin": {
    "silk-lsp": "./dist/bin.js"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./bin": "./dist/bin.js",
    "./Document": {
      "types": "./dist/Document.d.ts",
      "import": "./dist/Document.js"
    },
    "./Inspection": {
      "types": "./dist/Inspection.d.ts",
      "import": "./dist/Inspection.js"
    },
    "./LineIndex": {
      "types": "./dist/LineIndex.d.ts",
      "import": "./dist/LineIndex.js"
    },
    "./Server": {
      "types": "./dist/Server.d.ts",
      "import": "./dist/Server.js"
    },
    "./Workspace": {
      "types": "./dist/Workspace.d.ts",
      "import": "./dist/Workspace.js"
    }
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "bench:auto-import": "vitest run --config vitest.auto-import.config.ts --maxWorkers=1 --disableConsoleIntercept",
    "bench:pressure": "vitest run --config vitest.pressure.config.ts --maxWorkers=1 --disableConsoleIntercept",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@effect/platform-node": "4.0.0-rc.117",
    "@silklang/compiler": "workspace:*",
    "@silklang/docgen": "workspace:*",
    "@silklang/formatter": "workspace:*",
    "effect": "catalog:",
    "vscode-languageserver": "^9.0.1",
    "vscode-languageserver-textdocument": "^1.0.12",
    "vscode-languageserver-types": "3.17.5"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/node": "^24.10.1"
  }
}
