{
  "name": "@silklang/docgen",
  "version": "0.0.0",
  "private": true,
  "description": "Documentation generation, doctesting, and static rendering for Silk source.",
  "keywords": [
    "documentation",
    "markdown",
    "silk"
  ],
  "homepage": "https://github.com/julia-script/silk#readme",
  "bugs": {
    "url": "https://github.com/julia-script/silk/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julia-script/silk.git",
    "directory": "packages/docgen"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./Document": {
      "types": "./dist/Document.d.ts",
      "import": "./dist/Document.js"
    },
    "./CodeFence": {
      "types": "./dist/CodeFence.d.ts",
      "import": "./dist/CodeFence.js"
    },
    "./Json": {
      "types": "./dist/Json.d.ts",
      "import": "./dist/Json.js"
    },
    "./Highlight": {
      "types": "./dist/Highlight.d.ts",
      "import": "./dist/Highlight.js"
    },
    "./Project": {
      "types": "./dist/Project.d.ts",
      "import": "./dist/Project.js"
    },
    "./Doctest": {
      "types": "./dist/Doctest.d.ts",
      "import": "./dist/Doctest.js"
    },
    "./Example": {
      "types": "./dist/Example.d.ts",
      "import": "./dist/Example.js"
    },
    "./Report": {
      "types": "./dist/Report.d.ts",
      "import": "./dist/Report.js"
    },
    "./Sources": {
      "types": "./dist/Sources.d.ts",
      "import": "./dist/Sources.js"
    },
    "./Stdlib": {
      "types": "./dist/Stdlib.d.ts",
      "import": "./dist/Stdlib.js"
    },
    "./Html": {
      "types": "./dist/Html.d.ts",
      "import": "./dist/Html.js"
    },
    "./Model": {
      "types": "./dist/Model.d.ts",
      "import": "./dist/Model.js"
    },
    "./Prose": {
      "types": "./dist/Prose.d.ts",
      "import": "./dist/Prose.js"
    },
    "./Search": {
      "types": "./dist/Search.d.ts",
      "import": "./dist/Search.js"
    },
    "./Site": {
      "types": "./dist/Site.d.ts",
      "import": "./dist/Site.js"
    }
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\"",
    "dev": "tsc -p tsconfig.json --watch --preserveWatchOutput",
    "test": "vitest run --passWithNoTests",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.test.json"
  },
  "dependencies": {
    "@silklang/compiler": "workspace:*",
    "effect": "catalog:",
    "mdast-util-from-markdown": "^2.0.3"
  },
  "devDependencies": {
    "@effect/vitest": "catalog:",
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.10.1"
  }
}
