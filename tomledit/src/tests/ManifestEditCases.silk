//! Manifest edits add workspace members and path dependencies in place, keeping the rest of the
//! manifest as written.

import ManifestEdit as ManifestEdits { ManifestEditRefused }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.testing.testing { AssertionError, Testing }
import silk.num.usize

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

effect fn member(manifest: &[u8], entry: &[u8], expected: &[u8]) -> bool
  ! ManifestEditRefused | OutOfMemoryError
  ? &mut Allocator {
  let edited = run ManifestEdits.addMember(manifest, entry)
  return same(Bytes.asSlice(&edited), expected)
}

effect fn refusesMember(manifest: &[u8]) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  return match move run Effect.result(ManifestEdits.addMember(manifest, b"app")) {
    Result<Bytes, ManifestEditRefused | OutOfMemoryError>.Success { value: _ } => false
    Result<Bytes, ManifestEditRefused | OutOfMemoryError>.Failure { error } => match move error {
      ManifestEditRefused refused => {
        drop refused
        return true
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

effect fn memberPolicy() -> ()
  ! AssertionError<'static> | ManifestEditRefused | OutOfMemoryError
  ? &mut Allocator {
  let empty = run member(b"[workspace]\nmembers = []\n", b"app", b"[workspace]\nmembers = [\"app\"]\n")
  let inline = run member(
    b"[workspace]\nmembers = [\"compiler\", \"changes\"]\noutput-dir = \"build\"\n",
    b"tools/fmt",
    b"[workspace]\nmembers = [\"compiler\", \"changes\", \"tools/fmt\"]\noutput-dir = \"build\"\n"
  )
  let trailing = run member(b"[workspace]\nmembers = [\"a\",]", b"b", b"[workspace]\nmembers = [\"a\", \"b\"]\n")
  run Testing.expect(
    empty && inline && trailing,
    "a one-line members array gains the entry before its closing bracket"
  )
  let multiline = run member(
    b"[workspace]\nmembers = [\n    \"a\", # the app\n    \"b\"\n]\n",
    b"c",
    b"[workspace]\nmembers = [\n    \"a\", # the app\n    \"b\",\n    \"c\",\n]\n"
  )
  let emptyLines = run member(b"[workspace]\nmembers = [\n]\n", b"c", b"[workspace]\nmembers = [\n  \"c\",\n]\n")
  run Testing.expect(
    multiline && emptyLines,
    "a multi-line members array gains the entry on its own line, indented like the one before"
  )
  let keyless = run member(
    b"# root\n[workspace]\noutput-dir = \"out\"\n\n[package]\nname = \"root\"\n",
    b"app",
    b"# root\n[workspace]\nmembers = [\"app\"]\noutput-dir = \"out\"\n\n[package]\nname = \"root\"\n"
  )
  let bracketed = run member(
    b"[workspace]\nmembers = [\"a]\", 'b[' ] # [x]\n[package.x]\n",
    b"say \"hi\"",
    b"[workspace]\nmembers = [\"a]\", 'b[', \"say \\\"hi\\\"\" ] # [x]\n[package.x]\n"
  )
  run Testing.expect(
    keyless && bracketed,
    "a table without members gains the key, and brackets inside strings and comments are text"
  )
  let packageOnly = run refusesMember(b"[package]\nname = \"app\"\n")
  let notArray = run refusesMember(b"[workspace]\nmembers = \"app\"\n")
  run Testing.expect(packageOnly && notArray, "only a [workspace] table with a members array is edited")
}

test effect fn workspaceMembersAreAppendedInPlace() -> ()
  ! AssertionError<'static> | ManifestEditRefused | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run memberPolicy() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn dependency(manifest: &[u8], expected: &[u8]) -> bool
  ! ManifestEditRefused | OutOfMemoryError
  ? &mut Allocator {
  let edited = run ManifestEdits.addDependency(manifest, b"math", b"{ path = \"../math\" }")
  return same(Bytes.asSlice(&edited), expected)
}

effect fn removed(manifest: &[u8], expected: &[u8]) -> bool
  ! ManifestEditRefused | OutOfMemoryError
  ? &mut Allocator {
  let edited = run ManifestEdits.removeDependency(manifest, b"math")
  return same(Bytes.asSlice(&edited), expected)
}

effect fn refusesRemoval(manifest: &[u8]) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  return match move run Effect.result(ManifestEdits.removeDependency(manifest, b"math")) {
    Result<Bytes, ManifestEditRefused | OutOfMemoryError>.Success { value: _ } => false
    Result<Bytes, ManifestEditRefused | OutOfMemoryError>.Failure { error } => match move error {
      ManifestEditRefused refused => {
        drop refused
        return true
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

effect fn dependencyPolicy() -> ()
  ! AssertionError<'static> | ManifestEditRefused | OutOfMemoryError
  ? &mut Allocator {
  let created = run dependency(
    b"[package]\nname = \"app\"\n",
    b"[package]\nname = \"app\"\n\n[dependencies]\nmath = { path = \"../math\" }\n"
  )
  let appended = run dependency(
    b"[package]\nname = \"app\"\n\n[dependencies]\ntext = { path = \"../text\" }\n\n[build]\nstage = \"final\"\n",
    b"[package]\nname = \"app\"\n\n[dependencies]\ntext = { path = \"../text\" }\nmath = { path = \"../math\" }\n\n[build]\nstage = \"final\"\n"
  )
  let emptyTable = run dependency(
    b"[dependencies]\n[build]\n",
    b"[dependencies]\nmath = { path = \"../math\" }\n[build]\n"
  )
  run Testing.expect(
    created && appended && emptyTable,
    "a dependency is the last line of [dependencies], which is appended when missing"
  )
  let afterPackage = run dependency(
    b"# app\n[package]\nname = \"app\"\n\n[build]\nstage = \"final\"\n",
    b"# app\n[package]\nname = \"app\"\n\n[dependencies]\nmath = { path = \"../math\" }\n\n[build]\nstage = \"final\"\n"
  )
  run Testing.expect(afterPackage, "a missing [dependencies] table follows the [package] table")
  let line = run removed(
    b"[dependencies]\ntext = { path = \"../text\" }\nmath = { path = \"../math\" } # numbers\n\n[build]\n",
    b"[dependencies]\ntext = { path = \"../text\" }\n\n[build]\n"
  )
  let table = run removed(
    b"[package]\nname = \"app\"\n\n[dependencies.math]\npath = \"../math\"\n\n[build]\nstage = \"final\"\n",
    b"[package]\nname = \"app\"\n\n[build]\nstage = \"final\"\n"
  )
  let quoted = run removed(b"[dependencies]\n\"math\" = { path = \"m\" }\n", b"")
  let missing = run refusesRemoval(b"[dependencies]\ntext = {}\n")
  run Testing.expect(
    line && table && quoted && missing,
    "removing a dependency deletes its line or its table, and an absent one is refused"
  )
  let emptied = run removed(
    b"[package]\nname = \"app\"\n\n[dependencies]\nmath = { path = \"../math\" }\n\n[build]\n",
    b"[package]\nname = \"app\"\n\n[build]\n"
  )
  let last = run removed(
    b"[package]\nname = \"app\"\n\n[dependencies]\nmath = { path = \"../math\" }\n",
    b"[package]\nname = \"app\"\n"
  )
  let commented = run removed(b"[dependencies]\n# local\nmath = {}\n", b"[dependencies]\n# local\n")
  run Testing.expect(
    emptied && last && commented,
    "a [dependencies] table left with nothing in it is removed with its last entry"
  )
}

test effect fn pathDependenciesAreAddedAndRemovedInPlace() -> ()
  ! AssertionError<'static> | ManifestEditRefused | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run dependencyPolicy() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn pinned(manifest: &[u8], table: &[u8], expected: &[u8]) -> bool
  ! ManifestEditRefused | OutOfMemoryError
  ? &mut Allocator {
  let edited = run ManifestEdits.setValue(manifest, table, b"silk-version", b"\"0.1.0-dev.6\"")
  return same(Bytes.asSlice(&edited), expected)
}

effect fn refusesValue(manifest: &[u8], table: &[u8]) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  return match move run Effect.result(ManifestEdits.setValue(manifest, table, b"silk-version", b"\"1\"")) {
    Result<Bytes, ManifestEditRefused | OutOfMemoryError>.Success { value: _ } => false
    Result<Bytes, ManifestEditRefused | OutOfMemoryError>.Failure { error } => match move error {
      ManifestEditRefused refused => {
        drop refused
        return true
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

effect fn valuePolicy() -> ()
  ! AssertionError<'static> | ManifestEditRefused | OutOfMemoryError
  ? &mut Allocator {
  let replaced = run pinned(
    b"[package]\nname = \"app\"\nsilk-version = \"0.0.0\"\nsource = \".\"\n\n[dependencies]\n",
    b"package",
    b"[package]\nname = \"app\"\nsilk-version = \"0.1.0-dev.6\"\nsource = \".\"\n\n[dependencies]\n"
  )
  let added = run pinned(
    b"# app\n[package]\nname = \"app\"\n\n[dependencies]\nmath = {}\n",
    b"package",
    b"# app\n[package]\nname = \"app\"\nsilk-version = \"0.1.0-dev.6\"\n\n[dependencies]\nmath = {}\n"
  )
  let workspace = run pinned(
    b"[workspace]\nmembers = [\n  \"a\",\n]\n",
    b"workspace",
    b"[workspace]\nmembers = [\n  \"a\",\n]\nsilk-version = \"0.1.0-dev.6\"\n"
  )
  let refused = run refusesValue(b"[package]\n", b"workspace")
  run Testing.expect(
    replaced && added && workspace && refused,
    "a key's line is replaced in place or follows its table's last line, and a missing table is refused"
  )
}

test effect fn manifestValuesAreSetInPlace() -> ()
  ! AssertionError<'static> | ManifestEditRefused | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run valuePolicy() |> Effect.provideMut<Allocator>(&mut allocator)
}
