{
  "name": "@silklang/docgen",
  "version": "0.0.0",
  "private": true,
  "description": "CommonMark documentation, highlighting, and code-fence support for Silk editors and formatters.",
  "keywords": [
    "documentation",
    "markdown",
    "silk"
  ],
  "homepage": "https://github.com/julia-script/silk#readme",
  "bugs": {
    "url": "https://github.com/julia-script/silk/issues"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/julia-script/silk.git",
    "directory": "packages/docgen"
  },
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./Document": {
      "types": "./dist/Document.d.ts",
      "import": "./dist/Document.js"
    },
    "./CodeFence": {
      "types": "./dist/CodeFence.d.ts",
      "import": "./dist/CodeFence.js"
    },
    "./Highlight": {
      "types": "./dist/Highlight.d.ts",
      "import": "./dist/Highlight.js"
    }
  },
  "scripts": {
    "build": "pnpm clean && tsc -p tsconfig.json",
    "clean": "node -e \"require('node:fs').rmSync('dist', { recursive: true, force: true })\""
  },
  "dependencies": {
    "@silklang/compiler": "workspace:*",
    "effect": "catalog:",
    "mdast-util-from-markdown": "^2.0.3"
  },
  "devDependencies": {
    "@types/mdast": "^4.0.4",
    "@types/node": "^24.10.1"
  }
}
