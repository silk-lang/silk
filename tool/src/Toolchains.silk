//! Installed Silk toolchains, and which one a command started in a directory runs.
//!
//! Toolchains live in `$SILK_HOME/toolchains/<version>` (`SILK_HOME` defaults to `~/.silk`), each
//! laid out as its release archive unpacks: the compiler `bin/silkc` (`bin/silk` in releases from
//! before the rename) beside `lib/silk/stdlib`. The layout is frozen, so any version of the tool
//! reads the toolchains another installed. A project pins one with
//! `silk-version`: `[workspace].silk-version` covers the workspace and its members, otherwise the
//! nearest manifest's `[package].silk-version` applies. `0.0.0`, the version of a compiler built
//! from source, pins nothing.
//!
//! The first of these selects the version: `+<version>`, `SILK_TOOLCHAIN`, the project's pin, and
//! `default` in `$SILK_HOME/settings.toml`.

import Manifests
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.system.filesystem { DirectoryEntry, DirectoryInfo, FileError, FileInfo, FileSystem, Path }
import silk.system.host_input { HostInput, HostInputError }
import silk.collections.list { List }
import silk.option { Option }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.text.string { String }
import silk.toml.scanner { TomlError }
import silk.toml.value { Toml, Value as TomlValue }
import silk.num.u8
import silk.num.usize

/// Where the selected version came from.
pub enum Origin {
  /// `silk +<version>` on the command line.
  CommandLine,
  /// The `SILK_TOOLCHAIN` environment variable.
  Environment,
  /// `[workspace].silk-version` of the enclosing workspace.
  Workspace,
  /// `[package].silk-version` of the nearest manifest.
  Package,
  /// At a workspace root that pins nothing itself, the `[package].silk-version` its members agree
  /// on.
  Members,
  /// `default` in `$SILK_HOME/settings.toml`.
  Default,
  /// Nothing selects a version.
  Nothing,
}

/// The version a command runs with, and why.
pub struct Selection {
  pub version: Bytes,
  pub origin: Origin,

  /// The manifest that pins the version, for `Workspace` and `Package`; for `Members`, the first
  /// member that pins it.
  pub manifest: Option<Path>,

  /// For `Workspace`, a member's own `[package].silk-version` that names another version and is
  /// ignored, since the workspace's pin wins.
  pub ignored: Option<IgnoredPin>,
}

/// A package's `silk-version` that its workspace's pin overrides.
pub struct IgnoredPin {
  pub manifest: Path,
  pub version: Bytes,
}

/// A `silk-version` this tool cannot read: not a string, or not a semantic version. A newer tool
/// may understand it, so nothing guesses what it means. Also a workspace root whose members pin
/// different versions, which no single compiler should build.
pub struct UnknownPin {
  pub manifest: Path,
  pub detail: Bytes,

  /// The line that says how to fix it.
  pub hint: &'static [u8],
}

/// The hint for a pin a newer tool may read.
pub fn newerTool() -> &'static [u8] { return b"A newer tool may read it; update silk with: silk update self" }


/// The spelling of `origin` in messages and JSON.
pub fn originName(origin: Origin) -> &'static [u8] {
  return match origin {
    Origin.CommandLine => b"command-line"
    Origin.Environment => b"environment"
    Origin.Workspace => b"workspace"
    Origin.Package => b"package"
    Origin.Members => b"members"
    Origin.Default => b"default"
    Origin.Nothing => b"nothing"
  }
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// The length of `version` before its `+` build metadata.
fn coreLength(version: &[u8]) -> usize {
  let mut at = usize.ZERO
  while at < version.length && version[at] != 43 {
    at = at + usize.ONE
  }
  return at
}

/// Whether `version` pins nothing: `0.0.0`, the version of a compiler built from source, with or
/// without build metadata.
pub fn unpinned(version: &[u8]) -> bool {
  return same(Slice.view<u8>(version, usize.ZERO, coreLength(version)), b"0.0.0")
}

/// Whether the pin `requested` names the toolchain `installed`: the same version, or, when
/// `requested` has no build metadata, the same version before `installed`'s.
pub fn matches(requested: &[u8], installed: &[u8]) -> bool {
  if same(requested, installed) {
    return true
  }
  let core = coreLength(requested)
  if core != requested.length {
    return false
  }
  return core == coreLength(installed)
    && same(requested, Slice.view<u8>(installed, usize.ZERO, core))
}

// Compares two dot-separated pre-release identifier lists by SemVer precedence.
fn comparePrerelease(left: &[u8], right: &[u8]) -> i32 {
  let mut l = usize.ZERO
  let mut r = usize.ZERO
  while l < left.length && r < right.length {
    let mut le = l
    while le < left.length && left[le] != 46 {
      le = le + usize.ONE
    }
    let mut re = r
    while re < right.length && right[re] != 46 {
      re = re + usize.ONE
    }
    let order = compareIdentifier(Slice.view<u8>(left, l, le - l), Slice.view<u8>(right, r, re - r))
    if order != 0 {
      return order
    }
    l = le + usize.ONE
    r = re + usize.ONE
  }
  if l < left.length {
    return 1
  }
  if r < right.length {
    return -1
  }
  return 0
}

fn numeric(identifier: &[u8]) -> bool {
  if identifier.length == usize.ZERO {
    return false
  }
  let mut at = usize.ZERO
  while at < identifier.length {
    if identifier[at] < 48 || identifier[at] > 57 {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// Numeric identifiers compare by value (shorter is smaller, as there are no leading zeros) and
// sort before alphanumeric ones, which compare by bytes.
fn compareIdentifier(left: &[u8], right: &[u8]) -> i32 {
  let leftNumeric = numeric(left)
  let rightNumeric = numeric(right)
  if leftNumeric && !rightNumeric {
    return -1
  }
  if rightNumeric && !leftNumeric {
    return 1
  }
  if leftNumeric && left.length != right.length {
    if left.length < right.length {
      return -1
    }
    return 1
  }
  let mut at = usize.ZERO
  while at < left.length && at < right.length {
    if left[at] != right[at] {
      if left[at] < right[at] {
        return -1
      }
      return 1
    }
    at = at + usize.ONE
  }
  if left.length < right.length {
    return -1
  }
  if left.length > right.length {
    return 1
  }
  return 0
}

/// Compares two semantic versions by precedence: negative, zero or positive. Build metadata is
/// ignored.
pub fn compare(left: &[u8], right: &[u8]) -> i32 {
  let leftCore = Slice.view<u8>(left, usize.ZERO, coreLength(left))
  let rightCore = Slice.view<u8>(right, usize.ZERO, coreLength(right))
  let mut leftDash = usize.ZERO
  while leftDash < leftCore.length && leftCore[leftDash] != 45 {
    leftDash = leftDash + usize.ONE
  }
  let mut rightDash = usize.ZERO
  while rightDash < rightCore.length && rightCore[rightDash] != 45 {
    rightDash = rightDash + usize.ONE
  }
  let order = comparePrerelease(
    Slice.view<u8>(leftCore, usize.ZERO, leftDash),
    Slice.view<u8>(rightCore, usize.ZERO, rightDash)
  )
  if order != 0 {
    return order
  }
  let leftPre = leftDash < leftCore.length
  let rightPre = rightDash < rightCore.length
  if leftPre && !rightPre {
    return -1
  }
  if rightPre && !leftPre {
    return 1
  }
  if !leftPre {
    return 0
  }
  return comparePrerelease(
    Slice.view<u8>(leftCore, leftDash + usize.ONE, leftCore.length - leftDash - usize.ONE),
    Slice.view<u8>(rightCore, rightDash + usize.ONE, rightCore.length - rightDash - usize.ONE),
  )
}

/// `$SILK_HOME`, or `$HOME/.silk`; `None` when neither names an absolute directory, or when the
/// directory `HOME` names does not exist, so nothing creates one there.
pub effect fn home() -> Option<Path>
  ! HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut FileSystem | &mut Allocator {
  let mut chosen = run HostInput.variableNamed("SILK_HOME")
  let mut suffix = false
  if let Option<Bytes>.None = &chosen {
    chosen = run HostInput.variableNamed("HOME")
    suffix = true
  }
  let mut text = match move chosen {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => {
      return Option<Path>.none()
    }
  }
  let written = Bytes.asSlice(&text)
  if written.length == usize.ZERO || written[usize.ZERO] != 47 {
    return Option<Path>.none()
  }

  // A trailing separator would make an empty component.
  let mut end = written.length
  while end > usize.ONE && written[end - usize.ONE] == 47 {
    end = end - usize.ONE
  }
  let mut trimmed = run Bytes.copy(Slice.view<u8>(written, usize.ZERO, end))
  if suffix && !run isDirectory(Bytes.asSlice(&trimmed)) {
    return Option<Path>.none()
  }
  if suffix {
    if end > usize.ONE {
      run Bytes.append(&mut trimmed, b"/")
    }
    run Bytes.append(&mut trimmed, b".silk")
  }
  drop text
  return match move run Effect.result(Path.fromBytes(Bytes.asSlice(&trimmed))) {
    Result<Path, FileError | OutOfMemoryError>.Success { value } => Option<Path>.some(move value)
    Result<Path, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError invalid => {
        drop invalid
        return Option<Path>.none()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// Whether `path` names an existing directory.
effect fn isDirectory(path: &[u8]) -> bool
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let named = match move run Effect.result(Path.fromBytes(path)) {
    Result<Path, FileError | OutOfMemoryError>.Success { value } => move value
    Result<Path, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError invalid => {
        drop invalid
        return false
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  return match move run Effect.result(FileSystem.stat(&named)) {
    Result<FileInfo | DirectoryInfo, FileError>.Success { value } => match move value {
      FileInfo file => false
      DirectoryInfo folder => true
    }
    Result<FileInfo | DirectoryInfo, FileError>.Failure { error } => {
      drop error
      return false
    }
  }
}

/// The directory that holds the toolchain named `name` below `home`.
pub effect fn directory(home: &Path, name: &[u8]) -> Path
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let toolchains = run Path.join(home, "toolchains")
  return run Path.joinBytes(&toolchains, name)
}

/// The compiler executable of the toolchain named `name` below `home`: `bin/silkc`, or `bin/silk`
/// in a toolchain released before the compiler was renamed, which has no `bin/silkc`.
pub effect fn executable(home: &Path, name: &[u8]) -> Path
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let root = run directory(home, name)
  let bin = run Path.join(&root, "bin")
  let compiler = run Path.join(&bin, "silkc")
  if run isFile(&compiler) {
    return move compiler
  }
  return run Path.join(&bin, "silk")
}

effect fn isFile(path: &Path) -> bool
  ! OutOfMemoryError
  ? &mut FileSystem {
  return match move run Effect.result(FileSystem.stat(path)) {
    Result<FileInfo | DirectoryInfo, FileError>.Success { value } => match move value {
      FileInfo file => true
      DirectoryInfo folder => false
    }
    Result<FileInfo | DirectoryInfo, FileError>.Failure { error } => {
      drop error
      return false
    }
  }
}

/// The names of the toolchains installed below `home`, newest version first. A directory counts
/// when its name is a semantic version and it holds a compiler; temporary install directories
/// start with `.` and never count.
pub effect fn installed(home: &Path) -> List<Bytes>
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  return run folders(home, true)
}

// The names of the directories below `home/toolchains` named for a semantic version, newest first:
// only those that hold a compiler when `complete` is set.
effect fn folders(home: &Path, complete: bool) -> List<Bytes>
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut names = List<Bytes>.make()
  let toolchains = run Path.join(home, "toolchains")
  let listed = match move run Effect.result(FileSystem.listDirectory(&toolchains)) {
    Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Success { value } => move value
    Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Failure {
      error
    } => match move error {
      FileError missing => {
        drop missing
        return move names
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let entries = List<DirectoryEntry>.asSlice(&listed)
  let mut at = usize.ZERO
  while at < entries.length {
    let path = Path.rawBytes(&entries[at].path)
    let mut start = path.length
    while start > usize.ZERO && path[start - usize.ONE] != 47 {
      start = start - usize.ONE
    }
    let name = Slice.view<u8>(path, start, path.length - start)
    if Manifests.isSemanticVersion(name) {
      let compiler = run executable(home, name)
      if !complete || run isFile(&compiler) {
        // Insert newest first.
        let mut position = usize.ZERO
        let sorted = List<Bytes>.asSlice(&names)
        while position < sorted.length && compare(Bytes.asSlice(&sorted[position]), name) >= 0 {
          position = position + usize.ONE
        }
        run List<Bytes>.insert(&mut names, position, run Bytes.copy(name))
      }
    }
    at = at + usize.ONE
  }
  return move names
}

/// The installed toolchain the pin `version` names, if any.
pub effect fn find(home: &Path, version: &[u8]) -> Option<Bytes>
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let names = run installed(home)
  let listed = List<Bytes>.asSlice(&names)
  let mut at = usize.ZERO
  while at < listed.length {
    if matches(version, Bytes.asSlice(&listed[at])) {
      return Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&listed[at])))
    }
    at = at + usize.ONE
  }
  return Option<Bytes>.none()
}

/// The directory below `home/toolchains` the pin `version` names, whether or not it holds a whole
/// toolchain: one a disk cleaner or an interrupted copy damaged can still be removed.
pub effect fn present(home: &Path, version: &[u8]) -> Option<Bytes>
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  if let Option<Bytes>.Some { value } = move run find(home, version) {
    return Option<Bytes>.some(move value)
  }
  let names = run folders(home, false)
  let listed = List<Bytes>.asSlice(&names)
  let mut at = usize.ZERO
  while at < listed.length {
    if matches(version, Bytes.asSlice(&listed[at])) {
      return Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&listed[at])))
    }
    at = at + usize.ONE
  }
  return Option<Bytes>.none()
}

/// The parsed `$SILK_HOME/settings.toml`, or `None` when it is missing or not TOML.
effect fn settings(home: &Path) -> Option<TomlValue>
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let path = run Path.join(home, "settings.toml")
  let text = match move run Effect.result(FileSystem.readFile(&path)) {
    Result<Bytes, FileError | OutOfMemoryError>.Success { value } => move value
    Result<Bytes, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError missing => {
        drop missing
        return Option<TomlValue>.none()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  return match move run Effect.result(Toml.parse(Bytes.asSlice(&text))) {
    Result<TomlValue, TomlError | OutOfMemoryError>.Success { value } => Option<TomlValue>.some(
      move value
    )
    Result<TomlValue, TomlError | OutOfMemoryError>.Failure { error } => match move error {
      TomlError invalid => {
        drop invalid
        return Option<TomlValue>.none()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

/// `default` in `$SILK_HOME/settings.toml`, when it is a semantic version.
pub effect fn defaultVersion(home: &Path) -> Option<Bytes>
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let document = match move run settings(home) {
    Option<TomlValue>.Some { value } => move value
    Option<TomlValue>.None => {
      return Option<Bytes>.none()
    }
  }
  return match move Toml.asString(Toml.field(&document, "default")) {
    Option<string>.Some { value } => {
      let written = String.utf8Bytes(value)
      if !Manifests.isSemanticVersion(written) {
        return Option<Bytes>.none()
      }
      return Option<Bytes>.some(run Bytes.copy(written))
    }
    Option<string>.None => Option<Bytes>.none()
  }
}

/// Whether `auto-install = true` is in `$SILK_HOME/settings.toml`.
pub effect fn autoInstall(home: &Path) -> bool
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let document = match move run settings(home) {
    Option<TomlValue>.Some { value } => move value
    Option<TomlValue>.None => {
      return false
    }
  }
  return match move Toml.field(&document, "auto-install") {
    Option<&TomlValue>.Some { value } => match &value.* {
      TomlValue.Boolean { value: enabled } => enabled
      _ => false
    }
    Option<&TomlValue>.None => false
  }
}

/// Writes `default = "<version>"` to `$SILK_HOME/settings.toml`, keeping `auto-install`.
pub effect fn setDefault(home: &Path, version: &[u8]) -> ()
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let automatic = run autoInstall(home)
  let mut text = run Bytes.copy(b"# Written by `silk use`.\ndefault = \"")
  run Bytes.append(&mut text, version)
  run Bytes.append(&mut text, b"\"\n")
  if automatic {
    run Bytes.append(&mut text, b"auto-install = true\n")
  }
  let path = run Path.join(home, "settings.toml")
  run FileSystem.writeFileWithParents(&path, Bytes.asSlice(&text))
}

// The `silk-version` of `table` in the manifest at `manifest`, when it has one.
effect fn versionIn(manifest: &Path, table: Option<&TomlValue>, name: &[u8]) -> Option<Bytes>
  ! UnknownPin | OutOfMemoryError
  ? &mut Allocator {
  let field = match move Toml.fieldAt(move table, "silk-version") {
    Option<&TomlValue>.Some { value } => value
    Option<&TomlValue>.None => {
      return Option<Bytes>.none()
    }
  }
  if let Option<string>.Some { value } = move Toml.asString(Option<&TomlValue>.some(field)) {
    let written = String.utf8Bytes(value)
    if Manifests.isSemanticVersion(written) {
      return Option<Bytes>.some(run Bytes.copy(written))
    }
    let mut detail = run Bytes.copy(b"[")
    run Bytes.append(&mut detail, name)
    run Bytes.append(&mut detail, b"].silk-version = \"")
    run Bytes.append(&mut detail, written)
    run Bytes.append(&mut detail, b"\" is not a version this tool understands")
    fail UnknownPin { manifest: run Manifests.copyPath(manifest), detail: move detail, hint: newerTool() }
  }
  let mut detail = run Bytes.copy(b"[")
  run Bytes.append(&mut detail, name)
  run Bytes.append(&mut detail, b"].silk-version is not a string this tool understands")
  fail UnknownPin { manifest: run Manifests.copyPath(manifest), detail: move detail, hint: newerTool() }
}

/// The pin of the project around `start`, if it has one other than `0.0.0`.
///
/// The nearest manifest at or above `start` decides. When a workspace at or above it pins a
/// version and lists it (or is it), the workspace's pin wins; otherwise the manifest's own
/// `[package].silk-version` applies.
pub effect fn pinned(start: &Path) -> Option<Selection>
  ! UnknownPin | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let nearest = match move run Manifests.discover(start) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => {
      return Option<Selection>.none()
    }
  }
  let directory = match move run Path.parent(&nearest) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => {
      return Option<Selection>.none()
    }
  }
  if let Option<Path>.Some { value: workspace } = move run Manifests.enclosingWorkspace(&directory) {
    let covers = same(Path.rawBytes(&workspace), Path.rawBytes(&nearest))
      || run Manifests.listsMember(&workspace, &directory)
    if covers {
      if let Option<TomlValue>.Some { value: parsed } = move run Manifests.parsed(&workspace) {
        if let Option<Bytes>.Some { value: version } = move run versionIn(
          &workspace,
          Toml.field(&parsed, "workspace"),
          b"workspace"
        ) {
          if !unpinned(Bytes.asSlice(&version)) {
            let ignored = run ignoredPin(&nearest, Bytes.asSlice(&version))
            return Option<Selection>.some(
              Selection {
                version: move version,
                origin: Origin.Workspace,
                manifest: Option<Path>.some(move workspace),
                ignored: move ignored,
              }
            )
          }
        }
      }
    }
  }
  let parsed = match move run Manifests.parsed(&nearest) {
    Option<TomlValue>.Some { value } => move value
    Option<TomlValue>.None => {
      return Option<Selection>.none()
    }
  }
  return match move run versionIn(&nearest, Toml.field(&parsed, "package"), b"package") {
    Option<Bytes>.Some { value } => {
      if unpinned(Bytes.asSlice(&value)) {
        return Option<Selection>.none()
      }
      return Option<Selection>.some(
        Selection {
          version: move value,
          origin: Origin.Package,
          manifest: Option<Path>.some(move nearest),
          ignored: Option<IgnoredPin>.none(),
        }
      )
    }
    Option<Bytes>.None => Option<Selection>.none()
  }
}

// The `[package].silk-version` of `manifest` when it names a version other than the workspace's
// `pin`. One this tool cannot read, or `0.0.0`, says nothing.
effect fn ignoredPin(manifest: &Path, pin: &[u8]) -> Option<IgnoredPin>
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let parsed = match move run Manifests.parsed(manifest) {
    Option<TomlValue>.Some { value } => move value
    Option<TomlValue>.None => {
      return Option<IgnoredPin>.none()
    }
  }
  let read = run Effect.result(versionIn(manifest, Toml.field(&parsed, "package"), b"package"))
  let own = match move read {
    Result<Option<Bytes>, UnknownPin | OutOfMemoryError>.Success { value } => match move value {
      Option<Bytes>.Some { value: version } => move version
      Option<Bytes>.None => {
        return Option<IgnoredPin>.none()
      }
    }
    Result<Option<Bytes>, UnknownPin | OutOfMemoryError>.Failure { error } => match move error {
      UnknownPin unknown => {
        drop unknown
        return Option<IgnoredPin>.none()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let written = Bytes.asSlice(&own)
  if unpinned(written) || matches(written, pin) || matches(pin, written) {
    return Option<IgnoredPin>.none()
  }
  return Option<IgnoredPin>.some(IgnoredPin { manifest: run Manifests.copyPath(manifest), version: move own })
}

/// Where `silk set` writes a pin for the project around `start`.
pub struct PinTarget {
  pub manifest: Path,

  /// `workspace` or `package`.
  pub table: &'static [u8],

  /// The pin the table has now, when it has one other than `0.0.0`.
  pub previous: Option<Bytes>,
}

/// The table that pins the project around `start`: the `[workspace]` table of the workspace that
/// lists the nearest package (or is the nearest manifest), else the package's own `[package]`
/// table. `None` when no manifest is found.
pub effect fn pinTarget(start: &Path) -> Option<PinTarget>
  ! UnknownPin | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  // A member's own pin is the previous version, but the workspace that lists it is still the one
  // that gets pinned, so its members stay on one version.
  let mut previous = Option<Bytes>.none()
  if let Option<Selection>.Some { value } = move run pinned(start) {
    if let Option<Path>.Some { value: manifest } = move value.manifest {
      if value.origin == Origin.Workspace {
        return Option<PinTarget>.some(PinTarget { manifest: move manifest, table: b"workspace", previous: Option<Bytes>.some(move value.version) })
      }
      previous = Option<Bytes>.some(move value.version)
    }
  }
  let nearest = match move run Manifests.discover(start) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => {
      return Option<PinTarget>.none()
    }
  }
  // A workspace that lists the package pins it along with every other member.
  if let Option<Path>.Some { value: directory } = move run Path.parent(&nearest) {
    if let Option<Path>.Some { value: workspace } = move run Manifests.enclosingWorkspace(&directory) {
      let own = same(Path.rawBytes(&workspace), Path.rawBytes(&nearest))
      if own || run Manifests.listsMember(&workspace, &directory) {
        return Option<PinTarget>.some(PinTarget { manifest: move workspace, table: b"workspace", previous: move previous })
      }
    }
  }
  let mut table: &'static [u8] = b"package"
  if let Option<TomlValue>.Some { value: parsed } = move run Manifests.parsed(&nearest) {
    if let Option<&TomlValue>.Some { value: workspace } = Toml.field(&parsed, "workspace") {
      table = b"workspace"
    }
  }
  return Option<PinTarget>.some(PinTarget { manifest: move nearest, table: table, previous: move previous })
}

/// The manifests among the members of the workspace at `manifest`, its own package included, whose
/// `[package]` table sets a `silk-version` other than `0.0.0`. The workspace's pin wins over these,
/// so `silk set` moves them along with it. An unreadable workspace or member has none.
pub effect fn memberPins(manifest: &Path) -> List<Path>
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut pins = List<Path>.make()
  if run pinsPackage(manifest) {
    run List<Path>.append(&mut pins, run Path.fromBytes(Path.rawBytes(manifest)))
  }
  let members = run Manifests.memberManifests(manifest)
  let listed = List<Path>.asSlice(&members)
  let mut at = usize.ZERO
  while at < listed.length {
    let member = &listed[at]
    if !same(Path.rawBytes(member), Path.rawBytes(manifest)) && run pinsPackage(member) {
      run List<Path>.append(&mut pins, run Path.fromBytes(Path.rawBytes(member)))
    }
    at = at + usize.ONE
  }
  return move pins
}

// Whether the `[package]` table of `manifest` sets a `silk-version` other than `0.0.0`, including
// one this tool cannot read, which `silk set` replaces.
effect fn pinsPackage(manifest: &Path) -> bool
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  if let Option<TomlValue>.Some { value: parsed } = move run Manifests.parsed(manifest) {
    let read = run Effect.result(versionIn(manifest, Toml.field(&parsed, "package"), b"package"))
    return match move read {
      Result<Option<Bytes>, UnknownPin | OutOfMemoryError>.Success { value } => match &value {
        Option<Bytes>.Some { value: version } => !unpinned(Bytes.asSlice(&version))
        Option<Bytes>.None => false
      }
      Result<Option<Bytes>, UnknownPin | OutOfMemoryError>.Failure { error } => match move error {
        UnknownPin unknown => {
          drop unknown
          return true
        }
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
      }
    }
  }
  return false
}

/// Selects the version for a command started in `start`, by the rules in the module comment.
/// `requested` is a `+<version>` argument and `environment` the `SILK_TOOLCHAIN` value.
pub effect fn select(
  start: &Path,
  requested: Option<&[u8]>,
  environment: Option<&[u8]>,
  home: Option<&Path>
) -> Selection
  ! UnknownPin | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  if let Option<&[u8]>.Some { value } = move requested {
    return Selection {
      version: run Bytes.copy(value),
      origin: Origin.CommandLine,
      manifest: Option<Path>.none(),
      ignored: Option<IgnoredPin>.none(),
    }
  }
  if let Option<&[u8]>.Some { value } = move environment {
    if value.length > usize.ZERO {
      return Selection {
        version: run Bytes.copy(value),
        origin: Origin.Environment,
        manifest: Option<Path>.none(),
        ignored: Option<IgnoredPin>.none(),
      }
    }
  }
  if let Option<Selection>.Some { value } = move run projectPin(start) {
    return move value
  }
  if let Option<&Path>.Some { value: root } = move home {
    if let Option<Bytes>.Some { value } = move run defaultVersion(root) {
      return Selection {
        version: move value,
        origin: Origin.Default,
        manifest: Option<Path>.none(),
        ignored: Option<IgnoredPin>.none(),
      }
    }
  }
  return Selection { version: Bytes.make(), origin: Origin.Nothing, manifest: Option<Path>.none(), ignored: Option<IgnoredPin>.none() }
}

/// The version the project around `start` runs with: its pin, or at a workspace root that pins
/// nothing, the version its members agree on.
pub effect fn projectPin(start: &Path) -> Option<Selection>
  ! UnknownPin | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  if let Option<Selection>.Some { value } = move run pinned(start) {
    return Option<Selection>.some(move value)
  }
  return run membersPin(start)
}

// At a workspace root that pins no version itself, the version its members pin, so a command run
// there builds them with the compiler they build with alone. `None` elsewhere, or when no member
// pins one. Members that pin different versions are an error: no one compiler should build them.
effect fn membersPin(start: &Path) -> Option<Selection>
  ! UnknownPin | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let nearest = match move run Manifests.discover(start) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => {
      return Option<Selection>.none()
    }
  }
  let parsed = match move run Manifests.parsed(&nearest) {
    Option<TomlValue>.Some { value } => move value
    Option<TomlValue>.None => {
      return Option<Selection>.none()
    }
  }
  if let Option<&TomlValue>.None = Toml.field(&parsed, "workspace") {
    return Option<Selection>.none()
  }
  let members = run Manifests.memberManifests(&nearest)
  let listed = List<Path>.asSlice(&members)
  let mut chosen = Option<Selection>.none()
  let mut at = usize.ZERO
  while at < listed.length {
    let member = &listed[at]
    at = at + usize.ONE
    let document = match move run Manifests.parsed(member) {
      Option<TomlValue>.Some { value } => move value
      Option<TomlValue>.None => {
        continue
      }
    }
    let version = match move run versionIn(member, Toml.field(&document, "package"), b"package") {
      Option<Bytes>.Some { value } => move value
      Option<Bytes>.None => {
        continue
      }
    }
    if unpinned(Bytes.asSlice(&version)) {
      continue
    }
    if let Option<Selection>.Some { value: first } = &chosen {
      let agreed = Bytes.asSlice(&first.version)
      let written = Bytes.asSlice(&version)
      if !matches(agreed, written) && !matches(written, agreed) {
        let mut detail = run Bytes.copy(b"this workspace has no silk-version and its members pin different ones: ")
        run Bytes.append(&mut detail, agreed)
        if let Option<Path>.Some { value: manifest } = &first.manifest {
          run Bytes.append(&mut detail, b" in ")
          run Bytes.append(&mut detail, Path.rawBytes(&manifest))
        }
        run Bytes.append(&mut detail, b", ")
        run Bytes.append(&mut detail, written)
        run Bytes.append(&mut detail, b" in ")
        run Bytes.append(&mut detail, Path.rawBytes(member))
        fail UnknownPin {
          manifest: move nearest,
          detail: move detail,
          hint: b"Pin the workspace and its members to one version with: silk set <version>",
        }
      }
      continue
    }
    chosen = Option<Selection>.some(
      Selection {
        version: move version,
        origin: Origin.Members,
        manifest: Option<Path>.some(run Manifests.copyPath(member)),
        ignored: Option<IgnoredPin>.none(),
      }
    )
  }
  return move chosen
}
