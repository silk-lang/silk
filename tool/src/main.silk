//! `silk`, the one front door for Silk.
//!
//! It owns what must behave the same in every project: Silk versions (`silk use`, `silk set`),
//! release notes (`silk change`) and itself (`silk update self`). Every other command, `--version`
//! included, goes unchanged to the compiler `silkc` of the version the directory selects, so
//! editors, scripts and habit reach the pinned compiler.
//!
//! What each command does is the machine of the `flows` package, which `Driver` runs. This
//! module gives each step what it takes: the disk, the release source, a compiler to ask, or
//! the compiler that takes the place of the tool.

import Bundled
import HostPath
import changeset.Command as ChangeCommand
import Command { Context }
import Driver as Driver { Need, Session }
import Install as ToolchainInstall { HostFiles, InstallError, ReleaseSource }
import NativeHostFiles { NativeHostFiles }
import ProcessImage
import ReleaseVersion
import Sources as ToolchainSources { GitHubReleases, MirrorReleases }
import Toolchains
import Unavailable
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.system.host_input { HostInput, HostInputError }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.system.filesystem_machine { MachineFileSystem }
import silk.system.child_process { ChildProcess }
import silk.system.child_process_native { OsChildProcess }
import silk.io.writer_native { StderrWriter, StdoutWriter }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.num.usize
import silk.io.writer { Writer, WriterError }

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

effect fn writeError(bytes: &[u8]) -> () ! WriterError {
  let mut stderr = StderrWriter.make()
  return run Writer.writeAll(bytes) |> Effect.provideMut<Writer>(&mut stderr)
}

effect fn writeOutput(bytes: &[u8]) -> () ! WriterError {
  let mut stdout = StdoutWriter.make()
  return run Writer.writeAll(bytes) |> Effect.provideMut<Writer>(&mut stdout)
}

// What every command runs with.
effect fn context() -> Context
  ! HostInputError | OutOfMemoryError | FileError
  ? &mut HostInput | &mut Allocator {
  let workingDirectory = run HostInput.workingDirectory()
  let working = run HostPath.fromBytes(Bytes.asSlice(&workingDirectory))
  let mut files = run MachineFileSystem.make()
  let home = run Toolchains.home() |> Effect.provideMut<FileSystem>(&mut files)
  let environment = run HostInput.variableNamed("SILK_TOOLCHAIN")
  let all = run HostInput.arguments()
  let listed = List<Bytes>.asSlice(&all)
  let searchPath = run HostInput.variableNamed("PATH")
  let mut bundled = Option<Path>.none()
  if listed.length > usize.ZERO {
    let search = match &searchPath {
      Option<Bytes>.Some { value } => Option<&[u8]>.some(Bytes.asSlice(&value))
      Option<Bytes>.None => Option<&[u8]>.none()
    }
    bundled = run Bundled.compiler(Bytes.asSlice(&listed[usize.ZERO]), move search)
      |> Effect.provideMut<FileSystem>(&mut files)
  }

  // A missing version installs itself with SILK_AUTO_INSTALL=1, or auto-install = true in
  // settings.toml.
  let mut autoInstall = false
  let variable = run HostInput.variableNamed("SILK_AUTO_INSTALL")
  if let Option<Bytes>.Some { value } = &variable {
    autoInstall = same(Bytes.asSlice(&value), b"1")
  } else if let Option<Path>.Some { value: root } = &home {
    autoInstall = run Toolchains.autoInstall(&root) |> Effect.provideMut<FileSystem>(&mut files)
  }
  return Context {
    working: move working,
    home: move home,
    environment: move environment,
    target: ToolchainInstall.hostTarget(),
    releaseKey: ToolchainInstall.releaseKey(),
    release: ReleaseVersion.value(),
    bundled: move bundled,
    autoInstall: autoInstall,
  }
}

// Does the step of `session` that asks the release source: SILK_TOOLCHAIN_MIRROR when it is set,
// and GitHub otherwise (Sources). A source that cannot open ends the step as one that fails.
effect fn fetched(session: &mut Session, context: &Context) -> ()
  ! HostInputError | OutOfMemoryError | FileError
  ? &mut HostInput | &mut Allocator {
  let mut files = run MachineFileSystem.make()
  let mut host = NativeHostFiles.at(b"/")
  let mirrored = run HostInput.variableNamed("SILK_TOOLCHAIN_MIRROR")
  if let Option<Bytes>.Some { value } = &mirrored {
    let made = run Effect.result(ToolchainSources.mirror(Bytes.asSlice(&value)))
    let mut source = match move made {
      Result<MirrorReleases, InstallError | OutOfMemoryError>.Success { value: opened } => move opened
      Result<MirrorReleases, InstallError | OutOfMemoryError>.Failure { error } => match move error {
        InstallError stopped => {
          return run Driver.unreachable(&mut session.*, context, &stopped)
            |> Effect.provideMut<FileSystem>(&mut files)
        }
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
      }
    }
    return run Driver.fetch(&mut session.*, context)
      |> Effect.provideMut<ReleaseSource>(&mut source) |> Effect.provideMut<FileSystem>(&mut files)
      |> Effect.provideMut<HostFiles>(&mut host)
  }
  let made = run Effect.result(ToolchainSources.github())
  let mut source = match move made {
    Result<GitHubReleases, InstallError | HostInputError | OutOfMemoryError>.Success { value: opened } => move opened
    Result<GitHubReleases, InstallError | HostInputError | OutOfMemoryError>.Failure { error } => match move error {
      InstallError stopped => {
        return run Driver.unreachable(&mut session.*, context, &stopped)
          |> Effect.provideMut<FileSystem>(&mut files)
      }
      HostInputError failed => {
        fail move failed
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  return run Driver.fetch(&mut session.*, context)
    |> Effect.provideMut<ReleaseSource>(&mut source) |> Effect.provideMut<FileSystem>(&mut files)
    |> Effect.provideMut<HostFiles>(&mut host)
}

// Whether the forwarded command, after any `+<version>`, is `lsp`.
fn servesLanguage(arguments: &[Bytes]) -> bool {
  let mut command = usize.ZERO
  if arguments.length > usize.ZERO && Bytes.length(&arguments[usize.ZERO]) > usize.ZERO && Bytes.asSlice(&arguments[usize.ZERO])[usize.ZERO] == 43 {
    command = usize.ONE
  }
  return arguments.length > command && same(Bytes.asSlice(&arguments[command]), b"lsp")
}

// An editor that spawns `silk lsp` where no toolchain can serve receives `errors` in its
// initialization error response.
effect fn unavailableServer(errors: &[u8]) -> i32 {
  let mut end = errors.length
  while end > usize.ZERO && errors[end - usize.ONE] == 10 {
    end = end - usize.ONE
  }
  return run Unavailable.serveStandard(Slice.view<u8>(errors, usize.ZERO, end))
}

// Becomes the compiler `session` starts, with `arguments` less a leading `+<version>`. It
// returns only when that compiler does not start, with the exit status.
effect fn launch(session: &mut Session, context: &Context, arguments: &[Bytes]) -> i32
  ! OutOfMemoryError | FileError | WriterError
  ? &mut Allocator {
  let mut files = run MachineFileSystem.make()
  let mut executable = Bytes.make()
  let mut version = Bytes.make()
  let mut skip = usize.ZERO
  if let Option<Driver.Launch>.Some { value } = &session.launch {
    executable = run Bytes.copy(Bytes.asSlice(&value.executable))
    version = run Bytes.copy(Bytes.asSlice(&value.version))
    skip = value.skip
  }
  if !run ProcessImage.setVariable(b"SILK_TOOLCHAIN", Bytes.asSlice(&version)) {
    run writeError(b"silk: cannot set SILK_TOOLCHAIN\n")
    return 1
  }
  if let Option<Path>.Some { value: home } = &context.home {
    // The compiler and the tools it runs read the host's own spelling, never the tool's `/C:/...`.
    let spelled = match move run Effect.result(HostPath.toBytes(&home)) {
      Result<Bytes, FileError | OutOfMemoryError>.Success {value} => move value
      Result<Bytes, FileError | OutOfMemoryError>.Failure {error} => match move error {
        FileError invalid => {
          drop invalid
          run writeError(b"silk: the Silk home directory has a name Windows cannot pass to the compiler\n")
          return 1
        }
        OutOfMemoryError exhausted => { fail move exhausted }
      }
    }
    if !run ProcessImage.setVariable(b"SILK_HOME", Bytes.asSlice(&spelled)) {
      run writeError(b"silk: cannot set SILK_HOME\n")
      return 1
    }
  }
  if Bytes.length(&executable) > usize.ZERO {
    let program = run Path.fromBytes(Bytes.asSlice(&executable))
    let forwarded = Slice.view<Bytes>(arguments, skip, arguments.length - skip)
    let failure = run ProcessImage.replace(&program, forwarded)
    drop failure
  }
  run Driver.stuck(&mut session.*, context) |> Effect.provideMut<FileSystem>(&mut files)
  let said = run Driver.spoken(&mut session.*)
  run writeOutput(Bytes.asSlice(&said.output))
  run writeError(Bytes.asSlice(&said.errors))
  return session.status
}

effect fn program() -> i32
  ! HostInputError | OutOfMemoryError | FileError | WriterError
  ? &mut HostInput | &mut Allocator {
  let all = run HostInput.arguments()
  let listed = List<Bytes>.asSlice(&all)
  let mut arguments = Slice.view<Bytes>(listed, usize.ZERO, usize.ZERO)
  if listed.length > usize.ZERO {
    arguments = Slice.view<Bytes>(listed, usize.ONE, listed.length - usize.ONE)
  }
  if arguments.length > usize.ZERO && same(Bytes.asSlice(&arguments[usize.ZERO]), b"change") {
    return run ChangeCommand.runHost()
  }
  let context = run context()
  let mut files = run MachineFileSystem.make()
  let mut session = run Driver.begin(&context, arguments) |> Effect.provideMut<FileSystem>(&mut files)

  // An editor that spawns `silk lsp` reads what went wrong from the server's answer.
  let mut heard = Bytes.make()
  while true {
    let said = run Driver.spoken(&mut session)
    run writeOutput(Bytes.asSlice(&said.output))
    run writeError(Bytes.asSlice(&said.errors))
    run Bytes.append(&mut heard, Bytes.asSlice(&said.errors))
    let need = Driver.needs(&session)
    if need == Need.Nothing {
      if session.status != 0 && session.status != 2 && servesLanguage(arguments) {
        return run unavailableServer(Bytes.asSlice(&heard))
      }
      return session.status
    }
    if need == Need.Launch {
      return run launch(&mut session, &context, arguments)
    }
    if need == Need.Files {
      let mut host = NativeHostFiles.at(b"/")
      run Driver.work(&mut session, &context)
        |> Effect.provideMut<FileSystem>(&mut files) |> Effect.provideMut<HostFiles>(&mut host)
    } else if need == Need.Network {
      run fetched(&mut session, &context)
    } else {
      let mut processes = OsChildProcess.make()
      run Driver.ask(&mut session, &context)
        |> Effect.provideMut<FileSystem>(&mut files)
        |> Effect.provideMut<ChildProcess>(&mut processes)
    }
  }
  return session.status
}

pub effect fn main() -> i32 ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let outcome = run Effect.result(program() |> Effect.provideMut<Allocator>(&mut allocator))
  return match move outcome {
    Result<i32, HostInputError | OutOfMemoryError | FileError | WriterError>.Success { value } => value
    Result<i32, HostInputError | OutOfMemoryError | FileError | WriterError>.Failure { error } => match move error {
      HostInputError failed => {
        drop failed
        let reported = run Effect.result(writeError(b"silk: cannot read the command line or environment\n"))
        drop reported
        return 1
      }
      OutOfMemoryError exhausted => {
        drop exhausted
        let reported = run Effect.result(writeError(b"silk: out of memory\n"))
        drop reported
        return 1
      }
      FileError failed => {
        drop failed
        let reported = run Effect.result(writeError(b"silk: a file operation failed\n"))
        drop reported
        return 1
      }
      WriterError broken => {
        drop broken
        return 1
      }
    }
  }
}
