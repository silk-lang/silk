//! `silk cached <check|build|test> [options]`: runs a project command once per set of build inputs
//! and replays it after that.
//!
//! The key of a task is the command, its options that do not change what a build reads (such as
//! `--quiet` or `--filter`), and `silk hash` of the package, which covers the compiler, Clang, the
//! profile and every file the build reads. A task found under its key is replayed: its standard
//! output and error are written again, and a build's artifacts are written back. A task that is
//! not found runs in the compiler with its output captured, and is saved when it is worth keeping:
//! a check that passed or reported errors, a build that succeeded with every artifact, and a test
//! run that passed.
//!
//! Tasks live in a `TaskStore`. `DirectoryStore` keeps them in a directory on this machine
//! (`SILK_TASK_CACHE`, or `cache/tasks` in the Silk home); a remote store is one more provider of
//! the same two operations. A store that cannot read or write only costs a run, never a failure.

import Command { Outcome }
import HostPath
import Install { HostFiles }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.system.child_process { ChildProcess, ProcessError, ProcessOutcome }
import silk.core.effect { Effect }
import silk.system.filesystem { AtomicWriteError, FileError, FileSystem, Path }
import silk.system.filesystem_machine { MachineFileSystem }
import silk.system.host_input { HostInput, HostInputError }
import silk.json.scanner { JsonError }
import silk.json.value { Json, Value }
import silk.crypto.sha2 { Sha256 }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.text.string { String }
import silk.num.i32
import silk.num.u8
import silk.num.usize

/// Where finished tasks are kept, by key: a directory on this machine (`DirectoryStore`), or any
/// other store, such as a remote one, that offers these two operations.
pub service TaskStore {
  /// The entry saved under `key`, or none when there is none or it cannot be read.
  effect fn load(key: &[u8]) -> Option<Bytes> ! OutOfMemoryError ? &mut TaskStore | &mut Allocator

  /// Saves `entry` under `key`, replacing an entry already there; false when that fails.
  effect fn save(key: &[u8], entry: &[u8]) -> bool ! OutOfMemoryError ? &mut TaskStore | &mut Allocator
}

/// Tasks kept as files below a directory: the entry of key `k` is `<root>/<first two of k>/<k>`,
/// written atomically so that a reader never sees part of one.
pub struct DirectoryStore {
  root: Path,
  files: MachineFileSystem,
}

impl DirectoryStore {
  /// A store below `root`, which is made when the first task is saved.
  pub effect fn at(root: Path) -> DirectoryStore ! OutOfMemoryError ? &mut Allocator {
    return DirectoryStore { root: move root, files: run MachineFileSystem.make() }
  }

  // The file of `key`, or none for a key that is not a file name.
  effect fn file(self: &Self, key: &[u8]) -> Option<Path> ! OutOfMemoryError ? &mut Allocator {
    if key.length < usize.add(0, 2) || !isHex(key) {
      return Option<Path>.none()
    }
    let mut relative = run Bytes.copy(Slice.view<u8>(key, usize.ZERO, usize.add(0, 2)))
    run Bytes.append(&mut relative, b"/")
    run Bytes.append(&mut relative, key)
    let joined = run Effect.result(Path.resolveBytes(&self.root, Bytes.asSlice(&relative)))
    return match move joined {
      Result<Path, FileError | OutOfMemoryError>.Success { value } => Option<Path>.some(move value)
      Result<Path, FileError | OutOfMemoryError>.Failure { error } => match move error {
        FileError invalid => {
          drop invalid
          return Option<Path>.none()
        }
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
      }
    }
  }

  effect fn load(self: &mut Self, key: &[u8]) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
    let path = match move run self.file(key) {
      Option<Path>.Some { value } => move value
      Option<Path>.None => {
        return Option<Bytes>.none()
      }
    }
    let read = run Effect.result(FileSystem.readFile(&path)) |> Effect.provideMut<FileSystem>(&mut self.files)
    return match move read {
      Result<Bytes, FileError | OutOfMemoryError>.Success { value } => Option<Bytes>.some(move value)
      Result<Bytes, FileError | OutOfMemoryError>.Failure { error } => match move error {
        FileError missing => {
          drop missing
          return Option<Bytes>.none()
        }
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
      }
    }
  }

  effect fn save(self: &mut Self, key: &[u8], entry: &[u8]) -> bool ! OutOfMemoryError ? &mut Allocator {
    let path = match move run self.file(key) {
      Option<Path>.Some { value } => move value
      Option<Path>.None => {
        return false
      }
    }
    if let Option<Path>.Some { value: directory } = move run Path.parent(&path) {
      let made = run Effect.result(FileSystem.createDirectoriesRecursively(&directory)) |> Effect.provideMut<FileSystem>(&mut self.files)
      if let Result<(), FileError | OutOfMemoryError>.Failure { error } = move made {
        match move error {
          FileError failed => {
            drop failed
            return false
          }
          OutOfMemoryError exhausted => {
            fail move exhausted
          }
        }
      }
    }
    let written = run Effect.result(FileSystem.writeFileAtomic(&path, entry, FileSystem.replaceExisting(), FileSystem.buffered()))
      |> Effect.provideMut<FileSystem>(&mut self.files)
    return match move written {
      Result<(), AtomicWriteError>.Success { value: _ } => true
      Result<(), AtomicWriteError>.Failure { error } => {
        drop error
        return false
      }
    }
  }
}

impl TaskStore for DirectoryStore {
  load: DirectoryStore.load
  save: DirectoryStore.save
}

fn isHex(text: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < text.length {
    let byte = text[at]
    if !((byte >= 48 && byte <= 57) || (byte >= 97 && byte <= 102)) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

/// One file a build wrote: its path relative to the package directory (absolute when it is not
/// below it) and its bytes.
pub struct Artifact {
  pub path: Bytes,
  pub bytes: Bytes,
}

/// What a finished task left: its exit status, its standard output and error, and, for a build,
/// its artifacts.
pub struct Entry {
  pub status: i32,
  pub output: Bytes,
  pub errors: Bytes,
  pub artifacts: List<Artifact>,
}

const MAGIC: &'static [u8] = b"silk-task 1\n"

/// The stored form of `entry`: a version line, then `status`, `output`, `errors` and each
/// `artifact` as a line of decimal lengths followed by that many bytes.
pub effect fn encode(entry: &Entry) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut out = run Bytes.copy(MAGIC)
  run Bytes.append(&mut out, b"status ")
  run appendDecimal(&mut out, i32.toUsize(entry.status))
  run Bytes.append(&mut out, b"\noutput ")
  run appendDecimal(&mut out, Bytes.length(&entry.output))
  run Bytes.append(&mut out, b"\n")
  run Bytes.append(&mut out, Bytes.asSlice(&entry.output))
  run Bytes.append(&mut out, b"errors ")
  run appendDecimal(&mut out, Bytes.length(&entry.errors))
  run Bytes.append(&mut out, b"\n")
  run Bytes.append(&mut out, Bytes.asSlice(&entry.errors))
  let artifacts = List<Artifact>.asSlice(&entry.artifacts)
  let mut at = usize.ZERO
  while at < artifacts.length {
    run Bytes.append(&mut out, b"artifact ")
    run appendDecimal(&mut out, Bytes.length(&artifacts[at].path))
    run Bytes.append(&mut out, b" ")
    run appendDecimal(&mut out, Bytes.length(&artifacts[at].bytes))
    run Bytes.append(&mut out, b"\n")
    run Bytes.append(&mut out, Bytes.asSlice(&artifacts[at].path))
    run Bytes.append(&mut out, Bytes.asSlice(&artifacts[at].bytes))
    at = at + usize.ONE
  }
  return move out
}

// A reading position in a stored entry.
struct Reader {
  at: usize,
}

// Reads `word`, a space, a decimal and the byte `end` at the reader; none when they are not there.
fn number(text: &[u8], reader: &mut Reader, word: &[u8], end: u8) -> Option<usize> {
  let mut at = reader.at
  if at + word.length > text.length || !same(Slice.view<u8>(text, at, word.length), word) {
    return Option<usize>.none()
  }
  at = at + word.length
  let start = at
  let mut value = usize.ZERO
  while at < text.length && text[at] >= 48 && text[at] <= 57 {
    if at - start >= usize.add(0, 18) {
      return Option<usize>.none()
    }
    value = value * usize.add(0, 10) + u8.toUsize(text[at] - 48)
    at = at + usize.ONE
  }
  if at == start || at >= text.length || text[at] != end {
    return Option<usize>.none()
  }
  reader.at = at + usize.ONE
  return Option<usize>.some(value)
}

// Copies the next `length` bytes at the reader; none when the entry is shorter.
effect fn bytesAt(text: &[u8], reader: &mut Reader, length: usize) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  if length > text.length - reader.at {
    return Option<Bytes>.none()
  }
  let copied = run Bytes.copy(Slice.view<u8>(text, reader.at, length))
  reader.at = reader.at + length
  return Option<Bytes>.some(move copied)
}

/// The entry `text` stores, or none when it is not one `encode` wrote.
pub effect fn decode(text: &[u8]) -> Option<Entry> ! OutOfMemoryError ? &mut Allocator {
  if text.length < MAGIC.length || !same(Slice.view<u8>(text, usize.ZERO, MAGIC.length), MAGIC) {
    return Option<Entry>.none()
  }
  let mut reader = Reader { at: MAGIC.length }
  let status = match move number(text, &mut reader, b"status ", 10) {
    Option<usize>.Some { value } => value
    Option<usize>.None => {
      return Option<Entry>.none()
    }
  }
  if status > usize.add(0, 255) {
    return Option<Entry>.none()
  }
  let outputLength = match move number(text, &mut reader, b"output ", 10) {
    Option<usize>.Some { value } => value
    Option<usize>.None => {
      return Option<Entry>.none()
    }
  }
  let output = match move run bytesAt(text, &mut reader, outputLength) {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => {
      return Option<Entry>.none()
    }
  }
  let errorsLength = match move number(text, &mut reader, b"errors ", 10) {
    Option<usize>.Some { value } => value
    Option<usize>.None => {
      return Option<Entry>.none()
    }
  }
  let errors = match move run bytesAt(text, &mut reader, errorsLength) {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => {
      return Option<Entry>.none()
    }
  }
  let mut artifacts = List<Artifact>.make()
  while reader.at < text.length {
    let pathLength = match move number(text, &mut reader, b"artifact ", 32) {
      Option<usize>.Some { value } => value
      Option<usize>.None => {
        return Option<Entry>.none()
      }
    }
    let byteLength = match move number(text, &mut reader, b"", 10) {
      Option<usize>.Some { value } => value
      Option<usize>.None => {
        return Option<Entry>.none()
      }
    }
    let path = match move run bytesAt(text, &mut reader, pathLength) {
      Option<Bytes>.Some { value } => move value
      Option<Bytes>.None => {
        return Option<Entry>.none()
      }
    }
    let bytes = match move run bytesAt(text, &mut reader, byteLength) {
      Option<Bytes>.Some { value } => move value
      Option<Bytes>.None => {
        return Option<Entry>.none()
      }
    }
    run List<Artifact>.append(&mut artifacts, Artifact { path: move path, bytes: move bytes })
  }
  return Option<Entry>.some(Entry { status: usize.toI32(status), output: move output, errors: move errors, artifacts: move artifacts })
}

/// A `silk cached` command line, sorted by what each option does: `selection` picks packages,
/// `shared` changes what a build reads (so `silk hash` takes it), and `own` changes only the
/// command's output (so the task key takes it).
pub struct Split {
  pub selection: List<Bytes>,
  pub shared: List<Bytes>,
  pub own: List<Bytes>,
}

// Whether `argument` is `name` or `name=<value>`; `valued` when it is `name` alone, so the next
// argument is its value.
fn named(argument: &[u8], name: &[u8], valued: &mut bool) -> bool {
  if same(argument, name) {
    valued.* = true
    return true
  }
  valued.* = false
  return argument.length > name.length && same(Slice.view<u8>(argument, usize.ZERO, name.length), name) && argument[name.length] == 61
}

// Which list an option belongs to: 0 selection, 1 shared, 2 own; `valued` when the option takes
// the next argument as its value.
fn kind(command: &[u8], argument: &[u8], valued: &mut bool) -> usize {
  let selecting: [&'static [u8]; 2] = [b"--package", b"-p"]
  let mut at = usize.ZERO
  while at < selecting.length {
    if named(argument, selecting[at], &mut valued.*) {
      return usize.ZERO
    }
    at = at + usize.ONE
  }
  valued.* = false
  if same(argument, b"--workspace") {
    return usize.ZERO
  }
  if same(argument, b"--release") {
    return usize.ONE
  }
  let sharing: [&'static [u8]; 8] = [b"--manifest-path", b"--target", b"--optimization", b"--backend", b"--profile", b"--profile-input", b"--stdlib", b"--clang"]
  at = usize.ZERO
  while at < sharing.length {
    if named(argument, sharing[at], &mut valued.*) {
      return usize.ONE
    }
    at = at + usize.ONE
  }
  // A test's root module is another program to hash; `test --root` takes no `=` form.
  if same(command, b"test") && same(argument, b"--root") {
    valued.* = true
    return usize.ONE
  }
  let owning: [&'static [u8]; 6] = [b"--progress", b"--replay", b"--root", b"--file", b"--filter", b"--timeout"]
  at = usize.ZERO
  while at < owning.length {
    if same(argument, owning[at]) {
      valued.* = true
      return usize.add(0, 2)
    }
    at = at + usize.ONE
  }
  valued.* = false
  return usize.add(0, 2)
}

/// Sorts the options of `command` (`check`, `build` or `test`) into a `Split`, keeping each value
/// with its option and the order they were written in.
pub effect fn split(command: &[u8], arguments: &[Bytes]) -> Split ! OutOfMemoryError ? &mut Allocator {
  let mut sorted = Split { selection: List<Bytes>.make(), shared: List<Bytes>.make(), own: List<Bytes>.make() }
  let mut at = usize.ZERO
  while at < arguments.length {
    let mut valued = false
    let which = kind(command, Bytes.asSlice(&arguments[at]), &mut valued)
    let mut count = usize.ONE
    if valued && at + usize.ONE < arguments.length {
      count = usize.add(0, 2)
    }
    let mut one = usize.ZERO
    while one < count {
      let copied = run Bytes.copy(Bytes.asSlice(&arguments[at + one]))
      if which == usize.ZERO {
        run List<Bytes>.append(&mut sorted.selection, move copied)
      } else if which == usize.ONE {
        run List<Bytes>.append(&mut sorted.shared, move copied)
      } else {
        run List<Bytes>.append(&mut sorted.own, move copied)
      }
      one = one + usize.ONE
    }
    at = at + count
  }
  return move sorted
}

/// The key of running `command` with the options `own` on a package whose `silk hash` is `hash`,
/// where `context` holds what else the result depends on (`keyContext`): a SHA-256 in lowercase
/// hexadecimal.
pub effect fn key(command: &[u8], own: &[Bytes], context: &[u8], hash: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut text = run Bytes.copy(b"silk-task 1\n")
  run Bytes.append(&mut text, command)
  run Bytes.append(&mut text, b"\n")
  run appendDecimal(&mut text, context.length)
  run Bytes.append(&mut text, b":")
  run Bytes.append(&mut text, context)
  run Bytes.append(&mut text, b"\n")
  let mut at = usize.ZERO
  while at < own.length {
    run appendDecimal(&mut text, Bytes.length(&own[at]))
    run Bytes.append(&mut text, b":")
    run Bytes.append(&mut text, Bytes.asSlice(&own[at]))
    run Bytes.append(&mut text, b"\n")
    at = at + usize.ONE
  }
  run Bytes.append(&mut text, hash)
  run Bytes.append(&mut text, b"\n")
  let digest = Sha256.hash(Bytes.asSlice(&text))
  let digits = b"0123456789abcdef"
  let mut out = Bytes.make()
  let mut byte = usize.ZERO
  while byte < usize.add(0, 32) {
    let pair: [u8; 2] = [digits[u8.toUsize(digest[byte] / 16)], digits[u8.toUsize(digest[byte] % 16)]]
    run Bytes.append(&mut out, &pair)
    byte = byte + usize.ONE
  }
  return move out
}

/// One package `silk hash --json` named.
pub struct Package {
  pub name: Bytes,
  pub directory: Bytes,
  pub hash: Bytes,
  pub artifacts: List<Bytes>,
}

// A copy of the string member `key` of `value`, or none.
effect fn text(value: &Value, key: string) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  return match move (Json.field(value, key) |> Json.asString) {
    Option<string>.Some { value: found } => Option<Bytes>.some(run Bytes.copy(String.utf8Bytes(found)))
    Option<string>.None => Option<Bytes>.none()
  }
}

/// The packages of a `silk hash --json` document, or none when it is not one.
pub effect fn packages(document: &[u8]) -> Option<List<Package>> ! OutOfMemoryError ? &mut Allocator {
  let parsed = run Effect.result(Json.parse(document))
  let tree = match move parsed {
    Result<Value, JsonError | OutOfMemoryError>.Success { value } => move value
    Result<Value, JsonError | OutOfMemoryError>.Failure { error } => match move error {
      JsonError invalid => {
        drop invalid
        return Option<List<Package>>.none()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let listed = match move Json.field(&tree, "packages") {
    Option<&Value>.Some { value } => value
    Option<&Value>.None => {
      return Option<List<Package>>.none()
    }
  }
  let mut found = List<Package>.make()
  let mut at = usize.ZERO
  while true {
    let item = match move Json.item(listed, at) {
      Option<&Value>.Some { value } => value
      Option<&Value>.None => {
        break
      }
    }
    let name = run text(item, "name")
    let directory = run text(item, "directory")
    let hash = run text(item, "hash")
    let mut artifacts = List<Bytes>.make()
    if let Option<&Value>.Some { value: paths } = move Json.field(item, "artifacts") {
      let mut one = usize.ZERO
      while true {
        let path = match move (Json.item(paths, one) |> Json.asString) {
          Option<string>.Some { value } => value
          Option<string>.None => {
            break
          }
        }
        run List<Bytes>.append(&mut artifacts, run Bytes.copy(String.utf8Bytes(path)))
        one = one + usize.ONE
      }
    }
    match move name {
      Option<Bytes>.Some { value: named } => match move directory {
        Option<Bytes>.Some { value: located } => match move hash {
          Option<Bytes>.Some { value: hashed } => {
            run List<Package>.append(&mut found, Package { name: move named, directory: move located, hash: move hashed, artifacts: move artifacts })
          }
          Option<Bytes>.None => {
            return Option<List<Package>>.none()
          }
        }
        Option<Bytes>.None => {
          return Option<List<Package>>.none()
        }
      }
      Option<Bytes>.None => {
        return Option<List<Package>>.none()
      }
    }
    at = at + usize.ONE
  }
  return Option<List<Package>>.some(move found)
}

/// Whether a finished `command` with exit status `status` is kept: a check that passed or found
/// errors (its diagnostics are the result), and a build or test that passed.
pub fn keeps(command: &[u8], status: i32) -> bool {
  if status == 0 {
    return true
  }
  return same(command, b"check") && status == 1
}

/// The path an artifact is stored under: relative to the absolute `directory`, climbing with `..`
/// out of it when the artifact is elsewhere (as a workspace `output-dir` is), so a copy of the
/// project elsewhere restores it to the same place.
pub effect fn relative(directory: &[u8], path: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  // The length of the longest prefix that ends at a segment boundary of both.
  let mut common = usize.ZERO
  let mut at = usize.ZERO
  while at < directory.length && at < path.length && directory[at] == path[at] {
    at = at + usize.ONE
    if (at == directory.length || directory[at] == 47) && (at == path.length || path[at] == 47) {
      common = at
    }
  }
  let mut out = Bytes.make()
  let mut cursor = common
  while cursor < directory.length {
    if directory[cursor] == 47 && cursor + usize.ONE < directory.length {
      run Bytes.append(&mut out, b"../")
    }
    cursor = cursor + usize.ONE
  }
  let mut rest = common
  if rest < path.length && path[rest] == 47 {
    rest = rest + usize.ONE
  }
  run Bytes.append(&mut out, Slice.view<u8>(path, rest, path.length - rest))
  return move out
}

/// Where a path `relative` stored goes for a package in the absolute `directory`.
pub effect fn placed(directory: &[u8], stored: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  if stored.length > usize.ZERO && stored[usize.ZERO] == 47 {
    return run Bytes.copy(stored)
  }
  let mut path = run Bytes.copy(directory)
  let mut at = usize.ZERO
  while at < stored.length {
    let mut end = at
    while end < stored.length && stored[end] != 47 {
      end = end + usize.ONE
    }
    let segment = Slice.view<u8>(stored, at, end - at)
    if same(segment, b"..") {
      let current = Bytes.asSlice(&path)
      let mut cut = current.length
      while cut > usize.ZERO && current[cut - usize.ONE] != 47 {
        cut = cut - usize.ONE
      }
      if cut > usize.ONE {
        cut = cut - usize.ONE
      }
      let kept = run Bytes.copy(Slice.view<u8>(current, usize.ZERO, cut))
      path = move kept
    } else if segment.length > usize.ZERO && !same(segment, b".") {
      if Bytes.length(&path) != usize.ONE {
        run Bytes.append(&mut path, b"/")
      }
      run Bytes.append(&mut path, segment)
    }
    at = end + usize.ONE
  }
  return move path
}

/// The usage of `silk cached`.
pub fn usage() -> &'static [u8] {
  return b"usage: silk cached check|build|test [options]\nRuns the command once for each set of build inputs (`silk hash`) and replays it after that.\n"
}

// What running the compiler gave: its status, output and errors, or none when it could not start.
effect fn compile(silkc: &Path, environment: &[Bytes], arguments: &[Bytes]) -> Option<Outcome>
  ! OutOfMemoryError
  ? &mut ChildProcess | &mut Allocator {
  let mut request = run ChildProcess.request(silkc)
  let mut at = usize.ZERO
  while at < arguments.length {
    run ChildProcess.addArgumentBytes(&mut request, Bytes.asSlice(&arguments[at]))
    at = at + usize.ONE
  }
  let mut variable = usize.ZERO
  while variable + usize.ONE < environment.length {
    run ChildProcess.setVariableBytes(&mut request, Bytes.asSlice(&environment[variable]), Bytes.asSlice(&environment[variable + usize.ONE]))
    variable = variable + usize.add(0, 2)
  }
  let ran = run Effect.result(ChildProcess.submit(&request))
  let outcome = match move ran {
    Result<ProcessOutcome, ProcessError | OutOfMemoryError>.Success { value } => move value
    Result<ProcessOutcome, ProcessError | OutOfMemoryError>.Failure { error } => match move error {
      ProcessError failed => {
        drop failed
        return Option<Outcome>.none()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  // A compiler ended by a signal reports 128 plus the signal, as a shell does, which is never kept.
  let status = match move ChildProcess.exitCode(&outcome) {
    Option<i32>.Some { value } => value
    Option<i32>.None => match move ChildProcess.terminatingSignal(&outcome) {
      Option<i32>.Some { value: signal } => 128 + signal
      Option<i32>.None => 128
    }
  }
  return Option<Outcome>.some(Outcome {
    status: status,
    output: run Bytes.copy(ChildProcess.outputBytes(&outcome)),
    errors: run Bytes.copy(ChildProcess.errorBytes(&outcome)),
  })
}

effect fn appendAll(words: &mut List<Bytes>, from: &List<Bytes>) -> () ! OutOfMemoryError ? &mut Allocator {
  let listed = List<Bytes>.asSlice(from)
  let mut at = usize.ZERO
  while at < listed.length {
    run List<Bytes>.append(&mut words.*, run Bytes.copy(Bytes.asSlice(&listed[at])))
    at = at + usize.ONE
  }
  return ()
}

/// What a task's result depends on beyond `silk hash` and its options: the environment variables
/// that change a build's output (`environment` holds each name followed by its value), and, for a
/// build, the package directory, since a debug executable names its sources by absolute path.
pub effect fn keyContext(command: &[u8], directory: &[u8], environment: &[Bytes]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut text = Bytes.make()
  if same(command, b"build") {
    run Bytes.append(&mut text, b"directory ")
    run Bytes.append(&mut text, directory)
    run Bytes.append(&mut text, b"\n")
  }
  let names: [&'static [u8]; 5] = [b"SILK_PROFILE_GENERATE", b"SILK_PROFILE_USE", b"SILK_LLVM_AR", b"SILK_WASI_ADAPTER", b"SILK_WASI_REACTOR_ADAPTER"]
  let mut at = usize.ZERO
  while at < names.length {
    let mut variable = usize.ZERO
    while variable + usize.ONE < environment.length {
      if same(Bytes.asSlice(&environment[variable]), names[at]) {
        run Bytes.append(&mut text, names[at])
        run Bytes.append(&mut text, b"=")
        run appendDecimal(&mut text, Bytes.length(&environment[variable + usize.ONE]))
        run Bytes.append(&mut text, b":")
        run Bytes.append(&mut text, Bytes.asSlice(&environment[variable + usize.ONE]))
        run Bytes.append(&mut text, b"\n")
      }
      variable = variable + usize.add(0, 2)
    }
    at = at + usize.ONE
  }
  return move text
}

// The debug symbol map a build may write beside `artifact`.
effect fn symbolsOf(artifact: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut path = run Bytes.copy(artifact)
  run Bytes.append(&mut path, b".symbols")
  return move path
}

// Whether `artifacts` stores `path`, relative to `directory`.
effect fn stores(artifacts: &[Artifact], directory: &[u8], path: &[u8]) -> bool ! OutOfMemoryError ? &mut Allocator {
  let stored = run relative(directory, path)
  let mut at = usize.ZERO
  while at < artifacts.length {
    if same(Bytes.asSlice(&artifacts[at].path), Bytes.asSlice(&stored)) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// Writes a stored task's artifacts back for `package`, and removes a symbol map the stored build
// did not write; false when one cannot be written.
effect fn restore(package: &Package, artifacts: &[Artifact]) -> bool
  ! OutOfMemoryError
  ? &mut FileSystem | &mut HostFiles | &mut Allocator {
  let directory = Bytes.asSlice(&package.directory)
  let mut at = usize.ZERO
  while at < artifacts.length {
    let target = run placed(directory, Bytes.asSlice(&artifacts[at].path))
    let made = run Effect.result(Path.fromBytes(Bytes.asSlice(&target)))
    let path = match move made {
      Result<Path, FileError | OutOfMemoryError>.Success { value } => move value
      Result<Path, FileError | OutOfMemoryError>.Failure { error } => match move error {
        FileError invalid => {
          drop invalid
          return false
        }
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
      }
    }
    if let Option<Path>.Some { value: parent } = move run Path.parent(&path) {
      let created = run Effect.result(FileSystem.createDirectoriesRecursively(&parent))
      if let Result<(), FileError | OutOfMemoryError>.Failure { error } = move created {
        match move error {
          FileError failed => {
            drop failed
            return false
          }
          OutOfMemoryError exhausted => {
            fail move exhausted
          }
        }
      }
    }
    let written = run Effect.result(FileSystem.writeFileAtomic(&path, Bytes.asSlice(&artifacts[at].bytes), FileSystem.replaceExisting(), FileSystem.buffered()))
    if let Result<(), AtomicWriteError>.Failure { error } = move written {
      drop error
      return false
    }
    if !run HostFiles.markExecutable(&path) {
      return false
    }
    at = at + usize.ONE
  }
  let paths = List<Bytes>.asSlice(&package.artifacts)
  let mut one = usize.ZERO
  while one < paths.length {
    let symbols = run symbolsOf(Bytes.asSlice(&paths[one]))
    if !run stores(artifacts, directory, Bytes.asSlice(&symbols)) {
      let removed = run Effect.result(removePath(Bytes.asSlice(&symbols)))
      drop removed
    }
    one = one + usize.ONE
  }
  return true
}

effect fn removePath(path: &[u8]) -> () ! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let made = run Path.fromBytes(path)
  if run FileSystem.exists(&made) {
    run FileSystem.removeFile(&made)
  }
  return ()
}

// Reads the file at `path`: none when it is missing, or when `required` and it cannot be read.
effect fn readArtifact(path: &[u8], required: bool, missing: &mut bool) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let read = run Effect.result(readPath(path))
  return match move read {
    Result<Bytes, FileError | OutOfMemoryError>.Success { value } => Option<Bytes>.some(move value)
    Result<Bytes, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError failed => {
        drop failed
        if required {
          missing.* = true
        }
        return Option<Bytes>.none()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// The artifacts a finished build of `package` wrote, each with its symbol map when there is one,
// or none when an artifact cannot be read.
effect fn collect(package: &Package) -> Option<List<Artifact>>
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut collected = List<Artifact>.make()
  let paths = List<Bytes>.asSlice(&package.artifacts)
  let mut missing = false
  let mut at = usize.ZERO
  while at < paths.length {
    let symbols = run symbolsOf(Bytes.asSlice(&paths[at]))
    let both: [&[u8]; 2] = [Bytes.asSlice(&paths[at]), Bytes.asSlice(&symbols)]
    let mut one = usize.ZERO
    while one < both.length {
      if let Option<Bytes>.Some { value } = move run readArtifact(both[one], one == usize.ZERO, &mut missing) {
        let stored = run relative(Bytes.asSlice(&package.directory), both[one])
        run List<Artifact>.append(&mut collected, Artifact { path: move stored, bytes: move value })
      }
      if missing {
        return Option<List<Artifact>>.none()
      }
      one = one + usize.ONE
    }
    at = at + usize.ONE
  }
  return Option<List<Artifact>>.some(move collected)
}

effect fn readPath(path: &[u8]) -> Bytes ! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let made = run Path.fromBytes(path)
  return run FileSystem.readFile(&made)
}

// The packages `silk hash --json` names for `asked`, or none when they cannot be hashed.
effect fn hashed(silkc: &Path, environment: &[Bytes], asked: &List<Bytes>) -> Option<List<Package>>
  ! OutOfMemoryError
  ? &mut ChildProcess | &mut Allocator {
  let ran = match move run compile(silkc, environment, List<Bytes>.asSlice(asked)) {
    Option<Outcome>.Some { value } => move value
    Option<Outcome>.None => {
      return Option<List<Package>>.none()
    }
  }
  if ran.status != 0 {
    return Option<List<Package>>.none()
  }
  return run packages(Bytes.asSlice(&ran.output))
}

// Whether an option makes a command line one not to cache: `--help` prints help, and a check
// `--replay` script is read by the check, not by `silk hash`.
fn uncacheable(own: &[Bytes]) -> bool {
  let mut at = usize.ZERO
  while at < own.length {
    let word = Bytes.asSlice(&own[at])
    if same(word, b"--help") || same(word, b"-h") || same(word, b"--replay") || (word.length > usize.add(0, 9) && same(Slice.view<u8>(word, usize.ZERO, usize.add(0, 9)), b"--replay=")) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// A finished run waiting to be saved once its inputs prove unchanged.
struct Pending {
  name: Bytes,
  hash: Bytes,
  key: Bytes,
  entry: Bytes,
}

/// Runs `silk cached <arguments>` with the compiler `silkc` and the environment `environment` (each
/// name followed by its value), or answers none when the command should run without the cache, as
/// `silk <arguments>` without `cached`: the build inputs could not be hashed, the compiler did not
/// start, or the command line asks for help or a check replay.
///
/// A run is saved only when hashing again after it gives the same hash, so a file edited while it
/// ran is not saved under the inputs it had before.
pub effect fn cached(silkc: &Path, environment: &[Bytes], arguments: &[Bytes]) -> Option<Outcome>
  ! OutOfMemoryError
  ? &mut TaskStore | &mut ChildProcess | &mut FileSystem | &mut HostFiles | &mut Allocator {
  if arguments.length == usize.ZERO {
    return Option<Outcome>.some(Outcome { status: 2, output: Bytes.make(), errors: run Bytes.copy(usage()) })
  }
  let command = Bytes.asSlice(&arguments[usize.ZERO])
  if same(command, b"--help") || same(command, b"-h") {
    return Option<Outcome>.some(Outcome { status: 0, output: run Bytes.copy(usage()), errors: Bytes.make() })
  }
  if !same(command, b"check") && !same(command, b"build") && !same(command, b"test") {
    let mut errors = run Bytes.copy(b"silk cached: cannot cache `")
    run Bytes.append(&mut errors, command)
    run Bytes.append(&mut errors, b"`\n")
    run Bytes.append(&mut errors, usage())
    return Option<Outcome>.some(Outcome { status: 2, output: Bytes.make(), errors: move errors })
  }
  let options = Slice.view<Bytes>(arguments, usize.ONE, arguments.length - usize.ONE)
  let sorted = run split(command, options)
  if uncacheable(List<Bytes>.asSlice(&sorted.own)) {
    return Option<Outcome>.none()
  }
  let mut asked = List<Bytes>.make()
  run List<Bytes>.append(&mut asked, run Bytes.copy(b"hash"))
  run List<Bytes>.append(&mut asked, run Bytes.copy(b"--json"))
  // A test build loads the test runner too, and builds for the host.
  if same(command, b"test") {
    run List<Bytes>.append(&mut asked, run Bytes.copy(b"--test"))
  }
  run appendAll(&mut asked, &sorted.selection)
  run appendAll(&mut asked, &sorted.shared)
  let found = match move run hashed(silkc, environment, &asked) {
    Option<List<Package>>.Some { value } => move value
    Option<List<Package>>.None => {
      return Option<Outcome>.none()
    }
  }
  let listed = List<Package>.asSlice(&found)
  let own = List<Bytes>.asSlice(&sorted.own)
  let mut pending = List<Pending>.make()
  let mut result = Outcome { status: 0, output: Bytes.make(), errors: Bytes.make() }
  let mut at = usize.ZERO
  while at < listed.length {
    let package = &listed[at]
    let context = run keyContext(command, Bytes.asSlice(&package.directory), environment)
    let taskKey = run key(command, own, Bytes.asSlice(&context), Bytes.asSlice(&package.hash))
    let mut replayed = false
    if let Option<Bytes>.Some { value: stored } = move run TaskStore.load(Bytes.asSlice(&taskKey)) {
      if let Option<Entry>.Some { value: entry } = move run decode(Bytes.asSlice(&stored)) {
        if run restore(package, List<Artifact>.asSlice(&entry.artifacts)) {
          run Bytes.append(&mut result.output, Bytes.asSlice(&entry.output))
          run Bytes.append(&mut result.errors, Bytes.asSlice(&entry.errors))
          run Bytes.append(&mut result.errors, b"silk cached: replayed `")
          run Bytes.append(&mut result.errors, command)
          run Bytes.append(&mut result.errors, b"` of ")
          run Bytes.append(&mut result.errors, Bytes.asSlice(&package.name))
          run Bytes.append(&mut result.errors, b"\n")
          result.status = worse(result.status, entry.status)
          replayed = true
        }
      }
    }
    if !replayed {
      // One package runs as written; each of several runs alone, so its output is its own.
      let mut words = List<Bytes>.make()
      run List<Bytes>.append(&mut words, run Bytes.copy(command))
      if listed.length == usize.ONE {
        run appendAll(&mut words, &sorted.selection)
      } else {
        run List<Bytes>.append(&mut words, run Bytes.copy(b"--package"))
        run List<Bytes>.append(&mut words, run Bytes.copy(Bytes.asSlice(&package.name)))
      }
      run appendAll(&mut words, &sorted.shared)
      run appendAll(&mut words, &sorted.own)
      let ran = match move run compile(silkc, environment, List<Bytes>.asSlice(&words)) {
        Option<Outcome>.Some { value } => move value
        Option<Outcome>.None => {
          return Option<Outcome>.none()
        }
      }
      if keeps(command, ran.status) {
        let mut artifacts = Option<List<Artifact>>.some(List<Artifact>.make())
        if same(command, b"build") {
          artifacts = run collect(package)
        }
        if let Option<List<Artifact>>.Some { value: written } = move artifacts {
          let entry = Entry { status: ran.status, output: run Bytes.copy(Bytes.asSlice(&ran.output)), errors: run Bytes.copy(Bytes.asSlice(&ran.errors)), artifacts: move written }
          run List<Pending>.append(&mut pending, Pending {
            name: run Bytes.copy(Bytes.asSlice(&package.name)),
            hash: run Bytes.copy(Bytes.asSlice(&package.hash)),
            key: move taskKey,
            entry: run encode(&entry),
          })
        }
      }
      run Bytes.append(&mut result.output, Bytes.asSlice(&ran.output))
      run Bytes.append(&mut result.errors, Bytes.asSlice(&ran.errors))
      result.status = worse(result.status, ran.status)
    }
    at = at + usize.ONE
  }
  if List<Pending>.length(&pending) > usize.ZERO {
    if let Option<List<Package>>.Some { value: after } = move run hashed(silkc, environment, &asked) {
      run saveUnchanged(List<Pending>.asSlice(&pending), List<Package>.asSlice(&after))
    }
  }
  return Option<Outcome>.some(move result)
}

// Saves each pending run whose package still has the hash it ran with.
effect fn saveUnchanged(pending: &[Pending], after: &[Package]) -> () ! OutOfMemoryError ? &mut TaskStore | &mut Allocator {
  let mut at = usize.ZERO
  while at < pending.length {
    let mut one = usize.ZERO
    while one < after.length {
      if same(Bytes.asSlice(&after[one].name), Bytes.asSlice(&pending[at].name)) && same(Bytes.asSlice(&after[one].hash), Bytes.asSlice(&pending[at].hash)) {
        let saved = run TaskStore.save(Bytes.asSlice(&pending[at].key), Bytes.asSlice(&pending[at].entry))
        drop saved
      }
      one = one + usize.ONE
    }
    at = at + usize.ONE
  }
  return ()
}

// The worse of two exit statuses: the higher, so a usage error (2) outranks a failure (1).
fn worse(left: i32, right: i32) -> i32 {
  if right > left {
    return right
  }
  return left
}

/// Where `DirectoryStore` keeps tasks: SILK_TASK_CACHE (relative to `working` when it is relative),
/// else `cache/tasks` in the Silk home `home`.
pub effect fn storeRoot(working: &Path, home: &Option<Path>) -> Option<Path>
  ! HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  if let Option<Bytes>.Some { value } = move run HostInput.variableNamed("SILK_TASK_CACHE") {
    let made = run Effect.result(HostPath.fromBytes(Bytes.asSlice(&value)))
    if let Result<Path, FileError | OutOfMemoryError>.Success { value: path } = move made {
      return Option<Path>.some(move path)
    }
    let joined = run Effect.result(Path.resolveBytes(working, Bytes.asSlice(&value)))
    return match move joined {
      Result<Path, FileError | OutOfMemoryError>.Success { value: path } => Option<Path>.some(move path)
      Result<Path, FileError | OutOfMemoryError>.Failure { error } => match move error {
        FileError invalid => {
          drop invalid
          return Option<Path>.none()
        }
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
      }
    }
  }
  if let Option<Path>.Some { value } = &home.* {
    let joined = run Effect.result(Path.resolveBytes(&value, b"cache/tasks"))
    if let Result<Path, FileError | OutOfMemoryError>.Success { value: path } = move joined {
      return Option<Path>.some(move path)
    }
  }
  return Option<Path>.none()
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// Appends `value` in decimal.
effect fn appendDecimal(out: &mut Bytes, value: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  if value >= usize.add(0, 10) {
    run appendDecimal(&mut out.*, value / usize.add(0, 10))
  }
  let digit: [u8; 1] = [usize.toU8(value % usize.add(0, 10)) + 48]
  return run Bytes.append(&mut out.*, &digit)
}
