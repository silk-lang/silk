//! The compiler `silkc` beside the running tool.
//!
//! A release archive unpacks the tool as `bin/silk` beside its compiler `bin/silkc`, and Homebrew
//! and mise install them the same way. The tool finds its own executable from argument zero: a path
//! containing `/` names it relative to the working directory, and a bare name is looked up in
//! `PATH` as `execvp` would. Symbolic links then resolve with POSIX `realpath`, since the portable
//! filesystem does not follow them and package managers link commands into a shared `bin`.

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.system.filesystem { DirectoryInfo, FileError, FileInfo, FileSystem, Path }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.num.usize

unsafe extern "C" fn realpath(path: ?[*] const u8, resolved: ?[*] mut u8) -> ?[*] mut u8
with Intrinsic.foreign(noCapture: ("path", "resolved"))

// At least PATH_MAX on every supported host (4096 on Linux, 1024 on macOS), so `realpath` never
// writes past the buffer.
fn resolvedCapacity() -> usize {
  return usize.add(0, 4096)
}

fn contains(value: &[u8], wanted: u8) -> bool {
  let mut at = usize.ZERO
  while at < value.length {
    if value[at] == wanted {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

fn isNull(answer: ?[*] mut u8) -> bool {
  unsafe {
    return Pointer.isNullMany<u8>(Intrinsic.pointerRequalify<?[*] mut u8, ?[*] const u8>(answer))
  }
}

// The canonical path of `path`, relative to the working directory or absolute, with every
// symbolic link resolved, or `None` when the host cannot resolve it.
effect fn canonical(path: &[u8]) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  if contains(path, 0) {
    return Option<Bytes>.none()
  }
  let mut request = run Bytes.copy(path)
  let ending: [u8; 1] = [0]
  run Bytes.append(&mut request, &ending)
  let mut buffer = run Bytes.zeroed(resolvedCapacity())
  let answer = unsafe realpath(
    Pointer.fromSlice<u8>(Bytes.asSlice(&request)),
    Pointer.fromMutSlice<u8>(Bytes.asMutSlice(&mut buffer)),
  )
  if isNull(answer) {
    return Option<Bytes>.none()
  }
  let written = Bytes.asSlice(&buffer)
  let mut length = usize.ZERO
  while length < written.length && written[length] != 0 {
    length = length + usize.ONE
  }
  return Option<Bytes>.some(run Bytes.copy(Slice.view<u8>(written, usize.ZERO, length)))
}

// The path of the regular file `text` names, or `None` when it names none.
effect fn file(text: &[u8]) -> Option<Path> ! OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let parsed = run Effect.result(Path.fromBytes(text))
  let path = match move parsed {
    Result<Path, FileError | OutOfMemoryError>.Success { value } => move value
    Result<Path, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError invalid => {
        drop invalid
        return Option<Path>.none()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let inspected = run Effect.result(FileSystem.stat(&path))
  return match move inspected {
    Result<FileInfo | DirectoryInfo, FileError>.Success { value } => match move value {
      FileInfo found => Option<Path>.some(move path)
      DirectoryInfo folder => Option<Path>.none()
    }
    Result<FileInfo | DirectoryInfo, FileError>.Failure { error } => {
      drop error
      return Option<Path>.none()
    }
  }
}

// `silkc` in the directory of the executable at the canonical path `executable`, if it is there.
effect fn beside(executable: &[u8]) -> Option<Path> ! OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let mut end = executable.length
  while end > usize.ZERO && executable[end - usize.ONE] != 47 {
    end = end - usize.ONE
  }
  if end == usize.ZERO {
    return Option<Path>.none()
  }
  let mut compiler = run Bytes.copy(Slice.view<u8>(executable, usize.ZERO, end))
  run Bytes.append(&mut compiler, b"silkc")
  // The compiler may be a link too.
  return match move run canonical(Bytes.asSlice(&compiler)) {
    Option<Bytes>.Some { value } => run file(Bytes.asSlice(&value))
    Option<Bytes>.None => Option<Path>.none()
  }
}

// The canonical path of the running executable that `argumentZero` names, a regular file, or
// `None`. A bare name is the first match on the colon-separated `searchPath`.
effect fn executable(argumentZero: &[u8], searchPath: Option<&[u8]>) -> Option<Bytes>
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  if argumentZero.length == usize.ZERO {
    return Option<Bytes>.none()
  }
  if contains(argumentZero, 47) {
    return run canonical(argumentZero)
  }
  let entries = match move searchPath {
    Option<&[u8]>.Some { value } => value
    Option<&[u8]>.None => {
      return Option<Bytes>.none()
    }
  }
  let mut start = usize.ZERO
  let mut at = usize.ZERO
  while at <= entries.length {
    if at == entries.length || entries[at] == 58 {
      let mut candidate = Bytes.make()
      if at == start {
        run Bytes.append(&mut candidate, b".")
      } else {
        run Bytes.append(&mut candidate, Slice.view<u8>(entries, start, at - start))
      }
      run Bytes.append(&mut candidate, b"/")
      run Bytes.append(&mut candidate, argumentZero)
      if let Option<Bytes>.Some { value: resolved } = move run canonical(Bytes.asSlice(&candidate)) {
        if let Option<Path>.Some { value: found } = move run file(Bytes.asSlice(&resolved)) {
          drop found
          return Option<Bytes>.some(move resolved)
        }
      }
      start = at + usize.ONE
    }
    at = at + usize.ONE
  }
  return Option<Bytes>.none()
}

/// The compiler `silkc` beside the running tool that `argumentZero` names, found as described
/// above with the `PATH` value `searchPath`; `None` when there is none.
pub effect fn compiler(argumentZero: &[u8], searchPath: Option<&[u8]>) -> Option<Path>
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  return match move run executable(argumentZero, move searchPath) {
    Option<Bytes>.Some { value } => run beside(Bytes.asSlice(&value))
    Option<Bytes>.None => Option<Path>.none()
  }
}
