// Which releases the fake source lists.
enum Listing {
  WithTool,
  BeforeTool,
}

struct UpdateReleases {
  listing: Listing,
}

impl UpdateReleases {
  effect fn releases(self: &mut Self) -> List<Bytes>
    ! InstallError | OutOfMemoryError
    ? &mut Allocator {
    let mut published = List<Bytes>.make()
    run List<Bytes>.append(&mut published, run Bytes.copy(b"0.2.0+old"))
    if self.listing == Listing.WithTool {
      run List<Bytes>.append(&mut published, run Bytes.copy(b"0.3.0+def"))
      run List<Bytes>.append(&mut published, run Bytes.copy(b"0.4.0-dev.1+ghi"))
    }
    return move published
  }

  effect fn asset(self: &mut Self, version: &[u8], name: &[u8]) -> Bytes
    ! InstallError | OutOfMemoryError
    ? &mut Allocator {
    if same(name, b"silk-0.3.0+def-test-target.tar.gz") {
      return run Bytes.copy(stableArchive())
    }
    if same(name, b"silk-0.3.0+def-test-target.tar.gz.minisig") {
      return run Bytes.copy(stableSignature())
    }
    if same(name, b"silk-0.4.0-dev.1+ghi-test-target.tar.gz") {
      return run Bytes.copy(devArchive())
    }
    if same(name, b"silk-0.4.0-dev.1+ghi-test-target.tar.gz.minisig") {
      return run Bytes.copy(devSignature())
    }
    if same(name, b"silk-0.2.0+old-test-target.tar.gz") {
      return run Bytes.copy(earlyArchive())
    }
    if same(name, b"silk-0.2.0+old-test-target.tar.gz.minisig") {
      return run Bytes.copy(earlySignature())
    }
    fail InstallError { status: 1, message: run Bytes.copy(b"no such asset") }
  }
}

impl ReleaseSource for UpdateReleases {
  releases: UpdateReleases.releases
  asset: UpdateReleases.asset
}

// Runs `silk update` with `words` as silk `running` would, against `listing`.
effect fn update(home: &Path, running: &'static [u8], listing: Listing, words: &[&[u8]]) -> Outcome
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let context = Context {
    working: run Path.fromBytes(Path.rawBytes(home)),
    home: Option<Path>.some(run Path.fromBytes(Path.rawBytes(home))),
    environment: Option<Bytes>.none(),
    target: b"test-target",
    releaseKey: updateKey(),
    release: running,
    bundled: Option<Path>.none(),
  }
  let mut arguments = List<Bytes>.make()
  run List<Bytes>.append(&mut arguments, run Bytes.copy(b"update"))
  let mut at = usize.ZERO
  while at < words.length {
    run List<Bytes>.append(&mut arguments, run Bytes.copy(words[at]))
    at = at + usize.ONE
  }
  let mut source = UpdateReleases { listing: listing }
  let mut host = NativeHostFiles.at(temporaryRoot())
  return run Commands.networked(&context, List<Bytes>.asSlice(&arguments))
    |> Effect.provideMut<ReleaseSource>(&mut source)
    |> Effect.provideMut<HostFiles>(&mut host)
}

// Whether `home/bin/<name>` holds `expected`.
effect fn holds(home: &Path, name: string, expected: &[u8]) -> bool
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let bin = run Path.join(home, "bin")
  let path = run Path.join(&bin, name)
  if !run FileSystem.exists(&path) {
    return false
  }
  let content = run FileSystem.readFile(&path)
  return same(Bytes.asSlice(&content), expected)
}

effect fn updates(root: &Path) -> ()
  ! AssertionError<'static> | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let home = run Path.join(root, "home")
  run FileSystem.createDirectoriesRecursively(&home)
  let stable = run update(&home, b"0.2.0+old", Listing.WithTool, &[b"self"])
  let store = run Path.join(&home, "toolchains")
  let front = run holds(&home, "silk", b"silk 0.3.0+def\n")
  let stored = run FileSystem.exists(&store)
  run Testing.expect(
    stable.status == 0 && contains(Bytes.asSlice(&stable.output), b"Updated silk to 0.3.0+def")
      && front && !stored,
    "`silk update self` installs the newest stable release's tool as bin/silk and and installs no toolchain"
  )
  let current = run update(&home, b"0.3.0+def", Listing.WithTool, &[b"self"])
  run Testing.expect(
    current.status == 0 && contains(Bytes.asSlice(&current.output), b"silk 0.3.0+def is up to date"),
    "`silk update self` leaves an up-to-date tool alone"
  )
  let dev = run update(&home, b"0.3.0+def", Listing.WithTool, &[b"self", b"--dev"])
  let devFront = run holds(&home, "silk", b"silk 0.4.0-dev.1+ghi\n")
  run Testing.expect(
    dev.status == 0 && devFront,
    "`silk update self --dev` takes the newest release of any kind"
  )
  let older = run update(&home, b"0.0.0", Listing.BeforeTool, &[b"self"])
  let kept = run holds(&home, "silk", b"silk 0.4.0-dev.1+ghi\n")
  run Testing.expect(
    older.status == 1 && contains(Bytes.asSlice(&older.errors), b"has no silk tool") && kept,
    "a release without a tool fails and keeps the installed tool"
  )
  let unknown = run update(&home, b"0.0.0", Listing.WithTool, &[b"self", b"--beta"])
  run Testing.expect(unknown.status == 2, "`silk update self` takes only --dev")
}

effect fn isolatedUpdates() -> ()
  ! AssertionError<'static> | FileError | OutOfMemoryError
  ? &mut Allocator {
  let mut files = run OsFileSystem.makeBytes(temporaryRoot())
  let parent = run Path.root()
  let root = run FileSystem.createTemporaryDirectory(&parent, b"silk-update-")
    |> Effect.provideMut<FileSystem>(&mut files)
  let attempted = run Effect.result(updates(&root)) |> Effect.provideMut<FileSystem>(&mut files)
  let cleaned = run Effect.result(FileSystem.removeDirectoryRecursively(&root))
    |> Effect.provideMut<FileSystem>(&mut files)
  drop cleaned
  match move attempted {
    Result<(), AssertionError<'static> | FileError | OutOfMemoryError>.Success { value } => {}
    Result<(), AssertionError<'static> | FileError | OutOfMemoryError>.Failure { error } => {
      fail move error
    }
  }
}

test effect fn updateSelfReplacesTheTool() -> ()
  ! AssertionError<'static> | FileError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run isolatedUpdates() |> Effect.provideMut<Allocator>(&mut allocator)
}
