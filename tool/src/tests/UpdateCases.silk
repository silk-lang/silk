//! `silk update self` replaces `$SILK_HOME/bin/silk` with the `bin/silk` of the newest signed
//! release, installs no toolchain, and leaves an
//! up-to-date tool alone.

import NativeHostFiles as HostFileAccess { NativeHostFiles }
import Install as ToolchainInstall { HostFiles, InstallError, ReleaseSource }
import Command as Commands { Context, Outcome }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.system.filesystem_native { OsFileSystem }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.testing.testing { AssertionError, Testing }
import silk.num.usize

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn contains(text: &[u8], part: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at + part.length <= text.length {
    if same(Slice.view<u8>(text, at, part.length), part) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

fn temporaryRoot() -> &'static [u8] {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    return b"/private/tmp"
  } else {
    return b"/tmp"
  }
}

// Releases `0.3.0+def` and `0.4.0-dev.1+ghi`, which carry the tool `bin/silk` beside the compiler
// `bin/silkc`, and `0.2.0+old`, which has a compiler and no tool, for `test-target`, signed by `updateKey()`. Generated by signing ustar archives with Ed25519
// over BLAKE2b-512, as `minisign -S` does, with the secret seed of 32 bytes of 0x2a and key id
// 0x11..0x18.
fn updateKey() -> &'static [u8] { return b"\x52\x57\x51\x52\x45\x68\x4d\x55\x46\x52\x59\x58\x47\x42\x6c\x2f\x61\x79\x50\x68\x62\x49\x55\x79\x78\x71\x76\x49\x4f\x50\x72\x4e\x58\x71\x65\x4a\x76\x67\x78\x32\x73\x70\x49\x44\x4e\x41\x4f\x62\x2b\x6f\x73\x39\x4e\x6f\x31\x68" }
fn stableArchive() -> &'static [u8] { return b"\x1f\x8b\x08\x00\x00\x00\x00\x00\x02\xff\xed\xd4\xbd\x0e\xc2\x20\x14\x40\xe1\x3b\xfb\x14\x18\x47\xd3\x16\x4a\x2b\xcf\xe3\x4f\xd5\x46\xe3\x20\xf8\xfe\xa2\x26\x0e\xa8\x9b\x54\x8d\xe7\x5b\x20\xe9\xd0\x90\x93\x7b\x7d\xbf\xdf\x15\xba\xb4\xa5\x9e\xae\xba\x75\x11\x3a\x1f\x8a\x30\x3f\x6e\xba\x50\xc9\xbb\xe8\xc8\xb5\xed\xf5\x8c\xd2\xf3\xf1\x6e\x6a\x6b\x67\xa2\x5a\x19\xc0\xc9\xc7\xe7\xc6\xdf\xcb\x7f\xf2\xaf\xfb\x2f\xfa\x43\xf5\xa1\xfe\xd6\x68\xfa\x7f\x43\xff\xcb\xe7\x65\xf6\xfe\xa6\x4e\xfa\x37\xc6\xd6\xa2\x34\xfd\xb3\x9b\x8c\x6f\x9d\xb7\x23\x01\xf3\xff\x6c\xfe\xf3\xef\x7f\xe3\xd2\xfd\xef\x5c\xc3\xfc\x0f\xd5\x5f\xdd\xfb\xb3\x04\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xe0\x57\x9d\x01\x3e\xd2\x2b\x19\x00\x28\x00\x00" }
