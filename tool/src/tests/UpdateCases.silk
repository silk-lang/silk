//! `silk update self` replaces `$SILK_HOME/bin/silk` with the `bin/silk` of the newest signed
//! release, removes the `bin/sew` an earlier release installed, installs no toolchain, and leaves an
//! up-to-date tool alone.

import NativeHostFiles as HostFileAccess { NativeHostFiles }
import Install as ToolchainInstall { HostFiles, InstallError, ReleaseSource }
import Command as Commands { Context, Outcome }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.collections.list { List }
import silk.option { Option }
import silk.system.filesystem_native { OsFileSystem }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.testing.testing { AssertionError, Testing }
import silk.num.usize

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn contains(text: &[u8], part: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at + part.length <= text.length {
    if same(Slice.view<u8>(text, at, part.length), part) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

fn temporaryRoot() -> &'static [u8] {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    return b"/private/tmp"
  } else {
    return b"/tmp"
  }
}

// Releases `0.3.0+def` and `0.4.0-dev.1+ghi`, which carry the tool `bin/silk` beside the compiler
// `bin/silkc`, and `0.2.0+old`, whose `bin/silk` is its compiler, for `test-target`, signed by `updateKey()`. Generated by signing ustar archives with Ed25519
// over BLAKE2b-512, as `minisign -S` does, with the secret seed of 32 bytes of 0x2a and key id
// 0x11..0x18.
fn updateKey() -> &'static [u8] { return b"RWQREhMUFRYXGBl/ayPhbIUyxqvIOPrNXqeJvgx2spIDNAOb+os9No1h" }
fn stableArchive() -> &'static [u8] { return b"\x1f\x8b\x08\x00\x00\x00\x00\x00\x02\xff\xed\xd4\xbd\x0e\xc2 \x14@\xe1;\xfb\x14\x18G\xd3\x16J+\xcf\xe3O\xd5F\xe3 \xf8\xfe\xa2&\x0e\xa8\x9bT\x8d\xe7[ \xe9\xd0\x90\x93{}\xbf\xdf\x15\xba\xb4\xa5\x9e\xae\xbau\x11:\x1f\x8a0?n\xbaP\xc9\xbb\xe8\xc8\xb5\xed\xf5\x8c\xd2\xf3\xf1njkg\xa2Z\x19\xc0\xc9\xc7\xe7\xc6\xdf\xcb\x7f\xf2\xaf\xfb/\xfaC\xf5\xa1\xfe\xd6h\xfa\x7fC\xff\xcb\xe7e\xf6\xfe\xa6N\xfa7\xc6\xd6\xa24\xfd\xb3\x9b\x8co\x9d\xb7#\x01\xf3\xffl\xfe\xf3\xef\x7f\xe3\xd2\xfd\xef\x5c\xc3\xfc\x0f\xd5_\xdd\xfb\xb3\x04\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xe0W\x9d\x01>\xd2+\x19\x00(\x00\x00" }
fn stableSignature() -> &'static [u8] { return b"untrusted comment: signature from minisign secret key\x0aRUQREhMUFRYXGEpckaWMPD1HONjdJwjr+VZtCOeg/n2F6j7ykwKzVjEq8v6QArBNlZUA5UyIEN8G/rb5OdUrLNcEPk8qK7Tv5A0=\x0atrusted comment: silk v0.3.0+def silk-0.3.0+def-test-target.tar.gz\x0a2NPUNz7AqoIZrCNHUhAixf5UmEGYzb2lfZGqDrD++WMJSF/XeMMp9/t3TFkk/00SH9ueCye4ALijHHMd1xXuAw==\x0a" }
fn devArchive() -> &'static [u8] { return b"\x1f\x8b\x08\x00\x00\x00\x00\x00\x02\xff\xed\xd4\xbd\x0a\xc20\x14@\xe1\xcc>E\xc5Q\xd2\xde\xa6\x8d}\x1e\x7fB[\x14\x07\x13}~\xa3n\x11q\x90\x06\xc5\xf3-\xc9P(\xe1p\xaf\x1f\x0f{-e[\x8a\xde\xb9KY/\xfba\xd4\xc1\xf9\xa0\xc3\xfa\xd4\xbbP\xa9\xcfI\xd4Y{?\xa3\xf4|\xbe\xd7\x8dY5\xaa\xb0*\x83\xb3\x8f\x0f\x8d\xbfW\xff\xc9\xbf\xeb\xbf\x19\x8fU\xf6\xfe\xad4\xf4\xff\x9e\xfe\xb7\x8f\xb6\x13\xf6\xafM\xd2\xdf\x8a\xedT!\xf4\x9f\xdcb\xfe(<\xcc\x14\x98\xff\xd7\xf3?\xe5\xfe76\xdd\xff\x9d\x11\xe6?W\xff\x22\xe9\xcf*\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x80\xdfs\x05\x1b-\xdfM\x00(\x00\x00" }
fn devSignature() -> &'static [u8] { return b"untrusted comment: signature from minisign secret key\x0aRUQREhMUFRYXGLh7ElBOuzPNp9JM/OZ8gTEmK3ZiUBcHa6d89DugbfSxJAio2UXUHCgjrkfPwaipyU99hi+jXoapIYKR4zxnuA8=\x0atrusted comment: silk v0.4.0-dev.1+ghi silk-0.4.0-dev.1+ghi-test-target.tar.gz\x0aChutAOZMkKV62HfX8dLxBO7KwQLr3N3vgWmUYoXNg7t56SR+JmDYnzXwhIE03GBOMbzRaujNfmxCUWt22/W2CQ==\x0a" }
fn earlyArchive() -> &'static [u8] { return b"\x1f\x8b\x08\x00\x00\x00\x00\x00\x02\xff\xed\xd1M\x0a\xc20\x10@\xe1Y{\x8a\x8aKI;I\x8d\x9eG\xb1h\xb1(\x98\xf4\xfe\x8e\xba\xab\xb8\xb3\xfe\xe0\xfb6\x13\x98@\x08/\xb5\xdd\xc1i\x19J\x9d\x9f\xba\xad\xcbM\xca.\xaf\xcf\xbb&W\xf2*jV1\xde\xa6\x19\xce\xc7\xb3\x0f\xb5]/\xa2\xbcA\x9f\xec\xbb\xf6\xbc\xfc\xa7\xf4\xbc\xff\xa6=V\x1f\xea_\xfb@\xffo\xe8\x7f]\x8f\xdf\xdf\x87A\xff\x85\xeaR\x0a\xa5\xff\xe8f\xd3{\xe7\xfdD\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xf0\x83.X\xa7\xdaV\x00(\x00\x00" }
fn earlySignature() -> &'static [u8] { return b"untrusted comment: signature from minisign secret key\x0aRUQREhMUFRYXGE7882qP1FECRthgpNK9C8Nk6jKTKwvx9qncyR0Ub45/4GKipALFvV4ksyB/ZiKI/lRkf83iFUtawjIFdRyQFgM=\x0atrusted comment: silk v0.2.0+old silk-0.2.0+old-test-target.tar.gz\x0agD4CYspweiTxFqfPF7euPEQeDZr8VYmxOYaUSFjLYikXf/ChwHjQ13DVB0VWs6WQJya+WSWDEzDVLJtdT0TTDA==\x0a" }

// Which releases the fake source lists.
enum Listing {
  WithTool,
  BeforeTool,
}

struct UpdateReleases {
  listing: Listing,
}

impl UpdateReleases {
  effect fn releases(self: &mut Self) -> List<Bytes>
    ! InstallError | OutOfMemoryError
    ? &mut Allocator {
    let mut published = List<Bytes>.make()
    run List<Bytes>.append(&mut published, run Bytes.copy(b"0.2.0+old"))
    if self.listing == Listing.WithTool {
      run List<Bytes>.append(&mut published, run Bytes.copy(b"0.3.0+def"))
      run List<Bytes>.append(&mut published, run Bytes.copy(b"0.4.0-dev.1+ghi"))
    }
    return move published
  }

  effect fn asset(self: &mut Self, version: &[u8], name: &[u8]) -> Bytes
    ! InstallError | OutOfMemoryError
    ? &mut Allocator {
    if same(name, b"silk-0.3.0+def-test-target.tar.gz") {
      return run Bytes.copy(stableArchive())
    }
    if same(name, b"silk-0.3.0+def-test-target.tar.gz.minisig") {
      return run Bytes.copy(stableSignature())
    }
    if same(name, b"silk-0.4.0-dev.1+ghi-test-target.tar.gz") {
      return run Bytes.copy(devArchive())
    }
    if same(name, b"silk-0.4.0-dev.1+ghi-test-target.tar.gz.minisig") {
      return run Bytes.copy(devSignature())
    }
    if same(name, b"silk-0.2.0+old-test-target.tar.gz") {
      return run Bytes.copy(earlyArchive())
    }
    if same(name, b"silk-0.2.0+old-test-target.tar.gz.minisig") {
      return run Bytes.copy(earlySignature())
    }
    fail InstallError { status: 1, message: run Bytes.copy(b"no such asset") }
  }
}

impl ReleaseSource for UpdateReleases {
  releases: UpdateReleases.releases
  asset: UpdateReleases.asset
}

// Runs `silk update` with `words` as silk `running` would, against `listing`.
effect fn update(home: &Path, running: &'static [u8], listing: Listing, words: &[&[u8]]) -> Outcome
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let context = Context {
    working: run Path.fromBytes(Path.rawBytes(home)),
    home: Option<Path>.some(run Path.fromBytes(Path.rawBytes(home))),
    environment: Option<Bytes>.none(),
    target: b"test-target",
    releaseKey: updateKey(),
    release: running,
    bundled: Option<Path>.none(),
  }
  let mut arguments = List<Bytes>.make()
  run List<Bytes>.append(&mut arguments, run Bytes.copy(b"update"))
  let mut at = usize.ZERO
  while at < words.length {
    run List<Bytes>.append(&mut arguments, run Bytes.copy(words[at]))
    at = at + usize.ONE
  }
  let mut source = UpdateReleases { listing: listing }
  let mut host = NativeHostFiles.at(temporaryRoot())
  return run Commands.networked(&context, List<Bytes>.asSlice(&arguments))
    |> Effect.provideMut<ReleaseSource>(&mut source)
    |> Effect.provideMut<HostFiles>(&mut host)
}

// Whether `home/bin/<name>` holds `expected`.
effect fn holds(home: &Path, name: string, expected: &[u8]) -> bool
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let bin = run Path.join(home, "bin")
  let path = run Path.join(&bin, name)
  if !run FileSystem.exists(&path) {
    return false
  }
  let content = run FileSystem.readFile(&path)
  return same(Bytes.asSlice(&content), expected)
}

effect fn updates(root: &Path) -> ()
  ! AssertionError<'static> | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let home = run Path.join(root, "home")
  run FileSystem.createDirectoriesRecursively(&home)
  let earlier = run Path.join(&home, "bin/sew")
  run FileSystem.writeFileWithParents(&earlier, b"sew 0.1.0\n")
  let stable = run update(&home, b"0.2.0+old", Listing.WithTool, &[b"self"])
  let store = run Path.join(&home, "toolchains")
  let front = run holds(&home, "silk", b"silk 0.3.0+def\n")
  let stored = run FileSystem.exists(&store)
  let leftover = run FileSystem.exists(&earlier)
  run Testing.expect(
    stable.status == 0 && contains(Bytes.asSlice(&stable.output), b"Updated silk to 0.3.0+def")
      && front && !stored && !leftover,
    "`silk update self` installs the newest stable release's tool as bin/silk, removes bin/sew, and installs no toolchain"
  )
  let current = run update(&home, b"0.3.0+def", Listing.WithTool, &[b"self"])
  run Testing.expect(
    current.status == 0 && contains(Bytes.asSlice(&current.output), b"silk 0.3.0+def is up to date"),
    "`silk update self` leaves an up-to-date tool alone"
  )
  let dev = run update(&home, b"0.3.0+def", Listing.WithTool, &[b"self", b"--dev"])
  let devFront = run holds(&home, "silk", b"silk 0.4.0-dev.1+ghi\n")
  run Testing.expect(
    dev.status == 0 && devFront,
    "`silk update self --dev` takes the newest release of any kind"
  )
  let older = run update(&home, b"0.0.0", Listing.BeforeTool, &[b"self"])
  let kept = run holds(&home, "silk", b"silk 0.4.0-dev.1+ghi\n")
  run Testing.expect(
    older.status == 1 && contains(Bytes.asSlice(&older.errors), b"released before the tool existed") && kept,
    "a release whose bin/silk is its compiler fails and keeps the installed tool"
  )
  let unknown = run update(&home, b"0.0.0", Listing.WithTool, &[b"self", b"--beta"])
  run Testing.expect(unknown.status == 2, "`silk update self` takes only --dev")
}

effect fn isolatedUpdates() -> ()
  ! AssertionError<'static> | FileError | OutOfMemoryError
  ? &mut Allocator {
  let mut files = run OsFileSystem.makeBytes(temporaryRoot())
  let parent = run Path.root()
  let root = run FileSystem.createTemporaryDirectory(&parent, b"silk-update-")
    |> Effect.provideMut<FileSystem>(&mut files)
  let attempted = run Effect.result(updates(&root)) |> Effect.provideMut<FileSystem>(&mut files)
  let cleaned = run Effect.result(FileSystem.removeDirectoryRecursively(&root))
    |> Effect.provideMut<FileSystem>(&mut files)
  drop cleaned
  match move attempted {
    Result<(), AssertionError<'static> | FileError | OutOfMemoryError>.Success { value } => {}
    Result<(), AssertionError<'static> | FileError | OutOfMemoryError>.Failure { error } => {
      fail move error
    }
  }
}

test effect fn updateSelfReplacesTheTool() -> ()
  ! AssertionError<'static> | FileError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run isolatedUpdates() |> Effect.provideMut<Allocator>(&mut allocator)
}
