//! The silk tool hands a command to the toolchain the directory selects, drops a leading `+<version>`, and
//! exits 3 when the selected toolchain is not installed or nothing selects one.

import Command as Commands { Context }
import Forward as Forwards { Action, Forwarding }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.system.filesystem_native { OsFileSystem }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.testing.testing { AssertionError, Testing }
import silk.num.usize
import Toolchains

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn endsWith(text: &[u8], suffix: &[u8]) -> bool {
  if text.length < suffix.length {
    return false
  }
  let mut at = usize.ZERO
  while at < suffix.length {
    if text[text.length - suffix.length + at] != suffix[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn startsWith(text: &[u8], prefix: &[u8]) -> bool {
  return text.length >= prefix.length && same(Slice.view<u8>(text, usize.ZERO, prefix.length), prefix)
}

fn contains(text: &[u8], part: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at + part.length <= text.length {
    if same(Slice.view<u8>(text, at, part.length), part) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

fn suggests(word: &[u8], expected: &[u8]) -> bool {
  return match Commands.suggestion(word) {
    Option<&'static [u8]>.Some { value } => same(value, expected)
    Option<&'static [u8]>.None => expected.length == usize.ZERO
  }
}

test effect fn mistypedToolCommandsAreSuggested() -> () ! AssertionError<'static> {
  run Testing.expect(
    suggests(b"uze", b"use") && suggests(b"ues", b"use") && suggests(b"us", b"use") && suggests(b"uses", b"use")
      && suggests(b"sed", b"set") && suggests(b"updte", b"update") && suggests(b"udpate", b"update")
      && suggests(b"changes", b"change"),
    "a word one edit from use, set, update or change suggests that command"
  )
  run Testing.expect(
    suggests(b"use", b"") && suggests(b"test", b"") && suggests(b"tset", b"") && suggests(b"build", b"")
      && suggests(b"lsp", b"") && suggests(b"frobnicate", b"") && suggests(b"", b""),
    "silk's own commands, compiler commands, words near a compiler command and unrelated words suggest nothing"
  )
}

fn temporaryRoot() -> string<'static> {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    return "/private/tmp"
  } else {
    return "/tmp"
  }
}

effect fn write(root: &Path, relative: string, text: &[u8]) -> ()
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let path = run Path.join(root, relative)
  run FileSystem.writeFileWithParents(&path, text)
}

// The decision for `words` run in `working`, with `SILK_TOOLCHAIN` set to `environment` when it
// is not empty.
effect fn decided(working: &Path, home: &Path, environment: &[u8], words: &[&[u8]]) -> Forwarding
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut selected = Option<Bytes>.none()
  if environment.length > usize.ZERO {
    selected = Option<Bytes>.some(run Bytes.copy(environment))
  }
  let context = Context {
    working: run Path.fromBytes(Path.rawBytes(working)),
    home: Option<Path>.some(run Path.fromBytes(Path.rawBytes(home))),
    environment: move selected,
    target: b"test-target",
    releaseKey: b"",
    release: b"0.0.0",
    bundled: Option<Path>.none(),
  }
  let mut arguments = List<Bytes>.make()
  let mut at = usize.ZERO
  while at < words.length {
    run List<Bytes>.append(&mut arguments, run Bytes.copy(words[at]))
    at = at + usize.ONE
  }
  return run Forwards.decide(&context, List<Bytes>.asSlice(&arguments))
}

// Whether `decision` replaces the process with `home`'s toolchain `name`, skipping `skip` arguments.
// dev.6 is laid out as releases are since the compiler became `bin/silkc`; dev.4 is older, and its
// compiler is `bin/silk`.
effect fn replaces(decision: &Forwarding, home: &Path, name: &[u8], skip: usize) -> bool
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let mut expected = run Bytes.copy(Path.rawBytes(home))
  run Bytes.append(&mut expected, b"/toolchains/")
  run Bytes.append(&mut expected, name)
  if same(name, b"0.1.0-dev.6+1aed5da1a342") {
    run Bytes.append(&mut expected, b"/bin/silkc")
  } else {
    run Bytes.append(&mut expected, b"/bin/silk")
  }
  return decision.action == Action.Replace
    && same(Bytes.asSlice(&decision.executable), Bytes.asSlice(&expected))
    && same(Bytes.asSlice(&decision.version), name) && decision.skip == skip
}

effect fn dispatches(root: &Path) -> ()
  ! AssertionError<'static> | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let home = run Path.join(root, "home")
  run write(&home, "toolchains/0.1.0-dev.4+892d3bee6c53/bin/silk", b"")
  run write(&home, "toolchains/0.1.0-dev.6+1aed5da1a342/bin/silkc", b"")
  run write(
    root,
    "app/silk.toml",
    b"[package]\nname = \"app\"\nversion = \"0.1.0\"\nsilk-version = \"0.1.0-dev.4\"\nsource = \".\"\n"
  )
  run write(
    root,
    "missing/silk.toml",
    b"[package]\nname = \"missing\"\nversion = \"0.1.0\"\nsilk-version = \"0.1.0-dev.5\"\nsource = \".\"\n"
  )
  let app = run Path.join(root, "app")
  let missing = run Path.join(root, "missing")
  let outside = run Path.join(root, "outside")
  run write(root, "outside/keep", b"")
  let pinned = run decided(&app, &home, b"", &[b"build"])
  run Testing.expect(
    run replaces(&pinned, &home, b"0.1.0-dev.4+892d3bee6c53", usize.ZERO),
    "a project's pin runs the installed toolchain it names, with the full version in SILK_TOOLCHAIN"
  )
  let environment = run decided(&app, &home, b"0.1.0-dev.6+1aed5da1a342", &[b"build"])
  run Testing.expect(
    run replaces(&environment, &home, b"0.1.0-dev.6+1aed5da1a342", usize.ZERO),
    "SILK_TOOLCHAIN overrides the pin"
  )
  let requested = run decided(&app, &home, b"0.1.0-dev.4", &[b"+0.1.0-dev.6", b"build"])
  run Testing.expect(
    run replaces(&requested, &home, b"0.1.0-dev.6+1aed5da1a342", usize.ONE),
    "+<version> overrides both, and the compiler does not see it"
  )
  let absent = run decided(&missing, &home, b"", &[b"build"])
  run Testing.expect(
    absent.action == Action.Exit && absent.status == Commands.NOT_INSTALLED
      && same(Bytes.asSlice(&absent.missing), b"0.1.0-dev.5")
      && endsWith(Bytes.asSlice(&absent.errors), b") is not installed.\nInstall it with: silk use\n"),
    "a missing pinned toolchain exits 3 and names the version to install"
  )
  let nothing = run decided(&outside, &home, b"", &[b"build"])
  run Testing.expect(
    nothing.action == Action.Exit && nothing.status == Commands.NOT_INSTALLED
      && Bytes.length(&nothing.missing) == usize.ZERO,
    "with no pin and no default, nothing is selected and nothing installs itself"
  )
  run Toolchains.setDefault(&home, b"0.1.0-dev.6+1aed5da1a342")
  let defaulted = run decided(&outside, &home, b"", &[b"lsp"])
  run Testing.expect(
    run replaces(&defaulted, &home, b"0.1.0-dev.6+1aed5da1a342", usize.ZERO),
    "outside a project the default runs"
  )
  let garbage = run decided(&app, &home, b"", &[b"+garbage", b"build"])
  run Testing.expect(
    garbage.action == Action.Exit && garbage.status == 2
      && same(
        Bytes.asSlice(&garbage.errors),
        b"silk: `+garbage` is not a Silk version; +<version> takes a semantic version such as +0.1.0-dev.11\n"
      ),
    "+<version> that is not a semantic version is a usage error, not a missing toolchain"
  )
  let nonsense = run decided(&app, &home, b"nonsense", &[b"--version"])
  let overridden = run decided(&app, &home, b"nonsense", &[b"+0.1.0-dev.6", b"--version"])
  let overrides = run replaces(&overridden, &home, b"0.1.0-dev.6+1aed5da1a342", usize.ONE)
  run Testing.expect(
    nonsense.action == Action.Exit && nonsense.status == 2
      && same(
        Bytes.asSlice(&nonsense.errors),
        b"silk: SILK_TOOLCHAIN=nonsense is not a Silk version; set it to a semantic version such as 0.1.0-dev.11, or unset it\n"
      )
      && overrides,
    "SILK_TOOLCHAIN that is not a version is a usage error like +<version>, unless +<version> overrides it"
  )
  run write(
    root,
    "workspace/silk.toml",
    b"[workspace]\nmembers = [\"member\", \"agrees\"]\nsilk-version = \"0.1.0-dev.6+1aed5da1a342\"\n"
  )
  run write(
    root,
    "workspace/member/silk.toml",
    b"[package]\nname = \"member\"\nversion = \"0.1.0\"\nsilk-version = \"0.1.0-dev.4\"\nsource = \".\"\n"
  )
  run write(
    root,
    "workspace/agrees/silk.toml",
    b"[package]\nname = \"agrees\"\nversion = \"0.1.0\"\nsilk-version = \"0.1.0-dev.6\"\nsource = \".\"\n"
  )
  let member = run Path.join(root, "workspace/member")
  let agrees = run Path.join(root, "workspace/agrees")
  let shadowed = run decided(&member, &home, b"", &[b"build"])
  let agreeing = run decided(&agrees, &home, b"", &[b"build"])
  let runsWorkspacePin = run replaces(&shadowed, &home, b"0.1.0-dev.6+1aed5da1a342", usize.ZERO)
  let agreeingRuns = run replaces(&agreeing, &home, b"0.1.0-dev.6+1aed5da1a342", usize.ZERO)
  run Testing.expect(
    runsWorkspacePin
      && startsWith(Bytes.asSlice(&shadowed.errors), b"silk: note: ")
      && contains(Bytes.asSlice(&shadowed.errors), b"/workspace/member/silk.toml sets silk-version = \"0.1.0-dev.4\", which is ignored: the workspace silk-version in ")
      && contains(Bytes.asSlice(&shadowed.errors), b"/workspace/silk.toml (0.1.0-dev.6+1aed5da1a342) covers its members.\n")
      && agreeingRuns
      && Bytes.length(&agreeing.errors) == usize.ZERO,
    "a member pin the workspace pin overrides is named in a note, and one that agrees is not"
  )
  run write(
    root,
    "future/silk.toml",
    b"[package]\nname = \"future\"\nversion = \"0.1.0\"\nsilk-version = \"~1\"\nsource = \".\"\n"
  )
  let future = run Path.join(root, "future")
  let unknown = run decided(&future, &home, b"", &[b"build"])
  run Testing.expect(
    unknown.action == Action.Exit && unknown.status == 2,
    "a pin this tool cannot read stops with a configuration error"
  )
}

effect fn isolatedDispatches() -> ()
  ! AssertionError<'static> | FileError | OutOfMemoryError
  ? &mut Allocator {
  let mut files = run OsFileSystem.make(temporaryRoot())
  let parent = run Path.root()
  let root = run FileSystem.createTemporaryDirectory(&parent, b"silk-forward-")
    |> Effect.provideMut<FileSystem>(&mut files)
  let attempted = run Effect.result(dispatches(&root)) |> Effect.provideMut<FileSystem>(&mut files)
  let cleaned = run Effect.result(FileSystem.removeDirectoryRecursively(&root))
    |> Effect.provideMut<FileSystem>(&mut files)
  drop cleaned
  match move attempted {
    Result<(), AssertionError<'static> | FileError | OutOfMemoryError>.Success { value } => {}
    Result<(), AssertionError<'static> | FileError | OutOfMemoryError>.Failure { error } => {
      fail move error
    }
  }
}

test effect fn forwardingFollowsTheSelection() -> ()
  ! AssertionError<'static> | FileError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run isolatedDispatches() |> Effect.provideMut<Allocator>(&mut allocator)
}

// The decision for `words` run in `working` by a tool of release `0.2.0+rel` with a compiler
// `bin/silkc` beside it below `root`.
effect fn bundledDecision(root: &Path, working: &Path, home: &Path, words: &[&[u8]]) -> Forwarding
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let compiler = run Path.join(root, "release/bin/silkc")
  let context = Context {
    working: run Path.fromBytes(Path.rawBytes(working)),
    home: Option<Path>.some(run Path.fromBytes(Path.rawBytes(home))),
    environment: Option<Bytes>.none(),
    target: b"test-target",
    releaseKey: b"",
    release: b"0.2.0+rel",
    bundled: Option<Path>.some(move compiler),
  }
  let mut arguments = List<Bytes>.make()
  let mut at = usize.ZERO
  while at < words.length {
    run List<Bytes>.append(&mut arguments, run Bytes.copy(words[at]))
    at = at + usize.ONE
  }
  return run Forwards.decide(&context, List<Bytes>.asSlice(&arguments))
}

// Whether `decision` runs the compiler beside the tool as `0.2.0+rel`.
effect fn runsBundled(decision: &Forwarding, root: &Path) -> bool
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let mut expected = run Bytes.copy(Path.rawBytes(root))
  run Bytes.append(&mut expected, b"/release/bin/silkc")
  return decision.action == Action.Replace
    && same(Bytes.asSlice(&decision.executable), Bytes.asSlice(&expected))
    && same(Bytes.asSlice(&decision.version), b"0.2.0+rel")
}

effect fn bundledRuns(root: &Path) -> ()
  ! AssertionError<'static> | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let home = run Path.join(root, "home")
  run write(root, "release/bin/silkc", b"")
  run write(&home, "toolchains/0.1.0-dev.4+892d3bee6c53/bin/silk", b"")
  run write(root, "outside/keep", b"")
  run write(
    root,
    "same/silk.toml",
    b"[package]\nname = \"same\"\nversion = \"0.1.0\"\nsilk-version = \"0.2.0\"\nsource = \".\"\n"
  )
  run write(
    root,
    "other/silk.toml",
    b"[package]\nname = \"other\"\nversion = \"0.1.0\"\nsilk-version = \"0.1.0-dev.5\"\nsource = \".\"\n"
  )
  run write(
    root,
    "stored/silk.toml",
    b"[package]\nname = \"stored\"\nversion = \"0.1.0\"\nsilk-version = \"0.1.0-dev.4\"\nsource = \".\"\n"
  )
  let outside = run Path.join(root, "outside")
  let same = run Path.join(root, "same")
  let other = run Path.join(root, "other")
  let stored = run Path.join(root, "stored")
  let unselected = run bundledDecision(root, &outside, &home, &[b"build"])
  run Testing.expect(
    run runsBundled(&unselected, root),
    "with nothing selected, the compiler beside the tool runs as the tool's release"
  )
  let pinned = run bundledDecision(root, &same, &home, &[b"build"])
  run Testing.expect(
    run runsBundled(&pinned, root),
    "a pin that names the tool's own release, missing from the store, runs the compiler beside the tool"
  )
  let elsewhere = run bundledDecision(root, &other, &home, &[b"build"])
  run Testing.expect(
    elsewhere.action == Action.Exit && elsewhere.status == Commands.NOT_INSTALLED,
    "a pin of another version still needs it installed"
  )
  let installed = run bundledDecision(root, &stored, &home, &[b"build"])
  run Testing.expect(
    run replaces(&installed, &home, b"0.1.0-dev.4+892d3bee6c53", usize.ZERO),
    "an installed pin runs from the store"
  )
}

effect fn isolatedBundled() -> ()
  ! AssertionError<'static> | FileError | OutOfMemoryError
  ? &mut Allocator {
  let mut files = run OsFileSystem.make(temporaryRoot())
  let parent = run Path.root()
  let root = run FileSystem.createTemporaryDirectory(&parent, b"silk-bundled-")
    |> Effect.provideMut<FileSystem>(&mut files)
  let attempted = run Effect.result(bundledRuns(&root)) |> Effect.provideMut<FileSystem>(&mut files)
  let cleaned = run Effect.result(FileSystem.removeDirectoryRecursively(&root))
    |> Effect.provideMut<FileSystem>(&mut files)
  drop cleaned
  match move attempted {
    Result<(), AssertionError<'static> | FileError | OutOfMemoryError>.Success { value } => {}
    Result<(), AssertionError<'static> | FileError | OutOfMemoryError>.Failure { error } => {
      fail move error
    }
  }
}

test effect fn bundledCompilerRunsItsOwnRelease() -> ()
  ! AssertionError<'static> | FileError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run isolatedBundled() |> Effect.provideMut<Allocator>(&mut allocator)
}
