fn realSignature() -> &'static [u8] {
  return b"untrusted comment: signature from the Silk release key\x0aRUQefAo9Dbb8Lije8bVpP+VZ0WWuQnAYE3ADOQ+1t1c6/E/kBm/E0yCSIXhuUoKlU4phvP3z3z/41UVej2umz0pVjW+W9ocfSgo=\x0atrusted comment: silk v0.1.0-dev.6+1aed5da1a342 silk-0.1.0-dev.6+1aed5da1a342-x86_64-unknown-linux-gnu.tar.gz\x0aWJXW2jP37B4kaLtWRx4WOdjVFfVzIiSZ4NC7LPwe8ov2jtO13spO5GXBoTzgC85EDZ+fI1y3OG9xJtGs2vZQBg==\x0a"
