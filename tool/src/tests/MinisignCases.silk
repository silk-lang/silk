//! Minisign verification accepts the release format and refuses every altered part of it.

import Minisign as Minisign { MinisignError, MinisignKey }
import silk.core.result { Result }
import silk.testing.testing { AssertionError, Testing }
import silk.num.usize

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// Whether verifying `signature` fails with `expected`.
fn outcome(publicKey: &[u8], signature: &[u8], content: &[u8], expected: MinisignError) -> bool {
  let signer = match Minisign.key(publicKey) {
    Result<MinisignKey, MinisignError>.Success { value } => move value
    Result<MinisignKey, MinisignError>.Failure { error } => {
      return false
    }
  }
  return match Minisign.verify(&signer, signature, content) {
    Result<&[u8], MinisignError>.Success { value } => false
    Result<&[u8], MinisignError>.Failure { error } => error == expected
  }
}

fn accepts(publicKey: &[u8], signature: &[u8], content: &[u8]) -> bool {
  let signer = match Minisign.key(publicKey) {
    Result<MinisignKey, MinisignError>.Success { value } => move value
    Result<MinisignKey, MinisignError>.Failure { error } => {
      return false
    }
  }
  return match Minisign.verify(&signer, signature, content) {
    Result<&[u8], MinisignError>.Success { value } => same(value, comment())
    Result<&[u8], MinisignError>.Failure { error } => false
  }
}

fn invalidKey(text: &[u8]) -> bool {
  return match Minisign.key(text) {
    Result<MinisignKey, MinisignError>.Success { value } => false
    Result<MinisignKey, MinisignError>.Failure { error } => error == MinisignError.InvalidKey
  }
}

test effect fn minisignAcceptsPrehashedAndLegacySignatures() -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    accepts(testKey(), prehashed(), content()),
    "a prehashed ED signature verifies and returns its trusted comment"
  )
  run Testing.expect(
    accepts(testKey(), legacy(), content()),
    "a legacy Ed signature verifies and returns its trusted comment"
  )
}

test effect fn minisignRefusesAlteredInputs() -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    outcome(
      testKey(),
      prehashed(),
      b"silk toolchain archive bytes\n",
      MinisignError.InvalidSignature
    ),
    "different content is refused"
  )
  run Testing.expect(
    outcome(testKey(), otherKeyId(), content(), MinisignError.WrongKey),
    "a signature from another key id is refused"
  )
  run Testing.expect(
    outcome(testKey(), tamperedComment(), content(), MinisignError.InvalidTrustedComment),
    "an edited trusted comment is refused"
  )
  run Testing.expect(
    outcome(testKey(), b"untrusted comment: x\n", content(), MinisignError.MalformedSignature),
    "a truncated file is refused"
  )
  run Testing.expect(
    invalidKey(b"RWQ") && invalidKey(content()),
    "malformed public keys are refused"
  )
}

test effect fn minisignReadsTheReleaseKeyAndSignature() -> ()
  ! AssertionError<'static> {
  // A real release signature names the release key, so only the content check fails.
  run Testing.expect(
    outcome(realKey(), realSignature(), content(), MinisignError.InvalidSignature),
    "the published release key and signature parse, and other content does not verify"
  )
  run Testing.expect(
    outcome(testKey(), realSignature(), content(), MinisignError.WrongKey),
    "a release signature is refused for another key"
  )
}

fn testKey() -> &'static [u8] {
  return b"RWQBAgMEBQYHCPQgLHau3EuG5rWxdpetNMveATB6VO+Qzqd7MYbQEu4H"
}

fn realKey() -> &'static [u8] {
  return b"RWQefAo9Dbb8LrlLPaqWdRNlX5th2l7r+4WYhxRNbe5K5URDUht1XUDs"
}

fn content() -> &'static [u8] {
  return b"silk toolchain archive bytes\x0asilk toolchain archive bytes\x0asilk toolchain archive bytes\x0a"
}

fn prehashed() -> &'static [u8] {
  return b"untrusted comment: signature from minisign secret key\x0aRUQBAgMEBQYHCHizSZlg83zny+V88L0I3Wy/GLLi2Isz/IfdlGCRGLV+UjQ+HondusBdw2xZUePYwMoJZWX7O/+4WmVxeZyw5gA=\x0atrusted comment: timestamp:1700000000\x09file:archive.tar.gz\x0amFBEvOVNRWJM9ZL3xxRlL7tLVdoWNp3+GhAklCPQRjU+styPoZMr4m+cCXROaEI+ZtYagY2tHG+L+D9V0b1dAQ==\x0a"
}

fn legacy() -> &'static [u8] {
  return b"untrusted comment: signature from minisign secret key\x0aRWQBAgMEBQYHCDfSpD5qoCyBcf0GjIGQWyI5PRjg6UjBh+trqkTBxGGxpss/SATsUHb5a3Nl43DPuvms+/kSwidwRC2FGnOnMQ0=\x0atrusted comment: timestamp:1700000000\x09file:archive.tar.gz\x0agcPm9GPz8n934kcWMQ85gaYOJKdVB1YSvQYH8tWBeRqHVrDCbPvdW3KRzmy+faC57A2jJz1OGvxnFvf1QGamDA==\x0a"
}

fn otherKeyId() -> &'static [u8] {
  return b"untrusted comment: signature from minisign secret key\x0aRUQAAAAAAAAAAHizSZlg83zny+V88L0I3Wy/GLLi2Isz/IfdlGCRGLV+UjQ+HondusBdw2xZUePYwMoJZWX7O/+4WmVxeZyw5gA=\x0atrusted comment: timestamp:1700000000\x09file:archive.tar.gz\x0amFBEvOVNRWJM9ZL3xxRlL7tLVdoWNp3+GhAklCPQRjU+styPoZMr4m+cCXROaEI+ZtYagY2tHG+L+D9V0b1dAQ==\x0a"
}

fn tamperedComment() -> &'static [u8] {
  return b"untrusted comment: signature from minisign secret key\x0aRUQBAgMEBQYHCHizSZlg83zny+V88L0I3Wy/GLLi2Isz/IfdlGCRGLV+UjQ+HondusBdw2xZUePYwMoJZWX7O/+4WmVxeZyw5gA=\x0atrusted comment: timestamp:1700000000\x09file:other.tar.gz\x0amFBEvOVNRWJM9ZL3xxRlL7tLVdoWNp3+GhAklCPQRjU+styPoZMr4m+cCXROaEI+ZtYagY2tHG+L+D9V0b1dAQ==\x0a"
