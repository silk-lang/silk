//! Toolchain versions compare and match by SemVer, installed toolchains list newest first, and a
//! command's version comes from `+<version>`, `SILK_TOOLCHAIN`, the project's pin and the default,
//! in that order. A pin this tool cannot read is an error, never a guess.

import Command as Commands { Context }
import Toolchains as Toolchains { Origin, PinTarget, Selection, UnknownPin }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.system.filesystem_native { OsFileSystem }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.testing.testing { AssertionError, Testing }
import silk.num.usize

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn contains(text: &[u8], part: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at + part.length <= text.length {
    if same(Slice.view<u8>(text, at, part.length), part) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

fn temporaryRoot() -> string<'static> {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    return "/private/tmp"
  } else {
    return "/tmp"
  }
}

test effect fn toolchainVersionsCompareAndMatch() -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    Toolchains.compare(b"0.1.0-dev.10+aaaa", b"0.1.0-dev.9+bbbb") > 0
      && Toolchains.compare(b"0.1.0", b"0.1.0-dev.9") > 0
      && Toolchains.compare(b"0.2.0-dev.1", b"0.1.0") > 0
      && Toolchains.compare(b"1.0.0+x", b"1.0.0+y") == 0
      && Toolchains.compare(b"0.1.0-alpha", b"0.1.0-alpha.1") < 0
      && Toolchains.compare(b"0.1.0-1", b"0.1.0-alpha") < 0,
    "versions order by SemVer precedence, ignoring build metadata"
  )
  run Testing.expect(
    Toolchains.matches(b"0.1.0-dev.6", b"0.1.0-dev.6+1aed5da1a342")
      && Toolchains.matches(b"0.1.0-dev.6+1aed5da1a342", b"0.1.0-dev.6+1aed5da1a342")
      && !Toolchains.matches(b"0.1.0-dev.6+ffff", b"0.1.0-dev.6+1aed5da1a342")
      && !Toolchains.matches(b"0.1.0-dev.6", b"0.1.0-dev.60+aa"),
    "a pin without build metadata names the release with any; a full pin names only itself"
  )
  run Testing.expect(
    Toolchains.unpinned(b"0.0.0") && Toolchains.unpinned(b"0.0.0+local")
      && !Toolchains.unpinned(b"0.0.1"),
    "0.0.0 pins nothing"
  )
}

effect fn write(root: &Path, relative: string, text: &[u8]) -> ()
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let path = run Path.join(root, relative)
  run FileSystem.writeFileWithParents(&path, text)
}

effect fn selected(
  start: &Path,
  requested: Option<&[u8]>,
  environment: Option<&[u8]>,
  home: &Path,
  version: &[u8],
  origin: Origin
) -> bool
  ! UnknownPin | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let selection = run Toolchains.select(start, move requested, move environment, Option<&Path>.some(home))
  return same(Bytes.asSlice(&selection.version), version) && selection.origin == origin
}

effect fn whichStatus(working: &Path, home: &Path) -> i32
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let context = Context {
    working: run Path.fromBytes(Path.rawBytes(working)),
    home: Option<Path>.some(run Path.fromBytes(Path.rawBytes(home))),
    environment: Option<Bytes>.none(),
    target: b"test-target",
    releaseKey: b"",
    release: b"0.0.0",
    bundled: Option<Path>.none(),
  }
  let arguments = List<Bytes>.make()
  let mut words = move arguments
  run List<Bytes>.append(&mut words, run Bytes.copy(b"which"))
  let ran = run Commands.execute(&context, List<Bytes>.asSlice(&words))
  return ran.status
}

effect fn selections(root: &Path) -> ()
  ! AssertionError<'static> | UnknownPin | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let home = run Path.join(root, "home")
  run write(&home, "toolchains/0.1.0-dev.4+892d3bee6c53/bin/silk", b"")
  run write(&home, "toolchains/0.1.0-dev.10+aaaaaaaaaaaa/bin/silkc", b"")
  run write(&home, "toolchains/0.1.0-dev.6+1aed5da1a342/bin/silk", b"")
  run write(&home, "toolchains/.0.1.0-dev.7+partial/bin/silk", b"")
  run write(&home, "toolchains/0.1.0-dev.8+nobinary/lib/silk/stdlib/silk/option.silk", b"")
  let names = run Toolchains.installed(&home)
  let listed = List<Bytes>.asSlice(&names)
  run Testing.expect(
    listed.length == 3 && same(Bytes.asSlice(&listed[0]), b"0.1.0-dev.10+aaaaaaaaaaaa")
      && same(Bytes.asSlice(&listed[1]), b"0.1.0-dev.6+1aed5da1a342")
      && same(Bytes.asSlice(&listed[2]), b"0.1.0-dev.4+892d3bee6c53"),
    "installed toolchains list newest first, whether their compiler is bin/silkc or the earlier bin/silk, skipping partial installs and directories without a compiler"
  )
  let found = match move run Toolchains.find(&home, b"0.1.0-dev.6") {
    Option<Bytes>.Some { value } => same(Bytes.asSlice(&value), b"0.1.0-dev.6+1aed5da1a342")
    Option<Bytes>.None => false
  }
  let absent = match move run Toolchains.find(&home, b"0.1.0-dev.5") {
    Option<Bytes>.Some { value } => false
    Option<Bytes>.None => true
  }
  run Testing.expect(found && absent, "a pin finds the installed release it names, and only that")

  run write(
    root,
    "app/silk.toml",
    b"[package]\nname = \"app\"\nversion = \"0.1.0\"\nsilk-version = \"0.1.0-dev.4\"\nsource = \".\"\n"
  )
  run write(root, "app/src/nested/keep", b"")
  run write(
    root,
    "workspace/silk.toml",
    b"[workspace]\nmembers = [\"member\", \"other\"]\nsilk-version = \"0.1.0-dev.6+1aed5da1a342\"\n",
  )
  run write(
    root,
    "workspace/member/silk.toml",
    b"[package]\nname = \"member\"\nversion = \"0.1.0\"\nsilk-version = \"0.1.0-dev.4\"\nsource = \".\"\n"
  )
  run write(root, "plain/silk.toml", b"[workspace]\nmembers = [\"inner\"]\n")
  run write(
    root,
    "plain/inner/silk.toml",
    b"[package]\nname = \"inner\"\nversion = \"0.1.0\"\nsilk-version = \"0.1.0-dev.4\"\nsource = \".\"\n"
  )
  run write(
    root,
    "workspace/other/silk.toml",
    b"[package]\nname = \"other\"\nversion = \"0.1.0\"\nsilk-version = \"0.0.0\"\nsource = \".\"\n"
  )
  run write(
    root,
    "workspace/loose/silk.toml",
    b"[package]\nname = \"loose\"\nversion = \"0.1.0\"\nsilk-version = \"0.1.0-dev.4\"\nsource = \".\"\n"
  )
  run write(
    root,
    "unpinned/silk.toml",
    b"[package]\nname = \"unpinned\"\nversion = \"0.1.0\"\nsilk-version = \"0.0.0\"\nsource = \".\"\n"
  )
  let app = run Path.join(root, "app/src/nested")
  let member = run Path.join(root, "workspace/member")
  let loose = run Path.join(root, "workspace/loose")
  let unpinned = run Path.join(root, "unpinned")
  run Testing.expect(
    run selected(
      &app,
      Option<&[u8]>.none(),
      Option<&[u8]>.none(),
      &home,
      b"0.1.0-dev.4",
      Origin.Package
    ),
    "the nearest manifest's package pin applies below it"
  )
  run Testing.expect(
    run selected(
      &member,
      Option<&[u8]>.none(),
      Option<&[u8]>.none(),
      &home,
      b"0.1.0-dev.6+1aed5da1a342",
      Origin.Workspace
    ),
    "a workspace pin wins over its member's own pin"
  )
  run Testing.expect(
    run selected(
      &loose,
      Option<&[u8]>.none(),
      Option<&[u8]>.none(),
      &home,
      b"0.1.0-dev.4",
      Origin.Package
    ),
    "a workspace pin does not cover a package it does not list"
  )
  run Testing.expect(
    run selected(
      &unpinned,
      Option<&[u8]>.none(),
      Option<&[u8]>.none(),
      &home,
      b"",
      Origin.Nothing
    ),
    "a 0.0.0 pin and no default select nothing"
  )
  let plain = run Path.join(root, "plain")
  run Testing.expect(
    run selected(
      &plain,
      Option<&[u8]>.none(),
      Option<&[u8]>.none(),
      &home,
      b"0.1.0-dev.4",
      Origin.Members
    ),
    "a workspace root that pins nothing runs the version its members pin"
  )
  run write(root, "mixed/silk.toml", b"[workspace]\nmembers = [\"one\", \"two\", \"free\"]\n")
  run write(
    root,
    "mixed/one/silk.toml",
    b"[package]\nname = \"one\"\nversion = \"0.1.0\"\nsilk-version = \"0.1.0-dev.4\"\nmain = \"main.silk\"\n"
  )
  run write(
    root,
    "mixed/two/silk.toml",
    b"[package]\nname = \"two\"\nversion = \"0.1.0\"\nsilk-version = \"0.1.0-dev.6\"\nmain = \"main.silk\"\n"
  )
  run write(root, "mixed/free/silk.toml", b"[package]\nname = \"free\"\nversion = \"0.1.0\"\nmain = \"main.silk\"\n")
  let mixed = run Path.join(root, "mixed")
  let disagreement = run Effect.result(Toolchains.select(&mixed, Option<&[u8]>.none(), Option<&[u8]>.none(), Option<&Path>.some(&home)))
  let mixedRefused = match move disagreement {
    Result<Selection, UnknownPin | FileError | OutOfMemoryError>.Failure { error } => match move error {
      UnknownPin unknown => contains(Bytes.asSlice(&unknown.detail), b"members pin different ones: 0.1.0-dev.4 in ")
        && contains(Bytes.asSlice(&unknown.detail), b", 0.1.0-dev.6 in ")
        && contains(unknown.hint, b"silk set <version>")
      FileError failed => false
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
    Result<Selection, UnknownPin | FileError | OutOfMemoryError>.Success { value } => false
  }
  let one = run Path.join(root, "mixed/one")
  run Testing.expect(
    mixedRefused && run selected(&one, Option<&[u8]>.none(), Option<&[u8]>.none(), &home, b"0.1.0-dev.4", Origin.Package),
    "members that pin different versions stop a command at the workspace root, and each member still runs its own"
  )
  let environment = run selected(
    &app,
    Option<&[u8]>.none(),
    Option<&[u8]>.some(b"0.1.0-dev.10"),
    &home,
    b"0.1.0-dev.10",
    Origin.Environment
  )
  let commandLine = run selected(
    &app,
    Option<&[u8]>.some(b"0.1.0-dev.6"),
    Option<&[u8]>.some(b"0.1.0-dev.10"),
    &home,
    b"0.1.0-dev.6",
    Origin.CommandLine
  )
  run Testing.expect(
    environment && commandLine,
    "SILK_TOOLCHAIN overrides the pin, and +<version> overrides both"
  )
  run Toolchains.setDefault(&home, b"0.1.0-dev.10")
  let outside = run selected(
    &unpinned,
    Option<&[u8]>.none(),
    Option<&[u8]>.none(),
    &home,
    b"0.1.0-dev.10",
    Origin.Default
  )
  let inside = run selected(
    &app,
    Option<&[u8]>.none(),
    Option<&[u8]>.none(),
    &home,
    b"0.1.0-dev.4",
    Origin.Package
  )
  run Testing.expect(outside && inside, "the default applies outside pinned projects only")
  let installedStatus = run whichStatus(&app, &home)
  run Testing.expect(
    installedStatus == 0,
    "`which` succeeds when the pinned toolchain is installed"
  )
  run write(
    root,
    "missing/silk.toml",
    b"[package]\nname = \"missing\"\nversion = \"0.1.0\"\nsilk-version = \"0.1.0-dev.5\"\nsource = \".\"\n"
  )
  let missing = run Path.join(root, "missing")
  let missingStatus = run whichStatus(&missing, &home)
  run Testing.expect(
    missingStatus == Commands.NOT_INSTALLED,
    "`which` exits 3 when the pinned toolchain is missing"
  )
  let memberTarget = match move run Toolchains.pinTarget(&loose) {
    Option<PinTarget>.Some { value } => same(value.table, b"package")
    Option<PinTarget>.None => false
  }
  let workspaceTarget = match move run Toolchains.pinTarget(&member) {
    Option<PinTarget>.Some { value } => same(value.table, b"workspace")
      && match &value.previous {
        Option<Bytes>.Some { value: previous } => same(Bytes.asSlice(&previous), b"0.1.0-dev.6+1aed5da1a342")
        Option<Bytes>.None => false
      }
    Option<PinTarget>.None => false
  }
  let packageTarget = match move run Toolchains.pinTarget(&app) {
    Option<PinTarget>.Some { value } => same(value.table, b"package")
    Option<PinTarget>.None => false
  }
  run Testing.expect(
    memberTarget && workspaceTarget && packageTarget,
    "`set` pins the workspace that lists a package, and a package outside one pins itself"
  )
  let inner = run Path.join(root, "plain/inner")
  let innerTarget = match move run Toolchains.pinTarget(&inner) {
    Option<PinTarget>.Some { value } => same(value.table, b"workspace")
      && match &value.previous {
        Option<Bytes>.Some { value: previous } => same(Bytes.asSlice(&previous), b"0.1.0-dev.4")
        Option<Bytes>.None => false
      }
    Option<PinTarget>.None => false
  }
  run Testing.expect(innerTarget, "`set` in a pinned member of an unpinned workspace pins the workspace")
  let workspaceManifest = run Path.join(root, "workspace/silk.toml")
  let memberManifest = run Path.join(root, "workspace/member/silk.toml")
  let pins = run Toolchains.memberPins(&workspaceManifest)
  let pinned = List<Path>.asSlice(&pins)
  run Testing.expect(
    pinned.length == usize.ONE && same(Path.rawBytes(&pinned[usize.ZERO]), Path.rawBytes(&memberManifest)),
    "the members a workspace pin moves are those that pin a version of their own"
  )
  run write(
    root,
    "future/silk.toml",
    b"[package]\nname = \"future\"\nversion = \"0.1.0\"\nsilk-version = \"^0.2\"\nsource = \".\"\n"
  )
  let future = run Path.join(root, "future")
  let refused = match move run Effect.result(Toolchains.pinned(&future)) {
    Result<Option<Selection>, UnknownPin | FileError | OutOfMemoryError>.Success { value } => false
    Result<Option<Selection>, UnknownPin | FileError | OutOfMemoryError>.Failure { error } => match move error {
      UnknownPin unknown => same(Bytes.asSlice(&unknown.detail), b"[package].silk-version = \"^0.2\" is not a version this tool understands")
      FileError failed => {
        fail move failed
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let futureStatus = run whichStatus(&future, &home)
  run Testing.expect(refused && futureStatus == 2, "a pin this tool cannot read is a configuration error")
}

effect fn isolatedSelections() -> ()
  ! AssertionError<'static> | FileError | OutOfMemoryError
  ? &mut Allocator {
  let mut files = run OsFileSystem.make(temporaryRoot())
  let parent = run Path.root()
  let root = run FileSystem.createTemporaryDirectory(&parent, b"silk-toolchains-")
    |> Effect.provideMut<FileSystem>(&mut files)
  let attempted = run Effect.result(selections(&root)) |> Effect.provideMut<FileSystem>(&mut files)
  let cleaned = run Effect.result(FileSystem.removeDirectoryRecursively(&root))
    |> Effect.provideMut<FileSystem>(&mut files)
  drop cleaned
  match move attempted {
    Result<(), AssertionError<'static> | UnknownPin | FileError | OutOfMemoryError>.Success { value } => {}
    Result<(), AssertionError<'static> | UnknownPin | FileError | OutOfMemoryError>.Failure { error } => match move error {
      UnknownPin unknown => {
        drop unknown
        run Testing.expect(false, "every pin in the fixtures is readable")
      }
      AssertionError<'static> failed => {
        fail move failed
      }
      FileError failed => {
        fail move failed
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

test effect fn toolchainSelectionFollowsItsOrder() -> ()
  ! AssertionError<'static> | FileError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run isolatedSelections() |> Effect.provideMut<Allocator>(&mut allocator)
}
