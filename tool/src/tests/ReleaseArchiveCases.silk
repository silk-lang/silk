//! Release archives read their files and directories in order and refuse links, unsafe or
//! unusual paths, repeated paths, corrupt headers, and truncated archives.

import ReleaseArchive as ReleaseArchive {ArchiveError, ArchiveMember, ArchiveReader}
import silk.collections.bytes {Bytes}
import silk.collections.slice {Slice}
import silk.compress.deflate {EncodeError, Encoder, Options}
import silk.compress.inflate {Format}
import silk.compress.tar {TarError}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.core.result {Result}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.testing.testing {AssertionError, Testing}
import silk.num.u8
import silk.num.usize

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// Builds archives the way `ReleaseArchive.ts` writes them, into a fixed buffer.
struct Builder {
  bytes: [u8; 4096],
  length: usize,
}

fn builder() -> Builder {
  return Builder { bytes: [0; 4096], length: usize.ZERO }
}

fn put(target: &mut Builder, at: usize, text: &[u8]) -> () {
  let mut index = usize.ZERO
  while index < text.length {
    target.bytes[target.length + at + index] = text[index]
    index = index + usize.ONE
  }
}

fn putOctal(target: &mut Builder, at: usize, width: usize, value: usize) -> () {
  let mut remaining = value
  let mut index = width - usize.add(0, 2)
  let mut more = true
  while more {
    target.bytes[target.length + at + index] = usize.toU8(remaining % usize.add(0, 8)) + 48
    remaining = remaining / usize.add(0, 8)
    if index == usize.ZERO {
      more = false
    } else {
      index = index - usize.ONE
    }
  }
}

// Appends one member: `kind` is the ustar type byte, and `content` follows, padded to 512 bytes.
fn member(
  target: &mut Builder,
  prefix: &[u8],
  name: &[u8],
  kind: u8,
  mode: usize,
  content: &[u8]
) -> () {
  put(&mut target.*, usize.ZERO, name)
  putOctal(&mut target.*, usize.add(0, 100), usize.add(0, 8), mode)
  putOctal(&mut target.*, usize.add(0, 108), usize.add(0, 8), usize.ZERO)
  putOctal(&mut target.*, usize.add(0, 116), usize.add(0, 8), usize.ZERO)
  putOctal(&mut target.*, usize.add(0, 124), usize.add(0, 12), content.length)
  putOctal(&mut target.*, usize.add(0, 136), usize.add(0, 12), usize.ZERO)
  put(&mut target.*, usize.add(0, 148), b"        ")
  target.bytes[target.length + usize.add(0, 156)] = kind
  put(&mut target.*, usize.add(0, 257), b"ustar\x0000")
  put(&mut target.*, usize.add(0, 345), prefix)
  let mut sum = usize.ZERO
  let mut at = usize.ZERO
  while at < 512 {
    sum = sum + u8.toUsize(target.bytes[target.length + at])
    at = at + usize.ONE
  }
  putOctal(&mut target.*, usize.add(0, 148), usize.add(0, 7), sum)
  target.bytes[target.length + usize.add(0, 154)] = 0
  target.length = target.length + usize.add(0, 512)
  put(&mut target.*, usize.ZERO, content)
  target.length = target.length
    + (content.length + usize.add(0, 511)) / usize.add(0, 512) * usize.add(0, 512)
}

// Appends the two zero blocks that end an archive.
fn end(target: &mut Builder) -> () {
  target.length = target.length + usize.add(0, 1024)
}

fn release() -> Builder {
  let mut archive = builder()
  member(&mut archive, b"", b"silk-1/", 53, usize.add(0, 493), b"")
  // A long directory path goes entirely in the prefix, leaving the name empty.
  member(&mut archive, b"silk-1/lib", b"", 53, usize.add(0, 493), b"")
  member(&mut archive, b"", b"silk-1/bin/silk", 48, usize.add(0, 493), b"compiler")
  member(
    &mut archive,
    b"silk-1/lib/silk/stdlib",
    b"silk/core/option.silk",
    48,
    usize.add(0, 420),
    b"pub enum Option {}\n"
  )
  end(&mut archive)
  return move archive
}

fn bytesOf(archive: &Builder) -> &[u8] {
  return Slice.view<u8>(&archive.bytes, usize.ZERO, archive.length)
}

// The gzip stream of `tar`, as a release `.tar.gz` holds it.
effect fn gzipped(tar: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut output = run Bytes.zeroed(tar.length * 2 + usize.add(0, 64))
  let encoded = run Effect.result(Encoder.encode(tar, Bytes.asMutSlice(&mut output), Format.Gzip, Options.make(6)))
  let written = match move encoded {
    Result<usize, OutOfMemoryError | EncodeError>.Success {value} => value
    Result<usize, OutOfMemoryError | EncodeError>.Failure {error} => match move error {
      OutOfMemoryError exhausted => { fail move exhausted }
      EncodeError _impossible => { fail OutOfMemoryError {} }
    }
  }
  Bytes.truncate(&mut output, written)
  return move output
}

// The members of the tar release `archive`, compressed as a release is, in order, or the error
// that stops reading it.
effect fn members(archive: &[u8]) -> Result<Bytes, ArchiveError> ! OutOfMemoryError ? &mut Allocator {
  let compressed = run gzipped(archive)
  let mut reader = match move run ReleaseArchive.reader(Bytes.asSlice(&compressed), false) {
    Result.Success {value} => move value
    Result.Failure {error} => { return Result<Bytes, ArchiveError>.failResult(move error) }
  }
  let mut listing = Bytes.make()
  while true {
    let next = match move run Effect.result(ArchiveReader.next(&mut reader)) {
      Result<Option<ArchiveMember>, ArchiveError | OutOfMemoryError>.Success {value} => move value
      Result<Option<ArchiveMember>, ArchiveError | OutOfMemoryError>.Failure {error} => match move error {
        ArchiveError invalid => { return Result<Bytes, ArchiveError>.failResult(move invalid) }
        OutOfMemoryError exhausted => { fail move exhausted }
      }
    }
    let found = match move next {
      Option<ArchiveMember>.Some {value} => move value
      Option<ArchiveMember>.None => { return Result<Bytes, ArchiveError>.succeed(move listing) }
    }
    run Bytes.append(&mut listing, if found.directory { b"d" } else if found.executable { b"x" } else { b"f" })
    run Bytes.append(&mut listing, b" ")
    run Bytes.append(&mut listing, Bytes.asSlice(&found.name))
    run Bytes.append(&mut listing, b"=")
    run Bytes.append(&mut listing, Bytes.asSlice(&found.content))
    run Bytes.append(&mut listing, b";")
  }
  return Result<Bytes, ArchiveError>.succeed(move listing)
}

// A number for each refusal reason, so tests can compare them.
fn reason(error: ArchiveError) -> i32 {
  return match move error {
    ArchiveError.Gzip => 10
    ArchiveError.Tar {error: invalid} => match invalid { TarError.Truncated => 1 TarError.BadHeader => 2 TarError.UnsafePath => 3 TarError.PathTooLong => 8 TarError.InvalidUse => 9 }
    ArchiveError.Zip {..} => 4
    ArchiveError.Duplicate => 5
    ArchiveError.UnsupportedMember => 6
    ArchiveError.UnsafePath => 7
  }
}

effect fn refusedWith(archive: &[u8], expected: i32) -> bool ! OutOfMemoryError ? &mut Allocator {
  return match move run members(archive) {
    Result<Bytes, ArchiveError>.Success {..} => false
    Result<Bytes, ArchiveError>.Failure {error} => reason(move error) == expected
  }
}

effect fn readsTarRelease() -> () ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  let archive = release()
  let read = match move run members(bytesOf(&archive)) {
    Result<Bytes, ArchiveError>.Success {value} => same(Bytes.asSlice(&value),
      b"d silk-1=;d silk-1/lib=;x silk-1/bin/silk=compiler;f silk-1/lib/silk/stdlib/silk/core/option.silk=pub enum Option {}\n;")
    Result<Bytes, ArchiveError>.Failure {..} => false
  }
  run Testing.expect(read, "directories, executable files, and prefixed names, including a directory held only in the prefix, read in archive order")
}

effect fn refusesTarReleases() -> () ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  let mut climbing = builder()
  member(&mut climbing, b"", b"silk-1/../../escape", 48, usize.add(0, 420), b"x")
  end(&mut climbing)
  let mut prefixed = builder()
  member(&mut prefixed, b"silk-1/..", b"escape", 48, usize.add(0, 420), b"x")
  end(&mut prefixed)
  let climbed = run refusedWith(bytesOf(&climbing), 3)
  let prefixedClimbed = run refusedWith(bytesOf(&prefixed), 3)
  run Testing.expect(climbed && prefixedClimbed, "`..` components in the name or prefix are refused")
  let mut dotted = builder()
  member(&mut dotted, b"", b"silk-1/./file", 48, usize.add(0, 420), b"x")
  end(&mut dotted)
  run Testing.expect(run refusedWith(bytesOf(&dotted), 7), "a `.` component, which would hide a repeated path, is refused")
  let mut linked = builder()
  member(&mut linked, b"", b"silk-1/link", 50, usize.add(0, 511), b"")
  end(&mut linked)
  run Testing.expect(run refusedWith(bytesOf(&linked), 6), "symbolic links are refused")
  let mut corrupt = release()
  corrupt.bytes[3] = u8.bitXor(corrupt.bytes[3], 1)
  run Testing.expect(run refusedWith(bytesOf(&corrupt), 2), "a header whose checksum does not match is refused")
  let whole = release()
  run Testing.expect(run refusedWith(Slice.view<u8>(&whole.bytes, usize.ZERO, usize.add(0, 700)), 1),
    "an archive that ends inside a header is refused")
}

test effect fn releaseReadsTarMembers() -> () ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run readsTarRelease() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn releaseRefusesUnsafeTarArchives() -> () ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run refusesTarReleases() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Independent Node zlib raw-DEFLATE output and ZIP APPNOTE headers for "hello".
fn zipHello() -> &'static [u8] { return b"\x50\x4b\x03\x04\x14\x00\x00\x08\x08\x00\x00\x00\x00\x00\x86\xa6\x10\x36\x07\x00\x00\x00\x05\x00\x00\x00\x0d\x00\x00\x00\x72\x65\x6c\x65\x61\x73\x65\x2f\x68\x65\x6c\x6c\x6f\xcb\x48\xcd\xc9\xc9\x07\x00\x50\x4b\x01\x02\x14\x00\x14\x00\x00\x08\x08\x00\x00\x00\x00\x00\x86\xa6\x10\x36\x07\x00\x00\x00\x05\x00\x00\x00\x0d\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x72\x65\x6c\x65\x61\x73\x65\x2f\x68\x65\x6c\x6c\x6f\x50\x4b\x05\x06\x00\x00\x00\x00\x01\x00\x01\x00\x3b\x00\x00\x00\x32\x00\x00\x00\x00\x00" }

effect fn duplicateMember() -> bool ! ArchiveError | OutOfMemoryError ? &mut Allocator {
  let mut archive = builder()
  member(&mut archive, b"", b"release/file", 48, 420, b"first")
  member(&mut archive, b"", b"release/file", 48, 420, b"second")
  end(&mut archive)
  let compressed = run gzipped(bytesOf(&archive))
  let mut reader = match move run ReleaseArchive.reader(Bytes.asSlice(&compressed), false) {
    Result.Success {value} => move value
    Result.Failure {error} => { fail move error }
  }
  let first = run ArchiveReader.next(&mut reader)
  drop first
  return match move run Effect.result(ArchiveReader.next(&mut reader)) {
    Result<Option<ArchiveMember>, ArchiveError | OutOfMemoryError>.Success {..} => false
    Result<Option<ArchiveMember>, ArchiveError | OutOfMemoryError>.Failure {error} => match move error {
      ArchiveError invalid => match move invalid { ArchiveError.Duplicate => true _ => false }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

test effect fn releaseRefusesDuplicateMembers() -> () ! AssertionError<'static> | ArchiveError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let refused = run duplicateMember() |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(refused, "release extraction refuses repeated paths before overwriting an earlier member")
}

// The first member of the Windows release ZIP `archive`, or none when it is refused or empty.
effect fn firstZipMember(archive: &[u8]) -> Option<ArchiveMember> ! OutOfMemoryError ? &mut Allocator {
  let mut reader = match move run ReleaseArchive.reader(archive, true) {
    Result.Success {value} => move value
    Result.Failure {..} => { return Option<ArchiveMember>.none() }
  }
  return match move run Effect.result(ArchiveReader.next(&mut reader)) {
    Result<Option<ArchiveMember>, ArchiveError | OutOfMemoryError>.Success {value} => move value
    Result<Option<ArchiveMember>, ArchiveError | OutOfMemoryError>.Failure {error} => match move error {
      ArchiveError _invalid => Option<ArchiveMember>.none()
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

effect fn readsZipRelease() -> () ! AssertionError<'static> | OutOfMemoryError ? &mut Allocator {
  let read = match move run firstZipMember(zipHello()) {
    Option<ArchiveMember>.Some {value} => same(Bytes.asSlice(&value.name), b"release/hello") && !value.directory
      && same(Bytes.asSlice(&value.content), b"hello")
    Option<ArchiveMember>.None => false
  }
  run Testing.expect(read, "a Windows release ZIP decodes its DEFLATE member and path")
  let mut changed: [u8; 131] = [0; 131]
  let mut at: usize = 0
  while at < changed.length {
    changed[at] = zipHello()[at]
    at = at + 1
  }
  // The stored CRC-32 no longer matches the data.
  changed[66] = 0
  run Testing.expect(Option<ArchiveMember>.isNone(&run firstZipMember(&changed)), "a release ZIP member whose CRC-32 does not match is refused")
}

test effect fn releaseReadsWindowsZip() -> () ! AssertionError<'static> | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run readsZipRelease() |> Effect.provideMut<Allocator>(&mut allocator)
}
