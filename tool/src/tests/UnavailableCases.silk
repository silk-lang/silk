//! The language server silk serves when no compiler can: `initialize` gets no capabilities, the
//! reason shows as an error, and the protocol is followed until `exit`.

import Unavailable
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.json.scanner { JsonError }
import silk.collections.slice { Slice }
import silk.io.standard_input { ReadOutcome, StandardInput, StreamReadError }
import silk.testing.testing { AssertionError, Testing }
import silk.num.usize
import silk.io.writer { Writer, WriterError }

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + 1
  }
  return true
}

// Collects what the server writes, up to a fixed capacity.
struct Captured {
  bytes: Bytes,
  length: usize,
}

impl Captured {
  effect fn writeAll(self: &mut Self, bytes: &[u8]) -> ()
    ! WriterError {
    if bytes.length > Bytes.length(&self.bytes) - self.length {
      fail Writer.failure()
    }
    let target = Bytes.asMutSlice(&mut self.bytes)
    let mut at = usize.ZERO
    while at < bytes.length {
      target[self.length + at] = bytes[at]
      at = at + 1
    }
    self.length = self.length + bytes.length
    return ()
  }

  effect fn flush(self: &mut Self) -> ()
    ! WriterError {
    return ()
  }
}

impl Writer for Captured {
  writeAll: Captured.writeAll

  flush: Captured.flush
}

// Standard input that hands out `bytes` seven bytes at a time, so frames arrive split.
struct Scripted {
  bytes: &'static [u8],
  at: usize,
}

impl Scripted {
  effect fn read(self: &mut Self, buffer: &mut [u8]) -> ReadOutcome
    ! StreamReadError {
    if self.at == self.bytes.length {
      return StandardInput.endOfInput()
    }
    let mut count = self.bytes.length - self.at
    if count > 7 {
      count = 7
    }
    if count > buffer.length {
      count = buffer.length
    }
    let mut copied = usize.ZERO
    while copied < count {
      buffer[copied] = self.bytes[self.at + copied]
      copied = copied + 1
    }
    self.at = self.at + count
    return StandardInput.filled(count)
  }
}

impl StandardInput for Scripted {
  read: Scripted.read
}

fn contains(text: &[u8], part: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at + part.length <= text.length {
    if same(Slice.view<u8>(text, at, part.length), part) {
      return true
    }
    at = at + 1
  }
  return false
}

test effect fn unavailableServerExplainsItself() -> ()
  ! AssertionError<'static> | JsonError | WriterError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut input = Scripted {
    bytes: b"Content-Length: 46\r\n\r\n{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\"}Content-Length: 54\r\n\r\n{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/hover\"}Content-Length: 44\r\n\r\n{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"shutdown\"}Content-Length: 33\r\n\r\n{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}",
    at: usize.ZERO
  }
  let mut output = Captured {
    bytes: run Bytes.zeroed(1024) |> Effect.provideMut<Allocator>(&mut allocator),
    length: usize.ZERO
  }
  let status = run Unavailable.serve(b"Silk 9.9.9 is not installed")
    |> Effect.provideMut<StandardInput>(&mut input)
    |> Effect.provideMut<Writer>(&mut output)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let written = Slice.view<u8>(Bytes.asSlice(&output.bytes), usize.ZERO, output.length)
  run Testing.expect(status == 0, "shutdown then exit is status 0")
  run Testing.expect(
    contains(written, b"{\"jsonrpc\":\"2.0\",\"id\":1,\"result\":{\"capabilities\":{},"),
    "initialize gets no capabilities"
  )
  run Testing.expect(
    contains(
      written,
      b"{\"jsonrpc\":\"2.0\",\"method\":\"window/showMessage\",\"params\":{\"type\":1,\"message\":\"Silk 9.9.9 is not installed\"}}"
    ),
    "the reason is shown as an error"
  )
  run Testing.expect(
    contains(written, b"{\"jsonrpc\":\"2.0\",\"id\":2,\"error\":{\"code\":-32601,"),
    "other requests are not found"
  )
  run Testing.expect(
    contains(written, b"{\"jsonrpc\":\"2.0\",\"id\":3,\"result\":null}"),
    "shutdown answers null"
  )
}
