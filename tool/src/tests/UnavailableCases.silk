//! Failed LSP startup is an initialization error, with the reason preserved and no successful
//! result or notification. Subsequent requests remain uninitialized until the client exits.

import Unavailable
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.json.scanner { JsonError }
import silk.json.value { Json, Value }
import silk.core.option { Option }
import silk.collections.slice { Slice }
import silk.io.standard_input { ReadOutcome, StandardInput, StreamReadError }
import silk.testing.testing { AssertionError, Testing }
import silk.num.usize
import silk.num.u8
import silk.io.writer { Writer, WriterError }

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + 1
  }
  return true
}

// Collects what the server writes, up to a fixed capacity.
struct Captured {
  bytes: Bytes,
  length: usize,
}

impl Captured {
  effect fn writeAll(self: &mut Self, bytes: &[u8]) -> ()
    ! WriterError {
    if bytes.length > Bytes.length(&self.bytes) - self.length {
      fail Writer.failure()
    }
    let target = Bytes.asMutSlice(&mut self.bytes)
    let mut at = usize.ZERO
    while at < bytes.length {
      target[self.length + at] = bytes[at]
      at = at + 1
    }
    self.length = self.length + bytes.length
    return ()
  }

  effect fn flush(self: &mut Self) -> ()
    ! WriterError {
    return ()
  }
}

impl Writer for Captured {
  writeAll: Captured.writeAll

  flush: Captured.flush
}

// Standard input that hands out `bytes` seven bytes at a time, so frames arrive split.
struct Scripted {
  bytes: &'static [u8],
  at: usize,
}

impl Scripted {
  effect fn read(self: &mut Self, buffer: &mut [u8]) -> ReadOutcome
    ! StreamReadError {
    if self.at == self.bytes.length {
      return StandardInput.endOfInput()
    }
    let mut count = self.bytes.length - self.at
    if count > 7 {
      count = 7
    }
    if count > buffer.length {
      count = buffer.length
    }
    let mut copied = usize.ZERO
    while copied < count {
      buffer[copied] = self.bytes[self.at + copied]
      copied = copied + 1
    }
    self.at = self.at + count
    return StandardInput.filled(count)
  }
}

impl StandardInput for Scripted {
  read: Scripted.read
}

// Decode using the emitted Content-Length, so truncated or misframed output fails the test.
effect fn readReply(text: &[u8], offset: &mut usize) -> Value
  ! AssertionError<'static> | JsonError | OutOfMemoryError
  ? &mut Allocator {
  let prefix = b"Content-Length: "
  run Testing.expect(offset.* <= text.length && text.length - offset.* >= prefix.length, "reply has a header")
  run Testing.expect(same(Slice.view<u8>(text, offset.*, prefix.length), prefix), "reply names Content-Length")
  let mut at = offset.* + prefix.length
  let mut length: usize = 0
  while at < text.length && text[at] >= 48 && text[at] <= 57 {
    length = length * 10 + u8.toUsize(text[at] - 48)
    at = at + 1
  }
  run Testing.expect(text.length - at >= 4, "header is complete")
  run Testing.expect(same(Slice.view<u8>(text, at, 4), b"\r\n\r\n"), "header ends before JSON")
  at = at + 4
  run Testing.expect(length <= text.length - at, "reply body is complete")
  offset.* = at + length
  return run Json.parse(Slice.view<u8>(text, at, length))
}

test effect fn unavailableServerExplainsItself() -> ()
  ! AssertionError<'static> | JsonError | WriterError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut input = Scripted {
    bytes: b"Content-Length: 46\r\n\r\n{\"jsonrpc\":\"2.0\",\"id\":1,\"method\":\"initialize\"}Content-Length: 54\r\n\r\n{\"jsonrpc\":\"2.0\",\"id\":2,\"method\":\"textDocument/hover\"}Content-Length: 44\r\n\r\n{\"jsonrpc\":\"2.0\",\"id\":3,\"method\":\"shutdown\"}Content-Length: 33\r\n\r\n{\"jsonrpc\":\"2.0\",\"method\":\"exit\"}",
    at: usize.ZERO
  }
  let mut output = Captured {
    bytes: run Bytes.zeroed(1024) |> Effect.provideMut<Allocator>(&mut allocator),
    length: usize.ZERO
  }
  let status = run Unavailable.serve(b"Silk \"9.9.9\" is not installed.\nInstall it with: silk use")
    |> Effect.provideMut<StandardInput>(&mut input)
    |> Effect.provideMut<Writer>(&mut output)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let written = Slice.view<u8>(Bytes.asSlice(&output.bytes), usize.ZERO, output.length)
  let mut offset: usize = 0
  let initialized = run readReply(written, &mut offset) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Option<i32>.unwrapOr(Json.asI32(Json.field(&initialized, "id")), 0) == 1, "initialize preserves its request id")
  let result = Json.field(&initialized, "result")
  run Testing.expect(Option<&Value>.isNone(&result), "initialize must not report success")
  let code = Json.field(&initialized, "error") |> Json.fieldAt("code") |> Json.asI32 |> Option<i32>.unwrapOr(0)
  run Testing.expect(code == -32000, "initialize reports a server error")
  let message = Json.field(&initialized, "error") |> Json.fieldAt("message") |> Json.asString |> Option<string>.unwrapOr("")
  run Testing.expect(message == "Silk \"9.9.9\" is not installed.\nInstall it with: silk use", "the original reason survives JSON escaping")
  let retry = Json.field(&initialized, "error") |> Json.fieldAt("data") |> Json.fieldAt("retry")
  let noRetry = match move retry {
    Option<&Value>.Some { value } => match &value.* {
      Value.Bool { value: enabled } => !enabled
      _ => false
    }
    _ => false
  }
  run Testing.expect(noRetry, "the unavailable process cannot retry initialization")
  let hover = run readReply(written, &mut offset) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Option<i32>.unwrapOr(Json.asI32(Json.field(&hover, "id")), 0) == 2, "hover preserves its request id")
  let hoverCode = Json.field(&hover, "error") |> Json.fieldAt("code") |> Json.asI32 |> Option<i32>.unwrapOr(0)
  run Testing.expect(hoverCode == -32002, "requests after failed initialization remain uninitialized")
  let shutdown = run readReply(written, &mut offset) |> Effect.provideMut<Allocator>(&mut allocator)
  let shutdownCode = Json.field(&shutdown, "error") |> Json.fieldAt("code") |> Json.asI32 |> Option<i32>.unwrapOr(0)
  run Testing.expect(shutdownCode == -32002, "shutdown cannot succeed without initialization")
  run Testing.expect(offset == written.length, "there are no success replies or showMessage notifications")
  run Testing.expect(status == 1, "failed initialization exits unsuccessfully")
}

test effect fn unavailableServerPreservesStringIdsOnEof() -> ()
  ! AssertionError<'static> | JsonError | WriterError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut input = Scripted {
    bytes: b"Content-Length: 52\r\n\r\n{\"jsonrpc\":\"2.0\",\"id\":\"start\",\"method\":\"initialize\"}",
    at: usize.ZERO
  }
  let mut output = Captured {
    bytes: run Bytes.zeroed(1024) |> Effect.provideMut<Allocator>(&mut allocator),
    length: usize.ZERO
  }
  let status = run Unavailable.serve(b"toolchain download failed")
    |> Effect.provideMut<StandardInput>(&mut input)
    |> Effect.provideMut<Writer>(&mut output)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let written = Slice.view<u8>(Bytes.asSlice(&output.bytes), usize.ZERO, output.length)
  let mut offset: usize = 0
  let reply = run readReply(written, &mut offset) |> Effect.provideMut<Allocator>(&mut allocator)
  let id = Json.field(&reply, "id") |> Json.asString |> Option<string>.unwrapOr("")
  run Testing.expect(id == "start", "string request ids are preserved")
  let code = Json.field(&reply, "error") |> Json.fieldAt("code") |> Json.asI32 |> Option<i32>.unwrapOr(0)
  run Testing.expect(code == -32000, "download failures fail initialization too")
  run Testing.expect(offset == written.length, "EOF follows one error response")
  run Testing.expect(status == 1, "EOF after failed initialization is unsuccessful")
}
