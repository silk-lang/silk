//! The release archive reader returns files and directories in order and refuses links, unsafe
//! paths, corrupt headers and truncated archives.

import TarArchive as TarArchive { TarError, TarMember, TarReader }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.testing.testing { AssertionError, Testing }
import silk.num.u8
import silk.num.usize

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// Builds archives the way `ReleaseArchive.ts` writes them, into a fixed buffer.
struct Builder {
  bytes: [u8; 4096],
  length: usize,
}

fn builder() -> Builder {
  return Builder { bytes: [0; 4096], length: usize.ZERO }
}

fn put(target: &mut Builder, at: usize, text: &[u8]) -> () {
  let mut index = usize.ZERO
  while index < text.length {
    target.bytes[target.length + at + index] = text[index]
    index = index + usize.ONE
  }
}

fn putOctal(target: &mut Builder, at: usize, width: usize, value: usize) -> () {
  let mut remaining = value
  let mut index = width - usize.add(0, 2)
  let mut more = true
  while more {
    target.bytes[target.length + at + index] = usize.toU8(remaining % usize.add(0, 8)) + 48
    remaining = remaining / usize.add(0, 8)
    if index == usize.ZERO {
      more = false
    } else {
      index = index - usize.ONE
    }
  }
}

// Appends one member: `kind` is the ustar type byte, and `content` follows, padded to 512 bytes.
fn member(
  target: &mut Builder,
  prefix: &[u8],
  name: &[u8],
  kind: u8,
  mode: usize,
  content: &[u8]
) -> () {
  put(&mut target.*, usize.ZERO, name)
  putOctal(&mut target.*, usize.add(0, 100), usize.add(0, 8), mode)
  putOctal(&mut target.*, usize.add(0, 108), usize.add(0, 8), usize.ZERO)
  putOctal(&mut target.*, usize.add(0, 116), usize.add(0, 8), usize.ZERO)
  putOctal(&mut target.*, usize.add(0, 124), usize.add(0, 12), content.length)
  putOctal(&mut target.*, usize.add(0, 136), usize.add(0, 12), usize.ZERO)
  put(&mut target.*, usize.add(0, 148), b"        ")
  target.bytes[target.length + usize.add(0, 156)] = kind
  put(&mut target.*, usize.add(0, 257), b"ustar\x0000")
  put(&mut target.*, usize.add(0, 345), prefix)
  let mut sum = usize.ZERO
  let mut at = usize.ZERO
  while at < 512 {
    sum = sum + u8.toUsize(target.bytes[target.length + at])
    at = at + usize.ONE
  }
  putOctal(&mut target.*, usize.add(0, 148), usize.add(0, 7), sum)
  target.bytes[target.length + usize.add(0, 154)] = 0
  target.length = target.length + usize.add(0, 512)
  put(&mut target.*, usize.ZERO, content)
  target.length = target.length
    + (content.length + usize.add(0, 511)) / usize.add(0, 512) * usize.add(0, 512)
}

// Appends the two zero blocks that end an archive.
fn end(target: &mut Builder) -> () {
  target.length = target.length + usize.add(0, 1024)
}

fn release() -> Builder {
  let mut archive = builder()
  member(&mut archive, b"", b"silk-1/", 53, usize.add(0, 493), b"")
  member(&mut archive, b"", b"silk-1/bin/silk", 48, usize.add(0, 493), b"compiler")
  member(
    &mut archive,
    b"silk-1/lib/silk/stdlib",
    b"silk/core/option.silk",
    48,
    usize.add(0, 420),
    b"pub enum Option {}\n"
  )
  end(&mut archive)
  return move archive
}

fn bytesOf(archive: &Builder) -> &[u8] {
  return Slice.view<u8>(&archive.bytes, usize.ZERO, archive.length)
}

// The error reading `archive` to its end gives, or `None` when every member reads.
fn failure(archive: &[u8]) -> Option<TarError> {
  let mut reader = TarArchive.reader(archive)
  while true {
    match TarReader.next(&mut reader) {
      Result<Option<TarMember>, TarError>.Failure { error } => {
        return Option<TarError>.some(error)
      }
      Result<Option<TarMember>, TarError>.Success { value } => match move value {
        Option<TarMember>.None => {
          return Option<TarError>.none()
        }
        Option<TarMember>.Some { value: read } => ()
      }
    }
  }
  return Option<TarError>.none()
}

fn refused(archive: &[u8], expected: TarError) -> bool {
  return match failure(archive) {
    Option<TarError>.Some { value } => value == expected
    Option<TarError>.None => false
  }
}

// The next member, or `None` at the end or on a failure.
fn advance<'a>(reader: &mut TarReader<'a>) -> Option<TarMember<'a>> {
  return match TarReader.next(&mut reader.*) {
    Result<Option<TarMember<'a>>, TarError>.Success { value } => move value
    Result<Option<TarMember<'a>>, TarError>.Failure { error } => Option<TarMember<'a>>.none()
  }
}

fn readsRelease() -> bool {
  let archive = release()
  let mut reader = TarArchive.reader(bytesOf(&archive))
  let first = match advance(&mut reader) {
    Option<TarMember>.Some { value } => move value
    Option<TarMember>.None => {
      return false
    }
  }
  if !first.directory || !same(first.name, b"silk-1") || first.prefix.length != usize.ZERO {
    return false
  }
  let second = match advance(&mut reader) {
    Option<TarMember>.Some { value } => move value
    Option<TarMember>.None => {
      return false
    }
  }
  if second.directory || !second.executable || !same(second.content, b"compiler") {
    return false
  }
  let third = match advance(&mut reader) {
    Option<TarMember>.Some { value } => move value
    Option<TarMember>.None => {
      return false
    }
  }
  if third.executable || !same(third.prefix, b"silk-1/lib/silk/stdlib")
    || !same(third.name, b"silk/core/option.silk")
    || !same(third.content, b"pub enum Option {}\n") {
    return false
  }
  let ended = match advance(&mut reader) {
    Option<TarMember>.Some { value } => false
    Option<TarMember>.None => true
  }
  return ended
    && match failure(bytesOf(&archive)) {
    Option<TarError>.Some { value } => false
    Option<TarError>.None => true
  }
}

test effect fn tarReadsReleaseMembers() -> ()
  ! AssertionError<'static> {
  run Testing.expect(
    readsRelease(),
    "directories, executable files and prefixed names read in archive order"
  )
}

test effect fn tarRefusesUnsafeArchives() -> ()
  ! AssertionError<'static> {
  let mut climbing = builder()
  member(&mut climbing, b"", b"silk-1/../../escape", 48, usize.add(0, 420), b"x")
  end(&mut climbing)
  let mut absolute = builder()
  member(&mut absolute, b"", b"/etc/escape", 48, usize.add(0, 420), b"x")
  end(&mut absolute)
  let mut prefixed = builder()
  member(&mut prefixed, b"silk-1/..", b"escape", 48, usize.add(0, 420), b"x")
  end(&mut prefixed)
  run Testing.expect(
    refused(bytesOf(&climbing), TarError.UnsafePath)
      && refused(bytesOf(&absolute), TarError.UnsafePath)
      && refused(bytesOf(&prefixed), TarError.UnsafePath),
    "absolute paths and `..` components in the name or prefix are refused"
  )
  let mut linked = builder()
  member(&mut linked, b"", b"silk-1/link", 50, usize.add(0, 511), b"")
  end(&mut linked)
  run Testing.expect(
    refused(bytesOf(&linked), TarError.UnsupportedMember),
    "symbolic links are refused"
  )
  let mut corrupt = release()
  corrupt.bytes[3] = u8.bitXor(corrupt.bytes[3], 1)
  run Testing.expect(
    refused(bytesOf(&corrupt), TarError.BadChecksum),
    "a header whose checksum does not match is refused"
  )
  let whole = release()
  let cut = Slice.view<u8>(&whole.bytes, usize.ZERO, usize.add(0, 700))
  run Testing.expect(
    refused(cut, TarError.Truncated),
    "an archive that ends inside a member is refused"
  )
}


import ZipArchive as ZipArchive {ZipError, ZipMember, ZipReader}
import silk.collections.bytes {Bytes}
import silk.core.effect {Effect}
import silk.mem.allocator {Allocator, OutOfMemoryError}

// Independent Node zlib raw-DEFLATE output and ZIP APPNOTE headers for "hello".
fn zipHello() -> &'static [u8] { return b"\x50\x4b\x03\x04\x14\x00\x00\x08\x08\x00\x00\x00\x00\x00\x86\xa6\x10\x36\x07\x00\x00\x00\x05\x00\x00\x00\x0d\x00\x00\x00\x72\x65\x6c\x65\x61\x73\x65\x2f\x68\x65\x6c\x6c\x6f\xcb\x48\xcd\xc9\xc9\x07\x00\x50\x4b\x01\x02\x14\x00\x14\x00\x00\x08\x08\x00\x00\x00\x00\x00\x86\xa6\x10\x36\x07\x00\x00\x00\x05\x00\x00\x00\x0d\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x72\x65\x6c\x65\x61\x73\x65\x2f\x68\x65\x6c\x6c\x6f\x50\x4b\x05\x06\x00\x00\x00\x00\x01\x00\x01\x00\x3b\x00\x00\x00\x32\x00\x00\x00\x00\x00" }

fn zipRefused(bytes: &[u8], expected: ZipError) -> bool {
  let mut reader = match ZipArchive.reader(bytes) {
    Result.Success {value} => move value
    Result.Failure {error} => { return error == expected }
  }
  return match ZipReader.next(&mut reader) {
    Result.Success {value} => false
    Result.Failure {error} => error == expected
  }
}

effect fn decodeZip() -> () ! AssertionError<'static> | ZipError | OutOfMemoryError ? &mut Allocator {
  let mut reader = match ZipArchive.reader(zipHello()) {
    Result.Success {value} => move value
    Result.Failure {error} => { fail error }
  }
  let found = match ZipReader.next(&mut reader) {
    Result.Success {value} => move value
    Result.Failure {error} => { fail error }
  }
  if let Option<ZipMember>.Some {value} = move found {
    let content = run ZipArchive.content(&value)
    run Testing.expect(same(value.name, b"release/hello") && !value.directory
      && same(Bytes.asSlice(&content), b"hello"), "ZIP decodes independent DEFLATE data and its path")
    let wrong = ZipMember {name: value.name, compressed: value.compressed, directory: false,
      deflated: true, length: value.length, checksum: 0}
    let refused = match move run Effect.result(ZipArchive.content(&wrong)) {
      Result<Bytes, ZipError | OutOfMemoryError>.Success {value: decoded} => false
      Result<Bytes, ZipError | OutOfMemoryError>.Failure {error} => match move error {
        ZipError invalid => invalid == ZipError.BadChecksum
        OutOfMemoryError exhausted => { fail move exhausted }
      }
    }
    run Testing.expect(refused, "ZIP content CRC mismatch is refused")
  } else { run Testing.expect(false, "ZIP fixture must have a file") }
  let done = match ZipReader.next(&mut reader) {
    Result.Success {value} => match move value { Option.Some {value: extra} => false Option.None => true }
    Result.Failure {error} => false
  }
  run Testing.expect(done, "ZIP consumes exactly the central directory")
}

test effect fn zipDecodesAndChecksContent() -> () ! AssertionError<'static> | ZipError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  run decodeZip() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn zipRefusesInconsistentAndUnsafeRecords() -> () ! AssertionError<'static> {
  let mut changed: [u8; 131] = [0; 131]
  let mut at: usize = 0
  while at < changed.length { changed[at] = zipHello()[at]
    at = at + 1 }
  changed[92] = 1
  run Testing.expect(zipRefused(&changed, ZipError.InvalidDirectory), "ZIP refuses overlapping or reordered local headers")
  changed[92] = 0
  changed[30] = 47
  changed[96] = 47
  run Testing.expect(zipRefused(&changed, ZipError.UnsafePath), "ZIP refuses rooted paths even when both headers agree")
  changed[30] = 114
  changed[96] = 114
  changed[58] = 1
  run Testing.expect(zipRefused(&changed, ZipError.UnsupportedMember), "ZIP refuses encrypted members")
  run Testing.expect(zipRefused(Slice.view(zipHello(), 0, zipHello().length - 1), ZipError.InvalidDirectory),
    "ZIP refuses a truncated end record")
}


import ReleaseArchive as ReleaseArchive {ArchiveReader, ArchiveMember, ArchiveError}

effect fn duplicateMember() -> bool ! ArchiveError | OutOfMemoryError ? &mut Allocator {
  let mut archive = builder()
  member(&mut archive, b"", b"release/file", 48, 420, b"first")
  member(&mut archive, b"", b"release/file", 48, 420, b"second")
  end(&mut archive)
  let mut reader = match move ReleaseArchive.reader(bytesOf(&archive), false) {
    Result.Success {value} => move value
    Result.Failure {error} => { fail move error }
  }
  let first = run ArchiveReader.next(&mut reader)
  drop first
  return match move run Effect.result(ArchiveReader.next(&mut reader)) {
    Result<Option<ArchiveMember>, ArchiveError | OutOfMemoryError>.Success {value} => false
    Result<Option<ArchiveMember>, ArchiveError | OutOfMemoryError>.Failure {error} => match move error {
      ArchiveError invalid => match move invalid { ArchiveError.Duplicate => true ArchiveError.Tar {..} => false ArchiveError.Zip {..} => false }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

test effect fn releaseRefusesDuplicateMembers() -> () ! AssertionError<'static> | ArchiveError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let refused = run duplicateMember() |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(refused, "release extraction refuses repeated paths before overwriting an earlier member")
}
