//! The little of a `silk.toml` silk reads: where the nearest manifest is, which workspace lists it,
//! and the `silk-version` of `[workspace]` and `[package]`.
//!
//! Everything else in a manifest belongs to the compiler the project pins, so silk never validates
//! it: a manifest it cannot read or parse here is passed over, and the compiler that runs reports
//! the problem in its own words.

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.system.filesystem { DirectoryEntry, FileError, FileSystem, Path }
import silk.system.host_input { HostInput }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.text.string { InvalidUtf8, String }
import silk.toml.scanner { TomlError }
import silk.toml.value { Toml, Value as TomlValue }
import silk.num.usize

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// The digits-only identifier `value` has no leading zero.
fn isNumericIdentifier(value: &[u8]) -> bool {
  if value.length == usize.ZERO {
    return false
  }
  let mut at = usize.ZERO
  while at < value.length {
    if value[at] < 48 || value[at] > 57 {
      return false
    }
    at = at + usize.ONE
  }
  return value.length == usize.ONE || value[usize.ZERO] != 48
}

fn isIdentifierByte(byte: u8) -> bool {
  return byte >= 48 && byte <= 57 || byte >= 65 && byte <= 90 || byte >= 97 && byte <= 122 || byte == 45
}

// Whether the dot-separated identifiers of `value` are valid; `prerelease` identifiers that are
// all digits must also have no leading zero.
fn validIdentifiers(value: &[u8], prerelease: bool) -> bool {
  let mut start = usize.ZERO
  let mut at = usize.ZERO
  while at <= value.length {
    if at == value.length || value[at] == 46 {
      if at == start {
        return false
      }
      let mut digits = true
      let mut index = start
      while index < at {
        if !isIdentifierByte(value[index]) {
          return false
        }
        if value[index] < 48 || value[index] > 57 {
          digits = false
        }
        index = index + usize.ONE
      }
      if prerelease && digits && at - start > usize.ONE && value[start] == 48 {
        return false
      }
      start = at + usize.ONE
    }
    at = at + usize.ONE
  }
  return true
}

/// Whether `version` is a semantic version: `MAJOR.MINOR.PATCH`, an optional `-` pre-release and
/// an optional `+` build.
pub fn isSemanticVersion(version: &[u8]) -> bool {
  let mut end = version.length
  let mut at = usize.ZERO
  while at < version.length {
    if version[at] == 43 {
      end = at
      break
    }
    at = at + usize.ONE
  }
  if end < version.length && !validIdentifiers(Slice.view<u8>(version, end + usize.ONE, version.length - end - usize.ONE), false) {
    return false
  }
  let mut coreEnd = end
  at = usize.ZERO
  while at < end {
    if version[at] == 45 {
      coreEnd = at
      break
    }
    at = at + usize.ONE
  }
  if coreEnd < end && !validIdentifiers(Slice.view<u8>(version, coreEnd + usize.ONE, end - coreEnd - usize.ONE), true) {
    return false
  }
  let core = Slice.view<u8>(version, usize.ZERO, coreEnd)
  let mut parts = usize.ZERO
  let mut start = usize.ZERO
  at = usize.ZERO
  while at <= core.length {
    if at == core.length || core[at] == 46 {
      if !isNumericIdentifier(Slice.view<u8>(core, start, at - start)) {
        return false
      }
      parts = parts + usize.ONE
      start = at + usize.ONE
    }
    at = at + usize.ONE
  }
  return parts == usize.add(0, 3)
}

/// A copy of `path`.
pub effect fn copyPath(path: &Path) -> Path
  ! OutOfMemoryError
  ? &mut Allocator {
  return match move run Effect.result(Path.fromBytes(Path.rawBytes(path))) {
    Result<Path, FileError | OutOfMemoryError>.Success { value } => move value
    Result<Path, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError impossible => {
        drop impossible
        return run Path.root()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// Whether the manifest at `path` exists; one that cannot be inspected does not.
effect fn present(path: &Path) -> bool
  ? &mut FileSystem {
  return match move run Effect.result(FileSystem.exists(path)) {
    Result<bool, FileError>.Success { value } => value
    Result<bool, FileError>.Failure { error } => {
      drop error
      return false
    }
  }
}

/// The nearest `silk.toml` at or above `start`, or `None` when there is none.
pub effect fn discover(start: &Path) -> Option<Path>
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut directory = run copyPath(start)
  while true {
    let candidate = run Path.join(&directory, "silk.toml")
    if run present(&candidate) {
      return Option<Path>.some(move candidate)
    }
    match move run Path.parent(&directory) {
      Option<Path>.Some { value } => {
        directory = move value
      }
      Option<Path>.None => {
        break
      }
    }
  }
  return Option<Path>.none()
}

/// The parsed manifest at `manifest`, or `None` when it cannot be read or is not TOML.
pub effect fn parsed(manifest: &Path) -> Option<TomlValue>
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let text = match move run Effect.result(FileSystem.readFile(manifest)) {
    Result<Bytes, FileError | OutOfMemoryError>.Success { value } => move value
    Result<Bytes, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError unreadable => {
        drop unreadable
        return Option<TomlValue>.none()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  return match move run Effect.result(Toml.parse(Bytes.asSlice(&text))) {
    Result<TomlValue, TomlError | OutOfMemoryError>.Success { value } => Option<TomlValue>.some(move value)
    Result<TomlValue, TomlError | OutOfMemoryError>.Failure { error } => match move error {
      TomlError malformed => {
        drop malformed
        return Option<TomlValue>.none()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

/// The nearest manifest at or above `directory` that has a `[workspace]` table. Manifests that
/// cannot be read or parsed on the way are passed over.
pub effect fn enclosingWorkspace(directory: &Path) -> Option<Path>
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut current = run copyPath(directory)
  while true {
    let candidate = run Path.join(&current, "silk.toml")
    if run present(&candidate) {
      if let Option<TomlValue>.Some { value: document } = move run parsed(&candidate) {
        if let Option<&TomlValue>.Some { value: _ } = move Toml.field(&document, "workspace") {
          return Option<Path>.some(move candidate)
        }
      }
    }
    match move run Path.parent(&current) {
      Option<Path>.Some { value } => {
        current = move value
      }
      Option<Path>.None => {
        break
      }
    }
  }
  return Option<Path>.none()
}

// Whether `text` names a directory inside the workspace: relative, and never climbing above it.
fn isContainedDirectory(text: &[u8]) -> bool {
  if text.length == usize.ZERO || text[usize.ZERO] == 47 || text[usize.ZERO] == 92 {
    return false
  }
  let mut depth = usize.ZERO
  let mut start = usize.ZERO
  let mut at = usize.ZERO
  while at <= text.length {
    let boundary = at == text.length || text[at] == 47 || text[at] == 92
    if at < text.length && text[at] == 0 {
      return false
    }
    if boundary {
      let length = at - start
      if length == 2 && text[start] == 46 && text[start + usize.ONE] == 46 {
        if depth == usize.ZERO {
          return false
        }
        depth = depth - usize.ONE
      } else if length > usize.ZERO && !(length == usize.ONE && text[start] == 46) {
        depth = depth + usize.ONE
      }
      start = at + usize.ONE
    }
    at = at + usize.ONE
  }
  return true
}

// `written` resolved below `directory`, or `None` when it is not a contained directory.
effect fn below(directory: &Path, written: &[u8]) -> Option<Path>
  ! OutOfMemoryError
  ? &mut Allocator {
  if !isContainedDirectory(written) {
    return Option<Path>.none()
  }
  let text = match HostInput.text(written) {
    Result<string, InvalidUtf8>.Success { value } => value
    Result<string, InvalidUtf8>.Failure { error: _ } => {
      return Option<Path>.none()
    }
  }
  return match move run Effect.result(Path.resolve(directory, text)) {
    Result<Path, FileError | OutOfMemoryError>.Success { value } => Option<Path>.some(move value)
    Result<Path, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError invalid => {
        drop invalid
        return Option<Path>.none()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// One `[workspace].members` entry: the directory it names and whether it ends in `/*`, naming
// each child directory of that one.
struct Entry {
  base: Path,
  wildcard: bool,
}

// The entries of the `[workspace]` table of `document`, skipping any that are not contained
// directory strings.
effect fn entries(directory: &Path, document: &TomlValue) -> List<Entry>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut found = List<Entry>.make()
  let listed = match move Toml.fieldAt(Toml.field(document, "workspace"), "members") {
    Option<&TomlValue>.Some { value } => value
    Option<&TomlValue>.None => {
      return move found
    }
  }
  let mut at = usize.ZERO
  while true {
    let item = match move Toml.item(listed, at) {
      Option<&TomlValue>.Some { value } => value
      Option<&TomlValue>.None => {
        break
      }
    }
    at = at + usize.ONE
    let entry = match move Toml.asString(Option<&TomlValue>.some(item)) {
      Option<string>.Some { value } => String.utf8Bytes(value)
      Option<string>.None => {
        continue
      }
    }
    let suffix = usize.add(0, 2)
    let wildcard = entry.length > suffix && entry[entry.length - usize.ONE] == 42 && entry[entry.length - suffix] == 47
    let mut written = entry
    if wildcard {
      written = Slice.view<u8>(entry, usize.ZERO, entry.length - suffix)
    }
    if let Option<Path>.Some { value } = move run below(directory, written) {
      run List<Entry>.append(&mut found, Entry { base: move value, wildcard: wildcard })
    }
  }
  return move found
}

/// Whether some `[workspace].members` entry of the workspace at `manifest` names the directory
/// `member`, judged from the entries alone: a `dir/*` entry names every child of `dir`.
pub effect fn listsMember(manifest: &Path, member: &Path) -> bool
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let document = match move run parsed(manifest) {
    Option<TomlValue>.Some { value } => move value
    Option<TomlValue>.None => {
      return false
    }
  }
  let directory = match move run Path.parent(manifest) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => {
      return false
    }
  }
  let found = run entries(&directory, &document)
  let listed = List<Entry>.asSlice(&found)
  let mut at = usize.ZERO
  while at < listed.length {
    if listed[at].wildcard {
      if let Option<Path>.Some { value: parent } = move run Path.parent(member) {
        if same(Path.rawBytes(&parent), Path.rawBytes(&listed[at].base)) {
          return true
        }
      }
    } else if same(Path.rawBytes(&listed[at].base), Path.rawBytes(member)) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

/// The manifests of the members the workspace at `manifest` lists that exist, in listed order.
pub effect fn memberManifests(manifest: &Path) -> List<Path>
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let mut manifests = List<Path>.make()
  let document = match move run parsed(manifest) {
    Option<TomlValue>.Some { value } => move value
    Option<TomlValue>.None => {
      return move manifests
    }
  }
  let directory = match move run Path.parent(manifest) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => {
      return move manifests
    }
  }
  let found = run entries(&directory, &document)
  let listed = List<Entry>.asSlice(&found)
  let mut at = usize.ZERO
  while at < listed.length {
    let mut directories = List<Path>.make()
    if listed[at].wildcard {
      if let Result<List<DirectoryEntry>, FileError | OutOfMemoryError>.Success { value: children } = move run Effect.result(
        FileSystem.listDirectory(&listed[at].base)
      ) {
        let each = List<DirectoryEntry>.asSlice(&children)
        let mut child = usize.ZERO
        while child < each.length {
          if each[child].kind.code == FileSystem.directory().code {
            run List<Path>.append(&mut directories, run copyPath(&each[child].path))
          }
          child = child + usize.ONE
        }
      }
    } else {
      run List<Path>.append(&mut directories, run copyPath(&listed[at].base))
    }
    let named = List<Path>.asSlice(&directories)
    let mut index = usize.ZERO
    while index < named.length {
      if let Result<Path, FileError | OutOfMemoryError>.Success { value: member } = move run Effect.result(
        Path.join(&named[index], "silk.toml")
      ) {
        if run present(&member) {
          run List<Path>.append(&mut manifests, move member)
        }
      }
      index = index + usize.ONE
    }
    at = at + usize.ONE
  }
  return move manifests
}
