static if Intrinsic.targetOperatingSystem() == "windows" {
  import WindowsHostFiles {WindowsHostFiles}
  pub type NativeHostFiles = WindowsHostFiles
} else {
//! POSIX `chmod`, `rename`, `link` and `flock` for toolchain installs and silk's own updates.

import Install as ToolchainInstall { HostFiles }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.system.filesystem { Path }
import silk.mem.pointer { Pointer }
import silk.num.usize

@foreign(noCapture: ("path",))
unsafe extern "C" fn chmod(path: ?[*] const u8, mode: u32) -> i32

@foreign(noCapture: ("oldPath", "newPath"))
unsafe extern "C" fn rename(
  oldPath: ?[*] const u8,
  newPath: ?[*] const u8
) -> i32

@foreign(noCapture: ("oldPath", "newPath"))
unsafe extern "C" fn link(
  oldPath: ?[*] const u8,
  newPath: ?[*] const u8
) -> i32

@foreign(noCapture: ("path",))
unsafe extern "C" fn open(path: ?[*] const u8, flags: i32, ...) -> i32

unsafe extern "C" fn close(descriptor: i32) -> i32

unsafe extern "C" fn flock(descriptor: i32, operation: i32) -> i32

const READ_WRITE: i32 = 2
const EXCLUSIVE_LOCK: i32 = 2
const UNLOCK: i32 = 8

static if Intrinsic.targetOperatingSystem() == "darwin" {
  const CREATE: i32 = 512
  const CLOSE_ON_EXEC: i32 = 16777216
} else {
  const CREATE: i32 = 64
  const CLOSE_ON_EXEC: i32 = 524288
}

/// Host file operations on paths below `root`, the root of the `OsFileSystem` the paths belong to.
pub struct NativeHostFiles {
  root: &'static [u8],

  // The descriptor of the locked file, or -1.
  held: i32,
}

impl NativeHostFiles {
  /// Host file operations below `root`.
  pub fn at(root: &'static [u8]) -> NativeHostFiles {
    return NativeHostFiles { root: root, held: -1 }
  }

  // The NUL-terminated host path of `path`.
  effect fn host(self: &Self, path: &Path) -> Bytes
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut text = Bytes.make()
    let raw = Path.rawBytes(path)
    if !(self.root.length == 1 && self.root[0] == 47) {
      run Bytes.append(&mut text, self.root)
    }
    run Bytes.append(&mut text, raw)
    let ending: [u8; 1] = [0]
    run Bytes.append(&mut text, &ending)
    return move text
  }

  effect fn markExecutable(self: &mut Self, path: &Path) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    let target = run self.host(path)
    let status = unsafe chmod(Pointer.fromSlice<u8>(Bytes.asSlice(&target)), 493)
    return status == 0
  }

  effect fn rename(self: &mut Self, from: &Path, to: &Path) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    let source = run self.host(from)
    let destination = run self.host(to)
    let status = unsafe rename(
      Pointer.fromSlice<u8>(Bytes.asSlice(&source)),
      Pointer.fromSlice<u8>(Bytes.asSlice(&destination)),
    )
    return status == 0
  }

  effect fn hardLink(self: &mut Self, from: &Path, to: &Path) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    let source = run self.host(from)
    let destination = run self.host(to)
    let status = unsafe link(
      Pointer.fromSlice<u8>(Bytes.asSlice(&source)),
      Pointer.fromSlice<u8>(Bytes.asSlice(&destination)),
    )
    return status == 0
  }

  effect fn lock(self: &mut Self, path: &Path) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.held >= 0 {
      return false
    }
    let target = run self.host(path)
    let descriptor = unsafe open(
      Pointer.fromSlice<u8>(Bytes.asSlice(&target)),
      READ_WRITE + CREATE + CLOSE_ON_EXEC,
      420,
    )
    if descriptor < 0 {
      return false
    }
    if unsafe flock(descriptor, EXCLUSIVE_LOCK) != 0 {
      let closed = unsafe close(descriptor)
      return false
    }
    self.held = descriptor
    return true
  }

  effect fn unlock(self: &mut Self) -> () {
    if self.held < 0 {
      return ()
    }
    let released = unsafe flock(self.held, UNLOCK)
    let closed = unsafe close(self.held)
    self.held = -1
  }
}

impl HostFiles for NativeHostFiles {
  markExecutable: NativeHostFiles.markExecutable
  rename: NativeHostFiles.rename
  link: NativeHostFiles.hardLink
  lock: NativeHostFiles.lock
  unlock: NativeHostFiles.unlock
}

}
