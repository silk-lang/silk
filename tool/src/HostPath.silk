//! Host path conversion and ancestor boundaries for the Silk tool.

import silk.collections.bytes {Bytes}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.system.filesystem {Path, FileError}
import silk.core.option {Option}
static if Intrinsic.targetOperatingSystem() == "windows" { import silk.platform.windows.path {WindowsPath} }

/// Converts an absolute host name to the tool's machine namespace.
pub effect fn fromBytes(bytes: &[u8]) -> Path ! FileError | OutOfMemoryError ? &mut Allocator {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    if bytes.length > 0 && bytes[0] == 47 { return run Path.fromBytes(bytes) }
    return run WindowsPath.fromNativeBytes(bytes)
  } else { return run Path.fromBytes(bytes) }
}

/// The host's spelling of `path`, for an environment value a child process reads: the normal
/// Windows name (`C:\...`) on Windows, the unchanged bytes elsewhere.
pub effect fn toBytes(path: &Path) -> Bytes ! FileError | OutOfMemoryError ? &mut Allocator {
  static if Intrinsic.targetOperatingSystem() == "windows" { return run WindowsPath.toArgumentBytes(path) }
  else { return run Bytes.copy(Path.rawBytes(path)) }
}

/// Returns the parent without climbing above a Windows volume or Unix root.
pub effect fn parent(path: &Path) -> Option<Path> ! OutOfMemoryError ? &mut Allocator {
  static if Intrinsic.targetOperatingSystem() == "windows" { return run WindowsPath.parent(path) }
  else { return run Path.parent(path) }
}
