//! Reading silk's own environment to pass to a compiler it runs and captures (`silk cached`), since a
//! `ChildProcess` request starts with an empty environment.

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.system.host_input { HostInput, HostInputError }
import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.collections.slice { Slice }
import silk.text.string { String }
import silk.num.usize

static if Intrinsic.targetOperatingSystem() == "darwin" {
  unsafe extern "C" fn _NSGetEnviron() -> *const ?[*]const ?[*]const u8
  unsafe fn environmentVector() -> ?[*]const ?[*]const u8 {
    unsafe { return Pointer.read(_NSGetEnviron()) }
  }
} else static if Intrinsic.targetOperatingSystem() != "windows" && Intrinsic.targetOperatingSystem() != "wasi" {
  unsafe extern "C" static processEnvironment: ?[*]const ?[*]const u8 as "environ"
  unsafe fn environmentVector() -> ?[*]const ?[*]const u8 {
    unsafe { return processEnvironment }
  }
}

// Declared exactly as the standard library declares it, since two declarations of one C symbol must agree.
unsafe extern "C" fn strlen(text: [*]const u8) -> usize

/// Every variable of this process's environment, as a name followed by its value. Windows names
/// the variables a compiler and the programs it starts read.
pub effect fn variables() -> List<Bytes> ! HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator {
  let mut found = List<Bytes>.make()
  static if Intrinsic.targetOperatingSystem() == "windows" {
    let names: [string; 46] = ["PATH", "PATHEXT", "SystemRoot", "SystemDrive", "WINDIR", "COMSPEC", "TEMP", "TMP",
      "USERPROFILE", "USERNAME", "HOMEDRIVE", "HOMEPATH", "APPDATA", "LOCALAPPDATA", "ProgramData", "ProgramFiles",
      "ProgramFiles(x86)", "NUMBER_OF_PROCESSORS", "PROCESSOR_ARCHITECTURE", "OS", "SILK_HOME", "SILK_TOOLCHAIN",
      "SILK_CLANG", "SILK_LLVM_AR", "SILK_OFFLINE", "SILK_PROFILE_USE", "SILK_PROFILE_GENERATE", "SILK_PROGRESS",
      "NO_COLOR", "TERM", "COLUMNS", "SDKROOT", "SILK_WASI_ADAPTER", "SILK_WASI_REACTOR_ADAPTER", "SILK_VERIFY_MIR",
      "SILK_RECEIPTS", "HTTP_PROXY", "HTTPS_PROXY", "NO_PROXY", "ALL_PROXY", "GIT_SSH_COMMAND", "GIT_CONFIG_GLOBAL",
      "LIB", "LIBPATH", "INCLUDE", "WASMTIME_BACKTRACE_DETAILS"]
    let mut at = usize.ZERO
    while at < names.length {
      if let Option<Bytes>.Some { value } = move run HostInput.variableNamed(names[at]) {
        run List<Bytes>.append(&mut found, run Bytes.copy(String.utf8Bytes(names[at])))
        run List<Bytes>.append(&mut found, move value)
      }
      at = at + usize.ONE
    }
    return move found
  } else {
  static if Intrinsic.targetOperatingSystem() == "wasi" {
    return move found
  } else {
    let environment = match move Pointer.nonNullMany(unsafe environmentVector()) {
      Option<[*]const ?[*]const u8>.Some { value } => value
      Option<[*]const ?[*]const u8>.None => { return move found }
    }
    let mut index = usize.ZERO
    while true {
      let entry = match move Pointer.nonNullMany(unsafe Pointer.read(unsafe Pointer.at(environment, index))) {
        Option<[*]const u8>.Some { value } => value
        Option<[*]const u8>.None => { break }
      }
      let length = unsafe strlen(entry)
      let anchor = length
      let text = unsafe Pointer.borrowMany<usize, u8>(&anchor, entry, length)
      let mut equals = usize.ZERO
      while equals < text.length && text[equals] != 61 { equals = equals + usize.ONE }
      if equals > usize.ZERO && equals < text.length {
        run List<Bytes>.append(&mut found, run Bytes.copy(Slice.view<u8>(text, usize.ZERO, equals)))
        run List<Bytes>.append(&mut found, run Bytes.copy(Slice.view<u8>(text, equals + usize.ONE, text.length - equals - usize.ONE)))
      }
      index = index + usize.ONE
    }
    return move found
  }
  }
}

/// `variables` without the variables named in `names`.
pub effect fn without(variables: List<Bytes>, names: &[&[u8]]) -> List<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let mut kept = List<Bytes>.make()
  let listed = List<Bytes>.asSlice(&variables)
  let mut at = usize.ZERO
  while at + usize.ONE < listed.length {
    let mut named = false
    let mut one = usize.ZERO
    while one < names.length {
      if same(Bytes.asSlice(&listed[at]), names[one]) {
        named = true
      }
      one = one + usize.ONE
    }
    if !named {
      run List<Bytes>.append(&mut kept, run Bytes.copy(Bytes.asSlice(&listed[at])))
      run List<Bytes>.append(&mut kept, run Bytes.copy(Bytes.asSlice(&listed[at + usize.ONE])))
    }
    at = at + usize.add(0, 2)
  }
  return move kept
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}
