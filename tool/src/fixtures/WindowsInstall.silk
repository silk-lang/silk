// Real signed ZIP installation and replacement of this running executable. The fixture release
// is independently encoded and signed by Node zlib/crypto using a public, test-only key.
static if Intrinsic.targetOperatingSystem() == "windows" {
import Install as Install {HostFiles, InstallError, Installed, ReleaseSource}
import silk.io.writer {Writer, WriterError}
import silk.io.writer_native {StderrWriter}
import Toolchains
import WindowsHostFiles {WindowsHostFiles}
import fixtures.WindowsRelease as WindowsRelease
import silk.collections.bytes {Bytes}
import silk.collections.list {List}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.core.result {Result}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.platform.windows.host_path as WindowsHostPath
import silk.platform.windows.path {WindowsPath}
import silk.system.filesystem {FileSystem, FileError, Path}
import silk.system.filesystem_machine {MachineFileSystem}

struct Releases {badDigest: bool, badSignature: bool}
fn same(a: &[u8], b: &[u8]) -> bool {
  if a.length != b.length { return false }
  let mut at: usize = 0
  while at < a.length {
    if a[at] != b[at] { return false }
    at = at + 1
  }
  return true
}
impl ReleaseSource for Releases {
  effect fn releases(self: &mut Self) -> List<Bytes>
    ! InstallError | OutOfMemoryError ? &mut Allocator {
    let mut found = List<Bytes>.make()
    run List<Bytes>.append(&mut found, run Bytes.copy(b"1.2.3"))
    return move found
  }
  effect fn asset(self: &mut Self, version: &[u8], name: &[u8]) -> Bytes
    ! InstallError | OutOfMemoryError ? &mut Allocator {
    if same(name, b"silk-1.2.3-x86_64-pc-windows-msvc.zip") { return run Bytes.copy(WindowsRelease.archive()) }
    if same(name, b"silk-1.2.3-x86_64-pc-windows-msvc.zip.minisig") {
      return run Bytes.copy(if self.badSignature { b"invalid signature" } else { WindowsRelease.signature() })
    }
    if same(name, b"native-seed.json") {
      return run Bytes.copy(if self.badDigest { WindowsRelease.badSeed() } else { WindowsRelease.seed() })
    }
    fail InstallError {status: 4, message: run Bytes.copy(b"unexpected fixture asset")}
  }
}

effect fn refused(home: &Path) -> bool ! FileError | OutOfMemoryError
? &mut Allocator | &mut FileSystem | &mut HostFiles | &mut ReleaseSource {
  return match move run Effect.result(Install.install(home, b"1.2.3", Install.hostTarget(), WindowsRelease.key())) {
    Result<Installed, InstallError | FileError | OutOfMemoryError>.Success {value} => false
    Result<Installed, InstallError | FileError | OutOfMemoryError>.Failure {error} => match move error {
      InstallError invalid => invalid.status == Install.VERIFICATION
      FileError failure => { fail move failure }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

effect fn check(home: &Path) -> i32 ! InstallError | FileError | OutOfMemoryError
? &mut Allocator | &mut FileSystem | &mut HostFiles {
  let mut invalid = Releases {badDigest: false, badSignature: true}
  if !run refused(home) |> Effect.provideMut<ReleaseSource>(&mut invalid) { return 11 }
  invalid.badSignature = false
  invalid.badDigest = true
  if !run refused(home) |> Effect.provideMut<ReleaseSource>(&mut invalid) { return 12 }
  let store = run Path.join(home, "toolchains")
  let remaining = run FileSystem.listDirectory(&store)
  if List.length(&remaining) != 0 { return 13 }
  let mut source = Releases {badDigest: false, badSignature: false}
  let installed = run Install.install(home, b"1.2.3", Install.hostTarget(), WindowsRelease.key())
    |> Effect.provideMut<ReleaseSource>(&mut source)
  if !installed.changed { return 14 }
  let executable = run Toolchains.executable(home, b"1.2.3")
  let compiler = run FileSystem.readFile(&executable)
  if !same(Bytes.asSlice(&compiler), b"MZ fixture compiler\n") { return 15 }
  let extra = run Path.join(home, "toolchains/1.2.3/bin/silk.exe")
  if run FileSystem.exists(&extra) { return 16 }
  let again = run Install.install(home, b"1.2.3", Install.hostTarget(), WindowsRelease.key())
    |> Effect.provideMut<ReleaseSource>(&mut source)
  if again.changed { return 17 }
  let updated = run Install.updateSelf(home, b"0.0.0", false, Install.hostTarget(), WindowsRelease.key())
    |> Effect.provideMut<ReleaseSource>(&mut source)
  if !updated.changed { return 18 }
  return 0
}

effect fn fixture() -> i32 ! InstallError | FileError | OutOfMemoryError ? &mut Allocator {
  let executable = match move run WindowsHostPath.executable() {
    Option<Bytes>.Some {value} => run Path.fromBytes(Bytes.asSlice(&value))
    Option<Bytes>.None => { return 1 }
  }
  let bin = match move run WindowsPath.parent(&executable) {
    Option<Path>.Some {value} => move value
    Option<Path>.None => { return 2 }
  }
  let home = match move run WindowsPath.parent(&bin) {
    Option<Path>.Some {value} => move value
    Option<Path>.None => { return 3 }
  }
  let mut files = run MachineFileSystem.make()
  let mut host = WindowsHostFiles.at(b"/")
  return run check(&home) |> Effect.provideMut<FileSystem>(&mut files) |> Effect.provideMut<HostFiles>(&mut host)
}

pub effect fn main() -> i32 ! FileError | OutOfMemoryError | WriterError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let attempted = run Effect.result(fixture()) |> Effect.provideMut<Allocator>(&mut allocator)
  return match move attempted {
    Result<i32, InstallError | FileError | OutOfMemoryError>.Success {value} => value
    Result<i32, InstallError | FileError | OutOfMemoryError>.Failure {error} => match move error {
      InstallError failed => {
        let mut stderr = StderrWriter.make()
        run Writer.writeAll(Bytes.asSlice(&failed.message)) |> Effect.provideMut<Writer>(&mut stderr)
        return 100 + failed.status
      }
      FileError failed => { fail move failed }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}
}
