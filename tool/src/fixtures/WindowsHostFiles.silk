static if Intrinsic.targetOperatingSystem() == "windows" {
// Exercises real install publication against a loaded executable image. The runner checks the
// replacement bytes and the retained hard link independently, after this process exits.
import Install {HostFiles}
import WindowsHostFiles {WindowsHostFiles}
import silk.collections.bytes {Bytes}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.platform.windows.host_path as WindowsHostPath
import silk.platform.windows.path {WindowsPath}
import silk.system.filesystem {FileSystem, FileError, Path}
import silk.system.filesystem_machine {MachineFileSystem}

effect fn check() -> i32 ! FileError | OutOfMemoryError ? &mut Allocator | &mut FileSystem | &mut HostFiles {
  let current = match move run WindowsHostPath.executable() {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => { return 1 }
  }
  let executable = run Path.fromBytes(Bytes.asSlice(&current))
  let directory = match move run WindowsPath.parent(&executable) {
    Option<Path>.Some {value} => move value
    Option<Path>.None => { return 2 }
  }
  let previous = run Path.join(&directory, "previous.exe")
  if !run HostFiles.link(&executable, &previous) { return 3 }
  let fresh = run Path.join(&directory, "replacement.tmp")
  run FileSystem.createFile(&fresh, b"Windows image replacement\n")
  if !run HostFiles.markExecutable(&fresh) { return 4 }
  if !run HostFiles.rename(&fresh, &executable) { return 5 }
  let lock = run Path.join(&directory, "install.lock")
  if !run HostFiles.lock(&lock) { return 6 }
  run HostFiles.unlock()
  return 0
}

pub effect fn main() -> i32 ! FileError | OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut files = run MachineFileSystem.make() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut host = WindowsHostFiles.at(b"/")
  return run check() |> Effect.provideMut<FileSystem>(&mut files)
    |> Effect.provideMut<HostFiles>(&mut host) |> Effect.provideMut<Allocator>(&mut allocator)
}

}
