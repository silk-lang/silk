//! silk's own commands: `use`, `set` and `update`. `change` is the changeset package's.
//!
//! `silk use` installs Silk versions and chooses the machine's default, and never touches a project.
//! `silk set` is the only command that edits a project, and it installs the version it pins unless
//! `--no-install` is given. Every command runs without prompts, so agents, scripts and editors can
//! drive it. Results go to standard output, `--json` gives them a stable machine-readable shape,
//! and the exit status says what happened: 0 success, 1 a failed command, 2 a usage or configuration error, 3 the selected
//! toolchain is not installed, 4 a download failed, 5 a release failed verification. Commands that
//! would change nothing succeed without changing anything.

import Install as ToolchainInstall
import Manifests
import Toolchains as Toolchains { IgnoredPin, Origin, Selection, UnknownPin }
import tomledit.ManifestEdit as ManifestEdits { ManifestEditRefused }
import silk.cli.command { Command, CommandLine, Opt }
import silk.cli.parse { Cli, CliError, Parsed, Variable }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.system.filesystem { Path }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.text.string { String }
import silk.collections.slice { Slice }
import silk.num.u64
import silk.num.u8
import silk.num.usize

/// What a command runs with.
pub struct Context {
  /// The working directory.
  pub working: Path,

  /// `$SILK_HOME`, or `None` when no home directory is known.
  pub home: Option<Path>,

  /// The `SILK_TOOLCHAIN` value.
  pub environment: Option<Bytes>,

  /// The target whose release archives install, and the minisign public key they must be signed
  /// with: the host's and the release key, except in tests.
  pub target: &'static [u8],
  pub releaseKey: &'static [u8],

  /// The running silk's own version, which `silk update self` compares releases with.
  pub release: &'static [u8],

  /// The compiler `silkc` beside the running tool, as an unpacked release archive, Homebrew or
  /// mise lays them out. It is the release's own compiler, version `release`, and runs when
  /// nothing selects a version or the store lacks the selected one and `release` matches it.
  pub bundled: Option<Path>,

  /// Whether a command for the compiler installs the selected version when it is missing:
  /// `SILK_AUTO_INSTALL=1`, or `auto-install = true` in `settings.toml`.
  pub autoInstall: bool,
}

/// The exit status and the text for standard output and standard error.
pub struct Outcome {
  pub status: i32,
  pub output: Bytes,
  pub errors: Bytes,
}

/// The exit status when the selected toolchain is not installed.
pub const NOT_INSTALLED: i32 = 3

/// The commands the silk tool runs itself, as `silk --help` lists them after the overview of the
/// compiler the directory selects. That overview lists every other command, so the tool keeps no
/// list of the compiler's commands.
pub fn usage() -> &'static [u8] {
  return b"The silk tool runs these commands itself, and every other one in the compiler (silkc) of\nthe Silk version this directory selects (silk use which names it).\n\nSilk versions:\n  use                     Install the version this project pins\n  use <version>           Install a version and make it your default\n  use list [--json]       List installed versions\n  use which [--json]      Show the version this directory selects, and why\n  use uninstall <version> Remove an installed version\n  set <version>           Pin this project's silk-version and install it (--no-install: only pin)\n\nRelease notes (the [release] table of silk.toml):\n  change patch|minor|major \"Summary\" [--migration \"Guidance\"]\n                          Record a change for the next release\n  change status|version|release|snapshot|since|recover\n                          Plan, cut and query releases; silk change --help\n\nThe silk tool:\n  update self [--dev]     Update silk itself to the newest release\n\nOptions:\n  +<version>              Run one command with an installed version: silk +0.1.0 build\n  -h, --help              Show this help\n  -v, --version           Show the Silk version this directory selects\n\nA version is a release such as 0.1.0-dev.11, latest (the newest stable release) or dev\n(the newest release, dev releases included); `latest --dev` is the same as dev.\nThe project pin wins, then the default; SILK_TOOLCHAIN or +<version> override both.\nVersions live in $SILK_HOME/toolchains (default ~/.silk). SILK_AUTO_INSTALL=1, or\nauto-install = true in $SILK_HOME/settings.toml, installs a missing version when needed.\nExit status: 0 success, 1 failure, 2 usage or configuration error, 3 version not installed,\n4 download failed, 5 verification failed.\n"
}

/// Whether `word` is one of the tool's own commands rather than the compiler's.
pub fn owns(word: &[u8]) -> bool {
  return same(word, b"use") || same(word, b"set") || same(word, b"update") || same(word, b"change")
}

pub fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// Whether `left` and `right` differ by one edit: one byte changed, added or removed, or two
// neighbours swapped.
fn oneEdit(left: &[u8], right: &[u8]) -> bool {
  if same(left, right) {
    return false
  }
  if left.length == right.length {
    let mut first = usize.ZERO
    while left[first] == right[first] {
      first = first + usize.ONE
    }
    let next = first + usize.ONE
    let rest = left.length - next
    if same(Slice.view<u8>(left, next, rest), Slice.view<u8>(right, next, rest)) {
      return true
    }
    return next < left.length && left[first] == right[next] && left[next] == right[first]
      && same(
        Slice.view<u8>(left, next + usize.ONE, rest - usize.ONE),
        Slice.view<u8>(right, next + usize.ONE, rest - usize.ONE),
      )
  }
  if left.length + usize.ONE == right.length {
    return oneEdit(right, left)
  }
  if left.length != right.length + usize.ONE {
    return false
  }
  let mut first = usize.ZERO
  while first < right.length && left[first] == right[first] {
    first = first + usize.ONE
  }
  return same(
    Slice.view<u8>(left, first + usize.ONE, left.length - first - usize.ONE),
    Slice.view<u8>(right, first, right.length - first),
  )
}

/// The silk command a mistyped first word most likely meant, such as `use` for `uze` or `change` for
/// `changes`: one edit away from `use`, `set`, `update` or `change`. `None` sends the word on to the
/// compiler, which answers unknown commands itself.
pub fn suggestion(word: &[u8]) -> Option<&'static [u8]> {
  let own: [&'static [u8]; 4] = [b"use", b"set", b"update", b"change"]
  let mut at = usize.ZERO
  while at < own.length {
    if oneEdit(word, own[at]) {
      return Option<&'static [u8]>.some(own[at])
    }
    at = at + usize.ONE
  }
  return Option<&'static [u8]>.none()
}

/// Whether `word` is, or is one edit away from, a command that `overview` lists. `overview` is a
/// compiler's `--help` text, which lists each command on a line of two spaces, the command, and
/// its summary. A mistyped word near one of them, such as `tset`, belongs to the compiler even when
/// [`suggestion`] has a silk command for it.
pub fn nearListed(word: &[u8], overview: &[u8]) -> bool {
  let mut start = usize.ZERO
  while start < overview.length {
    let mut end = start
    while end < overview.length && overview[end] != 10 {
      end = end + usize.ONE
    }
    let indent = usize.add(0, 2)
    if end - start > indent && overview[start] == 32 && overview[start + usize.ONE] == 32
      && overview[start + indent] != 32 {
      let mut name = start + indent
      while name < end && overview[name] != 32 {
        name = name + usize.ONE
      }
      let listed = Slice.view<u8>(overview, start + indent, name - start - indent)
      if same(word, listed) || oneEdit(word, listed) {
        return true
      }
    }
    start = end + usize.ONE
  }
  return false
}

// Appends `text` as a JSON string, escaping quotes, backslashes and control bytes and keeping
// every other byte as written.
pub effect fn appendString(output: &mut Bytes, text: &[u8]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let digits = b"0123456789abcdef"
  run Bytes.append(&mut output.*, b"\"")
  let mut at = usize.ZERO
  while at < text.length {
    let byte = text[at]
    if byte == 34 || byte == 92 {
      let escaped: [u8; 2] = [92, byte]
      run Bytes.append(&mut output.*, &escaped)
    } else if byte < 32 {
      let value = u8.toU64(byte)
      let high = u64.toUsize(u64.divide(value, 16))
      let low = u64.toUsize(u64.remainder(value, 16))
      let escaped: [u8; 6] = [92, 117, 48, 48, digits[high], digits[low]]
      run Bytes.append(&mut output.*, &escaped)
    } else {
      run Bytes.append(&mut output.*, &[byte])
    }
    at = at + usize.ONE
  }
  return run Bytes.append(&mut output.*, b"\"")
}

effect fn outcome(status: i32, output: &[u8], errors: &[u8]) -> Outcome
  ! OutOfMemoryError
  ? &mut Allocator {
  return Outcome { status: status, output: run Bytes.copy(output), errors: run Bytes.copy(errors) }
}

effect fn usageError(command: &[u8], detail: &[u8]) -> Outcome
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut errors = run Bytes.copy(b"silk ")
  run Bytes.append(&mut errors, command)
  run Bytes.append(&mut errors, b": ")
  run Bytes.append(&mut errors, detail)
  run Bytes.append(&mut errors, b"\nRun `silk --help` for the commands.\n")
  return Outcome { status: 2, output: Bytes.make(), errors: move errors }
}

/// The outcome when no toolchain directory is known: SILK_HOME is relative, or HOME is unset.
pub effect fn noHome() -> Outcome
  ! OutOfMemoryError
  ? &mut Allocator {
  return run outcome(
    1,
    b"",
    b"silk: cannot find the toolchain directory; set SILK_HOME to an absolute path, or HOME to an existing directory\n",
  )
}

/// Where the selection came from, in words: `package silk-version in /p/silk.toml`.
pub effect fn because(selected: &Selection, text: &mut Bytes) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  match selected.origin {
    Origin.CommandLine => run Bytes.append(&mut text.*, b"selected with +<version>")
    Origin.Environment => run Bytes.append(&mut text.*, b"selected by SILK_TOOLCHAIN")
    Origin.Workspace => run Bytes.append(&mut text.*, b"workspace silk-version")
    Origin.Package => run Bytes.append(&mut text.*, b"package silk-version")
    Origin.Members => run Bytes.append(&mut text.*, b"member silk-version")
    Origin.Default => run Bytes.append(&mut text.*, b"default in settings.toml")
    Origin.Nothing => run Bytes.append(&mut text.*, b"nothing selects a version")
  }
  if let Option<Path>.Some { value } = &selected.manifest {
    run Bytes.append(&mut text.*, b" in ")
    run Bytes.append(&mut text.*, Path.rawBytes(&value))
  }
}

/// Appends the note that a member pins its own version beside the workspace's, which the
/// compiler refuses since the workspace's pin covers its members, when `selected` has one.
pub effect fn ignoredNote(selected: &Selection, text: &mut Bytes) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if let Option<IgnoredPin>.Some { value } = &selected.ignored {
    run Bytes.append(&mut text.*, b"silk: note: ")
    run Bytes.append(&mut text.*, Path.rawBytes(&value.manifest))
    run Bytes.append(&mut text.*, b" sets silk-version = \"")
    run Bytes.append(&mut text.*, Bytes.asSlice(&value.version))
    run Bytes.append(&mut text.*, b"\", which Silk refuses: the ")
    run because(selected, &mut text.*)
    run Bytes.append(&mut text.*, b" (")
    run Bytes.append(&mut text.*, Bytes.asSlice(&selected.version))
    run Bytes.append(
      &mut text.*,
      b") covers its members.\nRemove the member's silk-version, or pin the whole workspace with: silk set <version>\n",
    )
  }
}

/// The outcome for a SILK_TOOLCHAIN that is set but names no version, which is a usage error like
/// a malformed `+<version>`; `None` when it is unset, empty or a version.
pub effect fn badEnvironment(context: &Context) -> Option<Outcome>
  ! OutOfMemoryError
  ? &mut Allocator {
  if let Option<Bytes>.Some { value } = &context.environment {
    let written = Bytes.asSlice(&value)
    if written.length > usize.ZERO && !Manifests.isSemanticVersion(written) {
      let mut errors = run Bytes.copy(b"silk: SILK_TOOLCHAIN=")
      run Bytes.append(&mut errors, written)
      run Bytes.append(
        &mut errors,
        b" is not a Silk version; set it to a semantic version such as 0.1.0-dev.11, or unset it\n",
      )
      return Option<Outcome>.some(Outcome { status: 2, output: Bytes.make(), errors: move errors })
    }
  }
  return Option<Outcome>.none()
}

/// The command that installs the selected version: `silk use` for a project pin, which installs
/// it without changing the default, and `silk use <version>` otherwise.
pub effect fn installCommand(selected: &Selection) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  if selected.origin == Origin.Workspace || selected.origin == Origin.Package
    || selected.origin == Origin.Members {
    return run Bytes.copy(b"silk use")
  }
  let mut command = run Bytes.copy(b"silk use ")
  run Bytes.append(&mut command, Bytes.asSlice(&selected.version))
  return move command
}

// The words after a subcommand: `--json`, with `dev` also `--dev`, and the operands.
struct Words {
  json: bool,
  dev: bool,
  operands: List<Bytes>,
}

// The words of a command that takes `--dev`.
struct DevWords {
  pub json: bool,
  pub dev: bool,
  pub operands: List<Bytes>,
}

impl CommandLine for DevWords {
  static fn command() -> Command<DevWords> {
    return Command<DevWords>.make("silk", "")
      |> Command.option("json", Opt.about("Write the result as JSON"))
      |> Command.option("dev", Opt.about("With latest, the newest release, dev releases included"))
      |> Command.arg("operands", Opt.plain())
  }
}

// The words of a command without `--dev`.
struct PlainWords {
  pub json: bool,
  pub operands: List<Bytes>,
}

impl CommandLine for PlainWords {
  static fn command() -> Command<PlainWords> {
    return Command<PlainWords>.make("silk", "")
      |> Command.option("json", Opt.about("Write the result as JSON"))
      |> Command.arg("operands", Opt.plain())
  }
}

// `silk set <version> [--dev] [--json] [--no-install]`, read after `set`.
struct SetWords {
  pub json: bool,
  pub dev: bool,
  pub noInstall: bool,
  pub operands: List<Bytes>,
}

impl CommandLine for SetWords {
  static fn command() -> Command<SetWords> {
    return Command<SetWords>.make("silk", "")
      |> Command.option("json", Opt.about("Write the result as JSON"))
      |> Command.option("dev", Opt.about("With latest, the newest release, dev releases included"))
      |> Command.option(
        "noInstall",
        Opt.about("Only edit the manifest; do not install the pinned version"),
      )
      |> Command.arg("operands", Opt.plain())
  }
}

// `silk update self [--dev]`, read from `self` on.
struct SelfUpdate {
  pub dev: bool,
}

impl CommandLine for SelfUpdate {
  static fn command() -> Command<SelfUpdate> {
    return Command<SelfUpdate>.make("silk update self", "")
      |> Command.option("dev", Opt.about("Update to the newest release, dev releases included"))
  }
}

// `arguments` after a first word that the parser skips, as the program name.
effect fn line(arguments: &[Bytes]) -> List<Bytes>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut listed = List<Bytes>.make()
  run List<Bytes>.append(&mut listed, Bytes.make())
  let mut at = usize.ZERO
  while at < arguments.length {
    run List<Bytes>.append(&mut listed, run Bytes.copy(Bytes.asSlice(&arguments[at])))
    at = at + usize.ONE
  }
  return move listed
}

// The usage error of `command` that `error` describes, in `silk.cli`'s words.
effect fn refusal(command: &[u8], error: &CliError) -> Outcome
  ! OutOfMemoryError
  ? &mut Allocator {
  let text = run Cli.message(error)
  return run usageError(command, String.ownedUtf8Bytes(&text))
}

// What `parsed` gives, or the usage error of `command` it describes.
effect fn accepted<T>(command: &[u8], parsed: Parsed<T>) -> Result<T, Outcome>
  ! OutOfMemoryError
  ? &mut Allocator {
  return match move parsed {
    Parsed<T>.Run { value } => Result<T, Outcome>.succeed(move value)
    Parsed<T>.Failed { error, .. } => Result<T, Outcome>.failResult(run refusal(command, &error))

    // The tool answers `--help` before a command reads its words, and no command has `--version`.
    Parsed<T>.Help { .. } => Result<T, Outcome>.failResult(
      run usageError(command, b"`--help` stands alone"),
    )
    Parsed<T>.Version => Result<T, Outcome>.failResult(
      run usageError(command, b"unknown option --version"),
    )
  }
}

effect fn words(command: &[u8], arguments: &[Bytes], dev: bool) -> Result<Words, Outcome>
  ! OutOfMemoryError
  ? &mut Allocator {
  let listed = run line(arguments)
  let none: [Variable<'static>; 0] = []
  if dev {
    let parsed = run Cli.parseBytes<DevWords>(List<Bytes>.asSlice(&listed), &none)
    return match move run accepted<DevWords>(command, move parsed) {
      Result<DevWords, Outcome>.Success { value } => Result<Words, Outcome>.succeed(
        Words { json: value.json, dev: value.dev, operands: move value.operands },
      )
      Result<DevWords, Outcome>.Failure { error } => Result<Words, Outcome>.failResult(move error)
    }
  }
  let parsed = run Cli.parseBytes<PlainWords>(List<Bytes>.asSlice(&listed), &none)
  return match move run accepted<PlainWords>(command, move parsed) {
    Result<PlainWords, Outcome>.Success { value } => Result<Words, Outcome>.succeed(
      Words { json: value.json, dev: false, operands: move value.operands },
    )
    Result<PlainWords, Outcome>.Failure { error } => Result<Words, Outcome>.failResult(move error)
  }
}

// The selection for the working directory, or the outcome that reports a pin this tool cannot
// read.
/// The outcome for a pin this tool cannot read: a configuration error naming `silk update self`.
pub effect fn unknownPin(unknown: &UnknownPin) -> Outcome
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut errors = run Bytes.copy(b"silk: ")
  run Bytes.append(&mut errors, Path.rawBytes(&unknown.manifest))
  run Bytes.append(&mut errors, b": ")
  run Bytes.append(&mut errors, Bytes.asSlice(&unknown.detail))
  run Bytes.append(&mut errors, b".\n")
  run Bytes.append(&mut errors, unknown.hint)
  run Bytes.append(&mut errors, b"\n")
  return Outcome { status: 2, output: Bytes.make(), errors: move errors }
}

/// Whether `arguments`, the words after `use`, name a subcommand that needs no download.
pub fn local(arguments: &[Bytes]) -> bool {
  if arguments.length == usize.ZERO {
    return false
  }
  let first = Bytes.asSlice(&arguments[usize.ZERO])
  return same(first, b"list") || same(first, b"which") || same(first, b"uninstall")
}

pub effect fn appendFlag(output: &mut Bytes, name: &[u8], value: bool) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run Bytes.append(&mut output.*, b",\"")
  run Bytes.append(&mut output.*, name)
  if value {
    run Bytes.append(&mut output.*, b"\":true")
  } else {
    run Bytes.append(&mut output.*, b"\":false")
  }
}

// Appends one toolchain to the list output.
pub effect fn entry(
  output: &mut Bytes,
  json: bool,
  first: bool,
  version: &[u8],
  path: &[u8],
  selected: bool,
  pinned: bool,
  standard: bool,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if json {
    if !first {
      run Bytes.append(&mut output.*, b",")
    }
    run Bytes.append(&mut output.*, b"{\"version\":")
    run appendString(&mut output.*, version)
    run Bytes.append(&mut output.*, b",\"path\":")
    run appendString(&mut output.*, path)
    run appendFlag(&mut output.*, b"selected", selected)
    run appendFlag(&mut output.*, b"pinned", pinned)
    run appendFlag(&mut output.*, b"default", standard)
    run Bytes.append(&mut output.*, b"}")
    return ()
  }
  if selected {
    run Bytes.append(&mut output.*, b"* ")
  } else {
    run Bytes.append(&mut output.*, b"  ")
  }
  run Bytes.append(&mut output.*, version)
  let mut tags = Bytes.make()
  if pinned {
    run Bytes.append(&mut tags, b", pinned here")
  }
  if standard {
    run Bytes.append(&mut tags, b", default")
  }
  if Bytes.length(&tags) > usize.ZERO {
    let written = Bytes.asSlice(&tags)
    run Bytes.append(&mut output.*, b"  (")
    run Bytes.append(
      &mut output.*,
      Slice.view<u8>(written, usize.add(0, 2), written.length - usize.add(0, 2)),
    )
    run Bytes.append(&mut output.*, b")")
  }
  run Bytes.append(&mut output.*, b"  ")
  run Bytes.append(&mut output.*, path)
  run Bytes.append(&mut output.*, b"\n")
}

// `requested` with `--dev` applied: `latest --dev` is the newest release of any kind, the same as
// `dev`; `--dev` with a version is a usage error.
effect fn withDev(command: &[u8], requested: Bytes, dev: bool) -> Result<Bytes, Outcome>
  ! OutOfMemoryError
  ? &mut Allocator {
  if !dev {
    return Result<Bytes, Outcome>.succeed(move requested)
  }
  if same(Bytes.asSlice(&requested), b"latest") || same(Bytes.asSlice(&requested), b"dev") {
    return Result<Bytes, Outcome>.succeed(run Bytes.copy(b"dev"))
  }
  return Result<Bytes, Outcome>.failResult(run usageError(command, b"--dev only applies to latest"))
}

// The one version operand of `command`, checked: an alias or a release other than `0.0.0`.
effect fn requestedVersion(command: &[u8], given: &Words) -> Result<Bytes, Outcome>
  ! OutOfMemoryError
  ? &mut Allocator {
  let operands = List<Bytes>.asSlice(&given.operands)
  if operands.length != usize.ONE {
    return Result<Bytes, Outcome>.failResult(run usageError(command, b"takes one version"))
  }
  let version = match move run withDev(
    command,
    run Bytes.copy(Bytes.asSlice(&operands[usize.ZERO])),
    given.dev,
  ) {
    Result<Bytes, Outcome>.Success { value } => move value
    Result<Bytes, Outcome>.Failure { error } => {
      return Result<Bytes, Outcome>.failResult(move error)
    }
  }
  let alias = ToolchainInstall.isAlias(Bytes.asSlice(&version))
  if !alias && Toolchains.unpinned(Bytes.asSlice(&version)) {
    return Result<Bytes, Outcome>.failResult(
      run usageError(
        command,
        b"0.0.0 is the version of a compiler built from source and pins nothing; name a release such as 0.1.0-dev.11, or latest or dev",
      ),
    )
  }
  if !alias && !Manifests.isSemanticVersion(Bytes.asSlice(&version)) {
    return Result<Bytes, Outcome>.failResult(
      run usageError(
        command,
        b"the version must be latest, dev or a semantic version such as 0.1.0-dev.11",
      ),
    )
  }
  return Result<Bytes, Outcome>.succeed(move version)
}

// `version` without its `+` build metadata: `0.2.0+abc` is `0.2.0`.
pub fn withoutMetadata(version: &[u8]) -> &[u8] {
  let mut end = usize.ZERO
  while end < version.length && version[end] != 43 {
    end = end + usize.ONE
  }
  return Slice.view<u8>(version, usize.ZERO, end)
}

// `text`, the member manifest at `manifest`, without its `[package].silk-version`, or the outcome
// that reports why it cannot be edited.
pub effect fn unpin(manifest: &Path, text: &[u8]) -> Result<Bytes, Outcome>
  ! OutOfMemoryError
  ? &mut Allocator {
  return match move run Effect.result(
    ManifestEdits.removeValue(text, b"package", b"silk-version"),
  ) {
    Result<Bytes, ManifestEditRefused | OutOfMemoryError>.Success { value } => Result<
      Bytes,
      Outcome
    >.succeed(move value)
    Result<Bytes, ManifestEditRefused | OutOfMemoryError>.Failure { error } => match move error {
      ManifestEditRefused refused => {
        let mut errors = run Bytes.copy(b"silk set: cannot edit ")
        run Bytes.append(&mut errors, Path.rawBytes(manifest))
        run Bytes.append(&mut errors, b": ")
        run Bytes.append(&mut errors, Bytes.asSlice(&refused.detail))
        run Bytes.append(&mut errors, b"\n")
        return Result<Bytes, Outcome>.failResult(
          Outcome { status: 1, output: Bytes.make(), errors: move errors },
        )
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

// `text`, the manifest at `manifest`, with `[table].silk-version` set to `quoted`, or the outcome
// that reports why it cannot be edited.
pub effect fn edit(manifest: &Path, text: &[u8], table: &[u8], quoted: &[u8]) -> Result<Bytes, Outcome>
  ! OutOfMemoryError
  ? &mut Allocator {
  return match move run Effect.result(
    ManifestEdits.setValue(text, table, b"silk-version", quoted),
  ) {
    Result<Bytes, ManifestEditRefused | OutOfMemoryError>.Success { value } => Result<
      Bytes,
      Outcome
    >.succeed(move value)
    Result<Bytes, ManifestEditRefused | OutOfMemoryError>.Failure { error } => match move error {
      ManifestEditRefused refused => {
        let mut errors = run Bytes.copy(b"silk set: cannot edit ")
        run Bytes.append(&mut errors, Path.rawBytes(manifest))
        run Bytes.append(&mut errors, b": ")
        run Bytes.append(&mut errors, Bytes.asSlice(&refused.detail))
        run Bytes.append(&mut errors, b"\n")
        return Result<Bytes, Outcome>.failResult(
          Outcome { status: 1, output: Bytes.make(), errors: move errors },
        )
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

/// `silk update <what>`, with `arguments` after `update`. `self` updates the tool itself;
/// `silk` changes nothing and names the commands that move Silk versions.
pub effect fn update(arguments: &[Bytes]) -> Outcome
  ! OutOfMemoryError
  ? &mut Allocator {
  if arguments.length == usize.ZERO {
    return run usageError(b"update", b"name what to update: silk update self")
  }
  let what = Bytes.asSlice(&arguments[usize.ZERO])
  if same(what, b"silk") {
    return run outcome(
      2,
      b"",
      b"silk update silk: Silk versions are not updated in place.\nTo install the newest Silk as your default: silk use latest\nTo move this project to it and install it: silk set latest\n",
    )
  }
  let mut detail = run Bytes.copy(b"unknown target `")
  run Bytes.append(&mut detail, what)
  run Bytes.append(&mut detail, b"`; silk update self updates silk")
  return run usageError(b"update", Bytes.asSlice(&detail))
}

/// Whether `silk update` with `arguments` (after `update`) updates silk itself, which needs the
/// release source.
pub fn updatesSelf(arguments: &[Bytes]) -> bool {
  return arguments.length > usize.ZERO && same(Bytes.asSlice(&arguments[usize.ZERO]), b"self")
}


/// Whether one of `arguments` is `--help` or `-h`.
pub fn asksHelp(arguments: &[Bytes]) -> bool {
  let mut at = usize.ZERO
  while at < arguments.length {
    let word = Bytes.asSlice(&arguments[at])
    if same(word, b"--help") || same(word, b"-h") {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

/// What the words of one command line ask the tool to do.
pub enum Kind {
  /// Words that are no command, such as an unknown option or a missing version.
  Misuse,
  /// `silk use <version>`.
  Use,
  /// `silk use latest` or `silk use dev`.
  UseNewest,
  /// `silk use`.
  UsePinned,
  /// `silk use list`.
  List,
  /// `silk use which`.
  Which,
  /// `silk use uninstall <version>`.
  Uninstall,
  /// `silk set <version>`.
  Set,
  /// `silk set latest` or `silk set dev`.
  SetNewest,
  /// `silk update self`.
  UpdateSelf,
  /// A command for the compiler, such as `silk build`.
  Run,
  /// `silk --help`, or `silk` alone.
  Help,
  /// A first word that is one edit away from a command of the tool, such as `uze`.
  Near,
}

/// One command line as the tool reads it, before it looks at the computer.
pub struct Request {
  pub kind: Kind,

  /// The version the words name: the operand of `use`, `use uninstall` and `set`, or the text
  /// after the `+` of a command for the compiler. Empty when the words name none.
  pub version: Bytes,

  /// Whether a command for the compiler starts with `+<version>`, which the compiler does not
  /// receive.
  pub plus: bool,

  /// For `UseNewest` and `SetNewest`: true for `latest`, the newest stable release, and false
  /// for `dev`, the newest release of any kind.
  pub stable: bool,

  /// For `UpdateSelf`: whether `--dev` was given, which takes the newest release of any kind.
  pub dev: bool,

  /// Whether `--json` was given.
  pub json: bool,

  /// For `Set` and `SetNewest`: false when `--no-install` was given.
  pub install: bool,

  /// For `Help`: whether the command line was `silk` alone.
  pub bare: bool,

  /// For `Near`: the first word, and the command of the tool it most likely meant.
  pub word: Bytes,
  pub meant: &'static [u8],

  /// For `Misuse`: what is wrong with the words, as the text for standard error.
  pub complaint: Bytes,
}

effect fn plain(kind: Kind) -> Request
  ! OutOfMemoryError
  ? &mut Allocator {
  return Request {
    kind: kind,
    version: Bytes.make(),
    plus: false,
    stable: false,
    dev: false,
    json: false,
    install: true,
    bare: false,
    word: Bytes.make(),
    meant: b"",
    complaint: Bytes.make(),
  }
}

effect fn misuse(complaint: Outcome) -> Request
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut request = run plain(Kind.Misuse)
  request.complaint = move complaint.errors
  return move request
}

// `silk update <what>`, with `arguments` after `update`.
effect fn readUpdate(arguments: &[Bytes]) -> Request
  ! OutOfMemoryError
  ? &mut Allocator {
  if !updatesSelf(arguments) {
    return run misuse(run update(arguments))
  }
  let none: [Variable<'static>; 0] = []
  let parsed = run Cli.parseBytes<SelfUpdate>(arguments, &none)
  return match move run accepted<SelfUpdate>(b"update", move parsed) {
    Result<SelfUpdate, Outcome>.Success { value } => {
      let mut request = run plain(Kind.UpdateSelf)
      request.dev = value.dev
      return move request
    }
    Result<SelfUpdate, Outcome>.Failure { error } => run misuse(move error)
  }
}

// `silk use list`, `which` and `uninstall`, with `arguments` after `use`.
effect fn readLocal(arguments: &[Bytes]) -> Request
  ! OutOfMemoryError
  ? &mut Allocator {
  let name = Bytes.asSlice(&arguments[usize.ZERO])
  let mut command = run Bytes.copy(b"use ")
  run Bytes.append(&mut command, name)
  let rest = Slice.view<Bytes>(arguments, usize.ONE, arguments.length - usize.ONE)
  let given = match move run words(Bytes.asSlice(&command), rest, false) {
    Result<Words, Outcome>.Success { value } => move value
    Result<Words, Outcome>.Failure { error } => {
      return run misuse(move error)
    }
  }
  let operands = List<Bytes>.asSlice(&given.operands)
  if same(name, b"list") || same(name, b"which") {
    if operands.length != usize.ZERO {
      return run misuse(run usageError(Bytes.asSlice(&command), b"takes no operands"))
    }
    let mut request = run plain(if same(name, b"list") { Kind.List } else { Kind.Which })
    request.json = given.json
    return move request
  }
  if operands.length != usize.ONE || given.json {
    return run misuse(run usageError(Bytes.asSlice(&command), b"takes one version"))
  }
  let version = Bytes.asSlice(&operands[usize.ZERO])
  if !Manifests.isSemanticVersion(version) {
    return run misuse(
      run usageError(b"use uninstall", b"the version must be a semantic version such as 0.1.0-dev.11"),
    )
  }
  let mut request = run plain(Kind.Uninstall)
  request.version = run Bytes.copy(version)
  return move request
}

// `request` for the version `version`: `newest` when it is `latest` or `dev`, else `exact`.
effect fn versioned(exact: Kind, newest: Kind, version: Bytes, json: bool, install: bool) -> Request
  ! OutOfMemoryError
  ? &mut Allocator {
  let alias = ToolchainInstall.isAlias(Bytes.asSlice(&version))
  let mut request = run plain(if alias { newest } else { exact })
  request.stable = same(Bytes.asSlice(&version), b"latest")
  request.version = move version
  request.json = json
  request.install = install
  return move request
}

// `silk use [version] [--dev] [--json]`, with `arguments` after `use`.
effect fn readUse(arguments: &[Bytes]) -> Request
  ! OutOfMemoryError
  ? &mut Allocator {
  let given = match move run words(b"use", arguments, true) {
    Result<Words, Outcome>.Success { value } => move value
    Result<Words, Outcome>.Failure { error } => {
      return run misuse(move error)
    }
  }
  if List.length(&given.operands) == usize.ZERO {
    if given.dev {
      return run misuse(run usageError(b"use", b"--dev only applies to latest"))
    }
    let mut request = run plain(Kind.UsePinned)
    request.json = given.json
    return move request
  }
  return match move run requestedVersion(b"use", &given) {
    Result<Bytes, Outcome>.Success { value } => run versioned(
      Kind.Use,
      Kind.UseNewest,
      move value,
      given.json,
      true,
    )
    Result<Bytes, Outcome>.Failure { error } => run misuse(move error)
  }
}

// `silk set <version> [--dev] [--json] [--no-install]`, with `arguments` after `set`.
effect fn readSet(arguments: &[Bytes]) -> Request
  ! OutOfMemoryError
  ? &mut Allocator {
  let typed = run line(arguments)
  let none: [Variable<'static>; 0] = []
  let parsed = run Cli.parseBytes<SetWords>(List<Bytes>.asSlice(&typed), &none)
  let read = match move run accepted<SetWords>(b"set", move parsed) {
    Result<SetWords, Outcome>.Success { value } => move value
    Result<SetWords, Outcome>.Failure { error } => {
      return run misuse(move error)
    }
  }
  let install = !read.noInstall
  let json = read.json
  let given = Words { json: read.json, dev: read.dev, operands: move read.operands }
  return match move run requestedVersion(b"set", &given) {
    Result<Bytes, Outcome>.Success { value } => run versioned(
      Kind.Set,
      Kind.SetNewest,
      move value,
      json,
      install,
    )
    Result<Bytes, Outcome>.Failure { error } => run misuse(move error)
  }
}

/// Reads `arguments`, the command line without the name of the program.
///
/// A usage error is a `Misuse` with the complaint to print, so nothing here looks at the
/// computer. `silk change` is not read here: the changeset package reads its own words.
pub effect fn read(arguments: &[Bytes]) -> Request
  ! OutOfMemoryError
  ? &mut Allocator {
  if arguments.length == usize.ZERO {
    let mut help = run plain(Kind.Help)
    help.bare = true
    return move help
  }
  let first = Bytes.asSlice(&arguments[usize.ZERO])
  let rest = Slice.view<Bytes>(arguments, usize.ONE, arguments.length - usize.ONE)

  // The overview lists the selected compiler's commands too, and `silk help <command>` of a
  // compiler command is the compiler's. `silk use --help` and the like print the same overview.
  let helps = same(first, b"--help") || same(first, b"-h")
    || (same(first, b"help") && (rest.length == usize.ZERO || owns(Bytes.asSlice(&rest[usize.ZERO]))))
  if helps || (owns(first) && asksHelp(rest)) {
    return run plain(Kind.Help)
  }
  if same(first, b"update") {
    return run readUpdate(rest)
  }
  if same(first, b"use") {
    if local(rest) {
      return run readLocal(rest)
    }
    return run readUse(rest)
  }
  if same(first, b"set") {
    return run readSet(rest)
  }

  // Commands the compiler had before the tool took them over.
  if same(first, b"toolchain") {
    return run misuse(
      run outcome(
        2,
        b"",
        b"silk: `silk toolchain` was replaced: `silk use` installs and lists versions, `silk use which` shows the selected one, and `silk set` pins a project.\nRun `silk --help` for the commands.\n",
      ),
    )
  }
  if same(first, b"changes") {
    return run misuse(
      run outcome(
        2,
        b"",
        b"silk: `silk changes` was replaced by `silk change`.\nRun `silk change --help` for its commands.\n",
      ),
    )
  }
  if let Option<&'static [u8]>.Some { value: meant } = suggestion(first) {
    let mut near = run plain(Kind.Near)
    near.word = run Bytes.copy(first)
    near.meant = meant
    return move near
  }
  let mut forwarded = run plain(Kind.Run)
  if first.length >= usize.add(0, 2) && first[usize.ZERO] == 43 {
    forwarded.plus = true
    forwarded.version = run Bytes.copy(Slice.view<u8>(first, usize.ONE, first.length - usize.ONE))
  }
  return move forwarded
}
