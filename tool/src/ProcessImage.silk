//! Replacing silk's process with the compiler it forwards a command to.
//!
//! The compiler inherits standard input, output and error, the environment and the working
//! directory, so it runs exactly as if it had been started directly, and its exit status or
//! terminating signal is the command's own. `silk.system.child_process` closes a child's input, starts it
//! with an empty environment and captures its output, so this boundary calls POSIX `execv`.

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.system.filesystem { Path }
import silk.mem.pointer { Pointer }
import silk.num.usize
import silk.collections.list { List }

unsafe extern "C" fn execv(
  path: ?[*] const u8,
  arguments: ?[*] const ?[*] const u8
) -> i32 with Intrinsic .foreign (noCapture: ("path", "arguments"))

unsafe extern "C" fn setenv(
  name: ?[*] const u8,
  value: ?[*] const u8,
  overwrite: i32
) -> i32 with Intrinsic .foreign (noCapture: ("name", "value"))

/// The program could not replace this process: `execv` refused it, or an argument contains NUL.
pub struct ReplacementFailure {}

fn containsNul(value: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < value.length {
    if value[at] == 0 {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

effect fn terminated(value: &[u8]) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut copy = run Bytes.copy(value)
  let ending: [u8; 1] = [0]
  run Bytes.append(&mut copy, &ending)
  return move copy
}

fn nullBytes() -> ?[*] const u8 {
  unsafe {
    return Intrinsic.pointerRequalify<?*mut u8, ?[*] const u8>(Pointer.null<u8>())
  }
}

/// Sets the environment variable `name` to `value` for this process and the programs that replace
/// it. Returns false when either contains NUL or the variable could not be set.
pub effect fn setVariable(name: &[u8], value: &[u8]) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  if containsNul(name) || containsNul(value) {
    return false
  }
  let terminatedName = run terminated(name)
  let terminatedValue = run terminated(value)
  let status = unsafe setenv(
    Pointer.fromSlice<u8>(Bytes.asSlice(&terminatedName)),
    Pointer.fromSlice<u8>(Bytes.asSlice(&terminatedValue)),
    1,
  )
  return status == 0
}

/// Replaces this process with `program`, passing its path as argument zero and then `arguments`
/// unchanged. It returns only when the program could not start.
pub effect fn replace(program: &Path, arguments: &[Bytes]) -> ReplacementFailure
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut owned = List<Bytes>.make()
  run List<Bytes>.append(&mut owned, run terminated(Path.rawBytes(program)))
  let mut at = usize.ZERO
  while at < arguments.length {
    let argument = Bytes.asSlice(&arguments[at])
    if containsNul(argument) {
      return ReplacementFailure {}
    }
    run List<Bytes>.append(&mut owned, run terminated(argument))
    at = at + usize.ONE
  }
  let entries = List<Bytes>.asSlice(&owned)
  let mut pointers = List<?[*] const u8>.make()
  at = usize.ZERO
  while at < entries.length {
    run List<
      ?[*] const u8
    >.append(&mut pointers, Pointer.fromSlice<u8>(Bytes.asSlice(&entries[at])))
    at = at + usize.ONE
  }
  run List<?[*] const u8>.append(&mut pointers, nullBytes())
  let refused = unsafe execv(
    Pointer.fromSlice<u8>(Bytes.asSlice(&entries[usize.ZERO])),
    Pointer.fromSlice<?[*] const u8>(List<?[*] const u8>.asSlice(&pointers)),
  )
  return ReplacementFailure {}
}
