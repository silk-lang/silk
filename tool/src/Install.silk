//! The pieces of an install of a released toolchain into `$SILK_HOME/toolchains/<version>`.
//!
//! A release publishes `silk-<version>-<target>.zip` on Windows or `.tar.gz` elsewhere and its
//! minisign signature. The archive must carry the release key's signature with the trusted comment
//! `silk v<version> <archive>`, so a signature cannot vouch for another release or file. The
//! signature covers every byte of the archive, its compiler `bin/silkc` (`bin/silkc.exe` on
//! Windows) included. The archive unpacks into a hidden directory beside the store, which is
//! renamed into place only once everything checks out, so an interrupted install never leaves a
//! toolchain behind.
//!
//! Each function here is one step. The machine of the `flows` package says which step comes
//! when, and `Driver` calls them.

import silk.crypto.minisign as Minisign { MinisignError, MinisignKey }
import ReleaseArchive as ReleaseArchive { ArchiveError, ArchiveMember, ArchiveReader }
import Toolchains
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.system.filesystem { DirectoryEntry, FileError, FileSystem, Path }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.num.u8
import silk.num.usize

/// The exit status when a release cannot be downloaded.
pub const NETWORK: i32 = 4

/// The exit status when a release fails verification.
pub const VERIFICATION: i32 = 5

/// Why an install stopped, with the exit status the command reports.
pub struct InstallError {
  pub status: i32,
  pub message: Bytes,
}

/// Where releases come from: GitHub, or a mirror directory.
pub service ReleaseSource {
  /// The full versions of the published releases, without the tag's leading `v`.
  effect fn releases() -> List<Bytes>
  ! InstallError | OutOfMemoryError ? &mut ReleaseSource | &mut Allocator

  /// The bytes of the asset `name` of the release `version`.
  effect fn asset(version: &[u8], name: &[u8]) -> Bytes
  ! InstallError | OutOfMemoryError ? &mut ReleaseSource | &mut Allocator
}

/// The file operations `FileSystem` does not offer.
pub service HostFiles {
  /// Sets mode 0755 on the file or directory at `path`; false when that fails.
  effect fn markExecutable(path: &Path) -> bool ! OutOfMemoryError ? &mut HostFiles | &mut Allocator

  /// Renames `from` to `to` in one step, replacing a file at `to`; false when that fails.
  effect fn rename(from: &Path, to: &Path) -> bool ! OutOfMemoryError ? &mut HostFiles | &mut Allocator

  /// Makes `to` a second name (a hard link) of the file `from`; false when that fails.
  effect fn link(from: &Path, to: &Path) -> bool ! OutOfMemoryError ? &mut HostFiles | &mut Allocator

  /// Waits for and takes the exclusive lock on the file `path`, creating it when missing; false
  /// when the lock cannot be taken. The lock lasts until `unlock` or the end of the process.
  effect fn lock(path: &Path) -> bool ! OutOfMemoryError ? &mut HostFiles | &mut Allocator

  /// Releases the lock `lock` took.
  effect fn unlock() -> () ? &mut HostFiles
}

/// The minisign public key that signs Silk releases, also published as `minisign.pub`.
pub fn releaseKey() -> &'static [u8] {
  return b"RWQefAo9Dbb8LrlLPaqWdRNlX5th2l7r+4WYhxRNbe5K5URDUht1XUDs"
}

/// The target triple of the running compiler, which names its release archives.
static if Intrinsic.targetOperatingSystem() == "windows" {
  pub fn hostTarget() -> &'static [u8] { return b"x86_64-pc-windows-msvc" }
} else {
static if Intrinsic.targetOperatingSystem() == "darwin" {
  static if Intrinsic.targetArchitecture() == "x86_64" {
    pub fn hostTarget() -> &'static [u8] {
      return b"x86_64-apple-darwin"
    }
  } else {
    pub fn hostTarget() -> &'static [u8] {
      return b"aarch64-apple-darwin"
    }
  }
} else {
  static if Intrinsic.targetArchitecture() == "aarch64" {
    pub fn hostTarget() -> &'static [u8] {
      return b"aarch64-unknown-linux-gnu"
    }
  } else {
    pub fn hostTarget() -> &'static [u8] {
      return b"x86_64-unknown-linux-gnu"
    }
  }
}

}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn startsWith(text: &[u8], prefix: &[u8]) -> bool {
  return text.length >= prefix.length && same(Slice.view<u8>(text, usize.ZERO, prefix.length), prefix)
}

fn contains(text: &[u8], byte: u8) -> bool {
  let mut at = usize.ZERO
  while at < text.length {
    if text[at] == byte {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

effect fn stop(status: i32, parts: &[&[u8]]) -> InstallError
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut message = Bytes.make()
  let mut at = usize.ZERO
  while at < parts.length {
    run Bytes.append(&mut message, parts[at])
    at = at + usize.ONE
  }
  return InstallError { status: status, message: move message }
}

effect fn joined(parts: &[&[u8]]) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = Bytes.make()
  let mut at = usize.ZERO
  while at < parts.length {
    run Bytes.append(&mut text, parts[at])
    at = at + usize.ONE
  }
  return move text
}

/// Whether `requested` names a release by what it is rather than by version: `latest`, the newest
/// stable release, or `dev`, the newest release of any kind.
pub fn isAlias(requested: &[u8]) -> bool {
  return same(requested, b"latest") || same(requested, b"dev")
}

// Whether `version` is a pre-release such as `0.1.0-dev.6+1aed5da1a342`.
fn prerelease(version: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < version.length && version[at] != 43 {
    if version[at] == 45 {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

/// The index of the newest of `candidates` that `requested` names, or of the newest stable one when
/// `stable` is set.
pub fn newest(candidates: &[Bytes], requested: &[u8], stable: bool) -> Option<usize> {
  let alias = isAlias(requested)
  let mut best = Option<usize>.none()
  let mut at = usize.ZERO
  while at < candidates.length {
    let candidate = Bytes.asSlice(&candidates[at])
    let mut named = Toolchains.matches(requested, candidate)
    if alias {
      named = !stable || !prerelease(candidate)
    }
    if named {
      let better = match &best {
        Option<usize>.Some { value } => Toolchains.compare(candidate, Bytes.asSlice(&candidates[value])) > 0
        Option<usize>.None => true
      }
      if better {
        best = Option<usize>.some(at)
      }
    }
    at = at + usize.ONE
  }
  return move best
}

// The member's path below `top/`, or `None` for `top` itself. Fails for a path outside `top`.
effect fn below(member: &ArchiveMember, top: &[u8]) -> Option<Bytes>
  ! InstallError | OutOfMemoryError
  ? &mut Allocator {
  let whole = Bytes.asSlice(&member.name)
  if same(whole, top) {
    return Option<Bytes>.none()
  }
  if whole.length > top.length + usize.ONE && startsWith(whole, top) && whole[top.length] == 47 {
    return Option<Bytes>.some(run Bytes.copy(Slice.view<u8>(whole, top.length + usize.ONE, whole.length - top.length - usize.ONE)))
  }
  fail run stop(VERIFICATION, &[b"the release archive holds a path outside ", top, b": ", whole])
}

/// Unpacks `archive` below `top/` into `staging`, which must then hold the compiler `bin/silkc`
/// (`bin/silkc.exe` on Windows) and the standard library. The toolchain keeps
/// no copy of the silk tool, whose `bin/silk` beside `bin/silkc` is the one in `$SILK_HOME/bin`.
pub effect fn unpack(archive: &[u8], top: &[u8], staging: &Path, windows: bool) -> ()
  ! InstallError | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut HostFiles | &mut Allocator {
  let mut reader = match run ReleaseArchive.reader(archive, windows) {
    Result.Success {value} => move value
    Result.Failure {error} => { fail run stop(VERIFICATION, &[ReleaseArchive.describe(move error)]) }
  }
  let mut compiler = false
  let mut library = false
  while true {
    let next = match move run Effect.result(ArchiveReader.next(&mut reader)) {
      Result<Option<ArchiveMember>, ArchiveError | OutOfMemoryError>.Success {value} => move value
      Result<Option<ArchiveMember>, ArchiveError | OutOfMemoryError>.Failure {error} => match move error {
        OutOfMemoryError exhausted => { fail move exhausted }
        ArchiveError invalid => { fail run stop(VERIFICATION, &[b"the release archive is corrupt: ", ReleaseArchive.describe(move invalid)]) }
      }
    }
    let member = match move next {
      Option<ArchiveMember>.Some { value } => move value
      Option<ArchiveMember>.None => {
        if !library {
          fail run stop(VERIFICATION, &[b"the release archive holds no lib/silk/stdlib"])
        }
        if compiler {
          let tool = run Path.joinBytes(staging, if windows { b"bin/silk.exe" } else { b"bin/silk" })
          if run FileSystem.exists(&tool) {
            run FileSystem.removeFile(&tool)
          }
          return
        }
        fail run stop(VERIFICATION, &[b"the release archive holds no bin/silkc"])
      }
    }
    if let Option<Bytes>.Some { value: relative } = move run below(&member, top) {
      let place = run Path.joinBytes(staging, Bytes.asSlice(&relative))
      if member.directory {
        run FileSystem.createDirectoriesRecursively(&place)
        if !run HostFiles.markExecutable(&place) {
          fail run stop(1, &[b"cannot set the permissions of ", Path.rawBytes(&place)])
        }
        if same(Bytes.asSlice(&relative), b"lib/silk/stdlib") {
          library = true
        }
      } else {
        run FileSystem.writeFileWithParents(&place, Bytes.asSlice(&member.content))
        if member.executable {
          if !run HostFiles.markExecutable(&place) {
            fail run stop(1, &[b"cannot make ", Path.rawBytes(&place), b" executable"])
          }
        }
        if same(Bytes.asSlice(&relative), if windows { b"bin/silkc.exe" } else { b"bin/silkc" }) {
          compiler = true
        }
      }
    }
  }
  fail run stop(VERIFICATION, &[b"the release archive is corrupt"])
}

/// The name of the directory at the top of the archive of `version` for `target`.
pub effect fn topName(version: &[u8], target: &[u8]) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  return run joined(&[b"silk-", version, b"-", target])
}

/// The name of the archive of `version` for `target`: a `.tar.gz`, or a ZIP on Windows.
pub effect fn archiveName(version: &[u8], target: &[u8]) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  return run joined(&[b"silk-", version, b"-", target, if ReleaseArchive.windows(target) { b".zip" } else { b".tar.gz" }])
}

/// The name of the minisign signature of the archive of `version` for `target`.
pub effect fn signatureName(version: &[u8], target: &[u8]) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let archive = run archiveName(version, target)
  return run joined(&[Bytes.asSlice(&archive), b".minisig"])
}

/// Checks that the minisign public key `publicKey` signed `archive`, the archive of `version`
/// for `target`, with `signature`, and for that release and file.
///
/// Fails with status 1 when `publicKey` is no key, and with `VERIFICATION` when the signature
/// is not the key's or its trusted comment names another release or file.
pub effect fn verify(publicKey: &[u8], version: &[u8], target: &[u8], archive: &[u8], signature: &[u8]) -> ()
  ! InstallError | OutOfMemoryError
  ? &mut Allocator {
  let key = match Minisign.key(publicKey) {
    Result<MinisignKey, MinisignError>.Success { value } => move value
    Result<MinisignKey, MinisignError>.Failure { error } => {
      fail run stop(1, &[b"the release key is invalid: ", Minisign.describe(error)])
    }
  }
  let name = run archiveName(version, target)
  let comment = match Minisign.verify(&key, signature, archive) {
    Result<&[u8], MinisignError>.Success { value } => value
    Result<&[u8], MinisignError>.Failure { error } => {
      fail run stop(
        VERIFICATION,
        &[Bytes.asSlice(&name), b" is not signed by the Silk release key: ", Minisign.describe(error)]
      )
    }
  }
  let expected = run joined(&[b"silk v", version, b" ", Bytes.asSlice(&name)])
  if !same(comment, Bytes.asSlice(&expected)) {
    fail run stop(
      VERIFICATION,
      &[b"the signature of ", Bytes.asSlice(&name), b" belongs to a different release or file: ", comment]
    )
  }
  return ()
}

/// Removes the staging directories that interrupted installs left in `store`. Only an install
/// that holds the lock may, since no other install is staging then.
pub effect fn removeStaging(store: &Path) -> ()
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let listed = run FileSystem.listDirectory(store)
  let entries = List<DirectoryEntry>.asSlice(&listed)
  let mut at = usize.ZERO
  while at < entries.length {
    if staged(Path.rawBytes(&entries[at].path)) {
      let cleaned = run Effect.result(FileSystem.removeDirectoryRecursively(&entries[at].path))
      drop cleaned
    }
    at = at + usize.ONE
  }
}

// Whether the last name of `path` is that of a staging directory.
fn staged(path: &[u8]) -> bool {
  let mut start = path.length
  while start > usize.ZERO && path[start - usize.ONE] != 47 {
    start = start - usize.ONE
  }
  let name = Slice.view<u8>(path, start, path.length - start)
  return name.length > usize.add(0, 9) && same(Slice.view<u8>(name, usize.ZERO, usize.add(0, 9)), b".install-")
}

/// Whether an interrupted install left a staging directory in `store`.
pub effect fn leftStaging(store: &Path) -> bool
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  if !run FileSystem.exists(store) {
    return false
  }
  let listed = run FileSystem.listDirectory(store)
  let entries = List<DirectoryEntry>.asSlice(&listed)
  let mut at = usize.ZERO
  while at < entries.length {
    if staged(Path.rawBytes(&entries[at].path)) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

/// Builds the failure of an install from the parts of its message.
pub effect fn stopped(status: i32, parts: &[&[u8]]) -> InstallError
  ! OutOfMemoryError
  ? &mut Allocator {
  return run stop(status, parts)
}

/// The content of the file `relative` below `top/` in the archive `archive`, or `None`.
pub effect fn member(archive: &[u8], top: &[u8], relative: &[u8], windows: bool) -> Option<Bytes>
  ! InstallError | OutOfMemoryError
  ? &mut Allocator {
  let mut reader = match run ReleaseArchive.reader(archive, windows) {
    Result.Success {value} => move value
    Result.Failure {error} => { fail run stop(VERIFICATION, &[ReleaseArchive.describe(move error)]) }
  }
  let mut content = Option<Bytes>.none()
  while true {
    let next = match move run Effect.result(ArchiveReader.next(&mut reader)) {
      Result<Option<ArchiveMember>, ArchiveError | OutOfMemoryError>.Success {value} => move value
      Result<Option<ArchiveMember>, ArchiveError | OutOfMemoryError>.Failure {error} => match move error {
        OutOfMemoryError exhausted => { fail move exhausted }
        ArchiveError invalid => { fail run stop(VERIFICATION, &[b"the release archive is corrupt: ", ReleaseArchive.describe(move invalid)]) }
      }
    }
    let found = match move next {
      Option<ArchiveMember>.Some { value } => move value
      Option<ArchiveMember>.None => {
        return move content
      }
    }
    if let Option<Bytes>.Some { value: path } = move run below(&found, top) {
      if !found.directory && same(Bytes.asSlice(&path), relative) {
        content = Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&found.content)))
      }
    }
  }
  return Option<Bytes>.none()
}

// Writes `program` as `staging/silk`, then renames it over `bin/silk`, so the name always holds a
// whole program. Windows executable names carry the `.exe` suffix.
effect fn replaceProgramUnlocked(program: &[u8], staging: &Path, bin: &Path, windows: bool) -> ()
  ! InstallError | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut HostFiles | &mut Allocator {
  let fresh = run Path.join(staging, if windows { "silk.exe" } else { "silk" })
  run FileSystem.writeFileWithParents(&fresh, program)
  if !run HostFiles.markExecutable(&fresh) {
    fail run stop(1, &[b"cannot make ", Path.rawBytes(&fresh), b" executable"])
  }
  let front = run Path.join(bin, if windows { "silk.exe" } else { "silk" })
  if windows && run FileSystem.exists(&front) {
    // NTFS cannot replace the last name of a mapped executable image. Retain a hard link
    // to that image until a later update, when the old process has exited. Failure to remove
    // a still-mapped earlier image leaves the current tool untouched.
    let previous = run Path.join(bin, ".silk-previous.exe")
    if run FileSystem.exists(&previous) { run FileSystem.removeFile(&previous) }
    if !run HostFiles.link(&front, &previous) {
      fail run stop(1, &[b"cannot retain the running tool at ", Path.rawBytes(&previous)])
    }
  }
  if !run HostFiles.rename(&fresh, &front) {
    fail run stop(1, &[b"cannot replace ", Path.rawBytes(&front)])
  }

}

/// Writes `program` as `staging/silk`, then renames it over `bin/silk`, so the name always holds
/// a whole program. Windows updates run one at a time, because replacing a mapped image also
/// retains its previous link.
pub effect fn replaceProgram(program: &[u8], staging: &Path, bin: &Path, windows: bool) -> ()
  ! InstallError | FileError | OutOfMemoryError
  ? &mut FileSystem | &mut HostFiles | &mut Allocator {
  if !windows { return run replaceProgramUnlocked(program, staging, bin, false) }
  let lock = run Path.join(bin, ".update.lock")
  if !run HostFiles.lock(&lock) { fail run stop(1, &[b"cannot lock the tool for update"]) }
  let attempted = run Effect.result(replaceProgramUnlocked(program, staging, bin, true))
  run HostFiles.unlock()
  if let Result<(), InstallError | FileError | OutOfMemoryError>.Failure {error} = move attempted { fail move error }
}
