//! Reading the target's verified release container as ordinary files and directories.

import silk.collections.bytes {Bytes}
import silk.collections.slice {Slice}
import silk.compress.inflate {DecodeError, Decoder, Format as InflateFormat, Limits as InflateLimits, MEMORY_BOUND as INFLATE_MEMORY_BOUND, Progress, Status as InflateStatus}
import silk.compress.tar {TarError, TarKind, TarProgress, TarReader, TarStatus}
import silk.compress.zip {ZipError, ZipKind, ZipMember, ZipReader}
import silk.collections.hash {Hash, HashSeed, HashKey}
import silk.collections.hash_set {HashSet}
import silk.num.u8
import silk.num.usize
import silk.core.option {Option}
import silk.core.result {Result}
import silk.core.effect {Effect}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.text.string {String}

/// A malformed release container: gzip that does not decode, its format's structural reason, a
/// repeated path, a member that is neither a file nor a directory, or a path with an empty or `.`
/// segment.
pub union ArchiveError {Gzip, Tar {pub error: TarError}, Zip {pub error: ZipError}, Duplicate, UnsupportedMember, UnsafePath}

// Whether `path` is not empty and has no empty or `.` segment. The format readers have already
// refused absolute paths and `..` segments.
fn ordinary(path: &[u8]) -> bool {
  let mut start: usize = 0
  let mut at: usize = 0
  while at <= path.length {
    if at == path.length || path[at] == 47 {
      if at == start || (at - start == 1 && path[start] == 46) { return false }
      start = at + 1
    }
    at = at + 1
  }
  return true
}

/// A reader for the target's release container.
union ContainerReader<'a> {Tar {stream: TarStream<'a>}, Zip {reader: ZipReader<'a>}}

/// A `.tar.gz` release decoded as it is read: the gzip decoder, the tar reader, the compressed
/// bytes and how far the decoder has read them, and the decoded piece the tar reader has not
/// consumed yet.
struct TarStream<'a> {
  decoder: Decoder,
  reader: TarReader,
  archive: &'a [u8],
  offset: usize,
  chunk: Bytes,
  start: usize,
  end: usize,
  finished: bool,
}

// The decoded bytes a release `.tar.gz` may hold: 1 GiB.
const TAR_LIMIT: u64 = 1073741824

// The decoded piece the tar reader gets at a time: 64 KiB.
const CHUNK: usize = 65536

/// A member's relative path and decoded data. Directories have empty content.
struct MemberPath {bytes: Bytes}
impl HashKey for MemberPath {
  fn equals(left: &Self, right: &Self) -> bool {
    let a = Bytes.asSlice(&left.bytes)
    let b = Bytes.asSlice(&right.bytes)
    if a.length != b.length { return false }
    let mut at: usize = 0
    while at < a.length {
      if a[at] != b[at] { return false }
      at = at + 1
    }
    return true
  }
  fn hash(value: &Self, seed: &HashSeed) -> u64 {
    let bytes = Bytes.asSlice(&value.bytes)
    let mut hashed = Hash.mix(seed, usize.toU64(bytes.length))
    let mut at: usize = 0
    while at < bytes.length {
      hashed = Hash.combine(hashed, u8.toU64(bytes[at]))
      at = at + 1
    }
    return hashed
  }
}

/// A release reader retaining seen names to reject ambiguous duplicate members.
pub struct ArchiveReader<'a> {container: ContainerReader<'a>, seen: HashSet<MemberPath>}

/// One decoded regular file or directory below the archive root.
pub struct ArchiveMember {
  pub name: Bytes,
  pub directory: bool,
  pub executable: bool,
  pub content: Bytes,
}

/// Whether a target uses Windows release layout and ZIP containers.
pub fn windows(target: &[u8]) -> bool {
  let expected = b"x86_64-pc-windows-msvc"
  if target.length != expected.length { return false }
  let mut at: usize = 0
  while at < target.length {
    if target[at] != expected[at] { return false }
    at = at + 1
  }
  return true
}

// The decoded bytes a release ZIP may hold: 1 GiB.
const ZIP_LIMIT: u64 = 1073741824

/// Opens ZIP for Windows, or a gzip-compressed tar stream for other targets, which is decoded as
/// it is read.
///
/// # Errors
/// - `ArchiveError` when the ZIP directory is corrupt, or the gzip decoder cannot start.
/// - `OutOfMemoryError` when the decoder's storage cannot be allocated.
pub effect fn reader<'a>(archive: &'a [u8], windows: bool) -> Result<ArchiveReader<'a>, ArchiveError>
  ! OutOfMemoryError ? &mut Allocator {
  if windows {
    return match ZipReader.open(archive, ZIP_LIMIT) {
      Result.Success {value} => Result<ArchiveReader<'a>, ArchiveError>.succeed(ArchiveReader {container: ContainerReader.Zip {reader: move value}, seen: HashSet<MemberPath>.make(Hash.seed(0))})
      Result.Failure {error} => Result<ArchiveReader<'a>, ArchiveError>.failResult(ArchiveError.Zip {error: error})
    }
  }
  let limits = InflateLimits {
    maxInputBytes: usize.toU64(archive.length),
    maxOutputBytes: TAR_LIMIT,
    maxMembers: 1,
    maxHeaderBytes: 65536,
    maxMemoryBytes: INFLATE_MEMORY_BOUND,
  }
  let made = run Effect.result(Decoder.make(InflateFormat.Gzip, move limits))
  let decoder = match move made {
    Result<Decoder, OutOfMemoryError | DecodeError>.Success {value} => move value
    Result<Decoder, OutOfMemoryError | DecodeError>.Failure {error} => match move error {
      OutOfMemoryError exhausted => { fail move exhausted }
      DecodeError _invalid => { return Result<ArchiveReader<'a>, ArchiveError>.failResult(ArchiveError.Gzip) }
    }
  }
  let stream = TarStream<'a> {decoder: move decoder, reader: TarReader.make(), archive: archive, offset: 0,
    chunk: run Bytes.zeroed(CHUNK), start: 0, end: 0, finished: false}
  return Result<ArchiveReader<'a>, ArchiveError>.succeed(ArchiveReader {container: ContainerReader.Tar {stream: move stream}, seen: HashSet<MemberPath>.make(Hash.seed(0))})
}

impl<'a> ContainerReader<'a> {
  /// Validates and decodes the next member, including ZIP content CRCs.
  effect fn next(self: &mut ContainerReader<'_>) -> Option<ArchiveMember>
    ! ArchiveError | OutOfMemoryError ? &mut Allocator {
    match &mut self.* {
      ContainerReader.Tar {stream} => { return run tarNext(&mut stream) }
      ContainerReader.Zip {reader} => {
        let next = match ZipReader.next(&mut reader) {
          Result.Success {value} => move value
          Result.Failure {error} => { fail ArchiveError.Zip {error: error} }
        }
        if let Option<ZipMember>.Some {value} = move next {
          // A release holds only files and directories.
          if value.kind == ZipKind.SymbolicLink { fail ArchiveError.UnsupportedMember }
          let decoded = run Effect.result(ZipMember.content(&value))
          let content = match move decoded {
            Result<Bytes, ZipError | OutOfMemoryError>.Success {value: bytes} => move bytes
            Result<Bytes, ZipError | OutOfMemoryError>.Failure {error} => match move error {
              ZipError invalid => { fail ArchiveError.Zip {error: invalid} }
              OutOfMemoryError exhausted => { fail move exhausted }
            }
          }
          return Option<ArchiveMember>.some(ArchiveMember {name: run Bytes.copy(value.name),
            directory: value.kind == ZipKind.Directory, executable: value.executable, content: move content})
        }
      }
    }
    return Option<ArchiveMember>.none()
  }
}

// Reads the next tar member of `stream`, with all its content, decoding more gzip as the tar
// reader needs it.
effect fn tarNext(stream: &mut TarStream<'_>) -> Option<ArchiveMember>
  ! ArchiveError | OutOfMemoryError ? &mut Allocator {
  let mut name = Bytes.make()
  let mut directory = false
  let mut executable = false
  let mut content = Bytes.make()
  let mut started = false
  while true {
    if stream.start == stream.end && !stream.finished {
      let input = Slice.view<u8>(stream.archive, stream.offset, stream.archive.length - stream.offset)
      let decoded = match Decoder.step(&mut stream.decoder, input, Bytes.asMutSlice(&mut stream.chunk), true) {
        Result<Progress, DecodeError>.Success {value} => move value
        Result<Progress, DecodeError>.Failure {..} => { fail ArchiveError.Gzip }
      }
      stream.offset = stream.offset + decoded.consumed
      stream.start = 0
      stream.end = decoded.written
      stream.finished = decoded.status == InflateStatus.Finished
      if !stream.finished && decoded.consumed == 0 && decoded.written == 0 { fail ArchiveError.Gzip }
    }
    let rest = Slice.view<u8>(Bytes.asSlice(&stream.chunk), stream.start, stream.end - stream.start)
    let progress = match TarReader.step(&mut stream.reader, rest, stream.finished) {
      Result<TarProgress, TarError>.Success {value} => value
      Result<TarProgress, TarError>.Failure {error} => { fail ArchiveError.Tar {error: error} }
    }
    stream.start = stream.start + progress.consumed
    if progress.status == TarStatus.End { return Option<ArchiveMember>.none() }
    if progress.status == TarStatus.Content { run Bytes.append(&mut content, Slice.view<u8>(rest, 0, progress.consumed)) }
    if progress.status == TarStatus.Member {
      let member = TarReader.member(&stream.reader)
      // A release holds only files and directories.
      if member.kind != TarKind.File && member.kind != TarKind.Directory { fail ArchiveError.UnsupportedMember }
      name = run Bytes.copy(member.prefix)
      if member.prefix.length > 0 && member.name.length > 0 { run Bytes.append(&mut name, b"/") }
      run Bytes.append(&mut name, member.name)
      directory = member.kind == TarKind.Directory
      executable = member.executable
      started = true
    }
    if started && progress.status != TarStatus.NeedInput && TarReader.remaining(&stream.reader) == 0 {
      return Option<ArchiveMember>.some(ArchiveMember {name: move name, directory: directory, executable: executable, content: move content})
    }
  }
  return Option<ArchiveMember>.none()
}

impl<'a> ArchiveReader<'a> {
  /// Returns a decoded member, refusing a path with an empty or `.` segment, and a repeated path,
  /// before the caller writes them.
  pub effect fn next(self: &mut ArchiveReader<'_>) -> Option<ArchiveMember>
    ! ArchiveError | OutOfMemoryError ? &mut Allocator {
    let found = run ContainerReader.next(&mut self.container)
    if let Option<ArchiveMember>.Some {value} = move found {
      if !ordinary(Bytes.asSlice(&value.name)) { fail ArchiveError.UnsafePath }
      let name = run Bytes.copy(Bytes.asSlice(&value.name))
      if run HashSet<MemberPath>.insert(&mut self.seen, MemberPath {bytes: move name}) {
        fail ArchiveError.Duplicate
      }
      return Option<ArchiveMember>.some(move value)
    }
    return Option<ArchiveMember>.none()
  }
}

/// A description of the structural error for an install diagnostic.
pub fn describe(error: ArchiveError) -> &'static [u8] {
  return match move error {
    ArchiveError.Gzip => b"the release archive is not valid gzip"
    ArchiveError.Tar {error: invalid} => String.utf8Bytes(TarError.describe(invalid))
    ArchiveError.Zip {error: invalid} => String.utf8Bytes(ZipError.describe(invalid))
    ArchiveError.Duplicate => b"the archive repeats a member path"
    ArchiveError.UnsupportedMember => b"the archive holds a member that is neither a file nor a directory"
    ArchiveError.UnsafePath => b"the archive holds a path with an empty or `.` segment"
  }
}
