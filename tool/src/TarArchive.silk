//! A reader for the ustar archives Silk releases publish, after gzip decoding.
//!
//! Release archives hold only directories and regular files, with names split across the ustar
//! `prefix` and `name` fields (`compiler/scripts/ReleaseArchive.ts`). The reader refuses every other
//! member type, including links, and every path that is absolute or has an empty, `.` or `..`
//! component, so unpacking a member can never write outside the destination.

import silk.core.option { Option }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.num.u8
import silk.num.usize

/// Why an archive was refused.
pub enum TarError {
  /// The archive ends inside a header or a member's content.
  Truncated,
  /// A header's checksum does not match its bytes.
  BadChecksum,
  /// A member is neither a directory nor a regular file.
  UnsupportedMember,
  /// A member path is absolute or has an empty, `.` or `..` component.
  UnsafePath,
}

/// One archive member. Its path is `prefix/name`, or `name` alone when `prefix` is empty, without
/// the trailing `/` a directory name may carry.
pub struct TarMember<'a> {
  pub prefix: &'a [u8],
  pub name: &'a [u8],
  pub directory: bool,

  /// Whether any execute permission bit is set.
  pub executable: bool,

  /// The bytes of a regular file; empty for a directory.
  pub content: &'a [u8],
}

/// A position in an archive.
pub struct TarReader<'a> {
  archive: &'a [u8],
  offset: usize,
}

/// A short description of `error` for messages.
pub fn describe(error: TarError) -> &'static [u8] {
  return match error {
    TarError.Truncated => b"the archive is truncated"
    TarError.BadChecksum => b"an archive header is corrupt"
    TarError.UnsupportedMember => b"the archive holds a member that is neither a file nor a directory"
    TarError.UnsafePath => b"the archive holds a path outside its directory"
  }
}

/// A reader at the start of `archive`.
pub fn reader<'a>(archive: &'a [u8]) -> TarReader<'a> {
  return TarReader { archive: archive, offset: usize.ZERO }
}

// The bytes of a NUL-terminated header field.
fn field<'a>(header: &'a [u8], start: usize, width: usize) -> &'a [u8] {
  let mut length = usize.ZERO
  while length < width && header[start + length] != 0 {
    length = length + usize.ONE
  }
  return Slice.view<u8>(header, start, length)
}

// An octal header number, ignoring leading spaces and stopping at a space or NUL. `None` for any
// other byte.
fn octal(header: &[u8], start: usize, width: usize) -> Option<usize> {
  let mut at = start
  let end = start + width
  while at < end && header[at] == 32 {
    at = at + usize.ONE
  }
  let mut value = usize.ZERO
  while at < end && header[at] != 0 && header[at] != 32 {
    let digit = header[at]
    if digit < 48 || digit > 55 {
      return Option<usize>.none()
    }
    value = value * usize.add(0, 8) + u8.toUsize(digit - 48)
    at = at + usize.ONE
  }
  return Option<usize>.some(value)
}

fn allZero(block: &[u8]) -> bool {
  let mut at = usize.ZERO
  while at < block.length {
    if block[at] != 0 {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// Whether `path` is relative with only ordinary components. A trailing `/` is allowed when
// `trailing` is set; an empty path is allowed when `empty` is set.
fn safe(path: &[u8], trailing: bool, empty: bool) -> bool {
  if path.length == usize.ZERO {
    return empty
  }
  let mut end = path.length
  if trailing && path[end - usize.ONE] == 47 {
    end = end - usize.ONE
  }
  let mut start = usize.ZERO
  while start <= end {
    let mut stop = start
    while stop < end && path[stop] != 47 {
      stop = stop + usize.ONE
    }
    let length = stop - start
    if length == usize.ZERO {
      return false
    }
    if length == usize.ONE && path[start] == 46 {
      return false
    }
    if length == usize.add(0, 2) && path[start] == 46 && path[start + usize.ONE] == 46 {
      return false
    }
    start = stop + usize.ONE
  }
  return true
}

impl TarReader {
  /// The next member, or `None` at the end-of-archive blocks or the end of the bytes.
  pub fn next<'a>(self: &mut TarReader<'a>) -> Result<Option<TarMember<'a>>, TarError> {
    let archive = self.archive
    let block = usize.add(0, 512)
    if self.offset == archive.length {
      return Result<Option<TarMember<'a>>, TarError>.succeed(Option<TarMember<'a>>.none())
    }
    if archive.length - self.offset < block {
      return Result<Option<TarMember<'a>>, TarError>.failResult(TarError.Truncated)
    }
    let header = Slice.view<u8>(archive, self.offset, block)
    if allZero(header) {
      self.offset = archive.length
      return Result<Option<TarMember<'a>>, TarError>.succeed(Option<TarMember<'a>>.none())
    }

    // The checksum treats its own eight bytes as spaces.
    let mut sum = usize.ZERO
    let mut at = usize.ZERO
    while at < block {
      if at >= 148 && at < 156 {
        sum = sum + usize.add(0, 32)
      } else {
        sum = sum + u8.toUsize(header[at])
      }
      at = at + usize.ONE
    }
    let recorded = match octal(header, usize.add(0, 148), usize.add(0, 8)) {
      Option<usize>.Some { value } => value
      Option<usize>.None => {
        return Result<Option<TarMember<'a>>, TarError>.failResult(TarError.BadChecksum)
      }
    }
    if recorded != sum {
      return Result<Option<TarMember<'a>>, TarError>.failResult(TarError.BadChecksum)
    }
    let kind = header[156]
    let directory = kind == 53
    if !directory && kind != 48 && kind != 0 {
      return Result<Option<TarMember<'a>>, TarError>.failResult(TarError.UnsupportedMember)
    }
    let size = match octal(header, usize.add(0, 124), usize.add(0, 12)) {
      Option<usize>.Some { value } => value
      Option<usize>.None => {
        return Result<Option<TarMember<'a>>, TarError>.failResult(TarError.BadChecksum)
      }
    }
    let mode = match octal(header, usize.add(0, 100), usize.add(0, 8)) {
      Option<usize>.Some { value } => value
      Option<usize>.None => {
        return Result<Option<TarMember<'a>>, TarError>.failResult(TarError.BadChecksum)
      }
    }
    let mut name = field(header, usize.ZERO, usize.add(0, 100))
    let prefix = field(header, usize.add(0, 345), usize.add(0, 155))
    if !safe(name, directory, false) || !safe(prefix, false, true) {
      return Result<Option<TarMember<'a>>, TarError>.failResult(TarError.UnsafePath)
    }
    if directory && name[name.length - usize.ONE] == 47 {
      name = Slice.view<u8>(name, usize.ZERO, name.length - usize.ONE)
    }
    if directory && size != usize.ZERO {
      return Result<Option<TarMember<'a>>, TarError>.failResult(TarError.UnsupportedMember)
    }
    let start = self.offset + block
    if archive.length - start < size {
      return Result<Option<TarMember<'a>>, TarError>.failResult(TarError.Truncated)
    }
    let padded = (size + block - usize.ONE) / block * block
    if archive.length - start < padded {
      return Result<Option<TarMember<'a>>, TarError>.failResult(TarError.Truncated)
    }
    self.offset = start + padded
    let member = TarMember {
      prefix: prefix,
      name: name,
      directory: directory,
      executable: (mode / usize.add(0, 64)) % usize.add(0, 2) == usize.ONE
        || (mode / usize.add(0, 8)) % usize.add(0, 2) == usize.ONE
        || mode % usize.add(0, 2) == usize.ONE,
      content: Slice.view<u8>(archive, start, size),
    }
    return Result<Option<TarMember<'a>>, TarError>.succeed(Option<TarMember<'a>>.some(move member))
  }
}
