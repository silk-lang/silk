//! Minisign signatures, as Silk releases publish them beside each archive.
//!
//! A public key is the base64 text of `Ed`, an 8-byte key id and a 32-byte Ed25519 key. A signature
//! file has four lines: an untrusted comment, the base64 of an algorithm, the key id and a 64-byte
//! signature, `trusted comment: <text>`, and the base64 of a 64-byte global signature over the
//! signature followed by the trusted comment text. The `ED` algorithm signs the BLAKE2b-512 digest
//! of the content and the legacy `Ed` algorithm signs the content itself.

import silk.encoding.base64 { Base64, Base64Error }
import silk.crypto.blake2b { Blake2b512 }
import silk.crypto.ed25519 { Ed25519Error, Ed25519PublicKey }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.num.usize

/// Why a key or signature was refused.
pub enum MinisignError {
  /// The public key text is not the base64 of an Ed25519 minisign key.
  InvalidKey,
  /// The signature file does not have the four minisign lines.
  MalformedSignature,
  /// The signature names an algorithm other than `ED` or `Ed`.
  UnsupportedAlgorithm,
  /// The signature was made with a different key.
  WrongKey,
  /// The signature does not verify for this content.
  InvalidSignature,
  /// The global signature over the trusted comment does not verify.
  InvalidTrustedComment,
}

/// A decoded minisign public key.
pub struct MinisignKey {
  id: [u8; 8],
  key: Ed25519PublicKey,
}

/// The longest trusted comment accepted, in bytes.
const MAX_TRUSTED_COMMENT: usize = 1024

/// A short description of `error` for messages.
pub fn describe(error: MinisignError) -> &'static [u8] {
  return match error {
    MinisignError.InvalidKey => b"the public key is not a minisign Ed25519 key"
    MinisignError.MalformedSignature => b"the signature file is not in minisign format"
    MinisignError.UnsupportedAlgorithm => b"the signature uses an unsupported algorithm"
    MinisignError.WrongKey => b"the signature was made with a different key"
    MinisignError.InvalidSignature => b"the signature does not match the file"
    MinisignError.InvalidTrustedComment => b"the trusted comment is not signed by the key"
  }
}

fn decode(text: &[u8], output: &mut [u8]) -> bool {
  let expected = output.length
  return match Base64.decodeInto(move output, text) {
    Result<usize, Base64Error>.Success { value } => value == expected
    Result<usize, Base64Error>.Failure { error } => false
  }
}

/// Decodes the base64 public key `text`, such as the contents of `minisign.pub` after its comment
/// line.
pub fn key(text: &[u8]) -> Result<MinisignKey, MinisignError> {
  if text.length != usize.add(0, 56) {
    return Result<MinisignKey, MinisignError>.failResult(MinisignError.InvalidKey)
  }
  let mut raw: [u8; 42] = [0; 42]
  if !decode(text, &mut raw) || raw[0] != 69 || raw[1] != 100 {
    return Result<MinisignKey, MinisignError>.failResult(MinisignError.InvalidKey)
  }
  let mut id: [u8; 8] = [0; 8]
  let mut at = usize.ZERO
  while at < 8 {
    id[at] = raw[2 + at]
    at = at + usize.ONE
  }
  return match Ed25519PublicKey.fromBytes(
    Slice.view<u8>(&raw, usize.add(0, 10), usize.add(0, 32))
  ) {
    Result<Ed25519PublicKey, Ed25519Error>.Success { value } => Result<
      MinisignKey,
      MinisignError
    >.succeed(MinisignKey { id: id, key: move value })
    Result<Ed25519PublicKey, Ed25519Error>.Failure { error } => Result<
      MinisignKey,
      MinisignError
    >.failResult(MinisignError.InvalidKey)
  }
}

// The line of `text` starting at `start`, without its line ending; `next` receives where the
// following line starts.
fn line<'t>(text: &'t [u8], start: usize, next: &mut usize) -> &'t [u8] {
  let mut end = start
  while end < text.length && text[end] != 10 {
    end = end + usize.ONE
  }
  next.* = end
  if end < text.length {
    next.* = end + usize.ONE
  }
  let mut stop = end
  if stop > start && text[stop - usize.ONE] == 13 {
    stop = stop - usize.ONE
  }
  return Slice.view<u8>(text, start, stop - start)
}

fn startsWith(text: &[u8], prefix: &[u8]) -> bool {
  if text.length < prefix.length {
    return false
  }
  let mut at = usize.ZERO
  while at < prefix.length {
    if text[at] != prefix[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn accepted(verified: Result<(), Ed25519Error>) -> bool {
  return match move verified {
    Result<(), Ed25519Error>.Success { value } => true
    Result<(), Ed25519Error>.Failure { error } => false
  }
}

/// Verifies the minisign `signature` file of `content` against `signer`, and returns its trusted
/// comment.
///
/// Both the signature over the content and the global signature over the trusted comment must
/// verify, so the returned comment is authenticated too.
pub fn verify<'s>(signer: &MinisignKey, signature: &'s [u8], content: &[u8]) -> Result<
  &'s [u8],
  MinisignError
> {
  let mut next = usize.ZERO
  let untrusted = line(signature, usize.ZERO, &mut next)
  let encoded = line(signature, next, &mut next)
  let trustedLine = line(signature, next, &mut next)
  let globalEncoded = line(signature, next, &mut next)
  let prefix = b"trusted comment: "
  if !startsWith(untrusted, b"untrusted comment:") || !startsWith(trustedLine, prefix) {
    return Result<&'s [u8], MinisignError>.failResult(MinisignError.MalformedSignature)
  }
  let mut raw: [u8; 74] = [0; 74]
  let mut global: [u8; 64] = [0; 64]
  if !decode(encoded, &mut raw) || !decode(globalEncoded, &mut global) {
    return Result<&'s [u8], MinisignError>.failResult(MinisignError.MalformedSignature)
  }
  let prehashed = raw[0] == 69 && raw[1] == 68
  if !prehashed && !(raw[0] == 69 && raw[1] == 100) {
    return Result<&'s [u8], MinisignError>.failResult(MinisignError.UnsupportedAlgorithm)
  }
  let mut at = usize.ZERO
  while at < 8 {
    if raw[2 + at] != signer.id[at] {
      return Result<&'s [u8], MinisignError>.failResult(MinisignError.WrongKey)
    }
    at = at + usize.ONE
  }
  let signed = Slice.view<u8>(&raw, usize.add(0, 10), usize.add(0, 64))
  let mut valid = false
  if prehashed {
    let digest = Blake2b512.hash(content)
    valid = accepted(signer.key.verify(&digest, signed))
  } else {
    valid = accepted(signer.key.verify(content, signed))
  }
  if !valid {
    return Result<&'s [u8], MinisignError>.failResult(MinisignError.InvalidSignature)
  }
  let comment = Slice.view<u8>(trustedLine, prefix.length, trustedLine.length - prefix.length)
  if comment.length > MAX_TRUSTED_COMMENT {
    return Result<&'s [u8], MinisignError>.failResult(MinisignError.MalformedSignature)
  }
  let mut covered: [u8; 1088] = [0; 1088]
  at = usize.ZERO
  while at < 64 {
    covered[at] = signed[at]
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < comment.length {
    covered[64 + at] = comment[at]
    at = at + usize.ONE
  }
  if !accepted(
    signer.key.verify(
      Slice.view<u8>(&covered, usize.ZERO, usize.add(0, 64) + comment.length),
      &global
    )
  ) {
    return Result<&'s [u8], MinisignError>.failResult(MinisignError.InvalidTrustedComment)
  }
  return Result<&'s [u8], MinisignError>.succeed(comment)
}
