package silk:wasi;

/// The interfaces available to a Silk Preview 2 command. A component imports only the ones it
/// uses, so `wasi:logging`, a draft that few hosts offer, is imported only by a component that
/// logs through `silk.io.logger_wasi`.
world command {
  include wasi:cli/imports@0.2.12;
  import wasi:http/types@0.2.12;
  import wasi:http/outgoing-handler@0.2.12;
  import wasi:logging/logging@0.1.0-draft;
}

/// A request-driven HTTP component, with the same host services as a command.
world http {
  include wasi:http/proxy@0.2.12;
}
