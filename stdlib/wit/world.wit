package silk:wasi;

/// The interfaces available to a Silk Preview 2 command.
world command {
  include wasi:cli/imports@0.2.12;
  import wasi:http/types@0.2.12;
  import wasi:http/outgoing-handler@0.2.12;
}

/// A request-driven HTTP component, with the same host services as a command.
world http {
  include wasi:http/proxy@0.2.12;
}
