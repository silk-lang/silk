//! Thirty-two-bit unsigned integers for fixed-width counts, masks, and binary fields.
//!
//! # When to use
//! Use `u32` when an unsigned 32-bit representation is part of the contract, including masks and
//! encoded fields. Use `usize` for collection positions and allocation sizes tied to the target.
//!
//! # Details
//! Each arithmetic operation has four forms with different overflow rules:
//!
//! - The plain form, such as [`add`], traps on overflow. Use it when overflow is a program error.
//! - The `checked` form, such as [`checkedAdd`], returns `None` on overflow. Use it when input data
//!   controls the operands.
//! - The `wrapping` form, such as [`wrappingAdd`], computes the result modulo 2^32.
//! - The `saturating` form, such as [`saturatingAdd`], returns [`MIN`] or [`MAX`] on overflow.
//!
//! Division and remainder by zero trap. [`checkedDivide`] and [`checkedRemainder`] return `None`.
//! The shift count must be in the range 0 to `BITS - 1`. Otherwise, the program traps. A rotate
//! reduces its count modulo [`BITS`], so each count is valid. A right shift inserts zero bits.
//!
//! A `to` conversion, such as `toU8`, traps if the value is out of the range of the destination
//! type. A `checkedTo` conversion returns `None` instead. Conversion to `f32` or `f64` rounds to
//! the nearest value if the integer has more significant bits than the float.
//!
//! A `wrappingTo` conversion, such as `wrappingToI16`, never traps. It keeps the low bits of the
//! two's complement form of the value, like a cast in C or Rust, so it truncates, sign-extends, or
//! reinterprets bits.
//!
//! [`countOnes`], [`leadingZeros`], and [`trailingZeros`] count the bits of the value. For
//! zero, both zero counts return [`BITS`].
//!
//! [`parse`] reads decimal text. A sign is not valid. To write a value as text, use
//! `silk.format.Format.display` or `Format.displayWith` with a `Writer`. Neither needs an
//! `Allocator`.
//!
//! # Examples
//! ## Extract one byte from a fixed-width field
//! ```silk
//! import silk.u32
//!
//! pub fn main() -> i32 {
//!   let shifted = u32.shiftRight(0x00002A00, 8)
//!   let byte = u32.bitAnd(shifted, 0xFF)
//!   let result = u32.toI32(byte)
//!   if result != 42 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! ## Parse decimal text and reject invalid text
//! ```silk
//! import silk.format { ParseError }
//! import silk.result { Result }
//! import silk.u32
//!
//! pub fn main() -> i32 {
//!   let parsed = u32.parse("42") |> Result<u32, ParseError>.unwrapOr(0)
//!   let invalid = u32.parse("4x2") |> Result<u32, ParseError>.unwrapOr(0)
//!   if parsed != 42 || invalid != 0 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Numbers

import silk.bool
import silk.f32
import silk.f64
import silk.format { Format, ParseError }
import silk.i16
import silk.i32
import silk.i64
import silk.i8
import silk.isize
import silk.option { Option }
import silk.result { Result }
import silk.u16
import silk.u64
import silk.u8
import silk.usize

/// The largest `u32` value.
pub const MAX: u32 = 4294967295

/// The smallest `u32` value.
pub const MIN: u32 = 0

/// The fixed width of `u32`, in bits.
pub const BITS: u32 = 32

/// Converts `value` to `u8`. Traps if `value` is outside the `u8` range. Use
/// this function when an out-of-range value is a program error.
pub fn toU8(value: u32) -> u8 {
  if let Option<u8>.Some {value: converted} = checkedToU8(value) { return converted }
  return Intrinsic.trap("u32.toU8: the value is outside the u8 range")
}

/// Converts `value` to `u8`, or returns `None` if `value` is outside the `u8`
/// range. Use this function when an out-of-range value is input data.
pub fn checkedToU8(value: u32) -> Option<u8> {
  return Intrinsic.u32CheckedToU8<Option<u8>>(value, Option.some, Option.none)
}

/// Converts `value` to `u16`. Traps if `value` is outside the `u16` range. Use
/// this function when an out-of-range value is a program error.
pub fn toU16(value: u32) -> u16 {
  if let Option<u16>.Some {value: converted} = checkedToU16(value) { return converted }
  return Intrinsic.trap("u32.toU16: the value is outside the u16 range")
}

/// Converts `value` to `u16`, or returns `None` if `value` is outside the `u16`
/// range. Use this function when an out-of-range value is input data.
pub fn checkedToU16(value: u32) -> Option<u16> {
  return Intrinsic.u32CheckedToU16<Option<u16>>(value, Option.some, Option.none)
}

/// Returns `value` unchanged as `u32`. Use this function when generic conversion code
/// can select `u32` as both source and destination.
pub fn toU32(value: u32) -> u32 {
  return Intrinsic.u32ToU32(value)
}

/// Returns `Some` with `value` unchanged as `u32`. Use this function when generic
/// checked-conversion code can select the same source and destination type.
pub fn checkedToU32(value: u32) -> Option<u32> {
  return Intrinsic.u32CheckedToU32<Option<u32>>(value, Option.some, Option.none)
}

/// Converts `value` exactly to `u64`. Every `u32` value is representable.
pub fn toU64(value: u32) -> u64 {
  if let Option<u64>.Some {value: converted} = checkedToU64(value) { return converted }
  return Intrinsic.trap("u32.toU64: the value is outside the u64 range")
}

/// Converts `value` exactly to `u64` and returns `Some`. Every `u32` value is
/// representable.
pub fn checkedToU64(value: u32) -> Option<u64> {
  return Intrinsic.u32CheckedToU64<Option<u64>>(value, Option.some, Option.none)
}

/// Converts `value` exactly to `usize`. Every `u32` value is representable.
pub fn toUsize(value: u32) -> usize {
  if let Option<usize>.Some {value: converted} = checkedToUsize(value) { return converted }
  return Intrinsic.trap("u32.toUsize: the value is outside the usize range")
}

/// Converts `value` exactly to `usize` and returns `Some`. Every `u32` value is
/// representable.
pub fn checkedToUsize(value: u32) -> Option<usize> {
  return Intrinsic.u32CheckedToUsize<Option<usize>>(value, Option.some, Option.none)
}

/// Converts `value` to `i8`. Traps if `value` is outside the `i8` range. Use
/// this function when an out-of-range value is a program error.
pub fn toI8(value: u32) -> i8 {
  if let Option<i8>.Some {value: converted} = checkedToI8(value) { return converted }
  return Intrinsic.trap("u32.toI8: the value is outside the i8 range")
}

/// Converts `value` to `i8`, or returns `None` if `value` is outside the `i8`
/// range. Use this function when an out-of-range value is input data.
pub fn checkedToI8(value: u32) -> Option<i8> {
  return Intrinsic.u32CheckedToI8<Option<i8>>(value, Option.some, Option.none)
}

/// Converts `value` to `i16`. Traps if `value` is outside the `i16` range. Use
/// this function when an out-of-range value is a program error.
pub fn toI16(value: u32) -> i16 {
  if let Option<i16>.Some {value: converted} = checkedToI16(value) { return converted }
  return Intrinsic.trap("u32.toI16: the value is outside the i16 range")
}

/// Converts `value` to `i16`, or returns `None` if `value` is outside the `i16`
/// range. Use this function when an out-of-range value is input data.
pub fn checkedToI16(value: u32) -> Option<i16> {
  return Intrinsic.u32CheckedToI16<Option<i16>>(value, Option.some, Option.none)
}

/// Converts `value` to `i32`. Traps if `value` is outside the `i32` range. Use
/// this function when an out-of-range value is a program error.
pub fn toI32(value: u32) -> i32 {
  if let Option<i32>.Some {value: converted} = checkedToI32(value) { return converted }
  return Intrinsic.trap("u32.toI32: the value is outside the i32 range")
}

/// Converts `value` to `i32`, or returns `None` if `value` is outside the `i32`
/// range. Use this function when an out-of-range value is input data.
pub fn checkedToI32(value: u32) -> Option<i32> {
  return Intrinsic.u32CheckedToI32<Option<i32>>(value, Option.some, Option.none)
}

/// Converts `value` exactly to `i64`. Every `u32` value is representable.
pub fn toI64(value: u32) -> i64 {
  if let Option<i64>.Some {value: converted} = checkedToI64(value) { return converted }
  return Intrinsic.trap("u32.toI64: the value is outside the i64 range")
}

/// Converts `value` exactly to `i64` and returns `Some`. Every `u32` value is
/// representable.
pub fn checkedToI64(value: u32) -> Option<i64> {
  return Intrinsic.u32CheckedToI64<Option<i64>>(value, Option.some, Option.none)
}

/// Converts `value` to `isize`. Traps if `value` is outside the `isize` range. Use
/// this function when an out-of-range value is a program error.
pub fn toIsize(value: u32) -> isize {
  if let Option<isize>.Some {value: converted} = checkedToIsize(value) { return converted }
  return Intrinsic.trap("u32.toIsize: the value is outside the isize range")
}

/// Converts `value` to `isize`, or returns `None` if `value` is outside the `isize`
/// range. Use this function when an out-of-range value is input data.
pub fn checkedToIsize(value: u32) -> Option<isize> {
  return Intrinsic.u32CheckedToIsize<Option<isize>>(value, Option.some, Option.none)
}

/// Converts `value` to the nearest `f32` value, with ties to even. Only magnitudes below `2^24` are
/// exactly representable, so a larger `u32` rounds.
pub fn toF32(value: u32) -> f32 {
  return Intrinsic.u32ToF32(value)
}

/// Converts `value` exactly to `f64`. Every `u32` value is below `2^53` and so is exactly
/// representable.
pub fn toF64(value: u32) -> f64 {
  return Intrinsic.u32ToF64(value)
}

/// Converts `value` to `u8` modulo 2^8. Keeps the low 8 bits of the two's complement
/// form of `value` and reads them as `u8`, so it never traps. Use this function for deliberate
/// truncation, sign extension, or bit reinterpretation, such as reading a signed field.
pub fn wrappingToU8(value: u32) -> u8 {
  return u64.wrappingToU8(wrappingToU64(value))
}

/// Converts `value` to `u16` modulo 2^16. Keeps the low 16 bits of the two's complement
/// form of `value` and reads them as `u16`, so it never traps. Use this function for deliberate
/// truncation, sign extension, or bit reinterpretation, such as reading a signed field.
pub fn wrappingToU16(value: u32) -> u16 {
  return u64.wrappingToU16(wrappingToU64(value))
}

/// Returns `value` unchanged. Use this function when generic wrapping-conversion code
/// can select `u32` as both source and destination.
pub fn wrappingToU32(value: u32) -> u32 {
  return value
}

/// Converts `value` to `u64` modulo 2^64. Keeps the low 64 bits of the two's complement
/// form of `value` and reads them as `u64`, so it never traps. Use this function for deliberate
/// truncation, sign extension, or bit reinterpretation, such as reading a signed field.
pub fn wrappingToU64(value: u32) -> u64 {
  return toU64(value)
}

/// Converts `value` to `usize` modulo 2^`usize.BITS`. Keeps the low `usize.BITS` bits of the two's
/// complement form of `value` and reads them as `usize`, so it never traps. Use this function for
/// deliberate truncation, sign extension, or bit reinterpretation, such as reading a signed field.
pub fn wrappingToUsize(value: u32) -> usize {
  return u64.wrappingToUsize(wrappingToU64(value))
}

/// Converts `value` to `i8` modulo 2^8. Keeps the low 8 bits of the two's complement
/// form of `value` and reads them as `i8`, so it never traps. Use this function for deliberate
/// truncation, sign extension, or bit reinterpretation, such as reading a signed field.
pub fn wrappingToI8(value: u32) -> i8 {
  return u64.wrappingToI8(wrappingToU64(value))
}

/// Converts `value` to `i16` modulo 2^16. Keeps the low 16 bits of the two's complement
/// form of `value` and reads them as `i16`, so it never traps. Use this function for deliberate
/// truncation, sign extension, or bit reinterpretation, such as reading a signed field.
pub fn wrappingToI16(value: u32) -> i16 {
  return u64.wrappingToI16(wrappingToU64(value))
}

/// Converts `value` to `i32` modulo 2^32. Keeps the low 32 bits of the two's complement
/// form of `value` and reads them as `i32`, so it never traps. Use this function for deliberate
/// truncation, sign extension, or bit reinterpretation, such as reading a signed field.
pub fn wrappingToI32(value: u32) -> i32 {
  return u64.wrappingToI32(wrappingToU64(value))
}

/// Converts `value` to `i64` modulo 2^64. Keeps the low 64 bits of the two's complement
/// form of `value` and reads them as `i64`, so it never traps. Use this function for deliberate
/// truncation, sign extension, or bit reinterpretation, such as reading a signed field.
pub fn wrappingToI64(value: u32) -> i64 {
  return u64.wrappingToI64(wrappingToU64(value))
}

/// Converts `value` to `isize` modulo 2^`isize.BITS`. Keeps the low `isize.BITS` bits of the two's
/// complement form of `value` and reads them as `isize`, so it never traps. Use this function for
/// deliberate truncation, sign extension, or bit reinterpretation, such as reading a signed field.
pub fn wrappingToIsize(value: u32) -> isize {
  return u64.wrappingToIsize(wrappingToU64(value))
}

/// Returns `left + right` and traps if the result is outside the `u32` range. Use this function
/// when overflow is a program error.
pub fn add(left: u32, right: u32) -> u32 {
  return Intrinsic.u32Add(left, right)
}

/// Returns `left - right` and traps if the result is outside the `u32` range. Use this function
/// when overflow is a program error.
pub fn subtract(left: u32, right: u32) -> u32 {
  return Intrinsic.u32Subtract(left, right)
}

/// Returns `left * right` and traps if the result is outside the `u32` range. Use this function
/// when overflow is a program error.
pub fn multiply(left: u32, right: u32) -> u32 {
  return Intrinsic.u32Multiply(left, right)
}

/// Returns `left / right`. Traps if `right` is zero. Use this function when a zero
/// divisor is a program error.
pub fn divide(left: u32, right: u32) -> u32 {
  return Intrinsic.u32Divide(left, right)
}

/// Returns the remainder of `left / right`. Traps if `right` is zero. Use this function
/// when a zero divisor is a program error.
pub fn remainder(left: u32, right: u32) -> u32 {
  return Intrinsic.u32Remainder(left, right)
}

/// Returns the bitwise AND of `left` and `right`.
pub fn bitAnd(left: u32, right: u32) -> u32 {
  return Intrinsic.u32BitAnd(left, right)
}

/// Returns the bitwise OR of `left` and `right`.
pub fn bitOr(left: u32, right: u32) -> u32 {
  return Intrinsic.u32BitOr(left, right)
}

/// Returns the bitwise exclusive OR of `left` and `right`.
pub fn bitXor(left: u32, right: u32) -> u32 {
  return Intrinsic.u32BitXor(left, right)
}

/// Returns `value` with each bit inverted.
pub fn bitNot(value: u32) -> u32 {
  return Intrinsic.u32BitNot(value)
}

/// Shifts `left` bits left by `right` positions. Traps if `right` is not less than [`BITS`].
pub fn shiftLeft(left: u32, right: u32) -> u32 {
  return Intrinsic.u32ShiftLeft(left, right)
}

/// Shifts `left` bits right by `right` positions and inserts zero bits. Traps if `right` is
/// not less than [`BITS`].
pub fn shiftRight(left: u32, right: u32) -> u32 {
  return Intrinsic.u32ShiftRight(left, right)
}

/// Rotates the bits of `left` left by `right` positions. The count is reduced modulo [`BITS`], so
/// each count is valid.
pub fn rotateLeft(left: u32, right: u32) -> u32 {
  return Intrinsic.u32RotateLeft(left, right)
}

/// Rotates the bits of `left` right by `right` positions. The count is reduced modulo [`BITS`], so
/// each count is valid.
pub fn rotateRight(left: u32, right: u32) -> u32 {
  return Intrinsic.u32RotateRight(left, right)
}

/// Returns the number of one bits in `value`.
pub fn countOnes(value: u32) -> u32 {
  return u64.countOnes(toU64(value))
}

/// Returns the number of zero bits above the highest one bit of `value`. Returns [`BITS`] for
/// zero.
pub fn leadingZeros(value: u32) -> u32 {
  return u64.leadingZeros(toU64(value)) - (64 - BITS)
}

/// Returns the number of zero bits below the lowest one bit of `value`. Returns [`BITS`] for zero.
pub fn trailingZeros(value: u32) -> u32 {
  if value == 0 { return BITS }
  return u64.trailingZeros(toU64(value))
}

/// Returns `left + right`, wrapped to the `u32` range. Use this function for
/// deliberate modulo arithmetic.
pub fn wrappingAdd(left: u32, right: u32) -> u32 {
  return Intrinsic.u32WrappingAdd(left, right)
}

/// Returns `left - right`, wrapped to the `u32` range. Use this function for
/// deliberate modulo arithmetic.
pub fn wrappingSubtract(left: u32, right: u32) -> u32 {
  return Intrinsic.u32WrappingSubtract(left, right)
}

/// Returns `left * right`, wrapped to the `u32` range. Use this function for
/// deliberate modulo arithmetic.
pub fn wrappingMultiply(left: u32, right: u32) -> u32 {
  return Intrinsic.u32WrappingMultiply(left, right)
}

/// Returns `left + right`, clamped to [`MIN`] or [`MAX`]. Use this function when a
/// boundary value is the required overflow result.
pub fn saturatingAdd(left: u32, right: u32) -> u32 {
  return Intrinsic.u32SaturatingAdd(left, right)
}

/// Returns `left - right`, clamped to [`MIN`] or [`MAX`]. Use this function when a
/// boundary value is the required overflow result.
pub fn saturatingSubtract(left: u32, right: u32) -> u32 {
  return Intrinsic.u32SaturatingSubtract(left, right)
}

/// Returns `left * right`, clamped to [`MIN`] or [`MAX`]. Use this function when a
/// boundary value is the required overflow result.
pub fn saturatingMultiply(left: u32, right: u32) -> u32 {
  return Intrinsic.u32SaturatingMultiply(left, right)
}

/// Returns `Some` with `left + right`, or `None` if the result is outside the `u32` range.
/// Use this function when overflow is input data.
pub fn checkedAdd(left: u32, right: u32) -> Option<u32> {
  return Intrinsic.u32CheckedAdd<Option<u32>>(left, right, Option.some, Option.none)
}

/// Returns `Some` with `left - right`, or `None` if the result is outside the `u32` range.
/// Use this function when overflow is input data.
pub fn checkedSubtract(left: u32, right: u32) -> Option<u32> {
  return Intrinsic.u32CheckedSubtract<Option<u32>>(left, right, Option.some, Option.none)
}

/// Returns `Some` with `left * right`, or `None` if the result is outside the `u32` range.
/// Use this function when overflow is input data.
pub fn checkedMultiply(left: u32, right: u32) -> Option<u32> {
  return Intrinsic.u32CheckedMultiply<Option<u32>>(left, right, Option.some, Option.none)
}

/// Returns `Some` with `left / right`, or `None` if `right` is zero. Use this
/// function when a zero divisor is input data.
pub fn checkedDivide(left: u32, right: u32) -> Option<u32> {
  return Intrinsic.u32CheckedDivide<Option<u32>>(left, right, Option.some, Option.none)
}

/// Returns `Some` with the remainder, or `None` if `right` is zero. Use this function
/// when a zero divisor is input data.
pub fn checkedRemainder(left: u32, right: u32) -> Option<u32> {
  return Intrinsic.u32CheckedRemainder<Option<u32>>(left, right, Option.some, Option.none)
}

/// Returns `true` if `left` and `right` are equal.
pub fn equals(left: u32, right: u32) -> bool {
  return Intrinsic.u32Equals(left, right)
}

/// Returns `true` if `left` and `right` are not equal.
pub fn notEquals(left: u32, right: u32) -> bool {
  return Intrinsic.u32NotEquals(left, right)
}

/// Returns `true` if `left` is less than `right`.
pub fn lessThan(left: u32, right: u32) -> bool {
  return Intrinsic.u32LessThan(&left, &right)
}

/// Returns `true` if `left` is less than or equal to `right`.
pub fn lessOrEqual(left: u32, right: u32) -> bool {
  return Intrinsic.u32LessOrEqual(left, right)
}

/// Returns `true` if `left` is greater than `right`.
pub fn greaterThan(left: u32, right: u32) -> bool {
  return Intrinsic.u32GreaterThan(left, right)
}

/// Returns `true` if `left` is greater than or equal to `right`.
pub fn greaterOrEqual(left: u32, right: u32) -> bool {
  return Intrinsic.u32GreaterOrEqual(left, right)
}

/// Returns the `u32` value of the decimal text `text`, or a `ParseError`.
///
/// # Details
///
/// The complete text must be one decimal number. This function does not skip spaces and does not
/// accept digit separators.
///
/// # Errors
///
/// - `ParseError` with reason `silk.format.NotANumber` if `text` is empty, has a sign, contains a
///   byte that is not a digit, or has bytes after the number. `offset` gives the byte position
///   where the read stopped.
/// - `ParseError` with reason `silk.format.OutOfRange` if the number is outside the range of `u32`.
pub fn parse(text: string) -> Result<u32, ParseError> {
  return Format.u32Value(text)
}
