//! Two-way conversions between a value and its form on the wire, and checks that refine them.
//!
//! # When to use
//! Implement [`Codec`] for a conversion that a format cannot do by itself, such as a port number
//! written as text. Run several steps in order with [`Codecs.chain2`] to [`Codecs.chain6`], and
//! attach a check to a step with [`Codecs.check`], so a multi-step conversion is written once and
//! runs in both directions.
//!
//! # Details
//! A `Codec<A, I>` decodes a wire value `I` into a value `A`, and encodes `A` back into `I`.
//! Decoding can fail with an [`Issue`]; encoding cannot, because a value that exists already passed
//! its checks. A chain is an ordinary value whose type records each step, such as
//! `Chain3<Trim, Refine<NumberText<u16>, ...>, PortOf, ...>`, so decoding is direct calls with no
//! codec object left at runtime.
//!
//! Decoding runs the steps from the wire form to the value, and encoding runs them the other way.
//! A check added with `Codecs.check` runs on decode only, on the value its step produced.
//!
//! # Gotchas
//! A step of a chain must not be another chain, and the codec inside `Codecs.check` must not be a
//! chain: the compiler rejects the nested specialization (`SEM0053`). Use one longer chain instead.
//!
//! # Examples
//! ## Read a port from text
//! ```silk
//! import silk.core.effect { Effect }
//! import silk.core.result { Result }
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.schema.codec { Between, Codec, Codecs, NumberText, Trim }
//! import silk.schema.issue { Issue }
//! import silk.text.string { String }
//!
//! effect fn port(text: string) -> u16 ! Issue | OutOfMemoryError ? &mut Allocator {
//!   let codec = Codecs.chain2(Trim {}, Codecs.check(NumberText<u16>.make(),
//!     Between<u16> {low: 1, high: 65535, message: "between 1 and 65535"}))
//!   return run Codec.decode(&codec, run String.copy(text))
//! }
//!
//! pub effect fn main() -> i32 ! OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let parsed = run Effect.result(port(" 8080 ")) |> Effect.provideMut<Allocator>(&mut allocator)
//!   return match move parsed {
//!     Result<u16, Issue | OutOfMemoryError>.Success {value} => if value == 8080 { 0 } else { 1 }
//!     Result<u16, Issue | OutOfMemoryError>.Failure {..} => 2
//!   }
//! }
//! ```
//!
//! @category Data formats

import silk.core.order { Order }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.schema.issue { Issue }
import silk.text.format { Format, ParseError, NotANumber, OutOfRange }
import silk.text.string { String }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.num.i8
import silk.num.i16
import silk.num.i32
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.usize
import silk.core.ownership { Copy }

/// A two-way conversion between a value `A` and its wire form `I`.
///
/// # When to use
///
/// Implement it for a conversion step, such as text to a number. Combine steps with
/// [`Codecs.chain2`] and [`Codecs.check`] rather than writing one large implementation.
///
/// # Details
///
/// `decode` takes the wire value by value, so owned text moves through a chain without copies.
/// `encode` borrows the value. A codec type usually has no fields, or holds the static settings of
/// its step, such as the bounds of a range.
pub interface Codec<A, I> {
  /// Converts the wire value `input` into a value.
  ///
  /// # Errors
  ///
  /// - `Issue` if `input` does not hold an acceptable value.
  /// - `OutOfMemoryError` if the value needs memory that the `Allocator` cannot supply.
  effect fn decode(self: &Self, input: I) -> A ! Issue | OutOfMemoryError ? &mut Allocator

  /// Converts `value` back into its wire form.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the wire form needs memory that the `Allocator` cannot supply.
  effect fn encode(self: &Self, value: &A) -> I ! OutOfMemoryError ? &mut Allocator
}

/// A test that a decoded value must pass, with the message a person sees when it fails.
///
/// # When to use
///
/// Implement it for a rule a type cannot express, such as a length limit, and attach it to a codec
/// with [`Codecs.check`].
pub interface Check<T> {
  /// Returns whether `value` passes.
  fn test(self: &Self, value: &T) -> bool

  /// Returns what the check expects, as one line for a person, such as `"between 1 and 64"`.
  fn message(self: &Self) -> string<'static>
}

/// Two codecs run one after the other, from the wire form `I` to the value `A`.
///
/// # Details
///
/// Build it with [`Codecs.chain2`]. Decoding runs `step1` first; encoding runs `step2` first.
pub struct Chain2<S1, S2, A, M1, I> {
  /// Step 1, next to the wire form.
  pub step1: S1,
  /// Step 2, next to the value.
  pub step2: S2,
  /// Empty. It names the value type `A`.
  pub value: [A; 0],
  /// Empty. It names the type between step 1 and step 2.
  pub between1: [M1; 0],
  /// Empty. It names the wire form `I`.
  pub wire: [I; 0],
}

impl<A, M1, I, S1: Codec<M1, I>, S2: Codec<A, M1>> Codec<A, I> for Chain2<S1, S2, A, M1, I> {
  /// Decodes with each step, from `step1` to `step2`.
  effect fn decode(self: &Self, input: I) -> A ! Issue | OutOfMemoryError ? &mut Allocator {
    let m1 = run Codec.decode(&self.step1, move input)
    return run Codec.decode(&self.step2, move m1)
  }

  /// Encodes with each step, from `step2` to `step1`.
  effect fn encode(self: &Self, value: &A) -> I ! OutOfMemoryError ? &mut Allocator {
    let m1 = run Codec.encode(&self.step2, value)
    return run Codec.encode(&self.step1, &m1)
  }
}

/// Three codecs run one after the other, from the wire form `I` to the value `A`.
///
/// # Details
///
/// Build it with [`Codecs.chain3`]. Decoding runs `step1` first; encoding runs `step3` first.
pub struct Chain3<S1, S2, S3, A, M1, M2, I> {
  /// Step 1, next to the wire form.
  pub step1: S1,
  /// Step 2.
  pub step2: S2,
  /// Step 3, next to the value.
  pub step3: S3,
  /// Empty. It names the value type `A`.
  pub value: [A; 0],
  /// Empty. It names the type between step 1 and step 2.
  pub between1: [M1; 0],
  /// Empty. It names the type between step 2 and step 3.
  pub between2: [M2; 0],
  /// Empty. It names the wire form `I`.
  pub wire: [I; 0],
}

impl<A, M1, M2, I, S1: Codec<M1, I>, S2: Codec<M2, M1>, S3: Codec<A, M2>> Codec<A, I> for Chain3<S1, S2, S3, A, M1, M2, I> {
  /// Decodes with each step, from `step1` to `step3`.
  effect fn decode(self: &Self, input: I) -> A ! Issue | OutOfMemoryError ? &mut Allocator {
    let m1 = run Codec.decode(&self.step1, move input)
    let m2 = run Codec.decode(&self.step2, move m1)
    return run Codec.decode(&self.step3, move m2)
  }

  /// Encodes with each step, from `step3` to `step1`.
  effect fn encode(self: &Self, value: &A) -> I ! OutOfMemoryError ? &mut Allocator {
    let m2 = run Codec.encode(&self.step3, value)
    let m1 = run Codec.encode(&self.step2, &m2)
    return run Codec.encode(&self.step1, &m1)
  }
}

/// Four codecs run one after the other, from the wire form `I` to the value `A`.
///
/// # Details
///
/// Build it with [`Codecs.chain4`]. Decoding runs `step1` first; encoding runs `step4` first.
pub struct Chain4<S1, S2, S3, S4, A, M1, M2, M3, I> {
  /// Step 1, next to the wire form.
  pub step1: S1,
  /// Step 2.
  pub step2: S2,
  /// Step 3.
  pub step3: S3,
  /// Step 4, next to the value.
  pub step4: S4,
  /// Empty. It names the value type `A`.
  pub value: [A; 0],
  /// Empty. It names the type between step 1 and step 2.
  pub between1: [M1; 0],
  /// Empty. It names the type between step 2 and step 3.
  pub between2: [M2; 0],
  /// Empty. It names the type between step 3 and step 4.
  pub between3: [M3; 0],
  /// Empty. It names the wire form `I`.
  pub wire: [I; 0],
}

impl<A, M1, M2, M3, I, S1: Codec<M1, I>, S2: Codec<M2, M1>, S3: Codec<M3, M2>, S4: Codec<A, M3>> Codec<A, I> for Chain4<S1, S2, S3, S4, A, M1, M2, M3, I> {
  /// Decodes with each step, from `step1` to `step4`.
  effect fn decode(self: &Self, input: I) -> A ! Issue | OutOfMemoryError ? &mut Allocator {
    let m1 = run Codec.decode(&self.step1, move input)
    let m2 = run Codec.decode(&self.step2, move m1)
    let m3 = run Codec.decode(&self.step3, move m2)
    return run Codec.decode(&self.step4, move m3)
  }

  /// Encodes with each step, from `step4` to `step1`.
  effect fn encode(self: &Self, value: &A) -> I ! OutOfMemoryError ? &mut Allocator {
    let m3 = run Codec.encode(&self.step4, value)
    let m2 = run Codec.encode(&self.step3, &m3)
    let m1 = run Codec.encode(&self.step2, &m2)
    return run Codec.encode(&self.step1, &m1)
  }
}

/// Five codecs run one after the other, from the wire form `I` to the value `A`.
///
/// # Details
///
/// Build it with [`Codecs.chain5`]. Decoding runs `step1` first; encoding runs `step5` first.
pub struct Chain5<S1, S2, S3, S4, S5, A, M1, M2, M3, M4, I> {
  /// Step 1, next to the wire form.
  pub step1: S1,
  /// Step 2.
  pub step2: S2,
  /// Step 3.
  pub step3: S3,
  /// Step 4.
  pub step4: S4,
  /// Step 5, next to the value.
  pub step5: S5,
  /// Empty. It names the value type `A`.
  pub value: [A; 0],
  /// Empty. It names the type between step 1 and step 2.
  pub between1: [M1; 0],
  /// Empty. It names the type between step 2 and step 3.
  pub between2: [M2; 0],
  /// Empty. It names the type between step 3 and step 4.
  pub between3: [M3; 0],
  /// Empty. It names the type between step 4 and step 5.
  pub between4: [M4; 0],
  /// Empty. It names the wire form `I`.
  pub wire: [I; 0],
}

impl<A, M1, M2, M3, M4, I, S1: Codec<M1, I>, S2: Codec<M2, M1>, S3: Codec<M3, M2>, S4: Codec<M4, M3>, S5: Codec<A, M4>> Codec<A, I> for Chain5<S1, S2, S3, S4, S5, A, M1, M2, M3, M4, I> {
  /// Decodes with each step, from `step1` to `step5`.
  effect fn decode(self: &Self, input: I) -> A ! Issue | OutOfMemoryError ? &mut Allocator {
    let m1 = run Codec.decode(&self.step1, move input)
    let m2 = run Codec.decode(&self.step2, move m1)
    let m3 = run Codec.decode(&self.step3, move m2)
    let m4 = run Codec.decode(&self.step4, move m3)
    return run Codec.decode(&self.step5, move m4)
  }

  /// Encodes with each step, from `step5` to `step1`.
  effect fn encode(self: &Self, value: &A) -> I ! OutOfMemoryError ? &mut Allocator {
    let m4 = run Codec.encode(&self.step5, value)
    let m3 = run Codec.encode(&self.step4, &m4)
    let m2 = run Codec.encode(&self.step3, &m3)
    let m1 = run Codec.encode(&self.step2, &m2)
    return run Codec.encode(&self.step1, &m1)
  }
}

/// Six codecs run one after the other, from the wire form `I` to the value `A`.
///
/// # Details
///
/// Build it with [`Codecs.chain6`]. Decoding runs `step1` first; encoding runs `step6` first.
pub struct Chain6<S1, S2, S3, S4, S5, S6, A, M1, M2, M3, M4, M5, I> {
  /// Step 1, next to the wire form.
  pub step1: S1,
  /// Step 2.
  pub step2: S2,
  /// Step 3.
  pub step3: S3,
  /// Step 4.
  pub step4: S4,
  /// Step 5.
  pub step5: S5,
  /// Step 6, next to the value.
  pub step6: S6,
  /// Empty. It names the value type `A`.
  pub value: [A; 0],
  /// Empty. It names the type between step 1 and step 2.
  pub between1: [M1; 0],
  /// Empty. It names the type between step 2 and step 3.
  pub between2: [M2; 0],
  /// Empty. It names the type between step 3 and step 4.
  pub between3: [M3; 0],
  /// Empty. It names the type between step 4 and step 5.
  pub between4: [M4; 0],
  /// Empty. It names the type between step 5 and step 6.
  pub between5: [M5; 0],
  /// Empty. It names the wire form `I`.
  pub wire: [I; 0],
}

impl<A, M1, M2, M3, M4, M5, I, S1: Codec<M1, I>, S2: Codec<M2, M1>, S3: Codec<M3, M2>, S4: Codec<M4, M3>, S5: Codec<M5, M4>, S6: Codec<A, M5>> Codec<A, I> for Chain6<S1, S2, S3, S4, S5, S6, A, M1, M2, M3, M4, M5, I> {
  /// Decodes with each step, from `step1` to `step6`.
  effect fn decode(self: &Self, input: I) -> A ! Issue | OutOfMemoryError ? &mut Allocator {
    let m1 = run Codec.decode(&self.step1, move input)
    let m2 = run Codec.decode(&self.step2, move m1)
    let m3 = run Codec.decode(&self.step3, move m2)
    let m4 = run Codec.decode(&self.step4, move m3)
    let m5 = run Codec.decode(&self.step5, move m4)
    return run Codec.decode(&self.step6, move m5)
  }

  /// Encodes with each step, from `step6` to `step1`.
  effect fn encode(self: &Self, value: &A) -> I ! OutOfMemoryError ? &mut Allocator {
    let m5 = run Codec.encode(&self.step6, value)
    let m4 = run Codec.encode(&self.step5, &m5)
    let m3 = run Codec.encode(&self.step4, &m4)
    let m2 = run Codec.encode(&self.step3, &m3)
    let m1 = run Codec.encode(&self.step2, &m2)
    return run Codec.encode(&self.step1, &m1)
  }
}

/// A codec whose decoded values must also pass a check.
///
/// # Details
///
/// Build it with [`Codecs.check`]. Encoding does not run the check.
pub struct Refine<C, K, A, I> {
  /// The codec that produces the value.
  pub codec: C,
  /// The check the decoded value must pass.
  pub check: K,
  /// Empty. It names the value type `A`; `wire` names the wire form.
  pub value: [A; 0],
  /// Empty.
  pub wire: [I; 0],
}

impl<A, I, C: Codec<A, I>, K: Check<A>> Codec<A, I> for Refine<C, K, A, I> {
  /// Decodes with the codec, then fails with `Issue.checkFailed` if the check rejects the value.
  effect fn decode(self: &Self, input: I) -> A ! Issue | OutOfMemoryError ? &mut Allocator {
    let value = run Codec.decode(&self.codec, move input)
    if !Check.test(&self.check, &value) { fail Issue.checkFailed(Check.message(&self.check)) }
    return move value
  }

  /// Encodes with the codec. The check does not run.
  effect fn encode(self: &Self, value: &A) -> I ! OutOfMemoryError ? &mut Allocator {
    return run Codec.encode(&self.codec, value)
  }
}

/// The codec that leaves a value as it is. Use it to start a chain that only checks.
pub struct Identity {}

impl<T: Copy> Codec<T, T> for Identity {
  /// Returns `input`.
  effect fn decode(self: &Self, input: T) -> T ! Issue | OutOfMemoryError ? &mut Allocator {
    return input
  }

  /// Returns a copy of `value`.
  effect fn encode(self: &Self, value: &T) -> T ! OutOfMemoryError ? &mut Allocator {
    return value.*
  }
}

/// The codec that removes white space at both ends of text when decoding. Encoding copies the text
/// unchanged.
pub struct Trim {}

impl Codec<String, String> for Trim {
  /// Returns `input` without white space at either end.
  effect fn decode(self: &Self, input: String) -> String ! Issue | OutOfMemoryError ? &mut Allocator {
    let view = input.view()
    let trimmed = String.trim(view)
    if String.byteLength(trimmed) == String.byteLength(view) { return move input }
    return run String.copy(trimmed)
  }

  /// Returns a copy of `value`.
  effect fn encode(self: &Self, value: &String) -> String ! OutOfMemoryError ? &mut Allocator {
    return run String.copy(value.view())
  }
}

/// The codec between an integer and its decimal text, such as `"8080"` and `8080`.
///
/// # Details
///
/// It is implemented for `u8`, `u16`, `u32`, `u64`, `usize`, `i8`, `i16`, `i32` and `i64`. Decoding
/// accepts an optional sign and decimal digits, and fails with `IssueReason.InvalidType` for other
/// text and `IssueReason.InvalidValue` for a number that does not fit.
pub struct NumberText<T> {
  /// Empty. It names the integer type.
  pub kind: [T; 0],
}

impl<T> NumberText<T> {
  /// Returns the codec for the integer type `T`.
  pub fn make() -> NumberText<T> {
    return NumberText<T> {kind: []}
  }
}

fn parsed<T>(text: string, parse: fn(string) -> Result<T, ParseError>) -> Result<T, Issue> {
  return match move parse(text) {
    Result<T, ParseError>.Success {value} => Result<T, Issue>.succeed(move value)
    Result<T, ParseError>.Failure {error} => match move error.reason {
      NotANumber {..} => Result<T, Issue>.failResult(Issue.invalidType("a decimal integer"))
      OutOfRange {} => Result<T, Issue>.failResult(Issue.invalidValue("an integer in range"))
    }
  }
}

effect fn decodedNumber<T>(input: String, parse: fn(string) -> Result<T, ParseError>) -> T ! Issue {
  return match move parsed<T>(input.view(), parse) {
    Result<T, Issue>.Success {value} => move value
    Result<T, Issue>.Failure {error} => { fail error }
  }
}

effect fn unsignedText(value: u64) -> String ! OutOfMemoryError ? &mut Allocator {
  let mut digits: [u8; 24] = [0; 24]
  let end = Format.writeU64Display(value, &mut digits, usize.ZERO)
  return run String.copy(unsafe Intrinsic.stringFromUtf8Unchecked(Slice.view<u8>(&digits, usize.ZERO, end)))
}

effect fn signedText(value: i64) -> String ! OutOfMemoryError ? &mut Allocator {
  let mut digits: [u8; 24] = [0; 24]
  let end = Format.writeI64Display(value, &mut digits, usize.ZERO)
  return run String.copy(unsafe Intrinsic.stringFromUtf8Unchecked(Slice.view<u8>(&digits, usize.ZERO, end)))
}

impl Codec<u8, String> for NumberText<u8> {
  /// Parses decimal text.
  effect fn decode(self: &Self, input: String) -> u8 ! Issue | OutOfMemoryError ? &mut Allocator {
    return run decodedNumber<u8>(move input, Format.u8Value)
  }

  /// Writes the decimal digits.
  effect fn encode(self: &Self, value: &u8) -> String ! OutOfMemoryError ? &mut Allocator {
    return run unsignedText(u8.toU64(value.*))
  }
}

impl Codec<u16, String> for NumberText<u16> {
  /// Parses decimal text.
  effect fn decode(self: &Self, input: String) -> u16 ! Issue | OutOfMemoryError ? &mut Allocator {
    return run decodedNumber<u16>(move input, Format.u16Value)
  }

  /// Writes the decimal digits.
  effect fn encode(self: &Self, value: &u16) -> String ! OutOfMemoryError ? &mut Allocator {
    return run unsignedText(u16.toU64(value.*))
  }
}

impl Codec<u32, String> for NumberText<u32> {
  /// Parses decimal text.
  effect fn decode(self: &Self, input: String) -> u32 ! Issue | OutOfMemoryError ? &mut Allocator {
    return run decodedNumber<u32>(move input, Format.u32Value)
  }

  /// Writes the decimal digits.
  effect fn encode(self: &Self, value: &u32) -> String ! OutOfMemoryError ? &mut Allocator {
    return run unsignedText(u32.toU64(value.*))
  }
}

impl Codec<u64, String> for NumberText<u64> {
  /// Parses decimal text.
  effect fn decode(self: &Self, input: String) -> u64 ! Issue | OutOfMemoryError ? &mut Allocator {
    return run decodedNumber<u64>(move input, Format.u64Value)
  }

  /// Writes the decimal digits.
  effect fn encode(self: &Self, value: &u64) -> String ! OutOfMemoryError ? &mut Allocator {
    return run unsignedText(value.*)
  }
}

impl Codec<usize, String> for NumberText<usize> {
  /// Parses decimal text.
  effect fn decode(self: &Self, input: String) -> usize ! Issue | OutOfMemoryError ? &mut Allocator {
    return run decodedNumber<usize>(move input, Format.usizeValue)
  }

  /// Writes the decimal digits.
  effect fn encode(self: &Self, value: &usize) -> String ! OutOfMemoryError ? &mut Allocator {
    return run unsignedText(usize.toU64(value.*))
  }
}

impl Codec<i8, String> for NumberText<i8> {
  /// Parses decimal text with an optional sign.
  effect fn decode(self: &Self, input: String) -> i8 ! Issue | OutOfMemoryError ? &mut Allocator {
    return run decodedNumber<i8>(move input, Format.i8Value)
  }

  /// Writes the decimal digits, with `-` for a negative value.
  effect fn encode(self: &Self, value: &i8) -> String ! OutOfMemoryError ? &mut Allocator {
    return run signedText(i8.toI64(value.*))
  }
}

impl Codec<i16, String> for NumberText<i16> {
  /// Parses decimal text with an optional sign.
  effect fn decode(self: &Self, input: String) -> i16 ! Issue | OutOfMemoryError ? &mut Allocator {
    return run decodedNumber<i16>(move input, Format.i16Value)
  }

  /// Writes the decimal digits, with `-` for a negative value.
  effect fn encode(self: &Self, value: &i16) -> String ! OutOfMemoryError ? &mut Allocator {
    return run signedText(i16.toI64(value.*))
  }
}

impl Codec<i32, String> for NumberText<i32> {
  /// Parses decimal text with an optional sign.
  effect fn decode(self: &Self, input: String) -> i32 ! Issue | OutOfMemoryError ? &mut Allocator {
    return run decodedNumber<i32>(move input, Format.i32Value)
  }

  /// Writes the decimal digits, with `-` for a negative value.
  effect fn encode(self: &Self, value: &i32) -> String ! OutOfMemoryError ? &mut Allocator {
    return run signedText(i32.toI64(value.*))
  }
}

impl Codec<i64, String> for NumberText<i64> {
  /// Parses decimal text with an optional sign.
  effect fn decode(self: &Self, input: String) -> i64 ! Issue | OutOfMemoryError ? &mut Allocator {
    return run decodedNumber<i64>(move input, Format.i64Value)
  }

  /// Writes the decimal digits, with `-` for a negative value.
  effect fn encode(self: &Self, value: &i64) -> String ! OutOfMemoryError ? &mut Allocator {
    return run signedText(value.*)
  }
}

/// The check that a value lies between `low` and `high`, both included.
pub struct Between<T> {
  /// The smallest accepted value.
  pub low: T,
  /// The largest accepted value.
  pub high: T,
  /// What a person sees when the check fails, such as `"between 1 and 65535"`.
  pub message: string<'static>,
}

impl<T: Order> Check<T> for Between<T> {
  /// Returns whether `low <= value <= high`.
  fn test(self: &Self, value: &T) -> bool {
    return &self.low <= value && value <= &self.high
  }

  /// Returns `message`.
  fn message(self: &Self) -> string<'static> {
    return self.message
  }
}

/// The check that text has between `min` and `max` bytes of UTF-8, both included.
pub struct Length {
  /// The smallest accepted length in bytes.
  pub min: usize,
  /// The largest accepted length in bytes.
  pub max: usize,
  /// What a person sees when the check fails, such as `"1 to 64 bytes"`.
  pub message: string<'static>,
}

impl Check<String> for Length {
  /// Returns whether the byte length of `value` is between `min` and `max`.
  fn test(self: &Self, value: &String) -> bool {
    let length = String.byteLength(value.view())
    return length >= self.min && length <= self.max
  }

  /// Returns `message`.
  fn message(self: &Self) -> string<'static> {
    return self.message
  }
}

/// The check that a list of `T` has between `min` and `max` elements, both included.
///
/// # When to use
///
/// Build it with [`Items.between`], such as `Items<String>.between(1, 8, "1 to 8 tags")`.
pub struct Items<T> {
  min: usize,
  max: usize,
  message: string<'static>,
  element: [T; 0],
}

impl<T> Items<T> {
  /// Returns the check for `min` to `max` elements. `message` is what a person sees when it fails.
  pub fn between(min: usize, max: usize, message: string<'static>) -> Items<T> {
    return Items<T> {min: min, max: max, message: message, element: []}
  }
}

impl<T> Check<List<T>> for Items<T> {
  /// Returns whether `value` has between `min` and `max` elements.
  fn test(self: &Self, value: &List<T>) -> bool {
    let count = List<T>.length(value)
    return count >= self.min && count <= self.max
  }

  /// Returns the message.
  fn message(self: &Self) -> string<'static> {
    return self.message
  }
}

/// The owner of the functions that combine codecs. It has no fields and is never constructed.
pub struct Codecs {}

impl Codecs {
  /// Returns the codec that runs two steps in order: decoding from `step1` to `step2`, and
  /// encoding the other way.
  ///
  /// # Details
  ///
  /// Each step's value must be the next step's wire form. A mismatch is a type error at the call.
  pub fn chain2<A, M1, I, S1: Codec<M1, I>, S2: Codec<A, M1>>(step1: S1, step2: S2) -> Chain2<S1, S2, A, M1, I> {
    return Chain2<S1, S2, A, M1, I> {step1: move step1, step2: move step2, value: [], between1: [], wire: []}
  }

  /// Returns the codec that runs three steps in order: decoding from `step1` to `step3`, and
  /// encoding the other way.
  ///
  /// # Details
  ///
  /// Each step's value must be the next step's wire form. A mismatch is a type error at the call.
  pub fn chain3<A, M1, M2, I, S1: Codec<M1, I>, S2: Codec<M2, M1>, S3: Codec<A, M2>>(step1: S1, step2: S2, step3: S3) -> Chain3<S1, S2, S3, A, M1, M2, I> {
    return Chain3<S1, S2, S3, A, M1, M2, I> {step1: move step1, step2: move step2, step3: move step3, value: [], between1: [], between2: [], wire: []}
  }

  /// Returns the codec that runs four steps in order: decoding from `step1` to `step4`, and
  /// encoding the other way.
  ///
  /// # Details
  ///
  /// Each step's value must be the next step's wire form. A mismatch is a type error at the call.
  pub fn chain4<A, M1, M2, M3, I, S1: Codec<M1, I>, S2: Codec<M2, M1>, S3: Codec<M3, M2>, S4: Codec<A, M3>>(step1: S1, step2: S2, step3: S3, step4: S4) -> Chain4<S1, S2, S3, S4, A, M1, M2, M3, I> {
    return Chain4<S1, S2, S3, S4, A, M1, M2, M3, I> {step1: move step1, step2: move step2, step3: move step3, step4: move step4, value: [], between1: [], between2: [], between3: [], wire: []}
  }

  /// Returns the codec that runs five steps in order: decoding from `step1` to `step5`, and
  /// encoding the other way.
  ///
  /// # Details
  ///
  /// Each step's value must be the next step's wire form. A mismatch is a type error at the call.
  pub fn chain5<A, M1, M2, M3, M4, I, S1: Codec<M1, I>, S2: Codec<M2, M1>, S3: Codec<M3, M2>, S4: Codec<M4, M3>, S5: Codec<A, M4>>(step1: S1, step2: S2, step3: S3, step4: S4, step5: S5) -> Chain5<S1, S2, S3, S4, S5, A, M1, M2, M3, M4, I> {
    return Chain5<S1, S2, S3, S4, S5, A, M1, M2, M3, M4, I> {step1: move step1, step2: move step2, step3: move step3, step4: move step4, step5: move step5, value: [], between1: [], between2: [], between3: [], between4: [], wire: []}
  }

  /// Returns the codec that runs six steps in order: decoding from `step1` to `step6`, and
  /// encoding the other way.
  ///
  /// # Details
  ///
  /// Each step's value must be the next step's wire form. A mismatch is a type error at the call.
  pub fn chain6<A, M1, M2, M3, M4, M5, I, S1: Codec<M1, I>, S2: Codec<M2, M1>, S3: Codec<M3, M2>, S4: Codec<M4, M3>, S5: Codec<M5, M4>, S6: Codec<A, M5>>(step1: S1, step2: S2, step3: S3, step4: S4, step5: S5, step6: S6) -> Chain6<S1, S2, S3, S4, S5, S6, A, M1, M2, M3, M4, M5, I> {
    return Chain6<S1, S2, S3, S4, S5, S6, A, M1, M2, M3, M4, M5, I> {step1: move step1, step2: move step2, step3: move step3, step4: move step4, step5: move step5, step6: move step6, value: [], between1: [], between2: [], between3: [], between4: [], between5: [], wire: []}
  }

  /// Returns the codec that decodes with `codec` and fails if `check` rejects the value.
  ///
  /// # Details
  ///
  /// Encoding uses `codec` alone, because a value that exists already passed the check.
  pub fn check<A, I, C: Codec<A, I>, K: Check<A>>(codec: C, check: K) -> Refine<C, K, A, I> {
    return Refine<C, K, A, I> {codec: move codec, check: move check, value: [], wire: []}
  }
}
