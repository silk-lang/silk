//! One reader and one writer type that every format of `silk.schema` goes through.
//!
//! # When to use
//! Use `WireReader` or `WireWriter` when code that reads or writes a `Schema` type picks its format
//! at run time. `SchemaJson`, `SchemaToml`, `SchemaYaml` and `SchemaMsgpack` already read and write through them.
//!
//! # Details
//! A derived `Schema.read` is compiled once for each reader type it is used with, and a derived
//! `Schema.write` once for each writer type. Because the formats share these two types, a
//! type gets one reader and one writer however many formats a program uses. Each operation
//! forwards to the reader or writer of the format it holds, so what is read, written and reported
//! is that format's own.
//!
//! @category Data formats

import silk.collections.bytes { Bytes }
import silk.core.option { Option }
import silk.io.writer { Writer, WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.schema.issue { Issue, Span, ValueKind }
import silk.schema.json { JsonSchemaReader, JsonSchemaWriter }
import silk.schema.msgpack { MsgpackSchemaReader, MsgpackSchemaWriter }
import silk.schema.path { SchemaPath }
import silk.schema.schema { SchemaReader, SchemaWriter }
import silk.schema.toml { TomlSchemaReader, TomlSchemaWriter }
import silk.schema.yaml { YamlSchemaReader, YamlSchemaWriter }
import silk.text.string { String }

/// The reader of one of the formats.
pub union WireReader<'input> {
  Json { pub reader: JsonSchemaReader<'input> },
  Toml { pub reader: TomlSchemaReader<'input> },
  Yaml { pub reader: YamlSchemaReader<'input> },
  Msgpack { pub reader: MsgpackSchemaReader<'input> },
}

impl<'input> WireReader<'input> {
  /// Returns the JSON reader this holds. Traps if it holds another format's.
  pub fn json<'reader>(self: &'reader mut Self) -> &'reader mut JsonSchemaReader<'input> {
    return match &mut self.* {
      WireReader.Json { reader } => &mut reader
      _ => Intrinsic.trap("WireReader.json: not a JSON reader")
    }
  }

  /// Takes the JSON reader out. Traps if this holds another format's.
  pub fn intoJson(self: Self) -> JsonSchemaReader<'input> {
    return match move self {
      WireReader.Json { reader } => move reader
      _ => Intrinsic.trap("WireReader.intoJson: not a JSON reader")
    }
  }

  /// Takes the TOML reader out. Traps if this holds another format's.
  pub fn intoToml(self: Self) -> TomlSchemaReader<'input> {
    return match move self {
      WireReader.Toml { reader } => move reader
      _ => Intrinsic.trap("WireReader.intoToml: not a TOML reader")
    }
  }

  /// Takes the YAML reader out. Traps if this holds another format's.
  pub fn intoYaml(self: Self) -> YamlSchemaReader<'input> {
    return match move self {
      WireReader.Yaml { reader } => move reader
      _ => Intrinsic.trap("WireReader.intoYaml: not a YAML reader")
    }
  }

  /// Returns the MessagePack reader this holds. Traps if it holds another format's.
  pub fn msgpack<'reader>(self: &'reader mut Self) -> &'reader mut MsgpackSchemaReader<'input> {
    return match &mut self.* {
      WireReader.Msgpack { reader } => &mut reader
      _ => Intrinsic.trap("WireReader.msgpack: not a MessagePack reader")
    }
  }

  /// Takes the MessagePack reader out. Traps if this holds another format's.
  pub fn intoMsgpack(self: Self) -> MsgpackSchemaReader<'input> {
    return match move self {
      WireReader.Msgpack { reader } => move reader
      _ => Intrinsic.trap("WireReader.intoMsgpack: not a MessagePack reader")
    }
  }
}

impl<'input> SchemaReader for WireReader<'input> {
  fn taggedOptions(self: &Self) -> bool {
    return match &self.* {
      WireReader.Json { reader } => SchemaReader.taggedOptions(&reader)
      WireReader.Toml { reader } => SchemaReader.taggedOptions(&reader)
      WireReader.Yaml { reader } => SchemaReader.taggedOptions(&reader)
      WireReader.Msgpack { reader } => SchemaReader.taggedOptions(&reader)
    }
  }

  fn path(self: &mut Self) -> &mut SchemaPath {
    return match &mut self.* {
      WireReader.Json { reader } => SchemaReader.path(&mut reader)
      WireReader.Toml { reader } => SchemaReader.path(&mut reader)
      WireReader.Yaml { reader } => SchemaReader.path(&mut reader)
      WireReader.Msgpack { reader } => SchemaReader.path(&mut reader)
    }
  }

  effect fn boolean(self: &mut Self) -> bool ! Issue | OutOfMemoryError ? &mut Allocator {
    return match &mut self.* {
      WireReader.Json { reader } => run SchemaReader.boolean(&mut reader)
      WireReader.Toml { reader } => run SchemaReader.boolean(&mut reader)
      WireReader.Yaml { reader } => run SchemaReader.boolean(&mut reader)
      WireReader.Msgpack { reader } => run SchemaReader.boolean(&mut reader)
    }
  }

  effect fn signed(self: &mut Self) -> i64 ! Issue | OutOfMemoryError ? &mut Allocator {
    return match &mut self.* {
      WireReader.Json { reader } => run SchemaReader.signed(&mut reader)
      WireReader.Toml { reader } => run SchemaReader.signed(&mut reader)
      WireReader.Yaml { reader } => run SchemaReader.signed(&mut reader)
      WireReader.Msgpack { reader } => run SchemaReader.signed(&mut reader)
    }
  }

  effect fn unsigned(self: &mut Self) -> u64 ! Issue | OutOfMemoryError ? &mut Allocator {
    return match &mut self.* {
      WireReader.Json { reader } => run SchemaReader.unsigned(&mut reader)
      WireReader.Toml { reader } => run SchemaReader.unsigned(&mut reader)
      WireReader.Yaml { reader } => run SchemaReader.unsigned(&mut reader)
      WireReader.Msgpack { reader } => run SchemaReader.unsigned(&mut reader)
    }
  }

  effect fn float(self: &mut Self) -> f64 ! Issue | OutOfMemoryError ? &mut Allocator {
    return match &mut self.* {
      WireReader.Json { reader } => run SchemaReader.float(&mut reader)
      WireReader.Toml { reader } => run SchemaReader.float(&mut reader)
      WireReader.Yaml { reader } => run SchemaReader.float(&mut reader)
      WireReader.Msgpack { reader } => run SchemaReader.float(&mut reader)
    }
  }

  effect fn text(self: &mut Self) -> String ! Issue | OutOfMemoryError ? &mut Allocator {
    return match &mut self.* {
      WireReader.Json { reader } => run SchemaReader.text(&mut reader)
      WireReader.Toml { reader } => run SchemaReader.text(&mut reader)
      WireReader.Yaml { reader } => run SchemaReader.text(&mut reader)
      WireReader.Msgpack { reader } => run SchemaReader.text(&mut reader)
    }
  }

  effect fn bytes(self: &mut Self) -> Bytes ! Issue | OutOfMemoryError ? &mut Allocator {
    return match &mut self.* {
      WireReader.Json { reader } => run SchemaReader.bytes(&mut reader)
      WireReader.Toml { reader } => run SchemaReader.bytes(&mut reader)
      WireReader.Yaml { reader } => run SchemaReader.bytes(&mut reader)
      WireReader.Msgpack { reader } => run SchemaReader.bytes(&mut reader)
    }
  }

  effect fn null(self: &mut Self) -> bool ! Issue | OutOfMemoryError ? &mut Allocator {
    return match &mut self.* {
      WireReader.Json { reader } => run SchemaReader.null(&mut reader)
      WireReader.Toml { reader } => run SchemaReader.null(&mut reader)
      WireReader.Yaml { reader } => run SchemaReader.null(&mut reader)
      WireReader.Msgpack { reader } => run SchemaReader.null(&mut reader)
    }
  }

  effect fn beginList(self: &mut Self) -> () ! Issue | OutOfMemoryError ? &mut Allocator {
    return match &mut self.* {
      WireReader.Json { reader } => run SchemaReader.beginList(&mut reader)
      WireReader.Toml { reader } => run SchemaReader.beginList(&mut reader)
      WireReader.Yaml { reader } => run SchemaReader.beginList(&mut reader)
      WireReader.Msgpack { reader } => run SchemaReader.beginList(&mut reader)
    }
  }

  effect fn nextElement(self: &mut Self) -> bool ! Issue | OutOfMemoryError ? &mut Allocator {
    return match &mut self.* {
      WireReader.Json { reader } => run SchemaReader.nextElement(&mut reader)
      WireReader.Toml { reader } => run SchemaReader.nextElement(&mut reader)
      WireReader.Yaml { reader } => run SchemaReader.nextElement(&mut reader)
      WireReader.Msgpack { reader } => run SchemaReader.nextElement(&mut reader)
    }
  }

  effect fn beginObject(self: &mut Self) -> () ! Issue | OutOfMemoryError ? &mut Allocator {
    return match &mut self.* {
      WireReader.Json { reader } => run SchemaReader.beginObject(&mut reader)
      WireReader.Toml { reader } => run SchemaReader.beginObject(&mut reader)
      WireReader.Yaml { reader } => run SchemaReader.beginObject(&mut reader)
      WireReader.Msgpack { reader } => run SchemaReader.beginObject(&mut reader)
    }
  }

  effect fn member(self: &mut Self, key: string) -> bool ! Issue | OutOfMemoryError ? &mut Allocator {
    return match &mut self.* {
      WireReader.Json { reader } => run SchemaReader.member(&mut reader, key)
      WireReader.Toml { reader } => run SchemaReader.member(&mut reader, key)
      WireReader.Yaml { reader } => run SchemaReader.member(&mut reader, key)
      WireReader.Msgpack { reader } => run SchemaReader.member(&mut reader, key)
    }
  }

  effect fn nextMember(self: &mut Self) -> Option<String> ! Issue | OutOfMemoryError ? &mut Allocator {
    return match &mut self.* {
      WireReader.Json { reader } => run SchemaReader.nextMember(&mut reader)
      WireReader.Toml { reader } => run SchemaReader.nextMember(&mut reader)
      WireReader.Yaml { reader } => run SchemaReader.nextMember(&mut reader)
      WireReader.Msgpack { reader } => run SchemaReader.nextMember(&mut reader)
    }
  }

  effect fn rejectUnread(self: &mut Self, expected: string<'static>) -> () ! Issue | OutOfMemoryError ? &mut Allocator {
    return match &mut self.* {
      WireReader.Json { reader } => run SchemaReader.rejectUnread(&mut reader, expected)
      WireReader.Toml { reader } => run SchemaReader.rejectUnread(&mut reader, expected)
      WireReader.Yaml { reader } => run SchemaReader.rejectUnread(&mut reader, expected)
      WireReader.Msgpack { reader } => run SchemaReader.rejectUnread(&mut reader, expected)
    }
  }

  effect fn endObject(self: &mut Self) -> () ! Issue | OutOfMemoryError ? &mut Allocator {
    return match &mut self.* {
      WireReader.Json { reader } => run SchemaReader.endObject(&mut reader)
      WireReader.Toml { reader } => run SchemaReader.endObject(&mut reader)
      WireReader.Yaml { reader } => run SchemaReader.endObject(&mut reader)
      WireReader.Msgpack { reader } => run SchemaReader.endObject(&mut reader)
    }
  }

  fn lastSpan(self: &Self) -> Option<Span> {
    return match &self.* {
      WireReader.Json { reader } => SchemaReader.lastSpan(&reader)
      WireReader.Toml { reader } => SchemaReader.lastSpan(&reader)
      WireReader.Yaml { reader } => SchemaReader.lastSpan(&reader)
      WireReader.Msgpack { reader } => SchemaReader.lastSpan(&reader)
    }
  }

  fn lastKind(self: &Self) -> ValueKind {
    return match &self.* {
      WireReader.Json { reader } => SchemaReader.lastKind(&reader)
      WireReader.Toml { reader } => SchemaReader.lastKind(&reader)
      WireReader.Yaml { reader } => SchemaReader.lastKind(&reader)
      WireReader.Msgpack { reader } => SchemaReader.lastKind(&reader)
    }
  }

  effect fn report(self: &mut Self, issue: Issue) -> () ! Issue | OutOfMemoryError ? &mut Allocator {
    return match &mut self.* {
      WireReader.Json { reader } => run SchemaReader.report(&mut reader, issue)
      WireReader.Toml { reader } => run SchemaReader.report(&mut reader, issue)
      WireReader.Yaml { reader } => run SchemaReader.report(&mut reader, issue)
      WireReader.Msgpack { reader } => run SchemaReader.report(&mut reader, issue)
    }
  }

  fn collecting(self: &Self) -> bool {
    return match &self.* {
      WireReader.Json { reader } => SchemaReader.collecting(&reader)
      WireReader.Toml { reader } => SchemaReader.collecting(&reader)
      WireReader.Yaml { reader } => SchemaReader.collecting(&reader)
      WireReader.Msgpack { reader } => SchemaReader.collecting(&reader)
    }
  }

  effect fn mark(self: &mut Self) -> usize ! OutOfMemoryError ? &mut Allocator {
    return match &mut self.* {
      WireReader.Json { reader } => run SchemaReader.mark(&mut reader)
      WireReader.Toml { reader } => run SchemaReader.mark(&mut reader)
      WireReader.Yaml { reader } => run SchemaReader.mark(&mut reader)
      WireReader.Msgpack { reader } => run SchemaReader.mark(&mut reader)
    }
  }

  effect fn recover(self: &mut Self, mark: usize, skip: bool) -> () ! Issue | OutOfMemoryError ? &mut Allocator {
    return match &mut self.* {
      WireReader.Json { reader } => run SchemaReader.recover(&mut reader, mark, skip)
      WireReader.Toml { reader } => run SchemaReader.recover(&mut reader, mark, skip)
      WireReader.Yaml { reader } => run SchemaReader.recover(&mut reader, mark, skip)
      WireReader.Msgpack { reader } => run SchemaReader.recover(&mut reader, mark, skip)
    }
  }

  fn release(self: &mut Self, mark: usize) -> () {
    return match &mut self.* {
      WireReader.Json { reader } => SchemaReader.release(&mut reader, mark)
      WireReader.Toml { reader } => SchemaReader.release(&mut reader, mark)
      WireReader.Yaml { reader } => SchemaReader.release(&mut reader, mark)
      WireReader.Msgpack { reader } => SchemaReader.release(&mut reader, mark)
    }
  }
}

/// The writer of one of the formats.
pub union WireWriter {
  Json { pub writer: JsonSchemaWriter },
  Toml { pub writer: TomlSchemaWriter },
  Yaml { pub writer: YamlSchemaWriter },
  Msgpack { pub writer: MsgpackSchemaWriter },
}

impl WireWriter {
  /// Takes the YAML writer out. Traps if this holds another format's.
  pub fn intoYaml(self: Self) -> YamlSchemaWriter {
    return match move self {
      WireWriter.Yaml { writer } => move writer
      _ => Intrinsic.trap("WireWriter.intoYaml: not a YAML writer")
    }
  }
}

impl SchemaWriter for WireWriter {
  fn taggedOptions(self: &Self) -> bool {
    return match &self.* {
      WireWriter.Json { writer } => SchemaWriter.taggedOptions(&writer)
      WireWriter.Toml { writer } => SchemaWriter.taggedOptions(&writer)
      WireWriter.Yaml { writer } => SchemaWriter.taggedOptions(&writer)
      WireWriter.Msgpack { writer } => SchemaWriter.taggedOptions(&writer)
    }
  }

  effect fn boolean(self: &mut Self, value: bool) -> () ! Issue | WriterError ? &mut Writer {
    return match &mut self.* {
      WireWriter.Json { writer } => run SchemaWriter.boolean(&mut writer, value)
      WireWriter.Toml { writer } => run SchemaWriter.boolean(&mut writer, value)
      WireWriter.Yaml { writer } => run SchemaWriter.boolean(&mut writer, value)
      WireWriter.Msgpack { writer } => run SchemaWriter.boolean(&mut writer, value)
    }
  }

  effect fn signed(self: &mut Self, value: i64) -> () ! Issue | WriterError ? &mut Writer {
    return match &mut self.* {
      WireWriter.Json { writer } => run SchemaWriter.signed(&mut writer, value)
      WireWriter.Toml { writer } => run SchemaWriter.signed(&mut writer, value)
      WireWriter.Yaml { writer } => run SchemaWriter.signed(&mut writer, value)
      WireWriter.Msgpack { writer } => run SchemaWriter.signed(&mut writer, value)
    }
  }

  effect fn unsigned(self: &mut Self, value: u64) -> () ! Issue | WriterError ? &mut Writer {
    return match &mut self.* {
      WireWriter.Json { writer } => run SchemaWriter.unsigned(&mut writer, value)
      WireWriter.Toml { writer } => run SchemaWriter.unsigned(&mut writer, value)
      WireWriter.Yaml { writer } => run SchemaWriter.unsigned(&mut writer, value)
      WireWriter.Msgpack { writer } => run SchemaWriter.unsigned(&mut writer, value)
    }
  }

  effect fn float(self: &mut Self, value: f64) -> () ! Issue | WriterError ? &mut Writer {
    return match &mut self.* {
      WireWriter.Json { writer } => run SchemaWriter.float(&mut writer, value)
      WireWriter.Toml { writer } => run SchemaWriter.float(&mut writer, value)
      WireWriter.Yaml { writer } => run SchemaWriter.float(&mut writer, value)
      WireWriter.Msgpack { writer } => run SchemaWriter.float(&mut writer, value)
    }
  }

  effect fn text(self: &mut Self, value: string) -> () ! Issue | WriterError ? &mut Writer {
    return match &mut self.* {
      WireWriter.Json { writer } => run SchemaWriter.text(&mut writer, value)
      WireWriter.Toml { writer } => run SchemaWriter.text(&mut writer, value)
      WireWriter.Yaml { writer } => run SchemaWriter.text(&mut writer, value)
      WireWriter.Msgpack { writer } => run SchemaWriter.text(&mut writer, value)
    }
  }

  effect fn bytes(self: &mut Self, value: &[u8]) -> ()
    ! Issue | WriterError | OutOfMemoryError
    ? &mut Writer | &mut Allocator {
    return match &mut self.* {
      WireWriter.Json { writer } => run SchemaWriter.bytes(&mut writer, value)
      WireWriter.Toml { writer } => run SchemaWriter.bytes(&mut writer, value)
      WireWriter.Yaml { writer } => run SchemaWriter.bytes(&mut writer, value)
      WireWriter.Msgpack { writer } => run SchemaWriter.bytes(&mut writer, value)
    }
  }

  effect fn null(self: &mut Self) -> () ! Issue | WriterError ? &mut Writer {
    return match &mut self.* {
      WireWriter.Json { writer } => run SchemaWriter.null(&mut writer)
      WireWriter.Toml { writer } => run SchemaWriter.null(&mut writer)
      WireWriter.Yaml { writer } => run SchemaWriter.null(&mut writer)
      WireWriter.Msgpack { writer } => run SchemaWriter.null(&mut writer)
    }
  }

  effect fn beginList(self: &mut Self, count: usize) -> () ! Issue | WriterError ? &mut Writer {
    return match &mut self.* {
      WireWriter.Json { writer } => run SchemaWriter.beginList(&mut writer, count)
      WireWriter.Toml { writer } => run SchemaWriter.beginList(&mut writer, count)
      WireWriter.Yaml { writer } => run SchemaWriter.beginList(&mut writer, count)
      WireWriter.Msgpack { writer } => run SchemaWriter.beginList(&mut writer, count)
    }
  }

  effect fn element(self: &mut Self) -> () ! Issue | WriterError ? &mut Writer {
    return match &mut self.* {
      WireWriter.Json { writer } => run SchemaWriter.element(&mut writer)
      WireWriter.Toml { writer } => run SchemaWriter.element(&mut writer)
      WireWriter.Yaml { writer } => run SchemaWriter.element(&mut writer)
      WireWriter.Msgpack { writer } => run SchemaWriter.element(&mut writer)
    }
  }

  effect fn endList(self: &mut Self) -> () ! Issue | WriterError ? &mut Writer {
    return match &mut self.* {
      WireWriter.Json { writer } => run SchemaWriter.endList(&mut writer)
      WireWriter.Toml { writer } => run SchemaWriter.endList(&mut writer)
      WireWriter.Yaml { writer } => run SchemaWriter.endList(&mut writer)
      WireWriter.Msgpack { writer } => run SchemaWriter.endList(&mut writer)
    }
  }

  effect fn beginObject(self: &mut Self, count: usize) -> () ! Issue | WriterError ? &mut Writer {
    return match &mut self.* {
      WireWriter.Json { writer } => run SchemaWriter.beginObject(&mut writer, count)
      WireWriter.Toml { writer } => run SchemaWriter.beginObject(&mut writer, count)
      WireWriter.Yaml { writer } => run SchemaWriter.beginObject(&mut writer, count)
      WireWriter.Msgpack { writer } => run SchemaWriter.beginObject(&mut writer, count)
    }
  }

  effect fn key(self: &mut Self, name: string) -> () ! Issue | WriterError ? &mut Writer {
    return match &mut self.* {
      WireWriter.Json { writer } => run SchemaWriter.key(&mut writer, name)
      WireWriter.Toml { writer } => run SchemaWriter.key(&mut writer, name)
      WireWriter.Yaml { writer } => run SchemaWriter.key(&mut writer, name)
      WireWriter.Msgpack { writer } => run SchemaWriter.key(&mut writer, name)
    }
  }

  effect fn endObject(self: &mut Self) -> () ! Issue | WriterError ? &mut Writer {
    return match &mut self.* {
      WireWriter.Json { writer } => run SchemaWriter.endObject(&mut writer)
      WireWriter.Toml { writer } => run SchemaWriter.endObject(&mut writer)
      WireWriter.Yaml { writer } => run SchemaWriter.endObject(&mut writer)
      WireWriter.Msgpack { writer } => run SchemaWriter.endObject(&mut writer)
    }
  }
}
