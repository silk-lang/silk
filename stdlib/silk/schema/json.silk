//! Read and write `Schema` types as JSON.
//!
//! # When to use
//! Call [`SchemaJson.decode`] to read a value of a `silk.schema.schema.Schema` type from JSON text,
//! [`SchemaJson.decodeAll`] to report every problem in the text at once, and [`SchemaJson.encode`]
//! to write a value to the ambient `Writer`. Show the problems with
//! `silk.schema.report.SchemaReport`. Use `silk.json.value.Json` to work with a JSON document whose
//! shape is not known in advance.
//!
//! # Details
//! Decoding streams over the text with `silk.json.scanner.JsonScanner` and builds the value
//! directly, with no tree of JSON values in between. Each object is scanned once into an index of
//! its members, so members may come in any order, and members the type does not name are skipped,
//! or reported when its spec is `Spec.strict`. Every problem carries the span of the bytes it is
//! about. Encoding writes compact JSON, with struct fields in declaration order.
//!
//! # Examples
//! ## Report where a value failed
//! ```silk
//! import silk.collections.list { List }
//! import silk.core.effect { Effect }
//! import silk.core.result { Result }
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.schema.issue { IssueReason, SchemaError }
//! import silk.schema.json { SchemaJson }
//! import silk.schema.schema { Schema }
//! import silk.text.string { String }
//!
//! struct Limits {
//!   pub ports: List<u16>,
//! }
//!
//! impl Schema for Limits {}
//!
//! effect fn check() -> i32 ! OutOfMemoryError ? &mut Allocator {
//!   return match move run Effect.result(SchemaJson.decode<Limits>(b"{\"ports\": [80, 70000]}")) {
//!     Result<Limits, SchemaError | OutOfMemoryError>.Success {..} => 1
//!     Result<Limits, SchemaError | OutOfMemoryError>.Failure {error} => match move error {
//!       SchemaError {path, issue, ..} => {
//!         let pointer = run path.pointer()
//!         if pointer.view() == "/ports/1" && issue.reason == IssueReason.InvalidValue { 0 } else { 2 }
//!       }
//!       OutOfMemoryError {} => 3
//!     }
//!   }
//! }
//!
//! pub effect fn main() -> i32 ! OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   return run check() |> Effect.provideMut<Allocator>(&mut allocator)
//! }
//! ```
//!
//! @category Data formats

import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.json.output { JsonOutput }
import silk.json.scanner { JsonError, JsonScanner, JsonSpan, JsonToken }
import silk.json.text { JsonText }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.usize
import silk.schema.issue { Issue, IssueReason, MAX_PROBLEMS, SchemaError, SchemaErrors, Span, ValueKind }
import silk.schema.path { SchemaPath }
import silk.schema.schema { Schema, SchemaReader, SchemaWriter, Schemas }
import silk.text.format { Format, ParseError, NotANumber, OutOfRange }
import silk.text.string { InvalidUtf8, String }

/// The owner of the JSON entry points. It has no fields and is never constructed.
pub struct SchemaJson {}

impl SchemaJson {
  /// Reads one value of type `T` from the JSON text `bytes`, stopping at the first problem.
  ///
  /// # Details
  ///
  /// The whole input must be one JSON value, with optional white space around it.
  ///
  /// # Errors
  ///
  /// - `SchemaError` if the text is not valid JSON or does not hold a `T`. Its `path` names the part
  ///   that failed, and its issue has the span of the bytes it is about.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the value.
  pub effect fn decode<T: Schema>(bytes: &[u8]) -> T ! SchemaError | OutOfMemoryError ? &mut Allocator {
    let mut reader = JsonSchemaReader.make(bytes)
    let read = run Effect.result(readAll<T>(&mut reader))
    return match move read {
      Result<T, Issue | OutOfMemoryError>.Success {value} => move value
      Result<T, Issue | OutOfMemoryError>.Failure {error} => match move error {
        Issue {reason, expected, found, span} => {
          fail SchemaError {path: move reader.path, issue: Issue {reason: reason, expected: expected, found: found, span: span}}
        }
        OutOfMemoryError {} => { fail OutOfMemoryError {} }
      }
    }
  }

  /// Reads one value of type `T` from the JSON text `bytes`, reporting every problem.
  ///
  /// # Details
  ///
  /// A field, element or variant that fails is recorded and skipped, and reading goes on with the
  /// next one, so one call lists every problem, in input order: a missing key, a wrong type, a
  /// number out of range and a failed rule alike. Text that is not valid JSON is the one problem
  /// reported. At most `MAX_PROBLEMS` (64) are listed.
  ///
  /// # Errors
  ///
  /// - `SchemaErrors` with every problem found.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the value.
  pub effect fn decodeAll<T: Schema>(bytes: &[u8]) -> T ! SchemaErrors | OutOfMemoryError ? &mut Allocator {
    let mut reader = JsonSchemaReader.collectingAll(bytes)
    let read = run Effect.result(collectAll<T>(&mut reader))
    return run collected<T>(move read, move reader)
  }

  /// Reads the variant of the union `U` whose wire name is `name` from the JSON object `bytes` of its
  /// fields, reporting every problem.
  ///
  /// # When to use
  ///
  /// Read a call whose name and arguments arrive apart, such as a tool call from a model, into the
  /// union whose variants are the tools.
  ///
  /// # Errors
  ///
  /// - `SchemaErrors` with every problem found, as `decodeAll` reports them, or
  ///   `IssueReason.UnknownVariant` if `U` has no variant `name`.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the value.
  pub effect fn decodeVariant<U: Schema>(name: string, bytes: &[u8]) -> U ! SchemaErrors | OutOfMemoryError ? &mut Allocator {
    let mut reader = JsonSchemaReader.collectingAll(bytes)
    let read = run Effect.result(collectVariant<U>(&mut reader, name))
    return match move run Effect.result(collected<U>(move read, move reader)) {
      Result<U, SchemaErrors | OutOfMemoryError>.Success {value} => move value
      Result<U, SchemaErrors | OutOfMemoryError>.Failure {error} => match move error {
        SchemaErrors {errors, dropped} => {
          let mut found = move errors
          // An unknown name is not in `bytes`, so the problem quotes it from here.
          let listed = List<SchemaError>.asMutSlice(&mut found)
          if listed.length > 0 && listed[0].issue.reason == IssueReason.UnknownVariant && listed[0].path.length() == 0 {
            listed[0].got = Option<String>.some(run String.copy(name))
            listed[0].issue.found = ValueKind.Text
          }
          fail SchemaErrors {errors: move found, dropped: dropped}
        }
        OutOfMemoryError {} => { fail OutOfMemoryError {} }
      }
    }
  }

  /// Writes `value` as compact JSON to the ambient `Writer`.
  ///
  /// # Errors
  ///
  /// - `SchemaError` if JSON cannot hold the value, such as a NaN or an infinity, or a value nested
  ///   more than 64 levels deep. Its path is empty.
  /// - `WriterError` if the `Writer` fails. Bytes that it accepted before the failure stay written.
  /// - `OutOfMemoryError` if a codec needs memory that the `Allocator` cannot supply.
  pub effect fn encode<T: Schema>(value: &T)
    -> () ! SchemaError | WriterError | OutOfMemoryError ? &mut Writer | &mut Allocator {
    let mut writer = JsonSchemaWriter.make()
    return run Effect.catch<Issue>(Schemas.write<T, JsonSchemaWriter>(value, &mut writer),
      effect fn(issue: Issue) -> () ! SchemaError { fail SchemaError {path: SchemaPath.make(), issue: issue} })
  }
}

effect fn readAll<T: Schema>(reader: &mut JsonSchemaReader<'_>) -> T ! Issue | OutOfMemoryError ? &mut Allocator {
  let value = run Schemas.read<T, JsonSchemaReader<'_>>(&mut reader.*)
  run expectEnd(&mut reader.*)
  return move value
}

effect fn expectEnd(reader: &mut JsonSchemaReader<'_>) -> () ! Issue {
  match run token(&mut reader.scanner) {
    JsonToken.EndOfInput => {}
    JsonToken found => {
      fail Issue.at(IssueReason.InvalidSyntax, "the end of the input", kindOf(found), tokenSpan(&reader.scanner, found))
    }
  }
  return ()
}

// Checks that the whole input is one JSON value, so a collecting read never meets broken text.
effect fn wellFormed(reader: &mut JsonSchemaReader<'_>) -> () ! Issue {
  let mut scanner = JsonScanner.fork(&reader.scanner)
  let end = run skipValue(&mut scanner)
  drop end
  return match run token(&mut scanner) {
    JsonToken.EndOfInput => ()
    JsonToken found => { fail Issue.at(IssueReason.InvalidSyntax, "the end of the input", kindOf(found), tokenSpan(&scanner, found)) }
  }
}

effect fn collectAll<T: Schema>(reader: &mut JsonSchemaReader<'_>) -> T ! Issue | OutOfMemoryError ? &mut Allocator {
  run wellFormed(&mut reader.*)
  return run readAll<T>(&mut reader.*)
}

effect fn collectVariant<U: Schema>(reader: &mut JsonSchemaReader<'_>, name: string) -> U ! Issue | OutOfMemoryError ? &mut Allocator {
  run wellFormed(&mut reader.*)
  let value = run Schemas.readVariant<U, JsonSchemaReader<'_>>(&mut reader.*, name)
  run expectEnd(&mut reader.*)
  return move value
}

// The value of a collecting read, or every problem it recorded with the one it stopped at.
effect fn collected<T>(read: Result<T, Issue | OutOfMemoryError>, reader: JsonSchemaReader<'_>) -> T ! SchemaErrors | OutOfMemoryError ? &mut Allocator {
  let mut source = move reader
  return match move read {
    Result<T, Issue | OutOfMemoryError>.Success {value} => {
      if List<SchemaError>.length(&source.errors) != 0 { fail SchemaErrors {errors: move source.errors, dropped: source.dropped} }
      move value
    }
    Result<T, Issue | OutOfMemoryError>.Failure {error} => match move error {
      Issue {reason, expected, found, span} => {
        if reason != IssueReason.Reported {
          run record(&mut source, Issue {reason: reason, expected: expected, found: found, span: span})
        }
        fail SchemaErrors {errors: move source.errors, dropped: source.dropped}
      }
      OutOfMemoryError {} => { fail OutOfMemoryError {} }
    }
  }
}

// One member of an object: where its key is, and a scanner at its value.
struct Member<'input> {
  key: JsonSpan,
  escaped: bool,
  value: JsonScanner<'input>,
  seen: bool,
}

// An object being read: its members, and a scanner after its closing brace.
struct ObjectFrame<'input> {
  start: usize,
  members: List<Member<'input>>,
  end: JsonScanner<'input>,
  endOffset: usize,
}

// A position a collecting read can return to.
struct Mark<'input> {
  frames: usize,
  lists: usize,
  scanner: JsonScanner<'input>,
}

/// A `SchemaReader` over JSON text.
///
/// # When to use
///
/// [`SchemaJson.decode`] uses it. Use it directly to read a value from the middle of a larger
/// program's own JSON handling.
pub struct JsonSchemaReader<'input> {
  scanner: JsonScanner<'input>,
  frames: List<ObjectFrame<'input>>,
  lists: List<usize>,
  marks: List<Mark<'input>>,
  path: SchemaPath,
  collecting: bool,
  errors: List<SchemaError>,
  dropped: usize,
  last: Option<Span>,
  lastKind: ValueKind,
}

impl<'input> JsonSchemaReader<'input> {
  /// Returns a reader at the start of `input`.
  pub fn make(input: &'input [u8]) -> JsonSchemaReader<'input> {
    return JsonSchemaReader<'input> {
      scanner: JsonScanner.make(input),
      frames: List<ObjectFrame<'input>>.make(),
      lists: List<usize>.make(),
      marks: List<Mark<'input>>.make(),
      path: SchemaPath.make(),
      collecting: false,
      errors: List<SchemaError>.make(),
      dropped: usize.ZERO,
      last: Option<Span>.none(),
      lastKind: ValueKind.Unknown,
    }
  }

  /// Returns a reader at the start of `input` that records every problem instead of stopping at
  /// the first. Read them with [`JsonSchemaReader.intoErrors`].
  pub fn collectingAll(input: &'input [u8]) -> JsonSchemaReader<'input> {
    let mut reader = JsonSchemaReader<'input>.make(input)
    reader.collecting = true
    return move reader
  }

  /// Returns the problems the reader recorded, in the order they were found.
  pub fn intoErrors(self: Self) -> List<SchemaError> {
    return move self.errors
  }
}

effect fn record(reader: &mut JsonSchemaReader<'_>, issue: Issue) -> () ! OutOfMemoryError ? &mut Allocator {
  if List<SchemaError>.length(&reader.errors) >= MAX_PROBLEMS {
    reader.dropped = reader.dropped + usize.ONE
    return ()
  }
  let path = run SchemaPath.copy(&reader.path)
  // Problems are kept in input order: an unexpected key is found after the fields it precedes.
  let mut at = List<SchemaError>.length(&reader.errors)
  if let Option<Span>.Some {value: span} = issue.span {
    let recorded = List<SchemaError>.asSlice(&reader.errors)
    while at > usize.ZERO && startsAfter(recorded[at - usize.ONE].issue.span, span.start) { at = at - usize.ONE }
  }
  return run List<SchemaError>.insert(&mut reader.errors, at, SchemaError {path: move path, issue: issue})
}

fn startsAfter(span: Option<Span>, start: usize) -> bool {
  return match span {
    Option<Span>.Some {value} => value.start > start
    Option<Span>.None => false
  }
}

fn kindOf(found: JsonToken) -> ValueKind {
  return match found {
    JsonToken.String {..} => ValueKind.Text
    JsonToken.Number {..} => ValueKind.Number
    JsonToken.True => ValueKind.Boolean
    JsonToken.False => ValueKind.Boolean
    JsonToken.Null => ValueKind.Null
    JsonToken.ArrayBegin => ValueKind.List
    JsonToken.ObjectBegin => ValueKind.Object
    _ => ValueKind.Unknown
  }
}

// The bytes of `found`, the last token `scanner` returned.
fn tokenSpan(scanner: &JsonScanner<'_>, found: JsonToken) -> Span {
  let start = JsonScanner.offset(scanner)
  let length = match found {
    JsonToken.String {span, ..} => span.length
    JsonToken.Number {span} => span.length
    JsonToken.True => 4
    JsonToken.False => 5
    JsonToken.Null => 4
    JsonToken.EndOfInput => 0
    _ => 1
  }
  return Span {start: start, end: start + length}
}

fn syntax(error: JsonError) -> Issue {
  return match error.offset {
    Option<usize>.Some {value} => Issue.at(IssueReason.InvalidSyntax, "valid JSON", ValueKind.Unknown, Span {start: value, end: value + usize.ONE})
    Option<usize>.None => Issue.make(IssueReason.InvalidSyntax, "valid JSON")
  }
}

effect fn token(scanner: &mut JsonScanner<'_>) -> JsonToken ! Issue {
  return match move JsonScanner.next(&mut scanner.*) {
    Result<JsonToken, JsonError>.Success {value} => value
    Result<JsonToken, JsonError>.Failure {error} => { fail syntax(move error) }
  }
}

effect fn peekToken(scanner: &mut JsonScanner<'_>) -> JsonToken ! Issue {
  return match move JsonScanner.peek(&mut scanner.*) {
    Result<JsonToken, JsonError>.Success {value} => value
    Result<JsonToken, JsonError>.Failure {error} => { fail syntax(move error) }
  }
}

// Reads past one complete value, nested lists and objects included, and returns the offset after
// it.
effect fn skipValue(scanner: &mut JsonScanner<'_>) -> usize ! Issue {
  let mut depth = usize.ZERO
  while true {
    let found = run token(&mut scanner.*)
    match found {
      JsonToken.ObjectBegin => { depth = depth + usize.ONE }
      JsonToken.ArrayBegin => { depth = depth + usize.ONE }
      JsonToken.ObjectEnd => { depth = depth - usize.ONE }
      JsonToken.ArrayEnd => { depth = depth - usize.ONE }
      JsonToken.KeySeparator => { continue }
      JsonToken.ValueSeparator => { continue }
      JsonToken.EndOfInput => {
        fail Issue.at(IssueReason.InvalidSyntax, "valid JSON", ValueKind.Unknown, tokenSpan(&scanner.*, found))
      }
      _ => {}
    }
    if depth == usize.ZERO { return tokenSpan(&scanner.*, found).end }
  }
  return JsonScanner.offset(&scanner.*)
}

fn sameBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn keyMatches(scanner: &JsonScanner<'_>, span: JsonSpan, escaped: bool, key: string)
  -> bool ! Issue | OutOfMemoryError ? &mut Allocator {
  let wanted = String.utf8Bytes(key)
  let offset = span.offset
  let raw = JsonScanner.slice(scanner, span)
  if !escaped {
    return raw.length == wanted.length + 2 && sameBytes(Slice.view<u8>(raw, usize.ONE, wanted.length), wanted)
  }
  let decoded = match move run Effect.result(JsonText.decode(raw, offset, true)) {
    Result<Bytes, JsonError | OutOfMemoryError>.Success {value} => move value
    Result<Bytes, JsonError | OutOfMemoryError>.Failure {error} => match move error {
      JsonError {..} => { fail Issue.at(IssueReason.InvalidSyntax, "valid JSON", ValueKind.Text, Span {start: offset, end: offset + span.length}) }
      OutOfMemoryError {} => { fail OutOfMemoryError {} }
    }
  }
  return sameBytes(Bytes.asSlice(&decoded), wanted)
}

impl<'input> JsonSchemaReader<'input> {
  // Reads the next token as a scalar, remembering its span and kind.
  effect fn scalar(self: &mut Self) -> JsonToken ! Issue {
    let found = run token(&mut self.scanner)
    self.last = Option<Span>.some(tokenSpan(&self.scanner, found))
    self.lastKind = kindOf(found)
    return found
  }

  // An issue about the value the last token starts.
  fn mismatch(self: &Self, reason: IssueReason, expected: string<'static>, found: JsonToken) -> Issue {
    return Issue.at(reason, expected, kindOf(found), tokenSpan(&self.scanner, found))
  }

  effect fn numberText(self: &mut Self, expected: string<'static>) -> string<'input> ! Issue {
    let found = run self.scalar()
    return match found {
      JsonToken.Number {span} => unsafe Intrinsic.stringFromUtf8Unchecked(JsonScanner.slice(&self.scanner, span))
      _ => { fail self.mismatch(IssueReason.InvalidType, expected, found) }
    }
  }
}

effect fn parsedNumber<T>(result: Result<T, ParseError>, span: Option<Span>, expected: string<'static>) -> T ! Issue {
  return match move result {
    Result<T, ParseError>.Success {value} => move value
    Result<T, ParseError>.Failure {error} => match move error.reason {
      NotANumber {..} => {
        let issue = Issue.invalidType(expected)
        fail issue.locate(span, ValueKind.Number)
      }
      OutOfRange {} => {
        let issue = Issue.invalidValue(expected)
        fail issue.locate(span, ValueKind.Number)
      }
    }
  }
}

impl<'input> SchemaReader for JsonSchemaReader<'input> {
  /// Returns the path of the part being read.
  fn path(self: &mut Self) -> &mut SchemaPath {
    return &mut self.path
  }

  /// Fails with the issue, or records it and returns when the reader collects every problem.
  effect fn report(self: &mut Self, issue: Issue) -> () ! Issue | OutOfMemoryError ? &mut Allocator {
    if !self.collecting { fail issue }
    return run record(&mut self.*, issue)
  }

  /// Returns whether the reader records every problem.
  fn collecting(self: &Self) -> bool {
    return self.collecting
  }

  /// Returns the span of the last complete value read.
  fn lastSpan(self: &Self) -> Option<Span> {
    return self.last
  }

  /// Returns the kind of the last complete value read.
  fn lastKind(self: &Self) -> ValueKind {
    return self.lastKind
  }

  /// Remembers the open objects and lists and the scanner's position.
  effect fn mark(self: &mut Self) -> usize ! OutOfMemoryError ? &mut Allocator {
    let at = List<Mark<'input>>.length(&self.marks)
    run List<Mark<'input>>.append(&mut self.marks, Mark<'input> {frames: List<ObjectFrame<'input>>.length(&self.frames),
      lists: List<usize>.length(&self.lists), scanner: JsonScanner.fork(&self.scanner)})
    return at
  }

  /// Returns to the mark, closing the objects and lists opened since, and reads past the value
  /// there when `skip` is `true`.
  effect fn recover(self: &mut Self, mark: usize, skip: bool) -> () ! Issue | OutOfMemoryError ? &mut Allocator {
    let marks = List<Mark<'input>>.asSlice(&self.marks)
    let frames = marks[mark].frames
    let lists = marks[mark].lists
    self.scanner = JsonScanner.fork(&marks[mark].scanner)
    List<Mark<'input>>.truncate(&mut self.marks, mark)
    List<ObjectFrame<'input>>.truncate(&mut self.frames, frames)
    List<usize>.truncate(&mut self.lists, lists)
    if skip {
      let start = match run peekToken(&mut self.scanner) {
        JsonToken.EndOfInput => JsonScanner.length(&self.scanner)
        _ => JsonScanner.offset(&self.scanner)
      }
      let end = run skipValue(&mut self.scanner)
      self.last = Option<Span>.some(Span {start: start, end: end})
    }
    return ()
  }

  /// Forgets the mark and every later one.
  fn release(self: &mut Self, mark: usize) -> () {
    List<Mark<'input>>.truncate(&mut self.marks, mark)
    return ()
  }

  /// Reads `true` or `false`.
  effect fn boolean(self: &mut Self) -> bool ! Issue | OutOfMemoryError ? &mut Allocator {
    let found = run self.scalar()
    return match found {
      JsonToken.True => true
      JsonToken.False => false
      _ => { fail self.mismatch(IssueReason.InvalidType, "true or false", found) }
    }
  }

  /// Reads a JSON number as an `i64`.
  effect fn signed(self: &mut Self) -> i64 ! Issue | OutOfMemoryError ? &mut Allocator {
    let text = run self.numberText("an integer")
    return run parsedNumber<i64>(Format.signedValue(text), self.last, "an integer")
  }

  /// Reads a JSON number as a `u64`.
  effect fn unsigned(self: &mut Self) -> u64 ! Issue | OutOfMemoryError ? &mut Allocator {
    let text = run self.numberText("a non-negative integer")
    return run parsedNumber<u64>(Format.unsignedValue(text), self.last, "a non-negative integer")
  }

  /// Reads a JSON number as an `f64`.
  effect fn float(self: &mut Self) -> f64 ! Issue | OutOfMemoryError ? &mut Allocator {
    let text = run self.numberText("a number")
    return run parsedNumber<f64>(Format.f64Value(text), self.last, "a number")
  }

  /// Reads a JSON string, with its escapes decoded.
  effect fn text(self: &mut Self) -> String ! Issue | OutOfMemoryError ? &mut Allocator {
    let found = run self.scalar()
    return match found {
      JsonToken.String {span, escaped} => {
        let offset = span.offset
        let raw = JsonScanner.slice(&self.scanner, span)
        let bytes = match move run Effect.result(JsonText.decode(raw, offset, escaped)) {
          Result<Bytes, JsonError | OutOfMemoryError>.Success {value} => move value
          Result<Bytes, JsonError | OutOfMemoryError>.Failure {error} => match move error {
            JsonError {..} => { fail self.mismatch(IssueReason.InvalidSyntax, "valid JSON", found) }
            OutOfMemoryError {} => { fail OutOfMemoryError {} }
          }
        }
        // The scanner checked the UTF-8 of the string, and each decoded escape is a scalar value.
        match move String.fromBytes(move bytes) {
          Result<String, InvalidUtf8>.Success {value} => move value
          Result<String, InvalidUtf8>.Failure {..} => { fail self.mismatch(IssueReason.InvalidSyntax, "valid JSON", found) }
        }
      }
      _ => { fail self.mismatch(IssueReason.InvalidType, "text", found) }
    }
  }

  /// Reads past `null` and returns `true`, or returns `false` for another value.
  effect fn null(self: &mut Self) -> bool ! Issue | OutOfMemoryError ? &mut Allocator {
    return match run peekToken(&mut self.scanner) {
      JsonToken.Null => {
        let skipped = run self.scalar()
        drop skipped
        true
      }
      _ => false
    }
  }

  /// Reads past `[`.
  effect fn beginList(self: &mut Self) -> () ! Issue | OutOfMemoryError ? &mut Allocator {
    let found = run token(&mut self.scanner)
    return match found {
      JsonToken.ArrayBegin => run List<usize>.append(&mut self.lists, JsonScanner.offset(&self.scanner))
      _ => { fail self.mismatch(IssueReason.InvalidType, "a list", found) }
    }
  }

  /// Returns `true` at the next element, or reads past `]` and returns `false`.
  effect fn nextElement(self: &mut Self) -> bool ! Issue | OutOfMemoryError ? &mut Allocator {
    return match run peekToken(&mut self.scanner) {
      JsonToken.ArrayEnd => {
        let closed = run token(&mut self.scanner)
        let end = tokenSpan(&self.scanner, closed).end
        if let Option<usize>.Some {value: start} = List<usize>.pop(&mut self.lists) {
          self.last = Option<Span>.some(Span {start: start, end: end})
          self.lastKind = ValueKind.List
        }
        false
      }
      JsonToken.ValueSeparator => {
        let skipped = run token(&mut self.scanner)
        drop skipped
        true
      }
      _ => true
    }
  }

  /// Reads the object's members into an index once, so `member` finds each without scanning.
  effect fn beginObject(self: &mut Self) -> () ! Issue | OutOfMemoryError ? &mut Allocator {
    let found = run token(&mut self.scanner)
    match found {
      JsonToken.ObjectBegin => {}
      _ => { fail self.mismatch(IssueReason.InvalidType, "an object", found) }
    }
    let start = JsonScanner.offset(&self.scanner)
    let mut members = List<Member<'input>>.make()
    while true {
      let next = run token(&mut self.scanner)
      let key = match next {
        JsonToken.ObjectEnd => { break }
        JsonToken.String {span, escaped} => Member<'input> {key: span, escaped: escaped, value: JsonScanner.fork(&self.scanner), seen: false}
        _ => { fail self.mismatch(IssueReason.InvalidSyntax, "valid JSON", next) }
      }
      let separator = run token(&mut self.scanner)
      match separator {
        JsonToken.KeySeparator => {}
        _ => { fail self.mismatch(IssueReason.InvalidSyntax, "valid JSON", separator) }
      }
      let mut entry = move key
      entry.value = JsonScanner.fork(&self.scanner)
      run List<Member<'input>>.append(&mut members, move entry)
      let ignored = run skipValue(&mut self.scanner)
      drop ignored
      let after = run token(&mut self.scanner)
      match after {
        JsonToken.ValueSeparator => {}
        JsonToken.ObjectEnd => { break }
        _ => { fail self.mismatch(IssueReason.InvalidSyntax, "valid JSON", after) }
      }
    }
    let endOffset = JsonScanner.offset(&self.scanner) + usize.ONE
    return run List<ObjectFrame<'input>>.append(&mut self.frames, ObjectFrame<'input> {start: start, members: move members,
      end: JsonScanner.fork(&self.scanner), endOffset: endOffset})
  }

  /// Finds the member `key` in the object's index and leaves the reader at its value. A missing key
  /// leaves the object's opening brace as the last span.
  effect fn member(self: &mut Self, key: string) -> bool ! Issue | OutOfMemoryError ? &mut Allocator {
    let depth = List<ObjectFrame<'input>>.length(&self.frames) - usize.ONE
    let mut found = usize.MAX
    let mut at = usize.ZERO
    while found == usize.MAX {
      let frames = List<ObjectFrame<'input>>.asSlice(&self.frames)
      let members = List<Member<'input>>.asSlice(&frames[depth].members)
      if at >= members.length { break }
      if run keyMatches(&members[at].value, members[at].key, members[at].escaped, key) { found = at }
      at = at + usize.ONE
    }
    if found == usize.MAX {
      let start = List<ObjectFrame<'input>>.asSlice(&self.frames)[depth].start
      self.last = Option<Span>.some(Span {start: start, end: start + usize.ONE})
      self.lastKind = ValueKind.Missing
      return false
    }
    let frames = List<ObjectFrame<'input>>.asMutSlice(&mut self.frames)
    let members = List<Member<'input>>.asMutSlice(&mut frames[depth].members)
    members[found].seen = true
    let value = JsonScanner.fork(&members[found].value)
    self.scanner = move value
    return true
  }

  /// Reports every member no `member` call found, at its key.
  effect fn rejectUnread(self: &mut Self, expected: string<'static>) -> () ! Issue | OutOfMemoryError ? &mut Allocator {
    let depth = List<ObjectFrame<'input>>.length(&self.frames)
    let mut at = usize.ZERO
    while true {
      let frames = List<ObjectFrame<'input>>.asSlice(&self.frames)
      let members = List<Member<'input>>.asSlice(&frames[depth - usize.ONE].members)
      if at >= members.length { break }
      if !members[at].seen {
        let key = members[at].key
        let issue = Issue.at(IssueReason.UnexpectedKey, expected, ValueKind.Text, Span {start: key.offset, end: key.offset + key.length})
        run SchemaReader.report(&mut self.*, issue)
      }
      at = at + usize.ONE
    }
    return ()
  }

  /// Jumps past the whole object being read.
  effect fn endObject(self: &mut Self) -> () ! Issue | OutOfMemoryError ? &mut Allocator {
    let frame = match List<ObjectFrame<'input>>.pop(&mut self.frames) {
      Option<ObjectFrame<'input>>.Some {value} => move value
      Option<ObjectFrame<'input>>.None => { fail Issue.make(IssueReason.InvalidSyntax, "an object") }
    }
    self.scanner = JsonScanner.fork(&frame.end)
    self.last = Option<Span>.some(Span {start: frame.start, end: frame.endOffset})
    self.lastKind = ValueKind.Object
    return ()
  }
}

const MAX_DEPTH: usize = 64

/// A `SchemaWriter` that writes compact JSON to the ambient `Writer`.
///
/// # When to use
///
/// [`SchemaJson.encode`] uses it. Use it directly to write a value inside JSON that the program
/// writes itself.
pub struct JsonSchemaWriter {
  first: [bool; 64],
  depth: usize,
}

impl JsonSchemaWriter {
  /// Returns a writer for one top-level value.
  pub fn make() -> JsonSchemaWriter {
    return JsonSchemaWriter {first: [false; 64], depth: usize.ZERO}
  }
}

effect fn opened(self: &mut JsonSchemaWriter, bracket: &[u8]) -> () ! Issue | WriterError ? &mut Writer {
  if self.depth + usize.ONE >= MAX_DEPTH { fail Issue.invalidValue("a value nested at most 64 levels deep") }
  self.depth = self.depth + usize.ONE
  self.first[self.depth] = true
  return run Writer.writeAll(bracket)
}

effect fn closed(self: &mut JsonSchemaWriter, bracket: &[u8]) -> () ! Issue | WriterError ? &mut Writer {
  self.depth = self.depth - usize.ONE
  return run Writer.writeAll(bracket)
}

effect fn separated(self: &mut JsonSchemaWriter) -> () ! Issue | WriterError ? &mut Writer {
  if self.first[self.depth] {
    self.first[self.depth] = false
    return ()
  }
  return run Writer.writeAll(b",")
}

effect fn jsonFailure(error: JsonError) -> () ! Issue {
  fail Issue.invalidValue("a finite number")
}

impl SchemaWriter for JsonSchemaWriter {
  /// Writes `true` or `false`.
  effect fn boolean(self: &mut Self, value: bool) -> () ! Issue | WriterError ? &mut Writer {
    if value { return run Writer.writeAll(b"true") }
    return run Writer.writeAll(b"false")
  }

  /// Writes the integer in decimal.
  effect fn signed(self: &mut Self, value: i64) -> () ! Issue | WriterError ? &mut Writer {
    let mut digits: [u8; 24] = [0; 24]
    let end = Format.writeI64Display(value, &mut digits, usize.ZERO)
    return run Writer.writeAll(Slice.view<u8>(&digits, usize.ZERO, end))
  }

  /// Writes the integer in decimal.
  effect fn unsigned(self: &mut Self, value: u64) -> () ! Issue | WriterError ? &mut Writer {
    let mut digits: [u8; 24] = [0; 24]
    let end = Format.writeU64Display(value, &mut digits, usize.ZERO)
    return run Writer.writeAll(Slice.view<u8>(&digits, usize.ZERO, end))
  }

  /// Writes the number. A NaN or an infinity fails with `IssueReason.InvalidValue`.
  effect fn float(self: &mut Self, value: f64) -> () ! Issue | WriterError ? &mut Writer {
    return run Effect.catch<JsonError>(JsonOutput.writeFloat(value), jsonFailure)
  }

  /// Writes a JSON string, with the escapes JSON needs.
  effect fn text(self: &mut Self, value: string) -> () ! Issue | WriterError ? &mut Writer {
    return run JsonOutput.writeString(value)
  }

  /// Writes `null`.
  effect fn null(self: &mut Self) -> () ! Issue | WriterError ? &mut Writer {
    return run Writer.writeAll(b"null")
  }

  /// Writes `[`.
  effect fn beginList(self: &mut Self) -> () ! Issue | WriterError ? &mut Writer {
    return run opened(&mut self.*, b"[")
  }

  /// Writes `,` before every element but the first.
  effect fn element(self: &mut Self) -> () ! Issue | WriterError ? &mut Writer {
    return run separated(&mut self.*)
  }

  /// Writes `]`.
  effect fn endList(self: &mut Self) -> () ! Issue | WriterError ? &mut Writer {
    return run closed(&mut self.*, b"]")
  }

  /// Writes `{`.
  effect fn beginObject(self: &mut Self) -> () ! Issue | WriterError ? &mut Writer {
    return run opened(&mut self.*, b"{")
  }

  /// Writes `,` before every member but the first, then the key and `:`.
  effect fn key(self: &mut Self, name: string) -> () ! Issue | WriterError ? &mut Writer {
    run separated(&mut self.*)
    run JsonOutput.writeString(name)
    return run Writer.writeAll(b":")
  }

  /// Writes `}`.
  effect fn endObject(self: &mut Self) -> () ! Issue | WriterError ? &mut Writer {
    return run closed(&mut self.*, b"}")
  }
}
