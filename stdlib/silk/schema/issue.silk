//! The problems a schema reports, and where in the value and the input they happened.
//!
//! # When to use
//! Match on [`Issue`] when a codec, a check, or a format reader rejects input. Read
//! [`SchemaError`] from `silk.schema.json.SchemaJson.decode`, or [`SchemaErrors`] from
//! `SchemaJson.decodeAll`, and show them with `silk.schema.report.SchemaReport`.
//!
//! # Details
//! An `Issue` is a small copyable value: an [`IssueReason`], one line of static text that names what
//! was expected, the kind of value found, and the [`Span`] of input bytes it is about when the
//! format knows it. A `SchemaError` adds the [`SchemaPath`] from the root value to the part that
//! failed. Nothing copies the input: a report cuts the found value out of the input by its span.
//!
//! @category Data formats

import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.io.writer { Writer, WriterError }
import silk.schema.path { SchemaPath }
import silk.text.format { Debug, Format, Formatter }

/// Why a value could not be read, written, or accepted.
pub enum IssueReason {
  /// The input holds another kind of value, such as text where a number was expected.
  InvalidType,
  /// The input holds the right kind of value, but not one the type accepts, such as `300` for a
  /// `u8`.
  InvalidValue,
  /// A required key is absent.
  MissingKey,
  /// An object has a key that its type does not name, and its spec is `Spec.strict`.
  UnexpectedKey,
  /// The input is not well formed, such as JSON without a closing quote.
  InvalidSyntax,
  /// A check of the value failed.
  CheckFailed,
  /// The text names no variant of the union.
  UnknownVariant,
  /// A part of the value failed and its problems are already recorded, as `decodeAll` does. A
  /// report never lists it.
  Reported,
}

/// The kind of value found in the input.
pub enum ValueKind {
  /// Not known, or not one value.
  Unknown,
  /// Text, such as a JSON string.
  Text,
  /// A number.
  Number,
  /// `true` or `false`.
  Boolean,
  /// A null value.
  Null,
  /// A list, such as a JSON array.
  List,
  /// An object.
  Object,
  /// Nothing: the key is absent.
  Missing,
}

/// A range of bytes of the input, from `start` up to but not including `end`.
pub struct Span {
  /// The first byte.
  pub start: usize,
  /// The byte after the last one.
  pub end: usize,
}

impl Copy for Span {}

/// One problem found while reading, writing, or checking a value.
///
/// # Details
///
/// `expected` is one line of static text that says what the schema wanted, such as `"a number"` or
/// `"an integer from 1 to 65535"`. `found` is the kind of value the input held, and `span` the
/// bytes of the input the problem is about, when the format knows them.
pub struct Issue {
  /// Why the value was rejected.
  pub reason: IssueReason,
  /// What the schema expected, as one line of text for a person.
  pub expected: string<'static>,
  /// The kind of value the input held.
  pub found: ValueKind,
  /// The bytes of the input the problem is about, if known.
  pub span: Option<Span>,
}

impl Copy for Issue {}

impl Issue {
  /// Returns an issue with `reason` and `expected`, and no position.
  pub fn make(reason: IssueReason, expected: string<'static>) -> Issue {
    return Issue {reason: reason, expected: expected, found: ValueKind.Unknown, span: Option<Span>.none()}
  }

  /// Returns an issue about the input bytes `span`, which hold a value of kind `found`.
  pub fn at(reason: IssueReason, expected: string<'static>, found: ValueKind, span: Span) -> Issue {
    return Issue {reason: reason, expected: expected, found: found, span: Option<Span>.some(span)}
  }

  /// Returns an issue for input that holds another kind of value than `expected`.
  pub fn invalidType(expected: string<'static>) -> Issue {
    return Issue.make(IssueReason.InvalidType, expected)
  }

  /// Returns an issue for a value of the right kind that the type does not accept.
  pub fn invalidValue(expected: string<'static>) -> Issue {
    return Issue.make(IssueReason.InvalidValue, expected)
  }

  /// Returns an issue for a required key that is absent.
  pub fn missingKey() -> Issue {
    return Issue {reason: IssueReason.MissingKey, expected: "a value", found: ValueKind.Missing, span: Option<Span>.none()}
  }

  /// Returns an issue for a check that failed. `expected` is the check's message.
  pub fn checkFailed(expected: string<'static>) -> Issue {
    return Issue.make(IssueReason.CheckFailed, expected)
  }

  /// Returns the issue at `span`, holding a value of kind `found`, unless it already has a span.
  pub fn locate(self: Self, span: Option<Span>, found: ValueKind) -> Issue {
    if self.span.isSome() { return self }
    let mut kind = self.found
    if kind == ValueKind.Unknown { kind = found }
    return Issue {reason: self.reason, expected: self.expected, found: kind, span: span}
  }
}

impl Debug for Issue {
  /// Writes the fields, as `Issue { reason: ..., expected: ..., found: ..., span: ... }`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return run Format.debugFields(self, "Issue", &mut formatter)
  }
}

impl Debug for Span {
  /// Writes the fields, as `Span { start: ..., end: ... }`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return run Format.debugFields(self, "Span", &mut formatter)
  }
}

impl Debug for IssueReason {
  /// Writes the name of the reason, such as `MissingKey`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return run Format.writeText(&mut formatter, IssueReason.name(self.*))
  }
}

impl IssueReason {
  /// Returns the name of the reason, such as `"MissingKey"`.
  pub fn name(self: Self) -> string<'static> {
    return match self {
      IssueReason.InvalidType => "InvalidType"
      IssueReason.InvalidValue => "InvalidValue"
      IssueReason.MissingKey => "MissingKey"
      IssueReason.UnexpectedKey => "UnexpectedKey"
      IssueReason.InvalidSyntax => "InvalidSyntax"
      IssueReason.CheckFailed => "CheckFailed"
      IssueReason.UnknownVariant => "UnknownVariant"
      IssueReason.Reported => "Reported"
    }
  }
}

impl ValueKind {
  /// Returns how a person names the kind, such as `"text"` or `"a list"`.
  pub fn noun(self: Self) -> string<'static> {
    return match self {
      ValueKind.Unknown => "a value"
      ValueKind.Text => "text"
      ValueKind.Number => "a number"
      ValueKind.Boolean => "a boolean"
      ValueKind.Null => "null"
      ValueKind.List => "a list"
      ValueKind.Object => "an object"
      ValueKind.Missing => "nothing"
    }
  }
}

impl Debug for ValueKind {
  /// Writes the name of the kind, such as `Text`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    let name = match &self.* {
      ValueKind.Unknown => "Unknown"
      ValueKind.Text => "Text"
      ValueKind.Number => "Number"
      ValueKind.Boolean => "Boolean"
      ValueKind.Null => "Null"
      ValueKind.List => "List"
      ValueKind.Object => "Object"
      ValueKind.Missing => "Missing"
    }
    return run Format.writeText(&mut formatter, name)
  }
}

/// A rejected value: the problem, and the path from the root value to the part that failed.
///
/// # Details
///
/// `path` keeps its segments, so it renders with wire names for a person
/// (`SchemaPath.text`), as a JSON Pointer for a tool (`SchemaPath.pointer`), or with Silk names
/// (`SchemaPath.names`). It is empty when the root value itself failed.
pub struct SchemaError {
  /// The path from the root value to the part that failed, such as `settings.ports[2]`.
  pub path: SchemaPath,
  /// The problem.
  pub issue: Issue,
}

impl Debug for SchemaError {
  /// Writes the fields, as `SchemaError { path: ..., issue: ... }`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return run Format.debugFields(self, "SchemaError", &mut formatter)
  }
}

/// The most problems one `decodeAll` records; later ones are counted in `SchemaErrors.dropped`.
pub const MAX_PROBLEMS: usize = 64

/// Every problem found while reading one value, in input order.
///
/// # Details
///
/// [`silk.schema.json.SchemaJson.decodeAll`] reports it. A part that fails is recorded and
/// skipped, and reading goes on with its next sibling, so one call lists every problem in the
/// input, up to [`MAX_PROBLEMS`].
pub struct SchemaErrors {
  /// The problems, never empty.
  pub errors: List<SchemaError>,
  /// How many more problems were found after the first `MAX_PROBLEMS`.
  pub dropped: usize,
}

impl Debug for SchemaErrors {
  /// Writes the problems, as `SchemaErrors { errors: [...], dropped: ... }`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return run Format.debugFields(self, "SchemaErrors", &mut formatter)
  }
}
