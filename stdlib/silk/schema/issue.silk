//! The problems a schema reports, and where in the value they happened.
//!
//! # When to use
//! Match on [`Issue`] when a codec, a check, or a format reader rejects input. Read
//! [`SchemaError`] from `silk.schema.json.SchemaJson.decode` to show a person what failed and
//! where, such as `port: between 1 and 65535`.
//!
//! # Details
//! An `Issue` is a small copyable value: a [`IssueReason`], one line of static text that names what
//! was expected, and the byte offset of the problem when the format knows it. A `SchemaError` adds
//! the path from the root value to the part that failed.
//!
//! @category Data formats

import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.io.writer { Writer, WriterError }
import silk.text.format { Debug, Format, Formatter }
import silk.text.string { String }

/// Why a value could not be read, written, or accepted.
pub enum IssueReason {
  /// The input holds another kind of value, such as text where a number was expected.
  InvalidType,
  /// The input holds the right kind of value, but not one the type accepts, such as `300` for a
  /// `u8`.
  InvalidValue,
  /// A required key is absent.
  MissingKey,
  /// The input is not well formed, such as JSON without a closing quote.
  InvalidSyntax,
  /// A check of the value failed.
  CheckFailed,
  /// The text names no variant of the union.
  UnknownVariant,
}

/// One problem found while reading, writing, or checking a value.
///
/// # Details
///
/// `expected` is one line of static text that says what the schema wanted, such as `"a number"` or
/// `"between 1 and 65535"`. `offset` is the byte offset of the problem in the input, when the
/// format knows it.
pub struct Issue {
  /// Why the value was rejected.
  pub reason: IssueReason,
  /// What the schema expected, as one line of text for a person.
  pub expected: string<'static>,
  /// The byte offset of the problem in the input, if known.
  pub offset: Option<usize>,
}

impl Copy for Issue {}

impl Issue {
  /// Returns an issue with `reason` and `expected`, and no offset.
  pub fn make(reason: IssueReason, expected: string<'static>) -> Issue {
    return Issue {reason: reason, expected: expected, offset: Option<usize>.none()}
  }

  /// Returns an issue at byte `offset` of the input.
  pub fn at(reason: IssueReason, expected: string<'static>, offset: usize) -> Issue {
    return Issue {reason: reason, expected: expected, offset: Option<usize>.some(offset)}
  }

  /// Returns an issue for input that holds another kind of value than `expected`.
  pub fn invalidType(expected: string<'static>) -> Issue {
    return Issue.make(IssueReason.InvalidType, expected)
  }

  /// Returns an issue for a value of the right kind that the type does not accept.
  pub fn invalidValue(expected: string<'static>) -> Issue {
    return Issue.make(IssueReason.InvalidValue, expected)
  }

  /// Returns an issue for a required key that is absent.
  pub fn missingKey() -> Issue {
    return Issue.make(IssueReason.MissingKey, "a value")
  }

  /// Returns an issue for a check that failed. `expected` is the check's message.
  pub fn checkFailed(expected: string<'static>) -> Issue {
    return Issue.make(IssueReason.CheckFailed, expected)
  }
}

impl Debug for Issue {
  /// Writes the fields, as `Issue { reason: ..., expected: ..., offset: ... }`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return run Format.debugFields(self, "Issue", &mut formatter)
  }
}

impl Debug for IssueReason {
  /// Writes the name of the reason, such as `MissingKey`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    let name = match &self.* {
      IssueReason.InvalidType => "InvalidType"
      IssueReason.InvalidValue => "InvalidValue"
      IssueReason.MissingKey => "MissingKey"
      IssueReason.InvalidSyntax => "InvalidSyntax"
      IssueReason.CheckFailed => "CheckFailed"
      IssueReason.UnknownVariant => "UnknownVariant"
    }
    return run Format.writeText(&mut formatter, name)
  }
}

/// A rejected value: the problem, and the path from the root value to the part that failed.
///
/// # Details
///
/// `path` names struct fields by their Silk names and list elements by their index, as
/// `settings.ports[2]`. It is empty when the root value itself failed.
pub struct SchemaError {
  /// The path from the root value to the part that failed, such as `settings.ports[2]`.
  pub path: String,
  /// The problem.
  pub issue: Issue,
}

impl Debug for SchemaError {
  /// Writes the fields, as `SchemaError { path: ..., issue: ... }`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return run Format.debugFields(self, "SchemaError", &mut formatter)
  }
}
