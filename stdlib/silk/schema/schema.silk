impl Schema for f64 {
  /// Reads a number.
  effect fn read<R: SchemaReader>(reader: &mut R) -> f64 ! Issue | OutOfMemoryError ? &mut Allocator {
    return run SchemaReader.float(&mut reader.*)
  }

  /// Writes the number. A format that cannot hold a NaN or an infinity fails with an `Issue`.
  effect fn write<W: SchemaWriter>(self: &Self, writer: &mut W)
    -> () ! Issue | WriterError | OutOfMemoryError ? &mut Writer | &mut Allocator {
    return run SchemaWriter.float(&mut writer.*, self.*)
  }
}

impl Schema for String {
  /// Reads text.
  effect fn read<R: SchemaReader>(reader: &mut R) -> String ! Issue | OutOfMemoryError ? &mut Allocator {
    return run SchemaReader.text(&mut reader.*)
  }

  /// Writes the text.
  effect fn write<W: SchemaWriter>(self: &Self, writer: &mut W)
    -> () ! Issue | WriterError | OutOfMemoryError ? &mut Writer | &mut Allocator {
    return run SchemaWriter.text(&mut writer.*, self.view())
  }
}

impl<T: Schema> Schema for Option<T> {
  /// Reads `None` from a null value, and `Some` from any other value.
  effect fn read<R: SchemaReader>(reader: &mut R) -> Option<T> ! Issue | OutOfMemoryError ? &mut Allocator {
    if run SchemaReader.null(&mut reader.*) { return Option<T>.none() }
    return Option<T>.some(run Schemas.read<T, R>(&mut reader.*))
  }

  /// Writes the value of `Some`, or a null value for `None`. A `None` field is left out instead.
  effect fn write<W: SchemaWriter>(self: &Self, writer: &mut W)
    -> () ! Issue | WriterError | OutOfMemoryError ? &mut Writer | &mut Allocator {
    return match &self.* {
      Option<T>.Some {value} => run Schemas.write<T, W>(&value, &mut writer.*)
      Option<T>.None => run SchemaWriter.null(&mut writer.*)
    }
  }

  /// Returns `None`, so an `Option` field may be absent.
  effect fn missing() -> Option<T> ! Issue {
    return Option<T>.none()
  }

  /// Returns `true` for `None`, so a `None` field is left out.
  fn omitted(self: &Self) -> bool {
    return Option<T>.isNone(self)
  }
}

impl<T: Schema> Schema for List<T> {
  /// Reads a list, element by element.
  effect fn read<R: SchemaReader>(reader: &mut R) -> List<T> ! Issue | OutOfMemoryError ? &mut Allocator {
    run SchemaReader.beginList(&mut reader.*)
    let mut values = List<T>.make()
    let mut index = usize.ZERO
    while run SchemaReader.nextElement(&mut reader.*) {
      run SchemaPath.push(SchemaReader.path(&mut reader.*), PathSegment.Index {at: index})
      let value = run Schemas.read<T, R>(&mut reader.*)
      SchemaPath.pop(SchemaReader.path(&mut reader.*))
      run List<T>.append(&mut values, move value)
      index = index + usize.ONE
    }
    return move values
  }

  /// Writes the list, element by element.
  effect fn write<W: SchemaWriter>(self: &Self, writer: &mut W)
    -> () ! Issue | WriterError | OutOfMemoryError ? &mut Writer | &mut Allocator {
    run SchemaWriter.beginList(&mut writer.*)
    let values = List<T>.asSlice(self)
    let mut at = usize.ZERO
    while at < values.length {
      run SchemaWriter.element(&mut writer.*)
      run Schemas.write<T, W>(&values[at], &mut writer.*)
      at = at + usize.ONE
    }
    return run SchemaWriter.endList(&mut writer.*)
  }
}

impl Schema for u8 {
  /// Reads a number and fails with `IssueReason.InvalidValue` if it does not fit.
  effect fn read<R: SchemaReader>(reader: &mut R) -> u8 ! Issue | OutOfMemoryError ? &mut Allocator {
    let raw = run SchemaReader.unsigned(&mut reader.*)
    return match u64.checkedToU8(raw) {
      Option<u8>.Some {value} => value
      Option<u8>.None => { fail Issue.invalidValue("an integer from 0 to 255") }
    }
  }

  /// Writes the number.
  effect fn write<W: SchemaWriter>(self: &Self, writer: &mut W)
    -> () ! Issue | WriterError | OutOfMemoryError ? &mut Writer | &mut Allocator {
    return run SchemaWriter.unsigned(&mut writer.*, u8.toU64(self.*))
  }
}

