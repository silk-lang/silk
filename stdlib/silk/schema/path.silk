//! Where in a value a schema problem is: the steps from the root value to the part that failed.
//!
//! # When to use
//! Read a [`SchemaPath`] from a `silk.schema.issue.SchemaError` to say where a value failed, as
//! `settings.ports[2]` for a person with [`SchemaPath.text`], or as the JSON Pointer
//! `/settings/ports/2` for a tool with [`SchemaPath.pointer`].
//!
//! # Details
//! A path keeps its steps, not text, so one error renders in every form. A field step holds both
//! the field's Silk name and its name on the wire, and a variant step names the variant a tagged
//! union chose, so `auth.Basic.user` says which variant `user` belongs to.
//!
//! @category Data formats

import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.ownership { Copy }
import silk.io.writer { Writer, WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.usize
import silk.text.format { Debug, Format, Formatter }
import silk.text.string { String }

/// One step of a [`SchemaPath`]: a struct field, the variant a union chose, or a list element.
pub union PathSegment {
  /// A struct or variant field.
  Field {
    /// The field's name in Silk.
    pub name: string<'static>,
    /// The field's name in the data format, which `Spec.rename` may change.
    pub wire: string<'static>,
  },
  /// The variant a tagged union chose. Its fields follow it in the path.
  Variant {
    /// The variant's name in Silk.
    pub name: string<'static>,
    /// The variant's name in the data format.
    pub wire: string<'static>,
  },
  /// A list element.
  Index {
    /// The position of the element, from 0.
    pub at: usize,
  },
}

impl Copy for PathSegment {}

/// The path from the root value to the part a reader is reading, such as `settings.ports[2]`.
///
/// # When to use
///
/// A format's `SchemaReader` keeps one and returns it from `SchemaReader.path`. The derived
/// `read` operations push a segment before they read a part and pop it after, so when a read fails
/// the path still names the part that failed.
pub struct SchemaPath {
  steps: List<PathSegment>,
}

impl SchemaPath {
  /// Returns an empty path, which names the root value.
  pub fn make() -> SchemaPath {
    return SchemaPath {steps: List<PathSegment>.make()}
  }

  /// Returns a path with the same segments as `self`.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the copy.
  pub effect fn copy(self: &Self) -> SchemaPath ! OutOfMemoryError ? &mut Allocator {
    let mut copied = SchemaPath.make()
    let segments = List<PathSegment>.asSlice(&self.steps)
    let mut at = usize.ZERO
    while at < segments.length {
      run List<PathSegment>.append(&mut copied.steps, segments[at])
      at = at + usize.ONE
    }
    return move copied
  }

  /// Adds `segment` at the end of the path.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot grow the path.
  pub effect fn push(self: &mut Self, segment: PathSegment) -> () ! OutOfMemoryError ? &mut Allocator {
    return run List<PathSegment>.append(&mut self.steps, segment)
  }

  /// Removes the last segment. It does nothing to an empty path.
  pub fn pop(self: &mut Self) -> () {
    let removed = List<PathSegment>.pop(&mut self.steps)
    drop removed
  }

  /// Removes segments from the end until `length` remain.
  pub fn truncate(self: &mut Self, length: usize) -> () {
    while List<PathSegment>.length(&self.steps) > length { self.pop() }
    return ()
  }

  /// Returns the number of segments.
  pub fn length(self: &Self) -> usize {
    return List<PathSegment>.length(&self.steps)
  }

  /// Returns the segments, from the root value outward.
  pub fn segments(self: &Self) -> &[PathSegment] {
    return List<PathSegment>.asSlice(&self.steps)
  }

  /// Returns whether `text` is the path as [`SchemaPath.text`] writes it, without allocating.
  pub fn matchesText(self: &Self, text: string) -> bool {
    let wanted = String.utf8Bytes(text)
    let segments = List<PathSegment>.asSlice(&self.steps)
    let mut cursor = usize.ZERO
    let mut at = usize.ZERO
    while at < segments.length {
      let mut part: string = ""
      let mut digits: [u8; 24] = [0; 24]
      let mut digitEnd = usize.ZERO
      match segments[at] {
        PathSegment.Field {wire, ..} => { part = wire }
        PathSegment.Variant {wire, ..} => { part = wire }
        PathSegment.Index {at: index} => { digitEnd = Format.writeU64Display(usize.toU64(index), &mut digits, usize.ZERO) }
      }
      if digitEnd == usize.ZERO {
        if at > usize.ZERO {
          if cursor >= wanted.length || wanted[cursor] != 46 { return false }
          cursor = cursor + usize.ONE
        }
        if !startsAt(wanted, cursor, String.utf8Bytes(part)) { return false }
        cursor = cursor + String.byteLength(part)
      } else {
        if cursor >= wanted.length || wanted[cursor] != 91 { return false }
        cursor = cursor + usize.ONE
        if !startsAt(wanted, cursor, Slice.view<u8>(&digits, usize.ZERO, digitEnd)) { return false }
        cursor = cursor + digitEnd
        if cursor >= wanted.length || wanted[cursor] != 93 { return false }
        cursor = cursor + usize.ONE
      }
      at = at + usize.ONE
    }
    return cursor == wanted.length
  }

  /// Returns the path for a person, with wire names, such as `auth.Basic.user` or `ports[2]`. The
  /// root value is empty text.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the text.
  pub effect fn text(self: &Self) -> String ! OutOfMemoryError ? &mut Allocator {
    return run dotted(self, true)
  }

  /// Returns the path with Silk names, such as `auth.Basic.user` or `idleSeconds`, for code that
  /// matches on a type's own field names.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the text.
  pub effect fn names(self: &Self) -> String ! OutOfMemoryError ? &mut Allocator {
    return run dotted(self, false)
  }

  /// Returns the path as a JSON Pointer (RFC 6901) into the input, such as `/auth/user` or
  /// `/ports/2`. A variant step is left out, because the input has no member for it. The root value
  /// is empty text.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the text.
  pub effect fn pointer(self: &Self) -> String ! OutOfMemoryError ? &mut Allocator {
    let mut result = String.make()
    let segments = List<PathSegment>.asSlice(&self.steps)
    let mut at = usize.ZERO
    while at < segments.length {
      match segments[at] {
        PathSegment.Field {wire, ..} => {
          run String.append(&mut result, "/")
          run appendEscapedPointer(&mut result, wire)
        }
        PathSegment.Variant {..} => {}
        PathSegment.Index {at: index} => {
          run String.append(&mut result, "/")
          run appendIndex(&mut result, index)
        }
      }
      at = at + usize.ONE
    }
    return move result
  }
}

fn startsAt(bytes: &[u8], at: usize, part: &[u8]) -> bool {
  if at + part.length > bytes.length { return false }
  let mut index = usize.ZERO
  while index < part.length {
    if bytes[at + index] != part[index] { return false }
    index = index + usize.ONE
  }
  return true
}

effect fn dotted(path: &SchemaPath, wireNames: bool) -> String ! OutOfMemoryError ? &mut Allocator {
  let mut result = String.make()
  let segments = List<PathSegment>.asSlice(&path.steps)
  let mut at = usize.ZERO
  while at < segments.length {
    match segments[at] {
      PathSegment.Field {name, wire} => {
        if at > usize.ZERO { run String.append(&mut result, ".") }
        run String.append(&mut result, if wireNames { wire } else { name })
      }
      PathSegment.Variant {name, wire} => {
        if at > usize.ZERO { run String.append(&mut result, ".") }
        run String.append(&mut result, if wireNames { wire } else { name })
      }
      PathSegment.Index {at: index} => {
        run String.append(&mut result, "[")
        run appendIndex(&mut result, index)
        run String.append(&mut result, "]")
      }
    }
    at = at + usize.ONE
  }
  return move result
}

effect fn appendIndex(text: &mut String, index: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut digits: [u8; 24] = [0; 24]
  let end = Format.writeU64Display(usize.toU64(index), &mut digits, usize.ZERO)
  return run String.append(&mut text.*, unsafe Intrinsic.stringFromUtf8Unchecked(Slice.view<u8>(&digits, usize.ZERO, end)))
}

// A JSON Pointer writes `~` as `~0` and `/` as `~1`.
effect fn appendEscapedPointer(text: &mut String, name: string) -> () ! OutOfMemoryError ? &mut Allocator {
  let bytes = String.utf8Bytes(name)
  let mut start = usize.ZERO
  let mut at = usize.ZERO
  while at < bytes.length {
    if bytes[at] == 126 || bytes[at] == 47 {
      run String.append(&mut text.*, unsafe Intrinsic.stringFromUtf8Unchecked(Slice.view<u8>(bytes, start, at - start)))
      run String.append(&mut text.*, if bytes[at] == 126 { "~0" } else { "~1" })
      start = at + usize.ONE
    }
    at = at + usize.ONE
  }
  return run String.append(&mut text.*, unsafe Intrinsic.stringFromUtf8Unchecked(Slice.view<u8>(bytes, start, bytes.length - start)))
}

impl Debug for SchemaPath {
  /// Writes the path as `text` returns it, in quotes, such as `"ports[2]"`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    run Format.writeText(&mut formatter, "\"")
    let segments = List<PathSegment>.asSlice(&self.steps)
    let mut at = usize.ZERO
    while at < segments.length {
      match segments[at] {
        PathSegment.Field {wire, ..} => {
          if at > usize.ZERO { run Format.writeText(&mut formatter, ".") }
          run Format.writeText(&mut formatter, wire)
        }
        PathSegment.Variant {wire, ..} => {
          if at > usize.ZERO { run Format.writeText(&mut formatter, ".") }
          run Format.writeText(&mut formatter, wire)
        }
        PathSegment.Index {at: index} => {
          let mut digits: [u8; 24] = [0; 24]
          let end = Format.writeU64Display(usize.toU64(index), &mut digits, usize.ZERO)
          run Format.writeText(&mut formatter, "[")
          run Format.writeText(&mut formatter, unsafe Intrinsic.stringFromUtf8Unchecked(Slice.view<u8>(&digits, usize.ZERO, end)))
          run Format.writeText(&mut formatter, "]")
        }
      }
      at = at + usize.ONE
    }
    return run Format.writeText(&mut formatter, "\"")
  }
}
