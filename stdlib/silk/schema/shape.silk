//! One description of a `Schema` type's wire form, for everything that needs to know it.
//!
//! # When to use
//! Call `silk.schema.schema.Schemas.shape<T>()` to get the [`Shapes`] of `T`: what kind of value
//! it is on the wire, its fields with their wire names, doc comments and constraints, and its
//! variants. `silk.schema.json_schema.JsonSchemas` renders it as JSON Schema; command line help
//! and AI tool definitions read the same description.
//!
//! # Details
//! A shape is derived from the type, its `Spec` and its doc comments, never written by hand. Its
//! parts are nodes of one table, and a part refers to another by [`ShapeRef`], so a recursive type
//! such as a tree whose children are trees is one named node that refers to itself. Every struct and
//! union is one node named by its type, so a type used twice is described once.
//!
//! The text in a shape (names, docs, expected text) is static: building one only links nodes.
//!
//! @category Data formats

import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.usize

/// One end of a numeric range.
pub union Bound {
  /// No limit.
  None,
  /// A signed integer limit.
  Signed {
    /// The limit.
    pub value: i64,
  },
  /// An unsigned integer limit.
  Unsigned {
    /// The limit.
    pub value: u64,
  },
  /// A floating-point limit.
  Float {
    /// The limit.
    pub value: f64,
  },
}

impl Copy for Bound {}

/// A rule a value must follow beyond its type, declared in a `Spec` or given by a codec.
///
/// # Details
///
/// Every limit is inclusive. Lengths count characters, as JSON Schema's `minLength` and
/// `maxLength` do, and `usize.MAX` means no upper limit.
pub union Constraint {
  /// A number between `min` and `max`.
  Range {
    /// The smallest value.
    pub min: Bound,
    /// The largest value.
    pub max: Bound,
  },
  /// Text of `min` to `max` characters.
  Length {
    /// The fewest characters.
    pub min: usize,
    /// The most characters.
    pub max: usize,
  },
  /// A list of `min` to `max` elements.
  Items {
    /// The fewest elements.
    pub min: usize,
    /// The most elements.
    pub max: usize,
  },
  /// Text that a regular expression in `silk.text.regex` syntax matches.
  Pattern {
    /// The expression, which JSON Schema shares, since both use JavaScript syntax.
    pub source: string<'static>,
  },
  /// What a person reads when the value fails, instead of the generated text.
  Expected {
    /// The text, such as `"at most an hour"`.
    pub text: string<'static>,
  },
}

impl Copy for Constraint {}

/// A value a static `Spec` can hold, such as a field's default.
pub union Literal {
  /// `true` or `false`.
  Boolean {
    /// The value.
    pub value: bool,
  },
  /// An integer.
  Integer {
    /// The value.
    pub value: i64,
  },
  /// A number.
  Number {
    /// The value.
    pub value: f64,
  },
  /// Text, or the name of a unit variant.
  Text {
    /// The value.
    pub value: string<'static>,
  },
}

impl Copy for Literal {}

/// A link to one node of a [`Shapes`] table.
pub struct ShapeRef {
  /// The node's position in the table.
  pub index: usize,
}

impl Copy for ShapeRef {}

/// The node of a type `T` in a [`Shapes`] table, as `silk.schema.schema.Schema.shape` returns it.
///
/// # Details
///
/// The type parameter says whose shape it is, so a call of `Schema.shape` names the type it wants
/// by the result it expects. `at` is the node itself.
pub struct ShapeOf<T> {
  /// The node.
  pub at: ShapeRef,
  owner: [T; 0],
}

impl<T> ShapeOf<T> {
  /// Returns `at` as the node of `T`.
  pub fn make(at: ShapeRef) -> ShapeOf<T> {
    return ShapeOf<T> {at: at, owner: []}
  }
}

/// The name and doc comment of a named type.
pub struct TypeInfo {
  /// The type's name with its type arguments, such as `Server` or `Page<String>`.
  pub name: string<'static>,
  /// The type's `///` comment, without slashes, or empty text.
  pub doc: string<'static>,
}

impl Copy for TypeInfo {}

/// One field of a struct or of a union variant.
pub struct FieldShape {
  /// The field's name in Silk.
  pub name: string<'static>,
  /// The field's name in the data format.
  pub wire: string<'static>,
  /// The field's `///` comment, without slashes, or empty text.
  pub doc: string<'static>,
  /// The shape of the field's value.
  pub value: ShapeRef,
  /// Whether the field must be present: `false` for an `Option` field and a field with a default.
  pub required: bool,
  /// The value of an absent field, from `Spec.defaultValue`.
  pub default: Option<Literal>,
  /// The rules the field's `Spec` declares.
  pub constraints: List<Constraint>,
}

/// One variant of a union.
pub struct VariantShape {
  /// The variant's name in Silk.
  pub name: string<'static>,
  /// The variant's name in the data format.
  pub wire: string<'static>,
  /// The variant's `///` comment, without slashes, or empty text.
  pub doc: string<'static>,
  /// The variant's fields; empty for a unit variant.
  pub fields: List<FieldShape>,
}

/// The wire form of one type.
pub union Shape {
  /// `true` or `false`.
  Boolean,
  /// An integer between `min` and `max`, the limits of its type.
  Integer {
    /// The smallest value the type holds.
    pub min: Bound,
    /// The largest value the type holds.
    pub max: Bound,
  },
  /// A number.
  Float,
  /// Text.
  Text,
  /// A value that may be absent or null, as `Option` is.
  Optional {
    /// The value when present.
    pub value: ShapeRef,
  },
  /// A list.
  List {
    /// Each element.
    pub element: ShapeRef,
  },
  /// A struct: an object with one member per field.
  Object {
    /// The struct's name and doc comment.
    pub info: TypeInfo,
    /// The fields, in declaration order.
    pub fields: List<FieldShape>,
    /// Whether keys that no field names are rejected, from `Spec.strict`.
    pub strict: bool,
  },
  /// A union whose variants have no fields: the name of one variant.
  Choice {
    /// The union's name and doc comment.
    pub info: TypeInfo,
    /// The variants, in declaration order.
    pub variants: List<VariantShape>,
  },
  /// A union with fields: an object whose `tag` member names the variant and whose other members
  /// are that variant's fields.
  Tagged {
    /// The union's name and doc comment.
    pub info: TypeInfo,
    /// The member that names the variant, `type` unless `Spec.tag` picks another.
    pub tag: string<'static>,
    /// The variants, in declaration order.
    pub variants: List<VariantShape>,
  },
  /// A type with its own `read`, such as a port written as text: its wire form `wire`, plus the
  /// rules its codec reports.
  Custom {
    /// The shape of the wire form.
    pub wire: ShapeRef,
    /// The rules about the wire value itself.
    pub constraints: List<Constraint>,
    /// What else the codec expects, as text for a person, such as `"a port from 1 to 65535"`.
    pub notes: List<string<'static>>,
  },
  /// A node whose type is still being described; only seen while a recursive type is built.
  Pending,
}

/// The shape of one type, and of every type it uses, as a table of nodes.
///
/// # When to use
///
/// Get one from `Schemas.shape<T>()` and walk it from [`Shapes.root`] with [`Shapes.get`].
pub struct Shapes {
  nodes: List<Shape>,
  names: List<string<'static>>,
  top: ShapeRef,
}

impl Shapes {
  /// Returns an empty table. `Schemas.shape` fills it.
  pub fn make() -> Shapes {
    return Shapes {nodes: List<Shape>.make(), names: List<string<'static>>.make(), top: ShapeRef {index: usize.ZERO}}
  }

  /// Returns the shape of the type the table was made for.
  pub fn root(self: &Self) -> ShapeRef {
    return self.top
  }

  /// Sets the node of the type the table describes.
  pub fn setRoot(self: &mut Self, root: ShapeRef) -> () {
    self.top = root
    return ()
  }

  /// Returns the node `at` refers to.
  pub fn get(self: &Self, at: ShapeRef) -> &Shape {
    return &List<Shape>.asSlice(&self.nodes)[at.index]
  }

  /// Returns the number of nodes.
  pub fn length(self: &Self) -> usize {
    return List<Shape>.length(&self.nodes)
  }

  /// Adds an unnamed node and returns its link.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot grow the table.
  pub effect fn add(self: &mut Self, shape: Shape) -> ShapeRef ! OutOfMemoryError ? &mut Allocator {
    let at = ShapeRef {index: List<Shape>.length(&self.nodes)}
    run List<Shape>.append(&mut self.nodes, move shape)
    run List<string<'static>>.append(&mut self.names, "")
    return at
  }

  /// Returns the node of the named type `name`, if the table has one, finished or pending.
  pub fn named(self: &Self, name: string<'static>) -> Option<ShapeRef> {
    let names = List<string<'static>>.asSlice(&self.names)
    let mut at = usize.ZERO
    while at < names.length {
      if names[at] != "" && names[at] == name { return Option<ShapeRef>.some(ShapeRef {index: at}) }
      at = at + usize.ONE
    }
    return Option<ShapeRef>.none()
  }

  /// Adds a pending node for the named type `name` and returns its link. Fill it with
  /// [`Shapes.set`] once its parts are described; a part that refers back to `name` meanwhile finds
  /// this node with [`Shapes.named`].
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot grow the table.
  pub effect fn reserve(self: &mut Self, name: string<'static>) -> ShapeRef ! OutOfMemoryError ? &mut Allocator {
    let at = ShapeRef {index: List<Shape>.length(&self.nodes)}
    run List<Shape>.append(&mut self.nodes, Shape.Pending)
    run List<string<'static>>.append(&mut self.names, name)
    return at
  }

  /// Replaces the node `at` with `shape`.
  pub fn set(self: &mut Self, at: ShapeRef, shape: Shape) -> () {
    let nodes = List<Shape>.asMutSlice(&mut self.nodes)
    nodes[at.index] = move shape
    return ()
  }

  /// Returns the name of the node `at`: its type's name for a struct or union, else empty text.
  pub fn nameOf(self: &Self, at: ShapeRef) -> string<'static> {
    return List<string<'static>>.asSlice(&self.names)[at.index]
  }
}
