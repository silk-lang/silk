//! Named primitive Boolean equality and negation operations.
//!
//! # When to use
//! Prefer `==`, `!=`, and `!` in ordinary expressions. Import [`equals`], [`notEquals`], or [`not`]
//! when an operation must be passed or selected by name.
//!
//! # Details
//! These functions return the same Boolean results as the operators. They allocate no storage and
//! add no Effect channels.
//!
//! # Examples
//! ## Compose named Boolean operations
//! ```silk
//! import silk.bool
//!
//! pub fn main() -> i32 {
//!   let accepted = bool.equals(true, bool.not(false))
//!   if bool.notEquals(accepted, true) {
//!     return 1
//!   }
//!   return 42
//! }
//! ```

/// Returns `true` when `left` and `right` have the same Boolean value.
pub fn equals(left: bool, right: bool) -> bool {
  return Intrinsic.boolEquals(left, right)
}

/// Returns `true` when `left` and `right` have different Boolean values.
pub fn notEquals(left: bool, right: bool) -> bool {
  return Intrinsic.boolNotEquals(left, right)
}

/// Returns the logical negation of `value`.
pub fn not(value: bool) -> bool {
  return Intrinsic.boolNot(value)
}
