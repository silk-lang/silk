//! Explicit source entry for a static non-PIE Linux executable.
//!
//! # When to use
//!
//! Select this module as the artifact runtime root with libc none and loader entry `_start`.
//! The application supplies `pub fn main(inputs: &ProcessInputs) -> i32`.
//!
//! # Details
//!
//! Startup decodes the kernel stack and invokes the application once. Invalid required process
//! facts exit with status 127. Application return becomes the exit_group status.
//!
//! # Gotchas
//!
//! This composition provides no suspension storage or terminal report provider. It requires a
//! synchronous application closure. Fatal traps do not guarantee cleanup or a report.

static if Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.profileText("libc") == "none" && (Intrinsic.targetArchitecture() == "x86_64" || Intrinsic.targetArchitecture() == "aarch64") {
  import Intrinsic.application
  import silk.raw_linux { RawLinux, EXIT_GROUP }
  import silk.raw_process_inputs {ProcessInputs}
  import silk.result {Result}
  import silk.i32

  static if Intrinsic.targetArchitecture() == "x86_64" {
    /// Enters from the Linux kernel stack and transfers to the source process initializer.
    unsafe export "C" fn entry() -> () as "_start" with Intrinsic.machine(
      naked: true,
      noReturn: true,
    ) {
      return unsafe Intrinsic.assembly<()>(
        "movq %rsp, %rdi\nandq $$-16, %rsp\ncall silk_raw_process_entry\nud2",
        "",
        "",
        "readwrite",
        true,
        true,
        (),
      )
    }
  } else {
    /// Enters from the Linux kernel stack and transfers to the source process initializer.
    unsafe export "C" fn entry() -> () as "_start" with Intrinsic.machine(
      naked: true,
      noReturn: true,
    ) {
      return unsafe Intrinsic.assembly<()>(
        "mov x0, sp\nbl silk_raw_process_entry\nbrk #0",
        "",
        "",
        "readwrite",
        true,
        true,
        (),
      )
    }
  }
  /// Decodes the kernel stack, invokes the application and terminates the process.
  ///
  /// # Gotchas
  ///
  /// Only the raw entry fragment may call this export. Its pointer must identify the complete,
  /// aligned and readable Linux kernel stack image. The function does not return.
  export "C" fn invoke(stack: [*]const usize) -> () as "silk_raw_process_entry" {
    let decoded = unsafe ProcessInputs.decode(stack)
    let code = match move decoded {
      Result<ProcessInputs, usize>.Success {value} => application.main(&value)
      Result<ProcessInputs, usize>.Failure {error} => 127
    }
    let status = i32.toUsize(code & 255)
    return unsafe RawLinux.syscallNoReturn(EXIT_GROUP, status)
  }
}
