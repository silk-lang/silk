fn less(a: &[u32], b: &[u32], count: usize) -> bool {
  let mut i = count
  while i > 0 {
    i = i - 1
    if a[i] < b[i] {
      return true
    }
    if a[i] > b[i] {
      return false
    }
  }
  return false
}

// Inputs are reduced public representatives. One subtraction suffices because a+b < 2*n.
fn addMod(a: &[u32], b: &[u32], modulus: &[u32], count: usize) -> [u32; 128] {
  let mut out = emptyWords()
  let mut carry: u64 = 0
  let mut i: usize = 0
  while i < count {
    let sum = u32.toU64(a[i]) + u32.toU64(b[i]) + carry
    out[i] = u64.toU32(u64.bitAnd(sum, 4294967295))
    carry = u64.shiftRight(sum, 32)
    i = i + 1
  }
  if carry != 0 || !less(&out, modulus, count) {
    let mut borrow: u64 = 0
    i = 0
    while i < count {
      let left = u32.toU64(out[i])
      let right = u32.toU64(modulus[i]) + borrow
      out[i] = u64.toU32(u64.bitAnd(u64.wrappingSubtract(left, right), 4294967295))
      borrow = 0
      if left < right {
        borrow = 1
      }
      i = i + 1
    }
  }
  return out
}

fn multiplyMod(a: &[u32], b: &[u32], modulus: &[u32], count: usize, bits: usize) -> [u32; 128] {
  let mut out = emptyWords()
  let mut factor = emptyWords()
  let mut i: usize = 0
  while i < count {
    factor[i] = a[i]
    i = i + 1
  }
  i = 0
  while i < bits {
    let bit = u32.bitAnd(u32.shiftRight(b[i / 32], usize.toU32(i % 32)), 1)
    if bit != 0 {
      out = addMod(&out, &factor, modulus, count)
    }
    factor = addMod(&factor, &factor, modulus, count)
    i = i + 1
  }
  return out
}

fn decodeWords(bytes: &[u8]) -> [u32; 128] {
  let mut out = emptyWords()
  let mut i: usize = 0
  while i < bytes.length {
    let byte = u8.toU32(bytes[bytes.length - 1 - i])
    out[i / 4] = u32.bitOr(out[i / 4], u32.shiftLeft(byte, usize.toU32(8 * (i % 4))))
    i = i + 1
  }
  return out
}

fn recover(key: &RsaPublicKey, signature: &[u8]) -> Result<[u8; 512], RsaError> {
  let width = key.width
  let limbs = key.limbs
  let bits = key.bits
  if signature.length != width {
    return Result<[u8; 512], RsaError>.failResult(RsaError.InvalidLength)
  }
  let base = decodeWords(signature)
  if !less(&base, &key.modulus, limbs) {
    return Result<[u8; 512], RsaError>.failResult(RsaError.InvalidSignature)
  }
  let mut result = base
  let mut i: usize = 0
  while i < 16 {
    result = multiplyMod(&result, &result, &key.modulus, limbs, bits)
    i = i + 1
  }
  result = multiplyMod(&result, &base, &key.modulus, limbs, bits)
  let mut encoded: [u8; 512] = [
