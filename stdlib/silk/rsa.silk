      u32.bitAnd(u32.shiftRight(result[i / 4], usize.toU32(8 * (i % 4))), 255),
    )
    i = i + 1
  }
  return Result<[u8; 512], RsaError>.succeed(move encoded)
}

fn messageLengthAdmitted(length: u64) -> bool {
  return length <= u64.shiftRight(u64.MAX, 3)
}

fn verifyPssEncoding(encoded: &[u8], bits: usize, digest: &[u8]) -> bool {
  let emBits = bits - 1
  let emLength = (emBits + 7) / 8
  let offset = encoded.length - emLength
  if offset > 0 && encoded[0] != 0 {
    return false
  }
  if encoded[encoded.length - 1] != 188 {
    return false
  }
  let dbLength = emLength - 33
  let unused = 8 * emLength - emBits
  let mask = u32.shiftRight(255, usize.toU32(unused))
  if u32.bitAnd(u8.toU32(encoded[offset]), u32.bitXor(mask, 255)) != 0 {
    return false
  }
