//! Two- and three-dimensional positions over any number type.
//!
//! # When to use
//! Use [`Point2`] or [`Point3`] for a location, such as a path vertex, a glyph outline point, or
//! the corner of a box. Use `silk.geometry.vector` for a displacement between locations.
//!
//! # Details
//! A point is a `Copy` struct with public fields, generic over its number type `T`. Point
//! arithmetic keeps positions and displacements apart: `point - point` gives a vector, `point +
//! vector` and `point - vector` give a point, and there is no `point + point`. `&a == &b` compares
//! every field when `T: Equal`. Methods appear only when `T` has the operations they need:
//! [`distance`] needs `silk.num.numeric.Float`.
//!
//! # Gotchas
//! Comparison takes shared borrows, as in `&a == &b`. Float fields compare with IEEE rules, so a
//! point with a NaN field is not equal to itself.
//!
//! # Examples
//! ## Move a point and measure how far it went
//! ```silk
//! import silk.geometry.point { Point2 }
//! import silk.geometry.vector { Vector2 }
//!
//! pub fn main() -> i32 {
//!   let start = Point2<f64>.new(1.0, 1.0)
//!   let end = start + Vector2<f64>.new(3.0, 4.0)
//!   let offset = end - start
//!   if start.distance(end) != 5.0 || offset.x != 3.0 || start.midpoint(end).y != 3.0 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Geometry

import silk.core.equal { Equal }
import silk.core.ops { Add, Divide, Multiply, Subtract }
import silk.core.ownership { Copy }
import silk.geometry.vector { Vector2, Vector3 }
import silk.num.numeric { Float, Numeric, One, Zero }

/// A position in a plane with an `x` and a `y` coordinate of number type `T`.
///
/// # When to use
///
/// Use `Point2` for a location. Use `silk.geometry.vector.Vector2` for a displacement.
///
/// # Details
///
/// The fields are public. `point - point` gives a `Vector2<T>`, and `point + vector` and `point -
/// vector` give a `Point2<T>`, when `T` has the operator. There is no `point + point`. `&a == &b`
/// compares both coordinates when `T: Equal`.
pub struct Point2<T> {
  /// The horizontal coordinate.
  pub x: T,
  /// The vertical coordinate. In a y-down space, such as SVG or a screen, `y` grows downward.
  pub y: T,
}

impl<T: Copy> Copy for Point2<T> {}

impl<T> Point2<T> {
  /// Returns the point at `x` and `y`.
  pub fn new(x: T, y: T) -> Point2<T> {
    return Point2<T> { x: move x, y: move y }
  }

  /// Returns a point whose coordinates are `transform` applied to `x`, then to `y`.
  ///
  /// # When to use
  ///
  /// Use `map` to change the number type, such as from font units in `i32` to `f64`.
  pub fn map<U>(self: Self, transform: mut fn(T) -> U) -> Point2<U> {
    let mut function = move transform
    let x = function(move self.x)
    return Point2<U> { x: move x, y: function(move self.y) }
  }

  /// Returns the vector from the origin to this point, with the same `x` and `y`.
  pub fn toVector(self: Self) -> Vector2<T> {
    return Vector2<T> { x: move self.x, y: move self.y }
  }

  /// Returns the point at the end of `vector` when it starts at the origin.
  pub fn fromVector(vector: Vector2<T>) -> Point2<T> {
    return Point2<T> { x: move vector.x, y: move vector.y }
  }
}

impl<T: Copy> Point2<T> {
  /// Returns the coordinates as the array `[x, y]`.
  pub fn coordinates(self: Self) -> [T; 2] {
    return [self.x, self.y]
  }
}

impl<T: Zero> Point2<T> {
  /// Returns the origin, the point whose coordinates are zero.
  pub fn origin() -> Point2<T> {
    return Point2<T> { x: Numeric.zero<T>(), y: Numeric.zero<T>() }
  }
}

impl<T: Copy + Add<T, T> + Subtract<T, T> + Multiply<T, T>> Point2<T> {
  /// Returns `self + (other - self) * t`: `self` at `t = 0` and `other` at `t = 1`.
  pub fn lerp(self: Self, other: Point2<T>, t: T) -> Point2<T> {
    return Point2<T> { x: self.x + (other.x - self.x) * t, y: self.y + (other.y - self.y) * t }
  }

  /// Returns the square of the distance from `self` to `other`, with no square root.
  ///
  /// # When to use
  ///
  /// Use `distanceSquared` to compare distances, or when `T` is an integer or fixed-point type.
  pub fn distanceSquared(self: Self, other: Point2<T>) -> T {
    let x = other.x - self.x
    let y = other.y - self.y
    return x * x + y * y
  }
}

impl<T: Copy + One + Add<T, T> + Divide<T, T>> Point2<T> {
  /// Returns the point halfway between `self` and `other`.
  pub fn midpoint(self: Self, other: Point2<T>) -> Point2<T> {
    let two = Numeric.one<T>() + Numeric.one<T>()
    return Point2<T> { x: (self.x + other.x) / two, y: (self.y + other.y) / two }
  }
}

impl<T: Copy + Float + Subtract<T, T>> Point2<T> {
  /// Returns the distance from `self` to `other`, computed without overflow in the squares.
  pub fn distance(self: Self, other: Point2<T>) -> T {
    return floatHypot<T>(other.x - self.x, other.y - self.y)
  }

  /// Returns `true` when both coordinates are neither infinite nor NaN.
  pub fn isFinite(self: Self) -> bool {
    return floatIsFinite<T>(self.x) && floatIsFinite<T>(self.y)
  }
}

impl<T: Add<T, T>> Add<Vector2<T>, Point2<T>> for Point2<T> {
  fn add(left: Self, right: Vector2<T>) -> Self {
    return Point2<T> { x: move left.x + move right.x, y: move left.y + move right.y }
  }
}

impl<T: Subtract<T, T>> Subtract<Vector2<T>, Point2<T>> for Point2<T> {
  fn subtract(left: Self, right: Vector2<T>) -> Self {
    return Point2<T> { x: move left.x - move right.x, y: move left.y - move right.y }
  }
}

impl<T: Subtract<T, T>> Subtract<Point2<T>, Vector2<T>> for Point2<T> {
  fn subtract(left: Self, right: Self) -> Vector2<T> {
    return Vector2<T> { x: move left.x - move right.x, y: move left.y - move right.y }
  }
}

impl<T: Equal> Equal for Point2<T> {
  fn equals(left: &Self, right: &Self) -> bool {
    return &left.x == &right.x && &left.y == &right.y
  }
}

/// A position in space with `x`, `y`, and `z` coordinates of number type `T`.
///
/// # When to use
///
/// Use `Point3` for a location in space, such as a point that a `silk.geometry.matrix.Matrix4`
/// projects. Use `silk.geometry.vector.Vector3` for a displacement.
///
/// # Details
///
/// The fields are public. `point - point` gives a `Vector3<T>`, and `point + vector` and `point -
/// vector` give a `Point3<T>`, when `T` has the operator. There is no `point + point`. `&a == &b`
/// compares all three coordinates when `T: Equal`.
pub struct Point3<T> {
  /// The first coordinate.
  pub x: T,
  /// The second coordinate.
  pub y: T,
  /// The third coordinate.
  pub z: T,
}

impl<T: Copy> Copy for Point3<T> {}

impl<T> Point3<T> {
  /// Returns the point at `x`, `y`, and `z`.
  pub fn new(x: T, y: T, z: T) -> Point3<T> {
    return Point3<T> { x: move x, y: move y, z: move z }
  }

  /// Returns a point whose coordinates are `transform` applied to `x`, `y`, then `z`.
  pub fn map<U>(self: Self, transform: mut fn(T) -> U) -> Point3<U> {
    let mut function = move transform
    let x = function(move self.x)
    let y = function(move self.y)
    return Point3<U> { x: move x, y: move y, z: function(move self.z) }
  }

  /// Returns the vector from the origin to this point, with the same coordinates.
  pub fn toVector(self: Self) -> Vector3<T> {
    return Vector3<T> { x: move self.x, y: move self.y, z: move self.z }
  }

  /// Returns the point at the end of `vector` when it starts at the origin.
  pub fn fromVector(vector: Vector3<T>) -> Point3<T> {
    return Point3<T> { x: move vector.x, y: move vector.y, z: move vector.z }
  }
}

impl<T: Copy> Point3<T> {
  /// Returns the coordinates as the array `[x, y, z]`.
  pub fn coordinates(self: Self) -> [T; 3] {
    return [self.x, self.y, self.z]
  }
}

impl<T: Zero> Point3<T> {
  /// Returns the origin, the point whose coordinates are zero.
  pub fn origin() -> Point3<T> {
    return Point3<T> { x: Numeric.zero<T>(), y: Numeric.zero<T>(), z: Numeric.zero<T>() }
  }
}

impl<T: Copy + Add<T, T> + Subtract<T, T> + Multiply<T, T>> Point3<T> {
  /// Returns `self + (other - self) * t`: `self` at `t = 0` and `other` at `t = 1`.
  pub fn lerp(self: Self, other: Point3<T>, t: T) -> Point3<T> {
    return Point3<T> {
      x: self.x + (other.x - self.x) * t,
      y: self.y + (other.y - self.y) * t,
      z: self.z + (other.z - self.z) * t,
    }
  }

  /// Returns the square of the distance from `self` to `other`, with no square root.
  pub fn distanceSquared(self: Self, other: Point3<T>) -> T {
    let x = other.x - self.x
    let y = other.y - self.y
    let z = other.z - self.z
    return x * x + y * y + z * z
  }
}

impl<T: Copy + Float + Subtract<T, T>> Point3<T> {
  /// Returns the distance from `self` to `other`, computed without overflow in the squares.
  pub fn distance(self: Self, other: Point3<T>) -> T {
    return floatHypot<T>(floatHypot<T>(other.x - self.x, other.y - self.y), other.z - self.z)
  }

  /// Returns `true` when all three coordinates are neither infinite nor NaN.
  pub fn isFinite(self: Self) -> bool {
    return floatIsFinite<T>(self.x) && floatIsFinite<T>(self.y) && floatIsFinite<T>(self.z)
  }
}

impl<T: Add<T, T>> Add<Vector3<T>, Point3<T>> for Point3<T> {
  fn add(left: Self, right: Vector3<T>) -> Self {
    return Point3<T> {
      x: move left.x + move right.x,
      y: move left.y + move right.y,
      z: move left.z + move right.z,
    }
  }
}

impl<T: Subtract<T, T>> Subtract<Vector3<T>, Point3<T>> for Point3<T> {
  fn subtract(left: Self, right: Vector3<T>) -> Self {
    return Point3<T> {
      x: move left.x - move right.x,
      y: move left.y - move right.y,
      z: move left.z - move right.z,
    }
  }
}

impl<T: Subtract<T, T>> Subtract<Point3<T>, Vector3<T>> for Point3<T> {
  fn subtract(left: Self, right: Self) -> Vector3<T> {
    return Vector3<T> {
      x: move left.x - move right.x,
      y: move left.y - move right.y,
      z: move left.z - move right.z,
    }
  }
}

impl<T: Equal> Equal for Point3<T> {
  fn equals(left: &Self, right: &Self) -> bool {
    return &left.x == &right.x && &left.y == &right.y && &left.z == &right.z
  }
}

// Float calls go through helpers with explicit type arguments: the native compiler cannot yet
// lower a qualified interface call that a bounded inherent impl's head resolves (silk#2591).
fn floatHypot<T: Float>(x: T, y: T) -> T {
  return Float.hypot(move x, move y)
}

fn floatIsFinite<T: Float>(value: T) -> bool {
  return Float.isFinite(move value)
}
