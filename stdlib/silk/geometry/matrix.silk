//! Square 3x3 and 4x4 matrices for projective and three-dimensional transforms.
//!
//! # When to use
//! Use [`Matrix3`] for a projective transform of a plane, such as a perspective-correct image warp:
//! a homography that `silk.geometry.affine.Affine2` cannot express. Use [`Matrix4`] for transforms
//! in space, such as a CSS `matrix3d`, a `perspective`, or a 3D rotation, and to project those
//! transforms back onto a plane. Use `Affine2` for every transform of a plane that keeps parallel
//! lines parallel; it is smaller and cheaper.
//!
//! # Details
//! A matrix is a `Copy` struct that holds its entries in the public array `values` in column-major
//! order: entry `(row, column)` is `values[column * size + row]`. That is the order of WGSL, GLSL,
//! and CSS `matrix3d`, so a matrix copies to a GPU uniform or from CSS as written. A matrix
//! multiplies a column vector: `left * right` applies `right` first, then `left`.
//!
//! [`Matrix3.project`] and [`Matrix4.project`] divide by the homogeneous `w` coordinate and return
//! `None` where `w` is zero. [`Matrix3.transformHomogeneous`] and [`Matrix4.transformHomogeneous`]
//! return the coordinates before that division, for renderers that must clip against `w`.
//!
//! # Examples
//! ## Round-trip a point through a perspective
//! ```silk
//! import silk.geometry.matrix { Matrix4 }
//! import silk.geometry.point { Point3 }
//! import silk.core.option { Option }
//!
//! pub fn main() -> i32 {
//!   let camera = Matrix4<f64>.perspective(100.0) * Matrix4<f64>.rotationY(0.5)
//!   let inverse = match camera.inverse() {
//!     Option<Matrix4<f64>>.Some { value } => value
//!     Option<Matrix4<f64>>.None => {
//!       return 1
//!     }
//!   }
//!   let point = Point3<f64>.new(10.0, 20.0, 5.0)
//!   let back = match (inverse * camera).project(point) {
//!     Option<Point3<f64>>.Some { value } => value
//!     Option<Point3<f64>>.None => {
//!       return 2
//!     }
//!   }
//!   if back.x < 9.999999 || back.x > 10.000001 || back.z < 4.999999 || back.z > 5.000001 {
//!     return 3
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Geometry

import silk.core.equal { Equal }
import silk.core.ops { Add, Divide, Multiply, Subtract }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.geometry.affine { Affine2 }
import silk.geometry.point { Point2, Point3 }
import silk.geometry.vector { Vector3 }
import silk.num.numeric { Float, Numeric, One, Zero }

/// A 3x3 matrix of number type `T`, stored in column-major order.
///
/// # When to use
///
/// Use `Matrix3` for a projective transform of a plane (a homography). Use
/// `silk.geometry.affine.Affine2` when the transform keeps parallel lines parallel.
///
/// # Details
///
/// Entry `(row, column)` is `values[column * 3 + row]`. The matrix maps `(x, y)` through the
/// homogeneous vector `(x, y, 1)`: `project` divides the first two results by the third. `left *
/// right` applies `right` first. `&a == &b` compares all nine entries when `T: Equal`.
pub struct Matrix3<T> {
  /// The nine entries in column-major order: entry `(row, column)` is `values[column * 3 + row]`.
  pub values: [T; 9],
}

impl<T: Copy> Copy for Matrix3<T> {}

impl<T> Matrix3<T> {
  /// Returns the matrix with `values` in column-major order.
  pub fn new(values: [T; 9]) -> Matrix3<T> {
    return Matrix3<T> { values: move values }
  }
}

impl<T: Copy> Matrix3<T> {
  /// Returns entry `(row, column)`, where both count from zero.
  ///
  /// # Gotchas
  ///
  /// The program traps if `row` or `column` is greater than 2.
  pub fn at(self: &Self, row: usize, column: usize) -> T {
    if row > 2 || column > 2 {
      Intrinsic.trap("Matrix3.at: the row or column is greater than 2")
    }
    return self.values[column * 3 + row]
  }

  /// Returns the matrix with rows and columns exchanged.
  pub fn transpose(self: Self) -> Matrix3<T> {
    let a = self.values
    return Matrix3<T> { values: [a[0], a[3], a[6], a[1], a[4], a[7], a[2], a[5], a[8]] }
  }
}

impl<T: Copy + Zero + One> Matrix3<T> {
  /// Returns the matrix that maps every point to itself.
  pub fn identity() -> Matrix3<T> {
    let zero = Numeric.zero<T>()
    let one = Numeric.one<T>()
    return Matrix3<T> { values: [one, zero, zero, zero, one, zero, zero, zero, one] }
  }

  /// Returns the matrix of the same transform as `transform`: `[xx xy dx; yx yy dy; 0 0 1]`.
  pub fn fromAffine(transform: Affine2<T>) -> Matrix3<T> {
    let zero = Numeric.zero<T>()
    let one = Numeric.one<T>()
    return Matrix3<T> {
      values: [
        transform.xx,
        transform.yx,
        zero,
        transform.xy,
        transform.yy,
        zero,
        transform.dx,
        transform.dy,
        one,
      ],
    }
  }
}

impl<T: Copy + Equal + Zero + One> Matrix3<T> {
  /// Returns the affine transform of the matrix, or `None` when its last row is not `[0 0 1]`.
  ///
  /// # Details
  ///
  /// A matrix whose last row is `[0 0 1]` keeps parallel lines parallel. Any other last row
  /// describes a perspective, which `Affine2` cannot hold.
  pub fn toAffine(self: Self) -> Option<Affine2<T>> {
    let zero = Numeric.zero<T>()
    let one = Numeric.one<T>()
    let a = self.values
    if &a[2] != &zero || &a[5] != &zero || &a[8] != &one {
      return Option<Affine2<T>>.none()
    }
    return Option<Affine2<T>>.some(
      Affine2<T> { xx: a[0], yx: a[1], xy: a[3], yy: a[4], dx: a[6], dy: a[7] },
    )
  }
}

impl<T: Copy + Add<T, T> + Subtract<T, T> + Multiply<T, T>> Matrix3<T> {
  /// Returns the determinant. Zero means the matrix has no inverse.
  pub fn determinant(self: Self) -> T {
    let a = self.values
    return a[0] * (a[4] * a[8] - a[7] * a[5]) - a[3] * (a[1] * a[8] - a[7] * a[2])
      + a[6] * (a[1] * a[5] - a[4] * a[2])
  }

  /// Returns `(x', y', w)`: `point` mapped through `(x, y, 1)` before the division by `w`.
  ///
  /// # When to use
  ///
  /// Use `transformHomogeneous` when the sign of `w` matters, such as to clip the part of a plane
  /// behind a projection. Use `project` for the divided point.
  pub fn transformHomogeneous(self: Self, point: Point2<T>) -> Vector3<T> {
    let a = self.values
    return Vector3<T> {
      x: a[0] * point.x + a[3] * point.y + a[6],
      y: a[1] * point.x + a[4] * point.y + a[7],
      z: a[2] * point.x + a[5] * point.y + a[8],
    }
  }
}

impl<T: Copy + Equal + Zero + Add<T, T> + Subtract<T, T> + Multiply<T, T> + Divide<T, T>> Matrix3<
  T
> {
  /// Returns `point` mapped through the matrix and divided by `w`, or `None` where `w` is zero.
  ///
  /// # Gotchas
  ///
  /// A negative `w` still gives a point, which is the mirror image of a point behind the
  /// projection. Use `transformHomogeneous` to test the sign of `w` first.
  pub fn project(self: Self, point: Point2<T>) -> Option<Point2<T>> {
    let mapped = self.transformHomogeneous(point)
    if &mapped.z == &Numeric.zero<T>() {
      return Option<Point2<T>>.none()
    }
    return Option<Point2<T>>.some(Point2<T> { x: mapped.x / mapped.z, y: mapped.y / mapped.z })
  }
}

impl<
  T: Copy + Equal + Zero + One + Float + Add<T, T> + Subtract<T, T> + Multiply<T, T> + Divide<T, T>
> Matrix3<T> {
  /// Returns the matrix that undoes `self`, or `None` when `self` has no finite inverse.
  ///
  /// # Details
  ///
  /// `None` means the determinant is zero, or that the inverse has an infinite or NaN entry, such
  /// as when an input entry is infinite or NaN.
  pub fn inverse(self: Self) -> Option<Matrix3<T>> {
    let a = self.values
    let cofactor0 = a[8] * a[4] - a[5] * a[7]
    let cofactor1 = a[5] * a[6] - a[8] * a[3]
    let cofactor2 = a[7] * a[3] - a[4] * a[6]
    let determinant = a[0] * cofactor0 + a[1] * cofactor1 + a[2] * cofactor2
    if &determinant == &Numeric.zero<T>() {
      return Option<Matrix3<T>>.none()
    }
    let scale = Numeric.one<T>() / determinant
    let values = [
      cofactor0 * scale,
      (a[2] * a[7] - a[8] * a[1]) * scale,
      (a[5] * a[1] - a[2] * a[4]) * scale,
      cofactor1 * scale,
      (a[8] * a[0] - a[2] * a[6]) * scale,
      (a[2] * a[3] - a[5] * a[0]) * scale,
      cofactor2 * scale,
      (a[1] * a[6] - a[7] * a[0]) * scale,
      (a[4] * a[0] - a[1] * a[3]) * scale,
    ]
    if !allFinite<T>(&values) {
      return Option<Matrix3<T>>.none()
    }
    return Option<Matrix3<T>>.some(Matrix3<T> { values: values })
  }
}

impl<T: Copy + Zero + Add<T, T> + Multiply<T, T>> Multiply<Matrix3<T>, Matrix3<T>> for Matrix3<T> {
  fn multiply(left: Self, right: Self) -> Self {
    let mut values = [Numeric.zero<T>(); 9]
    let mut column: usize = 0
    while column < 3 {
      let mut row: usize = 0
      while row < 3 {
        values[column * 3 + row] = left.values[row] * right.values[column * 3]
          + left.values[3 + row] * right.values[column * 3 + 1]
          + left.values[6 + row] * right.values[column * 3 + 2]
        row = row + 1
      }
      column = column + 1
    }
    return Matrix3<T> { values: values }
  }
}

impl<T: Equal> Equal for Matrix3<T> {
  fn equals(left: &Self, right: &Self) -> bool {
    let mut index: usize = 0
    while index < 9 {
      if &left.values[index] != &right.values[index] {
        return false
      }
      index = index + 1
    }
    return true
  }
}

/// A 4x4 matrix of number type `T`, stored in column-major order.
///
/// # When to use
///
/// Use `Matrix4` for transforms in space, such as CSS `matrix3d`, `perspective`, and 3D rotations.
/// Use `silk.geometry.affine.Affine2` for a transform of a plane.
///
/// # Details
///
/// Entry `(row, column)` is `values[column * 4 + row]`, the order of CSS `matrix3d(...)` arguments
/// and of WGSL `mat4x4`. The matrix maps `(x, y, z)` through the homogeneous vector `(x, y, z, 1)`:
/// `project` divides the first three results by the fourth. `left * right` applies `right` first.
/// `&a == &b` compares all sixteen entries when `T: Equal`.
pub struct Matrix4<T> {
  /// The sixteen entries in column-major order: entry `(row, column)` is `values[column * 4 +
  /// row]`.
  pub values: [T; 16],
}

impl<T: Copy> Copy for Matrix4<T> {}

impl<T> Matrix4<T> {
  /// Returns the matrix with `values` in column-major order, the order of CSS `matrix3d`.
  pub fn new(values: [T; 16]) -> Matrix4<T> {
    return Matrix4<T> { values: move values }
  }
}

impl<T: Copy> Matrix4<T> {
  /// Returns entry `(row, column)`, where both count from zero.
  ///
  /// # Gotchas
  ///
  /// The program traps if `row` or `column` is greater than 3.
  pub fn at(self: &Self, row: usize, column: usize) -> T {
    if row > 3 || column > 3 {
      Intrinsic.trap("Matrix4.at: the row or column is greater than 3")
    }
    return self.values[column * 4 + row]
  }

  /// Returns the matrix with rows and columns exchanged.
  pub fn transpose(self: Self) -> Matrix4<T> {
    let a = self.values
    return Matrix4<T> {
      values: [
        a[0],
        a[4],
        a[8],
        a[12],
        a[1],
        a[5],
        a[9],
        a[13],
        a[2],
        a[6],
        a[10],
        a[14],
        a[3],
        a[7],
        a[11],
        a[15],
      ],
    }
  }
}

impl<T: Copy + Zero + One> Matrix4<T> {
  /// Returns the matrix that maps every point to itself.
  pub fn identity() -> Matrix4<T> {
    let zero = Numeric.zero<T>()
    let one = Numeric.one<T>()
    return Matrix4<T> {
      values: [
        one,
        zero,
        zero,
        zero,
        zero,
        one,
        zero,
        zero,
        zero,
        zero,
        one,
        zero,
        zero,
        zero,
        zero,
        one,
      ],
    }
  }

  /// Returns the matrix of `transform` acting on x and y, with z unchanged.
  ///
  /// # Details
  ///
  /// This is the CSS rule for a 2D transform in a 3D context: `matrix(a, b, c, d, e, f)` equals
  /// `matrix3d(a, b, 0, 0, c, d, 0, 0, 0, 0, 1, 0, e, f, 0, 1)`.
  pub fn fromAffine(transform: Affine2<T>) -> Matrix4<T> {
    let zero = Numeric.zero<T>()
    let one = Numeric.one<T>()
    return Matrix4<T> {
      values: [
        transform.xx,
        transform.yx,
        zero,
        zero,
        transform.xy,
        transform.yy,
        zero,
        zero,
        zero,
        zero,
        one,
        zero,
        transform.dx,
        transform.dy,
        zero,
        one,
      ],
    }
  }

  /// Returns the matrix that moves every point by `offset`.
  pub fn translation(offset: Vector3<T>) -> Matrix4<T> {
    let zero = Numeric.zero<T>()
    let one = Numeric.one<T>()
    return Matrix4<T> {
      values: [
        one,
        zero,
        zero,
        zero,
        zero,
        one,
        zero,
        zero,
        zero,
        zero,
        one,
        zero,
        offset.x,
        offset.y,
        offset.z,
        one,
      ],
    }
  }

  /// Returns the matrix that multiplies x by `x`, y by `y`, and z by `z` around the origin.
  pub fn scale(x: T, y: T, z: T) -> Matrix4<T> {
    let zero = Numeric.zero<T>()
    let one = Numeric.one<T>()
    return Matrix4<T> {
      values: [
        x,
        zero,
        zero,
        zero,
        zero,
        y,
        zero,
        zero,
        zero,
        zero,
        z,
        zero,
        zero,
        zero,
        zero,
        one,
      ],
    }
  }
}

impl<T: Copy + Equal + Zero + One> Matrix4<T> {
  /// Returns the affine transform of the matrix, or `None` when it is not a 2D transform.
  ///
  /// # Details
  ///
  /// The result is `Some` exactly when the matrix leaves z and w alone, as CSS "is 2D" requires:
  /// entries `(2, 0)`, `(3, 0)`, `(2, 1)`, `(3, 1)`, `(0, 2)`, `(1, 2)`, `(3, 2)`, and `(2, 3)` are
  /// zero and entries `(2, 2)` and `(3, 3)` are one.
  pub fn toAffine(self: Self) -> Option<Affine2<T>> {
    let zero = Numeric.zero<T>()
    let one = Numeric.one<T>()
    let a = self.values
    if &a[2] != &zero || &a[3] != &zero || &a[6] != &zero || &a[7] != &zero || &a[8] != &zero
      || &a[9] != &zero
      || &a[10] != &one
      || &a[11] != &zero
      || &a[14] != &zero
      || &a[15] != &one {
      return Option<Affine2<T>>.none()
    }
    return Option<Affine2<T>>.some(
      Affine2<T> { xx: a[0], yx: a[1], xy: a[4], yy: a[5], dx: a[12], dy: a[13] },
    )
  }
}

impl<T: Copy + Zero + One + Float + Subtract<T, T>> Matrix4<T> {
  /// Returns the matrix that rotates by `radians` around the x axis, turning positive y toward
  /// positive z.
  pub fn rotationX(radians: T) -> Matrix4<T> {
    let zero = Numeric.zero<T>()
    let one = Numeric.one<T>()
    let sine = floatSin<T>(radians)
    let cosine = floatCos<T>(radians)
    return Matrix4<T> {
      values: [
        one,
        zero,
        zero,
        zero,
        zero,
        cosine,
        sine,
        zero,
        zero,
        zero - sine,
        cosine,
        zero,
        zero,
        zero,
        zero,
        one,
      ],
    }
  }

  /// Returns the matrix that rotates by `radians` around the y axis, turning positive z toward
  /// positive x.
  pub fn rotationY(radians: T) -> Matrix4<T> {
    let zero = Numeric.zero<T>()
    let one = Numeric.one<T>()
    let sine = floatSin<T>(radians)
    let cosine = floatCos<T>(radians)
    return Matrix4<T> {
      values: [
        cosine,
        zero,
        zero - sine,
        zero,
        zero,
        one,
        zero,
        zero,
        sine,
        zero,
        cosine,
        zero,
        zero,
        zero,
        zero,
        one,
      ],
    }
  }

  /// Returns the matrix that rotates by `radians` around the z axis, turning positive x toward
  /// positive y.
  ///
  /// # Details
  ///
  /// On the x-y plane this is `silk.geometry.affine.Affine2.rotation` with the same angle, which is
  /// clockwise in a y-down space such as CSS.
  pub fn rotationZ(radians: T) -> Matrix4<T> {
    let zero = Numeric.zero<T>()
    let one = Numeric.one<T>()
    let sine = floatSin<T>(radians)
    let cosine = floatCos<T>(radians)
    return Matrix4<T> {
      values: [
        cosine,
        sine,
        zero,
        zero,
        zero - sine,
        cosine,
        zero,
        zero,
        zero,
        zero,
        one,
        zero,
        zero,
        zero,
        zero,
        one,
      ],
    }
  }
}

impl<T: Copy + Zero + One + Subtract<T, T> + Divide<T, T>> Matrix4<T> {
  /// Returns the CSS `perspective(distance)` matrix: a viewer at `distance` along positive z.
  ///
  /// # Details
  ///
  /// The matrix is the identity with entry `(3, 2)` set to `-1 / distance`, so a point at depth `z`
  /// scales by `distance / (distance - z)` after `project`.
  ///
  /// # Gotchas
  ///
  /// A zero `distance` divides by zero. CSS treats `perspective(0)` as no perspective; pass the
  /// identity in that case.
  pub fn perspective(distance: T) -> Matrix4<T> {
    let zero = Numeric.zero<T>()
    let one = Numeric.one<T>()
    return Matrix4<T> {
      values: [
        one,
        zero,
        zero,
        zero,
        zero,
        one,
        zero,
        zero,
        zero,
        zero,
        one,
        zero - one / distance,
        zero,
        zero,
        zero,
        one,
      ],
    }
  }
}

impl<T: Copy + Add<T, T> + Subtract<T, T> + Multiply<T, T>> Matrix4<T> {
  /// Returns the determinant. Zero means the matrix has no inverse.
  pub fn determinant(self: Self) -> T {
    let a = self.values
    let b00 = a[0] * a[5] - a[1] * a[4]
    let b01 = a[0] * a[6] - a[2] * a[4]
    let b02 = a[0] * a[7] - a[3] * a[4]
    let b03 = a[1] * a[6] - a[2] * a[5]
    let b04 = a[1] * a[7] - a[3] * a[5]
    let b05 = a[2] * a[7] - a[3] * a[6]
    let b06 = a[8] * a[13] - a[9] * a[12]
    let b07 = a[8] * a[14] - a[10] * a[12]
    let b08 = a[8] * a[15] - a[11] * a[12]
    let b09 = a[9] * a[14] - a[10] * a[13]
    let b10 = a[9] * a[15] - a[11] * a[13]
    let b11 = a[10] * a[15] - a[11] * a[14]
    return b00 * b11 - b01 * b10 + b02 * b09 + b03 * b08 - b04 * b07 + b05 * b06
  }

  /// Returns `(x', y', z', w)`: `point` mapped through `(x, y, z, 1)` before the division by `w`.
  ///
  /// # When to use
  ///
  /// Use `transformHomogeneous` when the sign of `w` matters, such as to clip geometry behind the
  /// viewer of a `perspective`. Use `project` for the divided point.
  pub fn transformHomogeneous(self: Self, point: Point3<T>) -> [T; 4] {
    let a = self.values
    return [
      a[0] * point.x + a[4] * point.y + a[8] * point.z + a[12],
      a[1] * point.x + a[5] * point.y + a[9] * point.z + a[13],
      a[2] * point.x + a[6] * point.y + a[10] * point.z + a[14],
      a[3] * point.x + a[7] * point.y + a[11] * point.z + a[15],
    ]
  }
}

impl<T: Copy + Equal + Zero + Add<T, T> + Subtract<T, T> + Multiply<T, T> + Divide<T, T>> Matrix4<
  T
> {
  /// Returns `point` mapped through the matrix and divided by `w`, or `None` where `w` is zero.
  ///
  /// # Gotchas
  ///
  /// A negative `w` still gives a point, which is the mirror image of a point behind the viewer.
  /// Use `transformHomogeneous` to test the sign of `w` first.
  pub fn project(self: Self, point: Point3<T>) -> Option<Point3<T>> {
    let mapped = self.transformHomogeneous(point)
    if &mapped[3] == &Numeric.zero<T>() {
      return Option<Point3<T>>.none()
    }
    return Option<Point3<T>>.some(
      Point3<T> { x: mapped[0] / mapped[3], y: mapped[1] / mapped[3], z: mapped[2] / mapped[3] },
    )
  }

  /// Returns the point of the plane `z = 0` mapped through the matrix, flattened onto the x-y
  /// plane, or `None` where `w` is zero.
  ///
  /// # When to use
  ///
  /// Use `projectPoint2` to draw a 2D element under a CSS 3D transform: the element lies in the
  /// plane `z = 0`, and the screen shows the x and y of each projected point.
  pub fn projectPoint2(self: Self, point: Point2<T>) -> Option<Point2<T>> {
    let mapped = self.transformHomogeneous(
      Point3<T> { x: point.x, y: point.y, z: Numeric.zero<T>() },
    )
    if &mapped[3] == &Numeric.zero<T>() {
      return Option<Point2<T>>.none()
    }
    return Option<Point2<T>>.some(Point2<T> { x: mapped[0] / mapped[3], y: mapped[1] / mapped[3] })
  }
}

impl<
  T: Copy + Equal + Zero + One + Float + Add<T, T> + Subtract<T, T> + Multiply<T, T> + Divide<T, T>
> Matrix4<T> {
  /// Returns the matrix that undoes `self`, or `None` when `self` has no finite inverse.
  ///
  /// # Details
  ///
  /// The inverse is the adjugate divided by the determinant. `None` means the determinant is zero,
  /// or that the inverse has an infinite or NaN entry, such as when an input entry is infinite or
  /// NaN.
  pub fn inverse(self: Self) -> Option<Matrix4<T>> {
    let a = self.values
    let b00 = a[0] * a[5] - a[1] * a[4]
    let b01 = a[0] * a[6] - a[2] * a[4]
    let b02 = a[0] * a[7] - a[3] * a[4]
    let b03 = a[1] * a[6] - a[2] * a[5]
    let b04 = a[1] * a[7] - a[3] * a[5]
    let b05 = a[2] * a[7] - a[3] * a[6]
    let b06 = a[8] * a[13] - a[9] * a[12]
    let b07 = a[8] * a[14] - a[10] * a[12]
    let b08 = a[8] * a[15] - a[11] * a[12]
    let b09 = a[9] * a[14] - a[10] * a[13]
    let b10 = a[9] * a[15] - a[11] * a[13]
    let b11 = a[10] * a[15] - a[11] * a[14]
    let determinant = b00 * b11 - b01 * b10 + b02 * b09 + b03 * b08 - b04 * b07 + b05 * b06
    if &determinant == &Numeric.zero<T>() {
      return Option<Matrix4<T>>.none()
    }
    let scale = Numeric.one<T>() / determinant
    let values = [
      (a[5] * b11 - a[6] * b10 + a[7] * b09) * scale,
      (a[2] * b10 - a[1] * b11 - a[3] * b09) * scale,
      (a[13] * b05 - a[14] * b04 + a[15] * b03) * scale,
      (a[10] * b04 - a[9] * b05 - a[11] * b03) * scale,
      (a[6] * b08 - a[4] * b11 - a[7] * b07) * scale,
      (a[0] * b11 - a[2] * b08 + a[3] * b07) * scale,
      (a[14] * b02 - a[12] * b05 - a[15] * b01) * scale,
      (a[8] * b05 - a[10] * b02 + a[11] * b01) * scale,
      (a[4] * b10 - a[5] * b08 + a[7] * b06) * scale,
      (a[1] * b08 - a[0] * b10 - a[3] * b06) * scale,
      (a[12] * b04 - a[13] * b02 + a[15] * b00) * scale,
      (a[9] * b02 - a[8] * b04 - a[11] * b00) * scale,
      (a[5] * b07 - a[4] * b09 - a[6] * b06) * scale,
      (a[0] * b09 - a[1] * b07 + a[2] * b06) * scale,
      (a[13] * b01 - a[12] * b03 - a[14] * b00) * scale,
      (a[8] * b03 - a[9] * b01 + a[10] * b00) * scale,
    ]
    if !allFinite<T>(&values) {
      return Option<Matrix4<T>>.none()
    }
    return Option<Matrix4<T>>.some(Matrix4<T> { values: values })
  }
}

impl<T: Copy + Zero + Add<T, T> + Multiply<T, T>> Multiply<Matrix4<T>, Matrix4<T>> for Matrix4<T> {
  fn multiply(left: Self, right: Self) -> Self {
    let mut values = [Numeric.zero<T>(); 16]
    let mut column: usize = 0
    while column < 4 {
      let mut row: usize = 0
      while row < 4 {
        values[column * 4 + row] = left.values[row] * right.values[column * 4]
          + left.values[4 + row] * right.values[column * 4 + 1]
          + left.values[8 + row] * right.values[column * 4 + 2]
          + left.values[12 + row] * right.values[column * 4 + 3]
        row = row + 1
      }
      column = column + 1
    }
    return Matrix4<T> { values: values }
  }
}

impl<T: Equal> Equal for Matrix4<T> {
  fn equals(left: &Self, right: &Self) -> bool {
    let mut index: usize = 0
    while index < 16 {
      if &left.values[index] != &right.values[index] {
        return false
      }
      index = index + 1
    }
    return true
  }
}

fn allFinite<T: Copy + Float>(values: &[T]) -> bool {
  let mut index: usize = 0
  while index < values.length {
    if !Float.isFinite(values[index]) {
      return false
    }
    index = index + 1
  }
  return true
}

// Float calls go through helpers with explicit type arguments: the native compiler cannot yet
// lower a qualified interface call that a bounded inherent impl's head resolves (silk#2591).
fn floatSin<T: Float>(value: T) -> T {
  return Float.sin(move value)
}

fn floatCos<T: Float>(value: T) -> T {
  return Float.cos(move value)
}
