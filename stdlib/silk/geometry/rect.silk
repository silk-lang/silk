//! Axis-aligned rectangles stored as their minimum and maximum corners, over any number type.
//!
//! # When to use
//! Use [`Rect`] for a bounding box, a clip region, a viewport at a position, or the border box of a
//! layout node. Build one from two corners with [`new`] or [`fromPoints`], or from a position and
//! an extent with [`fromOriginSize`]. Use `silk.geometry.size.Size2` for an extent with no
//! position.
//!
//! # Details
//! A rectangle is a `Copy` struct with the public fields `xMin`, `yMin`, `xMax`, and `yMax`,
//! generic over its number type `T`. Edges are inclusive: [`contains`] accepts a point on an edge,
//! and two rectangles that share an edge have a zero-area [`intersection`]. Bound computations such
//! as [`unionWith`], [`include`], and [`intersection`] need `T: Order`, so they work for integers,
//! fixed-point types, and floats. `&a == &b` compares every field when `T: Equal`.
//!
//! A valid rectangle has `xMin <= xMax` and `yMin <= yMax`. Fields are public, so a rectangle can
//! be built reversed; [`isValid`] tests for that and [`normalize`] fixes it.
//!
//! # Gotchas
//! For a float type, `Order` follows the IEEE 754 total order: negative zero is below positive
//! zero, and a NaN with the sign bit clear is above every number. Test [`isFinite`] first when the
//! input can hold NaN.
//!
//! # Examples
//! ## Grow a box and clip it
//! ```silk
//! import silk.geometry.insets { Insets }
//! import silk.geometry.point { Point2 }
//! import silk.geometry.rect { Rect }
//! import silk.geometry.size { Size2 }
//! import silk.core.option { Option }
//!
//! pub fn main() -> i32 {
//!   let card = Rect<f64>.fromOriginSize(Point2<f64>.new(10.0, 10.0), Size2<f64>.new(100.0, 50.0))
//!   let shadow = card.inflate(Insets<f64>.uniform(4.0))
//!   let viewport = Rect<f64>.new(0.0, 0.0, 80.0, 80.0)
//!   let visible = match shadow.intersection(viewport) {
//!     Option<Rect<f64>>.Some { value } => value
//!     Option<Rect<f64>>.None => {
//!       return 1
//!     }
//!   }
//!   let corner = Point2<f64>.new(110.0, 60.0)
//!   if visible.width() != 74.0 || visible.height() != 58.0 || !card.contains(corner) {
//!     return 2
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Geometry

import silk.core.equal { Equal }
import silk.core.ops { Add, Divide, Subtract }
import silk.core.option { Option }
import silk.core.order { Order }
import silk.core.ownership { Copy }
import silk.geometry.insets { Insets }
import silk.geometry.point { Point2 }
import silk.geometry.size { Size2 }
import silk.geometry.vector { Vector2 }
import silk.num.numeric { Float, Numeric, One }

/// An axis-aligned rectangle of number type `T`, stored as its minimum and maximum corners.
///
/// # When to use
///
/// Use `Rect` for bounds, clips, and boxes at a position. Use `silk.geometry.size.Size2` for an
/// extent alone.
///
/// # Details
///
/// The fields are public. A valid rectangle has `xMin <= xMax` and `yMin <= yMax`; a rectangle can
/// have zero width or height and still has a position. Edges are inclusive. `&a == &b` compares all
/// four fields when `T: Equal`.
pub struct Rect<T> {
  /// The minimum x coordinate: the left edge in a y-down space.
  pub xMin: T,
  /// The minimum y coordinate: the top edge in a y-down space.
  pub yMin: T,
  /// The maximum x coordinate: the right edge in a y-down space.
  pub xMax: T,
  /// The maximum y coordinate: the bottom edge in a y-down space.
  pub yMax: T,
}

impl<T: Copy> Copy for Rect<T> {}

impl<T> Rect<T> {
  /// Returns the rectangle with the given edges, as written.
  ///
  /// # Gotchas
  ///
  /// `new` does not reorder its arguments. Use [`fromPoints`] when the corners can come in any
  /// order.
  pub fn new(xMin: T, yMin: T, xMax: T, yMax: T) -> Rect<T> {
    return Rect<T> { xMin: move xMin, yMin: move yMin, xMax: move xMax, yMax: move yMax }
  }

  /// Returns a rectangle whose fields are `transform` applied to `xMin`, `yMin`, `xMax`, then
  /// `yMax`.
  ///
  /// # Gotchas
  ///
  /// A `transform` that reverses order, such as negation, gives a reversed rectangle. Call
  /// [`normalize`] on the result in that case.
  pub fn map<U>(self: Self, transform: mut fn(T) -> U) -> Rect<U> {
    let mut function = move transform
    let xMin = function(move self.xMin)
    let yMin = function(move self.yMin)
    let xMax = function(move self.xMax)
    return Rect<U> {
      xMin: move xMin,
      yMin: move yMin,
      xMax: move xMax,
      yMax: function(move self.yMax),
    }
  }
}

impl<T: Copy> Rect<T> {
  /// Returns the minimum corner `(xMin, yMin)`: the top-left corner in a y-down space.
  pub fn origin(self: Self) -> Point2<T> {
    return Point2<T> { x: self.xMin, y: self.yMin }
  }

  /// Returns the maximum corner `(xMax, yMax)`: the bottom-right corner in a y-down space.
  pub fn maxCorner(self: Self) -> Point2<T> {
    return Point2<T> { x: self.xMax, y: self.yMax }
  }

  /// Returns the edges as the array `[xMin, yMin, xMax, yMax]`.
  pub fn edges(self: Self) -> [T; 4] {
    return [self.xMin, self.yMin, self.xMax, self.yMax]
  }
}

impl<T: Copy + Add<T, T>> Rect<T> {
  /// Returns the rectangle whose minimum corner is `origin` and whose extent is `size`.
  ///
  /// # Gotchas
  ///
  /// A negative width or height gives a reversed rectangle. Call [`normalize`] on the result when
  /// the size can be negative.
  pub fn fromOriginSize(origin: Point2<T>, size: Size2<T>) -> Rect<T> {
    return Rect<T> {
      xMin: origin.x,
      yMin: origin.y,
      xMax: origin.x + size.width,
      yMax: origin.y + size.height,
    }
  }

  /// Returns the rectangle moved by `offset`, with the same size.
  pub fn translate(self: Self, offset: Vector2<T>) -> Rect<T> {
    return Rect<T> {
      xMin: self.xMin + offset.x,
      yMin: self.yMin + offset.y,
      xMax: self.xMax + offset.x,
      yMax: self.yMax + offset.y,
    }
  }
}

impl<T: Copy + Subtract<T, T>> Rect<T> {
  /// Returns `xMax - xMin`. A reversed rectangle gives a negative width.
  pub fn width(self: Self) -> T {
    return self.xMax - self.xMin
  }

  /// Returns `yMax - yMin`. A reversed rectangle gives a negative height.
  pub fn height(self: Self) -> T {
    return self.yMax - self.yMin
  }

  /// Returns the extent `(xMax - xMin, yMax - yMin)`.
  pub fn size(self: Self) -> Size2<T> {
    return Size2<T> { width: self.xMax - self.xMin, height: self.yMax - self.yMin }
  }
}

impl<T: Copy + Add<T, T> + Subtract<T, T>> Rect<T> {
  /// Returns the rectangle grown by `insets` on each side.
  ///
  /// # Details
  ///
  /// `insets.left` moves `xMin` down, `insets.top` moves `yMin` down, `insets.right` moves `xMax`
  /// up, and `insets.bottom` moves `yMax` up. Negative insets shrink the rectangle.
  ///
  /// # Gotchas
  ///
  /// Insets that shrink by more than the size give a reversed rectangle. Test the result with
  /// [`isValid`] when the insets can be negative.
  pub fn inflate(self: Self, insets: Insets<T>) -> Rect<T> {
    return Rect<T> {
      xMin: self.xMin - insets.left,
      yMin: self.yMin - insets.top,
      xMax: self.xMax + insets.right,
      yMax: self.yMax + insets.bottom,
    }
  }
}

impl<T: Copy + One + Add<T, T> + Divide<T, T>> Rect<T> {
  /// Returns the point halfway between the minimum and the maximum corner.
  pub fn center(self: Self) -> Point2<T> {
    let two = Numeric.one<T>() + Numeric.one<T>()
    return Point2<T> { x: (self.xMin + self.xMax) / two, y: (self.yMin + self.yMax) / two }
  }
}

impl<T: Copy + Order> Rect<T> {
  /// Returns the smallest rectangle that holds both `first` and `second`, in any order.
  pub fn fromPoints(first: Point2<T>, second: Point2<T>) -> Rect<T> {
    return Rect<T> {
      xMin: smaller<T>(first.x, second.x),
      yMin: smaller<T>(first.y, second.y),
      xMax: larger<T>(first.x, second.x),
      yMax: larger<T>(first.y, second.y),
    }
  }

  /// Returns `true` when `xMin <= xMax` and `yMin <= yMax`.
  pub fn isValid(self: &Self) -> bool {
    return &self.xMin <= &self.xMax && &self.yMin <= &self.yMax
  }

  /// Returns `true` when the rectangle has no area: its width or height is zero or negative.
  ///
  /// # Details
  ///
  /// A zero-width or zero-height rectangle still has a position, so [`unionWith`] and
  /// [`intersection`] use its edges. Use `isEmpty` to skip drawing, not to mark absent bounds; use
  /// `Option<Rect<T>>` for that.
  pub fn isEmpty(self: &Self) -> bool {
    return &self.xMax <= &self.xMin || &self.yMax <= &self.yMin
  }

  /// Returns `true` when `point` is inside the rectangle or on one of its edges.
  pub fn contains(self: &Self, point: Point2<T>) -> bool {
    return &self.xMin <= &point.x && &point.x <= &self.xMax && &self.yMin <= &point.y
      && &point.y <= &self.yMax
  }

  /// Returns the rectangle with `xMin`/`xMax` and `yMin`/`yMax` swapped where they are reversed.
  pub fn normalize(self: Self) -> Rect<T> {
    return Rect<T> {
      xMin: smaller<T>(self.xMin, self.xMax),
      yMin: smaller<T>(self.yMin, self.yMax),
      xMax: larger<T>(self.xMin, self.xMax),
      yMax: larger<T>(self.yMin, self.yMax),
    }
  }

  /// Returns the smallest rectangle that holds both `self` and `other`.
  ///
  /// # Details
  ///
  /// A zero-area rectangle still counts: its edges extend the result. Both inputs should be valid;
  /// a reversed input gives a result that holds neither.
  pub fn unionWith(self: Self, other: Rect<T>) -> Rect<T> {
    return Rect<T> {
      xMin: smaller<T>(self.xMin, other.xMin),
      yMin: smaller<T>(self.yMin, other.yMin),
      xMax: larger<T>(self.xMax, other.xMax),
      yMax: larger<T>(self.yMax, other.yMax),
    }
  }

  /// Returns the smallest rectangle that holds `self` and `point`.
  pub fn include(self: Self, point: Point2<T>) -> Rect<T> {
    return Rect<T> {
      xMin: smaller<T>(self.xMin, point.x),
      yMin: smaller<T>(self.yMin, point.y),
      xMax: larger<T>(self.xMax, point.x),
      yMax: larger<T>(self.yMax, point.y),
    }
  }

  /// Returns the region that `self` and `other` share, or `None` when they do not overlap.
  ///
  /// # Details
  ///
  /// Edges are inclusive, so two rectangles that touch along an edge or at a corner give a
  /// zero-area rectangle there, not `None`.
  pub fn intersection(self: Self, other: Rect<T>) -> Option<Rect<T>> {
    let result = Rect<T> {
      xMin: larger<T>(self.xMin, other.xMin),
      yMin: larger<T>(self.yMin, other.yMin),
      xMax: smaller<T>(self.xMax, other.xMax),
      yMax: smaller<T>(self.yMax, other.yMax),
    }
    if &result.xMax < &result.xMin || &result.yMax < &result.yMin {
      return Option<Rect<T>>.none()
    }
    return Option<Rect<T>>.some(result)
  }
}

impl<T: Copy + Float> Rect<T> {
  /// Returns `true` when all four edges are neither infinite nor NaN.
  pub fn isFinite(self: Self) -> bool {
    return floatIsFinite<T>(self.xMin) && floatIsFinite<T>(self.yMin) && floatIsFinite<T>(self.xMax)
      && floatIsFinite<T>(self.yMax)
  }
}

impl<T: Equal> Equal for Rect<T> {
  fn equals(left: &Self, right: &Self) -> bool {
    return &left.xMin == &right.xMin && &left.yMin == &right.yMin && &left.xMax == &right.xMax
      && &left.yMax == &right.yMax
  }
}

fn smaller<T: Copy + Order>(left: T, right: T) -> T {
  if &right < &left {
    return right
  }
  return left
}

fn larger<T: Copy + Order>(left: T, right: T) -> T {
  if &left < &right {
    return right
  }
  return left
}

// Float calls go through a helper with an explicit type argument: the native compiler cannot yet
// lower a qualified interface call that a bounded inherent impl's head resolves (silk#2591).
fn floatIsFinite<T: Float>(value: T) -> bool {
  return Float.isFinite(move value)
}
