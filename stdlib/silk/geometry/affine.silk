//! Two-dimensional affine transforms: scale, rotation, skew, and translation in one matrix.
//!
//! # When to use
//! Use [`Affine2`] to move, scale, rotate, or skew points, vectors, and rectangles in a plane, such
//! as an SVG `transform` attribute, a font matrix, or a canvas transform. Use
//! `silk.geometry.matrix` for projective (3x3) and three-dimensional (4x4) transforms.
//!
//! # Details
//! An affine transform is a `Copy` struct with six public coefficients, generic over its number
//! type `T`. It maps a point `(x, y)` to `(xx * x + xy * y + dx, yx * x + yy * y + dy)`. The
//! coefficient order `xx, yx, xy, yy, dx, dy` is the order of SVG and CSS `matrix(a, b, c, d, e,
//! f)`, of PDF, and of the OpenType and FreeType font matrices, so [`fromCoefficients`] takes those
//! six numbers as written.
//!
//! `left * right` composes two transforms: the result applies `right` first, then `left`. So a list
//! of transforms written left to right, as in SVG, multiplies in the written order. `transform *
//! point` maps a `silk.geometry.point.Point2`, and `transform * vector` maps a
//! `silk.geometry.vector.Vector2` without the translation. `&a == &b` compares all six coefficients
//! when `T: Equal`.
//!
//! # Gotchas
//! [`rotation`] and [`skew`] take radians. A positive angle turns the positive x axis toward
//! positive y, which is clockwise in a y-down space such as SVG and counterclockwise in a y-up
//! space such as a font.
//!
//! # Examples
//! ## Rotate around a point
//! ```silk
//! import silk.geometry.affine { Affine2 }
//! import silk.geometry.point { Point2 }
//! import silk.geometry.vector { Vector2 }
//!
//! pub fn main() -> i32 {
//!   let pivot = Vector2<f64>.new(10.0, 0.0)
//!   let turn = Affine2<f64>.translation(pivot) * Affine2<f64>.rotation(3.141592653589793)
//!     * Affine2<f64>.translation(-pivot)
//!   let moved = turn * Point2<f64>.new(12.0, 0.0)
//!   if moved.x < 7.999999 || moved.x > 8.000001 || moved.y < -0.000001 || moved.y > 0.000001 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Geometry

import silk.core.equal { Equal }
import silk.core.ops { Add, Divide, Multiply, Negate, Subtract }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.geometry.point { Point2 }
import silk.geometry.rect { Rect }
import silk.geometry.vector { Vector2 }
import silk.num.numeric { Float, Numeric, One, Zero }

/// A two-dimensional affine transform with coefficients of number type `T`.
///
/// # When to use
///
/// Use `Affine2` for any combination of scale, rotation, skew, reflection, and translation in a
/// plane.
///
/// # Details
///
/// The transform maps `(x, y)` to `(xx * x + xy * y + dx, yx * x + yy * y + dy)`. As a matrix that
/// multiplies a column vector, it is `[xx xy dx; yx yy dy; 0 0 1]`. The field order matches SVG and
/// CSS `matrix(a, b, c, d, e, f)`: `a = xx`, `b = yx`, `c = xy`, `d = yy`, `e = dx`, and `f = dy`.
///
/// `left * right` applies `right` first, then `left`. `transform * point` maps a `Point2<T>`, and
/// `transform * vector` maps a `Vector2<T>` with no translation. `&a == &b` compares all six
/// coefficients when `T: Equal`.
pub struct Affine2<T> {
  /// How much input x adds to output x (SVG `a`).
  pub xx: T,
  /// How much input x adds to output y (SVG `b`).
  pub yx: T,
  /// How much input y adds to output x (SVG `c`).
  pub xy: T,
  /// How much input y adds to output y (SVG `d`).
  pub yy: T,
  /// The translation added to output x (SVG `e`).
  pub dx: T,
  /// The translation added to output y (SVG `f`).
  pub dy: T,
}

impl<T: Copy> Copy for Affine2<T> {}

impl<T> Affine2<T> {
  /// Returns the transform with the six coefficients in SVG `matrix(a, b, c, d, e, f)` order.
  pub fn new(xx: T, yx: T, xy: T, yy: T, dx: T, dy: T) -> Affine2<T> {
    return Affine2<T> {
      xx: move xx,
      yx: move yx,
      xy: move xy,
      yy: move yy,
      dx: move dx,
      dy: move dy,
    }
  }

  /// Returns a transform whose coefficients are `transform` applied to each one, in field order.
  pub fn map<U>(self: Self, transform: mut fn(T) -> U) -> Affine2<U> {
    let mut function = move transform
    let xx = function(move self.xx)
    let yx = function(move self.yx)
    let xy = function(move self.xy)
    let yy = function(move self.yy)
    let dx = function(move self.dx)
    return Affine2<U> {
      xx: move xx,
      yx: move yx,
      xy: move xy,
      yy: move yy,
      dx: move dx,
      dy: function(move self.dy),
    }
  }
}

impl<T: Copy> Affine2<T> {
  /// Returns the transform from six coefficients in SVG `matrix(a, b, c, d, e, f)` order.
  pub fn fromCoefficients(values: [T; 6]) -> Affine2<T> {
    return Affine2<T> {
      xx: values[0],
      yx: values[1],
      xy: values[2],
      yy: values[3],
      dx: values[4],
      dy: values[5],
    }
  }

  /// Returns the six coefficients in SVG `matrix(a, b, c, d, e, f)` order.
  pub fn coefficients(self: Self) -> [T; 6] {
    return [self.xx, self.yx, self.xy, self.yy, self.dx, self.dy]
  }

  /// Returns the translation part `(dx, dy)`.
  pub fn translationPart(self: Self) -> Vector2<T> {
    return Vector2<T> { x: self.dx, y: self.dy }
  }
}

impl<T: Zero + One> Affine2<T> {
  /// Returns the transform that maps every point to itself.
  pub fn identity() -> Affine2<T> {
    return Affine2<T> {
      xx: Numeric.one<T>(),
      yx: Numeric.zero<T>(),
      xy: Numeric.zero<T>(),
      yy: Numeric.one<T>(),
      dx: Numeric.zero<T>(),
      dy: Numeric.zero<T>(),
    }
  }

  /// Returns the transform that moves every point by `offset`.
  pub fn translation(offset: Vector2<T>) -> Affine2<T> {
    return Affine2<T> {
      xx: Numeric.one<T>(),
      yx: Numeric.zero<T>(),
      xy: Numeric.zero<T>(),
      yy: Numeric.one<T>(),
      dx: move offset.x,
      dy: move offset.y,
    }
  }

  /// Returns the transform that multiplies x by `x` and y by `y` around the origin.
  ///
  /// # Details
  ///
  /// A negative factor reflects across the other axis.
  pub fn scale(x: T, y: T) -> Affine2<T> {
    return Affine2<T> {
      xx: move x,
      yx: Numeric.zero<T>(),
      xy: Numeric.zero<T>(),
      yy: move y,
      dx: Numeric.zero<T>(),
      dy: Numeric.zero<T>(),
    }
  }
}

impl<T: Copy + Zero + One + Float + Negate<T>> Affine2<T> {
  /// Returns the transform that rotates by `radians` around the origin.
  ///
  /// # Details
  ///
  /// A positive angle turns the positive x axis toward positive y. That is clockwise in a y-down
  /// space such as SVG, where it matches `rotate(angle)` after a degree-to-radian conversion.
  pub fn rotation(radians: T) -> Affine2<T> {
    let sine = floatSin<T>(radians)
    let cosine = floatCos<T>(radians)
    return Affine2<T> {
      xx: cosine,
      yx: sine,
      xy: -sine,
      yy: cosine,
      dx: Numeric.zero<T>(),
      dy: Numeric.zero<T>(),
    }
  }

  /// Returns the transform that skews by `x` radians along the x axis and `y` radians along the y
  /// axis.
  ///
  /// # Details
  ///
  /// The result is `[1, tan(y), tan(x), 1, 0, 0]`. `skew(angle, 0)` is SVG `skewX(angle)` and
  /// `skew(0, angle)` is SVG `skewY(angle)`, after a degree-to-radian conversion.
  pub fn skew(x: T, y: T) -> Affine2<T> {
    return Affine2<T> {
      xx: Numeric.one<T>(),
      yx: floatTan<T>(y),
      xy: floatTan<T>(x),
      yy: Numeric.one<T>(),
      dx: Numeric.zero<T>(),
      dy: Numeric.zero<T>(),
    }
  }
}

impl<T: Copy + Multiply<T, T> + Subtract<T, T>> Affine2<T> {
  /// Returns `xx * yy - yx * xy`, the factor by which the transform scales area.
  ///
  /// # Details
  ///
  /// A negative determinant means the transform reflects. Zero means it is singular: it flattens
  /// the plane onto a line or a point and has no inverse.
  pub fn determinant(self: Self) -> T {
    return self.xx * self.yy - self.yx * self.xy
  }
}

impl<
  T: Copy + Equal + Zero + One + Float + Add<T, T> + Subtract<T, T> + Multiply<T, T> + Divide<
    T,
    T
  > + Negate<T>,
> Affine2<T> {
  /// Returns the transform that undoes `self`, or `None` when `self` has no finite inverse.
  ///
  /// # Details
  ///
  /// `None` means `self` is singular or has an infinite or NaN coefficient, or that the inverse has
  /// an infinite or NaN coefficient. Each row is scaled by its largest coefficient before the
  /// determinant is formed, so a valid transform with very large or very small scales does not
  /// overflow or underflow to a false `None`. No epsilon rejects a small but invertible scale.
  pub fn inverse(self: Self) -> Option<Affine2<T>> {
    if !self.isFinite() {
      return Option<Affine2<T>>.none()
    }
    let zero = Numeric.zero<T>()
    let rowX = floatMax<T>(floatAbs<T>(self.xx), floatAbs<T>(self.xy))
    let rowY = floatMax<T>(floatAbs<T>(self.yx), floatAbs<T>(self.yy))
    if &rowX == &zero || &rowY == &zero {
      return Option<Affine2<T>>.none()
    }
    let xx = self.xx / rowX
    let xy = self.xy / rowX
    let yx = self.yx / rowY
    let yy = self.yy / rowY
    let determinant = xx * yy - yx * xy
    if &determinant == &zero {
      return Option<Affine2<T>>.none()
    }
    let inverseXx = inverseCoefficient<T>(yy, determinant, rowX)
    let inverseYx = inverseCoefficient<T>(-yx, determinant, rowX)
    let inverseXy = inverseCoefficient<T>(-xy, determinant, rowY)
    let inverseYy = inverseCoefficient<T>(xx, determinant, rowY)
    let result = Affine2<T> {
      xx: inverseXx,
      yx: inverseYx,
      xy: inverseXy,
      yy: inverseYy,
      dx: -(inverseXx * self.dx + inverseXy * self.dy),
      dy: -(inverseYx * self.dx + inverseYy * self.dy),
    }
    if !result.isFinite() {
      return Option<Affine2<T>>.none()
    }
    return Option<Affine2<T>>.some(result)
  }

  /// Returns the largest factor by which the transform stretches any vector.
  ///
  /// # When to use
  ///
  /// Use `maxScale` to convert a tolerance in device space to user space, such as a
  /// curve-flattening tolerance or a stroke width.
  ///
  /// # Details
  ///
  /// The result is the largest singular value of the linear part `[xx xy; yx yy]`; the translation
  /// does not count. A transform with an infinite or NaN linear coefficient gives NaN or infinity.
  pub fn maxScale(self: Self) -> T {
    let zero = Numeric.zero<T>()
    let scale = floatMax<T>(
      floatMax<T>(floatAbs<T>(self.xx), floatAbs<T>(self.yx)),
      floatMax<T>(floatAbs<T>(self.xy), floatAbs<T>(self.yy)),
    )
    if &scale == &zero || !floatIsFinite<T>(scale) {
      return scale
    }
    let xx = self.xx / scale
    let yx = self.yx / scale
    let xy = self.xy / scale
    let yy = self.yy / scale
    let first = xx * xx + yx * yx
    let second = xy * xy + yy * yy
    let mixed = xx * xy + yx * yy
    let difference = first - second
    let two = Numeric.one<T>() + Numeric.one<T>()
    let four = two + two
    let root = floatSqrt<T>(difference * difference + four * mixed * mixed)
    return scale * floatSqrt<T>((first + second + root) / two)
  }

  /// Returns the smallest rectangle that holds the four transformed corners of `bounds`.
  ///
  /// # Details
  ///
  /// The result holds the whole transformed rectangle, because an affine transform maps a rectangle
  /// to a parallelogram whose corners are the transformed corners. For a rotated or skewed
  /// transform it is larger than the transformed shape. To bound a curve exactly, transform the
  /// curve first and bound the result.
  ///
  /// # Gotchas
  ///
  /// An infinite or NaN coefficient or edge can give NaN edges. Test with `Rect.isFinite`.
  pub fn transformRect(self: Self, bounds: Rect<T>) -> Rect<T> {
    let first = mapPoint<T>(self, bounds.xMin, bounds.yMin)
    let second = mapPoint<T>(self, bounds.xMax, bounds.yMin)
    let third = mapPoint<T>(self, bounds.xMin, bounds.yMax)
    let fourth = mapPoint<T>(self, bounds.xMax, bounds.yMax)
    return Rect<T> {
      xMin: floatMin<T>(floatMin<T>(first.x, second.x), floatMin<T>(third.x, fourth.x)),
      yMin: floatMin<T>(floatMin<T>(first.y, second.y), floatMin<T>(third.y, fourth.y)),
      xMax: floatMax<T>(floatMax<T>(first.x, second.x), floatMax<T>(third.x, fourth.x)),
      yMax: floatMax<T>(floatMax<T>(first.y, second.y), floatMax<T>(third.y, fourth.y)),
    }
  }

  /// Returns `true` when all six coefficients are neither infinite nor NaN.
  pub fn isFinite(self: Self) -> bool {
    return floatIsFinite<T>(self.xx) && floatIsFinite<T>(self.yx) && floatIsFinite<T>(self.xy)
      && floatIsFinite<T>(self.yy)
      && floatIsFinite<T>(self.dx)
      && floatIsFinite<T>(self.dy)
  }
}

impl<T: Copy + Add<T, T> + Multiply<T, T>> Multiply<Affine2<T>, Affine2<T>> for Affine2<T> {
  fn multiply(left: Self, right: Self) -> Self {
    return Affine2<T> {
      xx: left.xx * right.xx + left.xy * right.yx,
      yx: left.yx * right.xx + left.yy * right.yx,
      xy: left.xx * right.xy + left.xy * right.yy,
      yy: left.yx * right.xy + left.yy * right.yy,
      dx: left.xx * right.dx + left.xy * right.dy + left.dx,
      dy: left.yx * right.dx + left.yy * right.dy + left.dy,
    }
  }
}

impl<T: Copy + Add<T, T> + Multiply<T, T>> Multiply<Point2<T>, Point2<T>> for Affine2<T> {
  fn multiply(left: Self, right: Point2<T>) -> Point2<T> {
    return Point2<T> {
      x: left.xx * right.x + left.xy * right.y + left.dx,
      y: left.yx * right.x + left.yy * right.y + left.dy,
    }
  }
}

impl<T: Copy + Add<T, T> + Multiply<T, T>> Multiply<Vector2<T>, Vector2<T>> for Affine2<T> {
  fn multiply(left: Self, right: Vector2<T>) -> Vector2<T> {
    return Vector2<T> {
      x: left.xx * right.x + left.xy * right.y,
      y: left.yx * right.x + left.yy * right.y,
    }
  }
}

impl<T: Equal> Equal for Affine2<T> {
  fn equals(left: &Self, right: &Self) -> bool {
    return &left.xx == &right.xx && &left.yx == &right.yx && &left.xy == &right.xy
      && &left.yy == &right.yy
      && &left.dx == &right.dx
      && &left.dy == &right.dy
  }
}

// transformRect maps its corners here: a generic body cannot yet use the `Affine2<T> * Point2<T>`
// conformance that its own bounds satisfy (silk#2593).
fn mapPoint<T: Copy + Add<T, T> + Multiply<T, T>>(transform: Affine2<T>, x: T, y: T) -> Point2<T> {
  return Point2<T> {
    x: transform.xx * x + transform.xy * y + transform.dx,
    y: transform.yx * x + transform.yy * y + transform.dy,
  }
}

// Divides by `determinant * scale` without overflowing or underflowing the product.
fn inverseCoefficient<T: Copy + Equal + Float + Zero + Multiply<T, T> + Divide<T, T>>(
  numerator: T,
  determinant: T,
  scale: T,
) -> T {
  let denominator = determinant * scale
  let zero = Numeric.zero<T>()
  if &denominator != &zero && floatIsFinite<T>(denominator) {
    return numerator / denominator
  }
  if !floatIsFinite<T>(denominator) {
    return (numerator / scale) / determinant
  }
  return (numerator / determinant) / scale
}

// Float calls go through helpers with explicit type arguments: the native compiler cannot yet
// lower a qualified interface call that a bounded inherent impl's head resolves (silk#2591).
fn floatSin<T: Float>(value: T) -> T {
  return Float.sin(move value)
}

fn floatCos<T: Float>(value: T) -> T {
  return Float.cos(move value)
}

fn floatTan<T: Float>(value: T) -> T {
  return Float.tan(move value)
}

fn floatAbs<T: Float>(value: T) -> T {
  return Float.abs(move value)
}

fn floatSqrt<T: Float>(value: T) -> T {
  return Float.sqrt(move value)
}

fn floatMin<T: Float>(left: T, right: T) -> T {
  return Float.min(move left, move right)
}

fn floatMax<T: Float>(left: T, right: T) -> T {
  return Float.max(move left, move right)
}

fn floatIsFinite<T: Float>(value: T) -> bool {
  return Float.isFinite(move value)
}
