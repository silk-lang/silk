//! The program entry for the standalone LLVM-to-WebAssembly profile.
//!
//! # When to use
//! Select this module as the runtime root for a wasm32 program with no host services. The host
//! calls the exported `main` function with no arguments and gets an `i32` exit status.
//!
//! # Details
//! `main` in the application can return one of these types:
//!
//! | `main` returns | Exit status |
//! |---|---|
//! | `i32` | The value |
//! | `()` | `0` |
//! | `Effect<() ! E>` | `0` on success, `1` on a failure (the payload is dropped first) |
//!
//! The application runs inside its own `Execution`. Nested transfers complete before the exported
//! `main` returns. If the application is still parked at the end, or the `Execution` cannot be
//! allocated, the status is `1`.
//!
//! With the `threading` profile set to `multi`, the module also exports the entry that runs each
//! thread `NativeThread.spawn` starts.
//!
//! # Gotchas
//! - The host gives no arguments and no services. The application source supplies each service
//!   requirement.
//! - The complete application call must satisfy `Intrinsic.NonParking`. To park on an external
//!   event, the application must own that wait itself.
//! - There is no diagnostic observer. A fatal trap stays a bare machine trap, with no cleanup.
//!
//! @category Native platform

static if Intrinsic.targetArchitecture() == "wasm32" {
  import Intrinsic.application
  import silk.mem.allocator {Allocator, OutOfMemoryError}
  import silk.core.effect {Effect}
  import silk.concurrency.execution {Execution}
  struct Application<T> {}
  interface EntryResult<T> {
    fn code(value: T) -> i32
  }
  impl EntryResult<i32> for Application<i32> {
    fn code(value: i32) -> i32 {
      return value
    }
  }
  impl EntryResult<()> for Application<()> {
    fn code(value: ()) -> i32 {
      return 0
    }
  }
  effect<'env> fn failed<E: 'env, 'env>(error: E) -> i32 {
    drop error
    return 1
  }
  effect fn succeeded(value: ()) -> i32 {
    return 0
  }
  impl<'env, E> EntryResult<Effect<'env; () ! E>> for Application<Effect<'env; () ! E>> {
    fn code(value: Effect<'env; () ! E>) -> i32 {
      let computation = Effect.flatMap(move value, succeeded)
      return run Effect.catchAll(move computation, failed)
    }
  }
  fn select<T>(value: &T) -> Application<T> {
    return Application<T> {}
  }
  fn adapt<T, P: EntryResult<T>>(value: T, provider: P) -> i32 {
    return EntryResult<T>.code(move value)
  }
  fn invokeApplication() -> i32 {
    let value = application.main()
    let provider = select(&value)
    return adapt(move value, move provider)
  }
  fn invoke<F: fn<'static>() -> i32 + Intrinsic.NonParking>(body: F) -> i32 {
    return body()
  }
  struct EntrySuspended {}
  struct Status {
    complete: bool,
    code: i32,
  }
  fn ready(state: &()) -> () {}
  fn complete(state: &mut Status, code: i32) -> () {
    state.complete = true
    state.code = code
  }
  fn suspended(state: &mut Status, execution: Intrinsic.Execution<i32>) -> () {
    drop execution
  }
  effect fn start() -> i32 ! OutOfMemoryError | EntrySuspended {
    let mut allocator = Allocator.systemAllocatorProvider()
    let execution = run Execution.make(
      effect {
        return invoke(invokeApplication)
      },
      (),
      ready,
    )
      |> Effect.provideMut<Allocator>(&mut allocator)
    let mut status = Status {complete: false, code: 0}
    run Execution.drive(move execution, &mut status, complete, suspended)
    if status.complete == false {
      fail EntrySuspended {}
    }
    return status.code
  }
  /// Runs the selected application and returns its exit status. The host sees it as `main`.
  ///
  /// # Details
  /// Each call makes and releases its own application `Execution`. Nested transfers complete before
  /// the function returns.
  export "C" fn enter() -> i32 as "main" {
    return run Effect.catchAll(start(), failed)
  }
  static if Intrinsic.profileText("threading") == "multi" {
    import silk.concurrency.thread_native {NativeThread}
    /// Runs one thread that `NativeThread.spawn` started. The `wasi_thread_start` of the linked
    /// runtime calls it on the stack of the new thread.
    export "C" fn threadEntry(argument: ?*mut u8) -> () as "silk_wasm_thread_entry_v1" {
      unsafe NativeThread.runStarted(argument)
      return ()
    }
  }
}
