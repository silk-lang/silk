//! The C library of every wasm32 executable: the heap entry points, the byte routines, the 128-bit
//! multiply and shifts, the floating remainder and the fused multiply-add.
//!
//! # When to use
//! The standard library's catalog names this module as the wasm32 targets' support module, so
//! every wasm32 executable links its C exports, whatever its runtime. Sealed core storage and
//! LLVM's lowering call `malloc`, `free`, `memcpy`, `__multi3`, `fmod`, `fma` and the rest, and
//! WebAssembly has no libc or compiler-rt to supply them. Applications do not call these functions.
//!
//! # Details
//! The heap functions forward to [`WasmHeap`]. LLVM expands its own copies and fills into
//! `memory.copy` and `memory.fill`, so the byte routines serve only calls by name: an unoptimized
//! build's sealed storage calls. [`memmove`] handles overlapping ranges, so it implements `memcpy`
//! too.
//!
//! # Gotchas
//! These C exports are link symbols only: unlike other C exports on WebAssembly, the module does
//! not export them to its host.
//!
//! @category Native platform

static if Intrinsic.targetObjectFormat() == "wasm" {
  import silk.mem.pointer { Pointer }
  import silk.num.f32
  import silk.num.f64
  import silk.num.i32
  import silk.num.i64
  import silk.num.u64
  import silk.platform.wasm.heap { WasmHeap }

  /// Returns uninitialized storage of at least `size` bytes, or null.
  ///
  /// # Gotchas
  /// Release a non-null result once with [`free`].
  export "C" fn malloc(size: usize) -> ?[*]mut u8 {
    return unsafe WasmHeap.allocate(size)
  }

  /// Returns `count * size` zero bytes, or null.
  ///
  /// # Gotchas
  /// Release a non-null result once with [`free`].
  export "C" fn calloc(count: usize, size: usize) -> ?[*]mut u8 {
    return unsafe WasmHeap.allocateZeroed(count, size)
  }

  /// Resizes storage from [`malloc`], or returns null and keeps it.
  ///
  /// # Gotchas
  /// `allocation` must be null or live storage of this heap.
  export "C" fn realloc(allocation: ?[*]mut u8, size: usize) -> ?[*]mut u8 {
    return unsafe WasmHeap.resize(allocation, size)
  }

  /// Releases storage from [`malloc`]. Null does nothing.
  ///
  /// # Gotchas
  /// `allocation` must be null or live storage of this heap, released once.
  export "C" fn free(allocation: ?[*]mut u8) -> () {
    unsafe WasmHeap.release(allocation)
    return ()
  }

  /// Copies `count` possibly overlapping bytes and returns `destination`.
  ///
  /// # Gotchas
  /// Both ranges must be live for `count` bytes.
  export "C" fn memmove(destination: ?[*]mut u8, source: ?[*]const u8, count: usize) -> ?[*]mut u8 {
    if count == 0 { return destination }
    unsafe {
      let output = Intrinsic.pointerRequalify<?[*]mut u8, [*]mut u8>(destination)
      let input = Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(source)
      // A destination above the source copies from the end, so each byte is read before any
      // overlapping write.
      if Pointer.addressMany<u8>(output) > Pointer.addressMany<u8>(input) {
        let mut at = count
        while at > 0 {
          at = at - 1
          Pointer.write<u8>(Pointer.atMut<u8>(output, at), Pointer.read<u8>(Pointer.at<u8>(input, at)))
        }
      } else {
        let mut at: usize = 0
        while at < count {
          Pointer.write<u8>(Pointer.atMut<u8>(output, at), Pointer.read<u8>(Pointer.at<u8>(input, at)))
          at = at + 1
        }
      }
    }
    return destination
  }

  /// Copies `count` bytes and returns `destination`, as [`memmove`] does.
  ///
  /// # Gotchas
  /// Both ranges must be live for `count` bytes.
  export "C" fn memcpy(destination: ?[*]mut u8, source: ?[*]const u8, count: usize) -> ?[*]mut u8 {
    return unsafe memmove(destination, source, count)
  }

  /// Sets `count` bytes to the low byte of `value` and returns `destination`.
  ///
  /// # Gotchas
  /// The range must be live and writable for `count` bytes.
  export "C" fn memset(destination: ?[*]mut u8, value: i32, count: usize) -> ?[*]mut u8 {
    if count == 0 { return destination }
    let byte = i32.toU8(i32.bitAnd(value, 255))
    unsafe {
      let output = Intrinsic.pointerRequalify<?[*]mut u8, [*]mut u8>(destination)
      let mut at: usize = 0
      while at < count {
        Pointer.write<u8>(Pointer.atMut<u8>(output, at), byte)
        at = at + 1
      }
    }
    return destination
  }

  /// Compares `count` unsigned bytes: zero when equal, otherwise the sign of the first difference.
  ///
  /// # Gotchas
  /// Both ranges must be live for `count` bytes.
  export "C" fn memcmp(left: ?[*]const u8, right: ?[*]const u8, count: usize) -> i32 {
    if count == 0 { return 0 }
    unsafe {
      let first = Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(left)
      let second = Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(right)
      let mut at: usize = 0
      while at < count {
        let a = Pointer.read<u8>(Pointer.at<u8>(first, at))
        let b = Pointer.read<u8>(Pointer.at<u8>(second, at))
        if a < b { return -1 }
        if a > b { return 1 }
        at = at + 1
      }
    }
    return 0
  }

  /// The low 128 bits of a 128-bit product, which LLVM calls for overflow-checked 64-bit products;
  /// wasm32 has no compiler-rt. WebAssembly passes each 128-bit operand as its two 64-bit halves,
  /// low first, and returns the result through `result`.
  ///
  /// # Gotchas
  /// `result` must address two writable, 8-byte aligned words.
  export "C" fn multiply128(result: *mut u64, leftLow: u64, leftHigh: u64, rightLow: u64, rightHigh: u64) -> () as "__multi3" {
    let mask: u64 = 4294967295
    let a0 = u64.bitAnd(leftLow, mask)
    let a1 = u64.shiftRight(leftLow, 32)
    let b0 = u64.bitAnd(rightLow, mask)
    let b1 = u64.shiftRight(rightLow, 32)
    // Checked 64-bit products would call this function again, so every step wraps modulo 2^64.
    let low = u64.wrappingMultiply(a0, b0)
    let middleA = u64.wrappingAdd(u64.wrappingMultiply(a1, b0), u64.shiftRight(low, 32))
    let middleB = u64.wrappingAdd(u64.wrappingMultiply(a0, b1), u64.bitAnd(middleA, mask))
    let mut high = u64.wrappingMultiply(a1, b1)
    high = u64.wrappingAdd(high, u64.shiftRight(middleA, 32))
    high = u64.wrappingAdd(high, u64.shiftRight(middleB, 32))
    high = u64.wrappingAdd(high, u64.wrappingMultiply(leftLow, rightHigh))
    high = u64.wrappingAdd(high, u64.wrappingMultiply(leftHigh, rightLow))
    unsafe {
      Pointer.write<u64>(result, u64.bitOr(u64.shiftLeft(middleB, 32), u64.bitAnd(low, mask)))
      Pointer.write<u64>(Pointer.atMut<u64>(Pointer.assumeManyMut<u64>(result), 1), high)
    }
    return ()
  }

  /// The 128-bit value `high:low` shifted left by `count` bits, as compiler-rt's `__ashlti3`. LLVM
  /// introduces 128-bit shifts when it merges two 64-bit words, and wasm32 has no compiler-rt.
  ///
  /// # Details
  /// `count` is below 128. The result goes through `result`, low half first, like
  /// [`multiply128`].
  ///
  /// # Gotchas
  /// `result` must address two writable, 8-byte aligned words.
  export "C" fn shiftLeft128(result: *mut u64, low: u64, high: u64, count: i32) -> () as "__ashlti3" {
    let bits = u64.bitAnd(i32.wrappingToU64(count), 127)
    if bits == 0 {
      return writeWords(result, low, high)
    }
    if bits >= 64 {
      return writeWords(result, 0, u64.shiftLeft(low, bits - 64))
    }
    return writeWords(
      result,
      u64.shiftLeft(low, bits),
      u64.bitOr(u64.shiftLeft(high, bits), u64.shiftRight(low, 64 - bits))
    )
  }

  /// The 128-bit value `high:low` shifted right by `count` bits with zeros, as compiler-rt's
  /// `__lshrti3`.
  ///
  /// # Details
  /// `count` is below 128. The result goes through `result`, low half first, like
  /// [`multiply128`].
  ///
  /// # Gotchas
  /// `result` must address two writable, 8-byte aligned words.
  export "C" fn shiftRight128(result: *mut u64, low: u64, high: u64, count: i32) -> () as "__lshrti3" {
    let bits = u64.bitAnd(i32.wrappingToU64(count), 127)
    if bits == 0 {
      return writeWords(result, low, high)
    }
    if bits >= 64 {
      return writeWords(result, u64.shiftRight(high, bits - 64), 0)
    }
    return writeWords(
      result,
      u64.bitOr(u64.shiftRight(low, bits), u64.shiftLeft(high, 64 - bits)),
      u64.shiftRight(high, bits)
    )
  }

  /// The 128-bit value `high:low` shifted right by `count` bits with copies of its sign bit, as
  /// compiler-rt's `__ashrti3`.
  ///
  /// # Details
  /// `count` is below 128. The result goes through `result`, low half first, like
  /// [`multiply128`].
  ///
  /// # Gotchas
  /// `result` must address two writable, 8-byte aligned words.
  export "C" fn shiftRightSigned128(result: *mut u64, low: u64, high: u64, count: i32) -> () as "__ashrti3" {
    let bits = u64.bitAnd(i32.wrappingToU64(count), 127)
    let signed = u64.wrappingToI64(high)
    if bits == 0 {
      return writeWords(result, low, high)
    }
    if bits >= 64 {
      let shifted = i64.shiftRight(signed, u64.wrappingToI64(bits - 64))
      return writeWords(result, i64.wrappingToU64(shifted), i64.wrappingToU64(i64.shiftRight(signed, 63)))
    }
    return writeWords(
      result,
      u64.bitOr(u64.shiftRight(low, bits), u64.shiftLeft(high, 64 - bits)),
      i64.wrappingToU64(i64.shiftRight(signed, u64.wrappingToI64(bits)))
    )
  }

  fn writeWords(result: *mut u64, low: u64, high: u64) -> () {
    unsafe {
      Pointer.write<u64>(result, low)
      Pointer.write<u64>(Pointer.atMut<u64>(Pointer.assumeManyMut<u64>(result), 1), high)
    }
    return ()
  }

  /// The remainder of `x / y` with the sign of `x`, exactly, as C's `fmod`. WebAssembly has no
  /// remainder instruction, so LLVM calls this for an `f64` remainder.
  ///
  /// # Details
  /// It works on the bit patterns alone, since a floating remainder here would call it again. A
  /// zero or NaN `y`, or an infinite or NaN `x`, gives NaN.
  export "C" fn remainder64(x: f64, y: f64) -> f64 as "fmod" {
    let xBits = f64.toBits(x)
    let yBits = f64.toBits(y)
    let fraction: u64 = 4503599627370495
    let hidden: u64 = 4503599627370496
    let mut ex = u64.toI64(u64.bitAnd(u64.shiftRight(xBits, 52), 2047))
    let mut ey = u64.toI64(u64.bitAnd(u64.shiftRight(yBits, 52), 2047))
    let sign = u64.bitAnd(xBits, 9223372036854775808)
    if u64.shiftLeft(yBits, 1) == 0 || f64.isNaN(y) || ex == 2047 {
      return (x * y) / (x * y)
    }
    let magnitudeX = u64.shiftLeft(xBits, 1)
    let magnitudeY = u64.shiftLeft(yBits, 1)
    if magnitudeX <= magnitudeY {
      if magnitudeX == magnitudeY { return 0.0 * x }
      return x
    }
    // Normalize both significands so the hidden bit is bit 52.
    let mut ux = xBits
    if ex == 0 {
      let mut probe = u64.shiftLeft(ux, 12)
      while u64.shiftRight(probe, 63) == 0 {
        ex = ex - 1
        probe = u64.shiftLeft(probe, 1)
      }
      ux = u64.shiftLeft(ux, i64.toU64(1 - ex))
    } else {
      ux = u64.bitOr(u64.bitAnd(ux, fraction), hidden)
    }
    let mut uy = yBits
    if ey == 0 {
      let mut probe = u64.shiftLeft(uy, 12)
      while u64.shiftRight(probe, 63) == 0 {
        ey = ey - 1
        probe = u64.shiftLeft(probe, 1)
      }
      uy = u64.shiftLeft(uy, i64.toU64(1 - ey))
    } else {
      uy = u64.bitOr(u64.bitAnd(uy, fraction), hidden)
    }
    // Long division, one bit per exponent step.
    while ex > ey {
      let difference = u64.wrappingSubtract(ux, uy)
      if u64.shiftRight(difference, 63) == 0 {
        if difference == 0 { return 0.0 * x }
        ux = difference
      }
      ux = u64.shiftLeft(ux, 1)
      ex = ex - 1
    }
    let difference = u64.wrappingSubtract(ux, uy)
    if u64.shiftRight(difference, 63) == 0 {
      if difference == 0 { return 0.0 * x }
      ux = difference
    }
    while u64.shiftRight(ux, 52) == 0 {
      ux = u64.shiftLeft(ux, 1)
      ex = ex - 1
    }
    if ex > 0 {
      ux = u64.bitOr(ux - hidden, u64.shiftLeft(i64.toU64(ex), 52))
    } else {
      ux = u64.shiftRight(ux, i64.toU64(1 - ex))
    }
    return f64.fromBits(u64.bitOr(ux, sign))
  }

  /// The remainder of `x / y` with the sign of `x`, exactly, as C's `fmodf`. The `f64` remainder
  /// of the widened operands is exact and fits `f32`, so narrowing it loses nothing.
  export "C" fn remainder32(x: f32, y: f32) -> f32 as "fmodf" {
    return f64.toF32(unsafe remainder64(f32.toF64(x), f32.toF64(y)))
  }

  /// `x * y + z` rounded once, as C's `fma`. WebAssembly has no fused multiply-add instruction, so
  /// a fused lane operation calls this.
  export "C" fn fusedMultiplyAdd64(x: f64, y: f64, z: f64) -> f64 as "fma" {
    return f64.fma(x, y, z)
  }

  /// `x * y + z` rounded once, as C's `fmaf`.
  export "C" fn fusedMultiplyAdd32(x: f32, y: f32, z: f32) -> f32 as "fmaf" {
    return f32.fma(x, y, z)
  }
}
