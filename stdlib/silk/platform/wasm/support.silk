//! The C library of every wasm32 executable: the heap entry points, the byte routines and the
//! 128-bit multiply.
//!
//! # When to use
//! The standard library's catalog names this module as the wasm32 targets' support module, so
//! every wasm32 executable links its C exports, whatever its runtime. Sealed core storage and
//! LLVM's lowering call `malloc`, `free`, `memcpy`, `__multi3` and the rest, and WebAssembly has
//! no libc or compiler-rt to supply them. Applications do not call these functions.
//!
//! # Details
//! The heap functions forward to [`WasmHeap`]. LLVM expands its own copies and fills into
//! `memory.copy` and `memory.fill`, so the byte routines serve only calls by name: an unoptimized
//! build's sealed storage calls. [`memmove`] handles overlapping ranges, so it implements `memcpy`
//! too.
//!
//! # Gotchas
//! These C exports are link symbols only: unlike other C exports on WebAssembly, the module does
//! not export them to its host.
//!
//! @category Native platform

static if Intrinsic.targetArchitecture() == "wasm32" {
  import silk.mem.pointer { Pointer }
  import silk.num.i32
  import silk.num.u64
  import silk.platform.wasm.heap { WasmHeap }

  /// Returns uninitialized storage of at least `size` bytes, or null.
  ///
  /// # Gotchas
  /// Release a non-null result once with [`free`].
  export "C" fn malloc(size: usize) -> ?[*]mut u8 {
    return unsafe WasmHeap.allocate(size)
  }

  /// Returns `count * size` zero bytes, or null.
  ///
  /// # Gotchas
  /// Release a non-null result once with [`free`].
  export "C" fn calloc(count: usize, size: usize) -> ?[*]mut u8 {
    return unsafe WasmHeap.allocateZeroed(count, size)
  }

  /// Resizes storage from [`malloc`], or returns null and keeps it.
  ///
  /// # Gotchas
  /// `allocation` must be null or live storage of this heap.
  export "C" fn realloc(allocation: ?[*]mut u8, size: usize) -> ?[*]mut u8 {
    return unsafe WasmHeap.resize(allocation, size)
  }

  /// Releases storage from [`malloc`]. Null does nothing.
  ///
  /// # Gotchas
  /// `allocation` must be null or live storage of this heap, released once.
  export "C" fn free(allocation: ?[*]mut u8) -> () {
    unsafe WasmHeap.release(allocation)
    return ()
  }

  /// Copies `count` possibly overlapping bytes and returns `destination`.
  ///
  /// # Gotchas
  /// Both ranges must be live for `count` bytes.
  export "C" fn memmove(destination: ?[*]mut u8, source: ?[*]const u8, count: usize) -> ?[*]mut u8 {
    if count == 0 { return destination }
    unsafe {
      let output = Intrinsic.pointerRequalify<?[*]mut u8, [*]mut u8>(destination)
      let input = Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(source)
      // A destination above the source copies from the end, so each byte is read before any
      // overlapping write.
      if Pointer.addressMany<u8>(output) > Pointer.addressMany<u8>(input) {
        let mut at = count
        while at > 0 {
          at = at - 1
          Pointer.write<u8>(Pointer.atMut<u8>(output, at), Pointer.read<u8>(Pointer.at<u8>(input, at)))
        }
      } else {
        let mut at: usize = 0
        while at < count {
          Pointer.write<u8>(Pointer.atMut<u8>(output, at), Pointer.read<u8>(Pointer.at<u8>(input, at)))
          at = at + 1
        }
      }
    }
    return destination
  }

  /// Copies `count` bytes and returns `destination`, as [`memmove`] does.
  ///
  /// # Gotchas
  /// Both ranges must be live for `count` bytes.
  export "C" fn memcpy(destination: ?[*]mut u8, source: ?[*]const u8, count: usize) -> ?[*]mut u8 {
    return unsafe memmove(destination, source, count)
  }

  /// Sets `count` bytes to the low byte of `value` and returns `destination`.
  ///
  /// # Gotchas
  /// The range must be live and writable for `count` bytes.
  export "C" fn memset(destination: ?[*]mut u8, value: i32, count: usize) -> ?[*]mut u8 {
    if count == 0 { return destination }
    let byte = i32.toU8(i32.bitAnd(value, 255))
    unsafe {
      let output = Intrinsic.pointerRequalify<?[*]mut u8, [*]mut u8>(destination)
      let mut at: usize = 0
      while at < count {
        Pointer.write<u8>(Pointer.atMut<u8>(output, at), byte)
        at = at + 1
      }
    }
    return destination
  }

  /// Compares `count` unsigned bytes: zero when equal, otherwise the sign of the first difference.
  ///
  /// # Gotchas
  /// Both ranges must be live for `count` bytes.
  export "C" fn memcmp(left: ?[*]const u8, right: ?[*]const u8, count: usize) -> i32 {
    if count == 0 { return 0 }
    unsafe {
      let first = Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(left)
      let second = Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(right)
      let mut at: usize = 0
      while at < count {
        let a = Pointer.read<u8>(Pointer.at<u8>(first, at))
        let b = Pointer.read<u8>(Pointer.at<u8>(second, at))
        if a < b { return -1 }
        if a > b { return 1 }
        at = at + 1
      }
    }
    return 0
  }

  /// The low 128 bits of a 128-bit product, which LLVM calls for overflow-checked 64-bit products;
  /// wasm32 has no compiler-rt. WebAssembly passes each 128-bit operand as its two 64-bit halves,
  /// low first, and returns the result through `result`.
  ///
  /// # Gotchas
  /// `result` must address two writable, 8-byte aligned words.
  export "C" fn multiply128(result: *mut u64, leftLow: u64, leftHigh: u64, rightLow: u64, rightHigh: u64) -> () as "__multi3" {
    let mask: u64 = 4294967295
    let a0 = u64.bitAnd(leftLow, mask)
    let a1 = u64.shiftRight(leftLow, 32)
    let b0 = u64.bitAnd(rightLow, mask)
    let b1 = u64.shiftRight(rightLow, 32)
    // Checked 64-bit products would call this function again, so every step wraps modulo 2^64.
    let low = u64.wrappingMultiply(a0, b0)
    let middleA = u64.wrappingAdd(u64.wrappingMultiply(a1, b0), u64.shiftRight(low, 32))
    let middleB = u64.wrappingAdd(u64.wrappingMultiply(a0, b1), u64.bitAnd(middleA, mask))
    let mut high = u64.wrappingMultiply(a1, b1)
    high = u64.wrappingAdd(high, u64.shiftRight(middleA, 32))
    high = u64.wrappingAdd(high, u64.shiftRight(middleB, 32))
    high = u64.wrappingAdd(high, u64.wrappingMultiply(leftLow, rightHigh))
    high = u64.wrappingAdd(high, u64.wrappingMultiply(leftHigh, rightLow))
    unsafe {
      Pointer.write<u64>(result, u64.bitOr(u64.shiftLeft(middleB, 32), u64.bitAnd(low, mask)))
      Pointer.write<u64>(Pointer.atMut<u64>(Pointer.assumeManyMut<u64>(result), 1), high)
    }
    return ()
  }
}
