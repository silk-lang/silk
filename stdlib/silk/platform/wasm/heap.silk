//! The linear-memory heap of every wasm32 module, and the report buffer of a module without WASI.
//!
//! # When to use
//! The wasm32 entry modules export `malloc`, `free`, `calloc` and `realloc` from [`WasmHeap`], and
//! a module without host services exports its report through [`WasmHeap.report`]. Applications use
//! `Allocator.systemAllocatorProvider`.
//!
//! # Details
//! The heap starts at the linker's `__heap_base` and grows with `memory.grow`. Its first bytes hold
//! the heap's own state, which a fresh linear memory already holds as zeros: the top chunk, the
//! lock, the report's length, the bin map, the bins and the report buffer. Chunks follow.
//!
//! Each chunk is a 16-byte header and a payload aligned to 16. A header holds the size of the chunk
//! before it while that one is free, then the chunk's own size with two flags, so a release
//! coalesces a chunk with both neighbors. Free chunks wait in bins by size: one per 16 bytes below
//! 1 KiB, then four per power of two. The last chunk is the top, which grows the memory instead of
//! joining a bin. Positions are byte offsets from the heap's start; offset zero, inside the
//! state, is no chunk. With the `multi` threading profile one lock serializes the heap.
//!
//! @category Native platform

static if Intrinsic.targetArchitecture() == "wasm32" {
  import silk.concurrency.atomic { Atomic, CompareExchange, MemoryOrder }
  import silk.core.option { Option }
  import silk.mem.pointer { Pointer }
  import silk.num.u32
  import silk.num.usize

  // The first byte after the module's data and stack, which the linker defines.
  unsafe extern "C" static heapBase: u8 as "__heap_base"

  const pageSize: usize = 65536
  const inUse: usize = 1
  const previousInUse: usize = 2
  const flags: usize = 15
  const header: usize = 16
  const minimumChunk: usize = 32
  const smallBins: usize = 64
  const binCount: usize = 160
  const reportCapacity: usize = 8192

  // Offsets of the state from the heap's start.
  const topAt: usize = 0
  const lockAt: usize = 4
  const reportUsedAt: usize = 8
  const binMapAt: usize = 16
  const binsAt: usize = 48
  const reportAt: usize = 688
  const chunksAt: usize = 8880

  /// The wasm32 heap: `malloc`-style storage over linear memory.
  pub struct WasmHeap {}

  // The heap's start: `__heap_base` rounded up to 16 bytes.
  unsafe fn start() -> [*]mut u8 {
    unsafe {
      let first = Intrinsic.pointerRequalify<*const u8, *mut u8>(Pointer.fromRef<u8>(&heapBase))
      let address = Pointer.address<u8>(first)
      let skew = usize.remainder(16 - usize.remainder(address, 16), 16)
      return Pointer.assumeManyMut<u8>(Pointer.atMut<u8>(Pointer.assumeManyMut<u8>(first), skew))
    }
  }

  unsafe fn word(offset: usize) -> *mut usize {
    unsafe { return Intrinsic.pointerReinterpret<*mut u8, *mut usize>(Pointer.atMut<u8>(start(), offset)) }
  }

  unsafe fn readWord(offset: usize) -> usize {
    unsafe { return Pointer.read<usize>(word(offset)) }
  }

  unsafe fn writeWord(offset: usize, value: usize) -> () {
    unsafe { Pointer.write<usize>(word(offset), value) }
  }

  unsafe fn mapWord(index: usize) -> *mut u32 {
    unsafe { return Intrinsic.pointerReinterpret<*mut u8, *mut u32>(Pointer.atMut<u8>(start(), binMapAt + index * 4)) }
  }

  // A chunk's fields: the previous chunk's size at its first word, its own head at its second, and
  // while free, the next and previous free chunks of its bin at its third and fourth.
  unsafe fn previousSize(chunk: usize) -> usize { unsafe { return readWord(chunk) } }
  unsafe fn head(chunk: usize) -> usize { unsafe { return readWord(chunk + 4) } }
  unsafe fn setPreviousSize(chunk: usize, value: usize) -> () { unsafe { writeWord(chunk, value) } }
  unsafe fn setHead(chunk: usize, value: usize) -> () { unsafe { writeWord(chunk + 4, value) } }
  unsafe fn next(chunk: usize) -> usize { unsafe { return readWord(chunk + header) } }
  unsafe fn previous(chunk: usize) -> usize { unsafe { return readWord(chunk + header + 4) } }
  unsafe fn setNext(chunk: usize, value: usize) -> () { unsafe { writeWord(chunk + header, value) } }
  unsafe fn setPrevious(chunk: usize, value: usize) -> () { unsafe { writeWord(chunk + header + 4, value) } }

  unsafe fn chunkSize(chunk: usize) -> usize {
    unsafe { return usize.bitAnd(head(chunk), usize.bitNot(flags)) }
  }

  unsafe fn after(chunk: usize) -> usize {
    unsafe { return chunk + chunkSize(chunk) }
  }

  unsafe fn top() -> usize { unsafe { return readWord(topAt) } }
  unsafe fn setTop(chunk: usize) -> () { unsafe { writeWord(topAt, chunk) } }

  fn binOf(bytes: usize) -> usize {
    if bytes < 1024 { return usize.shiftRight(bytes, 4) }
    let power = u32.toUsize(31 - usize.leadingZeros(bytes))
    let quarter = usize.bitAnd(usize.shiftRight(bytes, power - 2), 3)
    let bin = smallBins + (power - 10) * 4 + quarter
    if bin < binCount { return bin }
    return binCount - 1
  }

  unsafe fn binHead(bin: usize) -> usize { unsafe { return readWord(binsAt + bin * 4) } }
  unsafe fn setBinHead(bin: usize, chunk: usize) -> () { unsafe { writeWord(binsAt + bin * 4, chunk) } }

  unsafe fn insert(chunk: usize) -> () {
    unsafe {
      let bin = binOf(chunkSize(chunk))
      let first = binHead(bin)
      setPrevious(chunk, 0)
      setNext(chunk, first)
      if first != 0 { setPrevious(first, chunk) }
      setBinHead(bin, chunk)
      let map = mapWord(usize.shiftRight(bin, 5))
      Pointer.write<u32>(map, u32.bitOr(Pointer.read<u32>(map), u32.shiftLeft(1, usize.toU32(usize.bitAnd(bin, 31)))))
    }
  }

  unsafe fn remove(chunk: usize) -> () {
    unsafe {
      let bin = binOf(chunkSize(chunk))
      let before = previous(chunk)
      let following = next(chunk)
      if before != 0 { setNext(before, following) } else { setBinHead(bin, following) }
      if following != 0 { setPrevious(following, before) }
      if binHead(bin) == 0 {
        let map = mapWord(usize.shiftRight(bin, 5))
        Pointer.write<u32>(map, u32.bitAnd(Pointer.read<u32>(map), u32.bitNot(u32.shiftLeft(1, usize.toU32(usize.bitAnd(bin, 31))))))
      }
    }
  }

  // A free chunk of at least `bytes` bytes, taken out of its bin, or zero. A bin holds sizes from
  // its own lower bound up, so only the first bin needs a size check.
  unsafe fn take(bytes: usize) -> usize {
    unsafe {
      let mut bin = binOf(bytes)
      let mut chunk = binHead(bin)
      while chunk != 0 {
        if chunkSize(chunk) >= bytes {
          remove(chunk)
          return chunk
        }
        chunk = next(chunk)
      }
      bin = bin + 1
      while bin < binCount {
        let mask = u32.shiftLeft(u32.MAX, usize.toU32(usize.bitAnd(bin, 31)))
        let found = u32.bitAnd(Pointer.read<u32>(mapWord(usize.shiftRight(bin, 5))), mask)
        if found != 0 {
          let selected = binHead(usize.bitAnd(bin, usize.bitNot(31)) + u32.toUsize(u32.trailingZeros(found)))
          remove(selected)
          return selected
        }
        bin = usize.bitAnd(bin, usize.bitNot(31)) + 32
      }
      return 0
    }
  }

  // The bytes between the heap's start and the end of the linear memory.
  unsafe fn reach() -> usize {
    unsafe { return Intrinsic.wasmMemorySize() * pageSize - Pointer.addressMany<u8>(start()) }
  }

  // Places the top chunk after the state the first time the heap is used.
  unsafe fn begin() -> bool {
    unsafe {
      if top() != 0 { return true }
      let mut end = reach()
      if end < chunksAt + minimumChunk {
        let missing = chunksAt + minimumChunk - end
        if Intrinsic.wasmMemoryGrow((missing + pageSize - 1) / pageSize) == usize.MAX { return false }
        end = reach()
      }
      setTop(chunksAt)
      setPreviousSize(chunksAt, 0)
      setHead(chunksAt, usize.bitOr(usize.bitAnd(end - chunksAt, usize.bitNot(flags)), previousInUse))
      return true
    }
  }

  // Grows the memory until the top chunk holds at least `bytes` bytes.
  unsafe fn grow(bytes: usize) -> bool {
    unsafe {
      let have = chunkSize(top())
      if have >= bytes { return true }
      let pages = (bytes - have + pageSize - 1) / pageSize
      if pages > (usize.MAX - have) / pageSize { return false }
      if Intrinsic.wasmMemoryGrow(pages) == usize.MAX { return false }
      setHead(top(), head(top()) + pages * pageSize)
      return true
    }
  }

  // Gives the chunk `bytes` bytes and returns the rest to a bin when it is large enough to stand
  // alone.
  unsafe fn split(chunk: usize, bytes: usize) -> () {
    unsafe {
      let whole = chunkSize(chunk)
      if whole - bytes >= minimumChunk {
        setHead(chunk, usize.bitOr(usize.bitOr(bytes, inUse), usize.bitAnd(head(chunk), previousInUse)))
        let rest = after(chunk)
        setHead(rest, usize.bitOr(whole - bytes, previousInUse))
        setPreviousSize(after(rest), whole - bytes)
        setHead(after(rest), usize.bitAnd(head(after(rest)), usize.bitNot(previousInUse)))
        insert(rest)
      } else {
        setHead(chunk, usize.bitOr(head(chunk), inUse))
        setHead(after(chunk), usize.bitOr(head(after(chunk)), previousInUse))
      }
    }
  }

  unsafe fn lockWord() -> *mut u32 {
    unsafe { return Intrinsic.pointerReinterpret<*mut u8, *mut u32>(Pointer.atMut<u8>(start(), lockAt)) }
  }

  // Takes the heap lock in the `multi` threading profile. 2 marks a lock someone waits for, so the
  // holder knows to wake a waiter.
  unsafe fn lock() -> () {
    static if Intrinsic.profileText("threading") == "multi" {
      unsafe {
        let word = lockWord()
        if let CompareExchange<u32>.Observed {value} = Atomic.compareExchange<u32>(word, 0, 1, MemoryOrder.Acquire, MemoryOrder.Relaxed) {
          let mut seen = value
          if seen != 2 { seen = Atomic.swap<u32>(word, 2, MemoryOrder.Acquire) }
          while seen != 0 {
            let _woken = Atomic.wait(Intrinsic.pointerRequalify<*mut u32, *const u32>(word), 2, Option<u64>.none())
            seen = Atomic.swap<u32>(word, 2, MemoryOrder.Acquire)
          }
        }
      }
    }
    return ()
  }

  unsafe fn unlock() -> () {
    static if Intrinsic.profileText("threading") == "multi" {
      unsafe {
        let word = lockWord()
        if Atomic.swap<u32>(word, 0, MemoryOrder.Release) == 2 {
          Atomic.notifyOne(Intrinsic.pointerRequalify<*mut u32, *const u32>(word))
        }
      }
    }
    return ()
  }

  fn nothing() -> ?[*]mut u8 {
    return unsafe Intrinsic.pointerRequalify<?*mut u8, ?[*]mut u8>(Pointer.null<u8>())
  }

  unsafe fn payload(chunk: usize) -> ?[*]mut u8 {
    unsafe { return Pointer.assumeManyMut<u8>(Pointer.atMut<u8>(start(), chunk + header)) }
  }

  unsafe fn chunkOf(allocation: [*]mut u8) -> usize {
    unsafe { return Pointer.addressMany<u8>(allocation) - Pointer.addressMany<u8>(start()) - header }
  }

  impl WasmHeap {
    /// Returns uninitialized storage of at least `size` bytes aligned to 16, or null when the
    /// memory cannot grow.
    ///
    /// # Safety
    /// Release a non-null result once with [`WasmHeap.release`] after every access ends.
    pub unsafe fn allocate(size: usize) -> ?[*]mut u8 {
      if size > usize.MAX - header - flags { return nothing() }
      let mut needed = usize.bitAnd(size + header + flags, usize.bitNot(flags))
      if needed < minimumChunk { needed = minimumChunk }
      unsafe {
        lock()
        if !begin() {
          unlock()
          return nothing()
        }
        let mut chunk = take(needed)
        if chunk == 0 {
          // The top keeps room for its own header after the carve.
          if needed > usize.MAX - minimumChunk || !grow(needed + minimumChunk) {
            unlock()
            return nothing()
          }
          chunk = top()
          let whole = chunkSize(chunk)
          setHead(chunk, usize.bitOr(usize.bitOr(needed, inUse), usize.bitAnd(head(chunk), previousInUse)))
          setTop(after(chunk))
          setHead(top(), usize.bitOr(whole - needed, previousInUse))
        } else {
          split(chunk, needed)
        }
        unlock()
        return payload(chunk)
      }
    }

    /// Returns storage of `count * size` zero bytes, or null when the product overflows or the
    /// memory cannot grow.
    ///
    /// # Safety
    /// Release a non-null result once with [`WasmHeap.release`] after every access ends.
    pub unsafe fn allocateZeroed(count: usize, size: usize) -> ?[*]mut u8 {
      if count != 0 && size > usize.MAX / count { return nothing() }
      let bytes = count * size
      let allocation = unsafe WasmHeap.allocate(bytes)
      if let Option<[*]mut u8>.Some {value} = Pointer.nonNullManyMut<u8>(allocation) {
        let mut at: usize = 0
        while at < bytes {
          unsafe { Pointer.write<u8>(Pointer.atMut<u8>(value, at), 0) }
          at = at + 1
        }
      }
      return allocation
    }

    /// Releases storage from [`WasmHeap.allocate`]. Null does nothing.
    ///
    /// # Safety
    /// `allocation` must be null or a live result of this heap, released once, after every access.
    pub unsafe fn release(allocation: ?[*]mut u8) -> () {
      let owned = match Pointer.nonNullManyMut<u8>(allocation) {
        Option<[*]mut u8>.Some {value} => value
        Option<[*]mut u8>.None => { return () }
      }
      unsafe {
        lock()
        let mut chunk = chunkOf(owned)
        let mut bytes = chunkSize(chunk)
        if usize.bitAnd(head(chunk), previousInUse) == 0 {
          let before = chunk - previousSize(chunk)
          remove(before)
          bytes = bytes + chunkSize(before)
          chunk = before
        }
        let following = chunk + bytes
        if following == top() {
          // Coalescing into the top returns the chunk to the region allocation carves from.
          setHead(chunk, usize.bitOr(bytes + chunkSize(following), usize.bitAnd(head(chunk), previousInUse)))
          setTop(chunk)
          unlock()
          return ()
        }
        if usize.bitAnd(head(following), inUse) == 0 {
          remove(following)
          bytes = bytes + chunkSize(following)
        }
        setHead(chunk, usize.bitOr(bytes, usize.bitAnd(head(chunk), previousInUse)))
        let successor = after(chunk)
        setPreviousSize(successor, bytes)
        setHead(successor, usize.bitAnd(head(successor), usize.bitNot(previousInUse)))
        insert(chunk)
        unlock()
      }
      return ()
    }

    /// Keeps an allocation that already holds `size` bytes; otherwise moves its bytes to a new
    /// one and releases the old. Returns null, keeping the old allocation, when the memory cannot
    /// grow. A null `allocation` allocates.
    ///
    /// # Safety
    /// `allocation` must be null or a live result of this heap. After a non-null result, only that
    /// result may be used.
    pub unsafe fn resize(allocation: ?[*]mut u8, size: usize) -> ?[*]mut u8 {
      let owned = match Pointer.nonNullManyMut<u8>(allocation) {
        Option<[*]mut u8>.Some {value} => value
        Option<[*]mut u8>.None => { return unsafe WasmHeap.allocate(size) }
      }
      let mut have: usize = 0
      unsafe { have = chunkSize(chunkOf(owned)) - header }
      if size <= have { return allocation }
      let moved = unsafe WasmHeap.allocate(size)
      if let Option<[*]mut u8>.Some {value: target} = Pointer.nonNullManyMut<u8>(moved) {
        let mut at: usize = 0
        while at < have {
          unsafe { Pointer.write<u8>(Pointer.atMut<u8>(target, at), Pointer.read<u8>(Pointer.atMut<u8>(owned, at))) }
          at = at + 1
        }
        unsafe WasmHeap.release(allocation)
      }
      return moved
    }

    /// Appends what fits of `bytes` to the report buffer, and answers whether all of it did.
    /// Threads that report at once each reserve their own bytes.
    ///
    /// # Safety
    /// `bytes` must address `length` readable bytes.
    pub unsafe fn reportWrite(bytes: ?[*]const u8, length: usize) -> bool {
      unsafe {
        let used = word(reportUsedAt)
        let mut begin = Atomic.load<usize>(Intrinsic.pointerRequalify<*mut usize, *const usize>(used), MemoryOrder.Relaxed)
        let mut count: usize = 0
        while true {
          let room = reportCapacity - begin
          count = length
          if room < count { count = room }
          match Atomic.compareExchange<usize>(used, begin, begin + count, MemoryOrder.Relaxed, MemoryOrder.Relaxed) {
            CompareExchange<usize>.Exchanged => { break }
            CompareExchange<usize>.Observed {value} => { begin = value }
          }
        }
        if let Option<[*]const u8>.Some {value: source} = Pointer.nonNullMany<u8>(bytes) {
          let mut at: usize = 0
          while at < count {
            Pointer.write<u8>(Pointer.atMut<u8>(start(), reportAt + begin + at), Pointer.read<u8>(Pointer.at<u8>(source, at)))
            at = at + 1
          }
        }
        return count == length
      }
    }

    /// A non-null address aligned to 16 that holds no storage, for empty allocations that are
    /// never read or released.
    pub fn empty() -> ?[*]mut u8 {
      unsafe { return start() }
    }

    /// The address of the report buffer, which the host reads after a trap.
    pub fn report() -> ?[*]const u8 {
      unsafe { return Pointer.assumeMany<u8>(Intrinsic.pointerRequalify<*mut u8, *const u8>(Pointer.atMut<u8>(start(), reportAt))) }
    }

    /// The number of bytes written to the report buffer.
    pub fn reportLength() -> usize {
      unsafe { return readWord(reportUsedAt) }
    }
  }
}
