//! Random bytes, clocks, and the time zone setting from a JavaScript host, for the providers of
//! `Random`, `SystemClock`, `MonotonicClock`, and `LocalZone` on `wasm32-unknown-unknown`.
//!
//! # When to use
//! Application code does not call it. `OsRandom`, `OsSystemClock`, `OsMonotonicClock`, and
//! `OsLocalZone` use it when the program runs in a browser, Node.js, Deno or another JavaScript host, so the same
//! provider works on every target.
//!
//! # Details
//! The module imports three host functions from the import module `silk`, and a program imports
//! only the ones it reads:
//!
//! | Import | Does |
//! |---|---|
//! | `random(address, length)` | Fills `length` bytes at `address` with secure random bytes, as `crypto.getRandomValues` does |
//! | `clock(monotonic)` | Returns milliseconds as an `f64`: since 1970 when `monotonic` is 0, since a fixed start (`performance.now()`) when it is 1 |
//! | `time-zone(address, capacity)` | Writes the IANA name of the zone of the host, as `Intl.DateTimeFormat().resolvedOptions().timeZone` gives it, at `address`, and returns its length in bytes, or 0 if the host has no name or it is longer than `capacity` |
//!
//! The standard library's runner, `host/wasm-runner.mjs`, supplies all three. The `mount` of
//! `ui-app-dom` supplies `random` and `clock`.
//!
//! # Gotchas
//! - A host that instantiates the module itself supplies the imports the module names, or the
//!   instantiation fails.
//! - A JavaScript host cannot block, so a wait reads the monotonic clock until the deadline. It
//!   holds the thread, and in a browser page it holds the page.
//! - A browser rounds `performance.now()`, often to 5 or 100 microseconds.
//!
//! @category Native platform

static if Intrinsic.targetObjectFormat() == "wasm" && Intrinsic.targetOperatingSystem() != "wasi" {
  import silk.mem.pointer { Pointer }
  import silk.num.f64
  import silk.num.i64
  import silk.time.instant { Instant }
  import silk.time.mark { Mark }

  // Fills `length` bytes at `bytes` with secure random bytes.
  @foreign(noCapture: .("bytes"))
  unsafe extern "C" fn silk_wasm_random(bytes: ?[*]mut u8, length: usize) -> () as "silk#random"

  // Milliseconds of the wall clock (0) or the monotonic clock (1).
  unsafe extern "C" fn silk_wasm_clock(monotonic: i32) -> f64 as "silk#clock"

  // Writes the name of the zone of the host at `bytes` and returns its length, or 0.
  @foreign(noCapture: .("bytes"))
  unsafe extern "C" fn silk_wasm_time_zone(bytes: ?[*]mut u8, capacity: usize) -> usize as "silk#time-zone"

  /// The random bytes and clocks of a JavaScript host. A bad answer of the host is a trap.
  pub struct JsHost {}

  impl JsHost {
    /// Fills `output` with secure random bytes from the host. An empty slice does not call the
    /// host.
    pub fn fillRandom(output: &mut [u8]) -> () {
      let length = output.length
      if length == 0 { return () }
      unsafe silk_wasm_random(Pointer.fromMutSlice<u8>(move output), length)
      return ()
    }

    /// Returns the reading of the monotonic clock of the host.
    pub fn now() -> Mark {
      let milliseconds = unsafe silk_wasm_clock(1)
      if !f64.isFinite(milliseconds) || milliseconds < 0.0 {
        Intrinsic.trap("JsHost.now: the host clock returned an invalid time")
      }
      let seconds = f64.floor(milliseconds / 1000.0)
      return Mark.make(f64.toI64(seconds), subsecond(milliseconds, seconds))
    }

    /// Returns the date and time of the wall clock of the host.
    pub fn systemNow() -> Instant {
      let milliseconds = unsafe silk_wasm_clock(0)
      if !f64.isFinite(milliseconds) {
        Intrinsic.trap("JsHost.systemNow: the host clock returned an invalid time")
      }
      let seconds = f64.floor(milliseconds / 1000.0)
      return Instant.make(f64.toI64(seconds), subsecond(milliseconds, seconds))
    }

    /// Returns the resolution of the selected clock, in nanoseconds: one millisecond for the
    /// wall clock and one microsecond for the monotonic clock, the finest a host promises.
    pub fn resolution(monotonic: bool) -> u64 {
      if monotonic { return 1000 }
      return 1000000
    }

    /// Writes the IANA name of the time zone of the host, such as `America/Sao_Paulo`, at the
    /// start of `output`, and returns its length. Returns 0 if the host gives no name or the
    /// name does not fit in `output`.
    pub fn timeZone(output: &mut [u8]) -> usize {
      let capacity = output.length
      if capacity == 0 { return 0 }
      let length = unsafe silk_wasm_time_zone(Pointer.fromMutSlice<u8>(move output), capacity)
      if length > capacity { return 0 }
      return length
    }

    /// Reads the monotonic clock until it reaches `when`. It holds the thread while it waits.
    pub fn waitUntil(when: Mark) -> () {
      if when.seconds() < 0 { Intrinsic.trap("JsHost.waitUntil: the deadline is negative") }
      while true {
        let now = JsHost.now()
        if &now >= &when {
          return ()
        }
      }
      return ()
    }
  }

  // The nanoseconds of `milliseconds` after its whole `seconds`. Rounding can give a full second,
  // which `make` carries.
  fn subsecond(milliseconds: f64, seconds: f64) -> i64 {
    return f64.toI64(f64.round((milliseconds - seconds * 1000.0) * 1000000.0))
  }
}
