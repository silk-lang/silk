//! Random bytes and clocks from a JavaScript host, for the providers of `Random`, `SystemClock`
//! and `MonotonicClock` on `wasm32-unknown-unknown`.
//!
//! # When to use
//! Application code does not call it. `OsRandom`, `OsSystemClock` and `OsMonotonicClock` use it
//! when the program runs in a browser, Node.js, Deno or another JavaScript host, so the same
//! provider works on every target.
//!
//! # Details
//! The module imports two host functions from the import module `silk`, and only a program that
//! reads random bytes or a clock imports them:
//!
//! | Import | Does |
//! |---|---|
//! | `random(address, length)` | Fills `length` bytes at `address` with secure random bytes, as `crypto.getRandomValues` does |
//! | `clock(monotonic)` | Returns milliseconds as an `f64`: since 1970 when `monotonic` is 0, since a fixed start (`performance.now()`) when it is 1 |
//!
//! The standard library's runner, `host/wasm-runner.mjs`, supplies both, and so does the
//! `mount` of `ui-app-dom`.
//!
//! # Gotchas
//! - A host that instantiates the module itself supplies the imports the module names, or the
//!   instantiation fails.
//! - A JavaScript host cannot block, so a wait reads the monotonic clock until the deadline. It
//!   holds the thread, and in a browser page it holds the page.
//! - A browser rounds `performance.now()`, often to 5 or 100 microseconds.
//!
//! @category Native platform

static if Intrinsic.targetObjectFormat() == "wasm" && Intrinsic.targetOperatingSystem() != "wasi" {
  import silk.mem.pointer { Pointer }
  import silk.num.f64
  import silk.num.i64
  import silk.system.system_clock { Instant, SystemClock }

  // Fills `length` bytes at `bytes` with secure random bytes.
  @foreign(noCapture: .("bytes"))
  unsafe extern "C" fn silk_wasm_random(bytes: ?[*]mut u8, length: usize) -> () as "silk#random"

  // Milliseconds of the wall clock (0) or the monotonic clock (1).
  unsafe extern "C" fn silk_wasm_clock(monotonic: i32) -> f64 as "silk#clock"

  /// The random bytes and clocks of a JavaScript host. A bad answer of the host is a trap.
  pub struct JsHost {}

  impl JsHost {
    /// Fills `output` with secure random bytes from the host. An empty slice does not call the
    /// host.
    pub fn fillRandom(output: &mut [u8]) -> () {
      let length = output.length
      if length == 0 { return () }
      unsafe silk_wasm_random(Pointer.fromMutSlice<u8>(move output), length)
      return ()
    }

    /// Returns the time of the monotonic clock if `monotonic` is true, or of the wall clock, as
    /// seconds since 1970, if it is false.
    pub fn now(monotonic: bool) -> Instant {
      let mut which: i32 = 0
      if monotonic { which = 1 }
      let milliseconds = unsafe silk_wasm_clock(which)
      if !f64.isFinite(milliseconds) || (monotonic && milliseconds < 0.0) {
        Intrinsic.trap("JsHost.now: the host clock returned an invalid time")
      }
      let seconds = f64.floor(milliseconds / 1000.0)
      let mut nanoseconds = f64.toI64(f64.round((milliseconds - seconds * 1000.0) * 1000000.0))
      let mut whole = f64.toI64(seconds)
      if nanoseconds >= 1000000000 {
        whole = whole + 1
        nanoseconds = nanoseconds - 1000000000
      }
      return SystemClock.make(whole, nanoseconds)
    }

    /// Returns the resolution of the selected clock, in nanoseconds: one millisecond for the
    /// wall clock and one microsecond for the monotonic clock, the finest a host promises.
    pub fn resolution(monotonic: bool) -> u64 {
      if monotonic { return 1000 }
      return 1000000
    }

    /// Reads the monotonic clock until it reaches `when`. It holds the thread while it waits.
    pub fn waitUntil(when: Instant) -> () {
      let seconds = SystemClock.seconds(&when)
      let nanoseconds = SystemClock.nanoseconds(&when)
      if seconds < 0 { Intrinsic.trap("JsHost.waitUntil: the deadline is negative") }
      while true {
        let now = JsHost.now(true)
        let nowSeconds = SystemClock.seconds(&now)
        if nowSeconds > seconds || (nowSeconds == seconds && SystemClock.nanoseconds(&now) >= nanoseconds) {
          return ()
        }
      }
      return ()
    }
  }
}
