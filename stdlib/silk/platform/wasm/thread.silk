//! The wasi-threads records of a multi-threaded wasm32 module.
//!
//! # When to use
//! `NativeThread` starts and joins wasm32 threads through [`WasmThread`]. Applications use
//! `silk.concurrency.thread_native`.
//!
//! # Details
//! Each thread owns a record and a 1 MiB stack from the module's heap. The host starts the thread
//! as a new instance on the shared memory and calls the module's `wasi_thread_start`, which the
//! compiler defines: it moves the shadow stack to the record's stack top, calls the entry module's
//! thread entry, then marks the record done and wakes the joiner. The joiner releases the stack and
//! the record only after it sees the record done, which the thread sets after its last stack use.
//!
//! @category Native platform

static if Intrinsic.targetArchitecture() == "wasm32" {
  import silk.concurrency.atomic { Atomic, MemoryOrder }
  import silk.core.option { Option }
  import silk.mem.pointer { Pointer }
  import silk.core.ownership { Copy }
  import silk.core.result { Result }
  import silk.platform.wasm.heap { WasmHeap }

  // wasi-threads `thread-spawn`: starts `wasi_thread_start(thread, record)` on a new instance and
  // answers the thread's id, or a negated error number.
  unsafe extern "C" fn spawnHost(record: ?[*]mut u8) -> i32 as "wasi#thread-spawn"

  // The stack each thread gets, the size of the main thread's stack.
  const stackBytes: usize = 1048576
  // The offset of `ThreadRecord.done`: two 4-byte words.
  const doneAt: usize = 8

  // `wasi_thread_start` reads `stackTop` first, so it must stay the first field.
  extern "C" struct ThreadRecord {
    stackTop: usize,
    argument: ?*mut u8,
    done: u32,
    stack: ?[*]mut u8,
  }
  impl Copy for ThreadRecord {}

  /// The wasi-threads records that `NativeThread` starts and joins.
  pub struct WasmThread {}

  // The record behind a handle from `WasmThread.spawn`.
  unsafe fn record(handle: ?[*]mut u8) -> *mut ThreadRecord {
    let typed = unsafe Intrinsic.pointerReinterpret<?[*]mut u8, ?[*]mut ThreadRecord>(handle)
    return match Pointer.nonNullManyMut<ThreadRecord>(typed) {
      Option<[*]mut ThreadRecord>.Some {value} => unsafe Pointer.atMut<ThreadRecord>(value, 0)
      Option<[*]mut ThreadRecord>.None => Intrinsic.trap("WasmThread: a null thread record")
    }
  }

  impl WasmThread {
    /// Starts a thread that runs the entry module's thread entry with `argument`. It returns the
    /// thread's handle, or an error number when the host refuses the thread or the heap is full
    /// (12, `ENOMEM`).
    ///
    /// # Safety
    /// Join each started handle once with [`WasmThread.join`].
    pub unsafe fn spawn(argument: ?*mut u8) -> Result<?[*]mut u8, i32> {
      let stack = unsafe WasmHeap.allocate(stackBytes)
      let storage = unsafe WasmHeap.allocate(16)
      let base = match Pointer.nonNullManyMut<u8>(stack) {
        Option<[*]mut u8>.Some {value} => value
        Option<[*]mut u8>.None => {
          unsafe WasmHeap.release(storage)
          return Result<?[*]mut u8, i32>.Failure {error: 12}
        }
      }
      let handle = storage
      if let Option<[*]mut u8>.None = Pointer.nonNullManyMut<u8>(handle) {
        unsafe WasmHeap.release(stack)
        return Result<?[*]mut u8, i32>.Failure {error: 12}
      }
      // The heap aligns the stack to 16, so its end is aligned too.
      let top = Pointer.addressMany<u8>(base) + stackBytes
      unsafe Pointer.write<ThreadRecord>(unsafe record(handle), ThreadRecord {stackTop: top, argument: argument, done: 0, stack: stack})
      let thread = unsafe spawnHost(handle)
      if thread < 0 {
        unsafe WasmHeap.release(stack)
        unsafe WasmHeap.release(storage)
        return Result<?[*]mut u8, i32>.Failure {error: 0 - thread}
      }
      return Result<?[*]mut u8, i32>.Success {value: handle}
    }

    /// Returns the argument the thread behind `handle` was started with.
    ///
    /// # Safety
    /// `handle` is a live handle from [`WasmThread.spawn`].
    pub unsafe fn argument(handle: ?[*]mut u8) -> ?*mut u8 {
      let read = unsafe Pointer.read<ThreadRecord>(unsafe record(handle))
      return read.argument
    }

    /// Returns the word that `wasi_thread_start` sets to 1 once the thread's work is over.
    ///
    /// # Safety
    /// `handle` is a live handle from [`WasmThread.spawn`].
    pub unsafe fn done(handle: ?[*]mut u8) -> *mut u32 {
      unsafe {
        let base = Intrinsic.pointerReinterpret<*mut ThreadRecord, *mut u8>(record(handle))
        return Intrinsic.pointerReinterpret<*mut u8, *mut u32>(Pointer.atMut<u8>(Pointer.assumeManyMut<u8>(base), doneAt))
      }
    }

    /// Waits for the thread behind `handle` to finish, then releases its stack and record.
    ///
    /// # Safety
    /// `handle` is a live handle from [`WasmThread.spawn`], joined only once.
    pub unsafe fn join(handle: ?[*]mut u8) -> () {
      unsafe {
        let done = WasmThread.done(handle)
        let watched = Intrinsic.pointerRequalify<*mut u32, *const u32>(done)
        while Atomic.load<u32>(watched, MemoryOrder.Acquire) == 0 {
          let _woken = Atomic.wait(watched, 0, Option<u64>.none())
        }
        WasmHeap.release(Pointer.read<ThreadRecord>(record(handle)).stack)
        WasmHeap.release(handle)
      }
    }
  }
}
