//! Exact conversions between Windows clock units and Silk instants.
//!
//! # When to use
//! Windows providers use [`WindowsTime`] to convert FILETIME values, performance-counter ticks,
//! and blocking-wait durations. The conversions make no host calls and work on every target.
//!
//! @category Windows platform

import silk.system.system_clock { Instant, SystemClock }
import silk.num.i64
import silk.num.u64

/// Windows timestamp and timeout conversions without allocation or host calls.
///
/// # Details
///
/// FILETIME is unsigned 100-nanosecond intervals since 1601. Performance-counter values have a
/// nonnegative provider-local origin and a positive frequency. Invalid counter values trap.
pub struct WindowsTime {}

impl WindowsTime {
  /// Converts unsigned 100-nanosecond intervals since 1601 to Unix time.
  ///
  /// # Details
  ///
  /// Every `u64` input is representable. Division precedes epoch subtraction and multiplication,
  /// preserving dates before 1970 and avoiding overflow from a total nanosecond timestamp.
  pub fn fileTime(intervals: u64) -> Instant {
    return SystemClock.make(u64.toI64(intervals / 10000000) - 11644473600,
      u64.toI64(intervals % 10000000) * 100)
  }

  /// Converts nonnegative performance-counter ticks at `frequency` ticks per second to an instant.
  ///
  /// # Details
  ///
  /// Fractional nanoseconds round down. Seconds and the fraction are converted separately, so
  /// the total need not fit a nanosecond counter. Negative ticks or nonpositive frequency trap.
  pub fn counter(ticks: i64, frequency: i64) -> Instant {
    if ticks < 0 || frequency <= 0 { Intrinsic.trap("WindowsTime.counter: invalid counter or frequency") }
    let rate = i64.toU64(frequency)
    let value = i64.toU64(ticks)
    return SystemClock.make(u64.toI64(value / rate), u64.toI64(fraction(value % rate, rate)))
  }

  /// Returns one performance-counter tick in whole nanoseconds, rounded up to at least one.
  /// Nonpositive frequency traps. This is nominal resolution, not measured accuracy.
  pub fn counterResolution(frequency: i64) -> u64 {
    if frequency <= 0 { Intrinsic.trap("WindowsTime.counterResolution: invalid frequency") }
    let rate = i64.toU64(frequency)
    return 1 + 999999999 / rate
  }

  /// Converts a canonical nonnegative duration to a finite Windows sleep timeout in milliseconds.
  ///
  /// # Details
  ///
  /// Rounds up and saturates at 4,294,967,294, below Windows' infinite-wait sentinel. Callers
  /// recheck their original deadline after each sleep. Negative seconds or nanoseconds outside
  /// 0 through 999,999,999 trap.
  pub fn sleepMilliseconds(seconds: i64, nanoseconds: i64) -> u32 {
    if seconds < 0 || nanoseconds < 0 || nanoseconds >= 1000000000 {
      Intrinsic.trap("WindowsTime.sleepMilliseconds: invalid duration")
    }
    if seconds > 4294967 { return 4294967294 }
    let total = i64.toU64(seconds) * 1000 + i64.toU64((nanoseconds + 999999) / 1000000)
    if total > 4294967294 { return 4294967294 }
    return u64.toU32(total)
  }
}

fn fraction(remainder: u64, frequency: u64) -> u64 {
  if remainder <= u64.MAX / 1000000000 { return remainder * 1000000000 / frequency }
  // Binary multiply/divide keeps the residual below frequency. Since frequency <= i64.MAX,
  // doubling the residual fits u64. Reduce before adding another remainder. No u128 division
  // or compiler-runtime helper is needed, even for the largest signed QPF result.
  let multiplier: u64 = 1000000000
  let mut bit: u64 = 536870912
  let mut quotient: u64 = 0
  let mut residual: u64 = 0
  while bit != 0 {
    quotient = quotient * 2
    residual = residual * 2
    if residual >= frequency { residual = residual - frequency
      quotient = quotient + 1 }
    if (multiplier / bit) % 2 != 0 {
      if residual >= frequency - remainder {
        residual = residual - (frequency - remainder)
        quotient = quotient + 1
      } else { residual = residual + remainder }
    }
    bit = bit / 2
  }
  return quotient
}
