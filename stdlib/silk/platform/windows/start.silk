//! Synchronous Windows executable entry without a C runtime.
//!
//! # When to use
//! The Windows hosted composition selects this module. It exports `mainCRTStartup`, captures
//! raw host inputs, invokes the application, and ends the process with `ExitProcess`.
//!
//! # Details
//! `main` returns `i32`, `()`, or an effect of either result, optionally requiring `HostInput`.
//! Other requirements must be supplied by the application. Errors must implement `Debug`.
//! Unhandled errors use the shared bounded native report and exit with status 1.
//!
//! # Gotchas
//! This entry does not support parking or install Windows exception handlers. Traps do not unwind.
//!
//! @category Windows platform

static if Intrinsic.targetOperatingSystem() == "windows" && Intrinsic.targetArchitecture() == "x86_64" && Intrinsic.targetAbi() == "msvc" && Intrinsic.profileText("libc") == "system" {
  import Intrinsic.application
  import silk.core.effect { Effect }
  import silk.mem.allocator { Allocator, OutOfMemoryError }
  import silk.system.host_input { HostInput, HostInputError }
  import silk.platform.windows.host_input { WindowsHostInput }
  import silk.platform.native.diagnostics { NativeDiagnostics }
  import silk.platform.native.report { ErrorForm, NativeReport }
  import silk.text.format { Debug }
  import silk.num.usize
  import silk.num.i32

  unsafe extern "C" fn ExitProcess(status: u32) -> ()

  struct Application<T> {}
  interface EntryResult<T> {
    fn code(value: T, inputs: &mut WindowsHostInput) -> i32
  }
  impl EntryResult<i32> for Application<i32> {
    fn code(value: i32, inputs: &mut WindowsHostInput) -> i32 {
      return value
    }
  }
  impl EntryResult<()> for Application<()> {
    fn code(value: (), inputs: &mut WindowsHostInput) -> i32 {
      return 0
    }
  }
  // Reports an unhandled error, then writes the line `unhandled value: ` with its `Debug` form.
  effect<'env> fn failed<E: Debug + 'env, 'env>(error: E) -> i32 {
    let value = run ErrorForm.capture<E>(&error)
    // The observer requires the error to be dropped before it reports it.
    drop error
    let status = usize.toI32(Intrinsic.observeUnhandled())
    let _written = run ErrorForm.write(&value, 2)
    return status
  }
  effect fn succeeded(value: ()) -> i32 {
    return 0
  }
  effect fn succeededStatus(value: i32) -> i32 {
    return value
  }
  impl<'env, E: Debug> EntryResult<Effect<'env; () ! E>> for Application<Effect<'env; () ! E>> {
    fn code(value: Effect<'env; () ! E>, inputs: &mut WindowsHostInput) -> i32 {
      let computation = Effect.flatMap(move value, succeeded)
      return run Effect.catchAll(move computation, failed)
    }
  }
  impl<'env, E: Debug> EntryResult<Effect<'env; () ! E ? &mut HostInput>> for Application<
    Effect<'env; () ! E ? &mut HostInput>,
  > {
    fn code(value: Effect<'env; () ! E ? &mut HostInput>, inputs: &mut WindowsHostInput) -> i32 {
      let supplied = Effect.provideMut<HostInput>(move value, move inputs)
      let computation = Effect.flatMap(move supplied, succeeded)
      return run Effect.catchAll(move computation, failed)
    }
  }
  impl<'env, E: Debug> EntryResult<Effect<'env; i32 ! E>> for Application<Effect<'env; i32 ! E>> {
    fn code(value: Effect<'env; i32 ! E>, inputs: &mut WindowsHostInput) -> i32 {
      let computation = Effect.flatMap(move value, succeededStatus)
      return run Effect.catchAll(move computation, failed)
    }
  }
  impl<'env, E: Debug> EntryResult<Effect<'env; i32 ! E ? &mut HostInput>> for Application<
    Effect<'env; i32 ! E ? &mut HostInput>,
  > {
    fn code(value: Effect<'env; i32 ! E ? &mut HostInput>, inputs: &mut WindowsHostInput) -> i32 {
      let supplied = Effect.provideMut<HostInput>(move value, move inputs)
      let computation = Effect.flatMap(move supplied, succeededStatus)
      return run Effect.catchAll(move computation, failed)
    }
  }
  fn select<T>(value: &T) -> Application<T> {
    return Application<T> {}
  }
  fn adapt<T, P: EntryResult<T>>(value: T, provider: P, inputs: &mut WindowsHostInput) -> i32 {
    return EntryResult<T>.code(move value, move inputs)
  }

  fn invokeApplication(inputs: WindowsHostInput) -> i32 {
    let mut host = move inputs
    let value = application.main()
    let provider = select(&value)
    return adapt(move value, move provider, &mut host)
  }

  fn invoke<F: fn<'static>(WindowsHostInput) -> i32 + Intrinsic.NonParking>(body: F, inputs: WindowsHostInput) -> i32 {
    return body(move inputs)
  }

  effect fn start() -> i32 ! HostInputError | OutOfMemoryError {
    let mut allocator = Allocator.systemAllocatorProvider()
    let inputs = run WindowsHostInput.capture() |> Effect.provideMut<Allocator>(&mut allocator)
    return invoke(invokeApplication, move inputs)
  }

  effect fn startup() -> i32 {
    return run Effect.catchAll(start(), failed)
  }

  /// Runs the application under the shared diagnostic observer and exits with its status.
  ///
  /// # Details
  ///
  /// Startup failures and unhandled application errors produce a bounded report and status 1.
  /// Application-owned inputs and the observer are released before `ExitProcess` is called.
  export "C" fn enter() -> () as "mainCRTStartup" {
    let observer = run NativeDiagnostics.make(NativeReport.make(2, 4096, 32), 64)
    let status = run NativeDiagnostics.observe(move observer, startup())
    unsafe ExitProcess(i32.wrappingToU32(status))
    Intrinsic.trap("ExitProcess returned")
  }
}
