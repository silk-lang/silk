//! MSVC command-line encoding and decoding over Windows UTF-16 code units.
//!
//! # When to use
//! Use `CommandLine.parse` for a complete host command line. It returns raw canonical WTF-8 arguments.
//! Argument zero has its own quote rules. No wildcard expansion or shell interpretation occurs.
//! `CommandLine.encode` prepares a NUL-terminated command line for direct executable launch.
//!
//! @category Windows platform

import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.host_input { HostInputError }
import silk.platform.windows.wtf8 { Wtf8 }
import silk.num.usize

/// Encoding and decoding of executable names and arguments in Windows command lines.
pub struct CommandLine {}

fn separator(unit: u16) -> bool { return unit == 32 || unit == 9 }

// Reserve one code unit for CreateProcessW's terminating NUL. Check before growing the buffer.
effect fn appendUnit(output: &mut List<u16>, unit: u16) -> ()
! HostInputError | OutOfMemoryError ? &mut Allocator {
  if List<u16>.length(&output.*) >= 32766 { fail HostInputError {} }
  return run List<u16>.append(&mut output.*, unit)
}

impl CommandLine {
  /// Returns a NUL-terminated command line for an explicitly selected Windows executable.
  ///
  /// # Details
  ///
  /// `program` is its raw UTF-16 argument-zero spelling, without NUL. `arguments` is a sequence
  /// of NUL-terminated raw UTF-16 arguments; an empty sequence means no arguments, and a single
  /// NUL means one empty argument. Lone surrogates are preserved. Every argument is quoted;
  /// backslashes before quotes and at argument ends are escaped using MSVC rules. Argument
  /// zero uses its separate rule, in which backslashes are literal.
  ///
  /// The result contains at most 32,767 code units including its terminator. The caller must
  /// pass the executable separately to `CreateProcessW`. This encoding is for executables,
  /// not batch files or shell command strings.
  ///
  /// # Errors
  ///
  /// - `HostInputError` if `program` is empty or contains NUL or a quote, `arguments` lacks its
  ///   final NUL, or the encoded command exceeds the Windows length limit.
  /// - `OutOfMemoryError` if the result cannot be allocated.
  pub effect fn encode(program: &[u16], arguments: &[u16]) -> List<u16>
  ! HostInputError | OutOfMemoryError ? &mut Allocator {
    if program.length == 0 { fail HostInputError {} }
    if arguments.length != 0 && arguments[arguments.length - 1] != 0 { fail HostInputError {} }
    let mut output = List<u16>.make()
    run appendUnit(&mut output, 34)
    let mut at: usize = 0
    while at < program.length {
      let unit = program[at]
      if unit == 0 || unit == 34 { fail HostInputError {} }
      run appendUnit(&mut output, unit)
      at = at + 1
    }
    run appendUnit(&mut output, 34)
    at = 0
    while at < arguments.length {
      run appendUnit(&mut output, 32)
      run appendUnit(&mut output, 34)
      let mut slashes: usize = 0
      while arguments[at] != 0 {
        let unit = arguments[at]
        if unit == 34 {
          let mut extra: usize = 0
          while extra <= slashes {
            run appendUnit(&mut output, 92)
            extra = extra + 1
          }
        }
        run appendUnit(&mut output, unit)
        if unit == 92 { slashes = slashes + 1 }
        else { slashes = 0 }
        at = at + 1
      }
      let mut extra: usize = 0
      while extra < slashes {
        run appendUnit(&mut output, 92)
        extra = extra + 1
      }
      run appendUnit(&mut output, 34)
      at = at + 1
    }
    run List<u16>.append(&mut output, 0)
    return move output
  }

  /// Returns arguments in order, with the executable name at index zero.
  ///
  /// # Details
  ///
  /// `units` excludes the host NUL terminator. Empty input produces one empty program name.
  /// Leading space or tab also produces an empty program name. Only space and tab separate arguments.
  /// Quotes in argument zero toggle quoting; its backslashes are literal. Later arguments use
  /// MSVC backslash parity and doubled quotes inside quoted text. An unmatched quote consumes the rest.
  /// Lone UTF-16 surrogates survive as WTF-8 bytes, never as a valid UTF-8 `string`.
  ///
  /// # Errors
  ///
  /// - `HostInputError` if `units` contains NUL.
  /// - `OutOfMemoryError` if an argument or the argument list cannot be allocated.
  pub effect fn parse(units: &[u16]) -> List<Bytes> ! HostInputError | OutOfMemoryError ? &mut Allocator {
    let mut at: usize = 0
    while at < units.length {
      if units[at] == 0 { fail HostInputError {} }
      at = at + 1
    }
    let mut args = List<Bytes>.make()
    let mut word = List<u16>.make()
    let mut quoted = false
    at = 0
    while at < units.length {
      let unit = units[at]
      if !quoted && separator(unit) { break }
      if unit == 34 { quoted = !quoted }
      else { run List<u16>.append(&mut word, unit) }
      at = at + 1
    }
    run List<Bytes>.append(&mut args, run Wtf8.encode(List<u16>.asSlice(&word)))
    while at < units.length {
      while at < units.length && separator(units[at]) { at = at + 1 }
      if at == units.length { break }
      let mut argument = List<u16>.make()
      quoted = false
      while at < units.length {
        let unit = units[at]
        if !quoted && separator(unit) { break }
        if unit == 92 {
          let start = at
          while at < units.length && units[at] == 92 { at = at + 1 }
          let count = at - start
          let beforeQuote = at < units.length && units[at] == 34
          let mut copies = count
          if beforeQuote { copies = count / 2 }
          let mut index: usize = 0
          while index < copies {
            run List<u16>.append(&mut argument, 92)
            index = index + 1
          }
          if beforeQuote && count % 2 == 1 {
            run List<u16>.append(&mut argument, 34)
            at = at + 1
          }
        } else if unit == 34 {
          at = at + 1
          if quoted && at < units.length && units[at] == 34 {
            run List<u16>.append(&mut argument, 34)
            at = at + 1
          } else { quoted = !quoted }
        } else {
          run List<u16>.append(&mut argument, unit)
          at = at + 1
        }
      }
      run List<Bytes>.append(&mut args, run Wtf8.encode(List<u16>.asSlice(&argument)))
    }
    return move args
  }
}
