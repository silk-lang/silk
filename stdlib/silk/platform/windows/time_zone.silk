//! The time zone setting of Windows.
//!
//! # When to use
//! The `OsLocalZone` provider of `silk.time.zones_native` uses [`WindowsTimeZone`] on Windows.
//! Application code requires the `LocalZone` effect of `silk.time.zones` and does not call this
//! module.
//!
//! # Details
//! Windows names its zones with its own names, such as `E. South America Standard Time`, and
//! ships no IANA zone files. [`WindowsTimeZone.keyName`] reads the name of the zone that the
//! machine is set to, and the provider maps it to an IANA name with the table of the Unicode
//! CLDR project in the time zone bundle of the standard library.
//!
//! @category Windows platform

static if Intrinsic.targetOperatingSystem() == "windows" && Intrinsic.targetArchitecture() == "x86_64" && Intrinsic.targetAbi() == "msvc" && Intrinsic.profileText("libc") == "system" {
  import silk.collections.bytes { Bytes }
  import silk.collections.slice { Slice }
  import silk.core.option { Option }
  import silk.mem.allocator { Allocator, OutOfMemoryError }
  import silk.mem.pointer { Pointer }
  import silk.num.u16
  import silk.num.usize

  // DYNAMIC_TIME_ZONE_INFORMATION of the Windows API. The dates are SYSTEMTIME values, eight
  // 16-bit fields each.
  extern "C" struct DynamicTimeZoneInformation {
    bias: i32,
    standardName: [u16; 32],
    standardDate: [u16; 8],
    standardBias: i32,
    daylightName: [u16; 32],
    daylightDate: [u16; 8],
    daylightBias: i32,
    keyName: [u16; 128],
    dynamicDaylightTimeDisabled: u8,
  }

  @foreign(noCapture: .("information"))
  unsafe extern "C" fn GetDynamicTimeZoneInformation(information: *mut DynamicTimeZoneInformation) -> u32

  // The answer of a failed call (TIME_ZONE_ID_INVALID).
  const INVALID: u32 = 4294967295

  /// The time zone setting of Windows.
  pub struct WindowsTimeZone {}

  impl WindowsTimeZone {
    /// Returns the Windows name of the zone that the machine is set to, such as
    /// `E. South America Standard Time`, or `None` if Windows does not answer or the name is
    /// empty or not ASCII.
    ///
    /// # Errors
    /// - `OutOfMemoryError` if the `Allocator` cannot supply the name.
    pub effect fn keyName() -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
      let mut information = DynamicTimeZoneInformation {
        bias: 0,
        standardName: [0; 32],
        standardDate: [0; 8],
        standardBias: 0,
        daylightName: [0; 32],
        daylightDate: [0; 8],
        daylightBias: 0,
        keyName: [0; 128],
        dynamicDaylightTimeDisabled: 0,
      }
      if unsafe GetDynamicTimeZoneInformation(Pointer.fromMutRef(&mut information)) == INVALID {
        return Option<Bytes>.none()
      }
      let mut name: [u8; 128] = [0; 128]
      let mut length = usize.ZERO
      while length < 128 && information.keyName[length] != 0 {
        if information.keyName[length] >= 128 {
          return Option<Bytes>.none()
        }
        name[length] = u16.wrappingToU8(information.keyName[length])
        length = length + 1
      }
      if length == 0 {
        return Option<Bytes>.none()
      }
      return Option<Bytes>.some(run Bytes.copy(Slice.view<u8>(&name, 0, length)))
    }
  }
}
