//! Handle-relative filesystem operations for the Windows `OsFileSystem` provider.
//!
//! # Details
//! Portable paths remain relative to the provider root. Native roots use absolute drive or UNC
//! paths, such as `C:\\work` or `\\\\server\\share`. Names use canonical WTF-8 and preserve lone surrogates.
//! Each component opens without kernel reparse traversal. Relative symbolic links resolve through
//! retained directory handles; `..` stops at the provider root. Absolute symbolic links and junctions
//! must name that native root or a descendant, with matching component spelling except drive-letter
//! case. Other absolute targets and unknown tags are unsupported. At most 40 links resolve per path.
//! Listings classify symbolic links and junctions as links; final removal and replacement act on the link.
//! Operations require NTFS. Remote publication is refused before staging; deletion reports
//! `Unsupported` when the server lacks POSIX disposition. Directory synchronization is unsupported.
//!
//! @category Windows platform

static if Intrinsic.targetOperatingSystem() == "windows" && Intrinsic.targetArchitecture() == "x86_64" && Intrinsic.targetAbi() == "msvc" && Intrinsic.profileText("libc") == "system" {
import silk.core.ownership { Drop }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.platform.windows.wtf8 { Wtf8, Wtf8Point, InvalidWtf8 }
import silk.system.filesystem { FileSystem, FileOperation, FileReason, FileError, AtomicWriteError }
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.i64
import silk.num.usize

extern "C" struct UnicodeString { length: u16, capacity: u16, buffer: ?[*]const u16 }
extern "C" struct ObjectAttributes {
  length: u32, root: ?*mut u8, name: *mut UnicodeString, attributes: u32,
  security: ?*mut u8, quality: ?*mut u8,
}
extern "C" struct IoStatus { status: usize, information: usize }
extern "C" struct AttributeTag { attributes: u32, tag: u32 }
extern "C" struct StandardInfo {
  allocation: i64, length: i64, links: u32, deletePending: u8, directory: u8,
}
extern "C" struct RenameInfo {
  flags: u32, root: ?*mut u8, length: u32, name: [u16; 255],
}
@foreign(noCapture: ("handle", "attributes", "io", "allocation", "ea"))
unsafe extern "C" fn NtCreateFile(handle: *mut ?*mut u8, access: u32, attributes: *mut ObjectAttributes, io: *mut IoStatus, allocation: ?*mut i64, fileAttributes: u32, sharing: u32, disposition: u32, options: u32, ea: ?*mut u8, eaLength: u32) -> i32
unsafe extern "C" fn NtClose(handle: ?*mut u8) -> i32
@foreign(noCapture: ("io", "buffer"))
unsafe extern "C" fn NtQueryInformationFile(handle: ?*mut u8, io: *mut IoStatus, buffer: *mut u8, length: u32, kind: u32) -> i32
@foreign(noCapture: ("io", "buffer"))
unsafe extern "C" fn NtQueryVolumeInformationFile(handle: ?*mut u8, io: *mut IoStatus, buffer: *mut u8, length: u32, kind: u32) -> i32
@foreign(noCapture: ("io", "buffer"))
unsafe extern "C" fn NtSetInformationFile(handle: ?*mut u8, io: *mut IoStatus, buffer: *mut u8, length: u32, kind: u32) -> i32
@foreign(noCapture: ("io", "buffer", "offset", "key"))
unsafe extern "C" fn NtReadFile(handle: ?*mut u8, event: ?*mut u8, routine: ?*mut u8, context: ?*mut u8, io: *mut IoStatus, buffer: ?[*]mut u8, length: u32, offset: ?*mut i64, key: ?*mut u32) -> i32
@foreign(noCapture: ("io", "buffer", "offset", "key"))
unsafe extern "C" fn NtWriteFile(handle: ?*mut u8, event: ?*mut u8, routine: ?*mut u8, context: ?*mut u8, io: *mut IoStatus, buffer: ?[*]const u8, length: u32, offset: ?*mut i64, key: ?*mut u32) -> i32
@foreign(noCapture: ("io", "buffer", "name"))
unsafe extern "C" fn NtQueryDirectoryFile(handle: ?*mut u8, event: ?*mut u8, routine: ?*mut u8, context: ?*mut u8, io: *mut IoStatus, buffer: *mut u8, length: u32, kind: u32, single: u8, name: ?*mut UnicodeString, restart: u8) -> i32
@foreign(noCapture: ("io", "input", "output"))
unsafe extern "C" fn NtFsControlFile(handle: ?*mut u8, event: ?*mut u8, routine: ?*mut u8, context: ?*mut u8, io: *mut IoStatus, code: u32, input: ?*mut u8, inputLength: u32, output: *mut u8, outputLength: u32) -> i32

// All provider codes in this module are NTSTATUS bit patterns, never GetLastError values.
// Logical errors have no provider code. No operation retries an access or sharing failure.
fn ntReason(code: i32) -> FileReason {
  if code == -1073741772 || code == -1073741766 || code == -1073741809 { return FileSystem.notFound() }
  if code == -1073741771 { return FileSystem.alreadyExists() }
  if code == -1073741790 || code == -1073741535 { return FileSystem.permissionDenied() }
  if code == -1073741773 || code == -1073741765 || code == -1073741562 { return FileSystem.invalidPath() }
  if code == -1073741638 || code == -1073741565 { return FileSystem.wrongType() }
  if code == -1073741567 { return FileSystem.notEmpty() }
  if code == -1073741697 || code == -1073741801 || code == -1073741670 { return FileSystem.noSpace() }
  if code == -1073741637 { return FileSystem.unsupported() }
  return FileSystem.other()
}
effect fn reject(operation: i32, code: i32) -> never ! FileError {
  fail FileSystem.errorWithCode(FileOperation { code: operation }, ntReason(code), code)
}
effect fn logical(operation: i32, reason: FileReason) -> never ! FileError {
  fail FileSystem.error(FileOperation { code: operation }, move reason)
}
effect fn checked(status: i32, operation: i32) -> () ! FileError {
  // Synchronous handles must complete before their borrowed buffers go out of scope.
  if status != 0 { return run reject(operation, status) }
}
effect fn strictStatus(status: i32, operation: i32) -> () ! FileError {
  if status == -1073741811 || status == -1073741821 || status == -1073741808 || status == -1073741637 {
    fail FileSystem.errorWithCode(FileOperation { code: operation }, FileSystem.unsupported(), status)
  }
  return run checked(status, operation)
}
fn emptyIo() -> IoStatus { return IoStatus { status: 0, information: 0 } }
struct Handle { raw: ?*mut u8 }
impl Drop for Handle {
  fn drop(self: &mut Handle) -> () {
    let raw = Intrinsic.replace(self.raw, Pointer.null<u8>())
    if !Pointer.isNull(raw) { let ignored = unsafe NtClose(raw) }
  }
}
effect fn close(value: Handle, operation: i32) -> () ! FileError {
  let mut owner = move value
  let raw = Intrinsic.replace(owner.raw, Pointer.null<u8>())
  if !Pointer.isNull(raw) { run checked(unsafe NtClose(raw), operation) }
}

/// An owned synchronous file handle, shared for reads, writes, and deletion. Drop closes it once.
pub struct FileHandle { handle: Handle }
/// An owned directory handle with one pending counted name. Drop closes it once.
pub struct DirectoryHandle { handle: Handle, pending: Bytes, kind: i32, ended: bool }
struct Parent { handle: Handle, name: List<u16> }

fn canonical(bytes: &[u8]) -> bool {
  let mut at: usize = 0
  while at < bytes.length {
    let point = match move Wtf8.pointBytes(bytes, at) {
      Option<Wtf8Point>.Some { value } => move value
      Option<Wtf8Point>.None => { return false }
    }
    if point.value == 0 { return false }
    at = point.end
  }
  return true
}
fn component(bytes: &[u8]) -> bool {
  if bytes.length == 0 || !canonical(bytes) { return false }
  if bytes.length == 1 && bytes[0] == 46 { return false }
  if bytes.length == 2 && bytes[0] == 46 && bytes[1] == 46 { return false }
  let mut at: usize = 0
  while at < bytes.length {
    let byte = bytes[at]
    if byte == 47 || byte == 92 || byte == 58 { return false }
    at = at + 1
  }
  return true
}
effect fn wide(bytes: &[u8], operation: i32) -> List<u16> ! FileError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let result = run Effect.result(Wtf8.decodeBytes(bytes) |> Effect.provideMut<Allocator>(&mut allocator))
  return match move result {
    Result<List<u16>, InvalidWtf8 | OutOfMemoryError>.Success { value } => move value
    Result<List<u16>, InvalidWtf8 | OutOfMemoryError>.Failure { error } => match move error {
      InvalidWtf8 invalid => run logical(operation, FileSystem.invalidPath())
      OutOfMemoryError exhausted => run logical(operation, FileSystem.noSpace())
    }
  }
}
effect fn copied(bytes: &[u8], operation: i32) -> Bytes ! FileError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let result = run Effect.result(Bytes.copy(bytes) |> Effect.provideMut<Allocator>(&mut allocator))
  return match move result {
    Result<Bytes, OutOfMemoryError>.Success { value } => move value
    Result<Bytes, OutOfMemoryError>.Failure { error } => run logical(operation, FileSystem.noSpace())
  }
}
effect fn encoded(units: &[u16], operation: i32) -> Bytes ! FileError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let result = run Effect.result(Wtf8.encode(units) |> Effect.provideMut<Allocator>(&mut allocator))
  return match move result {
    Result<Bytes, OutOfMemoryError>.Success { value } => move value
    Result<Bytes, OutOfMemoryError>.Failure { error } => run logical(operation, FileSystem.noSpace())
  }
}
effect fn openAt(parent: ?*mut u8, units: &[u16], access: u32, disposition: u32, options: u32, operation: i32) -> Handle ! FileError {
  if units.length > 32767 { return run logical(operation, FileSystem.tooLarge()) }
  let size = usize.toU16(units.length * 2)
  let mut name = UnicodeString { length: size, capacity: size, buffer: Pointer.fromSlice(units) }
  // Do not set OBJ_CASE_INSENSITIVE: NTFS per-directory case sensitivity must remain effective.
  let mut attributes = ObjectAttributes { length: 48, root: parent, name: Pointer.fromMutRef(&mut name), attributes: 0, security: Pointer.null<u8>(), quality: Pointer.null<u8>() }
  let mut io = emptyIo()
  let mut raw = Pointer.null<u8>()
  let status = unsafe NtCreateFile(Pointer.fromMutRef(&mut raw), access | 1048576, Pointer.fromMutRef(&mut attributes), Pointer.fromMutRef(&mut io), Pointer.null<i64>(), 128, 7, disposition, options | 2097152 | 32, Pointer.null<u8>(), 0)
  run checked(status, operation)
  return Handle { raw: raw }
}
effect fn attributes(raw: ?*mut u8, operation: i32) -> AttributeTag ! FileError {
  let mut value = AttributeTag { attributes: 0, tag: 0 }
  let mut io = emptyIo()
  run checked(unsafe NtQueryInformationFile(raw, Pointer.fromMutRef(&mut io), unsafe Intrinsic.pointerReinterpret<*mut AttributeTag, *mut u8>(Pointer.fromMutRef(&mut value)), 8, 35), operation)
  return move value
}
effect fn entryKind(value: &AttributeTag, operation: i32) -> i32 ! FileError {
  if (value.attributes & 1024) != 0 {
    if value.tag == 2684354572 || value.tag == 2684354563 { return 2 }
    return run logical(operation, FileSystem.unsupported())
  }
  if (value.attributes & 16) != 0 { return 1 }
  return 0
}
effect fn requireKind(raw: ?*mut u8, expected: i32, operation: i32) -> () ! FileError {
  let value = run attributes(raw, operation)
  let actual = run entryKind(&value, operation)
  if actual == 2 { return run logical(operation, FileSystem.unsupported()) }
  if expected >= 0 && actual != expected { return run logical(operation, FileSystem.wrongType()) }
}
// Read fields bytewise: directory drivers have returned records with unexpected alignment.
fn word(bytes: &[u8], offset: usize) -> u32 {
  return u8.toU32(bytes[offset]) + u8.toU32(bytes[offset + 1]) * 256 + u8.toU32(bytes[offset + 2]) * 65536 + u8.toU32(bytes[offset + 3]) * 16777216
}
effect fn ntfs(raw: ?*mut u8, operation: i32) -> () ! FileError {
  let mut storage: [u64; 16] = [0; 16]
  let pointer = unsafe Intrinsic.pointerReinterpret<*mut u64, *mut u8>(Pointer.fromMutRef(&mut storage[0]))
  let mut io = emptyIo()
  run strictStatus(unsafe NtQueryVolumeInformationFile(raw, Pointer.fromMutRef(&mut io), pointer, 128, 4), operation)
  let device = unsafe Pointer.borrowMany(&storage, unsafe Pointer.assumeMany(pointer), 8)
  if word(device, 0) != 7 { return run logical(operation, FileSystem.unsupported()) }
  drop device
  run strictStatus(unsafe NtQueryVolumeInformationFile(raw, Pointer.fromMutRef(&mut io), pointer, 128, 5), operation)
  if io.information < 20 { return run logical(operation, FileSystem.unsupported()) }
  let data = unsafe Pointer.borrowMany(&storage, unsafe Pointer.assumeMany(pointer), 20)
  if word(data, 8) != 8 || word(data, 12) != 5505102 || word(data, 16) != 5439558 {
    return run logical(operation, FileSystem.unsupported())
  }
}

// SMB can report NTFS while refusing POSIX rename/delete. Refuse publication before staging;
// ordinary reads, writes, creation, and inspection do not require those information classes.
effect fn localPublication(raw: ?*mut u8, operation: i32) -> () ! FileError {
  let mut device: [u32; 2] = [0, 0]
  let mut io = emptyIo()
  let pointer = unsafe Intrinsic.pointerReinterpret<*mut u32, *mut u8>(Pointer.fromMutRef(&mut device[0]))
  run strictStatus(unsafe NtQueryVolumeInformationFile(raw, Pointer.fromMutRef(&mut io), pointer, 8, 4), operation)
  if (device[1] & 16) != 0 { return run logical(operation, FileSystem.unsupported()) }
}
effect fn rootHandle(root: &[u8], operation: i32) -> Handle ! FileError {
  if !WindowsFileSystem.validRootBytes(root) { return run logical(operation, FileSystem.invalidPath()) }
  // Counted NT names avoid Win32 normalization and the MAX_PATH boundary.
  let units = run wide(root, operation)
  let mut buffer: [u16; 32767] = [0; 32767]
  let view = List<u16>.asSlice(&units)
  let remote = root[0] == 92
  let prefix: usize = if remote { 8 } else { 4 }
  let skipped: usize = if remote { 2 } else { 0 }
  if view.length > 32767 - prefix + skipped { return run logical(operation, FileSystem.tooLarge()) }
  buffer[0] = 92
  buffer[1] = 63
  buffer[2] = 63
  buffer[3] = 92
  if remote { buffer[4] = 85
    buffer[5] = 78
    buffer[6] = 67
    buffer[7] = 92 }
  let mut at = skipped
  while at < view.length { buffer[prefix + at - skipped] = view[at]
    at = at + 1 }
  let result = run openAt(Pointer.null<u8>(), Slice.view(&buffer, 0, view.length + prefix - skipped), 128, 1, 1, operation)
  run requireKind(result.raw, 1, operation)
  run ntfs(result.raw, operation)
  return move result
}
struct LinkTarget { path: Bytes, absolute: bool }

// Read the substitute name from the opened reparse object, never by reopening its spelling.
// Absolute NT targets must lie below the provider's native root. Lookup still occurs only
// through retained root-relative handles, so lexical prefix recognition grants no host access.
effect fn linkTarget(handle: &Handle, root: &[u8], operation: i32) -> LinkTarget
! FileError | OutOfMemoryError ? &mut Allocator {
  let mut buffer: [u16; 8192] = [0; 8192]
  let pointer = unsafe Intrinsic.pointerReinterpret<*mut u16, *mut u8>(Pointer.fromMutRef(&mut buffer[0]))
  let mut io = emptyIo()
  run checked(unsafe NtFsControlFile(handle.raw, Pointer.null<u8>(), Pointer.null<u8>(), Pointer.null<u8>(), Pointer.fromMutRef(&mut io), 589992, Pointer.null<u8>(), 0, pointer, 16384), operation)
  if io.information < 16 || io.information > 16384 { return run logical(operation, FileSystem.invalidPath()) }
  let bytes = unsafe Pointer.borrowMany(&buffer, unsafe Pointer.assumeMany(pointer), io.information)
  let tag = word(bytes, 0)
  let dataLength = u16.toUsize(buffer[2])
  if dataLength + 8 > io.information { return run logical(operation, FileSystem.invalidPath()) }
  let mut begin: usize = 16
  let mut absolute = true
  if tag == 2684354572 {
    if io.information < 20 || dataLength < 12 { return run logical(operation, FileSystem.invalidPath()) }
    let flags = word(bytes, 16)
    if flags > 1 { return run logical(operation, FileSystem.unsupported()) }
    absolute = flags == 0
    begin = 20
  } else if tag != 2684354563 { return run logical(operation, FileSystem.unsupported()) }
  let offset = u16.toUsize(buffer[4])
  let length = u16.toUsize(buffer[5])
  if length == 0 || offset % 2 != 0 || length % 2 != 0 || begin + offset + length > dataLength + 8 {
    return run logical(operation, FileSystem.invalidPath())
  }
  drop bytes
  let native = run Wtf8.encode(Slice.view(&buffer, (begin + offset) / 2, length / 2))
  let text = Bytes.asSlice(&native)
  if !canonical(text) { return run logical(operation, FileSystem.invalidPath()) }
  let mut start: usize = 0
  if absolute {
    let remote = root[0] == 92
    let prefix: usize = if remote { 8 } else { 4 }
    let skipped: usize = if remote { 2 } else { 0 }
    if text.length < root.length + prefix - skipped || text[0] != 92 || text[1] != 63 || text[2] != 63 || text[3] != 92 {
      return run logical(operation, FileSystem.unsupported())
    }
    if remote && (text[4] != 85 || text[5] != 78 || text[6] != 67 || text[7] != 92) {
      return run logical(operation, FileSystem.unsupported())
    }
    let mut at = skipped
    while at < root.length {
      let mut actual = text[at + prefix - skipped]
      let mut expected = root[at]
      // Drive letters are case-insensitive; other components retain their exact spelling.
      if !remote && at == 0 {
        if actual >= 97 && actual <= 122 { actual = actual - 32 }
        if expected >= 97 && expected <= 122 { expected = expected - 32 }
      }
      if actual != expected { return run logical(operation, FileSystem.unsupported()) }
      at = at + 1
    }
    start = root.length + prefix - skipped
    if start < text.length && root[root.length - 1] != 92 {
      if text[start] != 92 { return run logical(operation, FileSystem.unsupported()) }
      start = start + 1
    }
  } else if text[0] == 92 || text[0] == 47 {
    return run logical(operation, FileSystem.invalidPath())
  }
  let mut path = run Bytes.copy(Slice.view(text, start, text.length - start))
  let view = Bytes.asMutSlice(&mut path)
  let mut at: usize = 0
  while at < view.length {
    if view[at] == 92 { view[at] = 47 }
    at = at + 1
  }
  drop view
  return LinkTarget { path: move path, absolute: absolute }
}

effect fn walk(root: &[u8], path: &[u8], followFinal: bool, operation: i32) -> Parent
! FileError | OutOfMemoryError ? &mut Allocator {
  let mut directory = run rootHandle(root, operation)
  let mut ancestors = List<Handle>.make()
  let mut pending = run Bytes.copy(path)
  let mut followed: usize = 0
  let mut at: usize = 1
  while at < Bytes.length(&pending) {
    let start = at
    while at < Bytes.length(&pending) && Bytes.asSlice(&pending)[at] != 47 { at = at + 1 }
    let last = at == Bytes.length(&pending)
    let part = Slice.view(Bytes.asSlice(&pending), start, at - start)
    if part.length == 0 || (part.length == 1 && part[0] == 46) {
      at = at + 1
    } else if part.length == 2 && part[0] == 46 && part[1] == 46 {
      if let Option<Handle>.Some {value} = move List<Handle>.pop(&mut ancestors) {
        let previous = Intrinsic.replace(directory, move value)
        run close(move previous, operation)
      }
      at = at + 1
    } else {
      if !component(part) { return run logical(operation, FileSystem.invalidPath()) }
      let name = run wide(part, operation)
      if List<u16>.length(&name) > 255 { return run logical(operation, FileSystem.tooLarge()) }
      if last && !followFinal { return Parent {handle: move directory, name: move name} }
      let attempted = run Effect.result(openAt(directory.raw, List<u16>.asSlice(&name), 128, 1, 0, operation))
      let child = match move attempted {
        Result<Handle, FileError>.Success {value} => move value
        Result<Handle, FileError>.Failure {error} => {
          // The caller performs the final open/create atomically, with reparse traversal disabled.
          if last && error.reason.code == FileSystem.notFound().code {
            return Parent {handle: move directory, name: move name}
          }
          fail move error
        }
      }
      let facts = run attributes(child.raw, operation)
      let kind = run entryKind(&facts, operation)
      if kind == 2 {
        followed = followed + 1
        if followed > 40 { return run logical(operation, FileSystem.invalidPath()) }
        let target = run linkTarget(&child, root, operation)
        run close(move child, operation)
        let mut next = move target.path
        if !last {
          run Bytes.append(&mut next, b"/")
          run Bytes.append(&mut next, Slice.view(Bytes.asSlice(&pending), at + 1, Bytes.length(&pending) - at - 1))
        }
        if target.absolute {
          while List<Handle>.length(&ancestors) > 0 {
            if let Option<Handle>.Some {value} = move List<Handle>.pop(&mut ancestors) {
              let previous = Intrinsic.replace(directory, move value)
              run close(move previous, operation)
            }
          }
        }
        pending = move next
        at = 0
      } else if last {
        run close(move child, operation)
        return Parent {handle: move directory, name: move name}
      } else {
        if kind != 1 { return run logical(operation, FileSystem.wrongType()) }
        let previous = Intrinsic.replace(directory, move child)
        run List<Handle>.append(&mut ancestors, move previous)
        at = at + 1
      }
    }
  }
  return Parent {handle: move directory, name: List<u16>.make()}
}

effect fn resolvedParent(root: &[u8], path: &[u8], followFinal: bool, operation: i32) -> Parent ! FileError {
  if path.length == 0 || path[0] != 47 { return run logical(operation, FileSystem.invalidPath()) }
  let mut at: usize = 1
  while at < path.length {
    let start = at
    while at < path.length && path[at] != 47 { at = at + 1 }
    if !component(Slice.view(path, start, at - start)) || at + 1 == path.length {
      return run logical(operation, FileSystem.invalidPath())
    }
    at = at + 1
  }
  let mut allocator = Allocator.systemAllocatorProvider()
  return match move run Effect.result(walk(root, path, followFinal, operation) |> Effect.provideMut<Allocator>(&mut allocator)) {
    Result<Parent, FileError | OutOfMemoryError>.Success {value} => move value
    Result<Parent, FileError | OutOfMemoryError>.Failure {error} => match move error {
      FileError failure => { fail move failure }
      OutOfMemoryError exhausted => run logical(operation, FileSystem.noSpace())
    }
  }
}

effect fn parentOf(root: &[u8], path: &[u8], operation: i32) -> Parent ! FileError {
  return run resolvedParent(root, path, false, operation)
}
effect fn openPath(root: &[u8], path: &[u8], access: u32, disposition: u32, options: u32, expected: i32, operation: i32) -> Handle ! FileError {
  let parent = run resolvedParent(root, path, disposition != 2, operation)
  if List<u16>.length(&parent.name) == 0 && disposition != 1 { return run logical(operation, FileSystem.wrongType()) }
  let handle = run openAt(parent.handle.raw, List<u16>.asSlice(&parent.name), access, disposition, options, operation)
  run requireKind(handle.raw, expected, operation)
  run close(move parent.handle, operation)
  return move handle
}
effect fn disposition(raw: ?*mut u8, operation: i32) -> () ! FileError {
  // DELETE | POSIX_SEMANTICS. Do not ignore the read-only attribute.
  let mut flags: u32 = 3
  let mut io = emptyIo()
  return run strictStatus(unsafe NtSetInformationFile(raw, Pointer.fromMutRef(&mut io), unsafe Intrinsic.pointerReinterpret<*mut u32, *mut u8>(Pointer.fromMutRef(&mut flags)), 4, 64), operation)
}
effect fn truncate(raw: ?*mut u8, operation: i32) -> () ! FileError {
  let mut length: i64 = 0
  let mut io = emptyIo()
  return run checked(unsafe NtSetInformationFile(raw, Pointer.fromMutRef(&mut io), unsafe Intrinsic.pointerReinterpret<*mut i64, *mut u8>(Pointer.fromMutRef(&mut length)), 8, 20), operation)
}
fn remember(primary: &mut Option<FileError>, result: Result<(), FileError>) -> () {
  match move result {
    Result<(), FileError>.Success { value } => ()
    Result<(), FileError>.Failure { error } => {
      if !Option<FileError>.isSome(&primary.*) { primary.* = Option<FileError>.some(move error) }
    }
  }
}
effect fn finish(primary: Option<FileError>) -> () ! FileError {
  match move primary {
    Option<FileError>.Some { value } => { fail move value }
    Option<FileError>.None => ()
  }
}
fn copyError(error: &FileError) -> FileError {
  let operation = FileOperation { code: error.operation.code }
  let reason = FileReason { code: error.reason.code }
  return match move FileSystem.providerCode(error) {
    Option<i32>.Some { value } => FileSystem.errorWithCode(move operation, move reason, value)
    Option<i32>.None => FileSystem.error(move operation, move reason)
  }
}

struct Publication {
  parent: Parent, file: FileHandle, name: Bytes, pending: bool, published: bool,
}
impl Drop for Publication {
  fn drop(self: &mut Publication) -> () {
    if self.pending && !Pointer.isNull(self.file.handle.raw) {
      // Unwind backstop only. Explicit cleanup clears pending even when it fails.
      self.pending = false
      let mut flags: u32 = 3
      let mut io = emptyIo()
      let ignored = unsafe NtSetInformationFile(self.file.handle.raw, Pointer.fromMutRef(&mut io), unsafe Intrinsic.pointerReinterpret<*mut u32, *mut u8>(Pointer.fromMutRef(&mut flags)), 4, 64)
    }
  }
}
effect fn prepare(root: &[u8], path: &[u8]) -> Publication ! FileError {
  let parent = run parentOf(root, path, 10)
  if List<u16>.length(&parent.name) == 0 { return run logical(10, FileSystem.wrongType()) }
  let name = run copied(b"s0000000", 10)
  return Publication { parent: move parent, file: FileHandle { handle: Handle { raw: Pointer.null<u8>() } }, name: move name, pending: false, published: false }
}
fn nextCounter(counter: &mut u64) -> u64 {
  let value = counter.*
  if value == u64.MAX { counter.* = 0 } else { counter.* = value + 1 }
  return value
}
fn stageAlias(name: &[u8], destination: &[u16]) -> bool {
  if name.length != destination.length { return false }
  let mut at: usize = 0
  while at < name.length {
    let mut unit = destination[at]
    if unit >= 65 && unit <= 90 { unit = unit + 32 }
    if unit != u8.toU16(name[at]) { return false }
    at = at + 1
  }
  return true
}
effect fn publish(owner: &mut Publication, bytes: &[u8], policy: i32, counter: &mut u64) -> () ! FileError {
  run localPublication(owner.parent.handle.raw, 10)
  if policy == 0 {
    // Type validation only; the single rename below decides replacement atomically.
    let inspected = run Effect.result(openAt(owner.parent.handle.raw, List<u16>.asSlice(&owner.parent.name), 128, 1, 0, 10))
    match move inspected {
      Result<Handle, FileError>.Success { value } => {
        let tag = run attributes(value.raw, 10)
        if (run entryKind(&tag, 10)) == 1 { return run logical(10, FileSystem.wrongType()) }
        run close(move value, 10)
      }
      Result<Handle, FileError>.Failure { error } => {
        if error.reason.code != 0 { fail move error }
      }
    }
  }
  let digits = b"0123456789abcdef"
  let mut attempts = 0
  while !owner.pending && attempts < 128 {
    let mut candidate = nextCounter(&mut counter)
    let output = Bytes.asMutSlice(&mut owner.name)
    let mut remaining: usize = 7
    while remaining > 0 {
      output[remaining] = digits[u64.toUsize(candidate % 16)]
      candidate = candidate / 16
      remaining = remaining - 1
    }
    drop output
    // Eight ASCII characters need no generated 8.3 alias. Exclude the destination even on
    // case-insensitive directories, without changing any user path or dependency key.
    if !stageAlias(Bytes.asSlice(&owner.name), List<u16>.asSlice(&owner.parent.name)) {
      let name = run wide(Bytes.asSlice(&owner.name), 10)
      let attempted = run Effect.result(openAt(owner.parent.handle.raw, List<u16>.asSlice(&name), 65666, 2, 64, 10))
      match move attempted {
        Result<Handle, FileError>.Success { value } => {
          owner.file.handle = move value
          owner.pending = true
        }
        Result<Handle, FileError>.Failure { error } => {
          if error.reason.code != 1 { fail move error }
        }
      }
    }
    attempts = attempts + 1
  }
  if !owner.pending { return run logical(10, FileSystem.alreadyExists()) }
  run WindowsFileSystem.writeFile(&mut owner.file, bytes, 10)
  let mut rename = RenameInfo { flags: 2, root: owner.parent.handle.raw, length: 0, name: [0; 255] }
  if policy == 0 { rename.flags = 3 }
  let destination = List<u16>.asSlice(&owner.parent.name)
  rename.length = usize.toU32(destination.length * 2)
  let mut at: usize = 0
  while at < destination.length { rename.name[at] = destination[at]
    at = at + 1 }
  let mut io = emptyIo()
  run strictStatus(unsafe NtSetInformationFile(owner.file.handle.raw, Pointer.fromMutRef(&mut io), unsafe Intrinsic.pointerReinterpret<*mut RenameInfo, *mut u8>(Pointer.fromMutRef(&mut rename)), 20 + rename.length, 65), 10)
  owner.published = true
  owner.pending = false
}
effect fn rejectAtomic(error: FileError) -> never ! AtomicWriteError {
  fail AtomicWriteError { published: false, cause: move error, cleanupError: Option<FileError>.none(), stagingName: Bytes.make() }
}

/// Handle-relative NTFS operations for `OsFileSystem`, with no C runtime dependency.
///
/// # Details
///
/// All provider error codes are signed NTSTATUS bit patterns. Logical errors have no native code.
/// Handles allow read, write, and delete sharing. Relative link targets stay inside the provider root;
/// parent components stop at it. Absolute symlink and junction targets must name the same native root
/// or a descendant, with matching component spelling except drive-letter case. Other absolute targets,
/// unknown tags, and directory synchronization are unsupported. More than 40 links fails with `InvalidPath`.
/// UNC roots support ordinary reads, writes, creation, inspection, and listing. Remote atomic publication
/// is refused before staging; deletion requires the server's POSIX disposition support and otherwise fails.
/// The intended minimum is Windows 10 1809; native fixtures currently target Server 2025 build 26100.
pub struct WindowsFileSystem {}
impl WindowsFileSystem {
  /// Returns whether bytes are a canonical WTF-8 absolute drive or server/share UNC path with normalized backslash components.
  ///
  /// Device, verbatim, drive-relative, and slash-rooted names are rejected. UNC requires a server and share.
  /// Case is preserved; empty, `.` and `..` components and trailing separators except drive roots are rejected.
  pub fn validRootBytes(root: &[u8]) -> bool {
    if root.length < 3 || !canonical(root) { return false }
    let mut start: usize = 3
    let remote = root[0] == 92 && root[1] == 92
    if remote {
      if root[2] == 63 || root[2] == 46 { return false }
      start = 2
    } else {
      if !((root[0] >= 65 && root[0] <= 90) || (root[0] >= 97 && root[0] <= 122)) { return false }
      if root[1] != 58 || root[2] != 92 { return false }
      if root.length == 3 { return true }
    }
    let mut parts: usize = 0
    let mut at = start
    while at <= root.length {
      let mut boundary = at == root.length
      if at < root.length { boundary = root[at] == 92 }
      if boundary {
        if !component(Slice.view(root, start, at - start)) { return false }
        parts = parts + 1
        start = at + 1
      }
      at = at + 1
    }
    return !remote || parts >= 2
  }

  /// Opens a regular file for reading, or creates and truncates it for writing, following confined links.
  ///
  /// Relative link targets resolve inside the root; `..` stops there. Absolute targets must name
  /// the native root or a descendant with matching component spelling except drive-letter case.
  /// `FileError` reports native failures, invalid names, a non-file target, or `InvalidPath` after
  /// 40 links. Other absolute targets and unknown reparse tags fail with `Unsupported`.
  pub effect fn openFile(root: &[u8], path: &[u8], writing: bool, operation: i32) -> FileHandle ! FileError {
    let mut access: u32 = 129
    let mut creation: u32 = 1
    if writing { access = 130
      creation = 3 }
    let handle = run openPath(root, path, access, creation, 64, 0, operation)
    if writing { run truncate(handle.raw, operation) }
    return FileHandle { handle: move handle }
  }
  /// Reads bytes from the current position, returning zero at EOF. Native failures produce `FileError`.
  pub effect fn readFile(handle: &mut FileHandle, output: &mut [u8], operation: i32) -> usize ! FileError {
    if output.length == 0 { return 0 }
    let mut count = output.length
    if count > 2147483647 { count = 2147483647 }
    let mut io = emptyIo()
    let status = unsafe NtReadFile(handle.handle.raw, Pointer.null<u8>(), Pointer.null<u8>(), Pointer.null<u8>(), Pointer.fromMutRef(&mut io), Pointer.fromMutSlice(move output), usize.toU32(count), Pointer.null<i64>(), Pointer.null<u32>())
    if status == -1073741807 { return 0 }
    run checked(status, operation)
    if io.information > count { return run logical(operation, FileSystem.other()) }
    return io.information
  }
  /// Writes all bytes at the current position. A `FileError` can follow partial progress.
  pub effect fn writeFile(handle: &mut FileHandle, input: &[u8], operation: i32) -> () ! FileError {
    let mut offset: usize = 0
    while offset < input.length {
      let mut count = input.length - offset
      if count > 2147483647 { count = 2147483647 }
      let mut io = emptyIo()
      let view = Slice.view(input, offset, count)
      run checked(unsafe NtWriteFile(handle.handle.raw, Pointer.null<u8>(), Pointer.null<u8>(), Pointer.null<u8>(), Pointer.fromMutRef(&mut io), Pointer.fromSlice(view), usize.toU32(count), Pointer.null<i64>(), Pointer.null<u32>()), operation)
      if io.information == 0 || io.information > count { return run logical(operation, FileSystem.other()) }
      offset = offset + io.information
    }
  }
  /// Creates a new regular file and writes its contents. Any existing entry causes `AlreadyExists`.
  /// A later `FileError` leaves the partial file in place.
  pub effect fn createFile(root: &[u8], path: &[u8], bytes: &[u8]) -> () ! FileError {
    let handle = run openPath(root, path, 130, 2, 64, 0, 9)
    let mut file = FileHandle { handle: move handle }
    let mut primary = Option<FileError>.none()
    remember(&mut primary, run Effect.result(WindowsFileSystem.writeFile(&mut file, bytes, 9)))
    remember(&mut primary, run Effect.result(WindowsFileSystem.closeFile(move file, FileSystem.createFileOperation())))
    return run finish(move primary)
  }
  /// Publishes complete bytes through one handle rename: policy 0 replaces, and policy 1 creates only.
  /// Remote volumes fail with `Unsupported` before a staging file is created.
  ///
  /// # Details
  ///
  /// An existing destination blocks create-only publication atomically. Replacement preserves existing
  /// handles to the old object. No copy or delete-then-rename fallback exists. At most 128 names are tried.
  ///
  /// # Errors
  ///
  /// - `AtomicWriteError` reports the first failure, publication state, and any failed temporary cleanup.
  /// - A nonzero durability or unknown policy fails with `Unsupported` before any file is created.
  pub effect fn writeFileAtomic(root: &[u8], path: &[u8], bytes: &[u8], policy: i32, durability: i32, counter: &mut u64) -> () ! AtomicWriteError {
    if durability != 0 || (policy != 0 && policy != 1) {
      return run rejectAtomic(FileSystem.error(FileSystem.writeFileAtomicOperation(), FileSystem.unsupported()))
    }
    let prepared = run Effect.result(prepare(root, path))
    let mut owner = match move prepared {
      Result<Publication, FileError>.Success { value } => move value
      Result<Publication, FileError>.Failure { error } => run rejectAtomic(move error)
    }
    let mut primary = Option<FileError>.none()
    remember(&mut primary, run Effect.result(publish(&mut owner, bytes, policy, move counter)))
    let mut cleanupError = Option<FileError>.none()
    let mut residual = Bytes.make()
    let cleanupNeeded = owner.pending
    if owner.pending {
      owner.pending = false
      let cleaned = run Effect.result(disposition(owner.file.handle.raw, 10))
      match move cleaned {
        Result<(), FileError>.Success { value } => ()
        Result<(), FileError>.Failure { error } => {
          cleanupError = Option<FileError>.some(move error)
          residual = Intrinsic.replace(owner.name, Bytes.make())
        }
      }
    }
    let handle = Intrinsic.replace(owner.file.handle, Handle { raw: Pointer.null<u8>() })
    let closed = run Effect.result(close(move handle, 10))
    match move closed {
      Result<(), FileError>.Success { value } => ()
      Result<(), FileError>.Failure { error } => {
        // Disposition removes the namespace entry at close. A failed close leaves cleanup unproven.
        if cleanupNeeded && Option<FileError>.isNone(&cleanupError) {
          cleanupError = Option<FileError>.some(copyError(&error))
          residual = Intrinsic.replace(owner.name, Bytes.make())
        }
        remember(&mut primary, Result<(), FileError>.Failure { error: move error })
      }
    }
    let parent = Intrinsic.replace(owner.parent.handle, Handle { raw: Pointer.null<u8>() })
    remember(&mut primary, run Effect.result(close(move parent, 10)))
    match move primary {
      Option<FileError>.Some { value } => {
        fail AtomicWriteError { published: owner.published, cause: move value, cleanupError: move cleanupError, stagingName: move residual }
      }
      Option<FileError>.None => ()
    }
  }
  /// Returns the kind and length after resolving links inside the root, with a 40-link limit.
  /// Relative targets cannot leave the root. Absolute targets must match the native root spelling
  /// except drive-letter case; outside targets and unknown tags fail with `Unsupported`.
  pub effect fn inspect(root: &[u8], path: &[u8], outputKind: &mut i32, length: &mut usize, operation: i32) -> () ! FileError {
    let handle = run openPath(root, path, 128, 1, 0, -1, operation)
    let mut value = StandardInfo { allocation: 0, length: 0, links: 0, deletePending: 0, directory: 0 }
    let mut io = emptyIo()
    run checked(unsafe NtQueryInformationFile(handle.raw, Pointer.fromMutRef(&mut io), unsafe Intrinsic.pointerReinterpret<*mut StandardInfo, *mut u8>(Pointer.fromMutRef(&mut value)), 24, 5), operation)
    outputKind.* = 0
    length.* = 0
    if value.directory != 0 { outputKind.* = 1 } else {
      if value.length < 0 { return run logical(operation, FileSystem.tooLarge()) }
      length.* = i64.toUsize(value.length)
    }
    return run close(move handle, operation)
  }
  /// Creates a directory (0), removes a file or link (1), or removes an empty directory (2).
  /// Intermediate links resolve inside the root. Removal acts on the opened final object, preserves
  /// read-only attributes, and never follows a final link.
  /// Unsupported reparse tags or filesystem semantics produce `FileError` with reason `Unsupported`.
  pub effect fn command(root: &[u8], path: &[u8], command: i32, operation: i32) -> () ! FileError {
    if command < 0 || command > 2 { return run logical(operation, FileSystem.unsupported()) }
    let parent = run parentOf(root, path, operation)
    if List<u16>.length(&parent.name) == 0 { return run logical(operation, FileSystem.wrongType()) }
    if command == 0 {
      let directory = run openAt(parent.handle.raw, List<u16>.asSlice(&parent.name), 128, 2, 1, operation)
      run close(move directory, operation)
      return run close(move parent.handle, operation)
    }
    let handle = run openAt(parent.handle.raw, List<u16>.asSlice(&parent.name), 65664, 1, 0, operation)
    let value = run attributes(handle.raw, operation)
    let kind = run entryKind(&value, operation)
    if (command == 1 && kind == 1) || (command == 2 && kind != 1) { return run logical(operation, FileSystem.wrongType()) }
    run disposition(handle.raw, operation)
    run close(move handle, operation)
    return run close(move parent.handle, operation)
  }
  /// Opens a directory for counted UTF-16 enumeration, resolving at most 40 links inside the root.
  /// Relative targets cannot leave the root. Absolute targets must match the native root spelling
  /// except drive-letter case; outside targets and unknown tags fail with `Unsupported`.
  pub effect fn openDirectory(root: &[u8], path: &[u8], operation: i32) -> DirectoryHandle ! FileError {
    let handle = run openPath(root, path, 129, 1, 1, 1, operation)
    return DirectoryHandle { handle: move handle, pending: Bytes.make(), kind: 0, ended: false }
  }
  /// Copies the next WTF-8 name and kind (file 0, directory 1, link 2), or reports required capacity.
  /// A successful zero-length result means EOF. Unknown tags and malformed records fail with `FileError`.
  pub effect fn next(handle: &mut DirectoryHandle, output: &mut [u8], count: &mut usize, required: &mut usize, outputKind: &mut i32, operation: i32) -> bool ! FileError {
    count.* = 0
    required.* = 0
    while Bytes.length(&handle.pending) == 0 && !handle.ended {
      let mut storage: [u64; 128] = [0; 128]
      let pointer = unsafe Intrinsic.pointerReinterpret<*mut u64, *mut u8>(Pointer.fromMutRef(&mut storage[0]))
      let mut io = emptyIo()
      let status = unsafe NtQueryDirectoryFile(handle.handle.raw, Pointer.null<u8>(), Pointer.null<u8>(), Pointer.null<u8>(), Pointer.fromMutRef(&mut io), pointer, 1024, 60, 1, Pointer.null<UnicodeString>(), 0)
      if status == -2147483642 { handle.ended = true } else {
        run strictStatus(status, operation)
        if io.information < 88 || io.information > 1024 { return run logical(operation, FileSystem.other()) }
        let record = unsafe Pointer.borrowMany(&storage, unsafe Pointer.assumeMany(pointer), io.information)
        let bytes = u32.toUsize(word(record, 60))
        if word(record, 0) != 0 || bytes == 0 || bytes % 2 != 0 || bytes > 510 || bytes > io.information - 88 { return run logical(operation, FileSystem.other()) }
        let mut units: [u16; 255] = [0; 255]
        let mut at: usize = 0
        while at < bytes / 2 {
          units[at] = u8.toU16(record[88 + at * 2]) + u8.toU16(record[89 + at * 2]) * 256
          at = at + 1
        }
        if !(at == 1 && units[0] == 46) && !(at == 2 && units[0] == 46 && units[1] == 46) {
          let value = AttributeTag { attributes: word(record, 56), tag: word(record, 68) }
          handle.kind = run entryKind(&value, operation)
          handle.pending = run encoded(Slice.view(&units, 0, at), operation)
          if !component(Bytes.asSlice(&handle.pending)) { return run logical(operation, FileSystem.invalidPath()) }
        }
      }
    }
    let name = Bytes.asSlice(&handle.pending)
    if output.length < name.length { required.* = name.length
      return false }
    let mut at: usize = 0
    while at < name.length { output[at] = name[at]
      at = at + 1 }
    count.* = name.length
    outputKind.* = handle.kind
    drop name
    Bytes.truncate(&mut handle.pending, 0)
    return true
  }
  /// Creates a unique directory below `path`, or reports required output capacity without creating anything.
  /// Names use `prefix`, a hyphen, and 16 hexadecimal digits. Only name collisions retry, at most 128 times.
  /// Invalid names, unsupported traversal, and native failures produce `FileError`.
  pub effect fn createUnique(root: &[u8], path: &[u8], prefix: &[u8], counter: &mut u64, output: &mut [u8], count: &mut usize, required: &mut usize, operation: i32) -> bool ! FileError {
    count.* = 0
    required.* = 0
    if !component(prefix) { return run logical(operation, FileSystem.invalidPath()) }
    let prefixUnits = run wide(prefix, operation)
    if List<u16>.length(&prefixUnits) > 238 { return run logical(operation, FileSystem.tooLarge()) }
    let length = prefix.length + 17
    if output.length < length { required.* = length
      return false }
    let directory = run openPath(root, path, 128, 1, 1, 1, operation)
    let mut at: usize = 0
    while at < prefix.length { output[at] = prefix[at]
      at = at + 1 }
    output[prefix.length] = 45
    let digits = b"0123456789abcdef"
    let mut attempts = 0
    while attempts < 128 {
      let mut candidate = nextCounter(&mut counter)
      let mut remaining: usize = 16
      while remaining > 0 {
        remaining = remaining - 1
        output[prefix.length + 1 + remaining] = digits[u64.toUsize(candidate % 16)]
        candidate = candidate / 16
      }
      let name = run wide(Slice.view(&output, 0, length), operation)
      let created = run Effect.result(openAt(directory.raw, List<u16>.asSlice(&name), 128, 2, 1, operation))
      match move created {
        Result<Handle, FileError>.Success { value } => {
          run close(move value, operation)
          run close(move directory, operation)
          count.* = length
          return true
        }
        Result<Handle, FileError>.Failure { error } => {
          if error.reason.code != 1 { fail move error }
        }
      }
      attempts = attempts + 1
    }
    return run logical(operation, FileSystem.alreadyExists())
  }
  /// Fails with `Unsupported`; no Windows directory-durability primitive is established for this provider.
  pub effect fn syncDirectory(root: &[u8], path: &[u8]) -> () ! FileError {
    return run logical(12, FileSystem.unsupported())
  }
  /// Closes the owned file exactly once. A native close failure produces `FileError`.
  pub effect fn closeFile(value: FileHandle, operation: FileOperation) -> () ! FileError {
    return run close(move value.handle, operation.code)
  }
  /// Closes the owned directory exactly once. A native close failure produces `FileError`.
  pub effect fn closeDirectory(value: DirectoryHandle, operation: FileOperation) -> () ! FileError {
    return run close(move value.handle, operation.code)
  }
}
}
