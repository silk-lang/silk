//! Lossless conversion between Windows UTF-16 code units and canonical WTF-8 bytes.
//!
//! # When to use
//! Use `Wtf8.encode` for raw host values and `Wtf8.decodeBytes` for their inverse. Lone surrogates
//! remain bytes. Use `String.fromUtf8` separately when a caller needs valid Unicode text.
//!
//! @category Windows platform

import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.option { Option }
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.usize
import silk.text.format { Debug, Format, Formatter }
import silk.io.writer { Writer, WriterError }

/// A malformed or noncanonical WTF-8 byte sequence.
pub struct InvalidWtf8 {}

impl Debug for InvalidWtf8 {
  /// Writes `InvalidWtf8`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return run Format.debugFields(self, "InvalidWtf8", &mut formatter)
  }
}

/// One decoded code point, including a possible lone surrogate, and the next byte offset.
pub struct Wtf8Point {
  /// The code point, from 0 through 0x10ffff, including lone surrogates.
  pub value: u32,
  /// The byte offset immediately after the code point.
  pub end: usize,
}

/// Conversion of arbitrary UTF-16 code units to canonical WTF-8 bytes, without replacement characters.
pub struct Wtf8 {}

impl Wtf8 {
  /// Returns canonical WTF-8 bytes for `units`. Pairs become one scalar; lone surrogates survive.
  ///
  /// # Details
  ///
  /// NUL is preserved. Host APIs that use NUL terminators must reject embedded NUL separately.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the output cannot be allocated.
  pub effect fn encode(units: &[u16]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    let mut output = Bytes.make()
    let mut at: usize = 0
    while at < units.length {
      let mut value = u16.toU32(units[at])
      at = at + 1
      if value >= 55296 && value <= 56319 && at < units.length {
        let low = u16.toU32(units[at])
        if low >= 56320 && low <= 57343 {
          value = 65536 + (value - 55296) * 1024 + low - 56320
          at = at + 1
        }
      }
      if value < 128 {
        run Bytes.append(&mut output, &[u32.toU8(value)])
      } else if value < 2048 {
        run Bytes.append(&mut output, &[u32.toU8(192 + value / 64)])
        run Bytes.append(&mut output, &[u32.toU8(128 + value % 64)])
      } else if value < 65536 {
        run Bytes.append(&mut output, &[u32.toU8(224 + value / 4096)])
        run Bytes.append(&mut output, &[u32.toU8(128 + value / 64 % 64)])
        run Bytes.append(&mut output, &[u32.toU8(128 + value % 64)])
      } else {
        run Bytes.append(&mut output, &[u32.toU8(240 + value / 262144)])
        run Bytes.append(&mut output, &[u32.toU8(128 + value / 4096 % 64)])
        run Bytes.append(&mut output, &[u32.toU8(128 + value / 64 % 64)])
        run Bytes.append(&mut output, &[u32.toU8(128 + value % 64)])
      }
    }
    return move output
  }

  /// Decodes one canonical WTF-8 code point at `at`, or returns an absent option for invalid input.
  ///
  /// # Details
  ///
  /// An absent result also indicates the end of input. Callers start at zero and advance to `end`.
  /// Overlong encodings, values above 0x10ffff, and separately encoded adjacent surrogate pairs are rejected.
  /// Lone surrogates and NUL are accepted. This operation does not allocate.
  pub fn pointBytes(bytes: &[u8], at: usize) -> Option<Wtf8Point> {
    if at >= bytes.length { return Option<Wtf8Point>.none() }
    let first = bytes[at]
    let mut count: usize = 1
    let mut value = u8.toU32(first)
    let mut minimum: u32 = 0
    if first >= 194 && first <= 223 {
      count = 2
      minimum = 128
      value = value - 192
    } else if first >= 224 && first <= 239 {
      count = 3
      minimum = 2048
      value = value - 224
    } else if first >= 240 && first <= 244 {
      count = 4
      minimum = 65536
      value = value - 240
    } else if first >= 128 {
      return Option<Wtf8Point>.none()
    }
    if count > bytes.length - at { return Option<Wtf8Point>.none() }
    let mut offset: usize = 1
    while offset < count {
      let byte = bytes[at + offset]
      if byte < 128 || byte > 191 { return Option<Wtf8Point>.none() }
      value = value * 64 + u8.toU32(byte - 128)
      offset = offset + 1
    }
    if value < minimum || value > 1114111 { return Option<Wtf8Point>.none() }
    let end = at + count
    // A separately encoded low surrogate after a high surrogate is not canonical WTF-8.
    if value >= 55296 && value <= 56319 && bytes.length - end >= 3 {
      if bytes[end] == 237 && bytes[end + 1] >= 176 && bytes[end + 1] <= 191
        && bytes[end + 2] >= 128 && bytes[end + 2] <= 191 {
        return Option<Wtf8Point>.none()
      }
    }
    return Option<Wtf8Point>.some(Wtf8Point { value: value, end: end })
  }

  /// Returns the UTF-16 code units of canonical WTF-8 bytes, preserving lone surrogates and NUL.
  ///
  /// # Errors
  ///
  /// - `InvalidWtf8` for malformed bytes or separately encoded adjacent high and low surrogates.
  /// - `OutOfMemoryError` if the output cannot be allocated.
  pub effect fn decodeBytes(bytes: &[u8]) -> List<u16> ! InvalidWtf8 | OutOfMemoryError ? &mut Allocator {
    let mut output = List<u16>.make()
    let mut at: usize = 0
    while at < bytes.length {
      let point = match move Wtf8.pointBytes(bytes, at) {
        Option<Wtf8Point>.Some { value } => move value
        Option<Wtf8Point>.None => { fail InvalidWtf8 {} }
      }
      if point.value < 65536 {
        run List<u16>.append(&mut output, u32.toU16(point.value))
      } else {
        run List<u16>.append(&mut output, u32.toU16(55296 + (point.value - 65536) / 1024))
        run List<u16>.append(&mut output, u32.toU16(56320 + (point.value - 65536) % 1024))
      }
      at = point.end
    }
    return move output
  }
}
