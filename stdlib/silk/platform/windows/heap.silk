//! Process-heap storage for the Windows runtime and the system allocator.
//!
//! # When to use
//! Use `Allocator.systemAllocatorProvider` for owned application storage. `WindowsHeap` supplies
//! raw runtime storage and adopted allocations without a C runtime.
//!
//! @category Windows platform

static if Intrinsic.targetOperatingSystem() == "windows" && Intrinsic.targetArchitecture() == "x86_64" && Intrinsic.targetAbi() == "msvc" && Intrinsic.profileText("libc") == "system" {
  import silk.mem.pointer { Pointer }
  import silk.mem.layout { Layout }
  import silk.mem.allocator { OutOfMemoryError }
  import silk.core.option { Option }
  import silk.num.usize

  unsafe extern "C" fn GetProcessHeap() -> ?*mut u8
  unsafe extern "C" fn HeapAlloc(heap: ?*mut u8, flags: u32, size: usize) -> ?*mut u8
  unsafe extern "C" fn HeapFree(heap: ?*mut u8, flags: u32, memory: ?*mut u8) -> i32

  /// Storage from the process heap, with no C runtime dependency.
  pub struct WindowsHeap {}

  impl WindowsHeap {
    /// Returns uninitialized storage aligned to 16 bytes, or null on failure. A zero size allocates one byte.
    ///
    /// # Gotchas
    ///
    /// Release a successful result exactly once with `WindowsHeap.release`, after all access ends.
    pub fn acquire(size: usize) -> ?*mut u8 {
      let mut count = size
      if count == 0 { count = 1 }
      let heap = unsafe GetProcessHeap()
      if Pointer.isNull(heap) { return Pointer.null<u8>() }
      return unsafe HeapAlloc(heap, 0, count)
    }

    /// Releases storage from `WindowsHeap.acquire`. Null does nothing.
    ///
    /// # Gotchas
    ///
    /// `memory` must be null or an unreleased result from `WindowsHeap.acquire`. No access can remain.
    pub unsafe fn release(memory: ?*mut u8) -> () {
      if !Pointer.isNull(memory) {
        let freed = unsafe HeapFree(unsafe GetProcessHeap(), 0, memory)
        if freed == 0 { Intrinsic.trap("Windows heap release failed") }
      }
      return ()
    }

    /// Returns owned storage for `layout`, including alignments greater than 16 bytes.
    ///
    /// # Errors
    ///
    /// - `OutOfMemoryError` if alignment is invalid, size arithmetic overflows, or the heap refuses storage.
    pub effect fn allocate(layout: Layout) -> Intrinsic.Allocation ! OutOfMemoryError {
      if layout.alignment == 0 || (layout.alignment & (layout.alignment - 1)) != 0 {
        fail OutOfMemoryError {}
      }
      let padding = layout.alignment - 1
      let mut size = layout.bytes
      if size == 0 { size = 1 }
      if size > usize.MAX - padding { fail OutOfMemoryError {} }
      let raw = WindowsHeap.acquire(size + padding)
      let base = match move Pointer.nonNullMut(raw) {
        Option<*mut u8>.Some { value } => value
        Option<*mut u8>.None => { fail OutOfMemoryError {} }
      }
      let remainder = Pointer.address(base) % layout.alignment
      let mut offset: usize = 0
      if remainder != 0 { offset = layout.alignment - remainder }
      let aligned = unsafe Pointer.atMut(unsafe Pointer.assumeManyMut(base), offset)
      let reclaim: extern "C" fn(?*mut u8) -> () = releaseAllocation
      return unsafe Intrinsic.allocationAdopt(aligned, move layout, reclaim, raw)
    }
  }

  export "C" fn releaseAllocation(memory: ?*mut u8) -> () as "silk_windows_heap_release" {
    unsafe WindowsHeap.release(memory)
  }
}
