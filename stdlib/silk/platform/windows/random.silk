//! Secure Windows random bytes without a C runtime.
//!
//! # When to use
//! The native `OsRandom` provider calls [`WindowsRandom.fillBytes`]. Applications use the portable
//! `Random` service so tests can provide a deterministic source.
//!
//! @category Windows platform

static if Intrinsic.targetOperatingSystem() == "windows" && Intrinsic.targetArchitecture() == "x86_64" && Intrinsic.targetAbi() == "msvc" && Intrinsic.profileText("libc") == "system" {
  import silk.mem.pointer { Pointer }

  @foreign(noCapture: ("buffer",))
  unsafe extern "C" fn ProcessPrng(buffer: ?[*]mut u8, count: usize) -> i32

  /// Secure randomness from Windows' `bcryptprimitives.dll`. No provider state is retained.
  pub struct WindowsRandom {}
  impl WindowsRandom {
    /// Fills the entire buffer using `ProcessPrng`. Empty input makes no host call.
    /// A failed call traps; callers must not use any partially written bytes after failure.
    pub effect fn fillBytes(output: &mut [u8]) -> () {
      let length = output.length
      if length == 0 { return () }
      if unsafe ProcessPrng(Pointer.fromMutSlice(move output), length) == 0 {
        Intrinsic.trap("WindowsRandom.fillBytes: ProcessPrng failed")
      }
      return ()
    }
  }
}
