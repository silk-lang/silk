//! Scoped ownership of a Windows Winsock initialization reference.

import silk.core.ownership {Drop}
import silk.core.result {Result}
import silk.mem.pointer {Pointer}

@foreign(noCapture: ("data",))
unsafe extern "C" fn WSAStartup(version: u16, data: ?[*]mut u64) -> i32
unsafe extern "C" fn WSACleanup() -> i32

/// One successful Winsock 2.2 initialization, released when dropped.
/// Keep the session alive until all sockets and address lists created under it are closed.
pub struct WinsockSession {}

impl Drop for WinsockSession {
  fn drop(self: &mut WinsockSession) -> () { let ignored = unsafe WSACleanup() }
}

impl WinsockSession {
  /// Acquires a Winsock 2.2 reference or returns WSAStartup's direct error code.
  /// Each successful call owns its own reference; concurrent providers do not share mutable state.
  pub fn make() -> Result<WinsockSession, i32> {
    // WSADATA is 408 bytes, aligned to 8, on Win64. No field outlives WSAStartup.
    let mut data: [u64; 51] = [0; 51]
    let status = unsafe WSAStartup(514, Pointer.fromMutSlice(&mut data))
    if status != 0 { return Result<WinsockSession, i32>.failResult(status) }
    return Result<WinsockSession, i32>.succeed(WinsockSession {})
  }
}
