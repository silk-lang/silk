//! Windows wall and monotonic clocks without a C runtime.
//!
//! # When to use
//! Native clock providers use [`WindowsClock`] for reads, resolution, and blocking waits.
//! Application code supplies `OsSystemClock` or `OsMonotonicClock` through the portable services.
//!
//! @category Windows platform

static if Intrinsic.targetOperatingSystem() == "windows" && Intrinsic.targetArchitecture() == "x86_64" && Intrinsic.targetAbi() == "msvc" && Intrinsic.profileText("libc") == "system" {
  import silk.platform.windows.time { WindowsTime }
  import silk.system.system_clock { Instant, SystemClock }
  import silk.mem.pointer { Pointer }
  import silk.num.u32

  extern "C" struct FileTime { low: u32, high: u32 }
  @foreign(noCapture: ("value",))
  unsafe extern "C" fn QueryPerformanceCounter(value: *mut i64) -> i32
  @foreign(noCapture: ("value",))
  unsafe extern "C" fn QueryPerformanceFrequency(value: *mut i64) -> i32
  @foreign(noCapture: ("value",))
  unsafe extern "C" fn GetSystemTimePreciseAsFileTime(value: *mut FileTime) -> ()
  unsafe extern "C" fn Sleep(milliseconds: u32) -> ()

  fn frequency() -> i64 {
    let mut value: i64 = 0
    if unsafe QueryPerformanceFrequency(Pointer.fromMutRef(&mut value)) == 0 || value <= 0 {
      Intrinsic.trap("WindowsClock: performance frequency failed")
    }
    return value
  }

  /// Windows clock operations. Failed or invalid counter reads trap; waits block the host thread.
  /// Wall time uses the Unix epoch and can move backwards. Monotonic time includes system suspend.
  pub struct WindowsClock {}
  impl WindowsClock {
    /// Returns QPC monotonic time if `monotonic` is true, otherwise precise Unix wall time.
    /// Failed or negative counter reads and nonpositive frequencies trap.
    pub effect fn now(monotonic: bool) -> Instant {
      if monotonic {
        let rate = frequency()
        let mut ticks: i64 = 0
        if unsafe QueryPerformanceCounter(Pointer.fromMutRef(&mut ticks)) == 0 {
          Intrinsic.trap("WindowsClock.now: performance counter failed")
        }
        return WindowsTime.counter(ticks, rate)
      }
      let mut value = FileTime { low: 0, high: 0 }
      unsafe GetSystemTimePreciseAsFileTime(Pointer.fromMutRef(&mut value))
      return WindowsTime.fileTime(u32.toU64(value.high) * 4294967296 + u32.toU64(value.low))
    }

    /// Returns nominal resolution in nanoseconds: a QPC tick rounded up, or FILETIME's 100 ns unit.
    /// This describes representation granularity, not accuracy. A failed frequency query traps.
    pub effect fn resolution(monotonic: bool) -> u64 {
      if monotonic { return WindowsTime.counterResolution(frequency()) }
      return 100
    }

    /// Blocks the host thread until the nonnegative monotonic deadline is reached.
    ///
    /// # Details
    ///
    /// Each finite `Sleep` rounds the remaining duration up to milliseconds. After waking, the
    /// clock is reread against the original deadline, including after an early wake or a capped
    /// timeout. No fiber cancellation or scheduling is provided. Negative deadlines trap.
    pub effect fn waitUntil(when: Instant) -> () {
      let seconds = SystemClock.seconds(&when)
      let nanoseconds = SystemClock.nanoseconds(&when)
      if seconds < 0 { Intrinsic.trap("WindowsClock.waitUntil: negative deadline") }
      while true {
        let now = run WindowsClock.now(true)
        let nowSeconds = SystemClock.seconds(&now)
        let nowNanoseconds = SystemClock.nanoseconds(&now)
        if nowSeconds > seconds || (nowSeconds == seconds && nowNanoseconds >= nanoseconds) { return () }
        let mut remainingSeconds = seconds - nowSeconds
        let mut remainingNanoseconds = nanoseconds - nowNanoseconds
        if remainingNanoseconds < 0 {
          remainingSeconds = remainingSeconds - 1
          remainingNanoseconds = remainingNanoseconds + 1000000000
        }
        unsafe Sleep(WindowsTime.sleepMilliseconds(remainingSeconds, remainingNanoseconds))
      }
      return ()
    }
  }
}
