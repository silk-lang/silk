//! Windows host paths represented in an explicit machine-wide path namespace.
//!
//! # When to use
//!
//! Use [`WindowsPath`] at compiler and process host boundaries. Drive paths map to `/C:/...`
//! and UNC paths to `/UNC/server/share/...`. These names are separate from a confined
//! `OsFileSystem` provider's `/`, which always denotes that provider's chosen root.
//!
//! @category Windows platform

import silk.collections.bytes { Bytes }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.platform.windows.wtf8 { Wtf8, Wtf8Point }
import silk.system.filesystem { Path, FileSystem, FileError }
import silk.text.string { String }

/// Conversion between absolute Windows host names and machine-wide portable paths.
///
/// # Details
///
/// Case and canonical WTF-8 bytes are preserved. Converting a path does not access the host,
/// resolve links, or assert confinement. Relative paths and device namespaces are refused.
pub struct WindowsPath {}

fn letter(value: u8) -> bool { return (value >= 65 && value <= 90) || (value >= 97 && value <= 122) }
fn separator(value: u8) -> bool { return value == 47 || value == 92 }
fn prefix(value: &[u8], wanted: &[u8]) -> bool {
  if value.length < wanted.length { return false }
  let mut at: usize = 0
  while at < wanted.length {
    if value[at] != wanted[at] { return false }
    at = at + 1
  }
  return true
}
fn canonical(value: &[u8]) -> bool {
  let mut at: usize = 0
  while at < value.length {
    if value[at] == 0 { return false }
    at = match move Wtf8.pointBytes(value, at) {
      Option<Wtf8Point>.Some {value: point} => point.end
      Option<Wtf8Point>.None => { return false }
    }
  }
  return true
}
effect fn invalid() -> never ! FileError {
  fail FileSystem.error(FileSystem.pathOperation(), FileSystem.invalidPath())
}

// End of the volume prefix. `/` cannot select a Windows volume implicitly.
fn rootEnd(value: &[u8]) -> usize {
  if value.length >= 3 && value[0] == 47 && letter(value[1]) && value[2] == 58 {
    if value.length == 3 || value[3] == 47 { return 3 }
    return 0
  }
  if !prefix(value, b"/UNC/") { return 0 }
  let mut at: usize = 5
  while at < value.length && value[at] != 47 { at = at + 1 }
  if at == 5 || at == value.length { return 0 }
  let share = at + 1
  at = share
  while at < value.length && value[at] != 47 { at = at + 1 }
  if at == share { return 0 }
  return at
}

impl WindowsPath {
  /// Resolves a text host path against an absolute machine path, without accessing files.
  ///
  /// # Details
  ///
  /// Both separators are accepted. Absolute drive, UNC, and machine paths select their volume;
  /// a single leading separator selects the base volume. Relative paths stay on the base volume.
  /// `.` and `..` are normalized, and a parent component cannot cross the volume root.
  ///
  /// # Errors
  ///
  /// - `FileError` with `InvalidPath` for malformed paths, device names, drive-relative names,
  ///   empty interior components, or a parent component above the volume root.
  /// - `OutOfMemoryError` if the path cannot be allocated.
  pub effect fn resolve(base: &Path, argument: string) -> Path
  ! FileError | OutOfMemoryError ? &mut Allocator {
    return run WindowsPath.resolveBytes(base, String.utf8Bytes(argument))
  }

  /// Resolves canonical WTF-8 host bytes against an absolute machine path.
  ///
  /// # Details
  ///
  /// Accepts absolute drive, UNC, machine, and relative paths. Both separators are accepted
  /// except inside an extended `\\\\?\\` name, where only backslashes are separators.
  /// Case and lone surrogates are preserved. `.` and `..` are normalized within one volume.
  /// A single leading separator selects the base volume; drive-relative names are refused.
  ///
  /// # Errors
  ///
  /// - `FileError` with `InvalidPath` for malformed WTF-8, NUL, device paths, empty interior
  ///   components, invalid volume names, or a parent component above the volume root.
  /// - `OutOfMemoryError` if the result cannot be allocated.
  pub effect fn resolveBytes(base: &Path, argument: &[u8]) -> Path
  ! FileError | OutOfMemoryError ? &mut Allocator {
    let baseBytes = Path.rawBytes(base)
    let baseRoot = rootEnd(baseBytes)
    if baseRoot == 0 || !canonical(baseBytes) || !canonical(argument) { return run invalid() }
    let mut normalized = Bytes.make()
    let mut input = argument
    let mut extended = false
    if prefix(input, b"\\\\?\\") {
      input = Slice.view(input, 4, input.length - 4)
      extended = true
    }
    if input.length >= 2 && letter(input[0]) && input[1] == 58 {
      if input.length < 3 || !separator(input[2]) { return run invalid() }
      run Bytes.append(&mut normalized, b"/")
    } else {
      if extended {
        if !prefix(input, b"UNC\\") { return run invalid() }
        run Bytes.append(&mut normalized, b"/UNC/")
        input = Slice.view(input, 4, input.length - 4)
      } else {
        if input.length >= 2 && separator(input[0]) && separator(input[1]) {
          run Bytes.append(&mut normalized, b"/UNC/")
          input = Slice.view(input, 2, input.length - 2)
        }
      }
    }
    let mut at: usize = 0
    while at < input.length {
      let mut unit = input[at]
      if extended && unit == 47 { return run invalid() }
      if unit == 92 { unit = 47 }
      run Bytes.append(&mut normalized, &[unit])
      at = at + 1
    }
    let written = Bytes.asSlice(&normalized)
    let selectedRoot = rootEnd(written)
    let mut root = Slice.view(baseBytes, 0, baseRoot)
    let mut localBase = Slice.view(baseBytes, baseRoot, baseBytes.length - baseRoot)
    let mut relative = written
    if selectedRoot != 0 {
      root = Slice.view(written, 0, selectedRoot)
      localBase = b"/"
      relative = Slice.view(written, selectedRoot, written.length - selectedRoot)
    } else {
      if written.length > 0 && written[0] == 47 { localBase = b"/" }
    }
    if localBase.length == 0 { localBase = b"/" }
    if relative.length > 0 && relative[0] == 47 {
      relative = Slice.view(relative, 1, relative.length - 1)
    }
    let local = run Path.fromBytes(localBase)
    let resolved = run Path.resolveBytes(&local, relative)
    let mut joined = run Bytes.copy(root)
    if !Path.isRoot(&resolved) { run Bytes.append(&mut joined, Path.rawBytes(&resolved)) }
    let answer = run Path.fromBytes(Bytes.asSlice(&joined))
    // Validate volume/component restrictions even when the input was already machine spelling.
    drop run WindowsPath.toNativeBytes(&answer)
    return move answer
  }

  /// Converts an absolute Windows text path to `/C:/...` or `/UNC/server/share/...`.
  ///
  /// # Errors
  ///
  /// - `FileError` with `InvalidPath` for relative paths, device namespaces, or non-normalized components.
  /// - `OutOfMemoryError` if the path cannot be allocated.
  pub effect fn fromNative(value: string) -> Path ! FileError | OutOfMemoryError ? &mut Allocator {
    return run WindowsPath.fromNativeBytes(String.utf8Bytes(value))
  }

  /// Converts canonical WTF-8 Windows host bytes to a machine-wide portable path.
  ///
  /// # Details
  ///
  /// Accepts absolute drive and UNC names, including `\\?\C:\...` and `\\?\UNC\server\share\...`.
  /// Normal names accept either separator. Extended names accept only backslashes. A trailing
  /// separator is removed. Case, trailing component dots/spaces, and lone surrogates are preserved.
  /// A drive root is represented by `/C:`, and a share root by `/UNC/server/share`.
  ///
  /// # Errors
  ///
  /// - `FileError` with `InvalidPath` for malformed WTF-8, NUL, relative/device paths, empty
  ///   components, `.` or `..`, or colons outside the drive prefix.
  /// - `OutOfMemoryError` if the path cannot be allocated.
  pub effect fn fromNativeBytes(value: &[u8]) -> Path ! FileError | OutOfMemoryError ? &mut Allocator {
    if !canonical(value) { return run invalid() }
    let mut input = value
    let mut extended = false
    if prefix(input, b"\\\\?\\") {
      input = Slice.view(input, 4, input.length - 4)
      extended = true
    }
    let mut result = Bytes.make()
    let mut at: usize = 0
    if input.length >= 3 && letter(input[0]) && input[1] == 58 && separator(input[2]) {
      if extended && input[2] != 92 { return run invalid() }
      run Bytes.append(&mut result, b"/")
      run Bytes.append(&mut result, Slice.view(input, 0, 2))
      at = 2
    } else {
      if extended {
        if !prefix(input, b"UNC\\") { return run invalid() }
        at = 4
      } else {
        if input.length < 2 || !separator(input[0]) || !separator(input[1]) { return run invalid() }
        at = 2
      }
      run Bytes.append(&mut result, b"/UNC/")
    }
    let mut end = input.length
    if end > at && separator(input[end - 1]) { end = end - 1 }
    while at < end {
      let mut unit = input[at]
      if extended && unit == 47 { return run invalid() }
      if unit == 58 { return run invalid() }
      if separator(unit) { unit = 47 }
      run Bytes.append(&mut result, &[unit])
      at = at + 1
    }
    let path = run Path.fromBytes(Bytes.asSlice(&result))
    if rootEnd(Path.rawBytes(&path)) == 0 { return run invalid() }
    return move path
  }

  /// Returns an extended Windows host name as canonical WTF-8, without a NUL terminator.
  ///
  /// # Details
  ///
  /// `/C:/...` becomes `\\?\C:\...`; `/UNC/server/share/...` becomes `\\?\UNC\server\share\...`.
  /// The extended prefix preserves trailing dots/spaces and avoids Win32's legacy path-length
  /// normalization. Other arguments to a process must not be passed through this conversion.
  ///
  /// # Errors
  ///
  /// - `FileError` with `InvalidPath` if the path lacks a volume, has invalid WTF-8, or contains
  ///   a backslash or a colon outside its drive prefix.
  /// - `OutOfMemoryError` if the host name cannot be allocated.
  pub effect fn toNativeBytes(path: &Path) -> Bytes ! FileError | OutOfMemoryError ? &mut Allocator {
    let value = Path.rawBytes(path)
    let root = rootEnd(value)
    if root == 0 || !canonical(value) { return run invalid() }
    let drive = root == 3
    let mut output = run Bytes.copy(b"\\\\?\\")
    let mut at: usize = 1
    while at < value.length {
      let mut unit = value[at]
      if unit == 92 || (unit == 58 && !(drive && at == 2)) { return run invalid() }
      if unit == 47 { unit = 92 }
      run Bytes.append(&mut output, &[unit])
      at = at + 1
    }
    if drive && value.length == 3 { run Bytes.append(&mut output, b"\\") }
    return move output
  }
}
