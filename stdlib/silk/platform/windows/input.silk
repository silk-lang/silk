//! Raw-byte reads from the Windows standard-input handle.
//!
//! # When to use
//! `OsStandardInput` uses [`WindowsInput.read`] beneath the portable `StandardInput` service.
//! Console reads use the active console input code page. Redirected files and pipes preserve bytes.
//!
//! @category Windows platform

static if Intrinsic.targetOperatingSystem() == "windows" && Intrinsic.targetArchitecture() == "x86_64" && Intrinsic.targetAbi() == "msvc" && Intrinsic.profileText("libc") == "system" {
  import silk.mem.pointer { Pointer }
  import silk.num.usize
  import silk.num.u32

  unsafe extern "C" fn GetStdHandle(kind: u32) -> ?*mut u8
  unsafe extern "C" fn GetLastError() -> u32
  @foreign(noCapture: ("buffer", "count", "overlapped"))
  unsafe extern "C" fn ReadFile(handle: ?*mut u8, buffer: ?[*]mut u8, requested: u32, count: *mut u32, overlapped: ?*mut u8) -> i32

  /// Unbuffered standard-input reads. The process retains ownership of its pointer-width handle.
  pub struct WindowsInput {}
  impl WindowsInput {
    /// Reads once into the buffer and returns success, capturing a Win32 error on failure.
    ///
    /// # Details
    ///
    /// Empty buffers make no host call. Each other read resolves the current standard handle and
    /// requests at most 4,294,967,295 bytes. Successful zero-byte reads and broken pipes report
    /// zero bytes with no error, including `ERROR_HANDLE_EOF`. A message-pipe partial read reports its received prefix. The
    /// count is zero on failure, and error is zero for an invalid host count. The handle is never
    /// closed. Console bytes use the active input code page; no text decoding is performed.
    pub effect fn read(buffer: &mut [u8], count: &mut usize, error: &mut i32) -> bool {
      count.* = 0
      error.* = 0
      if buffer.length == 0 { return true }
      let handle = unsafe GetStdHandle(4294967286)
      if Pointer.isNull(handle) { error.* = 6
        return false }
      if Pointer.address(handle) == usize.MAX { error.* = 6
        return false }
      let mut requested = buffer.length
      if requested > 4294967295 { requested = 4294967295 }
      let mut received: u32 = 0
      let status = unsafe ReadFile(handle, Pointer.fromMutSlice(move buffer), usize.toU32(requested), Pointer.fromMutRef(&mut received), Pointer.null<u8>())
      if status == 0 {
        let code = unsafe GetLastError()
        if code == 109 || code == 38 { return true }
        if code != 234 || received == 0 { error.* = u32.wrappingToI32(code)
          return false }
      }
      let length = u32.toUsize(received)
      if length > requested { return false }
      count.* = length
      return true
    }
  }
}
