fn emptyStat() -> Stat { return Stat { dev: 0, ino: 0, mode: 0, nlink: 0, uid: 0, gid: 0, rdev: 0, pad1: 0, size: 0, blksize: 0, pad2: 0, blocks: 0, atime: Timespec { seconds: 0, nanoseconds: 0 }, mtime: Timespec { seconds: 0, nanoseconds: 0 }, ctime: Timespec { seconds: 0, nanoseconds: 0 }, reserved: [0, 0] } }
fn statMode(value: &Stat) -> u32 { return value.mode }
const CREATE: i32 = 64
const EXCLUSIVE: i32 = 128
const NONBLOCK: i32 = 2048
const DIRECTORY: i32 = 16384
const SEARCH: i32 = 2097152
const NOFOLLOW: i32 = 32768
const CLOEXEC: i32 = 524288
const NOFOLLOW_STAT: i32 = 256
const REMOVE_DIRECTORY: i32 = 512
const NOT_EMPTY: i32 = 39
const OVERFLOW: i32 = 75
const NAME_TOO_LONG: i32 = 36
const LOOP: i32 = 40
const NAME_OFFSET: usize = 19
@foreign(noCapture: ("path",))
unsafe extern "C" fn mkdirat(fd: i32, path: ?[*]const u8, mode: u32) -> i32
fn fileMode() -> u32 { return 438 }
fn directoryMode() -> u32 { return 448 }
}
@foreign(noCapture: ("path",))
unsafe extern "C" fn open(path: ?[*]const u8, flags: i32, ...) -> i32
@foreign(noCapture: ("path",))
unsafe extern "C" fn openat(fd: i32, path: ?[*]const u8, flags: i32, ...) -> i32
unsafe extern "C" fn close(fd: i32) -> i32
@foreign(noCapture: ("buffer",))
unsafe extern "C" fn read(fd: i32, buffer: ?[*]mut u8, count: usize) -> isize
@foreign(noCapture: ("buffer",))
unsafe extern "C" fn write(fd: i32, buffer: ?[*]const u8, count: usize) -> isize
@foreign(noCapture: ("value",))
unsafe extern "C" fn fstat(fd: i32, value: *mut Stat) -> i32
@foreign(noCapture: ("path", "value"))
unsafe extern "C" fn fstatat(fd: i32, path: ?[*]const u8, value: *mut Stat, flags: i32) -> i32
@foreign(noCapture: ("path", "buffer"))
unsafe extern "C" fn readlinkat(fd: i32, path: ?[*]const u8, buffer: ?[*]mut u8, size: usize) -> isize
unsafe extern "C" fn ftruncate(fd: i32, length: i64) -> i32
