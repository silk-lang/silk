//! The system calls for files and directories, for the native `FileSystem` provider.
//!
//! # When to use
//! `silk.system.filesystem_native` uses [`NativeFileSystem`]. Application code uses the `FileSystem` effect
//! from `silk.system.filesystem` instead.
//!
//! # Details
//! Each operation starts at the root directory and opens each part of the path relative to its
//! parent. A symbolic link below the root resolves inside the root: an absolute target starts
//! again at the root, and `..` never goes above it. So a path cannot leave the root. At most 40
//! links resolve in one path. Removing a file and replacing a file act on a final link itself,
//! not its target, and a listing reports a link as a link.
//!
//! [`FileHandle`] and [`DirectoryHandle`] each own one open descriptor. Close them with
//! [`NativeFileSystem.closeFile`] or [`NativeFileSystem.closeDirectory`] to get a close error. A
//! drop also closes them, and keeps an earlier error.
//!
//! An atomic write makes a new file in the same directory with a unique name, then makes it visible
//! at the path. A replace uses `renameat`, which replaces a final symbolic link itself, not its
//! target. A create uses `linkat`, which fails if any entry exists. New files get mode 0666,
//! filtered by the umask. A replace keeps no permissions, owner, extended attributes, or hard links
//! of the old file. A synchronized write calls `fsync` on the new file before it is visible, and on
//! the directory after. This is not `F_FULLFSYNC`, and it does not promise that data survives a
//! power loss.
//!
//! # Errors
//! Each operation fails with `FileError`, with a portable reason and the native error code.
//! `writeFileAtomic` fails with `AtomicWriteError`.
//!
//! # Gotchas
//! - A call that a signal interrupts is made again, except `close`, which is never repeated.
//! - Other processes must not change the temporary files of an atomic write.
//! - The functions exist only on Darwin on aarch64, and Linux with GNU libc on x86_64 or aarch64.
//!
//! @category Native platform

static if (Intrinsic.targetOperatingSystem() == "darwin" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64") && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText("libc") == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
import silk.core.ownership { Drop }
import silk.mem.pointer { Pointer }
import silk.collections.bytes { Bytes }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.core.option { Option }
import silk.collections.slice { Slice }
import silk.system.filesystem { FileSystem, FileError, FileOperation, FileReason, AtomicWriteError }
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.i64
import silk.num.isize
import silk.num.usize

extern "C" struct Timespec {
 seconds: i64,
 nanoseconds: i64,
}
extern "C" struct DirectoryStream {}
static if Intrinsic.targetOperatingSystem() == "darwin" {
extern "C" struct Stat {
  dev: i32,
  mode: u16,
  nlink: u16,
  ino: u64,
  uid: u32,
  gid: u32,
  rdev: i32,
  atime: Timespec,
  mtime: Timespec,
  ctime: Timespec,
  birthtime: Timespec,
  size: i64,
  blocks: i64,
  blksize: i32,
  flags: u32,
  gen: u32,
  lspare: i32,
  qspare: [i64; 2],
}
fn emptyStat() -> Stat { return Stat { dev: 0, mode: 0, nlink: 0, ino: 0, uid: 0, gid: 0, rdev: 0, atime: Timespec { seconds: 0, nanoseconds: 0 }, mtime: Timespec { seconds: 0, nanoseconds: 0 }, ctime: Timespec { seconds: 0, nanoseconds: 0 }, birthtime: Timespec { seconds: 0, nanoseconds: 0 }, size: 0, blocks: 0, blksize: 0, flags: 0, gen: 0, lspare: 0, qspare: [0, 0] } }
fn statMode(value: &Stat) -> u32 { return u16.toU32(value.mode) }
const CREATE: i32 = 512
const EXCLUSIVE: i32 = 2048
const NONBLOCK: i32 = 4
const DIRECTORY: i32 = 1048576
const SEARCH: i32 = 1073741824
const NOFOLLOW: i32 = 256
const CLOEXEC: i32 = 16777216
const NOFOLLOW_STAT: i32 = 32
const REMOVE_DIRECTORY: i32 = 128
const NOT_EMPTY: i32 = 66
const OVERFLOW: i32 = 84
const NAME_TOO_LONG: i32 = 63
const LOOP: i32 = 62
const NAME_OFFSET: usize = 21
@foreign(noCapture: ("path",))
unsafe extern "C" fn mkdirat(fd: i32, path: ?[*]const u8, mode: u16) -> i32
fn fileMode() -> u16 { return 438 }
fn directoryMode() -> u16 { return 448 }
} else static if Intrinsic.targetArchitecture() == "x86_64" {
extern "C" struct Stat {
