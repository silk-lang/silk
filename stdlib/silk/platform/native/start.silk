//! The default start code of a native program: it calls your `main` and returns its status.
//!
//! # When to use
//! The compiler uses this runtime for native programs on Darwin on x86_64 or aarch64, and Linux with GNU libc
//! on x86_64 or aarch64. You do not call it.
//!
//! # Details
//! `main` can return one of these:
//! - `i32`, the exit status.
//! - `()`, for status 0.
//! - An effect that returns `i32` or `()`, and that can require `&mut HostInput`. The runtime gives
//!   an `OsHostInput` with the arguments and the environment of the process. Each error of the
//!   effect must implement `Debug`.
//!
//! Other requirements, such as `&mut Allocator`, must be provided by your code. An unhandled error
//! prints a report to standard error and returns status 1. The report has at most 4096 bytes and 32
//! frames, and ends with an `unhandled value:` line that holds the error's `Debug` form, cut to
//! 1024 bytes.
//!
//! # Gotchas
//! - There is no scheduler or event loop. If `main` parks, the program fails with status 1. Make
//!   your own execution for code that parks.
//! - A trap does not unwind, so cleanup code does not run.
//! - A stack overflow on the main thread prints `fatal trap: stack overflow`, and another invalid
//!   memory access prints `fatal trap: segmentation fault`, without frames. The process then ends
//!   with the signal, as it would without the report.
//!
//! @category Native platform

static if (Intrinsic.targetOperatingSystem() == "darwin" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64") && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText(
  "libc",
) == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText(
  "libc",
) == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
  import Intrinsic.application

  import silk.core.effect {Effect}

  import silk.platform.native.diagnostics {NativeDiagnostics}

  import silk.platform.native.report {ErrorForm, NativeReport}

  import silk.num.usize

  import silk.system.host_input {HostInput, HostInputError}

  import silk.platform.native.host_input {NativeHostInput}

  import silk.system.host_input_native {OsHostInput}

  import silk.text.format {Debug}
  struct Application<T> {}
  interface EntryResult<T> {
    fn code(value: T, inputs: &mut OsHostInput) -> i32
  }
  impl EntryResult<i32> for Application<i32> {
    fn code(value: i32, inputs: &mut OsHostInput) -> i32 {
      return value
    }
  }
  impl EntryResult<()> for Application<()> {
    fn code(value: (), inputs: &mut OsHostInput) -> i32 {
      return 0
    }
  }
  // Reports an unhandled error, then writes the line `unhandled value: ` with its `Debug` form.
  effect<'env> fn failed<E: Debug + 'env, 'env>(error: E) -> i32 {
    let value = run ErrorForm.capture<E>(&error)
    // The observer requires the error to be dropped before it reports it.
    drop error
    let status = usize.toI32(Intrinsic.observeUnhandled())
    let written = run ErrorForm.write(&value, 2)
    return status
  }
  effect fn succeeded(value: ()) -> i32 {
    return 0
  }
  effect fn succeededStatus(value: i32) -> i32 {
    return value
  }
  impl<'env, E: Debug> EntryResult<Effect<'env; () ! E>> for Application<Effect<'env; () ! E>> {
    fn code(value: Effect<'env; () ! E>, inputs: &mut OsHostInput) -> i32 {
      let computation = Effect.flatMap(move value, succeeded)
      return run Effect.catchAll(move computation, failed)
    }
  }
  impl<'env, E: Debug> EntryResult<Effect<'env; () ! E ? &mut HostInput>> for Application<
    Effect<'env; () ! E ? &mut HostInput>,
  > {
    fn code(value: Effect<'env; () ! E ? &mut HostInput>, inputs: &mut OsHostInput) -> i32 {
      let supplied = Effect.provideMut<HostInput>(move value, move inputs)
      let computation = Effect.flatMap(move supplied, succeeded)
      return run Effect.catchAll(move computation, failed)
    }
  }
  impl<'env, E: Debug> EntryResult<Effect<'env; i32 ! E>> for Application<Effect<'env; i32 ! E>> {
    fn code(value: Effect<'env; i32 ! E>, inputs: &mut OsHostInput) -> i32 {
      let computation = Effect.flatMap(move value, succeededStatus)
      return run Effect.catchAll(move computation, failed)
    }
  }
  impl<'env, E: Debug> EntryResult<Effect<'env; i32 ! E ? &mut HostInput>> for Application<
    Effect<'env; i32 ! E ? &mut HostInput>,
  > {
    fn code(value: Effect<'env; i32 ! E ? &mut HostInput>, inputs: &mut OsHostInput) -> i32 {
      let supplied = Effect.provideMut<HostInput>(move value, move inputs)
      let computation = Effect.flatMap(move supplied, succeededStatus)
      return run Effect.catchAll(move computation, failed)
    }
  }
  fn select<T>(value: &T) -> Application<T> {
    return Application<T> {}
  }
  fn adapt<T, P: EntryResult<T>>(value: T, provider: P, inputs: &mut OsHostInput) -> i32 {
    return EntryResult<T>.code(move value, move inputs)
  }

  import silk.mem.allocator {Allocator, OutOfMemoryError}

  import silk.concurrency.execution {Execution}
  struct EntrySuspended {}
  struct Status {
    complete: bool,
    code: i32,
  }
  fn ready(state: &()) -> () {}
  fn complete(state: &mut Status, code: i32) -> () {
    state.complete = true
    state.code = code
  }
  fn suspended(state: &mut Status, execution: Intrinsic.Execution<i32>) -> () {
    drop execution
    return ()
  }
  fn invokeApplication(inputs: OsHostInput) -> i32 {
    let mut host = move inputs
    let value = application.main()
    let provider = select(&value)
    return adapt(move value, move provider, &mut host)
  }
  fn invoke<F: fn<'static>(OsHostInput) -> i32 + Intrinsic.NonParking>(body: F, inputs: OsHostInput) -> i32 {
    return body(move inputs)
  }
  effect fn observedApplication(inputs: OsHostInput) -> i32 {
    let observer = run NativeDiagnostics.make(NativeReport.make(2, 4096, 32), 64)
    return run NativeDiagnostics.observe(
      move observer,
      effect {
        return invoke(invokeApplication, move inputs)
      },
    )
  }
  import silk.platform.native.descriptor {NativeDescriptor, write}

  import silk.mem.pointer {Pointer}

  import silk.core.option {Option}

  import silk.text.string {String}

  import silk.num.u64

  // `stack_t`, `struct sigaction` and the `siginfo_t` fault address differ between Darwin and GNU
  // libc.
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    extern "C" struct SignalStack {
      base: ?*mut u8,
      size: usize,
      flags: i32,
    }
    extern "C" struct SignalAction {
      handler: extern "C" fn(i32, ?*mut u8, ?*mut u8) -> (),
      mask: u32,
      flags: i32,
    }
    // SA_ONSTACK | SA_RESETHAND | SA_SIGINFO
    const FAULT_FLAGS: i32 = 69
    const FAULT_ADDRESS_OFFSET: usize = 24
    fn faultAction() -> SignalAction {
      return SignalAction {handler: silkNativeFault, mask: 0, flags: FAULT_FLAGS}
    }
  } else {
    extern "C" struct SignalStack {
      base: ?*mut u8,
      flags: i32,
      size: usize,
    }
    extern "C" struct SignalAction {
      handler: extern "C" fn(i32, ?*mut u8, ?*mut u8) -> (),
      mask: [u64; 16],
      flags: i32,
      restorer: ?*mut u8,
    }
    // SA_ONSTACK | SA_RESETHAND | SA_SIGINFO
    const FAULT_FLAGS: i32 = -2013265916
    const FAULT_ADDRESS_OFFSET: usize = 16
    fn faultAction() -> SignalAction {
      return SignalAction {handler: silkNativeFault, mask: [0; 16], flags: FAULT_FLAGS, restorer: Pointer.null<u8>()}
    }
  }

  unsafe extern "C" fn malloc(size: usize) -> ?*mut u8
  unsafe extern "C" fn sigaltstack(stack: ?*const SignalStack, previous: ?*mut SignalStack) -> i32
  unsafe extern "C" fn sigaction(signal: i32, action: ?*const SignalAction, previous: ?*mut SignalAction) -> i32
  unsafe extern "C" fn getrlimit(resource: i32, limit: *mut [u64; 2]) -> i32

  // The signal stack holds the fault handler's frame. The two words just past its end record the
  // main stack's top address and size limit, which the handler finds through `sigaltstack`.
  const FAULT_STACK_BYTES: usize = 65536
  const FAULT_HEADER_BYTES: usize = 16

  // Reads the word `offset` bytes past `base`.
  unsafe fn wordAt(base: *mut u8, offset: usize) -> usize {
    let many = unsafe Pointer.assumeManyMut<u8>(base)
    let at = unsafe Pointer.atMut<u8>(many, offset)
    return unsafe Pointer.read<usize>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut usize>(at))
  }

  unsafe fn putWordAt(base: *mut u8, offset: usize, value: usize) -> () {
    let many = unsafe Pointer.assumeManyMut<u8>(base)
    let at = unsafe Pointer.atMut<u8>(many, offset)
    return unsafe Pointer.write<usize>(unsafe Intrinsic.pointerReinterpret<*mut u8, *mut usize>(at), value)
  }

  fn writeReport(text: string) -> () {
    let bytes = String.utf8Bytes(text)
    let written = unsafe write(2, Pointer.fromSlice<u8>(bytes), bytes.length)
    drop written
    return ()
  }

  // The `SIGSEGV` and `SIGBUS` handler. It runs on the signal stack, names the fault, and returns;
  // the handler was reset, so the fault happens again and ends the process with the signal.
  export "C" fn silkNativeFault(signal: i32, information: ?*mut u8, context: ?*mut u8) -> () {
    let mut stack = SignalStack {base: Pointer.null<u8>(), size: 0, flags: 0}
    let queried = unsafe sigaltstack(Pointer.null<SignalStack>(), Pointer.fromMutRef(&mut stack))
    let mut overflow = false
    if queried == 0 {
      if let Option<*mut u8>.Some {value: base} = Pointer.nonNullMut<u8>(stack.base) {
        if let Option<*mut u8>.Some {value: details} = Pointer.nonNullMut<u8>(information) {
          let address = unsafe wordAt(details, FAULT_ADDRESS_OFFSET)
          let top = unsafe wordAt(base, FAULT_STACK_BYTES)
          let limit = unsafe wordAt(base, FAULT_STACK_BYTES + 8)
          // The guard page sits just below the stack's limit.
          overflow = address < top && top - address <= usize.saturatingAdd(limit, FAULT_STACK_BYTES)
        }
      }
    }
    if overflow {
      writeReport("fatal trap: stack overflow\n")
    } else {
      writeReport("fatal trap: segmentation fault\n")
    }
    return ()
  }

  // Installs the fault handler on a signal stack of its own, so a main stack that is out of space
  // still gets a report. `top` is an address near the top of the main stack. Without memory or a
  // signal stack the program runs without the report.
  fn installFaultReport(top: usize) -> () {
    let memory = unsafe malloc(FAULT_HEADER_BYTES + FAULT_STACK_BYTES)
    let base = match move Pointer.nonNullMut<u8>(memory) {
      Option<*mut u8>.Some {value} => value
      Option<*mut u8>.None => { return () }
    }
    let mut limit: [u64; 2] = [0, 0]
    let mut size = usize.MAX
    // RLIMIT_STACK is 3 on Darwin and GNU/Linux.
    if unsafe getrlimit(3, Pointer.fromMutRef(&mut limit)) == 0 {
      size = match move u64.checkedToUsize(limit[0]) {
        Option<usize>.Some {value} => value
        Option<usize>.None => usize.MAX
      }
    }
    unsafe putWordAt(base, FAULT_STACK_BYTES, top)
    unsafe putWordAt(base, FAULT_STACK_BYTES + 8, size)
    let stack = SignalStack {base: memory, size: FAULT_STACK_BYTES, flags: 0}
    if unsafe sigaltstack(Pointer.fromRef(&stack), Pointer.null<SignalStack>()) != 0 { return () }
    let action = faultAction()
    // SIGSEGV is 11 on both; SIGBUS is 7 on GNU/Linux and 10 on Darwin.
    let segmentation = unsafe sigaction(11, Pointer.fromRef(&action), Pointer.null<SignalAction>())
    static if Intrinsic.targetOperatingSystem() == "darwin" {
      let bus = unsafe sigaction(10, Pointer.fromRef(&action), Pointer.null<SignalAction>())
      drop bus
    } else {
      let bus = unsafe sigaction(7, Pointer.fromRef(&action), Pointer.null<SignalAction>())
      drop bus
    }
    drop segmentation
    return ()
  }

  effect fn start(argc: i32, argv: [*]const ?[*]const u8) -> i32
  ! HostInputError | OutOfMemoryError | EntrySuspended {
    let mut allocator = Allocator.systemAllocatorProvider()
    let inputs = run unsafe NativeHostInput.captureProcess(argc, argv)
      |> Effect.provideMut<Allocator>(&mut allocator)
    let provider = OsHostInput.make(move inputs)
    let execution = run Execution.make(observedApplication(move provider), (), ready)
      |> Effect.provideMut<Allocator>(&mut allocator)
    let mut status = Status {complete: false, code: 0}
    run Execution.drive(move execution, &mut status, complete, suspended)
    if status.complete == false {
      fail EntrySuspended {}
    }
    return status.code
  }
  // The start code's own errors are reported without their value.
  effect<'env> fn startFailed<E: 'env, 'env>(error: E) -> i32 {
    drop error
    return usize.toI32(Intrinsic.observeUnhandled())
  }
  effect fn startup(argc: i32, argv: [*]const ?[*]const u8) -> i32 {
    return run Effect.catchAll(start(argc, argv), startFailed)
  }
  /// The C `main` function of the program. It captures the arguments, calls the application, and
  /// returns its status.
  ///
  /// If the start code fails, for example when it cannot copy the arguments, it returns 1.
  export "C" fn enter(argc: i32, argv: [*]const ?[*]const u8) -> i32 as "main" {
    let marker: u8 = 0
    installFaultReport(Pointer.address<u8>(Pointer.fromRef(&marker)))
    let observer = run NativeDiagnostics.make(NativeReport.make(2, 4096, 32), 0)
    return run NativeDiagnostics.observe(move observer, startup(argc, argv))
  }
}
