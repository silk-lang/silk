//! A minimal start code for a native program whose `main` is an `i32` effect that requires `&mut
//! HostInput`.
//!
//! # When to use
//! Select this runtime explicitly when you want no execution and no diagnostics. The default
//! runtime, `silk.platform.native.start`, accepts more kinds of `main` and prints a report for an unhandled
//! error.
//!
//! # Details
//! The runtime copies the arguments and the environment, gives them to `main` as an `OsHostInput`,
//! and releases them after `main` returns. Your code provides every other requirement, such as the
//! `Allocator` that `HostInput` lookups need. An error during start or an unhandled error of `main`
//! returns status 1, without a report.
//!
//! # Gotchas
//! - `main` must be an effect that returns `i32` and requires `&mut HostInput`. A plain `i32`,
//!   `()`, other requirements, or parking need another runtime.
//! - A trap does not unwind, so cleanup code does not run.
//! - The runtime exists on Windows x86_64, Darwin x86_64 or aarch64, and GNU/Linux x86_64 or aarch64.
//!
//! @category Native platform

static if Intrinsic.targetOperatingSystem() == "windows" && Intrinsic.targetArchitecture() == "x86_64" && Intrinsic.targetAbi() == "msvc" && Intrinsic.profileText("libc") == "system" {
  import Intrinsic.application
  import silk.core.effect {Effect}
  import silk.mem.allocator {Allocator, OutOfMemoryError}
  import silk.system.host_input {HostInput, HostInputError}
  import silk.platform.windows.host_input {WindowsHostInput}
  import silk.num.i32
  unsafe extern "C" fn ExitProcess(status: u32) -> ()
  effect<'env> fn failed<E: 'env, 'env>(error: E) -> i32 {
    drop error
    return 1
  }
  fn invokeApplication(inputs: WindowsHostInput) -> i32 {
    let mut host = move inputs
    return run Effect.catchAll(application.main() |> Effect.provideMut<HostInput>(&mut host), failed)
  }
  fn invoke<F: fn<'static>(WindowsHostInput) -> i32 + Intrinsic.NonParking>(body: F, inputs: WindowsHostInput) -> i32 {
    return body(move inputs)
  }
  effect fn start() -> i32 ! HostInputError | OutOfMemoryError {
    let mut allocator = Allocator.systemAllocatorProvider()
    let inputs = run WindowsHostInput.capture() |> Effect.provideMut<Allocator>(&mut allocator)
    return invoke(invokeApplication, move inputs)
  }
  /// Runs a synchronous HostInput application and exits with its status; unhandled errors exit 1.
  export "C" fn enter() -> () as "mainCRTStartup" {
    let status = run Effect.catchAll(start(), failed)
    unsafe ExitProcess(i32.wrappingToU32(status))
    Intrinsic.trap("ExitProcess returned")
  }
}

static if (Intrinsic.targetOperatingSystem() == "darwin" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64") && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText(
  "libc",
) == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText(
  "libc",
) == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
  import Intrinsic.application
  import silk.mem.allocator {Allocator, OutOfMemoryError}
  import silk.core.effect {Effect}
  import silk.system.host_input {HostInput, HostInputError}
  import silk.platform.native.host_input {NativeHostInput}
  import silk.system.host_input_native {OsHostInput}
  effect<'env> fn failed<E: 'env, 'env>(error: E) -> i32 {
    drop error
    return 1
  }
  fn invokeApplication(inputs: OsHostInput) -> i32 {
    let mut host = move inputs
    let computation = application.main()
    let supplied = Effect.provideMut<HostInput>(move computation, &mut host)
    return run Effect.catchAll(move supplied, failed)
  }
  fn invoke<F: fn<'static>(OsHostInput) -> i32 + Intrinsic.NonParking>(body: F, inputs: OsHostInput) -> i32 {
    return body(move inputs)
  }
  effect fn start(argc: i32, argv: [*]const ?[*]const u8) -> i32 ! HostInputError | OutOfMemoryError {
    let mut allocator = Allocator.systemAllocatorProvider()
    let inputs = run unsafe NativeHostInput.captureProcess(argc, argv)
      |> Effect.provideMut<Allocator>(&mut allocator)
    let provider = OsHostInput.make(move inputs)
    return invoke(invokeApplication, move provider)
  }
  /// The C `main` function of the program. It returns the status of the application, or 1 after an
  /// error.
  export "C" fn enter(argc: i32, argv: [*]const ?[*]const u8) -> i32 as "main" {
    return run Effect.catchAll(start(argc, argv), failed)
  }
}
