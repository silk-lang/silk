//! Writes the report of an unhandled error or a trap to a descriptor, with fixed limits.
//!
//! # When to use
//! The native and wasm runtimes (`silk.platform.native.start`, `silk.platform.wasi.start`,
//! `silk.platform.wasm.start` and `silk.platform.native.diagnostics`) use [`NativeReport`] to print
//! an unhandled error and its call path to standard error, and [`ErrorForm`] to print the error's
//! value after it. Use them in a custom runtime. On `wasm32-unknown-unknown`, which has no
//! descriptors, every report goes to the module's report buffer, which the host reads through the
//! exported `silk_report` and `silk_report_length`.
//!
//! # Details
//! A report is lines of text:
//! ```text
//! unhandled error: app.ConfigError
//!   at app/main.silk:12:5
//!   at app.load
//! ```
//! Each fragment is written only if it fits in the byte limit. When a limit is reached, the report
//! is incomplete, and later calls write nothing. It does not allocate.
//!
//! # Gotchas
//! - The report does not close the descriptor.
//! - A write can fail after part of a fragment was written.
//! - A report does not stop a trap or run cleanup.
//!
//! # Examples
//! ## Report an error to standard error
//! ```silk
//! import silk.platform.native.report { NativeReport }
//!
//! pub fn main() -> i32 {
//!   // Write to standard error, with at most 512 bytes and 4 caller frames.
//!   let mut report = NativeReport.make(2, 512, 4)
//!
//!   // Each call returns false if the report is incomplete.
//!   let head = run report.unhandled("app.ConfigError", "app/main.silk:12:5")
//!   let load = run report.frame("app.load")
//!   let start = run report.frame("app.main")
//!   if !head || !load || !start || !report.succeeded() {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Native platform

static if (Intrinsic.targetOperatingSystem() == "windows" && Intrinsic.targetArchitecture() == "x86_64" && Intrinsic.targetAbi() == "msvc" && Intrinsic.profileText("libc") == "system") || Intrinsic.targetArchitecture() == "wasm32" || (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText("libc") == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
  static if Intrinsic.targetOperatingSystem() == "wasi" {
    import silk.platform.wasi.descriptor { WasiDescriptor as NativeDescriptor }
  } else static if Intrinsic.targetOperatingSystem() == "windows" {
    import silk.platform.windows.console { WindowsConsole as NativeDescriptor }
  } else static if Intrinsic.targetArchitecture() == "wasm32" {
    import silk.mem.pointer { Pointer }

    // Appends to the report buffer of the linked runtime, which the host reads through the
    // exported `silk_report` and `silk_report_length`. Returns nonzero when all bytes fit.
    unsafe extern "C" fn silk_wasm_report_write(bytes: ?[*]const u8, length: usize) -> i32

    // A wasm32 module without WASI has no descriptors: every report goes to the runtime's buffer.
    struct NativeDescriptor {}

    impl NativeDescriptor {
      effect fn writeAll(fd: i32, buffer: &[u8], error: &mut i32) -> bool {
        error.* = 0
        return unsafe silk_wasm_report_write(Pointer.fromSlice(buffer), buffer.length) != 0
      }
    }
  } else {
    import silk.platform.native.descriptor { NativeDescriptor }
  }
  import silk.core.effect { Effect }
  import silk.collections.slice { Slice }
  import silk.text.format { Debug, Format }
  import silk.text.string { String }
  import silk.num.usize
  import silk.io.writer { Writer, WriterError }

  /// One report: its descriptor, its remaining byte and frame limits, and whether it is complete.
  ///
  /// # When to use
  /// The native and WASI runtimes (`silk.platform.native.start`, `silk.platform.wasi.start` and
  /// `silk.platform.native.diagnostics`) use it to print an unhandled error and its call path to
  /// standard error. Use it in a custom runtime.
  ///
  /// # Details
  /// Each fragment is written only if it fits in the byte limit. When a limit is reached, the
  /// report is incomplete, and later calls write nothing. It does not allocate.
  ///
  /// # Gotchas
  /// - The report does not close the descriptor.
  /// - A write can fail after part of a fragment was written.
  /// - A report does not stop a trap or run cleanup.
  pub struct NativeReport {
    descriptor: i32,
    byteLimit: usize,
    frameLimit: usize,
    indent: string<'static>,
    remainingBytes: usize,
    remainingFrames: usize,
    complete: bool,
  }

  effect fn text(self: &mut NativeReport, value: string) -> bool {
    if self.complete == false { return false }
    let bytes = String.utf8Bytes(value)
    if bytes.length > self.remainingBytes { self.complete = false
      return false }
    self.remainingBytes = self.remainingBytes - bytes.length
    let mut error = 0
    let written = run NativeDescriptor.writeAll(self.descriptor, bytes, &mut error)
    if written == false { self.complete = false }
    return written
  }

  effect fn lineStart(self: &mut NativeReport) -> bool {
    let indent = self.indent
    return run text(&mut self, indent)
  }

  effect fn origin(self: &mut NativeReport, value: string) -> bool {
    let bytes = String.utf8Bytes(value)
    if bytes.length == 0 { return self.complete }
    let indent = run lineStart(&mut self)
    let prefix = run text(&mut self, "  at ")
    let label = run text(&mut self, value)
    return run text(&mut self, "\n")
  }

  impl NativeReport {
    /// Returns a report that writes to `fd`, with at most `byteLimit` bytes and `frameLimit` caller
    /// frames. It does not allocate.
    pub fn make(fd: i32, byteLimit: usize, frameLimit: usize) -> NativeReport {
      return NativeReport.indented(fd, byteLimit, frameLimit, "")
    }

    /// Returns a report like [`NativeReport.make`] that starts each line with `indent`. The
    /// indent counts toward the byte limit.
    ///
    /// # When to use
    /// Use it to nest a report under other output, such as a failed test under the test's name.
    pub fn indented(fd: i32, byteLimit: usize, frameLimit: usize, indent: string<'static>) -> NativeReport {
      return NativeReport {
        descriptor: fd,
        byteLimit: byteLimit,
        frameLimit: frameLimit,
        indent: indent,
        remainingBytes: byteLimit,
        remainingFrames: frameLimit,
        complete: true,
      }
    }

    /// Starts a new report on the same descriptor, with the full byte and frame limits again.
    ///
    /// # When to use
    /// Use it when one report writer serves several reports, such as one for each failed test.
    pub fn restart(self: &mut Self) -> () {
      self.remainingBytes = self.byteLimit
      self.remainingFrames = self.frameLimit
      self.complete = true
      return ()
    }

    /// Starts the next part of the same report with the full frame limit again. The byte limit
    /// keeps counting, so a report that ran out of bytes stays incomplete.
    ///
    /// # When to use
    /// Use it when one report has two lists of frames, such as a trap's caller frames and then the
    /// cause the trap happened while handling.
    pub fn resume(self: &mut Self) -> () {
      self.remainingFrames = self.frameLimit
      self.complete = self.remainingBytes > 0
      return ()
    }

    /// Writes `unhandled error: ` with `identity`, then the line ` at ` with `source`. Returns
    /// false if the report is incomplete.
    ///
    /// Call it after the runtime has dropped the error value.
    pub effect fn unhandled(self: &mut Self, identity: string, source: string) -> bool {
      let indent = run lineStart(&mut self)
      let prefix = run text(&mut self, "unhandled error: ")
      let name = run text(&mut self, identity)
      let newline = run text(&mut self, "\n")
      return run origin(&mut self, source)
    }

    /// Writes `fatal trap: ` with `reason`, then the line ` at ` with `source`. Returns false if
    /// the report is incomplete.
    pub effect fn fatal(self: &mut Self, reason: string, source: string) -> bool {
      let indent = run lineStart(&mut self)
      let prefix = run text(&mut self, "fatal trap: ")
      let name = run text(&mut self, reason)
      let newline = run text(&mut self, "\n")
      return run origin(&mut self, source)
    }

    /// Writes the line ` at ` with the caller `label`. Returns false if the report is incomplete.
    ///
    /// When the frame limit is reached, it writes ` [trace truncated]` one time, and the report
    /// becomes incomplete.
    pub effect fn frame(self: &mut Self, label: string) -> bool {
      if self.complete == false { return false }
      if self.remainingFrames == 0 {
        return run NativeReport.truncate(&mut self)
      }
      self.remainingFrames = self.remainingFrames - 1
      return run origin(&mut self, label)
    }

    /// Writes ` [trace truncated]`, and makes the report incomplete. Later calls write nothing. It
    /// returns false.
    pub effect fn truncate(self: &mut Self) -> bool {
      if self.complete == false { return false }
      let indent = run lineStart(&mut self)
      let marker = run text(&mut self, "  [trace truncated]\n")
      self.complete = false
      return false
    }

    /// Writes `while handling: ` with `identity`, then the line ` at ` with `source`. Use it for an
    /// earlier error that a handler was handling.
    pub effect fn cause(self: &mut Self, identity: string, source: string) -> bool {
      let indent = run lineStart(&mut self)
      let prefix = run text(&mut self, "while handling: ")
      let name = run text(&mut self, identity)
      let newline = run text(&mut self, "\n")
      return run origin(&mut self, source)
    }

    /// Returns whether all fragments were written within the limits.
    pub fn succeeded(self: &Self) -> bool { return self.complete }
  }

  /// The `Debug` form of an error, at most 1024 bytes, kept so a runtime can drop the error before
  /// its observer reports it, and print the form after the report.
  ///
  /// # When to use
  /// The native and WASI runtimes use it for the `unhandled value:` line of an unhandled error. Use
  /// it in a custom runtime.
  ///
  /// # Details
  /// A longer form is cut at a character boundary and marked as truncated. It does not allocate.
  pub struct ErrorForm {
    bytes: [u8; 1024],
    length: usize,
    truncated: bool,
  }

  impl Writer for ErrorForm {
    effect fn writeAll(self: &mut Self, bytes: &[u8]) -> () ! WriterError ? &mut Writer {
      if self.truncated { return () }
      let mut index = usize.ZERO
      while index < bytes.length {
        if self.length == 1024 {
          self.truncated = true
          // Leave out the start of a character that does not fit.
          let mut start = self.length
          while start > usize.ZERO && self.length - start < 3 && (self.bytes[start - usize.ONE] & 192) == 128 {
            start = start - usize.ONE
          }
          if start > usize.ZERO && self.bytes[start - usize.ONE] >= 192 {
            let lead = self.bytes[start - usize.ONE]
            let mut needed = usize.ONE + usize.ONE
            if lead >= 224 { needed = needed + usize.ONE }
            if lead >= 240 { needed = needed + usize.ONE }
            if self.length - start + usize.ONE < needed { self.length = start - usize.ONE }
          }
          return ()
        }
        self.bytes[self.length] = bytes[index]
        self.length = self.length + usize.ONE
        index = index + usize.ONE
      }
      return ()
    }
    effect fn flush(self: &mut Self) -> () ! WriterError ? &mut Writer {
      return ()
    }
  }

  effect fn ignoreWriteFailure(error: WriterError) -> () {
    drop error
    return ()
  }

  impl ErrorForm {
    /// Returns the `Debug` form of `error`, cut to 1024 bytes at a character boundary. A form that
    /// fails to format keeps the part written before the failure.
    pub effect fn capture<E: Debug>(error: &E) -> ErrorForm {
      let mut form = ErrorForm {bytes: [0; 1024], length: usize.ZERO, truncated: false}
      let written = Format.debug<E>(error) |> Effect.provideMut<Writer>(&mut form)
      run Effect.catchAll(move written, ignoreWriteFailure)
      return move form
    }

    /// Writes the line `unhandled value: ` with the form to `fd`, and ` [value truncated]` when the
    /// form was cut. Returns false if a write failed.
    ///
    /// # Gotchas
    /// A write can fail after part of the line was written.
    pub effect fn write(self: &Self, fd: i32) -> bool {
      let mut error = 0
      let prefix = run NativeDescriptor.writeAll(fd, b"unhandled value: ", &mut error)
      let form = run NativeDescriptor.writeAll(fd, Slice.view<u8>(&self.bytes, usize.ZERO, self.length), &mut error)
      let mut mark = true
      if self.truncated {
        mark = run NativeDescriptor.writeAll(fd, b" [value truncated]", &mut error)
      }
      let newline = run NativeDescriptor.writeAll(fd, b"\n", &mut error)
      return prefix && form && mark && newline
    }
  }
}
