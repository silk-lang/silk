//! Runs a child process with the system calls, for the native `ChildProcess` provider.
//!
//! # When to use
//! `silk.system.child_process_native` uses [`NativeProcess.execute`]. Application code uses the
//! `ChildProcess` effect from `silk.system.child_process` instead.
//!
//! # Details
//! Each call owns its descriptors, its copies of the request, and its child. If a step fails after
//! the child started, the call stops and waits for the child, closes the descriptors, and then
//! returns the first error.
//!
//! # Gotchas
//! - The calls block the thread.
//! - A trap does not clean up, and does not stop the child.
//!
//! @category Native platform

static if (Intrinsic.targetOperatingSystem() == "darwin" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64") && Intrinsic.profileText(
  "libc",
) == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.profileText("libc") == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
  import silk.core.ownership {Drop}
  import silk.mem.pointer {Pointer}
  import silk.collections.bytes {Bytes}
  import silk.mem.allocator {Allocator, OutOfMemoryError}
  import silk.system.child_process {
    ChildProcess,
    ProcessRequest,
    ProcessOutcome,
    ProcessError,
    ProcessOperation,
    ProcessReason,
  }
  import silk.system.subprocess { SpawnOptions, Stdio, Subprocess, SubprocessError }
  import silk.core.effect { Effect }
  import silk.core.option { Option }
  import silk.num.isize
  import silk.num.i32
  import silk.num.usize
  import silk.num.u8
  unsafe extern "C" fn close(fd: i32) -> i32
  @foreign(noCapture: .("buffer"))
  unsafe extern "C" fn read(fd: i32, buffer: ?[*]mut u8, count: usize) -> isize
  @foreign(noCapture: .("buffer"))
  unsafe extern "C" fn write(fd: i32, buffer: ?[*]const u8, count: usize) -> isize
  @foreign(noCapture: .("status"))
  unsafe extern "C" fn waitpid(pid: i32, status: *mut i32, options: i32) -> i32
  unsafe extern "C" fn kill(pid: i32, signal: i32) -> i32
  extern "C" struct PollFd {
    fd: i32,
    events: i16,
    revents: i16,
  }
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    unsafe extern "C" fn __error() -> *mut i32
    unsafe fn currentError() -> i32 {
      unsafe {
        return Pointer.read<i32>(__error())
      }
    }
    @foreign(noCapture: .("fds"))
    unsafe extern "C" fn poll(fds: [*]mut PollFd, count: u32, timeout: i32) -> i32
    const NOT_IMPLEMENTED: i32 = 78
    const NOT_SUPPORTED: i32 = 45
    const NAME_TOO_LONG: i32 = 63
    const SYMLINK_LOOP: i32 = 62
    const TRY_AGAIN: i32 = 35
  } else {
    unsafe extern "C" fn __errno_location() -> *mut i32
    unsafe fn currentError() -> i32 {
      unsafe {
        return Pointer.read<i32>(__errno_location())
      }
    }
    @foreign(noCapture: .("fds"))
    unsafe extern "C" fn poll(fds: [*]mut PollFd, count: usize, timeout: i32) -> i32
    const NOT_IMPLEMENTED: i32 = 38
    const NOT_SUPPORTED: i32 = 95
    const NAME_TOO_LONG: i32 = 36
    const SYMLINK_LOOP: i32 = 40
    const TRY_AGAIN: i32 = 11
  }
  struct Descriptor {
    fd: i32,
  }
  impl Drop for Descriptor {
    fn drop(self: &mut Descriptor) -> () {
      let fd = Intrinsic.replace(self.fd, -1)
      if fd >= 0 {
        let _ignored = unsafe close(fd)
      }
    }
  }
  struct Child {
    pid: i32,
  }
  impl Drop for Child {
    fn drop(self: &mut Child) -> () {
      let pid = Intrinsic.replace(self.pid, -1)
      if pid > 0 {
        let _ignored = unsafe kill(pid, 9)
        let mut status = 0
        let mut waiting = true
        while waiting {
          let result = unsafe waitpid(pid, Pointer.fromMutRef<i32>(&mut status), 0)
          if result == pid {
            if terminal(status) {
              waiting = false
            }
          } else {
            let error = unsafe currentError()
            if error != 4 {
              waiting = false
            }
          }
        }
      }
    }
  }
  fn reason(code: i32) -> ProcessReason {
    if code == 2 {
      return ChildProcess.notFound()
    }
    if code == 1 || code == 13 {
      return ChildProcess.permissionDenied()
    }
    if code == 22 || code == 20 || code == 21 || code == 7 || code == NAME_TOO_LONG || code == SYMLINK_LOOP {
      return ChildProcess.invalidRequest()
    }
    if code == 12 || code == 28 || code == 24 || code == 23 || code == TRY_AGAIN {
      return ChildProcess.noSpace()
    }
    if code == NOT_IMPLEMENTED || code == NOT_SUPPORTED {
      return ChildProcess.unsupported()
    }
    return ChildProcess.other()
  }
  effect fn reject(operation: ProcessOperation, code: i32) -> never ! ProcessError {
    fail ChildProcess.failureWithCode(move operation, reason(code), code)
  }
  effect fn closeOwned(value: Descriptor, operation: ProcessOperation) -> () ! ProcessError {
    let mut owner = move value
    let fd = Intrinsic.replace(owner.fd, -1)
    let result = unsafe close(fd)
    if result != 0 {
      let error = unsafe currentError()
      return run reject(move operation, error)
    }
  }
  effect fn reap(child: &mut Child) -> i32 ! ProcessError {
    let mut status = 0
    while true {
      let result = unsafe waitpid(child.pid, Pointer.fromMutRef<i32>(&mut status), 0)
      if result == child.pid {
        if terminal(status) {
          child.pid = -1
          return status
        }
      } else {
        let error = unsafe currentError()
        if error != 4 {
          if error == 10 {
            child.pid = -1
          }
          return run reject(ChildProcess.waitOperation(), error)
        }
      }
    }
    return 0
  }
  struct Captures {
    output: Bytes,
    errors: Bytes,
  }
  effect fn receive(descriptor: &mut Descriptor, scratch: &mut Bytes, destination: &mut Bytes) -> ()
  ! ProcessError | OutOfMemoryError
  ? &mut Allocator {
    let view = Bytes.asMutSlice(&mut scratch.*)
    let capacity = view.length
    let pointer = Pointer.fromMutSlice<u8>(move view)
    let transferred = unsafe read(descriptor.fd, pointer, capacity)
    if transferred < 0 {
      let error = unsafe currentError()
      // The parent ends of the pipes are nonblocking, so a read after a spurious wakeup can find
      // no data.
      if error == 4 || error == TRY_AGAIN {
        return
      }
      return run reject(ChildProcess.captureOperation(), error)
    }
    if transferred == 0 {
      let fd = Intrinsic.replace(descriptor.fd, -1)
      return run closeOwned(Descriptor {fd: fd}, ChildProcess.captureOperation())
    }
    let received = isize.toUsize(transferred)
    if received > capacity {
      return run reject(ChildProcess.captureOperation(), 0)
    }
    let bytes = Bytes.asSlice(&scratch.*)
    let mut index: usize = 0
    while index < received {
      let one = [bytes[index]]
      run Bytes.append(&mut destination.*, &one)
      index = index + 1
    }
  }
  effect fn capture(output: &mut Descriptor, errors: &mut Descriptor) -> Captures
  ! ProcessError | OutOfMemoryError
  ? &mut Allocator {
    let mut stdout = Bytes.make()
    let mut stderr = Bytes.make()
    let mut scratch = run Bytes.zeroed(4096)
    while output.fd >= 0 || errors.fd >= 0 {
      let mut watched: [PollFd; 2] = [
        PollFd {fd: output.fd, events: 1, revents: 0},
        PollFd {fd: errors.fd, events: 1, revents: 0},
      ]
      let mut ready = 0
      unsafe {
        let pointer = Intrinsic.pointerRequalify<?[*]mut PollFd, [*]mut PollFd>(
          Pointer.fromMutSlice<PollFd>(&mut watched),
        )
        ready = poll(pointer, 2, -1)
      }
      if ready < 0 {
        let error = unsafe currentError()
        if error != 4 {
          return run reject(ChildProcess.captureOperation(), error)
        }
      } else {
        if output.fd >= 0 && watched[0].revents != 0 {
          run receive(&mut output.*, &mut scratch, &mut stdout)
        }
        if errors.fd >= 0 && watched[1].revents != 0 {
          run receive(&mut errors.*, &mut scratch, &mut stderr)
        }
      }
    }
    return Captures {output: move stdout, errors: move stderr}
  }
  fn terminal(status: i32) -> bool {
    return (status & 127) != 127
  }
  effect fn spawnRejected(error: SubprocessError) -> Subprocess ! ProcessError {
    return run reject(ChildProcess.spawnOperation(), error.code)
  }
  // Takes the parent end of the pipe in `slot`, which `execute` asked for.
  fn pipeOf(child: &mut Subprocess, slot: usize) -> Descriptor {
    return match child.takePipe(slot) {
      Option<i32>.Some { value } => Descriptor { fd: value }
      Option<i32>.None => Descriptor { fd: -1 }
    }
  }
  /// The function that runs a child process with the system calls, for the native `ChildProcess`
  /// provider.
  ///
  /// # When to use
  /// `silk.system.child_process_native` uses [`NativeProcess.execute`]. Application code uses the
  /// `ChildProcess` effect from `silk.system.child_process` instead.
  pub struct NativeProcess {}
  impl NativeProcess {
    /// Starts the program of `request`, waits for it to end, and returns its outcome with all of
    /// its output.
    ///
    /// # Details
    /// The child gets the arguments and the environment of the request, and the working directory
    /// of the request, or of the parent when it is empty. Its standard input is closed. A failure
    /// to start is an error. An exit code that is not 0, and an end by a signal, are outcomes.
    ///
    /// # Gotchas
    /// The call blocks the thread. Do not wait for the child in other code. If a step fails after
    /// the child started, the call stops and waits for the child, closes the descriptors, and then
    /// returns the first error. A trap does not clean up, and does not stop the child.
    pub effect fn execute(request: &ProcessRequest) -> ProcessOutcome
    ! ProcessError | OutOfMemoryError
    ? &mut Allocator {
      let mut options = SpawnOptions.make()
      run options.setStdio(1, Stdio.pipe())
      run options.setStdio(2, Stdio.pipe())
      let mut started = run Effect.catch<SubprocessError>(Subprocess.spawn(request, &options), spawnRejected)
      let mut child = Child { pid: started.pid() }
      let mut output = pipeOf(&mut started, 1)
      let mut errors = pipeOf(&mut started, 2)
      drop started
      let captured = run capture(&mut output, &mut errors)
      let status = run reap(&mut child)
      if (status & 127) == 0 {
        return ChildProcess.exited((status / 256) % 256, move captured.output, move captured.errors)
      }
      return ChildProcess.signaled(status & 127, move captured.output, move captured.errors)
    }
  }
}
