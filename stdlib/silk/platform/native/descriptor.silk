//! Reads and writes on file descriptors that the caller owns, for native providers.
//!
//! # When to use
//! Use [`NativeDescriptor`] to build a native provider, such as `silk.io.writer_native` or
//! `silk.io.standard_input_native`. Application code uses the `Writer` and `StandardInput` effects
//! instead.
//!
//! # Details
//! One system call transfers at most 0x7ffff000 bytes. A call that a signal interrupts is made
//! again. An empty buffer makes no system call. The functions never close the descriptor.
//!
//! # Errors
//! Each function returns `false` on failure and writes the native error code to `error`, or 0 when
//! the system returned a count that is not valid.
//!
//! # Gotchas
//! - The caller keeps the descriptor open and controls access from other threads.
//! - [`NativeDescriptor.writeAll`] and [`NativeDescriptor.writeAllGather`] can fail after part of
//!   the bytes were written.
//! - The module is empty on targets other than Darwin on aarch64, and Linux with GNU libc on x86_64
//!   or aarch64.
//!
//! # Examples
//! ## Make empty transfers
//! ```silk
//! import silk.platform.native.descriptor { NativeDescriptor }
//!
//! pub fn main() -> i32 {
//!   let mut nativeError = 0
//!
//!   // Descriptor 1 is standard output. An empty write makes no system call.
//!   let written = run NativeDescriptor.writeAll(1, b"", &mut nativeError)
//!   if !written || nativeError != 0 {
//!     return 1
//!   }
//!
//!   // A read of zero bytes also makes no system call.
//!   let mut empty: [u8; 0] = []
//!   let mut count: usize = 7
//!   let read = run NativeDescriptor.read(0, &mut empty, &mut count, &mut nativeError)
//!   if !read || count != 0 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Native platform

static if (Intrinsic.targetOperatingSystem() == "darwin" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64") && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText("libc") == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
import silk.mem.pointer { Pointer }
import silk.collections.slice { Slice }
import silk.num.isize
import silk.num.usize

/// One buffer of a vectored write: the C `struct iovec`.
extern "C" struct IoVector {
  base: ?[*]const u8,
  length: usize,
}

/// The C `read` function: reads at most `count` bytes from `fd` into `buffer`.
///
/// # Gotchas
/// `buffer` must have `count` writable bytes during the call. After a negative result, read the
/// error code at once.
@foreign(noCapture: ("buffer",))
pub unsafe extern "C" fn read(fd: i32, buffer: ?[*]mut u8, count: usize) -> isize
/// The C `write` function: writes at most `count` bytes from `buffer` to `fd`.
///
/// # Gotchas
/// `buffer` must have `count` readable bytes during the call. A positive result can be less than
/// `count`. After a negative result, read the error code at once.
@foreign(noCapture: ("buffer",))
pub unsafe extern "C" fn write(fd: i32, buffer: ?[*]const u8, count: usize) -> isize
/// The C `isatty` function: returns 1 when `fd` is a terminal, else 0.
pub unsafe extern "C" fn isatty(fd: i32) -> i32
// Part `index` of a gathered write: `head` first, then each slice of `rest`.
fn part<'a>(head: &'a [u8], rest: &[&'a [u8]], index: usize) -> &'a [u8] {
  if index == 0 { return head }
  return rest[index - 1]
}

fn emptyVectors() -> [IoVector; 8] {
  let nothing: [u8; 0] = []
  let base = Pointer.fromSlice<u8>(&nothing)
  return [
    IoVector { base: base, length: 0 },
    IoVector { base: base, length: 0 },
    IoVector { base: base, length: 0 },
    IoVector { base: base, length: 0 },
    IoVector { base: base, length: 0 },
    IoVector { base: base, length: 0 },
    IoVector { base: base, length: 0 },
    IoVector { base: base, length: 0 },
  ]
}

/// The C `writev` function: writes the `count` buffers of `vectors` to `fd` in order, as one write.
///
/// # Gotchas
/// Each buffer must stay readable during the call. A positive result can be less than the sum of
/// the lengths, and can end inside any buffer. After a negative result, read the error code at
/// once.
@foreign(noCapture: ("vectors",))
unsafe extern "C" fn writev(fd: i32, vectors: ?[*]const IoVector, count: i32) -> isize
static if Intrinsic.targetOperatingSystem() == "darwin" {
  /// Returns the error code slot of the thread on Darwin. Read it at once after a failed call.
  pub unsafe extern "C" fn __error() -> *mut i32
  unsafe fn currentError() -> i32 { unsafe { return Pointer.read<i32>(__error()) } }
} else {
  /// Returns the error code slot of the thread on GNU/Linux. Read it at once after a failed call.
  pub unsafe extern "C" fn __errno_location() -> *mut i32
  unsafe fn currentError() -> i32 { unsafe { return Pointer.read<i32>(__errno_location()) } }
}

/// Safe reads and writes on a descriptor that the caller owns, for native providers.
///
/// # When to use
/// Use it to build a native provider, such as `silk.io.writer_native` or `silk.io.standard_input_native`.
/// Application code uses the `Writer` and `StandardInput` effects instead.
///
/// # Details
/// One system call transfers at most 0x7ffff000 bytes. A call that a signal interrupts is made
/// again. An empty buffer makes no system call. The functions never close the descriptor. Each
/// function returns `false` on failure and writes the native error code to `error`, or 0 when the
/// system returned a count that is not valid.
///
/// # Gotchas
/// - The caller keeps the descriptor open and controls access from other threads.
/// - The type is empty on targets other than Darwin on aarch64, and Linux with GNU libc on x86_64
///   or aarch64.
pub struct NativeDescriptor {}
impl NativeDescriptor {
  /// Reads one time from `fd` into the start of `buffer`, and returns whether it succeeded.
  ///
  /// # Details
  /// On success, `count` is the number of bytes read. Zero means the end of input, or an empty
  /// `buffer`. On failure, `count` is zero and `error` is the native error code, or zero for a
  /// count that is not valid. Bytes after the count are not changed.
  pub effect fn read(fd: i32, buffer: &mut [u8], count: &mut usize, error: &mut i32) -> bool {
    count.* = 0
    error.* = 0
    if buffer.length == 0 { return true }
    let mut requested = buffer.length
    if requested > 2147479552 { requested = 2147479552 }
    let pointer = Pointer.fromMutSlice<u8>(move buffer)
    while true {
      let transferred = unsafe read(fd, pointer, requested)
      if transferred < 0 {
        let code = unsafe currentError()
        if code != 4 {
          error.* = code
          return false
        }
      } else {
        let received = isize.toUsize(transferred)
        if received > requested { return false }
        count.* = received
        return true
      }
    }
    return false
  }

  /// Returns whether `fd`, such as 2 for standard error, is a terminal. A closed descriptor, a
  /// pipe, a file, or a failed query answers false.
  pub effect fn isTerminal(fd: i32) -> bool {
    return unsafe isatty(fd) == 1
  }

  /// Writes all of `buffer` to `fd`, and returns whether it succeeded.
  ///
  /// # Details
  /// It calls `write` until all bytes are written. On failure, `error` is the native error code, or
  /// zero if the system wrote nothing or returned a count that is not valid.
  ///
  /// # Gotchas
  /// Part of `buffer` can be written before a failure. Do not write all of it again without a
  /// check.
  pub effect fn writeAll(fd: i32, buffer: &[u8], error: &mut i32) -> bool {
    error.* = 0
    let mut offset: usize = 0
    while offset < buffer.length {
      let mut requested = buffer.length - offset
      if requested > 2147479552 { requested = 2147479552 }
      let mut transferred: isize = 0
      unsafe {
        let base = Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(Pointer.fromSlice<u8>(buffer))
        let next = Pointer.assumeMany<u8>(Pointer.at<u8>(base, offset))
        transferred = write(fd, next, requested)
      }
      if transferred < 0 {
        let code = unsafe currentError()
        if code != 4 {
          error.* = code
          return false
        }
      } else {
        let written = isize.toUsize(transferred)
        if written == 0 { return false }
        if written > requested { return false }
        offset = offset + written
      }
    }
    return true
  }

  /// Writes all of `head` and then all bytes of each slice of `rest` to `fd`, in order, and returns
  /// whether it succeeded.
  ///
  /// # When to use
  /// Use it to send buffered bytes and new slices together, without first copying the slices into
  /// the buffer. Pass an empty `head` when there is no buffer.
  ///
  /// # Details
  /// Each system call is one `writev` of at most eight non-empty slices and at most 0x7ffff000
  /// bytes. After a partial write, the next call starts at the first byte that was not written.
  /// Empty slices add nothing to a call. A call that a signal interrupts is made again. On failure,
  /// `error` is the native error code, or zero if the system wrote nothing or returned a count that
  /// is not valid.
  ///
  /// # Gotchas
  /// Part of the bytes can be written before a failure. Do not write all of them again without a
  /// check.
  pub effect fn writeAllGather(fd: i32, head: &[u8], rest: &[&[u8]], error: &mut i32) -> bool {
    error.* = 0
    let count = rest.length + 1
    let mut index: usize = 0
    let mut offset: usize = 0
    while true {
      // Skip the parts that are complete or empty.
      while index < count && offset == part(head, rest, index).length {
        index = index + 1
        offset = 0
      }
      if index == count { return true }
      let mut vectors = emptyVectors()
      let mut used: usize = 0
      let mut total: usize = 0
      let mut at = index
      let mut from = offset
      while at < count && used < 8 && total < 2147479552 {
        let source = part(head, rest, at)
        let mut length = source.length - from
        if length > 2147479552 - total { length = 2147479552 - total }
        if length != 0 {
          vectors[used] = IoVector { base: Pointer.fromSlice<u8>(Slice.view<u8>(source, from, length)), length: length }
          used = used + 1
          total = total + length
        }
        at = at + 1
        from = 0
      }
      let transferred = unsafe writev(fd, Pointer.fromSlice<IoVector>(&vectors), usize.toI32(used))
      if transferred < 0 {
        let code = unsafe currentError()
        if code != 4 {
          error.* = code
          return false
        }
      } else {
        let written = isize.toUsize(transferred)
        if written == 0 { return false }
        if written > total { return false }
        // Move past the written bytes, part by part.
        let mut remaining = written
        while remaining != 0 {
          let left = part(head, rest, index).length - offset
          if remaining < left {
            offset = offset + remaining
            remaining = 0
          } else {
            remaining = remaining - left
            index = index + 1
            offset = 0
          }
        }
      }
    }
    return false
  }
}
}
