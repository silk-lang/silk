//! Direct calls to the clocks of the system, for the native clock providers.
//!
//! # When to use
//! `silk.system.system_clock_native` and `silk.system.monotonic_clock_native` use [`NativeClock`]. Application code uses
//! those providers through the `SystemClock` and `MonotonicClock` effects, so a test can replace
//! them.
//!
//! # Details
//! Each read checks the result of the system. [`NativeClock.waitUntil`] keeps the same deadline
//! when a signal interrupts the wait, so the total wait does not grow.
//!
//! # Gotchas
//! - A failed call or a bad result is a trap.
//! - A wait blocks the whole thread. It does not let another fiber run.
//! - A call fails to compile on targets other than WASI, Darwin on aarch64, and Linux with GNU libc on x86_64 or aarch64.
//!
//! # Examples
//! ## Read the clocks
//! ```silk
//! import silk.platform.native.clock { NativeClock }
//! import silk.system.system_clock { SystemClock }
//!
//! pub fn main() -> i32 {
//!   // `true` selects the monotonic clock, `false` the system clock.
//!   let first = run NativeClock.now(true)
//!   let second = run NativeClock.now(true)
//!   if SystemClock.seconds(&second) < SystemClock.seconds(&first) {
//!     return 1
//!   }
//!   let resolution = run NativeClock.resolution(false)
//!   if resolution == 0 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Native platform

static if Intrinsic.targetOperatingSystem() == "wasi" { import silk.platform.wasi.clock {WasiClock} }

import silk.num.i64
import silk.num.u64
import silk.mem.pointer { Pointer }
import silk.system.system_clock { SystemClock, Instant }

extern "C" struct Timespec {
  seconds: i64,
  nanoseconds: i64,
}

unsafe extern "C" fn darwinClockGetTime(clock: u32, value: *mut Timespec) -> i32 as "clock_gettime" with Intrinsic.foreign(noCapture: ("value",))
unsafe extern "C" fn darwinClockGetResolution(clock: u32, value: *mut Timespec) -> i32 as "clock_getres" with Intrinsic.foreign(noCapture: ("value",))
unsafe extern "C" fn nanosleep(request: *const Timespec, remaining: ?*mut Timespec) -> i32 with Intrinsic.foreign(noCapture: ("request", "remaining"))
unsafe extern "C" fn __error() -> *mut i32
unsafe extern "C" fn gnuClockGetTime(clock: i32, value: *mut Timespec) -> i32 as "clock_gettime" with Intrinsic.foreign(noCapture: ("value",))
unsafe extern "C" fn gnuClockGetResolution(clock: i32, value: *mut Timespec) -> i32 as "clock_getres" with Intrinsic.foreign(noCapture: ("value",))
unsafe extern "C" fn clock_nanosleep(clock: i32, flags: i32, request: *const Timespec, remaining: ?*mut Timespec) -> i32 with Intrinsic.foreign(noCapture: ("request", "remaining"))

unsafe fn currentError() -> i32 { unsafe { return Pointer.read<i32>(__error()) } }

unsafe fn clockTime(monotonic: bool, value: *mut Timespec) -> i32 {
  static if Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText("libc") == "system" {
    let mut clock: u32 = 0
    if monotonic { clock = 6 }
    return unsafe darwinClockGetTime(clock, value)
  } else {
    static if Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText("libc") == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64") {
      let mut clock: i32 = 0
      if monotonic { clock = 1 }
      return unsafe gnuClockGetTime(clock, value)
    } else { compileError("NativeClock requires a supported WASI, Darwin or GNU libc profile") }
  }
}

unsafe fn clockResolution(monotonic: bool, value: *mut Timespec) -> i32 {
  static if Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText("libc") == "system" {
    let mut clock: u32 = 0
    if monotonic { clock = 6 }
    return unsafe darwinClockGetResolution(clock, value)
  } else {
    static if Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText("libc") == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64") {
      let mut clock: i32 = 0
      if monotonic { clock = 1 }
      return unsafe gnuClockGetResolution(clock, value)
    } else { compileError("NativeClock requires a supported WASI, Darwin or GNU libc profile") }
  }
}

/// The functions that read the system clocks and wait, for the native clock providers.
///
/// # When to use
/// `silk.system.system_clock_native` and `silk.system.monotonic_clock_native` use it. Application code uses those
/// providers through the `SystemClock` and `MonotonicClock` effects, so a test can replace them.
///
/// # Details
/// Each read checks the result of the system.
///
/// # Gotchas
/// - A failed call or a bad result is a trap.
/// - A wait blocks the whole thread. It does not let another fiber run.
/// - A call fails to compile on targets other than WASI, Darwin on aarch64, and Linux with GNU libc on x86_64 or aarch64.
pub struct NativeClock {}
impl NativeClock {
  /// Returns the time of the monotonic clock if `monotonic` is true, or of the system clock if it
  /// is false.
  ///
  /// A monotonic time is not negative. A failed call or a bad result is a trap.
  pub effect fn now(monotonic: bool) -> Instant {
    static if Intrinsic.targetOperatingSystem() == "wasi" {
      return run WasiClock.now(monotonic)
    } else {
    let mut value = Timespec { seconds: i64.toI64(0), nanoseconds: i64.toI64(0) }
    let status = unsafe clockTime(monotonic, Pointer.fromMutRef(&mut value))
    if status != 0 { Intrinsic.trap("NativeClock.now: the operating system clock call failed") }
    if monotonic && value.seconds < 0 { Intrinsic.trap("NativeClock.now: the monotonic clock reported a negative time") }
    return SystemClock.make(value.seconds, value.nanoseconds)
      }
  }

  /// Returns the resolution of the selected clock, in nanoseconds. It is more than zero. A failed
  /// call or a bad result is a trap.
  pub effect fn resolution(monotonic: bool) -> u64 {
    static if Intrinsic.targetOperatingSystem() == "wasi" {
      return run WasiClock.resolution(monotonic)
    } else {
    let mut value = Timespec { seconds: i64.toI64(0), nanoseconds: i64.toI64(0) }
    let status = unsafe clockResolution(monotonic, Pointer.fromMutRef(&mut value))
    if status != 0 { Intrinsic.trap("NativeClock.resolution: the operating system clock call failed") }
    if value.seconds < 0 || value.nanoseconds < 0 || value.nanoseconds >= 1000000000 { Intrinsic.trap("NativeClock.resolution: the operating system reported an invalid resolution") }
    let billion = u64.toU64(1000000000)
    let seconds = i64.toU64(value.seconds)
    let fraction = i64.toU64(value.nanoseconds)
    if seconds > u64.MAX / billion { Intrinsic.trap("NativeClock.resolution: the resolution does not fit in nanoseconds") }
    let whole = seconds * billion
    if fraction > u64.MAX - whole { Intrinsic.trap("NativeClock.resolution: the resolution does not fit in nanoseconds") }
    let total = whole + fraction
    if total == u64.MIN { Intrinsic.trap("NativeClock.resolution: the operating system reported a zero resolution") }
    return total
      }
  }

  /// Blocks the thread until the monotonic clock reaches `when`.
  ///
  /// # Details
  /// If a signal interrupts the wait, it waits again for the same deadline.
  ///
  /// # Gotchas
  /// A negative deadline or a failed call is a trap. The wait does not let another fiber run.
  pub effect fn waitUntil(when: Instant) -> () {
    static if Intrinsic.targetOperatingSystem() == "wasi" {
      return run WasiClock.waitUntil(move when)
    } else {
    let seconds = SystemClock.seconds(&when)
    let nanoseconds = SystemClock.nanoseconds(&when)
    if seconds < 0 { Intrinsic.trap("NativeClock.waitUntil: the deadline is negative") }
    static if Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText("libc") == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64") {
      let deadline = Timespec { seconds: seconds, nanoseconds: nanoseconds }
      while true {
        let status = unsafe clock_nanosleep(1, 1, Pointer.fromRef(&deadline), Pointer.null<Timespec>())
        if status == 0 { return () }
        if status != 4 { Intrinsic.trap("NativeClock.waitUntil: the operating system sleep call failed") }
      }
    } else {
      static if Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText("libc") == "system" {
        while true {
          let now = run NativeClock.now(true)
          let nowSeconds = SystemClock.seconds(&now)
          let nowNanoseconds = SystemClock.nanoseconds(&now)
          if nowSeconds > seconds || (nowSeconds == seconds && nowNanoseconds >= nanoseconds) { return () }
          let mut remainingSeconds = seconds - nowSeconds
          let mut remainingNanoseconds = nanoseconds - nowNanoseconds
          if remainingNanoseconds < 0 {
            remainingSeconds = remainingSeconds - 1
            remainingNanoseconds = remainingNanoseconds + 1000000000
          }
          let remaining = Timespec { seconds: remainingSeconds, nanoseconds: remainingNanoseconds }
          let status = unsafe nanosleep(Pointer.fromRef(&remaining), Pointer.null<Timespec>())
          if status != 0 {
            if status == -1 {
              let nativeError = unsafe currentError()
              if nativeError != 4 { Intrinsic.trap("NativeClock.waitUntil: the operating system sleep call failed") }
            } else { Intrinsic.trap("NativeClock.waitUntil: the operating system sleep call failed") }
          }
        }
      } else { compileError("NativeClock requires a supported WASI, Darwin or GNU libc profile") }
    }
    return ()
      }
  }
}
