//! Direct calls to the clocks of the system, for the native clock providers.
//!
//! # When to use
//! `silk.system.system_clock_native` and `silk.system.monotonic_clock_native` use [`NativeClock`].
//! Application code uses those providers through the `SystemClock` and `MonotonicClock` effects, so
//! a test can replace them.
//!
//! # Details
//! Each read checks the result of the system. [`NativeClock.waitUntil`] keeps the same deadline
//! when a signal interrupts the wait, so the total wait does not grow.
//!
//! # Gotchas
//! - A failed call or a bad result is a trap.
//! - A wait blocks the whole thread. It does not let another fiber run.
//! - A call fails to compile on targets other than WASI, Windows on x86_64, Darwin on x86_64 or
//!   aarch64, and GNU Linux on x86_64 or aarch64.
//!
//! # Examples
//! ## Read the clocks
//! ```silk
//! import silk.platform.native.clock { NativeClock }
//! import silk.system.system_clock { SystemClock }
//!
//! pub fn main() -> i32 {
//!   // `true` selects the monotonic clock, `false` the system clock.
//!   let first = run NativeClock.now(true)
//!   let second = run NativeClock.now(true)
//!   if SystemClock.seconds(&second) < SystemClock.seconds(&first) {
//!     return 1
//!   }
//!   let resolution = run NativeClock.resolution(false)
//!   if resolution == 0 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Native platform

static if Intrinsic.targetOperatingSystem() == "wasi" { import silk.platform.wasi.clock {WasiClock} }
static if Intrinsic.targetOperatingSystem() == "windows" && Intrinsic.targetArchitecture() == "x86_64" && Intrinsic.targetAbi() == "msvc" && Intrinsic.profileText("libc") == "system" { import silk.platform.windows.clock {WindowsClock} }

import silk.num.i64
import silk.num.u64
import silk.mem.pointer { Pointer }
import silk.system.system_clock { SystemClock, Instant }
import silk.system.monotonic_clock { ReadyWatch }
import silk.core.option { Option }
import silk.num.i32
import silk.num.usize

extern "C" struct Timespec {
  seconds: i64,
  nanoseconds: i64,
}

@foreign(noCapture: .("value"))
unsafe extern "C" fn darwinClockGetTime(clock: u32, value: *mut Timespec) -> i32 as "clock_gettime"
@foreign(noCapture: .("value"))
unsafe extern "C" fn darwinClockGetResolution(clock: u32, value: *mut Timespec) -> i32 as "clock_getres"
@foreign(noCapture: ("request", "remaining"))
unsafe extern "C" fn nanosleep(request: *const Timespec, remaining: ?*mut Timespec) -> i32
unsafe extern "C" fn __error() -> *mut i32
@foreign(noCapture: .("value"))
unsafe extern "C" fn gnuClockGetTime(clock: i32, value: *mut Timespec) -> i32 as "clock_gettime"
@foreign(noCapture: .("value"))
unsafe extern "C" fn gnuClockGetResolution(clock: i32, value: *mut Timespec) -> i32 as "clock_getres"
@foreign(noCapture: ("request", "remaining"))
unsafe extern "C" fn clock_nanosleep(clock: i32, flags: i32, request: *const Timespec, remaining: ?*mut Timespec) -> i32

unsafe fn currentError() -> i32 { unsafe { return Pointer.read<i32>(__error()) } }

@foreign(noCapture: .("fds"))
unsafe extern "C" fn darwinPoll(fds: [*]mut ReadyWatch, count: u32, timeout: i32) -> i32 as "poll"
@foreign(noCapture: .("fds"))
unsafe extern "C" fn gnuPoll(fds: [*]mut ReadyWatch, count: usize, timeout: i32) -> i32 as "poll"
unsafe extern "C" fn __errno_location() -> *mut i32
static if Intrinsic.targetOperatingSystem() == "windows" {
  @foreign(noCapture: .("fds"))
  unsafe extern "C" fn WSAPoll(fds: [*]mut ReadyWatch, count: u32, timeout: i32) -> i32
  unsafe extern "C" fn WSAGetLastError() -> i32
}

// Polls `watch` in place for up to `timeout` milliseconds (-1 waits without end). Returns the
// count of ready handles, or -1 when a signal interrupted the wait.
unsafe fn pollWatches(watch: &mut [ReadyWatch], timeout: i32) -> i32 {
  let length = watch.length
  let pointer = unsafe Intrinsic.pointerRequalify<?[*]mut ReadyWatch, [*]mut ReadyWatch>(
    Pointer.fromMutSlice<ReadyWatch>(move watch),
  )
  static if Intrinsic.targetOperatingSystem() == "windows" {
    if length > 4294967295 { Intrinsic.trap("NativeClock.waitReady: too many handles") }
    let status = unsafe WSAPoll(pointer, usize.toU32(length), timeout)
    if status < 0 {
      // WSAEINTR: a blocking call was interrupted, so the caller polls again.
      if unsafe WSAGetLastError() == 10004 { return -1 }
      Intrinsic.trap("NativeClock.waitReady: the operating system poll call failed")
    }
    return status
  } else {
    static if Intrinsic.targetOperatingSystem() == "darwin" {
      if length > 4294967295 { Intrinsic.trap("NativeClock.waitReady: too many handles") }
      let status = unsafe darwinPoll(pointer, usize.toU32(length), timeout)
      if status < 0 {
        if unsafe currentError() == 4 { return -1 }
        Intrinsic.trap("NativeClock.waitReady: the operating system poll call failed")
      }
      return status
    } else {
      let status = unsafe gnuPoll(pointer, length, timeout)
      if status < 0 {
        if unsafe Pointer.read<i32>(unsafe __errno_location()) == 4 { return -1 }
        Intrinsic.trap("NativeClock.waitReady: the operating system poll call failed")
      }
      return status
    }
  }
}

// The milliseconds from `now` to `until`, rounded up, and at most i32.MAX.
fn millisecondsUntil(now: &Instant, until: &Instant) -> i32 {
  let seconds = SystemClock.seconds(until) - SystemClock.seconds(now)
  let nanoseconds = SystemClock.nanoseconds(until) - SystemClock.nanoseconds(now)
  if seconds < 0 || (seconds == 0 && nanoseconds <= 0) { return 0 }
  if seconds > 2000000 { return 2147483647 }
  let total = seconds * 1000000000 + nanoseconds
  return i64.toI32((total + 999999) / 1000000)
}

fn reachedMark(now: &Instant, until: &Instant) -> bool {
  let seconds = SystemClock.seconds(now)
  let limit = SystemClock.seconds(until)
  if seconds != limit { return seconds > limit }
  return SystemClock.nanoseconds(now) >= SystemClock.nanoseconds(until)
}

unsafe fn clockTime(monotonic: bool, value: *mut Timespec) -> i32 {
  static if Intrinsic.targetOperatingSystem() == "darwin" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64") && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText("libc") == "system" {
    let mut clock: u32 = 0
    if monotonic { clock = 6 }
    return unsafe darwinClockGetTime(clock, value)
  } else {
    static if Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText("libc") == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64") {
      let mut clock: i32 = 0
      if monotonic { clock = 1 }
      return unsafe gnuClockGetTime(clock, value)
    } else { compileError("NativeClock requires a supported WASI, Windows, Darwin or GNU libc profile") }
  }
}

unsafe fn clockResolution(monotonic: bool, value: *mut Timespec) -> i32 {
  static if Intrinsic.targetOperatingSystem() == "darwin" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64") && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText("libc") == "system" {
    let mut clock: u32 = 0
    if monotonic { clock = 6 }
    return unsafe darwinClockGetResolution(clock, value)
  } else {
    static if Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText("libc") == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64") {
      let mut clock: i32 = 0
      if monotonic { clock = 1 }
      return unsafe gnuClockGetResolution(clock, value)
    } else { compileError("NativeClock requires a supported WASI, Windows, Darwin or GNU libc profile") }
  }
}

/// The functions that read the system clocks and wait, for the native clock providers.
///
/// # When to use
/// `silk.system.system_clock_native` and `silk.system.monotonic_clock_native` use it. Application
/// code uses those providers through the `SystemClock` and `MonotonicClock` effects, so a test can
/// replace them.
///
/// # Details
/// Each read checks the result of the system.
///
/// # Gotchas
/// - A failed call or a bad result is a trap.
/// - A wait blocks the whole thread. It does not let another fiber run.
/// - A call fails to compile on targets other than WASI, Windows on x86_64, Darwin on x86_64 or
///   aarch64, and GNU Linux on x86_64 or aarch64.
pub struct NativeClock {}
impl NativeClock {
  /// Returns the time of the monotonic clock if `monotonic` is true, or of the system clock if it
  /// is false.
  ///
  /// A monotonic time is not negative. A failed call or a bad result is a trap.
  pub effect fn now(monotonic: bool) -> Instant {
    static if Intrinsic.targetOperatingSystem() == "wasi" {
      return run WasiClock.now(monotonic)
    } else {
    static if Intrinsic.targetOperatingSystem() == "windows" && Intrinsic.targetArchitecture() == "x86_64" && Intrinsic.targetAbi() == "msvc" && Intrinsic.profileText("libc") == "system" {
      return run WindowsClock.now(monotonic)
    } else {
    let mut value = Timespec { seconds: i64.toI64(0), nanoseconds: i64.toI64(0) }
    let status = unsafe clockTime(monotonic, Pointer.fromMutRef(&mut value))
    if status != 0 { Intrinsic.trap("NativeClock.now: the operating system clock call failed") }
    if monotonic && value.seconds < 0 { Intrinsic.trap("NativeClock.now: the monotonic clock reported a negative time") }
    return SystemClock.make(value.seconds, value.nanoseconds)
      }
    }
  }

  /// Returns the resolution of the selected clock, in nanoseconds. It is more than zero. A failed
  /// call or a bad result is a trap.
  pub effect fn resolution(monotonic: bool) -> u64 {
    static if Intrinsic.targetOperatingSystem() == "wasi" {
      return run WasiClock.resolution(monotonic)
    } else {
    static if Intrinsic.targetOperatingSystem() == "windows" && Intrinsic.targetArchitecture() == "x86_64" && Intrinsic.targetAbi() == "msvc" && Intrinsic.profileText("libc") == "system" {
      return run WindowsClock.resolution(monotonic)
    } else {
    let mut value = Timespec { seconds: i64.toI64(0), nanoseconds: i64.toI64(0) }
    let status = unsafe clockResolution(monotonic, Pointer.fromMutRef(&mut value))
    if status != 0 { Intrinsic.trap("NativeClock.resolution: the operating system clock call failed") }
    if value.seconds < 0 || value.nanoseconds < 0 || value.nanoseconds >= 1000000000 { Intrinsic.trap("NativeClock.resolution: the operating system reported an invalid resolution") }
    let billion = u64.toU64(1000000000)
    let seconds = i64.toU64(value.seconds)
    let fraction = i64.toU64(value.nanoseconds)
    if seconds > u64.MAX / billion { Intrinsic.trap("NativeClock.resolution: the resolution does not fit in nanoseconds") }
    let whole = seconds * billion
    if fraction > u64.MAX - whole { Intrinsic.trap("NativeClock.resolution: the resolution does not fit in nanoseconds") }
    let total = whole + fraction
    if total == u64.MIN { Intrinsic.trap("NativeClock.resolution: the operating system reported a zero resolution") }
    return total
      }
    }
  }

  /// Blocks the thread until the monotonic clock reaches `when`.
  ///
  /// # Details
  /// If a signal interrupts the wait, it waits again for the same deadline.
  ///
  /// # Gotchas
  /// A negative deadline or a failed call is a trap. The wait does not let another fiber run.
  pub effect fn waitUntil(when: Instant) -> () {
    static if Intrinsic.targetOperatingSystem() == "wasi" {
      return run WasiClock.waitUntil(move when)
    } else {
    static if Intrinsic.targetOperatingSystem() == "windows" && Intrinsic.targetArchitecture() == "x86_64" && Intrinsic.targetAbi() == "msvc" && Intrinsic.profileText("libc") == "system" {
      return run WindowsClock.waitUntil(move when)
    } else {
    let seconds = SystemClock.seconds(&when)
    let nanoseconds = SystemClock.nanoseconds(&when)
    if seconds < 0 { Intrinsic.trap("NativeClock.waitUntil: the deadline is negative") }
    static if Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText("libc") == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64") {
      let deadline = Timespec { seconds: seconds, nanoseconds: nanoseconds }
      while true {
        let status = unsafe clock_nanosleep(1, 1, Pointer.fromRef(&deadline), Pointer.null<Timespec>())
        if status == 0 { return () }
        if status != 4 { Intrinsic.trap("NativeClock.waitUntil: the operating system sleep call failed") }
      }
    } else {
      static if Intrinsic.targetOperatingSystem() == "darwin" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64") && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText("libc") == "system" {
        while true {
          let now = run NativeClock.now(true)
          let nowSeconds = SystemClock.seconds(&now)
          let nowNanoseconds = SystemClock.nanoseconds(&now)
          if nowSeconds > seconds || (nowSeconds == seconds && nowNanoseconds >= nanoseconds) { return () }
          let mut remainingSeconds = seconds - nowSeconds
          let mut remainingNanoseconds = nanoseconds - nowNanoseconds
          if remainingNanoseconds < 0 {
            remainingSeconds = remainingSeconds - 1
            remainingNanoseconds = remainingNanoseconds + 1000000000
          }
          let remaining = Timespec { seconds: remainingSeconds, nanoseconds: remainingNanoseconds }
          let status = unsafe nanosleep(Pointer.fromRef(&remaining), Pointer.null<Timespec>())
          if status != 0 {
            if status == -1 {
              let nativeError = unsafe currentError()
              if nativeError != 4 { Intrinsic.trap("NativeClock.waitUntil: the operating system sleep call failed") }
            } else { Intrinsic.trap("NativeClock.waitUntil: the operating system sleep call failed") }
          }
        }
      } else { compileError("NativeClock requires a supported WASI, Windows, Darwin or GNU libc profile") }
    }
    return ()
      }
    }
  }

  /// Waits in one `poll` until a handle in `watch` is ready or the monotonic clock reaches
  /// `until`, and returns how many handles are ready.
  ///
  /// It clears the events of each watch first. An empty `watch` waits until `until`. A signal that
  /// interrupts the poll does not end the wait. WASI has no handles to poll, so a watch there traps.
  pub effect fn waitReady(watch: &mut [ReadyWatch], until: Option<Instant>) -> usize {
    let mut index: usize = 0
    while index < watch.length {
      ReadyWatch.clear(&mut watch[index])
      index = index + 1
    }
    if watch.length == 0 {
      return match move until {
        Option<Instant>.None => Intrinsic.trap("NativeClock.waitReady: nothing to wait for")
        Option<Instant>.Some {value} => {
          run NativeClock.waitUntil(move value)
          return 0
        }
      }
    }
    static if Intrinsic.targetOperatingSystem() == "wasi" {
      drop until
      return Intrinsic.trap("NativeClock.waitReady: WASI has no handles to poll")
    } else {
      while true {
        let mut timeout: i32 = -1
        if let Option<Instant>.Some {value: limit} = &until {
          let now = run NativeClock.now(true)
          timeout = millisecondsUntil(&now, &limit)
        }
        let status = unsafe pollWatches(&mut watch, timeout)
        if status > 0 { return i32.toUsize(status) }
        if status == 0 && timeout >= 0 {
          if let Option<Instant>.Some {value: limit} = &until {
            let after = run NativeClock.now(true)
            if reachedMark(&after, &limit) { return 0 }
          }
        }
      }
      return 0
    }
  }

  /// Polls `watch` once without waiting, and returns how many handles are ready. A test clock uses
  /// it to see real sockets while it moves its own time.
  pub fn pollNow(watch: &mut [ReadyWatch]) -> usize {
    let mut index: usize = 0
    while index < watch.length {
      ReadyWatch.clear(&mut watch[index])
      index = index + 1
    }
    if watch.length == 0 { return 0 }
    static if Intrinsic.targetOperatingSystem() == "wasi" {
      return Intrinsic.trap("NativeClock.pollNow: WASI has no handles to poll")
    } else {
      while true {
        let status = unsafe pollWatches(&mut watch, 0)
        if status >= 0 { return i32.toUsize(status) }
      }
      return 0
    }
  }
}
