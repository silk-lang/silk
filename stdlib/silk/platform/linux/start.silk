//! The program entry for a static, non-PIE Linux executable with no libc.
//!
//! # When to use
//! Select this module as the runtime root of the artifact, with `libc` set to `none` and the loader
//! entry `_start`. The application supplies `pub fn main(inputs: &ProcessInputs) -> i32`. Use
//! `silk.platform.native.start` for a normal hosted program.
//!
//! # Details
//! At start, the entry decodes the kernel stack with `ProcessInputs.decode` and calls `main` one
//! time. The return value of `main` becomes the status of `exit_group`. If the process inputs are
//! not valid, the process exits with status `127`.
//!
//! # Gotchas
//! - There is no suspension storage and no report provider. `main` must be a synchronous function,
//!   not an effect.
//! - A fatal trap does not run cleanup and does not print a report.
//!
//! @category Native platform

static if Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.profileText("libc") == "none" && (Intrinsic.targetArchitecture() == "x86_64" || Intrinsic.targetArchitecture() == "aarch64") {
  import Intrinsic.application
  import silk.platform.linux.syscall { RawLinux, EXIT_GROUP }
  import silk.platform.linux.process_inputs {ProcessInputs}
  import silk.core.result {Result}
  import silk.num.i32

  static if Intrinsic.targetArchitecture() == "x86_64" {
    /// The `_start` symbol. It passes the kernel stack pointer to `invoke`.
    unsafe export "C" fn entry() -> () as "_start" with Intrinsic.machine(
      naked: true,
      noReturn: true,
    ) {
      return unsafe Intrinsic.assembly<()>(
        "movq %rsp, %rdi\nandq $$-16, %rsp\ncall silk_raw_process_entry\nud2",
        "",
        "",
        "readwrite",
        true,
        true,
        (),
      )
    }
  } else {
    /// The `_start` symbol. It passes the kernel stack pointer to `invoke`.
    unsafe export "C" fn entry() -> () as "_start" with Intrinsic.machine(
      naked: true,
      noReturn: true,
    ) {
      return unsafe Intrinsic.assembly<()>(
        "mov x0, sp\nbl silk_raw_process_entry\nbrk #0",
        "",
        "",
        "readwrite",
        true,
        true,
        (),
      )
    }
  }
  /// Decodes the kernel stack, calls the application, and ends the process. It does not return.
  ///
  /// # Gotchas
  /// Only the `_start` entry calls this export. `stack` must point to the complete, aligned and
  /// readable kernel stack image.
  export "C" fn invoke(stack: [*]const usize) -> () as "silk_raw_process_entry" {
    let decoded = unsafe ProcessInputs.decode(stack)
    let code = match move decoded {
      Result<ProcessInputs, usize>.Success {value} => application.main(&value)
      Result<ProcessInputs, usize>.Failure {error} => 127
    }
    let status = i32.toUsize(code & 255)
    return unsafe RawLinux.syscallNoReturn(EXIT_GROUP, status)
  }
}
