//! Anonymous memory mappings from the Linux kernel, for programs that run without libc.
//!
//! # When to use
//! Use [`Mapping.allocate`] in a raw Linux program, after startup reads the page size from the
//! `AT_PAGESZ` auxiliary vector entry. Other programs get memory from the `Allocator` effect.
//!
//! # Details
//! This module exists only on Linux on x86_64 and aarch64, with the `libc` profile set to `none`.
//! Each [`Mapping`] owns its whole mapping. Dropping the mapping releases it with `munmap`. Errors
//! are Linux error numbers, such as 22 for `EINVAL`.
//!
//! # Gotchas
//! A raw pointer from [`Mapping.pointer`] does not keep the mapping alive. If the program traps,
//! the mapping is not always released.
//!
//! @category Native platform

static if Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.profileText("libc") == "none" && (Intrinsic.targetArchitecture() == "x86_64" || Intrinsic.targetArchitecture() == "aarch64") {
  import silk.core.ownership { Drop }
  import silk.platform.linux.syscall { RawLinux, MMAP, MUNMAP }
  import silk.core.result {Result}
  import silk.num.usize
  /// One anonymous mapping from the Linux kernel that starts as zeros, and an aligned range inside
  /// it. It exists only on Linux on x86_64 and aarch64, with the `libc` profile set to `none`.
  ///
  /// # Details
  ///
  /// Drop is automatic and releases the mapping. Use [`Mapping.release`] to get the error from
  /// `munmap`. Errors are Linux error numbers, such as 22 for `EINVAL`.
  ///
  /// # Gotchas
  ///
  /// A raw pointer from [`Mapping.pointer`] does not keep the mapping alive. If the program traps,
  /// the mapping is not always released.
  pub struct Mapping {
    base: usize,
    reserved: usize,
    address: usize,
    requested: usize,
  }
  impl Drop for Mapping {
    fn drop(self: &mut Mapping) -> () {
      let reserved = Intrinsic.replace(self.reserved, 0)
      if reserved != 0 {
        let ignored = unsafe RawLinux.syscall2(MUNMAP, self.base, reserved)
      }
    }
  }
  impl Mapping {
    /// Maps zeroed memory with at least `length` bytes that start at an address aligned to
    /// `alignment`.
    ///
    /// # Details
    ///
    /// `pageSize` must be the page size of the process, from `AT_PAGESZ`. The mapping is larger
    /// than `length` when it needs space to align the start.
    ///
    /// # Errors
    ///
    /// - `22` (`EINVAL`) if `length`, `alignment`, or `pageSize` is 0, if `alignment` or `pageSize`
    ///   is not a power of two, or if the size computation overflows.
    /// - The Linux error number from `mmap` if the kernel cannot make the mapping.
    pub fn allocate(length: usize, alignment: usize, pageSize: usize) -> Result<Mapping, usize> {
      if length == 0 || alignment == 0 || pageSize == 0 {
        return Result<Mapping, usize>.failResult(22)
      }
      if (alignment & (alignment - 1)) != 0 || (pageSize & (pageSize - 1)) != 0 {
        return Result<Mapping, usize>.failResult(22)
      }
      let padding = alignment - 1
      if length > usize.MAX - padding {
        return Result<Mapping, usize>.failResult(22)
      }
      let needed = length + padding
      if needed > usize.MAX - (pageSize - 1) {
        return Result<Mapping, usize>.failResult(22)
      }
      let reserved = ((needed + (pageSize - 1)) / pageSize) * pageSize
      let base = unsafe RawLinux.syscall6(MMAP, 0, reserved, 3, 34, usize.MAX, 0)
      let error = RawLinux.error(base)
      if error != 0 {
        return Result<Mapping, usize>.failResult(error)
      }
      let owner = Mapping {base: base, reserved: reserved, address: base, requested: length}
      if base > usize.MAX - padding {
        return Result<Mapping, usize>.failResult(22)
      }
      let address = ((base + padding) / alignment) * alignment
      let mut mapping = move owner
      mapping.address = address
      return Result<Mapping, usize>.succeed(move mapping)
    }
    /// Returns the usable byte count that was requested. It does not include the alignment space.
    pub fn length(self: &Mapping) -> usize {
      return self.requested
    }
    /// Returns a pointer to the start of the aligned usable range.
    ///
    /// # Gotchas
    ///
    /// The pointer does not own the mapping and does not keep it alive. Keep the [`Mapping`] alive
    /// and access at most [`Mapping.length`] bytes. The bytes are zero at first.
    pub unsafe fn pointer(self: &mut Mapping) -> ?[*]mut u8 {
      return unsafe RawLinux.pointer(self.address)
    }
    /// Releases the whole mapping now and returns the result of `munmap`.
    ///
    /// # Details
    ///
    /// Returns 0 on success or the Linux error number. After `release`, drop does not try to
    /// release the mapping again.
    pub fn release(value: Mapping) -> usize {
      let mut self = move value
      let reserved = Intrinsic.replace(self.reserved, 0)
      return RawLinux.error(unsafe RawLinux.syscall2(MUNMAP, self.base, reserved))
    }
  }
}
