//! A snapshot of WASI command arguments and environment variables.
//!
//! # When to use
//! Use `WasiHostInput.capture` to provide `HostInput` inside a WASI command.
//! The WASI runtime supplies this provider to an application that requires `HostInput`.
//!
//! # Details
//! The snapshot owns its bytes. The working directory is `/` in the guest namespace.
//! The host grants filesystem access separately through preopened directories.
//!
//! @category Native platform

static if Intrinsic.targetOperatingSystem() == "wasi" {
  import silk.mem.allocator { Allocator, OutOfMemoryError }
  import silk.collections.bytes { Bytes }
  import silk.system.host_input { HostInput, HostInputError }
  import silk.collections.list { List }
  import silk.option { Option }
  import silk.mem.pointer { Pointer }
  import silk.collections.slice { Slice }
  import silk.num.u32
  import silk.num.usize
  import silk.platform.wasi.preview1

  /// A WASI `HostInput` provider that owns command arguments and environment bytes.
  /// The working directory is `/` in the guest namespace.
  pub struct WasiHostInput {
    arguments: List<Bytes>,
    environment: List<Bytes>,
  }

  effect fn capture(arguments: bool) -> List<Bytes>
    ! HostInputError | OutOfMemoryError
    ? &mut Allocator {
    let mut count: u32 = 0
    let mut size: u32 = 0
    let mut status: u32 = 0
    if arguments {
      status = unsafe preview1.args_sizes_get(
        Pointer.fromMutRef(&mut count),
        Pointer.fromMutRef(&mut size)
      )
    } else {
      status = unsafe preview1.environ_sizes_get(
        Pointer.fromMutRef(&mut count),
        Pointer.fromMutRef(&mut size)
      )
    }
    if status != 0 {
      fail HostInput.inputFailure()
    }
    if count == 0 {
      return List<Bytes>.make()
    }
    let mut pointers = List<?[*]mut u8>.make()
    let mut index: u32 = 0
    while index < count {
      run List<?[*]mut u8>.append(
        &mut pointers,
        unsafe Intrinsic.pointerRequalify<?*mut u8, ?[*]mut u8>(Pointer.null<u8>())
      )
      index = index + 1
    }
    let mut bytes = run Bytes.zeroed(u32.toUsize(size))
    let table = Pointer.fromMutSlice(List<?[*]mut u8>.asMutSlice(&mut pointers))
    let buffer = Pointer.fromMutSlice(Bytes.asMutSlice(&mut bytes))
    let mut read: u32 = 0
    if arguments {
      read = unsafe preview1.args_get(table, buffer)
    } else {
      read = unsafe preview1.environ_get(table, buffer)
    }
    if read != 0 {
      fail HostInput.inputFailure()
    }

    // Validate each pointer against the buffer before copying its NUL-terminated string.
    let contents = Bytes.asSlice(&bytes)
    let mut result = List<Bytes>.make()
    let base = Pointer.addressMany(Pointer.fromSlice(contents))
    let entries = List<?[*]mut u8>.asSlice(&pointers)
    index = 0
    while index < count {
      let address = Pointer.addressMany(entries[u32.toUsize(index)])
      if address < base || address - base >= contents.length {
        fail HostInput.inputFailure()
      }
      let start = address - base
      let mut at = start
      while at < contents.length && contents[at] != 0 {
        at = at + 1
      }
      if at == contents.length {
        fail HostInput.inputFailure()
      }
      run List<Bytes>.append(&mut result, run Bytes.copy(Slice.view(contents, start, at - start)))
      at = at + 1
      index = index + 1
    }
    return move result
  }

  impl WasiHostInput {
    /// Copies the host's command arguments and environment into an owned snapshot.
    /// Fails with `HostInputError` on a host error, or `OutOfMemoryError` on an allocation failure.
    pub effect fn capture() -> WasiHostInput
      ! HostInputError | OutOfMemoryError
      ? &mut Allocator {
      let arguments = run capture(true)
      let environment = run capture(false)
      return WasiHostInput { arguments: move arguments, environment: move environment }
    }
  }

  impl HostInput for WasiHostInput {
    effect fn argumentCount(self: &mut Self) -> usize
      ! HostInputError {
      return List<Bytes>.length(&self.arguments)
    }

    effect fn argument(self: &mut Self, index: usize) -> Option<Bytes>
      ! HostInputError | OutOfMemoryError
      ? &mut Allocator {
      let arguments = List<Bytes>.asSlice(&self.arguments)
      if index >= arguments.length {
        return Option<Bytes>.none()
      }
      return Option<Bytes>.some(run Bytes.copy(Bytes.asSlice(&arguments[index])))
    }

    effect fn variable(self: &mut Self, name: &[u8]) -> Option<Bytes>
      ! HostInputError | OutOfMemoryError
      ? &mut Allocator {
      let environment = List<Bytes>.asSlice(&self.environment)
      let mut index: usize = 0
      while index < environment.length {
        let entry = Bytes.asSlice(&environment[index])
        if entry.length > name.length && entry[name.length] == 61 {
          let mut at: usize = 0
          while at < name.length && entry[at] == name[at] {
            at = at + 1
          }
          if at == name.length {
            return Option<Bytes>.some(
              run Bytes.copy(Slice.view(entry, at + 1, entry.length - at - 1))
            )
          }
        }
        index = index + 1
      }
      return Option<Bytes>.none()
    }

    effect fn workingDirectory(self: &mut Self) -> Bytes
      ! HostInputError | OutOfMemoryError
      ? &mut Allocator {
      return run Bytes.copy(b"/")
    }
  }
}
