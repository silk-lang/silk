//! Memory and polling operations shared by WASI Preview 2 providers.
//!
//! # Details
//! These types use the wasm32 canonical ABI. Imported lists use the same allocator as Silk and
//! their owners release the allocation. Pollable owners release their resource exactly once.
//!
//! @category Native platform

static if Intrinsic.profileText("target") == "wasm32-wasip2" {
  import silk.platform.wasi.preview2 as host
  import silk.system.monotonic_clock { MonotonicClock }
  import silk.system.system_clock { Instant, SystemClock }
  import silk.core.option { Option }
  import silk.core.ownership { Drop }
  import silk.mem.pointer { Pointer }
  import silk.num.u8
  import silk.num.u32
  import silk.num.u64
  import silk.num.usize

  /// An aligned, initialized result area for canonical results up to 128 bytes.
  pub extern "C" struct ResultArea {
    words: [u64; 16],
  }

  /// Returns the wasm32 address of a live value. The caller keeps the value alive through the call.
  pub fn address<T>(value: &mut T) -> u32 {
    return usize.toU32(Pointer.address(Pointer.fromMutRef(&mut value.*)))
  }

  /// Reads a byte of an initialized foreign record. `offset` must be inside its storage.
  pub unsafe fn byte<T>(value: &T, offset: usize) -> u8 {
    let raw = unsafe Pointer.bytes(Pointer.fromRef(value))
    let pointer = match move Pointer.nonNullMany(raw) {
      Option<[*]const u8>.Some {value: found} => found
      Option<[*]const u8>.None => Intrinsic.trap("a live canonical record has a null address")
    }
    unsafe { return Pointer.read(Pointer.at(pointer, offset)) }
  }

  impl ResultArea {
    /// Makes a zeroed canonical result area, aligned to eight bytes.
    pub fn make() -> ResultArea { return ResultArea {words: [0; 16]} }

    /// Reads one initialized byte. `offset` must be below 128.
    pub fn byte(self: &Self, offset: usize) -> u8 {
      if offset >= 128 { Intrinsic.trap("canonical result byte outside storage") }
      return unsafe byte(self, offset)
    }

    /// Reads one little-endian 16-bit integer. `offset` must be at most 126.
    pub fn word16(self: &Self, offset: usize) -> u16 {
      return u8.toU16(ResultArea.byte(self, offset)) + u8.toU16(ResultArea.byte(self, offset + 1)) * 256
    }

    /// Reads one little-endian 32-bit integer. `offset` must be at most 124.
    pub fn word32(self: &Self, offset: usize) -> u32 {
      let mut value: u32 = 0
      let mut at: usize = 4
      while at > 0 { at = at - 1 value = value * 256 + u8.toU32(ResultArea.byte(self, offset + at)) }
      return value
    }

    /// Reads one little-endian 64-bit integer. `offset` must be at most 120.
    pub fn word64(self: &Self, offset: usize) -> u64 {
      let mut value: u64 = 0
      let mut at: usize = 8
      while at > 0 { at = at - 1 value = value * 256 + u8.toU64(ResultArea.byte(self, offset + at)) }
      return value
    }
  }

  /// An owned WASI pollable. Drop releases the resource; it must precede its parent resource.
  pub struct Pollable { handle: u32 }

  /// Whether an optional absolute deadline has expired on the supplied monotonic clock.
  pub effect fn expired(deadline: &Option<Instant>) -> bool ? &mut MonotonicClock {
    if let Option<Instant>.Some {value: end} = &deadline.* {
      let now = run MonotonicClock.now()
      return SystemClock.seconds(&now) > SystemClock.seconds(&end) ||
        (SystemClock.seconds(&now) == SystemClock.seconds(&end) && SystemClock.nanoseconds(&now) >= SystemClock.nanoseconds(&end))
    }
    return false
  }

  impl Pollable {
    /// Takes ownership of a live pollable handle. The caller must surrender its previous owner.
    pub unsafe fn take(handle: u32) -> Pollable { return Pollable {handle: handle} }

    /// Waits for readiness, returning false when the deadline on the supplied clock expires.
    /// With no deadline the host blocks directly. With a deadline readiness is checked at most
    /// one millisecond apart, using the supplied clock for both time and waiting.
    pub effect fn wait(self: &Self, deadline: &Option<Instant>) -> bool ? &mut MonotonicClock {
      if let Option<Instant>.None = &deadline.* {
        unsafe host.io_poll_pollable_block(self.handle)
        return true
      }
      while true {
        if run expired(deadline) { return false }
        if unsafe host.io_poll_pollable_ready(self.handle) != 0 { return true }
        run MonotonicClock.waitFor(1000000)
      }
    }
  }

  impl Drop for Pollable {
    fn drop(self: &mut Self) -> () { unsafe host.io_poll_drop_pollable(self.handle) }
  }

  unsafe extern "C" fn free(pointer: ?[*]mut u8) -> ()

  /// An owned canonical `result<list<u8>, stream-error>`, initialized before a stream read.
  /// Drop releases the returned buffer or error resource. Read fields only through its methods.
  pub extern "C" struct StreamResult {
    tag: u8,
    data: ?[*]mut u8,
    length: u32,
  }

  impl StreamResult {
    /// Initializes storage for a host read. Pass its address as the indirect return argument.
    pub fn make() -> StreamResult {
      let empty = unsafe Intrinsic.pointerRequalify<?*mut u8, ?[*]mut u8>(Pointer.null<u8>())
      return StreamResult {tag: 0, data: empty, length: 0}
    }

    /// Whether the host returned bytes rather than a stream error.
    pub fn succeeded(self: &Self) -> bool { return self.tag == 0 }

    /// The byte count of a successful result. Call only after `succeeded` returns true.
    pub fn count(self: &Self) -> usize { return u32.toUsize(self.length) }

    /// Whether the host reported that the stream ended.
    pub fn ended(self: &Self) -> bool { return self.tag == 1 && unsafe byte(self, 4) == 1 }

    /// Copies the returned bytes into `output`. The host result must be a successful read of at
    /// most `output.length` bytes; an invalid host count traps before memory is accessed.
    pub fn copyTo(self: &Self, output: &mut [u8]) -> usize {
      let length = u32.toUsize(self.length)
      if self.tag != 0 || length > output.length { Intrinsic.trap("invalid WASI stream read result") }
      if length == 0 { return 0 }
      let pointer = match move Pointer.nonNullMany(self.data) {
        Option<[*]const u8>.Some {value} => value
        Option<[*]const u8>.None => Intrinsic.trap("WASI returned a null nonempty buffer")
      }
      let mut at: usize = 0
      while at < length {
        unsafe { output[at] = Pointer.read(Pointer.at(pointer, at)) }
        at = at + 1
      }
      return length
    }
  }

  impl Drop for StreamResult {
    fn drop(self: &mut Self) -> () {
      if self.tag == 0 {
        if self.length > 0 { unsafe free(self.data) }
      } else if unsafe byte(&self.*, 4) == 0 {
        unsafe host.io_error_drop_error(self.length)
      }
    }
  }
}
