//! The canonical ABI allocator of every `wasm32-wasip2` component.
//!
//! # When to use
//! The standard library's catalog names this module as a `wasm32-wasip2` support module, so every
//! component exports `cabi_realloc`, whatever its runtime. Applications do not call it.
//!
//! # Details
//! The canonical ABI and the command adapter allocate through `cabi_realloc`, so their storage
//! stays in the program's heap; a separate `memory.grow` allocator would overlap it.
//!
//! @category Native platform

static if Intrinsic.profileText("target") == "wasm32-wasip2" {
  import silk.num.usize
  import silk.core.option { Option }
  import silk.mem.pointer { Pointer }
  import silk.platform.wasm.heap { WasmHeap }
  /// The canonical ABI's allocator, which the canonical ABI and the command adapter allocate
  /// through, so their storage stays in the program's heap. Canonical values and the adapter's
  /// stack need at most 16-byte alignment; a larger or invalid one, or an exhausted heap, traps.
  export "C" fn componentRealloc(previous: ?[*]mut u8, previousSize: usize, alignment: usize, size: usize) -> ?[*]mut u8 as "cabi_realloc" {
    if alignment == 0 || alignment > 16 || usize.bitAnd(alignment, alignment - 1) != 0 {
      return Intrinsic.trap("cabi_realloc alignment above 16")
    }
    if size == 0 {
      if previousSize != 0 { unsafe WasmHeap.release(previous) }
      return WasmHeap.empty()
    }
    let mut allocation = WasmHeap.empty()
    if previousSize == 0 {
      allocation = unsafe WasmHeap.allocate(size)
    } else {
      allocation = unsafe WasmHeap.resize(previous, size)
    }
    if let Option<[*]mut u8>.None = Pointer.nonNullManyMut<u8>(allocation) {
      return Intrinsic.trap("cabi_realloc out of memory")
    }
    return allocation
  }
}
