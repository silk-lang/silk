//! Descriptor reads and writes through WASI.
//!
//! # Details
//! These operations borrow descriptors. They never close them.
//! They retry interrupted calls and report WASI errno values on failure.
//!
//! @category Native platform

static if Intrinsic.targetOperatingSystem() == "wasi" {
  import silk.platform.wasi.preview1 { IoVector, ConstIoVector }
  import silk.platform.wasi.preview1
  import silk.mem.pointer { Pointer }
  import silk.collections.slice { Slice }
  import silk.num.u32
  import silk.num.i32
  import silk.num.usize

  fn part<'a>(head: &'a [u8], rest: &[&'a [u8]], index: usize) -> &'a [u8] {
    if index == 0 {
      return head
    }
    return rest[index - 1]
  }

  fn emptyVectors() -> [ConstIoVector; 8] {
    let nothing: [u8; 0] = []
    let base = Pointer.fromSlice<u8>(&nothing)
    return [
      ConstIoVector { base: base, length: 0 },
      ConstIoVector { base: base, length: 0 },
      ConstIoVector { base: base, length: 0 },
      ConstIoVector { base: base, length: 0 },
      ConstIoVector { base: base, length: 0 },
      ConstIoVector { base: base, length: 0 },
      ConstIoVector { base: base, length: 0 },
      ConstIoVector { base: base, length: 0 },
    ]
  }

  /// Descriptor transfers for WASI providers. Calls never close the descriptor.
  pub struct WasiDescriptor {}
  impl WasiDescriptor {
    /// Reads once into `buffer`. Returns false with a WASI errno on failure.
    /// An empty buffer succeeds without a host call. A zero count means end of input.
    pub effect fn read(fd: i32, buffer: &mut [u8], count: &mut usize, error: &mut i32) -> bool {
      count.* = 0
      error.* = 0
      let length = buffer.length
      if length == 0 {
        return true
      }
      let vectors = [
        IoVector { base: Pointer.fromMutSlice(move buffer), length: usize.toU32(length) }
      ]
      let mut received: u32 = 0
      while true {
        let status = unsafe preview1.fd_read(
          i32.toU32(fd),
          Pointer.fromSlice(&vectors),
          1,
          Pointer.fromMutRef(&mut received)
        )
        if status != 27 {
          error.* = u32.toI32(status)
          if status != 0 || u32.toUsize(received) > length {
            return false
          }
          count.* = u32.toUsize(received)
          return true
        }
      }
      return false
    }

    /// Returns false because WASI does not define terminal detection.
    pub effect fn isTerminal(fd: i32) -> bool {
      return false
    }

    /// Writes all bytes in `buffer`. A failure can occur after a partial write.
    /// Returns false with the WASI errno, or zero for an invalid host count.
    pub effect fn writeAll(fd: i32, buffer: &[u8], error: &mut i32) -> bool {
      error.* = 0
      let mut offset: usize = 0
      while offset < buffer.length {
        let length = buffer.length - offset
        let vectors = [
          ConstIoVector {
            base: Pointer.fromSlice(Slice.view(buffer, offset, length)),
            length: usize.toU32(length)
          }
        ]
        let mut written: u32 = 0
        let status = unsafe preview1.fd_write(
          i32.toU32(fd),
          Pointer.fromSlice(&vectors),
          1,
          Pointer.fromMutRef(&mut written)
        )
        if status != 27 {
          error.* = u32.toI32(status)
          if status != 0 || written == 0 || u32.toUsize(written) > length {
            return false
          }
          offset = offset + u32.toUsize(written)
        }
      }
      return true
    }

    /// Writes `head` followed by all slices of `rest`. A failure can follow a partial write.
    /// Returns false with a WASI errno, or zero for an invalid host count.
    pub effect fn writeAllGather(fd: i32, head: &[u8], rest: &[&[u8]], error: &mut i32) -> bool {
      error.* = 0
      let count = rest.length + 1
      let mut index: usize = 0
      let mut offset: usize = 0
      while true {
        // Skip the parts that are complete or empty.
        while index < count && offset == part(head, rest, index).length {
          index = index + 1
          offset = 0
        }
        if index == count {
          return true
        }
        let mut vectors = emptyVectors()
        let mut used: usize = 0
        let mut total: usize = 0
        let mut at = index
        let mut from = offset
        while at < count && used < 8 && total < 2147479552 {
          let source = part(head, rest, at)
          let mut length = source.length - from
          if length > 2147479552 - total {
            length = 2147479552 - total
          }
          if length != 0 {
            vectors[used] = ConstIoVector {
              base: Pointer.fromSlice<u8>(Slice.view<u8>(source, from, length)),
              length: usize.toU32(length)
            }
            used = used + 1
            total = total + length
          }
          at = at + 1
          from = 0
        }
        let mut transferred: u32 = 0
        let status = unsafe preview1.fd_write(
          i32.toU32(fd),
          Pointer.fromSlice<ConstIoVector>(&vectors),
          usize.toU32(used),
          Pointer.fromMutRef(&mut transferred)
        )
        if status != 0 {
          if status != 27 {
            error.* = u32.toI32(status)
            return false
          }
        } else {
          let written = u32.toUsize(transferred)
          if written == 0 || written > total {
            return false
          }

          // Move past the written bytes, part by part.
          let mut remaining = written
          while remaining != 0 {
            let left = part(head, rest, index).length - offset
            if remaining < left {
              offset = offset + remaining
              remaining = 0
            } else {
              remaining = remaining - left
              index = index + 1
              offset = 0
            }
          }
        }
      }
      return false
    }
  }
}
