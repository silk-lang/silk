//! Owned Preview 2 input and output streams with partial transfers and deadlines.
//!
//! # Details
//! Stream owners close their resource on drop. Operations use WASI polling and the supplied
//! monotonic clock. The parent resource, such as a TCP socket or HTTP body, must outlive its streams.
//!
//! @category Native platform

static if Intrinsic.profileText("target") == "wasm32-wasip2" {
  import silk.platform.wasi.preview2 as host
  import silk.platform.wasi.component as abi { ResultArea, StreamResult, Pollable }
  import silk.io.byte_duplex { ReadTransfer }
  import silk.system.monotonic_clock { MonotonicClock }
  import silk.system.system_clock { Instant }
  import silk.core.option { Option }
  import silk.core.ownership { Drop }
  import silk.mem.pointer { Pointer }
  import silk.num.u32
  import silk.num.u64
  import silk.num.usize

  /// A stream failure: a closed resource, an expired deadline, or another host I/O failure.
  pub enum StreamError { Closed, Timeout, Host }

  /// An owned Preview 2 input stream. Its parent must outlive it.
  pub struct InputStream { handleValue: u32 }

  /// An owned Preview 2 output stream. Its parent must outlive it.
  pub struct OutputStream { handleValue: u32 }

  // Releases an io/error resource held by a canonical stream-error before returning its class.
  fn failure(result: &ResultArea, offset: usize) -> StreamError {
    if ResultArea.byte(result, offset) == 1 { return StreamError.Closed }
    unsafe host.io_error_drop_error(ResultArea.word32(result, offset + 4))
    return StreamError.Host
  }

  impl InputStream {
    /// Takes exclusive ownership of a live input-stream handle. The caller keeps its parent alive.
    pub unsafe fn take(handle: u32) -> InputStream { return InputStream {handleValue: handle} }

    /// Borrows the handle without transferring ownership. It is valid until this owner is dropped.
    pub fn handle(self: &Self) -> u32 { return self.handleValue }

    /// Reads a nonempty partial transfer or EOF. An empty output returns zero immediately.
    /// An expired deadline fails with `Timeout`; other failures are `Closed` or `Host`.
    pub effect fn read(self: &mut Self, output: &mut [u8], deadline: Option<Instant>) -> ReadTransfer
      ! StreamError ? &mut MonotonicClock {
      if output.length == 0 { return ReadTransfer.Data {count: 0} }
      while true {
        if run abi.expired(&deadline) { fail StreamError.Timeout }
        let mut result = StreamResult.make()
        unsafe host.io_streams_input_stream_read(self.handleValue, usize.toU64(output.length), abi.address(&mut result))
        if StreamResult.ended(&result) { return ReadTransfer.End }
        if !StreamResult.succeeded(&result) { fail StreamError.Host }
        if StreamResult.count(&result) > 0 {
          return ReadTransfer.Data {count: StreamResult.copyTo(&result, move output)}
        }
        let pollableHandle = unsafe host.io_streams_input_stream_subscribe(self.handleValue)
        let pollable = unsafe Pollable.take(pollableHandle)
        if !run Pollable.wait(&pollable, &deadline) { fail StreamError.Timeout }
      }
    }
  }

  impl Drop for InputStream {
    fn drop(self: &mut Self) -> () { unsafe host.io_streams_drop_input_stream(self.handleValue) }
  }

  impl OutputStream {
    /// Takes exclusive ownership of a live output-stream handle. The caller keeps its parent alive.
    pub unsafe fn take(handle: u32) -> OutputStream { return OutputStream {handleValue: handle} }

    /// Borrows the handle without transferring ownership. It is valid until this owner is dropped.
    pub fn handle(self: &Self) -> u32 { return self.handleValue }

    effect fn capacity(self: &Self, deadline: &Option<Instant>) -> u64
      ! StreamError ? &mut MonotonicClock {
      while true {
        if run abi.expired(deadline) { fail StreamError.Timeout }
        let mut result = ResultArea.make()
        unsafe host.io_streams_output_stream_check_write(self.handleValue, abi.address(&mut result))
        if ResultArea.byte(&result, 0) != 0 { fail failure(&result, 8) }
        let count = ResultArea.word64(&result, 8)
        if count > 0 { return count }
        let pollableHandle = unsafe host.io_streams_output_stream_subscribe(self.handleValue)
        let pollable = unsafe Pollable.take(pollableHandle)
        if !run Pollable.wait(&pollable, deadline) { fail StreamError.Timeout }
      }
    }

    /// Writes a nonempty partial transfer, honoring host backpressure and the deadline.
    /// An empty input returns zero; host I/O errors release their error resource before failing.
    pub effect fn write(self: &mut Self, input: &[u8], deadline: Option<Instant>) -> usize
      ! StreamError ? &mut MonotonicClock {
      if input.length == 0 { return 0 }
      let available = run OutputStream.capacity(&self.*, &deadline)
      let mut count = input.length
      if available < usize.toU64(count) { count = u64.toUsize(available) }
      let mut result = ResultArea.make()
      unsafe host.io_streams_output_stream_write(self.handleValue,
        usize.toU32(Pointer.addressMany(Pointer.fromSlice(input))), usize.toU32(count), abi.address(&mut result))
      if ResultArea.byte(&result, 0) != 0 { fail failure(&result, 4) }
      return count
    }

    /// Flushes buffered bytes and waits until the host permits another write.
    pub effect fn flush(self: &mut Self, deadline: Option<Instant>) -> ()
      ! StreamError ? &mut MonotonicClock {
      let mut result = ResultArea.make()
      unsafe host.io_streams_output_stream_flush(self.handleValue, abi.address(&mut result))
      if ResultArea.byte(&result, 0) != 0 { fail failure(&result, 4) }
      let available = run OutputStream.capacity(&self.*, &deadline)
      drop available
      return ()
    }
  }

  impl Drop for OutputStream {
    fn drop(self: &mut Self) -> () { unsafe host.io_streams_drop_output_stream(self.handleValue) }
  }
}
