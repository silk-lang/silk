//! WASI wall-clock and monotonic-clock operations.
//!
//! # Details
//! A host failure traps. Clock waits block the command until the host reports the deadline.
//!
//! @category Native platform

static if Intrinsic.targetOperatingSystem() == "wasi" {
  import silk.platform.wasi.preview1 { Subscription, Event }
  import silk.platform.wasi.preview1
  static if Intrinsic.profileText("target") == "wasm32-wasip2" { import silk.platform.wasi.preview2 as preview2 }
  import silk.num.usize
  import silk.num.u32

  extern "C" struct DateTime { seconds: u64, nanoseconds: u32 }
  import silk.mem.pointer { Pointer }
  import silk.system.system_clock { Instant, SystemClock }
  import silk.num.u64
  import silk.num.i64

  /// WASI clock operations. A host failure or an invalid clock result traps.
  pub struct WasiClock {}
  impl WasiClock {
    /// Returns monotonic time when `monotonic` is true, otherwise Unix time.
    /// A host failure traps.
    pub effect fn now(monotonic: bool) -> Instant {
      static if Intrinsic.profileText("target") == "wasm32-wasip2" {
        if monotonic {
          let time = unsafe preview2.clocks_monotonic_clock_now()
          return SystemClock.make(u64.toI64(time / 1000000000), u64.toI64(time % 1000000000))
        }
        let mut time = DateTime {seconds: 0, nanoseconds: 0}
        unsafe preview2.clocks_wall_clock_now(usize.toU32(Pointer.address(Pointer.fromMutRef(&mut time))))
        if time.seconds > 9223372036854775807 || time.nanoseconds >= 1000000000 { Intrinsic.trap("WasiClock.now: invalid wall time") }
        return SystemClock.make(u64.toI64(time.seconds), u32.toI64(time.nanoseconds))
      } else {
      let mut clock: u32 = 0
      if monotonic {
        clock = 1
      }
      let mut time: u64 = 0
      let status = unsafe preview1.clock_time_get(clock, 1, Pointer.fromMutRef(&mut time))
      if status != 0 {
        Intrinsic.trap("WasiClock.now: the host clock_time_get call failed")
      }
      return SystemClock.make(u64.toI64(time / 1000000000), u64.toI64(time % 1000000000))
      }
    }

    /// Returns the selected clock's resolution in nanoseconds. Zero or a host failure traps.
    pub effect fn resolution(monotonic: bool) -> u64 {
      static if Intrinsic.profileText("target") == "wasm32-wasip2" {
        let mut nanos: u64 = 0
        if monotonic { nanos = unsafe preview2.clocks_monotonic_clock_resolution() }
        else {
          let mut time = DateTime {seconds: 0, nanoseconds: 0}
          unsafe preview2.clocks_wall_clock_resolution(usize.toU32(Pointer.address(Pointer.fromMutRef(&mut time))))
          if time.nanoseconds >= 1000000000 || time.seconds > (u64.MAX - u32.toU64(time.nanoseconds)) / 1000000000 { Intrinsic.trap("WasiClock.resolution: invalid wall-clock resolution") }
          nanos = time.seconds * 1000000000 + u32.toU64(time.nanoseconds)
        }
        if nanos == 0 { Intrinsic.trap("WasiClock.resolution: zero resolution") }
        return nanos
      } else {
      let mut clock: u32 = 0
      if monotonic {
        clock = 1
      }
      let mut time: u64 = 0
      let status = unsafe preview1.clock_res_get(clock, Pointer.fromMutRef(&mut time))
      if status != 0 || time == 0 {
        Intrinsic.trap("WasiClock.resolution: the host clock_res_get call failed or returned zero")
      }
      return time
      }
    }

    /// Blocks until the monotonic deadline. A negative or unrepresentable deadline traps.
    /// Interrupted waits keep the same deadline. A host failure traps.
    pub effect fn waitUntil(when: Instant) -> () {
      let seconds = SystemClock.seconds(&when)
      let nanoseconds = SystemClock.nanoseconds(&when)
      if seconds < 0 {
        Intrinsic.trap("WasiClock.waitUntil: the deadline is negative")
      }
      if i64.toU64(seconds) > (u64.MAX - i64.toU64(nanoseconds)) / 1000000000 { Intrinsic.trap("WasiClock.waitUntil: deadline exceeds host timestamp range") }
      let timeout = i64.toU64(seconds) * 1000000000 + i64.toU64(nanoseconds)
      static if Intrinsic.profileText("target") == "wasm32-wasip2" {
        let pollable = unsafe preview2.clocks_monotonic_clock_subscribe_instant(timeout)
        unsafe preview2.io_poll_pollable_block(pollable)
        unsafe preview2.io_poll_drop_pollable(pollable)
        return ()
      } else {
      let subscriptions = [
        Subscription {
          userdata: 0,
          kind: 0,
          reserved: [0; 7],
          clock: 1,
          timeout: timeout,
          precision: 1,
          flags: 1
        }
      ]
      let mut events = [Event { userdata: 0, error: 0, kind: 0, bytes: 0, flags: 0 }]
      let mut count: u32 = 0
      while true {
        let status = unsafe preview1.poll_oneoff(
          Pointer.fromSlice(&subscriptions),
          Pointer.fromMutSlice(&mut events),
          1,
          Pointer.fromMutRef(&mut count)
        )
        if status != 27 {
          if status != 0 || count != 1 || events[0].error != 0 || events[0].kind != 0 {
            Intrinsic.trap(
              "WasiClock.waitUntil: the host poll_oneoff call failed or returned an invalid event"
            )
          }
          return ()
        }
      }
      return ()
      }
    }
  }
}
