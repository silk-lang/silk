//! The command entry for WASI Preview 1 and Preview 2.
//!
//! # Details
//! The application can return `i32`, `()`, or an Effect with either result.
//! An Effect can require `HostInput`; the entry supplies an owned argument and environment snapshot.
//! Each error of the Effect must implement `Debug`. Other services require explicit providers.
//! Success returns the application status, or zero for `()`. Cleanup completes before the WASI exit
//! call. The application must satisfy `Intrinsic.NonParking`. A parked execution returns status one.
//!
//! An unhandled error prints a report to standard error and returns status one. The report has at
//! most 4096 bytes and 32 frames, and ends with an `unhandled value:` line that holds the error's
//! `Debug` form, cut to 1024 bytes.
//!
//! # Gotchas
//! - A trap prints `fatal trap: ` with its reason and site to standard error, then stops the
//!   program without cleanup. A WASI program cannot walk its own stack, so the runtime's own trace,
//!   such as Wasmtime's `wasm backtrace`, lists the calling functions.
//!
//! @category Native platform

static if Intrinsic.targetOperatingSystem() == "wasi" {
  import Intrinsic.application
  import silk.mem.allocator { Allocator, OutOfMemoryError }
  import silk.core.effect { Effect }
  import silk.concurrency.execution { Execution }
  import silk.system.host_input { HostInput, HostInputError }
  import silk.platform.wasi.host_input { WasiHostInput }
  import silk.platform.wasi.preview1
  import silk.platform.native.diagnostics { NativeDiagnostics }
  import silk.platform.native.report { ErrorForm, NativeReport }
  import silk.text.format { Debug }
  import silk.num.i32
  import silk.num.usize
  struct Application<T> {}
  interface EntryResult<T> {
    fn code(value: T, inputs: &mut WasiHostInput) -> i32
  }
  impl EntryResult<i32> for Application<i32> {
    fn code(value: i32, inputs: &mut WasiHostInput) -> i32 {
      return value
    }
  }
  impl EntryResult<()> for Application<()> {
    fn code(value: (), inputs: &mut WasiHostInput) -> i32 {
      return 0
    }
  }

  // Reports an unhandled error, then writes the line `unhandled value: ` with its `Debug` form.
  effect<'env> fn failed<E: Debug + 'env, 'env>(error: E) -> i32 {
    let value = run ErrorForm.capture<E>(&error)
    // The observer requires the error to be dropped before it reports it.
    drop error
    let status = usize.toI32(Intrinsic.observeUnhandled())
    let _written = run ErrorForm.write(&value, 2)
    return status
  }

  effect fn succeeded(value: ()) -> i32 {
    return 0
  }
  impl<'env, E: Debug> EntryResult<Effect<'env; () ! E>> for Application<Effect<'env; () ! E>> {
    fn code(value: Effect<'env; () ! E>, inputs: &mut WasiHostInput) -> i32 {
      let computation = Effect.flatMap(move value, succeeded)
      return run Effect.catchAll(move computation, failed)
    }
  }

  effect fn succeededStatus(value: i32) -> i32 {
    return value
  }
  impl<'env, E: Debug> EntryResult<Effect<'env; () ! E ? &mut HostInput>> for Application<
    Effect<'env; () ! E ? &mut HostInput>,
  > {
    fn code(value: Effect<'env; () ! E ? &mut HostInput>, inputs: &mut WasiHostInput) -> i32 {
      let supplied = Effect.provideMut<HostInput>(move value, move inputs)
      let computation = Effect.flatMap(move supplied, succeeded)
      return run Effect.catchAll(move computation, failed)
    }
  }
  impl<'env, E: Debug> EntryResult<Effect<'env; i32 ! E>> for Application<Effect<'env; i32 ! E>> {
    fn code(value: Effect<'env; i32 ! E>, inputs: &mut WasiHostInput) -> i32 {
      let computation = Effect.flatMap(move value, succeededStatus)
      return run Effect.catchAll(move computation, failed)
    }
  }
  impl<'env, E: Debug> EntryResult<Effect<'env; i32 ! E ? &mut HostInput>> for Application<
    Effect<'env; i32 ! E ? &mut HostInput>,
  > {
    fn code(value: Effect<'env; i32 ! E ? &mut HostInput>, inputs: &mut WasiHostInput) -> i32 {
      let supplied = Effect.provideMut<HostInput>(move value, move inputs)
      let computation = Effect.flatMap(move supplied, succeededStatus)
      return run Effect.catchAll(move computation, failed)
    }
  }

  fn select<T>(value: &T) -> Application<T> {
    return Application<T> {}
  }

  fn adapt<T, P: EntryResult<T>>(value: T, provider: P, inputs: &mut WasiHostInput) -> i32 {
    return EntryResult<T>.code(move value, move inputs)
  }

  fn invokeApplication(inputs: WasiHostInput) -> i32 {
    let mut host = move inputs
    let value = application.main()
    let provider = select(&value)
    return adapt(move value, move provider, &mut host)
  }

  fn invoke<F: fn<'static>(WasiHostInput) -> i32 + Intrinsic.NonParking>(
    body: F,
    inputs: WasiHostInput
  ) -> i32 {
    return body(move inputs)
  }

  effect fn observedApplication(inputs: WasiHostInput) -> i32 {
    let observer = run NativeDiagnostics.make(NativeReport.make(2, 4096, 32), 64)
    return run NativeDiagnostics.observe(
      move observer,
      effect {
        return invoke(invokeApplication, move inputs)
      },
    )
  }

  struct EntrySuspended {}
  struct Status {
    complete: bool,
    code: i32,
  }

  fn ready(state: &()) -> () {}

  fn complete(state: &mut Status, code: i32) -> () {
    state.complete = true
    state.code = code
  }

  fn suspended(state: &mut Status, execution: Intrinsic.Execution<i32>) -> () {
    drop execution
  }

  effect fn start() -> i32
    ! OutOfMemoryError | HostInputError | EntrySuspended {
    let mut allocator = Allocator.systemAllocatorProvider()
    let inputs = run WasiHostInput.capture() |> Effect.provideMut<Allocator>(&mut allocator)
    let execution = run Execution.make(observedApplication(move inputs), (), ready)
      |> Effect.provideMut<Allocator>(&mut allocator)
    let mut status = Status { complete: false, code: 0 }
    run Execution.drive(move execution, &mut status, complete, suspended)
    if status.complete == false {
      fail EntrySuspended {}
    }
    return status.code
  }

  // The start code's own errors are reported without their value.
  effect<'env> fn startFailed<E: 'env, 'env>(error: E) -> i32 {
    drop error
    return usize.toI32(Intrinsic.observeUnhandled())
  }

  effect fn startup() -> i32 {
    return run Effect.catchAll(start(), startFailed)
  }

  /// Runs the application, releases its execution, and exits with its status through WASI.
  /// The host calls this exported `_start` function once per command instance.
  ///
  /// If the start code fails, for example when it cannot copy the arguments, the status is 1.
  export "C" fn enter() -> () as "_start" {
    let observer = run NativeDiagnostics.make(NativeReport.make(2, 4096, 32), 0)
    let code = run NativeDiagnostics.observe(move observer, startup())
    unsafe preview1.proc_exit(i32.toU32(i32.bitAnd(code, 255)))
    return ()
  }
}
