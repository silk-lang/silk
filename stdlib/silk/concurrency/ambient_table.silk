//! Storage shared by lexical providers and captured executions.

import silk.core.option { Option }
import silk.mem.pointer { Pointer }
import silk.core.ownership { Copy }

/// The active span and its execution-local record.
pub struct TraceContext {
  /// High half of the trace identifier.
  pub traceHigh: u64,
  /// Low half of the trace identifier.
  pub traceLow: u64,
  /// The current span identifier.
  pub span: u64,
  /// Sampling flags and local span depth.
  pub flags: u64,
  /// Identifies the recorder that owns the current span.
  pub owner: u64,
  /// The local open record address, or zero for an inherited span.
  pub record: u64,
}

/// The ambient dispatcher indexes the leading array. The active execution owns the context.
pub struct AmbientTable {
  /// Indexed provider handles consumed by ambient dispatch.
  pub entries: [?*const u8; Intrinsic.ambientCount()],
  /// The context inherited by executions created under this table.
  pub context: TraceContext,
}

impl Copy for TraceContext {}
impl Copy for AmbientTable {}

impl TraceContext {
  /// An execution with no open span has zero identifiers and no recorder.
  @inlineAlways
  pub fn empty() -> Self { return TraceContext {traceHigh: 0, traceLow: 0, span: 0, flags: 0, owner: 0, record: 0} }

  /// Identifies the installed table across a suspension, or zero outside an ambient scope.
  @inlineAlways
  pub fn tableAddress() -> usize {
    return Pointer.address(unsafe Pointer.read(Intrinsic.ambientSlot<AmbientTable>()))
  }

  /// Copies all six words from the installed execution. Returns an empty context outside a provider.
  @inlineAlways
  pub fn read() -> Self {
    let slot = Intrinsic.ambientSlot<AmbientTable>()
    if let Option<*const AmbientTable>.Some {value} = Pointer.nonNull(unsafe Pointer.read(slot)) {
      let table = unsafe Pointer.borrow(&slot, value)
      return table.context
    }
    return TraceContext.empty()
  }

  /// Replaces the context of the current execution while its ambient table is installed.
  ///
  /// # Safety
  /// The caller must own this execution's context. A nonzero record must still belong to the
  /// recorder and execution that opened it. A saved context can only be restored to that scope.
  @inlineAlways
  pub unsafe fn install(context: &Self) -> () {
    // Providers and execution frames install mutable tables and drive them on one thread at a time.
    let slot = Intrinsic.ambientSlot<AmbientTable>()
    let address = unsafe Pointer.castMut<?*const AmbientTable, ?*mut AmbientTable>(slot)
    let mut anchor = ()
    if let Option<*mut AmbientTable>.Some {value} = Pointer.nonNullMut(unsafe Pointer.read(address)) {
      let table = unsafe Pointer.borrowMut(&mut anchor, value)
      table.context = context.*
    }
  }
}
