//! Storage for the private execution frames that the compiler makes.
//!
//! # When to use
//! The compiler and the runtime use this module through its C exports. Application code does not
//! call it.
//!
//! # Details
//! Each [`ExecutionStorage`] state owns its limit, its accounting and its frames. There is no
//! shared counter and no environment lookup. A state is a stack: frames are carved one after
//! another from segments, and released in reverse order, so a callee's frame sits right after its
//! caller's and costs no allocation of its own. The first segment comes with the state; a frame
//! that does not fit starts a segment twice the size of the last, which stays for reuse once it
//! empties. Segments use the declared allocator of the selected target.
//!
//! # Errors
//! [`ExecutionStorage.make`] fails with `OutOfMemoryError`. [`ExecutionStorage.acquire`] returns
//! null when a frame does not fit in the limit or cannot be allocated.
//!
//! # Gotchas
//! - Raw frame access is unsafe. A frame is valid only until it is released or its state is
//!   destroyed.
//! - Frames are released last first; releasing any other frame corrupts the state.
//! - One state needs exclusive use. Independent states can use a concurrent host allocator.
//!
//! @category Concurrency

static if (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.profileText(
  "libc",
) == "gnu") || Intrinsic.targetObjectFormat() == "wasm" || (Intrinsic.targetOperatingSystem() == "windows" && Intrinsic.profileText("libc") == "system") {
  import silk.core.ownership {Copy, Drop}
  import silk.mem.pointer {Pointer}
  import silk.mem.layout {Layout}
  import silk.mem.allocator {OutOfMemoryError}
  import silk.core.effect {Effect}
  import silk.num.usize
  static if Intrinsic.targetOperatingSystem() == "windows" {
    import silk.platform.windows.heap {WindowsHeap}
    unsafe fn allocate(size: usize) -> ?*mut u8 { return WindowsHeap.acquire(size) }
    unsafe fn deallocate(pointer: ?*mut u8) -> () { unsafe WindowsHeap.release(pointer) }
  } else {
    unsafe extern "C" fn malloc(size: usize) -> ?*mut u8
    unsafe extern "C" fn free(pointer: ?*mut u8) -> ()
    unsafe fn allocate(size: usize) -> ?*mut u8 { return unsafe malloc(size) }
    unsafe fn deallocate(pointer: ?*mut u8) -> () { unsafe free(pointer) }
  }
  // One segment of a state's frame stack: frames are carved from its payload, which follows this
  // header, in acquisition order. `below` is the offset the previous segment had when this one
  // became current; `next` is a segment kept for reuse after this one emptied.
  extern "C" struct Segment {
    previous: ?*mut Segment,
    next: ?*mut Segment,
    capacity: usize,
    below: usize,
  }
  impl Copy for Segment {}
  // A state: the current segment, its payload and capacity, the bytes used in it, the charge and
  // its limit. The first segment follows this header in the same allocation.
  extern "C" struct Accounting {
    base: ?*mut u8,
    offset: usize,
    capacity: usize,
    current: ?*mut Segment,
    used: usize,
    limit: usize,
  }
  impl Copy for Accounting {}
  /// An affine state that owns its private-frame reservations and capacity limit.
  pub struct ExecutionStorage {
    handle: ?*mut u8,
  }
  impl Drop for ExecutionStorage {
    fn drop(self: &mut ExecutionStorage) -> () {
      let handle = Intrinsic.replace(self.handle, Pointer.null<u8>())
      unsafe {
        destroy(handle)
      }
    }
  }
  // The payload bytes of the first segment, which a state allocates with its header. A later
  // segment is four times the one before, or fits the frame that needs it.
  const FIRST: usize = 960
  const GROWTH: usize = 4
  // The word before each frame records the segment offset the frame was carved at.
  const WORD: usize = 8
  unsafe fn accounting(handle: ?*mut u8) -> *mut Accounting {
    unsafe {
      let typed = Intrinsic.pointerReinterpret<?*mut u8, ?*mut Accounting>(handle)
      return Intrinsic.pointerRequalify<?*mut Accounting, *mut Accounting>(typed)
    }
  }
  unsafe fn segment(handle: ?*mut Segment) -> *mut Segment {
    unsafe {
      return Intrinsic.pointerRequalify<?*mut Segment, *mut Segment>(handle)
    }
  }
  unsafe fn bytes<T>(value: *mut T) -> ?*mut u8 {
    unsafe {
      let nullable = Intrinsic.pointerRequalify<*mut T, ?*mut T>(value)
      return Intrinsic.pointerReinterpret<?*mut T, ?*mut u8>(nullable)
    }
  }
  // The byte `offset` bytes after `base`.
  unsafe fn after(base: ?*mut u8, offset: usize) -> ?*mut u8 {
    unsafe {
      let many = Intrinsic.pointerRequalify<?*mut u8, [*]mut u8>(base)
      return Intrinsic.pointerRequalify<*mut u8, ?*mut u8>(Pointer.atMut<u8>(many, offset))
    }
  }
  unsafe fn word(address: ?*mut u8) -> *mut usize {
    unsafe {
      let typed = Intrinsic.pointerReinterpret<?*mut u8, ?*mut usize>(address)
      return Intrinsic.pointerRequalify<?*mut usize, *mut usize>(typed)
    }
  }
  // The first payload byte of `node`.
  unsafe fn payload(node: ?*mut Segment) -> ?*mut u8 {
    unsafe {
      return after(Intrinsic.pointerReinterpret<?*mut Segment, ?*mut u8>(node), Layout.of<Segment>().bytes)
    }
  }
  // The state's own first segment, which follows its header.
  unsafe fn first(handle: ?*mut u8) -> ?*mut Segment {
    unsafe {
      return Intrinsic.pointerReinterpret<?*mut u8, ?*mut Segment>(after(handle, Layout.of<Accounting>().bytes))
    }
  }
  // Where a frame aligned to the power of two `alignment` starts in a payload at address `base`
  // whose bytes up to `offset` are used: after the frame's offset word.
  fn start(base: usize, offset: usize, alignment: usize) -> usize {
    return ((base + offset + WORD + (alignment - 1)) & (usize.MAX - (alignment - 1))) - base
  }
  unsafe fn create(limit: usize) -> ?*mut u8 {
    let handle = unsafe allocate(Layout.of<Accounting>().bytes + Layout.of<Segment>().bytes + FIRST)
    if Pointer.isNull<u8>(handle) {
      return handle
    }
    unsafe {
      let root = first(handle)
      Pointer.write<Segment>(
        segment(root),
        Segment {previous: Pointer.null<Segment>(), next: Pointer.null<Segment>(), capacity: FIRST, below: 0},
      )
      Pointer.write<Accounting>(
        accounting(handle),
        Accounting {base: payload(root), offset: 0, capacity: FIRST, current: root, used: 0, limit: limit},
      )
    }
    return handle
  }
  unsafe fn destroy(handle: ?*mut u8) -> () {
    if Pointer.isNull<u8>(handle) {
      return ()
    }
    unsafe {
      freeFrom(Pointer.read<Segment>(segment(first(handle))).next)
      deallocate(handle)
    }
  }
  // Frees `cursor` and every segment kept after it.
  unsafe fn freeFrom(cursor: ?*mut Segment) -> () {
    let mut at = cursor
    while Pointer.isNull<Segment>(at) == false {
      unsafe {
        let next = Pointer.read<Segment>(segment(at)).next
        deallocate(bytes<Segment>(segment(at)))
        at = next
      }
    }
  }
  // Whether `acquire` takes a frame of `size` bytes aligned to `alignment`: a nonzero size and a
  // power-of-two alignment, both small enough that its offset arithmetic cannot overflow.
  fn admits(size: usize, alignment: usize) -> bool {
    return size != 0 && size <= usize.MAX / 4 && alignment != 0 && alignment <= usize.MAX / 4
      && (alignment & (alignment - 1)) == 0
  }
  // Carves a frame of `size` bytes aligned to `alignment`, which `admits`, after the frame carved
  // last, or returns null when the charge would pass the limit or a segment cannot be allocated.
  @inlineAlways
  unsafe fn acquire(handle: ?*mut u8, size: usize, alignment: usize) -> ?*mut u8 {
    let mut aligned = alignment
    if aligned < WORD {
      aligned = WORD
    }
    unsafe {
      let pointer = accounting(handle)
      let mut state = Pointer.read<Accounting>(pointer)
      let base = Pointer.address<u8>(state.base)
      let mask = aligned - 1
      let at = usize.wrappingSubtract(usize.wrappingAdd(base, state.offset + WORD + mask) & (usize.MAX - mask), base)
      if size > state.capacity || at > state.capacity - size {
        return acquireAhead(pointer, size, aligned)
      }
      let end = at + size
      let charged = usize.wrappingSubtract(end, state.offset)
      if charged > state.limit - state.used {
        return Pointer.null<u8>()
      }
      Pointer.write<usize>(word(after(state.base, usize.wrappingSubtract(at, WORD))), state.offset)
      state.offset = end
      state.used = usize.wrappingAdd(state.used, charged)
      Pointer.write<Accounting>(pointer, state)
      return after(state.base, at)
    }
  }
  // Carves a frame that does not fit in the current segment from the start of the next one: the
  // kept one when it is large enough, or a new one, which replaces a kept one too small.
  @cold
  unsafe fn acquireAhead(pointer: *mut Accounting, size: usize, alignment: usize) -> ?*mut u8 {
    unsafe {
      let mut state = Pointer.read<Accounting>(pointer)
      let need = WORD + (alignment - 1) + size
      if need > state.limit - state.used {
        return Pointer.null<u8>()
      }
      let current = segment(state.current)
      let mut here = Pointer.read<Segment>(current)
      let mut next = here.next
      if Pointer.isNull<Segment>(next) == false && Pointer.read<Segment>(segment(next)).capacity < need {
        freeFrom(next)
        next = Pointer.null<Segment>()
      }
      if Pointer.isNull<Segment>(next) {
        let mut capacity = need
        if here.capacity <= usize.MAX / GROWTH && here.capacity * GROWTH > capacity {
          capacity = here.capacity * GROWTH
        }
        let header = Layout.of<Segment>().bytes
        if capacity > usize.MAX - header {
          return Pointer.null<u8>()
        }
        let allocation = allocate(header + capacity)
        if Pointer.isNull<u8>(allocation) {
          return Pointer.null<u8>()
        }
        next = Intrinsic.pointerReinterpret<?*mut u8, ?*mut Segment>(allocation)
        here.next = next
        Pointer.write<Segment>(current, here)
        Pointer.write<Segment>(
          segment(next),
          Segment {previous: state.current, next: Pointer.null<Segment>(), capacity: capacity, below: 0},
        )
      }
      let mut fresh = Pointer.read<Segment>(segment(next))
      fresh.below = state.offset
      Pointer.write<Segment>(segment(next), fresh)
      let base = payload(next)
      let at = start(Pointer.address<u8>(base), 0, alignment)
      Pointer.write<usize>(word(after(base, at - WORD)), 0)
      state.base = base
      state.capacity = fresh.capacity
      state.current = next
      state.offset = at + size
      state.used = state.used + at + size
      Pointer.write<Accounting>(pointer, state)
      return after(base, at)
    }
  }
  // Frames are released in reverse acquisition order, so the frame released is the last one
  // carved: the state returns to the offset recorded before it, and an emptied segment gives way
  // to the one before it, after which it stays kept.
  @inlineAlways
  unsafe fn release(handle: ?*mut u8, frame: ?*mut u8) -> () {
    unsafe {
      let pointer = accounting(handle)
      let mut state = Pointer.read<Accounting>(pointer)
      let at = Pointer.address<u8>(frame) - Pointer.address<u8>(state.base)
      let previous = Pointer.read<usize>(word(after(state.base, at - WORD)))
      state.used = state.used - (state.offset - previous)
      state.offset = previous
      if previous == 0 {
        let here = Pointer.read<Segment>(segment(state.current))
        if Pointer.isNull<Segment>(here.previous) == false {
          let below = Pointer.read<Segment>(segment(here.previous))
          state.current = here.previous
          state.base = payload(here.previous)
          state.capacity = below.capacity
          state.offset = here.below
        }
      }
      Pointer.write<Accounting>(pointer, state)
    }
  }
  impl ExecutionStorage {
    /// Creates an independent state whose frame reservations can charge at most `limit` bytes.
    ///
    /// # Details
    ///
    /// Charges include each frame's offset word and alignment padding. The state allocation,
    /// which holds the first segment, is excluded. Refusal acquires no state and reports
    /// OutOfMemoryError.
    pub effect fn make(limit: usize) -> ExecutionStorage ! OutOfMemoryError {
      let handle = unsafe create(limit)
      if Pointer.isNull<u8>(handle) {
        fail OutOfMemoryError {}
      }
      return ExecutionStorage {handle: handle}
    }
    /// Returns the bytes charged to this state's current frame reservations.
    pub fn used(self: &ExecutionStorage) -> usize {
      unsafe {
        return Pointer.read<Accounting>(accounting(self.handle)).used
      }
    }
    /// Acquires a fixed-address frame or returns null without retaining a partial reservation.
    ///
    /// # Gotchas
    ///
    /// The caller must initialize bytes before reading, obey the requested extent, and stop using
    /// the pointer before release or state destruction. A zero size or invalid alignment returns
    /// null.
    pub unsafe fn acquire(self: &mut ExecutionStorage, size: usize, alignment: usize) -> ?*mut u8 {
      if !admits(size, alignment) {
        return Pointer.null<u8>()
      }
      unsafe {
        return acquire(self.handle, size, alignment)
      }
    }
    /// Releases the frame this state acquired last and removes its charge.
    ///
    /// # Gotchas
    ///
    /// Frames are released in reverse acquisition order: `frame` must be the live frame acquired
    /// last. The caller must finish semantic cleanup and stop every access before releasing it.
    pub unsafe fn release(self: &mut ExecutionStorage, frame: ?*mut u8) -> () {
      unsafe {
        return release(self.handle, frame)
      }
    }
  }
  effect fn createDefault() -> ?*mut u8 ! OutOfMemoryError {
    let mut owner = run ExecutionStorage.make(usize.MAX)
    return Intrinsic.replace(owner.handle, Pointer.null<u8>())
  }
  effect fn refused(error: OutOfMemoryError) -> ?*mut u8 {
    return Pointer.null<u8>()
  }
  /// Acquires the default component's independent, explicitly unlimited storage state.
  export "C" fn silk_execution_storage_create() -> ?*mut u8 {
    return run Effect.catchAll(createDefault(), refused)
  }
  /// Acquires a frame for a live state previously returned by the component's create operation.
  /// The compiler asks for a nonzero size and a power-of-two alignment of at most a page.
  export "C" fn silk_execution_storage_acquire(state: ?*mut u8, size: usize, alignment: usize) -> ?*mut u8 {
    if !admits(size, alignment) {
      return Pointer.null<u8>()
    }
    unsafe {
      return acquire(state, size, alignment)
    }
  }
  /// Releases the frame acquired last after compiler-owned semantic cleanup has completed.
  export "C" fn silk_execution_storage_release(state: ?*mut u8, frame: ?*mut u8) -> () {
    unsafe {
      return release(state, frame)
    }
  }
  /// Destroys a state after the compiler has released every semantically live frame.
  export "C" fn silk_execution_storage_destroy(state: ?*mut u8) -> () {
    unsafe {
      return destroy(state)
    }
  }
}
