//! A work-stealing pool of native threads that runs fibers in parallel.
//!
//! # When to use
//! 1. Call [`ThreadPool.make`] to start the worker threads.
//! 2. Call [`Pool.block`] on a normal thread to run a program on the pool.
//! 3. In a fiber, start more fibers with [`Pool.fork`], and wait for one with [`PoolFiber.join`]
//!    or [`PoolFiber.await`].
//! 4. Stop a fiber and get its final outcome with [`PoolFiber.interrupt`].
//!
//! # Details
//! A pool fiber is a `Transferable` lazy effect, packaged with `Execution.makeTransferable`. Thus
//! a fiber can start on one worker, park, and continue on a different worker. Its outcome is the
//! same `Outcome` that `silk.concurrency.fiber` uses: success, typed failure, or `Cancelled`.
//!
//! A ready fiber goes on one shared ready list. An idle worker moves a batch of ready fibers into
//! its own `WorkDeque`. A worker with nothing to do steals from the deques of the other workers,
//! and then sleeps on a `Parker`. When a parked fiber wakes, it goes back on the ready list and a
//! sleeping worker wakes. Thus no worker spins.
//!
//! [`PoolFiber.interrupt`] marks the fiber for cancellation and waits for it. A parked fiber is
//! cancelled by the next worker that takes it: the worker drops the parked frames, which runs their `Drop` cleanup, and
//! the outcome is `Cancelled`. A running fiber is cancelled the next time it parks, for example in
//! [`Pool.yieldNow`] or [`PoolFiber.join`].
//!
//! A [`Pool`] is a small `Transferable` handle that fibers capture to fork more fibers. The
//! [`ThreadPool`] owns the threads. Dropping it stops and joins each worker, and cancels the
//! fibers that are not finished.
//!
//! # Errors
//! - [`ThreadPool.make`] fails with `SpawnError` or `OutOfMemoryError`.
//! - [`Pool.fork`] fails with `OutOfMemoryError`.
//! - [`Pool.block`] and [`PoolFiber.join`] raise the typed failure of the fiber unchanged, or
//!   `Cancelled`. [`PoolFiber.await`] returns them as data.
//!
//! # Gotchas
//! - Fiber bodies, results and failures must be `Transferable` and `'static`.
//! - In a fiber, wait for anything other than a [`PoolFiber`] with `Execution.parkTransferable`. A
//!   call that blocks the native thread, such as [`Pool.block`], holds up a whole worker.
//! - Call [`PoolFiber.join`], [`PoolFiber.await`], [`PoolFiber.interrupt`] and [`Pool.yieldNow`]
//!   only from inside a pool fiber.
//! - A fiber that never parks runs to the end, even after an interrupt.
//! - The pool uses the system allocator for its own storage, not the `Allocator` of the caller.
//!
//! # Examples
//! ## Sum two halves in parallel
//! ```silk
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.core.effect { Effect }
//! import silk.concurrency.fiber { Cancelled }
//! import silk.concurrency.thread_native { SpawnError }
//! import silk.concurrency.thread_pool { Pool, ThreadPool }
//!
//! effect fn sumRange(from: i64, to: i64) -> i64 {
//!   let mut total: i64 = 0
//!   let mut at = from
//!   while at < to {
//!     total = total + at
//!     at = at + 1
//!   }
//!   return total
//! }
//!
//! // Runs the low half as a new fiber, and the high half in this fiber.
//! effect fn both(pool: Pool) -> i64
//!   ! OutOfMemoryError | Cancelled {
//!   let low = run pool.fork(sumRange(0, 500))
//!   let high = run sumRange(500, 1001)
//!   let lowValue = run low.join()
//!   return lowValue + high
//! }
//!
//! effect fn program() -> i32
//!   ! OutOfMemoryError | SpawnError | Cancelled {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let threads = run ThreadPool.make(4) |> Effect.provideMut<Allocator>(&mut allocator)
//!   let pool = threads.pool()
//!   let value = run pool.block(both(pool.clone()))
//!   if value != 500500 {
//!     return 1
//!   }
//!   return 0
//! }
//!
//! effect fn failed<E>(error: E) -> i32 {
//!   drop error
//!   return 1
//! }
//!
//! pub fn main() -> i32 {
//!   return run Effect.catchAll(program(), failed)
//! }
//! ```
//!
//! ## Interrupt a fiber that waits forever
//! ```silk
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.core.effect { Effect }
//! import silk.concurrency.execution { Execution, TransferableWake }
//! import silk.concurrency.fiber { Cancelled, Outcome }
//! import silk.concurrency.thread_native { SpawnError }
//! import silk.concurrency.thread_pool { Pool, ThreadPool }
//!
//! // Parks and drops its Wake, so nothing ever resumes it.
//! effect fn forever() -> i32 {
//!   run Execution.parkTransferable(fn(wake: TransferableWake) -> () {
//!     drop wake
//!     return ()
//!   })
//!   return 1
//! }
//!
//! effect fn stopOne(pool: Pool) -> i32
//!   ! OutOfMemoryError {
//!   let stuck = run pool.fork(forever())
//!   let outcome = run stuck.interrupt()
//!   let Outcome<i32, never> { value } = move outcome
//!   return match move value {
//!     Cancelled {} => 0
//!     _ => 1
//!   }
//! }
//!
//! effect fn program() -> i32
//!   ! OutOfMemoryError | SpawnError | Cancelled {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let threads = run ThreadPool.make(2) |> Effect.provideMut<Allocator>(&mut allocator)
//!   let pool = threads.pool()
//!   return run pool.block(stopOne(pool.clone()))
//! }
//!
//! effect fn failed<E>(error: E) -> i32 {
//!   drop error
//!   return 1
//! }
//!
//! pub fn main() -> i32 {
//!   return run Effect.catchAll(program(), failed)
//! }
//! ```
//!
//! @category Concurrency

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.concurrency.execution { Execution, TransferableExecution, TransferableWake }
import silk.concurrency.fiber { Cancelled, Failure, Outcome, Success }
import silk.collections.list { List }
import silk.concurrency.thread_native { JoinHandle, NativeThread, SpawnError }
import silk.core.option { Option }
import silk.core.ownership { Drop }
import silk.core.result { Result }
import silk.concurrency.sync { Arc, Mutex, Parker, Unparker }
import silk.concurrency.thread { Concurrent, Transferable }
import silk.num.usize
import silk.concurrency.work_queue { Steal, Stealer, WorkDeque, Worker }

// A fiber's completion. `Running` holds whoever waits for it: a parked fiber or a blocked thread.
struct NoWaiter {}
struct FiberWaiter { wake: TransferableWake }
struct ThreadWaiter { unparker: Unparker }
struct Running { waiter: NoWaiter | FiberWaiter | ThreadWaiter }
struct Done<A, E> { value: Success<A> | Failure<E> | Cancelled }
struct Collected {}
struct Completion<A, E> { phase: Running | Done<A, E> | Collected }

/// The handle of one pool fiber, which gives back its outcome and can interrupt it.
///
/// # Details
/// A handle is `Transferable` when `A` and `E` are. It has one observer: [`await`] and [`join`]
/// consume it. Dropping it detaches the fiber, which still runs.
pub struct PoolFiber<A, E> {
  completion: Arc<Mutex<Completion<A, E>>>,
  pool: Arc<PoolShared>,
  id: usize,
  ticket: usize,
}

impl<A, E> PoolFiber<A, E> {
  /// Parks the calling fiber until this fiber ends, then returns its success, typed failure, or
  /// cancellation as data.
  ///
  /// # Gotchas
  /// Only a pool fiber can await. An await from any other place is a fatal state trap.
  pub effect fn await(self: Self) -> Outcome<A, E> {
    let PoolFiber<A, E> { completion, pool, id, ticket } = move self
    drop pool
    while true {
      let taken = takeDone<A, E>(completion.get())
      if let Option<Outcome<A, E>>.Some { value } = move taken { return move value }
      run Execution.parkTransferable(fn(wake: TransferableWake) -> () {
        return awaitCompletion<A, E>(completion.get(), move wake)
      })
    }
    return unreachable<Outcome<A, E>>()
  }

  /// Parks the calling fiber until this fiber ends, then returns its success value.
  ///
  /// # Details
  /// The typed failure of the fiber is raised unchanged. Cancellation raises `Cancelled`.
  ///
  /// # Gotchas
  /// Only a pool fiber can join. A join from any other place is a fatal state trap.
  pub effect fn join(self: Self) -> A ! E | Cancelled {
    let outcome = run PoolFiber<A, E>.await(move self)
    return run raise<A, E>(move outcome)
  }

  /// Cancels this fiber unless it already finished, waits until it has stopped, and returns its
  /// final outcome.
  ///
  /// # Details
  /// A parked fiber is cancelled by the next worker that takes it. A running fiber is cancelled
  /// the next time it parks. Cancellation drops the fiber's frames, which runs their `Drop`
  /// cleanup, and the outcome is `Cancelled`. A fiber that finished first keeps its success or
  /// typed failure.
  ///
  /// # Gotchas
  /// - Only a pool fiber can interrupt. An interrupt from any other place is a fatal state trap.
  /// - A fiber that never parks runs to the end, so the interrupt waits for that.
  pub effect fn interrupt(self: Self) -> Outcome<A, E> {
    requestCancel(self.pool.get(), self.id, self.ticket)
    return run PoolFiber<A, E>.await(move self)
  }
}

// Takes a finished outcome, leaving `Collected`, or puts a running phase back.
fn takeDone<A, E>(completion: &Mutex<Completion<A, E>>) -> Option<Outcome<A, E>> {
  let mut guard = completion.lock()
  let state = guard.getMut()
  let phase = Intrinsic.replace(state.phase, Collected {})
  return match move phase {
    Done<A, E> { value } => Option<Outcome<A, E>>.some(Outcome<A, E> { value: move value })
    Running waiting => keepRunning<A, E>(&mut state.*, move waiting)
    Collected nothing => Option<Outcome<A, E>>.none()
  }
}

fn keepRunning<A, E>(state: &mut Completion<A, E>, running: Running) -> Option<Outcome<A, E>> {
  state.phase = move running
  return Option<Outcome<A, E>>.none()
}

// Registers a parked waiter, or wakes it at once when the fiber ended in the meantime. A wake
// while the waiter is still registering is latched until its worker holds it again.
fn awaitCompletion<A, E>(completion: &Mutex<Completion<A, E>>, wake: TransferableWake) -> () {
  let mut guard = completion.lock()
  let state = guard.getMut()
  let phase = Intrinsic.replace(state.phase, Collected {})
  return match move phase {
    Running ignored => keepWaiting<A, E>(&mut state.*, FiberWaiter { wake: move wake })
    Done<A, E> done => wakeNow<A, E>(&mut state.*, move done, move wake)
    Collected nothing => ()
  }
}

fn keepWaiting<A, E>(state: &mut Completion<A, E>, waiter: FiberWaiter) -> () {
  state.phase = Running { waiter: move waiter }
  return ()
}

fn wakeNow<A, E>(state: &mut Completion<A, E>, done: Done<A, E>, wake: TransferableWake) -> () {
  state.phase = move done
  Execution.wakeTransferable(move wake)
  return ()
}

// Records the first outcome and wakes the waiter. A later outcome is dropped.
fn complete<A, E>(completion: &Mutex<Completion<A, E>>, value: Success<A> | Failure<E> | Cancelled) -> () {
  let mut guard = completion.lock()
  let state = guard.getMut()
  let phase = Intrinsic.replace(state.phase, Collected {})
  return match move phase {
    Running { waiter } => publish<A, E>(&mut state.*, move value, move waiter)
    Done<A, E> first => keepFirst<A, E>(&mut state.*, move first)
    Collected nothing => ()
  }
}

fn publish<A, E>(
  state: &mut Completion<A, E>,
  value: Success<A> | Failure<E> | Cancelled,
  waiter: NoWaiter | FiberWaiter | ThreadWaiter,
) -> () {
  state.phase = Done<A, E> { value: move value }
  return notify(move waiter)
}

fn keepFirst<A, E>(state: &mut Completion<A, E>, first: Done<A, E>) -> () {
  state.phase = move first
  return ()
}

fn notify(waiter: NoWaiter | FiberWaiter | ThreadWaiter) -> () {
  return match move waiter {
    NoWaiter nothing => ()
    FiberWaiter { wake } => Execution.wakeTransferable(move wake)
    ThreadWaiter { unparker } => unparker.unpark()
  }
}

effect<'env> fn raise<A, E: 'env, 'env>(outcome: Outcome<A, E>) -> A ! E | Cancelled {
  let Outcome<A, E> { value } = move outcome
  return match move value {
    Success<A> { value: success } => move success
    Failure<E> { error } => run raiseFailure<A, E>(move error)
    Cancelled {} => run raiseCancellation<A>()
  }
}

effect<'env> fn raiseFailure<A, E: 'env, 'env>(error: E) -> A ! E {
  fail move error
}

effect fn raiseCancellation<A>() -> A ! Cancelled {
  fail Cancelled {}
}

// The fiber body owns this guard. Dropping the body before it completes, by an interrupt or by
// the pool's drop, runs the cancel exits, and this records `Cancelled` and wakes the waiter.
struct CompletionGuard<A, E> {
  completion: Arc<Mutex<Completion<A, E>>>,
}

impl<A, E> Drop for CompletionGuard<A, E> {
  fn drop(self: &mut CompletionGuard<A, E>) -> () {
    complete<A, E>(self.completion.get(), Cancelled {})
    return ()
  }
}

// The pool's fiber table. Slot indices are fiber ids; `next` links the ready list and the free
// list. `ticket` changes whenever a slot's fiber goes away, so a late wake or interrupt for it
// does nothing. `queued` is true from the ready list until a worker takes the fiber, so a fiber
// is never on the ready list twice.
struct Vacant {}
struct Parked { execution: TransferableExecution<()> }
struct Taken {}
struct Slot {
  task: Vacant | Parked | Taken,
  next: usize,
  ticket: usize,
  queued: bool,
  cancel: bool,
}

struct PoolState {
  slots: List<Slot>,
  head: usize,
  tail: usize,
  free: usize,
  // Which workers are asleep, or about to be, waiting for work.
  idle: List<bool>,
  shutdown: bool,
}

struct PoolShared {
  state: Mutex<PoolState>,
  unparkers: List<Unparker>,
}

fn none() -> usize { return usize.MAX }

// Appends `id` to the ready list and returns a sleeping worker to wake, or `none`.
fn link(state: &mut PoolState, id: usize) -> usize {
  let tail = state.tail
  let slots = List<Slot>.asMutSlice(&mut state.slots)
  slots[id].next = none()
  slots[id].queued = true
  if tail == none() {
    state.head = id
  } else {
    slots[tail].next = id
  }
  state.tail = id
  return takeIdle(&mut state.*)
}

fn takeIdle(state: &mut PoolState) -> usize {
  let flags = List<bool>.asMutSlice(&mut state.idle)
  let mut at = usize.ZERO
  while at < flags.length {
    if flags[at] {
      flags[at] = false
      return at
    }
    at = at + 1
  }
  return none()
}

fn unlink(state: &mut PoolState) -> usize {
  let id = state.head
  if id == none() { return id }
  state.head = List<Slot>.asSlice(&state.slots)[id].next
  if state.head == none() { state.tail = none() }
  return id
}

fn wakeWorker(pool: &PoolShared, worker: usize) -> () {
  if worker != none() { List<Unparker>.asSlice(&pool.unparkers)[worker].unpark() }
  return ()
}

// Whether `id` still holds the fiber of `ticket` in a running pool.
fn current(state: &PoolState, id: usize, ticket: usize) -> bool {
  if state.shutdown { return false }
  let slots = List<Slot>.asSlice(&state.slots)
  return id < slots.length && slots[id].ticket == ticket
}

fn enqueue(pool: &PoolShared, id: usize, ticket: usize) -> () {
  let mut guard = pool.state.lock()
  let state = guard.getMut()
  if !current(&state.*, id, ticket) { return () }
  if List<Slot>.asSlice(&state.slots)[id].queued { return () }
  let worker = link(&mut state.*, id)
  drop guard
  wakeWorker(pool, worker)
  return ()
}

// Marks the fiber for cancellation. A parked fiber that is not on the ready list goes on it, so
// a worker takes and cancels it.
fn requestCancel(pool: &PoolShared, id: usize, ticket: usize) -> () {
  let mut guard = pool.state.lock()
  let state = guard.getMut()
  if !current(&state.*, id, ticket) { return () }
  let slots = List<Slot>.asMutSlice(&mut state.slots)
  slots[id].cancel = true
  if slots[id].queued { return () }
  if !isParked(&mut slots[id]) { return () }
  let worker = link(&mut state.*, id)
  drop guard
  wakeWorker(pool, worker)
  return ()
}

fn isParked(slot: &mut Slot) -> bool {
  let task = Intrinsic.replace(slot.task, Taken {})
  return match move task {
    Parked { execution } => restore(&mut slot.*, Parked { execution: move execution }, true)
    Vacant nothing => restore(&mut slot.*, Vacant {}, false)
    Taken nothing => false
  }
}

fn restore(slot: &mut Slot, task: Vacant | Parked | Taken, parked: bool) -> bool {
  slot.task = move task
  return parked
}

// The readiness endpoint of every fiber: it runs on the waking thread and must not allocate, so
// it only links the fiber's preallocated slot.
struct TaskHook {
  pool: Arc<PoolShared>,
  id: usize,
  ticket: usize,
}

fn ready(hook: &TaskHook) -> () {
  enqueue(hook.pool.get(), hook.id, hook.ticket)
  return ()
}

struct Reserved { id: usize, ticket: usize }

effect fn reserveSlot(pool: &PoolShared) -> Reserved ! OutOfMemoryError ? &mut Allocator {
  let mut guard = pool.state.lock()
  let state = guard.getMut()
  let id = state.free
  if id != none() {
    let slot = &List<Slot>.asSlice(&state.slots)[id]
    state.free = slot.next
    return Reserved { id: id, ticket: slot.ticket }
  }
  run List<Slot>.append(&mut state.slots, Slot { task: Taken {}, next: none(), ticket: usize.ZERO, queued: false, cancel: false })
  return Reserved { id: List<Slot>.length(&state.slots) - 1, ticket: usize.ZERO }
}

// Puts a slot back on the free list. Its new ticket makes any late wake or interrupt inert.
fn release(state: &mut PoolState, id: usize) -> () {
  let slot = &mut List<Slot>.asMutSlice(&mut state.slots)[id]
  slot.task = Vacant {}
  slot.ticket = slot.ticket + 1
  slot.queued = false
  slot.cancel = false
  slot.next = state.free
  state.free = id
  return ()
}

fn fillSlot(pool: &PoolShared, id: usize, execution: TransferableExecution<()>) -> () {
  let mut guard = pool.state.lock()
  let state = guard.getMut()
  if state.shutdown {
    // A stopped pool runs nothing more. Dropping the fiber here cancels it and drops its hook,
    // which would otherwise keep the pool alive from inside its own table. A slot reserved before
    // `stop` emptied the table is gone already.
    if id < List<Slot>.length(&state.slots) { release(&mut state.*, id) }
    drop guard
    drop execution
    return ()
  }
  let slots = List<Slot>.asMutSlice(&mut state.slots)
  slots[id].task = Parked { execution: move execution }
  let worker = link(&mut state.*, id)
  drop guard
  wakeWorker(pool, worker)
  return ()
}

effect<'static> fn runTask<
  A: 'static + Transferable,
  E: 'static + Transferable,
  F: once Effect<'static; A ! E> + Intrinsic.Detached + Transferable
>(task: F, guard: CompletionGuard<A, E>) -> () {
  let result = run Effect.result(move task)
  return match move result {
    Result<A, E>.Success { value } => complete<A, E>(guard.completion.get(), Success<A> { value: move value })
    Result<A, E>.Failure { error } => complete<A, E>(guard.completion.get(), Failure<E> { error: move error })
  }
}

effect<'env> fn launch<
  'env,
  A: 'static + Transferable,
  E: 'static + Transferable,
  F: once Effect<'static; A ! E> + Intrinsic.Detached + Transferable
>(pool: &Arc<PoolShared>, task: F) -> PoolFiber<A, E> ! OutOfMemoryError ? &mut Allocator {
  let waiting = Completion<A, E> { phase: Running { waiter: NoWaiter {} } }
  let locked = run Mutex<Completion<A, E>>.make(move waiting)
  let completion = run Arc<Mutex<Completion<A, E>>>.make(move locked)
  let Reserved { id, ticket } = run reserveSlot(pool.get())
  let hook = TaskHook { pool: pool.clone(), id: id, ticket: ticket }
  let guard = CompletionGuard<A, E> { completion: completion.clone() }
  let execution = run Execution.makeTransferable(runTask<A, E, F>(move task, move guard), move hook, ready)
  // An Initial execution may be driven directly, so the slot goes on the ready list as it is.
  fillSlot(pool.get(), id, move execution)
  return PoolFiber<A, E> { completion: move completion, pool: pool.clone(), id: id, ticket: ticket }
}

/// A handle to a running pool, which fibers capture to fork more fibers.
///
/// # Details
/// A handle is `Transferable` and `Concurrent`. It does not keep the worker threads running:
/// once the [`ThreadPool`] that made it is dropped, a forked fiber is cancelled before it starts.
pub struct Pool {
  shared: Arc<PoolShared>,
}

impl Pool {
  /// Starts `task` as a new pool fiber and returns the handle that awaits it.
  ///
  /// # Details
  /// The fiber is ready at once. It can start on any worker before this call returns. Its typed
  /// failure `E` is kept in its outcome, for [`PoolFiber.await`] or [`PoolFiber.join`].
  ///
  /// # Gotchas
  /// The body, its result and its failure must be `Transferable` and `'static`. Dropping the
  /// returned handle does not cancel the fiber.
  pub effect<'env> fn fork<
    'env,
    A: 'static + Transferable,
    E: 'static + Transferable,
    F: once Effect<'static; A ! E> + Intrinsic.Detached + Transferable
  >(self: &Self, task: F) -> PoolFiber<A, E> ! OutOfMemoryError {
    let mut allocator = Allocator.systemAllocatorProvider()
    return run launch<A, E, F>(&self.shared, move task) |> Effect.provideMut<Allocator>(&mut allocator)
  }

  /// Runs `task` on the pool and blocks the calling thread until it ends.
  ///
  /// # Details
  /// The typed failure of the fiber is raised unchanged. A fiber cancelled by the pool's drop
  /// raises `Cancelled`.
  ///
  /// # Gotchas
  /// Calling it from a pool fiber blocks that fiber's worker for the whole wait.
  pub effect<'env> fn block<
    'env,
    A: 'static + Transferable,
    E: 'static + Transferable,
    F: once Effect<'static; A ! E> + Intrinsic.Detached + Transferable
  >(self: &Self, task: F) -> A ! OutOfMemoryError | E | Cancelled {
    let fiber = run self.fork<A, E, F>(move task)
    let outcome = run awaitThread<A, E>(move fiber)
    return run raise<A, E>(move outcome)
  }

  /// Returns another handle to the same pool.
  pub fn clone(self: &Self) -> Pool {
    return Pool { shared: self.shared.clone() }
  }

  /// Lets the other ready fibers run before the calling fiber continues.
  ///
  /// # Details
  /// The calling fiber goes to the end of the ready list. An interrupt requested while it ran
  /// cancels it here.
  ///
  /// # Gotchas
  /// Only a pool fiber can yield. A yield from any other place is a fatal state trap.
  pub effect fn yieldNow() -> () {
    run Execution.parkTransferable(fn(wake: TransferableWake) -> () {
      Execution.wakeTransferable(move wake)
      return ()
    })
    return ()
  }
}

// Driving one fiber. The slot is `Taken` while a worker drives it; a parked fiber goes back to
// `Parked` before its wake can relink it, since `drive` publishes readiness only after `suspended`.
struct SlotOwner {
  pool: Arc<PoolShared>,
  id: usize,
}

struct Drive { execution: TransferableExecution<()> }
struct Cancel { execution: TransferableExecution<()> }

// Takes the fiber off its slot. A fiber marked for cancellation gets a new ticket first, so a wake
// racing its drop cannot link the slot again.
fn takeExecution(pool: &PoolShared, id: usize) -> Drive | Cancel {
  let mut guard = pool.state.lock()
  let state = guard.getMut()
  let slot = &mut List<Slot>.asMutSlice(&mut state.slots)[id]
  slot.queued = false
  let task = Intrinsic.replace(slot.task, Taken {})
  let execution = match move task {
    Parked { execution } => move execution
    Vacant nothing => unreachable<TransferableExecution<()>>()
    Taken nothing => unreachable<TransferableExecution<()>>()
  }
  if !slot.cancel { return Drive { execution: move execution } }
  slot.ticket = slot.ticket + 1
  return Cancel { execution: move execution }
}

fn finished(owner: SlotOwner, result: ()) -> () {
  let pool = owner.pool.get()
  let mut guard = pool.state.lock()
  release(guard.getMut(), owner.id)
  return ()
}

// Stores the parked fiber. One marked for cancellation goes straight on the ready list, unless a
// latched wake is about to put it there.
fn suspended(owner: SlotOwner, execution: Intrinsic.Execution<()>) -> () {
  let adopted = TransferableExecution<()>.adopt(move execution)
  let pool = owner.pool.get()
  let mut guard = pool.state.lock()
  let state = guard.getMut()
  let slots = List<Slot>.asMutSlice(&mut state.slots)
  slots[owner.id].task = Parked { execution: move adopted }
  if !slots[owner.id].cancel || slots[owner.id].queued { return () }
  let worker = link(&mut state.*, owner.id)
  drop guard
  wakeWorker(pool, worker)
  return ()
}

effect fn drive(pool: &Arc<PoolShared>, id: usize) -> () {
  return match takeExecution(pool.get(), id) {
    Drive { execution } => run Execution.drive(execution.local(), SlotOwner { pool: pool.clone(), id: id }, finished, suspended)
    Cancel { execution } => cancel(pool.get(), id, move execution)
  }
}

// Drops the fiber's frames outside the pool lock, since their cleanup may fork or interrupt.
fn cancel(pool: &PoolShared, id: usize, execution: TransferableExecution<()>) -> () {
  drop execution
  let mut guard = pool.state.lock()
  release(guard.getMut(), id)
  return ()
}

// One worker thread.
struct WorkerContext {
  pool: Arc<PoolShared>,
  index: usize,
  parker: Parker,
  local: Worker<usize>,
  stealers: List<Stealer<usize>>,
}

fn workerMain(context: WorkerContext) -> () {
  return run Effect.catchAll(workerLoop(move context), workerFailed)
}

effect fn workerFailed(error: OutOfMemoryError) -> () {
  // A worker that cannot queue work cannot keep the pool's guarantees.
  return Intrinsic.trap("ThreadPool: a worker could not queue work")
}

// How many ready fibers a worker moves from the shared list into its own deque at once.
const batch: usize = 16

effect fn workerLoop(context: WorkerContext) -> () ! OutOfMemoryError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut worker = move context
  while true {
    let next = run findTask(&mut worker) |> Effect.provideMut<Allocator>(&mut allocator)
    if next != none() {
      run drive(&worker.pool, next)
    } else if sleep(&worker) {
      return ()
    }
  }
  return ()
}

effect fn findTask(worker: &mut WorkerContext) -> usize ! OutOfMemoryError ? &mut Allocator {
  if let Option<usize>.Some { value } = move worker.local.pop() { return value }
  let shared = run takeBatch(&mut worker.*)
  if shared != none() { return shared }
  return steal(&worker.*)
}

// Moves up to `batch` ready fibers into the worker's deque and returns one of them. When it moves
// more than one, it wakes another sleeping worker to steal some.
effect fn takeBatch(worker: &mut WorkerContext) -> usize ! OutOfMemoryError ? &mut Allocator {
  let pool = worker.pool.get()
  let mut guard = pool.state.lock()
  let state = guard.getMut()
  let first = unlink(&mut state.*)
  if first == none() { return first }
  let mut moved = usize.ZERO
  while moved < batch {
    let id = unlink(&mut state.*)
    if id == none() { break }
    run worker.local.push(id)
    moved = moved + 1
  }
  let mut helper = none()
  if moved > usize.ZERO { helper = takeIdle(&mut state.*) }
  drop guard
  wakeWorker(pool, helper)
  return first
}

fn steal(worker: &WorkerContext) -> usize {
  let stealers = List<Stealer<usize>>.asSlice(&worker.stealers)
  let mut retry = true
  while retry {
    retry = false
    let mut at = usize.ZERO
    while at < stealers.length {
      if at != worker.index {
        match stealers[at].steal() {
          Steal<usize>.Success { value } => { return value }
          Steal<usize>.Retry => { retry = true }
          Steal<usize>.Empty => {}
        }
      }
      at = at + 1
    }
  }
  return none()
}

// Marks the worker idle and parks it, unless work or shutdown arrived first. Returns whether the
// pool is shutting down.
fn sleep(worker: &WorkerContext) -> bool {
  let pool = worker.pool.get()
  let mut guard = pool.state.lock()
  let state = guard.getMut()
  if state.shutdown { return true }
  if state.head != none() { return false }
  let flags = List<bool>.asMutSlice(&mut state.idle)
  flags[worker.index] = true
  drop guard
  worker.parker.park()
  return false
}

/// The owner of a pool's worker threads: a work-stealing pool of native threads that runs fibers
/// in parallel.
///
/// # When to use
/// Call [`ThreadPool.make`] to start the worker threads, then [`Pool.block`] on a normal thread to
/// run a program on the pool. In a fiber, start more fibers with [`Pool.fork`] and wait for one
/// with [`PoolFiber.join`] or [`PoolFiber.await`].
///
/// # Details
/// Each fiber is a `Transferable` lazy effect, so a fiber can start on one worker, park, and
/// continue on a different worker. Idle workers steal work from each other and then sleep, so no
/// worker spins. Dropping it stops every worker, joins its thread, and cancels the fibers still
/// unfinished, so their waiters see `Cancelled`.
///
/// # Gotchas
/// - Fiber bodies, results and failures must be `Transferable` and `'static`.
/// - The pool uses the system allocator for its own storage, not the `Allocator` of the caller.
pub struct ThreadPool {
  handle: Pool,
  threads: List<JoinHandle<()>>,
}

impl ThreadPool {
  /// Starts a pool of `workers` native threads, all waiting for fibers.
  ///
  /// # Details
  /// Zero workers means one. If a thread fails to start, the ones already started are stopped
  /// and joined before the error returns.
  pub effect fn make(workers: usize) -> ThreadPool ! OutOfMemoryError | SpawnError ? &mut Allocator {
    let mut count = workers
    if count == usize.ZERO { count = 1 }
    let mut parkers = List<Parker>.make()
    let mut unparkers = List<Unparker>.make()
    let mut deques = List<Worker<usize>>.make()
    let mut stealers = List<Stealer<usize>>.make()
    let mut idle = List<bool>.make()
    let mut at = usize.ZERO
    while at < count {
      let parker = run Parker.make()
      run List<Unparker>.append(&mut unparkers, parker.unparker())
      run List<Parker>.append(&mut parkers, move parker)
      let deque = run WorkDeque.make<usize>()
      run List<Stealer<usize>>.append(&mut stealers, deque.stealer())
      run List<Worker<usize>>.append(&mut deques, move deque)
      run List<bool>.append(&mut idle, false)
      at = at + 1
    }
    let state = PoolState { slots: List<Slot>.make(), head: none(), tail: none(), free: none(), idle: move idle, shutdown: false }
    let locked = run Mutex<PoolState>.make(move state)
    let shared = run Arc<PoolShared>.make(PoolShared { state: move locked, unparkers: move unparkers })
    let mut owner = ThreadPool { handle: Pool { shared: move shared }, threads: List<JoinHandle<()>>.make() }
    run startWorkers(&owner.handle.shared, move parkers, move deques, &stealers, &mut owner.threads)
    return move owner
  }

  /// Returns a handle to this pool.
  pub fn pool(self: &Self) -> Pool {
    return self.handle.clone()
  }
}

impl Drop for ThreadPool {
  fn drop(self: &mut ThreadPool) -> () {
    let threads = Intrinsic.replace(self.threads, List<JoinHandle<()>>.make())
    stop(self.handle.shared.get(), move threads)
    return ()
  }
}

effect fn startWorkers(
  pool: &Arc<PoolShared>,
  parkers: List<Parker>,
  deques: List<Worker<usize>>,
  stealers: &List<Stealer<usize>>,
  threads: &mut List<JoinHandle<()>>,
) -> () ! OutOfMemoryError | SpawnError ? &mut Allocator {
  let mut remainingParkers = move parkers
  let mut remainingDeques = move deques
  while List<Parker>.length(&remainingParkers) > usize.ZERO {
    let index = List<Parker>.length(&remainingParkers) - 1
    let parker = List<Parker>.remove(&mut remainingParkers, index)
    let deque = List<Worker<usize>>.remove(&mut remainingDeques, index)
    let mut own = List<Stealer<usize>>.make()
    let all = List<Stealer<usize>>.asSlice(stealers)
    let mut at = usize.ZERO
    while at < all.length {
      run List<Stealer<usize>>.append(&mut own, all[at].clone())
      at = at + 1
    }
    let context = WorkerContext { pool: pool.clone(), index: index, parker: move parker, local: move deque, stealers: move own }
    let thread = run NativeThread.spawn(fn() -> () { return workerMain(move context) })
    run List<JoinHandle<()>>.append(&mut threads.*, move thread)
  }
  return ()
}

// The calling thread is not a pool fiber, so it waits on a Parker.
effect fn awaitThread<A, E>(fiber: PoolFiber<A, E>) -> Outcome<A, E> ! OutOfMemoryError {
  let PoolFiber<A, E> { completion, pool, id, ticket } = move fiber
  drop pool
  let mut allocator = Allocator.systemAllocatorProvider()
  let parker = run Parker.make() |> Effect.provideMut<Allocator>(&mut allocator)
  while true {
    let taken = takeDone<A, E>(completion.get())
    if let Option<Outcome<A, E>>.Some { value } = move taken { return move value }
    if registerThread<A, E>(completion.get(), parker.unparker()) { parker.park() }
  }
  return unreachable<Outcome<A, E>>()
}

// Returns whether the fiber is still running, after registering the thread to be woken.
fn registerThread<A, E>(completion: &Mutex<Completion<A, E>>, unparker: Unparker) -> bool {
  let mut guard = completion.lock()
  let state = guard.getMut()
  let phase = Intrinsic.replace(state.phase, Collected {})
  return match move phase {
    Running ignored => keepThread<A, E>(&mut state.*, ThreadWaiter { unparker: move unparker })
    Done<A, E> done => restoreDone<A, E>(&mut state.*, move done)
    Collected nothing => false
  }
}

fn keepThread<A, E>(state: &mut Completion<A, E>, waiter: ThreadWaiter) -> bool {
  state.phase = Running { waiter: move waiter }
  return true
}

fn restoreDone<A, E>(state: &mut Completion<A, E>, done: Done<A, E>) -> bool {
  state.phase = move done
  return false
}

// Stops the workers, joins them, and drops every fiber still in the table. Dropping a fiber
// cancels it, which tells its waiter, and drops its hook, which holds the pool.
fn stop(pool: &PoolShared, threads: List<JoinHandle<()>>) -> () {
  let mut guard = pool.state.lock()
  let state = guard.getMut()
  state.shutdown = true
  drop guard
  let unparkers = List<Unparker>.asSlice(&pool.unparkers)
  let mut at = usize.ZERO
  while at < unparkers.length {
    unparkers[at].unpark()
    at = at + 1
  }
  let mut remaining = move threads
  while List<JoinHandle<()>>.length(&remaining) > usize.ZERO {
    let last = List<JoinHandle<()>>.length(&remaining) - 1
    let thread = List<JoinHandle<()>>.remove(&mut remaining, last)
    thread.join()
  }
  // The emptied table keeps no ready or free ids, so a fork from cleanup or a kept `Pool` gets a
  // new slot and is cancelled at once.
  let mut final = pool.state.lock()
  let emptied = final.getMut()
  let slots = Intrinsic.replace(emptied.slots, List<Slot>.make())
  emptied.head = none()
  emptied.tail = none()
  emptied.free = none()
  drop final
  drop slots
  return ()
}

fn unreachable<T>() -> T {
  return Intrinsic.trap("ThreadPool: a worker execution was missing where it had just been stored")
}
