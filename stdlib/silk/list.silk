//! Growable lists that own their elements, with stable sorting and binary search.
//!
//! # When to use
//! Use [`List`] when the number of elements is known only at runtime, or the sequence must grow.
//! Use a fixed array `[T; N]` when the length is part of the type. Use `silk.bytes.Bytes` for a
//! block of bytes that does not grow.
//!
//! # Details
//! [`List.make`] does not allocate. The first growth allocates space for four elements, and each
//! later growth doubles the capacity. Use [`List.reserve`] or [`List.reserveExact`] to allocate
//! before a sequence of appends. Growth copies the elements into new storage before it releases the
//! old storage. Thus a failed [`List.append`] or [`List.reserve`] leaves the list unchanged.
//!
//! [`List.remove`], [`List.clear`], and [`List.truncate`] drop the elements that they remove and
//! keep the capacity. Dropping a list drops each element and then releases the storage.
//!
//! [`List.sort`] is stable and works for elements that are not `Copy`. It allocates temporary
//! storage. [`List.binarySearch`] needs a sorted list and returns the lowest index of equal
//! elements.
//!
//! # Gotchas
//! [`List.get`], [`List.set`], and [`List.remove`] trap if the index is not less than the length.
//! The index of [`List.insert`] must be at most the length. [`List.get`] copies the element, so
//! it needs `T: Copy`. Use [`List.asSlice`] to borrow an element that is not `Copy`.
//!
//! # Examples
//! ## Grow and change a list
//! ```silk
//! import silk.allocator { Allocator, OutOfMemoryError }
//! import silk.effect { Effect }
//! import silk.list { List }
//!
//! pub effect fn main() -> i32
//!   ! OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let mut values = List<i32>.make()
//!   run List<i32>.append(&mut values, 10) |> Effect.provideMut<Allocator>(&mut allocator)
//!   run List<i32>.append(&mut values, 30) |> Effect.provideMut<Allocator>(&mut allocator)
//!   run List<i32>.insert(&mut values, 1, 20) |> Effect.provideMut<Allocator>(&mut allocator)
//!   List<i32>.set(&mut values, 2, 22)
//!   let removed = List<i32>.remove(&mut values, 0)
//!
//!   // The list is now [20, 22].
//!   if removed != 10 || List<i32>.get(&values, 0) + List<i32>.get(&values, 1) != 42 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! ## Sort values and find the first equal value
//! ```silk
//! import silk.allocator { Allocator, OutOfMemoryError }
//! import silk.effect { Effect }
//! import silk.option { Option }
//! import silk.usize
//! import silk.list { List }
//!
//! pub effect fn main() -> i32
//!   ! OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let mut values = List<i32>.make()
//!   run List<i32>.append(&mut values, 36) |> Effect.provideMut<Allocator>(&mut allocator)
//!   run List<i32>.append(&mut values, 3) |> Effect.provideMut<Allocator>(&mut allocator)
//!   run List<i32>.append(&mut values, 3) |> Effect.provideMut<Allocator>(&mut allocator)
//!   run List<i32>.sort(&mut values) |> Effect.provideMut<Allocator>(&mut allocator)
//!
//!   // The list is now [3, 3, 36]. The search returns the first 3.
//!   let found = List<i32>.binarySearch(&values, 3) |> Option<usize>.unwrapOr(usize.MAX)
//!   if found != usize.ZERO || List<i32>.get(&values, 2) != 36 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```

// A growable owned sequence over the allocation substrate. Ordinary Silk: no compiler phase
// knows this type, and every capability it uses is available to user code.
//
// The storage union keeps the empty list allocation-free; Intrinsic.replace moves it out and back
// through &mut self without a partial move, and the Drop hook destroys exactly the
// initialized elements before the backing buffer releases.

import silk.allocator {Allocator, OutOfMemoryError}
import silk.allocator {OutOfMemoryError}
import silk.layout {Layout}
import silk.layout {LayoutOverflow}
import silk.option {Option}
import silk.order {Order}
import silk.ownership {Copy, Drop}
import silk.raw_buffer {RawBuffer}
import silk.slot {Slot}
import silk.u8
import silk.usize

/// The storage state of a [`List`] that has no allocation. User code does not use it.
pub struct Empty<T> {
  anchor: [T; 0]
}

/// The storage state of a [`List`] that has an allocation. User code does not use it.
pub struct Full<T> {
  buffer: Intrinsic.RawBuffer<T>
}

/// A growable list that owns its elements in one contiguous allocation.
///
/// # Details
///
/// The length is the number of elements in the list. The capacity is the number of elements that
/// fit before the next growth. Dropping a list drops each element and then releases the storage. A
/// list is affine. Copy it element by element if a second list is necessary.
pub struct List<T> {
  storage: Empty<T> | Full<T>
  count: usize
  limit: usize
}

impl<T> List<T> {
  /// Returns an empty list. This function does not allocate.
  ///
  /// # Details
  ///
  /// The capacity is 0. The first [`List.append`], [`List.insert`], or [`List.reserve`] allocates.
  pub fn make() -> List<T> {
    return List<T> {storage: Empty<T> {anchor: []}, count: usize.ZERO, limit: usize.ZERO}
  }
  /// Returns the number of elements in the list.
  pub fn length(self: &Self) -> usize {
    return self.count
  }
  /// Returns the number of elements that fit in the current storage before the next growth.
  pub fn capacity(self: &Self) -> usize {
    return self.limit
  }
  /// Returns a shared borrow of all elements as a slice, in list order.
  ///
  /// # When to use
  ///
  /// Use `asSlice` to read elements that are not `Copy`, or to give the elements to a function that
  /// takes `&[T]`.
  ///
  /// # Gotchas
  ///
  /// The slice borrows the list. The compiler rejects a change to the list, such as an append,
  /// while the slice is live.
  pub fn asSlice(self: &Self) -> &[T] {
    return match & self.storage {
      Empty<T> {anchor} => emptySlice<T>(&anchor)
      // `Full` storage holds exactly `count` initialized elements, all within its capacity.
      Full<T> {buffer} => unsafe RawBuffer.view<T>(&buffer, usize.ZERO, self.count)
    }
  }
  /// Returns an exclusive borrow of all elements as a slice, in list order.
  ///
  /// # When to use
  ///
  /// Use `asMutSlice` to change elements in place, such as in a loop over all elements.
  ///
  /// # Gotchas
  ///
  /// The slice cannot change the length. The compiler rejects other uses of the list while the
  /// slice is live.
  pub fn asMutSlice(self: &mut Self) -> &mut [T] {
    return match &mut self.storage {
      Empty<T> {anchor} => emptyMutSlice<T>(&mut anchor)
      // `Full` storage holds exactly `count` initialized elements, all within its capacity.
      Full<T> {buffer} => unsafe RawBuffer.viewMut<T>(&mut buffer, usize.ZERO, self.count)
    }
  }
  /// Adds `value` at the end of the list.
  ///
  /// # Details
  ///
  /// The list takes ownership of `value`. If the list is full, it grows: the first growth allocates
  /// space for four elements, and each later growth doubles the capacity.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the new storage. The list does not
  ///   change.
  pub effect<'env> fn append<'env>(self: &mut Self, value: T) -> () ! OutOfMemoryError ? &mut Allocator {
    if self.count == self.limit {
      let next = grownCapacity(self.limit, self.count + usize.ONE)
      run grow<T>(&mut self.*, next)
    }
    let index = self.count
    let written = match &mut self.storage {
      Empty<T> nothing => absurd<()>()
      Full<T> {buffer} => writeInto<T>(&mut buffer, index, move value)
    }
    self.count = index + usize.ONE
    return ()
  }
  /// Inserts `value` at position `index` and moves the elements from `index` onward one position to
  /// the right.
  ///
  /// # Details
  ///
  /// `index` equal to [`List.length`] appends the value. The move of the later elements takes time
  /// in proportion to their number. `T` does not need to be `Copy`.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the new storage. The list does not
  ///   change.
  ///
  /// # Gotchas
  ///
  /// `index` must be less than or equal to [`List.length`]. The function checks `index` only
  /// against the capacity. An `index` more than the length and less than the capacity makes the
  /// list hold uninitialized elements.
  pub effect<'env> fn insert<'env>(self: &mut Self, index: usize, value: T) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
    if self.count == self.limit {
      let next = grownCapacity(self.limit, self.count + usize.ONE)
      run grow<T>(&mut self.*, next)
    }
    let length = self.count
    let inserted = match &mut self.storage {
      Empty<T> nothing => absurd<()>()
      Full<T> {buffer} => insertInto<T>(&mut buffer, index, length, move value)
    }
    self.count = length + usize.ONE
    return ()
  }
  /// Returns a copy of the element at position `index`.
  ///
  /// # When to use
  ///
  /// Use `get` when `T` is `Copy`. Use [`List.asSlice`] to borrow an element that is not `Copy`.
  ///
  /// # Gotchas
  ///
  /// If `index` is not less than [`List.length`], the program traps.
  pub fn get<T: Copy>(self: &Self, index: usize) -> T {
    if self.count <= index {
      let boom = 1 / 0
    }
    let read = match & self.storage {
      Empty<T> nothing => absurd<Read<T>>()
      Full<T> {buffer} => Read<T> {value: readAt<T>(&buffer, index)}
    }
    return match move read {
      Read<T> {value} => move value
    }
  }
  /// Removes the last element and returns it. Returns `None` if the list is empty.
  ///
  /// # Details
  ///
  /// The caller owns the returned element. The capacity does not change.
  pub fn pop(self: &mut Self) -> Option<T> {
    if self.count == usize.ZERO {
      return Option<T>.none()
    }
    let index = self.count - usize.ONE
    let value = match &mut self.storage {
      Empty<T> nothing => absurd<T>()
      Full<T> {buffer} => takeFrom<T>(&mut buffer, index)
    }
    self.count = index
    return Option<T>.some(move value)
  }
  /// Removes the element at position `index`, returns it, and moves the later elements one position
  /// to the left.
  ///
  /// # Details
  ///
  /// The caller owns the returned element. The capacity does not change. Use [`List.pop`] to remove
  /// the last element without a move of other elements.
  ///
  /// # Gotchas
  ///
  /// If `index` is not less than [`List.length`], the program traps.
  pub fn remove(self: &mut Self, index: usize) -> T {
    if self.count <= index {
      let boom = 1 / 0
    }
    let length = self.count
    let value = match &mut self.storage {
      Empty<T> nothing => absurd<T>()
      Full<T> {buffer} => removeFrom<T>(&mut buffer, index, length)
    }
    self.count = length - usize.ONE
    return move value
  }
  /// Drops all elements and sets the length to 0. The capacity does not change.
  pub fn clear(self: &mut Self) -> () {
    return List<T>.truncate(move self, usize.ZERO)
  }
  /// Drops the elements from position `length` to the end. The capacity does not change.
  ///
  /// # Details
  ///
  /// If `length` is more than or equal to the current length, this function does nothing.
  pub fn truncate(self: &mut Self, length: usize) -> () {
    if self.count <= length {
      return ()
    }
    let end = self.count
    let dropped = match &mut self.storage {
      Empty<T> nothing => absurd<()>()
      Full<T> {buffer} => dropRange<T>(&mut buffer, length, end)
    }
    self.count = length
    return ()
  }
  /// Replaces the element at position `index` with `value` and drops the old element.
  ///
  /// # Gotchas
  ///
  /// If `index` is not less than [`List.length`], the program traps.
  pub fn set(self: &mut Self, index: usize, value: T) -> () {
    if self.count <= index {
      let boom = 1 / 0
    }
    let replaced = match &mut self.storage {
      Empty<T> nothing => absurd<()>()
      Full<T> {buffer} => replaceIn<T>(&mut buffer, index, move value)
    }
    return ()
  }
  /// Makes sure that at least `additional` more elements fit without another allocation.
  ///
  /// # When to use
  ///
  /// Use `reserve` before a loop of appends when the number of new elements is known. Use
  /// [`List.reserveExact`] when the final length is known and extra capacity is not wanted.
  ///
  /// # Details
  ///
  /// If the capacity is already sufficient, this function does nothing. Otherwise, it grows the
  /// capacity by doubling until the elements fit. The length does not change.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the new storage. The list does not
  ///   change.
  pub effect fn reserve(self: &mut Self, additional: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
    let needed = self.count + additional
    if needed <= self.limit {
      return ()
    }
    let next = grownCapacity(self.limit, needed)
    run grow<T>(&mut self.*, next)
    return ()
  }
  /// Makes sure that at least `additional` more elements fit, with no extra capacity.
  ///
  /// # When to use
  ///
  /// Use `reserveExact` when the final length is known, such as before a copy of a slice. Use
  /// [`List.reserve`] when more appends can follow.
  ///
  /// # Details
  ///
  /// If the capacity is already sufficient, this function does nothing and does not shrink the
  /// storage. Otherwise, it allocates storage for exactly `length + additional` elements. The
  /// length does not change.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if `length + additional` overflows `usize`, or the `Allocator` cannot
  ///   supply the new storage. The list does not change.
  pub effect fn reserveExact(self: &mut Self, additional: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
    let needed = match move usize.checkedAdd(self.count, additional) {
      Option<usize>.Some {value} => value
      Option<usize>.None => run Allocator.outOfMemory()
    }
    if needed <= self.limit {
      return ()
    }
    run grow<T>(&mut self.*, needed)
    return ()
  }
  /// Sorts the elements in place, in ascending order of the `Order` conformance of `T`.
  ///
  /// # Details
  ///
  /// The sort is stable: equal elements keep their order. The result is deterministic. The sort
  /// works for elements that are not `Copy`. It allocates temporary storage from the active
  /// `Allocator`.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the temporary storage. The list does not
  ///   change.
  pub effect fn sort<T: Order>(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    let count = self.count
    if count <= usize.ONE {
      return ()
    }
    let element = Layout.of<T>()
    let plan = Layout.repeat(move element, count)
    let layout = match move plan {
      Layout ready => move ready
      LayoutOverflow overflow => run overflowed()
    }
    let recipe = Allocator.allocate(move layout)
    let allocation = run recipe
    let scratch = freshBuffer<T>(move allocation, count)
    let mut order = List<usize>.make()
    let mut spare = List<usize>.make()
    let mut seed = usize.ZERO
    while seed < count {
      let placed = run List<usize>.append(&mut order, seed)
      let staged = run List<usize>.append(&mut spare, seed)
      seed = seed + usize.ONE
    }
    let storage = Intrinsic.replace(self.storage, Empty<T> {anchor: []})
    let mut owned = takeBuffer<T>(move storage)
    let mut width = usize.ONE
    while width < count {
      let mut low = usize.ZERO
      while low < count {
        let mut middle = low + width
        if count < middle {
          middle = count
        }
        let mut high = middle + width
        if count < high {
          high = count
        }
        let mut left = low
        let mut right = middle
        let mut cursor = low
        while cursor < high {
          // The right run wins a position only when it compares strictly less, so equal elements
          // leave the left run first and the sort is stable.
          let mut takeRight = true
          if left < middle {
            takeRight = false
            if right < high {
              let indices = List<usize>.asSlice(&order)
              // `order` permutes 0..count and no element has moved yet, so each named slot is
              // initialized.
              unsafe {
                let after = RawBuffer.view<T>(&owned, indices[right], usize.ONE)
                let before = RawBuffer.view<T>(&owned, indices[left], usize.ONE)
                takeRight = (&after[usize.ZERO]) < (&before[usize.ZERO])
              }
            }
          }
          let mut picked = usize.ZERO
          if takeRight {
            let indices = List<usize>.asSlice(&order)
            picked = indices[right]
            right = right + usize.ONE
          } else {
            let indices = List<usize>.asSlice(&order)
            picked = indices[left]
            left = left + usize.ONE
          }
          let mut slots = List<usize>.asMutSlice(&mut spare)
          slots[cursor] = picked
          cursor = cursor + usize.ONE
        }
        low = high
      }
      let mut back = usize.ZERO
      while back < count {
        let staged = List<usize>.asSlice(&spare)
        let value = staged[back]
        let mut slots = List<usize>.asMutSlice(&mut order)
        slots[back] = value
        back = back + usize.ONE
      }
      width = width + width
    }
    let applied = applyOrder<T>(move owned, move scratch, List<usize>.asSlice(&order), count)
    let sorted = match move applied {
      Applied<T> {buffer, scratch: leftover} => releaseScratch<T>(move buffer, move leftover)
    }
    self.storage = Full<T> {buffer: move sorted}
    return ()
  }
  /// Returns the position of an element equal to `target` in a sorted list, or `None` if no element
  /// is equal.
  ///
  /// # Details
  ///
  /// If more than one element is equal to `target`, the result is the lowest position. The search
  /// takes time in proportion to the logarithm of the length. This function consumes `target` and
  /// does not change the list.
  ///
  /// # Gotchas
  ///
  /// The list must be sorted in ascending order by the same `Order` conformance, for example by
  /// [`List.sort`]. For a list that is not sorted, the result has no meaning.
  pub fn binarySearch<T: Order>(self: &Self, target: T) -> Option<usize> {
    let two = usize.ONE + usize.ONE
    let values = List<T>.asSlice(self)
    let mut low = usize.ZERO
    let mut high = self.count
    while low < high {
      let middle = low + (high - low) / two
      if (&values[middle]) < (&target) {
        low = middle + usize.ONE
      } else {
        high = middle
      }
    }
    if low < self.count {
      if !((&target) < (&values[low])) {
        return Option<usize>.some(low)
      }
    }
    return Option<usize>.none()
  }
}

// Diverges on the arms the surrounding logic has already proven impossible.
fn absurd<T>() -> T {
  let boom = 1 / 0
  return absurd<T>()
}

fn emptySlice<T>(anchor: &[T]) -> &[T] {
  return anchor
}

fn emptyMutSlice<T>(anchor: &mut [T]) -> &mut [T] {
  return move anchor
}

impl<T> Drop for List<T> {
  fn drop(self: &mut List<T>) -> () {
    let storage = Intrinsic.replace(self.storage, Empty<T> {anchor: []})
    let count = Intrinsic.replace(self.count, usize.ZERO)
    return match move storage {
      Empty<T> nothing => ()
      Full<T> full => releaseFull<T>(move full, count)
    }
  }
}

fn releaseFull<T>(full: Full<T>, length: usize) -> () {
  return match move full {
    Full<T> {buffer} => releaseBuffer<T>(move buffer, length)
  }
}

fn releaseBuffer<T>(buffer: Intrinsic.RawBuffer<T>, length: usize) -> () {
  unsafe {
    let mut owned = move buffer
    let mut index = usize.ZERO
    while index < length {
      let selected = RawBuffer.slot(&mut owned, index)
      let cleared = Slot.dropValue(move selected)
      index = index + usize.ONE
    }
    drop owned
  }
  return ()
}

// Bulk byte append. Concrete to u8 rather than generic over T: the copy moves the source range,
// and moving out of a borrowed slice is only a copy when the element type is Copy.
impl<T> List<T> {
  /// Adds a copy of each byte of `values` at the end of the list, in order.
  ///
  /// # When to use
  ///
  /// Use `appendBytes` to add many bytes at once. It copies the bytes in one operation, which is
  /// faster than one [`List.append`] for each byte.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the new storage. The list does not
  ///   change.
  pub effect fn appendBytes(self: &mut List<u8>, values: &[u8]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
    let count = values.length
    if count == usize.ZERO {
      return ()
    }
    let offset = self.count
    let needed = offset + count
    if self.limit < needed {
      let next = grownCapacity(self.limit, needed)
      run grow<u8>(&mut self.*, next)
    }
    let copied = match &mut self.storage {
      Empty<u8> nothing => absurd<()>()
      Full<u8> {buffer} => copyInto(&mut buffer, offset, values, count)
    }
    self.count = needed
    return ()
  }
  /// Adds `count` copies of `byte` at the end of the list.
  ///
  /// # Details
  ///
  /// A `count` of 0 does nothing and does not allocate.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the new storage. The list does not
  ///   change.
  pub effect fn appendRepeated(self: &mut List<u8>, byte: u8, count: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
    if count == usize.ZERO {
      return ()
    }
    let offset = self.count
    let needed = match move usize.checkedAdd(offset, count) {
      Option<usize>.Some {value} => value
      Option<usize>.None => run Allocator.outOfMemory()
    }
    if self.limit < needed {
      let next = grownCapacity(self.limit, needed)
      run grow<u8>(&mut self.*, next)
    }
    let filled = match &mut self.storage {
      Empty<u8> nothing => absurd<()>()
      Full<u8> {buffer} => fillInto(&mut buffer, offset, count, byte)
    }
    self.count = needed
    return ()
  }
}

effect fn overflowed() -> Layout ! OutOfMemoryError {
  return run Allocator.outOfMemory()
}

// Growth is atomic: the replacement buffer exists and holds every element before the list's
// storage commits, so a failed allocation leaves the original untouched.
effect fn grow<T>(self: &mut List<T>, next: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let element = Layout.of<T>()
  let plan = Layout.repeat(move element, next)
  let layout = match move plan {
    Layout ready => move ready
    LayoutOverflow overflow => run overflowed()
  }
  let allocation = run Allocator.allocate(move layout)
  let storage = Intrinsic.replace(self.storage, Empty<T> {anchor: []})
  let moved = match move storage {
    Empty<T> nothing => Full<T> {buffer: freshBuffer<T>(move allocation, next)}
    Full<T> full => Full<T> {buffer: migrate<T>(move full, move allocation, self.count, next)}
  }
  self.storage = move moved
  self.limit = next
  return ()
}

// The geometric capacity that holds `needed` elements: four on first growth, then doubling.
fn grownCapacity(limit: usize, needed: usize) -> usize {
  let mut next = limit + limit
  if limit == usize.ZERO {
    next = 4
  }
  while next < needed {
    next = next + next
  }
  return next
}

// Element access borrows the allocated buffer in place through `match &mut self.storage`, so an
// operation never moves the storage union out of the list and back.

fn writeInto<T>(buffer: &mut Intrinsic.RawBuffer<T>, index: usize, value: T) -> () {
  unsafe {
    let selected = RawBuffer.slot<T>(move buffer, index)
    let written = Slot.write<T>(move selected, move value)
  }
  return ()
}

fn takeFrom<T>(buffer: &mut Intrinsic.RawBuffer<T>, index: usize) -> T {
  unsafe {
    let selected = RawBuffer.slot<T>(move buffer, index)
    return Slot.take<T>(move selected)
  }
  return absurd<T>()
}

fn replaceIn<T>(buffer: &mut Intrinsic.RawBuffer<T>, index: usize, value: T) -> () {
  unsafe {
    let selected = RawBuffer.slot<T>(&mut buffer.*, index)
    let cleared = Slot.dropValue<T>(move selected)
    let target = RawBuffer.slot<T>(move buffer, index)
    let written = Slot.write<T>(move target, move value)
  }
  return ()
}

fn copyInto(buffer: &mut Intrinsic.RawBuffer<u8>, offset: usize, values: &[u8], count: usize) -> () {
  unsafe {
    let copied = RawBuffer.copy<u8>(move buffer, offset, values, count)
  }
  return ()
}

fn fillInto(buffer: &mut Intrinsic.RawBuffer<u8>, offset: usize, count: usize, value: u8) -> () {
  unsafe {
    let filled = RawBuffer.fill(move buffer, offset, count, value)
  }
  return ()
}

// Shifts each element after `index` up one slot from the end, then writes the value into the hole,
// so every slot holds an initialized value at each step.
fn insertInto<T>(buffer: &mut Intrinsic.RawBuffer<T>, index: usize, length: usize, value: T) -> () {
  unsafe {
    let mut cursor = length
    while index < cursor {
      let source = RawBuffer.slot<T>(&mut buffer.*, cursor - usize.ONE)
      let shifted = Slot.take<T>(move source)
      let target = RawBuffer.slot<T>(&mut buffer.*, cursor)
      let written = Slot.write<T>(move target, move shifted)
      cursor = cursor - usize.ONE
    }
    let selected = RawBuffer.slot<T>(move buffer, index)
    let written = Slot.write<T>(move selected, move value)
  }
  return ()
}

// Takes the element out first, then closes the hole by moving each later element down one slot,
// mirroring insertInto so every slot holds an initialized value at each step.
fn removeFrom<T>(buffer: &mut Intrinsic.RawBuffer<T>, index: usize, length: usize) -> T {
  unsafe {
    let selected = RawBuffer.slot<T>(&mut buffer.*, index)
    let value = Slot.take<T>(move selected)
    let mut cursor = index + usize.ONE
    while cursor < length {
      let source = RawBuffer.slot<T>(&mut buffer.*, cursor)
      let shifted = Slot.take<T>(move source)
      let target = RawBuffer.slot<T>(&mut buffer.*, cursor - usize.ONE)
      let written = Slot.write<T>(move target, move shifted)
      cursor = cursor + usize.ONE
    }
    return move value
  }
  return absurd<T>()
}

fn dropRange<T>(buffer: &mut Intrinsic.RawBuffer<T>, from: usize, to: usize) -> () {
  unsafe {
    let mut index = from
    while index < to {
      let selected = RawBuffer.slot<T>(&mut buffer.*, index)
      let cleared = Slot.dropValue<T>(move selected)
      index = index + usize.ONE
    }
  }
  return ()
}

fn freshBuffer<T>(allocation: Intrinsic.Allocation, count: usize) -> Intrinsic.RawBuffer<T> {
  unsafe {
    let made = RawBuffer.from<T>(move allocation, count)
    return move made
  }
  return absurd<Intrinsic.RawBuffer<T>>()
}

fn migrate<T>(full: Full<T>, allocation: Intrinsic.Allocation, length: usize, count: usize) -> Intrinsic.RawBuffer<T> {
  return match move full {
    Full<T> {buffer} => migrateBuffer<T>(move buffer, move allocation, length, count)
  }
}

// One bulk move replaces the element-by-element migration: the initialized prefix of the old
// buffer travels to the fresh buffer in a single copy, and the emptied source releases as before.
fn migrateBuffer<T>(old: Intrinsic.RawBuffer<T>, allocation: Intrinsic.Allocation, length: usize, count: usize) -> Intrinsic.RawBuffer<
  T,
> {
  let mut target = freshBuffer<T>(move allocation, count)
  unsafe {
    let mut source = move old
    let initialized = RawBuffer.view<T>(&source, usize.ZERO, length)
    let migrated = RawBuffer.copy<T>(&mut target, usize.ZERO, initialized, length)
    drop source
  }
  return move target
}

struct Read<T> {
  value: T
}

impl<T: Copy> Copy for Read<T> {}

// Checked read for Copy element types: out-of-range access traps identically on every supported target.

fn readAt<T: Copy>(buffer: &Intrinsic.RawBuffer<T>, index: usize) -> T {
  unsafe {
    return RawBuffer.read<T>(buffer, index)
  }
  return absurd<T>()
}

// Ordering. A bottom-up merge sort over a permutation of the element indices, so it is stable, and
// deterministic because every comparison and every exchange is decided by the run boundaries alone
// and never by an address, a capacity, or a target detail. The same input therefore produces the
// same output for every LLVM target.
//
// Merging cannot happen in place, so the sort allocates and carries `! OutOfMemoryError ? &mut Allocator`.
// An insertion sort would need no allocation and no requirement, but it costs O(n^2), and the two
// signatures are not source-compatible, so the choice cannot be deferred to a later release.
//
// The sort orders indices first and moves elements only once, at the end: each element is taken from
// its old slot into the scratch buffer exactly once and the whole prefix travels back in one bulk
// move. An element is therefore never read out of a borrowed place, never duplicated, and never
// dropped twice, and the movement itself never requires the element type to be Copy.
//
// `sort` is one single body rather than the helper chain the rest of this file uses because a bound
// is not carried into a nested generic call: a `T: Order` body cannot pass its own `T` to another
// `T: Order` function. Every helper `sort` calls is therefore unbounded, and every comparison is
// written here.

struct Applied<T> {
  buffer: Intrinsic.RawBuffer<T>
  scratch: Intrinsic.RawBuffer<T>
}

fn takeBuffer<T>(storage: Empty<T> | Full<T>) -> Intrinsic.RawBuffer<T> {
  return match move storage {
    Empty<T> nothing => absurd<Intrinsic.RawBuffer<T>>()
    Full<T> full => unwrapFull<T>(move full)
  }
}

fn unwrapFull<T>(full: Full<T>) -> Intrinsic.RawBuffer<T> {
  return match move full {
    Full<T> {buffer} => move buffer
  }
}

// Moves every element into the scratch buffer in the order the permutation names, then returns the
// whole prefix in one bulk move. Every source slot is taken exactly once because the permutation is
// a bijection, so nothing leaks and nothing is dropped twice.
fn applyOrder<T>(buffer: Intrinsic.RawBuffer<T>, scratch: Intrinsic.RawBuffer<T>, order: &[usize], count: usize) -> Applied<
  T,
> {
  let mut owned = move buffer
  let mut staging = move scratch
  unsafe {
    let mut index = usize.ZERO
    while index < count {
      let selected = RawBuffer.slot(&mut owned, order[index])
      let value = Slot.take(move selected)
      let destination = RawBuffer.slot(&mut staging, index)
      let written = Slot.write(move destination, move value)
      index = index + usize.ONE
    }
  }
  // The loop above filled scratch slots 0..count and emptied every source slot, so the bulk move
  // reads only initialized slots and overwrites only vacated ones.
  unsafe {
    let merged = RawBuffer.view<T>(&staging, usize.ZERO, count)
    let moved = RawBuffer.copy<T>(&mut owned, usize.ZERO, merged, count)
  }
  return Applied<T> {buffer: move owned, scratch: move staging}
}

// The scratch buffer holds no initialized element once the bulk move returns, so releasing it
// destroys nothing.
fn releaseScratch<T>(buffer: Intrinsic.RawBuffer<T>, leftover: Intrinsic.RawBuffer<T>) -> Intrinsic.RawBuffer<T> {
  unsafe {
    let spent = move leftover
    drop spent
  }
  return move buffer
}
