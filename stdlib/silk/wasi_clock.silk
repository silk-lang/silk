//! WASI wall-clock and monotonic-clock operations.
//!
//! # Details
//! A host failure traps. Clock waits block the command until the host reports the deadline.
//!
//! @category Native platform

static if Intrinsic.targetOperatingSystem() == "wasi" {
  import silk.wasi { Subscription, Event }
  import silk.wasi
  import silk.pointer { Pointer }
  import silk.system_clock { Instant, SystemClock }
  import silk.u64
  import silk.i64

  /// WASI clock operations. A host failure or an invalid clock result traps.
  pub struct WasiClock {}
  impl WasiClock {
    /// Returns monotonic time when `monotonic` is true, otherwise Unix time.
    /// A host failure traps.
    pub effect fn now(monotonic: bool) -> Instant {
      let mut clock: u32 = 0
      if monotonic {
        clock = 1
      }
      let mut time: u64 = 0
      let status = unsafe wasi.clock_time_get(clock, 1, Pointer.fromMutRef(&mut time))
      if status != 0 {
        Intrinsic.trap("WasiClock.now: the host clock_time_get call failed")
      }
      return SystemClock.make(u64.toI64(time / 1000000000), u64.toI64(time % 1000000000))
    }

    /// Returns the selected clock's resolution in nanoseconds. Zero or a host failure traps.
    pub effect fn resolution(monotonic: bool) -> u64 {
      let mut clock: u32 = 0
      if monotonic {
        clock = 1
      }
      let mut time: u64 = 0
      let status = unsafe wasi.clock_res_get(clock, Pointer.fromMutRef(&mut time))
      if status != 0 || time == 0 {
        Intrinsic.trap("WasiClock.resolution: the host clock_res_get call failed or returned zero")
      }
      return time
    }

    /// Blocks until the monotonic deadline. A negative or unrepresentable deadline traps.
    /// Interrupted waits keep the same deadline. A host failure traps.
    pub effect fn waitUntil(when: Instant) -> () {
      let seconds = SystemClock.seconds(&when)
      let nanoseconds = SystemClock.nanoseconds(&when)
      if seconds < 0 {
        Intrinsic.trap("WasiClock.waitUntil: the deadline is negative")
      }
      let timeout = i64.toU64(seconds) * 1000000000 + i64.toU64(nanoseconds)
      let subscriptions = [
        Subscription {
          userdata: 0,
          kind: 0,
          reserved: [0; 7],
          clock: 1,
          timeout: timeout,
          precision: 1,
          flags: 1
        }
      ]
      let mut events = [Event { userdata: 0, error: 0, kind: 0, bytes: 0, flags: 0 }]
      let mut count: u32 = 0
      while true {
        let status = unsafe wasi.poll_oneoff(
          Pointer.fromSlice(&subscriptions),
          Pointer.fromMutSlice(&mut events),
          1,
          Pointer.fromMutRef(&mut count)
        )
        if status != 27 {
          if status != 0 || count != 1 || events[0].error != 0 || events[0].kind != 0 {
            Intrinsic.trap(
              "WasiClock.waitUntil: the host poll_oneoff call failed or returned an invalid event"
            )
          }
          return ()
        }
      }
      return ()
    }
  }
}
