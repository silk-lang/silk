//! Synchronous source startup with an owned native HostInput provider.
//!
//! # When to use
//! Select this runtime explicitly for a hosted Darwin ARM64 or GNU Linux x86-64/ARM64 executable
//! whose application is an i32 Effect requiring borrowed HostInput. The default hosted runtime is
//! silk/native_start, which supports broader result signatures and diagnostic observation.
//!
//! # Details
//! Startup copies arguments and environment into owned storage, lends the provider to the
//! application, and releases it after the application completes. The exclusive provider loan
//! fulfills either a shared or exclusive HostInput requirement through ordinary service rules. Working-directory requests
//! observe the current directory through the ordinary provider. Applications supply every other
//! service themselves, including the Allocator needed by lookups that return owned bytes.
//!
//! Success returns the application's status. Initialization and application typed failures drop
//! their owned payload and return one. This composition installs no Execution, scheduler,
//! diagnostic observer, or report policy. The complete application call must be NonParking.
//!
//! # Gotchas
//! This minimal composition accepts only an i32 Effect requiring borrowed HostInput. Ordinary i32,
//! unit, other requirements, and parking need another source composition. Fatal traps do not
//! unwind and promise no cleanup.

static if (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText(
  "libc",
) == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText(
  "libc",
) == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
  import Intrinsic.application
  import silk.allocator {Allocator, OutOfMemoryError}
  import silk.effect {Effect}
  import silk.host_input {HostInput, HostInputError}
  import silk.native_host_input {NativeHostInput}
  import silk.os_host_input {OsHostInput}
  effect<'env> fn failed<E: 'env, 'env>(error: E) -> i32 {
    drop error
    return 1
  }
  fn invokeApplication(inputs: OsHostInput) -> i32 {
    let mut host = move inputs
    let computation = application.main()
    let supplied = Effect.provideMut<HostInput>(move computation, &mut host)
    return run Effect.catchAll(move supplied, failed)
  }
  fn invoke<F: fn<'static>(OsHostInput) -> i32 + Intrinsic.NonParking>(body: F, inputs: OsHostInput) -> i32 {
    return body(move inputs)
  }
  effect fn start(argc: i32, argv: [*]const ?[*]const u8) -> i32 ! HostInputError | OutOfMemoryError {
    let mut allocator = Allocator.systemAllocatorProvider()
    let inputs = run unsafe NativeHostInput.captureProcess(argc, argv)
      |> Effect.provideMut<Allocator>(&mut allocator)
    let provider = OsHostInput.make(move inputs)
    return invoke(invokeApplication, move provider)
  }
  /// Runs the explicitly selected application with a lexical process-input snapshot.
  ///
  /// # Details
  ///
  /// The platform supplies the standard C main argument-vector contract. Typed initialization or
  /// application failure returns one after cleanup; successful application status is unchanged.
  export "C" fn enter(argc: i32, argv: [*]const ?[*]const u8) -> i32 as "main" {
    return run Effect.catchAll(start(argc, argv), failed)
  }
}
