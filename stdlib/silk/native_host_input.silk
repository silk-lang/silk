//! Owned copies of the command-line arguments and the environment of the process.
//!
//! # When to use
//! The native runtime captures a [`NativeHostInput`] at start, and gives it to `main` as an
//! `OsHostInput`. Use [`NativeHostInput.environmentSnapshot`] in a library that gets no arguments,
//! or [`NativeHostInput.capture`] in a custom runtime.
//!
//! # Details
//! A capture copies all bytes, so later lookups do not use the memory of the process. The working
//! directory is read at each call, not captured.
//!
//! # Errors
//! `HostInputError` if the input is not valid. `OutOfMemoryError` if a copy cannot be allocated.
//!
//! # Gotchas
//! - The capture functions are unsafe. The input vectors and their strings must stay readable and
//!   unchanged during the capture. No other code can change the environment at that time.
//! - The module is empty on targets other than Darwin on aarch64, and Linux with GNU libc on x86_64
//!   or aarch64.
//!
//! # Examples
//! ## Copy the environment
//! ```silk
//! import silk.allocator { Allocator, OutOfMemoryError }
//! import silk.bytes { Bytes }
//! import silk.effect { Effect }
//! import silk.host_input { HostInputError }
//! import silk.native_host_input { NativeHostInput }
//! import silk.option { Option }
//!
//! effect fn program() -> i32
//!   ! HostInputError | OutOfMemoryError
//!   ? &mut Allocator {
//!   // Copy the environment. No other code changes the environment now.
//!   let inputs = run unsafe NativeHostInput.environmentSnapshot()
//!   if NativeHostInput.argumentCount(&inputs) != 0 {
//!     return 1
//!   }
//!
//!   // An empty output asks only for the length.
//!   let mut empty: [u8; 0] = []
//!   let missing = NativeHostInput.variable(&inputs, b"SILK_DOC_NOT_SET", &mut empty)
//!   match move missing {
//!     Option.Some { value: _ } => {
//!       return 1
//!     }
//!     Option.None => {}
//!   }
//!   let directory = run NativeHostInput.workingDirectory()
//!   if Bytes.length(&directory) == 0 {
//!     return 1
//!   }
//!   return 0
//! }
//!
//! effect fn failed<E>(error: E) -> i32 {
//!   drop error
//!   return 1
//! }
//!
//! pub fn main() -> i32 {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   return run Effect.catchAll(program(), failed) |> Effect.provideMut<Allocator>(&mut allocator)
//! }
//! ```

static if (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText("libc") == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
  import silk.allocator { Allocator, OutOfMemoryError }
  import silk.bytes { Bytes }
  import silk.host_input { HostInput, HostInputError }
  import silk.option { Option }
  import silk.pointer { Pointer }
  import silk.list { List }
  import silk.i32

  unsafe extern "C" fn getcwd(buffer: ?[*]mut u8, size: usize) -> ?[*]mut u8 with Intrinsic.foreign(noCapture: ("buffer",))
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    unsafe extern "C" fn __error() -> *mut i32
    unsafe extern "C" fn _NSGetEnviron() -> *const ?[*]const ?[*]const u8
    unsafe fn environmentVector() -> ?[*]const ?[*]const u8 {
      unsafe { return Pointer.read(_NSGetEnviron()) }
    }
    unsafe fn currentError() -> i32 { unsafe { return Pointer.read(__error()) } }
  } else {
    unsafe extern "C" fn __errno_location() -> *mut i32
    unsafe extern "C" static processEnvironment: ?[*]const ?[*]const u8 as "environ"
    unsafe fn environmentVector() -> ?[*]const ?[*]const u8 {
      unsafe { return processEnvironment }
    }
    unsafe fn currentError() -> i32 { unsafe { return Pointer.read(__errno_location()) } }
  }

  /// An owned copy of the command-line arguments and the environment of the process.
  ///
  /// # When to use
  /// The native runtime captures one at start, and gives it to `main` as an `OsHostInput`. Use
  /// [`NativeHostInput.environmentSnapshot`] in a library that gets no arguments, or
  /// [`NativeHostInput.capture`] in a custom runtime.
  ///
  /// # Details
  /// A capture copies all bytes, so later lookups do not use the memory of the process. The
  /// working directory is read at each call, not captured.
  ///
  /// # Gotchas
  /// The capture functions are unsafe. The input vectors and their strings must stay readable and
  /// unchanged during the capture. No other code can change the environment at that time.
  pub struct NativeHostInput {
    arguments: List<Bytes>
    environment: List<Bytes>
  }

  unsafe effect fn copyString(text: [*]const u8) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    let mut result = Bytes.make()
    let mut index: usize = 0
    while true {
      let byte = unsafe Pointer.read(unsafe Pointer.at(text, index))
      if byte == 0 { break }
      let one = [byte]
      let appended = run Bytes.append(&mut result, &one)
      index = index + 1
    }
    return move result
  }

  fn copyPrefix(value: &[u8], start: usize, output: &mut [u8]) -> usize {
    let length = value.length - start
    let mut index: usize = 0
    while index < length && index < output.length {
      output[index] = value[start + index]
      index = index + 1
    }
    return length
  }

  unsafe effect fn copyArguments(result: &mut NativeHostInput, argc: i32, argv: [*]const ?[*]const u8) -> () ! HostInputError | OutOfMemoryError ? &mut Allocator {
    if argc < 0 { fail HostInput.inputFailure() }
      let count = i32.toUsize(argc)
      let mut index: usize = 0
      while index < count {
        let pointer = unsafe Pointer.read(unsafe Pointer.at(argv, index))
        let selected = Pointer.nonNullMany(pointer)
        let text = match move selected {
          Option<[*]const u8>.Some { value } => value
          Option<[*]const u8>.None => { fail HostInput.inputFailure() }
        }
        let copied = run unsafe copyString(text)
        let appended = run List<Bytes>.append(&mut result.arguments, move copied)
        index = index + 1
      }
    return ()
  }

  impl NativeHostInput {
    /// Copies the environment of the process, with no arguments.
    ///
    /// # Gotchas
    /// No other code can change the environment during the call. A null environment gives no
    /// variables.
    pub unsafe effect fn environmentSnapshot() -> NativeHostInput ! HostInputError | OutOfMemoryError ? &mut Allocator {
      let selected = Pointer.nonNullMany(unsafe environmentVector())
      return match move selected {
        Option<[*]const ?[*]const u8>.Some { value } => run unsafe NativeHostInput.capture(0, value, value)
        Option<[*]const ?[*]const u8>.None => NativeHostInput {
          arguments: List<Bytes>.make(),
          environment: List<Bytes>.make(),
        }
      }
    }

    /// Copies `argc` arguments from `argv`, and the environment of the process.
    ///
    /// # Gotchas
    /// `argv` must have `argc` readable entries, each a NUL-terminated string that does not change.
    /// No other code can change the environment during the call. If it fails, all copies are freed.
    pub unsafe effect fn captureProcess(argc: i32, argv: [*]const ?[*]const u8) -> NativeHostInput ! HostInputError | OutOfMemoryError ? &mut Allocator {
      if argc < 0 { fail HostInput.inputFailure() }
      let mut result = run unsafe NativeHostInput.environmentSnapshot()
      run unsafe copyArguments(&mut result, argc, argv)
      return move result
    }

    /// Copies `argc` arguments from `argv`, and the entries of `environment` up to its null entry.
    ///
    /// # Gotchas
    /// Each non-null entry must be a NUL-terminated string that does not change during the call. If
    /// it fails, all copies are freed.
    pub unsafe effect fn capture(
      argc: i32,
      argv: [*]const ?[*]const u8,
      environment: [*]const ?[*]const u8
    ) -> NativeHostInput ! HostInputError | OutOfMemoryError ? &mut Allocator {
      if argc < 0 { fail HostInput.inputFailure() }
      let mut result = NativeHostInput {
        arguments: List<Bytes>.make(),
        environment: List<Bytes>.make(),
      }
      run unsafe copyArguments(&mut result, argc, argv)
      let mut index: usize = 0
      while true {
        let pointer = unsafe Pointer.read(unsafe Pointer.at(environment, index))
        if Pointer.isNullMany(pointer) { break }
        let selected = Pointer.nonNullMany(pointer)
        let text = match move selected {
          Option<[*]const u8>.Some { value } => value
          Option<[*]const u8>.None => { fail HostInput.inputFailure() }
        }
        let copied = run unsafe copyString(text)
        let appended = run List<Bytes>.append(&mut result.environment, move copied)
        index = index + 1
      }
      return move result
    }

    /// Returns the number of arguments, with the program name if there is one.
    pub fn argumentCount(self: &Self) -> usize {
      return List<Bytes>.length(&self.arguments)
    }

    /// Copies the start of argument `index` to `output`, and returns its full length, or `None` if
    /// there is no such argument.
    ///
    /// # Details
    /// An empty argument returns `Some(0)`. If `output` is too short, only its length is copied,
    /// and the bytes after the copy are not changed.
    pub fn argument(self: &Self, index: usize, output: &mut [u8]) -> Option<usize> {
      if index >= List<Bytes>.length(&self.arguments) { return Option<usize>.none() }
      let arguments = List<Bytes>.asSlice(&self.arguments)
      return Option<usize>.some(copyPrefix(Bytes.asSlice(&arguments[index]), 0, move output))
    }

    /// Copies the start of the value of the first variable named `name` to `output`, and returns
    /// its full length, or `None`.
    ///
    /// # Details
    /// The name must match byte for byte. An empty value returns `Some(0)`. A name with NUL or `=`
    /// never matches. Entries without `=` are ignored.
    pub fn variable(self: &Self, name: &[u8], output: &mut [u8]) -> Option<usize> {
      let entries = List<Bytes>.asSlice(&self.environment)
      let mut entry: usize = 0
      while entry < entries.length {
        let bytes = Bytes.asSlice(&entries[entry])
        let mut separator: usize = 0
        while separator < bytes.length && bytes[separator] != 61 {
          separator = separator + 1
        }
        if separator < bytes.length && separator == name.length {
          let mut equal = true
          let mut index: usize = 0
          while index < separator {
            if bytes[index] != name[index] { equal = false }
            index = index + 1
          }
          if equal { return Option<usize>.some(copyPrefix(bytes, separator + 1, move output)) }
        }
        entry = entry + 1
      }
      return Option<usize>.none()
    }

    /// Returns the current working directory of the process.
    ///
    /// # Details
    /// It starts with a 256-byte buffer, and makes it larger when the path does not fit, up to 1
    /// MiB.
    ///
    /// # Errors
    /// `OutOfMemoryError` if a buffer cannot be allocated. `HostInputError` for other failures.
    pub effect fn workingDirectory() -> Bytes ! HostInputError | OutOfMemoryError ? &mut Allocator {
      let mut room: usize = 256
      while room <= 1048576 {
        let mut buffer = run Bytes.zeroed(room)
        let pointer = Pointer.fromMutSlice(Bytes.asMutSlice(&mut buffer))
        let found = unsafe getcwd(pointer, room)
        if Pointer.isNullMany(found) == false {
          let bytes = Bytes.asSlice(&buffer)
          let mut length: usize = 0
          while length < room && bytes[length] != 0 { length = length + 1 }
          if length == room { fail HostInput.inputFailure() }
          let mut result = Bytes.make()
          let mut index: usize = 0
          while index < length {
            let one = [bytes[index]]
            let appended = run Bytes.append(&mut result, &one)
            index = index + 1
          }
          return move result
        }
        let error = unsafe currentError()
        if error != 34 { fail HostInput.inputFailure() }
        room = room * 2
      }
      fail HostInput.inputFailure()
    }

    /// Copies the start of the working directory to `output`, and returns its full length. The
    /// bytes after the copy are not changed.
    pub effect fn workingDirectoryCopy(output: &mut [u8]) -> usize ! HostInputError | OutOfMemoryError ? &mut Allocator {
      let value = run NativeHostInput.workingDirectory()
      return copyPrefix(Bytes.asSlice(&value), 0, move output)
    }
  }
}
