// The D50 reference white of CIE Lab, from the chromaticity (0.3457, 0.3585).
const D50_WHITE: [f64; 3] = [0.3457 / 0.3585, 1.0, (1.0 - 0.3457 - 0.3585) / 0.3585]

const LAB_EPSILON: f64 = 216.0 / 24389.0

const LAB_KAPPA: f64 = 24389.0 / 27.0

// Below these chroma values a polar hue is powerless and conversion marks it missing.
const LCH_ACHROMATIC: f64 = 0.0015

const OKLCH_ACHROMATIC: f64 = 0.000004

const RGB_ACHROMATIC: f64 = 0.000000001

const GAMUT_TOLERANCE: f64 = 0.000000001

const JUST_NOTICEABLE: f64 = 0.02

const CHROMA_PRECISION: f64 = 0.0001

fn hexByte(value: u32) -> f64 {
  return u32.toF64(u32.bitAnd(value, 255)) / 255.0
}

// Returns the value of an ASCII hex digit, or 16 for any other byte.
fn hexDigit(byte: u8) -> u32 {
  if byte >= 48 && byte <= 57 {
    return u8.toU32(byte - 48)
  }
  if byte >= 97 && byte <= 102 {
    return u8.toU32(byte - 87)
  }
  if byte >= 65 && byte <= 70 {
    return u8.toU32(byte - 55)
  }
  return 16
}

fn clamp(value: f64, low: f64, high: f64) -> f64 {
  return f64.min(f64.max(value, low), high)
}

fn resolvedValue(value: f64) -> f64 {
  return if f64.isNaN(value) {
    0.0
  } else {
    value
  }
}

fn resolved(components: [f64; 3]) -> [f64; 3] {
  return [resolvedValue(components[0]), resolvedValue(components[1]), resolvedValue(components[2])]
}

fn displayAlpha(alpha: f64) -> f64 {
  if f64.isNaN(alpha) {
    return 1.0
  }
  return clamp(alpha, 0.0, 1.0)
}

fn normalizeHue(degrees: f64) -> f64 {
  let wrapped = degrees - 360.0 * f64.floor(degrees / 360.0)
  return if wrapped >= 360.0 {
    0.0
  } else {
    wrapped
  }
}

fn distance(a: [f64; 3], b: [f64; 3]) -> f64 {
  return f64.hypot(f64.hypot(a[0] - b[0], a[1] - b[1]), a[2] - b[2])
}

fn close(a: f64, b: f64, tolerance: f64, hue: bool) -> bool {
  if f64.isNaN(a) || f64.isNaN(b) {
    return f64.isNaN(a) && f64.isNaN(b)
  }
  if hue {
    let difference = normalizeHue(a - b)
    return f64.min(difference, 360.0 - difference) <= tolerance
  }
  return f64.abs(a - b) <= tolerance
}

fn matrix(m: &[f64; 9], v: [f64; 3]) -> [f64; 3] {
  return [
    m[0] * v[0] + m[1] * v[1] + m[2] * v[2],
    m[3] * v[0] + m[4] * v[1] + m[5] * v[2],
    m[6] * v[0] + m[7] * v[1] + m[8] * v[2],
  ]
}

// The index of the hue component of a polar space, or 3 when the space has no hue.
fn hueComponent(space: ColorSpace) -> usize {
  return match space {
    ColorSpace.Lch => 2
    ColorSpace.Oklch => 2
    ColorSpace.Hsl => 0
    ColorSpace.Hwb => 0
    _ => 3
  }
}

// The rectangular space that a polar or cylindrical space is defined over.
fn baseSpace(space: ColorSpace) -> ColorSpace {
  return match space {
    ColorSpace.Hsl => ColorSpace.Srgb
    ColorSpace.Hwb => ColorSpace.Srgb
    ColorSpace.Lch => ColorSpace.Lab
    ColorSpace.Oklch => ColorSpace.Oklab
    _ => space
  }
}

// The RGB space whose gamut bounds a space: HSL and HWB use sRGB.
fn gamutSpace(space: ColorSpace) -> ColorSpace {
  return match space {
    ColorSpace.Hsl => ColorSpace.Srgb
    ColorSpace.Hwb => ColorSpace.Srgb
    _ => space
  }
}

fn hasGamut(space: ColorSpace) -> bool {
  return match space {
    ColorSpace.Srgb => true
    ColorSpace.SrgbLinear => true
    ColorSpace.DisplayP3 => true
    ColorSpace.A98Rgb => true
    ColorSpace.ProphotoRgb => true
    ColorSpace.Rec2020 => true
    _ => false
  }
}

fn rgbInGamut(c: [f64; 3]) -> bool {
  let low = -GAMUT_TOLERANCE
  let high = 1.0 + GAMUT_TOLERANCE
  return c[0] >= low && c[0] <= high && c[1] >= low && c[1] <= high && c[2] >= low && c[2] <= high
}

fn clipped(c: [f64; 3]) -> [f64; 3] {
  return [clamp(c[0], 0.0, 1.0), clamp(c[1], 0.0, 1.0), clamp(c[2], 0.0, 1.0)]
}

fn convert(from: ColorSpace, to: ColorSpace, components: [f64; 3]) -> [f64; 3] {
  let fromBase = baseSpace(from)
  let toBase = baseSpace(to)
  let mut base = toBaseComponents(from, components)
  if fromBase == ColorSpace.Srgb && toBase == ColorSpace.SrgbLinear {
    base = srgbDecode(base)
  } else if fromBase == ColorSpace.SrgbLinear && toBase == ColorSpace.Srgb {
    base = srgbEncode(base)
  } else if fromBase != toBase {
    base = fromXyz(toBase, toXyz(fromBase, base))
  }
  return fromBaseComponents(to, base)
}

// Converts polar and cylindrical components to those of the space's base space.
fn toBaseComponents(space: ColorSpace, c: [f64; 3]) -> [f64; 3] {
  return match space {
    ColorSpace.Hsl => hslToSrgb(c)
    ColorSpace.Hwb => hwbToSrgb(c)
    ColorSpace.Lch => polarToRectangular(c)
    ColorSpace.Oklch => polarToRectangular(c)
    _ => c
  }
}

// Converts base-space components to a polar or cylindrical space, marking powerless hues missing.
fn fromBaseComponents(space: ColorSpace, c: [f64; 3]) -> [f64; 3] {
  return match space {
    ColorSpace.Hsl => srgbToHsl(c)
    ColorSpace.Hwb => srgbToHwb(c)
    ColorSpace.Lch => rectangularToPolar(c, LCH_ACHROMATIC)
    ColorSpace.Oklch => rectangularToPolar(c, OKLCH_ACHROMATIC)
    _ => c
  }
}

fn toXyz(space: ColorSpace, c: [f64; 3]) -> [f64; 3] {
  return match space {
    ColorSpace.Srgb => matrix(&SRGB_XYZ, srgbDecode(c))
    ColorSpace.SrgbLinear => matrix(&SRGB_XYZ, c)
    ColorSpace.DisplayP3 => matrix(&P3_XYZ, srgbDecode(c))
    ColorSpace.A98Rgb => matrix(&A98_XYZ, gammaDecode(c, 563.0 / 256.0))
    ColorSpace.ProphotoRgb => matrix(&D50_D65, matrix(&PROPHOTO_XYZ_D50, prophotoDecode(c)))
    ColorSpace.Rec2020 => matrix(&REC2020_XYZ, gammaDecode(c, 2.4))
    ColorSpace.XyzD50 => matrix(&D50_D65, c)
    ColorSpace.XyzD65 => c
    ColorSpace.Lab => matrix(&D50_D65, labToXyzD50(c))
    ColorSpace.Oklab => oklabToXyz(c)
    _ => c
  }
}

fn fromXyz(space: ColorSpace, xyz: [f64; 3]) -> [f64; 3] {
  return match space {
    ColorSpace.Srgb => srgbEncode(matrix(&XYZ_SRGB, xyz))
    ColorSpace.SrgbLinear => matrix(&XYZ_SRGB, xyz)
    ColorSpace.DisplayP3 => srgbEncode(matrix(&XYZ_P3, xyz))
    ColorSpace.A98Rgb => gammaEncode(matrix(&XYZ_A98, xyz), 563.0 / 256.0)
    ColorSpace.ProphotoRgb => prophotoEncode(matrix(&XYZ_D50_PROPHOTO, matrix(&D65_D50, xyz)))
    ColorSpace.Rec2020 => gammaEncode(matrix(&XYZ_REC2020, xyz), 2.4)
    ColorSpace.XyzD50 => matrix(&D65_D50, xyz)
    ColorSpace.XyzD65 => xyz
    ColorSpace.Lab => xyzD50ToLab(matrix(&D65_D50, xyz))
    ColorSpace.Oklab => xyzToOklab(xyz)
    _ => xyz
  }
}

fn srgbDecodeChannel(value: f64) -> f64 {
  let magnitude = f64.abs(value)
  if magnitude <= 0.04045 {
    return value / 12.92
  }
  return f64.copysign(f64.pow((magnitude + 0.055) / 1.055, 2.4), value)
}

fn srgbEncodeChannel(value: f64) -> f64 {
  let magnitude = f64.abs(value)
  if magnitude <= 0.0031308 {
    return value * 12.92
  }
  return f64.copysign(1.055 * f64.pow(magnitude, 1.0 / 2.4) - 0.055, value)
}

fn srgbDecode(c: [f64; 3]) -> [f64; 3] {
  return [srgbDecodeChannel(c[0]), srgbDecodeChannel(c[1]), srgbDecodeChannel(c[2])]
}

fn srgbEncode(c: [f64; 3]) -> [f64; 3] {
  return [srgbEncodeChannel(c[0]), srgbEncodeChannel(c[1]), srgbEncodeChannel(c[2])]
}

// A pure power curve mirrored through zero, as a98-rgb and rec2020 use.
fn signedPow(value: f64, exponent: f64) -> f64 {
  return f64.copysign(f64.pow(f64.abs(value), exponent), value)
}

fn gammaDecode(c: [f64; 3], gamma: f64) -> [f64; 3] {
  return [signedPow(c[0], gamma), signedPow(c[1], gamma), signedPow(c[2], gamma)]
}

fn gammaEncode(c: [f64; 3], gamma: f64) -> [f64; 3] {
  return [signedPow(c[0], 1.0 / gamma), signedPow(c[1], 1.0 / gamma), signedPow(c[2], 1.0 / gamma)]
}

fn prophotoDecodeChannel(value: f64) -> f64 {
  if f64.abs(value) <= 16.0 / 512.0 {
    return value / 16.0
  }
  return signedPow(value, 1.8)
}

fn prophotoEncodeChannel(value: f64) -> f64 {
  if f64.abs(value) >= 1.0 / 512.0 {
    return signedPow(value, 1.0 / 1.8)
  }
  return value * 16.0
}

fn prophotoDecode(c: [f64; 3]) -> [f64; 3] {
  return [prophotoDecodeChannel(c[0]), prophotoDecodeChannel(c[1]), prophotoDecodeChannel(c[2])]
}

fn prophotoEncode(c: [f64; 3]) -> [f64; 3] {
  return [prophotoEncodeChannel(c[0]), prophotoEncodeChannel(c[1]), prophotoEncodeChannel(c[2])]
}

fn labToXyzD50(lab: [f64; 3]) -> [f64; 3] {
  let fy = (lab[0] + 16.0) / 116.0
  let fx = lab[1] / 500.0 + fy
  let fz = fy - lab[2] / 200.0
  let x = if fx * fx * fx > LAB_EPSILON {
    fx * fx * fx
  } else {
    (116.0 * fx - 16.0) / LAB_KAPPA
  }
  let y = if lab[0] > LAB_KAPPA * LAB_EPSILON {
    fy * fy * fy
  } else {
    lab[0] / LAB_KAPPA
  }
  let z = if fz * fz * fz > LAB_EPSILON {
    fz * fz * fz
  } else {
    (116.0 * fz - 16.0) / LAB_KAPPA
  }
  return [x * D50_WHITE[0], y * D50_WHITE[1], z * D50_WHITE[2]]
}

fn labCompand(value: f64) -> f64 {
  if value > LAB_EPSILON {
    return f64.cbrt(value)
  }
  return (LAB_KAPPA * value + 16.0) / 116.0
}

fn xyzD50ToLab(xyz: [f64; 3]) -> [f64; 3] {
  let fx = labCompand(xyz[0] / D50_WHITE[0])
  let fy = labCompand(xyz[1] / D50_WHITE[1])
  let fz = labCompand(xyz[2] / D50_WHITE[2])
  return [116.0 * fy - 16.0, 500.0 * (fx - fy), 200.0 * (fy - fz)]
}

fn oklabToXyz(lab: [f64; 3]) -> [f64; 3] {
  let lms = matrix(&OKLAB_LMS, lab)
  return matrix(
    &LMS_XYZ,
    [lms[0] * lms[0] * lms[0], lms[1] * lms[1] * lms[1], lms[2] * lms[2] * lms[2]],
  )
}

fn xyzToOklab(xyz: [f64; 3]) -> [f64; 3] {
  let lms = matrix(&XYZ_LMS, xyz)
  return matrix(&LMS_OKLAB, [f64.cbrt(lms[0]), f64.cbrt(lms[1]), f64.cbrt(lms[2])])
}

fn polarToRectangular(c: [f64; 3]) -> [f64; 3] {
  let radians = resolvedValue(c[2]) * f64.PI / 180.0
  return [c[0], c[1] * f64.cos(radians), c[1] * f64.sin(radians)]
}

fn rectangularToPolar(c: [f64; 3], achromatic: f64) -> [f64; 3] {
  let chroma = f64.hypot(c[1], c[2])
  let hue = if chroma < achromatic {
    f64.NAN
  } else {
    normalizeHue(f64.atan2(c[2], c[1]) * 180.0 / f64.PI)
  }
  return [c[0], chroma, hue]
}

fn hslChannel(n: f64, h: f64, s: f64, l: f64) -> f64 {
  let k = normalizeTwelve(n + h / 30.0)
  let amplitude = s * f64.min(l, 1.0 - l)
  return l - amplitude * f64.max(-1.0, f64.min(f64.min(k - 3.0, 9.0 - k), 1.0))
}

fn normalizeTwelve(value: f64) -> f64 {
  return value - 12.0 * f64.floor(value / 12.0)
}

fn hslToSrgb(c: [f64; 3]) -> [f64; 3] {
  let h = normalizeHue(resolvedValue(c[0]))
  return [
    hslChannel(0.0, h, c[1], c[2]),
    hslChannel(8.0, h, c[1], c[2]),
    hslChannel(4.0, h, c[1], c[2]),
  ]
}

fn hwbToSrgb(c: [f64; 3]) -> [f64; 3] {
  let white = c[1]
  let black = c[2]
  if white + black >= 1.0 {
    let gray = white / (white + black)
    return [gray, gray, gray]
  }
  let rgb = hslToSrgb([c[0], 1.0, 0.5])
  let factor = 1.0 - white - black
  return [rgb[0] * factor + white, rgb[1] * factor + white, rgb[2] * factor + white]
}

// The hue in degrees of an sRGB color, or NaN when the channels are equal.
fn srgbHue(c: [f64; 3]) -> f64 {
  let high = f64.max(f64.max(c[0], c[1]), c[2])
  let low = f64.min(f64.min(c[0], c[1]), c[2])
  let d = high - low
  if d < RGB_ACHROMATIC {
    return f64.NAN
  }
  let mut hue = 0.0
  if high == c[0] {
    hue = (c[1] - c[2]) / d
    if c[1] < c[2] {
      hue = hue + 6.0
    }
  } else if high == c[1] {
    hue = (c[2] - c[0]) / d + 2.0
  } else {
    hue = (c[0] - c[1]) / d + 4.0
  }
  return normalizeHue(hue * 60.0)
}

fn srgbToHsl(c: [f64; 3]) -> [f64; 3] {
  let high = f64.max(f64.max(c[0], c[1]), c[2])
  let low = f64.min(f64.min(c[0], c[1]), c[2])
  let lightness = (high + low) / 2.0
  let mut hue = srgbHue(c)
  let mut saturation = 0.0
  if !f64.isNaN(hue) && lightness != 0.0 && lightness != 1.0 {
    saturation = (high - lightness) / f64.min(lightness, 1.0 - lightness)
  }

  // An out-of-gamut color can give negative saturation: flip it to the opposite hue.
  if saturation < 0.0 {
    saturation = -saturation
    hue = normalizeHue(hue + 180.0)
  }
  return [hue, saturation, lightness]
}

fn srgbToHwb(c: [f64; 3]) -> [f64; 3] {
  let white = f64.min(f64.min(c[0], c[1]), c[2])
  let black = 1.0 - f64.max(f64.max(c[0], c[1]), c[2])
  let hue = if white + black >= 1.0 - RGB_ACHROMATIC {
    f64.NAN
  } else {
    srgbHue(c)
  }
  return [hue, white, black]
}

// The CSS Color 4 gamut-mapping algorithm (#binsearch): reduce Oklch chroma until the clipped color
// is within one just noticeable difference of the unclipped one. `space` is an RGB space.
fn gamutMap(color: Color, space: ColorSpace) -> [f64; 3] {
  let origin = color.to(space).components
  if rgbInGamut(origin) {
    return clipped(origin)
  }
  let mut current = color.to(ColorSpace.Oklch)
  current.components = resolved(current.components)
  if current.components[0] >= 1.0 {
    return convert(ColorSpace.Srgb, space, [1.0, 1.0, 1.0])
  }
  if current.components[0] <= 0.0 {
    return [0.0, 0.0, 0.0]
  }
  let mut result = clipped(origin)
  if deltaEOKComponents(space, result, current.components) < JUST_NOTICEABLE {
    return result
  }
  let mut low = 0.0
  let mut high = current.components[1]
  let mut lowInGamut = true
  while high - low > CHROMA_PRECISION {
    let chroma = (low + high) / 2.0
    current.components[1] = chroma
    let candidate = convert(ColorSpace.Oklch, space, current.components)
    if lowInGamut && rgbInGamut(candidate) {
      low = chroma
    } else {
      result = clipped(candidate)
      let error = deltaEOKComponents(space, result, current.components)
      if error < JUST_NOTICEABLE {
        if JUST_NOTICEABLE - error < CHROMA_PRECISION {
          return result
        }
        lowInGamut = false
        low = chroma
      } else {
        high = chroma
      }
    }
  }
  return result
}

// deltaEOK between `rgb` in `space` and an Oklch color.
fn deltaEOKComponents(space: ColorSpace, rgb: [f64; 3], oklch: [f64; 3]) -> f64 {
  return distance(convert(space, ColorSpace.Oklab, rgb), polarToRectangular(oklch))
}

// The analogous-component category of CSS Color 4 interpolation (#interpolation-missing): 1 reds, 2
// greens, 3 blues, 4 lightness, 5 colorfulness, 6 hue, 7 opponent a, 8 opponent b, 0 none.
fn category(space: ColorSpace, index: usize) -> u8 {
  let categories: [u8; 3] = match space {
    ColorSpace.Lab => [4, 7, 8]
    ColorSpace.Oklab => [4, 7, 8]
    ColorSpace.Lch => [4, 5, 6]
    ColorSpace.Oklch => [4, 5, 6]
    ColorSpace.Hsl => [6, 5, 4]
    ColorSpace.Hwb => [6, 0, 0]
    _ => [1, 2, 3]
  }
  return categories[index]
}

// Converts `color` for interpolation in `space`, carrying missing components into the analogous
// components of the target space.
fn prepared(color: Color, space: ColorSpace) -> Color {
  if color.space == space {
    return color
  }
  let mut result = color.to(space)
  let mut i: usize = 0
  while i < 3 {
    if f64.isNaN(color.components[i]) {
      let kind = category(color.space, i)
      let mut j: usize = 0
      while j < 3 {
        if kind != 0 && category(space, j) == kind {
          result.components[j] = f64.NAN
        }
        j = j + 1
      }
    }
    i = i + 1
  }
  return result
}

// Returns `value`, or `other` when `value` is missing, so a component missing in one color of an
// interpolation takes the other color's value.
fn filled(value: f64, other: f64) -> f64 {
  return if f64.isNaN(value) {
    other
  } else {
    value
  }
}

// Adjusts two hues in [0, 360) so that linear interpolation between them follows `method`.
fn fixupHues(first: f64, second: f64, method: HueInterpolation) -> [f64; 2] {
  let mut a = normalizeHue(first)
  let mut b = normalizeHue(second)
  let difference = b - a
  match method {
    HueInterpolation.Shorter => {
      if difference > 180.0 {
        a = a + 360.0
      } else if difference < -180.0 {
        b = b + 360.0
      }
    }
    HueInterpolation.Longer => {
      if difference > 0.0 && difference < 180.0 {
        a = a + 360.0
      } else if difference > -180.0 && difference <= 0.0 {
        b = b + 360.0
      }
    }
    HueInterpolation.Increasing => {
      if b < a {
        b = b + 360.0
      }
    }
    HueInterpolation.Decreasing => {
      if a < b {
        a = a + 360.0
      }
    }
  }
  return [a, b]
}
