//! Colors in the CSS Color 4 color spaces, with conversion, gamut mapping, mixing, adjustment, and
//! contrast measurement.
//!
//! # When to use
//! Use [`Color`] whenever a color is more than four channels to copy: to convert between sRGB,
//! Display P3, Oklch, Lab, HSL, and the other [`ColorSpace`] values, to interpolate gradient stops,
//! to derive hover and pressed shades of a theme color, or to check that text is readable on its
//! background. Use [`to`] to convert, [`toGamut`] or [`toRgba`] to get displayable channels,
//! [`mix`] to interpolate, [`lighten`], [`darken`], [`saturate`], and [`rotateHue`] to adjust, and
//! [`contrastRatio`] to measure legibility.
//!
//! # Details
//! A color is a [`ColorSpace`], three components, and an alpha, all public and in `f64`. Components
//! use the CSS Color 4 reference ranges, except that percentages are fractions in `[0, 1]`:
//!
//! - RGB spaces (`Srgb`, `SrgbLinear`, `DisplayP3`, `A98Rgb`, `ProphotoRgb`, `Rec2020`): red,
//!   green, and blue in `[0, 1]` inside the gamut.
//! - `XyzD65` and `XyzD50`: X, Y, and Z, with Y `1` for the reference white.
//! - `Lab`: lightness in `[0, 100]`, then a and b, roughly in `[-125, 125]`. `Lch`: lightness,
//!   chroma from `0`, then hue in degrees.
//! - `Oklab`: lightness in `[0, 1]`, then a and b, roughly in `[-0.4, 0.4]`. `Oklch`: lightness,
//!   chroma from `0`, then hue in degrees.
//! - `Hsl`: hue in degrees, saturation and lightness in `[0, 1]`. `Hwb`: hue in degrees, whiteness
//!   and blackness in `[0, 1]`.
//!
//! A NaN component or alpha is a missing component, which CSS writes as `none`. Conversion reads a
//! missing component as zero. [`mix`] instead takes it from the other color, as CSS Color 4
//! interpolation requires. Conversion into a polar space marks the hue of an achromatic color, such
//! as white or gray, as missing, because no hue describes it.
//!
//! Conversion goes through CIE XYZ with the D65 white point, using the matrices and transfer
//! functions of the CSS Color 4 sample code. Lab and ProPhoto use a D50 white and a Bradford
//! adaptation. Conversion never clips: a color outside the gamut of the target space gets
//! components outside `[0, 1]`. [`toGamut`] and [`toRgba`] map it into the gamut with the CSS Color
//! 4 algorithm, which lowers Oklch chroma until the color fits and keeps lightness and hue.
//!
//! # Gotchas
//! Missing components are NaN, so `==` on two components or a direct arithmetic step can give NaN.
//! Read a hue through [`isMissing`] first, or use [`approxEquals`], which treats two missing
//! components as equal.
//!
//! # Examples
//! ## Derive theme shades and check text contrast
//! ```silk
//! import silk.color.color { Color, ColorSpace, Interpolation }
//!
//! pub fn main() -> i32 {
//!   let brand = Color.fromHex(0x3366cc)
//!   let hover = brand.lighten(0.08)
//!   let border = brand.mix(Color.white(), 0.5, Interpolation.new(ColorSpace.Oklab))
//!   if hover.space != ColorSpace.Srgb || border.space != ColorSpace.Oklab {
//!     return 1
//!   }
//!   if Color.white().contrastRatio(brand) < 4.5 {
//!     return 2
//!   }
//!   let channels = brand.to(ColorSpace.Oklch).toRgba()
//!   if channels.b < 0.79 || channels.b > 0.81 {
//!     return 3
//!   }
//!   return 0
//! }
//! ```
//!
//! # See also
//! Use `silk.color.rgba` for plain straight or premultiplied channels, and `silk.color.srgb` for
//! the sRGB transfer function alone.
//!
//! @category Color

import silk.color.rgba { Rgba }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.num.f64
import silk.num.u32
import silk.num.u8
import silk.text.string { String }

/// A color space from CSS Color 4: the meaning and range of the three components of a [`Color`].
///
/// # Details
///
/// Each value names the space that CSS writes in `color()`, a color function, or an interpolation
/// method. Percentages are fractions here, so HSL saturation `50%` is `0.5`.
pub enum ColorSpace {
  /// Gamma-encoded sRGB: red, green, and blue in `[0, 1]`. The space of CSS hex colors and `rgb()`.
  Srgb,
  /// sRGB primaries with linear-light channels in `[0, 1]`, for physically correct blending.
  SrgbLinear,
  /// Display P3: the wider gamut of modern displays, with the sRGB transfer function.
  DisplayP3,
  /// Adobe RGB (1998), the `a98-rgb` space of CSS.
  A98Rgb,
  /// ProPhoto RGB, a very wide gamut with a D50 white point.
  ProphotoRgb,
  /// ITU-R BT.2020 primaries with a 2.4 gamma, the `rec2020` space of CSS.
  Rec2020,
  /// CIE XYZ with the D50 white point.
  XyzD50,
  /// CIE XYZ with the D65 white point, the hub of every conversion.
  XyzD65,
  /// CIE Lab (D50): lightness in `[0, 100]`, then the a (green to red) and b (blue to yellow) axes.
  Lab,
  /// CIE LCh (D50): lightness in `[0, 100]`, chroma from `0`, and hue in degrees.
  Lch,
  /// Oklab: perceptual lightness in `[0, 1]`, then the a and b axes, roughly in `[-0.4, 0.4]`.
  Oklab,
  /// Oklch: Oklab lightness in `[0, 1]`, chroma from `0`, and hue in degrees.
  Oklch,
  /// HSL over sRGB: hue in degrees, saturation and lightness in `[0, 1]`.
  Hsl,
  /// HWB over sRGB: hue in degrees, whiteness and blackness in `[0, 1]`.
  Hwb,
}

/// The way [`mix`] interpolates hue in a polar space: the arc it takes around the hue circle.
///
/// # Details
///
/// The values match the hue interpolation methods of CSS Color 4. They have no effect when the
/// interpolation space has no hue.
pub enum HueInterpolation {
  /// Takes the arc of at most 180 degrees, the CSS default.
  Shorter,
  /// Takes the arc of at least 180 degrees, the long way around.
  Longer,
  /// Moves toward increasing hue angles, wrapping from 360 to 0.
  Increasing,
  /// Moves toward decreasing hue angles, wrapping from 0 to 360.
  Decreasing,
}

/// The color space and hue method in which [`mix`] interpolates two colors.
///
/// # When to use
///
/// Use `Interpolation.new(ColorSpace.Oklab)` for even gradients without hue shifts, which is the
/// CSS default. Use `ColorSpace.Oklch` to keep colors saturated through the middle of a gradient,
/// and `ColorSpace.SrgbLinear` to match physical light mixing.
///
/// # Details
///
/// The fields are public. A hue method only affects polar spaces: `Lch`, `Oklch`, `Hsl`, and `Hwb`.
pub struct Interpolation {
  /// The color space in which components are interpolated, and the space of the result.
  pub space: ColorSpace,
  /// The arc taken around the hue circle in a polar space.
  pub hue: HueInterpolation,
}

impl Copy for Interpolation {}

impl Interpolation {
  /// Returns the interpolation in `space` with the shorter hue arc, the CSS default.
  pub fn new(space: ColorSpace) -> Interpolation {
    return Interpolation { space: space, hue: HueInterpolation.Shorter }
  }

  /// Returns the interpolation in `space` with the hue arc `hue`.
  pub fn withHue(space: ColorSpace, hue: HueInterpolation) -> Interpolation {
    return Interpolation { space: space, hue: hue }
  }
}

/// A color: three components in a [`ColorSpace`] and an alpha.
///
/// # When to use
///
/// Use `Color` to convert between color spaces, map wide-gamut colors to a display, interpolate
/// gradient stops, derive shades, and measure contrast. Use `silk.color.rgba.Rgba` for channels
/// that only need to be stored or uploaded.
///
/// # Details
///
/// The fields are public. Component ranges depend on `space`: RGB spaces use `[0, 1]`, `Lab` and
/// `Lch` lightness use `[0, 100]`, `Oklab` and `Oklch` lightness use `[0, 1]`, hues are in degrees,
/// and HSL and HWB percentages are fractions in `[0, 1]`. Alpha is in `[0, 1]` and straight, not
/// premultiplied.
///
/// A NaN component or alpha is missing, as CSS `none`: conversion reads it as zero and [`mix`]
/// takes the value from the other color. Conversion into a polar space marks the hue of an
/// achromatic color as missing.
///
/// # Gotchas
///
/// Two missing components are NaN and never compare equal with `==`. Compare colors with
/// [`approxEquals`].
pub struct Color {
  /// The color space that gives `components` their meaning.
  pub space: ColorSpace,
  /// The three components in the order CSS writes them for `space`. NaN marks a missing component.
  pub components: [f64; 3],
  /// The opacity in `[0, 1]`, straight rather than premultiplied. NaN marks a missing alpha.
  pub alpha: f64,
}

impl Copy for Color {}

impl Color {
  /// Returns the color with `components` in `space` and opacity `alpha`.
  ///
  /// # Details
  ///
  /// The values are stored as given. Pass `f64.NAN` for a component that CSS would write as `none`.
  pub fn new(space: ColorSpace, components: [f64; 3], alpha: f64) -> Color {
    return Color { space: space, components: components, alpha: alpha }
  }

  /// Returns the gamma-encoded sRGB color with red `r`, green `g`, blue `b`, and opacity `alpha`,
  /// each in `[0, 1]`.
  pub fn srgb(r: f64, g: f64, b: f64, alpha: f64) -> Color {
    return Color { space: ColorSpace.Srgb, components: [r, g, b], alpha: alpha }
  }

  /// Returns the linear-light sRGB color with red `r`, green `g`, blue `b`, and opacity `alpha`,
  /// each in `[0, 1]`.
  pub fn srgbLinear(r: f64, g: f64, b: f64, alpha: f64) -> Color {
    return Color { space: ColorSpace.SrgbLinear, components: [r, g, b], alpha: alpha }
  }

  /// Returns the Display P3 color with red `r`, green `g`, blue `b`, and opacity `alpha`, each in
  /// `[0, 1]`.
  pub fn displayP3(r: f64, g: f64, b: f64, alpha: f64) -> Color {
    return Color { space: ColorSpace.DisplayP3, components: [r, g, b], alpha: alpha }
  }

  /// Returns the HSL color with hue `h` in degrees, saturation `s` and lightness `l` in `[0, 1]`,
  /// and opacity `alpha`.
  ///
  /// # Gotchas
  ///
  /// Saturation and lightness are fractions: CSS `hsl(210 50% 40%)` is `Color.hsl(210.0, 0.5, 0.4,
  /// 1.0)`.
  pub fn hsl(h: f64, s: f64, l: f64, alpha: f64) -> Color {
    return Color { space: ColorSpace.Hsl, components: [h, s, l], alpha: alpha }
  }

  /// Returns the HWB color with hue `h` in degrees, whiteness `w` and blackness `b` in `[0, 1]`,
  /// and opacity `alpha`.
  ///
  /// # Details
  ///
  /// When `w + b` is at least `1`, the color is the gray `w / (w + b)` and the hue has no effect.
  pub fn hwb(h: f64, w: f64, b: f64, alpha: f64) -> Color {
    return Color { space: ColorSpace.Hwb, components: [h, w, b], alpha: alpha }
  }

  /// Returns the CIE Lab color with lightness `l` in `[0, 100]`, axes `a` and `b`, and opacity
  /// `alpha`.
  pub fn lab(l: f64, a: f64, b: f64, alpha: f64) -> Color {
    return Color { space: ColorSpace.Lab, components: [l, a, b], alpha: alpha }
  }

  /// Returns the CIE LCh color with lightness `l` in `[0, 100]`, chroma `c`, hue `h` in degrees,
  /// and opacity `alpha`.
  pub fn lch(l: f64, c: f64, h: f64, alpha: f64) -> Color {
    return Color { space: ColorSpace.Lch, components: [l, c, h], alpha: alpha }
  }

  /// Returns the Oklab color with lightness `l` in `[0, 1]`, axes `a` and `b`, and opacity `alpha`.
  pub fn oklab(l: f64, a: f64, b: f64, alpha: f64) -> Color {
    return Color { space: ColorSpace.Oklab, components: [l, a, b], alpha: alpha }
  }

  /// Returns the Oklch color with lightness `l` in `[0, 1]`, chroma `c`, hue `h` in degrees, and
  /// opacity `alpha`.
  ///
  /// # When to use
  ///
  /// Use Oklch to author palettes: equal steps in lightness look equally spaced, and changing hue
  /// keeps perceived lightness.
  pub fn oklch(l: f64, c: f64, h: f64, alpha: f64) -> Color {
    return Color { space: ColorSpace.Oklch, components: [l, c, h], alpha: alpha }
  }

  /// Returns the opaque sRGB color written in hex as `0xRRGGBB`.
  ///
  /// # When to use
  ///
  /// Use `fromHex` for colors copied from a design tool, such as `Color.fromHex(0x3366cc)`.
  ///
  /// # Gotchas
  ///
  /// Bits above the low 24 are ignored, so an `0xRRGGBBAA` value gives the wrong color. Use
  /// [`fromHexAlpha`] when the value has an alpha byte.
  pub fn fromHex(value: u32) -> Color {
    return Color.srgb(
      hexByte(u32.shiftRight(value, 16)),
      hexByte(u32.shiftRight(value, 8)),
      hexByte(value),
      1.0,
    )
  }

  /// Returns the sRGB color written in hex as `0xRRGGBBAA`, whose low byte is the opacity.
  pub fn fromHexAlpha(value: u32) -> Color {
    return Color.srgb(
      hexByte(u32.shiftRight(value, 24)),
      hexByte(u32.shiftRight(value, 16)),
      hexByte(u32.shiftRight(value, 8)),
      hexByte(value),
    )
  }

  /// Returns the sRGB color of a CSS hex color, or `None` when `text` is not one.
  ///
  /// # Details
  ///
  /// Accepts three, four, six, or eight hex digits after an optional `#`, in either case: `#rgb`,
  /// `#rgba`, `#rrggbb`, and `#rrggbbaa`. A short digit is repeated, so `#f80` is `#ff8800`.
  pub fn parseHex(text: string) -> Option<Color> {
    let bytes = String.utf8Bytes(text)
    let mut start: usize = 0
    if bytes.length > 0 && bytes[0] == 35 {
      start = 1
    }
    let count = bytes.length - start
    if count != 3 && count != 4 && count != 6 && count != 8 {
      return Option<Color>.none()
    }
    let mut digits: [u32; 8] = [0, 0, 0, 0, 0, 0, 0, 15]
    if count == 6 {
      digits[6] = 15
    }
    let mut i: usize = 0
    while i < count {
      let digit = hexDigit(bytes[start + i])
      if digit > 15 {
        return Option<Color>.none()
      }
      digits[i] = digit
      i = i + 1
    }
    let mut channels: [u32; 4] = [0, 0, 0, 255]
    let mut channel: usize = 0
    while channel < 4 {
      if count <= 4 {
        if channel < count {
          channels[channel] = digits[channel] * 17
        }
      } else if channel * 2 < count {
        channels[channel] = digits[channel * 2] * 16 + digits[channel * 2 + 1]
      }
      channel = channel + 1
    }
    return Option<Color>.some(
      Color.srgb(
        hexByte(channels[0]),
        hexByte(channels[1]),
        hexByte(channels[2]),
        hexByte(channels[3]),
      ),
    )
  }

  /// Returns the gamma-encoded sRGB color with the straight-alpha channels of `rgba`.
  pub fn fromRgba(rgba: Rgba<f64>) -> Color {
    return Color.srgb(rgba.r, rgba.g, rgba.b, rgba.a)
  }

  /// Returns the linear-light sRGB color with the straight-alpha channels of `rgba`.
  pub fn fromLinearRgba(rgba: Rgba<f64>) -> Color {
    return Color.srgbLinear(rgba.r, rgba.g, rgba.b, rgba.a)
  }

  /// Returns opaque sRGB black.
  pub fn black() -> Color {
    return Color.srgb(0.0, 0.0, 0.0, 1.0)
  }

  /// Returns opaque sRGB white.
  pub fn white() -> Color {
    return Color.srgb(1.0, 1.0, 1.0, 1.0)
  }

  /// Returns fully transparent sRGB black, the CSS `transparent` keyword.
  pub fn transparent() -> Color {
    return Color.srgb(0.0, 0.0, 0.0, 0.0)
  }

  /// Returns `true` when component `index`, from `0` to `2`, is missing (NaN).
  ///
  /// # Details
  ///
  /// A missing component is the CSS `none` value. Conversion into a polar space also marks the hue
  /// of an achromatic color as missing.
  pub fn isMissing(self: Self, index: usize) -> bool {
    return f64.isNaN(self.components[index])
  }

  /// Returns the color with the same space and components and opacity `alpha`.
  pub fn withAlpha(self: Self, alpha: f64) -> Color {
    return Color { space: self.space, components: self.components, alpha: alpha }
  }

  /// Returns the color converted to `space`, without gamut mapping.
  ///
  /// # Details
  ///
  /// Missing components read as zero, and alpha is copied, including a missing alpha. A conversion
  /// to the same space returns the color unchanged. A conversion into `Lch`, `Oklch`, `Hsl`, or
  /// `Hwb` marks the hue missing when the color is achromatic. The result can lie outside the gamut
  /// of `space`; use [`toGamut`] to bring it inside.
  ///
  /// Conversion among `Srgb`, `SrgbLinear`, `Hsl`, and `Hwb`, between `Lab` and `Lch`, and between
  /// `Oklab` and `Oklch` uses the direct formulas. Every other conversion goes through CIE XYZ
  /// (D65).
  pub fn to(self: Self, space: ColorSpace) -> Color {
    if self.space == space {
      return self
    }
    return Color {
      space: space,
      components: convert(self.space, space, resolved(self.components)),
      alpha: self.alpha,
    }
  }

  /// Returns `true` when the color lies inside the gamut of `space`, within `1e-9` per channel.
  ///
  /// # Details
  ///
  /// For an RGB space, every channel must be in `[0, 1]`. `Hsl` and `Hwb` use the sRGB gamut.
  /// `Lab`, `Lch`, `Oklab`, `Oklch`, `XyzD50`, and `XyzD65` hold every color, so the result is
  /// `true`.
  pub fn inGamut(self: Self, space: ColorSpace) -> bool {
    let rgb = gamutSpace(space)
    if !hasGamut(rgb) {
      return true
    }
    return rgbInGamut(self.to(rgb).components)
  }

  /// Returns the color converted to `space` and mapped into its gamut with the CSS Color 4
  /// algorithm.
  ///
  /// # When to use
  ///
  /// Use `toGamut` before displaying a color from a wider space, such as an Oklch value with high
  /// chroma or a Display P3 color on an sRGB screen.
  ///
  /// # Details
  ///
  /// A color already inside the gamut is converted exactly. Otherwise the algorithm keeps Oklch
  /// lightness and hue, and searches for the largest chroma whose clipped color is within a just
  /// noticeable difference (`deltaEOK` of `0.02`) of the unclipped one. Lightness of `1` or more
  /// maps to white and `0` or less to black. `Hsl` and `Hwb` map into the sRGB gamut. Spaces
  /// without a gamut (`Lab`, `Lch`, `Oklab`, `Oklch`, `XyzD50`, `XyzD65`) return the plain
  /// conversion. Alpha is copied unchanged.
  pub fn toGamut(self: Self, space: ColorSpace) -> Color {
    let rgb = gamutSpace(space)
    if !hasGamut(rgb) {
      return self.to(space)
    }
    let mapped = Color { space: rgb, components: gamutMap(self, rgb), alpha: self.alpha }
    return mapped.to(space)
  }

  /// Returns the straight-alpha gamma-encoded sRGB channels of the color, mapped into the sRGB
  /// gamut.
  ///
  /// # When to use
  ///
  /// Use `toRgba` to hand a color to a CSS-style renderer or to pack it into bytes. Use
  /// [`toLinearRgba`] for linear-light blending and GPU pipelines.
  ///
  /// # Details
  ///
  /// The color is mapped with the CSS Color 4 gamut-mapping algorithm, so every channel is in
  /// `[0, 1]`. A missing alpha becomes `1`, and alpha is clamped to `[0, 1]`.
  pub fn toRgba(self: Self) -> Rgba<f64> {
    let mapped = self.toGamut(ColorSpace.Srgb)
    return Rgba<f64> {
      r: mapped.components[0],
      g: mapped.components[1],
      b: mapped.components[2],
      a: displayAlpha(self.alpha),
    }
  }

  /// Returns the straight-alpha linear-light sRGB channels of the color, mapped into the sRGB
  /// gamut.
  ///
  /// # When to use
  ///
  /// Use `toLinearRgba` for physically based blending and for GPU pipelines that render to an sRGB
  /// surface format. Premultiply the result before compositing.
  ///
  /// # Details
  ///
  /// The color is mapped with the CSS Color 4 gamut-mapping algorithm, so every channel is in
  /// `[0, 1]`. A missing alpha becomes `1`, and alpha is clamped to `[0, 1]`.
  pub fn toLinearRgba(self: Self) -> Rgba<f64> {
    let mapped = self.toGamut(ColorSpace.SrgbLinear)
    return Rgba<f64> {
      r: mapped.components[0],
      g: mapped.components[1],
      b: mapped.components[2],
      a: displayAlpha(self.alpha),
    }
  }

  /// Returns the color `t` of the way from `self` to `other`, interpolated as CSS Color 4
  /// specifies.
  ///
  /// # When to use
  ///
  /// Use `mix` for gradient stops, transitions, and blends between theme colors. `t = 0.5` with
  /// `Interpolation.new(ColorSpace.Oklab)` is CSS `color-mix(in oklab, self, other)`.
  ///
  /// # Details
  ///
  /// The result is in `interpolation.space`. Both colors are converted to that space. A component
  /// missing in one color takes the other's value, including a missing component carried over from
  /// an analogous component of the original space, such as a missing hue or lightness. Components
  /// are premultiplied by alpha (except hue), interpolated linearly, and divided by the
  /// interpolated alpha. Hues follow `interpolation.hue`. `t` outside `[0, 1]` extrapolates.
  ///
  /// # Gotchas
  ///
  /// The result is not gamut mapped. Call [`toGamut`] or [`toRgba`] before display, because an
  /// interpolation in `Oklch` or `Lab` can leave the sRGB gamut.
  pub fn mix(self: Self, other: Color, t: f64, interpolation: Interpolation) -> Color {
    let space = interpolation.space
    let mut start = prepared(self, space)
    let mut end = prepared(other, space)
    let hueIndex = hueComponent(space)

    let mut i: usize = 0
    while i < 3 {
      let first = start.components[i]
      start.components[i] = filled(first, end.components[i])
      end.components[i] = filled(end.components[i], first)
      i = i + 1
    }
    let startAlpha = filled(start.alpha, end.alpha)
    let endAlpha = filled(end.alpha, start.alpha)

    // Components are premultiplied by alpha; a missing alpha in both colors counts as opaque.
    let premultiplyStart = filled(startAlpha, 1.0)
    let premultiplyEnd = filled(endAlpha, 1.0)

    if hueIndex < 3 && !f64.isNaN(start.components[hueIndex])
      && !f64.isNaN(end.components[hueIndex]) {
      let hues = fixupHues(start.components[hueIndex], end.components[hueIndex], interpolation.hue)
      start.components[hueIndex] = hues[0]
      end.components[hueIndex] = hues[1]
    }

    let alpha = startAlpha + (endAlpha - startAlpha) * t
    let divisor = premultiplyStart + (premultiplyEnd - premultiplyStart) * t
    let mut result = [0.0; 3]
    let mut j: usize = 0
    while j < 3 {
      let a = start.components[j]
      let b = end.components[j]
      if j == hueIndex {
        result[j] = normalizeHue(a + (b - a) * t)
      } else {
        let value = a * premultiplyStart + (b * premultiplyEnd - a * premultiplyStart) * t
        result[j] = if divisor == 0.0 {
          value
        } else {
          value / divisor
        }
      }
      j = j + 1
    }
    return Color { space: space, components: result, alpha: alpha }
  }

  /// Returns the color with Oklch lightness raised by `amount`, in the color's own space.
  ///
  /// # When to use
  ///
  /// Use `lighten` for hover states and lighter palette steps. Because Oklch lightness is
  /// perceptual, the same `amount` looks like the same step for every hue.
  ///
  /// # Details
  ///
  /// The color is converted to Oklch, lightness becomes `l + amount` clamped to `[0, 1]`, and the
  /// result is converted back to the original space. Chroma and hue are unchanged, so a light,
  /// saturated result can leave the gamut of an RGB space; call [`toGamut`] before display.
  pub fn lighten(self: Self, amount: f64) -> Color {
    let mut values = self.to(ColorSpace.Oklch)
    values.components[0] = clamp(resolvedValue(values.components[0]) + amount, 0.0, 1.0)
    return values.to(self.space)
  }

  /// Returns the color with Oklch lightness lowered by `amount`, in the color's own space.
  ///
  /// # When to use
  ///
  /// Use `darken` for pressed states and darker palette steps.
  ///
  /// # Details
  ///
  /// The color is converted to Oklch, lightness becomes `l - amount` clamped to `[0, 1]`, and the
  /// result is converted back to the original space. Chroma and hue are unchanged; call [`toGamut`]
  /// before display.
  pub fn darken(self: Self, amount: f64) -> Color {
    return self.lighten(-amount)
  }

  /// Returns the color with Oklch chroma raised by `amount`, in the color's own space.
  ///
  /// # Details
  ///
  /// The color is converted to Oklch, chroma becomes `c + amount` with a floor of zero, and the
  /// result is converted back. Oklch chroma of saturated sRGB colors is about `0.1` to `0.32`, so
  /// useful amounts are small, such as `0.02`. An achromatic color has no hue, so it gains chroma
  /// toward a hue of zero (pink). The result can leave the gamut of an RGB space; call [`toGamut`]
  /// before display.
  pub fn saturate(self: Self, amount: f64) -> Color {
    let mut values = self.to(ColorSpace.Oklch)
    values.components[1] = f64.max(resolvedValue(values.components[1]) + amount, 0.0)
    return values.to(self.space)
  }

  /// Returns the color with Oklch chroma lowered by `amount`, with a floor of zero, in the color's
  /// own space.
  ///
  /// # Details
  ///
  /// The color is converted to Oklch, chroma becomes `max(c - amount, 0)`, and the result is
  /// converted back. Lightness and hue are unchanged.
  pub fn desaturate(self: Self, amount: f64) -> Color {
    return self.saturate(-amount)
  }

  /// Returns the color with its Oklch hue turned by `degrees`, in the color's own space.
  ///
  /// # Details
  ///
  /// The color is converted to Oklch, the hue becomes `h + degrees` wrapped into `[0, 360)`, and
  /// the result is converted back. An achromatic color is returned unchanged in value. Rotating by
  /// `180` gives the complementary color at the same lightness and chroma, which can leave the
  /// gamut of an RGB space.
  pub fn rotateHue(self: Self, degrees: f64) -> Color {
    let mut values = self.to(ColorSpace.Oklch)
    if !f64.isNaN(values.components[2]) {
      values.components[2] = normalizeHue(values.components[2] + degrees)
    }
    return values.to(self.space)
  }

  /// Returns the gray with the same Oklch lightness, in the color's own space.
  ///
  /// # Details
  ///
  /// Oklch chroma becomes zero, so the result has the perceived lightness of the original. In a
  /// polar space the hue of the result is missing.
  pub fn grayscale(self: Self) -> Color {
    let mut values = self.to(ColorSpace.Oklch)
    values.components[1] = 0.0
    values.components[2] = f64.NAN
    return values.to(self.space)
  }

  /// Returns the sRGB negative of the color, in the color's own space.
  ///
  /// # Details
  ///
  /// The color is mapped into the sRGB gamut, each gamma-encoded channel becomes `1 - channel`, and
  /// the result is converted back. Alpha is unchanged. This matches the CSS `invert(1)` filter.
  pub fn invert(self: Self) -> Color {
    let rgb = self.toGamut(ColorSpace.Srgb)
    let inverted = Color {
      space: ColorSpace.Srgb,
      components: [1.0 - rgb.components[0], 1.0 - rgb.components[1], 1.0 - rgb.components[2]],
      alpha: self.alpha,
    }
    return inverted.to(self.space)
  }

  /// Returns the WCAG 2 relative luminance of the color, from `0` for black to `1` for white.
  ///
  /// # Details
  ///
  /// The color is mapped into the sRGB gamut, decoded to linear light, and weighted by
  /// `0.2126 R + 0.7152 G + 0.0722 B`. Alpha is ignored; composite a translucent color over its
  /// background first.
  pub fn relativeLuminance(self: Self) -> f64 {
    let rgb = self.toGamut(ColorSpace.SrgbLinear).components
    return 0.2126 * rgb[0] + 0.7152 * rgb[1] + 0.0722 * rgb[2]
  }

  /// Returns the WCAG 2 contrast ratio between the two colors, from `1` for equal luminance to `21`
  /// for black on white.
  ///
  /// # When to use
  ///
  /// Use `contrastRatio` to check text legibility. WCAG AA asks for at least `4.5` for body text
  /// and `3` for large text and interface components; AAA asks for `7` and `4.5`.
  ///
  /// # Details
  ///
  /// The ratio is `(lighter + 0.05) / (darker + 0.05)` of the two relative luminances, so the order
  /// of the colors does not matter. Alpha is ignored; composite translucent colors first.
  pub fn contrastRatio(self: Self, other: Color) -> f64 {
    let a = self.relativeLuminance()
    let b = other.relativeLuminance()
    let lighter = f64.max(a, b)
    let darker = f64.min(a, b)
    return (lighter + 0.05) / (darker + 0.05)
  }

  /// Returns the CSS Color 4 `deltaEOK` difference: the Euclidean distance between the two colors
  /// in Oklab.
  ///
  /// # When to use
  ///
  /// Use `deltaEOK` to ask whether two colors look the same. A value below `0.02` is about one just
  /// noticeable difference.
  ///
  /// # Details
  ///
  /// Missing components read as zero. Alpha is ignored.
  pub fn deltaEOK(self: Self, other: Color) -> f64 {
    let a = self.to(ColorSpace.Oklab).components
    let b = other.to(ColorSpace.Oklab).components
    return distance(resolved(a), resolved(b))
  }

  /// Returns `true` when both colors are in the same space and every component and alpha differ by
  /// at most `tolerance`.
  ///
  /// # Details
  ///
  /// Two missing components compare equal, and a missing component never equals a present one. Hues
  /// compare around the circle, so `359.9` and `0.1` differ by `0.2`. Colors in different spaces
  /// are never equal; convert one with [`to`] first.
  pub fn approxEquals(self: Self, other: Color, tolerance: f64) -> bool {
    if self.space != other.space {
      return false
    }
    let hueIndex = hueComponent(self.space)
    let mut i: usize = 0
    while i < 3 {
      if !close(self.components[i], other.components[i], tolerance, i == hueIndex) {
        return false
      }
      i = i + 1
    }
    return close(self.alpha, other.alpha, tolerance, false)
  }
}

