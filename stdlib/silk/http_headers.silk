//! An ordered list of HTTP header fields, with lookup by name, copies, and formatting.
//!
//! # When to use
//! Use [`Headers.make`] to put `Header` values from `silk.http` in a list without a copy. Use
//! [`Headers.copy`] when the list must live longer than its fields. Look up fields with
//! [`Headers.getFirst`], [`Headers.getUnique`], or [`Headers.getAll`].
//!
//! # Details
//! Names are compared without case. Repeated fields stay separate, in their order, and are never
//! joined into one value. [`Limits`] sets the maximum sizes, and every function checks them before
//! it allocates. [`Headers.formatInto`] writes `name: value\r\n` for each field.
//!
//! # Errors
//! - `ValueError` with `LimitExceeded` if a list exceeds its [`Limits`].
//! - `ValueError` with `OutputTooSmall` if the output buffer is too small. Nothing is written.
//!
//! # Examples
//! ## Look up repeated fields
//! ```silk
//! import silk.http { Header, ValueError }
//! import silk.http_headers { HeaderIterator, Headers, Limits }
//! import silk.option { Option }
//! import silk.result { Result }
//!
//! fn limits() -> Limits {
//!   return Limits {
//!     maxMethodBytes: 64,
//!     maxTargetBytes: 8192,
//!     maxNameBytes: 256,
//!     maxValueBytes: 8192,
//!     maxFields: 16,
//!     maxFieldBytes: 4096,
//!     maxOwnedBytes: 8192,
//!   }
//! }
//!
//! fn field(name: string<'static>, bytes: &'static [u8]) -> Header<'static> {
//!   return match Header.make(name, bytes, limits()) {
//!     Result<Header, ValueError>.Success { value } => value
//!     Result<Header, ValueError>.Failure { error: _ } => {
//!       Intrinsic.trap("unexpected failure")
//!       return field(name, bytes)
//!     }
//!   }
//! }
//!
//! pub fn main() -> i32 {
//!   let entries = [field("Accept", b"text/html"), field("Vary", b"Accept"), field("ACCEPT", b"*/*")]
//!   let headers = match Headers.make(&entries, limits()) {
//!     Result<Headers, ValueError>.Success { value } => value
//!     Result<Headers, ValueError>.Failure { error: _ } => {
//!       return 1
//!     }
//!   }
//!
//!   // Both Accept fields match, in their order.
//!   let mut accept = Headers.getAll(&headers, "accept")
//!   let mut count = 0
//!   while true {
//!     match HeaderIterator.next(&mut accept) {
//!       Option<Header>.Some { value: _ } => {
//!         count = count + 1
//!       }
//!       Option<Header>.None => {
//!         break
//!       }
//!     }
//!   }
//!   if count != 2 {
//!     return 1
//!   }
//!
//!   // getUnique fails, because Accept occurs two times.
//!   let unique = match Headers.getUnique(&headers, "Accept") {
//!     Result<Option<Header>, ValueError>.Success { value: _ } => true
//!     Result<Option<Header>, ValueError>.Failure { error: _ } => false
//!   }
//!   if unique {
//!     return 1
//!   }
//!   let mut output: [u8; 64] = [0; 64]
//!   let length = match Headers.formatInto(&headers, &mut output) {
//!     Result<usize, ValueError>.Success { value } => value
//!     Result<usize, ValueError>.Failure { error: _ } => {
//!       return 1
//!     }
//!   }
//!
//!   // "Accept: text/html\r\nVary: Accept\r\nACCEPT: */*\r\n"
//!   if length != 46 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category HTTP

import silk.allocator { Allocator, OutOfMemoryError }
import silk.bytes { Bytes }
import silk.http {
  Header,
  LimitKind,
  ValueComponent,
  ValueError,
  ValueReason,
}
import silk.layout { Layout }
import silk.option { Option }
import silk.ownership { Copy }
import silk.result { Result }
import silk.slice { Slice }
import silk.string { String }
import silk.u8
import silk.usize
import silk.list { List }

/// Maximum sizes for HTTP values, header lists, and copies. Every `Headers` function checks them
/// before it allocates.
pub struct Limits {
  /// The maximum length of a method, in bytes.
  pub maxMethodBytes: usize,
  /// The maximum length of a request target, in bytes.
  pub maxTargetBytes: usize,
  /// The maximum length of a field name, in bytes.
  pub maxNameBytes: usize,
  /// The maximum length of a field value or a reason phrase, in bytes.
  pub maxValueBytes: usize,
  /// The maximum number of fields in a list.
  pub maxFields: usize,
  /// The maximum total length of all names and values in a list, in bytes.
  pub maxFieldBytes: usize,
  /// The maximum memory for a copy, in bytes, including its index. See
  /// [`Headers.requiredOwnedBytes`].
  pub maxOwnedBytes: usize,
}

impl Copy for Limits {}

fn failure(reason: ValueReason, component: ValueComponent, offset: usize) -> ValueError {
  return ValueError {
    reason: reason,
    component: component,
    fieldIndex: Option<usize>.none(),
    offset: offset,
  }
}

fn indexedFailure(
  reason: ValueReason,
  component: ValueComponent,
  fieldIndex: usize,
  offset: usize,
) -> ValueError {
  return ValueError {
    reason: reason,
    component: component,
    fieldIndex: Option<usize>.some(fieldIndex),
    offset: offset,
  }
}

fn limitFailure(
  component: ValueComponent,
  limit: LimitKind,
  allowed: usize,
  attempted: usize,
) -> ValueError {
  return failure(
    ValueReason.LimitExceeded { limit: limit, allowed: allowed, attempted: attempted },
    component,
    attempted,
  )
}

fn outputFailure(component: ValueComponent, required: usize, available: usize) -> ValueError {
  return failure(
    ValueReason.OutputTooSmall { required: required, available: available },
    component,
    available,
  )
}

fn sizeFailure(component: ValueComponent) -> ValueError {
  return failure(ValueReason.SizeOverflow, component, usize.MAX)
}

fn tokenByte(value: u8) -> bool {
  if value >= 65 && value <= 90 { return true }
  if value >= 97 && value <= 122 { return true }
  if value >= 48 && value <= 57 { return true }
  return value == 33 || value == 35 || value == 36 || value == 37 || value == 38
    || value == 39 || value == 42 || value == 43 || value == 45 || value == 46
    || value == 94 || value == 95 || value == 96 || value == 124 || value == 126
}

fn asciiEqual(left: string, right: string) -> bool {
  let leftBytes = String.utf8Bytes(left)
  let rightBytes = String.utf8Bytes(right)
  if leftBytes.length != rightBytes.length { return false }
  let mut index = usize.ZERO
  while index < leftBytes.length {
    if asciiLower(leftBytes[index]) != asciiLower(rightBytes[index]) { return false }
    index = index + usize.ONE
  }
  return true
}

fn asciiLower(value: u8) -> u8 {
  if value >= 65 && value <= 90 { return value + 32 }
  return value
}

struct HeaderRecord {
  nameStart: usize,
  nameLength: usize,
  valueStart: usize,
  valueLength: usize,
}

impl Copy for HeaderRecord {}

union HeaderStorage<'value> {
  Borrowed { entries: &'value [Header<'value>] },
  Packed { bytes: &'value [u8], records: &'value [HeaderRecord] },
}

impl<'value> Copy for HeaderStorage<'value> {}

/// An ordered list of header fields that borrows its fields.
///
/// # When to use
///
/// Use [`Headers.make`] to put `Header` values from `silk.http` in a list without a copy. Use
/// [`Headers.copy`] when the list must live longer than its fields. Look up fields with
/// [`Headers.getFirst`], [`Headers.getUnique`], or [`Headers.getAll`].
///
/// # Details
///
/// Names are compared without case. Repeated fields stay separate, in their order, and are never
/// joined into one value. Every function checks the [`Limits`] before it allocates.
pub struct Headers<'value> {
  storage: HeaderStorage<'value>,
  countValue: usize,
  fieldBytesValue: usize,
}

impl<'value> Copy for Headers<'value> {}

impl<'value> Headers<'value> {
  /// Checks `entries` against `limits` and returns a list that borrows them. It does not allocate.
  pub fn make(
    entries: &'value [Header<'value>],
    limits: Limits,
  ) -> Result<Headers<'value>, ValueError> {
    if entries.length > limits.maxFields {
      return Result<Headers<'value>, ValueError>.failResult(limitFailure(
        ValueComponent.Headers,
        LimitKind.Fields,
        limits.maxFields,
        entries.length,
      ))
    }
    let mut total = usize.ZERO
    let mut index = usize.ZERO
    while index < entries.length {
      let header = entries[index]
      let nameLength = String.byteLength(Header.name(&header))
      let valueLength = Header.value(&header).length
      if nameLength > limits.maxNameBytes {
        return Result<Headers<'value>, ValueError>.failResult(indexedLimitFailure(
          ValueComponent.HeaderName,
          LimitKind.NameBytes,
          limits.maxNameBytes,
          nameLength,
          index,
        ))
      }
      if valueLength > limits.maxValueBytes {
        return Result<Headers<'value>, ValueError>.failResult(indexedLimitFailure(
          ValueComponent.HeaderValue,
          LimitKind.ValueBytes,
          limits.maxValueBytes,
          valueLength,
          index,
        ))
      }
      let fieldSize = match move checkedAdd(nameLength, valueLength, ValueComponent.Headers) {
        Result<usize, ValueError>.Failure { error } => {
          return Result<Headers<'value>, ValueError>.failResult(move error)
        }
        Result<usize, ValueError>.Success { value } => value
      }
      total = match move checkedAdd(total, fieldSize, ValueComponent.Headers) {
        Result<usize, ValueError>.Failure { error } => {
          return Result<Headers<'value>, ValueError>.failResult(move error)
        }
        Result<usize, ValueError>.Success { value } => value
      }
      if total > limits.maxFieldBytes {
        return Result<Headers<'value>, ValueError>.failResult(indexedLimitFailure(
          ValueComponent.Headers,
          LimitKind.FieldBytes,
          limits.maxFieldBytes,
          total,
          index,
        ))
      }
      index = index + usize.ONE
    }
    return Result<Headers<'value>, ValueError>.succeed(Headers<'value> {
      storage: HeaderStorage<'value>.Borrowed { entries: entries },
      countValue: entries.length,
      fieldBytesValue: total,
    })
  }

  /// Returns the number of fields, including repeated fields.
  pub fn count(self: &Self) -> usize { return self.countValue }

  /// Returns the total length of all names and values, in bytes.
  pub fn fieldBytes(self: &Self) -> usize { return self.fieldBytesValue }

  /// Returns an iterator over all fields, in order.
  pub fn iter(self: &Self) -> HeaderIterator<'value> {
    return HeaderIterator<'value> {
      headers: Headers<'value> {
        storage: self.storage,
        countValue: self.countValue,
        fieldBytesValue: self.fieldBytesValue,
      },
      filter: Option<string<'value>>.none(),
      index: usize.ZERO,
      sourceIndex: usize.MAX,
    }
  }

  /// Returns an iterator over the fields named `name`, compared without case, in order.
  pub fn getAll(self: &Self, name: string<'value>) -> HeaderIterator<'value> {
    return HeaderIterator<'value> {
      headers: Headers<'value> {
        storage: self.storage,
        countValue: self.countValue,
        fieldBytesValue: self.fieldBytesValue,
      },
      filter: Option<string<'value>>.some(name),
      index: usize.ZERO,
      sourceIndex: usize.MAX,
    }
  }

  /// Returns the first field named `name`, compared without case, or `None`.
  pub fn getFirst(self: &Self, name: string) -> Option<Header<'value>> {
    let mut index = usize.ZERO
    while index < self.countValue {
      let value = entryAt(self, index)
      if asciiEqual(Header.name(&value), name) { return Option<Header<'value>>.some(value) }
      index = index + usize.ONE
    }
    return Option<Header<'value>>.none()
  }

  /// Returns the field named `name`, or `None` if there is no such field.
  ///
  /// # Errors
  /// - `LimitExceeded` with `UniqueField` if there is more than one such field.
  pub fn getUnique(self: &Self, name: string) -> Result<Option<Header<'value>>, ValueError> {
    let mut found = Option<Header<'value>>.none()
    let mut count = usize.ZERO
    let mut index = usize.ZERO
    while index < self.countValue {
      let value = entryAt(self, index)
      if asciiEqual(Header.name(&value), name) {
        count = count + usize.ONE
        if count > usize.ONE {
          return Result<Option<Header<'value>>, ValueError>.failResult(indexedFailure(
            ValueReason.LimitExceeded {
              limit: LimitKind.UniqueField,
              allowed: usize.ONE,
              attempted: count,
            },
            ValueComponent.Headers,
            index,
            usize.ZERO,
          ))
        }
        found = Option<Header<'value>>.some(value)
      }
      index = index + usize.ONE
    }
    return Result<Option<Header<'value>>, ValueError>.succeed(move found)
  }

  /// Copies all fields into new memory, so that the copy does not borrow them.
  ///
  /// # Errors
  /// - `LimitExceeded` if the list exceeds `limits`. Nothing is allocated.
  /// - `OutOfMemoryError` if the `Allocator` fails.
  pub effect fn copy(
    self: &Self,
    limits: Limits,
  ) -> Result<OwnedHeaders, ValueError> ! OutOfMemoryError ? &mut Allocator {
    let validated = validateExisting(self, limits)
    match move validated {
      Result<(), ValueError>.Failure { error } => {
        return Result<OwnedHeaders, ValueError>.failResult(move error)
      }
      Result<(), ValueError>.Success { value } => {}
    }
    let recordLayout = Layout.of<HeaderRecord>()
    let recordBytes = match move usize.checkedMultiply(recordLayout.bytes, self.countValue) {
      Option<usize>.None => {
        return Result<OwnedHeaders, ValueError>.failResult(sizeFailure(ValueComponent.Headers))
      }
      Option<usize>.Some { value } => value
    }
    let ownedBytes = match move checkedAdd(
      self.fieldBytesValue,
      recordBytes,
      ValueComponent.Headers,
    ) {
      Result<usize, ValueError>.Failure { error } => {
        return Result<OwnedHeaders, ValueError>.failResult(move error)
      }
      Result<usize, ValueError>.Success { value } => value
    }
    if ownedBytes > limits.maxOwnedBytes {
      return Result<OwnedHeaders, ValueError>.failResult(limitFailure(
        ValueComponent.Headers,
        LimitKind.OwnedBytes,
        limits.maxOwnedBytes,
        ownedBytes,
      ))
    }
    let mut payload = Bytes.make()
    let reservedPayload = run Bytes.reserveExact(&mut payload, self.fieldBytesValue)
    let mut records = List<HeaderRecord>.make()
    let reservedRecords = run List<HeaderRecord>.reserveExact(&mut records, self.countValue)
    let mut index = usize.ZERO
    while index < self.countValue {
      let header = entryAt(self, index)
      let name = String.utf8Bytes(Header.name(&header))
      let value = Header.value(&header)
      let nameStart = Bytes.length(&payload)
      let wroteName = run Bytes.append(&mut payload, name)
      let valueStart = Bytes.length(&payload)
      let wroteValue = run Bytes.append(&mut payload, value)
      let wroteRecord = run List<HeaderRecord>.append(&mut records, HeaderRecord {
        nameStart: nameStart,
        nameLength: name.length,
        valueStart: valueStart,
        valueLength: value.length,
      })
      index = index + usize.ONE
    }
    return Result<OwnedHeaders, ValueError>.succeed(OwnedHeaders {
      payload: move payload,
      records: move records,
      fieldBytesValue: self.fieldBytesValue,
      ownedBytesValue: ownedBytes,
    })
  }

  /// Copies only the fields named `name`, compared without case, into new memory.
  ///
  /// # Details
  /// Repeated fields stay separate, in their order. `limits` applies to the copied fields only, and
  /// is checked before allocation.
  pub effect fn copyMatching(
    self: &Self,
    name: string<'value>,
    limits: Limits,
  ) -> Result<OwnedHeaders, ValueError> ! OutOfMemoryError ? &mut Allocator {
    let mut count = usize.ZERO
    let mut fieldBytes = usize.ZERO
    let mut iterator = Headers.getAll(self, name)
    while true {
      let next = HeaderIterator.next(&mut iterator)
      match move next {
        Option.None => { break }
        Option.Some {value} => {
          count = match move usize.checkedAdd(count, usize.ONE) {
            Option.None => {
              return Result<OwnedHeaders, ValueError>.failResult(sizeFailure(ValueComponent.Headers))
            }
            Option.Some {value: selected} => selected
          }
          if count > limits.maxFields {
            return Result<OwnedHeaders, ValueError>.failResult(limitFailure(
              ValueComponent.Headers,
              LimitKind.Fields,
              limits.maxFields,
              count,
            ))
          }
          let nameLength = String.byteLength(Header.name(&value))
          let valueLength = Header.value(&value).length
          if nameLength > limits.maxNameBytes {
            return Result<OwnedHeaders, ValueError>.failResult(limitFailure(
              ValueComponent.HeaderName,
              LimitKind.NameBytes,
              limits.maxNameBytes,
              nameLength,
            ))
          }
          if valueLength > limits.maxValueBytes {
            return Result<OwnedHeaders, ValueError>.failResult(limitFailure(
              ValueComponent.HeaderValue,
              LimitKind.ValueBytes,
              limits.maxValueBytes,
              valueLength,
            ))
          }
          let selectedBytes = match move checkedAdd(nameLength, valueLength, ValueComponent.Headers) {
            Result.Failure {error} => {
              return Result<OwnedHeaders, ValueError>.failResult(move error)
            }
            Result.Success {value: size} => size
          }
          fieldBytes = match move checkedAdd(fieldBytes, selectedBytes, ValueComponent.Headers) {
            Result.Failure {error} => {
              return Result<OwnedHeaders, ValueError>.failResult(move error)
            }
            Result.Success {value: size} => size
          }
          if fieldBytes > limits.maxFieldBytes {
            return Result<OwnedHeaders, ValueError>.failResult(limitFailure(
              ValueComponent.Headers,
              LimitKind.FieldBytes,
              limits.maxFieldBytes,
              fieldBytes,
            ))
          }
        }
      }
    }
    let recordBytes = match move usize.checkedMultiply(Layout.of<HeaderRecord>().bytes, count) {
      Option.None => {
        return Result<OwnedHeaders, ValueError>.failResult(sizeFailure(ValueComponent.Headers))
      }
      Option.Some {value} => value
    }
    let ownedBytes = match move checkedAdd(fieldBytes, recordBytes, ValueComponent.Headers) {
      Result.Failure {error} => {
        return Result<OwnedHeaders, ValueError>.failResult(move error)
      }
      Result.Success {value} => value
    }
    if ownedBytes > limits.maxOwnedBytes {
      return Result<OwnedHeaders, ValueError>.failResult(limitFailure(
        ValueComponent.Headers,
        LimitKind.OwnedBytes,
        limits.maxOwnedBytes,
        ownedBytes,
      ))
    }
    let mut payload = Bytes.make()
    let reservedPayload = run Bytes.reserveExact(&mut payload, fieldBytes)
    let mut records = List<HeaderRecord>.make()
    let reservedRecords = run List<HeaderRecord>.reserveExact(&mut records, count)
    iterator = Headers.getAll(self, name)
    while true {
      let next = HeaderIterator.next(&mut iterator)
      match move next {
        Option.None => { break }
        Option.Some {value} => {
          let selectedName = String.utf8Bytes(Header.name(&value))
          let selectedValue = Header.value(&value)
          let nameStart = Bytes.length(&payload)
          let wroteName = run Bytes.append(&mut payload, selectedName)
          let valueStart = Bytes.length(&payload)
          let wroteValue = run Bytes.append(&mut payload, selectedValue)
          let wroteRecord = run List<HeaderRecord>.append(&mut records, HeaderRecord {
            nameStart: nameStart,
            nameLength: selectedName.length,
            valueStart: valueStart,
            valueLength: selectedValue.length,
          })
        }
      }
    }
    return Result<OwnedHeaders, ValueError>.succeed(OwnedHeaders {
      payload: move payload,
      records: move records,
      fieldBytesValue: fieldBytes,
      ownedBytesValue: ownedBytes,
    })
  }

  /// Returns the memory that [`Headers.copy`] needs, to compare with `maxOwnedBytes`. It does not
  /// allocate.
  pub fn requiredOwnedBytes(self: &Self) -> Result<usize, ValueError> {
    let recordLayout = Layout.of<HeaderRecord>()
    let recordBytes = match move usize.checkedMultiply(recordLayout.bytes, self.countValue) {
      Option<usize>.None => {
        return Result<usize, ValueError>.failResult(sizeFailure(ValueComponent.Headers))
      }
      Option<usize>.Some {value} => value
    }
    return checkedAdd(self.fieldBytesValue, recordBytes, ValueComponent.Headers)
  }

  /// Writes `name: value\r\n` for each field to the start of `output`, and returns the length. It
  /// writes no start line and no empty line at the end.
  pub fn formatInto(self: &Self, output: &mut [u8]) -> Result<usize, ValueError> {
    let mut required = usize.ZERO
    let mut index = usize.ZERO
    while index < self.countValue {
      let header = entryAt(self, index)
      let nameLength = String.byteLength(Header.name(&header))
      let withName = match move checkedAdd(required, nameLength, ValueComponent.Headers) {
        Result<usize, ValueError>.Failure { error } => {
          return Result<usize, ValueError>.failResult(move error)
        }
        Result<usize, ValueError>.Success { value } => value
      }
      let withSyntax = match move checkedAdd(withName, 4, ValueComponent.Headers) {
        Result<usize, ValueError>.Failure { error } => {
          return Result<usize, ValueError>.failResult(move error)
        }
        Result<usize, ValueError>.Success { value } => value
      }
      required = match move checkedAdd(
        withSyntax,
        Header.value(&header).length,
        ValueComponent.Headers,
      ) {
        Result<usize, ValueError>.Failure { error } => {
          return Result<usize, ValueError>.failResult(move error)
        }
        Result<usize, ValueError>.Success { value } => value
      }
      index = index + usize.ONE
    }
    if output.length < required {
      return Result<usize, ValueError>.failResult(outputFailure(
        ValueComponent.Headers,
        required,
        output.length,
      ))
    }
    let mut cursor = usize.ZERO
    index = usize.ZERO
    while index < self.countValue {
      let header = entryAt(self, index)
      let name = String.utf8Bytes(Header.name(&header))
      cursor = copyBytes(&mut output, cursor, name)
      output[cursor] = 58
      output[cursor + usize.ONE] = 32
      cursor = cursor + 2
      cursor = copyBytes(&mut output, cursor, Header.value(&header))
      output[cursor] = 13
      output[cursor + usize.ONE] = 10
      cursor = cursor + 2
      index = index + usize.ONE
    }
    return Result<usize, ValueError>.succeed(cursor)
  }

  /// Returns an iterator over the options in all `Connection` fields, such as `close` or
  /// `keep-alive`.
  pub fn connectionTokens(self: &Self) -> MetadataIterator<'value> {
    return metadata(self, MetadataKind.Connection)
  }

  /// Returns an iterator over the codings in all `Content-Encoding` fields, such as `gzip`.
  pub fn contentCodings(self: &Self) -> MetadataIterator<'value> {
    return metadata(self, MetadataKind.ContentEncoding)
  }

  /// Returns an iterator over the codings in all `Transfer-Encoding` fields, such as `chunked`. It
  /// also checks the parameters of each coding.
  pub fn transferCodings(self: &Self) -> MetadataIterator<'value> {
    return metadata(self, MetadataKind.TransferEncoding)
  }
}

/// A header list that owns its memory. Get a [`Headers`] from it with [`OwnedHeaders.view`].
pub struct OwnedHeaders {
  payload: Bytes,
  records: List<HeaderRecord>,
  fieldBytesValue: usize,
  ownedBytesValue: usize,
}

impl OwnedHeaders {
  /// Returns the fields as a [`Headers`] that borrows this value.
  pub fn view<'value>(self: &'value Self) -> Headers<'value> {
    return Headers<'value> {
      storage: HeaderStorage<'value>.Packed {
        bytes: Bytes.asSlice(&self.payload),
        records: List<HeaderRecord>.asSlice(&self.records),
      },
      countValue: List<HeaderRecord>.length(&self.records),
      fieldBytesValue: self.fieldBytesValue,
    }
  }

  /// Returns the memory that this copy uses, in bytes, as counted against `maxOwnedBytes`.
  pub fn ownedBytes(self: &Self) -> usize { return self.ownedBytesValue }
}

/// An iterator over header fields, in order. Get it from [`Headers.iter`] or [`Headers.getAll`].
pub struct HeaderIterator<'value> {
  headers: Headers<'value>,
  filter: Option<string<'value>>,
  index: usize,
  sourceIndex: usize,
}

impl<'value> HeaderIterator<'value> {
  /// Returns the next field, or `None` at the end.
  pub fn next(self: &mut Self) -> Option<Header<'value>> {
    while self.index < self.headers.countValue {
      let index = self.index
      self.index = self.index + usize.ONE
      let header = entryAt(&self.headers, index)
      match & self.filter {
        Option<string<'value>>.None => {
          self.sourceIndex = index
          return Option<Header<'value>>.some(header)
        }
        Option<string<'value>>.Some { value } => {
          if asciiEqual(Header.name(&header), value) {
            self.sourceIndex = index
            return Option<Header<'value>>.some(header)
          }
        }
      }
    }
    return Option<Header<'value>>.none()
  }

  /// Returns the position in the list of the last field from [`HeaderIterator.next`], from 0.
  pub fn fieldIndex(self: &Self) -> usize { return self.sourceIndex }
}

enum MetadataKind { Connection, ContentEncoding, TransferEncoding }

/// One item of a list field, such as `gzip` in `Content-Encoding: gzip, br`.
pub struct MetadataToken<'value> {
  tokenBytes: &'value [u8],
  rawBytes: &'value [u8],
  sourceField: usize,
  sourceOffset: usize,
}

impl<'value> Copy for MetadataToken<'value> {}

impl<'value> MetadataToken<'value> {
  /// Returns the name of the item, without parameters.
  pub fn token(self: &Self) -> &'value [u8] { return self.tokenBytes }
  /// Returns the whole item, with its parameters.
  pub fn raw(self: &Self) -> &'value [u8] { return self.rawBytes }
  /// Returns the position in the list of the field that holds this item, from 0.
  pub fn fieldIndex(self: &Self) -> usize { return self.sourceField }
  /// Returns the byte offset of the item in the field value.
  pub fn offset(self: &Self) -> usize { return self.sourceOffset }
  /// Returns `true` if the name of the item equals `known`, compared without case.
  pub fn matches(self: &Self, known: string) -> bool {
    return bytesAsciiEqual(self.tokenBytes, String.utf8Bytes(known))
  }
}

/// An iterator over the items of list fields, such as `Connection` or `Content-Encoding`.
pub struct MetadataIterator<'value> {
  headers: Headers<'value>,
  kind: MetadataKind,
  fieldIndex: usize,
  valueOffset: usize,
}

impl<'value> MetadataIterator<'value> {
  /// Returns the next item, or `None` at the end.
  ///
  /// # Errors
  /// - `ValueError` with the location of the problem, if the field value is not a valid list.
  pub fn next(self: &mut Self) -> Result<Option<MetadataToken<'value>>, ValueError> {
    while self.fieldIndex < self.headers.countValue {
      let header = entryAt(&self.headers, self.fieldIndex)
      if !metadataName(self.kind, Header.name(&header)) {
        self.fieldIndex = self.fieldIndex + usize.ONE
        self.valueOffset = usize.ZERO
      } else {
        let value = Header.value(&header)
        while self.valueOffset < value.length {
          while self.valueOffset < value.length && (value[self.valueOffset] == 32 || value[self.valueOffset] == 9 || value[self.valueOffset] == 44) {
            self.valueOffset = self.valueOffset + usize.ONE
          }
          if self.valueOffset >= value.length { break }
          let tokenStart = self.valueOffset
          while self.valueOffset < value.length && tokenByte(value[self.valueOffset]) {
            self.valueOffset = self.valueOffset + usize.ONE
          }
          if self.valueOffset == tokenStart {
            return Result<Option<MetadataToken<'value>>, ValueError>.failResult(metadataFailure(
              self.fieldIndex,
              self.valueOffset,
            ))
          }
          let tokenEnd = self.valueOffset
          while self.valueOffset < value.length && (value[self.valueOffset] == 32 || value[self.valueOffset] == 9) {
            self.valueOffset = self.valueOffset + usize.ONE
          }
          if self.valueOffset < value.length && value[self.valueOffset] == 59 {
            if self.kind != MetadataKind.TransferEncoding {
              return Result<Option<MetadataToken<'value>>, ValueError>.failResult(metadataFailure(
                self.fieldIndex,
                self.valueOffset,
              ))
            }
            let parameters = validateParameters(value, self.fieldIndex, self.valueOffset)
            match move parameters {
              Result<usize, ValueError>.Failure { error } => {
                return Result<Option<MetadataToken<'value>>, ValueError>.failResult(move error)
              }
              Result<usize, ValueError>.Success { value: end } => {
                self.valueOffset = end
              }
            }
          }
          while self.valueOffset < value.length && (value[self.valueOffset] == 32 || value[self.valueOffset] == 9) {
            self.valueOffset = self.valueOffset + usize.ONE
          }
          let rawEnd = self.valueOffset
          if self.valueOffset < value.length {
            if value[self.valueOffset] != 44 {
              return Result<Option<MetadataToken<'value>>, ValueError>.failResult(metadataFailure(
                self.fieldIndex,
                self.valueOffset,
              ))
            }
            self.valueOffset = self.valueOffset + usize.ONE
          }
          return Result<Option<MetadataToken<'value>>, ValueError>.succeed(
            Option<MetadataToken<'value>>.some(MetadataToken<'value> {
              tokenBytes: Slice.view<u8>(value, tokenStart, tokenEnd - tokenStart),
              rawBytes: Slice.view<u8>(value, tokenStart, rawEnd - tokenStart),
              sourceField: self.fieldIndex,
              sourceOffset: tokenStart,
            }),
          )
        }
        self.fieldIndex = self.fieldIndex + usize.ONE
        self.valueOffset = usize.ZERO
      }
    }
    return Result<Option<MetadataToken<'value>>, ValueError>.succeed(
      Option<MetadataToken<'value>>.none(),
    )
  }
}

fn metadata<'value>(headers: &Headers<'value>, kind: MetadataKind) -> MetadataIterator<'value> {
  return MetadataIterator<'value> {
    headers: Headers<'value> {
      storage: headers.storage,
      countValue: headers.countValue,
      fieldBytesValue: headers.fieldBytesValue,
    },
    kind: kind,
    fieldIndex: usize.ZERO,
    valueOffset: usize.ZERO,
  }
}

fn metadataName(kind: MetadataKind, name: string) -> bool {
  return match move kind {
    MetadataKind.Connection => asciiEqual(name, "Connection")
    MetadataKind.ContentEncoding => asciiEqual(name, "Content-Encoding")
    MetadataKind.TransferEncoding => asciiEqual(name, "Transfer-Encoding")
  }
}

fn validateParameters(
  value: &[u8],
  fieldIndex: usize,
  start: usize,
) -> Result<usize, ValueError> {
  let mut index = start
  while index < value.length && value[index] == 59 {
    index = index + usize.ONE
    while index < value.length && (value[index] == 32 || value[index] == 9) { index = index + usize.ONE }
    let nameStart = index
    while index < value.length && tokenByte(value[index]) { index = index + usize.ONE }
    if index == nameStart { return Result<usize, ValueError>.failResult(metadataFailure(fieldIndex, index)) }
    while index < value.length && (value[index] == 32 || value[index] == 9) { index = index + usize.ONE }
    if index >= value.length || value[index] != 61 {
      return Result<usize, ValueError>.failResult(metadataFailure(fieldIndex, index))
    }
    index = index + usize.ONE
    while index < value.length && (value[index] == 32 || value[index] == 9) { index = index + usize.ONE }
    if index < value.length && value[index] == 34 {
      index = index + usize.ONE
      let mut closed = false
      while index < value.length && !closed {
        let byte = value[index]
        if byte == 34 {
          closed = true
          index = index + usize.ONE
        } else if byte == 92 {
          index = index + usize.ONE
          if index >= value.length || !quotedPairByte(value[index]) {
            return Result<usize, ValueError>.failResult(metadataFailure(fieldIndex, index))
          }
          index = index + usize.ONE
        } else if quotedTextByte(byte) {
          index = index + usize.ONE
        } else {
          return Result<usize, ValueError>.failResult(metadataFailure(fieldIndex, index))
        }
      }
      if !closed { return Result<usize, ValueError>.failResult(metadataFailure(fieldIndex, index)) }
    } else {
      let valueStart = index
      while index < value.length && tokenByte(value[index]) { index = index + usize.ONE }
      if index == valueStart { return Result<usize, ValueError>.failResult(metadataFailure(fieldIndex, index)) }
    }
    while index < value.length && (value[index] == 32 || value[index] == 9) { index = index + usize.ONE }
    if index >= value.length || value[index] == 44 { return Result<usize, ValueError>.succeed(index) }
    if value[index] != 59 { return Result<usize, ValueError>.failResult(metadataFailure(fieldIndex, index)) }
  }
  return Result<usize, ValueError>.succeed(index)
}

fn quotedTextByte(value: u8) -> bool {
  return value == 9 || value == 32 || value == 33 || (value >= 35 && value <= 91)
    || (value >= 93 && value <= 126) || value >= 128
}

fn quotedPairByte(value: u8) -> bool {
  return value == 9 || (value >= 32 && value <= 126) || value >= 128
}

fn metadataFailure(fieldIndex: usize, offset: usize) -> ValueError {
  return indexedFailure(ValueReason.InvalidToken, ValueComponent.Metadata, fieldIndex, offset)
}

fn entryAt<'value>(headers: &Headers<'value>, index: usize) -> Header<'value> {
  return match headers.storage {
    HeaderStorage<'value>.Borrowed { entries } => entries[index]
    HeaderStorage<'value>.Packed { bytes, records } => {
      let record = records[index]
      let nameBytes = Slice.view<u8>(bytes, record.nameStart, record.nameLength)
      let valueBytes = Slice.view<u8>(bytes, record.valueStart, record.valueLength)
      unsafe {
        let name = String.fromUtf8Unchecked(nameBytes)
        let limits = exactLimits(record.nameLength, record.valueLength)
        let made = Header.make(name, valueBytes, limits)
        return match move made {
          Result<Header<'value>, ValueError>.Success { value } => value
          Result<Header<'value>, ValueError>.Failure { error } => absurd<Header<'value>>()
        }
      }
      return absurd<Header<'value>>()
    }
  }
}

fn exactLimits(nameLength: usize, valueLength: usize) -> Limits {
  let total = match move usize.checkedAdd(nameLength, valueLength) {
    Option<usize>.Some { value } => value
    Option<usize>.None => usize.MAX
  }
  return Limits {
    maxMethodBytes: usize.MAX,
    maxTargetBytes: usize.MAX,
    maxNameBytes: nameLength,
    maxValueBytes: valueLength,
    maxFields: usize.ONE,
    maxFieldBytes: total,
    maxOwnedBytes: usize.MAX,
  }
}

fn validateExisting<'value>(headers: &Headers<'value>, limits: Limits) -> Result<(), ValueError> {
  // This helper must remain allocation-free; validate directly instead of constructing a slice.
  if headers.countValue > limits.maxFields {
    return Result<(), ValueError>.failResult(limitFailure(
      ValueComponent.Headers,
      LimitKind.Fields,
      limits.maxFields,
      headers.countValue,
    ))
  }
  let mut total = usize.ZERO
  let mut index = usize.ZERO
  while index < headers.countValue {
    let header = entryAt(headers, index)
    let nameLength = String.byteLength(Header.name(&header))
    let valueLength = Header.value(&header).length
    if nameLength > limits.maxNameBytes {
      return Result<(), ValueError>.failResult(indexedLimitFailure(
        ValueComponent.HeaderName,
        LimitKind.NameBytes,
        limits.maxNameBytes,
        nameLength,
        index,
      ))
    }
    if valueLength > limits.maxValueBytes {
      return Result<(), ValueError>.failResult(indexedLimitFailure(
        ValueComponent.HeaderValue,
        LimitKind.ValueBytes,
        limits.maxValueBytes,
        valueLength,
        index,
      ))
    }
    total = match move checkedAdd(total, nameLength, ValueComponent.Headers) {
      Result<usize, ValueError>.Failure { error } => {
        return Result<(), ValueError>.failResult(move error)
      }
      Result<usize, ValueError>.Success { value } => value
    }
    total = match move checkedAdd(total, valueLength, ValueComponent.Headers) {
      Result<usize, ValueError>.Failure { error } => {
        return Result<(), ValueError>.failResult(move error)
      }
      Result<usize, ValueError>.Success { value } => value
    }
    if total > limits.maxFieldBytes {
      return Result<(), ValueError>.failResult(indexedLimitFailure(
        ValueComponent.Headers,
        LimitKind.FieldBytes,
        limits.maxFieldBytes,
        total,
        index,
      ))
    }
    index = index + usize.ONE
  }
  return Result<(), ValueError>.succeed(())
}

fn indexedLimitFailure(
  component: ValueComponent,
  limit: LimitKind,
  allowed: usize,
  attempted: usize,
  fieldIndex: usize,
) -> ValueError {
  return indexedFailure(
    ValueReason.LimitExceeded { limit: limit, allowed: allowed, attempted: attempted },
    component,
    fieldIndex,
    attempted,
  )
}

fn checkedAdd(left: usize, right: usize, component: ValueComponent) -> Result<usize, ValueError> {
  return match move usize.checkedAdd(left, right) {
    Option<usize>.None => Result<usize, ValueError>.failResult(sizeFailure(component))
    Option<usize>.Some { value } => Result<usize, ValueError>.succeed(value)
  }
}

fn copyBytes(output: &mut [u8], start: usize, source: &[u8]) -> usize {
  Slice.copyInto<u8>(&mut output, start, source)
  return start + source.length
}

fn bytesAsciiEqual(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut index = usize.ZERO
  while index < left.length {
    if lower(left[index]) != lower(right[index]) { return false }
    index = index + usize.ONE
  }
  return true
}

fn lower(value: u8) -> u8 {
  if value >= 65 && value <= 90 { return value + 32 }
  return value
}

fn absurd<T>() -> T {
  return Intrinsic.trap("HTTP headers: a stored header field no longer passes validation")
}
