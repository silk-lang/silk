//! Bounded recording of OpenTelemetry spans and their parent contexts.

import silk.collections.list { List }
import silk.concurrency.ambient_table { TraceContext }
import silk.concurrency.atomic { Atomic, MemoryOrder }
import silk.concurrency.thread { Concurrent, Transferable }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.num.f64
import silk.num.i64
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silk.platform.native.clock { NativeClock }
import silk.system.monotonic_clock { MonotonicClock }
import silk.trace.sink as Sinks
import silk.trace.sink { Sink }
import silk.system.insecure_seed { InsecureSeed }
import silk.system.random { Random }
import silk.system.random_native { OsRandom }
import silk.trace.metric as Measurements
import silk.trace { Meter, Place, SpanContext, SpanKind, Tracer }
import silk.trace.signals { LogRecord, MetricPoint, SignalState }
import silk.trace.storage { Buffers, Pool, Storage }
import silk.trace.values { Attributes, Value }

/// The OTel resource, root sampling probability and fixed storage budget.
pub struct Config {
  /// Value of the OpenTelemetry service.name resource attribute.
  pub serviceName: string<'static>,
  /// Value of service.version. An empty value omits this attribute.
  pub serviceVersion: string<'static>,
  /// Fraction of new roots to record. Child spans inherit the parent’s sampled bit.
  pub sampleRatio: f64,
  /// Number of span records beyond the finished-span buffers. A record is held from the span's
  /// open until a drain takes it, so open spans and undrained finished spans share the pool.
  pub openCapacity: usize,
  /// Number of preallocated producer pages in each signal buffer pool.
  pub threadCapacity: usize,
  /// Maximum records per page. A full pool counts additional observations as drops.
  pub bufferCapacity: usize,
}
impl Copy for Config {}
impl Config {
  /// Records all roots with 64 open spans and eight buffers of eight finished spans each.
  pub fn make(name: string<'static>) -> Self {
    return Config {serviceName: name, serviceVersion: "", sampleRatio: 1.0,
      openCapacity: 64, threadCapacity: 8, bufferCapacity: 8}
  }
}

/// A timed event and its captured fields.
pub struct SpanEvent {
  /// The event name supplied by the instrumented code.
  pub name: string<'static>,
  /// The event time in Unix nanoseconds.
  pub time: u64,
  /// The captured event fields.
  pub attributes: Attributes,
}
impl Copy for SpanEvent {}
impl SpanEvent {
  /// An empty event.
  pub fn empty() -> Self { return SpanEvent {name: "", time: 0, attributes: Attributes.empty()} }
}

fn noContext() -> SpanContext { return SpanContext {traceHigh: 0, traceLow: 0, span: 0, flags: 0} }

/// A complete span with owned attributes, events and links. Times are Unix nanoseconds.
pub struct Span {
  /// Identifiers and flags of this span.
  pub context: SpanContext,
  /// Parent identifiers and flags. A zero parent span ID denotes a root.
  pub parent: SpanContext,
  /// Name supplied at the span site.
  pub name: string<'static>,
  /// The OpenTelemetry kind of this span.
  pub kind: SpanKind,
  /// Source and instrumentation scope for a decorated declaration.
  pub place: Place,
  /// Span start time, in Unix nanoseconds.
  pub start: u64,
  /// Span completion time, in Unix nanoseconds.
  pub end: u64,
  /// Whether this span ended with an error status.
  pub error: bool,
  /// Whether cancellation closed this span.
  pub cancelled: bool,
  /// Static identity of the failure type on an effect failure exit.
  pub errorType: string<'static>,
  /// Captured span attributes.
  pub attributes: Attributes,
  /// Event storage. The first eventCount elements are initialized events.
  pub events: [SpanEvent; 4],
  /// Number of captured events.
  pub eventCount: usize,
  /// Number of events omitted at the per-span limit.
  pub droppedEvents: u64,
  /// Links to other spans. Only the first linkCount entries are live.
  pub links: [SpanContext; 4],
  /// Number of captured links.
  pub linkCount: usize,
  /// Number of links omitted at the per-span limit.
  pub droppedLinks: u64,
}
impl Copy for Span {}
impl Span {
  fn canAppendEvent(self: &mut Self) -> bool {
    if self.eventCount < self.events.length { return true }
    self.droppedEvents = self.droppedEvents + 1
    return false
  }
  /// Returns an empty record with no parent, events or links.
  pub fn empty() -> Self {
    return Span {context: noContext(), parent: noContext(), name: "", kind: SpanKind.Internal,
      place: Place {function: "", file: "", line: 0, packageName: "", packageVersion: ""},
      start: 0, end: 0, error: false, cancelled: false, errorType: "", attributes: Attributes.empty(),
      events: [SpanEvent.empty(); 4], eventCount: 0, droppedEvents: 0,
      links: [noContext(); 4], linkCount: 0, droppedLinks: 0}
  }
}

// What recording one span touches, kept together so that a span costs a few cache lines. The
// attributes, events and links live apart in the record's `SpanBody`, which only spans that
// have them touch beyond the attribute count.
struct OpenSpan {
  context: SpanContext,
  parent: SpanContext,
  previous: TraceContext,
  table: usize,
  name: string<'static>,
  kind: SpanKind,
  place: Place,
  start: u64,
  end: u64,
  error: bool,
  cancelled: bool,
  errorType: string<'static>,
  eventCount: usize,
  droppedEvents: u64,
  linkCount: usize,
  droppedLinks: u64,
}
impl Copy for OpenSpan {}
impl OpenSpan {
  fn canAppendEvent(self: &mut Self) -> bool {
    if self.eventCount < 4 { return true }
    self.droppedEvents = self.droppedEvents + 1
    return false
  }
}

struct SpanBody { attributes: Attributes, events: [SpanEvent; 4], links: [SpanContext; 4] }
impl Copy for SpanBody {}

// These hints are indexes, never pointers into a potentially destroyed recorder.
struct Cursor { owner: u64, generator: u64, write: usize }
impl Copy for Cursor {}
fn cursor() -> *mut Cursor { return Intrinsic.threadSlot<Cursor>() }

// SplitMix64's bijection disperses neighboring seeds throughout the u64 range.
fn mix(word: u64) -> u64 {
  let a = u64.wrappingMultiply(u64.bitXor(word, u64.shiftRight(word, 30)), 13787848793156543929)
  let b = u64.wrappingMultiply(u64.bitXor(a, u64.shiftRight(a, 27)), 10723151780598845931)
  return u64.bitXor(b, u64.shiftRight(b, 31))
}
fn nextId(state: &mut Cursor) -> u64 {
  state.generator = u64.wrappingAdd(state.generator, 11400714819323198485)
  let id = mix(state.generator)
  if id != 0 { return id }
  state.generator = u64.wrappingAdd(state.generator, 11400714819323198485)
  return mix(state.generator)
}
fn monotonicNs() -> u64 {
  let now = run NativeClock.now()
  return i64.toU64(now.seconds()) * 1000000000 + u32.toU64(now.subsecondNanoseconds())
}

// Span times come from the processor's tick counter where it runs at a constant rate shared by
// every core, the way profilers time zones: reading it costs a few cycles, a clock call costs
// dozens. The rate is measured against the monotonic clock once per process, and a copy made
// with fork inherits it. Elsewhere the ticks are the monotonic clock's nanoseconds.
static if Intrinsic.targetArchitecture() == "x86_64" && ((Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu") || Intrinsic.targetOperatingSystem() == "darwin") {
  @inlineAlways
  fn ticks() -> u64 {
    return unsafe Intrinsic.assembly<u64>("rdtsc\nshlq $$32, %rdx\norq %rdx, %rax", "={rax}", "rdx,flags", "none", true, false, ())
  }
  // CPUID leaf 0x80000007 reports in EDX bit 8 a tick counter that runs at a constant rate in
  // every power state; leaf 0x80000000 gives the highest extended leaf.
  fn steadyTicks() -> bool {
    let highest = unsafe Intrinsic.assembly<u64>("movl $$0x80000000, %eax\nxorl %ecx, %ecx\nmovq %rbx, %rsi\ncpuid\nmovq %rsi, %rbx",
      "={rax}", "rcx,rdx,rsi,flags", "none", true, false, ())
    if u64.bitAnd(highest, 4294967295) < 2147483655 { return false }
    let features = unsafe Intrinsic.assembly<u64>("movl $$0x80000007, %eax\nxorl %ecx, %ecx\nmovq %rbx, %rsi\ncpuid\nmovq %rsi, %rbx",
      "={rdx}", "rax,rcx,rsi,flags", "none", true, false, ())
    return u64.bitAnd(features, 256) != 0
  }
  fn fixedRate() -> f64 { return 0.0 }
} else {
static if Intrinsic.targetArchitecture() == "aarch64" && ((Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu") || Intrinsic.targetOperatingSystem() == "darwin") {
  @inlineAlways
  fn ticks() -> u64 {
    return unsafe Intrinsic.assembly<u64>("mrs $0, cntvct_el0", "=r", "", "none", true, false, ())
  }
  fn steadyTicks() -> bool { return true }
  // The generic timer states its frequency, so nothing needs measuring.
  fn fixedRate() -> f64 {
    let frequency = unsafe Intrinsic.assembly<u64>("mrs $0, cntfrq_el0", "=r", "", "none", true, false, ())
    if frequency == 0 { return 0.0 }
    return 1000000000.0 / u64.toF64(frequency)
  }
} else {
  @inlineAlways
  fn ticks() -> u64 { return monotonicNs() }
  fn steadyTicks() -> bool { return false }
  fn fixedRate() -> f64 { return 0.0 }
}
}

// The process's tick rate: nanoseconds per tick, or zero before it is known. A rate of one with
// `clock` set means the ticks are the monotonic clock itself.
struct TickRate { nanoseconds: f64, clock: bool, known: bool }
impl Copy for TickRate {}

fn tickRate() -> TickRate {
  let slot = Intrinsic.processSlot<TickRate>()
  let saved = unsafe Pointer.read(slot)
  if saved.known { return saved }
  let mut rate = TickRate {nanoseconds: 1.0, clock: true, known: true}
  if steadyTicks() {
    let fixed = fixedRate()
    if fixed > 0.0 {
      rate = TickRate {nanoseconds: fixed, clock: false, known: true}
    } else {
      // Two millisecond-long windows; the longer the window, the less the clock calls' own
      // time weighs. The counter must have moved forward for the rate to be believed.
      let startClock = monotonicNs()
      let startTicks = ticks()
      let mut clock = monotonicNs()
      while clock - startClock < 2000000 { clock = monotonicNs() }
      let endTicks = ticks()
      if endTicks > startTicks {
        rate = TickRate {nanoseconds: u64.toF64(clock - startClock) / u64.toF64(endTicks - startTicks), clock: false,
          known: true}
      }
    }
  }
  unsafe Pointer.write(slot, rate)
  return rate
}
fn sameRecord(first: TraceContext, second: TraceContext) -> bool {
  return first.owner == second.owner && first.span == second.span && first.record == second.record
}
fn ids(value: &TraceContext) -> SpanContext {
  return SpanContext {traceHigh: value.traceHigh, traceLow: value.traceLow, span: value.span,
    flags: u64.wrappingToU8(value.flags)}
}

/// Owns all recording storage. Its ambient operations reserve disjoint slots without parking.
pub struct Recorder {
  config: Config,
  tag: u64,
  seed: u64,
  baseWall: u64,
  baseMono: u64,
  baseTicks: u64,
  rate: f64,
  // An empty span to copy, as building one writes every attribute, event and link.
  blank: Span,
  // Allocation-backed atomic words for dropped spans, next thread seed, and drain cursor.
  counters: Storage<u64>,
  // Each record is written in place from open to drain; producers hand finished record numbers
  // to the drain, so no span is copied on the recording path.
  open: Pool<OpenSpan>,
  bodies: Storage<SpanBody>,
  ready: Buffers<u32>,
  /// Log buffers and metric instruments shared by this recorder’s providers.
  pub signals: SignalState,
}
impl Concurrent for Recorder {}
impl Transferable for Recorder {}

impl Recorder {
  /// Allocates every recording cell and reads the clock bases and an OS random seed.
  pub effect fn make(config: Config) -> Self ! OutOfMemoryError ? &mut Allocator {
    if config.threadCapacity != 0 && config.bufferCapacity > usize.MAX / config.threadCapacity {
      fail OutOfMemoryError {}
    }
    let finished = config.threadCapacity * config.bufferCapacity
    if finished > 4294967295 || config.openCapacity > 4294967295 - finished { fail OutOfMemoryError {} }
    let static metrics = Intrinsic.ambientCount<Meter>() > 0
    let mut random = OsRandom.make()
    let fixed = run InsecureSeed.fromRandom() |> Effect.provideMut<Random>(&mut random)
    let source = run InsecureSeed.get() |> Effect.provide<InsecureSeed>(&fixed)
    let seed = u64.bitXor(mix(InsecureSeed.first(&source)), InsecureSeed.second(&source))
    let wall = run NativeClock.systemNow()
    // OTLP timestamps are unsigned nanoseconds. Clamp wall clocks outside that range.
    let baseWall: u64 = if wall.unixSeconds() < 0 { 0 } else {
      u64.saturatingAdd(u64.saturatingMultiply(i64.toU64(wall.unixSeconds()), 1000000000),
        u32.toU64(wall.subsecondNanoseconds()))
    }
    let tag = unsafe Atomic.fetchAdd<u64>(Intrinsic.processSlot<u64>(), 1, MemoryOrder.Relaxed) + 1
    let rate = tickRate()
    let baseMono = monotonicNs()
    let baseTicks = if rate.clock { baseMono } else { ticks() }
    let blank = Span.empty()
    let initial = OpenSpan {context: blank.context, parent: blank.parent, previous: TraceContext.empty(), table: 0,
      name: "", kind: SpanKind.Internal, place: blank.place, start: 0, end: 0, error: false, cancelled: false,
      errorType: "", eventCount: 0, droppedEvents: 0, linkCount: 0, droppedLinks: 0}
    let body = SpanBody {attributes: blank.attributes, events: blank.events, links: blank.links}
    return Recorder {config: config, tag: tag, seed: seed, baseWall: baseWall, baseMono: baseMono,
      baseTicks: baseTicks, rate: rate.nanoseconds, blank: blank,
      counters: run Storage<u64>.make(3, 0), open: run Pool<OpenSpan>.make(config.openCapacity + finished, initial),
      bodies: run Storage<SpanBody>.make(config.openCapacity + finished, body),
      ready: run Buffers<u32>.make(config.threadCapacity, config.bufferCapacity, 0), signals: run SignalState.make(config.threadCapacity, config.bufferCapacity, metrics)}
  }
  /// Returns the OTel service name of this resource.
  pub fn serviceName(self: &Self) -> string<'static> { return self.config.serviceName }
  /// Returns the OTel service version of this resource.
  pub fn serviceVersion(self: &Self) -> string<'static> { return self.config.serviceVersion }
  /// Returns the current Unix nanoseconds on the recorder's monotonic time base.
  pub fn now(self: &Self) -> u64 {
    let current = ticks()
    if current <= self.baseTicks { return self.baseWall }
    return u64.saturatingAdd(self.baseWall, unsafe f64.toU64Unchecked(u64.toF64(current - self.baseTicks) * self.rate))
  }
  /// Returns the total number of spans lost to pool or buffer exhaustion or export failure.
  pub fn droppedSpans(self: &Self) -> u64 {
    return unsafe Atomic.load<u64>(unsafe self.counters.at(0), MemoryOrder.Relaxed)
  }
  /// Adds terminal export or recording losses to the resource's drop count.
  pub fn countDroppedSpans(self: &Self, count: u64) -> () {
    drop unsafe Atomic.fetchAdd<u64>(unsafe self.counters.at(0), count, MemoryOrder.Relaxed)
  }
  fn threadCursor(self: &Self) -> Cursor {
    let saved = unsafe Pointer.read(cursor())
    if saved.owner == self.tag { return saved }
    let serial = unsafe Atomic.fetchAdd<u64>(unsafe self.counters.at(1), 1, MemoryOrder.Relaxed)
    let lane = if self.config.threadCapacity == 0 { usize.ZERO }
      else { u64.toUsize(serial % usize.toU64(self.config.threadCapacity)) }
    return Cursor {owner: self.tag, generator: mix(u64.wrappingAdd(self.seed, serial)),
      write: lane}
  }
  fn sampled(self: &Self, traceLow: u64) -> bool {
    if self.config.sampleRatio >= 1.0 { return true }
    if !(self.config.sampleRatio > 0.0) { return false }
    return u64.toF64(u64.shiftRight(traceLow, 11)) < self.config.sampleRatio * 9007199254740992.0
  }
  fn active(self: &Self) -> TraceContext { return TraceContext.read() }
  // A context names its open record by number plus one, zero for none.
  fn activeIndex(self: &Self, context: &TraceContext) -> usize {
    let count = self.open.length()
    if context.owner != self.tag || context.record == 0 || context.record > usize.toU64(count) { return count }
    return u64.toUsize(context.record - 1)
  }
  fn finish(self: &Self, cancelled: bool) -> () {
    let current = self.active()
    let index = self.activeIndex(&current)
    if index == self.open.length() { return () }
    let end = self.now()
    let mut token = ()
    let opened = unsafe Pointer.borrowMut(&mut token, unsafe self.open.at(index))
    // A nested provide copies its parent's context and can even install this recorder
    // again. Only the original table can hand its record to the drain.
    if opened.table != TraceContext.tableAddress() { return () }
    opened.end = end
    if cancelled { opened.cancelled = true opened.error = true }
    unsafe TraceContext.install(&opened.previous)
    let mut local = self.threadCursor()
    if !self.ready.append(&mut local.write, Pointer.address(cursor()), &usize.toU32(index)) {
      self.open.release(index)
      self.countDroppedSpans(1)
    }
    unsafe Pointer.write(cursor(), local)
  }
  /// Takes one finished span. When a producer is writing a slot, draining skips that slot.
  pub fn takeSpan(self: &Self) -> Option<Span> {
    let mut span = self.blank
    if self.takeSpanInto(&mut span) { return Option<Span>.some(span) }
    return Option<Span>.none()
  }

  /// Takes one finished span into `span`, as [`takeSpan`] does, and returns whether there was
  /// one. Only what the span holds is written: its attributes, events and links past their counts
  /// keep what `span` held, so a drain that reuses one record copies no more than the span's
  /// contents.
  pub fn takeSpanInto(self: &Self, span: &mut Span) -> bool {
    let index = match unsafe self.ready.take(unsafe self.counters.at(2)) {
      Option<u32>.Some {value} => u32.toUsize(value)
      Option<u32>.None => { return false }
    }
    let mut token = ()
    let opened = unsafe Pointer.borrow(&token, unsafe self.open.at(index))
    let body = unsafe Pointer.borrow(&token, unsafe self.bodies.at(index))
    span.context = opened.context
    span.parent = opened.parent
    span.name = opened.name
    span.kind = opened.kind
    span.place = opened.place
    span.start = opened.start
    span.end = opened.end
    span.error = opened.error
    span.cancelled = opened.cancelled
    span.errorType = opened.errorType
    let mut at: usize = 0
    while at < body.attributes.count {
      span.attributes.items[at] = body.attributes.items[at]
      at = at + 1
    }
    span.attributes.count = body.attributes.count
    span.attributes.dropped = body.attributes.dropped
    at = 0
    while at < opened.eventCount {
      span.events[at] = body.events[at]
      at = at + 1
    }
    span.eventCount = opened.eventCount
    span.droppedEvents = opened.droppedEvents
    at = 0
    while at < opened.linkCount {
      span.links[at] = body.links[at]
      at = at + 1
    }
    span.linkCount = opened.linkCount
    span.droppedLinks = opened.droppedLinks
    self.open.release(index)
    return true
  }
}
impl Meter for Recorder {
  effect fn add<Args>(self: &Self, static name: string<'static>, amount: u64, args: &Args) -> () {
    Measurements.add(&self.signals, self.now(), name, amount, args)
  }
  effect fn adjust<Args>(self: &Self, static name: string<'static>, amount: i64, args: &Args) -> () {
    Measurements.adjust(&self.signals, self.now(), name, amount, args)
  }
  effect fn gauge<Args>(self: &Self, static name: string<'static>, value: f64, args: &Args) -> () {
    Measurements.gauge(&self.signals, self.now(), name, value, args)
  }
  effect fn record<Args>(self: &Self, static name: string<'static>, value: f64, args: &Args) -> () {
    Measurements.record(&self.signals, self.now(), name, value, args)
  }
}

impl Tracer for Recorder {
  effect fn enter<Args>(self: &Self, static name: string<'static>, static kind: SpanKind, static place: Place,
    args: &Args, remote: Option<SpanContext>) -> () {
    let table = TraceContext.tableAddress()
    if table == 0 { return () }
    let previous = self.active()
    let parent = match move remote {
      Option<SpanContext>.Some {value} => value
      Option<SpanContext>.None => ids(&previous)
    }
    let mut local = self.threadCursor()
    let mut context = parent
    if parent.span == 0 {
      context.traceHigh = nextId(&mut local)
      context.traceLow = nextId(&mut local)
      context.flags = if self.sampled(context.traceLow) { 1 } else { 0 }
    }
    context.span = nextId(&mut local)
    let depth = u64.shiftRight(previous.flags, 8) + 1
    let mut region = TraceContext {traceHigh: context.traceHigh, traceLow: context.traceLow, span: context.span,
      flags: u64.bitOr(u64.shiftLeft(depth, 8), u8.toU64(context.flags)), owner: self.tag, record: 0}
    let sampled = u8.bitAnd(context.flags, 1) != 0
    let mut index = self.open.length()
    if sampled { index = self.open.acquire() }
    unsafe Pointer.write(cursor(), local)
    if index != self.open.length() {
      // The claimed record is written in place; only its counts are reset, so earlier
      // contents past them are never read.
      let mut token = ()
      let opened = unsafe Pointer.borrowMut(&mut token, unsafe self.open.at(index))
      opened.previous = previous
      opened.table = table
      opened.context = context
      opened.parent = parent
      opened.name = name
      opened.kind = kind
      opened.place = place
      opened.end = 0
      opened.error = false
      opened.cancelled = false
      opened.errorType = ""
      opened.eventCount = 0
      opened.droppedEvents = 0
      opened.linkCount = 0
      opened.droppedLinks = 0
      let mut cold = ()
      let body = unsafe Pointer.borrowMut(&mut cold, unsafe self.bodies.at(index))
      body.attributes.count = 0
      body.attributes.dropped = 0
      body.attributes.fields(args)
      // A user Display implementation can explicitly invoke a recorder. The saved
      // parent must still be live when it becomes this guard's restoration target.
      if !sameRecord(previous, self.active()) {
        Intrinsic.trap("formatting span attributes changed the enclosing span")
      }
      opened.start = self.now()
      region.record = usize.toU64(index) + 1
    } else if sampled { self.countDroppedSpans(1) }
    unsafe TraceContext.install(&region)
  }
  effect fn exit(self: &Self) -> () { self.finish(false) }
  effect fn cancelled(self: &Self) -> () { self.finish(true) }
  effect fn failed(self: &Self, static error: string<'static>) -> () {
    let active = self.active()
    let slot = self.activeIndex(&active)
    if slot == self.open.length() { return () }
    let mut token = ()
    let opened = unsafe Pointer.borrowMut(&mut token, unsafe self.open.at(slot))
    opened.error = true
    opened.errorType = error
  }
  effect fn attribute<V>(self: &Self, static key: string<'static>, value: &V) -> () {
    let active = self.active()
    let slot = self.activeIndex(&active)
    if slot == self.open.length() { return () }
    let captured = Value.capture<V>(value)
    if !sameRecord(active, self.active()) { return () }
    let mut cold = ()
    let body = unsafe Pointer.borrowMut(&mut cold, unsafe self.bodies.at(slot))
    body.attributes.setCaptured(key, captured)
  }
  effect fn recordError<V>(self: &Self, value: &V) -> () {
    let active = self.active()
    let slot = self.activeIndex(&active)
    if slot == self.open.length() { return () }
    let captured = Value.capture<V>(value)
    if !sameRecord(active, self.active()) { return () }
    let mut token = ()
    let opened = unsafe Pointer.borrowMut(&mut token, unsafe self.open.at(slot))
    opened.error = true
    let mut cold = ()
    let body = unsafe Pointer.borrowMut(&mut cold, unsafe self.bodies.at(slot))
    body.attributes.setCaptured("exception.message", captured)
  }
  effect fn event<Args>(self: &Self, static name: string<'static>, args: &Args) -> () {
    let active = self.active()
    let slot = self.activeIndex(&active)
    if slot == self.open.length() { return () }
    let mut check = ()
    if !(unsafe Pointer.borrowMut(&mut check, unsafe self.open.at(slot))).canAppendEvent() { return () }
    // Display may synchronously provide a tracer and observe the same span.
    // Release the borrow of its storage across that callback, then recheck its capacity.
    let attributes = Attributes.make(args)
    if !sameRecord(active, self.active()) { return () }
    let mut token = ()
    let opened = unsafe Pointer.borrowMut(&mut token, unsafe self.open.at(slot))
    if !opened.canAppendEvent() { return () }
    let index = opened.eventCount
    let mut cold = ()
    let body = unsafe Pointer.borrowMut(&mut cold, unsafe self.bodies.at(slot))
    body.events[index] = SpanEvent {name: name, time: self.now(), attributes: attributes}
    opened.eventCount = index + 1
  }
  effect fn link(self: &Self, context: &SpanContext) -> () {
    let active = self.active()
    let slot = self.activeIndex(&active)
    if slot == self.open.length() { return () }
    let mut token = ()
    let opened = unsafe Pointer.borrowMut(&mut token, unsafe self.open.at(slot))
    let index = opened.linkCount
    if index == 4 { opened.droppedLinks = opened.droppedLinks + 1 return () }
    let mut cold = ()
    let body = unsafe Pointer.borrowMut(&mut cold, unsafe self.bodies.at(slot))
    body.links[index] = context.*
    opened.linkCount = index + 1
  }
}

impl Recorder {
  /// The maximum number of completed spans the recorder can retain.
  pub fn finishedCapacity(self: &Self) -> usize { return self.ready.length() }
}

/// An owned collection of exported telemetry records.
pub struct Memory { collected: List<Span>, logsData: List<LogRecord>, metricsData: List<MetricPoint> }
impl Memory {
  /// Creates an empty collector.
  pub fn make() -> Self { return Memory {collected: List<Span>.make(), logsData: List<LogRecord>.make(), metricsData: List<MetricPoint>.make()} }
  /// Borrows the spans in their drain order.
  pub fn spans(self: &Self) -> &[Span] { return self.collected.asSlice() }
  /// Borrows the delivered log records.
  pub fn logs(self: &Self) -> &[LogRecord] { return self.logsData.asSlice() }
  /// Borrows the delivered metric snapshots.
  pub fn metrics(self: &Self) -> &[MetricPoint] { return self.metricsData.asSlice() }
  /// Appends one span batch.
  pub effect fn appendSpans(self: &mut Self, values: &[Span]) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.collected.appendSlice(values)
  }
  /// Appends one log batch.
  pub effect fn appendLogs(self: &mut Self, values: &[LogRecord]) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.logsData.appendSlice(values)
  }
  /// Appends one cumulative metric batch.
  pub effect fn appendMetrics(self: &mut Self, values: &[MetricPoint]) -> () ! OutOfMemoryError ? &mut Allocator {
    run self.metricsData.appendSlice(values)
  }
  /// Collects at most one recorder capacity of completed spans, reserving space before removal.
  pub effect fn drain(self: &mut Self, recorder: &Recorder) -> () ! OutOfMemoryError ? &mut Allocator {
    let count = recorder.finishedCapacity()
    run self.collected.reserve(count)
    let mut at: usize = 0
    while at < count {
      match recorder.takeSpan() {
        Option<Span>.Some {value} => { drop self.collected.appendWithinCapacity(value) }
        Option<Span>.None => { return () }
      }
      at = at + 1
    }
  }
}


impl Recorder {
  /// Drains the current buffers to a sink, including logs and cumulative metric snapshots.
  pub effect fn flush<E, ?R, S: Sink<E ? R>>(self: &Self, sink: &mut S) -> ()
  ! E | OutOfMemoryError ? R | &mut Allocator {
    return run Sinks.flush<E, R, S>(self, &mut sink.*)
  }

  /// Periodically flushes the recorder until cancellation or a sink failure.
  pub effect fn exportBatches<E, ?R, S: Sink<E ? R>>(self: &Self, sink: &mut S) -> ()
  ! E | OutOfMemoryError ? R | &mut Allocator | &mut MonotonicClock {
    return run Sinks.exportBatches<E, R, S>(self, &mut sink.*)
  }
}
