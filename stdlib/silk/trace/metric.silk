//! Cumulative OpenTelemetry instrument updates backed by a recorder's preallocated series.

import silk.num.i64
import silk.num.u8
import silk.core.static_text { StaticText }
import silk.trace.signals { InstrumentKind, SignalState }
import silk.trace.values { Attributes }

// The bounded polynomial hash folds during specialization. Directory lookup compares names on collision.
static fn nameHash(name: string<'static>) -> u64 {
  let mut result: u64 = 0
  let mut at: usize = 0
  while at < StaticText.byteLength(name) {
    result = (result * 131 + u8.toU64(StaticText.byteAt(name, at))) % 2147483647
    at = at + 1
  }
  return result
}

/// Adds a nonnegative amount to a cumulative counter.
pub fn add<Args>(signals: &SignalState, time: u64, static name: string<'static>, amount: u64, args: &Args) -> () {
  let static hash: u64 = nameHash(name)
  signals.observe(hash, name, InstrumentKind.Counter, &Attributes.make(args), time, amount, 0.0)
}

/// Adds a signed amount to a cumulative up-down counter.
pub fn adjust<Args>(signals: &SignalState, time: u64, static name: string<'static>, amount: i64, args: &Args) -> () {
  let static hash: u64 = nameHash(name)
  signals.observe(hash, name, InstrumentKind.UpDownCounter, &Attributes.make(args), time, i64.wrappingToU64(amount), 0.0)
}

/// Sets the most recently observed value of a gauge.
pub fn gauge<Args>(signals: &SignalState, time: u64, static name: string<'static>, value: f64, args: &Args) -> () {
  let static hash: u64 = nameHash(name)
  signals.observe(hash, name, InstrumentKind.Gauge, &Attributes.make(args), time, 0, value)
}

/// Adds a measurement to the explicit-bucket histogram.
pub fn record<Args>(signals: &SignalState, time: u64, static name: string<'static>, value: f64, args: &Args) -> () {
  let static hash: u64 = nameHash(name)
  signals.observe(hash, name, InstrumentKind.Histogram, &Attributes.make(args), time, 0, value)
}
