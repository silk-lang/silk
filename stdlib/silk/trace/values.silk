//! Bounded, owned attribute values used by recorded spans, logs and metrics.

import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.ownership { Copy }
import silk.core.reflect { Reflect, labeledFieldKind, namedKind, anonymousNamedKind }
import silk.core.result { Result }
import silk.core.static_text { StaticText }
import silk.io.writer { Writer, WriterError }
import silk.text.format { Format, Display }
import silk.text.string { String, InvalidUtf8 }
import silk.num.i8
import silk.num.i16
import silk.num.i32
import silk.num.isize
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.usize
import silk.num.f32

/// At most 64 UTF-8 bytes, owned by the record.
pub struct Text { bytes: [u8; 64], length: usize }
impl Copy for Text {}

impl Text {
  /// Returns an empty text value.
  pub fn empty() -> Self { return Text {bytes: [0; 64], length: 0} }

  /// Borrows the valid UTF-8 prefix. A scalar split at capacity is omitted.
  pub fn view(self: &Self) -> string {
    let mut length = self.length
    while length > 0 {
      match String.fromUtf8(Slice.view<u8>(&self.bytes, 0, length)) {
        Result<string, InvalidUtf8>.Success {value} => { return value }
        Result<string, InvalidUtf8>.Failure {error} => { length = error.offset }
      }
    }
    return ""
  }

  effect fn writeAll(self: &mut Self, values: &[u8]) -> () ! WriterError {
    let mut at: usize = 0
    while at < values.length && self.length < 64 {
      self.bytes[self.length] = values[at]
      self.length = self.length + 1
      at = at + 1
    }
  }
  effect fn flush(self: &mut Self) -> () {}

  /// Formats a log template into fixed record storage.
  pub fn render<Args>(static template: string<'static>, args: &Args) -> Self {
    let mut result = Text.empty()
    drop run Effect.result(Format.format<Args>(template, args) |> Effect.provideMut<Writer>(&mut result))
    return result
  }
  /// Formats one displayable attribute into fixed record storage.
  pub fn display<V: Display>(value: &V) -> Self {
    let mut result = Text.empty()
    drop run Effect.result(Format.display(value) |> Effect.provideMut<Writer>(&mut result))
    return result
  }
}

impl Writer for Text {
  writeAll: Text.writeAll
  flush: Text.flush
}

// Copy through the concrete type selected for this specialization.
fn scalar<T: Copy>(value: &T) -> T { return value.* }

/// An OpenTelemetry scalar, including signed and unsigned Silk integers.
pub union Value {
  Bool {pub value: bool},
  Integer {pub value: i64},
  Unsigned {pub value: u64},
  Double {pub value: f64},
  Text {pub value: Text},
}
impl Copy for Value {}

fn borrowed<V>(value: & &V) -> Value { return Value.capture<V>(value.*) }

impl Value {
  /// Keeps primitive values typed and captures other values through their Display implementation.
  pub fn capture<V>(value: &V) -> Self {
    let static name = Reflect.typeName<V>()
    static if StaticText.byteAt(name, 0) == 38 { return borrowed(value) }
    else {
      static if name == "bool" { return Value.Bool {value: scalar<bool>(value)} }
      static if name == "i8" { return Value.Integer {value: i8.toI64(scalar<i8>(value))} }
      static if name == "i16" { return Value.Integer {value: i16.toI64(scalar<i16>(value))} }
      static if name == "i32" { return Value.Integer {value: i32.toI64(scalar<i32>(value))} }
      static if name == "i64" { return Value.Integer {value: scalar<i64>(value)} }
      static if name == "isize" { return Value.Integer {value: isize.toI64(scalar<isize>(value))} }
      static if name == "u8" { return Value.Unsigned {value: u8.toU64(scalar<u8>(value))} }
      static if name == "u16" { return Value.Unsigned {value: u16.toU64(scalar<u16>(value))} }
      static if name == "u32" { return Value.Unsigned {value: u32.toU64(scalar<u32>(value))} }
      static if name == "u64" { return Value.Unsigned {value: scalar<u64>(value)} }
      static if name == "usize" { return Value.Unsigned {value: usize.toU64(scalar<usize>(value))} }
      static if name == "f32" { return Value.Double {value: f32.toF64(scalar<f32>(value))} }
      static if name == "f64" { return Value.Double {value: scalar<f64>(value)} }
      return Value.Text {value: Text.display<V>(&value.*)}
    }
  }
  /// Compares attribute type and value.
  pub fn equivalent(self: &Self, other: &Self) -> bool {
    match &self.* {
      Value.Bool {value} => { if let Value.Bool {value: b} = &other.* { return value == b } }
      Value.Integer {value} => { if let Value.Integer {value: b} = &other.* { return value == b } }
      Value.Unsigned {value} => { if let Value.Unsigned {value: b} = &other.* { return value == b } }
      Value.Double {value} => { if let Value.Double {value: b} = &other.* { return value == b } }
      Value.Text {value} => { if let Value.Text {value: b} = &other.* { return value.view() == b.view() } }
    }
    return false
  }
}

/// One static key and its owned value.
pub struct Attribute {
  /// The field or user-supplied key.
  pub key: string<'static>,
  /// The value captured during observation.
  pub value: Value,
}
impl Copy for Attribute {}
/// Up to eight distinct keys. Updates to an existing key replace its value.
pub struct Attributes {
  /// Attribute storage. Only the first count entries are populated.
  pub items: [Attribute; 8],
  /// Number of distinct keys captured.
  pub count: usize,
  /// Number of additional keys omitted at capacity.
  pub dropped: u64,
}
impl Copy for Attributes {}
impl Attributes {
  /// Creates an empty set.
  pub fn empty() -> Self {
    let item = Attribute {key: "", value: Value.Bool {value: false}}
    return Attributes {items: [item; 8], count: 0, dropped: 0}
  }
  /// Sets a typed value or increments the dropped count when storage is full.
  pub fn set<V>(self: &mut Self, static key: string<'static>, value: &V) -> () {
    let mut at: usize = 0
    while at < self.count && self.items[at].key != key { at = at + 1 }
    if at == self.items.length { self.dropped = self.dropped + 1 return () }
    self.items[at] = Attribute {key: key, value: Value.capture<V>(&value.*)}
    if at == self.count { self.count = self.count + 1 }
  }
  /// Collects the named fields of an argument record.
  pub fn fields<Args>(self: &mut Self, args: &Args) -> () {
    let static kind = Reflect.typeKind(Reflect.typeOf<Args>())
    static if kind == namedKind || kind == anonymousNamedKind {
      static for field in Reflect.fields<Args>() {
        static if Reflect.fieldKind(field) == labeledFieldKind {
          self.set(Reflect.fieldLabel(field), Reflect.borrowField(args, field))
        }
      }
    }
  }
  /// Captures the named fields of an argument record into a fresh set.
  pub fn make<Args>(args: &Args) -> Self {
    let mut result = Attributes.empty()
    result.fields(args)
    return result
  }
  /// Compares keys and values independently of insertion order.
  pub fn equivalent(self: &Self, other: &Self) -> bool {
    if self.count != other.count { return false }
    let mut at: usize = 0
    while at < self.count {
      let mut peer: usize = 0
      while peer < other.count && other.items[peer].key != self.items[at].key { peer = peer + 1 }
      if peer == other.count || !self.items[at].value.equivalent(&other.items[peer].value) { return false }
      at = at + 1
    }
    return true
  }
}
