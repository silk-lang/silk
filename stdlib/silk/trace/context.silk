//! The trace identifiers and flags that cross process and execution boundaries.

import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.num.u8
import silk.num.u64
import silk.text.string { String }

/// The 128-bit trace ID, 64-bit span ID and W3C trace flags of one span.
pub struct SpanContext {
  /// High half of the trace identifier in network byte order.
  pub traceHigh: u64,
  /// Low half of the trace identifier in network byte order.
  pub traceLow: u64,
  /// The span identifier, nonzero for a valid context.
  pub span: u64,
  /// The W3C trace flags. Bit zero is the sampled flag.
  pub flags: u8,
}
impl Copy for SpanContext {}

/// An owned version 00 W3C traceparent header value.
pub struct Traceparent { bytes: [u8; 55] }

impl Traceparent {
  /// Borrows the header as lowercase ASCII text.
  pub fn view(self: &Self) -> string {
    return unsafe String.fromUtf8Unchecked(&self.bytes)
  }
}

fn writeHex(output: &mut [u8], start: usize, width: usize, value: u64) -> () {
  let mut at = start + width
  let mut remaining = value
  while at > start {
    at = at - 1
    let digit = u64.toU8(u64.bitAnd(remaining, 15))
    output[at] = if digit < 10 { digit + 48 } else { digit + 87 }
    remaining = u64.shiftRight(remaining, 4)
  }
}

/// Encodes a valid context into the 55 bytes of a version 00 traceparent.
pub fn traceparent(context: &SpanContext) -> Traceparent {
  let mut bytes: [u8; 55] = [0; 55]
  bytes[0] = 48
  bytes[1] = 48
  bytes[2] = 45
  writeHex(&mut bytes, 3, 16, context.traceHigh)
  writeHex(&mut bytes, 19, 16, context.traceLow)
  bytes[35] = 45
  writeHex(&mut bytes, 36, 16, context.span)
  bytes[52] = 45
  writeHex(&mut bytes, 53, 2, u8.toU64(context.flags))
  return Traceparent {bytes: bytes}
}

// All callers have checked the field boundaries. W3C hex excludes uppercase digits.
fn readHex(input: &[u8], start: usize, width: usize) -> Option<u64> {
  let mut result: u64 = 0
  let mut at = start
  while at < start + width {
    let byte = input[at]
    let digit = if byte >= 48 && byte <= 57 { byte - 48 }
      else if byte >= 97 && byte <= 102 { byte - 87 }
      else { return Option<u64>.none() }
    result = u64.bitOr(u64.shiftLeft(result, 4), u8.toU64(digit))
    at = at + 1
  }
  return Option<u64>.some(result)
}

/// Parses a W3C traceparent header. A later version may append fields after a hyphen.
pub fn parseTraceparent(text: string) -> Option<SpanContext> {
  let bytes = String.utf8Bytes(text)
  if bytes.length < 55 || bytes[2] != 45 || bytes[35] != 45 || bytes[52] != 45 {
    return Option<SpanContext>.none()
  }
  let version = readHex(bytes, 0, 2).unwrapOr(255)
  if version == 255 || (bytes.length > 55 && (version == 0 || bytes[55] != 45)) {
    return Option<SpanContext>.none()
  }
  let high = match readHex(bytes, 3, 16) {
    Option<u64>.Some {value} => value
    Option<u64>.None => { return Option<SpanContext>.none() }
  }
  let low = match readHex(bytes, 19, 16) {
    Option<u64>.Some {value} => value
    Option<u64>.None => { return Option<SpanContext>.none() }
  }
  let span = match readHex(bytes, 36, 16) {
    Option<u64>.Some {value} => value
    Option<u64>.None => { return Option<SpanContext>.none() }
  }
  let flags = match readHex(bytes, 53, 2) {
    Option<u64>.Some {value} => value
    Option<u64>.None => { return Option<SpanContext>.none() }
  }
  if (high == 0 && low == 0) || span == 0 { return Option<SpanContext>.none() }
  return Option<SpanContext>.some(SpanContext {traceHigh: high, traceLow: low, span: span, flags: u64.toU8(flags)})
}
