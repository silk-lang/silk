//! Records structured ambient log events with the current W3C trace and span identifiers.

import silk.concurrency.sync { Arc }
import silk.concurrency.thread { Concurrent, Transferable }
import silk.core.effect { Effect }
import silk.io.logger { Logger, LogLevel }
import silk.trace { Trace }
import silk.trace.record { Recorder }
import silk.trace.signals { LogRecord }
import silk.trace.values { Attributes, Text }

/// An ambient Logger provider that appends OpenTelemetry logs to a recorder.
pub struct OtelLogger { recorder: Arc<Recorder> }

impl OtelLogger {
  /// Shares the recorder's queue with an ambient log scope.
  pub fn make(recorder: &Arc<Recorder>) -> Self {
    return OtelLogger {recorder: recorder.clone()}
  }

  /// Returns a provider that both records and forwards every event to the supplied Logger provider.
  pub fn forwarding<P: Concurrent + Transferable>(self: Self, inner: &Arc<P>) -> ForwardingLogger<P> {
    return ForwardingLogger<P> {logger: move self, inner: inner.clone()}
  }

  fn capture<Args>(self: &Self, level: LogLevel, static template: string<'static>, args: &Args) -> () {
    let recorder = self.recorder.get()
    let severity: u64 = match level {
      LogLevel.Trace => 1
      LogLevel.Debug => 5
      LogLevel.Info => 9
      LogLevel.Warning => 13
      LogLevel.Error => 17
    }
    recorder.signals.appendLog(LogRecord {
      time: recorder.now(), severity: severity, template: template,
      body: Text.render(template, args), attributes: Attributes.make(args), context: Trace.current(),
    })
  }
}

impl Logger for OtelLogger {
  effect fn log<Args>(self: &Self, level: LogLevel, static template: string<'static>, args: &Args) -> () {
    self.capture(level, template, args)
  }
}

/// An OpenTelemetry logger that also supplies the event to an inner ambient provider.
pub struct ForwardingLogger<P> { logger: OtelLogger, inner: Arc<P> }

impl<P: Concurrent + Transferable> Logger for ForwardingLogger<P> {
  effect fn log<Args>(self: &Self, level: LogLevel, static template: string<'static>, args: &Args) -> () {
    self.logger.capture(level, template, args)
    run Logger.log(level, template, args) |> Effect.provideAmbient<Logger>(&self.inner)
  }
}
