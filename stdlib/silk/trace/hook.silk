//! Bound functions used by the compiler at the entry and exits of a traced declaration.
import silk.concurrency.ambient_table { TraceContext }
import silk.core.option { Option }
import silk.trace { Place, SpanContext, SpanKind, Tracer }

/// The caller's context, saved independently of the recorder's bounded pool.
pub struct Guard { previous: TraceContext, table: usize, owner: u64, span: u64, record: u64 }

static fn spanKind(name: string<'static>) -> SpanKind {
  if name == "server" { return SpanKind.Server }
  if name == "client" { return SpanKind.Client }
  if name == "producer" { return SpanKind.Producer }
  if name == "consumer" { return SpanKind.Consumer }
  return SpanKind.Internal
}

/// Opens a span and saves the caller's context for every exit from the activation.
@inlineAlways
pub fn enter<Args>(static name: string<'static>, static kind: string<'static>, static function: string<'static>,
  static file: string<'static>, static packageName: string<'static>, static packageVersion: string<'static>, args: &Args) -> Guard {
  static if Intrinsic.ambientCount<Tracer>() > 0 {
    let previous = TraceContext.read()
    run Tracer.enter(name, spanKind(kind), Place {function: function, file: file, line: 0, packageName: packageName,
      packageVersion: packageVersion}, args, Option<SpanContext>.none())
    let active = TraceContext.read()
    return Guard {previous: previous, table: TraceContext.tableAddress(), owner: active.owner, span: active.span, record: active.record}
  } else { return Guard {previous: TraceContext.empty(), table: 0, owner: 0, span: 0, record: 0} }
}

/// Closes the span after a normal or failing return.
@inlineAlways
pub fn exit(guard: Guard) -> () {
  static if Intrinsic.ambientCount<Tracer>() > 0 {
    if !TraceContext.mayClose(&guard.previous, guard.table, guard.owner, guard.span, guard.record) { return () }
    run Tracer.exit()
    unsafe TraceContext.install(&guard.previous)
  }
}

/// Records the dynamic error member before closing a failed span.
@inlineAlways
pub fn failed(static error: string<'static>) -> () {
  static if Intrinsic.ambientCount<Tracer>() > 0 { run Tracer.failed(error) }
}

/// Closes a cancelled span and restores the parent context.
@inlineAlways
pub fn cancelled(guard: Guard) -> () {
  static if Intrinsic.ambientCount<Tracer>() > 0 {
    if !TraceContext.mayClose(&guard.previous, guard.table, guard.owner, guard.span, guard.record) { return () }
    run Tracer.cancelled()
    unsafe TraceContext.install(&guard.previous)
  }
}
