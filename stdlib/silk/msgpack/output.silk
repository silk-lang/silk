//! Write MessagePack values one at a time through the ambient `Writer`.
//!
//! # When to use
//! Use [`MsgpackOutput`] to write MessagePack by hand, value by value, without a tree: a scalar with
//! one call, an array with [`MsgpackOutput.writeArrayHeader`] and then its elements, a map with
//! [`MsgpackOutput.writeMapHeader`] and then each key and its value. To write a tree, use
//! `silk.msgpack.value.Msgpack.write`. To write your own types, use
//! `silk.schema.msgpack.SchemaMsgpack.encode`.
//!
//! # Details
//! Every value is written in the shortest MessagePack format that holds it: an integer from -32 to
//! 127 takes one byte, a string of up to 31 bytes one header byte. A float is always written as a
//! `float 64`. Nothing is buffered and nothing is allocated; the functions do not flush the
//! `Writer`.
//!
//! # Errors
//! - `MsgpackError` with `MsgpackReason.TooLong` for a length or count above 4294967295, which
//!   MessagePack cannot write. Nothing is written.
//! - `WriterError` if the `Writer` fails.
//!
//! # Gotchas
//! The functions do not check that the elements written after a header match its count. A wrong
//! count gives bytes that a reader misreads.
//!
//! # Examples
//! ## Write a map by hand
//! ```silk
//! import silk.collections.slice { Slice }
//! import silk.core.effect { Effect }
//! import silk.io.writer { Writer, WriterError }
//! import silk.msgpack.output { MsgpackOutput }
//! import silk.msgpack.scanner { MsgpackError }
//!
//! struct Capture {
//!   bytes: [u8; 32],
//!   length: usize,
//! }
//!
//! impl Writer for Capture {
//!   effect fn writeAll(self: &mut Self, value: &[u8]) -> () ! WriterError ? &mut Writer {
//!     if self.length + value.length > 32 { fail Writer.failure() }
//!     Slice.copyInto<u8>(&mut self.bytes, self.length, value)
//!     self.length = self.length + value.length
//!     return ()
//!   }
//!
//!   effect fn flush(self: &mut Self) -> () ! WriterError ? &mut Writer { return () }
//! }
//!
//! effect fn write() -> () ! MsgpackError | WriterError ? &mut Writer {
//!   // {"id": 7, "ok": true}
//!   run MsgpackOutput.writeMapHeader(2)
//!   run MsgpackOutput.writeString("id")
//!   run MsgpackOutput.writeUnsigned(7)
//!   run MsgpackOutput.writeString("ok")
//!   return run MsgpackOutput.writeBool(true)
//! }
//!
//! pub effect fn main() -> i32 ! MsgpackError | WriterError {
//!   let mut capture = Capture { bytes: [0; 32], length: 0 }
//!   run write() |> Effect.provideMut<Writer>(&mut capture)
//!   if Slice.view<u8>(&capture.bytes, 0, capture.length) != b"\x82\xa2id\x07\xa2ok\xc3" {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Data formats

import silk.collections.slice { Slice }
import silk.io.writer { Writer, WriterError }
import silk.msgpack.scanner { MsgpackError, MsgpackReason }
import silk.num.f64
import silk.num.i64
import silk.num.i8
import silk.num.u64
import silk.num.u8
import silk.num.usize
import silk.text.string { String }

/// The owner of the functions that write single MessagePack values. It has no fields and is never
/// constructed.
pub struct MsgpackOutput {}

// The largest length or count MessagePack can write.
const MAX_LENGTH: u64 = 4294967295

// Writes `lead`, then the low `width` bytes of `value` in big-endian order.
effect fn tagged(lead: u8, value: u64, width: usize) -> ()
  ! WriterError
  ? &mut Writer {
  let mut buffer: [u8; 9] = [0; 9]
  buffer[0] = lead
  let mut rest = value
  let mut at = width
  while at > usize.ZERO {
    buffer[at] = u64.toU8(rest % 256)
    rest = rest / 256
    at = at - usize.ONE
  }
  return run Writer.writeAll(Slice.view<u8>(&buffer, usize.ZERO, width + usize.ONE))
}

// Writes the header of a value whose length takes 1, 2 or 4 bytes: `lead` for 1 byte, `lead + 1`
// for 2, `lead + 2` for 4.
effect fn sized(lead: u8, length: u64) -> ()
  ! WriterError
  ? &mut Writer {
  if length <= 255 {
    return run tagged(lead, length, 1)
  }
  if length <= 65535 {
    return run tagged(lead + 1, length, 2)
  }
  return run tagged(lead + 2, length, 4)
}

effect fn checked(length: usize) -> u64
  ! MsgpackError {
  let wide = usize.toU64(length)
  if wide > MAX_LENGTH {
    fail MsgpackError { reason: MsgpackReason.TooLong, offset: usize.ZERO }
  }
  return wide
}

impl MsgpackOutput {
  /// Writes `nil`, the byte `0xc0`.
  ///
  /// # Errors
  ///
  /// - `WriterError` if the `Writer` fails.
  pub effect fn writeNil() -> ()
    ! WriterError
    ? &mut Writer {
    return run Writer.writeAll(b"\xc0")
  }

  /// Writes `true` as the byte `0xc3`, or `false` as `0xc2`.
  ///
  /// # Errors
  ///
  /// - `WriterError` if the `Writer` fails.
  pub effect fn writeBool(value: bool) -> ()
    ! WriterError
    ? &mut Writer {
    if value {
      return run Writer.writeAll(b"\xc3")
    }
    return run Writer.writeAll(b"\xc2")
  }

  /// Writes an integer in the shortest format that holds it: one byte from 0 to 127, or
  /// `uint 8`, `uint 16`, `uint 32` or `uint 64`.
  ///
  /// # Errors
  ///
  /// - `WriterError` if the `Writer` fails.
  pub effect fn writeUnsigned(value: u64) -> ()
    ! WriterError
    ? &mut Writer {
    if value <= 127 {
      let single: [u8; 1] = [u64.toU8(value)]
      return run Writer.writeAll(&single)
    }
    if value <= 255 {
      return run tagged(204, value, 1)
    }
    if value <= 65535 {
      return run tagged(205, value, 2)
    }
    if value <= 4294967295 {
      return run tagged(206, value, 4)
    }
    return run tagged(207, value, 8)
  }

  /// Writes an integer in the shortest format that holds it.
  ///
  /// # Details
  ///
  /// A value of 0 or more is written as [`MsgpackOutput.writeUnsigned`] writes it, so the same
  /// number has the same bytes whichever function wrote it. A negative value takes one byte from
  /// -32 to -1, or `int 8`, `int 16`, `int 32` or `int 64`.
  ///
  /// # Errors
  ///
  /// - `WriterError` if the `Writer` fails.
  pub effect fn writeSigned(value: i64) -> ()
    ! WriterError
    ? &mut Writer {
    if value >= 0 {
      return run MsgpackOutput.writeUnsigned(i64.toU64(value))
    }
    let raw = i64.wrappingToU64(value)
    if value >= -32 {
      let single: [u8; 1] = [u64.wrappingToU8(raw)]
      return run Writer.writeAll(&single)
    }
    if value >= -128 {
      return run tagged(208, raw, 1)
    }
    if value >= -32768 {
      return run tagged(209, raw, 2)
    }
    if value >= -2147483648 {
      return run tagged(210, raw, 4)
    }
    return run tagged(211, raw, 8)
  }

  /// Writes a number as a `float 64`: 9 bytes, for every value including NaN and the infinities.
  ///
  /// # Errors
  ///
  /// - `WriterError` if the `Writer` fails.
  pub effect fn writeFloat(value: f64) -> ()
    ! WriterError
    ? &mut Writer {
    return run tagged(203, f64.toBits(value), 8)
  }

  /// Writes text as a MessagePack string: a `fixstr` up to 31 bytes, or `str 8`, `str 16` or
  /// `str 32`.
  ///
  /// # Errors
  ///
  /// - `MsgpackError` with `MsgpackReason.TooLong` if `value` is longer than 4294967295 bytes.
  ///   Nothing is written.
  /// - `WriterError` if the `Writer` fails.
  pub effect fn writeString(value: string) -> ()
    ! MsgpackError | WriterError
    ? &mut Writer {
    let bytes = String.utf8Bytes(value)
    let length = run checked(bytes.length)
    if length <= 31 {
      let single: [u8; 1] = [160 + u64.toU8(length)]
      run Writer.writeAll(&single)
    } else {
      run sized(217, length)
    }
    return run Writer.writeAll(bytes)
  }

  /// Writes bytes as MessagePack binary data: `bin 8`, `bin 16` or `bin 32`.
  ///
  /// # When to use
  ///
  /// Use it for data that is not text. A reader tells binary data from a string, so write text
  /// with [`MsgpackOutput.writeString`].
  ///
  /// # Errors
  ///
  /// - `MsgpackError` with `MsgpackReason.TooLong` if `value` is longer than 4294967295 bytes.
  ///   Nothing is written.
  /// - `WriterError` if the `Writer` fails.
  pub effect fn writeBinary(value: &[u8]) -> ()
    ! MsgpackError | WriterError
    ? &mut Writer {
    run sized(196, run checked(value.length))
    return run Writer.writeAll(value)
  }

  /// Writes the header of an array of `count` elements. Write exactly `count` values after it.
  ///
  /// # Errors
  ///
  /// - `MsgpackError` with `MsgpackReason.TooLong` if `count` is above 4294967295. Nothing is
  ///   written.
  /// - `WriterError` if the `Writer` fails.
  pub effect fn writeArrayHeader(count: usize) -> ()
    ! MsgpackError | WriterError
    ? &mut Writer {
    let wide = run checked(count)
    if wide <= 15 {
      let single: [u8; 1] = [144 + u64.toU8(wide)]
      return run Writer.writeAll(&single)
    }
    if wide <= 65535 {
      return run tagged(220, wide, 2)
    }
    return run tagged(221, wide, 4)
  }

  /// Writes the header of a map of `count` entries. Write exactly `count` keys after it, each
  /// followed by its value.
  ///
  /// # Errors
  ///
  /// - `MsgpackError` with `MsgpackReason.TooLong` if `count` is above 4294967295. Nothing is
  ///   written.
  /// - `WriterError` if the `Writer` fails.
  pub effect fn writeMapHeader(count: usize) -> ()
    ! MsgpackError | WriterError
    ? &mut Writer {
    let wide = run checked(count)
    if wide <= 15 {
      let single: [u8; 1] = [128 + u64.toU8(wide)]
      return run Writer.writeAll(&single)
    }
    if wide <= 65535 {
      return run tagged(222, wide, 2)
    }
    return run tagged(223, wide, 4)
  }

  /// Writes an extension value: the type `kind` and the payload `data`, which MessagePack does
  /// not interpret.
  ///
  /// # Details
  ///
  /// A payload of 1, 2, 4, 8 or 16 bytes is written as a `fixext`, any other as `ext 8`, `ext 16`
  /// or `ext 32`. Applications use the types 0 to 127; MessagePack reserves the negative ones,
  /// such as -1 for a timestamp.
  ///
  /// # Errors
  ///
  /// - `MsgpackError` with `MsgpackReason.TooLong` if `data` is longer than 4294967295 bytes.
  ///   Nothing is written.
  /// - `WriterError` if the `Writer` fails.
  pub effect fn writeExtension(kind: i8, data: &[u8]) -> ()
    ! MsgpackError | WriterError
    ? &mut Writer {
    let length = run checked(data.length)
    let fixed: u8 = if length == 1 {
      212
    } else if length == 2 {
      213
    } else if length == 4 {
      214
    } else if length == 8 {
      215
    } else if length == 16 {
      216
    } else {
      0
    }
    if fixed != 0 {
      let single: [u8; 1] = [fixed]
      run Writer.writeAll(&single)
    } else {
      run sized(199, length)
    }
    let tag: [u8; 1] = [i8.wrappingToU8(kind)]
    run Writer.writeAll(&tag)
    return run Writer.writeAll(data)
  }
}
