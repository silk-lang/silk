//! Growable lists that store each field of a struct in its own column.
//!
//! # When to use
//! Use [`ColumnList`] for many rows of a `Copy` struct when code reads or writes a few of the fields
//! at a time, such as the positions of all particles or the links between the nodes of a tree. A
//! field access touches only the bytes of that field, so a loop over two fields of a wide row loads
//! far less memory than the same loop over a slice of structs. Use
//! `silk.collections.list.List` when code handles one whole element at a time, or when the
//! elements own storage.
//!
//! # Details
//! The row type `T` is a struct or a named tuple that the caller declares. The list keeps one
//! allocation that holds every column. The columns are in order of falling alignment and then in
//! declaration order, so no column needs padding: a row of `x: f32`, `alive: bool`, `id: u64`,
//! `y: f32` is 24 bytes as a struct and 17 bytes in a `ColumnList`.
//!
//! Index a list and name a field to use one field of one row: `particles[3].x` reads it,
//! `particles[3].x = 1.0` writes it, and `&mut particles[3].x` borrows it. Fields after the first
//! one are ordinary: `particles[3].position.y` is one load from the `position` column. The index
//! is a `usize` or a `silk.collections.id.Id` of the row type. Write `..` as the index for the whole
//! column: `&particles[..].x` is a `&[f32]` with one element for each row, and
//! `&mut particles[..].x` is a `&mut [f32]`. The borrow rules apply to each column apart, so code
//! can write one column while it reads another one.
//!
//! A field that is itself a struct is one column of that struct. Put the fields that code reads
//! together in a child struct, and they are next to each other in memory.
//!
//! [`ColumnList.rows`] and [`ColumnList.rowsMut`] give the handles [`Rows`] and [`RowsMut`]. A
//! handle takes the same index forms as the list. It keeps the address of the storage by value, so
//! it is the form to use in a loop and as a parameter in place of a slice of rows.
//! [`Rows.range`] and [`RowsMut.splitAt`] give handles for a part of the rows.
//!
//! [`ColumnList.make`] does not allocate. The first growth allocates space for four rows, and each
//! later growth doubles the capacity. A growth moves every column, so a failed growth leaves the
//! list unchanged.
//!
//! # Gotchas
//! The row type must implement `Copy`, every field of it must be `pub`, and at least one field
//! must have a size. An index alone, as in `particles[3]`, is a compile error: read a whole row
//! with [`ColumnList.get`] and replace it with [`ColumnList.set`]. A row index traps if it is not
//! less than the length.
//!
//! # Examples
//! ## Read and write the fields of rows
//! ```silk
//! import silk.collections.column_list { ColumnList }
//! import silk.core.effect { Effect }
//! import silk.core.ownership { Copy }
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//!
//! struct Point {
//!   pub x: f32,
//!   pub y: f32,
//! }
//!
//! impl Copy for Point {}
//!
//! struct Particle {
//!   pub position: Point,
//!   pub speed: f32,
//!   pub alive: bool,
//! }
//!
//! impl Copy for Particle {}
//!
//! effect fn moved() -> f32
//!   ! OutOfMemoryError
//!   ? &mut Allocator {
//!   let mut particles = ColumnList<Particle>.make()
//!   run particles.append(Particle { position: Point { x: 1.0, y: 0.0 }, speed: 4.0, alive: true })
//!   run particles.append(Particle { position: Point { x: 9.0, y: 0.0 }, speed: 1.0, alive: false })
//!   let mut at: usize = 0
//!   while at < particles.length() {
//!     // Each access loads or stores one field of one row.
//!     if particles[at].alive {
//!       particles[at].position.x = particles[at].position.x + particles[at].speed * 0.5
//!     }
//!     at = at + 1
//!   }
//!   return particles[0].position.x + particles[1].position.x
//! }
//!
//! effect fn recover(error: OutOfMemoryError) -> f32 {
//!   return 0.0
//! }
//!
//! pub fn main() -> i32 {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let sum = run moved()
//!     |> Effect.provideMut<Allocator>(&mut allocator)
//!     |> Effect.catchAll(recover)
//!   if sum != 12.0 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! ## Write one column while reading another
//! ```silk
//! import silk.collections.column_list { ColumnList }
//! import silk.core.effect { Effect }
//! import silk.core.ownership { Copy }
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//!
//! struct Particle {
//!   pub x: f32,
//!   pub speed: f32,
//!   pub id: u64,
//! }
//!
//! impl Copy for Particle {}
//!
//! // The signature states which column the function writes and which one it reads.
//! fn advance(x: &mut [f32], speed: &[f32], seconds: f32) -> () {
//!   let mut at: usize = 0
//!   while at < x.length {
//!     x[at] = x[at] + speed[at] * seconds
//!     at = at + 1
//!   }
//!   return ()
//! }
//!
//! effect fn moved() -> f32
//!   ! OutOfMemoryError
//!   ? &mut Allocator {
//!   let mut particles = ColumnList<Particle>.make()
//!   run particles.append(Particle { x: 1.0, speed: 4.0, id: 1 })
//!   // `..` stands for every row. The two borrows are of different columns.
//!   advance(&mut particles[..].x, &particles[..].speed, 0.5)
//!   return particles[0].x
//! }
//!
//! effect fn recover(error: OutOfMemoryError) -> f32 {
//!   return 0.0
//! }
//!
//! pub fn main() -> i32 {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let x = run moved()
//!     |> Effect.provideMut<Allocator>(&mut allocator)
//!     |> Effect.catchAll(recover)
//!   if x != 3.0 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! ## Pass a part of the rows to a function
//! ```silk
//! import silk.collections.column_list { ColumnList, RowsMut }
//! import silk.core.effect { Effect }
//! import silk.core.ownership { Copy }
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//!
//! struct Cell {
//!   pub width: u32,
//!   pub offset: u32,
//! }
//!
//! impl Copy for Cell {}
//!
//! // The function takes a handle in place of a `&mut [Cell]`. Its indexes start at the first row
//! // of the handle.
//! fn place(cells: RowsMut<'_, Cell>) -> () {
//!   let mut cells = move cells
//!   let mut offset: u32 = 0
//!   let mut at: usize = 0
//!   while at < cells.length() {
//!     cells[at].offset = offset
//!     offset = offset + cells[at].width
//!     at = at + 1
//!   }
//!   return ()
//! }
//!
//! effect fn placed() -> u32
//!   ! OutOfMemoryError
//!   ? &mut Allocator {
//!   let mut cells = ColumnList<Cell>.make()
//!   run cells.appendRepeated(Cell { width: 10, offset: 0 }, 4)
//!   let mut all = cells.rowsMut()
//!   place(all.range(1, 4))
//!   return cells[3].offset
//! }
//!
//! effect fn recover(error: OutOfMemoryError) -> u32 {
//!   return 0
//! }
//!
//! pub fn main() -> i32 {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let offset = run placed()
//!     |> Effect.provideMut<Allocator>(&mut allocator)
//!     |> Effect.catchAll(recover)
//!   if offset != 20 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Collections

// A struct-of-arrays list over the allocation substrate. Ordinary Silk: no compiler phase knows
// this type. The compiler turns `rows[i].field` and `rows[..].field` into calls of the sealed
// `Intrinsic.Rows` and `Intrinsic.RowsMut` operations, which this module implements for the list
// and its handles. The list is one byte buffer, a row count and a row capacity for every `T`. The
// byte offset of a column is `capacity * bytesBefore(field)`, and `bytesBefore` is static, so the
// list stores no pointer per column and a field access is one multiply and one add.
//
// Rows are `Copy`, so no slot ever needs a drop: removing rows only lowers the count, and dropping
// the list is the buffer's own release.

import silk.collections.id { Id }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.order { Order }
import silk.core.ownership { Copy }
import silk.core.reflect { Reflect, labeledFieldKind, namedKind, positionalKind }
import silk.core.static_text { StaticText }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.layout { Layout }
import silk.mem.pointer { Pointer }
import silk.mem.raw_buffer { RawBuffer }
import silk.num.u32
import silk.num.usize

/// A growable list of `T` rows that stores each field of `T` in its own column.
///
/// # Details
///
/// The length is the number of rows. The capacity is the number of rows that fit before the next
/// growth. All columns live in one allocation, in order of falling alignment and then in
/// declaration order, with no padding between or inside them. Dropping the list releases the
/// allocation. A list is affine.
///
/// `list[i].field` is one field of one row, where `i` is a `usize` or an `Id<T>`, and
/// `list[..].field` is that field of every row as a slice.
///
/// # Gotchas
///
/// `T` must implement `Copy`, every field of `T` must be `pub`, and at least one field must have a
/// size. A field that is itself a struct is one column of that struct.
pub struct ColumnList<T> {
  bytes: Intrinsic.RawBuffer<u8>,
  count: usize,
  limit: usize,
}

/// A shared handle for a run of the rows of a [`ColumnList`], borrowed for `'a`.
///
/// # When to use
///
/// Use it where slice-of-struct code has a `&[T]`: as a parameter, and for the rows that a loop
/// reads. Get one from [`ColumnList.rows`], and a part of one from [`Rows.range`].
///
/// # Details
///
/// `rows[i].field` reads one field of one row, and `&rows[..].field` is that field of every row of
/// the handle as a slice. A `usize` index counts from the first row of the handle. An `Id<T>`
/// index is the row's number in the list, whichever rows the handle has. A handle is `Copy`. It
/// keeps the address of the storage by value, so a loop does not load it again from the list.
///
/// # Gotchas
///
/// A row index traps if it names a row outside the handle. The list cannot change while a handle
/// is live.
pub struct Rows<'a, T> {
  mark: &'a Mark,
  base: [*]const u8,
  limit: usize,
  first: usize,
  count: usize,
}

impl<'a, T> Copy for Rows<'a, T> {}

/// An exclusive handle for a run of the rows of a [`ColumnList`], borrowed for `'a`.
///
/// # When to use
///
/// Use it where slice-of-struct code has a `&mut [T]`: as a parameter, and for the rows that a
/// loop writes. Get one from [`ColumnList.rowsMut`]. [`RowsMut.range`] lends a part of the rows,
/// and [`RowsMut.splitAt`] cuts the handle into two handles that code can write at the same time.
///
/// # Details
///
/// `rows[i].field` is one field of one row for reading and writing, and `&mut rows[..].field` is
/// that field of every row of the handle as a slice. A `usize` index counts from the first row of
/// the handle. An `Id<T>` index is the row's number in the list, whichever rows the handle has.
/// The handle keeps the address of the storage by value, so a loop does not load it again after
/// each store.
///
/// # Gotchas
///
/// A row index traps if it names a row outside the handle. The handle cannot add or remove rows,
/// and the list cannot be used while the handle is live.
pub struct RowsMut<'a, T> {
  mark: &'a mut Mark,
  base: [*]mut u8,
  limit: usize,
  first: usize,
  count: usize,
}

/// The two handles that [`RowsMut.splitAt`] returns: the rows before the cut and the rows from it.
pub struct RowsPair<'a, T> {
  /// The rows before the cut.
  pub left: RowsMut<'a, T>,
  /// The rows from the cut to the end.
  pub right: RowsMut<'a, T>,
}

/// The working storage of [`ColumnList.sortBy`].
///
/// # When to use
///
/// Make one with [`ColumnSort.make`] and pass it to each sort. It keeps its storage between calls,
/// so a sort allocates only when the list has more rows than any list it sorted before.
pub struct ColumnSort {
  order: List<u32>,
  spare: List<u32>,
}

impl ColumnSort {
  /// Returns working storage that holds nothing. This function does not allocate.
  pub fn make() -> ColumnSort {
    return ColumnSort { order: List<u32>.make(), spare: List<u32>.make() }
  }
}

impl<T: Copy> ColumnList<T> {
  /// Returns an empty list. This function does not allocate.
  pub fn make() -> ColumnList<T> {
    static if !validRow<T>() {
      compileError("the row type of a ColumnList is a struct or named tuple with a sized field")
    }
    return ColumnList<T> {
      bytes: Intrinsic.rawBufferEmpty<u8>(),
      count: usize.ZERO,
      limit: usize.ZERO,
    }
  }

  /// Returns an empty list with storage for exactly `capacity` rows.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the size of `capacity` rows overflows, or the `Allocator` cannot
  ///   supply the storage.
  pub effect fn makeWithCapacity(capacity: usize) -> ColumnList<T>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut list = ColumnList<T>.make()
    if capacity != usize.ZERO {
      run regrow<T>(&mut list, capacity, false)
    }
    return move list
  }

  /// Returns the number of rows in the list.
  pub fn length(self: &Self) -> usize {
    return self.count
  }

  /// Returns the number of rows that fit in the current storage before the next growth.
  pub fn capacity(self: &Self) -> usize {
    return self.limit
  }

  /// Returns a shared handle for all rows of the list.
  ///
  /// # When to use
  ///
  /// Use the handle in a loop that reads fields, and pass it to a function that would take a
  /// `&[T]` of a slice of structs. `rows[i].field` on the handle does not load the address of the
  /// storage from the list each time.
  pub fn rows<'s>(self: &'s Self) -> Rows<'s, T> {
    unsafe {
      return Rows<'s, T> {
        mark: markOf<'s, Self>(self),
        base: bufferStart(&self.bytes),
        limit: self.limit,
        first: usize.ZERO,
        count: self.count,
      }
    }
  }

  /// Returns an exclusive handle for all rows of the list.
  ///
  /// # When to use
  ///
  /// Use the handle in a loop that writes fields, and pass it to a function that would take a
  /// `&mut [T]` of a slice of structs. The handle keeps the address of the storage by value. A
  /// loop through `&mut ColumnList` can load it from the list again after each store.
  ///
  /// # Gotchas
  ///
  /// The list cannot be used while the handle is live, and the handle cannot add or remove rows.
  pub fn rowsMut<'s>(self: &'s mut Self) -> RowsMut<'s, T> {
    unsafe {
      let limit = self.limit
      let count = self.count
      let base = bufferStartMut(&mut self.bytes)
      return RowsMut<'s, T> {
        mark: markOfMut<'s, Self>(move self),
        base: base,
        limit: limit,
        first: usize.ZERO,
        count: count,
      }
    }
  }

  /// Returns a copy of the row at `index`.
  ///
  /// # When to use
  ///
  /// Use `get` when code needs every field of one row. It reads each column once. To read one
  /// field, write `list[index].field`.
  ///
  /// # Gotchas
  ///
  /// It traps if `index` is not less than the length.
  pub fn get(self: &Self, index: usize) -> T {
    if index >= self.count {
      return Intrinsic.trap("ColumnList.get: the index is not less than the length")
    }
    unsafe {
      return rowAt<T>(bufferStart(&self.bytes), self.limit, index)
    }
  }

  /// Replaces the row at `index` with `row`.
  ///
  /// # Gotchas
  ///
  /// It traps if `index` is not less than the length.
  pub fn set(self: &mut Self, index: usize, row: T) -> () {
    if index >= self.count {
      return Intrinsic.trap("ColumnList.set: the index is not less than the length")
    }
    let limit = self.limit
    unsafe {
      putRow<T>(bufferStartMut(&mut self.bytes), limit, index, &row)
    }
    return ()
  }

  /// Adds `row` at the end of the list.
  ///
  /// # Details
  ///
  /// If the list is full, it grows: the first growth allocates space for four rows, and each
  /// later growth doubles the capacity.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the new storage. The list does not
  ///   change.
  pub effect fn append(self: &mut Self, row: T) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.count == self.limit {
      run growFor<T>(&mut self.*, usize.ONE)
    }
    let limit = self.limit
    let index = self.count
    unsafe {
      putRow<T>(bufferStartMut(&mut self.bytes), limit, index, &row)
    }
    self.count = index + usize.ONE
    return ()
  }

  /// Adds `row` at the end of the list and returns the id of the new row.
  ///
  /// # When to use
  ///
  /// Use it when other rows store a link to the new row as an `Id<T>`.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the new storage. The list does not
  ///   change.
  ///
  /// # Gotchas
  ///
  /// It traps if the list already has 4,294,967,295 rows, because an `Id` cannot name the next
  /// one.
  pub effect fn appendId(self: &mut Self, row: T) -> Id<T>
    ! OutOfMemoryError
    ? &mut Allocator {
    let id = Id<T>.fromIndex(self.count)
    run ColumnList<T>.append(&mut self.*, row)
    return id
  }

  /// Adds `row` at the end of the list if the list is not full. Returns `true` if it added the
  /// row.
  ///
  /// # When to use
  ///
  /// Use it after [`ColumnList.reserve`] in code that must not allocate or fail.
  pub fn appendWithinCapacity(self: &mut Self, row: T) -> bool {
    if self.count == self.limit {
      return false
    }
    let limit = self.limit
    let index = self.count
    unsafe {
      putRow<T>(bufferStartMut(&mut self.bytes), limit, index, &row)
    }
    self.count = index + usize.ONE
    return true
  }

  /// Adds a copy of each row of `source` at the end of the list, in order.
  ///
  /// # Details
  ///
  /// `source` is a handle for rows of another list. For rows `a` to `b` of that list, pass
  /// `other.rows().range(a, b)`. It copies one column at a time.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the row count overflows, or the `Allocator` cannot supply the new
  ///   storage. The list does not change.
  pub effect fn appendSlice(self: &mut Self, source: Rows<'_, T>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let added = source.count
    if self.limit - self.count < added {
      run growFor<T>(&mut self.*, added)
    }
    let limit = self.limit
    let count = self.count
    copyRowsIn<T>(&mut self.bytes, limit, count, source)
    self.count = count + added
    return ()
  }

  /// Adds `count` copies of `row` at the end of the list.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the row count overflows, or the `Allocator` cannot supply the new
  ///   storage. The list does not change.
  pub effect fn appendRepeated(self: &mut Self, row: T, count: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.limit - self.count < count {
      run growFor<T>(&mut self.*, count)
    }
    let limit = self.limit
    let length = self.count
    unsafe {
      fillRows<T>(bufferStartMut(&mut self.bytes), limit, length, count, &row)
    }
    self.count = length + count
    return ()
  }

  /// Inserts `row` at `index` and moves the rows from `index` up by one.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the new storage. The list does not
  ///   change.
  ///
  /// # Gotchas
  ///
  /// It traps if `index` is more than the length.
  pub effect fn insert(self: &mut Self, index: usize, row: T) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if index > self.count {
      return Intrinsic.trap("ColumnList.insert: the index is more than the length")
    }
    if self.count == self.limit {
      run growFor<T>(&mut self.*, usize.ONE)
    }
    let limit = self.limit
    let count = self.count
    moveRows<T>(&mut self.bytes, limit, index, index + usize.ONE, count - index)
    unsafe {
      putRow<T>(bufferStartMut(&mut self.bytes), limit, index, &row)
    }
    self.count = count + usize.ONE
    return ()
  }

  /// Inserts a copy of each row of `source` at `index`, in order, and moves the rows from `index`
  /// up.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the row count overflows, or the `Allocator` cannot supply the new
  ///   storage. The list does not change.
  ///
  /// # Gotchas
  ///
  /// It traps if `index` is more than the length.
  pub effect fn insertSlice(self: &mut Self, index: usize, source: Rows<'_, T>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if index > self.count {
      return Intrinsic.trap("ColumnList.insertSlice: the index is more than the length")
    }
    let added = source.count
    if self.limit - self.count < added {
      run growFor<T>(&mut self.*, added)
    }
    let limit = self.limit
    let count = self.count
    moveRows<T>(&mut self.bytes, limit, index, index + added, count - index)
    copyRowsIn<T>(&mut self.bytes, limit, index, source)
    self.count = count + added
    return ()
  }

  /// Inserts `count` copies of `row` at `index` and moves the rows from `index` up.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the row count overflows, or the `Allocator` cannot supply the new
  ///   storage. The list does not change.
  ///
  /// # Gotchas
  ///
  /// It traps if `index` is more than the length.
  pub effect fn insertRepeated(self: &mut Self, index: usize, row: T, count: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if index > self.count {
      return Intrinsic.trap("ColumnList.insertRepeated: the index is more than the length")
    }
    if self.limit - self.count < count {
      run growFor<T>(&mut self.*, count)
    }
    let limit = self.limit
    let length = self.count
    moveRows<T>(&mut self.bytes, limit, index, index + count, length - index)
    unsafe {
      fillRows<T>(bufferStartMut(&mut self.bytes), limit, index, count, &row)
    }
    self.count = length + count
    return ()
  }

  /// Removes the last row and returns it, or none if the list is empty.
  pub fn pop(self: &mut Self) -> Option<T> {
    if self.count == usize.ZERO {
      return Option<T>.none()
    }
    let index = self.count - usize.ONE
    let mut row = Option<T>.none()
    unsafe {
      row = Option<T>.some(rowAt<T>(bufferStart(&self.bytes), self.limit, index))
    }
    self.count = index
    return row
  }

  /// Removes the row at `index`, moves the later rows down by one, and returns the removed row.
  ///
  /// # When to use
  ///
  /// Use `remove` when the order of the rows matters. [`ColumnList.swapRemove`] moves only one row,
  /// but it changes the order.
  ///
  /// # Gotchas
  ///
  /// It traps if `index` is not less than the length.
  pub fn remove(self: &mut Self, index: usize) -> T {
    if index >= self.count {
      return Intrinsic.trap("ColumnList.remove: the index is not less than the length")
    }
    let limit = self.limit
    let count = self.count
    let row = ColumnList<T>.get(&self.*, index)
    moveRows<T>(&mut self.bytes, limit, index + usize.ONE, index, count - index - usize.ONE)
    self.count = count - usize.ONE
    return row
  }

  /// Removes the row at `index`, puts the last row in its place, and returns the removed row.
  ///
  /// # Details
  ///
  /// It moves one row whatever the length is, but it changes the order of the rows.
  ///
  /// # Gotchas
  ///
  /// It traps if `index` is not less than the length.
  pub fn swapRemove(self: &mut Self, index: usize) -> T {
    if index >= self.count {
      return Intrinsic.trap("ColumnList.swapRemove: the index is not less than the length")
    }
    let limit = self.limit
    let last = self.count - usize.ONE
    let row = ColumnList<T>.get(&self.*, index)
    if index != last {
      let moved = ColumnList<T>.get(&self.*, last)
      unsafe {
        putRow<T>(bufferStartMut(&mut self.bytes), limit, index, &moved)
      }
    }
    self.count = last
    return row
  }

  /// Removes the rows from `start` up to but not including `end`, and moves the later rows down.
  ///
  /// # Gotchas
  ///
  /// It traps if `start` is more than `end`, or `end` is more than the length.
  pub fn removeRange(self: &mut Self, start: usize, end: usize) -> () {
    if start > end || end > self.count {
      return Intrinsic.trap("ColumnList.removeRange: the range is not inside the list")
    }
    let limit = self.limit
    let count = self.count
    moveRows<T>(&mut self.bytes, limit, end, start, count - end)
    self.count = count - (end - start)
    return ()
  }

  /// Copies the `count` rows that start at `from` over the `count` rows that start at `to`.
  ///
  /// # Details
  ///
  /// The two runs of rows can overlap: each target row gets the value that its source row had
  /// before the call. The length does not change, and rows outside the target run keep their
  /// values. It moves one column at a time.
  ///
  /// # Gotchas
  ///
  /// It traps if either run of rows goes past the length.
  pub fn moveRange(self: &mut Self, from: usize, to: usize, count: usize) -> () {
    if !insideLength(from, count, self.count) || !insideLength(to, count, self.count) {
      return Intrinsic.trap("ColumnList.moveRange: a range is not inside the list")
    }
    let limit = self.limit
    moveRows<T>(&mut self.bytes, limit, from, to, count)
    return ()
  }

  /// Removes the rows from `at` to the end and returns them as a new list.
  ///
  /// # Details
  ///
  /// The new list has storage for exactly the rows it holds. This list keeps its capacity.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the storage of the new list. This list
  ///   does not change.
  ///
  /// # Gotchas
  ///
  /// It traps if `at` is more than the length.
  pub effect fn splitOff(self: &mut Self, at: usize) -> ColumnList<T>
    ! OutOfMemoryError
    ? &mut Allocator {
    if at > self.count {
      return Intrinsic.trap("ColumnList.splitOff: the index is more than the length")
    }
    let moved = self.count - at
    let mut tail = run ColumnList<T>.makeWithCapacity(moved)
    let rows = ColumnList<T>.rows(&self.*)
    copyRowsIn<T>(&mut tail.bytes, moved, usize.ZERO, Rows<'_, T>.range(rows, at, at + moved))
    tail.count = moved
    self.count = at
    return move tail
  }

  /// Sorts the rows by the field `key`, from the least value to the greatest.
  ///
  /// # Details
  ///
  /// `key` is a static argument. Write the field's name as a string literal, as in
  /// `nodes.sortBy("depth", &mut scratch)`. The type of the field must implement `Order`. The sort
  /// is stable: rows with equal keys keep their order. It orders the row numbers by the key
  /// column, then moves one column at a time. `scratch` holds the row numbers. It keeps its
  /// storage, so a later sort of a list that is not longer does not allocate.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the storage of `scratch`. The list does
  ///   not change.
  ///
  /// # Gotchas
  ///
  /// It traps if the list has more than 4,294,967,295 rows. An `Id<T>` that named a row names
  /// another row after the sort.
  ///
  /// # Examples
  ///
  /// ## Sort rows by one field
  ///
  /// ```silk
  /// import silk.collections.column_list { ColumnList, ColumnSort }
  /// import silk.core.effect { Effect }
  /// import silk.core.ownership { Copy }
  /// import silk.mem.allocator { Allocator, OutOfMemoryError }
  ///
  /// struct Task {
  ///   pub priority: u32,
  ///   pub id: u64,
  /// }
  ///
  /// impl Copy for Task {}
  ///
  /// effect fn first() -> u64
  ///   ! OutOfMemoryError
  ///   ? &mut Allocator {
  ///   let mut tasks = ColumnList<Task>.make()
  ///   run tasks.append(Task { priority: 3, id: 10 })
  ///   run tasks.append(Task { priority: 1, id: 11 })
  ///   run tasks.append(Task { priority: 2, id: 12 })
  ///   // Keep the scratch and pass it to later sorts.
  ///   let mut scratch = ColumnSort.make()
  ///   run tasks.sortBy("priority", &mut scratch)
  ///   return tasks[0].id
  /// }
  ///
  /// effect fn recover(error: OutOfMemoryError) -> u64 {
  ///   return 0
  /// }
  ///
  /// pub fn main() -> i32 {
  ///   let mut allocator = Allocator.systemAllocatorProvider()
  ///   let id = run first()
  ///     |> Effect.provideMut<Allocator>(&mut allocator)
  ///     |> Effect.catchAll(recover)
  ///   if id != 11 {
  ///     return 1
  ///   }
  ///   return 0
  /// }
  /// ```
  pub effect fn sortBy<K: Order>(
    self: &mut Self,
    static key: Intrinsic.Field<T, K>,
    scratch: &mut ColumnSort,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let count = self.count
    if count <= usize.ONE {
      return ()
    }
    if count > u32.toUsize(u32.MAX) {
      return Intrinsic.trap("ColumnList.sortBy: the list has more rows than a sort can number")
    }
    run prepareSort(&mut scratch.*, count)
    let limit = self.limit
    unsafe {
      let keys = lendMany<Self, T, K>(
        &self.*,
        bufferStart(&self.bytes),
        limit,
        usize.ZERO,
        count,
        key,
      )
      orderRows<K>(
        keys,
        List<u32>.asMutSlice(&mut scratch.order),
        List<u32>.asMutSlice(&mut scratch.spare),
      )
    }
    unsafe {
      let base = bufferStartMut(&mut self.bytes)
      static for field in Reflect.fields<T>() {
        placeColumn<T>(
          base,
          limit,
          count,
          field,
          List<u32>.asSlice(&scratch.order),
          List<u32>.asMutSlice(&mut scratch.spare),
        )
      }
    }
    return ()
  }

  /// Removes all rows and keeps the capacity.
  pub fn clear(self: &mut Self) -> () {
    self.count = usize.ZERO
    return ()
  }

  /// Removes all rows and releases the storage. The capacity becomes zero.
  pub fn clearAndFree(self: &mut Self) -> () {
    let old = Intrinsic.replace(self.bytes, Intrinsic.rawBufferEmpty<u8>())
    drop old
    self.count = usize.ZERO
    self.limit = usize.ZERO
    return ()
  }

  /// Removes the rows from `length` to the end and keeps the capacity. It does nothing if
  /// `length` is not less than the current length.
  pub fn truncate(self: &mut Self, length: usize) -> () {
    if length < self.count {
      self.count = length
    }
    return ()
  }

  /// Makes room for at least `additional` more rows.
  ///
  /// # Details
  ///
  /// It can take more room than it needs, so that a series of appends grows the list few times.
  /// Use [`ColumnList.reserveExact`] for an exact capacity.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the row count overflows, or the `Allocator` cannot supply the
  ///   storage. The list does not change.
  pub effect fn reserve(self: &mut Self, additional: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.limit - self.count < additional {
      run growFor<T>(&mut self.*, additional)
    }
    return ()
  }

  /// Makes room for exactly `additional` more rows if the list has less room than that.
  ///
  /// # When to use
  ///
  /// Use it when the final number of rows is known. [`ColumnList.reserve`] is the better choice
  /// before a series of appends of unknown length.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the row count overflows, or the `Allocator` cannot supply the
  ///   storage. The list does not change.
  pub effect fn reserveExact(self: &mut Self, additional: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.limit - self.count < additional {
      let needed = match move usize.checkedAdd(self.count, additional) {
        Option<usize>.Some { value } => value
        Option<usize>.None => run Allocator.outOfMemory()
      }
      run regrow<T>(&mut self.*, needed, false)
    }
    return ()
  }

  /// Releases the capacity beyond the length.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the smaller storage. The list does not
  ///   change.
  pub effect fn shrinkToFit(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.count == self.limit {
      return ()
    }
    if self.count == usize.ZERO {
      let old = Intrinsic.replace(self.bytes, Intrinsic.rawBufferEmpty<u8>())
      drop old
      self.limit = usize.ZERO
      return ()
    }
    let count = self.count
    return run regrow<T>(&mut self.*, count, false)
  }
}

impl<'a, T: Copy> Rows<'a, T> {
  /// Returns the number of rows of the handle.
  pub fn length(self: Self) -> usize {
    return self.count
  }

  /// Returns a handle for the rows from `start` up to but not including `end`.
  ///
  /// # Details
  ///
  /// `start` and `end` count from the first row of this handle. In the new handle a `usize` index
  /// counts from `start`, and an `Id<T>` index stays the row's number in the list.
  ///
  /// # Gotchas
  ///
  /// It traps if `start` is more than `end`, or `end` is more than the length.
  pub fn range(self: Self, start: usize, end: usize) -> Rows<'a, T> {
    if start > end || end > self.count {
      return Intrinsic.trap("Rows.range: the range is not inside the rows")
    }
    return Rows<'a, T> {
      mark: self.mark,
      base: self.base,
      limit: self.limit,
      first: self.first + start,
      count: end - start,
    }
  }

  /// Returns a copy of the row at `index`, which counts from the first row of the handle.
  ///
  /// # Gotchas
  ///
  /// It traps if `index` is not less than the length.
  pub fn get(self: Self, index: usize) -> T {
    if index >= self.count {
      return Intrinsic.trap("Rows.get: the index is not less than the length")
    }
    unsafe {
      return rowAt<T>(self.base, self.limit, self.first + index)
    }
  }
}

impl<'a, T: Copy> RowsMut<'a, T> {
  /// Returns the number of rows of the handle.
  pub fn length(self: &Self) -> usize {
    return self.count
  }

  /// Returns a shared handle for the same rows, for as long as this handle is borrowed.
  pub fn rows<'s>(self: &'s Self) -> Rows<'s, T> {
    return Rows<'s, T> {
      mark: &self.mark.*,
      base: readable(self.base),
      limit: self.limit,
      first: self.first,
      count: self.count,
    }
  }

  /// Returns an exclusive handle for the rows from `start` up to but not including `end`, for as
  /// long as this handle is borrowed.
  ///
  /// # Details
  ///
  /// `start` and `end` count from the first row of this handle. In the new handle a `usize` index
  /// counts from `start`, and an `Id<T>` index stays the row's number in the list.
  ///
  /// # Gotchas
  ///
  /// It traps if `start` is more than `end`, or `end` is more than the length.
  pub fn range<'s>(self: &'s mut Self, start: usize, end: usize) -> RowsMut<'s, T> {
    if start > end || end > self.count {
      return Intrinsic.trap("RowsMut.range: the range is not inside the rows")
    }
    let base = self.base
    let limit = self.limit
    let first = self.first + start
    return RowsMut<'s, T> {
      mark: &mut self.mark.*,
      base: base,
      limit: limit,
      first: first,
      count: end - start,
    }
  }

  /// Cuts the handle into a handle for the rows before `at` and a handle for the rows from `at`.
  ///
  /// # When to use
  ///
  /// Use it to write two runs of rows at the same time, such as two halves that two functions
  /// fill.
  ///
  /// # Gotchas
  ///
  /// It traps if `at` is more than the length.
  ///
  /// # Examples
  ///
  /// ## Write two parts of the rows through two handles
  ///
  /// ```silk
  /// import silk.collections.column_list { ColumnList }
  /// import silk.core.effect { Effect }
  /// import silk.core.ownership { Copy }
  /// import silk.mem.allocator { Allocator, OutOfMemoryError }
  ///
  /// struct Cell {
  ///   pub value: u32,
  /// }
  ///
  /// impl Copy for Cell {}
  ///
  /// effect fn sum() -> u32
  ///   ! OutOfMemoryError
  ///   ? &mut Allocator {
  ///   let mut cells = ColumnList<Cell>.make()
  ///   run cells.appendRepeated(Cell { value: 0 }, 4)
  ///   let pair = cells.rowsMut().splitAt(1)
  ///   let mut head = move pair.left
  ///   let mut tail = move pair.right
  ///   // Both handles are live. Each index counts from the first row of its handle.
  ///   head[0].value = 1
  ///   tail[0].value = 20
  ///   tail[2].value = 300
  ///   return cells[0].value + cells[1].value + cells[3].value
  /// }
  ///
  /// effect fn recover(error: OutOfMemoryError) -> u32 {
  ///   return 0
  /// }
  ///
  /// pub fn main() -> i32 {
  ///   let mut allocator = Allocator.systemAllocatorProvider()
  ///   let total = run sum()
  ///     |> Effect.provideMut<Allocator>(&mut allocator)
  ///     |> Effect.catchAll(recover)
  ///   if total != 321 {
  ///     return 1
  ///   }
  ///   return 0
  /// }
  /// ```
  pub fn splitAt(self: Self, at: usize) -> RowsPair<'a, T> {
    if at > self.count {
      return Intrinsic.trap("RowsMut.splitAt: the index is more than the length")
    }
    let RowsMut<'a, T> { mark, base, limit, first, count } = move self
    unsafe {
      let both = splitMark<'a>(move mark)
      return RowsPair<'a, T> {
        left: RowsMut<'a, T> {
          mark: &mut both.here,
          base: base,
          limit: limit,
          first: first,
          count: at,
        },
        right: RowsMut<'a, T> {
          mark: &mut both.rest,
          base: base,
          limit: limit,
          first: first + at,
          count: count - at,
        },
      }
    }
  }

  /// Returns a copy of the row at `index`, which counts from the first row of the handle.
  ///
  /// # Gotchas
  ///
  /// It traps if `index` is not less than the length.
  pub fn get(self: &Self, index: usize) -> T {
    if index >= self.count {
      return Intrinsic.trap("RowsMut.get: the index is not less than the length")
    }
    unsafe {
      return rowAt<T>(readable(self.base), self.limit, self.first + index)
    }
  }

  /// Replaces the row at `index`, which counts from the first row of the handle, with `row`.
  ///
  /// # Gotchas
  ///
  /// It traps if `index` is not less than the length.
  pub fn set(self: &mut Self, index: usize, row: T) -> () {
    if index >= self.count {
      return Intrinsic.trap("RowsMut.set: the index is not less than the length")
    }
    unsafe {
      putRow<T>(self.base, self.limit, self.first + index, &row)
    }
    return ()
  }
}

// `list[index].field` and `list[..].field` (INDEX-002). Each operation checks the row and lends
// one address or one slice inside the column of `field`. Two different fields never share bytes.

impl<T: Copy> Intrinsic.Rows<usize, T> for ColumnList<T> {
  @inlineAlways
  fn borrow<'s, V>(self: &'s Self, index: usize, static field: Intrinsic.Field<T, V>) -> &'s V {
    if index >= self.count {
      return Intrinsic.trap("ColumnList: the row index is not less than the length")
    }
    unsafe {
      return lend<Self, T, V>(self, bufferStart(&self.bytes), self.limit, index, field)
    }
  }

  @inlineAlways
  fn span<'s, V>(self: &'s Self, static field: Intrinsic.Field<T, V>) -> &'s [V] {
    unsafe {
      return lendMany<Self, T, V>(
        self,
        bufferStart(&self.bytes),
        self.limit,
        usize.ZERO,
        self.count,
        field,
      )
    }
  }
}

impl<T: Copy> Intrinsic.RowsMut<usize, T> for ColumnList<T> {
  @inlineAlways
  fn borrowMut<'s, V>(
    self: &'s mut Self,
    index: usize,
    static field: Intrinsic.Field<T, V>,
  ) -> &'s mut V {
    if index >= self.count {
      return Intrinsic.trap("ColumnList: the row index is not less than the length")
    }
    let limit = self.limit
    unsafe {
      let base = bufferStartMut(&mut self.bytes)
      return lendMut<Self, T, V>(move self, base, limit, index, field)
    }
  }

  @inlineAlways
  fn spanMut<'s, V>(self: &'s mut Self, static field: Intrinsic.Field<T, V>) -> &'s mut [V] {
    let limit = self.limit
    let count = self.count
    unsafe {
      let base = bufferStartMut(&mut self.bytes)
      return lendManyMut<Self, T, V>(move self, base, limit, usize.ZERO, count, field)
    }
  }
}

impl<T: Copy> Intrinsic.Rows<Id<T>, T> for ColumnList<T> {
  @inlineAlways
  fn borrow<'s, V>(self: &'s Self, index: Id<T>, static field: Intrinsic.Field<T, V>) -> &'s V {
    let row = Id<T>.index(index)
    if row >= self.count {
      return Intrinsic.trap("ColumnList: the row id is not the id of a row")
    }
    unsafe {
      return lend<Self, T, V>(self, bufferStart(&self.bytes), self.limit, row, field)
    }
  }

  @inlineAlways
  fn span<'s, V>(self: &'s Self, static field: Intrinsic.Field<T, V>) -> &'s [V] {
    unsafe {
      return lendMany<Self, T, V>(
        self,
        bufferStart(&self.bytes),
        self.limit,
        usize.ZERO,
        self.count,
        field,
      )
    }
  }
}

