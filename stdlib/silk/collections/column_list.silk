      return lendManyMut<Self, T, V>(move self, base, limit, first, count, field)
    }
  }
}

// Whether `T` can be a row: a declared struct or named tuple whose fields are all visible here and
// have a size between them. A field that is not `pub` is refused at its declaration.
static fn validRow<T>() -> bool {
  let kind = Reflect.typeKind<T>(Reflect.typeOf<T>())
  if kind != namedKind && kind != positionalKind {
    return false
  }
  let hidden = Reflect.privateField<T>()
  if StaticText.byteLength(hidden) != usize.ZERO {
    let mut text = StaticText.concat(
      "a ColumnList stores every field in its own column, so `",
      hidden,
    )
    text = StaticText.concat(text, "` must be `pub`")
    StaticText.errorAt(hidden, usize.ZERO, StaticText.byteLength(hidden), text)
  }
  return rowBytes<T>() != usize.ZERO
}

static fn bytesOf<T, V>(field: Intrinsic.Field<T, V>) -> usize {
  return Layout.of<V>().bytes
}

static fn alignmentOf<T, V>(field: Intrinsic.Field<T, V>) -> usize {
  return Layout.of<V>().alignment
}

// Whether two descriptors of `T` describe the same field: the same name, or the same position in
// a named tuple.
static fn sameField<T, A, B>(left: Intrinsic.Field<T, A>, right: Intrinsic.Field<T, B>) -> bool {
  if Reflect.fieldKind<T, A>(left) == labeledFieldKind {
    return Reflect.fieldLabel<T, A>(left) == Reflect.fieldLabel<T, B>(right)
  }
  return Reflect.fieldOrdinal<T, A>(left) == Reflect.fieldOrdinal<T, B>(right)
}

// The bytes of one row: the sum of the field sizes, with no padding.
static fn rowBytes<T>() -> usize {
  let mut total: usize = 0
  static for field in Reflect.fields<T>() {
    total = total + bytesOf(field)
  }
  return total
}

// The alignment of the allocation: the largest field alignment.
static fn rowAlignment<T>() -> usize {
  let mut most: usize = 1
  static for field in Reflect.fields<T>() {
    if alignmentOf(field) > most {
      most = alignmentOf(field)
    }
  }
  return most
}

// The bytes of one row that are stored in front of the column of `target`. Columns are in order of
// falling alignment and then in declaration order. Each field size is a multiple of its alignment,
// so `capacity * bytesBefore(target)` is aligned for `target`.
static fn bytesBefore<T, V>(target: Intrinsic.Field<T, V>) -> usize {
  let mut total: usize = 0
  let mut seen = false
  static for field in Reflect.fields<T>() {
    if sameField(field, target) {
      seen = true
    } else {
      if alignmentOf(field) > alignmentOf(target)
        || (alignmentOf(field) == alignmentOf(target) && !seen) {
        total = total + bytesOf(field)
      }
    }
  }
  return total
}

// Whether the `count` rows from `start` are inside a list of `length` rows.
fn insideLength(start: usize, count: usize, length: usize) -> bool {
  return start <= length && count <= length - start
}

// The first byte of the buffer, for reads. The buffer of an empty list owns no storage; its null
// base is never read, because the count is zero.
@inlineAlways
unsafe fn bufferStart(bytes: &Intrinsic.RawBuffer<u8>) -> [*]const u8 {
  unsafe {
    let start = Intrinsic.pointerFromSlice<u8>(
      Intrinsic.rawBufferView<u8>(bytes, usize.ZERO, usize.ZERO),
    )
    return Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(start)
  }
}

// The first byte of the buffer, for writes.
@inlineAlways
unsafe fn bufferStartMut(bytes: &mut Intrinsic.RawBuffer<u8>) -> [*]mut u8 {
  unsafe {
    let mut empty = Intrinsic.rawBufferViewMut<u8>(&mut bytes.*, usize.ZERO, usize.ZERO)
    return Intrinsic.pointerRequalify<?[*]mut u8, [*]mut u8>(
      Intrinsic.pointerFromMutSlice<u8>(&mut empty),
    )
  }
}

// A base for writes as a base for reads.
@inlineAlways
fn readable(base: [*]mut u8) -> [*]const u8 {
  unsafe {
    return Intrinsic.pointerRequalify<[*]mut u8, [*]const u8>(base)
  }
}

// The element of row `first` in the column of `field`, in storage of `limit` rows at `base`.
@inlineAlways
unsafe fn columnAt<T, V>(
  base: [*]const u8,
  limit: usize,
  first: usize,
  static field: Intrinsic.Field<T, V>,
) -> [*]const V {
  unsafe {
    let start = Intrinsic.pointerAt<u8>(base, limit * bytesBefore(field) + first * bytesOf(field))
    return Intrinsic.pointerRequalify<*const align (1) V, [*]const V>(
      Intrinsic.pointerReinterpret<*const u8, *const align (1) V>(start),
    )
  }
}

@inlineAlways
unsafe fn columnAtMut<T, V>(
  base: [*]mut u8,
  limit: usize,
  first: usize,
  static field: Intrinsic.Field<T, V>,
) -> [*]mut V {
  unsafe {
    let start = Intrinsic.pointerAtMut<u8>(
      base,
      limit * bytesBefore(field) + first * bytesOf(field),
    )
    return Intrinsic.pointerRequalify<*mut align (1) V, [*]mut V>(
      Intrinsic.pointerReinterpret<*mut u8, *mut align (1) V>(start),
    )
  }
}

// One field of row `row`, lent for as long as `anchor` is. The caller checked `row`.
@inlineAlways
unsafe fn lend<'s, A, T, V>(
  anchor: &'s A,
  base: [*]const u8,
  limit: usize,
  row: usize,
  static field: Intrinsic.Field<T, V>,
) -> &'s V {
  unsafe {
    return Intrinsic.pointerBorrow<A, V>(
      anchor,
      Intrinsic.pointerAt<V>(columnAt<T, V>(base, limit, usize.ZERO, field), row),
    )
  }
}

@inlineAlways
unsafe fn lendMut<'s, A, T, V>(
  anchor: &'s mut A,
  base: [*]mut u8,
  limit: usize,
  row: usize,
  static field: Intrinsic.Field<T, V>,
) -> &'s mut V {
  unsafe {
    return Intrinsic.pointerBorrowMut<A, V>(
      move anchor,
      Intrinsic.pointerAtMut<V>(columnAtMut<T, V>(base, limit, usize.ZERO, field), row),
    )
  }
}

// One field of the `count` rows from `first`, lent for as long as `anchor` is.
@inlineAlways
unsafe fn lendMany<'s, A, T, V>(
  anchor: &'s A,
  base: [*]const u8,
  limit: usize,
  first: usize,
  count: usize,
  static field: Intrinsic.Field<T, V>,
) -> &'s [V] {
  unsafe {
    return Intrinsic.pointerBorrowMany<A, V>(
      anchor,
      columnAt<T, V>(base, limit, first, field),
      count,
    )
  }
}

@inlineAlways
unsafe fn lendManyMut<'s, A, T, V>(
  anchor: &'s mut A,
  base: [*]mut u8,
  limit: usize,
  first: usize,
  count: usize,
  static field: Intrinsic.Field<T, V>,
) -> &'s mut [V] {
  unsafe {
    return Intrinsic.pointerBorrowManyMut<A, V>(
      move anchor,
      columnAtMut<T, V>(base, limit, first, field),
      count,
    )
  }
}

// A borrow of nothing. A handle keeps the address of the storage by value, and a mark carries the
// borrow of the list that makes the address valid. A mark has no bytes, so it can live at any
// address, and one exclusive mark can become two.
struct Mark {}

struct Marks {
  here: Mark,
  rest: Mark,
}

unsafe fn markOf<'s, A>(anchor: &'s A) -> &'s Mark {
  unsafe {
    let place = Pointer.assumeAligned<Mark>(
      Pointer.castUnaligned<A, Mark>(Intrinsic.pointerFromRef<A>(anchor)),
    )
    return Intrinsic.pointerBorrow<A, Mark>(anchor, place)
  }
}

unsafe fn markOfMut<'s, A>(anchor: &'s mut A) -> &'s mut Mark {
  unsafe {
    let place = Pointer.assumeAlignedMut<Mark>(
      Pointer.castUnalignedMut<A, Mark>(Intrinsic.pointerFromMutRef<A>(&mut anchor.*)),
    )
    return Intrinsic.pointerBorrowMut<A, Mark>(move anchor, place)
  }
}

// One exclusive mark as two, for the two handles of `RowsMut.splitAt`. The handles name rows that
// do not overlap.
unsafe fn splitMark<'s>(mark: &'s mut Mark) -> &'s mut Marks {
  unsafe {
    let place = Pointer.assumeAlignedMut<Marks>(
      Pointer.castUnalignedMut<Mark, Marks>(Intrinsic.pointerFromMutRef<Mark>(&mut mark.*)),
    )
    return Intrinsic.pointerBorrowMut<Mark, Marks>(move mark, place)
  }
}

// Reads one element of a column. The caller checked `row`.
@inlineAlways
unsafe fn cell<T, V: Copy>(
  base: [*]const u8,
  limit: usize,
  row: usize,
  static field: Intrinsic.Field<T, V>,
) -> V {
  unsafe {
    return Intrinsic.pointerRead<V>(
      Intrinsic.pointerAt<V>(columnAt<T, V>(base, limit, usize.ZERO, field), row),
    )
  }
}

// Writes one element of a column. The caller checked `row` against the capacity. Rows are `Copy`,
// so the write never drops an old value.
@inlineAlways
unsafe fn putCell<T, V: Copy>(
  base: [*]mut u8,
  limit: usize,
  row: usize,
  static field: Intrinsic.Field<T, V>,
  value: &V,
) -> () {
  unsafe {
    Intrinsic.pointerWrite<V>(
      Intrinsic.pointerAtMut<V>(columnAtMut<T, V>(base, limit, usize.ZERO, field), row),
      value.*,
    )
  }
  return ()
}

// Writes `value` to the `count` elements of a column from row `first`.
unsafe fn fillCells<T, V: Copy>(
  base: [*]mut u8,
  limit: usize,
  first: usize,
  count: usize,
  static field: Intrinsic.Field<T, V>,
  value: &V,
) -> () {
  unsafe {
    let column = columnAtMut<T, V>(base, limit, first, field)
    let mut at = usize.ZERO
    while at < count {
      Intrinsic.pointerWrite<V>(Intrinsic.pointerAtMut<V>(column, at), value.*)
      at = at + usize.ONE
    }
  }
  return ()
}

unsafe fn rowAt<T>(base: [*]const u8, limit: usize, row: usize) -> T {
  unsafe {
    return T {
      static for field in Reflect.fields<T>() { [field]: cell<T>(base, limit, row, field) },
    }
  }
}

unsafe fn putRow<T>(base: [*]mut u8, limit: usize, row: usize, value: &T) -> () {
  unsafe {
    static for field in Reflect.fields<T>() {
      putCell<T>(base, limit, row, field, Reflect.borrowField(value, field))
    }
  }
  return ()
}

// Writes `value` to the `count` rows from `first`, one column at a time.
unsafe fn fillRows<T>(base: [*]mut u8, limit: usize, first: usize, count: usize, value: &T) -> () {
  unsafe {
    static for field in Reflect.fields<T>() {
      fillCells<T>(base, limit, first, count, field, Reflect.borrowField(value, field))
    }
  }
  return ()
}

// Copies the rows of `source` over the rows from `at` of a buffer of `limit` rows, one copy for
// each column. The buffer has room for them, and `source` is a handle of another buffer.
fn copyRowsIn<T>(
  bytes: &mut Intrinsic.RawBuffer<u8>,
  limit: usize,
  at: usize,
  source: Rows<'_, T>,
) -> () {
  if source.count == usize.ZERO {
    return ()
  }
  unsafe {
    static for field in Reflect.fields<T>() {
      let length = source.count * bytesOf(field)
      if length != usize.ZERO {
        let from = Intrinsic.pointerAt<u8>(
          source.base,
          source.limit * bytesBefore(field) + source.first * bytesOf(field),
        )
        let view = Intrinsic.pointerBorrowMany<Mark, u8>(
          source.mark,
          Pointer.assumeMany<u8>(from),
          length,
        )
        RawBuffer.copy<u8>(
          &mut bytes.*,
          limit * bytesBefore(field) + at * bytesOf(field),
          view,
          length,
        )
      }
    }
  }
  return ()
}

// Moves `count` rows from row `from` to row `to` inside one buffer, one overlapping copy for each
// column.
fn moveRows<T>(
  bytes: &mut Intrinsic.RawBuffer<u8>,
  limit: usize,
  from: usize,
  to: usize,
  count: usize,
) -> () {
  if count == usize.ZERO || from == to {
    return ()
  }
  unsafe {
    static for field in Reflect.fields<T>() {
      let start = limit * bytesBefore(field)
      let length = count * bytesOf(field)
      if length != usize.ZERO {
        let source = aliased<usize>(&limit, &bytes.*, start + from * bytesOf(field), length)
        RawBuffer.copy<u8>(&mut bytes.*, start + to * bytesOf(field), source, length)
      }
    }
  }
  return ()
}

// Moves the columns of `count` rows from their places in storage for `limit` rows to their places
// in storage for `next` rows, which is more, inside one buffer. A column only moves toward the end,
// so the last column moves first: it never lands on a column that has not moved yet.
fn spreadColumns<T>(
  bytes: &mut Intrinsic.RawBuffer<u8>,
  limit: usize,
  next: usize,
  count: usize,
) -> () {
  unsafe {
    static for turn in Reflect.fields<T>() {
      static for field in Reflect.fields<T>() {
        static if movesInTurn(turn, field) {
          let length = count * bytesOf(field)
          let source = aliased<usize>(&limit, &bytes.*, limit * bytesBefore(field), length)
          RawBuffer.copy<u8>(&mut bytes.*, next * bytesBefore(field), source, length)
        }
      }
    }
  }
  return ()
}

// Whether the column of `field` is the one that moves in the turn of `turn`, when the columns that
// have bytes take turns in declaration order and move from the last stored column to the first.
// The first stored column never moves, because it starts at the base for every capacity.
static fn movesInTurn<T, A, B>(turn: Intrinsic.Field<T, A>, field: Intrinsic.Field<T, B>) -> bool {
  if bytesOf(turn) == 0 || bytesOf(field) == 0 || bytesBefore(field) == 0 {
    return false
  }
  return columnsBefore(field) + columnsInFrontInSource(turn) + 1 == columnCount<T>()
}

// The number of columns with bytes that are stored in front of the column of `target`.
static fn columnsBefore<T, V>(target: Intrinsic.Field<T, V>) -> usize {
  let mut total: usize = 0
  let mut seen = false
  static for field in Reflect.fields<T>() {
    if sameField(field, target) {
      seen = true
    } else {
      if bytesOf(field) != 0
        && (alignmentOf(field) > alignmentOf(target)
          || (alignmentOf(field) == alignmentOf(target) && !seen)) {
        total = total + 1
      }
    }
  }
  return total
}

// The number of fields with bytes that are declared in front of `target`.
static fn columnsInFrontInSource<T, V>(target: Intrinsic.Field<T, V>) -> usize {
  let mut total: usize = 0
  let mut seen = false
  static for field in Reflect.fields<T>() {
    if sameField(field, target) {
      seen = true
    } else {
      if bytesOf(field) != 0 && !seen {
        total = total + 1
      }
    }
  }
  return total
}

// The number of fields of `T` with bytes.
static fn columnCount<T>() -> usize {
  let mut total: usize = 0
  static for field in Reflect.fields<T>() {
    if bytesOf(field) != 0 {
      total = total + 1
    }
  }
  return total
}

// `count` bytes of `buffer` from `start`, as a slice that borrows `anchor` instead of `buffer`, so
// the caller can copy them to another range of the same buffer.
unsafe fn aliased<'a, A>(
  anchor: &'a A,
  buffer: &Intrinsic.RawBuffer<u8>,
  start: usize,
  count: usize,
) -> &'a [u8] {
  unsafe {
    let descriptor = Intrinsic.pointerFromRef<Intrinsic.RawBuffer<u8>>(buffer)
    let alias = Intrinsic.pointerBorrow<A, Intrinsic.RawBuffer<u8>>(anchor, descriptor)
    return RawBuffer.view<u8>(alias, start, count)
  }
}

// Gives the scratch of a sort the row numbers `0` to `count`, in order, and a spare of that length.
effect fn prepareSort(scratch: &mut ColumnSort, count: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  List<u32>.clear(&mut scratch.order)
  List<u32>.clear(&mut scratch.spare)
  run List<u32>.reserve(&mut scratch.order, count)
  run List<u32>.reserve(&mut scratch.spare, count)
  let mut at = usize.ZERO
  while at < count {
    let number = usize.wrappingToU32(at)
    let _placed = List<u32>.appendWithinCapacity(&mut scratch.order, number)
    let _spared = List<u32>.appendWithinCapacity(&mut scratch.spare, number)
    at = at + usize.ONE
  }
  return ()
}

// Orders the row numbers in `order` by their keys with a stable merge sort. `order` holds `0` to
// its length on entry, and `spare` has the same length.
fn orderRows<K: Order>(keys: &[K], order: &mut [u32], spare: &mut [u32]) -> () {
  let count = order.length
  let mut width = usize.ONE
  while width < count {
    let mut low = usize.ZERO
    while low < count {
      let mut middle = low + width
      if count < middle {
        middle = count
      }
      let mut high = middle + width
      if count < high {
        high = count
      }
      let mut left = low
      let mut right = middle
      let mut cursor = low
      while cursor < high {
        // The right run wins a position only when its key is strictly less, so rows with equal
        // keys leave the left run first and the sort is stable.
        let mut takeRight = true
        if left < middle {
          takeRight = false
          if right < high {
            takeRight = (&keys[u32.toUsize(order[right])]) < (&keys[u32.toUsize(order[left])])
          }
        }
        if takeRight {
          spare[cursor] = order[right]
          right = right + usize.ONE
        } else {
          spare[cursor] = order[left]
          left = left + usize.ONE
        }
        cursor = cursor + usize.ONE
      }
      low = high
    }
    let mut back = usize.ZERO
    while back < count {
      order[back] = spare[back]
      back = back + usize.ONE
    }
    width = width + width
  }
  return ()
}

// Puts the element of row `order[at]` at row `at` for every row of one column. `marks` is working
// storage of the same length. Each cycle of the order moves through one saved element, so the
// column needs no copy.
unsafe fn placeColumn<T, V: Copy>(
  base: [*]mut u8,
  limit: usize,
  count: usize,
  static field: Intrinsic.Field<T, V>,
  order: &[u32],
  marks: &mut [u32],
) -> () {
  static if bytesOf(field) == 0 {
    return ()
  }
  unsafe {
    let column = columnAtMut<T, V>(base, limit, usize.ZERO, field)
    let mut at = usize.ZERO
    while at < count {
      marks[at] = order[at]
      at = at + usize.ONE
    }
    let mut start = usize.ZERO
    while start < count {
      if u32.toUsize(marks[start]) != start {
        let saved = Intrinsic.pointerRead<V>(Intrinsic.pointerAtMut<V>(column, start))
        let mut target = start
        while true {
          let source = u32.toUsize(marks[target])
          marks[target] = usize.wrappingToU32(target)
          if source == start {
            Intrinsic.pointerWrite<V>(Intrinsic.pointerAtMut<V>(column, target), saved)
            break
          }
          let moved = Intrinsic.pointerRead<V>(Intrinsic.pointerAtMut<V>(column, source))
          Intrinsic.pointerWrite<V>(Intrinsic.pointerAtMut<V>(column, target), moved)
          target = source
        }
      }
      start = start + usize.ONE
    }
  }
  return ()
}

// The growing path of the appends, the inserts and `reserve`, kept out of line. The capacity
// becomes at least `count + additional`: four rows on the first growth, then doubling.
@inlineNever
effect fn growFor<T>(self: &mut ColumnList<T>, additional: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let needed = match move usize.checkedAdd(self.count, additional) {
    Option<usize>.Some { value } => value
    Option<usize>.None => run Allocator.outOfMemory()
  }
  let mut next: usize = 4
  if self.limit != usize.ZERO {
    next = doubled(self.limit, needed)
  }
  while next < needed {
    next = doubled(next, needed)
  }
  return run regrow<T>(&mut self.*, next, true)
}

// Twice `capacity`, or `needed` when that overflows `usize`.
fn doubled(capacity: usize, needed: usize) -> usize {
  return match move usize.checkedAdd(capacity, capacity) {
    Option<usize>.Some { value } => value
    Option<usize>.None => needed
  }
}

// Whether storage for `next` rows is a block large enough that the system provider gives it pages
// of its own on macOS (`MAPPED_BYTES` in silk/mem/allocator.silk). The macOS heap keeps the pages
// of a large block that a list left dirty, so a list that grew by doubling to tens of megabytes
// was charged about twice.
fn mapsItsOwnPages<T>(next: usize) -> bool {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    return next >= 262144 / rowBytes<T>()
  } else {
    return false
  }
}

// Gives the list storage for `next` rows, which is not less than the count. The list changes only
// after the storage is there.
//
// An `amortized` growth makes room for appends to come. Under the system provider on macOS, once
// the storage is on pages of its own, it takes eight times the room: the pages cost nothing until
// they are written, and the copies onto fresh pages become rare. A request for an exact capacity
// (`makeWithCapacity`, `reserveExact`, `shrinkToFit`) gets that capacity.
//
// Any other growth under the system provider first asks the heap to make the block larger: the
// heap can extend it, or move a large one without copying its pages. The offset of a column depends
// on the capacity, so the columns then move to their new places inside the block.
effect fn regrow<T>(self: &mut ColumnList<T>, next: usize, amortized: bool) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut next = next
  let mut inPlace = false
  if self.count != usize.ZERO {
    if run Allocator.growsInPlace() {
      if mapsItsOwnPages<T>(next) {
        if amortized {
          next = doubled(next, next)
          next = doubled(next, next)
          next = doubled(next, next)
        }
      } else {
        // The heap aligns a block that it makes larger for a machine word and no more.
        inPlace = next > self.limit && rowAlignment<T>() <= 8
      }
    }
  }
  let size = match move usize.checkedMultiply(next, rowBytes<T>()) {
    Option<usize>.Some { value } => value
    Option<usize>.None => run Allocator.outOfMemory()
  }
  let layout = match Layout.make(size, rowAlignment<T>()) {
    Layout ready => move ready
    _ => run Allocator.outOfMemory()
  }
  if inPlace {
    let mut resized = false
    unsafe {
      resized = RawBuffer.resize<u8>(&mut self.bytes, size)
    }
    if resized {
      spreadColumns<T>(&mut self.bytes, self.limit, next, self.count)
      self.limit = next
      return ()
    }
  }
  let allocation = run Allocator.allocate(move layout)
  let mut target = unsafe RawBuffer.from<u8>(move allocation, size)
  let limit = self.limit
  let count = self.count
  unsafe {
    static for field in Reflect.fields<T>() {
      let length = count * bytesOf(field)
      if length != usize.ZERO {
        let source = RawBuffer.view<u8>(&self.bytes, limit * bytesBefore(field), length)
        RawBuffer.copy<u8>(&mut target, next * bytesBefore(field), source, length)
      }
    }
  }
  let old = Intrinsic.replace(self.bytes, move target)
  drop old
  self.limit = next
  return ()
}
