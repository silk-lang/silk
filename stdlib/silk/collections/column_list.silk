impl<'a, T: Copy> Intrinsic.Rows<usize, T> for Rows<'a, T> {
  @inlineAlways
  fn borrow<'s, V>(self: &'s Self, index: usize, static field: Intrinsic.Field<T, V>) -> &'s V {
    if index >= self.count {
      return Intrinsic.trap("Rows: the row index is not less than the length")
    }
    unsafe {
      return lend<Self, T, V>(self, self.base, self.limit, self.first + index, field)
    }
  }

  @inlineAlways
  fn span<'s, V>(self: &'s Self, static field: Intrinsic.Field<T, V>) -> &'s [V] {
    unsafe {
      return lendMany<Self, T, V>(self, self.base, self.limit, self.first, self.count, field)
    }
  }
}

impl<'a, T: Copy> Intrinsic.Rows<Id<T>, T> for Rows<'a, T> {
  @inlineAlways
  fn borrow<'s, V>(self: &'s Self, index: Id<T>, static field: Intrinsic.Field<T, V>) -> &'s V {
    let row = Id<T>.index(index)
    if row < self.first || row - self.first >= self.count {
      return Intrinsic.trap("Rows: the row id is not the id of a row of the handle")
    }
    unsafe {
      return lend<Self, T, V>(self, self.base, self.limit, row, field)
    }
  }

  @inlineAlways
  fn span<'s, V>(self: &'s Self, static field: Intrinsic.Field<T, V>) -> &'s [V] {
    unsafe {
      return lendMany<Self, T, V>(self, self.base, self.limit, self.first, self.count, field)
    }
  }
}

