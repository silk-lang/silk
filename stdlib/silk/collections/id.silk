//! Typed 32-bit row numbers.
//!
//! # When to use
//! Use [`Id`] for a row number that code stores: a link from one row to another row, or a key that
//! names a row of one collection. An `Id<Fragment>` is a different type from an `Id<Box>`, so the
//! compiler rejects a row number that is used with rows of the wrong type. An `Id` is 4 bytes, half
//! of a `usize` on a 64-bit target. Use a plain `usize` for a loop counter.
//!
//! # Details
//! An [`Id`] holds one `u32`. [`Id.none`] is the value that names no row. It replaces a sentinel
//! such as `usize.MAX`. `silk.collections.column_list.ColumnList` accepts an `Id<T>` as the index
//! of its `T` rows, as in `fragments[id].size`.
//!
//! # Gotchas
//! An `Id` is not checked when it is made. A row index traps when its `Id` names no row.
//!
//! # Examples
//! ## Follow a link from one row to the next row
//! ```silk
//! import silk.collections.column_list { ColumnList }
//! import silk.collections.id { Id }
//! import silk.core.effect { Effect }
//! import silk.core.ownership { Copy }
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//!
//! struct Step {
//!   pub next: Id<Step>,
//!   pub cost: u32,
//! }
//!
//! impl Copy for Step {}
//!
//! effect fn total() -> u32
//!   ! OutOfMemoryError
//!   ? &mut Allocator {
//!   let mut steps = ColumnList<Step>.make()
//!   let last = run steps.appendId(Step { next: Id<Step>.none(), cost: 5 })
//!   let first = run steps.appendId(Step { next: last, cost: 2 })
//!   let mut sum: u32 = 0
//!   let mut current = first
//!   while !current.isNone() {
//!     sum = sum + steps[current].cost
//!     current = steps[current].next
//!   }
//!   return sum
//! }
//!
//! effect fn recover(error: OutOfMemoryError) -> u32 {
//!   return 0
//! }
//!
//! pub fn main() -> i32 {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let sum = run total()
//!     |> Effect.provideMut<Allocator>(&mut allocator)
//!     |> Effect.catchAll(recover)
//!   if sum != 7 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Collections

import silk.collections.hash { Hash, HashKey, HashSeed }
import silk.core.equal { Equal }
import silk.core.order { Order, Ordering }
import silk.core.ownership { Copy }
import silk.num.u32
import silk.num.usize

/// The number of a row of `T`, in 32 bits.
///
/// # Details
///
/// The type parameter only names the rows that the number belongs to. An `Id<T>` is `Copy`, and two
/// of them compare by their numbers. [`Id.none`] names no row.
pub struct Id<T> {
  value: u32,
}

impl<T> Copy for Id<T> {}

impl<T> Id<T> {
  /// Returns the id of the row at `index`.
  ///
  /// # Gotchas
  ///
  /// It traps if `index` is 4,294,967,295 or more, because that number is [`Id.none`] and larger
  /// numbers do not fit in 32 bits.
  pub fn fromIndex(index: usize) -> Id<T> {
    if index >= u32.toUsize(u32.MAX) {
      return Intrinsic.trap("Id.fromIndex: the index does not fit in an Id")
    }
    return Id<T> { value: usize.wrappingToU32(index) }
  }

  /// Returns the id that has the number `value`. The number 4,294,967,295 gives [`Id.none`].
  pub fn fromRaw(value: u32) -> Id<T> {
    return Id<T> { value: value }
  }

  /// Returns the id that names no row.
  ///
  /// # When to use
  ///
  /// Use it as the value of a link that has no target, such as the next sibling of the last
  /// child. Test for it with [`Id.isNone`].
  pub fn none() -> Id<T> {
    return Id<T> { value: u32.MAX }
  }

  /// Returns `true` if the id is [`Id.none`].
  pub fn isNone(self: Self) -> bool {
    return self.value == u32.MAX
  }

  /// Returns the row index that the id names.
  ///
  /// # Gotchas
  ///
  /// [`Id.none`] gives 4,294,967,295, which is not the index of a row.
  pub fn index(self: Self) -> usize {
    return u32.toUsize(self.value)
  }

  /// Returns the number that the id holds. [`Id.none`] gives 4,294,967,295.
  pub fn raw(self: Self) -> u32 {
    return self.value
  }
}

impl<T> Equal for Id<T> {
  fn equals(left: &Self, right: &Self) -> bool {
    return left.value == right.value
  }
}

impl<T> Order for Id<T> {
  fn compare(left: &Self, right: &Self) -> Ordering {
    if left.value < right.value {
      return Ordering.Less
    }
    if left.value > right.value {
      return Ordering.Greater
    }
    return Ordering.Equal
  }
}

impl<T> HashKey for Id<T> {
  fn equals(left: &Self, right: &Self) -> bool {
    return left.value == right.value
  }

  fn hash(value: &Self, seed: &HashSeed) -> u64 {
    return Hash.mix(seed, u32.toU64(value.value))
  }
}
