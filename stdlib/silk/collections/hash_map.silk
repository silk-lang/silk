//! Hash maps that own their keys and values, with deterministic seeded hashing.
//!
//! # When to use
//! Use [`HashMap`] to find a value by a key. The key type must implement `silk.collections.hash.HashKey`. Use
//! `silk.collections.list.List` when the order of insertion matters, or when the code finds values by position.
//!
//! # Details
//! [`HashMap.make`] does not allocate. The first insert allocates eight buckets.
//! [`HashMap.makeWithCapacity`] and [`HashMap.reserve`] allocate room for a known number of entries
//! in one step. [`HashMap.clear`] drops the entries and keeps the buckets for reuse, and
//! [`HashMap.clearAndFree`] also releases them. The map rebuilds its table before more than three
//! quarters of the buckets are in use. A bucket stays in use after a removal, until the next
//! rebuild. The rebuild doubles the number of buckets if the entries fill more than half of them.
//! Otherwise it keeps the number and only clears the removed buckets, so a map that inserts and
//! removes forever keeps a bucket count in proportion to its largest length. A failed growth leaves
//! the entries, the length, and the bucket count unchanged.
//!
//! The same seed and the same operations give the same bucket order on each target. To visit each
//! entry, scan the buckets from 0 to [`HashMap.bucketCount`], test [`HashMap.occupiedAt`], and read
//! [`HashMap.keyAt`] and [`HashMap.valueAt`]. This order is the bucket order, not the order of
//! insertion.
//!
//! # Gotchas
//! Each lookup and removal consumes its probe key. [`HashMap.get`], [`HashMap.keyAt`], and
//! [`HashMap.valueAt`] copy, so the key and value types must be `Copy`. For a value that is not
//! `Copy`, use [`HashMap.withMut`] to change it in place, or [`HashMap.remove`] to move it out.
//!
//! # Examples
//! ## Insert, read, and remove one value
//! ```silk
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.core.effect { Effect }
//! import silk.collections.hash { Hash, Word }
//! import silk.collections.hash_map { HashMap }
//! import silk.option { Option }
//!
//! pub effect fn main() -> i32
//!   ! OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let mut map = HashMap<Word, i32>.make(Hash.seed(17))
//!   let previous = run HashMap<Word, i32>.insert(&mut map, Hash.word(7), 42)
//!     |> Effect.provideMut<Allocator>(&mut allocator)
//!   let found = HashMap<Word, i32>.get(&map, Hash.word(7)) |> Option<i32>.unwrapOr(0)
//!   let removed = HashMap<Word, i32>.remove(&mut map, Hash.word(7)) |> Option<i32>.unwrapOr(0)
//!   if found != 42 || removed != 42 || HashMap<Word, i32>.contains(&map, Hash.word(7)) {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Collections

// A hashed map over the allocation substrate. Ordinary Silk: no compiler phase knows this type, no
// LLVM lowering contains a hash operation, and every hash a program computes is a call to the key's
// `HashKey` witness declared in Silk.
//
// Open addressing with linear probing over two buffers of one width: the entries, whose slot is
// initialized exactly when its state byte says occupied, and the states — vacant, occupied, or
// removed. A removed slot keeps a probe run intact after a removal, and growth drops the removed
// marks because it rehomes only the occupied entries.
//
// Each entry carries the hash it was placed under. That is what lets growth rehome an entry without
// hashing it again, which matters here beyond the saved work: a bound is not carried into a nested
// generic call, so a `K: HashKey` body cannot hand its own `K` to another `K: HashKey` function.
// Anything that needs the witness has to be written in the body that needs it. Storing the hash
// keeps growth, placement, and release ordinary unbounded code, and leaves the witness reached from
// exactly the five operations that take a key from the caller.
//
// Every bucket index is reduced from the hash in u64 arithmetic before it narrows to `usize`, so the
// index a key lands on does not depend on the width of a pointer and the iteration order is the same
// under native and WebAssembly targets.

import silk.core.bool
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.allocator { OutOfMemoryError }
import silk.collections.hash { HashKey, HashSeed }
import silk.layout { Layout }
import silk.layout { LayoutOverflow }
import silk.option { Option }
import silk.core.ownership { Copy, Drop }
import silk.mem.raw_buffer { RawBuffer }
import silk.simd.simd
import silk.simd.mask16
import silk.simd.u8x16
import silk.mem.slot { Slot }
import silk.num.u64
import silk.num.u8
import silk.num.usize

/// A slot is vacant, and no key was ever placed here.
const VACANT: u8 = 0

/// A slot holds an initialized entry when its state byte is at least `OCCUPIED`. The low seven bits
/// are the top seven bits of its hash, so a probe can skip a slot without reading the entry.
const OCCUPIED: u8 = 128

/// A slot held an entry that was removed. Probing continues through it, so a lookup does not
/// stop there.
const REMOVED: u8 = 2

/// The width a map takes when it first allocates.
const INITIAL_WIDTH: usize = 8

/// An internal part of the storage of [`HashMap`]. User code does not use it.
pub struct Entry<K, V> {
  hash: u64,
  key: K,
  value: V,
}

impl<K: Copy, V: Copy> Copy for Entry<K, V> {}

/// An internal part of the storage of [`HashMap`]. User code does not use it.
pub struct Unallocated<K, V> {
  anchor: [Entry<K, V>; 0],
}

/// An internal part of the storage of [`HashMap`]. User code does not use it.
pub struct Table<K, V> {
  entries: Intrinsic.RawBuffer<Entry<K, V>>,
  states: Intrinsic.RawBuffer<u8>,
}

/// A hash map that owns unique keys and their values, with deterministic seeded hashing.
///
/// # When to use
///
/// Use it to find a value by a key. The key type must implement `silk.collections.hash.HashKey`. Use
/// `silk.collections.list.List` when the order of insertion matters, or when the code finds values by
/// position.
///
/// # Details
///
/// [`HashMap.make`] does not allocate. The first insert allocates eight buckets.
/// [`HashMap.makeWithCapacity`] and [`HashMap.reserve`] allocate room for a known number of entries
/// in one step. [`HashMap.clear`] drops the entries and keeps the buckets for reuse, and
/// [`HashMap.clearAndFree`] also releases them. The map rebuilds its table before more than three
/// quarters of the buckets are in use. A bucket stays in use after a removal, until the next
/// rebuild. The rebuild doubles the number of buckets if the entries fill more than half of them.
/// Otherwise it keeps the number and only clears the removed buckets, so a map that inserts and
/// removes forever keeps a bucket count in proportion to its largest length. A failed growth leaves
/// the entries, the length, and the bucket count unchanged.
///
/// To visit each entry, scan the buckets from 0 to [`HashMap.bucketCount`], test
/// [`HashMap.occupiedAt`], and read [`HashMap.keyAt`] and [`HashMap.valueAt`]. This order is the
/// bucket order, not the order of insertion. The same seed and the same operations give the same
/// bucket order on each target.
///
/// Each key is unique under `HashKey.equals`. An insert with a key that is already present replaces
/// the value. The map uses one seed for all of its hashes. Dropping the map drops each key and
/// value and then releases the storage.
///
/// # Gotchas
///
/// Each lookup and removal consumes its probe key. [`HashMap.get`], [`HashMap.keyAt`], and
/// [`HashMap.valueAt`] copy, so the key and value types must be `Copy`. For a value that is not
/// `Copy`, use [`HashMap.withMut`] to change it in place, or [`HashMap.remove`] to move it out.
pub struct HashMap<K, V> {
  storage: Unallocated<K, V> | Table<K, V>,
  seed: HashSeed,
  count: usize,
  used: usize,
  capacity: usize,
}

impl<K, V> HashMap<K, V> {
  /// Returns an empty map that uses `seed` for each hash. This function does not allocate.
  ///
  /// # Details
  ///
  /// The seed and the sequence of operations decide the bucket order.
  pub fn make(seed: HashSeed) -> HashMap<K, V> {
    return HashMap<K, V> {
      storage: Unallocated<K, V> { anchor: [] },
      seed: move seed,
      count: usize.ZERO,
      used: usize.ZERO,
      capacity: usize.ZERO,
    }
  }

  /// Returns an empty map that uses `seed` for each hash, with buckets for at least `capacity`
  /// entries before the first rebuild.
  ///
  /// # When to use
  ///
  /// Use `makeWithCapacity` when the number of entries is known or can be estimated before the
  /// inserts, so that the table allocates once instead of growing step by step.
  ///
  /// # Details
  ///
  /// The length is 0. Inserts of up to `capacity` entries do not allocate. The bucket count is the
  /// smallest of 8, 16, 32, and so on that keeps `capacity` entries under three quarters of the
  /// buckets. A `capacity` of 0 does not allocate and gives the same map as [`HashMap.make`]. The
  /// seed and the sequence of operations decide the bucket order.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the bucket count overflows `usize`, or the `Allocator` cannot supply
  ///   the storage.
  pub effect fn makeWithCapacity(seed: HashSeed, capacity: usize) -> HashMap<K, V>
  ! OutOfMemoryError
  ? &mut Allocator {
    let mut made = HashMap<K, V>.make(move seed)
    run HashMap<K, V>.reserve(&mut made, capacity)
    return move made
  }

  /// Returns the number of entries in the map.
  pub fn length(self: &Self) -> usize {
    return self.count
  }

  /// Returns the number of buckets. Each bucket index from 0 to this value minus 1 is valid for
  /// [`HashMap.occupiedAt`].
  pub fn bucketCount(self: &Self) -> usize {
    return self.capacity
  }

  /// Returns `true` if the bucket at `index` holds an entry. Returns `false` for an index out of
  /// range.
  pub fn occupiedAt(self: &Self, index: usize) -> bool {
    if self.capacity <= index {
      return false
    }
    return stateAt<K, V>(self, index) >= OCCUPIED
  }

  /// Inserts `key` with `value`. Returns the old value if the map already held an equal key, or
  /// `None`.
  ///
  /// # Details
  ///
  /// The map takes ownership of `key` and `value`. If an equal key is already present, the length
  /// does not change: the map keeps the new key and value, drops the old key, and returns the old
  /// value.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the table must grow and the `Allocator` cannot supply the storage. The
  ///   map does not change.
  pub effect<'env> fn insert<K: HashKey + 'env, 'env>(
    self: &mut Self,
    key: K,
    value: V
  ) -> Option<V> ! OutOfMemoryError ? &mut Allocator {
    let hashed = HashKey.hash(&key, &self.seed)
    let tag = tagOf(hashed)
    if usize.ZERO < self.capacity {
      let storage = Intrinsic.replace(self.storage, Unallocated<K, V> { anchor: [] })
      let mut owned = openStorage<K, V>(move storage)
      let mut found = self.capacity
      let mut index = bucketOf(hashed, self.capacity)
      let mut scanned = usize.ZERO
      // The probe keeps `index` below `capacity`. `states` holds one initialized byte per slot, and
      // a slot whose state byte is occupied holds an initialized entry.
      unsafe {
        while scanned < self.capacity {
          let seen = RawBuffer.view<u8>(&owned.states, usize.ZERO, self.capacity)
          let skip = skipToCandidate(seen, index, self.capacity - scanned, tag)
          scanned = scanned + skip
          index = wrapIndex(index + skip, self.capacity)
          if scanned == self.capacity {
            break
          }
          let state = seen[index]
          if state == VACANT {
            break
          }
          if state == tag {
            let held = RawBuffer.view<Entry<K, V>>(&owned.entries, index, usize.ONE)
            if held[usize.ZERO].hash == hashed {
              if HashKey.equals(&held[usize.ZERO].key, &key) {
                found = index
                break
              }
            }
          }
          index = advance(index, self.capacity)
          scanned = scanned + usize.ONE
        }
      }
      if found < self.capacity {
        let previous = exchange<K, V>(
          &mut owned,
          found,
          Entry<K, V> { hash: hashed, key: move key, value: move value },
        )
        self.storage = move owned
        return move previous
      }
      self.storage = move owned
    }
    // The key is absent. Growth is allocated before the storage is opened, so a failure here never
    // observes the map with its buffers taken out.
    if needsRoom(self.used, self.capacity) {
      let next = rebuiltWidth(self.count, self.capacity)
      let fresh = run allocateTable<K, V>(next)
      let storage = Intrinsic.replace(self.storage, Unallocated<K, V> { anchor: [] })
      self.storage = migrate<K, V>(move storage, self.capacity, move fresh, next)
      self.capacity = next
      self.used = self.count
    }
    let storage = Intrinsic.replace(self.storage, Unallocated<K, V> { anchor: [] })
    let mut owned = openStorage<K, V>(move storage)
    let mut index = bucketOf(hashed, self.capacity)
    let mut searching = true
    while searching {
      // A table's `states` holds one initialized byte for each of its `capacity` slots.
      let seen = unsafe RawBuffer.view<u8>(&owned.states, usize.ZERO, self.capacity)
      if seen[index] >= OCCUPIED {
        index = advance(index, self.capacity)
      } else {
        searching = false
      }
    }
    let fresh = vacantAt<K, V>(&owned, index)
    let written = writeEntry<K, V>(
      &mut owned,
      index,
      Entry<K, V> { hash: hashed, key: move key, value: move value },
    )
    self.storage = move owned
    self.count = self.count + usize.ONE
    if fresh {
      self.used = self.used + usize.ONE
    }
    return Option<V>.none()
  }

  /// Returns `true` if the map holds a key equal to `key`.
  ///
  /// # Details
  ///
  /// This function consumes `key`. It does not change the map.
  pub fn contains<K: HashKey>(self: &Self, key: K) -> bool {
    if self.capacity == usize.ZERO {
      return false
    }
    let hashed = HashKey.hash(&key, &self.seed)
    let tag = tagOf(hashed)
    let mut index = bucketOf(hashed, self.capacity)
    let mut scanned = usize.ZERO
    let seen = statesOf<K, V>(self)
    while scanned < self.capacity {
      let skip = skipToCandidate(seen, index, self.capacity - scanned, tag)
      scanned = scanned + skip
      index = wrapIndex(index + skip, self.capacity)
      if scanned == self.capacity {
        break
      }
      let state = seen[index]
      if state == VACANT {
        return false
      }
      if state == tag {
        let held = entryAt<K, V>(self, index)
        if held[usize.ZERO].hash == hashed {
          if HashKey.equals(&held[usize.ZERO].key, &key) {
            return true
          }
        }
      }
      index = advance(index, self.capacity)
      scanned = scanned + usize.ONE
    }
    return false
  }

  /// Returns the bucket index of the entry with a key equal to `key`, or `None` if there is no such
  /// entry.
  ///
  /// # When to use
  ///
  /// Use `indexOf` to find a key without a copy or a move, for example when the value type is not
  /// `Copy`.
  ///
  /// # Details
  ///
  /// This function consumes `key`. It does not change the map.
  pub fn indexOf<K: HashKey>(self: &Self, key: K) -> Option<usize> {
    if self.capacity == usize.ZERO {
      return Option<usize>.none()
    }
    let hashed = HashKey.hash(&key, &self.seed)
    let tag = tagOf(hashed)
    let mut index = bucketOf(hashed, self.capacity)
    let mut scanned = usize.ZERO
    let seen = statesOf<K, V>(self)
    while scanned < self.capacity {
      let skip = skipToCandidate(seen, index, self.capacity - scanned, tag)
      scanned = scanned + skip
      index = wrapIndex(index + skip, self.capacity)
      if scanned == self.capacity {
        break
      }
      let state = seen[index]
      if state == VACANT {
        return Option<usize>.none()
      }
      if state == tag {
        let held = entryAt<K, V>(self, index)
        if held[usize.ZERO].hash == hashed {
          if HashKey.equals(&held[usize.ZERO].key, &key) {
            return Option<usize>.some(index)
          }
        }
      }
      index = advance(index, self.capacity)
      scanned = scanned + usize.ONE
    }
    return Option<usize>.none()
  }

  /// Returns a copy of the value for the key equal to `key`, or `None` if there is no such key.
  ///
  /// # When to use
  ///
  /// Use `get` when the key and value types are `Copy`. Use [`HashMap.withMut`] or
  /// [`HashMap.remove`] for a value that is not `Copy`.
  ///
  /// # Details
  ///
  /// This function consumes `key`. It does not change the map.
  pub fn get<K: HashKey + Copy, V: Copy>(self: &Self, key: K) -> Option<V> {
    if self.capacity == usize.ZERO {
      return Option<V>.none()
    }
    let hashed = HashKey.hash(&key, &self.seed)
    let tag = tagOf(hashed)
    let mut index = bucketOf(hashed, self.capacity)
    let mut scanned = usize.ZERO
    let seen = statesOf<K, V>(self)
    while scanned < self.capacity {
      let skip = skipToCandidate(seen, index, self.capacity - scanned, tag)
      scanned = scanned + skip
      index = wrapIndex(index + skip, self.capacity)
      if scanned == self.capacity {
        break
      }
      let state = seen[index]
      if state == VACANT {
        return Option<V>.none()
      }
      if state == tag {
        let held = entryAt<K, V>(self, index)
        if held[usize.ZERO].hash == hashed {
          if HashKey.equals(&held[usize.ZERO].key, &key) {
            return partValue<K, V>(readEntry<K, V>(self, index))
          }
        }
      }
      index = advance(index, self.capacity)
      scanned = scanned + usize.ONE
    }
    return Option<V>.none()
  }

  /// Calls `use` one time with an exclusive borrow of the value for the key equal to `key`. Returns
  /// `false` and does not call `use` if there is no such key.
  ///
  /// # When to use
  ///
  /// Use `withMut` to change a value in place, such as to increment a counter, when the value type
  /// is not `Copy`.
  ///
  /// # Details
  ///
  /// This function does not allocate and does not grow the map. It consumes `key`. The stored key,
  /// the length, and the bucket count do not change. `use` returns `()`, so it cannot keep the
  /// borrow.
  ///
  /// # Gotchas
  ///
  /// `use` must be `Intrinsic.NonParking`. It cannot suspend.
  pub fn withMut<K: HashKey, F: once fn(&mut V) -> () + Intrinsic.NonParking
  >(self: &mut Self, key: K, use: F) -> bool {
    if self.capacity == usize.ZERO {
      return false
    }
    let hashed = HashKey.hash(&key, &self.seed)
    let tag = tagOf(hashed)
    let storage = Intrinsic.replace(self.storage, Unallocated<K, V> { anchor: [] })
    let mut owned = openStorage<K, V>(move storage)
    let mut found = self.capacity
    let mut index = bucketOf(hashed, self.capacity)
    let mut scanned = usize.ZERO
    // The probe keeps `index` below `capacity`. `states` holds one initialized byte per slot, and a
    // slot whose state byte is occupied holds an initialized entry.
    unsafe {
      while scanned < self.capacity {
        let seen = RawBuffer.view<u8>(&owned.states, usize.ZERO, self.capacity)
        let skip = skipToCandidate(seen, index, self.capacity - scanned, tag)
        scanned = scanned + skip
        index = wrapIndex(index + skip, self.capacity)
        if scanned == self.capacity {
          break
        }
        let state = seen[index]
        if state == VACANT {
          break
        }
        if state == tag {
          let held = RawBuffer.view<Entry<K, V>>(&owned.entries, index, usize.ONE)
          if held[usize.ZERO].hash == hashed {
            if HashKey.equals(&held[usize.ZERO].key, &key) {
              found = index
              break
            }
          }
        }
        index = advance(index, self.capacity)
        scanned = scanned + usize.ONE
      }
    }
    if self.capacity <= found {
      self.storage = move owned
      return false
    }
    // `found` was set only at a slot whose state byte was occupied, so it is in bounds and
    // initialized.
    let mut held = unsafe RawBuffer.viewMut<Entry<K, V>>(&mut owned.entries, found, usize.ONE)
    use(&mut held[usize.ZERO].value)
    self.storage = move owned
    return true
  }

  /// Removes the entry with a key equal to `key` and returns its value. Returns `None` if there is
  /// no such entry.
  ///
  /// # Details
  ///
  /// The caller owns the returned value. The stored key is dropped. This function consumes `key`.
  /// It does not allocate.
  pub fn remove<K: HashKey>(self: &mut Self, key: K) -> Option<V> {
    if self.capacity == usize.ZERO {
      return Option<V>.none()
    }
    let hashed = HashKey.hash(&key, &self.seed)
    let tag = tagOf(hashed)
    let storage = Intrinsic.replace(self.storage, Unallocated<K, V> { anchor: [] })
    let mut owned = openStorage<K, V>(move storage)
    let mut found = self.capacity
    let mut index = bucketOf(hashed, self.capacity)
    let mut scanned = usize.ZERO
    // The probe keeps `index` below `capacity`. `states` holds one initialized byte per slot, and a
    // slot whose state byte is occupied holds an initialized entry.
    unsafe {
      while scanned < self.capacity {
        let seen = RawBuffer.view<u8>(&owned.states, usize.ZERO, self.capacity)
        let skip = skipToCandidate(seen, index, self.capacity - scanned, tag)
        scanned = scanned + skip
        index = wrapIndex(index + skip, self.capacity)
        if scanned == self.capacity {
          break
        }
        let state = seen[index]
        if state == VACANT {
          break
        }
        if state == tag {
          let held = RawBuffer.view<Entry<K, V>>(&owned.entries, index, usize.ONE)
          if held[usize.ZERO].hash == hashed {
            if HashKey.equals(&held[usize.ZERO].key, &key) {
              found = index
              break
            }
          }
        }
        index = advance(index, self.capacity)
        scanned = scanned + usize.ONE
      }
    }
    if self.capacity <= found {
      self.storage = move owned
      return Option<V>.none()
    }
    let carried = evict<K, V>(&mut owned, found)
    let marked = markRemoved<K, V>(&mut owned, found)
    self.storage = move owned
    self.count = self.count - usize.ONE
    return move carried
  }

  /// Returns a copy of the key in the bucket at `index`.
  ///
  /// # When to use
  ///
  /// Use `keyAt` with [`HashMap.occupiedAt`] to visit each entry in bucket order.
  ///
  /// # Gotchas
  ///
  /// The key and value types must be `Copy`. If `index` is out of range or the bucket is empty, the
  /// program traps.
  pub fn keyAt<K: Copy, V: Copy>(self: &Self, index: usize) -> K {
    if !HashMap<K, V>.occupiedAt(self, index) {
      Intrinsic.trap("HashMap.keyAt: the bucket is out of range or empty")
    }
    return partKey<K, V>(readEntry<K, V>(self, index))
  }

  /// Returns a copy of the value in the bucket at `index`.
  ///
  /// # When to use
  ///
  /// Use `valueAt` with [`HashMap.occupiedAt`] to visit each entry in bucket order.
  ///
  /// # Gotchas
  ///
  /// The key and value types must be `Copy`. If `index` is out of range or the bucket is empty, the
  /// program traps.
  pub fn valueAt<K: Copy, V: Copy>(self: &Self, index: usize) -> V {
    if !HashMap<K, V>.occupiedAt(self, index) {
      Intrinsic.trap("HashMap.valueAt: the bucket is out of range or empty")
    }
    return unwrapValue<K, V>(readEntry<K, V>(self, index))
  }

  /// Makes sure that at least `additional` more entries fit before the next rebuild.
  ///
  /// # When to use
  ///
  /// Use `reserve` before a run of inserts whose count is known, so that the table grows at most
  /// once.
  ///
  /// # Details
  ///
  /// If the buckets already hold `additional` more entries under three quarters of the bucket
  /// count, this function does nothing. Otherwise, it rebuilds the table once, with the smallest
  /// bucket count, doubling from the current one or from 8, that holds the length plus `additional`
  /// entries. The rebuild also reclaims the buckets of removed entries. The length does not change.
  /// An
  /// `additional` of 0 does nothing.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the length plus `additional` overflows `usize`, the bucket count
  ///   overflows `usize`, or the `Allocator` cannot supply the storage. The map does not change.
  pub effect fn reserve(self: &mut Self, additional: usize) -> () ! OutOfMemoryError ? &mut Allocator {
    if additional == usize.ZERO {
      return ()
    }
    let wanted = match move usize.checkedAdd(self.used, additional) {
      Option<usize>.Some {value} => value
      Option<usize>.None => run Allocator.outOfMemory()
    }
    if holds(self.capacity, wanted) {
      return ()
    }
    let entries = match move usize.checkedAdd(self.count, additional) {
      Option<usize>.Some {value} => value
      Option<usize>.None => run Allocator.outOfMemory()
    }
    let mut next = self.capacity
    if next == usize.ZERO {
      next = INITIAL_WIDTH
    }
    while !holds(next, entries) {
      if usize.MAX - next < next {
        return run Allocator.outOfMemory()
      }
      next = next + next
    }
    let fresh = run allocateTable<K, V>(next)
    let storage = Intrinsic.replace(self.storage, Unallocated<K, V> { anchor: [] })
    self.storage = migrate<K, V>(move storage, self.capacity, move fresh, next)
    self.capacity = next
    self.used = self.count
    return ()
  }

  /// Drops every entry and sets the length to 0. The bucket count does not change.
  ///
  /// # When to use
  ///
  /// Use `clear` to reuse a map, such as one filled again on each pass of a loop: later inserts up
  /// to the old size do not allocate. Use [`HashMap.clearAndFree`] to also release the storage.
  ///
  /// # Details
  ///
  /// The buckets of removed entries are reclaimed too. This function does not allocate.
  pub fn clear(self: &mut Self) -> () {
    if self.capacity == usize.ZERO {
      return ()
    }
    let storage = Intrinsic.replace(self.storage, Unallocated<K, V> { anchor: [] })
    let mut owned = openStorage<K, V>(move storage)
    let emptied = emptyTable<K, V>(&mut owned, self.capacity)
    self.storage = move owned
    self.count = usize.ZERO
    self.used = usize.ZERO
    return ()
  }

  /// Drops every entry and releases the storage. The length and the bucket count become 0.
  ///
  /// # When to use
  ///
  /// Use `clearAndFree` when the map stays alive but its storage is no longer needed. Use
  /// [`HashMap.clear`] to keep the buckets for reuse.
  ///
  /// # Details
  ///
  /// This function does not allocate and does not need an `Allocator`. The next insert allocates
  /// eight buckets again, as on a map from [`HashMap.make`]. The seed does not change.
  pub fn clearAndFree(self: &mut Self) -> () {
    let storage = Intrinsic.replace(self.storage, Unallocated<K, V> { anchor: [] })
    let width = Intrinsic.replace(self.capacity, usize.ZERO)
    let emptied = Intrinsic.replace(self.count, usize.ZERO)
    let reclaimed = Intrinsic.replace(self.used, usize.ZERO)
    return match move storage {
      Unallocated<K, V> nothing => ()
      Table<K, V> full => releaseFull<K, V>(move full, width)
    }
  }
}

// Diverges on the arms the surrounding logic has already proven impossible.
fn absurd<T>() -> T {
  return Intrinsic.trap("HashMap: an internal state the surrounding logic ruled out was reached")
}

fn stateAt<K, V>(self: &HashMap<K, V>, index: usize) -> u8 {
  return match &self.storage {
    Unallocated<K, V> nothing => VACANT
    // Every caller passes an index below the table's capacity; state bytes are always initialized.
    Table<K, V> { entries, states } => firstByte(unsafe RawBuffer.view<u8>(&states, index, usize.ONE))
  }
}

fn firstByte(seen: &[u8]) -> u8 {
  return seen[usize.ZERO]
}

fn entryAt<K, V>(self: &HashMap<K, V>, index: usize) -> &[Entry<K, V>] {
  return match &self.storage {
    Unallocated<K, V> { anchor } => emptySlice<K, V>(&anchor)
    // Every caller passes an index below the capacity whose state byte is occupied.
    Table<K, V> { entries, states } => unsafe RawBuffer.view<Entry<K, V>>(&entries, index, usize.ONE)
  }
}

fn emptySlice<K, V>(anchor: &[Entry<K, V>]) -> &[Entry<K, V>] {
  return anchor
}

/// Reduces a hash to a bucket index in u64 arithmetic, so the index does not depend on the width of
/// `usize` and one seed therefore fixes one order on every supported target.
fn bucketOf(hashed: u64, width: usize) -> usize {
  return u64.toUsize(u64.remainder(hashed, usize.toU64(width)))
}

fn advance(index: usize, width: usize) -> usize {
  let next = index + usize.ONE
  if next == width {
    return usize.ZERO
  }
  return next
}

impl<K, V> Drop for HashMap<K, V> {
  fn drop(self: &mut HashMap<K, V>) -> () {
    return HashMap<K, V>.clearAndFree(move self)
  }
}

// Releases every occupied entry exactly once and then both buffers, so a map dropped while
// non-empty destroys the keys and values it still owns rather than leaking them.
fn releaseFull<K, V>(full: Table<K, V>, width: usize) -> () {
  let mut owned = move full
  unsafe {
    let mut index = usize.ZERO
    while index < width {
      let seen = RawBuffer.view<u8>(&owned.states, usize.ZERO, width)
      if seen[index] >= OCCUPIED {
        let selected = RawBuffer.slot(&mut owned.entries, index)
        let cleared = Slot.dropValue(move selected)
      }
      index = index + usize.ONE
    }
    drop owned
  }
  return ()
}

// Drops every occupied entry in place and marks every bucket vacant, keeping both buffers.
fn emptyTable<K, V>(owned: &mut Table<K, V>, width: usize) -> () {
  unsafe {
    let mut index = usize.ZERO
    while index < width {
      let seen = RawBuffer.view<u8>(&owned.states, usize.ZERO, width)
      if seen[index] >= OCCUPIED {
        let selected = RawBuffer.slot(&mut owned.entries, index)
        let cleared = Slot.dropValue(move selected)
      }
      index = index + usize.ONE
    }
  }
  RawBuffer.fill(&mut owned.states, usize.ZERO, width, VACANT)
  return ()
}

// Reports whether `width` buckets hold `used` buckets in use without a rebuild: the insert that
// brings the table to `used` passes the three-quarter test in `needsRoom`.
fn holds(width: usize, used: usize) -> bool {
  if width == usize.ZERO {
    return false
  }
  let quarter = width / (usize.ONE + usize.ONE + usize.ONE + usize.ONE)
  return used <= width - quarter
}

fn openStorage<K, V>(storage: Unallocated<K, V> | Table<K, V>) -> Table<K, V> {
  return match move storage {
    Unallocated<K, V> nothing => absurd<Table<K, V>>()
    Table<K, V> full => move full
  }
}

effect fn overflowed() -> Layout ! OutOfMemoryError {
  return run Allocator.outOfMemory()
}

// Both buffers exist before either is installed, so an allocation that fails releases the one
// already taken and leaves the caller's map exactly as it was.
effect fn allocateTable<K, V>(count: usize) -> Table<K, V> ! OutOfMemoryError ? &mut Allocator {
  let states = run vacantStates(count)
  let entries = run entryStorage<K, V>(count)
  return Table<K, V> { entries: move entries, states: move states }
}

effect fn vacantStates(count: usize) -> Intrinsic.RawBuffer<u8> ! OutOfMemoryError ? &mut Allocator {
  let element = Layout.of<u8>()
  let plan = Layout.repeat(move element, count)
  let layout = match move plan {
    Layout ready => move ready
    LayoutOverflow overflow => run overflowed()
  }
  let recipe = Allocator.allocate(move layout)
  let allocation = run recipe
  return markVacant(move allocation, count)
}

fn markVacant(allocation: Intrinsic.Allocation, count: usize) -> Intrinsic.RawBuffer<u8> {
  unsafe {
    let mut made = RawBuffer.from<u8>(move allocation, count)
    let mut index = usize.ZERO
    while index < count {
      let selected = RawBuffer.slot(&mut made, index)
      let written = Slot.write<u8>(move selected, VACANT)
      index = index + usize.ONE
    }
    return move made
  }
  return absurd<Intrinsic.RawBuffer<u8>>()
}

effect fn entryStorage<K, V>(count: usize) -> Intrinsic.RawBuffer<Entry<K, V>> ! OutOfMemoryError ? &mut Allocator {
  let element = Layout.of<Entry<K, V>>()
  let plan = Layout.repeat(move element, count)
  let layout = match move plan {
    Layout ready => move ready
    LayoutOverflow overflow => run overflowed()
  }
  let recipe = Allocator.allocate(move layout)
  let allocation = run recipe
  return adopt<K, V>(move allocation, count)
}

fn adopt<K, V>(allocation: Intrinsic.Allocation, count: usize) -> Intrinsic.RawBuffer<Entry<K, V>> {
  unsafe {
    return RawBuffer.from<Entry<K, V>>(move allocation, count)
  }
  return absurd<Intrinsic.RawBuffer<Entry<K, V>>>()
}

/// Reports whether one more entry would take the map past three quarters of its buckets.
fn needsRoom(used: usize, width: usize) -> bool {
  if width == usize.ZERO {
    return true
  }
  let quarter = width / (usize.ONE + usize.ONE + usize.ONE + usize.ONE)
  return width - quarter < used + usize.ONE
}

// The width of the table that replaces a full one. When the entries fill at most half of the
// buckets, removed marks are what filled it, so the rebuild keeps the width and only drops those
// marks. Otherwise the width doubles. A map that inserts and removes keys forever therefore keeps
// a width in proportion to its largest number of entries.
fn rebuiltWidth(count: usize, width: usize) -> usize {
  if width == usize.ZERO {
    return INITIAL_WIDTH
  }
  if count + usize.ONE <= width / (usize.ONE + usize.ONE) {
    return width
  }
  return width + width
}

// Rehomes every occupied entry into the replacement table under the hash it was placed with, then
// releases the old buffers. The removed marks do not travel, so growth reclaims them.
fn migrate<K, V>(
  storage: Unallocated<K, V> | Table<K, V>,
  width: usize,
  fresh: Table<K, V>,
  next: usize
) -> Table<K, V> {
  return match move storage {
    Unallocated<K, V> nothing => move fresh
    Table<K, V> full => rehome<K, V>(move full, width, move fresh, next)
  }
}

fn rehome<K, V>(old: Table<K, V>, width: usize, fresh: Table<K, V>, next: usize) -> Table<K, V> {
  let mut source = move old
  let mut target = move fresh
  unsafe {
    let mut index = usize.ZERO
    while index < width {
      let seen = RawBuffer.view<u8>(&source.states, usize.ZERO, width)
      if seen[index] >= OCCUPIED {
        let selected = RawBuffer.slot(&mut source.entries, index)
        let carried = Slot.take(move selected)
        let placed = settle<K, V>(&mut target, move carried, next)
      }
      index = index + usize.ONE
    }
    drop source
  }
  return move target
}

// Places one entry at the first slot its own probe run does not already occupy. Every slot of a
// replacement table is vacant, so the run always ends.
fn settle<K, V>(target: &mut Table<K, V>, carried: Entry<K, V>, next: usize) -> () {
  let hashed = entryHash<K, V>(&carried)
  let mut index = bucketOf(hashed, next)
  let mut searching = true
  while searching {
    // A replacement table's `states` holds one initialized byte for each of its `next` slots.
    let seen = unsafe RawBuffer.view<u8>(&target.states, usize.ZERO, next)
    if seen[index] >= OCCUPIED {
      index = advance(index, next)
    } else {
      searching = false
    }
  }
  let written = writeEntry<K, V>(move target, index, move carried)
  return ()
}

fn entryHash<K, V>(entry: &Entry<K, V>) -> u64 {
  return entry.hash
}

fn writeEntry<K, V>(owned: &mut Table<K, V>, index: usize, entry: Entry<K, V>) -> () {
  let tag = tagOf(entry.hash)
  unsafe {
    let selected = RawBuffer.slot(&mut owned.entries, index)
    let written = Slot.write<Entry<K, V>>(move selected, move entry)
  }
  // Every caller passes an index below the table's capacity; state bytes are always initialized.
  let mut states = unsafe RawBuffer.viewMut<u8>(&mut owned.states, index, usize.ONE)
  states[usize.ZERO] = tag
  return ()
}

fn vacantAt<K, V>(owned: &Table<K, V>, index: usize) -> bool {
  // Every caller passes an index below the table's capacity; state bytes are always initialized.
  let seen = unsafe RawBuffer.view<u8>(&owned.states, index, usize.ONE)
  return seen[usize.ZERO] == VACANT
}

// Replaces the entry at one slot, answering with the value the slot held. The key that arrives wins
// and the key the slot held is released, so exactly one of the two equivalent keys survives.
fn exchange<K, V>(owned: &mut Table<K, V>, index: usize, entry: Entry<K, V>) -> Option<V> {
  unsafe {
    let selected = RawBuffer.slot(&mut owned.entries, index)
    let taken = Slot.take(move selected)
    let target = RawBuffer.slot(&mut owned.entries, index)
    let written = Slot.write<Entry<K, V>>(move target, move entry)
    return partValue<K, V>(move taken)
  }
  return absurd<Option<V>>()
}

// Moves the entry out of one slot and answers with its value, releasing the key it held.
fn evict<K, V>(owned: &mut Table<K, V>, index: usize) -> Option<V> {
  unsafe {
    let selected = RawBuffer.slot(&mut owned.entries, index)
    let taken = Slot.take(move selected)
    return partValue<K, V>(move taken)
  }
  return absurd<Option<V>>()
}

fn partValue<K, V>(entry: Entry<K, V>) -> Option<V> {
  return match move entry {
    Entry<K, V> { hash, key, value } => releaseKey<K, V>(move key, move value)
  }
}

fn releaseKey<K, V>(key: K, value: V) -> Option<V> {
  drop key
  return Option<V>.some(move value)
}

fn markRemoved<K, V>(owned: &mut Table<K, V>, index: usize) -> () {
  // Every caller passes an index below the table's capacity; state bytes are always initialized.
  let mut states = unsafe RawBuffer.viewMut<u8>(&mut owned.states, index, usize.ONE)
  states[usize.ZERO] = REMOVED
  return ()
}

fn readEntry<K: Copy, V: Copy>(self: &HashMap<K, V>, index: usize) -> Entry<K, V> {
  return match &self.storage {
    Unallocated<K, V> nothing => absurd<Entry<K, V>>()
    Table<K, V> { entries, states } => readAt<K, V>(&entries, index)
  }
}

fn readAt<K: Copy, V: Copy>(entries: &Intrinsic.RawBuffer<Entry<K, V>>, index: usize) -> Entry<K, V> {
  unsafe {
    return RawBuffer.read<Entry<K, V>>(entries, index)
  }
  return absurd<Entry<K, V>>()
}

fn partKey<K, V>(entry: Entry<K, V>) -> K {
  return match move entry {
    Entry<K, V> { hash, key, value } => keepKey<K, V>(move key, move value)
  }
}

fn keepKey<K, V>(key: K, value: V) -> K {
  drop value
  return move key
}

fn unwrapValue<K, V>(entry: Entry<K, V>) -> V {
  return match move entry {
    Entry<K, V> { hash, key, value } => keepValue<K, V>(move key, move value)
  }
}

fn keepValue<K, V>(key: K, value: V) -> V {
  drop key
  return move value
}

// The state byte of an occupied slot: `OCCUPIED` and the top seven bits of `hashed`.
fn tagOf(hashed: u64) -> u8 {
  return u8.bitOr(OCCUPIED, u64.toU8(u64.shiftRight(hashed, 57)))
}

fn wrapIndex(index: usize, width: usize) -> usize {
  if index == width {
    return usize.ZERO
  }
  return index
}

// The number of slots from `index` up to the next one that is vacant or carries `tag`, at most
// `limit` and never past the end of `seen`. A probe skips them, since none can hold its key and
// none ends the probe. Sixteen state bytes are tested at a time where the CPU has 128-bit vectors.
fn skipToCandidate(seen: &[u8], index: usize, limit: usize, tag: u8) -> usize {
  let mut room = seen.length - index
  if limit < room {
    room = limit
  }
  let mut skipped = usize.ZERO
  static if simd.hardware() {
    let wanted = u8x16.splat(tag)
    let vacant = u8x16.splat(VACANT)
    while skipped + 16 <= room {
      let group = u8x16.load(seen, index + skipped)
      let stops = u8x16.lanesEqual(group, wanted) | u8x16.lanesEqual(group, vacant)
      if mask16.any(stops) {
        return skipped + mask16.firstSet(stops)
      }
      skipped = skipped + 16
    }
  }
  while skipped < room {
    let state = seen[index + skipped]
    if state == tag || state == VACANT {
      return skipped
    }
    skipped = skipped + usize.ONE
  }
  return skipped
}

// Every state byte of an allocated table; empty before the first allocation.
fn statesOf<K, V>(self: &HashMap<K, V>) -> &[u8] {
  return match &self.storage {
    Unallocated<K, V> nothing => b""
    // An allocated table's `states` holds one initialized byte for each of its `capacity` slots.
    Table<K, V> { entries, states } => unsafe RawBuffer.view<u8>(&states, usize.ZERO, self.capacity)
  }
}
