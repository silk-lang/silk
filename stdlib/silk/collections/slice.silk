//! Borrowed subranges of slices, with no copy and no allocation.
//!
//! # When to use
//! Use [`Slice.view`] to give a part of a slice to a function that takes `&[T]`, such as the
//! remaining input of a parser. Use [`Slice.viewMut`] to give a part of a slice to a function that
//! takes `&mut [T]`, such as one row of a scratch buffer. Use [`Slice.asBytes`] to pass a slice of
//! numbers to a function that takes `&[u8]`, such as a GPU buffer upload.
//!
//! # Details
//! A view borrows the input. It has the same lifetime as the input and does not copy elements.
//! The range rules are the same as for indexing: a range outside the input traps. An empty range at
//! the end of the input is valid, also for an empty input.
//!
//! # Examples
//! ## Sum the second half of an array
//! ```silk
//! import silk.collections.slice { Slice }
//!
//! fn sum(values: &[i32]) -> i32 {
//!   let mut total = 0
//!   let mut index: usize = 0
//!   while index < values.length {
//!     total = total + values[index]
//!     index = index + 1
//!   }
//!   return total
//! }
//!
//! pub fn main() -> i32 {
//!   let values = [1, 2, 3, 4]
//!   let tail = Slice.view<i32>(&values, 2, 2)
//!   if sum(tail) != 7 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Collections

import silk.core.ownership { Copy }

/// Element types whose slices [`Slice.asBytes`] and [`Slice.asMutBytes`] can view as bytes.
///
/// # Details
///
/// Every primitive integer type and `f32` and `f64` conform. These types have no padding bytes, and
/// every bit pattern of their size is a valid value, so any byte can be read from them or written to
/// them. `bool` and `char` do not conform, because most bit patterns are not valid values of them.
///
/// # Gotchas
///
/// A conformance for another type must return a view of exactly the bytes of `values`, in memory
/// order. Writing one needs `unsafe` code that proves the type has no padding and no invalid bit
/// patterns.
pub interface ByteView {
  /// Returns the bytes of `values` in memory order, as a shared borrow of the same storage.
  fn bytes(values: &[Self]) -> &[u8]
  /// Returns the bytes of `values` in memory order, as an exclusive borrow of the same storage.
  fn mutBytes(values: &mut [Self]) -> &mut [u8]
}

/// The owner type of the slice operations. It has no fields and is never constructed.
pub struct Slice {}

impl Slice {
  /// Returns a shared borrow of the `length` elements of `values` that start at index `offset`.
  ///
  /// # Details
  ///
  /// The view does not copy elements and does not allocate. It cannot live longer than `values`.
  /// `view(values, values.length, 0)` is a valid empty view.
  ///
  /// # Gotchas
  ///
  /// If `offset` is more than `values.length`, or `offset + length` is more than `values.length`,
  /// the program traps.
  pub fn view<T>(values: &[T], offset: usize, length: usize) -> &[T] {
    if offset > values.length || length > values.length - offset {
      return Intrinsic.trap("Slice.view: the range ends past the end of the slice")
    }
    return Intrinsic.sliceView<T>(values, offset, length)
  }

  /// Copies every element of `source` into `destination`, starting at index `offset`.
  ///
  /// # Details
  ///
  /// The range is checked once, and the copy compiles to a bulk memory copy. A fixed array works as
  /// the destination through `&mut array`. Elements of `destination` outside the range keep their
  /// values.
  ///
  /// # Gotchas
  ///
  /// If `offset` is more than `destination.length`, or `source.length` is more than
  /// `destination.length - offset`, the program traps.
  ///
  /// # Examples
  /// ```silk
  /// import silk.collections.slice { Slice }
  ///
  /// pub fn main() -> i32 {
  ///   let mut buffer: [u8; 6] = [0; 6]
  ///   Slice.copyInto<u8>(&mut buffer, 2, b"abc")
  ///   if buffer[2] != 97 || buffer[4] != 99 || buffer[5] != 0 {
  ///     return 1
  ///   }
  ///   return 0
  /// }
  /// ```
  pub fn copyInto<T: Copy>(destination: &mut [T], offset: usize, source: &[T]) -> () {
    let count = source.length
    if offset > destination.length || count > destination.length - offset {
      return Intrinsic.trap("Slice.copyInto: the source does not fit at offset")
    }
    if count == 0 { return () }
    // Both slices are nonempty here, so their pointers are not null; `&mut` and `&` never overlap,
    // so the loop is a plain copy that LLVM turns into `memcpy`. The range check above proves
    // `offset + index` fits, and a checked add there would keep LLVM from forming the copy.
    unsafe {
      let output = Intrinsic.pointerRequalify<?[*]mut T, [*]mut T>(Intrinsic.pointerFromMutSlice<T>(&mut destination))
      let input = Intrinsic.pointerRequalify<?[*]const T, [*]const T>(Intrinsic.pointerFromSlice<T>(source))
      let mut index: usize = 0
      while index < count {
        Intrinsic.pointerWrite<T>(Intrinsic.pointerAtMut<T>(output, Intrinsic.usizeWrappingAdd(offset, index)), Intrinsic.pointerRead<T>(Intrinsic.pointerAt<T>(input, index)))
        index = index + 1
      }
    }
  }

  /// Returns an exclusive borrow of the `length` elements of `values` that start at index `offset`.
  ///
  /// # Details
  ///
  /// The view does not copy elements and does not allocate. Writes through it change `values`.
  /// While the view lives, `values` cannot be used. `viewMut(values, values.length, 0)` is a valid
  /// empty view.
  ///
  /// # Gotchas
  ///
  /// If `offset` is more than `values.length`, or `offset + length` is more than `values.length`,
  /// the program traps.
  pub fn viewMut<'a, T>(values: &'a mut [T], offset: usize, length: usize) -> &'a mut [T] {
    if offset > values.length || length > values.length - offset {
      return Intrinsic.trap("Slice.viewMut: the range ends past the end of the slice")
    }
    // The view takes over the exclusive borrow of `values` for `'a`, and its length is exactly
    // `length`, so a loop over the view can relate its index checks to it.
    return Intrinsic.sliceView<T>(move values, offset, length)
  }

  /// Returns the bytes of `values` in memory order, with no copy.
  ///
  /// # When to use
  ///
  /// Use `asBytes` to pass numbers to an API that takes bytes, such as a GPU buffer upload or a
  /// binary file write. To build the bytes of one value in a fixed byte order, use the integer
  /// type's own conversion instead.
  ///
  /// # Details
  ///
  /// `T` is a primitive integer type, `f32`, or `f64` (see [`ByteView`]). The result has
  /// `values.length` times the size of `T` bytes and lives as long as `values`. The call does not
  /// copy or allocate.
  ///
  /// # Gotchas
  ///
  /// The bytes are in memory order, which is little-endian on every current target. A reader on a
  /// big-endian machine sees each element with its bytes reversed.
  ///
  /// # Examples
  /// ```silk
  /// import silk.collections.slice { Slice }
  ///
  /// pub fn main() -> i32 {
  ///   let words: [u32; 2] = [0x04030201, 0x08070605]
  ///   let bytes = Slice.asBytes<u32>(&words)
  ///   if bytes.length != 8 || bytes[0] != 1 || bytes[7] != 8 {
  ///     return 1
  ///   }
  ///   return 0
  /// }
  /// ```
  pub fn asBytes<T: ByteView>(values: &[T]) -> &[u8] {
    return ByteView.bytes(values)
  }

  /// Returns the bytes of `values` in memory order as an exclusive borrow, with no copy.
  ///
  /// # When to use
  ///
  /// Use `asMutBytes` to fill a slice of numbers from an API that writes bytes, such as a GPU
  /// buffer readback or a binary file read.
  ///
  /// # Details
  ///
  /// `T` is a primitive integer type, `f32`, or `f64` (see [`ByteView`]). Every bit pattern is a
  /// valid value of these types, so any byte written through the result leaves valid numbers. The
  /// result has `values.length` times the size of `T` bytes. While it lives, `values` cannot be
  /// used.
  ///
  /// # Gotchas
  ///
  /// The bytes are in memory order, which is little-endian on every current target.
  ///
  /// # Examples
  /// ```silk
  /// import silk.collections.slice { Slice }
  ///
  /// pub fn main() -> i32 {
  ///   let mut words: [u16; 2] = [0, 0]
  ///   let bytes = Slice.asMutBytes<u16>(&mut words)
  ///   bytes[0] = 0x34
  ///   bytes[1] = 0x12
  ///   if words[0] != 0x1234 || words[1] != 0 {
  ///     return 1
  ///   }
  ///   return 0
  /// }
  /// ```
  pub fn asMutBytes<T: ByteView>(values: &mut [T]) -> &mut [u8] {
    return ByteView.mutBytes(move values)
  }
}

// Every slice has a non-null pointer aligned for its element type, also when it is empty, and
// spans `length * size` bytes that fit in `isize`. A `u8` needs no alignment, so the same storage is
// a valid byte slice. The callers only pass element types with no padding and no invalid bit
// patterns, so every byte is initialized and any byte written leaves a valid element.
fn sharedBytes<T>(values: &[T]) -> &[u8] {
  let layout = Intrinsic.layoutOf<T>()
  let count = Intrinsic.usizeWrappingMultiply(values.length, layout.bytes)
  unsafe {
    let elements = Intrinsic.pointerRequalify<?[*]const T, [*]const T>(Intrinsic.pointerFromSlice<T>(values))
    let bytes = Intrinsic.pointerReinterpret<[*]const T, [*]const u8>(elements)
    return Intrinsic.pointerBorrowMany<T, u8>(values, bytes, count)
  }
}

fn exclusiveBytes<T>(values: &mut [T]) -> &mut [u8] {
  let layout = Intrinsic.layoutOf<T>()
  let count = Intrinsic.usizeWrappingMultiply(values.length, layout.bytes)
  unsafe {
    let elements = Intrinsic.pointerRequalify<?[*]mut T, [*]mut T>(Intrinsic.pointerFromMutSlice<T>(&mut values))
    let bytes = Intrinsic.pointerReinterpret<[*]mut T, [*]mut u8>(elements)
    return Intrinsic.pointerBorrowManyMut<T, u8>(move values, bytes, count)
  }
}

impl ByteView for u8 {
  fn bytes(values: &[u8]) -> &[u8] { return sharedBytes<u8>(values) }
  fn mutBytes(values: &mut [u8]) -> &mut [u8] { return exclusiveBytes<u8>(move values) }
}

impl ByteView for u16 {
  fn bytes(values: &[u16]) -> &[u8] { return sharedBytes<u16>(values) }
  fn mutBytes(values: &mut [u16]) -> &mut [u8] { return exclusiveBytes<u16>(move values) }
}

impl ByteView for u32 {
  fn bytes(values: &[u32]) -> &[u8] { return sharedBytes<u32>(values) }
  fn mutBytes(values: &mut [u32]) -> &mut [u8] { return exclusiveBytes<u32>(move values) }
}

impl ByteView for u64 {
  fn bytes(values: &[u64]) -> &[u8] { return sharedBytes<u64>(values) }
  fn mutBytes(values: &mut [u64]) -> &mut [u8] { return exclusiveBytes<u64>(move values) }
}

impl ByteView for usize {
  fn bytes(values: &[usize]) -> &[u8] { return sharedBytes<usize>(values) }
  fn mutBytes(values: &mut [usize]) -> &mut [u8] { return exclusiveBytes<usize>(move values) }
}

impl ByteView for i8 {
  fn bytes(values: &[i8]) -> &[u8] { return sharedBytes<i8>(values) }
  fn mutBytes(values: &mut [i8]) -> &mut [u8] { return exclusiveBytes<i8>(move values) }
}

impl ByteView for i16 {
  fn bytes(values: &[i16]) -> &[u8] { return sharedBytes<i16>(values) }
  fn mutBytes(values: &mut [i16]) -> &mut [u8] { return exclusiveBytes<i16>(move values) }
}

