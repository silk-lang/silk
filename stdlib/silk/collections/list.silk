//! Growable lists that own their elements, with stable sorting and binary search.
//!
//! # When to use
//! Use [`List`] when the number of elements is known only at runtime, or the sequence must grow.
//! Use a fixed array `[T; N]` when the length is part of the type. Use `silk.collections.bytes.Bytes` for a
//! block of bytes that does not grow.
//!
//! # Details
//! [`List.make`] does not allocate. The first growth allocates space for four elements, and each
//! later growth doubles the capacity. Use [`List.reserve`] or [`List.reserveExact`] to allocate
//! before a sequence of appends. Growth copies the elements into new storage before it releases the
//! old storage. Thus a failed [`List.append`] or [`List.reserve`] leaves the list unchanged.
//!
//! [`List.remove`], [`List.clear`], and [`List.truncate`] drop the elements that they remove and
//! keep the capacity. Dropping a list drops each element and then releases the storage.
//!
//! [`List.sort`] is stable and works for elements that are not `Copy`. It allocates temporary
//! storage. [`List.binarySearch`] needs a sorted list and returns the lowest index of equal
//! elements.
//!
//! # Gotchas
//! [`List.get`], [`List.set`], and [`List.remove`] trap if the index is not less than the length.
//! [`List.insert`] traps if the index is more than the length. [`List.get`] copies the element, so
//! it needs `T: Copy`. Use [`List.asSlice`] to borrow an element that is not `Copy`.
//!
//! # Examples
//! ## Grow and change a list
//! ```silk
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.core.effect { Effect }
//! import silk.collections.list { List }
//!
//! pub effect fn main() -> i32
//!   ! OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let mut values = List<i32>.make()
//!   run List<i32>.append(&mut values, 10) |> Effect.provideMut<Allocator>(&mut allocator)
//!   run List<i32>.append(&mut values, 30) |> Effect.provideMut<Allocator>(&mut allocator)
//!   run List<i32>.insert(&mut values, 1, 20) |> Effect.provideMut<Allocator>(&mut allocator)
//!   List<i32>.set(&mut values, 2, 22)
//!   let removed = List<i32>.remove(&mut values, 0)
//!
//!   // The list is now [20, 22].
//!   if removed != 10 || List<i32>.get(&values, 0) + List<i32>.get(&values, 1) != 42 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! ## Sort values and find the first equal value
//! ```silk
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.core.effect { Effect }
//! import silk.core.option { Option }
//! import silk.num.usize
//! import silk.collections.list { List }
//!
//! pub effect fn main() -> i32
//!   ! OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let mut values = List<i32>.make()
//!   run List<i32>.append(&mut values, 36) |> Effect.provideMut<Allocator>(&mut allocator)
//!   run List<i32>.append(&mut values, 3) |> Effect.provideMut<Allocator>(&mut allocator)
//!   run List<i32>.append(&mut values, 3) |> Effect.provideMut<Allocator>(&mut allocator)
//!   run List<i32>.sort(&mut values) |> Effect.provideMut<Allocator>(&mut allocator)
//!
//!   // The list is now [3, 3, 36]. The search returns the first 3.
//!   let found = List<i32>.binarySearch(&values, 3) |> Option<usize>.unwrapOr(usize.MAX)
//!   if found != usize.ZERO || List<i32>.get(&values, 2) != 36 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Collections

// A growable owned sequence over the allocation substrate. Ordinary Silk: no compiler phase
// knows this type, and every capability it uses is available to user code.
//
// The list holds one buffer whose slot count is its capacity. An empty list's buffer
// (`Intrinsic.rawBufferEmpty`) owns no storage, so the empty list stays allocation-free and every
// access reads the buffer without a storage tag. Intrinsic.replace moves the buffer out and back
// through &mut self without a partial move, and the Drop hook destroys exactly the initialized
// elements before the backing buffer releases.

import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.mem.allocator {OutOfMemoryError}
import silk.mem.layout {Layout}
import silk.mem.layout {LayoutOverflow}
import silk.core.option {Option}
import silk.core.order {Order}
import silk.core.ownership {Copy, Drop}
import silk.mem.raw_buffer {RawBuffer}
import silk.mem.slot {Slot}
import silk.num.u8
import silk.num.usize

/// A growable list that owns its elements in one contiguous allocation.
///
/// # Details
///
/// The length is the number of elements in the list. The capacity is the number of elements that
/// fit before the next growth. Dropping a list drops each element and then releases the storage. A
/// list is affine. Copy it element by element if a second list is necessary.
///
/// [`List.make`] does not allocate. The first growth allocates space for four elements, and each
/// later growth doubles the capacity. Use [`List.makeWithCapacity`] to create a list with its
/// storage in one call, or [`List.reserve`] and [`List.reserveExact`] to allocate before a sequence
/// of appends. Growth copies the elements into new storage before it releases the old storage, so a
/// failed [`List.append`] or [`List.reserve`] leaves the list unchanged. [`List.remove`],
/// [`List.clear`], and [`List.truncate`] drop the elements that they remove and keep the capacity,
/// so a list cleared in a loop reuses its storage. [`List.clearAndFree`] also releases the storage,
/// and [`List.shrinkToFit`] releases only the capacity beyond the length.
///
/// [`List.sort`] is stable, works for elements that are not `Copy`, and allocates temporary
/// storage. [`List.binarySearch`] needs a sorted list and returns the lowest index of equal
/// elements.
///
/// # Gotchas
///
/// [`List.get`], [`List.set`], and [`List.remove`] trap if the index is not less than the length.
/// [`List.insert`] traps if the index is more than the length. [`List.get`] copies the element, so
/// it needs `T: Copy`. Use [`List.asSlice`] to borrow an element that is not `Copy`.
pub struct List<T> {
  buffer: Intrinsic.RawBuffer<T>,
  count: usize,
}

impl<T> List<T> {
  /// Returns an empty list. This function does not allocate.
  ///
  /// # Details
  ///
  /// The capacity is 0. The first [`List.append`], [`List.insert`], or [`List.reserve`] allocates.
  pub fn make() -> List<T> {
    return List<T> {buffer: emptyBuffer<T>(), count: usize.ZERO}
  }
  /// Returns an empty list with storage for exactly `capacity` elements.
  ///
  /// # When to use
  ///
  /// Use `makeWithCapacity` when the number of elements is known or can be estimated before the
  /// appends, so that the list allocates once instead of growing step by step.
  ///
  /// # Details
  ///
  /// The length is 0 and the capacity is `capacity`. Appends up to that capacity do not allocate.
  /// A `capacity` of 0 does not allocate and gives the same list as [`List.make`].
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the size of `capacity` elements overflows, or the `Allocator` cannot
  ///   supply the storage.
  ///
  /// # Examples
  /// ```silk
  /// import silk.mem.allocator { Allocator, OutOfMemoryError }
  /// import silk.core.effect { Effect }
  /// import silk.collections.list { List }
  ///
  /// pub effect fn main() -> i32
  ///   ! OutOfMemoryError {
  ///   let mut allocator = Allocator.systemAllocatorProvider()
  ///   let mut values = run List<u32>.makeWithCapacity(16) |> Effect.provideMut<Allocator>(&mut allocator)
  ///   run List<u32>.append(&mut values, 7) |> Effect.provideMut<Allocator>(&mut allocator)
  ///   if List<u32>.length(&values) != 1 || List<u32>.capacity(&values) != 16 {
  ///     return 1
  ///   }
  ///   return 0
  /// }
  /// ```
  pub effect fn makeWithCapacity(capacity: usize) -> List<T> ! OutOfMemoryError ? &mut Allocator {
    let mut list = List<T> {buffer: emptyBuffer<T>(), count: usize.ZERO}
    if capacity != usize.ZERO {
      run grow<T>(&mut list, capacity)
    }
    return move list
  }
  /// Returns the number of elements in the list.
  pub fn length(self: &Self) -> usize {
    return self.count
  }
  /// Returns the number of elements that fit in the current storage before the next growth.
  pub fn capacity(self: &Self) -> usize {
    return limitOf<T>(self)
  }
  /// Returns a shared borrow of all elements as a slice, in list order.
  ///
  /// # When to use
  ///
  /// Use `asSlice` to read elements that are not `Copy`, or to give the elements to a function that
  /// takes `&[T]`.
  ///
  /// # Gotchas
  ///
  /// The slice borrows the list. The compiler rejects a change to the list, such as an append,
  /// while the slice is live.
  pub fn asSlice(self: &Self) -> &[T] {
    // The buffer holds exactly `count` initialized elements, all within its capacity, so the slice
    // starts at the buffer's base pointer instead of going through `RawBuffer.view`, whose capacity
    // check could never fail.
    unsafe {
      let start = Intrinsic.pointerFromSlice<T>(RawBuffer.view<T>(&self.buffer, usize.ZERO, usize.ZERO))
      let base = Intrinsic.pointerRequalify<?[*]const T, [*]const T>(start)
      return Intrinsic.pointerBorrowMany<Self, T>(self, base, self.count)
    }
  }
  /// Returns an exclusive borrow of all elements as a slice, in list order.
  ///
  /// # When to use
  ///
  /// Use `asMutSlice` to change elements in place, such as in a loop over all elements.
  ///
  /// # Gotchas
  ///
  /// The slice cannot change the length. The compiler rejects other uses of the list while the
  /// slice is live.
  pub fn asMutSlice(self: &mut Self) -> &mut [T] {
    // The buffer holds exactly `count` initialized elements, all within its capacity; see `asSlice`.
    unsafe {
      let mut empty = RawBuffer.viewMut<T>(&mut self.buffer, usize.ZERO, usize.ZERO)
      let base = Intrinsic.pointerRequalify<?[*]mut T, [*]mut T>(Intrinsic.pointerFromMutSlice<T>(&mut empty))
      let count = self.count
      return Intrinsic.pointerBorrowManyMut<Self, T>(&mut self, base, count)
    }
  }
  /// Adds `value` at the end of the list.
  ///
  /// # Details
  ///
  /// The list takes ownership of `value`. If the list is full, it grows: the first growth allocates
  /// space for four elements, and each later growth doubles the capacity.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the new storage. The list does not
  ///   change.
  @inlineAlways
  pub effect<'env> fn append<'env>(self: &mut Self, value: T) -> () ! OutOfMemoryError ? &mut Allocator {
    if self.count == limitOf<T>(&self.*) {
      run growForAppend<T>(&mut self.*)
    }
    let index = self.count
    let _written = writeInto<T>(&mut self.buffer, index, move value)
    self.count = index + usize.ONE
    return ()
  }
  /// Inserts `value` at position `index` and moves the elements from `index` onward one position to
  /// the right.
  ///
  /// # Details
  ///
  /// `index` equal to [`List.length`] appends the value. The move of the later elements takes time
  /// in proportion to their number. `T` does not need to be `Copy`.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the new storage. The list does not
  ///   change.
  ///
  /// # Gotchas
  ///
  /// If `index` is more than [`List.length`], the program traps.
  pub effect<'env> fn insert<'env>(self: &mut Self, index: usize, value: T) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
    if self.count < index {
      Intrinsic.trap("List.insert: the index is greater than the length")
    }
    if self.count == limitOf<T>(&self.*) {
      let next = grownCapacity(limitOf<T>(&self.*), self.count + usize.ONE)
      run grow<T>(&mut self.*, next)
    }
    let length = self.count
    let _inserted = insertInto<T>(&mut self.buffer, index, length, move value)
    self.count = length + usize.ONE
    return ()
  }
  /// Returns a copy of the element at position `index`.
  ///
  /// # When to use
  ///
  /// Use `get` when `T` is `Copy`. Use [`List.asSlice`] to borrow an element that is not `Copy`.
  ///
  /// # Gotchas
  ///
  /// If `index` is not less than [`List.length`], the program traps.
  @inlineAlways
  pub fn get<T: Copy>(self: &Self, index: usize) -> T {
    if self.count <= index {
      Intrinsic.trap("List.get: the index is not less than the length")
    }
    let read = Read<T> {value: readAt<T>(&self.buffer, index)}
    return match move read {
      Read<T> {value} => move value
    }
  }
  /// Removes the last element and returns it. Returns `None` if the list is empty.
  ///
  /// # Details
  ///
  /// The caller owns the returned element. The capacity does not change.
  pub fn pop(self: &mut Self) -> Option<T> {
    if self.count == usize.ZERO {
      return Option<T>.none()
    }
    let index = self.count - usize.ONE
    let value = takeFrom<T>(&mut self.buffer, index)
    self.count = index
    return Option<T>.some(move value)
  }
  /// Removes the element at position `index`, returns it, and moves the later elements one position
  /// to the left.
  ///
  /// # Details
  ///
  /// The caller owns the returned element. The capacity does not change. Use [`List.pop`] to remove
  /// the last element without a move of other elements.
  ///
  /// # Gotchas
  ///
  /// If `index` is not less than [`List.length`], the program traps.
  pub fn remove(self: &mut Self, index: usize) -> T {
    if self.count <= index {
      Intrinsic.trap("List.remove: the index is not less than the length")
    }
    let length = self.count
    let value = removeFrom<T>(&mut self.buffer, index, length)
    self.count = length - usize.ONE
    return move value
  }
  /// Drops all elements and sets the length to 0. The capacity does not change.
  ///
  /// # When to use
  ///
  /// Use `clear` to reuse a list, such as a buffer filled again on each pass of a loop: later
  /// appends up to the old capacity do not allocate. Use [`List.clearAndFree`] to also release the
  /// storage.
  pub fn clear(self: &mut Self) -> () {
    return List<T>.truncate(move self, usize.ZERO)
  }
  /// Drops all elements and releases the storage. The length and the capacity become 0.
  ///
  /// # When to use
  ///
  /// Use `clearAndFree` when the list stays alive but its storage is no longer needed, such as a
  /// large buffer that is kept for rare later use. Use [`List.clear`] to keep the storage for
  /// reuse.
  ///
  /// # Details
  ///
  /// This function does not allocate and does not need an `Allocator`. The next append allocates
  /// again, as on a list from [`List.make`].
  pub fn clearAndFree(self: &mut Self) -> () {
    let buffer = Intrinsic.replace(self.buffer, emptyBuffer<T>())
    let count = Intrinsic.replace(self.count, usize.ZERO)
    return releaseBuffer<T>(move buffer, count)
  }
  /// Drops the elements from position `length` to the end. The capacity does not change.
  ///
  /// # Details
  ///
  /// If `length` is more than or equal to the current length, this function does nothing.
  pub fn truncate(self: &mut Self, length: usize) -> () {
    if self.count <= length {
      return ()
    }
    let end = self.count
    let _dropped = dropRange<T>(&mut self.buffer, length, end)
    self.count = length
    return ()
  }
  /// Replaces the element at position `index` with `value` and drops the old element.
  ///
  /// # Gotchas
  ///
  /// If `index` is not less than [`List.length`], the program traps.
  @inlineAlways
  pub fn set(self: &mut Self, index: usize, value: T) -> () {
    if self.count <= index {
      Intrinsic.trap("List.set: the index is not less than the length")
    }
    let _replaced = replaceIn<T>(&mut self.buffer, index, move value)
    return ()
  }
  /// Makes sure that at least `additional` more elements fit without another allocation.
  ///
  /// # When to use
  ///
  /// Use `reserve` before a loop of appends when the number of new elements is known. Use
  /// [`List.reserveExact`] when the final length is known and extra capacity is not wanted.
  ///
  /// # Details
  ///
  /// If the capacity is already sufficient, this function does nothing. Otherwise, it grows the
  /// capacity by doubling until the elements fit. The length does not change.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if `length + additional` overflows `usize`, or the `Allocator` cannot
  ///   supply the new storage. The list does not change.
  @inlineAlways
  pub effect fn reserve(self: &mut Self, additional: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
    if additional <= limitOf<T>(&self.*) - self.count {
      return ()
    }
    run growReserve<T>(&mut self.*, additional)
    return ()
  }
  /// Makes sure that at least `additional` more elements fit, with no extra capacity.
  ///
  /// # When to use
  ///
  /// Use `reserveExact` when the final length is known, such as before a copy of a slice. Use
  /// [`List.reserve`] when more appends can follow.
  ///
  /// # Details
  ///
  /// If the capacity is already sufficient, this function does nothing and does not shrink the
  /// storage. Otherwise, it allocates storage for exactly `length + additional` elements. The
  /// length does not change.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if `length + additional` overflows `usize`, or the `Allocator` cannot
  ///   supply the new storage. The list does not change.
  @inlineAlways
  pub effect fn reserveExact(self: &mut Self, additional: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
    if additional <= limitOf<T>(&self.*) - self.count {
      return ()
    }
    run growExact<T>(&mut self.*, additional)
    return ()
  }
  /// Releases the capacity beyond the length.
  ///
  /// # When to use
  ///
  /// Use `shrinkToFit` on a list that is complete and kept for a long time, so that the spare room
  /// left by doubling growth does not stay allocated.
  ///
  /// # Details
  ///
  /// If the capacity equals the length, this function does nothing. If the list is empty, it
  /// releases the storage, and the capacity becomes 0. Otherwise, it moves the elements into
  /// storage for exactly the length. The length does not change.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the new storage. The list does not
  ///   change. An empty list never fails.
  pub effect fn shrinkToFit(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    if self.count == limitOf<T>(&self.*) {
      return ()
    }
    if self.count == usize.ZERO {
      return List<T>.clearAndFree(&mut self.*)
    }
    let length = self.count
    run grow<T>(&mut self.*, length)
    return ()
  }
  /// Sorts the elements in place, in ascending order of the `Order` conformance of `T`.
  ///
  /// # Details
  ///
  /// The sort is stable: equal elements keep their order. The result is deterministic. The sort
  /// works for elements that are not `Copy`. It allocates temporary storage from the active
  /// `Allocator`.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the temporary storage. The list does not
  ///   change.
  pub effect fn sort<T: Order>(self: &mut Self) -> () ! OutOfMemoryError ? &mut Allocator {
    let count = self.count
    if count <= usize.ONE {
      return ()
    }
    let element = Layout.of<T>()
    let plan = Layout.repeat(move element, count)
    let layout = match move plan {
      Layout ready => move ready
      LayoutOverflow _overflow => run overflowed()
    }
    let recipe = Allocator.allocate(move layout)
    let allocation = run recipe
    let scratch = freshBuffer<T>(move allocation, count)
    let mut order = List<usize>.make()
    let mut spare = List<usize>.make()
    run List<usize>.reserveExact(&mut order, count)
    run List<usize>.reserveExact(&mut spare, count)
    let mut seed = usize.ZERO
    while seed < count {
      let _placed = run List<usize>.append(&mut order, seed)
      let _staged = run List<usize>.append(&mut spare, seed)
      seed = seed + usize.ONE
    }
    let mut owned = Intrinsic.replace(self.buffer, emptyBuffer<T>())
    let mut width = usize.ONE
    while width < count {
      let mut low = usize.ZERO
      while low < count {
        let mut middle = low + width
        if count < middle {
          middle = count
        }
        let mut high = middle + width
        if count < high {
          high = count
        }
        let mut left = low
        let mut right = middle
        let mut cursor = low
        while cursor < high {
          // The right run wins a position only when it compares strictly less, so equal elements
          // leave the left run first and the sort is stable.
          let mut takeRight = true
          if left < middle {
            takeRight = false
            if right < high {
              let indices = List<usize>.asSlice(&order)
              // `order` permutes 0..count and no element has moved yet, so each named slot is
              // initialized.
              unsafe {
                let after = RawBuffer.view<T>(&owned, indices[right], usize.ONE)
                let before = RawBuffer.view<T>(&owned, indices[left], usize.ONE)
                takeRight = (&after[usize.ZERO]) < (&before[usize.ZERO])
              }
            }
          }
          let mut picked = usize.ZERO
          if takeRight {
            let indices = List<usize>.asSlice(&order)
            picked = indices[right]
            right = right + usize.ONE
          } else {
            let indices = List<usize>.asSlice(&order)
            picked = indices[left]
            left = left + usize.ONE
          }
          let mut slots = List<usize>.asMutSlice(&mut spare)
          slots[cursor] = picked
          cursor = cursor + usize.ONE
        }
        low = high
      }
      let mut back = usize.ZERO
      while back < count {
        let staged = List<usize>.asSlice(&spare)
        let value = staged[back]
        let mut slots = List<usize>.asMutSlice(&mut order)
        slots[back] = value
        back = back + usize.ONE
      }
      width = width + width
    }
    let applied = applyOrder<T>(move owned, move scratch, List<usize>.asSlice(&order), count)
    let sorted = match move applied {
      Applied<T> {buffer, scratch: leftover} => releaseScratch<T>(move buffer, move leftover)
    }
    let unsorted = Intrinsic.replace(self.buffer, move sorted)
    drop unsorted
    return ()
  }
  /// Returns the position of an element equal to `target` in a sorted list, or `None` if no element
  /// is equal.
  ///
  /// # Details
  ///
  /// If more than one element is equal to `target`, the result is the lowest position. The search
  /// takes time in proportion to the logarithm of the length. This function consumes `target` and
  /// does not change the list.
  ///
  /// # Gotchas
  ///
  /// The list must be sorted in ascending order by the same `Order` conformance, for example by
  /// [`List.sort`]. For a list that is not sorted, the result has no meaning.
  pub fn binarySearch<T: Order>(self: &Self, target: T) -> Option<usize> {
    let two = usize.ONE + usize.ONE
    let values = List<T>.asSlice(self)
    let mut low = usize.ZERO
    let mut high = self.count
    while low < high {
      let middle = low + (high - low) / two
      if (&values[middle]) < (&target) {
        low = middle + usize.ONE
      } else {
        high = middle
      }
    }
    if low < self.count {
      if !((&target) < (&values[low])) {
        return Option<usize>.some(low)
      }
    }
    return Option<usize>.none()
  }
}

// Diverges on the arms the surrounding logic has already proven impossible.
fn absurd<T>() -> T {
  return Intrinsic.trap("List: an internal state the surrounding logic ruled out was reached")
}

// A buffer of no slots that owns no storage; releasing it frees nothing.
fn emptyBuffer<T>() -> Intrinsic.RawBuffer<T> {
  return Intrinsic.rawBufferEmpty<T>()
}

// Drops the elements in place. The buffer field's own drop then releases the storage, so a list's
// drop is one storage release with no buffer swapped out and back.
impl<T> Drop for List<T> {
  fn drop(self: &mut List<T>) -> () {
    return dropRange<T>(&mut self.buffer, usize.ZERO, self.count)
  }
}

fn releaseBuffer<T>(buffer: Intrinsic.RawBuffer<T>, length: usize) -> () {
  unsafe {
    let mut owned = move buffer
    dropRange<T>(&mut owned, usize.ZERO, length)
    drop owned
  }
  return ()
}

// Bulk appends. Each takes `T: Copy`: the copy reads the source range out of a borrowed slice, and
// that is only a copy, not a move, when the element type is Copy.
impl<T> List<T> {
  /// Adds a copy of each byte of `values` at the end of the list, in order.
  ///
  /// # When to use
  ///
  /// Use `appendBytes` to add many bytes at once. It copies the bytes in one operation, which is
  /// faster than one [`List.append`] for each byte. [`List.appendSlice`] does the same for any
  /// `Copy` element type.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the new storage. The list does not
  ///   change.
  @inlineAlways
  pub effect fn appendBytes(self: &mut List<u8>, values: &[u8]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
    return run List<u8>.appendSlice(&mut self.*, values)
  }
  /// Adds a copy of each element of `values` at the end of the list, in order.
  ///
  /// # When to use
  ///
  /// Use `appendSlice` to add many elements at once. It grows the list once and copies the elements
  /// in one operation, which is faster than one [`List.append`] for each element.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the new storage. The list does not
  ///   change.
  ///
  /// # Examples
  /// ```silk
  /// import silk.mem.allocator { Allocator, OutOfMemoryError }
  /// import silk.core.effect { Effect }
  /// import silk.collections.list { List }
  ///
  /// pub effect fn main() -> i32
  ///   ! OutOfMemoryError {
  ///   let mut allocator = Allocator.systemAllocatorProvider()
  ///   let mut values = List<u16>.make()
  ///   let more: [u16; 2] = [8, 9]
  ///   run List<u16>.appendSlice(&mut values, &more) |> Effect.provideMut<Allocator>(&mut allocator)
  ///   if List<u16>.length(&values) != 2 || List<u16>.get(&values, 1) != 9 {
  ///     return 1
  ///   }
  ///   return 0
  /// }
  /// ```
  @inlineAlways
  pub effect fn appendSlice<T: Copy>(self: &mut Self, values: &[T]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
    let count = values.length
    if count == usize.ZERO {
      return ()
    }
    let offset = self.count
    let needed = offset + count
    if limitOf<T>(&self.*) < needed {
      run growTo<T>(&mut self.*, needed)
    }
    let _copied = copyInto<T>(&mut self.buffer, offset, values, count)
    self.count = needed
    return ()
  }
  /// Adds `count` copies of `value` at the end of the list.
  ///
  /// # Details
  ///
  /// The list grows at most once, and the copies are written in one tight loop with no call or
  /// capacity check for each element. For `u8` the loop compiles to a `memset`. A `count` of 0 does
  /// nothing and does not allocate.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if `length + count` overflows `usize`, or the `Allocator` cannot supply
  ///   the new storage. The list does not change.
  ///
  /// # Examples
  /// ```silk
  /// import silk.mem.allocator { Allocator, OutOfMemoryError }
  /// import silk.core.effect { Effect }
  /// import silk.collections.list { List }
  ///
  /// pub effect fn main() -> i32
  ///   ! OutOfMemoryError {
  ///   let mut allocator = Allocator.systemAllocatorProvider()
  ///   let mut levels = List<u16>.make()
  ///   run List<u16>.appendRepeated(&mut levels, 65535, 4) |> Effect.provideMut<Allocator>(&mut allocator)
  ///   if List<u16>.length(&levels) != 4 || List<u16>.get(&levels, 3) != 65535 {
  ///     return 1
  ///   }
  ///   return 0
  /// }
  /// ```
  @inlineAlways
  pub effect fn appendRepeated<T: Copy>(self: &mut Self, value: T, count: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
    if count == usize.ZERO {
      return ()
    }
    let offset = self.count
    let needed = match move usize.checkedAdd(offset, count) {
      Option<usize>.Some {value: total} => total
      Option<usize>.None => run Allocator.outOfMemory()
    }
    if limitOf<T>(&self.*) < needed { run growTo<T>(&mut self.*, needed) }
    let _filled = fillInto<T>(&mut self.buffer, offset, count, value)
    self.count = needed
    return ()
  }
  /// Inserts a copy of each element of `values` at position `index`, in order, and moves the
  /// elements from `index` onward `values.length` positions to the right.
  ///
  /// # When to use
  ///
  /// Use `insertSlice` to insert many elements at once. It grows the list at most once and moves
  /// the later elements with one overlapping copy, where one [`List.insert`] for each element moves
  /// them once per element.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the new storage. The list does not
  ///   change.
  ///
  /// # Gotchas
  ///
  /// If `index` is more than [`List.length`], the program traps.
  ///
  /// # Examples
  /// ```silk
  /// import silk.mem.allocator { Allocator, OutOfMemoryError }
  /// import silk.core.effect { Effect }
  /// import silk.collections.list { List }
  ///
  /// pub effect fn main() -> i32
  ///   ! OutOfMemoryError {
  ///   let mut allocator = Allocator.systemAllocatorProvider()
  ///   let mut values = List<u16>.make()
  ///   let ends: [u16; 2] = [1, 4]
  ///   let middle: [u16; 2] = [2, 3]
  ///   run List<u16>.appendSlice(&mut values, &ends) |> Effect.provideMut<Allocator>(&mut allocator)
  ///   run List<u16>.insertSlice(&mut values, 1, &middle) |> Effect.provideMut<Allocator>(&mut allocator)
  ///   if List<u16>.length(&values) != 4 || List<u16>.get(&values, 2) != 3 || List<u16>.get(&values, 3) != 4 {
  ///     return 1
  ///   }
  ///   return 0
  /// }
  /// ```
  pub effect fn insertSlice<T: Copy>(self: &mut Self, index: usize, values: &[T]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
    if self.count < index {
      Intrinsic.trap("List.insertSlice: the index is greater than the length")
    }
    let count = values.length
    if count == usize.ZERO {
      return ()
    }
    let length = self.count
    let needed = match move usize.checkedAdd(length, count) {
      Option<usize>.Some {value: total} => total
      Option<usize>.None => run Allocator.outOfMemory()
    }
    if limitOf<T>(&self.*) < needed { run growTo<T>(&mut self.*, needed) }
    let _opened = openGap<T>(&mut self.buffer, index, length, count)
    let _copied = copyInto<T>(&mut self.buffer, index, values, count)
    self.count = needed
    return ()
  }
  /// Inserts `count` copies of `value` at position `index` and moves the elements from `index`
  /// onward `count` positions to the right.
  ///
  /// # Details
  ///
  /// The list grows at most once, the later elements move with one overlapping copy, and the copies
  /// are written in one tight loop. A `count` of 0 does nothing and does not allocate.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if `length + count` overflows `usize`, or the `Allocator` cannot supply
  ///   the new storage. The list does not change.
  ///
  /// # Gotchas
  ///
  /// If `index` is more than [`List.length`], the program traps.
  ///
  /// # Examples
  /// ```silk
  /// import silk.mem.allocator { Allocator, OutOfMemoryError }
  /// import silk.core.effect { Effect }
  /// import silk.collections.list { List }
  ///
  /// pub effect fn main() -> i32
  ///   ! OutOfMemoryError {
  ///   let mut allocator = Allocator.systemAllocatorProvider()
  ///   let mut values = List<u16>.make()
  ///   let ends: [u16; 2] = [1, 9]
  ///   run List<u16>.appendSlice(&mut values, &ends) |> Effect.provideMut<Allocator>(&mut allocator)
  ///   run List<u16>.insertRepeated(&mut values, 1, 5, 3) |> Effect.provideMut<Allocator>(&mut allocator)
  ///   if List<u16>.length(&values) != 5 || List<u16>.get(&values, 3) != 5 || List<u16>.get(&values, 4) != 9 {
  ///     return 1
  ///   }
  ///   return 0
  /// }
  /// ```
  pub effect fn insertRepeated<T: Copy>(self: &mut Self, index: usize, value: T, count: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
    if self.count < index {
      Intrinsic.trap("List.insertRepeated: the index is greater than the length")
    }
    if count == usize.ZERO {
      return ()
    }
    let length = self.count
    let needed = match move usize.checkedAdd(length, count) {
      Option<usize>.Some {value: total} => total
      Option<usize>.None => run Allocator.outOfMemory()
    }
    if limitOf<T>(&self.*) < needed { run growTo<T>(&mut self.*, needed) }
    let _opened = openGap<T>(&mut self.buffer, index, length, count)
    let _filled = fillInto<T>(&mut self.buffer, index, count, value)
    self.count = needed
    return ()
  }
}

effect fn overflowed() -> Layout ! OutOfMemoryError {
  return run Allocator.outOfMemory()
}

// Growth is atomic: the replacement buffer exists and holds every element before the list's
// storage commits, so a failed allocation leaves the original untouched.
//
// One body serves every growth, the first included: an empty list moves no elements, and its old
// storage releases like any other. Keeping this body small matters because each element type
// instantiates it.
effect fn grow<T>(self: &mut List<T>, next: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  // Under the system provider, heap storage grows in place first: the heap can extend the block,
  // or remap a large one without copying its pages (#2641). Any other provider sees a new request.
  if self.count != usize.ZERO && run Allocator.growsInPlace() {
    let mut resized = false
    unsafe { resized = RawBuffer.resize<T>(&mut self.buffer, next) }
    if resized { return () }
  }
  let plan = Layout.repeat(Layout.of<T>(), next)
  let layout = match move plan {
    Layout ready => move ready
    LayoutOverflow _overflow => run overflowed()
  }
  let allocation = run Allocator.allocate(move layout)
  let mut target = freshBuffer<T>(move allocation, next)
  if self.count != usize.ZERO {
    unsafe {
      let initialized = RawBuffer.view<T>(&self.buffer, usize.ZERO, self.count)
      let _moved = RawBuffer.copy<T>(&mut target, usize.ZERO, initialized, self.count)
    }
  }
  let old = Intrinsic.replace(self.buffer, move target)
  drop old
  return ()
}

// The growth path of the bulk appends, kept out of line like `growForAppend`.
@inlineNever
effect fn growTo<T>(self: &mut List<T>, needed: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let next = grownCapacity(limitOf<T>(&self.*), needed)
  return run grow<T>(&mut self.*, next)
}

// The growing path of `reserve`, kept out of line so the inlined fast path is one capacity check.
// `additional` is more than the spare capacity here.
@inlineNever
effect fn growReserve<T>(self: &mut List<T>, additional: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let needed = match move usize.checkedAdd(self.count, additional) {
    Option<usize>.Some {value} => value
    Option<usize>.None => run Allocator.outOfMemory()
  }
  let next = grownCapacity(limitOf<T>(&self.*), needed)
  return run grow<T>(&mut self.*, next)
}

// The growing path of `reserveExact`, kept out of line so the inlined fast path is one capacity
// check. `additional` is more than the spare capacity here.
@inlineNever
effect fn growExact<T>(self: &mut List<T>, additional: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  let needed = match move usize.checkedAdd(self.count, additional) {
    Option<usize>.Some {value} => value
    Option<usize>.None => run Allocator.outOfMemory()
  }
  return run grow<T>(&mut self.*, needed)
}

// The full-list path of `append`, kept out of line so the inlined fast path is only the capacity
// check, the element write and the count update.
@inlineNever
effect fn growForAppend<T>(self: &mut List<T>) -> () ! OutOfMemoryError ? &mut Allocator {
  let next = grownCapacity(limitOf<T>(&self.*), self.count + usize.ONE)
  return run grow<T>(&mut self.*, next)
}

// The capacity lives in the buffer's slot count, so the list does not store it a second time.
fn limitOf<T>(list: &List<T>) -> usize {
  return RawBuffer.count<T>(&list.buffer)
}

// The geometric capacity that holds `needed` elements: four on first growth, then doubling. When
// doubling would overflow `usize`, the capacity is exactly `needed`, so the allocation reports the
// shortage as OutOfMemoryError instead of trapping.
fn grownCapacity(limit: usize, needed: usize) -> usize {
  let mut next: usize = 4
  if limit != usize.ZERO {
    next = doubled(limit, needed)
  }
  while next < needed {
    next = doubled(next, needed)
  }
  return next
}

// Twice `capacity`, or `needed` when that overflows `usize`.
fn doubled(capacity: usize, needed: usize) -> usize {
  return match move usize.checkedAdd(capacity, capacity) {
    Option<usize>.Some {value} => value
    Option<usize>.None => needed
  }
}

// Element access borrows the buffer in place, so an operation never moves it out of the list and
// back.

fn writeInto<T>(buffer: &mut Intrinsic.RawBuffer<T>, index: usize, value: T) -> () {
  unsafe {
    let selected = RawBuffer.slot<T>(move buffer, index)
    let _written = Slot.write<T>(move selected, move value)
  }
  return ()
}

fn takeFrom<T>(buffer: &mut Intrinsic.RawBuffer<T>, index: usize) -> T {
  unsafe {
    let selected = RawBuffer.slot<T>(move buffer, index)
    return Slot.take<T>(move selected)
  }
  return absurd<T>()
}

fn replaceIn<T>(buffer: &mut Intrinsic.RawBuffer<T>, index: usize, value: T) -> () {
  unsafe {
    let selected = RawBuffer.slot<T>(&mut buffer.*, index)
    let _cleared = Slot.dropValue<T>(move selected)
    let target = RawBuffer.slot<T>(move buffer, index)
    let _written = Slot.write<T>(move target, move value)
  }
  return ()
}

fn copyInto<T: Copy>(buffer: &mut Intrinsic.RawBuffer<T>, offset: usize, values: &[T], count: usize) -> () {
  unsafe {
    let _copied = RawBuffer.copy<T>(move buffer, offset, values, count)
  }
  return ()
}

// The caller grew the buffer, so the range is in bounds and checked once by the view. The slots are
// not initialized yet, but `T` is Copy, so the writes never read or drop an old value.
fn fillInto<T: Copy>(buffer: &mut Intrinsic.RawBuffer<T>, offset: usize, count: usize, value: T) -> () {
  unsafe {
    let mut slots = RawBuffer.viewMut<T>(move buffer, offset, count)
    let output = Intrinsic.pointerRequalify<?[*]mut T, [*]mut T>(Intrinsic.pointerFromMutSlice<T>(&mut slots))
    let mut index = usize.ZERO
    while index < count {
      Intrinsic.pointerWrite<T>(Intrinsic.pointerAtMut<T>(output, index), value)
      index = index + usize.ONE
    }
  }
  return ()
}

// Moves the elements from `index` up `count` slots with one overlapping copy. The caller grew the
// buffer and fills the `count` slots from `index`, which are uninitialized until then.
fn openGap<T>(buffer: &mut Intrinsic.RawBuffer<T>, index: usize, length: usize, count: usize) -> () {
  unsafe {
    if index < length {
      let tail = moved<usize, T>(&length, &buffer.*, index, length - index)
      RawBuffer.copy<T>(&mut buffer.*, index + count, tail, length - index)
    }
  }
  return ()
}

// Moves the elements from `index` up one slot with one overlapping copy, then writes the value into
// the hole. Every move is bitwise, so the slot left at `index` is uninitialized until the write.
fn insertInto<T>(buffer: &mut Intrinsic.RawBuffer<T>, index: usize, length: usize, value: T) -> () {
  unsafe {
    if index < length {
      let tail = moved<usize, T>(&length, &buffer.*, index, length - index)
      RawBuffer.copy<T>(&mut buffer.*, index + usize.ONE, tail, length - index)
    }
    let selected = RawBuffer.slot<T>(move buffer, index)
    let _written = Slot.write<T>(move selected, move value)
  }
  return ()
}

// Takes the element out first, then closes the hole by moving every later element down one slot
// with one overlapping copy.
fn removeFrom<T>(buffer: &mut Intrinsic.RawBuffer<T>, index: usize, length: usize) -> T {
  unsafe {
    let selected = RawBuffer.slot<T>(&mut buffer.*, index)
    let value = Slot.take<T>(move selected)
    let after = index + usize.ONE
    if after < length {
      let tail = moved<usize, T>(&length, &buffer.*, after, length - after)
      RawBuffer.copy<T>(&mut buffer.*, index, tail, length - after)
    }
    return move value
  }
  return absurd<T>()
}

// The `count` initialized slots from `start`, as a slice that borrows `anchor` instead of `buffer`,
// so the caller can move them to another range of the same buffer. The slice reads the buffer
// through a second view of its descriptor; the caller must not read it after the move.
unsafe fn moved<'a, A, T>(anchor: &'a A, buffer: &Intrinsic.RawBuffer<T>, start: usize, count: usize) -> &'a [T] {
  unsafe {
    let descriptor = Intrinsic.pointerFromRef<Intrinsic.RawBuffer<T>>(buffer)
    let alias = Intrinsic.pointerBorrow<A, Intrinsic.RawBuffer<T>>(anchor, descriptor)
    return RawBuffer.view<T>(alias, start, count)
  }
}

// Callers pass a range inside the list's count, which never exceeds the buffer's capacity, so the
// elements are reached through the buffer's base pointer instead of `RawBuffer.slot`, whose own
// capacity check could never fail. Without the check, a list of elements with no drop glue drops
// with no per-element work at all.
fn dropRange<T>(buffer: &mut Intrinsic.RawBuffer<T>, from: usize, to: usize) -> () {
  unsafe {
    let mut empty = RawBuffer.viewMut<T>(&mut buffer.*, usize.ZERO, usize.ZERO)
    let base = Intrinsic.pointerRequalify<?[*]mut T, [*]mut T>(Intrinsic.pointerFromMutSlice<T>(&mut empty))
    let mut index = from
    while index < to {
      drop Intrinsic.pointerTake<T>(Intrinsic.pointerAtMut<T>(base, index))
      index = index + usize.ONE
    }
  }
  return ()
}

fn freshBuffer<T>(allocation: Intrinsic.Allocation, count: usize) -> Intrinsic.RawBuffer<T> {
  unsafe {
    let made = RawBuffer.from<T>(move allocation, count)
    return move made
  }
  return absurd<Intrinsic.RawBuffer<T>>()
}

struct Read<T> {
  value: T,
}

impl<T: Copy> Copy for Read<T> {}

// Reads the element at `index`, which the caller has already checked against the list's count.
// The count never exceeds the buffer's capacity, so the read goes through the buffer's base
// pointer instead of `RawBuffer.read`, whose own capacity check could never fail.
fn readAt<T: Copy>(buffer: &Intrinsic.RawBuffer<T>, index: usize) -> T {
  unsafe {
    let start = Intrinsic.pointerFromSlice<T>(RawBuffer.view<T>(buffer, usize.ZERO, usize.ZERO))
    let base = Intrinsic.pointerRequalify<?[*]const T, [*]const T>(start)
    return Intrinsic.pointerRead<T>(Intrinsic.pointerAt<T>(base, index))
  }
  return absurd<T>()
}

// Ordering. A bottom-up merge sort over a permutation of the element indices, so it is stable, and
// deterministic because every comparison and every exchange is decided by the run boundaries alone
// and never by an address, a capacity, or a target detail. The same input therefore produces the
// same output for every LLVM target.
//
// Merging cannot happen in place, so the sort allocates and carries `! OutOfMemoryError ? &mut Allocator`.
// An insertion sort would need no allocation and no requirement, but it costs O(n^2), and the two
// signatures are not source-compatible, so the choice cannot be deferred to a later release.
//
// The sort orders indices first and moves elements only once, at the end: each element is taken from
// its old slot into the scratch buffer exactly once and the whole prefix travels back in one bulk
// move. An element is therefore never read out of a borrowed place, never duplicated, and never
// dropped twice, and the movement itself never requires the element type to be Copy.
//
// `sort` is one single body rather than the helper chain the rest of this file uses because a bound
// is not carried into a nested generic call: a `T: Order` body cannot pass its own `T` to another
// `T: Order` function. Every helper `sort` calls is therefore unbounded, and every comparison is
// written here.

struct Applied<T> {
  buffer: Intrinsic.RawBuffer<T>,
  scratch: Intrinsic.RawBuffer<T>,
}

// Moves every element into the scratch buffer in the order the permutation names, then returns the
// whole prefix in one bulk move. Every source slot is taken exactly once because the permutation is
// a bijection, so nothing leaks and nothing is dropped twice.
fn applyOrder<T>(buffer: Intrinsic.RawBuffer<T>, scratch: Intrinsic.RawBuffer<T>, order: &[usize], count: usize) -> Applied<
  T,
> {
  let mut owned = move buffer
  let mut staging = move scratch
  unsafe {
    let mut index = usize.ZERO
    while index < count {
      let selected = RawBuffer.slot(&mut owned, order[index])
      let value = Slot.take(move selected)
      let destination = RawBuffer.slot(&mut staging, index)
      let _written = Slot.write(move destination, move value)
      index = index + usize.ONE
    }
  }
  // The loop above filled scratch slots 0..count and emptied every source slot, so the bulk move
  // reads only initialized slots and overwrites only vacated ones.
  unsafe {
    let merged = RawBuffer.view<T>(&staging, usize.ZERO, count)
    let _moved = RawBuffer.copy<T>(&mut owned, usize.ZERO, merged, count)
  }
  return Applied<T> {buffer: move owned, scratch: move staging}
}

// The scratch buffer holds no initialized element once the bulk move returns, so releasing it
// destroys nothing.
fn releaseScratch<T>(buffer: Intrinsic.RawBuffer<T>, leftover: Intrinsic.RawBuffer<T>) -> Intrinsic.RawBuffer<T> {
  unsafe {
    let spent = move leftover
    drop spent
  }
  return move buffer
}
