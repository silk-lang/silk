//! Deterministic seeded hashing for hash maps, hash sets, and key types that users define.
//!
//! # When to use
//! `string` and every integer type implement [`HashKey`], so `HashMap<string, i32>` and
//! `HashSet<u64>` work without more code. Implement [`HashKey`] for your own type that is a key of a
//! `HashMap` or an element of a `HashSet`. In the `hash` member, use [`Hash.mix`] for the first
//! integer field and [`Hash.combine`] for each other field that `equals` compares.
//!
//! # Details
//! A [`HashSeed`] belongs to a collection, not to a key. The same seed, keys, and operations give
//! the same results and the same bucket order on each supported target. The results do not depend
//! on addresses, clocks, or other state. The compiler selects `HashKey` conformances during
//! specialization, so there is no runtime dispatch.
//!
//! # Gotchas
//! If `HashKey.equals` returns `true` for two values, `HashKey.hash` must return the same value for
//! both, for each seed. A collection cannot find a conformance that breaks this rule. If the rule
//! is broken, a key in the collection can become impossible to find.
//!
//! The hash is deterministic. It does not protect against inputs that an attacker selects to make
//! collisions.
//!
//! # Examples
//! ## Implement a key for a struct with two fields
//! ```silk
//! import silk.collections.hash { Hash, HashKey, HashSeed }
//!
//! struct Point {
//!   x: u64,
//!   y: u64,
//! }
//!
//! fn pointEquals(left: &Point, right: &Point) -> bool {
//!   return left.x == right.x && left.y == right.y
//! }
//!
//! fn pointHash(value: &Point, seed: &HashSeed) -> u64 {
//!   return Hash.mix(seed, value.x) |> Hash.combine(value.y)
//! }
//!
//! impl HashKey for Point {
//!   equals: Point.pointEquals
//!
//!   hash: Point.pointHash
//! }
//!
//! pub fn main() -> i32 {
//!   let seed = Hash.seed(17)
//!   let first = Point { x: 4, y: 9 }
//!   let second = Point { x: 4, y: 9 }
//!   if HashKey.hash(&first, &seed) != HashKey.hash(&second, &seed) {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Collections

// The hashing contract the hashed collections resolve against, and the seed every hash is computed
// under. Ordinary Silk: no compiler phase computes a hash, recognizes this interface by spelling, or
// treats a conformance to it as anything other than an ordinary conformance.
//
// The contract pairs an equivalence with a hash because a hashed collection needs both and needs
// them to agree. Both are reached by naming the bound, as `HashKey.equals` and `HashKey.hash`; the
// `==` operator belongs to `silk.core.equal.Equal`, which a key type may implement separately.

import silk.core.bool
import silk.num.i16
import silk.num.i32
import silk.num.i64
import silk.num.i8
import silk.num.isize
import silk.core.ownership { Copy }
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.u8
import silk.num.usize

/// The owner type of the seed and mix operations. It has no fields and is never constructed.
pub struct Hash {}

impl Hash {
  /// Returns a [`HashSeed`] made from `value`.
  ///
  /// # Details
  ///
  /// The same `value` always gives the same seed. To get a different bucket order for each run of a
  /// program, make the seed from a random value.
  pub fn seed(value: u64) -> HashSeed {
    return HashSeed { value: value }
  }

  /// Returns the hash of the integer `value` under `seed`.
  ///
  /// # When to use
  ///
  /// Use `mix` for an integer key, or for the first integer field of a key with more fields.
  ///
  /// # Details
  ///
  /// The same seed and value give the same result on each supported target. Use [`Hash.combine`] to
  /// add each other field that `equals` compares.
  pub fn mix(seed: &HashSeed, value: u64) -> u64 {
    let salted = u64.wrappingAdd(value, seed.value)
    let stepped = u64.wrappingAdd(salted, 11400714819323198485)
    let folded = u64.bitXor(stepped, u64.shiftRight(stepped, 30))
    let spread = u64.wrappingMultiply(folded, 13787848793156543929)
    let refolded = u64.bitXor(spread, u64.shiftRight(spread, 27))
    let respread = u64.wrappingMultiply(refolded, 10723151780598845931)
    return u64.bitXor(respread, u64.shiftRight(respread, 31))
  }

  /// Returns a new hash that adds `value` to the hash `hashed`.
  ///
  /// # When to use
  ///
  /// Use `combine` after [`Hash.mix`], one time for each other field that `equals` compares. The
  /// order of the fields changes the result.
  pub fn combine(hashed: u64, value: u64) -> u64 {
    let mingled = u64.bitXor(hashed, u64.wrappingAdd(value, 11400714819323198485))
    let spread = u64.wrappingMultiply(mingled, 13787848793156543929)
    return u64.bitXor(spread, u64.shiftRight(spread, 27))
  }

  /// Returns a [`Word`] key that holds `value`.
  pub fn word(value: u64) -> Word {
    return Word { value: value }
  }
}

/// The seed of a hash collection. Different seeds give different hashes and bucket orders.
///
/// # Details
///
/// The same seed, keys, and operations give the same bucket order on each supported target. A seed
/// does not use addresses, clocks, or random state. Make one with [`Hash.seed`].
///
/// # Gotchas
///
/// The hash is deterministic. A seed does not protect against inputs that an attacker selects to
/// make collisions.
pub struct HashSeed {
  /// The seed value that each hash of the collection uses.
  pub value: u64,
}

impl Copy for HashSeed {}

/// The interface of a key type for `HashMap` and `HashSet`: an equality test and a seeded hash.
///
/// # When to use
///
/// `string` and every integer type already implement it. Implement it for your own type that is a
/// key of a `HashMap` or an element of a `HashSet`. In the `hash` member, use [`Hash.mix`] for the
/// first integer field and [`Hash.combine`] for each other field that `equals` compares.
///
/// # Details
///
/// A `string` key compares its UTF-8 bytes exactly, with no case folding or Unicode
/// normalization. An integer key compares its value. A conformance gives two members: `equals(left: &Self, right: &Self) -> bool` and `hash(value:
/// &Self, seed: &HashSeed) -> u64`. A collection calls `equals` to compare keys and `hash` with its
/// own seed.
///
/// # Gotchas
///
/// If `equals` returns `true` for two keys, `hash` must return the same value for both, for each
/// seed. A collection cannot check this rule. If the rule is broken, a key in the collection can
/// become impossible to find.
///
/// The hash is deterministic. It does not protect against inputs that an attacker selects to make
/// collisions.
pub interface HashKey {
  /// Returns `true` if `left` and `right` are the same key.
  fn equals(left: &Self, right: &Self) -> bool
  /// Returns the hash of `value` under `seed`.
  ///
  /// # Gotchas
  ///
  /// Two keys that `equals` reports as the same must give the same hash for the same seed.
  fn hash(value: &Self, seed: &HashSeed) -> u64
}

/// A ready-made [`HashKey`] that holds one `u64`.
pub struct Word {
  /// The integer value of the key.
  pub value: u64,
}

impl Copy for Word {}

fn wordEquals(left: &Word, right: &Word) -> bool {
  return left.value == right.value
}

fn wordHash(value: &Word, seed: &HashSeed) -> u64 {
  return Hash.mix(seed, value.value)
}

impl HashKey for Word { equals: Word.wordEquals hash: Word.wordHash }

// The built-in keys. Each `equals` is the built-in `==`, and each `hash` is a pure function of the
// value, so equal keys always hash alike.

impl<'text> HashKey for string<'text> {
  fn equals(left: &Self, right: &Self) -> bool {
    return left.* == right.*
  }

  // The length goes in first, so a shorter text never hashes like a longer one padded with zeros.
  // The bytes follow eight at a time as little-endian words, and the last word holds the rest.
  fn hash(value: &Self, seed: &HashSeed) -> u64 {
    let bytes = Intrinsic.stringUtf8Bytes(value.*)
    let mut hashed = Hash.mix(seed, usize.toU64(bytes.length))
    let mut offset = usize.ZERO
    while offset < bytes.length {
      let mut word: u64 = 0
      let mut shift: u64 = 0
      let mut index = offset
      while index < bytes.length && index < offset + 8 {
        word = u64.bitOr(word, u64.shiftLeft(u8.toU64(bytes[index]), shift))
        shift = shift + 8
        index = index + usize.ONE
      }
      hashed = Hash.combine(hashed, word)
      offset = index
    }
    return hashed
  }
}

impl HashKey for u64 {
  fn equals(left: &Self, right: &Self) -> bool {
    return left.* == right.*
  }

  fn hash(value: &Self, seed: &HashSeed) -> u64 {
    return Hash.mix(seed, value.*)
  }
}

impl HashKey for u8 {
  fn equals(left: &Self, right: &Self) -> bool {
    return left.* == right.*
  }

  fn hash(value: &Self, seed: &HashSeed) -> u64 {
    return Hash.mix(seed, u8.toU64(value.*))
  }
}

impl HashKey for u16 {
  fn equals(left: &Self, right: &Self) -> bool {
    return left.* == right.*
  }

  fn hash(value: &Self, seed: &HashSeed) -> u64 {
    return Hash.mix(seed, u16.toU64(value.*))
  }
}

impl HashKey for u32 {
  fn equals(left: &Self, right: &Self) -> bool {
    return left.* == right.*
  }

  fn hash(value: &Self, seed: &HashSeed) -> u64 {
    return Hash.mix(seed, u32.toU64(value.*))
  }
}

impl HashKey for usize {
  fn equals(left: &Self, right: &Self) -> bool {
    return left.* == right.*
  }

  fn hash(value: &Self, seed: &HashSeed) -> u64 {
    return Hash.mix(seed, usize.toU64(value.*))
  }
}

impl HashKey for i64 {
  fn equals(left: &Self, right: &Self) -> bool {
    return left.* == right.*
  }

  fn hash(value: &Self, seed: &HashSeed) -> u64 {
    return Hash.mix(seed, signedBits(value.*))
  }
}

impl HashKey for i8 {
  fn equals(left: &Self, right: &Self) -> bool {
    return left.* == right.*
  }

  fn hash(value: &Self, seed: &HashSeed) -> u64 {
    return Hash.mix(seed, signedBits(i8.toI64(value.*)))
  }
}

impl HashKey for i16 {
  fn equals(left: &Self, right: &Self) -> bool {
    return left.* == right.*
  }

  fn hash(value: &Self, seed: &HashSeed) -> u64 {
    return Hash.mix(seed, signedBits(i16.toI64(value.*)))
  }
}

impl HashKey for i32 {
  fn equals(left: &Self, right: &Self) -> bool {
    return left.* == right.*
  }

  fn hash(value: &Self, seed: &HashSeed) -> u64 {
    return Hash.mix(seed, signedBits(i32.toI64(value.*)))
  }
}

impl HashKey for isize {
  fn equals(left: &Self, right: &Self) -> bool {
    return left.* == right.*
  }

  fn hash(value: &Self, seed: &HashSeed) -> u64 {
    return Hash.mix(seed, signedBits(isize.toI64(value.*)))
  }
}

// The two's complement bits of `value`. A negative value's complement is not negative, so it
// converts to `u64` without a trap.
fn signedBits(value: i64) -> u64 {
  if value < 0 {
    return u64.bitNot(i64.toU64(i64.bitNot(value)))
  }
  return i64.toU64(value)
}
