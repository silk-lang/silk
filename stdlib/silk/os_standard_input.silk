//! Native [`StandardInput`] provider backed by the process standard-input descriptor.
//!
//! # When to use
//! Construct [`OsStandardInput`] at a native application edge and provide it to portable byte-input
//! code. Use a scripted provider in tests to control partial reads, end-of-input, and failures.
//!
//! # Details
//! The provider remembers observed end-of-input and commits each libc read directly into the caller's
//! buffer. For a non-empty buffer, a zero-length host transfer becomes the outcome selected by
//! [`StandardInput.endOfInput`]. Only a host read error becomes [`StreamReadError`]. Partial transfer counts are
//! preserved exactly.
//!
//! Constructing the provider performs no read. Portable code reads after the application supplies
//! `&mut OsStandardInput` for the `&mut StandardInput` requirement.
//!
//! # Gotchas
//! This module publishes its provider only for the supported native profiles.
//! WebAssembly selection leaves the module empty.
//! Empty buffers produce Filled(0) without reading, including after observed end-of-input.
//! A fresh provider can observe descriptor changes after a previous provider latched end-of-input.
//!
//! # Examples
//! ## Construct the native provider without reading standard input
//!
//! ```silk
//! import silk.os_standard_input { OsStandardInput }
//!
//! pub fn main() -> i32 {
//!   let provider = OsStandardInput.make()
//!   drop provider
//!   return 42
//! }
//! ```

static if (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText("libc") == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
  import silk.native_descriptor { NativeDescriptor }
  import silk.standard_input { ReadOutcome, StandardInput, StreamReadError }

  /// A native [`StandardInput`] provider for the process input descriptor.
  ///
  /// # Details
  ///
  /// The process owns the descriptor. Each read changes only the committed prefix of the caller's
  /// buffer and preserves the host transfer count.
  pub struct OsStandardInput {
    ended: bool
  }

  impl OsStandardInput {
    /// Commits one host read into the caller's buffer.
    ///
    /// The low-level boundary reports a zero-length transfer for the end of input, which becomes
    /// `EndOfInput` data rather than a typed failure. Only a host error becomes `StreamReadError`.
    ///
    /// Empty buffers return Filled(0) without a libc call. Once a non-empty read observes zero,
    /// later non-empty reads return EndOfInput without touching the descriptor.
    effect fn read(self: &mut Self, buffer: &mut [u8]) -> ReadOutcome ! StreamReadError {
      if buffer.length == 0 { return StandardInput.filled(0) }
      if self.ended { return StandardInput.endOfInput() }
      let mut nativeError = 0
      let mut length: usize = 0
      let received = run NativeDescriptor.read(0, move buffer, &mut length, &mut nativeError)
      if received == false { return run raise() }
      if length == 0 {
        self.ended = true
        return StandardInput.endOfInput()
      }
      return StandardInput.filled(length)
    }
  }

  impl OsStandardInput {
    /// Creates a provider for native standard-input bytes.
    ///
    /// # When to use
    ///
    /// Use this function at a native application edge. Provide the result as `&mut StandardInput` to
    /// portable code that calls `silk.standard_input.receive`.
    ///
    /// # Details
    ///
    /// Construction initializes only the EOF flag and cannot fail. For a non-empty read buffer, a zero-byte
    /// host transfer becomes end-of-input data. A host read error becomes [`StreamReadError`].
    pub fn make() -> OsStandardInput {
      return OsStandardInput { ended: false }
    }
  }

  effect fn raise() -> never ! StreamReadError {
    fail StandardInput.readFailure()
  }

  impl StandardInput for OsStandardInput {
    read: OsStandardInput.read
  }
}
