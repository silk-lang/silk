//! UTF-8 text: owned strings, validation of bytes, and traversal one Unicode scalar at a time.
//!
//! # When to use
//! Use the built-in `string` type for borrowed text, such as a literal or a view into a buffer. Use
//! [`String`] when the text must own its storage, for example to build text at runtime. Use
//! `silk.bytes.Bytes` for bytes that are not necessarily UTF-8.
//!
//! # Details
//! A `string` and a [`String`] always hold valid UTF-8.
//!
//! - [`String.fromUtf8`] checks bytes and borrows them as a `string`. It does not allocate.
//! - [`String.copyUtf8`] checks bytes and copies them into a new [`String`].
//! - [`String.fromBytes`] checks an owned `Bytes` value and keeps its storage, with no copy.
//!   [`String.intoBytes`] gives the storage back as `Bytes`.
//!
//! A failed [`String.append`] or [`String.appendOwned`] leaves the string unchanged. Traversal with
//! [`String.nextScalar`] gives Unicode scalar values and byte offsets. It does not give grapheme
//! clusters, so one visible character can be more than one scalar.
//!
//! # Gotchas
//! A [`ScalarCursor`] is valid only for the string where the traversal started, and only while that
//! string does not change. Start with [`String.scalarCursor`] and advance only with
//! [`String.nextCursor`].
//!
//! # Examples
//! ## Check bytes as UTF-8
//! ```silk
//! import silk.result { Result }
//! import silk.string { String, InvalidUtf8 }
//!
//! pub fn main() -> i32 {
//!   let valid = String.fromUtf8(b"Silk") |> Result<string, InvalidUtf8>.unwrapOr("")
//!   let rejected = String.fromUtf8(b"a\x80") |> Result<string, InvalidUtf8>.unwrapOr("")
//!   if String.byteLength(valid) != 4 || String.byteLength(rejected) != 0 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! ## Count the scalars of a string
//! ```silk
//! import silk.option { Option }
//! import silk.string { String, ScalarStep }
//!
//! pub fn main() -> i32 {
//!   // "né" has 2 scalars in 3 bytes.
//!   let text = "né"
//!   let mut count = 0
//!   let mut step = String.nextScalar(text, String.scalarCursor())
//!   while true {
//!     match move step {
//!       Option<ScalarStep>.Some { value } => {
//!         count = count + 1
//!         step = String.nextScalar(text, String.nextCursor(move value))
//!       }
//!       Option<ScalarStep>.None => {
//!         break
//!       }
//!     }
//!   }
//!   if count != 2 || String.byteLength(text) != 3 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! ## Build an owned string
//! ```silk
//! import silk.allocator { Allocator, OutOfMemoryError }
//! import silk.effect { Effect }
//! import silk.string { String }
//!
//! pub effect fn main() -> i32
//!   ! OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let mut text = run String.copy("hello") |> Effect.provideMut<Allocator>(&mut allocator)
//!   run String.append(&mut text, ", world") |> Effect.provideMut<Allocator>(&mut allocator)
//!   if String.view(&text) != "hello, world" {
//!     return 1
//!   }
//!   return 0
//! }
//! ```

import silk.bool
import silk.bytes { Bytes }
import silk.char
import silk.allocator { Allocator, OutOfMemoryError }
import silk.option { Option }
import silk.result { Result }
import silk.u32
import silk.u8
import silk.usize

/// Owned UTF-8 text. Dropping a `String` releases its storage.
///
/// # Details
///
/// Get a borrowed `string` view with [`String.view`]. A `String` is affine. Use [`String.copy`] to
/// make an independent copy of a view.
pub struct String {
  bytes: Bytes
}

impl String {
  /// Returns `values` as a `string` view, with no UTF-8 check.
  ///
  /// # When to use
  ///
  /// Use this function only when earlier code proves that all of `values` is valid UTF-8, such as a
  /// buffer that this module made. Use [`String.fromUtf8`] in other cases.
  ///
  /// # Gotchas
  ///
  /// This function is `unsafe`. If `values` is not valid UTF-8, the behavior of later text
  /// operations is not defined.
  pub unsafe fn fromUtf8Unchecked(values: &[u8]) -> string {
    unsafe { return Intrinsic.stringFromUtf8Unchecked(values) }
    return ""
  }

  /// Checks that `values` is valid UTF-8 and returns it as a `string` view. This function does not
  /// allocate.
  ///
  /// # Details
  ///
  /// The view borrows `values` and has the same lifetime.
  ///
  /// # Errors
  ///
  /// - [`InvalidUtf8`] if `values` is not valid UTF-8. `offset` gives the position of the first
  ///   invalid byte.
  pub fn fromUtf8(values: &[u8]) -> Result<string, InvalidUtf8> {
    let failure = match move firstInvalidUtf8(values) {
      Option<usize>.Some { value } => move value
      Option<usize>.None => values.length + usize.ONE
    }
    if failure <= values.length {
      return Result<string, InvalidUtf8>.failResult(InvalidUtf8 { offset: failure })
    }
    let text = unsafe String.fromUtf8Unchecked(values)
    return Result<string, InvalidUtf8>.succeed(text)
    return Result<string, InvalidUtf8>.failResult(InvalidUtf8 { offset: usize.ZERO })
  }

  /// Returns an empty `String`. This function does not allocate.
  pub fn make() -> String {
    return String { bytes: Bytes.make() }
  }

  /// Checks that `values` is valid UTF-8 and returns it as a `String` that keeps the same storage.
  ///
  /// # When to use
  ///
  /// Use `fromBytes` to turn an owned byte buffer, such as file contents, into owned text without a
  /// copy. Use [`String.fromUtf8`] to borrow bytes without taking ownership.
  ///
  /// # Details
  ///
  /// This function consumes `values`. On success, the `String` keeps the allocation and capacity of
  /// `values`. This function does not allocate and does not copy.
  ///
  /// # Errors
  ///
  /// - [`InvalidUtf8`] if `values` is not valid UTF-8. `offset` gives the position of the first
  ///   invalid byte. The storage of `values` is released.
  pub fn fromBytes(values: Bytes) -> Result<String, InvalidUtf8> {
    let failure = firstInvalidUtf8(Bytes.asSlice(&values))
    return match move failure {
      Option<usize>.Some {value} => Result<String, InvalidUtf8>.failResult(
        InvalidUtf8 {offset: value},
      )
      Option<usize>.None => Result<String, InvalidUtf8>.succeed(String {bytes: move values})
    }
  }
  /// Returns `values` as a `String` that keeps the same storage, with no UTF-8 check.
  ///
  /// # When to use
  ///
  /// Use this function only when earlier code proves that all bytes of `values` are valid UTF-8.
  /// Use [`String.fromBytes`] in other cases.
  ///
  /// # Gotchas
  ///
  /// This function is `unsafe`. If `values` is not valid UTF-8, the behavior of later text
  /// operations is not defined.
  pub unsafe fn fromBytesUnchecked(values: Bytes) -> String {
    return String {bytes: move values}
  }
  /// Returns the storage of the string as `Bytes`, with no copy.
  ///
  /// # Details
  ///
  /// This function consumes the string. The result keeps the allocation, the capacity, and the
  /// UTF-8 contents. After the conversion, the bytes can change to any value.
  pub fn intoBytes(self: Self) -> Bytes {
    return match move self {
      String {bytes} => move bytes
    }
  }

  /// Returns a new `String` that holds a copy of `value`.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the storage.
  pub effect fn copy(value: string) -> String ! OutOfMemoryError ? &mut Allocator {
    let source = Intrinsic.stringUtf8Bytes(value)
    let bytes = run Bytes.copy(source)
    return String { bytes: move bytes }
  }

  /// Checks that `values` is valid UTF-8 and returns a new `String` that holds a copy.
  ///
  /// # When to use
  ///
  /// Use `copyUtf8` when the text must live longer than the buffer of `values`. Use
  /// [`String.fromUtf8`] to borrow the bytes without allocation.
  ///
  /// # Errors
  ///
  /// - [`InvalidUtf8`] as the `Result` failure if `values` is not valid UTF-8. `offset` gives the
  ///   position of the first invalid byte. The function does not allocate.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the storage.
  pub effect fn copyUtf8(values: &[u8]) -> Result<String, InvalidUtf8> ! OutOfMemoryError ? &mut Allocator {
    let failure = match move firstInvalidUtf8(values) {
      Option<usize>.Some { value } => move value
      Option<usize>.None => values.length + usize.ONE
    }
    if failure <= values.length {
      return Result<String, InvalidUtf8>.failResult(InvalidUtf8 { offset: failure })
    }
    let bytes = run Bytes.copy(values)
    return Result<String, InvalidUtf8>.succeed(String { bytes: move bytes })
  }

  /// Adds a copy of `value` at the end of the string.
  ///
  /// # When to use
  ///
  /// Use `append` for borrowed text. Use [`String.appendOwned`] when the suffix is an owned
  /// [`String`].
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the storage. The string does not change.
  pub effect fn append(self: &mut Self, value: string) -> () ! OutOfMemoryError ? &mut Allocator {
    let suffix = Intrinsic.stringUtf8Bytes(value)
    return run Bytes.append(&mut self.bytes, suffix)
  }

  /// Adds the text of `value` at the end of the string and consumes `value`.
  ///
  /// # When to use
  ///
  /// Use `appendOwned` when the suffix is an owned [`String`] that the caller does not need again.
  /// Use [`String.append`] for borrowed text.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the storage. The string does not change,
  ///   and `value` is dropped.
  pub effect fn appendOwned(self: &mut Self, value: String) -> () ! OutOfMemoryError ? &mut Allocator {
    let suffix = Bytes.asSlice(&value.bytes)
    return run Bytes.append(&mut self.bytes, suffix)
  }

  /// Returns a `string` view of the text. This function does not allocate or copy.
  pub fn view(self: &Self) -> string {
    let bytes = Bytes.asSlice(&self.bytes)
    return unsafe String.fromUtf8Unchecked(bytes)
  }

  /// Returns the UTF-8 bytes of `value` as a shared slice.
  pub fn utf8Bytes(value: string) -> &[u8] {
    return Intrinsic.stringUtf8Bytes(value)
  }

  /// Returns the number of UTF-8 bytes in `value`. This is not the number of characters.
  pub fn byteLength(value: string) -> usize {
    return Intrinsic.stringByteLength(value)
  }

  /// Returns the UTF-8 bytes of the string as a shared slice.
  pub fn ownedUtf8Bytes(self: &Self) -> &[u8] {
    return Bytes.asSlice(&self.bytes)
  }

  /// Returns the number of UTF-8 bytes in the string. This is not the number of characters.
  pub fn ownedByteLength(self: &Self) -> usize {
    return Bytes.length(&self.bytes)
  }

  /// Returns a cursor at the start of a string, before the first scalar.
  ///
  /// # Details
  ///
  /// Give the cursor to [`String.nextScalar`] to read the first scalar.
  pub fn scalarCursor() -> ScalarCursor {
    return ScalarCursor { byteOffset: usize.ZERO }
  }

  /// Returns the byte position of `cursor` in its string.
  pub fn cursorByteOffset(cursor: &ScalarCursor) -> usize {
    return cursor.byteOffset
  }

  /// Returns the Unicode scalar that `step` read.
  pub fn scalarValue(step: &ScalarStep) -> char {
    return step.scalar
  }

  /// Returns the byte position where the scalar of `step` starts.
  pub fn scalarByteOffset(step: &ScalarStep) -> usize {
    return step.byteOffset
  }

  /// Returns the cursor after the scalar of `step`, and consumes `step`.
  ///
  /// # Details
  ///
  /// Give the cursor to [`String.nextScalar`] to read the next scalar.
  pub fn nextCursor(step: ScalarStep) -> ScalarCursor {
    return match move step {
      ScalarStep { scalar, byteOffset, next } => move next
    }
  }

  /// Reads the scalar at `cursor` in `value`. Returns `None` at the end of the text.
  ///
  /// # Details
  ///
  /// A present [`ScalarStep`] holds the scalar, its byte position, and the cursor after it. Read
  /// them with [`String.scalarValue`], [`String.scalarByteOffset`], and [`String.nextCursor`]. This
  /// function does not allocate.
  ///
  /// # Gotchas
  ///
  /// `cursor` must come from [`String.scalarCursor`] or [`String.nextCursor`] for the same `value`.
  /// A cursor from a different string gives incorrect results.
  pub fn nextScalar(value: string, cursor: ScalarCursor) -> Option<ScalarStep> {
    let bytes = Intrinsic.stringUtf8Bytes(value)
    let offset = cursor.byteOffset
    if offset == bytes.length { return Option<ScalarStep>.none() }
    let first = bytes[offset]
    let mut scalar = scalar32(first)
    let mut width = usize.ONE
    if byte(194) <= first {
      if first <= byte(223) {
        scalar = (scalar32(first) - u32.toU32(192)) * u32.toU32(64)
          + (scalar32(bytes[offset + usize.ONE]) - u32.toU32(128))
        width = 2
      } else {
        if first <= byte(239) {
          scalar = (scalar32(first) - u32.toU32(224)) * u32.toU32(4096)
            + (scalar32(bytes[offset + usize.ONE]) - u32.toU32(128)) * u32.toU32(64)
            + (scalar32(bytes[offset + 2]) - u32.toU32(128))
          width = 3
        } else {
          scalar = (scalar32(first) - u32.toU32(240)) * u32.toU32(262144)
            + (scalar32(bytes[offset + usize.ONE]) - u32.toU32(128)) * u32.toU32(4096)
            + (scalar32(bytes[offset + 2]) - u32.toU32(128)) * u32.toU32(64)
            + (scalar32(bytes[offset + 3]) - u32.toU32(128))
          width = 4
        }
      }
    }
    return match move char.fromU32(scalar) {
      Option<char>.Some { value: decoded } => Option<ScalarStep>.some(ScalarStep {
        scalar: decoded,
        byteOffset: offset,
        next: ScalarCursor { byteOffset: offset + width }
      })
      Option<char>.None => Option<ScalarStep>.none()
    }
  }
}

/// The error value of a UTF-8 check: the position of the first invalid byte.
pub struct InvalidUtf8 {
  /// The zero-based position of the first byte that is not valid UTF-8.
  pub offset: usize
}

/// A position in a string for traversal one scalar at a time.
///
/// # Details
///
/// Get the first cursor from [`String.scalarCursor`] and the next one from [`String.nextCursor`].
pub struct ScalarCursor {
  byteOffset: usize
}

/// One scalar that [`String.nextScalar`] read, with its byte position and the cursor after it.
pub struct ScalarStep {
  scalar: char
  byteOffset: usize
  next: ScalarCursor
}

fn byte(value: u8) -> u8 {
  return value
}

fn continuation(value: u8) -> bool {
  if value < byte(128) { return false }
  return value <= byte(191)
}

/// Returns the first byte offset at which UTF-8 validation fails, or None for complete valid text.
fn firstInvalidUtf8(values: &[u8]) -> Option<usize> {
  let mut index = usize.ZERO
  while index < values.length {
    let first = values[index]
    if first < byte(128) {
      index = index + usize.ONE
    } else {
      if first < byte(194) { return Option<usize>.some(index) }
      if first <= byte(223) {
        if values.length <= index + usize.ONE { return Option<usize>.some(index) }
        if continuation(values[index + usize.ONE]) == false {
          return Option<usize>.some(index + usize.ONE)
        }
        index = index + 2
      } else {
        if first <= byte(239) {
          if values.length <= index + 2 { return Option<usize>.some(index) }
          let second = values[index + usize.ONE]
          let third = values[index + 2]
          if continuation(second) == false { return Option<usize>.some(index + usize.ONE) }
          if continuation(third) == false { return Option<usize>.some(index + 2) }
          if first == byte(224) {
            if second < byte(160) { return Option<usize>.some(index + usize.ONE) }
          }
          if first == byte(237) {
            if byte(159) < second { return Option<usize>.some(index + usize.ONE) }
          }
          index = index + 3
        } else {
          if byte(244) < first { return Option<usize>.some(index) }
          if values.length <= index + 3 { return Option<usize>.some(index) }
          let second = values[index + usize.ONE]
          let third = values[index + 2]
          let fourth = values[index + 3]
          if continuation(second) == false { return Option<usize>.some(index + usize.ONE) }
          if continuation(third) == false { return Option<usize>.some(index + 2) }
          if continuation(fourth) == false { return Option<usize>.some(index + 3) }
          if first == byte(240) {
            if second < byte(144) { return Option<usize>.some(index + usize.ONE) }
          }
          if first == byte(244) {
            if byte(143) < second { return Option<usize>.some(index + usize.ONE) }
          }
          index = index + 4
        }
      }
    }
  }
  return Option<usize>.none()
}

// Appending grows the existing storage rather than copying the whole string into fresh storage
// first. The atomicity is the same either way — the underlying byte append builds its replacement
// buffer in full before committing, so a failed allocation leaves the original untouched — but the
// cost is not: composing a message from several pieces is what this API is for, and a copy per
// piece made that quadratic in the message and linear in allocations.

fn scalar32(value: u8) -> u32 {
  return u8.toU32(value)
}
