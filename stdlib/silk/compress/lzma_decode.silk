//! Shared LZMA range decoder and probability models for LZMA, LZMA2, and XZ.
//!
//! @category Data formats

// Adapted from Zig lib/std/compress/lzma.zig. See licenses/zig-compression.txt.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.compress.limits { DecodeLimits, DecodeReason, DecodeError }
import silk.collections.list { List }
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.usize

// Disjoint model regions: match, rep flags, short rep, distance slots, distance suffix,
// alignment, two length models, and literal contexts.
const LITERAL: usize = 1846

const LENGTH: usize = 818

const REP_LENGTH: usize = 1332

/// Internal range and dictionary state. The output buffer also holds dictionary history.
pub struct LzmaState {
  /// Current input offset.
  pub ip: usize,

  /// Exclusive input bound for the current chunk.
  pub inputEnd: usize,

  /// Current output offset.
  pub op: usize,

  /// Exclusive output bound for the current stream or chunk.
  pub outputEnd: usize,

  /// Output offset of the most recent dictionary reset.
  pub dictionaryStart: usize,

  /// Maximum permitted match distance.
  pub dictionarySize: u64,

  /// First failure, if any.
  pub failed: bool,

  /// Failure reason, meaningful only when failed is true.
  pub reason: DecodeReason,

  /// Whether an LZMA end marker was decoded.
  pub ended: bool,

  /// Current arithmetic range.
  pub range: u32,

  /// Current arithmetic code.
  pub code: u32,
  models: List<u32>,
  state: usize,
  rep: [u32; 4],
  lc: u32,
  lp: u32,
  pb: u32,
}

impl LzmaState {
  /// Creates empty state; probability storage is allocated by configure.
  pub fn make(inputEnd: usize, outputEnd: usize) -> LzmaState {
    return LzmaState {
      ip: 0,
      inputEnd: inputEnd,
      op: 0,
      outputEnd: outputEnd,
      dictionaryStart: 0,
      dictionarySize: 4096,
      failed: false,
      reason: DecodeReason.InvalidData,
      ended: false,
      range: 0,
      code: 0,
      models: List<u32>.make(),
      state: 0,
      rep: [0, 0, 0, 0],
      lc: 0,
      lp: 0,
      pb: 0
    }
  }

  /// Records only the first failure.
  pub fn reject(self: &mut Self, reason: DecodeReason) -> () {
    if !self.failed {
      self.failed = true
      self.reason = reason
    }
  }

  /// Returns the current failure with progress offsets.
  pub fn error(self: &Self) -> DecodeError {
    return DecodeError { reason: self.reason, consumed: self.ip, written: self.op }
  }

  /// Reads one byte without crossing the current chunk's input boundary.
  pub fn byte(self: &mut Self, input: &[u8]) -> u32 {
    if self.failed {
      return 0
    }
    if self.ip >= self.inputEnd {
      LzmaState.reject(&mut self, DecodeReason.TruncatedInput)
      return 0
    }
    let value = input[self.ip]
    self.ip = self.ip + 1
    return u8.toU32(value)
  }

  /// Reads a little-endian integer of at most eight bytes.
  pub fn little(self: &mut Self, input: &[u8], count: u32) -> u64 {
    let mut value: u64 = 0
    let mut index: u32 = 0
    while index < count {
      let byte = LzmaState.byte(&mut self, input)
      value = u64.bitOr(value, u64.shiftLeft(u32.toU64(byte), u32.toU64(index) * 8))
      index = index + 1
    }
    return value
  }

  /// Validates properties and resets all probability models within the workspace limit.
  pub effect fn configure(self: &mut Self, property: u32, lzma2: bool, workspace: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.failed {
      return ()
    }
    if property >= 225 {
      LzmaState.reject(&mut self, DecodeReason.InvalidHeader)
      return ()
    }
    self.lc = u32.remainder(property, 9)
    let rest = u32.divide(property, 9)
    self.lp = u32.remainder(rest, 5)
    self.pb = u32.divide(rest, 5)
    if lzma2 && self.lc + self.lp > 4 {
      LzmaState.reject(&mut self, DecodeReason.InvalidHeader)
      return ()
    }
    let count = LITERAL + 768 * u32.toUsize(u32.shiftLeft(1, self.lc + self.lp))
    if count > usize.divide(workspace, 4) {
      LzmaState.reject(&mut self, DecodeReason.WorkspaceLimit)
      return ()
    }

    // Drop a differently sized table before allocating its replacement, so the cap bounds peak use.
    if List<u32>.length(&self.models) != count {
      self.models = List<u32>.make()
      run List<u32>.reserveExact(&mut self.models, count)
      let mut index: usize = 0
      while index < count {
        run List<u32>.append(&mut self.models, 1024)
        index = index + 1
      }
    }
    LzmaState.reset(&mut self)
  }

  /// Resets probabilities and repeat distances without changing dictionary history.
  pub fn reset(self: &mut Self) -> () {
    let mut index: usize = 0
    while index < List<u32>.length(&self.models) {
      List<u32>.set(&mut self.models, index, 1024)
      index = index + 1
    }
    self.state = 0
    self.rep = [0, 0, 0, 0]
    self.ended = false
  }

  /// Starts a five-byte range-coded chunk and validates its reserved byte.
  pub fn startRange(self: &mut Self, input: &[u8]) -> () {
    self.range = 4294967295
    self.code = 0
    if LzmaState.byte(&mut self, input) != 0 {
      LzmaState.reject(&mut self, DecodeReason.InvalidData)
    }
    let mut index: u32 = 0
    while index < 4 {
      let byte = LzmaState.byte(&mut self, input)
      self.code = u32.bitOr(u32.shiftLeft(self.code, 8), byte)
      index = index + 1
    }
    if self.code == 4294967295 {
      LzmaState.reject(&mut self, DecodeReason.InvalidData)
    }
  }

  /// Appends a byte, respecting the caller's output bound.
  pub fn put(self: &mut Self, output: &mut [u8], value: u8) -> () {
    if self.failed {
      return ()
    }
    if self.op >= self.outputEnd {
      LzmaState.reject(&mut self, DecodeReason.OutputLimit)
      return ()
    }
    output[self.op] = value
    self.op = self.op + 1
  }

  /// Decodes one literal, match, or end marker with bounded input and output access.
  pub fn symbol(self: &mut Self, input: &[u8], output: &mut [u8]) -> () {
    if self.failed || self.ended {
      return ()
    }
    let modelState = self.state
    let pos = self.op - self.dictionaryStart
    let position = usize.bitAnd(pos, u32.toUsize(u32.shiftLeft(1, self.pb) - 1))
    if bit(&mut self, input, modelState * 16 + position) == 0 {
      let mut previous: u32 = 0
      if pos != 0 {
        previous = u8.toU32(output[self.op - 1])
      }
      let context = usize.shiftLeft(
        usize.bitAnd(pos, u32.toUsize(u32.shiftLeft(1, self.lp) - 1)),
        u32.toUsize(self.lc)
      )
        + u32.toUsize(u32.shiftRight(previous, 8 - self.lc))
      let base = LITERAL + context * 768
      let mut value: u32 = 1
      if self.state >= 7 {
        let recent = self.rep[0]
        let mut matched = u8.toU32(history(&mut self, &output, recent))
        while value < 256 && !self.failed {
          let expected = u32.bitAnd(u32.shiftRight(matched, 7), 1)
          matched = u32.shiftLeft(matched, 1)
          let actual = bit(&mut self, input, base + u32.toUsize((1 + expected) * 256 + value))
          value = value * 2 + actual
          if actual != expected {
            break
          }
        }
      }
      while value < 256 && !self.failed {
        value = value * 2 + bit(&mut self, input, base + u32.toUsize(value))
      }
      if self.failed {
        return ()
      }
      LzmaState.put(&mut self, &mut output, u32.toU8(value - 256))
      if self.state < 4 {
        self.state = 0
      } else if self.state < 10 {
        self.state = self.state - 3
      } else {
        self.state = self.state - 6
      }
      return ()
    }
    let mut length: u32 = 0
    if bit(&mut self, input, 192 + modelState) != 0 {
      if bit(&mut self, input, 204 + modelState) == 0 {
        if bit(&mut self, input, 240 + modelState * 16 + position) == 0 {
          if self.state < 7 {
            self.state = 9
          } else {
            self.state = 11
          }
          let recent = self.rep[0]
          let byte = history(&mut self, &output, recent)
          LzmaState.put(&mut self, &mut output, byte)
          return ()
        }
      } else {
        let mut index: usize = 1
        if bit(&mut self, input, 216 + modelState) != 0 {
          index = 2
          if bit(&mut self, input, 228 + modelState) != 0 {
            index = 3
          }
        }
        let distance = self.rep[index]
        while index > 0 {
          self.rep[index] = self.rep[index - 1]
          index = index - 1
        }
        self.rep[0] = distance
      }
      length = decodeLength(&mut self, input, REP_LENGTH, position)
      if self.state < 7 {
        self.state = 8
      } else {
        self.state = 11
      }
    } else {
      self.rep[3] = self.rep[2]
      self.rep[2] = self.rep[1]
      self.rep[1] = self.rep[0]
      length = decodeLength(&mut self, input, LENGTH, position)
      if self.state < 7 {
        self.state = 7
      } else {
        self.state = 10
      }
      let mut lengthState = length
      if lengthState > 3 {
        lengthState = 3
      }
      let slot = tree(&mut self, input, 432 + u32.toUsize(lengthState) * 64, 6, false)
      let mut distance = slot
      if slot >= 4 {
        let direct = u32.shiftRight(slot, 1) - 1
        distance = u32.shiftLeft(2 + u32.bitAnd(slot, 1), direct)
        if slot < 14 {
          distance = distance
            + tree(&mut self, input, 688 + u32.toUsize(distance - slot), direct, true)
        } else {
          let mut suffix: u32 = 0
          let mut count: u32 = 0
          while count < direct - 4 {
            self.range = u32.shiftRight(self.range, 1)
            let mut value: u32 = 0
            if self.code >= self.range {
              self.code = self.code - self.range
              value = 1
            }
            suffix = suffix * 2 + value
            normalize(&mut self, input)
            count = count + 1
          }
          distance = distance + u32.shiftLeft(suffix, 4)
          distance = distance + tree(&mut self, input, 802, 4, true)
        }
      }
      self.rep[0] = distance
      if distance == 4294967295 {
        self.ended = true
        if self.code != 0 {
          LzmaState.reject(&mut self, DecodeReason.InvalidData)
        }
        return ()
      }
    }
    let mut count: u32 = 0
    while count < length + 2 && !self.failed {
      let recent = self.rep[0]
      let byte = history(&mut self, &output, recent)
      LzmaState.put(&mut self, &mut output, byte)
      count = count + 1
    }
  }
}

fn normalize(state: &mut LzmaState, input: &[u8]) -> () {
  if state.range < 16777216 {
    state.range = u32.shiftLeft(state.range, 8)
    let byte = LzmaState.byte(&mut state, input)
    state.code = u32.bitOr(u32.shiftLeft(state.code, 8), byte)
  }
}

fn bit(state: &mut LzmaState, input: &[u8], index: usize) -> u32 {
  if state.failed {
    return 0
  }
  let probability = List<u32>.get(&state.models, index)
  let bound = u32.shiftRight(state.range, 11) * probability
  let mut value: u32 = 0
  if state.code < bound {
    state.range = bound
    List<u32>.set(&mut state.models, index, probability + u32.shiftRight(2048 - probability, 5))
  } else {
    state.range = state.range - bound
    state.code = state.code - bound
    List<u32>.set(&mut state.models, index, probability - u32.shiftRight(probability, 5))
    value = 1
  }
  normalize(&mut state, input)
  return value
}

fn tree(state: &mut LzmaState, input: &[u8], base: usize, count: u32, reverse: bool) -> u32 {
  let mut value: u32 = 1
  let mut result: u32 = 0
  let mut index: u32 = 0
  while index < count && !state.failed {
    let next = bit(&mut state, input, base + u32.toUsize(value))
    value = value * 2 + next
    result = u32.bitOr(result, u32.shiftLeft(next, index))
    index = index + 1
  }
  if state.failed {
    return 0
  }
  if reverse {
    return result
  }
  return value - u32.shiftLeft(1, count)
}

fn decodeLength(state: &mut LzmaState, input: &[u8], base: usize, position: usize) -> u32 {
  if bit(&mut state, input, base) == 0 {
    return tree(&mut state, input, base + 2 + position * 8, 3, false)
  }
  if bit(&mut state, input, base + 1) == 0 {
    return 8 + tree(&mut state, input, base + 130 + position * 8, 3, false)
  }
  return 16 + tree(&mut state, input, base + 258, 8, false)
}

fn history(state: &mut LzmaState, output: &[u8], encoded: u32) -> u8 {
  let distance = u32.toU64(encoded) + 1
  if distance > state.dictionarySize || distance > usize.toU64(state.op - state.dictionaryStart) {
    LzmaState.reject(&mut state, DecodeReason.InvalidDistance)
    return 0
  }
  return output[state.op - u64.toUsize(distance)]
}
