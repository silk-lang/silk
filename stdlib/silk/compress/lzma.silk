//! Decode complete LZMA-alone streams into caller-owned byte buffers.
//!
//! # When to use
//! Use [`Lzma.decode`] for `.lzma` files with the 13-byte LZMA-alone header.
//! Use `silk.compress.lzma2.Lzma2` for raw LZMA2 chunks and `silk.compress.xz.Xz` for `.xz` files.
//!
//! # Details
//! Decoding allocates probability tables through the ambient allocator. The output buffer also
//! holds dictionary history. Both known-size streams and streams with end markers are accepted.
//! Input must contain exactly one stream. There is no checksum; use an authenticated container
//! when integrity is required. Discard output after a failure.
//!
//! @category Data formats

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.compress.limits { DecodeLimits, DecodeReason, DecodeError, Decoded }
import silk.compress.lzma_decode { LzmaState }
import silk.num.u64
import silk.num.usize

/// A complete-buffer LZMA-alone decoder with caller-selected resource limits.
pub struct Lzma {}

impl Lzma {
  /// Decodes one 13-byte-header LZMA-alone stream into the start of `output`.
  ///
  /// # Details
  /// Allocates probability tables with the ambient allocator and uses `output` for dictionary
  /// history. Known-size streams may omit the end marker; unknown-size streams must include it.
  /// Returns the consumed and written lengths. Trailing bytes are rejected. LZMA has no checksum.
  ///
  /// # Errors
  /// Fails with `DecodeError` for malformed or truncated data, trailing bytes, invalid distances,
  /// size mismatches, or exhausted input, output, dictionary, or workspace limits. Output is not
  /// verified on failure and must be discarded. Allocation failure raises `OutOfMemoryError`.
  pub effect fn decode(input: &[u8], output: &mut [u8], limits: DecodeLimits) -> Decoded
    ! OutOfMemoryError | DecodeError
    ? &mut Allocator {
    let mut end = output.length
    if limits.maxOutputBytes < end {
      end = limits.maxOutputBytes
    }
    let mut state = LzmaState.make(input.length, end)
    if input.length > limits.maxInputBytes {
      fail DecodeError { reason: DecodeReason.InputLimit, consumed: 0, written: 0 }
    }
    let property = LzmaState.byte(&mut state, input)
    let mut dictionary = LzmaState.little(&mut state, input, 4)
    if dictionary < 4096 {
      dictionary = 4096
    }
    let size = LzmaState.little(&mut state, input, 8)
    if state.failed {
      fail LzmaState.error(&state)
    }
    if dictionary > limits.maxDictionaryBytes {
      fail DecodeError { reason: DecodeReason.DictionaryLimit, consumed: state.ip, written: 0 }
    }
    state.dictionarySize = dictionary
    if size != u64.MAX {
      if size > usize.toU64(end) {
        fail DecodeError { reason: DecodeReason.OutputLimit, consumed: state.ip, written: 0 }
      }
      state.outputEnd = u64.toUsize(size)
    }
    run LzmaState.configure(&mut state, property, false, limits.maxWorkspaceBytes)
    LzmaState.startRange(&mut state, input)
    while !state.failed && !state.ended {
      if size != u64.MAX && usize.toU64(state.op) == size && state.code == 0 {
        break
      }
      LzmaState.symbol(&mut state, input, &mut output)
    }
    if state.failed {
      fail LzmaState.error(&state)
    }
    if size != u64.MAX && usize.toU64(state.op) != size {
      fail DecodeError { reason: DecodeReason.InvalidSize, consumed: state.ip, written: state.op }
    }
    if state.ip != input.length {
      fail DecodeError { reason: DecodeReason.TrailingData, consumed: state.ip, written: state.op }
    }
    return Decoded { consumed: state.ip, written: state.op }
  }
}
