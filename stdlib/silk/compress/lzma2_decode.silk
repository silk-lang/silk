//! LZMA2 chunk framing shared by raw LZMA2 and XZ decoders.
//!
//! @category Data formats

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.compress.limits { DecodeReason }
import silk.compress.lzma_decode { LzmaState }
import silk.num.u32

/// Internal LZMA2 stream driver; state owns probability models and progress counters.
pub struct Lzma2Stream {}

impl Lzma2Stream {
  /// Decodes through the LZMA2 end control byte, preserving any following container bytes.
  /// Requires a validated dictionary size and slice bounds in `state`.
  pub effect fn decode(
    state: &mut LzmaState,
    input: &[u8],
    output: &mut [u8],
    workspace: usize
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let inputEnd = state.inputEnd
    let outputEnd = state.outputEnd
    let mut needDictionary = true
    let mut needProperties = true
    let mut needState = true
    while !state.failed {
      let control = LzmaState.byte(&mut state, input)
      if state.failed || control == 0 {
        return ()
      }
      if control == 1 || control >= 224 {
        state.dictionaryStart = state.op
        needDictionary = false
        needProperties = true
      } else if needDictionary {
        LzmaState.reject(&mut state, DecodeReason.InvalidData)
        return ()
      }
      if control == 1 || control == 2 {
        let high = LzmaState.byte(&mut state, input)
        let low = LzmaState.byte(&mut state, input)
        let size = u32.toUsize(high * 256 + low + 1)
        if size > outputEnd - state.op {
          LzmaState.reject(&mut state, DecodeReason.OutputLimit)
          return ()
        }
        let mut index: usize = 0
        while index < size && !state.failed {
          let byte = LzmaState.byte(&mut state, input)
          LzmaState.put(&mut state, &mut output, u32.toU8(byte))
          index = index + 1
        }
        needState = true
      } else {
        if control < 128 {
          LzmaState.reject(&mut state, DecodeReason.InvalidData)
          return ()
        }
        let high = LzmaState.byte(&mut state, input)
        let low = LzmaState.byte(&mut state, input)
        let unpacked = u32.toUsize(u32.bitAnd(control, 31) * 65536 + high * 256 + low + 1)
        let packedHigh = LzmaState.byte(&mut state, input)
        let packedLow = LzmaState.byte(&mut state, input)
        let packed = u32.toUsize(packedHigh * 256 + packedLow + 1)
        if control >= 192 {
          let property = LzmaState.byte(&mut state, input)
          run LzmaState.configure(&mut state, property, true, workspace)
          needProperties = false
          needState = false
        } else {
          if needProperties || (needState && control < 160) {
            LzmaState.reject(&mut state, DecodeReason.InvalidData)
            return ()
          }
          if control >= 160 {
            LzmaState.reset(&mut state)
            needState = false
          }
        }
        if state.failed {
          return ()
        }
        if packed > inputEnd - state.ip {
          LzmaState.reject(&mut state, DecodeReason.TruncatedInput)
          return ()
        }
        if unpacked > outputEnd - state.op {
          LzmaState.reject(&mut state, DecodeReason.OutputLimit)
          return ()
        }
        state.inputEnd = state.ip + packed
        state.outputEnd = state.op + unpacked
        LzmaState.startRange(&mut state, input)
        while state.op < state.outputEnd && !state.failed && !state.ended {
          LzmaState.symbol(&mut state, input, &mut output)
        }
        if state.failed {
          if state.reason == DecodeReason.OutputLimit {
            state.reason = DecodeReason.InvalidSize
          }
          return ()
        }
        if state.ended || state.op != state.outputEnd || state.ip != state.inputEnd
          || state.code != 0 {
          LzmaState.reject(&mut state, DecodeReason.InvalidSize)
          return ()
        }
        state.inputEnd = inputEnd
        state.outputEnd = outputEnd
      }
    }
  }
}
