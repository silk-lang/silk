fn literalCode(length: u32) -> usize {
  if length < 16 {
    return u32.toUsize(length)
  }
  if length >= 64 {
    return u32.toUsize(highBit(length) + 19)
  }
  let mut code: usize = 16
  while code < 35 && LITERAL_BASE[code + 1] <= length {
    code = code + 1
  }
  return code
}

fn matchCode(length: u32) -> usize {
  let base = length - 3
  if base < 32 {
    return u32.toUsize(base)
  }
  if base >= 128 {
    return u32.toUsize(highBit(base) + 36)
  }
  let mut code: usize = 32
  while code < 52 && MATCH_BASE[code + 1] <= length {
    code = code + 1
  }
  return code
}

fn defaultCount(kind: u32, symbol: usize) -> i64 {
  if kind == 0 {
    return LITERAL_DEFAULT[symbol]
  }
  if kind == 1 {
    if symbol > 28 {
      return 0
    }
    return OFFSET_DEFAULT[symbol]
  }
  return MATCH_DEFAULT[symbol]
}

fn buildKindTable(
  state: &mut ZstdEncoder,
  kind: u32,
  normalized: &[i64; 64],
  maxSymbol: usize,
  log: u32,
) -> () {
  if kind == 0 {
    buildTable(&mut state.literalTable, normalized, maxSymbol, log)
  } else if kind == 1 {
    buildTable(&mut state.offsetTable, normalized, maxSymbol, log)
  } else {
    buildTable(&mut state.matchTable, normalized, maxSymbol, log)
  }
}

fn setRle(state: &mut ZstdEncoder, kind: u32) -> () {
  if kind == 0 {
    state.literalTable.rle = true
    state.literalTable.log = 0
  } else if kind == 1 {
    state.offsetTable.rle = true
    state.offsetTable.log = 0
  } else {
    state.matchTable.rle = true
    state.matchTable.log = 0
  }
}

// Picks RLE, predefined, or a new FSE table for one symbol stream, writes its description to the
// stage, builds its encoding table, and returns the mode.
fn chooseTable(
  state: &mut ZstdEncoder,
  kind: u32,
  counts: &[u32; 64],
  maxSymbol: usize,
  total: usize,
) -> u32 {
  let mut distinct: usize = 0
  let mut only: usize = 0
  let mut symbol: usize = 0
  while symbol <= maxSymbol {
    if counts[symbol] != 0 {
      distinct = distinct + 1
      only = symbol
    }
    symbol = symbol + 1
  }
  let mut defaultLog: u32 = 6
  let mut maxLog: u32 = 9
  let mut defaultMax: usize = 35
  if kind == 1 {
    defaultLog = 5
    maxLog = 8
    defaultMax = 28
  } else if kind == 2 {
    defaultMax = 52
  }
  let mut defaultCost: i64 = 0
  let mut defaultValid = maxSymbol <= defaultMax
  symbol = 0
  while symbol <= maxSymbol && defaultValid {
    if counts[symbol] != 0 {
      let count = defaultCount(kind, symbol)
      if count == 0 {
        defaultValid = false
      } else {
        defaultCost = defaultCost + u32.toI64(counts[symbol]) * symbolCost(count, defaultLog)
      }
    }
    symbol = symbol + 1
  }
  if distinct == 1 && (total > 2 || !defaultValid) {
    stageByte(&mut state, usize.toU8(only))
    setRle(&mut state, kind)
    return 1
  }
  if defaultValid && total <= 16 {
    useDefault(&mut state, kind, defaultMax, defaultLog)
    return 0
  }
  let log = optimalLog(maxLog, total, maxSymbol)
  let mut normalized: [i64; 64] = [0; 64]
  normalize(counts, maxSymbol, total, log, total >= 2048, &mut normalized)
  let begin = state.stageLength
  writeDistribution(&mut state, &normalized, maxSymbol, log)
  let mut customCost = usize.toI64(state.stageLength - begin) * 8 * 256
  symbol = 0
  while symbol <= maxSymbol {
    if counts[symbol] != 0 {
      customCost = customCost + u32.toI64(counts[symbol]) * symbolCost(normalized[symbol], log)
    }
    symbol = symbol + 1
  }
  if defaultValid && defaultCost <= customCost {
    state.stageLength = begin
    useDefault(&mut state, kind, defaultMax, defaultLog)
    return 0
  }
  buildKindTable(&mut state, kind, &normalized, maxSymbol, log)
  return 2
}

fn useDefault(state: &mut ZstdEncoder, kind: u32, maxSymbol: usize, log: u32) -> () {
  let mut normalized: [i64; 64] = [0; 64]
  let mut symbol: usize = 0
  while symbol <= maxSymbol {
    normalized[symbol] = defaultCount(kind, symbol)
    symbol = symbol + 1
  }
  buildKindTable(&mut state, kind, &normalized, maxSymbol, log)
}

fn tableLog(state: &ZstdEncoder, kind: u32) -> u32 {
  if kind == 0 {
    return state.literalTable.log
  }
  if kind == 1 {
    return state.offsetTable.log
  }
  return state.matchTable.log
}

@inlineAlways
fn tableRle(state: &ZstdEncoder, kind: u32) -> bool {
  if kind == 0 {
    return state.literalTable.rle
  }
  if kind == 1 {
    return state.offsetTable.rle
  }
  return state.matchTable.rle
}

fn startState(state: &ZstdEncoder, kind: u32, symbol: usize) -> u32 {
  if tableRle(state, kind) {
    return 0
  }
  if kind == 0 {
    return initialState(&state.literalTable, symbol)
  }
  if kind == 1 {
    return initialState(&state.offsetTable, symbol)
  }
  return initialState(&state.matchTable, symbol)
}

@inlineAlways
fn stepState(state: &mut ZstdEncoder, kind: u32, value: u32, symbol: usize) -> u32 {
  if tableRle(&state, kind) {
    return 0
  }
  return encodeSymbol(&mut state, kind, value, symbol)
}

@inlineAlways
fn sequenceExtras(state: &mut ZstdEncoder, index: usize) -> () {
  let literal = List<u32>.get(&state.sequenceLiteral, index)
  let literalSymbol = u8.toUsize(List<u8>.get(&state.literalCodes, index))
  addBits(&mut state, literal - LITERAL_BASE[literalSymbol], LITERAL_EXTRA[literalSymbol])
  let length = List<u32>.get(&state.sequenceMatch, index)
  let matchSymbol = u8.toUsize(List<u8>.get(&state.matchCodes, index))
  addBits(&mut state, length - MATCH_BASE[matchSymbol], MATCH_EXTRA[matchSymbol])
  let offset = List<u32>.get(&state.sequenceOffset, index)
  let offsetSymbol = u8.toU32(List<u8>.get(&state.offsetCodes, index))
  addBits(&mut state, offset - u32.shiftLeft(1, offsetSymbol), offsetSymbol)
}

// Writes the sequences section: the count, the table modes and descriptions, and the backward
// bit stream of codes and extra bits.
fn encodeSequences(state: &mut ZstdEncoder) -> () {
  let count = state.sequenceCount
  if count < 128 {
    stageByte(&mut state, usize.toU8(count))
  } else if count < 32512 {
    stageByte(&mut state, usize.toU8(usize.shiftRight(count, 8) + 128))
    stageByte(&mut state, usize.toU8(count & 255))
  } else {
    stageByte(&mut state, 255)
    stageLittle(&mut state, usize.toU32(count - 32512), 2)
  }
  if count == 0 {
    return ()
  }
  let mut literalCounts: [u32; 64] = [0; 64]
  let mut matchCounts: [u32; 64] = [0; 64]
  let mut offsetCounts: [u32; 64] = [0; 64]
  let mut literalMax: usize = 0
  let mut matchMax: usize = 0
  let mut offsetMax: usize = 0
  let mut index: usize = 0
  while index < count {
    let literal = literalCode(List<u32>.get(&state.sequenceLiteral, index))
    let length = matchCode(List<u32>.get(&state.sequenceMatch, index))
    let offset = u32.toUsize(highBit(List<u32>.get(&state.sequenceOffset, index)))
    List<u8>.set(&mut state.literalCodes, index, usize.toU8(literal))
    List<u8>.set(&mut state.matchCodes, index, usize.toU8(length))
    List<u8>.set(&mut state.offsetCodes, index, usize.toU8(offset))
    literalCounts[literal] = literalCounts[literal] + 1
    matchCounts[length] = matchCounts[length] + 1
    offsetCounts[offset] = offsetCounts[offset] + 1
    if literal > literalMax {
      literalMax = literal
    }
    if length > matchMax {
      matchMax = length
    }
    if offset > offsetMax {
      offsetMax = offset
    }
    index = index + 1
  }
  let modes = state.stageLength
  stageByte(&mut state, 0)
  let literalMode = chooseTable(&mut state, 0, &literalCounts, literalMax, count)
  let offsetMode = chooseTable(&mut state, 1, &offsetCounts, offsetMax, count)
  let matchMode = chooseTable(&mut state, 2, &matchCounts, matchMax, count)
  stagePatch(
    &mut state,
    modes,
    u32.shiftLeft(literalMode, 6) | u32.shiftLeft(offsetMode, 4) | u32.shiftLeft(matchMode, 2),
    1,
  )
  let last = count - 1
  let mut matchState = startState(&state, 2, u8.toUsize(List<u8>.get(&state.matchCodes, last)))
  let mut offsetState = startState(&state, 1, u8.toUsize(List<u8>.get(&state.offsetCodes, last)))
  let mut literalState = startState(&state, 0, u8.toUsize(List<u8>.get(&state.literalCodes, last)))
  let literalRle = state.literalTable.rle
  let matchRle = state.matchTable.rle
  let offsetRle = state.offsetTable.rle
  let mut writer = BitWriter {
    bits: 0,
    count: 0,
    position: state.stageLength,
    limit: List<u8>.length(&state.stage) - 8,
    full: state.stageFull,
  }
  let literals = List<u32>.asSlice(&state.sequenceLiteral)
  let matches = List<u32>.asSlice(&state.sequenceMatch)
  let offsets = List<u32>.asSlice(&state.sequenceOffset)
  let literalCodes = List<u8>.asSlice(&state.literalCodes)
  let matchCodes = List<u8>.asSlice(&state.matchCodes)
  let offsetCodes = List<u8>.asSlice(&state.offsetCodes)
  index = count
  while index > 0 {
    index = index - 1
    let literalSymbol = u8.toUsize(literalCodes[index])
    let matchSymbol = u8.toUsize(matchCodes[index])
    let offsetSymbol = u8.toUsize(offsetCodes[index])
    if index != last {
      if !offsetRle {
        offsetState = fseStep(
          &state.offsetTable,
          &mut writer,
          &mut state.stage,
          offsetState,
          offsetSymbol,
        )
      }
      if !matchRle {
        matchState = fseStep(
          &state.matchTable,
          &mut writer,
          &mut state.stage,
          matchState,
          matchSymbol,
        )
      }
      if !literalRle {
        literalState = fseStep(
          &state.literalTable,
          &mut writer,
          &mut state.stage,
          literalState,
          literalSymbol,
        )
      }
    }
    put(
      &mut writer,
      &mut state.stage,
      literals[index] - LITERAL_BASE[literalSymbol],
      LITERAL_EXTRA[literalSymbol],
    )
    put(
      &mut writer,
      &mut state.stage,
      matches[index] - MATCH_BASE[matchSymbol],
      MATCH_EXTRA[matchSymbol],
    )
    let offsetBits = usize.toU32(offsetSymbol)
    put(&mut writer, &mut state.stage, offsets[index] - u32.shiftLeft(1, offsetBits), offsetBits)
  }
  put(&mut writer, &mut state.stage, matchState, state.matchTable.log)
  put(&mut writer, &mut state.stage, offsetState, state.offsetTable.log)
  put(&mut writer, &mut state.stage, literalState, state.literalTable.log)
  if writer.position > writer.limit {
    writer.full = true
    writer.position = writer.limit
  }
  state.stageLength = writer.position
  state.stageFull = writer.full
  state.bitBuffer = writer.bits
  state.bitCount = writer.count
  closeBits(&mut state)
}

// A bit writer that lives in locals during a hot loop and writes 8 bytes at a time into a stage.
struct BitWriter {
  bits: u64,
  count: u32,
  position: usize,
  limit: usize,
  full: bool,
}

// Adds the low `count` bits of `value`, at most 32.
@inlineAlways
fn put(writer: &mut BitWriter, stage: &mut List<u8>, value: u32, count: u32) -> () {
  let masked = u32.toU64(value) & (u64.shiftLeft(1, u32.toU64(count)) - 1)
  writer.bits = writer.bits | u64.shiftLeft(masked, u32.toU64(writer.count))
  writer.count = writer.count + count
  if writer.count >= 32 {
    if writer.position > writer.limit {
      writer.full = true
    } else {
      store64(&mut stage, writer.position, writer.bits)
    }
    let bytes = u32.shiftRight(writer.count, 3)
    writer.position = writer.position + u32.toUsize(bytes)
    writer.bits = u64.shiftRight(writer.bits, u32.toU64(u32.shiftLeft(bytes, 3)))
    writer.count = writer.count - u32.shiftLeft(bytes, 3)
  }
}

// Writes the bits of one symbol for an FSE state and returns the next state.
@inlineAlways
fn fseStep(
  table: &FseTable,
  writer: &mut BitWriter,
  stage: &mut List<u8>,
  value: u32,
  symbol: usize,
) -> u32 {
  let bits = u32.shiftRight(value + table.deltaBits[symbol], 16)
  put(&mut writer, &mut stage, value, bits)
  let slot = i64.toUsize(u32.toI64(u32.shiftRight(value, bits)) + table.deltaFind[symbol])
  return table.state[slot]
}
