//! Compress bytes as Zstandard frames (RFC 8878), in steps or all at once, with levels 1 to 22.
//!
//! # When to use
//! Use a [`ZstdEncoder`] to write `.zst` files or HTTP bodies with `Content-Encoding: zstd`, in
//! steps and with fixed memory. Use [`ZstdEncoder.encode`] to compress one complete buffer. Decode
//! with `silk.compress.zstd.Zstd`.
//!
//! # Details
//! The encoder finds matches with hash chains over a window of up to 128 MiB, greedily for low
//! levels and lazily for higher ones. It codes literals with Huffman codes and sequences with
//! FSE tables made for each block, or the predefined tables when those are smaller. A block that
//! does not shrink is stored raw, and a block of one repeated byte is stored as RLE.
//! [`ZstdEncoder.make`] allocates all storage one time. Later calls do not allocate and do not
//! keep a borrow of your buffers. The output is deterministic but is not the same bytes that the
//! reference `zstd` writes.
//!
//! # Examples
//! ## Compress a buffer
//! ```silk
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.core.effect { Effect }
//! import silk.compress.zstd_encode { ZstdEncodeError, ZstdEncoder, ZstdOptions }
//!
//! pub effect fn main() -> i32
//!   ! OutOfMemoryError | ZstdEncodeError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let input = b"abcabcabcabcabcabcabcabcabcabcabcabc"
//!   let mut output: [u8; 64] = [0; 64]
//!   let written = run ZstdEncoder.encode(input, &mut output, ZstdOptions.make(3))
//!     |> Effect.provideMut<Allocator>(&mut allocator)
//!   // A frame starts with the magic number 28 b5 2f fd.
//!   if output[0] != 40 || output[3] != 253 || written >= input.length {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Data formats

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.format { Debug, Format as TextFormat, Formatter }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.compress.zstd_checksum { Xxh64 }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.i64
import silk.num.usize
import silk.io.writer { Writer, WriterError }

/// What a call to [`ZstdEncoder.step`] must finish before it returns.
///
/// The values match the end directives of the reference `ZSTD_compressStream2`.
pub enum ZstdFlush {
  /// Compress as the encoder sees fit. Output can lag behind the input by up to one block.
  Continue,
  /// Write all input in complete blocks, so that a decoder can decode all of it.
  Flush,
  /// Write all input, end the frame, and write the checksum if it is on. After it finishes, the
  /// encoder accepts no more input.
  End,
}

/// What the encoder needs after a successful [`ZstdEncoder.step`].
pub enum ZstdEncodeStatus {
  /// All input is consumed and the flush was `Continue`. Call again with more input, or with
  /// another flush.
  NeedInput,
  /// The output buffer is full. Call again with a new output buffer, the input that was not
  /// consumed, and the same flush.
  NeedOutput,
  /// All input is consumed and written in complete blocks, after `ZstdFlush.Flush`.
  Flushed,
  /// The frame is complete.
  Finished,
}

/// The result of one successful [`ZstdEncoder.step`].
pub struct ZstdEncodeProgress {
  /// The number of input bytes that this call consumed, from the start of the input.
  pub consumed: usize,
  /// The number of output bytes that this call wrote, from the start of the output.
  pub written: usize,
  /// What the encoder needs next.
  pub status: ZstdEncodeStatus,
}

/// The cause of a [`ZstdEncodeError`].
pub enum ZstdEncodeErrorKind {
  /// The level or window size is outside its range.
  InvalidOptions,
  /// The call is not allowed now: a pledged size after the frame started, input after the frame
  /// finished, a frame whose size differs from the pledged size, or any step after a failure.
  InvalidUse,
  /// [`ZstdEncoder.encode`] filled the output buffer before the frame was complete.
  OutputFull,
}

impl Debug for ZstdEncodeErrorKind {
  /// Writes the name of the variant, such as `InvalidOptions`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return match &self.* {
      ZstdEncodeErrorKind.InvalidOptions => run TextFormat.write(&mut formatter, b"InvalidOptions")
      ZstdEncodeErrorKind.InvalidUse => run TextFormat.write(&mut formatter, b"InvalidUse")
      ZstdEncodeErrorKind.OutputFull => run TextFormat.write(&mut formatter, b"OutputFull")
    }
  }
}

/// An encoding failure, with the progress of the call before it failed.
///
/// # Gotchas
/// After a failed [`ZstdEncoder.step`], discard the frame. Each later step fails with
/// `InvalidUse` until you call [`ZstdEncoder.reset`].
pub struct ZstdEncodeError {
  /// The cause of the failure.
  pub kind: ZstdEncodeErrorKind,
  /// The number of input bytes that the call consumed before it failed.
  pub consumed: usize,
  /// The number of output bytes that the call wrote before it failed.
  pub written: usize,
}

impl Debug for ZstdEncodeError {
  /// Writes the fields, as `ZstdEncodeError { kind: ..., consumed: ..., written: ... }`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return run TextFormat.debugFields(self, "ZstdEncodeError", &mut formatter)
  }
}

/// The settings of a [`ZstdEncoder`].
pub struct ZstdOptions {
  /// The effort, from 1 to 22. 1 is the fastest, 22 the smallest, and 3 is the default of the
  /// reference `zstd`.
  pub level: u32,
  /// The base-2 logarithm of the match window, from 10 to 27. A larger window finds older matches
  /// and uses more memory. The decoder needs a window of the same size.
  pub windowLog: u32,
  /// Whether the frame ends with the low 32 bits of the XXH64 of the content.
  pub checksum: bool,
  /// Whether the frame header records the content size when the encoder knows it: from
  /// [`ZstdEncoder.setPledgedSize`], or when the first step ends the frame.
  pub contentSize: bool,
}

impl ZstdOptions {
  /// Returns options for `level` with the window of the reference `zstd` for that level (512 KiB
  /// for level 1, 1 MiB for 2, 2 MiB for 3 to 5, 4 MiB for 6 to 12, and 8 MiB above), no checksum,
  /// and the content size recorded when known.
  pub fn make(level: u32) -> ZstdOptions {
    let mut windowLog: u32 = 23
    if level <= 1 {
      windowLog = 19
    } else if level == 2 {
      windowLog = 20
    } else if level <= 5 {
      windowLog = 21
    } else if level <= 12 {
      windowLog = 22
    }
    return ZstdOptions { level: level, windowLog: windowLog, checksum: false, contentSize: true }
  }
}

struct FseTable {
  state: [u32; 512],
  deltaBits: [u32; 64],
  deltaFind: [i64; 64],
  log: u32,
  rle: bool,
}

/// A streaming Zstandard encoder that owns its window, match tables, and output buffer.
///
/// # When to use
/// Use it to compress data that arrives in parts, as the reference `ZSTD_compressStream2` does.
/// Make one with [`ZstdEncoder.make`], call [`ZstdEncoder.step`] with each part of the input, and
/// end with `ZstdFlush.End`. Call [`ZstdEncoder.reset`] to write another frame with the same
/// storage.
///
/// # Details
/// [`ZstdEncoder.make`] allocates all storage one time: twice the window, the hash and chain
/// tables (up to 16 MiB each for the highest levels), and about 640 KiB of block buffers. Later
/// calls do not allocate and do not keep a borrow of your buffers, so you can move the encoder
/// between threads between calls.
pub struct ZstdEncoder {
  level: u32,
  windowLog: u32,
  windowSize: usize,
  blockSize: usize,
  checksumOn: bool,
  contentSizeOn: bool,
  searches: u32,
  lazy: u32,
  niceLength: usize,
  hashLog: u32,
  chainMask: usize,
  buffer: List<u8>,
  bufferEnd: usize,
  compressedEnd: usize,
  nextInsert: usize,
  hashTable: List<u32>,
  chainTable: List<u32>,
  repeat: [u32; 3],
  literals: List<u8>,
  literalCount: usize,
  sequenceLiteral: List<u32>,
  sequenceMatch: List<u32>,
  sequenceOffset: List<u32>,
  sequenceCount: usize,
  literalCodes: List<u8>,
  matchCodes: List<u8>,
  offsetCodes: List<u8>,
  literalTable: FseTable,
  matchTable: FseTable,
  offsetTable: FseTable,
  huffmanCode: [u32; 256],
  huffmanBits: [u32; 256],
  stage: List<u8>,
  stageLength: usize,
  stageFull: bool,
  bitBuffer: u64,
  bitCount: u32,
  pending: List<u8>,
  pendingLength: usize,
  pendingOffset: usize,
  phase: u32,
  pledged: u64,
  hasPledged: bool,
  totalIn: u64,
  hash: Xxh64,
  wroteLast: bool,
  flushed: bool,
  inputPosition: usize,
  outputPosition: usize,
}

const BLOCK_MAX: usize = 131072

const MIN_MATCH: usize = 4

const PHASE_START: u32 = 0

const PHASE_RUNNING: u32 = 1

const PHASE_FINISHED: u32 = 2

const PHASE_FAILED: u32 = 3

impl ZstdEncoder {
  /// Returns an encoder for one frame with `options`, with storage from the ambient `Allocator`.
  ///
  /// # Errors
  /// - [`ZstdEncodeError`] with `InvalidOptions` if the level is not 1 to 22 or the window log is
  ///   not 10 to 27, checked before the allocation.
  /// - `OutOfMemoryError` if the `Allocator` fails.
  pub effect fn make(options: ZstdOptions) -> ZstdEncoder
    ! OutOfMemoryError | ZstdEncodeError
    ? &mut Allocator {
    if options.level < 1 || options.level > 22 || options.windowLog < 10 || options.windowLog > 27 {
      fail ZstdEncodeError { kind: ZstdEncodeErrorKind.InvalidOptions, consumed: 0, written: 0 }
    }
    let windowSize = usize.shiftLeft(1, u32.toUsize(options.windowLog))
    let mut blockSize = BLOCK_MAX
    if blockSize > windowSize {
      blockSize = windowSize
    }
    let searches: [u32; 22] = [
      1,
      2,
      4,
      6,
      8,
      12,
      16,
      24,
      32,
      48,
      64,
      80,
      96,
      128,
      160,
      192,
      256,
      320,
      384,
      512,
      768,
      1024,
    ]
    let level = options.level
    let mut lazy: u32 = 0
    if level >= 8 {
      lazy = 2
    } else if level >= 4 {
      lazy = 1
    }
    let niceLength = u32.toUsize(level) * 16
    let mut hashLog = 15 + level
    if hashLog > 22 {
      hashLog = 22
    }
    if hashLog > options.windowLog {
      hashLog = options.windowLog
    }
    let mut chainLog = 14 + (level + 1) / 2
    if chainLog > 22 {
      chainLog = 22
    }
    if chainLog >= options.windowLog {
      chainLog = options.windowLog - 1
    }
    let chainSize = usize.shiftLeft(1, u32.toUsize(chainLog))
    let mut span = windowSize
    if span < BLOCK_MAX {
      span = BLOCK_MAX
    }
    let mut buffer = List<u8>.make()
    run List<u8>.appendRepeated(&mut buffer, 0, 2 * span + chainSize)
    let mut hashTable = List<u32>.make()
    run List<u32>.appendRepeated(&mut hashTable, 0, usize.shiftLeft(1, u32.toUsize(hashLog)))
    let mut chainTable = List<u32>.make()
    run List<u32>.appendRepeated(&mut chainTable, 0, chainSize)
    let mut literals = List<u8>.make()
    run List<u8>.appendRepeated(&mut literals, 0, BLOCK_MAX)
    let mut sequenceLiteral = List<u32>.make()
    run List<u32>.appendRepeated(&mut sequenceLiteral, 0, BLOCK_MAX / 4 + 1)
    let mut sequenceMatch = List<u32>.make()
    run List<u32>.appendRepeated(&mut sequenceMatch, 0, BLOCK_MAX / 4 + 1)
    let mut sequenceOffset = List<u32>.make()
    run List<u32>.appendRepeated(&mut sequenceOffset, 0, BLOCK_MAX / 4 + 1)
    let mut literalCodes = List<u8>.make()
    run List<u8>.appendRepeated(&mut literalCodes, 0, BLOCK_MAX / 4 + 1)
    let mut matchCodes = List<u8>.make()
    run List<u8>.appendRepeated(&mut matchCodes, 0, BLOCK_MAX / 4 + 1)
    let mut offsetCodes = List<u8>.make()
    run List<u8>.appendRepeated(&mut offsetCodes, 0, BLOCK_MAX / 4 + 1)
    let mut stage = List<u8>.make()
    run List<u8>.appendRepeated(&mut stage, 0, BLOCK_MAX + 1024)
    let mut pending = List<u8>.make()
    run List<u8>.appendRepeated(&mut pending, 0, BLOCK_MAX + 64)
    let mut encoder = ZstdEncoder {
      level: level,
      windowLog: options.windowLog,
      windowSize: windowSize,
      blockSize: blockSize,
      checksumOn: options.checksum,
      contentSizeOn: options.contentSize,
      searches: searches[u32.toUsize(level - 1)],
      lazy: lazy,
      niceLength: niceLength,
      hashLog: hashLog,
      chainMask: chainSize - 1,
      buffer: move buffer,
      bufferEnd: 0,
      compressedEnd: 0,
      nextInsert: 0,
      hashTable: move hashTable,
      chainTable: move chainTable,
      repeat: [1, 4, 8],
      literals: move literals,
      literalCount: 0,
      sequenceLiteral: move sequenceLiteral,
      sequenceMatch: move sequenceMatch,
      sequenceOffset: move sequenceOffset,
      sequenceCount: 0,
      literalCodes: move literalCodes,
      matchCodes: move matchCodes,
      offsetCodes: move offsetCodes,
      literalTable: emptyTable(),
      matchTable: emptyTable(),
      offsetTable: emptyTable(),
      huffmanCode: [0; 256],
      huffmanBits: [0; 256],
      stage: move stage,
      stageLength: 0,
      stageFull: false,
      bitBuffer: 0,
      bitCount: 0,
      pending: move pending,
      pendingLength: 0,
      pendingOffset: 0,
      phase: PHASE_START,
      pledged: 0,
      hasPledged: false,
      totalIn: 0,
      hash: Xxh64.make(),
      wroteLast: false,
      flushed: false,
      inputPosition: 0,
      outputPosition: 0,
    }
    ZstdEncoder.reset(&mut encoder)
    return move encoder
  }

  /// Starts a new frame with the same options and storage. It does not allocate. It drops the
  /// input and output that the encoder holds, the pledged size, and a failure.
  pub fn reset(self: &mut Self) -> () {
    let table = List<u32>.asMutSlice(&mut self.hashTable)
    let mut index: usize = 0
    while index < table.length {
      table[index] = 0
      index = index + 1
    }
    self.bufferEnd = 0
    self.compressedEnd = 0
    self.nextInsert = 0
    self.repeat = [1, 4, 8]
    self.literalCount = 0
    self.sequenceCount = 0
    self.stageLength = 0
    self.stageFull = false
    self.bitBuffer = 0
    self.bitCount = 0
    self.pendingLength = 0
    self.pendingOffset = 0
    self.phase = PHASE_START
    self.pledged = 0
    self.hasPledged = false
    self.totalIn = 0
    self.hash = Xxh64.make()
    self.wroteLast = false
    self.flushed = false
  }

  /// Declares the exact size of the frame's content before the first step, as the reference
  /// `ZSTD_CCtx_setPledgedSrcSize` does. The frame header then records the size.
  ///
  /// # Errors
  /// `InvalidUse` after the first step or after a failure. The step that ends the frame fails with
  /// `InvalidUse` if the content has another size.
  pub fn setPledgedSize(self: &mut Self, size: u64) -> Result<(), ZstdEncodeError> {
    if self.phase != PHASE_START {
      return Result<(), ZstdEncodeError>.failResult(
        ZstdEncodeError { kind: ZstdEncodeErrorKind.InvalidUse, consumed: 0, written: 0 },
      )
    }
    self.pledged = size
    self.hasPledged = true
    return Result<(), ZstdEncodeError>.succeed(())
  }

  /// Compresses from `input` into `output` and returns how much it consumed and wrote.
  ///
  /// # Details
  /// On the next call, give only the input after the consumed prefix. You can give a new output
  /// buffer of any length. Call with `ZstdFlush.Continue` while more input follows. A flush
  /// finishes only when the step returns `Flushed`, or `Finished` for `ZstdFlush.End`. Until then,
  /// call again with the same flush.
  ///
  /// # Errors
  /// `InvalidUse` with input after the frame finished, a frame whose size differs from the pledged
  /// size, or after an earlier failure.
  pub fn step(self: &mut Self, input: &[u8], output: &mut [u8], flush: ZstdFlush) -> Result<
    ZstdEncodeProgress,
    ZstdEncodeError,
  > {
    self.inputPosition = 0
    self.outputPosition = 0
    if self.phase == PHASE_FAILED {
      return failure(&mut self, ZstdEncodeErrorKind.InvalidUse)
    }
    if self.phase == PHASE_FINISHED {
      if !drain(&mut self, &mut output) {
        return success(&mut self, ZstdEncodeStatus.NeedOutput)
      }
      if input.length != 0 {
        return failure(&mut self, ZstdEncodeErrorKind.InvalidUse)
      }
      return success(&mut self, ZstdEncodeStatus.Finished)
    }
    if self.phase == PHASE_START {
      writeFrameHeader(&mut self, input.length, flush == ZstdFlush.End)
      self.phase = PHASE_RUNNING
    }
    if input.length != 0 {
      self.flushed = false
    }
    while true {
      if !drain(&mut self, &mut output) {
        return success(&mut self, ZstdEncodeStatus.NeedOutput)
      }
      let buffered = self.bufferEnd - self.compressedEnd
      let remaining = input.length - self.inputPosition
      if buffered >= self.blockSize {
        let size = self.blockSize
        let last = flush == ZstdFlush.End && remaining == 0 && buffered == size
        compressBlock(&mut self, size, last)
        continue
      }
      if remaining != 0 {
        fill(&mut self, input)
        continue
      }
      if flush == ZstdFlush.Continue {
        return success(&mut self, ZstdEncodeStatus.NeedInput)
      }
      if flush == ZstdFlush.Flush {
        if buffered != 0 {
          compressBlock(&mut self, buffered, false)
          continue
        }
        self.flushed = true
        return success(&mut self, ZstdEncodeStatus.Flushed)
      }
      if self.hasPledged && self.totalIn != self.pledged {
        return failure(&mut self, ZstdEncodeErrorKind.InvalidUse)
      }
      if buffered != 0 || !self.wroteLast {
        compressBlock(&mut self, buffered, true)
      }
      if self.checksumOn {
        let digest = u64.toU32(Xxh64.finish(&self.hash) & 0xffffffff)
        putLittle(&mut self, digest, 4)
      }
      self.phase = PHASE_FINISHED
      if !drain(&mut self, &mut output) {
        return success(&mut self, ZstdEncodeStatus.NeedOutput)
      }
      return success(&mut self, ZstdEncodeStatus.Finished)
    }
    return failure(&mut self, ZstdEncodeErrorKind.InvalidUse)
  }

  /// Returns the most bytes that [`ZstdEncoder.encode`] can write for `length` input bytes with
  /// any options, or `None` if that count does not fit in `usize`.
  ///
  /// # Details
  /// An output buffer of this size never fails with `OutputFull`. The bound is the frame header
  /// (at most 18 bytes), 3 bytes per 128 KiB block or part of one, the input, and a 4-byte
  /// checksum.
  pub fn encodedBound(length: usize) -> Option<usize> {
    let blocks = usize.divide(length, BLOCK_MAX) + 1
    return usize.checkedAdd(length, blocks * 3 + 22)
  }

  /// Compresses all of `input` into the start of `output` as one frame with `options`, and returns
  /// the encoded length.
  ///
  /// # Details
  /// It makes a [`ZstdEncoder`] with storage from the ambient `Allocator`, runs one step with
  /// `ZstdFlush.End`, and releases the storage before it returns. The window shrinks to the
  /// smallest power of two, at least 1 KiB, that holds the input, so small inputs need little
  /// memory and the decoder needs a small window. The frame header records the
  /// content size if `options.contentSize` is set.
  ///
  /// # Errors
  /// - `OutputFull` if `output` fills before the frame is complete. It never occurs when `output`
  ///   holds at least `ZstdEncoder.encodedBound(input.length)` bytes. Discard the partial frame.
  /// - `InvalidOptions` if an option is outside its range.
  /// - `OutOfMemoryError` if the `Allocator` fails.
  pub effect fn encode(input: &[u8], output: &mut [u8], options: ZstdOptions) -> usize
    ! OutOfMemoryError | ZstdEncodeError
    ? &mut Allocator {
    let mut fitted = move options
    let mut needed: u32 = 10
    while needed < fitted.windowLog && usize.shiftLeft(1, u32.toUsize(needed)) < input.length {
      needed = needed + 1
    }
    fitted.windowLog = needed
    let mut encoder = run ZstdEncoder.make(move fitted)
    return match ZstdEncoder.step(&mut encoder, input, &mut output, ZstdFlush.End) {
      Result<ZstdEncodeProgress, ZstdEncodeError>.Success { value } => {
        if value.status != ZstdEncodeStatus.Finished {
          fail ZstdEncodeError {
            kind: ZstdEncodeErrorKind.OutputFull,
            consumed: value.consumed,
            written: value.written,
          }
        }
        value.written
      }
      Result<ZstdEncodeProgress, ZstdEncodeError>.Failure { error } => {
        fail move error
      }
    }
  }
}

fn emptyTable() -> FseTable {
  return FseTable { state: [0; 512], deltaBits: [0; 64], deltaFind: [0; 64], log: 0, rle: false }
}

fn success(state: &mut ZstdEncoder, status: ZstdEncodeStatus) -> Result<
  ZstdEncodeProgress,
  ZstdEncodeError,
> {
  return Result<ZstdEncodeProgress, ZstdEncodeError>.succeed(
    ZstdEncodeProgress {
      consumed: state.inputPosition,
      written: state.outputPosition,
      status: status,
    },
  )
}

fn failure(state: &mut ZstdEncoder, kind: ZstdEncodeErrorKind) -> Result<
  ZstdEncodeProgress,
  ZstdEncodeError,
> {
  state.phase = PHASE_FAILED
  return Result<ZstdEncodeProgress, ZstdEncodeError>.failResult(
    ZstdEncodeError { kind: kind, consumed: state.inputPosition, written: state.outputPosition },
  )
}

// Copies pending bytes to the output; returns whether no pending byte is left.
fn drain(state: &mut ZstdEncoder, output: &mut [u8]) -> bool {
  let available = state.pendingLength - state.pendingOffset
  if available != 0 {
    let mut count = output.length - state.outputPosition
    if count > available {
      count = available
    }
    if count != 0 {
      let source = Slice.view<u8>(List<u8>.asSlice(&state.pending), state.pendingOffset, count)
      Slice.copyInto<u8>(&mut output, state.outputPosition, source)
      state.outputPosition = state.outputPosition + count
      state.pendingOffset = state.pendingOffset + count
    }
  }
  if state.pendingOffset == state.pendingLength {
    state.pendingOffset = 0
    state.pendingLength = 0
    return true
  }
  return false
}

fn putByte(state: &mut ZstdEncoder, value: u8) -> () {
  let position = state.pendingLength
  List<u8>.set(&mut state.pending, position, value)
  state.pendingLength = position + 1
}

fn putLittle(state: &mut ZstdEncoder, value: u32, count: u32) -> () {
  let mut index: u32 = 0
  while index < count {
    putByte(&mut state, u32.toU8(u32.shiftRight(value, index * 8) & 255))
    index = index + 1
  }
}

fn writeFrameHeader(state: &mut ZstdEncoder, inputLength: usize, endNow: bool) -> () {
  let mut known = false
  let mut size: u64 = 0
  if state.hasPledged {
    known = true
    size = state.pledged
  } else if endNow {
    known = true
    size = usize.toU64(inputLength)
  }
  if !state.contentSizeOn {
    known = false
  }
  let single = known && size <= usize.toU64(state.windowSize)
  let mut sizeFlag: u32 = 0
  if known {
    if single && size < 256 {
      sizeFlag = 0
    } else if size >= 256 && size < 65792 {
      sizeFlag = 1
    } else if size <= 4294967295 {
      sizeFlag = 2
    } else {
      sizeFlag = 3
    }
  }
  let mut descriptor = u32.shiftLeft(sizeFlag, 6)
  if single {
    descriptor = descriptor | 32
  }
  if state.checksumOn {
    descriptor = descriptor | 4
  }
  putLittle(&mut state, 0xfd2fb528, 4)
  putByte(&mut state, u32.toU8(descriptor))
  if !single {
    let windowByte = u32.toU8(u32.shiftLeft(state.windowLog - 10, 3))
    putByte(&mut state, windowByte)
  }
  if known {
    if sizeFlag == 0 {
      putByte(&mut state, u64.toU8(size))
    } else if sizeFlag == 1 {
      putLittle(&mut state, u64.toU32(size - 256), 2)
    } else if sizeFlag == 2 {
      putLittle(&mut state, u64.toU32(size), 4)
    } else {
      putLittle(&mut state, u64.toU32(size & 0xffffffff), 4)
      putLittle(&mut state, u64.toU32(u64.shiftRight(size, 32)), 4)
    }
  }
  if single {
    // A single-segment frame's window is its content, so blocks cannot be longer.
    let content = u64.toUsize(size)
    if content < state.blockSize && content > 0 {
      state.blockSize = content
    }
  }
}

// Copies input into the buffer after the uncompressed bytes, sliding the history down when the
// buffer is full.
fn fill(state: &mut ZstdEncoder, input: &[u8]) -> () {
  let capacity = List<u8>.length(&state.buffer)
  if state.bufferEnd == capacity {
    slide(&mut state)
  }
  let mut count = input.length - state.inputPosition
  let room = capacity - state.bufferEnd
  if count > room {
    count = room
  }
  let wanted = state.blockSize - (state.bufferEnd - state.compressedEnd)
  if count > wanted {
    count = wanted
  }
  let source = Slice.view<u8>(input, state.inputPosition, count)
  Slice.copyInto<u8>(List<u8>.asMutSlice(&mut state.buffer), state.bufferEnd, source)
  if state.checksumOn {
    Xxh64.update(&mut state.hash, source)
  }
  state.bufferEnd = state.bufferEnd + count
  state.inputPosition = state.inputPosition + count
  state.totalIn = state.totalIn + usize.toU64(count)
}

// Keeps the last window of history before the uncompressed bytes. The shift is a multiple of the
// chain size, so chain slots stay valid.
fn slide(state: &mut ZstdEncoder) -> () {
  let chainSize = state.chainMask + 1
  let keep = state.compressedEnd - state.windowSize
  let shift = keep - usize.remainder(keep, chainSize)
  let buffer = List<u8>.asMutSlice(&mut state.buffer)
  let mut index: usize = 0
  let moved = state.bufferEnd - shift
  while index < moved {
    buffer[index] = buffer[index + shift]
    index = index + 1
  }
  state.bufferEnd = moved
  state.compressedEnd = state.compressedEnd - shift
  state.nextInsert = state.nextInsert - shift
  let offset = usize.toU32(shift)
  let table = List<u32>.asMutSlice(&mut state.hashTable)
  index = 0
  while index < table.length {
    if table[index] > offset {
      table[index] = table[index] - offset
    } else {
      table[index] = 0
    }
    index = index + 1
  }
  let chain = List<u32>.asMutSlice(&mut state.chainTable)
  index = 0
  while index < chain.length {
    if chain[index] > offset {
      chain[index] = chain[index] - offset
    } else {
      chain[index] = 0
    }
    index = index + 1
  }
}

fn hash4(buffer: &[u8], position: usize, shift: u32) -> usize {
  let value = u8.toU32(buffer[position]) | u32.shiftLeft(u8.toU32(buffer[position + 1]), 8)
    | u32.shiftLeft(u8.toU32(buffer[position + 2]), 16)
    | u32.shiftLeft(u8.toU32(buffer[position + 3]), 24)
  return u32.toUsize(u32.shiftRight(u32.wrappingMultiply(value, 2654435761), shift))
}

// Links every position before `target` that has 4 readable bytes into the hash chains.
fn insertUpTo(state: &mut ZstdEncoder, target: usize) -> () {
  let mut position = state.nextInsert
  let mut stop = target
  if stop + MIN_MATCH > state.bufferEnd + 1 {
    if state.bufferEnd + 1 < MIN_MATCH {
      stop = 0
    } else {
      stop = state.bufferEnd + 1 - MIN_MATCH
    }
  }
  let shift = 32 - state.hashLog
  let mask = state.chainMask
  let buffer = List<u8>.asSlice(&state.buffer)
  let hashes = List<u32>.asMutSlice(&mut state.hashTable)
  let chain = List<u32>.asMutSlice(&mut state.chainTable)
  while position < stop {
    let slot = hash4(buffer, position, shift)
    chain[position & mask] = hashes[slot]
    hashes[slot] = usize.toU32(position + 1)
    position = position + 1
  }
  if position < target {
    position = target
  }
  state.nextInsert = position
}

fn commonLength(buffer: &[u8], earlier: usize, position: usize, limit: usize) -> usize {
  let mut length: usize = 0
  while length < limit && buffer[earlier + length] == buffer[position + length] {
    length = length + 1
  }
  return length
}

struct Found {
  length: usize,
  offset: usize,
}

impl Copy for Found {}

// Returns the longest match at `position` that ends by `end`: repeat offsets first, then the hash
// chain. Inserts `position` afterwards.
fn bestMatch(state: &mut ZstdEncoder, position: usize, end: usize) -> Found {
  insertUpTo(&mut state, position)
  let limit = end - position
  let mut best = Found { length: 0, offset: 0 }
  let buffer = List<u8>.asSlice(&state.buffer)
  let mut index: usize = 0
  while index < 3 {
    let offset = u32.toUsize(state.repeat[index])
    if offset <= position && offset <= state.windowSize {
      let length = commonLength(buffer, position - offset, position, limit)
      if length > best.length {
        best = Found { length: length, offset: offset }
      }
    }
    index = index + 1
  }
  let mut candidate = u32.toUsize(
    List<u32>.get(&state.hashTable, hash4(buffer, position, 32 - state.hashLog)),
  )
  let mut attempts = state.searches
  while candidate != 0 && attempts != 0 && best.length < limit && best.length < state.niceLength {
    let earlier = candidate - 1
    if earlier >= position || position - earlier > state.windowSize {
      break
    }
    if buffer[earlier + best.length] == buffer[position + best.length] {
      let length = commonLength(buffer, earlier, position, limit)
      if length > best.length {
        best = Found { length: length, offset: position - earlier }
      }
    }
    let next = u32.toUsize(List<u32>.get(&state.chainTable, earlier & state.chainMask))
    if next >= candidate {
      break
    }
    candidate = next
    attempts = attempts - 1
  }
  insertUpTo(&mut state, position + 1)
  return best
}

fn highBit(value: u32) -> u32 {
  return 31 - u32.leadingZeros(value)
}

// Approximate cost of a match in quarter bytes: longer is better, a far offset costs its bits.
fn gain(found: &Found) -> i64 {
  return usize.toI64(found.length) * 4 - u32.toI64(highBit(usize.toU32(found.offset) + 1))
}

// Splits the block into literals and sequences with greedy or lazy matching.
fn findSequences(state: &mut ZstdEncoder, start: usize, end: usize) -> () {
  state.literalCount = 0
  state.sequenceCount = 0
  let mut position = start
  let mut anchor = start
  while position + MIN_MATCH <= end {
    let mut found = bestMatch(&mut state, position, end)
    if found.length < MIN_MATCH {
      position = position + 1
      continue
    }
    let mut steps: u32 = 0
    while steps < state.lazy && position + 1 + MIN_MATCH <= end {
      let next = bestMatch(&mut state, position + 1, end)
      if next.length >= MIN_MATCH && gain(&next) > gain(&found) + 4 {
        position = position + 1
        found = next
        steps = steps + 1
      } else {
        break
      }
    }
    addSequence(&mut state, anchor, position, found.length, found.offset)
    position = position + found.length
    anchor = position
  }
  insertUpTo(&mut state, end)
  addLiterals(&mut state, anchor, end)
}

fn addLiterals(state: &mut ZstdEncoder, from: usize, to: usize) -> () {
  let count = to - from
  if count == 0 {
    return ()
  }
  let source = Slice.view<u8>(List<u8>.asSlice(&state.buffer), from, count)
  Slice.copyInto<u8>(List<u8>.asMutSlice(&mut state.literals), state.literalCount, source)
  state.literalCount = state.literalCount + count
}

// Records literals from `anchor` to `position` and a match, choosing a repeat-offset code when it
// applies and updating the repeat offsets as the decoder will.
fn addSequence(
  state: &mut ZstdEncoder,
  anchor: usize,
  position: usize,
  length: usize,
  offset: usize,
) -> () {
  addLiterals(&mut state, anchor, position)
  let literalLength = position - anchor
  let distance = usize.toU32(offset)
  let rep0 = state.repeat[0]
  let rep1 = state.repeat[1]
  let rep2 = state.repeat[2]
  let mut value = distance + 3
  if literalLength != 0 {
    if distance == rep0 {
      value = 1
    } else if distance == rep1 {
      value = 2
      state.repeat = [rep1, rep0, rep2]
    } else if distance == rep2 {
      value = 3
      state.repeat = [rep2, rep0, rep1]
    } else {
      state.repeat = [distance, rep0, rep1]
    }
  } else {
    if distance == rep1 {
      value = 1
      state.repeat = [rep1, rep0, rep2]
    } else if distance == rep2 {
      value = 2
      state.repeat = [rep2, rep0, rep1]
    } else if rep0 > 1 && distance == rep0 - 1 {
      value = 3
      state.repeat = [distance, rep0, rep1]
    } else {
      state.repeat = [distance, rep0, rep1]
    }
  }
  let index = state.sequenceCount
  List<u32>.set(&mut state.sequenceLiteral, index, usize.toU32(literalLength))
  List<u32>.set(&mut state.sequenceMatch, index, usize.toU32(length))
  List<u32>.set(&mut state.sequenceOffset, index, value)
  state.sequenceCount = index + 1
}

fn blockHeader(state: &mut ZstdEncoder, last: bool, kind: u32, size: usize) -> () {
  let mut value = u32.shiftLeft(kind, 1) | u32.shiftLeft(usize.toU32(size), 3)
  if last {
    value = value | 1
  }
  putLittle(&mut state, value, 3)
}

// Compresses `size` buffered bytes as one block: RLE if they are one byte, compressed if that is
// smaller, raw otherwise.
fn compressBlock(state: &mut ZstdEncoder, size: usize, last: bool) -> () {
  let start = state.compressedEnd
  let end = start + size
  state.compressedEnd = end
  if last {
    state.wroteLast = true
  }
  if size == 0 {
    blockHeader(&mut state, last, 0, 0)
    return ()
  }
  let buffer = List<u8>.asSlice(&state.buffer)
  let first = buffer[start]
  let mut same = true
  let mut index = start + 1
  while index < end {
    if buffer[index] != first {
      same = false
      break
    }
    index = index + 1
  }
  if same && size > 1 {
    insertUpTo(&mut state, end)
    blockHeader(&mut state, last, 1, size)
    putByte(&mut state, first)
    return ()
  }
  let saved = state.repeat
  findSequences(&mut state, start, end)
  state.stageLength = 0
  state.stageFull = false
  encodeLiterals(&mut state)
  encodeSequences(&mut state)
  if !state.stageFull && state.stageLength < size {
    let length = state.stageLength
    blockHeader(&mut state, last, 2, length)
    let source = Slice.view<u8>(List<u8>.asSlice(&state.stage), 0, length)
    let target = state.pendingLength
    Slice.copyInto<u8>(List<u8>.asMutSlice(&mut state.pending), target, source)
    state.pendingLength = target + length
    return ()
  }
  state.repeat = saved
  blockHeader(&mut state, last, 0, size)
  let source = Slice.view<u8>(List<u8>.asSlice(&state.buffer), start, size)
  let target = state.pendingLength
  Slice.copyInto<u8>(List<u8>.asMutSlice(&mut state.pending), target, source)
  state.pendingLength = target + size
}

fn stageByte(state: &mut ZstdEncoder, value: u8) -> () {
  let position = state.stageLength
  if position == List<u8>.length(&state.stage) {
    state.stageFull = true
    return ()
  }
  List<u8>.set(&mut state.stage, position, value)
  state.stageLength = position + 1
}

fn stageLittle(state: &mut ZstdEncoder, value: u32, count: u32) -> () {
  let mut index: u32 = 0
  while index < count {
    stageByte(&mut state, u32.toU8(u32.shiftRight(value, index * 8) & 255))
    index = index + 1
  }
}

fn stagePatch(state: &mut ZstdEncoder, position: usize, value: u32, count: u32) -> () {
  let mut index: u32 = 0
  while index < count {
    let slot = position + u32.toUsize(index)
    if slot < state.stageLength {
      List<u8>.set(&mut state.stage, slot, u32.toU8(u32.shiftRight(value, index * 8) & 255))
    }
    index = index + 1
  }
}

// A forward bit writer into the stage, read backward by the decoder.
fn addBits(state: &mut ZstdEncoder, value: u32, count: u32) -> () {
  if count == 0 {
    return ()
  }
  let masked = u32.toU64(value) & (u64.shiftLeft(1, u32.toU64(count)) - 1)
  state.bitBuffer = state.bitBuffer | u64.shiftLeft(masked, u32.toU64(state.bitCount))
  state.bitCount = state.bitCount + count
  while state.bitCount >= 8 {
    let low = u64.toU8(state.bitBuffer & 255)
    stageByte(&mut state, low)
    state.bitBuffer = u64.shiftRight(state.bitBuffer, 8)
    state.bitCount = state.bitCount - 8
  }
}

// Ends a backward bit stream with its 1 marker bit and the padding of its last byte.
fn closeBits(state: &mut ZstdEncoder) -> () {
  addBits(&mut state, 1, 1)
  if state.bitCount != 0 {
    let low = u64.toU8(state.bitBuffer & 255)
    stageByte(&mut state, low)
  }
  state.bitBuffer = 0
  state.bitCount = 0
}

// Approximate base-2 logarithm in 1/256 bits, with a linear mantissa.
fn log2Fixed(value: u32) -> i64 {
  let bits = highBit(value)
  let scaled = u64.shiftRight(u64.shiftLeft(u32.toU64(value), 8), u32.toU64(bits))
  return u32.toI64(bits) * 256 + u64.toI64(scaled) - 256
}

// The cost in 1/256 bits of a symbol with normalized count `count` in a table of `log` bits.
fn symbolCost(count: i64, log: u32) -> i64 {
  let mut probability = count
  if probability < 1 {
    probability = 1
  }
  return u32.toI64(log) * 256 - log2Fixed(i64.toU32(probability))
}

fn optimalLog(maxLog: u32, total: usize, maxSymbol: usize) -> u32 {
  let totalValue = usize.toU32(total)
  let mut maxBitsSource: i64 = 0
  if totalValue > 1 {
    maxBitsSource = u32.toI64(highBit(totalValue - 1)) - 2
  }
  let minBitsSource = highBit(totalValue) + 1
  let mut minBitsSymbols: u32 = 2
  if maxSymbol > 0 {
    minBitsSymbols = highBit(usize.toU32(maxSymbol)) + 2
  }
  let mut minBits = minBitsSource
  if minBitsSymbols < minBits {
    minBits = minBitsSymbols
  }
  let mut log = u32.toI64(maxLog)
  if maxBitsSource < log {
    log = maxBitsSource
  }
  if u32.toI64(minBits) > log {
    log = u32.toI64(minBits)
  }
  if log < 5 {
    log = 5
  }
  if log > u32.toI64(maxLog) {
    log = u32.toI64(maxLog)
  }
  return i64.toU32(log)
}

// Scales `counts` to sum to 2^log, keeping each present symbol at least 1.
fn normalize(
  counts: &[u32; 64],
  maxSymbol: usize,
  total: usize,
  log: u32,
  normalized: &mut [i64; 64],
) -> () {
  let size = usize.shiftLeft(1, u32.toUsize(log))
  let mut sum: usize = 0
  let mut largest: usize = 0
  let mut symbol: usize = 0
  while symbol <= maxSymbol {
    let count = u32.toUsize(counts[symbol])
    if count == 0 {
      normalized[symbol] = 0
    } else {
      let mut share = count * size / total
      if share == 0 {
        share = 1
      }
      normalized[symbol] = usize.toI64(share)
      sum = sum + share
      if count > u32.toUsize(counts[largest]) {
        largest = symbol
      }
    }
    symbol = symbol + 1
  }
  if sum < size {
    normalized[largest] = normalized[largest] + usize.toI64(size - sum)
  }
  while sum > size {
    let mut biggest: usize = 0
    symbol = 0
    while symbol <= maxSymbol {
      if normalized[symbol] > normalized[biggest] {
        biggest = symbol
      }
      symbol = symbol + 1
    }
    normalized[biggest] = normalized[biggest] - 1
    sum = sum - 1
  }
}

// Builds encoding tables from a normalized distribution, where -1 is a low-probability symbol, as
// the reference FSE_buildCTable does.
fn buildTable(table: &mut FseTable, normalized: &[i64; 64], maxSymbol: usize, log: u32) -> () {
  let size = usize.shiftLeft(1, u32.toUsize(log))
  let mask = size - 1
  let step = size / 2 + size / 8 + 3
  let mut high = size - 1
  let mut cumulative: [usize; 65] = [0; 65]
  let mut spread: [u8; 512] = [0; 512]
  let mut symbol: usize = 0
  while symbol <= maxSymbol {
    if normalized[symbol] == -1 {
      cumulative[symbol + 1] = cumulative[symbol] + 1
      spread[high] = usize.toU8(symbol)
      high = high - 1
    } else {
      cumulative[symbol + 1] = cumulative[symbol] + i64.toUsize(normalized[symbol])
    }
    symbol = symbol + 1
  }
  let mut position: usize = 0
  symbol = 0
  while symbol <= maxSymbol {
    let mut occurrence: i64 = 0
    while occurrence < normalized[symbol] {
      spread[position] = usize.toU8(symbol)
      position = (position + step) & mask
      while position > high {
        position = (position + step) & mask
      }
      occurrence = occurrence + 1
    }
    symbol = symbol + 1
  }
  let mut index: usize = 0
  while index < size {
    let owner = u8.toUsize(spread[index])
    table.state[cumulative[owner]] = usize.toU32(size + index)
    cumulative[owner] = cumulative[owner] + 1
    index = index + 1
  }
  let sizeValue = usize.toU32(size)
  let mut total: i64 = 0
  symbol = 0
  while symbol <= maxSymbol {
    let count = normalized[symbol]
    if count == 0 {
      table.deltaBits[symbol] = u32.shiftLeft(log + 1, 16) - sizeValue
    } else if count == -1 || count == 1 {
      table.deltaBits[symbol] = u32.shiftLeft(log, 16) - sizeValue
      table.deltaFind[symbol] = total - 1
      total = total + 1
    } else {
      let countValue = i64.toU32(count)
      let maxBitsOut = log - highBit(countValue - 1)
      let minStatePlus = u32.shiftLeft(countValue, maxBitsOut)
      table.deltaBits[symbol] = u32.shiftLeft(maxBitsOut, 16) - minStatePlus
      table.deltaFind[symbol] = total - count
      total = total + count
    }
    symbol = symbol + 1
  }
  table.log = log
  table.rle = false
}

fn initialState(table: &FseTable, symbol: usize) -> u32 {
  let bits = u32.shiftRight(table.deltaBits[symbol] + 32768, 16)
  let value = u32.shiftLeft(bits, 16) - table.deltaBits[symbol]
  let slot = u32.toI64(u32.shiftRight(value, bits)) + table.deltaFind[symbol]
  return table.state[i64.toUsize(slot)]
}

// Writes the bits of one symbol for an FSE state and returns the next state.
fn encodeSymbol(state: &mut ZstdEncoder, kind: u32, value: u32, symbol: usize) -> u32 {
  let mut deltaBits: u32 = 0
  let mut deltaFind: i64 = 0
  if kind == 0 {
    deltaBits = state.literalTable.deltaBits[symbol]
    deltaFind = state.literalTable.deltaFind[symbol]
  } else if kind == 1 {
    deltaBits = state.offsetTable.deltaBits[symbol]
    deltaFind = state.offsetTable.deltaFind[symbol]
  } else {
    deltaBits = state.matchTable.deltaBits[symbol]
    deltaFind = state.matchTable.deltaFind[symbol]
  }
  let bits = u32.shiftRight(value + deltaBits, 16)
  addBits(&mut state, value, bits)
  let slot = i64.toUsize(u32.toI64(u32.shiftRight(value, bits)) + deltaFind)
  if kind == 0 {
    return state.literalTable.state[slot]
  }
  if kind == 1 {
    return state.offsetTable.state[slot]
  }
  return state.matchTable.state[slot]
}

// Writes a normalized distribution as an FSE table description, as FSE_writeNCount does.
fn writeDistribution(
  state: &mut ZstdEncoder,
  normalized: &[i64; 64],
  maxSymbol: usize,
  log: u32,
) -> () {
  let size = i64.shiftLeft(1, u32.toI64(log))
  let mut bits: u64 = u32.toU64(log - 5)
  let mut count: u32 = 4
  let mut remaining = size + 1
  let mut threshold = size
  let mut width = log + 1
  let mut symbol: usize = 0
  let mut previousZero = false
  while symbol <= maxSymbol && remaining > 1 {
    if previousZero {
      let mut start = symbol
      while symbol <= maxSymbol && normalized[symbol] == 0 {
        symbol = symbol + 1
      }
      if symbol > maxSymbol {
        break
      }
      while symbol >= start + 24 {
        start = start + 24
        bits = bits + u64.shiftLeft(0xffff, u32.toU64(count))
        stageByte(&mut state, u64.toU8(bits & 255))
        stageByte(&mut state, u64.toU8(u64.shiftRight(bits, 8) & 255))
        bits = u64.shiftRight(bits, 16)
      }
      while symbol >= start + 3 {
        start = start + 3
        bits = bits + u64.shiftLeft(3, u32.toU64(count))
        count = count + 2
      }
      bits = bits + u64.shiftLeft(usize.toU64(symbol - start), u32.toU64(count))
      count = count + 2
      if count > 16 {
        stageByte(&mut state, u64.toU8(bits & 255))
        stageByte(&mut state, u64.toU8(u64.shiftRight(bits, 8) & 255))
        bits = u64.shiftRight(bits, 16)
        count = count - 16
      }
    }
    let mut value = normalized[symbol]
    symbol = symbol + 1
    let most = 2 * threshold - 1 - remaining
    if value < 0 {
      remaining = remaining + value
    } else {
      remaining = remaining - value
    }
    value = value + 1
    if value >= threshold {
      value = value + most
    }
    bits = bits + u64.shiftLeft(i64.toU64(value), u32.toU64(count))
    count = count + width
    if value < most {
      count = count - 1
    }
    previousZero = value == 1
    while remaining < threshold {
      width = width - 1
      threshold = i64.shiftRight(threshold, 1)
    }
    if count > 16 {
      stageByte(&mut state, u64.toU8(bits & 255))
      stageByte(&mut state, u64.toU8(u64.shiftRight(bits, 8) & 255))
      bits = u64.shiftRight(bits, 16)
      count = count - 16
    }
  }
  let mut emitted: u32 = 0
  while emitted < (count + 7) / 8 {
    stageByte(&mut state, u64.toU8(bits & 255))
    bits = u64.shiftRight(bits, 8)
    emitted = emitted + 1
  }
}

// Computes Huffman code lengths of at most 11 bits for the literal counts into `huffmanBits`,
// with a complete code, and returns the longest length.
fn buildHuffman(state: &mut ZstdEncoder, counts: &[u32; 256], maxSymbol: usize) -> u32 {
  let mut order: [u32; 256] = [0; 256]
  let mut present: usize = 0
  let mut symbol: usize = 0
  while symbol <= maxSymbol {
    state.huffmanBits[symbol] = 0
    if counts[symbol] != 0 {
      // Insertion sort by count, then by symbol.
      let mut slot = present
      while slot > 0 && counts[u32.toUsize(order[slot - 1])] > counts[symbol] {
        order[slot] = order[slot - 1]
        slot = slot - 1
      }
      order[slot] = usize.toU32(symbol)
      present = present + 1
    }
    symbol = symbol + 1
  }
  let mut weight: [u64; 512] = [0; 512]
  let mut parent: [u32; 512] = [0; 512]
  let mut depth: [u32; 512] = [0; 512]
  let mut index: usize = 0
  while index < present {
    weight[index] = u32.toU64(counts[u32.toUsize(order[index])])
    index = index + 1
  }
  let mut leaf: usize = 0
  let mut inner = present
  let mut next = present
  while next < 2 * present - 1 {
    let mut pair: [usize; 2] = [0, 0]
    let mut pick: usize = 0
    while pick < 2 {
      if leaf < present && (inner >= next || weight[leaf] <= weight[inner]) {
        pair[pick] = leaf
        leaf = leaf + 1
      } else {
        pair[pick] = inner
        inner = inner + 1
      }
      pick = pick + 1
    }
    weight[next] = weight[pair[0]] + weight[pair[1]]
    parent[pair[0]] = usize.toU32(next)
    parent[pair[1]] = usize.toU32(next)
    next = next + 1
  }
  let root = 2 * present - 2
  depth[root] = 0
  index = root
  while index > 0 {
    index = index - 1
    depth[index] = depth[u32.toUsize(parent[index])] + 1
  }
  let limit: u32 = 11
  let mut longest: u32 = 0
  index = 0
  while index < present {
    if depth[index] > longest {
      longest = depth[index]
    }
    index = index + 1
  }
  if longest > limit {
    // Clamp, then repay the Kraft excess by lengthening the rarest short codes, then fill any
    // deficit by shortening the longest codes, so that the code stays complete.
    let mut excess: i64 = 0 - i64.shiftLeft(1, u32.toI64(limit))
    index = 0
    while index < present {
      if depth[index] > limit {
        depth[index] = limit
      }
      excess = excess + i64.shiftLeft(1, u32.toI64(limit - depth[index]))
      index = index + 1
    }
    while excess > 0 {
      let mut target = limit - 1
      let mut done = false
      while target >= 1 && !done {
        index = 0
        while index < present {
          if depth[index] == target {
            depth[index] = target + 1
            excess = excess - i64.shiftLeft(1, u32.toI64(limit - target - 1))
            done = true
            break
          }
          index = index + 1
        }
        target = target - 1
      }
    }
    while excess < 0 {
      let mut chosen = present
      index = present
      while index > 0 {
        index = index - 1
        let gainValue = i64.shiftLeft(1, u32.toI64(limit - depth[index]))
        if depth[index] > 1 && gainValue <= 0 - excess
          && (chosen == present || depth[index] > depth[chosen]) {
          chosen = index
        }
      }
      excess = excess + i64.shiftLeft(1, u32.toI64(limit - depth[chosen]))
      depth[chosen] = depth[chosen] - 1
    }
    longest = 0
    index = 0
    while index < present {
      if depth[index] > longest {
        longest = depth[index]
      }
      index = index + 1
    }
  }
  index = 0
  while index < present {
    state.huffmanBits[u32.toUsize(order[index])] = depth[index]
    index = index + 1
  }

  // Canonical codes: lower weights (longer codes) first, by symbol within a weight.
  let mut perWeight: [u32; 13] = [0; 13]
  symbol = 0
  while symbol <= maxSymbol {
    let bits = state.huffmanBits[symbol]
    if bits != 0 {
      let weightValue = u32.toUsize(longest + 1 - bits)
      perWeight[weightValue] = perWeight[weightValue] + 1
    }
    symbol = symbol + 1
  }
  let mut start: [u32; 13] = [0; 13]
  let mut current: u32 = 0
  let mut level: usize = 1
  while level <= u32.toUsize(longest) {
    start[level] = current
    current = u32.shiftRight(current + perWeight[level], 1)
    level = level + 1
  }
  symbol = 0
  while symbol <= maxSymbol {
    let bits = state.huffmanBits[symbol]
    if bits != 0 {
      let weightValue = u32.toUsize(longest + 1 - bits)
      state.huffmanCode[symbol] = start[weightValue]
      start[weightValue] = start[weightValue] + 1
    }
    symbol = symbol + 1
  }
  return longest
}

// Writes the Huffman weights of symbols below `maxSymbol` with FSE and two interleaved states.
// Returns false, with the stage unchanged, if that is not possible in 127 bytes.
fn writeWeightsFse(
  state: &mut ZstdEncoder,
  weights: &[u32; 256],
  count: usize,
  longest: u32,
) -> bool {
  let begin = state.stageLength
  let mut counts: [u32; 64] = [0; 64]
  let mut maxWeight: usize = 0
  let mut index: usize = 0
  while index < count {
    let weightValue = u32.toUsize(weights[index])
    counts[weightValue] = counts[weightValue] + 1
    if weightValue > maxWeight {
      maxWeight = weightValue
    }
    index = index + 1
  }
  let mut distinct: usize = 0
  index = 0
  while index <= maxWeight {
    if counts[index] != 0 {
      distinct = distinct + 1
    }
    index = index + 1
  }
  if count <= 2 || distinct < 2 {
    return false
  }
  let log = optimalLog(6, count, maxWeight)
  let mut normalized: [i64; 64] = [0; 64]
  normalize(&counts, maxWeight, count, log, &mut normalized)
  buildTable(&mut state.literalTable, &normalized, maxWeight, log)
  stageByte(&mut state, 0)
  writeDistribution(&mut state, &normalized, maxWeight, log)
  state.bitBuffer = 0
  state.bitCount = 0
  let mut position = count
  let mut first: u32 = 0
  let mut second: u32 = 0
  if usize.remainder(count, 2) == 1 {
    first = initialState(&state.literalTable, u32.toUsize(weights[position - 1]))
    second = initialState(&state.literalTable, u32.toUsize(weights[position - 2]))
    first = encodeSymbol(&mut state, 0, first, u32.toUsize(weights[position - 3]))
    position = position - 3
  } else {
    second = initialState(&state.literalTable, u32.toUsize(weights[position - 1]))
    first = initialState(&state.literalTable, u32.toUsize(weights[position - 2]))
    position = position - 2
  }
  while position >= 2 {
    second = encodeSymbol(&mut state, 0, second, u32.toUsize(weights[position - 1]))
    first = encodeSymbol(&mut state, 0, first, u32.toUsize(weights[position - 2]))
    position = position - 2
  }
  addBits(&mut state, second, log)
  addBits(&mut state, first, log)
  closeBits(&mut state)
  let size = state.stageLength - begin - 1
  if state.stageFull || size >= 128 {
    state.stageLength = begin
    state.stageFull = false
    return false
  }
  List<u8>.set(&mut state.stage, begin, usize.toU8(size))
  return true
}

fn writeHuffmanStream(state: &mut ZstdEncoder, from: usize, to: usize) -> () {
  state.bitBuffer = 0
  state.bitCount = 0
  let mut index = to
  while index > from {
    index = index - 1
    let symbol = u8.toUsize(List<u8>.get(&state.literals, index))
    let code = state.huffmanCode[symbol]
    let bits = state.huffmanBits[symbol]
    addBits(&mut state, code, bits)
  }
  closeBits(&mut state)
}

fn literalHeader(state: &mut ZstdEncoder, kind: u32, size: usize) -> () {
  let value = usize.toU32(size)
  if size < 32 {
    stageByte(&mut state, u32.toU8(kind | u32.shiftLeft(value, 3)))
  } else if size < 4096 {
    stageLittle(&mut state, kind | 4 | u32.shiftLeft(value, 4), 2)
  } else {
    stageLittle(&mut state, kind | 12 | u32.shiftLeft(value, 4), 3)
  }
}

fn rawLiterals(state: &mut ZstdEncoder) -> () {
  let count = state.literalCount
  literalHeader(&mut state, 0, count)
  let mut index: usize = 0
  while index < count {
    let byte = List<u8>.get(&state.literals, index)
    stageByte(&mut state, byte)
    index = index + 1
  }
}

// Writes the literals section: raw, RLE, or Huffman-coded with one or four streams, whichever
// is smallest.
fn encodeLiterals(state: &mut ZstdEncoder) -> () {
  let count = state.literalCount
  let mut counts: [u32; 256] = [0; 256]
  let mut maxSymbol: usize = 0
  let mut index: usize = 0
  while index < count {
    let symbol = u8.toUsize(List<u8>.get(&state.literals, index))
    counts[symbol] = counts[symbol] + 1
    if symbol > maxSymbol {
      maxSymbol = symbol
    }
    index = index + 1
  }
  let mut distinct: usize = 0
  index = 0
  while index <= maxSymbol {
    if counts[index] != 0 {
      distinct = distinct + 1
    }
    index = index + 1
  }
  if count == 0 || count < 64 && distinct > 1 {
    rawLiterals(&mut state)
    return ()
  }
  if distinct == 1 {
    literalHeader(&mut state, 1, count)
    let byte = List<u8>.get(&state.literals, 0)
    stageByte(&mut state, byte)
    return ()
  }
  let longest = buildHuffman(&mut state, &counts, maxSymbol)
  let mut weights: [u32; 256] = [0; 256]
  index = 0
  while index < maxSymbol {
    if state.huffmanBits[index] != 0 {
      weights[index] = longest + 1 - state.huffmanBits[index]
    }
    index = index + 1
  }
  let begin = state.stageLength
  let fourStreams = count > 1023
  let mut headerSize: usize = 3
  if count > 16383 {
    headerSize = 5
  } else if count > 1023 {
    headerSize = 4
  }
  index = 0
  while index < headerSize {
    stageByte(&mut state, 0)
    index = index + 1
  }
  let treeStart = state.stageLength
  if !writeWeightsFse(&mut state, &weights, maxSymbol, longest) {
    if maxSymbol > 128 {
      state.stageLength = begin
      rawLiterals(&mut state)
      return ()
    }
    stageByte(&mut state, usize.toU8(127 + maxSymbol))
    index = 0
    while index < maxSymbol {
      let high = u32.shiftLeft(weights[index], 4)
      let mut low: u32 = 0
      if index + 1 < maxSymbol {
        low = weights[index + 1]
      }
      stageByte(&mut state, u32.toU8(high | low))
      index = index + 2
    }
  } else {
    let fseSize = state.stageLength - treeStart
    if maxSymbol <= 128 && 1 + (maxSymbol + 1) / 2 < fseSize {
      state.stageLength = treeStart
      stageByte(&mut state, usize.toU8(127 + maxSymbol))
      index = 0
      while index < maxSymbol {
        let high = u32.shiftLeft(weights[index], 4)
        let mut low: u32 = 0
        if index + 1 < maxSymbol {
          low = weights[index + 1]
        }
        stageByte(&mut state, u32.toU8(high | low))
        index = index + 2
      }
    }
  }
  if fourStreams {
    let segment = (count + 3) / 4
    let jump = state.stageLength
    stageLittle(&mut state, 0, 4)
    stageLittle(&mut state, 0, 2)
    let mut sizes: [usize; 3] = [0, 0, 0]
    let mut stream: usize = 0
    while stream < 4 {
      let from = stream * segment
      let mut to = from + segment
      if stream == 3 || to > count {
        to = count
      }
      let streamStart = state.stageLength
      writeHuffmanStream(&mut state, from, to)
      if stream < 3 {
        sizes[stream] = state.stageLength - streamStart
      }
      stream = stream + 1
    }
    if sizes[0] > 65535 || sizes[1] > 65535 || sizes[2] > 65535 {
      state.stageLength = begin
      state.stageFull = false
      rawLiterals(&mut state)
      return ()
    }
    stagePatch(
      &mut state,
      jump,
      usize.toU32(sizes[0]) | u32.shiftLeft(usize.toU32(sizes[1]), 16),
      4,
    )
    stagePatch(&mut state, jump + 4, usize.toU32(sizes[2]), 2)
  } else {
    writeHuffmanStream(&mut state, 0, count)
  }
  let compressed = state.stageLength - treeStart
  if state.stageFull || compressed + headerSize >= count + 3 || (!fourStreams && compressed > 1023)
    || compressed > 262143 {
    state.stageLength = begin
    state.stageFull = false
    rawLiterals(&mut state)
    return ()
  }
  let regenerated = usize.toU32(count)
  let size = usize.toU32(compressed)
  if headerSize == 3 {
    let mut format: u32 = 0
    if fourStreams {
      format = 4
    }
    stagePatch(
      &mut state,
      begin,
      2 | format | u32.shiftLeft(regenerated, 4) | u32.shiftLeft(size, 14),
      3,
    )
  } else if headerSize == 4 {
    stagePatch(
      &mut state,
      begin,
      2 | 8 | u32.shiftLeft(regenerated, 4) | u32.shiftLeft(size, 18),
      4,
    )
  } else {
    let low = u64.toU32(
      u32.toU64(2 | 12) | u64.shiftLeft(u32.toU64(regenerated), 4)
        | u64.shiftLeft(u32.toU64(size), 22) & 0xffffffff,
    )
    stagePatch(&mut state, begin, low, 4)
    stagePatch(&mut state, begin + 4, u32.shiftRight(size, 10), 1)
  }
}

