//! CRC checksums used by gzip and XZ containers.
//!
//! @category Data formats

import silk.num.u8
import silk.num.u32
import silk.num.u64

/// Allocation-free container checksums.
pub struct CompressionChecksum {}

impl CompressionChecksum {
  /// Returns the reflected IEEE CRC-32 of the supplied bytes.
  pub fn crc32(bytes: &[u8]) -> u32 {
    let mut value: u32 = 4294967295
    let mut index: usize = 0
    while index < bytes.length {
      value = CompressionChecksum.crc32Byte(value, bytes[index])
      index = index + 1
    }
    return u32.bitXor(value, 4294967295)
  }

  /// Updates a running reflected CRC-32; initialize and finalize by XOR with 4294967295.
  pub fn crc32Byte(state: u32, byte: u8) -> u32 {
    let mut value = u32.bitXor(state, u8.toU32(byte))
    let mut bit: u32 = 0
    while bit < 8 {
      let low = u32.bitAnd(value, 1)
      value = u32.shiftRight(value, 1)
      if low != 0 {
        value = u32.bitXor(value, 3988292384)
      }
      bit = bit + 1
    }
    return value
  }

  /// Returns the CRC-64/XZ checksum of the supplied bytes.
  pub fn crc64(bytes: &[u8]) -> u64 {
    let mut value = u64.MAX
    let mut index: usize = 0
    while index < bytes.length {
      value = u64.bitXor(value, u8.toU64(bytes[index]))
      let mut bit: u32 = 0
      while bit < 8 {
        let low = u64.bitAnd(value, 1)
        value = u64.shiftRight(value, 1)
        if low != 0 {
          value = u64.bitXor(value, 14514072000185962306)
        }
        bit = bit + 1
      }
      index = index + 1
    }
    return u64.bitXor(value, u64.MAX)
  }
}
