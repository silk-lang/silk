//! Decompress Brotli data (RFC 7932) in steps, with fixed memory and limits that you set.
//!
//! # When to use
//! Use [`Brotli`] to read `.br` files or HTTP bodies with `Content-Encoding: br`. Make a decoder
//! with [`Brotli.make`], and call [`Brotli.step`] until it returns `Finished`. Call
//! [`Brotli.reset`] to decode another stream with the same storage. This module does not
//! compress.
//!
//! # Details
//! The decoder supports all of RFC 7932: compressed, uncompressed, and metadata meta-blocks, all
//! context modes, and the static dictionary with its 121 word transforms. [`Brotli.make`] allocates
//! all storage one time: the history window and the space for prefix code tables. [`Brotli.step`]
//! does not allocate and keeps no borrow of your buffers, so you can move the decoder between
//! threads between calls.
//!
//! A Brotli stream ends itself. The decoder returns `Finished` when the last meta-block is decoded
//! and all output is written, and it leaves the bytes after the stream unconsumed.
//!
//! # Errors
//! - `OutOfMemoryError` from [`Brotli.make`] if the `Allocator` fails.
//! - [`BrotliError`] if the configuration is not valid, the data is not valid, a limit is
//!   exceeded, or a call after the final input does not give exactly the input that is not consumed
//!   yet. `reason` gives the cause and `offset` the input position.
//!
//! # Gotchas
//! The window holds `windowBytes` rounded down to a power of two. A stream can declare a larger
//! window than that and still decode, as long as no back-reference reaches further than the window
//! holds. A failure is permanent until [`Brotli.reset`].
//!
//! # Examples
//! ## Decode a short stream
//! ```silk
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.core.effect { Effect }
//! import silk.core.result { Result }
//! import silk.compress.brotli { Brotli, BrotliError, BrotliLimits, BrotliProgress, BrotliStatus }
//!
//! pub effect fn main() -> i32
//!   ! BrotliError | OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let mut decoder = run Brotli.make(BrotliLimits.make())
//!     |> Effect.provideMut<Allocator>(&mut allocator)
//!
//!   // The reference encoder's output for "hi": one uncompressed meta-block and an empty last one.
//!   let input = b"\x8b\x00\x80hi\x03"
//!   let mut output: [u8; 16] = [0; 16]
//!   return match Brotli.step(&mut decoder, &input, &mut output, true) {
//!     Result<BrotliProgress, BrotliError>.Success { value } => {
//!       if value.status != BrotliStatus.Finished || value.written != 2 || output[0] != 104
//!         || output[1] != 105 {
//!         return 1
//!       }
//!       return 0
//!     }
//!     Result<BrotliProgress, BrotliError>.Failure {..} => 1
//!   }
//! }
//! ```
//!
//! @category Data formats

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.format { Debug, Format, Formatter }
import silk.mem.layout { Layout }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.result { Result }
import silk.compress.brotli_tables
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.i64
import silk.num.usize
import silk.io.writer { Writer, WriterError }

/// The resource limits for one stream. [`BrotliLimits.make`] gives defaults.
pub struct BrotliLimits {
  /// The maximum number of input bytes to consume.
  pub inputBytes: u64,
  /// The maximum number of decoded bytes.
  pub outputBytes: u64,
  /// The size of the history window that [`Brotli.make`] allocates, rounded down to a power of two
  /// and capped at 16 MiB, the largest window of the format. It must not be 0. A back-reference
  /// further than the window fails with `WindowLimit`.
  pub windowBytes: usize,
  /// The storage budget other than the window: decoder state, context maps, and the space for the
  /// prefix code tables of one meta-block. If it is too small for the fixed part, [`Brotli.make`]
  /// fails with `WorkspaceLimit`, and if a meta-block needs more table space than it leaves, the
  /// step fails with `WorkspaceLimit`.
  pub workspaceBytes: usize,
}

impl BrotliLimits {
  /// Returns default limits: 64 MiB of input, 256 MiB of output, a 16 MiB window, and a 3 MiB
  /// workspace. These decode any valid stream within the input and output limits.
  pub fn make() -> Self {
    return BrotliLimits {
      inputBytes: 67108864,
      outputBytes: 268435456,
      windowBytes: 16777216,
      workspaceBytes: 3145728,
    }
  }
}

/// What the decoder needs after a successful step.
pub enum BrotliStatus {
  /// All given input is consumed. Call again with more input, or with `finalInput` set if there is
  /// no more.
  NeedInput,
  /// The output buffer is full. Call again with an output buffer that is not empty, and the input
  /// that was not consumed.
  NeedOutput,
  /// The stream is complete and all of its output is written. The bytes after it are not consumed.
  Finished,
}

/// The result of one successful step.
pub struct BrotliProgress {
  /// The number of input bytes that this call consumed. Give only the rest of the input on the next
  /// call.
  pub consumed: usize,
  /// The number of output bytes that this call wrote. Only this prefix of the output changed.
  pub written: usize,
  /// What the decoder needs next.
  pub status: BrotliStatus,
}

/// The cause of a [`BrotliError`].
pub enum BrotliReason {
  /// No failure. The decoder uses it internally. A returned error never has it.
  None,
  /// The window size is 0, or the storage sizes do not fit in `usize`.
  InvalidConfiguration,
  /// A call changes the final input after it was set, or uses a decoder that lost its storage.
  InvalidState,
  /// The stream header asks for a window size that RFC 7932 does not define.
  WindowBits,
  /// A meta-block header is not valid: a reserved bit is set, a length has an extra zero nibble or
  /// byte, or padding bits are not zero.
  Header,
  /// A prefix code is not valid: a symbol is out of range or repeated, a code is incomplete or
  /// oversubscribed, or a repeat runs past the alphabet.
  PrefixCode,
  /// A context map has a run of zeros past its end.
  ContextMap,
  /// The commands of a meta-block produce more bytes than its length.
  BlockLength,
  /// A distance is 0 or less, or too large.
  Distance,
  /// A static dictionary reference has a length with no words, or a transform that does not exist.
  Dictionary,
  /// The final input ends before the stream is complete.
  Truncated,
  /// The consumed input would go over [`BrotliLimits.inputBytes`].
  InputLimit,
  /// The decoded output would go over [`BrotliLimits.outputBytes`].
  OutputLimit,
  /// A back-reference reaches further than the window that [`Brotli.make`] allocated.
  WindowLimit,
  /// [`BrotliLimits.workspaceBytes`] is too small for the decoder state or for the prefix code
  /// tables of a meta-block.
  WorkspaceLimit,
}

impl Debug for BrotliReason {
  /// Writes the name of the variant, such as `None`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return match &self.* {
      BrotliReason.None => run Format.write(&mut formatter, b"None")
      BrotliReason.InvalidConfiguration => run Format.write(&mut formatter, b"InvalidConfiguration")
      BrotliReason.InvalidState => run Format.write(&mut formatter, b"InvalidState")
      BrotliReason.WindowBits => run Format.write(&mut formatter, b"WindowBits")
      BrotliReason.Header => run Format.write(&mut formatter, b"Header")
      BrotliReason.PrefixCode => run Format.write(&mut formatter, b"PrefixCode")
      BrotliReason.ContextMap => run Format.write(&mut formatter, b"ContextMap")
      BrotliReason.BlockLength => run Format.write(&mut formatter, b"BlockLength")
      BrotliReason.Distance => run Format.write(&mut formatter, b"Distance")
      BrotliReason.Dictionary => run Format.write(&mut formatter, b"Dictionary")
      BrotliReason.Truncated => run Format.write(&mut formatter, b"Truncated")
      BrotliReason.InputLimit => run Format.write(&mut formatter, b"InputLimit")
      BrotliReason.OutputLimit => run Format.write(&mut formatter, b"OutputLimit")
      BrotliReason.WindowLimit => run Format.write(&mut formatter, b"WindowLimit")
      BrotliReason.WorkspaceLimit => run Format.write(&mut formatter, b"WorkspaceLimit")
    }
  }
}

/// A decoding failure. It is permanent until [`Brotli.reset`].
///
/// Each later call returns the same `reason` and `offset` with no progress. The output that earlier
/// calls wrote is not valid.
pub struct BrotliError {
  /// The cause of the failure.
  pub reason: BrotliReason,
  /// The input position where the decoder found the problem, counted from the start of the stream.
  pub offset: u64,
  /// The number of input bytes that this call consumed before it failed.
  pub consumed: usize,
  /// The number of output bytes that this call wrote before it failed.
  pub written: usize,
}

impl Debug for BrotliError {
  /// Writes the fields, as `BrotliError { reason: ..., offset: ..., ... }`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return run Format.debugFields(self, "BrotliError", &mut formatter)
  }
}

/// A Brotli decoder for one stream at a time. It owns all its storage.
///
/// # When to use
/// Use it to read `.br` files or HTTP bodies with `Content-Encoding: br`. Make a decoder with
/// [`Brotli.make`], call [`Brotli.step`] until it returns `Finished`, and call [`Brotli.reset`] to
/// decode another stream.
///
/// # Details
/// [`Brotli.make`] allocates the window and the table space one time. [`Brotli.step`] does not
/// allocate and keeps no borrow of your buffers, so you can move the decoder between threads
/// between calls.
///
/// # Gotchas
/// A failure is permanent until [`Brotli.reset`]. Output that the stream wrote before a failure is
/// not valid.
pub struct Brotli {
  limits: BrotliLimits,
  ring: List<u8>,
  ringSize: usize,
  ringMask: usize,
  pool: List<u32>,
  poolUsed: usize,
  literalOffsets: List<u32>,
  commandOffsets: List<u32>,
  distanceOffsets: List<u32>,
  typeTrees: List<u32>,
  countTrees: List<u32>,
  mapTree: List<u32>,
  lengthTree: List<u32>,
  maps: List<u8>,
  modes: List<u8>,
  lengths: List<u8>,
  sorted: List<u32>,
  treeCounts: [u32; 16],
  treeUsed: usize,
  codeLengthLengths: [u8; 18],
  word: [u8; 64],
  wordLength: usize,
  wordIndex: usize,
  acc: u64,
  count: u32,
  position: usize,
  written: usize,
  phase: u32,
  maxBackward: u64,
  last: bool,
  remaining: u32,
  types: [u32; 3],
  blockType: [u32; 3],
  previousType: [u32; 3],
  blockLength: [u32; 3],
  category: u32,
  postfix: u32,
  direct: u32,
  distanceAlphabet: u32,
  literalTreeCount: u32,
  distanceTreeCount: u32,
  group: u32,
  groupTree: u32,
  contextMode: usize,
  literalMapBase: usize,
  distanceMapBase: usize,
  commandBase: usize,
  insertCode: u32,
  copyCode: u32,
  implicitDistance: bool,
  insertRemaining: u32,
  copyLength: u32,
  copyRemaining: u32,
  copyDistance: u64,
  distances: [u32; 4],
  last1: u8,
  last2: u8,
  produced: u64,
  flushed: u64,
  treePhase: u32,
  treeAlphabet: u32,
  treeDestination: u32,
  treeBase: usize,
  treeIndex: usize,
  treeSpace: i64,
  treeCodes: u32,
  treePrevious: u32,
  treeRepeat: u32,
  treeRepeatLength: u32,
  mapPhase: u32,
  mapBase: usize,
  mapSize: usize,
  mapTrees: u32,
  mapRle: u32,
  mapIndex: usize,
  totalInput: u64,
  finalKnown: bool,
  finalOffset: u64,
  reason: BrotliReason,
  errorOffset: u64,
}

// Step outcomes.
const GO: u32 = 0

const NEED_INPUT: u32 = 1

const NEED_OUTPUT: u32 = 2

const FAILED: u32 = 3

const DONE: u32 = 4

// `decodeSymbol` returns it when the bits on hand do not hold the whole code.
const NEED: u32 = 4294967295

const PHASE_WINDOW: u32 = 0

const PHASE_HEADER: u32 = 1

const PHASE_METADATA: u32 = 2

const PHASE_UNCOMPRESSED: u32 = 3

const PHASE_TYPES: u32 = 4

const PHASE_TYPE_TREE: u32 = 5

const PHASE_COUNT_TREE: u32 = 6

const PHASE_FIRST_COUNT: u32 = 7

const PHASE_DISTANCE_PARAMETERS: u32 = 8

const PHASE_MODES: u32 = 9

const PHASE_LITERAL_TREE_COUNT: u32 = 10

const PHASE_LITERAL_MAP: u32 = 11

const PHASE_DISTANCE_TREE_COUNT: u32 = 12

const PHASE_DISTANCE_MAP: u32 = 13

const PHASE_GROUPS: u32 = 14

const PHASE_COMMAND: u32 = 15

const PHASE_COMMAND_EXTRA: u32 = 16

const PHASE_LITERALS: u32 = 17

const PHASE_DISTANCE: u32 = 18

const PHASE_COPY: u32 = 19

const PHASE_WORD: u32 = 20

const PHASE_BLOCK_DONE: u32 = 21

const PHASE_FLUSH_END: u32 = 22

const PHASE_FINISHED: u32 = 23

const TREE_START: u32 = 0

const TREE_LENGTHS: u32 = 1

const TREE_SYMBOLS: u32 = 2

const MAP_START: u32 = 0

const MAP_TREE: u32 = 1

const MAP_VALUES: u32 = 2

const MAP_TRANSFORM: u32 = 3

// Where `finishTree` puts a table: 0 to 2 for block type codes, 3 to 5 for block count codes.
const DEST_MAP: u32 = 6

const DEST_POOL: u32 = 7

const TYPE_TREE_SIZE: usize = 662

const COUNT_TREE_SIZE: usize = 402

const MAP_TREE_SIZE: usize = 662

const DISTANCE_MAP_BASE: usize = 16384

const MAPS_SIZE: usize = 17408

const MAX_ALPHABET: usize = 704

// The table space of the worst meta-block: 256 trees each of literals (630 entries), commands
// (1080), and distances (920), with the reference's bound for 8-bit root tables.
const WORST_POOL: usize = 673280

const MAX_WINDOW: usize = 16777216

const MAX_ALLOWED_DISTANCE: u64 = 2147483644

// Table sizes for 8-bit root tables, by `(alphabet + 31) / 32` (huffman.h).
