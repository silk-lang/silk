// The first insert and copy length codes of each 64-symbol cell of the command alphabet.
const CELL_INSERT: [u32; 11] = [0, 0, 0, 0, 8, 8, 0, 16, 8, 16, 16]

const CELL_COPY: [u32; 11] = [0, 8, 0, 8, 0, 8, 16, 0, 16, 8, 16]

