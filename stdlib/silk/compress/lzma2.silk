//! Decode complete raw LZMA2 streams into caller-owned byte buffers.
//!
//! # When to use
//! Use [`Lzma2.decode`] when a surrounding protocol supplies the dictionary size. For `.xz` files,
//! use `silk.compress.xz.Xz`, which reads the dictionary size and verifies the container.
//!
//! # Details
//! Supports stored and range-coded chunks, dictionary resets, property changes, and state reuse.
//! Input must contain exactly one stream including its zero end byte. Raw LZMA2 has no checksum.
//! The output buffer holds dictionary history. Probability tables use the ambient allocator.
//!
//! @category Data formats

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.compress.limits { DecodeLimits, DecodeReason, DecodeError, Decoded }
import silk.compress.lzma_decode { LzmaState }
import silk.compress.lzma2_decode { Lzma2Stream }

/// A complete-buffer raw LZMA2 decoder with caller-selected dictionary and resource limits.
pub struct Lzma2 {}

impl Lzma2 {
  /// Decodes one raw LZMA2 stream into the start of `output`, with the supplied dictionary size.
  ///
  /// # Details
  /// `dictionaryBytes` must be between 4096 and 4294967295. The output buffer holds history;
  /// only probability tables allocate. Stored and compressed chunks, all reset modes, and property
  /// changes are supported. The zero end byte is mandatory, and trailing bytes are rejected.
  /// Raw LZMA2 has no checksum. Returns the consumed and written lengths.
  ///
  /// # Errors
  /// `DecodeError` reports invalid properties, chunk sequences, ranges, distances, sizes, truncated
  /// or trailing input, and resource limits. Discard output on failure. `OutOfMemoryError` reports
  /// failure to allocate probability tables through the ambient allocator.
  pub effect fn decode(
    input: &[u8],
    output: &mut [u8],
    dictionaryBytes: u64,
    limits: DecodeLimits
  ) -> Decoded
    ! OutOfMemoryError | DecodeError
    ? &mut Allocator {
    let mut end = output.length
    if limits.maxOutputBytes < end {
      end = limits.maxOutputBytes
    }
    let mut state = LzmaState.make(input.length, end)
    if input.length > limits.maxInputBytes {
      fail DecodeError { reason: DecodeReason.InputLimit, consumed: 0, written: 0 }
    }
    if dictionaryBytes < 4096 || dictionaryBytes > 4294967295 {
      fail DecodeError { reason: DecodeReason.InvalidHeader, consumed: 0, written: 0 }
    }
    if dictionaryBytes > limits.maxDictionaryBytes {
      fail DecodeError { reason: DecodeReason.DictionaryLimit, consumed: 0, written: 0 }
    }
    state.dictionarySize = dictionaryBytes
    run Lzma2Stream.decode(&mut state, input, &mut output, limits.maxWorkspaceBytes)
    if state.failed {
      fail LzmaState.error(&state)
    }
    if state.ip != input.length {
      fail DecodeError { reason: DecodeReason.TrailingData, consumed: state.ip, written: state.op }
    }
    return Decoded { consumed: state.ip, written: state.op }
  }
}
