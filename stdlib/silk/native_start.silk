//! The default start code of a native program: it calls your `main` and returns its status.
//!
//! # When to use
//! The compiler uses this runtime for native programs on Darwin on aarch64, and Linux with GNU libc
//! on x86_64 or aarch64. You do not call it.
//!
//! # Details
//! `main` can return one of these:
//! - `i32`, the exit status.
//! - `()`, for status 0.
//! - An effect that returns `i32` or `()`, and that can require `&mut HostInput`. The runtime gives
//!   an `OsHostInput` with the arguments and the environment of the process.
//!
//! Other requirements, such as `&mut Allocator`, must be provided by your code. An unhandled error
//! prints a report to standard error and returns status 1. The report has at most 4096 bytes and 32
//! frames.
//!
//! # Gotchas
//! - There is no scheduler or event loop. If `main` parks, the program fails with status 1. Make
//!   your own execution for code that parks.
//! - A trap does not unwind, so cleanup code does not run.
//!
//! @category Native platform

static if (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText(
  "libc",
) == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText(
  "libc",
) == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
  import Intrinsic.application

  import silk.effect {Effect}

  import silk.native_diagnostics {NativeDiagnostics}

  import silk.native_report {NativeReport}

  import silk.usize

  import silk.host_input {HostInput, HostInputError}

  import silk.native_host_input {NativeHostInput}

  import silk.os_host_input {OsHostInput}
  struct Application<T> {}
  interface EntryResult<T> {
    fn code(value: T, inputs: &mut OsHostInput) -> i32
  }
  impl EntryResult<i32> for Application<i32> {
    fn code(value: i32, inputs: &mut OsHostInput) -> i32 {
      return value
    }
  }
  impl EntryResult<()> for Application<()> {
    fn code(value: (), inputs: &mut OsHostInput) -> i32 {
      return 0
    }
  }
  effect<'env> fn failed<E: 'env, 'env>(error: E) -> i32 {
    drop error
    return usize.toI32(Intrinsic.observeUnhandled())
  }
  effect fn succeeded(value: ()) -> i32 {
    return 0
  }
  effect fn succeededStatus(value: i32) -> i32 {
    return value
  }
  impl<'env, E> EntryResult<Effect<'env; () ! E>> for Application<Effect<'env; () ! E>> {
    fn code(value: Effect<'env; () ! E>, inputs: &mut OsHostInput) -> i32 {
      let computation = Effect.flatMap(move value, succeeded)
      return run Effect.catchAll(move computation, failed)
    }
  }
  impl<'env, E> EntryResult<Effect<'env; () ! E ? &mut HostInput>> for Application<
    Effect<'env; () ! E ? &mut HostInput>,
  > {
    fn code(value: Effect<'env; () ! E ? &mut HostInput>, inputs: &mut OsHostInput) -> i32 {
      let supplied = Effect.provideMut<HostInput>(move value, move inputs)
      let computation = Effect.flatMap(move supplied, succeeded)
      return run Effect.catchAll(move computation, failed)
    }
  }
  impl<'env, E> EntryResult<Effect<'env; i32 ! E>> for Application<Effect<'env; i32 ! E>> {
    fn code(value: Effect<'env; i32 ! E>, inputs: &mut OsHostInput) -> i32 {
      let computation = Effect.flatMap(move value, succeededStatus)
      return run Effect.catchAll(move computation, failed)
    }
  }
  impl<'env, E> EntryResult<Effect<'env; i32 ! E ? &mut HostInput>> for Application<
    Effect<'env; i32 ! E ? &mut HostInput>,
  > {
    fn code(value: Effect<'env; i32 ! E ? &mut HostInput>, inputs: &mut OsHostInput) -> i32 {
      let supplied = Effect.provideMut<HostInput>(move value, move inputs)
      let computation = Effect.flatMap(move supplied, succeededStatus)
      return run Effect.catchAll(move computation, failed)
    }
  }
  fn select<T>(value: &T) -> Application<T> {
    return Application<T> {}
  }
  fn adapt<T, P: EntryResult<T>>(value: T, provider: P, inputs: &mut OsHostInput) -> i32 {
    return EntryResult<T>.code(move value, move inputs)
  }

  import silk.allocator {Allocator, OutOfMemoryError}

  import silk.execution {Execution}
  struct EntrySuspended {}
  struct Status {
    complete: bool
    code: i32
  }
  fn ready(state: &()) -> () {}
  fn complete(state: &mut Status, code: i32) -> () {
    state.complete = true
    state.code = code
  }
  fn suspended(state: &mut Status, execution: Intrinsic.Execution<i32>) -> () {
    drop execution
    return ()
  }
  fn invokeApplication(inputs: OsHostInput) -> i32 {
    let mut host = move inputs
    let value = application.main()
    let provider = select(&value)
    return adapt(move value, move provider, &mut host)
  }
  fn invoke<F: fn<'static>(OsHostInput) -> i32 + Intrinsic.NonParking>(body: F, inputs: OsHostInput) -> i32 {
    return body(move inputs)
  }
  effect fn observedApplication(inputs: OsHostInput) -> i32 {
    let observer = run NativeDiagnostics.make(NativeReport.make(2, 4096, 32), 64)
    return run NativeDiagnostics.observe(
      move observer,
      effect {
        return invoke(invokeApplication, move inputs)
      },
    )
  }
  effect fn start(argc: i32, argv: [*]const ?[*]const u8) -> i32
  ! HostInputError | OutOfMemoryError | EntrySuspended {
    let mut allocator = Allocator.systemAllocatorProvider()
    let inputs = run unsafe NativeHostInput.captureProcess(argc, argv)
      |> Effect.provideMut<Allocator>(&mut allocator)
    let provider = OsHostInput.make(move inputs)
    let execution = run Execution.make(observedApplication(move provider), (), ready)
      |> Effect.provideMut<Allocator>(&mut allocator)
    let mut status = Status {complete: false, code: 0}
    run Execution.drive(move execution, &mut status, complete, suspended)
    if status.complete == false {
      fail EntrySuspended {}
    }
    return status.code
  }
  effect fn startup(argc: i32, argv: [*]const ?[*]const u8) -> i32 {
    return run Effect.catchAll(start(argc, argv), failed)
  }
  /// The C `main` function of the program. It captures the arguments, calls the application, and
  /// returns its status.
  ///
  /// If the start code fails, for example when it cannot copy the arguments, it returns 1.
  export "C" fn enter(argc: i32, argv: [*]const ?[*]const u8) -> i32 as "main" {
    let observer = run NativeDiagnostics.make(NativeReport.make(2, 4096, 32), 0)
    return run NativeDiagnostics.observe(move observer, startup(argc, argv))
  }
}
