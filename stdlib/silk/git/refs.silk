//! Git object ids, references, and the lists of references that a remote or a local repository
//! has.
//!
//! # When to use
//! Use the types here with `silk.git.remote`, which lists the references of a remote repository
//! like `git ls-remote`, and `silk.git.local`, which reads them from a `.git` directory. Look a
//! name up in a [`RefList`] with [`RefList.find`] for an exact name such as `refs/tags/v1.0.0`, or
//! with [`RefList.resolve`] for a short name such as `main` or `v1.0.0`, as Git does.
//!
//! # Details
//! An [`ObjectId`] is a SHA-1 (20 bytes) or SHA-256 (32 bytes) object name. A [`Ref`] has a full
//! name, the object it points at, the object that an annotated tag peels to, and the target of a
//! symbolic reference such as `HEAD`. [`Ref.commit`] gives the peeled object when there is one,
//! which for a tag is the commit that it tags.
//!
//! # Errors
//! - [`GitRefError`] for the failures of the Git modules, such as a malformed advertisement.
//! - `OutOfMemoryError` from functions that copy names.
//!
//! # Examples
//! ## Resolve a short name
//! ```silk
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.core.effect { Effect }
//! import silk.core.option { Option }
//! import silk.git.refs { ObjectId, Ref, RefList }
//!
//! effect fn build() -> bool ! OutOfMemoryError ? &mut Allocator {
//!   let id = match ObjectId.parseHex(b"95d09f2b10159347eece71399a7e2e907ea3df4f") {
//!     Option<ObjectId>.Some { value } => value
//!     Option<ObjectId>.None => { return false }
//!   }
//!   let mut refs = RefList.make()
//!   run refs.add(run Ref.make("refs/heads/main", Option<ObjectId>.some(id)))
//!   return match refs.resolve("main") {
//!     Option<&Ref>.Some { value } => value.isBranch()
//!     Option<&Ref>.None => false
//!   }
//! }
//!
//! pub effect fn main() -> i32 ! OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   if run build() |> Effect.provideMut<Allocator>(&mut allocator) {
//!     return 0
//!   }
//!   return 1
//! }
//! ```
//!
//! @category Version control

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.num.u8
import silk.text.format { Debug, Format, Formatter }
import silk.text.string { InvalidUtf8, String }
import silk.io.writer { Writer, WriterError }

/// The name of a Git object: a SHA-1 of 20 bytes or a SHA-256 of 32 bytes.
///
/// # Details
///
/// Make one with [`ObjectId.parseHex`] from 40 or 64 hexadecimal digits, or with
/// [`ObjectId.fromBytes`]. It is a plain value, so copies are cheap. Two ids are equal when
/// [`ObjectId.equals`] says so: the same length and the same bytes.
pub struct ObjectId {
  value: [u8; 32],
  length: usize,
}

impl Copy for ObjectId {}

impl ObjectId {
  /// Returns the id that `text` spells in hexadecimal, upper or lower case, or `None` if `text` is
  /// not 40 or 64 hexadecimal digits.
  pub fn parseHex(text: &[u8]) -> Option<ObjectId> {
    if text.length != 40 && text.length != 64 {
      return Option<ObjectId>.none()
    }
    let mut value: [u8; 32] = [0; 32]
    let mut index: usize = 0
    while index < text.length / 2 {
      let high = hexValue(text[index * 2])
      let low = hexValue(text[index * 2 + 1])
      if high > 15 || low > 15 {
        return Option<ObjectId>.none()
      }
      value[index] = high * 16 + low
      index = index + 1
    }
    return Option<ObjectId>.some(ObjectId { value: value, length: text.length / 2 })
  }

  /// Returns the id with the raw bytes `bytes`, or `None` if `bytes` is not 20 or 32 bytes long.
  pub fn fromBytes(bytes: &[u8]) -> Option<ObjectId> {
    if bytes.length != 20 && bytes.length != 32 {
      return Option<ObjectId>.none()
    }
    let mut value: [u8; 32] = [0; 32]
    let mut index: usize = 0
    while index < bytes.length {
      value[index] = bytes[index]
      index = index + 1
    }
    return Option<ObjectId>.some(ObjectId { value: value, length: bytes.length })
  }

  /// Returns the raw bytes of the id: 20 for SHA-1, 32 for SHA-256.
  pub fn bytes(self: &Self) -> &[u8] {
    return Slice.view<u8>(&self.value, 0, self.length)
  }

  /// Returns `true` for a SHA-256 id, `false` for a SHA-1 id.
  pub fn isSha256(self: &Self) -> bool {
    return self.length == 32
  }

  /// Returns `true` if every byte is zero. Git uses the zero id for a reference that does not
  /// exist yet.
  pub fn isZero(self: &Self) -> bool {
    let mut index: usize = 0
    while index < self.length {
      if self.value[index] != 0 {
        return false
      }
      index = index + 1
    }
    return true
  }

  /// Returns `true` if `self` and `other` have the same length and the same bytes.
  pub fn equals(self: &Self, other: &ObjectId) -> bool {
    if self.length != other.length {
      return false
    }
    let mut index: usize = 0
    while index < self.length {
      if self.value[index] != other.value[index] {
        return false
      }
      index = index + 1
    }
    return true
  }

  /// Returns the number of hexadecimal digits of the id: 40 for SHA-1, 64 for SHA-256.
  pub fn hexLength(self: &Self) -> usize {
    return self.length * 2
  }

  /// Writes the id as lower-case hexadecimal digits to the start of `output` and returns the
  /// number of digits written, [`ObjectId.hexLength`]. Returns 0 and writes nothing if `output` is
  /// shorter than that.
  pub fn writeHex(self: &Self, output: &mut [u8]) -> usize {
    let digits = b"0123456789abcdef"
    if output.length < self.length * 2 {
      return 0
    }
    let mut index: usize = 0
    while index < self.length {
      let byte = u8.toUsize(self.value[index])
      output[index * 2] = digits[byte / 16]
      output[index * 2 + 1] = digits[byte % 16]
      index = index + 1
    }
    return self.length * 2
  }

  /// Returns the id as lower-case hexadecimal text, such as
  /// `95d09f2b10159347eece71399a7e2e907ea3df4f`.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the text.
  pub effect fn hex(self: &Self) -> String
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut text: [u8; 64] = [0; 64]
    let length = self.writeHex(&mut text)

    // Hexadecimal digits are ASCII, so they are always valid text.
    let view = match String.fromUtf8(Slice.view<u8>(&text, 0, length)) {
      Result<string, InvalidUtf8>.Success { value } => value
      Result<string, InvalidUtf8>.Failure { .. } => Intrinsic.trap(
        "ObjectId.hex: hexadecimal digits are ASCII",
      )
    }
    return run String.copy(view)
  }
}

impl Debug for ObjectId {
  /// Writes the id as lower-case hexadecimal digits.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    let mut text: [u8; 64] = [0; 64]
    let length = self.writeHex(&mut text)
    return run Format.write(&mut formatter, Slice.view<u8>(&text, 0, length))
  }
}

/// One Git reference: a name, the object it points at, and, for some, a symbolic target or a
/// peeled object.
///
/// # Details
///
/// `name` is the full name, such as `HEAD`, `refs/heads/main`, or `refs/tags/v1.0.0`. `id` is the
/// object that the reference points at. It is `None` only for a symbolic reference whose target
/// does not exist yet, such as `HEAD` in a new repository. `peeled` is the object that an annotated
/// tag points at, after all tags are followed, when the source reported it. `target` is the name
/// that a symbolic reference points at, such as `refs/heads/main` for `HEAD`.
pub struct Ref {
  /// The full name of the reference.
  pub name: String,
  /// The object the reference points at, or `None` for an unborn symbolic reference.
  pub id: Option<ObjectId>,
  /// The object that an annotated tag peels to, when the source reported it.
  pub peeled: Option<ObjectId>,
  /// The name that a symbolic reference points at, or `None` for a direct reference.
  pub target: Option<String>,
}

impl Ref {
  /// Returns a direct reference named `name` that points at `id`, with no peeled object and no
  /// target.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the copy of `name`.
  pub effect fn make(name: string, id: Option<ObjectId>) -> Ref
    ! OutOfMemoryError
    ? &mut Allocator {
    return Ref {
      name: run String.copy(name),
      id: id,
      peeled: Option<ObjectId>.none(),
      target: Option<String>.none(),
    }
  }

  /// Returns the full name, such as `refs/heads/main`.
  pub fn fullName(self: &Self) -> string {
    return String.view(&self.name)
  }

  /// Returns `true` for a branch, a name that starts with `refs/heads/`.
  pub fn isBranch(self: &Self) -> bool {
    return String.startsWith(String.view(&self.name), "refs/heads/")
  }

  /// Returns `true` for a tag, a name that starts with `refs/tags/`.
  pub fn isTag(self: &Self) -> bool {
    return String.startsWith(String.view(&self.name), "refs/tags/")
  }

  /// Returns `true` for a remote-tracking branch, a name that starts with `refs/remotes/`.
  pub fn isRemoteBranch(self: &Self) -> bool {
    return String.startsWith(String.view(&self.name), "refs/remotes/")
  }

  /// Returns `true` for a symbolic reference, one with a `target`.
  pub fn isSymbolic(self: &Self) -> bool {
    return self.target.isSome()
  }

  /// Returns the name without the prefix of its kind: `main` for `refs/heads/main`, `v1.0.0` for
  /// `refs/tags/v1.0.0`, `origin/main` for `refs/remotes/origin/main`. Another name under `refs/`
  /// loses only `refs/`, and a name outside `refs/`, such as `HEAD`, does not change.
  pub fn shortName(self: &Self) -> string {
    let name = String.view(&self.name)
    let prefixes: [string; 4] = ["refs/heads/", "refs/tags/", "refs/remotes/", "refs/"]
    let mut index: usize = 0
    while index < 4 {
      let prefix = prefixes[index]
      if String.startsWith(name, prefix) && String.byteLength(name) > String.byteLength(prefix) {
        return String.slice(
          name,
          String.byteLength(prefix),
          String.byteLength(name) - String.byteLength(prefix),
        )
      }
      index = index + 1
    }
    return name
  }

  /// Returns the object that the reference finally names: the peeled object when there is one,
  /// which for an annotated tag is the object it tags, usually a commit. Otherwise returns `id`.
  pub fn commit(self: &Self) -> Option<ObjectId> {
    if let Option.Some { value } = &self.peeled {
      return Option<ObjectId>.some(value)
    }
    return self.id
  }
}

impl Debug for Ref {
  /// Writes the fields, as `Ref { name: "refs/heads/main", id: Some(95d0...) }`. It leaves out
  /// `peeled` and `target` when they are absent.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    let mut record = run Format.debugRecord("Ref", &mut formatter)
    run Format.debugField(&mut record, "name", &self.name, &mut formatter)
    run Format.debugField(&mut record, "id", &self.id, &mut formatter)
    if self.peeled.isSome() {
      run Format.debugField(&mut record, "peeled", &self.peeled, &mut formatter)
    }
    if self.target.isSome() {
      run Format.debugField(&mut record, "target", &self.target, &mut formatter)
    }
    return run Format.debugFinish(record, &mut formatter)
  }
}

/// The references of one repository, in the order of the source.
///
/// # Details
///
/// A remote lists its references sorted by name, after `HEAD`. A local repository is read in the
/// same order. Use [`RefList.find`] for an exact name, [`RefList.resolve`] for a short name, and
/// [`RefList.asSlice`] to walk all of them.
pub struct RefList {
  refs: List<Ref>,
}

impl RefList {
  /// Returns an empty list. It does not allocate.
  pub fn make() -> RefList {
    return RefList { refs: List<Ref>.make() }
  }

  /// Adds `entry` at the end of the list.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot grow the list. The list does not change.
  pub effect fn add(self: &mut Self, entry: Ref) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return run List<Ref>.append(&mut self.refs, move entry)
  }

  /// Puts `entry` at its place in name order and returns its index. A reference with the same
  /// name is replaced.
  ///
  /// # Details
  ///
  /// Names compare by their bytes, as Git sorts them, so `HEAD` comes before `refs/`. It finds the
  /// place by binary search, so the list must already be in name order, as it is when you only add
  /// references with this function. An entry that sorts last is appended without moving others.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot grow the list. The list does not change.
  pub effect fn insertSorted(self: &mut Self, entry: Ref) -> usize
    ! OutOfMemoryError
    ? &mut Allocator {
    let place = placeOf(List<Ref>.asSlice(&self.refs), String.ownedUtf8Bytes(&entry.name))
    if place < List<Ref>.length(&self.refs)
      && String.view(&List<Ref>.asSlice(&self.refs)[place].name) == String.view(&entry.name) {
      List<Ref>.set(&mut self.refs, place, move entry)
      return place
    }
    run List<Ref>.insert(&mut self.refs, place, move entry)
    return place
  }

  /// Returns the number of references.
  pub fn length(self: &Self) -> usize {
    return List<Ref>.length(&self.refs)
  }

  /// Returns all references, in the order of the source.
  pub fn asSlice(self: &Self) -> &[Ref] {
    return List<Ref>.asSlice(&self.refs)
  }

  /// Returns all references so that you can change them, in the order of the source.
  ///
  /// # Gotchas
  ///
  /// [`RefList.insertSorted`] needs the names in order, so change a name only if the order stays.
  pub fn asMutSlice(self: &mut Self) -> &mut [Ref] {
    return List<Ref>.asMutSlice(&mut self.refs)
  }

  /// Returns the reference whose full name is exactly `name`, such as `refs/heads/main` or `HEAD`,
  /// or `None` if there is none.
  pub fn find<'r>(self: &'r Self, name: string) -> Option<&'r Ref> {
    let entries = List<Ref>.asSlice(&self.refs)
    let mut index: usize = 0
    while index < entries.length {
      if String.view(&entries[index].name) == name {
        return Option<&'r Ref>.some(&entries[index])
      }
      index = index + 1
    }
    return Option<&'r Ref>.none()
  }

  /// Returns the reference that the short name `name` means, in the order that Git uses, or
  /// `None` if there is none.
  ///
  /// # Details
  ///
  /// It tries, in order: `name` itself, `refs/<name>`, `refs/tags/<name>`, `refs/heads/<name>`,
  /// `refs/remotes/<name>`, and `refs/remotes/<name>/HEAD`. So a tag wins over a branch with the
  /// same short name, as in `git rev-parse`.
  pub fn resolve<'r>(self: &'r Self, name: string) -> Option<&'r Ref> {
    let entries = List<Ref>.asSlice(&self.refs)
    let prefixes: [string; 6] = [
      "",
      "refs/",
      "refs/tags/",
      "refs/heads/",
      "refs/remotes/",
      "refs/remotes/",
    ]
    let suffixes: [string; 6] = ["", "", "", "", "", "/HEAD"]
    let mut rule: usize = 0
    while rule < 6 {
      let mut index: usize = 0
      while index < entries.length {
        if matchesRule(String.view(&entries[index].name), prefixes[rule], name, suffixes[rule]) {
          return Option<&'r Ref>.some(&entries[index])
        }
        index = index + 1
      }
      rule = rule + 1
    }
    return Option<&'r Ref>.none()
  }

  /// Returns `HEAD`, or `None` if the source did not report it.
  ///
  /// # Details
  ///
  /// For a remote, `HEAD` is the default branch: its `target` is the branch name, such as
  /// `refs/heads/main`, when the server reports it. A detached `HEAD` has no target.
  pub fn head<'r>(self: &'r Self) -> Option<&'r Ref> {
    return self.find("HEAD")
  }
}

impl Debug for RefList {
  /// Writes the references as a list.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return run Format.debugList<Ref>(List<Ref>.asSlice(&self.refs), &mut formatter)
  }
}

/// The reason that a Git operation failed.
pub union GitRefError {
  /// The data at `offset` is not in the expected format: a broken pkt-line, a line without an
  /// object id, or a broken `packed-refs` or loose reference file.
  Malformed {
    /// The byte offset in the response or file where the problem is.
    pub offset: usize,
  },
  /// The server answered with an `ERR` packet. `message` is its text.
  ServerError {
    /// The text that the server sent.
    pub message: String,
  },
  /// The response is not a Git reference advertisement, for example an HTML page from a URL that
  /// is not a repository.
  NotGitRepository,
  /// The repository uses a format that is not read: an unknown object format, or the `reftable`
  /// reference store.
  Unsupported,
  /// A symbolic reference points at itself through a chain of more than five references.
  SymbolicLoop,
}

impl Debug for GitRefError {
  /// Writes the variant and its fields, such as `Malformed { offset: 4 }`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return match &self.* {
      GitRefError.Malformed { offset } => {
        let mut record = run Format.debugRecord("Malformed", &mut formatter)
        run Format.debugField(&mut record, "offset", &offset, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      GitRefError.ServerError { message } => {
        let mut record = run Format.debugRecord("ServerError", &mut formatter)
        run Format.debugField(&mut record, "message", &message, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      GitRefError.NotGitRepository => run Format.write(&mut formatter, b"NotGitRepository")
      GitRefError.Unsupported => run Format.write(&mut formatter, b"Unsupported")
      GitRefError.SymbolicLoop => run Format.write(&mut formatter, b"SymbolicLoop")
    }
  }
}

// The first index whose name does not sort before `name`.
fn placeOf(entries: &[Ref], name: &[u8]) -> usize {
  let mut low: usize = 0
  let mut high = entries.length
  while low < high {
    let middle = low + (high - low) / 2
    if compareBytes(String.ownedUtf8Bytes(&entries[middle].name), name) < 0 {
      low = middle + 1
    } else {
      high = middle
    }
  }
  return low
}

// -1, 0, or 1 as `left` sorts before, with, or after `right` by bytes.
fn compareBytes(left: &[u8], right: &[u8]) -> i32 {
  let mut index: usize = 0
  while index < left.length && index < right.length {
    if left[index] < right[index] {
      return -1
    }
    if left[index] > right[index] {
      return 1
    }
    index = index + 1
  }
  if left.length < right.length {
    return -1
  }
  if left.length > right.length {
    return 1
  }
  return 0
}

// Whether `full` is `prefix`, `name`, and `suffix` joined.
fn matchesRule(full: string, prefix: string, name: string, suffix: string) -> bool {
  let total = String.byteLength(prefix) + String.byteLength(name) + String.byteLength(suffix)
  if String.byteLength(full) != total {
    return false
  }
  return String.startsWith(full, prefix) && String.endsWith(full, suffix)
    && String.slice(full, String.byteLength(prefix), String.byteLength(name)) == name
}

fn hexValue(byte: u8) -> u8 {
  if byte >= 48 && byte <= 57 {
    return byte - 48
  }
  if byte >= 97 && byte <= 102 {
    return byte - 87
  }
  if byte >= 65 && byte <= 70 {
    return byte - 55
  }
  return 16
}
