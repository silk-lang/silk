//! The native provider of the `Logger` effect: it writes each message to standard output.
//!
//! # When to use
//! Provide [`StdoutLogger`] for `Logger` in a native program. Code that logs uses `silk.logger`, so
//! a test can provide `InMemoryLogger` instead.
//!
//! # Details
//! Each message is formatted directly to standard output. The logger adds no level, timestamp, or
//! newline, and it does not allocate.
//!
//! # Errors
//! `LogError` with code 3 if the write fails. Part of the message can be written already.
//!
//! # Gotchas
//! The provider exists only on Darwin on aarch64, and Linux with GNU libc on x86_64 or aarch64.
//!
//! # Examples
//! ## Log to standard output
//! ```silk
//! import silk.effect { Effect }
//! import silk.logger { LogError, Logger }
//! import silk.os_logger { StdoutLogger }
//!
//! pub effect fn main() -> i32
//!   ! LogError {
//!   let mut logger = StdoutLogger.make()
//!   let values = .{ name: "silk", count: 3 }
//!
//!   // The logger adds no newline, so the template ends with one.
//!   run Effect.logInfo("{name} started {count} workers\n", &values)
//!     |> Effect.provideMut<Logger>(&mut logger)
//!   return 0
//! }
//! ```

static if (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText("libc") == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
  import silk.writer { WriterError, Writer }
  import silk.os_writer { StdoutWriter }
  import silk.logger { Logger, LogError, LogLevel }
  import silk.effect { Effect }
  import silk.result { Result }
  import silk.format { Format }

/// The native `Logger` provider. It writes only the formatted message, and ignores the level.
pub struct StdoutLogger {}

impl StdoutLogger {
  /// Returns a logger. It does not write anything.
  pub fn make() -> StdoutLogger { return StdoutLogger {} }

  effect fn writeStdout<Args>(
    self: &mut Self,
    level: LogLevel,
    static template: string<'static>,
    args: &Args
  ) -> () ! LogError {
    let mut streams = StdoutWriter.make()
    let completed = run Effect.result(formatStdout<Args>(&mut streams, template, args))
    return match move completed {
      Result<(), WriterError>.Success { value: _ } => ()
      Result<(), WriterError>.Failure { error: _ } => run writeFailure()
    }
  }
}

effect fn formatStdout<Args>(
  writer: &mut StdoutWriter,
  static template: string<'static>,
  args: &Args
) -> () ! WriterError {
  return run Format.format<Args>(template, args) |> Effect.provideMut<Writer>(&mut writer)
}

effect fn writeFailure() -> never ! LogError { fail Logger.failure(3) }

impl Logger for StdoutLogger {
  log: StdoutLogger.writeStdout
}

}
