  /// Creates a test runner named `name` with `root` resolved against the package directory.
  pub effect fn test(name: string, root: string) -> Self
    ! StepFailure
    ? &mut Allocator | &mut FileSystem | &mut HostInput {
    return run Compilation.create(
      Option<String>.some(run String.copy(name)),
      Option<String>.some(run String.copy("test")),
      Option<String>.some(run String.copy(root)),
    )
  }

  effect fn setting(self: Self, setting: Setting) -> Self
    ! StepFailure
    ? &mut Allocator {
    let mut held = self.state.lock()
    if held.get().registered.isSome() {
      fail StepError {
        message: run String.copy("compilation settings are frozen after its artifact is used"),
      }
    }
    let state = held.getMut()
    let mut at: usize = 0
    while at < state.settings.length() {
      if Settings.replaces(&setting, &state.settings.asSlice()[at]) {
        drop state.settings.remove(at)
      } else {
        at = at + 1
      }
    }
    run state.settings.append(move setting)
    drop held
    return move self
  }

  /// Configures one declared dependency alias, or `self` for this package.
  pub effect fn package(self: Self, alias: string, settings: Package) -> Self
    ! StepFailure
    ? &mut Allocator {
    return run self.setting(
      Setting.Package { alias: run String.copy(alias), settings: move settings },
    )
  }

  /// Removes a declared dependency from this compilation's available imports.
  pub effect fn without(self: Self, alias: string) -> Self
    ! StepFailure
    ? &mut Allocator {
    return run self.package(alias, Package.make().without())
  }

