  /// Executes this compilation through the build runner, publishing its request and artifact.
  pub effect fn build(self: Self) -> Built
    ! BuildError
    ? &mut Allocator | &mut FileSystem | &mut HostInput {
    let build = run Build.make()
    let graph = run build.add(move self)
    return run graph.compile()
  }

  /// Sets the runner's peak-memory estimate for this compiler process; the default is 3 GiB.
  pub effect fn memoryBudget(self: Self, bytes: u64) -> Self
    ! StepFailure
    ? &mut Allocator {
    let mut held = self.state.lock()
    if held.get().registered.isSome() {
      fail StepError {
        message: run String.copy("compilation settings are frozen after its artifact is used"),
      }
    }
    let state = held.getMut()
    state.memory = bytes
    drop held
    return move self
  }

  /// Authorizes package tools to run without a sandbox for this graph execution.
  /// This setting is not serialized into compilation definitions or requests.
  pub effect fn unsandboxedTools(self: Self, allowed: bool) -> Self
    ! StepFailure
    ? &mut Allocator {
    let mut held = self.state.lock()
    if held.get().registered.isSome() {
      fail StepError {
        message: run String.copy("compilation settings are frozen after its artifact is used"),
      }
    }
    let state = held.getMut()
    state.unsandboxedTools = allowed
    drop held
    return move self
  }

  /// Registers the compilation once, freezing its settings. The step holds the compilation's
  /// description, which the compiler restores and runs.
  pub effect fn step(self: &Self) -> StepHandle
    ! StepFailure
    ? &mut Allocator {
    let mut held = self.state.lock()
    let state = held.getMut()
    if let Option<StepHandle>.Some { value } = &state.registered {
      return value.copy()
    }
    let definition = match move Intrinsic.replace(state.definition, Option<Definition>.none()) {
      Option<Definition>.Some { value } => move value
      Option<Definition>.None => {
        fail StepError { message: run String.copy("the compilation has already been consumed") }
      }
    }
    let compiler = match move Intrinsic.replace(state.compiler, Option<Deferred<Path>>.none()) {
      Option<Deferred<Path>>.Some { value } => move value
      Option<Deferred<Path>>.None => {
        fail StepError { message: run String.copy("the compilation has no compiler") }
      }
    }
    let description = Description {
      definition: move definition,
      compiler: move compiler,
      settings: Intrinsic.replace(state.settings, List<Setting>.make()),
      memory: state.memory,
      unsandboxedTools: state.unsandboxedTools,
    }
    let mut key = Key.collecting()
    run key.toolchain(&description.compiler)
    let settings = description.settings.asSlice()
    let mut at: usize = 0
    while at < settings.length {
      run Settings.key(&settings[at], &mut key)
      at = at + 1
    }
    let step = run StepHandle.described(
      "compilation",
      run Encoding.json<Description>(&description),
      run key.producers(),
    )
    state.registered = Option<StepHandle>.some(step.copy())
    return move step
  }

  /// Returns the artifact's deferred path; consuming it adds this compilation as a dependency.
  pub effect fn artifact(self: &Self) -> Deferred<Path>
    ! StepFailure
    ? &mut Allocator {
    let step = run self.step()
    return run step.output("artifact")
  }

  /// Returns the generated C header as a deferred input. Configure `header` before using it.
  /// Consuming the path runs this compilation and rejects a missing header output.
  pub effect fn emittedHeader(self: &Self) -> Deferred<Path>
    ! StepFailure
    ? &mut Allocator {
    return run (run self.step()).output("header.h")
  }

  /// Returns the Windows import library as a deferred input. Configure `importLibrary` first.
  /// Consuming the path runs this compilation and rejects a missing import-library output.
  pub effect fn emittedImportLibrary(self: &Self) -> Deferred<Path>
    ! StepFailure
    ? &mut Allocator {
    return run (run self.step()).output("import-library.lib")
  }
}

import silk.collections.bytes { Bytes }

/// Restores a described compilation as the steps this process can run: one resolves its
/// request and one compiles it. Answers the compiling step.
pub effect fn restore(step: &[u8]) -> StepHandle
  ! StepFailure
  ? &mut Allocator | &mut FileSystem {
  let description = run SchemaJson.decode<Description>(step)
  let Description {
    definition: described,
    compiler,
    settings: listed,
    memory,
    unsandboxedTools
  } = move description
  let mut definition = move described
  let mut settings = move listed
  let inputs = run Context.inputs(&run Path.make(definition.manifest.view()))
  let applied = settings.asSlice()
  let mut at: usize = 0
  while at < applied.length {
    Settings.clearReplaced(&mut definition, &applied[at])
    at = at + 1
  }
  let encoded = run Encoding.json<Definition>(&definition)
  let resolved = run Step.register(
    RequestStep {
      definition: move encoded,
      compiler: run compiler.copy(),
      packages: run Deferred<List<String>>.value(move inputs.packages),
      files: run Deferred<List<String>>.value(move inputs.files),
      settings: move settings,
      unsandboxedTools: unsandboxedTools,
    },
  )
  return run Step.register(
    CompilerStep {
      request: run resolved.valueFile<Request>("request.json"),
      files: run resolved.valueFile<List<String>>("files.json"),
      trees: run resolved.valueFile<List<String>>("trees.json"),
      packages: run resolved.valueFile<List<String>>("packages.json"),
      compiler: move compiler,
      memory: memory,
    },
  )
}

struct RequestStep {
  unsandboxedTools: bool,
  settings: List<Setting>,
  definition: Bytes,
  compiler: Deferred<Path>,
  packages: Deferred<List<String>>,
  files: Deferred<List<String>>,
}

impl Step for RequestStep {
  effect fn key(self: &Self, key: &mut Key) -> ()
    ! StepFailure
    ? &mut Allocator {
    run key.bytes(self.definition.asSlice())
    run key.bytes(
      if self.unsandboxedTools {
        b"unsandboxed"
      } else {
        b"sandboxed"
      },
    )
    run key.toolchain(&self.compiler)
    run key.packageTrees(&self.packages)
    run key.files(&self.files)
    run compilerEnvironment(&mut key)
    let definition = run SchemaJson.decode<Definition>(self.definition.asSlice())
    if let Option<String>.Some { value } = &definition.stdlib {
      run key.tree(&run Deferred<Path>.external(value.view()))
    }
    run Settings.keyValues(&definition.settings, &mut key)
    let settings = self.settings.asSlice()
    let mut setting = usize.ZERO
    while setting < settings.length {
      run Settings.key(&settings[setting], &mut key)
      setting = setting + usize.ONE
    }
  }

  effect fn make(self: &Self, make: &mut Make) -> ()
    ! StepFailure
    ? &mut Allocator {
    let mut definition = run SchemaJson.decode<Definition>(self.definition.asSlice())
    let settings = self.settings.asSlice()
    let mut setting = usize.ZERO
    while setting < settings.length {
      run Settings.apply(&settings[setting], &mut make, &mut definition)
      setting = setting + usize.ONE
    }
    let encoded = run Encoding.toml<Definition>(&definition)
    run make.write("definition.toml", encoded.asSlice())
    let input = run Context.text(&run make.output("definition.toml"))
    let output = run Context.text(&run make.output("resolved.toml"))
    let outcome = if self.unsandboxedTools {
      run make.exec(
        &self.compiler,
        &[
          "resolve",
          "--definition",
          input.view(),
          "--output",
          output.view(),
          "--unsandboxed-tools",
        ],
      )
    } else {
      run make.exec(
        &self.compiler,
        &["resolve", "--definition", input.view(), "--output", output.view()],
      )
    }
    let succeeded = match move ChildProcess.exitCode(&outcome) {
      Option<i32>.Some { value } => value == 0
      Option<i32>.None => false
    }
    if !succeeded {
      let mut message = run String.copy("cannot resolve the compilation definition")
      if let Result<string, InvalidUtf8>.Success { value } = move String.fromUtf8(
        ChildProcess.errorBytes(&outcome),
      ) {
        run message.append(": ")
        run message.append(value)
      }
      fail StepError { message: move message }
    }
    let contents = run make.readOutput("resolved.toml")
    let request = run SchemaToml.decode<Request>(contents.asSlice())
    return run resolvedInputs(&mut make, &request)
  }
}

struct CompilerStep {
  request: Deferred<Request>,
  files: Deferred<List<String>>,
  trees: Deferred<List<String>>,
  packages: Deferred<List<String>>,
  compiler: Deferred<Path>,
  memory: u64,
}

impl Step for CompilerStep {
  effect fn key(self: &Self, key: &mut Key) -> ()
    ! StepFailure
    ? &mut Allocator {
    run key.value(&self.request)
    run key.files(&self.files)
    run key.trees(&self.trees)
    run key.packageTrees(&self.packages)
    run key.toolchain(&self.compiler)
    run compilerEnvironment(&mut key)

    // `silk build -q`, `--timings` and `--progress` change only what the compiler reports.
    run key.passEnvironment("SILK_QUIET")
    run key.passEnvironment("SILK_TIMINGS")
    run key.passEnvironment("SILK_PROGRESS")
  }

  effect fn make(self: &Self, make: &mut Make) -> ()
    ! StepFailure
    ? &mut Allocator {
    let mut request = run make.get(&self.request)
    let publication = run Encoding.toml<Request>(&request)
    run make.write("publication.toml", publication.asSlice())
    if request.header.isSome() {
      request.header = Option<String>.some(run pathText(&run make.output("header.h")))
    }
    if request.importLibrary.isSome() {
      request.importLibrary = Option<String>.some(
        run pathText(&run make.output("import-library.lib")),
      )
    }
    let output = run make.output("artifact")
    request.output = run pathText(&output)
    let encoded = run Encoding.toml<Request>(&request)
    run make.write("request.toml", encoded.asSlice())
    if !make.shouldCompile() {
      return ()
    }
    let requestPath = run make.output("request.toml")
    let written = run pathText(&requestPath)
    // The compiler's progress and diagnostics show as they come, as a build of this compilation
    // alone shows them.
    let succeeded = run make.execShown(
      &self.compiler,
      &["compile", "--request", written.view(), "--progress"],
    )
    if !succeeded {
      fail StepError { message: run String.copy("the compiler rejected the compilation request") }
    }
    if request.header.isSome() {
      run make.requireOutput("header.h")
    }
    if request.importLibrary.isSome() {
      run make.requireOutput("import-library.lib")
    }
    return run make.requireOutput("artifact")
  }

  fn memory(self: &Self) -> u64 {
    return self.memory
  }

  fn compilation(self: &Self) -> bool {
    return true
  }
}

effect fn optionalPath(paths: &mut List<String>, path: &Option<String>) -> ()
  ! StepFailure
  ? &mut Allocator {
  if let Option<String>.Some { value } = &path.* {
    run paths.append(run String.copy(value.view()))
  }
}

effect fn resolvedInputs(make: &mut Make, request: &Request) -> ()
  ! StepFailure
  ? &mut Allocator {
  let mut files = List<String>.make()
  let mut trees = List<String>.make()
  let mut packages = List<String>.make()
  run files.append(run String.copy(request.root.view()))
  run trees.append(run String.copy(request.stdlib.view()))
  let listed = request.packages.asSlice()
  let mut at = usize.ZERO
  while at < listed.length {
    let package = &listed[at]
    run packages.append(run String.copy(package.directory.view()))
    if package.source.view() != package.directory.view() {
      run trees.append(run String.copy(package.source.view()))
    }
    let modules = package.modules.asSlice()
    let mut module = usize.ZERO
    while module < modules.length {
      run files.append(run String.copy(modules[module].source.view()))
      module = module + usize.ONE
    }
    at = at + usize.ONE
  }
  let sources = request.native.sources.asSlice()
  at = usize.ZERO
  while at < sources.length {
    run files.append(run String.copy(sources[at].path.view()))
    let include = sources[at].include.asSlice()
    let mut directory = usize.ZERO
    while directory < include.length {
      run trees.append(run String.copy(include[directory].view()))
      directory = directory + usize.ONE
    }
    at = at + usize.ONE
  }
  let links = request.native.link.asSlice()
  at = usize.ZERO
  while at < links.length {
    let link = &links[at]
    let kind = link.kind.view()
    if kind == "object" || kind == "archive" || kind == "linker-script" {
      run files.append(run String.copy(link.value.view()))
    } else if kind == "search-path" || kind == "framework-search-path" {
      run trees.append(run String.copy(link.value.view()))
    }
    at = at + usize.ONE
  }
  run optionalPath(&mut files, &request.native.functionOrder)

  // A sysroot and its support installations are system trees, such as `/usr`, with links that
  // leave them or name nothing. The request keys their paths, as a host toolchain is keyed.
  if let Option<Platform>.Some { value } = &request.platform {
    run files.append(run String.copy(value.linker.view()))
  }
  if let Option<Windows>.Some { value } = &request.windows {
    run optionalPath(&mut files, &value.manifest)
    let resources = value.resources.asSlice()
    at = usize.ZERO
    while at < resources.length {
      run files.append(run String.copy(resources[at].view()))
      at = at + usize.ONE
    }
  }
  if let Option<MacOS>.Some { value } = &request.macos {
    run optionalPath(&mut files, &value.entitlements)
  }
  if let Option<Wasm>.Some { value } = &request.wasm {
    run optionalPath(&mut trees, &value.wit)
  }
  run make.valueFile<Request>("request.json", request)
  run make.valueFile<List<String>>("files.json", &files)
  run make.valueFile<List<String>>("trees.json", &trees)
  return run make.valueFile<List<String>>("packages.json", &packages)
}

effect fn pathText(path: &Path) -> String
  ! StepFailure
  ? &mut Allocator {
  return match move Path.view(path) {
    Option<string>.Some { value } => run String.copy(value)
    Option<string>.None => {
      fail StepError { message: run String.copy("a compilation path must be UTF-8") }
    }
  }
}

// Resolution may fetch pinned sources, and compilation invokes the selected native tools.
// Child processes inherit only inputs declared here.
effect fn compilerEnvironment(key: &mut Key) -> ()
  ! StepFailure
  ? &mut Allocator {
  let names = [
    "PATH",
    "SDKROOT",
    "DEVELOPER_DIR",
    "SILK_CLANG",
    "SILK_LLVM_AR",
    "SILK_HOME",
    "SILK_OFFLINE",
    "SILK_ARCHIVE_MIRROR",
    "SILK_BACKEND",
    "SILK_IGNORE_WARNINGS",
    "HOME",
    "LANG",
    "LC_ALL",
    "LC_CTYPE",
    "LOCALAPPDATA",
    "USERPROFILE",
    "SystemRoot",
    "COMSPEC",
    "TMPDIR",
    "TMP",
    "TEMP",
    "SILK_VERIFY_MIR",
    "SILK_RECEIPTS",
    "SILK_PROFILE_USE",
    "SILK_PROFILE_GENERATE",
    "SILK_WASM_TOOLS",
    "SILK_WASI_ADAPTER",
    "SILK_WASI_REACTOR_ADAPTER",
    "HTTP_PROXY",
    "HTTPS_PROXY",
    "ALL_PROXY",
    "NO_PROXY",
    "http_proxy",
    "https_proxy",
    "all_proxy",
    "no_proxy",
    "SSL_CERT_FILE",
    "SSL_CERT_DIR",
    "CURL_CA_BUNDLE",
    "GIT_SSL_CAINFO",
    "GIT_SSL_CAPATH",
    "SSH_AUTH_SOCK",
    "GIT_SSH_COMMAND",
  ]
  let mut at: usize = 0
  while at < names.length {
    run key.environment(names[at])
    at = at + 1
  }
}
