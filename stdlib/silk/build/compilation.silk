// A compilation as the compiler restores it: the definition and the settings still to apply.
struct Description {
  pub definition: Definition,
  pub compiler: Deferred<Path>,
  pub settings: List<Setting>,
  pub memory: u64,
  pub unsandboxedTools: bool,
}

impl Schema for Description {}

struct State {
  definition: Option<Definition>,
  compiler: Option<Deferred<Path>>,
  registered: Option<StepHandle>,
  settings: List<Setting>,
  memory: u64,
  unsandboxedTools: bool,
}

/// A compilation whose settings freeze when its artifact is first used by the graph.
pub struct Compilation {
  state: Mutex<State>,
}

impl Compilation {
  /// Applies `transform` when `condition` is true, returning the original value otherwise.
  pub effect fn when<'env, E, ? R>(
    self: Self,
    condition: bool,
    transform: once effect fn<'env>(Self) -> Self ! E ? R,
  ) -> Self
    ! E
    ? R {
    if condition {
      return run transform(move self)
    }
    return move self
  }

  /// Creates a compilation from an explicit package definition and compiler. Resolution runs as a graph prerequisite.
  pub effect fn fromDefinition(definition: Definition, compiler: Deferred<Path>) -> Self
    ! StepFailure
    ? &mut Allocator | &mut FileSystem {
    return Compilation {
      state: run Mutex<State>.make(
        State {
          definition: Option<Definition>.some(move definition),
          compiler: Option<Deferred<Path>>.some(move compiler),
          registered: Option<StepHandle>.none(),
          settings: List<Setting>.make(),
          memory: 3221225472,
          unsandboxedTools: false,
        },
      ),
    }
  }

  effect fn create(name: Option<String>, artifact: Option<String>, root: Option<String>) -> Self
    ! StepFailure
    ? &mut Allocator | &mut FileSystem | &mut HostInput {
    let manifest = run Context.manifest()
    let mut settings = Values.make()
    if let Option<String>.Some { value } = move root {
      let parent = match move run Path.parent(&manifest) {
        Option<Path>.Some { value: directory } => move directory
        Option<Path>.None => {
          fail StepError { message: run String.copy("the package manifest has no directory") }
        }
      }
      settings.root = Option<String>.some(
        run Context.text(&run Context.path(&parent, value.view())),
      )
    }
    let definition = Definition {
      manifest: run Context.text(&manifest),
      name: move name,
      artifact: move artifact,
      stdlib: run Context.standardLibrary(),
      settings: move settings,
      packages: Dictionary<PackageSettings>.make(),
    }
    return run Compilation.fromDefinition(move definition, run Context.compiler())
  }

  /// Uses the current package's default root and artifact with the command's options.
  /// A compilation selects at most one target. Commands building several targets create one
  /// compilation per target and add them to a Build.
  pub effect fn fromPackage(options: &Options) -> Self
    ! StepFailure
    ? &mut Allocator | &mut FileSystem | &mut HostInput {
    if options.target.length() > 1 {
      fail StepError {
        message: run String.copy(
          "one compilation selects at most one target; add one compilation per target to Build",
        ),
      }
    }
    let mut compilation = run Compilation.create(
      Option<String>.none(),
      Option<String>.none(),
      Option<String>.none(),
    )
    if options.target.length() == 1 {
      let previous = move compilation
      compilation = run previous.target(
        run Deferred<String>.value(run String.copy(options.target.asSlice()[0].view())),
      )
    }
    let selected = move compilation
    let optimized = run selected.optimize(run Deferred<Optimize>.value(options.optimize))
    let debugged = run optimized.debug(run Deferred<bool>.value(options.debugInfo()))
    return run debugged.unsandboxedTools(options.unsandboxedTools)
  }

  /// Creates a program named `name` with `root` resolved against the package directory.
  pub effect fn executable(name: string, root: string) -> Self
    ! StepFailure
    ? &mut Allocator | &mut FileSystem | &mut HostInput {
    return run Compilation.create(
      Option<String>.some(run String.copy(name)),
      Option<String>.some(run String.copy("executable")),
      Option<String>.some(run String.copy(root)),
    )
  }

  /// Creates a loadable module named `name` with `root` resolved against the package directory.
  pub effect fn loadableModule(name: string, root: string) -> Self
