//! Generated files whose contents are known values or other steps' deferred values.

import silk.build.descriptor { Action, Input, Chain, File as StaticFile }
import silk.core.option { Option }
import silk.system.filesystem { Path }
import silk.build.step { describedPath, Deferred, Key, Make, Step, StepFailure, StepHandle, StepError }
import silk.collections.list { List }
import silk.mem.allocator { Allocator }
import silk.text.string { String }
import silk.num.usize
import silk.schema.json { SchemaJson }
import silk.schema.schema { Schema }

struct File {pub name: String, pub content: Deferred<String>}

impl Schema for File {}

/// A step that writes declared text files without starting a process.
struct Files {pub files: List<File>}

impl Schema for Files {}

impl Files {
  /// Creates an empty set of generated files.
  fn make() -> Self { return Files {files: List<File>.make()} }

  /// Adds UTF-8 text to write below this step's output directory.
  effect fn text(self: Self, name: string, content: string) -> Self ! StepFailure ? &mut Allocator {
    return run self.value(name, run Deferred<String>.value(run String.copy(content)))
  }

  /// Adds text produced by another step; its producer becomes an implicit dependency.
  effect fn value(self: Self, name: string, content: Deferred<String>) -> Self ! StepFailure ? &mut Allocator {
    let mut files = move self
    run files.files.append(File {name: run String.copy(name), content: move content})
    return move files
  }


}

impl Step for Files {
  effect fn key(self: &Self, key: &mut Key) -> () ! StepFailure ? &mut Allocator {
    let files = self.files.asSlice()
    let mut at = usize.ZERO
    while at < files.length {
      run key.text(files[at].name.view())
      run key.value(&files[at].content)
      at = at + usize.ONE
    }
  }

  effect fn make(self: &Self, make: &mut Make) -> () ! StepFailure ? &mut Allocator {
    let files = self.files.asSlice()
    let mut at = usize.ZERO
    while at < files.length {
      let content = run make.get<String>(&files[at].content)
      run make.write(files[at].name.view(), String.ownedUtf8Bytes(&content))
      at = at + usize.ONE
    }
  }
}

/// A generated-file step shared by static package plans and runtime task graphs.
pub union WriteFiles {
  Static {files: Option<&'static Chain<StaticFile>>},
  Dynamic {files: Files},
}

impl WriteFiles {
  /// Begins a pure description of generated text files.
  pub static fn empty() -> Self { return WriteFiles.Static {files: Option<&'static Chain<StaticFile>>.None} }
  /// Adds a known text file to a static description.
  pub static fn literal(self: Self, name: string<'static>, content: string<'static>) -> Self {
    let files = WriteFiles.description(&self)
    return WriteFiles.Static {files: Chain<StaticFile>.append(files, StaticFile {name: name, content: content})}
  }
  /// Reads a pure file description; runtime values cannot enter a package plan.
  pub static fn description(self: &Self) -> Option<&'static Chain<StaticFile>> {
    return match &self.* {
      WriteFiles.Static {files} => files
      WriteFiles.Dynamic {..} => compileError("a package plan requires statically described file contents")
    }
  }
  /// Names a file without registering or executing its producer.
  pub static fn result(self: &Self, name: string<'static>) -> Deferred<Path> {
    let action = Action.WriteFiles {files: WriteFiles.description(self)}
    return describedPath(Input.Output {step: &action, name: name})
  }
  /// Starts a generated-file step that accepts runtime values.
  pub fn make() -> Self { return WriteFiles.Dynamic {files: Files.make()} }
  /// Adds known UTF-8 text to the generated files.
  pub effect fn text(self: Self, name: string, content: string) -> Self ! StepFailure ? &mut Allocator {
    let files = run materialize(move self)
    return WriteFiles.Dynamic {files: run files.text(name, content)}
  }
  /// Adds a deferred text value, retaining its producer dependency.
  pub effect fn value(self: Self, name: string, content: Deferred<String>) -> Self ! StepFailure ? &mut Allocator {
    let files = run materialize(move self)
    return WriteFiles.Dynamic {files: run files.value(name, move content)}
  }
  /// Registers the files and returns a handle to their deferred output paths.
  pub effect fn register(self: Self) -> StepHandle ! StepFailure ? &mut Allocator {
    return run Step.describe<Files>("files", run materialize(move self))
  }

  /// Registers the files as work this process runs itself, without describing it to the compiler.
  pub effect fn registerHere(self: Self) -> StepHandle ! StepFailure ? &mut Allocator {
    return run Step.register(move self)
  }
}

/// Restores described files as a step this process can run.
pub effect fn restore(step: &[u8]) -> StepHandle ! StepFailure ? &mut Allocator {
  return run Step.register(WriteFiles.Dynamic { files: run SchemaJson.decode<Files>(step) })
}

effect fn materialize(step: WriteFiles) -> Files ! StepFailure ? &mut Allocator {
  return match move step {
    WriteFiles.Dynamic {files} => move files
    WriteFiles.Static {files} => run append(Files.make(), files)
  }
}

effect fn append(files: Files, description: Option<&'static Chain<StaticFile>>) -> Files
! StepFailure ? &mut Allocator {
  if let Option<&'static Chain<StaticFile>>.Some {value} = description {
    let previous = run append(move files, value.previous)
    return run previous.text(value.value.name, value.value.content)
  }
  return move files
}

impl Step for WriteFiles {
  effect fn prepare(self: Self) -> Self ! StepFailure ? &mut Allocator { return WriteFiles.Dynamic {files: run materialize(move self)} }
  effect fn key(self: &Self, key: &mut Key) -> () ! StepFailure ? &mut Allocator {
    if let WriteFiles.Dynamic {files} = &self.* { return run Step.key(&files, &mut key.*) }
    fail StepError {message: run String.copy("a file description must be prepared before keying")}
  }
  effect fn make(self: &Self, make: &mut Make) -> () ! StepFailure ? &mut Allocator {
    if let WriteFiles.Dynamic {files} = &self.* { return run Step.make(&files, &mut make.*) }
    fail StepError {message: run String.copy("a file description must be prepared before execution")}
  }
}
