//! Typed compilation definitions whose defaults and package inputs the toolchain resolves.

import silk.build.request { Module, Native, NativeSource, LinkInput, Platform, Windows, MacOS, Wasm, Runner, ParameterValue, profileSpec }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.schema.schema { Dictionary, Schema, Spec, Checks }
import silk.num.usize
import silk.text.string { String }

/// A package-backed compilation before target defaults, imports, and plans are resolved.
pub struct Definition {
  /// The absolute manifest path defining the available packages.
  pub manifest: String,
  /// The artifact name; absent uses the package name.
  pub name: Option<String>,
  /// The artifact shape; absent uses the package's default.
  pub artifact: Option<String>,
  /// The standard-library root; absent uses the compiler installation.
  pub stdlib: Option<String>,
  /// Values selected by the command after its deferred inputs complete.
  pub settings: Settings,
  /// Overrides keyed by declared dependency alias, or `self` for the root package.
  pub packages: Dictionary<Package>,
}
impl Schema for Definition {
  static fn spec() -> Spec<Definition> {
    return Spec<Definition>.of() |> Spec<Definition>.strict()
      |> Spec<Definition>.pattern("name", "^[A-Za-z0-9_.-]+$")
      |> Spec<Definition>.pattern("artifact", "^(executable|loadable-module|static-archive|object|test)$")
  }
}

/// Compilation settings without target-dependent defaults. Lists preserve the command's order.
pub struct Settings {
  /// Optional program-wide source and backend settings.
  pub profile: Profile,
  /// An absolute root module path; absent uses the package entry.
  pub root: Option<String>,
  /// Generated modules added to the root package.
  pub modules: List<Module>,
  /// Additional native translation units and link inputs.
  pub native: Native,
  /// The emitted form; absent selects the final artifact.
  pub emit: Option<String>,
  /// An explicit sysroot, linker, and support installations.
  pub platform: Option<Platform>,
  /// Windows link settings.
  pub windows: Option<Windows>,
  /// macOS link and signing settings.
  pub macos: Option<MacOS>,
  /// WebAssembly memory, execution, and interface settings.
  pub wasm: Option<Wasm>,
  /// The requested C header output path.
  pub header: Option<String>,
  /// The requested import library output path.
  pub importLibrary: Option<String>,
  /// The program and arguments used to launch the artifact.
  pub runner: Option<Runner>,
}
impl Schema for Settings {
  static fn spec() -> Spec<Settings> {
    return Spec<Settings>.of() |> Spec<Settings>.strict()
      |> Spec<Settings>.rename("importLibrary", "import-library")
      |> Spec<Settings>.pattern("emit", "^(final|llvm-ir|llvm-bitcode|assembly|object|wasm-text)$")
  }
}
impl Settings {
  /// Returns settings that leave target-dependent defaults to the compiler.
  pub fn make() -> Self {
    return Settings {profile: Profile.make(), root: Option<String>.none(), modules: List<Module>.make(),
      native: Native {sources: List<NativeSource>.make(), link: List<LinkInput>.make(), functionOrder: Option<String>.none()},
      emit: Option<String>.none(), platform: Option<Platform>.none(), windows: Option<Windows>.none(),
      macos: Option<MacOS>.none(), wasm: Option<Wasm>.none(), header: Option<String>.none(),
      importLibrary: Option<String>.none(), runner: Option<Runner>.none()}
  }
}

/// Overrides for one declared package, without changing program-wide source facts.
pub struct Package {
  /// The defining package's code-generation optimization.
  pub optimization: Option<String>,
  /// Whether code defined in this package emits debug information.
  pub debug: Option<bool>,
  /// Parameters named by module and declaration.
  pub parameters: List<Parameter>,
  /// Whether this compilation excludes the declared dependency.
  pub excluded: bool,
}
impl Schema for Package {
  static fn spec() -> Spec<Package> {
    return Spec<Package>.of() |> Spec<Package>.strict()
      |> Spec<Package>.pattern("optimization", "^(none|speed|size)$")
  }
  fn check(self: &Self, checks: &mut Checks<Self>) -> () {
    checks.that(!self.excluded || (!self.optimization.isSome() && !self.debug.isSome() && self.parameters.length() == usize.ZERO),
      "an excluded package without settings or parameters")
  }
}

/// A typed parameter binding supplied by a root command.
pub struct Parameter {
  /// The package-relative module path declaring the parameter.
  pub module: String,
  /// The parameter declaration's name.
  pub name: String,
  /// The supplied value, interpreted against the declared parameter schema.
  pub value: ParameterValue,
  /// Whether this value grants a supplied-path capability to the package's plan.
  pub suppliedPath: bool,
}
impl Schema for Parameter {
  static fn spec() -> Spec<Parameter> {
    return Spec<Parameter>.of() |> Spec<Parameter>.strict() |> Spec<Parameter>.rename("suppliedPath", "supplied-path")
  }
}

/// Optional source facts and backend settings, resolved by the compiler's target policy.
pub struct Profile {
  /// The canonical target triple.
  pub target: Option<String>,
  /// The CPU model.
  pub cpu: Option<String>,
  /// The enabled CPU features.
  pub cpuFeatures: Option<List<String>>,
  /// The minimum operating-system version.
  pub deployment: Option<String>,
  /// The selected C library.
  pub libc: Option<String>,
  /// The entry selection: default, none, or a declared name.
  pub entry: Option<String>,
  /// The runtime selection: default, none, or a declared name.
  pub runtime: Option<String>,
  /// The link mode.
  pub link: Option<String>,
  /// The target code model.
  pub codeModel: Option<String>,
  /// The relocation model.
  pub relocation: Option<String>,
  /// The program-wide optimization: none, speed, or size.
  pub optimization: Option<String>,
  /// Whether the program emits debug information by default.
  pub debug: Option<bool>,
  /// The program-wide safety policy.
  pub safety: Option<String>,
  /// The program-wide threading policy.
  pub threading: Option<String>,
  /// The enabled sanitizers.
  pub sanitizers: Option<List<String>>,
  /// The unwind policy.
  pub unwind: Option<String>,
  /// The code generator: llvm or direct.
  pub backend: Option<String>,
  /// The number of code generation units for an optimized build.
  pub codegenUnits: Option<u64>,
  /// The maximum WebAssembly memory, in bytes.
  pub maxMemory: Option<u64>,
  /// The main stack size, in bytes.
  pub stackSize: Option<u64>,
}

impl Schema for Profile {
  static fn spec() -> Spec<Profile> { return profileSpec<Profile>() }
}
impl Profile {
  /// Leaves every setting unspecified so the target supplies its defaults.
  pub fn make() -> Self {
    return Profile {
      target: Option<String>.none(),
      cpu: Option<String>.none(),
      cpuFeatures: Option<List<String>>.none(),
      deployment: Option<String>.none(),
      libc: Option<String>.none(),
      entry: Option<String>.none(),
      runtime: Option<String>.none(),
      link: Option<String>.none(),
      codeModel: Option<String>.none(),
      relocation: Option<String>.none(),
      optimization: Option<String>.none(),
      debug: Option<bool>.none(),
      safety: Option<String>.none(),
      threading: Option<String>.none(),
      sanitizers: Option<List<String>>.none(),
      unwind: Option<String>.none(),
      backend: Option<String>.none(),
      codegenUnits: Option<u64>.none(),
      maxMemory: Option<u64>.none(),
      stackSize: Option<u64>.none()}
  }
}
