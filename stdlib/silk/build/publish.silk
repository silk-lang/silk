//! Copies completed build outputs without exposing partially written files.

import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.collections.bytes { Bytes }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { AtomicWriteError, DirectoryInfo, FileError, FileInfo, FileSystem, Path }

static if Intrinsic.targetOperatingSystem() == "linux" || Intrinsic.targetOperatingSystem() == "darwin" {
  import silk.platform.native.file { NativeFile, NativeFileError, CopyMethod }

  effect fn replace(source: &Path, temporary: &Path, destination: &Path) -> () ! NativeFileError {
    run NativeFile.copy(Path.rawBytes(source), Path.rawBytes(temporary), true, CopyMethod.CloneOrBytes)
    return run NativeFile.rename(Path.rawBytes(temporary), Path.rawBytes(destination))
  }

  effect fn copyFile(source: &Path, destination: &Path, parent: &Path) -> () ! FileError | OutOfMemoryError
  ? &mut Allocator | &mut FileSystem {
    let directory = run FileSystem.temporaryDirectory(parent, ".publish")
    let temporary = run Path.join(&directory.path, "artifact")
    let result = run Effect.result(replace(source, &temporary, destination))
    let cleaned = run Effect.result(FileSystem.release(move directory))
    drop cleaned
    match move result {
      Result<(), NativeFileError>.Success {..} => ()
      Result<(), NativeFileError>.Failure {error} => {
        fail FileSystem.errorWithCode(FileSystem.writeFileAtomicOperation(), FileSystem.other(), error.code)
      }
    }
  }
} else {
  effect fn copyFile(source: &Path, destination: &Path, parent: &Path) -> () ! AtomicWriteError | FileError | OutOfMemoryError
  ? &mut Allocator | &mut FileSystem {
    let contents = run FileSystem.readFile(source)
    return run FileSystem.writeFileAtomic(destination, contents.asSlice(), FileSystem.replaceExisting(), FileSystem.buffered())
  }
}

/// Copies a completed file or directory tree. Files replace their destination atomically and
/// retain executable permissions on Unix; directories merge their completed files.
pub effect fn copy(source: &Path, destination: &Path) -> () ! AtomicWriteError | FileError | OutOfMemoryError
? &mut Allocator | &mut FileSystem {
  match move run FileSystem.stat(source) {
    FileInfo {..} => {
      let parent = match move run Path.parent(destination) {
        Option<Path>.Some {value} => move value
        Option<Path>.None => { fail FileSystem.error(FileSystem.pathOperation(), FileSystem.invalidPath()) }
      }
      run FileSystem.createDirectoriesRecursively(&parent)
      return run copyFile(source, destination, &parent)
    }
    DirectoryInfo {} => {
      run FileSystem.createDirectoriesRecursively(destination)
      let entries = run FileSystem.listDirectory(source)
      let listed = entries.asSlice()
      let mut at: usize = 0
      while at < listed.length {
        let entry = &listed[at]
        if entry.kind.code == FileSystem.symbolicLink().code {
          fail FileSystem.error(FileSystem.readFileOperation(), FileSystem.unsupported())
        }
        let name = match move Path.name(&entry.path) {
          Option<string>.Some {value} => value
          Option<string>.None => { fail FileSystem.error(FileSystem.pathOperation(), FileSystem.invalidPath()) }
        }
        run copy(&entry.path, &run Path.join(destination, name))
        at = at + 1
      }
    }
  }
}

/// Publishes an artifact and any symbol map or macOS debug bundle stored beside it.
pub effect fn artifact(source: &Path, destination: &Path) -> () ! AtomicWriteError | FileError | OutOfMemoryError
? &mut Allocator | &mut FileSystem {
  run copy(source, destination)
  let suffixes = [b".symbols", b".dSYM"]
  let mut at: usize = 0
  while at < suffixes.length {
    let mut sourceBytes = run Bytes.copy(Path.rawBytes(source))
    run sourceBytes.append(suffixes[at])
    let sidecar = run Path.fromBytes(sourceBytes.asSlice())
    let mut destinationBytes = run Bytes.copy(Path.rawBytes(destination))
    run destinationBytes.append(suffixes[at])
    let published = run Path.fromBytes(destinationBytes.asSlice())
    if run FileSystem.exists(&sidecar) {
      run copy(&sidecar, &published)
    } else if run FileSystem.exists(&published) {
      match move run FileSystem.stat(&published) {
        FileInfo {..} => run FileSystem.removeFile(&published)
        DirectoryInfo {} => run FileSystem.removeDirectoryRecursively(&published)
      }
    }
    at = at + 1
  }
}
