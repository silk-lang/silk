//! Generated modules that expose a declared file's bytes as a static value.

import silk.build.step { Deferred, Key, Make, Step, StepFailure }
import silk.collections.bytes { Bytes }
import silk.mem.allocator { Allocator }
import silk.system.filesystem { Path }
import silk.num.usize
import silk.num.u8

struct Embedded {
  input: Deferred<Path>
}

impl Step for Embedded {
  effect fn key(self: &Self, key: &mut Key) -> ()
    ! StepFailure
    ? &mut Allocator {
    return run key.file(&self.input)
  }

  effect fn make(self: &Self, make: &mut Make) -> ()
    ! StepFailure
    ? &mut Allocator {
    let input = run make.read(&self.input)
    let mut source = run Bytes.copy(b"pub const data: &'static [u8] = b\"")
    let digits = b"0123456789abcdef"
    let bytes = input.asSlice()
    let mut at = usize.ZERO
    while at < bytes.length {
      let byte = bytes[at]
      run source.append(&[92, 120, digits[u8.toUsize(byte / 16)], digits[u8.toUsize(byte % 16)]])
      at = at + usize.ONE
    }
    run source.append(b"\"\n")
    return run make.write("embedded.silk", source.asSlice())
  }
}

/// Produces a module with `pub const data: &'static [u8]` containing exactly the input file's bytes.
/// The file's producer runs first, and its content determines the generated module's cache key.
pub effect fn module(input: Deferred<Path>) -> Deferred<Path>
  ! StepFailure
  ? &mut Allocator {
  let step = run Step.register(Embedded { input: move input })
  return run step.output("embedded.silk")
}
