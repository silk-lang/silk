//! Pure package requirements built with the same standard actions and deferred paths as tasks.
//!
//! A package declares `pub const PLAN: Plan` in `build.silk`. The compiler evaluates the value
//! without effects. Generated files and processes execute later through the build graph; package
//! processes require dependency authorization and a supported operating-system sandbox.

import silk.build.descriptor { Chain, Input }
import silk.build.step { Deferred, describedPath }
import silk.core.option { Option }
import silk.system.filesystem { Path }

/// One static package requirement, interpreted after its deferred producers complete.
pub union Operation {
  /// A generated Silk module, named relative to the package's source root.
  Module { pub name: string<'static>, pub source: Input },
  /// A native source file in the indicated language.
  Compile {
    pub language: string<'static>,
    pub source: Input,
    pub flags: &'static [string<'static>],
    pub include: Option<&'static Chain<Input>>,
    pub pattern: Option<string<'static>>
  },
  /// A native compiler flag, applied to the package's translation units in order.
  Flag { pub value: string<'static> },
  /// An include directory shared by the package's native translation units.
  Include { pub path: Input },
  /// A linker file or search directory.
  LinkFile { pub kind: string<'static>, pub path: Input },
  /// A named library or framework.
  Link {
    pub kind: string<'static>,
    pub name: string<'static>,
    pub mode: string<'static>,
    pub weak: bool,
    pub needed: bool
  },
  /// A runtime library search path.
  RPath { pub value: string<'static> },
  /// The package's native symbol order file.
  FunctionOrder { pub path: Input },
  /// A declared dependency whose native plan links into this package's artifacts.
  LinkDependency { pub name: string<'static> },
}

/// How a named library is linked: by static or dynamic search, and whether it is weak or retained.
///
/// # When to use
///
/// Pass it to `Plan.linkLibrary` or `Compilation.linkLibrary`. Start from [`Library.dynamicSearch`] or
/// [`Library.staticSearch`] and add [`Library.weak`] or [`Library.needed`] only where the link needs them.
pub struct Library {
  /// `"dynamic"` or `"static"`.
  pub mode: string<'static>,
  /// Whether the program may start when the library is absent.
  pub isWeak: bool,
  /// Whether the library stays linked when no symbol refers to it.
  pub isNeeded: bool,
}

impl Library {
  /// A library found by dynamic search, strong and dropped when unused.
  pub fn dynamicSearch() -> Library {
    return Library { mode: "dynamic", isWeak: false, isNeeded: false }
  }

  /// A library found by static search, strong and dropped when unused.
  pub fn staticSearch() -> Library {
    return Library { mode: "static", isWeak: false, isNeeded: false }
  }

  /// Returns this library linked weakly, so the program may start when it is absent.
  pub fn weak(self: Self) -> Library {
    return Library { mode: self.mode, isWeak: true, isNeeded: self.isNeeded }
  }

  /// Returns this library retained even when no symbol refers to it.
  pub fn needed(self: Self) -> Library {
    return Library { mode: self.mode, isWeak: self.isWeak, isNeeded: true }
  }
}

/// How a named macOS framework is linked: whether it is weak or retained.
///
/// # When to use
///
/// Pass it to `Plan.linkFramework` or `Compilation.linkFramework`. Start from [`Framework.make`]
/// and add [`Framework.weak`] or [`Framework.needed`] only where the link needs them.
pub struct Framework {
  /// Whether the program may start when the framework is absent.
  pub isWeak: bool,
  /// Whether the framework stays linked when no symbol refers to it.
  pub isNeeded: bool,
}

impl Framework {
  /// A framework linked strongly and dropped when unused.
  pub fn make() -> Framework {
    return Framework { isWeak: false, isNeeded: false }
  }

  /// Returns this framework linked weakly, so the program may start when it is absent.
  pub fn weak(self: Self) -> Framework {
    return Framework { isWeak: true, isNeeded: self.isNeeded }
  }

  /// Returns this framework retained even when no symbol refers to it.
  pub fn needed(self: Self) -> Framework {
    return Framework { isWeak: self.isWeak, isNeeded: true }
  }
}

/// The immutable requirements contributed by a package wherever it is used.
pub struct Plan {
  /// Requirements in reverse insertion order; producers are retained by their deferred inputs.
  pub steps: Option<&'static Chain<Operation>>,
}

impl Plan {
  /// Applies `transform` when `condition` is true, returning this plan without calling it otherwise.
  pub static fn when(self: Self, condition: bool, transform: fn(Self) -> Self) -> Self {
    if condition {
      return transform(self)
    }
    return self
  }

  /// Names a file or directory in this package's manifest-pinned native archive.
  /// The package plan resolves the target variant and root or machine override before running steps.
  pub static fn archivePath(name: string<'static>, path: string<'static>) -> Deferred<Path> {
    return describedPath(Input.Archive { name: name, path: path })
  }

  /// Starts a package plan without requirements.
  pub static fn empty() -> Self {
    return Plan { steps: Option<&'static Chain<Operation>>.None }
  }

  static fn append(self: Self, operation: Operation) -> Self {
    return Plan { steps: Chain<Operation>.append(self.steps, move operation) }
  }

  /// Adds the file produced by a standard step as a generated Silk module.
  pub static fn module(self: Self, name: string<'static>, source: Deferred<Path>) -> Self {
    return Plan.append(
      self,
      Operation.Module { name: name, source: Deferred<Path>.description(&source) },
    )
  }

  /// Compiles a deferred C file into the package's native inputs.
  pub static fn compileC(self: Self, source: Deferred<Path>) -> Self {
    return Plan.append(
      self,
      Operation.Compile {
        language: "c",
        source: Deferred<Path>.description(&source),
        flags: &[],
        include: Option<&'static Chain<Input>>.None,
        pattern: Option<string<'static>>.None,
      },
    )
  }

  /// Compiles a deferred C++ file into the package's native inputs.
  pub static fn compileCpp(self: Self, source: Deferred<Path>) -> Self {
    return Plan.append(
      self,
      Operation.Compile {
        language: "cpp",
        source: Deferred<Path>.description(&source),
        flags: &[],
        include: Option<&'static Chain<Input>>.None,
        pattern: Option<string<'static>>.None,
      },
    )
  }

  /// Compiles a deferred Objective-C file into the package's native inputs.
  pub static fn compileObjectiveC(self: Self, source: Deferred<Path>) -> Self {
    return Plan.append(
      self,
      Operation.Compile {
        language: "objc",
        source: Deferred<Path>.description(&source),
        flags: &[],
        include: Option<&'static Chain<Input>>.None,
        pattern: Option<string<'static>>.None,
      },
    )
  }

  /// Compiles a deferred Objective-C++ file into the package's native inputs.
  pub static fn compileObjectiveCpp(self: Self, source: Deferred<Path>) -> Self {
    return Plan.append(
      self,
      Operation.Compile {
        language: "objcpp",
        source: Deferred<Path>.description(&source),
        flags: &[],
        include: Option<&'static Chain<Input>>.None,
        pattern: Option<string<'static>>.None,
      },
    )
  }

  /// Compiles one translation unit with flags and include directories applying only to that file.
  /// `language` is `c`, `cpp`, `objc`, or `objcpp`. Package-wide flags and includes are also applied.
  pub static fn compileNative(
    self: Self,
    language: string<'static>,
    source: Deferred<Path>,
    flags: &'static [string<'static>],
    include: &'static [Deferred<Path>],
  ) -> Self {
    let mut paths = Option<&'static Chain<Input>>.None
    let mut at: usize = 0
    while at < include.length {
      paths = Chain<Input>.append(paths, Deferred<Path>.description(&include[at]))
      at = at + 1
    }
    return Plan.append(
      self,
      Operation.Compile {
        language: language,
        source: Deferred<Path>.description(&source),
        flags: flags,
        include: paths,
        pattern: Option<string<'static>>.None,
      },
    )
  }

  /// Compiles matching files from a declared directory with flags and include paths for those files.
  /// Resolution expands the glob after any producer or pinned archive has supplied the directory.
  pub static fn compileSources(
    self: Self,
    language: string<'static>,
    directory: Deferred<Path>,
    pattern: string<'static>,
    flags: &'static [string<'static>],
    include: &'static [Deferred<Path>],
  ) -> Self {
    let mut paths = Option<&'static Chain<Input>>.None
    let mut at: usize = 0
    while at < include.length {
      paths = Chain<Input>.append(paths, Deferred<Path>.description(&include[at]))
      at = at + 1
    }
    return Plan.append(
      self,
      Operation.Compile {
        language: language,
        source: Deferred<Path>.description(&directory),
        flags: flags,
        include: paths,
        pattern: Option<string<'static>>.Some { value: pattern },
      },
    )
  }

  /// Adds one allowed native compiler flag to this package's translation units.
  pub static fn cFlag(self: Self, value: string<'static>) -> Self {
    return Plan.append(self, Operation.Flag { value: value })
  }

  /// Adds an include directory to this package's native translation units.
  pub static fn includePath(self: Self, path: Deferred<Path>) -> Self {
    return Plan.append(self, Operation.Include { path: Deferred<Path>.description(&path) })
  }

  /// Links a deferred static archive.
  pub static fn linkArchive(self: Self, path: Deferred<Path>) -> Self {
    return Plan.append(
      self,
      Operation.LinkFile { kind: "archive", path: Deferred<Path>.description(&path) },
    )
  }

  /// Links a deferred object file.
  pub static fn linkObject(self: Self, path: Deferred<Path>) -> Self {
    return Plan.append(
      self,
      Operation.LinkFile { kind: "object", path: Deferred<Path>.description(&path) },
    )
  }

  /// Adds a deferred library search directory.
  pub static fn searchPath(self: Self, path: Deferred<Path>) -> Self {
    return Plan.append(
      self,
      Operation.LinkFile { kind: "search-path", path: Deferred<Path>.description(&path) },
    )
  }

  /// Adds a deferred framework search directory.
  pub static fn frameworkSearchPath(self: Self, path: Deferred<Path>) -> Self {
    return Plan.append(
      self,
      Operation.LinkFile { kind: "framework-search-path", path: Deferred<Path>.description(&path) },
    )
  }

  /// Supplies a deferred native linker script.
  pub static fn linkerScript(self: Self, path: Deferred<Path>) -> Self {
    return Plan.append(
      self,
      Operation.LinkFile { kind: "linker-script", path: Deferred<Path>.description(&path) },
    )
  }

  /// Links a named library as `library` describes, for example `Library.dynamicSearch()`.
  pub static fn linkLibrary(self: Self, name: string<'static>, library: Library) -> Self {
    return Plan.append(
      self,
      Operation.Link {
        kind: "library",
        name: name,
        mode: library.mode,
        weak: library.isWeak,
        needed: library.isNeeded,
      },
    )
  }

  /// Links the native plan of `name`, a dependency this package declares, into every artifact that
  /// links this package, even when nothing imports it: for a package of only C, whose functions
  /// this package declares itself. A name the manifest does not declare refuses the plan.
  pub static fn linkDependency(self: Self, name: string<'static>) -> Self {
    return Plan.append(self, Operation.LinkDependency { name: name })
  }

  /// Links a named macOS framework as `framework` describes, for example `Framework.make()`.
  pub static fn linkFramework(self: Self, name: string<'static>, framework: Framework) -> Self {
    return Plan.append(
      self,
      Operation.Link {
        kind: "framework",
        name: name,
        mode: "",
        weak: framework.isWeak,
        needed: framework.isNeeded,
      },
    )
  }

  /// Adds a runtime library search path.
  pub static fn rpath(self: Self, value: string<'static>) -> Self {
    return Plan.append(self, Operation.RPath { value: value })
  }

  /// Selects a deferred native symbol-order file.
  pub static fn functionOrder(self: Self, path: Deferred<Path>) -> Self {
    return Plan.append(self, Operation.FunctionOrder { path: Deferred<Path>.description(&path) })
  }
}
