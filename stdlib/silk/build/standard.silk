//! Materializes immutable standard action descriptions through the ordinary step interface.

import silk.build.descriptor { Action, Chain, File }
import silk.build.run { Run }
import silk.build.write_files { WriteFiles }
import silk.build.step { Link, Provision, StepDescription, StepHandle, StepFailure, StepError }
import silk.schema.json { SchemaJson }
import silk.num.usize
import silk.build.compilation as Compilations
import silk.build.embed as Embed
import silk.build.package as Packages
import silk.build.run as Runs
import silk.build.write_files as Files
import silk.system.filesystem { FileSystem }
import silk.text.string { String }
import silk.core.option { Option }
import silk.mem.allocator { Allocator }

/// Registers a standard action without executing it or reading its inputs.
pub effect fn register(action: &Action) -> StepHandle ! StepFailure ? &mut Allocator {
  return match &action.* {
    Action.Run {invocation} => run Run.fromDescription(invocation).registerHere()
    Action.WriteFiles {files} => {
      let written = run generated(WriteFiles.make(), files)
      run written.registerHere()
    }
  }
}

effect fn generated(current: WriteFiles, files: Option<&'static Chain<File>>) -> WriteFiles
! StepFailure ? &mut Allocator {
  if let Option<&'static Chain<File>>.Some {value} = files {
    let previous = run generated(move current, value.previous)
    return run previous.text(value.value.name, value.value.content)
  }
  return move current
}

/// Restores a described standard step by its kind as a step this process can run.
pub effect fn restore(kind: string, step: &[u8]) -> StepHandle
  ! StepFailure
  ? &mut Allocator | &mut FileSystem {
  if kind == "files" {
    return run Files.restore(step)
  }
  if kind == "embed" {
    return run Embed.restore(step)
  }
  if kind == "process" {
    return run Runs.restore(step)
  }
  if kind == "package-path" {
    return run Packages.restorePath(step)
  }
  if kind == "compilation" {
    return run Compilations.restore(step)
  }
  if kind == "provided" {
    return run StepHandle.provided(run SchemaJson.decode<Provision>(step))
  }
  fail StepError { message: run String.copy("unknown standard step in a graph description") }
}

/// Restores every step of a description in this process, so a runner here can run them.
pub effect fn restoreLinks(links: &[Link]) -> ()
  ! StepFailure
  ? &mut Allocator | &mut FileSystem {
  let steps = run StepHandle.linkedSteps(links)
  let listed = steps.asSlice()
  let mut at = usize.ZERO
  while at < listed.length {
    if let Option<StepDescription>.Some { value } = move run listed[at].description() {
      let restored = run restore(value.kind.view(), String.ownedUtf8Bytes(&value.step))
      run listed[at].install(&restored)
    }
    at = at + usize.ONE
  }
}
