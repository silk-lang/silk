//! Materializes immutable standard action descriptions through the ordinary step interface.

import silk.build.descriptor { Action, Chain, File }
import silk.build.run { Run }
import silk.build.write_files { WriteFiles }
import silk.build.step { StepHandle, StepFailure }
import silk.core.option { Option }
import silk.mem.allocator { Allocator }

/// Registers a standard action without executing it or reading its inputs.
pub effect fn register(action: &Action) -> StepHandle ! StepFailure ? &mut Allocator {
  return match &action.* {
    Action.Run {invocation} => run Run.fromDescription(invocation).register()
    Action.WriteFiles {files} => {
      let written = run generated(WriteFiles.make(), files)
      run written.register()
    }
  }
}

effect fn generated(current: WriteFiles, files: Option<&'static Chain<File>>) -> WriteFiles
! StepFailure ? &mut Allocator {
  if let Option<&'static Chain<File>>.Some {value} = files {
    let previous = run generated(move current, value.previous)
    return run previous.text(value.value.name, value.value.content)
  }
  return move current
}
