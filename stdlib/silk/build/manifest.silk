//! Package identities, fetch pins, and publication settings read from `silk.toml`.

import silk.collections.list { List }
import silk.core.option { Option }
import silk.schema.schema { Checks, Dictionary, Schema, Spec }
import silk.schema.shape { Literal }
import silk.text.string { String }
import silk.num.usize

/// Static package and workspace data. Compilation settings belong to the build graph.
pub struct Manifest {
  /// The package at this directory, when it is not a virtual workspace.
  pub package: Option<Package>,
  /// Packages this package may import, keyed by their import aliases.
  pub dependencies: Dictionary<Dependency>,
  /// Workspace membership and shared dependency pins.
  pub workspace: Option<Workspace>,
  /// Downloaded native archives and local replacements.
  pub native: Option<Native>,
  /// The package's WebAssembly component interface and world.
  pub component: Option<Component>,
  /// Runtime composition declarations that travel with the package.
  pub unstable: Option<Unstable>,
  /// Source and binary archive publication settings.
  pub pack: Option<Pack>,
  /// Release publication settings.
  pub release: Option<Release>,
  /// Commands run only when a developer initializes a project from this template.
  pub postInit: Option<List<PostInit>>,
  /// What `silk init` shows after creating a project from this template.
  pub template: Option<Template>,
  /// Input-only configuration owned by external tools; manifest edits preserve its original TOML.
  pub tool: Option<Tool>,
}

impl Schema for Manifest {
  static fn spec() -> Spec<Manifest> {
    return Spec<Manifest>.of() |> Spec<Manifest>.strict() |> Spec<Manifest>.rename("postInit", "post-init")
  }
  fn check(self: &Self, checks: &mut Checks<Self>) -> () {
    checks.that(self.package.isSome() || self.workspace.isSome(), "a package or workspace table")
    checkAliases(&self.dependencies, &mut checks)
  }
}

/// An external tool's table, accepted without interpreting its keys or values.
/// Decoding discards its contents; a manifest editor must preserve the source document.
pub struct Tool {}
impl Schema for Tool {}

/// The interface definition and exported world of a WebAssembly component package.
pub struct Component {
  /// A WIT file or directory relative to this package.
  pub wit: String,
  /// The WIT world to compile.
  pub world: String,
}
impl Schema for Component {
  static fn spec() -> Spec<Component> {
    return Spec<Component>.of() |> Spec<Component>.strict()
      |> Spec<Component>.length("wit", 1, 65536) |> Spec<Component>.length("world", 1, 65536)
  }
}

/// Experimental package declarations whose selected bindings become explicit request inputs.
pub struct Unstable {
  /// Runtime implementations, defaults, and execution-storage bindings.
  pub composition: Option<Composition>,
}
impl Schema for Unstable {
  static fn spec() -> Spec<Unstable> { return Spec<Unstable>.of() |> Spec<Unstable>.strict() }
}

/// Runtime and provider declarations available to compilations of this package.
pub struct Composition {
  /// Named runtime modules declared by the package.
  pub runtimes: Option<List<Runtime>>,
  /// The runtime names selected by default.
  pub defaults: Option<List<String>>,
  /// Execution-storage implementations.
  pub components: Option<List<Capability>>,
  /// Declarations retained regardless of import reachability.
  pub retention: Option<List<Retention>>,
  /// Reserved requirements; the current compiler accepts only an empty list.
  pub requirements: Option<List<String>>,
}
impl Schema for Composition {
  static fn spec() -> Spec<Composition> {
    return Spec<Composition>.of() |> Spec<Composition>.strict() |> Spec<Composition>.items("requirements", 0, 0)
  }
  fn check(self: &Self, checks: &mut Checks<Self>) -> () {
    if let Option<List<String>>.Some {value: defaults} = &self.defaults {
      let names = defaults.asSlice()
      let mut at = usize.ZERO
      while at < names.length {
        let mut found = false
        if let Option<List<Runtime>>.Some {value: runtimes} = &self.runtimes {
          let listed = runtimes.asSlice()
          let mut index = usize.ZERO
          while index < listed.length {
            found = found || listed[index].name.view() == names[at].view()
            index = index + usize.ONE
          }
        }
        checks.that(found, "default runtime names declared in runtimes")
        at = at + usize.ONE
      }
    }
  }
}

/// A named package runtime module.
pub struct Runtime {
  /// The name a compilation selects.
  pub name: String,
  /// The module implementing the runtime.
  pub module: String,
}
impl Schema for Runtime {
  static fn spec() -> Spec<Runtime> {
    return Spec<Runtime>.of() |> Spec<Runtime>.strict()
      |> Spec<Runtime>.length("name", 1, 65536) |> Spec<Runtime>.length("module", 1, 65536)
  }
}

/// A runtime capability supplied by a complete set of declaration bindings.
pub struct Capability {
  /// The supported capability, `execution-storage`.
  pub capability: String,
  /// One binding for each execution-storage operation.
  pub bindings: List<StorageBinding>,
}
impl Schema for Capability {
  static fn spec() -> Spec<Capability> {
    return Spec<Capability>.of() |> Spec<Capability>.strict()
      |> Spec<Capability>.pattern("capability", "^execution-storage$")
      |> Spec<Capability>.items("bindings", 4, 4)
  }
  fn check(self: &Self, checks: &mut Checks<Self>) -> () {
    let bindings = self.bindings.asSlice()
    let mut at = usize.ZERO
    while at < bindings.length {
      let mut previous = usize.ZERO
      while previous < at {
        checks.that(bindings[previous].operation.view() != bindings[at].operation.view(), "one binding per execution-storage operation")
        previous = previous + usize.ONE
      }
      at = at + usize.ONE
    }
  }
}

/// One operation supplied by an execution-storage implementation.
pub struct StorageBinding {
  /// The operation: create, acquire, release, or destroy.
  pub operation: String,
  /// The module declaring the implementation.
  pub module: String,
  /// The implementation's declaration name.
  pub declaration: String,
}
impl Schema for StorageBinding {
  static fn spec() -> Spec<StorageBinding> {
    return Spec<StorageBinding>.of() |> Spec<StorageBinding>.strict()
      |> Spec<StorageBinding>.pattern("operation", "^(create|acquire|release|destroy)$")
      |> Spec<StorageBinding>.length("module", 1, 65536)
      |> Spec<StorageBinding>.pattern("declaration", "^[A-Za-z_][A-Za-z0-9_]*$")
  }
}

/// A declaration kept even when no ordinary source import reaches it.
pub struct Retention {
  /// The module declaring the retained value or function.
  pub module: String,
  /// The declaration name.
  pub declaration: String,
}
impl Schema for Retention {
  static fn spec() -> Spec<Retention> {
    return Spec<Retention>.of() |> Spec<Retention>.strict()
      |> Spec<Retention>.length("module", 1, 65536)
      |> Spec<Retention>.pattern("declaration", "^[A-Za-z_][A-Za-z0-9_]*$")
  }
}

/// A package identity and its source and publication layout.
pub struct Package {
  /// The lowercase package name, distinct from its local import aliases.
  pub name: String,
  /// The full semantic version; absent versions are `0.0.0`.
  pub version: String,
  /// The compiler version selected by the launcher.
  pub silkVersion: Option<String>,
  /// The module root, resolved relative to the package directory.
  pub source: String,
  /// The root module relative to `source`; absent roots use `main.silk` or `lib.silk`.
  pub main: Option<String>,
  /// Whether the default command builds an executable or checks a library.
  pub kind: String,
  /// Canonical module names that other packages may import.
  pub exports: Option<List<String>>,
  /// The package description.
  pub description: Option<String>,
  /// The license identifier.
  pub license: Option<String>,
  /// The source repository URL.
  pub repository: Option<String>,
  /// The project website URL.
  pub homepage: Option<String>,
  /// Author names.
  pub authors: Option<List<String>>,
  /// Discovery keywords.
  pub keywords: Option<List<String>>,
  /// The README path relative to the package directory.
  pub readme: Option<String>,
  /// Additional packaged files and directories, also available through `Package.path`.
  pub include: Option<List<String>>,
  /// Whether this package may be published.
  pub publish: bool,
}

impl Schema for Package {
  static fn spec() -> Spec<Package> {
    return Spec<Package>.of() |> Spec<Package>.strict()
      |> Spec<Package>.pattern("name", "^[a-z][a-z0-9_-]*$")
      |> Spec<Package>.default("version", Literal.Text {value: "0.0.0"})
      |> Spec<Package>.rename("silkVersion", "silk-version")
      |> Spec<Package>.pattern("version", "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$")
      |> Spec<Package>.pattern("silkVersion", "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$")
      |> Spec<Package>.default("source", Literal.Text {value: "src"})
      |> Spec<Package>.length("source", 1, 65536)
      |> Spec<Package>.default("kind", Literal.Text {value: "executable"})
      |> Spec<Package>.pattern("kind", "^(executable|library)$")
      |> Spec<Package>.default("publish", Literal.Boolean {value: true})
  }
  fn check(self: &Self, checks: &mut Checks<Self>) -> () {
    let name = self.name.view()
    checks.that(name != "self" && name != "silk" && name != "silkc", "a package name other than self, silk, or silkc")
  }
}

/// One path, pinned Git commit, pinned archive, or workspace catalog entry.
pub struct Dependency {
  /// A local directory, or a subdirectory of the fetched repository or archive.
  pub path: Option<String>,
  /// The selected package name when it differs from the import alias.
  pub package: Option<String>,
  /// A Git repository URL.
  pub git: Option<String>,
  /// A complete lowercase Git commit hash.
  pub rev: Option<String>,
  /// An HTTPS or local file archive URL.
  pub url: Option<String>,
  /// The archive's lowercase SHA-256 digest.
  pub sha256: Option<String>,
  /// Selects the same alias from the enclosing workspace catalog.
  pub workspace: Option<bool>,
  /// Explicitly authorizes this dependency's sandboxed build tools.
  pub tools: bool,
}

impl Schema for Dependency {
  static fn spec() -> Spec<Dependency> {
    return Spec<Dependency>.of() |> Spec<Dependency>.strict()
      |> Spec<Dependency>.pattern("rev", "^([0-9a-f]{40}|[0-9a-f]{64})$")
      |> Spec<Dependency>.pattern("sha256", "^[0-9a-f]{64}$")
      |> Spec<Dependency>.pattern("url", "^(https://|file:///)")
      |> Spec<Dependency>.length("path", 1, 65536)
      |> Spec<Dependency>.length("git", 1, 65536)
      |> Spec<Dependency>.default("tools", Literal.Boolean {value: false})
  }
  fn check(self: &Self, checks: &mut Checks<Self>) -> () {
    let local = self.path.isSome() && !self.git.isSome() && !self.rev.isSome() && !self.url.isSome() && !self.sha256.isSome()
    let git = self.git.isSome() && self.rev.isSome() && !self.url.isSome() && !self.sha256.isSome()
    let archive = self.url.isSome() && self.sha256.isSome() && !self.git.isSome() && !self.rev.isSome()
    let workspace = match &self.workspace {
      Option<bool>.Some {value} => value
      Option<bool>.None => false
    }
    if self.workspace.isSome() {
      checks.that(workspace && !self.path.isSome() && !self.package.isSome() && !self.git.isSome()
        && !self.rev.isSome() && !self.url.isSome() && !self.sha256.isSome(), "workspace = true without a second source")
    } else {
      checks.that(local || git || archive, "a path, a Git URL and revision, or an archive URL and SHA-256")
    }
  }
}

/// A workspace's member paths, output directory, and dependency catalog.
pub struct Workspace {
  /// Package directories or globs relative to this manifest.
  pub members: List<String>,
  /// The build output directory relative to the workspace root.
  pub outputDir: String,
  /// The compiler version selected for workspace members.
  pub silkVersion: Option<String>,
  /// Fully specified dependency sources shared by workspace members.
  pub dependencies: Dictionary<Dependency>,
}
impl Schema for Workspace {
  static fn spec() -> Spec<Workspace> {
    return Spec<Workspace>.of() |> Spec<Workspace>.strict()
      |> Spec<Workspace>.rename("outputDir", "output-dir")
      |> Spec<Workspace>.rename("silkVersion", "silk-version")
      |> Spec<Workspace>.pattern("silkVersion", "^(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)\\.(0|[1-9][0-9]*)(-((0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*)(\\.(0|[1-9][0-9]*|[0-9]*[A-Za-z-][0-9A-Za-z-]*))*))?(\\+[0-9A-Za-z-]+(\\.[0-9A-Za-z-]+)*)?$")
      |> Spec<Workspace>.default("outputDir", Literal.Text {value: "build"})
  }
  fn check(self: &Self, checks: &mut Checks<Self>) -> () {
    checkAliases(&self.dependencies, &mut checks)
    let entries = self.dependencies.entries()
    let mut at = usize.ZERO
    while at < entries.length {
      checks.that(!entries[at].value.workspace.isSome(), "a fully specified workspace dependency source")
      at = at + usize.ONE
    }
  }
}

fn checkAliases<T>(dependencies: &Dictionary<Dependency>, checks: &mut Checks<T>) -> () {
  let entries = dependencies.entries()
  let mut at = usize.ZERO
  while at < entries.length {
    let name = entries[at].key.view()
    let bytes = String.utf8Bytes(name)
    let mut valid = bytes.length > usize.ZERO && name != "self" && name != "silk" && name != "silkc" && name != "Intrinsic"
    let mut index = usize.ZERO
    while index < bytes.length {
      let byte = bytes[index]
      valid = valid && ((byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95
        || (index > usize.ZERO && byte >= 48 && byte <= 57))
      index = index + usize.ONE
    }
    checks.that(valid, "dependency aliases that are identifiers other than self, silk, silkc, or Intrinsic")
    at = at + usize.ONE
  }
}

/// Native files fetched from pinned archives; compilation and linking are graph operations.
pub struct Native {
  /// Archives keyed by their package-local names.
  pub archive: Dictionary<Archive>,
  /// Local archive replacements keyed by the same names.
  pub overrides: Dictionary<ArchiveOverride>,
}
impl Schema for Native {
  static fn spec() -> Spec<Native> {
    return Spec<Native>.of() |> Spec<Native>.strict() |> Spec<Native>.rename("overrides", "override")
  }
}

/// One portable archive pin or a table of pins selected by target triple.
pub struct Archive {
  /// The portable archive URL, absent when using target-specific pins.
  pub url: Option<String>,
  /// The portable archive digest.
  pub sha256: Option<String>,
  /// The number of directory components removed during extraction.
  pub strip: Option<u32>,
  /// Target-specific archive pins.
  pub targets: Dictionary<ArchivePin>,
}
impl Schema for Archive {
  static fn spec() -> Spec<Archive> {
    return Spec<Archive>.of() |> Spec<Archive>.strict()
      |> Spec<Archive>.pattern("url", "^(https://|file:///)")
      |> Spec<Archive>.pattern("sha256", "^[0-9a-fA-F]{64}$")
      |> Spec<Archive>.between("strip", 0, 99)
  }
  fn check(self: &Self, checks: &mut Checks<Self>) -> () {
    let portable = self.url.isSome() && self.sha256.isSome() && self.targets.entries().length == usize.ZERO
    let targeted = !self.url.isSome() && !self.sha256.isSome() && !self.strip.isSome() && self.targets.entries().length > usize.ZERO
    checks.that(portable || targeted, "one archive URL and digest, or target-specific pins")
  }
}

/// The verified archive downloaded for one target.
pub struct ArchivePin {
  /// An HTTPS or local file URL.
  pub url: String,
  /// The SHA-256 digest of the downloaded bytes.
  pub sha256: String,
  /// Directory components removed during extraction.
  pub strip: u32,
}
impl Schema for ArchivePin {
  static fn spec() -> Spec<ArchivePin> {
    return Spec<ArchivePin>.of() |> Spec<ArchivePin>.strict()
      |> Spec<ArchivePin>.pattern("url", "^(https://|file:///)")
      |> Spec<ArchivePin>.pattern("sha256", "^[0-9a-fA-F]{64}$")
      |> Spec<ArchivePin>.between("strip", 0, 99)
      |> Spec<ArchivePin>.default("strip", Literal.Integer {value: 0})
  }
}

/// A developer's local replacement for a downloaded native archive.
pub struct ArchiveOverride {
  /// The local installation directory.
  pub path: String,
}
impl Schema for ArchiveOverride {
  static fn spec() -> Spec<ArchiveOverride> {
    return Spec<ArchiveOverride>.of() |> Spec<ArchiveOverride>.strict() |> Spec<ArchiveOverride>.length("path", 1, 65536)
  }
}

/// Optional binary archives published beside the source archive.
pub struct Pack {
  /// Enables binary publication and configures its layout.
  pub binary: Option<Binary>,
}
impl Schema for Pack {
  static fn spec() -> Spec<Pack> { return Spec<Pack>.of() |> Spec<Pack>.strict() }
}

/// Default binary archive settings and target-specific overrides.
pub struct Binary {
  /// Archive format: `tar.gz` or `zip`.
  pub format: String,
  /// Executable placement: `bin` or `flat`.
  pub layout: String,
  /// Additional paths copied into every binary archive.
  pub include: Option<List<String>>,
  /// Settings that replace the defaults for each named target.
  pub target: Dictionary<BinaryTarget>,
}
impl Schema for Binary {
  static fn spec() -> Spec<Binary> {
    return Spec<Binary>.of() |> Spec<Binary>.strict()
      |> Spec<Binary>.pattern("format", "^(tar\\.gz|zip)$")
      |> Spec<Binary>.default("format", Literal.Text {value: "tar.gz"})
      |> Spec<Binary>.pattern("layout", "^(bin|flat)$")
      |> Spec<Binary>.default("layout", Literal.Text {value: "bin"})
  }
}

/// Binary archive settings replaced for one target; absent fields retain the defaults.
pub struct BinaryTarget {
  /// The replacement archive format.
  pub format: Option<String>,
  /// The replacement executable placement.
  pub layout: Option<String>,
  /// The replacement list of additional files.
  pub include: Option<List<String>>,
}
impl Schema for BinaryTarget {
  static fn spec() -> Spec<BinaryTarget> {
    return Spec<BinaryTarget>.of() |> Spec<BinaryTarget>.strict()
      |> Spec<BinaryTarget>.pattern("format", "^(tar\\.gz|zip)$")
      |> Spec<BinaryTarget>.pattern("layout", "^(bin|flat)$")
  }
}

/// Release repository and version-source settings.
pub struct Release {
  /// The GitHub repository as owner/name.
  pub repository: Option<String>,
  /// The release directory relative to the repository root.
  pub directory: Option<String>,
  /// A Silk version constant source file outside `.changes`.
  pub versionFile: Option<String>,
}
impl Schema for Release {
  static fn spec() -> Spec<Release> {
    return Spec<Release>.of() |> Spec<Release>.strict() |> Spec<Release>.rename("versionFile", "version-file")
      |> Spec<Release>.pattern("repository", "^(?!\\.{1,2}/)[A-Za-z0-9_.-]+/(?!\\.{1,2}$)[A-Za-z0-9_.-]+$")
      |> Spec<Release>.pattern("directory", "^(?:(?!\\.{1,2}(?:/|$))[^/\\\\\\u0000-\\u001f\\u007f]+(?:/(?!\\.{1,2}(?:/|$))[^/\\\\\\u0000-\\u001f\\u007f]+)*)?$")
      |> Spec<Release>.pattern("versionFile", "^(?!.*(?:^|/)(?:\\.{1,2}|\\.[cC][hH][aA][nN][gG][eE][sS])(?:/|$))[^/:\\\\\\u0000-\\u001f\\u007f]+(?:/[^/:\\\\\\u0000-\\u001f\\u007f]+)*\\.silk$")
  }
}

/// Settings read only when `silk init` creates a project from this manifest's directory; the new
/// project's manifest does not keep them.
pub struct Template {
  /// The commands `silk init` suggests running in the new project, in order, after `cd` into it;
  /// empty to suggest nothing.
  pub nextSteps: Option<List<String>>,
}
impl Schema for Template {
  static fn spec() -> Spec<Template> {
    return Spec<Template>.of() |> Spec<Template>.strict() |> Spec<Template>.rename("nextSteps", "next-steps")
  }
}

/// A template command run only by an explicit `silk init` invocation.
pub struct PostInit {
  /// The executable followed by its arguments.
  pub command: List<String>,
  /// Whether to append arguments passed to `silk init` after `--`.
  pub arguments: bool,
}
impl Schema for PostInit {
  static fn spec() -> Spec<PostInit> {
    return Spec<PostInit>.of() |> Spec<PostInit>.strict()
      |> Spec<PostInit>.rename("command", "run") |> Spec<PostInit>.items("command", 1, 65536)
      |> Spec<PostInit>.default("arguments", Literal.Boolean {value: false})
  }
}
