//! The standard tasks a project's tasks.silk starts from: build, run, dev and plan.
//!
//! `silk init` writes a tasks.silk whose `Build`, `Run`, `Dev` and `Plan` variants each call one
//! function here with the project's own compilation, so a setting the project makes once reaches
//! every command and the editor. Each variant embeds [`Options`], which gives it `--release`,
//! `--optimization none|speed|size`, `--target <triple>` and `--debug true|false`. `silk test`
//! stays the toolchain's own command.
//!
//! # Examples
//! ```silk
//! import silk.build.graph { Compilation, Options, BuildError }
//! import silk.build.tasks { Standard, StandardError }
//! import silk.cli.command { Command, CommandLine, Opt }
//! import silk.cli.task { Task, TaskSet }
//! import silk.collections.list { List }
//! import silk.mem.allocator { Allocator }
//! import silk.system.child_process { ChildProcess }
//! import silk.system.filesystem { FileSystem }
//! import silk.system.host_input { HostInput }
//! import silk.text.string { String }
//!
//! union Tasks {
//!   Build { pub options: Options, pub out: String },
//!   Run { pub options: Options, pub arguments: List<String> },
//!   Dev { pub options: Options, pub arguments: List<String> },
//!   Plan { pub options: Options },
//! }
//!
//! impl CommandLine for Tasks {
//!   static fn command() -> Command<Tasks> {
//!     return Command<Tasks>.make("tasks", "Build and run the program")
//!       |> Command.variant("Build", "Build the program (use --release to optimize)")
//!       |> Command.variant("Run", "Build the program and run it")
//!       |> Command.variant("Dev", "Run the program, and restart it when a source changes")
//!       |> Command.variant("Plan", "Write the editor compilation requests")
//!       |> Command.flatten("options")
//!       |> Command.option("out", Opt.about("Also copy the program to this directory"))
//!       |> Command.arg("arguments", Opt.about("Arguments for the program, after --"))
//!   }
//! }
//!
//! effect fn compilation(options: &Options) -> Compilation
//!   ! BuildError
//!   ? &mut Allocator | &mut FileSystem | &mut HostInput {
//!   return run Compilation.fromPackage(options)
//! }
//!
//! impl TaskSet for Tasks {
//!   effect fn perform(self: Tasks) -> ()
//!     ! StandardError
//!     ? &mut HostInput | &mut Allocator | &mut ChildProcess | &mut FileSystem {
//!     match move self {
//!       Tasks.Build { options, out } => run Standard.build(run compilation(&options), out.view())
//!       Tasks.Run { options, arguments } => {
//!         run Standard.start(run compilation(&options), &options, &arguments)
//!       }
//!       Tasks.Dev { options, arguments } => run Standard.dev(&options, &arguments)
//!       Tasks.Plan { options } => run Standard.plan(run compilation(&options))
//!     }
//!   }
//! }
//!
//! pub effect fn main() -> i32 ? &mut HostInput {
//!   return run Task.main<Tasks>()
//! }
//! ```
//!
//! @category Build

import silk.build.graph { Build, BuildError, Compilation, Planned }
import silk.build.options { Options, Optimize }
import silk.cli.task { Task, TaskError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.io.writer { WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.child_process { ProcessError }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.system.host_input { HostInput, HostInputError }
import silk.text.string { String }

static if Intrinsic.targetOperatingSystem() == "darwin"
  || Intrinsic.targetOperatingSystem() == "linux" {
  import silk.build.watch as Watch
}

/// Every failure a standard task can end with, for the `perform` of a tasks program whose variants
/// call [`Standard`]: a failed build, a program that ended with a nonzero status, or a file,
/// process, environment, memory or output failure.
pub type StandardError = BuildError
  | TaskError
  | ProcessError
  | FileError
  | HostInputError
  | OutOfMemoryError
  | WriterError

/// The standard tasks. Each takes the project's compilation, made from the command's [`Options`],
/// so that one function of the project configures every task.
pub struct Standard {}

impl Standard {
  /// Builds `compilation`. Its artifacts stay at `build/<target>/<mode>/<name>`. When `out` is not
  /// empty, they are also copied to the directory `out`, relative to the package directory, keeping
  /// their names and permissions.
  ///
  /// # Errors
  /// [`BuildError`] when the compilation or one of its steps fails.
  pub effect fn build(compilation: Compilation, out: string) -> ()
    ! BuildError
    ? &mut Allocator | &mut FileSystem | &mut HostInput {
    let graph = run (run Build.make()).add(move compilation)
    let built = run graph.compile()
    if out != "" {
      drop run built.write(out)
    }
  }

  /// Builds `compilation` and runs its program with `arguments`, sharing the task's terminal and
  /// environment, and waits for it. `options` are the ones `compilation` was made from: a
  /// `--target` this machine cannot run is refused before anything is built.
  ///
  /// # Errors
  /// [`BuildError`] when the build fails; [`TaskError`] with the program's status when it ends
  /// with a nonzero one, or status 2 for a target this machine cannot run.
  pub effect fn start(compilation: Compilation, options: &Options, arguments: &List<String>) -> ()
    ! BuildError | TaskError
    ? &mut Allocator | &mut FileSystem | &mut HostInput {
    let targets = options.target.asSlice()
    if targets.length == 1 && !runnable(targets[0].view()) {
      drop compilation
      let mut message = run String.copy("cannot run a program built for ")
      run message.append(targets[0].view())
      run message.append(" on this machine; build it with `silk build` instead")
      fail TaskError { message: move message, status: 2 }
    }
    let graph = run (run Build.make()).add(move compilation)
    let built = run graph.compile()
    let given = arguments.asSlice()
    let mut words = List<string>.make()
    let mut at: usize = 0
    while at < given.length {
      run words.append(given[at].view())
      at = at + 1
    }
    run built.launch(words.asSlice())
  }

  /// Writes the editor's compilation requests for `compilation` to `build/requests/`, without
  /// compiling it.
  ///
  /// # Errors
  /// [`BuildError`] when a step the requests need fails.
  pub effect fn plan(compilation: Compilation) -> ()
    ! BuildError
    ? &mut Allocator | &mut FileSystem | &mut HostInput {
    let graph = run (run Build.make()).add(move compilation)
    let planned: Planned = run graph.write()
    drop planned
  }

  /// Runs the project as `silk run` does, with `options` and `arguments`, and restarts it each time
  /// a file under the package's `src/` or its `silk.toml` changes. A build that fails is reported
  /// and the next change tries again. It ends when the task is stopped, such as with Control-C,
  /// and stops the program first. It needs macOS or Linux.
  ///
  /// # Errors
  /// [`TaskError`] when `SILK_COMPILER` or `SILK_PROJECT_ROOT` is not set, as outside `silk`, on
  /// another system, or when the program cannot be started.
  pub effect fn dev(options: &Options, arguments: &List<String>) -> ()
    ! TaskError | FileError | HostInputError | OutOfMemoryError
    ? &mut Allocator | &mut FileSystem | &mut HostInput {
    let compiler = match move run HostInput.variableNamed("SILK_COMPILER") {
      Option<Bytes>.Some { value } => move value
      Option<Bytes>.None => run Task.abort("SILK_COMPILER is not set; run this with `silk dev`")
    }
    let root = run Task.root()
    let mut words = List<Bytes>.make()
    run words.append(run Bytes.copy(b"run"))
    run carried(&mut words, "SILK_STDLIB", b"--stdlib")
    run carried(&mut words, "SILK_CLANG", b"--clang")
    run carried(&mut words, "SILK_BACKEND", b"--backend")
    run carried(&mut words, "SILK_PROGRESS", b"--progress")
    run append(&mut words, options)
    if arguments.length() != 0 {
      run words.append(run Bytes.copy(b"--"))
      let given = arguments.asSlice()
      let mut at: usize = 0
      while at < given.length {
        run words.append(run Bytes.copy(String.utf8Bytes(given[at].view())))
        at = at + 1
      }
    }
    let program = run Path.fromBytes(compiler.asSlice())
    static if Intrinsic.targetOperatingSystem() == "darwin"
      || Intrinsic.targetOperatingSystem() == "linux" {
      let sources = run Watch.packageSources(&root)
      let status = run Watch.restarting(&program, words.asSlice(), &root, sources.asSlice())
      if status != 0 {
        fail TaskError {
          message: run String.copy("the development run was stopped"),
          status: status,
        }
      }
    } else {
      drop program
      drop root
      run Task.abort("`silk dev` restarts programs only on macOS and Linux")
    }
  }
}

const HOST_SYSTEM: string<'static> = Intrinsic.targetOperatingSystem()
const HOST_ARCHITECTURE: string<'static> = Intrinsic.targetArchitecture()

// Whether a program built for `target` runs here: this machine's own, or WASI under wasmtime.
fn runnable(target: string) -> bool {
  if target == "host" || target == "wasm32-wasip1" || target == "wasm32-wasip2" {
    return true
  }
  if !String.startsWith(target, HOST_ARCHITECTURE) {
    return false
  }
  return if HOST_SYSTEM == "darwin" {
    String.endsWith(target, "-apple-darwin")
  } else if HOST_SYSTEM == "windows" {
    String.contains(target, "-windows")
  } else {
    String.contains(target, "-linux")
  }
}

// The words that select `options` again on a `silk` command line.
effect fn append(words: &mut List<Bytes>, options: &Options) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let targets = options.target.asSlice()
  let mut at: usize = 0
  while at < targets.length {
    run words.append(run Bytes.copy(b"--target"))
    run words.append(run Bytes.copy(String.utf8Bytes(targets[at].view())))
    at = at + 1
  }
  if options.optimize != Optimize.None {
    run words.append(run Bytes.copy(b"--optimization"))
    run words.append(run Bytes.copy(String.utf8Bytes(options.optimize.text())))
  }
  if let Option<bool>.Some { value } = options.debug {
    run words.append(run Bytes.copy(b"--debug"))
    run words.append(
      run Bytes.copy(
        if value {
          b"true"
        } else {
          b"false"
        },
      ),
    )
  }
  if options.unsandboxedTools {
    run words.append(run Bytes.copy(b"--unsandboxed-tools"))
  }
}

// The compiler's own option `flag`, again, when the compiler that started the tasks passed it as
// the environment variable `name`.
effect fn carried(words: &mut List<Bytes>, name: string, flag: &[u8]) -> ()
  ! HostInputError | OutOfMemoryError
  ? &mut Allocator | &mut HostInput {
  if let Option<Bytes>.Some { value } = move run HostInput.variableNamed(name) {
    if value.length() != 0 {
      run words.append(run Bytes.copy(flag))
      run words.append(move value)
    }
  }
}
