//! Selects the LLVM tools used by a compiler installation and by build-cache fingerprints.

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.option { Option }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.system.executable as Executable
import silk.system.host_path as HostPath
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.system.host_input { HostInput, HostInputError }
import silk.text.string { String }
import silk.num.usize

static if Intrinsic.targetOperatingSystem() == "windows" {
  import silk.platform.windows.host_path as WindowsHostPath
  import silk.platform.windows.path { WindowsPath }
  import silk.collections.list { List }
  import silk.mem.pointer { Pointer }
  @foreign(noCapture: ("newName", "existing", "security"))
  unsafe extern "C" fn CreateHardLinkW(
    newName: ?[*]const u16,
    existing: ?[*]const u16,
    security: ?*mut u8,
  ) -> i32
} else static if Intrinsic.targetOperatingSystem() == "linux"
  || Intrinsic.targetOperatingSystem() == "darwin" {
  import silk.mem.pointer { Pointer }
  @foreign(noCapture: ("target", "path"))
  unsafe extern "C" fn symlink(target: ?[*]const u8, path: ?[*]const u8) -> i32
}

/// Tool names supplied by Silk's LLVM installation.
pub const TOOLS: [string<'static>; 9] = [
  "clang",
  "ld.lld",
  "ld64.lld",
  "wasm-ld",
  "lld-link",
  "llvm-ar",
  "llvm-dlltool",
  "llvm-rc",
  "llvm-link",
]

/// Selects an explicit Clang, `SILK_CLANG`, the compiler's bundled LLVM, or `clang` on `PATH`.
/// The compiler path identifies the installation even when this function runs in a task program.
pub effect fn compiler(executable: &Path, selected: Option<&[u8]>) -> Option<Path>
  ! FileError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut FileSystem | &mut Allocator {
  if let Option<&[u8]>.Some { value } = move selected {
    return run selectedPath(value)
  }
  if let Option<Bytes>.Some { value } = move run HostInput.variableNamed("SILK_SELECTED_CLANG") {
    if value.length() > 0 {
      return run selectedPath(value.asSlice())
    }
  }
  if let Option<Bytes>.Some { value } = move run HostInput.variableNamed("SILK_CLANG") {
    return run selectedPath(value.asSlice())
  }
  if let Option<Path>.Some { value } = move run bundled(executable) {
    return Option<Path>.some(move value)
  }
  return run Executable.find("clang")
}

effect fn selectedPath(value: &[u8]) -> Option<Path>
  ! FileError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut FileSystem | &mut Allocator {
  let mut explicit = false
  let mut at: usize = 0
  while at < value.length {
    if value[at] == 47 || value[at] == 92 {
      explicit = true
    }
    at = at + 1
  }
  if !explicit {
    return run Executable.findBytes(value)
  }
  static if Intrinsic.targetOperatingSystem() == "windows" {
    let cwd = run HostInput.workingDirectory()
    let root = run WindowsPath.fromNativeBytes(cwd.asSlice())
    return Option<Path>.some(run WindowsPath.resolveBytes(&root, value))
  } else {
    if value.length > 0 && value[0] == 47 {
      return Option<Path>.some(run Path.fromBytes(value))
    }
    let cwd = run HostInput.workingDirectory()
    let root = run Path.fromBytes(cwd.asSlice())
    return Option<Path>.some(run Path.joinBytes(&root, value))
  }
}

/// Selects `SILK_LLVM_AR`, or the archiver beside the selected Clang.
pub effect fn archiver(clang: &Path) -> Option<Path>
  ! FileError | HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut FileSystem | &mut Allocator {
  if let Option<Bytes>.Some { value } = move run HostInput.variableNamed("SILK_LLVM_AR") {
    return run selectedPath(value.asSlice())
  }
  return Option<Path>.some(run companion(clang, "llvm-ar"))
}

/// Returns a tool beside Clang, including the Windows executable suffix when needed.
pub effect fn companion(clang: &Path, name: string) -> Path
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let directory = match move run Path.parent(clang) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => run Path.root()
  }
  let mut file = run String.copy(name)
  static if Intrinsic.targetOperatingSystem() == "windows" {
    run file.append(".exe")
  }
  return run Path.join(&directory, file.view())
}

// Resolve the compiler's symlinks, then locate and materialize its bundled LLVM tool names.
effect fn bundled(executable: &Path) -> Option<Path>
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let canonical = match move run HostPath.canonicalBytes(Path.rawBytes(executable)) {
    Option<Bytes>.Some { value } => run Path.fromBytes(value.asSlice())
    Option<Bytes>.None => {
      return Option<Path>.none()
    }
  }
  let bin = match move run Path.parent(&canonical) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => {
      return Option<Path>.none()
    }
  }
  let prefix = match move run Path.parent(&bin) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => {
      return Option<Path>.none()
    }
  }
  let directory = run Path.join(&prefix, "lib/silk/llvm/bin")
  let multicall = run companion(&run Path.join(&directory, "clang"), "llvm")
  if !run FileSystem.exists(&multicall) {
    return Option<Path>.none()
  }
  let mut at: usize = 0
  while at < TOOLS.length {
    let tool = run companion(&multicall, TOOLS[at])
    if !run FileSystem.exists(&tool) {
      if TOOLS[at] == "llvm-link" {
        return Option<Path>.none()
      }
      if !run linkTool(Path.rawBytes(&multicall), Path.rawBytes(&tool)) {
        if !run FileSystem.exists(&tool) {
          return Option<Path>.none()
        }
      }
    }
    at = at + 1
  }
  return Option<Path>.some(run companion(&multicall, "clang"))
}

static if Intrinsic.targetOperatingSystem() == "windows" {
  effect fn pathOf(text: &[u8]) -> Option<Path>
    ! OutOfMemoryError
    ? &mut Allocator {
    return match move run Effect.result(Path.fromBytes(text)) {
      Result<Path, FileError | OutOfMemoryError>.Success { value } => Option<Path>.some(move value)
      Result<Path, FileError | OutOfMemoryError>.Failure { error } => match move error {
        FileError _invalid => Option<Path>.none()
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
      }
    }
  }
}

// Makes `tool` run the multicall executable at `multicall`, in the same directory: a relative
// symbolic link on Unix, so the installation can move, and a hard link on Windows.
static if Intrinsic.targetOperatingSystem() == "windows" {
  effect fn linkTool(multicall: &[u8], tool: &[u8]) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    let existing = match move run pathWide(multicall) {
      Option<List<u16>>.Some { value } => move value
      Option<List<u16>>.None => {
        return false
      }
    }
    let created = match move run pathWide(tool) {
      Option<List<u16>>.Some { value } => move value
      Option<List<u16>>.None => {
        return false
      }
    }
    return unsafe CreateHardLinkW(
      Pointer.fromSlice(List<u16>.asSlice(&created)),
      Pointer.fromSlice(List<u16>.asSlice(&existing)),
      Pointer.null<u8>(),
    )
      != 0
  }

  effect fn pathWide(text: &[u8]) -> Option<List<u16>>
    ! OutOfMemoryError
    ? &mut Allocator {
    let parsed = match move run pathOf(text) {
      Option<Path>.Some { value } => move value
      Option<Path>.None => {
        return Option<List<u16>>.none()
      }
    }
    return run WindowsHostPath.wide(&parsed)
  }
} else static if Intrinsic.targetOperatingSystem() == "linux"
  || Intrinsic.targetOperatingSystem() == "darwin" {
  effect fn linkTool(multicall: &[u8], tool: &[u8]) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    let _beside = multicall
    let ending: [u8; 1] = [0]
    let mut target = run Bytes.copy(b"llvm")
    run Bytes.append(&mut target, &ending)
    let mut path = run Bytes.copy(tool)
    run Bytes.append(&mut path, &ending)
    return unsafe symlink(
      Pointer.fromSlice<u8>(Bytes.asSlice(&target)),
      Pointer.fromSlice<u8>(Bytes.asSlice(&path)),
    )
      == 0
  }
} else {
  // A host without links, such as WASI, never has a bundled LLVM to run.
  effect fn linkTool(multicall: &[u8], tool: &[u8]) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    let _beside = multicall
    let _named = tool
    return false
  }
}
