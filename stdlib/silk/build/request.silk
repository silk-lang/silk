//! Complete compilation inputs for the compiler and development tools.
//!
//! # When to use
//! Use `Request` to describe one compilation independently of a package manifest or task program.
//! Read and write it with `silk.schema.toml.SchemaToml` or `silk.schema.json.SchemaJson`.
//! Generate its JSON Schema with `silk.schema.json_schema.JsonSchemas`.
//!
//! # Details
//! All filesystem paths are absolute. Packages and their import edges are explicit.
//! Compilation requests contain resolved values and never execute a task or fetch a dependency.
//! Every record rejects unknown fields. The `version` field identifies this wire format.
//!
//! @category Core

import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.box { Box }
import silk.schema.schema { Schema, Spec, Checks }
import silk.text.string { String }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.usize

/// One complete compilation, with no manifest discovery.
pub struct Request {
  /// The request format version; currently 1.
  pub version: u32,
  /// The artifact name, without a directory.
  pub name: String,
  /// The artifact kind: executable, loadable-module, static-archive, object, or test.
  pub artifact: String,
  /// The absolute path of the root Silk module.
  pub root: String,
  /// The root module identity within the root package, independent of its physical file.
  pub rootModule: String,
  /// The absolute path at which the compiler writes the artifact.
  pub output: String,
  /// The absolute path of the standard library.
  pub stdlib: String,
  /// The program-wide compilation settings.
  pub profile: Profile,
  /// Every package used by this compilation, with the root package first.
  pub packages: List<Package>,
  /// The selected runtime, support modules, and execution-storage bindings.
  pub composition: Composition,
  /// The ordered native inputs of the whole compilation.
  pub native: Native,
  /// The emitted form: final, llvm-ir, llvm-bitcode, assembly, object, or wasm-text.
  pub emit: String,
  /// An explicit sysroot and linker supply, when the target needs one.
  pub platform: Option<Platform>,
  /// Windows-specific link options.
  pub windows: Option<Windows>,
  /// macOS-specific link and signing options.
  pub macos: Option<MacOS>,
  /// WebAssembly memory and execution options.
  pub wasm: Option<Wasm>,
  /// The absolute path of an emitted C header, when requested.
  pub header: Option<String>,
  /// The absolute path of an emitted import library, when requested.
  pub importLibrary: Option<String>,
  /// The program used to run a foreign artifact or its tests.
  pub runner: Option<Runner>,
}

impl Schema for Request {
  static fn spec() -> Spec<Request> {
    return Spec<Request>.of()
      |> Spec<Request>.strict()
      |> Spec<Request>.between("version", 1, 1)
      |> Spec<Request>.pattern("name", "^[A-Za-z0-9_.-]+$")
      |> Spec<Request>.pattern(
        "artifact",
        "^(executable|loadable-module|static-archive|object|test)$",
      )
      |> Spec<Request>.rename("rootModule", "root-module")
      |> Spec<Request>.pattern("root", "^(/|[A-Za-z]:[/\\\\]|\\\\\\\\)[^\\x00]*$")
      |> Spec<Request>.pattern("output", "^(/|[A-Za-z]:[/\\\\]|\\\\\\\\)[^\\x00]*$")
      |> Spec<Request>.pattern("stdlib", "^(/|[A-Za-z]:[/\\\\]|\\\\\\\\)[^\\x00]*$")
      |> Spec<Request>.items("packages", 1, 65536)
      |> Spec<Request>.pattern("emit", "^(final|llvm-ir|llvm-bitcode|assembly|object|wasm-text)$")
      |> Spec<Request>.rename("importLibrary", "import-library")
      |> Spec<Request>.pattern("header", "^(/|[A-Za-z]:[/\\\\]|\\\\\\\\)[^\\x00]*$")
      |> Spec<Request>.pattern("importLibrary", "^(/|[A-Za-z]:[/\\\\]|\\\\\\\\)[^\\x00]*$")
  }

  /// Requires unique package identities and import aliases, with every dependency resolved in the request.
  fn check(self: &Self, checks: &mut Checks<Self>) -> () {
    checks.that(
      modulePath(self.rootModule.view(), true),
      "a canonical root module path ending in .silk",
    )
    let windows = String.endsWith(self.profile.target.view(), "windows-msvc")
    let macos = String.endsWith(self.profile.target.view(), "apple-darwin")
    let wasm = String.startsWith(self.profile.target.view(), "wasm")
    checks.that(self.windows.isNone() || windows, "Windows settings require a Windows target")
    checks.that(self.macos.isNone() || macos, "macOS settings require a macOS target")
    checks.that(self.wasm.isNone() || wasm, "WebAssembly settings require a WebAssembly target")
    checks.that(
      self.importLibrary.isNone() || (windows && self.artifact.view() == "loadable-module"),
      "an import library requires a Windows loadable module",
    )
    if let Option<Wasm>.Some { value } = &self.wasm {
      checks.that(
        self.profile.threading.view() != "multi" || (value.sharedMemory && value.importMemory),
        "multiple threads require imported shared memory",
      )
    }
    if let Option<MacOS>.Some { value } = &self.macos {
      checks.that(
        value.installName.isNone() || self.artifact.view() == "loadable-module",
        "an install name requires a loadable module",
      )
    }
    let packages = self.packages.asSlice()
    let mut at = usize.ZERO
    while at < packages.length {
      let package = &packages[at]
      let mut previous = usize.ZERO
      while previous < at {
        checks.that(
          package.name.view() != packages[previous].name.view()
            || package.version.view() != packages[previous].version.view(),
          "unique package identities",
        )
        previous = previous + usize.ONE
      }
      let dependencies = package.dependencies.asSlice()
      let mut edge = usize.ZERO
      while edge < dependencies.length {
        let dependency = &dependencies[edge]
        let mut found = false
        let mut target = usize.ZERO
        while target < packages.length {
          if identifies(dependency.package.view(), &packages[target]) {
            found = true
          }
          target = target + usize.ONE
        }
        checks.that(found, "every dependency identity present in packages")
        previous = usize.ZERO
        while previous < edge {
          checks.that(
            dependencies[previous].name.view() != dependency.name.view(),
            "unique dependency aliases within a package",
          )
          previous = previous + usize.ONE
        }
        edge = edge + usize.ONE
      }
      at = at + usize.ONE
    }
    return ()
  }
}

fn identifies(identity: string, package: &Package) -> bool {
  let bytes = String.utf8Bytes(identity)
  let name = String.ownedUtf8Bytes(&package.name)
  let version = String.ownedUtf8Bytes(&package.version)
  if bytes.length != name.length + usize.ONE + version.length {
    return false
  }
  let mut at = usize.ZERO
  while at < name.length {
    if bytes[at] != name[at] {
      return false
    }
    at = at + usize.ONE
  }
  if bytes[at] != 64 {
    return false
  }
  at = usize.ZERO
  while at < version.length {
    if bytes[name.length + usize.ONE + at] != version[at] {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

/// Program-wide source facts and default backend settings.
pub struct Profile {
  /// The canonical target triple.
  pub target: String,
  /// The CPU model.
  pub cpu: Option<String>,
  /// The enabled CPU features.
  pub cpuFeatures: List<String>,
  /// The minimum operating-system version.
  pub deployment: Option<String>,
  /// The selected C library.
  pub libc: String,
  /// The entry selection: default, none, or a declared name.
  pub entry: String,
  /// The runtime selection: default, none, or a declared name.
  pub runtime: String,
  /// The link mode.
  pub link: String,
  /// The target code model.
  pub codeModel: String,
  /// The relocation model.
  pub relocation: String,
  /// The program-wide optimization: none, speed, or size.
  pub optimization: String,
  /// Whether the program emits debug information by default.
  pub debug: bool,
  /// The program-wide safety policy.
  pub safety: String,
  /// The program-wide threading policy.
  pub threading: String,
  /// The enabled sanitizers.
  pub sanitizers: List<String>,
  /// The unwind policy.
  pub unwind: String,
  /// The code generator: llvm or direct.
  pub backend: String,
  /// The number of code generation units for an optimized build.
  pub codegenUnits: Option<u64>,
  /// The maximum WebAssembly memory, in bytes.
  pub maxMemory: Option<u64>,
  /// The main stack size, in bytes.
  pub stackSize: Option<u64>,
}

impl Schema for Profile {
  static fn spec() -> Spec<Profile> {
    return profileSpec<Profile>()
  }
}

/// Describes the shared profile field names and domains for resolved and optional settings.
pub static fn profileSpec<T>() -> Spec<T> {
  return Spec<T>.of()
    |> Spec<T>.strict()
    |> Spec<T>.pattern(
      "target",
      "^(aarch64-apple-darwin|x86_64-apple-darwin|aarch64-unknown-linux-gnu|x86_64-unknown-linux-gnu|x86_64-pc-windows-msvc|wasm32-unknown-unknown|wasm32-wasip1|wasm32-wasip2|wasm64-unknown-unknown)$",
    )
    |> Spec<T>.pattern("optimization", "^(none|speed|size)$")
    |> Spec<T>.pattern("backend", "^(llvm|direct)$")
    |> Spec<T>.rename("cpuFeatures", "cpu-features")
    |> Spec<T>.rename("codeModel", "code-model")
    |> Spec<T>.rename("codegenUnits", "codegen-units")
    |> Spec<T>.rename("maxMemory", "max-memory")
    |> Spec<T>.rename("stackSize", "stack-size")
}

/// A resolved source package and the settings its consumer supplied.
pub struct Package {
  /// The package name.
  pub name: String,
  /// The package version.
  pub version: String,
  /// The absolute package directory used for relative embedded files.
  pub directory: String,
  /// The absolute root directory of its Silk modules.
  pub source: String,
  /// The import aliases and exact package identities they select.
  pub dependencies: List<Dependency>,
  /// The canonical module paths other packages may import.
  pub exports: List<String>,
  /// The declared parameters and their resolved values.
  pub parameters: List<Parameter>,
  /// Generated modules, with their absolute source paths.
  pub modules: List<Module>,
  /// The backend optimization override; source-visible optimization stays program-wide.
  pub optimization: Option<String>,
  /// The backend debug-information override.
  pub debug: Option<bool>,
}

impl Schema for Package {
  static fn spec() -> Spec<Package> {
    return Spec<Package>.of()
      |> Spec<Package>.strict()
      |> Spec<Package>.pattern("directory", "^(/|[A-Za-z]:[/\\\\]|\\\\\\\\)[^\\x00]*$")
      |> Spec<Package>.pattern("source", "^(/|[A-Za-z]:[/\\\\]|\\\\\\\\)[^\\x00]*$")
      |> Spec<Package>.pattern("optimization", "^(none|speed|size)$")
  }
}

/// An import alias bound to an exact package identity.
pub struct Dependency {
  /// The import alias.
  pub name: String,
  /// The selected package identity, as name@version.
  pub package: String,
}

impl Schema for Dependency {
  static fn spec() -> Spec<Dependency> {
    return Spec<Dependency>.of() |> Spec<Dependency>.strict()
  }
}

/// A declared package parameter, including its documentation and bound value.
pub struct Parameter {
  /// The public parameter name.
  pub name: String,
  /// The module that declares the parameter, relative to its package.
  pub module: String,
  /// The admitted Silk type of the parameter.
  pub typeName: String,
  /// The declaration documentation.
  pub description: String,
  /// Whether the declaration has no default.
  pub required: bool,
  /// The declared default, when present.
  pub default: Option<ParameterValue>,
  /// The value bound for this compilation.
  pub value: ParameterValue,
  /// Whether the root supplied this value as a path capability.
  pub suppliedPath: bool,
}

impl Schema for Parameter {
  static fn spec() -> Spec<Parameter> {
    return Spec<Parameter>.of()
      |> Spec<Parameter>.strict()
      |> Spec<Parameter>.rename("typeName", "type")
      |> Spec<Parameter>.rename("suppliedPath", "supplied-path")
  }
}

/// A resolved parameter value. Lists and records preserve their declared element and field types.
pub union ParameterValue {
  /// A text parameter.
  Text { pub value: String },
  /// A boolean parameter.
  Boolean { pub value: bool },
  /// An exact decimal integer; its declared type supplies width and signedness.
  Integer { pub decimal: String },
  /// A member of a named enum.
  Enum { pub nominal: String, pub member: String },
  /// An absent optional value.
  None,
  /// A present optional value.
  Some { pub value: Box<ParameterValue> },
  /// An ordered sequence of parameter values.
  Sequence { pub values: List<ParameterValue> },
  /// A record's named parameter values.
  Record { pub fields: List<ParameterField> },
}

impl Schema for ParameterValue {
  static fn spec() -> Spec<ParameterValue> {
    return Spec<ParameterValue>.of() |> Spec<ParameterValue>.strict()
  }
}

/// One named field of a structured parameter.
pub struct ParameterField {
  /// The declared field name.
  pub name: String,
  /// The field value.
  pub value: ParameterValue,
}

impl Schema for ParameterField {
  static fn spec() -> Spec<ParameterField> {
    return Spec<ParameterField>.of() |> Spec<ParameterField>.strict()
  }
}

/// A generated module whose source is stored at an explicit path.
pub struct Module {
  /// The canonical module path inside its package.
  pub name: String,
  /// The absolute path of its generated source.
  pub source: String,
  /// The step key that produces the file, for editor diagnostics.
  pub producer: Option<String>,
}

impl Schema for Module {
  static fn spec() -> Spec<Module> {
    return Spec<Module>.of()
      |> Spec<Module>.strict()
      |> Spec<Module>.pattern("source", "^(/|[A-Za-z]:[/\\\\]|\\\\\\\\)[^\\x00]*$")
  }

  fn check(self: &Self, checks: &mut Checks<Self>) -> () {
    checks.that(
      modulePath(self.name.view(), false),
      "a canonical generated module name without empty or parent segments",
    )
  }
}

/// A declaration rooted by the runtime composition.
pub struct Selector {
  /// The defining package identity, or silk for the standard library.
  pub package: String,
  /// The canonical module path.
  pub module: String,
  /// The declaration name.
  pub declaration: String,
}

impl Schema for Selector {
  static fn spec() -> Spec<Selector> {
    return Spec<Selector>.of() |> Spec<Selector>.strict()
  }
}

/// The resolved runtime composition and exported support modules.
pub struct Composition {
  /// The selected startup module, absent for artifacts without a runtime.
  pub runtime: Option<ModuleRef>,
  /// The target support modules rooted by this compilation.
  pub support: List<Support>,
  /// Declarations retained regardless of import reachability.
  pub retention: List<Selector>,
  /// The execution-storage operations selected by the runtime.
  pub storage: Option<Storage>,
}

impl Schema for Composition {
  static fn spec() -> Spec<Composition> {
    return Spec<Composition>.of() |> Spec<Composition>.strict()
  }
}

/// A module identified without a filesystem path.
pub struct ModuleRef {
  /// The package identity.
  pub package: String,
  /// The canonical module path.
  pub module: String,
}

impl Schema for ModuleRef {
  static fn spec() -> Spec<ModuleRef> {
    return Spec<ModuleRef>.of() |> Spec<ModuleRef>.strict()
  }
}

/// A target support module and its export policy.
pub struct Support {
  /// The support module.
  pub module: ModuleRef,
  /// Whether its C exports are also host exports.
  pub hosted: bool,
}

impl Schema for Support {
  static fn spec() -> Spec<Support> {
    return Spec<Support>.of() |> Spec<Support>.strict()
  }
}

/// The four runtime execution-storage bindings.
pub struct Storage {
  /// The declaration that implements create.
  pub create: Selector,
  /// The declaration that implements acquire.
  pub acquire: Selector,
  /// The declaration that implements release.
  pub release: Selector,
  /// The declaration that implements destroy.
  pub destroy: Selector,
}

impl Schema for Storage {
  static fn spec() -> Spec<Storage> {
    return Spec<Storage>.of() |> Spec<Storage>.strict()
  }
}

/// Ordered native compilation and link inputs.
pub struct Native {
  /// Native translation units and their compiler arguments.
  pub sources: List<NativeSource>,
  /// Inputs in linker order.
  pub link: List<LinkInput>,
  /// The absolute path of a function-order file.
  pub functionOrder: Option<String>,
}

impl Schema for Native {
  static fn spec() -> Spec<Native> {
    return Spec<Native>.of()
      |> Spec<Native>.strict()
      |> Spec<Native>.pattern("functionOrder", "^(/|[A-Za-z]:[/\\\\]|\\\\\\\\)[^\\x00]*$")
      |> Spec<Native>.rename("functionOrder", "function-order")
  }
}

/// One native translation unit with explicit flags and include paths.
pub struct NativeSource {
  /// The absolute path of the source file.
  pub path: String,
  /// The source language: c, cpp, objc, or objcpp.
  pub language: String,
  /// The compiler flags, in argument order.
  pub flags: List<String>,
  /// Absolute include directory paths.
  pub include: List<String>,
}

impl Schema for NativeSource {
  static fn spec() -> Spec<NativeSource> {
    return Spec<NativeSource>.of()
      |> Spec<NativeSource>.strict()
      |> Spec<NativeSource>.pattern("path", "^(/|[A-Za-z]:[/\\\\]|\\\\\\\\)[^\\x00]*$")
      |> Spec<NativeSource>.pattern("language", "^(c|cpp|objc|objcpp)$")
  }
}

/// One ordered native linker input.
pub struct LinkInput {
  /// The input kind: object, archive, library, framework, search-path, framework-search-path, rpath, or linker-script.
  pub kind: String,
  /// The library or framework name, or an absolute path for a file or directory input.
  pub value: String,
  /// The library search mode, static or dynamic.
  pub mode: Option<String>,
  /// Whether the platform may leave this library or framework absent.
  pub weak: bool,
  /// Whether to retain the library even when no symbol references it.
  pub needed: bool,
}

impl Schema for LinkInput {
  static fn spec() -> Spec<LinkInput> {
    return Spec<LinkInput>.of()
      |> Spec<LinkInput>.strict()
      |> Spec<LinkInput>.pattern(
        "kind",
        "^(object|archive|library|framework|search-path|framework-search-path|rpath|linker-script)$",
      )
      |> Spec<LinkInput>.pattern("mode", "^(static|dynamic)$")
  }

  fn check(self: &Self, checks: &mut Checks<Self>) -> () {
    let kind = self.kind.view()
    let named = kind == "library" || kind == "framework"
    checks.that(!self.weak || !self.needed, "weak or needed linking, never both")
    checks.that(
      named || (!self.weak && !self.needed),
      "weak and needed only on libraries or frameworks",
    )
    checks.that(kind == "library" || !self.mode.isSome(), "a link mode only on a named library")
    checks.that(self.value.view() != "", "a nonempty native link input")
  }
}

/// An explicit platform toolchain supply.
pub struct Platform {
  /// The absolute sysroot directory.
  pub sysroot: String,
  /// The absolute linker executable path.
  pub linker: String,
  /// Compiler-support installations, each selected by its canonical target triple.
  pub support: List<Installation>,
}

impl Schema for Platform {
  static fn spec() -> Spec<Platform> {
    return Spec<Platform>.of()
      |> Spec<Platform>.strict()
      |> Spec<Platform>.pattern("sysroot", "^(/|[A-Za-z]:[/\\\\]|\\\\\\\\)[^\\x00]*$")
      |> Spec<Platform>.pattern("linker", "^(/|[A-Za-z]:[/\\\\]|\\\\\\\\)[^\\x00]*$")
  }
}

/// An installed compiler-support directory for one target.
pub struct Installation {
  /// The canonical target triple served by the installation.
  pub target: String,
  /// The absolute installation directory.
  pub root: String,
}

impl Schema for Installation {
  static fn spec() -> Spec<Installation> {
    return Spec<Installation>.of()
      |> Spec<Installation>.strict()
      |> Spec<Installation>.pattern("root", "^/[^\\x00]*$")
  }
}

/// Windows executable and resource settings.
pub struct Windows {
  /// The subsystem, console or windows.
  pub subsystem: Option<String>,
  /// The absolute path of the Windows application manifest.
  pub manifest: Option<String>,
  /// The absolute paths of resource files.
  pub resources: List<String>,
}

impl Schema for Windows {
  static fn spec() -> Spec<Windows> {
    return Spec<Windows>.of()
      |> Spec<Windows>.strict()
      |> Spec<Windows>.pattern("subsystem", "^(console|windows)$")
      |> Spec<Windows>.pattern("manifest", "^(/|[A-Za-z]:[/\\\\]|\\\\\\\\)[^\\x00]*$")
  }
}

/// macOS signing and dynamic-library settings.
pub struct MacOS {
  /// The absolute path of the signing entitlements.
  pub entitlements: Option<String>,
  /// The dynamic-library install name.
  pub installName: Option<String>,
}

impl Schema for MacOS {
  static fn spec() -> Spec<MacOS> {
    return Spec<MacOS>.of()
      |> Spec<MacOS>.strict()
      |> Spec<MacOS>.pattern("entitlements", "^(/|[A-Za-z]:[/\\\\]|\\\\\\\\)[^\\x00]*$")
      |> Spec<MacOS>.rename("installName", "install-name")
  }
}

/// WebAssembly memory, table, and execution settings.
pub struct Wasm {
  /// Whether memory is supplied by the host.
  pub importMemory: bool,
  /// Whether the linear memory is shared.
  pub sharedMemory: bool,
  /// Whether to export the function table.
  pub exportTable: bool,
  /// The WASI execution model, command or reactor.
  pub executionModel: String,
  /// The absolute WIT directory for a component build.
  pub wit: Option<String>,
  /// The WIT world name for a component build.
  pub world: Option<String>,
}

impl Schema for Wasm {
  static fn spec() -> Spec<Wasm> {
    return Spec<Wasm>.of()
      |> Spec<Wasm>.strict()
      |> Spec<Wasm>.pattern("wit", "^/[^\\x00]*$")
      |> Spec<Wasm>.rename("importMemory", "import-memory")
      |> Spec<Wasm>.rename("sharedMemory", "shared-memory")
      |> Spec<Wasm>.rename("exportTable", "export-table")
      |> Spec<Wasm>.rename("executionModel", "execution-model")
      |> Spec<Wasm>.pattern("executionModel", "^(command|reactor)$")
  }
}

/// A command used to launch a foreign artifact.
pub struct Runner {
  /// The runner executable name or absolute path.
  pub program: String,
  /// Arguments placed before the artifact path.
  pub arguments: List<String>,
}

impl Schema for Runner {
  static fn spec() -> Spec<Runner> {
    return Spec<Runner>.of() |> Spec<Runner>.strict()
  }
}

fn modulePath(value: string, extension: bool) -> bool {
  let bytes = String.utf8Bytes(value)
  if bytes.length == usize.ZERO {
    return false
  }
  if extension {
    if bytes.length < 6 {
      return false
    }
    let end = bytes.length
    if bytes[end - 5] != 46 || bytes[end - 4] != 115 || bytes[end - 3] != 105
      || bytes[end - 2] != 108
      || bytes[end - 1] != 107 {
      return false
    }
  }
  let mut start = usize.ZERO
  let mut at = usize.ZERO
  while at <= bytes.length {
    if at == bytes.length || bytes[at] == 47 {
      let length = at - start
      if length == usize.ZERO || (length == 1 && bytes[start] == 46)
        || (length == 2 && bytes[start] == 46 && bytes[start + 1] == 46) {
        return false
      }
      start = at + usize.ONE
    } else if bytes[at] == 0 || bytes[at] == 92 {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

impl Request {
  /// Returns the stable publication filename for this artifact, target, and optimization mode.
  pub effect fn fileName(self: &Self) -> String
    ! OutOfMemoryError
    ? &mut Allocator {
    return run Request.requestFileName(
      self.name.view(),
      self.profile.target.view(),
      self.profile.optimization.view(),
    )
  }

  /// Names a published request using its compilation name, canonical target, and optimization.
  pub effect fn requestFileName(name: string, target: string, optimization: string) -> String
    ! OutOfMemoryError
    ? &mut Allocator {
    let mode = if optimization == "none" {
      "dev"
    } else if optimization == "size" {
      "size"
    } else {
      "release"
    }
    let mut filename = run String.copy(name)
    run filename.append(".")
    run filename.append(target)
    run filename.append(".")
    run filename.append(mode)
    run filename.append(".toml")
    return move filename
  }
}

/// Returns the artifact filename selected by the resolved request.
pub effect fn artifactName(name: string, artifact: string, emit: string, target: string) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let windows = target == "x86_64-pc-windows-msvc"
  let darwin = target == "aarch64-apple-darwin" || target == "x86_64-apple-darwin"
  let wasm = target == "wasm32-unknown-unknown" || target == "wasm64-unknown-unknown"
    || target == "wasm32-wasip1"
    || target == "wasm32-wasip2"
  let kind = artifact
  let suffix = if emit == "llvm-ir" {
    ".ll"
  } else if emit == "llvm-bitcode" {
    ".bc"
  } else if emit == "assembly" {
    ".s"
  } else if emit == "wasm-text" {
    ".wat"
  } else if emit == "object" || kind == "object" {
    if windows {
      ".obj"
    } else {
      ".o"
    }
  } else if kind == "static-archive" {
    if windows {
      ".lib"
    } else {
      ".a"
    }
  } else if wasm {
    ".wasm"
  } else if kind == "loadable-module" {
    if windows {
      ".dll"
    } else if darwin {
      ".dylib"
    } else {
      ".so"
    }
  } else if windows {
    ".exe"
  } else {
    ""
  }
  let mut file = run String.copy(name)
  run file.append(suffix)
  return move file
}

/// The complete request set most recently published by `Build.write` or the built-in plan command.
/// Readers select only these files when this index exists; other commands may publish additional requests.
pub struct RequestSet {
  /// The request-set format version, currently 1.
  pub version: u32,
  /// Request filenames relative to the directory holding `plan.json`.
  pub files: List<String>,
}

impl Schema for RequestSet {
  static fn spec() -> Spec<RequestSet> {
    return Spec<RequestSet>.of()
      |> Spec<RequestSet>.strict()
      |> Spec<RequestSet>.between("version", 1, 1)
  }

  fn check(self: &Self, checks: &mut Checks<Self>) -> () {
    let files = self.files.asSlice()
    let mut at: usize = 0
    while at < files.length {
      let name = String.ownedUtf8Bytes(&files[at])
      let mut valid = name.length > 5 && String.endsWith(files[at].view(), ".toml")
      let mut index: usize = 0
      while index < name.length {
        let byte = name[index]
        valid = valid
          && ((byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122)
            || (byte >= 48 && byte <= 57)
            || byte == 45
            || byte == 46
            || byte == 95)
        index = index + 1
      }
      checks.that(valid, "request filenames ending in .toml without directory components")
      let mut previous: usize = 0
      while previous < at {
        checks.that(files[previous].view() != files[at].view(), "unique request filenames")
        previous = previous + 1
      }
      at = at + 1
    }
  }
}
