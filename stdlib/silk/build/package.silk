//! Per-package backend settings and typed parameter bindings in a compilation graph.

import silk.build.definition as Definitions { Parameter }
import silk.build.options { Optimize }
import silk.build.request { ParameterValue }
import silk.build.step { Deferred, Key, Make, StepFailure }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.allocator { Allocator }
import silk.system.filesystem { Path }
import silk.build.context as Context
import silk.text.string { String }
import silk.num.usize

union Binding {
  Value {module: String, name: String, value: Deferred<ParameterValue>},
  Path {module: String, name: String, value: Deferred<Path>},
}

/// Overrides that affect only the selected declared package.
pub struct Package {
  optimization: Option<Deferred<Optimize>>,
  debugging: Option<Deferred<bool>>,
  bindings: List<Binding>,
  excluded: bool,
}

impl Package {
  /// Creates an override that preserves the compilation's defaults.
  pub fn make() -> Self {
    return Package {optimization: Option<Deferred<Optimize>>.none(), debugging: Option<Deferred<bool>>.none(),
      bindings: List<Binding>.make(), excluded: false}
  }

  /// Selects optimization for code defined in this package, including generic instantiations.
  pub fn optimize(self: Self, value: Deferred<Optimize>) -> Self {
    let mut package = move self
    package.optimization = Option<Deferred<Optimize>>.some(move value)
    return move package
  }

  /// Selects debug information for code defined in this package.
  pub fn debug(self: Self, value: Deferred<bool>) -> Self {
    let mut package = move self
    package.debugging = Option<Deferred<bool>>.some(move value)
    return move package
  }

  /// Binds a typed value to a public parameter declared in `module`, such as `build.silk`.
  pub effect fn set(self: Self, module: string, name: string, value: Deferred<ParameterValue>) -> Self ! StepFailure ? &mut Allocator {
    let mut package = move self
    run package.bindings.append(Binding.Value {module: run String.copy(module), name: run String.copy(name), value: move value})
    return move package
  }

  /// Grants the package's plan read access to a declared path parameter.
  pub effect fn path(self: Self, module: string, name: string, value: Deferred<Path>) -> Self ! StepFailure ? &mut Allocator {
    let mut package = move self
    run package.bindings.append(Binding.Path {module: run String.copy(module), name: run String.copy(name), value: move value})
    return move package
  }

  /// Excludes this dependency from the compilation's available import graph.
  pub fn without(self: Self) -> Self {
    let mut package = move self
    package.excluded = true
    return move package
  }
}

/// Declares the deferred values and supplied paths that determine the override.
pub effect fn key(package: &Package, key: &mut Key) -> () ! StepFailure ? &mut Allocator {
  run key.text(if package.excluded { "excluded" } else { "included" })
  if let Option<Deferred<Optimize>>.Some {value} = &package.optimization { run key.text("optimization")
    run key.value(&value) }
  if let Option<Deferred<bool>>.Some {value} = &package.debugging { run key.text("debug")
    run key.value(&value) }
  let bindings = package.bindings.asSlice()
  let mut at = usize.ZERO
  while at < bindings.length {
    match &bindings[at] {
      Binding.Value {module, name, value} => { run key.text("value")
        run key.text(module.view())
        run key.text(name.view())
        run key.value(&value) }
      Binding.Path {module, name, value} => { run key.text("path")
        run key.text(module.view())
        run key.text(name.view())
        run key.tree(&value) }
    }
    at = at + usize.ONE
  }
}

/// Resolves overrides only after every declared producer has completed.
pub effect fn resolve(package: &Package, make: &mut Make) -> Definitions.Package ! StepFailure ? &mut Allocator {
  let mut optimization = Option<String>.none()
  if let Option<Deferred<Optimize>>.Some {value} = &package.optimization {
    optimization = Option<String>.some(run String.copy((run make.get(&value)).text()))
  }
  let mut debugging = Option<bool>.none()
  if let Option<Deferred<bool>>.Some {value} = &package.debugging { debugging = Option<bool>.some(run make.get(&value)) }
  let mut parameters = List<Parameter>.make()
  let bindings = package.bindings.asSlice()
  let mut at = usize.ZERO
  while at < bindings.length {
    match &bindings[at] {
      Binding.Value {module, name, value} => {
        run parameters.append(Parameter {module: run String.copy(module.view()), name: run String.copy(name.view()),
          value: run make.get(&value), suppliedPath: false})
      }
      Binding.Path {module, name, value} => {
        run parameters.append(Parameter {module: run String.copy(module.view()), name: run String.copy(name.view()),
          value: ParameterValue.Text {value: run Context.text(&run make.path(&value))}, suppliedPath: true})
      }
    }
    at = at + usize.ONE
  }
  return Definitions.Package {optimization: move optimization, debug: debugging, parameters: move parameters, excluded: package.excluded}
}
