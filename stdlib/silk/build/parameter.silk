//! Typed package parameters resolved by the build graph.

import silk.build.request { ParameterValue, ParameterField }
import silk.build.encoding as Encoding
import silk.build.step { Deferred, Step, Key, Make, StepError, StepFailure }
import silk.collections.list { List }
import silk.concurrency.thread { Transferable }
import silk.core.option { Option }
import silk.core.reflect { Reflect, enumKind, namedKind, anonymousNamedKind }
import silk.core.result { Result }
import silk.mem.allocator { Allocator }
import silk.mem.box { Box }
import silk.schema.schema { Schema }
import silk.text.string { String, InvalidUtf8 }
import silk.num.usize

/// A value admitted as a package parameter: text, boolean, fixed-width integer, enum, option, list,
/// or a record of those values. An empty implementation derives an enum or a record's public fields.
/// Records and enums also implement `Schema` so deferred values can be cached and restored.
pub interface Parameter {
  /// Encodes the value without losing its nominal enum identity, integer precision, or optional layers.
  effect fn parameter(self: &Self) -> ParameterValue
    ! StepFailure
    ? &mut Allocator {
    static if Reflect.typeKind(Reflect.typeOf<Self>()) == enumKind {
      static for member in Reflect.enumMembers<Self>() {
        if self.* == member {
          return ParameterValue.Enum {
            nominal: run String.copy(Reflect.declarationName<Self>()),
            member: run String.copy(Reflect.enumLabelOf(member)),
          }
        }
      }
      fail StepError { message: run String.copy("the parameter holds no declared enum member") }
    } else {
      static if Reflect.typeKind(Reflect.typeOf<Self>()) == namedKind
        || Reflect.typeKind(Reflect.typeOf<Self>()) == anonymousNamedKind {
        static if Reflect.privateField<Self>() != "" {
          compileError("a parameter record must expose every field")
        }
        let mut fields = List<ParameterField>.make()
        static for field in Reflect.fields<Self>() {
          run fields.append(run fieldValue(self, field))
        }
        return ParameterValue.Record { fields: move fields }
      } else {
        compileError("package parameters admit text, booleans, fixed-width integers, enums, options, lists, and records")
      }
    }
  }
}

effect fn fieldValue<T, V: Parameter>(
  owner: &T,
  static field: Intrinsic.Field<T, V>,
) -> ParameterField
  ! StepFailure
  ? &mut Allocator {
  return ParameterField {
    name: run String.copy(Reflect.fieldLabel(field)),
    value: run Parameter.parameter(Reflect.borrowField(owner, field)),
  }
}

impl Parameter for bool {
  effect fn parameter(self: &Self) -> ParameterValue
    ! StepFailure
    ? &mut Allocator {
    return ParameterValue.Boolean { value: self.* }
  }
}

impl Parameter for String {
  effect fn parameter(self: &Self) -> ParameterValue
    ! StepFailure
    ? &mut Allocator {
    return ParameterValue.Text { value: run String.copy(self.view()) }
  }
}

impl<T: Parameter> Parameter for Option<T> {
  effect fn parameter(self: &Self) -> ParameterValue
    ! StepFailure
    ? &mut Allocator {
    return match &self.* {
      Option<T>.None => ParameterValue.None
      Option<T>.Some { value } => ParameterValue.Some {
        value: run Box<ParameterValue>.make(run Parameter.parameter(&value)),
      }
    }
  }
}

impl<T: Parameter> Parameter for List<T> {
  effect fn parameter(self: &Self) -> ParameterValue
    ! StepFailure
    ? &mut Allocator {
    let mut values = List<ParameterValue>.make()
    let items = self.asSlice()
    let mut at: usize = 0
    while at < items.length {
      run values.append(run Parameter.parameter(&items[at]))
      at = at + 1
    }
    return ParameterValue.Sequence { values: move values }
  }
}

effect fn integer<T: Schema>(value: &T) -> ParameterValue
  ! StepFailure
  ? &mut Allocator {
  let bytes = run Encoding.json(value)
  let decimal = match move String.fromBytes(move bytes) {
    Result<String, InvalidUtf8>.Success { value: text } => move text
    Result<String, InvalidUtf8>.Failure { error: _invalid } => {
      fail StepError { message: run String.copy("integer serialization was not UTF-8") }
    }
  }
  return ParameterValue.Integer { decimal: move decimal }
}

impl Parameter for i8 {
  effect fn parameter(self: &Self) -> ParameterValue
    ! StepFailure
    ? &mut Allocator {
    return run integer(self)
  }
}

impl Parameter for i16 {
  effect fn parameter(self: &Self) -> ParameterValue
    ! StepFailure
    ? &mut Allocator {
    return run integer(self)
  }
}

impl Parameter for i32 {
  effect fn parameter(self: &Self) -> ParameterValue
    ! StepFailure
    ? &mut Allocator {
    return run integer(self)
  }
}

impl Parameter for i64 {
  effect fn parameter(self: &Self) -> ParameterValue
    ! StepFailure
    ? &mut Allocator {
    return run integer(self)
  }
}

impl Parameter for u8 {
  effect fn parameter(self: &Self) -> ParameterValue
    ! StepFailure
    ? &mut Allocator {
    return run integer(self)
  }
}

impl Parameter for u16 {
  effect fn parameter(self: &Self) -> ParameterValue
    ! StepFailure
    ? &mut Allocator {
    return run integer(self)
  }
}

impl Parameter for u32 {
  effect fn parameter(self: &Self) -> ParameterValue
    ! StepFailure
    ? &mut Allocator {
    return run integer(self)
  }
}

impl Parameter for u64 {
  effect fn parameter(self: &Self) -> ParameterValue
    ! StepFailure
    ? &mut Allocator {
    return run integer(self)
  }
}

struct Encoded<T> {
  input: Deferred<T>
}

impl<T: Schema + Parameter> Step for Encoded<T> {
  effect fn key(self: &Self, key: &mut Key) -> ()
    ! StepFailure
    ? &mut Allocator {
    return run key.value(&self.input)
  }

  effect fn make(self: &Self, make: &mut Make) -> ()
    ! StepFailure
    ? &mut Allocator {
    let input = run make.get(&self.input)
    let value = run Parameter.parameter(&input)
    return run make.value(&value)
  }
}

/// Preserves the producer dependency while encoding the parameter only when the graph runs.
pub effect fn deferred<T: Schema + Parameter + Transferable + 'static>(
  value: Deferred<T>,
) -> Deferred<ParameterValue>
  ! StepFailure
  ? &mut Allocator {
  let step = run Step.register(Encoded<T> { input: move value })
  return run step.value<ParameterValue>()
}
