//! Immutable descriptions shared by static package plans and runtime build steps.

import silk.mem.pointer { Pointer }
import silk.core.option { Option }
import silk.core.ownership { Copy }

/// A persistent sequence constructed without allocation during static evaluation.
pub struct Chain<T> {
  /// The preceding entries, in reverse insertion order.
  pub previous: Option<&'static Chain<T>>,
  /// The last inserted entry.
  pub value: T,
}
impl<T> Chain<T> {
  /// Appends an entry to an immutable static sequence.
  pub static fn append(previous: Option<&'static Self>, value: T) -> Option<&'static Self> {
    let node = Chain<T> {previous: previous, value: move value}
    return Option<&'static Self>.Some {value: &node}
  }
}

/// An existing package file, an explicitly supplied host path, or another standard step's output.
pub union Input {
  /// A path confined to the declaring package.
  Source {pub path: string<'static>},
  /// A path supplied by the root command as a package parameter.
  Supplied {pub path: string<'static>},
  /// A declared output of a process or generated-file step.
  Output {pub step: &'static Action, pub name: string<'static>},
}
impl Copy for Input {}

/// One argument or declared dependency of a process.
pub union Argument {
  /// Literal argument text.
  Text {pub value: string<'static>},
  /// A path argument whose input contents enter the step's key.
  Input {pub path: Input},
  /// An argument naming a required output below the step's private directory.
  Output {pub name: string<'static>},
  /// A file dependency that adds no argument.
  File {pub path: Input},
  /// A directory dependency that adds no argument.
  Tree {pub path: Input},
}
impl Copy for Argument {}

/// A process's executable and ordered arguments and dependencies.
pub struct Invocation {
  /// The executable file, confined like every other declared input.
  pub program: Input,
  /// Arguments and dependencies in reverse insertion order.
  pub arguments: Option<&'static Chain<Argument>>,
}
impl Copy for Invocation {}

/// One generated UTF-8 file.
pub struct File {
  /// Its path below the step's private output directory.
  pub name: string<'static>,
  /// Its complete contents.
  pub content: string<'static>,
}
impl Copy for File {}

/// A standard build action that can be described in a pure package plan.
pub union Action {
  /// A process invocation with explicit input and output dependencies.
  Run {pub invocation: Invocation},
  /// Generated files whose contents are already known.
  WriteFiles {pub files: Option<&'static Chain<File>>},
}
impl Copy for Action {}

/// Compares deferred references within one graph; producer content determines persistent keys.
pub fn sameInput(left: &Input, right: &Input) -> bool {
  return match &left.* {
    Input.Source {path} => match &right.* { Input.Source {path: other} => path == other _ => false }
    Input.Supplied {path} => match &right.* { Input.Supplied {path: other} => path == other _ => false }
    Input.Output {step, name} => match &right.* {
      Input.Output {step: other, name: output} => name == output && Pointer.address(Pointer.fromRef(step)) == Pointer.address(Pointer.fromRef(other))
      _ => false
    }
  }
}
