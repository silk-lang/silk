//! Owned schema output used by build keys, cached values, and compilation requests.

import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError, SystemAllocator }
import silk.schema.issue { SchemaError }
import silk.schema.json { SchemaJson }
import silk.schema.toml { SchemaToml }
import silk.schema.schema { Schema }

struct Output {
  bytes: Bytes,
  allocator: SystemAllocator,
}

impl Writer for Output {
  effect fn writeAll(self: &mut Self, bytes: &[u8]) -> ()
    ! WriterError
    ? &mut Writer {
    let appended = run Effect.result(
      Bytes.append(&mut self.bytes, bytes) |> Effect.provideMut<Allocator>(&mut self.allocator),
    )
    match move appended {
      Result<(), OutOfMemoryError>.Success { .. } => ()
      Result<(), OutOfMemoryError>.Failure { .. } => {
        fail Writer.failure()
      }
    }
  }

  effect fn flush(self: &mut Self) -> ()
    ! WriterError
    ? &mut Writer {
    return ()
  }
}

/// Encodes one value as JSON without decoding or retaining a second representation.
pub effect fn json<T: Schema>(value: &T) -> Bytes
  ! SchemaError | WriterError | OutOfMemoryError
  ? &mut Allocator {
  let mut output = Output { bytes: Bytes.make(), allocator: Allocator.systemAllocatorProvider() }
  run SchemaJson.encode<T>(value) |> Effect.provideMut<Writer>(&mut output)
  return move output.bytes
}

/// Encodes one record as TOML without decoding or retaining a second representation.
pub effect fn toml<T: Schema>(value: &T) -> Bytes
  ! SchemaError | WriterError | OutOfMemoryError
  ? &mut Allocator {
  let mut output = Output { bytes: Bytes.make(), allocator: Allocator.systemAllocatorProvider() }
  run SchemaToml.encode<T>(value) |> Effect.provideMut<Writer>(&mut output)
  return move output.bytes
}

/// Encodes a cached graph value, preserving each layer of nested options.
pub effect fn value<T: Schema>(input: &T) -> Bytes
  ! SchemaError | WriterError | OutOfMemoryError
  ? &mut Allocator {
  let mut output = Output { bytes: Bytes.make(), allocator: Allocator.systemAllocatorProvider() }
  run SchemaJson.encodeTagged<T>(input) |> Effect.provideMut<Writer>(&mut output)
  return move output.bytes
}

/// Restores a cached graph value with its exact optional structure.
pub effect fn read<T: Schema>(bytes: &[u8]) -> T
  ! SchemaError | OutOfMemoryError
  ? &mut Allocator {
  return run SchemaJson.decodeTagged<T>(bytes)
}
