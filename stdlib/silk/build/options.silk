//! Standard command-line options shared by build commands.

import silk.cli.command { Command, CommandLine, Opt }
import silk.cli.value { Arg, ArgValue, FromArg }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }
import silk.schema.schema { Schema, SchemaReader, SchemaWriter, KindOf }
import silk.schema.shape { Shape, Shapes, ShapeOf, TypeInfo, VariantShape, FieldShape }
import silk.schema.issue { Issue, ValueKind }
import silk.io.writer { Writer, WriterError }

/// The optimization applied to a compilation or a defining package.
pub enum Optimize {
  /// Preserve straightforward code generation for development.
  None,
  /// Optimize execution speed.
  Speed,
  /// Optimize code size.
  Size,
}

impl Schema for Optimize {
  static fn kind() -> KindOf<Self> {
    return KindOf<Self>.of(ValueKind.Text, "none, speed, or size")
  }

  effect fn read(reader: &mut any SchemaReader) -> Self
    ! Issue | OutOfMemoryError
    ? &mut Allocator {
    let text = run SchemaReader.text(&mut reader.*)
    if text.view() == "none" {
      return Optimize.None
    }
    if text.view() == "speed" {
      return Optimize.Speed
    }
    if text.view() == "size" {
      return Optimize.Size
    }
    fail Issue.invalidValue("none, speed, or size")
  }

  effect fn write(self: &Self, writer: &mut any SchemaWriter) -> ()
    ! Issue | WriterError | OutOfMemoryError
    ? &mut Writer | &mut Allocator {
    return run SchemaWriter.text(&mut writer.*, self.text())
  }

  effect fn shape(shapes: &mut Shapes) -> ShapeOf<Self>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut variants = List<VariantShape>.make()
    run variants.append(
      VariantShape {
        name: "None",
        wire: "none",
        doc: "Development",
        fields: List<FieldShape>.make(),
      },
    )
    run variants.append(
      VariantShape {
        name: "Speed",
        wire: "speed",
        doc: "Execution speed",
        fields: List<FieldShape>.make(),
      },
    )
    run variants.append(
      VariantShape {
        name: "Size",
        wire: "size",
        doc: "Code size",
        fields: List<FieldShape>.make(),
      },
    )
    return ShapeOf<Self>.make(
      run shapes.add(
        Shape.Choice {
          info: TypeInfo { name: "Optimize", doc: "Optimization mode" },
          variants: move variants,
        },
      ),
    )
  }
}

impl Optimize {
  /// Returns the spelling used by compilation requests and command-line arguments.
  pub fn text(self: Self) -> string<'static> {
    if self == Optimize.Speed {
      return "speed"
    }
    if self == Optimize.Size {
      return "size"
    }
    return "none"
  }
}

impl FromArg for Optimize {
  effect fn fromArg(arg: Arg<'_>) -> Result<Self, bool>
    ! OutOfMemoryError
    ? &mut Allocator {
    if arg.text == "none" {
      return Result<Self, bool>.Success { value: Optimize.None }
    }
    if arg.text == "speed" {
      return Result<Self, bool>.Success { value: Optimize.Speed }
    }
    if arg.text == "size" {
      return Result<Self, bool>.Success { value: Optimize.Size }
    }
    return Result<Self, bool>.Failure { error: false }
  }
}

impl ArgValue for Optimize {
  fn takesValue() -> bool {
    return true
  }

  fn repeats() -> bool {
    return false
  }

  effect fn initial() -> Self
    ! OutOfMemoryError
    ? &mut Allocator {
    return Optimize.None
  }

  effect fn accept(self: &mut Self, arg: Arg<'_>) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    match run readOptimize<Optimize>(arg) {
      Result<Self, bool>.Success { value } => {
        self.* = value
        return true
      }
      Result<Self, bool>.Failure { error: _ } => {
        return false
      }
    }
  }
}

/// The fixed options a command embeds with `Command.flatten`.
pub struct Options {
  /// Requested target triples, in command-line order. An empty list selects the host.
  pub target: List<String>,
  /// The requested optimization. `--release` selects `Speed`.
  pub optimize: Optimize,
  /// An explicit debug-information choice; absent uses the compilation's mode default.
  pub debug: Option<bool>,
  /// Authorizes package tools without a sandbox during this command.
  pub unsandboxedTools: bool,
}

impl Options {
  /// Returns host-target development options without an explicit debug override.
  pub fn make() -> Self {
    return Options {
      target: List<String>.make(),
      optimize: Optimize.None,
      debug: Option<bool>.None,
      unsandboxedTools: false,
    }
  }

  /// Returns the debug choice, defaulting to enabled for unoptimized code.
  pub fn debugInfo(self: &Self) -> bool {
    return match self.debug {
      Option<bool>.Some { value } => value
      Option<bool>.None => self.optimize == Optimize.None
    }
  }
}

impl CommandLine for Options {
  static fn command() -> Command<Self> {
    return Command<Self>.make("", "Compilation options")
      |> Command.option("target", Opt.about("Target triple; repeat to build several targets"))
      |> Command.option(
        "optimize",
        Opt.about("Optimization mode")
          |> Opt.long("optimization")
          |> Opt.choice("none")
          |> Opt.choice("speed")
          |> Opt.choice("size")
          |> Opt.flagValue("release", "speed"),
      )
      |> Command.option(
        "debug",
        Opt.about("Emit debug information")
          |> Opt.choice("true")
          |> Opt.choice("false"),
      )
      |> Command.option(
        "unsandboxedTools",
        Opt.about("Allow package tools without a sandbox for this invocation"),
      )
  }
}

effect fn readOptimize<T: FromArg>(arg: Arg<'_>) -> Result<T, bool>
  ! OutOfMemoryError
  ? &mut Allocator {
  return run FromArg.fromArg(arg)
}
