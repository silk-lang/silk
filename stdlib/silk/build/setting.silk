//! Deferred compilation settings resolved by the graph runner.

import silk.build.package as Packages { Package }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.schema.issue { Issue }
import silk.mem.allocator { OutOfMemoryError }
import silk.build.options { Optimize }
import silk.build.definition { Settings as Values, Definition }
import silk.build.request { Module, NativeSource, LinkInput, Runner, Platform, Windows, MacOS, Wasm }
import silk.build.step { Deferred, Key, Make, StepError, StepFailure }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.allocator { Allocator }
import silk.system.filesystem { Path }
import silk.text.string { String }
import silk.num.usize

pub enum TextField { Target, Cpu, Deployment, Libc, Entry, Runtime, Link, CodeModel, Relocation, Safety, Threading, Unwind, Backend }
pub enum NumberField { CodegenUnits, MaxMemory, StackSize }
pub enum ListField { CpuFeatures, Sanitizers }

/// A setting whose dependencies enter the compilation key before its value is read.
pub union Setting {
  Text {pub field: TextField, pub value: Deferred<String>},
  Number {pub field: NumberField, pub value: Deferred<u64>},
  Texts {pub field: ListField, pub value: Deferred<List<String>>},
  Optimization {pub value: Deferred<Optimize>},
  Debug {pub value: Deferred<bool>},
  Runner {pub value: Deferred<Runner>},
  StandardLibrary {pub path: Deferred<Path>},
  Platform {pub value: Deferred<Platform>},
  Windows {pub value: Deferred<Windows>},
  MacOS {pub value: Deferred<MacOS>},
  Wasm {pub value: Deferred<Wasm>},
  Header {pub value: Deferred<String>},
  ImportLibrary {pub value: Deferred<String>},
  Emit {pub value: Deferred<String>},
  Root {pub path: Deferred<Path>},
  ModuleFile {pub name: String, pub path: Deferred<Path>},
  Native {pub language: String, pub path: Deferred<Path>, pub flags: Deferred<List<String>>, pub include: List<Deferred<Path>>},
  LinkFile {pub kind: String, pub path: Deferred<Path>},
  LinkName {pub kind: String, pub name: Deferred<String>, pub mode: Option<String>, pub weak: bool, pub needed: bool},
  FunctionOrder {pub path: Deferred<Path>},
  Package {pub alias: String, pub settings: Package},
}

/// Adds a setting's identity and all deferred inputs to the compilation key.
pub effect fn key(setting: &Setting, key: &mut Key) -> () ! StepFailure ? &mut Allocator {
  match &setting.* {
    Setting.Package {alias, settings} => { run key.text("package")
      run key.text(alias.view())
      run Packages.key(&settings, &mut key) }
    Setting.Text {field, value} => {
      run key.text("profile-text")
      if field == TextField.Target { run key.text("target") }
      if field == TextField.Cpu { run key.text("cpu") }
      if field == TextField.Deployment { run key.text("deployment") }
      if field == TextField.Libc { run key.text("libc") }
      if field == TextField.Entry { run key.text("entry") }
      if field == TextField.Runtime { run key.text("runtime") }
      if field == TextField.Link { run key.text("link") }
      if field == TextField.CodeModel { run key.text("codeModel") }
      if field == TextField.Relocation { run key.text("relocation") }
      if field == TextField.Safety { run key.text("safety") }
      if field == TextField.Threading { run key.text("threading") }
      if field == TextField.Unwind { run key.text("unwind") }
      if field == TextField.Backend { run key.text("backend") }
      run key.value(&value)
    }
    Setting.Number {field, value} => {
      run key.text("profile-number")
      if field == NumberField.CodegenUnits { run key.text("codegenUnits") }
      if field == NumberField.MaxMemory { run key.text("maxMemory") }
      if field == NumberField.StackSize { run key.text("stackSize") }
      run key.value(&value)
    }
    Setting.Texts {field, value} => {
      run key.text("profile-list")
      if field == ListField.CpuFeatures { run key.text("cpuFeatures") }
      if field == ListField.Sanitizers { run key.text("sanitizers") }
      run key.value(&value)
    }
    Setting.Optimization {value} => { run key.text("optimization")
      run key.value(&value) }
    Setting.Debug {value} => { run key.text("debug")
      run key.value(&value) }
    Setting.StandardLibrary {path} => { run key.text("stdlib")
      run key.tree(&path) }
    Setting.Platform {value} => { run key.text("platform")
      run key.value(&value) }
    Setting.Windows {value} => { run key.text("windows")
      run key.value(&value) }
    Setting.MacOS {value} => { run key.text("macos")
      run key.value(&value) }
    Setting.Wasm {value} => { run key.text("wasm")
      run key.value(&value) }
    Setting.Header {value} => { run key.text("header")
      run key.value(&value) }
    Setting.ImportLibrary {value} => { run key.text("import-library")
      run key.value(&value) }
    Setting.Runner {value} => { run key.text("runner")
      run key.value(&value) }
    Setting.Emit {value} => { run key.text("emit")
      run key.value(&value) }
    Setting.Root {path} => { run key.text("root")
      run key.file(&path) }
    Setting.ModuleFile {name, path} => { run key.text("module")
      run key.text(name.view())
      run key.file(&path) }
    Setting.Native {language, path, flags, include} => {
      run key.text("native")
      run key.text(language.view())
      run key.file(&path)
      run key.value(&flags)
      let directories = include.asSlice()
      let mut at = usize.ZERO
      while at < directories.length { run key.tree(&directories[at])
        at = at + usize.ONE }
    }
    Setting.LinkFile {kind, path} => {
      run key.text(kind.view())
      if kind.view() == "search-path" || kind.view() == "framework-search-path" { run key.tree(&path) }
      else { run key.file(&path) }
    }
    Setting.LinkName {kind, name, mode, weak, needed} => {
      run key.text(kind.view())
      run key.value(&name)
      if let Option<String>.Some {value} = &mode { run key.text(value.view()) }
      run key.text(if weak { "weak" } else { "strong" })
      run key.text(if needed { "needed" } else { "as-needed" })
    }
    Setting.FunctionOrder {path} => { run key.text("function-order")
      run key.file(&path) }
  }
}

/// Resolves a setting only after its declared prerequisites have completed.
pub effect fn apply(setting: &Setting, make: &mut Make, definition: &mut Definition) -> () ! StepFailure ? &mut Allocator {
  if let Setting.Package {alias, settings} = &setting.* {
    let resolved = run Packages.resolve(&settings, &mut make)
    return match move run Effect.result(definition.packages.insert(run String.copy(alias.view()), move resolved)) {
      Result<(), Issue | OutOfMemoryError>.Success {..} => ()
      Result<(), Issue | OutOfMemoryError>.Failure {error} => match move error {
        Issue _duplicate => { fail StepError {message: run String.copy("a compilation configures each package alias once")} }
        OutOfMemoryError exhausted => { fail move exhausted }
      }
    }
  }
  if let Setting.StandardLibrary {path} = &setting.* {
    definition.stdlib = Option<String>.some(run pathText(&run make.path(&path)))
    return ()
  }
  let request = &mut definition.settings
  match &setting.* {
    Setting.Package {..} => ()
    Setting.StandardLibrary {..} => ()
    Setting.Platform {value} => { request.platform = Option<Platform>.some(run make.get(&value)) }
    Setting.Windows {value} => { request.windows = Option<Windows>.some(run make.get(&value)) }
    Setting.MacOS {value} => { request.macos = Option<MacOS>.some(run make.get(&value)) }
    Setting.Wasm {value} => { request.wasm = Option<Wasm>.some(run make.get(&value)) }
    Setting.Header {value} => { request.header = Option<String>.some(run make.get(&value)) }
    Setting.ImportLibrary {value} => { request.importLibrary = Option<String>.some(run make.get(&value)) }

    Setting.Text {field, value} => {
      let resolved = run make.get(&value)
      match field {
        TextField.Target => { request.profile.target = Option<String>.some(move resolved) }
        TextField.Cpu => { request.profile.cpu = Option<String>.some(move resolved) }
        TextField.Deployment => { request.profile.deployment = Option<String>.some(move resolved) }
        TextField.Libc => { request.profile.libc = Option<String>.some(move resolved) }
        TextField.Entry => { request.profile.entry = Option<String>.some(move resolved) }
        TextField.Runtime => { request.profile.runtime = Option<String>.some(move resolved) }
        TextField.Link => { request.profile.link = Option<String>.some(move resolved) }
        TextField.CodeModel => { request.profile.codeModel = Option<String>.some(move resolved) }
        TextField.Relocation => { request.profile.relocation = Option<String>.some(move resolved) }
        TextField.Safety => { request.profile.safety = Option<String>.some(move resolved) }
        TextField.Threading => { request.profile.threading = Option<String>.some(move resolved) }
        TextField.Unwind => { request.profile.unwind = Option<String>.some(move resolved) }
        TextField.Backend => { request.profile.backend = Option<String>.some(move resolved) }
      }
    }
    Setting.Number {field, value} => {
      let resolved = run make.get(&value)
      match field {
        NumberField.CodegenUnits => { request.profile.codegenUnits = Option<u64>.some(resolved) }
        NumberField.MaxMemory => { request.profile.maxMemory = Option<u64>.some(resolved) }
        NumberField.StackSize => { request.profile.stackSize = Option<u64>.some(resolved) }
      }
    }
    Setting.Texts {field, value} => {
      let resolved = run make.get(&value)
      match field {
        ListField.CpuFeatures => { request.profile.cpuFeatures = Option<List<String>>.some(move resolved) }
        ListField.Sanitizers => { request.profile.sanitizers = Option<List<String>>.some(move resolved) }
      }
    }
    Setting.Optimization {value} => { let resolved = run make.get(&value)
      request.profile.optimization = Option<String>.some(run String.copy(resolved.text())) }
    Setting.Debug {value} => { request.profile.debug = Option<bool>.some(run make.get(&value)) }
    Setting.Runner {value} => { request.runner = Option<Runner>.some(run make.get(&value)) }
    Setting.Emit {value} => { request.emit = Option<String>.some(run make.get(&value)) }
    Setting.Root {path} => { request.root = Option<String>.some(run pathText(&run make.path(&path))) }
    Setting.ModuleFile {name, path} => {
      run request.modules.append(Module {name: run String.copy(name.view()),
        source: run pathText(&run make.path(&path)), producer: run make.producer<Path>(&path)})
    }
    Setting.Native {language, path, flags, include} => {
      let mut directories = List<String>.make()
      let inputs = include.asSlice()
      let mut at = usize.ZERO
      while at < inputs.length { run directories.append(run pathText(&run make.path(&inputs[at])))
        at = at + usize.ONE }
      run request.native.sources.append(NativeSource {path: run pathText(&run make.path(&path)),
        language: run String.copy(language.view()), flags: run make.get(&flags), include: move directories})
    }
    Setting.LinkFile {kind, path} => {
      run request.native.link.append(LinkInput {kind: run String.copy(kind.view()),
        value: run pathText(&run make.path(&path)), mode: Option<String>.none(), weak: false, needed: false})
    }
    Setting.LinkName {kind, name, mode, weak, needed} => {
      let copiedMode = match &mode {
        Option<String>.Some {value} => Option<String>.some(run String.copy(value.view()))
        Option<String>.None => Option<String>.none()
      }
      run request.native.link.append(LinkInput {kind: run String.copy(kind.view()),
        value: run make.get(&name), mode: move copiedMode, weak: weak, needed: needed})
    }
    Setting.FunctionOrder {path} => { request.native.functionOrder = Option<String>.some(run pathText(&run make.path(&path))) }
  }
}

effect fn pathText(path: &Path) -> String ! StepFailure ? &mut Allocator {
  return match move Path.view(path) {
    Option<string>.Some {value} => run String.copy(value)
    Option<string>.None => { fail StepError {message: run String.copy("a compilation path must be UTF-8")} }
  }
}

/// Declares every physical input already present in a compilation definition.
pub effect fn keyValues(values: &Values, key: &mut Key) -> () ! StepFailure ? &mut Allocator {
  run fileOption(&mut key, &values.root)
  let modules = values.modules.asSlice()
  let mut at = usize.ZERO
  while at < modules.length { run key.file(&run Deferred<Path>.external(modules[at].source.view()))
    at = at + usize.ONE }
  let sources = values.native.sources.asSlice()
  at = usize.ZERO
  while at < sources.length {
    run key.file(&run Deferred<Path>.external(sources[at].path.view()))
    let include = sources[at].include.asSlice()
    let mut index = usize.ZERO
    while index < include.length { run key.tree(&run Deferred<Path>.external(include[index].view()))
      index = index + usize.ONE }
    at = at + usize.ONE
  }
  let links = values.native.link.asSlice()
  at = usize.ZERO
  while at < links.length {
    let kind = links[at].kind.view()
    if kind == "archive" || kind == "object" || kind == "linker-script" {
      run key.file(&run Deferred<Path>.external(links[at].value.view()))
    } else if kind == "search-path" || kind == "framework-search-path" {
      run key.tree(&run Deferred<Path>.external(links[at].value.view()))
    }
    at = at + usize.ONE
  }
  run fileOption(&mut key, &values.native.functionOrder)
  if let Option<Platform>.Some {value} = &values.platform {
    run key.file(&run Deferred<Path>.external(value.linker.view()))
    run key.tree(&run Deferred<Path>.external(value.sysroot.view()))
    let support = value.support.asSlice()
    at = usize.ZERO
    while at < support.length { run key.tree(&run Deferred<Path>.external(support[at].root.view()))
      at = at + usize.ONE }
  }
  if let Option<Windows>.Some {value} = &values.windows {
    run fileOption(&mut key, &value.manifest)
    let resources = value.resources.asSlice()
    at = usize.ZERO
    while at < resources.length { run key.file(&run Deferred<Path>.external(resources[at].view()))
      at = at + usize.ONE }
  }
  if let Option<MacOS>.Some {value} = &values.macos { run fileOption(&mut key, &value.entitlements) }
  if let Option<Wasm>.Some {value} = &values.wasm {
    if let Option<String>.Some {value: wit} = &value.wit { run key.tree(&run Deferred<Path>.external(wit.view())) }
  }
}

effect fn fileOption(key: &mut Key, path: &Option<String>) -> () ! StepFailure ? &mut Allocator {
  if let Option<String>.Some {value} = &path.* { run key.file(&run Deferred<Path>.external(value.view())) }
}
