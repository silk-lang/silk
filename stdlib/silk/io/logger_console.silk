//! A `Logger` provider for browser and JavaScript hosts: [`ConsoleLogger`] hands each message to
//! the host's console.
//!
//! # When to use
//! Provide [`ConsoleLogger`] for `Logger` in a `wasm32-unknown-unknown` program that runs in a
//! browser, Node.js, Deno or another JavaScript host. On WASI and native targets, use
//! `silk.io.logger_native` instead. Code that logs uses `silk.io.logger`, so a test can provide
//! `InMemoryLogger` instead.
//!
//! # Details
//! The module imports one host function, `console` from the import module `silk`, and only a
//! program that provides [`ConsoleLogger`] imports it: a module that never logs this way keeps
//! importing nothing. The standard library's runner, `host/wasm-runner.mjs`, supplies the import.
//! It passes each message to `options.onLog` with its level, and by default to the console method
//! of the level: `console.debug` for trace and debug, `console.info`, `console.warn` and
//! `console.error`.
//!
//! The import is `console(level, address, length, more)`. `level` counts from 0 for trace to 4 for
//! error, `address` and `length` name UTF-8 bytes in the module's memory, and `more` is 1 when the
//! next call continues the same message. The logger formats into a 256-byte buffer on the stack,
//! so a longer message arrives in several parts, which the host joins before it decodes them. The
//! logger does not allocate.
//!
//! # Errors
//! None. A host cannot refuse a message.
//!
//! # Gotchas
//! - The provider exists only on `wasm32-unknown-unknown`.
//! - A host that instantiates the module itself supplies `silk.console`, or the instantiation fails.
//! - The logger adds no level, timestamp, or newline. The console shows the level by its method.
//!
//! # Examples
//! ```silk,ignore
//! import silk.core.effect { Effect }
//! import silk.io.logger { LogError, Logger }
//! import silk.io.logger_console { ConsoleLogger }
//!
//! pub effect fn main() -> ()
//!   ! LogError {
//!   let mut logger = ConsoleLogger.make()
//!   let values = .{ name: "silk", count: 3 }
//!
//!   // Calls `console.info("silk started 3 workers")` in the host.
//!   run Effect.logInfo("{name} started {count} workers", &values)
//!     |> Effect.provideMut<Logger>(&mut logger)
//!   return ()
//! }
//! ```
//!
//! @category Input and output

static if Intrinsic.targetArchitecture() == "wasm32" && Intrinsic.targetOperatingSystem() != "wasi" {
  import silk.io.writer { WriterError, Writer }
  import silk.io.logger { Logger, LogError, LogLevel }
  import silk.core.effect { Effect }
  import silk.collections.slice { Slice }
  import silk.text.format { Format }
  import silk.mem.pointer { Pointer }
  import silk.num.usize

  // Passes `length` bytes at `bytes` to the host's console at `level`; `more` is 1 when the next
  // call continues the message. The linked runtime forwards it to the `silk.console` import.
  @foreign(noCapture: ("bytes",))
  unsafe extern "C" fn silk_wasm_console(level: i32, bytes: ?[*]const u8, length: usize, more: i32) -> ()

/// A `Logger` provider that passes each formatted message, with its level, to the host's console.
///
/// # Details
///
/// The host receives the message without a newline. A message longer than 256 bytes arrives in
/// parts that the host joins.
pub struct ConsoleLogger {}

impl ConsoleLogger {
  /// Returns a logger. It does not call the host.
  pub fn make() -> ConsoleLogger { return ConsoleLogger {} }

  effect fn writeConsole<Args>(
    self: &mut Self,
    level: LogLevel,
    static template: string<'static>,
    args: &Args
  ) -> () ! LogError {
    let mut line = ConsoleLine { bytes: [0; 256], length: 0, level: levelCode(level) }
    let formatted = run Effect.result(formatConsole<Args>(&mut line, template, args))
    drop formatted
    line.send(0)
    return ()
  }
}

// The part of a message not yet passed to the host.
struct ConsoleLine {
  bytes: [u8; 256],
  length: usize,
  level: i32,
}

impl ConsoleLine {
  fn send(self: &mut Self, more: i32) -> () {
    let held = Slice.view<u8>(&self.bytes, usize.ZERO, self.length)
    unsafe silk_wasm_console(self.level, Pointer.fromSlice(held), self.length, more)
    self.length = usize.ZERO
  }
}

impl Writer for ConsoleLine {
  effect fn writeAll(self: &mut Self, bytes: &[u8]) -> () ! WriterError ? &mut Writer {
    let mut index = usize.ZERO
    while index < bytes.length {
      if self.length == 256 { self.send(1) }
      self.bytes[self.length] = bytes[index]
      self.length = self.length + usize.ONE
      index = index + usize.ONE
    }
    return ()
  }

  effect fn flush(self: &mut Self) -> () ! WriterError ? &mut Writer { return () }
}

effect fn formatConsole<Args>(
  line: &mut ConsoleLine,
  static template: string<'static>,
  args: &Args
) -> () ! WriterError {
  return run Format.format<Args>(template, args) |> Effect.provideMut<Writer>(&mut line)
}

fn levelCode(level: LogLevel) -> i32 {
  return match level {
    LogLevel.Trace => 0
    LogLevel.Debug => 1
    LogLevel.Info => 2
    LogLevel.Warning => 3
    LogLevel.Error => 4
  }
}

impl Logger for ConsoleLogger {
  log: ConsoleLogger.writeConsole
}

}
