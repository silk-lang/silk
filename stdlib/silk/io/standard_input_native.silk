//! The native provider of the `StandardInput` effect: it reads the standard input of the process.
//!
//! # When to use
//! Provide [`OsStandardInput`] for `StandardInput` in a native program. Code that reads uses
//! `silk.io.standard_input`, so a test can provide a fake with fixed input.
//!
//! # Details
//! Each read reads once from the descriptor, directly into your buffer. It returns the count that
//! the system returned, which can be less than the buffer. When the system reports the end of
//! input, the provider remembers it. Later reads return the end without a system call.
//! Windows reads raw bytes through `ReadFile`; console bytes use the active input code page.
//!
//! # Errors
//! `StreamReadError` if the system read fails.
//!
//! # Gotchas
//! - An empty buffer returns a count of 0 without a read, also after the end of input.
//! - A read waits until input arrives or ends.
//! - The provider exists on WASI, Windows on x86_64, Darwin on aarch64, and GNU Linux on x86_64 or aarch64.
//!
//! # Examples
//! ## Read standard input
//! ```silk
//! import silk.core.effect { Effect }
//! import silk.io.standard_input_native { OsStandardInput }
//! import silk.io.standard_input { StandardInput, StreamReadError }
//!
//! // Counts all bytes of standard input. Each read waits for input or its end.
//! effect fn countBytes() -> usize
//!   ! StreamReadError
//!   ? &mut StandardInput {
//!   let mut buffer: [u8; 4096] = [0; 4096]
//!   let mut total: usize = 0
//!   while true {
//!     let outcome = run StandardInput.receive(&mut buffer)
//!     if StandardInput.isEndOfInput(&outcome) {
//!       return total
//!     }
//!     total = total + StandardInput.count(&outcome)
//!   }
//!   return total
//! }
//!
//! pub effect fn main() -> i32
//!   ! StreamReadError {
//!   let mut input = OsStandardInput.make()
//!
//!   // An empty buffer returns 0 at once and does not read. Call `countBytes` to read everything.
//!   let mut empty: [u8; 0] = []
//!   let outcome = run StandardInput.receive(&mut empty)
//!     |> Effect.provideMut<StandardInput>(&mut input)
//!   if StandardInput.count(&outcome) != 0 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Input and output

static if (Intrinsic.targetOperatingSystem() == "windows" && Intrinsic.targetArchitecture() == "x86_64" && Intrinsic.targetAbi() == "msvc" && Intrinsic.profileText("libc") == "system") || Intrinsic.targetOperatingSystem() == "wasi" || (Intrinsic.targetOperatingSystem() == "darwin" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64") && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText("libc") == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
  static if Intrinsic.targetOperatingSystem() == "wasi" {
    import silk.platform.wasi.descriptor {WasiDescriptor as NativeDescriptor}
  } else {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    import silk.platform.windows.input {WindowsInput}
  } else {
    import silk.platform.native.descriptor {NativeDescriptor}
  }
  }
  import silk.io.standard_input { ReadOutcome, StandardInput, StreamReadError }

  /// The native `StandardInput` provider. The process owns the descriptor, and the provider does
  /// not close it.
  ///
  /// # Details
  /// Each read reads once from the descriptor, directly into your buffer, and returns the count
  /// that the system returned, which can be less than the buffer. After the system reports the
  /// end of input, later reads return the end without a system call.
  /// On Windows, `ReadFile` preserves redirected bytes and uses the active console input code
  /// page for console bytes. Broken pipes end input; other read failures raise `StreamReadError`.
  ///
  /// # Gotchas
  /// - An empty buffer returns a count of 0 without a read, also after the end of input.
  /// - A read waits until input arrives or ends.
  pub struct OsStandardInput {
    ended: bool,
  }

  impl OsStandardInput {
    /// Reads one time into `buffer`. A system count of 0 is the end of input.
    effect fn read(self: &mut Self, buffer: &mut [u8]) -> ReadOutcome ! StreamReadError {
      if buffer.length == 0 { return StandardInput.filled(0) }
      if self.ended { return StandardInput.endOfInput() }
      let mut nativeError = 0
      let mut length: usize = 0
      let mut received = false
      static if Intrinsic.targetOperatingSystem() == "windows" {
        received = run WindowsInput.read(move buffer, &mut length, &mut nativeError)
      } else {
        received = run NativeDescriptor.read(0, move buffer, &mut length, &mut nativeError)
      }
      if received == false { return run raise() }
      if length == 0 {
        self.ended = true
        return StandardInput.endOfInput()
      }
      return StandardInput.filled(length)
    }
  }

  impl OsStandardInput {
    /// Returns a provider. It does not read.
    pub fn make() -> OsStandardInput {
      return OsStandardInput { ended: false }
    }
  }

  effect fn raise() -> never ! StreamReadError {
    fail StandardInput.readFailure()
  }

  impl StandardInput for OsStandardInput {
    read: OsStandardInput.read
  }
}
