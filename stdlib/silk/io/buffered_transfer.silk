//! Copy bytes from one buffered session to another, and consume only what the destination accepts.
//!
//! # When to use
//! Use [`BufferedTransfer.transferAtMost`] or [`BufferedTransfer.transferExact`] inside
//! `silk.io.buffered_duplex.withBufferedPairCapacity` to forward a body or a stream, for example in a
//! proxy.
//!
//! # Details
//! The transfer reads into the input buffer of the source and offers those bytes to the output
//! buffer of the destination. It consumes from the source only the bytes that the destination
//! accepted. If a write fails, the bytes that were not accepted stay unread in the source. No
//! operation allocates.
//!
//! # Gotchas
//! The destination output buffer can still hold bytes after the transfer. Flush the destination
//! when the transfer is complete.
//!
//! @category Input and output

import silk.io.buffered_duplex {BufferedDuplex}
import silk.io.buffered_input {BufferError, FillOutcome}
import silk.io.byte_duplex {ByteDuplex}
import silk.core.effect {Effect}
import silk.system.monotonic_clock {MonotonicClock}
import silk.option {Option}
import silk.core.result {Result}
import silk.collections.slice {Slice}
import silk.system.system_clock {Instant, SystemClock}
import silk.num.usize

/// The result of [`BufferedTransfer.transferAtMost`].
pub struct TransferOutcome {
  /// The number of bytes that the destination accepted and the source consumed.
  pub count: usize,
  /// `true` if the transfer stopped because the source ended. `false` if it reached the limit.
  pub endObserved: bool,
}

/// The owner type of the transfer operations. It has no fields and is never constructed.
///
/// # When to use
///
/// Use [`BufferedTransfer.transferAtMost`] or [`BufferedTransfer.transferExact`] inside
/// `silk.io.buffered_duplex.withBufferedPairCapacity` to forward a body or a stream, for example in a
/// proxy.
pub struct BufferedTransfer {}

impl BufferedTransfer {
/// Copies up to `limit` bytes from `source` to `destination`. It stops early if the source ends.
///
/// # Details
///
/// It reads into the input buffer of `source` and offers those bytes to the output buffer of
/// `destination`. It consumes from `source` only the bytes that `destination` accepted. If a write
/// fails, the bytes that were not accepted stay unread in `source`. Nothing allocates.
/// `deadline` is an absolute time on the active `MonotonicClock`. `Option.none()` means no time
/// limit. It applies to each read and write.
///
/// # Errors
///
/// - `BufferError.Terminal` if an earlier failure or a close made a session unusable.
/// - `BufferError.ReadFailed` if a read of `source` fails, or `BufferError.WriteFailed` if a write
///   to `destination` fails. The failed session becomes terminal. `progress` and `accepted`
///   include the bytes that this call already transferred.
///
/// # Gotchas
///
/// The output buffer of `destination` can still hold bytes after the transfer. Flush `destination`
/// when the transfer is complete.
pub effect fn transferAtMost<'source, 'destination, SP, DP>(
  source: &mut BufferedDuplex<'source, SP>,
  destination: &mut BufferedDuplex<'destination, DP>,
  limit: usize,
  deadline: Option<Instant>,
) -> TransferOutcome
! BufferError
? &mut MonotonicClock
where &mut SP provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock,
  &mut DP provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock {
  let mut transferred = usize.ZERO
  while transferred < limit {
    let filling = run Effect.result(BufferedDuplex.fill(
      &mut source.*,
      usize.ONE,
      copyDeadline(&deadline),
    ))
    let fill = match move filling {
      Result<FillOutcome, BufferError>.Success {value} => move value
      Result<FillOutcome, BufferError>.Failure {error} => {
        fail addProgress(move error, transferred)
      }
    }
    let unread = BufferedDuplex.unread(&source.*)
    if unread == usize.ZERO {
      drop fill
      return TransferOutcome {count: transferred, endObserved: true}
    }
    let count = minimum(unread, limit - transferred)
    let available = BufferedDuplex.peek(&source.*)
    let offered = Slice.view<u8>(available, usize.ZERO, count)
    let writing = run Effect.result(BufferedDuplex.writeSome(
      &mut destination.*,
      offered,
      copyDeadline(&deadline),
    ))
    drop offered
    drop available
    let accepted = match move writing {
      Result<usize, BufferError>.Success {value} => value
      Result<usize, BufferError>.Failure {error} => {
        fail addProgress(move error, transferred)
      }
    }
    run BufferedDuplex.consume(&mut source.*, accepted)
    transferred = transferred + accepted
    drop fill
  }
  return TransferOutcome {count: transferred, endObserved: false}
}

/// Copies exactly `count` bytes from `source` to `destination`.
///
/// # Details
///
/// It consumes from `source` only the bytes that `destination` accepted. If a write fails, the
/// bytes that were not accepted stay unread in `source`. Nothing allocates. `deadline` is an
/// absolute time on the active `MonotonicClock`. `Option.none()` means no time limit. It applies to
/// each read and write.
///
/// # Errors
///
/// - `BufferError.UnexpectedEnd` if the source ends first. `progress` gives the number of bytes
///   that were transferred.
/// - `BufferError.Terminal` if an earlier failure or a close made a session unusable.
/// - `BufferError.ReadFailed` if a read of `source` fails, or `BufferError.WriteFailed` if a write
///   to `destination` fails. The failed session becomes terminal. `progress` and `accepted`
///   include the bytes that this call already transferred.
///
/// # Gotchas
///
/// The output buffer of `destination` can still hold bytes after the transfer. Flush `destination`
/// when the transfer is complete.
pub effect fn transferExact<'source, 'destination, SP, DP>(
  source: &mut BufferedDuplex<'source, SP>,
  destination: &mut BufferedDuplex<'destination, DP>,
  count: usize,
  deadline: Option<Instant>,
) -> ()
! BufferError
? &mut MonotonicClock
where &mut SP provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock,
  &mut DP provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock {
  let outcome = run BufferedTransfer.transferAtMost(
    move source,
    move destination,
    count,
    move deadline,
  )
  if outcome.count != count {
    fail BufferError.UnexpectedEnd {progress: outcome.count}
  }
  return ()
}
}

fn minimum(left: usize, right: usize) -> usize {
  if left < right { return left }
  return right
}

fn copyInstant(value: &Instant) -> Instant {
  return SystemClock.make(SystemClock.seconds(value), SystemClock.nanoseconds(value))
}

fn copyDeadline(value: &Option<Instant>) -> Option<Instant> {
  return match &value.* {
    Option<Instant>.None => Option<Instant>.none()
    Option<Instant>.Some {value: present} => Option<Instant>.some(copyInstant(&present))
  }
}

fn addProgress(failure: BufferError, prior: usize) -> BufferError {
  return match move failure {
    BufferError.ReadFailed {progress, error: cause} => BufferError.ReadFailed {
      progress: prior + progress,
      error: move cause,
    }
    BufferError.InputFailed {progress, error: cause} => BufferError.InputFailed {
      progress: prior + progress,
      error: move cause,
    }
    BufferError.WriteFailed {accepted, drained, error: cause} => BufferError.WriteFailed {
      accepted: prior + accepted,
      drained: drained,
      error: move cause,
    }
    BufferError.UnknownExternalTransfer {progress, error: cause} => BufferError.UnknownExternalTransfer {
      progress: prior + progress,
      error: move cause,
    }
    BufferError.UnexpectedEnd {progress} => BufferError.UnexpectedEnd {progress: prior + progress}
    BufferError.InvalidCapacity {capacity} => BufferError.InvalidCapacity {capacity: capacity}
    BufferError.BufferTooSmall {requested, capacity} => BufferError.BufferTooSmall {
      requested: requested,
      capacity: capacity,
    }
    BufferError.InvalidConsumption {requested, available} => BufferError.InvalidConsumption {
      requested: requested,
      available: available,
    }
    BufferError.InvalidReadCount {count, limit} => BufferError.InvalidReadCount {
      count: count,
      limit: limit,
    }
    BufferError.LengthOverflow => BufferError.LengthOverflow
    BufferError.Terminal => BufferError.Terminal
  }
}
