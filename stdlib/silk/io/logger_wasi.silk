//! A `Logger` provider for Preview 2 components whose host offers `wasi:logging`: [`WasiLogger`]
//! passes each message to `wasi:logging/logging.log`.
//!
//! # When to use
//! Provide [`WasiLogger`] for `Logger` in a `wasm32-wasip2` component that runs on a platform with
//! a `wasi:logging` host, such as Spin or wasmCloud, so the platform collects the messages with
//! their level. Everywhere else, `StderrLogger` from `silk.io.logger_native` writes to standard
//! error, which every WASI runtime supports.
//!
//! # Details
//! `wasi:logging` is a draft proposal, `wasi:logging@0.1.0-draft`, and not part of the command
//! world, so no logger uses it by default. The bundled WIT world `command` lists the interface, and
//! a component imports it only when it provides [`WasiLogger`]. A component with its own
//! `[component].world` imports `wasi:logging/logging@0.1.0-draft` there.
//!
//! Each call passes the level, the context given to [`WasiLogger.make`], and the formatted message.
//! The logger formats into a 512-byte buffer on the stack, so a longer message is passed as several
//! records, in order, each ending on a whole character. The logger does not allocate.
//!
//! # Errors
//! None. `wasi:logging` cannot refuse a message.
//!
//! # Gotchas
//! - The provider exists only on `wasm32-wasip2`.
//! - A host without `wasi:logging`, such as `wasmtime run`, refuses to instantiate a component that
//!   uses [`WasiLogger`].
//! - `LogLevel.Warning` is `warn` in `wasi:logging`. Its `critical` level has no Silk level.
//!
//! # Examples
//! ```silk,ignore
//! import silk.core.effect { Effect }
//! import silk.io.logger { LogError, Logger }
//! import silk.io.logger_wasi { WasiLogger }
//!
//! pub effect fn main() -> i32
//!   ! LogError {
//!   let mut logger = WasiLogger.make("startup")
//!   let values = .{ count: 3 }
//!
//!   // Logs "started 3 workers" at `info` with the context "startup".
//!   run Effect.logInfo("started {count} workers", &values)
//!     |> Effect.provideMut<Logger>(&mut logger)
//!   return 0
//! }
//! ```
//!
//! @category Input and output

static if Intrinsic.profileText("target") == "wasm32-wasip2" {
  import silk.io.writer { WriterError, Writer }
  import silk.io.logger { Logger, LogError, LogLevel }
  import silk.core.effect { Effect }
  import silk.collections.slice { Slice }
  import silk.text.format { Format }
  import silk.text.string { String }
  import silk.mem.pointer { Pointer }
  import silk.num.u32
  import silk.num.usize
  import silk.platform.wasi.preview2 as host

/// A `Logger` provider that passes each formatted message, its level and a fixed context to
/// `wasi:logging`.
///
/// # Details
///
/// A message longer than 512 bytes is passed as several records, in order, each ending on a whole character.
pub struct WasiLogger {
  context: string<'static>,
}

impl WasiLogger {
  /// Returns a logger that passes `context` with every message, such as the name of the
  /// component's part that logs. It does not call the host.
  pub fn make(context: string<'static>) -> WasiLogger { return WasiLogger { context: context } }

  effect fn writeRecord<Args>(
    self: &mut Self,
    level: LogLevel,
    static template: string<'static>,
    args: &Args
  ) -> () ! LogError {
    let mut record = LogRecord { bytes: [0; 512], length: 0, level: levelCode(level), context: self.context }
    let formatted = run Effect.result(formatRecord<Args>(&mut record, template, args))
    drop formatted
    let held = record.length
    record.send(held)
    return ()
  }
}

// The part of a message not yet passed to the host.
struct LogRecord {
  bytes: [u8; 512],
  length: usize,
  level: u32,
  context: string<'static>,
}

impl LogRecord {
  // Passes the first `count` held bytes to the host and keeps the rest at the front.
  fn send(self: &mut Self, count: usize) -> () {
    let context = String.utf8Bytes(self.context)
    let held = Slice.view<u8>(&self.bytes, usize.ZERO, count)
    // The level, then the context and the message, each as an address and a length.
    unsafe host.logging_logging_log(self.level, usize.toU32(Pointer.addressMany(Pointer.fromSlice(context))), usize.toU32(context.length),
      usize.toU32(Pointer.addressMany(Pointer.fromSlice(held))), usize.toU32(count))
    let mut at = count
    while at < self.length {
      self.bytes[at - count] = self.bytes[at]
      at = at + usize.ONE
    }
    self.length = self.length - count
  }

  // The held bytes that end on a whole character: the host refuses a string that ends inside one.
  fn whole(self: &Self) -> usize {
    let mut start = self.length - usize.ONE
    while start > usize.ZERO && self.bytes[start] >= 0x80 && self.bytes[start] < 0xC0 { start = start - usize.ONE }
    let lead = self.bytes[start]
    let mut width = usize.ONE
    if lead >= 0xF0 {
      width = 4
    } else if lead >= 0xE0 {
      width = 3
    } else if lead >= 0xC0 {
      width = 2
    }
    if start + width <= self.length || start == usize.ZERO { return self.length }
    return start
  }
}

impl Writer for LogRecord {
  effect fn writeAll(self: &mut Self, bytes: &[u8]) -> () ! WriterError ? &mut Writer {
    let mut index = usize.ZERO
    while index < bytes.length {
      if self.length == 512 {
        let whole = self.whole()
        self.send(whole)
      }
      self.bytes[self.length] = bytes[index]
      self.length = self.length + usize.ONE
      index = index + usize.ONE
    }
    return ()
  }

  effect fn flush(self: &mut Self) -> () ! WriterError ? &mut Writer { return () }
}

effect fn formatRecord<Args>(
  record: &mut LogRecord,
  static template: string<'static>,
  args: &Args
) -> () ! WriterError {
  return run Format.format<Args>(template, args) |> Effect.provideMut<Writer>(&mut record)
}

// The `wasi:logging` level: trace, debug, info, warn, error, critical.
fn levelCode(level: LogLevel) -> u32 {
  return match level {
    LogLevel.Trace => 0
    LogLevel.Debug => 1
    LogLevel.Info => 2
    LogLevel.Warning => 3
    LogLevel.Error => 4
  }
}

impl Logger for WasiLogger {
  log: WasiLogger.writeRecord
}

}
