//! A fixed-size input buffer for parsers that must look at bytes before they use them.
//!
//! # When to use
//! Use [`BufferedInput`] to parse a protocol from a `ByteDuplex` transport or from `StandardInput`.
//! For example, a parser can look for a line end with [`BufferedInput.peek`] and then remove only
//! that line with [`BufferedInput.consume`]. The bytes after the line stay in the buffer for the
//! next step. In a scoped session that also writes, use `silk.io.buffered_duplex.BufferedDuplex`.
//!
//! # Details
//! [`BufferedInput.make`] allocates the buffer one time. No other operation allocates.
//! [`BufferedInput.fill`] reads from the transport until the buffer holds a minimum number of
//! unread bytes or the transport ends. [`BufferedInput.peek`] returns the unread bytes and does not
//! change the buffer. [`BufferedInput.consume`] removes bytes from the front.
//!
//! When the transport ends, the end is recorded, and later fills do not read again. The bytes that
//! were read before the end stay available.
//!
//! # Errors
//! - [`BufferError`] for each failure. A transport failure makes the buffer terminal, and each
//!   later fill fails with `BufferError.Terminal`.
//!
//! # Gotchas
//! A message that is longer than the capacity cannot be in the buffer at one time. Choose the
//! capacity for the longest unit that the parser must see, such as the longest header line.
//!
//! # Examples
//! ## Read one line and keep the rest
//! ```silk
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.io.buffered_input { BufferError, BufferedInput }
//! import silk.io.byte_duplex { ByteDuplex }
//! import silk.collections.bytes { Bytes }
//! import silk.core.effect { Effect }
//! import silk.collections.list { List }
//! import silk.io.memory_byte_duplex { MemoryByteDuplex, MemoryReadEvent, MemoryWriteEvent }
//! import silk.system.monotonic_clock { MonotonicClock }
//! import silk.option { Option }
//! import silk.system.system_clock { Instant, SystemClock }
//!
//! struct FixedClock {}
//!
//! impl MonotonicClock for FixedClock {
//!   effect fn now(self: &mut Self) -> Instant {
//!     return SystemClock.make(0, 0)
//!   }
//!
//!   effect fn getResolution(self: &mut Self) -> u64 {
//!     return 1
//!   }
//!
//!   effect fn waitUntil(self: &mut Self, when: Instant) -> () {
//!     return ()
//!   }
//!
//!   effect fn waitFor(self: &mut Self, howLong: u64) -> () {
//!     return ()
//!   }
//! }
//!
//! effect fn transport() -> MemoryByteDuplex
//!   ! OutOfMemoryError
//!   ? &mut Allocator {
//!   let mut reads = List<MemoryReadEvent>.make()
//!   let bytes = run Bytes.copy(&b"GET\nrest")
//!   run List<MemoryReadEvent>.append(
//!     &mut reads,
//!     MemoryReadEvent.Data { readyAt: SystemClock.make(0, 0), bytes: move bytes }
//!   )
//!   run List<MemoryReadEvent>.append(
//!     &mut reads,
//!     MemoryReadEvent.End { readyAt: SystemClock.make(0, 0) }
//!   )
//!   return run MemoryByteDuplex.make(
//!     move reads,
//!     List<MemoryWriteEvent>.make(),
//!     0,
//!     8,
//!     Option<i32>.none()
//!   )
//! }
//!
//! // Reads bytes up to the first newline and returns how many came before it.
//! effect fn firstLineLength(input: &mut BufferedInput) -> usize
//!   ! BufferError
//!   ? &mut ByteDuplex | &mut MonotonicClock {
//!   let filled = run BufferedInput.fill(&mut input, 4, Option<Instant>.none())
//!   drop filled
//!   let view = BufferedInput.peek(&input)
//!   let mut length: usize = 0
//!   while length < view.length && view[length] != 10 {
//!     length = length + 1
//!   }
//!   drop view
//!   run BufferedInput.consume(&mut input, length + 1)
//!   return length
//! }
//!
//! pub effect fn main() -> i32
//!   ! BufferError | OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let mut clock = FixedClock {}
//!   let mut duplex = run transport() |> Effect.provideMut<Allocator>(&mut allocator)
//!   let mut input = run BufferedInput.make(16) |> Effect.provideMut<Allocator>(&mut allocator)
//!   let length = run firstLineLength(&mut input) |> Effect.provideMut<ByteDuplex>(&mut duplex)
//!     |> Effect.provideMut<MonotonicClock>(&mut clock)
//!   if length != 3 || BufferedInput.unread(&input) != 4 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Input and output

import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.io.byte_duplex {ByteDuplex, ByteIoError, ReadTransfer}
import silk.core.effect {Effect}
import silk.format {Debug, Format, Formatter}
import silk.layout {Layout}
import silk.system.monotonic_clock {MonotonicClock}
import silk.option {Option}
import silk.mem.raw_buffer {RawBuffer}
import silk.core.result {Result}
import silk.io.standard_input {ReadOutcome, StandardInput, StreamReadError}
import silk.system.system_clock {Instant, SystemClock}
import silk.num.usize
import silk.io.writer {Writer, WriterError}

/// The largest capacity that a buffer can have: 1 MiB (1,048,576 bytes).
pub const MAX_CAPACITY: usize = 1048576

/// The error from a buffered input, output, or transfer operation.
///
/// # Details
///
/// The failures that report progress give the number of bytes that the operation completed before
/// the failure. This tells a protocol exactly where the stream stopped.
pub union BufferError {
  /// The capacity was 0 or more than [`MAX_CAPACITY`]. Nothing was allocated.
  InvalidCapacity {
    /// The capacity that was rejected, in bytes.
    pub capacity: usize,
  },
  /// A fill asked for more bytes than the buffer can hold.
  BufferTooSmall {
    /// The minimum byte count that was requested.
    pub requested: usize,
    /// The capacity of the buffer, in bytes.
    pub capacity: usize,
  },
  /// A consume asked to remove more bytes than are unread. The buffer did not change.
  InvalidConsumption {
    /// The byte count that was requested.
    pub requested: usize,
    /// The number of unread bytes.
    pub available: usize,
  },
  /// An input provider reported a byte count that is not possible: 0, or more than the space it was
  /// given.
  InvalidReadCount {
    /// The count that the provider reported.
    pub count: usize,
    /// The space that the provider was given, in bytes.
    pub limit: usize,
  },
  /// The transport ended before an exact read, discard, or transfer completed.
  UnexpectedEnd {
    /// The number of bytes that the operation completed before the end.
    pub progress: usize,
  },
  /// A `ByteDuplex` read failed. The buffer becomes terminal.
  ReadFailed {
    /// The number of bytes that the operation completed before the failure.
    pub progress: usize,
    /// The transport error.
    pub error: ByteIoError,
  },
  /// A `StandardInput` read failed. The buffer becomes terminal.
  InputFailed {
    /// The number of bytes that the operation completed before the failure.
    pub progress: usize,
    /// The standard input error.
    pub error: StreamReadError,
  },
  /// A `ByteDuplex` write or flush failed. The output buffer becomes terminal.
  WriteFailed {
    /// The number of bytes of the current input that the buffer accepted before the failure.
    pub accepted: usize,
    /// The number of pending bytes that the transport received during the failed operation.
    pub drained: usize,
    /// The transport error.
    pub error: ByteIoError,
  },
  /// A `Writer` call failed. The `Writer` does not report how many bytes of that call it wrote.
  UnknownExternalTransfer {
    /// The number of bytes from earlier calls that completed before the failed call.
    pub progress: usize,
    /// The `Writer` error.
    pub error: WriterError,
  },
  /// The total length of the input slices does not fit in `usize`. Nothing was written.
  LengthOverflow,
  /// An earlier transport failure or a close made the buffer unusable.
  Terminal,
}

impl Debug for BufferError {
  /// Writes the name of the variant and its fields, such as `InvalidCapacity { ... }`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      BufferError.InvalidCapacity { capacity } => {
        let mut record = run Format.debugRecord("InvalidCapacity", &mut formatter)
        run Format.debugField(&mut record, "capacity", &capacity, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      BufferError.BufferTooSmall { requested, capacity } => {
        let mut record = run Format.debugRecord("BufferTooSmall", &mut formatter)
        run Format.debugField(&mut record, "requested", &requested, &mut formatter)
        run Format.debugField(&mut record, "capacity", &capacity, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      BufferError.InvalidConsumption { requested, available } => {
        let mut record = run Format.debugRecord("InvalidConsumption", &mut formatter)
        run Format.debugField(&mut record, "requested", &requested, &mut formatter)
        run Format.debugField(&mut record, "available", &available, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      BufferError.InvalidReadCount { count, limit } => {
        let mut record = run Format.debugRecord("InvalidReadCount", &mut formatter)
        run Format.debugField(&mut record, "count", &count, &mut formatter)
        run Format.debugField(&mut record, "limit", &limit, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      BufferError.UnexpectedEnd { progress } => {
        let mut record = run Format.debugRecord("UnexpectedEnd", &mut formatter)
        run Format.debugField(&mut record, "progress", &progress, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      BufferError.ReadFailed { progress, error } => {
        let mut record = run Format.debugRecord("ReadFailed", &mut formatter)
        run Format.debugField(&mut record, "progress", &progress, &mut formatter)
        run Format.debugField(&mut record, "error", &error, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      BufferError.InputFailed { progress, error } => {
        let mut record = run Format.debugRecord("InputFailed", &mut formatter)
        run Format.debugField(&mut record, "progress", &progress, &mut formatter)
        run Format.debugField(&mut record, "error", &error, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      BufferError.WriteFailed { accepted, drained, error } => {
        let mut record = run Format.debugRecord("WriteFailed", &mut formatter)
        run Format.debugField(&mut record, "accepted", &accepted, &mut formatter)
        run Format.debugField(&mut record, "drained", &drained, &mut formatter)
        run Format.debugField(&mut record, "error", &error, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      BufferError.UnknownExternalTransfer { progress, error } => {
        let mut record = run Format.debugRecord("UnknownExternalTransfer", &mut formatter)
        run Format.debugField(&mut record, "progress", &progress, &mut formatter)
        run Format.debugField(&mut record, "error", &error, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      BufferError.LengthOverflow => run Format.write(&mut formatter, b"LengthOverflow")
      BufferError.Terminal => run Format.write(&mut formatter, b"Terminal")
    }
  }
}

/// The result of a fill.
pub union FillOutcome {
  /// The buffer holds at least the requested number of unread bytes.
  Available {
    /// The number of unread bytes. It can be more than the requested minimum.
    pub count: usize,
  },
  /// The transport ended. The buffer can hold fewer bytes than requested.
  End {
    /// The number of unread bytes that are still in the buffer.
    pub available: usize,
  },
}

/// The result of [`BufferedInput.discardAtMost`].
pub struct DiscardOutcome {
  /// The number of bytes that were discarded.
  pub count: usize,
  /// `true` if the operation stopped because the transport ended. `false` if it reached the limit.
  pub endObserved: bool,
}

/// A fixed-size input buffer for parsers that must look at bytes before they use them. Make one
/// with [`BufferedInput.make`].
///
/// # When to use
///
/// Use it to parse a protocol from a `ByteDuplex` transport or from `StandardInput`. For example,
/// a parser can look for a line end with [`BufferedInput.peek`] and then remove only that line with
/// [`BufferedInput.consume`]. The bytes after the line stay in the buffer for the next step. In a
/// scoped session that also writes, use `silk.io.buffered_duplex.BufferedDuplex`.
///
/// # Details
///
/// [`BufferedInput.make`] allocates the buffer one time. No other operation allocates. When the
/// transport ends, the end is recorded, and later fills do not read again. The bytes that were read
/// before the end stay available. A transport failure makes the buffer terminal, and each later
/// fill fails with `BufferError.Terminal`.
///
/// # Gotchas
///
/// A message that is longer than the capacity cannot be in the buffer at one time. Choose the
/// capacity for the longest unit that the parser must see, such as the longest header line.
pub struct BufferedInput {
  storage: Intrinsic.RawBuffer<u8>,
  capacityValue: usize,
  start: usize,
  end: usize,
  ended: bool,
  terminal: bool,
}

impl BufferedInput {
  /// Returns an empty buffer that holds at most `capacity` bytes.
  ///
  /// # Errors
  ///
  /// - `BufferError.InvalidCapacity` if `capacity` is 0 or more than [`MAX_CAPACITY`]. Nothing is
  ///   allocated.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply `capacity` bytes.
  pub effect fn make(capacity: usize) -> BufferedInput
  ! BufferError | OutOfMemoryError
  ? &mut Allocator {
    if capacity == usize.ZERO || capacity > MAX_CAPACITY {
      fail BufferError.InvalidCapacity {capacity: capacity}
    }
    let allocation = run Allocator.allocate(Layout {bytes: capacity, alignment: usize.ONE})
    // The allocation was requested for `capacity` bytes with byte alignment.
    let mut storage = unsafe RawBuffer.from<u8>(move allocation, capacity)
    RawBuffer.fill(&mut storage, usize.ZERO, capacity, 0)
    return BufferedInput {
      storage: move storage,
      capacityValue: capacity,
      start: usize.ZERO,
      end: usize.ZERO,
      ended: false,
      terminal: false,
    }
  }

  /// Returns the capacity in bytes. It does not change.
  pub fn capacity(self: &Self) -> usize { return self.capacityValue }

  /// Returns the number of bytes that were read from the transport and not yet consumed.
  pub fn unread(self: &Self) -> usize { return self.end - self.start }

  /// Returns `true` if the transport ended. Unread bytes can still be in the buffer.
  pub fn isEnded(self: &Self) -> bool { return self.ended }

  /// Returns `true` if a transport failure made the buffer unusable.
  pub fn isTerminal(self: &Self) -> bool { return self.terminal }

  /// Returns the unread bytes. It does not read from the transport and does not change the buffer.
  ///
  /// # Details
  ///
  /// The slice borrows the buffer. Drop the slice before you call an operation that changes the
  /// buffer.
  pub fn peek<'a>(self: &'a Self) -> &'a [u8] {
    // `make` zero-fills all `capacity` bytes, so every slot stays initialized, and `start <= end <=
    // capacity` holds between operations.
    return unsafe RawBuffer.view<u8>(&self.storage, self.start, self.end - self.start)
  }

  /// Removes `count` unread bytes from the front of the buffer.
  ///
  /// # Errors
  ///
  /// - `BufferError.InvalidConsumption` if `count` is more than [`BufferedInput.unread`]. The
  ///   buffer does not change.
  pub effect fn consume(self: &mut Self, count: usize) -> () ! BufferError {
    let available = self.end - self.start
    if count > available {
      fail BufferError.InvalidConsumption {requested: count, available: available}
    }
    self.start = self.start + count
    if self.start == self.end {
      self.start = usize.ZERO
      self.end = usize.ZERO
    }
    return ()
  }

  /// Reads from the `ByteDuplex` transport until the buffer holds at least `minimum` unread bytes,
  /// or until the transport ends.
  ///
  /// # Details
  ///
  /// If the buffer already holds `minimum` bytes, it does not read. Each read asks for all free
  /// space, so the buffer can hold more than `minimum` bytes after the call. Unread bytes move to
  /// the front of the buffer when necessary. A `minimum` of 0 never reads. `deadline` is an
  /// absolute time on the active `MonotonicClock`. `Option.none()` means no time limit.
  ///
  /// # Errors
  ///
  /// - `BufferError.BufferTooSmall` if `minimum` is more than the capacity.
  /// - `BufferError.Terminal` if an earlier failure made the buffer unusable.
  /// - `BufferError.ReadFailed` if a read fails. The buffer becomes terminal. `progress` gives the
  ///   bytes that this call added.
  pub effect fn fill(
    self: &mut Self,
    minimum: usize,
    deadline: Option<Instant>,
  ) -> FillOutcome
  ! BufferError
  ? &mut ByteDuplex | &mut MonotonicClock {
    if minimum > self.capacityValue {
      fail BufferError.BufferTooSmall {requested: minimum, capacity: self.capacityValue}
    }
    if minimum == usize.ZERO {
      return FillOutcome.Available {count: self.end - self.start}
    }
    if self.terminal { fail BufferError.Terminal }
    let initial = self.end - self.start
    while self.end - self.start < minimum && !self.ended {
      compact(&mut self.*)
      let tail = self.capacityValue - self.end
      // `end <= capacity` and `tail = capacity - end`, so the view stays in bounds; the zero fill
      // at `make` keeps every byte initialized.
      let mut output = unsafe RawBuffer.viewMut<u8>(&mut self.storage, self.end, tail)
      let attempted = run Effect.result(ByteDuplex.readSome(&mut output, copyDeadline(&deadline)))
      drop output
      let transfer = match move attempted {
        Result<ReadTransfer, ByteIoError>.Success {value} => move value
        Result<ReadTransfer, ByteIoError>.Failure {error} => {
          self.terminal = true
          fail BufferError.ReadFailed {
            progress: self.end - self.start - initial,
            error: move error,
          }
        }
      }
      match move transfer {
        ReadTransfer.Data {count} => { self.end = self.end + count }
        ReadTransfer.End => { self.ended = true }
      }
    }
    let available = self.end - self.start
    if self.ended { return FillOutcome.End {available: available} }
    return FillOutcome.Available {count: available}
  }

  /// Reads from `StandardInput` until the buffer holds at least `minimum` unread bytes, or until
  /// the transport ends.
  ///
  /// # Details
  ///
  /// If the buffer already holds `minimum` bytes, it does not read. Each read asks for all free
  /// space, so the buffer can hold more than `minimum` bytes after the call. Unread bytes move to
  /// the front of the buffer when necessary. A `minimum` of 0 never reads. There is no deadline.
  ///
  /// # Errors
  ///
  /// - `BufferError.BufferTooSmall` if `minimum` is more than the capacity.
  /// - `BufferError.Terminal` if an earlier failure made the buffer unusable.
  /// - `BufferError.InputFailed` if a read fails. The buffer becomes terminal. `progress` gives the
  ///   bytes that this call added.
  /// - `BufferError.InvalidReadCount` if the provider reports a count that is not possible. The
  ///   buffer becomes terminal.
  pub effect fn fillStandard(self: &mut Self, minimum: usize) -> FillOutcome
  ! BufferError
  ? &mut StandardInput {
    if minimum > self.capacityValue {
      fail BufferError.BufferTooSmall {requested: minimum, capacity: self.capacityValue}
    }
    if minimum == usize.ZERO {
      return FillOutcome.Available {count: self.end - self.start}
    }
    if self.terminal { fail BufferError.Terminal }
    let initial = self.end - self.start
    while self.end - self.start < minimum && !self.ended {
      compact(&mut self.*)
      let tail = self.capacityValue - self.end
      // `end <= capacity` and `tail = capacity - end`, so the view stays in bounds; the zero fill
      // at `make` keeps every byte initialized.
      let mut output = unsafe RawBuffer.viewMut<u8>(&mut self.storage, self.end, tail)
      let attempted = run Effect.result(StandardInput.receive(&mut output))
      drop output
      let outcome = match move attempted {
        Result<ReadOutcome, StreamReadError>.Success {value} => move value
        Result<ReadOutcome, StreamReadError>.Failure {error} => {
          self.terminal = true
          fail BufferError.InputFailed {
            progress: self.end - self.start - initial,
            error: move error,
          }
        }
      }
      if StandardInput.isEndOfInput(&outcome) {
        self.ended = true
      } else {
        let count = StandardInput.count(&outcome)
        if count == usize.ZERO || count > tail {
          self.terminal = true
          fail BufferError.InvalidReadCount {count: count, limit: tail}
        }
        self.end = self.end + count
      }
    }
    let available = self.end - self.start
    if self.ended { return FillOutcome.End {available: available} }
    return FillOutcome.Available {count: available}
  }

  /// Copies unread bytes into `output` and consumes them. Reads from the transport first if the
  /// buffer is empty.
  ///
  /// # Details
  ///
  /// The result is `ReadTransfer.Data` with a count from 1 to `output.length`, or
  /// `ReadTransfer.End` if the transport ended and the buffer is empty. An empty `output` returns a
  /// count of 0 and does not read. `deadline` is an absolute time on the active `MonotonicClock`.
  /// `Option.none()` means no time limit.
  ///
  /// # Errors
  ///
  /// - `BufferError.Terminal` if an earlier failure made the buffer unusable.
  /// - `BufferError.ReadFailed` if a read fails. The buffer becomes terminal. `progress` gives the
  ///   bytes that this call added.
  pub effect fn readSome(
    self: &mut Self,
    output: &mut [u8],
    deadline: Option<Instant>,
  ) -> ReadTransfer
  ! BufferError
  ? &mut ByteDuplex | &mut MonotonicClock {
    if output.length == usize.ZERO { return ReadTransfer.Data {count: usize.ZERO} }
    let filled = run BufferedInput.fill(&mut self.*, usize.ONE, move deadline)
    let available = self.end - self.start
    if available == usize.ZERO {
      drop filled
      return ReadTransfer.End
    }
    let count = minimum(available, output.length)
    copyOut(&self.storage, self.start, move output, count)
    run BufferedInput.consume(&mut self.*, count)
    drop filled
    return ReadTransfer.Data {count: count}
  }

  /// Copies unread bytes into `output` and consumes them. Reads from `StandardInput` first if the
  /// buffer is empty.
  ///
  /// # Details
  ///
  /// The result is `ReadTransfer.Data` with a count from 1 to `output.length`, or
  /// `ReadTransfer.End` if the transport ended and the buffer is empty. An empty `output` returns a
  /// count of 0 and does not read.
  ///
  /// # Errors
  ///
  /// - `BufferError.Terminal` if an earlier failure made the buffer unusable.
  /// - `BufferError.InputFailed` if a read fails. The buffer becomes terminal. `progress` gives the
  ///   bytes that this call added.
  /// - `BufferError.InvalidReadCount` if the provider reports a count that is not possible. The
  ///   buffer becomes terminal.
  pub effect fn readSomeStandard(self: &mut Self, output: &mut [u8]) -> ReadTransfer
  ! BufferError
  ? &mut StandardInput {
    if output.length == usize.ZERO { return ReadTransfer.Data {count: usize.ZERO} }
    let filled = run BufferedInput.fillStandard(&mut self.*, usize.ONE)
    let available = self.end - self.start
    if available == usize.ZERO {
      drop filled
      return ReadTransfer.End
    }
    let count = minimum(available, output.length)
    copyOut(&self.storage, self.start, move output, count)
    run BufferedInput.consume(&mut self.*, count)
    drop filled
    return ReadTransfer.Data {count: count}
  }

  /// Fills all of `output` with the next bytes and consumes them.
  ///
  /// # Details
  ///
  /// `deadline` is an absolute time on the active `MonotonicClock`. `Option.none()` means no time
  /// limit. It applies to each read.
  ///
  /// # Errors
  ///
  /// - `BufferError.UnexpectedEnd` if the transport ends first. `progress` gives the number of
  ///   bytes that were copied into `output`.
  /// - `BufferError.Terminal` if an earlier failure made the buffer unusable.
  /// - `BufferError.ReadFailed` if a read fails. The buffer becomes terminal. `progress` includes
  ///   the bytes that this call copied before the failure.
  pub effect fn readExact(
    self: &mut Self,
    output: &mut [u8],
    deadline: Option<Instant>,
  ) -> ()
  ! BufferError
  ? &mut ByteDuplex | &mut MonotonicClock {
    let mut copied = usize.ZERO
    while copied < output.length {
      let attempted = run Effect.result(BufferedInput.fill(
        &mut self.*,
        usize.ONE,
        copyDeadline(&deadline),
      ))
      match move attempted {
        Result<FillOutcome, BufferError>.Failure {error} => {
          fail addReadProgress(move error, copied)
        }
        Result<FillOutcome, BufferError>.Success {value} => {
          let available = self.end - self.start
          if available == usize.ZERO {
            drop value
            fail BufferError.UnexpectedEnd {progress: copied}
          }
          let count = minimum(available, output.length - copied)
          copyOutAt(&self.storage, self.start, &mut output, copied, count)
          run BufferedInput.consume(&mut self.*, count)
          copied = copied + count
          drop value
        }
      }
    }
    return ()
  }

  /// Consumes and drops up to `limit` bytes. It stops early if the transport ends.
  ///
  /// # When to use
  ///
  /// Use it to skip a body or a field of a known maximum length.
  ///
  /// # Details
  ///
  /// The result gives the number of discarded bytes and if the transport ended. `deadline` is an
  /// absolute time on the active `MonotonicClock`. `Option.none()` means no time limit.
  ///
  /// # Errors
  ///
  /// - `BufferError.Terminal` if an earlier failure made the buffer unusable.
  /// - `BufferError.ReadFailed` if a read fails. The buffer becomes terminal. `progress` gives the
  ///   bytes that this call added.
  pub effect fn discardAtMost(
    self: &mut Self,
    limit: usize,
    deadline: Option<Instant>,
  ) -> DiscardOutcome
  ! BufferError
  ? &mut ByteDuplex | &mut MonotonicClock {
    let mut discarded = usize.ZERO
    while discarded < limit {
      let filled = run BufferedInput.fill(&mut self.*, usize.ONE, copyDeadline(&deadline))
      let available = self.end - self.start
      if available == usize.ZERO {
        drop filled
        return DiscardOutcome {count: discarded, endObserved: true}
      }
      let count = minimum(available, limit - discarded)
      run BufferedInput.consume(&mut self.*, count)
      discarded = discarded + count
      drop filled
    }
    return DiscardOutcome {count: discarded, endObserved: false}
  }

  /// Consumes and drops exactly `count` bytes.
  ///
  /// # Details
  ///
  /// `deadline` is an absolute time on the active `MonotonicClock`. `Option.none()` means no time
  /// limit.
  ///
  /// # Errors
  ///
  /// - `BufferError.UnexpectedEnd` if the transport ends first. `progress` gives the number of
  ///   bytes that were discarded.
  /// - `BufferError.Terminal` if an earlier failure made the buffer unusable.
  /// - `BufferError.ReadFailed` if a read fails. The buffer becomes terminal. `progress` gives the
  ///   bytes that this call added.
  pub effect fn discardExact(
    self: &mut Self,
    count: usize,
    deadline: Option<Instant>,
  ) -> ()
  ! BufferError
  ? &mut ByteDuplex | &mut MonotonicClock {
    let outcome = run BufferedInput.discardAtMost(&mut self.*, count, move deadline)
    if outcome.count != count {
      fail BufferError.UnexpectedEnd {progress: outcome.count}
    }
    return ()
  }
}

fn compact(input: &mut BufferedInput) -> () {
  if input.start == usize.ZERO { return () }
  let unread = input.end - input.start
  let mut index = usize.ZERO
  while index < unread {
    // Each index stays below `end - start`, so both reads and writes stay within 0..end. `make`
    // zero-fills all `capacity` bytes, so every slot stays initialized, and `start <= end <=
    // capacity` holds between operations.
    unsafe {
      let value = RawBuffer.read<u8>(&input.storage, input.start + index)
      let mut destination = RawBuffer.viewMut<u8>(&mut input.storage, index, usize.ONE)
      destination[usize.ZERO] = value
      drop destination
    }
    index = index + usize.ONE
  }
  input.start = usize.ZERO
  input.end = unread
}

// Every caller passes `start + count` within the storage's capacity and `count` within
// `output.length`.
fn copyOut(storage: &Intrinsic.RawBuffer<u8>, start: usize, output: &mut [u8], count: usize) -> () {
  copyOutAt(storage, start, move output, usize.ZERO, count)
}

// Every caller passes `start + count` within the storage's capacity and `outputStart + count`
// within `output.length`.
fn copyOutAt(
  storage: &Intrinsic.RawBuffer<u8>,
  start: usize,
  output: &mut [u8],
  outputStart: usize,
  count: usize,
) -> () {
  let mut index = usize.ZERO
  while index < count {
    // In bounds by the caller contract above; the zero fill at `make` keeps every byte initialized.
    output[outputStart + index] = unsafe RawBuffer.read<u8>(storage, start + index)
    index = index + usize.ONE
  }
}

fn minimum(left: usize, right: usize) -> usize {
  if left < right { return left }
  return right
}

fn copyInstant(value: &Instant) -> Instant {
  return SystemClock.make(SystemClock.seconds(value), SystemClock.nanoseconds(value))
}

fn copyDeadline(value: &Option<Instant>) -> Option<Instant> {
  return match &value.* {
    Option<Instant>.None => Option<Instant>.none()
    Option<Instant>.Some {value: present} => Option<Instant>.some(copyInstant(&present))
  }
}

fn addReadProgress(failure: BufferError, prior: usize) -> BufferError {
  return match move failure {
    BufferError.ReadFailed {progress, error: cause} => BufferError.ReadFailed {
      progress: prior + progress,
      error: move cause,
    }
    BufferError.InputFailed {progress, error: cause} => BufferError.InputFailed {
      progress: prior + progress,
      error: move cause,
    }
    BufferError.UnexpectedEnd {progress} => BufferError.UnexpectedEnd {progress: prior + progress}
    BufferError.InvalidCapacity {capacity} => BufferError.InvalidCapacity {capacity: capacity}
    BufferError.BufferTooSmall {requested, capacity} => BufferError.BufferTooSmall {
      requested: requested,
      capacity: capacity,
    }
    BufferError.InvalidConsumption {requested, available} => BufferError.InvalidConsumption {
      requested: requested,
      available: available,
    }
    BufferError.InvalidReadCount {count, limit} => BufferError.InvalidReadCount {
      count: count,
      limit: limit,
    }
    BufferError.WriteFailed {accepted, drained, error: cause} => BufferError.WriteFailed {
      accepted: accepted,
      drained: drained,
      error: move cause,
    }
    BufferError.UnknownExternalTransfer {progress, error: cause} => BufferError.UnknownExternalTransfer {
      progress: progress,
      error: move cause,
    }
    BufferError.LengthOverflow => BufferError.LengthOverflow
    BufferError.Terminal => BufferError.Terminal
  }
}
