//! Compare JSON numbers and test divisibility without rounding to binary floating point.
//!
//! # Details
//! Inputs must be valid JSON number spellings. Exponents and coefficients have no machine-integer
//! limit. Comparisons, integer checks, and bounded conversions do not allocate. Divisibility uses
//! decimal integer arithmetic and needs storage proportional to the significands, not exponents.
//!
//! @category Data formats

import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.i32
import silk.num.u8
import silk.num.usize
import silk.text.string { String }

/// Exact operations on validated JSON number spellings, including arbitrary-length exponents.
pub struct SchemaNumber {}

impl SchemaNumber {
  /// Returns -1, 0, or 1 according to the mathematical order of two valid JSON numbers.
  /// Signs, decimal places, exponent spelling, and negative zero do not affect equality.
  /// This operation does not allocate or convert either number to floating point.
  pub fn compare(left: string, right: string) -> i32 {
    let a = parts(left)
    let b = parts(right)
    if a.length == 0 && b.length == 0 { return 0 }
    if a.length == 0 {
      if b.negative { return 1 }
      return -1
    }
    if b.length == 0 {
      if a.negative { return -1 }
      return 1
    }
    if a.negative != b.negative {
      if a.negative { return -1 }
      return 1
    }
    let mut order = scaleCompare(&a, &b, a.length, b.length)
    if order == 0 {
      let mut ai = a.first
      let mut bi = b.first
      while ai < a.end || bi < b.end {
        if ai < a.end && a.bytes[ai] == 46 { ai = ai + 1 }
        if bi < b.end && b.bytes[bi] == 46 { bi = bi + 1 }
        let mut ad: u8 = 48
        let mut bd: u8 = 48
        if ai < a.end {
          ad = a.bytes[ai]
          ai = ai + 1
        }
        if bi < b.end {
          bd = b.bytes[bi]
          bi = bi + 1
        }
        if ad < bd {
          order = -1
          break
        }
        if ad > bd {
          order = 1
          break
        }
      }
    }
    if a.negative { return -order }
    return order
  }

  /// Returns whether a valid JSON number is mathematically integral, including `1.0` and `1e3`.
  /// Zero is integral for every exponent. This operation does not allocate.
  pub fn isInteger(value: string) -> bool {
    let a = parts(value)
    let zero = parts("0")
    return a.length == 0 || scaleCompare(&a, &zero, 0, 0) >= 0
  }

  /// Returns whether `value` is an exact integer multiple of the positive JSON number `divisor`.
  /// Decimal fractions are exact: `0.3` is a multiple of `0.1`. Negative values and zero are
  /// accepted; a nonpositive divisor returns false. Storage depends on significand length only.
  ///
  /// # Errors
  /// - `OutOfMemoryError` if decimal integer scratch storage cannot be allocated.
  pub effect fn multipleOf(value: string, divisor: string) -> bool
    ! OutOfMemoryError ? &mut Allocator {
    let a = parts(value)
    let b = parts(divisor)
    if b.length == 0 || b.negative { return false }
    if a.length == 0 { return true }
    // Normalized coefficients are not divisible by ten. A negative decimal scale difference
    // therefore cannot produce an integer quotient, whatever the denominator's other factors.
    if scaleCompare(&a, &b, 0, 0) < 0 { return false }
    let mut numerator = run coefficient(&a)
    let mut denominator = run coefficient(&b)
    let a2 = removeFactors(&mut numerator, 2)
    let a5 = removeFactors(&mut numerator, 5)
    let b2 = removeFactors(&mut denominator, 2)
    let b5 = removeFactors(&mut denominator, 5)
    if scaleCompare(&a, &b, a2, b2) < 0 || scaleCompare(&a, &b, a5, b5) < 0 {
      return false
    }
    if List<u8>.length(&denominator) == 1 && List<u8>.asSlice(&denominator)[0] == 1 {
      return true
    }
    let mut remainder = List<u8>.make()
    let digits = List<u8>.asSlice(&numerator)
    let mut index = digits.length
    while index > 0 {
      index = index - 1
      run shiftDigit(&mut remainder, digits[index])
      while integerCompare(&remainder, &denominator) >= 0 {
        subtract(&mut remainder, &denominator)
      }
    }
    return List<u8>.length(&remainder) == 0
  }

  /// Converts a valid JSON number to `usize` if it is nonnegative, integral, and in range.
  /// Returns `None` for negative nonzero numbers, fractions, and overflow. Negative zero is zero.
  /// This operation is exact and does not allocate.
  pub fn asUsize(value: string) -> Option<usize> {
    let a = parts(value)
    if a.length == 0 { return Option<usize>.some(0) }
    if a.negative { return Option<usize>.none() }
    let zero = parts("0")
    if scaleCompare(&a, &zero, 0, 0) < 0 { return Option<usize>.none() }
    // Every supported usize fits in at most twenty decimal digits.
    if scaleCompare(&a, &zero, a.length, 20) > 0 { return Option<usize>.none() }
    let mut result: usize = 0
    let mut at = a.first
    while at < a.end {
      let byte = a.bytes[at]
      at = at + 1
      if byte == 46 { continue }
      let digit = u8.toUsize(byte - 48)
      if result > (usize.MAX - digit) / 10 { return Option<usize>.none() }
      result = result * 10 + digit
    }
    let mut zeros: usize = 0
    while scaleCompare(&a, &zero, 0, zeros) > 0 {
      if result > usize.MAX / 10 { return Option<usize>.none() }
      result = result * 10
      zeros = zeros + 1
    }
    return Option<usize>.some(result)
  }
}

struct Parts<'text> {
  bytes: &'text [u8],
  negative: bool,
  first: usize,
  end: usize,
  length: usize,
  fraction: usize,
  trailing: usize,
  exponent: usize,
  exponentNegative: bool,
}

fn parts<'text>(text: string<'text>) -> Parts<'text> {
  let bytes = String.utf8Bytes(text)
  let negative = bytes[0] == 45
  let mut at: usize = 0
  if negative { at = 1 }
  let mut first = bytes.length
  let mut end = at
  let mut length: usize = 0
  let mut fraction: usize = 0
  let mut trailing: usize = 0
  let mut decimal = false
  while at < bytes.length && bytes[at] != 101 && bytes[at] != 69 {
    if bytes[at] == 46 {
      decimal = true
      at = at + 1
      continue
    }
    if decimal { fraction = fraction + 1 }
    if bytes[at] != 48 {
      if first == bytes.length { first = at }
      end = at + 1
      trailing = 0
    } else { trailing = trailing + 1 }
    if first != bytes.length { length = length + 1 }
    at = at + 1
  }
  if length != 0 { length = length - trailing } else { trailing = 0 }
  let mut exponentNegative = false
  if at < bytes.length {
    at = at + 1
    if bytes[at] == 45 || bytes[at] == 43 {
      exponentNegative = bytes[at] == 45
      at = at + 1
    }
  }
  return Parts<'text> { bytes: bytes, negative: negative, first: first, end: end,
    length: length, fraction: fraction, trailing: trailing, exponent: at,
    exponentNegative: exponentNegative }
}

// Compare exponent(a)-fraction(a)+trailing(a)+bonusA against the corresponding value for b.
// Signed decimal columns avoid any bound on exponent magnitude and any addition of usize lengths.
fn scaleCompare(a: &Parts, b: &Parts, bonusA: usize, bonusB: usize) -> i32 {
  let mut ai = a.bytes.length
  let mut bi = b.bytes.length
  let mut terms: [usize; 6] = [a.trailing, b.fraction, bonusA, b.trailing, a.fraction, bonusB]
  let mut carry: i32 = 0
  let mut order: i32 = 0
  while true {
    let mut active = ai > a.exponent || bi > b.exponent || carry != 0
    let mut column = carry
    if ai > a.exponent {
      ai = ai - 1
      let digit = u8.toI32(a.bytes[ai] - 48)
      if a.exponentNegative { column = column - digit } else { column = column + digit }
    }
    if bi > b.exponent {
      bi = bi - 1
      let digit = u8.toI32(b.bytes[bi] - 48)
      if b.exponentNegative { column = column + digit } else { column = column - digit }
    }
    let mut i: usize = 0
    while i < 6 {
      if terms[i] != 0 { active = true }
      let digit = usize.toI32(terms[i] % 10)
      if i < 3 { column = column + digit } else { column = column - digit }
      terms[i] = terms[i] / 10
      i = i + 1
    }
    if !active { return order }
    let remainder = column % 10
    if remainder < 0 { order = -1 }
    if remainder > 0 { order = 1 }
    carry = column / 10
  }
  return order
}

// Integer scratch digits are little-endian and have no leading zeros; zero is an empty list.
effect fn coefficient(value: &Parts) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let mut result = run List<u8>.makeWithCapacity(value.length)
  let mut at = value.end
  while at > value.first {
    at = at - 1
    if value.bytes[at] != 46 { run List<u8>.append(&mut result, value.bytes[at] - 48) }
  }
  return move result
}

fn trim(value: &mut List<u8>) -> () {
  let mut count = List<u8>.length(&value.*)
  while count > 0 && List<u8>.asSlice(&value.*)[count - 1] == 0 { count = count - 1 }
  List<u8>.truncate(&mut value.*, count)
}

fn removeFactors(value: &mut List<u8>, factor: u8) -> usize {
  let mut count: usize = 0
  while List<u8>.length(&value.*) != 0 && List<u8>.asSlice(&value.*)[0] % factor == 0 {
    let digits = List<u8>.asMutSlice(&mut value.*)
    let mut at = digits.length
    let mut remainder: u8 = 0
    while at > 0 {
      at = at - 1
      let current = remainder * 10 + digits[at]
      digits[at] = current / factor
      remainder = current % factor
    }
    trim(&mut value.*)
    count = count + 1
  }
  return count
}

effect fn shiftDigit(value: &mut List<u8>, digit: u8) -> ()
  ! OutOfMemoryError ? &mut Allocator {
  if List<u8>.length(&value.*) == 0 && digit == 0 { return }
  run List<u8>.append(&mut value.*, 0)
  let digits = List<u8>.asMutSlice(&mut value.*)
  let mut at = digits.length - 1
  while at > 0 {
    digits[at] = digits[at - 1]
    at = at - 1
  }
  digits[0] = digit
}

fn integerCompare(left: &List<u8>, right: &List<u8>) -> i32 {
  let a = List<u8>.asSlice(left)
  let b = List<u8>.asSlice(right)
  if a.length < b.length { return -1 }
  if a.length > b.length { return 1 }
  let mut at = a.length
  while at > 0 {
    at = at - 1
    if a[at] < b[at] { return -1 }
    if a[at] > b[at] { return 1 }
  }
  return 0
}

fn subtract(left: &mut List<u8>, right: &List<u8>) -> () {
  let a = List<u8>.asMutSlice(&mut left.*)
  let b = List<u8>.asSlice(right)
  let mut at: usize = 0
  let mut borrow: i32 = 0
  while at < a.length {
    let mut digit = u8.toI32(a[at]) - borrow
    if at < b.length { digit = digit - u8.toI32(b[at]) }
    borrow = 0
    if digit < 0 {
      digit = digit + 10
      borrow = 1
    }
    a[at] = i32.toU8(digit)
    at = at + 1
  }
  trim(&mut left.*)
}
