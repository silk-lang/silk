//! International hostname validation for JSON Schema using Unicode 16.0.0 UTS #46 mapping.
//!
//! Mapping is nontransitional. IDNA2008 contextual rules, canonical Punycode, DNS wire lengths,
//! NFC, and the domain-wide RFC 5893 bidirectional rule are checked without DNS access.

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.option { Option }
import silk.text.string { String, ScalarStep }
import silk.text.char
import silk.text.unicode { Unicode }
import silk.text.unicode_properties { BidiClass, JoiningType, CanonicalCombiningClass }
import silk.text.unicode_script { Script }
import silk.collections.slice { Slice }
import silk.json.schema_format_idna_data
import silk.num.u8
import silk.num.u32
import silk.num.usize

struct Label { points: [u32; 63], length: usize }
// Ordinary ASCII DNS names need neither mapping nor temporary Unicode buffers.
fn ascii(value: string) -> Option<bool> {
  let b = String.utf8Bytes(value)
  let mut i: usize = 0
  while i < b.length {
    if b[i] >= 128 { return Option<bool>.none() }
    i = i + 1
  }
  let mut start: usize = 0
  i = 0
  while i <= b.length {
    if i == b.length || b[i] == 46 {
      if i - start >= 4 && (b[start] == 120 || b[start] == 88)
        && (b[start + 1] == 110 || b[start + 1] == 78)
        && b[start + 2] == 45 && b[start + 3] == 45 { return Option<bool>.none() }
      start = i + 1
    }
    i = i + 1
  }
  if b.length == 0 || b.length > 253 { return Option<bool>.some(false) }
  start = 0
  i = 0
  while i <= b.length {
    if i == b.length || b[i] == 46 {
      if i == start || i - start > 63 || b[start] == 45 || b[i - 1] == 45 { return Option<bool>.some(false) }
      if i - start >= 4 && b[start + 2] == 45 && b[start + 3] == 45 { return Option<bool>.some(false) }
      start = i + 1
    } else {
      let c = b[i]
      if !(c >= 65 && c <= 90) && !(c >= 97 && c <= 122)
        && !(c >= 48 && c <= 57) && c != 45 { return Option<bool>.some(false) }
    }
    i = i + 1
  }
  return Option<bool>.some(true)
}


/// Returns whether a name passes nontransitional UTS #46 and IDNA2008 hostname checks.
/// Empty labels and trailing dots are rejected. Allocation failures propagate to the caller.
pub effect fn check(value: string) -> bool ! OutOfMemoryError ? &mut Allocator {
  match ascii(value) {
    Option<bool>.Some { value: valid } => { return valid }
    Option<bool>.None => {}
  }
  let mut mapped = String.make()
  let mut cursor = String.scalarCursor()
  while true {
    let step = match String.nextScalar(value, move cursor) {
      Option<ScalarStep>.Some { value: scalar } => move scalar
      Option<ScalarStep>.None => { break }
    }
    let cp = char.toU32(String.scalarValue(&step))
    let at = String.scalarByteOffset(&step)
    cursor = String.nextCursor(move step)
    let row = schema_format_idna_data.row(cp)
    let status = schema_format_idna_data.status(row)
    if status == 3 { return false }
    if status == 2 { run String.append(&mut mapped, schema_format_idna_data.replacement(row)) }
    if status == 0 {
      run String.append(&mut mapped, String.slice(value, at, String.cursorByteOffset(&cursor) - at))
    }
  }
  let normalized = run Unicode.normalizeNfc(String.view(&mapped))
  let text = String.view(&normalized)
  let bytes = String.utf8Bytes(text)
  if bytes.length == 0 { return false }
  let mut start: usize = 0
  let mut i: usize = 0
  let mut wire: usize = 1
  let mut rtlDomain = false
  let mut allBidi = true
  while i <= bytes.length {
    if i == bytes.length || bytes[i] == 46 {
      if i == start { return false }
      let part = String.slice(text, start, i - start)
      let mut label = Label { points: [0; 63], length: 0 }
      let alabel = String.startsWith(part, "xn--")
      if alabel {
        if i - start > 63 || !decode(String.slice(part, 4, i - start - 4), &mut label) { return false }
      } else {
        if !scalars(part, &mut label) { return false }
      }
      if !valid(&label) { return false }
      let mut labelText = String.make()
      let mut j: usize = 0
      let mut nonascii = false
      while j < label.length {
        let cp = label.points[j]
        if cp >= 128 { nonascii = true }
        let direction = BidiClass.of(cp)
        if direction == BidiClass.R || direction == BidiClass.AL || direction == BidiClass.AN { rtlDomain = true }
        run appendScalar(&mut labelText, cp)
        j = j + 1
      }
      if !bidi(&label) { allBidi = false }
      let nfc = run Unicode.normalizeNfc(String.view(&labelText))
      if String.view(&nfc) != String.view(&labelText) { return false }
      let mut encoded = String.make()
      if nonascii {
        run String.append(&mut encoded, "xn--")
        run encode(&label, &mut encoded)
      } else {
        if alabel { return false }
        run String.append(&mut encoded, part)
      }
      let length = String.ownedByteLength(&encoded)
      if length > 63 || (alabel && String.view(&encoded) != part) { return false }
      wire = wire + length + 1
      if wire > 255 { return false }
      start = i + 1
    }
    i = i + 1
  }
  return !rtlDomain || allBidi
}

fn scalars(text: string, label: &mut Label) -> bool {
  let mut cursor = String.scalarCursor()
  while true {
    let step = match String.nextScalar(text, move cursor) {
      Option<ScalarStep>.Some { value } => move value
      Option<ScalarStep>.None => { break }
    }
    if label.length == 63 { return false }
    label.points[label.length] = char.toU32(String.scalarValue(&step))
    label.length = label.length + 1
    cursor = String.nextCursor(move step)
  }
  return label.length != 0
}
fn valid(label: &Label) -> bool {
  let n = label.length
  if n == 0 || label.points[0] == 45 || label.points[n - 1] == 45 || Unicode.isMark(label.points[0]) { return false }
  if n >= 4 && label.points[2] == 45 && label.points[3] == 45 { return false }
  let mut i: usize = 0
  while i < n {
    let cp = label.points[i]
    if !schema_format_idna_data.pvalid(cp) && !context(label, i) { return false }
    i = i + 1
  }
  return true
}
fn context(label: &Label, i: usize) -> bool {
  let cp = label.points[i]
  let n = label.length
  if cp == 0x200C || cp == 0x200D {
    if i > 0 && CanonicalCombiningClass.number(CanonicalCombiningClass.of(label.points[i - 1])) == 9 { return true }
    if cp == 0x200D { return false }
    let mut j = i
    let mut left = false
    while j > 0 {
      j = j - 1
      let joining = JoiningType.of(label.points[j])
      if joining != JoiningType.T {
        left = joining == JoiningType.L || joining == JoiningType.D
        break
      }
    }
    if !left { return false }
    j = i + 1
    while j < n {
      let joining = JoiningType.of(label.points[j])
      if joining != JoiningType.T { return joining == JoiningType.R || joining == JoiningType.D }
      j = j + 1
    }
    return false
  }
  if cp == 0xB7 { return i > 0 && i + 1 < n && label.points[i - 1] == 108 && label.points[i + 1] == 108 }
  if cp == 0x375 { return i + 1 < n && Script.of(label.points[i + 1]).value == 0x4772656B }
  if cp == 0x5F3 || cp == 0x5F4 { return i > 0 && Script.of(label.points[i - 1]).value == 0x48656272 }
  if cp == 0x30FB {
    let mut j: usize = 0
    while j < n {
      let script = Script.of(label.points[j]).value
      if script == 0x48697261 || script == 0x4B616E61 || script == 0x48616E69 { return true }
      j = j + 1
    }
    return false
  }
  if (cp >= 0x660 && cp <= 0x669) || (cp >= 0x6F0 && cp <= 0x6F9) {
    let mut j: usize = 0
    while j < n {
      let other = label.points[j]
      if cp <= 0x669 && other >= 0x6F0 && other <= 0x6F9 { return false }
      if cp >= 0x6F0 && other >= 0x660 && other <= 0x669 { return false }
      j = j + 1
    }
    return true
  }
  return false
}
fn bidi(label: &Label) -> bool {
  let first = BidiClass.of(label.points[0])
  let rtl = first == BidiClass.R || first == BidiClass.AL
  if !rtl && first != BidiClass.L { return false }
  let mut end = false
  let mut european = false
  let mut arabic = false
  let mut i: usize = 0
  while i < label.length {
    let d = BidiClass.of(label.points[i])
    if d == BidiClass.EN { european = true }
    if d == BidiClass.AN { arabic = true }
    let neutral = d == BidiClass.EN || d == BidiClass.ES || d == BidiClass.CS
      || d == BidiClass.ET || d == BidiClass.ON || d == BidiClass.BN || d == BidiClass.NSM
    if rtl {
      if !neutral && d != BidiClass.R && d != BidiClass.AL && d != BidiClass.AN { return false }
      if d != BidiClass.NSM { end = d == BidiClass.R || d == BidiClass.AL || d == BidiClass.EN || d == BidiClass.AN }
    } else {
      if !neutral && d != BidiClass.L { return false }
      if d != BidiClass.NSM { end = d == BidiClass.L || d == BidiClass.EN }
    }
    i = i + 1
  }
  return end && (!rtl || !european || !arabic)
}

// RFC 3492 bootstring, with all arithmetic bounded by a 63-scalar DNS label.
fn adapt(delta: u32, points: u32, first: bool) -> u32 {
  let mut d = delta / 2
  if first { d = delta / 700 }
  d = d + d / points
  let mut k: u32 = 0
  while d > 455 {
    d = d / 35
    k = k + 36
  }
  return k + 36 * d / (d + 38)
}
fn threshold(k: u32, bias: u32) -> u32 {
  if k <= bias { return 1 }
  if k >= bias + 26 { return 26 }
  return k - bias
}
fn decode(text: string, label: &mut Label) -> bool {
  let b = String.utf8Bytes(text)
  if b.length == 0 { return false }
  let mut basic: usize = 0
  let mut j: usize = 0
  while j < b.length {
    if b[j] == 45 { basic = j + 1 }
    j = j + 1
  }
  if basic > 0 {
    j = 0
    while j + 1 < basic {
      if b[j] >= 128 || label.length == 63 { return false }
      label.points[label.length] = u8.toU32(b[j])
      label.length = label.length + 1
      j = j + 1
    }
  }
  let mut offset = basic
  let mut n: u32 = 128
  let mut index: u32 = 0
  let mut bias: u32 = 72
  while offset < b.length {
    let old = index
    let mut weight: u32 = 1
    let mut k: u32 = 36
    while true {
      if offset == b.length { return false }
      let c = b[offset]
      offset = offset + 1
      let mut d: u32 = 36
      if c >= 97 && c <= 122 { d = u8.toU32(c) - 97 }
      if c >= 65 && c <= 90 { d = u8.toU32(c) - 65 }
      if c >= 48 && c <= 57 { d = u8.toU32(c) - 22 }
      if d >= 36 || d > (4294967295 - index) / weight { return false }
      index = index + d * weight
      let t = threshold(k, bias)
      if d < t { break }
      if weight > 4294967295 / (36 - t) { return false }
      weight = weight * (36 - t)
      k = k + 36
    }
    if label.length == 63 { return false }
    let count = usize.toU32(label.length + 1)
    bias = adapt(index - old, count, old == 0)
    if index / count > 0x10FFFF - n { return false }
    n = n + index / count
    if n >= 0xD800 && n <= 0xDFFF { return false }
    index = index % count
    j = label.length
    while j > u32.toUsize(index) {
      label.points[j] = label.points[j - 1]
      j = j - 1
    }
    label.points[j] = n
    label.length = label.length + 1
    index = index + 1
  }
  return label.length != 0
}
effect fn encode(label: &Label, output: &mut String) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut handled: u32 = 0
  let mut j: usize = 0
  while j < label.length {
    if label.points[j] < 128 {
      run appendScalar(&mut output.*, label.points[j])
      handled = handled + 1
    }
    j = j + 1
  }
  let basic = handled
  if basic > 0 { run String.append(&mut output.*, "-") }
  let mut n: u32 = 128
  let mut delta: u32 = 0
  let mut bias: u32 = 72
  while handled < usize.toU32(label.length) {
    let mut minimum: u32 = 0x10FFFF
    j = 0
    while j < label.length {
      let cp = label.points[j]
      if cp >= n && cp < minimum { minimum = cp }
      j = j + 1
    }
    delta = delta + (minimum - n) * (handled + 1)
    n = minimum
    j = 0
    while j < label.length {
      let cp = label.points[j]
      if cp < n { delta = delta + 1 }
      if cp == n {
        let mut q = delta
        let mut k: u32 = 36
        while true {
          let t = threshold(k, bias)
          if q < t { break }
          run encodeDigit(&mut output.*, t + (q - t) % (36 - t))
          q = (q - t) / (36 - t)
          k = k + 36
        }
        run encodeDigit(&mut output.*, q)
        bias = adapt(delta, handled + 1, handled == basic)
        delta = 0
        handled = handled + 1
      }
      j = j + 1
    }
    delta = delta + 1
    n = n + 1
  }
}
effect fn encodeDigit(output: &mut String, digit: u32) -> () ! OutOfMemoryError ? &mut Allocator {
  let digits = "abcdefghijklmnopqrstuvwxyz0123456789"
  return run String.append(&mut output.*, String.slice(digits, u32.toUsize(digit), 1))
}
effect fn appendScalar(output: &mut String, cp: u32) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut bytes: [u8; 4] = [0; 4]
  let mut length: usize = 1
  if cp < 128 { bytes[0] = u32.toU8(cp) }
  else if cp < 2048 {
    bytes[0] = u32.toU8(192 + cp / 64)
    bytes[1] = u32.toU8(128 + cp % 64)
    length = 2
  } else if cp < 65536 {
    bytes[0] = u32.toU8(224 + cp / 4096)
    bytes[1] = u32.toU8(128 + cp / 64 % 64)
    bytes[2] = u32.toU8(128 + cp % 64)
    length = 3
  } else {
    bytes[0] = u32.toU8(240 + cp / 262144)
    bytes[1] = u32.toU8(128 + cp / 4096 % 64)
    bytes[2] = u32.toU8(128 + cp / 64 % 64)
    bytes[3] = u32.toU8(128 + cp % 64)
    length = 4
  }
  let text = unsafe String.fromUtf8Unchecked(Slice.view<u8>(&bytes, 0, length))
  return run String.append(&mut output.*, text)
}
