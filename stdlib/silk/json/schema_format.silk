//! String format assertions for JSON Schema, without network access.
//!
//! `SchemaFormat.check` checks the standard format names and accepts unknown names. Schema
//! evaluation must opt in to assertions: a `format` annotation alone does not reject an instance.
//!
//! @category Data formats

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.text.string { String, ScalarStep }
import silk.text.char
import silk.text.regex { Regex, RegexError, RegexReason }
import silk.net.address { Ipv4Address, Ipv6Address, AddressError }
import silk.uri.reference { UriReference, ParseError }
import silk.json.schema_format_idna
import silk.num.u8
import silk.num.u32
import silk.num.usize

/// Checks the standard JSON Schema string formats. No check performs DNS or network access.
pub struct SchemaFormat {}

impl SchemaFormat {
  /// Returns whether `name` is a standard format implemented by this module.
  pub fn known(name: string) -> bool {
    return name == "date-time" || name == "date" || name == "time" || name == "duration"
      || name == "email" || name == "idn-email" || name == "hostname" || name == "idn-hostname"
      || name == "ipv4" || name == "ipv6" || name == "uri" || name == "uri-reference"
      || name == "iri" || name == "iri-reference" || name == "uri-template" || name == "uuid"
      || name == "json-pointer" || name == "relative-json-pointer" || name == "regex"
  }

  /// Returns whether `value` satisfies `name`; an unknown format name returns `true`.
  ///
  /// # Details
  ///
  /// Dates and times use RFC 3339, durations its Appendix A, mailboxes RFC 5321 and RFC 6531,
  /// URI references RFC 3986, IRIs RFC 3987, and URI templates RFC 6570. International hostnames
  /// use nontransitional UTS #46 mapping and IDNA2008 contextual and bidirectional checks.
  /// Regex syntax uses ECMAScript Unicode mode. The function does not resolve names or references.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if temporary Unicode or regular-expression storage cannot be allocated.
  /// - `RegexError` if a regular expression exceeds the parser's resource limits. Invalid syntax
  ///   returns `false`; operational failures are not treated as invalid instances.
  pub effect fn check(name: string, value: string) -> bool ! RegexError | OutOfMemoryError ? &mut Allocator {
    if name == "date" { return date(value) }
    if name == "time" { return time(value) }
    if name == "date-time" {
      let b = String.utf8Bytes(value)
      if b.length < 20 || (b[10] != 84 && b[10] != 116) { return false }
      if !date(String.slice(value, 0, 10)) || !time(String.slice(value, 11, b.length - 11)) { return false }
      if b[17] != 54 || b[18] != 48 { return true }
      let mut offset = 0
      if b[b.length - 1] != 90 && b[b.length - 1] != 122 {
        let zone = b.length - 6
        offset = number(b, zone + 1, 2) * 60 + number(b, zone + 4, 2)
        if b[zone] == 45 { offset = -offset }
      }
      let utcMinute = number(b, 11, 2) * 60 + number(b, 14, 2) - offset
      let day = number(b, 8, 2)
      // A positive offset can place UTC on the previous local calendar day.
      if utcMinute < 0 { return day == 1 }
      let lastDay = monthDays(number(b, 0, 4), number(b, 5, 2))
      if utcMinute >= 1440 { return day + 1 == lastDay }
      return day == lastDay
    }
    if name == "duration" { return duration(value) }
    if name == "email" { return run email(value, false) }
    if name == "idn-email" { return run email(value, true) }
    if name == "hostname" { return run hostname(value) }
    if name == "idn-hostname" { return run schema_format_idna.check(value) }
    if name == "ipv4" { return ipv4(value) }
    if name == "ipv6" { return ipv6(value) }
    if name == "uri" { return uri(value, true) }
    if name == "uri-reference" { return uri(value, false) }
    if name == "iri" { return run iri(value, true) }
    if name == "iri-reference" { return run iri(value, false) }
    if name == "uri-template" { return uriTemplate(value) }
    if name == "uuid" { return uuid(value) }
    if name == "json-pointer" { return pointer(value) }
    if name == "relative-json-pointer" { return relativePointer(value) }
    if name == "regex" {
      return run Effect.catch<RegexError>(regex(value), invalidRegex)
    }
    return true
  }
}

effect fn regex(value: string) -> bool ! RegexError | OutOfMemoryError ? &mut Allocator {
  run Regex.validate(value)
  return true
}
effect fn invalidRegex(error: RegexError) -> bool ! RegexError {
  if error.reason == RegexReason.PatternLimit || error.reason == RegexReason.MatchLimit { fail move error }
  return false
}

fn digit(c: u8) -> bool { return c >= 48 && c <= 57 }
fn alpha(c: u8) -> bool { return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) }
fn hex(c: u8) -> bool { return digit(c) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102) }
fn number(b: &[u8], start: usize, count: usize) -> i32 {
  let mut i = start
  let mut n = 0
  while i < start + count {
    if !digit(b[i]) { return -1 }
    n = n * 10 + u8.toI32(b[i]) - 48
    i = i + 1
  }
  return n
}
fn date(value: string) -> bool {
  let b = String.utf8Bytes(value)
  if b.length != 10 || b[4] != 45 || b[7] != 45 { return false }
  let year = number(b, 0, 4)
  let month = number(b, 5, 2)
  let day = number(b, 8, 2)
  if year < 0 || month < 1 || month > 12 || day < 1 { return false }
  return day <= monthDays(year, month)
}
fn monthDays(year: i32, month: i32) -> i32 {
  if month == 4 || month == 6 || month == 9 || month == 11 { return 30 }
  if month == 2 {
    if year % 4 == 0 && (year % 100 != 0 || year % 400 == 0) { return 29 }
    return 28
  }
  return 31
}
fn time(value: string) -> bool {
  let b = String.utf8Bytes(value)
  if b.length < 9 || b[2] != 58 || b[5] != 58 { return false }
  let hour = number(b, 0, 2)
  let minute = number(b, 3, 2)
  let second = number(b, 6, 2)
  if hour < 0 || hour > 23 || minute < 0 || minute > 59 || second < 0 || second > 60 { return false }
  let mut i: usize = 8
  if b[i] == 46 {
    i = i + 1
    let start = i
    while i < b.length && digit(b[i]) { i = i + 1 }
    if i == start || i == b.length { return false }
  }
  let mut offset = 0
  if b[i] == 90 || b[i] == 122 {
    if i + 1 != b.length { return false }
  } else {
    if b.length - i != 6 || (b[i] != 43 && b[i] != 45) || b[i + 3] != 58 { return false }
    let h = number(b, i + 1, 2)
    let m = number(b, i + 4, 2)
    if h < 0 || h > 23 || m < 0 || m > 59 { return false }
    offset = h * 60 + m
    if b[i] == 45 { offset = -offset }
  }
  // Leap seconds are represented at UTC 23:59, including its local-date rollover.
  return second != 60 || (hour * 60 + minute - offset + 1440) % 1440 == 1439
}
fn duration(value: string) -> bool {
  let b = String.utf8Bytes(value)
  if b.length < 3 || (b[0] != 80 && b[0] != 112) { return false }
  let mut i: usize = 1
  let mut clock = false
  let mut previous = 0
  let mut any = false
  let mut clockAny = false
  while i < b.length {
    if b[i] == 84 || b[i] == 116 {
      if clock { return false }
      clock = true
      previous = 0
      i = i + 1
      continue
    }
    let start = i
    while i < b.length && digit(b[i]) { i = i + 1 }
    if i == start || i == b.length { return false }
    let c = b[i]
    i = i + 1
    if c == 87 || c == 119 { return !any && !clock && i == b.length }
    let mut rank = 0
    if clock {
      if c == 72 || c == 104 { rank = 1 }
      if c == 77 || c == 109 { rank = 2 }
      if c == 83 || c == 115 { rank = 3 }
      clockAny = true
    } else {
      if c == 89 || c == 121 { rank = 1 }
      if c == 77 || c == 109 { rank = 2 }
      if c == 68 || c == 100 { rank = 3 }
    }
    // Appendix A nests each next unit; Y cannot skip M and H cannot skip M.
    if rank == 0 || (previous != 0 && rank != previous + 1) { return false }
    previous = rank
    any = true
  }
  return any && (!clock || clockAny)
}
fn ipv4(value: string) -> bool {
  return match Ipv4Address.parse(value) {
    Result<Ipv4Address, AddressError>.Success {..} => true
    Result<Ipv4Address, AddressError>.Failure {..} => false
  }
}
fn ipv6(value: string) -> bool {
  if !String.contains(value, ".") {
    return match Ipv6Address.parse(value) {
      Result<Ipv6Address, AddressError>.Success {..} => true
      Result<Ipv6Address, AddressError>.Failure {..} => false
    }
  }
  // The network address type deliberately excludes embedded IPv4; RFC 4291 does not.
  let b = String.utf8Bytes(value)
  let mut i: usize = 0
  let mut groups: usize = 0
  let mut compressed = false
  if b.length == 0 { return false }
  if b[0] == 58 {
    if b.length < 2 || b[1] != 58 { return false }
    compressed = true
    i = 2
  }
  while i < b.length {
    let start = i
    while i < b.length && b[i] != 58 { i = i + 1 }
    let part = String.slice(value, start, i - start)
    if String.contains(part, ".") {
      if i != b.length || !ipv4(part) { return false }
      groups = groups + 2
    } else {
      if i == start || i - start > 4 { return false }
      let mut j = start
      while j < i {
        if !hex(b[j]) { return false }
        j = j + 1
      }
      groups = groups + 1
    }
    if groups > 8 { return false }
    if i < b.length {
      i = i + 1
      if i < b.length && b[i] == 58 {
        if compressed { return false }
        compressed = true
        i = i + 1
      } else { if i == b.length { return false } }
    }
  }
  return (compressed && groups < 8) || (!compressed && groups == 8)
}
effect fn hostname(value: string) -> bool ! OutOfMemoryError ? &mut Allocator {
  let b = String.utf8Bytes(value)
  if b.length == 0 || b.length > 253 { return false }
  let mut start: usize = 0
  let mut i: usize = 0
  while i <= b.length {
    if i == b.length || b[i] == 46 {
      if i == start || i - start > 63 || b[start] == 45 || b[i - 1] == 45 { return false }
      if i - start >= 4 && (b[start] == 120 || b[start] == 88)
        && (b[start + 1] == 110 || b[start + 1] == 78)
        && b[start + 2] == 45 && b[start + 3] == 45 {
        if !run schema_format_idna.check(String.slice(value, start, i - start)) { return false }
      }
      start = i + 1
    } else { if !alpha(b[i]) && !digit(b[i]) && b[i] != 45 { return false } }
    i = i + 1
  }
  return true
}
effect fn email(value: string, international: bool) -> bool ! OutOfMemoryError ? &mut Allocator {
  let b = String.utf8Bytes(value)
  if b.length == 0 { return false }
  let mut i: usize = 0
  if b[0] == 34 {
    i = 1
    while i < b.length && b[i] != 34 {
      if b[i] == 92 {
        i = i + 1
        if i == b.length || b[i] < 32 || b[i] > 126 { return false }
      } else {
        if b[i] < 32 || b[i] == 127 || (!international && b[i] > 127) { return false }
      }
      i = i + 1
    }
    if i == b.length { return false }
    i = i + 1
  } else {
    let mut dot = true
    while i < b.length && b[i] != 64 {
      let c = b[i]
      if c == 46 {
        if dot { return false }
        dot = true
      } else {
        if c >= 128 {
          if !international { return false }
        } else if !alpha(c) && !digit(c)
          && !String.contains("!#$%&'*+-/=?^_`{|}~", String.slice(value, i, 1)) { return false }
        dot = false
      }
      i = i + 1
    }
    if dot { return false }
  }
  if i >= b.length || b[i] != 64 { return false }
  let domain = String.slice(value, i + 1, b.length - i - 1)
  let d = String.utf8Bytes(domain)
  if d.length == 0 { return false }
  if d[0] == 91 {
    if d.length < 3 || d[d.length - 1] != 93 { return false }
    let inner = String.slice(domain, 1, d.length - 2)
    let literal = String.utf8Bytes(inner)
    if literal.length >= 5 && (literal[0] == 73 || literal[0] == 105)
      && (literal[1] == 80 || literal[1] == 112) && (literal[2] == 86 || literal[2] == 118)
      && literal[3] == 54 && literal[4] == 58 {
      return ipv6(String.slice(inner, 5, String.byteLength(inner) - 5))
    }
    return ipv4(inner)
  }
  if international { return run schema_format_idna.check(domain) }
  return run hostname(domain)
}
fn uri(value: string, absolute: bool) -> bool {
  return match UriReference.parse(value) {
    Result<UriReference, ParseError>.Success { value: parsed } => {
      if !absolute { return true }
      return match UriReference.scheme(&parsed) {
        Option<string>.Some {..} => true
        Option<string>.None => false
      }
    }
    Result<UriReference, ParseError>.Failure {..} => false
  }
}
fn ucschar(cp: u32) -> bool {
  return (cp >= 0xA0 && cp <= 0xD7FF) || (cp >= 0xF900 && cp <= 0xFDCF)
    || (cp >= 0xFDF0 && cp <= 0xFFEF)
    || (cp >= 0x10000 && cp <= 0xDFFFD && cp % 65536 <= 65533)
    || (cp >= 0xE1000 && cp <= 0xEFFFD)
}
fn privateScalar(cp: u32) -> bool {
  return (cp >= 0xE000 && cp <= 0xF8FF) || (cp >= 0xF0000 && cp <= 0xFFFFD)
    || (cp >= 0x100000 && cp <= 0x10FFFD)
}
effect fn iri(value: string, absolute: bool) -> bool ! OutOfMemoryError ? &mut Allocator {
  let bytes = String.utf8Bytes(value)
  let mut hasUnicode = false
  let mut index: usize = 0
  while index < bytes.length {
    if bytes[index] >= 128 {
      hasUnicode = true
      break
    }
    index = index + 1
  }
  if !hasUnicode { return uri(value, absolute) }
  let mut cursor = String.scalarCursor()
  let mut mapped = String.make()
  let mut query = false
  let mut fragment = false
  while true {
    let step = match String.nextScalar(value, move cursor) {
      Option<ScalarStep>.Some { value: scalar } => move scalar
      Option<ScalarStep>.None => { break }
    }
    let cp = char.toU32(String.scalarValue(&step))
    let at = String.scalarByteOffset(&step)
    cursor = String.nextCursor(move step)
    if cp == 35 {
      fragment = true
      query = false
    }
    if cp == 63 && !fragment { query = true }
    if cp < 128 {
      run String.append(&mut mapped, String.slice(value, at, 1))
    } else {
      if !ucschar(cp) && !(query && privateScalar(cp)) { return false }
      // Escaped octets preserve component grammar, including the ASCII-only scheme.
      run String.append(&mut mapped, "%80")
    }
  }
  return uri(String.view(&mapped), absolute)
}
fn pointer(value: string) -> bool {
  let b = String.utf8Bytes(value)
  if b.length == 0 { return true }
  if b[0] != 47 { return false }
  let mut i: usize = 1
  while i < b.length {
    if b[i] == 126 {
      i = i + 1
      if i == b.length || (b[i] != 48 && b[i] != 49) { return false }
    }
    i = i + 1
  }
  return true
}
fn relativePointer(value: string) -> bool {
  let b = String.utf8Bytes(value)
  if b.length == 0 || !digit(b[0]) { return false }
  let mut i: usize = 1
  if b[0] != 48 { while i < b.length && digit(b[i]) { i = i + 1 } }
  if i + 1 == b.length && b[i] == 35 { return true }
  return pointer(String.slice(value, i, b.length - i))
}
fn uuid(value: string) -> bool {
  let b = String.utf8Bytes(value)
  if b.length != 36 { return false }
  let mut i: usize = 0
  while i < 36 {
    if i == 8 || i == 13 || i == 18 || i == 23 {
      if b[i] != 45 { return false }
    } else { if !hex(b[i]) { return false } }
    i = i + 1
  }
  return true
}
fn uriTemplate(value: string) -> bool {
  let b = String.utf8Bytes(value)
  let mut i: usize = 0
  while i < b.length {
    let c = b[i]
    if c == 123 {
      i = i + 1
      if i == b.length { return false }
      if b[i] == 43 || b[i] == 35 || b[i] == 46 || b[i] == 47 || b[i] == 59 || b[i] == 63 || b[i] == 38 { i = i + 1 }
      while true {
        let start = i
        let mut needChar = true
        while i < b.length {
          let v = b[i]
          if alpha(v) || digit(v) || v == 95 {
            needChar = false
            i = i + 1
          }
          else if v == 37 {
            if b.length - i < 3 || !hex(b[i + 1]) || !hex(b[i + 2]) { return false }
            needChar = false
            i = i + 3
          } else if v == 46 {
            if needChar { return false }
            needChar = true
            i = i + 1
          } else { break }
        }
        if i == start || needChar || i == b.length { return false }
        if b[i] == 42 { i = i + 1 }
        else if b[i] == 58 {
          i = i + 1
          let begin = i
          if i == b.length || b[i] < 49 || b[i] > 57 { return false }
          while i < b.length && digit(b[i]) { i = i + 1 }
          if i - begin > 4 { return false }
        }
        if i == b.length { return false }
        if b[i] == 125 {
          i = i + 1
          break
        }
        if b[i] != 44 { return false }
        i = i + 1
      }
    } else if c == 37 {
      if b.length - i < 3 || !hex(b[i + 1]) || !hex(b[i + 2]) { return false }
      i = i + 3
    } else if c < 128 {
      if c <= 32 || c == 34 || c == 60 || c == 62 || c == 92 || c == 94 || c == 96 || c == 125 || c == 124 || c == 127 { return false }
      i = i + 1
    } else {
      let mut end = i + 1
      while end < b.length && !String.isCharBoundary(value, end) { end = end + 1 }
      let one = String.slice(value, i, end - i)
      let step = match String.nextScalar(one, String.scalarCursor()) {
        Option<ScalarStep>.Some { value: scalar } => move scalar
        Option<ScalarStep>.None => { return false }
      }
      let cp = char.toU32(String.scalarValue(&step))
      if !ucschar(cp) && !privateScalar(cp) { return false }
      i = end
    }
  }
  return true
}
