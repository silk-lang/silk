impl Decode for f32 {
  fn decode(scanner: &mut JsonScanner) -> Result<Self, JsonError> {
    return match move number<f32>(&mut scanner.*, Format.f32Value) {
      Result<f32, JsonError>.Failure { error } => Result<f32, JsonError>.failResult(move error)
      Result<f32, JsonError>.Success { value } => {
        if !f32.isFinite(value) {
          return Result<f32, JsonError>.failResult(
            JsonError.at(JsonReason.NumberOutOfRange, JsonScanner.offset(&scanner.*)))
        }
        return Result<f32, JsonError>.succeed(value)
      }
    }
  }
}

impl Deserialize for f32 {
  effect fn deserialize(scanner: &mut JsonScanner)
    -> Self ! JsonError | OutOfMemoryError ? &mut Allocator {
    return run decoded<f32>(&mut scanner.*)
  }
}

impl Serialize for f32 {
  effect fn serialize(self: &Self, options: &JsonOptions)
    -> () ! JsonError | WriterError ? &mut Writer {
    if !f32.isFinite(self.*) {
      fail JsonError {
        reason: JsonReason.InvalidNumber,
        offset: Option<usize>.none(),
        required: Option<usize>.none(),
        available: Option<usize>.none(),
      }
    }
    return run Format.display<f32>(self)
  }
}

impl Decode for f64 {
  fn decode(scanner: &mut JsonScanner) -> Result<Self, JsonError> {
    return match move number<f64>(&mut scanner.*, Format.f64Value) {
      Result<f64, JsonError>.Failure { error } => Result<f64, JsonError>.failResult(move error)
      Result<f64, JsonError>.Success { value } => {
        if !f64.isFinite(value) {
          return Result<f64, JsonError>.failResult(
            JsonError.at(JsonReason.NumberOutOfRange, JsonScanner.offset(&scanner.*)))
        }
        return Result<f64, JsonError>.succeed(value)
      }
    }
  }
}

impl Deserialize for f64 {
  effect fn deserialize(scanner: &mut JsonScanner)
    -> Self ! JsonError | OutOfMemoryError ? &mut Allocator {
    return run decoded<f64>(&mut scanner.*)
  }
}

impl Serialize for f64 {
  effect fn serialize(self: &Self, options: &JsonOptions)
    -> () ! JsonError | WriterError ? &mut Writer {
    if !f64.isFinite(self.*) {
