//! The interfaces that let a type be written to JSON and read from JSON.
//!
//! # When to use
//! Implement [`Serialize`] for your type to write it with `silk.json.value.Json.serialize`.
//! Implement [`Decode`] (no memory needed) or [`Deserialize`] (memory needed) to read it with
//! `Json.decode` or `Json.deserialize`.
//!
//! # Details
//! The standard library implements the interfaces for `bool`, the integer types, `f32`, `f64`,
//! strings, `Option<T>`, and `List<T>`. `Option<T>` is `null` when absent.
//!
//! A `Serialize` implementation for a struct usually writes an object with
//! `silk.json.object.JsonObject`, or uses `silk.json.reflect.JsonReflect.write`. A `Deserialize`
//! implementation reads tokens from a `JsonScanner` and calls [`JsonCodec.deserializeOne`] for each
//! field.
//!
//! # Errors
//! - `JsonError` when the JSON does not match the type, a number does not fit, or a float that is
//!   not finite is written. A float that is not finite fails before any bytes are written.
//!
//! # Gotchas
//! Each read function reads exactly one value and leaves the next token, such as `,` or `]`, for
//! the caller. The caller must check that the document ends.
//!
//! # Examples
//! ## Implement `Serialize` for a struct
//! ```silk
//! import silk.core.effect { Effect }
//! import silk.json.codec { Serialize }
//! import silk.json.object { JsonObject }
//! import silk.json.output { JsonOptions }
//! import silk.json.scanner { JsonError }
//! import silk.json.value { Json }
//! import silk.io.writer { Writer, WriterError }
//!
//! struct CaptureWriter {
//!   bytes: [u8; 64],
//!   length: usize,
//! }
//!
//! impl Writer for CaptureWriter {
//!   effect fn writeAll(self: &mut Self, value: &[u8]) -> ()
//!     ! WriterError
//!     ? &mut Writer {
//!     let mut index: usize = 0
//!     while index < value.length {
//!       self.bytes[self.length] = value[index]
//!       self.length = self.length + 1
//!       index = index + 1
//!     }
//!     return ()
//!   }
//!
//!   effect fn flush(self: &mut Self) -> ()
//!     ! WriterError
//!     ? &mut Writer {
//!     return ()
//!   }
//! }
//!
//! fn holds(writer: &CaptureWriter, expected: &[u8]) -> bool {
//!   if writer.length != expected.length {
//!     return false
//!   }
//!   let mut index: usize = 0
//!   while index < expected.length {
//!     if writer.bytes[index] != expected[index] {
//!       return false
//!     }
//!     index = index + 1
//!   }
//!   return true
//! }
//!
//! struct Point {
//!   x: i32,
//!   y: i32,
//! }
//!
//! impl Serialize for Point {
//!   effect fn serialize(self: &Self, options: &JsonOptions) -> ()
//!     ! JsonError | WriterError
//!     ? &mut Writer {
//!     return run JsonObject.begin(options) |> JsonObject.field("x", &self.x)
//!       |> JsonObject.field("y", &self.y)
//!       |> JsonObject.end
//!   }
//! }
//!
//! pub effect fn main() -> i32
//!   ! JsonError | WriterError {
//!   let mut writer = CaptureWriter { bytes: [0; 64], length: 0 }
//!   let point = Point { x: 3, y: -4 }
//!   run Json.serialize(&point, &JsonOptions.compact()) |> Effect.provideMut<Writer>(&mut writer)
//!   if !holds(&writer, b"{\"x\":3,\"y\":-4}") {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Data formats

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.f64
import silk.format { Format, ParseError, NotANumber, OutOfRange }
import silk.json.output { JsonOptions, JsonOutput }
import silk.json.scanner { JsonError, JsonReason, JsonScanner, JsonToken }
import silk.option { Option }
import silk.core.result { Result }
import silk.text.string { String }
import silk.num.usize
import silk.collections.list { List }
import silk.json.text { JsonText }
import silk.io.writer { Writer, WriterError }

/// A type that can write itself as one JSON value.
///
/// # When to use
/// Implement it for your type to write the type with `silk.json.value.Json.serialize`. The
/// standard library implements it for `bool`, the integer types, `f32`, `f64`, strings,
/// `Option<T>` (`null` when absent), and `List<T>` (an array).
///
/// # Details
/// An implementation for a struct usually writes an object with `silk.json.object.JsonObject`, or
/// uses `silk.json.reflect.JsonReflect.write`.
///
/// # Errors
/// - `JsonError` when a value cannot be written, such as a float that is not finite. A float that
///   is not finite fails before any bytes are written.
pub interface Serialize {
  /// Writes `self` as one JSON value to the `Writer`, with `options`.
  effect fn serialize(self: &Self, options: &JsonOptions)
    -> () ! JsonError | WriterError ? &mut Writer
}

/// A type that can read itself from one JSON value without memory from an `Allocator`.
///
/// # When to use
/// Implement it for your type to read the type with `silk.json.value.Json.decode`. If the type
/// needs memory, implement [`Deserialize`] instead. The standard library implements it for `bool`,
/// the integer types, `f32`, `f64`, and `Option<T>` of those (`null` when absent).
///
/// # Gotchas
/// `decode` reads exactly one value and leaves the next token, such as `,` or `]`, for the caller.
/// The caller must check that the document ends.
pub interface Decode {
  /// Reads one value from `scanner`. It leaves the next token unread.
  fn decode(scanner: &mut JsonScanner) -> Result<Self, JsonError>
}

/// A type that can read itself from one JSON value and can use memory from the `Allocator`.
///
/// # When to use
/// Implement it for your type to read the type with `silk.json.value.Json.deserialize`. The
/// standard library implements it for `bool`, the integer types, `f32`, `f64`, strings,
/// `Option<T>` (`null` when absent), and `List<T>`.
///
/// # Details
/// An implementation for a struct reads tokens from the `JsonScanner` and calls
/// [`JsonCodec.deserializeOne`] for each field.
///
/// # Gotchas
/// `deserialize` reads exactly one value and leaves the next token, such as `,` or `]`, for the
/// caller. The caller must check that the document ends.
pub interface Deserialize {
  /// Reads one value from `scanner`. It leaves the next token unread.
  effect fn deserialize(scanner: &mut JsonScanner)
    -> Self ! JsonError | OutOfMemoryError ? &mut Allocator
}

/// The owner type of the generic read and write operations. It has no fields and is never
/// constructed.
pub struct JsonCodec {}

impl JsonCodec {
  /// Reads one value of type `T` from `scanner` with its `Decode` implementation. It leaves the
  /// next token unread.
  ///
  /// # Errors
  ///
  /// - `JsonError` if the value is not valid JSON or does not have type `T`.
  pub fn decodeOne<T: Decode>(scanner: &mut JsonScanner) -> Result<T, JsonError> {
    return Decode.decode(&mut scanner.*)
  }

  /// Reads one value of type `T` from `scanner` with its `Deserialize` implementation. It leaves
  /// the next token unread.
  ///
  /// # When to use
  ///
  /// Call it for each field in your own `Deserialize` implementation.
  ///
  /// # Errors
  ///
  /// - `JsonError` if the value is not valid JSON or does not have type `T`.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the value.
  pub effect fn deserializeOne<T: Deserialize>(scanner: &mut JsonScanner)
    -> T ! JsonError | OutOfMemoryError ? &mut Allocator {
    return run Deserialize.deserialize(&mut scanner.*)
  }

  /// Writes `value` with its `Serialize` implementation.
  ///
  /// # Errors
  ///
  /// - `JsonError` from the implementation, such as for a float that is not finite.
  /// - `WriterError` if the `Writer` fails. Bytes that it accepted before the failure stay written.
  pub effect fn writeOne<T: Serialize>(value: &T, options: &JsonOptions)
    -> () ! JsonError | WriterError ? &mut Writer {
    return run Serialize.serialize(value, options)
  }
}

fn number<T>(scanner: &mut JsonScanner, parser: fn(string) -> Result<T, ParseError>)
  -> Result<T, JsonError> {
  let token = JsonScanner.next(&mut scanner.*)
  return match move token {
    Result<JsonToken, JsonError>.Failure { error } => Result<T, JsonError>.failResult(move error)
    Result<JsonToken, JsonError>.Success { value } => match move value {
      JsonToken.Number { span } => {
        let start = span.offset
        // The scanner accepts only ASCII bytes in a number token.
        let text = unsafe Intrinsic.stringFromUtf8Unchecked(
          JsonScanner.slice(&scanner.*, move span))
        return match move parser(text) {
          Result<T, ParseError>.Success { value: parsed } => Result<T, JsonError>.succeed(move parsed)
          Result<T, ParseError>.Failure { error } => match move error.reason {
            NotANumber { offset: _ } => Result<T, JsonError>.failResult(
              JsonError.at(JsonReason.TypeMismatch, start))
            OutOfRange {} => Result<T, JsonError>.failResult(
              JsonError.at(JsonReason.NumberOutOfRange, start))
          }
        }
      }
      _ => Result<T, JsonError>.failResult(
        JsonError.at(JsonReason.TypeMismatch, JsonScanner.offset(&scanner.*)))
    }
  }
}

effect fn decoded<T: Decode>(scanner: &mut JsonScanner) -> T ! JsonError {
  return match move Decode.decode(&mut scanner.*) {
    Result<T, JsonError>.Success { value } => move value
    Result<T, JsonError>.Failure { error } => { fail move error }
  }
}

impl Serialize for bool {
  effect fn serialize(self: &Self, options: &JsonOptions)
    -> () ! JsonError | WriterError ? &mut Writer {
    if self.* { return run Writer.writeAll(b"true") }
    return run Writer.writeAll(b"false")
  }
}

impl Decode for bool {
  fn decode(scanner: &mut JsonScanner) -> Result<Self, JsonError> {
    let token = JsonScanner.next(&mut scanner.*)
    return match move token {
      Result<JsonToken, JsonError>.Failure { error } =>
        Result<bool, JsonError>.failResult(move error)
      Result<JsonToken, JsonError>.Success { value } => match move value {
        JsonToken.True => Result<bool, JsonError>.succeed(true)
        JsonToken.False => Result<bool, JsonError>.succeed(false)
        _ => Result<bool, JsonError>.failResult(
          JsonError.at(JsonReason.TypeMismatch, JsonScanner.offset(&scanner.*)))
      }
    }
  }
}

impl Deserialize for bool {
  effect fn deserialize(scanner: &mut JsonScanner)
    -> Self ! JsonError | OutOfMemoryError ? &mut Allocator {
    return run decoded<bool>(&mut scanner.*)
  }
}

impl Serialize for u8 {
  effect fn serialize(self: &Self, options: &JsonOptions)
    -> () ! JsonError | WriterError ? &mut Writer {
    return run Format.display<u8>(self)
  }
}

impl Decode for u8 {
  fn decode(scanner: &mut JsonScanner) -> Result<Self, JsonError> {
    return number<u8>(&mut scanner.*, Format.u8Value)
  }
}

impl Deserialize for u8 {
  effect fn deserialize(scanner: &mut JsonScanner)
    -> Self ! JsonError | OutOfMemoryError ? &mut Allocator {
    return run decoded<u8>(&mut scanner.*)
  }
}

