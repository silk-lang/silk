//! Parse JSON into a tree of values, read fields from it, and write it back.
//!
//! # When to use
//! Use [`Json.parse`] when the shape of a document is not fixed, or when you need only a few fields
//! of a larger document. Read the fields with [`Json.field`], [`Json.fieldAt`], and the `as...`
//! functions. Use [`Json.deserialize`] or [`Json.decode`] to read a document straight into a typed
//! value, and [`Json.serialize`] to write a typed value. To read tokens without building a tree,
//! use `silk.json.scanner`.
//!
//! # Details
//! Parsing is strict (RFC 8259): no comments, no trailing commas, and no duplicate keys in an
//! object. Arrays and objects keep the order of the source. Numbers and string escapes are converted
//! when the document is parsed: an integer that fits in `i64` or `u64` stays exact, and any other
//! number becomes the nearest `f64`. If parsing fails, everything that was built is released.
//!
//! # Errors
//! - `JsonError` if the input is not valid JSON, has a duplicate key, has a number too large for a
//!   finite `f64`, nests deeper than `MAX_DEPTH` (64), or has content after the value. `offset` gives the position.
//! - `OutOfMemoryError` if the `Allocator` cannot supply the tree.
//! - `WriterError` from the write functions if the `Writer` fails.
//!
//! # Gotchas
//! A borrowed field or string cannot live longer than the [`Value`] that owns it. The write
//! functions do not flush the `Writer`.
//!
//! # Examples
//! ## Read fields from a document
//! ```silk
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.core.effect { Effect }
//! import silk.json.scanner { JsonError }
//! import silk.json.value { Json }
//! import silk.core.option { Option }
//!
//! pub effect fn main() -> i32
//!   ! JsonError | OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let document = run Json.parse(b"{\"id\":42,\"user\":{\"name\":\"Ada\"}}")
//!     |> Effect.provideMut<Allocator>(&mut allocator)
//!   let id = Json.field(&document, "id") |> Json.asI32 |> Option<i32>.unwrapOr(0)
//!   let name = Json.field(&document, "user") |> Json.fieldAt("name") |> Json.asString
//!     |> Option<string>.unwrapOr("")
//!   if id != 42 || name != "Ada" {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! ## Read a typed value directly
//! ```silk
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.core.effect { Effect }
//! import silk.json.scanner { JsonError }
//! import silk.json.value { Json }
//! import silk.collections.list { List }
//!
//! pub effect fn main() -> i32
//!   ! JsonError | OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let values = run Json.deserialize<List<i64>>(b"[1, 2, 39]")
//!     |> Effect.provideMut<Allocator>(&mut allocator)
//!   if List<i64>.length(&values) != 3 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Data formats

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.f64
import silk.text.format { Format, ParseError }
import silk.json.output { JsonOptions, JsonOutput }
import silk.json.scanner { JsonError, JsonReason, JsonScanner, JsonSyntax, JsonToken, MAX_DEPTH }
import silk.json.codec { Decode, Deserialize, JsonCodec, Serialize }
import silk.json.text { JsonText }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.text.string { String }
import silk.num.i64
import silk.num.u64
import silk.num.u8
import silk.num.usize
import silk.collections.list { List }
import silk.io.writer { Writer, WriterError }
import silk.core.effect { Effect }
import silk.collections.slice { Slice }
import silk.simd.simd
import silk.simd.mask16
import silk.simd.u8x16

/// One key and value of a JSON object.
pub struct JsonEntry {
  /// The key, with escapes decoded.
  pub key: String,
  /// The value.
  pub value: Value,
}

/// A JSON number, converted to the type that holds it exactly when there is one.
///
/// # Details
///
/// An integer written without a fraction or an exponent is `Integer` if it fits in `i64` and
/// `Unsigned` if it is larger but fits in `u64`. Any other number is `Float`, rounded to the nearest
/// `f64` with ties to even. `1.0` and `1e3` are floats.
///
/// # Gotchas
///
/// `Json.write` fails with `InvalidNumber` for a `Float` that is not finite.
pub union JsonNumber {
  /// An integer that fits in `i64`.
  Integer {
    /// The value.
    pub value: i64
  },
  /// An integer more than `i64.MAX` that fits in `u64`.
  Unsigned {
    /// The value.
    pub value: u64
  },
  /// A number with a fraction or an exponent, or an integer too large for `u64`.
  Float {
    /// The nearest `f64`.
    pub value: f64
  },
}

impl Copy for JsonNumber {}

/// One JSON value: null, a boolean, a number, a string, an array, or an object.
///
/// # Details
///
/// A `Value` owns all of its children. Use `match` to get the kind, or the `Json.as...` functions
/// to read a field of a known kind. Arrays and objects keep the order of the source. A number is
/// converted when the document is parsed, as a [`JsonNumber`].
///
/// # Gotchas
///
/// A borrowed field or string cannot live longer than the `Value` that owns it.
pub union Value {
  /// JSON `null`.
  Null,
  /// JSON `true` or `false`.
  Bool {
    /// The boolean value.
    pub value: bool
  },
  /// A JSON number.
  Number {
    /// The number, converted when the document was parsed.
    pub value: JsonNumber
  },
  /// A JSON string.
  String {
    /// The text, with escapes decoded.
    pub text: String
  },
  /// A JSON array.
  Array {
    /// The elements in source order.
    pub values: List<Value>
  },
  /// A JSON object.
  Object {
    /// The members in source order.
    pub entries: List<JsonEntry>
  },
}

/// The owner type of the JSON parse, write, and read operations. It has no fields and is never
/// constructed.
pub struct Json {}

impl Json {
  /// Parses `bytes` as one complete JSON document and returns its tree.
  ///
  /// # When to use
  ///
  /// Use it when the shape of a document is not fixed, or when you need only a few fields of a
  /// larger document. To read a typed value, use [`Json.deserialize`] or [`Json.decode`].
  ///
  /// # Details
  ///
  /// Parsing is strict (RFC 8259): no comments, no trailing commas, and no duplicate keys in an
  /// object. String escapes are decoded when the document is parsed.
  ///
  /// # Errors
  ///
  /// - `JsonError` if `bytes` is not one valid JSON value, if an object has a duplicate key, if the
  ///   nesting is deeper than 64, or if content follows the value. The partial tree is dropped.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the tree.
  pub effect fn parse(bytes: &[u8]) -> Value ! JsonError | OutOfMemoryError ? &mut Allocator {
    let mut cursor = TreeCursor { index: usize.ZERO, depth: usize.ZERO, failed: false }
    let mut scratch = Scratch { values: List<Value>.make(), entries: List<JsonEntry>.make() }
    let document = run treeValue(bytes, &mut cursor, &mut scratch)
    if !cursor.failed && JsonSyntax.skipWhitespace(bytes, cursor.index) == bytes.length {
      return move document
    }
    drop document
    return run parseScanned(bytes)
  }

  /// Reads `bytes` as one complete JSON document of type `T`. It does not allocate.
  ///
  /// # When to use
  ///
  /// Use it for types that implement `Decode`, such as numbers and `bool`. Use [`Json.deserialize`]
  /// for types that need memory, such as `String` and `List<T>`.
  ///
  /// # Errors
  ///
  /// - `JsonError` if the JSON is not valid, the value does not have type `T` (`TypeMismatch`), a
  ///   number does not fit (`NumberOutOfRange`), or content follows the value (`TrailingContent`).
  pub fn decode<T: Decode>(bytes: &[u8]) -> Result<T, JsonError> {
    let mut scanner = JsonScanner.make(bytes)
    let parsed = JsonCodec.decodeOne<T>(&mut scanner)
    return match move parsed {
      Result<T, JsonError>.Failure { error } => Result<T, JsonError>.failResult(move error)
      Result<T, JsonError>.Success { value } => match move JsonScanner.next(&mut scanner) {
        Result<JsonToken, JsonError>.Failure { error } => Result<T, JsonError>.failResult(move error)
        Result<JsonToken, JsonError>.Success { value: tail } => match move tail {
          JsonToken.EndOfInput => Result<T, JsonError>.succeed(move value)
          _ => Result<T, JsonError>.failResult(
            JsonError.at(JsonReason.TrailingContent, JsonScanner.offset(&scanner)))
        }
      }
    }
  }

  /// Reads `bytes` as one complete JSON document of type `T`.
  ///
  /// # Errors
  ///
  /// - `JsonError` if the JSON is not valid, the value does not have type `T`, or content follows
  ///   the value.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the value.
  pub effect fn deserialize<T: Deserialize>(bytes: &[u8])
    -> T ! JsonError | OutOfMemoryError ? &mut Allocator {
    let mut scanner = JsonScanner.make(bytes)
    let value = run JsonCodec.deserializeOne<T>(&mut scanner)
    let tail = run nextToken(&mut scanner)
    match move tail {
      JsonToken.EndOfInput => { return move value }
      _ => { fail JsonError.at(JsonReason.TrailingContent, JsonScanner.offset(&scanner)) }
    }
  }

  /// Writes `value` as JSON to the `Writer`, with `options`.
  ///
  /// # Errors
  ///
  /// - `JsonError` if the nesting is deeper than the limit in `options`, or a float is not finite.
  /// - `WriterError` if the `Writer` fails. Bytes that it accepted before the failure stay written.
  ///
  /// # Examples
  ///
  /// ## Write a struct
  /// ```silk
  /// import silk.core.effect { Effect }
  /// import silk.json.codec { Serialize }
  /// import silk.json.object { JsonObject }
  /// import silk.json.output { JsonOptions }
  /// import silk.json.scanner { JsonError }
  /// import silk.json.value { Json }
  /// import silk.io.writer { Writer, WriterError }
  ///
  /// struct CaptureWriter {
  ///   bytes: [u8; 64],
  ///   length: usize,
  /// }
  ///
  /// impl Writer for CaptureWriter {
  ///   effect fn writeAll(self: &mut Self, value: &[u8]) -> ()
  ///     ! WriterError
  ///     ? &mut Writer {
  ///     let mut index: usize = 0
  ///     while index < value.length {
  ///       self.bytes[self.length] = value[index]
  ///       self.length = self.length + 1
  ///       index = index + 1
  ///     }
  ///     return ()
  ///   }
  ///
  ///   effect fn flush(self: &mut Self) -> ()
  ///     ! WriterError
  ///     ? &mut Writer {
  ///     return ()
  ///   }
  /// }
  ///
  /// fn holds(writer: &CaptureWriter, expected: &[u8]) -> bool {
  ///   if writer.length != expected.length {
  ///     return false
  ///   }
  ///   let mut index: usize = 0
  ///   while index < expected.length {
  ///     if writer.bytes[index] != expected[index] {
  ///       return false
  ///     }
  ///     index = index + 1
  ///   }
  ///   return true
  /// }
  ///
  /// struct Point {
  ///   x: i32,
  ///   y: i32,
  /// }
  ///
  /// impl Serialize for Point {
  ///   effect fn serialize(self: &Self, options: &JsonOptions) -> ()
  ///     ! JsonError | WriterError
  ///     ? &mut Writer {
  ///     return run JsonObject.begin(options) |> JsonObject.field("x", &self.x)
  ///       |> JsonObject.field("y", &self.y)
  ///       |> JsonObject.end
  ///   }
  /// }
  ///
  /// pub effect fn main() -> i32
  ///   ! JsonError | WriterError {
  ///   let mut writer = CaptureWriter { bytes: [0; 64], length: 0 }
  ///   let point = Point { x: 3, y: -4 }
  ///   run Json.serialize(&point, &JsonOptions.compact()) |> Effect.provideMut<Writer>(&mut writer)
  ///   if !holds(&writer, b"{\"x\":3,\"y\":-4}") {
  ///     return 1
  ///   }
  ///   return 0
  /// }
  /// ```
  pub effect fn serialize<T: Serialize>(value: &T, options: &JsonOptions)
    -> () ! JsonError | WriterError ? &mut Writer {
    return run JsonCodec.writeOne<T>(value, options)
  }

  /// Writes `document` as compact JSON to the `Writer`. It does not flush the `Writer`.
  ///
  /// # Errors
  ///
  /// - `JsonError` if the nesting is deeper than 64.
  /// - `WriterError` if the `Writer` fails.
  ///
  /// # Gotchas
  ///
  /// The text goes to the `Writer` in pieces of up to 4 KiB. After a failure, the `Writer` holds
  /// only the pieces passed to it before the failure.
  pub effect fn write(document: &Value) -> () ! JsonError | WriterError ? &mut Writer {
    let options = JsonOptions.compact()
    return run Json.writeWith(document, &options)
  }

  /// Writes `document` as JSON to the `Writer`, with the indentation and depth limit of `options`.
  /// It does not flush the `Writer`.
  ///
  /// # Errors
  ///
  /// - `JsonError` if the nesting is deeper than the limit in `options`.
  /// - `WriterError` if the `Writer` fails.
  ///
  /// # Gotchas
  ///
  /// The text goes to the `Writer` in pieces of up to 4 KiB. After a failure, the `Writer` holds
  /// only the pieces passed to it before the failure.
  pub effect fn writeWith(document: &Value, options: &JsonOptions)
    -> () ! JsonError | WriterError ? &mut Writer {
    let mut buffer = OutputBuffer { bytes: [0; 4096], length: usize.ZERO }
    run writeNode(document, options, &mut buffer)
    return run flushOutput(&mut buffer)
  }

  /// Returns the value of member `key` of an object. Returns an absent option if `self` is not an
  /// object or has no such key.
  pub fn field<'a>(self: &'a Value, key: string) -> Option<&'a Value> {
    return match &self.* {
      Value.Object { entries } => findMember(&entries, key)
      _ => Option<&'a Value>.none()
    }
  }

  /// Returns the value of member `key` if `self` is a present object. Returns an absent option in
  /// other cases.
  ///
  /// # When to use
  ///
  /// Use it to read nested fields in a chain: `Json.field(&doc, "user") |> Json.fieldAt("name")`.
  pub fn fieldAt<'a>(self: Option<&'a Value>, key: string) -> Option<&'a Value> {
    return match move self {
      Option<&'a Value>.None => Option<&'a Value>.none()
      Option<&'a Value>.Some { value } => Json.field(value, key)
    }
  }

  /// Returns the number as `i32`. Returns an absent option if the value is absent, is not an
  /// integer (`1.0` and `1e3` are not), or does not fit in `i32`.
  pub fn asI32(self: Option<&Value>) -> Option<i32> {
    return match move Json.asI64(self) {
      Option<i64>.None => Option<i32>.none()
      Option<i64>.Some { value } => i64.checkedToI32(value)
    }
  }

  /// Returns the number as `i64`. Returns an absent option if the value is absent, is not an
  /// integer (`1.0` and `1e3` are not), or does not fit in `i64`.
  pub fn asI64(self: Option<&Value>) -> Option<i64> {
    return match move numberOf(self) {
      Option<JsonNumber>.Some { value } => match value {
        JsonNumber.Integer { value: integer } => Option<i64>.some(integer)
        _ => Option<i64>.none()
      }
      Option<JsonNumber>.None => Option<i64>.none()
    }
  }

  /// Returns the number as `u64`. Returns an absent option if the value is absent, is not an
  /// integer (`1.0` and `1e3` are not), or does not fit in `u64`.
  pub fn asU64(self: Option<&Value>) -> Option<u64> {
    return match move numberOf(self) {
      Option<JsonNumber>.Some { value } => match value {
        JsonNumber.Integer { value: integer } => i64.checkedToU64(integer)
        JsonNumber.Unsigned { value: integer } => Option<u64>.some(integer)
        _ => Option<u64>.none()
      }
      Option<JsonNumber>.None => Option<u64>.none()
    }
  }

  /// Returns the number as `f64`, rounded to the nearest value. Returns an absent option if the
  /// value is absent, is not a number, or is not finite.
  pub fn asF64(self: Option<&Value>) -> Option<f64> {
    return match move numberOf(self) {
      Option<JsonNumber>.Some { value } => match value {
        JsonNumber.Integer { value: integer } => Option<f64>.some(i64.toF64(integer))
        JsonNumber.Unsigned { value: integer } => Option<f64>.some(u64.toF64(integer))
        JsonNumber.Float { value: float } => {
          if !f64.isFinite(float) { return Option<f64>.none() }
          return Option<f64>.some(float)
        }
      }
      Option<JsonNumber>.None => Option<f64>.none()
    }
  }

  /// Returns the number as `f32`, rounded to the nearest value. Returns an absent option if the
  /// value is absent, is not a number, or is too large for a finite `f32`.
  ///
  /// # Gotchas
  ///
  /// A `Float` was already rounded to `f64` when the document was parsed, so it is rounded two
  /// times.
  pub fn asF32(self: Option<&Value>) -> Option<f32> {
    let converted = match move numberOf(self) {
      Option<JsonNumber>.Some { value } => match value {
        JsonNumber.Integer { value: integer } => i64.toF32(integer)
        JsonNumber.Unsigned { value: integer } => u64.toF32(integer)
        JsonNumber.Float { value: float } => f64.toF32(float)
      }
      Option<JsonNumber>.None => { return Option<f32>.none() }
    }
    if !f32.isFinite(converted) { return Option<f32>.none() }
    return Option<f32>.some(converted)
  }

  /// Returns the text of a string. Returns an absent option if the value is absent or is not a
  /// string. The text is borrowed from the tree.
  pub fn asString<'a>(self: Option<&'a Value>) -> Option<string<'a>> {
    return match move self {
      Option<&'a Value>.None => Option<string<'a>>.none()
      Option<&'a Value>.Some { value } => match &value.* {
        Value.String { text } => Option<string<'a>>.some(String.view(&text))
        _ => Option<string<'a>>.none()
      }
    }
  }
}

impl Serialize for Value {
  effect fn serialize(self: &Self, options: &JsonOptions)
    -> () ! JsonError | WriterError ? &mut Writer {
    return run Json.writeWith(self, options)
  }
}

impl Deserialize for Value {
  effect fn deserialize(scanner: &mut JsonScanner)
    -> Self ! JsonError | OutOfMemoryError ? &mut Allocator {
    let first = run nextToken(&mut scanner.*)
    let end = JsonScanner.length(&scanner.*)
    let mut scratch = Scratch { values: List<Value>.make(), entries: List<JsonEntry>.make() }
    return run parseValue(&mut scanner.*, &mut scratch, first, end)
  }
}


// Parses `bytes` token by token with `JsonScanner`, which checks the grammar and reports the first
// error where it is. `Json.parse` uses it only for documents that its own parser rejects.
effect fn parseScanned(bytes: &[u8]) -> Value ! JsonError | OutOfMemoryError ? &mut Allocator {
  let mut scanner = JsonScanner.make(bytes)
  let mut scratch = Scratch { values: List<Value>.make(), entries: List<JsonEntry>.make() }
  let first = run nextToken(&mut scanner)
  let document = run parseValue(&mut scanner, &mut scratch, first, bytes.length)
  let tail = run nextToken(&mut scanner)
  match move tail {
    JsonToken.EndOfInput => { return move document }
    _ => { fail inputError(JsonReason.TrailingContent, bytes.length) }
  }
}

fn numberOf(value: Option<&Value>) -> Option<JsonNumber> {
  return match move value {
    Option<&Value>.Some { value: present } => match &present.* {
      Value.Number { value: number } => Option<JsonNumber>.some(number)
      _ => Option<JsonNumber>.none()
    }
    Option<&Value>.None => Option<JsonNumber>.none()
  }
}

// Converts the text of a number token, which the scanner checked. `offset` is its position.
effect fn convertNumber(raw: &[u8], offset: usize) -> JsonNumber ! JsonError {
  let mut index = usize.ZERO
  let negative = raw[0] == 45
  if negative { index = usize.ONE }
  let digits = index
  let mut magnitude: u64 = 0
  // Nineteen digits always fit in `u64`.
  while index < raw.length && index - digits < 19 {
    let byte = raw[index]
    if byte < 48 || byte > 57 { break }
    magnitude = magnitude * 10 + u8.toU64(byte - 48)
    index = index + usize.ONE
  }
  if index == raw.length {
    if !negative {
      if magnitude <= 9223372036854775807 {
        return JsonNumber.Integer { value: u64.toI64(magnitude) }
      }
      return JsonNumber.Unsigned { value: magnitude }
    }
    // `-0` keeps its sign, which only a float can hold.
    if magnitude == 0 { return JsonNumber.Float { value: -0.0 } }
    if magnitude <= 9223372036854775807 {
      return JsonNumber.Integer { value: 0 - u64.toI64(magnitude) }
    }
    if magnitude == 9223372036854775808 { return JsonNumber.Integer { value: i64.MIN } }
  }
  // The scanner accepts only ASCII bytes in a number token.
  let text = unsafe Intrinsic.stringFromUtf8Unchecked(raw)
  if index < raw.length && raw[index] >= 48 && raw[index] <= 57 && isInteger(raw, index) {
    if !negative {
      if let Result<u64, ParseError>.Success { value } = Format.u64Value(text) {
        return JsonNumber.Unsigned { value: value }
      }
    }
  }
  return match move Format.f64Value(text) {
    Result<f64, ParseError>.Success { value } => {
      if !f64.isFinite(value) { fail inputError(JsonReason.NumberOutOfRange, offset) }
      return JsonNumber.Float { value: value }
    }
    Result<f64, ParseError>.Failure {..} => { fail inputError(JsonReason.InvalidNumber, offset) }
  }
}

// `true` if the bytes of `raw` from `from` are all digits.
fn isInteger(raw: &[u8], from: usize) -> bool {
  let mut index = from
  while index < raw.length {
    if raw[index] < 48 || raw[index] > 57 { return false }
    index = index + usize.ONE
  }
  return true
}

fn findMember<'a>(entries: &'a List<JsonEntry>, key: string) -> Option<&'a Value> {
  let members = List<JsonEntry>.asSlice(entries)
  let mut index = usize.ZERO
  while index < members.length {
    if String.view(&members[index].key) == key { return Option<&'a Value>.some(&members[index].value) }
    index = index + usize.ONE
  }
  return Option<&'a Value>.none()
}

effect fn nextToken(scanner: &mut JsonScanner) -> JsonToken ! JsonError {
  return match move JsonScanner.next(&mut scanner.*) {
    Result<JsonToken, JsonError>.Success { value } => move value
    Result<JsonToken, JsonError>.Failure { error } => { fail move error }
  }
}

// The elements and members of the arrays and objects that are open. A container keeps its children
// at the end of these lists until it closes, and then moves them into a list of exactly their size.
struct Scratch {
  values: List<Value>,
  entries: List<JsonEntry>,
}

effect fn parseValue(scanner: &mut JsonScanner, scratch: &mut Scratch, token: JsonToken, end: usize)
  -> Value ! JsonError | OutOfMemoryError ? &mut Allocator {
  return match move token {
    JsonToken.Null => Value.Null
    JsonToken.True => Value.Bool { value: true }
    JsonToken.False => Value.Bool { value: false }
    JsonToken.Number { span } => {
      let offset = span.offset
      return Value.Number { value: run convertNumber(JsonScanner.slice(&scanner.*, move span), offset) }
    }
    JsonToken.String { span, escaped } => {
      let offset = span.offset
      let decoded = run JsonText.decode(JsonScanner.slice(&scanner.*, move span), offset, escaped)
      return Value.String { text: unsafe String.fromBytesUnchecked(move decoded) }
    }
    JsonToken.ArrayBegin => run parseArray(&mut scanner.*, &mut scratch.*, end)
    JsonToken.ObjectBegin => run parseObject(&mut scanner.*, &mut scratch.*, end)
    _ => { fail inputError(JsonReason.UnexpectedByte, end) }
  }
}

effect fn parseArray(scanner: &mut JsonScanner, scratch: &mut Scratch, end: usize)
  -> Value ! JsonError | OutOfMemoryError ? &mut Allocator {
  let mark = List<Value>.length(&scratch.values)
  let mut token = run nextToken(&mut scanner.*)
  match token {
    JsonToken.ArrayEnd => { return Value.Array { values: List<Value>.make() } }
    _ => {}
  }
  while true {
    let value = run parseValue(&mut scanner.*, &mut scratch.*, token, end)
    run List<Value>.append(&mut scratch.values, move value)
    let separator = run nextToken(&mut scanner.*)
    match move separator {
      JsonToken.ArrayEnd => {
        return Value.Array { values: run List<Value>.splitOff(&mut scratch.values, mark) }
      }
      JsonToken.ValueSeparator => {}
      _ => { fail inputError(JsonReason.UnexpectedByte, end) }
    }
    token = run nextToken(&mut scanner.*)
  }
  fail inputError(JsonReason.UnexpectedEnd, end)
}

effect fn parseObject(scanner: &mut JsonScanner, scratch: &mut Scratch, end: usize)
  -> Value ! JsonError | OutOfMemoryError ? &mut Allocator {
  let mark = List<JsonEntry>.length(&scratch.entries)
  let mut token = run nextToken(&mut scanner.*)
  match token {
    JsonToken.ObjectEnd => { return Value.Object { entries: List<JsonEntry>.make() } }
    _ => {}
  }
  while true {
    let key = match move token {
      JsonToken.String { span, escaped } => {
        let offset = span.offset
        let raw = JsonScanner.slice(&scanner.*, move span)
        let decoded = run JsonText.decode(raw, offset, escaped)
        let text = unsafe String.fromBytesUnchecked(move decoded)
        if containsKey(&scratch.entries, mark, String.view(&text)) {
          fail inputError(JsonReason.DuplicateKey, offset)
        }
        move text
      }
      _ => { fail inputError(JsonReason.UnexpectedByte, end) }
    }
    let colon = run nextToken(&mut scanner.*)
    match colon {
      JsonToken.KeySeparator => {}
      _ => { fail inputError(JsonReason.UnexpectedByte, end) }
    }
    let valueToken = run nextToken(&mut scanner.*)
    let value = run parseValue(&mut scanner.*, &mut scratch.*, valueToken, end)
    run List<JsonEntry>.append(&mut scratch.entries, JsonEntry { key: move key, value: move value })
    let separator = run nextToken(&mut scanner.*)
    match move separator {
      JsonToken.ObjectEnd => {
        return Value.Object { entries: run List<JsonEntry>.splitOff(&mut scratch.entries, mark) }
      }
      JsonToken.ValueSeparator => {}
      _ => { fail inputError(JsonReason.UnexpectedByte, end) }
    }
    token = run nextToken(&mut scanner.*)
  }
  fail inputError(JsonReason.UnexpectedEnd, end)
}

// `true` if a member from index `from` of `entries` has the key `key`.
fn containsKey(entries: &List<JsonEntry>, from: usize, key: string) -> bool {
  let members = List<JsonEntry>.asSlice(entries)
  let mut index = from
  while index < members.length {
    if String.view(&members[index].key) == key { return true }
    index = index + usize.ONE
  }
  return false
}

// Where the tree parser of `Json.parse` is in the document. `failed` is set when the parser finds
// anything that is not valid JSON, and the parser then returns at once without a useful value.
struct TreeCursor {
  index: usize,
  depth: usize,
  failed: bool,
}

fn treeFailed(cursor: &mut TreeCursor) -> Value {
  cursor.failed = true
  return Value.Null
}

// `true` if the bytes of `bytes` at `at` are `word`.
fn wordAt(bytes: &[u8], at: usize, word: &[u8]) -> bool {
  if bytes.length - at < word.length { return false }
  let mut index = usize.ZERO
  while index < word.length {
    if bytes[at + index] != word[index] { return false }
    index = index + usize.ONE
  }
  return true
}

// Parses the value that starts after whitespace at `cursor.index`, and moves `cursor.index` after it.
effect fn treeValue(bytes: &[u8], cursor: &mut TreeCursor, scratch: &mut Scratch)
  -> Value ! JsonError | OutOfMemoryError ? &mut Allocator {
  let at = JsonSyntax.skipWhitespace(bytes, cursor.index)
  if at >= bytes.length { return treeFailed(&mut cursor.*) }
  let byte = bytes[at]
  if byte == 34 {
    let mut escaped = false
    let after = JsonSyntax.stringEnd(bytes, at + usize.ONE, &mut escaped)
    if after == usize.ZERO { return treeFailed(&mut cursor.*) }
    cursor.index = after
    let decoded = run JsonText.decode(Slice.view<u8>(bytes, at, after - at), at, escaped)
    return Value.String { text: unsafe String.fromBytesUnchecked(move decoded) }
  }
  if byte == 45 || (byte >= 48 && byte <= 57) { return run treeNumber(bytes, &mut cursor.*, at) }
  if byte == 91 { return run treeArray(bytes, &mut cursor.*, &mut scratch.*, at + usize.ONE) }
  if byte == 123 { return run treeObject(bytes, &mut cursor.*, &mut scratch.*, at + usize.ONE) }
  if byte == 116 && wordAt(bytes, at, b"true") {
    cursor.index = at + 4
    return Value.Bool { value: true }
  }
  if byte == 102 && wordAt(bytes, at, b"false") {
    cursor.index = at + 5
    return Value.Bool { value: false }
  }
  if byte == 110 && wordAt(bytes, at, b"null") {
    cursor.index = at + 4
    return Value.Null
  }
  return treeFailed(&mut cursor.*)
}

// Parses the number that starts at `at` in one pass. A number with more than 19 digits goes to
// `convertNumber`, which reads its text again.
effect fn treeNumber(bytes: &[u8], cursor: &mut TreeCursor, at: usize) -> Value ! JsonError {
  let mut index = at
  let negative = bytes[index] == 45
  if negative { index = index + usize.ONE }
  let digitsStart = index
  let mut significand: u64 = 0
  if index < bytes.length && bytes[index] == 48 {
    index = index + usize.ONE
  } else {
    while index < bytes.length {
      let digit = u8.wrappingSubtract(bytes[index], 48)
      if digit > 9 { break }
      significand = u64.wrappingAdd(u64.wrappingMultiply(significand, 10), u8.toU64(digit))
      index = index + usize.ONE
    }
    if index == digitsStart { return treeFailed(&mut cursor.*) }
  }
  let mut digitCount = index - digitsStart
  let mut fractionCount = usize.ZERO
  let mut float = false
  if index < bytes.length && bytes[index] == 46 {
    index = index + usize.ONE
    let fractionStart = index
    while index < bytes.length {
      let digit = u8.wrappingSubtract(bytes[index], 48)
      if digit > 9 { break }
      significand = u64.wrappingAdd(u64.wrappingMultiply(significand, 10), u8.toU64(digit))
      index = index + usize.ONE
    }
    fractionCount = index - fractionStart
    if fractionCount == usize.ZERO { return treeFailed(&mut cursor.*) }
    digitCount = digitCount + fractionCount
    float = true
  }
  let mut exponent: i64 = 0
  if index < bytes.length && (bytes[index] == 101 || bytes[index] == 69) {
    index = index + usize.ONE
    let mut exponentNegative = false
    if index < bytes.length && (bytes[index] == 43 || bytes[index] == 45) {
      exponentNegative = bytes[index] == 45
      index = index + usize.ONE
    }
    let exponentStart = index
    while index < bytes.length {
      let digit = u8.wrappingSubtract(bytes[index], 48)
      if digit > 9 { break }
      // Any larger exponent is far outside `f64` already, and the cap keeps it from overflowing.
      if exponent < 1000000000000 { exponent = exponent * 10 + u8.toI64(digit) }
      index = index + usize.ONE
    }
    if index == exponentStart { return treeFailed(&mut cursor.*) }
    if exponentNegative { exponent = -exponent }
    float = true
  }
  cursor.index = index
  if digitCount > 19 {
    // The scanner checks what follows the number before it converts it, so the errors match.
    if JsonSyntax.numberEnd(bytes, at) != index { return treeFailed(&mut cursor.*) }
    return Value.Number { value: run convertNumber(Slice.view<u8>(bytes, at, index - at), at) }
  }
  if !float {
    if !negative {
      if significand <= 9223372036854775807 {
        return Value.Number { value: JsonNumber.Integer { value: u64.toI64(significand) } }
      }
      return Value.Number { value: JsonNumber.Unsigned { value: significand } }
    }
    if significand != 0 && significand <= 9223372036854775807 {
      return Value.Number { value: JsonNumber.Integer { value: 0 - u64.toI64(significand) } }
    }
    if significand == 9223372036854775808 {
      return Value.Number { value: JsonNumber.Integer { value: i64.MIN } }
    }
  }
  let mut value = Format.f64FromDecimal(significand, exponent - usize.toI64(fractionCount))
  // The scanner path reports the error, after it checks what follows the number.
  if !f64.isFinite(value) { return treeFailed(&mut cursor.*) }
  if negative { value = -value }
  return Value.Number { value: JsonNumber.Float { value: value } }
}

// Parses the rest of the array whose `[` is before `start`.
effect fn treeArray(bytes: &[u8], cursor: &mut TreeCursor, scratch: &mut Scratch, start: usize)
  -> Value ! JsonError | OutOfMemoryError ? &mut Allocator {
  if cursor.depth == MAX_DEPTH { return treeFailed(&mut cursor.*) }
  let mut at = JsonSyntax.skipWhitespace(bytes, start)
  if at < bytes.length && bytes[at] == 93 {
    cursor.index = at + usize.ONE
    return Value.Array { values: List<Value>.make() }
  }
  cursor.depth = cursor.depth + usize.ONE
  cursor.index = at
  let mark = List<Value>.length(&scratch.values)
  while true {
    let value = run treeValue(bytes, &mut cursor.*, &mut scratch.*)
    if cursor.failed { return move value }
    run List<Value>.append(&mut scratch.values, move value)
    at = JsonSyntax.skipWhitespace(bytes, cursor.index)
    if at >= bytes.length { break }
    let byte = bytes[at]
    cursor.index = at + usize.ONE
    if byte == 93 {
      cursor.depth = cursor.depth - usize.ONE
      return Value.Array { values: run List<Value>.splitOff(&mut scratch.values, mark) }
    }
    if byte != 44 { break }
  }
  return treeFailed(&mut cursor.*)
}

// Parses the rest of the object whose `{` is before `start`.
effect fn treeObject(bytes: &[u8], cursor: &mut TreeCursor, scratch: &mut Scratch, start: usize)
  -> Value ! JsonError | OutOfMemoryError ? &mut Allocator {
  if cursor.depth == MAX_DEPTH { return treeFailed(&mut cursor.*) }
  let mut at = JsonSyntax.skipWhitespace(bytes, start)
  if at < bytes.length && bytes[at] == 125 {
    cursor.index = at + usize.ONE
    return Value.Object { entries: List<JsonEntry>.make() }
  }
  cursor.depth = cursor.depth + usize.ONE
  let mark = List<JsonEntry>.length(&scratch.entries)
  while true {
    if at >= bytes.length || bytes[at] != 34 { break }
    let mut escaped = false
    let after = JsonSyntax.stringEnd(bytes, at + usize.ONE, &mut escaped)
    if after == usize.ZERO { break }
    let decoded = run JsonText.decode(Slice.view<u8>(bytes, at, after - at), at, escaped)
    let key = unsafe String.fromBytesUnchecked(move decoded)
    if containsKey(&scratch.entries, mark, String.view(&key)) { break }
    at = JsonSyntax.skipWhitespace(bytes, after)
    if at >= bytes.length || bytes[at] != 58 { break }
    cursor.index = at + usize.ONE
    let value = run treeValue(bytes, &mut cursor.*, &mut scratch.*)
    if cursor.failed { return move value }
    run List<JsonEntry>.append(&mut scratch.entries, JsonEntry { key: move key, value: move value })
    at = JsonSyntax.skipWhitespace(bytes, cursor.index)
    if at >= bytes.length { break }
    let byte = bytes[at]
    cursor.index = at + usize.ONE
    if byte == 125 {
      cursor.depth = cursor.depth - usize.ONE
      return Value.Object { entries: run List<JsonEntry>.splitOff(&mut scratch.entries, mark) }
    }
    if byte != 44 { break }
    at = JsonSyntax.skipWhitespace(bytes, cursor.index)
  }
  return treeFailed(&mut cursor.*)
}

// The writer collects output here and passes it to the ambient `Writer` in large pieces, so that
// each comma, bracket, and number costs a copy instead of a `Writer` call.
struct OutputBuffer {
  bytes: [u8; 4096],
  length: usize,
}

const OUTPUT_CAPACITY: usize = 4096

effect fn outputWrite(self: &mut OutputBuffer, values: &[u8]) -> () ! WriterError {
  if values.length > OUTPUT_CAPACITY - self.length { fail Writer.failure() }
  Slice.copyInto<u8>(&mut self.bytes, self.length, values)
  self.length = self.length + values.length
}

effect fn outputFlush(self: &mut OutputBuffer) -> () ! WriterError { return () }

impl Writer for OutputBuffer {
  writeAll: OutputBuffer.outputWrite
  flush: OutputBuffer.outputFlush
}

effect fn flushOutput(buffer: &mut OutputBuffer) -> () ! WriterError ? &mut Writer {
  if buffer.length == usize.ZERO { return () }
  run Writer.writeAll(Slice.view<u8>(&buffer.bytes, usize.ZERO, buffer.length))
  buffer.length = usize.ZERO
}

// Makes room for `size` more bytes, which is at most `OUTPUT_CAPACITY`.
@inlineAlways
effect fn reserveOutput(buffer: &mut OutputBuffer, size: usize) -> () ! WriterError ? &mut Writer {
  if size > OUTPUT_CAPACITY - buffer.length { run flushOutput(&mut buffer) }
}

// Appends one byte that `reserveOutput` made room for.
@inlineAlways
fn pushOutput(buffer: &mut OutputBuffer, byte: u8) -> () {
  buffer.bytes[buffer.length] = byte
  buffer.length = buffer.length + usize.ONE
}

@inlineAlways
effect fn literalOutput(buffer: &mut OutputBuffer, text: &[u8]) -> () ! WriterError ? &mut Writer {
  run reserveOutput(&mut buffer, text.length)
  Slice.copyInto<u8>(&mut buffer.bytes, buffer.length, text)
  buffer.length = buffer.length + text.length
}

// An escaped byte takes at most 6 bytes, so a string of up to this many bytes always fits in an
// empty buffer with its quotes.
const BUFFERED_STRING_LIMIT: usize = 680

effect fn stringOutput(buffer: &mut OutputBuffer, text: string) -> () ! WriterError ? &mut Writer {
  let size = String.byteLength(text)
  if size > BUFFERED_STRING_LIMIT {
    run flushOutput(&mut buffer)
    return run JsonOutput.writeString(text)
  }
  run reserveOutput(&mut buffer, size * 6 + 2)
  if plainStringOutput(&mut buffer, String.utf8Bytes(text)) { return () }
  return run JsonOutput.writeString(text) |> Effect.provideMut<Writer>(&mut buffer)
}

// Appends `bytes` in quotes if none of them needs an escape, and returns `true`. Otherwise
// appends nothing and returns `false`. `reserveOutput` made room for the text.
@inlineAlways
fn plainStringOutput(buffer: &mut OutputBuffer, bytes: &[u8]) -> bool {
  let start = buffer.length
  pushOutput(&mut buffer, 34)
  let mut index = usize.ZERO
  static if simd.hardware() {
    let quote = u8x16.splat(34)
    let backslash = u8x16.splat(92)
    let space = u8x16.splat(32)
    // Each block of 16 is stored whole. When it holds a byte to escape, the bytes after that
    // byte are written over or left past the end of the output.
    while index + 16 <= bytes.length {
      let lanes = u8x16.load(bytes, index)
      u8x16.store(&mut buffer.bytes, buffer.length, lanes)
      let stops = u8x16.lanesEqual(lanes, quote) | u8x16.lanesEqual(lanes, backslash) |
        u8x16.lanesLess(lanes, space)
      if mask16.any(stops) {
        buffer.length = start
        return false
      }
      buffer.length = buffer.length + 16
      index = index + 16
    }
  }
  while index < bytes.length {
    let byte = bytes[index]
    if byte == 34 || byte == 92 || byte < 32 {
      buffer.length = start
      return false
    }
    pushOutput(&mut buffer, byte)
    index = index + usize.ONE
  }
  pushOutput(&mut buffer, 34)
  return true
}

// Compact output, the common case, stays inline in the loops of `writeNode`.
@inlineAlways
effect fn separatorOutput(buffer: &mut OutputBuffer, options: &JsonOptions, first: bool)
  -> () ! WriterError ? &mut Writer {
  if options.indent == usize.ZERO {
    if !first {
      run reserveOutput(&mut buffer, usize.ONE)
      pushOutput(&mut buffer, 44)
    }
    return ()
  }
  return run indentedSeparatorOutput(&mut buffer, options, first)
}

effect fn indentedSeparatorOutput(buffer: &mut OutputBuffer, options: &JsonOptions, first: bool)
  -> () ! WriterError ? &mut Writer {
  run flushOutput(&mut buffer)
  return run JsonOutput.separator(options, first)
}

effect fn lineOutput(buffer: &mut OutputBuffer, options: &JsonOptions) -> () ! WriterError ? &mut Writer {
  if options.indent == usize.ZERO { return () }
  run flushOutput(&mut buffer)
  return run JsonOutput.line(options)
}

effect fn colonOutput(buffer: &mut OutputBuffer, options: &JsonOptions) -> () ! WriterError ? &mut Writer {
  run reserveOutput(&mut buffer, 2)
  pushOutput(&mut buffer, 58)
  if options.indent != usize.ZERO { pushOutput(&mut buffer, 32) }
}

// The longest number text: 20 digits and a sign for an integer, 24 bytes for a float.
const NUMBER_ROOM: usize = 32

effect fn writeNode(document: &Value, options: &JsonOptions, buffer: &mut OutputBuffer)
  -> () ! JsonError | WriterError ? &mut Writer {
  return match &document.* {
    Value.Null => run literalOutput(&mut buffer, b"null")
    Value.Bool { value } => {
      if value { return run literalOutput(&mut buffer, b"true") }
      return run literalOutput(&mut buffer, b"false")
    }
    Value.Number { value } => {
      run reserveOutput(&mut buffer, NUMBER_ROOM)
      return match value {
        JsonNumber.Integer { value: integer } => {
          buffer.length = Format.writeI64Display(integer, &mut buffer.bytes, buffer.length)
        }
        JsonNumber.Unsigned { value: integer } => {
          buffer.length = Format.writeU64Display(integer, &mut buffer.bytes, buffer.length)
        }
        JsonNumber.Float { value: float } => {
          // `writeFloat` reports the error for a value that JSON cannot hold.
          if !f64.isFinite(float) {
            return run JsonOutput.writeFloat(float) |> Effect.provideMut<Writer>(&mut buffer)
          }
          buffer.length = Format.writeF64Debug(float, &mut buffer.bytes, buffer.length)
        }
      }
    }
    Value.String { text } => run stringOutput(&mut buffer, String.view(&text))
    Value.Array { values } => {
      let child = run JsonOptions.child(options)
      let items = List<Value>.asSlice(&values)
      run literalOutput(&mut buffer, b"[")
      let mut index = usize.ZERO
      while index < items.length {
        run separatorOutput(&mut buffer, &child, index == usize.ZERO)
        run writeNode(&items[index], &child, &mut buffer)
        index = index + usize.ONE
      }
      if items.length != usize.ZERO { run lineOutput(&mut buffer, options) }
      return run literalOutput(&mut buffer, b"]")
    }
    Value.Object { entries } => {
      let child = run JsonOptions.child(options)
      let members = List<JsonEntry>.asSlice(&entries)
      run literalOutput(&mut buffer, b"{")
      let mut index = usize.ZERO
      while index < members.length {
        run separatorOutput(&mut buffer, &child, index == usize.ZERO)
        run stringOutput(&mut buffer, String.view(&members[index].key))
        run colonOutput(&mut buffer, &child)
        run writeNode(&members[index].value, &child, &mut buffer)
        index = index + usize.ONE
      }
      if members.length != usize.ZERO { run lineOutput(&mut buffer, options) }
      return run literalOutput(&mut buffer, b"}")
    }
  }
}

fn inputError(reason: JsonReason, offset: usize) -> JsonError {
  return JsonError {
    reason: reason,
    offset: Option<usize>.some(offset),
    required: Option<usize>.none(),
    available: Option<usize>.none(),
  }
}
