//! Parse JSON into a tree of values, read fields from it, and write it back.
//!
//! # When to use
//! Use [`Json.parse`] when the shape of a document is not fixed, or when you need only a few fields
//! of a larger document. Read the fields with [`Json.field`], [`Json.fieldAt`], and the `as...`
//! functions. Use [`Json.deserialize`] or [`Json.decode`] to read a document straight into a typed
//! value, and [`Json.serialize`] to write a typed value. To read tokens without building a tree,
//! use `silk.json.scanner`.
//!
//! # Details
//! Parsing is strict (RFC 8259): no comments, no trailing commas, and no duplicate keys in an
//! object. Arrays and objects keep the order of the source. Numbers and string escapes are converted
//! when the document is parsed: an integer that fits in `i64` or `u64` stays exact, and any other
//! number becomes the nearest `f64`. If parsing fails, everything that was built is released.
//!
//! # Errors
//! - `JsonError` if the input is not valid JSON, has a duplicate key, has a number too large for a
//!   finite `f64`, nests deeper than `MAX_DEPTH` (64), or has content after the value. `offset` gives the position.
//! - `OutOfMemoryError` if the `Allocator` cannot supply the tree.
//! - `WriterError` from the write functions if the `Writer` fails.
//!
//! # Gotchas
//! A borrowed field or string cannot live longer than the [`Value`] that owns it. The write
//! functions do not flush the `Writer`.
//!
//! # Examples
//! ## Read fields from a document
//! ```silk
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.core.effect { Effect }
//! import silk.json.scanner { JsonError }
//! import silk.json.value { Json }
//! import silk.core.option { Option }
//!
//! pub effect fn main() -> i32
//!   ! JsonError | OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let document = run Json.parse(b"{\"id\":42,\"user\":{\"name\":\"Ada\"}}")
//!     |> Effect.provideMut<Allocator>(&mut allocator)
//!   let id = Json.field(&document, "id") |> Json.asI32 |> Option<i32>.unwrapOr(0)
//!   let name = Json.field(&document, "user") |> Json.fieldAt("name") |> Json.asString
//!     |> Option<string>.unwrapOr("")
//!   if id != 42 || name != "Ada" {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! ## Read a typed value directly
//! ```silk
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.core.effect { Effect }
//! import silk.json.scanner { JsonError }
//! import silk.json.value { Json }
//! import silk.collections.list { List }
//!
//! pub effect fn main() -> i32
//!   ! JsonError | OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let values = run Json.deserialize<List<i64>>(b"[1, 2, 39]")
//!     |> Effect.provideMut<Allocator>(&mut allocator)
//!   if List<i64>.length(&values) != 3 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Data formats

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f32
import silk.num.f64
import silk.text.format { Format, ParseError }
import silk.json.output { JsonOptions, JsonOutput }
import silk.json.scanner { JsonError, JsonReason, JsonScanner, JsonSyntax, JsonToken, MAX_DEPTH }
import silk.json.codec { Decode, Deserialize, JsonCodec, Serialize }
import silk.json.text { JsonText }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.text.string { String }
import silk.num.i64
import silk.num.u32
import silk.num.u64
import silk.num.u8
import silk.num.usize
import silk.collections.list { List }
import silk.collections.bytes { Bytes }
import silk.io.writer { Writer, WriterError }
import silk.core.effect { Effect }
import silk.collections.slice { Slice }
import silk.simd.simd
import silk.simd.mask16
import silk.simd.u8x16

/// One key and value of a JSON object.
pub struct JsonEntry {
  /// The key, with escapes decoded.
  pub key: String,
  /// The value.
  pub value: Value,
}

/// A JSON number, converted to the type that holds it exactly when there is one.
///
/// # Details
///
/// An integer written without a fraction or an exponent is `Integer` if it fits in `i64` and
/// `Unsigned` if it is larger but fits in `u64`. Any other number is `Float`, rounded to the nearest
/// `f64` with ties to even. `1.0` and `1e3` are floats.
///
/// # Gotchas
///
/// `Json.write` fails with `InvalidNumber` for a `Float` that is not finite.
pub union JsonNumber {
  /// An integer that fits in `i64`.
  Integer {
    /// The value.
    pub value: i64
  },
  /// An integer more than `i64.MAX` that fits in `u64`.
  Unsigned {
    /// The value.
    pub value: u64
  },
  /// A number with a fraction or an exponent, or an integer too large for `u64`.
  Float {
    /// The nearest `f64`.
    pub value: f64
  },
}

impl Copy for JsonNumber {}

/// One JSON value: null, a boolean, a number, a string, an array, or an object.
///
/// # Details
///
/// A `Value` owns all of its children. Use `match` to get the kind, or the `Json.as...` functions
/// to read a field of a known kind. Arrays and objects keep the order of the source. A number is
/// converted when the document is parsed, as a [`JsonNumber`].
///
/// # Gotchas
///
/// A borrowed field or string cannot live longer than the `Value` that owns it.
pub union Value {
  /// JSON `null`.
  Null,
  /// JSON `true` or `false`.
  Bool {
    /// The boolean value.
    pub value: bool
  },
  /// A JSON number.
  Number {
    /// The number, converted when the document was parsed.
    pub value: JsonNumber
  },
  /// A JSON string.
  String {
    /// The text, with escapes decoded.
    pub text: String
  },
  /// A JSON array.
  Array {
    /// The elements in source order.
    pub values: List<Value>
  },
  /// A JSON object.
  Object {
    /// The members in source order.
    pub entries: List<JsonEntry>
  },
}

/// The owner type of the JSON parse, write, and read operations. It has no fields and is never
/// constructed.
pub struct Json {}

impl Json {
  /// Parses `bytes` as one complete JSON document and returns its tree.
  ///
  /// # When to use
  ///
  /// Use it when the shape of a document is not fixed, or when you need only a few fields of a
  /// larger document. To read a typed value, use [`Json.deserialize`] or [`Json.decode`].
  ///
  /// # Details
  ///
  /// Parsing is strict (RFC 8259): no comments, no trailing commas, and no duplicate keys in an
  /// object. String escapes are decoded when the document is parsed.
  ///
  /// # Errors
  ///
  /// - `JsonError` if `bytes` is not one valid JSON value, if an object has a duplicate key, if the
  ///   nesting is deeper than 64, or if content follows the value. The partial tree is dropped.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the tree.
  pub effect fn parse(bytes: &[u8]) -> Value ! JsonError | OutOfMemoryError ? &mut Allocator {
    let mut cursor = TreeCursor { index: usize.ZERO, depth: usize.ZERO, failed: false }
    let mut scratch = Scratch { values: List<Value>.make(), entries: List<JsonEntry>.make() }
    let document = run treeValue(bytes, &mut cursor, &mut scratch)
    if !cursor.failed && JsonSyntax.skipWhitespace(bytes, cursor.index) == bytes.length {
      return move document
    }
    drop document
    return run parseScanned(bytes)
  }

  /// Reads `bytes` as one complete JSON document of type `T`. It does not allocate.
  ///
  /// # When to use
  ///
  /// Use it for types that implement `Decode`, such as numbers and `bool`. Use [`Json.deserialize`]
  /// for types that need memory, such as `String` and `List<T>`.
  ///
  /// # Errors
  ///
  /// - `JsonError` if the JSON is not valid, the value does not have type `T` (`TypeMismatch`), a
  ///   number does not fit (`NumberOutOfRange`), or content follows the value (`TrailingContent`).
  pub fn decode<T: Decode>(bytes: &[u8]) -> Result<T, JsonError> {
    let mut scanner = JsonScanner.make(bytes)
    let parsed = JsonCodec.decodeOne<T>(&mut scanner)
    return match move parsed {
      Result<T, JsonError>.Failure { error } => Result<T, JsonError>.failResult(move error)
      Result<T, JsonError>.Success { value } => match move JsonScanner.next(&mut scanner) {
        Result<JsonToken, JsonError>.Failure { error } => Result<T, JsonError>.failResult(move error)
        Result<JsonToken, JsonError>.Success { value: tail } => match move tail {
          JsonToken.EndOfInput => Result<T, JsonError>.succeed(move value)
          _ => Result<T, JsonError>.failResult(
            JsonError.at(JsonReason.TrailingContent, JsonScanner.offset(&scanner)))
        }
      }
    }
  }

  /// Reads `bytes` as one complete JSON document of type `T`.
  ///
  /// # Errors
  ///
  /// - `JsonError` if the JSON is not valid, the value does not have type `T`, or content follows
  ///   the value.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the value.
  pub effect fn deserialize<T: Deserialize>(bytes: &[u8])
    -> T ! JsonError | OutOfMemoryError ? &mut Allocator {
    let mut scanner = JsonScanner.make(bytes)
    let value = run JsonCodec.deserializeOne<T>(&mut scanner)
    let tail = run nextToken(&mut scanner)
    match move tail {
      JsonToken.EndOfInput => { return move value }
      _ => { fail JsonError.at(JsonReason.TrailingContent, JsonScanner.offset(&scanner)) }
    }
  }

  /// Writes `value` as JSON to the `Writer`, with `options`.
  ///
  /// # Errors
  ///
  /// - `JsonError` if the nesting is deeper than the limit in `options`, or a float is not finite.
  /// - `WriterError` if the `Writer` fails. Bytes that it accepted before the failure stay written.
  ///
  /// # Examples
  ///
  /// ## Write a struct
  /// ```silk
  /// import silk.core.effect { Effect }
  /// import silk.json.codec { Serialize }
  /// import silk.json.object { JsonObject }
  /// import silk.json.output { JsonOptions }
  /// import silk.json.scanner { JsonError }
  /// import silk.json.value { Json }
  /// import silk.io.writer { Writer, WriterError }
  ///
  /// struct CaptureWriter {
  ///   bytes: [u8; 64],
  ///   length: usize,
  /// }
  ///
  /// impl Writer for CaptureWriter {
  ///   effect fn writeAll(self: &mut Self, value: &[u8]) -> ()
  ///     ! WriterError
  ///     ? &mut Writer {
  ///     let mut index: usize = 0
  ///     while index < value.length {
  ///       self.bytes[self.length] = value[index]
  ///       self.length = self.length + 1
  ///       index = index + 1
  ///     }
  ///     return ()
  ///   }
  ///
  ///   effect fn flush(self: &mut Self) -> ()
  ///     ! WriterError
  ///     ? &mut Writer {
  ///     return ()
  ///   }
  /// }
  ///
  /// fn holds(writer: &CaptureWriter, expected: &[u8]) -> bool {
  ///   if writer.length != expected.length {
  ///     return false
  ///   }
  ///   let mut index: usize = 0
  ///   while index < expected.length {
  ///     if writer.bytes[index] != expected[index] {
  ///       return false
  ///     }
  ///     index = index + 1
  ///   }
  ///   return true
  /// }
  ///
  /// struct Point {
  ///   x: i32,
  ///   y: i32,
  /// }
  ///
  /// impl Serialize for Point {
  ///   effect fn serialize(self: &Self, options: &JsonOptions) -> ()
  ///     ! JsonError | WriterError
  ///     ? &mut Writer {
  ///     return run JsonObject.begin(options) |> JsonObject.field("x", &self.x)
  ///       |> JsonObject.field("y", &self.y)
  ///       |> JsonObject.end
  ///   }
  /// }
  ///
  /// pub effect fn main() -> i32
  ///   ! JsonError | WriterError {
  ///   let mut writer = CaptureWriter { bytes: [0; 64], length: 0 }
  ///   let point = Point { x: 3, y: -4 }
  ///   run Json.serialize(&point, &JsonOptions.compact()) |> Effect.provideMut<Writer>(&mut writer)
  ///   if !holds(&writer, b"{\"x\":3,\"y\":-4}") {
  ///     return 1
  ///   }
  ///   return 0
  /// }
  /// ```
  pub effect fn serialize<T: Serialize>(value: &T, options: &JsonOptions)
    -> () ! JsonError | WriterError ? &mut Writer {
    return run JsonCodec.writeOne<T>(value, options)
  }

  /// Writes `document` as compact JSON to the `Writer`. It does not flush the `Writer`.
  ///
  /// # Errors
  ///
  /// - `JsonError` if the nesting is deeper than 64.
  /// - `WriterError` if the `Writer` fails.
  ///
  /// # Gotchas
  ///
  /// The text goes to the `Writer` in pieces of up to 4 KiB. After a failure, the `Writer` holds
  /// only the pieces passed to it before the failure.
  pub effect fn write(document: &Value) -> () ! JsonError | WriterError ? &mut Writer {
    let options = JsonOptions.compact()
    return run Json.writeWith(document, &options)
  }

  /// Writes `document` as JSON to the `Writer`, with the indentation and depth limit of `options`.
  /// It does not flush the `Writer`.
  ///
  /// # Errors
  ///
  /// - `JsonError` if the nesting is deeper than the limit in `options`.
  /// - `WriterError` if the `Writer` fails.
  ///
  /// # Gotchas
  ///
  /// The text goes to the `Writer` in pieces of up to 4 KiB. After a failure, the `Writer` holds
  /// only the pieces passed to it before the failure.
  pub effect fn writeWith(document: &Value, options: &JsonOptions)
    -> () ! JsonError | WriterError ? &mut Writer {
    let mut buffer = OutputBuffer { bytes: [0; 4096], length: usize.ZERO }
    run writeNode(document, options, &mut buffer)
    return run flushOutput(&mut buffer)
  }

  /// Returns the value of member `key` of an object. Returns an absent option if `self` is not an
  /// object or has no such key.
  pub fn field<'a>(self: &'a Value, key: string) -> Option<&'a Value> {
    return match &self.* {
      Value.Object { entries } => findMember(&entries, key)
      _ => Option<&'a Value>.none()
    }
  }

  /// Returns the value of member `key` if `self` is a present object. Returns an absent option in
  /// other cases.
  ///
  /// # When to use
  ///
  /// Use it to read nested fields in a chain: `Json.field(&doc, "user") |> Json.fieldAt("name")`.
  pub fn fieldAt<'a>(self: Option<&'a Value>, key: string) -> Option<&'a Value> {
    return match move self {
      Option<&'a Value>.None => Option<&'a Value>.none()
      Option<&'a Value>.Some { value } => Json.field(value, key)
    }
  }

  /// Returns the number as `i32`. Returns an absent option if the value is absent, is not an
  /// integer (`1.0` and `1e3` are not), or does not fit in `i32`.
  pub fn asI32(self: Option<&Value>) -> Option<i32> {
    return match move Json.asI64(self) {
      Option<i64>.None => Option<i32>.none()
      Option<i64>.Some { value } => i64.checkedToI32(value)
    }
  }

  /// Returns the number as `i64`. Returns an absent option if the value is absent, is not an
  /// integer (`1.0` and `1e3` are not), or does not fit in `i64`.
  pub fn asI64(self: Option<&Value>) -> Option<i64> {
    return match move numberOf(self) {
      Option<JsonNumber>.Some { value } => match value {
        JsonNumber.Integer { value: integer } => Option<i64>.some(integer)
        _ => Option<i64>.none()
      }
      Option<JsonNumber>.None => Option<i64>.none()
    }
  }

  /// Returns the number as `u64`. Returns an absent option if the value is absent, is not an
  /// integer (`1.0` and `1e3` are not), or does not fit in `u64`.
  pub fn asU64(self: Option<&Value>) -> Option<u64> {
    return match move numberOf(self) {
      Option<JsonNumber>.Some { value } => match value {
        JsonNumber.Integer { value: integer } => i64.checkedToU64(integer)
        JsonNumber.Unsigned { value: integer } => Option<u64>.some(integer)
        _ => Option<u64>.none()
      }
      Option<JsonNumber>.None => Option<u64>.none()
    }
  }

  /// Returns the number as `f64`, rounded to the nearest value. Returns an absent option if the
  /// value is absent, is not a number, or is not finite.
  pub fn asF64(self: Option<&Value>) -> Option<f64> {
    return match move numberOf(self) {
      Option<JsonNumber>.Some { value } => match value {
        JsonNumber.Integer { value: integer } => Option<f64>.some(i64.toF64(integer))
        JsonNumber.Unsigned { value: integer } => Option<f64>.some(u64.toF64(integer))
        JsonNumber.Float { value: float } => {
          if !f64.isFinite(float) { return Option<f64>.none() }
          return Option<f64>.some(float)
        }
      }
      Option<JsonNumber>.None => Option<f64>.none()
    }
  }

  /// Returns the number as `f32`, rounded to the nearest value. Returns an absent option if the
  /// value is absent, is not a number, or is too large for a finite `f32`.
  ///
  /// # Gotchas
  ///
  /// A `Float` was already rounded to `f64` when the document was parsed, so it is rounded two
  /// times.
  pub fn asF32(self: Option<&Value>) -> Option<f32> {
    let converted = match move numberOf(self) {
      Option<JsonNumber>.Some { value } => match value {
        JsonNumber.Integer { value: integer } => i64.toF32(integer)
        JsonNumber.Unsigned { value: integer } => u64.toF32(integer)
        JsonNumber.Float { value: float } => f64.toF32(float)
      }
      Option<JsonNumber>.None => { return Option<f32>.none() }
    }
    if !f32.isFinite(converted) { return Option<f32>.none() }
    return Option<f32>.some(converted)
  }

  /// Returns the text of a string. Returns an absent option if the value is absent or is not a
  /// string. The text is borrowed from the tree.
  pub fn asString<'a>(self: Option<&'a Value>) -> Option<string<'a>> {
    return match move self {
      Option<&'a Value>.None => Option<string<'a>>.none()
      Option<&'a Value>.Some { value } => match &value.* {
        Value.String { text } => Option<string<'a>>.some(String.view(&text))
        _ => Option<string<'a>>.none()
      }
    }
  }
}

impl Serialize for Value {
  effect fn serialize(self: &Self, options: &JsonOptions)
    -> () ! JsonError | WriterError ? &mut Writer {
    return run Json.writeWith(self, options)
  }
}

impl Deserialize for Value {
  effect fn deserialize(scanner: &mut JsonScanner)
    -> Self ! JsonError | OutOfMemoryError ? &mut Allocator {
    let first = run nextToken(&mut scanner.*)
    let end = JsonScanner.length(&scanner.*)
    let mut scratch = Scratch { values: List<Value>.make(), entries: List<JsonEntry>.make() }
    return run parseValue(&mut scanner.*, &mut scratch, first, end)
  }
}


// Parses `bytes` token by token with `JsonScanner`, which checks the grammar and reports the first
// error where it is. `Json.parse` uses it only for documents that its own parser rejects.
effect fn parseScanned(bytes: &[u8]) -> Value ! JsonError | OutOfMemoryError ? &mut Allocator {
  let mut scanner = JsonScanner.make(bytes)
  let mut scratch = Scratch { values: List<Value>.make(), entries: List<JsonEntry>.make() }
  let first = run nextToken(&mut scanner)
  let document = run parseValue(&mut scanner, &mut scratch, first, bytes.length)
  let tail = run nextToken(&mut scanner)
  match move tail {
    JsonToken.EndOfInput => { return move document }
    _ => { fail inputError(JsonReason.TrailingContent, bytes.length) }
  }
}

fn numberOf(value: Option<&Value>) -> Option<JsonNumber> {
  return match move value {
    Option<&Value>.Some { value: present } => match &present.* {
      Value.Number { value: number } => Option<JsonNumber>.some(number)
      _ => Option<JsonNumber>.none()
    }
    Option<&Value>.None => Option<JsonNumber>.none()
  }
}

// Converts the text of a number token, which the scanner checked. `offset` is its position.
effect fn convertNumber(raw: &[u8], offset: usize) -> JsonNumber ! JsonError {
  let mut index = usize.ZERO
  let negative = raw[0] == 45
  if negative { index = usize.ONE }
  let digits = index
  let mut magnitude: u64 = 0
  // Nineteen digits always fit in `u64`.
  while index < raw.length && index - digits < 19 {
    let byte = raw[index]
    if byte < 48 || byte > 57 { break }
    magnitude = magnitude * 10 + u8.toU64(byte - 48)
    index = index + usize.ONE
  }
  if index == raw.length {
    if !negative {
      if magnitude <= 9223372036854775807 {
        return JsonNumber.Integer { value: u64.toI64(magnitude) }
      }
      return JsonNumber.Unsigned { value: magnitude }
    }
    // `-0` keeps its sign, which only a float can hold.
    if magnitude == 0 { return JsonNumber.Float { value: -0.0 } }
    if magnitude <= 9223372036854775807 {
      return JsonNumber.Integer { value: 0 - u64.toI64(magnitude) }
    }
    if magnitude == 9223372036854775808 { return JsonNumber.Integer { value: i64.MIN } }
  }
  // The scanner accepts only ASCII bytes in a number token.
  let text = unsafe Intrinsic.stringFromUtf8Unchecked(raw)
  if index < raw.length && raw[index] >= 48 && raw[index] <= 57 && isInteger(raw, index) {
    if !negative {
      if let Result<u64, ParseError>.Success { value } = Format.u64Value(text) {
        return JsonNumber.Unsigned { value: value }
      }
    }
  }
  return match move Format.f64Value(text) {
    Result<f64, ParseError>.Success { value } => {
      if !f64.isFinite(value) { fail inputError(JsonReason.NumberOutOfRange, offset) }
      return JsonNumber.Float { value: value }
    }
    Result<f64, ParseError>.Failure {..} => { fail inputError(JsonReason.InvalidNumber, offset) }
  }
}

// `true` if the bytes of `raw` from `from` are all digits.
fn isInteger(raw: &[u8], from: usize) -> bool {
  let mut index = from
  while index < raw.length {
    if raw[index] < 48 || raw[index] > 57 { return false }
    index = index + usize.ONE
  }
  return true
}

fn findMember<'a>(entries: &'a List<JsonEntry>, key: string) -> Option<&'a Value> {
  let members = List<JsonEntry>.asSlice(entries)
  let mut index = usize.ZERO
  while index < members.length {
    if String.view(&members[index].key) == key { return Option<&'a Value>.some(&members[index].value) }
    index = index + usize.ONE
  }
  return Option<&'a Value>.none()
}

effect fn nextToken(scanner: &mut JsonScanner) -> JsonToken ! JsonError {
  return match move JsonScanner.next(&mut scanner.*) {
    Result<JsonToken, JsonError>.Success { value } => move value
    Result<JsonToken, JsonError>.Failure { error } => { fail move error }
  }
}

// The elements and members of the arrays and objects that are open. A container keeps its children
// at the end of these lists until it closes, and then moves them into a list of exactly their size.
struct Scratch {
  values: List<Value>,
  entries: List<JsonEntry>,
}

effect fn parseValue(scanner: &mut JsonScanner, scratch: &mut Scratch, token: JsonToken, end: usize)
  -> Value ! JsonError | OutOfMemoryError ? &mut Allocator {
  return match move token {
    JsonToken.Null => Value.Null
    JsonToken.True => Value.Bool { value: true }
    JsonToken.False => Value.Bool { value: false }
    JsonToken.Number { span } => {
      let offset = span.offset
      return Value.Number { value: run convertNumber(JsonScanner.slice(&scanner.*, move span), offset) }
    }
    JsonToken.String { span, escaped } => {
      let offset = span.offset
      let decoded = run JsonText.decode(JsonScanner.slice(&scanner.*, move span), offset, escaped)
      return Value.String { text: unsafe String.fromBytesUnchecked(move decoded) }
    }
    JsonToken.ArrayBegin => run parseArray(&mut scanner.*, &mut scratch.*, end)
    JsonToken.ObjectBegin => run parseObject(&mut scanner.*, &mut scratch.*, end)
    _ => { fail inputError(JsonReason.UnexpectedByte, end) }
  }
}

effect fn parseArray(scanner: &mut JsonScanner, scratch: &mut Scratch, end: usize)
  -> Value ! JsonError | OutOfMemoryError ? &mut Allocator {
  let mark = List<Value>.length(&scratch.values)
  let mut token = run nextToken(&mut scanner.*)
  match token {
    JsonToken.ArrayEnd => { return Value.Array { values: List<Value>.make() } }
    _ => {}
  }
  while true {
    let value = run parseValue(&mut scanner.*, &mut scratch.*, token, end)
    run List<Value>.append(&mut scratch.values, move value)
    let separator = run nextToken(&mut scanner.*)
    match move separator {
      JsonToken.ArrayEnd => {
        return Value.Array { values: run List<Value>.splitOff(&mut scratch.values, mark) }
      }
      JsonToken.ValueSeparator => {}
      _ => { fail inputError(JsonReason.UnexpectedByte, end) }
    }
    token = run nextToken(&mut scanner.*)
  }
  fail inputError(JsonReason.UnexpectedEnd, end)
}

effect fn parseObject(scanner: &mut JsonScanner, scratch: &mut Scratch, end: usize)
  -> Value ! JsonError | OutOfMemoryError ? &mut Allocator {
  let mark = List<JsonEntry>.length(&scratch.entries)
  let mut token = run nextToken(&mut scanner.*)
  match token {
    JsonToken.ObjectEnd => { return Value.Object { entries: List<JsonEntry>.make() } }
    _ => {}
  }
  while true {
    let key = match move token {
      JsonToken.String { span, escaped } => {
        let offset = span.offset
        let raw = JsonScanner.slice(&scanner.*, move span)
        let decoded = run JsonText.decode(raw, offset, escaped)
        let text = unsafe String.fromBytesUnchecked(move decoded)
        if containsKey(&scratch.entries, mark, String.view(&text)) {
          fail inputError(JsonReason.DuplicateKey, offset)
        }
        move text
      }
      _ => { fail inputError(JsonReason.UnexpectedByte, end) }
    }
    let colon = run nextToken(&mut scanner.*)
    match colon {
      JsonToken.KeySeparator => {}
      _ => { fail inputError(JsonReason.UnexpectedByte, end) }
    }
    let valueToken = run nextToken(&mut scanner.*)
    let value = run parseValue(&mut scanner.*, &mut scratch.*, valueToken, end)
    run List<JsonEntry>.append(&mut scratch.entries, JsonEntry { key: move key, value: move value })
    let separator = run nextToken(&mut scanner.*)
    match move separator {
      JsonToken.ObjectEnd => {
        return Value.Object { entries: run List<JsonEntry>.splitOff(&mut scratch.entries, mark) }
      }
      JsonToken.ValueSeparator => {}
      _ => { fail inputError(JsonReason.UnexpectedByte, end) }
    }
    token = run nextToken(&mut scanner.*)
  }
  fail inputError(JsonReason.UnexpectedEnd, end)
}

// `true` if a member from index `from` of `entries` has the key `key`.
fn containsKey(entries: &List<JsonEntry>, from: usize, key: string) -> bool {
  let members = List<JsonEntry>.asSlice(entries)
  let mut index = from
  while index < members.length {
    if String.view(&members[index].key) == key { return true }
    index = index + usize.ONE
  }
  return false
}

// Where the tree parser of `Json.parse` is in the document. `failed` is set when the parser finds
// anything that is not valid JSON, and the parser then returns at once without a useful value.
struct TreeCursor {
  index: usize,
  depth: usize,
  failed: bool,
}

// `true` if the bytes of `bytes` at `at` are `word`.
fn wordAt(bytes: &[u8], at: usize, word: &[u8]) -> bool {
  if bytes.length - at < word.length { return false }
  let mut index = usize.ZERO
  while index < word.length {
    if bytes[at + index] != word[index] { return false }
    index = index + usize.ONE
  }
  return true
}

// Parses the value that starts after whitespace at `cursor.index`, and moves `cursor.index` after it.
effect fn treeValue(bytes: &[u8], cursor: &mut TreeCursor, scratch: &mut Scratch)
  -> Value ! JsonError | OutOfMemoryError ? &mut Allocator {
  run treeItem(bytes, &mut cursor.*, &mut scratch.*)
  if cursor.failed { return Value.Null }
  return match List<Value>.pop(&mut scratch.values) {
    Option<Value>.Some { value } => move value
    Option<Value>.None => Value.Null
  }
}

// Parses the value that starts after whitespace at `cursor.index` onto the end of `scratch.values`,
// and moves `cursor.index` after it. Each kind of value is built in its place in the list, so
// nothing reads it back through a copy just after it is written. `treeMember` has the same cases.
effect fn treeItem(bytes: &[u8], cursor: &mut TreeCursor, scratch: &mut Scratch)
  -> () ! JsonError | OutOfMemoryError ? &mut Allocator {
  let at = JsonSyntax.skipWhitespace(bytes, cursor.index)
  if at >= bytes.length { return markFailed(&mut cursor.*) }
  let byte = bytes[at]
  if byte == 34 {
    let text = run treeString(bytes, &mut cursor.*, at)
    if cursor.failed { return () }
    return run List<Value>.append(&mut scratch.values, Value.String { text: move text })
  }
  if byte == 45 || (byte >= 48 && byte <= 57) {
    let number = run treeNumber(bytes, &mut cursor.*, at)
    if cursor.failed { return () }
    return run List<Value>.append(&mut scratch.values, Value.Number { value: number })
  }
  if byte == 91 {
    let values = run treeArray(bytes, &mut cursor.*, &mut scratch.*, at + usize.ONE)
    if cursor.failed { return () }
    return run List<Value>.append(&mut scratch.values, Value.Array { values: move values })
  }
  if byte == 123 {
    let entries = run treeObject(bytes, &mut cursor.*, &mut scratch.*, at + usize.ONE)
    if cursor.failed { return () }
    return run List<Value>.append(&mut scratch.values, Value.Object { entries: move entries })
  }
  if byte == 116 && wordAt(bytes, at, b"true") {
    cursor.index = at + 4
    return run List<Value>.append(&mut scratch.values, Value.Bool { value: true })
  }
  if byte == 102 && wordAt(bytes, at, b"false") {
    cursor.index = at + 5
    return run List<Value>.append(&mut scratch.values, Value.Bool { value: false })
  }
  if byte == 110 && wordAt(bytes, at, b"null") {
    cursor.index = at + 4
    return run List<Value>.append(&mut scratch.values, Value.Null)
  }
  return markFailed(&mut cursor.*)
}

// Parses the value at `at`, after whitespace, as the member `key` onto the end of
// `scratch.entries`, and moves `cursor.index` after it. The cases are those of `treeItem`.
effect fn treeMember(bytes: &[u8], cursor: &mut TreeCursor, scratch: &mut Scratch, at: usize, key: String)
  -> () ! JsonError | OutOfMemoryError ? &mut Allocator {
  let byte = bytes[at]
  if byte == 34 {
    let text = run treeString(bytes, &mut cursor.*, at)
    if cursor.failed { return () }
    return run List<JsonEntry>.append(&mut scratch.entries,
      JsonEntry { key: move key, value: Value.String { text: move text } })
  }
  if byte == 45 || (byte >= 48 && byte <= 57) {
    let number = run treeNumber(bytes, &mut cursor.*, at)
    if cursor.failed { return () }
    return run List<JsonEntry>.append(&mut scratch.entries,
      JsonEntry { key: move key, value: Value.Number { value: number } })
  }
  if byte == 91 {
    let values = run treeArray(bytes, &mut cursor.*, &mut scratch.*, at + usize.ONE)
    if cursor.failed { return () }
    return run List<JsonEntry>.append(&mut scratch.entries,
      JsonEntry { key: move key, value: Value.Array { values: move values } })
  }
  if byte == 123 {
    let entries = run treeObject(bytes, &mut cursor.*, &mut scratch.*, at + usize.ONE)
    if cursor.failed { return () }
    return run List<JsonEntry>.append(&mut scratch.entries,
      JsonEntry { key: move key, value: Value.Object { entries: move entries } })
  }
  if byte == 116 && wordAt(bytes, at, b"true") {
    cursor.index = at + 4
    return run List<JsonEntry>.append(&mut scratch.entries, JsonEntry { key: move key, value: Value.Bool { value: true } })
  }
  if byte == 102 && wordAt(bytes, at, b"false") {
    cursor.index = at + 5
    return run List<JsonEntry>.append(&mut scratch.entries, JsonEntry { key: move key, value: Value.Bool { value: false } })
  }
  if byte == 110 && wordAt(bytes, at, b"null") {
    cursor.index = at + 4
    return run List<JsonEntry>.append(&mut scratch.entries, JsonEntry { key: move key, value: Value.Null })
  }
  return markFailed(&mut cursor.*)
}

// The decoded string whose quote is at `at`, with `cursor.index` moved after it. Sets
// `cursor.failed` instead when the string does not end, and the result is then empty.
@inlineAlways
effect fn treeString(bytes: &[u8], cursor: &mut TreeCursor, at: usize)
  -> String ! JsonError | OutOfMemoryError ? &mut Allocator {
  let mut escaped = false
  let after = JsonSyntax.stringEnd(bytes, at + usize.ONE, &mut escaped)
  if after == usize.ZERO {
    markFailed(&mut cursor.*)
    return String.make()
  }
  cursor.index = after
  let decoded = run JsonText.decode(Slice.view<u8>(bytes, at, after - at), at, escaped)
  return unsafe String.fromBytesUnchecked(move decoded)
}

fn markFailed(cursor: &mut TreeCursor) -> () {
  cursor.failed = true
}

// Appends the decimal digits from `at` on to `significand`, wrapping past 20 digits, and returns
// the index after them. Reads 8 bytes at a time: the digits before the first other byte are
// converted as one word.
@inlineAlways
fn digitRun(bytes: &[u8], at: usize, significand: &mut u64) -> usize {
  let mut index = at
  while index + 8 <= bytes.length {
    let lanes = Slice.view<u8>(bytes, index, 8)
    let mut word: u64 = 0
    let mut lane = usize.ZERO
    while lane < 8 {
      word = u64.bitOr(word, u64.shiftLeft(u8.toU64(lanes[lane]), usize.toU64(lane * 8)))
      lane = lane + usize.ONE
    }
    // A byte is a digit when its high nibble is 3 and adding 6 keeps it there. A carry out of a
    // byte that is not a digit only reaches the bytes after it.
    let high = u64.bitXor(u64.bitAnd(word, 0xF0F0F0F0F0F0F0F0), 0x3030303030303030)
    let carried = u64.bitXor(u64.bitAnd(u64.wrappingAdd(word, 0x0606060606060606), 0xF0F0F0F0F0F0F0F0),
      0x3030303030303030)
    let stops = u64.bitOr(high, carried)
    if stops == 0 {
      significand.* = u64.wrappingAdd(u64.wrappingMultiply(significand.*, 100000000), eightDigitValue(word))
      index = index + 8
    } else {
      let count = u64.toUsize(u64.shiftRight(u32.toU64(u64.trailingZeros(stops)), 3))
      if count != usize.ZERO {
        // Moving the digits to the top of the word and filling below with zero digits.
        let shift = usize.toU64(64 - count * 8)
        let aligned = u64.bitOr(u64.shiftLeft(word, shift), u64.shiftRight(0x3030303030303030, 64 - shift))
        significand.* = u64.wrappingAdd(u64.wrappingMultiply(significand.*, SMALL_POWERS_OF_TEN[count]),
          eightDigitValue(aligned))
      }
      return index + count
    }
  }
  while index < bytes.length {
    let digit = u8.wrappingSubtract(bytes[index], 48)
    if digit > 9 { break }
    significand.* = u64.wrappingAdd(u64.wrappingMultiply(significand.*, 10), u8.toU64(digit))
    index = index + usize.ONE
  }
  return index
}

const SMALL_POWERS_OF_TEN: [u64; 8] = [1, 10, 100, 1000, 10000, 100000, 1000000, 10000000]

// The value of the 8 ASCII digits of `word`, the first digit in the lowest byte. Pairs, then
// quads, then the whole are combined with multiplies; no lane overflows into the next.
@inlineAlways
fn eightDigitValue(word: u64) -> u64 {
  let digits = u64.wrappingSubtract(word, 0x3030303030303030)
  let pairs = u64.wrappingAdd(u64.wrappingMultiply(digits, 10), u64.shiftRight(digits, 8))
  let low = u64.wrappingMultiply(u64.bitAnd(pairs, 0x000000FF000000FF), 4294967296000100)
  let high = u64.wrappingMultiply(u64.bitAnd(u64.shiftRight(pairs, 16), 0x000000FF000000FF), 42949672960001)
  return u64.shiftRight(u64.wrappingAdd(low, high), 32)
}

// The number at `at`, with `cursor.index` moved after it. Sets `cursor.failed` instead when it is
// not valid, and the result is then any number.
@inlineAlways
effect fn treeNumber(bytes: &[u8], cursor: &mut TreeCursor, at: usize) -> JsonNumber ! JsonError {
  let mut index = at
  let negative = bytes[index] == 45
  if negative { index = index + usize.ONE }
  let digitsStart = index
  let mut significand: u64 = 0
  if index < bytes.length && bytes[index] == 48 {
    index = index + usize.ONE
  } else {
    index = digitRun(bytes, index, &mut significand)
    if index == digitsStart { return numberFailed(&mut cursor.*) }
  }
  let mut digitCount = index - digitsStart
  let mut fractionCount = usize.ZERO
  let mut float = false
  if index < bytes.length && bytes[index] == 46 {
    index = index + usize.ONE
    let fractionStart = index
    index = digitRun(bytes, index, &mut significand)
    fractionCount = index - fractionStart
    if fractionCount == usize.ZERO { return numberFailed(&mut cursor.*) }
    digitCount = digitCount + fractionCount
    float = true
  }
  let mut exponent: i64 = 0
  if index < bytes.length && (bytes[index] == 101 || bytes[index] == 69) {
    index = index + usize.ONE
    let mut exponentNegative = false
    if index < bytes.length && (bytes[index] == 43 || bytes[index] == 45) {
      exponentNegative = bytes[index] == 45
      index = index + usize.ONE
    }
    let exponentStart = index
    while index < bytes.length {
      let digit = u8.wrappingSubtract(bytes[index], 48)
      if digit > 9 { break }
      // Any larger exponent is far outside `f64` already, and the cap keeps it from overflowing.
      if exponent < 1000000000000 { exponent = exponent * 10 + u8.toI64(digit) }
      index = index + usize.ONE
    }
    if index == exponentStart { return numberFailed(&mut cursor.*) }
    if exponentNegative { exponent = -exponent }
    float = true
  }
  cursor.index = index
  if digitCount > 19 {
    // The scanner checks what follows the number before it converts it, so the errors match.
    if JsonSyntax.numberEnd(bytes, at) != index { return numberFailed(&mut cursor.*) }
    return run convertNumber(Slice.view<u8>(bytes, at, index - at), at)
  }
  if !float {
    if !negative {
      if significand <= 9223372036854775807 {
        return JsonNumber.Integer { value: u64.toI64(significand) }
      }
      return JsonNumber.Unsigned { value: significand }
    }
    if significand != 0 && significand <= 9223372036854775807 {
      return JsonNumber.Integer { value: 0 - u64.toI64(significand) }
    }
    if significand == 9223372036854775808 {
      return JsonNumber.Integer { value: i64.MIN }
    }
  }
  let mut value = Format.f64FromDecimal(significand, exponent - usize.toI64(fractionCount))
  // The scanner path reports the error, after it checks what follows the number.
  if !f64.isFinite(value) { return numberFailed(&mut cursor.*) }
  if negative { value = -value }
  return JsonNumber.Float { value: value }
}

fn numberFailed(cursor: &mut TreeCursor) -> JsonNumber {
  cursor.failed = true
  return JsonNumber.Integer { value: 0 }
}

// Parses the rest of the array whose `[` is before `start` and returns its elements. Sets
// `cursor.failed` instead when it is not valid, and the result is then empty.
effect fn treeArray(bytes: &[u8], cursor: &mut TreeCursor, scratch: &mut Scratch, start: usize)
  -> List<Value> ! JsonError | OutOfMemoryError ? &mut Allocator {
  if cursor.depth == MAX_DEPTH { return failedList<Value>(&mut cursor.*) }
  let mut at = JsonSyntax.skipWhitespace(bytes, start)
  if at < bytes.length && bytes[at] == 93 {
    cursor.index = at + usize.ONE
    return List<Value>.make()
  }
  cursor.depth = cursor.depth + usize.ONE
  cursor.index = at
  let mark = List<Value>.length(&scratch.values)
  while true {
    run treeItem(bytes, &mut cursor.*, &mut scratch.*)
    if cursor.failed { return List<Value>.make() }
    at = JsonSyntax.skipWhitespace(bytes, cursor.index)
    if at >= bytes.length { break }
    let byte = bytes[at]
    cursor.index = at + usize.ONE
    if byte == 93 {
      cursor.depth = cursor.depth - usize.ONE
      return run List<Value>.splitOff(&mut scratch.values, mark)
    }
    if byte != 44 { break }
  }
  return failedList<Value>(&mut cursor.*)
}

// Parses the rest of the object whose `{` is before `start` and returns its members. Sets
// `cursor.failed` instead when it is not valid, and the result is then empty.
effect fn treeObject(bytes: &[u8], cursor: &mut TreeCursor, scratch: &mut Scratch, start: usize)
  -> List<JsonEntry> ! JsonError | OutOfMemoryError ? &mut Allocator {
  if cursor.depth == MAX_DEPTH { return failedList<JsonEntry>(&mut cursor.*) }
  let mut at = JsonSyntax.skipWhitespace(bytes, start)
  if at < bytes.length && bytes[at] == 125 {
    cursor.index = at + usize.ONE
    return List<JsonEntry>.make()
  }
  cursor.depth = cursor.depth + usize.ONE
  let mark = List<JsonEntry>.length(&scratch.entries)
  while true {
    if at >= bytes.length || bytes[at] != 34 { break }
    let mut escaped = false
    let after = JsonSyntax.stringEnd(bytes, at + usize.ONE, &mut escaped)
    if after == usize.ZERO { break }
    let decoded = run JsonText.decode(Slice.view<u8>(bytes, at, after - at), at, escaped)
    let key = unsafe String.fromBytesUnchecked(move decoded)
    if containsKey(&scratch.entries, mark, String.view(&key)) { break }
    at = JsonSyntax.skipWhitespace(bytes, after)
    if at >= bytes.length || bytes[at] != 58 { break }
    at = JsonSyntax.skipWhitespace(bytes, at + usize.ONE)
    if at >= bytes.length { break }
    run treeMember(bytes, &mut cursor.*, &mut scratch.*, at, move key)
    if cursor.failed { return List<JsonEntry>.make() }
    at = JsonSyntax.skipWhitespace(bytes, cursor.index)
    if at >= bytes.length { break }
    let byte = bytes[at]
    cursor.index = at + usize.ONE
    if byte == 125 {
      cursor.depth = cursor.depth - usize.ONE
      return run List<JsonEntry>.splitOff(&mut scratch.entries, mark)
    }
    if byte != 44 { break }
    at = JsonSyntax.skipWhitespace(bytes, cursor.index)
  }
  return failedList<JsonEntry>(&mut cursor.*)
}

fn failedList<T>(cursor: &mut TreeCursor) -> List<T> {
  cursor.failed = true
  return List<T>.make()
}

// The writer collects output here and passes it to the ambient `Writer` in large pieces, so that
// each comma, bracket, and number costs a copy instead of a `Writer` call.
struct OutputBuffer {
  bytes: [u8; 4096],
  length: usize,
}

const OUTPUT_CAPACITY: usize = 4096

effect fn outputWrite(self: &mut OutputBuffer, values: &[u8]) -> () ! WriterError {
  if values.length > OUTPUT_CAPACITY - self.length { fail Writer.failure() }
  Slice.copyInto<u8>(&mut self.bytes, self.length, values)
  self.length = self.length + values.length
}

effect fn outputFlush(self: &mut OutputBuffer) -> () ! WriterError { return () }

impl Writer for OutputBuffer {
  writeAll: OutputBuffer.outputWrite
  flush: OutputBuffer.outputFlush
}

effect fn flushOutput(buffer: &mut OutputBuffer) -> () ! WriterError ? &mut Writer {
  if buffer.length == usize.ZERO { return () }
  run Writer.writeAll(Slice.view<u8>(&buffer.bytes, usize.ZERO, buffer.length))
  buffer.length = usize.ZERO
}

// Makes room for `size` more bytes, which is at most `OUTPUT_CAPACITY`.
@inlineAlways
effect fn reserveOutput(buffer: &mut OutputBuffer, size: usize) -> () ! WriterError ? &mut Writer {
  if size > OUTPUT_CAPACITY - buffer.length { run flushOutput(&mut buffer) }
}

// Appends one byte that `reserveOutput` made room for.
@inlineAlways
fn pushOutput(buffer: &mut OutputBuffer, byte: u8) -> () {
  buffer.bytes[buffer.length] = byte
  buffer.length = buffer.length + usize.ONE
}

@inlineAlways
effect fn literalOutput(buffer: &mut OutputBuffer, text: &[u8]) -> () ! WriterError ? &mut Writer {
  run reserveOutput(&mut buffer, text.length)
  Slice.copyInto<u8>(&mut buffer.bytes, buffer.length, text)
  buffer.length = buffer.length + text.length
}

// An escaped byte takes at most 6 bytes, so a string of up to this many bytes always fits in an
// empty buffer with its quotes.
const BUFFERED_STRING_LIMIT: usize = 680

effect fn stringOutput(buffer: &mut OutputBuffer, text: string) -> () ! WriterError ? &mut Writer {
  let size = String.byteLength(text)
  if size > BUFFERED_STRING_LIMIT {
    run flushOutput(&mut buffer)
    return run JsonOutput.writeString(text)
  }
  run reserveOutput(&mut buffer, size * 6 + 2)
  if plainStringOutput(&mut buffer, String.utf8Bytes(text)) { return () }
  return run JsonOutput.writeString(text) |> Effect.provideMut<Writer>(&mut buffer)
}

// Appends `bytes` in quotes if none of them needs an escape, and returns `true`. Otherwise
// appends nothing and returns `false`. `reserveOutput` made room for the text.
@inlineAlways
fn plainStringOutput(buffer: &mut OutputBuffer, bytes: &[u8]) -> bool {
  let start = buffer.length
  pushOutput(&mut buffer, 34)
  let mut index = usize.ZERO
  static if simd.hardware() {
    let quote = u8x16.splat(34)
    let backslash = u8x16.splat(92)
    let space = u8x16.splat(32)
    // Each block of 16 is stored whole. When it holds a byte to escape, the bytes after that
    // byte are written over or left past the end of the output.
    while index + 16 <= bytes.length {
      let lanes = u8x16.load(bytes, index)
      u8x16.store(&mut buffer.bytes, buffer.length, lanes)
      let stops = u8x16.lanesEqual(lanes, quote) | u8x16.lanesEqual(lanes, backslash) |
        u8x16.lanesLess(lanes, space)
      if mask16.any(stops) {
        buffer.length = start
        return false
      }
      buffer.length = buffer.length + 16
      index = index + 16
    }
  }
  // The rest 8 bytes at a time, then one at a time, counting in a local so that the length is
  // stored once.
  let mut out = buffer.length
  while index + 8 <= bytes.length {
    let word = wordAt8(bytes, index)
    if plainWordStops(word) {
      buffer.length = start
      return false
    }
    Slice.copyInto<u8>(&mut buffer.bytes, out, Slice.view<u8>(bytes, index, 8))
    out = out + 8
    index = index + 8
  }
  while index < bytes.length {
    let byte = bytes[index]
    if byte == 34 || byte == 92 || byte < 32 {
      buffer.length = start
      return false
    }
    buffer.bytes[out] = byte
    out = out + usize.ONE
    index = index + usize.ONE
  }
  buffer.bytes[out] = 34
  buffer.length = out + usize.ONE
  return true
}

// `true` if one of the 8 bytes of `word` is `"`, `\` or a control byte. Bytes from 128 up count as
// plain, since only the bytes below 128 that are flagged set the high bit of their lane.
@inlineAlways
fn plainWordStops(word: u64) -> bool {
  let ones: u64 = 0x0101010101010101
  let highs: u64 = 0x8080808080808080
  let below = u64.bitAnd(u64.wrappingSubtract(word, u64.wrappingMultiply(ones, 32)), u64.bitNot(word))
  let quote = u64.bitXor(word, u64.wrappingMultiply(ones, 34))
  let quotes = u64.bitAnd(u64.wrappingSubtract(quote, ones), u64.bitNot(quote))
  let slash = u64.bitXor(word, u64.wrappingMultiply(ones, 92))
  let slashes = u64.bitAnd(u64.wrappingSubtract(slash, ones), u64.bitNot(slash))
  return u64.bitAnd(u64.bitOr(below, u64.bitOr(quotes, slashes)), highs) != 0
}

// The 8 bytes at `at` as a little-endian word.
@inlineAlways
fn wordAt8(bytes: &[u8], at: usize) -> u64 {
  let lanes = Slice.view<u8>(bytes, at, 8)
  let mut word: u64 = 0
  let mut lane = usize.ZERO
  while lane < 8 {
    word = u64.bitOr(word, u64.shiftLeft(u8.toU64(lanes[lane]), usize.toU64(lane * 8)))
    lane = lane + usize.ONE
  }
  return word
}


// Compact output, the common case, stays inline in the loops of `writeNode`.
@inlineAlways
effect fn separatorOutput(buffer: &mut OutputBuffer, options: &JsonOptions, first: bool)
  -> () ! WriterError ? &mut Writer {
  if options.indent == usize.ZERO {
    if !first {
      run reserveOutput(&mut buffer, usize.ONE)
      pushOutput(&mut buffer, 44)
    }
    return ()
  }
  return run indentedSeparatorOutput(&mut buffer, options, first)
}

effect fn indentedSeparatorOutput(buffer: &mut OutputBuffer, options: &JsonOptions, first: bool)
  -> () ! WriterError ? &mut Writer {
  run flushOutput(&mut buffer)
  return run JsonOutput.separator(options, first)
}

effect fn lineOutput(buffer: &mut OutputBuffer, options: &JsonOptions) -> () ! WriterError ? &mut Writer {
  if options.indent == usize.ZERO { return () }
  run flushOutput(&mut buffer)
  return run JsonOutput.line(options)
}

effect fn colonOutput(buffer: &mut OutputBuffer, options: &JsonOptions) -> () ! WriterError ? &mut Writer {
  run reserveOutput(&mut buffer, 2)
  pushOutput(&mut buffer, 58)
  if options.indent != usize.ZERO { pushOutput(&mut buffer, 32) }
}

// The longest number text: 20 digits and a sign for an integer, 24 bytes for a float.
const NUMBER_ROOM: usize = 32

effect fn writeNode(document: &Value, options: &JsonOptions, buffer: &mut OutputBuffer)
  -> () ! JsonError | WriterError ? &mut Writer {
  return match &document.* {
    Value.Null => run literalOutput(&mut buffer, b"null")
    Value.Bool { value } => {
      if value { return run literalOutput(&mut buffer, b"true") }
      return run literalOutput(&mut buffer, b"false")
    }
    Value.Number { value } => {
      run reserveOutput(&mut buffer, NUMBER_ROOM)
      return match value {
        JsonNumber.Integer { value: integer } => {
          buffer.length = Format.writeI64Display(integer, &mut buffer.bytes, buffer.length)
        }
        JsonNumber.Unsigned { value: integer } => {
          buffer.length = Format.writeU64Display(integer, &mut buffer.bytes, buffer.length)
        }
        JsonNumber.Float { value: float } => {
          // `writeFloat` reports the error for a value that JSON cannot hold.
          if !f64.isFinite(float) {
            return run JsonOutput.writeFloat(float) |> Effect.provideMut<Writer>(&mut buffer)
          }
          buffer.length = Format.writeF64Debug(float, &mut buffer.bytes, buffer.length)
        }
      }
    }
    Value.String { text } => run stringOutput(&mut buffer, String.view(&text))
    Value.Array { values } => {
      let child = run JsonOptions.child(options)
      let items = List<Value>.asSlice(&values)
      run literalOutput(&mut buffer, b"[")
      let mut index = usize.ZERO
      while index < items.length {
        run separatorOutput(&mut buffer, &child, index == usize.ZERO)
        run writeNode(&items[index], &child, &mut buffer)
        index = index + usize.ONE
      }
      if items.length != usize.ZERO { run lineOutput(&mut buffer, options) }
      return run literalOutput(&mut buffer, b"]")
    }
    Value.Object { entries } => {
      let child = run JsonOptions.child(options)
      let members = List<JsonEntry>.asSlice(&entries)
      run literalOutput(&mut buffer, b"{")
      let mut index = usize.ZERO
      while index < members.length {
        run separatorOutput(&mut buffer, &child, index == usize.ZERO)
        run stringOutput(&mut buffer, String.view(&members[index].key))
        run colonOutput(&mut buffer, &child)
        run writeNode(&members[index].value, &child, &mut buffer)
        index = index + usize.ONE
      }
      if members.length != usize.ZERO { run lineOutput(&mut buffer, options) }
      return run literalOutput(&mut buffer, b"}")
    }
  }
}

fn inputError(reason: JsonReason, offset: usize) -> JsonError {
  return JsonError {
    reason: reason,
    offset: Option<usize>.some(offset),
    required: Option<usize>.none(),
    available: Option<usize>.none(),
  }
}

/// A parsed JSON document kept in two flat buffers: one record for each value, in source order,
/// and the decoded text of every string and key.
///
/// # When to use
///
/// Use it to read a document. Parsing allocates about two buffers in all, instead of one for each
/// string, array, and object as [`Json.parse`] does, and dropping it frees only those buffers. Use
/// a [`Value`] tree when you need to build or change a document; [`JsonDocument.toValue`] makes one.
///
/// # Details
///
/// A value is named by a [`JsonNode`], a position in its document. An array record is followed by
/// its elements, and an object record by each key and its value, so a node's children are the
/// records after it. Each array and object knows where its last child ends, so skipping a value is
/// one step.
///
/// # Gotchas
///
/// A `JsonNode` is only meaningful with the document that returned it. With another document it
/// names some other value or traps.
///
/// # Examples
/// ## Read fields of a parsed document
/// ```silk
/// import silk.mem.allocator { Allocator, OutOfMemoryError }
/// import silk.core.effect { Effect }
/// import silk.core.option { Option }
/// import silk.json.scanner { JsonError }
/// import silk.json.value { JsonDocument, JsonNode }
///
/// effect fn read() -> i32 ! JsonError | OutOfMemoryError ? &mut Allocator {
///   let document = run JsonDocument.parse(b"{\"name\":\"Ada\",\"tags\":[1,2,3]}")
///   let root = JsonDocument.root(&document)
///   let tags = match JsonDocument.field(&document, root, "tags") {
///     Option<JsonNode>.Some { value } => value
///     Option<JsonNode>.None => { return 1 }
///   }
///   if JsonDocument.length(&document, tags) != 3 {
///     return 2
///   }
///   let name = match JsonDocument.field(&document, root, "name") {
///     Option<JsonNode>.Some { value } => value
///     Option<JsonNode>.None => { return 3 }
///   }
///   return match JsonDocument.asString(&document, name) {
///     Option<string>.Some { value } => if value == "Ada" { 0 } else { 4 }
///     Option<string>.None => 4
///   }
/// }
///
/// effect fn program() -> i32 ! JsonError | OutOfMemoryError {
///   let mut allocator = Allocator.systemAllocatorProvider()
///   return run read() |> Effect.provideMut<Allocator>(&mut allocator)
/// }
///
/// effect fn failed(error: JsonError | OutOfMemoryError) -> i32 {
///   return 5
/// }
///
/// pub fn main() -> i32 {
///   return run Effect.catchAll(program(), failed)
/// }
/// ```
pub struct JsonDocument {
  slots: List<DocumentSlot>,
  text: Bytes,
}

/// One value in a [`JsonDocument`]: its position in the document.
pub struct JsonNode {
  index: usize,
}

impl Copy for JsonNode {}

/// The kind of a value in a [`JsonDocument`].
pub enum JsonKind {
  /// JSON `null`.
  Null,
  /// JSON `true` or `false`.
  Bool,
  /// A JSON number.
  Number,
  /// A JSON string.
  String,
  /// A JSON array.
  Array,
  /// A JSON object.
  Object,
}

/// One member of an object in a [`JsonDocument`]: the node of its key, which is a string, and the
/// node of its value.
pub struct JsonMember {
  /// The key, a string node.
  pub key: JsonNode,
  /// The value.
  pub value: JsonNode,
}

impl Copy for JsonMember {}

/// The elements of an array in a [`JsonDocument`], in source order. [`JsonDocument.items`] makes it.
pub struct JsonItems {
  position: usize,
  end: usize,
}

/// The members of an object in a [`JsonDocument`], in source order. [`JsonDocument.members`] makes
/// it.
pub struct JsonMembers {
  position: usize,
  end: usize,
}

impl JsonItems {
  /// Returns the next element, or an absent option after the last one. `document` must be the one
  /// that made these items.
  pub fn next(self: &mut Self, document: &JsonDocument) -> Option<JsonNode> {
    if self.position >= self.end { return Option<JsonNode>.none() }
    let node = JsonNode { index: self.position }
    self.position = slotEnd(&document.slots, self.position)
    return Option<JsonNode>.some(node)
  }
}

impl JsonMembers {
  /// Returns the next member, or an absent option after the last one. `document` must be the one
  /// that made these members.
  pub fn next(self: &mut Self, document: &JsonDocument) -> Option<JsonMember> {
    if self.position >= self.end { return Option<JsonMember>.none() }
    let key = self.position
    self.position = slotEnd(&document.slots, key + usize.ONE)
    return Option<JsonMember>.some(JsonMember { key: JsonNode { index: key }, value: JsonNode { index: key + usize.ONE } })
  }
}

impl JsonDocument {
  /// Parses `bytes` as one complete JSON document.
  ///
  /// # Details
  ///
  /// Parsing is strict (RFC 8259), with the same rules and errors as [`Json.parse`]: no comments,
  /// no trailing commas, no duplicate keys, nesting at most 64 deep, and nothing after the value.
  /// String escapes are decoded when the document is parsed, and numbers are converted to a
  /// [`JsonNumber`].
  ///
  /// # Errors
  ///
  /// - `JsonError` if `bytes` is not one valid JSON value, with the reason and offset that
  ///   [`Json.parse`] reports.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the buffers.
  pub effect fn parse(bytes: &[u8]) -> JsonDocument ! JsonError | OutOfMemoryError ? &mut Allocator {
    let mut cursor = TreeCursor { index: usize.ZERO, depth: usize.ZERO, failed: false }
    let mut document = JsonDocument { slots: List<DocumentSlot>.make(), text: Bytes.make() }
    // A value takes at least 2 bytes of the text but for a lone digit, and the decoded strings are
    // never longer than the text.
    run List<DocumentSlot>.reserve(&mut document.slots, bytes.length / 8 + 4)
    run Bytes.reserve(&mut document.text, bytes.length / 2)
    // The hashes of the keys of each object being parsed, for the duplicate check.
    let mut keys = List<u64>.make()
    run documentItem(bytes, &mut cursor, &mut document, &mut keys)
    if !cursor.failed && JsonSyntax.skipWhitespace(bytes, cursor.index) == bytes.length {
      return move document
    }
    drop document
    // The scanner path reports the error where it is.
    let tree = run parseScanned(bytes)
    return run JsonDocument.fromValue(&tree)
  }

  /// Returns a document that holds a copy of `value`.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the buffers.
  pub effect fn fromValue(value: &Value) -> JsonDocument ! OutOfMemoryError ? &mut Allocator {
    let mut document = JsonDocument { slots: List<DocumentSlot>.make(), text: Bytes.make() }
    run copyValue(&mut document, value)
    return move document
  }

  /// Returns the node of the whole document.
  pub fn root(self: &Self) -> JsonNode {
    return JsonNode { index: usize.ZERO }
  }

  /// Returns the kind of `node`.
  pub fn kind(self: &Self, node: JsonNode) -> JsonKind {
    let kind = slotKind(&self.slots, node.index)
    if kind == SLOT_NULL { return JsonKind.Null }
    if kind <= SLOT_TRUE { return JsonKind.Bool }
    if kind <= SLOT_FLOAT { return JsonKind.Number }
    if kind == SLOT_STRING { return JsonKind.String }
    if kind == SLOT_ARRAY { return JsonKind.Array }
    return JsonKind.Object
  }

  /// Returns the value of a boolean. Returns an absent option if `node` is not a boolean.
  pub fn asBool(self: &Self, node: JsonNode) -> Option<bool> {
    let kind = slotKind(&self.slots, node.index)
    if kind == SLOT_FALSE { return Option<bool>.some(false) }
    if kind == SLOT_TRUE { return Option<bool>.some(true) }
    return Option<bool>.none()
  }

  /// Returns the value of a number. Returns an absent option if `node` is not a number.
  pub fn asNumber(self: &Self, node: JsonNode) -> Option<JsonNumber> {
    let slot = List<DocumentSlot>.get(&self.slots, node.index)
    let kind = u64.bitAnd(slot.info, 255)
    if kind == SLOT_INTEGER { return Option<JsonNumber>.some(JsonNumber.Integer { value: u64.wrappingToI64(slot.payload) }) }
    if kind == SLOT_UNSIGNED { return Option<JsonNumber>.some(JsonNumber.Unsigned { value: slot.payload }) }
    if kind == SLOT_FLOAT { return Option<JsonNumber>.some(JsonNumber.Float { value: f64.fromBits(slot.payload) }) }
    return Option<JsonNumber>.none()
  }

  /// Returns the text of a string, with escapes decoded. Returns an absent option if `node` is not
  /// a string. The text is borrowed from the document.
  pub fn asString<'a>(self: &'a Self, node: JsonNode) -> Option<string<'a>> {
    let slot = List<DocumentSlot>.get(&self.slots, node.index)
    if u64.bitAnd(slot.info, 255) != SLOT_STRING { return Option<string<'a>>.none() }
    return Option<string<'a>>.some(slotText(&self.*, slot))
  }

  /// Returns the number of elements of an array or members of an object, or 0 for any other value.
  pub fn length(self: &Self, node: JsonNode) -> usize {
    let slot = List<DocumentSlot>.get(&self.slots, node.index)
    let kind = u64.bitAnd(slot.info, 255)
    if kind != SLOT_ARRAY && kind != SLOT_OBJECT { return usize.ZERO }
    return u64.toUsize(u64.shiftRight(slot.info, 8))
  }

  /// Returns the elements of an array, or no elements if `node` is not an array.
  pub fn items(self: &Self, node: JsonNode) -> JsonItems {
    let slot = List<DocumentSlot>.get(&self.slots, node.index)
    if u64.bitAnd(slot.info, 255) != SLOT_ARRAY { return JsonItems { position: usize.ZERO, end: usize.ZERO } }
    return JsonItems { position: node.index + usize.ONE, end: u64.toUsize(slot.payload) }
  }

  /// Returns the members of an object, or no members if `node` is not an object.
  pub fn members(self: &Self, node: JsonNode) -> JsonMembers {
    let slot = List<DocumentSlot>.get(&self.slots, node.index)
    if u64.bitAnd(slot.info, 255) != SLOT_OBJECT { return JsonMembers { position: usize.ZERO, end: usize.ZERO } }
    return JsonMembers { position: node.index + usize.ONE, end: u64.toUsize(slot.payload) }
  }

  /// Returns the value of member `key` of an object. Returns an absent option if `node` is not an
  /// object or has no such key.
  pub fn field(self: &Self, node: JsonNode, key: string) -> Option<JsonNode> {
    let mut members = JsonDocument.members(self, node)
    while true {
      match JsonMembers.next(&mut members, self) {
        Option<JsonMember>.Some { value } => {
          let text = slotText(self, List<DocumentSlot>.get(&self.slots, value.key.index))
          if text == key { return Option<JsonNode>.some(value.value) }
        }
        Option<JsonMember>.None => { break }
      }
    }
    return Option<JsonNode>.none()
  }

  /// Returns a [`Value`] tree that holds a copy of `node` and everything in it.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the tree.
  pub effect fn toValue(self: &Self, node: JsonNode) -> Value ! OutOfMemoryError ? &mut Allocator {
    let slot = List<DocumentSlot>.get(&self.slots, node.index)
    let kind = u64.bitAnd(slot.info, 255)
    if kind == SLOT_ARRAY {
      let mut values = run List<Value>.makeWithCapacity(u64.toUsize(u64.shiftRight(slot.info, 8)))
      let mut items = JsonDocument.items(self, node)
      while true {
        match JsonItems.next(&mut items, self) {
          Option<JsonNode>.Some { value } => run List<Value>.append(&mut values, run JsonDocument.toValue(self, value))
          Option<JsonNode>.None => { break }
        }
      }
      return Value.Array { values: move values }
    }
    if kind == SLOT_OBJECT {
      let mut entries = run List<JsonEntry>.makeWithCapacity(u64.toUsize(u64.shiftRight(slot.info, 8)))
      let mut members = JsonDocument.members(self, node)
      while true {
        match JsonMembers.next(&mut members, self) {
          Option<JsonMember>.Some { value } => {
            let keySlot = List<DocumentSlot>.get(&self.slots, value.key.index)
            let key = unsafe String.fromBytesUnchecked(run Bytes.copy(String.utf8Bytes(slotText(self, keySlot))))
            run List<JsonEntry>.append(&mut entries, JsonEntry { key: move key, value: run JsonDocument.toValue(self, value.value) })
          }
          Option<JsonMember>.None => { break }
        }
      }
      return Value.Object { entries: move entries }
    }
    if kind == SLOT_STRING {
      let text = unsafe String.fromBytesUnchecked(run Bytes.copy(String.utf8Bytes(slotText(self, slot))))
      return Value.String { text: move text }
    }
    if kind == SLOT_NULL { return Value.Null }
    if kind == SLOT_FALSE { return Value.Bool { value: false } }
    if kind == SLOT_TRUE { return Value.Bool { value: true } }
    return match JsonDocument.asNumber(self, node) {
      Option<JsonNumber>.Some { value } => Value.Number { value: value }
      Option<JsonNumber>.None => Value.Null
    }
  }

  /// Writes the document as compact JSON to the `Writer`. It does not flush the `Writer`.
  ///
  /// # Errors
  ///
  /// - `JsonError` with reason `InvalidNumber` for a float that is not finite, which only
  ///   [`JsonDocument.fromValue`] can store.
  /// - `WriterError` if the `Writer` fails.
  ///
  /// # Gotchas
  ///
  /// The text goes to the `Writer` in pieces of up to 4 KiB. After a failure, the `Writer` holds
  /// only the pieces passed to it before the failure.
  pub effect fn write(self: &Self) -> () ! JsonError | WriterError ? &mut Writer {
    let options = JsonOptions.compact()
    return run JsonDocument.writeWith(self, &options)
  }

  /// Writes the document as JSON to the `Writer`, with the indentation and depth limit of
  /// `options`. It does not flush the `Writer`.
  ///
  /// # Errors
  ///
  /// - `JsonError` if the nesting is deeper than the limit in `options`, or with reason
  ///   `InvalidNumber` for a float that is not finite.
  /// - `WriterError` if the `Writer` fails.
  pub effect fn writeWith(self: &Self, options: &JsonOptions) -> () ! JsonError | WriterError ? &mut Writer {
    let mut buffer = OutputBuffer { bytes: [0; 4096], length: usize.ZERO }
    run writeSlot(self, usize.ZERO, options, &mut buffer)
    return run flushOutput(&mut buffer)
  }
}

// One value of a `JsonDocument`. The low byte of `info` is the kind; above it is the byte length of
// a string or the child count of an array or object. `payload` is a number's bits, the offset of a
// string in the text, or the index after an array's or object's last child.
struct DocumentSlot {
  info: u64,
  payload: u64,
}

impl Copy for DocumentSlot {}

const SLOT_NULL: u64 = 0
const SLOT_FALSE: u64 = 1
const SLOT_TRUE: u64 = 2
const SLOT_INTEGER: u64 = 3
const SLOT_UNSIGNED: u64 = 4
const SLOT_FLOAT: u64 = 5
const SLOT_STRING: u64 = 6
const SLOT_ARRAY: u64 = 7
const SLOT_OBJECT: u64 = 8

fn slotKind(slots: &List<DocumentSlot>, index: usize) -> u64 {
  return u64.bitAnd(List<DocumentSlot>.get(slots, index).info, 255)
}

// The index after the value at `index` and everything in it.
@inlineAlways
fn slotEnd(slots: &List<DocumentSlot>, index: usize) -> usize {
  let slot = List<DocumentSlot>.get(slots, index)
  let kind = u64.bitAnd(slot.info, 255)
  if kind == SLOT_ARRAY || kind == SLOT_OBJECT { return u64.toUsize(slot.payload) }
  return index + usize.ONE
}

fn slotText<'a>(document: &'a JsonDocument, slot: DocumentSlot) -> string<'a> {
  let bytes = Slice.view<u8>(Bytes.asSlice(&document.text), u64.toUsize(slot.payload), u64.toUsize(u64.shiftRight(slot.info, 8)))
  // Every string was checked as UTF-8 or decoded from an escape when it was stored.
  return unsafe Intrinsic.stringFromUtf8Unchecked(bytes)
}

@inlineAlways
effect fn pushSlot(document: &mut JsonDocument, kind: u64, count: usize, payload: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  return run List<DocumentSlot>.append(&mut document.slots,
    DocumentSlot { info: u64.bitOr(kind, u64.shiftLeft(usize.toU64(count), 8)), payload: payload })
}

// Parses the value that starts after whitespace at `cursor.index` onto the end of `document`, and
// moves `cursor.index` after it. Sets `cursor.failed` at anything that is not valid JSON.
effect fn documentItem(bytes: &[u8], cursor: &mut TreeCursor, document: &mut JsonDocument, keys: &mut List<u64>)
  -> () ! JsonError | OutOfMemoryError ? &mut Allocator {
  let at = JsonSyntax.skipWhitespace(bytes, cursor.index)
  if at >= bytes.length { return markFailed(&mut cursor.*) }
  let byte = bytes[at]
  if byte == 34 { return run documentString(bytes, &mut cursor.*, &mut document.*, at) }
  if byte == 45 || (byte >= 48 && byte <= 57) {
    let number = run treeNumber(bytes, &mut cursor.*, at)
    if cursor.failed { return () }
    return match number {
      JsonNumber.Integer { value } => run pushSlot(&mut document.*, SLOT_INTEGER, usize.ZERO, i64.wrappingToU64(value))
      JsonNumber.Unsigned { value } => run pushSlot(&mut document.*, SLOT_UNSIGNED, usize.ZERO, value)
      JsonNumber.Float { value } => run pushSlot(&mut document.*, SLOT_FLOAT, usize.ZERO, f64.toBits(value))
    }
  }
  if byte == 91 { return run documentArray(bytes, &mut cursor.*, &mut document.*, &mut keys.*, at + usize.ONE) }
  if byte == 123 { return run documentObject(bytes, &mut cursor.*, &mut document.*, &mut keys.*, at + usize.ONE) }
  if byte == 116 && wordAt(bytes, at, b"true") {
    cursor.index = at + 4
    return run pushSlot(&mut document.*, SLOT_TRUE, usize.ZERO, 0)
  }
  if byte == 102 && wordAt(bytes, at, b"false") {
    cursor.index = at + 5
    return run pushSlot(&mut document.*, SLOT_FALSE, usize.ZERO, 0)
  }
  if byte == 110 && wordAt(bytes, at, b"null") {
    cursor.index = at + 4
    return run pushSlot(&mut document.*, SLOT_NULL, usize.ZERO, 0)
  }
  return markFailed(&mut cursor.*)
}

// Appends the string whose quote is at `at` to the text and a record for it to the slots.
effect fn documentString(bytes: &[u8], cursor: &mut TreeCursor, document: &mut JsonDocument, at: usize)
  -> () ! JsonError | OutOfMemoryError ? &mut Allocator {
  let mut escaped = false
  let after = JsonSyntax.stringEnd(bytes, at + usize.ONE, &mut escaped)
  if after == usize.ZERO { return markFailed(&mut cursor.*) }
  cursor.index = after
  let start = Bytes.length(&document.text)
  run JsonText.decodeInto(&mut document.text, Slice.view<u8>(bytes, at, after - at), at, escaped)
  let length = Bytes.length(&document.text) - start
  return run pushSlot(&mut document.*, SLOT_STRING, length, usize.toU64(start))
}

// Parses the rest of the array whose `[` is before `start`.
effect fn documentArray(bytes: &[u8], cursor: &mut TreeCursor, document: &mut JsonDocument, keys: &mut List<u64>, start: usize)
  -> () ! JsonError | OutOfMemoryError ? &mut Allocator {
  if cursor.depth == MAX_DEPTH { return markFailed(&mut cursor.*) }
  let open = List<DocumentSlot>.length(&document.slots)
  run pushSlot(&mut document.*, SLOT_ARRAY, usize.ZERO, usize.toU64(open + usize.ONE))
  let mut at = JsonSyntax.skipWhitespace(bytes, start)
  if at < bytes.length && bytes[at] == 93 {
    cursor.index = at + usize.ONE
    return ()
  }
  cursor.depth = cursor.depth + usize.ONE
  cursor.index = at
  let mut count = usize.ZERO
  while true {
    run documentItem(bytes, &mut cursor.*, &mut document.*, &mut keys.*)
    if cursor.failed { return () }
    count = count + usize.ONE
    at = JsonSyntax.skipWhitespace(bytes, cursor.index)
    if at >= bytes.length { break }
    let byte = bytes[at]
    cursor.index = at + usize.ONE
    if byte == 93 {
      cursor.depth = cursor.depth - usize.ONE
      return closeSlot(&mut document.*, open, SLOT_ARRAY, count)
    }
    if byte != 44 { break }
  }
  return markFailed(&mut cursor.*)
}

// Parses the rest of the object whose `{` is before `start`.
effect fn documentObject(bytes: &[u8], cursor: &mut TreeCursor, document: &mut JsonDocument, keys: &mut List<u64>, start: usize)
  -> () ! JsonError | OutOfMemoryError ? &mut Allocator {
  if cursor.depth == MAX_DEPTH { return markFailed(&mut cursor.*) }
  let open = List<DocumentSlot>.length(&document.slots)
  run pushSlot(&mut document.*, SLOT_OBJECT, usize.ZERO, usize.toU64(open + usize.ONE))
  let mut at = JsonSyntax.skipWhitespace(bytes, start)
  if at < bytes.length && bytes[at] == 125 {
    cursor.index = at + usize.ONE
    return ()
  }
  cursor.depth = cursor.depth + usize.ONE
  let mut count = usize.ZERO
  let mut seen: [u64; 4] = [0, 0, 0, 0]
  let base = List<u64>.length(&keys.*)
  while true {
    if at >= bytes.length || bytes[at] != 34 { break }
    let key = List<DocumentSlot>.length(&document.slots)
    run documentString(bytes, &mut cursor.*, &mut document.*, at)
    if cursor.failed { return () }
    // A key can only repeat an earlier one with the same bit in `seen`, so most keys skip the scan.
    // A key can only repeat an earlier one with the same hash, and then with the same bit in
    // `seen`, so most keys skip the scan and nearly all the rest skip the comparison of bytes.
    let hash = keyHash(&document.*, key)
    let bit = u64.shiftRight(hash, 56)
    let word = u64.toUsize(u64.shiftRight(bit, 6))
    let mask = u64.shiftLeft(1, u64.bitAnd(bit, 63))
    if u64.bitAnd(seen[word], mask) != 0 && sameHash(&keys.*, base, hash)
      && repeatedKey(&document.*, open + usize.ONE, key) {
      break
    }
    seen[word] = u64.bitOr(seen[word], mask)
    run List<u64>.append(&mut keys.*, hash)
    at = JsonSyntax.skipWhitespace(bytes, cursor.index)
    if at >= bytes.length || bytes[at] != 58 { break }
    cursor.index = at + usize.ONE
    run documentItem(bytes, &mut cursor.*, &mut document.*, &mut keys.*)
    if cursor.failed { return () }
    count = count + usize.ONE
    at = JsonSyntax.skipWhitespace(bytes, cursor.index)
    if at >= bytes.length { break }
    let byte = bytes[at]
    cursor.index = at + usize.ONE
    if byte == 125 {
      cursor.depth = cursor.depth - usize.ONE
      List<u64>.truncate(&mut keys.*, base)
      return closeSlot(&mut document.*, open, SLOT_OBJECT, count)
    }
    if byte != 44 { break }
    at = JsonSyntax.skipWhitespace(bytes, cursor.index)
  }
  return markFailed(&mut cursor.*)
}

// Records the child count and the end of the array or object at `open`.
fn closeSlot(document: &mut JsonDocument, open: usize, kind: u64, count: usize) -> () {
  let end = List<DocumentSlot>.length(&document.slots)
  List<DocumentSlot>.set(&mut document.slots, open,
    DocumentSlot { info: u64.bitOr(kind, u64.shiftLeft(usize.toU64(count), 8)), payload: usize.toU64(end) })
}

// A hash of the key at `key`, from its length and its first and last 8 bytes.
@inlineAlways
fn keyHash(document: &JsonDocument, key: usize) -> u64 {
  let slot = List<DocumentSlot>.get(&document.slots, key)
  let size = u64.toUsize(u64.shiftRight(slot.info, 8))
  let start = u64.toUsize(slot.payload)
  let all = Bytes.asSlice(&document.text)
  let text = Slice.view<u8>(all, start, size)
  let mut mixed = usize.toU64(size)
  if size >= 8 {
    mixed = u64.bitXor(mixed, u64.bitXor(littleWord(text, usize.ZERO), u64.rotateLeft(littleWord(text, size - 8), 29)))
  } else if size > usize.ZERO && start + size >= 8 {
    // The word that ends with the key, with the bytes before it shifted out.
    mixed = u64.bitXor(mixed, u64.shiftLeft(u64.shiftRight(littleWord(all, start + size - 8), usize.toU64((8 - size) * 8)), 8))
  } else {
    let mut index = usize.ZERO
    while index < size {
      mixed = u64.bitXor(mixed, u64.shiftLeft(u8.toU64(text[index]), usize.toU64(index * 8 + 8)))
      index = index + usize.ONE
    }
  }
  let product = u64.wrappingMultiply(mixed, 11400714819323198485)
  return u64.bitXor(product, u64.shiftRight(product, 29))
}

// The 8 bytes at `at` as a little-endian word.
@inlineAlways
fn littleWord(bytes: &[u8], at: usize) -> u64 {
  let lanes = Slice.view<u8>(bytes, at, 8)
  let mut word: u64 = 0
  let mut lane = usize.ZERO
  while lane < 8 {
    word = u64.bitOr(word, u64.shiftLeft(u8.toU64(lanes[lane]), usize.toU64(lane * 8)))
    lane = lane + usize.ONE
  }
  return word
}

// `true` if a hash from `base` on in `keys` is `hash`.
fn sameHash(keys: &List<u64>, base: usize, hash: u64) -> bool {
  let hashes = List<u64>.asSlice(keys)
  let mut index = base
  while index < hashes.length {
    if hashes[index] == hash { return true }
    index = index + usize.ONE
  }
  return false
}

// `true` if a key of the object whose first key is at `first` repeats the key at `key`.
fn repeatedKey(document: &JsonDocument, first: usize, key: usize) -> bool {
  let text = slotText(document, List<DocumentSlot>.get(&document.slots, key))
  let mut index = first
  while index < key {
    if slotText(document, List<DocumentSlot>.get(&document.slots, index)) == text { return true }
    index = slotEnd(&document.slots, index + usize.ONE)
  }
  return false
}

// Appends `value` and everything in it to `document`.
effect fn copyValue(document: &mut JsonDocument, value: &Value) -> () ! OutOfMemoryError ? &mut Allocator {
  match &value.* {
    Value.Null => run pushSlot(&mut document.*, SLOT_NULL, usize.ZERO, 0)
    Value.Bool { value: flag } => {
      if flag { run pushSlot(&mut document.*, SLOT_TRUE, usize.ZERO, 0) } else { run pushSlot(&mut document.*, SLOT_FALSE, usize.ZERO, 0) }
    }
    Value.Number { value: number } => match number {
      JsonNumber.Integer { value: integer } => run pushSlot(&mut document.*, SLOT_INTEGER, usize.ZERO, i64.wrappingToU64(integer))
      JsonNumber.Unsigned { value: integer } => run pushSlot(&mut document.*, SLOT_UNSIGNED, usize.ZERO, integer)
      JsonNumber.Float { value: float } => run pushSlot(&mut document.*, SLOT_FLOAT, usize.ZERO, f64.toBits(float))
    }
    Value.String { text } => run copyText(&mut document.*, String.view(&text))
    Value.Array { values } => {
      let open = List<DocumentSlot>.length(&document.slots)
      run pushSlot(&mut document.*, SLOT_ARRAY, usize.ZERO, 0)
      let items = List<Value>.asSlice(&values)
      let mut index = usize.ZERO
      while index < items.length {
        run copyValue(&mut document.*, &items[index])
        index = index + usize.ONE
      }
      closeSlot(&mut document.*, open, SLOT_ARRAY, items.length)
    }
    Value.Object { entries } => {
      let open = List<DocumentSlot>.length(&document.slots)
      run pushSlot(&mut document.*, SLOT_OBJECT, usize.ZERO, 0)
      let members = List<JsonEntry>.asSlice(&entries)
      let mut index = usize.ZERO
      while index < members.length {
        run copyText(&mut document.*, String.view(&members[index].key))
        run copyValue(&mut document.*, &members[index].value)
        index = index + usize.ONE
      }
      closeSlot(&mut document.*, open, SLOT_OBJECT, members.length)
    }
  }
}

effect fn copyText(document: &mut JsonDocument, text: string) -> () ! OutOfMemoryError ? &mut Allocator {
  let start = Bytes.length(&document.text)
  run Bytes.append(&mut document.text, String.utf8Bytes(text))
  return run pushSlot(&mut document.*, SLOT_STRING, String.byteLength(text), usize.toU64(start))
}

// Writes the value at `index` of `document`, as `writeNode` writes a `Value`.
effect fn writeSlot(document: &JsonDocument, index: usize, options: &JsonOptions, buffer: &mut OutputBuffer)
  -> () ! JsonError | WriterError ? &mut Writer {
  let slot = List<DocumentSlot>.get(&document.slots, index)
  let kind = u64.bitAnd(slot.info, 255)
  if kind == SLOT_ARRAY {
    let child = run JsonOptions.child(options)
    let end = u64.toUsize(slot.payload)
    run literalOutput(&mut buffer, b"[")
    let mut at = index + usize.ONE
    while at < end {
      run separatorOutput(&mut buffer, &child, at == index + usize.ONE)
      run writeSlot(document, at, &child, &mut buffer)
      at = slotEnd(&document.slots, at)
    }
    if end != index + usize.ONE { run lineOutput(&mut buffer, options) }
    return run literalOutput(&mut buffer, b"]")
  }
  if kind == SLOT_OBJECT {
    let child = run JsonOptions.child(options)
    let end = u64.toUsize(slot.payload)
    run literalOutput(&mut buffer, b"{")
    let mut at = index + usize.ONE
    while at < end {
      run separatorOutput(&mut buffer, &child, at == index + usize.ONE)
      run stringOutput(&mut buffer, slotText(document, List<DocumentSlot>.get(&document.slots, at)))
      run colonOutput(&mut buffer, &child)
      run writeSlot(document, at + usize.ONE, &child, &mut buffer)
      at = slotEnd(&document.slots, at + usize.ONE)
    }
    if end != index + usize.ONE { run lineOutput(&mut buffer, options) }
    return run literalOutput(&mut buffer, b"}")
  }
  if kind == SLOT_STRING { return run stringOutput(&mut buffer, slotText(document, slot)) }
  if kind == SLOT_NULL { return run literalOutput(&mut buffer, b"null") }
  if kind == SLOT_FALSE { return run literalOutput(&mut buffer, b"false") }
  if kind == SLOT_TRUE { return run literalOutput(&mut buffer, b"true") }
  run reserveOutput(&mut buffer, NUMBER_ROOM)
  if kind == SLOT_INTEGER {
    buffer.length = Format.writeI64Display(u64.wrappingToI64(slot.payload), &mut buffer.bytes, buffer.length)
    return ()
  }
  if kind == SLOT_UNSIGNED {
    buffer.length = Format.writeU64Display(slot.payload, &mut buffer.bytes, buffer.length)
    return ()
  }
  let float = f64.fromBits(slot.payload)
  // `writeFloat` reports the error for a value that JSON cannot hold.
  if !f64.isFinite(float) {
    return run JsonOutput.writeFloat(float) |> Effect.provideMut<Writer>(&mut buffer)
  }
  buffer.length = Format.writeF64Debug(float, &mut buffer.bytes, buffer.length)
}
