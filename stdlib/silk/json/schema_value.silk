//! Convert TOML documents to the existing JSON value tree without rounding numbers.
//!
//! # When to use
//! Use [`SchemaValue.parseToml`] to feed TOML instances or schemas to JSON Schema validation.
//! Use `silk.json.value.Json.parseExact` for JSON source. Both return `silk.json.value.Value`.
//!
//! # Details
//! Tables become objects, arrays retain order, and dates and times become source strings.
//! Numbers use `JsonNumber.Decimal`: underscores and leading pluses are removed, and base-prefixed
//! integers become exact decimal. Infinity and NaN are rejected because JSON has no such numbers.
//!
//! @category Data formats

import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.json.value { Value, Json, JsonNumber, JsonEntry }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.box { Box }
import silk.num.u8
import silk.num.usize
import silk.text.string { String }
import silk.toml.scanner { TomlError, TomlScanner, TomlScalarKind, TomlSpan }
import silk.toml.value { Value as TomlValue, Toml, TomlChild }

/// A TOML tree cannot be represented as a JSON data-model tree.
pub enum ValueError {
  /// A source number is NaN or positive or negative infinity.
  NonFiniteNumber,
  /// A manually constructed TOML scalar or child has an invalid shape or spelling.
  InvalidTomlValue,
}

/// Convert TOML into the shared JSON value tree for instance and schema processing.
pub struct SchemaValue {}

impl SchemaValue {
  /// Parses TOML as a JSON object tree, resolving dotted keys, tables, and arrays of tables.
  /// Dates and times become source strings. Numbers use exact `JsonNumber.Decimal` spellings,
  /// including base-prefixed integers and numbers containing underscores.
  ///
  /// # Errors
  /// - `TomlError` for invalid TOML, duplicate definitions, or excessive nesting.
  /// - `ValueError.NonFiniteNumber` for any infinity or NaN in the document.
  /// - `OutOfMemoryError` if the allocator cannot supply either tree.
  pub effect fn parseToml(bytes: &[u8]) -> Value
    ! TomlError | ValueError | OutOfMemoryError ? &mut Allocator {
    let source = run Toml.parse(bytes)
    return run SchemaValue.fromToml(&source)
  }

  /// Copies a TOML tree into an independently owned JSON tree without rounding its numbers.
  /// Tables become objects, arrays retain order, and dates and times become their source strings.
  /// Base-prefixed integers become decimal; numeric underscores and leading pluses are removed.
  ///
  /// # Errors
  /// - `ValueError.NonFiniteNumber` for infinity or NaN.
  /// - `ValueError.InvalidTomlValue` for malformed numeric values, children, or duplicate keys.
  /// - `OutOfMemoryError` if the allocator cannot supply the copy.
  pub effect fn fromToml(value: &TomlValue) -> Value
    ! ValueError | OutOfMemoryError ? &mut Allocator {
    return match &value.* {
      TomlValue.Integer { text } => Value.Number {
        value: JsonNumber.Decimal { text: run tomlNumber(String.view(&text), false) }
      }
      TomlValue.Float { text } => Value.Number {
        value: JsonNumber.Decimal { text: run tomlNumber(String.view(&text), true) }
      }
      TomlValue.Boolean { value: boolean } => Value.Bool { value: boolean }
      TomlValue.OffsetDateTime { text } => Value.String { text: run String.copy(String.view(&text)) }
      TomlValue.LocalDateTime { text } => Value.String { text: run String.copy(String.view(&text)) }
      TomlValue.LocalDate { text } => Value.String { text: run String.copy(String.view(&text)) }
      TomlValue.LocalTime { text } => Value.String { text: run String.copy(String.view(&text)) }
      TomlValue.String { text } => Value.String { text: run String.copy(String.view(&text)) }
      TomlValue.Array { values, tables: _ } => {
        let boxed = Box<List<TomlChild>>.get(&values)
        let source = List<TomlChild>.asSlice(&boxed[0])
        let mut copied = run List<Value>.makeWithCapacity(source.length)
        let mut i: usize = 0
        while i < source.length {
          match &source[i] {
            TomlChild.Item { value: child } => {
              let converted = run SchemaValue.fromToml(&child)
              run List<Value>.append(&mut copied, move converted)
            }
            _ => { fail ValueError.InvalidTomlValue }
          }
          i = i + 1
        }
        Value.Array { values: move copied }
      }
      TomlValue.Table { entries, kind: _ } => {
        let boxed = Box<List<TomlChild>>.get(&entries)
        let source = List<TomlChild>.asSlice(&boxed[0])
        let mut copied = Value.Object { entries: run List<JsonEntry>.makeWithCapacity(source.length) }
        let mut i: usize = 0
        while i < source.length {
          match &source[i] {
            TomlChild.Member { entry } => {
              match move Json.field(&copied, String.view(&entry.key)) {
                Option<&Value>.Some { value: _ } => { fail ValueError.InvalidTomlValue }
                Option<&Value>.None => {}
              }
              let key = run String.copy(String.view(&entry.key))
              let child = run SchemaValue.fromToml(&entry.value)
              match &mut copied {
                Value.Object { entries: members } => {
                  run List<JsonEntry>.append(&mut members, JsonEntry { key: move key, value: move child })
                }
                _ => {}
              }
            }
            _ => { fail ValueError.InvalidTomlValue }
          }
          i = i + 1
        }
        move copied
      }
    }
  }
}

effect fn tomlNumber(text: string, floating: bool) -> String
  ! ValueError | OutOfMemoryError ? &mut Allocator {
  let raw = String.utf8Bytes(text)
  let scanner = TomlScanner.make(raw)
  let kind = TomlScanner.scalarKind(&scanner, TomlSpan { offset: 0, length: raw.length })
  let valid = match move kind {
    Option<TomlScalarKind>.Some { value: TomlScalarKind.Integer } => !floating
    Option<TomlScalarKind>.Some { value: TomlScalarKind.Float } => floating
    _ => false
  }
  if !valid { fail ValueError.InvalidTomlValue }
  let mut start: usize = 0
  if raw[0] == 43 || raw[0] == 45 { start = 1 }
  if raw[start] == 105 || raw[start] == 110 { fail ValueError.NonFiniteNumber }
  if raw.length > start + 2 && raw[start] == 48 {
    let prefix = raw[start + 1]
    if prefix == 120 || prefix == 111 || prefix == 98 {
      let mut base: usize = 16
      if prefix == 111 { base = 8 }
      if prefix == 98 { base = 2 }
      let mut digits = List<u8>.make()
      run List<u8>.append(&mut digits, 0)
      let mut at = start + 2
      while at < raw.length {
        let byte = raw[at]
        at = at + 1
        if byte == 95 { continue }
        let mut digit = u8.toUsize(byte - 48)
        if byte >= 97 { digit = u8.toUsize(byte - 97) + 10 }
        else if byte >= 65 { digit = u8.toUsize(byte - 65) + 10 }
        let mut carry = digit
        let count = List<u8>.length(&digits)
        let mut i: usize = 0
        while i < count {
          let decimal = List<u8>.asMutSlice(&mut digits)
          let product = u8.toUsize(decimal[i]) * base + carry
          decimal[i] = usize.toU8(product % 10)
          carry = product / 10
          i = i + 1
        }
        while carry != 0 {
          run List<u8>.append(&mut digits, usize.toU8(carry % 10))
          carry = carry / 10
        }
      }
      let decimal = List<u8>.asSlice(&digits)
      let mut output = run Bytes.makeWithCapacity(decimal.length)
      let mut i = decimal.length
      while i > 0 {
        i = i - 1
        let byte: [u8; 1] = [decimal[i] + 48]
        run Bytes.append(&mut output, &byte)
      }
      return unsafe String.fromBytesUnchecked(move output)
    }
  }
  let mut output = run Bytes.makeWithCapacity(raw.length)
  let mut i: usize = 0
  if raw[0] == 43 { i = 1 }
  while i < raw.length {
    if raw[i] != 95 { run Bytes.append(&mut output, Slice.view<u8>(raw, i, 1)) }
    i = i + 1
  }
  return unsafe String.fromBytesUnchecked(move output)
}
