//! Write a struct as a JSON object from its fields, and read one back, without writing each field
//! by hand.
//!
//! # When to use
//! Use [`JsonReflect.write`] for a struct whose fields each implement `Serialize`, and
//! [`JsonReflect.read`] for a struct whose fields each implement `Deserialize`. Call them
//! directly, or from the `Serialize` and `Deserialize` implementations of the struct.
//!
//! # Details
//! The fields are written in declaration order. Only the fields that this module can see are
//! written, so the private fields of a type from another module are left out. Writing does not
//! allocate.
//!
//! Reading finds each field's member by its key, in any order, and builds the struct with one
//! field initializer per field. Members that name no field are skipped.
//!
//! # Errors
//! - `JsonError` from a field value, or `MissingField` when the object has no member for a field.
//! - `WriterError` if the `Writer` fails. Bytes that it accepted before the failure stay written.
//!
//! # Gotchas
//! [`JsonReflect.read`] needs every field of the struct to be public, since it initializes each
//! one. It scans the object once for each field, so prefer a hand-written `Deserialize` for an
//! object with many members.
//!
//! @category Data formats

import silk.json.output { JsonOptions, JsonOutput }
import silk.json.scanner { JsonError, JsonReason, JsonScanner, JsonToken }
import silk.json.codec { Deserialize, JsonCodec }
import silk.json.text { JsonText }
import silk.collections.bytes { Bytes }
import silk.collections.slice { Slice }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }
import silk.core.reflect { Reflect, namedKind, anonymousNamedKind, labeledFieldKind }
import silk.core.static_sequence { StaticSequence }
import silk.io.writer { Writer, WriterError }

static fn visibleLabels<T>() -> Intrinsic.StaticSequence<string<'static>> {
  let mut labels = StaticSequence.empty<string<'static>>()
  static for field in Reflect.fields<T>() {
    static if Reflect.fieldKind(field) == labeledFieldKind {
      labels = StaticSequence.append<string<'static>>(
        move labels, Reflect.fieldLabel(field))
    }
  }
  return move labels
}

/// The owner type of the reflection writer. It has no fields and is never constructed.
pub struct JsonReflect {}

impl JsonReflect {
  /// Writes `value` as a JSON object with one member for each field that is visible here, in
  /// declaration order.
  ///
  /// # Details
  ///
  /// Each field must implement `Serialize`. A type that is not a struct with named fields, or a
  /// field without `Serialize`, is a compile error.
  ///
  /// # Errors
  ///
  /// - `JsonError` from a field value.
  /// - `WriterError` if the `Writer` fails. Bytes that it accepted before the failure stay written.
  ///   The object can be incomplete.
  pub effect fn write<T>(value: &T, options: &JsonOptions)
    -> () ! JsonError | WriterError ? &mut Writer {
    static if Reflect.typeKind(Reflect.typeOf<T>()) != namedKind &&
      Reflect.typeKind(Reflect.typeOf<T>()) != anonymousNamedKind {
      compileError("JsonReflect.write requires a named aggregate")
    }
    let child = run JsonOptions.child(options)
    run Writer.writeAll(b"{")
    let mut first = true
    static for label in visibleLabels<T>() {
      static for field in Reflect.fields<T>() {
        static if Reflect.fieldKind(field) == labeledFieldKind {
          static if Reflect.fieldLabel(field) == label {
            run JsonOutput.separator(&child, first)
            run JsonOutput.writeString(label)
            run JsonOutput.colon(&child)
            let member = Reflect.borrowField(value, field)
            run JsonCodec.writeOne(member, &child)
            first = false
          }
        }
      }
    }
    if !first { run JsonOutput.line(options) }
    return run Writer.writeAll(b"}")
  }
  /// Reads a JSON object from `scanner` as a `T`, one field for each member whose key is the
  /// field's name. It leaves the next token unread.
  ///
  /// # Details
  ///
  /// Each field must be public and implement `Deserialize`. Members may come in any order, and a
  /// member whose key names no field is skipped. When a key appears twice, the first member wins.
  ///
  /// # Errors
  ///
  /// - `JsonError` with reason `TypeMismatch` if the value is not an object, `MissingField` if
  ///   the object has no member for a field, or the error of a member value.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply a field value.
  ///
  /// # Examples
  ///
  /// ```silk
  /// import silk.json.reflect { JsonReflect }
  /// import silk.json.scanner { JsonError, JsonScanner }
  /// import silk.mem.allocator { Allocator, OutOfMemoryError }
  /// import silk.core.effect { Effect }
  ///
  /// struct Point {
  ///   pub x: i32,
  ///   pub y: i32,
  /// }
  ///
  /// pub effect fn main() -> i32 ! JsonError | OutOfMemoryError {
  ///   let mut allocator = Allocator.systemAllocatorProvider()
  ///   let mut scanner = JsonScanner.make(b"{\"y\": 4, \"x\": 3}")
  ///   let point = run JsonReflect.read<Point>(&mut scanner) |> Effect.provideMut<Allocator>(&mut allocator)
  ///   return point.x * 10 + point.y
  /// }
  /// ```
  pub effect fn read<T>(scanner: &mut JsonScanner<'_>)
    -> T ! JsonError | OutOfMemoryError ? &mut Allocator {
    static if Reflect.typeKind(Reflect.typeOf<T>()) != namedKind &&
      Reflect.typeKind(Reflect.typeOf<T>()) != anonymousNamedKind {
      compileError("JsonReflect.read requires a named aggregate")
    }
    let start = JsonScanner.fork(&scanner.*)
    let value = T {
      static for field in Reflect.fields<T>() { [field]: run memberValue(&start, field) },
    }
    run skipValue(&mut scanner.*)
    return move value
  }
}

// Reads the value of the member of the object at `start` whose key is the name of `field`.
effect fn memberValue<Owner, V: Deserialize>(start: &JsonScanner<'_>, static field: Intrinsic.Field<Owner, V>)
  -> V ! JsonError | OutOfMemoryError ? &mut Allocator {
  let label = Reflect.fieldLabel(field)
  let mut scanner = JsonScanner.fork(start)
  match run token(&mut scanner) {
    JsonToken.ObjectBegin => {}
    _ => { fail JsonError.at(JsonReason.TypeMismatch, JsonScanner.offset(&scanner)) }
  }
  let wanted = String.utf8Bytes(label)
  while true {
    let key = run token(&mut scanner)
    let matched = match move key {
      JsonToken.ObjectEnd => { fail JsonError.at(JsonReason.MissingField, JsonScanner.offset(start)) }
      JsonToken.String {span, escaped} => {
        let offset = span.offset
        let raw = JsonScanner.slice(&scanner, move span)
        if escaped {
          let decoded = run JsonText.decode(raw, offset, escaped)
          sameBytes(Bytes.asSlice(&decoded), wanted)
        } else {
          raw.length == wanted.length + 2 && sameBytes(Slice.view<u8>(raw, 1, wanted.length), wanted)
        }
      }
      _ => { fail JsonError.at(JsonReason.UnexpectedByte, JsonScanner.offset(&scanner)) }
    }
    match run token(&mut scanner) {
      JsonToken.KeySeparator => {}
      _ => { fail JsonError.at(JsonReason.UnexpectedByte, JsonScanner.offset(&scanner)) }
    }
    if matched { return run JsonCodec.deserializeOne<V>(&mut scanner) }
    run skipValue(&mut scanner)
    match run token(&mut scanner) {
      JsonToken.ValueSeparator => {}
      JsonToken.ObjectEnd => { fail JsonError.at(JsonReason.MissingField, JsonScanner.offset(start)) }
      _ => { fail JsonError.at(JsonReason.UnexpectedByte, JsonScanner.offset(&scanner)) }
    }
  }
  fail JsonError.at(JsonReason.UnexpectedEnd, JsonScanner.offset(&scanner))
}

// Reads past one complete value, nested arrays and objects included.
effect fn skipValue(scanner: &mut JsonScanner<'_>) -> () ! JsonError {
  let mut depth: usize = 0
  while true {
    match run token(&mut scanner.*) {
      JsonToken.ObjectBegin => { depth = depth + 1 }
      JsonToken.ArrayBegin => { depth = depth + 1 }
      JsonToken.ObjectEnd => { depth = depth - 1 }
      JsonToken.ArrayEnd => { depth = depth - 1 }
      JsonToken.KeySeparator => { continue }
      JsonToken.ValueSeparator => { continue }
      JsonToken.EndOfInput => { fail JsonError.at(JsonReason.UnexpectedEnd, JsonScanner.offset(&scanner.*)) }
      _ => {}
    }
    if depth == 0 { return () }
  }
  return ()
}

effect fn token(scanner: &mut JsonScanner<'_>) -> JsonToken ! JsonError {
  return match move JsonScanner.next(&mut scanner.*) {
    Result<JsonToken, JsonError>.Success {value} => move value
    Result<JsonToken, JsonError>.Failure {error} => { fail move error }
  }
}

fn sameBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at: usize = 0
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + 1
  }
  return true
}
