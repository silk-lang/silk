//! Low-level JSON output: strings, numbers, and punctuation, and the [`JsonOptions`] for layout.
//!
//! # When to use
//! Use [`JsonOptions.compact`] or [`JsonOptions.indented`] to choose the layout for
//! `Json.serialize` and `Json.writeWith`. Use [`JsonOutput`] directly only when you write JSON by
//! hand, for example in a `Serialize` implementation that `JsonObject` cannot express.
//!
//! # Details
//! Each operation writes to the `Writer` at once. It does not flush and does not allocate.
//!
//! # Errors
//! - `WriterError` if the `Writer` fails. Bytes that it accepted before the failure stay written.
//! - `JsonError` from [`JsonOutput.writeNumber`] for text that is not a JSON number, and from
//!   [`JsonOptions.child`] when the nesting is too deep.
//!
//! # Examples
//! ## Choose two-space indentation
//! ```silk
//! import silk.json.output { JsonOptions }
//!
//! pub fn main() -> i32 {
//!   let options = JsonOptions.indented(2)
//!   if options.indent != 2 || options.depthLimit != 64 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Data formats

import silk.json.scanner { JsonError, JsonReason, JsonScanner, JsonToken }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.text.string { String }
import silk.num.u8
import silk.num.usize
import silk.io.writer { Writer, WriterError }

/// The layout and depth limit for JSON output.
///
/// # Details
///
/// Make one with [`JsonOptions.compact`] or [`JsonOptions.indented`] and pass it to
/// `Json.serialize` or `Json.writeWith`. The writers make a child with [`JsonOptions.child`] for
/// each nested array or object.
pub struct JsonOptions {
  /// The number of spaces for each level of indentation. 0 means compact output on one line.
  pub indent: usize,
  /// The depth of the current array or object. 0 at the top level.
  pub depth: usize,
  /// The largest depth that the writers allow.
  pub depthLimit: usize,
}

impl Copy for JsonOptions {}

/// The owner type of the low-level output operations. It has no fields and is never constructed.
///
/// # When to use
/// Use its operations only when you write JSON by hand, for example in a `Serialize`
/// implementation that `JsonObject` cannot express.
///
/// # Details
/// Each operation writes to the `Writer` at once. It does not flush and does not allocate. If the
/// `Writer` fails, the bytes that it accepted before the failure stay written.
pub struct JsonOutput {}

impl JsonOptions {
  /// Returns options for compact output on one line, with a depth limit of 64 (`MAX_DEPTH`).
  pub fn compact() -> JsonOptions {
    return JsonOptions { indent: usize.ZERO, depth: usize.ZERO, depthLimit: 64 }
  }

  /// Returns options for output with `width` spaces for each level, with a depth limit of 64.
  pub fn indented(width: usize) -> JsonOptions {
    return JsonOptions { indent: width, depth: usize.ZERO, depthLimit: 64 }
  }

  /// Returns the options for a nested array or object, one level deeper.
  ///
  /// # Errors
  ///
  /// - `JsonError` with reason `DepthExceeded` if the depth is already at the limit.
  pub effect fn child(self: &JsonOptions) -> JsonOptions ! JsonError {
    if self.depth >= self.depthLimit {
      fail outputError(JsonReason.DepthExceeded)
    }
    return JsonOptions {
      indent: self.indent,
      depth: self.depth + usize.ONE,
      depthLimit: self.depthLimit,
    }
  }
}

impl JsonOutput {
  /// Writes `value` as a quoted JSON string. It escapes `"`, `\`, and control characters.
  ///
  /// # Errors
  ///
  /// - `WriterError` if the `Writer` fails. Bytes that it accepted before the failure stay written.
  pub effect fn writeString(value: string) -> () ! WriterError ? &mut Writer {
    let bytes = String.utf8Bytes(value)
    run Writer.writeAll(b"\"")
    let mut index = usize.ZERO
    let mut start = usize.ZERO
    while index < bytes.length {
      let byte = bytes[index]
      if byte == 34 || byte == 92 || byte < 32 {
        if start < index {
          run Writer.writeAll(Slice.view<u8>(bytes, start, index - start))
        }
        if byte == 34 { run Writer.writeAll(b"\\\"") }
        else if byte == 92 { run Writer.writeAll(b"\\\\") }
        else if byte == 8 { run Writer.writeAll(b"\\b") }
        else if byte == 12 { run Writer.writeAll(b"\\f") }
        else if byte == 10 { run Writer.writeAll(b"\\n") }
        else if byte == 13 { run Writer.writeAll(b"\\r") }
        else if byte == 9 { run Writer.writeAll(b"\\t") }
        else {
          let escaped = [u8.toU8(92), u8.toU8(117), u8.toU8(48), u8.toU8(48),
            hex(byte / u8.toU8(16)), hex(byte % u8.toU8(16))]
          run Writer.writeAll(&escaped)
        }
        start = index + usize.ONE
      }
      index = index + usize.ONE
    }
    if start < bytes.length {
      run Writer.writeAll(Slice.view<u8>(bytes, start, bytes.length - start))
    }
    return run Writer.writeAll(b"\"")
  }

  /// Writes `value` as a JSON number, without changes, after it checks that `value` is a valid JSON
  /// number.
  ///
  /// # Errors
  ///
  /// - `JsonError` with reason `InvalidNumber` if `value` is not a valid JSON number, such as
  ///   `"NaN"` or `"01"`. Nothing is written.
  /// - `WriterError` if the `Writer` fails. Bytes that it accepted before the failure stay written.
  pub effect fn writeNumber(value: string) -> () ! JsonError | WriterError ? &mut Writer {
    let bytes = String.utf8Bytes(value)
    let mut scanner = JsonScanner.make(bytes)
    let first = JsonScanner.next(&mut scanner)
    match move first {
      Result<JsonToken, JsonError>.Failure { error: _ } => { fail outputError(JsonReason.InvalidNumber) }
      Result<JsonToken, JsonError>.Success { value: token } => match move token {
        JsonToken.Number { span } => {
          if span.length != bytes.length { fail outputError(JsonReason.InvalidNumber) }
        }
        _ => { fail outputError(JsonReason.InvalidNumber) }
      }
    }
    let finished = JsonScanner.next(&mut scanner)
    match move finished {
      Result<JsonToken, JsonError>.Failure { error: _ } => { fail outputError(JsonReason.InvalidNumber) }
      Result<JsonToken, JsonError>.Success { value: token } => match move token {
        JsonToken.EndOfInput => {}
        _ => { fail outputError(JsonReason.InvalidNumber) }
      }
    }
    return run Writer.writeAll(bytes)
  }

  /// Writes a comma if `first` is `false`, then a newline and indentation if indentation is on.
  pub effect fn separator(options: &JsonOptions, first: bool) -> () ! WriterError ? &mut Writer {
    if !first { run Writer.writeAll(b",") }
    return run JsonOutput.line(options)
  }

  /// Writes a newline and the indentation for the current depth. Writes nothing for compact output.
  pub effect fn line(options: &JsonOptions) -> () ! WriterError ? &mut Writer {
    if options.indent == usize.ZERO { return () }
    run Writer.writeAll(b"\n")
    let mut level = usize.ZERO
    while level < options.depth {
      let mut width = usize.ZERO
      while width < options.indent {
        run Writer.writeAll(b" ")
        width = width + usize.ONE
      }
      level = level + usize.ONE
    }
    return ()
  }

  /// Writes `:` after a key. It adds a space if indentation is on.
  pub effect fn colon(options: &JsonOptions) -> () ! WriterError ? &mut Writer {
    run Writer.writeAll(b":")
    if options.indent != usize.ZERO { run Writer.writeAll(b" ") }
    return ()
  }
}

fn hex(value: u8) -> u8 {
  if value < 10 { return value + u8.toU8(48) }
  return value - u8.toU8(10) + u8.toU8(65)
}

fn outputError(reason: JsonReason) -> JsonError {
  return JsonError {
    reason: reason,
    offset: Option<usize>.none(),
    required: Option<usize>.none(),
    available: Option<usize>.none(),
  }
}
