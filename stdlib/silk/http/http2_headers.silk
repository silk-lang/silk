//! HTTP/2 field validation for requests, responses, and trailers under RFC 9113 section 8.
//!
//! @category HTTP

import silk.http.target { HttpAuthority }
import silk.text.string { String }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.num.u16
import silk.http.hpack { Field }
import silk.http.http2_frame { ProtocolError, PROTOCOL_ERROR }
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.usize

/// The expected field section type.
pub enum Section {
  /// Initial request fields, including request pseudo-headers.
  Request,
  /// Informational or final response fields, including `:status`.
  Response,
  /// Trailing fields, without pseudo-headers.
  Trailers,
}

/// Message properties needed for body validation.
pub struct Message {
  /// True if Content-Length is present.
  pub hasLength: bool,

  /// The declared body length, or zero if absent.
  pub length: u64,

  /// Response status, or zero for requests and trailers.
  pub status: u32,

  /// True for a HEAD request.
  pub head: bool,

  /// True for a CONNECT request.
  pub connect: bool,
}

/// Validates one complete decoded field section. Violations are stream PROTOCOL_ERRORs.
/// It rejects invalid bytes, pseudo-header order and duplicates, connection fields, and conflicting Content-Length values.
pub effect<'call> fn validate<'call, 'data: 'call>(
  fields: &'call [Field<'data>],
  section: Section,
  stream: u32
) -> Message
  ! ProtocolError {
  let mut request = false
  let mut response = false
  match section {
    Section.Request => {
      request = true
    }
    Section.Response => {
      response = true
    }
    Section.Trailers => {}
  }
  let mut regular = false
  let mut method: &'data [u8] = b""
  let mut scheme: &'data [u8] = b""
  let mut path: &'data [u8] = b""
  let mut authority: &'data [u8] = b""
  let mut host: &'data [u8] = b""
  let mut hasAuthority = false
  let mut hasHost = false
  let mut hasPath = false
  let mut status: u32 = 0
  let mut hasLength = false
  let mut length: u64 = 0
  let mut index: usize = 0
  while index < fields.length {
    let field = fields[index]
    if field.name.length == 0 {
      fail ProtocolError { code: PROTOCOL_ERROR, stream: stream }
    }
    let pseudo = field.name[0] == 58
    let mut byte: usize = 0
    if pseudo {
      byte = 1
    }
    if byte == field.name.length {
      fail ProtocolError { code: PROTOCOL_ERROR, stream: stream }
    }
    while byte < field.name.length {
      if !token(field.name[byte]) || (field.name[byte] >= 65 && field.name[byte] <= 90) {
        fail ProtocolError { code: PROTOCOL_ERROR, stream: stream }
      }
      byte = byte + 1
    }
    byte = 0
    while byte < field.value.length {
      let value = field.value[byte]
      if (value < 32 && value != 9) || value == 127 {
        fail ProtocolError { code: PROTOCOL_ERROR, stream: stream }
      }
      byte = byte + 1
    }
    if field.value.length > 0 {
      let first = field.value[0]
      let last = field.value[field.value.length - 1]
      if first == 32 || first == 9 || last == 32 || last == 9 {
        fail ProtocolError { code: PROTOCOL_ERROR, stream: stream }
      }
    }
    if pseudo {
      if regular {
        fail ProtocolError { code: PROTOCOL_ERROR, stream: stream }
      }
      if request && equal(field.name, b":method") && method.length == 0 {
        if field.value.length == 0 {
          fail ProtocolError { code: PROTOCOL_ERROR, stream: stream }
        }
        byte = 0
        while byte < field.value.length {
          if !token(field.value[byte]) {
            fail ProtocolError { code: PROTOCOL_ERROR, stream: stream }
          }
          byte = byte + 1
        }
        method = field.value
      } else if request && equal(field.name, b":scheme") && scheme.length == 0 {
        if field.value.length == 0 {
          fail ProtocolError { code: PROTOCOL_ERROR, stream: stream }
        }
        scheme = field.value
        byte = 0
        while byte < scheme.length {
          let value = scheme[byte]
          let letter = (value >= 65 && value <= 90) || (value >= 97 && value <= 122)
          if !letter
            && (byte == 0
            || !((value >= 48 && value <= 57) || value == 43 || value == 45 || value == 46)) {
            fail ProtocolError { code: PROTOCOL_ERROR, stream: stream }
          }
          byte = byte + 1
        }
      } else if request && equal(field.name, b":path") && !hasPath {
        hasPath = true
        path = field.value
        byte = 0
        while byte < path.length {
          if path[byte] <= 32 || path[byte] == 127 || path[byte] == 35 {
            fail ProtocolError { code: PROTOCOL_ERROR, stream: stream }
          }
          byte = byte + 1
        }
      } else if request && equal(field.name, b":authority") && !hasAuthority {
        authority = field.value
        hasAuthority = true
      } else if response && equal(field.name, b":status") && status == 0 {
        if field.value.length != 3 {
          fail ProtocolError { code: PROTOCOL_ERROR, stream: stream }
        }
        byte = 0
        while byte < 3 {
          if field.value[byte] < 48 || field.value[byte] > 57 {
            fail ProtocolError { code: PROTOCOL_ERROR, stream: stream }
          }
          status = status * 10 + u8.toU32(field.value[byte] - 48)
          byte = byte + 1
        }
        if status < 100 || status > 599 || status == 101 {
          fail ProtocolError { code: PROTOCOL_ERROR, stream: stream }
        }
      } else {
        fail ProtocolError { code: PROTOCOL_ERROR, stream: stream }
      }
    } else {
      regular = true
      if equal(field.name, b"connection") || equal(field.name, b"proxy-connection")
        || equal(field.name, b"keep-alive")
        || equal(field.name, b"transfer-encoding")
        || equal(field.name, b"upgrade") {
        fail ProtocolError { code: PROTOCOL_ERROR, stream: stream }
      }
      if equal(field.name, b"te") && (!request || !equalFold(field.value, b"trailers")) {
        fail ProtocolError { code: PROTOCOL_ERROR, stream: stream }
      }
      if equal(field.name, b"host") {
        if hasHost {
          fail ProtocolError { code: PROTOCOL_ERROR, stream: stream }
        }
        host = field.value
        hasHost = true
      }
      if equal(field.name, b"content-length") {
        if !request && !response {
          fail ProtocolError { code: PROTOCOL_ERROR, stream: stream }
        }
        if field.value.length == 0 {
          fail ProtocolError { code: PROTOCOL_ERROR, stream: stream }
        }
        let mut parsed: u64 = 0
        byte = 0
        while byte < field.value.length {
          let value = field.value[byte]
          if value < 48 || value > 57 {
            fail ProtocolError { code: PROTOCOL_ERROR, stream: stream }
          }
          let digit = u8.toU64(value - 48)
          if parsed > (u64.MAX - digit) / 10 {
            fail ProtocolError { code: PROTOCOL_ERROR, stream: stream }
          }
          parsed = parsed * 10 + digit
          byte = byte + 1
        }
        if hasLength && length != parsed {
          fail ProtocolError { code: PROTOCOL_ERROR, stream: stream }
        }
        hasLength = true
        length = parsed
      }
    }
    index = index + 1
  }
  let connect = equal(method, b"CONNECT")
  if request {
    if method.length == 0 {
      fail ProtocolError { code: PROTOCOL_ERROR, stream: stream }
    }
    if connect {
      if scheme.length != 0 || hasPath || !hasAuthority || authority.length == 0 {
        fail ProtocolError { code: PROTOCOL_ERROR, stream: stream }
      }
    } else {
      if scheme.length == 0 || !hasPath {
        fail ProtocolError { code: PROTOCOL_ERROR, stream: stream }
      }
      if path.length == 0 && (equalFold(scheme, b"http") || equalFold(scheme, b"https")) {
        fail ProtocolError { code: PROTOCOL_ERROR, stream: stream }
      }
      if path.length > 0 && path[0] != 47 && !(equal(path, b"*") && equal(method, b"OPTIONS")) {
        fail ProtocolError { code: PROTOCOL_ERROR, stream: stream }
      }
    }
    if hasAuthority && authority.length > 0 {
      let parsed = run checkedAuthority(authority, stream)
      if connect {
        match move HttpAuthority.port(&parsed) {
          Option.Some {..} => {}
          Option.None => {
            fail ProtocolError { code: PROTOCOL_ERROR, stream: stream }
          }
        }
      }
    }
    if hasHost {
      drop run checkedAuthority(host, stream)
    }
    if hasHost && hasAuthority {
      let same = run sameAuthority(host, authority, scheme, stream)
      if !same {
        fail ProtocolError { code: PROTOCOL_ERROR, stream: stream }
      }
    }
    let mut byte: usize = 0
    while byte < authority.length {
      if authority[byte] <= 32 || authority[byte] == 127 || authority[byte] == 64
        || authority[byte] == 47
        || authority[byte] == 63
        || authority[byte] == 35 {
        fail ProtocolError { code: PROTOCOL_ERROR, stream: stream }
      }
      byte = byte + 1
    }
  }
  if response && status == 0 {
    fail ProtocolError { code: PROTOCOL_ERROR, stream: stream }
  }
  if response && (status < 200 || status == 204) && hasLength {
    fail ProtocolError { code: PROTOCOL_ERROR, stream: stream }
  }
  return Message {
    hasLength: hasLength,
    length: length,
    status: status,
    head: equal(method, b"HEAD"),
    connect: connect
  }
}

fn token(byte: u8) -> bool {
  return (byte >= 48 && byte <= 57) || (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122)
    || byte == 33
    || byte == 35
    || byte == 36
    || byte == 37
    || byte == 38
    || byte == 39
    || byte == 42
    || byte == 43
    || byte == 45
    || byte == 46
    || byte == 94
    || byte == 95
    || byte == 96
    || byte == 124
    || byte == 126
}

fn equal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut index: usize = 0
  while index < left.length {
    if left[index] != right[index] {
      return false
    }
    index = index + 1
  }
  return true
}

effect fn checkedAuthority<'a>(bytes: &'a [u8], stream: u32) -> HttpAuthority<'a>
  ! ProtocolError {
  let text = match move String.fromUtf8(bytes) {
    Result.Success { value } => value
    Result.Failure {..} => {
      fail ProtocolError { code: PROTOCOL_ERROR, stream: stream }
    }
  }
  return match move HttpAuthority.parse(text) {
    Result.Success { value } => value
    Result.Failure {..} => {
      fail ProtocolError { code: PROTOCOL_ERROR, stream: stream }
    }
  }
}

effect fn sameAuthority(left: &[u8], right: &[u8], scheme: &[u8], stream: u32) -> bool
  ! ProtocolError {
  let a = run checkedAuthority(left, stream)
  let b = run checkedAuthority(right, stream)
  if !equalFold(
    String.utf8Bytes(HttpAuthority.host(&a)),
    String.utf8Bytes(HttpAuthority.host(&b))
  ) {
    return false
  }
  let mut defaultPort: u16 = 0
  if equalFold(scheme, b"http") {
    defaultPort = 80
  }
  if equalFold(scheme, b"https") {
    defaultPort = 443
  }
  let first = match move HttpAuthority.port(&a) {
    Option.Some { value } => value
    Option.None => defaultPort
  }
  let second = match move HttpAuthority.port(&b) {
    Option.Some { value } => value
    Option.None => defaultPort
  }
  return first == second
}

fn equalFold(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut index: usize = 0
  while index < left.length {
    let mut a = left[index]
    let mut b = right[index]
    if a >= 65 && a <= 90 {
      a = a + 32
    }
    if b >= 65 && b <= 90 {
      b = b + 32
    }
    if a != b {
      return false
    }
    index = index + 1
  }
  return true
}
