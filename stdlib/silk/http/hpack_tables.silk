//! RFC 7541 Appendix A static fields and Appendix B Huffman decoding trie.
//!
//! @category HTTP

import silk.http.hpack { Field }
import silk.num.usize

/// Returns the RFC 7541 static field at a one-based index from 1 through 61. Other indices return an empty field.
pub fn field(index: usize) -> Field<'static> {
  return match index {
    1 => Field { name: b":authority", value: b"", sensitive: false }
    2 => Field { name: b":method", value: b"GET", sensitive: false }
    3 => Field { name: b":method", value: b"POST", sensitive: false }
    4 => Field { name: b":path", value: b"/", sensitive: false }
    5 => Field { name: b":path", value: b"/index.html", sensitive: false }
    6 => Field { name: b":scheme", value: b"http", sensitive: false }
    7 => Field { name: b":scheme", value: b"https", sensitive: false }
    8 => Field { name: b":status", value: b"200", sensitive: false }
    9 => Field { name: b":status", value: b"204", sensitive: false }
    10 => Field { name: b":status", value: b"206", sensitive: false }
    11 => Field { name: b":status", value: b"304", sensitive: false }
    12 => Field { name: b":status", value: b"400", sensitive: false }
    13 => Field { name: b":status", value: b"404", sensitive: false }
    14 => Field { name: b":status", value: b"500", sensitive: false }
    15 => Field { name: b"accept-charset", value: b"", sensitive: false }
    16 => Field { name: b"accept-encoding", value: b"gzip, deflate", sensitive: false }
    17 => Field { name: b"accept-language", value: b"", sensitive: false }
    18 => Field { name: b"accept-ranges", value: b"", sensitive: false }
    19 => Field { name: b"accept", value: b"", sensitive: false }
    20 => Field { name: b"access-control-allow-origin", value: b"", sensitive: false }
    21 => Field { name: b"age", value: b"", sensitive: false }
    22 => Field { name: b"allow", value: b"", sensitive: false }
    23 => Field { name: b"authorization", value: b"", sensitive: false }
    24 => Field { name: b"cache-control", value: b"", sensitive: false }
    25 => Field { name: b"content-disposition", value: b"", sensitive: false }
    26 => Field { name: b"content-encoding", value: b"", sensitive: false }
    27 => Field { name: b"content-language", value: b"", sensitive: false }
    28 => Field { name: b"content-length", value: b"", sensitive: false }
    29 => Field { name: b"content-location", value: b"", sensitive: false }
    30 => Field { name: b"content-range", value: b"", sensitive: false }
    31 => Field { name: b"content-type", value: b"", sensitive: false }
    32 => Field { name: b"cookie", value: b"", sensitive: false }
    33 => Field { name: b"date", value: b"", sensitive: false }
    34 => Field { name: b"etag", value: b"", sensitive: false }
    35 => Field { name: b"expect", value: b"", sensitive: false }
    36 => Field { name: b"expires", value: b"", sensitive: false }
    37 => Field { name: b"from", value: b"", sensitive: false }
    38 => Field { name: b"host", value: b"", sensitive: false }
    39 => Field { name: b"if-match", value: b"", sensitive: false }
    40 => Field { name: b"if-modified-since", value: b"", sensitive: false }
    41 => Field { name: b"if-none-match", value: b"", sensitive: false }
    42 => Field { name: b"if-range", value: b"", sensitive: false }
    43 => Field { name: b"if-unmodified-since", value: b"", sensitive: false }
    44 => Field { name: b"last-modified", value: b"", sensitive: false }
    45 => Field { name: b"link", value: b"", sensitive: false }
    46 => Field { name: b"location", value: b"", sensitive: false }
    47 => Field { name: b"max-forwards", value: b"", sensitive: false }
    48 => Field { name: b"proxy-authenticate", value: b"", sensitive: false }
    49 => Field { name: b"proxy-authorization", value: b"", sensitive: false }
    50 => Field { name: b"range", value: b"", sensitive: false }
    51 => Field { name: b"referer", value: b"", sensitive: false }
    52 => Field { name: b"refresh", value: b"", sensitive: false }
    53 => Field { name: b"retry-after", value: b"", sensitive: false }
    54 => Field { name: b"server", value: b"", sensitive: false }
    55 => Field { name: b"set-cookie", value: b"", sensitive: false }
    56 => Field { name: b"strict-transport-security", value: b"", sensitive: false }
    57 => Field { name: b"transfer-encoding", value: b"", sensitive: false }
    58 => Field { name: b"user-agent", value: b"", sensitive: false }
    59 => Field { name: b"vary", value: b"", sensitive: false }
    60 => Field { name: b"via", value: b"", sensitive: false }
    61 => Field { name: b"www-authenticate", value: b"", sensitive: false }
    _ => Field { name: b"", value: b"", sensitive: false }
  }
}

