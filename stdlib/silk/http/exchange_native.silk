/// The error of a native HTTP connection, before or during TLS.
pub union NativeExchangeError {
  /// The poll interval or the attempt count of [`Options`] is out of range. See
  /// `silk.net.socket_native`.
  InvalidConnectOptions,
  /// A host name must be resolved, and there is a deadline. Resolution cannot stop at a deadline.
  UnsupportedDeadline,
  /// The origin uses `https`, and no trust snapshot was given.
  TrustRequired,
  /// The policy is `RequiredHttp11`, and the server did not select `http/1.1`.
  AlpnMismatch {
    /// The TLS error.
    pub error: ConnectionError,
  },
}

impl Debug for NativeExchangeError {
  /// Writes the name of the variant and its fields, such as `InvalidConnectOptions`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      NativeExchangeError.InvalidConnectOptions => run Format.write(&mut formatter, b"InvalidConnectOptions")
      NativeExchangeError.UnsupportedDeadline => run Format.write(&mut formatter, b"UnsupportedDeadline")
      NativeExchangeError.TrustRequired => run Format.write(&mut formatter, b"TrustRequired")
      NativeExchangeError.AlpnMismatch { error } => {
        let mut record = run Format.debugRecord("AlpnMismatch", &mut formatter)
        run Format.debugField(&mut record, "error", &error, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
    }
  }
}

/// How TLS negotiates the HTTP version (ALPN).
pub enum AlpnPolicy {
  /// Offers `http/1.1`. The server can select it or select nothing.
  OptionalHttp11,
  /// Offers `http/1.1`. If the server does not select it, the connection fails with `AlpnMismatch`.
  RequiredHttp11,
  /// Sends no ALPN extension. Use it for a server that supports only HTTP/1.0.
  Http10,
}

/// The settings of a native connection. Start from [`Options.defaults`].
///
/// # Details
///
/// The deadline is absolute, and each step of a connection gets it unchanged: the check, the name
/// resolution, the connect, and TLS.
///
/// # Gotchas
///
/// A host name with a deadline fails with `UnsupportedDeadline` before any contact, because
/// resolution cannot stop at a deadline. An IP address with a deadline is accepted.
pub struct Options {
  /// The maximum number of addresses to keep from resolution.
  pub maximumAddresses: usize,
  /// The address families to use: IPv4, IPv6, or both.
  pub family: FamilySelection,
  /// Whether to disable Nagle's algorithm on the socket.
  pub noDelay: bool,
  /// The time between checks while a socket connects. It is 1 nanosecond through 1 second.
  pub pollIntervalNanoseconds: u64,
  /// The maximum number of connection attempts. It is 1 through 1024.
  pub maximumAttempts: usize,
  /// The absolute deadline for the whole operation, on the monotonic clock. It must be `None` when
  /// the host of the origin is a name, because the name lookup cannot stop at a deadline. Then the
  /// operation fails with `UnsupportedDeadline` before any I/O.
  pub deadline: Option<Instant>,
  /// The maximum duration of the TLS handshake.
  pub handshakeNanoseconds: u64,
  /// The storage limits of the TLS client.
  pub tls: ClientLimits,
  /// The limits for loading trust anchors.
  pub trust: TrustLoadLimits,
  /// How TLS negotiates the HTTP version.
  pub alpn: AlpnPolicy,
}

impl Options {
  /// Returns the default settings.
  ///
  /// They are: 16 addresses, any family, Nagle on, a 1 ms poll interval, 64 attempts, no deadline,
  /// 30 seconds for the handshake, and `OptionalHttp11`.
  pub fn defaults() -> Options {
    return Options {
      maximumAddresses: 16,
      family: FamilySelection.Any,
      noDelay: false,
      pollIntervalNanoseconds: u64.toU64(1000000),
      maximumAttempts: 64,
      deadline: Option<Instant>.none(),
      handshakeNanoseconds: u64.toU64(30000000000),
      tls: ClientLimits.defaults(),
      trust: TrustLoadLimits.defaults(),
      alpn: AlpnPolicy.OptionalHttp11,
    }
  }
}

fn proxyPeer<'configuration>(route: &Route<'configuration>) -> Result<Origin, ProxyError> {
  if Route.mode(route) == RouteMode.Direct {
    return Result<Origin, ProxyError>.succeed(Route.originalOrigin(route))
  }
  return match move Route.physicalPeer(route) {
    Result.Success {value} => {
      return Result<Origin, ProxyError>.succeed(value)
    }
    Result.Failure {error} => {
      drop error
      return Result<Origin, ProxyError>.failResult(ProxyError.invalidRoute())
    }
  }
}

fn proxyProtocol(policy: AlpnPolicy) -> RouteProtocol {
  return match policy {
    AlpnPolicy.Http10 => RouteProtocol.Http10
    AlpnPolicy.OptionalHttp11 => RouteProtocol.OptionalHttp11
    AlpnPolicy.RequiredHttp11 => RouteProtocol.RequiredHttp11
  }
}

fn proxySettings(options: &Options, limits: Limits) -> RouteSettings {
  return RouteSettings {
    http: limits,
    request: limits.head.values,
    maxRequestHeadBytes: limits.head.maxHeadBytes,
    maxProxyCredentialBytes: limits.head.values.maxValueBytes,
    protocol: proxyProtocol(options.alpn),
    tls: options.tls,
    handshakeDurationNanoseconds: options.handshakeNanoseconds,
  }
}

import silk.net.resolver_native {NativeSystemResolver}
import silk.net.socket_native as Sockets {
  Connection as NativeConnection,
  ConnectOptions,
  NativeSocketError,
}
import silk.io.writer {Writer, WriterError}

union State {
  Plain {connection: NativeConnection},
  Secured {connection: OwnedConnection<NativeConnection>},
}

/// The transport of a native HTTP connection. It owns its socket or TLS connection.
pub struct NativeTransport {
  state: State,
  terminal: bool,
  routeValue: NativeRoute,
}

/// The plain socket of a connection through [`withProxyRoute`].
///
/// # Details
/// It is connected to the peer that the route selects: the origin or the proxy. After a `CONNECT`
/// tunnel, TLS uses the same socket. The HTTP side and the byte side share one closed state, so the
/// socket is never used by two owners.
pub struct NativeRouteProvider {
  connection: NativeConnection,
  terminal: bool,
}

impl NativeRouteProvider {
  effect fn readHttp(self: &mut Self, output: &mut [u8], deadline: Option<Instant>) -> ReadTransfer
  ! TransportError | OutOfMemoryError
  ? &mut Allocator | &mut MonotonicClock | &mut Random {
    static if (Intrinsic.targetOperatingSystem() == "windows" && Intrinsic.targetArchitecture() == "x86_64" && Intrinsic.targetAbi() == "msvc" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText(
      "libc",
    ) == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText(
      "libc",
    ) == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
      if self.terminal {
        fail TransportError.Plain {error: ByteDuplex.closed(ByteIoOperation.Read)}
      }
      // The socket is used directly. Going through Transport.plain would dispatch HttpTransport
      // again inside the RouteTransport dispatch, which the compiler rejects as growing recursion
      // (SEM0053). The other HTTP operations below do the same.
      let attempted = run Effect.result(ByteDuplex.readSome(move output, move deadline) |> Effect.provideMut<ByteDuplex>(&mut self.connection))
      return match move attempted {
        Result<ReadTransfer, ByteIoError>.Success {value} => move value
        Result<ReadTransfer, ByteIoError>.Failure {error} => {
          fail TransportError.Plain {error: move error}
        }
      }
    } else {
      compileError("Native HTTP acquisition requires a supported Windows, Darwin, or GNU libc profile")
    }
  }
  effect fn writeHttp(self: &mut Self, input: &[u8], deadline: Option<Instant>) -> usize
  ! TransportError | OutOfMemoryError
  ? &mut Allocator | &mut MonotonicClock | &mut Random {
    static if (Intrinsic.targetOperatingSystem() == "windows" && Intrinsic.targetArchitecture() == "x86_64" && Intrinsic.targetAbi() == "msvc" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText(
      "libc",
    ) == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText(
      "libc",
    ) == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
      if self.terminal {
        fail TransportError.Plain {error: ByteDuplex.closed(ByteIoOperation.Write)}
      }
      let attempted = run Effect.result(ByteDuplex.writeSome(move input, move deadline) |> Effect.provideMut<ByteDuplex>(&mut self.connection))
      return match move attempted {
        Result<usize, ByteIoError>.Success {value} => move value
        Result<usize, ByteIoError>.Failure {error} => {
          fail TransportError.Plain {error: move error}
        }
      }
    } else {
      compileError("Native HTTP acquisition requires a supported Windows, Darwin, or GNU libc profile")
    }
  }
  effect fn flushHttp(self: &mut Self, deadline: Option<Instant>) -> ()
  ! TransportError | OutOfMemoryError
  ? &mut Allocator | &mut MonotonicClock | &mut Random {
    static if (Intrinsic.targetOperatingSystem() == "windows" && Intrinsic.targetArchitecture() == "x86_64" && Intrinsic.targetAbi() == "msvc" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText(
      "libc",
    ) == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText(
      "libc",
    ) == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
      if self.terminal {
        fail TransportError.Plain {error: ByteDuplex.closed(ByteIoOperation.Flush)}
      }
      let attempted = run Effect.result(ByteDuplex.flush(move deadline) |> Effect.provideMut<ByteDuplex>(&mut self.connection))
      return match move attempted {
        Result<(), ByteIoError>.Success {value} => move value
        Result<(), ByteIoError>.Failure {error} => {
          fail TransportError.Plain {error: move error}
        }
      }
    } else {
      compileError("Native HTTP acquisition requires a supported Windows, Darwin, or GNU libc profile")
    }
  }
  effect fn closeHttp(self: &mut Self) -> () ! TransportError {
    static if (Intrinsic.targetOperatingSystem() == "windows" && Intrinsic.targetArchitecture() == "x86_64" && Intrinsic.targetAbi() == "msvc" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText(
      "libc",
    ) == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText(
      "libc",
    ) == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
      if self.terminal {
        return ()
      }
      self.terminal = true
      let attempted = run Effect.result(ByteDuplex.close() |> Effect.provideMut<ByteDuplex>(&mut self.connection))
      return match move attempted {
        Result<(), ByteIoError>.Success {value} => move value
        Result<(), ByteIoError>.Failure {error} => {
          fail TransportError.Plain {error: move error}
        }
      }
    } else {
      compileError("Native HTTP acquisition requires a supported Windows, Darwin, or GNU libc profile")
    }
  }
  unsafe effect fn readBytes(self: &mut Self, output: &mut [u8], deadline: Option<Instant>) -> ReadTransfer
  ! ByteIoError
  ? &mut MonotonicClock {
    static if (Intrinsic.targetOperatingSystem() == "windows" && Intrinsic.targetArchitecture() == "x86_64" && Intrinsic.targetAbi() == "msvc" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText(
      "libc",
    ) == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText(
      "libc",
    ) == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
      if self.terminal {
        fail ByteDuplex.closed(ByteIoOperation.Read)
      }
      return run unsafe ByteDuplex.readSomeRaw(move output, move deadline)
        |> Effect.provideMut<ByteDuplex>(&mut self.connection)
    } else {
      compileError("Native HTTP acquisition requires a supported Windows, Darwin, or GNU libc profile")
    }
  }
  unsafe effect fn writeBytes(self: &mut Self, input: &[u8], deadline: Option<Instant>) -> usize
  ! ByteIoError
  ? &mut MonotonicClock {
    static if (Intrinsic.targetOperatingSystem() == "windows" && Intrinsic.targetArchitecture() == "x86_64" && Intrinsic.targetAbi() == "msvc" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText(
      "libc",
    ) == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText(
      "libc",
    ) == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
      if self.terminal {
        fail ByteDuplex.closed(ByteIoOperation.Write)
      }
      return run unsafe ByteDuplex.writeSomeRaw(move input, move deadline)
        |> Effect.provideMut<ByteDuplex>(&mut self.connection)
    } else {
      compileError("Native HTTP acquisition requires a supported Windows, Darwin, or GNU libc profile")
    }
  }
  unsafe effect fn writeBytesVectored(self: &mut Self, inputs: &[&[u8]], deadline: Option<Instant>) -> usize
  ! ByteIoError
  ? &mut MonotonicClock {
    static if (Intrinsic.targetOperatingSystem() == "windows" && Intrinsic.targetArchitecture() == "x86_64" && Intrinsic.targetAbi() == "msvc" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText(
      "libc",
    ) == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText(
      "libc",
    ) == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
      if self.terminal {
        fail ByteDuplex.closed(ByteIoOperation.Write)
      }
      return run unsafe ByteDuplex.writeSomeVectoredRaw(inputs, move deadline)
        |> Effect.provideMut<ByteDuplex>(&mut self.connection)
    } else {
      compileError("Native HTTP acquisition requires a supported Windows, Darwin, or GNU libc profile")
    }
  }
  unsafe effect fn flushBytes(self: &mut Self, deadline: Option<Instant>) -> ()
  ! ByteIoError
  ? &mut MonotonicClock {
    static if (Intrinsic.targetOperatingSystem() == "windows" && Intrinsic.targetArchitecture() == "x86_64" && Intrinsic.targetAbi() == "msvc" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText(
      "libc",
    ) == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText(
      "libc",
    ) == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
      if self.terminal {
        fail ByteDuplex.closed(ByteIoOperation.Flush)
      }
      return run unsafe ByteDuplex.flushRaw(move deadline)
        |> Effect.provideMut<ByteDuplex>(&mut self.connection)
    } else {
      compileError("Native HTTP acquisition requires a supported Windows, Darwin, or GNU libc profile")
    }
  }
  unsafe effect fn shutdownBytes(self: &mut Self, deadline: Option<Instant>) -> ()
  ! ByteIoError
  ? &mut MonotonicClock {
    static if (Intrinsic.targetOperatingSystem() == "windows" && Intrinsic.targetArchitecture() == "x86_64" && Intrinsic.targetAbi() == "msvc" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText(
      "libc",
    ) == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText(
      "libc",
    ) == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
      if self.terminal {
        fail ByteDuplex.closed(ByteIoOperation.ShutdownWrite)
      }
      return run unsafe ByteDuplex.shutdownWriteRaw(move deadline)
        |> Effect.provideMut<ByteDuplex>(&mut self.connection)
    } else {
      compileError("Native HTTP acquisition requires a supported Windows, Darwin, or GNU libc profile")
    }
  }
  unsafe effect fn closeBytes(self: &mut Self) -> () ! ByteIoError {
    static if (Intrinsic.targetOperatingSystem() == "windows" && Intrinsic.targetArchitecture() == "x86_64" && Intrinsic.targetAbi() == "msvc" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText(
      "libc",
    ) == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText(
      "libc",
    ) == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
      if self.terminal {
        return ()
      }
      self.terminal = true
      return run unsafe ByteDuplex.closeRaw()
        |> Effect.provideMut<ByteDuplex>(&mut self.connection)
    } else {
      compileError("Native HTTP acquisition requires a supported Windows, Darwin, or GNU libc profile")
    }
  }
}

impl HttpTransport for NativeRouteProvider {
  readSomeRaw: NativeRouteProvider.readHttp
  writeSomeRaw: NativeRouteProvider.writeHttp
  flush: NativeRouteProvider.flushHttp
  close: NativeRouteProvider.closeHttp
}

impl ByteDuplex for NativeRouteProvider {
  readSomeRaw: NativeRouteProvider.readBytes
  writeSomeRaw: NativeRouteProvider.writeBytes
  writeSomeVectoredRaw: NativeRouteProvider.writeBytesVectored
  flushRaw: NativeRouteProvider.flushBytes
  shutdownWriteRaw: NativeRouteProvider.shutdownBytes
  closeRaw: NativeRouteProvider.closeBytes
}

fn copyOpeningInstant(value: &Instant) -> Instant {
  return SystemClock.make(SystemClock.seconds(value), SystemClock.nanoseconds(value))
}

fn instantEarlierOrEqual(left: &Instant, right: &Instant) -> bool {
  let leftSeconds = SystemClock.seconds(left)
  let rightSeconds = SystemClock.seconds(right)
  if leftSeconds < rightSeconds {
    return true
  }
  if leftSeconds > rightSeconds {
    return false
  }
  return SystemClock.nanoseconds(left) <= SystemClock.nanoseconds(right)
}

fn selectOpeningDeadline(requestDeadline: &Option<Instant>, acquisitionDeadline: &Option<Instant>) -> Option<
  Instant,
> {
  return match & requestDeadline.* {
    Option.None => copyDeadline(acquisitionDeadline)
    Option.Some {value: request} => {
      return match & acquisitionDeadline.* {
        Option.None => Option<Instant>.some(copyOpeningInstant(&request))
        Option.Some {value: acquisition} => {
          if instantEarlierOrEqual(&acquisition, &request) {
            return Option<Instant>.some(copyOpeningInstant(&acquisition))
          }
          return Option<Instant>.some(copyOpeningInstant(&request))
        }
      }
    }
  }
}

effect fn checkOpeningDeadline(deadline: &Option<Instant>) -> ()
! NativeSocketError
? &mut MonotonicClock {
  if let Option.Some {value: limit} = &deadline.* {
    let now = run MonotonicClock.now()
    if instantEarlierOrEqual(&limit, &now) {
      fail NativeSocketError.Timeout
    }
  }
  return ()
}

fn trustPresent(trust: &Option<TrustSnapshot>) -> bool {
  return match & trust.* {
    Option.None => false
    Option.Some {value} => true
  }
}

effect fn prepareTrust(origin: &Origin, options: &Options) -> Option<TrustSnapshot>
! TrustSourceError | OutOfMemoryError
? &mut Allocator | &mut TrustSource {
  if Origin.secure(origin) {
    return Option<TrustSnapshot>.some(run TrustSource.load(options.trust))
  }
  return Option<TrustSnapshot>.none()
}

struct OwnedPublication {
  socket: Option<NativeConnection>,
  transport: Option<NativeTransport>,
  connection: Option<Connection<NativeTransport>>,
}

effect fn releasePublication(owned: &mut OwnedPublication) -> () {
  if let Option.Some {value} = &mut owned.socket {
    let closed = run Effect.result(NativeConnection.close(&mut value))
    drop closed
  }
  if let Option.Some {value} = &mut owned.transport {
    let closed = run Effect.result(HttpTransport.close())
      |> Effect.provideMut<HttpTransport>(&mut value)
    drop closed
  }
  if let Option.Some {value} = &mut owned.connection {
    let closed = run Effect.result(Client.close(&mut value))
    drop closed
  }
  return ()
}

effect fn publishOwned(
  socket: NativeConnection,
  origin: Origin,
  options: &Options,
  limits: Limits,
  preparedTrust: Option<TrustSnapshot>,
  route: NativeRoute,
  deadline: Option<Instant>,
) -> Connection<NativeTransport>
! NativeExchangeError | ExchangeError | NativeSocketError | ConnectionError | IdentityError | OutOfMemoryError
? &mut Allocator | &mut MonotonicClock | &mut SystemClock | &mut Random {
  let guard = OwnedPublication {
    socket: Option<NativeConnection>.some(move socket),
    transport: Option<NativeTransport>.none(),
    connection: Option<Connection<NativeTransport>>.none(),
  }
  let use = effect fn(owned: &mut OwnedPublication) -> Connection<NativeTransport>
  ! NativeExchangeError | ExchangeError | NativeSocketError | ConnectionError | IdentityError | OutOfMemoryError
  ? &mut Allocator | &mut MonotonicClock | &mut SystemClock | &mut Random {
    if Origin.secure(&origin) {
      let trust = match move preparedTrust {
        Option.Some {value} => move value
        Option.None => unavailable<TrustSnapshot>()
      }
      run securePrepared(&mut owned.*, &origin, options, route, move trust)
    } else {
      drop preparedTrust
      let stored = Intrinsic.replace(owned.socket, Option<NativeConnection>.none())
      let provider = match move stored {
        Option.Some {value} => move value
        Option.None => unavailable<NativeConnection>()
      }
      owned.transport = Option<NativeTransport>.some(
        NativeTransport {
          state: State.Plain {connection: move provider},
          terminal: false,
          routeValue: route,
        },
      )
    }
    let retained = Intrinsic.replace(owned.transport, Option<NativeTransport>.none())
    let publishedTransport = match move retained {
      Option.Some {value} => move value
      Option.None => unavailable<NativeTransport>()
    }
    let version = match options.alpn {
      AlpnPolicy.Http10 => Version.Http10
      AlpnPolicy.OptionalHttp11 => Version.Http11
      AlpnPolicy.RequiredHttp11 => Version.Http11
    }
    let connection = run Client.makeOwned(
      move publishedTransport,
      origin,
      version,
      limits,
      Option<Instant>.none(),
    )
    owned.connection = Option<Connection<NativeTransport>>.some(move connection)
    run checkOpeningDeadline(&deadline)
    let complete = Intrinsic.replace(owned.connection, Option<Connection<NativeTransport>>.none())
    return match move complete {
      Option.Some {value} => move value
      Option.None => unavailable<Connection<NativeTransport>>()
    }
  }
  let release = effect fn(owned: &mut OwnedPublication) -> () {
    return run releasePublication(&mut owned.*)
  }
  return run Effect.useReleaseNonParking(move guard, move use, move release)
}

/// Opens a direct TCP or HTTPS connection to `origin`, and returns it.
///
/// # Details
/// The opening deadline is the earlier of `options.deadline` and `acquisitionDeadline`. For
/// `https`, it uses `preparedTrust` and checks the certificate against `origin`. The returned
/// connection keeps no deadline. Close it, or give it to another owner such as a pool.
///
/// # Errors
/// - `NativeExchangeError.TrustRequired` if `origin` uses `https` and `preparedTrust` is none.
/// - `NativeSocketError.Timeout` if the deadline has passed.
/// - `UnsupportedDeadline` if the host of `origin` is a name and a deadline is set.
/// - `ResolverError`, `NativeSocketError`, `ConnectionError`, and `IdentityError` from resolution,
///   the socket, TLS, and the certificate check.
///
/// # Gotchas
/// Only Darwin on aarch64, and Linux with GNU libc on x86_64 or aarch64, are supported. On other
/// targets, a call fails to compile.
pub effect fn acquireOwned(
  origin: Origin,
  options: Options,
  limits: Limits,
  preparedTrust: Option<TrustSnapshot>,
  acquisitionDeadline: Option<Instant>,
) -> Connection<NativeTransport>
! NativeExchangeError | ExchangeError | ResolverError | NativeSocketError | ConnectionError | IdentityError | OutOfMemoryError
? &mut Allocator | &mut MonotonicClock | &mut SystemClock | &mut Random {
  static if (Intrinsic.targetOperatingSystem() == "windows" && Intrinsic.targetArchitecture() == "x86_64" && Intrinsic.targetAbi() == "msvc" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText(
    "libc",
  ) == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText(
    "libc",
  ) == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
    let deadline = selectOpeningDeadline(&options.deadline, &acquisitionDeadline)
    let mut openingOptions = move options
    openingOptions.deadline = copyDeadline(&deadline)
    let admitted = preflight(&origin, &openingOptions)
    if let Result.Failure {error} = move admitted {
      fail move error
    }
    if Origin.secure(&origin) && !trustPresent(&preparedTrust) {
      fail NativeExchangeError.TrustRequired
    }
    run checkOpeningDeadline(&deadline)
    let connect = run connectOptions(&openingOptions)
    let request = match move ResolveRequest.make(
      Origin.host(&origin),
      Origin.port(&origin),
      openingOptions.family,
      openingOptions.maximumAddresses,
      copyDeadline(&deadline),
    ) {
      Result.Success {value} => move value
      Result.Failure {error} => {
        fail move error
      }
    }
    let mut resolver = NativeSystemResolver.make()
    let endpoints = run Resolver.resolve(&request)
      |> Effect.provideMut<Resolver>(&mut resolver)
    let socket = run Sockets.connectResolvedOwned(
      ResolvedEndpoints.asSlice(&endpoints),
      connect,
      copyDeadline(&deadline),
    )
    return run publishOwned(
      move socket,
      origin,
      &openingOptions,
      limits,
      move preparedTrust,
      directRoute(),
      move deadline,
    )
  } else {
    compileError("Native HTTP acquisition requires a supported Windows, Darwin, or GNU libc profile")
  }
}

/// Returns a route for the Unix socket at `path`. It copies `path` and does not connect.
///
/// # Errors
/// `NativeSocketError` if `path` is too long for a socket address on the target.
pub effect fn admitUnixRoute(path: &[u8]) -> NativeRoute ! NativeSocketError {
  static if (Intrinsic.targetOperatingSystem() == "windows" && Intrinsic.targetArchitecture() == "x86_64" && Intrinsic.targetAbi() == "msvc" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText(
    "libc",
  ) == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText(
    "libc",
  ) == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
    return run unixRoute(path)
  } else {
    compileError("Native HTTP acquisition requires a supported Windows, Darwin, or GNU libc profile")
  }
}

/// Opens an HTTP or HTTPS connection to `origin` through the Unix socket at `path`, and returns it.
///
/// # Details
/// `path` selects only the socket. For `https`, it uses `preparedTrust`, and TLS checks the
/// certificate against `origin`. The opening deadline is the earlier of `options.deadline` and
/// `acquisitionDeadline`. The returned connection keeps no deadline. Close it, or give it to
/// another owner such as a pool.
///
/// # Gotchas
/// Only Darwin on aarch64, and Linux with GNU libc on x86_64 or aarch64, are supported. On other
/// targets, a call fails to compile.
pub effect fn acquireUnixOwned(
  path: &[u8],
  origin: Origin,
  options: Options,
  limits: Limits,
  preparedTrust: Option<TrustSnapshot>,
  acquisitionDeadline: Option<Instant>,
) -> Connection<NativeTransport>
! NativeExchangeError | ExchangeError | NativeSocketError | ConnectionError | IdentityError | OutOfMemoryError
? &mut Allocator | &mut MonotonicClock | &mut SystemClock | &mut Random {
  static if (Intrinsic.targetOperatingSystem() == "windows" && Intrinsic.targetArchitecture() == "x86_64" && Intrinsic.targetAbi() == "msvc" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText(
    "libc",
  ) == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText(
    "libc",
  ) == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
    let deadline = selectOpeningDeadline(&options.deadline, &acquisitionDeadline)
    let mut openingOptions = move options
    openingOptions.deadline = copyDeadline(&deadline)
    if Origin.secure(&origin) && !trustPresent(&preparedTrust) {
      fail NativeExchangeError.TrustRequired
    }
    let connect = run connectOptions(&openingOptions)
    let route = run unixRoute(path)
    run checkOpeningDeadline(&deadline)
    let socket = run Sockets.connectUnixOwned(path, connect, copyDeadline(&deadline))
    return run publishOwned(
      move socket,
      origin,
      &openingOptions,
      limits,
      move preparedTrust,
      route,
      move deadline,
    )
  } else {
    compileError("Native HTTP acquisition requires a supported Windows, Darwin, or GNU libc profile")
  }
}

struct PublishedConnection<H> {
  connection: Connection<NativeTransport>,
  handler: Option<H>,
}

effect<'env> fn withPublishedConnection<
  A,
  E,
  ?R,
  H: ConnectionHandler<NativeTransport, A, E ? R> + 'env,
  'env,
>(connection: Connection<NativeTransport>, handler: H) -> A ! E ? R {
  let lease = PublishedConnection<H> {
    connection: move connection,
    handler: Option<H>.some(move handler),
  }
  let use = effect fn(owned: &mut PublishedConnection<H>) -> A ! E ? R {
    let stored = Intrinsic.replace(owned.handler, Option<H>.none())
    let selected = match move stored {
      Option.Some {value} => move value
      Option.None => unavailable<H>()
    }
    return run ConnectionHandler<NativeTransport, A, E ? R>.handle(
      move selected,
      &mut owned.connection,
    )
  }
  let release = effect fn(owned: &mut PublishedConnection<H>) -> () {
    let closed = run Effect.result(Client.close(&mut owned.connection))
    drop closed
    return ()
  }
  return run Effect.useReleaseNonParking(move lease, move use, move release)
}

/// Opens a connection to `origin`, lends it to `handler`, and closes it after.
///
/// # Details
/// For `https`, it loads trust from the `TrustSource` service before it connects, and checks the
/// certificate against `origin`. A `Host` field never changes the identity that is checked. The
/// deadline in `options` is absolute, and each step gets it unchanged. When the handler returns or
/// fails, the connection is closed. Closing does not flush and does not send a TLS close message.
///
/// # Errors
/// - `UnsupportedDeadline` if the host of `origin` is a name and `options.deadline` is set.
/// - [`NativeExchangeError`] for options that are not valid, a deadline that cannot be honored,
///   missing trust, or a failed ALPN negotiation.
/// - `ResolverError`, `NativeSocketError`, `ConnectionError`, and `IdentityError` from resolution,
///   the socket, TLS, and the certificate check.
/// - `ExchangeError` from the HTTP connection.
/// - `TrustSourceError` if trust cannot be loaded.
/// - The error of the handler.
///
/// # Gotchas
/// Only Darwin on aarch64, and Linux with GNU libc on x86_64 or aarch64, are supported. On other
/// targets, a call fails to compile.
pub effect<'env> fn withConnection<
  A,
  E,
  ?R,
  H: ConnectionHandler<NativeTransport, A, E ? R> + 'env,
  'env,
>(origin: Origin, options: Options, limits: Limits, handler: H) -> A
! E | ExchangeError | NativeExchangeError | ResolverError | NativeSocketError | ConnectionError | IdentityError | TrustSourceError | OutOfMemoryError
? R | &mut Allocator | &mut MonotonicClock | &mut SystemClock | &mut Random | &mut TrustSource
where R in Without<R, HttpTransport> {
  let admitted = preflight(&origin, &options)
  if let Result.Failure {error} = move admitted {
    fail move error
  }
  run checkOpeningDeadline(&options.deadline)
  let trust = run prepareTrust(&origin, &options)
  let connection = run acquireOwned(
    origin,
    move options,
    limits,
    move trust,
    Option<Instant>.none(),
  )
  return run withPublishedConnection<A, E, R, H>(move connection, move handler)
}

/// Opens a connection to `origin` through the Unix socket at `path`, lends it to `handler`, and
/// closes it after.
///
/// # Details
/// `path` selects only the socket. For `https`, it loads trust from the `TrustSource` service and
/// checks the certificate against `origin`. The deadline in `options` is absolute, and each step
/// gets it unchanged. When the handler returns or fails, the connection is closed. Closing does not
/// flush and does not send a TLS close message.
///
/// # Errors
/// - [`NativeExchangeError`] for options that are not valid, a deadline that cannot be honored,
///   missing trust, or a failed ALPN negotiation.
/// - `ResolverError`, `NativeSocketError`, `ConnectionError`, and `IdentityError` from resolution,
///   the socket, TLS, and the certificate check.
/// - `TrustSourceError` if trust cannot be loaded.
/// - `ExchangeError` and the error of the handler.
///
/// # Gotchas
/// Only Darwin on aarch64, and Linux with GNU libc on x86_64 or aarch64, are supported. On other
/// targets, a call fails to compile.
pub effect<'env> fn withUnixConnection<
  A,
  E,
  ?R,
  H: ConnectionHandler<NativeTransport, A, E ? R> + 'env,
  'env,
>(path: &[u8], origin: Origin, options: Options, limits: Limits, handler: H) -> A
! E | ExchangeError | NativeExchangeError | NativeSocketError | ConnectionError | IdentityError | TrustSourceError | OutOfMemoryError
? R | &mut Allocator | &mut MonotonicClock | &mut SystemClock | &mut Random | &mut TrustSource
where R in Without<R, HttpTransport> {
  run checkOpeningDeadline(&options.deadline)
  let trust = run prepareTrust(&origin, &options)
  let connection = run acquireUnixOwned(
    path,
    origin,
    move options,
    limits,
    move trust,
    Option<Instant>.none(),
  )
  return run withPublishedConnection<A, E, R, H>(move connection, move handler)
}

struct NativeProxyClient<A, E, ?R> {
  options: Options,
  limits: Limits,
  expectedPeer: Origin,
}

impl<A, E, ?R> NativeProxyClient<A, E, R> {
  fn settings(client: &Self) -> RouteSettings {
    return proxySettings(&client.options, client.limits)
  }
  effect<'env> fn acquire<'env>(client: Self, peer: Origin, deadline: Option<Instant>) -> A
  ! E | ProxyError | NativeExchangeError | ResolverError | NativeSocketError | OutOfMemoryError
  ? R | &mut Allocator | &mut MonotonicClock | &mut AcquiredRouteContext<NativeRouteProvider, A, E ? R | &mut Allocator | &mut MonotonicClock>
  where R in Without<R, ByteDuplex>, R in Without<R, HttpTransport> {
    let NativeProxyClient<A, E, R> {options, limits, expectedPeer} = move client
    drop limits
    if !Origin.equals(&expectedPeer, &peer) {
      fail ProxyError.invalidRoute()
    }
    let provider = run acquireRouteProvider(peer, &options, &deadline)
    return run AcquiredRouteContext<
      NativeRouteProvider,
      A,
      E,
      R | &mut Allocator | &mut MonotonicClock,
    >.use(move provider)
  }
}

impl<A, E, ?R> RouteClient<NativeRouteProvider, A, E, ProxyError | NativeExchangeError | ResolverError | NativeSocketError | OutOfMemoryError, &mut Allocator | &mut MonotonicClock ? R | &mut Allocator | &mut MonotonicClock> for NativeProxyClient<
  A,
  E,
  R,
> {
  settings: NativeProxyClient.settings
  acquire: NativeProxyClient.acquire
}

/// Connects through `route`, lends the connection to `handler`, and closes it after.
///
/// # Details
/// It connects only to the peer that the route selects: the origin for `Direct`, or the proxy for
/// `Forward` and `Tunnel`. For `Tunnel`, it sends `CONNECT`, then does TLS with the origin through
/// the tunnel. `options.deadline` is used unchanged for all steps. `limits` applies to the HTTP
/// connection and to the `CONNECT` exchange.
///
/// # Errors
/// - `ProxyError` if the proxy rejects `CONNECT`, or the route is not valid.
/// - `NativeExchangeError.TrustRequired` if the origin uses `https` and `preparedTrust` is none.
/// - The errors of resolution, the socket, TLS, and the handler.
pub effect<'env> fn withProxyRoute<
  'configuration,
  A,
  E,
  ?R,
  H: RouteHandler<'configuration, NativeRouteProvider, A, E ? R> + 'env,
  'env,
>(
  route: Route<'configuration>,
  options: Options,
  limits: Limits,
  preparedTrust: Option<TrustSnapshot>,
  handler: H,
) -> A
! E | ProxyError | ExchangeError | NativeExchangeError | ResolverError | NativeSocketError | ConnectionError | IdentityError | OutOfMemoryError
? R | &mut Allocator | &mut MonotonicClock | &mut SystemClock | &mut Random
where R in Without<R, ByteDuplex>, R in Without<R, HttpTransport> {
  let expectedPeer = match move proxyPeer(&route) {
    Result.Success {value} => value
    Result.Failure {error} => {
      fail move error
    }
  }
  let deadline = copyDeadline(&options.deadline)
  let client = NativeProxyClient<
    A,
    E | ProxyError | ExchangeError | ConnectionError | IdentityError | OutOfMemoryError,
    R | &mut Allocator | &mut MonotonicClock | &mut SystemClock | &mut Random,
  > {options: move options, limits: limits, expectedPeer: expectedPeer}
  return run withRoute<
    'configuration,
    NativeRouteProvider,
    A,
    E,
    ProxyError | NativeExchangeError | ResolverError | NativeSocketError | OutOfMemoryError,
    R,
    &mut Allocator | &mut MonotonicClock,
  >(move client, route, move preparedTrust, move deadline, move handler)
}

effect fn acquireRouteProvider(peer: Origin, options: &Options, deadline: &Option<Instant>) -> NativeRouteProvider
! NativeExchangeError | ResolverError | NativeSocketError | OutOfMemoryError
? &mut Allocator | &mut MonotonicClock {
  let admitted = preflightDeadline(&peer, deadline)
  if let Result.Failure {error} = move admitted {
    fail move error
  }
  let connect = run connectOptions(options)
  let request: ResolveRequest = match move ResolveRequest.make(
    Origin.host(&peer),
    Origin.port(&peer),
    options.family,
    options.maximumAddresses,
    copyDeadline(deadline),
  ) {
    Result.Success {value} => move value
    Result.Failure {error} => {
      fail move error
    }
  }
  let mut resolver = NativeSystemResolver.make()
  let endpoints = run Resolver.resolve(&request)
    |> Effect.provideMut<Resolver>(&mut resolver)
  let connection = run Sockets.connectResolvedOwned(
    ResolvedEndpoints.asSlice(&endpoints),
    connect,
    copyDeadline(deadline),
  )
  return NativeRouteProvider {connection: move connection, terminal: false}
}

effect fn unixRoute(path: &[u8]) -> NativeRoute ! NativeSocketError {
  let mut limit: usize = 107
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    limit = 103
  }
  if path.length > limit {
    fail NativeSocketError.PathTooLong {length: path.length, limit: limit}
  }
  let mut route = directRoute()
  route.unix = true
  route.length = path.length
  let mut index = usize.ZERO
  while index < path.length {
    route.bytes[index] = path[index]
    index = index + usize.ONE
  }
  return route
}

effect fn connectOptions(options: &Options) -> ConnectOptions ! NativeExchangeError {
  return match move ConnectOptions.make(
    options.noDelay,
    options.pollIntervalNanoseconds,
    options.maximumAttempts,
  ) {
    Result.Success {value} => value
    Result.Failure {error} => {
      drop error
      fail NativeExchangeError.InvalidConnectOptions
    }
  }
}

