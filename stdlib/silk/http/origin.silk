//! The origin of an HTTP request: the scheme, host, and port that a connection goes to.
//!
//! # When to use
//! Use [`Origin.fromUri`] to get the origin of a URL. The client connects to the host and port of
//! the origin, and for HTTPS checks the server certificate against the host. Use
//! [`Origin.authorityInto`] to write the `Host` value.
//!
//! # Details
//! An `Origin` has no path, and does not allocate. A missing port becomes 80 for `http` and 443 for
//! `https`. [`Origin.authorityInto`] writes a lowercase domain, the canonical IP text, and the port
//! only when it is not the default. A `Host` field that you give never changes the host that TLS
//! checks.
//!
//! # Errors
//! - [`OriginError`] if the scheme is not `http` or `https`, the URI has user information, or the
//!   host or port is not valid.
//!
//! # Examples
//! ## Get the origin of a URL
//! ```silk
//! import silk.http.origin { Origin, OriginError }
//! import silk.net.address { Port }
//! import silk.core.result { Result }
//! import silk.uri.uri { Uri }
//! import silk.uri.reference { ParseError }
//!
//! pub fn main() -> i32 {
//!   let uri = match Uri.parse("https://Example.COM/docs?page=2") {
//!     Result<Uri, ParseError>.Success { value } => value
//!     Result<Uri, ParseError>.Failure { error: _ } => {
//!       return 1
//!     }
//!   }
//!   let origin = match Origin.fromUri(&uri) {
//!     Result<Origin, OriginError>.Success { value } => value
//!     Result<Origin, OriginError>.Failure { error: _ } => {
//!       return 1
//!     }
//!   }
//!   if !Origin.secure(&origin) || Port.value(&Origin.port(&origin)) != 443 {
//!     return 1
//!   }
//!
//!   // The default port is not written, and the domain is lowercase.
//!   let mut output: [u8; 64] = [0; 64]
//!   let length = match Origin.authorityInto(&origin, &mut output) {
//!     Result<usize, OriginError>.Success { value } => value
//!     Result<usize, OriginError>.Failure { error: _ } => {
//!       return 1
//!     }
//!   }
//!   if length != 11 || output[0] != 101 {
//!     return 1
//!   }
//!   if !Origin.matchesAuthority(&origin, "example.com:443") {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category HTTP

import silk.format {Debug, Format, Formatter}
import silk.net.address {Host, DomainHost, Ipv4Address, Ipv6Address, Port, AddressError}
import silk.option {Option}
import silk.core.ownership {Copy}
import silk.core.result {Result}
import silk.collections.slice {Slice}
import silk.text.string {String}
import silk.uri.uri {Uri}
import silk.num.u8
import silk.num.u16
import silk.num.usize
import silk.io.writer {Writer, WriterError}

/// The reason that an origin is not valid, or that its text does not fit: the scheme is not `http`
/// or `https`, the URI has user information, the host or port is not valid, or the output is too
/// small.
pub enum OriginError {
  /// The scheme is not `http` or `https`.
  InvalidScheme,
  /// The URI has user information, as in `user@host`.
  UserInfo,
  /// The URI has no host.
  MissingHost,
  /// The host is not a valid domain name or IP address. See `Host.parse` in `silk.net.address`.
  InvalidHost,
  /// The port is empty, not a number, or not from 1 to 65535.
  InvalidPort,
  /// The output buffer is too small. Nothing was written.
  OutputTooSmall,
}

impl Debug for OriginError {
  /// Writes the name of the variant, such as `InvalidScheme`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      OriginError.InvalidScheme => run Format.write(&mut formatter, b"InvalidScheme")
      OriginError.UserInfo => run Format.write(&mut formatter, b"UserInfo")
      OriginError.MissingHost => run Format.write(&mut formatter, b"MissingHost")
      OriginError.InvalidHost => run Format.write(&mut formatter, b"InvalidHost")
      OriginError.InvalidPort => run Format.write(&mut formatter, b"InvalidPort")
      OriginError.OutputTooSmall => run Format.write(&mut formatter, b"OutputTooSmall")
    }
  }
}

/// The scheme, host, and port of an HTTP server. Make it with [`Origin.fromUri`] or
/// [`Origin.make`].
pub struct Origin {
  hostValue: Host,
  portValue: Port,
  secureValue: bool,
}

impl Copy for Origin {}

impl Origin {
  /// Returns the origin for `host` and `port`. `secure` selects HTTPS. Port 0 returns
  /// `InvalidPort`.
  pub fn make(host: Host, port: Port, secure: bool) -> Result<Origin, OriginError> {
    if Port.value(&port) == 0 {
      return Result<Origin, OriginError>.failResult(OriginError.InvalidPort)
    }
    return Result<Origin, OriginError>.succeed(Origin {
      hostValue: host,
      portValue: port,
      secureValue: secure,
    })
  }

  /// Returns the origin of an `http` or `https` URI.
  ///
  /// # Details
  /// A missing port becomes 80 for `http` and 443 for `https`. The path, query, and fragment are
  /// ignored. User information returns `UserInfo`.
  pub fn fromUri(uri: &Uri) -> Result<Origin, OriginError> {
    let scheme = String.utf8Bytes(Uri.scheme(uri))
    let secure = foldedEqual(scheme, b"https")
    if !secure && !foldedEqual(scheme, b"http") {
      return Result<Origin, OriginError>.failResult(OriginError.InvalidScheme)
    }
    let checked1 = Uri.userinfo(uri)
    match move checked1 {
      Option<string>.Some {value} => {
        return Result<Origin, OriginError>.failResult(OriginError.UserInfo)
      }
      Option<string>.None => {}
    }
    let checked2 = Uri.host(uri)
    let text = match move checked2 {
      Option<string>.Some {value} => value
      Option<string>.None => {
        return Result<Origin, OriginError>.failResult(OriginError.MissingHost)
      }
    }
    let checked3 = Host.parse(text)
    let host = match move checked3 {
      Result<Host, AddressError>.Success {value} => value
      Result<Host, AddressError>.Failure {error} => {
        return Result<Origin, OriginError>.failResult(OriginError.InvalidHost)
      }
    }
    let mut defaultPort: usize = 80
    if secure {
      defaultPort = 443
    }
    let mut selectedPort = defaultPort
    let portOption = Uri.port(uri)
    match move portOption {
      Option<string>.Some {value: portText} => {
        let parsedPort = parsePort(String.utf8Bytes(portText))
        match move parsedPort {
          Result<Port, OriginError>.Success {value: admittedPort} => {
            selectedPort = u16.toUsize(Port.value(&admittedPort))
          }
          Result<Port, OriginError>.Failure {error} => {
            return Result<Origin, OriginError>.failResult(move error)
          }
        }
      }
      Option<string>.None => {}
    }
    let madePort = Port.make(selectedPort)
    let port = match move madePort {
      Result<Port, AddressError>.Success {value} => value
      Result<Port, AddressError>.Failure {error} => {
        return Result<Origin, OriginError>.failResult(OriginError.InvalidPort)
      }
    }
    return Result<Origin, OriginError>.succeed(
      Origin {hostValue: host, portValue: port, secureValue: secure},
    )
  }
  /// Returns the host. The client resolves it, and TLS checks the certificate against it.
  pub fn host(self: &Self) -> Host {
    return self.hostValue
  }
  /// Returns the port, with the default port if the URI had none.
  pub fn port(self: &Self) -> Port {
    return self.portValue
  }
  /// Returns `true` for HTTPS.
  pub fn secure(self: &Self) -> bool {
    return self.secureValue
  }
  /// Returns `true` if the scheme, the port, and the host are equal. Domains are compared without
  /// case.
  pub fn equals(self: &Self, other: &Self) -> bool {
    return self.secureValue == other.secureValue && Port.value(&self.portValue) == Port.value(
      &other.portValue,
    ) && hostsEqual(&self.hostValue, &other.hostValue)
  }
  /// Writes `host` or `host:port` to the start of `output`, and returns the length. The port is
  /// written only when it is not the default. If `output` is too small, it writes nothing.
  pub fn authorityInto(self: &Self, output: &mut [u8]) -> Result<usize, OriginError> {
    let mut scratch: [u8; 261] = [
      0,
      0,
      0,
      0,
