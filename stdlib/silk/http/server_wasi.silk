//! HTTP requests delivered to a WASI Preview 2 component.
//!
//! # When to use
//! Export the canonical `wasi:http/incoming-handler@0.2.12#handle` function from a component
//! with the `wasi:http/incoming-handler` WIT interface. Transfer its two handles to
//! `Exchange.take`, then read the request and send one response. The host owns listening,
//! transport, TLS, and HTTP framing. Provide `Allocator` and `MonotonicClock` to body operations.
//!
//! # Details
//! Request metadata is copied into owned values. Bodies are bounded by the caller's limit and
//! deadline. A response is submitted before its body is written, so host backpressure can advance.
//! Dropping an unanswered exchange releases both handles; the host treats it as a failed request.
//!
//! @category HTTP

static if Intrinsic.profileText("target") == "wasm32-wasip2" {
  import silk.platform.wasi.preview2 as host
  import silk.platform.wasi.component as abi { ResultArea }
  import silk.platform.wasi.http as wasi { Resource, ResourceKind, Field }
  import silk.mem.allocator { Allocator, OutOfMemoryError }
  import silk.collections.bytes { Bytes }
  import silk.http.client { HttpError, HttpErrorKind }
  import silk.collections.list { List }
  import silk.system.monotonic_clock { MonotonicClock }
  import silk.core.option { Option }
  import silk.core.ownership { Drop }
  import silk.mem.pointer { Pointer }
  import silk.core.result { Result }
  import silk.text.string { String, InvalidUtf8 }
  import silk.system.system_clock { Instant }
  import silk.num.u16
  import silk.num.u32

  /// An owned snapshot of request metadata. Field order, duplicates, and raw field values survive.
  pub struct Request {
    /// The case-sensitive HTTP method.
    pub method: String,
    /// The path and optional query supplied by the host, absent when the request has neither.
    pub pathWithQuery: Option<String>,
    /// The request scheme, when supplied by the host.
    pub scheme: Option<String>,
    /// The request authority, when supplied by the host.
    pub authority: Option<String>,
    /// The request's fields in host order.
    pub fields: List<Field>,
  }

  /// Owns one incoming request and its response out-parameter. Responding consumes this value.
  pub struct Exchange { request: Resource, response: Resource }

  unsafe extern "C" fn free(pointer: ?[*]const u8) -> ()
  extern "C" struct TextResult { tag: u32, pointer: ?[*]mut u8, length: u32 }
  impl TextResult {
    fn make() -> TextResult {
      return TextResult {tag: 0, pointer: unsafe Intrinsic.pointerRequalify<?*mut u8, ?[*]mut u8>(Pointer.null<u8>()), length: 0}
    }
    effect fn copy(self: &Self) -> String ! HttpError | OutOfMemoryError ? &mut Allocator {
      let mut bytes = Bytes.make()
      unsafe { bytes = run wasi.copyBytes(self.pointer, self.length) }
      return match move String.fromBytes(move bytes) {
        Result<String, InvalidUtf8>.Success {value} => move value
        Result<String, InvalidUtf8>.Failure {error: _} => { fail wasi.protocol("HTTP metadata is not UTF-8") }
      }
    }
    effect fn optional(self: &Self) -> Option<String> ! HttpError | OutOfMemoryError ? &mut Allocator {
      if self.tag == 0 { return Option<String>.none() }
      return Option<String>.some(run TextResult.copy(self))
    }
  }
  impl Drop for TextResult {
    fn drop(self: &mut Self) -> () { if self.length > 0 { unsafe free(self.pointer) } }
  }
  extern "C" struct SchemeResult { present: u32, scheme: TextResult }

  impl Exchange {
    /// Takes the incoming-request and response-outparam handles passed to the WIT `handle` export.
    /// Both handles must be live, unborrowed, and uniquely owned; the caller gives up ownership.
    pub unsafe fn take(request: u32, response: u32) -> Exchange {
      return Exchange {request: unsafe Resource.take(request, ResourceKind.IncomingRequest),
        response: unsafe Resource.take(response, ResourceKind.ResponseOut)}
    }

    /// Copies the request method, optional URL parts, and fields. It does not consume the body.
    pub effect fn metadata(self: &Self) -> Request ! HttpError | OutOfMemoryError ? &mut Allocator {
      unsafe {
        let handle = Resource.handle(&self.request)
        let mut method = TextResult.make()
        host.http_types_incoming_request_method(handle, abi.address(&mut method))
        let mut verb = String.make()
        if method.tag == 9 { verb = run TextResult.copy(&method) }
        else {
          let methods = ["GET", "HEAD", "POST", "PUT", "DELETE", "CONNECT", "OPTIONS", "TRACE", "PATCH"]
          if method.tag > 8 { fail wasi.protocol("Invalid host HTTP method") }
          verb = run String.copy(methods[u32.toUsize(method.tag)])
        }
        let mut path = TextResult.make()
        host.http_types_incoming_request_path_with_query(handle, abi.address(&mut path))
        let mut authority = TextResult.make()
        host.http_types_incoming_request_authority(handle, abi.address(&mut authority))
        let mut scheme = SchemeResult {present: 0, scheme: TextResult.make()}
        host.http_types_incoming_request_scheme(handle, abi.address(&mut scheme))
        let mut schemeText = Option<String>.none()
        if scheme.present != 0 {
          if scheme.scheme.tag == 0 { schemeText = Option<String>.some(run String.copy("http")) }
          else if scheme.scheme.tag == 1 { schemeText = Option<String>.some(run String.copy("https")) }
          else { schemeText = Option<String>.some(run TextResult.copy(&scheme.scheme)) }
        }
        let fields = Resource.take(host.http_types_incoming_request_headers(handle), ResourceKind.Fields)
        return Request {method: move verb, pathWithQuery: run TextResult.optional(&path),
          scheme: move schemeText, authority: run TextResult.optional(&authority),
          fields: run wasi.readFields(Resource.handle(&fields))}
      }
    }

    /// Reads the request body once, enforcing the byte limit and absolute monotonic deadline.
    /// A second call fails. Dropping a failed read releases its body and stream resources.
    pub effect fn readBody(self: &mut Self, maximum: usize, deadline: Option<Instant>) -> Bytes
      ! HttpError | OutOfMemoryError ? &mut Allocator | &mut MonotonicClock {
      if run abi.expired(&deadline) { fail HttpError.make(HttpErrorKind.Timeout, "HTTP deadline expired") }
      unsafe {
        let mut result = ResultArea.make()
        host.http_types_incoming_request_consume(Resource.handle(&self.request), abi.address(&mut result))
        if ResultArea.byte(&result, 0) != 0 { fail wasi.protocol("HTTP request body was already consumed") }
        return run wasi.readBody(Resource.take(ResultArea.word32(&result, 4), ResourceKind.IncomingBody), maximum, &deadline)
      }
    }

    /// Sends a response with ordered fields and a complete body, consuming this exchange.
    /// The host validates status and field restrictions. Failure before submission drops the
    /// out-parameter; failure after submission terminates the response body.
    pub effect fn respond(self: Self, status: u16, fields: &[Field], body: &[u8], deadline: Option<Instant>) -> ()
      ! HttpError ? &mut MonotonicClock {
      let mut exchange = move self
      if run abi.expired(&deadline) { fail HttpError.make(HttpErrorKind.Timeout, "HTTP deadline expired") }
      unsafe {
        let mut headers = Resource.take(host.http_types_new_fields(), ResourceKind.Fields)
        let mut at: usize = 0
        while at < fields.length {
          run wasi.appendField(Resource.handle(&headers), String.view(&fields[at].name), Bytes.asSlice(&fields[at].value))
          at = at + 1
        }
        let mut response = Resource.take(host.http_types_new_outgoing_response(Resource.release(&mut headers)), ResourceKind.OutgoingResponse)
        if host.http_types_outgoing_response_set_status_code(Resource.handle(&response), u16.toU32(status)) != 0 {
          fail HttpError.make(HttpErrorKind.InvalidRequest, "Invalid HTTP response status")
        }
        let mut result = ResultArea.make()
        host.http_types_outgoing_response_body(Resource.handle(&response), abi.address(&mut result))
        if ResultArea.byte(&result, 0) != 0 { fail wasi.protocol("HTTP response body was already taken") }
        let outgoing = Resource.take(ResultArea.word32(&result, 4), ResourceKind.OutgoingBody)
        host.http_types_response_outparam_set(Resource.release(&mut exchange.response), 0,
          Resource.release(&mut response), 0, 0, 0, 0, 0, 0)
        run wasi.writeBody(move outgoing, body, &deadline)
      }
    }
  }
}
