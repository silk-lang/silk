//! Accepts native socket connections and serves each one with `silk.http.server`.
//!
//! # When to use
//! Make a listener with `silk.net.socket_native`, then call [`serveNext`] in a loop. Each call accepts
//! one connection and serves it with your `ConnectionHandler` until the handler returns.
//!
//! # Details
//! [`serveNext`] serves one connection at a time, on the calling task. This module has no queue,
//! router, supervisor, or background task. To serve connections at the same time, start tasks
//! yourself.
//!
//! # Errors
//! - `NativeSocketError` if the accept fails or the deadline passes.
//! - `ServerError`, `BufferError`, and `OutOfMemoryError` from `silk.http.server`.
//! - The error of the handler.
//!
//! # Gotchas
//! The whole module exists only on Darwin on aarch64, and on Linux with GNU libc on x86_64 or
//! aarch64. On other targets, an import from it fails to compile.
//!
//! @category HTTP

static if (Intrinsic.targetOperatingSystem() == "darwin"
  && Intrinsic.targetArchitecture() == "aarch64"
  && Intrinsic.targetAbi() == "apple"
  && Intrinsic.profileText("libc") == "system")
  || (Intrinsic.targetOperatingSystem() == "linux"
    && Intrinsic.targetAbi() == "gnu"
    && Intrinsic.profileText("libc") == "gnu"
    && (Intrinsic.targetArchitecture() == "aarch64"
      || Intrinsic.targetArchitecture() == "x86_64")) {
  import silk.mem.allocator {Allocator, OutOfMemoryError}
  import silk.io.buffered_input {BufferError}
  import silk.io.byte_duplex {ByteDuplex}
  import silk.core.effect {Effect}
  import silk.http.server {
    ConnectionHandler,
    Limits,
    ServerError,
    withConnection,
  }
  import silk.system.monotonic_clock {MonotonicClock}
  import silk.net.socket_native {
    AcceptedContext,
    AcceptedView,
    Connection as NativeConnection,
    Listener,
    NativeSocketError,
    accept,
    withAcceptedContext,
  }
  import silk.system.system_clock {Instant}
  import silk.core.option {Option}

  /// An empty marker type for this module.
  pub struct HttpServerNative {}

  struct ServerAcceptedContext<A, E, ?HandlerRequirements, H> {
    limits: Limits,
    handler: H,
  }

  impl<A, E, ?HandlerRequirements, OuterH>
    ServerAcceptedContext<A, E, HandlerRequirements, OuterH> {
    effect<'call> fn use<
      'call,
      H: ConnectionHandler<NativeConnection, A, E ? HandlerRequirements>,
    >(
      context: ServerAcceptedContext<A, E, HandlerRequirements, H>,
      view: &'call mut AcceptedView<'call>,
    ) -> A
    ! E | ServerError | BufferError | OutOfMemoryError
    ? HandlerRequirements | &mut Allocator | &mut MonotonicClock
    where HandlerRequirements in Without<HandlerRequirements, ByteDuplex> {
      let ServerAcceptedContext<A, E, HandlerRequirements, H> {limits, handler} = move context
      return run withConnection<A, E, HandlerRequirements, NativeConnection>(
        &mut view.connection.*,
        limits,
        move handler,
      )
    }
  }

  impl<
    A,
    E,
    ?HandlerRequirements,
    H: ConnectionHandler<NativeConnection, A, E ? HandlerRequirements>,
  > AcceptedContext<
    A,
    E | ServerError | BufferError | OutOfMemoryError,
    HandlerRequirements
    ? &mut Allocator | &mut MonotonicClock
  > for ServerAcceptedContext<A, E, HandlerRequirements, H>
  where HandlerRequirements in Without<HandlerRequirements, ByteDuplex> {
    use: ServerAcceptedContext.use
  }

  /// Accepts one connection from `listener`, and serves it with `handler`.
  ///
  /// # Details
  /// The accept waits until `acceptDeadline`, or with no limit if it is `None`. Then it calls
  /// `withConnection` of `silk.http.server` with `limits`. The socket is closed when the handler
  /// returns or fails. Call it in a loop. It serves one connection at a time, on the calling task,
  /// with no queue, router, supervisor, or background task. To serve connections at the same time,
  /// start tasks yourself.
  ///
  /// # Errors
  /// - `NativeSocketError` if the accept fails or the deadline passes.
  /// - `ServerError`, `BufferError`, and `OutOfMemoryError` from `silk.http.server`.
  /// - The error of the handler.
  ///
  /// # Gotchas
  /// It exists only on Darwin on aarch64, and on Linux with GNU libc on x86_64 or aarch64.
  pub effect<'env> fn serveNext<
    'listener,
    A,
    E,
    ?HandlerRequirements,
    H: ConnectionHandler<NativeConnection, A, E ? HandlerRequirements> + 'env,
    'env,
  >(
    listener: &'listener mut Listener,
    limits: Limits,
    acceptDeadline: Option<Instant>,
    handler: H,
  ) -> A
  ! E | NativeSocketError | ServerError | BufferError | OutOfMemoryError
  ? HandlerRequirements | &mut Allocator | &mut MonotonicClock
  where HandlerRequirements in Without<HandlerRequirements, ByteDuplex> {
    let accepted = run accept(move listener, move acceptDeadline)
    let context = ServerAcceptedContext<A, E, HandlerRequirements, H> {
      limits: limits,
      handler: move handler,
    }
    return run withAcceptedContext<
      A,
      E | ServerError | BufferError | OutOfMemoryError,
      HandlerRequirements,
    >(move accepted, move context)
  }
}
