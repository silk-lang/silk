//! HTTP/1.0 and HTTP/1.1 values: versions, methods, statuses, header fields, and message heads.
//!
//! # When to use
//! Use these types to make or inspect an HTTP message head. `silk.http.head` parses and writes
//! them, and the client and server modules take them. Each `make` and `parse` function checks the
//! value. The values borrow their text. Call `copy` on a head to keep it after its input is gone.
//!
//! # Details
//! A [`Method`] is any valid token, and keeps its spelling, so `get` and `GET` are different. A
//! [`Status`] is any code from 100 to 599. A [`Header`] keeps the exact bytes of its name and
//! value. [`RequestHead.make`] checks that the target form fits the method, and that an HTTP/1.1
//! request has one `Host` field. This module does not read or write bodies.
//!
//! # Errors
//! - [`ValueError`] tells which rule failed in [`ValueError.reason`], in which part in
//!   [`ValueError.component`], and where, in [`ValueError.fieldIndex`] and [`ValueError.offset`].
//!
//! # Gotchas
//! [`Header.make`] takes the value without the spaces around it on the wire. It rejects CR, LF,
//! NUL, DEL, other control bytes, and leading or trailing spaces or tabs.
//!
//! # Examples
//! ## Make a response head
//! ```silk
//! import silk.http.message { Header, ResponseHead, Status, StatusClass, ValueError, Version }
//! import silk.http.headers { Headers, Limits }
//! import silk.core.option { Option }
//! import silk.core.result { Result }
//!
//! fn limits() -> Limits {
//!   return Limits {
//!     maxMethodBytes: 64,
//!     maxTargetBytes: 8192,
//!     maxNameBytes: 256,
//!     maxValueBytes: 8192,
//!     maxFields: 128,
//!     maxFieldBytes: 65536,
//!     maxOwnedBytes: 131072,
//!   }
//! }
//!
//! pub fn main() -> i32 {
//!   let status = match Status.fromCode(404) {
//!     Result<Status, ValueError>.Success { value } => value
//!     Result<Status, ValueError>.Failure { error: _ } => {
//!       return 1
//!     }
//!   }
//!   if Status.class(&status) != StatusClass.ClientError {
//!     return 1
//!   }
//!   let header = match Header.make("Content-Type", b"text/plain", limits()) {
//!     Result<Header, ValueError>.Success { value } => value
//!     Result<Header, ValueError>.Failure { error: _ } => {
//!       return 1
//!     }
//!   }
//!   let entries = [header]
//!   let headers = match Headers.make(&entries, limits()) {
//!     Result<Headers, ValueError>.Success { value } => value
//!     Result<Headers, ValueError>.Failure { error: _ } => {
//!       return 1
//!     }
//!   }
//!   let reason = b"Not Found"
//!   let head = match ResponseHead.make(
//!     Version.Http11,
//!     status,
//!     Option<&[u8]>.some(&reason),
//!     headers,
//!     limits(),
//!   ) {
//!     Result<ResponseHead, ValueError>.Success { value } => move value
//!     Result<ResponseHead, ValueError>.Failure { error: _ } => {
//!       return 1
//!     }
//!   }
//!   if Status.code(&ResponseHead.status(&head)) != 404 {
//!     return 1
//!   }
//!
//!   // A value with a line break fails.
//!   let bad = match Header.make("X-Note", b"a\r\nb", limits()) {
//!     Result<Header, ValueError>.Success { value: _ } => false
//!     Result<Header, ValueError>.Failure { error } => error.offset == 1
//!   }
//!   if !bad {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category HTTP

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.text.format { Debug, Format, Formatter }
import silk.http.headers { Headers, Limits, OwnedHeaders }
import silk.http.target { HttpAuthority, RequestTarget, validateRequestHost }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.text.string { String }
import silk.num.u16
import silk.num.u8
import silk.num.usize
import silk.io.writer { Writer, WriterError }

/// The part of an HTTP value that failed a check. See [`ValueError.component`].
pub enum ValueComponent {
  /// An HTTP version token.
  Version,
  /// A request method token.
  Method,
  /// A numeric response status.
  Status,
  /// A field name.
  HeaderName,
  /// A field value.
  HeaderValue,
  /// An optional response reason phrase.
  ReasonPhrase,
  /// A list of header fields.
  Headers,
  /// A request target.
  Target,
  /// An HTTP authority.
  Authority,
  /// The `Host` field of a request.
  Host,
  /// A list in a field such as `Connection`, `Content-Encoding`, or `Transfer-Encoding`.
  Metadata,
}

impl Debug for ValueComponent {
  /// Writes the name of the variant, such as `Version`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      ValueComponent.Version => run Format.write(&mut formatter, b"Version")
      ValueComponent.Method => run Format.write(&mut formatter, b"Method")
      ValueComponent.Status => run Format.write(&mut formatter, b"Status")
      ValueComponent.HeaderName => run Format.write(&mut formatter, b"HeaderName")
      ValueComponent.HeaderValue => run Format.write(&mut formatter, b"HeaderValue")
      ValueComponent.ReasonPhrase => run Format.write(&mut formatter, b"ReasonPhrase")
      ValueComponent.Headers => run Format.write(&mut formatter, b"Headers")
      ValueComponent.Target => run Format.write(&mut formatter, b"Target")
      ValueComponent.Authority => run Format.write(&mut formatter, b"Authority")
      ValueComponent.Host => run Format.write(&mut formatter, b"Host")
      ValueComponent.Metadata => run Format.write(&mut formatter, b"Metadata")
    }
  }
}

/// The limit in [`Limits`] that a value exceeded. See [`ValueReason.LimitExceeded`].
pub enum LimitKind {
  /// `maxMethodBytes`: the length of a method.
  MethodBytes,
  /// `maxTargetBytes`: the length of a request target.
  TargetBytes,
  /// `maxNameBytes`: the length of a field name.
  NameBytes,
  /// `maxValueBytes`: the length of a field value or a reason phrase.
  ValueBytes,
  /// `maxFields`: the number of fields.
  Fields,
  /// `maxFieldBytes`: the total length of all names and values.
  FieldBytes,
  /// `maxOwnedBytes`: the memory for a copy.
  OwnedBytes,
  /// A field must occur at most one time, but it occurred more times.
  UniqueField,
}

impl Debug for LimitKind {
  /// Writes the name of the variant, such as `MethodBytes`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      LimitKind.MethodBytes => run Format.write(&mut formatter, b"MethodBytes")
      LimitKind.TargetBytes => run Format.write(&mut formatter, b"TargetBytes")
      LimitKind.NameBytes => run Format.write(&mut formatter, b"NameBytes")
      LimitKind.ValueBytes => run Format.write(&mut formatter, b"ValueBytes")
      LimitKind.Fields => run Format.write(&mut formatter, b"Fields")
      LimitKind.FieldBytes => run Format.write(&mut formatter, b"FieldBytes")
      LimitKind.OwnedBytes => run Format.write(&mut formatter, b"OwnedBytes")
      LimitKind.UniqueField => run Format.write(&mut formatter, b"UniqueField")
    }
  }
}

/// The rule that failed. See [`ValueError.reason`].
pub union ValueReason {
  /// A token, such as a method or a field name, is empty or has a byte that is not allowed in a
  /// token.
  InvalidToken,
  /// A value has a byte that is not allowed, such as CR, LF, or NUL.
  InvalidValueByte,
  /// A version is not HTTP/1.0 or HTTP/1.1.
  UnsupportedVersion,
  /// A response code is outside 100 through 599.
  InvalidStatus,
  /// A request target has invalid syntax.
  InvalidTarget,
  /// An HTTP authority has invalid syntax.
  InvalidAuthority,
  /// A port is absent, empty, nonnumeric, or outside its accepted range.
  InvalidPort,
  /// The target form does not fit the method. For example, `CONNECT` needs `host:port`, and only
  /// `OPTIONS` can use `*`.
  MethodTargetMismatch,
  /// HTTP/1.1 has no Host field.
  MissingHost,
  /// More than one Host field is present.
  DuplicateHost,
  /// A value exceeded a limit in [`Limits`].
  LimitExceeded {
    /// The limit that was exceeded.
    pub limit: LimitKind,
    /// The value of the limit.
    pub allowed: usize,
    /// The size that was found.
    pub attempted: usize,
  },
  /// A size calculation overflowed `usize`.
  SizeOverflow,
  /// The output buffer is too small. Nothing was written.
  OutputTooSmall {
    /// The number of bytes that the output needs.
    pub required: usize,
    /// The length of the buffer that you gave.
    pub available: usize,
  },
}

impl Copy for ValueReason {}

impl Debug for ValueReason {
  /// Writes the name of the variant and its fields, such as `InvalidToken`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      ValueReason.InvalidToken => run Format.write(&mut formatter, b"InvalidToken")
      ValueReason.InvalidValueByte => run Format.write(&mut formatter, b"InvalidValueByte")
      ValueReason.UnsupportedVersion => run Format.write(&mut formatter, b"UnsupportedVersion")
      ValueReason.InvalidStatus => run Format.write(&mut formatter, b"InvalidStatus")
      ValueReason.InvalidTarget => run Format.write(&mut formatter, b"InvalidTarget")
      ValueReason.InvalidAuthority => run Format.write(&mut formatter, b"InvalidAuthority")
      ValueReason.InvalidPort => run Format.write(&mut formatter, b"InvalidPort")
      ValueReason.MethodTargetMismatch => run Format.write(&mut formatter, b"MethodTargetMismatch")
      ValueReason.MissingHost => run Format.write(&mut formatter, b"MissingHost")
      ValueReason.DuplicateHost => run Format.write(&mut formatter, b"DuplicateHost")
      ValueReason.LimitExceeded { limit, allowed, attempted } => {
        let mut record = run Format.debugRecord("LimitExceeded", &mut formatter)
        run Format.debugField(&mut record, "limit", &limit, &mut formatter)
        run Format.debugField(&mut record, "allowed", &allowed, &mut formatter)
        run Format.debugField(&mut record, "attempted", &attempted, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      ValueReason.SizeOverflow => run Format.write(&mut formatter, b"SizeOverflow")
      ValueReason.OutputTooSmall { required, available } => {
        let mut record = run Format.debugRecord("OutputTooSmall", &mut formatter)
        run Format.debugField(&mut record, "required", &required, &mut formatter)
        run Format.debugField(&mut record, "available", &available, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
    }
  }
}

/// The error from checking an HTTP value. It tells which rule failed, and where.
///
/// # Details
///
/// `reason` gives the rule, `component` the part of the value, and `fieldIndex` and `offset` the
/// position.
pub struct ValueError {
  /// The rule that failed.
  pub reason: ValueReason,
  /// The part that failed.
  pub component: ValueComponent,
  /// The position of the field in its list, from 0, when the error is in a field.
  pub fieldIndex: Option<usize>,
  /// The byte offset in the part where the rule failed.
  pub offset: usize,
}

impl Debug for ValueError {
  /// Writes the fields, as `ValueError { reason: ..., component: ..., ... }`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return run Format.debugFields(self, "ValueError", &mut formatter)
  }
}

/// An HTTP version that this module supports.
pub enum Version {
  /// HTTP/1.0.
  Http10,
  /// HTTP/1.1.
  Http11,
}

impl Debug for Version {
  /// Writes the name of the variant, such as `Http10`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      Version.Http10 => run Format.write(&mut formatter, b"Http10")
      Version.Http11 => run Format.write(&mut formatter, b"Http11")
    }
  }
}

impl Version {
  /// Parses exactly `HTTP/1.0` or `HTTP/1.1`.
  pub fn parse(text: string) -> Result<Version, ValueError> {
    if text == "HTTP/1.0" {
      return Result<Version, ValueError>.succeed(Version.Http10)
    }
    if text == "HTTP/1.1" {
      return Result<Version, ValueError>.succeed(Version.Http11)
    }
    return Result<Version, ValueError>.failResult(failure(
      ValueReason.UnsupportedVersion,
      ValueComponent.Version,
      usize.ZERO,
    ))
  }

  /// Returns `HTTP/1.0` or `HTTP/1.1`.
  pub fn format(self: &Self) -> string<'static> {
    return match & self.* {
      Version.Http10 => "HTTP/1.0"
      Version.Http11 => "HTTP/1.1"
    }
  }
}

/// An HTTP method, such as `GET`. It keeps its exact spelling, and is compared with case.
///
/// # Details
///
/// Any valid token is a method, so `get` and `GET` are different methods. It borrows its text. The
/// `make` and `parse` functions check the token.
pub struct Method<'text> {
  text: string<'text>,
}

impl<'text> Copy for Method<'text> {}

impl<'text> Method<'text> {
  /// Checks that `text` is a token of at most `maxBytes` bytes, and returns it as a method.
  pub fn parse(text: string<'text>, maxBytes: usize) -> Result<Method<'text>, ValueError> {
    let bytes = String.utf8Bytes(text)
    if bytes.length > maxBytes {
      return Result<Method<'text>, ValueError>.failResult(limitFailure(
        ValueComponent.Method,
        LimitKind.MethodBytes,
        maxBytes,
        bytes.length,
      ))
    }
    if bytes.length == usize.ZERO {
      return Result<Method<'text>, ValueError>.failResult(failure(
        ValueReason.InvalidToken,
        ValueComponent.Method,
        usize.ZERO,
      ))
    }
    let mut index = usize.ZERO
    while index < bytes.length {
      if !tokenByte(bytes[index]) {
        return Result<Method<'text>, ValueError>.failResult(failure(
          ValueReason.InvalidToken,
          ValueComponent.Method,
          index,
        ))
      }
      index = index + usize.ONE
    }
    return Result<Method<'text>, ValueError>.succeed(Method<'text> { text: text })
  }

  /// Returns the method text, spelled as given.
  pub fn format(self: &Self) -> string<'text> {
    return self.text
  }

  /// Returns `true` if the two methods have the same spelling. Case matters.
  pub fn equals(self: &Self, other: &Method) -> bool {
    return self.text == other.text
  }

  /// Returns the standard GET method value.
  pub fn get() -> Method<'static> { return Method<'static> { text: "GET" } }
  /// Returns the standard HEAD method value.
  pub fn head() -> Method<'static> { return Method<'static> { text: "HEAD" } }
  /// Returns the standard POST method value.
  pub fn post() -> Method<'static> { return Method<'static> { text: "POST" } }
  /// Returns the standard PUT method value.
  pub fn put() -> Method<'static> { return Method<'static> { text: "PUT" } }
  /// Returns the standard DELETE method value.
  pub fn delete() -> Method<'static> { return Method<'static> { text: "DELETE" } }
  /// Returns the standard CONNECT method value.
  pub fn connect() -> Method<'static> { return Method<'static> { text: "CONNECT" } }
  /// Returns the standard OPTIONS method value.
  pub fn options() -> Method<'static> { return Method<'static> { text: "OPTIONS" } }
  /// Returns the standard TRACE method value.
  pub fn trace() -> Method<'static> { return Method<'static> { text: "TRACE" } }
  /// Returns the standard PATCH method value.
  pub fn patch() -> Method<'static> { return Method<'static> { text: "PATCH" } }
}

/// The class of a status code, from its first digit.
pub enum StatusClass {
  /// 1xx informational.
  Informational,
  /// 2xx successful.
  Successful,
  /// 3xx redirection.
  Redirection,
  /// 4xx client error.
  ClientError,
  /// 5xx server error.
  ServerError,
}

/// An HTTP status code from 100 to 599. Codes without a name, such as 299, are kept.
pub struct Status {
  value: u16,
}

impl Copy for Status {}

impl Debug for Status {
  /// Writes the code, as `Status { code: 404 }`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    let mut record = run Format.debugRecord("Status", &mut formatter)
    run Format.debugField(&mut record, "code", &self.value, &mut formatter)
    return run Format.debugFinish(record, &mut formatter)
  }
}

impl Status {
  /// Returns the status for `code`, or `InvalidStatus` if `code` is not from 100 to 599.
  pub fn fromCode(code: u16) -> Result<Status, ValueError> {
    if code < 100 || code > 599 {
      return Result<Status, ValueError>.failResult(failure(
        ValueReason.InvalidStatus,
        ValueComponent.Status,
        usize.ZERO,
      ))
    }
    return Result<Status, ValueError>.succeed(Status { value: code })
  }

  /// Returns the code, such as 404.
  pub fn code(self: &Self) -> u16 { return self.value }

  /// Returns the class, from the first digit of the code.
  pub fn class(self: &Self) -> StatusClass {
    let hundreds = self.value / 100
    if hundreds == 1 { return StatusClass.Informational }
    if hundreds == 2 { return StatusClass.Successful }
    if hundreds == 3 { return StatusClass.Redirection }
    if hundreds == 4 { return StatusClass.ClientError }
    return StatusClass.ServerError
  }
}

/// An HTTP header field. It borrows its name and value, and keeps their exact bytes.
///
/// # Gotchas
///
/// [`Header.make`] takes the value without the spaces around it on the wire. It rejects CR, LF,
/// NUL, DEL, other control bytes, and leading or trailing spaces or tabs.
pub struct Header<'value> {
  nameText: string<'value>,
  valueBytes: &'value [u8],
}

impl<'value> Copy for Header<'value> {}

impl<'value> Header<'value> {
  /// Checks a field and returns it.
  ///
  /// `name` must be a token. `value` is the value without the spaces around it on the wire.
  ///
  /// # Errors
  /// - `InvalidToken` if `name` is not valid.
  /// - `InvalidValueByte` if `value` has a control byte, or starts or ends with a space or a tab.
  /// - `LimitExceeded` if `name` or `value` is too long for `limits`.
  pub fn make(
    name: string<'value>,
    value: &'value [u8],
    limits: Limits,
  ) -> Result<Header<'value>, ValueError> {
    let nameBytes = String.utf8Bytes(name)
    if nameBytes.length > limits.maxNameBytes {
      return Result<Header<'value>, ValueError>.failResult(limitFailure(
        ValueComponent.HeaderName,
        LimitKind.NameBytes,
        limits.maxNameBytes,
        nameBytes.length,
      ))
    }
    if value.length > limits.maxValueBytes {
      return Result<Header<'value>, ValueError>.failResult(limitFailure(
        ValueComponent.HeaderValue,
        LimitKind.ValueBytes,
        limits.maxValueBytes,
        value.length,
      ))
    }
    if nameBytes.length == usize.ZERO {
      return Result<Header<'value>, ValueError>.failResult(failure(
        ValueReason.InvalidToken,
        ValueComponent.HeaderName,
        usize.ZERO,
      ))
    }
    let mut index = usize.ZERO
    while index < nameBytes.length {
      if !tokenByte(nameBytes[index]) {
        return Result<Header<'value>, ValueError>.failResult(failure(
          ValueReason.InvalidToken,
          ValueComponent.HeaderName,
          index,
        ))
      }
      index = index + usize.ONE
    }
    index = usize.ZERO
    while index < value.length {
      if !fieldValueByte(value[index]) {
        return Result<Header<'value>, ValueError>.failResult(failure(
          ValueReason.InvalidValueByte,
          ValueComponent.HeaderValue,
          index,
        ))
      }
      index = index + usize.ONE
    }
    if value.length > usize.ZERO {
      if value[usize.ZERO] == 9 || value[usize.ZERO] == 32 {
        return Result<Header<'value>, ValueError>.failResult(failure(
          ValueReason.InvalidValueByte,
          ValueComponent.HeaderValue,
          usize.ZERO,
        ))
      }
      let last = value.length - usize.ONE
      if value[last] == 9 || value[last] == 32 {
        return Result<Header<'value>, ValueError>.failResult(failure(
          ValueReason.InvalidValueByte,
          ValueComponent.HeaderValue,
          last,
        ))
      }
    }
    return Result<Header<'value>, ValueError>.succeed(Header<'value> {
      nameText: name,
      valueBytes: value,
    })
  }

  /// Returns the field name, spelled as given.
  pub fn name(self: &Self) -> string<'value> { return self.nameText }

  /// Returns the field value bytes.
  pub fn value(self: &Self) -> &'value [u8] { return self.valueBytes }
}

fn failure(reason: ValueReason, component: ValueComponent, offset: usize) -> ValueError {
  return ValueError {
    reason: reason,
    component: component,
    fieldIndex: Option<usize>.none(),
    offset: offset,
  }
}

fn indexedFailure(
  reason: ValueReason,
  component: ValueComponent,
  fieldIndex: usize,
  offset: usize,
) -> ValueError {
  return ValueError {
    reason: reason,
    component: component,
    fieldIndex: Option<usize>.some(fieldIndex),
    offset: offset,
  }
}

fn limitFailure(
  component: ValueComponent,
  limit: LimitKind,
  allowed: usize,
  attempted: usize,
) -> ValueError {
  return failure(
    ValueReason.LimitExceeded { limit: limit, allowed: allowed, attempted: attempted },
    component,
    attempted,
  )
}

fn outputFailure(component: ValueComponent, required: usize, available: usize) -> ValueError {
  return failure(
    ValueReason.OutputTooSmall { required: required, available: available },
    component,
    available,
  )
}

fn sizeFailure(component: ValueComponent) -> ValueError {
  return failure(ValueReason.SizeOverflow, component, usize.MAX)
}

fn tokenByte(value: u8) -> bool {
  if value >= 65 && value <= 90 { return true }
  if value >= 97 && value <= 122 { return true }
  if value >= 48 && value <= 57 { return true }
  return value == 33 || value == 35 || value == 36 || value == 37 || value == 38
    || value == 39 || value == 42 || value == 43 || value == 45 || value == 46
    || value == 94 || value == 95 || value == 96 || value == 124 || value == 126
}

fn fieldValueByte(value: u8) -> bool {
  return value == 9 || (value >= 32 && value <= 126) || value >= 128
}

fn asciiEqual(left: string, right: string) -> bool {
  let leftBytes = String.utf8Bytes(left)
  let rightBytes = String.utf8Bytes(right)
  if leftBytes.length != rightBytes.length { return false }
  let mut index = usize.ZERO
  while index < leftBytes.length {
    if asciiLower(leftBytes[index]) != asciiLower(rightBytes[index]) { return false }
    index = index + usize.ONE
  }
  return true
}

fn asciiLower(value: u8) -> u8 {
  if value >= 65 && value <= 90 { return value + 32 }
  return value
}

/// A checked request line and header fields, without a body. It borrows its parts.
pub struct RequestHead<'value> {
  versionValue: Version,
  methodValue: Method<'value>,
  targetValue: RequestTarget<'value>,
  headerValues: Headers<'value>,
}

impl<'value> Copy for RequestHead<'value> {}

impl<'value> RequestHead<'value> {
  /// Checks the parts of a request head and returns it.
  ///
  /// # Errors
  /// - `MethodTargetMismatch` if the target form does not fit the method.
  /// - `MissingHost` or `DuplicateHost` if an HTTP/1.1 request has no `Host` field, or more than
  ///   one.
  pub fn make(
    version: Version,
    method: Method<'value>,
    target: RequestTarget<'value>,
    headers: Headers<'value>,
  ) -> Result<RequestHead<'value>, ValueError> {
    let targetValidation = RequestTarget.validateForMethod(&method, target)
    match move targetValidation {
      Result<(), ValueError>.Failure {error} => {
        return Result<RequestHead<'value>, ValueError>.failResult(move error)
      }
      Result<(), ValueError>.Success {value} => {}
    }
    let host = validateRequestHost(version, &target, &headers)
    match move host {
      Result<Option<HttpAuthority<'value>>, ValueError>.Failure {error} => {
        return Result<RequestHead<'value>, ValueError>.failResult(move error)
      }
      Result<Option<HttpAuthority<'value>>, ValueError>.Success {value} => { drop value }
    }
    return Result<RequestHead<'value>, ValueError>.succeed(RequestHead<'value> {
      versionValue: version,
      methodValue: method,
      targetValue: move target,
      headerValues: headers,
    })
  }

  /// Returns the request version.
  pub fn version(self: &Self) -> Version { return self.versionValue }

  /// Returns the method.
  pub fn method(self: &Self) -> Method<'value> { return self.methodValue }

  /// Returns the request target.
  pub fn target(self: &Self) -> RequestTarget<'value> { return self.targetValue }

  /// Returns the header fields, in order.
  pub fn headers(self: &Self) -> Headers<'value> { return self.headerValues }

  /// Copies the head into new memory, so that it does not borrow its input.
  ///
  /// # Errors
  /// - `LimitExceeded` if the head exceeds `limits`. Nothing is allocated.
  /// - `OutOfMemoryError` if the `Allocator` fails.
  pub effect fn copy(
    self: &Self,
    limits: Limits,
  ) -> Result<OwnedRequestHead, ValueError> ! OutOfMemoryError ? &mut Allocator {
    let methodText = Method.format(&self.methodValue)
    let targetText = RequestTarget.format(self.targetValue)
    let methodLength = String.byteLength(methodText)
    if methodLength > limits.maxMethodBytes {
      return Result<OwnedRequestHead, ValueError>.failResult(limitFailure(
        ValueComponent.Method,
        LimitKind.MethodBytes,
        limits.maxMethodBytes,
        methodLength,
      ))
    }
    let targetLength = String.byteLength(targetText)
    if targetLength > limits.maxTargetBytes {
      return Result<OwnedRequestHead, ValueError>.failResult(limitFailure(
        ValueComponent.Target,
        LimitKind.TargetBytes,
        limits.maxTargetBytes,
        targetLength,
      ))
    }
    let total = headOwnedBytes(
      &self.headerValues,
      methodLength,
      targetLength,
      usize.ZERO,
      limits,
    )
    match move total {
      Result<usize, ValueError>.Failure {error} => {
        return Result<OwnedRequestHead, ValueError>.failResult(move error)
      }
      Result<usize, ValueError>.Success {value} => { drop value }
    }
    let headerCopy = run Headers.copy(&self.headerValues, limits)
    return match move headerCopy {
      Result<OwnedHeaders, ValueError>.Failure {error} => {
        return Result<OwnedRequestHead, ValueError>.failResult(move error)
      }
      Result<OwnedHeaders, ValueError>.Success {value} => {
        let methodOwned = run String.copy(methodText)
        let targetOwned = run String.copy(targetText)
        return Result<OwnedRequestHead, ValueError>.succeed(OwnedRequestHead {
          versionValue: self.versionValue,
          methodValue: move methodOwned,
          targetValue: move targetOwned,
          headerValues: move value,
          limitsValue: limits,
        })
      }
    }
  }

}

/// A request head that owns its memory. Get a [`RequestHead`] from it with
/// [`OwnedRequestHead.view`].
pub struct OwnedRequestHead {
  versionValue: Version,
  methodValue: String,
  targetValue: String,
  headerValues: OwnedHeaders,
  limitsValue: Limits,
}

impl OwnedRequestHead {
  /// Returns the head as a [`RequestHead`] that borrows this value.
  pub fn view<'value>(self: &'value Self) -> RequestHead<'value> {
    let methodText = String.view(&self.methodValue)
    let method = match move Method.parse(methodText, self.limitsValue.maxMethodBytes) {
      Result<Method<'value>, ValueError>.Failure {error} => {
        drop error
        return absurd<RequestHead<'value>>()
      }
      Result<Method<'value>, ValueError>.Success {value} => value
    }
    let targetText = String.view(&self.targetValue)
    let target = match move RequestTarget.parse(
      &method,
      targetText,
      self.limitsValue.maxTargetBytes,
    ) {
      Result<RequestTarget<'value>, ValueError>.Failure {error} => {
        drop error
        return absurd<RequestHead<'value>>()
      }
      Result<RequestTarget<'value>, ValueError>.Success {value} => value
    }
    return RequestHead<'value> {
      versionValue: self.versionValue,
      methodValue: method,
      targetValue: move target,
      headerValues: OwnedHeaders.view(&self.headerValues),
    }
  }
}

/// A checked status line and header fields, without a body. It borrows its parts.
pub struct ResponseHead<'value> {
  versionValue: Version,
  statusValue: Status,
  reasonValue: Option<&'value [u8]>,
  headerValues: Headers<'value>,
}

impl<'value> ResponseHead<'value> {
  /// Checks the parts of a response head and returns it.
  ///
  /// `reason` is the optional text after the status code, such as `Not Found`.
  ///
  /// # Errors
  /// - `InvalidValueByte` if `reason` has a control byte.
  /// - `LimitExceeded` if `reason` is longer than `maxValueBytes`.
  pub fn make(
    version: Version,
    status: Status,
    reason: Option<&'value [u8]>,
    headers: Headers<'value>,
    limits: Limits,
  ) -> Result<ResponseHead<'value>, ValueError> {
    match & reason {
      Option<&[u8]>.None => {}
      Option<&[u8]>.Some { value } => {
        if value.length > limits.maxValueBytes {
          return Result<ResponseHead<'value>, ValueError>.failResult(limitFailure(
            ValueComponent.ReasonPhrase,
            LimitKind.ValueBytes,
            limits.maxValueBytes,
            value.length,
          ))
        }
        let mut index = usize.ZERO
        while index < value.length {
          if !fieldValueByte(value[index]) {
            return Result<ResponseHead<'value>, ValueError>.failResult(ValueError {
              reason: ValueReason.InvalidValueByte,
              component: ValueComponent.ReasonPhrase,
              fieldIndex: Option<usize>.none(),
              offset: index,
            })
          }
          index = index + usize.ONE
        }
      }
    }
    return Result<ResponseHead<'value>, ValueError>.succeed(ResponseHead<'value> {
      versionValue: version,
      statusValue: status,
      reasonValue: move reason,
      headerValues: headers,
    })
  }

  /// Returns the response version.
  pub fn version(self: &Self) -> Version { return self.versionValue }

  /// Returns the status.
  pub fn status(self: &Self) -> Status { return self.statusValue }

  /// Returns the reason phrase, if there is one.
  pub fn reason(self: &Self) -> Option<&'value [u8]> {
    return match & self.reasonValue {
      Option<&[u8]>.None => Option<&'value [u8]>.none()
      Option<&[u8]>.Some {value} => Option<&'value [u8]>.some(value)
    }
  }

  /// Returns the header fields, in order.
  pub fn headers(self: &Self) -> Headers<'value> { return self.headerValues }

  /// Copies the head into new memory, so that it does not borrow its input.
  ///
  /// # Errors
  /// - `LimitExceeded` if the head exceeds `limits`. Nothing is allocated.
  /// - `OutOfMemoryError` if the `Allocator` fails.
  pub effect fn copy(
    self: &Self,
    limits: Limits,
  ) -> Result<OwnedResponseHead, ValueError> ! OutOfMemoryError ? &mut Allocator {
    let reasonLength = match & self.reasonValue {
      Option<&[u8]>.None => usize.ZERO
      Option<&[u8]>.Some {value} => value.length
    }
    if reasonLength > limits.maxValueBytes {
      return Result<OwnedResponseHead, ValueError>.failResult(limitFailure(
        ValueComponent.ReasonPhrase,
        LimitKind.ValueBytes,
        limits.maxValueBytes,
        reasonLength,
      ))
    }
    let total = headOwnedBytes(
      &self.headerValues,
      usize.ZERO,
      usize.ZERO,
      reasonLength,
      limits,
    )
    match move total {
      Result<usize, ValueError>.Failure {error} => {
        return Result<OwnedResponseHead, ValueError>.failResult(move error)
      }
      Result<usize, ValueError>.Success {value} => { drop value }
    }
    let headerCopy = run Headers.copy(&self.headerValues, limits)
    return match move headerCopy {
      Result<OwnedHeaders, ValueError>.Failure {error} => {
        return Result<OwnedResponseHead, ValueError>.failResult(move error)
      }
      Result<OwnedHeaders, ValueError>.Success {value: headers} => {
        let reason = match & self.reasonValue {
          Option<&[u8]>.None => OwnedReason.None
          Option<&[u8]>.Some {value} => OwnedReason.Some {bytes: run Bytes.copy(value)}
        }
        return Result<OwnedResponseHead, ValueError>.succeed(OwnedResponseHead {
          versionValue: self.versionValue,
          statusValue: self.statusValue,
          reasonValue: move reason,
          headerValues: move headers,
        })
      }
    }
  }

  /// Copies the status, the reason, and only the fields named `name`, into new memory.
  ///
  /// # Details
  /// Names are compared without case. Repeated fields stay separate, in their order. `limits`
  /// applies to the copied parts only.
  pub effect fn copyMatchingHeaders(
    self: &Self,
    name: string<'value>,
    limits: Limits,
  ) -> Result<OwnedResponseHead, ValueError> ! OutOfMemoryError ? &mut Allocator {
    let reasonLength = match & self.reasonValue {
      Option<&[u8]>.None => usize.ZERO
      Option<&[u8]>.Some {value} => value.length
    }
    if reasonLength > limits.maxValueBytes {
      return Result<OwnedResponseHead, ValueError>.failResult(limitFailure(
        ValueComponent.ReasonPhrase,
        LimitKind.ValueBytes,
        limits.maxValueBytes,
        reasonLength,
      ))
    }
    if reasonLength > limits.maxOwnedBytes {
      return Result<OwnedResponseHead, ValueError>.failResult(limitFailure(
        ValueComponent.Headers,
        LimitKind.OwnedBytes,
        limits.maxOwnedBytes,
        reasonLength,
      ))
    }
    let mut headerLimits = limits
    headerLimits.maxOwnedBytes = limits.maxOwnedBytes - reasonLength
    let headerCopy = run Headers.copyMatching(&self.headerValues, name, headerLimits)
    return match move headerCopy {
      Result<OwnedHeaders, ValueError>.Failure {error} => {
        return Result<OwnedResponseHead, ValueError>.failResult(move error)
      }
      Result<OwnedHeaders, ValueError>.Success {value: headers} => {
        let reason = match & self.reasonValue {
          Option<&[u8]>.None => OwnedReason.None
          Option<&[u8]>.Some {value} => OwnedReason.Some {bytes: run Bytes.copy(value)}
        }
        return Result<OwnedResponseHead, ValueError>.succeed(OwnedResponseHead {
          versionValue: self.versionValue,
          statusValue: self.statusValue,
          reasonValue: move reason,
          headerValues: move headers,
        })
      }
    }
  }
}

union OwnedReason {
  None,
  Some {bytes: Bytes},
}

impl Debug for OwnedReason {
  /// Writes the name of the variant and its fields, such as `None`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      OwnedReason.None => run Format.write(&mut formatter, b"None")
      OwnedReason.Some { bytes } => {
        let mut record = run Format.debugRecord("Some", &mut formatter)
        run Format.debugField(&mut record, "bytes", &bytes, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
    }
  }
}

/// A response head that owns its memory. Get a [`ResponseHead`] from it with
/// [`OwnedResponseHead.view`].
pub struct OwnedResponseHead {
  versionValue: Version,
  statusValue: Status,
  reasonValue: OwnedReason,
  headerValues: OwnedHeaders,
}

impl Debug for OwnedResponseHead {
  /// Writes the version and the status, as `OwnedResponseHead { version: Http11, status: Status { code: 407 } }`. It leaves out the reason phrase and the headers.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    let mut record = run Format.debugRecord("OwnedResponseHead", &mut formatter)
    run Format.debugField(&mut record, "version", &self.versionValue, &mut formatter)
    run Format.debugField(&mut record, "status", &self.statusValue, &mut formatter)
    return run Format.debugFinish(record, &mut formatter)
  }
}

impl OwnedResponseHead {
  /// Returns the head as a [`ResponseHead`] that borrows this value.
  pub fn view<'value>(self: &'value Self) -> ResponseHead<'value> {
    let reason = match & self.reasonValue {
      OwnedReason.None => Option<&'value [u8]>.none()
      OwnedReason.Some {bytes} => Option<&'value [u8]>.some(Bytes.asSlice(&bytes))
    }
    return ResponseHead<'value> {
      versionValue: self.versionValue,
      statusValue: self.statusValue,
      reasonValue: move reason,
      headerValues: OwnedHeaders.view(&self.headerValues),
    }
  }
}

fn headOwnedBytes(
  headers: &Headers,
  first: usize,
  second: usize,
  third: usize,
  limits: Limits,
) -> Result<usize, ValueError> {
  let headerBytes = match move Headers.requiredOwnedBytes(headers) {
    Result<usize, ValueError>.Failure {error} => {
      return Result<usize, ValueError>.failResult(move error)
    }
    Result<usize, ValueError>.Success {value} => value
  }
  let firstTotal = match move usize.checkedAdd(headerBytes, first) {
    Option<usize>.None => {
      return Result<usize, ValueError>.failResult(sizeFailure(ValueComponent.Headers))
    }
    Option<usize>.Some {value} => value
  }
  let secondTotal = match move usize.checkedAdd(firstTotal, second) {
    Option<usize>.None => {
      return Result<usize, ValueError>.failResult(sizeFailure(ValueComponent.Headers))
    }
    Option<usize>.Some {value} => value
  }
  let total = match move usize.checkedAdd(secondTotal, third) {
    Option<usize>.None => {
      return Result<usize, ValueError>.failResult(sizeFailure(ValueComponent.Headers))
    }
    Option<usize>.Some {value} => value
  }
  if total > limits.maxOwnedBytes {
    return Result<usize, ValueError>.failResult(limitFailure(
      ValueComponent.Headers,
      LimitKind.OwnedBytes,
      limits.maxOwnedBytes,
      total,
    ))
  }
  return Result<usize, ValueError>.succeed(total)
}

fn absurd<T>() -> T {
  return Intrinsic.trap("HTTP: an internal state the surrounding logic ruled out was reached")
}
