//! HTTP/2 over the existing plain or TLS `HttpTransport` service.
//!
//! Create a [`Driver`], queue requests or responses through `Driver.connection`, and call
//! `Driver.next` to flush output and receive an event. Calls preserve unread bytes between events.
//! The provider remains caller-owned. Use `silk.http.transport.plain` for a socket or
//! `silk.http.transport.secured` after a TLS handshake with required `h2` ALPN.
//!
//! @category HTTP

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.io.byte_duplex { ReadTransfer }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.http.http2 { Connection, Event, Limits, Role }
import silk.http.http2_frame { ProtocolError, PROTOCOL_ERROR }
import silk.http.transport { HttpTransport, TransportError }
import silk.system.monotonic_clock { MonotonicClock }
import silk.core.option { Option }
import silk.system.random { Random }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.system.system_clock { Instant, SystemClock }
import silk.tls.client { AlpnProtocol, Authentication }
import silk.num.usize

/// Returns the `h2` ALPN identifier. Offer it with `AlpnConfig.Offered` and `required: true` for HTTP/2-only TLS.
pub fn protocol() -> AlpnProtocol<'static> {
  return AlpnProtocol<'static> { bytes: b"h2" }
}

/// Verifies that an authenticated TLS connection selected `h2`. Other protocols fail with PROTOCOL_ERROR.
pub effect fn requireAlpn(authentication: &Authentication) -> ()
  ! ProtocolError {
  match move Authentication.selectedAlpn(authentication) {
    Option.Some { value } => {
      if value.length == 2 && value[0] == 104 && value[1] == 50 {
        return ()
      }
    }
    Option.None => {}
  }
  fail ProtocolError { code: PROTOCOL_ERROR, stream: 0 }
}

/// A buffered driver for one HTTP/2 connection. It borrows the transport through the Effect service.
pub struct Driver {
  core: Connection,
  input: Bytes,
  offset: usize,
  length: usize,
  ended: bool,
}

impl Driver {
  /// Creates a protocol connection and a 16 KiB transport read buffer. No I/O occurs until `flush` or `next`.
  pub effect fn make(endpoint: Role, limits: Limits) -> Driver
    ! ProtocolError | OutOfMemoryError
    ? &mut Allocator {
    let core = run Connection.make(move endpoint, limits)
    let input = run Bytes.zeroed(16384)
    return Driver { core: move core, input: move input, offset: 0, length: 0, ended: false }
  }

  /// Borrows the protocol connection to open streams, send fields or data, return credit, or initiate shutdown.
  pub fn connection(self: &mut Self) -> &mut Connection {
    return &mut self.core
  }

  /// Sends all queued protocol bytes and flushes the transport with the caller's absolute deadline.
  pub effect fn flush(self: &mut Self, deadline: Option<Instant>) -> ()
    ! ProtocolError | TransportError | OutOfMemoryError
    ? &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random {
    while Connection.output(&self.core).length > 0 {
      let count = run HttpTransport.writeSome(
        Connection.output(&self.core),
        copyDeadline(&deadline)
      )
      run Connection.consumeOutput(&mut self.core, count)
    }
    run HttpTransport.flush(move deadline)
  }

  /// Flushes output, drains at most `drainBytes` incoming bytes, and closes the transport.
  /// Give a finite deadline after GOAWAY so unread socket data does not discard the shutdown frame.
  /// Drain failures stop draining. Flush and close failures are returned after the close attempt.
  pub effect fn close(self: &mut Self, deadline: Option<Instant>, drainBytes: usize) -> ()
    ! ProtocolError | TransportError | OutOfMemoryError
    ? &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random {
    let flushed = run Effect.result(Driver.flush(&mut self.*, copyDeadline(&deadline)))
    self.ended = true
    let mut remaining = drainBytes
    while remaining > 0 {
      let mut count = remaining
      if count > Bytes.length(&self.input) {
        count = Bytes.length(&self.input)
      }
      Bytes.truncate(&mut self.input, count)
      let read = run Effect.result(
        HttpTransport.readSome(Bytes.asMutSlice(&mut self.input), copyDeadline(&deadline))
      )
      match move read {
        Result.Success { value } => match move value {
          ReadTransfer.Data { count: received } => {
            remaining = remaining - received
          }
          ReadTransfer.End => {
            break
          }
        }
        Result.Failure { error } => {
          break
        }
      }
    }
    let closed = run Effect.result(HttpTransport.close())
    match move flushed {
      Result.Success { value } => {}
      Result.Failure { error } => {
        fail move error
      }
    }
    match move closed {
      Result.Success { value } => {}
      Result.Failure { error } => {
        fail move error
      }
    }
  }

  /// Flushes queued output, then waits for one event. None means clean transport EOF.
  /// A partial frame or unfinished stream at EOF fails. Protocol errors attempt to flush GOAWAY before returning.
  pub effect fn next(self: &mut Self, deadline: Option<Instant>) -> Option<Event>
    ! ProtocolError | TransportError | OutOfMemoryError
    ? &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random {
    if self.ended {
      return Option<Event>.none()
    }
    while true {
      run Driver.flush(&mut self.*, copyDeadline(&deadline))
      if self.offset == self.length {
        let read = run HttpTransport.readSome(
          Bytes.asMutSlice(&mut self.input),
          copyDeadline(&deadline)
        )
        self.offset = 0
        match move read {
          ReadTransfer.Data { count } => {
            self.length = count
          }
          ReadTransfer.End => {
            self.ended = true
            run Connection.finishInput(&mut self.core)
            return Option<Event>.none()
          }
        }
      }
      let received = run Effect.result(
        Connection.receive(
          &mut self.core,
          Slice.view(Bytes.asSlice(&self.input), self.offset, self.length - self.offset)
        )
      )
      let progress = match move received {
        Result.Success { value } => move value
        Result.Failure { error } => {
          self.ended = true
          drop run Effect.result(Driver.flush(&mut self.*, copyDeadline(&deadline)))
          fail move error
        }
      }
      self.offset = self.offset + progress.consumed
      let empty = match &progress.event {
        Event.None => true
        _ => false
      }
      if !empty {
        return Option<Event>.some(move progress.event)
      }
    }
  }
}

fn copyDeadline(deadline: &Option<Instant>) -> Option<Instant> {
  return match &deadline.* {
    Option.None => Option<Instant>.none()
    Option.Some { value } => Option<Instant>.some(
      SystemClock.make(SystemClock.seconds(&value), SystemClock.nanoseconds(&value))
    )
  }
}
