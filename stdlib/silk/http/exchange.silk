const DEFAULT_DRAIN_WIRE_BYTES: u64 = 65536

const MAX_DRAIN_WIRE_BYTES: u64 = 1048576

/// The state of a [`Connection`].
pub enum ConnectionPhase {
  /// The connection can start a new exchange.
  Ready,
  /// An exchange is running.
  Active,
  /// The connection cannot run more exchanges.
  Closed,
}

/// The next step of an [`Exchange`].
pub enum ExchangePhase {
  /// Call [`send`].
  Prepared,
  /// The request has `Expect: 100-continue`. Call [`receive`] to wait for 100 Continue or an early
  /// final response.
  AwaitContinue,
  /// Call [`writeSome`] for the body, then [`finishRequest`].
  Upload,
  /// Call [`receive`] or [`receiveFinal`].
  AwaitResponse,
  /// Read the body with [`readSome`] or [`readContentSome`], then call [`finishResponse`].
  Response,
  /// A `CONNECT` succeeded. Call [`withTunnel`].
  Tunnel,
  /// The request and the response are complete.
  Finished,
  /// The exchange stopped. No more steps are possible.
  Aborted,
}

/// Whether the client waits for 100 Continue before it sends the body.
pub union ContinuePolicy {
  /// Send the whole body before the response is read.
  Disabled,
  /// Wait for 100 Continue until a deadline. If it does not come, fail with `ContinueTimeout`. The
  /// request needs `Expect: 100-continue`.
  Require100 {
    /// The deadline on the `MonotonicClock`. The deadline of the exchange also applies.
    pub deadline: Instant,
  },
}

/// The deadlines of one exchange. They are never restarted between steps.
pub struct RequestOptions {
  /// The deadline of the whole exchange on the `MonotonicClock`, or `None` for no deadline.
  pub deadline: Option<Instant>,
  /// Whether to wait for 100 Continue. It must match the `PreparedRequest`.
  pub continuePolicy: ContinuePolicy,
}

/// The limits of a connection: buffers, heads, bodies, and request counts. Start from
/// [`Limits.defaults`].
pub struct Limits {
  /// The limits for response heads.
  pub head: HeadLimits,
  /// The limits for request bodies.
  pub requestBody: BodyLimits,
  /// The limits for response bodies.
  pub responseBody: BodyLimits,
  /// The size of the read buffer. It must not be 0.
  pub readCapacity: usize,
  /// The size of the write buffer for framing. It must not be 0.
  pub writeCapacity: usize,
  /// The maximum number of requests on one connection.
  pub maxRequests: usize,
  /// The maximum number of 1xx responses in one exchange. The default is 16.
  pub maxInformationalResponses: usize,
  /// The maximum total size of the 1xx responses in one exchange. The default is 65536.
  pub maxInformationalWireBytes: u64,
  /// The maximum bytes that one discard or drain call reads. It is at most 1048576.
  pub maxDiscardWireBytes: u64,
}

impl Copy for Limits {}

impl Limits {
  /// Returns the default limits: 16 MiB bodies, 256 KiB heads with field values up to 64 KiB, and
  /// 128 requests for each connection. Servers send long values: GitHub's release downloads
  /// answer with a `Content-Security-Policy` of over 9 KiB.
  pub fn defaults() -> Limits {
    let values = HeaderLimits {
      maxMethodBytes: 64,
      maxTargetBytes: 8192,
      maxNameBytes: 256,
      maxValueBytes: 65536,
      maxFields: 128,
      maxFieldBytes: 262144,
      maxOwnedBytes: 524288,
    }
    let head = HeadLimits {
      maxHeadBytes: 262144,
      maxStartLineBytes: 16384,
      maxFieldLineBytes: 65800,
      maxOwnedBytes: 524288,
      values: values,
    }
    let trailers = HeaderLimits {
      maxMethodBytes: 64,
      maxTargetBytes: 8192,
      maxNameBytes: 256,
      maxValueBytes: 8192,
      maxFields: 128,
      maxFieldBytes: 65536,
      maxOwnedBytes: 131072,
    }
    let body = BodyLimits {
      maxWireBytes: 16777216,
      maxPayloadBytes: 16777216,
      maxChunkBytes: 65536,
      maxChunks: 65536,
      maxChunkLineBytes: 1024,
      maxExtensionBytes: 65536,
      maxTrailerBytes: 16384,
      maxTrailerFields: 64,
      maxOwnedBytes: 131072,
      trailerValues: trailers,
    }
    return Limits {
      head: head,
      requestBody: body,
      responseBody: body,
      readCapacity: 16384,
      writeCapacity: 16384,
      maxRequests: 128,
      maxInformationalResponses: 16,
      maxInformationalWireBytes: 65536,
      maxDiscardWireBytes: DEFAULT_DRAIN_WIRE_BYTES,
    }
  }
}

impl RequestOptions {
  /// Returns options with no deadline that do not wait for 100 Continue.
  pub fn defaults() -> RequestOptions {
    return RequestOptions {
      deadline: Option<Instant>.none(),
      continuePolicy: ContinuePolicy.Disabled,
    }
  }
}

/// The error from a connection or an exchange.
///
/// # Details
///
/// It keeps the error from the lower module: the head parser, the body framing, content decoding,
/// or the transport. A step out of order fails with `InvalidState`.
pub union ExchangeError {
  /// Content decoding failed.
  Content {
    /// The error from `silk.http.content`.
    pub error: ContentError<'static>,
  },
  /// A response head is not valid, or the head limits are not valid.
  Head {
    /// The error from `silk.http.head`.
    pub error: ParseError,
  },
  /// The body framing failed.
  Body {
    /// The error from `silk.http.body`.
    pub error: BodyError,
  },
  /// The transport failed.
  Transport {
    /// The error from `silk.http.transport`.
    pub error: TransportError,
  },
  /// The transport failed during a write. `progress` tells what was already accepted and sent.
  Output {
    /// The error from `silk.http.transport`.
    pub error: TransportError,
    /// The bytes accepted and sent by the call before the error.
    pub progress: WriteProgress,
  },
  /// The deadline passed during a write.
  OutputTimeout {
    /// The bytes accepted and sent by the call before the deadline.
    pub progress: WriteProgress,
  },
  /// The transport could not allocate during a write.
  OutputAllocation {
    /// The allocation error.
    pub error: OutOfMemoryError,
    /// The bytes accepted and sent by the call before the error.
    pub progress: WriteProgress,
  },
  /// The step is not valid in the current phase. Nothing was sent or read.
  InvalidState,
  /// The request does not fit the connection, for example another version or another server, or its
  /// body framing does not fit the options.
  InvalidRequest,
  /// A buffer size in the limits is 0.
  InvalidLimits,
  /// Too many 1xx responses, or too many requests on the connection.
  LimitExceeded,
  /// The connection ended before a complete response head.
  TruncatedHead,
  /// The server sent 101 Switching Protocols, which this module does not support.
  UnsupportedUpgrade,
  /// The deadline of `Require100` passed without 100 Continue.
  ContinueTimeout,
  /// The deadline of the exchange passed.
  Timeout,
}

impl Debug for ExchangeError {
  /// Writes the name of the variant and its fields, such as `Content { ... }`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      ExchangeError.Content { error } => {
        let mut record = run Format.debugRecord("Content", &mut formatter)
        run Format.debugField(&mut record, "error", &error, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      ExchangeError.Head { error } => {
        let mut record = run Format.debugRecord("Head", &mut formatter)
        run Format.debugField(&mut record, "error", &error, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      ExchangeError.Body { error } => {
        let mut record = run Format.debugRecord("Body", &mut formatter)
        run Format.debugField(&mut record, "error", &error, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      ExchangeError.Transport { error } => {
        let mut record = run Format.debugRecord("Transport", &mut formatter)
        run Format.debugField(&mut record, "error", &error, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      ExchangeError.Output { error, progress } => {
        let mut record = run Format.debugRecord("Output", &mut formatter)
        run Format.debugField(&mut record, "error", &error, &mut formatter)
        run Format.debugField(&mut record, "progress", &progress, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      ExchangeError.OutputTimeout { progress } => {
        let mut record = run Format.debugRecord("OutputTimeout", &mut formatter)
        run Format.debugField(&mut record, "progress", &progress, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      ExchangeError.OutputAllocation { error, progress } => {
        let mut record = run Format.debugRecord("OutputAllocation", &mut formatter)
        run Format.debugField(&mut record, "error", &error, &mut formatter)
        run Format.debugField(&mut record, "progress", &progress, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      ExchangeError.InvalidState => run Format.write(&mut formatter, b"InvalidState")
      ExchangeError.InvalidRequest => run Format.write(&mut formatter, b"InvalidRequest")
      ExchangeError.InvalidLimits => run Format.write(&mut formatter, b"InvalidLimits")
      ExchangeError.LimitExceeded => run Format.write(&mut formatter, b"LimitExceeded")
      ExchangeError.TruncatedHead => run Format.write(&mut formatter, b"TruncatedHead")
      ExchangeError.UnsupportedUpgrade => run Format.write(&mut formatter, b"UnsupportedUpgrade")
      ExchangeError.ContinueTimeout => run Format.write(&mut formatter, b"ContinueTimeout")
      ExchangeError.Timeout => run Format.write(&mut formatter, b"Timeout")
    }
  }
}

/// Checks `limits` without allocation or I/O.
///
/// # Details
/// The buffer sizes must not be 0, and `maxDiscardWireBytes` must be at most 1048576. The head
/// limits must pass `validateLimits` of `silk.http.head`. That error is returned in `Head`.
pub fn validateLimits(limits: &Limits) -> Result<(), ExchangeError> {
  if limits.readCapacity == usize.ZERO || limits.writeCapacity == usize.ZERO || limits.maxDiscardWireBytes > MAX_DRAIN_WIRE_BYTES {
    return Result<(), ExchangeError>.failResult(ExchangeError.InvalidLimits)
  }
  return match move Head.validateLimits(&limits.head) {
    Result<(), ParseError>.Failure {error} => {
      return Result<(), ExchangeError>.failResult(ExchangeError.Head {error: move error})
    }
    Result<(), ParseError>.Success {value} => {
      return Result<(), ExchangeError>.succeed(move value)
    }
  }
}

/// The result of a discard or a drain.
pub enum DiscardOutcome {
  /// The whole response was read within the limit.
  Completed,
  /// The limit was reached before the end of the response. The connection cannot be used again.
  CapReached,
}

/// Whether a connection can go back to a pool. See [`reuseEligibility`].
pub union ReuseEligibility {
  /// The connection can go back to a pool.
  Eligible,
  /// The last exchange did not complete.
  NotReady,
  /// The connection does not own its transport, so it cannot close it later.
  NotOwned,
  /// The connection has reached `maxRequests`.
  RequestLimit,
  /// The server sent bytes after the end of the response.
  RetainedInput {
    /// The number of extra bytes.
    pub bytes: usize,
  },
}

impl Copy for ReuseEligibility {}

/// The progress of one write call.
pub struct WriteProgress {
  /// The bytes of your input that the call accepted.
  pub consumed: usize,
  /// The framed bytes that the call sent to the transport.
  pub written: usize,
  /// The total body bytes accepted so far.
  pub totalPayload: u64,
  /// The total framed bytes sent so far.
  pub totalWire: u64,
}

impl Copy for WriteProgress {}

impl Debug for WriteProgress {
  /// Writes the fields, as `WriteProgress { consumed: ..., written: ..., ... }`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return run Format.debugFields(self, "WriteProgress", &mut formatter)
  }
}

/// An HTTP/1 connection over the transport `P`. It keeps its buffers and the bytes that it read
/// after the last response.
///
/// # When to use
///
/// Use it to stream a request or a response body, or to reuse a connection. Make one with
/// [`makeOwned`], [`withOwned`], or [`withConnected`], or let [`withRoute`] connect through a proxy
/// route. Then call [`withExchange`] for each request. Most programs use `silk.http.client` or
/// `silk.http.fetch` instead.
///
/// # Details
///
/// A connection runs one exchange at a time. In the callback of [`withExchange`], call the steps in
/// order: [`send`], then [`writeSome`] and [`finishRequest`], then [`receive`] or [`receiveFinal`]
/// and [`readSome`] or [`readContentSome`], then [`finishResponse`].
///
/// # Gotchas
///
/// If an exchange callback fails or returns before the response is complete, the connection closes
/// and is not used again. Nothing is flushed, drained, or sent again for you.
pub struct Connection<P> {
  transport: P,
  origin: Origin,
  version: Version,
  overallDeadline: Option<Instant>,
  input: Bytes,
  start: usize,
  end: usize,
  eof: bool,
  scratch: Bytes,
  requestParser: RequestParser,
  responseParser: ResponseParser,
  parserUsed: bool,
  limits: Limits,
  phaseValue: ConnectionPhase,
  closeAuthority: CloseAuthority,
  requests: usize,
}

enum CloseAuthority {
  Armed,
  Transferred,
  Closed,
}

impl<P> Connection<P> {
  /// Returns the state of the connection.
  pub fn phase(self: &Self) -> ConnectionPhase {
    return self.phaseValue
  }
  /// Returns the number of bytes that were read after the last response.
  pub fn unread(self: &Self) -> usize {
    return self.end - self.start
  }
}

/// Returns whether the connection can go back to a pool.
///
/// `Eligible` needs a `Ready` connection that owns its transport, has requests left, and has no
/// extra bytes. Other values tell the first check that failed.
pub fn reuseEligibility<P>(connection: &Connection<P>) -> ReuseEligibility {
  if connection.closeAuthority != CloseAuthority.Armed {
    return ReuseEligibility.NotOwned
  }
  if connection.phaseValue != ConnectionPhase.Ready {
    return ReuseEligibility.NotReady
  }
  if connection.requests >= connection.limits.maxRequests {
    return ReuseEligibility.RequestLimit
  }
  let retained = connection.end - connection.start
  if retained > usize.ZERO {
    return ReuseEligibility.RetainedInput {bytes: retained}
  }
  return ReuseEligibility.Eligible
}

/// A shared view of the transport of a connection, to inspect its route.
pub struct TransportContext<'view, P> {
  /// The transport.
  pub transport: &'view P,
}

impl<P> Connection<P> {
  /// Returns a shared view of the transport.
  pub fn transportContext<'view>(self: &'view Self) -> TransportContext<'view, P> {
    return TransportContext<'view, P> {transport: &self.transport}
  }
}

/// One request and its response on a connection. You get it in the callback of [`withExchange`].
pub struct Exchange<'exchange, P> {
  connection: &'exchange mut Connection<P>,
  encoder: Encoder,
  decoder: Option<Decoder>,
  contentDecoder: Option<Box<ContentDecoder>>,
  bodySelected: bool,
  contentSelected: bool,
  options: RequestOptions,
  phaseValue: ExchangePhase,
  headBytes: Bytes,
  requestComplete: bool,
  responseDelimited: bool,
  responseWireTotal: u64,
  requestPayloadTotal: u64,
  requestWireTotal: u64,
  reusable: bool,
  informationalCount: usize,
  informationalWire: u64,
  responseHeadUsed: bool,
  callbackSucceeded: bool,
}

impl<'exchange, P> Exchange<'exchange, P> {
  /// Returns the next step.
  pub fn phase(self: &Self) -> ExchangePhase {
    return self.phaseValue
  }
  /// Returns the last response head that was received. Copy it with `ResponseHead.copy` to keep it.
  pub effect fn head<'head>(self: &'head Self) -> ResponseHead<'head> ! ExchangeError {
    if !self.responseHeadUsed {
      fail ExchangeError.InvalidState
    }
    return match move ResponseParser.head(&self.connection.responseParser) {
      Result.Failure {error} => {
        fail ExchangeError.Head {error: move error}
      }
      Result.Success {value} => value
    }
  }
}

/// The code that uses a connection in [`withOwned`] or [`withConnected`]. It cannot keep the
/// connection.
pub interface ConnectionHandler<P, A, E, ?R> {
  /// Uses the connection. The connection is closed or kept after this call returns.
  effect<'call> fn handle<'call>(handler: Self, connection: &'call mut Connection<P>) -> A ! E ? R where
    &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut P provides &HttpTransport from &mut HttpTransport
}

/// The HTTP version, and the ALPN that TLS sends, for a route.
pub enum RouteProtocol {
  /// Use HTTP/1.0, and send no ALPN.
  Http10,
  /// Use HTTP/1.1. The TLS server can choose no ALPN protocol.
  OptionalHttp11,
  /// Use HTTP/1.1. The TLS server must choose `http/1.1`.
  RequiredHttp11,
}

/// The settings for [`withRoute`].
pub struct RouteSettings {
  /// The limits of the connection.
  pub http: Limits,
  /// The value limits for the `CONNECT` request to a proxy.
  pub request: HeaderLimits,
  /// The maximum size of the `CONNECT` head.
  pub maxRequestHeadBytes: usize,
  /// The maximum size of the proxy credentials in the `CONNECT` head.
  pub maxProxyCredentialBytes: usize,
  /// The HTTP version and ALPN.
  pub protocol: RouteProtocol,
  /// The limits of the TLS client.
  pub tls: ClientLimits,
  /// The maximum duration of the TLS handshake, in nanoseconds.
  pub handshakeDurationNanoseconds: u64,
}

impl Copy for RouteSettings {}

/// The service that a [`RouteClient`] calls with the transport that it opened.
pub service AcquiredRouteContext<P, A, E, ?R> {
  /// Uses `provider`, the transport to the server that the route selected.
  effect<'env> fn use<'env>(provider: P) -> A ! E ? R | &mut AcquiredRouteContext<P, A, E, R> where
    &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut P provides &HttpTransport from &mut HttpTransport,
    &mut P provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut P provides &ByteDuplex from &mut ByteDuplex,
    R in Without<R, ByteDuplex>,
    R in Without<R, HttpTransport>
}

/// Opens transports for [`withRoute`]: a direct connection or a connection to a proxy.
pub interface RouteClient<P, A, E, AcquisitionError, ?AcquisitionRequirements, ?R> {
  /// Returns the HTTP and TLS settings. No default is added.
  fn settings(client: &Self) -> RouteSettings
  /// Opens a transport to `peer` before `deadline`, and gives it to [`AcquiredRouteContext.use`].
  effect<'env> fn acquire<'env>(client: Self, peer: Origin, deadline: Option<Instant>) -> A ! E | AcquisitionError ? AcquisitionRequirements | R | &mut AcquiredRouteContext<
    P,
    A,
    E,
    R,
  > where R in Without<R, ByteDuplex>, R in Without<R, HttpTransport>
}

/// The transport that [`withRoute`] gives to your handler.
pub struct RouteTransport<'transport, 'provider: 'transport, 'tunnel: 'provider, P> {
  state: RouteTransportState<'transport, 'provider, 'tunnel, P>,
}

union RouteTransportState<'transport, 'provider: 'transport, 'tunnel: 'provider, P> {
  /// A plain connection, direct or to a forward proxy.
  Plain {provider: Loan<'provider, P>},
  /// A TLS connection directly to the origin.
  SecuredDirect {provider: Secured<'transport, Loan<'provider, P>>},
  /// A TLS connection to the origin through a `CONNECT` tunnel.
  SecuredTunnel {provider: Secured<'transport, Loan<'provider, TransferredTunnel<'tunnel, P>>>},
}

/// The code that uses the connection of [`withRoute`].
pub interface RouteHandler<'configuration, P, A, E, ?R> {
  /// Uses the connection after it is open, and after TLS checked the origin.
  effect<'call> fn handle<'call, 'transport: 'call, 'provider: 'transport, 'tunnel: 'provider>(
    handler: Self,
    route: Route<'configuration>,
    connection: &'call mut Connection<RouteTransport<'transport, 'provider, 'tunnel, P>>,
  ) -> A ! E ? R where
    &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut P provides &HttpTransport from &mut HttpTransport,
    &mut P provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut P provides &ByteDuplex from &mut ByteDuplex
}

impl<'transport, 'provider: 'transport, 'tunnel: 'provider, P> RouteTransport<
  'transport,
  'provider,
  'tunnel,
  P,
> {
  effect fn read(self: &mut Self, output: &mut [u8], deadline: Option<Instant>) -> ReadTransfer
  ! TransportError | OutOfMemoryError
  ? &mut MonotonicClock | &mut Allocator | &mut Random
  where
    &mut P provides &HttpTransport from &mut HttpTransport,
    &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut P provides &ByteDuplex from &mut ByteDuplex,
    &mut P provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random {
    return match &mut self.state {
      RouteTransportState<'transport, 'provider, 'tunnel, P>.Plain {provider} => run HttpTransport.readSome(
        move output,
        move deadline,
      )
        |> Effect.provideMut<HttpTransport>(&mut provider)
      RouteTransportState<'transport, 'provider, 'tunnel, P>.SecuredDirect {provider} => run HttpTransport.readSome(
        move output,
        move deadline,
      )
        |> Effect.provideMut<HttpTransport>(&mut provider)
      RouteTransportState<'transport, 'provider, 'tunnel, P>.SecuredTunnel {provider} => run HttpTransport.readSome(
        move output,
        move deadline,
      )
        |> Effect.provideMut<HttpTransport>(&mut provider)
    }
  }
  effect fn write(self: &mut Self, input: &[u8], deadline: Option<Instant>) -> usize
  ! TransportError | OutOfMemoryError
  ? &mut MonotonicClock | &mut Allocator | &mut Random
  where
    &mut P provides &HttpTransport from &mut HttpTransport,
    &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut P provides &ByteDuplex from &mut ByteDuplex,
    &mut P provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random {
    return match &mut self.state {
      RouteTransportState<'transport, 'provider, 'tunnel, P>.Plain {provider} => run HttpTransport.writeSome(
        move input,
        move deadline,
      )
        |> Effect.provideMut<HttpTransport>(&mut provider)
      RouteTransportState<'transport, 'provider, 'tunnel, P>.SecuredDirect {provider} => run HttpTransport.writeSome(
        move input,
        move deadline,
      )
        |> Effect.provideMut<HttpTransport>(&mut provider)
      RouteTransportState<'transport, 'provider, 'tunnel, P>.SecuredTunnel {provider} => run HttpTransport.writeSome(
        move input,
        move deadline,
      )
        |> Effect.provideMut<HttpTransport>(&mut provider)
    }
  }
  effect fn flushOutput(self: &mut Self, deadline: Option<Instant>) -> ()
  ! TransportError | OutOfMemoryError
  ? &mut MonotonicClock | &mut Allocator | &mut Random
  where
    &mut P provides &HttpTransport from &mut HttpTransport,
    &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut P provides &ByteDuplex from &mut ByteDuplex,
    &mut P provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random {
    return match &mut self.state {
      RouteTransportState<'transport, 'provider, 'tunnel, P>.Plain {provider} => run HttpTransport.flush(
        move deadline,
      )
        |> Effect.provideMut<HttpTransport>(&mut provider)
      RouteTransportState<'transport, 'provider, 'tunnel, P>.SecuredDirect {provider} => run HttpTransport.flush(
        move deadline,
      )
        |> Effect.provideMut<HttpTransport>(&mut provider)
      RouteTransportState<'transport, 'provider, 'tunnel, P>.SecuredTunnel {provider} => run HttpTransport.flush(
        move deadline,
      )
        |> Effect.provideMut<HttpTransport>(&mut provider)
    }
  }
  effect fn closeTransport(self: &mut Self) -> ()
  ! TransportError
  where
    &mut P provides &HttpTransport from &mut HttpTransport,
    &mut P provides &ByteDuplex from &mut ByteDuplex {
    return match &mut self.state {
      RouteTransportState<'transport, 'provider, 'tunnel, P>.Plain {provider} => run HttpTransport.close()
        |> Effect.provideMut<HttpTransport>(&mut provider)
      RouteTransportState<'transport, 'provider, 'tunnel, P>.SecuredDirect {provider} => run HttpTransport.close()
        |> Effect.provideMut<HttpTransport>(&mut provider)
      RouteTransportState<'transport, 'provider, 'tunnel, P>.SecuredTunnel {provider} => run HttpTransport.close()
        |> Effect.provideMut<HttpTransport>(&mut provider)
    }
  }
}

impl<'transport, 'provider: 'transport, 'tunnel: 'provider, P> HttpTransport for RouteTransport<
  'transport,
  'provider,
  'tunnel,
  P,
>
where
  &mut P provides &HttpTransport from &mut HttpTransport,
  &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut P provides &ByteDuplex from &mut ByteDuplex,
  &mut P provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random {
  readSomeRaw: RouteTransport.read
  writeSomeRaw: RouteTransport.write
  flush: RouteTransport.flushOutput
  close: RouteTransport.closeTransport
}

struct FinalRouteContext<'configuration, H> {
  route: Route<'configuration>,
  handler: H,
}

fn routeVersion(protocol: RouteProtocol) -> Version {
  return match protocol {
    RouteProtocol.Http10 => Version.Http10
    RouteProtocol.OptionalHttp11 => Version.Http11
    RouteProtocol.RequiredHttp11 => Version.Http11
  }
}

fn routeAlpn<'a>(protocols: &'a [AlpnProtocol<'a>], policy: RouteProtocol) -> AlpnConfig<'a> {
  return match policy {
    RouteProtocol.Http10 => AlpnConfig<'a>.Disabled
    RouteProtocol.OptionalHttp11 => AlpnConfig<'a>.Offered {protocols: protocols, required: false}
    RouteProtocol.RequiredHttp11 => AlpnConfig<'a>.Offered {protocols: protocols, required: true}
  }
}

fn copyRouteDomain(host: &Host, output: &mut [u8]) -> usize {
  return match & host.* {
    Host.Domain {value} => {
      let bytes = DomainHost.bytes(&value)
      let mut index = usize.ZERO
      while index < bytes.length {
        output[index] = bytes[index]
        index = index + usize.ONE
      }
      return bytes.length
    }
    Host.Ipv4 {value} => usize.ZERO
    Host.Ipv6 {value} => usize.ZERO
  }
}

