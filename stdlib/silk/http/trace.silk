//! Opt-in propagation of W3C trace context on HTTP requests.

import silk.core.option { Option }
import silk.http.client { Request }
import silk.http.head { RequestHead }
import silk.http.headers { headerNamesEqual }
import silk.http.message { Header }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }
import silk.trace { SpanContext, SpanGuard, SpanKind, Trace, Tracer }

/// Sets a single traceparent header from the current span, including when it is unsampled.
pub effect fn inject<'a>(request: &mut Request<'a>) -> () ! OutOfMemoryError ? &mut Allocator {
  if let Option<SpanContext>.Some {value} = Trace.current() {
    let header = Trace.traceparent(&value)
    run request.setHeader("traceparent", header.view())
  }
}

/// Returns a valid remote parent from the request head. Duplicate fields are invalid.
pub fn extract<'a>(head: &RequestHead<'a>) -> Option<SpanContext> {
  let mut fields = head.fields()
  let mut parent = Option<SpanContext>.none()
  let mut found = false
  while true {
    let header = match fields.next() {
      Option<Header<'a>>.Some {value} => value
      Option<Header<'a>>.None => { return move parent }
    }
    if headerNamesEqual(header.name(), "traceparent") {
      if found { return Option<SpanContext>.none() }
      found = true
      parent = Trace.parseTraceparent(String.fromUtf8(header.value()).unwrapOr(""))
    }
  }
}

/// Opens a server span and uses a valid incoming traceparent as its remote parent.
pub fn serverSpan<'a>(head: &RequestHead<'a>, static name: string<'static>) -> SpanGuard {
  static if Intrinsic.ambientCount<Tracer>() > 0 {
    if let Option<SpanContext>.Some {value} = extract(head) { return Trace.spanFrom(&value, name) }
  }
  return Trace.spanOf(name, SpanKind.Server)
}
