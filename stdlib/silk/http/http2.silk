//! A transport-independent HTTP/2 connection for clients and servers (RFC 9113).
//!
//! Feed incoming bytes to `Connection.receive`, send `Connection.output`, and acknowledge sent bytes
//! with `Connection.consumeOutput`. Each call returns at most one application event. Keep calling
//! with the unconsumed input. SETTINGS and PING acknowledgments are queued automatically.
//!
//! DATA uses connection and stream flow control. Call `Connection.release` only after consuming
//! received data. A zero return from `Connection.sendData` means flow control or queued output blocks progress.
//! Streams can progress independently. Field blocks remain contiguous on the wire.
//!
//! Use prior knowledge on cleartext transports. On TLS, select `h2` with ALPN before creating this
//! connection. The obsolete HTTP/1.1 Upgrade handshake is not part of RFC 9113.
//!
//! # Examples
//! ## Queue two requests on one connection
//! ```silk
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.core.effect { Effect }
//! import silk.http.hpack { Field }
//! import silk.http.http2 { Connection, Limits, Role }
//! import silk.http.http2_frame { ProtocolError }
//! import silk.num.u32
//! import silk.num.usize
//!
//! effect fn requests() -> i32
//!   ! ProtocolError | OutOfMemoryError
//!   ? &mut Allocator {
//!   let mut connection = run Connection.make(Role.Client, Limits.defaults())
//!   let fields = [
//!     Field { name: b":method", value: b"GET", sensitive: false },
//!     Field { name: b":scheme", value: b"https", sensitive: false },
//!     Field { name: b":authority", value: b"example.com", sensitive: false },
//!     Field { name: b":path", value: b"/", sensitive: false }
//!   ]
//!   let first = run Connection.open(&mut connection, &fields, true)
//!   let second = run Connection.open(&mut connection, &fields, true)
//!
//!   // Send these queued bytes over the authenticated h2 transport.
//!   let wire = Connection.output(&connection)
//!   if first != 1 || second != 3 || wire.length < 24 {
//!     return 1
//!   }
//!   return 0
//! }
//!
//! effect fn failed<E>(error: E) -> i32 {
//!   drop error
//!   return 1
//! }
//!
//! pub fn main() -> i32 {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   return run Effect.catchAll(requests(), failed) |> Effect.provideMut<Allocator>(&mut allocator)
//! }
//! ```
//!
//! @category HTTP

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.http.hpack { Decoder, Encoder, Field, Header, HpackError }
import silk.http.http2_frame as Frame
import silk.http.http2_frame { FrameHeader, ProtocolError }
import silk.http.http2_headers as Fields
import silk.http.http2_headers { Message, Section }
import silk.num.i64
import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.usize

/// The endpoint role. Clients allocate odd stream identifiers; servers allocate even identifiers for push.
pub enum Role {
  /// Sends the client preface and initiates requests.
  Client,
  /// Checks the client preface and accepts requests.
  Server,
}

/// Connection resource limits. The receiver advertises the applicable limits in SETTINGS.
pub struct Limits {
  /// Maximum simultaneous peer-initiated streams.
  pub streams: u32,

  /// Maximum accepted frame payload, from 16384 through 16777215 bytes.
  pub frameBytes: u32,

  /// Maximum decoded field count per block.
  pub fields: usize,

  /// Maximum decoded field-list size, including 32 bytes per field.
  pub headerBytes: u32,

  /// Maximum compressed field block bytes across HEADERS and CONTINUATION frames.
  pub compressedBytes: usize,

  /// Maximum HPACK dynamic table bytes.
  pub tableBytes: u32,

  /// Initial receive window for each stream, at most 2147483647 bytes.
  pub windowBytes: u32,

  /// Maximum unsent wire bytes. Drain output before queuing more application data.
  pub outputBytes: usize,

  /// Whether a client accepts push for the exact authority and scheme of the associated request. Servers ignore this field.
  pub push: bool,
}

impl Copy for Limits {}

impl Limits {
  /// Returns limits of 100 streams, 16 KiB frames, 64 KiB field lists, and 1 MiB queued output.
  pub fn defaults() -> Limits {
    return Limits {
      streams: 100,
      frameBytes: 16384,
      fields: 128,
      headerBytes: 65536,
      compressedBytes: 262144,
      tableBytes: 4096,
      windowBytes: 65535,
      outputBytes: 1048576,
      push: false
    }
  }
}

/// One event from the peer. DATA storage belongs to the event until the application drops it.
pub union Event {
  /// No application event. Continue with the unconsumed input, or wait for more bytes.
  None,
  /// A complete initial, informational, or trailing field section.
  Headers {
    /// The stream identifier.
    pub stream: u32,
    /// Decoded fields in wire order.
    pub fields: List<Header>,
    /// True if this section ends the peer's side of the stream.
    pub endStream: bool,
  },
  /// Stream body bytes with frame padding removed.
  Data {
    /// The stream identifier.
    pub stream: u32,
    /// The body bytes. Call `release` after consuming them.
    pub bytes: Bytes,
    /// True if the peer finished this stream.
    pub endStream: bool,
  },
  /// A server push request. A client can reject it with `reset`.
  Push {
    /// The associated request stream.
    pub stream: u32,
    /// The promised even stream identifier.
    pub promised: u32,
    /// The promised request fields.
    pub fields: List<Header>,
  },
  /// The peer reset one stream.
  Reset {
    /// The reset stream.
    pub stream: u32,
    /// The wire error code, including unknown extension codes.
    pub code: u32,
  },
  /// A PING acknowledgment with its opaque payload.
  Pong {
    /// The eight bytes supplied by the peer.
    pub bytes: Bytes,
  },
  /// The peer started graceful shutdown. Existing eligible streams can still finish.
  Goaway {
    /// The last locally initiated stream the peer might have processed.
    pub lastStream: u32,
    /// The peer's wire error code.
    pub code: u32,
    /// Opaque diagnostic bytes.
    pub debug: Bytes,
  },
  /// The peer's settings changed or it acknowledged local settings.
  Settings,
  /// A rejected stream. RST_STREAM is queued; other streams remain usable.
  StreamError {
    /// The rejected stream identifier.
    pub stream: u32,
    /// The wire error code.
    pub code: u32,
  },
  /// The peer granted connection or stream send credit.
  Writable,
}

/// The result of feeding incoming wire bytes.
pub struct Progress {
  /// Bytes consumed from the supplied input.
  pub consumed: usize,

  /// At most one complete event.
  pub event: Event,
}

struct Stream {
  id: u32,
  local: bool,
  remote: bool,
  reservedLocal: bool,
  reservedRemote: bool,
  sentFinal: bool,
  receivedFinal: bool,
  sendWindow: i64,
  receiveWindow: i64,
  uncredited: u32,
  sent: u64,
  received: u64,
  sendLength: u64,
  receiveLength: u64,
  hasSendLength: bool,
  hasReceiveLength: bool,
  sendNoBody: bool,
  receiveNoBody: bool,
  head: bool,
  connect: bool,
  tunnel: bool,
  resetSent: bool,
}

impl Copy for Stream {}

fn stream(id: u32, sendWindow: u32, receiveWindow: u32) -> Stream {
  return Stream {
    id: id,
    local: true,
    remote: true,
    reservedLocal: false,
    reservedRemote: false,
    sentFinal: false,
    receivedFinal: false,
    sendWindow: u32.toI64(sendWindow),
    receiveWindow: u32.toI64(receiveWindow),
    uncredited: 0,
    sent: 0,
    received: 0,
    sendLength: 0,
    receiveLength: 0,
    hasSendLength: false,
    hasReceiveLength: false,
    sendNoBody: false,
    receiveNoBody: false,
    head: false,
    connect: false,
    tunnel: false,
    resetSent: false
  }
}

struct RequestOrigin {
  stream: u32,
  authority: Bytes,
  scheme: Bytes,
}

/// An owned HTTP/2 state machine. It does no I/O and needs no compiler or native protocol support.
/// Connection errors queue GOAWAY and make the connection terminal. Stream errors queue RST_STREAM.
pub struct Connection {
  client: bool,
  limits: Limits,
  decoder: Decoder,
  encoder: Encoder,
  streams: List<Stream>,
  origins: List<RequestOrigin>,
  input: Bytes,
  wire: Bytes,
  outputOffset: usize,
  preface: usize,
  lastConsumed: usize,
  first: bool,
  terminal: bool,
  settingsOutstanding: bool,
  lastLocal: u32,
  lastRemote: u32,
  sentGoaway: bool,
  sentLast: u32,
  receivedGoaway: bool,
  peerLast: u32,
  peerStreams: u32,
  peerFrame: u32,
  peerHeaders: u32,
  peerWindow: u32,
  peerPush: bool,
  sendWindow: i64,
  receiveWindow: i64,
  uncredited: u32,
  block: Bytes,
  blockStream: u32,
  blockPromised: u32,
  blockEnd: bool,
  blockError: u32,
}

impl Connection {
  /// Creates a connection and queues its preface and initial SETTINGS.
  /// Invalid limits fail with PROTOCOL_ERROR. TLS callers must first verify ALPN selected `h2`.
  pub effect fn make(endpoint: Role, limits: Limits) -> Connection
    ! ProtocolError | OutOfMemoryError
    ? &mut Allocator {
    if limits.frameBytes < 16384 || limits.frameBytes > 16777215 || limits.windowBytes > 2147483647
      || limits.outputBytes < 64
      || limits.compressedBytes == 0
      || limits.headerBytes < 32
      || limits.fields == 0 {
      fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: 0 }
    }
    let client = match endpoint {
      Role.Client => true
      Role.Server => false
    }
    let mut connection = Connection {
      client: client,
      limits: limits,
      decoder: Decoder.make(4096, limits.fields, u32.toUsize(limits.headerBytes)),
      encoder: Encoder.make(4096),
      streams: List<Stream>.make(),
      origins: List<RequestOrigin>.make(),
      input: Bytes.make(),
      wire: Bytes.make(),
      outputOffset: 0,
      preface: 0,
      lastConsumed: 0,
      first: true,
      terminal: false,
      settingsOutstanding: true,
      lastLocal: 0,
      lastRemote: 0,
      sentGoaway: false,
      sentLast: 0,
      receivedGoaway: false,
      peerLast: 2147483647,
      peerStreams: 4294967295,
      peerFrame: 16384,
      peerHeaders: 4294967295,
      peerWindow: 65535,
      peerPush: true,
      sendWindow: 65535,
      receiveWindow: 65535,
      uncredited: 0,
      block: Bytes.make(),
      blockStream: 0,
      blockPromised: 0,
      blockEnd: false,
      blockError: 0,
    }
    if client {
      run Bytes.append(&mut connection.wire, Frame.preface())
    }
    let mut settings = Bytes.make()
    run setting(&mut settings, 1, limits.tableBytes)
    if client {
      let mut push: u32 = 0
      if limits.push {
        push = 1
      }
      run setting(&mut settings, 2, push)
    }
    run setting(&mut settings, 3, limits.streams)
    run setting(&mut settings, 4, limits.windowBytes)
    run setting(&mut settings, 5, limits.frameBytes)
    run setting(&mut settings, 6, limits.headerBytes)
    run queue(&mut connection, 4, 0, 0, Bytes.asSlice(&settings))
    return move connection
  }

  /// Borrows all unsent bytes. Send them in order before calling `consumeOutput`.
  pub fn output(self: &Self) -> &[u8] {
    return Slice.view(
      Bytes.asSlice(&self.wire),
      self.outputOffset,
      Bytes.length(&self.wire) - self.outputOffset
    )
  }

  /// Marks bytes as sent. A count beyond the available output fails with PROTOCOL_ERROR.
  pub effect fn consumeOutput(self: &mut Self, count: usize) -> ()
    ! ProtocolError {
    if count > Bytes.length(&self.wire) - self.outputOffset {
      fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: 0 }
    }
    self.outputOffset = self.outputOffset + count
    if self.outputOffset == Bytes.length(&self.wire) {
      Bytes.clear(&mut self.wire)
      self.outputOffset = 0
    }
  }

  /// True after a connection error. Drain the queued GOAWAY, then close the transport.
  pub fn failed(self: &Self) -> bool {
    return self.terminal
  }

  /// Consumes a wire fragment and returns at most one event. Partial frames are retained within the frame limit.
  /// Stream errors queue RST_STREAM; connection errors queue GOAWAY and reject subsequent input.
  pub effect<'call> fn receive<'call>(self: &'call mut Self, input: &'call [u8]) -> Progress
    ! ProtocolError | OutOfMemoryError
    ? &mut Allocator {
    if self.terminal {
      fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: 0 }
    }
    let result = run Effect.result(receive(&mut self.*, input))
    return match move result {
      Result.Success { value } => move value
      Result.Failure { error } => match move error {
        ProtocolError failure => {
          if failure.stream == 0 {
            self.terminal = true
            run goaway(&mut self.*, failure.code, b"")
          } else {
            run reset(&mut self.*, failure.stream, failure.code)
            return Progress {
              consumed: self.lastConsumed,
              event: Event.StreamError { stream: failure.stream, code: failure.code }
            }
          }
          fail failure
        }
        OutOfMemoryError failure => {
          self.terminal = true
          fail move failure
        }
      }
    }
  }

  /// Reports EOF. A truncated preface, frame, field block, or open stream fails with PROTOCOL_ERROR.
  pub effect fn finishInput(self: &mut Self) -> ()
    ! ProtocolError {
    if self.first || Bytes.length(&self.input) != 0 || self.blockStream != 0
      || active(&self.*, false) != 0
      || active(&self.*, true) != 0 {
      self.terminal = true
      fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: 0 }
    }
  }

  /// Opens a client request stream. GOAWAY, exhausted identifiers, and peer stream limits refuse new streams.
  pub effect fn open(self: &mut Self, fields: &[Field], endStream: bool) -> u32
    ! ProtocolError | OutOfMemoryError
    ? &mut Allocator {
    if !self.client || self.terminal || self.sentGoaway || self.receivedGoaway
      || self.lastLocal >= 2147483647
      || active(&self.*, true) >= self.peerStreams {
      fail ProtocolError { code: Frame.REFUSED_STREAM, stream: 0 }
    }
    let mut id: u32 = 1
    if self.lastLocal != 0 {
      id = self.lastLocal + 2
    }
    let message = run Fields.validate(fields, Section.Request, id)
    if endStream && message.hasLength && message.length != 0 {
      fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: id }
    }
    run room(&mut self.*, fields, 0)
    let mut value = stream(id, self.peerWindow, receiveWindow(&self.*))
    value.head = message.head
    value.connect = message.connect
    value.sentFinal = true
    value.hasSendLength = message.hasLength
    value.sendLength = message.length
    value.local = !endStream
    prune(&mut self.*)
    run List.append(&mut self.streams, value)
    self.lastLocal = id
    run saveOrigin(&mut self.*, id, fields)
    run headers(&mut self.*, id, 0, fields, endStream)
    return id
  }

  /// Queues response fields or trailers on an existing stream. Trailers must end the stream.
  /// Informational responses leave the stream ready for a final response and cannot end it.
  pub effect fn sendHeaders(self: &mut Self, id: u32, fields: &[Field], endStream: bool) -> ()
    ! ProtocolError | OutOfMemoryError
    ? &mut Allocator {
    let index = find(&self.*, id)
    if self.terminal || index == List.length(&self.streams) {
      fail ProtocolError { code: Frame.STREAM_CLOSED, stream: id }
    }
    let mut value = List.get(&self.streams, index)
    if !value.local {
      fail ProtocolError { code: Frame.STREAM_CLOSED, stream: id }
    }
    let mut section = Section.Response
    if value.sentFinal {
      section = Section.Trailers
    }
    let message = run Fields.validate(fields, move section, id)
    if value.tunnel {
      fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: id }
    }
    if value.sentFinal {
      if !endStream || (value.hasSendLength && value.sent != value.sendLength) {
        fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: id }
      }
    } else {
      if self.client || (message.status < 200 && endStream) {
        fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: id }
      }
      if message.status >= 200 {
        value.sentFinal = true
        value.sendNoBody = value.head || message.status == 204 || message.status == 304
        value.hasSendLength = message.hasLength && !value.sendNoBody
        value.sendLength = message.length
        if value.connect && message.status >= 200 && message.status < 300 {
          value.tunnel = true
          value.sendNoBody = false
          value.hasReceiveLength = false
          if message.hasLength {
            fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: id }
          }
        }
      }
    }
    if endStream && value.hasSendLength && value.sent != value.sendLength {
      fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: id }
    }
    if value.reservedLocal && concurrent(&self.*, true) >= self.peerStreams {
      fail ProtocolError { code: Frame.REFUSED_STREAM, stream: id }
    }
    run room(&mut self.*, fields, 0)
    value.reservedLocal = false
    if endStream {
      value.local = false
    }
    run headers(&mut self.*, id, 0, fields, endStream)
    List.set(&mut self.streams, index, value)
  }

  /// Queues as many body bytes as flow control, the frame size, and output space allow.
  /// END_STREAM is sent only when all input bytes fit. A zero return with nonempty input means backpressure.
  pub effect fn sendData(self: &mut Self, id: u32, input: &[u8], endStream: bool) -> usize
    ! ProtocolError | OutOfMemoryError
    ? &mut Allocator {
    let index = find(&self.*, id)
    if self.terminal || index == List.length(&self.streams) {
      fail ProtocolError { code: Frame.STREAM_CLOSED, stream: id }
    }
    let mut value = List.get(&self.streams, index)
    if !value.local || !value.sentFinal || value.reservedLocal || value.reservedRemote {
      fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: id }
    }
    if value.sendNoBody && input.length != 0 {
      fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: id }
    }
    let mut length = input.length
    if length > u32.toUsize(self.peerFrame) {
      length = u32.toUsize(self.peerFrame)
    }
    if input.length > 0 {
      if self.sendWindow <= 0 || value.sendWindow <= 0 {
        return 0
      }
      if usize.toU64(length) > i64.toU64(self.sendWindow) {
        length = i64.toUsize(self.sendWindow)
      }
      if usize.toU64(length) > i64.toU64(value.sendWindow) {
        length = i64.toUsize(value.sendWindow)
      }
      let pending = Bytes.length(&self.wire) - self.outputOffset
      if self.limits.outputBytes - pending <= 9 {
        return 0
      }
      if length > self.limits.outputBytes - pending - 9 {
        length = self.limits.outputBytes - pending - 9
      }
    }
    if usize.toU64(length) > u64.MAX - value.sent {
      fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: id }
    }
    let total = value.sent + usize.toU64(length)
    let finish = endStream && length == input.length
    if value.hasSendLength && (total > value.sendLength || (finish && total != value.sendLength)) {
      fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: id }
    }
    let mut flags: u8 = 0
    if finish {
      flags = 1
    }
    run queue(&mut self.*, 0, flags, id, Slice.view(input, 0, length))
    self.sendWindow = self.sendWindow - usize.toI64(length)
    value.sendWindow = value.sendWindow - usize.toI64(length)
    value.sent = total
    if finish {
      value.local = false
    }
    List.set(&mut self.streams, index, value)
    return length
  }

  /// Returns consumed DATA credit to the peer. Padding credit is returned automatically.
  /// The count cannot exceed unreleased body bytes for this stream. Closed streams return connection credit only.
  pub effect fn release(self: &mut Self, id: u32, count: u32) -> ()
    ! ProtocolError | OutOfMemoryError
    ? &mut Allocator {
    let index = find(&self.*, id)
    if index == List.length(&self.streams) || count > self.uncredited {
      fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: id }
    }
    let mut value = List.get(&self.streams, index)
    if count > value.uncredited {
      fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: id }
    }
    if count == 0 {
      return ()
    }
    run window(&mut self.*, 0, count)
    self.receiveWindow = self.receiveWindow + u32.toI64(count)
    self.uncredited = self.uncredited - count
    value.uncredited = value.uncredited - count
    if value.remote {
      run window(&mut self.*, id, count)
      value.receiveWindow = value.receiveWindow + u32.toI64(count)
    }
    List.set(&mut self.streams, index, value)
  }

  /// Cancels an existing stream and queues RST_STREAM. Queued incoming body credit is returned to the connection.
  pub effect fn reset(self: &mut Self, id: u32, code: u32) -> ()
    ! ProtocolError | OutOfMemoryError
    ? &mut Allocator {
    if id == 0 || idle(&self.*, id) {
      fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: 0 }
    }
    run reset(&mut self.*, id, code)
  }

  /// Sends a PING with exactly eight opaque bytes. Other lengths fail with FRAME_SIZE_ERROR.
  pub effect fn ping(self: &mut Self, bytes: &[u8]) -> ()
    ! ProtocolError | OutOfMemoryError
    ? &mut Allocator {
    if bytes.length != 8 {
      fail ProtocolError { code: Frame.FRAME_SIZE_ERROR, stream: 0 }
    }
    run queue(&mut self.*, 6, 0, 0, bytes)
  }

  /// Stops accepting new streams and queues GOAWAY. Existing streams can finish when the code is NO_ERROR.
  pub effect fn shutdown(self: &mut Self, code: u32, debug: &[u8]) -> ()
    ! ProtocolError | OutOfMemoryError
    ? &mut Allocator {
    run goaway(&mut self.*, code, debug)
    if code != 0 {
      self.terminal = true
    }
  }

  /// Fails the connection if the initial SETTINGS acknowledgment has not arrived by the caller's deadline.
  pub effect fn settingsTimeout(self: &mut Self) -> ()
    ! ProtocolError | OutOfMemoryError
    ? &mut Allocator {
    if self.settingsOutstanding {
      self.terminal = true
      run goaway(&mut self.*, Frame.SETTINGS_TIMEOUT, b"")
      fail ProtocolError { code: Frame.SETTINGS_TIMEOUT, stream: 0 }
    }
  }

  /// Reserves a server push stream and queues PUSH_PROMISE. The request must use GET or HEAD without a body.
  pub effect fn push(self: &mut Self, associated: u32, fields: &[Field]) -> u32
    ! ProtocolError | OutOfMemoryError
    ? &mut Allocator {
    let index = find(&self.*, associated)
    if self.client || self.terminal || !self.peerPush || self.sentGoaway || self.receivedGoaway
      || self.lastLocal >= 2147483646
      || index == List.length(&self.streams)
      || active(&self.*, true) >= self.peerStreams {
      fail ProtocolError { code: Frame.REFUSED_STREAM, stream: associated }
    }
    let parent = List.get(&self.streams, index)
    if !parent.local || associated % 2 == 0 {
      fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: associated }
    }
    let id = self.lastLocal + 2
    let message = run Fields.validate(fields, Section.Request, id)
    if message.connect || (message.hasLength && message.length != 0) || !safePush(fields) {
      fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: id }
    }
    run room(&mut self.*, fields, 4)
    let mut value = stream(id, self.peerWindow, receiveWindow(&self.*))
    value.remote = false
    value.reservedLocal = true
    value.receivedFinal = true
    value.head = message.head
    prune(&mut self.*)
    run List.append(&mut self.streams, value)
    self.lastLocal = id
    run headers(&mut self.*, associated, id, fields, false)
    return id
  }
}

fn find(self: &Connection, id: u32) -> usize {
  let values = List.asSlice(&self.streams)
  let mut index: usize = 0
  while index < values.length {
    if values[index].id == id {
      return index
    }
    index = index + 1
  }
  return values.length
}

fn local(self: &Connection, id: u32) -> bool {
  return (id % 2 == 1) == self.client
}

fn idle(self: &Connection, id: u32) -> bool {
  if local(&self.*, id) {
    return id > self.lastLocal
  }
  return id > self.lastRemote
}

fn active(self: &Connection, initiatedLocally: bool) -> u32 {
  let values = List.asSlice(&self.streams)
  let mut count: u32 = 0
  let mut index: usize = 0
  while index < values.length {
    let value = values[index]
    if (value.local || value.remote) && local(&self.*, value.id) == initiatedLocally {
      count = count + 1
    }
    index = index + 1
  }
  return count
}

fn prune(self: &mut Connection) -> () {
  let mut closed: usize = 0
  let mut index: usize = 0
  while index < List.length(&self.streams) {
    let value = List.get(&self.streams, index)
    if !value.local && !value.remote && value.uncredited == 0 {
      closed = closed + 1
    }
    index = index + 1
  }
  index = 0
  while closed > 32 && index < List.length(&self.streams) {
    let value = List.get(&self.streams, index)
    if !value.local && !value.remote && value.uncredited == 0 {
      let mut origin: usize = 0
      while origin < List.length(&self.origins) {
        if List.asSlice(&self.origins)[origin].stream == value.id {
          drop List.remove(&mut self.origins, origin)
          break
        }
        origin = origin + 1
      }
      drop List.remove(&mut self.streams, index)
      closed = closed - 1
    } else {
      index = index + 1
    }
  }
}

effect fn setting(output: &mut Bytes, id: u8, value: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let bytes = [u8.toU8(0), id]
  run Bytes.append(&mut output.*, &bytes)
  run Frame.write32(&mut output.*, value)
}

effect fn queue(self: &mut Connection, kind: u8, flags: u8, id: u32, payload: &[u8]) -> ()
  ! ProtocolError | OutOfMemoryError
  ? &mut Allocator {
  let pending = Bytes.length(&self.wire) - self.outputOffset
  if payload.length > self.limits.outputBytes - pending
    || self.limits.outputBytes - pending - payload.length < 9 {
    fail ProtocolError { code: Frame.ENHANCE_YOUR_CALM, stream: 0 }
  }
  if self.outputOffset != 0 {
    let compact = run Bytes.copy(Connection.output(&self.*))
    self.wire = move compact
    self.outputOffset = 0
  }
  let header = FrameHeader { length: payload.length, kind: kind, flags: flags, stream: id }
  run FrameHeader.write(&header, &mut self.wire, payload)
}

effect fn window(self: &mut Connection, id: u32, count: u32) -> ()
  ! ProtocolError | OutOfMemoryError
  ? &mut Allocator {
  let mut payload = Bytes.make()
  run Frame.write32(&mut payload, count)
  run queue(&mut self.*, 8, 0, id, Bytes.asSlice(&payload))
}

effect fn closeStream(self: &mut Connection, id: u32) -> ()
  ! ProtocolError | OutOfMemoryError
  ? &mut Allocator {
  let index = find(&self.*, id)
  if index < List.length(&self.streams) {
    let mut value = List.get(&self.streams, index)
    if value.uncredited > 0 {
      run window(&mut self.*, 0, value.uncredited)
      self.receiveWindow = self.receiveWindow + u32.toI64(value.uncredited)
      self.uncredited = self.uncredited - value.uncredited
      value.uncredited = 0
    }
    value.local = false
    value.remote = false
    value.reservedLocal = false
    value.reservedRemote = false
    List.set(&mut self.streams, index, value)
  }
}

effect fn reset(self: &mut Connection, id: u32, code: u32) -> ()
  ! ProtocolError | OutOfMemoryError
  ? &mut Allocator {
  let mut payload = Bytes.make()
  run Frame.write32(&mut payload, code)
  run queue(&mut self.*, 3, 0, id, Bytes.asSlice(&payload))
  run closeStream(&mut self.*, id)

  // Rejected promises and refused new streams still need to absorb frames already in flight.
  if find(&self.*, id) == List.length(&self.streams) && !idle(&self.*, id) {
    prune(&mut self.*)
    let mut closed = stream(id, self.peerWindow, receiveWindow(&self.*))
    closed.local = false
    closed.remote = false
    run List.append(&mut self.streams, closed)
  }
  let index = find(&self.*, id)
  if index < List.length(&self.streams) {
    let mut value = List.get(&self.streams, index)
    value.resetSent = true
    List.set(&mut self.streams, index, value)
  }
}

effect fn goaway(self: &mut Connection, code: u32, debug: &[u8]) -> ()
  ! ProtocolError | OutOfMemoryError
  ? &mut Allocator {
  if debug.length > u32.toUsize(self.peerFrame) - 8 {
    fail ProtocolError { code: Frame.FRAME_SIZE_ERROR, stream: 0 }
  }
  let mut payload = Bytes.make()
  if !self.sentGoaway {
    self.sentLast = self.lastRemote
  }
  run Frame.write32(&mut payload, self.sentLast)
  run Frame.write32(&mut payload, code)
  run Bytes.append(&mut payload, debug)
  run queue(&mut self.*, 7, 0, 0, Bytes.asSlice(&payload))
  self.sentGoaway = true
}

effect fn room(self: &mut Connection, fields: &[Field], extra: usize) -> ()
  ! ProtocolError {
  let mut size: usize = 0
  let mut encoded: usize = 32 + extra
  let mut index: usize = 0
  while index < fields.length {
    let field = fields[index]
    if field.name.length > usize.MAX - 64 - field.value.length {
      fail ProtocolError { code: Frame.ENHANCE_YOUR_CALM, stream: 0 }
    }
    let cost = field.name.length + field.value.length + 32
    if cost > u32.toUsize(self.peerHeaders) - size || cost > self.limits.outputBytes - encoded {
      fail ProtocolError { code: Frame.ENHANCE_YOUR_CALM, stream: 0 }
    }
    size = size + cost
    encoded = encoded + cost
    index = index + 1
  }
  let overhead = (encoded / u32.toUsize(self.peerFrame) + 1) * 9
  let available = self.limits.outputBytes - (Bytes.length(&self.wire) - self.outputOffset)
  if encoded > available || overhead > available - encoded {
    fail ProtocolError { code: Frame.ENHANCE_YOUR_CALM, stream: 0 }
  }
}

effect fn headers(
  self: &mut Connection,
  id: u32,
  promised: u32,
  fields: &[Field],
  endStream: bool
) -> ()
  ! ProtocolError | OutOfMemoryError
  ? &mut Allocator {
  let block = run Encoder.encode(&mut self.encoder, fields)
  let bytes = Bytes.asSlice(&block)
  let mut cursor: usize = 0
  let mut first = true
  while first || cursor < bytes.length {
    let mut payload = Bytes.make()
    let mut kind: u8 = 9
    let mut flags: u8 = 0
    if first {
      kind = 1
      if endStream {
        flags = 1
      }
      if promised != 0 {
        kind = 5
        run Frame.write32(&mut payload, promised)
      }
    }
    let mut count = bytes.length - cursor
    let capacity = u32.toUsize(self.peerFrame) - Bytes.length(&payload)
    if count > capacity {
      count = capacity
    }
    run Bytes.append(&mut payload, Slice.view(bytes, cursor, count))
    cursor = cursor + count
    if cursor == bytes.length {
      flags = flags | 4
    }
    run queue(&mut self.*, kind, flags, id, Bytes.asSlice(&payload))
    first = false
  }
}

fn safePush(fields: &[Field]) -> bool {
  let mut index: usize = 0
  while index < fields.length {
    if equal(fields[index].name, b":method") {
      return equal(fields[index].value, b"GET") || equal(fields[index].value, b"HEAD")
    }
    index = index + 1
  }
  return false
}

fn equal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut index: usize = 0
  while index < left.length {
    if left[index] != right[index] {
      return false
    }
    index = index + 1
  }
  return true
}

effect fn receive(self: &mut Connection, input: &[u8]) -> Progress
  ! ProtocolError | OutOfMemoryError
  ? &mut Allocator {
  let mut cursor: usize = 0
  self.lastConsumed = 0
  if !self.client {
    while self.preface < 24 && cursor < input.length {
      if input[cursor] != Frame.preface()[self.preface] {
        fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: 0 }
      }
      self.preface = self.preface + 1
      cursor = cursor + 1
      self.lastConsumed = cursor
    }
    if self.preface < 24 {
      return Progress { consumed: cursor, event: Event.None }
    }
  }
  let mut needed: usize = 9
  if Bytes.length(&self.input) >= 9 {
    let header = run FrameHeader.read(Slice.view(Bytes.asSlice(&self.input), 0, 9))
    needed = 9 + header.length
  }
  while cursor < input.length || Bytes.length(&self.input) == needed {
    let mut count = needed - Bytes.length(&self.input)
    if count > input.length - cursor {
      count = input.length - cursor
    }
    run Bytes.append(&mut self.input, Slice.view(input, cursor, count))
    cursor = cursor + count
    self.lastConsumed = cursor
    if Bytes.length(&self.input) < needed {
      break
    }
    let header = run FrameHeader.read(Slice.view(Bytes.asSlice(&self.input), 0, 9))
    if header.length > u32.toUsize(self.limits.frameBytes) {
      fail ProtocolError { code: Frame.FRAME_SIZE_ERROR, stream: 0 }
    }
    if self.first && (header.kind != 4 || header.flags & 1 != 0) {
      fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: 0 }
    }
    if self.blockStream != 0 && (header.kind != 9 || header.stream != self.blockStream) {
      fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: 0 }
    }
    needed = 9 + header.length
    if Bytes.length(&self.input) == needed {
      let payload = run Bytes.copy(Slice.view(Bytes.asSlice(&self.input), 9, header.length))
      Bytes.clear(&mut self.input)
      self.first = false
      let event = run frame(&mut self.*, header, Bytes.asSlice(&payload))
      return Progress { consumed: cursor, event: move event }
    }
  }
  return Progress { consumed: cursor, event: Event.None }
}

effect fn frame(self: &mut Connection, header: FrameHeader, payload: &[u8]) -> Event
  ! ProtocolError | OutOfMemoryError
  ? &mut Allocator {
  let id = header.stream
  let kind = header.kind
  if (kind == 0 || kind == 1 || kind == 2 || kind == 3 || kind == 5 || kind == 9) && id == 0 {
    fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: 0 }
  }
  if (kind == 4 || kind == 6 || kind == 7) && id != 0 {
    fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: 0 }
  }
  if kind == 4 {
    return run settings(&mut self.*, header, payload)
  }
  if kind == 6 {
    if payload.length != 8 {
      fail ProtocolError { code: Frame.FRAME_SIZE_ERROR, stream: 0 }
    }
    if header.flags & 1 == 0 {
      run queue(&mut self.*, 6, 1, 0, payload)
      return Event.None
    }
    return Event.Pong { bytes: run Bytes.copy(payload) }
  }
  if kind == 7 {
    if payload.length < 8 {
      fail ProtocolError { code: Frame.FRAME_SIZE_ERROR, stream: 0 }
    }
    let last = Frame.read32(payload, 0) & 2147483647
    if self.receivedGoaway && last > self.peerLast {
      fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: 0 }
    }
    self.receivedGoaway = true
    self.peerLast = last
    let mut index: usize = 0
    while index < List.length(&self.streams) {
      let value = List.get(&self.streams, index)
      if local(&self.*, value.id) && value.id > last {
        run closeStream(&mut self.*, value.id)
      }
      index = index + 1
    }
    return Event.Goaway {
      lastStream: last,
      code: Frame.read32(payload, 4),
      debug: run Bytes.copy(Slice.view(payload, 8, payload.length - 8))
    }
  }
  if kind == 8 {
    if payload.length != 4 {
      fail ProtocolError { code: Frame.FRAME_SIZE_ERROR, stream: 0 }
    }
    let amount = Frame.read32(payload, 0) & 2147483647
    if amount == 0 {
      fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: id }
    }
    if id == 0 {
      if self.sendWindow > 2147483647 - u32.toI64(amount) {
        fail ProtocolError { code: Frame.FLOW_CONTROL_ERROR, stream: 0 }
      }
      self.sendWindow = self.sendWindow + u32.toI64(amount)
    } else {
      if idle(&self.*, id) {
        fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: 0 }
      }
      let index = find(&self.*, id)
      if index < List.length(&self.streams) {
        let mut value = List.get(&self.streams, index)
        if value.reservedRemote {
          fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: 0 }
        }
        if value.local || value.remote {
          if value.sendWindow > 2147483647 - u32.toI64(amount) {
            fail ProtocolError { code: Frame.FLOW_CONTROL_ERROR, stream: id }
          }
          value.sendWindow = value.sendWindow + u32.toI64(amount)
          List.set(&mut self.streams, index, value)
        }
      }
    }
    return Event.Writable
  }
  if kind == 2 {
    if payload.length != 5 {
      fail ProtocolError { code: Frame.FRAME_SIZE_ERROR, stream: id }
    }
    if Frame.read32(payload, 0) & 2147483647 == id {
      fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: id }
    }
    return Event.None
  }
  if kind == 3 {
    if payload.length != 4 {
      fail ProtocolError { code: Frame.FRAME_SIZE_ERROR, stream: 0 }
    }
    if idle(&self.*, id) {
      fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: 0 }
    }
    run closeStream(&mut self.*, id)
    return Event.Reset { stream: id, code: Frame.read32(payload, 0) }
  }
  if kind == 0 {
    return run data(&mut self.*, header, payload)
  }
  if kind == 1 || kind == 5 || kind == 9 {
    return run fieldFrame(&mut self.*, header, payload)
  }
  return Event.None
}

effect fn settings(self: &mut Connection, header: FrameHeader, payload: &[u8]) -> Event
  ! ProtocolError | OutOfMemoryError
  ? &mut Allocator {
  if header.flags & 1 != 0 {
    if payload.length != 0 {
      fail ProtocolError { code: Frame.FRAME_SIZE_ERROR, stream: 0 }
    }
    if !self.settingsOutstanding {
      fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: 0 }
    }
    let delta = u32.toI64(self.limits.windowBytes) - 65535
    let mut index: usize = 0
    while index < List.length(&self.streams) {
      let mut value = List.get(&self.streams, index)
      if value.remote {
        value.receiveWindow = value.receiveWindow + delta
        List.set(&mut self.streams, index, value)
      }
      index = index + 1
    }
    Decoder.setMaximum(&mut self.decoder, u32.toUsize(self.limits.tableBytes))
    self.settingsOutstanding = false
    return Event.Settings
  }
  if payload.length % 6 != 0 {
    fail ProtocolError { code: Frame.FRAME_SIZE_ERROR, stream: 0 }
  }
  let mut cursor: usize = 0
  while cursor < payload.length {
    let id = u8.toU32(payload[cursor]) * 256 + u8.toU32(payload[cursor + 1])
    let value = Frame.read32(payload, cursor + 2)
    if id == 1 {
      let mut maximum = value
      if maximum > self.limits.tableBytes {
        maximum = self.limits.tableBytes
      }
      Encoder.setMaximum(&mut self.encoder, u32.toUsize(maximum))
    }
    if id == 2 {
      if (self.client && value != 0) || value > 1 {
        fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: 0 }
      }
      self.peerPush = value == 1
    }
    if id == 3 {
      self.peerStreams = value
    }
    if id == 4 {
      if value > 2147483647 {
        fail ProtocolError { code: Frame.FLOW_CONTROL_ERROR, stream: 0 }
      }
      let delta = u32.toI64(value) - u32.toI64(self.peerWindow)
      let mut index: usize = 0
      while index < List.length(&self.streams) {
        let mut entry = List.get(&self.streams, index)
        if entry.local {
          if entry.sendWindow + delta > 2147483647 {
            fail ProtocolError { code: Frame.FLOW_CONTROL_ERROR, stream: 0 }
          }
          entry.sendWindow = entry.sendWindow + delta
          List.set(&mut self.streams, index, entry)
        }
        index = index + 1
      }
      self.peerWindow = value
    }
    if id == 5 {
      if value < 16384 || value > 16777215 {
        fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: 0 }
      }
      self.peerFrame = value
    }
    if id == 6 {
      self.peerHeaders = value
    }
    cursor = cursor + 6
  }
  run queue(&mut self.*, 4, 1, 0, b"")
  return Event.Settings
}

effect fn data(self: &mut Connection, header: FrameHeader, payload: &[u8]) -> Event
  ! ProtocolError | OutOfMemoryError
  ? &mut Allocator {
  let id = header.stream
  if idle(&self.*, id) {
    fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: 0 }
  }
  if usize.toI64(payload.length) > self.receiveWindow {
    fail ProtocolError { code: Frame.FLOW_CONTROL_ERROR, stream: 0 }
  }
  let mut start: usize = 0
  let mut padding: usize = 0
  if header.flags & 8 != 0 {
    if payload.length == 0 {
      fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: 0 }
    }
    start = 1
    padding = u8.toUsize(payload[0])
    if padding >= payload.length {
      fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: 0 }
    }
  }
  self.receiveWindow = self.receiveWindow - usize.toI64(payload.length)
  let index = find(&self.*, id)
  if index == List.length(&self.streams) {
    if payload.length > 0 {
      run window(&mut self.*, 0, usize.toU32(payload.length))
      self.receiveWindow = self.receiveWindow + usize.toI64(payload.length)
    }
    fail ProtocolError { code: Frame.STREAM_CLOSED, stream: id }
  }
  let mut value = List.get(&self.streams, index)
  let length = payload.length - start - padding
  value.uncredited = value.uncredited + usize.toU32(payload.length)
  self.uncredited = self.uncredited + usize.toU32(payload.length)
  List.set(&mut self.streams, index, value)
  if value.reservedLocal || value.reservedRemote {
    fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: 0 }
  }
  if !value.remote {
    if value.resetSent {
      run closeStream(&mut self.*, id)
      return Event.None
    }
    if !value.local {
      fail ProtocolError { code: Frame.STREAM_CLOSED, stream: 0 }
    }
    fail ProtocolError { code: Frame.STREAM_CLOSED, stream: id }
  }
  if !value.receivedFinal {
    fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: id }
  }
  if payload.length > 0 && usize.toI64(payload.length) > value.receiveWindow {
    fail ProtocolError { code: Frame.FLOW_CONTROL_ERROR, stream: id }
  }
  value.receiveWindow = value.receiveWindow - usize.toI64(payload.length)
  if value.receiveNoBody && length > 0 {
    fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: id }
  }
  if usize.toU64(length) > u64.MAX - value.received {
    fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: id }
  }
  value.received = value.received + usize.toU64(length)
  let end = header.flags & 1 != 0
  if value.hasReceiveLength
    && (value.received > value.receiveLength || (end && value.received != value.receiveLength)) {
    fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: id }
  }
  List.set(&mut self.streams, index, value)
  if start + padding > 0 {
    run Connection.release(&mut self.*, id, usize.toU32(start + padding))
    value = List.get(&self.streams, index)
  }
  if end {
    value.remote = false
  }
  List.set(&mut self.streams, index, value)
  return Event.Data {
    stream: id,
    bytes: run Bytes.copy(Slice.view(payload, start, length)),
    endStream: end
  }
}

effect fn fieldFrame(self: &mut Connection, header: FrameHeader, payload: &[u8]) -> Event
  ! ProtocolError | OutOfMemoryError
  ? &mut Allocator {
  let id = header.stream
  let mut start: usize = 0
  let mut padding: usize = 0
  if header.kind == 9 {
    if self.blockStream == 0 || self.blockStream != id {
      fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: 0 }
    }
  } else {
    if self.blockStream != 0 {
      fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: 0 }
    }
    if header.flags & 8 != 0 {
      if payload.length == 0 {
        fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: 0 }
      }
      start = 1
      padding = u8.toUsize(payload[0])
      if padding >= payload.length {
        fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: 0 }
      }
    }
    self.blockError = 0
    if header.kind == 1 && header.flags & 32 != 0 {
      if payload.length - start - padding < 5 {
        fail ProtocolError { code: Frame.FRAME_SIZE_ERROR, stream: 0 }
      }
      if Frame.read32(payload, start) & 2147483647 == id {
        self.blockError = Frame.PROTOCOL_ERROR
      }
      start = start + 5
    }
    self.blockPromised = 0
    if header.kind == 5 {
      if !self.client || !self.limits.push {
        fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: 0 }
      }
      if payload.length - start - padding < 4 {
        fail ProtocolError { code: Frame.FRAME_SIZE_ERROR, stream: 0 }
      }
      let promised = Frame.read32(payload, start) & 2147483647
      if promised == 0 || promised % 2 != 0 || promised <= self.lastRemote {
        fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: 0 }
      }
      let index = find(&self.*, id)
      if index == List.length(&self.streams) {
        fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: 0 }
      }
      let parent = List.get(&self.streams, index)
      if (!parent.remote && !parent.resetSent) || !local(&self.*, id) {
        fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: 0 }
      }
      self.blockPromised = promised
      start = start + 4
    } else if idle(&self.*, id) {
      if self.client || local(&self.*, id) {
        fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: 0 }
      }
    }
    self.blockStream = id
    self.blockEnd = header.flags & 1 != 0 && header.kind == 1
  }
  let length = payload.length - start - padding
  if length > self.limits.compressedBytes - Bytes.length(&self.block) {
    fail ProtocolError { code: Frame.ENHANCE_YOUR_CALM, stream: 0 }
  }
  run Bytes.append(&mut self.block, Slice.view(payload, start, length))
  if header.flags & 4 == 0 {
    return Event.None
  }
  let decoded = run Effect.result(Decoder.decode(&mut self.decoder, Bytes.asSlice(&self.block)))
  Bytes.clear(&mut self.block)
  self.blockStream = 0
  let fields = match move decoded {
    Result.Success { value } => move value
    Result.Failure { error } => match move error {
      HpackError failure => {
        let mut code = Frame.COMPRESSION_ERROR
        if failure.limit {
          code = Frame.ENHANCE_YOUR_CALM
        }
        fail ProtocolError { code: code, stream: 0 }
      }
      OutOfMemoryError failure => {
        fail move failure
      }
    }
  }
  return run fieldSection(&mut self.*, id, move fields)
}

effect fn fieldSection(self: &mut Connection, id: u32, fields: List<Header>) -> Event
  ! ProtocolError | OutOfMemoryError
  ? &mut Allocator {
  if self.blockError != 0 {
    if idle(&self.*, id) {
      self.lastRemote = id
    }
    fail ProtocolError { code: self.blockError, stream: id }
  }
  let entries = List.asSlice(&fields)
  let mut views = List<Field>.make()
  let mut cursor: usize = 0
  while cursor < entries.length {
    run List.append(&mut views, Header.view(&entries[cursor]))
    cursor = cursor + 1
  }
  let end = self.blockEnd
  if self.blockPromised != 0 {
    let promised = self.blockPromised
    self.blockPromised = 0
    self.lastRemote = promised
    let message = run Fields.validate(List.asSlice(&views), Section.Request, promised)
    if message.connect || (message.hasLength && message.length != 0)
      || !safePush(List.asSlice(&views))
      || !pushAuthority(&self.*, id, List.asSlice(&views)) {
      fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: promised }
    }
    self.lastRemote = promised
    if self.sentGoaway || active(&self.*, false) >= self.limits.streams {
      fail ProtocolError { code: Frame.REFUSED_STREAM, stream: promised }
    }
    let mut value = stream(promised, self.peerWindow, receiveWindow(&self.*))
    value.local = false
    value.reservedRemote = true
    value.sentFinal = true
    value.head = message.head
    prune(&mut self.*)
    run List.append(&mut self.streams, value)
    drop views
    drop entries
    return Event.Push { stream: id, promised: promised, fields: move fields }
  }
  if idle(&self.*, id) {
    self.lastRemote = id
    if self.sentGoaway || active(&self.*, false) >= self.limits.streams {
      fail ProtocolError { code: Frame.REFUSED_STREAM, stream: id }
    }
    prune(&mut self.*)
    let opened = stream(id, self.peerWindow, receiveWindow(&self.*))
    run List.append(&mut self.streams, opened)
  }
  let index = find(&self.*, id)
  if index == List.length(&self.streams) {
    fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: 0 }
  }
  let mut value = List.get(&self.streams, index)
  if value.reservedLocal {
    fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: 0 }
  }
  if value.reservedRemote && concurrent(&self.*, false) >= self.limits.streams {
    fail ProtocolError { code: Frame.REFUSED_STREAM, stream: id }
  }
  if !value.remote {
    if value.resetSent {
      return Event.None
    }
    if !value.local {
      fail ProtocolError { code: Frame.STREAM_CLOSED, stream: 0 }
    }
    fail ProtocolError { code: Frame.STREAM_CLOSED, stream: id }
  }
  let mut section = Section.Request
  if self.client {
    section = Section.Response
  }
  if value.receivedFinal {
    section = Section.Trailers
  }
  let message = run Fields.validate(List.asSlice(&views), move section, id)
  if value.tunnel {
    fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: id }
  }
  if value.receivedFinal {
    if !end {
      fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: id }
    }
  } else {
    if self.client && message.status < 200 {
      if end {
        fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: id }
      }
    } else {
      value.receivedFinal = true
      value.receiveNoBody = self.client
        && (value.head || message.status == 204 || message.status == 304)
      value.hasReceiveLength = message.hasLength && !value.receiveNoBody
      value.receiveLength = message.length
      if !self.client {
        value.head = message.head
        value.connect = message.connect
      }
      if self.client && value.connect && message.status >= 200 && message.status < 300 {
        if message.hasLength {
          fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: id }
        }
        value.tunnel = true
        value.receiveNoBody = false
        value.hasSendLength = false
      }
    }
  }
  if end && value.hasReceiveLength && value.received != value.receiveLength {
    fail ProtocolError { code: Frame.PROTOCOL_ERROR, stream: id }
  }
  value.reservedRemote = false
  if end {
    value.remote = false
  }
  List.set(&mut self.streams, index, value)
  drop views
  drop entries
  return Event.Headers { stream: id, fields: move fields, endStream: end }
}

fn fieldValue<'a>(fields: &[Field<'a>], name: &[u8]) -> &'a [u8] {
  let mut index: usize = 0
  while index < fields.length {
    if equal(fields[index].name, name) {
      return fields[index].value
    }
    index = index + 1
  }
  return b""
}

effect fn saveOrigin(self: &mut Connection, id: u32, fields: &[Field]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut authority = fieldValue(fields, b":authority")
  if authority.length == 0 {
    authority = fieldValue(fields, b"host")
  }
  let host = run Bytes.copy(authority)
  let scheme = run Bytes.copy(fieldValue(fields, b":scheme"))
  run List.append(
    &mut self.origins,
    RequestOrigin { stream: id, authority: move host, scheme: move scheme }
  )
}

fn pushAuthority(self: &Connection, id: u32, fields: &[Field]) -> bool {
  let authority = fieldValue(fields, b":authority")
  let scheme = fieldValue(fields, b":scheme")
  if authority.length == 0 {
    return false
  }
  let origins = List.asSlice(&self.origins)
  let mut index: usize = 0
  while index < origins.length {
    if origins[index].stream == id {
      return equal(authority, Bytes.asSlice(&origins[index].authority))
        && equal(scheme, Bytes.asSlice(&origins[index].scheme))
    }
    index = index + 1
  }
  return false
}

fn receiveWindow(self: &Connection) -> u32 {
  if self.settingsOutstanding {
    return 65535
  }
  return self.limits.windowBytes
}

fn concurrent(self: &Connection, initiatedLocally: bool) -> u32 {
  let values = List.asSlice(&self.streams)
  let mut count: u32 = 0
  let mut index: usize = 0
  while index < values.length {
    let value = values[index]
    if (value.local || value.remote) && !value.reservedLocal && !value.reservedRemote
      && local(&self.*, value.id) == initiatedLocally {
      count = count + 1
    }
    index = index + 1
  }
  return count
}
