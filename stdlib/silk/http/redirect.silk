fn delimiter(storage: &[u8], start: usize) -> usize {
  let mut index = start
  while index < storage.length && storage[index] != u8.toU8(0) {
    index = index + usize.ONE
  }
  return index
}

fn rangeEqual(storage: &[u8], start: usize, end: usize, value: &[u8]) -> bool {
  if end < start || end - start != value.length {
    return false
  }
  let mut index = usize.ZERO
  while index < value.length {
    if storage[start + index] != value[index] {
      return false
    }
    index = index + usize.ONE
  }
  return true
}

fn foldedRangeEqual(storage: &[u8], start: usize, end: usize, value: &[u8]) -> bool {
  if end < start || end - start != value.length {
    return false
  }
  let mut index = usize.ZERO
  while index < value.length {
    if folded(storage[start + index]) != folded(value[index]) {
      return false
    }
    index = index + usize.ONE
  }
  return true
}

fn historyContains(arena: &[u8], method: &Method, origin: &Origin, authority: &[u8], uri: &Uri) -> bool {
  let methodBytes = String.utf8Bytes(Method.format(method))
  let mut secureMarker = u8.toU8(112)
  if Origin.secure(origin) {
    secureMarker = u8.toU8(115)
  }
  let mut cursor = usize.ZERO
  while cursor < arena.length {
    let methodEnd = delimiter(arena, cursor)
    if methodEnd >= arena.length {
      return false
    }
    let markerAt = methodEnd + usize.ONE
    if markerAt >= arena.length {
      return false
    }
    let authorityStart = markerAt + usize.ONE
    let authorityEnd = delimiter(arena, authorityStart)
    if authorityEnd >= arena.length {
      return false
    }
    let targetStart = authorityEnd + usize.ONE
    let targetEnd = delimiter(arena, targetStart)
    if targetEnd >= arena.length {
      return false
    }
    if rangeEqual(arena, cursor, methodEnd, methodBytes) && arena[markerAt] == secureMarker && foldedRangeEqual(
      arena,
      authorityStart,
      authorityEnd,
      authority,
    ) && targetRangeEqual(arena, targetStart, targetEnd, uri) {
      return true
    }
    cursor = targetEnd + usize.ONE
  }
  return false
}

fn historyAdd(left: usize, right: usize, hop: usize) -> Result<usize, RedirectError> {
  return match move usize.checkedAdd(left, right) {
    Option.None => Result<usize, RedirectError>.failResult(
      failure(RedirectComponent.History, RedirectReason.SizeOverflow, hop, Option<Status>.none()),
    )
    Option.Some {value} => Result<usize, RedirectError>.succeed(value)
  }
}

impl History {
  /// Returns an empty history, and allocates all its memory before any network I/O.
  pub effect fn make(limits: HistoryLimits) -> Result<History, RedirectError>
  ! OutOfMemoryError
  ? &mut Allocator {
    let entries = match move usize.checkedAdd(limits.maxHops, usize.ONE) {
      Option.None => {
        return Result<History, RedirectError>.failResult(
          failure(
            RedirectComponent.History,
            RedirectReason.SizeOverflow,
            usize.ZERO,
            Option<Status>.none(),
          ),
        )
      }
      Option.Some {value} => value
    }
    let mut arena = Bytes.make()
    let reserved = run Bytes.reserveExact(&mut arena, limits.maxHistoryBytes)
    return Result<History, RedirectError>.succeed(
      History {arena: move arena, limits: limits, maxEntriesValue: entries, countValue: usize.ZERO},
    )
  }
  /// Adds a request, by its method, origin, path, and query. Fails with `RedirectLoop` if the same
  /// request is already in the history.
  pub effect fn insert<'method>(self: &mut Self, method: Method<'method>, origin: Origin, uri: &Uri) -> Result<
    (),
    RedirectError,
  > ! OutOfMemoryError ? &mut Allocator {
    let selectedTargetLength = match move targetLength(uri) {
      Result.Failure {error} => {
        return Result<(), RedirectError>.failResult(move error)
      }
      Result.Success {value} => value
    }
    let mut authority = authorityScratch()
    let authorityLength = match move Origin.authorityWithPortInto(&origin, &mut authority) {
      Result.Failure {error} => {
        return Result<(), RedirectError>.failResult(
          failure(
            RedirectComponent.History,
            RedirectReason.SizeOverflow,
            self.countValue,
            Option<Status>.none(),
          ),
        )
      }
      Result.Success {value} => value
    }
    let authorityBytes = Slice.view<u8>(&authority, usize.ZERO, authorityLength)
    if historyContains(Bytes.asSlice(&self.arena), &method, &origin, authorityBytes, uri) {
      return Result<(), RedirectError>.failResult(
        failure(
          RedirectComponent.History,
          RedirectReason.RedirectLoop,
          self.countValue - usize.ONE,
          Option<Status>.none(),
        ),
      )
    }
    if self.countValue >= self.maxEntriesValue {
      let attempted = match move usize.checkedAdd(self.countValue, usize.ONE) {
        Option.None => usize.MAX
        Option.Some {value} => value
      }
      return Result<(), RedirectError>.failResult(
        limitFailure(
          RedirectComponent.History,
          RedirectLimit.HistoryEntries,
          self.maxEntriesValue,
          attempted,
        ),
      )
    }
    let withMethod = match move historyAdd(
      String.byteLength(Method.format(&method)),
      authorityLength,
      self.countValue,
    ) {
      Result.Failure {error} => {
        return Result<(), RedirectError>.failResult(move error)
      }
      Result.Success {value} => value
    }
    let withTarget = match move historyAdd(withMethod, selectedTargetLength, self.countValue) {
      Result.Failure {error} => {
        return Result<(), RedirectError>.failResult(move error)
      }
      Result.Success {value} => value
    }
    let entryBytes = match move historyAdd(withTarget, 4, self.countValue) {
      Result.Failure {error} => {
        return Result<(), RedirectError>.failResult(move error)
      }
      Result.Success {value} => value
    }
    let required = match move historyAdd(Bytes.length(&self.arena), entryBytes, self.countValue) {
      Result.Failure {error} => {
        return Result<(), RedirectError>.failResult(move error)
      }
      Result.Success {value} => value
    }
    if required > self.limits.maxHistoryBytes {
      return Result<(), RedirectError>.failResult(
        RedirectError {
          component: RedirectComponent.History,
          reason: RedirectReason.LimitExceeded {
            limit: RedirectLimit.HistoryBytes,
            allowed: self.limits.maxHistoryBytes,
            attempted: required,
          },
          context: emptyContext(self.countValue, Option<Status>.none()),
        },
      )
    }
    let wroteMethod = run Bytes.append(&mut self.arena, String.utf8Bytes(Method.format(&method)))
    let wroteMethodEnd = run Bytes.append(&mut self.arena, b"\x00")
    if Origin.secure(&origin) {
      let wroteScheme = run Bytes.append(&mut self.arena, b"s")
    } else {
      let wroteScheme = run Bytes.append(&mut self.arena, b"p")
    }
    let wroteAuthority = run Bytes.append(&mut self.arena, authorityBytes)
    let wroteAuthorityEnd = run Bytes.append(&mut self.arena, b"\x00")
    let wroteTarget = run writeTarget(&mut self.arena, uri)
    let wroteTargetEnd = run Bytes.append(&mut self.arena, b"\x00")
    self.countValue = self.countValue + usize.ONE
    return Result<(), RedirectError>.succeed(())
  }
  /// Returns the number of requests in the history.
  pub fn count(self: &Self) -> usize {
    return self.countValue
  }
  /// Returns the bytes of the history that are used.
  pub fn ownedBytes(self: &Self) -> usize {
    return Bytes.length(&self.arena)
  }
}

fn named(name: string, expected: string) -> bool {
  return foldedEqual(String.utf8Bytes(name), String.utf8Bytes(expected))
}

fn alwaysRemoved(name: string) -> bool {
  return named(name, "host") || named(name, "connection") || named(name, "keep-alive") || named(
    name,
    "te",
  ) || named(name, "trailer") || named(name, "transfer-encoding") || named(name, "upgrade") || named(
    name,
    "proxy-connection",
  ) || named(name, "proxy-authorization") || named(name, "content-length") || named(name, "expect")
}

fn droppedContent(name: string) -> bool {
  return named(name, "content-length") || named(name, "transfer-encoding") || named(
    name,
    "content-type",
  ) || named(name, "content-encoding") || named(name, "content-language") || named(
    name,
    "content-location",
  ) || named(name, "digest") || named(name, "content-digest") || named(name, "repr-digest") || named(
    name,
    "trailer",
  ) || named(name, "expect")
}

fn fixedCrossOriginSafe(name: string, body: BodyDecision) -> bool {
  if named(name, "accept") || named(name, "accept-encoding") || named(name, "accept-language") || named(
    name,
    "user-agent",
  ) {
    return true
  }
  return match body {
    BodyDecision.Drop => false
    BodyDecision.Retain => named(name, "content-type") || named(name, "content-encoding") || named(
      name,
      "content-language",
    )
  }
}

fn denyLast(policy: &Policy, name: string) -> bool {
  return named(name, "authorization") || named(name, "cookie") || named(name, "proxy-authorization") || named(
    name,
    "origin",
  ) || named(name, "referer") || NameList.contains(Policy.sensitive(policy), name)
}

effect fn collectConnectionNames<'value>(headers: &Headers<'value>) -> Result<
  List<string<'value>>,
  ValueError,
> ! OutOfMemoryError ? &mut Allocator {
  let mut names = List<string<'value>>.make()
  let reserved = run List<string<'value>>.reserveExact(&mut names, Headers.count(headers))
  let mut tokens = Headers.connectionTokens(headers)
  while true {
    let next = MetadataIterator.next(&mut tokens)
    let selected = match move next {
      Result.Failure {error} => {
        return Result<List<string<'value>>, ValueError>.failResult(move error)
      }
      Result.Success {value} => move value
    }
    match move selected {
      Option.None => {
        break
      }
      Option.Some {value} => {
        let name = unsafe String.fromUtf8Unchecked(MetadataToken.token(&value))
        let appended = run List<string<'value>>.append(&mut names, name)
      }
    }
  }
  return Result<List<string<'value>>, ValueError>.succeed(move names)
}

fn nominated(names: &[string], name: string) -> bool {
  let sought = String.utf8Bytes(name)
  let mut index = usize.ZERO
  while index < names.length {
    if foldedEqual(String.utf8Bytes(names[index]), sought) {
      return true
    }
    index = index + usize.ONE
  }
  return false
}

fn keepHeader(
  connectionNames: &[string],
  policy: &Policy,
  name: string,
  crossOrigin: bool,
  body: BodyDecision,
) -> bool {
  if alwaysRemoved(name) || nominated(connectionNames, name) {
    return false
  }
  if body == BodyDecision.Drop && droppedContent(name) {
    return false
  }
  if !crossOrigin {
    return true
  }
  let admitted = fixedCrossOriginSafe(name, body) || NameList.contains(
    Policy.safeCustom(policy),
    name,
  )
  if !admitted {
    return false
  }
  return !denyLast(policy, name)
}

/// Returns a copy of `headers` without the headers that must not go to the next request.
///
/// # When to use
/// Use it before you prepare the request of each redirect.
///
/// # Details
/// It removes `Host`, `Connection`, `Keep-Alive`, `TE`, `Trailer`, `Transfer-Encoding`, `Upgrade`,
/// `Proxy-Connection`, `Proxy-Authorization`, `Content-Length`, `Expect`, and the fields that
/// `Connection` names. When the body is dropped, it also removes the content headers. For another
/// origin, it keeps only `Accept`, `Accept-Encoding`, `Accept-Language`, `User-Agent`, the safe
/// names of the policy, and the content headers of a kept body. Then `Authorization`, `Cookie`,
/// `Origin`, `Referer`, and the sensitive names of the policy are always removed.
///
/// # Gotchas
/// The request preparation makes `Host`, the framing fields, `Expect`, and `Proxy-Authorization`
/// again for the next request. A bad `Connection` value fails with its `ValueError`.
pub effect fn sanitizeHeaders<'value>(
  headers: &Headers<'value>,
  policy: &Policy,
  crossOrigin: bool,
  body: BodyDecision,
  limits: HeaderLimits,
) -> Result<OwnedHeaders, ValueError> ! OutOfMemoryError ? &mut Allocator {
  let connectionNames = match move run collectConnectionNames(headers) {
    Result.Failure {error} => {
      return Result<OwnedHeaders, ValueError>.failResult(move error)
    }
    Result.Success {value} => move value
  }
  let nominations = List<string<'value>>.asSlice(&connectionNames)
  let mut selected = List<Header<'value>>.make()
  let reserved = run List<Header<'value>>.reserveExact(&mut selected, Headers.count(headers))
  let mut iterator = Headers.iter(headers)
  while true {
    let next = HeaderIterator.next(&mut iterator)
    match move next {
      Option.None => {
        break
      }
      Option.Some {value} => {
        if keepHeader(nominations, policy, Header.name(&value), crossOrigin, body) {
          let appended = run List<Header<'value>>.append(&mut selected, value)
        }
      }
    }
  }
  let borrowed = match move Headers.make(List<Header<'value>>.asSlice(&selected), limits) {
    Result.Failure {error} => {
      return Result<OwnedHeaders, ValueError>.failResult(move error)
    }
    Result.Success {value} => value
  }
  return run Headers.copy(&borrowed, limits)
}
