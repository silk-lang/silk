//! Follow HTTP redirects with a [`Policy`]: which statuses to follow, how the method and the body
//! change, which origins are allowed, and which headers are kept.
//!
//! # When to use
//! Most programs set a [`Policy`] in `FetchOptions` of `silk.http.fetch`. Use the `with*Response`
//! functions to follow redirects with your own [`AttemptClient`]. Use [`statusDecision`],
//! [`transition`], [`resolveLocation`], [`admitOrigin`], [`History`], and [`sanitizeHeaders`] to
//! build your own redirect loop.
//!
//! # Details
//! For each response, [`statusDecision`] decides if it is a redirect. [`transition`] selects the
//! next method and whether the body is sent again:
//! - 303 changes the method to GET, or keeps HEAD, and drops the body.
//! - 301 and 302 change POST to GET and drop the body when `post301302` is `ToGet`.
//! - All other cases keep the method and the body.
//!
//! [`resolveLocation`] reads the `Location` field. [`admitOrigin`] applies the cross-origin and
//! downgrade rules. [`History`] finds loops. [`sanitizeHeaders`] removes headers that must not go
//! to the next request.
//!
//! The suffix of a `with*Response` function tells what the request body is, as in
//! `silk.http.fetch`: `Empty`, `Bytes`, `OneShot`, or `Replay`. The `Hybrid` forms take a client
//! that can connect through a proxy route or directly.
//!
//! # Errors
//! - [`RedirectError`] tells the part, the reason, and the URIs and status, when they are known. It
//!   holds no credentials or body.
//!
//! # Gotchas
//! The default [`Policy`] does not follow redirects. It denies a change of origin and a change from
//! HTTPS to HTTP. A `OneShot` body cannot be sent again, so a redirect that keeps the body fails
//! with `ReplayUnavailable`.
//!
//! # Examples
//! ## Apply redirect rules
//! ```silk
//! import silk.http.message { Method, Status, ValueError }
//! import silk.http.origin { Origin, OriginError }
//! import silk.http.redirect {
//!   BodyDecision,
//!   CrossOriginPolicy,
//!   DowngradePolicy,
//!   Mode,
//!   NameList,
//!   Policy,
//!   Post301302Policy,
//!   PreviousResponsePolicy,
//!   RedirectError,
//!   RedirectReason,
//!   StatusDecision,
//!   Transition,
//!   admitOrigin,
//!   statusDecision,
//!   transition
//! }
//! import silk.core.result { Result }
//! import silk.uri.uri { Uri }
//! import silk.uri.reference { ParseError }
//!
//! fn status(code: u16) -> Status {
//!   return match Status.fromCode(code) {
//!     Result<Status, ValueError>.Success { value } => value
//!     Result<Status, ValueError>.Failure { error: _ } => {
//!       Intrinsic.trap("unexpected failure")
//!       return status(code)
//!     }
//!   }
//! }
//!
//! fn origin(text: string<'static>) -> Origin {
//!   let uri = match Uri.parse(text) {
//!     Result<Uri, ParseError>.Success { value } => value
//!     Result<Uri, ParseError>.Failure { error: _ } => {
//!       Intrinsic.trap("unexpected failure")
//!       return origin(text)
//!     }
//!   }
//!   return match Origin.fromUri(&uri) {
//!     Result<Origin, OriginError>.Success { value } => value
//!     Result<Origin, OriginError>.Failure { error: _ } => {
//!       Intrinsic.trap("unexpected failure")
//!       return origin(text)
//!     }
//!   }
//! }
//!
//! pub fn main() -> i32 {
//!   let defaults = Policy.defaults()
//!   let policy = match Policy.make(
//!     Mode.Follow,
//!     Policy.historyLimits(&defaults),
//!     CrossOriginPolicy.Allow,
//!     DowngradePolicy.Deny,
//!     Post301302Policy.ToGet,
//!     PreviousResponsePolicy.Close,
//!     NameList.empty(),
//!     NameList.empty(),
//!   ) {
//!     Result<Policy, RedirectError>.Success { value } => move value
//!     Result<Policy, RedirectError>.Failure { error: _ } => {
//!       return 1
//!     }
//!   }
//!
//!   // 303 is a redirect. It changes POST to GET and drops the body.
//!   let decision = match statusDecision(&policy, status(303), 0) {
//!     Result<StatusDecision, RedirectError>.Success { value } => value
//!     Result<StatusDecision, RedirectError>.Failure { error: _ } => {
//!       return 1
//!     }
//!   }
//!   let seeOther = transition(&policy, status(303), Method.post())
//!   if decision != StatusDecision.Redirect || Method.format(&seeOther.method) != "GET"
//!     || seeOther.body != BodyDecision.Drop {
//!     return 1
//!   }
//!
//!   // 307 keeps the method and the body.
//!   let temporary = transition(&policy, status(307), Method.post())
//!   if Method.format(&temporary.method) != "POST" || temporary.body != BodyDecision.Retain {
//!     return 1
//!   }
//!
//!   // A redirect from HTTPS to HTTP fails.
//!   let downgrade = match admitOrigin(
//!     &policy,
//!     &origin("https://example.com/"),
//!     &origin("http://example.com/"),
//!     0,
//!     status(302),
//!   ) {
//!     Result<bool, RedirectError>.Success { value: _ } => false
//!     Result<bool, RedirectError>.Failure { error } => match error.reason {
//!       RedirectReason.DowngradeDenied => true
//!       _ => false
//!     }
//!   }
//!   if !downgrade {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category HTTP

import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.io.byte_duplex {ByteDuplex}
import silk.collections.bytes {Bytes}
import silk.core.effect {Effect}
import silk.text.format {Debug, Format, Formatter}
import silk.http.message {Header, Method, Status, ValueError, Version}
import silk.http.exchange {
  ExchangeError,
  ContinuePolicy,
  DiscardOutcome,
  Exchange,
  ExchangePhase,
  RouteTransport,
}
import silk.http.exchange as Client
import silk.http.headers {
  HeaderIterator,
  Headers,
  Limits as HeaderLimits,
  MetadataIterator,
  MetadataToken,
  OwnedHeaders,
}
import silk.http.origin {Origin, OriginError}
import silk.http.request {Authorization, BodyMode, HeaderControl, HeaderPolicy}
import silk.http.transport {HttpTransport}
import silk.mem.layout {Layout}
import silk.system.monotonic_clock {MonotonicClock}
import silk.core.option {Option}
import silk.core.ownership {Copy}
import silk.system.random {Random}
import silk.core.result {Result}
import silk.collections.slice {Slice}
import silk.text.string {String}
import silk.system.system_clock {Instant, SystemClock}
import silk.num.u64
import silk.num.u8
import silk.uri.uri {OwnedUri, Uri}
import silk.uri.reference {UriReference}
import silk.num.usize
import silk.collections.list {List}
import silk.io.writer {Writer, WriterError}

/// Whether to follow redirects.
pub enum Mode {
  /// Return the first response. `Location` is not read.
  Manual,
  /// Follow redirects by the policy.
  Follow,
}

/// Whether a redirect can go to another origin.
pub enum CrossOriginPolicy {
  /// A redirect to another origin fails with `RedirectOriginDenied`.
  Deny,
  /// A redirect to another origin is followed. Sensitive headers are removed first.
  Allow,
}

/// Whether a redirect can go from HTTPS to HTTP.
pub enum DowngradePolicy {
  /// A redirect from HTTPS to HTTP fails with `DowngradeDenied`.
  Deny,
  /// A redirect from HTTPS to HTTP is followed, if the cross-origin policy allows it.
  Allow,
}

/// What a 301 or 302 redirect does with a POST request.
pub enum Post301302Policy {
  /// Send POST again, with the body.
  Preserve,
  /// Send GET without the body, as browsers do.
  ToGet,
}

/// What to do with the body of a redirect response before the next request.
pub union PreviousResponsePolicy {
  /// Do not read it. The connection closes if the body is not complete.
  Close,
  /// Read and drop the body, up to a limit, so that the connection can be used again.
  Drain {
    /// The maximum bytes to read.
    pub maxDiscardWireBytes: u64,
    /// The deadline of the drain on the `MonotonicClock`. The deadline of the operation also
    /// applies.
    pub deadline: Instant,
  },
}

/// The limits of a [`NameList`].
pub struct NameListLimits {
  /// The maximum number of names.
  pub maxNames: usize,
  /// The maximum length of one name.
  pub maxNameBytes: usize,
  /// The maximum memory of the list, in bytes.
  pub maxOwnedBytes: usize,
}

impl Copy for NameListLimits {}

/// A list of header names, compared without case.
pub struct NameList {
  values: List<String>,
  ownedBytesValue: usize,
}

/// The limits of a redirect operation.
pub struct HistoryLimits {
  /// The maximum number of redirects to follow.
  pub maxHops: usize,
  /// The maximum length of a `Location` value and of a resolved URI.
  pub maxUriBytes: usize,
  /// The maximum memory of the [`History`], in bytes.
  pub maxHistoryBytes: usize,
}

impl Copy for HistoryLimits {}

/// The redirect rules: which statuses to follow, how the method and the body change, which origins
/// are allowed, and which headers are kept. Start from [`Policy.defaults`], or make one with
/// [`Policy.make`].
///
/// # Details
///
/// A 303 changes the method to GET, or keeps HEAD, and drops the body. A 301 or 302 changes POST to
/// GET and drops the body when `post301302` is `ToGet`. All other cases keep the method and the
/// body.
///
/// # Gotchas
///
/// The default policy does not follow redirects. It denies a change of origin and a change from
/// HTTPS to HTTP.
pub struct Policy {
  modeValue: Mode,
  historyValue: HistoryLimits,
  crossOriginValue: CrossOriginPolicy,
  downgradeValue: DowngradePolicy,
  post301302Value: Post301302Policy,
  previousResponseValue: PreviousResponsePolicy,
  safeCustomValue: NameList,
  sensitiveValue: NameList,
}

/// The part of a redirect where an error occurred.
pub enum RedirectComponent {
  /// The policy.
  Policy,
  /// The `Location` field.
  Location,
  /// The next URI.
  Uri,
  /// The next origin.
  Origin,
  /// The redirect history.
  History,
  /// The request body.
  Body,
}

impl Debug for RedirectComponent {
  /// Writes the name of the variant, such as `Policy`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      RedirectComponent.Policy => run Format.write(&mut formatter, b"Policy")
      RedirectComponent.Location => run Format.write(&mut formatter, b"Location")
      RedirectComponent.Uri => run Format.write(&mut formatter, b"Uri")
      RedirectComponent.Origin => run Format.write(&mut formatter, b"Origin")
      RedirectComponent.History => run Format.write(&mut formatter, b"History")
      RedirectComponent.Body => run Format.write(&mut formatter, b"Body")
    }
  }
}

/// The limit that was exceeded.
pub enum RedirectLimit {
  /// `maxNames` of a name list.
  PolicyNames,
  /// `maxNameBytes` of a name list.
  PolicyNameBytes,
  /// `maxOwnedBytes` of a name list.
  PolicyOwnedBytes,
  /// `maxUriBytes`.
  UriBytes,
  /// The number of history entries, `maxHops` plus 1.
  HistoryEntries,
  /// `maxHistoryBytes`.
  HistoryBytes,
}

impl Debug for RedirectLimit {
  /// Writes the name of the variant, such as `PolicyNames`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      RedirectLimit.PolicyNames => run Format.write(&mut formatter, b"PolicyNames")
      RedirectLimit.PolicyNameBytes => run Format.write(&mut formatter, b"PolicyNameBytes")
      RedirectLimit.PolicyOwnedBytes => run Format.write(&mut formatter, b"PolicyOwnedBytes")
      RedirectLimit.UriBytes => run Format.write(&mut formatter, b"UriBytes")
      RedirectLimit.HistoryEntries => run Format.write(&mut formatter, b"HistoryEntries")
      RedirectLimit.HistoryBytes => run Format.write(&mut formatter, b"HistoryBytes")
    }
  }
}

/// The reason of a [`RedirectError`].
pub union RedirectReason {
  /// The policy is not valid, for example `maxHops` plus 1 overflows.
  InvalidPolicy,
  /// A name is in both the safe list and the sensitive list.
  NameListOverlap,
  /// A size does not fit in `usize`.
  SizeOverflow,
  /// A limit was exceeded.
  LimitExceeded {
    /// The limit.
    pub limit: RedirectLimit,
    /// The value of the limit.
    pub allowed: usize,
    /// The value that was found.
    pub attempted: usize,
  },
  /// The redirect has no `Location` field.
  LocationMissing,
  /// The redirect has more than one `Location` field.
  LocationAmbiguous,
  /// The `Location` value is not UTF-8, or is not a valid URI reference.
  LocationInvalid,
  /// The next URI is not `http` or `https`, or has no host or has user information.
  RedirectSchemeDenied,
  /// The policy does not allow a change of origin.
  RedirectOriginDenied,
  /// The policy does not allow a change from HTTPS to HTTP.
  DowngradeDenied,
  /// There are more redirects than `maxHops`.
  HopLimit,
  /// The next request has the same method and URI as an earlier request.
  RedirectLoop,
  /// The redirect keeps the body, but the body cannot be sent again.
  ReplayUnavailable,
  /// A body producer sent another length or framing than its `mode` said.
  ReplayContractMismatch,
}

impl Copy for RedirectReason {}

impl Debug for RedirectReason {
  /// Writes the name of the variant and its fields, such as `InvalidPolicy`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      RedirectReason.InvalidPolicy => run Format.write(&mut formatter, b"InvalidPolicy")
      RedirectReason.NameListOverlap => run Format.write(&mut formatter, b"NameListOverlap")
      RedirectReason.SizeOverflow => run Format.write(&mut formatter, b"SizeOverflow")
      RedirectReason.LimitExceeded { limit, allowed, attempted } => {
        let mut record = run Format.debugRecord("LimitExceeded", &mut formatter)
        run Format.debugField(&mut record, "limit", &limit, &mut formatter)
        run Format.debugField(&mut record, "allowed", &allowed, &mut formatter)
        run Format.debugField(&mut record, "attempted", &attempted, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      RedirectReason.LocationMissing => run Format.write(&mut formatter, b"LocationMissing")
      RedirectReason.LocationAmbiguous => run Format.write(&mut formatter, b"LocationAmbiguous")
      RedirectReason.LocationInvalid => run Format.write(&mut formatter, b"LocationInvalid")
      RedirectReason.RedirectSchemeDenied => run Format.write(&mut formatter, b"RedirectSchemeDenied")
      RedirectReason.RedirectOriginDenied => run Format.write(&mut formatter, b"RedirectOriginDenied")
      RedirectReason.DowngradeDenied => run Format.write(&mut formatter, b"DowngradeDenied")
      RedirectReason.HopLimit => run Format.write(&mut formatter, b"HopLimit")
      RedirectReason.RedirectLoop => run Format.write(&mut formatter, b"RedirectLoop")
      RedirectReason.ReplayUnavailable => run Format.write(&mut formatter, b"ReplayUnavailable")
      RedirectReason.ReplayContractMismatch => run Format.write(&mut formatter, b"ReplayContractMismatch")
    }
  }
}

/// The context of a [`RedirectError`]. It owns its data.
pub struct RedirectContext {
  /// The number of the attempt, from 0.
  pub hop: usize,
  /// The status of the response, when it is known.
  pub status: Option<Status>,
  /// A copy of the current URI, when it is known.
  pub currentUri: Option<OwnedUri>,
  /// A copy of the next URI, when it is known.
  pub nextUri: Option<OwnedUri>,
}

impl Debug for RedirectContext {
  /// Writes the fields, as `RedirectContext { hop: ..., status: ..., ... }`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return run Format.debugFields(self, "RedirectContext", &mut formatter)
  }
}

/// The error from a redirect. It holds no response, credentials, or body.
///
/// # Details
///
/// It tells the part, the reason, and the URIs and status, when they are known.
pub struct RedirectError {
  /// The part where the error occurred.
  pub component: RedirectComponent,
  /// The reason.
  pub reason: RedirectReason,
  /// The URIs and the status.
  pub context: RedirectContext,
}

impl Debug for RedirectError {
  /// Writes the fields, as `RedirectError { component: ..., reason: ..., ... }`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return run Format.debugFields(self, "RedirectError", &mut formatter)
  }
}

/// A request that can be built again for each redirect. It does not hold the body.
pub struct Request<'uri, 'method, 'headers, 'policy> {
  /// The first URI. Its fragment is kept for later URIs that have none.
  pub uri: Uri<'uri>,
  /// The first method.
  pub method: Method<'method>,
  /// Your headers, without the fields that the policy and the body make.
  pub headers: Headers<'headers>,
  /// The policy for the fields that the request adds, and the credentials.
  pub headerPolicy: HeaderPolicy<'policy>,
  /// The HTTP version of all attempts.
  pub version: Version,
  /// Whether all attempts wait for 100 Continue.
  pub continuePolicy: ContinuePolicy,
  /// The limits of the values and fields.
  pub limits: HeaderLimits,
  /// The maximum size of each request head.
  pub maxHeadBytes: usize,
  /// The maximum size of the credentials in each request head.
  pub maxCredentialBytes: usize,
}

/// The request for one attempt, which an [`AttemptClient`] prepares and sends.
///
/// # Details
/// The client borrows from this value only in its handler call. It must prepare a new request after
/// it selects the route, and never send the bytes of an earlier request to another origin.
pub struct AttemptRequest<'policy> {
  /// The URI of this attempt. The fragment is not sent.
  pub uri: OwnedUri,
  /// The method of this attempt.
  pub method: String,
  /// The headers, after [`sanitizeHeaders`].
  pub headers: OwnedHeaders,
  /// The policy for the fields that the request adds, and the credentials. See
  /// [`crossOriginHeaderPolicy`].
  pub headerPolicy: HeaderPolicy<'policy>,
  /// The HTTP version.
  pub version: Version,
  /// Whether to wait for 100 Continue.
  pub continuePolicy: ContinuePolicy,
  /// The limits of the values and fields.
  pub requestLimits: HeaderLimits,
  /// The maximum size of the request head.
  pub maxHeadBytes: usize,
  /// The maximum size of the credentials in the request head.
  pub maxCredentialBytes: usize,
  /// The framing of the body of this attempt.
  pub bodyMode: BodyMode,
}

/// Returns the header policy for a request to another origin, without credentials.
///
/// # When to use
/// Use it when [`admitOrigin`] returns `true`, before you prepare the request.
///
/// # Details
/// `Host` is made for the new origin, and `Authorization` is removed. `User-Agent`, `Accept`, the
/// Basic security, and the HTTP/1.0 keep-alive setting stay.
pub fn crossOriginHeaderPolicy<'value>(policy: HeaderPolicy<'value>) -> HeaderPolicy<'value> {
  return HeaderPolicy<'value> {
    host: HeaderControl<'value>.Default,
    userAgent: policy.userAgent,
    accept: policy.accept,
    authorization: Authorization<'value>.Absent,
    basicSecurity: policy.basicSecurity,
    http10KeepAlive: policy.http10KeepAlive,
  }
}

/// The result of [`BodyProducer.pull`].
pub struct BodyChunk {
  /// The number of bytes written at the start of the output.
  pub length: usize,
  /// `true` when there are no more bytes.
  pub end: bool,
}

impl Copy for BodyChunk {}

/// A source of request body bytes.
pub interface BodyProducer<E, ?R> {
  /// Returns the framing of the body, before the head is sent.
  fn mode(producer: &Self) -> BodyMode
  /// Writes the next bytes of the body to the start of `output`. It does not keep `output`.
  effect fn pull(producer: &mut Self, output: &mut [u8]) -> BodyChunk ! E ? R
}

/// Makes a new [`BodyProducer`] for each attempt that sends the body.
///
/// # Details
/// Each producer is released after its attempt, also after an error or a cancel. `release` cannot
/// fail or wait.
pub interface ReplayFactory<P, FactoryError, ?FactoryRequirements> {
  /// Returns a new producer for the next attempt.
  effect fn acquire(factory: &mut Self) -> P ! FactoryError ? FactoryRequirements
  /// Releases a producer after its attempt.
  fn release(factory: &mut Self, producer: &mut P) -> ()
}

/// The body of one attempt, as given to [`writeBody`].
pub union AttemptBody<'bytes, 'oneShot, 'replay, OneShot, ReplayProducer> {
  /// No body.
  Empty,
  /// Bytes that can be sent again from the start.
  RepeatableBytes {bytes: &'bytes [u8], offset: usize},
  /// A producer that can run only one time.
  OneShot {producer: &'oneShot mut OneShot},
  /// A new producer from a [`ReplayFactory`].
  ReplayFactory {producer: &'replay mut ReplayProducer},
}

/// The result of [`writeBody`].
pub union BodyWriteOutcome {
  /// The body was sent, and a final response arrived.
  Completed {
    /// The status of the final response.
    pub status: u16,
  },
  /// With `Require100`, a final response arrived before the body was sent.
  EarlyFinal {
    /// The status of the final response.
    pub status: u16,
  },
}

/// The service that an [`AttemptClient`] calls with the exchange of one attempt.
pub service Attempt<'policy, P, A, E, ?R> {
  /// Handles one live routed exchange inside its acquisition bracket.
  effect<'call> fn handle<
    'call,
    'exchangeView: 'call,
    'transport: 'exchangeView,
    'provider: 'transport,
    'tunnel: 'provider,
  >(
    request: &'call AttemptRequest<'policy>,
    method: Method<'call>,
    exchange: &'call mut Exchange<'exchangeView, RouteTransport<'transport, 'provider, 'tunnel, P>>,
  ) -> A ! E ? R | &mut Attempt<'policy, P, A, E, R> where
    &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut P provides &HttpTransport from &mut HttpTransport,
    &mut P provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut P provides &ByteDuplex from &mut ByteDuplex
}

/// Connects and runs one attempt of a redirect operation.
///
/// # When to use
/// Implement it to give your own connections to the `with*Response` functions. It hides the
/// sockets, TLS, proxy credentials, and pools from the redirect code.
///
/// # Details
/// `withAttempt` selects the route for the URI of `request`, prepares a new request, connects
/// before the deadline, and runs one `withExchange` of `silk.http.exchange`. It gives the exchange
/// to the redirect code through [`Attempt`]. Errors from the connection come back as
/// `AcquisitionError`.
///
/// # Gotchas
/// The implementation must close or release its transport after the handler returns, fails, or is
/// cancelled. It must not keep the request, the transport, or the exchange.
pub interface AttemptClient<
  'policy,
  P,
  A,
  HandlerError,
  AcquisitionError,
  ?AcquisitionRequirements,
  ?HandlerRequirements,
> {
  /// Rebuilds, acquires, and drives one scoped request while preserving both channel families.
  effect fn withAttempt(
    client: &mut Self,
    request: AttemptRequest<'policy>,
    deadline: Option<Instant>,
  ) -> A ! HandlerError | AcquisitionError ? HandlerRequirements | AcquisitionRequirements | &mut Attempt<'policy, P, A, HandlerError ? HandlerRequirements> where
    HandlerRequirements in Without<HandlerRequirements, ByteDuplex>,
    HandlerRequirements in Without<HandlerRequirements, HttpTransport>
}

/// The service that a [`HybridAttemptClient`] calls with the exchange of one attempt.
///
/// # Details
/// A routed client calls `handleRouted`, and a direct client calls `handleDirect`. The exchange
/// cannot be kept after the call.
pub service HybridAttempt<'policy, RoutedP, DirectP, A, E, ?R> {
  /// Handles the exchange of one attempt over a route.
  effect<'call> fn handleRouted<
    'call,
    'exchangeView: 'call,
    'transport: 'exchangeView,
    'provider: 'transport,
    'tunnel: 'provider,
  >(
    request: &'call AttemptRequest<'policy>,
    method: Method<'call>,
    exchange: &'call mut Exchange<
      'exchangeView,
      RouteTransport<'transport, 'provider, 'tunnel, RoutedP>,
    >,
  ) -> A ! E ? R | &mut HybridAttempt<'policy, RoutedP, DirectP, A, E, R> where
    &mut RoutedP provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut RoutedP provides &HttpTransport from &mut HttpTransport,
    &mut RoutedP provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut RoutedP provides &ByteDuplex from &mut ByteDuplex
  /// Handles the exchange of one attempt over a direct connection.
  effect<'call> fn handleDirect<'call, 'exchangeView: 'call>(
    request: &'call AttemptRequest<'policy>,
    method: Method<'call>,
    exchange: &'call mut Exchange<'exchangeView, DirectP>,
  ) -> A ! E ? R | &mut HybridAttempt<'policy, RoutedP, DirectP, A, E, R> where
    &mut DirectP provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut DirectP provides &HttpTransport from &mut HttpTransport
}

/// Connects and runs one attempt of a redirect operation, over a proxy route or a direct
/// connection. Implement it to give your own connections to the `with*HybridResponse` functions.
///
/// # Details
/// The client selects the form before it connects, and calls one handler. A direct connection
/// cannot open a `CONNECT` tunnel.
pub interface HybridAttemptClient<
  'policy,
  RoutedP,
  DirectP,
  A,
  HandlerError,
  AcquisitionError,
  ?AcquisitionRequirements,
  ?HandlerRequirements,
> {
  /// Rebuilds, acquires, and drives one routed or direct scoped request.
  effect fn withAttempt(
    client: &mut Self,
    request: AttemptRequest<'policy>,
    deadline: Option<Instant>,
  ) -> A ! HandlerError | AcquisitionError ? HandlerRequirements | AcquisitionRequirements | &mut HybridAttempt<'policy, RoutedP, DirectP, A, HandlerError ? HandlerRequirements> where
    HandlerRequirements in Without<HandlerRequirements, ByteDuplex>,
    HandlerRequirements in Without<HandlerRequirements, HttpTransport>
}

/// Handles the final response of a redirect operation.
///
/// # When to use
/// Give it to a `with*Response` function. It reads the final response while the exchange is open.
///
/// # Details
/// `uri` is the final URI, and `hop` the number of redirects. The URI and the exchange cannot be
/// kept after the call.
pub interface ResponseHandler<P, A, E, ?R> {
  /// Handles the final response.
  effect<'call> fn handle<
    'call,
    'exchangeView: 'call,
    'transport: 'exchangeView,
    'provider: 'transport,
    'tunnel: 'provider,
  >(
    handler: &mut Self,
    uri: Uri<'call>,
    hop: usize,
    exchange: &'call mut Exchange<'exchangeView, RouteTransport<'transport, 'provider, 'tunnel, P>>,
  ) -> A ! E ? R where
    &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut P provides &HttpTransport from &mut HttpTransport,
    &mut P provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut P provides &ByteDuplex from &mut ByteDuplex
}

/// Handles the final response of a redirect operation, over a proxy route or a direct connection.
/// It reads the final response while the exchange is open. The URI and the exchange cannot be kept
/// after the call.
///
/// # When to use
/// Give it to a `with*HybridResponse` function.
pub interface HybridResponseHandler<RoutedP, DirectP, A, E, ?R> {
  /// Handles the final response over a route.
  effect<'call> fn handleRouted<
    'call,
    'exchangeView: 'call,
    'transport: 'exchangeView,
    'provider: 'transport,
    'tunnel: 'provider,
  >(
    handler: &mut Self,
    uri: Uri<'call>,
    hop: usize,
    exchange: &'call mut Exchange<
      'exchangeView,
      RouteTransport<'transport, 'provider, 'tunnel, RoutedP>,
    >,
  ) -> A ! E ? R where
    &mut RoutedP provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut RoutedP provides &HttpTransport from &mut HttpTransport,
    &mut RoutedP provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut RoutedP provides &ByteDuplex from &mut ByteDuplex
  /// Handles the final response over a direct connection.
  effect<'call> fn handleDirect<'call, 'exchangeView: 'call>(
    handler: &mut Self,
    uri: Uri<'call>,
    hop: usize,
    exchange: &'call mut Exchange<'exchangeView, DirectP>,
  ) -> A ! E ? R where
    &mut DirectP provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut DirectP provides &HttpTransport from &mut HttpTransport
}

/// The body of the current attempt. It exists only during the attempt.
pub service SelectedBody<E, ?R> {
  /// Writes the next bytes of the body to the start of `output`.
  effect fn pull(output: &mut [u8]) -> BodyChunk ! E ? R | &mut SelectedBody<E, R>
}

struct BytesSelected<'bytes, E, ?R> {
  bytes: &'bytes [u8],
  offset: usize,
}

impl<'bytes, E, ?R> BytesSelected<'bytes, E, R> {
  effect fn pull(self: &mut Self, output: &mut [u8]) -> BodyChunk ! E ? R {
    let remaining = self.bytes.length - self.offset
    let mut length = remaining
    if output.length < length {
      length = output.length
    }
    let mut index = usize.ZERO
    while index < length {
      output[index] = self.bytes[self.offset + index]
      index = index + usize.ONE
    }
    self.offset = self.offset + length
    return BodyChunk {length: length, end: self.offset == self.bytes.length}
  }
}

impl<'bytes, E, ?R> SelectedBody<E, R> for BytesSelected<'bytes, E, R> {
  pull: BytesSelected.pull
}

struct ProducerSelected<'producer, Producer, E, ?R> {
  producer: &'producer mut Producer,
}

impl<'producer, E, ?R, Producer: BodyProducer<E ? R>> SelectedBody<E, R> for ProducerSelected<
  'producer,
  Producer,
  E,
  R,
> {
  effect fn pull(self: &mut Self, output: &mut [u8]) -> BodyChunk ! E ? R {
    return run BodyProducer<E ? R>.pull(&mut self.producer.*, move output)
  }
}

struct ServiceBodyProducer<E, ?R> {
  modeValue: BodyMode,
}

fn serviceAttemptBody<'scope, E, ?R>(producer: &'scope mut ServiceBodyProducer<E, R>, empty: bool) -> AttemptBody<
  'scope,
  'scope,
  'scope,
  ServiceBodyProducer<E, R>,
  ServiceBodyProducer<E, R>,
> {
  if empty {
    drop producer
    return AttemptBody<'scope, 'scope, 'scope, ServiceBodyProducer<E, R>, ServiceBodyProducer<E, R>>.Empty
  }
  return AttemptBody<'scope, 'scope, 'scope, ServiceBodyProducer<E, R>, ServiceBodyProducer<E, R>>.OneShot {
    producer: move producer,
  }
}

impl<E, ?R> BodyProducer<E ? R | &mut SelectedBody<E, R>> for ServiceBodyProducer<E, R> {
  fn mode(producer: &Self) -> BodyMode {
    return producer.modeValue
  }
  effect fn pull(producer: &mut Self, output: &mut [u8]) -> BodyChunk
  ! E
  ? R | &mut SelectedBody<E, R> {
    drop producer
    return run SelectedBody<E, R>.pull(move output)
  }
}

struct RedirectState<'policy> {
  uri: OwnedUri,
  method: String,
  headers: OwnedHeaders,
  headerPolicy: HeaderPolicy<'policy>,
  version: Version,
  continuePolicy: ContinuePolicy,
  requestLimits: HeaderLimits,
  maxHeadBytes: usize,
  maxCredentialBytes: usize,
  expectedBodyMode: Option<BodyMode>,
}

/// The result of one attempt. Only the redirect code makes and reads it.
pub union AttemptStep<'policy, A> {
  Final {value: A},
  Redirect {state: RedirectState<'policy>, history: History, body: BodyDecision},
}

struct RedirectAttemptHandler<'policy, E, ?R> {
  policy: &'policy Policy,
  history: History,
  followedHops: usize,
  replayable: bool,
}

fn copyInstant(value: &Instant) -> Instant {
  return SystemClock.make(SystemClock.seconds(value), SystemClock.nanoseconds(value))
}

fn copyDeadline(value: &Option<Instant>) -> Option<Instant> {
  return match & value.* {
    Option.None => Option<Instant>.none()
    Option.Some {value: present} => Option<Instant>.some(copyInstant(&present))
  }
}

fn copyContinuePolicy(policy: &ContinuePolicy) -> ContinuePolicy {
  return match & policy.* {
    ContinuePolicy.Disabled => ContinuePolicy.Disabled
    ContinuePolicy.Require100 {deadline} => ContinuePolicy.Require100 {
      deadline: copyInstant(&deadline),
    }
  }
}

fn requiredOrigin(uri: &Uri, hop: usize, status: Option<Status>) -> Result<Origin, RedirectError> {
  return match move Origin.fromUri(uri) {
    Result.Failure {error} => Result<Origin, RedirectError>.failResult(
      failure(RedirectComponent.Origin, originFailure(error), hop, move status),
    )
    Result.Success {value} => Result<Origin, RedirectError>.succeed(value)
  }
}

effect fn enrichCurrent(error: RedirectError, current: &Uri) -> RedirectError
! OutOfMemoryError
? &mut Allocator {
  let mut enriched = move error
  enriched.context.currentUri = Option<OwnedUri>.some(run Uri.copy(current))
  return move enriched
}

effect fn enrichBoth(error: RedirectError, current: &Uri, next: &Uri) -> RedirectError
! OutOfMemoryError
? &mut Allocator {
  let mut enriched = run enrichCurrent(move error, current)
  enriched.context.nextUri = Option<OwnedUri>.some(run Uri.copy(next))
  return move enriched
}

effect fn cleanupIntermediate<'exchange, P>(
  exchange: &mut Exchange<'exchange, P>,
  policy: &PreviousResponsePolicy,
) -> ()
! ExchangeError | OutOfMemoryError
? &mut MonotonicClock | &mut Allocator | &mut Random
where
  &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random {
  return match & policy.* {
    PreviousResponsePolicy.Close => ()
    PreviousResponsePolicy.Drain {maxDiscardWireBytes, deadline} => {
      let outcome = run Client.discardRemainingAtMost(
        &mut exchange.*,
        maxDiscardWireBytes,
        Option<Instant>.some(copyInstant(&deadline)),
      )
      match move outcome {
        DiscardOutcome.Completed => run Client.finishResponse(&mut exchange.*)
        DiscardOutcome.CapReached => ()
      }
    }
  }
}

fn atResponse(error: RedirectError, hop: usize, status: Status) -> RedirectError {
  let mut contextual = move error
  contextual.context.hop = hop
  contextual.context.status = Option<Status>.some(move status)
  return move contextual
}

interface FinalResponse<T, H, A, E, ?R> {
  effect<'call> fn handle<'call, 'exchangeView: 'call>(
    adapter: Self,
    callback: &mut H,
    uri: Uri<'call>,
    hop: usize,
    exchange: &'call mut Exchange<'exchangeView, T>,
  ) -> A ! E ? R where
    &mut T provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut T provides &HttpTransport from &mut HttpTransport
}

struct RoutedFinalResponse<'transport, 'provider, 'tunnel, P, H, A, E, ?R> {}

impl<
  'transport,
  'provider: 'transport,
  'tunnel: 'provider,
  P,
  A,
  E,
  ?R,
  H: ResponseHandler<P, A, E ? R>,
> FinalResponse<RouteTransport<'transport, 'provider, 'tunnel, P>, H, A, E ? R> for RoutedFinalResponse<
  'transport,
  'provider,
  'tunnel,
  P,
  H,
  A,
  E,
  R,
>
where
  &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut P provides &HttpTransport from &mut HttpTransport,
  &mut P provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut P provides &ByteDuplex from &mut ByteDuplex {
  effect<'call> fn handle<'call, 'exchangeView: 'call>(
    adapter: Self,
    callback: &mut H,
    uri: Uri<'call>,
    hop: usize,
    exchange: &'call mut Exchange<'exchangeView, RouteTransport<'transport, 'provider, 'tunnel, P>>,
  ) -> A
  ! E
  ? R {
    drop adapter
    return run ResponseHandler<P, A, E ? R>.handle(&mut callback, uri, hop, move exchange)
  }
}

effect<'env> fn handleAttemptCore<
  'policy,
  'call,
  'exchangeView: 'call,
  E: 'env,
  ?R,
  T,
  A,
  CallbackError,
  ?CallbackRequirements,
  H,
  Final: FinalResponse<T, H, A, CallbackError ? CallbackRequirements> + 'env,
  'env,
>(
  handler: RedirectAttemptHandler<'policy, E, R>,
  scratch: &mut [u8],
  callback: &mut H,
  request: &'call AttemptRequest<'policy>,
  method: Method<'call>,
  exchange: &'call mut Exchange<'exchangeView, T>,
  finalResponse: Final,
) -> AttemptStep<'policy, A>
! RedirectError | ValueError | E | CallbackError | ExchangeError | OutOfMemoryError
? R | CallbackRequirements | &mut SelectedBody<E, R> | &mut MonotonicClock | &mut Allocator | &mut Random
where
  &mut T provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut T provides &HttpTransport from &mut HttpTransport {
  let RedirectAttemptHandler<'policy, E, R> {policy, history, followedHops, replayable} = move handler
  let emptyFields: [Header<'static>; 0] = []
  let trailers = match move Headers.make(&emptyFields, request.requestLimits) {
    Result.Failure {error} => {
      fail move error
    }
    Result.Success {value} => value
  }
  let mut serviceProducer = ServiceBodyProducer<E, R> {modeValue: request.bodyMode}
  let selectedBody = serviceAttemptBody(&mut serviceProducer, bodyModeEmpty(&request.bodyMode))
  let written = run writeBody(
    &mut exchange.*,
    &request.uri.view(),
    request.bodyMode,
    move selectedBody,
    &mut scratch,
    &trailers,
    followedHops,
  )
  drop written
  let head = run Exchange.head(&exchange.*)
  let status = head.status()
  // A redirect status without a `Location` field has nowhere to go, so it is the final response
  // (RFC 9110 section 15.4), like a 300 or a 304.
  let mut located = false
  let mut fields = head.fields()
  while true {
    match move fields.next() {
      Option.None => { break }
      Option.Some {value} => {
        if foldedEqual(String.utf8Bytes(Header.name(&value)), b"location") { located = true }
      }
    }
  }
  let mut decision = StatusDecision.Final
  if located {
    decision = match move statusDecision(policy, status, followedHops) {
      Result.Failure {error} => {
        let enriched = run enrichCurrent(move error, &request.uri.view())
        fail move enriched
      }
      Result.Success {value} => value
    }
  }
  if decision == StatusDecision.Final {
    let value = run FinalResponse<T, H, A, CallbackError ? CallbackRequirements>.handle(
      move finalResponse,
      move callback,
      request.uri.view(),
      followedHops,
      move exchange,
    )
    return AttemptStep<'policy, A>.Final {value: move value}
  }
  let currentUri = request.uri.view()
  let locationHead = match move run head.copyMatchingHeaders("Location", request.requestLimits) {
    Result.Failure {error} => {
      fail move error
    }
    Result.Success {value} => move value
  }
  let locationView = locationHead.view()
  let responseHeaders = locationView.headers()
  let nextUri = match move run resolveLocation(
    &currentUri,
    &responseHeaders,
    Policy.historyLimits(policy),
    followedHops,
    status,
  ) {
    Result.Failure {error} => {
      let enriched = run enrichCurrent(move error, &currentUri)
      fail move enriched
    }
    Result.Success {value} => move value
  }
  drop responseHeaders
  drop head
  let nextView = nextUri.view()
  let currentOrigin = match move requiredOrigin(
    &currentUri,
    followedHops,
    Option<Status>.some(status),
  ) {
    Result.Failure {error} => {
      let enriched = run enrichBoth(move error, &currentUri, &nextView)
      fail move enriched
    }
    Result.Success {value} => value
  }
  let nextOrigin = match move requiredOrigin(&nextView, followedHops, Option<Status>.some(status)) {
    Result.Failure {error} => {
      let enriched = run enrichBoth(move error, &currentUri, &nextView)
      fail move enriched
    }
    Result.Success {value} => value
  }
  let crossOrigin = match move admitOrigin(
    policy,
    &currentOrigin,
    &nextOrigin,
    followedHops,
    status,
  ) {
    Result.Failure {error} => {
      let enriched = run enrichBoth(move error, &currentUri, &nextView)
      fail move enriched
    }
    Result.Success {value} => value
  }
  let transitioned = transition(policy, status, method)
  if transitioned.body == BodyDecision.Retain && !replayable {
    let error = failure(
      RedirectComponent.Body,
      RedirectReason.ReplayUnavailable,
      followedHops,
      Option<Status>.some(status),
    )
    let enriched = run enrichBoth(move error, &currentUri, &nextView)
    fail move enriched
  }
  let nextHeaders = match move run sanitizeHeaders(
    &request.headers.view(),
    policy,
    crossOrigin,
    transitioned.body,
    request.requestLimits,
  ) {
    Result.Failure {error} => {
      fail move error
    }
    Result.Success {value} => move value
  }
  let nextMethod = run String.copy(Method.format(&transitioned.method))
  let mut nextHistory = move history
  match move run History.insert(&mut nextHistory, transitioned.method, nextOrigin, &nextView) {
    Result.Failure {error} => {
      let contextual = atResponse(move error, followedHops, status)
      let enriched = run enrichBoth(move contextual, &currentUri, &nextView)
      fail move enriched
    }
    Result.Success {value} => {}
  }
  let mut nextHeaderPolicy = request.headerPolicy
  if crossOrigin {
    nextHeaderPolicy = crossOriginHeaderPolicy(request.headerPolicy)
  }
  let nextBodyMode = match transitioned.body {
    BodyDecision.Drop => BodyMode.Empty
    BodyDecision.Retain => request.bodyMode
  }
  let nextState = RedirectState<'policy> {
    uri: move nextUri,
    method: move nextMethod,
    headers: move nextHeaders,
    headerPolicy: nextHeaderPolicy,
    version: request.version,
    continuePolicy: copyContinuePolicy(&request.continuePolicy),
    requestLimits: request.requestLimits,
    maxHeadBytes: request.maxHeadBytes,
    maxCredentialBytes: request.maxCredentialBytes,
    expectedBodyMode: Option<BodyMode>.some(nextBodyMode),
  }
  run cleanupIntermediate(&mut exchange.*, Policy.previousResponse(policy))
  return AttemptStep<'policy, A>.Redirect {
    state: move nextState,
    history: move nextHistory,
    body: transitioned.body,
  }
}

struct RedirectRoutedAttempt<
  'attempt,
  'callback,
  'policy,
  P,
  A,
  E,
  ?R,
  CallbackError,
  ?CallbackRequirements,
  H,
> {
  handler: Option<RedirectAttemptHandler<'policy, E, R>>,
  scratch: &'attempt mut [u8],
  callback: &'callback mut H,
}

struct RedirectHybridAttempt<
  'attempt,
  'callback,
  'policy,
  RoutedP,
  DirectP,
  A,
  E,
  ?R,
  CallbackError,
  ?CallbackRequirements,
  H,
> {
  handler: Option<RedirectAttemptHandler<'policy, E, R>>,
  scratch: &'attempt mut [u8],
  callback: &'callback mut H,
}

fn unavailableHybrid<T>() -> T {
  return unavailableHybrid<T>()
}

impl<
  'attempt,
  'callback,
  'policy,
  E,
  ?R,
  P,
  A,
  CallbackError,
  ?CallbackRequirements,
  H: ResponseHandler<P, A, CallbackError ? CallbackRequirements>,
> Attempt<'policy, P, AttemptStep<'policy, A>, RedirectError | ValueError | E | CallbackError | ExchangeError | OutOfMemoryError ? R | CallbackRequirements | &mut SelectedBody<
  E,
  R,
> | &mut MonotonicClock | &mut Allocator | &mut Random> for RedirectRoutedAttempt<
  'attempt,
  'callback,
  'policy,
  P,
  A,
  E,
  R,
  CallbackError,
  CallbackRequirements,
  H,
> {
  effect<'call> fn handle<
    'call,
    'exchangeView: 'call,
    'transport: 'exchangeView,
    'provider: 'transport,
    'tunnel: 'provider,
  >(
    provider: &mut Self,
    request: &'call AttemptRequest<'policy>,
    method: Method<'call>,
    exchange: &'call mut Exchange<'exchangeView, RouteTransport<'transport, 'provider, 'tunnel, P>>,
  ) -> AttemptStep<'policy, A>
  ! RedirectError | ValueError | E | CallbackError | ExchangeError | OutOfMemoryError
  ? R | CallbackRequirements | &mut SelectedBody<E, R> | &mut MonotonicClock | &mut Allocator | &mut Random
  where
    &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut P provides &HttpTransport from &mut HttpTransport,
    &mut P provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut P provides &ByteDuplex from &mut ByteDuplex {
    let stored = Intrinsic.replace(
      provider.handler,
      Option<RedirectAttemptHandler<'policy, E, R>>.none(),
    )
    let handler = match move stored {
      Option.Some {value} => move value
      Option.None => unavailableHybrid<RedirectAttemptHandler<'policy, E, R>>()
    }
    return run handleAttemptCore(
      move handler,
      &mut provider.scratch,
      &mut provider.callback.*,
      request,
      method,
      move exchange,
      RoutedFinalResponse<
        'transport,
        'provider,
        'tunnel,
        P,
        H,
        A,
        CallbackError,
        CallbackRequirements,
      > {},
    )
  }
}

struct HybridRoutedFinalResponse<'transport, 'provider, 'tunnel, RoutedP, DirectP, H, A, E, ?R> {}

impl<
  'transport,
  'provider: 'transport,
  'tunnel: 'provider,
  RoutedP,
  DirectP,
  A,
  E,
  ?R,
  H: HybridResponseHandler<RoutedP, DirectP, A, E ? R>,
> FinalResponse<RouteTransport<'transport, 'provider, 'tunnel, RoutedP>, H, A, E ? R> for HybridRoutedFinalResponse<
  'transport,
  'provider,
  'tunnel,
  RoutedP,
  DirectP,
  H,
  A,
  E,
  R,
>
where
  &mut RoutedP provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut RoutedP provides &HttpTransport from &mut HttpTransport,
  &mut RoutedP provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut RoutedP provides &ByteDuplex from &mut ByteDuplex {
  effect<'call> fn handle<'call, 'exchangeView: 'call>(
    adapter: Self,
    callback: &mut H,
    uri: Uri<'call>,
    hop: usize,
    exchange: &'call mut Exchange<
      'exchangeView,
      RouteTransport<'transport, 'provider, 'tunnel, RoutedP>,
    >,
  ) -> A
  ! E
  ? R {
    drop adapter
    return run HybridResponseHandler<RoutedP, DirectP, A, E ? R>.handleRouted(
      &mut callback,
      uri,
      hop,
      move exchange,
    )
  }
}

struct HybridDirectFinalResponse<RoutedP, DirectP, H, A, E, ?R> {}

impl<RoutedP, DirectP, A, E, ?R, H: HybridResponseHandler<RoutedP, DirectP, A, E ? R>> FinalResponse<DirectP, H, A, E ? R> for HybridDirectFinalResponse<
  RoutedP,
  DirectP,
  H,
  A,
  E,
  R,
> {
  effect<'call> fn handle<'call, 'exchangeView: 'call>(
    adapter: Self,
    callback: &mut H,
    uri: Uri<'call>,
    hop: usize,
    exchange: &'call mut Exchange<'exchangeView, DirectP>,
  ) -> A
  ! E
  ? R
  where
    &mut DirectP provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut DirectP provides &HttpTransport from &mut HttpTransport {
    drop adapter
    return run HybridResponseHandler<RoutedP, DirectP, A, E ? R>.handleDirect(
      &mut callback,
      uri,
      hop,
      move exchange,
    )
  }
}

impl<'policy, E, ?R> RedirectAttemptHandler<'policy, E, R> {
  effect<'env> fn handleHybridRouted<
    'call,
    'exchangeView: 'call,
    'transport: 'exchangeView,
    'provider: 'transport,
    'tunnel: 'provider,
    RoutedP,
    DirectP,
    A,
    CallbackError,
    ?CallbackRequirements,
    H: HybridResponseHandler<RoutedP, DirectP, A, CallbackError ? CallbackRequirements>,
    'env,
  >(
    handler: Self,
    scratch: &mut [u8],
    callback: &mut H,
    request: &'call AttemptRequest<'policy>,
    method: Method<'call>,
    exchange: &'call mut Exchange<
      'exchangeView,
      RouteTransport<'transport, 'provider, 'tunnel, RoutedP>,
    >,
  ) -> AttemptStep<'policy, A>
  ! RedirectError | ValueError | E | CallbackError | ExchangeError | OutOfMemoryError
  ? R | CallbackRequirements | &mut SelectedBody<E, R> | &mut MonotonicClock | &mut Allocator | &mut Random
  where
    &mut RoutedP provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut RoutedP provides &HttpTransport from &mut HttpTransport,
    &mut RoutedP provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut RoutedP provides &ByteDuplex from &mut ByteDuplex {
    return run handleAttemptCore(
      move handler,
      move scratch,
      move callback,
      request,
      method,
      move exchange,
      HybridRoutedFinalResponse<
        'transport,
        'provider,
        'tunnel,
        RoutedP,
        DirectP,
        H,
        A,
        CallbackError,
        CallbackRequirements,
      > {},
    )
  }
  effect<'env> fn handleHybridDirect<
    'call,
    'exchangeView: 'call,
    RoutedP,
    DirectP,
    A,
    CallbackError,
    ?CallbackRequirements,
    H: HybridResponseHandler<RoutedP, DirectP, A, CallbackError ? CallbackRequirements>,
    'env,
  >(
    handler: Self,
    scratch: &mut [u8],
    callback: &mut H,
    request: &'call AttemptRequest<'policy>,
    method: Method<'call>,
    exchange: &'call mut Exchange<'exchangeView, DirectP>,
  ) -> AttemptStep<'policy, A>
  ! RedirectError | ValueError | E | CallbackError | ExchangeError | OutOfMemoryError
  ? R | CallbackRequirements | &mut SelectedBody<E, R> | &mut MonotonicClock | &mut Allocator | &mut Random
  where
    &mut DirectP provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut DirectP provides &HttpTransport from &mut HttpTransport {
    return run handleAttemptCore(
      move handler,
      move scratch,
      move callback,
      request,
      method,
      move exchange,
      HybridDirectFinalResponse<RoutedP, DirectP, H, A, CallbackError, CallbackRequirements> {},
    )
  }
}

impl<
  'attempt,
  'callback,
  'policy,
  E,
  ?R,
  RoutedP,
  DirectP,
  A,
  CallbackError,
  ?CallbackRequirements,
  H: HybridResponseHandler<RoutedP, DirectP, A, CallbackError ? CallbackRequirements>,
> HybridAttempt<'policy, RoutedP, DirectP, AttemptStep<'policy, A>, RedirectError | ValueError | E | CallbackError | ExchangeError | OutOfMemoryError ? R | CallbackRequirements | &mut SelectedBody<
  E,
  R,
> | &mut MonotonicClock | &mut Allocator | &mut Random> for RedirectHybridAttempt<
  'attempt,
  'callback,
  'policy,
  RoutedP,
  DirectP,
  A,
  E,
  R,
  CallbackError,
  CallbackRequirements,
  H,
> {
  effect<'call> fn handleRouted<
    'call,
    'exchangeView: 'call,
    'transport: 'exchangeView,
    'provider: 'transport,
    'tunnel: 'provider,
  >(
    provider: &mut Self,
    request: &'call AttemptRequest<'policy>,
    method: Method<'call>,
    exchange: &'call mut Exchange<
      'exchangeView,
      RouteTransport<'transport, 'provider, 'tunnel, RoutedP>,
    >,
  ) -> AttemptStep<'policy, A>
  ! RedirectError | ValueError | E | CallbackError | ExchangeError | OutOfMemoryError
  ? R | CallbackRequirements | &mut SelectedBody<E, R> | &mut MonotonicClock | &mut Allocator | &mut Random
  where
    &mut RoutedP provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut RoutedP provides &HttpTransport from &mut HttpTransport,
    &mut RoutedP provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut RoutedP provides &ByteDuplex from &mut ByteDuplex {
    let stored = Intrinsic.replace(
      provider.handler,
      Option<RedirectAttemptHandler<'policy, E, R>>.none(),
    )
    let handler = match move stored {
      Option.Some {value} => move value
      Option.None => unavailableHybrid<RedirectAttemptHandler<'policy, E, R>>()
    }
    return run RedirectAttemptHandler<
      E,
      R,
    >.handleHybridRouted<
      RoutedP,
      DirectP,
      A,
      CallbackError,
      CallbackRequirements,
      H,
    >(move handler, &mut provider.scratch, &mut provider.callback.*, request, method, move exchange)
  }
  effect<'call> fn handleDirect<'call, 'exchangeView: 'call>(
    provider: &mut Self,
    request: &'call AttemptRequest<'policy>,
    method: Method<'call>,
    exchange: &'call mut Exchange<'exchangeView, DirectP>,
  ) -> AttemptStep<'policy, A>
  ! RedirectError | ValueError | E | CallbackError | ExchangeError | OutOfMemoryError
  ? R | CallbackRequirements | &mut SelectedBody<E, R> | &mut MonotonicClock | &mut Allocator | &mut Random
  where
    &mut DirectP provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
    &mut DirectP provides &HttpTransport from &mut HttpTransport {
    let stored = Intrinsic.replace(
      provider.handler,
      Option<RedirectAttemptHandler<'policy, E, R>>.none(),
    )
    let handler = match move stored {
      Option.Some {value} => move value
      Option.None => unavailableHybrid<RedirectAttemptHandler<'policy, E, R>>()
    }
    return run RedirectAttemptHandler<
      E,
      R,
    >.handleHybridDirect<
      RoutedP,
      DirectP,
      A,
      CallbackError,
      CallbackRequirements,
      H,
    >(move handler, &mut provider.scratch, &mut provider.callback.*, request, method, move exchange)
  }
}

fn intoAttemptRequest<'policy>(state: RedirectState<'policy>, mode: BodyMode) -> AttemptRequest<
  'policy,
> {
  let RedirectState<'policy> {
    uri,
    method,
    headers,
    headerPolicy,
    version,
    continuePolicy,
    requestLimits,
    maxHeadBytes,
    maxCredentialBytes,
    expectedBodyMode,
  } = move state
  drop expectedBodyMode
  return AttemptRequest<'policy> {
    uri: move uri,
    method: move method,
    headers: move headers,
    headerPolicy: headerPolicy,
    version: version,
    continuePolicy: move continuePolicy,
    requestLimits: requestLimits,
    maxHeadBytes: maxHeadBytes,
    maxCredentialBytes: maxCredentialBytes,
    bodyMode: mode,
  }
}

struct InitialRedirect<'policy> {
  state: RedirectState<'policy>,
  history: History,
}

effect fn initialize<'uri, 'method, 'headers, 'policy>(
  request: Request<'uri, 'method, 'headers, 'policy>,
  policy: &'policy Policy,
) -> InitialRedirect<'policy> ! RedirectError | ValueError | OutOfMemoryError ? &mut Allocator {
  let limits = Policy.historyLimits(policy)
  let uriLength = String.byteLength(Uri.format(&request.uri))
  if uriLength > limits.maxUriBytes {
    fail RedirectError {
      component: RedirectComponent.Uri,
      reason: RedirectReason.LimitExceeded {
        limit: RedirectLimit.UriBytes,
        allowed: limits.maxUriBytes,
        attempted: uriLength,
      },
      context: emptyContext(usize.ZERO, Option<Status>.none()),
    }
  }
  let origin = match move requiredOrigin(&request.uri, usize.ZERO, Option<Status>.none()) {
    Result.Failure {error} => {
      let enriched = run enrichCurrent(move error, &request.uri)
      fail move enriched
    }
    Result.Success {value} => value
  }
  let mut history = match move run History.make(limits) {
    Result.Failure {error} => {
      let enriched = run enrichCurrent(move error, &request.uri)
      fail move enriched
    }
    Result.Success {value} => move value
  }
  match move run History.insert(&mut history, request.method, origin, &request.uri) {
    Result.Failure {error} => {
      let enriched = run enrichCurrent(move error, &request.uri)
      fail move enriched
    }
    Result.Success {value} => {}
  }
  let headers = match move run sanitizeHeaders(
    &request.headers,
    policy,
    false,
    BodyDecision.Retain,
    request.limits,
  ) {
    Result.Failure {error} => {
      fail move error
    }
    Result.Success {value} => move value
  }
  let uri = run Uri.copy(&request.uri)
  let method = run String.copy(Method.format(&request.method))
  return InitialRedirect<'policy> {
    state: RedirectState<'policy> {
      uri: move uri,
      method: move method,
      headers: move headers,
      headerPolicy: request.headerPolicy,
      version: request.version,
      continuePolicy: move request.continuePolicy,
      requestLimits: request.limits,
      maxHeadBytes: request.maxHeadBytes,
      maxCredentialBytes: request.maxCredentialBytes,
      expectedBodyMode: Option<BodyMode>.none(),
    },
    history: move history,
  }
}

service AttemptDispatch<'policy, H, A, E, ?R> {
  effect<'env> fn withAttempt<'env>(
    request: AttemptRequest<'policy>,
    deadline: Option<Instant>,
    handler: H,
  ) -> A ! E ? R | &mut AttemptDispatch<'policy, H, A, E, R>
}

struct RoutedAttemptDispatch<
  'client,
  'resources,
  'callback,
  'policy,
  P,
  A,
  C,
  H,
  BodyError,
  CallbackError,
  AcquisitionError,
  ?BodyRequirements,
  ?CallbackRequirements,
  ?AcquisitionRequirements,
> {
  policy: &'policy Policy,
  client: &'client mut C,
  scratch: &'resources mut [u8],
  callback: &'callback mut H,
}

impl<
  'client,
  'resources,
  'callback,
  'policy,
  P,
  A,
  BodyError,
  CallbackError,
  AcquisitionError,
  ?BodyRequirements,
  ?CallbackRequirements,
  ?AcquisitionRequirements,
  H: ResponseHandler<P, A, CallbackError ? CallbackRequirements>,
  C: AttemptClient<'policy, P, AttemptStep<'policy, A>, RedirectError | ValueError | BodyError | CallbackError | ExchangeError | OutOfMemoryError, AcquisitionError, AcquisitionRequirements ? BodyRequirements | CallbackRequirements | &mut SelectedBody<
    BodyError,
    BodyRequirements,
  > | &mut MonotonicClock | &mut Allocator | &mut Random>,
> AttemptDispatch<'policy, RedirectAttemptHandler<'policy, BodyError, BodyRequirements>, AttemptStep<
  'policy,
  A,
>, RedirectError | ValueError | BodyError | CallbackError | ExchangeError | OutOfMemoryError | AcquisitionError ? BodyRequirements | CallbackRequirements | AcquisitionRequirements | &mut SelectedBody<
  BodyError,
  BodyRequirements,
> | &mut MonotonicClock | &mut Allocator | &mut Random> for RoutedAttemptDispatch<
  'client,
  'resources,
  'callback,
  'policy,
  P,
  A,
  C,
  H,
  BodyError,
  CallbackError,
  AcquisitionError,
  BodyRequirements,
  CallbackRequirements,
  AcquisitionRequirements,
> {
  effect<'env> fn withAttempt<'env>(
    dispatch: &mut Self,
    request: AttemptRequest<'policy>,
    deadline: Option<Instant>,
    handler: RedirectAttemptHandler<'policy, BodyError, BodyRequirements>,
  ) -> AttemptStep<'policy, A>
  ! RedirectError | ValueError | BodyError | CallbackError | ExchangeError | OutOfMemoryError | AcquisitionError
  ? BodyRequirements | CallbackRequirements | AcquisitionRequirements | &mut SelectedBody<
    BodyError,
    BodyRequirements,
  > | &mut MonotonicClock | &mut Allocator | &mut Random {
    let mut provider = RedirectRoutedAttempt<
      P,
      A,
      BodyError,
      BodyRequirements,
      CallbackError,
      CallbackRequirements,
      H,
    > {
      handler: Option<RedirectAttemptHandler<'policy, BodyError, BodyRequirements>>.some(
        move handler,
      ),
      scratch: &mut dispatch.scratch,
      callback: &mut dispatch.callback.*,
    }
    return run AttemptClient<'policy, P, AttemptStep<'policy, A>, RedirectError | ValueError | BodyError | CallbackError | ExchangeError | OutOfMemoryError, AcquisitionError, AcquisitionRequirements ? BodyRequirements | CallbackRequirements | &mut SelectedBody<
      BodyError,
      BodyRequirements,
    > | &mut MonotonicClock | &mut Allocator | &mut Random>.withAttempt(
      &mut dispatch.client.*,
      move request,
      move deadline,
    )
      |> Effect.provideMut<
        Attempt<'policy, P, AttemptStep<'policy, A>, RedirectError | ValueError | BodyError | CallbackError | ExchangeError | OutOfMemoryError ? BodyRequirements | CallbackRequirements | &mut SelectedBody<
          BodyError,
          BodyRequirements,
        > | &mut MonotonicClock | &mut Allocator | &mut Random>,
      >(&mut provider)
  }
}

struct HybridAttemptDispatch<
  'client,
  'resources,
  'callback,
  'policy,
  RoutedP,
  DirectP,
  A,
  C,
  H,
  BodyError,
  CallbackError,
  AcquisitionError,
  ?BodyRequirements,
  ?CallbackRequirements,
  ?AcquisitionRequirements,
> {
  policy: &'policy Policy,
  client: &'client mut C,
  scratch: &'resources mut [u8],
  callback: &'callback mut H,
}

impl<
  'client,
  'resources,
  'callback,
  'policy,
  RoutedP,
  DirectP,
  A,
  BodyError,
  CallbackError,
  AcquisitionError,
  ?BodyRequirements,
  ?CallbackRequirements,
  ?AcquisitionRequirements,
  H: HybridResponseHandler<RoutedP, DirectP, A, CallbackError ? CallbackRequirements>,
  C: HybridAttemptClient<'policy, RoutedP, DirectP, AttemptStep<'policy, A>, RedirectError | ValueError | BodyError | CallbackError | ExchangeError | OutOfMemoryError, AcquisitionError, AcquisitionRequirements ? BodyRequirements | CallbackRequirements | &mut SelectedBody<
    BodyError,
    BodyRequirements,
  > | &mut MonotonicClock | &mut Allocator | &mut Random>,
> AttemptDispatch<'policy, RedirectAttemptHandler<'policy, BodyError, BodyRequirements>, AttemptStep<
  'policy,
  A,
>, RedirectError | ValueError | BodyError | CallbackError | ExchangeError | OutOfMemoryError | AcquisitionError ? BodyRequirements | CallbackRequirements | AcquisitionRequirements | &mut SelectedBody<
  BodyError,
  BodyRequirements,
> | &mut MonotonicClock | &mut Allocator | &mut Random> for HybridAttemptDispatch<
  'client,
  'resources,
  'callback,
  'policy,
  RoutedP,
  DirectP,
  A,
  C,
  H,
  BodyError,
  CallbackError,
  AcquisitionError,
  BodyRequirements,
  CallbackRequirements,
  AcquisitionRequirements,
> {
  effect<'env> fn withAttempt<'env>(
    dispatch: &mut Self,
    request: AttemptRequest<'policy>,
    deadline: Option<Instant>,
    handler: RedirectAttemptHandler<'policy, BodyError, BodyRequirements>,
  ) -> AttemptStep<'policy, A>
  ! RedirectError | ValueError | BodyError | CallbackError | ExchangeError | OutOfMemoryError | AcquisitionError
  ? BodyRequirements | CallbackRequirements | AcquisitionRequirements | &mut SelectedBody<
    BodyError,
    BodyRequirements,
  > | &mut MonotonicClock | &mut Allocator | &mut Random {
    let mut provider = RedirectHybridAttempt<
      RoutedP,
      DirectP,
      A,
      BodyError,
      BodyRequirements,
      CallbackError,
      CallbackRequirements,
      H,
    > {
      handler: Option<RedirectAttemptHandler<'policy, BodyError, BodyRequirements>>.some(
        move handler,
      ),
      scratch: &mut dispatch.scratch,
      callback: &mut dispatch.callback.*,
    }
    return run HybridAttemptClient<'policy, RoutedP, DirectP, AttemptStep<'policy, A>, RedirectError | ValueError | BodyError | CallbackError | ExchangeError | OutOfMemoryError, AcquisitionError, AcquisitionRequirements ? BodyRequirements | CallbackRequirements | &mut SelectedBody<
      BodyError,
      BodyRequirements,
    > | &mut MonotonicClock | &mut Allocator | &mut Random>.withAttempt(
      &mut dispatch.client.*,
      move request,
      move deadline,
    )
      |> Effect.provideMut<
        HybridAttempt<'policy, RoutedP, DirectP, AttemptStep<'policy, A>, RedirectError | ValueError | BodyError | CallbackError | ExchangeError | OutOfMemoryError ? BodyRequirements | CallbackRequirements | &mut SelectedBody<
          BodyError,
          BodyRequirements,
        > | &mut MonotonicClock | &mut Allocator | &mut Random>,
      >(&mut provider)
  }
}

interface SelectedAttempt<P, A, E, ?R> {
  effect<'env> fn handle<'env>(handler: Self, mode: BodyMode, replayable: bool) -> A ! E ? R
}

struct SelectedAttemptHandler<
  'policy,
  E,
  ?R,
  P,
  A,
  CallbackError,
  AcquisitionError,
  ?CallbackRequirements,
  ?AcquisitionRequirements,
> {
  state: RedirectState<'policy>,
  policy: &'policy Policy,
  history: History,
  followedHops: usize,
  hasScratch: bool,
  deadline: Option<Instant>,
}

impl<
  'policy,
  E,
  ?R,
  P,
  A,
  CallbackError,
  AcquisitionError,
  ?CallbackRequirements,
  ?AcquisitionRequirements,
> SelectedAttempt<P, AttemptStep<'policy, A>, RedirectError | ValueError | E | CallbackError | ExchangeError | OutOfMemoryError | AcquisitionError ? R | CallbackRequirements | AcquisitionRequirements | &mut SelectedBody<
  E,
  R,
> | &mut AttemptDispatch<'policy, RedirectAttemptHandler<'policy, E, R>, AttemptStep<'policy, A>, RedirectError | ValueError | E | CallbackError | ExchangeError | OutOfMemoryError | AcquisitionError ? R | CallbackRequirements | AcquisitionRequirements | &mut SelectedBody<
  E,
  R,
> | &mut MonotonicClock | &mut Allocator | &mut Random> | &mut MonotonicClock | &mut Allocator | &mut Random> for SelectedAttemptHandler<
  'policy,
  E,
  R,
  P,
  A,
  CallbackError,
  AcquisitionError,
  CallbackRequirements,
  AcquisitionRequirements,
>
where
  R in Without<R, ByteDuplex>,
  R in Without<R, HttpTransport>,
  CallbackRequirements in Without<CallbackRequirements, ByteDuplex>,
  CallbackRequirements in Without<CallbackRequirements, HttpTransport> {
  effect<'env> fn handle<'env>(self: Self, mode: BodyMode, replayable: bool) -> AttemptStep<
    'policy,
    A,
  >
  ! RedirectError | ValueError | E | CallbackError | ExchangeError | OutOfMemoryError | AcquisitionError
  ? R | CallbackRequirements | AcquisitionRequirements | &mut SelectedBody<E, R> | &mut AttemptDispatch<'policy, RedirectAttemptHandler<
    'policy,
    E,
    R,
  >, AttemptStep<'policy, A>, RedirectError | ValueError | E | CallbackError | ExchangeError | OutOfMemoryError | AcquisitionError ? R | CallbackRequirements | AcquisitionRequirements | &mut SelectedBody<
    E,
    R,
  > | &mut MonotonicClock | &mut Allocator | &mut Random> | &mut MonotonicClock | &mut Allocator | &mut Random {
    let SelectedAttemptHandler<
      'policy,
      E,
      R,
      P,
      A,
      CallbackError,
      AcquisitionError,
      CallbackRequirements,
      AcquisitionRequirements,
    > {state, policy, history, followedHops, hasScratch, deadline} = move self
    if let Option.Some {value} = &state.expectedBodyMode {
      if !bodyModesEqual(value, mode) {
        let enriched = run enrichCurrent(bodyContractFailure(followedHops), &state.uri.view())
        fail move enriched
      }
    }
    let nonempty = match mode {
      BodyMode.Empty => false
      _ => true
    }
    if nonempty && !hasScratch {
      let enriched = run enrichCurrent(bodyContractFailure(followedHops), &state.uri.view())
      fail move enriched
    }
    let request = intoAttemptRequest(move state, mode)
    let attemptHandler = RedirectAttemptHandler<'policy, E, R> {
      policy: policy,
      history: move history,
      followedHops: followedHops,
      replayable: replayable,
    }
    return run AttemptDispatch<
      'policy,
      RedirectAttemptHandler<'policy, E, R>,
      AttemptStep<'policy, A>,
      RedirectError | ValueError | E | CallbackError | ExchangeError | OutOfMemoryError | AcquisitionError,
      R | CallbackRequirements | AcquisitionRequirements | &mut SelectedBody<E, R> | &mut MonotonicClock | &mut Allocator | &mut Random,
    >.withAttempt(move request, move deadline, move attemptHandler)
  }
}

interface SourcePlan<
  P,
  BodyError,
  A,
  SourceError,
  HandlerError,
  ?BodyRequirements,
  ?SourceRequirements,
  ?HandlerRequirements,
  H: SelectedAttempt<P, A, HandlerError ? HandlerRequirements | &mut SelectedBody<
    BodyError,
    BodyRequirements,
  >>,
> {
  effect<'env> fn withSelected<'env>(plan: &mut Self, handler: H) -> A ! SourceError | HandlerError ? SourceRequirements | HandlerRequirements
  fn applyRedirect(plan: &mut Self, body: BodyDecision) -> ()
}

effect<'env> fn runEmptySelected<
  P,
  BodyError,
  A,
  HandlerError,
  ?BodyRequirements,
  ?HandlerRequirements,
  H: SelectedAttempt<P, A, HandlerError ? HandlerRequirements | &mut SelectedBody<
    BodyError,
    BodyRequirements,
  >> + 'env,
  'env,
>(handler: H) -> A ! HandlerError ? HandlerRequirements {
  let mut provider = BytesSelected<'static, BodyError, BodyRequirements> {
    bytes: b"",
    offset: usize.ZERO,
  }
  return run SelectedAttempt<P, A, HandlerError ? HandlerRequirements | &mut SelectedBody<
    BodyError,
    BodyRequirements,
  >>.handle(move handler, BodyMode.Empty, true)
    |> Effect.provideMut<SelectedBody<BodyError, BodyRequirements>>(&mut provider)
}

struct RepeatablePlan<
  'bytes,
  P,
  BodyError,
  A,
  HandlerError,
  ?BodyRequirements,
  ?HandlerRequirements,
  H,
> {
  bytes: &'bytes [u8],
  retained: bool,
}

impl<
  'bytes,
  P,
  BodyError,
  A,
  HandlerError,
  ?BodyRequirements,
  ?HandlerRequirements,
  H: SelectedAttempt<P, A, HandlerError ? HandlerRequirements | &mut SelectedBody<
    BodyError,
    BodyRequirements,
  >>,
> SourcePlan<P, BodyError, A, never, HandlerError, BodyRequirements, never, HandlerRequirements, H> for RepeatablePlan<
  'bytes,
  P,
  BodyError,
  A,
  HandlerError,
  BodyRequirements,
  HandlerRequirements,
  H,
> {
  effect<'env> fn withSelected<'env>(plan: &mut Self, handler: H) -> A
  ! HandlerError
  ? HandlerRequirements {
    if plan.retained && plan.bytes.length != usize.ZERO {
      let mut provider = BytesSelected<'bytes, BodyError, BodyRequirements> {
        bytes: plan.bytes,
        offset: usize.ZERO,
      }
      return run SelectedAttempt<P, A, HandlerError ? HandlerRequirements | &mut SelectedBody<
        BodyError,
        BodyRequirements,
      >>.handle(move handler, BodyMode.KnownLength {length: usize.toU64(plan.bytes.length)}, true)
        |> Effect.provideMut<SelectedBody<BodyError, BodyRequirements>>(&mut provider)
    }
    return run runEmptySelected<
      P,
      BodyError,
      A,
      HandlerError,
      BodyRequirements,
      HandlerRequirements,
      H,
    >(move handler)
  }
  fn applyRedirect(plan: &mut Self, body: BodyDecision) -> () {
    if body == BodyDecision.Drop {
      plan.retained = false
    }
    return ()
  }
}

union OneShotState<Producer> {
  Fresh {producer: Producer},
  Spent,
}

struct OneShotPlan<
  P,
  BodyError,
  A,
  HandlerError,
  ?BodyRequirements,
  ?HandlerRequirements,
  Producer,
  H,
> {
  state: OneShotState<Producer>,
}

impl<
  P,
  BodyError,
  A,
  HandlerError,
  ?BodyRequirements,
  ?HandlerRequirements,
  Producer: BodyProducer<BodyError ? BodyRequirements>,
  H: SelectedAttempt<P, A, HandlerError ? HandlerRequirements | &mut SelectedBody<
    BodyError,
    BodyRequirements,
  >>,
> SourcePlan<P, BodyError, A, never, HandlerError, BodyRequirements, never, HandlerRequirements, H> for OneShotPlan<
  P,
  BodyError,
  A,
  HandlerError,
  BodyRequirements,
  HandlerRequirements,
  Producer,
  H,
> {
  effect<'env> fn withSelected<'env>(plan: &mut Self, handler: H) -> A
  ! HandlerError
  ? HandlerRequirements {
    let state = Intrinsic.replace(plan.state, OneShotState<Producer>.Spent)
    return match move state {
      OneShotState.Spent => {
        return run runEmptySelected<
          P,
          BodyError,
          A,
          HandlerError,
          BodyRequirements,
          HandlerRequirements,
          H,
        >(move handler)
      }
      OneShotState.Fresh {producer} => {
        let mode = BodyProducer<BodyError ? BodyRequirements>.mode(&producer)
        let mut owned = move producer
        let mut provider = ProducerSelected<Producer, BodyError, BodyRequirements> {
          producer: &mut owned,
        }
        return run SelectedAttempt<P, A, HandlerError ? HandlerRequirements | &mut SelectedBody<
          BodyError,
          BodyRequirements,
        >>.handle(move handler, mode, false)
          |> Effect.provideMut<SelectedBody<BodyError, BodyRequirements>>(&mut provider)
      }
    }
  }
  fn applyRedirect(plan: &mut Self, body: BodyDecision) -> () {
    drop plan
    drop body
    return ()
  }
}

struct ReplayPlan<
  P,
  BodyError,
  A,
  FactoryError,
  HandlerError,
  ?BodyRequirements,
  ?FactoryRequirements,
  ?HandlerRequirements,
  Factory,
  Producer,
  H,
> {
  factory: Factory,
  retained: bool,
}

impl<
  P,
  BodyError,
  A,
  FactoryError,
  HandlerError,
  ?BodyRequirements,
  ?FactoryRequirements,
  ?HandlerRequirements,
  Producer: BodyProducer<BodyError ? BodyRequirements>,
  H: SelectedAttempt<P, A, HandlerError ? HandlerRequirements | &mut SelectedBody<
    BodyError,
    BodyRequirements,
  >>,
  Factory: ReplayFactory<Producer, FactoryError, FactoryRequirements>,
> SourcePlan<
  P,
  BodyError,
  A,
  FactoryError,
  HandlerError,
  BodyRequirements,
  FactoryRequirements,
  HandlerRequirements,
  H,
> for ReplayPlan<
  P,
  BodyError,
  A,
  FactoryError,
  HandlerError,
  BodyRequirements,
  FactoryRequirements,
  HandlerRequirements,
  Factory,
  Producer,
  H,
> {
  effect<'env> fn withSelected<'env>(plan: &mut Self, handler: H) -> A
  ! FactoryError | HandlerError
  ? FactoryRequirements | HandlerRequirements {
    if plan.retained {
      let producer = run ReplayFactory<Producer, FactoryError, FactoryRequirements>.acquire(
        &mut plan.factory,
      )
      let use = effect fn(owned: &mut Producer) -> A ! HandlerError ? HandlerRequirements {
        let mode = BodyProducer<BodyError ? BodyRequirements>.mode(&owned)
        let mut provider = ProducerSelected<Producer, BodyError, BodyRequirements> {
          producer: move owned,
        }
        return run SelectedAttempt<P, A, HandlerError ? HandlerRequirements | &mut SelectedBody<
          BodyError,
          BodyRequirements,
        >>.handle(move handler, mode, true)
          |> Effect.provideMut<SelectedBody<BodyError, BodyRequirements>>(&mut provider)
      }
      let release = effect fn(owned: &mut Producer) -> () {
        return ReplayFactory<Producer, FactoryError, FactoryRequirements>.release(
          &mut plan.factory,
          &mut owned,
        )
      }
      return run Effect.useReleaseNonParking(move producer, move use, move release)
    }
    return run runEmptySelected<
      P,
      BodyError,
      A,
      HandlerError,
      BodyRequirements,
      HandlerRequirements,
      H,
    >(move handler)
  }
  fn applyRedirect(plan: &mut Self, body: BodyDecision) -> () {
    if body == BodyDecision.Drop {
      plan.retained = false
    }
    return ()
  }
}

effect<'env> fn runResponseLoop<
  'policy,
  'client,
  'uri,
  'method,
  'headers,
  P,
  A,
  BodyError,
  SourceError,
  CallbackError,
  AcquisitionError,
  ?BodyRequirements,
  ?SourceRequirements,
  ?CallbackRequirements,
  ?AcquisitionRequirements,
  D,
  Plan: SourcePlan<
    P,
    BodyError,
    AttemptStep<'policy, A>,
    SourceError,
    RedirectError | ValueError | BodyError | CallbackError | ExchangeError | OutOfMemoryError | AcquisitionError,
    BodyRequirements,
    SourceRequirements,
    BodyRequirements | CallbackRequirements | AcquisitionRequirements | &mut AttemptDispatch<'policy, RedirectAttemptHandler<
      'policy,
      BodyError,
      BodyRequirements,
    >, AttemptStep<'policy, A>, RedirectError | ValueError | BodyError | CallbackError | ExchangeError | OutOfMemoryError | AcquisitionError ? BodyRequirements | CallbackRequirements | AcquisitionRequirements | &mut SelectedBody<
      BodyError,
      BodyRequirements,
    > | &mut MonotonicClock | &mut Allocator | &mut Random> | &mut MonotonicClock | &mut Allocator | &mut Random,
    SelectedAttemptHandler<
      'policy,
      BodyError,
      BodyRequirements,
      P,
      A,
      CallbackError,
      AcquisitionError,
      CallbackRequirements,
      AcquisitionRequirements,
    >,
  > + 'env,
  'env,
>(
  dispatch: &'client mut D,
  request: Request<'uri, 'method, 'headers, 'policy>,
  policy: &'policy Policy,
  plan: Plan,
  deadline: Option<Instant>,
  hasScratch: bool,
) -> A
! RedirectError | ValueError | BodyError | SourceError | CallbackError | ExchangeError | OutOfMemoryError | AcquisitionError
? BodyRequirements | SourceRequirements | CallbackRequirements | AcquisitionRequirements | &mut MonotonicClock | &mut Allocator | &mut Random
where
  &mut D provides &AttemptDispatch<'policy, RedirectAttemptHandler<
    'policy,
    BodyError,
    BodyRequirements,
  >, AttemptStep<'policy, A>, RedirectError | ValueError | BodyError | CallbackError | ExchangeError | OutOfMemoryError | AcquisitionError ? BodyRequirements | CallbackRequirements | AcquisitionRequirements | &mut SelectedBody<
    BodyError,
    BodyRequirements,
  > | &mut MonotonicClock | &mut Allocator | &mut Random> from BodyRequirements | SourceRequirements | CallbackRequirements | AcquisitionRequirements | &mut AttemptDispatch<'policy, RedirectAttemptHandler<
    'policy,
    BodyError,
    BodyRequirements,
  >, AttemptStep<'policy, A>, RedirectError | ValueError | BodyError | CallbackError | ExchangeError | OutOfMemoryError | AcquisitionError ? BodyRequirements | CallbackRequirements | AcquisitionRequirements | &mut SelectedBody<
    BodyError,
    BodyRequirements,
  > | &mut MonotonicClock | &mut Allocator | &mut Random> | &mut MonotonicClock | &mut Allocator | &mut Random,
  BodyRequirements in Without<BodyRequirements, ByteDuplex>,
  BodyRequirements in Without<BodyRequirements, HttpTransport>,
  SourceRequirements in Without<SourceRequirements, ByteDuplex>,
  SourceRequirements in Without<SourceRequirements, HttpTransport>,
  CallbackRequirements in Without<CallbackRequirements, ByteDuplex>,
  CallbackRequirements in Without<CallbackRequirements, HttpTransport>,
  AcquisitionRequirements in Without<AcquisitionRequirements, ByteDuplex>,
  AcquisitionRequirements in Without<AcquisitionRequirements, HttpTransport> {
  let initial = run initialize(move request, policy)
  let InitialRedirect<'policy> {state: initialState, history: initialHistory} = move initial
  let mut currentState = move initialState
  let mut currentHistory = move initialHistory
  let mut selectedPlan = move plan
  let mut followedHops = usize.ZERO
  while true {
    let selected = SelectedAttemptHandler<
      'policy,
      BodyError,
      BodyRequirements,
      P,
      A,
      CallbackError,
      AcquisitionError,
      CallbackRequirements,
      AcquisitionRequirements,
    > {
      state: move currentState,
      policy: policy,
      history: move currentHistory,
      followedHops: followedHops,
      hasScratch: hasScratch,
      deadline: copyDeadline(&deadline),
    }
    let outcome = run SourcePlan<
      P,
      BodyError,
      AttemptStep<'policy, A>,
      SourceError,
      RedirectError | ValueError | BodyError | CallbackError | ExchangeError | OutOfMemoryError | AcquisitionError,
      BodyRequirements,
      SourceRequirements,
      BodyRequirements | CallbackRequirements | AcquisitionRequirements | &mut AttemptDispatch<'policy, RedirectAttemptHandler<
        'policy,
        BodyError,
        BodyRequirements,
      >, AttemptStep<'policy, A>, RedirectError | ValueError | BodyError | CallbackError | ExchangeError | OutOfMemoryError | AcquisitionError ? BodyRequirements | CallbackRequirements | AcquisitionRequirements | &mut SelectedBody<
        BodyError,
        BodyRequirements,
      > | &mut MonotonicClock | &mut Allocator | &mut Random> | &mut MonotonicClock | &mut Allocator | &mut Random,
      SelectedAttemptHandler<
        'policy,
        BodyError,
        BodyRequirements,
        P,
        A,
        CallbackError,
        AcquisitionError,
        CallbackRequirements,
        AcquisitionRequirements,
      >,
    >.withSelected(&mut selectedPlan, move selected)
      |> Effect.provideMut<
        AttemptDispatch<'policy, RedirectAttemptHandler<'policy, BodyError, BodyRequirements>, AttemptStep<
          'policy,
          A,
        >, RedirectError | ValueError | BodyError | CallbackError | ExchangeError | OutOfMemoryError | AcquisitionError ? BodyRequirements | CallbackRequirements | AcquisitionRequirements | &mut SelectedBody<
          BodyError,
          BodyRequirements,
        > | &mut MonotonicClock | &mut Allocator | &mut Random>,
      >(&mut dispatch.*)
    match move outcome {
      AttemptStep<'policy, A>.Final {value} => {
        return move value
      }
      AttemptStep<'policy, A>.Redirect {state, history, body} => {
        SourcePlan<
          P,
          BodyError,
          AttemptStep<'policy, A>,
          SourceError,
          RedirectError | ValueError | BodyError | CallbackError | ExchangeError | OutOfMemoryError | AcquisitionError,
          BodyRequirements,
          SourceRequirements,
          BodyRequirements | CallbackRequirements | AcquisitionRequirements | &mut AttemptDispatch<'policy, RedirectAttemptHandler<
            'policy,
            BodyError,
            BodyRequirements,
          >, AttemptStep<'policy, A>, RedirectError | ValueError | BodyError | CallbackError | ExchangeError | OutOfMemoryError | AcquisitionError ? BodyRequirements | CallbackRequirements | AcquisitionRequirements | &mut SelectedBody<
            BodyError,
            BodyRequirements,
          > | &mut MonotonicClock | &mut Allocator | &mut Random> | &mut MonotonicClock | &mut Allocator | &mut Random,
          SelectedAttemptHandler<
            'policy,
            BodyError,
            BodyRequirements,
            P,
            A,
            CallbackError,
            AcquisitionError,
            CallbackRequirements,
            AcquisitionRequirements,
          >,
        >.applyRedirect(&mut selectedPlan, body)
        currentState = move state
        currentHistory = move history
        followedHops = followedHops + usize.ONE
      }
    }
  }
  return impossible<A>()
}

fn impossible<T>() -> T {
  return impossible<T>()
}

/// Follows redirects for a request without a body, and gives the final response to `handler`.
///
/// # Details
/// Each attempt is a new request with the same deadline. The body of each redirect response is
/// closed or drained as `policy` says. `handler` runs one time, and only if a final response
/// arrives.
pub effect<'env> fn withEmptyResponse<
  'client,
  'uri,
  'method,
  'headers,
  'policy,
  'scratch,
  P,
  A,
  CallbackError,
  AcquisitionError,
  ?CallbackRequirements,
  ?AcquisitionRequirements,
  H: ResponseHandler<P, A, CallbackError ? CallbackRequirements> + 'env,
  C: AttemptClient<'policy, P, AttemptStep<'policy, A>, RedirectError | ValueError | CallbackError | ExchangeError | OutOfMemoryError, AcquisitionError, AcquisitionRequirements ? CallbackRequirements | &mut SelectedBody<
    never,
    never,
  > | &mut MonotonicClock | &mut Allocator | &mut Random>,
  'env,
>(
  client: &'client mut C,
  request: Request<'uri, 'method, 'headers, 'policy>,
  policy: &'policy Policy,
  deadline: Option<Instant>,
  scratch: &'scratch mut [u8],
  handler: H,
) -> A
! RedirectError | ValueError | CallbackError | ExchangeError | OutOfMemoryError | AcquisitionError
? CallbackRequirements | AcquisitionRequirements | &mut MonotonicClock | &mut Allocator | &mut Random
where
  &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut P provides &HttpTransport from &mut HttpTransport,
  &mut P provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut P provides &ByteDuplex from &mut ByteDuplex,
  CallbackRequirements in Without<CallbackRequirements, ByteDuplex>,
  CallbackRequirements in Without<CallbackRequirements, HttpTransport>,
  AcquisitionRequirements in Without<AcquisitionRequirements, ByteDuplex>,
  AcquisitionRequirements in Without<AcquisitionRequirements, HttpTransport> {
  let hasScratch = scratch.length != usize.ZERO
  let mut callback = move handler
  let mut dispatch = RoutedAttemptDispatch<
    P,
    A,
    C,
    H,
    never,
    CallbackError,
    AcquisitionError,
    never,
    CallbackRequirements,
    AcquisitionRequirements,
  > {policy: policy, client: &mut client.*, scratch: &mut scratch, callback: &mut callback}
  return run runResponseLoop<
    'policy,
    P,
    A,
    never,
    never,
    CallbackError,
    AcquisitionError,
    never,
    never,
    CallbackRequirements,
    AcquisitionRequirements,
  >(
    &mut dispatch,
    move request,
    policy,
    RepeatablePlan<
      'static,
      P,
      never,
      AttemptStep<'policy, A>,
      RedirectError | ValueError | CallbackError | ExchangeError | OutOfMemoryError | AcquisitionError,
      never,
      CallbackRequirements | AcquisitionRequirements | &mut AttemptDispatch<'policy, RedirectAttemptHandler<
        'policy,
        never,
        never,
      >, AttemptStep<'policy, A>, RedirectError | ValueError | CallbackError | ExchangeError | OutOfMemoryError | AcquisitionError ? CallbackRequirements | AcquisitionRequirements | &mut SelectedBody<
        never,
        never,
      > | &mut MonotonicClock | &mut Allocator | &mut Random> | &mut MonotonicClock | &mut Allocator | &mut Random,
      SelectedAttemptHandler<
        'policy,
        never,
        never,
        P,
        A,
        CallbackError,
        AcquisitionError,
        CallbackRequirements,
        AcquisitionRequirements,
      >,
    > {bytes: b"", retained: true},
    move deadline,
    hasScratch,
  )
}

