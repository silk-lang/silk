static if (Intrinsic.targetOperatingSystem() == "windows" && Intrinsic.targetArchitecture() == "x86_64" && Intrinsic.targetAbi() == "msvc" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "darwin" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64") && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText(
  "libc",
) == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText(
  "libc",
) == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
  import silk.tls.trust_source_native {NativeFileTrustSource}
  static if Intrinsic.targetOperatingSystem() == "windows" {
    import silk.tls.trust_source_windows {WindowsRootTrustSource}
    import silk.platform.windows.path {WindowsPath}
    union ConfiguredTrust {
      Root {provider: WindowsRootTrustSource},
      File {provider: NativeFileTrustSource},
    }
    impl ConfiguredTrust {
      effect fn loadCurrent(self: &mut Self, limits: TrustLoadLimits) -> TrustSnapshot
      ! TrustSourceError | OutOfMemoryError ? &mut Allocator {
        return match &mut self.* {
          ConfiguredTrust.Root {provider} => run TrustSource.load(limits) |> Effect.provideMut<TrustSource>(&mut provider)
          ConfiguredTrust.File {provider} => run TrustSource.load(limits) |> Effect.provideMut<TrustSource>(&mut provider)
        }
      }
    }
    impl TrustSource for ConfiguredTrust { load: ConfiguredTrust.loadCurrent }
  } else { type ConfiguredTrust = NativeFileTrustSource }

  // A snapshot that a trust source loaded, and the limits it was loaded with.
  struct LoadedTrust {
    limits: TrustLoadLimits,
    snapshot: TrustSnapshot,
  }

  // The trust source of a client. It reads and decodes the bundle on the first secure connection
  // and gives each later connection a copy, so a client with the system bundle of about 150
  // anchors decodes it once rather than in every handshake. A load with other limits reads the
  // bundle again.
  struct CachedTrust {
    provider: ConfiguredTrust,
    loaded: Option<LoadedTrust>,
  }

  impl CachedTrust {
    fn of(provider: ConfiguredTrust) -> CachedTrust {
      return CachedTrust {provider: move provider, loaded: Option<LoadedTrust>.none()}
    }

    effect fn loadCached(self: &mut Self, limits: TrustLoadLimits) -> TrustSnapshot
    ! TrustSourceError | OutOfMemoryError ? &mut Allocator {
      if let Option.Some {value} = &self.loaded {
        if sameLimits(value.limits, limits) { return run copyLoaded(&value.snapshot, limits) }
      }
      let fresh = run TrustSource.load(limits) |> Effect.provideMut<TrustSource>(&mut self.provider)
      let copied = run copyLoaded(&fresh, limits)
      self.loaded = Option<LoadedTrust>.some(LoadedTrust {limits: limits, snapshot: move fresh})
      return move copied
    }
  }

  impl TrustSource for CachedTrust { load: CachedTrust.loadCached }

  effect fn copyLoaded(snapshot: &TrustSnapshot, limits: TrustLoadLimits) -> TrustSnapshot
  ! TrustSourceError | OutOfMemoryError ? &mut Allocator {
    return match move run TrustSnapshot.copy(snapshot, limits.snapshot) {
      Result<TrustSnapshot, TrustSourceError>.Success {value} => move value
      Result<TrustSnapshot, TrustSourceError>.Failure {error} => { fail move error }
    }
  }

  fn sameLimits(left: TrustLoadLimits, right: TrustLoadLimits) -> bool {
    return left.snapshot.anchors == right.snapshot.anchors && left.snapshot.encodedBytes == right.snapshot.encodedBytes
      && left.decode.inputBytes == right.decode.inputBytes && left.decode.certificateBytes == right.decode.certificateBytes
      && left.decode.totalDerBytes == right.decode.totalDerBytes && left.decode.certificates == right.decode.certificates
      && left.decode.fieldBytes == right.decode.fieldBytes && left.decode.extensions == right.decode.extensions
      && left.decode.depth == right.decode.depth && left.decode.nodes == right.decode.nodes
  }
  import silk.system.monotonic_clock_native {OsMonotonicClock}
  import silk.system.random_native {OsRandom}
  import silk.net.socket_native {NativeSocketError}
  import silk.net.resolver_native {NativeSystemResolver}
  import silk.system.system_clock_native {OsSystemClock}

  /// The default deadline for one request, in seconds.
  pub const DEFAULT_TIMEOUT_SECONDS: u64 = 30
  /// The default response body limit, in bytes.
  pub const DEFAULT_MAX_BODY_BYTES: usize = 16777216
  /// The default number of redirects followed.
  pub const DEFAULT_MAX_REDIRECTS: usize = 10
  // The most idle connections the client keeps open at once. An origin can have several, so that
  // concurrent requests reuse them.
  const MAX_IDLE: usize = 64
  /// The default number of requests that [`Http.sendAll`] runs at the same time.
  pub const DEFAULT_CONCURRENCY: usize = 32
  /// The maximum number of headers that [`NativeHttp.header`] adds.
  pub const MAX_DEFAULT_HEADERS: usize = 16

  union TrustChoice<'config> {
    Platform,
    Borrowed {path: string<'config>},
    Owned {path: Bytes},
  }

  /// A native HTTP client. It holds the defaults for all requests: the base URL, headers, limits,
  /// and trust.
  ///
  /// # When to use
  ///
  /// Give it one time, near `main`, with `Effect.provideMut<Http>(&mut http)`. All code that
  /// requires `? &mut Http` then sends real requests over sockets and TLS.
  ///
  /// # Details
  ///
  /// The provider has its own clocks, random source, and trust store, so you give only an
  /// allocator. The defaults are a deadline of 30 seconds for each request, a response body of at
  /// most 16 MiB, up to 10 redirects, and the PEM bundle of the platform for HTTPS:
  /// `/etc/ssl/cert.pem` on macOS and `/etc/ssl/certs/ca-certificates.crt` on Linux, or the logical
  /// Windows `ROOT` certificate store. Requests use HTTP/1.1 and send `Accept-Encoding: identity`,
  /// so the body arrives as the server sent it. The next request to an origin reuses an open
  /// connection to it. The client keeps up to 64 open connections, several for one origin when
  /// requests ran at the same time. It reads the trust bundle on its first HTTPS connection and
  /// keeps the anchors for later ones.
  ///
  /// [`Http.sendAll`] runs up to 32 requests at the same time on one thread, each on its own
  /// connection. Set the number with [`NativeHttp.withConcurrency`].
  ///
  /// Redirects follow the Fetch standard. After 303, and after 301 or 302 for a POST, the client
  /// sends a GET without a body. After 307 and 308, it sends the same method and body. A redirect
  /// from HTTPS to HTTP fails. A redirect to another origin does not send `Authorization` and
  /// `Cookie`.
  ///
  /// # Gotchas
  ///
  /// The deadline covers the TLS handshake and the HTTP exchange, but not the name lookup and the
  /// TCP connect. A change to the trust bundle file takes effect in a new client. The macOS
  /// keychain is not used, only the PEM bundle. [`NativeHttp.make`] reads no
  /// environment variables, so it never uses a proxy. Only `http://` proxies are supported.
  /// Windows imports root certificates rather than chain-engine policy; revocation, store usage
  /// properties, and disallowed-store entries are not imported.
  pub struct NativeHttp<'config> {
    baseValue: string<'config>,
    headerValues: [Field<'config>; 16],
    headerCount: usize,
    overflowValue: bool,
    timeoutValue: u64,
    maxBodyValue: usize,
    redirectValue: usize,
    failOnStatusValue: bool,
    trustChoice: TrustChoice<'config>,
    trust: Option<CachedTrust>,
    clock: OsMonotonicClock,
    random: OsRandom,
    secureProxy: Option<ProxyConfig>,
    plainProxy: Option<ProxyConfig>,
    noProxy: Bytes,
    idle: List<Box<IdleConnection>>,
    concurrencyValue: usize,
    // The trust sources that the worker tasks of `sendAll` made, kept for the next round so that a
    // task does not open the PEM bundle path again.
  }

  // A direct connection that finished its last exchange and stayed open, kept for the next request
  // to the same origin. The client keeps up to `MAX_IDLE` of them, each boxed: a TLS connection
  // holds kilobytes of record state, and a box moves as one pointer between the pool and a task.
  struct IdleConnection {
    origin: Origin,
    link: Link,
  }

  // ---- HTTP/2 ----
  //
  // A direct https connection offers `h2`, then `http/1.1`. When the server selects `h2`, each
  // request on it is one stream: the prepared HTTP/1.1 head is rewritten as HTTP/2 fields, and the
  // response is read whole, as `exchangeBody` reads it.

  // A connection that speaks HTTP/2, with its transport and its protocol state.
  struct Http2Link {
    transport: NativeTransport,
    driver: Driver,
    // The peer sent GOAWAY, or the connection failed: no new stream goes on it.
    closed: bool,
  }

  // The protocol of a kept connection.
  union Link {
    Http1 {connection: Connection<NativeTransport>},
    Http2 {link: Box<Http2Link>},
  }

  fn isHttp2(idle: &List<Box<IdleConnection>>, index: usize) -> bool {
    let kept = List<Box<IdleConnection>>.asSlice(&idle.*)
    let entry = &Box<IdleConnection>.get(&kept[index])[usize.ZERO]
    return match &entry.link {
      Link.Http1 {..} => false
      Link.Http2 {..} => true
    }
  }

  // Whether another request can go out on `link`. An HTTP/2 connection can carry one unless the
  // peer has sent GOAWAY or the connection failed; frames the peer sends while it is idle, such as
  // PING or SETTINGS, are read with the next response.
  fn linkReusable(link: &Link) -> bool {
    return match &link.* {
      Link.Http1 {connection} => ExchangeNative.reusable(&connection)
      Link.Http2 {link: kept} => {
        let open = &Box<Http2Link>.get(&kept)[usize.ZERO]
        !open.closed && !Driver.finished(&open.driver)
      }
    }
  }

  // Closes `link`, ignoring failures: the connection is being dropped. An HTTP/2 connection closes
  // without GOAWAY, as an HTTP/1.1 connection closes without a last request.
  effect fn closeLink(link: &mut Link) -> () {
    match &mut link.* {
      Link.Http1 {connection} => {
        let closed = run Effect.result(Exchange.close(&mut connection))
        drop closed
      }
      Link.Http2 {link: kept} => {
        let open = &mut Box<Http2Link>.getMut(&mut kept)[usize.ZERO]
        let closed = run Effect.result(HttpTransport.close())
          |> Effect.provideMut<HttpTransport>(&mut open.transport)
        drop closed
      }
    }
    return ()
  }

  // Makes the kept form of a connection that `acquireNegotiatedOwned` opened.
  effect fn linkOf(negotiated: Negotiated) -> Link ! ProtocolError | OutOfMemoryError ? &mut Allocator {
    return match move negotiated {
      Negotiated.Http1 {connection} => Link.Http1 {connection: move connection}
      Negotiated.Http2 {transport} => {
        let driver = run Driver.make(Http2Role.Client, Http2Limits.defaults())
        Link.Http2 {link: run Box<Http2Link>.make(Http2Link {transport: move transport, driver: move driver, closed: false})}
      }
    }
  }

  // Sends `exchange` as one stream on the HTTP/2 connection at `index`, and reads the whole response.
  // It returns none when the connection closed before the response began, so that an idempotent
  // request can go again on a new connection.
  effect fn exchangeHttp2(idle: &mut List<Box<IdleConnection>>, index: usize, exchange: Direct<'_>) -> Option<Received>
  ! HttpError | OutOfMemoryError
  ? &mut Allocator | &mut MonotonicClock | &mut Random {
    let kept = List<Box<IdleConnection>>.asMutSlice(&mut idle.*)
    let entry = &mut Box<IdleConnection>.getMut(&mut kept[index])[usize.ZERO]
    let secure = Origin.secure(&entry.origin)
    let open = match &mut entry.link {
      Link.Http2 {link} => &mut Box<Http2Link>.getMut(&mut link)[usize.ZERO]
      Link.Http1 {..} => { fail HttpError.make(HttpErrorKind.Protocol, "The connection does not speak HTTP/2.") }
    }
    let result = run Effect.result(streamHttp2(&mut open.driver, exchange, secure)
      |> Effect.provideMut<HttpTransport>(&mut open.transport))
    return match move result {
      Result.Success {value} => {
        if !value.reusable { open.closed = true }
        move value.received
      }
      Result.Failure {error} => {
        open.closed = true
        match move error {
          HttpError failure => { fail move failure }
          OutOfMemoryError failure => { fail move failure }
          ProtocolError failure => {
            drop failure
            fail HttpError.make(HttpErrorKind.Protocol, "The HTTP/2 connection failed.")
          }
          TransportError failure => {
            if transportTimedOut(&failure) {
              fail HttpError.make(HttpErrorKind.Timeout, "The request deadline passed.")
            }
            drop failure
            // A transport failure before any response leaves the request unanswered: it can go
            // again on a new connection.
            Option<Received>.none()
          }
        }
      }
    }
  }

  fn unanswered() -> HttpError {
    return HttpError.make(HttpErrorKind.Protocol, "The server closed the HTTP/2 connection before it answered.")
  }

  struct Streamed {
    received: Option<Received>,
    reusable: bool,
  }

  // The rewritten request: its HTTP/2 fields point into `storage`.
  struct Http2Request {
    storage: Bytes,
    // Name start, name length, value start, value length, for each field.
    spans: List<usize>,
  }

  // Rewrites the HTTP/1.1 head `head` as HTTP/2 fields: the request line becomes `:method`,
  // `:scheme` and `:path`, `Host` becomes `:authority`, names are lowercased, and the fields that
  // HTTP/2 forbids (RFC 9113 section 8.2.2) are left out.
  effect fn rewriteRequest(head: &[u8], secure: bool) -> Http2Request ! HttpError | OutOfMemoryError ? &mut Allocator {
    let mut storage = run Bytes.copy(head)
    // Four spans for each field; sixteen fields cover the usual request.
    let mut spans = List<usize>.make()
    run List<usize>.reserveExact(&mut spans, 64)
    let bytes = Bytes.asMutSlice(&mut storage)
    let mut space = usize.ZERO
    while space < bytes.length && bytes[space] != 32 { space = space + usize.ONE }
    let mut second = space + usize.ONE
    while second < bytes.length && bytes[second] != 32 { second = second + usize.ONE }
    let mut lineEnd = second
    while lineEnd < bytes.length && bytes[lineEnd] != 13 { lineEnd = lineEnd + usize.ONE }
    if second >= bytes.length || lineEnd + usize.ONE >= bytes.length {
      fail HttpError.make(HttpErrorKind.InvalidRequest, "The request head cannot be sent over HTTP/2.")
    }
    run appendSpan(&mut spans, usize.MAX, 0, 0, space)
    run appendSpan(&mut spans, usize.MAX - usize.ONE, if secure { 1 } else { 0 }, 0, 0)
    run appendSpan(&mut spans, usize.MAX - 2, 0, space + usize.ONE, second - space - usize.ONE)
    // The authority goes in its slot once `Host` is found; until then it is empty.
    run appendSpan(&mut spans, usize.MAX - 3, 0, 0, 0)
    let mut start = lineEnd + 2
    while start + usize.ONE < bytes.length && bytes[start] != 13 {
      let mut colon = start
      while colon < bytes.length && bytes[colon] != 58 { colon = colon + usize.ONE }
      let mut end = colon
      while end < bytes.length && bytes[end] != 13 { end = end + usize.ONE }
      if colon >= end || end >= bytes.length { break }
      let mut at = start
      while at < colon {
        if bytes[at] >= 65 && bytes[at] <= 90 { bytes[at] = bytes[at] + 32 }
        at = at + usize.ONE
      }
      let mut valueStart = colon + usize.ONE
      while valueStart < end && (bytes[valueStart] == 32 || bytes[valueStart] == 9) { valueStart = valueStart + usize.ONE }
      let name = Slice.view<u8>(&bytes, start, colon - start)
      if bytesEqual(name, b"host") {
        List<usize>.set(&mut spans, 14, valueStart)
        List<usize>.set(&mut spans, 15, end - valueStart)
      } else if !forbiddenInHttp2(name) {
        run appendSpan(&mut spans, start, colon - start, valueStart, end - valueStart)
      }
      start = end + 2
    }
    return Http2Request {storage: move storage, spans: move spans}
  }

  effect fn appendSpan(spans: &mut List<usize>, nameStart: usize, nameLength: usize, valueStart: usize, valueLength: usize) -> () ! OutOfMemoryError ? &mut Allocator {
    run List<usize>.append(&mut spans.*, nameStart)
    run List<usize>.append(&mut spans.*, nameLength)
    run List<usize>.append(&mut spans.*, valueStart)
    run List<usize>.append(&mut spans.*, valueLength)
    return ()
  }

  fn forbiddenInHttp2(name: &[u8]) -> bool {
    return bytesEqual(name, b"connection") || bytesEqual(name, b"keep-alive") || bytesEqual(name, b"proxy-connection")
      || bytesEqual(name, b"transfer-encoding") || bytesEqual(name, b"upgrade") || bytesEqual(name, b"te")
  }

  fn bytesEqual(left: &[u8], right: &[u8]) -> bool {
    if left.length != right.length { return false }
    let mut index = usize.ZERO
    while index < left.length {
      if left[index] != right[index] { return false }
      index = index + usize.ONE
    }
    return true
  }

  // The HTTP/2 fields of `request`.
  effect fn fieldsOf<'a>(request: &'a Http2Request) -> List<Http2Field<'a>> ! OutOfMemoryError ? &mut Allocator {
    let bytes = Bytes.asSlice(&request.storage)
    let spans = List<usize>.asSlice(&request.spans)
    let mut fields = List<Http2Field<'a>>.make()
    run List<Http2Field<'a>>.reserveExact(&mut fields, spans.length / 4)
    let mut at = usize.ZERO
    while at < spans.length {
      let nameStart = spans[at]
      let name: &'a [u8] = if nameStart == usize.MAX { b":method" } else if nameStart == usize.MAX - usize.ONE {
        b":scheme"
      } else if nameStart == usize.MAX - 2 { b":path" } else if nameStart == usize.MAX - 3 { b":authority" } else {
        Slice.view<u8>(bytes, nameStart, spans[at + usize.ONE])
      }
      let value: &'a [u8] = if nameStart == usize.MAX - usize.ONE {
        if spans[at + usize.ONE] == 1 { b"https" } else { b"http" }
      } else {
        Slice.view<u8>(bytes, spans[at + 2], spans[at + 3])
      }
      run List<Http2Field<'a>>.append(&mut fields, Http2Field<'a> {name: name, value: value, sensitive: false})
      at = at + 4
    }
    return move fields
  }

  effect fn streamHttp2(driver: &mut Driver, exchange: Direct<'_>, secure: bool) -> Streamed
  ! HttpError | ProtocolError | TransportError | OutOfMemoryError
  ? &mut HttpTransport | &mut Allocator | &mut MonotonicClock | &mut Random {
    let rewritten = run rewriteRequest(exchange.request.bytes(), secure)
    let fields = run fieldsOf(&rewritten)
    let payload = exchange.body
    let id = run Http2Connection.open(Driver.connection(&mut driver.*), List<Http2Field<'_>>.asSlice(&fields), payload.length == usize.ZERO)
    drop fields
    let deadline = SystemClock.make(SystemClock.seconds(exchange.deadline), SystemClock.nanoseconds(exchange.deadline))
    let mut sent = usize.ZERO
    let mut status: u16 = 0
    let mut head = Option<OwnedResponseHead>.none()
    let mut body = Bytes.make()
    let mut reusable = true
    while true {
      while sent < payload.length {
        let wrote = run Http2Connection.sendData(Driver.connection(&mut driver.*), id, Slice.view<u8>(payload, sent, payload.length - sent), true)
        if wrote == usize.ZERO { break }
        sent = sent + wrote
      }
      let next = run Driver.next(&mut driver.*, Option<Instant>.some(SystemClock.make(SystemClock.seconds(&deadline), SystemClock.nanoseconds(&deadline))))
      let event = match move next {
        Option.Some {value} => move value
        Option.None => {
          if status == 0 { return Streamed {received: Option<Received>.none(), reusable: false} }
          fail HttpError.make(HttpErrorKind.Protocol, "The HTTP/2 connection closed before the response ended.")
        }
      }
      match move event {
        Http2Event.Headers {stream, fields: received, endStream} => {
          if stream == id {
            if status == 0 {
              let code = statusField(&received)
              if code < 100 || code > 999 {
                fail HttpError.make(HttpErrorKind.Protocol, "The HTTP/2 response has no valid :status.")
              }
              // An informational response comes before the final one.
              if code >= 200 {
                status = code
                head = Option<OwnedResponseHead>.some(run headOf(code, &received))
              }
            }
            if endStream && status != 0 { break }
          }
        }
        Http2Event.Data {stream, bytes, endStream} => {
          let count = Bytes.length(&bytes)
          if stream == id {
            if count > exchange.maxBody - Bytes.length(&body) {
              fail HttpError {
                kind: HttpErrorKind.TooLarge,
                message: "The response body exceeds the configured limit.",
                status: Option<u16>.some(status),
                cause: HttpCause.None,
              }
            }
            run Bytes.append(&mut body, Bytes.asSlice(&bytes))
          }
          if count > usize.ZERO {
            run Http2Connection.release(Driver.connection(&mut driver.*), stream, usize.toU32(count))
          }
          if stream == id && endStream { break }
        }
        Http2Event.Reset {stream, code} => {
          if stream == id {
            // REFUSED_STREAM means the server did not process the request (RFC 9113 section 8.7).
            if code == 7 && status == 0 { return Streamed {received: Option<Received>.none(), reusable: true} }
            fail HttpError.make(HttpErrorKind.Protocol, "The server reset the HTTP/2 stream.")
          }
        }
        Http2Event.StreamError {stream, code} => {
          drop code
          if stream == id { fail HttpError.make(HttpErrorKind.Protocol, "The HTTP/2 response is malformed.") }
        }
        Http2Event.Goaway {lastStream, code, debug} => {
          drop code
          reusable = false
          if lastStream < id { return Streamed {received: Option<Received>.none(), reusable: false} }
        }
        _ => {}
      }
    }
    let mut location = Option<String>.none()
    let kept = match move head {
      Option.Some {value} => move value
      Option.None => { fail HttpError.make(HttpErrorKind.Protocol, "The HTTP/2 response has no head.") }
    }
    if isRedirect(status) {
      location = run redirectLocation(&kept)
    }
    // The request bytes queued last (WINDOW_UPDATE, RST_STREAM) go out with the next request.
    return Streamed {
      received: Option<Received>.some(Received {
        parts: run Box<ReceivedParts>.make(ReceivedParts {status: status, head: move kept, body: move body, location: move location}),
      }),
      reusable: reusable,
    }
  }

  fn statusField(fields: &List<Http2Header>) -> u16 {
    let all = List<Http2Header>.asSlice(&fields.*)
    let mut index = usize.ZERO
    while index < all.length {
      let name = Bytes.asSlice(&all[index].name)
      if bytesEqual(name, b":status") {
        let value = Bytes.asSlice(&all[index].value)
        if value.length != 3 { return 0 }
        let mut code: u16 = 0
        let mut at = usize.ZERO
        while at < 3 {
          if value[at] < 48 || value[at] > 57 { return 0 }
          code = code * 10 + u8.toU16(value[at] - 48)
          at = at + usize.ONE
        }
        return code
      }
      index = index + usize.ONE
    }
    return 0
  }

  // The response head of an HTTP/2 response: `code`, and the regular fields of `fields`.
  effect fn headOf(code: u16, fields: &List<Http2Header>) -> OwnedResponseHead ! HttpError | OutOfMemoryError ? &mut Allocator {
    let all = List<Http2Header>.asSlice(&fields.*)
    let mut count = usize.ZERO
    let mut bytes = usize.ZERO
    let mut index = usize.ZERO
    while index < all.length {
      count = count + usize.ONE
      bytes = bytes + Bytes.length(&all[index].name) + Bytes.length(&all[index].value)
      index = index + usize.ONE
    }
    let mut headers = run OwnedHeaders.withCapacity(count, bytes)
    index = usize.ZERO
    while index < all.length {
      let name = Bytes.asSlice(&all[index].name)
      if name.length > usize.ZERO && name[0] != 58 {
        // The HPACK decoder accepted the field, so its name is a lowercase token and its value
        // has no CR, LF or NUL (RFC 9113 section 8.2.1).
        run unsafe OwnedHeaders.appendUnchecked(&mut headers, name, Bytes.asSlice(&all[index].value))
      }
      index = index + usize.ONE
    }
    let status = match move Status.fromCode(code) {
      Result.Success {value} => value
      Result.Failure {..} => { fail HttpError.make(HttpErrorKind.Protocol, "The HTTP/2 response has no valid :status.") }
    }
    return match move run OwnedResponseHead.make(Version.Http11, status, b"", move headers, Limits.defaults().head.values) {
      Result.Success {value} => move value
      Result.Failure {error} => {
        fail HttpError.caused(HttpErrorKind.Protocol, "The response head exceeds the header limits.", HttpCause.Value {error: move error})
      }
    }
  }

  impl<'config> NativeHttp<'config> {
    /// Returns a client with the default limits and platform trust. It reads
    /// nothing yet.
    ///
    /// # Details
    ///
    /// The defaults are a deadline of 30 seconds for each request, a response body of at most 16
    /// MiB, up to 10 redirects, and the PEM bundle `/etc/ssl/cert.pem` on macOS or
    /// `/etc/ssl/certs/ca-certificates.crt` on Linux, or the logical Windows `ROOT` store.
    /// Windows imports certificate anchors without chain-engine policy, store usage properties,
    /// disallowed-store entries, or revocation. Use [`NativeHttp.fromEnvironment`] to honor
    /// `SSL_CERT_FILE`, which replaces platform trust with the configured PEM bundle.
    pub fn make() -> NativeHttp<'config> {
      let empty = Field<'config> {name: "", value: ""}
      return NativeHttp<'config> {
        baseValue: "",
        headerValues: [
          empty, empty,
          empty, empty,
          empty, empty,
          empty, empty,
          empty, empty,
          empty, empty,
          empty, empty,
          empty, empty,
        ],
        headerCount: usize.ZERO,
        overflowValue: false,
        timeoutValue: DEFAULT_TIMEOUT_SECONDS,
        maxBodyValue: DEFAULT_MAX_BODY_BYTES,
        redirectValue: DEFAULT_MAX_REDIRECTS,
        failOnStatusValue: false,
        trustChoice: TrustChoice<'config>.Platform,
        trust: Option<CachedTrust>.none(),
        clock: OsMonotonicClock.make(),
        random: OsRandom.make(),
        secureProxy: Option<ProxyConfig>.none(),
        plainProxy: Option<ProxyConfig>.none(),
        noProxy: Bytes.make(),
        idle: List<Box<IdleConnection>>.make(),
        concurrencyValue: DEFAULT_CONCURRENCY,
      }
    }

    /// Makes a client that uses `SSL_CERT_FILE` as its PEM bundle and the proxy variables when they
    /// are set.
    ///
    /// # Details
    ///
    /// A relative `SSL_CERT_FILE` is resolved against the working directory. An empty value fails.
    ///
    /// HTTPS requests go through `HTTPS_PROXY`, then `https_proxy`, `ALL_PROXY`, and `all_proxy`,
    /// the first one that is set and not empty. Plain HTTP requests go through `HTTP_PROXY`, then
    /// `http_proxy`, `ALL_PROXY`, and `all_proxy`. HTTPS uses a `CONNECT` tunnel, so TLS still
    /// checks the server certificate. A proxy URL such as `http://user:pass@proxy:3128` sends Basic
    /// credentials to the proxy. A URL without a scheme is read as `http://`.
    ///
    /// `NO_PROXY` or `no_proxy` lists hosts that are reached directly, separated by commas. An entry
    /// matches the host and its subdomains, so `example.com` and `.example.com` both match
    /// `api.example.com`. A port in an entry is ignored, and `*` matches every host. An address
    /// range such as `10.0.0.0/8` matches nothing; list the addresses instead.
    ///
    /// # Errors
    ///
    /// A proxy URL that is not valid fails with `InvalidUrl`. Only `http://` proxies are supported,
    /// so an `https://` or `socks5://` proxy URL fails too.
    pub effect fn fromEnvironment() -> NativeHttp<'config>
    ! HttpError | HostInputError | OutOfMemoryError
    ? &mut HostInput | &mut Allocator {
      let selected = run HostInput.variable(b"SSL_CERT_FILE")
      let mut client = NativeHttp<'config>.make()
      let secureNames: [&'static [u8]; 4] = [b"HTTPS_PROXY", b"https_proxy", b"ALL_PROXY", b"all_proxy"]
      let plainNames: [&'static [u8]; 4] = [b"HTTP_PROXY", b"http_proxy", b"ALL_PROXY", b"all_proxy"]
      let bypassNames: [&'static [u8]; 2] = [b"NO_PROXY", b"no_proxy"]
      let secureUrl = run firstVariable(&secureNames)
      if let Option.Some {value: secureText} = &secureUrl {
        client.secureProxy = Option<ProxyConfig>.some(run proxyConfig(Bytes.asSlice(&secureText), u64.toU64(1)))
      }
      let plainUrl = run firstVariable(&plainNames)
      if let Option.Some {value: plainText} = &plainUrl {
        client.plainProxy = Option<ProxyConfig>.some(run proxyConfig(Bytes.asSlice(&plainText), u64.toU64(2)))
      }
      let hosts = run firstVariable(&bypassNames)
      if let Option.Some {value: bypassText} = move hosts {
        client.noProxy = move bypassText
      }
      match move selected {
        Option.None => { return move client }
        Option.Some {value} => {
          if Bytes.length(&value) == usize.ZERO {
            fail HttpError.make(HttpErrorKind.Tls, "SSL_CERT_FILE is empty; unset it to use platform trust.")
          }
          static if Intrinsic.targetOperatingSystem() == "windows" {
            let cwd = run HostInput.workingDirectory()
            let resolved = run Effect.result(windowsBundlePath(Bytes.asSlice(&cwd), Bytes.asSlice(&value)))
            let path = match move resolved {
              Result<Bytes, FileError | OutOfMemoryError>.Success {value: path} => move path
              Result<Bytes, FileError | OutOfMemoryError>.Failure {error} => match move error {
                FileError _invalid => { fail HttpError.make(HttpErrorKind.Tls, "SSL_CERT_FILE is not a valid Windows path.") }
                OutOfMemoryError exhausted => { fail move exhausted }
              }
            }
            client.trustChoice = TrustChoice<'config>.Owned {path: move path}
            return move client
          }
          if Bytes.asSlice(&value)[usize.ZERO] == 47 {
            client.trustChoice = TrustChoice<'config>.Owned {path: move value}
            return move client
          }
          let mut absolute = run HostInput.workingDirectory()
          let cwd = Bytes.asSlice(&absolute)
          let needsSeparator = cwd.length > usize.ZERO && cwd[cwd.length - usize.ONE] != 47
          drop cwd
          if needsSeparator { run Bytes.append(&mut absolute, b"/") }
          run Bytes.append(&mut absolute, Bytes.asSlice(&value))
          client.trustChoice = TrustChoice<'config>.Owned {path: move absolute}
          return move client
        }
      }
    }

    /// Puts `url` before each request URL that has no scheme, such as `"/repos"`.
    pub fn baseUrl(self: Self, url: string<'config>) -> NativeHttp<'config> {
      let mut next = move self
      next.baseValue = url
      return move next
    }

    /// Adds a header to each request. A header of the request with the same name replaces it.
    pub fn header(self: Self, name: string<'config>, value: string<'config>) -> NativeHttp<'config> {
      let mut next = move self
      if next.headerCount == MAX_DEFAULT_HEADERS {
        next.overflowValue = true
        return move next
      }
      next.headerValues[next.headerCount] = Field<'config> {name: name, value: value}
      next.headerCount = next.headerCount + usize.ONE
      return move next
    }

    /// Sets the default deadline for each request.
    pub fn timeoutSeconds(self: Self, seconds: u64) -> NativeHttp<'config> {
      let mut next = move self
      next.timeoutValue = seconds
      return move next
    }

    /// Sets the default response body limit.
    pub fn maxBodyBytes(self: Self, limit: usize) -> NativeHttp<'config> {
      let mut next = move self
      next.maxBodyValue = limit
      return move next
    }

    /// Sets how many redirects requests follow by default. With 0, a redirect response is returned
    /// as it is.
    pub fn maxRedirects(self: Self, hops: usize) -> NativeHttp<'config> {
      let mut next = move self
      next.redirectValue = hops
      return move next
    }

    /// Sets how many requests [`Http.sendAll`] runs at the same time. A value of 0 counts as 1.
    pub fn withConcurrency(self: Self, limit: usize) -> NativeHttp<'config> {
      let mut next = move self
      next.concurrencyValue = limit
      if limit == usize.ZERO { next.concurrencyValue = usize.ONE }
      return move next
    }

    /// Makes each final response with a status outside 200 to 299 fail with a `Status` error.
    pub fn failOnStatus(self: Self) -> NativeHttp<'config> {
      let mut next = move self
      next.failOnStatusValue = true
      return move next
    }

    /// Uses the PEM bundle at the absolute path `path`, such as `"/etc/ssl/cert.pem"`, instead of
    /// platform trust. On Windows, use an absolute native drive path or `/C:/...` machine path;
    /// the bundle is opened on local NTFS without following reparse points.
    pub fn trustBundle(self: Self, path: string<'config>) -> NativeHttp<'config> {
      let mut next = move self
      next.trustChoice = TrustChoice<'config>.Borrowed {path: path}
      next.trust = Option<CachedTrust>.none()
      return move next
    }
  }

  fn platformBundle() -> &'static [u8] {
    static if Intrinsic.targetOperatingSystem() == "darwin" {
      return b"/etc/ssl/cert.pem"
    } else {
      return b"/etc/ssl/certs/ca-certificates.crt"
    }
  }

  struct Settings {
    timeoutSeconds: u64,
    maxBody: usize,
    redirects: usize,
  }

  // A response travels boxed: every effect layer between the exchange and `advance` moves it, and
  // a pointer is cheaper to move than the head, body, and location.
  struct Received {
    parts: Box<ReceivedParts>,
  }

  struct ReceivedParts {
    status: u16,
    head: OwnedResponseHead,
    body: Bytes,
    location: Option<String>,
  }

  fn isRedirect(status: u16) -> bool {
    return status == 301 || status == 302 || status == 303 || status == 307 || status == 308
  }

  fn sameName(left: string, right: string) -> bool {
    let a = String.utf8Bytes(left)
    let b = String.utf8Bytes(right)
    if a.length != b.length { return false }
    let mut index = usize.ZERO
    while index < a.length {
      let mut x = a[index]
      let mut y = b[index]
      if x >= 65 && x <= 90 { x = x + 32 }
      if y >= 65 && y <= 90 { y = y + 32 }
      if x != y { return false }
      index = index + usize.ONE
    }
    return true
  }

  fn invalid(message: string<'static>) -> HttpError {
    return HttpError.make(HttpErrorKind.InvalidRequest, message)
  }

  fn redirectFailure(message: string<'static>) -> HttpError {
    return HttpError.make(HttpErrorKind.Redirect, message)
  }

  // The connection options of a request: the defaults, with its timeout as the handshake limit.
  fn requestOptions(nanoseconds: u64) -> Options {
    let mut options = Options.defaults()
    options.handshakeNanoseconds = nanoseconds
    // Requests are small writes that wait for an answer, so Nagle's algorithm only adds delay.
    options.noDelay = true
    // An https connection offers `h2`, then `http/1.1`; the server picks.
    options.alpn = AlpnPolicy.PreferHttp2
    return move options
  }

  fn limitsFor(maxBody: usize) -> Limits {
    let mut selected = Limits.defaults()
    // The server decides when a kept connection closes; the client sets no count of its own.
    selected.maxRequests = usize.MAX
    // Leave room above the caller's limit so the client reports TooLarge before framing does.
    let room = usize.toU64(maxBody) + u64.toU64(65536)
    if room > selected.responseBody.maxPayloadBytes {
      selected.responseBody.maxPayloadBytes = room
      selected.responseBody.maxWireBytes = room + room
    }
    return selected
  }

  effect fn ensureTrust(client: &mut NativeHttp<'_>) -> () ! HttpError | OutOfMemoryError ? &mut Allocator {
    if let Option.Some {..} = &client.trust { return () }
    let plan = run trustPlan(&client.*)
    client.trust = Option<CachedTrust>.some(CachedTrust.of(run trustOf(&plan)))
  }

  // What a task of `sendAll` needs to make its own trust source.
  union TrustPlan {
    // The logical Windows ROOT store.
    Root,
    // The PEM bundle at this path.
    Bundle {path: Bytes},
  }

  effect fn trustPlan(client: &NativeHttp<'_>) -> TrustPlan ! OutOfMemoryError ? &mut Allocator {
    static if Intrinsic.targetOperatingSystem() == "windows" {
      if let TrustChoice.Platform = &client.trustChoice { return TrustPlan.Root }
    }
    let path = match & client.trustChoice {
      TrustChoice.Platform => run Bytes.copy(platformBundle())
      TrustChoice.Borrowed {path} => run Bytes.copy(String.utf8Bytes(path))
      TrustChoice.Owned {path} => run Bytes.copy(Bytes.asSlice(&path))
    }
    return TrustPlan.Bundle {path: move path}
  }

  effect fn copyPlan(plan: &TrustPlan) -> TrustPlan ! OutOfMemoryError ? &mut Allocator {
    return match & plan.* {
      TrustPlan.Root => TrustPlan.Root
      TrustPlan.Bundle {path} => TrustPlan.Bundle {path: run Bytes.copy(Bytes.asSlice(&path))}
    }
  }

  effect fn trustOf(plan: &TrustPlan) -> ConfiguredTrust ! HttpError | OutOfMemoryError ? &mut Allocator {
    let configured = match & plan.* {
      TrustPlan.Root => {
        static if Intrinsic.targetOperatingSystem() == "windows" {
          return ConfiguredTrust.Root {provider: WindowsRootTrustSource.make()}
        } else { fail HttpError.make(HttpErrorKind.Tls, "The platform trust store exists only on Windows.") }
      }
      TrustPlan.Bundle {path} => run Effect.result(trustAt(Bytes.asSlice(&path)))
    }
    return match move configured {
      Result.Success {value} => {
        static if Intrinsic.targetOperatingSystem() == "windows" {
          return ConfiguredTrust.File {provider: move value}
        } else { return move value }
      }
      Result.Failure {error} => match move error {
        HttpError failure => { fail move failure }
        FileError _failure => { fail HttpError.make(HttpErrorKind.Tls, "The PEM bundle path is not a valid file name.") }
        TrustSourceError failure => {
          fail HttpError.caused(HttpErrorKind.Tls, "Could not configure the PEM trust bundle.", HttpCause.Trust {error: move failure})
        }
        OutOfMemoryError exhausted => { fail move exhausted }
      }
    }
  }

  effect fn trustAt(bundle: &[u8]) -> NativeFileTrustSource
  ! HttpError | FileError | TrustSourceError | OutOfMemoryError
  ? &mut Allocator {
    static if Intrinsic.targetOperatingSystem() == "windows" {
      let absolute = if bundle.length > 0 && bundle[0] == 47 {
        run Path.fromBytes(bundle)
      } else { run WindowsPath.fromNativeBytes(bundle) }
      let parent = match move run WindowsPath.parent(&absolute) {
        Option<Path>.Some {value} => move value
        Option<Path>.None => { fail HttpError.make(HttpErrorKind.Tls, "The PEM bundle names a volume, not a file.") }
      }
      let root = run WindowsPath.toNativeBytes(&parent)
      let bytes = Path.rawBytes(&absolute)
      let start = Path.rawBytes(&parent).length
      let path = run Path.fromBytes(Slice.view(bytes, start, bytes.length - start))
      // The confined Windows filesystem accepts normalized native drive roots.
      let native = Bytes.asSlice(&root)
      return run NativeFileTrustSource.make(Slice.view(native, 4, native.length - 4), &path)
    }
    if bundle.length == usize.ZERO || bundle.length > 4096 || bundle[usize.ZERO] != 47 {
      fail HttpError.make(HttpErrorKind.Tls, "The PEM bundle must be an absolute path of at most 4096 bytes.")
    }
    let mut index = usize.ZERO
    let mut separator = usize.ZERO
    while index < bundle.length {
      if bundle[index] == 0 { fail HttpError.make(HttpErrorKind.Tls, "The PEM bundle path contains a NUL byte.") }
      if bundle[index] == 47 { separator = index }
      index = index + usize.ONE
    }
    if separator + usize.ONE == bundle.length {
      fail HttpError.make(HttpErrorKind.Tls, "The PEM bundle path names a directory, not a file.")
    }
    // The parent directory is trusted configuration (on macOS /etc is a symlink); only the final
    // file is opened beneath it with the no-follow policy.
    let path = run Path.fromBytes(Slice.view<u8>(bundle, separator, bundle.length - separator))
    if separator == usize.ZERO {
      return run NativeFileTrustSource.make(b"/", &path)
    }
    return run NativeFileTrustSource.make(Slice.view<u8>(bundle, usize.ZERO, separator), &path)
  }

  static if Intrinsic.targetOperatingSystem() == "windows" {
    effect fn windowsBundlePath(cwd: &[u8], value: &[u8]) -> Bytes
    ! FileError | OutOfMemoryError ? &mut Allocator {
      let base = run WindowsPath.fromNativeBytes(cwd)
      let resolved = run WindowsPath.resolveBytes(&base, value)
      return run Bytes.copy(Path.rawBytes(&resolved))
    }
  }

  effect fn firstVariable(names: &[&'static [u8]]) -> Option<Bytes>
  ! HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
    let mut index = usize.ZERO
    while index < names.length {
      let found = run HostInput.variable(names[index])
      if let Option.Some {value: text} = move found {
        if Bytes.length(&text) > usize.ZERO { return Option<Bytes>.some(move text) }
      }
      index = index + usize.ONE
    }
    return Option<Bytes>.none()
  }

  fn isSpace(byte: u8) -> bool {
    return byte == 32 || byte == 9 || byte == 10 || byte == 13
  }

  fn lowered(byte: u8) -> u8 {
    if byte >= 65 && byte <= 90 { return byte + 32 }
    return byte
  }

  fn hexValue(byte: u8) -> Option<u8> {
    if byte >= 48 && byte <= 57 { return Option<u8>.some(byte - 48) }
    let folded = lowered(byte)
    if folded >= 97 && folded <= 102 { return Option<u8>.some(folded - 87) }
    return Option<u8>.none()
  }

  fn statusOf(head: &OwnedResponseHead) -> u16 {
    let view = head.view()
    return Status.code(&view.status())
  }

  fn badProxy() -> HttpError {
    return HttpError.make(HttpErrorKind.InvalidUrl, "The proxy URL is not valid; only http://host:port proxies are supported.")
  }

  // Reads a proxy URL such as `http://user:pass@proxy:3128/`. The user information becomes a Basic
  // token, because ProxyConfig accepts only a scheme, a host, and a port.
  effect fn proxyConfig(raw: &[u8], id: u64) -> ProxyConfig ! HttpError | OutOfMemoryError ? &mut Allocator {
    let mut start = usize.ZERO
    let mut end = raw.length
    while start < end && isSpace(raw[start]) { start = start + usize.ONE }
    while end > start && isSpace(raw[end - usize.ONE]) { end = end - usize.ONE }
    let mut full = Bytes.make()
    let mut index = start
    let mut scheme = false
    while index + usize.ONE + usize.ONE < end {
      if raw[index] == 58 && raw[index + usize.ONE] == 47 && raw[index + usize.ONE + usize.ONE] == 47 {
        scheme = true
        break
      }
      if raw[index] == 47 || raw[index] == 64 { break }
      index = index + usize.ONE
    }
    if !scheme { run Bytes.append(&mut full, b"http://") }
    run Bytes.append(&mut full, Slice.view<u8>(raw, start, end - start))
    let text = Bytes.asSlice(&full)
    let mut authority = usize.ZERO
    index = usize.ZERO
    while index + usize.ONE + usize.ONE < text.length {
      if text[index] == 58 && text[index + usize.ONE] == 47 && text[index + usize.ONE + usize.ONE] == 47 {
        authority = index + 3
        break
      }
      index = index + usize.ONE
    }
    let mut finish = authority
    while finish < text.length && text[finish] != 47 && text[finish] != 63 && text[finish] != 35 { finish = finish + usize.ONE }
    // Only an empty path or `/` may follow the authority.
    if finish < text.length && !(finish + usize.ONE == text.length && text[finish] == 47) { fail badProxy() }
    let mut at = Option<usize>.none()
    index = authority
    while index < finish {
      if text[index] == 64 { at = Option<usize>.some(index) }
      index = index + usize.ONE
    }
    let mut stripped = Bytes.make()
    run Bytes.append(&mut stripped, Slice.view<u8>(text, usize.ZERO, authority))
    let mut authentication = ProxyAuth.none(ProxyAuthContextId.make(id))
    match move at {
      Option.None => run Bytes.append(&mut stripped, Slice.view<u8>(text, authority, finish - authority))
      Option.Some {value: sign} => {
        run Bytes.append(&mut stripped, Slice.view<u8>(text, sign + usize.ONE, finish - sign - usize.ONE))
        let mut credentials = Bytes.make()
        index = authority
        while index < sign {
          let mut byte = text[index]
          if byte == 37 && index + usize.ONE + usize.ONE < sign {
            if let Option.Some {value: high} = hexValue(text[index + usize.ONE]) {
              if let Option.Some {value: low} = hexValue(text[index + usize.ONE + usize.ONE]) {
                byte = high * 16 + low
                index = index + usize.ONE + usize.ONE
              }
            }
          }
          run Bytes.append(&mut credentials, &[byte])
          index = index + usize.ONE
        }
        let size = match move Base64.encodedLength(Bytes.length(&credentials)) {
          Result.Success {value} => value
          Result.Failure {..} => { fail badProxy() }
        }
        let mut token = run Bytes.zeroed(size)
        match move Base64.encodeInto(Bytes.asMutSlice(&mut token), Bytes.asSlice(&credentials)) {
          Result.Success {value} => { drop value }
          Result.Failure {..} => { fail badProxy() }
        }
        authentication = match move run ProxyAuth.preparedBasic(ProxyAuthContextId.make(id), Bytes.asSlice(&token)) {
          Result.Success {value} => move value
          Result.Failure {..} => { fail badProxy() }
        }
      }
    }
    drop text
    let url = match move run String.copyUtf8(Bytes.asSlice(&stripped)) {
      Result.Success {value} => move value
      Result.Failure {..} => { fail badProxy() }
    }
    let none: [Origin; 0] = []
    let bypass = match move run BypassPolicy.copy(&none) {
      Result.Success {value} => move value
      Result.Failure {..} => { fail badProxy() }
    }
    return match move ProxyConfig.fromUri(ProxyConfigId.make(id), String.view(&url), move authentication, move bypass, 65536) {
      Result.Success {value} => move value
      Result.Failure {error} => match move error {
        ProxyError.Admission {error: admission} => match admission.reason {
          ProxyReason.UnsupportedProxyTransport => {
            fail HttpError.make(HttpErrorKind.InvalidUrl, "HTTPS proxies are not supported; use an http:// proxy URL.")
          }
          _ => { fail badProxy() }
        }
        _ => { fail badProxy() }
      }
    }
  }

  // Whether `host` matches an entry of a NO_PROXY list.
  fn bypassed(list: &[u8], host: &[u8]) -> bool {
    let mut name = host
    if name.length >= 2 && name[usize.ZERO] == 91 && name[name.length - usize.ONE] == 93 {
      name = Slice.view<u8>(host, usize.ONE, host.length - 2)
    }
    let mut start = usize.ZERO
    while start <= list.length {
      let mut end = start
      while end < list.length && list[end] != 44 { end = end + usize.ONE }
      if entryMatches(Slice.view<u8>(list, start, end - start), name) { return true }
      start = end + usize.ONE
    }
    return false
  }

  fn entryMatches(raw: &[u8], host: &[u8]) -> bool {
    let mut start = usize.ZERO
    let mut end = raw.length
    while start < end && isSpace(raw[start]) { start = start + usize.ONE }
    while end > start && isSpace(raw[end - usize.ONE]) { end = end - usize.ONE }
    if end - start == usize.ONE && raw[start] == 42 { return true }
    if start < end && raw[start] == 42 { start = start + usize.ONE }
    if start < end && raw[start] == 46 { start = start + usize.ONE }
    if start < end && raw[start] == 91 {
      // An IPv6 literal such as `[::1]:8080`.
      start = start + usize.ONE
      let mut close = start
      while close < end && raw[close] != 93 { close = close + usize.ONE }
      end = close
    } else {
      let mut colons = usize.ZERO
      let mut last = end
      let mut index = start
      while index < end {
        if raw[index] == 58 {
          colons = colons + usize.ONE
          last = index
        }
        index = index + usize.ONE
      }
      if colons == usize.ONE { end = last }
    }
    let length = end - start
    if length == usize.ZERO || length > host.length { return false }
    let offset = host.length - length
    if offset > usize.ZERO && host[offset - usize.ONE] != 46 { return false }
    let mut index = usize.ZERO
    while index < length {
      if lowered(raw[start + index]) != lowered(host[offset + index]) { return false }
      index = index + usize.ONE
    }
    return true
  }

  // Runs one exchange of `request` on a direct connection and reads the whole response.
  // The same exchange as exchangeKept runs, over a connection from withProxyRoute.
  struct RouteBody<'b> {
    request: PreparedRequest,
    body: &'b [u8],
    deadline: Instant,
    maxBody: usize,
  }

  impl<'b> RouteBody<'b> {
    effect<'call> fn handle<'configuration, 'call, 'transport: 'call, 'provider: 'transport, 'tunnel: 'provider>(
      handler: Self,
      route: Route<'configuration>,
      connection: &'call mut Connection<RouteTransport<'transport, 'provider, 'tunnel, NativeRouteProvider>>,
    ) -> Received
    ! HttpError | ExchangeError | OutOfMemoryError
    ? &mut Allocator | &mut MonotonicClock | &mut Random {
      drop route
      let RouteBody<'b> {request, body, deadline, maxBody} = move handler
      let options = RequestOptions {deadline: Option<Instant>.some(move deadline), continuePolicy: ContinuePolicy.Disabled}
      let callback = effect fn(exchange: &mut Live<RouteTransport<'transport, 'provider, 'tunnel, NativeRouteProvider>>) -> Received
      ! HttpError | ExchangeError | OutOfMemoryError
      ? &mut Allocator | &mut MonotonicClock | &mut Random {
        return run exchangeBody(&mut exchange.*, body, maxBody)
      }
      return run Exchange.withExchange(&mut connection.*, &request, move options, move callback)
    }
  }

  impl<'configuration, 'b> RouteHandler<
    'configuration,
    NativeRouteProvider,
    Received,
    HttpError | ExchangeError | OutOfMemoryError
    ? &mut Allocator | &mut MonotonicClock | &mut Random
  > for RouteBody<'b> {
    handle: RouteBody.handle
  }

  effect fn exchangeBody<P>(exchange: &mut Live<'_, P>, payload: &[u8], maxBody: usize) -> Received
  ! HttpError | ExchangeError | OutOfMemoryError
  ? &mut Allocator | &mut MonotonicClock | &mut Random
  where
    &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random {
    run Exchange.send(&mut exchange.*)
    let mut offset = usize.ZERO
    while offset < payload.length {
      let progress = run Exchange.writeSome(&mut exchange.*, Slice.view<u8>(payload, offset, payload.length - offset))
      offset = offset + progress.consumed
    }
    let entries: [Header<'static>; 0] = []
    let trailers = match move Headers.make(&entries, Limits.defaults().head.values) {
      Result.Success {value} => move value
      Result.Failure {..} => { fail invalid("Could not prepare the request trailers.") }
    }
    run Exchange.finishRequest(&mut exchange.*, &trailers)
    let status = run Exchange.receiveFinal(&mut exchange.*)
    let live = run Live.head(&exchange.*)
    let head = match move run live.copy(Limits.defaults().head.values) {
      Result.Success {value} => move value
      Result.Failure {error} => {
        fail HttpError.caused(HttpErrorKind.Protocol, "The response head exceeds the header limits.", HttpCause.Value {error: move error})
      }
    }
    let mut location = Option<String>.none()
    if isRedirect(status) {
      location = run redirectLocation(&head)
    }
    // A body with a fixed length is read straight into storage of that size, and a response with
    // no body reads nothing. Bigger bodies use the loop below, which grows the storage as bytes
    // arrive.
    let framing = exchange.responseFraming()
    if let Option.Some {value: Framing.Empty} = framing {
      run Exchange.finishResponse(&mut exchange.*)
      return Received {
        parts: run Box<ReceivedParts>.make(ReceivedParts {status: status, head: move head, body: Bytes.make(), location: move location}),
      }
    }
    if let Option.Some {value: Framing.Fixed {length}} = framing {
      let declared = u64.toUsize(length)
      if length <= usize.toU64(maxBody) && length <= u64.toU64(1048576) {
        let mut sized = run Bytes.zeroed(declared)
        let mut filled = usize.ZERO
        while filled < declared {
          let space = Bytes.asMutSlice(&mut sized)
          let count = run Exchange.readSome(&mut exchange.*, Slice.viewMut<u8>(move space, filled, declared - filled))
          if count == usize.ZERO { break }
          filled = filled + count
        }
        Bytes.truncate(&mut sized, filled)
        run Exchange.finishResponse(&mut exchange.*)
        return Received {
          parts: run Box<ReceivedParts>.make(ReceivedParts {status: status, head: move head, body: move sized, location: move location}),
        }
      }
    }
    let mut body = Bytes.make()
    let mut scratch = run Bytes.zeroed(16384)
    while true {
      let count = run Exchange.readSome(&mut exchange.*, Bytes.asMutSlice(&mut scratch))
      if count == usize.ZERO { break }
      if count > maxBody - Bytes.length(&body) {
        fail HttpError {
          kind: HttpErrorKind.TooLarge,
          message: "The response body exceeds the configured limit.",
          status: Option<u16>.some(status),
          cause: HttpCause.None,
        }
      }
      run Bytes.append(&mut body, Slice.view<u8>(Bytes.asSlice(&scratch), usize.ZERO, count))
    }
    run Exchange.finishResponse(&mut exchange.*)
    return Received {
      parts: run Box<ReceivedParts>.make(ReceivedParts {status: status, head: move head, body: move body, location: move location}),
    }
  }

  // A redirect without a `Location` field has nowhere to go, so it is returned as the response
  // (RFC 9110 section 15.4).
  effect fn redirectLocation(head: &OwnedResponseHead) -> Option<String> ! HttpError | OutOfMemoryError ? &mut Allocator {
    let view = head.view()
    let mut fields = view.headers().iter()
    let mut selected = Option<&[u8]>.none()
    while true {
      let next = fields.next()
      match move next {
        Option.None => { break }
        Option.Some {value} => {
          if sameName(Header.name(&value), "location") {
            if let Option.Some {..} = &selected {
              fail redirectFailure("The redirect has more than one Location header.")
            }
            selected = Option<&[u8]>.some(Header.value(&value))
          }
        }
      }
    }
    let bytes = match move selected {
      Option.Some {value} => value
      Option.None => { return Option<String>.none() }
    }
    if bytes.length == usize.ZERO || bytes.length > 8192 {
      fail redirectFailure("The redirect Location must contain 1 to 8192 bytes.")
    }
    return match move run String.copyUtf8(bytes) {
      Result.Success {value} => Option<String>.some(move value)
      Result.Failure {..} => { fail redirectFailure("The redirect Location is not UTF-8.") }
    }
  }

  effect fn attempt<'config: 'r, 'r>(
    client: &mut NativeHttp<'config>,
    method: Method<'static>,
    url: string,
    request: &Request<'r>,
    bearer: &'r [u8],
    withBody: bool,
    credentials: bool,
    settings: &Settings,
    defer: bool,
  ) -> Attempted
  ! HttpError | ProxyError | RequestError | ExchangeError | NativeExchangeError | ResolverError | NativeSocketError | ConnectionError | IdentityError | TrustSourceError | OutOfMemoryError
  ? &mut Allocator {
    let uri = match move Uri.parse(url) {
      Result.Success {value} => move value
      Result.Failure {error} => {
        fail HttpError.caused(HttpErrorKind.InvalidUrl, "The URL is not a valid absolute URI.", HttpCause.Uri {error: move error})
      }
    }
    let origin = match move Origin.fromUri(&uri) {
      Result.Success {value} => move value
      Result.Failure {..} => {
        fail HttpError.make(HttpErrorKind.InvalidUrl, "The URL must be http or https with a host and no credentials.")
      }
    }
    if request.overflowed() {
      fail invalid("The request has more path segments, query parameters, or headers than it can hold.")
    }
    let limits = limitsFor(settings.maxBody)
    let values = limits.head.values
    let mut policy = HeaderPolicy<'r>.defaults()
    // A client holds at most MAX_DEFAULT_HEADERS defaults and a request at most MAX_HEADERS fields,
    // and the client adds at most two, so the fields fit in a fixed array.
    let blank = blankHeader<'r>()
    let mut fields: [Header<'r>; 50] = [blank; 50]
    let mut count = usize.ZERO
    let mut hasEncoding = false
    let mut hasContentType = false
    let requested = request.headers()
    let mut index = usize.ZERO
    // Provider defaults first; a request header with the same name replaces the default. Each
    // default is copied out of the client on its own, so the request never copies the whole table.
    let defaultCount = client.headerCount
    while index < defaultCount + requested.length {
      let mut field = Field<'r> {name: "", value: ""}
      let mut use = true
      if index < defaultCount {
        let stored: Field<'config> = client.headerValues[index]
        field = Field<'r> {name: stored.name, value: stored.value}
        let mut other = usize.ZERO
        while other < requested.length {
          if sameName(requested[other].name, field.name) { use = false }
          other = other + usize.ONE
        }
      } else {
        field = requested[index - defaultCount]
      }
      if use {
        if sameName(field.name, "accept-encoding") { hasEncoding = true }
        if sameName(field.name, "content-type") { hasContentType = true }
        let bytes = String.utf8Bytes(field.value)
        match slotFor(field.name, credentials) {
          Slot.UserAgent => { policy.userAgent = HeaderControl<'r>.Value {value: bytes} }
          Slot.Accept => { policy.accept = HeaderControl<'r>.Value {value: bytes} }
          Slot.Host => { policy.host = HeaderControl<'r>.Value {value: bytes} }
          Slot.Authorization => { policy.authorization = Authorization<'r>.Value {value: bytes} }
          Slot.Skip => {}
          Slot.Plain => run appendHeader<'r>(&mut fields, &mut count, field.name, bytes, values)
        }
      }
      index = index + usize.ONE
    }
    if credentials && bearer.length > usize.ZERO {
      policy.authorization = Authorization<'r>.Value {value: bearer}
    }
    if !hasEncoding {
      unsafe { fields[count] = Header<'r>.makeUnchecked("Accept-Encoding", b"identity") }
      count = count + usize.ONE
    }
    let mut payloadLength = usize.ZERO
    let mut body = BodyMode.Empty
    if withBody {
      payloadLength = request.bodyBytes().length
      body = BodyMode.KnownLength {length: usize.toU64(payloadLength)}
      if !hasContentType {
        if let Option.Some {value: contentType} = move request.contentType() {
          run appendHeader<'r>(&mut fields, &mut count, "Content-Type", String.utf8Bytes(contentType), values)
        }
      }
    }
    let headers = match move Headers.make(Slice.view<Header<'r>>(&fields, usize.ZERO, count), values) {
      Result.Success {value} => move value
      Result.Failure {error} => {
        fail HttpError.caused(HttpErrorKind.InvalidRequest, "The request headers exceed the header limits.", HttpCause.Value {error: move error})
      }
    }
    run ensureTrust(&mut client.*)
    let secure = Origin.secure(&origin)
    let host = match uri.host() {
      Option.Some {value} => String.utf8Bytes(value)
      Option.None => b""
    }
    let mut configured = &client.plainProxy
    if secure { configured = &client.secureProxy }
    let mut route = Option<Route>.none()
    if let Option.Some {value: proxy} = &configured.* {
      if !bypassed(Bytes.asSlice(&client.noProxy), host) {
        route = Option<Route>.some(selectRoute(&proxy, origin))
      }
    }
    // A plain HTTP origin behind a proxy sends the full URI to the proxy; a tunnel sends the usual
    // request through it.
    let prepared = match &route {
      Option.Some {value: through} => match Route.mode(&through) {
        RouteMode.Forward => run Prepare.prepareForward(&through, &uri, Version.Http11, method, &headers, &policy, body, false, values, limits.head.maxHeadBytes, 8192)
        _ => run Prepare.fromUriAt(&origin, &uri, Version.Http11, method, &headers, &policy, body, false, values, limits.head.maxHeadBytes, 8192)
      }
      Option.None => run Prepare.fromUriAt(&origin, &uri, Version.Http11, method, &headers, &policy, body, false, values, limits.head.maxHeadBytes, 8192)
    }
    let nanoseconds = settings.timeoutSeconds * u64.toU64(1000000000)
    let now = run MonotonicClock.now() |> Effect.provideMut<MonotonicClock>(&mut client.clock)
    let deadline = MonotonicClock.deadlineAfter(&now, nanoseconds)
    let options = requestOptions(nanoseconds)
    let payload = Slice.view<u8>(request.bodyBytes(), usize.ZERO, payloadLength)
    let taken = Intrinsic.replace(client.trust, Option<CachedTrust>.none())
    let mut trust = match move taken {
      Option.Some {value} => move value
      Option.None => { fail HttpError.make(HttpErrorKind.Tls, "The trust source is not configured.") }
    }
    let mut wall = OsSystemClock.make()
    if let Option.Some {value: through} = move route {
      let routed = RouteBody {request: move prepared, body: payload, deadline: move deadline, maxBody: settings.maxBody}
      let result = run Effect.result(viaProxy(through, move options, limits, &mut trust, move routed)
        |> Effect.provideMut<SystemClock>(&mut wall)
        |> Effect.provideMut<MonotonicClock>(&mut client.clock)
        |> Effect.provideMut<Random>(&mut client.random))
      client.trust = Option<CachedTrust>.some(move trust)
      return match move result {
        Result.Success {value} => Attempted.Done {received: move value}
        Result.Failure {error} => { fail move error }
      }
    }
    if defer {
      client.trust = Option<CachedTrust>.some(move trust)
      drop deadline
      drop options
      // The calls come first, so the request moves straight into the job instead of through a
      // temporary that a failed call would have to drop.
      let copied = run Bytes.copy(payload)
      let idempotent = method.idempotent()
      return Attempted.Deferred {job: run Box<PendingJob>.make(PendingJob {
        request: move prepared,
        body: move copied,
        timeoutNanoseconds: nanoseconds,
        maxBody: settings.maxBody,
        idempotent: idempotent,
      })}
    }
    // An idempotent request skips the check that the server has not closed the connection:
    // `exchangeKept` sends it again on a new connection if it did, which saves a system call on
    // every reused request.
    let mut slot = Option<usize>.none()
    let mut found = usize.MAX
    let pool = List<Box<IdleConnection>>.asSlice(&client.idle)
    let mut scan = usize.ZERO
    while scan < pool.length {
      if Origin.equals(&Box<IdleConnection>.get(&pool[scan])[usize.ZERO].origin, &origin) { found = scan }
      scan = scan + usize.ONE
    }
    if found != usize.MAX {
      if method.idempotent() || linkReusable(&Box<IdleConnection>.get(&pool[found])[usize.ZERO].link) {
        slot = Option<usize>.some(found)
      } else {
        run discard(&mut client.idle, found)
      }
    }
    let exchange = Direct {request: &prepared, body: payload, deadline: &deadline, maxBody: settings.maxBody, idempotent: method.idempotent()}
    let mut job = JobTrust.Own {source: move trust}
    let outcome = run Effect.result(exchangeKept(&mut client.idle, slot, &origin, &options, &limits, exchange, &mut job)
      |> Effect.provideMut<SystemClock>(&mut wall)
      |> Effect.provideMut<MonotonicClock>(&mut client.clock)
      |> Effect.provideMut<Random>(&mut client.random))
    if let JobTrust.Own {source} = move job {
      client.trust = Option<CachedTrust>.some(move source)
    }
    return match move outcome {
      Result.Success {value} => Attempted.Done {received: move value}
      Result.Failure {error} => { fail move error }
    }
  }

  // The result of one hop: the response, or a direct request that a task of `sendAll` sends.
  union Attempted {
    Done {received: Received},
    Deferred {job: Box<PendingJob>},
  }

  // One request on a direct connection, borrowed so that it can be sent again.
  struct Direct<'r> {
    request: &'r PreparedRequest,
    body: &'r [u8],
    deadline: &'r Instant,
    maxBody: usize,
    idempotent: bool,
  }

  impl<'r> Copy for Direct<'r> {}

  // Sends one request on the idle connection at `slot`, or on a new connection when it is none.
  // When a reused connection fails because the server closed it, an idempotent request goes once
  // more on a new connection, since the server may have closed it while idle. The connection stays
  // in `idle` while it runs, so it is not copied on each request. A connection that can run another
  // exchange afterwards stays there; any other is closed. A new connection to an origin past
  // `MAX_IDLE` replaces the oldest one.
  // Opens a connection to `origin` and adds it to the idle list, and returns its index. A
  // connection is about 16 KB by value; keeping it out of `exchangeKept` keeps that out of the frame
  // every request carves.
  @inlineNever
  // `endpoints` are addresses of the host of `origin` that a worker of `sendAll` resolved before,
  // or empty, and then the connection resolves the host.
  effect fn connectIdle(idle: &mut List<Box<IdleConnection>>, origin: &Origin, endpoints: &List<Endpoint>, options: &Options, limits: &Limits) -> usize
  ! NativeExchangeError | ExchangeError | ResolverError | NativeSocketError | ConnectionError | IdentityError | TrustSourceError | OutOfMemoryError
  ? &mut Allocator | &mut MonotonicClock | &mut SystemClock | &mut Random | &mut TrustSource {
    let mut trust = Option<TrustSnapshot>.none()
    if Origin.secure(origin) {
      trust = Option<TrustSnapshot>.some(run TrustSource.load(options.trust))
    }
    let connection = if List<Endpoint>.length(&endpoints.*) == usize.ZERO {
      run ExchangeNative.acquireNegotiatedOwned(origin.*, copyOptions(options), limits.*, move trust, Option<Instant>.none())
    } else {
      run ExchangeNative.acquireResolvedNegotiatedOwned(origin.*, List<Endpoint>.asSlice(&endpoints.*), copyOptions(options), limits.*, move trust, Option<Instant>.none())
    }
    let made = run Effect.result(linkOf(move connection))
    let link = match move made {
      Result.Success {value} => move value
      Result.Failure {error} => match move error {
        // Only invalid limits fail here, and the defaults are valid.
        ProtocolError failure => {
          drop failure
          fail ExchangeError.InvalidLimits
        }
        OutOfMemoryError failure => { fail move failure }
      }
    }
    if List<Box<IdleConnection>>.length(&idle.*) >= MAX_IDLE {
      run discard(&mut idle.*, usize.ZERO)
    }
    let boxed = run Box<IdleConnection>.make(IdleConnection {origin: origin.*, link: move link})
    run List<Box<IdleConnection>>.append(&mut idle.*, move boxed)
    return List<Box<IdleConnection>>.length(&idle.*) - usize.ONE
  }

  effect fn exchangeKept(
    idle: &mut List<Box<IdleConnection>>,
    slot: Option<usize>,
    origin: &Origin,
    options: &Options,
    limits: &Limits,
    exchange: Direct<'_>,
    trust: &mut JobTrust,
  ) -> Received
  ! HttpError | ExchangeError | NativeExchangeError | ResolverError | NativeSocketError | ConnectionError | IdentityError | TrustSourceError | OutOfMemoryError
  ? &mut Allocator | &mut MonotonicClock | &mut SystemClock | &mut Random {
    if let Option.Some {value: index} = slot {
      if isHttp2(&idle.*, index) {
        let tried = run Effect.result(exchangeHttp2(&mut idle.*, index, exchange))
        match move tried {
          Result.Success {value} => match move value {
            Option.Some {value: received} => {
              run settle(&mut idle.*, index)
              return move received
            }
            Option.None => {
              run discard(&mut idle.*, index)
              if !exchange.idempotent { fail unanswered() }
            }
          }
          Result.Failure {error} => {
            run discard(&mut idle.*, index)
            fail move error
          }
        }
      } else {
        // The exchange runs straight on the kept connection, without a helper frame between.
        let callback = effect fn(live: &mut Live<NativeTransport>) -> Received
        ! HttpError | ExchangeError | OutOfMemoryError
        ? &mut Allocator | &mut MonotonicClock | &mut Random {
          return run exchangeBody(&mut live.*, exchange.body, exchange.maxBody)
        }
        let attempt = run Effect.result(Exchange.withExchange(connectionAt(&mut idle.*, index), exchange.request, exchangeOptions(exchange.deadline), move callback))
        match move attempt {
          Result.Success {value: received} => {
            run settle(&mut idle.*, index)
            return move received
          }
          Result.Failure {error} => {
            run discard(&mut idle.*, index)
            match move error {
              ExchangeError failure => {
                if !exchange.idempotent || !closedByPeer(&failure) { fail move failure }
              }
              HttpError failure => { fail move failure }
              OutOfMemoryError failure => { fail move failure }
            }
          }
        }
      }
    }
    // Only a new connection loads trust, so the trust source wraps the connect alone and not the
    // exchange on a kept connection.
    let unresolved = List<Endpoint>.make()
    let index = run connectIdle(&mut idle.*, origin, &unresolved, options, limits) |> Effect.provideMut<TrustSource>(&mut trust.*)
    if isHttp2(&idle.*, index) {
      let fresh = run Effect.result(exchangeHttp2(&mut idle.*, index, exchange))
      match move fresh {
        Result.Success {value} => match move value {
          Option.Some {value: received} => {
            run settle(&mut idle.*, index)
            return move received
          }
          Option.None => {
            run discard(&mut idle.*, index)
            fail unanswered()
          }
        }
        Result.Failure {error} => {
          run discard(&mut idle.*, index)
          fail move error
        }
      }
    }
    // The exchange runs straight on the kept connection, without a helper frame between.
    let callback = effect fn(live: &mut Live<NativeTransport>) -> Received
    ! HttpError | ExchangeError | OutOfMemoryError
    ? &mut Allocator | &mut MonotonicClock | &mut Random {
      return run exchangeBody(&mut live.*, exchange.body, exchange.maxBody)
    }
    let result = run Effect.result(Exchange.withExchange(connectionAt(&mut idle.*, index), exchange.request, exchangeOptions(exchange.deadline), move callback))
    return match move result {
      Result.Success {value} => {
        run settle(&mut idle.*, index)
        return move value
      }
      Result.Failure {error} => {
        run discard(&mut idle.*, index)
        fail move error
      }
    }
  }

  // A copy of `options`. Only a new connection needs its own, so the request path passes a borrow.
  fn copyOptions(options: &Options) -> Options {
    let deadline = match &options.deadline {
      Option.None => Option<Instant>.none()
      Option.Some {value} => Option<Instant>.some(SystemClock.make(SystemClock.seconds(&value), SystemClock.nanoseconds(&value)))
    }
    return Options {
      maximumAddresses: options.maximumAddresses,
      family: options.family,
      noDelay: options.noDelay,
      maximumAttempts: options.maximumAttempts,
      deadline: move deadline,
      handshakeNanoseconds: options.handshakeNanoseconds,
      tls: options.tls,
      tlsVersions: options.tlsVersions,
      trust: options.trust,
      alpn: options.alpn,
    }
  }

  // The connection at `index` in `idle`.
  fn connectionAt(idle: &mut List<Box<IdleConnection>>, index: usize) -> &mut Connection<NativeTransport> {
    let kept = List<Box<IdleConnection>>.asMutSlice(&mut idle.*)
    let entry = &mut Box<IdleConnection>.getMut(&mut kept[index])[usize.ZERO]
    return match &mut entry.link {
      Link.Http1 {connection} => &mut connection
      // Callers check `isHttp2` first.
      Link.Http2 {..} => Intrinsic.trap("connectionAt: an HTTP/2 connection")
    }
  }

  // The options of an exchange that must end by `deadline`.
  fn exchangeOptions(deadline: &Instant) -> RequestOptions {
    let until = SystemClock.make(SystemClock.seconds(deadline), SystemClock.nanoseconds(deadline))
    return RequestOptions {deadline: Option<Instant>.some(move until), continuePolicy: ContinuePolicy.Disabled}
  }

  // Keeps the connection at `index` for the next request when it can run another exchange, and
  // closes it otherwise.
  effect fn settle(idle: &mut List<Box<IdleConnection>>, index: usize) -> () {
    let kept = List<Box<IdleConnection>>.asSlice(&idle.*)
    let entry = &Box<IdleConnection>.get(&kept[index])[usize.ZERO]
    let eligible = match &entry.link {
      Link.Http1 {connection} => match Exchange.reuseEligibility<NativeTransport>(&connection) {
        ReuseEligibility.Eligible => true
        _ => false
      }
      Link.Http2 {..} => linkReusable(&entry.link)
    }
    if !eligible {
      run discard(&mut idle.*, index)
    }
    return ()
  }

  // Closes the connection at `index` and removes it from `idle`.
  effect fn discard(idle: &mut List<Box<IdleConnection>>, index: usize) -> () {
    let mut removed = List<Box<IdleConnection>>.remove(&mut idle.*, index)
    run closeLink(&mut Box<IdleConnection>.getMut(&mut removed)[usize.ZERO].link)
    drop removed
    return ()
  }

  // Whether the exchange failed because the peer closed or reset the connection before the
  // response head arrived.
  fn closedByPeer(error: &ExchangeError) -> bool {
    return match & error.* {
      ExchangeError.Transport {..} => true
      ExchangeError.Output {..} => true
      ExchangeError.TruncatedHead => true
      _ => false
    }
  }

  // Sends one request through the proxy route. A tunnel to an https origin checks its certificate
  // with a snapshot of the client's trust bundle.
  effect fn viaProxy<'configuration, 'b>(
    route: Route<'configuration>,
    options: Options,
    limits: Limits,
    trust: &mut CachedTrust,
    handler: RouteBody<'b>,
  ) -> Received
  ! HttpError | ProxyError | ExchangeError | NativeExchangeError | ResolverError | NativeSocketError | ConnectionError | IdentityError | TrustSourceError | OutOfMemoryError
  ? &mut Allocator | &mut MonotonicClock | &mut SystemClock | &mut Random {
    let mut snapshot = Option<TrustSnapshot>.none()
    if Origin.secure(&Route.originalOrigin(&route)) {
      snapshot = Option<TrustSnapshot>.some(run TrustSource.load(options.trust) |> Effect.provideMut<TrustSource>(&mut trust.*))
    }
    return run ExchangeNative.withProxyRoute(route, move options, limits, move snapshot, move handler)
  }

  // A direct request that a task of `sendAll` sends. It owns all its data, so that the task does
  // not borrow from the caller.
  struct PendingJob {
    request: PreparedRequest,
    body: Bytes,
    timeoutNanoseconds: u64,
    maxBody: usize,
    idempotent: bool,
  }

  // A job with the idle connection it reuses, if one was open to its origin. Jobs, connections,
  // and outcomes are boxed, so that each step of a task moves a pointer and not the whole value.
  struct Job {
    pending: Box<PendingJob>,
    connection: Option<Box<IdleConnection>>,
  }

  // A job's result as it travels back through a round. A failure is boxed, so the slots and lists
  // of a round hold a pointer and not a whole error on every request.
  union Outcome {
    Done {received: Received},
    Failed {error: Box<HttpError>},
    Exhausted,
  }

  effect fn outcomeOf(result: Result<Received, HttpError | OutOfMemoryError>) -> Outcome ? &mut Allocator {
    return match move result {
      Result.Success {value} => Outcome.Done {received: move value}
      Result.Failure {error} => match move error {
        OutOfMemoryError _exhausted => Outcome.Exhausted
        HttpError failure => match move run Effect.result(Box<HttpError>.make(move failure)) {
          Result.Success {value} => Outcome.Failed {error: move value}
          Result.Failure {..} => Outcome.Exhausted
        }
      }
    }
  }

  // One request of `sendAll` and where it is.
  union Progress {
    // It needs another hop.
    Going {hop: Hop},
    // It has finished.
    Finished {result: Result<Response, HttpError>},
    // Its result was taken out at the end of `sendAll`.
    Taken,
  }

  // Sends `requests` and returns their results in the same order. The direct requests run on at
  // most `concurrencyValue` worker tasks of one local scheduler, which live for the whole batch: the
  // root task prepares the next hop of each request while the workers send the ones before it, and
  // proxied requests run one by one in the root task. A redirect goes back to the root task.
  effect fn sendConcurrent(client: &mut NativeHttp<'_>, requests: List<Request<'_>>) -> List<Result<Response, HttpError>>
  ! OutOfMemoryError
  ? &mut Allocator {
    let all = List<Request>.asSlice(&requests)
    let mut progress = List<Progress>.make()
    run List<Progress>.reserveExact(&mut progress, all.length)
    let mut going = usize.ZERO
    let mut index = usize.ZERO
    while index < all.length {
      let begun = run Effect.result(begin(&client.*, &all[index]))
      let next = match move begun {
        Result.Success {value} => {
          going = going + usize.ONE
          Progress.Going {hop: move value}
        }
        Result.Failure {error} => match move error {
          HttpError failure => Progress.Finished {result: Result<Response, HttpError>.failResult(move failure)}
          OutOfMemoryError exhausted => { fail move exhausted }
        }
      }
      run List<Progress>.append(&mut progress, move next)
      index = index + usize.ONE
    }
    if going > usize.ZERO {
      run sendBatch(&mut client.*, all, &mut progress, going)
    }
    drop all
    // Take each result out in request order, leaving `Taken` behind.
    let mut ordered = List<Result<Response, HttpError>>.make()
    run List<Result<Response, HttpError>>.reserveExact(&mut ordered, List<Progress>.length(&progress))
    let done = List<Progress>.asMutSlice(&mut progress)
    index = usize.ZERO
    while index < done.length {
      match Intrinsic.replace(done[index], Progress.Taken) {
        Progress.Finished {result} => run List<Result<Response, HttpError>>.append(&mut ordered, move result)
        _ => Intrinsic.trap("sendAll: a request did not finish")
      }
      index = index + usize.ONE
    }
    drop done
    return move ordered
  }

  // What one step of a request did.
  union Stepped {
    // A proxied hop redirected; the request needs another hop.
    Again,
    // The request has its final response.
    Final {response: Response},
    // The hop is a direct request for this round.
    Queued {job: Box<PendingJob>},
  }

  effect fn stepHop(client: &mut NativeHttp<'_>, request: &Request<'_>, hop: &mut Hop) -> Stepped
  ! HttpError | OutOfMemoryError
  ? &mut Allocator {
    let attempted = run Effect.result(attemptHop(&mut client.*, request, &hop.*, true))
    let received = match move attempted {
      Result.Success {value} => match move value {
        Attempted.Deferred {job} => { return Stepped.Queued {job: move job} }
        Attempted.Done {received} => move received
      }
      Result.Failure {error} => match move error {
        HttpError failure => { fail move failure }
        OutOfMemoryError exhausted => { fail move exhausted }
        ProxyError failure => run classify(move failure)
        RequestError failure => run classify(move failure)
        ExchangeError failure => run classify(move failure)
        NativeExchangeError failure => run classify(move failure)
        ResolverError failure => run classify(move failure)
        NativeSocketError failure => run classify(move failure)
        ConnectionError failure => run classify(move failure)
        IdentityError failure => run classify(move failure)
        TrustSourceError failure => run classify(move failure)
      }
    }
    return match move run advance(client.failOnStatusValue, &mut hop.*, move received) {
      Option.Some {value} => Stepped.Final {response: move value}
      Option.None => Stepped.Again
    }
  }

  // The client, the requests, and their progress, which the root task of `sendBatch` reaches. They
  // live in the frame of `sendBatch`, which waits in `LocalScheduler.execute` until the root task
  // and every worker task have finished, so they outlive every task. The root program of a
  // scheduler must be `'static`, so the borrows travel as addresses
  // (https://github.com/silk-lang/silk/issues/2961).
  struct BatchView {
    client: *mut u8,
    requests: ?[*]const u8,
    count: usize,
    progress: *mut u8,
  }

  fn viewOf<'c, 'r>(client: &mut NativeHttp<'c>, all: &[Request<'r>], progress: &mut List<Progress>) -> BatchView {
    let clientAt = Pointer.fromMutRef<NativeHttp<'c>>(&mut client.*)
    let requestsAt = Pointer.fromSlice<Request<'r>>(all)
    let progressAt = Pointer.fromMutRef<List<Progress>>(&mut progress.*)
    let erasedClient = unsafe Intrinsic.pointerReinterpret<*mut NativeHttp<'c>, *mut u8>(clientAt)
    let erasedRequests = unsafe Intrinsic.pointerReinterpret<?[*]const Request<'r>, ?[*]const u8>(requestsAt)
    let erasedProgress = unsafe Intrinsic.pointerReinterpret<*mut List<Progress>, *mut u8>(progressAt)
    return BatchView {client: erasedClient, requests: erasedRequests, count: all.length, progress: erasedProgress}
  }

  // Sends the unfinished requests of `progress`, `going` of them, on worker tasks of one local
  // scheduler that waits on the client's clock. The client's idle connections go to the tasks and
  // come back after.
  effect fn sendBatch(client: &mut NativeHttp<'_>, all: &[Request<'_>], progress: &mut List<Progress>, going: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
    // Every job comes from this client, so the workers share its trust source, and the first
    // secure job makes it from the plan when the client has none yet.
    let plan = run trustPlan(&client.*)
    let idle = Intrinsic.replace(client.idle, List<Box<IdleConnection>>.make())
    let trust = Intrinsic.replace(client.trust, Option<CachedTrust>.none())
    let mut workers = client.concurrencyValue
    if going < workers { workers = going }
    if workers == usize.ZERO { workers = usize.ONE }
    let view = viewOf(&mut client.*, all, &mut progress.*)
    // The root task reaches the client through `view`, so the scheduler waits on a clock of its
    // own rather than on `client.clock`.
    let mut clock = OsMonotonicClock.make()
    let mut scheduler = LocalScheduler.make()
    let outcome = run Effect.result(scheduler.execute<Batch, OutOfMemoryError | TaskIdExhaustedError | Cancelled>(
      runBatch(move view, move idle, move trust, workers, move plan),
    ) |> Effect.provideMut<MonotonicClock>(&mut clock))
    let batch = match move outcome {
      Result.Success {value} => move value
      Result.Failure {error} => match move error {
        OutOfMemoryError exhausted => { fail move exhausted }
        TaskIdExhaustedError _exhausted => Intrinsic.trap("sendAll: the scheduler ran out of task identities")
        Cancelled _cancelled => Intrinsic.trap("sendAll: a request task was cancelled")
        StalledError _stalled => Intrinsic.trap("sendAll: the request tasks stalled")
      }
    }
    let Batch {idle: kept, trust: made} = move batch
    let previous = Intrinsic.replace(client.idle, move kept)
    drop previous
    client.trust = move made
    while List<Box<IdleConnection>>.length(&client.idle) > MAX_IDLE {
      run discard(&mut client.idle, usize.ZERO)
    }
    return ()
  }

  // What the root task of a batch gives back: the connections that stayed open and the client's
  // trust source.
  struct Batch {
    idle: List<Box<IdleConnection>>,
    trust: Option<CachedTrust>,
  }

  // The state that the worker tasks of a batch share on its thread.
  struct BatchState {
    // The open connections that no worker holds. Its capacity has room for `MAX_IDLE`, and a
    // worker that gives one back past that closes the oldest, so adding one never allocates.
    pool: List<Box<IdleConnection>>,
    // The client's trust source, which every worker loads from. A load takes it out and puts it
    // back without suspending.
    trust: Option<CachedTrust>,
    // The endpoints of each origin that a worker resolved in this batch, so that the batch looks
    // up each host once rather than once for each new connection. The system lookup blocks the
    // thread, so each one stalls every worker.
    resolved: List<ResolvedOrigin>,
  }

  // A job for a worker, and the request it belongs to.
  struct Indexed {
    index: usize,
    pending: Box<PendingJob>,
  }

  // A job's result on its way back to the root task.
  struct Settled {
    worker: usize,
    index: usize,
    outcome: Outcome,
  }

  union Checkout {
    Fresh,
    Reuse {connection: Box<IdleConnection>},
    Close {connection: Box<IdleConnection>},
  }

  effect fn runBatch(view: BatchView, idle: List<Box<IdleConnection>>, trust: Option<CachedTrust>, workers: usize, plan: TrustPlan) -> Batch
  ! OutOfMemoryError | TaskIdExhaustedError | Cancelled
  ? &mut Scheduler | &mut MonotonicClock {
    let mut allocator = Allocator.systemAllocatorProvider()
    return run driveBatch(move view, move idle, move trust, workers, &plan) |> Effect.provideMut<Allocator>(&mut allocator)
  }

  // The root task of a batch. It steps each request to its next direct job and gives it to a
  // worker without one, and takes each result back as it arrives. A worker gives its connection back when its job ends, so a later job to the
  // same origin reuses it.
  effect fn driveBatch(view: BatchView, idle: List<Box<IdleConnection>>, trust: Option<CachedTrust>, workers: usize, plan: &TrustPlan) -> Batch
  ! OutOfMemoryError | TaskIdExhaustedError | Cancelled
  ? &mut Scheduler | &mut MonotonicClock | &mut Allocator {
    let BatchView {client: clientAddress, requests: requestsAddress, count, progress: progressAddress} = move view
    let mut clientAnchor: u8 = 0
    let requestsAnchor: u8 = 0
    let mut progressAnchor: u8 = 0
    // `sendBatch` made these addresses from live borrows that outlive this task (see `BatchView`).
    let clientAt = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut NativeHttp<'static>>(clientAddress)
    let client = unsafe Pointer.borrowMut<u8, NativeHttp<'static>>(&mut clientAnchor, clientAt)
    let requestsMany = unsafe Intrinsic.pointerReinterpret<?[*]const u8, ?[*]const Request<'static>>(requestsAddress)
    let requestsAt = unsafe Intrinsic.pointerRequalify<?[*]const Request<'static>, [*]const Request<'static>>(requestsMany)
    let all = unsafe Pointer.borrowMany<u8, Request<'static>>(&requestsAnchor, requestsAt, count)
    let progressAt = unsafe Intrinsic.pointerReinterpret<*mut u8, *mut List<Progress>>(progressAddress)
    let progress = unsafe Pointer.borrowMut<u8, List<Progress>>(&mut progressAnchor, progressAt)
    let failOnStatus = client.failOnStatusValue
    // The requests to step next, in order; a redirected one goes to the end.
    let mut ready = List<usize>.make()
    let states = List<Progress>.asSlice(&progress.*)
    run List<usize>.reserveExact(&mut ready, states.length)
    let mut index = usize.ZERO
    while index < states.length {
      if let Progress.Going {..} = &states[index] {
        let _added = List<usize>.appendWithinCapacity(&mut ready, index)
      }
      index = index + usize.ONE
    }
    drop states
    // Each worker has a queue of its own, which holds its next job, and the root task gives a job
    // only to a worker without one. A worker that finishes waits for the root task to step the
    // next request, but each prepared request goes out while it is still in the cache: at 64
    // workers, two jobs for each cost about 13% more time for each request. A queue of its own
    // wakes only that worker, where one shared queue wakes every waiting worker for each job.
    let results = run Channel<Settled>.make(workers)
    let Channel<Settled> {sender: done, receiver: settled} = move results
    let mut pool = move idle
    let open = List<Box<IdleConnection>>.length(&pool)
    if open < MAX_IDLE {
      run List<Box<IdleConnection>>.reserveExact(&mut pool, MAX_IDLE - open)
    }
    let state = run Shared<BatchState>.make(BatchState {pool: move pool, trust: move trust, resolved: List<ResolvedOrigin>.make()})
    let mut queues = List<Sender<Indexed>>.make()
    run List<Sender<Indexed>>.reserveExact(&mut queues, workers)
    // The workers without a job.
    let mut free = List<usize>.make()
    run List<usize>.reserveExact(&mut free, workers)
    let mut running = List<Fiber<(), never>>.make()
    run List<Fiber<(), never>>.reserveExact(&mut running, workers)
    while List<Fiber<(), never>>.length(&running) < workers {
      let worker = List<Fiber<(), never>>.length(&running)
      let channel = run Channel<Indexed>.make(usize.ONE)
      let Channel<Indexed> {sender, receiver} = move channel
      let _queued = List<Sender<Indexed>>.appendWithinCapacity(&mut queues, move sender)
      let _free = List<usize>.appendWithinCapacity(&mut free, workers - usize.ONE - worker)
      let copied = run copyPlan(plan)
      let back = run done.clone()
      let fiber = run Fiber<(), never>.forkChild(batchWorker(Shared<BatchState>.clone(&state), move receiver, move back, worker, move copied))
      let _added = List<Fiber<(), never>>.appendWithinCapacity(&mut running, move fiber)
    }
    drop done
    let mut head = usize.ZERO
    let mut inflight = usize.ZERO
    while true {
      while head < List<usize>.length(&ready) && List<usize>.length(&free) > usize.ZERO {
        let at = List<usize>.asSlice(&ready)[head]
        head = head + usize.ONE
        let idle = List<usize>.asSlice(&free)
        let worker = idle[idle.length - usize.ONE]
        drop idle
        if run stepRequest(&mut client.*, &all[at], List<Progress>.asMutSlice(&mut progress.*), &mut ready, &List<Sender<Indexed>>.asSlice(&queues)[worker], at) {
          let _taken = List<usize>.pop(&mut free)
          inflight = inflight + usize.ONE
        }
      }
      if inflight == usize.ZERO { break }
      let first = match run settled.receive() {
        Option.Some {value} => move value
        Option.None => Intrinsic.trap("sendAll: the request tasks stopped before their jobs ended")
      }
      inflight = inflight - usize.ONE
      let _freed = List<usize>.appendWithinCapacity(&mut free, first.worker)
      run absorb(failOnStatus, List<Progress>.asMutSlice(&mut progress.*), &mut ready, move first)
      while true {
        match settled.tryReceive() {
          TryReceive.Received {value} => {
            inflight = inflight - usize.ONE
            let _freed = List<usize>.appendWithinCapacity(&mut free, value.worker)
            run absorb(failOnStatus, List<Progress>.asMutSlice(&mut progress.*), &mut ready, move value)
          }
          _ => { break }
        }
      }
    }
    // Dropping its queue ends each worker once it finds no job.
    drop queues
    while true {
      match List<Fiber<(), never>>.pop(&mut running) {
        Option.None => { break }
        Option.Some {value} => run value.join()
      }
    }
    drop settled
    return Shared<BatchState>.withMut<Batch>(&state, finishBatch)
  }

  // Steps the request at `index` once, and queues its job on `jobs`, a worker's empty queue.
  // Returns whether it queued a job.
  effect fn stepRequest(client: &mut NativeHttp<'_>, request: &Request<'_>, states: &mut [Progress], ready: &mut List<usize>, jobs: &Sender<Indexed>, index: usize) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
    let mut finished = Option<Result<Response, HttpError>>.none()
    let mut queued = false
    if let Progress.Going {hop} = &mut states[index] {
      let attempted = run Effect.result(stepHop(&mut client.*, request, &mut hop))
      match move attempted {
        Result.Success {value} => match move value {
          Stepped.Again => run List<usize>.append(&mut ready.*, index)
          Stepped.Final {response} => { finished = Option<Result<Response, HttpError>>.some(Result<Response, HttpError>.succeed(move response)) }
          Stepped.Queued {job} => {
            match jobs.trySend(Indexed {index: index, pending: move job}) {
              TrySend.Sent => {}
              _ => Intrinsic.trap("sendAll: the job queue had no room")
            }
            queued = true
          }
        }
        Result.Failure {error} => match move error {
          HttpError failure => { finished = Option<Result<Response, HttpError>>.some(Result<Response, HttpError>.failResult(move failure)) }
          OutOfMemoryError exhausted => { fail move exhausted }
        }
      }
    }
    if let Option.Some {value} = move finished {
      states[index] = Progress.Finished {result: move value}
    }
    return queued
  }

  // Takes the result of a job: the request finishes, or goes back to `ready` for its next hop.
  effect fn absorb(failOnStatus: bool, states: &mut [Progress], ready: &mut List<usize>, settled: Settled) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
    let Settled {worker: _worker, index, outcome} = move settled
    let mut finished = Option<Result<Response, HttpError>>.none()
    if let Progress.Going {hop} = &mut states[index] {
      let advanced = match move outcome {
        Outcome.Done {received} => run Effect.result(advance(failOnStatus, &mut hop, move received))
        Outcome.Failed {error} => Result<Option<Response>, HttpError | OutOfMemoryError>.failResult(Box<HttpError>.into(move error))
        Outcome.Exhausted => { fail OutOfMemoryError {} }
      }
      match move advanced {
        Result.Success {value} => match move value {
          Option.Some {value: response} => { finished = Option<Result<Response, HttpError>>.some(Result<Response, HttpError>.succeed(move response)) }
          Option.None => run List<usize>.append(&mut ready.*, index)
        }
        Result.Failure {error} => match move error {
          HttpError failure => { finished = Option<Result<Response, HttpError>>.some(Result<Response, HttpError>.failResult(move failure)) }
          OutOfMemoryError exhausted => { fail move exhausted }
        }
      }
    }
    if let Option.Some {value} = move finished {
      states[index] = Progress.Finished {result: move value}
    }
    return ()
  }

  // One worker task of a batch. Its clock parks only this task while the socket waits.
  effect fn batchWorker(state: Shared<BatchState>, jobs: Receiver<Indexed>, done: Sender<Settled>, worker: usize, plan: TrustPlan) -> () ? &mut Scheduler | &mut MonotonicClock {
    // The services that do not depend on the request are given once for all the jobs of this
    // task, so a request does not pay for a provider layer of each.
    let mut allocator = Allocator.systemAllocatorProvider()
    let mut wall = OsSystemClock.make()
    let mut random = OsRandom.make()
    return run workBatch(move state, &jobs, &done, worker, &plan)
      |> Effect.provideMut<Allocator>(&mut allocator)
      |> Effect.provideMut<SystemClock>(&mut wall)
      |> Effect.provideMut<Random>(&mut random)
  }

  effect fn workBatch(state: Shared<BatchState>, jobs: &Receiver<Indexed>, done: &Sender<Settled>, worker: usize, plan: &TrustPlan) -> ()
  ? &mut Allocator | &mut MonotonicClock | &mut SystemClock | &mut Random {
    // A job holds its connection in this list while it runs, and the list keeps its memory for the
    // next job.
    let mut idle = List<Box<IdleConnection>>.make()
    // Every job comes from one client, so the workers share its trust source.
    let mut trust = JobTrust.Batch {state: Shared<BatchState>.clone(&state)}
    while true {
      let Indexed {index, pending} = match run jobs.receive() {
        Option.None => { break }
        Option.Some {value} => move value
      }
      let mut connection = Option<Box<IdleConnection>>.none()
      match Shared<BatchState>.withMut<Checkout>(&state, checkOut(&Box<PendingJob>.get(&pending)[usize.ZERO])) {
        Checkout.Fresh => {}
        Checkout.Reuse {connection: open} => { connection = Option<Box<IdleConnection>>.some(move open) }
        Checkout.Close {connection: stale} => run closeIdle(move stale)
      }
      // `idle` is empty here, and holds at most the connection of this job after the exchange.
      let outcome = run outcomeOf(run jobExchange(&mut idle, &mut trust, plan, Job {pending: move pending, connection: move connection}))
      if let Option.Some {value} = List<Box<IdleConnection>>.pop(&mut idle) {
        if let Option.Some {value: evicted} = Shared<BatchState>.withMut<Option<Box<IdleConnection>>>(&state, giveBack(move value)) {
          run closeIdle(move evicted)
        }
      }
      // The root task takes every result before it closes the queue, so the send succeeds.
      let sent = run done.send(Settled {worker: worker, index: index, outcome: move outcome})
      drop sent
    }
    drop trust
    return ()
  }

  fn takeSource(state: &mut BatchState) -> Option<CachedTrust> {
    return Intrinsic.replace(state.trust, Option<CachedTrust>.none())
  }

  fn putSource(state: &mut BatchState, source: CachedTrust) -> () {
    state.trust = Option<CachedTrust>.some(move source)
  }

  // An origin and its endpoints.
  struct ResolvedOrigin {
    origin: Origin,
    endpoints: ResolvedEndpoints,
  }

  // Takes the endpoints of `origin` out of the batch state, if a worker resolved it.
  fn takeEndpoints(state: &mut BatchState, origin: Origin) -> Option<ResolvedEndpoints> {
    let kept = List<ResolvedOrigin>.asSlice(&state.resolved)
    let mut index = usize.ZERO
    while index < kept.length {
      if Origin.equals(&kept[index].origin, &origin) {
        drop kept
        let ResolvedOrigin {origin: _found, endpoints} = List<ResolvedOrigin>.remove(&mut state.resolved, index)
        return Option<ResolvedEndpoints>.some(move endpoints)
      }
      index = index + usize.ONE
    }
    return Option<ResolvedEndpoints>.none()
  }

  // Keeps the endpoints of `origin` for the later workers of the batch.
  effect fn keepEndpoints(state: &Shared<BatchState>, origin: Origin, endpoints: ResolvedEndpoints) -> () ! OutOfMemoryError ? &mut Allocator {
    // The append needs the allocator, so the list is reserved first and the move into it does not
    // allocate.
    let reserved = Shared<BatchState>.withMut<bool>(&state.*, hasRoomForEndpoints)
    if !reserved {
      let mut grown = Shared<BatchState>.withMut<List<ResolvedOrigin>>(&state.*, takeResolved)
      run List<ResolvedOrigin>.reserve(&mut grown, usize.ONE)
      Shared<BatchState>.withMut<()>(&state.*, putResolved(move grown))
    }
    Shared<BatchState>.withMut<()>(&state.*, addEndpoints(ResolvedOrigin {origin: origin, endpoints: move endpoints}))
  }

  fn hasRoomForEndpoints(state: &mut BatchState) -> bool {
    return List<ResolvedOrigin>.length(&state.resolved) < List<ResolvedOrigin>.capacity(&state.resolved)
  }

  fn takeResolved(state: &mut BatchState) -> List<ResolvedOrigin> {
    return Intrinsic.replace(state.resolved, List<ResolvedOrigin>.make())
  }

  fn putResolved(state: &mut BatchState, resolved: List<ResolvedOrigin>) -> () {
    state.resolved = move resolved
  }

  fn addEndpoints(state: &mut BatchState, entry: ResolvedOrigin) -> () {
    let _added = List<ResolvedOrigin>.appendWithinCapacity(&mut state.resolved, move entry)
  }

  // Resolves the host of `origin` as `ExchangeNative.acquireOwned` does.
  effect fn resolveOrigin(origin: &Origin, options: &Options) -> ResolvedEndpoints ! ResolverError | OutOfMemoryError ? &mut Allocator | &mut MonotonicClock {
    let request = match move ResolveRequest.make(Origin.host(origin), Origin.port(origin), options.family, options.maximumAddresses, Option<Instant>.none()) {
      Result.Success {value} => move value
      Result.Failure {error} => { fail move error }
    }
    let mut resolver = NativeSystemResolver.make()
    return run Resolver.resolve(&request) |> Effect.provideMut<Resolver>(&mut resolver)
  }

  effect fn copyEndpoints(endpoints: &ResolvedEndpoints) -> List<Endpoint> ! OutOfMemoryError ? &mut Allocator {
    let values = ResolvedEndpoints.asSlice(endpoints)
    let mut copied = run List<Endpoint>.makeWithCapacity(values.length)
    let mut index = usize.ZERO
    while index < values.length {
      let _added = List<Endpoint>.appendWithinCapacity(&mut copied, values[index])
      index = index + usize.ONE
    }
    return move copied
  }

  fn hasSource(state: &BatchState) -> bool {
    if let Option.Some {..} = &state.trust { return true }
    return false
  }

  fn checkOut(state: &mut BatchState, job: &PendingJob) -> Checkout {
    return pick(&mut state.pool, job)
  }

  // Puts `connection` in the pool, and returns the oldest one when the pool already holds
  // `MAX_IDLE`, for the caller to close.
  fn giveBack(state: &mut BatchState, connection: Box<IdleConnection>) -> Option<Box<IdleConnection>> {
    let mut evicted = Option<Box<IdleConnection>>.none()
    if List<Box<IdleConnection>>.length(&state.pool) >= MAX_IDLE {
      evicted = Option<Box<IdleConnection>>.some(List<Box<IdleConnection>>.remove(&mut state.pool, usize.ZERO))
    }
    let _added = List<Box<IdleConnection>>.appendWithinCapacity(&mut state.pool, move connection)
    return move evicted
  }

  fn finishBatch(state: &mut BatchState) -> Batch {
    return Batch {
      idle: Intrinsic.replace(state.pool, List<Box<IdleConnection>>.make()),
      trust: Intrinsic.replace(state.trust, Option<CachedTrust>.none()),
    }
  }

  // Takes the newest idle connection to the origin of `job` out of `pool`. A request that is not
  // idempotent uses it only when the server has not closed it; otherwise the caller closes it.
  fn pick(pool: &mut List<Box<IdleConnection>>, job: &PendingJob) -> Checkout {
    let kept = List<Box<IdleConnection>>.asSlice(&pool.*)
    let origin = job.request.origin()
    // The newest connection is last, so the scan runs from the end and stops at the first match.
    let mut found = usize.MAX
    let mut scan = kept.length
    while scan > usize.ZERO {
      scan = scan - usize.ONE
      if Origin.equals(&Box<IdleConnection>.get(&kept[scan])[usize.ZERO].origin, &origin) {
        found = scan
        break
      }
    }
    if found == usize.MAX { return Checkout.Fresh }
    let usable = job.idempotent || linkReusable(&Box<IdleConnection>.get(&kept[found])[usize.ZERO].link)
    drop kept
    let taken = List<Box<IdleConnection>>.remove(&mut pool.*, found)
    if !usable { return Checkout.Close {connection: move taken} }
    return Checkout.Reuse {connection: move taken}
  }

  effect fn closeIdle(stale: Box<IdleConnection>) -> () ? &mut MonotonicClock {
    let mut closing = move stale
    run closeLink(&mut Box<IdleConnection>.getMut(&mut closing)[usize.ZERO].link)
  }

  // Where a request loads trust: the client's source, which a request on the calling task holds,
  // or the batch state that holds it for the workers of `sendAll`.
  union JobTrust {
    Own {source: CachedTrust},
    Batch {state: Shared<BatchState>},
  }

  impl JobTrust {
    effect fn loadFor(self: &mut Self, limits: TrustLoadLimits) -> TrustSnapshot
    ! TrustSourceError | OutOfMemoryError ? &mut Allocator {
      return match &mut self.* {
        JobTrust.Own {source} => run CachedTrust.loadCached(&mut source, limits)
        JobTrust.Batch {state} => {
          // `setUpJob` made the source, and a load does not suspend, so no other worker finds the
          // state without it.
          let mut source = match Shared<BatchState>.withMut<Option<CachedTrust>>(&state, takeSource) {
            Option.None => Intrinsic.trap("sendAll: a request loaded trust before its source was made")
            Option.Some {value} => move value
          }
          let loaded = run Effect.result(CachedTrust.loadCached(&mut source, limits))
          Shared<BatchState>.withMut<()>(&state, putSource(move source))
          return match move loaded {
            Result.Success {value} => move value
            Result.Failure {error} => match move error {
              TrustSourceError failure => { fail move failure }
              OutOfMemoryError exhausted => { fail move exhausted }
            }
          }
        }
      }
    }
  }

  impl TrustSource for JobTrust { load: JobTrust.loadFor }

  struct JobSetup {
    pending: Box<PendingJob>,
    slot: Option<usize>,
  }

  // Puts the kept connection of a job in `idle`, and makes the trust source of a secure origin
  // unless `trust` already holds one.
  effect fn setUpJob(idle: &mut List<Box<IdleConnection>>, trust: &mut JobTrust, plan: &TrustPlan, job: Job) -> JobSetup
  ! HttpError | OutOfMemoryError
  ? &mut Allocator {
    let Job {pending, connection} = move job
    let mut slot = Option<usize>.none()
    if let Option.Some {value} = move connection {
      run List<Box<IdleConnection>>.append(&mut idle.*, move value)
      slot = Option<usize>.some(usize.ZERO)
    }
    // A plain HTTP origin never loads trust, so it does not make a trust source.
    let secure = Origin.secure(&Box<PendingJob>.get(&pending)[usize.ZERO].request.origin())
    if secure {
      if let JobTrust.Batch {state} = &trust.* {
        if !Shared<BatchState>.with<bool>(&state, hasSource) {
          let made = CachedTrust.of(run trustOf(plan))
          Shared<BatchState>.withMut<()>(&state, putSource(move made))
        }
      }
    }
    return JobSetup {pending: move pending, slot: slot}
  }

  // A failure is returned rather than raised, so that the job does not wrap this in a result.
  effect fn jobExchange(idle: &mut List<Box<IdleConnection>>, trust: &mut JobTrust, plan: &TrustPlan, job: Job) -> Result<Received, HttpError | OutOfMemoryError>
  ? &mut Allocator | &mut MonotonicClock | &mut SystemClock | &mut Random {
    let JobSetup {pending, slot} = match move run Effect.result(setUpJob(&mut idle.*, &mut trust.*, plan, move job)) {
      Result.Success {value} => move value
      Result.Failure {error} => { return Result<Received, HttpError | OutOfMemoryError>.failResult(move error) }
    }
    let job = &Box<PendingJob>.get(&pending)[usize.ZERO]
    let now = run MonotonicClock.now()
    let deadline = MonotonicClock.deadlineAfter(&now, job.timeoutNanoseconds)
    let exchange = Direct {request: &job.request, body: Bytes.asSlice(&job.body), deadline: &deadline, maxBody: job.maxBody, idempotent: job.idempotent}
    // This is `exchangeKept` written out for a job, which returns its failure: the exchange runs
    // in this frame, without a result and the frame of `exchangeKept` around it.
    if let Option.Some {value: index} = slot {
      if isHttp2(&idle.*, index) {
        let tried = run Effect.result(exchangeHttp2(&mut idle.*, index, exchange))
        match move tried {
          Result.Success {value} => match move value {
            Option.Some {value: received} => {
              run settle(&mut idle.*, index)
              return Result<Received, HttpError | OutOfMemoryError>.succeed(move received)
            }
            Option.None => {
              run discard(&mut idle.*, index)
              if !exchange.idempotent { return Result<Received, HttpError | OutOfMemoryError>.failResult(unanswered()) }
            }
          }
          Result.Failure {error} => {
            run discard(&mut idle.*, index)
            return Result<Received, HttpError | OutOfMemoryError>.failResult(move error)
          }
        }
      } else {
        let callback = effect fn(live: &mut Live<NativeTransport>) -> Received
        ! HttpError | ExchangeError | OutOfMemoryError
        ? &mut Allocator | &mut MonotonicClock | &mut Random {
          return run exchangeBody(&mut live.*, exchange.body, exchange.maxBody)
        }
        let attempt = run Effect.result(Exchange.withExchange(connectionAt(&mut idle.*, index), exchange.request, exchangeOptions(exchange.deadline), move callback))
        match move attempt {
          Result.Success {value: received} => {
            run settle(&mut idle.*, index)
            return Result<Received, HttpError | OutOfMemoryError>.succeed(move received)
          }
          Result.Failure {error} => {
            run discard(&mut idle.*, index)
            match move error {
              ExchangeError failure => {
                // An idempotent request whose kept connection the server closed goes again on a
                // new connection.
                if !exchange.idempotent || !closedByPeer(&failure) {
                  return Result<Received, HttpError | OutOfMemoryError>.failResult(httpErrorOf(move failure))
                }
              }
              HttpError failure => { return Result<Received, HttpError | OutOfMemoryError>.failResult(move failure) }
              OutOfMemoryError failure => { return Result<Received, HttpError | OutOfMemoryError>.failResult(move failure) }
            }
          }
        }
      }
    }
    // The options and limits follow from the request, so a job does not carry them, and the request
    // is for the job's origin. Only a new connection needs them, so a request on a kept connection
    // does not write them into its frame.
    let connected = run Effect.result(connectNew(&mut idle.*, &mut trust.*, job))
    let index = match move connected {
      Result.Success {value} => value
      Result.Failure {error} => {
        let failure: HttpError | OutOfMemoryError = match move error {
          OutOfMemoryError exhausted => move exhausted
          ExchangeError failure => httpErrorOf(move failure)
          NativeExchangeError failure => httpErrorOf(move failure)
          ResolverError failure => httpErrorOf(move failure)
          NativeSocketError failure => httpErrorOf(move failure)
          ConnectionError failure => httpErrorOf(move failure)
          IdentityError failure => httpErrorOf(move failure)
          TrustSourceError failure => httpErrorOf(move failure)
        }
        return Result<Received, HttpError | OutOfMemoryError>.failResult(move failure)
      }
    }
    if isHttp2(&idle.*, index) {
      let fresh = run Effect.result(exchangeHttp2(&mut idle.*, index, exchange))
      return match move fresh {
        Result.Success {value} => match move value {
          Option.Some {value: received} => {
            run settle(&mut idle.*, index)
            Result<Received, HttpError | OutOfMemoryError>.succeed(move received)
          }
          Option.None => {
            run discard(&mut idle.*, index)
            Result<Received, HttpError | OutOfMemoryError>.failResult(unanswered())
          }
        }
        Result.Failure {error} => {
          run discard(&mut idle.*, index)
          Result<Received, HttpError | OutOfMemoryError>.failResult(move error)
        }
      }
    }
    let callback = effect fn(live: &mut Live<NativeTransport>) -> Received
    ! HttpError | ExchangeError | OutOfMemoryError
    ? &mut Allocator | &mut MonotonicClock | &mut Random {
      return run exchangeBody(&mut live.*, exchange.body, exchange.maxBody)
    }
    let result = run Effect.result(Exchange.withExchange(connectionAt(&mut idle.*, index), exchange.request, exchangeOptions(exchange.deadline), move callback))
    return match move result {
      Result.Success {value} => {
        run settle(&mut idle.*, index)
        return Result<Received, HttpError | OutOfMemoryError>.succeed(move value)
      }
      Result.Failure {error} => {
        run discard(&mut idle.*, index)
        let failure: HttpError | OutOfMemoryError = match move error {
          HttpError failure => move failure
          OutOfMemoryError exhausted => move exhausted
          ExchangeError failure => httpErrorOf(move failure)
        }
        return Result<Received, HttpError | OutOfMemoryError>.failResult(move failure)
      }
    }
  }

  effect fn connectNew(idle: &mut List<Box<IdleConnection>>, trust: &mut JobTrust, job: &PendingJob) -> usize
  ! NativeExchangeError | ExchangeError | ResolverError | NativeSocketError | ConnectionError | IdentityError | TrustSourceError | OutOfMemoryError
  ? &mut Allocator | &mut MonotonicClock | &mut SystemClock | &mut Random {
    let options = requestOptions(job.timeoutNanoseconds)
    let limits = limitsFor(job.maxBody)
    let origin = job.request.origin()
    let mut endpoints = List<Endpoint>.make()
    if let JobTrust.Batch {state} = &trust.* {
      let shared = Shared<BatchState>.clone(&state)
      endpoints = run batchEndpoints(&shared, &origin, &options)
    }
    return run connectIdle(&mut idle.*, &origin, &endpoints, &options, &limits) |> Effect.provideMut<TrustSource>(&mut trust.*)
  }

  // The endpoints of `origin` for a new connection of a batch: the ones an earlier worker
  // resolved, or a new lookup, which the later workers then use.
  effect fn batchEndpoints(state: &Shared<BatchState>, origin: &Origin, options: &Options) -> List<Endpoint>
  ! ResolverError | OutOfMemoryError
  ? &mut Allocator | &mut MonotonicClock {
    let cached = Shared<BatchState>.withMut<Option<ResolvedEndpoints>>(&state.*, takeEndpoints(origin.*))
    let endpoints = match move cached {
      Option.Some {value} => move value
      Option.None => run resolveOrigin(origin, options)
    }
    let copied = run copyEndpoints(&endpoints)
    run keepEndpoints(&state.*, origin.*, move endpoints)
    return move copied
  }

  enum Slot {
    UserAgent,
    Accept,
    Host,
    Authorization,
    Skip,
    Plain,
  }

  fn slotFor(name: string, credentials: bool) -> Slot {
    if sameName(name, "user-agent") { return Slot.UserAgent }
    if sameName(name, "accept") { return Slot.Accept }
    if sameName(name, "host") { return Slot.Host }
    if sameName(name, "authorization") {
      if credentials { return Slot.Authorization }
      return Slot.Skip
    }
    if sameName(name, "cookie") && !credentials { return Slot.Skip }
    return Slot.Plain
  }

  // A field that only fills unused storage; it is never sent.
  fn blankHeader<'r>() -> Header<'r> {
    unsafe { return Header<'r>.makeUnchecked("", b"") }
  }

  // `fields` holds every field a request can have: a client keeps at most MAX_DEFAULT_HEADERS
  // defaults, a request at most MAX_HEADERS fields, and the client adds at most two.
  effect fn appendHeader<'r>(fields: &mut [Header<'r>; 50], count: &mut usize, name: string<'r>, value: &'r [u8], values: HeaderLimits) -> ()
  ! HttpError {
    let header = match move Header.make(name, value, values) {
      Result.Success {value: made} => move made
      Result.Failure {error} => {
        fail HttpError.caused(HttpErrorKind.InvalidRequest, "A request header name or value is invalid.", HttpCause.Value {error: move error})
      }
    }
    fields[count.*] = header
    count.* = count.* + usize.ONE
  }

  // The state of one request while it follows redirects.
  struct Hop {
    settings: Settings,
    bearer: Bytes,
    current: String,
    method: Method<'static>,
    withBody: bool,
    credentials: bool,
    hops: usize,
  }

  effect fn begin(client: &NativeHttp<'_>, request: &Request<'_>) -> Hop ! HttpError | OutOfMemoryError ? &mut Allocator {
    let settings = Settings {
      timeoutSeconds: Option<u64>.unwrapOr(request.timeout(), client.timeoutValue),
      maxBody: Option<usize>.unwrapOr(request.maxBody(), client.maxBodyValue),
      redirects: Option<usize>.unwrapOr(request.redirects(), client.redirectValue),
    }
    if client.overflowValue {
      fail invalid("The client has more default headers than it can hold.")
    }
    let mut bearer = Bytes.make()
    if let Option.Some {value: token} = move request.bearerToken() {
      run Bytes.append(&mut bearer, b"Bearer ")
      run Bytes.append(&mut bearer, String.utf8Bytes(token))
    }
    let current = run request.resolveUrl(client.baseValue)
    return Hop {
      settings: move settings,
      bearer: move bearer,
      current: move current,
      method: request.method(),
      withBody: request.hasBody(),
      credentials: true,
      hops: usize.ZERO,
    }
  }

  // Sends the current hop of `request`. With `defer`, a direct request is returned as a job.
  effect fn attemptHop(client: &mut NativeHttp<'_>, request: &Request<'_>, hop: &Hop, defer: bool) -> Attempted
  ! HttpError | ProxyError | RequestError | ExchangeError | NativeExchangeError | ResolverError | NativeSocketError | ConnectionError | IdentityError | TrustSourceError | OutOfMemoryError
  ? &mut Allocator {
    return run attempt(&mut client.*, hop.method, String.view(&hop.current), request, Bytes.asSlice(&hop.bearer), hop.withBody, hop.credentials, &hop.settings, defer)
  }

  // Takes the response of the current hop. It returns the final response, or none after it moved
  // `hop` to the redirect target.
  effect fn advance(failOnStatus: bool, hop: &mut Hop, received: Received) -> Option<Response>
  ! HttpError | OutOfMemoryError
  ? &mut Allocator {
    let Received {parts} = move received
    let ReceivedParts {status, head, body, location} = Box<ReceivedParts>.into(move parts)
    let target = match move location {
      Option.None => {
        let url = Intrinsic.replace(hop.current, String.make())
        return Option<Response>.some(run finish(failOnStatus, status, move head, move body, move url))
      }
      Option.Some {value} => move value
    }
    if hop.settings.redirects == usize.ZERO {
      drop target
      let url = Intrinsic.replace(hop.current, String.make())
      return Option<Response>.some(run finish(failOnStatus, status, move head, move body, move url))
    }
    drop head
    drop body
    if hop.hops == hop.settings.redirects { fail redirectFailure("The request exceeded its redirect limit.") }
    let next = run resolveRedirect(String.view(&hop.current), String.view(&target), &mut hop.credentials)
    if status == 303 && !Method.equals(&hop.method, &Method.head()) {
      hop.method = Method.get()
      hop.withBody = false
    }
    if (status == 301 || status == 302) && Method.equals(&hop.method, &Method.post()) {
      hop.method = Method.get()
      hop.withBody = false
    }
    hop.current = move next
    hop.hops = hop.hops + usize.ONE
    return Option<Response>.none()
  }

  effect fn follow(client: &mut NativeHttp<'_>, request: Request<'_>) -> Response
  ! HttpError | ProxyError | RequestError | ExchangeError | NativeExchangeError | ResolverError | NativeSocketError | ConnectionError | IdentityError | TrustSourceError | OutOfMemoryError
  ? &mut Allocator {
    let mut hop = run begin(&client.*, &request)
    while true {
      let received = match move run attemptHop(&mut client.*, &request, &hop, false) {
        Attempted.Done {received} => move received
        Attempted.Deferred {..} => { fail redirectFailure("The request was deferred outside sendAll.") }
      }
      if let Option.Some {value} = move run advance(client.failOnStatusValue, &mut hop, move received) {
        return move value
      }
    }
    fail redirectFailure("The redirect loop ended unexpectedly.")
  }

  effect fn finish(failOnStatus: bool, status: u16, head: OwnedResponseHead, body: Bytes, url: String) -> Response ! HttpError {
    let response = Response.fromParts(move head, move body, move url)
    if failOnStatus { return run response.expectOk() }
    return move response
  }

  effect fn resolveRedirect(current: string, location: string, credentials: &mut bool) -> String
  ! HttpError | OutOfMemoryError
  ? &mut Allocator {
    let base = match move Uri.parse(current) {
      Result.Success {value} => move value
      Result.Failure {..} => { fail redirectFailure("The redirect source URL is invalid.") }
    }
    let reference = match move UriReference.parse(location) {
      Result.Success {value} => move value
      Result.Failure {error} => {
        fail HttpError.caused(HttpErrorKind.Redirect, "The redirect Location is not a valid URI reference.", HttpCause.Uri {error: move error})
      }
    }
    let resolved = match move run Uri.resolveOwned(&base, &reference) {
      Result.Success {value} => move value
      Result.Failure {error} => {
        fail HttpError.caused(HttpErrorKind.Redirect, "The redirect Location does not resolve to a URL.", HttpCause.Uri {error: move error})
      }
    }
    let view = resolved.view()
    if let Option.Some {..} = move view.userinfo() {
      fail redirectFailure("The redirect Location contains credentials.")
    }
    let scheme = view.scheme()
    if !sameName(scheme, "http") && !sameName(scheme, "https") {
      fail redirectFailure("The redirect Location is not an http or https URL.")
    }
    if sameName(base.scheme(), "https") && sameName(scheme, "http") {
      fail redirectFailure("Refused a redirect from HTTPS to HTTP.")
    }
    let from = Origin.fromUri(&base)
    let to = Origin.fromUri(&view)
    let same = match & from {
      Result.Success {value: left} => match & to {
        Result.Success {value: right} => left.equals(&right)
        Result.Failure {..} => false
      }
      Result.Failure {..} => false
    }
    if !same { credentials.* = false }
    drop view
    return resolved.intoString()
  }

  /// Whether an exchange failure is the request deadline, at any transport layer.
  fn exchangeTimedOut(failure: &ExchangeError) -> bool {
    return match &failure.* {
      ExchangeError.Timeout => true
      ExchangeError.OutputTimeout {..} => true
      ExchangeError.Transport {error} => transportTimedOut(&error)
      ExchangeError.Output {error, progress: _} => transportTimedOut(&error)
      _ => false
    }
  }

  fn transportTimedOut(failure: &TransportError) -> bool {
    return match &failure.* {
      TransportError.Plain {error} => ioTimedOut(&error)
      TransportError.Secured {error} => match &error {
        ConnectionError.Io {error: io} => ioTimedOut(&io)
        ConnectionError.HandshakeTimeout => true
        _ => false
      }
    }
  }

  fn ioTimedOut(failure: &ByteIoError) -> bool {
    return match &failure.* {
      ByteIoError.Timeout {..} => true
      _ => false
    }
  }

  // The message names the most common reasons a handshake fails, so a program that prints only
  // `HttpError.message` still says what went wrong. The full error stays in `HttpCause.Tls`.
  fn tlsMessage(failure: &ConnectionError) -> string<'static> {
    return match &failure.* {
      ConnectionError.Tls {error} => match &error {
        TlsError.PeerAlert {code} => alertMessage(code)
        TlsError.ProtocolViolation {..} => "The server broke the TLS 1.3 protocol during the handshake."
        TlsError.CertificateDecode {..} => "The server certificate could not be decoded."
        TlsError.CertificatePath {error: path} => pathMessage(&path)
        TlsError.CertificateIdentity {error: identity} => match &identity {
          CertificateIdentityFailure.Match {..} => "The server certificate is not valid for this host name."
          _ => "The names in the server certificate could not be read."
        }
        TlsError.CertificateVerify {..} => "The server's TLS signature did not verify against its certificate key."
        TlsError.UnsupportedProfile => "The server chose a TLS cipher suite, key exchange group, or signature algorithm that is not supported."
        TlsError.HandshakeTruncated => "The server closed the connection during the TLS handshake."
        TlsError.LimitExceeded {..} => "The server's TLS handshake exceeds a configured limit."
        _ => "The TLS connection failed."
      }
      ConnectionError.Io {..} => "The connection failed during the TLS handshake."
      _ => "The TLS connection failed."
    }
  }

  fn alertMessage(code: u8) -> string<'static> {
    // protocol_version (70) is what a server without TLS 1.3 sends; handshake_failure (40) and
    // insufficient_security (71) mean no offered algorithm was acceptable.
    if code == 70 { return "The server does not support TLS 1.3." }
    if code == 40 || code == 71 {
      return "The server rejected the TLS handshake: it may not support TLS 1.3 or the offered algorithms."
    }
    if code == 112 { return "The server does not recognize the requested host name." }
    if code == 120 { return "The server requires an application protocol other than HTTP/1.1." }
    return "The server ended the TLS handshake with an alert."
  }

  fn pathMessage(failure: &ValidationError) -> string<'static> {
    let mut reason = failure.reason
    if reason == ValidationReason.NoValidPath {
      if let Option.Some {value} = &failure.detailReason { reason = value }
    }
    if reason == ValidationReason.InvalidTime { return "The server certificate has expired or is not yet valid." }
    if reason == ValidationReason.NoIssuer || reason == ValidationReason.IssuerMismatch {
      return "The server certificate is not signed by a trusted root."
    }
    if reason == ValidationReason.UnsupportedAlgorithm || reason == ValidationReason.UnsupportedParameters
      || reason == ValidationReason.InvalidKey {
      return "The server certificate uses a key or signature algorithm that is not supported."
    }
    if reason == ValidationReason.InvalidSignature { return "A signature in the server certificate chain is not valid." }
    if reason == ValidationReason.InvalidUsage { return "The server certificate is not allowed for TLS server authentication." }
    return "The server certificate chain is not valid."
  }

  effect fn classify(error: ProxyError | RequestError | ExchangeError | NativeExchangeError | ResolverError | NativeSocketError | ConnectionError | IdentityError | TrustSourceError) -> never ! HttpError {
    fail httpErrorOf(move error)
  }

  // The HTTP error of a failure from a lower layer.
  fn httpErrorOf(error: ProxyError | RequestError | ExchangeError | NativeExchangeError | ResolverError | NativeSocketError | ConnectionError | IdentityError | TrustSourceError) -> HttpError {
    return match move error {
      ProxyError failure => match move failure {
        ProxyError.ProxyAuthenticationRequired {response} => {
          return HttpError {
            kind: HttpErrorKind.Connect,
            message: "The proxy requires authentication; put the credentials in the proxy URL.",
            status: Option<u16>.some(statusOf(&response)),
            cause: HttpCause.None,
          }
        }
        ProxyError.ProxyRejected {response} => {
          return HttpError {
            kind: HttpErrorKind.Connect,
            message: "The proxy refused to open a tunnel to the server.",
            status: Option<u16>.some(statusOf(&response)),
            cause: HttpCause.None,
          }
        }
        _ => { return HttpError.make(HttpErrorKind.Connect, "The proxy answer is not valid.") }
      }
      RequestError failure => {
        return HttpError.caused(HttpErrorKind.InvalidRequest, "Could not prepare the request.", HttpCause.Request {error: move failure})
      }
      ExchangeError failure => {
        if exchangeTimedOut(&failure) {
          return HttpError.caused(HttpErrorKind.Timeout, "The request deadline passed.", HttpCause.Exchange {error: move failure})
        }
        return HttpError.caused(HttpErrorKind.Protocol, "The HTTP exchange failed.", HttpCause.Exchange {error: move failure})
      }
      NativeExchangeError failure => match move failure {
        NativeExchangeError.AlpnMismatch {error: connection} => {
          return HttpError.caused(HttpErrorKind.Tls, "The server did not agree to HTTP/1.1.", HttpCause.Tls {error: move connection})
        }
        _ => { return HttpError.make(HttpErrorKind.Connect, "Could not open the connection.") }
      }
      ResolverError failure => {
        return HttpError.caused(HttpErrorKind.Connect, "Could not resolve the host name.", HttpCause.Resolver {error: move failure})
      }
      NativeSocketError _failure => { return HttpError.make(HttpErrorKind.Connect, "Could not connect to the server.") }
      ConnectionError failure => match & failure {
        ConnectionError.HandshakeTimeout => {
          return HttpError.caused(HttpErrorKind.Timeout, "The TLS handshake did not finish before the deadline.", HttpCause.Tls {error: move failure})
        }
        _ => { return HttpError.caused(HttpErrorKind.Tls, tlsMessage(&failure), HttpCause.Tls {error: move failure}) }
      }
      IdentityError failure => {
        return HttpError.caused(HttpErrorKind.Tls, "The server name cannot be checked against its certificate.", HttpCause.Identity {error: move failure})
      }
      TrustSourceError failure => {
        return HttpError.caused(HttpErrorKind.Tls, "Could not load the trust source.", HttpCause.Trust {error: move failure})
      }
    }
  }

  impl<'config> Http for NativeHttp<'config> {
    effect fn sendAll(self: &mut Self, requests: List<Request<'_>>) -> List<Result<Response, HttpError>>
    ! OutOfMemoryError
    ? &mut Allocator {
      let mut noProxy = true
      if let Option.Some {..} = &self.secureProxy { noProxy = false }
      if let Option.Some {..} = &self.plainProxy { noProxy = false }
      if self.concurrencyValue > usize.ONE && List<Request>.length(&requests) > usize.ONE && noProxy {
        return run sendConcurrent(&mut self.*, move requests)
      }
      return run Http.sendEach(move requests) |> Effect.provideMut<Http>(&mut self.*)
    }
    effect fn send(self: &mut Self, request: Request<'_>) -> Response ! HttpError | OutOfMemoryError ? &mut Allocator {
      let outcome = run Effect.result(follow(&mut self.*, move request))
      return match move outcome {
        Result.Success {value} => move value
        Result.Failure {error} => match move error {
          HttpError failure => { fail move failure }
          OutOfMemoryError exhausted => { fail move exhausted }
          ProxyError failure => run classify(move failure)
          RequestError failure => run classify(move failure)
          ExchangeError failure => run classify(move failure)
          NativeExchangeError failure => run classify(move failure)
          ResolverError failure => run classify(move failure)
          NativeSocketError failure => run classify(move failure)
          ConnectionError failure => run classify(move failure)
          IdentityError failure => run classify(move failure)
          TrustSourceError failure => run classify(move failure)
        }
      }
    }
  }
}
