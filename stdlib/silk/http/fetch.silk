      redirect,
      content,
      pool,
      proxy,
      deadline,
      http,
      contentLimits,
      maxEncodedBodyBytes,
      maxDeliveredBodyBytes,
      maxOwnedMetadataBytes,
      maxBufferedBytes,
    } = move options
