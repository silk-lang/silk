  ProducerRequirements in Without<ProducerRequirements, ByteDuplex>,
  ProducerRequirements in Without<ProducerRequirements, HttpTransport>,
  SinkRequirements in Without<SinkRequirements, ByteDuplex>,
  SinkRequirements in Without<SinkRequirements, HttpTransport>,
  AcquisitionRequirements in Without<AcquisitionRequirements, ByteDuplex>,
  AcquisitionRequirements in Without<AcquisitionRequirements, HttpTransport> {
  run admit(&options)
  let operation = ReplayOperation<
    'fetch,
    'policy,
    RoutedP,
    DirectP,
    FetchResult,
    FactoryError,
    ProducerError,
    DestinationFailure<SinkError>,
    AcquisitionError,
    FactoryRequirements,
    ProducerRequirements,
    SinkRequirements,
    AcquisitionRequirements,
    Factory,
    Producer,
    SinkDestination<SinkError, SinkRequirements, S>,
    C,
  > {
    fetch: move fetch,
    factory: move factory,
    policyAnchor: [],
    options: move options,
    destination: SinkDestination<SinkError, SinkRequirements, S> {sink: move sink},
  }
  return run withSemanticRequest<RoutedP, DirectP>(move request, move operation)
}

/// Sends a request whose body comes from a new producer from `factory` for each attempt, and
/// returns the body of the final response in memory. More than `maxBodyBytes` fails, and no partial
/// body is returned.
pub effect<'env> fn collectReplay<
  'fetch,
  'uri,
  'method,
  'headers,
  'policy,
  RoutedP,
  DirectP,
  FactoryError,
  ProducerError,
  AcquisitionError,
  ?FactoryRequirements,
  ?ProducerRequirements,
  ?AcquisitionRequirements,
  Factory: ReplayFactory<Producer, FactoryError, FactoryRequirements> + 'env,
  Producer: BodyProducer<ProducerError ? ProducerRequirements>,
  C: FetchClient<
    'policy,
    RoutedP,
    DirectP,
    Redirect.AttemptStep<'policy, CollectedResponse>,
    RedirectError | FetchError | ValueError | BodyError | ProducerError | ExchangeError | OutOfMemoryError,
    AcquisitionError,
    ProducerRequirements | &mut Redirect.SelectedBody<ProducerError, ProducerRequirements> | &mut MonotonicClock | &mut Allocator | &mut Random,
    AcquisitionRequirements,
  >,
  'env,
>(
  fetch: &'fetch mut Fetch<C>,
  request: FetchRequest<'uri, 'method, 'headers, 'policy>,
  factory: Factory,
  options: FetchOptions,
  maxBodyBytes: usize,
) -> CollectedResponse
! RedirectError | FetchError | ValueError | BodyError | FactoryError | ProducerError | ExchangeError | OutOfMemoryError | AcquisitionError
? FactoryRequirements | ProducerRequirements | AcquisitionRequirements | &mut MonotonicClock | &mut Allocator | &mut Random
where
  &mut RoutedP provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut RoutedP provides &HttpTransport from &mut HttpTransport,
  &mut RoutedP provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut RoutedP provides &ByteDuplex from &mut ByteDuplex,
  &mut DirectP provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut DirectP provides &HttpTransport from &mut HttpTransport,
  FactoryRequirements in Without<FactoryRequirements, ByteDuplex>,
  FactoryRequirements in Without<FactoryRequirements, HttpTransport>,
  ProducerRequirements in Without<ProducerRequirements, ByteDuplex>,
  ProducerRequirements in Without<ProducerRequirements, HttpTransport>,
  AcquisitionRequirements in Without<AcquisitionRequirements, ByteDuplex>,
  AcquisitionRequirements in Without<AcquisitionRequirements, HttpTransport> {
  run admit(&options)
  let operation = ReplayOperation<
    'fetch,
    'policy,
    RoutedP,
    DirectP,
    CollectedResponse,
    FactoryError,
    ProducerError,
    FetchError | OutOfMemoryError,
    AcquisitionError,
    FactoryRequirements,
    ProducerRequirements,
    &mut Allocator,
    AcquisitionRequirements,
    Factory,
    Producer,
    CollectDestination,
    C,
  > {
    fetch: move fetch,
    factory: move factory,
    policyAnchor: [],
    options: move options,
    destination: CollectDestination {body: Bytes.make(), maximum: maxBodyBytes},
  }
  return run withSemanticRequest<RoutedP, DirectP>(move request, move operation)
}

/// Sends a request whose body comes from a new producer from `factory` for each attempt, and reads
/// and checks the body of the final response without keeping it. More than `maxDiscardBytes` fails.
pub effect<'env> fn discardReplay<
  'fetch,
  'uri,
  'method,
  'headers,
  'policy,
  RoutedP,
  DirectP,
  FactoryError,
  ProducerError,
  AcquisitionError,
  ?FactoryRequirements,
  ?ProducerRequirements,
  ?AcquisitionRequirements,
  Factory: ReplayFactory<Producer, FactoryError, FactoryRequirements> + 'env,
  Producer: BodyProducer<ProducerError ? ProducerRequirements>,
  C: FetchClient<
    'policy,
    RoutedP,
    DirectP,
    Redirect.AttemptStep<'policy, FetchResult>,
    RedirectError | FetchError | ValueError | BodyError | ProducerError | ExchangeError | OutOfMemoryError,
    AcquisitionError,
    ProducerRequirements | &mut Redirect.SelectedBody<ProducerError, ProducerRequirements> | &mut MonotonicClock | &mut Allocator | &mut Random,
    AcquisitionRequirements,
  >,
  'env,
>(
  fetch: &'fetch mut Fetch<C>,
  request: FetchRequest<'uri, 'method, 'headers, 'policy>,
  factory: Factory,
  options: FetchOptions,
  maxDiscardBytes: u64,
) -> FetchResult
! RedirectError | FetchError | ValueError | BodyError | FactoryError | ProducerError | ExchangeError | OutOfMemoryError | AcquisitionError
? FactoryRequirements | ProducerRequirements | AcquisitionRequirements | &mut MonotonicClock | &mut Allocator | &mut Random
where
  &mut RoutedP provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut RoutedP provides &HttpTransport from &mut HttpTransport,
  &mut RoutedP provides &ByteDuplex from &mut ByteDuplex | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut RoutedP provides &ByteDuplex from &mut ByteDuplex,
  &mut DirectP provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut DirectP provides &HttpTransport from &mut HttpTransport,
  FactoryRequirements in Without<FactoryRequirements, ByteDuplex>,
  FactoryRequirements in Without<FactoryRequirements, HttpTransport>,
  ProducerRequirements in Without<ProducerRequirements, ByteDuplex>,
  ProducerRequirements in Without<ProducerRequirements, HttpTransport>,
  AcquisitionRequirements in Without<AcquisitionRequirements, ByteDuplex>,
  AcquisitionRequirements in Without<AcquisitionRequirements, HttpTransport> {
  run admit(&options)
  let operation = ReplayOperation<
    'fetch,
    'policy,
    RoutedP,
    DirectP,
    FetchResult,
    FactoryError,
    ProducerError,
    FetchError,
    AcquisitionError,
    FactoryRequirements,
    ProducerRequirements,
    never,
    AcquisitionRequirements,
    Factory,
    Producer,
    DiscardDestination,
    C,
  > {
    fetch: move fetch,
    factory: move factory,
    policyAnchor: [],
    options: move options,
    destination: DiscardDestination {maximum: maxDiscardBytes},
  }
  return run withSemanticRequest<RoutedP, DirectP>(move request, move operation)
}

fn copyInstant(value: &Instant) -> Instant {
  return SystemClock.make(SystemClock.seconds(value), SystemClock.nanoseconds(value))
}

fn copyDeadline(value: &Option<Instant>) -> Option<Instant> {
  return match & value.* {
    Option.None => Option<Instant>.none()
    Option.Some {value: present} => Option<Instant>.some(copyInstant(&present))
  }
}

fn unavailable<T>() -> T {
  return Intrinsic.trap("HTTP fetch: an internal value was missing where the fetch had just stored it")
}

fn fetchFailure(phase: FetchPhase, reason: FetchReason) -> FetchError {
  return FetchError {
    phase: phase,
    reason: move reason,
    status: Option<Status>.none(),
    uri: Option<OwnedUri>.none(),
    deliveredBodyBytes: u64.MIN,
    offeredBodyBytes: usize.ZERO,
  }
}

fn ownedResponseFailure(
  phase: FetchPhase,
  reason: FetchReason,
  status: Option<Status>,
  uri: OwnedUri,
  delivered: u64,
  offered: usize,
) -> FetchError {
  return FetchError {
    phase: phase,
    reason: move reason,
    status: move status,
    uri: Option<OwnedUri>.some(move uri),
    deliveredBodyBytes: delivered,
    offeredBodyBytes: offered,
  }
}

fn enrichResponseStatus(error: FetchError, status: Status) -> FetchError {
  let FetchError {phase, reason, status: priorStatus, uri, deliveredBodyBytes, offeredBodyBytes} = move error
  drop priorStatus
  return FetchError {
    phase: phase,
    reason: move reason,
    status: Option<Status>.some(status),
    uri: move uri,
    deliveredBodyBytes: deliveredBodyBytes,
    offeredBodyBytes: offeredBodyBytes,
  }
}

effect fn borrowedResponseFailure<'uri>(
  phase: FetchPhase,
  reason: FetchReason,
  status: Option<Status>,
  uri: &Uri<'uri>,
  delivered: u64,
  offered: usize,
) -> FetchError ! OutOfMemoryError ? &mut Allocator {
  return ownedResponseFailure(
    phase,
    move reason,
    move status,
    run Uri.copy(uri),
    delivered,
    offered,
  )
}

fn metadataFailure(
  phase: FetchPhase,
  reason: FetchReason,
  metadata: &ResponseMetadata,
  delivered: u64,
  offered: usize,
) -> FetchError {
  let head = metadata.head.view()
  let status = head.status()
  drop head
  return FetchError {
    phase: phase,
    reason: move reason,
    status: Option<Status>.some(status),
    uri: Option<OwnedUri>.none(),
    deliveredBodyBytes: delivered,
    offeredBodyBytes: offered,
  }
}

fn ownedMetadataFailure(
  phase: FetchPhase,
  reason: FetchReason,
  metadata: ResponseMetadata,
  delivered: u64,
  offered: usize,
) -> FetchError {
  let ResponseMetadata {finalUri, head, representation, ownedBytes} = move metadata
  let headView = head.view()
  let status = headView.status()
  drop headView
  drop head
  drop representation
  drop ownedBytes
  return ownedResponseFailure(
    phase,
    move reason,
    Option<Status>.some(status),
    move finalUri,
    delivered,
    offered,
  )
}

fn enrichResponseFailure(
  error: FetchError,
  status: Status,
  uri: OwnedUri,
  delivered: u64,
  offered: usize,
) -> FetchError {
  let FetchError {
    phase,
    reason,
    status: priorStatus,
    uri: priorUri,
    deliveredBodyBytes,
    offeredBodyBytes,
  } = move error
  drop priorStatus
  drop priorUri
  drop deliveredBodyBytes
  drop offeredBodyBytes
  return ownedResponseFailure(
    phase,
    move reason,
    Option<Status>.some(status),
    move uri,
    delivered,
    offered,
  )
}

fn enrichMetadataFailure(
  error: FetchError,
  metadata: ResponseMetadata,
  delivered: u64,
  offered: usize,
) -> FetchError {
  let FetchError {phase, reason, status, uri, deliveredBodyBytes, offeredBodyBytes} = move error
  drop status
  drop uri
  drop deliveredBodyBytes
  drop offeredBodyBytes
  return ownedMetadataFailure(phase, move reason, move metadata, delivered, offered)
}

fn contentOptionFailure(error: ContentError<'static>) -> FetchError {
  let ContentError<'static> {reason, written, totalEncoded, totalIntermediate, totalDecoded} = move error
  return match move reason {
    ContentReason.InvalidLimit {limit, allowed, attempted} => FetchError {
      phase: FetchPhase.Decode,
      reason: FetchReason.Content {
        error: FetchContentError {
          reason: FetchContentReason.InvalidLimit {
            limit: limit,
            allowed: allowed,
            attempted: attempted,
          },
          written: written,
          totalEncoded: totalEncoded,
          totalIntermediate: totalIntermediate,
          totalDecoded: totalDecoded,
        },
      },
      status: Option<Status>.none(),
      uri: Option<OwnedUri>.none(),
      deliveredBodyBytes: u64.MIN,
      offeredBodyBytes: usize.ZERO,
    }
    _ => fetchFailure(FetchPhase.Decode, FetchReason.InvalidOptions)
  }
}

fn switchingFailure() -> FetchError {
  let status = match move Status.fromCode(101) {
    Result.Failure {error} => {
      drop error
      return unavailable<FetchError>()
    }
    Result.Success {value} => value
  }
  return FetchError {
    phase: FetchPhase.Head,
    reason: FetchReason.UnsupportedSwitchingResponse {status: status},
    status: Option<Status>.some(status),
    uri: Option<OwnedUri>.none(),
    deliveredBodyBytes: u64.MIN,
    offeredBodyBytes: usize.ZERO,
  }
}

effect fn mapSwitching<'env, A, E, ?R>(attempted: once Effect<'env; A ! E | ExchangeError ? R>) -> A
! E | ExchangeError | FetchError
? R {
  let outcome = run Effect.result(move attempted)
  return match move outcome {
    Result.Success {value} => move value
    Result.Failure {error} => match move error {
      ExchangeError.UnsupportedUpgrade => {
        fail switchingFailure()
      }
      ExchangeError cause => {
        fail move cause
      }
      E cause => {
        fail move cause
      }
    }
  }
}

fn limitFailure(
  phase: FetchPhase,
  limit: FetchLimit,
  allowed: u64,
  attempted: u64,
  delivered: u64,
  offered: usize,
) -> FetchError {
  return FetchError {
    phase: phase,
    reason: FetchReason.LimitExceeded {limit: limit, allowed: allowed, attempted: attempted},
    status: Option<Status>.none(),
    uri: Option<OwnedUri>.none(),
    deliveredBodyBytes: delivered,
    offeredBodyBytes: offered,
  }
}

fn copyContinuePolicy(value: &ContinuePolicy) -> ContinuePolicy {
  return match & value.* {
    ContinuePolicy.Disabled => ContinuePolicy.Disabled
    ContinuePolicy.Require100 {deadline} => ContinuePolicy.Require100 {
      deadline: copyInstant(&deadline),
    }
  }
}

fn copyContentLimits(value: &ContentLimits) -> ContentLimits {
  return ContentLimits {
    maxEncoded: value.maxEncoded,
    maxIntermediate: value.maxIntermediate,
    maxDecoded: value.maxDecoded,
    maxOwned: value.maxOwned,
    maxDepth: value.maxDepth,
    intermediateCapacity: value.intermediateCapacity,
    inflate: InflateLimits {
      maxInputBytes: value.inflate.maxInputBytes,
      maxOutputBytes: value.inflate.maxOutputBytes,
      maxMembers: value.inflate.maxMembers,
      maxHeaderBytes: value.inflate.maxHeaderBytes,
      maxMemoryBytes: value.inflate.maxMemoryBytes,
    },
    zstd: ZstdLimits {
      inputBytes: value.zstd.inputBytes,
      outputBytes: value.zstd.outputBytes,
      frames: value.zstd.frames,
      skippableBytes: value.zstd.skippableBytes,
      windowBytes: value.zstd.windowBytes,
      workspaceBytes: value.zstd.workspaceBytes,
    },
  }
}

effect fn ownContentError<'head>(
  error: ContentError<'head>,
  metadataUsed: usize,
  metadataLimit: usize,
) -> FetchContentError ! FetchError | OutOfMemoryError ? &mut Allocator {
  let ContentError<'head> {reason, written, totalEncoded, totalIntermediate, totalDecoded} = move error
  let ownedReason = match move reason {
    ContentReason.InvalidLimit {limit, allowed, attempted} => FetchContentReason.InvalidLimit {
      limit: limit,
      allowed: allowed,
      attempted: attempted,
    }
    ContentReason.CodingSyntax {position} => FetchContentReason.CodingSyntax {position: position}
    ContentReason.UnsupportedCoding {position, token} => run ownUnsupportedCoding(
      position,
      token,
      metadataUsed,
      metadataLimit,
    )
    ContentReason.PartialResponse {position} => FetchContentReason.PartialResponse {
      position: position,
    }
    ContentReason.Tunnel => FetchContentReason.Tunnel
    ContentReason.Body {error: cause} => FetchContentReason.Body {error: move cause}
    ContentReason.Buffer {error: cause} => FetchContentReason.Buffer {error: move cause}
    ContentReason.Inflate {stage, wireIndex, error: cause} => FetchContentReason.Inflate {
      stage: stage,
      wireIndex: wireIndex,
      error: move cause,
    }
    ContentReason.Zstandard {stage, wireIndex, error: cause} => FetchContentReason.Zstandard {
      stage: stage,
      wireIndex: wireIndex,
      error: move cause,
    }
    ContentReason.TrailingEncodedData {stage, wireIndex} => FetchContentReason.TrailingEncodedData {
      stage: stage,
      wireIndex: wireIndex,
    }
    ContentReason.ArithmeticOverflow => FetchContentReason.ArithmeticOverflow
    ContentReason.InvalidState => FetchContentReason.InvalidState
  }
  return FetchContentError {
    reason: move ownedReason,
    written: written,
    totalEncoded: totalEncoded,
    totalIntermediate: totalIntermediate,
    totalDecoded: totalDecoded,
  }
}

effect fn ownUnsupportedCoding(
  position: CodingPosition,
  token: &[u8],
  metadataUsed: usize,
  metadataLimit: usize,
) -> FetchContentReason ! FetchError | OutOfMemoryError ? &mut Allocator {
  let total = match move usize.checkedAdd(metadataUsed, token.length) {
    Option.None => {
      fail fetchFailure(FetchPhase.Decode, FetchReason.SizeOverflow)
    }
    Option.Some {value} => value
  }
  if total > metadataLimit {
    fail limitFailure(
      FetchPhase.Decode,
      FetchLimit.OwnedMetadataBytes,
      usize.toU64(metadataLimit),
      usize.toU64(total),
      u64.MIN,
      usize.ZERO,
    )
  }
  return FetchContentReason.UnsupportedCoding {position: position, token: run Bytes.copy(token)}
}
