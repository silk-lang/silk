//! HTTP/2 wire frame headers, error codes, and frame serialization from RFC 9113.
//!
//! Use [`FrameHeader.read`] after collecting nine bytes. A connection must enforce its negotiated
//! frame size and stream rules before it accepts the payload. Unknown frame types remain representable.
//!
//! @category HTTP

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.text.format { Debug, Format, Formatter }
import silk.io.writer { Writer, WriterError }
import silk.core.ownership { Copy }
import silk.num.u8
import silk.num.u32
import silk.num.usize

/// Returns the client connection preface. The client sends SETTINGS immediately after these bytes.
pub fn preface() -> &'static [u8] {
  return b"PRI * HTTP/2.0\r\n\r\nSM\r\n\r\n"
}

/// Successful completion, wire error code 0.
pub const NO_ERROR: u32 = 0

/// A protocol rule violation, wire error code 1.
pub const PROTOCOL_ERROR: u32 = 1

/// An implementation failure, wire error code 2.
pub const INTERNAL_ERROR: u32 = 2

/// A flow-control violation, wire error code 3.
pub const FLOW_CONTROL_ERROR: u32 = 3

/// A SETTINGS acknowledgment timeout, wire error code 4.
pub const SETTINGS_TIMEOUT: u32 = 4

/// A frame on a closed stream, wire error code 5.
pub const STREAM_CLOSED: u32 = 5

/// An invalid frame length, wire error code 6.
pub const FRAME_SIZE_ERROR: u32 = 6

/// A request refused before processing, wire error code 7.
pub const REFUSED_STREAM: u32 = 7

/// A cancelled stream, wire error code 8.
pub const CANCEL: u32 = 8

/// A malformed HPACK context, wire error code 9.
pub const COMPRESSION_ERROR: u32 = 9

/// A failed CONNECT tunnel, wire error code 10.
pub const CONNECT_ERROR: u32 = 10

/// A peer exceeded resource limits, wire error code 11.
pub const ENHANCE_YOUR_CALM: u32 = 11

/// The transport does not meet security requirements, wire error code 12.
pub const INADEQUATE_SECURITY: u32 = 12

/// The peer requires HTTP/1.1, wire error code 13.
pub const HTTP_1_1_REQUIRED: u32 = 13

/// An HTTP/2 error. Stream zero identifies a connection error; a nonzero identifier identifies a stream error.
pub struct ProtocolError {
  /// The wire error code for GOAWAY or RST_STREAM.
  pub code: u32,

  /// Zero for a connection error, otherwise the affected stream identifier.
  pub stream: u32,
}

impl Copy for ProtocolError {}

impl Debug for ProtocolError {
  /// Writes the fields, as `ProtocolError { code: ..., stream: ... }`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return run Format.debugFields(self, "ProtocolError", &mut formatter)
  }
}

/// The nine-byte HTTP/2 frame header. The reserved stream bit is ignored when reading.
pub struct FrameHeader {
  /// Payload length, excluding the nine-byte header.
  pub length: usize,

  /// The wire frame type, including extension types.
  pub kind: u8,

  /// Frame flags, including unknown flags that receivers ignore.
  pub flags: u8,

  /// The 31-bit stream identifier, or zero for a connection frame.
  pub stream: u32,
}

impl Copy for FrameHeader {}

impl FrameHeader {
  /// Reads exactly nine header bytes. An incorrect input length fails with FRAME_SIZE_ERROR.
  pub effect fn read(input: &[u8]) -> FrameHeader
    ! ProtocolError {
    if input.length != 9 {
      fail ProtocolError { code: FRAME_SIZE_ERROR, stream: 0 }
    }
    return FrameHeader {
      length: u8.toUsize(input[0]) * 65536 + u8.toUsize(input[1]) * 256 + u8.toUsize(input[2]),
      kind: input[3],
      flags: input[4],
      stream: read32(input, 5) & 2147483647,
    }
  }

  /// Appends this header and payload. Invalid payload length or stream bits fail before output changes.
  pub effect fn write(self: &Self, output: &mut Bytes, payload: &[u8]) -> ()
    ! ProtocolError | OutOfMemoryError
    ? &mut Allocator {
    if self.length != payload.length || self.length > 16777215 {
      fail ProtocolError { code: FRAME_SIZE_ERROR, stream: 0 }
    }
    if self.stream > 2147483647 {
      fail ProtocolError { code: PROTOCOL_ERROR, stream: 0 }
    }
    let bytes = [
      usize.toU8(self.length / 65536),
      usize.toU8((self.length / 256) % 256),
      usize.toU8(self.length % 256),
      self.kind,
      self.flags,
      u32.toU8(self.stream / 16777216),
      u32.toU8((self.stream / 65536) % 256),
      u32.toU8((self.stream / 256) % 256),
      u32.toU8(self.stream % 256),
    ]
    run Bytes.append(&mut output.*, &bytes)
    run Bytes.append(&mut output.*, payload)
  }
}

/// Reads four network-order bytes. The caller must supply four bytes starting at `offset`.
pub fn read32(input: &[u8], offset: usize) -> u32 {
  return u8.toU32(input[offset]) * 16777216 + u8.toU32(input[offset + 1]) * 65536
    + u8.toU32(input[offset + 2]) * 256
    + u8.toU32(input[offset + 3])
}

/// Appends four bytes in network order.
pub effect fn write32(output: &mut Bytes, value: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let bytes = [
    u32.toU8(value / 16777216),
    u32.toU8((value / 65536) % 256),
    u32.toU8((value / 256) % 256),
    u32.toU8(value % 256)
  ]
  run Bytes.append(&mut output.*, &bytes)
}
