//! Parse and write the head of an HTTP/1.0 or HTTP/1.1 message: the start line and the header
//! fields.
//!
//! # When to use
//! Use [`RequestParser`] or [`ResponseParser`] to parse a head as its bytes arrive from a
//! transport. Use [`parseRequest`] or [`parseResponse`] when you have all the bytes. Use
//! [`writeRequestInto`] and [`writeResponseInto`] to write a head from `silk.http.message`.
//!
//! # Details
//! A parser allocates all its memory in `make`. After that, `feed`, `head`, `reset`, and the write
//! functions do not allocate. `feed` returns how many bytes of the input it used, and stops after
//! the empty line that ends the head. The bytes after the head, such as the body, stay with you.
//! The head and its fields borrow the parser. Call `copy` to keep them after a `reset`.
//!
//! `maxOwnedBytes` must hold `maxHeadBytes` plus 32 bytes for each field in `maxFields`. Check a
//! [`Limits`] value with [`validateLimits`].
//!
//! # Errors
//! - [`ParseError`] tells which rule failed, the part, the byte offset in the head, and how many
//!   bytes of the current call were used.
//! - After an error, the parser stays failed until [`RequestParser.reset`].
//! - `OutOfMemoryError` from `make` if the `Allocator` fails.
//!
//! # Gotchas
//! The parser is strict. Lines must end with CRLF, and the start line uses one space between its
//! parts. These fail: a bare LF, a space before `:` in a field, a folded request line, empty lines
//! before the start line, and HTTP/0.9. A folded response field is joined with spaces.
//! A status line with no reason phrase may leave out the space after the code: `HTTP/1.1 200`.
//!
//! # Examples
//! ## Parse a response head
//! ```silk
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.core.effect { Effect }
//! import silk.http.message { Status }
//! import silk.http.head {
//!   Limits,
//!   ParseError,
//!   ParsedResponse,
//!   ProgressState,
//!   ResponseHead,
//!   ResponseParser,
//!   parseResponse
//! }
//! import silk.http.headers { Limits as ValueLimits }
//! import silk.core.result { Result }
//!
//! fn limits() -> Limits {
//!   return Limits {
//!     maxHeadBytes: 4096,
//!     maxStartLineBytes: 1024,
//!     maxFieldLineBytes: 1024,
//!     maxOwnedBytes: 8192,
//!     values: ValueLimits {
//!       maxMethodBytes: 16,
//!       maxTargetBytes: 1024,
//!       maxNameBytes: 64,
//!       maxValueBytes: 1024,
//!       maxFields: 32,
//!       maxFieldBytes: 4096,
//!       maxOwnedBytes: 8192,
//!     },
//!   }
//! }
//!
//! effect fn program() -> i32
//!   ! OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let wire = b"HTTP/1.1 200 OK\r\nContent-Length: 5\r\n\r\nhello"
//!   let parsed = run parseResponse(&wire, limits()) |> Effect.provideMut<Allocator>(&mut allocator)
//!   let result = match move parsed {
//!     Result<ParsedResponse, ParseError>.Success { value } => move value
//!     Result<ParsedResponse, ParseError>.Failure {..} => {
//!       return 1
//!     }
//!   }
//!
//!   // The parser stops after the head. The body "hello" starts at byte 38.
//!   if result.progress.consumed != 38 || result.progress.state != ProgressState.Complete {
//!     return 1
//!   }
//!   let head = match ResponseParser.head(&result.parser) {
//!     Result<ResponseHead, ParseError>.Success { value } => value
//!     Result<ResponseHead, ParseError>.Failure {..} => {
//!       return 1
//!     }
//!   }
//!   if Status.code(&ResponseHead.status(&head)) != 200 || ResponseHead.fieldCount(&head) != 1 {
//!     return 1
//!   }
//!   return 0
//! }
//!
//! effect fn failed<E>(error: E) -> i32 {
//!   drop error
//!   return 1
//! }
//!
//! pub fn main() -> i32 {
//!   return run Effect.catchAll(program(), failed)
//! }
//! ```
//!
//! @category HTTP

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.text.format { Debug, Format, Formatter }
import silk.http.message {
  Header,
  LimitKind as ValueLimitKind,
  Method,
  OwnedRequestHead,
  OwnedResponseHead,
  RequestHead as ValueRequestHead,
  ResponseHead as ValueResponseHead,
  Status,
  ValueComponent,
  ValueError,
  ValueReason,
  Version,
}
import silk.http.headers {
  HeaderIterator as ValueHeaderIterator,
  Headers,
  Limits as ValueLimits,
}
import silk.http.target { HttpAuthority, RequestTarget }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.text.string { String }
import silk.num.u16
import silk.num.u64
import silk.num.u8
import silk.num.usize
import silk.collections.list { List }
import silk.io.writer { Writer, WriterError }

const RECORD_BYTES: usize = 32

/// The maximum sizes for a parser. The `values` limits also apply to each part of the head.
///
/// # Gotchas
///
/// `maxOwnedBytes` must hold `maxHeadBytes` plus 32 bytes for each field in `maxFields`. Check a
/// value with [`validateLimits`].
pub struct Limits {
  /// The maximum size of the head, including every CRLF and the empty line at the end.
  pub maxHeadBytes: usize,
  /// The maximum size of the request line or status line, including its CRLF.
  pub maxStartLineBytes: usize,
  /// The maximum size of one field line, including its CRLF.
  pub maxFieldLineBytes: usize,
  /// The maximum memory of the parser: `maxHeadBytes` plus 32 bytes for each field in
  /// `values.maxFields`.
  pub maxOwnedBytes: usize,
  /// The limits for the method, target, names, values, and field count.
  pub values: ValueLimits,
}

impl Copy for Limits {}

/// Whether a head is complete after a `feed`.
pub enum ProgressState {
  /// The head is not complete. Feed more bytes.
  NeedInput,
  /// The empty line at the end was read. Get the head with `head`.
  Complete,
}

/// The result of a successful `feed`.
pub struct Progress {
  /// The number of bytes from the start of this input that the parser used. Give the rest again in
  /// the next call, or keep it if the head is complete.
  pub consumed: usize,
  /// Whether the head is complete.
  pub state: ProgressState,
}

impl Copy for Progress {}

/// The state of a parser.
pub enum ParserState {
  /// The parser takes more input.
  Active,
  /// A head is complete. Call `reset` before you parse the next head.
  Complete,
  /// A parse failed. Get the error with `failure`, and call `reset` to use the parser again.
  Failed,
}

/// The part of a head where a parse failed.
pub enum ParseComponent {
  /// The parser itself, for example its limits or its state.
  Parser,
  /// Request or response start line as a whole.
  StartLine,
  /// HTTP version token.
  Version,
  /// Request method token.
  Method,
  /// Request target.
  Target,
  /// Response status digits or range.
  Status,
  /// Response reason phrase.
  ReasonPhrase,
  /// Field name.
  HeaderName,
  /// A field value, without the spaces around it.
  HeaderValue,
  /// The `Host` field.
  Host,
  /// A line ending.
  LineEnding,
}

impl Debug for ParseComponent {
  /// Writes the name of the variant, such as `Parser`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      ParseComponent.Parser => run Format.write(&mut formatter, b"Parser")
      ParseComponent.StartLine => run Format.write(&mut formatter, b"StartLine")
      ParseComponent.Version => run Format.write(&mut formatter, b"Version")
      ParseComponent.Method => run Format.write(&mut formatter, b"Method")
      ParseComponent.Target => run Format.write(&mut formatter, b"Target")
      ParseComponent.Status => run Format.write(&mut formatter, b"Status")
      ParseComponent.ReasonPhrase => run Format.write(&mut formatter, b"ReasonPhrase")
      ParseComponent.HeaderName => run Format.write(&mut formatter, b"HeaderName")
      ParseComponent.HeaderValue => run Format.write(&mut formatter, b"HeaderValue")
      ParseComponent.Host => run Format.write(&mut formatter, b"Host")
      ParseComponent.LineEnding => run Format.write(&mut formatter, b"LineEnding")
    }
  }
}

/// The limit that a head exceeded. See [`ParseReason.LimitExceeded`].
pub enum ParseLimitKind {
  /// `maxHeadBytes`.
  HeadBytes,
  /// `maxStartLineBytes`.
  StartLineBytes,
  /// `maxFieldLineBytes`.
  FieldLineBytes,
  /// `maxFields`: the number of fields, including repeated fields.
  Fields,
  /// `maxMethodBytes`.
  MethodBytes,
  /// `maxTargetBytes`.
  TargetBytes,
  /// `maxNameBytes`.
  NameBytes,
  /// `maxValueBytes`, for a field value or the reason phrase.
  ValueBytes,
  /// `maxFieldBytes`: the total length of all names and values.
  FieldBytes,
  /// `maxOwnedBytes`: the memory of the parser.
  OwnedBytes,
}

impl Debug for ParseLimitKind {
  /// Writes the name of the variant, such as `HeadBytes`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      ParseLimitKind.HeadBytes => run Format.write(&mut formatter, b"HeadBytes")
      ParseLimitKind.StartLineBytes => run Format.write(&mut formatter, b"StartLineBytes")
      ParseLimitKind.FieldLineBytes => run Format.write(&mut formatter, b"FieldLineBytes")
      ParseLimitKind.Fields => run Format.write(&mut formatter, b"Fields")
      ParseLimitKind.MethodBytes => run Format.write(&mut formatter, b"MethodBytes")
      ParseLimitKind.TargetBytes => run Format.write(&mut formatter, b"TargetBytes")
      ParseLimitKind.NameBytes => run Format.write(&mut formatter, b"NameBytes")
      ParseLimitKind.ValueBytes => run Format.write(&mut formatter, b"ValueBytes")
      ParseLimitKind.FieldBytes => run Format.write(&mut formatter, b"FieldBytes")
      ParseLimitKind.OwnedBytes => run Format.write(&mut formatter, b"OwnedBytes")
    }
  }
}

/// The rule that a parse or a write failed.
pub union ParseReason {
  /// The start line does not have the form `METHOD SP target SP version` or `version SP status SP
  /// reason`, or `version SP status` with no reason.
  InvalidStartLine,
  /// A version is not exactly HTTP/1.0 or HTTP/1.1.
  UnsupportedVersion,
  /// A request method is not a nonempty HTTP token.
  InvalidMethod,
  /// The request target is not valid, or its form does not fit the method.
  InvalidTarget,
  /// The status is not three digits from 100 to 599.
  InvalidStatus,
  /// The reason phrase has a control byte or DEL.
  InvalidReasonPhrase,
  /// A field name is empty, or has a byte that is not allowed in a token.
  InvalidFieldName,
  /// A field value has a byte that is not allowed.
  InvalidFieldValue,
  /// A line ends with LF without CR.
  BareLf,
  /// A CR is not followed by LF.
  InvalidLineEnding,
  /// A field has a space or a tab between its name and the `:`.
  WhitespaceBeforeColon,
  /// A field line starts with a space or a tab. Requests do not accept folded lines; a response
  /// accepts one only after its first field, and joins it to that field with spaces.
  ObsFold,
  /// An HTTP/1.1 request has no `Host` field.
  MissingHost,
  /// A request has more than one `Host` field.
  DuplicateHost,
  /// The `Host` field is not a valid authority.
  InvalidHost,
  /// The head exceeded a limit.
  LimitExceeded {
    /// The limit that was exceeded.
    pub limit: ParseLimitKind,
    /// The value of the limit.
    pub allowed: usize,
    /// The size that was found.
    pub attempted: usize,
  },
  /// A size calculation overflowed `usize`.
  SizeOverflow,
  /// The input ended, with `final` set to `true`, before the head was complete.
  Truncated,
  /// The call is not valid in the current [`ParserState`], for example `feed` after a complete
  /// head.
  InvalidState,
}

impl Copy for ParseReason {}

impl Debug for ParseReason {
  /// Writes the name of the variant and its fields, such as `InvalidStartLine`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      ParseReason.InvalidStartLine => run Format.write(&mut formatter, b"InvalidStartLine")
      ParseReason.UnsupportedVersion => run Format.write(&mut formatter, b"UnsupportedVersion")
      ParseReason.InvalidMethod => run Format.write(&mut formatter, b"InvalidMethod")
      ParseReason.InvalidTarget => run Format.write(&mut formatter, b"InvalidTarget")
      ParseReason.InvalidStatus => run Format.write(&mut formatter, b"InvalidStatus")
      ParseReason.InvalidReasonPhrase => run Format.write(&mut formatter, b"InvalidReasonPhrase")
      ParseReason.InvalidFieldName => run Format.write(&mut formatter, b"InvalidFieldName")
      ParseReason.InvalidFieldValue => run Format.write(&mut formatter, b"InvalidFieldValue")
      ParseReason.BareLf => run Format.write(&mut formatter, b"BareLf")
      ParseReason.InvalidLineEnding => run Format.write(&mut formatter, b"InvalidLineEnding")
      ParseReason.WhitespaceBeforeColon => run Format.write(&mut formatter, b"WhitespaceBeforeColon")
      ParseReason.ObsFold => run Format.write(&mut formatter, b"ObsFold")
      ParseReason.MissingHost => run Format.write(&mut formatter, b"MissingHost")
      ParseReason.DuplicateHost => run Format.write(&mut formatter, b"DuplicateHost")
      ParseReason.InvalidHost => run Format.write(&mut formatter, b"InvalidHost")
      ParseReason.LimitExceeded { limit, allowed, attempted } => {
        let mut record = run Format.debugRecord("LimitExceeded", &mut formatter)
        run Format.debugField(&mut record, "limit", &limit, &mut formatter)
        run Format.debugField(&mut record, "allowed", &allowed, &mut formatter)
        run Format.debugField(&mut record, "attempted", &attempted, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      ParseReason.SizeOverflow => run Format.write(&mut formatter, b"SizeOverflow")
      ParseReason.Truncated => run Format.write(&mut formatter, b"Truncated")
      ParseReason.InvalidState => run Format.write(&mut formatter, b"InvalidState")
    }
  }
}

/// The error from a parse. It tells which rule failed, the part, the byte offset in the head, and
/// how many bytes of the current call were used.
pub struct ParseError {
  /// The rule that failed.
  pub reason: ParseReason,
  /// The part of the head that failed.
  pub component: ParseComponent,
  /// The number of bytes of this call that were valid before the error.
  pub consumed: usize,
  /// The byte offset in the head where the error is, from the start of the head.
  pub offset: usize,
  /// The position of the field, from 0, when the error is in a field.
  pub fieldIndex: Option<usize>,
}

impl Debug for ParseError {
  /// Writes the fields, as `ParseError { reason: ..., component: ..., ... }`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return run Format.debugFields(self, "ParseError", &mut formatter)
  }
}

/// Checks that `limits` are consistent, without allocation.
///
/// # Errors
/// - `LimitExceeded` with `OwnedBytes` if `maxOwnedBytes` is less than `maxHeadBytes` plus 32 bytes
///   for each field.
/// - `SizeOverflow` if that sum does not fit in `usize`.
pub fn validateLimits(limits: &Limits) -> Result<(), ParseError> {
  let metadata = match move usize.checkedMultiply(limits.values.maxFields, RECORD_BYTES) {
    Option<usize>.None => {
      return Result<(), ParseError>.failResult(parseError(
        ParseReason.SizeOverflow,
        ParseComponent.Parser,
        usize.ZERO,
        Option<usize>.none(),
      ))
    }
    Option<usize>.Some {value} => value
  }
  let required = match move usize.checkedAdd(limits.maxHeadBytes, metadata) {
    Option<usize>.None => {
      return Result<(), ParseError>.failResult(parseError(
        ParseReason.SizeOverflow,
        ParseComponent.Parser,
        usize.ZERO,
        Option<usize>.none(),
      ))
    }
    Option<usize>.Some {value} => value
  }
  if required > limits.maxOwnedBytes {
    return Result<(), ParseError>.failResult(parseError(
      ParseReason.LimitExceeded {
        limit: ParseLimitKind.OwnedBytes,
        allowed: limits.maxOwnedBytes,
        attempted: required,
      },
      ParseComponent.Parser,
      usize.ZERO,
      Option<usize>.none(),
    ))
  }
  return Result<(), ParseError>.succeed(())
}

enum HeadKind { Request, Response }

enum Phase { StartLine, Fields }

enum StartPart { First, Second, Third }

struct ParserCore {
  kind: HeadKind,
  storage: Bytes,
  limits: Limits,
  length: usize,
  lineStart: usize,
  pendingCr: bool,
  phase: Phase,
  startPart: StartPart,
  componentLength: usize,
  fieldColonSeen: bool,
  fieldNameLength: usize,
  fieldValueStarted: bool,
  fieldValueLength: usize,
  fieldPendingOws: usize,
  lineCompletesHead: bool,
  state: ParserState,
  failureReason: ParseReason,
  failureComponent: ParseComponent,
  failureConsumed: usize,
  failureOffset: usize,
  failureField: usize,
  failureHasField: bool,
  fieldCount: usize,
  fieldBytes: usize,
  versionValue: Version,
  methodStart: usize,
  methodLength: usize,
  targetStart: usize,
  targetLength: usize,
  statusValue: u16,
  reasonStart: usize,
  reasonLength: usize,
}

/// A parser for request heads that you feed in parts. Make it with [`RequestParser.make`].
///
/// # Details
///
/// `make` allocates all its memory. After that, `feed`, `head`, and `reset` do not allocate.
/// `feed` returns how many bytes of the input it used, and stops after the empty line that ends
/// the head. The bytes after the head, such as the body, stay with you. The head and its fields
/// borrow the parser. Call `copy` to keep them after a `reset`. After an error, the parser stays
/// failed until `reset`.
///
/// # Gotchas
///
/// The parser is strict. Lines must end with CRLF, and the start line uses one space between its
/// parts. These fail: a bare LF, a space before `:` in a field, a folded request line, empty lines
/// before the start line, and HTTP/0.9. A folded response field is joined with spaces.
/// A status line with no reason phrase may leave out the space after the code: `HTTP/1.1 200`.
pub struct RequestParser { core: ParserCore }

/// A parser for response heads that you feed in parts. Make it with [`ResponseParser.make`].
///
/// # Details
///
/// `make` allocates all its memory. After that, `feed`, `head`, and `reset` do not allocate.
/// `feed` returns how many bytes of the input it used, and stops after the empty line that ends
/// the head. The bytes after the head, such as the body, stay with you. The head and its fields
/// borrow the parser. Call `copy` to keep them after a `reset`. After an error, the parser stays
/// failed until `reset`.
///
/// # Gotchas
///
/// The parser is strict. Lines must end with CRLF, and the start line uses one space between its
/// parts. These fail: a bare LF, a space before `:` in a field, a folded request line, empty lines
/// before the start line, and HTTP/0.9. A folded response field is joined with spaces.
/// A status line with no reason phrase may leave out the space after the code: `HTTP/1.1 200`.
pub struct ResponseParser { core: ParserCore }

/// A parsed request head. It borrows its parser.
pub struct RequestHead<'owner> {
  bytes: &'owner [u8],
  records: &'owner [u8],
  limitsValue: ValueLimits,
  versionValue: Version,
  methodStart: usize,
  methodLength: usize,
  targetStart: usize,
  targetLength: usize,
  fieldCountValue: usize,
}

impl<'owner> Copy for RequestHead<'owner> {}

/// A parsed response head. It borrows its parser.
pub struct ResponseHead<'owner> {
  bytes: &'owner [u8],
  records: &'owner [u8],
  limitsValue: ValueLimits,
  versionValue: Version,
  statusValue: u16,
  reasonStart: usize,
  reasonLength: usize,
  fieldCountValue: usize,
}

impl<'owner> Copy for ResponseHead<'owner> {}

/// An iterator over the fields of a parsed head, in order.
pub struct HeaderIterator<'owner> {
  bytes: &'owner [u8],
  records: &'owner [u8],
  limitsValue: ValueLimits,
  count: usize,
  index: usize,
}

/// The result of [`parseRequest`].
pub struct ParsedRequest {
  /// The parser that holds the head. Get the head with [`RequestParser.head`].
  pub parser: RequestParser,
  /// How many bytes the head used. The bytes after it, such as the body, start at
  /// `progress.consumed`.
  pub progress: Progress,
}

/// The result of [`parseResponse`].
pub struct ParsedResponse {
  /// The parser that holds the head. Get the head with [`ResponseParser.head`].
  pub parser: ResponseParser,
  /// How many bytes the head used. The bytes after it, such as the body, start at
  /// `progress.consumed`.
  pub progress: Progress,
}

impl RequestParser {
  /// Returns a parser, and allocates all its memory.
  ///
  /// # Errors
  /// - `ParseError` if [`validateLimits`] fails.
  /// - `OutOfMemoryError` if the `Allocator` fails.
  pub effect fn make(limits: Limits) -> Result<RequestParser, ParseError>
  ! OutOfMemoryError
  ? &mut Allocator {
    let made = run makeCore(HeadKind.Request, limits)
    return match move made {
      Result<ParserCore, ParseError>.Failure {error} => {
        return Result<RequestParser, ParseError>.failResult(move error)
      }
      Result<ParserCore, ParseError>.Success {value} => {
        return Result<RequestParser, ParseError>.succeed(RequestParser {core: move value})
      }
    }
  }

  /// Parses the start of `input`, and returns how many bytes it used.
  ///
  /// # Details
  /// The parser keeps the bytes that it used. It stops after the empty line that ends the head. Set
  /// `final` to `true` when no more input comes, so that an incomplete head fails with `Truncated`.
  pub fn feed(self: &mut Self, input: &[u8], final: bool) -> Result<Progress, ParseError> {
    return feedCore(&mut self.core, input, final)
  }

  /// Returns the state of the parser.
  pub fn state(self: &Self) -> ParserState { return self.core.state }

  /// Returns the error that made the parser fail, or `None`.
  pub fn failure(self: &Self) -> Option<ParseError> { return storedFailure(&self.core) }

  /// Returns the parsed head. Returns `InvalidState` if the head is not complete.
  pub fn head<'owner>(self: &'owner Self) -> Result<RequestHead<'owner>, ParseError> {
    if self.core.state != ParserState.Complete {
      return Result<RequestHead<'owner>, ParseError>.failResult(stateError(self.core.length))
    }
    let length = self.core.length
    let recordsStart = self.core.limits.maxHeadBytes
    let recordsLength = self.core.fieldCount * RECORD_BYTES
    let limitsValue = self.core.limits.values
    let versionValue = self.core.versionValue
    let methodStart = self.core.methodStart
    let methodLength = self.core.methodLength
    let targetStart = self.core.targetStart
    let targetLength = self.core.targetLength
    let fieldCountValue = self.core.fieldCount
    let storage = Bytes.asSlice(&self.core.storage)
    return Result<RequestHead<'owner>, ParseError>.succeed(RequestHead<'owner> {
      bytes: Slice.view<u8>(storage, usize.ZERO, length),
      records: Slice.view<u8>(storage, recordsStart, recordsLength),
      limitsValue: limitsValue,
      versionValue: versionValue,
      methodStart: methodStart,
      methodLength: methodLength,
      targetStart: targetStart,
      targetLength: targetLength,
      fieldCountValue: fieldCountValue,
    })
  }

  /// Makes the parser ready for a new head, and keeps its memory. You cannot call it while you
  /// borrow a head from the parser.
  pub fn reset(self: &mut Self) -> Result<(), ParseError> { return resetCore(&mut self.core) }
}

impl ResponseParser {
  /// Returns a parser, and allocates all its memory.
  ///
  /// # Errors
  /// - `ParseError` if [`validateLimits`] fails.
  /// - `OutOfMemoryError` if the `Allocator` fails.
  pub effect fn make(limits: Limits) -> Result<ResponseParser, ParseError>
  ! OutOfMemoryError
  ? &mut Allocator {
    let made = run makeCore(HeadKind.Response, limits)
    return match move made {
      Result<ParserCore, ParseError>.Failure {error} => {
        return Result<ResponseParser, ParseError>.failResult(move error)
      }
      Result<ParserCore, ParseError>.Success {value} => {
        return Result<ResponseParser, ParseError>.succeed(ResponseParser {core: move value})
      }
    }
  }

  /// Parses the start of `input`, and returns how many bytes it used.
  ///
  /// # Details
  /// The parser keeps the bytes that it used. It stops after the empty line that ends the head. Set
  /// `final` to `true` when no more input comes, so that an incomplete head fails with `Truncated`.
  pub fn feed(self: &mut Self, input: &[u8], final: bool) -> Result<Progress, ParseError> {
    return feedCore(&mut self.core, input, final)
  }

  /// Returns the state of the parser.
  pub fn state(self: &Self) -> ParserState { return self.core.state }

  /// Returns the error that made the parser fail, or `None`.
  pub fn failure(self: &Self) -> Option<ParseError> { return storedFailure(&self.core) }

  /// Returns the parsed head. Returns `InvalidState` if the head is not complete.
  pub fn head<'owner>(self: &'owner Self) -> Result<ResponseHead<'owner>, ParseError> {
    if self.core.state != ParserState.Complete {
      return Result<ResponseHead<'owner>, ParseError>.failResult(stateError(self.core.length))
    }
    let length = self.core.length
    let recordsStart = self.core.limits.maxHeadBytes
    let recordsLength = self.core.fieldCount * RECORD_BYTES
    let limitsValue = self.core.limits.values
    let versionValue = self.core.versionValue
    let statusValue = self.core.statusValue
    let reasonStart = self.core.reasonStart
    let reasonLength = self.core.reasonLength
    let fieldCountValue = self.core.fieldCount
    let storage = Bytes.asSlice(&self.core.storage)
    return Result<ResponseHead<'owner>, ParseError>.succeed(ResponseHead<'owner> {
      bytes: Slice.view<u8>(storage, usize.ZERO, length),
      records: Slice.view<u8>(storage, recordsStart, recordsLength),
      limitsValue: limitsValue,
      versionValue: versionValue,
      statusValue: statusValue,
      reasonStart: reasonStart,
      reasonLength: reasonLength,
      fieldCountValue: fieldCountValue,
    })
  }

  /// Makes the parser ready for a new head, and keeps its memory. You cannot call it while you
  /// borrow a head from the parser.
  pub fn reset(self: &mut Self) -> Result<(), ParseError> { return resetCore(&mut self.core) }
}

impl<'owner> RequestHead<'owner> {
  /// Returns the parsed protocol version.
  pub fn version(self: &Self) -> Version { return self.versionValue }

  /// Returns the method, spelled as received.
  pub fn method(self: &Self) -> Method<'owner> {
    let text = asciiText(range(self.bytes, self.methodStart, self.methodLength))
    return match move Method.parse(text, self.limitsValue.maxMethodBytes) {
      Result<Method<'owner>, ValueError>.Failure {..} => { return absurd<Method<'owner>>() }
      Result<Method<'owner>, ValueError>.Success {value} => { return value }
    }
  }

  /// Returns the request target.
  pub fn target(self: &Self) -> RequestTarget<'owner> {
    let method = RequestHead.method(self)
    let text = asciiText(range(self.bytes, self.targetStart, self.targetLength))
    return match move RequestTarget.parse(&method, text, self.limitsValue.maxTargetBytes) {
      Result<RequestTarget<'owner>, ValueError>.Failure {..} => {
        return absurd<RequestTarget<'owner>>()
      }
      Result<RequestTarget<'owner>, ValueError>.Success {value} => { return value }
    }
  }

  /// Returns the number of fields, including duplicates.
  pub fn fieldCount(self: &Self) -> usize { return self.fieldCountValue }

  /// Returns an iterator over the fields, in order. Repeated fields stay separate.
  pub fn fields(self: &Self) -> HeaderIterator<'owner> {
    return HeaderIterator<'owner> {
      bytes: self.bytes,
      records: self.records,
      limitsValue: self.limitsValue,
      count: self.fieldCountValue,
      index: usize.ZERO,
    }
  }

  /// Copies the head into new memory, as an owned head from `silk.http.message`.
  ///
  /// # Errors
  /// - `ValueError` if the head exceeds `limits`.
  /// - `OutOfMemoryError` if the `Allocator` fails.
  pub effect fn copy(
    self: &Self,
    limits: ValueLimits,
  ) -> Result<OwnedRequestHead, ValueError> ! OutOfMemoryError ? &mut Allocator {
    let entries = run collectHeaders(self.bytes, self.records, self.fieldCountValue, limits)
    return run copyRequestValues(
      self.versionValue,
      RequestHead.method(self),
      RequestHead.target(self),
      List<Header<'owner>>.asSlice(&entries),
      limits,
    )
  }

}

impl<'owner> ResponseHead<'owner> {
  /// Returns the parsed protocol version.
  pub fn version(self: &Self) -> Version { return self.versionValue }

  /// Returns the status.
  pub fn status(self: &Self) -> Status {
    return match move Status.fromCode(self.statusValue) {
      Result<Status, ValueError>.Failure {..} => { return absurd<Status>() }
      Result<Status, ValueError>.Success {value} => { return value }
    }
  }

  /// Returns the reason phrase bytes. They can be empty, and are not always UTF-8.
  pub fn reason(self: &Self) -> &'owner [u8] {
    return range(self.bytes, self.reasonStart, self.reasonLength)
  }

  /// Returns the number of fields, including duplicates.
  pub fn fieldCount(self: &Self) -> usize { return self.fieldCountValue }

  /// Returns an iterator over the fields, in order. Repeated fields stay separate.
  pub fn fields(self: &Self) -> HeaderIterator<'owner> {
    return HeaderIterator<'owner> {
      bytes: self.bytes,
      records: self.records,
      limitsValue: self.limitsValue,
      count: self.fieldCountValue,
      index: usize.ZERO,
    }
  }

  /// Copies the head into new memory, as an owned head from `silk.http.message`.
  ///
  /// # Errors
  /// - `ValueError` if the head exceeds `limits`.
  /// - `OutOfMemoryError` if the `Allocator` fails.
  pub effect fn copy(
    self: &Self,
    limits: ValueLimits,
  ) -> Result<OwnedResponseHead, ValueError> ! OutOfMemoryError ? &mut Allocator {
    let entries = run collectHeaders(self.bytes, self.records, self.fieldCountValue, limits)
    return run copyResponseValues(
      self.versionValue,
      ResponseHead.status(self),
      ResponseHead.reason(self),
      List<Header<'owner>>.asSlice(&entries),
      limits,
    )
  }

  /// Copies the status, the reason, and only the fields named `name`, into new memory.
  ///
  /// # Details
  /// Names are compared without case. Repeated fields stay separate, in their order. `limits`
  /// applies to the copied parts only.
  pub effect fn copyMatchingHeaders<'name>(
    self: &Self,
    name: string<'name>,
    limits: ValueLimits,
  ) -> Result<OwnedResponseHead, ValueError> ! OutOfMemoryError ? &mut Allocator {
    let selected = run collectMatchingHeaders(
      self.bytes,
      self.records,
      self.fieldCountValue,
      name,
      limits,
    )
    return match move selected {
      Result<List<Header<'owner>>, ValueError>.Failure {error} => {
        return Result<OwnedResponseHead, ValueError>.failResult(move error)
      }
      Result<List<Header<'owner>>, ValueError>.Success {value} => run copyResponseValues(
        self.versionValue,
        ResponseHead.status(self),
        ResponseHead.reason(self),
        List<Header<'owner>>.asSlice(&value),
        limits,
      )
    }
  }
}

impl<'owner> HeaderIterator<'owner> {
  /// Returns the next validated field, or `None` after the final field.
  pub fn next(self: &mut Self) -> Option<Header<'owner>> {
    if self.index >= self.count { return Option<Header<'owner>>.none() }
    let record = readRecord(self.records, self.index)
    self.index = self.index + usize.ONE
    let name = asciiText(range(self.bytes, record.nameStart, record.nameLength))
    let valueBytes = range(self.bytes, record.valueStart, record.valueLength)
    return match move Header.make(name, valueBytes, self.limitsValue) {
      Result<Header<'owner>, ValueError>.Failure {..} => {
        return absurd<Option<Header<'owner>>>()
      }
      Result<Header<'owner>, ValueError>.Success {value} => {
        return Option<Header<'owner>>.some(value)
      }
    }
  }

  /// Returns the position of the last field from [`HeaderIterator.next`], from 0.
  pub fn fieldIndex(self: &Self) -> usize {
    if self.index == usize.ZERO { return usize.MAX }
    return self.index - usize.ONE
  }
}

/// Parses a request head from the start of `input`. The bytes after the head start at
/// `progress.consumed` in the result.
///
/// # Gotchas
///
/// The parser is strict. Lines must end with CRLF, and the start line uses one space between its
/// parts. These fail: a bare LF, a space before `:` in a field, a folded request line, empty lines
/// before the start line, and HTTP/0.9. A folded response field is joined with spaces.
/// A status line with no reason phrase may leave out the space after the code: `HTTP/1.1 200`.
pub effect fn parseRequest(
  input: &[u8],
  limits: Limits,
) -> Result<ParsedRequest, ParseError> ! OutOfMemoryError ? &mut Allocator {
  let made = run RequestParser.make(limits)
  let mut parser = match move made {
    Result<RequestParser, ParseError>.Failure {error} => {
      return Result<ParsedRequest, ParseError>.failResult(move error)
    }
    Result<RequestParser, ParseError>.Success {value} => move value
  }
  let fed = RequestParser.feed(&mut parser, input, true)
  return match move fed {
    Result<Progress, ParseError>.Failure {error} => {
      return Result<ParsedRequest, ParseError>.failResult(move error)
    }
    Result<Progress, ParseError>.Success {value} => {
      return Result<ParsedRequest, ParseError>.succeed(ParsedRequest {
        parser: move parser,
        progress: value,
      })
    }
  }
}

/// Parses a response head from the start of `input`. The bytes after the head start at
/// `progress.consumed` in the result.
///
/// # Gotchas
///
/// The parser is strict. Lines must end with CRLF, and the start line uses one space between its
/// parts. These fail: a bare LF, a space before `:` in a field, a folded request line, empty lines
/// before the start line, and HTTP/0.9. A folded response field is joined with spaces.
/// A status line with no reason phrase may leave out the space after the code: `HTTP/1.1 200`.
pub effect fn parseResponse(
  input: &[u8],
  limits: Limits,
) -> Result<ParsedResponse, ParseError> ! OutOfMemoryError ? &mut Allocator {
  let made = run ResponseParser.make(limits)
  let mut parser = match move made {
    Result<ResponseParser, ParseError>.Failure {error} => {
      return Result<ParsedResponse, ParseError>.failResult(move error)
    }
    Result<ResponseParser, ParseError>.Success {value} => move value
  }
  let fed = ResponseParser.feed(&mut parser, input, true)
  return match move fed {
    Result<Progress, ParseError>.Failure {error} => {
      return Result<ParsedResponse, ParseError>.failResult(move error)
    }
    Result<Progress, ParseError>.Success {value} => {
      return Result<ParsedResponse, ParseError>.succeed(ParsedResponse {
        parser: move parser,
        progress: value,
      })
    }
  }
}

/// Returns the number of bytes that [`writeRequestInto`] writes for `head`.
pub fn requestSerializedSize<'value>(
  head: &ValueRequestHead<'value>,
  limits: ValueLimits,
) -> Result<usize, ValueError> {
  let validated = validateRequestForSerialization(head, limits)
  if let Result<(), ValueError>.Failure {error} = move validated {
    return Result<usize, ValueError>.failResult(move error)
  }
  let methodValue = ValueRequestHead.method(head)
  let targetValue = ValueRequestHead.target(head)
  let versionValue = ValueRequestHead.version(head)
  let headers = ValueRequestHead.headers(head)
  let method = String.byteLength(Method.format(&methodValue))
  let target = String.byteLength(RequestTarget.format(targetValue))
  let version = String.byteLength(Version.format(&versionValue))
  let withMethod = checkedValueAdd(method, usize.ONE, ValueComponent.Headers)
  let withTarget = chainValueAdd(move withMethod, target, ValueComponent.Headers)
  let withTargetSpace = chainValueAdd(move withTarget, usize.ONE, ValueComponent.Headers)
  let withVersion = chainValueAdd(move withTargetSpace, version, ValueComponent.Headers)
  let withStartLine = chainValueAdd(move withVersion, 2, ValueComponent.Headers)
  let withFields = chainValueResult(
    move withStartLine,
    fieldsSerializedSize(&headers),
    ValueComponent.Headers,
  )
  return chainValueAdd(move withFields, 2, ValueComponent.Headers)
}

/// Returns the number of bytes that [`writeResponseInto`] writes for `head`.
pub fn responseSerializedSize<'value>(
  head: &ValueResponseHead<'value>,
  limits: ValueLimits,
) -> Result<usize, ValueError> {
  let validated = validateResponseForSerialization(head, limits)
  if let Result<(), ValueError>.Failure {error} = move validated {
    return Result<usize, ValueError>.failResult(move error)
  }
  let versionValue = ValueResponseHead.version(head)
  let reason = ValueResponseHead.reason(head)
  let headers = ValueResponseHead.headers(head)
  let version = String.byteLength(Version.format(&versionValue))
  let reasonLength = match move reason {
    Option<&[u8]>.None => usize.ZERO
    Option<&[u8]>.Some {value} => value.length
  }
  let withStatus = checkedValueAdd(version, 5, ValueComponent.Headers)
  let withReason = chainValueAdd(move withStatus, reasonLength, ValueComponent.Headers)
  let withStartLine = chainValueAdd(move withReason, 2, ValueComponent.Headers)
  let withFields = chainValueResult(
    move withStartLine,
    fieldsSerializedSize(&headers),
    ValueComponent.Headers,
  )
  return chainValueAdd(move withFields, 2, ValueComponent.Headers)
}

/// Writes `head` with single spaces and CRLF line endings, and the empty line at the end, to the
/// start of `output`. Returns the length. If `output` is too small, it writes nothing.
pub fn writeRequestInto<'value>(
  head: &ValueRequestHead<'value>,
  output: &mut [u8],
  limits: ValueLimits,
) -> Result<usize, ValueError> {
  let required = match move requestSerializedSize(head, limits) {
    Result<usize, ValueError>.Failure {error} => {
      return Result<usize, ValueError>.failResult(move error)
    }
    Result<usize, ValueError>.Success {value} => value
  }
  if output.length < required {
    return Result<usize, ValueError>.failResult(valueOutputTooSmall(required, output.length))
  }
  let methodValue = ValueRequestHead.method(head)
  let targetValue = ValueRequestHead.target(head)
  let versionValue = ValueRequestHead.version(head)
  let headers = ValueRequestHead.headers(head)
  let mut cursor = usize.ZERO
  cursor = writeSlice(&mut output, cursor, String.utf8Bytes(Method.format(&methodValue)))
  output[cursor] = 32
  cursor = cursor + usize.ONE
  cursor = writeSlice(&mut output, cursor, String.utf8Bytes(RequestTarget.format(targetValue)))
  output[cursor] = 32
  cursor = cursor + usize.ONE
  cursor = writeSlice(&mut output, cursor, String.utf8Bytes(Version.format(&versionValue)))
  output[cursor] = 13
  output[cursor + usize.ONE] = 10
  cursor = cursor + 2
  cursor = writeFields(&headers, &mut output, cursor)
  output[cursor] = 13
  output[cursor + usize.ONE] = 10
  return Result<usize, ValueError>.succeed(cursor + 2)
}

/// Writes `head` with single spaces and CRLF line endings, and the empty line at the end, to the
/// start of `output`. Returns the length. If `output` is too small, it writes nothing.
pub fn writeResponseInto<'value>(
  head: &ValueResponseHead<'value>,
  output: &mut [u8],
  limits: ValueLimits,
) -> Result<usize, ValueError> {
  let required = match move responseSerializedSize(head, limits) {
    Result<usize, ValueError>.Failure {error} => {
      return Result<usize, ValueError>.failResult(move error)
    }
    Result<usize, ValueError>.Success {value} => value
  }
  if output.length < required {
    return Result<usize, ValueError>.failResult(valueOutputTooSmall(required, output.length))
  }
  let versionValue = ValueResponseHead.version(head)
  let statusValue = ValueResponseHead.status(head)
  let reason = ValueResponseHead.reason(head)
  let headers = ValueResponseHead.headers(head)
  let mut cursor = usize.ZERO
  cursor = writeSlice(&mut output, cursor, String.utf8Bytes(Version.format(&versionValue)))
  output[cursor] = 32
  let code = u16.toUsize(Status.code(&statusValue))
  output[cursor + usize.ONE] = usize.toU8(code / 100 + 48)
  output[cursor + 2] = usize.toU8((code / 10) % 10 + 48)
  output[cursor + 3] = usize.toU8(code % 10 + 48)
  output[cursor + 4] = 32
  cursor = cursor + 5
  match move reason {
    Option<&[u8]>.None => {}
    Option<&[u8]>.Some {value} => { cursor = writeSlice(&mut output, cursor, value) }
  }
  output[cursor] = 13
  output[cursor + usize.ONE] = 10
  cursor = cursor + 2
  cursor = writeFields(&headers, &mut output, cursor)
  output[cursor] = 13
  output[cursor + usize.ONE] = 10
  return Result<usize, ValueError>.succeed(cursor + 2)
}

effect fn makeCore(kind: HeadKind, limits: Limits) -> Result<ParserCore, ParseError>
! OutOfMemoryError
? &mut Allocator {
  let valid = validateLimits(&limits)
  if let Result<(), ParseError>.Failure {error} = move valid {
    return Result<ParserCore, ParseError>.failResult(move error)
  }
  let metadata = limits.values.maxFields * RECORD_BYTES
  let required = limits.maxHeadBytes + metadata
  let storage = run exactZeroed(required)
  return Result<ParserCore, ParseError>.succeed(ParserCore {
    kind: kind,
    storage: move storage,
    limits: limits,
    length: usize.ZERO,
    lineStart: usize.ZERO,
    pendingCr: false,
    phase: Phase.StartLine,
    startPart: StartPart.First,
    componentLength: usize.ZERO,
    fieldColonSeen: false,
    fieldNameLength: usize.ZERO,
    fieldValueStarted: false,
    fieldValueLength: usize.ZERO,
    fieldPendingOws: usize.ZERO,
    lineCompletesHead: false,
    state: ParserState.Active,
    failureReason: ParseReason.InvalidState,
    failureComponent: ParseComponent.Parser,
    failureConsumed: usize.ZERO,
    failureOffset: usize.ZERO,
    failureField: usize.ZERO,
    failureHasField: false,
    fieldCount: usize.ZERO,
    fieldBytes: usize.ZERO,
    versionValue: Version.Http11,
    methodStart: usize.ZERO,
    methodLength: usize.ZERO,
    targetStart: usize.ZERO,
    targetLength: usize.ZERO,
    statusValue: 100,
    reasonStart: usize.ZERO,
    reasonLength: usize.ZERO,
  })
}

effect fn exactZeroed(length: usize) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut storage = Bytes.make()
  let _reserved = run Bytes.reserveExact(&mut storage, length)
  let zero: [u8; 1] = [0]
  let mut index = usize.ZERO
  while index < length {
    let _appended = run Bytes.append(&mut storage, &zero)
    index = index + usize.ONE
  }
  return move storage
}

fn feedCore(core: &mut ParserCore, input: &[u8], final: bool) -> Result<Progress, ParseError> {
  if core.state != ParserState.Active {
    return Result<Progress, ParseError>.failResult(stateError(core.length))
  }
  let callStart = core.length
  let mut inputIndex = usize.ZERO
  while inputIndex < input.length {
    let value = input[inputIndex]
    if core.pendingCr {
      if value != 10 {
        let offset = core.length - usize.ONE
        let field = fieldIndex(&core.*)
        let error = parseError(
          ParseReason.InvalidLineEnding,
          ParseComponent.LineEnding,
          offset,
          move field,
        )
        return poison(&mut core.*, move error, callStart)
      }
      let capacity = checkByteCapacity(&core.*)
      if let Result<(), ParseError>.Failure {error} = move capacity {
        return poison(&mut core.*, move error, callStart)
      }
      let lineLength = core.length - core.lineStart - usize.ONE
      let validated = finishLine(&mut core.*, lineLength)
      if let Result<(), ParseError>.Failure {error} = move validated {
        return poison(&mut core.*, move error, callStart)
      }
      storeByte(&mut core.*, value)
      inputIndex = inputIndex + usize.ONE
      core.pendingCr = false
      core.lineStart = core.length
      resetLineLexicalState(&mut core.*)
      if core.lineCompletesHead {
        core.lineCompletesHead = false
        core.state = ParserState.Complete
      }
      if core.state == ParserState.Complete {
        return Result<Progress, ParseError>.succeed(Progress {
          consumed: inputIndex,
          state: ProgressState.Complete,
        })
      }
      continue
    }
    if value == 10 {
      let offset = core.length
      let field = fieldIndex(&core.*)
      let error = parseError(
        ParseReason.BareLf,
        ParseComponent.LineEnding,
        offset,
        move field,
      )
      return poison(&mut core.*, move error, callStart)
    }
    let capacity = checkByteCapacity(&core.*)
    if let Result<(), ParseError>.Failure {error} = move capacity {
      return poison(&mut core.*, move error, callStart)
    }
    if value != 13 {
      let lexical = validateIncrementalByte(&mut core.*, value)
      if let Result<(), ParseError>.Failure {error} = move lexical {
        return poison(&mut core.*, move error, callStart)
      }
    }
    storeByte(&mut core.*, value)
    inputIndex = inputIndex + usize.ONE
    if value == 13 { core.pendingCr = true }
  }
  if final {
    let offset = core.length
    let field = fieldIndex(&core.*)
    let error = parseError(
      ParseReason.Truncated,
      ParseComponent.Parser,
      offset,
      move field,
    )
    return poison(&mut core.*, move error, callStart)
  }
  return Result<Progress, ParseError>.succeed(Progress {
    consumed: input.length,
    state: ProgressState.NeedInput,
  })
}

fn checkByteCapacity(core: &ParserCore) -> Result<(), ParseError> {
  let attemptedHead = match move usize.checkedAdd(core.length, usize.ONE) {
    Option<usize>.None => {
      return Result<(), ParseError>.failResult(parseError(
        ParseReason.SizeOverflow,
        ParseComponent.Parser,
        core.length,
        fieldIndex(&core.*),
      ))
    }
    Option<usize>.Some {value: admitted} => admitted
  }
  if attemptedHead > core.limits.maxHeadBytes {
    return Result<(), ParseError>.failResult(limitParseError(
      ParseLimitKind.HeadBytes,
      core.limits.maxHeadBytes,
      attemptedHead,
      ParseComponent.Parser,
      core.length,
      fieldIndex(&core.*),
    ))
  }
  let attemptedLine = attemptedHead - core.lineStart
  let lineLimit = match core.phase {
    Phase.StartLine => core.limits.maxStartLineBytes
    Phase.Fields => core.limits.maxFieldLineBytes
  }
  if attemptedLine > lineLimit {
    let kind = match core.phase {
      Phase.StartLine => ParseLimitKind.StartLineBytes
      Phase.Fields => ParseLimitKind.FieldLineBytes
    }
    let component = match core.phase {
      Phase.StartLine => ParseComponent.StartLine
      Phase.Fields => ParseComponent.HeaderValue
    }
    return Result<(), ParseError>.failResult(limitParseError(
      kind,
      lineLimit,
      attemptedLine,
      component,
      core.length,
      fieldIndex(&core.*),
    ))
  }
  return Result<(), ParseError>.succeed(())
}

fn storeByte(core: &mut ParserCore, byte: u8) -> () {
  let storage = Bytes.asMutSlice(&mut core.storage)
  storage[core.length] = byte
  core.length = core.length + usize.ONE
  return ()
}

fn resetLineLexicalState(core: &mut ParserCore) -> () {
  if core.phase == Phase.Fields {
    core.fieldColonSeen = false
    core.fieldNameLength = usize.ZERO
    core.fieldValueStarted = false
    core.fieldValueLength = usize.ZERO
    core.fieldPendingOws = usize.ZERO
  }
  return ()
}

fn validateIncrementalByte(core: &mut ParserCore, byte: u8) -> Result<(), ParseError> {
  return match core.phase {
    Phase.StartLine => validateStartLineByte(&mut core.*, byte)
    Phase.Fields => validateFieldByte(&mut core.*, byte)
  }
}

fn validateStartLineByte(core: &mut ParserCore, byte: u8) -> Result<(), ParseError> {
  return match core.kind {
    HeadKind.Request => validateRequestLineByte(&mut core.*, byte)
    HeadKind.Response => validateResponseLineByte(&mut core.*, byte)
  }
}

fn validateRequestLineByte(core: &mut ParserCore, byte: u8) -> Result<(), ParseError> {
  return match core.startPart {
    StartPart.First => {
      if byte == 32 {
        if core.componentLength == usize.ZERO {
          return Result<(), ParseError>.failResult(parseError(
            ParseReason.InvalidStartLine,
            ParseComponent.StartLine,
            core.length,
            Option<usize>.none(),
          ))
        }
        core.startPart = StartPart.Second
        core.componentLength = usize.ZERO
        return Result<(), ParseError>.succeed(())
      }
      if !tokenByte(byte) {
        return Result<(), ParseError>.failResult(parseError(
          ParseReason.InvalidMethod,
          ParseComponent.Method,
          core.length,
          Option<usize>.none(),
        ))
      }
      let attempted = core.componentLength + usize.ONE
      if attempted > core.limits.values.maxMethodBytes {
        return Result<(), ParseError>.failResult(limitParseError(
          ParseLimitKind.MethodBytes,
          core.limits.values.maxMethodBytes,
          attempted,
          ParseComponent.Method,
          core.length,
          Option<usize>.none(),
        ))
      }
      core.componentLength = attempted
      return Result<(), ParseError>.succeed(())
    }
    StartPart.Second => {
      if byte == 32 {
        if core.componentLength == usize.ZERO {
          return Result<(), ParseError>.failResult(parseError(
            ParseReason.InvalidStartLine,
            ParseComponent.Target,
            core.length,
            Option<usize>.none(),
          ))
        }
        core.startPart = StartPart.Third
        core.componentLength = usize.ZERO
        return Result<(), ParseError>.succeed(())
      }
      if byte < 33 || byte > 126 {
        return Result<(), ParseError>.failResult(parseError(
          ParseReason.InvalidTarget,
          ParseComponent.Target,
          core.length,
          Option<usize>.none(),
        ))
      }
      let attempted = core.componentLength + usize.ONE
      if attempted > core.limits.values.maxTargetBytes {
        return Result<(), ParseError>.failResult(limitParseError(
          ParseLimitKind.TargetBytes,
          core.limits.values.maxTargetBytes,
          attempted,
          ParseComponent.Target,
          core.length,
          Option<usize>.none(),
        ))
      }
      core.componentLength = attempted
      return Result<(), ParseError>.succeed(())
    }
    StartPart.Third => {
      if core.componentLength >= 8 {
        return Result<(), ParseError>.failResult(parseError(
          ParseReason.InvalidStartLine,
          ParseComponent.StartLine,
          core.length,
          Option<usize>.none(),
        ))
      }
      if !versionByte(core.componentLength, byte) {
        return Result<(), ParseError>.failResult(parseError(
          ParseReason.UnsupportedVersion,
          ParseComponent.Version,
          core.length,
          Option<usize>.none(),
        ))
      }
      core.componentLength = core.componentLength + usize.ONE
      return Result<(), ParseError>.succeed(())
    }
  }
}

fn validateResponseLineByte(core: &mut ParserCore, byte: u8) -> Result<(), ParseError> {
  return match core.startPart {
    StartPart.First => {
      if core.componentLength < 8 {
        if !versionByte(core.componentLength, byte) {
          return Result<(), ParseError>.failResult(parseError(
            ParseReason.UnsupportedVersion,
            ParseComponent.Version,
            core.length,
            Option<usize>.none(),
          ))
        }
        core.componentLength = core.componentLength + usize.ONE
        return Result<(), ParseError>.succeed(())
      }
      if byte != 32 {
        return Result<(), ParseError>.failResult(parseError(
          ParseReason.InvalidStartLine,
          ParseComponent.StartLine,
          core.length,
          Option<usize>.none(),
        ))
      }
      core.startPart = StartPart.Second
      core.componentLength = usize.ZERO
      return Result<(), ParseError>.succeed(())
    }
    StartPart.Second => {
      if core.componentLength < 3 {
        if byte < 48 || byte > 57 {
          return Result<(), ParseError>.failResult(parseError(
            ParseReason.InvalidStatus,
            ParseComponent.Status,
            core.length,
            Option<usize>.none(),
          ))
        }
        if core.componentLength == 2 {
          let bytes = Bytes.asSlice(&core.storage)
          let first = u8.toU16(bytes[core.length - 2])
          let second = u8.toU16(bytes[core.length - usize.ONE])
          let status = (first - 48) * 100 + (second - 48) * 10 + (u8.toU16(byte) - 48)
          if status < 100 || status > 599 {
            return Result<(), ParseError>.failResult(parseError(
              ParseReason.InvalidStatus,
              ParseComponent.Status,
              core.length - 2,
              Option<usize>.none(),
            ))
          }
        }
        core.componentLength = core.componentLength + usize.ONE
        return Result<(), ParseError>.succeed(())
      }
      if byte != 32 {
        return Result<(), ParseError>.failResult(parseError(
          ParseReason.InvalidStartLine,
          ParseComponent.StartLine,
          core.length,
          Option<usize>.none(),
        ))
      }
      core.startPart = StartPart.Third
      core.componentLength = usize.ZERO
      return Result<(), ParseError>.succeed(())
    }
    StartPart.Third => {
      if byte != 9 && (byte < 32 || byte == 127) {
        return Result<(), ParseError>.failResult(parseError(
          ParseReason.InvalidReasonPhrase,
          ParseComponent.ReasonPhrase,
          core.length,
          Option<usize>.none(),
        ))
      }
      let attempted = core.componentLength + usize.ONE
      if attempted > core.limits.values.maxValueBytes {
        return Result<(), ParseError>.failResult(limitParseError(
          ParseLimitKind.ValueBytes,
          core.limits.values.maxValueBytes,
          attempted,
          ParseComponent.ReasonPhrase,
          core.length,
          Option<usize>.none(),
        ))
      }
      core.componentLength = attempted
      return Result<(), ParseError>.succeed(())
    }
  }
}

fn validateFieldByte(core: &mut ParserCore, byte: u8) -> Result<(), ParseError> {
  if !core.fieldColonSeen {
    if core.fieldNameLength == usize.ZERO {
      if (byte == 32 || byte == 9) && foldAllowed(&core.*) {
        // A folded continuation of the previous response field: the rest of the line is value
        // bytes, and `foldContinuation` joins it when the line ends.
        core.fieldColonSeen = true
        return Result<(), ParseError>.succeed(())
      }
      let attemptedFields = core.fieldCount + usize.ONE
      if attemptedFields > core.limits.values.maxFields {
        return Result<(), ParseError>.failResult(limitParseError(
          ParseLimitKind.Fields,
          core.limits.values.maxFields,
          attemptedFields,
          ParseComponent.HeaderName,
          core.length,
          Option<usize>.some(core.fieldCount),
        ))
      }
      if byte == 32 || byte == 9 {
        return Result<(), ParseError>.failResult(parseError(
          ParseReason.ObsFold,
          ParseComponent.HeaderName,
          core.length,
          Option<usize>.some(core.fieldCount),
        ))
      }
    }
    if byte == 58 {
      if core.fieldNameLength == usize.ZERO {
        return Result<(), ParseError>.failResult(parseError(
          ParseReason.InvalidFieldName,
          ParseComponent.HeaderName,
          core.length,
          Option<usize>.some(core.fieldCount),
        ))
      }
      core.fieldColonSeen = true
      return Result<(), ParseError>.succeed(())
    }
    if byte == 32 || byte == 9 {
      return Result<(), ParseError>.failResult(parseError(
        ParseReason.WhitespaceBeforeColon,
        ParseComponent.HeaderName,
        core.length,
        Option<usize>.some(core.fieldCount),
      ))
    }
    if !tokenByte(byte) {
      return Result<(), ParseError>.failResult(parseError(
        ParseReason.InvalidFieldName,
        ParseComponent.HeaderName,
        core.length,
        Option<usize>.some(core.fieldCount),
      ))
    }
    let attemptedName = core.fieldNameLength + usize.ONE
    if attemptedName > core.limits.values.maxNameBytes {
      return Result<(), ParseError>.failResult(limitParseError(
        ParseLimitKind.NameBytes,
        core.limits.values.maxNameBytes,
        attemptedName,
        ParseComponent.HeaderName,
        core.length,
        Option<usize>.some(core.fieldCount),
      ))
    }
    let aggregate = match move usize.checkedAdd(core.fieldBytes, attemptedName) {
      Option<usize>.None => {
        return Result<(), ParseError>.failResult(parseError(
          ParseReason.SizeOverflow,
          ParseComponent.HeaderName,
          core.length,
          Option<usize>.some(core.fieldCount),
        ))
      }
      Option<usize>.Some {value} => value
    }
    if aggregate > core.limits.values.maxFieldBytes {
      return Result<(), ParseError>.failResult(limitParseError(
        ParseLimitKind.FieldBytes,
        core.limits.values.maxFieldBytes,
        aggregate,
        ParseComponent.HeaderName,
        core.length,
        Option<usize>.some(core.fieldCount),
      ))
    }
    core.fieldNameLength = attemptedName
    return Result<(), ParseError>.succeed(())
  }
  if byte != 9 && (byte < 32 || byte == 127) {
    return Result<(), ParseError>.failResult(parseError(
      ParseReason.InvalidFieldValue,
      ParseComponent.HeaderValue,
      core.length,
      Option<usize>.some(core.fieldCount),
    ))
  }
  if byte == 32 || byte == 9 {
    if core.fieldValueStarted { core.fieldPendingOws = core.fieldPendingOws + usize.ONE }
    return Result<(), ParseError>.succeed(())
  }
  let withPending = match move usize.checkedAdd(core.fieldValueLength, core.fieldPendingOws) {
    Option<usize>.None => {
      return Result<(), ParseError>.failResult(parseError(
        ParseReason.SizeOverflow,
        ParseComponent.HeaderValue,
        core.length,
        Option<usize>.some(core.fieldCount),
      ))
    }
    Option<usize>.Some {value} => value
  }
  let attemptedValue = match move usize.checkedAdd(withPending, usize.ONE) {
    Option<usize>.None => {
      return Result<(), ParseError>.failResult(parseError(
        ParseReason.SizeOverflow,
        ParseComponent.HeaderValue,
        core.length,
        Option<usize>.some(core.fieldCount),
      ))
    }
    Option<usize>.Some {value} => value
  }
  if attemptedValue > core.limits.values.maxValueBytes {
    return Result<(), ParseError>.failResult(limitParseError(
      ParseLimitKind.ValueBytes,
      core.limits.values.maxValueBytes,
      attemptedValue,
      ParseComponent.HeaderValue,
      core.length,
      Option<usize>.some(core.fieldCount),
    ))
  }
  let nameAndValue = match move usize.checkedAdd(core.fieldNameLength, attemptedValue) {
    Option<usize>.None => {
      return Result<(), ParseError>.failResult(parseError(
        ParseReason.SizeOverflow,
        ParseComponent.HeaderValue,
        core.length,
        Option<usize>.some(core.fieldCount),
      ))
    }
    Option<usize>.Some {value} => value
  }
  let aggregate = match move usize.checkedAdd(core.fieldBytes, nameAndValue) {
    Option<usize>.None => {
      return Result<(), ParseError>.failResult(parseError(
        ParseReason.SizeOverflow,
        ParseComponent.HeaderValue,
        core.length,
        Option<usize>.some(core.fieldCount),
      ))
    }
    Option<usize>.Some {value} => value
  }
  if aggregate > core.limits.values.maxFieldBytes {
    return Result<(), ParseError>.failResult(limitParseError(
      ParseLimitKind.FieldBytes,
      core.limits.values.maxFieldBytes,
      aggregate,
      ParseComponent.HeaderValue,
      core.length,
      Option<usize>.some(core.fieldCount),
    ))
  }
  core.fieldValueStarted = true
  core.fieldValueLength = attemptedValue
  core.fieldPendingOws = usize.ZERO
  return Result<(), ParseError>.succeed(())
}

fn versionByte(index: usize, byte: u8) -> bool {
  if index == usize.ZERO { return byte == 72 }
  if index == usize.ONE { return byte == 84 }
  if index == 2 { return byte == 84 }
  if index == 3 { return byte == 80 }
  if index == 4 { return byte == 47 }
  if index == 5 { return byte == 49 }
  if index == 6 { return byte == 46 }
  if index == 7 { return byte == 48 || byte == 49 }
  return false
}

fn finishLine(core: &mut ParserCore, lineLength: usize) -> Result<(), ParseError> {
  return match core.phase {
    Phase.StartLine => {
      if lineLength == usize.ZERO {
        return Result<(), ParseError>.failResult(parseError(
          ParseReason.InvalidStartLine,
          ParseComponent.StartLine,
          core.lineStart,
          Option<usize>.none(),
        ))
      }
      let result = match core.kind {
        HeadKind.Request => validateRequestLine(&mut core.*, lineLength)
        HeadKind.Response => validateResponseLine(&mut core.*, lineLength)
      }
      return match move result {
        Result<(), ParseError>.Failure {error} => {
          return Result<(), ParseError>.failResult(move error)
        }
        Result<(), ParseError>.Success {..} => {
          core.phase = Phase.Fields
          return Result<(), ParseError>.succeed(())
        }
      }
    }
    Phase.Fields => {
      if lineLength == usize.ZERO {
        if core.kind == HeadKind.Request {
          let validHost = validateHost(&core.*)
          if let Result<(), ParseError>.Failure {error} = move validHost {
            return Result<(), ParseError>.failResult(move error)
          }
        }
        core.lineCompletesHead = true
        return Result<(), ParseError>.succeed(())
      }
      let first = headBytes(&core.*)[core.lineStart]
      if (first == 32 || first == 9) && foldAllowed(&core.*) {
        return foldContinuation(&mut core.*, lineLength)
      }
      return validateFieldLine(&mut core.*, lineLength)
    }
  }
}

fn validateRequestLine(core: &mut ParserCore, length: usize) -> Result<(), ParseError> {
  let bytes = headBytes(&core.*)
  let start = core.lineStart
  let end = start + length
  let mut firstSpace = usize.MAX
  let mut secondSpace = usize.MAX
  let mut index = start
  while index < end {
    if bytes[index] == 32 {
      if firstSpace == usize.MAX { firstSpace = index }
      else if secondSpace == usize.MAX { secondSpace = index }
      else {
        return Result<(), ParseError>.failResult(parseError(
          ParseReason.InvalidStartLine,
          ParseComponent.StartLine,
          index,
          Option<usize>.none(),
        ))
      }
    }
    index = index + usize.ONE
  }
  if firstSpace == usize.MAX || secondSpace == usize.MAX || firstSpace == start
    || secondSpace == firstSpace + usize.ONE || secondSpace + usize.ONE >= end {
    let mut offset = end
    if firstSpace != usize.MAX && secondSpace != usize.MAX { offset = secondSpace }
    return Result<(), ParseError>.failResult(parseError(
      ParseReason.InvalidStartLine,
      ParseComponent.StartLine,
      offset,
      Option<usize>.none(),
    ))
  }
  let methodLength = firstSpace - start
  let targetStart = firstSpace + usize.ONE
  let targetLength = secondSpace - targetStart
  let versionStart = secondSpace + usize.ONE
  let versionLength = end - versionStart
  index = start
  while index < firstSpace {
    if !tokenByte(bytes[index]) {
      return Result<(), ParseError>.failResult(parseError(
        ParseReason.InvalidMethod,
        ParseComponent.Method,
        index,
        Option<usize>.none(),
      ))
    }
    index = index + usize.ONE
  }
  if methodLength > core.limits.values.maxMethodBytes {
    return Result<(), ParseError>.failResult(limitParseError(
      ParseLimitKind.MethodBytes,
      core.limits.values.maxMethodBytes,
      methodLength,
      ParseComponent.Method,
      start,
      Option<usize>.none(),
    ))
  }
  index = targetStart
  while index < secondSpace {
    let byte = bytes[index]
    if byte < 33 || byte > 126 {
      return Result<(), ParseError>.failResult(parseError(
        ParseReason.InvalidTarget,
        ParseComponent.Target,
        index,
        Option<usize>.none(),
      ))
    }
    index = index + usize.ONE
  }
  if targetLength > core.limits.values.maxTargetBytes {
    return Result<(), ParseError>.failResult(limitParseError(
      ParseLimitKind.TargetBytes,
      core.limits.values.maxTargetBytes,
      targetLength,
      ParseComponent.Target,
      targetStart,
      Option<usize>.none(),
    ))
  }
  let version = parseVersion(range(bytes, versionStart, versionLength), versionStart)
  let parsedVersion = match move version {
    Result<Version, ParseError>.Failure {error} => {
      return Result<(), ParseError>.failResult(move error)
    }
    Result<Version, ParseError>.Success {value} => value
  }
  let validValues = validateRequestValues(
    bytes,
    start,
    methodLength,
    targetStart,
    targetLength,
    core.limits.values,
  )
  if let Result<(), ParseError>.Failure {error} = move validValues {
    return Result<(), ParseError>.failResult(move error)
  }
  core.versionValue = parsedVersion
  core.methodStart = start
  core.methodLength = methodLength
  core.targetStart = targetStart
  core.targetLength = targetLength
  return Result<(), ParseError>.succeed(())
}

fn validateRequestValues<'value>(
  bytes: &'value [u8],
  methodStart: usize,
  methodLength: usize,
  targetStart: usize,
  targetLength: usize,
  limits: ValueLimits,
) -> Result<(), ParseError> {
  let methodText = asciiText(range(bytes, methodStart, methodLength))
  let method = match move Method.parse(methodText, limits.maxMethodBytes) {
    Result<Method<'value>, ValueError>.Failure {error} => {
      return Result<(), ParseError>.failResult(translateValueError(
        move error,
        ParseReason.InvalidMethod,
        ParseComponent.Method,
        methodStart,
        Option<usize>.none(),
      ))
    }
    Result<Method<'value>, ValueError>.Success {value} => value
  }
  let targetText = asciiText(range(bytes, targetStart, targetLength))
  let parsedTarget = RequestTarget.parse(&method, targetText, limits.maxTargetBytes)
  if let Result<RequestTarget<'value>, ValueError>.Failure {error} = move parsedTarget {
    return Result<(), ParseError>.failResult(translateValueError(
      move error,
      ParseReason.InvalidTarget,
      ParseComponent.Target,
      targetStart,
      Option<usize>.none(),
    ))
  }
  return Result<(), ParseError>.succeed(())
}

fn validateResponseLine(core: &mut ParserCore, length: usize) -> Result<(), ParseError> {
  let bytes = headBytes(&core.*)
  let start = core.lineStart
  let end = start + length
  // `HTTP/1.1 200` with no space before an empty reason phrase is accepted, as curl and browsers
  // accept it.
  if length < 12 {
    return Result<(), ParseError>.failResult(parseError(
      ParseReason.InvalidStartLine,
      ParseComponent.StartLine,
      end,
      Option<usize>.none(),
    ))
  }
  let version = parseVersion(range(bytes, start, 8), start)
  let parsedVersion = match move version {
    Result<Version, ParseError>.Failure {error} => {
      return Result<(), ParseError>.failResult(move error)
    }
    Result<Version, ParseError>.Success {value} => value
  }
  if bytes[start + 8] != 32 {
    return Result<(), ParseError>.failResult(parseError(
      ParseReason.InvalidStartLine,
      ParseComponent.StartLine,
      start + 8,
      Option<usize>.none(),
    ))
  }
  let mut digitIndex = usize.ZERO
  while digitIndex < 3 {
    let offset = start + 9 + digitIndex
    if bytes[offset] < 48 || bytes[offset] > 57 {
      return Result<(), ParseError>.failResult(parseError(
        ParseReason.InvalidStatus,
        ParseComponent.Status,
        offset,
        Option<usize>.none(),
      ))
    }
    digitIndex = digitIndex + usize.ONE
  }
  if length > 12 && bytes[start + 12] != 32 {
    return Result<(), ParseError>.failResult(parseError(
      ParseReason.InvalidStartLine,
      ParseComponent.StartLine,
      start + 12,
      Option<usize>.none(),
    ))
  }
  let status = u8.toU16(bytes[start + 9]) * 100
    + u8.toU16(bytes[start + 10]) * 10
    + u8.toU16(bytes[start + 11])
    - 5328
  if status < 100 || status > 599 {
    return Result<(), ParseError>.failResult(parseError(
      ParseReason.InvalidStatus,
      ParseComponent.Status,
      start + 9,
      Option<usize>.none(),
    ))
  }
  let mut reasonStart = end
  if length > 12 { reasonStart = start + 13 }
  let reasonLength = end - reasonStart
  if reasonLength > core.limits.values.maxValueBytes {
    return Result<(), ParseError>.failResult(limitParseError(
      ParseLimitKind.ValueBytes,
      core.limits.values.maxValueBytes,
      reasonLength,
      ParseComponent.ReasonPhrase,
      reasonStart,
      Option<usize>.none(),
    ))
  }
  let mut index = reasonStart
  while index < end {
    let byte = bytes[index]
    if byte != 9 && (byte < 32 || byte == 127) {
      return Result<(), ParseError>.failResult(parseError(
        ParseReason.InvalidReasonPhrase,
        ParseComponent.ReasonPhrase,
        index,
        Option<usize>.none(),
      ))
    }
    index = index + usize.ONE
  }
  let statusValue = match move Status.fromCode(status) {
    Result<Status, ValueError>.Failure {..} => {
      return Result<(), ParseError>.failResult(parseError(
        ParseReason.InvalidStatus,
        ParseComponent.Status,
        start + 9,
        Option<usize>.none(),
      ))
    }
    Result<Status, ValueError>.Success {value} => Status.code(&value)
  }
  core.versionValue = parsedVersion
  core.statusValue = statusValue
  core.reasonStart = reasonStart
  core.reasonLength = reasonLength
  return Result<(), ParseError>.succeed(())
}

fn validateFieldLine(core: &mut ParserCore, length: usize) -> Result<(), ParseError> {
  let bytes = headBytes(&core.*)
  let start = core.lineStart
  let end = start + length
  if bytes[start] == 32 || bytes[start] == 9 {
    return Result<(), ParseError>.failResult(parseError(
      ParseReason.ObsFold,
      ParseComponent.HeaderName,
      start,
      Option<usize>.some(core.fieldCount),
    ))
  }
  let mut colon = usize.MAX
  let mut index = start
  while index < end {
    let byte = bytes[index]
    if byte == 58 {
      colon = index
      break
    }
    if byte == 32 || byte == 9 {
      return Result<(), ParseError>.failResult(parseError(
        ParseReason.WhitespaceBeforeColon,
        ParseComponent.HeaderName,
        index,
        Option<usize>.some(core.fieldCount),
      ))
    }
    if !tokenByte(byte) {
      return Result<(), ParseError>.failResult(parseError(
        ParseReason.InvalidFieldName,
        ParseComponent.HeaderName,
        index,
        Option<usize>.some(core.fieldCount),
      ))
    }
    index = index + usize.ONE
  }
  if colon == usize.MAX || colon == start {
    return Result<(), ParseError>.failResult(parseError(
      ParseReason.InvalidFieldName,
      ParseComponent.HeaderName,
      fieldNameFailureOffset(colon, start, end),
      Option<usize>.some(core.fieldCount),
    ))
  }
  let attemptedFields = match move usize.checkedAdd(core.fieldCount, usize.ONE) {
    Option<usize>.None => {
      return Result<(), ParseError>.failResult(parseError(
        ParseReason.SizeOverflow,
        ParseComponent.HeaderName,
        start,
        Option<usize>.some(core.fieldCount),
      ))
    }
    Option<usize>.Some {value} => value
  }
  if attemptedFields > core.limits.values.maxFields {
    return Result<(), ParseError>.failResult(limitParseError(
      ParseLimitKind.Fields,
      core.limits.values.maxFields,
      attemptedFields,
      ParseComponent.HeaderName,
      start,
      Option<usize>.some(core.fieldCount),
    ))
  }
  let nameLength = colon - start
  if nameLength > core.limits.values.maxNameBytes {
    return Result<(), ParseError>.failResult(limitParseError(
      ParseLimitKind.NameBytes,
      core.limits.values.maxNameBytes,
      nameLength,
      ParseComponent.HeaderName,
      start,
      Option<usize>.some(core.fieldCount),
    ))
  }
  let mut valueStart = colon + usize.ONE
  while valueStart < end && (bytes[valueStart] == 32 || bytes[valueStart] == 9) {
    valueStart = valueStart + usize.ONE
  }
  let mut valueEnd = end
  while valueEnd > valueStart && (bytes[valueEnd - usize.ONE] == 32 || bytes[valueEnd - usize.ONE] == 9) {
    valueEnd = valueEnd - usize.ONE
  }
  let valueLength = valueEnd - valueStart
  if valueLength > core.limits.values.maxValueBytes {
    return Result<(), ParseError>.failResult(limitParseError(
      ParseLimitKind.ValueBytes,
      core.limits.values.maxValueBytes,
      valueLength,
      ParseComponent.HeaderValue,
      valueStart,
      Option<usize>.some(core.fieldCount),
    ))
  }
  let validValue = validateFieldValue(
    bytes,
    start,
    nameLength,
    valueStart,
    valueLength,
    core.fieldCount,
    core.limits.values,
  )
  if let Result<(), ParseError>.Failure {error} = move validValue {
    return Result<(), ParseError>.failResult(move error)
  }
  let fieldSize = match move usize.checkedAdd(nameLength, valueLength) {
    Option<usize>.None => {
      return Result<(), ParseError>.failResult(parseError(
        ParseReason.SizeOverflow,
        ParseComponent.HeaderValue,
        valueStart,
        Option<usize>.some(core.fieldCount),
      ))
    }
    Option<usize>.Some {value: summed} => summed
  }
  let aggregate = match move usize.checkedAdd(core.fieldBytes, fieldSize) {
    Option<usize>.None => {
      return Result<(), ParseError>.failResult(parseError(
        ParseReason.SizeOverflow,
        ParseComponent.HeaderValue,
        valueStart,
        Option<usize>.some(core.fieldCount),
      ))
    }
    Option<usize>.Some {value: summed} => summed
  }
  if aggregate > core.limits.values.maxFieldBytes {
    return Result<(), ParseError>.failResult(limitParseError(
      ParseLimitKind.FieldBytes,
      core.limits.values.maxFieldBytes,
      aggregate,
      ParseComponent.HeaderValue,
      valueStart,
      Option<usize>.some(core.fieldCount),
    ))
  }
  let fieldIndex = core.fieldCount
  writeRecord(&mut core.*, fieldIndex, FieldRecord {
    nameStart: start,
    nameLength: nameLength,
    valueStart: valueStart,
    valueLength: valueLength,
  })
  core.fieldCount = attemptedFields
  core.fieldBytes = aggregate
  return Result<(), ParseError>.succeed(())
}

// RFC 9112 section 5.2: a client must accept obs-fold in a response and replace it with spaces
// before reading the value. A request, or a fold before the first field, still fails `ObsFold`.
fn foldAllowed(core: &ParserCore) -> bool {
  return core.kind == HeadKind.Response && core.fieldCount > usize.ZERO
}

// Joins a folded line onto the previous field. Field lines are stored back to back, so the bytes
// from the end of the previous value to the start of this line's text (the CRLF and the leading
// whitespace) are overwritten with spaces, and the previous record grows to cover this line.
fn foldContinuation(core: &mut ParserCore, length: usize) -> Result<(), ParseError> {
  let index = core.fieldCount - usize.ONE
  let record = readRecord(recordBytes(&core.*), index)
  let start = core.lineStart
  let end = start + length
  let mut textStart = start
  let mut textEnd = end
  let mut storage = Bytes.asMutSlice(&mut core.storage)
  while textStart < end && (storage[textStart] == 32 || storage[textStart] == 9) {
    textStart = textStart + usize.ONE
  }
  while textEnd > textStart && (storage[textEnd - usize.ONE] == 32 || storage[textEnd - usize.ONE] == 9) {
    textEnd = textEnd - usize.ONE
  }
  if textStart == textEnd { return Result<(), ParseError>.succeed(()) }
  let mut valueStart = record.valueStart
  if record.valueLength == usize.ZERO {
    valueStart = textStart
  } else {
    let mut cursor = record.valueStart + record.valueLength
    while cursor < textStart {
      storage[cursor] = 32
      cursor = cursor + usize.ONE
    }
  }
  let valueLength = textEnd - valueStart
  if valueLength > core.limits.values.maxValueBytes {
    return Result<(), ParseError>.failResult(limitParseError(
      ParseLimitKind.ValueBytes,
      core.limits.values.maxValueBytes,
      valueLength,
      ParseComponent.HeaderValue,
      valueStart,
      Option<usize>.some(index),
    ))
  }
  let aggregate = core.fieldBytes - record.valueLength + valueLength
  if aggregate > core.limits.values.maxFieldBytes {
    return Result<(), ParseError>.failResult(limitParseError(
      ParseLimitKind.FieldBytes,
      core.limits.values.maxFieldBytes,
      aggregate,
      ParseComponent.HeaderValue,
      valueStart,
      Option<usize>.some(index),
    ))
  }
  let validValue = validateFieldValue(
    headBytes(&core.*),
    record.nameStart,
    record.nameLength,
    valueStart,
    valueLength,
    index,
    core.limits.values,
  )
  if let Result<(), ParseError>.Failure {error} = move validValue {
    return Result<(), ParseError>.failResult(move error)
  }
  writeRecord(&mut core.*, index, FieldRecord {
    nameStart: record.nameStart,
    nameLength: record.nameLength,
    valueStart: valueStart,
    valueLength: valueLength,
  })
  core.fieldBytes = aggregate
  return Result<(), ParseError>.succeed(())
}

fn validateFieldValue<'value>(
  bytes: &'value [u8],
  nameStart: usize,
  nameLength: usize,
  valueStart: usize,
  valueLength: usize,
  fieldIndex: usize,
  limits: ValueLimits,
) -> Result<(), ParseError> {
  let name = asciiText(range(bytes, nameStart, nameLength))
  let fieldValue = range(bytes, valueStart, valueLength)
  let made = Header.make(name, fieldValue, limits)
  if let Result<Header<'value>, ValueError>.Failure {error} = move made {
    let mut fallback = ParseReason.InvalidFieldValue
    let mut component = ParseComponent.HeaderValue
    let mut base = valueStart
    if error.component == ValueComponent.HeaderName {
      fallback = ParseReason.InvalidFieldName
      component = ParseComponent.HeaderName
      base = nameStart
    }
    return Result<(), ParseError>.failResult(translateValueError(
      move error,
      fallback,
      component,
      base,
      Option<usize>.some(fieldIndex),
    ))
  }
  return Result<(), ParseError>.succeed(())
}

fn validateHost<'value>(core: &'value ParserCore) -> Result<(), ParseError> {
  let bytes = headBytes(core)
  let records = recordBytes(core)
  let mut count = usize.ZERO
  let mut index = usize.ZERO
  while index < core.fieldCount {
    let record = readRecord(records, index)
    if isHostName(range(bytes, record.nameStart, record.nameLength)) {
      count = count + usize.ONE
      if count > usize.ONE {
        return Result<(), ParseError>.failResult(parseError(
          ParseReason.DuplicateHost,
          ParseComponent.Host,
          record.nameStart,
          Option<usize>.some(index),
        ))
      }
      let value = range(bytes, record.valueStart, record.valueLength)
      let mut offset = usize.ZERO
      while offset < value.length {
        let byte = value[offset]
        if byte < 33 || byte > 126 || byte == 64 {
          return Result<(), ParseError>.failResult(parseError(
            ParseReason.InvalidHost,
            ParseComponent.Host,
            record.valueStart + offset,
            Option<usize>.some(index),
          ))
        }
        offset = offset + usize.ONE
      }
      let parsed = HttpAuthority.parse(asciiText(value))
      if let Result<HttpAuthority<'value>, ValueError>.Failure {error} = move parsed {
        return Result<(), ParseError>.failResult(parseError(
          ParseReason.InvalidHost,
          ParseComponent.Host,
          record.valueStart + error.offset,
          Option<usize>.some(index),
        ))
      }
    }
    index = index + usize.ONE
  }
  if count == usize.ZERO && core.versionValue == Version.Http11 {
    return Result<(), ParseError>.failResult(parseError(
      ParseReason.MissingHost,
      ParseComponent.Host,
      core.lineStart,
      Option<usize>.none(),
    ))
  }
  return Result<(), ParseError>.succeed(())
}

fn parseVersion(bytes: &[u8], start: usize) -> Result<Version, ParseError> {
  if bytes.length != 8 {
    return Result<Version, ParseError>.failResult(parseError(
      ParseReason.UnsupportedVersion,
      ParseComponent.Version,
      start,
      Option<usize>.none(),
    ))
  }
  let expected: [u8; 7] = [72,84,84,80,47,49,46]
  let mut index = usize.ZERO
  while index < 7 {
    if bytes[index] != expected[index] {
      return Result<Version, ParseError>.failResult(parseError(
        ParseReason.UnsupportedVersion,
        ParseComponent.Version,
        start + index,
        Option<usize>.none(),
      ))
    }
    index = index + usize.ONE
  }
  if bytes[7] == 48 { return Result<Version, ParseError>.succeed(Version.Http10) }
  if bytes[7] == 49 { return Result<Version, ParseError>.succeed(Version.Http11) }
  return Result<Version, ParseError>.failResult(parseError(
    ParseReason.UnsupportedVersion,
    ParseComponent.Version,
    start + 7,
    Option<usize>.none(),
  ))
}

struct FieldRecord {
  nameStart: usize,
  nameLength: usize,
  valueStart: usize,
  valueLength: usize,
}

impl Copy for FieldRecord {}

fn headBytes(core: &ParserCore) -> &[u8] {
  return Slice.view<u8>(Bytes.asSlice(&core.storage), usize.ZERO, core.length)
}

fn recordBytes(core: &ParserCore) -> &[u8] {
  return Slice.view<u8>(
    Bytes.asSlice(&core.storage),
    core.limits.maxHeadBytes,
    core.fieldCount * RECORD_BYTES,
  )
}

fn writeRecord(core: &mut ParserCore, index: usize, record: FieldRecord) -> () {
  let base = core.limits.maxHeadBytes + index * RECORD_BYTES
  let mut storage = Bytes.asMutSlice(&mut core.storage)
  writeUsize(&mut storage, base, record.nameStart)
  writeUsize(&mut storage, base + 8, record.nameLength)
  writeUsize(&mut storage, base + 16, record.valueStart)
  writeUsize(&mut storage, base + 24, record.valueLength)
  return ()
}

fn readRecord(records: &[u8], index: usize) -> FieldRecord {
  let base = index * RECORD_BYTES
  return FieldRecord {
    nameStart: readUsize(records, base),
    nameLength: readUsize(records, base + 8),
    valueStart: readUsize(records, base + 16),
    valueLength: readUsize(records, base + 24),
  }
}

fn writeUsize(output: &mut [u8], offset: usize, value: usize) -> () {
  let wide = usize.toU64(value)
  let mut index = usize.ZERO
  while index < 8 {
    output[offset + index] = u64.toU8(u64.bitAnd(u64.shiftRight(wide, usize.toU64(index * 8)), 255))
    index = index + usize.ONE
  }
  return ()
}

fn readUsize(input: &[u8], offset: usize) -> usize {
  let mut value: u64 = 0
  let mut index = usize.ZERO
  while index < 8 {
    let byte = u8.toU64(input[offset + index])
    value = u64.bitOr(value, u64.shiftLeft(byte, usize.toU64(index * 8)))
    index = index + usize.ONE
  }
  return u64.toUsize(value)
}

fn range<'value>(bytes: &'value [u8], start: usize, length: usize) -> &'value [u8] {
  return Slice.view<u8>(bytes, start, length)
}

fn asciiText<'value>(bytes: &'value [u8]) -> string<'value> {
  unsafe { return String.fromUtf8Unchecked(bytes) }
}

fn tokenByte(value: u8) -> bool {
  if value >= 65 && value <= 90 { return true }
  if value >= 97 && value <= 122 { return true }
  if value >= 48 && value <= 57 { return true }
  return value == 33 || value == 35 || value == 36 || value == 37 || value == 38
    || value == 39 || value == 42 || value == 43 || value == 45 || value == 46
    || value == 94 || value == 95 || value == 96 || value == 124 || value == 126
}

fn isHostName(name: &[u8]) -> bool {
  if name.length != 4 { return false }
  return asciiLower(name[0]) == 104
    && asciiLower(name[1]) == 111
    && asciiLower(name[2]) == 115
    && asciiLower(name[3]) == 116
}

fn fieldNameFailureOffset(colon: usize, start: usize, end: usize) -> usize {
  if colon == start { return start }
  return end
}

fn asciiLower(value: u8) -> u8 {
  if value >= 65 && value <= 90 { return value + 32 }
  return value
}

fn asciiEqual<'left, 'right>(left: string<'left>, right: string<'right>) -> bool {
  let leftBytes = String.utf8Bytes(left)
  let rightBytes = String.utf8Bytes(right)
  if leftBytes.length != rightBytes.length { return false }
  let mut index = usize.ZERO
  while index < leftBytes.length {
    if asciiLower(leftBytes[index]) != asciiLower(rightBytes[index]) { return false }
    index = index + usize.ONE
  }
  return true
}

fn fieldIndex(core: &ParserCore) -> Option<usize> {
  return match core.phase {
    Phase.StartLine => Option<usize>.none()
    Phase.Fields => Option<usize>.some(core.fieldCount)
  }
}

fn parseError(
  reason: ParseReason,
  component: ParseComponent,
  offset: usize,
  field: Option<usize>,
) -> ParseError {
  return ParseError {
    reason: reason,
    component: component,
    consumed: usize.ZERO,
    offset: offset,
    fieldIndex: move field,
  }
}

fn limitParseError(
  limit: ParseLimitKind,
  allowed: usize,
  attempted: usize,
  component: ParseComponent,
  offset: usize,
  field: Option<usize>,
) -> ParseError {
  return parseError(
    ParseReason.LimitExceeded {limit: limit, allowed: allowed, attempted: attempted},
    component,
    offset,
    move field,
  )
}

fn stateError(offset: usize) -> ParseError {
  return parseError(
    ParseReason.InvalidState,
    ParseComponent.Parser,
    offset,
    Option<usize>.none(),
  )
}

fn withConsumed(error: ParseError, consumed: usize) -> ParseError {
  let ParseError {reason, component, offset, fieldIndex, ..} = move error
  return ParseError {
    reason: reason,
    component: component,
    consumed: consumed,
    offset: offset,
    fieldIndex: move fieldIndex,
  }
}

fn poison(
  core: &mut ParserCore,
  error: ParseError,
  callStart: usize,
) -> Result<Progress, ParseError> {
  let mut consumed = usize.ZERO
  if error.offset > callStart { consumed = error.offset - callStart }
  let mut bounded = consumed
  if bounded > core.length - callStart { bounded = core.length - callStart }
  let reported = withConsumed(move error, bounded)
  core.state = ParserState.Failed
  core.failureReason = reported.reason
  core.failureComponent = reported.component
  core.failureConsumed = reported.consumed
  core.failureOffset = reported.offset
  core.failureHasField = false
  match & reported.fieldIndex {
    Option<usize>.None => {}
    Option<usize>.Some {value} => {
      core.failureField = value
      core.failureHasField = true
    }
  }
  return Result<Progress, ParseError>.failResult(move reported)
}

fn storedFailure(core: &ParserCore) -> Option<ParseError> {
  if core.state != ParserState.Failed { return Option<ParseError>.none() }
  let mut field = Option<usize>.none()
  if core.failureHasField { field = Option<usize>.some(core.failureField) }
  return Option<ParseError>.some(ParseError {
    reason: core.failureReason,
    component: core.failureComponent,
    consumed: core.failureConsumed,
    offset: core.failureOffset,
    fieldIndex: move field,
  })
}

fn resetCore(core: &mut ParserCore) -> Result<(), ParseError> {
  if core.state == ParserState.Active {
    return Result<(), ParseError>.failResult(stateError(core.length))
  }
  core.length = usize.ZERO
  core.lineStart = usize.ZERO
  core.pendingCr = false
  core.phase = Phase.StartLine
  core.startPart = StartPart.First
  core.componentLength = usize.ZERO
  core.fieldColonSeen = false
  core.fieldNameLength = usize.ZERO
  core.fieldValueStarted = false
  core.fieldValueLength = usize.ZERO
  core.fieldPendingOws = usize.ZERO
  core.lineCompletesHead = false
  core.state = ParserState.Active
  core.failureReason = ParseReason.InvalidState
  core.failureComponent = ParseComponent.Parser
  core.failureConsumed = usize.ZERO
  core.failureOffset = usize.ZERO
  core.failureField = usize.ZERO
  core.failureHasField = false
  core.fieldCount = usize.ZERO
  core.fieldBytes = usize.ZERO
  core.versionValue = Version.Http11
  core.methodStart = usize.ZERO
  core.methodLength = usize.ZERO
  core.targetStart = usize.ZERO
  core.targetLength = usize.ZERO
  core.statusValue = 100
  core.reasonStart = usize.ZERO
  core.reasonLength = usize.ZERO
  return Result<(), ParseError>.succeed(())
}

fn translateValueError(
  error: ValueError,
  fallback: ParseReason,
  component: ParseComponent,
  base: usize,
  field: Option<usize>,
) -> ParseError {
  let reason = match error.reason {
    ValueReason.LimitExceeded {limit, allowed, attempted} => {
      return limitParseError(
        translateLimit(limit),
        allowed,
        attempted,
        component,
        base + error.offset,
        move field,
      )
    }
    ValueReason.SizeOverflow => ParseReason.SizeOverflow
    ValueReason.MissingHost => ParseReason.MissingHost
    ValueReason.DuplicateHost => ParseReason.DuplicateHost
    ValueReason.InvalidAuthority => {
      if component == ParseComponent.Host {
        return parseError(
          ParseReason.InvalidHost,
          component,
          base + error.offset,
          move field,
        )
      }
      return parseError(fallback, component, base + error.offset, move field)
    }
    ValueReason.InvalidToken => fallback
    ValueReason.InvalidValueByte => fallback
    ValueReason.UnsupportedVersion => ParseReason.UnsupportedVersion
    ValueReason.InvalidStatus => ParseReason.InvalidStatus
    ValueReason.InvalidTarget => ParseReason.InvalidTarget
    ValueReason.InvalidPort => fallback
    ValueReason.MethodTargetMismatch => ParseReason.InvalidTarget
    ValueReason.OutputTooSmall {..} => fallback
  }
  return parseError(reason, component, base + error.offset, move field)
}

fn translateLimit(limit: ValueLimitKind) -> ParseLimitKind {
  return match limit {
    ValueLimitKind.MethodBytes => ParseLimitKind.MethodBytes
    ValueLimitKind.TargetBytes => ParseLimitKind.TargetBytes
    ValueLimitKind.NameBytes => ParseLimitKind.NameBytes
    ValueLimitKind.ValueBytes => ParseLimitKind.ValueBytes
    ValueLimitKind.Fields => ParseLimitKind.Fields
    ValueLimitKind.FieldBytes => ParseLimitKind.FieldBytes
    ValueLimitKind.OwnedBytes => ParseLimitKind.OwnedBytes
    ValueLimitKind.UniqueField => ParseLimitKind.Fields
  }
}

effect fn collectHeaders<'owner>(
  bytes: &'owner [u8],
  records: &'owner [u8],
  count: usize,
  limits: ValueLimits,
) -> List<Header<'owner>> ! OutOfMemoryError ? &mut Allocator {
  let mut entries = List<Header<'owner>>.make()
  let _reserved = run List<Header<'owner>>.reserveExact(&mut entries, count)
  let mut index = usize.ZERO
  while index < count {
    let record = readRecord(records, index)
    let name: string<'owner> = asciiText(range(bytes, record.nameStart, record.nameLength))
    let fieldValue: &'owner [u8] = range(bytes, record.valueStart, record.valueLength)
    let header: Header<'owner> = match move Header.make(name, fieldValue, limits) {
      Result<Header<'owner>, ValueError>.Failure {..} => absurd<Header<'owner>>()
      Result<Header<'owner>, ValueError>.Success {value} => value
    }
    let _appended = run List<Header<'owner>>.append(&mut entries, header)
    index = index + usize.ONE
  }
  return move entries
}

effect fn collectMatchingHeaders<'owner, 'name>(
  bytes: &'owner [u8],
  records: &'owner [u8],
  count: usize,
  name: string<'name>,
  limits: ValueLimits,
) -> Result<List<Header<'owner>>, ValueError> ! OutOfMemoryError ? &mut Allocator {
  let mut selectedCount = usize.ZERO
  let mut index = usize.ZERO
  while index < count {
    let record = readRecord(records, index)
    let fieldName = asciiText(range(bytes, record.nameStart, record.nameLength))
    if asciiEqual(fieldName, name) { selectedCount = selectedCount + usize.ONE }
    index = index + usize.ONE
  }
  let mut entries = List<Header<'owner>>.make()
  let reserved = run List<Header<'owner>>.reserveExact(&mut entries, selectedCount)
  drop reserved
  index = usize.ZERO
  while index < count {
    let record = readRecord(records, index)
    let fieldName: string<'owner> = asciiText(range(bytes, record.nameStart, record.nameLength))
    if asciiEqual(fieldName, name) {
      let fieldValue: &'owner [u8] = range(bytes, record.valueStart, record.valueLength)
      let header = match move Header.make(fieldName, fieldValue, limits) {
        Result<Header<'owner>, ValueError>.Failure {error} => {
          return Result<List<Header<'owner>>, ValueError>.failResult(move error)
        }
        Result<Header<'owner>, ValueError>.Success {value} => value
      }
      let appended = run List<Header<'owner>>.append(&mut entries, header)
      drop appended
    }
    index = index + usize.ONE
  }
  return Result<List<Header<'owner>>, ValueError>.succeed(move entries)
}

effect fn copyRequestValues<'value>(
  version: Version,
  method: Method<'value>,
  target: RequestTarget<'value>,
  entries: &'value [Header<'value>],
  limits: ValueLimits,
) -> Result<OwnedRequestHead, ValueError> ! OutOfMemoryError ? &mut Allocator {
  let headers = match move Headers.make(entries, limits) {
    Result<Headers<'value>, ValueError>.Failure {error} => {
      return Result<OwnedRequestHead, ValueError>.failResult(move error)
    }
    Result<Headers<'value>, ValueError>.Success {value} => value
  }
  let shared = match move ValueRequestHead.make(version, method, target, headers) {
    Result<ValueRequestHead<'value>, ValueError>.Failure {error} => {
      return Result<OwnedRequestHead, ValueError>.failResult(move error)
    }
    Result<ValueRequestHead<'value>, ValueError>.Success {value} => value
  }
  return run ValueRequestHead.copy(&shared, limits)
}

effect fn copyResponseValues<'value>(
  version: Version,
  status: Status,
  reason: &'value [u8],
  entries: &'value [Header<'value>],
  limits: ValueLimits,
) -> Result<OwnedResponseHead, ValueError> ! OutOfMemoryError ? &mut Allocator {
  let headers = match move Headers.make(entries, limits) {
    Result<Headers<'value>, ValueError>.Failure {error} => {
      return Result<OwnedResponseHead, ValueError>.failResult(move error)
    }
    Result<Headers<'value>, ValueError>.Success {value} => value
  }
  let shared = match move ValueResponseHead.make(
    version,
    status,
    Option<&[u8]>.some(reason),
    headers,
    limits,
  ) {
    Result<ValueResponseHead<'value>, ValueError>.Failure {error} => {
      return Result<OwnedResponseHead, ValueError>.failResult(move error)
    }
    Result<ValueResponseHead<'value>, ValueError>.Success {value} => move value
  }
  return run ValueResponseHead.copy(&shared, limits)
}

fn validateRequestForSerialization<'value>(
  head: &ValueRequestHead<'value>,
  limits: ValueLimits,
) -> Result<(), ValueError> {
  let methodText = Method.format(&ValueRequestHead.method(head))
  let method = match move Method.parse(methodText, limits.maxMethodBytes) {
    Result<Method<'value>, ValueError>.Failure {error} => {
      return Result<(), ValueError>.failResult(move error)
    }
    Result<Method<'value>, ValueError>.Success {value} => value
  }
  let targetText = RequestTarget.format(ValueRequestHead.target(head))
  let target = match move RequestTarget.parse(&method, targetText, limits.maxTargetBytes) {
    Result<RequestTarget<'value>, ValueError>.Failure {error} => {
      return Result<(), ValueError>.failResult(move error)
    }
    Result<RequestTarget<'value>, ValueError>.Success {value} => value
  }
  let headers = ValueRequestHead.headers(head)
  let validFields = validateHeaders(&headers, limits)
  if let Result<(), ValueError>.Failure {error} = move validFields {
    return Result<(), ValueError>.failResult(move error)
  }
  let made = ValueRequestHead.make(ValueRequestHead.version(head), method, target, headers)
  return match move made {
    Result<ValueRequestHead<'value>, ValueError>.Failure {error} => Result<(), ValueError>.failResult(move error)
    Result<ValueRequestHead<'value>, ValueError>.Success {..} => Result<(), ValueError>.succeed(())
  }
}

fn validateResponseForSerialization<'value>(
  head: &ValueResponseHead<'value>,
  limits: ValueLimits,
) -> Result<(), ValueError> {
  let headers = ValueResponseHead.headers(head)
  let validFields = validateHeaders(&headers, limits)
  if let Result<(), ValueError>.Failure {error} = move validFields {
    return Result<(), ValueError>.failResult(move error)
  }
  let made = ValueResponseHead.make(
    ValueResponseHead.version(head),
    ValueResponseHead.status(head),
    ValueResponseHead.reason(head),
    headers,
    limits,
  )
  return match move made {
    Result<ValueResponseHead<'value>, ValueError>.Failure {error} => Result<(), ValueError>.failResult(move error)
    Result<ValueResponseHead<'value>, ValueError>.Success {..} => Result<(), ValueError>.succeed(())
  }
}

fn validateHeaders<'value>(headers: &Headers<'value>, limits: ValueLimits) -> Result<(), ValueError> {
  if Headers.count(headers) > limits.maxFields {
    return Result<(), ValueError>.failResult(valueLimitError(
      ValueComponent.Headers,
      ValueLimitKind.Fields,
      limits.maxFields,
      Headers.count(headers),
    ))
  }
  if Headers.fieldBytes(headers) > limits.maxFieldBytes {
    return Result<(), ValueError>.failResult(valueLimitError(
      ValueComponent.Headers,
      ValueLimitKind.FieldBytes,
      limits.maxFieldBytes,
      Headers.fieldBytes(headers),
    ))
  }
  let mut iterator = Headers.iter(headers)
  let mut done = false
  while !done {
    match move ValueHeaderIterator.next(&mut iterator) {
      Option<Header<'value>>.None => { done = true }
      Option<Header<'value>>.Some {value: header} => {
        let made = Header.make(Header.name(&header), Header.value(&header), limits)
        if let Result<Header<'value>, ValueError>.Failure {error} = move made {
          return Result<(), ValueError>.failResult(move error)
        }
      }
    }
  }
  return Result<(), ValueError>.succeed(())
}

fn fieldsSerializedSize<'value>(headers: &Headers<'value>) -> Result<usize, ValueError> {
  let mut total = usize.ZERO
  let mut iterator = Headers.iter(headers)
  let mut done = false
  while !done {
    match move ValueHeaderIterator.next(&mut iterator) {
      Option<Header<'value>>.None => { done = true }
      Option<Header<'value>>.Some {value: header} => {
        total = match move checkedValueAdd(
          total,
          String.byteLength(Header.name(&header)),
          ValueComponent.Headers,
        ) {
          Result<usize, ValueError>.Failure {error} => {
            return Result<usize, ValueError>.failResult(move error)
          }
          Result<usize, ValueError>.Success {value: nextTotal} => nextTotal
        }
        total = match move checkedValueAdd(total, 4, ValueComponent.Headers) {
          Result<usize, ValueError>.Failure {error} => {
            return Result<usize, ValueError>.failResult(move error)
          }
          Result<usize, ValueError>.Success {value: nextTotal} => nextTotal
        }
        total = match move checkedValueAdd(
          total,
          Header.value(&header).length,
          ValueComponent.Headers,
        ) {
          Result<usize, ValueError>.Failure {error} => {
            return Result<usize, ValueError>.failResult(move error)
          }
          Result<usize, ValueError>.Success {value: nextTotal} => nextTotal
        }
      }
    }
  }
  return Result<usize, ValueError>.succeed(total)
}

fn writeFields<'value>(headers: &Headers<'value>, output: &mut [u8], start: usize) -> usize {
  let mut cursor = start
  let mut iterator = Headers.iter(headers)
  let mut done = false
  while !done {
    match move ValueHeaderIterator.next(&mut iterator) {
      Option<Header<'value>>.None => { done = true }
      Option<Header<'value>>.Some {value: header} => {
        cursor = writeSlice(&mut output, cursor, String.utf8Bytes(Header.name(&header)))
        output[cursor] = 58
        output[cursor + usize.ONE] = 32
        cursor = cursor + 2
        cursor = writeSlice(&mut output, cursor, Header.value(&header))
        output[cursor] = 13
        output[cursor + usize.ONE] = 10
        cursor = cursor + 2
      }
    }
  }
  return cursor
}

fn writeSlice(output: &mut [u8], start: usize, input: &[u8]) -> usize {
  let mut index = usize.ZERO
  while index < input.length {
    output[start + index] = input[index]
    index = index + usize.ONE
  }
  return start + input.length
}

fn checkedValueAdd(
  left: usize,
  right: usize,
  component: ValueComponent,
) -> Result<usize, ValueError> {
  return match move usize.checkedAdd(left, right) {
    Option<usize>.None => Result<usize, ValueError>.failResult(valueSizeError(component))
    Option<usize>.Some {value} => Result<usize, ValueError>.succeed(value)
  }
}

fn chainValueAdd(
  left: Result<usize, ValueError>,
  right: usize,
  component: ValueComponent,
) -> Result<usize, ValueError> {
  return match move left {
    Result<usize, ValueError>.Failure {error} => Result<usize, ValueError>.failResult(move error)
    Result<usize, ValueError>.Success {value} => checkedValueAdd(value, right, component)
  }
}

fn chainValueResult(
  left: Result<usize, ValueError>,
  right: Result<usize, ValueError>,
  component: ValueComponent,
) -> Result<usize, ValueError> {
  let base = match move left {
    Result<usize, ValueError>.Failure {error} => {
      return Result<usize, ValueError>.failResult(move error)
    }
    Result<usize, ValueError>.Success {value} => value
  }
  return match move right {
    Result<usize, ValueError>.Failure {error} => Result<usize, ValueError>.failResult(move error)
    Result<usize, ValueError>.Success {value} => checkedValueAdd(base, value, component)
  }
}

fn valueSizeError(component: ValueComponent) -> ValueError {
  return ValueError {
    reason: ValueReason.SizeOverflow,
    component: component,
    fieldIndex: Option<usize>.none(),
    offset: usize.MAX,
  }
}

fn valueOutputTooSmall(required: usize, available: usize) -> ValueError {
  return ValueError {
    reason: ValueReason.OutputTooSmall {required: required, available: available},
    component: ValueComponent.Headers,
    fieldIndex: Option<usize>.none(),
    offset: available,
  }
}

fn valueLimitError(
  component: ValueComponent,
  limit: ValueLimitKind,
  allowed: usize,
  attempted: usize,
) -> ValueError {
  return ValueError {
    reason: ValueReason.LimitExceeded {limit: limit, allowed: allowed, attempted: attempted},
    component: component,
    fieldIndex: Option<usize>.none(),
    offset: attempted,
  }
}

fn absurd<T>() -> T {
  unsafe {}
  return absurd<T>()
}
