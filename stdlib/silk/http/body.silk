//! Read and write the body of an HTTP/1 message: fixed length, chunked, or until the connection
//! closes.
//!
//! # When to use
//! After you parse a head with `silk.http.head`, call [`selectRequest`] or [`selectResponse`] to
//! find how the body is framed. Then make a [`Decoder`] and call [`Decoder.step`] with the bytes
//! after the head. To send a body, check the head with [`validateOutgoingRequest`] or
//! [`validateOutgoingResponse`], make an [`Encoder`], and call [`Encoder.step`],
//! [`Encoder.beginFinish`], and [`Encoder.continueFinish`].
//!
//! # Details
//! `make` allocates all the memory. After that, `step` does not allocate and does not keep your
//! buffers. Each call returns how many input bytes it used and how many output bytes it wrote, and
//! the next action in [`ProgressState`]. The decoder removes the chunk framing and gives only the
//! payload. This module does not decompress content: see `silk.http.content`.
//!
//! # Errors
//! - [`BodyError`] tells which rule failed, in which part, and the byte offset on the wire. After
//!   an error, the decoder or encoder stays failed.
//! - `OutOfMemoryError` from `make` if the `Allocator` fails.
//!
//! # Gotchas
//! A complete body does not mean that the connection is good. Check the connection separately
//! before you use it again. A response with `CloseDelimited` framing ends only when the connection
//! closes, so give `finalInput` as `true` at the end of the transport.
//!
//! # Examples
//! ## Decode a chunked response
//! ```silk
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.core.effect { Effect }
//! import silk.http.message { Method }
//! import silk.http.body {
//!   BodyError,
//!   Decoder,
//!   Framing,
//!   Limits as BodyLimits,
//!   Progress,
//!   ProgressState,
//!   Selection,
//!   TrailerPolicy,
//!   selectResponse
//! }
//! import silk.http.head {
//!   Limits,
//!   ParseError,
//!   ParsedResponse,
//!   ResponseHead,
//!   ResponseParser,
//!   parseResponse
//! }
//! import silk.http.headers { Limits as ValueLimits }
//! import silk.core.result { Result }
//! import silk.collections.slice { Slice }
//!
//! fn values() -> ValueLimits {
//!   return ValueLimits {
//!     maxMethodBytes: 16,
//!     maxTargetBytes: 1024,
//!     maxNameBytes: 64,
//!     maxValueBytes: 1024,
//!     maxFields: 32,
//!     maxFieldBytes: 4096,
//!     maxOwnedBytes: 8192,
//!   }
//! }
//!
//! fn headLimits() -> Limits {
//!   return Limits {
//!     maxHeadBytes: 4096,
//!     maxStartLineBytes: 1024,
//!     maxFieldLineBytes: 1024,
//!     maxOwnedBytes: 8192,
//!     values: values(),
//!   }
//! }
//!
//! fn bodyLimits() -> BodyLimits {
//!   return BodyLimits {
//!     maxWireBytes: 65536,
//!     maxPayloadBytes: 65536,
//!     maxChunkBytes: 4096,
//!     maxChunks: 64,
//!     maxChunkLineBytes: 256,
//!     maxExtensionBytes: 1024,
//!     maxTrailerBytes: 1024,
//!     maxTrailerFields: 8,
//!     maxOwnedBytes: 16384,
//!     trailerValues: values(),
//!   }
//! }
//!
//! effect fn program() -> i32
//!   ! OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let wire = b"HTTP/1.1 200 OK\r\nTransfer-Encoding: chunked\r\n\r\n5\r\nhello\r\n0\r\n\r\n"
//!   let parsed = run parseResponse(&wire, headLimits())
//!     |> Effect.provideMut<Allocator>(&mut allocator)
//!   let result = match move parsed {
//!     Result<ParsedResponse, ParseError>.Success { value } => move value
//!     Result<ParsedResponse, ParseError>.Failure {..} => {
//!       return 1
//!     }
//!   }
//!   let head = match ResponseParser.head(&result.parser) {
//!     Result<ResponseHead, ParseError>.Success { value } => value
//!     Result<ResponseHead, ParseError>.Failure {..} => {
//!       return 1
//!     }
//!   }
//!   let get = Method.get()
//!   let selection = match selectResponse(head, &get, TrailerPolicy.defaultPolicy()) {
//!     Result<Selection, BodyError>.Success { value } => move value
//!     Result<Selection, BodyError>.Failure {..} => {
//!       return 1
//!     }
//!   }
//!   let chunked = match Selection.framing(&selection) {
//!     Framing.Chunked => true
//!     _ => false
//!   }
//!   if !chunked {
//!     return 1
//!   }
//!   let made = run Decoder.make(move selection, bodyLimits(), TrailerPolicy.defaultPolicy())
//!     |> Effect.provideMut<Allocator>(&mut allocator)
//!   let mut decoder = match move made {
//!     Result<Decoder, BodyError>.Success { value } => move value
//!     Result<Decoder, BodyError>.Failure {..} => {
//!       return 1
//!     }
//!   }
//!
//!   // The body starts after the head.
//!   let body = Slice.view<u8>(&wire, result.progress.consumed, wire.length - result.progress.consumed)
//!   let mut payload: [u8; 16] = [0; 16]
//!   let progress = match Decoder.step(&mut decoder, body, &mut payload, true) {
//!     Result<Progress, BodyError>.Success { value } => move value
//!     Result<Progress, BodyError>.Failure {..} => {
//!       return 1
//!     }
//!   }
//!   if progress.state != ProgressState.Complete || progress.written != 5 || payload[0] != 104 {
//!     return 1
//!   }
//!   return 0
//! }
//!
//! effect fn failed<E>(error: E) -> i32 {
//!   drop error
//!   return 1
//! }
//!
//! pub fn main() -> i32 {
//!   return run Effect.catchAll(program(), failed)
//! }
//! ```
//!
//! @category HTTP

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.text.format { Debug, Format, Formatter }
import silk.http.message { Header, Method, Status, ValueError, Version }
import silk.http.head { HeaderIterator as HeadHeaderIterator, RequestHead, ResponseHead }
import silk.http.headers {
  HeaderIterator as ValueHeaderIterator,
  Headers,
  Limits as ValueLimits,
}
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.text.string { String }
import silk.num.u64
import silk.num.u8
import silk.num.usize
import silk.collections.list { List }
import silk.io.writer { Writer, WriterError }

const FIELD_RECORD_BYTES: usize = 32
const NAME_RECORD_BYTES: usize = 16
const ENCODER_SYNTAX_BYTES: usize = 32
const TWO: usize = 2
const THREE: usize = 3
const FOUR: usize = 4

/// How the end of a body is found.
pub union Framing {
  /// There is no body, for example in a response to `HEAD`, or with status 204 or 304.
  Empty,
  /// The body has the length in `Content-Length`.
  Fixed {
    /// The length of the body, in bytes.
    pub length: u64,
  },
  /// The body is sent in chunks, with `Transfer-Encoding: chunked`.
  Chunked,
  /// The body ends when the connection closes. The connection cannot be used again.
  CloseDelimited,
  /// The bytes after the head are a tunnel, for example after a successful `CONNECT`. They are not
  /// an HTTP body.
  Tunnel,
}

impl Copy for Framing {}

/// A problem in a response with no body. The body is still empty, but do not use the connection
/// again.
pub enum Anomaly {
  /// There is no problem.
  None,
  /// A 1xx or 204 response has `Content-Length` or `Transfer-Encoding`.
  ProhibitedFraming,
  /// An HTTP/1.0 response has `Transfer-Encoding`.
  Http10TransferEncoding,
}

/// The framing of a body, from [`selectRequest`] or [`selectResponse`]. Give it to [`Decoder.make`]
/// or [`Encoder.make`].
pub struct Selection<'head> {
  framingValue: Framing,
  anomalyValue: Anomaly,
  statsFields: HeadHeaderIterator<'head>,
  copyFields: HeadHeaderIterator<'head>,
}

impl<'head> Selection<'head> {
  /// Returns how the end of the body is found.
  pub fn framing(self: &Self) -> Framing { return self.framingValue }
  /// Returns a problem that prevents use of the connection again, if any.
  pub fn anomaly(self: &Self) -> Anomaly { return self.anomalyValue }
}

/// The maximum sizes for a body and its framing.
pub struct Limits {
  /// The maximum number of bytes on the wire, including the chunk framing.
  pub maxWireBytes: u64,
  /// The maximum number of payload bytes.
  pub maxPayloadBytes: u64,
  /// The maximum size of one chunk.
  pub maxChunkBytes: usize,
  /// The maximum number of chunks that are not empty.
  pub maxChunks: usize,
  /// The maximum length of one chunk size line.
  pub maxChunkLineBytes: usize,
  /// The maximum total length of all chunk extensions.
  pub maxExtensionBytes: u64,
  /// The maximum size of the trailer section.
  pub maxTrailerBytes: usize,
  /// The maximum number of trailer fields.
  pub maxTrailerFields: usize,
  /// The maximum memory of a decoder or an encoder.
  pub maxOwnedBytes: usize,
  /// The limits for each trailer name and value.
  pub trailerValues: ValueLimits,
}

impl Copy for Limits {}

/// What to do after a `step`.
pub enum ProgressState {
  /// Give more input.
  NeedInput,
  /// Give more space in the output buffer.
  NeedOutput,
  /// The body is complete.
  Complete,
  /// The bytes are a tunnel, not an HTTP body.
  Tunnel,
}

/// The result of a successful `step`.
pub struct Progress {
  /// The number of input bytes that this call used.
  pub consumed: usize,
  /// The number of output bytes that this call wrote.
  pub written: usize,
  /// The total number of wire bytes so far.
  pub totalWire: u64,
  /// The total number of payload bytes so far.
  pub totalPayload: u64,
  /// What to do next.
  pub state: ProgressState,
}

/// How a body ended. See [`Completion.kind`].
pub enum CompletionKind {
  /// The framing marked the end: the length, the last chunk, or no body.
  Delimited,
  /// The connection closed.
  CloseDelimited,
  /// The bytes were a tunnel.
  Tunnel,
}

/// Proof that a body is complete. Get it from [`Decoder.completion`] or [`Encoder.completion`].
pub struct Completion<'owner> {
  kindValue: CompletionKind,
  marker: &'owner u8,
}

impl<'owner> Completion<'owner> {
  /// Returns how the body ended.
  pub fn kind(self: &Self) -> CompletionKind { return self.kindValue }
}

/// The part of the body work where an error occurred.
pub enum BodyComponent {
  /// The selection of the framing from the head.
  Selection,
  /// The `Content-Length` field.
  ContentLength,
  /// The `Transfer-Encoding` field.
  TransferEncoding,
  /// A chunk size line, with its extensions.
  ChunkLine,
  /// The bytes of a chunk.
  ChunkPayload,
  /// The CRLF after the bytes of a chunk.
  ChunkDelimiter,
  /// The name of a trailer field.
  TrailerName,
  /// The value of a trailer field.
  TrailerValue,
  /// The check of a trailer name against the [`TrailerPolicy`].
  TrailerPolicy,
  /// The decoder.
  Decoder,
  /// The encoder.
  Encoder,
  /// A [`Decoder.discard`] call.
  Discard,
}

impl Debug for BodyComponent {
  /// Writes the name of the variant, such as `Selection`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      BodyComponent.Selection => run Format.write(&mut formatter, b"Selection")
      BodyComponent.ContentLength => run Format.write(&mut formatter, b"ContentLength")
      BodyComponent.TransferEncoding => run Format.write(&mut formatter, b"TransferEncoding")
      BodyComponent.ChunkLine => run Format.write(&mut formatter, b"ChunkLine")
      BodyComponent.ChunkPayload => run Format.write(&mut formatter, b"ChunkPayload")
      BodyComponent.ChunkDelimiter => run Format.write(&mut formatter, b"ChunkDelimiter")
      BodyComponent.TrailerName => run Format.write(&mut formatter, b"TrailerName")
      BodyComponent.TrailerValue => run Format.write(&mut formatter, b"TrailerValue")
      BodyComponent.TrailerPolicy => run Format.write(&mut formatter, b"TrailerPolicy")
      BodyComponent.Decoder => run Format.write(&mut formatter, b"Decoder")
      BodyComponent.Encoder => run Format.write(&mut formatter, b"Encoder")
      BodyComponent.Discard => run Format.write(&mut formatter, b"Discard")
    }
  }
}

/// The limit that a body exceeded. Each value names a field of [`Limits`].
pub enum BodyLimitKind {
  /// The cumulative wire-byte budget.
  WireBytes,
  /// The cumulative payload-byte budget.
  PayloadBytes,
  /// The per-chunk payload-byte budget.
  ChunkBytes,
  /// The nonempty chunk-count budget.
  Chunks,
  /// The chunk-line byte budget.
  ChunkLineBytes,
  /// The cumulative extension-byte budget.
  ExtensionBytes,
  /// The trailer-section byte budget.
  TrailerBytes,
  /// The trailer field-count budget.
  TrailerFields,
  /// `trailerValues.maxNameBytes`.
  TrailerNameBytes,
  /// `trailerValues.maxValueBytes`.
  TrailerValueBytes,
  /// `trailerValues.maxFieldBytes`.
  TrailerFieldBytes,
  /// The owned-storage byte budget.
  OwnedBytes,
}

impl Debug for BodyLimitKind {
  /// Writes the name of the variant, such as `WireBytes`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      BodyLimitKind.WireBytes => run Format.write(&mut formatter, b"WireBytes")
      BodyLimitKind.PayloadBytes => run Format.write(&mut formatter, b"PayloadBytes")
      BodyLimitKind.ChunkBytes => run Format.write(&mut formatter, b"ChunkBytes")
      BodyLimitKind.Chunks => run Format.write(&mut formatter, b"Chunks")
      BodyLimitKind.ChunkLineBytes => run Format.write(&mut formatter, b"ChunkLineBytes")
      BodyLimitKind.ExtensionBytes => run Format.write(&mut formatter, b"ExtensionBytes")
      BodyLimitKind.TrailerBytes => run Format.write(&mut formatter, b"TrailerBytes")
      BodyLimitKind.TrailerFields => run Format.write(&mut formatter, b"TrailerFields")
      BodyLimitKind.TrailerNameBytes => run Format.write(&mut formatter, b"TrailerNameBytes")
      BodyLimitKind.TrailerValueBytes => run Format.write(&mut formatter, b"TrailerValueBytes")
      BodyLimitKind.TrailerFieldBytes => run Format.write(&mut formatter, b"TrailerFieldBytes")
      BodyLimitKind.OwnedBytes => run Format.write(&mut formatter, b"OwnedBytes")
    }
  }
}

/// The rule that failed.
pub union BodyReason {
  /// The head does not allow this framing.
  InvalidFraming,
  /// The head has both `Content-Length` and `Transfer-Encoding`.
  ConflictingFraming,
  /// A transfer coding other than `chunked` is used.
  UnsupportedTransferCoding,
  /// The `Content-Length` value is not valid.
  InvalidLength,
  /// A size calculation overflowed.
  SizeOverflow,
  /// A chunk size line or a chunk delimiter is not valid.
  ChunkSyntax,
  /// A trailer field is not valid.
  TrailerSyntax,
  /// A trailer name is not allowed by the [`TrailerPolicy`].
  TrailerPolicy,
  /// The input ended before the body was complete.
  Truncated,
  /// The encoder finished before it got `Content-Length` bytes.
  FixedLengthUnderrun,
  /// The encoder got more than `Content-Length` bytes.
  FixedLengthOverrun,
  /// The encoder got bytes for a message with no body.
  UnexpectedPayload,
  /// An encoder cannot send tunnel bytes as a body.
  UnsupportedTunnelEncoding,
  /// A [`Decoder.discard`] call would read more than its `maxDiscardWireBytes`.
  DiscardLimit {
    /// The value of the limit.
    pub allowed: u64,
    /// The size that was found.
    pub attempted: u64,
  },
  /// The body exceeded a limit in [`Limits`].
  LimitExceeded {
    /// The limit that was exceeded.
    pub limit: BodyLimitKind,
    /// The value of the limit.
    pub allowed: u64,
    /// The size that was found.
    pub attempted: u64,
  },
  /// The call is not valid now, for example a `step` after the body is complete or after an error.
  InvalidState,
}

impl Copy for BodyReason {}

impl Debug for BodyReason {
  /// Writes the name of the variant and its fields, such as `InvalidFraming`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      BodyReason.InvalidFraming => run Format.write(&mut formatter, b"InvalidFraming")
      BodyReason.ConflictingFraming => run Format.write(&mut formatter, b"ConflictingFraming")
      BodyReason.UnsupportedTransferCoding => run Format.write(&mut formatter, b"UnsupportedTransferCoding")
      BodyReason.InvalidLength => run Format.write(&mut formatter, b"InvalidLength")
      BodyReason.SizeOverflow => run Format.write(&mut formatter, b"SizeOverflow")
      BodyReason.ChunkSyntax => run Format.write(&mut formatter, b"ChunkSyntax")
      BodyReason.TrailerSyntax => run Format.write(&mut formatter, b"TrailerSyntax")
      BodyReason.TrailerPolicy => run Format.write(&mut formatter, b"TrailerPolicy")
      BodyReason.Truncated => run Format.write(&mut formatter, b"Truncated")
      BodyReason.FixedLengthUnderrun => run Format.write(&mut formatter, b"FixedLengthUnderrun")
      BodyReason.FixedLengthOverrun => run Format.write(&mut formatter, b"FixedLengthOverrun")
      BodyReason.UnexpectedPayload => run Format.write(&mut formatter, b"UnexpectedPayload")
      BodyReason.UnsupportedTunnelEncoding => run Format.write(&mut formatter, b"UnsupportedTunnelEncoding")
      BodyReason.DiscardLimit { allowed, attempted } => {
        let mut record = run Format.debugRecord("DiscardLimit", &mut formatter)
        run Format.debugField(&mut record, "allowed", &allowed, &mut formatter)
        run Format.debugField(&mut record, "attempted", &attempted, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      BodyReason.LimitExceeded { limit, allowed, attempted } => {
        let mut record = run Format.debugRecord("LimitExceeded", &mut formatter)
        run Format.debugField(&mut record, "limit", &limit, &mut formatter)
        run Format.debugField(&mut record, "allowed", &allowed, &mut formatter)
        run Format.debugField(&mut record, "attempted", &attempted, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      BodyReason.InvalidState => run Format.write(&mut formatter, b"InvalidState")
    }
  }
}

/// The error from body work. After it, the decoder or encoder stays failed.
pub struct BodyError {
  /// The rule that failed.
  pub reason: BodyReason,
  /// The part where it failed.
  pub component: BodyComponent,
  /// The byte offset on the wire, from the start of the body.
  pub wireOffset: u64,
  /// The number of input bytes that this call used before the error.
  pub consumed: usize,
  /// The number of output bytes that this call wrote before the error.
  pub written: usize,
  /// The total number of wire bytes before the error.
  pub totalWire: u64,
  /// The total number of payload bytes before the error.
  pub totalPayload: u64,
  /// The position of the trailer field, from 0, when the error is in a trailer.
  pub fieldIndex: Option<usize>,
}

impl Debug for BodyError {
  /// Writes the fields, as `BodyError { reason: ..., component: ..., ... }`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return run Format.debugFields(self, "BodyError", &mut formatter)
  }
}

/// The trailer fields that a chunked body can have.
pub union TrailerPolicy<'names> {
  /// Allow trailers, but not fields that change the framing, routing, or authentication, such as
  /// `Content-Length` or `Host`.
  Default,
  /// Allow only the trailers with these names.
  Explicit { names: &'names [string<'names>] },
}

impl<'names> Copy for TrailerPolicy<'names> {}

impl<'names> TrailerPolicy<'names> {
  /// Returns the `Default` policy.
  pub fn defaultPolicy() -> TrailerPolicy<'names> { return TrailerPolicy<'names>.Default }

  /// Returns a policy that allows only `names`. It fails if a name is not a token, or is a field
  /// that is never allowed in a trailer.
  pub fn fromNames(
    names: &'names [string<'names>],
  ) -> Result<TrailerPolicy<'names>, BodyError> {
    let mut index = usize.ZERO
    while index < names.length {
      let bytes = String.utf8Bytes(names[index])
      if !validToken(bytes) || staticallyForbidden(bytes) {
        return Result<TrailerPolicy<'names>, BodyError>.failResult(baseError(
          BodyReason.TrailerPolicy,
          BodyComponent.TrailerPolicy,
          usize.toU64(index),
          Option<usize>.some(index),
        ))
      }
      index = index + usize.ONE
    }
    return Result<TrailerPolicy<'names>, BodyError>.succeed(
      TrailerPolicy<'names>.Explicit {names: names},
    )
  }
}

struct HeadMetadata {
  hasLength: bool,
  length: u64,
  hasTransfer: bool,
}

/// Returns the framing of a received request body.
///
/// A request without `Content-Length` or `Transfer-Encoding` has no body.
pub fn selectRequest<'value>(
  head: RequestHead<'value>,
  policy: TrailerPolicy,
) -> Result<Selection<'value>, BodyError> {
  let metadata = match move scanRequestHead(head, policy) {
    Result<HeadMetadata, BodyError>.Failure {error} => {
      return Result<Selection<'value>, BodyError>.failResult(move error)
    }
    Result<HeadMetadata, BodyError>.Success {value} => move value
  }
  let framing = match move ordinaryFraming(move metadata, true) {
    Result<Framing, BodyError>.Failure {error} => {
      return Result<Selection<'value>, BodyError>.failResult(move error)
    }
    Result<Framing, BodyError>.Success {value} => value
  }
  return Result<Selection<'value>, BodyError>.succeed(Selection<'value> {
    framingValue: framing,
    anomalyValue: Anomaly.None,
    statsFields: head.fields(),
    copyFields: head.fields(),
  })
}

/// Returns the framing of a received response body. `requestMethod` is the method of the request.
///
/// # Details
/// A response to `HEAD`, a 1xx, 204, or 304 response has no body. A 2xx response to `CONNECT` is a
/// tunnel. A response without `Content-Length` or `Transfer-Encoding` ends when the connection
/// closes.
pub fn selectResponse<'value>(
  head: ResponseHead<'value>,
  requestMethod: &Method,
  policy: TrailerPolicy,
) -> Result<Selection<'value>, BodyError> {
  let version = head.version()
  let statusValue = head.status()
  let status = Status.code(&statusValue)
  if Method.format(requestMethod) == "CONNECT" && status >= 200 && status < 300 {
    return Result<Selection<'value>, BodyError>.succeed(Selection<'value> {
      framingValue: Framing.Tunnel,
      anomalyValue: Anomaly.None,
      statsFields: head.fields(),
      copyFields: head.fields(),
    })
  }
  if semanticallyEmpty(statusValue, requestMethod) {
    let mut anomaly = Anomaly.None
    let hasLength = hasHeader(head.fields(), b"content-length")
    let hasTransfer = hasHeader(head.fields(), b"transfer-encoding")
    if version == Version.Http10 && hasTransfer {
      anomaly = Anomaly.Http10TransferEncoding
    }
    else if ((status >= 100 && status < 200) || status == 204) && (hasLength || hasTransfer) {
      anomaly = Anomaly.ProhibitedFraming
    }
    return Result<Selection<'value>, BodyError>.succeed(Selection<'value> {
      framingValue: Framing.Empty,
      anomalyValue: anomaly,
      statsFields: head.fields(),
      copyFields: head.fields(),
    })
  }
  let metadata = match move scanResponseHead(head, policy) {
    Result<HeadMetadata, BodyError>.Failure {error} => {
      return Result<Selection<'value>, BodyError>.failResult(move error)
    }
    Result<HeadMetadata, BodyError>.Success {value} => move value
  }
  let framing = match move ordinaryFraming(move metadata, false) {
    Result<Framing, BodyError>.Failure {error} => {
      return Result<Selection<'value>, BodyError>.failResult(move error)
    }
    Result<Framing, BodyError>.Success {value} => value
  }
  return Result<Selection<'value>, BodyError>.succeed(Selection<'value> {
    framingValue: framing,
    anomalyValue: Anomaly.None,
    statsFields: head.fields(),
    copyFields: head.fields(),
  })
}

/// Checks the framing fields of a request that you send, and returns the framing for
/// [`Encoder.make`].
pub fn validateOutgoingRequest<'value>(
  head: RequestHead<'value>,
  policy: TrailerPolicy,
) -> Result<Selection<'value>, BodyError> {
  return selectRequest(head, policy)
}

/// Checks the framing fields of a response that you send, and returns the framing for
/// [`Encoder.make`]. A 1xx, 204, or 2xx `CONNECT` response cannot have `Content-Length` or
/// `Transfer-Encoding`.
pub fn validateOutgoingResponse<'value>(
  head: ResponseHead<'value>,
  requestMethod: &Method,
  policy: TrailerPolicy,
) -> Result<Selection<'value>, BodyError> {
  let statusValue = head.status()
  let status = Status.code(&statusValue)
  let prohibited = (status >= 100 && status < 200) || status == 204
    || (Method.format(requestMethod) == "CONNECT" && status >= 200 && status < 300)
  if prohibited && (hasHeader(head.fields(), b"content-length")
    || hasHeader(head.fields(), b"transfer-encoding")) {
    return Result<Selection<'value>, BodyError>.failResult(baseError(
      BodyReason.InvalidFraming,
      BodyComponent.Selection,
      u64.MIN,
      Option<usize>.none(),
    ))
  }
  if Method.format(requestMethod) == "CONNECT" && status >= 200 && status < 300 {
    return Result<Selection<'value>, BodyError>.succeed(Selection<'value> {
      framingValue: Framing.Tunnel,
      anomalyValue: Anomaly.None,
      statsFields: head.fields(),
      copyFields: head.fields(),
    })
  }
  if semanticallyEmpty(statusValue, requestMethod) {
    let validated = scanResponseHead(head, policy)
    if let Result<HeadMetadata, BodyError>.Failure {error} = move validated {
      return Result<Selection<'value>, BodyError>.failResult(move error)
    }
    return Result<Selection<'value>, BodyError>.succeed(Selection<'value> {
      framingValue: Framing.Empty,
      anomalyValue: Anomaly.None,
      statsFields: head.fields(),
      copyFields: head.fields(),
    })
  }
  return selectResponse(move head, requestMethod, policy)
}

fn scanRequestHead<'value>(
  head: RequestHead<'value>,
  policy: TrailerPolicy,
) -> Result<HeadMetadata, BodyError> {
  let metadata = match move scanHead(head.fields(), head.version(), policy) {
    Result<HeadMetadata, BodyError>.Failure {error} => {
      return Result<HeadMetadata, BodyError>.failResult(move error)
    }
    Result<HeadMetadata, BodyError>.Success {value} => move value
  }
  let exclusions = validateRequestTrailerExclusions(head)
  if let Result<(), BodyError>.Failure {error} = move exclusions {
    return Result<HeadMetadata, BodyError>.failResult(move error)
  }
  return Result<HeadMetadata, BodyError>.succeed(move metadata)
}

fn scanResponseHead<'value>(
  head: ResponseHead<'value>,
  policy: TrailerPolicy,
) -> Result<HeadMetadata, BodyError> {
  let metadata = match move scanHead(head.fields(), head.version(), policy) {
    Result<HeadMetadata, BodyError>.Failure {error} => {
      return Result<HeadMetadata, BodyError>.failResult(move error)
    }
    Result<HeadMetadata, BodyError>.Success {value} => move value
  }
  let exclusions = validateResponseTrailerExclusions(head)
  if let Result<(), BodyError>.Failure {error} = move exclusions {
    return Result<HeadMetadata, BodyError>.failResult(move error)
  }
  return Result<HeadMetadata, BodyError>.succeed(move metadata)
}

fn scanHead<'value>(
  fields: HeadHeaderIterator<'value>,
  version: Version,
  policy: TrailerPolicy,
) -> Result<HeadMetadata, BodyError> {
  let mut lengthCount = usize.ZERO
  let mut transferCount = usize.ZERO
  let mut length: u64 = 0
  let mut iterator = move fields
  let mut index = usize.ZERO
  while true {
    let field = match move HeadHeaderIterator.next(&mut iterator) {
      Option<Header<'value>>.None => { break }
      Option<Header<'value>>.Some {value: fieldValue} => fieldValue
    }
    let name = String.utf8Bytes(Header.name(&field))
    let value = Header.value(&field)
    if asciiName(name, b"content-length") {
      lengthCount = lengthCount + usize.ONE
      if lengthCount > usize.ONE {
        return Result<HeadMetadata, BodyError>.failResult(selectionError(
          BodyReason.InvalidLength,
          BodyComponent.ContentLength,
          index,
        ))
      }
      length = match move parseContentLength(value, index) {
        Result<u64, BodyError>.Failure {error} => {
          return Result<HeadMetadata, BodyError>.failResult(move error)
        }
        Result<u64, BodyError>.Success {value: parsed} => parsed
      }
    } else if asciiName(name, b"transfer-encoding") {
      transferCount = transferCount + usize.ONE
      if transferCount > usize.ONE || !asciiTrimmed(value, b"chunked") {
        return Result<HeadMetadata, BodyError>.failResult(selectionError(
          BodyReason.UnsupportedTransferCoding,
          BodyComponent.TransferEncoding,
          index,
        ))
      }
    } else if asciiName(name, b"trailer") {
      let declared = validateNameList(value, policy, index)
      if let Result<(), BodyError>.Failure {error} = move declared {
        return Result<HeadMetadata, BodyError>.failResult(move error)
      }
    } else if asciiName(name, b"connection") {
      let nominated = validateConnectionList(value, index)
      if let Result<(), BodyError>.Failure {error} = move nominated {
        return Result<HeadMetadata, BodyError>.failResult(move error)
      }
    }
    index = index + usize.ONE
  }
  if transferCount > usize.ZERO && version == Version.Http10 {
    return Result<HeadMetadata, BodyError>.failResult(baseError(
      BodyReason.UnsupportedTransferCoding,
      BodyComponent.TransferEncoding,
      u64.MIN,
      Option<usize>.none(),
    ))
  }
  return Result<HeadMetadata, BodyError>.succeed(HeadMetadata {
    hasLength: lengthCount == usize.ONE,
    length: length,
    hasTransfer: transferCount == usize.ONE,
  })
}

fn validateConnectionList(value: &[u8], fieldIndex: usize) -> Result<(), BodyError> {
  let mut cursor = usize.ZERO
  let mut count = usize.ZERO
  while cursor < value.length {
    while cursor < value.length && (value[cursor] == 32 || value[cursor] == 9) {
      cursor = cursor + usize.ONE
    }
    let start = cursor
    while cursor < value.length && tokenByte(value[cursor]) { cursor = cursor + usize.ONE }
    if cursor == start {
      return Result<(), BodyError>.failResult(selectionError(
        BodyReason.TrailerPolicy,
        BodyComponent.TrailerPolicy,
        fieldIndex,
      ))
    }
    count = count + usize.ONE
    while cursor < value.length && (value[cursor] == 32 || value[cursor] == 9) {
      cursor = cursor + usize.ONE
    }
    if cursor < value.length {
      if value[cursor] != 44 {
        return Result<(), BodyError>.failResult(selectionError(
          BodyReason.TrailerPolicy,
          BodyComponent.TrailerPolicy,
          fieldIndex,
        ))
      }
      cursor = cursor + usize.ONE
      if cursor == value.length {
        return Result<(), BodyError>.failResult(selectionError(
          BodyReason.TrailerPolicy,
          BodyComponent.TrailerPolicy,
          fieldIndex,
        ))
      }
    }
  }
  if count == usize.ZERO {
    return Result<(), BodyError>.failResult(selectionError(
      BodyReason.TrailerPolicy,
      BodyComponent.TrailerPolicy,
      fieldIndex,
    ))
  }
  return Result<(), BodyError>.succeed(())
}

fn ordinaryFraming(metadata: HeadMetadata, request: bool) -> Result<Framing, BodyError> {
  if metadata.hasLength && metadata.hasTransfer {
    return Result<Framing, BodyError>.failResult(baseError(
      BodyReason.ConflictingFraming,
      BodyComponent.Selection,
      u64.MIN,
      Option<usize>.none(),
    ))
  }
  if metadata.hasTransfer { return Result<Framing, BodyError>.succeed(Framing.Chunked) }
  if metadata.hasLength {
    return Result<Framing, BodyError>.succeed(Framing.Fixed {length: metadata.length})
  }
  if request { return Result<Framing, BodyError>.succeed(Framing.Empty) }
  return Result<Framing, BodyError>.succeed(Framing.CloseDelimited)
}

fn semanticallyEmpty(status: Status, method: &Method) -> bool {
  let code = Status.code(&status)
  return Method.format(method) == "HEAD"
    || (code >= 100 && code < 200)
    || code == 204
    || code == 304
}

fn parseContentLength(value: &[u8], fieldIndex: usize) -> Result<u64, BodyError> {
  if value.length == usize.ZERO {
    return Result<u64, BodyError>.failResult(selectionError(
      BodyReason.InvalidLength,
      BodyComponent.ContentLength,
      fieldIndex,
    ))
  }
  let mut parsed: u64 = 0
  let mut index = usize.ZERO
  while index < value.length {
    let byte = value[index]
    if byte < 48 || byte > 57 {
      return Result<u64, BodyError>.failResult(selectionError(
        BodyReason.InvalidLength,
        BodyComponent.ContentLength,
        fieldIndex,
      ))
    }
    if parsed > u64.MAX / 10 {
      return Result<u64, BodyError>.failResult(selectionError(
        BodyReason.SizeOverflow,
        BodyComponent.ContentLength,
        fieldIndex,
      ))
    }
    let product = parsed * 10
    let digit = u8.toU64(byte - 48)
    if digit > u64.MAX - product {
      return Result<u64, BodyError>.failResult(selectionError(
        BodyReason.SizeOverflow,
        BodyComponent.ContentLength,
        fieldIndex,
      ))
    }
    parsed = product + digit
    index = index + usize.ONE
  }
  return Result<u64, BodyError>.succeed(parsed)
}

fn validateNameList<'value>(
  value: &[u8],
  policy: TrailerPolicy,
  fieldIndex: usize,
) -> Result<(), BodyError> {
  let mut cursor = usize.ZERO
  let mut count = usize.ZERO
  while cursor < value.length {
    while cursor < value.length && (value[cursor] == 32 || value[cursor] == 9) {
      cursor = cursor + usize.ONE
    }
    let start = cursor
    while cursor < value.length && tokenByte(value[cursor]) { cursor = cursor + usize.ONE }
    if cursor == start {
      return Result<(), BodyError>.failResult(selectionError(
        BodyReason.TrailerPolicy,
        BodyComponent.TrailerPolicy,
        fieldIndex,
      ))
    }
    let name = Slice.view<u8>(value, start, cursor - start)
    if staticallyForbidden(name) || !policyAllows(policy, name) {
      return Result<(), BodyError>.failResult(selectionError(
        BodyReason.TrailerPolicy,
        BodyComponent.TrailerPolicy,
        fieldIndex,
      ))
    }
    count = count + usize.ONE
    while cursor < value.length && (value[cursor] == 32 || value[cursor] == 9) {
      cursor = cursor + usize.ONE
    }
    if cursor < value.length {
      if value[cursor] != 44 {
        return Result<(), BodyError>.failResult(selectionError(
          BodyReason.TrailerPolicy,
          BodyComponent.TrailerPolicy,
          fieldIndex,
        ))
      }
      cursor = cursor + usize.ONE
      if cursor == value.length {
        return Result<(), BodyError>.failResult(selectionError(
          BodyReason.TrailerPolicy,
          BodyComponent.TrailerPolicy,
          fieldIndex,
        ))
      }
    }
  }
  if count == usize.ZERO {
    return Result<(), BodyError>.failResult(selectionError(
      BodyReason.TrailerPolicy,
      BodyComponent.TrailerPolicy,
      fieldIndex,
    ))
  }
  return Result<(), BodyError>.succeed(())
}

fn validateRequestTrailerExclusions<'value>(
  head: RequestHead<'value>,
) -> Result<(), BodyError> {
  let mut iterator = head.fields()
  let mut fieldIndex = usize.ZERO
  while true {
    let field = match move HeadHeaderIterator.next(&mut iterator) {
      Option<Header<'value>>.None => { break }
      Option<Header<'value>>.Some {value} => value
    }
    if asciiName(String.utf8Bytes(Header.name(&field)), b"trailer") {
      let value = Header.value(&field)
      let mut cursor = usize.ZERO
      while cursor < value.length {
        while cursor < value.length && (value[cursor] == 32 || value[cursor] == 9) {
          cursor = cursor + usize.ONE
        }
        let start = cursor
        while cursor < value.length && tokenByte(value[cursor]) { cursor = cursor + usize.ONE }
        let name = Slice.view<u8>(value, start, cursor - start)
        if connectionNominates(head.fields(), name) {
          return Result<(), BodyError>.failResult(selectionError(
            BodyReason.TrailerPolicy,
            BodyComponent.TrailerPolicy,
            fieldIndex,
          ))
        }
        while cursor < value.length && value[cursor] != 44 { cursor = cursor + usize.ONE }
        if cursor < value.length { cursor = cursor + usize.ONE }
      }
    }
    fieldIndex = fieldIndex + usize.ONE
  }
  return Result<(), BodyError>.succeed(())
}

fn validateResponseTrailerExclusions<'value>(
  head: ResponseHead<'value>,
) -> Result<(), BodyError> {
  let mut iterator = head.fields()
  let mut fieldIndex = usize.ZERO
  while true {
    let field = match move HeadHeaderIterator.next(&mut iterator) {
      Option<Header<'value>>.None => { break }
      Option<Header<'value>>.Some {value} => value
    }
    if asciiName(String.utf8Bytes(Header.name(&field)), b"trailer") {
      let value = Header.value(&field)
      let mut cursor = usize.ZERO
      while cursor < value.length {
        while cursor < value.length && (value[cursor] == 32 || value[cursor] == 9) {
          cursor = cursor + usize.ONE
        }
        let start = cursor
        while cursor < value.length && tokenByte(value[cursor]) { cursor = cursor + usize.ONE }
        let name = Slice.view<u8>(value, start, cursor - start)
        if connectionNominates(head.fields(), name) {
          return Result<(), BodyError>.failResult(selectionError(
            BodyReason.TrailerPolicy,
            BodyComponent.TrailerPolicy,
            fieldIndex,
          ))
        }
        while cursor < value.length && value[cursor] != 44 { cursor = cursor + usize.ONE }
        if cursor < value.length { cursor = cursor + usize.ONE }
      }
    }
    fieldIndex = fieldIndex + usize.ONE
  }
  return Result<(), BodyError>.succeed(())
}

// Whether a `Trailer` header may declare `name`. The default policy accepts any declaration that is
// not statically forbidden, because a received field it does not admit is discarded, not an error.
fn policyAllows(policy: TrailerPolicy, name: &[u8]) -> bool {
  return match move policy {
    TrailerPolicy.Default => true
    TrailerPolicy.Explicit {names} => {
      let mut index = usize.ZERO
      while index < names.length {
        if asciiName(name, String.utf8Bytes(names[index])) { return true }
        index = index + usize.ONE
      }
      return false
    }
  }
}

fn connectionNominates<'value>(fields: HeadHeaderIterator<'value>, candidate: &[u8]) -> bool {
  let mut iterator = move fields
  while true {
    let field = match move HeadHeaderIterator.next(&mut iterator) {
      Option<Header<'value>>.None => { return false }
      Option<Header<'value>>.Some {value: fieldValue} => fieldValue
    }
    if asciiName(String.utf8Bytes(Header.name(&field)), b"connection")
      && listContains(Header.value(&field), candidate) {
      return true
    }
  }
  return false
}

fn listContains(value: &[u8], candidate: &[u8]) -> bool {
  let mut cursor = usize.ZERO
  while cursor < value.length {
    while cursor < value.length
      && (value[cursor] == 32 || value[cursor] == 9 || value[cursor] == 44) {
      cursor = cursor + usize.ONE
    }
    let start = cursor
    while cursor < value.length && tokenByte(value[cursor]) { cursor = cursor + usize.ONE }
    if cursor > start && asciiName(Slice.view<u8>(value, start, cursor - start), candidate) {
      return true
    }
    while cursor < value.length && value[cursor] != 44 { cursor = cursor + usize.ONE }
  }
  return false
}

fn hasHeader<'value>(fields: HeadHeaderIterator<'value>, name: &[u8]) -> bool {
  let mut iterator = move fields
  while true {
    let field = match move HeadHeaderIterator.next(&mut iterator) {
      Option<Header<'value>>.None => { return false }
      Option<Header<'value>>.Some {value: fieldValue} => fieldValue
    }
    if asciiName(String.utf8Bytes(Header.name(&field)), name) { return true }
  }
  return false
}

fn selectionError(
  reason: BodyReason,
  component: BodyComponent,
  fieldIndex: usize,
) -> BodyError {
  return baseError(reason, component, u64.MIN, Option<usize>.some(fieldIndex))
}

fn baseError(
  reason: BodyReason,
  component: BodyComponent,
  offset: u64,
  fieldIndex: Option<usize>,
) -> BodyError {
  return BodyError {
    reason: reason,
    component: component,
    wireOffset: offset,
    consumed: usize.ZERO,
    written: usize.ZERO,
    totalWire: u64.MIN,
    totalPayload: u64.MIN,
    fieldIndex: move fieldIndex,
  }
}

fn asciiTrimmed(value: &[u8], expected: &[u8]) -> bool {
  let mut start = usize.ZERO
  let mut end = value.length
  while start < end && (value[start] == 32 || value[start] == 9) { start = start + usize.ONE }
  while end > start && (value[end - usize.ONE] == 32 || value[end - usize.ONE] == 9) {
    end = end - usize.ONE
  }
  return asciiName(Slice.view<u8>(value, start, end - start), expected)
}

fn asciiName(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut index = usize.ZERO
  while index < left.length {
    if asciiLower(left[index]) != asciiLower(right[index]) { return false }
    index = index + usize.ONE
  }
  return true
}

fn asciiLower(value: u8) -> u8 {
  if value >= 65 && value <= 90 { return value + 32 }
  return value
}

fn validToken(value: &[u8]) -> bool {
  if value.length == usize.ZERO { return false }
  let mut index = usize.ZERO
  while index < value.length {
    if !tokenByte(value[index]) { return false }
    index = index + usize.ONE
  }
  return true
}

fn tokenByte(value: u8) -> bool {
  if value >= 65 && value <= 90 { return true }
  if value >= 97 && value <= 122 { return true }
  if value >= 48 && value <= 57 { return true }
  return value == 33 || value == 35 || value == 36 || value == 37 || value == 38
    || value == 39 || value == 42 || value == 43 || value == 45 || value == 46
    || value == 94 || value == 95 || value == 96 || value == 124 || value == 126
}

fn staticallyForbidden(name: &[u8]) -> bool {
  return asciiName(name, b"content-length")
    || asciiName(name, b"transfer-encoding")
    || asciiName(name, b"host")
    || asciiName(name, b"connection")
    || asciiName(name, b"te")
    || asciiName(name, b"trailer")
    || asciiName(name, b"upgrade")
    || asciiName(name, b"authorization")
    || asciiName(name, b"proxy-authorization")
    || asciiName(name, b"www-authenticate")
    || asciiName(name, b"proxy-authenticate")
    || asciiName(name, b"cookie")
    || asciiName(name, b"set-cookie")
    || asciiName(name, b"content-encoding")
    || asciiName(name, b"content-type")
    || asciiName(name, b"content-range")
    || asciiName(name, b"content-location")
    || asciiName(name, b"range")
    || asciiName(name, b"cache-control")
    || asciiName(name, b"max-forwards")
    || asciiName(name, b"expect")
}

struct NameRecord {
  start: usize,
  length: usize,
}

impl Copy for NameRecord {}

struct StoredNames {
  bytes: Bytes,
  records: List<NameRecord>,
  defaultPolicy: bool,
}

enum DecoderPhase {
  Fixed,
  Close,
  ChunkLine,
  ChunkData,
  ChunkDataCr,
  ChunkDataLf,
  TrailerLine,
  Complete,
  Tunnel,
  Failed,
  Abandoned,
}

fn initialDecoderPhase(framing: Framing) -> DecoderPhase {
  return match framing {
    Framing.Empty => { return DecoderPhase.Complete }
    Framing.Fixed {length} => {
      if length == u64.MIN { return DecoderPhase.Complete }
      return DecoderPhase.Fixed
    }
    Framing.Chunked => { return DecoderPhase.ChunkLine }
    Framing.CloseDelimited => { return DecoderPhase.Close }
    Framing.Tunnel => { return DecoderPhase.Tunnel }
  }
}

fn isEmptyFraming(framing: Framing) -> bool {
  return match framing {
    Framing.Empty => true
    _ => false
  }
}

fn isFixedFraming(framing: Framing) -> bool {
  return match framing {
    Framing.Fixed {length} => { drop length return true }
    _ => false
  }
}

fn isChunkedFraming(framing: Framing) -> bool {
  return match framing {
    Framing.Chunked => true
    _ => false
  }
}

fn isCloseFraming(framing: Framing) -> bool {
  return match framing {
    Framing.CloseDelimited => true
    _ => false
  }
}

fn isTunnelFraming(framing: Framing) -> bool {
  return match framing {
    Framing.Tunnel => true
    _ => false
  }
}

struct DecoderCore {
  framing: Framing,
  limits: Limits,
  phase: DecoderPhase,
  remaining: u64,
  currentChunk: u64,
  chunks: usize,
  extensions: u64,
  line: Bytes,
  lineLength: usize,
  linePendingCr: bool,
  trailerBytes: Bytes,
  trailerLength: usize,
  trailerLineStart: usize,
  trailerPendingCr: bool,
  trailerRecords: Bytes,
  trailerCount: usize,
  trailerFieldBytes: usize,
  allowedNames: StoredNames,
  forbiddenNames: StoredNames,
  totalWire: u64,
  totalPayload: u64,
  finalSeen: bool,
  completionKind: CompletionKind,
  completionMarker: u8,
  failureReason: BodyReason,
  failureComponent: BodyComponent,
  failureOffset: u64,
  failureField: usize,
  failureHasField: bool,
}

/// Reads a body from wire bytes. Make it with [`Decoder.make`].
pub struct Decoder { core: DecoderCore }

impl Decoder {
  /// Returns a decoder for the framing in `selection`, and allocates all its memory.
  ///
  /// # Errors
  /// - `LimitExceeded` with `OwnedBytes` if the memory is more than `maxOwnedBytes`.
  /// - `OutOfMemoryError` if the `Allocator` fails.
  pub effect fn make<'head>(
    selection: Selection<'head>,
    limits: Limits,
    policy: TrailerPolicy,
  ) -> Result<Decoder, BodyError> ! OutOfMemoryError ? &mut Allocator {
    let framing = selection.framingValue
    let recordBytes = match move usize.checkedMultiply(limits.maxTrailerFields, FIELD_RECORD_BYTES) {
      Option<usize>.None => {
        return Result<Decoder, BodyError>.failResult(baseError(
          BodyReason.SizeOverflow,
          BodyComponent.Decoder,
          u64.MIN,
          Option<usize>.none(),
        ))
      }
      Option<usize>.Some {value} => value
    }
    let policyStats = match move policyNameStats(policy) {
      Result.Failure {error} => { return Result<Decoder, BodyError>.failResult(move error) }
      Result.Success {value} => move value
    }
    let connectionStats = match move connectionNameStats(move selection.statsFields) {
      Result.Failure {error} => { return Result<Decoder, BodyError>.failResult(move error) }
      Result.Success {value} => move value
    }
    let mut owned = match move usize.checkedAdd(limits.maxChunkLineBytes, limits.maxTrailerBytes) {
      Option<usize>.None => {
        return Result<Decoder, BodyError>.failResult(baseError(
          BodyReason.SizeOverflow,
          BodyComponent.Decoder,
          u64.MIN,
          Option<usize>.none(),
        ))
      }
      Option<usize>.Some {value} => value
    }
    owned = match move usize.checkedAdd(owned, recordBytes) {
      Option<usize>.None => {
        return Result<Decoder, BodyError>.failResult(baseError(
          BodyReason.SizeOverflow,
          BodyComponent.Decoder,
          u64.MIN,
          Option<usize>.none(),
        ))
      }
      Option<usize>.Some {value} => value
    }
    let policyRecords = match move usize.checkedMultiply(policyStats.count, NAME_RECORD_BYTES) {
      Option<usize>.None => {
        return Result<Decoder, BodyError>.failResult(baseError(
          BodyReason.SizeOverflow,
          BodyComponent.Decoder,
          u64.MIN,
          Option<usize>.none(),
        ))
      }
      Option<usize>.Some {value} => value
    }
    let connectionRecords = match move usize.checkedMultiply(
      connectionStats.count,
      NAME_RECORD_BYTES,
    ) {
      Option<usize>.None => {
        return Result<Decoder, BodyError>.failResult(baseError(
          BodyReason.SizeOverflow,
          BodyComponent.Decoder,
          u64.MIN,
          Option<usize>.none(),
        ))
      }
      Option<usize>.Some {value} => value
    }
    owned = match move checkedOwnedAdd(owned, policyStats.bytes, BodyComponent.Decoder) {
      Result.Failure {error} => { return Result<Decoder, BodyError>.failResult(move error) }
      Result.Success {value} => value
    }
    owned = match move checkedOwnedAdd(owned, policyRecords, BodyComponent.Decoder) {
      Result.Failure {error} => { return Result<Decoder, BodyError>.failResult(move error) }
      Result.Success {value} => value
    }
    owned = match move checkedOwnedAdd(owned, connectionStats.bytes, BodyComponent.Decoder) {
      Result.Failure {error} => { return Result<Decoder, BodyError>.failResult(move error) }
      Result.Success {value} => value
    }
    owned = match move checkedOwnedAdd(owned, connectionRecords, BodyComponent.Decoder) {
      Result.Failure {error} => { return Result<Decoder, BodyError>.failResult(move error) }
      Result.Success {value} => value
    }
    if owned > limits.maxOwnedBytes {
      return Result<Decoder, BodyError>.failResult(baseError(
        BodyReason.LimitExceeded {
          limit: BodyLimitKind.OwnedBytes,
          allowed: usize.toU64(limits.maxOwnedBytes),
          attempted: usize.toU64(owned),
        },
        BodyComponent.Decoder,
        u64.MIN,
        Option<usize>.none(),
      ))
    }
    let line = run Bytes.zeroed(limits.maxChunkLineBytes)
    let trailerBytes = run Bytes.zeroed(limits.maxTrailerBytes)
    let trailerRecords = run Bytes.zeroed(recordBytes)
    let allowedNames = run copyPolicyNames(policy, move policyStats)
    let forbiddenNames = run copyConnectionNames(move selection.copyFields, move connectionStats)
    let phase = initialDecoderPhase(framing)
    let remaining = match framing {
      Framing.Fixed {length} => length
      _ => u64.MIN
    }
    let completion = match framing {
      Framing.Empty => CompletionKind.Delimited
      Framing.Fixed {..} => CompletionKind.Delimited
      Framing.Tunnel => CompletionKind.Tunnel
      _ => CompletionKind.Delimited
    }
    return Result<Decoder, BodyError>.succeed(Decoder {
      core: DecoderCore {
        framing: framing,
        limits: limits,
        phase: phase,
        remaining: remaining,
        currentChunk: u64.MIN,
        chunks: usize.ZERO,
        extensions: u64.MIN,
        line: move line,
        lineLength: usize.ZERO,
        linePendingCr: false,
        trailerBytes: move trailerBytes,
        trailerLength: usize.ZERO,
        trailerLineStart: usize.ZERO,
        trailerPendingCr: false,
        trailerRecords: move trailerRecords,
        trailerCount: usize.ZERO,
        trailerFieldBytes: usize.ZERO,
        allowedNames: move allowedNames,
        forbiddenNames: move forbiddenNames,
        totalWire: u64.MIN,
        totalPayload: u64.MIN,
        finalSeen: false,
        completionKind: completion,
        completionMarker: 0,
        failureReason: BodyReason.InvalidState,
        failureComponent: BodyComponent.Decoder,
        failureOffset: u64.MIN,
        failureField: usize.ZERO,
        failureHasField: false,
      },
    })
  }

  /// Reads wire bytes from `input`, and writes payload bytes to `output`.
  ///
  /// # Details
  /// The decoder uses only the input bytes whose payload fits in `output`. Give the rest again in
  /// the next call. Set `finalInput` to `true` when the transport has no more bytes. For a body
  /// that ends with the connection, this completes the body. For other bodies, it makes an
  /// incomplete body fail with `Truncated`.
  pub fn step(
    self: &mut Self,
    input: &[u8],
    output: &mut [u8],
    finalInput: bool,
  ) -> Result<Progress, BodyError> {
    return decodeCore(&mut self.core, input, &mut output, finalInput, false, u64.MAX)
  }

  /// Reads and drops body bytes, for example to use the connection again without the body.
  ///
  /// `maxDiscardWireBytes` limits the total wire bytes of all discard calls. If more are needed, it
  /// fails with `DiscardLimit`.
  pub fn discard(
    self: &mut Self,
    input: &[u8],
    finalInput: bool,
    maxDiscardWireBytes: u64,
  ) -> Result<Progress, BodyError> {
    let mut empty: [u8; 0] = []
    return decodeCore(
      &mut self.core,
      input,
      &mut empty,
      finalInput,
      true,
      maxDiscardWireBytes,
    )
  }

  /// Returns proof that the body is complete, or `None`.
  pub fn completion<'owner>(self: &'owner Self) -> Option<Completion<'owner>> {
    if self.core.phase != DecoderPhase.Complete && self.core.phase != DecoderPhase.Tunnel {
      return Option<Completion<'owner>>.none()
    }
    return Option<Completion<'owner>>.some(Completion<'owner> {
      kindValue: self.core.completionKind,
      marker: &self.core.completionMarker,
    })
  }

  /// Returns the trailer fields of a complete chunked body, or `None`. They are separate from the
  /// fields of the head.
  pub fn trailers<'owner>(self: &'owner Self) -> Option<Trailers<'owner>> {
    if self.core.phase != DecoderPhase.Complete || !isChunkedFraming(self.core.framing) {
      return Option<Trailers<'owner>>.none()
    }
    return Option<Trailers<'owner>>.some(Trailers<'owner> {
      bytes: Slice.view<u8>(
        Bytes.asSlice(&self.core.trailerBytes),
        usize.ZERO,
        self.core.trailerLength,
      ),
      records: Slice.view<u8>(
        Bytes.asSlice(&self.core.trailerRecords),
        usize.ZERO,
        self.core.trailerCount * FIELD_RECORD_BYTES,
      ),
      countValue: self.core.trailerCount,
      limits: self.core.limits.trailerValues,
    })
  }

  /// Stops the decoder. Later calls fail. It does no I/O.
  pub fn abandon(self: &mut Self) -> () {
    if self.core.phase != DecoderPhase.Complete && self.core.phase != DecoderPhase.Tunnel {
      self.core.phase = DecoderPhase.Abandoned
    }
    return ()
  }
}

struct NameStats {
  bytes: usize,
  count: usize,
}

fn policyNameStats(policy: TrailerPolicy) -> Result<NameStats, BodyError> {
  return match move policy {
    TrailerPolicy.Default => Result<NameStats, BodyError>.succeed(NameStats {
      bytes: usize.ZERO,
      count: usize.ZERO,
    })
    TrailerPolicy.Explicit {names} => {
      let mut total = usize.ZERO
      let mut index = usize.ZERO
      while index < names.length {
        total = match move usize.checkedAdd(total, String.byteLength(names[index])) {
          Option.None => {
            return Result<NameStats, BodyError>.failResult(baseError(
              BodyReason.SizeOverflow,
              BodyComponent.TrailerPolicy,
              usize.toU64(index),
              Option<usize>.some(index),
            ))
          }
          Option.Some {value} => value
        }
        index = index + usize.ONE
      }
      return Result<NameStats, BodyError>.succeed(NameStats {
        bytes: total,
        count: names.length,
      })
    }
  }
}

fn connectionNameStats<'value>(
  fields: HeadHeaderIterator<'value>,
) -> Result<NameStats, BodyError> {
  let mut total = usize.ZERO
  let mut count = usize.ZERO
  let mut iterator = move fields
  while true {
    let field = match move HeadHeaderIterator.next(&mut iterator) {
      Option<Header<'value>>.None => { break }
      Option<Header<'value>>.Some {value} => value
    }
    if asciiName(String.utf8Bytes(Header.name(&field)), b"connection") {
      let value = Header.value(&field)
      let mut cursor = usize.ZERO
      while cursor < value.length {
        while cursor < value.length
          && (value[cursor] == 32 || value[cursor] == 9 || value[cursor] == 44) {
          cursor = cursor + usize.ONE
        }
        let start = cursor
        while cursor < value.length && tokenByte(value[cursor]) { cursor = cursor + usize.ONE }
        if cursor > start {
          total = match move usize.checkedAdd(total, cursor - start) {
            Option.None => {
              return Result<NameStats, BodyError>.failResult(baseError(
                BodyReason.SizeOverflow,
                BodyComponent.TrailerPolicy,
                usize.toU64(count),
                Option<usize>.none(),
              ))
            }
            Option.Some {value: nextTotal} => nextTotal
          }
          count = match move usize.checkedAdd(count, usize.ONE) {
            Option.None => {
              return Result<NameStats, BodyError>.failResult(baseError(
                BodyReason.SizeOverflow,
                BodyComponent.TrailerPolicy,
                usize.toU64(count),
                Option<usize>.none(),
              ))
            }
            Option.Some {value: nextCount} => nextCount
          }
        }
        while cursor < value.length && value[cursor] != 44 { cursor = cursor + usize.ONE }
      }
    }
  }
  return Result<NameStats, BodyError>.succeed(NameStats {bytes: total, count: count})
}

effect fn copyPolicyNames(
  policy: TrailerPolicy,
  stats: NameStats,
) -> StoredNames ! OutOfMemoryError ? &mut Allocator {
  let mut bytes = Bytes.make()
  let _reservedBytes = run Bytes.reserveExact(&mut bytes, stats.bytes)
  let mut records = List<NameRecord>.make()
  let _reservedRecords = run List<NameRecord>.reserveExact(&mut records, stats.count)
  let mut defaults = false
  match & policy {
    TrailerPolicy.Default => { defaults = true }
    TrailerPolicy.Explicit {..} => {}
  }
  match move policy {
    TrailerPolicy.Default => {}
    TrailerPolicy.Explicit {names} => {
      let mut index = usize.ZERO
      while index < names.length {
        let value = String.utf8Bytes(names[index])
        let start = Bytes.length(&bytes)
        let _appended = run Bytes.append(&mut bytes, value)
        let _recorded = run List<NameRecord>.append(&mut records, NameRecord {
          start: start,
          length: value.length,
        })
        index = index + usize.ONE
      }
    }
  }
  return StoredNames {bytes: move bytes, records: move records, defaultPolicy: defaults}
}

effect fn copyConnectionNames<'value>(
  fields: HeadHeaderIterator<'value>,
  stats: NameStats,
) -> StoredNames ! OutOfMemoryError ? &mut Allocator {
  let mut bytes = Bytes.make()
  let _reservedBytes = run Bytes.reserveExact(&mut bytes, stats.bytes)
  let mut records = List<NameRecord>.make()
  let _reservedRecords = run List<NameRecord>.reserveExact(&mut records, stats.count)
  let mut iterator = move fields
  while true {
    let field = match move HeadHeaderIterator.next(&mut iterator) {
      Option<Header<'value>>.None => { break }
      Option<Header<'value>>.Some {value} => value
    }
    if asciiName(String.utf8Bytes(Header.name(&field)), b"connection") {
      let value = Header.value(&field)
      let mut cursor = usize.ZERO
      while cursor < value.length {
        while cursor < value.length
          && (value[cursor] == 32 || value[cursor] == 9 || value[cursor] == 44) {
          cursor = cursor + usize.ONE
        }
        let start = cursor
        while cursor < value.length && tokenByte(value[cursor]) { cursor = cursor + usize.ONE }
        if cursor > start {
          let recordStart = Bytes.length(&bytes)
          let token = Slice.view<u8>(value, start, cursor - start)
          let _appended = run Bytes.append(&mut bytes, token)
          let _recorded = run List<NameRecord>.append(&mut records, NameRecord {
            start: recordStart,
            length: token.length,
          })
        }
        while cursor < value.length && value[cursor] != 44 { cursor = cursor + usize.ONE }
      }
    }
  }
  return StoredNames {bytes: move bytes, records: move records, defaultPolicy: false}
}

fn checkedOwnedAdd(
  current: usize,
  added: usize,
  component: BodyComponent,
) -> Result<usize, BodyError> {
  return match move usize.checkedAdd(current, added) {
    Option.None => Result<usize, BodyError>.failResult(baseError(
      BodyReason.SizeOverflow,
      component,
      u64.MIN,
      Option<usize>.none(),
    ))
    Option.Some {value} => Result<usize, BodyError>.succeed(value)
  }
}

fn decodeCore(
  core: &mut DecoderCore,
  input: &[u8],
  output: &mut [u8],
  finalInput: bool,
  discarding: bool,
  discardLimit: u64,
) -> Result<Progress, BodyError> {
  if core.phase == DecoderPhase.Failed || core.phase == DecoderPhase.Abandoned {
    return Result<Progress, BodyError>.failResult(decoderStateError(&core.*))
  }
  if core.phase == DecoderPhase.Complete {
    return Result<Progress, BodyError>.succeed(decoderProgress(
      &core.*,
      usize.ZERO,
      usize.ZERO,
      ProgressState.Complete,
    ))
  }
  if core.phase == DecoderPhase.Tunnel {
    return Result<Progress, BodyError>.succeed(decoderProgress(
      &core.*,
      usize.ZERO,
      usize.ZERO,
      ProgressState.Tunnel,
    ))
  }
  let mut consumed = usize.ZERO
  let mut written = usize.ZERO
  while consumed < input.length {
    if core.phase == DecoderPhase.Complete || core.phase == DecoderPhase.Tunnel { break }
    if core.phase == DecoderPhase.Fixed || core.phase == DecoderPhase.Close
      || core.phase == DecoderPhase.ChunkData {
      if core.phase == DecoderPhase.Fixed && core.remaining == 0 {
        completeDecoder(&mut core.*, CompletionKind.Delimited)
        break
      }
      if core.phase == DecoderPhase.ChunkData && core.currentChunk == 0 {
        core.phase = DecoderPhase.ChunkDataCr
        continue
      }
      if !discarding && written >= output.length {
        return Result<Progress, BodyError>.succeed(decoderProgress(
          &core.*,
          consumed,
          written,
          ProgressState.NeedOutput,
        ))
      }
      let payload = commitPayloadWire(
        &mut core.*,
        discarding,
        discardLimit,
        consumed,
        written,
        BodyComponent.ChunkPayload,
      )
      if let Result<(), BodyError>.Failure {error} = move payload {
        return Result<Progress, BodyError>.failResult(move error)
      }
      if !discarding {
        output[written] = input[consumed]
        written = written + usize.ONE
      }
      consumed = consumed + usize.ONE
      if core.phase == DecoderPhase.Fixed {
        core.remaining = core.remaining - 1
        if core.remaining == 0 { completeDecoder(&mut core.*, CompletionKind.Delimited) }
      } else if core.phase == DecoderPhase.ChunkData {
        core.currentChunk = core.currentChunk - 1
        if core.currentChunk == 0 { core.phase = DecoderPhase.ChunkDataCr }
      }
      continue
    }
    if core.phase == DecoderPhase.ChunkDataCr || core.phase == DecoderPhase.ChunkDataLf {
      let mut expected: u8 = 13
      if core.phase == DecoderPhase.ChunkDataLf { expected = 10 }
      if input[consumed] != expected {
        return Result<Progress, BodyError>.failResult(decoderFailure(
          &mut core.*,
          BodyReason.ChunkSyntax,
          BodyComponent.ChunkDelimiter,
          consumed,
          written,
          Option<usize>.none(),
        ))
      }
      let wire = commitWire(
        &mut core.*,
        discarding,
        discardLimit,
        consumed,
        written,
        BodyComponent.ChunkDelimiter,
      )
      if let Result<(), BodyError>.Failure {error} = move wire {
        return Result<Progress, BodyError>.failResult(move error)
      }
      consumed = consumed + usize.ONE
      if core.phase == DecoderPhase.ChunkDataCr {
        core.phase = DecoderPhase.ChunkDataLf
      } else {
        core.phase = DecoderPhase.ChunkLine
      }
      continue
    }
    if core.phase == DecoderPhase.ChunkLine {
      let byte = input[consumed]
      if core.linePendingCr && byte != 10 {
        return Result<Progress, BodyError>.failResult(decoderFailure(
          &mut core.*,
          BodyReason.ChunkSyntax,
          BodyComponent.ChunkLine,
          consumed,
          written,
          Option<usize>.none(),
        ))
      }
      if !core.linePendingCr && byte == 10 {
        return Result<Progress, BodyError>.failResult(decoderFailure(
          &mut core.*,
          BodyReason.ChunkSyntax,
          BodyComponent.ChunkLine,
          consumed,
          written,
          Option<usize>.none(),
        ))
      }
      let attempted = match move usize.checkedAdd(core.lineLength, usize.ONE) {
        Option.None => {
          return Result<Progress, BodyError>.failResult(decoderFailure(
            &mut core.*,
            BodyReason.SizeOverflow,
            BodyComponent.ChunkLine,
            consumed,
            written,
            Option<usize>.none(),
          ))
        }
        Option.Some {value} => value
      }
      if attempted > core.limits.maxChunkLineBytes {
        let allowed = core.limits.maxChunkLineBytes
        return Result<Progress, BodyError>.failResult(decoderLimitFailure(
          &mut core.*,
          BodyLimitKind.ChunkLineBytes,
          usize.toU64(allowed),
          usize.toU64(attempted),
          BodyComponent.ChunkLine,
          consumed,
          written,
          Option<usize>.none(),
        ))
      }
      let wire = commitWire(
        &mut core.*,
        discarding,
        discardLimit,
        consumed,
        written,
        BodyComponent.ChunkLine,
      )
      if let Result<(), BodyError>.Failure {error} = move wire {
        return Result<Progress, BodyError>.failResult(move error)
      }
      let mut lineStorage = Bytes.asMutSlice(&mut core.line)
      lineStorage[core.lineLength] = byte
      drop lineStorage
      core.lineLength = attempted
      consumed = consumed + usize.ONE
      if byte == 13 {
        core.linePendingCr = true
      } else if byte == 10 {
        core.linePendingCr = false
        let parsed = parseChunkLine(
          Slice.view<u8>(Bytes.asSlice(&core.line), usize.ZERO, core.lineLength - 2),
        )
        let chunk = match move parsed {
          Result<ChunkInfo, BodyError>.Failure {error} => {
            return Result<Progress, BodyError>.failResult(poisonWith(
              &mut core.*,
              move error,
              consumed,
              written,
            ))
          }
          Result<ChunkInfo, BodyError>.Success {value} => move value
        }
        let attemptedChunks = match move usize.checkedAdd(core.chunks, usize.ONE) {
          Option.None => {
            return Result<Progress, BodyError>.failResult(decoderFailure(
              &mut core.*,
              BodyReason.SizeOverflow,
              BodyComponent.ChunkLine,
              consumed,
              written,
              Option<usize>.none(),
            ))
          }
          Option.Some {value} => value
        }
        if attemptedChunks > core.limits.maxChunks {
          let allowed = core.limits.maxChunks
          return Result<Progress, BodyError>.failResult(decoderLimitFailure(
            &mut core.*,
            BodyLimitKind.Chunks,
            usize.toU64(allowed),
            usize.toU64(attemptedChunks),
            BodyComponent.ChunkLine,
            consumed,
            written,
            Option<usize>.none(),
          ))
        }
        if chunk.size > usize.toU64(core.limits.maxChunkBytes) {
          let allowed = core.limits.maxChunkBytes
          return Result<Progress, BodyError>.failResult(decoderLimitFailure(
            &mut core.*,
            BodyLimitKind.ChunkBytes,
            usize.toU64(allowed),
            chunk.size,
            BodyComponent.ChunkLine,
            consumed,
            written,
            Option<usize>.none(),
          ))
        }
        let nextExtensions = match move u64.checkedAdd(core.extensions, chunk.extensions) {
          Option<u64>.None => {
            return Result<Progress, BodyError>.failResult(decoderFailure(
              &mut core.*,
              BodyReason.SizeOverflow,
              BodyComponent.ChunkLine,
              consumed,
              written,
              Option<usize>.none(),
            ))
          }
          Option<u64>.Some {value} => value
        }
        if nextExtensions > core.limits.maxExtensionBytes {
          let allowed = core.limits.maxExtensionBytes
          return Result<Progress, BodyError>.failResult(decoderLimitFailure(
            &mut core.*,
            BodyLimitKind.ExtensionBytes,
            allowed,
            nextExtensions,
            BodyComponent.ChunkLine,
            consumed,
            written,
            Option<usize>.none(),
          ))
        }
        let payloadAfter = match move u64.checkedAdd(core.totalPayload, chunk.size) {
          Option<u64>.None => {
            return Result<Progress, BodyError>.failResult(decoderFailure(
              &mut core.*,
              BodyReason.SizeOverflow,
              BodyComponent.ChunkLine,
              consumed,
              written,
              Option<usize>.none(),
            ))
          }
          Option<u64>.Some {value} => value
        }
        if payloadAfter > core.limits.maxPayloadBytes {
          let allowed = core.limits.maxPayloadBytes
          return Result<Progress, BodyError>.failResult(decoderLimitFailure(
            &mut core.*,
            BodyLimitKind.PayloadBytes,
            allowed,
            payloadAfter,
            BodyComponent.ChunkPayload,
            consumed,
            written,
            Option<usize>.none(),
          ))
        }
        core.chunks = attemptedChunks
        core.extensions = nextExtensions
        core.currentChunk = chunk.size
        core.lineLength = usize.ZERO
        if chunk.size == 0 {
          core.phase = DecoderPhase.TrailerLine
          core.trailerLineStart = core.trailerLength
        } else {
          core.phase = DecoderPhase.ChunkData
        }
      }
      continue
    }
    if core.phase == DecoderPhase.TrailerLine {
      let byte = input[consumed]
      if core.trailerPendingCr && byte != 10 {
        let fieldIndex = core.trailerCount
        return Result<Progress, BodyError>.failResult(decoderFailure(
          &mut core.*,
          BodyReason.TrailerSyntax,
          BodyComponent.TrailerValue,
          consumed,
          written,
          Option<usize>.some(fieldIndex),
        ))
      }
      if !core.trailerPendingCr && byte == 10 {
        let fieldIndex = core.trailerCount
        return Result<Progress, BodyError>.failResult(decoderFailure(
          &mut core.*,
          BodyReason.TrailerSyntax,
          BodyComponent.TrailerValue,
          consumed,
          written,
          Option<usize>.some(fieldIndex),
        ))
      }
      let attempted = match move usize.checkedAdd(core.trailerLength, usize.ONE) {
        Option.None => {
          let fieldIndex = core.trailerCount
          return Result<Progress, BodyError>.failResult(decoderFailure(
            &mut core.*,
            BodyReason.SizeOverflow,
            BodyComponent.TrailerValue,
            consumed,
            written,
            Option<usize>.some(fieldIndex),
          ))
        }
        Option.Some {value} => value
      }
      if attempted > core.limits.maxTrailerBytes {
        let allowed = core.limits.maxTrailerBytes
        let fieldIndex = core.trailerCount
        return Result<Progress, BodyError>.failResult(decoderLimitFailure(
          &mut core.*,
          BodyLimitKind.TrailerBytes,
          usize.toU64(allowed),
          usize.toU64(attempted),
          BodyComponent.TrailerValue,
          consumed,
          written,
          Option<usize>.some(fieldIndex),
        ))
      }
      let wire = commitWire(
        &mut core.*,
        discarding,
        discardLimit,
        consumed,
        written,
        BodyComponent.TrailerValue,
      )
      if let Result<(), BodyError>.Failure {error} = move wire {
        return Result<Progress, BodyError>.failResult(move error)
      }
      let mut trailerStorage = Bytes.asMutSlice(&mut core.trailerBytes)
      trailerStorage[core.trailerLength] = byte
      drop trailerStorage
      core.trailerLength = attempted
      consumed = consumed + usize.ONE
      if byte == 13 {
        core.trailerPendingCr = true
      } else if byte == 10 {
        core.trailerPendingCr = false
        let lineLength = core.trailerLength - core.trailerLineStart - 2
        if lineLength == usize.ZERO {
          let retainedRecords = match move usize.checkedMultiply(
            core.trailerCount,
            FIELD_RECORD_BYTES,
          ) {
            Option.None => {
              return Result<Progress, BodyError>.failResult(decoderFailure(
                &mut core.*,
                BodyReason.SizeOverflow,
                BodyComponent.TrailerValue,
                consumed,
                written,
                Option<usize>.none(),
              ))
            }
            Option.Some {value} => value
          }
          let retainedOwned = match move usize.checkedAdd(core.trailerLength, retainedRecords) {
            Option.None => {
              return Result<Progress, BodyError>.failResult(decoderFailure(
                &mut core.*,
                BodyReason.SizeOverflow,
                BodyComponent.TrailerValue,
                consumed,
                written,
                Option<usize>.none(),
              ))
            }
            Option.Some {value} => value
          }
          if retainedOwned > core.limits.trailerValues.maxOwnedBytes {
            let allowed = core.limits.trailerValues.maxOwnedBytes
            return Result<Progress, BodyError>.failResult(decoderLimitFailure(
              &mut core.*,
              BodyLimitKind.OwnedBytes,
              usize.toU64(allowed),
              usize.toU64(retainedOwned),
              BodyComponent.TrailerValue,
              consumed,
              written,
              Option<usize>.none(),
            ))
          }
          completeDecoder(&mut core.*, CompletionKind.Delimited)
          break
        }
        let accepted = acceptTrailerLine(&mut core.*, lineLength)
        if let Result<(), BodyError>.Failure {error} = move accepted {
          return Result<Progress, BodyError>.failResult(poisonWith(
            &mut core.*,
            move error,
            consumed,
            written,
          ))
        }
        core.trailerLineStart = core.trailerLength
      }
      continue
    }
  }
  if finalInput && consumed == input.length {
    core.finalSeen = true
    if core.phase == DecoderPhase.Close {
      completeDecoder(&mut core.*, CompletionKind.CloseDelimited)
    } else if core.phase != DecoderPhase.Complete && core.phase != DecoderPhase.Tunnel {
      return Result<Progress, BodyError>.failResult(decoderFailure(
        &mut core.*,
        BodyReason.Truncated,
        BodyComponent.Decoder,
        consumed,
        written,
        Option<usize>.none(),
      ))
    }
  }
  let mut state = ProgressState.NeedInput
  if core.phase == DecoderPhase.Complete { state = ProgressState.Complete }
  if core.phase == DecoderPhase.Tunnel { state = ProgressState.Tunnel }
  return Result<Progress, BodyError>.succeed(decoderProgress(
    &core.*,
    consumed,
    written,
    state,
  ))
}

struct ChunkInfo {
  size: u64,
  extensions: u64,
}

fn parseChunkLine(line: &[u8]) -> Result<ChunkInfo, BodyError> {
  let mut cursor = usize.ZERO
  let mut size: u64 = 0
  while cursor < line.length && hexDigit(line[cursor]) {
    if size > u64.MAX / 16 {
      return Result<ChunkInfo, BodyError>.failResult(baseError(
        BodyReason.SizeOverflow,
        BodyComponent.ChunkLine,
        usize.toU64(cursor),
        Option<usize>.none(),
      ))
    }
    let product = size * 16
    let digit = hexValue(line[cursor])
    if digit > u64.MAX - product {
      return Result<ChunkInfo, BodyError>.failResult(baseError(
        BodyReason.SizeOverflow,
        BodyComponent.ChunkLine,
        usize.toU64(cursor),
        Option<usize>.none(),
      ))
    }
    size = product + digit
    cursor = cursor + usize.ONE
  }
  if cursor == usize.ZERO {
    return Result<ChunkInfo, BodyError>.failResult(baseError(
      BodyReason.ChunkSyntax,
      BodyComponent.ChunkLine,
      u64.MIN,
      Option<usize>.none(),
    ))
  }
  let extensionStart = cursor
  while cursor < line.length {
    if line[cursor] != 59 {
      return Result<ChunkInfo, BodyError>.failResult(baseError(
        BodyReason.ChunkSyntax,
        BodyComponent.ChunkLine,
        usize.toU64(cursor),
        Option<usize>.none(),
      ))
    }
    cursor = cursor + usize.ONE
    let nameStart = cursor
    while cursor < line.length && tokenByte(line[cursor]) { cursor = cursor + usize.ONE }
    if cursor == nameStart {
      return Result<ChunkInfo, BodyError>.failResult(baseError(
        BodyReason.ChunkSyntax,
        BodyComponent.ChunkLine,
        usize.toU64(cursor),
        Option<usize>.none(),
      ))
    }
    if cursor < line.length && line[cursor] == 61 {
      cursor = cursor + usize.ONE
      if cursor >= line.length {
        return Result<ChunkInfo, BodyError>.failResult(baseError(
          BodyReason.ChunkSyntax,
          BodyComponent.ChunkLine,
          usize.toU64(cursor),
          Option<usize>.none(),
        ))
      }
      if line[cursor] == 34 {
        cursor = cursor + usize.ONE
        let mut closed = false
        while cursor < line.length {
          let byte = line[cursor]
          if byte == 34 {
            cursor = cursor + usize.ONE
            closed = true
            break
          }
          if byte == 92 {
            cursor = cursor + usize.ONE
            if cursor >= line.length || !quotedPairByte(line[cursor]) {
              return Result<ChunkInfo, BodyError>.failResult(baseError(
                BodyReason.ChunkSyntax,
                BodyComponent.ChunkLine,
                usize.toU64(cursor),
                Option<usize>.none(),
              ))
            }
          } else if !quotedByte(byte) {
            return Result<ChunkInfo, BodyError>.failResult(baseError(
              BodyReason.ChunkSyntax,
              BodyComponent.ChunkLine,
              usize.toU64(cursor),
              Option<usize>.none(),
            ))
          }
          cursor = cursor + usize.ONE
        }
        if !closed {
          return Result<ChunkInfo, BodyError>.failResult(baseError(
            BodyReason.ChunkSyntax,
            BodyComponent.ChunkLine,
            usize.toU64(cursor),
            Option<usize>.none(),
          ))
        }
      } else {
        let valueStart = cursor
        while cursor < line.length && tokenByte(line[cursor]) { cursor = cursor + usize.ONE }
        if cursor == valueStart {
          return Result<ChunkInfo, BodyError>.failResult(baseError(
            BodyReason.ChunkSyntax,
            BodyComponent.ChunkLine,
            usize.toU64(cursor),
            Option<usize>.none(),
          ))
        }
      }
    }
  }
  return Result<ChunkInfo, BodyError>.succeed(ChunkInfo {
    size: size,
    extensions: usize.toU64(line.length - extensionStart),
  })
}

fn acceptTrailerLine(core: &mut DecoderCore, lineLength: usize) -> Result<(), BodyError> {
  let bytes = Bytes.asSlice(&core.trailerBytes)
  let start = core.trailerLineStart
  let end = match move usize.checkedAdd(start, lineLength) {
    Option.None => {
      return Result<(), BodyError>.failResult(baseError(
        BodyReason.SizeOverflow,
        BodyComponent.TrailerValue,
        usize.toU64(start),
        Option<usize>.some(core.trailerCount),
      ))
    }
    Option.Some {value} => value
  }
  let mut colon = start
  while colon < end && bytes[colon] != 58 { colon = colon + usize.ONE }
  if colon == start || colon >= end {
    return Result<(), BodyError>.failResult(baseError(
      BodyReason.TrailerSyntax,
      BodyComponent.TrailerName,
      usize.toU64(start),
      Option<usize>.some(core.trailerCount),
    ))
  }
  let name = Slice.view<u8>(bytes, start, colon - start)
  let nameLength = name.length
  if !validToken(name) {
    return Result<(), BodyError>.failResult(baseError(
      BodyReason.TrailerSyntax,
      BodyComponent.TrailerName,
      usize.toU64(start),
      Option<usize>.some(core.trailerCount),
    ))
  }
  if staticallyForbidden(name) || storedContains(&core.forbiddenNames, name) {
    return Result<(), BodyError>.failResult(baseError(
      BodyReason.TrailerPolicy,
      BodyComponent.TrailerPolicy,
      usize.toU64(start),
      Option<usize>.some(core.trailerCount),
    ))
  }
  // Any other field the policy does not admit is discarded, not an error (RFC 9110 section
  // 6.5.2): the body is still complete, and the field never reaches the application. Its bytes
  // still count toward the trailer limits.
  if !decoderAllows(&core.*, name) {
    return Result<(), BodyError>.succeed(())
  }
  if nameLength > core.limits.trailerValues.maxNameBytes {
    return Result<(), BodyError>.failResult(trailerLimitError(
      BodyLimitKind.TrailerNameBytes,
      core.limits.trailerValues.maxNameBytes,
      nameLength,
      BodyComponent.TrailerName,
      start,
      core.trailerCount,
    ))
  }
  let mut valueStart = colon + usize.ONE
  while valueStart < end && (bytes[valueStart] == 32 || bytes[valueStart] == 9) {
    valueStart = valueStart + usize.ONE
  }
  let mut valueEnd = end
  while valueEnd > valueStart && (bytes[valueEnd - usize.ONE] == 32
    || bytes[valueEnd - usize.ONE] == 9) {
    valueEnd = valueEnd - usize.ONE
  }
  let mut cursor = valueStart
  while cursor < valueEnd {
    let byte = bytes[cursor]
    if byte != 9 && (byte < 32 || byte == 127) {
      return Result<(), BodyError>.failResult(baseError(
        BodyReason.TrailerSyntax,
        BodyComponent.TrailerValue,
        usize.toU64(cursor),
        Option<usize>.some(core.trailerCount),
      ))
    }
    cursor = cursor + usize.ONE
  }
  let valueLength = valueEnd - valueStart
  if valueLength > core.limits.trailerValues.maxValueBytes {
    return Result<(), BodyError>.failResult(trailerLimitError(
      BodyLimitKind.TrailerValueBytes,
      core.limits.trailerValues.maxValueBytes,
      valueLength,
      BodyComponent.TrailerValue,
      valueStart,
      core.trailerCount,
    ))
  }
  let fieldBytes = match move usize.checkedAdd(nameLength, valueLength) {
    Option.None => {
      return Result<(), BodyError>.failResult(baseError(
        BodyReason.SizeOverflow,
        BodyComponent.TrailerValue,
        usize.toU64(start),
        Option<usize>.some(core.trailerCount),
      ))
    }
    Option.Some {value} => value
  }
  let nextFieldBytes = match move usize.checkedAdd(core.trailerFieldBytes, fieldBytes) {
    Option.None => {
      return Result<(), BodyError>.failResult(baseError(
        BodyReason.SizeOverflow,
        BodyComponent.TrailerValue,
        usize.toU64(start),
        Option<usize>.some(core.trailerCount),
      ))
    }
    Option.Some {value} => value
  }
  if nextFieldBytes > core.limits.trailerValues.maxFieldBytes {
    return Result<(), BodyError>.failResult(trailerLimitError(
      BodyLimitKind.TrailerFieldBytes,
      core.limits.trailerValues.maxFieldBytes,
      nextFieldBytes,
      BodyComponent.TrailerValue,
      start,
      core.trailerCount,
    ))
  }
  let attempted = match move usize.checkedAdd(core.trailerCount, usize.ONE) {
    Option.None => {
      return Result<(), BodyError>.failResult(baseError(
        BodyReason.SizeOverflow,
        BodyComponent.TrailerName,
        usize.toU64(start),
        Option<usize>.some(core.trailerCount),
      ))
    }
    Option.Some {value} => value
  }
  if attempted > core.limits.maxTrailerFields {
    return Result<(), BodyError>.failResult(trailerLimitError(
      BodyLimitKind.TrailerFields,
      core.limits.maxTrailerFields,
      attempted,
      BodyComponent.TrailerName,
      start,
      core.trailerCount,
    ))
  }
  if attempted > core.limits.trailerValues.maxFields {
    return Result<(), BodyError>.failResult(trailerLimitError(
      BodyLimitKind.TrailerFields,
      core.limits.trailerValues.maxFields,
      attempted,
      BodyComponent.TrailerName,
      start,
      core.trailerCount,
    ))
  }
  let retainedRecords = match move usize.checkedMultiply(attempted, FIELD_RECORD_BYTES) {
    Option.None => {
      return Result<(), BodyError>.failResult(baseError(
        BodyReason.SizeOverflow,
        BodyComponent.TrailerValue,
        usize.toU64(start),
        Option<usize>.some(core.trailerCount),
      ))
    }
    Option.Some {value} => value
  }
  let retainedOwned = match move usize.checkedAdd(core.trailerLength, retainedRecords) {
    Option.None => {
      return Result<(), BodyError>.failResult(baseError(
        BodyReason.SizeOverflow,
        BodyComponent.TrailerValue,
        usize.toU64(start),
        Option<usize>.some(core.trailerCount),
      ))
    }
    Option.Some {value} => value
  }
  if retainedOwned > core.limits.trailerValues.maxOwnedBytes {
    return Result<(), BodyError>.failResult(trailerLimitError(
      BodyLimitKind.OwnedBytes,
      core.limits.trailerValues.maxOwnedBytes,
      retainedOwned,
      BodyComponent.TrailerValue,
      start,
      core.trailerCount,
    ))
  }
  drop bytes
  writeFieldRecord(
    &mut core.trailerRecords,
    core.trailerCount,
    FieldRecord {
      nameStart: start,
      nameLength: nameLength,
      valueStart: valueStart,
      valueLength: valueLength,
    },
  )
  core.trailerCount = attempted
  core.trailerFieldBytes = nextFieldBytes
  return Result<(), BodyError>.succeed(())
}

fn trailerLimitError(
  limit: BodyLimitKind,
  allowed: usize,
  attempted: usize,
  component: BodyComponent,
  offset: usize,
  fieldIndex: usize,
) -> BodyError {
  return baseError(
    BodyReason.LimitExceeded {
      limit: limit,
      allowed: usize.toU64(allowed),
      attempted: usize.toU64(attempted),
    },
    component,
    usize.toU64(offset),
    Option<usize>.some(fieldIndex),
  )
}

fn decoderAllows(core: &DecoderCore, name: &[u8]) -> bool {
  if staticallyForbidden(name) || storedContains(&core.forbiddenNames, name) { return false }
  if core.allowedNames.defaultPolicy {
    return asciiName(name, b"content-digest") || asciiName(name, b"repr-digest")
  }
  return storedContains(&core.allowedNames, name)
}

fn storedPolicyAllows(allowed: &StoredNames, forbidden: &StoredNames, name: &[u8]) -> bool {
  if staticallyForbidden(name) || storedContains(forbidden, name) { return false }
  if allowed.defaultPolicy {
    return asciiName(name, b"content-digest") || asciiName(name, b"repr-digest")
  }
  return storedContains(allowed, name)
}

fn storedContains(names: &StoredNames, candidate: &[u8]) -> bool {
  let records = List<NameRecord>.asSlice(&names.records)
  let bytes = Bytes.asSlice(&names.bytes)
  let mut index = usize.ZERO
  while index < records.length {
    let record = records[index]
    if asciiName(Slice.view<u8>(bytes, record.start, record.length), candidate) { return true }
    index = index + usize.ONE
  }
  return false
}

fn commitWire(
  core: &mut DecoderCore,
  discarding: bool,
  discardLimit: u64,
  consumed: usize,
  written: usize,
  component: BodyComponent,
) -> Result<(), BodyError> {
  let attempted = match move u64.checkedAdd(core.totalWire, 1) {
    Option<u64>.None => {
      return Result<(), BodyError>.failResult(decoderFailure(
        &mut core.*,
        BodyReason.SizeOverflow,
        component,
        consumed,
        written,
        Option<usize>.none(),
      ))
    }
    Option<u64>.Some {value} => value
  }
  if discarding && attempted > discardLimit {
    return Result<(), BodyError>.failResult(decoderFailure(
      &mut core.*,
      BodyReason.DiscardLimit {allowed: discardLimit, attempted: attempted},
      BodyComponent.Discard,
      consumed,
      written,
      Option<usize>.none(),
    ))
  }
  if attempted > core.limits.maxWireBytes {
    let allowed = core.limits.maxWireBytes
    return Result<(), BodyError>.failResult(decoderLimitFailure(
      &mut core.*,
      BodyLimitKind.WireBytes,
      allowed,
      attempted,
      component,
      consumed,
      written,
      Option<usize>.none(),
    ))
  }
  core.totalWire = attempted
  return Result<(), BodyError>.succeed(())
}

fn commitPayloadWire(
  core: &mut DecoderCore,
  discarding: bool,
  discardLimit: u64,
  consumed: usize,
  written: usize,
  component: BodyComponent,
) -> Result<(), BodyError> {
  let nextWire = match move u64.checkedAdd(core.totalWire, 1) {
    Option<u64>.None => {
      return Result<(), BodyError>.failResult(decoderFailure(
        &mut core.*,
        BodyReason.SizeOverflow,
        component,
        consumed,
        written,
        Option<usize>.none(),
      ))
    }
    Option<u64>.Some {value} => value
  }
  let nextPayload = match move u64.checkedAdd(core.totalPayload, 1) {
    Option<u64>.None => {
      return Result<(), BodyError>.failResult(decoderFailure(
        &mut core.*,
        BodyReason.SizeOverflow,
        component,
        consumed,
        written,
        Option<usize>.none(),
      ))
    }
    Option<u64>.Some {value} => value
  }
  if discarding && nextWire > discardLimit {
    return Result<(), BodyError>.failResult(decoderFailure(
      &mut core.*,
      BodyReason.DiscardLimit {allowed: discardLimit, attempted: nextWire},
      BodyComponent.Discard,
      consumed,
      written,
      Option<usize>.none(),
    ))
  }
  if nextWire > core.limits.maxWireBytes {
    let allowed = core.limits.maxWireBytes
    return Result<(), BodyError>.failResult(decoderLimitFailure(
      &mut core.*,
      BodyLimitKind.WireBytes,
      allowed,
      nextWire,
      component,
      consumed,
      written,
      Option<usize>.none(),
    ))
  }
  if nextPayload > core.limits.maxPayloadBytes {
    let allowed = core.limits.maxPayloadBytes
    return Result<(), BodyError>.failResult(decoderLimitFailure(
      &mut core.*,
      BodyLimitKind.PayloadBytes,
      allowed,
      nextPayload,
      component,
      consumed,
      written,
      Option<usize>.none(),
    ))
  }
  core.totalWire = nextWire
  core.totalPayload = nextPayload
  return Result<(), BodyError>.succeed(())
}

fn completeDecoder(core: &mut DecoderCore, kind: CompletionKind) -> () {
  core.phase = DecoderPhase.Complete
  core.completionKind = kind
  return ()
}

fn decoderProgress(
  core: &DecoderCore,
  consumed: usize,
  written: usize,
  state: ProgressState,
) -> Progress {
  return Progress {
    consumed: consumed,
    written: written,
    totalWire: core.totalWire,
    totalPayload: core.totalPayload,
    state: state,
  }
}

fn decoderFailure(
  core: &mut DecoderCore,
  reason: BodyReason,
  component: BodyComponent,
  consumed: usize,
  written: usize,
  field: Option<usize>,
) -> BodyError {
  let offset = core.totalWire
  return decoderFailureAt(
    &mut core.*,
    reason,
    component,
    offset,
    consumed,
    written,
    move field,
  )
}

fn decoderFailureAt(
  core: &mut DecoderCore,
  reason: BodyReason,
  component: BodyComponent,
  offset: u64,
  consumed: usize,
  written: usize,
  field: Option<usize>,
) -> BodyError {
  core.phase = DecoderPhase.Failed
  core.failureReason = reason
  core.failureComponent = component
  core.failureOffset = offset
  core.failureHasField = false
  match & field {
    Option<usize>.None => {}
    Option<usize>.Some {value} => {
      core.failureField = value
      core.failureHasField = true
    }
  }
  return BodyError {
    reason: reason,
    component: component,
    wireOffset: offset,
    consumed: consumed,
    written: written,
    totalWire: core.totalWire,
    totalPayload: core.totalPayload,
    fieldIndex: move field,
  }
}

fn decoderLimitFailure(
  core: &mut DecoderCore,
  limit: BodyLimitKind,
  allowed: u64,
  attempted: u64,
  component: BodyComponent,
  consumed: usize,
  written: usize,
  field: Option<usize>,
) -> BodyError {
  return decoderFailure(
    &mut core.*,
    BodyReason.LimitExceeded {limit: limit, allowed: allowed, attempted: attempted},
    component,
    consumed,
    written,
    move field,
  )
}

fn poisonWith(
  core: &mut DecoderCore,
  error: BodyError,
  consumed: usize,
  written: usize,
) -> BodyError {
  let mut offset = core.totalWire
  if error.component == BodyComponent.ChunkLine {
    offset = core.totalWire - usize.toU64(core.lineLength) + error.wireOffset
  } else if error.component == BodyComponent.TrailerName
    || error.component == BodyComponent.TrailerValue
    || error.component == BodyComponent.TrailerPolicy {
    offset = core.totalWire - usize.toU64(core.trailerLength) + error.wireOffset
  }
  return decoderFailureAt(
    &mut core.*,
    error.reason,
    error.component,
    offset,
    consumed,
    written,
    move error.fieldIndex,
  )
}

fn decoderStateError(core: &DecoderCore) -> BodyError {
  return BodyError {
    reason: BodyReason.InvalidState,
    component: BodyComponent.Decoder,
    wireOffset: core.totalWire,
    consumed: usize.ZERO,
    written: usize.ZERO,
    totalWire: core.totalWire,
    totalPayload: core.totalPayload,
    fieldIndex: Option<usize>.none(),
  }
}

fn hexDigit(value: u8) -> bool {
  return (value >= 48 && value <= 57)
    || (value >= 65 && value <= 70)
    || (value >= 97 && value <= 102)
}

fn hexValue(value: u8) -> u64 {
  if value >= 48 && value <= 57 { return u8.toU64(value - 48) }
  if value >= 65 && value <= 70 { return u8.toU64(value - 65 + 10) }
  return u8.toU64(value - 97 + 10)
}

fn quotedByte(value: u8) -> bool {
  return value == 9 || value == 32 || value == 33
    || (value >= 35 && value <= 91)
    || (value >= 93 && value <= 126)
    || value >= 128
}

fn quotedPairByte(value: u8) -> bool {
  return value == 9 || value == 32 || (value >= 33 && value <= 126) || value >= 128
}

struct FieldRecord {
  nameStart: usize,
  nameLength: usize,
  valueStart: usize,
  valueLength: usize,
}

impl Copy for FieldRecord {}

fn writeFieldRecord(storage: &mut Bytes, index: usize, record: FieldRecord) -> () {
  let output = Bytes.asMutSlice(&mut storage.*)
  let base = index * FIELD_RECORD_BYTES
  writeUsize(&mut output, base, record.nameStart)
  writeUsize(&mut output, base + 8, record.nameLength)
  writeUsize(&mut output, base + 16, record.valueStart)
  writeUsize(&mut output, base + 24, record.valueLength)
  return ()
}

fn readFieldRecord(storage: &[u8], index: usize) -> FieldRecord {
  let base = index * FIELD_RECORD_BYTES
  return FieldRecord {
    nameStart: readUsize(storage, base),
    nameLength: readUsize(storage, base + 8),
    valueStart: readUsize(storage, base + 16),
    valueLength: readUsize(storage, base + 24),
  }
}

fn writeUsize(output: &mut [u8], offset: usize, value: usize) -> () {
  let wide = usize.toU64(value)
  let mut index = usize.ZERO
  while index < 8 {
    output[offset + index] = u64.toU8(u64.shiftRight(wide, usize.toU64(index * 8)))
    index = index + usize.ONE
  }
  return ()
}

fn readUsize(input: &[u8], offset: usize) -> usize {
  let mut value: u64 = 0
  let mut index = usize.ZERO
  while index < 8 {
    value = u64.bitOr(
      value,
      u64.shiftLeft(u8.toU64(input[offset + index]), usize.toU64(index * 8)),
    )
    index = index + usize.ONE
  }
  return u64.toUsize(value)
}

/// The trailer fields of a chunked body. They borrow the decoder.
pub struct Trailers<'owner> {
  bytes: &'owner [u8],
  records: &'owner [u8],
  countValue: usize,
  limits: ValueLimits,
}

impl<'owner> Trailers<'owner> {
  /// Returns the number of trailer fields.
  pub fn count(self: &Self) -> usize { return self.countValue }

  /// Returns the memory that [`Trailers.copy`] needs.
  pub fn requiredOwnedBytes(self: &Self) -> Result<usize, BodyError> {
    let recordBytes = match move usize.checkedMultiply(self.countValue, FIELD_RECORD_BYTES) {
      Option<usize>.None => {
        return Result<usize, BodyError>.failResult(baseError(
          BodyReason.SizeOverflow,
          BodyComponent.TrailerValue,
          u64.MIN,
          Option<usize>.none(),
        ))
      }
      Option<usize>.Some {value} => value
    }
    return match move usize.checkedAdd(self.bytes.length, recordBytes) {
      Option<usize>.None => Result<usize, BodyError>.failResult(baseError(
        BodyReason.SizeOverflow,
        BodyComponent.TrailerValue,
        u64.MIN,
        Option<usize>.none(),
      ))
      Option<usize>.Some {value} => Result<usize, BodyError>.succeed(value)
    }
  }

  /// Returns an iterator over the trailer fields, in order.
  pub fn fields(self: &'owner Self) -> TrailerIterator<'owner> {
    return TrailerIterator<'owner> {
      bytes: self.bytes,
      records: self.records,
      count: self.countValue,
      index: usize.ZERO,
      limits: self.limits,
    }
  }

  /// Copies the trailers into new memory, so that they do not borrow the decoder.
  pub effect fn copy(
    self: &'owner Self,
    limits: ValueLimits,
  ) -> Result<OwnedTrailers, BodyError> ! OutOfMemoryError ? &mut Allocator {
    let validated = validateTrailerCopy(self.bytes, self.records, self.countValue, limits)
    if let Result.Failure {error} = move validated {
      return Result<OwnedTrailers, BodyError>.failResult(move error)
    }
    let required = match move self.requiredOwnedBytes() {
      Result<usize, BodyError>.Failure {error} => {
        return Result<OwnedTrailers, BodyError>.failResult(move error)
      }
      Result<usize, BodyError>.Success {value} => value
    }
    if required > limits.maxOwnedBytes {
      return Result<OwnedTrailers, BodyError>.failResult(baseError(
        BodyReason.LimitExceeded {
          limit: BodyLimitKind.OwnedBytes,
          allowed: usize.toU64(limits.maxOwnedBytes),
          attempted: usize.toU64(required),
        },
        BodyComponent.TrailerValue,
        u64.MIN,
        Option<usize>.none(),
      ))
    }
    let bytes = run Bytes.copy(self.bytes)
    let records = run Bytes.copy(self.records)
    return Result<OwnedTrailers, BodyError>.succeed(OwnedTrailers {
      bytes: move bytes,
      records: move records,
      countValue: self.countValue,
      limits: limits,
    })
  }
}

/// Trailer fields that own their memory. Get a [`Trailers`] from it with [`OwnedTrailers.view`].
pub struct OwnedTrailers {
  bytes: Bytes,
  records: Bytes,
  countValue: usize,
  limits: ValueLimits,
}

impl OwnedTrailers {
  /// Returns the memory that this copy uses, in bytes.
  pub fn ownedBytes(self: &Self) -> usize {
    return Bytes.length(&self.bytes) + Bytes.length(&self.records)
  }

  /// Returns the trailers as a [`Trailers`] that borrows this value.
  pub fn view<'owner>(self: &'owner Self) -> Trailers<'owner> {
    return Trailers<'owner> {
      bytes: Bytes.asSlice(&self.bytes),
      records: Bytes.asSlice(&self.records),
      countValue: self.countValue,
      limits: self.limits,
    }
  }
}

/// An iterator over trailer fields, in order.
pub struct TrailerIterator<'owner> {
  bytes: &'owner [u8],
  records: &'owner [u8],
  count: usize,
  index: usize,
  limits: ValueLimits,
}

impl<'owner> TrailerIterator<'owner> {
  /// Returns the next trailer field, or `None` at the end.
  pub fn next(self: &mut Self) -> Option<Header<'owner>> {
    if self.index >= self.count { return Option<Header<'owner>>.none() }
    let record = readFieldRecord(self.records, self.index)
    self.index = self.index + usize.ONE
    let name = unsafe String.fromUtf8Unchecked(
      Slice.view<u8>(self.bytes, record.nameStart, record.nameLength),
    )
    let value = Slice.view<u8>(self.bytes, record.valueStart, record.valueLength)
    return match move Header.make(name, value, self.limits) {
      Result<Header<'owner>, ValueError>.Failure {..} => {
        return Intrinsic.trap("HTTP body: a stored header field no longer passes validation")
      }
      Result<Header<'owner>, ValueError>.Success {value: header} => {
        return Option<Header<'owner>>.some(move header)
      }
    }
  }
}

fn validateTrailerCopy(
  bytes: &[u8],
  records: &[u8],
  count: usize,
  limits: ValueLimits,
) -> Result<(), BodyError> {
  if count > limits.maxFields {
    return Result<(), BodyError>.failResult(trailerLimitError(
      BodyLimitKind.TrailerFields,
      limits.maxFields,
      count,
      BodyComponent.TrailerName,
      usize.ZERO,
      limits.maxFields,
    ))
  }
  let mut total = usize.ZERO
  let mut index = usize.ZERO
  while index < count {
    let record = readFieldRecord(records, index)
    if record.nameLength > limits.maxNameBytes {
      return Result<(), BodyError>.failResult(trailerLimitError(
        BodyLimitKind.TrailerNameBytes,
        limits.maxNameBytes,
        record.nameLength,
        BodyComponent.TrailerName,
        record.nameStart,
        index,
      ))
    }
    if record.valueLength > limits.maxValueBytes {
      return Result<(), BodyError>.failResult(trailerLimitError(
        BodyLimitKind.TrailerValueBytes,
        limits.maxValueBytes,
        record.valueLength,
        BodyComponent.TrailerValue,
        record.valueStart,
        index,
      ))
    }
    let fieldBytes = match move usize.checkedAdd(record.nameLength, record.valueLength) {
      Option.None => {
        return Result<(), BodyError>.failResult(baseError(
          BodyReason.SizeOverflow,
          BodyComponent.TrailerValue,
          usize.toU64(record.nameStart),
          Option<usize>.some(index),
        ))
      }
      Option.Some {value} => value
    }
    total = match move usize.checkedAdd(total, fieldBytes) {
      Option.None => {
        return Result<(), BodyError>.failResult(baseError(
          BodyReason.SizeOverflow,
          BodyComponent.TrailerValue,
          usize.toU64(record.nameStart),
          Option<usize>.some(index),
        ))
      }
      Option.Some {value} => value
    }
    if total > limits.maxFieldBytes {
      return Result<(), BodyError>.failResult(trailerLimitError(
        BodyLimitKind.TrailerFieldBytes,
        limits.maxFieldBytes,
        total,
        BodyComponent.TrailerValue,
        record.nameStart,
        index,
      ))
    }
    index = index + usize.ONE
  }
  return Result<(), BodyError>.succeed(())
}

enum EncoderPhase { Active, Finishing, Complete, Failed, Abandoned }

struct EncoderCore {
  framing: Framing,
  limits: Limits,
  phase: EncoderPhase,
  remaining: u64,
  chunks: usize,
  chunk: Bytes,
  chunkLength: usize,
  chunkOffset: usize,
  finish: Bytes,
  finishLength: usize,
  finishOffset: usize,
  allowedNames: StoredNames,
  forbiddenNames: StoredNames,
  totalWire: u64,
  totalPayload: u64,
  completionKind: CompletionKind,
  completionMarker: u8,
}

/// Writes a body with its framing. Make it with [`Encoder.make`].
pub struct Encoder { core: EncoderCore }

impl Encoder {
  /// Returns an encoder for the framing in `selection`, and allocates all its memory.
  ///
  /// # Errors
  /// - `UnsupportedTunnelEncoding` for `Tunnel` framing.
  /// - `OutOfMemoryError` if the `Allocator` fails.
  pub effect fn make<'head>(
    selection: Selection<'head>,
    limits: Limits,
    policy: TrailerPolicy,
  ) -> Result<Encoder, BodyError> ! OutOfMemoryError ? &mut Allocator {
    let framing = selection.framingValue
    if isTunnelFraming(framing) {
      return Result<Encoder, BodyError>.failResult(baseError(
        BodyReason.UnsupportedTunnelEncoding,
        BodyComponent.Encoder,
        u64.MIN,
        Option<usize>.none(),
      ))
    }
    let chunkCapacity = match move usize.checkedAdd(limits.maxChunkBytes, ENCODER_SYNTAX_BYTES) {
      Option<usize>.None => {
        return Result<Encoder, BodyError>.failResult(baseError(
          BodyReason.SizeOverflow,
          BodyComponent.Encoder,
          u64.MIN,
          Option<usize>.none(),
        ))
      }
      Option<usize>.Some {value} => value
    }
    let finishCapacity = match move usize.checkedAdd(limits.maxTrailerBytes, THREE) {
      Option<usize>.None => {
        return Result<Encoder, BodyError>.failResult(baseError(
          BodyReason.SizeOverflow,
          BodyComponent.Encoder,
          u64.MIN,
          Option<usize>.none(),
        ))
      }
      Option<usize>.Some {value} => value
    }
    let policyStats = match move policyNameStats(policy) {
      Result.Failure {error} => { return Result<Encoder, BodyError>.failResult(move error) }
      Result.Success {value} => move value
    }
    let connectionStats = match move connectionNameStats(move selection.statsFields) {
      Result.Failure {error} => { return Result<Encoder, BodyError>.failResult(move error) }
      Result.Success {value} => move value
    }
    let policyRecords = match move usize.checkedMultiply(policyStats.count, NAME_RECORD_BYTES) {
      Option<usize>.None => {
        return Result<Encoder, BodyError>.failResult(baseError(
          BodyReason.SizeOverflow,
          BodyComponent.Encoder,
          u64.MIN,
          Option<usize>.none(),
        ))
      }
      Option<usize>.Some {value} => value
    }
    let connectionRecords = match move usize.checkedMultiply(
      connectionStats.count,
      NAME_RECORD_BYTES,
    ) {
      Option<usize>.None => {
        return Result<Encoder, BodyError>.failResult(baseError(
          BodyReason.SizeOverflow,
          BodyComponent.Encoder,
          u64.MIN,
          Option<usize>.none(),
        ))
      }
      Option<usize>.Some {value} => value
    }
    let mut owned = match move usize.checkedAdd(chunkCapacity, finishCapacity) {
      Option.None => {
        return Result<Encoder, BodyError>.failResult(baseError(
          BodyReason.SizeOverflow,
          BodyComponent.Encoder,
          u64.MIN,
          Option<usize>.none(),
        ))
      }
      Option.Some {value} => value
    }
    owned = match move checkedOwnedAdd(owned, policyStats.bytes, BodyComponent.Encoder) {
      Result.Failure {error} => { return Result<Encoder, BodyError>.failResult(move error) }
      Result.Success {value} => value
    }
    owned = match move checkedOwnedAdd(owned, policyRecords, BodyComponent.Encoder) {
      Result.Failure {error} => { return Result<Encoder, BodyError>.failResult(move error) }
      Result.Success {value} => value
    }
    owned = match move checkedOwnedAdd(owned, connectionStats.bytes, BodyComponent.Encoder) {
      Result.Failure {error} => { return Result<Encoder, BodyError>.failResult(move error) }
      Result.Success {value} => value
    }
    owned = match move checkedOwnedAdd(owned, connectionRecords, BodyComponent.Encoder) {
      Result.Failure {error} => { return Result<Encoder, BodyError>.failResult(move error) }
      Result.Success {value} => value
    }
    if owned > limits.maxOwnedBytes {
      return Result<Encoder, BodyError>.failResult(baseError(
        BodyReason.LimitExceeded {
          limit: BodyLimitKind.OwnedBytes,
          allowed: usize.toU64(limits.maxOwnedBytes),
          attempted: usize.toU64(owned),
        },
        BodyComponent.Encoder,
        u64.MIN,
        Option<usize>.none(),
      ))
    }
    let chunk = run Bytes.zeroed(chunkCapacity)
    let finish = run Bytes.zeroed(finishCapacity)
    let allowedNames = run copyPolicyNames(policy, move policyStats)
    let forbiddenNames = run copyConnectionNames(move selection.copyFields, move connectionStats)
    let remaining = match framing {
      Framing.Fixed {length} => length
      _ => u64.MIN
    }
    return Result<Encoder, BodyError>.succeed(Encoder {
      core: EncoderCore {
        framing: framing,
        limits: limits,
        phase: EncoderPhase.Active,
        remaining: remaining,
        chunks: usize.ZERO,
        chunk: move chunk,
        chunkLength: usize.ZERO,
        chunkOffset: usize.ZERO,
        finish: move finish,
        finishLength: usize.ZERO,
        finishOffset: usize.ZERO,
        allowedNames: move allowedNames,
        forbiddenNames: move forbiddenNames,
        totalWire: u64.MIN,
        totalPayload: u64.MIN,
        completionKind: CompletionKind.Delimited,
        completionMarker: 0,
      },
    })
  }

  /// Takes payload bytes from `input`, and writes framed bytes to `output`.
  ///
  /// For chunked framing, the encoder writes a chunk for the bytes that it takes. With
  /// `NeedOutput`, send the output and call again.
  pub fn step(self: &mut Self, input: &[u8], output: &mut [u8]) -> Result<Progress, BodyError> {
    if self.core.phase != EncoderPhase.Active {
      return Result<Progress, BodyError>.failResult(encoderStateError(&self.core))
    }
    if isEmptyFraming(self.core.framing) {
      if input.length > usize.ZERO {
        return Result<Progress, BodyError>.failResult(encoderFailure(
          &mut self.core,
          BodyReason.UnexpectedPayload,
          usize.ZERO,
          usize.ZERO,
        ))
      }
      return Result<Progress, BodyError>.succeed(encoderProgress(
        &self.core,
        usize.ZERO,
        usize.ZERO,
        ProgressState.NeedInput,
      ))
    }
    if isChunkedFraming(self.core.framing) {
      return encodeChunked(&mut self.core, input, &mut output)
    }
    let available = usize.toU64(input.length)
    if let Framing.Fixed {..} = self.core.framing {
      if available > self.core.remaining {
        return Result<Progress, BodyError>.failResult(encoderFailure(
          &mut self.core,
          BodyReason.FixedLengthOverrun,
          usize.ZERO,
          usize.ZERO,
        ))
      }
    }
    let mut count = input.length
    if count > output.length { count = output.length }
    let mut index = usize.ZERO
    while index < count {
      let committed = encoderCommitByte(&mut self.core, input[index], &mut output, index)
      if let Result<(), BodyError>.Failure {error} = move committed {
        return Result<Progress, BodyError>.failResult(move error)
      }
      index = index + usize.ONE
      if isFixedFraming(self.core.framing) {
        self.core.remaining = self.core.remaining - 1
      }
    }
    let mut state = ProgressState.NeedInput
    if count < input.length { state = ProgressState.NeedOutput }
    return Result<Progress, BodyError>.succeed(encoderProgress(
      &self.core,
      count,
      count,
      state,
    ))
  }

  /// Starts the end of the body, with `trailers` for a chunked body. Then call
  /// [`Encoder.continueFinish`].
  ///
  /// # Errors
  /// - `FixedLengthUnderrun` if a fixed-length body did not get all its bytes.
  /// - `TrailerPolicy` or `TrailerSyntax` if a trailer is not valid. Nothing is written.
  pub fn beginFinish<'value>(
    self: &mut Self,
    trailers: &Headers<'value>,
  ) -> Result<(), BodyError> {
    if self.core.phase != EncoderPhase.Active || self.core.chunkOffset < self.core.chunkLength {
      return Result<(), BodyError>.failResult(encoderStateError(&self.core))
    }
    if isFixedFraming(self.core.framing) && self.core.remaining > u64.MIN {
      return Result<(), BodyError>.failResult(encoderFailure(
        &mut self.core,
        BodyReason.FixedLengthUnderrun,
        usize.ZERO,
        usize.ZERO,
      ))
    }
    if !isChunkedFraming(self.core.framing) && Headers.count(trailers) > usize.ZERO {
      return Result<(), BodyError>.failResult(encoderFailure(
        &mut self.core,
        BodyReason.TrailerPolicy,
        usize.ZERO,
        usize.ZERO,
      ))
    }
    if isEmptyFraming(self.core.framing) || isFixedFraming(self.core.framing) {
      self.core.phase = EncoderPhase.Complete
      self.core.completionKind = CompletionKind.Delimited
      return Result<(), BodyError>.succeed(())
    }
    if isCloseFraming(self.core.framing) {
      self.core.phase = EncoderPhase.Complete
      self.core.completionKind = CompletionKind.CloseDelimited
      return Result<(), BodyError>.succeed(())
    }
    let terminalChunks = match move usize.checkedAdd(self.core.chunks, usize.ONE) {
      Option<usize>.None => {
        return Result<(), BodyError>.failResult(encoderFailure(
          &mut self.core,
          BodyReason.SizeOverflow,
          usize.ZERO,
          usize.ZERO,
        ))
      }
      Option<usize>.Some {value} => value
    }
    if terminalChunks > self.core.limits.maxChunks {
      let allowed = self.core.limits.maxChunks
      return Result<(), BodyError>.failResult(encoderLimitFailure(
        &mut self.core,
        BodyLimitKind.Chunks,
        usize.toU64(allowed),
        usize.toU64(terminalChunks),
        usize.ZERO,
        usize.ZERO,
      ))
    }
    if THREE > self.core.limits.maxChunkLineBytes {
      let allowed = self.core.limits.maxChunkLineBytes
      return Result<(), BodyError>.failResult(encoderLimitFailure(
        &mut self.core,
        BodyLimitKind.ChunkLineBytes,
        usize.toU64(allowed),
        usize.toU64(THREE),
        usize.ZERO,
        usize.ZERO,
      ))
    }
    let required = match move validateFinishTrailers(
      trailers,
      &self.core.allowedNames,
      &self.core.forbiddenNames,
      self.core.limits,
    ) {
      Result<usize, BodyError>.Failure {error} => {
        return Result<(), BodyError>.failResult(encoderPoison(&mut self.core, move error))
      }
      Result<usize, BodyError>.Success {value} => value
    }
    let mut output = Bytes.asMutSlice(&mut self.core.finish)
    output[usize.ZERO] = 48
    output[usize.ONE] = 13
    output[TWO] = 10
    let mut cursor = THREE
    let mut iterator = Headers.iter(trailers)
    while true {
      let field = match move ValueHeaderIterator.next(&mut iterator) {
        Option<Header<'value>>.None => { break }
        Option<Header<'value>>.Some {value} => value
      }
      let name = String.utf8Bytes(Header.name(&field))
      let value = Header.value(&field)
      cursor = copyInto(&mut output, cursor, name)
      output[cursor] = 58
      output[cursor + usize.ONE] = 32
      cursor = cursor + TWO
      cursor = copyInto(&mut output, cursor, value)
      output[cursor] = 13
      output[cursor + usize.ONE] = 10
      cursor = cursor + TWO
    }
    output[cursor] = 13
    output[cursor + usize.ONE] = 10
    self.core.finishLength = required
    self.core.finishOffset = usize.ZERO
    self.core.chunks = terminalChunks
    self.core.phase = EncoderPhase.Finishing
    return Result<(), BodyError>.succeed(())
  }

  /// Writes the end of the body, such as the last chunk and the trailers, to `output`. Call it
  /// again while the state is `NeedOutput`.
  pub fn continueFinish(self: &mut Self, output: &mut [u8]) -> Result<Progress, BodyError> {
    if self.core.phase != EncoderPhase.Finishing {
      return Result<Progress, BodyError>.failResult(encoderStateError(&self.core))
    }
    let mut written = usize.ZERO
    while written < output.length && self.core.finishOffset < self.core.finishLength {
      let nextWire = match move u64.checkedAdd(self.core.totalWire, 1) {
        Option<u64>.None => {
          return Result<Progress, BodyError>.failResult(encoderFailure(
            &mut self.core,
            BodyReason.SizeOverflow,
            usize.ZERO,
            written,
          ))
        }
        Option<u64>.Some {value} => value
      }
      if nextWire > self.core.limits.maxWireBytes {
        let allowed = self.core.limits.maxWireBytes
        return Result<Progress, BodyError>.failResult(encoderLimitFailure(
          &mut self.core,
          BodyLimitKind.WireBytes,
          allowed,
          nextWire,
          usize.ZERO,
          written,
        ))
      }
      let finishBytes = Bytes.asSlice(&self.core.finish)
      let byte = finishBytes[self.core.finishOffset]
      drop finishBytes
      output[written] = byte
      self.core.finishOffset = self.core.finishOffset + usize.ONE
      self.core.totalWire = nextWire
      written = written + usize.ONE
    }
    if self.core.finishOffset == self.core.finishLength {
      self.core.phase = EncoderPhase.Complete
      self.core.completionKind = CompletionKind.Delimited
      return Result<Progress, BodyError>.succeed(encoderProgress(
        &self.core,
        usize.ZERO,
        written,
        ProgressState.Complete,
      ))
    }
    return Result<Progress, BodyError>.succeed(encoderProgress(
      &self.core,
      usize.ZERO,
      written,
      ProgressState.NeedOutput,
    ))
  }

  /// Returns proof that the whole body was written, or `None`.
  pub fn completion<'owner>(self: &'owner Self) -> Option<Completion<'owner>> {
    if self.core.phase != EncoderPhase.Complete {
      return Option<Completion<'owner>>.none()
    }
    return Option<Completion<'owner>>.some(Completion<'owner> {
      kindValue: self.core.completionKind,
      marker: &self.core.completionMarker,
    })
  }

  /// Stops the encoder without writing more bytes. Later calls fail. The body on the wire is
  /// incomplete.
  pub fn abandon(self: &mut Self) -> () {
    if self.core.phase != EncoderPhase.Complete { self.core.phase = EncoderPhase.Abandoned }
    return ()
  }
}

fn encodeChunked(
  core: &mut EncoderCore,
  input: &[u8],
  output: &mut [u8],
) -> Result<Progress, BodyError> {
  let mut consumed = usize.ZERO
  let firstDrain = drainChunk(&mut core.*, &mut output, usize.ZERO, usize.ZERO)
  let mut written = match move firstDrain {
    Result<usize, BodyError>.Failure {error} => {
      return Result<Progress, BodyError>.failResult(move error)
    }
    Result<usize, BodyError>.Success {value} => value
  }
  if core.chunkOffset < core.chunkLength {
    return Result<Progress, BodyError>.succeed(encoderProgress(
      &core.*,
      consumed,
      written,
      ProgressState.NeedOutput,
    ))
  }
  if input.length == usize.ZERO {
    return Result<Progress, BodyError>.succeed(encoderProgress(
      &core.*,
      consumed,
      written,
      ProgressState.NeedInput,
    ))
  }
  if core.limits.maxChunkBytes == usize.ZERO {
    return Result<Progress, BodyError>.failResult(encoderLimitFailure(
      &mut core.*,
      BodyLimitKind.ChunkBytes,
      u64.MIN,
      usize.toU64(input.length),
      usize.ZERO,
      written,
    ))
  }
  let mut accepted = input.length
  if accepted > core.limits.maxChunkBytes { accepted = core.limits.maxChunkBytes }
  let attemptedChunks = match move usize.checkedAdd(core.chunks, usize.ONE) {
    Option<usize>.None => {
      return Result<Progress, BodyError>.failResult(encoderFailure(
        &mut core.*,
        BodyReason.SizeOverflow,
        usize.ZERO,
        written,
      ))
    }
    Option<usize>.Some {value} => value
  }
  if attemptedChunks > core.limits.maxChunks {
    let allowed = core.limits.maxChunks
    return Result<Progress, BodyError>.failResult(encoderLimitFailure(
      &mut core.*,
      BodyLimitKind.Chunks,
      usize.toU64(allowed),
      usize.toU64(attemptedChunks),
      usize.ZERO,
      written,
    ))
  }
  let payloadAfter = match move u64.checkedAdd(core.totalPayload, usize.toU64(accepted)) {
    Option<u64>.None => {
      return Result<Progress, BodyError>.failResult(encoderFailure(
        &mut core.*,
        BodyReason.SizeOverflow,
        usize.ZERO,
        written,
      ))
    }
    Option<u64>.Some {value} => value
  }
  if payloadAfter > core.limits.maxPayloadBytes {
    let allowed = core.limits.maxPayloadBytes
    return Result<Progress, BodyError>.failResult(encoderLimitFailure(
      &mut core.*,
      BodyLimitKind.PayloadBytes,
      allowed,
      payloadAfter,
      usize.ZERO,
      written,
    ))
  }
  let maximumLine = core.limits.maxChunkLineBytes
  let mut storage = Bytes.asMutSlice(&mut core.chunk)
  let headerLength = writeHexLine(accepted, &mut storage)
  if headerLength > maximumLine {
    drop storage
    return Result<Progress, BodyError>.failResult(encoderLimitFailure(
      &mut core.*,
      BodyLimitKind.ChunkLineBytes,
      usize.toU64(maximumLine),
      usize.toU64(headerLength),
      usize.ZERO,
      written,
    ))
  }
  let mut index = usize.ZERO
  while index < accepted {
    storage[headerLength + index] = input[index]
    index = index + usize.ONE
  }
  storage[headerLength + accepted] = 13
  storage[headerLength + accepted + usize.ONE] = 10
  let framedLength = headerLength + accepted + TWO
  drop storage
  core.chunkLength = framedLength
  core.chunkOffset = usize.ZERO
  core.totalPayload = payloadAfter
  core.chunks = attemptedChunks
  consumed = accepted
  if written < output.length {
    let drained = drainChunk(&mut core.*, &mut output, written, accepted)
    let additional = match move drained {
      Result<usize, BodyError>.Failure {error} => {
        return Result<Progress, BodyError>.failResult(move error)
      }
      Result<usize, BodyError>.Success {value} => value
    }
    written = written + additional
  }
  let mut state = ProgressState.NeedInput
  if core.chunkOffset < core.chunkLength { state = ProgressState.NeedOutput }
  return Result<Progress, BodyError>.succeed(encoderProgress(
    &core.*,
    consumed,
    written,
    state,
  ))
}

fn drainChunk(
  core: &mut EncoderCore,
  output: &mut [u8],
  start: usize,
  consumed: usize,
) -> Result<usize, BodyError> {
  let mut written = usize.ZERO
  while start + written < output.length && core.chunkOffset < core.chunkLength {
    let nextWire = match move u64.checkedAdd(core.totalWire, 1) {
      Option<u64>.None => {
        return Result<usize, BodyError>.failResult(encoderFailure(
          &mut core.*,
          BodyReason.SizeOverflow,
          consumed,
          start + written,
        ))
      }
      Option<u64>.Some {value} => value
    }
    if nextWire > core.limits.maxWireBytes {
      let allowed = core.limits.maxWireBytes
      return Result<usize, BodyError>.failResult(encoderLimitFailure(
        &mut core.*,
        BodyLimitKind.WireBytes,
        allowed,
        nextWire,
        consumed,
        start + written,
      ))
    }
    let chunkBytes = Bytes.asSlice(&core.chunk)
    let byte = chunkBytes[core.chunkOffset]
    drop chunkBytes
    output[start + written] = byte
    core.chunkOffset = core.chunkOffset + usize.ONE
    core.totalWire = nextWire
    written = written + usize.ONE
  }
  return Result<usize, BodyError>.succeed(written)
}

fn encoderCommitByte(
  core: &mut EncoderCore,
  byte: u8,
  output: &mut [u8],
  index: usize,
) -> Result<(), BodyError> {
  let nextWire = match move u64.checkedAdd(core.totalWire, 1) {
    Option<u64>.None => {
      return Result<(), BodyError>.failResult(encoderFailure(
        &mut core.*,
        BodyReason.SizeOverflow,
        index,
        index,
      ))
    }
    Option<u64>.Some {value} => value
  }
  let nextPayload = match move u64.checkedAdd(core.totalPayload, 1) {
    Option<u64>.None => {
      return Result<(), BodyError>.failResult(encoderFailure(
        &mut core.*,
        BodyReason.SizeOverflow,
        index,
        index,
      ))
    }
    Option<u64>.Some {value} => value
  }
  if nextWire > core.limits.maxWireBytes {
    let allowed = core.limits.maxWireBytes
    return Result<(), BodyError>.failResult(encoderLimitFailure(
      &mut core.*,
      BodyLimitKind.WireBytes,
      allowed,
      nextWire,
      index,
      index,
    ))
  }
  if nextPayload > core.limits.maxPayloadBytes {
    let allowed = core.limits.maxPayloadBytes
    return Result<(), BodyError>.failResult(encoderLimitFailure(
      &mut core.*,
      BodyLimitKind.PayloadBytes,
      allowed,
      nextPayload,
      index,
      index,
    ))
  }
  output[index] = byte
  core.totalWire = nextWire
  core.totalPayload = nextPayload
  return Result<(), BodyError>.succeed(())
}

fn validateFinishTrailers<'value>(
  trailers: &Headers<'value>,
  allowed: &StoredNames,
  forbidden: &StoredNames,
  limits: Limits,
) -> Result<usize, BodyError> {
  let count = Headers.count(trailers)
  if count > limits.maxTrailerFields {
    return Result<usize, BodyError>.failResult(baseError(
      BodyReason.LimitExceeded {
        limit: BodyLimitKind.TrailerFields,
        allowed: usize.toU64(limits.maxTrailerFields),
        attempted: usize.toU64(count),
      },
      BodyComponent.TrailerName,
      u64.MIN,
      Option<usize>.some(limits.maxTrailerFields),
    ))
  }
  if count > limits.trailerValues.maxFields {
    return Result<usize, BodyError>.failResult(trailerLimitError(
      BodyLimitKind.TrailerFields,
      limits.trailerValues.maxFields,
      count,
      BodyComponent.TrailerName,
      usize.ZERO,
      limits.trailerValues.maxFields,
    ))
  }
  let mut required = TWO
  let mut fieldBytes = usize.ZERO
  let mut iterator = Headers.iter(trailers)
  let mut index = usize.ZERO
  while true {
    let field = match move ValueHeaderIterator.next(&mut iterator) {
      Option<Header<'value>>.None => { break }
      Option<Header<'value>>.Some {value} => value
    }
    let name = String.utf8Bytes(Header.name(&field))
    let fieldValue = Header.value(&field)
    if name.length > limits.trailerValues.maxNameBytes {
      return Result<usize, BodyError>.failResult(trailerLimitError(
        BodyLimitKind.TrailerNameBytes,
        limits.trailerValues.maxNameBytes,
        name.length,
        BodyComponent.TrailerName,
        required,
        index,
      ))
    }
    if fieldValue.length > limits.trailerValues.maxValueBytes {
      return Result<usize, BodyError>.failResult(trailerLimitError(
        BodyLimitKind.TrailerValueBytes,
        limits.trailerValues.maxValueBytes,
        fieldValue.length,
        BodyComponent.TrailerValue,
        required,
        index,
      ))
    }
    if !storedPolicyAllows(allowed, forbidden, name) {
      return Result<usize, BodyError>.failResult(baseError(
        BodyReason.TrailerPolicy,
        BodyComponent.TrailerPolicy,
        u64.MIN,
        Option<usize>.some(index),
      ))
    }
    let semantic = match move usize.checkedAdd(name.length, fieldValue.length) {
      Option.None => {
        return Result<usize, BodyError>.failResult(baseError(
          BodyReason.SizeOverflow,
          BodyComponent.Encoder,
          u64.MIN,
          Option<usize>.some(index),
        ))
      }
      Option.Some {value: semanticValue} => semanticValue
    }
    fieldBytes = match move usize.checkedAdd(fieldBytes, semantic) {
      Option.None => {
        return Result<usize, BodyError>.failResult(baseError(
          BodyReason.SizeOverflow,
          BodyComponent.Encoder,
          u64.MIN,
          Option<usize>.some(index),
        ))
      }
      Option.Some {value: totalFields} => totalFields
    }
    if fieldBytes > limits.trailerValues.maxFieldBytes {
      return Result<usize, BodyError>.failResult(trailerLimitError(
        BodyLimitKind.TrailerFieldBytes,
        limits.trailerValues.maxFieldBytes,
        fieldBytes,
        BodyComponent.TrailerValue,
        required,
        index,
      ))
    }
    let line = match move usize.checkedAdd(semantic, FOUR) {
      Option.None => {
        return Result<usize, BodyError>.failResult(baseError(
          BodyReason.SizeOverflow,
          BodyComponent.Encoder,
          u64.MIN,
          Option<usize>.some(index),
        ))
      }
      Option.Some {value: lineValue} => lineValue
    }
    required = match move usize.checkedAdd(required, line) {
      Option<usize>.None => {
        return Result<usize, BodyError>.failResult(baseError(
          BodyReason.SizeOverflow,
          BodyComponent.Encoder,
          u64.MIN,
          Option<usize>.some(index),
        ))
      }
      Option<usize>.Some {value} => value
    }
    index = index + usize.ONE
  }
  if required > limits.maxTrailerBytes {
    return Result<usize, BodyError>.failResult(baseError(
      BodyReason.LimitExceeded {
        limit: BodyLimitKind.TrailerBytes,
        allowed: usize.toU64(limits.maxTrailerBytes),
        attempted: usize.toU64(required),
      },
      BodyComponent.TrailerValue,
      u64.MIN,
      Option<usize>.none(),
    ))
  }
  let finishRequired = match move usize.checkedAdd(required, THREE) {
    Option.None => {
      return Result<usize, BodyError>.failResult(baseError(
        BodyReason.SizeOverflow,
        BodyComponent.Encoder,
        u64.MIN,
        Option<usize>.none(),
      ))
    }
    Option.Some {value} => value
  }
  if finishRequired > limits.trailerValues.maxOwnedBytes {
    return Result<usize, BodyError>.failResult(trailerLimitError(
      BodyLimitKind.OwnedBytes,
      limits.trailerValues.maxOwnedBytes,
      finishRequired,
      BodyComponent.Encoder,
      usize.ZERO,
      usize.ZERO,
    ))
  }
  return Result<usize, BodyError>.succeed(finishRequired)
}

fn writeHexLine(value: usize, output: &mut [u8]) -> usize {
  let mut digits = usize.ONE
  let mut remaining = value
  while remaining >= 16 {
    digits = digits + usize.ONE
    remaining = remaining / 16
  }
  let mut index = digits
  remaining = value
  while index > usize.ZERO {
    index = index - usize.ONE
    let digit = remaining % 16
    let mut encoded = usize.toU8(digit + 48)
    if digit >= 10 { encoded = usize.toU8(digit - 10 + 97) }
    output[index] = encoded
    remaining = remaining / 16
  }
  output[digits] = 13
  output[digits + usize.ONE] = 10
  return digits + 2
}

fn copyInto(output: &mut [u8], start: usize, input: &[u8]) -> usize {
  Slice.copyInto<u8>(&mut output, start, input)
  return start + input.length
}

fn encoderProgress(
  core: &EncoderCore,
  consumed: usize,
  written: usize,
  state: ProgressState,
) -> Progress {
  return Progress {
    consumed: consumed,
    written: written,
    totalWire: core.totalWire,
    totalPayload: core.totalPayload,
    state: state,
  }
}

fn encoderFailure(
  core: &mut EncoderCore,
  reason: BodyReason,
  consumed: usize,
  written: usize,
) -> BodyError {
  core.phase = EncoderPhase.Failed
  return BodyError {
    reason: reason,
    component: BodyComponent.Encoder,
    wireOffset: core.totalWire,
    consumed: consumed,
    written: written,
    totalWire: core.totalWire,
    totalPayload: core.totalPayload,
    fieldIndex: Option<usize>.none(),
  }
}

fn encoderPoison(core: &mut EncoderCore, error: BodyError) -> BodyError {
  core.phase = EncoderPhase.Failed
  return BodyError {
    reason: error.reason,
    component: error.component,
    wireOffset: core.totalWire,
    consumed: usize.ZERO,
    written: usize.ZERO,
    totalWire: core.totalWire,
    totalPayload: core.totalPayload,
    fieldIndex: move error.fieldIndex,
  }
}

fn encoderLimitFailure(
  core: &mut EncoderCore,
  limit: BodyLimitKind,
  allowed: u64,
  attempted: u64,
  consumed: usize,
  written: usize,
) -> BodyError {
  return encoderFailure(
    &mut core.*,
    BodyReason.LimitExceeded {limit: limit, allowed: allowed, attempted: attempted},
    consumed,
    written,
  )
}

fn encoderStateError(core: &EncoderCore) -> BodyError {
  return BodyError {
    reason: BodyReason.InvalidState,
    component: BodyComponent.Encoder,
    wireOffset: core.totalWire,
    consumed: usize.ZERO,
    written: usize.ZERO,
    totalWire: core.totalWire,
    totalPayload: core.totalPayload,
    fieldIndex: Option<usize>.none(),
  }
}
