//! Make the value of an `Authorization: Basic` header from a username and a password.
//!
//! # When to use
//! Use [`encodeInto`] to make the header value for HTTP Basic authentication. Use [`encodedLength`]
//! first to size the output buffer.
//!
//! # Details
//! The value is `Basic ` and the Base64 of `username:password`. You choose the character encoding
//! of the credentials, usually UTF-8. You also give a scratch buffer for `username:password`.
//! Nothing is written to a buffer if a check fails.
//!
//! # Errors
//! - [`BasicError`] if a credential has a byte that is not allowed, or a buffer is too small.
//!
//! # Gotchas
//! Basic credentials are not encrypted. Send them only over HTTPS. After the call, the scratch
//! buffer holds the password as plain text. Overwrite it when you are done.
//!
//! # Examples
//! ## Encode credentials
//! ```silk
//! import silk.http.basic { BasicError, encodeInto, encodedLength }
//! import silk.core.result { Result }
//!
//! pub fn main() -> i32 {
//!   let mut scratch: [u8; 64] = [0; 64]
//!   let mut output: [u8; 64] = [0; 64]
//!   let length = match encodeInto(b"Aladdin", b"open sesame", &mut scratch, &mut output) {
//!     Result<usize, BasicError>.Success { value } => value
//!     Result<usize, BasicError>.Failure { error: _ } => {
//!       return 1
//!     }
//!   }
//!
//!   // "Basic QWxhZGRpbjpvcGVuIHNlc2FtZQ=="
//!   if length != 34 || output[6] != 81 || output[33] != 61 {
//!     return 1
//!   }
//!   let size = match encodedLength(7, 11) {
//!     Result<usize, BasicError>.Success { value } => value
//!     Result<usize, BasicError>.Failure { error: _ } => 0
//!   }
//!   if size != length {
//!     return 1
//!   }
//!
//!   // A colon in the username fails.
//!   let colon = match encodeInto(b"a:b", b"c", &mut scratch, &mut output) {
//!     Result<usize, BasicError>.Success { value: _ } => false
//!     Result<usize, BasicError>.Failure { error } => error == BasicError.InvalidUsername
//!   }
//!   if !colon {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category HTTP

import silk.encoding.base64 {Base64, Base64Error}
import silk.format {Debug, Format, Formatter}
import silk.core.result {Result}
import silk.collections.slice {Slice}
import silk.num.usize
import silk.io.writer {Writer, WriterError}

/// The reason that [`encodeInto`] failed. It never holds the credentials.
pub enum BasicError {
  /// The username contains a colon, a control byte, or DEL.
  InvalidUsername,
  /// The password contains a control byte or DEL.
  InvalidPassword,
  /// The length of the result does not fit in `usize`.
  SizeOverflow,
  /// The scratch buffer cannot hold `username:password`.
  ScratchTooSmall,
  /// The output buffer cannot hold the whole value. See [`encodedLength`].
  OutputTooSmall,
}

impl Debug for BasicError {
  /// Writes the name of the variant, such as `InvalidUsername`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      BasicError.InvalidUsername => run Format.write(&mut formatter, b"InvalidUsername")
      BasicError.InvalidPassword => run Format.write(&mut formatter, b"InvalidPassword")
      BasicError.SizeOverflow => run Format.write(&mut formatter, b"SizeOverflow")
      BasicError.ScratchTooSmall => run Format.write(&mut formatter, b"ScratchTooSmall")
      BasicError.OutputTooSmall => run Format.write(&mut formatter, b"OutputTooSmall")
    }
  }
}

/// Returns the length of the header value for credentials of these lengths, including `Basic `.
pub fn encodedLength(usernameLength: usize, passwordLength: usize) -> Result<usize, BasicError> {
  if usernameLength == usize.MAX || passwordLength > usize.MAX - usernameLength - usize.ONE {
    return Result<usize, BasicError>.failResult(BasicError.SizeOverflow)
  }
  let rawLength = usernameLength + usize.ONE + passwordLength
  let measured = Base64.encodedLength(rawLength)
  let length = match move measured {
    Result<usize, Base64Error>.Failure {error} => {
      return Result<usize, BasicError>.failResult(BasicError.SizeOverflow)
    }
    Result<usize, Base64Error>.Success {value} => value
  }
  if length > usize.MAX - 6 {
    return Result<usize, BasicError>.failResult(BasicError.SizeOverflow)
  }
  return Result<usize, BasicError>.succeed(length + 6)
}

/// Writes `Basic ` and the Base64 of `username:password` to the start of `output`, and returns the
/// length.
///
/// # Details
/// The function writes `username:password` to `scratch` first. Bytes that are not ASCII are copied
/// without a change. You choose the character encoding of the credentials, usually UTF-8. Use
/// [`encodedLength`] to size `output`.
///
/// # Errors
/// - `InvalidUsername` if `username` has a colon, a control byte, or DEL.
/// - `InvalidPassword` if `password` has a control byte or DEL.
/// - `ScratchTooSmall` or `OutputTooSmall` if a buffer is too small. Nothing is written to a buffer
///   if the function fails.
///
/// # Gotchas
/// Basic credentials are not encrypted. Send them only over HTTPS. After the call, `scratch` holds
/// the password as plain text. Overwrite it when you are done.
pub fn encodeInto(username: &[u8], password: &[u8], scratch: &mut [u8], output: &mut [u8]) -> Result<
  usize,
  BasicError,
> {
  let mut index = usize.ZERO
  while index < username.length {
    let byte = username[index]
    if byte < 32 || byte == 127 || byte == 58 {
      return Result<usize, BasicError>.failResult(BasicError.InvalidUsername)
    }
    index = index + usize.ONE
  }
  index = usize.ZERO
  while index < password.length {
    let byte = password[index]
    if byte < 32 || byte == 127 {
      return Result<usize, BasicError>.failResult(BasicError.InvalidPassword)
    }
    index = index + usize.ONE
  }
  let measured = encodedLength(username.length, password.length)
  let required = match move measured {
    Result<usize, BasicError>.Failure {error} => {
      return Result<usize, BasicError>.failResult(move error)
    }
    Result<usize, BasicError>.Success {value} => value
  }
  let rawLength = username.length + usize.ONE + password.length
  if scratch.length < rawLength {
    return Result<usize, BasicError>.failResult(BasicError.ScratchTooSmall)
  }
  if output.length < required {
    return Result<usize, BasicError>.failResult(BasicError.OutputTooSmall)
  }
  index = usize.ZERO
  while index < username.length {
    scratch[index] = username[index]
    index = index + usize.ONE
  }
  scratch[username.length] = 58
  index = usize.ZERO
  while index < password.length {
    scratch[username.length + usize.ONE + index] = password[index]
    index = index + usize.ONE
  }
  let encoded = Base64.encodeInto(&mut output, Slice.view<u8>(&scratch, usize.ZERO, rawLength))
  match move encoded {
    Result<usize, Base64Error>.Failure {error} => {
      return Result<usize, BasicError>.failResult(BasicError.SizeOverflow)
    }
    Result<usize, Base64Error>.Success {value} => {}
  }
  index = required - 6
  while index > usize.ZERO {
    index = index - usize.ONE
    output[index + 6] = output[index]
  }
  output[0] = 66
  output[1] = 97
  output[2] = 115
  output[3] = 105
  output[4] = 99
  output[5] = 32
  return Result<usize, BasicError>.succeed(required)
}
