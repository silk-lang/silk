//! A bounded pool of HTTP/1 connections, for reuse across requests to the same origin.
//!
//! # When to use
//! Most code uses `silk.http.connection_pool_native`, which supplies a context for direct TCP,
//! HTTPS, and Unix connections. Use this module directly to pool connections from a custom
//! [`PoolContext`], for example over a test transport.
//!
//! 1. Call [`withPool`] with a [`Config`], a context, and a [`PoolHandler`]. The pool lives only
//!    inside the handler, and closes when the handler returns, fails, or is cancelled.
//! 2. For each request, call [`withConnection`] with a key. The handler gets one connection to use
//!    alone. [`CheckoutResult.source`] tells if the connection was reused or new.
//! 3. Call [`collect`] from time to time to close idle connections that have expired.
//!
//! # Details
//! [`withPool`] allocates all slots before the handler starts. After that, the pool does not
//! allocate. Each slot is opening, leased, or idle. The total of the three is at most `maxTotal`,
//! and the total for one origin is at most `maxPerOrigin`.
//!
//! A checkout does these steps:
//! 1. It removes one expired idle connection, if there is one.
//! 2. It takes the idle connection with the same key that was returned last.
//! 3. If there is none, it reserves a slot. If the pool or the origin is at its limit, it evicts
//!    the oldest idle connection. If no idle connection can be evicted, it fails with `PoolFull`.
//! 4. It opens a new connection with [`PoolContext.acquire`] if it reserved a slot.
//!
//! After the handler, the connection goes back to the idle list only if `silk.http.exchange` says
//! that it is eligible for reuse. Otherwise the pool closes it. If the idle list is full, the
//! oldest idle connection is closed.
//!
//! The pool does not use locks. Use it from one thread only. Calls to the clock, the connector, the
//! handler, and close are done outside the shared state.
//!
//! # Errors
//! - [`PoolError`] for a bad [`Config`], a full or closed pool, a key that the context does not
//!   accept, or an opening that ends after its deadline.
//! - The errors of the key copy, the connector, and the handler, unchanged.
//! - `ExchangeError` from [`close`] if an idle connection fails to close.
//!
//! # Gotchas
//! - There is no wait queue. When the pool is full, a checkout fails at once with `PoolFull`.
//! - The pool never sends a request again. If the handler fails or is cancelled, the connection is
//!   closed.
//! - Expired idle connections are closed only by a checkout, a return, or [`collect`]. No
//!   background task closes them.
//! - There is no HTTP/2 and no WebSocket pooling.
//!
//! @category HTTP

import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.effect {Effect}
import silk.text.format {Debug, Format, Formatter}
import silk.http.exchange as Client
import silk.http.exchange {ExchangeError, Connection, ConnectionHandler, ReuseEligibility}
import silk.http.origin {Origin}
import silk.http.proxy {RouteKey}
import silk.http.transport {HttpTransport}
import silk.system.monotonic_clock {MonotonicClock}
import silk.core.option {Option}
import silk.core.ownership {Copy}
import silk.system.random {Random}
import silk.core.result {Result}
import silk.mem.shared {Shared}
import silk.system.system_clock {Instant, SystemClock}
import silk.num.u64
import silk.num.u8
import silk.num.usize
import silk.collections.list {List}
import silk.io.writer {Writer, WriterError}

/// The default maximum number of connections: opening, leased, and idle together.
pub const DEFAULT_MAX_TOTAL: usize = 32
/// The default maximum number of idle connections.
pub const DEFAULT_MAX_IDLE: usize = 16
/// The default maximum number of connections to one origin.
pub const DEFAULT_MAX_PER_ORIGIN: usize = 8
/// The default time that a connection stays idle before it expires: 30 seconds.
pub const DEFAULT_IDLE_TIMEOUT_NANOSECONDS: u64 = 30000000000
/// The largest `maxTotal` that a [`Config`] accepts.
pub const MAX_TOTAL: usize = 1024

/// The limits of a pool. [`withPool`] checks them before it allocates.
pub struct Config {
  /// The maximum number of opening, leased, and idle connections together. It is 1 through
  /// [`MAX_TOTAL`].
  pub maxTotal: usize,
  /// The maximum number of idle connections. It is at most `maxTotal`. Zero disables reuse.
  pub maxIdle: usize,
  /// The maximum number of connections to one origin. It is 1 through `maxTotal`.
  pub maxPerOrigin: usize,
  /// The time that a connection stays idle before it expires, on the monotonic clock. It is more
  /// than zero.
  pub idleTimeoutNanoseconds: u64,
}

impl Copy for Config {}

impl Config {
  /// Returns the default limits: 32 in total, 16 idle, 8 for each origin, and 30 seconds of idle
  /// time.
  pub fn defaults() -> Config {
    return Config {
      maxTotal: DEFAULT_MAX_TOTAL,
      maxIdle: DEFAULT_MAX_IDLE,
      maxPerOrigin: DEFAULT_MAX_PER_ORIGIN,
      idleTimeoutNanoseconds: DEFAULT_IDLE_TIMEOUT_NANOSECONDS,
    }
  }
}

/// The [`Config`] field that is not valid.
pub enum ConfigField {
  /// `maxTotal` is zero or more than [`MAX_TOTAL`].
  MaxTotal,
  /// `maxIdle` is more than `maxTotal`.
  MaxIdle,
  /// `maxPerOrigin` is zero or more than `maxTotal`.
  MaxPerOrigin,
  /// `idleTimeoutNanoseconds` is zero.
  IdleTimeout,
}

impl Debug for ConfigField {
  /// Writes the name of the variant, such as `MaxTotal`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      ConfigField.MaxTotal => run Format.write(&mut formatter, b"MaxTotal")
      ConfigField.MaxIdle => run Format.write(&mut formatter, b"MaxIdle")
      ConfigField.MaxPerOrigin => run Format.write(&mut formatter, b"MaxPerOrigin")
      ConfigField.IdleTimeout => run Format.write(&mut formatter, b"IdleTimeout")
    }
  }
}

/// The error of a pool operation: a bad [`Config`], a full or closed pool, a key that the context
/// does not accept, or an opening that ends after its deadline.
pub union PoolError {
  /// The [`Config`] is not valid. Nothing was allocated.
  InvalidConfig {
    /// The field that is not valid.
    pub field: ConfigField,
  },
  /// The pool or the origin is at its limit, and no idle connection can be evicted.
  PoolFull,
  /// The pool is closed. A copied [`Handle`] can outlive its pool, but it cannot check out.
  PoolClosed,
  /// The context of the pool does not accept the key. For example, a direct pool got a proxy key.
  ContextMismatch,
  /// The deadline passed before or while the connection was opened. A new connection is closed.
  OpeningExpired,
}

impl Copy for PoolError {}

impl Debug for PoolError {
  /// Writes the name of the variant and its fields, such as `InvalidConfig { ... }`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      PoolError.InvalidConfig { field } => {
        let mut record = run Format.debugRecord("InvalidConfig", &mut formatter)
        run Format.debugField(&mut record, "field", &field, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      PoolError.PoolFull => run Format.write(&mut formatter, b"PoolFull")
      PoolError.PoolClosed => run Format.write(&mut formatter, b"PoolClosed")
      PoolError.ContextMismatch => run Format.write(&mut formatter, b"ContextMismatch")
      PoolError.OpeningExpired => run Format.write(&mut formatter, b"OpeningExpired")
    }
  }
}

/// A snapshot of the slots of a pool. See [`counts`].
pub struct Counts {
  /// The number of connections that are being opened.
  pub opening: usize,
  /// The number of connections that a handler is using.
  pub leased: usize,
  /// The number of connections that are ready for reuse.
  pub idle: usize,
  /// The sum of `opening`, `leased`, and `idle`.
  pub total: usize,
  /// Whether the pool is closed.
  pub closed: bool,
}

impl Copy for Counts {}

/// The result of [`collect`].
pub struct Collection {
  /// The number of expired idle connections that were closed.
  pub expired: usize,
}

impl Copy for Collection {}

/// Where the connection of a checkout came from.
pub enum CheckoutSource {
  /// An idle connection with the same key. The one that was returned last is used first.
  Reused,
  /// A new connection from [`PoolContext.acquire`].
  Opened,
}

/// The result of [`withConnection`].
pub struct CheckoutResult<A> {
  /// The value that the handler returned.
  pub value: A,
  /// Whether the connection was reused or new.
  pub source: CheckoutSource,
}

/// The key that selects which connections can be reused for a request.
///
/// Two keys are [`PoolKey.equals`] only if a connection for one is safe to use for the other. The
/// pool stores a copy of each key. [`ConnectionKey`] is the standard key.
pub interface PoolKey<CopyError, ?CopyRequirements> {
  /// Returns a copy of `key` that the pool can keep.
  effect fn copy(key: &Self) -> Self ! CopyError ? CopyRequirements
  /// Returns whether a connection for one key can be used for the other: the same route, provider,
  /// and security settings.
  fn equals(left: &Self, right: &Self) -> bool
  /// Returns whether the keys have the same original origin. The pool uses it for `maxPerOrigin`.
  fn sameOrigin(left: &Self, right: &Self) -> bool
}

/// Copies a pool context, for [`copyHandle`].
pub interface PoolContextCopy<CopyError, ?CopyRequirements> {
  /// Returns a copy of `context`. If it fails, no handle is made.
  effect fn copy(context: &Self) -> Self ! CopyError ? CopyRequirements
}

/// Opens new connections for a pool.
///
/// The pool keeps the context outside its shared state and never changes it.
pub interface PoolContext<K, P, AcquisitionError, ?AcquisitionRequirements> {
  /// Returns whether this context can open connections for `key`. It does not allocate, read the
  /// clock, or use the network.
  fn accepts(context: &Self, key: &K) -> bool
  /// Opens one connection for `key`. It finishes before `deadline`, if there is one. The connection
  /// does not keep the deadline.
  effect fn acquire(
    context: &Self,
    key: &K,
    deadline: Option<Instant>,
  ) -> Connection<P> ! AcquisitionError ? AcquisitionRequirements
}

/// The code that uses a pool. [`withPool`] lends the pool to it, and closes the pool when it
/// returns, fails, or is cancelled.
pub interface PoolHandler<K, P, C, A, E, ?R> {
  /// Uses `pool`. The pool closes when this returns. The borrow of the pool cannot escape.
  effect<'scope> fn handle<'scope>(handler: Self, pool: &'scope mut Pool<K, P, C>) -> A ! E ? R
}

/// How a [`ConnectionKey`] reaches its origin.
pub union EndpointIdentity {
  /// A direct network connection to the original origin.
  Direct,
  /// A connection through a proxy.
  Proxy {
    /// The route: the mode, the proxy, the original origin, and the identity of the credentials.
    pub route: RouteKey,
  },
  /// A connection to a Unix socket at an exact path.
  Unix { path: Bytes },
}

/// The standard [`PoolKey`]: the original origin and how it is reached.
///
/// # Details
/// The key holds only the route. The TLS, trust, HTTP, and connector settings are part of the
/// [`PoolContext`], so all keys of one pool share them. Two direct keys for the same origin are
/// equal, even if DNS gives other addresses.
pub struct ConnectionKey {
  originalOrigin: Origin,
  endpoint: EndpointIdentity,
}

impl ConnectionKey {
  /// Returns a key for a direct connection to `originalOrigin`. It does not allocate.
  pub fn direct(originalOrigin: Origin) -> ConnectionKey {
    return ConnectionKey {
      originalOrigin: originalOrigin,
      endpoint: EndpointIdentity.Direct,
    }
  }

  /// Returns a key for a connection through a proxy route. The origin comes from the route.
  pub fn proxy(route: RouteKey) -> ConnectionKey {
    return ConnectionKey {
      originalOrigin: RouteKey.originalOrigin(&route),
      endpoint: EndpointIdentity.Proxy {route: route},
    }
  }

  /// Returns a key for a connection to `originalOrigin` through the Unix socket at `path`. It
  /// copies `path`.
  pub effect fn unix(
    originalOrigin: Origin,
    path: &[u8],
  ) -> ConnectionKey ! OutOfMemoryError ? &mut Allocator {
    let ownedPath = run Bytes.copy(path)
    return ConnectionKey {
      originalOrigin: originalOrigin,
      endpoint: EndpointIdentity.Unix {path: move ownedPath},
    }
  }

  /// Returns the original origin.
  pub fn origin(self: &Self) -> Origin { return self.originalOrigin }

  /// Returns whether the key is for a direct network connection.
  pub fn isDirect(self: &Self) -> bool {
    return match & self.endpoint {
      EndpointIdentity.Direct => true
      _ => false
    }
  }

  /// Returns whether the key is for a Unix socket at exactly `path`.
  pub fn matchesUnixPath(self: &Self, path: &[u8]) -> bool {
    return match & self.endpoint {
      EndpointIdentity.Unix {path: stored} => bytesEqualSlice(&stored, path)
      _ => false
    }
  }
}

fn bytesEqual(left: &Bytes, right: &Bytes) -> bool {
  let a = Bytes.asSlice(left)
  let b = Bytes.asSlice(right)
  if a.length != b.length { return false }
  let mut index = usize.ZERO
  while index < a.length {
    if a[index] != b[index] { return false }
    index = index + usize.ONE
  }
  return true
}

fn bytesEqualSlice(left: &Bytes, right: &[u8]) -> bool {
  let bytes = Bytes.asSlice(left)
  if bytes.length != right.length { return false }
  let mut index = usize.ZERO
  while index < bytes.length {
    if bytes[index] != right[index] { return false }
    index = index + usize.ONE
  }
  return true
}

fn endpointsEqual(left: &EndpointIdentity, right: &EndpointIdentity) -> bool {
  return match & left.* {
    EndpointIdentity.Direct => match & right.* {
      EndpointIdentity.Direct => true
      _ => false
    }
    EndpointIdentity.Proxy {route} => match & right.* {
      EndpointIdentity.Proxy {route: other} => RouteKey.equals(&route, &other)
      _ => false
    }
    EndpointIdentity.Unix {path} => match & right.* {
      EndpointIdentity.Unix {path: other} => bytesEqual(&path, &other)
      _ => false
    }
  }
}

effect fn copyEndpoint(value: &EndpointIdentity) -> EndpointIdentity
! OutOfMemoryError
? &mut Allocator {
  return match & value.* {
    EndpointIdentity.Direct => EndpointIdentity.Direct
    EndpointIdentity.Proxy {route} => EndpointIdentity.Proxy {route: route}
    EndpointIdentity.Unix {path} => {
      return EndpointIdentity.Unix {
        path: run Bytes.copy(Bytes.asSlice(&path)),
      }
    }
  }
}

impl PoolKey<OutOfMemoryError ? &mut Allocator> for ConnectionKey {
  effect fn copy(key: &Self) -> ConnectionKey ! OutOfMemoryError ? &mut Allocator {
    return ConnectionKey {
      originalOrigin: key.originalOrigin,
      endpoint: run copyEndpoint(&key.endpoint),
    }
  }

  fn equals(left: &Self, right: &Self) -> bool {
    return Origin.equals(&left.originalOrigin, &right.originalOrigin)
      && endpointsEqual(&left.endpoint, &right.endpoint)
  }

  fn sameOrigin(left: &Self, right: &Self) -> bool {
    return Origin.equals(&left.originalOrigin, &right.originalOrigin)
  }
}

union PoolSlot<K, P> {
  Vacant,
  Opening {key: K},
  Leased {key: K},
  Idle {
    key: K,
    connection: Connection<P>,
    returnedAt: Instant,
    expiresAt: Instant,
    sequence: u64,
  },
}

struct PoolState<K, P> {
  slots: List<PoolSlot<K, P>>,
  config: Config,
  nextSequence: u64,
  sequenceExhausted: bool,
  closed: bool,
}

/// A pool. [`withPool`] lends it to a [`PoolHandler`], and closes it after.
pub struct Pool<K, P, C> {
  handleValue: Handle<K, P, C>,
}

/// A reference to a pool, for checkouts.
///
/// Get the handle of a pool with [`Pool.handle`]. Make more handles with [`copyHandle`]. All
/// handles share the slots of the pool.
pub struct Handle<K, P, C> {
  state: Shared<PoolState<K, P>>,
  context: C,
  config: Config,
}

impl<K, P, C> Pool<K, P, C> {
  /// Returns the handle of the pool.
  pub fn handle(self: &Self) -> &Handle<K, P, C> { return &self.handleValue }
}

/// Returns the context of a handle.
pub fn context<'handle, K, P, C>(handle: &'handle Handle<K, P, C>) -> &'handle C {
  return &handle.context
}

fn validate(config: Config) -> Result<Config, PoolError> {
  if config.maxTotal == usize.ZERO || config.maxTotal > MAX_TOTAL {
    return Result<Config, PoolError>.failResult(PoolError.InvalidConfig {field: ConfigField.MaxTotal})
  }
  if config.maxIdle > config.maxTotal {
    return Result<Config, PoolError>.failResult(PoolError.InvalidConfig {field: ConfigField.MaxIdle})
  }
  if config.maxPerOrigin == usize.ZERO || config.maxPerOrigin > config.maxTotal {
    return Result<Config, PoolError>.failResult(PoolError.InvalidConfig {field: ConfigField.MaxPerOrigin})
  }
  if config.idleTimeoutNanoseconds == u64.MIN {
    return Result<Config, PoolError>.failResult(PoolError.InvalidConfig {field: ConfigField.IdleTimeout})
  }
  return Result<Config, PoolError>.succeed(config)
}

effect fn makeState<K, P>(config: Config) -> Shared<PoolState<K, P>>
! OutOfMemoryError
? &mut Allocator {
  let mut slots = List<PoolSlot<K, P>>.make()
  run List<PoolSlot<K, P>>.reserveExact(&mut slots, config.maxTotal)
  let mut index = usize.ZERO
  while index < config.maxTotal {
    run List<PoolSlot<K, P>>.append(&mut slots, PoolSlot<K, P>.Vacant)
    index = index + usize.ONE
  }
  return run Shared<PoolState<K, P>>.make(PoolState {
    slots: move slots,
    config: config,
    nextSequence: u64.MIN,
    sequenceExhausted: false,
    closed: false,
  })
}

/// Makes a pool, lends it to `handler`, and closes it after.
///
/// # Details
/// The pool allocates all `config.maxTotal` slots first and then does not allocate. Each slot is
/// opening, leased, or idle. The total of the three is at most `maxTotal`, and the total for one
/// origin is at most `maxPerOrigin`. It closes when the handler returns, fails,
/// or is cancelled. Closing closes all idle connections.
///
/// # Errors
/// - `PoolError.InvalidConfig` if `config` is not valid.
/// - `OutOfMemoryError` if the slots cannot be allocated.
/// - The error of the handler.
///
/// # Gotchas
/// - Use the pool from one thread only. It does not use locks.
/// - There is no wait queue. When the pool is full, a checkout fails at once with `PoolFull`.
/// - Expired idle connections are closed only by a checkout, a return, or [`collect`]. No
///   background task closes them.
/// - There is no HTTP/2 and no WebSocket pooling.
pub effect<'env> fn withPool<
  K,
  P,
  C: 'env,
  A,
  E,
  ?R,
  H: PoolHandler<K, P, C, A, E ? R> + 'env,
  'env,
>(config: Config, context: C, handler: H) -> A
! E | PoolError | OutOfMemoryError
? R | &mut Allocator
where &mut P provides &HttpTransport from &mut HttpTransport {
  let admitted = match move validate(config) {
    Result.Failure {error} => { fail move error }
    Result.Success {value} => value
  }
  let state = run makeState<K, P>(admitted)
  let handle = Handle<K, P, C> {state: move state, context: move context, config: admitted}
  let pool = Pool<K, P, C> {handleValue: move handle}
  let use = effect fn(owned: &mut Pool<K, P, C>) -> A ! E ? R {
    return run PoolHandler<K, P, C, A, E ? R>.handle(move handler, &mut owned.*)
  }
  let release = effect fn(owned: &mut Pool<K, P, C>) -> () {
    return run closeQuietly<K, P, C>(&mut owned.*)
  }
  return run Effect.useReleaseNonParking(move pool, move use, move release)
}

/// Returns another handle for the same pool.
///
/// It copies the context first. If that fails, no new handle is made.
pub effect fn copyHandle<
  K,
  P,
  CopyError,
  ?CopyRequirements,
  C: PoolContextCopy<CopyError ? CopyRequirements>,
>(handle: &Handle<K, P, C>) -> Handle<K, P, C> ! CopyError ? CopyRequirements {
  let context = run PoolContextCopy<CopyError ? CopyRequirements>.copy(&handle.context)
  let state = Shared<PoolState<K, P>>.clone(&handle.state)
  return Handle<K, P, C> {state: move state, context: move context, config: handle.config}
}

fn instantBefore(left: &Instant, right: &Instant) -> bool {
  let leftSeconds = SystemClock.seconds(left)
  let rightSeconds = SystemClock.seconds(right)
  if leftSeconds < rightSeconds { return true }
  if leftSeconds > rightSeconds { return false }
  return SystemClock.nanoseconds(left) < SystemClock.nanoseconds(right)
}

fn copyInstant(value: &Instant) -> Instant {
  return SystemClock.make(SystemClock.seconds(value), SystemClock.nanoseconds(value))
}

fn copyDeadline(value: &Option<Instant>) -> Option<Instant> {
  return match & value.* {
    Option.None => Option<Instant>.none()
    Option.Some {value: present} => Option<Instant>.some(copyInstant(&present))
  }
}

fn earlierDeadline(left: &Option<Instant>, right: &Option<Instant>) -> Option<Instant> {
  return match & left.* {
    Option.None => copyDeadline(right)
    Option.Some {value: a} => match & right.* {
      Option.None => Option<Instant>.some(copyInstant(&a))
      Option.Some {value: b} => {
        if instantBefore(&a, &b) { return Option<Instant>.some(copyInstant(&a)) }
        return Option<Instant>.some(copyInstant(&b))
      }
    }
  }
}

fn deadlineExpired(now: &Instant, deadline: &Option<Instant>) -> bool {
  return match & deadline.* {
    Option.None => false
    Option.Some {value} => !instantBefore(now, &value)
  }
}

fn isExpired(now: &Instant, expiresAt: &Instant) -> bool {
  return !instantBefore(now, expiresAt)
}

fn older(
  leftReturnedAt: &Instant,
  leftSequence: u64,
  rightReturnedAt: &Instant,
  rightSequence: u64,
) -> bool {
  if instantBefore(leftReturnedAt, rightReturnedAt) { return true }
  if instantBefore(rightReturnedAt, leftReturnedAt) { return false }
  return leftSequence < rightSequence
}

fn newer(
  leftReturnedAt: &Instant,
  leftSequence: u64,
  rightReturnedAt: &Instant,
  rightSequence: u64,
) -> bool {
  if instantBefore(rightReturnedAt, leftReturnedAt) { return true }
  if instantBefore(leftReturnedAt, rightReturnedAt) { return false }
  return leftSequence > rightSequence
}

fn countState<K, P>(state: &PoolState<K, P>) -> Counts {
  let slots = List<PoolSlot<K, P>>.asSlice(&state.slots)
  let mut opening = usize.ZERO
  let mut leased = usize.ZERO
  let mut idle = usize.ZERO
  let mut index = usize.ZERO
  while index < slots.length {
    match & slots[index] {
      PoolSlot.Vacant => {}
      PoolSlot.Opening {..} => { opening = opening + usize.ONE }
      PoolSlot.Leased {..} => { leased = leased + usize.ONE }
      PoolSlot.Idle {..} => {
        idle = idle + usize.ONE
      }
    }
    index = index + usize.ONE
  }
  return Counts {
    opening: opening,
    leased: leased,
    idle: idle,
    total: opening + leased + idle,
    closed: state.closed,
  }
}

/// Returns the number of opening, leased, and idle connections. It does not allocate or read the
/// clock.
pub fn counts<K, P, C>(handle: &Handle<K, P, C>) -> Counts {
  return Shared.with(&handle.state, countState)
}

union Admission<P> {
  Closed,
  Full,
  Expired {connection: Connection<P>},
  Selected {index: usize, connection: Connection<P>},
  Opening {index: usize, victim: Option<Connection<P>>},
}

fn replaceSlot<K, P>(slot: &mut PoolSlot<K, P>, next: PoolSlot<K, P>) -> PoolSlot<K, P> {
  return Intrinsic.replace(slot.*, move next)
}

fn firstExpired<K, P>(state: &mut PoolState<K, P>, now: &Instant) -> Option<Connection<P>> {
  let mut slots = List<PoolSlot<K, P>>.asMutSlice(&mut state.slots)
  let mut index = usize.ZERO
  while index < slots.length {
    let expired = match & slots[index] {
      PoolSlot.Idle {key: _, connection: _, returnedAt: _, expiresAt, sequence: _} => isExpired(now, &expiresAt)
      _ => false
    }
    if expired {
      let previous = replaceSlot(&mut slots[index], PoolSlot<K, P>.Vacant)
      return match move previous {
        PoolSlot.Idle {key, connection, returnedAt: _, expiresAt: _, sequence: _} => {
          drop key
          return Option<Connection<P>>.some(move connection)
        }
        _ => unavailable<Option<Connection<P>>>()
      }
    }
    index = index + usize.ONE
  }
  return Option<Connection<P>>.none()
}

fn reserveStep<
  P,
  KeyCopyError,
  ?KeyCopyRequirements,
  K: PoolKey<KeyCopyError ? KeyCopyRequirements>,
>(state: &mut PoolState<K, P>, key: K, now: Instant) -> Admission<P> {
  if state.closed {
    drop key
    return Admission<P>.Closed
  }
  let expired = firstExpired(&mut state.*, &now)
  if let Option.Some {value} = move expired {
    drop key
    return Admission<P>.Expired {connection: move value}
  }

  let view = List<PoolSlot<K, P>>.asSlice(&state.slots)
  let mut selected = Option<usize>.none()
  let mut selectedReturned = Option<Instant>.none()
  let mut selectedSequence = u64.MIN
  let mut total = usize.ZERO
  let mut originTotal = usize.ZERO
  let mut vacant = Option<usize>.none()
  let mut oldestGlobal = Option<usize>.none()
  let mut oldestGlobalReturned = Option<Instant>.none()
  let mut oldestGlobalSequence = u64.MIN
  let mut oldestOrigin = Option<usize>.none()
  let mut oldestOriginReturned = Option<Instant>.none()
  let mut oldestOriginSequence = u64.MIN
  let mut index = usize.ZERO
  while index < view.length {
    match & view[index] {
      PoolSlot.Vacant => {
        let unclaimed = match & vacant {
          Option.None => true
          Option.Some {..} => false
        }
        if unclaimed { vacant = Option<usize>.some(index) }
      }
      PoolSlot.Opening {key: stored} => {
        total = total + usize.ONE
        if PoolKey<KeyCopyError ? KeyCopyRequirements>.sameOrigin(&key, &stored) {
          originTotal = originTotal + usize.ONE
        }
      }
      PoolSlot.Leased {key: stored} => {
        total = total + usize.ONE
        if PoolKey<KeyCopyError ? KeyCopyRequirements>.sameOrigin(&key, &stored) {
          originTotal = originTotal + usize.ONE
        }
      }
      PoolSlot.Idle {key: stored, connection: _, returnedAt, expiresAt: _, sequence} => {
        total = total + usize.ONE
        let sameOrigin = PoolKey<KeyCopyError ? KeyCopyRequirements>.sameOrigin(&key, &stored)
        if sameOrigin { originTotal = originTotal + usize.ONE }
        if PoolKey<KeyCopyError ? KeyCopyRequirements>.equals(&key, &stored) {
          let choose = match & selectedReturned {
            Option.None => true
            Option.Some {value} => newer(&returnedAt, sequence, &value, selectedSequence)
          }
          if choose {
            selected = Option<usize>.some(index)
            selectedReturned = Option<Instant>.some(copyInstant(&returnedAt))
            selectedSequence = sequence
          }
        }
        let globalOlder = match & oldestGlobalReturned {
          Option.None => true
          Option.Some {value} => older(&returnedAt, sequence, &value, oldestGlobalSequence)
        }
        if globalOlder {
          oldestGlobal = Option<usize>.some(index)
          oldestGlobalReturned = Option<Instant>.some(copyInstant(&returnedAt))
          oldestGlobalSequence = sequence
        }
        if sameOrigin {
          let originOlder = match & oldestOriginReturned {
            Option.None => true
            Option.Some {value} => older(&returnedAt, sequence, &value, oldestOriginSequence)
          }
          if originOlder {
            oldestOrigin = Option<usize>.some(index)
            oldestOriginReturned = Option<Instant>.some(copyInstant(&returnedAt))
            oldestOriginSequence = sequence
          }
        }
      }
    }
    index = index + usize.ONE
  }
  drop view

  if let Option.Some {value: selectedIndex} = move selected {
    drop key
    let mut slots = List<PoolSlot<K, P>>.asMutSlice(&mut state.slots)
    let previous = replaceSlot(&mut slots[selectedIndex], PoolSlot<K, P>.Vacant)
    return match move previous {
      PoolSlot.Idle {key: stored, connection, returnedAt: _, expiresAt: _, sequence: _} => {
        slots[selectedIndex] = PoolSlot<K, P>.Leased {key: move stored}
        return Admission<P>.Selected {index: selectedIndex, connection: move connection}
      }
      _ => unavailable<Admission<P>>()
    }
  }

  let mut destination = Option<usize>.none()
  if originTotal >= state.config.maxPerOrigin {
    destination = move oldestOrigin
  } else if total < state.config.maxTotal {
    destination = move vacant
  } else {
    destination = move oldestGlobal
  }
  let selectedDestination = match move destination {
    Option.None => {
      drop key
      return Admission<P>.Full
    }
    Option.Some {value} => value
  }
  let mut slots = List<PoolSlot<K, P>>.asMutSlice(&mut state.slots)
  let previous = replaceSlot(&mut slots[selectedDestination], PoolSlot<K, P>.Opening {key: move key})
  let mut victim = Option<Connection<P>>.none()
  match move previous {
    PoolSlot.Vacant => {}
    PoolSlot.Idle {key: previousKey, connection, returnedAt: _, expiresAt: _, sequence: _} => {
      drop previousKey
      victim = Option<Connection<P>>.some(move connection)
    }
    _ => { return unavailable<Admission<P>>() }
  }
  return Admission<P>.Opening {index: selectedDestination, victim: move victim}
}

fn activate<K, P>(state: &mut PoolState<K, P>, index: usize) -> bool {
  let closed = state.closed
  let mut slots = List<PoolSlot<K, P>>.asMutSlice(&mut state.slots)
  let previous = replaceSlot(&mut slots[index], PoolSlot<K, P>.Vacant)
  return match move previous {
    PoolSlot.Opening {key} => {
      if closed {
        drop key
        return false
      }
      slots[index] = PoolSlot<K, P>.Leased {key: move key}
      return true
    }
    _ => unavailable<bool>()
  }
}

fn clearLease<K, P>(state: &mut PoolState<K, P>, index: usize) -> () {
  let mut slots = List<PoolSlot<K, P>>.asMutSlice(&mut state.slots)
  let previous = replaceSlot(&mut slots[index], PoolSlot<K, P>.Vacant)
  match move previous {
    PoolSlot.Vacant => {}
    PoolSlot.Opening {key} => { drop key }
    PoolSlot.Leased {key} => { drop key }
    PoolSlot.Idle {key, connection, returnedAt: _, expiresAt: _, sequence: _} => {
      drop key
      drop connection
    }
  }
  return ()
}

struct Checkout<K, P> {
  state: Shared<PoolState<K, P>>,
  index: usize,
  source: CheckoutSource,
  idleTimeoutNanoseconds: u64,
  connection: Option<Connection<P>>,
  victim: Option<Connection<P>>,
  reusable: bool,
  returnedAt: Option<Instant>,
  expiresAt: Option<Instant>,
}

effect fn closeConnectionQuietly<P>(connection: &mut Connection<P>) -> ()
where &mut P provides &HttpTransport from &mut HttpTransport {
  let attempted = run Effect.result(Client.close(&mut connection.*))
  drop attempted
  return ()
}

effect fn closeOptionQuietly<P>(selected: &mut Option<Connection<P>>) -> ()
where &mut P provides &HttpTransport from &mut HttpTransport {
  let previous = Intrinsic.replace(selected.*, Option<Connection<P>>.none())
  if let Option.Some {value} = move previous {
    let mut owned = move value
    run closeConnectionQuietly(&mut owned)
  }
  return ()
}

fn eligibilityReusable(value: ReuseEligibility) -> bool {
  return match move value {
    ReuseEligibility.Eligible => true
    _ => false
  }
}

fn idleCount<K, P>(state: &PoolState<K, P>) -> usize {
  return countState(state).idle
}

fn oldestIdleExcept<K, P>(state: &PoolState<K, P>, excluded: usize) -> Option<usize> {
  let slots = List<PoolSlot<K, P>>.asSlice(&state.slots)
  let mut selected = Option<usize>.none()
  let mut selectedAt = Option<Instant>.none()
  let mut selectedSequence = u64.MIN
  let mut index = usize.ZERO
  while index < slots.length {
    if index != excluded {
      if let PoolSlot.Idle {key: _, connection: _, returnedAt, expiresAt: _, sequence} = & slots[index] {
        let choose = match & selectedAt {
          Option.None => true
          Option.Some {value} => older(&returnedAt, sequence, &value, selectedSequence)
        }
        if choose {
          selected = Option<usize>.some(index)
          selectedAt = Option<Instant>.some(copyInstant(&returnedAt))
          selectedSequence = sequence
        }
      }
    }
    index = index + usize.ONE
  }
  return move selected
}

fn publish<K, P>(
  state: &mut PoolState<K, P>,
  index: usize,
  connection: Connection<P>,
  returnedAt: Instant,
  expiresAt: Instant,
) -> Option<Connection<P>> {
  if state.closed || state.config.maxIdle == usize.ZERO || state.sequenceExhausted {
    clearLease(&mut state.*, index)
    return Option<Connection<P>>.some(move connection)
  }
  let sequence = state.nextSequence
  if sequence == u64.MAX {
    state.sequenceExhausted = true
  } else {
    state.nextSequence = sequence + 1
  }
  let mut victimIndex = Option<usize>.none()
  if idleCount(&state.*) >= state.config.maxIdle {
    victimIndex = oldestIdleExcept(&state.*, index)
  }
  let mut victim = Option<Connection<P>>.none()
  if let Option.Some {value} = move victimIndex {
    let mut slots = List<PoolSlot<K, P>>.asMutSlice(&mut state.slots)
    let previous = replaceSlot(&mut slots[value], PoolSlot<K, P>.Vacant)
    match move previous {
      PoolSlot.Idle {key, connection: evicted, returnedAt: _, expiresAt: _, sequence: _} => {
        drop key
        victim = Option<Connection<P>>.some(move evicted)
      }
      _ => { return unavailable<Option<Connection<P>>>() }
    }
  }
  let mut slots = List<PoolSlot<K, P>>.asMutSlice(&mut state.slots)
  let previous = replaceSlot(&mut slots[index], PoolSlot<K, P>.Vacant)
  match move previous {
    PoolSlot.Leased {key} => {
      slots[index] = PoolSlot<K, P>.Idle {
        key: move key,
        connection: move connection,
        returnedAt: move returnedAt,
        expiresAt: move expiresAt,
        sequence: sequence,
      }
    }
    _ => unavailable<()>()
  }
  return move victim
}

fn extractExpiredStep<K, P>(state: &mut PoolState<K, P>, now: Instant) -> Option<Connection<P>> {
  return firstExpired(&mut state.*, &now)
}

effect fn drainExpired<K, P>(
  state: &Shared<PoolState<K, P>>,
  now: &Instant,
) -> usize
where &mut P provides &HttpTransport from &mut HttpTransport {
  let mut count = usize.ZERO
  let mut keepGoing = true
  while keepGoing {
    let selected = Shared.withMut(
      &state.*,
      extractExpiredStep<K, P>(copyInstant(now)),
    )
    match move selected {
      Option.None => { keepGoing = false }
      Option.Some {value} => {
        let mut owned = move value
        run closeConnectionQuietly(&mut owned)
        count = count + usize.ONE
      }
    }
  }
  return count
}

effect fn releaseCheckout<K, P>(checkout: &mut Checkout<K, P>) -> ()
where &mut P provides &HttpTransport from &mut HttpTransport {
  run closeOptionQuietly(&mut checkout.victim)
  let selected = Intrinsic.replace(checkout.connection, Option<Connection<P>>.none())
  let connection = match move selected {
    Option.None => {
      Shared.withMut(&checkout.state, clearLease<K, P>(checkout.index))
      return ()
    }
    Option.Some {value} => move value
  }
  if checkout.reusable {
    if let Option.Some {value: returnedAt} = move Intrinsic.replace(
      checkout.returnedAt,
      Option<Instant>.none(),
    ) {
      if let Option.Some {value: expiresAt} = move Intrinsic.replace(
        checkout.expiresAt,
        Option<Instant>.none(),
      ) {
        let expired = run drainExpired(&checkout.state, &returnedAt)
        drop expired
        let toClose = Shared.withMut(
          &checkout.state,
          publish<K, P>(checkout.index, move connection, move returnedAt, move expiresAt),
        )
        let mut pending = move toClose
        run closeOptionQuietly(&mut pending)
        return ()
      }
    }
  }
  Shared.withMut(&checkout.state, clearLease<K, P>(checkout.index))
  let mut discarded = move connection
  run closeConnectionQuietly(&mut discarded)
  return ()
}

effect<'env> fn checkoutUse<
  K,
  P,
  A,
  E,
  AcquisitionError,
  ?AcquisitionRequirements,
  ?CallbackRequirements,
  C: PoolContext<K, P, AcquisitionError ? AcquisitionRequirements>,
  H: ConnectionHandler<P, A, E ? CallbackRequirements> + 'env,
  'env,
>(
  checkout: &mut Checkout<K, P>,
  context: &C,
  key: &K,
  deadline: Option<Instant>,
  handler: H,
) -> CheckoutResult<A>
! E | AcquisitionError | PoolError
? AcquisitionRequirements | CallbackRequirements | &mut MonotonicClock
where
  &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut P provides &HttpTransport from &mut HttpTransport {
  run closeOptionQuietly(&mut checkout.victim)
  let needsConnection = match & checkout.connection {
    Option.None => true
    Option.Some {..} => false
  }
  if needsConnection {
    let acquired = run PoolContext<K, P, AcquisitionError ? AcquisitionRequirements>.acquire(
      context,
      key,
      copyDeadline(&deadline),
    )
    checkout.connection = Option<Connection<P>>.some(move acquired)
    let afterOpening = run MonotonicClock.now()
    if deadlineExpired(&afterOpening, &deadline) {
      fail PoolError.OpeningExpired
    }
    let active = Shared.withMut(&checkout.state, activate<K, P>(checkout.index))
    if !active { fail PoolError.PoolClosed }
  }
  if let Option.Some {value: connection} = &mut checkout.connection {
    let value = run ConnectionHandler<P, A, E ? CallbackRequirements>.handle(
      move handler,
      &mut connection,
    )
    let eligibility = Client.reuseEligibility(&connection)
    if eligibilityReusable(move eligibility) {
      let returnedAt = run MonotonicClock.now()
      let expiresAt = MonotonicClock.deadlineAfter(
        &returnedAt,
        checkout.idleTimeoutNanoseconds,
      )
      checkout.reusable = true
      checkout.returnedAt = Option<Instant>.some(move returnedAt)
      checkout.expiresAt = Option<Instant>.some(move expiresAt)
    }
    return CheckoutResult<A> {value: move value, source: checkout.source}
  }
  return unavailable<CheckoutResult<A>>()
}

/// Checks out one connection for `key`, and lends it to `handler`.
///
/// # Details
/// A checkout does these steps:
/// 1. It removes one expired idle connection, if there is one.
/// 2. It takes the idle connection with the same key that was returned last.
/// 3. If there is none, it reserves a slot. If the pool or the origin is at its limit, it evicts
///    the oldest idle connection. If no idle connection can be evicted, it fails with `PoolFull`.
/// 4. It opens a new connection with `PoolContext.acquire` if it reserved a slot.
///
/// The handler gets the connection to use alone. `CheckoutResult.source` tells if the connection
/// was reused or new. To open a new connection, the context gets the earlier of `requestDeadline`
/// and `acquisitionDeadline`. The handler uses `requestDeadline` for its exchanges.
///
/// After the handler returns, the connection goes back to the pool if it is eligible for reuse.
/// Otherwise it is closed. If the handler fails or is cancelled, the connection is closed. If the
/// idle list is full, the oldest idle connection is closed.
///
/// # Gotchas
/// There is no wait queue: when the pool is full, the checkout fails at once with `PoolFull`. The
/// pool never sends a request again.
///
/// # Errors
/// - `PoolError.ContextMismatch` if the context does not accept `key`.
/// - `PoolError.OpeningExpired` if the deadline passes before or during opening.
/// - `PoolError.PoolFull` or `PoolError.PoolClosed`.
/// - The errors of the key copy, the connector, and the handler.
pub effect<'env> fn withConnection<
  P,
  A,
  E,
  KeyCopyError,
  AcquisitionError,
  ?KeyCopyRequirements,
  ?AcquisitionRequirements,
  ?CallbackRequirements,
  K: PoolKey<KeyCopyError ? KeyCopyRequirements>,
  C: PoolContext<K, P, AcquisitionError ? AcquisitionRequirements>,
  H: ConnectionHandler<P, A, E ? CallbackRequirements> + 'env,
  'env,
>(
  handle: &Handle<K, P, C>,
  key: &K,
  requestDeadline: Option<Instant>,
  acquisitionDeadline: Option<Instant>,
  handler: H,
) -> CheckoutResult<A>
! E | KeyCopyError | AcquisitionError | PoolError
? KeyCopyRequirements | AcquisitionRequirements | CallbackRequirements | &mut MonotonicClock
where
  &mut P provides &HttpTransport from &mut HttpTransport | &mut MonotonicClock | &mut Allocator | &mut Random,
  &mut P provides &HttpTransport from &mut HttpTransport {
  if !PoolContext<K, P, AcquisitionError ? AcquisitionRequirements>.accepts(
    &handle.context,
    key,
  ) {
    fail PoolError.ContextMismatch
  }
  let effective = earlierDeadline(&requestDeadline, &acquisitionDeadline)
  let now = run MonotonicClock.now()
  if deadlineExpired(&now, &effective) { fail PoolError.OpeningExpired }
  let state = Shared<PoolState<K, P>>.clone(&handle.state)
  let mut keepTrying = true
  let mut copied = Option<K>.some(run PoolKey<KeyCopyError ? KeyCopyRequirements>.copy(key))
  while keepTrying {
    let ownedKey = match move Intrinsic.replace(copied, Option<K>.none()) {
      Option.None => run PoolKey<KeyCopyError ? KeyCopyRequirements>.copy(key)
      Option.Some {value} => move value
    }
    let admitted = Shared.withMut(
      &state,
      reserveStep<P, KeyCopyError, KeyCopyRequirements, K>(move ownedKey, copyInstant(&now)),
    )
    match move admitted {
      Admission.Closed => { fail PoolError.PoolClosed }
      Admission.Full => { fail PoolError.PoolFull }
      Admission.Expired {connection} => {
        let mut expired = move connection
        run closeConnectionQuietly(&mut expired)
        copied = Option<K>.some(run PoolKey<KeyCopyError ? KeyCopyRequirements>.copy(key))
      }
      Admission.Selected {index, connection} => {
        let checkout = Checkout<K, P> {
          state: move state,
          index: index,
          source: CheckoutSource.Reused,
          idleTimeoutNanoseconds: handle.config.idleTimeoutNanoseconds,
          connection: Option<Connection<P>>.some(move connection),
          victim: Option<Connection<P>>.none(),
          reusable: false,
          returnedAt: Option<Instant>.none(),
          expiresAt: Option<Instant>.none(),
        }
        let use = effect fn(resource: &mut Checkout<K, P>) -> CheckoutResult<A>
        ! E | AcquisitionError | PoolError
        ? AcquisitionRequirements | CallbackRequirements | &mut MonotonicClock {
          return run checkoutUse<
            K, P, A, E, AcquisitionError, AcquisitionRequirements, CallbackRequirements, C, H,
          >(&mut resource.*, &handle.context, key, copyDeadline(&effective), move handler)
        }
        let release = effect fn(resource: &mut Checkout<K, P>) -> () {
          return run releaseCheckout(&mut resource.*)
        }
        return run Effect.useReleaseNonParking(move checkout, move use, move release)
      }
      Admission.Opening {index, victim} => {
        let checkout = Checkout<K, P> {
          state: move state,
          index: index,
          source: CheckoutSource.Opened,
          idleTimeoutNanoseconds: handle.config.idleTimeoutNanoseconds,
          connection: Option<Connection<P>>.none(),
          victim: move victim,
          reusable: false,
          returnedAt: Option<Instant>.none(),
          expiresAt: Option<Instant>.none(),
        }
        let use = effect fn(resource: &mut Checkout<K, P>) -> CheckoutResult<A>
        ! E | AcquisitionError | PoolError
        ? AcquisitionRequirements | CallbackRequirements | &mut MonotonicClock {
          return run checkoutUse<
            K, P, A, E, AcquisitionError, AcquisitionRequirements, CallbackRequirements, C, H,
          >(&mut resource.*, &handle.context, key, copyDeadline(&effective), move handler)
        }
        let release = effect fn(resource: &mut Checkout<K, P>) -> () {
          return run releaseCheckout(&mut resource.*)
        }
        return run Effect.useReleaseNonParking(move checkout, move use, move release)
      }
    }
  }
  return unavailable<CheckoutResult<A>>()
}

/// Closes all idle connections that have expired. It reads the clock one time.
///
/// Call it from time to time. No background task closes expired idle connections.
pub effect fn collect<K, P, C>(handle: &Handle<K, P, C>) -> Collection
? &mut MonotonicClock
where &mut P provides &HttpTransport from &mut HttpTransport {
  let now = run MonotonicClock.now()
  let expired = run drainExpired(&handle.state, &now)
  return Collection {expired: expired}
}

fn markClosed<K, P>(state: &mut PoolState<K, P>) -> () {
  state.closed = true
  return ()
}

fn extractAnyIdle<K, P>(state: &mut PoolState<K, P>) -> Option<Connection<P>> {
  let mut slots = List<PoolSlot<K, P>>.asMutSlice(&mut state.slots)
  let mut index = usize.ZERO
  while index < slots.length {
    let idle = match & slots[index] {
      PoolSlot.Idle {..} => true
      _ => false
    }
    if idle {
      let previous = replaceSlot(&mut slots[index], PoolSlot<K, P>.Vacant)
      let mut extracted = Option<Connection<P>>.none()
      match move previous {
        PoolSlot.Idle {key: ownedKey, connection: owned, returnedAt: _, expiresAt: _, sequence: _} => {
          drop ownedKey
          extracted = Option<Connection<P>>.some(move owned)
        }
        _ => { return unavailable<Option<Connection<P>>>() }
      }
      return move extracted
    }
    index = index + usize.ONE
  }
  return Option<Connection<P>>.none()
}

/// Closes the pool and all its idle connections.
///
/// Calling it again does nothing. Leased connections are closed when their handlers finish. If some
/// connections fail to close, it still closes the others, and then fails with the first error.
pub effect fn close<K, P, C>(pool: &mut Pool<K, P, C>) -> () ! ExchangeError
where &mut P provides &HttpTransport from &mut HttpTransport {
  Shared.withMut(&pool.handleValue.state, markClosed)
  let mut keepGoing = true
  let mut firstError = Option<ExchangeError>.none()
  while keepGoing {
    let selected = Shared.withMut(&pool.handleValue.state, extractAnyIdle)
    match move selected {
      Option.None => { keepGoing = false }
      Option.Some {value} => {
        let mut owned = move value
        let attempted = run Effect.result(Client.close(&mut owned))
        match move attempted {
          Result<(), ExchangeError>.Success {value: closed} => { drop closed }
          Result<(), ExchangeError>.Failure {error} => {
            let unrecorded = match & firstError {
              Option.None => true
              Option.Some {..} => false
            }
            if unrecorded { firstError = Option<ExchangeError>.some(move error) } else { drop error }
          }
        }
      }
    }
  }
  return match move firstError {
    Option.None => ()
    Option.Some {value} => { fail move value }
  }
}

effect fn closeQuietly<K, P, C>(pool: &mut Pool<K, P, C>) -> ()
where &mut P provides &HttpTransport from &mut HttpTransport {
  let attempted = run Effect.result(close(&mut pool.*))
  drop attempted
  return ()
}

fn unavailable<T>() -> T {
  return Intrinsic.trap("HTTP connection pool: an internal state was empty where the pool had just filled it")
}
