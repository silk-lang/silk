//! Native WebSocket clients and split sessions over TCP and TLS.
//!
//! # When to use
//! Call [`connect`] to open a client session to a `ws` or `wss` URI. Call [`split`] on a session
//! over a `NativeTransport`, from [`connect`] or from `acceptOwned` of
//! `silk.http.websocket_upgrade`, so that one fiber reads while other fibers send.
//!
//! # Details
//! [`connect`] opens the connection with `acquireOwned` of `silk.http.exchange_native`, then calls
//! `handshake` of `silk.http.websocket_client`. A `wss` URI uses TLS with the trust snapshot that
//! you give, and offers only HTTP/1.1 in ALPN.
//!
//! [`split`] splits the socket, and for TLS the session, so the reader and the writers do not
//! wait for each other.
//!
//! # Errors
//! [`connect`] fails with the errors of the connection and of the handshake. `OriginError` if the
//! URI is not a `ws`, `wss`, `http`, or `https` URI.
//!
//! # Gotchas
//! - With a host name, the deadline of the options must be `None`, as for `acquireOwned`.
//! - The session does not close the transport. Close it when the session is `Closed` or failed.
//!
//! # Examples
//! ## Split an accepted session
//! ```silk
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.http.exchange_native { NativeTransport }
//! import silk.http.websocket_native { split }
//! import silk.http.websocket_stream { Split, WebSocket }
//!
//! // Splits `socket`, so a fiber can read with the reader while others send with the writer.
//! effect fn halves(socket: WebSocket<NativeTransport>) -> Split<NativeTransport, NativeTransport>
//!   ! OutOfMemoryError
//!   ? &mut Allocator {
//!   return run split(move socket)
//! }
//!
//! pub fn main() -> i32 {
//!   return 0
//! }
//! ```
//!
//! @category HTTP

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.http.exchange { ExchangeError, Limits }
import silk.http.exchange_native { NativeExchangeError, NativeTransport, NativeTransportHalves, Options as NativeOptions, acquireOwned }
import silk.http.headers { Headers }
import silk.http.origin { Origin, OriginError }
import silk.http.request { RequestError }
import silk.http.websocket_client { ClientOptions, HandshakeError, Opened, handshake }
import silk.http.websocket_stream { Split, StreamError, TransportHalves, WebSocket, fromHalves }
import silk.net.resolver { ResolverError }
import silk.net.socket_native { NativeSocketError }
import silk.system.monotonic_clock { MonotonicClock }
import silk.system.random { Random }
import silk.system.system_clock { Instant, SystemClock }
import silk.tls.connection { ConnectionError }
import silk.tls.https_identity { IdentityError }
import silk.tls.trust_snapshot { TrustSnapshot }
import silk.uri.uri { Uri }

/// Opens a connection to the origin of `uri`, sends the opening handshake, and returns the open
/// client session.
///
/// # Details
/// `native` sets the socket and TLS options. The deadline of `options` limits the connection too.
/// `preparedTrust` is needed for `wss`. `headers` are sent with the handshake, as for `handshake`.
///
/// # Errors
/// - `OriginError` if `uri` has no valid origin.
/// - `NativeExchangeError`, `ResolverError`, `NativeSocketError`, `ConnectionError`, and
///   `IdentityError` from the connection, as for `acquireOwned`.
/// - [`HandshakeError`], `ExchangeError`, `RequestError`, and `StreamError` from the handshake.
/// - `OutOfMemoryError` if a buffer cannot grow.
pub effect fn connect<'value>(
  uri: &Uri<'value>,
  headers: &Headers<'value>,
  options: ClientOptions<'value>,
  native: NativeOptions,
  preparedTrust: Option<TrustSnapshot>,
) -> Opened<NativeTransport>
! OriginError | NativeExchangeError | ResolverError | NativeSocketError | ConnectionError | IdentityError | HandshakeError | ExchangeError | RequestError | StreamError | OutOfMemoryError
? &mut Allocator | &mut MonotonicClock | &mut SystemClock | &mut Random {
  let origin = match Origin.fromUri(uri) {
    Result.Success {value} => value
    Result.Failure {error} => { fail move error }
  }
  let connection = run acquireOwned(origin, move native, Limits.defaults(), move preparedTrust, copyDeadline(&options.deadline))
  return run handshake(move connection, uri, headers, move options)
}

/// Splits a session over a `NativeTransport` into a reader and a writer.
///
/// # Errors
/// `OutOfMemoryError` if the shared state cannot be allocated.
///
/// # Gotchas
/// It traps if the transport is already a half.
pub effect fn split(socket: WebSocket<NativeTransport>) -> Split<NativeTransport, NativeTransport>
! OutOfMemoryError
? &mut Allocator {
  let detached = socket.detach()
  let NativeTransportHalves {reader, writer} = run detached.transport.split()
  return run fromHalves(TransportHalves<NativeTransport, NativeTransport> {reader: move reader, writer: move writer}, move detached.parts)
}

fn copyDeadline(value: &Option<Instant>) -> Option<Instant> {
  return match &value.* {
    Option.None => Option<Instant>.none()
    Option.Some {value: present} => Option<Instant>.some(
      SystemClock.make(SystemClock.seconds(&present), SystemClock.nanoseconds(&present)),
    )
  }
}
