  /// Reads all of `text` as a decimal `i8`. One leading `-` is accepted.
  ///
  /// # Details
  ///
  /// Only the digits `0` to `9` and one leading `-` are accepted. The minimum value reads
  /// correctly. A leading `+`, spaces, and separators are not accepted.
  ///
  /// # Errors
  ///
  /// - [`NotANumber`] if `text` is empty or has a character that is not part of the number. The
  ///   offset is the position of that character, or the length of `text` if a digit is missing at
  ///   the end.
  /// - [`OutOfRange`] if the value is less than `i8.MIN` or more than `i8.MAX`.
  pub fn i8Value(text: string) -> Result<i8, ParseError> {
    return match move Format.signedValue(text) {
      Result<i64, ParseError>.Success { value } => narrowI8(value)
      Result<i64, ParseError>.Failure { error } => Result<i8, ParseError>.failResult(move error)
    }
  }

