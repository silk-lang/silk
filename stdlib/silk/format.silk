//! Text output for values through the ambient `Writer`, compile-time checked templates, and decimal
//! parsing.
//!
//! # When to use
//! Use [`Format.display`] to write one value with default options. Use [`Format.displayWith`] to
//! write one value with a width, fill, sign, or precision. Use [`Format.format`] to write a
//! template such as `"{name} has {count}"` with values from a tuple or record. Implement
//! [`Display`] to make your own type usable with all three. Implement [`Debug`] to show a value
//! for a programmer with `{:?}`, [`Format.debug`], and [`Format.debugWith`].
//!
//! Use [`Format.i32Value`], [`Format.f64Value`], and the other `...Value` functions to read decimal
//! text back into a number. They accept the default output of `Display` for the same type.
//!
//! # Details
//! Output goes to the ambient `Writer` effect. A [`Formatter`] holds only the options. No operation
//! in this module allocates, and none makes an intermediate `String`.
//!
//! Integers display in decimal, or in hexadecimal, octal, or binary with a [`Style`]. Finite
//! floats display as the shortest decimal that parses back to the same bits, and negative zero
//! displays as `-0`. If you set a precision, a float displays with exactly that many fractional
//! digits, rounded half to even. That output does not always parse back to the same bits.
//!
//! Width counts Unicode scalars, not UTF-8 bytes and not terminal columns. The compiler parses and
//! checks templates, selects fields, and selects `Display` implementations, so a bad template is a
//! compile error, not a runtime error.
//!
//! # Errors
//! - `WriterError` if the ambient `Writer` fails. The bytes that the writer accepted before the
//!   failure stay written. This module does not roll output back.
//! - [`ParseError`] from the `...Value` parse functions, with the reason [`NotANumber`] or
//!   [`OutOfRange`].
//!
//! Numbers align to the right by default. Text, `bool`, and `char` align to the left by default.
//!
//! # Gotchas
//! `NaN` and `Infinity` ignore precision and zero padding. To check that a float is finite before
//! you display it, use `f64.isFinite` or `f32.isFinite`.
//!
//! # Examples
//! ## Write a padded number and a template into a buffer
//! ```silk
//! import silk.effect { Effect }
//! import silk.format { Alignment, Format, FormatOptions, Sign, Style }
//! import silk.option { Option }
//! import silk.writer { Writer, WriterError }
//!
//! struct CaptureWriter {
//!   bytes: [u8; 64],
//!   length: usize,
//! }
//!
//! impl Writer for CaptureWriter {
//!   effect fn writeAll(self: &mut Self, value: &[u8]) -> ()
//!     ! WriterError
//!     ? &mut Writer {
//!     let mut index: usize = 0
//!     while index < value.length {
//!       self.bytes[self.length] = value[index]
//!       self.length = self.length + 1
//!       index = index + 1
//!     }
//!     return ()
//!   }
//!
//!   effect fn flush(self: &mut Self) -> ()
//!     ! WriterError
//!     ? &mut Writer {
//!     return ()
//!   }
//! }
//!
//! fn holds(writer: &CaptureWriter, expected: &[u8]) -> bool {
//!   if writer.length != expected.length {
//!     return false
//!   }
//!   let mut index: usize = 0
//!   while index < expected.length {
//!     if writer.bytes[index] != expected[index] {
//!       return false
//!     }
//!     index = index + 1
//!   }
//!   return true
//! }
//!
//! effect fn render() -> ()
//!   ! WriterError
//!   ? &mut Writer {
//!   let value = 42
//!   let options = FormatOptions {
//!     width: Option<usize>.some(6),
//!     alignment: Alignment.Right,
//!     fill: '.',
//!     sign: Sign.Always,
//!     alternate: false,
//!     zeroPad: false,
//!     precision: Option<usize>.none(),
//!     color: false,
//!     style: Style.Default,
//!   }
//!   run Format.displayWith(&value, move options)
//!   let args = .{ name: "Ada", count: 3 }
//!   return run Format.format(" {name} has {count}", &args)
//! }
//!
//! pub effect fn main() -> i32
//!   ! WriterError {
//!   let mut writer = CaptureWriter { bytes: [0; 64], length: 0 }
//!   run render() |> Effect.provideMut<Writer>(&mut writer)
//!   if !holds(&writer, b"...+42 Ada has 3") {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! ## Read a number from text
//! ```silk
//! import silk.format { Format, NotANumber, OutOfRange, ParseError }
//! import silk.result { Result }
//!
//! fn read(text: string) -> i32 {
//!   return match move Format.i32Value(text) {
//!     Result<i32, ParseError>.Success { value } => value
//!     Result<i32, ParseError>.Failure { error } => match move error.reason {
//!       NotANumber { offset } => -1
//!       OutOfRange {} => -2
//!     }
//!   }
//! }
//!
//! pub fn main() -> i32 {
//!   if read("-17") != -17 || read("12x") != -1 || read("3000000000") != -2 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! # See also
//! - `silk.writer` for the `Writer` effect that receives the output.
//! - `silk.os_writer` for `StdoutWriter` and `StderrWriter`, which write to standard output and
//!   standard error.
//!
//! @category Text

import silk.char
import silk.f32
import silk.f64
import silk.i16
import silk.i32
import silk.i64
import silk.i8
import silk.isize
import silk.list { List }
import silk.option { Option }
import silk.ownership { Copy }
import silk.reflect { Reflect, namedKind, positionalKind, anonymousNamedKind, anonymousPositionalKind, arrayKind, labeledFieldKind, positionalFieldKind }
import silk.result { Result }
import silk.slice { Slice }
import silk.static_sequence { StaticSequence }
import silk.static_text { StaticText }
import silk.string { String, InvalidUtf8 }
import silk.u16
import silk.u32
import silk.u64
import silk.u8
import silk.usize
import silk.writer { Writer, WriterError }

/// The owner type of the formatting and parsing operations. It has no fields and is never
/// constructed.
///
/// # When to use
///
/// Use [`Format.display`] to write one value with default options, [`Format.displayWith`] to set a
/// width, fill, sign, or precision, and [`Format.format`] to write a template such as
/// `"{name} has {count}"`. Use [`Format.debug`] to show a value for a programmer. Use
/// [`Format.i32Value`], [`Format.f64Value`], and the other `...Value` functions to read decimal
/// text back into a number. They accept the default `Display` output of the same type.
///
/// # Details
///
/// Output goes to the ambient `Writer` effect. No operation allocates, and none makes an
/// intermediate `String`. Integers display in decimal, or in another base with a [`Style`]. Finite
/// floats display as the shortest decimal that parses back to the same bits, and negative zero
/// displays as `-0`. With a precision, a float displays with exactly that many fractional digits,
/// rounded half to even, and that output does not always parse back to the same bits. Width counts
/// Unicode scalars, not UTF-8 bytes and not terminal columns. Numbers align to the right by
/// default. Text, `bool`, and `char` align to the left by default.
///
/// # Errors
///
/// - `WriterError` if the ambient `Writer` fails. The bytes that the writer accepted before the
///   failure stay written. Nothing is rolled back.
/// - [`ParseError`] from the `...Value` parse functions.
///
/// # Gotchas
///
/// `NaN` and `Infinity` ignore precision and zero padding. To check that a float is finite before
/// you display it, use `f64.isFinite` or `f32.isFinite`.
pub struct Format {}

impl Format {
  /// Returns the default [`FormatOptions`].
  ///
  /// # Details
  ///
  /// The defaults are: no width, `Alignment.Default`, a space as fill, `Sign.NegativeOnly`, no
  /// alternate form, no zero padding, no precision, no color, and `Style.Default`.
  /// [`Format.display`] uses these options.
  pub fn defaultOptions() -> FormatOptions {
    return FormatOptions {
      width: Option<usize>.none(),
      alignment: Alignment.Default,
      fill: ' ',
      sign: Sign.NegativeOnly,
      alternate: false,
      zeroPad: false,
      precision: Option<usize>.none(),
      color: false,
      style: Style.Default,
    }
  }

  /// Returns a [`Formatter`] that uses `options`.
  ///
  /// # When to use
  ///
  /// Use `make` when you call `Display.display` directly. [`Format.displayWith`] calls it for you.
  pub fn make(options: FormatOptions) -> Formatter {
    return Formatter { options: move options, depth: usize.ZERO }
  }

  /// Returns a [`Formatter`] that uses [`Format.defaultOptions`].
  pub fn makeDefault() -> Formatter { return Format.make(Format.defaultOptions()) }

  /// Returns `true` if the options set a minimum width.
  pub fn hasWidth(self: &Formatter) -> bool {
    return match &self.options.width {
      Option<usize>.Some { value } => true
      Option<usize>.None => false
    }
  }

  /// Returns the minimum width in Unicode scalars. Returns 0 if the options set no width.
  pub fn width(self: &Formatter) -> usize {
    return match &self.options.width {
      Option<usize>.Some { value } => value
      Option<usize>.None => usize.ZERO
    }
  }

  /// Returns the alignment of the content inside the width.
  pub fn alignment(self: &Formatter) -> Alignment { return self.options.alignment }

  /// Returns the character that fills the space up to the width.
  pub fn fill(self: &Formatter) -> char { return self.options.fill }

  /// Returns the sign rule for numbers.
  pub fn sign(self: &Formatter) -> Sign { return self.options.sign }

  /// Returns the style that selects the number base or notation.
  pub fn style(self: &Formatter) -> Style { return self.options.style }

  /// Returns `true` if the options ask for the alternate form.
  ///
  /// # Details
  ///
  /// The standard integers write a base prefix (`0x`, `0o`, `0b`) in the alternate form of a
  /// [`Style`] other than `Style.Default`. A `Display` implementation that you write can use the
  /// flag and must document what it changes.
  pub fn alternate(self: &Formatter) -> bool { return self.options.alternate }

  /// Returns `true` if the options ask to pad numbers with zeros up to the width.
  ///
  /// # Details
  ///
  /// The zeros go after the sign, so `-7` with width 4 displays as `-007`. A precision turns off
  /// this padding for integers but not for floats. `NaN` and `Infinity` pad with the fill
  /// character.
  pub fn zeroPad(self: &Formatter) -> bool { return self.options.zeroPad }

  /// Returns `true` if the options set a precision.
  pub fn hasPrecision(self: &Formatter) -> bool {
    return match &self.options.precision {
      Option<usize>.Some { value } => true
      Option<usize>.None => false
    }
  }

  /// Returns the precision. Returns 0 if the options set no precision.
  ///
  /// # Details
  ///
  /// For integers, the precision is the minimum number of digits, with leading zeros. For floats,
  /// it is the exact number of digits after the decimal point. For text, it is the maximum number
  /// of Unicode scalars.
  pub fn precision(self: &Formatter) -> usize {
    return match &self.options.precision {
      Option<usize>.Some { value } => value
      Option<usize>.None => usize.ZERO
    }
  }

  /// Returns `true` if the output can contain ANSI color codes.
  ///
  /// # Details
  ///
  /// This is a permission, not a request. The standard `Display` implementations never write color
  /// codes.
  pub fn color(self: &Formatter) -> bool { return self.options.color }

  /// Writes `bytes` to the ambient `Writer` as they are. It does not apply width or other options.
  ///
  /// # Errors
  ///
  /// - `WriterError` if the ambient `Writer` fails. The bytes that the writer accepted before the
  ///   failure stay written. Nothing is rolled back.
  pub effect fn write(
    self: &mut Formatter,
    bytes: &[u8]
  ) -> () ! WriterError ? &mut Writer {
    return run Writer.writeAll(bytes)
  }

  /// Writes the UTF-8 bytes of `text` to the ambient `Writer`. It does not apply width or other
  /// options.
  ///
  /// # Errors
  ///
  /// - `WriterError` if the ambient `Writer` fails. The bytes that the writer accepted before the
  ///   failure stay written. Nothing is rolled back.
  pub effect fn writeText(
    self: &mut Formatter,
    text: string
  ) -> () ! WriterError ? &mut Writer {
    return run Format.write(&mut self, String.utf8Bytes(text))
  }

  /// Writes the fill character `count` times.
  ///
  /// # Errors
  ///
  /// - `WriterError` if the ambient `Writer` fails. The bytes that the writer accepted before the
  ///   failure stay written. Nothing is rolled back.
  pub effect fn writePadding(
    self: &mut Formatter,
    count: usize
  ) -> () ! WriterError ? &mut Writer {
    let encoded = encodeFill(self.options.fill)
    let mut remaining = count
    while 4 <= remaining {
      run writeFillGroup(&mut self, &encoded, 4)
      remaining = remaining - 4
    }
    return run writeFillGroup(&mut self, &encoded, remaining)
  }

  /// Returns how many fill characters go before content that is `contentWidth` scalars wide.
  ///
  /// # When to use
  ///
  /// Use it in a `Display` implementation to align content whose byte length is not its visible
  /// width, for example content with ANSI color codes. Pair it with [`Format.trailingPadding`], or
  /// use [`Format.writeLeadingPadding`] to write the fill.
  ///
  /// # Details
  ///
  /// The result is 0 if the width is not more than `contentWidth`. Otherwise the extra space is the
  /// width minus `contentWidth`. `Alignment.Default` and `Alignment.Right` put all of it before the
  /// content. `Alignment.Left` puts none of it there. `Alignment.Center` puts half of it there,
  /// rounded down.
  pub fn leadingPadding(self: &Formatter, contentWidth: usize) -> usize {
    return fillBefore(&self, contentWidth, Alignment.Right)
  }

  /// Returns how many fill characters go after content that is `contentWidth` scalars wide.
  ///
  /// # Details
  ///
  /// The result is 0 if the width is not more than `contentWidth`. `Alignment.Left` puts all extra
  /// space after the content. `Alignment.Default` and `Alignment.Right` put none of it there.
  /// `Alignment.Center` puts half of it there, rounded up, so the two sides add up to the extra
  /// space.
  pub fn trailingPadding(self: &Formatter, contentWidth: usize) -> usize {
    return fillAfter(&self, contentWidth, Alignment.Right)
  }

  /// Writes the fill that goes before content that is `contentWidth` scalars wide. The count comes
  /// from [`Format.leadingPadding`].
  ///
  /// # Errors
  ///
  /// - `WriterError` if the ambient `Writer` fails. The bytes that the writer accepted before the
  ///   failure stay written. Nothing is rolled back.
  pub effect fn writeLeadingPadding(
    self: &mut Formatter,
    contentWidth: usize
  ) -> () ! WriterError ? &mut Writer {
    let count = Format.leadingPadding(&self, contentWidth)
    return run Format.writePadding(&mut self, count)
  }

  /// Writes the fill that goes after content that is `contentWidth` scalars wide. The count comes
  /// from [`Format.trailingPadding`].
  ///
  /// # Errors
  ///
  /// - `WriterError` if the ambient `Writer` fails. The bytes that the writer accepted before the
  ///   failure stay written. Nothing is rolled back.
  pub effect fn writeTrailingPadding(
    self: &mut Formatter,
    contentWidth: usize
  ) -> () ! WriterError ? &mut Writer {
    let count = Format.trailingPadding(&self, contentWidth)
    return run Format.writePadding(&mut self, count)
  }

  /// Writes `text` with the width, fill, alignment, and precision of the options.
  ///
  /// # When to use
  ///
  /// Use it in a `Display` implementation that writes one piece of text, so that your type pads
  /// and cuts like a string does. The `Display` implementation for `string` calls it.
  ///
  /// # Details
  ///
  /// The precision is the maximum number of Unicode scalars to write, and the rest is cut. The
  /// width counts the scalars that are written. `Alignment.Default` puts the content on the left.
  /// The sign, zero padding, and alternate options do not apply.
  ///
  /// # Errors
  ///
  /// - `WriterError` if the ambient `Writer` fails. The bytes that the writer accepted before the
  ///   failure stay written. Nothing is rolled back.
  pub effect fn padText(
    self: &mut Formatter,
    text: string
  ) -> () ! WriterError ? &mut Writer {
    return run padBytes(&mut self, String.utf8Bytes(text))
  }

  /// Writes the digits of a number with the sign, width, fill, alignment, and zero padding of the
  /// options.
  ///
  /// # When to use
  ///
  /// Use it in a `Display` implementation for a number type, so that your type pads like the
  /// standard integers. Calculate the digits yourself, without a sign.
  ///
  /// # Details
  ///
  /// The output is the sign, then `prefix`, then `digits`. The sign comes from `negative` and the
  /// sign rule. `prefix` is text such as `0x` that goes before the digits; use `""` for none. Zero
  /// padding puts the zeros between `prefix` and `digits`. `Alignment.Default` puts the content on
  /// the right. This operation ignores the precision.
  ///
  /// # Errors
  ///
  /// - `WriterError` if the ambient `Writer` fails. The bytes that the writer accepted before the
  ///   failure stay written. Nothing is rolled back.
  pub effect fn padNumber(
    self: &mut Formatter,
    negative: bool,
    prefix: string,
    digits: string
  ) -> () ! WriterError ? &mut Writer {
    let core = signWidth(&self, negative) + scalarCount(String.utf8Bytes(prefix))
      + scalarCount(String.utf8Bytes(digits))
    let padding = numberPadding(&self, core, true)
    run writeNumberStart(&mut self, &padding, negative)
    run Format.writeText(&mut self, prefix)
    run writeZeroes(&mut self, padding.zeros)
    run Format.writeText(&mut self, digits)
    return run Format.writePadding(&mut self, padding.after)
  }

  /// Writes `value` to the ambient `Writer` with [`Format.defaultOptions`].
  ///
  /// # When to use
  ///
  /// Use `display` to write one value. Use [`Format.displayWith`] to set a width, fill, sign, or
  /// precision. Use [`Format.format`] to write several values in a template.
  ///
  /// # Errors
  ///
  /// - `WriterError` if the ambient `Writer` fails. The bytes that the writer accepted before the
  ///   failure stay written. Nothing is rolled back.
  pub effect fn display<T: Display>(value: &T) -> () ! WriterError ? &mut Writer {
    let mut formatter = Format.makeDefault()
    return run Display.display(&value, &mut formatter)
  }

  /// Writes `value` to the ambient `Writer` with `options`.
  ///
  /// # Details
  ///
  /// For integers, the precision is a minimum digit count and turns off zero padding. For floats,
  /// the precision is the exact number of fractional digits, rounded half to even. For text, the
  /// precision is the maximum number of Unicode scalars, and the rest is cut. Integers use
  /// `style` for the base and `alternate` for the base prefix. The standard implementations ignore
  /// `color`. Width counts Unicode scalars. Numbers align to the right by default. Text, `bool`,
  /// and `char` align to the left by default.
  ///
  /// # Gotchas
  ///
  /// `NaN` and `Infinity` ignore precision and zero padding. With a precision, float output does
  /// not always parse back to the same bits.
  ///
  /// # Errors
  ///
  /// - `WriterError` if the ambient `Writer` fails. The bytes that the writer accepted before the
  ///   failure stay written. Nothing is rolled back.
  pub effect fn displayWith<T: Display>(
    value: &T,
    options: FormatOptions
  ) -> () ! WriterError ? &mut Writer {
    let mut formatter = Format.make(move options)
    return run Display.display(&value, &mut formatter)
  }

  /// Writes the [`Debug`] form of `value` to the ambient `Writer` with
  /// [`Format.defaultOptions`].
  ///
  /// # When to use
  ///
  /// Use it to show a value to a programmer, for example in a log or a test failure. Strings show
  /// with quotes and escapes, so you can see spaces and control characters.
  ///
  /// # Errors
  ///
  /// - `WriterError` if the ambient `Writer` fails. The bytes that the writer accepted before the
  ///   failure stay written. Nothing is rolled back.
  pub effect fn debug<T: Debug>(value: &T) -> () ! WriterError ? &mut Writer {
    let mut formatter = Format.makeDefault()
    return run Debug.debug(&value, &mut formatter)
  }

  /// Writes the [`Debug`] form of `value` to the ambient `Writer` with `options`.
  ///
  /// # Details
  ///
  /// `alternate` selects the pretty form, with one field or element on each line and four spaces
  /// of indentation for each level. Numbers apply the other options as `Display` does.
  ///
  /// # Errors
  ///
  /// - `WriterError` if the ambient `Writer` fails. The bytes that the writer accepted before the
  ///   failure stay written. Nothing is rolled back.
  pub effect fn debugWith<T: Debug>(
    value: &T,
    options: FormatOptions
  ) -> () ! WriterError ? &mut Writer {
    let mut formatter = Format.make(move options)
    return run Debug.debug(&value, &mut formatter)
  }

  /// Writes the visible fields of `value` in the [`Debug`] form, after `name`.
  ///
  /// # When to use
  ///
  /// Use it to implement `Debug` for your struct in one line:
  /// `return run Format.debugFields(self, "Point", &mut formatter)`.
  ///
  /// # Details
  ///
  /// A struct with labeled fields writes `Point { x: 1, y: 2 }`. A struct with positional fields
  /// writes `Pair(1, 2)`. With no visible field, only `name` is written. The pretty form
  /// ([`Format.alternate`]) puts each field on its own line. Every field must implement `Debug`;
  /// the compiler checks this for each type that you call it with.
  ///
  /// # Errors
  ///
  /// - `WriterError` if the ambient `Writer` fails. The bytes that the writer accepted before the
  ///   failure stay written. Nothing is rolled back.
  ///
  /// # Gotchas
  ///
  /// Reflection sees fields from this module, so it shows only the `pub` fields of your type. To
  /// show private fields, write the `Debug` implementation by hand.
  pub effect fn debugFields<T>(
    value: &T,
    static name: string<'static>,
    formatter: &mut Formatter
  ) -> () ! WriterError ? &mut Writer {
    run Format.writeText(&mut formatter, name)
    let mut first = true
    static if Reflect.typeKind(Reflect.typeOf<T>()) == namedKind ||
      Reflect.typeKind(Reflect.typeOf<T>()) == anonymousNamedKind {
      static for field in Reflect.fields<T>() {
        static if Reflect.fieldKind(field) == labeledFieldKind {
          if first {
            if StaticText.byteLength(name) != usize.ZERO { run Format.write(&mut formatter, b" ") }
            run Format.write(&mut formatter, b"{")
          }
          run debugSeparator(&mut formatter, first, true)
          run Format.writeText(&mut formatter, Reflect.fieldLabel(field))
          run Format.write(&mut formatter, b": ")
          static if fieldValueKind(field) == anonymousPositionalKind || fieldValueKind(field) == anonymousNamedKind {
            run Format.debugFields(Reflect.borrowField(value, field), "", &mut formatter)
            run debugMemberEnd(&mut formatter)
          } else {
            static if fieldValueKind(field) == arrayKind {
              run Format.debugList(Reflect.borrowField(value, field), &mut formatter)
              run debugMemberEnd(&mut formatter)
            } else {
              run debugMember(&mut formatter, Reflect.borrowField(value, field))
            }
          }
          first = false
        }
      }
      if !first {
        run debugClose(&mut formatter, true)
        run Format.write(&mut formatter, b"}")
      }
    } else {
      static for field in Reflect.fields<T>() {
        static if Reflect.fieldKind(field) == positionalFieldKind {
          if first { run Format.write(&mut formatter, b"(") }
          run debugSeparator(&mut formatter, first, false)
          static if fieldValueKind(field) == anonymousPositionalKind || fieldValueKind(field) == anonymousNamedKind {
            run Format.debugFields(Reflect.borrowField(value, field), "", &mut formatter)
            run debugMemberEnd(&mut formatter)
          } else {
            static if fieldValueKind(field) == arrayKind {
              run Format.debugList(Reflect.borrowField(value, field), &mut formatter)
              run debugMemberEnd(&mut formatter)
            } else {
              run debugMember(&mut formatter, Reflect.borrowField(value, field))
            }
          }
          first = false
        }
      }
      if !first {
        run debugClose(&mut formatter, false)
        run Format.write(&mut formatter, b")")
      }
    }
    return ()
  }

  /// Writes the elements of `values` in the [`Debug`] form, as `[1, 2, 3]`.
  ///
  /// # When to use
  ///
  /// Use it to implement `Debug` for a type that holds a sequence. The pretty form
  /// ([`Format.alternate`]) puts each element on its own line.
  ///
  /// # Errors
  ///
  /// - `WriterError` if the ambient `Writer` fails. The bytes that the writer accepted before the
  ///   failure stay written. Nothing is rolled back.
  pub effect fn debugList<T: Debug>(
    values: &[T],
    formatter: &mut Formatter
  ) -> () ! WriterError ? &mut Writer {
    run Format.write(&mut formatter, b"[")
    let mut index = usize.ZERO
    while index < values.length {
      run debugSeparator(&mut formatter, index == usize.ZERO, false)
      run debugMember(&mut formatter, &values[index])
      index = index + usize.ONE
    }
    if values.length != usize.ZERO { run debugClose(&mut formatter, false) }
    return run Format.write(&mut formatter, b"]")
  }

  /// Starts the [`Debug`] form of a value with labeled fields by writing `name`.
  ///
  /// # When to use
  ///
  /// Use it to implement `Debug` by hand when [`Format.debugFields`] does not fit: the type has
  /// private fields, or it is a union with fields in a variant. Write each field with
  /// [`Format.debugField`] and end with [`Format.debugFinish`]. This one leaves out a secret:
  ///
  /// ```silk
  /// import silk.format { Debug, Format, Formatter }
  /// import silk.writer { Writer, WriterError }
  ///
  /// struct Account {
  ///   pub name: string,
  ///   secret: string,
  /// }
  ///
  /// impl Debug for Account {
  ///   effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
  ///     let mut record = run Format.debugRecord("Account", &mut formatter)
  ///     run Format.debugField(&mut record, "name", &self.name, &mut formatter)
  ///     return run Format.debugFinish(record, &mut formatter)
  ///   }
  /// }
  ///
  /// pub fn main() -> i32 {
  ///   let account = Account { name: "ada", secret: "hunter2" }
  ///   return 0
  /// }
  /// ```
  ///
  /// It writes `Account { name: "ada" }`. A record with no field writes only its name. The pretty
  /// form ([`Format.alternate`]) puts each field on its own line.
  ///
  /// # Errors
  ///
  /// - `WriterError` if the ambient `Writer` fails. The bytes that the writer accepted before the
  ///   failure stay written. Nothing is rolled back.
  pub effect fn debugRecord(
    name: string,
    formatter: &mut Formatter
  ) -> DebugRecord ! WriterError ? &mut Writer {
    run Format.writeText(&mut formatter, name)
    return DebugRecord { first: true }
  }

  /// Writes one field of a record that [`Format.debugRecord`] started, as `label: value`.
  ///
  /// # Errors
  ///
  /// - `WriterError` if the ambient `Writer` fails. The bytes that the writer accepted before the
  ///   failure stay written. Nothing is rolled back.
  pub effect fn debugField<T: Debug>(
    record: &mut DebugRecord,
    label: string,
    value: &T,
    formatter: &mut Formatter
  ) -> () ! WriterError ? &mut Writer {
    if record.first { run Format.write(&mut formatter, b" {") }
    run debugSeparator(&mut formatter, record.first, true)
    run Format.writeText(&mut formatter, label)
    run Format.write(&mut formatter, b": ")
    run debugMember(&mut formatter, value)
    record.first = false
    return ()
  }

  /// Ends a record that [`Format.debugRecord`] started. It writes the closing `}` when the record
  /// has a field.
  ///
  /// # Errors
  ///
  /// - `WriterError` if the ambient `Writer` fails. The bytes that the writer accepted before the
  ///   failure stay written. Nothing is rolled back.
  pub effect fn debugFinish(
    record: DebugRecord,
    formatter: &mut Formatter
  ) -> () ! WriterError ? &mut Writer {
    if record.first { return () }
    run debugClose(&mut formatter, true)
    return run Format.write(&mut formatter, b"}")
  }

  /// Writes `template` to the ambient `Writer` and replaces each placeholder with a value from
  /// `args`.
  ///
  /// # When to use
  ///
  /// Use `format` when the text is known at compile time and each value implements [`Display`].
  ///
  /// # Details
  ///
  /// - `{}` takes the next field of a tuple, in order.
  /// - `{1}` takes the tuple field `1`. The same field can show more than one time. `{}` counts
  ///   from field `0` and ignores the `{1}` placeholders, as in Rust.
  /// - `{name}` takes the record field `name`.
  /// - `{{` writes `{` and `}}` writes `}`.
  ///
  /// A placeholder can set options after a colon, as in Rust: `{:>8}`, `{name:*^10.2}`. The
  /// options are, in this order and each optional:
  ///
  /// - A fill character and an alignment: `<` left, `^` center, `>` right. The fill needs an
  ///   alignment after it, so `{:*<6}` pads with `*`. Without a fill, the fill is a space.
  /// - `+` for `Sign.Always`. `-` is the default and changes nothing.
  /// - `#` for the alternate form.
  /// - `0` for zero padding.
  /// - A width in decimal digits, or `1$` or `w$` to take it from the integer field `1` or `w`.
  /// - `.` and a precision in decimal digits, or `.1$` or `.p$` to take it from an integer field.
  ///   For an integer value the precision is a minimum count of digits, so `{:.3}` of 7 is `007`;
  ///   Rust ignores it there.
  /// - A type: `x` lowercase hexadecimal, `X` uppercase hexadecimal, `o` octal, `b` binary. These
  ///   need an integer, and `#` adds the prefix `0x`, `0o`, or `0b`. `e` and `E` write a float in
  ///   scientific notation, such as `1.25e3`; these need a float. `?` writes the [`Debug`]
  ///   form, and `#?` the pretty `Debug` form.
  ///
  /// The compiler parses the options and checks the template and the fields. A placeholder without
  /// options uses [`Format.defaultOptions`]. `format` borrows `args`.
  ///
  /// # Errors
  ///
  /// - `WriterError` if the ambient `Writer` fails. The bytes that the writer accepted before the
  ///   failure stay written. Nothing is rolled back.
  ///
  /// # Gotchas
  ///
  /// One template cannot mix tuple fields and record fields: `{}`, `{1}`, and `1$` need a tuple,
  /// and `{name}` and `w$` need a record. A template with tuple fields must use each field at
  /// least one time, as a value, a width, or a precision. A malformed template, a malformed
  /// option, a field that does not exist, or a type such as `x` on a value that it does not apply
  /// to is a compile error. A width or precision field that is not an integer is a compile error,
  /// and a negative one traps.
  /// `Sign.Space` and `color` are available only through [`FormatOptions`].
  ///
  /// # Examples
  ///
  /// ## Write a tuple and a record
  ///
  /// ```silk
  /// import silk.effect { Effect }
  /// import silk.format { Format }
  /// import silk.writer { Writer, WriterError }
  ///
  /// struct CaptureWriter {
  ///   bytes: [u8; 64],
  ///   length: usize,
  /// }
  ///
  /// impl Writer for CaptureWriter {
  ///   effect fn writeAll(self: &mut Self, value: &[u8]) -> ()
  ///     ! WriterError
  ///     ? &mut Writer {
  ///     let mut index: usize = 0
  ///     while index < value.length {
  ///       self.bytes[self.length] = value[index]
  ///       self.length = self.length + 1
  ///       index = index + 1
  ///     }
  ///     return ()
  ///   }
  ///
  ///   effect fn flush(self: &mut Self) -> ()
  ///     ! WriterError
  ///     ? &mut Writer {
  ///     return ()
  ///   }
  /// }
  ///
  /// fn holds(writer: &CaptureWriter, expected: &[u8]) -> bool {
  ///   if writer.length != expected.length {
  ///     return false
  ///   }
  ///   let mut index: usize = 0
  ///   while index < expected.length {
  ///     if writer.bytes[index] != expected[index] {
  ///       return false
  ///     }
  ///     index = index + 1
  ///   }
  ///   return true
  /// }
  ///
  /// effect fn render() -> ()
  ///   ! WriterError
  ///   ? &mut Writer {
  ///   let pair = (3, 4)
  ///   run Format.format("{} + {} = 7. ", &pair)
  ///   let user = .{ name: "Ada", age: 36 }
  ///   run Format.format("{name} is {age} {{years}}. ", &user)
  ///   let price = .{ item: "tea", cost: 2.5 }
  ///   run Format.format("[{item:.<6}{cost:>6.2}] ", &price)
  ///   return run Format.format("{:#06x} {:b} {:.2e}", &(255, 5, 1234.5))
  /// }
  ///
  /// effect fn reuse() -> ()
  ///   ! WriterError
  ///   ? &mut Writer {
  ///   let width: usize = 5
  ///   run Format.format("{0}-{1}-{0} ", &("ab", 7))
  ///   return run Format.format("[{name:>width$}]", &.{ name: "Ada", width: width })
  /// }
  ///
  /// pub effect fn main() -> i32
  ///   ! WriterError {
  ///   let mut writer = CaptureWriter { bytes: [0; 64], length: 0 }
  ///   run render() |> Effect.provideMut<Writer>(&mut writer)
  ///   if !holds(&writer, b"3 + 4 = 7. Ada is 36 {years}. [tea...  2.50] 0x00ff 101 1.23e3") {
  ///     return 1
  ///   }
  ///   let mut second = CaptureWriter { bytes: [0; 64], length: 0 }
  ///   run reuse() |> Effect.provideMut<Writer>(&mut second)
  ///   if !holds(&second, b"ab-7-ab [  Ada]") {
  ///     return 1
  ///   }
  ///   return 0
  /// }
  /// ```
  pub effect fn format<Args>(
    static template: string<'static>,
    args: &Args
  ) -> () ! WriterError ? &mut Writer {
    let mut formatter = Format.makeDefault()
    static for part in validatedTemplate<Args>(template) {
      static if part.mode == PartMode.Literal {
        run Format.writeText(&mut formatter, part.text)
      } else {
        // A width or precision from an argument adds to the template's own, which is then zero.
        let mut width = usize.ZERO
        let mut precision = usize.ZERO
        static if part.widthArgument {
          static for field in Reflect.fields<Args>() {
            static if selectsField(field, part.widthName, part.widthOrdinal) {
              width = argumentCount(Intrinsic.borrowField(args, field))
            }
          }
        }
        static if part.precisionArgument {
          static for field in Reflect.fields<Args>() {
            static if selectsField(field, part.precisionName, part.precisionOrdinal) {
              precision = argumentCount(Intrinsic.borrowField(args, field))
            }
          }
        }
        static for field in Reflect.fields<Args>() {
          static if part.mode == PartMode.Positional {
            static if Reflect.fieldKind(field) == positionalFieldKind {
              static if Reflect.fieldOrdinal(field) == part.ordinal {
                let value = Intrinsic.borrowField(args, field)
                static if !part.hasSpec {
                  run Format.display(value)
                } else {
                  let options = specOptions(
                    part.fill, part.alignment, part.sign, part.alternate, part.zeroPad,
                    part.hasWidth || part.widthArgument, part.width + width,
                    part.hasPrecision || part.precisionArgument, part.precision + precision, part.style
                  )
                  static if part.debug {
                    static if fieldValueKind(field) == anonymousPositionalKind || fieldValueKind(field) == anonymousNamedKind {
                      run debugFieldsWith(value, move options)
                    } else {
                      static if fieldValueKind(field) == arrayKind {
                        run debugListWith(value, move options)
                      } else {
                        run Format.debugWith(value, move options)
                      }
                    }
                  } else {
                  static if part.style == Style.Default {
                    run Format.displayWith(value, move options)
                  } else {
                    static if part.style == Style.LowerExp || part.style == Style.UpperExp {
                      run displayExponent(value, move options)
                    } else {
                      run displayRadix(value, move options)
                    }
                  }
                  }
                }
              }
            }
          } else {
            static if Reflect.fieldKind(field) == labeledFieldKind {
              static if Reflect.fieldLabel(field) == part.text {
                let value = Intrinsic.borrowField(args, field)
                static if !part.hasSpec {
                  run Format.display(value)
                } else {
                  let options = specOptions(
                    part.fill, part.alignment, part.sign, part.alternate, part.zeroPad,
                    part.hasWidth || part.widthArgument, part.width + width,
                    part.hasPrecision || part.precisionArgument, part.precision + precision, part.style
                  )
                  static if part.debug {
                    static if fieldValueKind(field) == anonymousPositionalKind || fieldValueKind(field) == anonymousNamedKind {
                      run debugFieldsWith(value, move options)
                    } else {
                      static if fieldValueKind(field) == arrayKind {
                        run debugListWith(value, move options)
                      } else {
                        run Format.debugWith(value, move options)
                      }
                    }
                  } else {
                  static if part.style == Style.Default {
                    run Format.displayWith(value, move options)
                  } else {
                    static if part.style == Style.LowerExp || part.style == Style.UpperExp {
                      run displayExponent(value, move options)
                    } else {
                      run displayRadix(value, move options)
                    }
                  }
                  }
                }
              }
            }
          }
        }
      }
    }
    return ()
  }

  /// Reads all of `text` as a decimal `u64`.
  ///
  /// # Details
  ///
  /// `text` must contain only the digits `0` to `9`. Signs, spaces, and separators are not
  /// accepted. Leading zeros are accepted.
  ///
  /// # Errors
  ///
  /// - [`NotANumber`] if `text` is empty or has a character that is not part of the number. The
  ///   offset is the position of that character, or the length of `text` if a digit is missing at
  ///   the end.
  /// - [`OutOfRange`] if the value is more than `u64.MAX`.
  pub fn unsignedValue(text: string) -> Result<u64, ParseError> {
    let bytes = String.utf8Bytes(text)
    if bytes.length == usize.ZERO { return notANumber<u64>(usize.ZERO) }
    let mut index = usize.ZERO
    let mut total = ZERO
    while index < bytes.length {
      let digit = digitValue(bytes[index])
      if digit < 0 { return notANumber<u64>(index) }
      if u64.MAX / TEN < total { return outOfRange<u64>() }
      total = total * TEN
      let addend = i32.toU64(digit)
      if u64.MAX - addend < total { return outOfRange<u64>() }
      total = total + addend
      index = index + usize.ONE
    }
    return Result<u64, ParseError>.succeed(total)
  }

  /// Reads all of `text` as a decimal `i64`. One leading `-` is accepted.
  ///
  /// # Details
  ///
  /// `i64.MIN` reads correctly. A leading `+`, spaces, and separators are not accepted.
  ///
  /// # Errors
  ///
  /// - [`NotANumber`] if `text` is empty or has a character that is not part of the number. The
  ///   offset is the position of that character, or the length of `text` if a digit is missing at
  ///   the end.
  /// - [`OutOfRange`] if the value is less than `i64.MIN` or more than `i64.MAX`.
  pub fn signedValue(text: string) -> Result<i64, ParseError> {
    let bytes = String.utf8Bytes(text)
    let mut index = usize.ZERO
    let mut negative = false
    if usize.ZERO < bytes.length {
      if bytes[usize.ZERO] == ASCII_MINUS {
        negative = true
        index = usize.ONE
      }
    }
    if index == bytes.length { return notANumber<i64>(index) }
    let mut total = SIGNED_ZERO
    while index < bytes.length {
      let digit = digitValue(bytes[index])
      if digit < 0 { return notANumber<i64>(index) }
      if total < i64.MIN / SIGNED_TEN { return outOfRange<i64>() }
      total = total * SIGNED_TEN
      let subtrahend = i32.toI64(digit)
      if total < i64.MIN + subtrahend { return outOfRange<i64>() }
      total = total - subtrahend
      index = index + usize.ONE
    }
    if negative { return Result<i64, ParseError>.succeed(total) }
    if total < SIGNED_ZERO - i64.MAX { return outOfRange<i64>() }
    return Result<i64, ParseError>.succeed(SIGNED_ZERO - total)
  }

  /// Reads all of `text` as a decimal `f64`.
  ///
  /// # Details
  ///
  /// The accepted form is an optional `+` or `-`, digits with an optional `.` and fraction, and an
  /// optional exponent `e` or `E` with an optional sign. There must be at least one digit before or
  /// after the `.`. The value is rounded correctly to the nearest `f64`, with ties to even. A value
  /// too large for `f64` becomes infinity with the same sign. A value too small becomes zero with
  /// the same sign. The result does not depend on floating-point arithmetic of the target.
  ///
  /// # Errors
  ///
  /// - [`NotANumber`] if `text` is empty or has a character that is not part of the number. The
  ///   offset is the position of that character, or the length of `text` if a digit is missing at
  ///   the end.
  ///
  /// # Gotchas
  ///
  /// `NaN`, `Infinity`, and `inf` are not accepted, so the output of `Display` for a value that is
  /// not finite does not parse back.
  pub fn f64Value(text: string) -> Result<f64, ParseError> {
    let bytes = String.utf8Bytes(text)
    return match move parseDecimal(bytes) {
      Result<DecimalText, ParseError>.Failure { error } => Result<f64, ParseError>.failResult(move error)
      Result<DecimalText, ParseError>.Success { value } => {
        let magnitude = decimalFloatBits(bytes, &value, 52, 1023, 9218868437227405312)
        let mut bits = magnitude
        if value.negative { bits = u64.bitOr(bits, 9223372036854775808) }
        return Result<f64, ParseError>.succeed(f64.fromBits(bits))
      }
    }
  }

  /// Reads all of `text` as a decimal `f32`.
  ///
  /// # Details
  ///
  /// The accepted form is an optional `+` or `-`, digits with an optional `.` and fraction, and an
  /// optional exponent `e` or `E` with an optional sign. There must be at least one digit before or
  /// after the `.`. The value is rounded correctly to the nearest `f32`, with ties to even. A value
  /// too large for `f32` becomes infinity with the same sign. A value too small becomes zero with
  /// the same sign. The text is rounded to `f32` directly, not through `f64`, so there is no double
  /// rounding.
  ///
  /// # Errors
  ///
  /// - [`NotANumber`] if `text` is empty or has a character that is not part of the number. The
  ///   offset is the position of that character, or the length of `text` if a digit is missing at
  ///   the end.
  ///
  /// # Gotchas
  ///
  /// `NaN`, `Infinity`, and `inf` are not accepted, so the output of `Display` for a value that is
  /// not finite does not parse back.
  pub fn f32Value(text: string) -> Result<f32, ParseError> {
    let bytes = String.utf8Bytes(text)
    return match move parseDecimal(bytes) {
      Result<DecimalText, ParseError>.Failure { error } => Result<f32, ParseError>.failResult(move error)
      Result<DecimalText, ParseError>.Success { value } => {
        let magnitude = decimalFloatBits(bytes, &value, 23, 127, 2139095040)
        let mut bits = magnitude
        if value.negative { bits = u64.bitOr(bits, 2147483648) }
        return Result<f32, ParseError>.succeed(f32.fromBits(u64.toU32(bits)))
      }
    }
  }

  /// Reads all of `text` as a decimal `u8`.
  ///
  /// # Details
  ///
  /// `text` must contain only the digits `0` to `9`. Signs, spaces, and separators are not
  /// accepted. Leading zeros are accepted.
  ///
  /// # Errors
  ///
  /// - [`NotANumber`] if `text` is empty or has a character that is not part of the number. The
  ///   offset is the position of that character, or the length of `text` if a digit is missing at
  ///   the end.
  /// - [`OutOfRange`] if the value is more than `u8.MAX`.
  pub fn u8Value(text: string) -> Result<u8, ParseError> {
    return match move Format.unsignedValue(text) {
      Result<u64, ParseError>.Success { value } => narrowU8(value)
      Result<u64, ParseError>.Failure { error } => Result<u8, ParseError>.failResult(move error)
    }
  }

