//! Draws a benchmark report as text: a table for a terminal, with optional color, and Markdown.
//!
//! # When to use
//! Call [`Render.terminal`] or [`Render.markdown`] on a `silk.bench.record.Report` to show a
//! saved run again, or to put a run in a pull request. `silk.bench.bench` calls them for the
//! outputs a suite declares with `Format.Terminal` and `Format.Markdown`. Use
//! `silk.bench.html` for a page with charts.
//!
//! # Details
//! Each benchmark is one table with one row for each implementation: the median time, its 95%
//! interval, the fastest run, the processor time, the peak memory, and the ratio to the
//! reference with its interval and verdict. A renderer computes nothing: every number comes
//! from the report.
//!
//! With color, a ratio is green or red only when its verdict is `faster` or `slower`, and dim
//! when no difference was found. The words stay, so a report without color, or read by someone
//! who cannot tell the colors apart, says the same.
//!
//! @category Benchmarks

import silk.bench.record { Comparison, Environment, Overall, Report, Row, Subject, Table }
import silk.bench.units { Units }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f64
import silk.num.u64
import silk.num.usize
import silk.text.string { String }

const COLUMNS: usize = 7

const BAR_CELLS: usize = 12

const RESET: string<'static> = "\x1b[0m"

const BOLD: string<'static> = "\x1b[1m"

const DIM: string<'static> = "\x1b[2m"

const RED: string<'static> = "\x1b[31m"

const GREEN: string<'static> = "\x1b[32m"

const YELLOW: string<'static> = "\x1b[33m"

// One row of a table as text, before it is padded.
struct Line {
  cells: List<String>,
  // "faster", "slower", "same", or empty for a row without a ratio.
  verdict: string<'static>,
  // The row's median as a share of the table's largest median, for the bar.
  share: f64,
}

/// The owner type of the text renderers. It has no fields and is never constructed.
pub struct Render {}

impl Render {
  /// Returns `report` as a table for a terminal. With `color`, it holds ANSI escape codes.
  ///
  /// # Errors
  /// `OutOfMemoryError` if the `Allocator` cannot supply the text.
  pub effect fn terminal(report: &Report, color: bool) -> String
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut text = String.make()
    let tables = report.benchmarks.asSlice()
    let mut at: usize = 0
    while at < tables.length {
      run terminalTable(&mut text, report, &tables[at], color)
      at = at + 1
    }
    let overall = report.overall.asSlice()
    at = 0
    while at < overall.length {
      run paint(&mut text, BOLD, "overall", color)
      run text.append("  ")
      run text.append(overall[at].implementation.view())
      run text.append(" ")
      run text.appendOwned(run Units.ratio(overall[at].ratio))
      run text.append(" ")
      run text.append(report.reference.view())
      run text.append(" (geometric mean of ")
      run Units.appendWhole(&mut text, overall[at].benchmarks)
      run text.append(" benchmarks)\n")
      at = at + 1
    }
    if overall.length > 0 {
      run text.append("\n")
    }
    let mut details = List<String>.make()
    run describe(&mut details, report)
    let lines = details.asSlice()
    at = 0
    while at < lines.length {
      run paint(&mut text, DIM, lines[at].view(), color)
      run text.append("\n")
      at = at + 1
    }
    return move text
  }

  /// Returns `report` as Markdown: a heading and a table for each benchmark, then the run's
  /// details as a list.
  ///
  /// # Errors
  /// `OutOfMemoryError` if the `Allocator` cannot supply the text.
  pub effect fn markdown(report: &Report) -> String
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut text = String.make()
    run text.append("# ")
    run text.append(report.suite.view())
    run text.append("\n\n")
    let tables = report.benchmarks.asSlice()
    let mut at: usize = 0
    while at < tables.length {
      if tables.length > 1 || tables[at].name.view() != report.suite.view() {
        run text.append("## ")
        run text.append(tables[at].name.view())
        run text.append("\n\n")
      }
      let titles = run headings(report.reference.view())
      run markdownRow(&mut text, titles.asSlice())
      run text.append("| :-- | --: | --: | --: | --: | --: | :-- |\n")
      let rows = tables[at].rows.asSlice()
      let mut row: usize = 0
      while row < rows.length {
        let line = run lineOf(&rows[row], 1.0, report.floor)
        run markdownRow(&mut text, line.cells.asSlice())
        row = row + 1
      }
      run text.append("\n")
      row = 0
      while row < rows.length {
        if rows[row].failures > 0 {
          run text.append("**")
          run text.appendOwned(run failureText(&rows[row]))
          run text.append("**\n\n")
        }
        row = row + 1
      }
      at = at + 1
    }
    let overall = report.overall.asSlice()
    at = 0
    while at < overall.length {
      run text.append("Overall, ")
      run text.append(overall[at].implementation.view())
      run text.append(" takes ")
      run text.appendOwned(run Units.ratio(overall[at].ratio))
      run text.append(" the time of ")
      run text.append(report.reference.view())
      run text.append(" (geometric mean of ")
      run Units.appendWhole(&mut text, overall[at].benchmarks)
      run text.append(" benchmarks).\n\n")
      at = at + 1
    }
    let mut details = List<String>.make()
    run describe(&mut details, report)
    let lines = details.asSlice()
    at = 0
    while at < lines.length {
      run text.append("- ")
      run text.append(lines[at].view())
      run text.append("\n")
      at = at + 1
    }
    return move text
  }

  /// Returns the lines that describe the run of `report` under its tables: the computer, the
  /// dates, the label, the revisions, and the notes.
  ///
  /// # Errors
  /// `OutOfMemoryError` if the `Allocator` cannot supply the lines.
  pub effect fn details(report: &Report) -> List<String>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut lines = List<String>.make()
    run describe(&mut lines, report)
    return move lines
  }

  /// Returns the text of the peak memory column for `row`, such as `4.20 MiB`. A peak that is
  /// not above `floor`, the smallest the run could see, is written as `≤ 16.6 MiB`.
  ///
  /// # Errors
  /// `OutOfMemoryError` if the `Allocator` cannot supply the text.
  pub effect fn memory(row: &Row, floor: u64) -> String
    ! OutOfMemoryError
    ? &mut Allocator {
    if floor > 0 && row.peak <= u64.toF64(floor) {
      let mut text = run String.copy("≤ ")
      run text.appendOwned(run Units.memory(u64.toF64(floor)))
      return move text
    }
    return run Units.memory(row.peak)
  }

  /// Returns the text of the ratio column for `row`: `reference`, `-` for a row with no
  /// successful run, or the ratio with its interval and verdict, such as
  /// `0.49x [0.47, 0.51] faster`.
  ///
  /// # Errors
  /// `OutOfMemoryError` if the `Allocator` cannot supply the text.
  pub effect fn comparison(row: &Row) -> String
    ! OutOfMemoryError
    ? &mut Allocator {
    if row.reference {
      return run String.copy("reference")
    }
    return match &row.ratio {
      Option<Comparison>.Some { value } => {
        let mut text = run Units.ratio(value.value)
        run text.append(" [")
        run Units.appendFixed(&mut text, value.low, 2)
        run text.append(", ")
        run Units.appendFixed(&mut text, value.high, 2)
        run text.append("] ")
        if value.verdict.view() == "same" {
          run text.append("no difference")
        } else {
          run text.append(value.verdict.view())
        }
        move text
      }
      Option<Comparison>.None => run String.copy("-")
    }
  }
}

effect fn headings(reference: string) -> List<String>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut titles = List<String>.make()
  run titles.append(run String.copy("implementation"))
  run titles.append(run String.copy("median"))
  run titles.append(run String.copy("95% interval"))
  run titles.append(run String.copy("fastest"))
  run titles.append(run String.copy("processor"))
  run titles.append(run String.copy("peak memory"))
  let mut versus = run String.copy("vs ")
  run versus.append(reference)
  run titles.append(move versus)
  return move titles
}

fn verdictOf(row: &Row) -> string<'static> {
  if let Option<Comparison>.Some { value } = &row.ratio {
    if value.verdict.view() == "faster" {
      return "faster"
    }
    if value.verdict.view() == "slower" {
      return "slower"
    }
    return "same"
  }
  return ""
}

effect fn lineOf(row: &Row, largest: f64, floor: u64) -> Line
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut cells = List<String>.make()
  run cells.append(run String.copy(row.implementation.view()))
  if row.runs == 0 {
    let mut blank: usize = 1
    while blank < COLUMNS - 1 {
      run cells.append(run String.copy("-"))
      blank = blank + 1
    }
    run cells.append(run Render.comparison(row))
    return Line { cells: move cells, verdict: "", share: 0.0 }
  }
  let scale = Units.scale(row.median)
  let mut median = run Units.scaled(row.median, scale)
  run median.append(" ")
  run median.append(scale.name)
  run cells.append(move median)
  let mut interval = run String.copy("[")
  run interval.appendOwned(run Units.scaled(row.low, scale))
  run interval.append(", ")
  run interval.appendOwned(run Units.scaled(row.high, scale))
  run interval.append("] ")
  run interval.append(scale.name)
  run cells.append(move interval)
  let mut fastest = run Units.scaled(row.minimum, scale)
  run fastest.append(" ")
  run fastest.append(scale.name)
  run cells.append(move fastest)
  run cells.append(run Units.duration(row.user + row.system))
  run cells.append(run Render.memory(row, floor))
  run cells.append(run Render.comparison(row))
  let mut share = 0.0
  if largest > 0.0 {
    share = row.median / largest
  }
  return Line { cells: move cells, verdict: verdictOf(row), share: share }
}

effect fn failureText(row: &Row) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = run String.copy(row.implementation.view())
  run text.append(": ")
  run Units.appendWhole(&mut text, row.failures)
  run text.append(" of ")
  run Units.appendWhole(&mut text, row.failures + row.runs)
  run text.append(" runs failed and are in no statistic")
  return move text
}

effect fn paint(text: &mut String, code: string, value: string, color: bool) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if color {
    run text.append(code)
  }
  run text.append(value)
  if color {
    run text.append(RESET)
  }
}

effect fn spaces(text: &mut String, count: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut at: usize = 0
  while at < count {
    run text.append(" ")
    at = at + 1
  }
}

effect fn terminalTable(text: &mut String, report: &Report, table: &Table, color: bool) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run paint(&mut text, BOLD, table.name.view(), color)
  let mut about = run String.copy("  ")
  run Units.appendWhole(&mut about, report.runs)
  run about.append(" runs, reference ")
  run about.append(report.reference.view())
  run paint(&mut text, DIM, about.view(), color)
  run text.append("\n")

  let rows = table.rows.asSlice()
  let mut largest = 0.0
  let mut row: usize = 0
  while row < rows.length {
    largest = f64.max(largest, rows[row].median)
    row = row + 1
  }
  let titles = run headings(report.reference.view())
  let mut lines = List<Line>.make()
  row = 0
  while row < rows.length {
    run lines.append(run lineOf(&rows[row], largest, report.floor))
    row = row + 1
  }
  let mut widths: [usize; 7] = [0; 7]
  let mut column: usize = 0
  while column < COLUMNS {
    widths[column] = Units.width(titles.asSlice()[column].view())
    row = 0
    while row < lines.length() {
      let wide = Units.width(lines.asSlice()[row].cells.asSlice()[column].view())
      if wide > widths[column] {
        widths[column] = wide
      }
      row = row + 1
    }
    column = column + 1
  }

  run text.append("  ")
  column = 0
  while column < COLUMNS {
    if column == COLUMNS - 1 {
      // Nothing follows the last title, so it takes no padding.
      run paint(&mut text, DIM, titles.asSlice()[column].view(), color)
    } else {
      run cell(&mut text, titles.asSlice()[column].view(), widths[column], column, DIM, color)
    }
    column = column + 1
  }
  run text.append("\n")
  row = 0
  while row < lines.length() {
    let line = &lines.asSlice()[row]
    run text.append("  ")
    column = 0
    while column < COLUMNS {
      let mut code = ""
      if column == COLUMNS - 1 {
        if line.verdict == "faster" {
          code = GREEN
        } else if line.verdict == "slower" {
          code = RED
        } else if line.verdict == "same" {
          code = DIM
        }
      }
      run cell(&mut text, line.cells.asSlice()[column].view(), widths[column], column, code, color)
      column = column + 1
    }
    run bar(&mut text, line.share, color)
    run text.append("\n")
    row = row + 1
  }
  row = 0
  while row < rows.length {
    if rows[row].failures > 0 {
      run text.append("  ")
      let warning = run failureText(&rows[row])
      run paint(&mut text, YELLOW, warning.view(), color)
      run text.append("\n")
    }
    row = row + 1
  }
  run text.append("\n")
}

// One padded cell and the gap after it. The first and last columns are left-aligned.
effect fn cell(
  text: &mut String,
  value: string,
  width: usize,
  column: usize,
  code: string,
  color: bool,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let padding = width - Units.width(value)
  let left = column == 0 || column == COLUMNS - 1
  if !left {
    run spaces(&mut text, padding)
  }
  if String.byteLength(code) > 0 {
    run paint(&mut text, code, value, color)
  } else {
    run text.append(value)
  }
  if left {
    run spaces(&mut text, padding)
  }
  run text.append("  ")
}

effect fn bar(text: &mut String, share: f64, color: bool) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if share <= 0.0 {
    return ()
  }
  let mut filled = f64.toUsize(f64.floor(share * usize.toF64(BAR_CELLS) + 0.5))
  if filled == 0 {
    filled = 1
  }
  if filled > BAR_CELLS {
    filled = BAR_CELLS
  }
  if color {
    run text.append(DIM)
  }
  let mut at: usize = 0
  while at < filled {
    run text.append("█")
    at = at + 1
  }
  if color {
    run text.append(RESET)
  }
}

effect fn markdownRow(text: &mut String, cells: &[String]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run text.append("|")
  let mut at: usize = 0
  while at < cells.length {
    run text.append(" ")
    run text.append(cells[at].view())
    run text.append(" |")
    at = at + 1
  }
  run text.append("\n")
}

effect fn describe(lines: &mut List<String>, report: &Report) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let environment = &report.environment
  let mut computer = run String.copy(environment.system.view())
  run computer.append(" ")
  run computer.append(environment.release.view())
  run computer.append(" ")
  run computer.append(environment.machine.view())
  run computer.append(", ")
  run computer.append(environment.processor.view())
  run computer.append(", ")
  run Units.appendWhole(&mut computer, environment.usable)
  run computer.append(" of ")
  run Units.appendWhole(&mut computer, environment.processors)
  run computer.append(" processors, ")
  run computer.appendOwned(run Units.memory(u64.toF64(environment.memory)))
  run computer.append(", load ")
  run Units.appendFixed(&mut computer, environment.load, 2)
  run lines.append(move computer)

  let mut when = run String.copy("started ")
  run when.append(report.started.view())
  run when.append(", ended ")
  run when.append(report.ended.view())
  run when.append(", run ")
  run when.append(report.id.view())
  if let Option<String>.Some { value } = &report.label {
    run when.append(", label ")
    run when.append(value.view())
  }
  run lines.append(move when)

  let variables = environment.variables.asSlice()
  let mut at: usize = 0
  while at < variables.length {
    let mut variable = run String.copy(variables[at].name.view())
    run variable.append("=")
    run variable.append(variables[at].value.view())
    run lines.append(move variable)
    at = at + 1
  }
  let subjects = report.implementations.asSlice()
  at = 0
  while at < subjects.length {
    let mut subject = run String.copy(subjects[at].name.view())
    run subject.append(": ")
    run subject.append(subjects[at].command.view())
    if let Option<String>.Some { value } = &subjects[at].revision {
      run subject.append(" (revision ")
      run subject.append(value.view())
      run subject.append(")")
    }
    run lines.append(move subject)
    at = at + 1
  }
  let notes = report.notes.asSlice()
  at = 0
  while at < notes.length {
    let mut note = run String.copy("note: ")
    run note.append(notes[at].view())
    run lines.append(move note)
    at = at + 1
  }
}
