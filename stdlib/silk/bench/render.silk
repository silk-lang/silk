//! Draws a benchmark report as text: a table for a terminal, with optional color, and Markdown.
//!
//! # When to use
//! Call [`Render.terminal`] or [`Render.markdown`] on a `silk.bench.record.Report` to show a
//! saved run again, or to put a run in a pull request. `silk.bench.bench` calls them for the
//! outputs a suite declares with `Format.Terminal` and `Format.Markdown`. Use
//! `silk.bench.html` for a page with charts.
//!
//! # Details
//! Each benchmark is one table with one row for each implementation: the median time, its 95%
//! interval, the fastest run, the processor time, the peak memory, and the ratio to the
//! reference with its interval and verdict. A table of result lines has the median in the unit
//! of the lines and, in place of the processor time and the memory, one column for each other
//! unit the lines carry. A renderer computes nothing: every number comes
//! from the report.
//!
//! With color, a ratio is green or red only when its verdict is `faster` or `slower`, and dim
//! when no difference was found. The words stay, so a report without color, or read by someone
//! who cannot tell the colors apart, says the same.
//!
//! @category Benchmarks

import silk.bench.record {
  Chart,
  Comparison,
  Panel,
  Report,
  Row,
  Table
}
import silk.bench.units { Units }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f64
import silk.num.u64
import silk.num.usize
import silk.text.string { String }

const BAR_CELLS: usize = 12

const RESET: string<'static> = "\x1b[0m"

const BOLD: string<'static> = "\x1b[1m"

const DIM: string<'static> = "\x1b[2m"

const RED: string<'static> = "\x1b[31m"

const GREEN: string<'static> = "\x1b[32m"

const YELLOW: string<'static> = "\x1b[33m"

// One row of a table as text, before it is padded.
struct Line {
  cells: List<String>,
  // "faster", "slower", "same", or empty for a row without a ratio.
  verdict: string<'static>,
  // The row's median as a share of the table's largest median, for the bar.
  share: f64,
}

/// The owner type of the text renderers. It has no fields and is never constructed.
pub struct Render {}

impl Render {
  /// Returns `report` as a table for a terminal. With `color`, it holds ANSI escape codes.
  ///
  /// # Errors
  /// `OutOfMemoryError` if the `Allocator` cannot supply the text.
  pub effect fn terminal(report: &Report, color: bool) -> String
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut text = String.make()
    let tables = report.benchmarks.asSlice()
    let mut at: usize = 0
    while at < tables.length {
      run terminalTable(&mut text, report, &tables[at], color)
      at = at + 1
    }
    let overall = report.overall.asSlice()
    at = 0
    while at < overall.length {
      run paint(&mut text, BOLD, "overall", color)
      run text.append("  ")
      run text.append(overall[at].implementation.view())
      run text.append(" ")
      run text.appendOwned(run Units.ratio(overall[at].ratio))
      run text.append(" ")
      run text.append(report.reference.view())
      run text.append(" (geometric mean of ")
      run Units.appendWhole(&mut text, overall[at].benchmarks)
      run text.append(" benchmarks)\n")
      at = at + 1
    }
    if overall.length > 0 {
      run text.append("\n")
    }
    let charts = report.views.asSlice()
    at = 0
    while at < charts.length {
      if !Render.restates(report, &charts[at]) {
        run terminalChart(&mut text, &charts[at], color)
      }
      at = at + 1
    }
    let mut details = List<String>.make()
    run describe(&mut details, report)
    let lines = details.asSlice()
    at = 0
    while at < lines.length {
      run paint(&mut text, DIM, lines[at].view(), color)
      run text.append("\n")
      at = at + 1
    }
    return move text
  }

  /// Returns `report` as Markdown: a heading and a table for each benchmark, then the run's
  /// details as a list.
  ///
  /// # Errors
  /// `OutOfMemoryError` if the `Allocator` cannot supply the text.
  pub effect fn markdown(report: &Report) -> String
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut text = String.make()
    run text.append("# ")
    run text.append(report.suite.view())
    run text.append("\n\n")
    let tables = report.benchmarks.asSlice()
    let mut at: usize = 0
    while at < tables.length {
      if tables.length > 1 || tables[at].name.view() != report.suite.view() {
        run text.append("## ")
        run text.append(tables[at].name.view())
        run text.append("\n\n")
      }
      let extras = run extrasOf(&tables[at])
      let titles = run headings(report.reference.view(), &tables[at], extras.asSlice())
      run markdownRow(&mut text, titles.asSlice())
      run text.append("| :-- |")
      let mut column: usize = 2
      while column < titles.length() {
        run text.append(" --: |")
        column = column + 1
      }
      run text.append(" :-- |\n")
      let rows = tables[at].rows.asSlice()
      let mut row: usize = 0
      while row < rows.length {
        let line = run lineOf(&tables[at], extras.asSlice(), &rows[row], 1.0, report.floor)
        run markdownRow(&mut text, line.cells.asSlice())
        row = row + 1
      }
      run text.append("\n")
      if tables[at].mismatch {
        run text.append("**")
        run text.append(MISMATCH)
        run text.append("**\n\n")
      }
      row = 0
      while row < rows.length {
        if rows[row].failures > 0 {
          run text.append("**")
          run text.appendOwned(run failureText(&rows[row]))
          run text.append("**\n\n")
        }
        row = row + 1
      }
      at = at + 1
    }
    let overall = report.overall.asSlice()
    at = 0
    while at < overall.length {
      run text.append("Overall, ")
      run text.append(overall[at].implementation.view())
      run text.append(" takes ")
      run text.appendOwned(run Units.ratio(overall[at].ratio))
      run text.append(" the time of ")
      run text.append(report.reference.view())
      run text.append(" (geometric mean of ")
      run Units.appendWhole(&mut text, overall[at].benchmarks)
      run text.append(" benchmarks).\n\n")
      at = at + 1
    }
    let charts = report.views.asSlice()
    at = 0
    while at < charts.length {
      if !Render.restates(report, &charts[at]) {
        run markdownChart(&mut text, &charts[at])
      }
      at = at + 1
    }
    let mut details = List<String>.make()
    run describe(&mut details, report)
    let lines = details.asSlice()
    at = 0
    while at < lines.length {
      run text.append("- ")
      run text.append(lines[at].view())
      run text.append("\n")
      at = at + 1
    }
    return move text
  }

  /// Returns the lines that describe the run of `report` under its tables: the computer, the
  /// dates, the label, the revisions, and the notes.
  ///
  /// # Errors
  /// `OutOfMemoryError` if the `Allocator` cannot supply the lines.
  /// Returns whether `chart` says only what the tables of `report` already say: the median of
  /// every implementation relative to the reference, for each benchmark. The terminal and
  /// Markdown reports leave such a chart out.
  pub fn restates(report: &Report, chart: &Chart) -> bool {
    return chart.kind.view() == "ratio" && chart.normalize.view() == report.reference.view()
      && chart.x.view() == "benchmark"
      && chart.series.view() == "impl"
      && chart.stat.view() == "median"
      && String.byteLength(chart.facet.view()) == 0
  }

  /// Returns `panel` of `chart` as the rows of a table, for a renderer that shows a chart as
  /// text: a heading row, then one row for each series with one cell for each entry of the
  /// axis. A `distribution` gets the columns `runs`, `smallest`, `largest` and `spread`, where
  /// the spread is a small histogram of the measured runs between the smallest and the largest
  /// value of the panel.
  ///
  /// # Errors
  /// `OutOfMemoryError` if the `Allocator` cannot supply the cells.
  pub effect fn grid(chart: &Chart, panel: &Panel) -> List<List<String>>
    ! OutOfMemoryError
    ? &mut Allocator {
    if chart.kind.view() == "distribution" {
      return run spreadGrid(chart, panel)
    }
    let lists = panel.series.asSlice()
    let mut places = List<f64>.make()
    let mut labels = List<String>.make()
    let mut series: usize = 0
    while series < lists.length {
      let points = lists[series].points.asSlice()
      let mut at: usize = 0
      while at < points.length {
        let known = places.asSlice()
        let mut found = false
        let mut index: usize = 0
        while index < known.length {
          if known[index] == points[at].at {
            found = true
          }
          index = index + 1
        }
        if !found {
          run places.append(points[at].at)
          run labels.append(run String.copy(points[at].x.view()))
        }
        at = at + 1
      }
      series = series + 1
    }

    // The entries in the order of the axis.
    let known = places.asSlice()
    let named = labels.asSlice()
    let mut order = List<usize>.make()
    let mut place: usize = 0
    while place < known.length {
      let mut index: usize = 0
      while index < known.length {
        let mut before: usize = 0
        let mut other: usize = 0
        while other < known.length {
          if known[other] < known[index] {
            before = before + 1
          }
          other = other + 1
        }
        if before == place {
          run order.append(index)
        }
        index = index + 1
      }
      place = place + 1
    }
    let ordered = order.asSlice()

    let mut rows = List<List<String>>.make()
    let mut heading = List<String>.make()
    run heading.append(run String.copy(chart.series.view()))
    let mut at: usize = 0
    while at < ordered.length {
      run heading.append(run String.copy(named[ordered[at]].view()))
      at = at + 1
    }
    run rows.append(move heading)
    series = 0
    while series < lists.length {
      let points = lists[series].points.asSlice()
      let mut row = List<String>.make()
      run row.append(run String.copy(lists[series].name.view()))
      at = 0
      while at < ordered.length {
        let mut shown = run String.copy("-")
        let mut index: usize = 0
        while index < points.length {
          if points[index].at == known[ordered[at]] {
            shown = run amount(chart, points[index].value)
          }
          index = index + 1
        }
        run row.append(move shown)
        at = at + 1
      }
      run rows.append(move row)
      series = series + 1
    }
    return move rows
  }

  pub effect fn details(report: &Report) -> List<String>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut lines = List<String>.make()
    run describe(&mut lines, report)
    return move lines
  }

  /// Returns the column titles of `table`, for a renderer that draws its own table: the
  /// implementation, the median, its interval, the best value, the processor time and peak
  /// memory of a table of process times or one column for each other unit of a table of result
  /// lines, and last the comparison to the reference.
  ///
  /// # Errors
  /// `OutOfMemoryError` if the `Allocator` cannot supply the titles.
  pub effect fn titles(report: &Report, table: &Table) -> List<String>
    ! OutOfMemoryError
    ? &mut Allocator {
    let extras = run extrasOf(table)
    return run headings(report.reference.view(), table, extras.asSlice())
  }

  /// Returns the cells of `row`, a row of `table`, as text: one for each title of
  /// [`Render.titles`]. A row with no successful run has `-` in every cell between its name and
  /// its comparison.
  ///
  /// # Errors
  /// `OutOfMemoryError` if the `Allocator` cannot supply the cells.
  pub effect fn cells(report: &Report, table: &Table, row: &Row) -> List<String>
    ! OutOfMemoryError
    ? &mut Allocator {
    let extras = run extrasOf(table)
    let line = run lineOf(table, extras.asSlice(), row, 1.0, report.floor)
    return move line.cells
  }

  /// Returns the text of the peak memory column for `row`, such as `4.20 MiB`. A peak that is
  /// not above `floor`, the smallest the run could see, is written as `≤ 16.6 MiB`.
  ///
  /// # Errors
  /// `OutOfMemoryError` if the `Allocator` cannot supply the text.
  pub effect fn memory(row: &Row, floor: u64) -> String
    ! OutOfMemoryError
    ? &mut Allocator {
    if floor > 0 && row.peak <= u64.toF64(floor) {
      let mut text = run String.copy("≤ ")
      run text.appendOwned(run Units.memory(u64.toF64(floor)))
      return move text
    }
    return run Units.memory(row.peak)
  }

  /// Returns the text of the ratio column for `row`: `reference`, `-` for a row with no
  /// successful run, or the ratio with its interval and verdict, such as
  /// `0.49x [0.47, 0.51] faster`.
  ///
  /// # Errors
  /// `OutOfMemoryError` if the `Allocator` cannot supply the text.
  pub effect fn comparison(row: &Row) -> String
    ! OutOfMemoryError
    ? &mut Allocator {
    if row.reference {
      return run String.copy("reference")
    }
    return match &row.ratio {
      Option<Comparison>.Some { value } => {
        let mut text = run Units.ratio(value.value)
        run text.append(" [")
        run Units.appendFixed(&mut text, value.low, 2)
        run text.append(", ")
        run Units.appendFixed(&mut text, value.high, 2)
        run text.append("] ")
        if value.verdict.view() == "same" {
          run text.append("no difference")
        } else {
          run text.append(value.verdict.view())
        }
        move text
      }
      Option<Comparison>.None => run String.copy("-")
    }
  }
}

const MISMATCH: string<
  'static
> = "the checks differ, so the implementations did not do the same work and are not compared"

// Whether `table` holds the times of whole processes, not what result lines reported.
fn ofProcesses(table: &Table) -> bool {
  return table.unit.view() == "ns"
}

// The other units the rows of `table` carry, in the order they first appear.
effect fn extrasOf(table: &Table) -> List<String>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut units = List<String>.make()
  let rows = table.rows.asSlice()
  let mut row: usize = 0
  while row < rows.length {
    let others = rows[row].others.asSlice()
    let mut at: usize = 0
    while at < others.length {
      let known = units.asSlice()
      let mut found = false
      let mut index: usize = 0
      while index < known.length {
        if known[index].view() == others[at].unit.view() {
          found = true
        }
        index = index + 1
      }
      if !found {
        run units.append(run String.copy(others[at].unit.view()))
      }
      at = at + 1
    }
    row = row + 1
  }
  return move units
}

effect fn headings(reference: string, table: &Table, extras: &[String]) -> List<String>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut titles = List<String>.make()
  run titles.append(run String.copy("implementation"))
  run titles.append(run String.copy("median"))
  run titles.append(run String.copy("95% interval"))
  if table.higher {
    run titles.append(run String.copy("highest"))
  } else {
    run titles.append(run String.copy("fastest"))
  }
  if ofProcesses(table) {
    run titles.append(run String.copy("processor"))
    run titles.append(run String.copy("peak memory"))
  }
  let mut at: usize = 0
  while at < extras.length {
    run titles.append(run String.copy(extras[at].view()))
    at = at + 1
  }
  let mut versus = run String.copy("vs ")
  run versus.append(reference)
  run titles.append(move versus)
  return move titles
}

fn verdictOf(row: &Row) -> string<'static> {
  if let Option<Comparison>.Some { value } = &row.ratio {
    if value.verdict.view() == "faster" {
      return "faster"
    }
    if value.verdict.view() == "slower" {
      return "slower"
    }
    return "same"
  }
  return ""
}

effect fn lineOf(table: &Table, extras: &[String], row: &Row, largest: f64, floor: u64) -> Line
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut cells = List<String>.make()
  run cells.append(run String.copy(row.implementation.view()))
  if row.runs == 0 {
    let mut blanks = 3 + extras.length
    if ofProcesses(table) {
      blanks = blanks + 2
    }
    while blanks > 0 {
      run cells.append(run String.copy("-"))
      blanks = blanks - 1
    }
    run cells.append(run Render.comparison(row))
    return Line { cells: move cells, verdict: "", share: 0.0 }
  }
  let unit = table.unit.view()
  let scale = Units.measure(row.median, unit)
  let name = Units.named(scale, unit)
  let mut median = run Units.scaled(row.median, scale)
  run median.append(" ")
  run median.append(name)
  run cells.append(move median)
  let mut interval = run String.copy("[")
  run interval.appendOwned(run Units.scaled(row.low, scale))
  run interval.append(", ")
  run interval.appendOwned(run Units.scaled(row.high, scale))
  run interval.append("] ")
  run interval.append(name)
  run cells.append(move interval)
  let mut best = row.minimum
  if table.higher {
    best = row.maximum
  }
  let mut fastest = run Units.scaled(best, scale)
  run fastest.append(" ")
  run fastest.append(name)
  run cells.append(move fastest)
  if ofProcesses(table) {
    run cells.append(run Units.duration(row.user + row.system))
    run cells.append(run Render.memory(row, floor))
  }
  let others = row.others.asSlice()
  let mut extra: usize = 0
  while extra < extras.length {
    let mut cell = run String.copy("-")
    let mut at: usize = 0
    while at < others.length {
      if others[at].unit.view() == extras[extra].view() {
        cell = run Units.quantity(others[at].value, others[at].unit.view())
      }
      at = at + 1
    }
    run cells.append(move cell)
    extra = extra + 1
  }
  run cells.append(run Render.comparison(row))
  let mut share = 0.0
  if largest > 0.0 {
    share = row.median / largest
  }
  return Line { cells: move cells, verdict: verdictOf(row), share: share }
}

effect fn failureText(row: &Row) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = run String.copy(row.implementation.view())
  run text.append(": ")
  run Units.appendWhole(&mut text, row.failures)
  run text.append(" of ")
  run Units.appendWhole(&mut text, row.failures + row.runs)
  run text.append(" runs failed and are in no statistic")
  return move text
}

effect fn paint(text: &mut String, code: string, value: string, color: bool) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if color {
    run text.append(code)
  }
  run text.append(value)
  if color {
    run text.append(RESET)
  }
}

effect fn spaces(text: &mut String, count: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut at: usize = 0
  while at < count {
    run text.append(" ")
    at = at + 1
  }
}

effect fn terminalTable(text: &mut String, report: &Report, table: &Table, color: bool) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run paint(&mut text, BOLD, table.name.view(), color)
  let mut about = run String.copy("  ")
  run Units.appendWhole(&mut about, report.runs)
  run about.append(" runs, reference ")
  run about.append(report.reference.view())
  if !ofProcesses(table) {
    run about.append(", ")
    run about.append(table.unit.view())
  }
  run paint(&mut text, DIM, about.view(), color)
  run text.append("\n")

  let rows = table.rows.asSlice()
  let mut largest = 0.0
  let mut row: usize = 0
  while row < rows.length {
    largest = f64.max(largest, rows[row].median)
    row = row + 1
  }
  let extras = run extrasOf(table)
  let titles = run headings(report.reference.view(), table, extras.asSlice())
  let columns = titles.length()
  let mut lines = List<Line>.make()
  row = 0
  while row < rows.length {
    run lines.append(run lineOf(table, extras.asSlice(), &rows[row], largest, report.floor))
    row = row + 1
  }
  let mut measured = List<usize>.make()
  run measured.appendRepeated(0, columns)
  let widths = measured.asMutSlice()
  let mut column: usize = 0
  while column < columns {
    widths[column] = Units.width(titles.asSlice()[column].view())
    row = 0
    while row < lines.length() {
      let wide = Units.width(lines.asSlice()[row].cells.asSlice()[column].view())
      if wide > widths[column] {
        widths[column] = wide
      }
      row = row + 1
    }
    column = column + 1
  }

  run text.append("  ")
  column = 0
  while column < columns {
    if column == columns - 1 {
      // Nothing follows the last title, so it takes no padding.
      run paint(&mut text, DIM, titles.asSlice()[column].view(), color)
    } else {
      run cell(&mut text, titles.asSlice()[column].view(), widths[column], column == 0, DIM, color)
    }
    column = column + 1
  }
  run text.append("\n")
  row = 0
  while row < lines.length() {
    let line = &lines.asSlice()[row]
    run text.append("  ")
    column = 0
    while column < columns {
      let mut code = ""
      if column == columns - 1 {
        if line.verdict == "faster" {
          code = GREEN
        } else if line.verdict == "slower" {
          code = RED
        } else if line.verdict == "same" {
          code = DIM
        }
      }
      let left = column == 0 || column == columns - 1
      run cell(&mut text, line.cells.asSlice()[column].view(), widths[column], left, code, color)
      column = column + 1
    }
    run bar(&mut text, line.share, color)
    run text.append("\n")
    row = row + 1
  }
  row = 0
  while row < rows.length {
    if rows[row].failures > 0 {
      run text.append("  ")
      let warning = run failureText(&rows[row])
      run paint(&mut text, YELLOW, warning.view(), color)
      run text.append("\n")
    }
    row = row + 1
  }
  if table.mismatch {
    run text.append("  ")
    run paint(&mut text, YELLOW, MISMATCH, color)
    run text.append("\n")
  }
  run text.append("\n")
}

// One padded cell and the gap after it. The first and last columns are left-aligned.
effect fn cell(
  text: &mut String,
  value: string,
  width: usize,
  left: bool,
  code: string,
  color: bool,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let padding = width - Units.width(value)
  if !left {
    run spaces(&mut text, padding)
  }
  if String.byteLength(code) > 0 {
    run paint(&mut text, code, value, color)
  } else {
    run text.append(value)
  }
  if left {
    run spaces(&mut text, padding)
  }
  run text.append("  ")
}

effect fn bar(text: &mut String, share: f64, color: bool) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if share <= 0.0 {
    return ()
  }
  let mut filled = f64.toUsize(f64.floor(share * usize.toF64(BAR_CELLS) + 0.5))
  if filled == 0 {
    filled = 1
  }
  if filled > BAR_CELLS {
    filled = BAR_CELLS
  }
  if color {
    run text.append(DIM)
  }
  let mut at: usize = 0
  while at < filled {
    run text.append("█")
    at = at + 1
  }
  if color {
    run text.append(RESET)
  }
}

effect fn markdownRow(text: &mut String, cells: &[String]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run text.append("|")
  let mut at: usize = 0
  while at < cells.length {
    run text.append(" ")
    run text.append(cells[at].view())
    run text.append(" |")
    at = at + 1
  }
  run text.append("\n")
}

effect fn describe(lines: &mut List<String>, report: &Report) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let environment = &report.environment
  let mut computer = run String.copy(environment.system.view())
  run computer.append(" ")
  run computer.append(environment.release.view())
  run computer.append(" ")
  run computer.append(environment.machine.view())
  run computer.append(", ")
  run computer.append(environment.processor.view())
  run computer.append(", ")
  run Units.appendWhole(&mut computer, environment.usable)
  run computer.append(" of ")
  run Units.appendWhole(&mut computer, environment.processors)
  run computer.append(" processors, ")
  run computer.appendOwned(run Units.memory(u64.toF64(environment.memory)))
  run computer.append(", load ")
  run Units.appendFixed(&mut computer, environment.load, 2)
  run lines.append(move computer)

  let mut when = run String.copy("started ")
  run when.append(report.started.view())
  run when.append(", ended ")
  run when.append(report.ended.view())
  run when.append(", run ")
  run when.append(report.id.view())
  if let Option<String>.Some { value } = &report.label {
    run when.append(", label ")
    run when.append(value.view())
  }
  if let Option<String>.Some { value } = &report.revision {
    run when.append(", revision ")
    run when.append(value.view())
  }
  run lines.append(move when)

  let variables = environment.variables.asSlice()
  let mut at: usize = 0
  while at < variables.length {
    let mut variable = run String.copy(variables[at].name.view())
    run variable.append("=")
    run variable.append(variables[at].value.view())
    run lines.append(move variable)
    at = at + 1
  }
  let subjects = report.implementations.asSlice()
  at = 0
  while at < subjects.length {
    let mut subject = run String.copy(subjects[at].name.view())
    run subject.append(": ")
    run subject.append(subjects[at].command.view())
    if let Option<String>.Some { value } = &subjects[at].revision {
      run subject.append(" (revision ")
      run subject.append(value.view())
      run subject.append(")")
    }
    run lines.append(move subject)
    at = at + 1
  }
  let notes = report.notes.asSlice()
  at = 0
  while at < notes.length {
    let mut note = run String.copy("note: ")
    run note.append(notes[at].view())
    run lines.append(move note)
    at = at + 1
  }
}

// A value of `chart` as text: a ratio when the chart is normalized, and else a quantity in the
// chart's unit.
effect fn amount(chart: &Chart, value: f64) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  if String.byteLength(chart.normalize.view()) > 0 {
    return run Units.ratio(value)
  }
  return run Units.quantity(value, chart.y.view())
}

const SPREAD_CELLS: usize = 16

const LEVELS: [string<'static>; 9] = [" ", "▁", "▂", "▃", "▄", "▅", "▆", "▇", "█"]

effect fn spreadGrid(chart: &Chart, panel: &Panel) -> List<List<String>>
  ! OutOfMemoryError
  ? &mut Allocator {
  let lists = panel.series.asSlice()
  let mut low = 0.0
  let mut high = 0.0
  let mut any = false
  let mut series: usize = 0
  while series < lists.length {
    let points = lists[series].points.asSlice()
    let mut at: usize = 0
    while at < points.length {
      if !points[at].faded {
        if !any || points[at].value < low {
          low = points[at].value
        }
        if !any || points[at].value > high {
          high = points[at].value
        }
        any = true
      }
      at = at + 1
    }
    series = series + 1
  }
  let mut rows = List<List<String>>.make()
  let mut heading = List<String>.make()
  run heading.append(run String.copy(chart.series.view()))
  run heading.append(run String.copy("runs"))
  run heading.append(run String.copy("smallest"))
  run heading.append(run String.copy("largest"))
  let mut scale = run amount(chart, low)
  run scale.append(" to ")
  run scale.appendOwned(run amount(chart, high))
  run heading.append(move scale)
  run rows.append(move heading)
  series = 0
  while series < lists.length {
    let points = lists[series].points.asSlice()
    let mut counts = List<usize>.make()
    let mut at: usize = 0
    while at < SPREAD_CELLS {
      run counts.append(0)
      at = at + 1
    }
    let bins = counts.asMutSlice()
    let mut runs: u64 = 0
    let mut smallest = 0.0
    let mut largest = 0.0
    let mut most: usize = 0
    at = 0
    while at < points.length {
      if !points[at].faded {
        let mut bin: usize = 0
        if high > low {
          bin = f64.toUsize(
            f64.floor((points[at].value - low) / (high - low) * usize.toF64(SPREAD_CELLS)),
          )
        }
        if bin >= SPREAD_CELLS {
          bin = SPREAD_CELLS - 1
        }
        bins[bin] = bins[bin] + 1
        if bins[bin] > most {
          most = bins[bin]
        }
        if runs == 0 || points[at].value < smallest {
          smallest = points[at].value
        }
        if runs == 0 || points[at].value > largest {
          largest = points[at].value
        }
        runs = runs + 1
      }
      at = at + 1
    }
    let mut drawn = String.make()
    at = 0
    while at < SPREAD_CELLS {
      let mut level: usize = 0
      if bins[at] > 0 {
        level = 1 + (bins[at] * 7) / most
        if level > 8 {
          level = 8
        }
      }
      run drawn.append(LEVELS[level])
      at = at + 1
    }
    let mut row = List<String>.make()
    run row.append(run String.copy(lists[series].name.view()))
    let mut count = String.make()
    run Units.appendWhole(&mut count, runs)
    run row.append(move count)
    run row.append(run amount(chart, smallest))
    run row.append(run amount(chart, largest))
    let mut framed = run String.copy("▕")
    run framed.appendOwned(move drawn)
    run framed.append("▏")
    run row.append(move framed)
    run rows.append(move row)
    series = series + 1
  }
  return move rows
}

effect fn terminalChart(text: &mut String, chart: &Chart, color: bool) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let panels = chart.panels.asSlice()
  if panels.length == 0 {
    return ()
  }
  run paint(&mut text, BOLD, chart.title.view(), color)
  run text.append("\n")
  let mut at: usize = 0
  while at < panels.length {
    if String.byteLength(panels[at].title.view()) > 0 && panels.length > 1 {
      run paint(&mut text, DIM, panels[at].title.view(), color)
      run text.append("\n")
    }
    let grid = run Render.grid(chart, &panels[at])
    let rows = grid.asSlice()
    let mut widths = List<usize>.make()
    let mut row: usize = 0
    while row < rows.length {
      let cells = rows[row].asSlice()
      let mut column: usize = 0
      while column < cells.length {
        if column == widths.length() {
          run widths.append(0)
        }
        let wide = widths.asMutSlice()
        if Units.width(cells[column].view()) > wide[column] {
          wide[column] = Units.width(cells[column].view())
        }
        column = column + 1
      }
      row = row + 1
    }
    let wide = widths.asSlice()
    row = 0
    while row < rows.length {
      let cells = rows[row].asSlice()
      let mut column: usize = 0
      while column < cells.length {
        let value = cells[column].view()
        let padding = wide[column] - Units.width(value)
        if column > 0 {
          run text.append("  ")
          run spaces(&mut text, padding)
        }
        if row == 0 {
          run paint(&mut text, DIM, value, color)
        } else {
          run text.append(value)
        }
        if column == 0 && cells.length > 1 {
          run spaces(&mut text, padding)
        }
        column = column + 1
      }
      run text.append("\n")
      row = row + 1
    }
    run text.append("\n")
    at = at + 1
  }
}

effect fn markdownChart(text: &mut String, chart: &Chart) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let panels = chart.panels.asSlice()
  if panels.length == 0 {
    return ()
  }
  run text.append("## ")
  run text.append(chart.title.view())
  run text.append("\n\n")
  let mut at: usize = 0
  while at < panels.length {
    if String.byteLength(panels[at].title.view()) > 0 && panels.length > 1 {
      run text.append("### ")
      run text.append(panels[at].title.view())
      run text.append("\n\n")
    }
    let grid = run Render.grid(chart, &panels[at])
    let rows = grid.asSlice()
    let mut row: usize = 0
    while row < rows.length {
      run markdownRow(&mut text, rows[row].asSlice())
      if row == 0 {
        run text.append("| :-- |")
        let mut column: usize = 1
        while column < rows[row].length() {
          run text.append(" --: |")
          column = column + 1
        }
        run text.append("\n")
      }
      row = row + 1
    }
    run text.append("\n")
    at = at + 1
  }
}
