static if (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetAbi() == "apple"
  && Intrinsic.profileText("libc") == "system")
  || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu"
    && Intrinsic.profileText("libc") == "gnu") {
  import silk.system.monotonic_clock_native { OsMonotonicClock }
  import silk.system.system_clock_native { OsSystemClock }
}

/// Every way a benchmark task can fail. `silk.cli.task.Task.main` reports each of them.
pub type BenchError = TaskError
  | StepFailure
  | SpawnError
  | Cancelled
  | FileError
  | HostInputError
  | OutOfMemoryError
  | WriterError
  | SchemaError

/// The command-line options every benchmark task shares. A task embeds them with
/// `Command.flatten`.
pub struct BenchOptions {
  /// Run only the suites whose name contains this text. Repeat it to select more.
  pub filter: List<String>,
  /// The number of measured rounds, over what a suite sets.
  pub runs: Option<u64>,
  /// The number of warm-up rounds, over what a suite sets.
  pub warmup: Option<u64>,
  /// When the terminal table has color: `auto`, `always`, or `never`.
  pub color: String,
  /// Also write each suite's page with charts to `build/bench/<suite>.html`.
  pub html: bool,
  /// Also write each suite's Markdown report to `build/bench/<suite>.md`.
  pub markdown: bool,
  /// Also write each suite's samples as result lines to `build/bench/<suite>.txt`.
  pub lines: bool,
  /// Notes recorded with the run. Repeat it to add more.
  pub note: List<String>,
  /// A label for the run, such as `before` or `after`.
  pub label: Option<String>,
  /// The revision of the project the run measures. Without it, the commit that `HEAD` names in
  /// the Git repository the package is in.
  pub revision: Option<String>,
  /// Also add the run to the suite's history, `bench/history/<suite>.jsonl`.
  pub record: bool,
  /// Print each suite's history and run nothing.
  pub history: bool,
  /// Add this text to the journal, `bench/journal.md`, under the revision, and run nothing.
  pub log: Option<String>,
  /// How large a difference must be to count, in percent.
  pub noise: String,
}

impl BenchOptions {
  /// Returns the options of a command line that gives none of them.
  ///
  /// # Errors
  /// `OutOfMemoryError` if the `Allocator` cannot supply the text.
  pub effect fn make() -> Self
    ! OutOfMemoryError
    ? &mut Allocator {
    return BenchOptions {
      filter: List<String>.make(),
      runs: Option<u64>.None,
      warmup: Option<u64>.None,
      color: run String.copy("auto"),
      html: false,
      markdown: false,
      lines: false,
      note: List<String>.make(),
      label: Option<String>.None,
      revision: Option<String>.None,
      record: false,
      history: false,
      log: Option<String>.None,
      noise: run String.copy("1"),
    }
  }
}

impl CommandLine for BenchOptions {
  static fn command() -> Command<Self> {
    return Command<Self>.make("", "Benchmark options")
      |> Command.option(
        "filter",
        Opt.about("Run only the suites whose name contains this text; repeat to select more"),
      )
      |> Command.option("runs", Opt.about("The number of measured rounds"))
      |> Command.option("warmup", Opt.about("The number of warm-up rounds"))
      |> Command.option(
        "color",
        Opt.about("Color in the terminal table")
          |> Opt.choice("auto")
          |> Opt.choice("always")
          |> Opt.choice("never")
          |> Opt.default("auto"),
      )
      |> Command.option(
        "html",
        Opt.about("Also write build/bench/<suite>.html, a page with charts"),
      )
      |> Command.option("markdown", Opt.about("Also write build/bench/<suite>.md"))
      |> Command.option(
        "lines",
        Opt.about("Also write build/bench/<suite>.txt, the samples as result lines for benchstat"),
      )
      |> Command.option("note", Opt.about("A note recorded with the run; repeat to add more"))
      |> Command.option("label", Opt.about("A label for the run, such as before or after"))
      |> Command.option(
        "revision",
        Opt.about("The revision the run measures; without it, the commit of the Git repository"),
      )
      |> Command.option(
        "record",
        Opt.about("Also add the run to the history, bench/history/<suite>.jsonl"),
      )
      |> Command.option("history", Opt.about("Print the history of each suite and run nothing"))
      |> Command.option(
        "log",
        Opt.about("Add this text to bench/journal.md under the revision and run nothing"),
      )
      |> Command.option(
        "noise",
        Opt.about("How large a difference must be to count, in percent") |> Opt.default("1"),
      )
  }
}

/// The owner type of the benchmark entry point. It has no fields and is never constructed.
pub struct Bench {}

impl Bench {
  /// Runs each of `suites` that `options` selects and writes its reports, as the module
  /// describes.
  ///
  /// # Errors
  /// - `TaskError` with status 2 if a suite is not valid, such as one without implementations
  ///   or with a reference it does not have, or if `--noise` is not a number.
  /// - `TaskError` if a setup, prepare, conclude or cleanup call fails, if a program cannot be
  ///   started, or, after every suite has been reported, if a measured run failed.
  /// - `StepFailure` if a build step a path comes from fails.
  /// - `FileError` if a report cannot be written.
  pub effect fn perform(options: &BenchOptions, suites: &[Suite]) -> ()
    ! BenchError
    ? &mut HostInput | &mut Allocator | &mut FileSystem {
    static if (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetAbi() == "apple"
      && Intrinsic.profileText("libc") == "system")
      || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu"
        && Intrinsic.profileText("libc") == "gnu") {
      let mut steady = OsMonotonicClock.make()
      let mut calendar = OsSystemClock.make()
      return run performed(options, suites)
        |> Effect.provideMut<MonotonicClock>(&mut steady)
        |> Effect.provideMut<SystemClock>(&mut calendar)
    } else {
      drop options
      drop suites
      fail TaskError {
        message: run String.copy("this system cannot measure a process yet"),
        status: 127,
      }
    }
  }
}

// Resolves every path of a run in one step of the build graph. It runs every time: the paths
// are cheap to resolve, and the steps they come from keep their own cache.
struct Locate {
  paths: List<Deferred<Path>>,
}

impl Step for Locate {
  effect fn key(self: &Self, key: &mut Key) -> ()
    ! StepFailure
    ? &mut Allocator {
    let paths = self.paths.asSlice()
    let mut at: usize = 0
    while at < paths.length {
      run key.location(&paths[at])
      at = at + 1
    }
    key.always()
  }

  effect fn make(self: &Self, make: &mut Make) -> ()
    ! StepFailure
    ? &mut Allocator {
    let paths = self.paths.asSlice()
    let mut texts = List<String>.make()
    let mut at: usize = 0
    while at < paths.length {
      let path = run make.path(&paths[at])
      match Path.view(&path) {
        Option<string>.Some { value } => run texts.append(run String.copy(value))
        Option<string>.None => run texts.append(String.make())
      }
      at = at + 1
    }
    return run make.value<List<String>>(&texts)
  }
}

// A call with its paths resolved and its placeholders not yet filled in.
struct Shape {
  program: String,
  arguments: List<String>,
  directory: Option<String>,
  variables: List<Pair>,
}

struct Candidate {
  name: String,
  timed: Shape,
  before: List<Shape>,
  after: List<Shape>,
  revision: Option<String>,
  reports: bool,
}

struct Plan {
  // One entry for each output of the suite: its file, or empty text for standard output.
  files: List<String>,
  before: List<Shape>,
  after: List<Shape>,
  candidates: List<Candidate>,
}

// One benchmark of a suite: a value for each parameter.
struct Combination {
  name: String,
  pairs: List<Pair>,
  cpus: u32,
}

struct Settings {
  rounds: u64,
  warmups: u64,
  noise: f64,
}

// xorshift64*, to order the implementations of a round.
struct Shuffle {
  state: u64,
}

impl Shuffle {
  fn below(self: &mut Self, count: usize) -> usize {
    self.state = u64.bitXor(self.state, u64.shiftRight(self.state, 12))
    self.state = u64.bitXor(self.state, u64.shiftLeft(self.state, 25))
    self.state = u64.bitXor(self.state, u64.shiftRight(self.state, 27))
    let mixed = u64.wrappingMultiply(self.state, 0x2545F4914F6CDD1D)
    return u64.toUsize(u64.shiftRight(mixed, 33) % usize.toU64(count))
  }
}

effect fn invalid(first: string, second: string) -> never
  ! TaskError | OutOfMemoryError
  ? &mut Allocator {
  let mut message = run String.copy(first)
  run message.append(second)
  fail TaskError { message: move message, status: 2 }
}

effect fn say(first: string, second: string) -> ()
  ? &mut Allocator {
  let mut err = StderrWriter.make()
  drop run Effect.result(
    Writer.writeAll(String.utf8Bytes(first)) |> Effect.provideMut<Writer>(&mut err),
  )
  drop run Effect.result(
    Writer.writeAll(String.utf8Bytes(second)) |> Effect.provideMut<Writer>(&mut err),
  )
  drop run Effect.result(Writer.writeAll(b"\n") |> Effect.provideMut<Writer>(&mut err))
}

fn selected(options: &BenchOptions, suite: &Suite) -> bool {
  let filters = options.filter.asSlice()
  if filters.length == 0 {
    return true
  }
  let mut at: usize = 0
  while at < filters.length {
    if String.contains(suite.name.view(), filters[at].view()) {
      return true
    }
    at = at + 1
  }
  return false
}

effect fn referenceOf(suite: &Suite) -> String
  ! TaskError | OutOfMemoryError
  ? &mut Allocator {
  let named = suite.implementations.asSlice()
  if named.length == 0 {
    run invalid("a benchmark suite needs an implementation: ", suite.name.view())
  }
  let mut at: usize = 0
  while at < named.length {
    let mut other = at + 1
    while other < named.length {
      if named[at].name.view() == named[other].name.view() {
        run invalid("a benchmark suite has two implementations named ", named[at].name.view())
      }
      other = other + 1
    }
    at = at + 1
  }
  return match &suite.baseline {
    Option<String>.Some { value } => {
      let mut found = false
      at = 0
      while at < named.length {
        if named[at].name.view() == value.view() {
          found = true
        }
        at = at + 1
      }
      if !found {
        run invalid(
          "a benchmark suite has no implementation named like its reference, ",
          value.view(),
        )
      }
      run String.copy(value.view())
    }
    Option<String>.None => run String.copy(named[0].name.view())
  }
}

// `collectCall` and `shapeOf` walk a call's paths in the same order, as `collectSuite` and
// `planOf` walk a suite's: the resolved paths come back as a flat list in that order.
effect fn collectCall(call: &Call, paths: &mut List<Deferred<Path>>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run paths.append(run call.executable.copy())
  if let Option<Deferred<Path>>.Some { value } = &call.workingDirectory {
    run paths.append(run value.copy())
  }
  let parts = call.parts.asSlice()
  let mut at: usize = 0
  while at < parts.length {
    if let Part.Location { path } = &parts[at] {
      run paths.append(run path.copy())
    }
    at = at + 1
  }
}

effect fn collectCalls(calls: &List<Call>, paths: &mut List<Deferred<Path>>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let listed = calls.asSlice()
  let mut at: usize = 0
  while at < listed.length {
    run collectCall(&listed[at], &mut paths)
    at = at + 1
  }
}

effect fn collectSuite(suite: &Suite, paths: &mut List<Deferred<Path>>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let outputs = suite.outputs.asSlice()
  let mut at: usize = 0
  while at < outputs.length {
    if let Destination.File { path, append: _ } = &outputs[at].destination {
      run paths.append(run path.copy())
    }
    at = at + 1
  }
  run collectCalls(&suite.before, &mut paths)
  run collectCalls(&suite.after, &mut paths)
  let named = suite.implementations.asSlice()
  at = 0
  while at < named.length {
    run collectCall(&named[at].implementation.call, &mut paths)
    run collectCalls(&named[at].implementation.before, &mut paths)
    run collectCalls(&named[at].implementation.after, &mut paths)
    at = at + 1
  }
}

effect fn taken(resolved: &[String], at: &mut usize) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let text = run String.copy(resolved[at.*].view())
  at.* = at.* + 1
  return move text
}

effect fn copyPairs(pairs: &[Pair]) -> List<Pair>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut copies = List<Pair>.make()
  let mut at: usize = 0
  while at < pairs.length {
    run copies.append(
      Pair {
        name: run String.copy(pairs[at].name.view()),
        value: run String.copy(pairs[at].value.view()),
      },
    )
    at = at + 1
  }
  return move copies
}

effect fn shapeOf(call: &Call, resolved: &[String], at: &mut usize) -> Shape
  ! OutOfMemoryError
  ? &mut Allocator {
  let program = run taken(resolved, &mut at)
  let mut directory = Option<String>.None
  if let Option<Deferred<Path>>.Some { value: _ } = &call.workingDirectory {
    directory = Option<String>.Some { value: run taken(resolved, &mut at) }
  }
  let mut arguments = List<String>.make()
  let parts = call.parts.asSlice()
  let mut index: usize = 0
  while index < parts.length {
    match &parts[index] {
      Part.Text { value } => run arguments.append(run String.copy(value.view()))
      Part.Location { .. } => run arguments.append(run taken(resolved, &mut at))
    }
    index = index + 1
  }
  return Shape {
    program: move program,
    arguments: move arguments,
    directory: move directory,
    variables: run copyPairs(call.variables.asSlice()),
  }
}

effect fn shapesOf(calls: &List<Call>, resolved: &[String], at: &mut usize) -> List<Shape>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut shapes = List<Shape>.make()
  let listed = calls.asSlice()
  let mut index: usize = 0
  while index < listed.length {
    run shapes.append(run shapeOf(&listed[index], resolved, &mut at))
    index = index + 1
  }
  return move shapes
}

effect fn planOf(suite: &Suite, resolved: &[String], at: &mut usize) -> Plan
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut files = List<String>.make()
  let outputs = suite.outputs.asSlice()
  let mut index: usize = 0
  while index < outputs.length {
    match &outputs[index].destination {
      Destination.File { .. } => run files.append(run taken(resolved, &mut at))
      Destination.Stdout => run files.append(String.make())
    }
    index = index + 1
  }
  let before = run shapesOf(&suite.before, resolved, &mut at)
  let after = run shapesOf(&suite.after, resolved, &mut at)
  let mut candidates = List<Candidate>.make()
  let named = suite.implementations.asSlice()
  index = 0
  while index < named.length {
    let timed = run shapeOf(&named[index].implementation.call, resolved, &mut at)
    let prepare = run shapesOf(&named[index].implementation.before, resolved, &mut at)
    let conclude = run shapesOf(&named[index].implementation.after, resolved, &mut at)
    let revision = match &named[index].implementation.version {
      Option<String>.Some { value } => Option<String>.Some { value: run String.copy(value.view()) }
      Option<String>.None => Option<String>.None
    }
    run candidates.append(
      Candidate {
        name: run String.copy(named[index].name.view()),
        timed: move timed,
        before: move prepare,
        after: move conclude,
        revision: move revision,
        reports: named[index].implementation.reports,
      },
    )
    index = index + 1
  }
  return Plan {
    files: move files,
    before: move before,
    after: move after,
    candidates: move candidates,
  }
}

// `text` with each `{name}` replaced by the value of the pair `name`. Braces around a name no
// pair has stay as they are.
effect fn filled(text: string, pairs: &[Pair]) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let bytes = String.utf8Bytes(text)
  let mut result = String.make()
  let mut start: usize = 0
  let mut at: usize = 0
  while at < bytes.length {
    if bytes[at] == 123 {
      let mut close = at + 1
      while close < bytes.length && bytes[close] != 125 {
        close = close + 1
      }
      if close < bytes.length {
        let name = String.slice(text, at + 1, close - at - 1)
        let mut pair: usize = 0
        while pair < pairs.length {
          if pairs[pair].name.view() == name {
            run result.append(String.slice(text, start, at - start))
            run result.append(pairs[pair].value.view())
            start = close + 1
            at = close
            break
          }
          pair = pair + 1
        }
      }
    }
    at = at + 1
  }
  run result.append(String.slice(text, start, bytes.length - start))
  return move result
}

effect fn launchOf(shape: &Shape, pairs: &[Pair]) -> Launch
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let program = run filled(shape.program.view(), pairs)
  let mut arguments = List<String>.make()
  let listed = shape.arguments.asSlice()
  let mut at: usize = 0
  while at < listed.length {
    run arguments.append(run filled(listed[at].view(), pairs))
    at = at + 1
  }
  let directory = match &shape.directory {
    Option<String>.Some { value } => {
      let place = run filled(value.view(), pairs)
      Option<Path>.Some { value: run Path.make(place.view()) }
    }
    Option<String>.None => Option<Path>.None
  }
  return Launch {
    program: run Path.make(program.view()),
    arguments: move arguments,
    directory: move directory,
    variables: run copyPairs(shape.variables.asSlice()),
    output: Option<Path>.None,
  }
}

// What the result lines of a run said about the run itself.
struct Told {
  // One entry for each implementation: the revision its lines gave, or empty text.
  revisions: List<String>,
  notes: List<String>,
}

// The text of the file at `file`, or empty text when there is no such file. Bytes that are not
// UTF-8 give empty text: such a file holds no result line.
effect fn textAt(file: string) -> String
  ! FileError | OutOfMemoryError
  ? &mut Allocator | &mut FileSystem {
  let path = run Path.make(file)
  if !(run FileSystem.exists(&path)) {
    return String.make()
  }
  let bytes = run FileSystem.readFile(&path)
  return match move String.fromBytes(move bytes) {
    Result<String, InvalidUtf8>.Success { value } => move value
    Result<String, InvalidUtf8>.Failure { .. } => String.make()
  }
}

// Adds the result lines of `text`, which one run of the implementation `chosen` printed, to
// `readings`, and what its configuration lines say to `told`.
effect fn read(
  text: string,
  name: string,
  chosen: usize,
  round: u64,
  warmup: bool,
  readings: &mut List<Reading>,
  told: &mut Told,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let parsed = run Lines.parse(text)
  let lines = parsed.lines.asSlice()
  let mut at: usize = 0
  while at < lines.length {
    let mut values = List<Metric>.make()
    let listed = lines[at].values.asSlice()
    let mut value: usize = 0
    while value < listed.length {
      run values.append(
        Metric { unit: run String.copy(listed[value].unit.view()), value: listed[value].value },
      )
      value = value + 1
    }
    let check = match Lines.setting(&parsed, at, "check") {
      Option<string>.Some { value: said } => Option<String>.Some { value: run String.copy(said) }
      Option<string>.None => Option<String>.None
    }

    // `Benchmark` is 9 bytes.
    let whole = lines[at].name.view()
    run readings.append(
      Reading {
        name: run String.copy(String.slice(whole, 9, String.byteLength(whole) - 9)),
        implementation: run String.copy(name),
        round: round,
        warmup: warmup,
        iterations: lines[at].iterations,
        values: move values,
        check: move check,
      },
    )
    at = at + 1
  }
  let settings = parsed.settings.asSlice()
  at = 0
  while at < settings.length {
    if settings[at].name.view() == "revision" {
      let revisions = told.revisions.asMutSlice()
      revisions[chosen] = run String.copy(settings[at].value.view())
    } else if settings[at].name.view() == "note" {
      let known = told.notes.asSlice()
      let mut found = false
      let mut index: usize = 0
      while index < known.length {
        if known[index].view() == settings[at].value.view() {
          found = true
        }
        index = index + 1
      }
      if !found {
        run told.notes.append(run String.copy(settings[at].value.view()))
      }
    }
    at = at + 1
  }
}

effect fn performAll(shapes: &List<Shape>, pairs: &[Pair]) -> ()
  ! TaskError | FileError | OutOfMemoryError
  ? &mut Allocator {
  let listed = shapes.asSlice()
  let mut at: usize = 0
  while at < listed.length {
    let launch = run launchOf(&listed[at], pairs)
    run Process.perform(&launch)
    at = at + 1
  }
}

effect fn combinations(suite: &Suite) -> List<Combination>
  ! OutOfMemoryError
  ? &mut Allocator {
  let parameters = suite.parameters.asSlice()
  let processors = suite.processors.asSlice()
  let mut total: usize = 1
  let mut at: usize = 0
  while at < parameters.length {
    total = total * parameters[at].values.length()
    at = at + 1
  }
  if processors.length > 0 {
    total = total * processors.length
  }
  let mut all = List<Combination>.make()
  let mut index: usize = 0
  while index < total {
    // The last dimension changes fastest, as nested loops would do it.
    let mut rest = index
    let mut cpus: u32 = 0
    if processors.length > 0 {
      cpus = processors[rest % processors.length]
      rest = rest / processors.length
    }
    let mut choices = List<usize>.make()
    at = parameters.length
    while at > 0 {
      at = at - 1
      let count = parameters[at].values.length()
      run choices.append(rest % count)
      rest = rest / count
    }
    let mut name = run String.copy(suite.name.view())
    let mut pairs = List<Pair>.make()
    at = 0
    while at < parameters.length {
      let choice = choices.asSlice()[parameters.length - 1 - at]
      let value = parameters[at].values.asSlice()[choice].view()
      run name.append("/")
      run name.append(parameters[at].name.view())
      run name.append("=")
      run name.append(value)
      run pairs.append(
        Pair { name: run String.copy(parameters[at].name.view()), value: run String.copy(value) },
      )
      at = at + 1
    }
    if cpus > 0 {
      let mut count = String.make()
      run Units.appendWhole(&mut count, u32.toU64(cpus))
      run name.append("/cpus=")
      run name.append(count.view())
      run pairs.append(Pair { name: run String.copy("cpus"), value: move count })
    }
    run all.append(Combination { name: move name, pairs: move pairs, cpus: cpus })
    index = index + 1
  }
  return move all
}

effect fn two(text: &mut String, value: u64) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if value < 10 {
    run text.append("0")
  }
  run Units.appendWhole(&mut text, value)
}

// `seconds` since 1970 as UTC text: `2026-11-19T14:03:22Z`, or `20261119T140322Z` when
// `compact`, for a file name.
effect fn dated(seconds: i64, compact: bool) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut whole: u64 = 0
  if seconds > 0 {
    whole = i64.toU64(seconds)
  }
  let days = whole / 86400
  let clock = whole % 86400

  // Days to a civil date, after Howard Hinnant's `civil_from_days`.
  let shifted = days + 719468
  let era = shifted / 146097
  let dayOfEra = shifted - era * 146097
  let yearOfEra = (dayOfEra - dayOfEra / 1460 + dayOfEra / 36524 - dayOfEra / 146096) / 365
  let dayOfYear = dayOfEra - (365 * yearOfEra + yearOfEra / 4 - yearOfEra / 100)
  let shiftedMonth = (5 * dayOfYear + 2) / 153
  let day = dayOfYear - (153 * shiftedMonth + 2) / 5 + 1
  let mut month = shiftedMonth + 3
  let mut year = yearOfEra + era * 400
  if shiftedMonth >= 10 {
    month = shiftedMonth - 9
    year = year + 1
  }
  let mut text = String.make()
  run Units.appendWhole(&mut text, year)
  if !compact {
    run text.append("-")
  }
  run two(&mut text, month)
  if !compact {
    run text.append("-")
  }
  run two(&mut text, day)
  run text.append("T")
  run two(&mut text, clock / 3600)
  if !compact {
    run text.append(":")
  }
  run two(&mut text, clock % 3600 / 60)
  if !compact {
    run text.append(":")
  }
  run two(&mut text, clock % 60)
  run text.append("Z")
  return move text
}

effect fn sampleOf(name: string, round: u64, position: usize, warmup: bool, timed: &Timed) -> Sample
  ! OutOfMemoryError
  ? &mut Allocator {
  return Sample {
    implementation: run String.copy(name),
    round: round,
    position: usize.toU64(position),
    warmup: warmup,
    wall: timed.wall,
    user: timed.user,
    system: timed.system,
    peak: timed.peak,
    exit: timed.exit,
    signal: timed.signal,
  }
}

effect fn timeBenchmark(
  plan: &Plan,
  combination: &Combination,
  settings: &Settings,
  shuffle: &mut Shuffle,
  scratch: string,
  told: &mut Told,
) -> Measured
  ! TaskError | FileError | OutOfMemoryError
  ? &mut Allocator | &mut FileSystem | &mut MonotonicClock {
  let candidates = plan.candidates.asSlice()
  let pairs = combination.pairs.asSlice()

  // A program that reports result lines writes them to standard output, kept in the first
  // file, or to the second, which `BENCH_OUT` names.
  let mut printed = run String.copy(scratch)
  run printed.append("/lines-stdout.txt")
  let mut named = run String.copy(scratch)
  run named.append("/lines-out.txt")
  let mut launches = List<Launch>.make()
  let mut order = List<usize>.make()
  let mut at: usize = 0
  while at < candidates.length {
    let mut launch = run launchOf(&candidates[at].timed, pairs)
    if candidates[at].reports {
      launch.output = Option<Path>.Some { value: run Path.make(printed.view()) }
      run launch.variables.append(
        Pair { name: run String.copy("BENCH_OUT"), value: run String.copy(named.view()) },
      )
    }
    run launches.append(move launch)
    run order.append(at)
    at = at + 1
  }
  let mut readings = List<Reading>.make()
  let mut samples = List<Sample>.make()
  let mut round: u64 = 0
  while round < settings.warmups + settings.rounds {
    // Fisher-Yates: every order of the implementations is as likely as any other.
    let slots = order.asMutSlice()
    at = slots.length
    while at > 1 {
      at = at - 1
      let other = shuffle.below(at + 1)
      let held = slots[at]
      slots[at] = slots[other]
      slots[other] = held
    }
    let warmup = round < settings.warmups
    let mut number = round
    if !warmup {
      number = round - settings.warmups
    }
    let mut position: usize = 0
    while position < candidates.length {
      let chosen = order.asSlice()[position]
      run performAll(&candidates[chosen].before, pairs)
      if candidates[chosen].reports {
        // What the last run left must not be read as this run's.
        run FileSystem.writeFileWithParents(&run Path.make(named.view()), b"")
      }
      let timed = run Process.time(&launches.asSlice()[chosen], combination.cpus)
      run performAll(&candidates[chosen].after, pairs)
      if candidates[chosen].reports {
        let name = candidates[chosen].name.view()
        let first = run textAt(printed.view())
        run read(first.view(), name, chosen, number, warmup, &mut readings, &mut told)
        let second = run textAt(named.view())
        run read(second.view(), name, chosen, number, warmup, &mut readings, &mut told)
      }
      run samples.append(
        run sampleOf(candidates[chosen].name.view(), number, position, warmup, &timed),
      )
      position = position + 1
    }
    round = round + 1
  }
  return Measured {
    name: run String.copy(combination.name.view()),
    parameters: run copyPairs(pairs),
    samples: move samples,
    readings: move readings,
  }
}

effect fn timeSuite(
  suite: &Suite,
  plan: &Plan,
  settings: &Settings,
  shuffle: &mut Shuffle,
  scratch: string,
  told: &mut Told,
) -> List<Measured>
  ! TaskError | FileError | OutOfMemoryError
  ? &mut Allocator | &mut FileSystem | &mut MonotonicClock {
  let all = run combinations(suite)
  let listed = all.asSlice()
  let mut benchmarks = List<Measured>.make()
  let mut at: usize = 0
  while at < listed.length {
    run say("Timing ", listed[at].name.view())
    run benchmarks.append(
      run timeBenchmark(plan, &listed[at], settings, &mut shuffle, scratch, &mut told),
    )
    at = at + 1
  }
  return move benchmarks
}

effect fn measured(
  options: &BenchOptions,
  suite: &Suite,
  plan: &Plan,
  settings: &Settings,
  directory: string,
  revision: &Option<String>,
) -> RunResult
  ! TaskError | FileError | HostInputError | OutOfMemoryError
  ? &mut Allocator | &mut HostInput | &mut FileSystem | &mut MonotonicClock | &mut SystemClock {
  let reference = run referenceOf(suite)
  let mut environment = run Process.computer()
  let recorded = suite.recorded.asSlice()
  let mut at: usize = 0
  while at < recorded.length {
    let value = match move run HostInput.variableNamed(recorded[at].view()) {
      Option<Bytes>.Some { value } => match move String.fromBytes(move value) {
        Result<String, InvalidUtf8>.Success { value: text } => move text
        Result<String, InvalidUtf8>.Failure { .. } => run String.copy("(not UTF-8)")
      }
      Option<Bytes>.None => run String.copy("(not set)")
    }
    run environment.variables.append(
      Pair { name: run String.copy(recorded[at].view()), value: move value },
    )
    at = at + 1
  }
  let started = run SystemClock.now()
  let mut shuffle = Shuffle {
    state: u64.bitOr(
      u64.bitXor(
        i64.wrappingToU64(SystemClock.seconds(&started)),
        u64.shiftLeft(i64.wrappingToU64(SystemClock.nanoseconds(&started)), 20),
      ),
      1,
    ),
  }
  let none = List<Pair>.make()
  let mut told = Told { revisions: List<String>.make(), notes: List<String>.make() }
  at = 0
  while at < plan.candidates.length() {
    run told.revisions.append(String.make())
    at = at + 1
  }
  let mut scratch = run String.copy(directory)
  run scratch.append("/tmp")
  run performAll(&plan.before, none.asSlice())
  let timed = run Effect.result(
    timeSuite(suite, plan, settings, &mut shuffle, scratch.view(), &mut told),
  )
  let cleaned = run Effect.result(performAll(&plan.after, none.asSlice()))
  let benchmarks = match move timed {
    Result<List<Measured>, TaskError | FileError | OutOfMemoryError>.Success { value } => move value
    Result<List<Measured>, TaskError | FileError | OutOfMemoryError>.Failure { error } => {
      fail move error
    }
  }
  if let Result<(), TaskError | FileError | OutOfMemoryError>.Failure { error } = move cleaned {
    fail move error
  }
  let ended = run SystemClock.now()
  let floor = run Process.floor()

  let mut id = run dated(SystemClock.seconds(&started), true)
  run id.append("-")
  run Units.appendWhole(&mut id, i64.toU64(SystemClock.nanoseconds(&started)) / 1000 % 100000)
  let mut subjects = List<Subject>.make()
  let candidates = plan.candidates.asSlice()
  at = 0
  while at < candidates.length {
    let launch = run launchOf(&candidates[at].timed, none.asSlice())
    let said = told.revisions.asSlice()[at].view()
    let revision = match &candidates[at].revision {
      Option<String>.Some { value } => Option<String>.Some { value: run String.copy(value.view()) }
      Option<String>.None => {
        if String.byteLength(said) > 0 {
          Option<String>.Some { value: run String.copy(said) }
        } else {
          Option<String>.None
        }
      }
    }
    run subjects.append(
      Subject {
        name: run String.copy(candidates[at].name.view()),
        command: run Process.text(&launch),
        revision: move revision,
      },
    )
    at = at + 1
  }
  let mut notes = List<String>.make()
  let own = suite.notes.asSlice()
  at = 0
  while at < own.length {
    run notes.append(run String.copy(own[at].view()))
    at = at + 1
  }
  let given = options.note.asSlice()
  at = 0
  while at < given.length {
    run notes.append(run String.copy(given[at].view()))
    at = at + 1
  }
  let printed = told.notes.asSlice()
  at = 0
  while at < printed.length {
    run notes.append(run String.copy(printed[at].view()))
    at = at + 1
  }
  let label = match &options.label {
    Option<String>.Some { value } => Option<String>.Some { value: run String.copy(value.view()) }
    Option<String>.None => Option<String>.None
  }
  return RunResult {
    protocol: PROTOCOL,
    suite: run String.copy(suite.name.view()),
    id: move id,
    label: move label,
    revision: match &revision.* {
      Option<String>.Some { value } => Option<String>.Some { value: run String.copy(value.view()) }
      Option<String>.None => Option<String>.None
    },
    started: run dated(SystemClock.seconds(&started), false),
    ended: run dated(SystemClock.seconds(&ended), false),
    notes: move notes,
    environment: move environment,
    implementations: move subjects,
    reference: move reference,
    runs: settings.rounds,
    warmups: settings.warmups,
    floor: floor,
    benchmarks: move benchmarks,
  }
}

effect fn colored(options: &BenchOptions) -> bool
  ! HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  if options.color.view() == "always" {
    return true
  }
  if options.color.view() == "never" || !Process.terminal(1) {
    return false
  }

  // https://no-color.org: any value that is not empty turns color off.
  return match move run HostInput.variableNamed("NO_COLOR") {
    Option<Bytes>.Some { value } => value.length() == 0
    Option<Bytes>.None => true
  }
}

effect fn rendered(format: Format, result: &RunResult, report: &Report, color: bool) -> Bytes
  ! SchemaError | WriterError | OutOfMemoryError
  ? &mut Allocator {
  let text = match format {
    Format.Terminal => run Render.terminal(report, color)
    Format.Markdown => run Render.markdown(report)
    Format.Html => run Html.page(report)
    Format.Lines => run Lines.fromResult(result)
    Format.History => run History.lines(report)
    Format.Report => {
      let mut encoded = run Encoding.json<Report>(report)
      run encoded.append(b"\n")
      return move encoded
    }
    Format.Result => {
      let mut encoded = run Encoding.json<RunResult>(result)
      run encoded.append(b"\n")
      return move encoded
    }
  }
  return run Bytes.copy(String.utf8Bytes(text.view()))
}

effect fn written(file: string, bytes: &[u8], append: bool) -> ()
  ! FileError | OutOfMemoryError
  ? &mut Allocator | &mut FileSystem {
  let path = run Path.make(file)
  if append && run FileSystem.exists(&path) {
    let mut whole = run FileSystem.readFile(&path)
    run whole.append(bytes)
    run FileSystem.writeFile(&path, whole.asSlice())
  } else {
    run FileSystem.writeFileWithParents(&path, bytes)
  }
  run say("Wrote ", file)
}

effect fn delivered(
  options: &BenchOptions,
  suite: &Suite,
  plan: &Plan,
  directory: string,
  result: &RunResult,
  report: &Report,
) -> ()
  ! FileError | HostInputError | SchemaError | WriterError | OutOfMemoryError
  ? &mut Allocator | &mut FileSystem | &mut HostInput {
  let mut out = StdoutWriter.make()
  let mut base = run String.copy(directory)
  run base.append("/")
  run base.append(suite.name.view())

  let mut raw = run String.copy(base.view())
  run raw.append("-")
  run raw.append(result.id.view())
  run raw.append(".json")
  let samples = run rendered(Format.Result, result, report, false)
  run written(raw.view(), samples.asSlice(), false)

  let outputs = suite.outputs.asSlice()
  if outputs.length == 0 {
    let table = run rendered(Format.Terminal, result, report, run colored(options))
    run Writer.writeAll(table.asSlice()) |> Effect.provideMut<Writer>(&mut out)
  }
  let mut at: usize = 0
  while at < outputs.length {
    match &outputs[at].destination {
      Destination.Stdout => {
        let bytes = run rendered(outputs[at].format, result, report, run colored(options))
        run Writer.writeAll(bytes.asSlice()) |> Effect.provideMut<Writer>(&mut out)
      }
      Destination.File { path: _, append } => {
        let color = options.color.view() == "always"
        let bytes = run rendered(outputs[at].format, result, report, color)
        run written(plan.files.asSlice()[at].view(), bytes.asSlice(), append)
      }
    }
    at = at + 1
  }
  if options.html {
    let mut file = run String.copy(base.view())
    run file.append(".html")
    let page = run rendered(Format.Html, result, report, false)
    run written(file.view(), page.asSlice(), false)
  }
  if options.markdown {
    let mut file = run String.copy(base.view())
    run file.append(".md")
    let page = run rendered(Format.Markdown, result, report, false)
    run written(file.view(), page.asSlice(), false)
  }
  if options.lines {
    let mut file = run String.copy(base.view())
    run file.append(".txt")
    let page = run rendered(Format.Lines, result, report, false)
    run written(file.view(), page.asSlice(), false)
  }
}

fn mismatchesOf(report: &Report) -> u64 {
  let mut mismatches: u64 = 0
  let tables = report.benchmarks.asSlice()
  let mut at: usize = 0
  while at < tables.length {
    if tables[at].mismatch {
      mismatches = mismatches + 1
    }
    at = at + 1
  }
  return mismatches
}

fn failuresOf(report: &Report) -> u64 {
  let mut failures: u64 = 0
  let tables = report.benchmarks.asSlice()
  let mut at: usize = 0
  while at < tables.length {
    let rows = tables[at].rows.asSlice()
    let mut row: usize = 0
    while row < rows.length {
      failures = failures + rows[row].failures
      row = row + 1
    }
    at = at + 1
  }
  return failures
}

effect fn located(paths: List<Deferred<Path>>) -> List<String>
  ! BuildError | FileError | SchemaError | OutOfMemoryError
  ? &mut Allocator | &mut FileSystem | &mut HostInput {
  let step = run Step.register(Locate { paths: move paths })
  let build = run Build.make()
  let whole = run build.addStep(move step, ".value.json")
  let built = run whole.compile()
  let artifacts = built.artifacts.asSlice()
  let bytes = run FileSystem.readFile(&artifacts[0].path)
  return run Encoding.read<List<String>>(bytes.asSlice())
}

// The commit that `HEAD` names in the Git repository that holds the directory `from`, as 12
// characters, or `None` when there is no repository or it cannot be read.
effect fn commitAt(from: string) -> Option<String>
  ! OutOfMemoryError
  ? &mut Allocator | &mut FileSystem {
  let mut length = String.byteLength(from)
  let bytes = String.utf8Bytes(from)
  while length > 0 {
    let place = String.slice(from, 0, length)
    let found = run Effect.result(headOf(place))
    if let Result<Option<String>, GitRefError | FileError | OutOfMemoryError>.Success {
      value
    } = move found {
      if let Option<String>.Some { value: commit } = move value {
        return Option<String>.Some { value: move commit }
      }
    }

    // The directory above, up to the root.
    length = length - 1
    while length > 0 && bytes[length] != 47 {
      length = length - 1
    }
  }
  return Option<String>.None
}

effect fn headOf(place: string) -> Option<String>
  ! GitRefError | FileError | OutOfMemoryError
  ? &mut Allocator | &mut FileSystem {
  let worktree = run Path.make(place)
  if !(run FileSystem.exists(&run Path.join(&worktree, ".git"))) {
    return Option<String>.None
  }
  let refs = run LocalRefs.read(&run LocalRefs.gitDirectory(&worktree))
  if let Option<&Ref>.Some { value: head } = refs.head() {
    if let Option<ObjectId>.Some { value: id } = head.commit() {
      let hex = run id.hex()
      return Option<String>.Some { value: run String.copy(String.slice(hex.view(), 0, 12)) }
    }
  }
  return Option<String>.None
}

// The text of the file at `file` as UTF-8, or empty text when the file is missing.
effect fn readText(file: string) -> String
  ! FileError | TaskError | OutOfMemoryError
  ? &mut Allocator | &mut FileSystem {
  let path = run Path.make(file)
  if !(run FileSystem.exists(&path)) {
    return String.make()
  }
  let bytes = run FileSystem.readFile(&path)
  return match move String.fromBytes(move bytes) {
    Result<String, InvalidUtf8>.Success { value } => move value
    Result<String, InvalidUtf8>.Failure { .. } => run invalid("a file is not UTF-8 text: ", file)
  }
}

// Adds `entry` to the journal under the revision, or under today's date without one.
effect fn logged(place: string, revision: &Option<String>, entry: string) -> ()
  ! FileError | TaskError | OutOfMemoryError
  ? &mut Allocator | &mut FileSystem | &mut SystemClock {
  let mut file = run String.copy(place)
  run file.append("/journal.md")
  let before = run readText(file.view())
  let now = run SystemClock.now()
  let today = run dated(SystemClock.seconds(&now), false)
  let key = match &revision.* {
    Option<String>.Some { value } => value.view()
    Option<String>.None => String.slice(today.view(), 0, 10)
  }
  let mut start = run String.copy(before.view())
  if String.byteLength(before.view()) == 0 {
    start = run String.copy("# Benchmark journal\n")
  }
  let after = run Journal.added(start.view(), key, entry)
  run FileSystem.writeFileWithParents(&run Path.make(file.view()), String.utf8Bytes(after.view()))
  run say("Wrote ", file.view())
}

// Prints the recorded history of `suite`, and writes it as Markdown with `--markdown`.
effect fn recalled(options: &BenchOptions, suite: &Suite, place: string, directory: string) -> ()
  ! FileError | HostInputError | SchemaError | TaskError | WriterError | OutOfMemoryError
  ? &mut Allocator | &mut FileSystem | &mut HostInput {
  let mut file = run String.copy(place)
  run file.append("/history/")
  run file.append(suite.name.view())
  run file.append(".jsonl")
  let text = run readText(file.view())
  if String.byteLength(text.view()) == 0 {
    return run say("No history is recorded for ", suite.name.view())
  }
  let entries = run History.parse(text.view())
  let mut journal = run String.copy(place)
  run journal.append("/journal.md")
  let journalText = run readText(journal.view())
  let notes = run Journal.parse(journalText.view())
  let table = run History.terminal(entries.asSlice(), notes.asSlice(), run colored(options))
  let mut out = StdoutWriter.make()
  run Writer.writeAll(String.utf8Bytes(table.view())) |> Effect.provideMut<Writer>(&mut out)
  if options.markdown {
    let mut page = run String.copy(directory)
    run page.append("/")
    run page.append(suite.name.view())
    run page.append("-history.md")
    let mut whole = run String.copy("# ")
    run whole.append(suite.name.view())
    run whole.append(" history\n\n")
    run whole.appendOwned(run History.markdown(entries.asSlice(), notes.asSlice()))
    run written(page.view(), String.utf8Bytes(whole.view()), false)
  }
  if options.html {
    let mut page = run String.copy(directory)
    run page.append("/")
    run page.append(suite.name.view())
    run page.append("-history.html")
    let whole = run History.page(suite.name.view(), entries.asSlice(), notes.asSlice())
    run written(page.view(), String.utf8Bytes(whole.view()), false)
  }
}

effect fn performed(options: &BenchOptions, suites: &[Suite]) -> ()
  ! BenchError
  ? &mut HostInput | &mut Allocator | &mut FileSystem | &mut MonotonicClock | &mut SystemClock {
  let percent = match Text.f64Value(options.noise.view()) {
    Result<f64, ParseError>.Success { value } => value
    Result<f64, ParseError>.Failure { .. } => run invalid(
      "--noise takes a number of percent, not ",
      options.noise.view(),
    )
  }
  if !(percent >= 0.0 && percent < 100.0) {
    run invalid("--noise takes a number of percent from 0 to 100, not ", options.noise.view())
  }

  let mut paths = List<Deferred<Path>>.make()
  run paths.append(run Deferred<Path>.source("build/bench"))
  run paths.append(run Deferred<Path>.source("bench"))
  let mut chosen: usize = 0
  let mut at: usize = 0
  while at < suites.length {
    if selected(options, &suites[at]) {
      // Checked before anything is built, so a mistake costs no time.
      drop run referenceOf(&suites[at])
      run collectSuite(&suites[at], &mut paths)
      chosen = chosen + 1
    }
    at = at + 1
  }
  if chosen == 0 {
    return run say("No benchmark suite matches", "")
  }
  let resolved = run located(move paths)
  let places = resolved.asSlice()
  let directory = places[0].view()
  let bench = places[1].view()
  let revision = match &options.revision {
    Option<String>.Some { value } => Option<String>.Some { value: run String.copy(value.view()) }
    Option<String>.None => run commitAt(bench)
  }
  if let Option<String>.Some { value } = &options.log {
    return run logged(bench, &revision, value.view())
  }
  let mut next: usize = 2
  let mut failures: u64 = 0
  let mut mismatches: u64 = 0
  at = 0
  while at < suites.length {
    if selected(options, &suites[at]) {
      let suite = &suites[at]
      let plan = run planOf(suite, places, &mut next)
      if options.history {
        run recalled(options, suite, bench, directory)
        at = at + 1
        continue
      }
      let mut settings = Settings { rounds: 10, warmups: 1, noise: percent / 100.0 }
      if let Option<u64>.Some { value } = suite.rounds {
        settings.rounds = value
      }
      if let Option<u64>.Some { value } = suite.warmups {
        settings.warmups = value
      }
      if let Option<u64>.Some { value } = options.runs {
        settings.rounds = value
      }
      if let Option<u64>.Some { value } = options.warmup {
        settings.warmups = value
      }
      if settings.rounds == 0 {
        run invalid("a benchmark needs at least one measured round: ", suite.name.view())
      }
      let result = run measured(options, suite, &plan, &settings, directory, &revision)
      let report = run Reports.make(&result, settings.noise)
      run delivered(options, suite, &plan, directory, &result, &report)
      if options.record {
        let mut file = run String.copy(bench)
        run file.append("/history/")
        run file.append(suite.name.view())
        run file.append(".jsonl")
        let lines = run History.lines(&report)
        run written(file.view(), String.utf8Bytes(lines.view()), true)
      }
      failures = failures + failuresOf(&report)
      mismatches = mismatches + mismatchesOf(&report)
    }
    at = at + 1
  }
  if mismatches > 0 {
    let mut message = String.make()
    run Units.appendWhole(&mut message, mismatches)
    run message.append(
      " benchmarks have implementations whose checks differ, so they did not do the same work",
    )
    fail TaskError { message: move message, status: 1 }
  }
  if failures > 0 {
    let mut message = String.make()
    run Units.appendWhole(&mut message, failures)
    run message.append(" measured runs failed; their exit statuses are in the result files")
    fail TaskError { message: move message, status: 1 }
  }
}
