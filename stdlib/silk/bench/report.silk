//! Turns the raw samples of a benchmark run into the report a renderer draws.
//!
//! # When to use
//! Call [`Reports.make`] on a `silk.bench.record.RunResult` you read from a result file, to
//! render a saved run again or with another noise threshold. `silk.bench.bench` calls it for
//! every suite it runs.
//!
//! # Details
//! Each implementation gets one row for each benchmark. The row's statistics cover the measured
//! runs that exited with status 0: warm-up runs and failed runs are left out, and failed runs
//! are counted in the row. Every row except the reference's gets its ratio to the reference
//! with a 95% interval and a verdict, from `silk.bench.statistics`. A suite with more than one
//! benchmark also gets the geometric mean of each implementation's ratios.
//!
//! @category Benchmarks

import silk.bench.record {
  Comparison,
  Environment,
  Measured,
  Overall,
  PROTOCOL,
  Pair,
  Report,
  Row,
  RunResult,
  Sample,
  Subject,
  Table
}
import silk.bench.statistics { Ratio, Statistics, Summary, Verdict }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u64
import silk.num.usize
import silk.text.string { String }

/// The owner type of the report functions. It has no fields and is never constructed.
pub struct Reports {}

impl Reports {
  /// Returns the report of `result`, with verdicts at the noise threshold `noise`, a fraction
  /// such as 0.01 for 1%.
  ///
  /// # Errors
  /// `OutOfMemoryError` if the `Allocator` cannot supply the report.
  pub effect fn make(result: &RunResult, noise: f64) -> Report
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut tables = List<Table>.make()
    let measured = result.benchmarks.asSlice()
    let subjects = result.implementations.asSlice()
    let mut at: usize = 0
    while at < measured.length {
      run tables.append(run table(&measured[at], subjects, result.reference.view(), noise))
      at = at + 1
    }
    let mut overall = List<Overall>.make()
    if measured.length > 1 {
      let mut subject: usize = 0
      while subject < subjects.length {
        let name = subjects[subject].name.view()
        if name != result.reference.view() {
          let mut ratios = List<f64>.make()
          let listed = tables.asSlice()
          let mut index: usize = 0
          while index < listed.length {
            let rows = listed[index].rows.asSlice()
            let mut row: usize = 0
            while row < rows.length {
              if rows[row].implementation.view() == name {
                if let Option<Comparison>.Some { value } = &rows[row].ratio {
                  run ratios.append(value.value)
                }
              }
              row = row + 1
            }
            index = index + 1
          }
          if ratios.length() > 0 {
            run overall.append(
              Overall {
                implementation: run String.copy(name),
                ratio: Statistics.geometricMean(ratios.asSlice()),
                benchmarks: usize.toU64(ratios.length()),
              },
            )
          }
        }
        subject = subject + 1
      }
    }
    return Report {
      protocol: PROTOCOL,
      suite: run String.copy(result.suite.view()),
      id: run String.copy(result.id.view()),
      label: run copyOptional(&result.label),
      started: run String.copy(result.started.view()),
      ended: run String.copy(result.ended.view()),
      notes: run copyTexts(&result.notes),
      environment: run copyEnvironment(&result.environment),
      implementations: run copySubjects(subjects),
      reference: run String.copy(result.reference.view()),
      noise: noise,
      runs: result.runs,
      floor: result.floor,
      benchmarks: move tables,
      overall: move overall,
    }
  }
}

// The wall times of the successful measured runs of `name`, in nanoseconds.
effect fn timesOf(samples: &[Sample], name: string) -> List<f64>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut times = List<f64>.make()
  let mut at: usize = 0
  while at < samples.length {
    if counted(&samples[at], name) {
      run times.append(u64.toF64(samples[at].wall))
    }
    at = at + 1
  }
  return move times
}

fn measuredFor(sample: &Sample, name: string) -> bool {
  return !sample.warmup && sample.implementation.view() == name
}

fn counted(sample: &Sample, name: string) -> bool {
  return measuredFor(sample, name) && sample.exit == 0 && sample.signal == 0
}

effect fn table(measured: &Measured, subjects: &[Subject], reference: string, noise: f64) -> Table
  ! OutOfMemoryError
  ? &mut Allocator {
  let samples = measured.samples.asSlice()
  let base = run timesOf(samples, reference)
  let mut rows = List<Row>.make()
  let mut subject: usize = 0
  while subject < subjects.length {
    let name = subjects[subject].name.view()
    let times = run timesOf(samples, name)
    let mut user = List<f64>.make()
    let mut system = List<f64>.make()
    let mut peak = List<f64>.make()
    let mut failures: u64 = 0
    let mut at: usize = 0
    while at < samples.length {
      if counted(&samples[at], name) {
        run user.append(u64.toF64(samples[at].user))
        run system.append(u64.toF64(samples[at].system))
        run peak.append(u64.toF64(samples[at].peak))
      } else if measuredFor(&samples[at], name) {
        failures = failures + 1
      }
      at = at + 1
    }
    let summary = run Statistics.summary(times.asSlice())
    let isReference = name == reference
    let mut ratio = Option<Comparison>.None
    if !isReference && times.length() > 0 && base.length() > 0 {
      let compared = run Statistics.ratio(times.asSlice(), base.asSlice(), noise)
      ratio = Option<Comparison>.Some {
        value: Comparison {
          value: compared.value,
          low: compared.low,
          high: compared.high,
          verdict: run String.copy(verdictText(compared.verdict)),
        },
      }
    }
    run rows.append(
      Row {
        implementation: run String.copy(name),
        reference: isReference,
        runs: usize.toU64(summary.count),
        failures: failures,
        median: summary.median,
        minimum: summary.minimum,
        maximum: summary.maximum,
        mean: summary.mean,
        low: summary.low,
        high: summary.high,
        outliers: usize.toU64(summary.outliers),
        user: run Statistics.median(user.asSlice()),
        system: run Statistics.median(system.asSlice()),
        peak: run Statistics.median(peak.asSlice()),
        ratio: move ratio,
        times: move times,
      },
    )
    subject = subject + 1
  }
  return Table {
    name: run String.copy(measured.name.view()),
    parameters: run copyPairs(&measured.parameters),
    rows: move rows,
  }
}

fn verdictText(verdict: Verdict) -> string<'static> {
  return match verdict {
    Verdict.Faster => "faster"
    Verdict.Slower => "slower"
    Verdict.Same => "same"
  }
}

effect fn copyOptional(text: &Option<String>) -> Option<String>
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &text.* {
    Option<String>.Some { value } => Option<String>.Some { value: run String.copy(value.view()) }
    Option<String>.None => Option<String>.None
  }
}

effect fn copyTexts(texts: &List<String>) -> List<String>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut copies = List<String>.make()
  let listed = texts.asSlice()
  let mut at: usize = 0
  while at < listed.length {
    run copies.append(run String.copy(listed[at].view()))
    at = at + 1
  }
  return move copies
}

effect fn copyPairs(pairs: &List<Pair>) -> List<Pair>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut copies = List<Pair>.make()
  let listed = pairs.asSlice()
  let mut at: usize = 0
  while at < listed.length {
    run copies.append(
      Pair {
        name: run String.copy(listed[at].name.view()),
        value: run String.copy(listed[at].value.view()),
      },
    )
    at = at + 1
  }
  return move copies
}

effect fn copySubjects(subjects: &[Subject]) -> List<Subject>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut copies = List<Subject>.make()
  let mut at: usize = 0
  while at < subjects.length {
    run copies.append(
      Subject {
        name: run String.copy(subjects[at].name.view()),
        command: run String.copy(subjects[at].command.view()),
        revision: run copyOptional(&subjects[at].revision),
      },
    )
    at = at + 1
  }
  return move copies
}

effect fn copyEnvironment(environment: &Environment) -> Environment
  ! OutOfMemoryError
  ? &mut Allocator {
  return Environment {
    system: run String.copy(environment.system.view()),
    release: run String.copy(environment.release.view()),
    machine: run String.copy(environment.machine.view()),
    processor: run String.copy(environment.processor.view()),
    processors: environment.processors,
    usable: environment.usable,
    memory: environment.memory,
    load: environment.load,
    variables: run copyPairs(&environment.variables),
  }
}
