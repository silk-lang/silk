//! Turns the raw samples of a benchmark run into the report a renderer draws.
//!
//! # When to use
//! Call [`Reports.make`] on a `silk.bench.record.RunResult` you read from a result file, to
//! render a saved run again or with another noise threshold. `silk.bench.bench` calls it for
//! every suite it runs.
//!
//! # Details
//! A combination of parameters whose programs print result lines gets one table for each name
//! the lines carry, in the unit of the lines: `ns/op` when a line has it, or else the first
//! unit written. The medians of the other units are in the row. Where a larger value is better,
//! as for `req/s`, a ratio above 1 has the verdict `faster`. When the lines of two
//! implementations carry different checks for one name, the table is marked and no row of it
//! has a ratio. Every other combination gets one table of process times, as follows.
//!
//! Each implementation gets one row for each benchmark. The row's statistics cover the measured
//! runs that exited with status 0: warm-up runs and failed runs are left out, and failed runs
//! are counted in the row. Every row except the reference's gets its ratio to the reference
//! with a 95% interval and a verdict, from `silk.bench.statistics`. A suite with more than one
//! benchmark also gets the geometric mean of each implementation's ratios.
//!
//! @category Benchmarks

import silk.bench.record {
  Comparison,
  Environment,
  Measured,
  Metric,
  Overall,
  PROTOCOL,
  Pair,
  Reading,
  Report,
  Row,
  RunResult,
  Sample,
  Subject,
  Table
}
import silk.bench.statistics { Ratio, Statistics, Summary, Verdict }
import silk.bench.units { Units }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u64
import silk.num.usize
import silk.text.string { String }

/// The owner type of the report functions. It has no fields and is never constructed.
pub struct Reports {}

impl Reports {
  /// Returns the report of `result`, with verdicts at the noise threshold `noise`, a fraction
  /// such as 0.01 for 1%.
  ///
  /// # Errors
  /// `OutOfMemoryError` if the `Allocator` cannot supply the report.
  pub effect fn make(result: &RunResult, noise: f64) -> Report
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut tables = List<Table>.make()
    let measured = result.benchmarks.asSlice()
    let subjects = result.implementations.asSlice()
    let mut at: usize = 0
    while at < measured.length {
      if measured[at].readings.length() == 0 {
        run tables.append(run table(&measured[at], subjects, result.reference.view(), noise))
      } else {
        run readingTables(&mut tables, result, &measured[at], noise)
      }
      at = at + 1
    }
    let mut overall = List<Overall>.make()
    if tables.length() > 1 {
      let mut subject: usize = 0
      while subject < subjects.length {
        let name = subjects[subject].name.view()
        if name != result.reference.view() {
          let mut ratios = List<f64>.make()
          let listed = tables.asSlice()
          let mut index: usize = 0
          while index < listed.length {
            let rows = listed[index].rows.asSlice()
            let mut row: usize = 0
            while row < rows.length {
              if rows[row].implementation.view() == name {
                if let Option<Comparison>.Some { value } = &rows[row].ratio {
                  if listed[index].higher {
                    run ratios.append(1.0 / value.value)
                  } else {
                    run ratios.append(value.value)
                  }
                }
              }
              row = row + 1
            }
            index = index + 1
          }
          if ratios.length() > 1 {
            run overall.append(
              Overall {
                implementation: run String.copy(name),
                ratio: Statistics.geometricMean(ratios.asSlice()),
                benchmarks: usize.toU64(ratios.length()),
              },
            )
          }
        }
        subject = subject + 1
      }
    }
    return Report {
      protocol: PROTOCOL,
      suite: run String.copy(result.suite.view()),
      id: run String.copy(result.id.view()),
      label: run copyOptional(&result.label),
      revision: run copyOptional(&result.revision),
      started: run String.copy(result.started.view()),
      ended: run String.copy(result.ended.view()),
      notes: run copyTexts(&result.notes),
      environment: run copyEnvironment(&result.environment),
      implementations: run copySubjects(subjects),
      reference: run String.copy(result.reference.view()),
      noise: noise,
      runs: result.runs,
      floor: result.floor,
      benchmarks: move tables,
      overall: move overall,
    }
  }
}

// The wall times of the successful measured runs of `name`, in nanoseconds.
effect fn timesOf(samples: &[Sample], name: string) -> List<f64>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut times = List<f64>.make()
  let mut at: usize = 0
  while at < samples.length {
    if counted(&samples[at], name) {
      run times.append(u64.toF64(samples[at].wall))
    }
    at = at + 1
  }
  return move times
}

fn measuredFor(sample: &Sample, name: string) -> bool {
  return !sample.warmup && sample.implementation.view() == name
}

fn counted(sample: &Sample, name: string) -> bool {
  return measuredFor(sample, name) && sample.exit == 0 && sample.signal == 0
}

effect fn table(measured: &Measured, subjects: &[Subject], reference: string, noise: f64) -> Table
  ! OutOfMemoryError
  ? &mut Allocator {
  let samples = measured.samples.asSlice()
  let base = run timesOf(samples, reference)
  let mut rows = List<Row>.make()
  let mut subject: usize = 0
  while subject < subjects.length {
    let name = subjects[subject].name.view()
    let times = run timesOf(samples, name)
    let mut user = List<f64>.make()
    let mut system = List<f64>.make()
    let mut peak = List<f64>.make()
    let mut failures: u64 = 0
    let mut at: usize = 0
    while at < samples.length {
      if counted(&samples[at], name) {
        run user.append(u64.toF64(samples[at].user))
        run system.append(u64.toF64(samples[at].system))
        run peak.append(u64.toF64(samples[at].peak))
      } else if measuredFor(&samples[at], name) {
        failures = failures + 1
      }
      at = at + 1
    }
    let summary = run Statistics.summary(times.asSlice())
    let isReference = name == reference
    let mut ratio = Option<Comparison>.None
    if !isReference && times.length() > 0 && base.length() > 0 {
      let compared = run Statistics.ratio(times.asSlice(), base.asSlice(), noise)
      ratio = Option<Comparison>.Some {
        value: Comparison {
          value: compared.value,
          low: compared.low,
          high: compared.high,
          verdict: run String.copy(verdictText(compared.verdict)),
        },
      }
    }
    run rows.append(
      Row {
        implementation: run String.copy(name),
        reference: isReference,
        runs: usize.toU64(summary.count),
        failures: failures,
        median: summary.median,
        minimum: summary.minimum,
        maximum: summary.maximum,
        mean: summary.mean,
        low: summary.low,
        high: summary.high,
        outliers: usize.toU64(summary.outliers),
        user: run Statistics.median(user.asSlice()),
        system: run Statistics.median(system.asSlice()),
        peak: run Statistics.median(peak.asSlice()),
        ratio: move ratio,
        times: move times,
        others: List<Metric>.make(),
        check: Option<String>.None,
      },
    )
    subject = subject + 1
  }
  return Table {
    name: run String.copy(measured.name.view()),
    parameters: run copyPairs(&measured.parameters),
    unit: run String.copy("ns"),
    higher: false,
    mismatch: false,
    rows: move rows,
  }
}

// Whether the measured run of `name` in `round` ended well. A reading of a run that failed is
// in no statistic.
fn succeeded(samples: &[Sample], name: string, round: u64) -> bool {
  let mut at: usize = 0
  while at < samples.length {
    if measuredFor(&samples[at], name) && samples[at].round == round {
      return samples[at].exit == 0 && samples[at].signal == 0
    }
    at = at + 1
  }
  return true
}

fn valueOf(reading: &Reading, unit: string) -> Option<f64> {
  let values = reading.values.asSlice()
  let mut at: usize = 0
  while at < values.length {
    if values[at].unit.view() == unit {
      return Option<f64>.Some { value: values[at].value }
    }
    at = at + 1
  }
  return Option<f64>.None
}

// The values of `unit` that the counted readings of `title` by `name` carry.
effect fn valuesOf(measured: &Measured, title: string, name: string, unit: string) -> List<f64>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut values = List<f64>.make()
  let readings = measured.readings.asSlice()
  let samples = measured.samples.asSlice()
  let mut at: usize = 0
  while at < readings.length {
    let reading = &readings[at]
    if !reading.warmup && reading.name.view() == title && reading.implementation.view() == name
      && succeeded(samples, name, reading.round) {
      if let Option<f64>.Some { value } = valueOf(reading, unit) {
        run values.append(value)
      }
    }
    at = at + 1
  }
  return move values
}

// The units the measured readings of `title` carry, in the order they first appear, with
// `ns/op` first when a reading has it: the first unit is the one the statistics cover.
effect fn unitsOf(measured: &Measured, title: string) -> List<String>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut units = List<String>.make()
  let readings = measured.readings.asSlice()
  let mut at: usize = 0
  while at < readings.length {
    if readings[at].name.view() == title {
      let values = readings[at].values.asSlice()
      let mut value: usize = 0
      while value < values.length {
        let unit = values[value].unit.view()
        let known = units.asSlice()
        let mut found = false
        let mut index: usize = 0
        while index < known.length {
          if known[index].view() == unit {
            found = true
          }
          index = index + 1
        }
        if !found {
          run units.append(run String.copy(unit))
        }
        value = value + 1
      }
    }
    at = at + 1
  }
  let found = units.asSlice()
  let mut ordered = List<String>.make()
  at = 0
  while at < found.length {
    if found[at].view() == "ns/op" {
      run ordered.append(run String.copy("ns/op"))
    }
    at = at + 1
  }
  at = 0
  while at < found.length {
    if found[at].view() != "ns/op" {
      run ordered.append(run String.copy(found[at].view()))
    }
    at = at + 1
  }
  return move ordered
}

// The check of the readings of `title` by `name`, and whether `checks` now holds two that
// differ.
effect fn checkOf(
  measured: &Measured,
  title: string,
  name: string,
  checks: &mut List<String>,
) -> Option<String>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut own = Option<String>.None
  let readings = measured.readings.asSlice()
  let mut at: usize = 0
  while at < readings.length {
    let reading = &readings[at]
    if reading.name.view() == title && reading.implementation.view() == name {
      if let Option<String>.Some { value } = &reading.check {
        let known = checks.asSlice()
        let mut found = false
        let mut index: usize = 0
        while index < known.length {
          if known[index].view() == value.view() {
            found = true
          }
          index = index + 1
        }
        if !found {
          run checks.append(run String.copy(value.view()))
        }
        own = Option<String>.Some { value: run String.copy(value.view()) }
      }
    }
    at = at + 1
  }
  return move own
}

effect fn readingTable(result: &RunResult, measured: &Measured, title: string, noise: f64) -> Table
  ! OutOfMemoryError
  ? &mut Allocator {
  let subjects = result.implementations.asSlice()
  let reference = result.reference.view()
  let samples = measured.samples.asSlice()
  let units = run unitsOf(measured, title)
  let listed = units.asSlice()
  let unit = listed[0].view()
  let higher = Units.higher(unit)
  let base = run valuesOf(measured, title, reference, unit)
  let mut checks = List<String>.make()
  let mut rows = List<Row>.make()
  let mut subject: usize = 0
  while subject < subjects.length {
    let name = subjects[subject].name.view()
    let values = run valuesOf(measured, title, name, unit)
    let mut failures: u64 = 0
    let mut at: usize = 0
    while at < samples.length {
      if measuredFor(&samples[at], name) && !counted(&samples[at], name) {
        failures = failures + 1
      }
      at = at + 1
    }
    let summary = run Statistics.summary(values.asSlice())
    let isReference = name == reference
    let mut ratio = Option<Comparison>.None
    if !isReference && values.length() > 0 && base.length() > 0 {
      let compared = run Statistics.ratio(values.asSlice(), base.asSlice(), noise)
      let mut verdict = compared.verdict
      if higher {
        verdict = match compared.verdict {
          Verdict.Faster => Verdict.Slower
          Verdict.Slower => Verdict.Faster
          Verdict.Same => Verdict.Same
        }
      }
      ratio = Option<Comparison>.Some {
        value: Comparison {
          value: compared.value,
          low: compared.low,
          high: compared.high,
          verdict: run String.copy(verdictText(verdict)),
        },
      }
    }
    let mut others = List<Metric>.make()
    at = 1
    while at < listed.length {
      let other = run valuesOf(measured, title, name, listed[at].view())
      if other.length() > 0 {
        run others.append(
          Metric {
            unit: run String.copy(listed[at].view()),
            value: run Statistics.median(other.asSlice()),
          },
        )
      }
      at = at + 1
    }
    run rows.append(
      Row {
        implementation: run String.copy(name),
        reference: isReference,
        runs: usize.toU64(summary.count),
        failures: failures,
        median: summary.median,
        minimum: summary.minimum,
        maximum: summary.maximum,
        mean: summary.mean,
        low: summary.low,
        high: summary.high,
        outliers: usize.toU64(summary.outliers),
        user: 0.0,
        system: 0.0,
        peak: 0.0,
        ratio: move ratio,
        times: move values,
        others: move others,
        check: run checkOf(measured, title, name, &mut checks),
      },
    )
    subject = subject + 1
  }
  let mismatch = checks.length() > 1
  if mismatch {
    // The implementations did not do the same work, so no row is compared.
    let all = rows.asMutSlice()
    let mut at: usize = 0
    while at < all.length {
      all[at].ratio = Option<Comparison>.None
      at = at + 1
    }
  }

  // The name the program gave, then the parameters of the combination.
  let mut name = run String.copy(title)
  let suffix = String.slice(
    measured.name.view(),
    String.byteLength(result.suite.view()),
    String.byteLength(measured.name.view()) - String.byteLength(result.suite.view()),
  )
  if String.byteLength(title) == 0 {
    name = run String.copy(measured.name.view())
  } else {
    run name.append(suffix)
  }
  return Table {
    name: move name,
    parameters: run copyPairs(&measured.parameters),
    unit: run String.copy(unit),
    higher: higher,
    mismatch: mismatch,
    rows: move rows,
  }
}

// One table for each name the readings of `measured` carry, in the order the names first
// appear.
effect fn readingTables(
  tables: &mut List<Table>,
  result: &RunResult,
  measured: &Measured,
  noise: f64,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let readings = measured.readings.asSlice()
  let mut at: usize = 0
  while at < readings.length {
    let title = readings[at].name.view()
    let mut seen = false
    let mut before: usize = 0
    while before < at {
      if readings[before].name.view() == title {
        seen = true
        break
      }
      before = before + 1
    }
    if !seen {
      run tables.append(run readingTable(result, measured, title, noise))
    }
    at = at + 1
  }
}

fn verdictText(verdict: Verdict) -> string<'static> {
  return match verdict {
    Verdict.Faster => "faster"
    Verdict.Slower => "slower"
    Verdict.Same => "same"
  }
}

effect fn copyOptional(text: &Option<String>) -> Option<String>
  ! OutOfMemoryError
  ? &mut Allocator {
  return match &text.* {
    Option<String>.Some { value } => Option<String>.Some { value: run String.copy(value.view()) }
    Option<String>.None => Option<String>.None
  }
}

effect fn copyTexts(texts: &List<String>) -> List<String>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut copies = List<String>.make()
  let listed = texts.asSlice()
  let mut at: usize = 0
  while at < listed.length {
    run copies.append(run String.copy(listed[at].view()))
    at = at + 1
  }
  return move copies
}

effect fn copyPairs(pairs: &List<Pair>) -> List<Pair>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut copies = List<Pair>.make()
  let listed = pairs.asSlice()
  let mut at: usize = 0
  while at < listed.length {
    run copies.append(
      Pair {
        name: run String.copy(listed[at].name.view()),
        value: run String.copy(listed[at].value.view()),
      },
    )
    at = at + 1
  }
  return move copies
}

effect fn copySubjects(subjects: &[Subject]) -> List<Subject>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut copies = List<Subject>.make()
  let mut at: usize = 0
  while at < subjects.length {
    run copies.append(
      Subject {
        name: run String.copy(subjects[at].name.view()),
        command: run String.copy(subjects[at].command.view()),
        revision: run copyOptional(&subjects[at].revision),
      },
    )
    at = at + 1
  }
  return move copies
}

effect fn copyEnvironment(environment: &Environment) -> Environment
  ! OutOfMemoryError
  ? &mut Allocator {
  return Environment {
    system: run String.copy(environment.system.view()),
    release: run String.copy(environment.release.view()),
    machine: run String.copy(environment.machine.view()),
    processor: run String.copy(environment.processor.view()),
    processors: environment.processors,
    usable: environment.usable,
    memory: environment.memory,
    load: environment.load,
    variables: run copyPairs(&environment.variables),
  }
}
