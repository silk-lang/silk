//! Draws a benchmark report as one static HTML page with charts.
//!
//! # When to use
//! Call [`Html.page`] on a `silk.bench.record.Report` to make a page you can open, attach to a
//! pull request, or publish. `silk.bench.bench` calls it for the outputs a suite declares with
//! `Format.Html`, and for `--html`.
//!
//! # Details
//! The page is one file: its style is inline, its charts are inline SVG, and it loads nothing
//! and runs no script, so it opens the same from a disk, an archive, or a web server. It follows
//! the reader's light or dark color scheme.
//!
//! Each benchmark has the table of `silk.bench.render` and one chart on a shared time axis that
//! starts at zero. A row of the chart is an implementation: a bar to its median, a whisker over
//! the 95% interval of the median, and one dot for each run, so a reader sees the spread and
//! any outlier. A bar is green or red only when the verdict is `faster` or `slower`; the table
//! says the same in words.
//!
//! @category Benchmarks

import silk.bench.record { Chart, Comparison, Panel, Report, Row, Table }
import silk.bench.render { Render }
import silk.bench.units { Units }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f64
import silk.num.usize
import silk.text.string { String }

const STYLE: string<
  'static
> = ":root{color-scheme:light dark;--text:#1c1e21;--soft:#646a73;--line:#d9dce1;--back:#ffffff;--bar:#8f96a3;--good:#1a7f4b;--bad:#c2372e}@media(prefers-color-scheme:dark){:root{--text:#e6e8eb;--soft:#9aa1ac;--line:#353a42;--back:#16181c;--bar:#6b7380;--good:#4cc38a;--bad:#ff7b72}}body{margin:0;background:var(--back);color:var(--text);font:15px/1.5 system-ui,-apple-system,Segoe UI,sans-serif}main{max-width:960px;margin:0 auto;padding:32px 16px 64px}h1{font-size:26px;margin:0 0 4px}h2{font-size:18px;margin:40px 0 8px}p.meta,li{color:var(--soft)}ul{padding-left:20px}.scroll{overflow-x:auto}table{border-collapse:collapse;width:100%;font-variant-numeric:tabular-nums}th,td{padding:6px 10px;text-align:right;border-bottom:1px solid var(--line);white-space:nowrap}th{color:var(--soft);font-weight:500;font-size:13px}th:first-child,td:first-child,th:last-child,td:last-child{text-align:left}td.faster{color:var(--good)}td.slower{color:var(--bad)}td.same{color:var(--soft)}p.warn{color:var(--bad)}svg{display:block;width:100%;height:auto;margin-top:12px}svg text{fill:var(--soft);font-size:12px}svg text.name{fill:var(--text)}svg .grid{stroke:var(--line)}svg .bar{fill:var(--bar);opacity:.45}svg .bar.faster{fill:var(--good)}svg .bar.slower{fill:var(--bad)}svg .whisker{stroke:var(--text);stroke-width:1.5}svg .dot{fill:var(--text);opacity:.45}svg .one{stroke:var(--soft);stroke-dasharray:5 4}svg .mark{stroke:var(--soft);stroke-dasharray:2 3}svg .s0{stroke:#2f6fde;fill:#2f6fde}svg .s1{stroke:#d9730d;fill:#d9730d}svg .s2{stroke:#8250df;fill:#8250df}svg .s3{stroke:#0b8a8a;fill:#0b8a8a}svg .s4{stroke:#c2409a;fill:#c2409a}svg .line{fill:none;stroke-width:2}svg text.s0,svg text.s1,svg text.s2,svg text.s3,svg text.s4{stroke:none}svg rect.s0,svg rect.s1,svg rect.s2,svg rect.s3,svg rect.s4{stroke:none;opacity:.8}svg .faded{opacity:.2}h3{font-size:15px;margin:22px 0 4px}.legend{margin:8px 0 0;color:var(--soft);font-size:13px}.legend span{margin-right:16px;white-space:nowrap}.legend i{display:inline-block;width:10px;height:10px;border-radius:2px;margin-right:6px}.k0{background:#2f6fde}.k1{background:#d9730d}.k2{background:#8250df}.k3{background:#0b8a8a}.k4{background:#c2409a}"

// The chart's layout, in SVG units.
const WIDTH: f64 = 928.0

const NAMES: f64 = 150.0

const RIGHT: f64 = 24.0

const ROW: f64 = 34.0

const AXIS: f64 = 26.0

/// The owner type of the HTML renderer. It has no fields and is never constructed.
pub struct Html {}

impl Html {
  /// Returns the style sheet of the pages this module writes, for another page that should look
  /// the same.
  pub fn style() -> string<'static> {
    return STYLE
  }

  /// Appends `value` to `text` with the characters `&`, `<`, `>` and `"` written as HTML
  /// entities.
  ///
  /// # Errors
  /// `OutOfMemoryError` if the `Allocator` cannot grow `text`.
  pub effect fn escaped(text: &mut String, value: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return run escape(&mut text, value)
  }

  /// Returns `report` as one complete HTML document.
  ///
  /// # Errors
  /// `OutOfMemoryError` if the `Allocator` cannot supply the text.
  pub effect fn page(report: &Report) -> String
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut text = String.make()
    run text.append("<!doctype html>\n<html lang=\"en\"><head><meta charset=\"utf-8\">")
    run text.append(
      "<meta name=\"viewport\" content=\"width=device-width,initial-scale=1\"><title>",
    )
    run escape(&mut text, report.suite.view())
    run text.append(" benchmark</title><style>")
    run text.append(STYLE)
    run text.append("</style></head><body><main>\n<h1>")
    run escape(&mut text, report.suite.view())
    run text.append("</h1>\n<p class=\"meta\">")
    run escape(&mut text, report.started.view())
    if let Option<String>.Some { value } = &report.label {
      run text.append(" · ")
      run escape(&mut text, value.view())
    }
    run text.append(" · ")
    run Units.appendWhole(&mut text, report.runs)
    run text.append(" runs · reference ")
    run escape(&mut text, report.reference.view())
    run text.append("</p>\n")

    let overall = report.overall.asSlice()
    let mut at: usize = 0
    while at < overall.length {
      run text.append("<p>Overall, <b>")
      run escape(&mut text, overall[at].implementation.view())
      run text.append("</b> takes <b>")
      run text.appendOwned(run Units.ratio(overall[at].ratio))
      run text.append("</b> the time of ")
      run escape(&mut text, report.reference.view())
      run text.append(" (geometric mean of ")
      run Units.appendWhole(&mut text, overall[at].benchmarks)
      run text.append(" benchmarks).</p>\n")
      at = at + 1
    }

    let tables = report.benchmarks.asSlice()
    at = 0
    while at < tables.length {
      run section(&mut text, report, &tables[at])
      at = at + 1
    }

    let charts = report.views.asSlice()
    at = 0
    while at < charts.length {
      run view(&mut text, &charts[at])
      at = at + 1
    }

    run text.append("<h2>Run</h2>\n<ul>\n")
    let details = run Render.details(report)
    let lines = details.asSlice()
    at = 0
    while at < lines.length {
      run text.append("<li>")
      run escape(&mut text, lines[at].view())
      run text.append("</li>\n")
      at = at + 1
    }
    run text.append("</ul>\n</main></body></html>\n")
    return move text
  }
}

effect fn escape(text: &mut String, value: string) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let bytes = String.utf8Bytes(value)
  let mut start: usize = 0
  let mut at: usize = 0
  while at < bytes.length {
    let mut entity = ""
    if bytes[at] == 38 {
      entity = "&amp;"
    } else if bytes[at] == 60 {
      entity = "&lt;"
    } else if bytes[at] == 62 {
      entity = "&gt;"
    } else if bytes[at] == 34 {
      entity = "&quot;"
    }
    if String.byteLength(entity) > 0 {
      run text.append(String.slice(value, start, at - start))
      run text.append(entity)
      start = at + 1
    }
    at = at + 1
  }
  run text.append(String.slice(value, start, bytes.length - start))
}

fn verdictClass(row: &Row) -> string<'static> {
  if let Option<Comparison>.Some { value } = &row.ratio {
    if value.verdict.view() == "faster" {
      return "faster"
    }
    if value.verdict.view() == "slower" {
      return "slower"
    }
    return "same"
  }
  return ""
}

effect fn section(text: &mut String, report: &Report, table: &Table) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if report.benchmarks.length() > 1 || table.name.view() != report.suite.view() {
    run text.append("<h2>")
    run escape(&mut text, table.name.view())
    run text.append("</h2>\n")
  }
  run text.append("<div class=\"scroll\"><table>\n<tr>")
  let titles = run Render.titles(report, table)
  let headings = titles.asSlice()
  let mut column: usize = 0
  while column < headings.length {
    run text.append("<th>")
    run escape(&mut text, headings[column].view())
    run text.append("</th>")
    column = column + 1
  }
  run text.append("</tr>\n")
  let rows = table.rows.asSlice()
  let mut at: usize = 0
  while at < rows.length {
    let cells = run Render.cells(report, table, &rows[at])
    let listed = cells.asSlice()
    run text.append("<tr>")
    column = 0
    while column < listed.length {
      if column == listed.length - 1 {
        run text.append("<td class=\"")
        run text.append(verdictClass(&rows[at]))
        run text.append("\">")
      } else {
        run text.append("<td>")
      }
      run escape(&mut text, listed[column].view())
      run text.append("</td>")
      column = column + 1
    }
    run text.append("</tr>\n")
    at = at + 1
  }
  run text.append("</table></div>\n")
  at = 0
  while at < rows.length {
    if rows[at].failures > 0 {
      run text.append("<p class=\"warn\">")
      run escape(&mut text, rows[at].implementation.view())
      run text.append(": ")
      run Units.appendWhole(&mut text, rows[at].failures)
      run text.append(" of ")
      run Units.appendWhole(&mut text, rows[at].failures + rows[at].runs)
      run text.append(" runs failed and are in no statistic.</p>\n")
    }
    at = at + 1
  }
  if table.mismatch {
    run text.append(
      "<p class=\"warn\">The checks differ, so the implementations did not do the same work and are not compared.</p>\n",
    )
  }
  run chart(&mut text, table)
}

effect fn number(text: &mut String, value: f64) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  return run Units.appendFixed(&mut text, value, 1)
}

// A round step that puts about five ticks on an axis that ends at `limit`.
fn tickStep(limit: f64) -> f64 {
  let mut step = 1.0
  while step * 10.0 <= limit {
    step = step * 10.0
  }
  while step > limit {
    step = step / 10.0
  }
  if limit / step < 2.5 {
    return step / 2.0
  }
  if limit / step > 7.0 {
    return step * 2.0
  }
  return step
}

effect fn chart(text: &mut String, table: &Table) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let rows = table.rows.asSlice()
  let mut limit = 0.0
  let mut at: usize = 0
  while at < rows.length {
    limit = f64.max(limit, rows[at].maximum)
    at = at + 1
  }
  if limit <= 0.0 {
    return ()
  }
  let scale = Units.measure(limit, table.unit.view())
  let step = tickStep(limit / scale.nanoseconds) * scale.nanoseconds
  let plot = WIDTH - NAMES - RIGHT
  let height = ROW * usize.toF64(rows.length) + AXIS
  run text.append("<svg viewBox=\"0 0 ")
  run number(&mut text, WIDTH)
  run text.append(" ")
  run number(&mut text, height)
  run text.append("\" role=\"img\" aria-label=\"")
  run escape(&mut text, table.name.view())
  run text.append(": each measured value, with the median and its 95% interval\">\n")

  let mut tick = 0.0
  while tick <= limit {
    let x = NAMES + plot * tick / limit
    run text.append("<line class=\"grid\" x1=\"")
    run number(&mut text, x)
    run text.append("\" y1=\"0\" x2=\"")
    run number(&mut text, x)
    run text.append("\" y2=\"")
    run number(&mut text, height - AXIS)
    run text.append("\"/><text text-anchor=\"middle\" x=\"")
    run number(&mut text, x)
    run text.append("\" y=\"")
    run number(&mut text, height - 8.0)
    run text.append("\">")
    if tick > 0.0 {
      run text.appendOwned(run Units.scaled(tick, scale))
      run text.append(" ")
      run escape(&mut text, Units.named(scale, table.unit.view()))
    } else {
      run text.append("0")
    }
    run text.append("</text>\n")
    tick = tick + step
  }

  at = 0
  while at < rows.length {
    let row = &rows[at]
    let top = ROW * usize.toF64(at)
    let middle = top + ROW / 2.0
    run text.append("<text class=\"name\" x=\"0\" y=\"")
    run number(&mut text, middle + 4.0)
    run text.append("\">")
    run escape(&mut text, row.implementation.view())
    run text.append("</text>")
    if row.runs > 0 {
      run text.append("<rect class=\"bar ")
      run text.append(verdictClass(row))
      run text.append("\" x=\"")
      run number(&mut text, NAMES)
      run text.append("\" y=\"")
      run number(&mut text, top + 7.0)
      run text.append("\" width=\"")
      run number(&mut text, plot * row.median / limit)
      run text.append("\" height=\"")
      run number(&mut text, ROW - 14.0)
      run text.append("\"/>")
      let times = row.times.asSlice()
      let mut dot: usize = 0
      while dot < times.length {
        run text.append("<circle class=\"dot\" r=\"2.5\" cx=\"")
        run number(&mut text, NAMES + plot * times[dot] / limit)
        run text.append("\" cy=\"")
        run number(&mut text, middle)
        run text.append("\"/>")
        dot = dot + 1
      }
      let low = NAMES + plot * row.low / limit
      let high = NAMES + plot * row.high / limit
      run text.append("<path class=\"whisker\" fill=\"none\" d=\"M")
      run number(&mut text, low)
      run text.append(" ")
      run number(&mut text, middle - 6.0)
      run text.append("v12M")
      run number(&mut text, high)
      run text.append(" ")
      run number(&mut text, middle - 6.0)
      run text.append("v12M")
      run number(&mut text, low)
      run text.append(" ")
      run number(&mut text, middle)
      run text.append("H")
      run number(&mut text, high)
      run text.append("\"/>")
    }
    run text.append("\n")
    at = at + 1
  }
  run text.append("</svg>\n")
}

const COLORS: [string<'static>; 5] = ["s0", "s1", "s2", "s3", "s4"]

const KEYS: [string<'static>; 5] = ["k0", "k1", "k2", "k3", "k4"]

// The layout of a line chart, in SVG units.
const LEFT: f64 = 76.0

const TOP: f64 = 12.0

const PLOT: f64 = 220.0

const BOTTOM: f64 = 28.0

// The height of one bar of a bar chart, and the space around a group of bars.
const BAR: f64 = 14.0

const GROUP: f64 = 12.0

// One axis of a chart: the values at its two ends, and whether it is logarithmic.
struct Axis {
  low: f64,
  high: f64,
  log: bool,
  // The distance between the ticks of a linear axis.
  step: f64,
}

impl Copy for Axis {}

effect fn put(text: &mut String, before: string, value: f64) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run text.append(before)
  return run Units.appendFixed(&mut text, value, 1)
}

// The largest power of ten that is not above `value`, which is above zero.
fn decadeBelow(value: f64) -> f64 {
  let mut decade = 1.0
  while decade > value {
    decade = decade / 10.0
  }
  while decade * 10.0 <= value {
    decade = decade * 10.0
  }
  return decade
}

// An axis that holds `low` to `high`, with ends that are round in the scale `unit`: the size
// of what the labels count in, such as 1048576 for MiB.
fn axisOf(low: f64, high: f64, log: bool, zero: bool, unit: f64) -> Axis {
  if log && high > 0.0 {
    let mut bottom = low
    if !(bottom > 0.0) {
      bottom = high / 10.0
    }
    let start = decadeBelow(bottom)
    let mut end = decadeBelow(high)
    if end < high {
      end = end * 10.0
    }
    if end <= start {
      end = start * 10.0
    }
    return Axis { low: start, high: end, log: true, step: 0.0 }
  }
  let mut start = low
  if zero && start > 0.0 {
    start = 0.0
  }
  let mut end = high
  if !(end > start) {
    end = start + 1.0
  }
  let step = tickStep((end - start) / unit) * unit
  return Axis {
    low: f64.floor(start / step) * step,
    high: f64.ceil(end / step) * step,
    log: false,
    step: step,
  }
}

// Where `value` is along `axis`, from 0 at its low end to 1 at its high end.
fn share(axis: Axis, value: f64) -> f64 {
  if axis.log {
    if !(value > 0.0) {
      return 0.0
    }
    return (f64.log(value) - f64.log(axis.low)) / (f64.log(axis.high) - f64.log(axis.low))
  }
  return (value - axis.low) / (axis.high - axis.low)
}

effect fn ticksOf(axis: Axis) -> List<f64>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut ticks = List<f64>.make()
  if axis.log {
    let mut tick = axis.low
    while tick <= axis.high * 1.000001 {
      run ticks.append(tick)
      tick = tick * 10.0
    }
    return move ticks
  }
  let mut count = 0.0
  while axis.step > 0.0 && axis.low + count * axis.step <= axis.high + axis.step / 1000.0 {
    run ticks.append(axis.low + count * axis.step)
    count = count + 1.0
  }
  return move ticks
}

// A value of `chart` as an axis label.
effect fn labelOf(chart: &Chart, value: f64) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  if String.byteLength(chart.normalize.view()) > 0 {
    return run Units.ratio(value)
  }
  if value == 0.0 {
    return run String.copy("0")
  }
  return run Units.quantity(value, chart.y.view())
}

// The size of what the labels of `chart` count in when its largest value is `high`.
fn unitSize(chart: &Chart, high: f64) -> f64 {
  if String.byteLength(chart.normalize.view()) > 0 {
    return 1.0
  }
  return Units.measure(high, chart.y.view()).nanoseconds
}

// The smallest and the largest value of `panel`, whiskers included.
fn extent(panel: &Panel) -> Axis {
  let lists = panel.series.asSlice()
  let mut low = 0.0
  let mut high = 0.0
  let mut any = false
  let mut series: usize = 0
  while series < lists.length {
    let points = lists[series].points.asSlice()
    let mut at: usize = 0
    while at < points.length {
      if !any || points[at].low < low {
        low = points[at].low
      }
      if !any || points[at].high > high {
        high = points[at].high
      }
      any = true
      at = at + 1
    }
    series = series + 1
  }
  return Axis { low: low, high: high, log: false, step: 0.0 }
}

// The number of entries along the axis of `panel` when the axis is not numeric.
fn entriesOf(panel: &Panel) -> usize {
  let lists = panel.series.asSlice()
  let mut most = 0.0
  let mut any = false
  let mut series: usize = 0
  while series < lists.length {
    let points = lists[series].points.asSlice()
    let mut at: usize = 0
    while at < points.length {
      if points[at].at > most {
        most = points[at].at
      }
      any = true
      at = at + 1
    }
    series = series + 1
  }
  if !any {
    return 0
  }
  return f64.toUsize(most) + 1
}

effect fn legend(text: &mut String, panel: &Panel) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let lists = panel.series.asSlice()
  if lists.length < 2 {
    return ()
  }
  run text.append("<p class=\"legend\">")
  let mut at: usize = 0
  while at < lists.length {
    run text.append("<span><i class=\"")
    run text.append(KEYS[at % 5])
    run text.append("\"></i>")
    run escape(&mut text, lists[at].name.view())
    run text.append("</span>")
    at = at + 1
  }
  run text.append("</p>\n")
}

effect fn opened(text: &mut String, height: f64, chart: &Chart, panel: &Panel) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run put(&mut text, "<svg viewBox=\"0 0 ", WIDTH)
  run put(&mut text, " ", height)
  run text.append("\" role=\"img\" aria-label=\"")
  run escape(&mut text, chart.title.view())
  if String.byteLength(panel.title.view()) > 0 {
    run text.append(": ")
    run escape(&mut text, panel.title.view())
  }
  run text.append("\">\n")
}

// The grid lines and labels of a value axis that runs from left to right under a plot `height`
// tall, and the dashed line at 1 of a normalized chart.
effect fn across(text: &mut String, chart: &Chart, axis: Axis, height: f64) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let plot = WIDTH - NAMES - RIGHT
  let ticks = run ticksOf(axis)
  let listed = ticks.asSlice()
  let mut at: usize = 0
  while at < listed.length {
    let x = NAMES + plot * share(axis, listed[at])
    run put(&mut text, "<line class=\"grid\" x1=\"", x)
    run put(&mut text, "\" y1=\"0\" x2=\"", x)
    run put(&mut text, "\" y2=\"", height)
    run put(&mut text, "\"/><text text-anchor=\"middle\" x=\"", x)
    run put(&mut text, "\" y=\"", height + AXIS - 8.0)
    run text.append("\">")
    run text.appendOwned(run labelOf(chart, listed[at]))
    run text.append("</text>\n")
    at = at + 1
  }
  if String.byteLength(chart.normalize.view()) > 0 && axis.low < 1.0 && axis.high > 1.0 {
    let x = NAMES + plot * share(axis, 1.0)
    run put(&mut text, "<line class=\"one\" x1=\"", x)
    run put(&mut text, "\" y1=\"0\" x2=\"", x)
    run put(&mut text, "\" y2=\"", height)
    run text.append("\"/>\n")
  }
}

// The entry of the axis at `place`, from any series of `panel` that has it.
fn entryAt<'panel>(panel: &'panel Panel, place: f64) -> string<'panel> {
  let lists = panel.series.asSlice()
  let mut series: usize = 0
  while series < lists.length {
    let points = lists[series].points.asSlice()
    let mut at: usize = 0
    while at < points.length {
      if points[at].at == place {
        return points[at].x.view()
      }
      at = at + 1
    }
    series = series + 1
  }
  return ""
}

// Bars from left to right: one group for each entry of the axis, one bar for each series.
effect fn bars(text: &mut String, chart: &Chart, panel: &Panel) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let lists = panel.series.asSlice()
  let entries = entriesOf(panel)
  if entries == 0 {
    return ()
  }
  let found = extent(panel)
  let axis = axisOf(
    found.low,
    found.high,
    chart.scale.view() != "linear",
    chart.zero,
    unitSize(chart, found.high),
  )
  let plot = WIDTH - NAMES - RIGHT
  let group = BAR * usize.toF64(lists.length) + GROUP
  let height = group * usize.toF64(entries)
  run legend(&mut text, panel)
  run opened(&mut text, height + AXIS, chart, panel)
  run across(&mut text, chart, axis, height)
  let mut entry: usize = 0
  while entry < entries {
    let top = group * usize.toF64(entry) + GROUP / 2.0
    run put(
      &mut text,
      "<text class=\"name\" x=\"0\" y=\"",
      top + BAR * usize.toF64(lists.length) / 2.0 + 4.0,
    )
    run text.append("\">")
    run escape(&mut text, entryAt(panel, usize.toF64(entry)))
    run text.append("</text>")
    let mut series: usize = 0
    while series < lists.length {
      let points = lists[series].points.asSlice()
      let mut at: usize = 0
      while at < points.length {
        if points[at].at == usize.toF64(entry) {
          let y = top + BAR * usize.toF64(series)
          let end = NAMES + plot * share(axis, points[at].value)
          run text.append("<rect class=\"")
          run text.append(COLORS[series % 5])
          run put(&mut text, "\" x=\"", NAMES)
          run put(&mut text, "\" y=\"", y + 1.0)
          run put(&mut text, "\" width=\"", f64.max(end - NAMES, 1.0))
          run put(&mut text, "\" height=\"", BAR - 2.0)
          run text.append("\"/>")
          if points[at].high > points[at].low {
            let low = NAMES + plot * share(axis, points[at].low)
            let high = NAMES + plot * share(axis, points[at].high)
            run put(&mut text, "<path class=\"whisker\" fill=\"none\" d=\"M", low)
            run put(&mut text, " ", y + 3.0)
            run put(&mut text, "v", BAR - 6.0)
            run put(&mut text, "M", high)
            run put(&mut text, " ", y + 3.0)
            run put(&mut text, "v", BAR - 6.0)
            run put(&mut text, "M", low)
            run put(&mut text, " ", y + BAR / 2.0)
            run put(&mut text, "H", high)
            run text.append("\"/>")
          }
        }
        at = at + 1
      }
      series = series + 1
    }
    run text.append("\n")
    entry = entry + 1
  }
  run text.append("</svg>\n")
}

// Every sample as a dot along a value axis, one row for each series. The warm-up runs are
// faded.
effect fn strip(text: &mut String, chart: &Chart, panel: &Panel) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let lists = panel.series.asSlice()
  if lists.length == 0 {
    return ()
  }
  let found = extent(panel)
  let axis = axisOf(
    found.low,
    found.high,
    chart.scale.view() != "linear",
    chart.zero,
    unitSize(chart, found.high),
  )
  let plot = WIDTH - NAMES - RIGHT
  let height = ROW * usize.toF64(lists.length)
  run opened(&mut text, height + AXIS, chart, panel)
  run across(&mut text, chart, axis, height)
  let mut series: usize = 0
  while series < lists.length {
    let middle = ROW * usize.toF64(series) + ROW / 2.0
    run put(&mut text, "<text class=\"name\" x=\"0\" y=\"", middle + 4.0)
    run text.append("\">")
    run escape(&mut text, lists[series].name.view())
    run text.append("</text>")
    let points = lists[series].points.asSlice()
    let mut at: usize = 0
    while at < points.length {
      // A fixed pattern up and down keeps dots of one value apart.
      let offset = (usize.toF64((at * 7) % 11) - 5.0) * 2.0
      run text.append("<circle class=\"")
      run text.append(COLORS[series % 5])
      if points[at].faded {
        run text.append(" faded")
      }
      run put(&mut text, "\" r=\"2.5\" cx=\"", NAMES + plot * share(axis, points[at].value))
      run put(&mut text, "\" cy=\"", middle + offset)
      run text.append("\"/>")
      at = at + 1
    }
    run text.append("\n")
    series = series + 1
  }
  run text.append("</svg>\n")
}

// Lines from left to right: one line for each series, the value going up.
effect fn lines(text: &mut String, chart: &Chart, panel: &Panel) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let lists = panel.series.asSlice()
  let entries = entriesOf(panel)
  if entries == 0 {
    return ()
  }
  let found = extent(panel)
  let axis = axisOf(
    found.low,
    found.high,
    chart.scale.view() != "linear",
    chart.zero,
    unitSize(chart, found.high),
  )

  // The axis the lines run along: the numbers of a numeric one, or evenly spaced entries.
  let mut first = 0.0
  let mut last = 0.0
  let mut any = false
  let mut series: usize = 0
  while series < lists.length {
    let points = lists[series].points.asSlice()
    let mut at: usize = 0
    while at < points.length {
      if !any || points[at].at < first {
        first = points[at].at
      }
      if !any || points[at].at > last {
        last = points[at].at
      }
      any = true
      at = at + 1
    }
    series = series + 1
  }
  let mut along = Axis { low: first, high: last, log: false, step: 0.0 }
  if chart.numeric {
    along.log = chart.scale.view() == "log-log" && first > 0.0
    if !(last > first) {
      along.low = first - 1.0
      along.high = first + 1.0
    }
  } else {
    along.low = 0.0 - 0.5
    along.high = usize.toF64(entries) - 0.5
  }
  let plot = WIDTH - LEFT - RIGHT
  run legend(&mut text, panel)
  run opened(&mut text, TOP + PLOT + BOTTOM, chart, panel)

  let ticks = run ticksOf(axis)
  let listed = ticks.asSlice()
  let mut at: usize = 0
  while at < listed.length {
    let y = TOP + PLOT * (1.0 - share(axis, listed[at]))
    run put(&mut text, "<line class=\"grid\" x1=\"", LEFT)
    run put(&mut text, "\" y1=\"", y)
    run put(&mut text, "\" x2=\"", WIDTH - RIGHT)
    run put(&mut text, "\" y2=\"", y)
    run put(&mut text, "\"/><text text-anchor=\"end\" x=\"", LEFT - 8.0)
    run put(&mut text, "\" y=\"", y + 4.0)
    run text.append("\">")
    run text.appendOwned(run labelOf(chart, listed[at]))
    run text.append("</text>\n")
    at = at + 1
  }
  if String.byteLength(chart.normalize.view()) > 0 && axis.low < 1.0 && axis.high > 1.0 {
    let y = TOP + PLOT * (1.0 - share(axis, 1.0))
    run put(&mut text, "<line class=\"one\" x1=\"", LEFT)
    run put(&mut text, "\" y1=\"", y)
    run put(&mut text, "\" x2=\"", WIDTH - RIGHT)
    run put(&mut text, "\" y2=\"", y)
    run text.append("\"/>\n")
  }

  // The entries under the axis: every one while they fit, and else every few.
  let mut places = List<f64>.make()
  series = 0
  while series < lists.length {
    let points = lists[series].points.asSlice()
    at = 0
    while at < points.length {
      let known = places.asSlice()
      let mut seen = false
      let mut index: usize = 0
      while index < known.length {
        if known[index] == points[at].at {
          seen = true
        }
        index = index + 1
      }
      if !seen {
        run places.append(points[at].at)
      }
      at = at + 1
    }
    series = series + 1
  }
  let marks = places.asSlice()
  let every = (marks.length + 11) / 12
  at = 0
  while at < marks.length {
    // In the order of the axis, so that every few leaves even gaps.
    let mut before: usize = 0
    let mut index: usize = 0
    while index < marks.length {
      if marks[index] < marks[at] {
        before = before + 1
      }
      index = index + 1
    }
    if before % every == 0 {
      run put(
        &mut text,
        "<text text-anchor=\"middle\" x=\"",
        LEFT + 10.0 + (plot - 20.0) * share(along, marks[at]),
      )
      run put(&mut text, "\" y=\"", TOP + PLOT + BOTTOM - 8.0)
      run text.append("\">")
      run escape(&mut text, entryAt(panel, marks[at]))
      run text.append("</text>")
    }
    at = at + 1
  }
  run text.append("\n")

  series = 0
  while series < lists.length {
    let points = lists[series].points.asSlice()
    let color = COLORS[series % 5]
    if points.length > 1 {
      run text.append("<path class=\"line ")
      run text.append(color)
      run text.append("\" d=\"")
      at = 0
      while at < points.length {
        if at == 0 {
          run put(&mut text, "M", LEFT + 10.0 + (plot - 20.0) * share(along, points[at].at))
        } else {
          run put(&mut text, "L", LEFT + 10.0 + (plot - 20.0) * share(along, points[at].at))
        }
        run put(&mut text, " ", TOP + PLOT * (1.0 - share(axis, points[at].value)))
        at = at + 1
      }
      run text.append("\"/>")
    }
    at = 0
    while at < points.length {
      let x = LEFT + 10.0 + (plot - 20.0) * share(along, points[at].at)
      if points[at].high > points[at].low {
        run text.append("<path class=\"line ")
        run text.append(color)
        run put(&mut text, "\" stroke-width=\"1\" d=\"M", x)
        run put(&mut text, " ", TOP + PLOT * (1.0 - share(axis, points[at].low)))
        run put(&mut text, "V", TOP + PLOT * (1.0 - share(axis, points[at].high)))
        run text.append("\"/>")
      }
      run text.append("<circle class=\"")
      run text.append(color)
      run put(&mut text, "\" r=\"3\" cx=\"", x)
      run put(&mut text, "\" cy=\"", TOP + PLOT * (1.0 - share(axis, points[at].value)))
      run text.append("\"/>")
      at = at + 1
    }
    run text.append("\n")
    series = series + 1
  }
  run text.append("</svg>\n")
}

// A panel as a table, for the kinds that have no drawing.
effect fn pivot(text: &mut String, chart: &Chart, panel: &Panel) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let grid = run Render.grid(chart, panel)
  let rows = grid.asSlice()
  run text.append("<div class=\"scroll\"><table>\n")
  let mut row: usize = 0
  while row < rows.length {
    let cells = rows[row].asSlice()
    run text.append("<tr>")
    let mut column: usize = 0
    while column < cells.length {
      // The last column of a report table is text; here it is a number like the others.
      if row == 0 {
        run text.append("<th style=\"text-align:")
      } else {
        run text.append("<td style=\"text-align:")
      }
      if column == 0 {
        run text.append("left\">")
      } else {
        run text.append("right\">")
      }
      run escape(&mut text, cells[column].view())
      if row == 0 {
        run text.append("</th>")
      } else {
        run text.append("</td>")
      }
      column = column + 1
    }
    run text.append("</tr>\n")
    row = row + 1
  }
  run text.append("</table></div>\n")
}

effect fn view(text: &mut String, chart: &Chart) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let panels = chart.panels.asSlice()
  if panels.length == 0 {
    return ()
  }
  run text.append("<h2>")
  run escape(&mut text, chart.title.view())
  run text.append("</h2>\n")
  let kind = chart.kind.view()
  let mut at: usize = 0
  while at < panels.length {
    if String.byteLength(panels[at].title.view()) > 0 && panels.length > 1 {
      run text.append("<h3>")
      run escape(&mut text, panels[at].title.view())
      run text.append("</h3>\n")
    }
    if kind == "distribution" {
      run strip(&mut text, chart, &panels[at])
    } else if kind == "line" || kind == "percentiles" || kind == "history" {
      run lines(&mut text, chart, &panels[at])
    } else if kind == "ratio" || kind == "bars" {
      run bars(&mut text, chart, &panels[at])
    } else {
      run pivot(&mut text, chart, &panels[at])
    }
    at = at + 1
  }
}
