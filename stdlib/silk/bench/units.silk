//! Text for the quantities of a benchmark report: durations, memory sizes, and ratios.
//!
//! # When to use
//! Use [`Units`] in a renderer of your own, so its numbers read like those of the built-in
//! reports: `12.3 ms`, `4.20 MiB`, `0.49x`.
//!
//! # Details
//! A duration is given in nanoseconds and written with three significant digits in the largest
//! unit that keeps it at 1 or more: `ns`, `µs`, `ms`, or `s`. A [`Scale`] fixes the unit, so the
//! numbers of one column share it and line up. Memory is given in bytes and written in binary
//! units: `KiB`, `MiB`, `GiB`.
//!
//! # Examples
//! ```silk
//! import silk.bench.units { Units }
//! import silk.core.effect { Effect }
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.text.string { String }
//!
//! effect fn check() -> i32 ! OutOfMemoryError ? &mut Allocator {
//!   let time = run Units.duration(12345678.0)
//!   let size = run Units.memory(4404019.0)
//!   if String.view(&time) == "12.3 ms" && String.view(&size) == "4.20 MiB" {
//!     return 0
//!   }
//!   return 1
//! }
//!
//! effect fn failed(error: OutOfMemoryError) -> i32 {
//!   drop error
//!   return 2
//! }
//!
//! pub fn main() -> i32 {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   return run Effect.catchAll(check(), failed) |> Effect.provideMut<Allocator>(&mut allocator)
//! }
//! ```
//!
//! @category Benchmarks

import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f64
import silk.num.u8
import silk.num.u64
import silk.num.usize
import silk.text.string { String }

/// A unit chosen for a column of values, so that the numbers of the column line up.
pub struct Scale {
  /// How many of the base unit one unit holds: nanoseconds for a time, bytes for memory.
  pub nanoseconds: f64,
  /// The unit's name: `ns`, `µs`, `ms` or `s` for a time, `B`, `KiB`, `MiB` or `GiB` for
  /// memory. Empty for any other unit, which keeps the name the program gave it.
  pub name: string<'static>,
  /// What follows the number directly for any other unit: nothing, `k`, `M` or `G`.
  pub prefix: string<'static>,
}

impl Copy for Scale {}

/// The owner type of the unit functions. It has no fields and is never constructed.
pub struct Units {}

impl Units {
  /// Returns the largest unit in which `nanoseconds` is 1 or more, or `ns` for less than 1 µs.
  pub fn scale(nanoseconds: f64) -> Scale {
    if nanoseconds >= 1000000000.0 {
      return Scale { nanoseconds: 1000000000.0, name: "s", prefix: "" }
    }
    if nanoseconds >= 1000000.0 {
      return Scale { nanoseconds: 1000000.0, name: "ms", prefix: "" }
    }
    if nanoseconds >= 1000.0 {
      return Scale { nanoseconds: 1000.0, name: "µs", prefix: "" }
    }
    return Scale { nanoseconds: 1.0, name: "ns", prefix: "" }
  }

  /// Returns the kind of the unit `unit`, which decides how its values are scaled: `ns` for a
  /// time in nanoseconds, `B` for bytes, and nothing for any other unit.
  ///
  /// # Details
  /// What counts is the text before the first `/`, after a qualifier that ends with `-`. So
  /// `ns/op`, `user-ns/op` and `ns` are times, and `B/op` and `peak-B` are bytes.
  pub fn kind(unit: string) -> string<'static> {
    let bytes = String.utf8Bytes(unit)
    let mut end: usize = 0
    while end < bytes.length && bytes[end] != 47 {
      end = end + 1
    }
    let mut start = end
    while start > 0 && bytes[start - 1] != 45 {
      start = start - 1
    }
    let base = String.slice(unit, start, end - start)
    if base == "ns" {
      return "ns"
    }
    if base == "B" {
      return "B"
    }
    return ""
  }

  /// Returns whether a larger value of the unit `unit` is better: a unit that ends with `/s`
  /// or `/sec`, such as `req/s` or `MB/s`. For every other unit, smaller is better.
  pub fn higher(unit: string) -> bool {
    return String.endsWith(unit, "/s") || String.endsWith(unit, "/sec")
  }

  /// Returns the scale in which `value` of the unit `unit` reads best: the largest one in which
  /// it is 1 or more.
  pub fn measure(value: f64, unit: string) -> Scale {
    let kind = Units.kind(unit)
    if kind == "ns" {
      return Units.scale(value)
    }
    let size = f64.abs(value)
    if kind == "B" {
      if size >= 1073741824.0 {
        return Scale { nanoseconds: 1073741824.0, name: "GiB", prefix: "" }
      }
      if size >= 1048576.0 {
        return Scale { nanoseconds: 1048576.0, name: "MiB", prefix: "" }
      }
      if size >= 1024.0 {
        return Scale { nanoseconds: 1024.0, name: "KiB", prefix: "" }
      }
      return Scale { nanoseconds: 1.0, name: "B", prefix: "" }
    }
    if size >= 1000000000.0 {
      return Scale { nanoseconds: 1000000000.0, name: "", prefix: "G" }
    }
    if size >= 1000000.0 {
      return Scale { nanoseconds: 1000000.0, name: "", prefix: "M" }
    }
    if size >= 10000.0 {
      return Scale { nanoseconds: 1000.0, name: "", prefix: "k" }
    }
    return Scale { nanoseconds: 1.0, name: "", prefix: "" }
  }

  /// Returns the name that follows the numbers of a column in `scale`: the scale's own name for
  /// a time or memory, and `unit` as it is for any other unit.
  pub fn named<'unit>(scale: Scale, unit: string<'unit>) -> string<'unit> {
    if String.byteLength(scale.name) > 0 {
      return scale.name
    }
    return unit
  }

  /// Returns `value` of the unit `unit` as text with its unit, such as `12.3 ms`, `4.20 MiB` or
  /// `74.2k req/s`.
  ///
  /// # Errors
  /// `OutOfMemoryError` if the `Allocator` cannot supply the text.
  pub effect fn quantity(value: f64, unit: string) -> String
    ! OutOfMemoryError
    ? &mut Allocator {
    let scale = Units.measure(value, unit)
    let mut text = run Units.scaled(value, scale)
    run text.append(" ")
    run text.append(Units.named(scale, unit))
    return move text
  }

  /// Appends `value` to `text` with `decimals` digits after the point, rounded half away from
  /// zero. A value that is not finite is written as `-`.
  ///
  /// # Errors
  /// `OutOfMemoryError` if the `Allocator` cannot grow `text`.
  pub effect fn appendFixed(text: &mut String, value: f64, decimals: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if !f64.isFinite(value) || f64.abs(value) >= 9.0e18 {
      return run text.append("-")
    }
    let mut factor = 1.0
    let mut at: usize = 0
    while at < decimals {
      factor = factor * 10.0
      at = at + 1
    }
    let scaled = f64.toU64(f64.floor(f64.abs(value) * factor + 0.5))
    let divisor = f64.toU64(factor)
    if value < 0.0 && scaled > 0 {
      run text.append("-")
    }
    run Units.appendWhole(&mut text, scaled / divisor)
    if decimals == 0 {
      return ()
    }
    run text.append(".")
    let mut digits: [u8; 20] = [48; 20]
    let mut rest = scaled % divisor
    at = decimals
    while at > 0 {
      at = at - 1
      digits[at] = u64.toU8(48 + rest % 10)
      rest = rest / 10
    }
    return run appendDigits(&mut text, &digits, 0, decimals)
  }

  /// Appends `value` to `text` in decimal.
  ///
  /// # Errors
  /// `OutOfMemoryError` if the `Allocator` cannot grow `text`.
  pub effect fn appendWhole(text: &mut String, value: u64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut digits: [u8; 20] = [48; 20]
    let mut at: usize = 20
    let mut rest = value
    while true {
      at = at - 1
      digits[at] = u64.toU8(48 + rest % 10)
      rest = rest / 10
      if rest == 0 {
        break
      }
    }
    return run appendDigits(&mut text, &digits, at, 20)
  }

  /// Appends `value` to `text` with three significant digits: `1.23`, `12.3`, or `123`. Values
  /// of 1000 or more keep all their whole digits.
  ///
  /// # Errors
  /// `OutOfMemoryError` if the `Allocator` cannot grow `text`.
  pub effect fn appendSignificant(text: &mut String, value: f64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let size = f64.abs(value)
    if size >= 99.95 {
      return run Units.appendFixed(&mut text, value, 0)
    }
    if size >= 9.995 {
      return run Units.appendFixed(&mut text, value, 1)
    }
    return run Units.appendFixed(&mut text, value, 2)
  }

  /// Returns `nanoseconds`, a value in the base unit of `scale`, as text in the unit of `scale`,
  /// without the unit's name, such as `12.3`, or `74.2k` for a scale with a prefix.
  ///
  /// # Errors
  /// `OutOfMemoryError` if the `Allocator` cannot supply the text.
  pub effect fn scaled(nanoseconds: f64, scale: Scale) -> String
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut text = String.make()
    run Units.appendSignificant(&mut text, nanoseconds / scale.nanoseconds)
    run text.append(scale.prefix)
    return move text
  }

  /// Returns `nanoseconds` as text with its unit, such as `12.3 ms`.
  ///
  /// # Errors
  /// `OutOfMemoryError` if the `Allocator` cannot supply the text.
  pub effect fn duration(nanoseconds: f64) -> String
    ! OutOfMemoryError
    ? &mut Allocator {
    let scale = Units.scale(nanoseconds)
    let mut text = run Units.scaled(nanoseconds, scale)
    run text.append(" ")
    run text.append(scale.name)
    return move text
  }

  /// Returns `bytes` as text in binary units, such as `4.20 MiB`.
  ///
  /// # Errors
  /// `OutOfMemoryError` if the `Allocator` cannot supply the text.
  pub effect fn memory(bytes: f64) -> String
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut text = String.make()
    if bytes >= 1073741824.0 {
      run Units.appendSignificant(&mut text, bytes / 1073741824.0)
      run text.append(" GiB")
    } else if bytes >= 1048576.0 {
      run Units.appendSignificant(&mut text, bytes / 1048576.0)
      run text.append(" MiB")
    } else if bytes >= 1024.0 {
      run Units.appendSignificant(&mut text, bytes / 1024.0)
      run text.append(" KiB")
    } else {
      run Units.appendFixed(&mut text, bytes, 0)
      run text.append(" B")
    }
    return move text
  }

  /// Returns `ratio` as text with two decimals and an `x`, such as `0.49x`.
  ///
  /// # Errors
  /// `OutOfMemoryError` if the `Allocator` cannot supply the text.
  pub effect fn ratio(ratio: f64) -> String
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut text = String.make()
    run Units.appendFixed(&mut text, ratio, 2)
    run text.append("x")
    return move text
  }

  /// Returns the number of characters of `text`, which is the number of terminal columns it
  /// takes when it holds no wide or combining characters.
  pub fn width(text: string) -> usize {
    let bytes = String.utf8Bytes(text)
    let mut count: usize = 0
    let mut at: usize = 0
    while at < bytes.length {
      // Bytes 0x80 to 0xBF continue a character that was already counted.
      if bytes[at] < 128 || bytes[at] >= 192 {
        count = count + 1
      }
      at = at + 1
    }
    return count
  }
}

effect fn appendDigits(text: &mut String, digits: &[u8; 20], from: usize, to: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let names = "0123456789"
  let mut at = from
  while at < to {
    run text.append(String.slice(names, u8.toUsize(digits[at] - 48), 1))
    at = at + 1
  }
}
