//! Text for the quantities of a benchmark report: durations, memory sizes, and ratios.
//!
//! # When to use
//! Use [`Units`] in a renderer of your own, so its numbers read like those of the built-in
//! reports: `12.3 ms`, `4.20 MiB`, `0.49x`.
//!
//! # Details
//! A duration is given in nanoseconds and written with three significant digits in the largest
//! unit that keeps it at 1 or more: `ns`, `µs`, `ms`, or `s`. A [`Scale`] fixes the unit, so the
//! numbers of one column share it and line up. Memory is given in bytes and written in binary
//! units: `KiB`, `MiB`, `GiB`.
//!
//! # Examples
//! ```silk
//! import silk.bench.units { Units }
//! import silk.core.effect { Effect }
//! import silk.mem.allocator { Allocator }
//!
//! pub effect fn main() -> i32 {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let text = run Units.duration(12345678.0).ignoreError()
//!     |> Effect.provideMut<Allocator>(&mut allocator)
//!   return 0
//! }
//! ```
//!
//! @category Benchmarks

import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f64
import silk.num.u8
import silk.num.u64
import silk.num.usize
import silk.text.string { String }

/// A unit of time chosen for a column of durations.
pub struct Scale {
  /// How many nanoseconds one unit holds.
  pub nanoseconds: f64,
  /// The unit's name: `ns`, `µs`, `ms`, or `s`.
  pub name: string<'static>,
}

impl Copy for Scale {}

/// The owner type of the unit functions. It has no fields and is never constructed.
pub struct Units {}

impl Units {
  /// Returns the largest unit in which `nanoseconds` is 1 or more, or `ns` for less than 1 µs.
  pub fn scale(nanoseconds: f64) -> Scale {
    if nanoseconds >= 1000000000.0 {
      return Scale { nanoseconds: 1000000000.0, name: "s" }
    }
    if nanoseconds >= 1000000.0 {
      return Scale { nanoseconds: 1000000.0, name: "ms" }
    }
    if nanoseconds >= 1000.0 {
      return Scale { nanoseconds: 1000.0, name: "µs" }
    }
    return Scale { nanoseconds: 1.0, name: "ns" }
  }

  /// Appends `value` to `text` with `decimals` digits after the point, rounded half away from
  /// zero. A value that is not finite is written as `-`.
  ///
  /// # Errors
  /// `OutOfMemoryError` if the `Allocator` cannot grow `text`.
  pub effect fn appendFixed(text: &mut String, value: f64, decimals: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if !f64.isFinite(value) || f64.abs(value) >= 9.0e18 {
      return run text.append("-")
    }
    let mut factor = 1.0
    let mut at: usize = 0
    while at < decimals {
      factor = factor * 10.0
      at = at + 1
    }
    let scaled = f64.toU64(f64.floor(f64.abs(value) * factor + 0.5))
    let divisor = f64.toU64(factor)
    if value < 0.0 && scaled > 0 {
      run text.append("-")
    }
    run Units.appendWhole(&mut text, scaled / divisor)
    if decimals == 0 {
      return ()
    }
    run text.append(".")
    let mut digits: [u8; 20] = [48; 20]
    let mut rest = scaled % divisor
    at = decimals
    while at > 0 {
      at = at - 1
      digits[at] = u64.toU8(48 + rest % 10)
      rest = rest / 10
    }
    return run appendDigits(&mut text, &digits, 0, decimals)
  }

  /// Appends `value` to `text` in decimal.
  ///
  /// # Errors
  /// `OutOfMemoryError` if the `Allocator` cannot grow `text`.
  pub effect fn appendWhole(text: &mut String, value: u64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut digits: [u8; 20] = [48; 20]
    let mut at: usize = 20
    let mut rest = value
    while true {
      at = at - 1
      digits[at] = u64.toU8(48 + rest % 10)
      rest = rest / 10
      if rest == 0 {
        break
      }
    }
    return run appendDigits(&mut text, &digits, at, 20)
  }

  /// Appends `value` to `text` with three significant digits: `1.23`, `12.3`, or `123`. Values
  /// of 1000 or more keep all their whole digits.
  ///
  /// # Errors
  /// `OutOfMemoryError` if the `Allocator` cannot grow `text`.
  pub effect fn appendSignificant(text: &mut String, value: f64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let size = f64.abs(value)
    if size >= 99.95 {
      return run Units.appendFixed(&mut text, value, 0)
    }
    if size >= 9.995 {
      return run Units.appendFixed(&mut text, value, 1)
    }
    return run Units.appendFixed(&mut text, value, 2)
  }

  /// Returns `nanoseconds` as text in the unit of `scale`, without the unit's name, such as
  /// `12.3`.
  ///
  /// # Errors
  /// `OutOfMemoryError` if the `Allocator` cannot supply the text.
  pub effect fn scaled(nanoseconds: f64, scale: Scale) -> String
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut text = String.make()
    run Units.appendSignificant(&mut text, nanoseconds / scale.nanoseconds)
    return move text
  }

  /// Returns `nanoseconds` as text with its unit, such as `12.3 ms`.
  ///
  /// # Errors
  /// `OutOfMemoryError` if the `Allocator` cannot supply the text.
  pub effect fn duration(nanoseconds: f64) -> String
    ! OutOfMemoryError
    ? &mut Allocator {
    let scale = Units.scale(nanoseconds)
    let mut text = run Units.scaled(nanoseconds, scale)
    run text.append(" ")
    run text.append(scale.name)
    return move text
  }

  /// Returns `bytes` as text in binary units, such as `4.20 MiB`.
  ///
  /// # Errors
  /// `OutOfMemoryError` if the `Allocator` cannot supply the text.
  pub effect fn memory(bytes: f64) -> String
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut text = String.make()
    if bytes >= 1073741824.0 {
      run Units.appendSignificant(&mut text, bytes / 1073741824.0)
      run text.append(" GiB")
    } else if bytes >= 1048576.0 {
      run Units.appendSignificant(&mut text, bytes / 1048576.0)
      run text.append(" MiB")
    } else if bytes >= 1024.0 {
      run Units.appendSignificant(&mut text, bytes / 1024.0)
      run text.append(" KiB")
    } else {
      run Units.appendFixed(&mut text, bytes, 0)
      run text.append(" B")
    }
    return move text
  }

  /// Returns `ratio` as text with two decimals and an `x`, such as `0.49x`.
  ///
  /// # Errors
  /// `OutOfMemoryError` if the `Allocator` cannot supply the text.
  pub effect fn ratio(ratio: f64) -> String
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut text = String.make()
    run Units.appendFixed(&mut text, ratio, 2)
    run text.append("x")
    return move text
  }

  /// Returns the number of characters of `text`, which is the number of terminal columns it
  /// takes when it holds no wide or combining characters.
  pub fn width(text: string) -> usize {
    let bytes = String.utf8Bytes(text)
    let mut count: usize = 0
    let mut at: usize = 0
    while at < bytes.length {
      // Bytes 0x80 to 0xBF continue a character that was already counted.
      if bytes[at] < 128 || bytes[at] >= 192 {
        count = count + 1
      }
      at = at + 1
    }
    return count
  }
}

effect fn appendDigits(text: &mut String, digits: &[u8; 20], from: usize, to: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let names = "0123456789"
  let mut at = from
  while at < to {
    run text.append(String.slice(names, u8.toUsize(digits[at] - 48), 1))
    at = at + 1
  }
}
