//! Benchmarks declared with `bench fn`, the [`Bencher`] they loop on, and the program that
//! runs them.
//!
//! # When to use
//! Write a `bench fn` beside the code it measures when the work is a Silk function: a parser,
//! a hash, one step of a computation. Compare whole programs, or programs in other languages,
//! with a suite of `silk.bench.suite` instead.
//!
//! # Details
//! A benchmark is a top-level function marked `bench` that takes one [`Bencher`]. It does its
//! setup, then loops on [`Bencher.next`], and each turn of the loop is one iteration:
//!
//! ```silk,ignore
//! bench fn sumToOneThousand(b: Bencher) {
//!   let mut total: u64 = 0
//!   while b.next() {
//!     total = 0
//!     let mut at: u64 = 0
//!     while at < 1000 {
//!       total = total + at
//!       at = at + 1
//!     }
//!     b.keep<u64>(&total)
//!   }
//!   b.check(total)
//! }
//! ```
//!
//! The time that counts runs from the first call of `next` to the call that returns `false`,
//! so what comes before the loop and after it is free. [`Bencher.stop`] and [`Bencher.start`]
//! leave a stretch inside the loop out, and [`Bencher.reset`] starts the time again.
//!
//! The benchmarks of a program are the `bench` functions of the modules its entry file
//! imports, directly or through other modules of the same package. [`Benchmarks.main`] runs
//! them. A program whose `main` calls it is a harness as `silk.bench.harness` describes: run
//! by hand, it finds an iteration count for each benchmark, takes ten samples and prints
//! result lines; declared in a suite with `silk.bench.suite.Implementation.driven`, it takes
//! its iteration counts from the benchmark task, which compares it with other programs and
//! with earlier runs.
//!
//! A benchmark is named after its function. Two benchmarks with one name in different modules
//! are both named `<module>.<name>`.
//!
//! A `bench effect fn` may fail. A failure ends the run of that benchmark, which is reported as
//! failed.
//!
//! # Gotchas
//! - The compiler removes work whose result nothing uses. Give each iteration's result to
//!   [`Bencher.keep`].
//! - The compiler also computes ahead of time what it can: work on a constant is done when the
//!   program is built. Give [`Bencher.keep`] the input too, before the work reads it.
//! - `bench` marks only a top-level function with one parameter, no type parameters and no
//!   requirement row. A benchmark that needs a service provides it inside.
//! - A benchmark that never calls `next` is timed as a whole, as if its one call were every
//!   iteration.
//! - A build that does not call [`Benchmarks.main`] keeps no benchmark.
//!
//! # Examples
//! The entry file of a benchmark program:
//!
//! ```silk,ignore
//! import silk.bench.bencher { Benchmarks }
//! import silk.system.host_input { HostInput }
//!
//! // The modules that hold the `bench` functions. A name that starts with `_` is not
//! // reported as unused.
//! import parser as _parser
//! import encoder as _encoder
//!
//! pub effect fn main() -> i32
//!   ? &mut HostInput {
//!   return run Benchmarks.main()
//! }
//! ```
//!
//! @category Benchmarks

import silk.bench.harness { Harness }
import silk.bench.transport { StreamTransport, Transport, TransportError }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.num.i64
import silk.num.usize
import silk.platform.native.clock { NativeClock }
import silk.system.host_input { HostInput }
import silk.system.monotonic_clock { MonotonicClock }
import silk.system.monotonic_clock_native { OsMonotonicClock }
import silk.system.system_clock { SystemClock }
import silk.text.string { String }

// One run of a benchmark: how many iterations are left, and the time so far.
struct Run {
  remaining: u64,
  iterations: u64,
  looped: bool,
  timing: bool,
  began: u64,
  spent: u64,
  checked: bool,
  mark: u64,
}

/// The run of a benchmark that is in progress: what a `bench fn` loops on.
///
/// # Details
/// A `Bencher` is a handle to a run the benchmark program holds, so a copy of it is the same
/// run.
///
/// # Gotchas
/// A `Bencher` is good only inside the call of the benchmark it was given to.
pub struct Bencher {
  state: *mut Run,
}

impl Copy for Bencher {}

fn now() -> u64 {
  let instant = run NativeClock.now(true)
  return i64.toU64(SystemClock.seconds(&instant)) * 1000000000
    + i64.toU64(SystemClock.nanoseconds(&instant))
}

impl Bencher {
  /// Returns whether there is another iteration to do. The first call starts the time, and the
  /// call that returns `false` stops it.
  pub fn next(self: Self) -> bool {
    let mut anchor = ()
    let state = unsafe Pointer.borrowMut<(), Run>(&mut anchor, self.state)
    if !state.looped {
      state.looped = true
      state.spent = 0
      state.timing = true
      state.began = now()
    }
    if state.remaining == 0 {
      if state.timing {
        state.spent = state.spent + (now() - state.began)
        state.timing = false
      }
      return false
    }
    state.remaining = state.remaining - 1
    return true
  }

  /// Returns how many iterations the run has in all.
  pub fn iterations(self: Self) -> u64 {
    let mut anchor = ()
    let state = unsafe Pointer.borrowMut<(), Run>(&mut anchor, self.state)
    return state.iterations
  }

  /// Stops the time, until [`Bencher.start`]. Stopping twice changes nothing.
  pub fn stop(self: Self) -> () {
    let mut anchor = ()
    let state = unsafe Pointer.borrowMut<(), Run>(&mut anchor, self.state)
    if state.timing {
      state.spent = state.spent + (now() - state.began)
      state.timing = false
    }
  }

  /// Starts the time again after [`Bencher.stop`]. Starting twice changes nothing.
  pub fn start(self: Self) -> () {
    let mut anchor = ()
    let state = unsafe Pointer.borrowMut<(), Run>(&mut anchor, self.state)
    if !state.timing {
      state.timing = true
      state.began = now()
    }
  }

  /// Starts the time again from zero, after work inside the loop that should not count.
  pub fn reset(self: Self) -> () {
    let mut anchor = ()
    let state = unsafe Pointer.borrowMut<(), Run>(&mut anchor, self.state)
    state.looped = true
    state.spent = 0
    state.timing = true
    state.began = now()
  }

  /// Makes the compiler treat `value` as used, so it cannot remove the work that computed it.
  ///
  /// # Gotchas
  /// On a target without inline assembly, which is every target but Linux on x86_64 and
  /// aarch64 and macOS on aarch64, the value is only made to live in memory, which stops less.
  pub fn keep<T>(self: Self, value: &T) -> () {
    static if (Intrinsic.targetOperatingSystem() == "linux"
      && (Intrinsic.targetArchitecture() == "x86_64"
        || Intrinsic.targetArchitecture() == "aarch64"))
      || (Intrinsic.targetOperatingSystem() == "darwin"
        && Intrinsic.targetArchitecture() == "aarch64") {
      // An empty fragment that says it reads and writes memory through the address.
      unsafe Intrinsic.assembly<()>(
        "",
        "r",
        "",
        "readwrite",
        true,
        false,
        .(Pointer.fromRef<T>(value)),
      )
    } else {
      let mut anchor = ()
      let state = unsafe Pointer.borrowMut<(), Run>(&mut anchor, self.state)
      state.began = state.began + usize.toU64(Pointer.address<T>(Pointer.fromRef<T>(value)) & 0)
    }
  }

  /// Reports `number` as what the run computed, such as a checksum. A benchmark task does not
  /// compare implementations whose checks differ.
  pub fn check(self: Self, number: u64) -> () {
    let mut anchor = ()
    let state = unsafe Pointer.borrowMut<(), Run>(&mut anchor, self.state)
    state.checked = true
    state.mark = number
  }
}

struct Outcome<T> {}

interface Complete<T> {
  fn finished(value: T) -> bool
}

impl Complete<()> for Outcome<()> {
  fn finished(value: ()) -> bool {
    return true
  }
}

effect<'env> fn refused<E: 'env, 'env>(error: E) -> bool {
  drop error
  return false
}

effect<'env> fn attempted<E: 'env, 'env>(value: Effect<'env; () ! E>) -> bool
  ! E {
  run value
  return true
}

impl<'env, E> Complete<Effect<'env; () ! E>> for Outcome<Effect<'env; () ! E>> {
  fn finished(value: Effect<'env; () ! E>) -> bool {
    return run Effect.catchAll(attempted(move value), refused)
  }
}

fn outcomeOf<T>(value: &T) -> Outcome<T> {
  return Outcome<T> {}
}

fn completed<T, P: Complete<T>>(value: T, provider: P) -> bool {
  return Complete<T>.finished(move value)
}

// Calls one benchmark. Each benchmark gets its own copy of this function.
fn invoke<F>(static descriptor: Intrinsic.Test<F>, bencher: Bencher) -> bool {
  let body = Intrinsic.testFunction(descriptor)
  let value = body(bencher)
  let provider = outcomeOf(&value)
  return completed(move value, move provider)
}

// One benchmark of the catalog: where it is declared.
struct Declared {
  module: string<'static>,
  name: string<'static>,
}

// Collects the catalog. A service, so the loop over the catalog holds no loan.
service Sink {
  effect fn add(declared: Declared) -> () ! OutOfMemoryError ? &mut Sink | &mut Allocator
}

struct Catalog {
  declared: List<Declared>,
}

impl Sink for Catalog {
  effect fn add(self: &mut Self, declared: Declared) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return run self.declared.append(move declared)
  }
}

effect fn collect() -> ()
  ! OutOfMemoryError
  ? &mut Sink | &mut Allocator {
  static for descriptor in Intrinsic.benchmarks() {
    run Sink.add(
      Declared {
        module: Intrinsic.testInfo(descriptor).module,
        name: Intrinsic.testInfo(descriptor).name,
      },
    )
  }
}

// Runs the benchmark at `position` of the catalog, and returns whether it finished.
fn dispatch(position: usize, bencher: Bencher) -> bool {
  let mut at: usize = 0
  let mut finished = true
  static for descriptor in Intrinsic.benchmarks() {
    if at == position {
      finished = invoke(descriptor, bencher)
    }
    at = at + 1
  }
  return finished
}

/// The benchmarks of a program.
pub struct Benchmarks {}

impl Benchmarks {
  /// Returns the names of the benchmarks of the program, in the order they run: by module,
  /// then by name.
  ///
  /// # Errors
  /// `OutOfMemoryError` if the `Allocator` cannot supply the names.
  pub effect fn names() -> List<String>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut catalog = Catalog { declared: List<Declared>.make() }
    run collect() |> Effect.provideMut<Sink>(&mut catalog)
    let declared = catalog.declared.asSlice()
    let mut names = List<String>.make()
    let mut at: usize = 0
    while at < declared.length {
      let mut shared = false
      let mut other: usize = 0
      while other < declared.length {
        if other != at && declared[other].name == declared[at].name {
          shared = true
        }
        other = other + 1
      }
      let mut name = String.make()
      if shared {
        run name.append(declared[at].module)
        run name.append(".")
      }
      run name.append(declared[at].name)
      run names.append(move name)
      at = at + 1
    }
    return move names
  }

  /// Runs the benchmarks as a harness: driven by a benchmark task when one started the
  /// program, and otherwise alone, printing result lines.
  ///
  /// # Errors
  /// - `TransportError` if a line cannot be carried.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply a line.
  pub effect fn perform() -> ()
    ! TransportError | OutOfMemoryError
    ? &mut Transport | &mut Allocator | &mut MonotonicClock | &mut HostInput {
    let names = run Benchmarks.names()
    let views = run viewsOf(names.asSlice())
    let harness = run Harness.open(views.asSlice())
    return run served(move harness)
  }

  /// Runs the benchmarks as a harness that follows the commands arriving over the `Transport`
  /// if `driven`, and that otherwise runs every benchmark itself and sends the result lines.
  ///
  /// # Errors
  /// - `TransportError` if a line cannot be carried.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply a line.
  pub effect fn serve(driven: bool) -> ()
    ! TransportError | OutOfMemoryError
    ? &mut Transport | &mut Allocator | &mut MonotonicClock {
    let names = run Benchmarks.names()
    let views = run viewsOf(names.asSlice())
    let harness = run Harness.make(views.asSlice(), driven)
    return run served(move harness)
  }

  /// Runs the benchmarks with the standard input and output of the process, and returns the
  /// exit status: 0, or 1 if a line could not be carried.
  pub effect fn main() -> i32
    ? &mut HostInput {
    let mut allocator = Allocator.systemAllocatorProvider()
    let mut transport = StreamTransport.standard()
    let mut clock = OsMonotonicClock.make()
    return run Effect.catchAll(succeeded(), gaveUp)
      |> Effect.provideMut<Transport>(&mut transport)
      |> Effect.provideMut<MonotonicClock>(&mut clock)
      |> Effect.provideMut<Allocator>(&mut allocator)
  }
}

effect fn viewsOf<'names>(names: &'names [String]) -> List<string<'names>>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut views = List<string<'names>>.make()
  let mut at: usize = 0
  while at < names.length {
    run views.append(names[at].view())
    at = at + 1
  }
  return move views
}

// Runs each benchmark the harness asks for, and gives the harness what the run measured.
effect fn served(opened: Harness) -> ()
  ! TransportError | OutOfMemoryError
  ? &mut Transport | &mut Allocator | &mut MonotonicClock {
  let mut harness = move opened
  while run harness.next() {
    let mut state = Run {
      remaining: harness.iterations(),
      iterations: harness.iterations(),
      looped: false,
      timing: false,
      began: 0,
      spent: 0,
      checked: false,
      mark: 0,
    }
    let bencher = Bencher { state: Pointer.fromMutRef<Run>(&mut state) }
    let finished = dispatch(harness.position(), bencher)
    bencher.stop()
    if !finished {
      run harness.failed("the benchmark failed")
    } else {
      if state.looped {
        harness.measured(state.spent)
      }
      if state.checked {
        run harness.checkNumber(state.mark)
      }
    }
  }
}

effect fn succeeded() -> i32
  ! TransportError | OutOfMemoryError
  ? &mut Transport | &mut Allocator | &mut MonotonicClock | &mut HostInput {
  run Benchmarks.perform()
  return 0
}

effect fn gaveUp(error: TransportError | OutOfMemoryError) -> i32 {
  drop error
  return 1
}
