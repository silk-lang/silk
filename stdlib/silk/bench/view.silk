//! Says how the results of a benchmark suite should be shown: a kind of chart and the fields it
//! maps.
//!
//! # When to use
//! Add a [`View`] to a suite with `silk.bench.suite.Suite.view` when the default presentation
//! is not the one a reader needs: a line against an input size, a comparison against another
//! implementation than the reference, every sample of a noisy benchmark, or a chart of your
//! own kind.
//!
//! # Details
//! A view holds no numbers and no code. It names a kind and sets fields, and the report
//! resolves it into a `silk.bench.record.Chart` with every number computed, which the
//! renderers only draw.
//!
//! | Kind | Shows |
//! | --- | --- |
//! | `table` | One value for each benchmark and implementation |
//! | `ratio` | Values relative to the reference, with interval whiskers |
//! | `bars` | Absolute values with whiskers |
//! | `distribution` | Every sample, warm-up runs dimmed |
//! | `line` | A value against a parameter of the suite |
//! | `percentiles` | A value against the percentile of the samples |
//! | `history` | A value against the recorded runs of the suite |
//! | `x-<name>` | Anything: the built-in renderers show it as a table |
//!
//! The fields are the same for every kind, and a kind ignores the ones that mean nothing to it:
//!
//! | Field | Value | Default |
//! | --- | --- | --- |
//! | `y` | The unit to show, such as `ns/op`. A command suite has `ns`, `user-ns`, `sys-ns` and `peak-B` | The unit of the tables |
//! | `x` | What runs along the axis: `benchmark`, `name`, `impl`, or a parameter | `benchmark`; the parameter of a `line` |
//! | `series` | What each line or bar group is: the same choices as `x` | `impl` |
//! | `facet` | What each separate chart is | Whatever `x` and `series` leave |
//! | `stat` | `median`, `min`, `max`, `mean`, or a percentile such as `p99` | `median` |
//! | `error` | `interval` (the 95% interval of the median), `range`, or `none` | `interval` |
//! | `scale` | `linear`, `log` (the value axis), or `log-log` (both axes) | `linear` |
//! | `zero` | `true` to start the value axis at zero, `false` to fit the values | `true` |
//! | `normalize` | An implementation to divide every value by | The reference in a `ratio` |
//! | `sort` | `value` or `-value` to order the entries of `x` by their first series | The order they ran in |
//! | `title` | The heading | Written from the kind and the fields |
//!
//! A view has a text form, [`View.text`], which is one line: the kind, then `field=value`
//! pairs. A program that prints result lines may print `view: line x=size y=ns/op` to suggest
//! a view; the views a suite declares win over the ones its programs suggest.
//!
//! # Examples
//! ```silk
//! import silk.bench.view { View }
//! import silk.core.effect { Effect }
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//!
//! // A view written in the tasks program is the same as the line a program prints.
//! effect fn check() -> i32 ! OutOfMemoryError ? &mut Allocator {
//!   let mut view = run View.line("size")
//!   run view.y("ns/op")
//!   run view.logLog()
//!   let text = run view.text()
//!   if text.view() != "line x=size y=ns/op scale=log-log" {
//!     return 1
//!   }
//!   let read = run View.parse("line x=size y=ns/op scale=log-log")
//!   let again = run read.text()
//!   if again.view() != text.view() {
//!     return 2
//!   }
//!   return 0
//! }
//!
//! effect fn failed(error: OutOfMemoryError) -> i32 {
//!   drop error
//!   return 3
//! }
//!
//! pub fn main() -> i32 {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   return run Effect.catchAll(check(), failed) |> Effect.provideMut<Allocator>(&mut allocator)
//! }
//! ```
//!
//! @category Benchmarks

import silk.bench.record { Pair }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }

/// A presentation of the results of a suite: a kind of chart and the fields it maps.
///
/// # Details
/// The fields are public so a tool can read a view. Build one with the functions named after
/// the kinds, such as [`View.line`], and set fields with the methods below.
pub struct View {
  /// The kind, such as `line` or `x-flame`.
  pub kind: String,
  /// The fields that were set, in the order they were first set.
  pub fields: List<Pair>,
}

impl View {
  /// Returns a view of `kind` with no field set. A kind the report does not know is resolved
  /// like `table`, so name your own kinds `x-<name>`.
  pub effect fn of(kind: string) -> View
    ! OutOfMemoryError
    ? &mut Allocator {
    return View { kind: run String.copy(kind), fields: List<Pair>.make() }
  }

  /// Returns a view that shows one value for each benchmark and implementation as a table.
  pub effect fn table() -> View
    ! OutOfMemoryError
    ? &mut Allocator {
    return run View.of("table")
  }

  /// Returns a view that shows every implementation relative to the reference, with the
  /// interval of the ratio as whiskers.
  pub effect fn ratio() -> View
    ! OutOfMemoryError
    ? &mut Allocator {
    return run View.of("ratio")
  }

  /// Returns a view that shows absolute values as bars with whiskers.
  pub effect fn bars() -> View
    ! OutOfMemoryError
    ? &mut Allocator {
    return run View.of("bars")
  }

  /// Returns a view that shows every sample, with the warm-up runs dimmed, to check for two
  /// modes or for drift.
  pub effect fn distribution() -> View
    ! OutOfMemoryError
    ? &mut Allocator {
    return run View.of("distribution")
  }

  /// Returns a view that shows a value against the parameter `x` of the suite, such as an
  /// input size or a thread count.
  pub effect fn line(x: string) -> View
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut view = run View.of("line")
    run view.field("x", x)
    return move view
  }

  /// Returns a view that shows a value against the percentile of the samples, as a load test
  /// reads its latencies.
  ///
  /// # Details
  /// When the result lines carry units such as `p50-ns` and `p99-ns` and the view's `y` is
  /// `ns`, the chart shows what the lines report. Otherwise the percentiles are taken from the
  /// samples of `y`.
  pub effect fn percentiles() -> View
    ! OutOfMemoryError
    ? &mut Allocator {
    return run View.of("percentiles")
  }

  /// Returns a view that shows a value against the recorded runs of the suite, with the run
  /// being reported last.
  pub effect fn history() -> View
    ! OutOfMemoryError
    ? &mut Allocator {
    return run View.of("history")
  }

  /// Returns a view of the kind `x-<name>`, for a renderer of your own. The report resolves it
  /// like `table` and carries every field through, also the ones it does not know.
  pub effect fn custom(name: string) -> View
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut kind = run String.copy("x-")
    run kind.append(name)
    return View { kind: move kind, fields: List<Pair>.make() }
  }

  /// Returns the view that `text` describes: a kind, then `field=value` pairs separated by
  /// spaces. A value with spaces is written in double quotes, with `\"` for a quote inside it.
  /// Text without a kind gives a `table`.
  pub effect fn parse(text: string) -> View
    ! OutOfMemoryError
    ? &mut Allocator {
    let bytes = String.utf8Bytes(text)
    let mut view = View { kind: String.make(), fields: List<Pair>.make() }
    let mut at: usize = 0
    let mut first = true
    while at < bytes.length {
      if bytes[at] == 32 || bytes[at] == 9 {
        at = at + 1
        continue
      }
      let start = at
      while at < bytes.length && bytes[at] != 32 && bytes[at] != 9 && bytes[at] != 61 {
        at = at + 1
      }
      let word = String.slice(text, start, at - start)
      if at >= bytes.length || bytes[at] != 61 {
        if first {
          view.kind = run String.copy(word)
        }
        first = false
        continue
      }
      first = false

      // After the `=`: a quoted value, or everything up to the next space.
      at = at + 1
      let mut value = String.make()
      if at < bytes.length && bytes[at] == 34 {
        at = at + 1
        let mut from = at
        while at < bytes.length && bytes[at] != 34 {
          if bytes[at] == 92 && at + 1 < bytes.length {
            run value.append(String.slice(text, from, at - from))
            from = at + 1
            at = at + 1
          }
          at = at + 1
        }
        run value.append(String.slice(text, from, at - from))
        at = at + 1
      } else {
        let from = at
        while at < bytes.length && bytes[at] != 32 && bytes[at] != 9 {
          at = at + 1
        }
        run value.append(String.slice(text, from, at - from))
      }
      run view.field(word, value.view())
    }
    if String.byteLength(view.kind.view()) == 0 {
      view.kind = run String.copy("table")
    }
    return move view
  }

  /// Sets the field `name` to `value`, replacing what it was set to before. The methods below
  /// set the fields the report knows; this one also sets a field of your own.
  pub effect fn field(self: &mut Self, name: string, value: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let known = self.fields.asMutSlice()
    let mut at: usize = 0
    while at < known.length {
      if known[at].name.view() == name {
        known[at].value = run String.copy(value)
        return ()
      }
      at = at + 1
    }
    return run self.fields.append(
      Pair { name: run String.copy(name), value: run String.copy(value) },
    )
  }

  /// Returns what the field `name` was set to, if it was set.
  pub fn value<'view>(self: &'view Self, name: string) -> Option<string<'view>> {
    let known = self.fields.asSlice()
    let mut at: usize = 0
    while at < known.length {
      if known[at].name.view() == name {
        return Option<string<'view>>.Some { value: known[at].value.view() }
      }
      at = at + 1
    }
    return Option<string<'view>>.None
  }

  /// Sets the heading.
  pub effect fn title(self: &mut Self, text: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return run self.field("title", text)
  }

  /// Sets the unit to show, such as `ns/op` or `req/s`.
  pub effect fn y(self: &mut Self, unit: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return run self.field("y", unit)
  }

  /// Sets what runs along the axis: `benchmark`, `name`, `impl`, or the name of a parameter.
  pub effect fn x(self: &mut Self, name: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return run self.field("x", name)
  }

  /// Sets what each line or group of bars is: `impl`, `benchmark`, `name`, or the name of a
  /// parameter.
  pub effect fn series(self: &mut Self, name: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return run self.field("series", name)
  }

  /// Sets what each separate chart is: `impl`, `benchmark`, `name`, or the name of a
  /// parameter.
  pub effect fn facet(self: &mut Self, name: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return run self.field("facet", name)
  }

  /// Sets the statistic of the samples to show: `median`, `min`, `max`, `mean`, or a
  /// percentile such as `p99`.
  pub effect fn stat(self: &mut Self, name: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return run self.field("stat", name)
  }

  /// Sets what the whiskers show: `interval`, `range`, or `none`.
  pub effect fn error(self: &mut Self, name: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return run self.field("error", name)
  }

  /// Puts the value axis on a logarithmic scale.
  pub effect fn log(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return run self.field("scale", "log")
  }

  /// Puts both axes on a logarithmic scale.
  pub effect fn logLog(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return run self.field("scale", "log-log")
  }

  /// Says whether the value axis starts at zero. Without it, the axis starts at zero unless
  /// its scale is logarithmic.
  pub effect fn zero(self: &mut Self, start: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if start {
      return run self.field("zero", "true")
    }
    return run self.field("zero", "false")
  }

  /// Divides every value by the value of `implementation` in the same benchmark.
  pub effect fn normalize(self: &mut Self, implementation: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return run self.field("normalize", implementation)
  }

  /// Orders the entries of `x` by the value of their first series: `value` puts the smallest
  /// first and `-value` the largest.
  pub effect fn sort(self: &mut Self, order: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return run self.field("sort", order)
  }

  /// Returns the view as one line: the kind, then `field=value` pairs. [`View.parse`] reads it
  /// back.
  pub effect fn text(self: &Self) -> String
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut text = run String.copy(self.kind.view())
    let known = self.fields.asSlice()
    let mut at: usize = 0
    while at < known.length {
      run text.append(" ")
      run text.append(known[at].name.view())
      run text.append("=")
      let value = known[at].value.view()
      let bytes = String.utf8Bytes(value)
      let mut plain = bytes.length > 0
      let mut index: usize = 0
      while index < bytes.length {
        if bytes[index] == 32 || bytes[index] == 9 || bytes[index] == 34 || bytes[index] == 92 {
          plain = false
        }
        index = index + 1
      }
      if plain {
        run text.append(value)
      } else {
        run text.append("\"")
        let mut from: usize = 0
        index = 0
        while index < bytes.length {
          if bytes[index] == 34 || bytes[index] == 92 {
            run text.append(String.slice(value, from, index - from))
            run text.append("\\")
            from = index
          }
          index = index + 1
        }
        run text.append(String.slice(value, from, bytes.length - from))
        run text.append("\"")
      }
      at = at + 1
    }
    return move text
  }
}
