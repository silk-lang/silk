//! The data of a benchmark run: the result file with every raw sample, and the report with the
//! statistics a renderer draws.
//!
//! # When to use
//! Read a [`RunResult`] to work with the raw samples of a run, such as to compare two saved
//! runs. Read a [`Report`] to draw a run in a renderer of your own: every number a table or a
//! chart needs is already in it, so a renderer does no statistics.
//!
//! # Details
//! Both types are `silk.schema.schema.Schema` types, written as JSON with
//! `silk.schema.json.SchemaJson`. `silk.bench.bench` writes the result as
//! `build/bench/<suite>-<time>.json`, and the report wherever a suite declares an output with
//! `silk.bench.suite.Format.Report`.
//!
//! Times are nanoseconds and memory is bytes. A raw sample holds whole numbers; the statistics
//! of a report are `f64`. Dates are RFC 3339 text in UTC, such as `2026-11-19T14:03:22Z`.
//!
//! A program that prints result lines is measured by what it reports, not by its process: each
//! line is a [`Reading`], and a report gives every name the lines carry a table of its own, in
//! the unit of the lines.
//!
//! A run never drops a sample. A warm-up run is kept with `warmup` set, and a run whose program
//! failed is kept with its exit status. A report counts the failed runs of a row in `failures`
//! and leaves both kinds out of its statistics.
//!
//! # Examples
//! ```silk
//! import silk.bench.record { Report }
//! import silk.core.effect { Effect }
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.schema.issue { SchemaError }
//! import silk.schema.json { SchemaJson }
//!
//! // The fastest median of the first benchmark of a report, in nanoseconds.
//! effect fn fastest(text: &[u8]) -> f64 ! SchemaError | OutOfMemoryError ? &mut Allocator {
//!   let report = run SchemaJson.decode<Report>(text)
//!   let rows = report.benchmarks.asSlice()[0].rows.asSlice()
//!   let mut best = rows[0].median
//!   let mut at: usize = 1
//!   while at < rows.length {
//!     if rows[at].median < best {
//!       best = rows[at].median
//!     }
//!     at = at + 1
//!   }
//!   return best
//! }
//!
//! // Text that is not a report is an error, never a guess.
//! effect fn check() -> i32 ! SchemaError | OutOfMemoryError ? &mut Allocator {
//!   let best = run fastest(b"{}")
//!   if best > 0.0 {
//!     return 1
//!   }
//!   return 2
//! }
//!
//! effect fn failed(error: SchemaError | OutOfMemoryError) -> i32 {
//!   drop error
//!   return 0
//! }
//!
//! pub fn main() -> i32 {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   return run Effect.catchAll(check(), failed) |> Effect.provideMut<Allocator>(&mut allocator)
//! }
//! ```
//!
//! @category Benchmarks

import silk.collections.list { List }
import silk.core.option { Option }
import silk.schema.schema { Schema }
import silk.text.string { String }

/// The version of the result and report files this module writes.
pub const PROTOCOL: u64 = 2

/// A name with a value: a parameter of a benchmark, or a recorded environment variable.
pub struct Pair {
  /// The name.
  pub name: String,
  /// The value.
  pub value: String,
}

impl Schema for Pair {}

/// The computer a run was measured on.
pub struct Environment {
  /// The kernel name, such as `Linux` or `Darwin`.
  pub system: String,
  /// The kernel release, such as `6.8.0-45-generic`.
  pub release: String,
  /// The hardware name, such as `x86_64` or `arm64`.
  pub machine: String,
  /// The model text of the first processor, or `unknown`.
  pub processor: String,
  /// The number of logical processors online.
  pub processors: u64,
  /// The number of processors the run could use, which a container or an affinity mask lowers.
  pub usable: u64,
  /// The physical memory, in bytes.
  pub memory: u64,
  /// The 1 minute load average when the run started. A value well above 0 on an idle computer
  /// means something else was running.
  pub load: f64,
  /// The environment variables the suite asked to record.
  pub variables: List<Pair>,
}

impl Schema for Environment {}

/// One implementation of a suite, as it was run.
pub struct Subject {
  /// The name the suite gave it.
  pub name: String,
  /// The program and its arguments, as one line for a reader. Placeholders are not filled in.
  pub command: String,
  /// The revision the suite recorded for it, such as a commit hash or a version.
  pub revision: Option<String>,
}

impl Schema for Subject {}

/// One timed run of one program.
pub struct Sample {
  /// The name of the implementation.
  pub implementation: String,
  /// The round the run belongs to, from 0. Every implementation runs once in each round.
  pub round: u64,
  /// The position of the run inside its round, from 0. The order is random in each round.
  pub position: u64,
  /// Whether the run was a warm-up, which statistics leave out.
  pub warmup: bool,
  /// The time from start to exit, in nanoseconds.
  pub wall: u64,
  /// The processor time in user mode, in nanoseconds, summed over the threads of the program
  /// and the children it waited for.
  pub user: u64,
  /// The processor time in kernel mode, in nanoseconds.
  pub system: u64,
  /// The peak resident memory, in bytes.
  pub peak: u64,
  /// The exit status, or -1 when a signal ended the program.
  pub exit: i64,
  /// The signal that ended the program, or 0.
  pub signal: i64,
}

impl Schema for Sample {}

/// One value of a reading with its unit.
pub struct Metric {
  /// The unit as the program wrote it, such as `ns/op`, `B/op` or `req/s`.
  pub unit: String,
  /// The value, for one iteration.
  pub value: f64,
}

impl Schema for Metric {}

/// One sample a program reported as a result line, as `silk.bench.lines` reads it.
pub struct Reading {
  /// The name the program gave the sample, without the leading `Benchmark`.
  pub name: String,
  /// The name of the implementation whose run printed the line.
  pub implementation: String,
  /// The round of the run that printed the line, from 0.
  pub round: u64,
  /// Whether that run was a warm-up, which statistics leave out.
  pub warmup: bool,
  /// The number of iterations the sample covers.
  pub iterations: u64,
  /// The values of the sample, in the order the program wrote them.
  pub values: List<Metric>,
  /// What the program said it computed, from its last `check:` line before this one. Two
  /// implementations with different checks for one name did not do the same work.
  pub check: Option<String>,
}

impl Schema for Reading {}

/// The samples of one combination of a suite's parameters.
pub struct Measured {
  /// The name: the suite's name, then `/name=value` for each parameter.
  pub name: String,
  /// The parameters of this combination, in the order the suite declared them.
  pub parameters: List<Pair>,
  /// Every run, in the order it happened.
  pub samples: List<Sample>,
  /// Every result line the runs printed, in the order they were read. Empty when no
  /// implementation reports result lines.
  pub readings: List<Reading>,
}

impl Schema for Measured {}

/// A whole run of one suite with its raw samples: the content of a result file.
pub struct RunResult {
  /// The version of this format, [`PROTOCOL`].
  pub protocol: u64,
  /// The name of the suite.
  pub suite: String,
  /// The run's identity: its start time and a random part, safe in a file name.
  pub id: String,
  /// The label the run was given, such as `before` or `after`.
  pub label: Option<String>,
  /// The revision of the project the run measured, such as a commit hash.
  pub revision: Option<String>,
  /// When the run started, as RFC 3339 text in UTC.
  pub started: String,
  /// When the run ended, as RFC 3339 text in UTC.
  pub ended: String,
  /// The notes of the suite and of the command line.
  pub notes: List<String>,
  /// The computer the run was measured on.
  pub environment: Environment,
  /// The implementations, in the order the suite declared them.
  pub implementations: List<Subject>,
  /// The name of the implementation the others are compared to.
  pub reference: String,
  /// The number of measured rounds asked for.
  pub runs: u64,
  /// The number of warm-up rounds asked for.
  pub warmups: u64,
  /// The smallest peak memory the run could see, in bytes, or 0 when there is none. On Linux a
  /// new process starts with the peak of the process that started it, so a program that uses
  /// less memory than the benchmark task reads as the task's own peak.
  pub floor: u64,
  /// The benchmarks, one for each combination of parameters.
  pub benchmarks: List<Measured>,
}

impl Schema for RunResult {}

/// How one implementation compares to the reference on one benchmark.
pub struct Comparison {
  /// The median divided by the reference's median. For a time, 0.5 is twice as fast.
  pub value: f64,
  /// The low end of the 95% interval of the ratio.
  pub low: f64,
  /// The high end of the 95% interval of the ratio.
  pub high: f64,
  /// `faster`, `slower`, or `same` when the interval does not clear the noise threshold.
  pub verdict: String,
}

impl Schema for Comparison {}

/// The statistics of one implementation on one benchmark.
pub struct Row {
  /// The name of the implementation.
  pub implementation: String,
  /// Whether this is the reference the other rows are compared to.
  pub reference: bool,
  /// The number of values the statistics cover: the measured runs that succeeded, or the result
  /// lines those runs printed for this benchmark.
  pub runs: u64,
  /// The number of measured runs whose program failed. They are in no statistic.
  pub failures: u64,
  /// The median, in the table's unit: for process times, the time from start to exit in
  /// nanoseconds.
  pub median: f64,
  /// The smallest value, in the table's unit.
  pub minimum: f64,
  /// The largest value, in the table's unit.
  pub maximum: f64,
  /// The mean, in the table's unit.
  pub mean: f64,
  /// The low end of the 95% interval of the median, in the table's unit.
  pub low: f64,
  /// The high end of the 95% interval of the median, in the table's unit.
  pub high: f64,
  /// How many runs lie far outside the others. They are counted, never removed.
  pub outliers: u64,
  /// The median processor time in user mode, in nanoseconds. 0 in a table of result lines.
  pub user: f64,
  /// The median processor time in kernel mode, in nanoseconds. 0 in a table of result lines.
  pub system: f64,
  /// The median peak resident memory, in bytes.
  pub peak: f64,
  /// The comparison to the reference. Absent for the reference itself, for a row with no
  /// successful run, and in a table whose checks differ.
  pub ratio: Option<Comparison>,
  /// Every value the statistics cover, in the table's unit, in the order they were measured, for
  /// a renderer that draws the distribution.
  pub times: List<f64>,
  /// The median of each other unit the row's readings carry, in the order the units first
  /// appear. Empty for a table of process times.
  pub others: List<Metric>,
  /// What the implementation said it computed, when its readings carry a check.
  pub check: Option<String>,
}

impl Schema for Row {}

/// The rows of one benchmark.
pub struct Table {
  /// The name of the benchmark.
  pub name: String,
  /// The parameters of the benchmark.
  pub parameters: List<Pair>,
  /// The unit of the statistics of the rows: `ns` for the time of a whole process, or the unit
  /// of the result lines, such as `ns/op` or `req/s`.
  pub unit: String,
  /// Whether a larger value is better, as for `req/s`. A ratio above 1 is then `faster`.
  pub higher: bool,
  /// Whether two rows carry different checks. The rows then have no ratio: the implementations
  /// did not do the same work.
  pub mismatch: bool,
  /// One row for each implementation, in the order the suite declared them.
  pub rows: List<Row>,
}

impl Schema for Table {}

/// How one implementation compares to the reference over a whole suite.
pub struct Overall {
  /// The name of the implementation.
  pub implementation: String,
  /// The geometric mean of its ratios to the reference, as time: the ratio of a table where a
  /// larger value is better is inverted first, so below 1 always means faster.
  pub ratio: f64,
  /// The number of benchmarks the mean covers.
  pub benchmarks: u64,
}

impl Schema for Overall {}

/// A run of one suite with its statistics: everything a renderer draws.
pub struct Report {
  /// The version of this format, [`PROTOCOL`].
  pub protocol: u64,
  /// The name of the suite.
  pub suite: String,
  /// The run's identity, the same as in its result file.
  pub id: String,
  /// The label the run was given.
  pub label: Option<String>,
  /// The revision of the project the run measured, such as a commit hash.
  pub revision: Option<String>,
  /// When the run started, as RFC 3339 text in UTC.
  pub started: String,
  /// When the run ended, as RFC 3339 text in UTC.
  pub ended: String,
  /// The notes of the suite and of the command line.
  pub notes: List<String>,
  /// The computer the run was measured on.
  pub environment: Environment,
  /// The implementations, in the order the suite declared them.
  pub implementations: List<Subject>,
  /// The name of the implementation the others are compared to.
  pub reference: String,
  /// The noise threshold of the verdicts, as a fraction: 0.01 is 1%.
  pub noise: f64,
  /// The number of measured rounds asked for.
  pub runs: u64,
  /// The smallest peak memory the run could see, in bytes, or 0 when there is none. A row whose
  /// `peak` is not above it used at most this much.
  pub floor: u64,
  /// The benchmarks, one for each combination of parameters.
  pub benchmarks: List<Table>,
  /// The geometric mean of each implementation's ratios, without the reference. Empty when the
  /// suite has one benchmark, where the mean would repeat the ratio.
  pub overall: List<Overall>,
}

impl Schema for Report {}
