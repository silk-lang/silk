//! Describes what a benchmark run compares: suites, their implementations, the programs to
//! time, and where the reports go.
//!
//! # When to use
//! Build a [`Suite`] in a project's `tasks.silk` and give it to `silk.bench.bench.Bench.run`. A
//! suite compares implementations of one piece of work: a Silk program and the same program in
//! another language, two versions of one program, or one program with different options.
//!
//! # Details
//! A command suite, from [`Suite.command`], times whole processes: any program in any language
//! is an implementation, with nothing to adopt. An [`Implementation`] is one program with its
//! arguments. A [`Call`] is a program a hook runs without timing it: [`Suite.setup`] and
//! [`Suite.cleanup`] run once around the suite, and [`Implementation.prepare`] and
//! [`Implementation.conclude`] run around every timed run.
//!
//! Every path is a `silk.build.step.Deferred<Path>` from the build system, resolved when the
//! task runs: a package file from `Deferred<Path>.source`, a host path from
//! `Deferred<Path>.external`, or the output of a build step, such as a compilation's
//! `artifact()` or a `Run` step that builds a program in another language. The steps a suite's
//! paths come from run before anything is timed, with the build system's cache, so a second run
//! rebuilds nothing that did not change.
//!
//! A program that measures itself says so with [`Implementation.resultLines`]: the suite then
//! reads the result lines the program prints, one sample a line, and reports what the lines
//! say in their own unit, such as `ns/op` or `req/s`. A load generator, a server benchmark, or
//! a loop that times one function inside a larger program reports this way.
//!
//! [`Suite.parameter`] runs the suite once for each value: `{name}` in an argument is replaced
//! by the value, and each combination of values is its own benchmark, named
//! `suite/name=value`. [`Suite.cpus`] does the same for the number of processors a program may
//! run on, as the parameter `cpus`.
//!
//! [`Suite.output`] declares where a report goes: an [`Output`] is a [`Format`] and a place,
//! standard output or a file. A suite without outputs prints the terminal table.
//!
//! # Examples
//! ```silk,ignore
//! import silk.bench.suite { Format, Implementation, Output, Suite }
//! import silk.build.graph { BuildError, Compilation, Options }
//! import silk.build.step { Deferred }
//! import silk.mem.allocator { Allocator }
//! import silk.system.filesystem { FileSystem, Path }
//! import silk.system.host_input { HostInput }
//!
//! // Compares this package's program with a Rust build of the same work, on two inputs.
//! effect fn jsonParse(options: &Options) -> Suite
//!   ! BuildError
//!   ? &mut Allocator | &mut FileSystem | &mut HostInput {
//!   let compilation = run Compilation.fromPackage(options)
//!   let mut silk = Implementation.program(run compilation.artifact())
//!   run silk.path(run Deferred<Path>.source("data/{file}.json"))
//!
//!   let mut rust = Implementation.program(run Deferred<Path>.source("rust/target/release/parse"))
//!   run rust.path(run Deferred<Path>.source("data/{file}.json"))
//!
//!   let mut suite = run Suite.command("json-parse")
//!   run suite.implementation("silk", move silk)
//!   run suite.implementation("rust", move rust)
//!   run suite.reference("rust")
//!   run suite.parameter("file", &["twitter", "canada"])
//!   run suite.output(Output.stdout(Format.Terminal))
//!   run suite.output(Output.file(run Deferred<Path>.source("build/bench/json.html"), Format.Html))
//!   return move suite
//! }
//! ```
//!
//! @category Benchmarks

import silk.bench.record { Pair }
import silk.build.step { Deferred, StepError, StepFailure }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.executable as Executable
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.system.host_input { HostInput, HostInputError }
import silk.text.string { String }

/// One argument of a [`Call`]: text, or a path the build system resolves.
pub union Part {
  /// Text passed as it is, after `{name}` placeholders are replaced.
  Text { pub value: String },
  /// A path, passed as the absolute path it resolves to.
  Location { pub path: Deferred<Path> },
}

/// A program with its arguments, working directory, and environment.
///
/// # Details
/// A call inherits the environment of the task and adds the variables set with
/// [`Call.variable`]. Without [`Call.directory`], it runs in the package directory.
pub struct Call {
  /// The program.
  pub executable: Deferred<Path>,
  /// The arguments, in order.
  pub parts: List<Part>,
  /// The working directory, if the call sets one.
  pub workingDirectory: Option<Deferred<Path>>,
  /// The environment variables the call adds.
  pub variables: List<Pair>,
}

impl Call {
  /// Returns a call of the program at `program`, with no arguments.
  pub fn program(program: Deferred<Path>) -> Call {
    return Call {
      executable: move program,
      parts: List<Part>.make(),
      workingDirectory: Option<Deferred<Path>>.None,
      variables: List<Pair>.make(),
    }
  }

  /// Returns a call of the program named `name`, found now: on `PATH` for a name without a
  /// `/`, or as a path relative to the package directory.
  ///
  /// # Errors
  /// `StepError` if no such program exists.
  pub effect fn command(name: string) -> Call
    ! StepFailure | FileError | HostInputError | OutOfMemoryError
    ? &mut HostInput | &mut Allocator | &mut FileSystem {
    let found = match move run Executable.find(name) {
      Option<Path>.Some { value } => move value
      Option<Path>.None => {
        let mut message = run String.copy("cannot find the program ")
        run message.append(name)
        fail StepError { message: move message }
      }
    }
    let text = match Path.view(&found) {
      Option<string>.Some { value } => value
      Option<string>.None => {
        fail StepError { message: run String.copy("a program path must be UTF-8") }
      }
    }
    return Call.program(run Deferred<Path>.external(text))
  }

  /// Adds the argument `value`. `{name}` in it is replaced by the value of the suite parameter
  /// `name`.
  pub effect fn argument(self: &mut Self, value: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return run self.parts.append(Part.Text { value: run String.copy(value) })
  }

  /// Adds each of `values` as an argument, as [`Call.argument`] does.
  pub effect fn arguments(self: &mut Self, values: &[string]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut at: usize = 0
    while at < values.length {
      run self.argument(values[at])
      at = at + 1
    }
  }

  /// Adds an argument that is the absolute path `value` resolves to. The step that produces
  /// the path, if any, runs before the suite is timed.
  pub effect fn path(self: &mut Self, value: Deferred<Path>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return run self.parts.append(Part.Location { path: move value })
  }

  /// Sets the working directory.
  pub fn directory(self: &mut Self, value: Deferred<Path>) -> () {
    self.workingDirectory = Option<Deferred<Path>>.Some { value: move value }
  }

  /// Sets the environment variable `name` to `value` for the program.
  pub effect fn variable(self: &mut Self, name: string, value: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return run self.variables.append(
      Pair { name: run String.copy(name), value: run String.copy(value) },
    )
  }
}

/// One program a suite times, with the hooks around each of its runs.
pub struct Implementation {
  /// The program that is timed.
  pub call: Call,
  /// The calls that run before every timed run, without being timed.
  pub before: List<Call>,
  /// The calls that run after every timed run, without being timed.
  pub after: List<Call>,
  /// The revision recorded for the implementation.
  pub version: Option<String>,
  /// Whether the program prints result lines, which then are what the suite measures.
  pub reports: bool,
}

impl Implementation {
  /// Returns an implementation that times `call`.
  pub fn of(call: Call) -> Implementation {
    return Implementation {
      call: move call,
      before: List<Call>.make(),
      after: List<Call>.make(),
      version: Option<String>.None,
      reports: false,
    }
  }

  /// Returns an implementation that times the program at `program`, such as a compilation's
  /// `artifact()` or the output of a `Run` step.
  pub fn program(program: Deferred<Path>) -> Implementation {
    return Implementation.of(Call.program(move program))
  }

  /// Returns an implementation that times the program named `name`, found as [`Call.command`]
  /// finds it.
  ///
  /// # Errors
  /// `StepError` if no such program exists.
  pub effect fn command(name: string) -> Implementation
    ! StepFailure | FileError | HostInputError | OutOfMemoryError
    ? &mut HostInput | &mut Allocator | &mut FileSystem {
    return Implementation.of(run Call.command(name))
  }

  /// Adds the argument `value`, as [`Call.argument`] does.
  pub effect fn argument(self: &mut Self, value: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return run self.call.argument(value)
  }

  /// Adds each of `values` as an argument, as [`Call.argument`] does.
  pub effect fn arguments(self: &mut Self, values: &[string]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return run self.call.arguments(values)
  }

  /// Adds an argument that is a resolved path, as [`Call.path`] does.
  pub effect fn path(self: &mut Self, value: Deferred<Path>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return run self.call.path(move value)
  }

  /// Sets the working directory of the timed program.
  pub fn directory(self: &mut Self, value: Deferred<Path>) -> () {
    self.call.directory(move value)
  }

  /// Sets the environment variable `name` to `value` for the timed program.
  pub effect fn variable(self: &mut Self, name: string, value: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return run self.call.variable(name, value)
  }

  /// Adds a call that runs before every timed run of this implementation, such as one that
  /// removes a cache. It is not timed. A call that fails stops the run.
  pub effect fn prepare(self: &mut Self, call: Call) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return run self.before.append(move call)
  }

  /// Adds a call that runs after every timed run of this implementation. It is not timed. A
  /// call that fails stops the run.
  pub effect fn conclude(self: &mut Self, call: Call) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return run self.after.append(move call)
  }

  /// Records `text` as the revision of this implementation, such as a commit hash or a version
  /// number, so a report says what was measured.
  pub effect fn revision(self: &mut Self, text: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.version = Option<String>.Some { value: run String.copy(text) }
  }

  /// Says that the program prints result lines, as `silk.bench.lines` describes them, and that
  /// the suite measures what those lines report, not the time of the process.
  ///
  /// # Details
  /// Each line is one sample of the benchmark its name gives, so one run of the program may
  /// report many benchmarks and many samples of each. The program writes the lines to standard
  /// output, or to the file the environment variable `BENCH_OUT` names, which the suite sets
  /// for every timed run. Lines that are not result lines are ignored.
  ///
  /// The suite reads three configuration keys. `check:` says what the program computed, such
  /// as a checksum or a count: implementations whose checks differ for one benchmark are not
  /// compared, and the task fails. `revision:` is recorded as the implementation's revision
  /// when the suite gives none. `note:` is added to the notes of the run.
  pub fn resultLines(self: &mut Self) -> () {
    self.reports = true
  }
}

/// How a report is written.
pub enum Format {
  /// The table for a terminal, of `silk.bench.render.Render.terminal`. It has color when it
  /// goes to a terminal that takes it.
  Terminal,
  /// Markdown, of `silk.bench.render.Render.markdown`.
  Markdown,
  /// One static HTML page with charts, of `silk.bench.html.Html.page`.
  Html,
  /// The report with its statistics as JSON, a `silk.bench.record.Report`, for a renderer of
  /// your own.
  Report,
  /// The raw samples as JSON, a `silk.bench.record.RunResult`.
  Result,
  /// The samples as result lines, of `silk.bench.lines.Lines.fromResult`, the text format of
  /// Go's `testing` package that tools such as `benchstat` read.
  Lines,
  /// One line for each row of the report, of `silk.bench.history.History.lines`, to add to a
  /// history file with [`Output.appending`].
  History,
}

/// Where a report goes.
pub union Destination {
  /// Standard output.
  Stdout,
  /// A file. Its directories are made when they are missing.
  File { pub path: Deferred<Path>, pub append: bool },
}

/// One report of a suite: a format and a destination.
pub struct Output {
  /// How the report is written.
  pub format: Format,
  /// Where it goes.
  pub destination: Destination,
}

impl Output {
  /// Returns an output that prints the report in `format` on standard output.
  pub fn stdout(format: Format) -> Output {
    return Output { format: format, destination: Destination.Stdout }
  }

  /// Returns an output that writes the report in `format` to the file at `path`, replacing it.
  pub fn file(path: Deferred<Path>, format: Format) -> Output {
    return Output {
      format: format,
      destination: Destination.File { path: move path, append: false },
    }
  }

  /// Returns `self` writing to the end of its file instead of replacing it, for a log that
  /// grows with every run. An output to standard output is returned as it is.
  pub fn appending(self: Self) -> Output {
    let Output { format, destination } = move self
    return match move destination {
      Destination.File { path, append: _ } => Output {
        format: format,
        destination: Destination.File { path: move path, append: true },
      }
      Destination.Stdout => Output { format: format, destination: Destination.Stdout }
    }
  }
}

/// A parameter of a suite: a name and the values the suite runs with.
pub struct Parameter {
  /// The name, which `{name}` in an argument refers to.
  pub name: String,
  /// The values, in the order they run.
  pub values: List<String>,
}

/// An implementation with the name a suite gave it.
pub struct Named {
  /// The name.
  pub name: String,
  /// The implementation.
  pub implementation: Implementation,
}

/// A set of implementations of the same work, compared to each other.
///
/// # Details
/// The fields are public so a tool can read a suite. Build one with [`Suite.command`] and the
/// methods below.
pub struct Suite {
  /// The name, which starts the name of each of its benchmarks and of its result file.
  pub name: String,
  /// The implementations, in the order they were added.
  pub implementations: List<Named>,
  /// The name of the implementation the others are compared to. Without one, it is the first.
  pub baseline: Option<String>,
  /// The parameters, in the order they were added.
  pub parameters: List<Parameter>,
  /// The processor counts to run with. Empty means no limit.
  pub processors: List<u32>,
  /// The number of measured rounds, if the suite sets it.
  pub rounds: Option<u64>,
  /// The number of warm-up rounds, if the suite sets it.
  pub warmups: Option<u64>,
  /// The notes recorded with every run.
  pub notes: List<String>,
  /// The environment variables whose values are recorded with every run.
  pub recorded: List<String>,
  /// The calls that run once before anything is timed.
  pub before: List<Call>,
  /// The calls that run once after everything is timed.
  pub after: List<Call>,
  /// The reports. Empty means the terminal table on standard output.
  pub outputs: List<Output>,
}

impl Suite {
  /// Returns an empty suite named `name` that times whole processes. `name` becomes part of
  /// file names, so use letters, digits, `-`, `_` and `.`.
  pub effect fn command(name: string) -> Suite
    ! OutOfMemoryError
    ? &mut Allocator {
    return Suite {
      name: run String.copy(name),
      implementations: List<Named>.make(),
      baseline: Option<String>.None,
      parameters: List<Parameter>.make(),
      processors: List<u32>.make(),
      rounds: Option<u64>.None,
      warmups: Option<u64>.None,
      notes: List<String>.make(),
      recorded: List<String>.make(),
      before: List<Call>.make(),
      after: List<Call>.make(),
      outputs: List<Output>.make(),
    }
  }

  /// Adds `implementation` under `name`. Names must differ inside a suite.
  pub effect fn implementation(self: &mut Self, name: string, implementation: Implementation) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return run self.implementations.append(
      Named { name: run String.copy(name), implementation: move implementation },
    )
  }

  /// Names the implementation the others are compared to. Without it, the first one added is
  /// the reference.
  pub effect fn reference(self: &mut Self, name: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    self.baseline = Option<String>.Some { value: run String.copy(name) }
  }

  /// Adds the parameter `name` with `values`. The suite runs once for each value, and once for
  /// each combination when it has several parameters.
  pub effect fn parameter(self: &mut Self, name: string, values: &[string]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut copies = List<String>.make()
    let mut at: usize = 0
    while at < values.length {
      run copies.append(run String.copy(values[at]))
      at = at + 1
    }
    return run self.parameters.append(
      Parameter { name: run String.copy(name), values: move copies },
    )
  }

  /// Runs the suite once for each of `counts`, with every program limited to that many
  /// processors, as the parameter `cpus`. The limit is an affinity mask over the first
  /// processors the task may use.
  ///
  /// # Gotchas
  /// Only Linux can limit processors. On another system, a suite with this setting fails
  /// before anything is timed.
  pub effect fn cpus(self: &mut Self, counts: &[u32]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return run self.processors.appendSlice(counts)
  }

  /// Sets the number of measured rounds. Every implementation runs once in each round, in a
  /// random order. The default is 10. `--runs` on the command line wins.
  pub fn runs(self: &mut Self, count: u64) -> () {
    self.rounds = Option<u64>.Some { value: count }
  }

  /// Sets the number of warm-up rounds, which fill caches before the measured rounds and are
  /// in no statistic. The default is 1. `--warmup` on the command line wins.
  pub fn warmup(self: &mut Self, count: u64) -> () {
    self.warmups = Option<u64>.Some { value: count }
  }

  /// Records `text` with every run of the suite, such as what a reader should know about the
  /// setup.
  pub effect fn note(self: &mut Self, text: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return run self.notes.append(run String.copy(text))
  }

  /// Records the value of the environment variable `name` with every run.
  pub effect fn record(self: &mut Self, name: string) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return run self.recorded.append(run String.copy(name))
  }

  /// Adds a call that runs once before anything is timed. A call that fails stops the run.
  pub effect fn setup(self: &mut Self, call: Call) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return run self.before.append(move call)
  }

  /// Adds a call that runs once after everything is timed, also when a run failed.
  pub effect fn cleanup(self: &mut Self, call: Call) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return run self.after.append(move call)
  }

  /// Adds a report. A suite with at least one output prints nothing else: add
  /// `Output.stdout(Format.Terminal)` to keep the table.
  pub effect fn output(self: &mut Self, output: Output) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return run self.outputs.append(move output)
  }
}
