//! The statistics a benchmark report is made of: medians, bootstrap intervals, ratios between
//! two sets of samples, and the verdict a ratio supports.
//!
//! # When to use
//! Use these functions to summarize samples you measured yourself, or to write a renderer that
//! needs a number `silk.bench.report` does not compute. A suite run by `silk.bench.bench` already
//! has them applied.
//!
//! # Details
//! A summary is built on the median, because a few slow runs on a busy computer move a mean far
//! more than they move a median. An interval is a 95% percentile bootstrap: the samples are drawn
//! again with replacement many times, and the interval holds the middle 95% of the medians that
//! come out. The draws use a fixed seed, so the same samples always give the same interval.
//!
//! A ratio compares a candidate to a reference: 0.5 means the candidate took half the time. Its
//! interval comes from drawing both sides again. A [`Verdict`] calls a difference only when the
//! whole interval is beyond the noise threshold, so a ratio of 0.99 with an interval of 0.97 to
//! 1.01 is `Same`.
//!
//! # Examples
//! ```silk
//! import silk.bench.statistics { Statistics, Verdict }
//! import silk.collections.list { List }
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//!
//! effect fn compare() -> bool ! OutOfMemoryError ? &mut Allocator {
//!   let mut fast = List<f64>.make()
//!   let mut slow = List<f64>.make()
//!   let mut at: usize = 0
//!   while at < 10 {
//!     run fast.append(100.0 + usize.toF64(at))
//!     run slow.append(200.0 + usize.toF64(at))
//!     at = at + 1
//!   }
//!   let ratio = run Statistics.ratio(fast.asSlice(), slow.asSlice(), 0.01)
//!   return ratio.verdict == Verdict.Faster
//! }
//!
//! pub effect fn main() -> i32 {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let faster = run compare().ignoreError() |> Effect.provideMut<Allocator>(&mut allocator)
//!   return 0
//! }
//! ```
//!
//! @category Benchmarks

import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f64
import silk.num.u64
import silk.num.usize

// How many times a bootstrap draws the samples again.
const RESAMPLES: usize = 2000

// The seed of every bootstrap, so a report does not change when it is made again.
const SEED: u64 = 0x9E3779B97F4A7C15

/// What a ratio to a reference supports.
pub enum Verdict {
  /// The whole interval is below the noise threshold: the candidate is faster.
  Faster,
  /// The whole interval is above the noise threshold: the candidate is slower.
  Slower,
  /// The interval reaches into the noise threshold: no difference was found.
  Same,
}

/// The summary of one set of samples.
pub struct Summary {
  /// The number of samples.
  pub count: usize,
  /// The median.
  pub median: f64,
  /// The smallest sample.
  pub minimum: f64,
  /// The largest sample.
  pub maximum: f64,
  /// The arithmetic mean.
  pub mean: f64,
  /// The low end of the 95% bootstrap interval of the median.
  pub low: f64,
  /// The high end of the 95% bootstrap interval of the median.
  pub high: f64,
  /// How many samples lie more than 1.5 interquartile ranges outside the quartiles. They are
  /// counted, never removed.
  pub outliers: usize,
}

impl Copy for Summary {}

/// A candidate's median divided by a reference's median, with its interval and verdict.
pub struct Ratio {
  /// The ratio of the medians. Below 1 means the candidate's values are smaller.
  pub value: f64,
  /// The low end of the 95% bootstrap interval.
  pub low: f64,
  /// The high end of the 95% bootstrap interval.
  pub high: f64,
  /// What the interval supports at the noise threshold the ratio was made with.
  pub verdict: Verdict,
}

impl Copy for Ratio {}

// SplitMix64: small, fast, and good enough to pick sample indexes.
struct Draws {
  state: u64,
}

impl Draws {
  fn next(self: &mut Self) -> u64 {
    self.state = u64.wrappingAdd(self.state, 0x9E3779B97F4A7C15)
    let mut mixed = self.state
    mixed = u64.wrappingMultiply(u64.bitXor(mixed, u64.shiftRight(mixed, 30)), 0xBF58476D1CE4E5B9)
    mixed = u64.wrappingMultiply(u64.bitXor(mixed, u64.shiftRight(mixed, 27)), 0x94D049BB133111EB)
    return u64.bitXor(mixed, u64.shiftRight(mixed, 31))
  }

  fn below(self: &mut Self, count: usize) -> usize {
    return u64.toUsize(self.next() % usize.toU64(count))
  }
}

/// The owner type of the statistics functions. It has no fields and is never constructed.
pub struct Statistics {}

impl Statistics {
  /// Returns the median of `sorted`, which must be in ascending order, or 0 for no samples.
  pub fn medianOfSorted(sorted: &[f64]) -> f64 {
    return Statistics.quantileOfSorted(sorted, 0.5)
  }

  /// Returns the value at `fraction` (0 to 1) of `sorted`, which must be in ascending order,
  /// between neighbors in a straight line. Returns 0 for no samples.
  pub fn quantileOfSorted(sorted: &[f64], fraction: f64) -> f64 {
    if sorted.length == 0 {
      return 0.0
    }
    let position = fraction * usize.toF64(sorted.length - 1)
    let below = f64.toUsize(f64.floor(position))
    if below + 1 >= sorted.length {
      return sorted[sorted.length - 1]
    }
    let weight = position - usize.toF64(below)
    return sorted[below] + (sorted[below + 1] - sorted[below]) * weight
  }

  /// Returns the median of `samples`, in any order, or 0 for no samples.
  ///
  /// # Errors
  /// `OutOfMemoryError` if the `Allocator` cannot supply the sorted copy.
  pub effect fn median(samples: &[f64]) -> f64
    ! OutOfMemoryError
    ? &mut Allocator {
    let sorted = run sortedCopy(samples)
    return Statistics.medianOfSorted(sorted.asSlice())
  }

  /// Returns the summary of `samples`: count, median, extremes, mean, the 95% bootstrap interval
  /// of the median, and the number of outliers. Every field is 0 for no samples.
  ///
  /// # Errors
  /// `OutOfMemoryError` if the `Allocator` cannot supply the working copies.
  pub effect fn summary(samples: &[f64]) -> Summary
    ! OutOfMemoryError
    ? &mut Allocator {
    if samples.length == 0 {
      return Summary {
        count: 0,
        median: 0.0,
        minimum: 0.0,
        maximum: 0.0,
        mean: 0.0,
        low: 0.0,
        high: 0.0,
        outliers: 0,
      }
    }
    let sorted = run sortedCopy(samples)
    let values = sorted.asSlice()
    let mut total = 0.0
    let mut at: usize = 0
    while at < values.length {
      total = total + values[at]
      at = at + 1
    }
    let lowerQuartile = Statistics.quantileOfSorted(values, 0.25)
    let upperQuartile = Statistics.quantileOfSorted(values, 0.75)
    let reach = (upperQuartile - lowerQuartile) * 1.5
    let mut outliers: usize = 0
    at = 0
    while at < values.length {
      if values[at] < lowerQuartile - reach || values[at] > upperQuartile + reach {
        outliers = outliers + 1
      }
      at = at + 1
    }
    let mut draws = Draws { state: SEED }
    let mut medians = run List<f64>.makeWithCapacity(RESAMPLES)
    let mut drawn = run List<f64>.makeWithCapacity(values.length)
    let mut round: usize = 0
    while round < RESAMPLES {
      run medians.append(run resampledMedian(values, &mut drawn, &mut draws))
      round = round + 1
    }
    sortInPlace(medians.asMutSlice())
    return Summary {
      count: values.length,
      median: Statistics.medianOfSorted(values),
      minimum: values[0],
      maximum: values[values.length - 1],
      mean: total / usize.toF64(values.length),
      low: Statistics.quantileOfSorted(medians.asSlice(), 0.025),
      high: Statistics.quantileOfSorted(medians.asSlice(), 0.975),
      outliers: outliers,
    }
  }

  /// Returns the median of `candidate` divided by the median of `reference`, with its 95%
  /// bootstrap interval and the verdict at the noise threshold `noise`, a fraction such as 0.01
  /// for 1%.
  ///
  /// # Details
  /// The verdict is `Faster` when the whole interval is below `1 - noise`, `Slower` when it is
  /// above `1 + noise`, and `Same` otherwise. With no samples on either side, or a reference
  /// median of 0, the ratio is 1 and the verdict is `Same`.
  ///
  /// # Errors
  /// `OutOfMemoryError` if the `Allocator` cannot supply the working copies.
  pub effect fn ratio(candidate: &[f64], reference: &[f64], noise: f64) -> Ratio
    ! OutOfMemoryError
    ? &mut Allocator {
    let same = Ratio { value: 1.0, low: 1.0, high: 1.0, verdict: Verdict.Same }
    if candidate.length == 0 || reference.length == 0 {
      return same
    }
    let top = run sortedCopy(candidate)
    let bottom = run sortedCopy(reference)
    let base = Statistics.medianOfSorted(bottom.asSlice())
    if base <= 0.0 {
      return same
    }
    let mut draws = Draws { state: SEED }
    let mut ratios = run List<f64>.makeWithCapacity(RESAMPLES)
    let mut drawn = run List<f64>.makeWithCapacity(top.length() + bottom.length())
    let mut round: usize = 0
    while round < RESAMPLES {
      let above = run resampledMedian(top.asSlice(), &mut drawn, &mut draws)
      let below = run resampledMedian(bottom.asSlice(), &mut drawn, &mut draws)
      if below > 0.0 {
        run ratios.append(above / below)
      }
      round = round + 1
    }
    sortInPlace(ratios.asMutSlice())
    let low = Statistics.quantileOfSorted(ratios.asSlice(), 0.025)
    let high = Statistics.quantileOfSorted(ratios.asSlice(), 0.975)
    let mut verdict = Verdict.Same
    if high < 1.0 - noise {
      verdict = Verdict.Faster
    } else if low > 1.0 + noise {
      verdict = Verdict.Slower
    }
    return Ratio {
      value: Statistics.medianOfSorted(top.asSlice()) / base,
      low: low,
      high: high,
      verdict: verdict,
    }
  }

  /// Returns the geometric mean of `ratios`, the right mean for ratios: a suite that is twice as
  /// fast on one benchmark and half as fast on another comes out at 1. Returns 1 for no ratios.
  /// Ratios that are not positive are left out.
  pub fn geometricMean(ratios: &[f64]) -> f64 {
    let mut total = 0.0
    let mut count: usize = 0
    let mut at: usize = 0
    while at < ratios.length {
      if ratios[at] > 0.0 {
        total = total + f64.log(ratios[at])
        count = count + 1
      }
      at = at + 1
    }
    if count == 0 {
      return 1.0
    }
    return f64.exp(total / usize.toF64(count))
  }
}

effect fn sortedCopy(samples: &[f64]) -> List<f64>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut copy = run List<f64>.makeWithCapacity(samples.length)
  run copy.appendSlice(samples)
  sortInPlace(copy.asMutSlice())
  return move copy
}

// Draws `values.length` samples with replacement and returns their median. `drawn` is scratch.
effect fn resampledMedian(values: &[f64], drawn: &mut List<f64>, draws: &mut Draws) -> f64
  ! OutOfMemoryError
  ? &mut Allocator {
  drawn.clear()
  let mut at: usize = 0
  while at < values.length {
    run drawn.append(values[draws.below(values.length)])
    at = at + 1
  }
  sortInPlace(drawn.asMutSlice())
  return Statistics.medianOfSorted(drawn.asSlice())
}

// Shell sort: in place, no allocation, and fast for the few thousand values a bootstrap sorts.
fn sortInPlace(values: &mut [f64]) -> () {
  let mut gap = values.length / 2
  while gap > 0 {
    let mut at = gap
    while at < values.length {
      let held = values[at]
      let mut slot = at
      while slot >= gap && values[slot - gap] > held {
        values[slot] = values[slot - gap]
        slot = slot - gap
      }
      values[slot] = held
      at = at + 1
    }
    gap = gap / 2
  }
}
