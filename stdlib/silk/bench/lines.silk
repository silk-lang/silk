//! Benchmark result lines: the text format of Go's `testing` package, read and written.
//!
//! # When to use
//! Use [`Lines.parse`] to read the samples a benchmark program printed, in any language, and
//! [`Lines.fromResult`] to hand a run to a tool that reads the format, such as `benchstat`. A
//! program that prints these lines needs no library: one `printf` per sample is enough.
//!
//! # Details
//! A result line is one sample: a name, the number of iterations the sample covers, then one
//! or more pairs of a value and a unit. Values are for one iteration.
//!
//! ```text
//! impl: simdjson
//! BenchmarkParse/file=twitter 2000 165412 ns/op 1024 B/op
//! BenchmarkParse/file=twitter 2000 164980 ns/op 1024 B/op
//! ```
//!
//! A name starts with `Benchmark`, and the character after it is not a lowercase letter. A
//! configuration line is `key: value`, where the key starts with a lowercase letter and has no
//! space and no uppercase letter. It applies to every result line after it, until a line with
//! the same key replaces it. Every other line is ignored, so a program may print anything else.
//! Letters are judged as ASCII: a byte outside ASCII counts as lowercase.
//!
//! A sample is never summarized by the program that prints it. It prints the line again for
//! the next sample, and `silk.bench.statistics` computes every statistic.
//!
//! # Examples
//! ```silk
//! import silk.bench.lines { Lines }
//! import silk.core.effect { Effect }
//! import silk.core.option { Option }
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//!
//! effect fn check() -> i32 ! OutOfMemoryError ? &mut Allocator {
//!   let parsed = run Lines.parse("impl: silk\nBenchmarkParse 2000 165412 ns/op\nok 0.4s\n")
//!   let lines = parsed.lines.asSlice()
//!   if lines.length != 1 || lines[0].iterations != 2000 {
//!     return 1
//!   }
//!   return match Lines.value(&lines[0], "ns/op") {
//!     Option<f64>.Some { value } => if value == 165412.0 { 0 } else { 2 }
//!     Option<f64>.None => 3
//!   }
//! }
//!
//! effect fn failed(error: OutOfMemoryError) -> i32 {
//!   drop error
//!   return 4
//! }
//!
//! pub fn main() -> i32 {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   return run Effect.catchAll(check(), failed) |> Effect.provideMut<Allocator>(&mut allocator)
//! }
//! ```
//!
//! @category Benchmarks

import silk.bench.record { Measured, RunResult, Sample }
import silk.bench.units { Units }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.f64
import silk.num.u8
import silk.num.u64
import silk.num.usize
import silk.text.format { Format, ParseError }
import silk.text.string { InvalidUtf8, String }

/// One measured value of a sample with its unit.
pub struct Value {
  /// The value, for one iteration.
  pub value: f64,
  /// The unit as the program wrote it, such as `ns/op`, `B/op` or `MB/s`.
  pub unit: String,
}

/// One configuration line.
pub struct Setting {
  /// The key, without the colon.
  pub name: String,
  /// The value, without the space around it.
  pub value: String,
  /// The index in [`Parsed.lines`] of the first result line after this one. The setting applies
  /// from that line on.
  pub from: usize,
}

/// One result line: one sample.
pub struct Line {
  /// The whole name, starting with `Benchmark`.
  pub name: String,
  /// The number of iterations the sample covers.
  pub iterations: u64,
  /// The values, in the order they were written. There is at least one.
  pub values: List<Value>,
}

/// What a text held: its result lines and its configuration lines.
pub struct Parsed {
  /// The configuration lines, in the order they were written.
  pub settings: List<Setting>,
  /// The result lines, in the order they were written.
  pub lines: List<Line>,
}

/// The owner type of the result line functions. It has no fields and is never constructed.
pub struct Lines {}

impl Lines {
  /// Returns the result lines and configuration lines of `text`. A line that is neither is
  /// ignored, and so is a line that starts like a result but has a part that does not parse,
  /// such as a value that is not a number or a value with no unit.
  ///
  /// # Errors
  /// `OutOfMemoryError` if the `Allocator` cannot supply the lines.
  pub effect fn parse(text: string) -> Parsed
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut parsed = Parsed { settings: List<Setting>.make(), lines: List<Line>.make() }
    let bytes = String.utf8Bytes(text)
    let mut start: usize = 0
    while start < bytes.length {
      let mut end = start
      while end < bytes.length && bytes[end] != 10 {
        end = end + 1
      }
      let line = String.slice(text, start, end - start)
      if !(run result(&mut parsed, line)) {
        run setting(&mut parsed, line)
      }
      start = end + 1
    }
    return move parsed
  }

  /// Returns the value of the configuration key `name` that applies to the result line at index
  /// `at`: the last one written before that line. It is `None` when no line before it sets the
  /// key.
  pub fn setting<'parsed>(parsed: &'parsed Parsed, at: usize, name: string) -> Option<
    string<'parsed>
  > {
    let settings = parsed.settings.asSlice()
    let mut index = settings.length
    while index > 0 {
      index = index - 1
      if settings[index].from <= at && settings[index].name.view() == name {
        return Option<string<'parsed>>.Some { value: settings[index].value.view() }
      }
    }
    return Option<string<'parsed>>.None
  }

  /// Returns the value of `line` with the unit `unit`, or `None` when the line has none. When a
  /// line repeats a unit, the first one is returned.
  pub fn value(line: &Line, unit: string) -> Option<f64> {
    let values = line.values.asSlice()
    let mut at: usize = 0
    while at < values.length {
      if values[at].unit.view() == unit {
        return Option<f64>.Some { value: values[at].value }
      }
      at = at + 1
    }
    return Option<f64>.None
  }

  /// Returns the name a benchmark of a suite has as a result line: `Benchmark`, then `name` with
  /// its first letter in uppercase and every space replaced by `_`. `parse/file=twitter` becomes
  /// `BenchmarkParse/file=twitter`.
  ///
  /// # Errors
  /// `OutOfMemoryError` if the `Allocator` cannot supply the text.
  pub effect fn named(name: string) -> String
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut text = run String.copy("Benchmark")
    let bytes = String.utf8Bytes(name)
    let mut at: usize = 0
    let mut piece: usize = 0
    while at < bytes.length {
      let byte = bytes[at]
      let first = at == 0 && byte >= 97 && byte <= 122
      if first || byte == 32 || byte == 9 {
        run text.append(String.slice(name, piece, at - piece))
        if first {
          run text.append(String.slice(UPPER, u8.toUsize(byte - 97), 1))
        } else {
          run text.append("_")
        }
        piece = at + 1
      }
      at = at + 1
    }
    run text.append(String.slice(name, piece, bytes.length - piece))
    return move text
  }

  /// Returns the samples of `result` as result lines, for a tool that reads the format.
  ///
  /// Each implementation is a block that starts with the configuration line `impl: <name>` and,
  /// when it has a revision, `revision:`, after the lines `suite:`, `date:` and, when the run
  /// has one, `label:`. Each measured run
  /// that succeeded is one line with 1 iteration and the units `ns/op` (time from start to
  /// exit), `user-ns/op`, `sys-ns/op` and `peak-B`. Warm-up runs and failed runs are left out.
  ///
  /// Where the programs printed result lines themselves, those lines are written in place of
  /// the process times, as they were read, with the parameters of their combination added to
  /// the name.
  ///
  /// # Errors
  /// `OutOfMemoryError` if the `Allocator` cannot supply the text.
  pub effect fn fromResult(result: &RunResult) -> String
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut text = String.make()
    run text.append("suite: ")
    run text.append(result.suite.view())
    run text.append("\ndate: ")
    run text.append(result.started.view())
    run text.append("\n")
    if let Option<String>.Some { value } = &result.label {
      run text.append("label: ")
      run text.append(value.view())
      run text.append("\n")
    }
    let subjects = result.implementations.asSlice()
    let measured = result.benchmarks.asSlice()
    let mut subject: usize = 0
    while subject < subjects.length {
      run text.append("\nimpl: ")
      run text.append(subjects[subject].name.view())
      run text.append("\n")
      if let Option<String>.Some { value } = &subjects[subject].revision {
        run text.append("revision: ")
        run text.append(value.view())
        run text.append("\n")
      }
      let mut at: usize = 0
      while at < measured.length {
        if measured[at].readings.length() > 0 {
          run reported(&mut text, result, &measured[at], subjects[subject].name.view())
        } else {
          run block(&mut text, &measured[at], subjects[subject].name.view())
        }
        at = at + 1
      }
      subject = subject + 1
    }
    return move text
  }
}

const UPPER: string<'static> = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"

// The result lines of one implementation on one benchmark.
effect fn block(text: &mut String, measured: &Measured, implementation: string) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let name = run Lines.named(measured.name.view())
  let samples = measured.samples.asSlice()
  let mut at: usize = 0
  while at < samples.length {
    let sample = &samples[at]
    if !sample.warmup && sample.exit == 0 && sample.implementation.view() == implementation {
      run text.append(name.view())
      run text.append(" 1 ")
      run Units.appendWhole(&mut text, sample.wall)
      run text.append(" ns/op ")
      run Units.appendWhole(&mut text, sample.user)
      run text.append(" user-ns/op ")
      run Units.appendWhole(&mut text, sample.system)
      run text.append(" sys-ns/op ")
      run Units.appendWhole(&mut text, sample.peak)
      run text.append(" peak-B\n")
    }
    at = at + 1
  }
}

// The result lines one implementation's program printed for one combination of parameters, as
// they were read, with the parameters of the combination added to each name.
effect fn reported(
  text: &mut String,
  result: &RunResult,
  measured: &Measured,
  implementation: string,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let whole = measured.name.view()
  let skip = String.byteLength(result.suite.view())
  let suffix = String.slice(whole, skip, String.byteLength(whole) - skip)
  let readings = measured.readings.asSlice()
  let mut at: usize = 0
  while at < readings.length {
    let reading = &readings[at]
    if !reading.warmup && reading.implementation.view() == implementation {
      run text.append("Benchmark")
      run text.append(reading.name.view())
      if String.byteLength(reading.name.view()) > 0 {
        run text.append(suffix)
      }
      run text.append(" ")
      run Units.appendWhole(&mut text, reading.iterations)
      let values = reading.values.asSlice()
      let mut value: usize = 0
      while value < values.length {
        run text.append(" ")
        run number(&mut text, values[value].value)
        run text.append(" ")
        run text.append(values[value].unit.view())
        value = value + 1
      }
      run text.append("\n")
    }
    at = at + 1
  }
}

// The bytes of one number as `silk.text.format` writes it. The shortest text that reads back
// as the same `f64` has at most 24 bytes.
struct Digits {
  bytes: [u8; 32],
  length: usize,
}

impl Writer for Digits {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> ()
    ! WriterError
    ? &mut Writer {
    let mut at: usize = 0
    while at < value.length && self.length < 32 {
      self.bytes[self.length] = value[at]
      self.length = self.length + 1
      at = at + 1
    }
    return ()
  }

  effect fn flush(self: &mut Self) -> ()
    ! WriterError
    ? &mut Writer {
    return ()
  }
}

// Appends `value` to `text` as the shortest text that reads back as the same number.
effect fn number(text: &mut String, value: f64) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if value >= 0.0 && value < 1.0e15 && f64.floor(value) == value {
    // A whole number reads best without an exponent.
    return run Units.appendWhole(&mut text, f64.toU64(value))
  }
  let mut digits = Digits { bytes: [0; 32], length: 0 }
  drop run Effect.result(Format.format("{}", &.(value)) |> Effect.provideMut<Writer>(&mut digits))
  if let Result<String, InvalidUtf8>.Success { value: copy } = move run String.copyUtf8(
    Slice.view<u8>(&digits.bytes, 0, digits.length),
  ) {
    run text.appendOwned(move copy)
  }
}

fn blank(byte: u8) -> bool {
  return byte == 32 || byte == 9 || byte == 13
}

// The end of the field that starts at `at`: the next blank or the end of the line.
fn fieldEnd(bytes: &[u8], at: usize) -> usize {
  let mut end = at
  while end < bytes.length && !blank(bytes[end]) {
    end = end + 1
  }
  return end
}

// The start of the next field at or after `at`, or the length of the line.
fn fieldStart(bytes: &[u8], at: usize) -> usize {
  let mut start = at
  while start < bytes.length && blank(bytes[start]) {
    start = start + 1
  }
  return start
}

// Appends `line` to `parsed` if it is a result line, and returns whether it was one.
effect fn result(parsed: &mut Parsed, line: string) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let bytes = String.utf8Bytes(line)
  if !String.startsWith(line, "Benchmark") {
    return false
  }
  let nameEnd = fieldEnd(bytes, 0)
  if nameEnd > 9 && bytes[9] >= 97 && bytes[9] <= 122 {
    return false
  }
  let mut at = fieldStart(bytes, nameEnd)
  let mut end = fieldEnd(bytes, at)
  let iterations = match Format.u64Value(String.slice(line, at, end - at)) {
    Result<u64, ParseError>.Success { value } => value
    Result<u64, ParseError>.Failure { .. } => {
      return false
    }
  }
  let mut values = List<Value>.make()
  at = fieldStart(bytes, end)
  while at < bytes.length {
    end = fieldEnd(bytes, at)
    let value = match Format.f64Value(String.slice(line, at, end - at)) {
      Result<f64, ParseError>.Success { value } => value
      Result<f64, ParseError>.Failure { .. } => {
        return false
      }
    }
    at = fieldStart(bytes, end)
    if at == bytes.length {
      // A value with no unit.
      return false
    }
    end = fieldEnd(bytes, at)
    run values.append(Value { value, unit: run String.copy(String.slice(line, at, end - at)) })
    at = fieldStart(bytes, end)
  }
  if values.length() == 0 {
    return false
  }
  run parsed.lines.append(
    Line { name: run String.copy(String.slice(line, 0, nameEnd)), iterations, values: move values },
  )
  return true
}

// Appends `line` to `parsed` if it is a configuration line.
effect fn setting(parsed: &mut Parsed, line: string) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let bytes = String.utf8Bytes(line)
  if bytes.length == 0 || !(bytes[0] >= 97 && bytes[0] <= 122 || bytes[0] >= 128) {
    return ()
  }
  let mut colon: usize = 0
  while colon < bytes.length && bytes[colon] != 58 {
    if blank(bytes[colon]) || (bytes[colon] >= 65 && bytes[colon] <= 90) {
      return ()
    }
    colon = colon + 1
  }
  if colon == bytes.length {
    return ()
  }

  // After the colon comes a blank, or nothing when the value is empty.
  if colon + 1 < bytes.length && !blank(bytes[colon + 1]) {
    return ()
  }
  let rest = String.trim(String.slice(line, colon + 1, bytes.length - colon - 1))
  let from = parsed.lines.length()
  run parsed.settings.append(
    Setting {
      name: run String.copy(String.slice(line, 0, colon)),
      value: run String.copy(rest),
      from,
    },
  )
}
