  v13 = u32.rotateRight(u32.bitXor(v13, v1), 16)
  v9 = u32.wrappingAdd(v9, v13)
  v5 = u32.rotateRight(u32.bitXor(v5, v9), 12)
  v1 = u32.wrappingAdd(u32.wrappingAdd(v1, v5), m3)
  v13 = u32.rotateRight(u32.bitXor(v13, v1), 8)
  v9 = u32.wrappingAdd(v9, v13)
  v5 = u32.rotateRight(u32.bitXor(v5, v9), 7)
  v2 = u32.wrappingAdd(u32.wrappingAdd(v2, v6), m4)
  v14 = u32.rotateRight(u32.bitXor(v14, v2), 16)
  v10 = u32.wrappingAdd(v10, v14)
  v6 = u32.rotateRight(u32.bitXor(v6, v10), 12)
  v2 = u32.wrappingAdd(u32.wrappingAdd(v2, v6), m5)
  v14 = u32.rotateRight(u32.bitXor(v14, v2), 8)
  v10 = u32.wrappingAdd(v10, v14)
  v6 = u32.rotateRight(u32.bitXor(v6, v10), 7)
  v3 = u32.wrappingAdd(u32.wrappingAdd(v3, v7), m6)
  v15 = u32.rotateRight(u32.bitXor(v15, v3), 16)
  v11 = u32.wrappingAdd(v11, v15)
  v7 = u32.rotateRight(u32.bitXor(v7, v11), 12)
  v3 = u32.wrappingAdd(u32.wrappingAdd(v3, v7), m7)
  v15 = u32.rotateRight(u32.bitXor(v15, v3), 8)
  v11 = u32.wrappingAdd(v11, v15)
  v7 = u32.rotateRight(u32.bitXor(v7, v11), 7)
  v0 = u32.wrappingAdd(u32.wrappingAdd(v0, v5), m8)
  v15 = u32.rotateRight(u32.bitXor(v15, v0), 16)
  v10 = u32.wrappingAdd(v10, v15)
  v5 = u32.rotateRight(u32.bitXor(v5, v10), 12)
