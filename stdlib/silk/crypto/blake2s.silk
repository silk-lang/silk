// The initialization vector, shared with SHA-256.
fn initial() -> [u32; 8] {
  return [0x6a09e667, 0xbb67ae85, 0x3c6ef372, 0xa54ff53a, 0x510e527f, 0x9b05688c, 0x1f83d9ab, 0x5be0cd19]
}

impl Digest for Blake2s256 {
  /// Returns a BLAKE2s-256 state for an empty message.
  make: Blake2s256.make
  /// Adds `bytes` to the end of the message.
  update: Blake2s256.update
  /// Returns 64, the BLAKE2s-256 block length in bytes.
  fn blockLength(self: &Self) -> usize {
    return 64
  }
  /// Returns 32, the BLAKE2s-256 digest length in bytes.
  fn digestLength(self: &Self) -> usize {
    return 32
  }
  /// Returns the content bytes of the BLAKE2s-256 object identifier, 1.3.6.1.4.1.1722.12.2.2.8.
  fn objectIdentifier(self: &Self) -> &[u8] {
    return b"\x2b\x06\x01\x04\x01\x8d\x3a\x0c\x02\x02\x08"
  }
  /// Returns an independent copy of the state.
  fn copy(self: &Self) -> Self {
    return Blake2s256 {words: self.words, buffer: self.buffer, buffered: self.buffered, count: self.count}
  }
  /// Writes the 32-byte BLAKE2s-256 digest to the start of `output` and consumes the state.
  fn finishInto(self: Self, output: &mut [u8]) -> () {
    let digest = Blake2s256.finish(move self)
    writeDigest(&digest, move output)
  }
}

// Writes `digest` to the start of `output` for `Digest.finishInto`.
fn writeDigest(digest: &[u8], output: &mut [u8]) -> () {
  let mut index: usize = 0
  while index < digest.length {
    output[index] = digest[index]
    index = index + 1
  }
}
