//! Portable BLAKE2s-256 state for the unkeyed 32-byte cryptographic digest of RFC 7693.
//!
//! # When to use
//! Use [`Blake2s256`] where a format names BLAKE2s with a 32-byte digest, such as Node's
//! `blake2s256` hash. Use `silk.crypto.blake2b` for BLAKE2b and `silk.crypto.sha2` where a
//! protocol names SHA-2.
//!
//! # Details
//! The state supports incremental input through `update`, consuming finalization through `finish`,
//! and one-shot input through `hash`. It uses only inline storage and allocates no memory. The
//! digest is the little-endian encoding of the final state words, as RFC 7693 specifies.
//!
//! # Gotchas
//! Keyed hashing, salts, personalization and digest lengths other than 32 bytes are not supported.
//! If an update makes the message longer than 2^64 - 1 bytes, the program traps.
//!
//! # Examples
//! ## Hash a short message
//! ```silk
//! import silk.crypto.blake2s {Blake2s256}
//!
//! pub fn main() -> i32 {
//!   let digest = Blake2s256.hash(b"abc")
//!   // BLAKE2s-256("abc") is 508c5e8c...5982.
//!   if digest[0] != 0x50 || digest[31] != 0x82 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Cryptography

import silk.num.u8
import silk.crypto.digest {Digest}
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silk.encoding.endian
import silk.collections.slice {Slice}

/// An incremental unkeyed BLAKE2s state with a 32-byte digest (RFC 7693).
///
/// # Details
///
/// Give input in parts with [`Blake2s256.update`] and get the digest with [`Blake2s256.finish`],
/// or hash one slice with [`Blake2s256.hash`]. The state uses only inline storage and allocates no
/// memory.
///
/// # Gotchas
///
/// Keyed hashing, salts, personalization and digest lengths other than 32 bytes are not supported.
/// If an update makes the message longer than 2^64 - 1 bytes, the program traps.
pub struct Blake2s256 {
  words: [u32; 8],
  buffer: [u8; 64],
  buffered: usize,
  count: u64,
}

impl Blake2s256 {
  /// Creates an empty BLAKE2s-256 state.
  pub fn make() -> Blake2s256 {
    let mut words = initial()

    // Parameter block word zero: digest length 32, no key, fanout 1, depth 1.
    words[0] = u32.bitXor(words[0], 0x01010020)
    return Blake2s256 {words: words, buffer: [0; 64], buffered: usize.ZERO, count: 0}
  }

  /// Adds `bytes` to this state in source order. An empty slice does not change the state.
  ///
  /// # Details
  /// A full block is compressed only when more input follows it, because the final block is
  /// compressed with the finalization flag. It allocates no memory.
  pub fn update(self: &mut Self, bytes: &[u8]) -> () {
    // The last block is compressed with the final flag, so a full block stays buffered until more
    // bytes follow. Whole blocks with more bytes after them are compressed straight from `bytes`.
    let mut index = usize.ZERO
    if self.buffered > usize.ZERO {
      let mut take = 64 - self.buffered
      if take > bytes.length { take = bytes.length }
      Slice.copyInto<u8>(&mut self.buffer, self.buffered, Slice.view<u8>(bytes, usize.ZERO, take))
      self.buffered = self.buffered + take
      index = take
      if index == bytes.length { return () }
      advance(&mut self.*, 64)
      compress(&mut self.words, &self.buffer, usize.ZERO, self.count, false)
      self.buffered = usize.ZERO
    }
    while bytes.length - index > 64 {
      advance(&mut self.*, 64)
      compress(&mut self.words, bytes, index, self.count, false)
      index = index + 64
    }
    Slice.copyInto<u8>(&mut self.buffer, usize.ZERO, Slice.view<u8>(bytes, index, bytes.length - index))
    self.buffered = bytes.length - index
    return ()
  }


  /// Consumes this state and returns its 32-byte digest.
  pub fn finish(self: Self) -> [u8; 32] {
    let mut state = move self
    let buffered = state.buffered
    advance(&mut state, usize.toU64(buffered))
    let mut index = buffered
    while index < 64 {
      state.buffer[index] = 0
      index = index + usize.ONE
    }
    compress(&mut state.words, &state.buffer, usize.ZERO, state.count, true)
    let mut digest: [u8; 32] = [0; 32]
    index = usize.ZERO
    while index < 32 {
      let shift = usize.toU32((index % 4) * 8)
      digest[index] = u32.toU8(u32.bitAnd(u32.shiftRight(state.words[index / 4], shift), 255))
      index = index + usize.ONE
    }
    return digest
  }

  /// Returns the 32-byte BLAKE2s digest of `bytes`.
  pub fn hash(bytes: &[u8]) -> [u8; 32] {
    let mut state = Blake2s256.make()
    state.update(bytes)
    return state.finish()
  }
}

// Adds `count` bytes to the 64-bit message counter, trapping past its domain.
fn advance(state: &mut Blake2s256, count: u64) -> () {
  let total = u64.wrappingAdd(state.count, count)
  if total < state.count {
    Intrinsic.trap("Blake2s256.update: the total input is longer than 2^64 bytes")
  }
  state.count = total
  return ()
}

// Compresses the 64-byte block at `offset` in `bytes` into `words`, with the 64-bit byte count
// `count` and the final-block flag `last`. The rounds are unrolled.
fn compress(words: &mut [u32; 8], bytes: &[u8], offset: usize, count: u64, last: bool) -> () {
  let block = Slice.view<u8>(bytes, offset, 64)
  let m0 = endian.readU32LittleEndian(block, 0)
  let m1 = endian.readU32LittleEndian(block, 4)
  let m2 = endian.readU32LittleEndian(block, 8)
  let m3 = endian.readU32LittleEndian(block, 12)
  let m4 = endian.readU32LittleEndian(block, 16)
  let m5 = endian.readU32LittleEndian(block, 20)
  let m6 = endian.readU32LittleEndian(block, 24)
  let m7 = endian.readU32LittleEndian(block, 28)
  let m8 = endian.readU32LittleEndian(block, 32)
  let m9 = endian.readU32LittleEndian(block, 36)
  let m10 = endian.readU32LittleEndian(block, 40)
  let m11 = endian.readU32LittleEndian(block, 44)
  let m12 = endian.readU32LittleEndian(block, 48)
  let m13 = endian.readU32LittleEndian(block, 52)
  let m14 = endian.readU32LittleEndian(block, 56)
  let m15 = endian.readU32LittleEndian(block, 60)
  let start = initial()
  let mut v0 = words[0]
  let mut v1 = words[1]
  let mut v2 = words[2]
  let mut v3 = words[3]
  let mut v4 = words[4]
  let mut v5 = words[5]
  let mut v6 = words[6]
  let mut v7 = words[7]
  let mut v8 = start[0]
  let mut v9 = start[1]
  let mut v10 = start[2]
  let mut v11 = start[3]
  let mut v12 = u32.bitXor(start[4], u64.toU32(u64.bitAnd(count, 0xffffffff)))
  let mut v13 = u32.bitXor(start[5], u64.toU32(u64.shiftRight(count, 32)))
  let mut v14 = start[6]
  let mut v15 = start[7]
  if last {
    v14 = u32.bitNot(v14)
  }
  v0 = u32.wrappingAdd(u32.wrappingAdd(v0, v4), m0)
  v12 = u32.rotateRight(u32.bitXor(v12, v0), 16)
  v8 = u32.wrappingAdd(v8, v12)
  v4 = u32.rotateRight(u32.bitXor(v4, v8), 12)
  v0 = u32.wrappingAdd(u32.wrappingAdd(v0, v4), m1)
  v12 = u32.rotateRight(u32.bitXor(v12, v0), 8)
  v8 = u32.wrappingAdd(v8, v12)
