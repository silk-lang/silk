//! Wrap keys with the AES key wrap algorithms of RFC 3394 and RFC 5649 (NIST SP 800-38F KW, KWP).
//!
//! # When to use
//! Use [`AesKeyWrap`] to encrypt one key under another where a format names AES key wrap, such as
//! CMS, JOSE `A128KW`, or Node's `id-aes128-wrap` and `id-aes128-wrap-pad`.
//!
//! # Details
//! The key-encryption key is 16, 24, or 32 bytes. [`AesKeyWrap.wrap`] takes a multiple of 8 bytes,
//! at least 16, and adds 8 bytes. [`AesKeyWrap.wrapPadded`] takes any nonzero length, pads it to a
//! multiple of 8, and adds 8 bytes. Unwrapping checks the integrity value, so a wrong key or a
//! changed input fails. The IV is 8 bytes for KW and 4 bytes for KWP; [`AesKeyWrap.defaultIv`] and
//! [`AesKeyWrap.defaultPaddedIv`] return the RFC values. Nothing allocates.
//!
//! # Errors
//! The functions return an [`AesKeyWrapError`]. The checks on lengths come before the first write.
//! Unwrapping works in the output buffer, and on `IntegrityCheckFailed` it sets the bytes it used
//! back to zero.
//!
//! # Examples
//! ## Wrap and unwrap a key
//! ```silk
//! import silk.crypto.aes_wrap { AesKeyWrap, AesKeyWrapError }
//! import silk.core.result { Result }
//!
//! pub fn main() -> i32 {
//!   let kek: [u8; 16] = [1; 16]
//!   let secret: [u8; 16] = [2; 16]
//!   let iv = AesKeyWrap.defaultIv()
//!   let mut wrapped: [u8; 24] = [0; 24]
//!   if let Result.Failure { error: _ } = AesKeyWrap.wrap(&kek, &iv, &secret, &mut wrapped) { return 1 }
//!   let mut unwrapped: [u8; 16] = [0; 16]
//!   return match AesKeyWrap.unwrap(&kek, &iv, &wrapped, &mut unwrapped) {
//!     Result<usize, AesKeyWrapError>.Success { value } => if value == 16 && unwrapped[0] == 2 { 0 } else { 1 }
//!     Result<usize, AesKeyWrapError>.Failure { error: _ } => 1
//!   }
//! }
//! ```
//!
//! @category Cryptography

import silk.text.format { Debug, Format, Formatter }
import silk.core.result { Result }
import silk.crypto.aes { Aes, AesError }
import silk.num.u8
import silk.num.u64
import silk.num.usize
import silk.io.writer { Writer, WriterError }

/// The reason that a key wrap call was rejected. The checks run in the order of the variants.
pub enum AesKeyWrapError {
  /// The key-encryption key is not 16, 24, or 32 bytes.
  InvalidKeyLength,
  /// The IV is not 8 bytes (KW) or 4 bytes (KWP).
  InvalidIvLength,
  /// The input length is not one that the algorithm takes.
  InvalidInputLength,
  /// The output is shorter than the bytes the call writes.
  OutputTooSmall,
  /// The unwrapped integrity value does not match: the key is wrong or the input was changed.
  IntegrityCheckFailed,
}

impl Debug for AesKeyWrapError {
  /// Writes the name of the variant, such as `InvalidKeyLength`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      AesKeyWrapError.InvalidKeyLength => run Format.write(&mut formatter, b"InvalidKeyLength")
      AesKeyWrapError.InvalidIvLength => run Format.write(&mut formatter, b"InvalidIvLength")
      AesKeyWrapError.InvalidInputLength => run Format.write(&mut formatter, b"InvalidInputLength")
      AesKeyWrapError.OutputTooSmall => run Format.write(&mut formatter, b"OutputTooSmall")
      AesKeyWrapError.IntegrityCheckFailed => run Format.write(&mut formatter, b"IntegrityCheckFailed")
    }
  }
}

/// Functions that wrap and unwrap keys with AES (RFC 3394 KW and RFC 5649 KWP).
///
/// # Details
///
/// The key-encryption key is 16, 24, or 32 bytes. Wrapping adds 8 bytes. Nothing allocates.
pub struct AesKeyWrap {}

impl AesKeyWrap {
  /// Returns the default KW IV of RFC 3394, A6A6A6A6A6A6A6A6.
  pub fn defaultIv() -> [u8; 8] {
    return [0xa6, 0xa6, 0xa6, 0xa6, 0xa6, 0xa6, 0xa6, 0xa6]
  }

  /// Returns the default KWP IV of RFC 5649, A65959A6.
  pub fn defaultPaddedIv() -> [u8; 4] {
    return [0xa6, 0x59, 0x59, 0xa6]
  }

  /// Wraps `input` (a multiple of 8 bytes, at least 16) under `key` with the 8-byte `iv` into the
  /// first `input.length + 8` bytes of `output`, and returns that length.
  ///
  /// # Errors
  ///
  /// - `InvalidKeyLength` if `key` is not 16, 24, or 32 bytes.
  /// - `InvalidIvLength` if `iv` is not 8 bytes.
  /// - `InvalidInputLength` if `input` is shorter than 16 bytes or not a multiple of 8.
  /// - `OutputTooSmall` if `output` is shorter than `input.length + 8`.
  pub fn wrap(key: &[u8], iv: &[u8], input: &[u8], output: &mut [u8]) -> Result<usize, AesKeyWrapError> {
    let cipher = match expandKey(key) {
      Result<Aes, AesKeyWrapError>.Success { value } => move value
      Result<Aes, AesKeyWrapError>.Failure { error } => { return Result<usize, AesKeyWrapError>.failResult(move error) }
    }
    if iv.length != 8 {
      return Result<usize, AesKeyWrapError>.failResult(AesKeyWrapError.InvalidIvLength)
    }
    if input.length < 16 || input.length % 8 != 0 {
      return Result<usize, AesKeyWrapError>.failResult(AesKeyWrapError.InvalidInputLength)
    }
    if output.length < input.length + 8 {
      return Result<usize, AesKeyWrapError>.failResult(AesKeyWrapError.OutputTooSmall)
    }
    let mut integrity: [u8; 8] = [0; 8]
    copy(iv, 0, &mut integrity, 0, 8)
    copy(input, 0, &mut output, 8, input.length)
    wrapCore(&cipher, &integrity, &mut output, input.length + 8)
    return Result<usize, AesKeyWrapError>.succeed(input.length + 8)
  }

  /// Unwraps `input` (a multiple of 8 bytes, at least 24) under `key`, checks it against the
  /// 8-byte `iv`, writes the key to the first `input.length - 8` bytes of `output`, and returns
  /// that length.
  ///
  /// # Errors
  ///
  /// - `InvalidKeyLength` if `key` is not 16, 24, or 32 bytes.
  /// - `InvalidIvLength` if `iv` is not 8 bytes.
  /// - `InvalidInputLength` if `input` is shorter than 24 bytes or not a multiple of 8.
  /// - `OutputTooSmall` if `output` is shorter than `input.length - 8`.
  /// - `IntegrityCheckFailed` if the integrity value is not `iv`. The written bytes are zero.
  pub fn unwrap(key: &[u8], iv: &[u8], input: &[u8], output: &mut [u8]) -> Result<usize, AesKeyWrapError> {
    let cipher = match expandKey(key) {
      Result<Aes, AesKeyWrapError>.Success { value } => move value
      Result<Aes, AesKeyWrapError>.Failure { error } => { return Result<usize, AesKeyWrapError>.failResult(move error) }
    }
    if iv.length != 8 {
      return Result<usize, AesKeyWrapError>.failResult(AesKeyWrapError.InvalidIvLength)
    }
    if input.length < 24 || input.length % 8 != 0 {
      return Result<usize, AesKeyWrapError>.failResult(AesKeyWrapError.InvalidInputLength)
    }
    let length = input.length - 8
    if output.length < length {
      return Result<usize, AesKeyWrapError>.failResult(AesKeyWrapError.OutputTooSmall)
    }
    copy(input, 8, &mut output, 0, length)
    let integrity = unwrapCore(&cipher, input, &mut output, length)
    if differs(&integrity, iv, 8) {
      clear(&mut output, length)
      return Result<usize, AesKeyWrapError>.failResult(AesKeyWrapError.IntegrityCheckFailed)
    }
    return Result<usize, AesKeyWrapError>.succeed(length)
  }

  /// Pads `input` (1 byte or more) to a multiple of 8, wraps it under `key` with the 4-byte `iv`
  /// into `output`, and returns the wrapped length, which is the padded length plus 8.
  ///
  /// # Errors
  ///
  /// - `InvalidKeyLength` if `key` is not 16, 24, or 32 bytes.
  /// - `InvalidIvLength` if `iv` is not 4 bytes.
  /// - `InvalidInputLength` if `input` is empty or longer than 2^32 - 1 bytes.
  /// - `OutputTooSmall` if `output` is shorter than the wrapped length.
  pub fn wrapPadded(key: &[u8], iv: &[u8], input: &[u8], output: &mut [u8]) -> Result<usize, AesKeyWrapError> {
    let cipher = match expandKey(key) {
      Result<Aes, AesKeyWrapError>.Success { value } => move value
      Result<Aes, AesKeyWrapError>.Failure { error } => { return Result<usize, AesKeyWrapError>.failResult(move error) }
    }
    if iv.length != 4 {
      return Result<usize, AesKeyWrapError>.failResult(AesKeyWrapError.InvalidIvLength)
    }
    if input.length == 0 || usize.toU64(input.length) > 4294967295 {
      return Result<usize, AesKeyWrapError>.failResult(AesKeyWrapError.InvalidInputLength)
    }
    let padded = ((input.length + 7) / 8) * 8
    if output.length < padded + 8 {
      return Result<usize, AesKeyWrapError>.failResult(AesKeyWrapError.OutputTooSmall)
    }
    let mut integrity: [u8; 8] = [0; 8]
    copy(iv, 0, &mut integrity, 0, 4)
    let size = usize.toU64(input.length)
    let mut index: usize = 0
    while index < 4 {
      integrity[4 + index] = u64.toU8(u64.bitAnd(u64.shiftRight(size, usize.toU64((3 - index) * 8)), 255))
      index = index + 1
    }
    copy(input, 0, &mut output, 8, input.length)
    index = 8 + input.length
    while index < padded + 8 {
      output[index] = 0
      index = index + 1
    }
    if padded == 8 {
      let mut block: [u8; 16] = [0; 16]
      copy(&integrity, 0, &mut block, 0, 8)
      copy(&output, 8, &mut block, 8, 8)
      let encrypted = cipher.encryptBlock(&block)
      copy(&encrypted, 0, &mut output, 0, 16)
    } else {
      wrapCore(&cipher, &integrity, &mut output, padded + 8)
    }
    return Result<usize, AesKeyWrapError>.succeed(padded + 8)
  }

  /// Unwraps `input` (a multiple of 8 bytes, at least 16) under `key`, checks the 4-byte `iv`,
  /// the length, and the padding, writes the key to `output`, and returns its length.
  ///
  /// # Errors
  ///
  /// - `InvalidKeyLength` if `key` is not 16, 24, or 32 bytes.
  /// - `InvalidIvLength` if `iv` is not 4 bytes.
  /// - `InvalidInputLength` if `input` is shorter than 16 bytes or not a multiple of 8.
  /// - `OutputTooSmall` if `output` is shorter than `input.length - 8`, the padded length.
  /// - `IntegrityCheckFailed` if the IV, length, or padding is wrong. The bytes it used are zero.
  pub fn unwrapPadded(key: &[u8], iv: &[u8], input: &[u8], output: &mut [u8]) -> Result<usize, AesKeyWrapError> {
    let cipher = match expandKey(key) {
      Result<Aes, AesKeyWrapError>.Success { value } => move value
      Result<Aes, AesKeyWrapError>.Failure { error } => { return Result<usize, AesKeyWrapError>.failResult(move error) }
    }
    if iv.length != 4 {
      return Result<usize, AesKeyWrapError>.failResult(AesKeyWrapError.InvalidIvLength)
    }
    if input.length < 16 || input.length % 8 != 0 {
      return Result<usize, AesKeyWrapError>.failResult(AesKeyWrapError.InvalidInputLength)
    }
    let padded = input.length - 8
    if output.length < padded {
      return Result<usize, AesKeyWrapError>.failResult(AesKeyWrapError.OutputTooSmall)
    }
    let mut integrity: [u8; 8] = [0; 8]
    if padded == 8 {
      let mut block: [u8; 16] = [0; 16]
      copy(input, 0, &mut block, 0, 16)
      let decrypted = cipher.decryptBlock(&block)
      copy(&decrypted, 0, &mut integrity, 0, 8)
      copy(&decrypted, 8, &mut output, 0, 8)
    } else {
      copy(input, 8, &mut output, 0, padded)
      integrity = unwrapCore(&cipher, input, &mut output, padded)
    }
    let mut size: u64 = 0
    let mut index: usize = 0
    while index < 4 {
      size = u64.bitOr(u64.shiftLeft(size, 8), u8.toU64(integrity[4 + index]))
      index = index + 1
    }
    // Every check is made before the result is used, and none branches on which byte differs.
    let mut bad = differs(&integrity, iv, 4)
    let length = u64.toUsize(size)
    if size == 0 || size > usize.toU64(padded) || size + 8 <= usize.toU64(padded) {
      bad = true
    } else {
      let mut padding: u8 = 0
      index = length
      while index < padded {
        padding = u8.bitOr(padding, output[index])
        index = index + 1
      }
      if padding != 0 {
        bad = true
      }
    }
    if bad {
      clear(&mut output, padded)
      return Result<usize, AesKeyWrapError>.failResult(AesKeyWrapError.IntegrityCheckFailed)
    }
    return Result<usize, AesKeyWrapError>.succeed(length)
  }
}

fn expandKey(key: &[u8]) -> Result<Aes, AesKeyWrapError> {
  return match Aes.make(key) {
    Result<Aes, AesError>.Success { value } => Result<Aes, AesKeyWrapError>.succeed(move value)
    Result<Aes, AesError>.Failure { error: _ } => Result<Aes, AesKeyWrapError>.failResult(AesKeyWrapError.InvalidKeyLength)
  }
}

fn copy(source: &[u8], from: usize, target: &mut [u8], to: usize, length: usize) -> () {
  let mut index: usize = 0
  while index < length {
    target[to + index] = source[from + index]
    index = index + 1
  }
}

fn clear(target: &mut [u8], length: usize) -> () {
  let mut index: usize = 0
  while index < length {
    target[index] = 0
    index = index + 1
  }
}

fn differs(left: &[u8], right: &[u8], length: usize) -> bool {
  let mut difference: u8 = 0
  let mut index: usize = 0
  while index < length {
    difference = u8.bitOr(difference, u8.bitXor(left[index], right[index]))
    index = index + 1
  }
  return difference != 0
}

// RFC 3394 section 2.2.1 on `output[8..total]`, which holds the blocks R. Writes A to output[0..8].
fn wrapCore(cipher: &Aes, integrity: &[u8; 8], output: &mut [u8], total: usize) -> () {
  let blocks = (total - 8) / 8
  let mut register = integrity.*
  let mut step: u64 = 0
  let mut round: usize = 0
  while round < 6 {
    let mut item: usize = 1
    while item <= blocks {
      let mut block: [u8; 16] = [0; 16]
      copy(&register, 0, &mut block, 0, 8)
      copy(&output, item * 8, &mut block, 8, 8)
      let encrypted = cipher.encryptBlock(&block)
      step = step + 1
      let mut index: usize = 0
      while index < 8 {
        let counter = u64.toU8(u64.bitAnd(u64.shiftRight(step, usize.toU64((7 - index) * 8)), 255))
        register[index] = u8.bitXor(encrypted[index], counter)
        index = index + 1
      }
      copy(&encrypted, 8, &mut output, item * 8, 8)
      item = item + 1
    }
    round = round + 1
  }
  copy(&register, 0, &mut output, 0, 8)
}

// RFC 3394 section 2.2.2 on `output[0..length]`, which holds the blocks R taken from `input[8..]`.
// Returns the recovered integrity value A.
fn unwrapCore(cipher: &Aes, input: &[u8], output: &mut [u8], length: usize) -> [u8; 8] {
  let blocks = length / 8
  let mut register: [u8; 8] = [0; 8]
  copy(input, 0, &mut register, 0, 8)
  let mut step = usize.toU64(6 * blocks)
  let mut round: usize = 0
  while round < 6 {
    let mut item = blocks
    while item >= 1 {
      let mut block: [u8; 16] = [0; 16]
      let mut index: usize = 0
      while index < 8 {
        let counter = u64.toU8(u64.bitAnd(u64.shiftRight(step, usize.toU64((7 - index) * 8)), 255))
        block[index] = u8.bitXor(register[index], counter)
        index = index + 1
      }
      copy(&output, (item - 1) * 8, &mut block, 8, 8)
      let decrypted = cipher.decryptBlock(&block)
      copy(&decrypted, 0, &mut register, 0, 8)
      copy(&decrypted, 8, &mut output, (item - 1) * 8, 8)
      step = step - 1
      item = item - 1
    }
    round = round + 1
  }
  return register
}
