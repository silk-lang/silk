//! Read and write elliptic-curve keys in DER: SEC1 private keys, PKCS #8 private keys, and
//! SubjectPublicKeyInfo public keys, for the named curves of [`EcCurve`].
//!
//! # When to use
//! Use [`EcKeyDer`] to load a key that OpenSSL, a browser, or Node.js wrote, or to export a key in
//! one of those forms. The reader tells you the curve, so you can pick `silk.crypto.p256`,
//! `silk.crypto.p384`, `silk.crypto.p521`, or `silk.crypto.ec` for any other curve.
//!
//! # Details
//! SEC1 is the `EC PRIVATE KEY` form of RFC 5915. PKCS #8 is the `PRIVATE KEY` form of RFC 5958
//! with the algorithm `id-ecPublicKey`. SubjectPublicKeyInfo is the `PUBLIC KEY` form of RFC 5480.
//! The readers return views into the DER and do not copy. The writers give the same bytes as
//! OpenSSL. Nothing allocates. PEM is DER in Base64 between header lines; use
//! `silk.encoding.base64` for it.
//!
//! # Errors
//! - [`EcKeyError`] for DER that is not valid, or for an algorithm or curve that is not supported.
//!
//! # Gotchas
//! The readers check the structure and the lengths, but not the values. Pass the secret to
//! `P256.fromBytes`, `P384.fromBytes`, or `P521.fromBytes`, and the public key to `validatePublicKey` or
//! `decompressPublicKey`, before you use them. A private key file can hold a public key that does
//! not belong to its secret; compare it with the public key of the secret if that matters.
//!
//! # Examples
//! ## Read a public key
//! ```silk
//! import silk.collections.slice { Slice }
//! import silk.crypto.ec_key { EcCurve, EcKeyDer, EcKeyError, EcPublicKeyDer }
//! import silk.core.result { Result }
//!
//! pub fn main() -> i32 {
//!   let mut point: [u8; 65] = [0; 65]
//!   point[0] = 0x04
//!   let mut der: [u8; 120] = [0; 120]
//!   let length = match EcKeyDer.writeSpki(EcCurve.P256, &point, &mut der) {
//!     Result<usize, EcKeyError>.Success { value } => value
//!     Result<usize, EcKeyError>.Failure {..} => {
//!       return 1
//!     }
//!   }
//!   // A P-256 SubjectPublicKeyInfo is 91 bytes.
//!   if length != 91 {
//!     return 1
//!   }
//!   // The reader takes exactly one key, so pass only the bytes that were written.
//!   return match EcKeyDer.readSpki(Slice.view<u8>(&der, 0, length)) {
//!     Result<EcPublicKeyDer, EcKeyError>.Success { value } => {
//!       if value.curve == EcCurve.P256 && value.publicKey.length == 65 {
//!         return 0
//!       }
//!       return 1
//!     }
//!     Result<EcPublicKeyDer, EcKeyError>.Failure {..} => 1
//!   }
//! }
//! ```
//!
//! @category Cryptography

import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.num.u8
import silk.num.usize
import silk.text.format { Debug, Format, Formatter }

/// A named elliptic curve over a prime field, as OpenSSL and Node.js `crypto.getCurves` list
/// them.
pub enum EcCurve {
  /// The curve that OpenSSL names `secp112r1`.
  Secp112r1,
  /// The curve that OpenSSL names `secp112r2`.
  Secp112r2,
  /// The curve that OpenSSL names `secp128r1`.
  Secp128r1,
  /// The curve that OpenSSL names `secp128r2`.
  Secp128r2,
  /// The curve that OpenSSL names `secp160k1`.
  Secp160k1,
  /// The curve that OpenSSL names `secp160r1`.
  Secp160r1,
  /// The curve that OpenSSL names `secp160r2`.
  Secp160r2,
  /// The curve that OpenSSL names `secp192k1`.
  Secp192k1,
  /// The curve that OpenSSL names `secp224k1`.
  Secp224k1,
  /// NIST P-224, which OpenSSL and SEC 2 name `secp224r1`.
  P224,
  /// The curve that OpenSSL names `secp256k1`.
  Secp256k1,
  /// NIST P-384, which OpenSSL and SEC 2 name `secp384r1`.
  P384,
  /// NIST P-521, which OpenSSL and SEC 2 name `secp521r1`.
  P521,
  /// NIST P-192, which OpenSSL names `prime192v1` and SEC 2 names `secp192r1`.
  P192,
  /// The curve that OpenSSL names `prime192v2`.
  Prime192v2,
  /// The curve that OpenSSL names `prime192v3`.
  Prime192v3,
  /// The curve that OpenSSL names `prime239v1`.
  Prime239v1,
  /// The curve that OpenSSL names `prime239v2`.
  Prime239v2,
  /// The curve that OpenSSL names `prime239v3`.
  Prime239v3,
  /// NIST P-256, which OpenSSL names `prime256v1` and SEC 2 names `secp256r1`.
  P256,
  /// The curve that OpenSSL names `wap-wsg-idm-ecid-wtls6`.
  Wtls6,
  /// The curve that OpenSSL names `wap-wsg-idm-ecid-wtls7`.
  Wtls7,
  /// The curve that OpenSSL names `wap-wsg-idm-ecid-wtls8`.
  Wtls8,
  /// The curve that OpenSSL names `wap-wsg-idm-ecid-wtls9`.
  Wtls9,
  /// The curve that OpenSSL names `wap-wsg-idm-ecid-wtls12`.
  Wtls12,
  /// The curve that OpenSSL names `brainpoolP160r1`.
  BrainpoolP160r1,
  /// The curve that OpenSSL names `brainpoolP160t1`.
  BrainpoolP160t1,
  /// The curve that OpenSSL names `brainpoolP192r1`.
  BrainpoolP192r1,
  /// The curve that OpenSSL names `brainpoolP192t1`.
  BrainpoolP192t1,
  /// The curve that OpenSSL names `brainpoolP224r1`.
  BrainpoolP224r1,
  /// The curve that OpenSSL names `brainpoolP224t1`.
  BrainpoolP224t1,
  /// The curve that OpenSSL names `brainpoolP256r1`.
  BrainpoolP256r1,
  /// The curve that OpenSSL names `brainpoolP256t1`.
  BrainpoolP256t1,
  /// The curve that OpenSSL names `brainpoolP320r1`.
  BrainpoolP320r1,
  /// The curve that OpenSSL names `brainpoolP320t1`.
  BrainpoolP320t1,
  /// The curve that OpenSSL names `brainpoolP384r1`.
  BrainpoolP384r1,
  /// The curve that OpenSSL names `brainpoolP384t1`.
  BrainpoolP384t1,
  /// The curve that OpenSSL names `brainpoolP512r1`.
  BrainpoolP512r1,
  /// The curve that OpenSSL names `brainpoolP512t1`.
  BrainpoolP512t1,
  /// The Chinese SM2 curve, which OpenSSL names `SM2`.
  Sm2,
}

impl EcCurve {
  /// Returns the length in bytes of a secret and of each half of an ECDSA signature: the byte
  /// length of the order of the base point, such as 32 for P-256 and 66 for P-521.
  pub fn secretLength(self: &Self) -> usize {
    return match &self.* {
      EcCurve.Secp112r1 => 14
      EcCurve.Secp112r2 => 14
      EcCurve.Secp128r1 => 16
      EcCurve.Secp128r2 => 16
      EcCurve.Secp160k1 => 21
      EcCurve.Secp160r1 => 21
      EcCurve.Secp160r2 => 21
      EcCurve.Secp192k1 => 24
      EcCurve.Secp224k1 => 29
      EcCurve.P224 => 28
      EcCurve.Secp256k1 => 32
      EcCurve.P384 => 48
      EcCurve.P521 => 66
      EcCurve.P192 => 24
      EcCurve.Prime192v2 => 24
      EcCurve.Prime192v3 => 24
      EcCurve.Prime239v1 => 30
      EcCurve.Prime239v2 => 30
      EcCurve.Prime239v3 => 30
      EcCurve.P256 => 32
      EcCurve.Wtls6 => 14
      EcCurve.Wtls7 => 21
      EcCurve.Wtls8 => 15
      EcCurve.Wtls9 => 21
      EcCurve.Wtls12 => 28
      EcCurve.BrainpoolP160r1 => 20
      EcCurve.BrainpoolP160t1 => 20
      EcCurve.BrainpoolP192r1 => 24
      EcCurve.BrainpoolP192t1 => 24
      EcCurve.BrainpoolP224r1 => 28
      EcCurve.BrainpoolP224t1 => 28
      EcCurve.BrainpoolP256r1 => 32
      EcCurve.BrainpoolP256t1 => 32
      EcCurve.BrainpoolP320r1 => 40
      EcCurve.BrainpoolP320t1 => 40
      EcCurve.BrainpoolP384r1 => 48
      EcCurve.BrainpoolP384t1 => 48
      EcCurve.BrainpoolP512r1 => 64
      EcCurve.BrainpoolP512t1 => 64
      EcCurve.Sm2 => 32
    }
  }

  /// Returns the length in bytes of a field element, which is the length of a shared secret and
  /// of each coordinate of a public key, such as 32 for P-256 and 66 for P-521.
  pub fn fieldLength(self: &Self) -> usize {
    return match &self.* {
      EcCurve.Secp112r1 => 14
      EcCurve.Secp112r2 => 14
      EcCurve.Secp128r1 => 16
      EcCurve.Secp128r2 => 16
      EcCurve.Secp160k1 => 20
      EcCurve.Secp160r1 => 20
      EcCurve.Secp160r2 => 20
      EcCurve.Secp192k1 => 24
      EcCurve.Secp224k1 => 28
      EcCurve.P224 => 28
      EcCurve.Secp256k1 => 32
      EcCurve.P384 => 48
      EcCurve.P521 => 66
      EcCurve.P192 => 24
      EcCurve.Prime192v2 => 24
      EcCurve.Prime192v3 => 24
      EcCurve.Prime239v1 => 30
      EcCurve.Prime239v2 => 30
      EcCurve.Prime239v3 => 30
      EcCurve.P256 => 32
      EcCurve.Wtls6 => 14
      EcCurve.Wtls7 => 20
      EcCurve.Wtls8 => 14
      EcCurve.Wtls9 => 20
      EcCurve.Wtls12 => 28
      EcCurve.BrainpoolP160r1 => 20
      EcCurve.BrainpoolP160t1 => 20
      EcCurve.BrainpoolP192r1 => 24
      EcCurve.BrainpoolP192t1 => 24
      EcCurve.BrainpoolP224r1 => 28
      EcCurve.BrainpoolP224t1 => 28
      EcCurve.BrainpoolP256r1 => 32
      EcCurve.BrainpoolP256t1 => 32
      EcCurve.BrainpoolP320r1 => 40
      EcCurve.BrainpoolP320t1 => 40
      EcCurve.BrainpoolP384r1 => 48
      EcCurve.BrainpoolP384t1 => 48
      EcCurve.BrainpoolP512r1 => 64
      EcCurve.BrainpoolP512t1 => 64
      EcCurve.Sm2 => 32
    }
  }

  /// Returns the length of an uncompressed public key in bytes: twice
  /// [`EcCurve.fieldLength`] plus 1, such as 65 for P-256.
  pub fn publicKeyLength(self: &Self) -> usize {
    return self.fieldLength() * 2 + 1
  }

  /// Returns the length of a compressed public key in bytes: [`EcCurve.fieldLength`] plus 1,
  /// such as 33 for P-256.
  pub fn compressedPublicKeyLength(self: &Self) -> usize {
    return self.fieldLength() + 1
  }

  /// Returns the content bytes of the object identifier that names the curve, without the tag
  /// and length.
  pub fn objectIdentifier(self: &Self) -> &[u8] {
    return match &self.* {
      EcCurve.Secp112r1 => b"\x2b\x81\x04\x00\x06"
      EcCurve.Secp112r2 => b"\x2b\x81\x04\x00\x07"
      EcCurve.Secp128r1 => b"\x2b\x81\x04\x00\x1c"
      EcCurve.Secp128r2 => b"\x2b\x81\x04\x00\x1d"
      EcCurve.Secp160k1 => b"\x2b\x81\x04\x00\x09"
      EcCurve.Secp160r1 => b"\x2b\x81\x04\x00\x08"
      EcCurve.Secp160r2 => b"\x2b\x81\x04\x00\x1e"
      EcCurve.Secp192k1 => b"\x2b\x81\x04\x00\x1f"
      EcCurve.Secp224k1 => b"\x2b\x81\x04\x00\x20"
      EcCurve.P224 => b"\x2b\x81\x04\x00\x21"
      EcCurve.Secp256k1 => b"\x2b\x81\x04\x00\x0a"
      EcCurve.P384 => b"\x2b\x81\x04\x00\x22"
      EcCurve.P521 => b"\x2b\x81\x04\x00\x23"
      EcCurve.P192 => b"\x2a\x86\x48\xce\x3d\x03\x01\x01"
      EcCurve.Prime192v2 => b"\x2a\x86\x48\xce\x3d\x03\x01\x02"
      EcCurve.Prime192v3 => b"\x2a\x86\x48\xce\x3d\x03\x01\x03"
      EcCurve.Prime239v1 => b"\x2a\x86\x48\xce\x3d\x03\x01\x04"
      EcCurve.Prime239v2 => b"\x2a\x86\x48\xce\x3d\x03\x01\x05"
      EcCurve.Prime239v3 => b"\x2a\x86\x48\xce\x3d\x03\x01\x06"
      EcCurve.P256 => b"\x2a\x86\x48\xce\x3d\x03\x01\x07"
      EcCurve.Wtls6 => b"\x67\x2b\x01\x04\x06"
      EcCurve.Wtls7 => b"\x67\x2b\x01\x04\x07"
      EcCurve.Wtls8 => b"\x67\x2b\x01\x04\x08"
      EcCurve.Wtls9 => b"\x67\x2b\x01\x04\x09"
      EcCurve.Wtls12 => b"\x67\x2b\x01\x04\x0c"
      EcCurve.BrainpoolP160r1 => b"\x2b\x24\x03\x03\x02\x08\x01\x01\x01"
      EcCurve.BrainpoolP160t1 => b"\x2b\x24\x03\x03\x02\x08\x01\x01\x02"
      EcCurve.BrainpoolP192r1 => b"\x2b\x24\x03\x03\x02\x08\x01\x01\x03"
      EcCurve.BrainpoolP192t1 => b"\x2b\x24\x03\x03\x02\x08\x01\x01\x04"
      EcCurve.BrainpoolP224r1 => b"\x2b\x24\x03\x03\x02\x08\x01\x01\x05"
      EcCurve.BrainpoolP224t1 => b"\x2b\x24\x03\x03\x02\x08\x01\x01\x06"
      EcCurve.BrainpoolP256r1 => b"\x2b\x24\x03\x03\x02\x08\x01\x01\x07"
      EcCurve.BrainpoolP256t1 => b"\x2b\x24\x03\x03\x02\x08\x01\x01\x08"
      EcCurve.BrainpoolP320r1 => b"\x2b\x24\x03\x03\x02\x08\x01\x01\x09"
      EcCurve.BrainpoolP320t1 => b"\x2b\x24\x03\x03\x02\x08\x01\x01\x0a"
      EcCurve.BrainpoolP384r1 => b"\x2b\x24\x03\x03\x02\x08\x01\x01\x0b"
      EcCurve.BrainpoolP384t1 => b"\x2b\x24\x03\x03\x02\x08\x01\x01\x0c"
      EcCurve.BrainpoolP512r1 => b"\x2b\x24\x03\x03\x02\x08\x01\x01\x0d"
      EcCurve.BrainpoolP512t1 => b"\x2b\x24\x03\x03\x02\x08\x01\x01\x0e"
      EcCurve.Sm2 => b"\x2a\x81\x1c\xcf\x55\x01\x82\x2d"
    }
  }

  /// Returns the name of the curve in OpenSSL and in Node.js `crypto.getCurves`, such as
  /// `prime256v1` or `brainpoolP256r1`.
  pub fn name(self: &Self) -> string {
    return match &self.* {
      EcCurve.Secp112r1 => "secp112r1"
      EcCurve.Secp112r2 => "secp112r2"
      EcCurve.Secp128r1 => "secp128r1"
      EcCurve.Secp128r2 => "secp128r2"
      EcCurve.Secp160k1 => "secp160k1"
      EcCurve.Secp160r1 => "secp160r1"
      EcCurve.Secp160r2 => "secp160r2"
      EcCurve.Secp192k1 => "secp192k1"
      EcCurve.Secp224k1 => "secp224k1"
      EcCurve.P224 => "secp224r1"
      EcCurve.Secp256k1 => "secp256k1"
      EcCurve.P384 => "secp384r1"
      EcCurve.P521 => "secp521r1"
      EcCurve.P192 => "prime192v1"
      EcCurve.Prime192v2 => "prime192v2"
      EcCurve.Prime192v3 => "prime192v3"
      EcCurve.Prime239v1 => "prime239v1"
      EcCurve.Prime239v2 => "prime239v2"
      EcCurve.Prime239v3 => "prime239v3"
      EcCurve.P256 => "prime256v1"
      EcCurve.Wtls6 => "wap-wsg-idm-ecid-wtls6"
      EcCurve.Wtls7 => "wap-wsg-idm-ecid-wtls7"
      EcCurve.Wtls8 => "wap-wsg-idm-ecid-wtls8"
      EcCurve.Wtls9 => "wap-wsg-idm-ecid-wtls9"
      EcCurve.Wtls12 => "wap-wsg-idm-ecid-wtls12"
      EcCurve.BrainpoolP160r1 => "brainpoolP160r1"
      EcCurve.BrainpoolP160t1 => "brainpoolP160t1"
      EcCurve.BrainpoolP192r1 => "brainpoolP192r1"
      EcCurve.BrainpoolP192t1 => "brainpoolP192t1"
      EcCurve.BrainpoolP224r1 => "brainpoolP224r1"
      EcCurve.BrainpoolP224t1 => "brainpoolP224t1"
      EcCurve.BrainpoolP256r1 => "brainpoolP256r1"
      EcCurve.BrainpoolP256t1 => "brainpoolP256t1"
      EcCurve.BrainpoolP320r1 => "brainpoolP320r1"
      EcCurve.BrainpoolP320t1 => "brainpoolP320t1"
      EcCurve.BrainpoolP384r1 => "brainpoolP384r1"
      EcCurve.BrainpoolP384t1 => "brainpoolP384t1"
      EcCurve.BrainpoolP512r1 => "brainpoolP512r1"
      EcCurve.BrainpoolP512t1 => "brainpoolP512t1"
      EcCurve.Sm2 => "SM2"
    }
  }

  /// Returns the curve for a name of OpenSSL, such as `prime256v1` or `secp256k1`, or a NIST
  /// name: `P-192`, `P-224`, `P-256`, `P-384`, or `P-521`, as Node.js `crypto.createECDH`
  /// accepts. Names are case-sensitive.
  pub fn fromName(name: string) -> Option<EcCurve> {
    if name == "P-224" {
      return Option<EcCurve>.some(EcCurve.P224)
    }
    if name == "P-384" {
      return Option<EcCurve>.some(EcCurve.P384)
    }
    if name == "P-521" {
      return Option<EcCurve>.some(EcCurve.P521)
    }
    if name == "P-192" {
      return Option<EcCurve>.some(EcCurve.P192)
    }
    if name == "P-256" {
      return Option<EcCurve>.some(EcCurve.P256)
    }
    if name == "secp112r1" {
      return Option<EcCurve>.some(EcCurve.Secp112r1)
    }
    if name == "secp112r2" {
      return Option<EcCurve>.some(EcCurve.Secp112r2)
    }
    if name == "secp128r1" {
      return Option<EcCurve>.some(EcCurve.Secp128r1)
    }
    if name == "secp128r2" {
      return Option<EcCurve>.some(EcCurve.Secp128r2)
    }
    if name == "secp160k1" {
      return Option<EcCurve>.some(EcCurve.Secp160k1)
    }
    if name == "secp160r1" {
      return Option<EcCurve>.some(EcCurve.Secp160r1)
    }
    if name == "secp160r2" {
      return Option<EcCurve>.some(EcCurve.Secp160r2)
    }
    if name == "secp192k1" {
      return Option<EcCurve>.some(EcCurve.Secp192k1)
    }
    if name == "secp224k1" {
      return Option<EcCurve>.some(EcCurve.Secp224k1)
    }
    if name == "secp224r1" {
      return Option<EcCurve>.some(EcCurve.P224)
    }
    if name == "secp256k1" {
      return Option<EcCurve>.some(EcCurve.Secp256k1)
    }
    if name == "secp384r1" {
      return Option<EcCurve>.some(EcCurve.P384)
    }
    if name == "secp521r1" {
      return Option<EcCurve>.some(EcCurve.P521)
    }
    if name == "prime192v1" {
      return Option<EcCurve>.some(EcCurve.P192)
    }
    if name == "prime192v2" {
      return Option<EcCurve>.some(EcCurve.Prime192v2)
    }
    if name == "prime192v3" {
      return Option<EcCurve>.some(EcCurve.Prime192v3)
    }
    if name == "prime239v1" {
      return Option<EcCurve>.some(EcCurve.Prime239v1)
    }
    if name == "prime239v2" {
      return Option<EcCurve>.some(EcCurve.Prime239v2)
    }
    if name == "prime239v3" {
      return Option<EcCurve>.some(EcCurve.Prime239v3)
    }
    if name == "prime256v1" {
      return Option<EcCurve>.some(EcCurve.P256)
    }
    if name == "wap-wsg-idm-ecid-wtls6" {
      return Option<EcCurve>.some(EcCurve.Wtls6)
    }
    if name == "wap-wsg-idm-ecid-wtls7" {
      return Option<EcCurve>.some(EcCurve.Wtls7)
    }
    if name == "wap-wsg-idm-ecid-wtls8" {
      return Option<EcCurve>.some(EcCurve.Wtls8)
    }
    if name == "wap-wsg-idm-ecid-wtls9" {
      return Option<EcCurve>.some(EcCurve.Wtls9)
    }
    if name == "wap-wsg-idm-ecid-wtls12" {
      return Option<EcCurve>.some(EcCurve.Wtls12)
    }
    if name == "brainpoolP160r1" {
      return Option<EcCurve>.some(EcCurve.BrainpoolP160r1)
    }
    if name == "brainpoolP160t1" {
      return Option<EcCurve>.some(EcCurve.BrainpoolP160t1)
    }
    if name == "brainpoolP192r1" {
      return Option<EcCurve>.some(EcCurve.BrainpoolP192r1)
    }
    if name == "brainpoolP192t1" {
      return Option<EcCurve>.some(EcCurve.BrainpoolP192t1)
    }
    if name == "brainpoolP224r1" {
      return Option<EcCurve>.some(EcCurve.BrainpoolP224r1)
    }
    if name == "brainpoolP224t1" {
      return Option<EcCurve>.some(EcCurve.BrainpoolP224t1)
    }
    if name == "brainpoolP256r1" {
      return Option<EcCurve>.some(EcCurve.BrainpoolP256r1)
    }
    if name == "brainpoolP256t1" {
      return Option<EcCurve>.some(EcCurve.BrainpoolP256t1)
    }
    if name == "brainpoolP320r1" {
      return Option<EcCurve>.some(EcCurve.BrainpoolP320r1)
    }
    if name == "brainpoolP320t1" {
      return Option<EcCurve>.some(EcCurve.BrainpoolP320t1)
    }
    if name == "brainpoolP384r1" {
      return Option<EcCurve>.some(EcCurve.BrainpoolP384r1)
    }
    if name == "brainpoolP384t1" {
      return Option<EcCurve>.some(EcCurve.BrainpoolP384t1)
    }
    if name == "brainpoolP512r1" {
      return Option<EcCurve>.some(EcCurve.BrainpoolP512r1)
    }
    if name == "brainpoolP512t1" {
      return Option<EcCurve>.some(EcCurve.BrainpoolP512t1)
    }
    if name == "SM2" {
      return Option<EcCurve>.some(EcCurve.Sm2)
    }
    return Option<EcCurve>.none()
  }

  /// Returns the curve whose object identifier has the content bytes `identifier`, without the
  /// tag and length, or `None`.
  pub fn fromObjectIdentifier(identifier: &[u8]) -> Option<EcCurve> {
    if sameIdentifier(identifier, EcCurve.Secp112r1) {
      return Option<EcCurve>.some(EcCurve.Secp112r1)
    }
    if sameIdentifier(identifier, EcCurve.Secp112r2) {
      return Option<EcCurve>.some(EcCurve.Secp112r2)
    }
    if sameIdentifier(identifier, EcCurve.Secp128r1) {
      return Option<EcCurve>.some(EcCurve.Secp128r1)
    }
    if sameIdentifier(identifier, EcCurve.Secp128r2) {
      return Option<EcCurve>.some(EcCurve.Secp128r2)
    }
    if sameIdentifier(identifier, EcCurve.Secp160k1) {
      return Option<EcCurve>.some(EcCurve.Secp160k1)
    }
    if sameIdentifier(identifier, EcCurve.Secp160r1) {
      return Option<EcCurve>.some(EcCurve.Secp160r1)
    }
    if sameIdentifier(identifier, EcCurve.Secp160r2) {
      return Option<EcCurve>.some(EcCurve.Secp160r2)
    }
    if sameIdentifier(identifier, EcCurve.Secp192k1) {
      return Option<EcCurve>.some(EcCurve.Secp192k1)
    }
    if sameIdentifier(identifier, EcCurve.Secp224k1) {
      return Option<EcCurve>.some(EcCurve.Secp224k1)
    }
    if sameIdentifier(identifier, EcCurve.P224) {
      return Option<EcCurve>.some(EcCurve.P224)
    }
    if sameIdentifier(identifier, EcCurve.Secp256k1) {
      return Option<EcCurve>.some(EcCurve.Secp256k1)
    }
    if sameIdentifier(identifier, EcCurve.P384) {
      return Option<EcCurve>.some(EcCurve.P384)
    }
    if sameIdentifier(identifier, EcCurve.P521) {
      return Option<EcCurve>.some(EcCurve.P521)
    }
    if sameIdentifier(identifier, EcCurve.P192) {
      return Option<EcCurve>.some(EcCurve.P192)
    }
    if sameIdentifier(identifier, EcCurve.Prime192v2) {
      return Option<EcCurve>.some(EcCurve.Prime192v2)
    }
    if sameIdentifier(identifier, EcCurve.Prime192v3) {
      return Option<EcCurve>.some(EcCurve.Prime192v3)
    }
    if sameIdentifier(identifier, EcCurve.Prime239v1) {
      return Option<EcCurve>.some(EcCurve.Prime239v1)
    }
    if sameIdentifier(identifier, EcCurve.Prime239v2) {
      return Option<EcCurve>.some(EcCurve.Prime239v2)
    }
    if sameIdentifier(identifier, EcCurve.Prime239v3) {
      return Option<EcCurve>.some(EcCurve.Prime239v3)
    }
    if sameIdentifier(identifier, EcCurve.P256) {
      return Option<EcCurve>.some(EcCurve.P256)
    }
    if sameIdentifier(identifier, EcCurve.Wtls6) {
      return Option<EcCurve>.some(EcCurve.Wtls6)
    }
    if sameIdentifier(identifier, EcCurve.Wtls7) {
      return Option<EcCurve>.some(EcCurve.Wtls7)
    }
    if sameIdentifier(identifier, EcCurve.Wtls8) {
      return Option<EcCurve>.some(EcCurve.Wtls8)
    }
    if sameIdentifier(identifier, EcCurve.Wtls9) {
      return Option<EcCurve>.some(EcCurve.Wtls9)
    }
    if sameIdentifier(identifier, EcCurve.Wtls12) {
      return Option<EcCurve>.some(EcCurve.Wtls12)
    }
    if sameIdentifier(identifier, EcCurve.BrainpoolP160r1) {
      return Option<EcCurve>.some(EcCurve.BrainpoolP160r1)
    }
    if sameIdentifier(identifier, EcCurve.BrainpoolP160t1) {
      return Option<EcCurve>.some(EcCurve.BrainpoolP160t1)
    }
    if sameIdentifier(identifier, EcCurve.BrainpoolP192r1) {
      return Option<EcCurve>.some(EcCurve.BrainpoolP192r1)
    }
    if sameIdentifier(identifier, EcCurve.BrainpoolP192t1) {
      return Option<EcCurve>.some(EcCurve.BrainpoolP192t1)
    }
    if sameIdentifier(identifier, EcCurve.BrainpoolP224r1) {
      return Option<EcCurve>.some(EcCurve.BrainpoolP224r1)
    }
    if sameIdentifier(identifier, EcCurve.BrainpoolP224t1) {
      return Option<EcCurve>.some(EcCurve.BrainpoolP224t1)
    }
    if sameIdentifier(identifier, EcCurve.BrainpoolP256r1) {
      return Option<EcCurve>.some(EcCurve.BrainpoolP256r1)
    }
    if sameIdentifier(identifier, EcCurve.BrainpoolP256t1) {
      return Option<EcCurve>.some(EcCurve.BrainpoolP256t1)
    }
    if sameIdentifier(identifier, EcCurve.BrainpoolP320r1) {
      return Option<EcCurve>.some(EcCurve.BrainpoolP320r1)
    }
    if sameIdentifier(identifier, EcCurve.BrainpoolP320t1) {
      return Option<EcCurve>.some(EcCurve.BrainpoolP320t1)
    }
    if sameIdentifier(identifier, EcCurve.BrainpoolP384r1) {
      return Option<EcCurve>.some(EcCurve.BrainpoolP384r1)
    }
    if sameIdentifier(identifier, EcCurve.BrainpoolP384t1) {
      return Option<EcCurve>.some(EcCurve.BrainpoolP384t1)
    }
    if sameIdentifier(identifier, EcCurve.BrainpoolP512r1) {
      return Option<EcCurve>.some(EcCurve.BrainpoolP512r1)
    }
    if sameIdentifier(identifier, EcCurve.BrainpoolP512t1) {
      return Option<EcCurve>.some(EcCurve.BrainpoolP512t1)
    }
    if sameIdentifier(identifier, EcCurve.Sm2) {
      return Option<EcCurve>.some(EcCurve.Sm2)
    }
    return Option<EcCurve>.none()
  }
}

fn sameIdentifier(identifier: &[u8], curve: EcCurve) -> bool {
  let expected = curve.objectIdentifier()
  if identifier.length != expected.length {
    return false
  }
  let mut i: usize = 0
  while i < expected.length {
    if identifier[i] != expected[i] {
      return false
    }
    i = i + 1
  }
  return true
}

impl Debug for EcCurve {
  /// Writes the name of the variant, such as `P256`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return match &self.* {
      EcCurve.Secp112r1 => run Format.write(&mut formatter, b"Secp112r1")
      EcCurve.Secp112r2 => run Format.write(&mut formatter, b"Secp112r2")
      EcCurve.Secp128r1 => run Format.write(&mut formatter, b"Secp128r1")
      EcCurve.Secp128r2 => run Format.write(&mut formatter, b"Secp128r2")
      EcCurve.Secp160k1 => run Format.write(&mut formatter, b"Secp160k1")
      EcCurve.Secp160r1 => run Format.write(&mut formatter, b"Secp160r1")
      EcCurve.Secp160r2 => run Format.write(&mut formatter, b"Secp160r2")
      EcCurve.Secp192k1 => run Format.write(&mut formatter, b"Secp192k1")
      EcCurve.Secp224k1 => run Format.write(&mut formatter, b"Secp224k1")
      EcCurve.P224 => run Format.write(&mut formatter, b"P224")
      EcCurve.Secp256k1 => run Format.write(&mut formatter, b"Secp256k1")
      EcCurve.P384 => run Format.write(&mut formatter, b"P384")
      EcCurve.P521 => run Format.write(&mut formatter, b"P521")
      EcCurve.P192 => run Format.write(&mut formatter, b"P192")
      EcCurve.Prime192v2 => run Format.write(&mut formatter, b"Prime192v2")
      EcCurve.Prime192v3 => run Format.write(&mut formatter, b"Prime192v3")
      EcCurve.Prime239v1 => run Format.write(&mut formatter, b"Prime239v1")
      EcCurve.Prime239v2 => run Format.write(&mut formatter, b"Prime239v2")
      EcCurve.Prime239v3 => run Format.write(&mut formatter, b"Prime239v3")
      EcCurve.P256 => run Format.write(&mut formatter, b"P256")
      EcCurve.Wtls6 => run Format.write(&mut formatter, b"Wtls6")
      EcCurve.Wtls7 => run Format.write(&mut formatter, b"Wtls7")
      EcCurve.Wtls8 => run Format.write(&mut formatter, b"Wtls8")
      EcCurve.Wtls9 => run Format.write(&mut formatter, b"Wtls9")
      EcCurve.Wtls12 => run Format.write(&mut formatter, b"Wtls12")
      EcCurve.BrainpoolP160r1 => run Format.write(&mut formatter, b"BrainpoolP160r1")
      EcCurve.BrainpoolP160t1 => run Format.write(&mut formatter, b"BrainpoolP160t1")
      EcCurve.BrainpoolP192r1 => run Format.write(&mut formatter, b"BrainpoolP192r1")
      EcCurve.BrainpoolP192t1 => run Format.write(&mut formatter, b"BrainpoolP192t1")
      EcCurve.BrainpoolP224r1 => run Format.write(&mut formatter, b"BrainpoolP224r1")
      EcCurve.BrainpoolP224t1 => run Format.write(&mut formatter, b"BrainpoolP224t1")
      EcCurve.BrainpoolP256r1 => run Format.write(&mut formatter, b"BrainpoolP256r1")
      EcCurve.BrainpoolP256t1 => run Format.write(&mut formatter, b"BrainpoolP256t1")
      EcCurve.BrainpoolP320r1 => run Format.write(&mut formatter, b"BrainpoolP320r1")
      EcCurve.BrainpoolP320t1 => run Format.write(&mut formatter, b"BrainpoolP320t1")
      EcCurve.BrainpoolP384r1 => run Format.write(&mut formatter, b"BrainpoolP384r1")
      EcCurve.BrainpoolP384t1 => run Format.write(&mut formatter, b"BrainpoolP384t1")
      EcCurve.BrainpoolP512r1 => run Format.write(&mut formatter, b"BrainpoolP512r1")
      EcCurve.BrainpoolP512t1 => run Format.write(&mut formatter, b"BrainpoolP512t1")
      EcCurve.Sm2 => run Format.write(&mut formatter, b"Sm2")
    }
  }
}

/// The reason that an elliptic-curve key in DER could not be read or written.
pub enum EcKeyError {
  /// The bytes are not strict DER of the expected structure, or a version is not supported.
  InvalidEncoding,
  /// The key algorithm is not `id-ecPublicKey`.
  UnsupportedAlgorithm,
  /// The curve is not one of [`EcCurve`], the curve is given by explicit parameters, or no curve
  /// is named.
  UnsupportedCurve,
  /// A secret or a public key does not have a length that the curve allows.
  InvalidLength,
}

impl Debug for EcKeyError {
  /// Writes the name of the variant, such as `InvalidEncoding`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return match &self.* {
      EcKeyError.InvalidEncoding => run Format.write(&mut formatter, b"InvalidEncoding")
      EcKeyError.UnsupportedAlgorithm => run Format.write(&mut formatter, b"UnsupportedAlgorithm")
      EcKeyError.UnsupportedCurve => run Format.write(&mut formatter, b"UnsupportedCurve")
      EcKeyError.InvalidLength => run Format.write(&mut formatter, b"InvalidLength")
    }
  }
}

/// A private key that [`EcKeyDer.readSec1`] or [`EcKeyDer.readPkcs8`] read. The slices point into
/// the DER.
pub struct EcPrivateKeyDer<'a> {
  /// The curve of the key.
  pub curve: EcCurve,
  /// The secret, big-endian, of [`EcCurve.secretLength`] bytes.
  pub secret: &'a [u8],
  /// The public key that the file holds, compressed, uncompressed, or hybrid, or `None`.
  pub publicKey: Option<&'a [u8]>,
}

/// A public key that [`EcKeyDer.readSpki`] read. The slice points into the DER.
pub struct EcPublicKeyDer<'a> {
  /// The curve of the key.
  pub curve: EcCurve,
  /// The public key in SEC1 form, compressed, uncompressed, or hybrid.
  pub publicKey: &'a [u8],
}

/// Functions that read and write elliptic-curve keys in DER.
///
/// # When to use
/// Use it to load or export a key on a curve of [`EcCurve`] as SEC1, PKCS #8, or
/// SubjectPublicKeyInfo.
///
/// # Details
/// The writers give the same bytes as OpenSSL: SEC1 names the curve and holds the public key,
/// PKCS #8 holds the public key in the inner SEC1 key, and SubjectPublicKeyInfo names the curve. A
/// SEC1 key is at most 223 bytes, a PKCS #8 key at most 241 bytes, and a SubjectPublicKeyInfo at
/// most 158 bytes.
///
/// # Gotchas
/// The readers do not check that the secret is in range or that the public key is on the curve.
pub struct EcKeyDer {}

impl EcKeyDer {
  /// Reads a SEC1 `ECPrivateKey` (RFC 5915), the form of an `EC PRIVATE KEY` PEM file.
  ///
  /// The key must name its curve. The public key is optional.
  ///
  /// # Errors
  /// - `InvalidEncoding` if `der` is not one strict DER `ECPrivateKey` of version 1.
  /// - `UnsupportedCurve` if the curve is missing, explicit, or not one of [`EcCurve`].
  /// - `InvalidLength` if the secret or the public key has the wrong length for the curve.
  pub fn readSec1<'a>(der: &'a [u8]) -> Result<EcPrivateKeyDer<'a>, EcKeyError> {
    return readEcPrivateKey(der, 0, der.length, Option<EcCurve>.none())
  }

  /// Reads a PKCS #8 `PrivateKeyInfo` or `OneAsymmetricKey` (RFC 5958) with an elliptic-curve key,
  /// the form of a `PRIVATE KEY` PEM file.
  ///
  /// Versions 0 and 1 are accepted. Attributes are skipped. A public key of version 1 is used when
  /// the inner key has none.
  ///
  /// # Errors
  /// - `InvalidEncoding` if `der` is not strict DER of that structure, or the inner key names
  ///   another curve.
  /// - `UnsupportedAlgorithm` if the algorithm is not `id-ecPublicKey`.
  /// - `UnsupportedCurve` if the curve is explicit, or not one of [`EcCurve`].
  /// - `InvalidLength` if the secret or the public key has the wrong length for the curve.
  pub fn readPkcs8<'a>(der: &'a [u8]) -> Result<EcPrivateKeyDer<'a>, EcKeyError> {
    let outer = element(der, 0, der.length)
    if !outer.valid || outer.tag != 48 || outer.next != der.length {
      return Result<EcPrivateKeyDer<'a>, EcKeyError>.failResult(EcKeyError.InvalidEncoding)
    }
    let version = element(der, outer.start, outer.end)
    if !version.valid || version.tag != 2 || version.end != version.start + 1
      || der[version.start] > 1 {
      return Result<EcPrivateKeyDer<'a>, EcKeyError>.failResult(EcKeyError.InvalidEncoding)
    }
    let versionOne = der[version.start] == 1
    let algorithm = readAlgorithm(der, version.next, outer.end)
    let curve = match move algorithm {
      Result<CurveAt, EcKeyError>.Success { value } => value
      Result<CurveAt, EcKeyError>.Failure { error } => {
        return Result<EcPrivateKeyDer<'a>, EcKeyError>.failResult(error)
      }
    }
    let wrapped = element(der, curve.next, outer.end)
    if !wrapped.valid || wrapped.tag != 4 {
      return Result<EcPrivateKeyDer<'a>, EcKeyError>.failResult(EcKeyError.InvalidEncoding)
    }
    let mut position = wrapped.next
    if position < outer.end && der[position] == 160 {
      let attributes = element(der, position, outer.end)
      if !attributes.valid {
        return Result<EcPrivateKeyDer<'a>, EcKeyError>.failResult(EcKeyError.InvalidEncoding)
      }
      position = attributes.next
    }
    let mut outerPublic = Option<&'a [u8]>.none()
    if position < outer.end && der[position] == 129 {
      let publicKey = element(der, position, outer.end)
      if !versionOne || !publicKey.valid || publicKey.end == publicKey.start
        || der[publicKey.start] != 0 {
        return Result<EcPrivateKeyDer<'a>, EcKeyError>.failResult(EcKeyError.InvalidEncoding)
      }
      outerPublic = Option<&'a [u8]>.some(
        Slice.view<u8>(der, publicKey.start + 1, publicKey.end - publicKey.start - 1),
      )
      position = publicKey.next
    }
    if position != outer.end {
      return Result<EcPrivateKeyDer<'a>, EcKeyError>.failResult(EcKeyError.InvalidEncoding)
    }
    let inner = readEcPrivateKey(der, wrapped.start, wrapped.end, Option<EcCurve>.some(curve.curve))
    let key = match move inner {
      Result<EcPrivateKeyDer<'a>, EcKeyError>.Success { value } => move value
      Result<EcPrivateKeyDer<'a>, EcKeyError>.Failure { error } => {
        return Result<EcPrivateKeyDer<'a>, EcKeyError>.failResult(error)
      }
    }
    let hasInner = match &key.publicKey {
      Option<&[u8]>.Some { .. } => true
      Option<&[u8]>.None => false
    }
    if hasInner {
      return Result<EcPrivateKeyDer<'a>, EcKeyError>.succeed(move key)
    }
    return match move outerPublic {
      Option<&[u8]>.Some { value } => {
        if !pointLengthAllowed(curve.curve, value) {
          return Result<EcPrivateKeyDer<'a>, EcKeyError>.failResult(EcKeyError.InvalidLength)
        }
        return Result<EcPrivateKeyDer<'a>, EcKeyError>.succeed(
          EcPrivateKeyDer {
            curve: curve.curve,
            secret: key.secret,
            publicKey: Option<&'a [u8]>.some(value),
          },
        )
      }
      Option<&[u8]>.None => Result<EcPrivateKeyDer<'a>, EcKeyError>.succeed(move key)
    }
  }

  /// Reads a `SubjectPublicKeyInfo` (RFC 5480) with an elliptic-curve key, the form of a
  /// `PUBLIC KEY` PEM file and of the key in an X.509 certificate.
  ///
  /// # Errors
  /// - `InvalidEncoding` if `der` is not one strict DER `SubjectPublicKeyInfo`.
  /// - `UnsupportedAlgorithm` if the algorithm is not `id-ecPublicKey`.
  /// - `UnsupportedCurve` if the curve is explicit, or not one of [`EcCurve`].
  /// - `InvalidLength` if the public key has the wrong length for the curve.
  pub fn readSpki<'a>(der: &'a [u8]) -> Result<EcPublicKeyDer<'a>, EcKeyError> {
    let outer = element(der, 0, der.length)
    if !outer.valid || outer.tag != 48 || outer.next != der.length {
      return Result<EcPublicKeyDer<'a>, EcKeyError>.failResult(EcKeyError.InvalidEncoding)
    }
    let algorithm = readAlgorithm(der, outer.start, outer.end)
    let curve = match move algorithm {
      Result<CurveAt, EcKeyError>.Success { value } => value
      Result<CurveAt, EcKeyError>.Failure { error } => {
        return Result<EcPublicKeyDer<'a>, EcKeyError>.failResult(error)
      }
    }
    let bits = element(der, curve.next, outer.end)
    if !bits.valid || bits.tag != 3 || bits.next != outer.end || bits.end == bits.start
      || der[bits.start] != 0 {
      return Result<EcPublicKeyDer<'a>, EcKeyError>.failResult(EcKeyError.InvalidEncoding)
    }
    let point = Slice.view<u8>(der, bits.start + 1, bits.end - bits.start - 1)
    if !pointLengthAllowed(curve.curve, point) {
      return Result<EcPublicKeyDer<'a>, EcKeyError>.failResult(EcKeyError.InvalidLength)
    }
    return Result<EcPublicKeyDer<'a>, EcKeyError>.succeed(
      EcPublicKeyDer { curve: curve.curve, publicKey: point },
    )
  }

  /// Writes `secret` and `publicKey` as a SEC1 `ECPrivateKey` that names `curve`, and returns the
  /// length. The bytes of `output` after the DER do not change.
  ///
  /// # Errors
  /// - `InvalidLength` if `secret` is not [`EcCurve.secretLength`] bytes, or `publicKey` is not a
  ///   compressed, uncompressed, or hybrid key of that length for the curve. `output` does not
  ///   change.
  ///
  /// # Gotchas
  /// The program traps if `output` is shorter than the DER, at most 223 bytes.
  pub fn writeSec1(curve: EcCurve, secret: &[u8], publicKey: &[u8], output: &mut [u8]) -> Result<
    usize,
    EcKeyError,
  > {
    if secret.length != curve.secretLength() || !pointLengthAllowed(curve, publicKey) {
      return Result<usize, EcKeyError>.failResult(EcKeyError.InvalidLength)
    }
    return Result<usize, EcKeyError>.succeed(
      writeEcPrivateKey(curve, secret, publicKey, true, &mut output, 0),
    )
  }

  /// Writes `secret` and `publicKey` as a PKCS #8 `PrivateKeyInfo` of version 0 for `curve`, and
  /// returns the length. The inner SEC1 key holds the public key and does not repeat the curve.
  /// The bytes of `output` after the DER do not change.
  ///
  /// # Errors
  /// - `InvalidLength`, as for [`EcKeyDer.writeSec1`].
  ///
  /// # Gotchas
  /// The program traps if `output` is shorter than the DER, at most 241 bytes.
  pub fn writePkcs8(curve: EcCurve, secret: &[u8], publicKey: &[u8], output: &mut [u8]) -> Result<
    usize,
    EcKeyError,
  > {
    if secret.length != curve.secretLength() || !pointLengthAllowed(curve, publicKey) {
      return Result<usize, EcKeyError>.failResult(EcKeyError.InvalidLength)
    }
    let innerContent = ecPrivateKeyLength(curve, publicKey, false)
    let inner = headerLength(innerContent) + innerContent
    let algorithm = algorithmLength(curve)
    let content = 3 + algorithm + headerLength(inner) + inner
    let mut position = writeHeader(&mut output, 0, 48, content)
    position = writeBytes(&mut output, position, b"\x02\x01\x00")
    position = writeAlgorithm(curve, &mut output, position)
    position = writeHeader(&mut output, position, 4, inner)
    position = writeEcPrivateKey(curve, secret, publicKey, false, &mut output, position)
    return Result<usize, EcKeyError>.succeed(position)
  }

  /// Writes `publicKey` as a `SubjectPublicKeyInfo` for `curve`, and returns the length. The bytes
  /// of `output` after the DER do not change.
  ///
  /// # Errors
  /// - `InvalidLength` if `publicKey` is not a compressed, uncompressed, or hybrid key of the right length
  ///   for the curve. `output` does not change.
  ///
  /// # Gotchas
  /// The program traps if `output` is shorter than the DER, at most 158 bytes.
  pub fn writeSpki(curve: EcCurve, publicKey: &[u8], output: &mut [u8]) -> Result<
    usize,
    EcKeyError
  > {
    if !pointLengthAllowed(curve, publicKey) {
      return Result<usize, EcKeyError>.failResult(EcKeyError.InvalidLength)
    }
    let bits = publicKey.length + 1
    let content = algorithmLength(curve) + headerLength(bits) + bits
    let mut position = writeHeader(&mut output, 0, 48, content)
    position = writeAlgorithm(curve, &mut output, position)
    position = writeHeader(&mut output, position, 3, bits)
    output[position] = 0
    position = writeBytes(&mut output, position + 1, publicKey)
    return Result<usize, EcKeyError>.succeed(position)
  }
}

// One DER element: the tag, the content range, and the offset after it.
struct Element {
  tag: u8,
  start: usize,
  end: usize,
  next: usize,
  valid: bool,
}

// Reads the element at `offset` that must end by `limit`. Lengths use the shortest form, and the
// keys here are below 64 KiB.
fn element(bytes: &[u8], offset: usize, limit: usize) -> Element {
  let invalid = Element { tag: 0, start: 0, end: 0, next: 0, valid: false }
  if limit > bytes.length || offset >= limit || limit - offset < 2 {
    return move invalid
  }
  let first = bytes[offset + 1]
  let mut start = offset + 2
  let mut length = u8.toUsize(first)
  if first == 129 {
    if limit - start < 1 || bytes[start] < 128 {
      return move invalid
    }
    length = u8.toUsize(bytes[start])
    start = start + 1
  } else if first == 130 {
    if limit - start < 2 || bytes[start] == 0 {
      return move invalid
    }
    length = u8.toUsize(bytes[start]) * 256 + u8.toUsize(bytes[start + 1])
    if length < 256 {
      return move invalid
    }
    start = start + 2
  } else if first >= 128 {
    return move invalid
  }
  if length > limit - start {
    return move invalid
  }
  return Element {
    tag: bytes[offset],
    start: start,
    end: start + length,
    next: start + length,
    valid: true,
  }
}

fn sameBytes(bytes: &[u8], start: usize, end: usize, expected: &[u8]) -> bool {
  if end - start != expected.length {
    return false
  }
  let mut i: usize = 0
  while i < expected.length {
    if bytes[start + i] != expected[i] {
      return false
    }
    i = i + 1
  }
  return true
}

fn pointLengthAllowed(curve: EcCurve, point: &[u8]) -> bool {
  if point.length == curve.publicKeyLength() {
    return point[0] == 4 || point[0] == 6 || point[0] == 7
  }
  if point.length == curve.compressedPublicKeyLength() {
    return point[0] == 2 || point[0] == 3
  }
  return false
}

// The curve that an OBJECT IDENTIFIER element names.
fn namedCurve(bytes: &[u8], at: &Element) -> Result<EcCurve, EcKeyError> {
  if at.tag != 6 {
    return Result<EcCurve, EcKeyError>.failResult(EcKeyError.UnsupportedCurve)
  }
  return match EcCurve.fromObjectIdentifier(Slice.view<u8>(bytes, at.start, at.end - at.start)) {
    Option<EcCurve>.Some { value } => Result<EcCurve, EcKeyError>.succeed(value)
    Option<EcCurve>.None => Result<EcCurve, EcKeyError>.failResult(EcKeyError.UnsupportedCurve)
  }
}

struct CurveAt {
  curve: EcCurve,
  next: usize,
}

impl Copy for CurveAt {}

// AlgorithmIdentifier { id-ecPublicKey, namedCurve } at `offset`.
fn readAlgorithm(bytes: &[u8], offset: usize, limit: usize) -> Result<CurveAt, EcKeyError> {
  let sequence = element(bytes, offset, limit)
  if !sequence.valid || sequence.tag != 48 {
    return Result<CurveAt, EcKeyError>.failResult(EcKeyError.InvalidEncoding)
  }
  let identifier = element(bytes, sequence.start, sequence.end)
  if !identifier.valid || identifier.tag != 6 {
    return Result<CurveAt, EcKeyError>.failResult(EcKeyError.InvalidEncoding)
  }
  if !sameBytes(bytes, identifier.start, identifier.end, b"\x2a\x86\x48\xce\x3d\x02\x01") {
    return Result<CurveAt, EcKeyError>.failResult(EcKeyError.UnsupportedAlgorithm)
  }
  let parameters = element(bytes, identifier.next, sequence.end)
  if !parameters.valid || parameters.next != sequence.end {
    return Result<CurveAt, EcKeyError>.failResult(EcKeyError.InvalidEncoding)
  }
  let named = namedCurve(bytes, &parameters)
  return match move named {
    Result<EcCurve, EcKeyError>.Success { value } => Result<CurveAt, EcKeyError>.succeed(
      CurveAt { curve: value, next: sequence.next },
    )
    Result<EcCurve, EcKeyError>.Failure { error } => Result<CurveAt, EcKeyError>.failResult(error)
  }
}

// ECPrivateKey in bytes[start..end], which it must fill. `outer` is the curve of a PKCS #8 wrapper.
fn readEcPrivateKey<'a>(
  bytes: &'a [u8],
  start: usize,
  end: usize,
  outer: Option<EcCurve>,
) -> Result<EcPrivateKeyDer<'a>, EcKeyError,> {
  let sequence = element(bytes, start, end)
  if !sequence.valid || sequence.tag != 48 || sequence.next != end {
    return Result<EcPrivateKeyDer<'a>, EcKeyError>.failResult(EcKeyError.InvalidEncoding)
  }
  let version = element(bytes, sequence.start, sequence.end)
  if !version.valid || version.tag != 2 || version.end != version.start + 1
    || bytes[version.start] != 1 {
    return Result<EcPrivateKeyDer<'a>, EcKeyError>.failResult(EcKeyError.InvalidEncoding)
  }
  let secret = element(bytes, version.next, sequence.end)
  if !secret.valid || secret.tag != 4 {
    return Result<EcPrivateKeyDer<'a>, EcKeyError>.failResult(EcKeyError.InvalidEncoding)
  }
  let mut position = secret.next
  let mut curve = move outer
  if position < sequence.end && bytes[position] == 160 {
    let wrapper = element(bytes, position, sequence.end)
    if !wrapper.valid {
      return Result<EcPrivateKeyDer<'a>, EcKeyError>.failResult(EcKeyError.InvalidEncoding)
    }
    let identifier = element(bytes, wrapper.start, wrapper.end)
    if !identifier.valid || identifier.next != wrapper.end {
      return Result<EcPrivateKeyDer<'a>, EcKeyError>.failResult(EcKeyError.InvalidEncoding)
    }
    let named = match move namedCurve(bytes, &identifier) {
      Result<EcCurve, EcKeyError>.Success { value } => value
      Result<EcCurve, EcKeyError>.Failure { error } => {
        return Result<EcPrivateKeyDer<'a>, EcKeyError>.failResult(error)
      }
    }
    let conflicts = match &curve {
      Option<EcCurve>.Some { value } => value != named
      Option<EcCurve>.None => false
    }
    if conflicts {
      return Result<EcPrivateKeyDer<'a>, EcKeyError>.failResult(EcKeyError.InvalidEncoding)
    }
    curve = Option<EcCurve>.some(named)
    position = wrapper.next
  }
  let mut publicKey = Option<&'a [u8]>.none()
  if position < sequence.end && bytes[position] == 161 {
    let wrapper = element(bytes, position, sequence.end)
    if !wrapper.valid {
      return Result<EcPrivateKeyDer<'a>, EcKeyError>.failResult(EcKeyError.InvalidEncoding)
    }
    let bits = element(bytes, wrapper.start, wrapper.end)
    if !bits.valid || bits.tag != 3 || bits.next != wrapper.end || bits.end == bits.start
      || bytes[bits.start] != 0 {
      return Result<EcPrivateKeyDer<'a>, EcKeyError>.failResult(EcKeyError.InvalidEncoding)
    }
    publicKey = Option<&'a [u8]>.some(
      Slice.view<u8>(bytes, bits.start + 1, bits.end - bits.start - 1),
    )
    position = wrapper.next
  }
  if position != sequence.end {
    return Result<EcPrivateKeyDer<'a>, EcKeyError>.failResult(EcKeyError.InvalidEncoding)
  }
  let known = match move curve {
    Option<EcCurve>.Some { value } => value
    Option<EcCurve>.None => {
      return Result<EcPrivateKeyDer<'a>, EcKeyError>.failResult(EcKeyError.UnsupportedCurve)
    }
  }
  if secret.end - secret.start != known.secretLength() {
    return Result<EcPrivateKeyDer<'a>, EcKeyError>.failResult(EcKeyError.InvalidLength)
  }
  let pointAllowed = match &publicKey {
    Option<&[u8]>.Some { value } => pointLengthAllowed(known, value)
    Option<&[u8]>.None => true
  }
  if !pointAllowed {
    return Result<EcPrivateKeyDer<'a>, EcKeyError>.failResult(EcKeyError.InvalidLength)
  }
  return Result<EcPrivateKeyDer<'a>, EcKeyError>.succeed(
    EcPrivateKeyDer {
      curve: known,
      secret: Slice.view<u8>(bytes, secret.start, secret.end - secret.start),
      publicKey: move publicKey,
    },
  )
}

fn headerLength(length: usize) -> usize {
  if length < 128 {
    return 2
  }
  if length < 256 {
    return 3
  }
  return 4
}

fn writeHeader(output: &mut [u8], position: usize, tag: u8, length: usize) -> usize {
  output[position] = tag
  if length < 128 {
    output[position + 1] = usize.toU8(length)
    return position + 2
  }
  if length < 256 {
    output[position + 1] = 129
    output[position + 2] = usize.toU8(length)
    return position + 3
  }
  output[position + 1] = 130
  output[position + 2] = usize.toU8(length / 256)
  output[position + 3] = usize.toU8(length % 256)
  return position + 4
}

fn writeBytes(output: &mut [u8], position: usize, bytes: &[u8]) -> usize {
  let mut i: usize = 0
  while i < bytes.length {
    output[position + i] = bytes[i]
    i = i + 1
  }
  return position + bytes.length
}

fn algorithmLength(curve: EcCurve) -> usize {
  return 2 + 9 + 2 + curve.objectIdentifier().length
}

fn writeAlgorithm(curve: EcCurve, output: &mut [u8], position: usize) -> usize {
  let identifier = curve.objectIdentifier()
  let mut at = writeHeader(&mut output, position, 48, 9 + 2 + identifier.length)
  at = writeBytes(&mut output, at, b"\x06\x07\x2a\x86\x48\xce\x3d\x02\x01")
  at = writeHeader(&mut output, at, 6, identifier.length)
  return writeBytes(&mut output, at, identifier)
}

// The content length of an ECPrivateKey SEQUENCE.
fn ecPrivateKeyLength(curve: EcCurve, publicKey: &[u8], named: bool) -> usize {
  let mut length = 3 + 2 + curve.secretLength()
  if named {
    length = length + 4 + curve.objectIdentifier().length
  }
  let bits = publicKey.length + 1
  return length + headerLength(headerLength(bits) + bits) + headerLength(bits) + bits
}

fn writeEcPrivateKey(
  curve: EcCurve,
  secret: &[u8],
  publicKey: &[u8],
  named: bool,
  output: &mut [u8],
  position: usize,
) -> usize {
  let content = ecPrivateKeyLength(curve, publicKey, named)
  let mut at = writeHeader(&mut output, position, 48, content)
  at = writeBytes(&mut output, at, b"\x02\x01\x01")
  at = writeHeader(&mut output, at, 4, secret.length)
  at = writeBytes(&mut output, at, secret)
  if named {
    let identifier = curve.objectIdentifier()
    at = writeHeader(&mut output, at, 160, identifier.length + 2)
    at = writeHeader(&mut output, at, 6, identifier.length)
    at = writeBytes(&mut output, at, identifier)
  }
  let bits = publicKey.length + 1
  at = writeHeader(&mut output, at, 161, headerLength(bits) + bits)
  at = writeHeader(&mut output, at, 3, bits)
  output[at] = 0
  return writeBytes(&mut output, at + 1, publicKey)
}
