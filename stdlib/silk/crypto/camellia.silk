const SIGMA: [u64; 6] = [
  0xa09e667f3bcc908b,
  0xb67ae8584caa73b2,
  0xc6ef372fe94f82be,
  0x54ff53a5f1d36f1c,
  0x10e527fade682d1d,
  0xb05688c2b3e6c1fd,
]

// The subkeys in the order a block uses them: `whitening` holds kw1 to kw4, `round` holds k1 to
// k18 or k24, and `layer` holds the FL and FL^-1 keys ke1 to ke4 or ke6.
struct Schedule {
  whitening: [u64; 4],
  round: [u64; 24],
  layer: [u64; 6],
  rounds: usize,
}

/// A Camellia key schedule.
///
/// # Details
///
/// Make one with [`Camellia.make`] and run it in a mode from `silk.crypto.block_cipher`, or call
/// `encryptBlock` and `decryptBlock` of `BlockCipher` on one 16-byte block.
pub struct Camellia {
  encryption: Schedule,
  decryption: Schedule,
}

impl Camellia {
  /// Returns the key schedule of `key`, which is 16, 24, or 32 bytes.
  ///
  /// # Errors
  ///
  /// - `InvalidKeyLength` if `key` is not 16, 24, or 32 bytes.
  pub fn make(key: &[u8]) -> Result<Camellia, BlockCipherError> {
    if key.length != 16 && key.length != 24 && key.length != 32 {
      return Result<Camellia, BlockCipherError>.failResult(BlockCipherError.InvalidKeyLength)
    }
    let leftHigh = load(key, 0)
    let leftLow = load(key, 8)
    let mut rightHigh: u64 = 0
    let mut rightLow: u64 = 0
    if key.length == 24 {
      rightHigh = load(key, 16)
      rightLow = u64.bitXor(rightHigh, 0xffffffffffffffff)
    } else if key.length == 32 {
      rightHigh = load(key, 16)
      rightLow = load(key, 24)
    }
    let mut d1 = u64.bitXor(leftHigh, rightHigh)
    let mut d2 = u64.bitXor(leftLow, rightLow)
    d2 = u64.bitXor(d2, feistel(d1, SIGMA[0]))
    d1 = u64.bitXor(d1, feistel(d2, SIGMA[1]))
    d1 = u64.bitXor(d1, leftHigh)
    d2 = u64.bitXor(d2, leftLow)
    d2 = u64.bitXor(d2, feistel(d1, SIGMA[2]))
    d1 = u64.bitXor(d1, feistel(d2, SIGMA[3]))
    let aHigh = d1
    let aLow = d2
    d1 = u64.bitXor(aHigh, rightHigh)
    d2 = u64.bitXor(aLow, rightLow)
    d2 = u64.bitXor(d2, feistel(d1, SIGMA[4]))
    d1 = u64.bitXor(d1, feistel(d2, SIGMA[5]))
    let left: [u64; 2] = [leftHigh, leftLow]
    let right: [u64; 2] = [rightHigh, rightLow]
    let a: [u64; 2] = [aHigh, aLow]
    let b: [u64; 2] = [d1, d2]
    let mut schedule = Schedule { whitening: [0; 4], round: [0; 24], layer: [0; 6], rounds: 18 }
    if key.length == 16 {
      place(&mut schedule.whitening, 0, &left, 0)
      place(&mut schedule.whitening, 2, &a, 111)
      place(&mut schedule.round, 0, &a, 0)
      place(&mut schedule.round, 2, &left, 15)
      place(&mut schedule.round, 4, &a, 15)
      place(&mut schedule.round, 6, &left, 45)
      // k9 and k10 take the high half of KA <<< 45 and the low half of KL <<< 60.
      schedule.round[8] = rotate(&a, 45)[0]
      schedule.round[9] = rotate(&left, 60)[1]
      place(&mut schedule.round, 10, &a, 60)
      place(&mut schedule.round, 12, &left, 94)
      place(&mut schedule.round, 14, &a, 94)
      place(&mut schedule.round, 16, &left, 111)
      place(&mut schedule.layer, 0, &a, 30)
      place(&mut schedule.layer, 2, &left, 77)
    } else {
      schedule.rounds = 24
      place(&mut schedule.whitening, 0, &left, 0)
      place(&mut schedule.whitening, 2, &b, 111)
      place(&mut schedule.round, 0, &b, 0)
      place(&mut schedule.round, 2, &right, 15)
      place(&mut schedule.round, 4, &a, 15)
      place(&mut schedule.round, 6, &b, 30)
      place(&mut schedule.round, 8, &left, 45)
      place(&mut schedule.round, 10, &a, 45)
      place(&mut schedule.round, 12, &right, 60)
      place(&mut schedule.round, 14, &b, 60)
      place(&mut schedule.round, 16, &left, 77)
      place(&mut schedule.round, 18, &right, 94)
      place(&mut schedule.round, 20, &a, 94)
      place(&mut schedule.round, 22, &left, 111)
      place(&mut schedule.layer, 0, &right, 30)
      place(&mut schedule.layer, 2, &left, 60)
      place(&mut schedule.layer, 4, &a, 77)
    }
    // Decryption runs the same network with the subkeys in reverse order.
    let layers = schedule.rounds / 3 - 2
    let mut reverse = Schedule { whitening: [0; 4], round: [0; 24], layer: [0; 6], rounds: schedule.rounds }
    reverse.whitening = [schedule.whitening[2], schedule.whitening[3], schedule.whitening[0], schedule.whitening[1]]
    let mut index: usize = 0
    while index < schedule.rounds {
      reverse.round[index] = schedule.round[schedule.rounds - 1 - index]
      index = index + 1
    }
    index = 0
    while index < layers {
      reverse.layer[index] = schedule.layer[layers - 1 - index]
      index = index + 1
    }
    return Result<Camellia, BlockCipherError>.succeed(Camellia { encryption: move schedule, decryption: move reverse })
  }
}

impl BlockCipher for Camellia {
  /// Returns 16.
  fn blockLength(self: &Self) -> usize {
    return 16
  }

  /// Encrypts the 16 bytes of `block` in place.
  fn encryptBlock(self: &Self, block: &mut [u8; 16]) -> () {
    crypt(&self.encryption, &mut block)
  }

  /// Decrypts the 16 bytes of `block` in place.
  fn decryptBlock(self: &Self, block: &mut [u8; 16]) -> () {
    crypt(&self.decryption, &mut block)
  }
}

fn load(bytes: &[u8], offset: usize) -> u64 {
  let mut value: u64 = 0
  let mut index: usize = 0
  while index < 8 {
    value = u64.bitOr(u64.shiftLeft(value, 8), u8.toU64(bytes[offset + index]))
    index = index + 1
  }
  return value
}

fn store(block: &mut [u8; 16], offset: usize, value: u64) -> () {
  let mut index: usize = 0
  while index < 8 {
    block[offset + index] = u64.toU8(u64.bitAnd(u64.shiftRight(value, usize.toU64(56 - 8 * index)), 255))
    index = index + 1
  }
}

// The 128-bit value `value` (high half first) rotated left by `count` bits.
fn rotate(value: &[u64; 2], count: usize) -> [u64; 2] {
  let mut high = value[0]
  let mut low = value[1]
  if count >= 64 {
    let swap = high
    high = low
    low = swap
  }
  let shift = usize.toU64(count % 64)
  if shift == 0 {
    return [high, low]
  }
  return [
    u64.bitOr(u64.shiftLeft(high, shift), u64.shiftRight(low, 64 - shift)),
    u64.bitOr(u64.shiftLeft(low, shift), u64.shiftRight(high, 64 - shift)),
  ]
}

// Writes both halves of `value` rotated left by `count` bits at `offset` of `keys`.
fn place(keys: &mut [u64], offset: usize, value: &[u64; 2], count: usize) -> () {
  let rotated = rotate(value, count)
  keys[offset] = rotated[0]
  keys[offset + 1] = rotated[1]
}

fn byte(value: u64, index: u64) -> usize {
  return u64.toUsize(u64.bitAnd(u64.shiftRight(value, 56 - 8 * index), 255))
}

// The F function of RFC 3713 section 2.4.1: S-boxes, then the P function.
fn feistel(input: u64, key: u64) -> u64 {
  let x = u64.bitXor(input, key)
  let t1 = SBOX1[byte(x, 0)]
  let t2 = SBOX2[byte(x, 1)]
  let t3 = SBOX3[byte(x, 2)]
  let t4 = SBOX4[byte(x, 3)]
  let t5 = SBOX2[byte(x, 4)]
  let t6 = SBOX3[byte(x, 5)]
  let t7 = SBOX4[byte(x, 6)]
  let t8 = SBOX1[byte(x, 7)]
  let y1 = u8.bitXor(u8.bitXor(u8.bitXor(t1, t3), u8.bitXor(t4, t6)), u8.bitXor(t7, t8))
  let y2 = u8.bitXor(u8.bitXor(u8.bitXor(t1, t2), u8.bitXor(t4, t5)), u8.bitXor(t7, t8))
  let y3 = u8.bitXor(u8.bitXor(u8.bitXor(t1, t2), u8.bitXor(t3, t5)), u8.bitXor(t6, t8))
  let y4 = u8.bitXor(u8.bitXor(u8.bitXor(t2, t3), u8.bitXor(t4, t5)), u8.bitXor(t6, t7))
  let y5 = u8.bitXor(u8.bitXor(t1, t2), u8.bitXor(u8.bitXor(t6, t7), t8))
  let y6 = u8.bitXor(u8.bitXor(t2, t3), u8.bitXor(u8.bitXor(t5, t7), t8))
  let y7 = u8.bitXor(u8.bitXor(t3, t4), u8.bitXor(u8.bitXor(t5, t6), t8))
  let y8 = u8.bitXor(u8.bitXor(t1, t4), u8.bitXor(u8.bitXor(t5, t6), t7))
  let high = u32.bitOr(
    u32.bitOr(u32.shiftLeft(u8.toU32(y1), 24), u32.shiftLeft(u8.toU32(y2), 16)),
    u32.bitOr(u32.shiftLeft(u8.toU32(y3), 8), u8.toU32(y4)),
  )
  let low = u32.bitOr(
    u32.bitOr(u32.shiftLeft(u8.toU32(y5), 24), u32.shiftLeft(u8.toU32(y6), 16)),
    u32.bitOr(u32.shiftLeft(u8.toU32(y7), 8), u8.toU32(y8)),
  )
  return u64.bitOr(u64.shiftLeft(u32.toU64(high), 32), u32.toU64(low))
}

fn layer(value: u64, key: u64) -> u64 {
  let mut x1 = u64.toU32(u64.shiftRight(value, 32))
  let mut x2 = u64.toU32(u64.bitAnd(value, 0xffffffff))
  let k1 = u64.toU32(u64.shiftRight(key, 32))
  let k2 = u64.toU32(u64.bitAnd(key, 0xffffffff))
  x2 = u32.bitXor(x2, u32.rotateLeft(u32.bitAnd(x1, k1), 1))
  x1 = u32.bitXor(x1, u32.bitOr(x2, k2))
  return u64.bitOr(u64.shiftLeft(u32.toU64(x1), 32), u32.toU64(x2))
}

fn inverseLayer(value: u64, key: u64) -> u64 {
  let mut y1 = u64.toU32(u64.shiftRight(value, 32))
  let mut y2 = u64.toU32(u64.bitAnd(value, 0xffffffff))
  let k1 = u64.toU32(u64.shiftRight(key, 32))
  let k2 = u64.toU32(u64.bitAnd(key, 0xffffffff))
  y1 = u32.bitXor(y1, u32.bitOr(y2, k2))
  y2 = u32.bitXor(y2, u32.rotateLeft(u32.bitAnd(y1, k1), 1))
  return u64.bitOr(u64.shiftLeft(u32.toU64(y1), 32), u32.toU64(y2))
}

// RFC 3713 section 2.3: six-round groups split by FL and FL^-1 layers, with whitening on both
// ends.
fn crypt(schedule: &Schedule, block: &mut [u8; 16]) -> () {
  let mut d1 = u64.bitXor(load(&block.*, 0), schedule.whitening[0])
  let mut d2 = u64.bitXor(load(&block.*, 8), schedule.whitening[1])
  let mut pair: usize = 0
  while pair < schedule.rounds / 2 {
    if pair > 0 && pair % 3 == 0 {
      let index = (pair / 3 - 1) * 2
      d1 = layer(d1, schedule.layer[index])
      d2 = inverseLayer(d2, schedule.layer[index + 1])
    }
    d2 = u64.bitXor(d2, feistel(d1, schedule.round[2 * pair]))
    d1 = u64.bitXor(d1, feistel(d2, schedule.round[2 * pair + 1]))
    pair = pair + 1
  }
  store(&mut block, 0, u64.bitXor(d2, schedule.whitening[2]))
  store(&mut block, 8, u64.bitXor(d1, schedule.whitening[3]))
}
