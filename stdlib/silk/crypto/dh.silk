//! Finite-field Diffie-Hellman key agreement (DH) over a prime modulus.
//!
//! # When to use
//! Use [`DhPrivateKey`] where a protocol needs classic Diffie-Hellman, such as Node.js
//! `crypto.createDiffieHellman` and `crypto.getDiffieHellman`, SSH `diffie-hellman-group14`, or the
//! TLS groups `ffdhe2048` and up. For a new design, `silk.crypto.x25519` is faster and simpler.
//!
//! # Details
//! A [`DhGroup`] is a prime `p` and a generator `g`. [`DhGroup.named`] gives the MODP groups of RFC
//! 2409 and RFC 3526 and the FFDHE groups of RFC 7919, all with `g = 2`. [`DhGroup.make`] takes any
//! odd prime from 512 to 8192 bits. A secret `x` gives the public key `g^x mod p`, and
//! [`DhPrivateKey.agree`] returns `y^x mod p` for the peer key `y`, big-endian and padded to the
//! length of `p`, as Node.js and TLS expect. The exponentiation takes the same time for every
//! secret of a group. Nothing allocates.
//!
//! # Errors
//! - [`DhError`] for a group, a secret, or a peer key that is not valid.
//!
//! # Gotchas
//! [`DhGroup.make`] does not test that `p` is prime. Call [`DhGroup.check`] on a group from a
//! source that you do not trust, and use only safe primes. The key exchange does not authenticate the
//! peer. Pass the shared secret through `silk.crypto.hkdf` before you use it as a key. The secret
//! is not erased when it is dropped.
//!
//! # Examples
//! ## Agree on a shared secret
//! ```silk
//! import silk.crypto.dh { DhError, DhGroup, DhNamedGroup, DhPrivateKey }
//! import silk.crypto.modular { Natural }
//! import silk.core.result { Result }
//!
//! pub fn main() -> i32 {
//!   let group = DhGroup.named(DhNamedGroup.Modp14)
//!   // Real programs use `DhPrivateKey.generate(&group)` with a secure `Random` provider.
//!   let alice = match DhPrivateKey.fromBytes(&group, b"\x51\x7a\x2c\x09\x33") {
//!     Result<DhPrivateKey, DhError>.Success { value } => value
//!     Result<DhPrivateKey, DhError>.Failure {..} => {
//!       return 1
//!     }
//!   }
//!   let bob = match DhPrivateKey.fromBytes(&group, b"\x07\xe2\x91\x4c\x6d") {
//!     Result<DhPrivateKey, DhError>.Success { value } => value
//!     Result<DhPrivateKey, DhError>.Failure {..} => {
//!       return 1
//!     }
//!   }
//!   let mut alicePublic: [u8; 256] = [0; 256]
//!   let mut bobPublic: [u8; 256] = [0; 256]
//!   alice.writePublicKey(&mut alicePublic)
//!   bob.writePublicKey(&mut bobPublic)
//!
//!   let mut fromAlice: [u8; 256] = [0; 256]
//!   let mut fromBob: [u8; 256] = [0; 256]
//!   match alice.agree(&bobPublic, &mut fromAlice) {
//!     Result<(), DhError>.Success {..} => {}
//!     Result<(), DhError>.Failure {..} => {
//!       return 1
//!     }
//!   }
//!   match bob.agree(&alicePublic, &mut fromBob) {
//!     Result<(), DhError>.Success {..} => {}
//!     Result<(), DhError>.Failure {..} => {
//!       return 1
//!     }
//!   }
//!   let mut i: usize = 0
//!   while i < 256 {
//!     if fromAlice[i] != fromBob[i] {
//!       return 1
//!     }
//!     i = i + 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Cryptography

import silk.collections.slice { Slice }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.crypto.modular { ModularError, Modulus, Natural }
import silk.crypto.prime { Prime }
import silk.io.writer { Writer, WriterError }
import silk.num.u8
import silk.num.u32
import silk.num.usize
import silk.system.random { Random }
import silk.text.format { Debug, Format, Formatter }

/// The reason that a DH group, secret, or peer key is not valid. It holds no secret bytes.
pub enum DhError {
  /// The prime is even, or not from 512 to 8192 bits.
  InvalidPrime,
  /// The generator is not from 2 to `p - 2`.
  InvalidGenerator,
  /// The secret is 0, or not less than `p`.
  InvalidSecret,
  /// The peer key is 0 or 1. OpenSSL calls this a key that is too small.
  KeyTooSmall,
  /// The peer key is `p - 1` or more. OpenSSL calls this a key that is too large.
  KeyTooLarge,
  /// An output does not have the length of the prime.
  InvalidLength,
}

impl Debug for DhError {
  /// Writes the name of the variant, such as `InvalidPrime`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return match &self.* {
      DhError.InvalidPrime => run Format.write(&mut formatter, b"InvalidPrime")
      DhError.InvalidGenerator => run Format.write(&mut formatter, b"InvalidGenerator")
      DhError.InvalidSecret => run Format.write(&mut formatter, b"InvalidSecret")
      DhError.KeyTooSmall => run Format.write(&mut formatter, b"KeyTooSmall")
      DhError.KeyTooLarge => run Format.write(&mut formatter, b"KeyTooLarge")
      DhError.InvalidLength => run Format.write(&mut formatter, b"InvalidLength")
    }
  }
}

/// A standard DH group. Every one has the generator 2 and a safe prime `p = 2q + 1`.
pub enum DhNamedGroup {
  /// The 768-bit MODP group 1 of RFC 2409. It is too small to be secure; use it only to talk to old systems.
  Modp1,
  /// The 1024-bit MODP group 2 of RFC 2409. It is too small to be secure; use it only to talk to old systems.
  Modp2,
  /// The 1536-bit MODP group 5 of RFC 3526.
  Modp5,
  /// The 2048-bit MODP group 14 of RFC 3526.
  Modp14,
  /// The 3072-bit MODP group 15 of RFC 3526.
  Modp15,
  /// The 4096-bit MODP group 16 of RFC 3526.
  Modp16,
  /// The 6144-bit MODP group 17 of RFC 3526.
  Modp17,
  /// The 8192-bit MODP group 18 of RFC 3526.
  Modp18,
  /// The 2048-bit group `ffdhe2048` of RFC 7919, for TLS.
  Ffdhe2048,
  /// The 3072-bit group `ffdhe3072` of RFC 7919, for TLS.
  Ffdhe3072,
  /// The 4096-bit group `ffdhe4096` of RFC 7919, for TLS.
  Ffdhe4096,
  /// The 6144-bit group `ffdhe6144` of RFC 7919, for TLS.
  Ffdhe6144,
  /// The 8192-bit group `ffdhe8192` of RFC 7919, for TLS.
  Ffdhe8192,
}

impl Debug for DhNamedGroup {
  /// Writes the name of the variant, such as `Modp14`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return match &self.* {
      DhNamedGroup.Modp1 => run Format.write(&mut formatter, b"Modp1")
      DhNamedGroup.Modp2 => run Format.write(&mut formatter, b"Modp2")
      DhNamedGroup.Modp5 => run Format.write(&mut formatter, b"Modp5")
      DhNamedGroup.Modp14 => run Format.write(&mut formatter, b"Modp14")
      DhNamedGroup.Modp15 => run Format.write(&mut formatter, b"Modp15")
      DhNamedGroup.Modp16 => run Format.write(&mut formatter, b"Modp16")
      DhNamedGroup.Modp17 => run Format.write(&mut formatter, b"Modp17")
      DhNamedGroup.Modp18 => run Format.write(&mut formatter, b"Modp18")
      DhNamedGroup.Ffdhe2048 => run Format.write(&mut formatter, b"Ffdhe2048")
      DhNamedGroup.Ffdhe3072 => run Format.write(&mut formatter, b"Ffdhe3072")
      DhNamedGroup.Ffdhe4096 => run Format.write(&mut formatter, b"Ffdhe4096")
      DhNamedGroup.Ffdhe6144 => run Format.write(&mut formatter, b"Ffdhe6144")
      DhNamedGroup.Ffdhe8192 => run Format.write(&mut formatter, b"Ffdhe8192")
    }
  }
}

/// A DH group: a prime modulus `p` and a generator `g`.
///
/// # When to use
/// Use [`DhGroup.named`] for a standard group, or [`DhGroup.make`] for a group that the peer sends.
///
/// # Details
/// The group is a fixed-size `Copy` value of about 3 KiB that does not allocate.
pub struct DhGroup {
  modulus: Modulus,
  g: Natural,
  length: usize,
}

impl Copy for DhGroup {}

impl DhGroup {
  /// Returns the standard group `group`.
  pub fn named(group: DhNamedGroup) -> DhGroup {
    let prime = hexNatural(namedPrime(group))
    return match DhGroup.fromNaturals(&prime, &Natural.fromU64(2)) {
      Result<DhGroup, DhError>.Success { value } => value
      Result<DhGroup, DhError>.Failure { .. } => Intrinsic.trap(
        "DhGroup.named: the standard groups are valid",
      )
    }
  }

  /// Returns the group with the big-endian prime `prime` and generator `generator`.
  ///
  /// Leading zero bytes are allowed.
  ///
  /// # Errors
  /// - `InvalidPrime` if the prime is even, or not from 512 to 8192 bits.
  /// - `InvalidGenerator` if the generator is not from 2 to `p - 2`.
  ///
  /// # Gotchas
  /// It does not test that `prime` is prime; [`DhGroup.check`] does.
  pub fn make(prime: &[u8], generator: &[u8]) -> Result<DhGroup, DhError> {
    let p = match Natural.fromBytes(prime) {
      Result<Natural, ModularError>.Success { value } => value
      Result<Natural, ModularError>.Failure { .. } => {
        return Result<DhGroup, DhError>.failResult(DhError.InvalidPrime)
      }
    }
    let g = match Natural.fromBytes(generator) {
      Result<Natural, ModularError>.Success { value } => value
      Result<Natural, ModularError>.Failure { .. } => {
        return Result<DhGroup, DhError>.failResult(DhError.InvalidGenerator)
      }
    }
    return DhGroup.fromNaturals(&p, &g)
  }

  /// Returns the prime `p`, with the word length of the group.
  pub fn prime(self: &Self) -> Natural {
    return self.modulus.natural()
  }

  /// Returns the generator `g`, with the word length of the group.
  pub fn generator(self: &Self) -> Natural {
    return self.g
  }

  /// Returns the length of `p` in bytes, such as 256 for a 2048-bit group. Public keys and shared
  /// secrets have this length.
  pub fn primeLength(self: &Self) -> usize {
    return self.length
  }

  /// Returns the length of `p` in bits.
  pub fn primeBits(self: &Self) -> usize {
    return self.modulus.bitLength()
  }

  /// Tests whether `p` is prime and whether `(p - 1) / 2` is prime too, as OpenSSL `DH_check`
  /// does for a group without a known subgroup order.
  ///
  /// It uses `silk.crypto.prime` with [`Prime.recommendedRounds`] and reads random bases from the
  /// ambient `Random`. For an 8192-bit group it takes seconds, so check a custom group once, and do
  /// not check the named groups, which are safe primes.
  pub effect fn check(self: &Self) -> DhCheck
    ? &mut Random {
    let p = self.modulus.natural()
    let rounds = Prime.recommendedRounds(p.bitLength())
    if !run Prime.isProbablePrime(&p, rounds) {
      return DhCheck { prime: false, safePrime: false }
    }
    let half = p.shiftRight(1)
    return DhCheck { prime: true, safePrime: run Prime.isProbablePrime(&half, rounds) }
  }

  fn fromNaturals(prime: &Natural, generator: &Natural) -> Result<DhGroup, DhError> {
    let bits = prime.bitLength()
    if bits < 512 || bits > 8192 {
      return Result<DhGroup, DhError>.failResult(DhError.InvalidPrime)
    }
    let modulus = match Modulus.make(prime) {
      Result<Modulus, ModularError>.Success { value } => value
      Result<Modulus, ModularError>.Failure { .. } => {
        return Result<DhGroup, DhError>.failResult(DhError.InvalidPrime)
      }
    }
    let words = modulus.wordLength()
    let p = modulus.natural()
    let below = match p.subtract(&Natural.fromU64(1)) {
      Result<Natural, ModularError>.Success { value } => value
      Result<Natural, ModularError>.Failure { .. } => {
        return Result<DhGroup, DhError>.failResult(DhError.InvalidPrime)
      }
    }
    if generator.lessThan(&Natural.fromU64(2)) || !generator.lessThan(&below) {
      return Result<DhGroup, DhError>.failResult(DhError.InvalidGenerator)
    }
    let fitted = match generator.resize(words) {
      Result<Natural, ModularError>.Success { value } => value
      Result<Natural, ModularError>.Failure { .. } => {
        return Result<DhGroup, DhError>.failResult(DhError.InvalidGenerator)
      }
    }
    return Result<DhGroup, DhError>.succeed(
      DhGroup { modulus: modulus, g: fitted, length: (bits + 7) / 8 },
    )
  }
}

/// The result of [`DhGroup.check`]: whether the prime of a group is prime and safe.
///
/// # Details
/// Node.js reports the same facts as `verifyError`: `DH_CHECK_P_NOT_PRIME` (1) when
/// [`DhCheck.prime`] is false, and `DH_CHECK_P_NOT_SAFE_PRIME` (2) when [`DhCheck.safePrime`] is
/// false.
pub struct DhCheck {
  /// Whether `p` passed the primality test.
  pub prime: bool,
  /// Whether `p` and `(p - 1) / 2` both passed the primality test.
  pub safePrime: bool,
}

/// A DH secret with its group and public key.
///
/// # When to use
/// Make one with [`DhPrivateKey.generate`] for each key exchange, send the public key from
/// [`DhPrivateKey.writePublicKey`], and call [`DhPrivateKey.agree`] with the peer key.
///
/// # Details
/// The value is a fixed-size `Copy` value of about 5 KiB that does not allocate. The secret has the
/// word length of the group, so every exponentiation in a group takes the same time.
///
/// # Gotchas
/// Pass the shared secret through `silk.crypto.hkdf` before you use it as a key. The secret is not
/// erased when it is dropped.
pub struct DhPrivateKey {
  parameters: DhGroup,
  x: Natural,
  y: Natural,
}

impl Copy for DhPrivateKey {}

impl DhPrivateKey {
  /// Returns a new random secret in `group`, with bytes from the ambient `Random`.
  ///
  /// The secret is uniform from 2 to `2^(n - 1) - 1` for an `n`-bit prime, as in OpenSSL. The
  /// `Random` provider must be cryptographically secure. If it fails, the program stops.
  pub effect fn generate(group: &DhGroup) -> DhPrivateKey
    ? &mut Random {
    let length = group.length
    let bits = group.modulus.bitLength()
    let mut bytes: [u8; 1024] = [0; 1024]
    let two = Natural.fromU64(2)
    while true {
      run Random.fillBytes(Slice.viewMut<u8>(&mut bytes, 0, length))

      // Keep the low n - 1 bits of the n-bit prime, so the secret is below p.
      let extra = length * 8 - (bits - 1)
      bytes[0] = u8.bitAnd(bytes[0], u32.toU8(u32.shiftRight(255, usize.toU32(extra))))
      let secret = match Natural.fromBytes(Slice.view<u8>(&bytes, 0, length)) {
        Result<Natural, ModularError>.Success { value } => value
        Result<Natural, ModularError>.Failure { .. } => Intrinsic.trap(
          "DhPrivateKey.generate: the secret fits",
        )
      }
      if !secret.lessThan(&two) {
        return keyFor(group, &secret)
      }
    }
    return Intrinsic.trap("DhPrivateKey.generate: the loop returns")
  }

  /// Returns the key for the big-endian secret `secret` in `group`, as Node.js
  /// `setPrivateKey` does.
  ///
  /// Leading zero bytes are allowed.
  ///
  /// # Errors
  /// - `InvalidSecret` if the secret is 0, or not less than `p`.
  pub fn fromBytes(group: &DhGroup, secret: &[u8]) -> Result<DhPrivateKey, DhError> {
    let value = match Natural.fromBytes(secret) {
      Result<Natural, ModularError>.Success { value: parsed } => parsed
      Result<Natural, ModularError>.Failure { .. } => {
        return Result<DhPrivateKey, DhError>.failResult(DhError.InvalidSecret)
      }
    }
    let p = group.modulus.natural()
    if value.isZero() || !value.lessThan(&p) {
      return Result<DhPrivateKey, DhError>.failResult(DhError.InvalidSecret)
    }
    return Result<DhPrivateKey, DhError>.succeed(keyFor(group, &value))
  }

  /// Returns the group of the key.
  pub fn group(self: &Self) -> DhGroup {
    return self.parameters
  }

  /// Returns the secret `x`, with the word length of the group.
  ///
  /// # Gotchas
  /// The value is the private key. Keep it secret.
  pub fn secret(self: &Self) -> Natural {
    return self.x
  }

  /// Returns the public key `g^x mod p`, with the word length of the group.
  pub fn publicKey(self: &Self) -> Natural {
    return self.y
  }

  /// Writes the public key to all of `output`, big-endian with leading zero bytes.
  ///
  /// # Gotchas
  /// The program traps if `output` is shorter than [`DhGroup.primeLength`].
  pub fn writePublicKey(self: &Self, output: &mut [u8]) -> () {
    match self.y.writeBytes(move output) {
      Result<(), ModularError>.Success { .. } => {}
      Result<(), ModularError>.Failure { .. } => Intrinsic.trap(
        "DhPrivateKey.writePublicKey: the output is shorter than the prime",
      )
    }
  }

  /// Writes the shared secret `y^x mod p` for the big-endian peer key `peer` to `output`,
  /// big-endian and padded with leading zero bytes to the length of `p`.
  ///
  /// Leading zero bytes in `peer` are allowed. The time does not depend on the secret or on the
  /// value of the peer key.
  ///
  /// # Errors
  /// - `InvalidLength` if `output` is not [`DhGroup.primeLength`] bytes.
  /// - `KeyTooSmall` if the peer key is 0 or 1.
  /// - `KeyTooLarge` if the peer key is `p - 1` or more.
  ///
  /// `output` does not change when it fails.
  pub fn agree(self: &Self, peer: &[u8], output: &mut [u8]) -> Result<(), DhError> {
    if output.length != self.parameters.length {
      return Result<(), DhError>.failResult(DhError.InvalidLength)
    }
    let value = match Natural.fromBytes(peer) {
      Result<Natural, ModularError>.Success { value: parsed } => parsed
      Result<Natural, ModularError>.Failure { .. } => {
        return Result<(), DhError>.failResult(DhError.KeyTooLarge)
      }
    }
    if value.lessThan(&Natural.fromU64(2)) {
      return Result<(), DhError>.failResult(DhError.KeyTooSmall)
    }
    let p = self.parameters.modulus.natural()
    let below = match p.subtract(&Natural.fromU64(1)) {
      Result<Natural, ModularError>.Success { value: difference } => difference
      Result<Natural, ModularError>.Failure { .. } => Intrinsic.trap("DhPrivateKey.agree: p is odd")
    }
    if !value.lessThan(&below) {
      return Result<(), DhError>.failResult(DhError.KeyTooLarge)
    }
    let base = match value.resize(self.parameters.modulus.wordLength()) {
      Result<Natural, ModularError>.Success { value: fitted } => fitted
      Result<Natural, ModularError>.Failure { .. } => Intrinsic.trap(
        "DhPrivateKey.agree: the key is below p",
      )
    }
    let shared = self.parameters.modulus.power(&base, &self.x)
    return match shared.writeBytes(move output) {
      Result<(), ModularError>.Success { .. } => Result<(), DhError>.succeed(())
      Result<(), ModularError>.Failure { .. } => Intrinsic.trap(
        "DhPrivateKey.agree: the secret has the length of p",
      )
    }
  }
}

fn keyFor(group: &DhGroup, secret: &Natural) -> DhPrivateKey {
  let fitted = match secret.resize(group.modulus.wordLength()) {
    Result<Natural, ModularError>.Success { value } => value
    Result<Natural, ModularError>.Failure { .. } => Intrinsic.trap(
      "DhPrivateKey: the secret is below p",
    )
  }
  let public = group.modulus.power(&group.g, &fitted)
  return DhPrivateKey { parameters: group.*, x: fitted, y: public }
}

fn hexDigit(character: u8) -> u32 {
  if character >= 97 {
    return u8.toU32(character) - 87
  }
  return u8.toU32(character) - 48
}

// The number with the lowercase hexadecimal digits `hex`.
fn hexNatural(hex: &[u8]) -> Natural {
  let mut bytes: [u8; 1024] = [0; 1024]
  let length = hex.length / 2
  let mut i: usize = 0
  while i < length {
    bytes[i] = u32.toU8(hexDigit(hex[2 * i]) * 16 + hexDigit(hex[2 * i + 1]))
    i = i + 1
  }
  return match Natural.fromBytes(Slice.view<u8>(&bytes, 0, length)) {
    Result<Natural, ModularError>.Success { value } => value
    Result<Natural, ModularError>.Failure { .. } => Intrinsic.trap(
      "hexNatural: the standard primes fit",
    )
  }
}

// The primes of RFC 2409, RFC 3526, and RFC 7919, in hexadecimal.
fn namedPrime(group: DhNamedGroup) -> &'static [u8] {
  return match group {
    DhNamedGroup.Modp1 => b"ffffffffffffffffc90fdaa22168c234c4c6628b80dc1cd129024e088a67cc74020bbea63b139b22514a08798e3404ddef9519b3cd3a431b302b0a6df25f14374fe1356d6d51c245e485b576625e7ec6f44c42e9a63a3620ffffffffffffffff"
    DhNamedGroup.Modp2 => b"ffffffffffffffffc90fdaa22168c234c4c6628b80dc1cd129024e088a67cc74020bbea63b139b22514a08798e3404ddef9519b3cd3a431b302b0a6df25f14374fe1356d6d51c245e485b576625e7ec6f44c42e9a637ed6b0bff5cb6f406b7edee386bfb5a899fa5ae9f24117c4b1fe649286651ece65381ffffffffffffffff"
    DhNamedGroup.Modp5 => b""
    DhNamedGroup.Modp14 => b""
    DhNamedGroup.Modp15 => b""
    DhNamedGroup.Modp16 => b""
    DhNamedGroup.Modp17 => b""
    DhNamedGroup.Modp18 => b""
    DhNamedGroup.Ffdhe2048 => b""
    DhNamedGroup.Ffdhe3072 => b""
    DhNamedGroup.Ffdhe4096 => b""
    DhNamedGroup.Ffdhe6144 => b""
    DhNamedGroup.Ffdhe8192 => b""
  }
}
