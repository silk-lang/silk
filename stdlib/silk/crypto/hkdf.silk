//! Derive keys with HKDF (RFC 5869) over any hash of `silk.crypto`.
//!
//! # When to use
//! Use [`HkdfSha256`], [`HkdfSha384`], or [`Hkdf`] with another hash to turn a shared secret, such
//! as the result of an X25519 key exchange, into one or more keys of the length that you need.
//! Give each key a different `info` label so that the keys are independent.
//!
//! # Details
//! HKDF has two steps. `extract` mixes the input key material with a salt and returns a
//! pseudorandom key (PRK) of one digest length. `expand` turns the PRK and an `info` label into
//! output of any length up to 255 digests: 8160 bytes for SHA-256, 12240 bytes for SHA-384.
//! [`Hkdf`] takes the hash as a type argument, such as `Hkdf.derive<Sha512>`, as `crypto.hkdf` in
//! Node.js does. Nothing allocates.
//!
//! # Errors
//! - [`OutputTooLongError`] from `expand` if the output is longer than the maximum. The output does
//!   not change.
//!
//! # Gotchas
//! HKDF is not for passwords. A password needs a slow function such as Argon2 or scrypt. The PRK is
//! a secret and is not erased.
//!
//! # Examples
//! ## Derive two keys from one secret
//! ```silk
//! import silk.crypto.hkdf { HkdfSha256, OutputTooLongError }
//! import silk.core.result { Result }
//!
//! pub fn main() -> i32 {
//!   let prk = HkdfSha256.extract(b"salt", b"shared secret")
//!   let mut encryption: [u8; 32] = [0; 32]
//!   let mut authentication: [u8; 32] = [0; 32]
//!   match HkdfSha256.expand(&prk, b"app v1 encryption", &mut encryption) {
//!     Result<(), OutputTooLongError>.Success { value: _ } => {}
//!     Result<(), OutputTooLongError>.Failure { error: _ } => {
//!       return 1
//!     }
//!   }
//!   match HkdfSha256.expand(&prk, b"app v1 authentication", &mut authentication) {
//!     Result<(), OutputTooLongError>.Success { value: _ } => {}
//!     Result<(), OutputTooLongError>.Failure { error: _ } => {
//!       return 1
//!     }
//!   }
//!
//!   // Different labels give different keys.
//!   if encryption[0] == authentication[0] && encryption[1] == authentication[1] {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Cryptography

import silk.text.format {Debug, Format, Formatter}
import silk.crypto.digest {Digest}
import silk.crypto.hmac {Hmac}
import silk.crypto.sha2 {Sha256, Sha384}
import silk.collections.slice {Slice}
import silk.core.result {Result}
import silk.num.usize
import silk.io.writer {Writer, WriterError}

/// The error that `expand` returns when the output is longer than 255 digests.
pub struct OutputTooLongError {
  /// The output length that you asked for.
  pub requested: usize,
  /// The maximum output length: 255 digests, such as 8160 for SHA-256 and 12240 for SHA-384.
  pub maximum: usize,
}

impl Debug for OutputTooLongError {
  /// Writes the fields, as `OutputTooLongError { requested: ..., maximum: ... }`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return run Format.debugFields(self, "OutputTooLongError", &mut formatter)
  }
}

/// HKDF with SHA-256 as the hash (RFC 5869). The PRK is 32 bytes and the output is at most 8160
/// bytes.
///
/// # When to use
///
/// Use it to turn a shared secret, such as the result of an X25519 key exchange, into one or more
/// keys of the length that you need. Give each key a different `info` label so that the keys are
/// independent.
///
/// # Details
///
/// HKDF has two steps. `extract` mixes the input key material with a salt and returns a
/// pseudorandom key (PRK). `expand` turns the PRK and an `info` label into output of any length up
/// to 8160 bytes. Nothing allocates.
///
/// # Gotchas
///
/// HKDF is not for passwords. A password needs a slow function such as Argon2 or scrypt. The PRK is
/// a secret and is not erased.
pub struct HkdfSha256 {}

impl HkdfSha256 {
  /// Returns the 32-byte pseudorandom key (PRK) for the input key material `ikm` and `salt`.
  ///
  /// An empty salt is the same as 32 zero bytes. Use a random salt if the protocol has one. Pass
  /// the result to [`HkdfSha256.expand`].
  ///
  /// # Gotchas
  /// The program traps if `salt` or `ikm` is longer than the hash allows (2^64 bits).
  pub fn extract(salt: &[u8], ikm: &[u8]) -> [u8; 32] {
    let mut prk: [u8; 32] = [0; 32]
    Hkdf.extractInto<Sha256>(salt, ikm, &mut prk)
    return prk
  }
  /// Fills all of `output` with key material from `prk` and the label `info`.
  ///
  /// `prk` must come from [`HkdfSha256.extract`], or be another uniformly random key of 32 bytes.
  /// An empty `info` and an empty `output` are valid. The same `prk` and `info` always give the
  /// same bytes, and a shorter output is a prefix of a longer one.
  ///
  /// # Errors
  /// - [`OutputTooLongError`] if `output` is longer than 8160 bytes. `output` does not change.
  pub fn expand(prk: &([u8; 32]), info: &[u8], output: &mut [u8]) -> Result<(), OutputTooLongError> {
    return Hkdf.expand<Sha256>(prk, info, move output)
  }

}

/// HKDF with SHA-384 as the hash (RFC 5869). The PRK is 48 bytes and the output is at most 12240
/// bytes.
///
/// # When to use
///
/// Use it to turn a shared secret, such as the result of an X25519 key exchange, into one or more
/// keys of the length that you need. Give each key a different `info` label so that the keys are
/// independent.
///
/// # Details
///
/// HKDF has two steps. `extract` mixes the input key material with a salt and returns a
/// pseudorandom key (PRK). `expand` turns the PRK and an `info` label into output of any length up
/// to 12240 bytes. Nothing allocates.
///
/// # Gotchas
///
/// HKDF is not for passwords. A password needs a slow function such as Argon2 or scrypt. The PRK is
/// a secret and is not erased.
pub struct HkdfSha384 {}

impl HkdfSha384 {
  /// Returns the 48-byte pseudorandom key (PRK) for the input key material `ikm` and `salt`.
  ///
  /// An empty salt is the same as 48 zero bytes. Use a random salt if the protocol has one. Pass
  /// the result to [`HkdfSha384.expand`].
  ///
  /// # Gotchas
  /// The program traps if `salt` or `ikm` is longer than the hash allows (2^128 bits).
  pub fn extract(salt: &[u8], ikm: &[u8]) -> [u8; 48] {
    let mut prk: [u8; 48] = [0; 48]
    Hkdf.extractInto<Sha384>(salt, ikm, &mut prk)
    return prk
  }
  /// Fills all of `output` with key material from `prk` and the label `info`.
  ///
  /// `prk` must come from [`HkdfSha384.extract`], or be another uniformly random key of 48 bytes.
  /// An empty `info` and an empty `output` are valid. The same `prk` and `info` always give the
  /// same bytes, and a shorter output is a prefix of a longer one.
  ///
  /// # Errors
  /// - [`OutputTooLongError`] if `output` is longer than 12240 bytes. `output` does not change.
  pub fn expand(prk: &([u8; 48]), info: &[u8], output: &mut [u8]) -> Result<(), OutputTooLongError> {
    return Hkdf.expand<Sha384>(prk, info, move output)
  }

}

/// HKDF (RFC 5869) over the hash `H`, such as `Hkdf.derive<Sha512>` or `Hkdf.derive<Sha1>`.
///
/// # When to use
///
/// Use it when a protocol names HKDF with a hash other than SHA-256 or SHA-384, or in generic code,
/// or for `crypto.hkdf` in Node.js. For those two hashes, [`HkdfSha256`] and [`HkdfSha384`]
/// return the PRK as an array.
///
/// # Details
///
/// [`Hkdf.extractInto`] writes the pseudorandom key (PRK) of one digest length. [`Hkdf.expand`]
/// turns a PRK and an `info` label into output of up to 255 digests. [`Hkdf.derive`] does both.
/// Nothing allocates.
///
/// # Gotchas
///
/// HKDF is not for passwords. A password needs a slow function such as scrypt. The PRK is a secret
/// and is not erased.
pub struct Hkdf {}

impl Hkdf {
  /// Writes the pseudorandom key (PRK) for the input key material `ikm` and `salt` to the first
  /// digest-length bytes of `prk`.
  ///
  /// An empty salt is the same as one digest length of zero bytes. The bytes of `prk` after the
  /// key do not change.
  ///
  /// # Gotchas
  /// The program traps if `prk` is shorter than the digest length of `H`.
  pub fn extractInto<H: Digest>(salt: &[u8], ikm: &[u8], prk: &mut [u8]) -> () {
    let mut state = Hmac<H>.make(salt)
    state.update(ikm)
    state.finishInto(move prk)
  }
  /// Fills all of `output` with key material from `prk` and the label `info`.
  ///
  /// `prk` must come from [`Hkdf.extractInto`], or be another uniformly random key, usually of one
  /// digest length. An empty `info` and an empty `output` are valid. A shorter output is a prefix
  /// of a longer one.
  ///
  /// # Errors
  /// - [`OutputTooLongError`] if `output` is longer than 255 digest lengths of `H`. `output` does
  ///   not change.
  pub fn expand<H: Digest>(prk: &[u8], info: &[u8], output: &mut [u8]) -> Result<
    (),
    OutputTooLongError,
  > {
    let keyed = Hmac<H>.make(prk)
    let length = keyed.tagLength()
    if output.length > 255 * length {
      return Result<(), OutputTooLongError>.failResult(
        OutputTooLongError {requested: output.length, maximum: 255 * length},
      )
    }
    let mut previous: [u8; 64] = [0; 64]
    let mut written: usize = 0
    let mut counter: usize = 1
    while written < output.length {
      let mut state = keyed.copy()
      if counter > 1 {
        state.update(Slice.view<u8>(&previous, 0, length))
      }
      state.update(info)
      let counterByte: [u8; 1] = [usize.toU8(counter)]
      state.update(&counterByte)
      state.finishInto(&mut previous)
      let mut index: usize = 0
      while index < length && written < output.length {
        output[written] = previous[index]
        index = index + 1
        written = written + 1
      }
      counter = counter + 1
    }
    return Result<(), OutputTooLongError>.succeed(())
  }
  /// Fills all of `output` with the HKDF key for `ikm`, `salt`, and `info`: [`Hkdf.extractInto`]
  /// followed by [`Hkdf.expand`].
  ///
  /// # Errors
  /// - [`OutputTooLongError`] if `output` is longer than 255 digest lengths of `H`. `output` does
  ///   not change.
  pub fn derive<H: Digest>(
    salt: &[u8],
    ikm: &[u8],
    info: &[u8],
    output: &mut [u8],
  ) -> Result<(), OutputTooLongError> {
    let mut prk: [u8; 64] = [0; 64]
    let probe: H = Digest.make()
    let length = probe.digestLength()
    Hkdf.extractInto<H>(salt, ikm, &mut prk)
    return Hkdf.expand<H>(Slice.view<u8>(&prk, 0, length), info, move output)
  }
}
