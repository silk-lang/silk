//! Read and write X25519, X448, Ed25519, and Ed448 keys in DER: PKCS #8 private keys and
//! SubjectPublicKeyInfo public keys, as RFC 8410 defines them.
//!
//! # When to use
//! Use [`OkpKeyDer`] to load a key that OpenSSL, a browser, or Node.js wrote, or to export a key in
//! one of those forms. The reader tells you the algorithm, so you can pick `silk.crypto.x25519`,
//! `silk.crypto.ed25519`, or `silk.crypto.curve448`. JOSE calls these keys octet key pairs, OKP.
//!
//! # Details
//! A private key is the `PRIVATE KEY` form of RFC 5958: the algorithm identifier and the raw secret
//! in an inner OCTET STRING. For Ed25519 and Ed448 the secret is the seed of RFC 8032, 32 or 57
//! bytes; for X25519 and X448 it is the scalar before clamping, 32 or 56 bytes. A public key is the
//! `PUBLIC KEY` form, the raw public key in a BIT STRING. The algorithm identifiers have no
//! parameters. The readers return views into the DER and do not copy. The writers give the same
//! bytes as OpenSSL. Nothing allocates. PEM is DER in Base64 between header lines; use
//! `silk.encoding.pem` for it.
//!
//! # Errors
//! - [`OkpKeyError`] for DER that is not valid, for another algorithm, or for a key of the wrong
//!   length.
//!
//! # Gotchas
//! The readers check the structure and the lengths, but not the values. A private key file can
//! hold a public key that does not belong to its secret; compare it with the public key of the
//! secret if that matters.
//!
//! # Examples
//! ## Write and read an Ed25519 public key
//! ```silk
//! import silk.collections.slice { Slice }
//! import silk.crypto.okp_key { OkpAlgorithm, OkpKeyDer, OkpKeyError, OkpPublicKeyDer }
//! import silk.core.result { Result }
//!
//! pub fn main() -> i32 {
//!   let key: [u8; 32] = [7; 32]
//!   let mut der: [u8; 44] = [0; 44]
//!   let length = match OkpKeyDer.writeSpki(OkpAlgorithm.Ed25519, &key, &mut der) {
//!     Result<usize, OkpKeyError>.Success { value } => value
//!     Result<usize, OkpKeyError>.Failure {..} => {
//!       return 1
//!     }
//!   }
//!   // An Ed25519 SubjectPublicKeyInfo is 44 bytes.
//!   if length != 44 {
//!     return 1
//!   }
//!   return match OkpKeyDer.readSpki(Slice.view<u8>(&der, 0, length)) {
//!     Result<OkpPublicKeyDer, OkpKeyError>.Success { value } => {
//!       if value.algorithm == OkpAlgorithm.Ed25519 && value.publicKey[0] == 7 {
//!         return 0
//!       }
//!       return 1
//!     }
//!     Result<OkpPublicKeyDer, OkpKeyError>.Failure {..} => 1
//!   }
//! }
//! ```
//!
//! @category Cryptography

import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.num.u8
import silk.num.usize
import silk.text.format { Debug, Format, Formatter }

/// A key algorithm of RFC 8410 that [`OkpKeyDer`] reads and writes.
pub enum OkpAlgorithm {
  /// X25519 key agreement, `id-X25519` (1.3.101.110).
  X25519,
  /// X448 key agreement, `id-X448` (1.3.101.111).
  X448,
  /// Ed25519 signatures, `id-Ed25519` (1.3.101.112).
  Ed25519,
  /// Ed448 signatures, `id-Ed448` (1.3.101.113).
  Ed448,
}

impl OkpAlgorithm {
  /// Returns the length of a secret in bytes: 32 for X25519 and Ed25519, 56 for X448, and 57 for
  /// Ed448.
  pub fn secretLength(self: &Self) -> usize {
    return match &self.* {
      OkpAlgorithm.X25519 => 32
      OkpAlgorithm.X448 => 56
      OkpAlgorithm.Ed25519 => 32
      OkpAlgorithm.Ed448 => 57
    }
  }

  /// Returns the length of a public key in bytes, the same as [`OkpAlgorithm.secretLength`].
  pub fn publicKeyLength(self: &Self) -> usize {
    return self.secretLength()
  }

  /// Returns the content bytes of the object identifier that names the algorithm, without the tag
  /// and length.
  pub fn objectIdentifier(self: &Self) -> &[u8] {
    return match &self.* {
      OkpAlgorithm.X25519 => b"\x2b\x65\x6e"
      OkpAlgorithm.X448 => b"\x2b\x65\x6f"
      OkpAlgorithm.Ed25519 => b"\x2b\x65\x70"
      OkpAlgorithm.Ed448 => b"\x2b\x65\x71"
    }
  }
}

impl Debug for OkpAlgorithm {
  /// Writes the name of the variant, such as `Ed25519`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return match &self.* {
      OkpAlgorithm.X25519 => run Format.write(&mut formatter, b"X25519")
      OkpAlgorithm.X448 => run Format.write(&mut formatter, b"X448")
      OkpAlgorithm.Ed25519 => run Format.write(&mut formatter, b"Ed25519")
      OkpAlgorithm.Ed448 => run Format.write(&mut formatter, b"Ed448")
    }
  }
}

/// The reason that a key in DER could not be read or written.
pub enum OkpKeyError {
  /// The bytes are not strict DER of the expected structure, the algorithm has parameters, or a
  /// version is not supported.
  InvalidEncoding,
  /// The key algorithm is not X25519, X448, Ed25519, or Ed448.
  UnsupportedAlgorithm,
  /// A secret or a public key does not have the length of the algorithm.
  InvalidLength,
}

impl Debug for OkpKeyError {
  /// Writes the name of the variant, such as `InvalidEncoding`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return match &self.* {
      OkpKeyError.InvalidEncoding => run Format.write(&mut formatter, b"InvalidEncoding")
      OkpKeyError.UnsupportedAlgorithm => run Format.write(&mut formatter, b"UnsupportedAlgorithm")
      OkpKeyError.InvalidLength => run Format.write(&mut formatter, b"InvalidLength")
    }
  }
}

/// A private key that [`OkpKeyDer.readPkcs8`] read. The slices point into the DER.
pub struct OkpPrivateKeyDer<'a> {
  /// The algorithm of the key.
  pub algorithm: OkpAlgorithm,
  /// The secret, of [`OkpAlgorithm.secretLength`] bytes.
  pub secret: &'a [u8],
  /// The public key that a version 1 key holds, or `None`.
  pub publicKey: Option<&'a [u8]>,
}

/// A public key that [`OkpKeyDer.readSpki`] read. The slice points into the DER.
pub struct OkpPublicKeyDer<'a> {
  /// The algorithm of the key.
  pub algorithm: OkpAlgorithm,
  /// The public key, of [`OkpAlgorithm.publicKeyLength`] bytes.
  pub publicKey: &'a [u8],
}

/// Functions that read and write X25519, X448, Ed25519, and Ed448 keys in DER.
///
/// # When to use
/// Use it to load or export one of these keys as PKCS #8 or SubjectPublicKeyInfo.
///
/// # Details
/// The writers give the same bytes as OpenSSL: a PKCS #8 key of version 0 without the public key,
/// at most 73 bytes, and a SubjectPublicKeyInfo of at most 69 bytes.
///
/// # Gotchas
/// The readers do not check that a public key is a valid point.
pub struct OkpKeyDer {}

impl OkpKeyDer {
  /// Reads a PKCS #8 `PrivateKeyInfo` or `OneAsymmetricKey` (RFC 5958) with an RFC 8410 key, the
  /// form of a `PRIVATE KEY` PEM file.
  ///
  /// Versions 0 and 1 are accepted. Attributes are skipped. A public key is accepted in version 1.
  ///
  /// # Errors
  /// - `InvalidEncoding` if `der` is not one strict DER key of that structure.
  /// - `UnsupportedAlgorithm` if the algorithm is not X25519, X448, Ed25519, or Ed448.
  /// - `InvalidLength` if the secret or the public key has the wrong length.
  pub fn readPkcs8<'a>(der: &'a [u8]) -> Result<OkpPrivateKeyDer<'a>, OkpKeyError> {
    let outer = element(der, 0, der.length)
    if !outer.valid || outer.tag != 48 || outer.next != der.length {
      return Result<OkpPrivateKeyDer<'a>, OkpKeyError>.failResult(OkpKeyError.InvalidEncoding)
    }
    let version = element(der, outer.start, outer.end)
    if !version.valid || version.tag != 2 || version.end != version.start + 1
      || der[version.start] > 1 {
      return Result<OkpPrivateKeyDer<'a>, OkpKeyError>.failResult(OkpKeyError.InvalidEncoding)
    }
    let versionOne = der[version.start] == 1
    let found = match move readAlgorithm(der, version.next, outer.end) {
      Result<AlgorithmAt, OkpKeyError>.Success { value } => value
      Result<AlgorithmAt, OkpKeyError>.Failure { error } => {
        return Result<OkpPrivateKeyDer<'a>, OkpKeyError>.failResult(error)
      }
    }
    let wrapped = element(der, found.next, outer.end)
    if !wrapped.valid || wrapped.tag != 4 {
      return Result<OkpPrivateKeyDer<'a>, OkpKeyError>.failResult(OkpKeyError.InvalidEncoding)
    }
    let secret = element(der, wrapped.start, wrapped.end)
    if !secret.valid || secret.tag != 4 || secret.next != wrapped.end {
      return Result<OkpPrivateKeyDer<'a>, OkpKeyError>.failResult(OkpKeyError.InvalidEncoding)
    }
    let mut position = wrapped.next
    if position < outer.end && der[position] == 160 {
      let attributes = element(der, position, outer.end)
      if !attributes.valid {
        return Result<OkpPrivateKeyDer<'a>, OkpKeyError>.failResult(OkpKeyError.InvalidEncoding)
      }
      position = attributes.next
    }
    let mut publicKey = Option<&'a [u8]>.none()
    let mut publicLength: usize = 0
    if position < outer.end && der[position] == 129 {
      let bits = element(der, position, outer.end)
      if !versionOne || !bits.valid || bits.end == bits.start || der[bits.start] != 0 {
        return Result<OkpPrivateKeyDer<'a>, OkpKeyError>.failResult(OkpKeyError.InvalidEncoding)
      }
      publicLength = bits.end - bits.start - 1
      publicKey = Option<&'a [u8]>.some(Slice.view<u8>(der, bits.start + 1, publicLength))
      position = bits.next
    }
    if position != outer.end {
      return Result<OkpPrivateKeyDer<'a>, OkpKeyError>.failResult(OkpKeyError.InvalidEncoding)
    }
    let algorithm = found.algorithm
    if secret.end - secret.start != algorithm.secretLength() {
      return Result<OkpPrivateKeyDer<'a>, OkpKeyError>.failResult(OkpKeyError.InvalidLength)
    }
    let hasPublic = match &publicKey {
      Option<&[u8]>.Some { .. } => true
      Option<&[u8]>.None => false
    }
    if hasPublic && publicLength != algorithm.publicKeyLength() {
      return Result<OkpPrivateKeyDer<'a>, OkpKeyError>.failResult(OkpKeyError.InvalidLength)
    }
    return Result<OkpPrivateKeyDer<'a>, OkpKeyError>.succeed(
      OkpPrivateKeyDer {
        algorithm: algorithm,
        secret: Slice.view<u8>(der, secret.start, secret.end - secret.start),
        publicKey: move publicKey,
      },
    )
  }

  /// Reads a `SubjectPublicKeyInfo` with an RFC 8410 key, the form of a `PUBLIC KEY` PEM file and
  /// of the key in an X.509 certificate.
  ///
  /// # Errors
  /// - `InvalidEncoding` if `der` is not one strict DER `SubjectPublicKeyInfo`.
  /// - `UnsupportedAlgorithm` if the algorithm is not X25519, X448, Ed25519, or Ed448.
  /// - `InvalidLength` if the public key has the wrong length.
  pub fn readSpki<'a>(der: &'a [u8]) -> Result<OkpPublicKeyDer<'a>, OkpKeyError> {
    let outer = element(der, 0, der.length)
    if !outer.valid || outer.tag != 48 || outer.next != der.length {
      return Result<OkpPublicKeyDer<'a>, OkpKeyError>.failResult(OkpKeyError.InvalidEncoding)
    }
    let found = match move readAlgorithm(der, outer.start, outer.end) {
      Result<AlgorithmAt, OkpKeyError>.Success { value } => value
      Result<AlgorithmAt, OkpKeyError>.Failure { error } => {
        return Result<OkpPublicKeyDer<'a>, OkpKeyError>.failResult(error)
      }
    }
    let bits = element(der, found.next, outer.end)
    if !bits.valid || bits.tag != 3 || bits.next != outer.end || bits.end == bits.start
      || der[bits.start] != 0 {
      return Result<OkpPublicKeyDer<'a>, OkpKeyError>.failResult(OkpKeyError.InvalidEncoding)
    }
    if bits.end - bits.start - 1 != found.algorithm.publicKeyLength() {
      return Result<OkpPublicKeyDer<'a>, OkpKeyError>.failResult(OkpKeyError.InvalidLength)
    }
    return Result<OkpPublicKeyDer<'a>, OkpKeyError>.succeed(
      OkpPublicKeyDer {
        algorithm: found.algorithm,
        publicKey: Slice.view<u8>(der, bits.start + 1, bits.end - bits.start - 1),
      },
    )
  }

  /// Writes `secret` as a PKCS #8 `PrivateKeyInfo` of version 0 for `algorithm`, and returns the
  /// length. The bytes of `output` after the DER do not change.
  ///
  /// # Errors
  /// - `InvalidLength` if `secret` is not [`OkpAlgorithm.secretLength`] bytes. `output` does not
  ///   change.
  ///
  /// # Gotchas
  /// The program traps if `output` is shorter than the DER: 16 bytes more than the secret, at most
  /// 73 bytes.
  pub fn writePkcs8(algorithm: OkpAlgorithm, secret: &[u8], output: &mut [u8]) -> Result<
    usize,
    OkpKeyError,
  > {
    if secret.length != algorithm.secretLength() {
      return Result<usize, OkpKeyError>.failResult(OkpKeyError.InvalidLength)
    }
    // SEQUENCE { INTEGER 0, SEQUENCE { OID }, OCTET STRING { OCTET STRING secret } }; all lengths
    // are below 128.
    let content = 3 + 7 + 2 + 2 + secret.length
    let mut position = writeHeader(&mut output, 0, 48, content)
    position = writeBytes(&mut output, position, b"\x02\x01\x00")
    position = writeAlgorithm(algorithm, &mut output, position)
    position = writeHeader(&mut output, position, 4, secret.length + 2)
    position = writeHeader(&mut output, position, 4, secret.length)
    position = writeBytes(&mut output, position, secret)
    return Result<usize, OkpKeyError>.succeed(position)
  }

  /// Writes `publicKey` as a `SubjectPublicKeyInfo` for `algorithm`, and returns the length. The
  /// bytes of `output` after the DER do not change.
  ///
  /// # Errors
  /// - `InvalidLength` if `publicKey` is not [`OkpAlgorithm.publicKeyLength`] bytes. `output` does
  ///   not change.
  ///
  /// # Gotchas
  /// The program traps if `output` is shorter than the DER: 12 bytes more than the key, at most 69
  /// bytes.
  pub fn writeSpki(algorithm: OkpAlgorithm, publicKey: &[u8], output: &mut [u8]) -> Result<
    usize,
    OkpKeyError,
  > {
    if publicKey.length != algorithm.publicKeyLength() {
      return Result<usize, OkpKeyError>.failResult(OkpKeyError.InvalidLength)
    }
    let content = 7 + 3 + publicKey.length
    let mut position = writeHeader(&mut output, 0, 48, content)
    position = writeAlgorithm(algorithm, &mut output, position)
    position = writeHeader(&mut output, position, 3, publicKey.length + 1)
    output[position] = 0
    position = writeBytes(&mut output, position + 1, publicKey)
    return Result<usize, OkpKeyError>.succeed(position)
  }
}

// One DER element: the tag, the content range, and the offset after it.
struct Element {
  tag: u8,
  start: usize,
  end: usize,
  next: usize,
  valid: bool,
}

// Reads the element at `offset` that must end by `limit`. Lengths use the shortest form, and the
// keys here are below 64 KiB.
fn element(bytes: &[u8], offset: usize, limit: usize) -> Element {
  let invalid = Element { tag: 0, start: 0, end: 0, next: 0, valid: false }
  if limit > bytes.length || offset >= limit || limit - offset < 2 {
    return move invalid
  }
  let first = bytes[offset + 1]
  let mut start = offset + 2
  let mut length = u8.toUsize(first)
  if first == 129 {
    if limit - start < 1 || bytes[start] < 128 {
      return move invalid
    }
    length = u8.toUsize(bytes[start])
    start = start + 1
  } else if first == 130 {
    if limit - start < 2 || bytes[start] == 0 {
      return move invalid
    }
    length = u8.toUsize(bytes[start]) * 256 + u8.toUsize(bytes[start + 1])
    if length < 256 {
      return move invalid
    }
    start = start + 2
  } else if first >= 128 {
    return move invalid
  }
  if length > limit - start {
    return move invalid
  }
  return Element {
    tag: bytes[offset],
    start: start,
    end: start + length,
    next: start + length,
    valid: true,
  }
}

fn sameBytes(bytes: &[u8], start: usize, end: usize, expected: &[u8]) -> bool {
  if end - start != expected.length {
    return false
  }
  let mut i: usize = 0
  while i < expected.length {
    if bytes[start + i] != expected[i] {
      return false
    }
    i = i + 1
  }
  return true
}

struct AlgorithmAt {
  algorithm: OkpAlgorithm,
  next: usize,
}

impl Copy for AlgorithmAt {}

// AlgorithmIdentifier { id-X25519 | id-X448 | id-Ed25519 | id-Ed448 } with absent parameters, at
// `offset`.
fn readAlgorithm(bytes: &[u8], offset: usize, limit: usize) -> Result<AlgorithmAt, OkpKeyError> {
  let sequence = element(bytes, offset, limit)
  if !sequence.valid || sequence.tag != 48 {
    return Result<AlgorithmAt, OkpKeyError>.failResult(OkpKeyError.InvalidEncoding)
  }
  let identifier = element(bytes, sequence.start, sequence.end)
  if !identifier.valid || identifier.tag != 6 {
    return Result<AlgorithmAt, OkpKeyError>.failResult(OkpKeyError.InvalidEncoding)
  }
  let mut algorithm = OkpAlgorithm.X25519
  if sameBytes(bytes, identifier.start, identifier.end, OkpAlgorithm.X25519.objectIdentifier()) {
    algorithm = OkpAlgorithm.X25519
  } else if sameBytes(bytes, identifier.start, identifier.end, OkpAlgorithm.X448.objectIdentifier()) {
    algorithm = OkpAlgorithm.X448
  } else if sameBytes(
    bytes,
    identifier.start,
    identifier.end,
    OkpAlgorithm.Ed25519.objectIdentifier(),
  ) {
    algorithm = OkpAlgorithm.Ed25519
  } else if sameBytes(bytes, identifier.start, identifier.end, OkpAlgorithm.Ed448.objectIdentifier()) {
    algorithm = OkpAlgorithm.Ed448
  } else {
    return Result<AlgorithmAt, OkpKeyError>.failResult(OkpKeyError.UnsupportedAlgorithm)
  }
  if identifier.next != sequence.end {
    return Result<AlgorithmAt, OkpKeyError>.failResult(OkpKeyError.InvalidEncoding)
  }
  return Result<AlgorithmAt, OkpKeyError>.succeed(
    AlgorithmAt { algorithm: algorithm, next: sequence.next },
  )
}

fn writeHeader(output: &mut [u8], position: usize, tag: u8, length: usize) -> usize {
  output[position] = tag
  output[position + 1] = usize.toU8(length)
  return position + 2
}

fn writeBytes(output: &mut [u8], position: usize, bytes: &[u8]) -> usize {
  let mut i: usize = 0
  while i < bytes.length {
    output[position + i] = bytes[i]
    i = i + 1
  }
  return position + bytes.length
}

fn writeAlgorithm(algorithm: OkpAlgorithm, output: &mut [u8], position: usize) -> usize {
  let mut at = writeHeader(&mut output, position, 48, 5)
  at = writeHeader(&mut output, at, 6, 3)
  return writeBytes(&mut output, at, algorithm.objectIdentifier())
}
