//! Compute HMAC tags (RFC 2104) with any hash of `silk.crypto`.
//!
//! # When to use
//! Use [`HmacSha256`], [`HmacSha384`], or [`Hmac`] with another hash to prove that a message comes
//! from someone who has a shared secret key and was not changed, for example to sign a webhook or a
//! cookie. Use `silk.crypto.hkdf` to derive keys, and `silk.crypto.sha2` for a hash without a key.
//!
//! # Details
//! [`Hmac`] takes the hash as a type argument, such as `Hmac<Sha1>` or `Hmac<Sha3_256>`, and writes
//! its tag into a slice. [`HmacSha256`] and [`HmacSha384`] return their tag as an array.
//! [`HmacSha256.authenticate`] returns the tag of one message. For a message that arrives in parts,
//! call `make` with the key, then `update` for each part, then `finish`. Any key length is valid. A
//! key longer than the block size of the hash (64 bytes for SHA-256, 128 for SHA-384) is hashed
//! first. Nothing allocates.
//!
//! # Gotchas
//! This module computes tags, but it does not compare them. To check a received tag, compare all
//! bytes in constant time, as the example shows. Do not use `==` or a loop that stops at the first
//! difference. The states hold key material and are not erased when they are dropped.
//!
//! # Examples
//! ## Check a received tag
//! ```silk
//! import silk.crypto.hmac { HmacSha256 }
//! import silk.num.u8
//!
//! // Compares in constant time, so the time does not tell an attacker how many bytes match.
//! fn same(left: &[u8; 32], right: &[u8; 32]) -> bool {
//!   let mut difference: u8 = 0
//!   let mut index: usize = 0
//!   while index < 32 {
//!     difference = u8.bitOr(difference, u8.bitXor(left[index], right[index]))
//!     index = index + 1
//!   }
//!   return difference == 0
//! }
//!
//! pub fn main() -> i32 {
//!   let key = b"key"
//!   let message = b"The quick brown fox jumps over the lazy dog"
//!   let received = HmacSha256.authenticate(key, message)
//!   let mut state = HmacSha256.make(key)
//!   state.update(b"The quick brown fox ")
//!   state.update(b"jumps over the lazy dog")
//!   let expected = state.finish()
//!
//!   // HMAC-SHA-256 of this key and message is f7bc83f4...d8.
//!   if !same(&received, &expected) || expected[0] != 0xf7 || expected[31] != 0xd8 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Cryptography

import silk.crypto.digest {Digest}
import silk.crypto.sha2 {Sha256, Sha384}
import silk.collections.slice {Slice}
import silk.num.u8

/// A streaming HMAC state (RFC 2104) over the hash `H`, such as `Hmac<Sha1>` or `Hmac<Sha512>`.
///
/// # When to use
///
/// Use it to prove that a message comes from someone who has a shared secret key and was not
/// changed, when the protocol names a hash other than SHA-256 or SHA-384, or in generic code. For
/// those two, [`HmacSha256`] and [`HmacSha384`] return the tag as an array.
///
/// # Details
///
/// Call [`Hmac.make`] with the key, [`Hmac.update`] for each part of the message, then
/// [`Hmac.finishInto`]. The tag has the digest length of `H`. Any key length is valid. A key longer
/// than the block length of `H` is hashed first. [`Hmac.copy`] forks the state, so a prefix keyed
/// once can be reused, as PBKDF2 does. The state is a fixed-size value and does not allocate.
///
/// # Gotchas
///
/// It computes tags, but it does not compare them. To check a received tag, compare all bytes in
/// constant time. The state holds key material and is not erased when it is dropped.
pub struct Hmac<H> {
  inner: H,
  outer: H,
}

impl<H: Digest> Hmac<H> {
  /// Returns an HMAC state over `H` for `key`. Any key length is valid, also 0.
  ///
  /// A key longer than the block length of `H` is hashed first. The state copies what it needs and
  /// does not borrow `key`.
  pub fn make(key: &[u8]) -> Hmac<H> {
    let mut inner: H = Digest.make()
    let block = inner.blockLength()
    let mut pad: [u8; 144] = [0; 144]
    let mut index: usize = 0
    if key.length > block {
      let mut hashed: H = Digest.make()
      hashed.update(key)
      hashed.finishInto(&mut pad)
    } else {
      while index < key.length {
        pad[index] = key[index]
        index = index + 1
      }
    }
    index = 0
    while index < block {
      pad[index] = u8.bitXor(pad[index], 0x36)
      index = index + 1
    }
    inner.update(Slice.view<u8>(&pad, 0, block))
    index = 0
    while index < block {
      // Replace the inner pad with the outer pad: 0x36 XOR 0x5C = 0x6A.
      pad[index] = u8.bitXor(pad[index], 0x6A)
      index = index + 1
    }
    let mut outer: H = Digest.make()
    outer.update(Slice.view<u8>(&pad, 0, block))
    return Hmac<H> {inner: move inner, outer: move outer}
  }
  /// Adds `bytes` to the end of the message.
  ///
  /// Any split of the message into parts gives the same tag. An empty slice changes nothing.
  pub fn update(self: &mut Self, bytes: &[u8]) -> () {
    self.inner.update(bytes)
  }
  /// Returns an independent copy of the state, with the same key and message so far.
  pub fn copy(self: &Self) -> Hmac<H> {
    return Hmac<H> {inner: self.inner.copy(), outer: self.outer.copy()}
  }
  /// Returns the length of the tag in bytes, which is the digest length of `H`.
  pub fn tagLength(self: &Self) -> usize {
    return self.outer.digestLength()
  }
  /// Writes the tag of the message to the first [`Hmac.tagLength`] bytes of `output` and consumes
  /// the state.
  ///
  /// The bytes of `output` after the tag do not change.
  ///
  /// # Gotchas
  /// The program traps if `output` is shorter than [`Hmac.tagLength`].
  pub fn finishInto(self: Self, output: &mut [u8]) -> () {
    let inner = move self.inner
    let mut outer = move self.outer
    let length = inner.digestLength()
    let mut digest: [u8; 64] = [0; 64]
    inner.finishInto(&mut digest)
    outer.update(Slice.view<u8>(&digest, 0, length))
    outer.finishInto(move output)
  }
}

/// A streaming HMAC-SHA-256 state (RFC 2104) that returns a 32-byte tag.
///
/// Call [`HmacSha256.make`] with the key, [`HmacSha256.update`] for each part of the message, then
/// [`HmacSha256.finish`]. For one message, use [`HmacSha256.authenticate`]. The state is a
/// fixed-size value. It holds key material and is not erased when it is dropped.
///
/// # When to use
///
/// Use it to prove that a message comes from someone who has a shared secret key and was not
/// changed, for example to sign a webhook or a cookie. Use `silk.crypto.hkdf` to derive keys, and
/// `silk.crypto.sha2` for a hash without a key.
///
/// # Details
///
/// Any key length is valid. A key longer than the block size (64 bytes) is hashed first. It is
/// `Hmac<Sha256>` with the tag returned as an array. Nothing allocates.
///
/// # Gotchas
///
/// It computes tags, but it does not compare them. To check a received tag, compare all bytes in
/// constant time. Do not use `==` or a loop that stops at the first difference.
pub struct HmacSha256 {
  state: Hmac<Sha256>,
}

impl HmacSha256 {
  /// Returns an HMAC-SHA-256 state for `key`. Any key length is valid, also 0.
  ///
  /// A key longer than 64 bytes is hashed first. The state copies what it needs and does not borrow
  /// `key`.
  pub fn make(key: &[u8]) -> HmacSha256 {
    return HmacSha256 {state: Hmac<Sha256>.make(key)}
  }
  /// Adds `bytes` to the end of the message.
  ///
  /// Any split of the message into parts gives the same tag. An empty slice changes nothing.
  ///
  /// # Gotchas
  /// The program traps if the message is longer than 2^64 - 1 bits minus the 64-byte key block.
  pub fn update(self: &mut Self, bytes: &[u8]) -> () {
    self.state.update(bytes)
  }
  /// Returns the 32-byte HMAC-SHA-256 tag of the message and consumes the state.
  pub fn finish(self: Self) -> [u8; 32] {
    let mut tag: [u8; 32] = [0; 32]
    let state = move self.state
    state.finishInto(&mut tag)
    return tag
  }
  /// Returns the 32-byte HMAC-SHA-256 tag of `message` with `key`.
  ///
  /// An empty key or message is valid. To check a received tag, compare all bytes in constant time.
  /// Do not use `==` or a loop that stops at the first difference.
  pub fn authenticate(key: &[u8], message: &[u8]) -> [u8; 32] {
    let mut state = HmacSha256.make(key)
    state.update(message)
    return state.finish()
  }
}

/// A streaming HMAC-SHA-384 state (RFC 2104) that returns a 48-byte tag.
///
/// Call [`HmacSha384.make`] with the key, [`HmacSha384.update`] for each part of the message, then
/// [`HmacSha384.finish`]. For one message, use [`HmacSha384.authenticate`]. The state is a
/// fixed-size value. It holds key material and is not erased when it is dropped.
///
/// # When to use
///
/// Use it to prove that a message comes from someone who has a shared secret key and was not
/// changed, for example to sign a webhook or a cookie. Use `silk.crypto.hkdf` to derive keys, and
/// `silk.crypto.sha2` for a hash without a key.
///
/// # Details
///
/// Any key length is valid. A key longer than the block size (128 bytes) is hashed first. It is
/// `Hmac<Sha384>` with the tag returned as an array. Nothing allocates.
///
/// # Gotchas
///
/// It computes tags, but it does not compare them. To check a received tag, compare all bytes in
/// constant time. Do not use `==` or a loop that stops at the first difference.
pub struct HmacSha384 {
  state: Hmac<Sha384>,
}

impl HmacSha384 {
  /// Returns an HMAC-SHA-384 state for `key`. Any key length is valid, also 0.
  ///
  /// A key longer than 128 bytes is hashed first. The state copies what it needs and does not
  /// borrow `key`.
  pub fn make(key: &[u8]) -> HmacSha384 {
    return HmacSha384 {state: Hmac<Sha384>.make(key)}
  }
  /// Adds `bytes` to the end of the message.
  ///
  /// Any split of the message into parts gives the same tag. An empty slice changes nothing.
  ///
  /// # Gotchas
  /// The program traps if the message is longer than 2^128 - 1 bits minus the 128-byte key block.
  pub fn update(self: &mut Self, bytes: &[u8]) -> () {
    self.state.update(bytes)
  }
  /// Returns the 48-byte HMAC-SHA-384 tag of the message and consumes the state.
  pub fn finish(self: Self) -> [u8; 48] {
    let mut tag: [u8; 48] = [0; 48]
    let state = move self.state
    state.finishInto(&mut tag)
    return tag
  }
  /// Returns the 48-byte HMAC-SHA-384 tag of `message` with `key`.
  ///
  /// An empty key or message is valid. To check a received tag, compare all bytes in constant time.
  /// Do not use `==` or a loop that stops at the first difference.
  pub fn authenticate(key: &[u8], message: &[u8]) -> [u8; 48] {
    let mut state = HmacSha384.make(key)
    state.update(message)
    return state.finish()
  }
}
