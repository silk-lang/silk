//! Elliptic-curve keys, ECDSA, and ECDH on every named curve over a prime field that OpenSSL and
//! Node.js list, such as `brainpoolP256r1`, `secp256k1`, `secp224r1`, and `SM2`.
//!
//! # When to use
//! Use [`EcPrivateKey`] and [`EcPublicKey`] for Node.js `crypto.createECDH`, `generateKeyPair('ec')`,
//! and `crypto.sign` with an `ec` key on any curve of `silk.crypto.ec_key.EcCurve`. For P-256,
//! P-384, P-521, or secp256k1 alone, `silk.crypto.p256`, `silk.crypto.p384`, `silk.crypto.p521`,
//! and `silk.crypto.secp256k1` are faster.
//!
//! # Details
//! An [`EcGroup`] holds the parameters of a curve `y^2 = x^3 + ax + b` modulo a prime `p` and its
//! base point `G` of prime order `n`. A private key is a number `d` from 1 to `n - 1` and its public
//! key is the point `dG`. Points are read and written in the SEC1 forms: uncompressed `04 || x || y`,
//! compressed `02` or `03 || x`, and hybrid `06` or `07 || x || y`.
//!
//! The signing functions take the digest of the message, not the message. A digest longer than `n`
//! keeps its leftmost bits, as OpenSSL does. A signature is `r || s`, each big-endian and
//! [`EcGroup.secretLength`] bytes, the IEEE P1363 form that Node.js calls `ieee-p1363`.
//! [`EcSignature`] converts it to and from DER, the default of Node.js. [`EcPrivateKey.agree`] gives
//! the x-coordinate of `dQ`, as Node.js `ecdh.computeSecret` does.
//!
//! Field arithmetic uses Montgomery multiplication on 64-bit limbs, and points use the complete
//! projective formulas of Renes, Costello, and Batina. Operations with a secret, such as
//! [`EcPrivateKey.generate`], [`EcPrivateKey.signDigest`], and [`EcPrivateKey.agree`], take the
//! same time for every secret of a curve: they have no branch and no memory access that depends on
//! the secret.
//!
//! # Errors
//! - [`EcError`] for a secret, a point, a length, or a signature that is not valid.
//!
//! # Gotchas
//! On a curve with a cofactor other than 1, such as `secp112r2`, [`EcPublicKey.fromBytes`] also
//! checks that the point is in the subgroup of the base point. Each signature needs a fresh secret
//! from a cryptographically secure `Random`; a repeated or predictable one reveals the private key.
//! The values stay in memory after use; nothing erases them.
//!
//! # Examples
//! ## Agree on a secret on brainpoolP256r1
//! ```silk
//! import silk.core.effect { Effect }
//! import silk.core.result { Result }
//! import silk.crypto.ec { EcError, EcGroup, EcPrivateKey }
//! import silk.crypto.ec_key { EcCurve }
//! import silk.num.u64
//! import silk.system.random { Random }
//!
//! // A test provider. Never use it for keys.
//! struct Counter {
//!   state: u64,
//! }
//!
//! impl Random for Counter {
//!   effect fn fillBytes(self: &mut Self, output: &mut [u8]) -> () {
//!     let mut index: usize = 0
//!     while index < output.length {
//!       self.state = u64.wrappingAdd(u64.wrappingMultiply(self.state, 6364136223846793005), 1)
//!       output[index] = u64.toU8(u64.shiftRight(self.state, 56))
//!       index = index + 1
//!     }
//!   }
//! }
//!
//! effect fn agreeBoth() -> i32 ! EcError ? &mut Random {
//!   let group = EcGroup.named(EcCurve.BrainpoolP256r1)
//!   let alice = run EcPrivateKey.generate(&group)
//!   let bob = run EcPrivateKey.generate(&group)
//!   let mut fromAlice: [u8; 32] = [0; 32]
//!   let mut fromBob: [u8; 32] = [0; 32]
//!   if let Result<(), EcError>.Failure { error } = alice.agree(&bob.publicKey(), &mut fromAlice) {
//!     fail error
//!   }
//!   if let Result<(), EcError>.Failure { error } = bob.agree(&alice.publicKey(), &mut fromBob) {
//!     fail error
//!   }
//!   let mut i: usize = 0
//!   while i < 32 {
//!     if fromAlice[i] != fromBob[i] {
//!       return 1
//!     }
//!     i = i + 1
//!   }
//!   return 0
//! }
//!
//! pub effect fn main() -> i32 ! EcError {
//!   let mut random = Counter { state: 1 }
//!   return run agreeBoth() |> Effect.provideMut<Random>(&mut random)
//! }
//! ```
//!
//! @category Cryptography

import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.crypto.ec_key { EcCurve }
import silk.io.writer { Writer, WriterError }
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silk.system.random { Random }
import silk.text.format { Debug, Format, Formatter }

/// The reason that an elliptic-curve secret, point, length, or signature was rejected.
pub enum EcError {
  /// A secret is 0 or not less than the order `n` of the base point.
  InvalidKey,
  /// A point encoding is not valid: the first byte is not a SEC1 form, the length is wrong, a
  /// coordinate is not less than `p`, the point is not on the curve or not in the subgroup of the
  /// base point, the hybrid parity does not match, or the point is the point at infinity.
  InvalidPoint,
  /// An input or output does not have the required length.
  InvalidLength,
  /// A DER signature is not strict DER of two non-negative integers.
  InvalidEncoding,
  /// The signature does not match the digest and the key.
  InvalidSignature,
  /// The shared point of a key agreement is the point at infinity.
  InvalidSharedSecret,
}

impl Debug for EcError {
  /// Writes the name of the variant, such as `InvalidKey`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return match &self.* {
      EcError.InvalidKey => run Format.write(&mut formatter, b"InvalidKey")
      EcError.InvalidPoint => run Format.write(&mut formatter, b"InvalidPoint")
      EcError.InvalidLength => run Format.write(&mut formatter, b"InvalidLength")
      EcError.InvalidEncoding => run Format.write(&mut formatter, b"InvalidEncoding")
      EcError.InvalidSignature => run Format.write(&mut formatter, b"InvalidSignature")
      EcError.InvalidSharedSecret => run Format.write(&mut formatter, b"InvalidSharedSecret")
    }
  }
}

/// The SEC1 form of an encoded public point.
pub enum EcPointFormat {
  /// `02` or `03`, by the parity of `y`, then `x`.
  Compressed,
  /// `04`, then `x` and `y`.
  Uncompressed,
  /// `06` or `07`, by the parity of `y`, then `x` and `y`.
  Hybrid,
}

impl Debug for EcPointFormat {
  /// Writes the name of the variant, such as `Compressed`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return match &self.* {
      EcPointFormat.Compressed => run Format.write(&mut formatter, b"Compressed")
      EcPointFormat.Uncompressed => run Format.write(&mut formatter, b"Uncompressed")
      EcPointFormat.Hybrid => run Format.write(&mut formatter, b"Hybrid")
    }
  }
}

// Little-endian 64-bit limbs. Nine limbs hold 576 bits, enough for P-521.
const LIMBS: usize = 9

struct Limbs {
  words: [u64; 9],
}

impl Copy for Limbs {}

// A prime modulus with the constants of Montgomery multiplication modulo it. Residues have
// `length` limbs; every loop runs over `length`, which depends only on the curve.
struct Field {
  modulus: Limbs,
  length: usize,
  bits: usize,
  // -modulus^-1 modulo 2^64.
  inverse: u64,
  // R = 2^(64 * length) modulo the modulus, which is 1 in Montgomery form.
  one: Limbs,
  // R^2 modulo the modulus.
  squared: Limbs,
}

impl Copy for Field {}

// A projective point (X : Y : Z) with Montgomery coordinates. The point at infinity has Z = 0.
struct Point {
  x: Limbs,
  y: Limbs,
  z: Limbs,
}

impl Copy for Point {}

/// The parameters of a named curve over a prime field, with its base point and order.
///
/// # When to use
/// Make one with [`EcGroup.curveName`] and pass it to the key functions of this module. Keep it for
/// all the operations on that curve.
///
/// # Details
/// Making a group converts the parameters to Montgomery form, which takes a few microseconds.
///
/// # Gotchas
/// It is a fixed-size value of about 1.5 KiB. Pass it by reference.
pub struct EcGroup {
  curveName: EcCurve,
  field: Field,
  order: Field,
  a: Limbs,
  b: Limbs,
  b3: Limbs,
  base: Point,
  cofactorValue: u32,
  fieldBytes: usize,
  orderBytes: usize,
}

impl Copy for EcGroup {}

/// An elliptic-curve public key: a point of the subgroup of the base point other than the point
/// at infinity.
///
/// # When to use
/// Use it to verify ECDSA signatures and as the peer key of [`EcPrivateKey.agree`]. Read one with
/// [`EcPublicKey.fromBytes`], or get one with [`EcPrivateKey.publicKey`].
///
/// # Gotchas
/// It is a fixed-size value of about 1.7 KiB. Pass it by reference.
pub struct EcPublicKey {
  domain: EcGroup,
  // Affine coordinates in Montgomery form.
  x: Limbs,
  y: Limbs,
}

impl Copy for EcPublicKey {}

/// An elliptic-curve private key: a secret `d` from 1 to `n - 1` and its public point `dG`.
///
/// # When to use
/// Use it to sign digests with ECDSA and to agree on a secret with ECDH. Generate one with
/// [`EcPrivateKey.generate`], or read one with [`EcPrivateKey.fromBytes`].
///
/// # Gotchas
/// It does not erase its memory when dropped. It is a fixed-size value of about 1.8 KiB. Pass it
/// by reference.
pub struct EcPrivateKey {
  public: EcPublicKey,
  // The secret as plain limbs.
  secret: Limbs,
}

impl Copy for EcPrivateKey {}

/// Conversions between the `r || s` form of an ECDSA signature and its DER form.
///
/// # When to use
/// Use it for Node.js `dsaEncoding`: `der`, the default, is the DER `SEQUENCE` of two `INTEGER`s,
/// and `ieee-p1363` is `r || s`, which [`EcPrivateKey.signDigest`] writes.
pub struct EcSignature {}

// Limb arithmetic. Every function runs in time that depends only on its length arguments.

fn zeroLimbs() -> Limbs {
  return Limbs { words: [0; 9] }
}

fn wordLimbs(value: u64) -> Limbs {
  let mut result = zeroLimbs()
  result.words[0] = value
  return result
}

// The carry out of a + b = sum. Compilers lower the comparison to a flag, not a branch.
fn carryOf(a: u64, b: u64, sum: u64) -> u64 {
  if u64.lessThan(sum, a) {
    return 1
  }
  return 0
}

// The borrow out of a - b = difference.
fn borrowOf(a: u64, b: u64, difference: u64) -> u64 {
  if u64.lessThan(a, b) {
    return 1
  }
  return 0
}

// All ones when `bit` is 1, else 0.
fn maskOf(bit: u64) -> u64 {
  return u64.wrappingSubtract(0, bit)
}

// 1 when `value` is 0, else 0.
fn zeroWord(value: u64) -> u64 {
  return u64.bitXor(u64.shiftRight(u64.bitOr(value, u64.wrappingSubtract(0, value)), 63), 1)
}

// The first `length` limbs of `ifSet` when `mask` is all ones, or of `ifClear` when it is 0.
fn selectLimbs(mask: u64, ifSet: &Limbs, ifClear: &Limbs, length: usize) -> Limbs {
  let mut result = zeroLimbs()
  let mut i: usize = 0
  while i < length {
    result.words[i] = u64.bitOr(
      u64.bitAnd(mask, ifSet.words[i]),
      u64.bitAnd(u64.bitNot(mask), ifClear.words[i]),
    )
    i = i + 1
  }
  return result
}

// 1 when the first `length` limbs are all 0.
fn isZeroBit(value: &Limbs, length: usize) -> u64 {
  let mut combined: u64 = 0
  let mut i: usize = 0
  while i < length {
    combined = u64.bitOr(combined, value.words[i])
    i = i + 1
  }
  return zeroWord(combined)
}

fn equalBit(left: &Limbs, right: &Limbs, length: usize) -> u64 {
  let mut combined: u64 = 0
  let mut i: usize = 0
  while i < length {
    combined = u64.bitOr(combined, u64.bitXor(left.words[i], right.words[i]))
    i = i + 1
  }
  return zeroWord(combined)
}

// 1 when left < right over `length` limbs.
fn lessBit(left: &Limbs, right: &Limbs, length: usize) -> u64 {
  let mut borrow: u64 = 0
  let mut i: usize = 0
  while i < length {
    let partial = u64.wrappingSubtract(left.words[i], right.words[i])
    let first = borrowOf(left.words[i], right.words[i], partial)
    let difference = u64.wrappingSubtract(partial, borrow)
    let second = borrowOf(partial, borrow, difference)
    borrow = u64.bitOr(first, second)
    i = i + 1
  }
  return borrow
}

// left - right over `length` limbs into `result`, returning the borrow.
fn subtractInto(result: &mut Limbs, left: &Limbs, right: &Limbs, length: usize) -> u64 {
  let mut borrow: u64 = 0
  let mut i: usize = 0
  while i < length {
    let partial = u64.wrappingSubtract(left.words[i], right.words[i])
    let first = borrowOf(left.words[i], right.words[i], partial)
    let difference = u64.wrappingSubtract(partial, borrow)
    let second = borrowOf(partial, borrow, difference)
    result.words[i] = difference
    borrow = u64.bitOr(first, second)
    i = i + 1
  }
  return borrow
}

// left + right over `length` limbs into `result`, returning the carry.
fn addInto(result: &mut Limbs, left: &Limbs, right: &Limbs, length: usize) -> u64 {
  let mut carry: u64 = 0
  let mut i: usize = 0
  while i < length {
    let partial = u64.wrappingAdd(left.words[i], right.words[i])
    let first = carryOf(left.words[i], right.words[i], partial)
    let sum = u64.wrappingAdd(partial, carry)
    let second = carryOf(partial, carry, sum)
    result.words[i] = sum
    carry = u64.bitOr(first, second)
    i = i + 1
  }
  return carry
}

// Reads big-endian bytes, at most 72, into limbs.
fn limbsFromBytes(bytes: &[u8]) -> Limbs {
  let mut result = zeroLimbs()
  let mut i: usize = 0
  while i < bytes.length {
    let position = bytes.length - 1 - i
    let word = i / 8
    result.words[word] = u64.bitOr(
      result.words[word],
      u64.shiftLeft(u8.toU64(bytes[position]), usize.toU64(8 * (i % 8))),
    )
    i = i + 1
  }
  return result
}

// Writes the low `output.length` bytes of the value, big-endian.
fn limbsToBytes(value: &Limbs, output: &mut [u8]) -> () {
  let mut i: usize = 0
  while i < output.length {
    let position = output.length - 1 - i
    output[position] = u64.toU8(
      u64.bitAnd(u64.shiftRight(value.words[i / 8], usize.toU64(8 * (i % 8))), 255),
    )
    i = i + 1
  }
}

fn bitLengthOf(value: &Limbs) -> usize {
  let mut i = LIMBS
  while i > 0 {
    i = i - 1
    if value.words[i] != 0 {
      return 64 * i + 64 - u32.toUsize(u64.leadingZeros(value.words[i]))
    }
  }
  return 0
}

// A shift right by `count` bits, for public values.
fn shiftRightLimbs(value: &Limbs, count: usize) -> Limbs {
  let mut result = zeroLimbs()
  let wordShift = count / 64
  let bitShift = usize.toU64(count % 64)
  let mut i: usize = 0
  while i + wordShift < LIMBS {
    let source = i + wordShift
    let mut word = u64.shiftRight(value.words[source], bitShift)
    if bitShift != 0 && source + 1 < LIMBS {
      word = u64.bitOr(word, u64.shiftLeft(value.words[source + 1], 64 - bitShift))
    }
    result.words[i] = word
    i = i + 1
  }
  return result
}

fn plainAddWord(value: &Limbs, word: u64) -> Limbs {
  let mut result = zeroLimbs()
  drop addInto(&mut result, value, &wordLimbs(word), LIMBS)
  return result
}

fn plainSubtractWord(value: &Limbs, word: u64) -> Limbs {
  let mut result = zeroLimbs()
  drop subtractInto(&mut result, value, &wordLimbs(word), LIMBS)
  return result
}

// Field arithmetic. Inputs are below the modulus; results are below it.

fn makeField(modulus: &Limbs) -> Field {
  let bits = bitLengthOf(modulus)
  let length = (bits + 63) / 64
  let first = modulus.words[0]
  // Newton's iteration doubles the correct low bits of the inverse: 3, 6, 12, 24, 48, 96.
  let mut inverse = first
  let mut i: usize = 0
  while i < 5 {
    inverse = u64.wrappingMultiply(inverse, u64.wrappingSubtract(2, u64.wrappingMultiply(first, inverse)))
    i = i + 1
  }
  let mut field = Field {
    modulus: modulus.*,
    length: length,
    bits: bits,
    inverse: u64.wrappingSubtract(0, inverse),
    one: zeroLimbs(),
    squared: zeroLimbs(),
  }
  // 2^(64 * length) and 2^(128 * length) modulo the modulus, one doubling at a time from 1.
  let mut value = wordLimbs(1)
  i = 0
  while i < 64 * length {
    value = fieldAdd(&field, &value, &value)
    i = i + 1
  }
  field.one = value
  i = 0
  while i < 64 * length {
    value = fieldAdd(&field, &value, &value)
    i = i + 1
  }
  field.squared = value
  return field
}

fn fieldAdd(field: &Field, left: &Limbs, right: &Limbs) -> Limbs {
  let length = field.length
  let mut sum = zeroLimbs()
  let carry = addInto(&mut sum, left, right, length)
  let mut reduced = zeroLimbs()
  let borrow = subtractInto(&mut reduced, &sum, &field.modulus, length)
  // Keep the reduced value when the sum overflowed or did not go below zero.
  let keep = u64.bitOr(carry, u64.bitXor(borrow, 1))
  return selectLimbs(maskOf(keep), &reduced, &sum, length)
}

fn fieldSubtract(field: &Field, left: &Limbs, right: &Limbs) -> Limbs {
  let length = field.length
  let mut difference = zeroLimbs()
  let borrow = subtractInto(&mut difference, left, right, length)
  let mut corrected = zeroLimbs()
  drop addInto(&mut corrected, &difference, &field.modulus, length)
  return selectLimbs(maskOf(borrow), &corrected, &difference, length)
}

// Montgomery multiplication: left * right / R modulo the modulus (CIOS).
fn fieldMultiply(field: &Field, left: &Limbs, right: &Limbs) -> Limbs {
  let length = field.length
  let mut t: [u64; 11] = [0; 11]
  let mut i: usize = 0
  while i < length {
    let factor = right.words[i]
    let mut carry: u64 = 0
    let mut j: usize = 0
    while j < length {
      let low = u64.wrappingMultiply(left.words[j], factor)
      let high = u64.multiplyHigh(left.words[j], factor)
      let partial = u64.wrappingAdd(low, t[j])
      let first = carryOf(low, t[j], partial)
      let sum = u64.wrappingAdd(partial, carry)
      let second = carryOf(partial, carry, sum)
      t[j] = sum
      carry = u64.wrappingAdd(high, u64.wrappingAdd(first, second))
      j = j + 1
    }
    let top = u64.wrappingAdd(t[length], carry)
    t[length + 1] = carryOf(t[length], carry, top)
    t[length] = top
    let reducer = u64.wrappingMultiply(t[0], field.inverse)
    let low = u64.wrappingMultiply(reducer, field.modulus.words[0])
    let high = u64.multiplyHigh(reducer, field.modulus.words[0])
    let partial = u64.wrappingAdd(low, t[0])
    carry = u64.wrappingAdd(high, carryOf(low, t[0], partial))
    j = 1
    while j < length {
      let productLow = u64.wrappingMultiply(reducer, field.modulus.words[j])
      let productHigh = u64.multiplyHigh(reducer, field.modulus.words[j])
      let partialSum = u64.wrappingAdd(productLow, t[j])
      let first = carryOf(productLow, t[j], partialSum)
      let sum = u64.wrappingAdd(partialSum, carry)
      let second = carryOf(partialSum, carry, sum)
      t[j - 1] = sum
      carry = u64.wrappingAdd(productHigh, u64.wrappingAdd(first, second))
      j = j + 1
    }
    let last = u64.wrappingAdd(t[length], carry)
    t[length - 1] = last
    t[length] = u64.wrappingAdd(t[length + 1], carryOf(t[length], carry, last))
    t[length + 1] = 0
    i = i + 1
  }
  let mut value = zeroLimbs()
  i = 0
  while i < length {
    value.words[i] = t[i]
    i = i + 1
  }
  let mut reduced = zeroLimbs()
  let borrow = subtractInto(&mut reduced, &value, &field.modulus, length)
  let keep = u64.bitOr(t[length], u64.bitXor(borrow, 1))
  return selectLimbs(maskOf(keep), &reduced, &value, length)
}

fn toMontgomery(field: &Field, value: &Limbs) -> Limbs {
  return fieldMultiply(field, value, &field.squared)
}

fn fromMontgomery(field: &Field, value: &Limbs) -> Limbs {
  return fieldMultiply(field, value, &wordLimbs(1))
}

// base^exponent for a Montgomery base and a public exponent.
fn fieldPower(field: &Field, base: &Limbs, exponent: &Limbs) -> Limbs {
  let mut result = field.one
  let mut index = bitLengthOf(exponent)
  while index > 0 {
    index = index - 1
    result = fieldMultiply(field, &result, &result)
    if u64.bitAnd(u64.shiftRight(exponent.words[index / 64], usize.toU64(index % 64)), 1) == 1 {
      result = fieldMultiply(field, &result, base)
    }
  }
  return result
}

// The inverse of a Montgomery value modulo a prime, by Fermat's little theorem. 0 gives 0.
fn fieldInvert(field: &Field, value: &Limbs) -> Limbs {
  return fieldPower(field, value, &plainSubtractWord(&field.modulus, 2))
}

// A plain value of up to `bits` bits modulo the modulus, one bit at a time.
fn fieldReduce(field: &Field, value: &Limbs, bits: usize) -> Limbs {
  let mut result = zeroLimbs()
  let mut index = bits
  while index > 0 {
    index = index - 1
    result = fieldAdd(field, &result, &result)
    let bit = u64.bitAnd(u64.shiftRight(value.words[index / 64], usize.toU64(index % 64)), 1)
    result = fieldAdd(field, &result, &wordLimbs(bit))
  }
  return result
}

// A square root of a Montgomery value, for public values (Tonelli-Shanks), or None.
fn fieldSquareRoot(field: &Field, value: &Limbs) -> Option<Limbs> {
  let length = field.length
  let modulus = &field.modulus
  let mut root = zeroLimbs()
  if u64.bitAnd(modulus.words[0], 3) == 3 {
    root = fieldPower(field, value, &shiftRightLimbs(&plainAddWord(modulus, 1), 2))
  } else {
    // p - 1 = q * 2^s with q odd.
    let below = plainSubtractWord(modulus, 1)
    let mut s: usize = 0
    while u64.bitAnd(u64.shiftRight(below.words[s / 64], usize.toU64(s % 64)), 1) == 0 {
      s = s + 1
    }
    let q = shiftRightLimbs(&below, s)
    let half = shiftRightLimbs(&below, 1)
    let minusOne = fieldSubtract(field, &zeroLimbs(), &field.one)
    let mut candidate: u64 = 2
    let mut nonResidue = toMontgomery(field, &wordLimbs(candidate))
    while equalBit(&fieldPower(field, &nonResidue, &half), &minusOne, length) == 0 {
      candidate = candidate + 1
      nonResidue = toMontgomery(field, &wordLimbs(candidate))
    }
    let mut m = s
    let mut c = fieldPower(field, &nonResidue, &q)
    let mut t = fieldPower(field, value, &q)
    root = fieldPower(field, value, &shiftRightLimbs(&plainAddWord(&q, 1), 1))
    while equalBit(&t, &field.one, length) == 0 && isZeroBit(&t, length) == 0 {
      let mut i: usize = 0
      let mut probe = t
      while equalBit(&probe, &field.one, length) == 0 {
        probe = fieldMultiply(field, &probe, &probe)
        i = i + 1
        if i == m {
          return Option<Limbs>.none()
        }
      }
      let mut b = c
      let mut j: usize = 0
      while j + i + 1 < m {
        b = fieldMultiply(field, &b, &b)
        j = j + 1
      }
      m = i
      c = fieldMultiply(field, &b, &b)
      t = fieldMultiply(field, &t, &c)
      root = fieldMultiply(field, &root, &b)
    }
  }
  if equalBit(&fieldMultiply(field, &root, &root), value, length) == 0 {
    return Option<Limbs>.none()
  }
  return Option<Limbs>.some(root)
}

// Points.

fn identity(group: &EcGroup) -> Point {
  return Point { x: zeroLimbs(), y: group.field.one, z: zeroLimbs() }
}

fn selectPoint(mask: u64, ifSet: &Point, ifClear: &Point, length: usize) -> Point {
  return Point {
    x: selectLimbs(mask, &ifSet.x, &ifClear.x, length),
    y: selectLimbs(mask, &ifSet.y, &ifClear.y, length),
    z: selectLimbs(mask, &ifSet.z, &ifClear.z, length),
  }
}

// Complete addition for any a (Renes, Costello, Batina 2016, algorithm 1).
fn addPoints(group: &EcGroup, p: &Point, q: &Point) -> Point {
  let f = &group.field
  let mut t0 = fieldMultiply(f, &p.x, &q.x)
  let mut t1 = fieldMultiply(f, &p.y, &q.y)
  let mut t2 = fieldMultiply(f, &p.z, &q.z)
  let mut t3 = fieldAdd(f, &p.x, &p.y)
  let mut t4 = fieldAdd(f, &q.x, &q.y)
  t3 = fieldMultiply(f, &t3, &t4)
  t4 = fieldAdd(f, &t0, &t1)
  t3 = fieldSubtract(f, &t3, &t4)
  t4 = fieldAdd(f, &p.x, &p.z)
  let mut t5 = fieldAdd(f, &q.x, &q.z)
  t4 = fieldMultiply(f, &t4, &t5)
  t5 = fieldAdd(f, &t0, &t2)
  t4 = fieldSubtract(f, &t4, &t5)
  t5 = fieldAdd(f, &p.y, &p.z)
  let mut x3 = fieldAdd(f, &q.y, &q.z)
  t5 = fieldMultiply(f, &t5, &x3)
  x3 = fieldAdd(f, &t1, &t2)
  t5 = fieldSubtract(f, &t5, &x3)
  let mut z3 = fieldMultiply(f, &group.a, &t4)
  x3 = fieldMultiply(f, &group.b3, &t2)
  z3 = fieldAdd(f, &x3, &z3)
  x3 = fieldSubtract(f, &t1, &z3)
  z3 = fieldAdd(f, &t1, &z3)
  let mut y3 = fieldMultiply(f, &x3, &z3)
  t1 = fieldAdd(f, &t0, &t0)
  t1 = fieldAdd(f, &t1, &t0)
  t2 = fieldMultiply(f, &group.a, &t2)
  t4 = fieldMultiply(f, &group.b3, &t4)
  t1 = fieldAdd(f, &t1, &t2)
  t2 = fieldSubtract(f, &t0, &t2)
  t2 = fieldMultiply(f, &group.a, &t2)
  t4 = fieldAdd(f, &t4, &t2)
  t0 = fieldMultiply(f, &t1, &t4)
  y3 = fieldAdd(f, &y3, &t0)
  t0 = fieldMultiply(f, &t5, &t4)
  x3 = fieldMultiply(f, &t3, &x3)
  x3 = fieldSubtract(f, &x3, &t0)
  t0 = fieldMultiply(f, &t3, &t1)
  z3 = fieldMultiply(f, &t5, &z3)
  z3 = fieldAdd(f, &z3, &t0)
  return Point { x: x3, y: y3, z: z3 }
}

// Complete doubling for any a (Renes, Costello, Batina 2016, algorithm 3).
fn doublePoint(group: &EcGroup, p: &Point) -> Point {
  let f = &group.field
  let mut t0 = fieldMultiply(f, &p.x, &p.x)
  let t1 = fieldMultiply(f, &p.y, &p.y)
  let mut t2 = fieldMultiply(f, &p.z, &p.z)
  let mut t3 = fieldMultiply(f, &p.x, &p.y)
  t3 = fieldAdd(f, &t3, &t3)
  let mut z3 = fieldMultiply(f, &p.x, &p.z)
  z3 = fieldAdd(f, &z3, &z3)
  let mut x3 = fieldMultiply(f, &group.a, &z3)
  let mut y3 = fieldMultiply(f, &group.b3, &t2)
  y3 = fieldAdd(f, &x3, &y3)
  x3 = fieldSubtract(f, &t1, &y3)
  y3 = fieldAdd(f, &t1, &y3)
  y3 = fieldMultiply(f, &x3, &y3)
  x3 = fieldMultiply(f, &t3, &x3)
  z3 = fieldMultiply(f, &group.b3, &z3)
  t2 = fieldMultiply(f, &group.a, &t2)
  t3 = fieldSubtract(f, &t0, &t2)
  t3 = fieldMultiply(f, &group.a, &t3)
  t3 = fieldAdd(f, &t3, &z3)
  z3 = fieldAdd(f, &t0, &t0)
  t0 = fieldAdd(f, &z3, &t0)
  t0 = fieldAdd(f, &t0, &t2)
  t0 = fieldMultiply(f, &t0, &t3)
  y3 = fieldAdd(f, &y3, &t0)
  t2 = fieldMultiply(f, &p.y, &p.z)
  t2 = fieldAdd(f, &t2, &t2)
  t0 = fieldMultiply(f, &t2, &t3)
  x3 = fieldSubtract(f, &x3, &t0)
  z3 = fieldMultiply(f, &t2, &t1)
  z3 = fieldAdd(f, &z3, &z3)
  z3 = fieldAdd(f, &z3, &z3)
  return Point { x: x3, y: y3, z: z3 }
}

// The multiples 0 to 15 of a point, for a 4-bit window.
fn windowTable(group: &EcGroup, point: &Point) -> [Point; 16] {
  let mut table: [Point; 16] = [identity(group); 16]
  table[1] = point.*
  let mut index: usize = 2
  while index < 16 {
    if index % 2 == 0 {
      table[index] = doublePoint(group, &table[index / 2])
    } else {
      table[index] = addPoints(group, &table[index - 1], point)
    }
    index = index + 1
  }
  return table
}

// The entry of the table for the 4-bit digit `window` of the scalar, read so that every entry is
// touched and the time does not depend on the digit.
fn windowEntry(group: &EcGroup, table: &[Point; 16], scalar: &Limbs, window: usize) -> Point {
  let position = 4 * window
  let digit = u64.bitAnd(u64.shiftRight(scalar.words[position / 64], usize.toU64(position % 64)), 15)
  let mut entry = table[0]
  let mut candidate: usize = 1
  while candidate < 16 {
    let mask = maskOf(zeroWord(u64.bitXor(digit, usize.toU64(candidate))))
    entry = selectPoint(mask, &table[candidate], &entry, group.field.length)
    candidate = candidate + 1
  }
  return entry
}

fn quadruple(group: &EcGroup, point: &Point) -> Point {
  let twice = doublePoint(group, point)
  let four = doublePoint(group, &twice)
  let eight = doublePoint(group, &four)
  return doublePoint(group, &eight)
}

// scalar * point for a plain scalar of up to `bits` bits, with a fixed 4-bit window, so the time
// does not depend on the scalar.
fn multiplyPoint(group: &EcGroup, point: &Point, scalar: &Limbs, bits: usize) -> Point {
  let table = windowTable(group, point)
  let mut result = identity(group)
  let mut window = (bits + 3) / 4
  while window > 0 {
    window = window - 1
    result = quadruple(group, &result)
    result = addPoints(group, &result, &windowEntry(group, &table, scalar, window))
  }
  return result
}

// first * p + second * q with shared doublings, for verification.
fn multiplyTwo(
  group: &EcGroup,
  p: &Point,
  first: &Limbs,
  q: &Point,
  second: &Limbs,
  bits: usize,
) -> Point {
  let firstTable = windowTable(group, p)
  let secondTable = windowTable(group, q)
  let mut result = identity(group)
  let mut window = (bits + 3) / 4
  while window > 0 {
    window = window - 1
    result = quadruple(group, &result)
    result = addPoints(group, &result, &windowEntry(group, &firstTable, first, window))
    result = addPoints(group, &result, &windowEntry(group, &secondTable, second, window))
  }
  return result
}

// Affine Montgomery coordinates of a point, or None for the point at infinity or an invalid
// result of the formulas (Z = 0).
fn affine(group: &EcGroup, point: &Point) -> Option<Point> {
  let f = &group.field
  if isZeroBit(&point.z, f.length) == 1 {
    return Option<Point>.none()
  }
  let inverse = fieldInvert(f, &point.z)
  return Option<Point>.some(
    Point {
      x: fieldMultiply(f, &point.x, &inverse),
      y: fieldMultiply(f, &point.y, &inverse),
      z: f.one,
    },
  )
}

// Whether the projective point is the point at infinity: Z = 0 and Y != 0.
fn isInfinity(group: &EcGroup, point: &Point) -> bool {
  let length = group.field.length
  return isZeroBit(&point.z, length) == 1 && isZeroBit(&point.y, length) == 0
}

// y^2 = x^3 + ax + b for affine Montgomery coordinates.
fn onCurve(group: &EcGroup, x: &Limbs, y: &Limbs) -> bool {
  let f = &group.field
  let left = fieldMultiply(f, y, y)
  return equalBit(&left, &rightSide(group, x), f.length) == 1
}

// x^3 + ax + b for a Montgomery x.
fn rightSide(group: &EcGroup, x: &Limbs) -> Limbs {
  let f = &group.field
  let squared = fieldMultiply(f, x, x)
  let withA = fieldAdd(f, &squared, &group.a)
  return fieldAdd(f, &fieldMultiply(f, &withA, x), &group.b)
}

fn plainParity(group: &EcGroup, y: &Limbs) -> u64 {
  return u64.bitAnd(fromMontgomery(&group.field, y).words[0], 1)
}

// The parameters of a curve as big-endian bytes: the prime, a and b, the base point, the order,
// and the cofactor.
struct CurveData {
  prime: &'static [u8],
  a: &'static [u8],
  b: &'static [u8],
  x: &'static [u8],
  y: &'static [u8],
  order: &'static [u8],
  cofactor: u32,
}

impl EcGroup {
  /// Returns the group of the named curve `curve`.
  pub fn named(curve: EcCurve) -> EcGroup {
    let data = curveData(curve)
    let field = makeField(&limbsFromBytes(data.prime))
    let order = makeField(&limbsFromBytes(data.order))
    let a = toMontgomery(&field, &limbsFromBytes(data.a))
    let b = toMontgomery(&field, &limbsFromBytes(data.b))
    let b3 = fieldAdd(&field, &b, &fieldAdd(&field, &b, &b))
    let base = Point {
      x: toMontgomery(&field, &limbsFromBytes(data.x)),
      y: toMontgomery(&field, &limbsFromBytes(data.y)),
      z: field.one,
    }
    return EcGroup {
      curveName: curve,
      field: field,
      order: order,
      a: a,
      b: b,
      b3: b3,
      base: base,
      cofactorValue: data.cofactor,
      fieldBytes: data.prime.length,
      orderBytes: data.order.length,
    }
  }

  /// Returns the named curve of the group.
  pub fn curve(self: &Self) -> EcCurve {
    return self.curveName
  }

  /// Returns the number of bits of the prime `p`, such as 256 for brainpoolP256r1.
  pub fn fieldBits(self: &Self) -> usize {
    return self.field.bits
  }

  /// Returns the number of bits of the order `n` of the base point, such as 161 for secp160r1.
  pub fn orderBits(self: &Self) -> usize {
    return self.order.bits
  }

  /// Returns the cofactor: the number of points of the curve divided by `n`, such as 1 for most
  /// curves and 4 for `secp112r2`.
  pub fn cofactor(self: &Self) -> u32 {
    return self.cofactorValue
  }

  /// Returns the length in bytes of a field element: the length of a shared secret from
  /// [`EcPrivateKey.agree`] and of each coordinate of an encoded point.
  pub fn fieldLength(self: &Self) -> usize {
    return self.fieldBytes
  }

  /// Returns the length in bytes of a secret, which is the byte length of `n`.
  pub fn secretLength(self: &Self) -> usize {
    return self.orderBytes
  }

  /// Returns the length in bytes of a signature in the `r || s` form: twice
  /// [`EcGroup.secretLength`].
  pub fn signatureLength(self: &Self) -> usize {
    return 2 * self.orderBytes
  }

  /// Returns the length in bytes of a point encoded in `format`: [`EcGroup.fieldBytes`] plus 1
  /// when compressed, and twice it plus 1 otherwise.
  pub fn encodedLength(self: &Self, format: EcPointFormat) -> usize {
    return match format {
      EcPointFormat.Compressed => self.fieldBytes + 1
      EcPointFormat.Uncompressed => 2 * self.fieldBytes + 1
      EcPointFormat.Hybrid => 2 * self.fieldBytes + 1
    }
  }
}

// The affine point of a SEC1 encoding with Montgomery coordinates, or None.
fn decodePoint(group: &EcGroup, encoded: &[u8]) -> Option<Point> {
  let f = &group.field
  let length = group.fieldBytes
  if encoded.length == 0 {
    return Option<Point>.none()
  }
  let tag = encoded[0]
  let compressed = (tag == 2 || tag == 3) && encoded.length == length + 1
  let full = (tag == 4 || tag == 6 || tag == 7) && encoded.length == 2 * length + 1
  if !compressed && !full {
    return Option<Point>.none()
  }
  let xPlain = limbsFromBytes(Slice.view<u8>(encoded, 1, length))
  if lessBit(&xPlain, &f.modulus, f.length) == 0 {
    return Option<Point>.none()
  }
  let x = toMontgomery(f, &xPlain)
  let mut y = zeroLimbs()
  if compressed {
    y = match fieldSquareRoot(f, &rightSide(group, &x)) {
      Option<Limbs>.Some { value } => value
      Option<Limbs>.None => {
        return Option<Point>.none()
      }
    }
    if plainParity(group, &y) != u8.toU64(u8.bitAnd(tag, 1)) {
      y = fieldSubtract(f, &zeroLimbs(), &y)
      if plainParity(group, &y) != u8.toU64(u8.bitAnd(tag, 1)) {
        return Option<Point>.none()
      }
    }
  } else {
    let yPlain = limbsFromBytes(Slice.view<u8>(encoded, 1 + length, length))
    if lessBit(&yPlain, &f.modulus, f.length) == 0 {
      return Option<Point>.none()
    }
    y = toMontgomery(f, &yPlain)
    if !onCurve(group, &x, &y) {
      return Option<Point>.none()
    }
    if tag != 4 && u64.bitAnd(yPlain.words[0], 1) != u8.toU64(u8.bitAnd(tag, 1)) {
      return Option<Point>.none()
    }
  }
  let point = Point { x: x, y: y, z: f.one }
  if group.cofactorValue != 1 {
    let check = multiplyPoint(group, &point, &group.order.modulus, group.order.bits)
    if !isInfinity(group, &check) {
      return Option<Point>.none()
    }
  }
  return Option<Point>.some(point)
}

fn writePoint(group: &EcGroup, x: &Limbs, y: &Limbs, format: EcPointFormat, output: &mut [u8]) -> usize {
  let f = &group.field
  let length = group.fieldBytes
  let xPlain = fromMontgomery(f, x)
  let yPlain = fromMontgomery(f, y)
  let parity = u64.toU8(u64.bitAnd(yPlain.words[0], 1))
  limbsToBytes(&xPlain, Slice.viewMut<u8>(&mut output, 1, length))
  return match format {
    EcPointFormat.Compressed => {
      output[0] = 2 + parity
      return length + 1
    }
    EcPointFormat.Uncompressed => {
      output[0] = 4
      limbsToBytes(&yPlain, Slice.viewMut<u8>(&mut output, 1 + length, length))
      return 2 * length + 1
    }
    EcPointFormat.Hybrid => {
      output[0] = 6 + parity
      limbsToBytes(&yPlain, Slice.viewMut<u8>(&mut output, 1 + length, length))
      return 2 * length + 1
    }
  }
}

// The leftmost bits of the digest, at most as many as n has, reduced modulo n.
fn digestScalar(group: &EcGroup, digest: &[u8]) -> Limbs {
  let bits = group.order.bits
  let mut take = digest.length
  if take > group.orderBytes {
    take = group.orderBytes
  }
  let mut value = limbsFromBytes(Slice.view<u8>(digest, 0, take))
  if 8 * take > bits {
    value = shiftRightLimbs(&value, 8 * take - bits)
  }
  return fieldReduce(&group.order, &value, bits)
}

// A uniform scalar from 1 to n - 1, by rejection: the rejected draws are independent of the
// result, so the time reveals nothing about it.
effect fn randomScalar(group: &EcGroup) -> Limbs
  ? &mut Random {
  let length = group.orderBytes
  let excess = 8 * length - group.order.bits
  let mut bytes: [u8; 72] = [0; 72]
  while true {
    run Random.fillBytes(Slice.viewMut<u8>(&mut bytes, 0, length))
    bytes[0] = u8.bitAnd(bytes[0], u32.toU8(u32.shiftRight(255, usize.toU32(excess))))
    let value = limbsFromBytes(Slice.view<u8>(&bytes, 0, length))
    let valid = u64.bitAnd(
      u64.bitXor(isZeroBit(&value, group.order.length), 1),
      lessBit(&value, &group.order.modulus, group.order.length),
    )
    if valid == 1 {
      return value
    }
  }
  return Intrinsic.trap("randomScalar: the loop returns")
}

fn keyFor(group: &EcGroup, secret: &Limbs) -> EcPrivateKey {
  let product = multiplyPoint(group, &group.base, secret, group.order.bits)
  let point = match affine(group, &product) {
    Option<Point>.Some { value } => value
    Option<Point>.None => Intrinsic.trap("EcPrivateKey: the public point is at infinity")
  }
  return EcPrivateKey {
    public: EcPublicKey { domain: group.*, x: point.x, y: point.y },
    secret: secret.*,
  }
}

fn affinePoint(key: &EcPublicKey) -> Point {
  return Point { x: key.x, y: key.y, z: key.domain.field.one }
}

impl EcPublicKey {
  /// Returns the public key for the SEC1 point `encoded` on `group`: compressed, uncompressed,
  /// or hybrid, as Node.js `ecdh.computeSecret` and `ECDH.convertKey` accept.
  ///
  /// The time depends on the point, which is public.
  ///
  /// # Errors
  /// - `InvalidPoint` if the encoding is not valid, a coordinate is not less than `p`, the point
  ///   is not on the curve, a hybrid parity does not match `y`, or, on a curve with a cofactor
  ///   other than 1, the point is not in the subgroup of the base point. The point at infinity
  ///   is rejected.
  pub fn fromBytes(group: &EcGroup, encoded: &[u8]) -> Result<EcPublicKey, EcError> {
    return match decodePoint(group, encoded) {
      Option<Point>.Some { value } => Result<EcPublicKey, EcError>.succeed(
        EcPublicKey { domain: group.*, x: value.x, y: value.y },
      )
      Option<Point>.None => Result<EcPublicKey, EcError>.failResult(EcError.InvalidPoint)
    }
  }

  /// Returns the group of the key.
  pub fn group(self: &Self) -> EcGroup {
    return self.domain
  }

  /// Writes the point in `format` to the start of `output`, and returns its length, which is
  /// [`EcGroup.encodedLength`]. The bytes of `output` after it do not change.
  ///
  /// # Errors
  /// - `InvalidLength` if `output` is shorter than the encoding.
  pub fn write(self: &Self, format: EcPointFormat, output: &mut [u8]) -> Result<usize, EcError> {
    if output.length < self.domain.encodedLength(format) {
      return Result<usize, EcError>.failResult(EcError.InvalidLength)
    }
    return Result<usize, EcError>.succeed(writePoint(&self.domain, &self.x, &self.y, format, &mut output))
  }

  /// Checks that `signature` is a valid ECDSA signature in the `r || s` form of the message with
  /// the digest `digest`.
  ///
  /// A digest longer than `n` keeps its leftmost [`EcGroup.orderBits`] bits, as OpenSSL does.
  ///
  /// # Errors
  /// - `InvalidLength` if `signature` is not [`EcGroup.signatureLength`] bytes.
  /// - `InvalidSignature` if `r` or `s` is not from 1 to `n - 1`, or the signature does not
  ///   match.
  pub fn verifyDigest(self: &Self, digest: &[u8], signature: &[u8]) -> Result<(), EcError> {
    let group = &self.domain
    let half = group.orderBytes
    if signature.length != 2 * half {
      return Result<(), EcError>.failResult(EcError.InvalidLength)
    }
    let order = &group.order
    let r = limbsFromBytes(Slice.view<u8>(signature, 0, half))
    let s = limbsFromBytes(Slice.view<u8>(signature, half, half))
    if isZeroBit(&r, order.length) == 1 || isZeroBit(&s, order.length) == 1
      || lessBit(&r, &order.modulus, order.length) == 0
      || lessBit(&s, &order.modulus, order.length) == 0 {
      return Result<(), EcError>.failResult(EcError.InvalidSignature)
    }
    let z = digestScalar(group, digest)
    let w = fieldInvert(order, &toMontgomery(order, &s))
    let first = fromMontgomery(order, &fieldMultiply(order, &toMontgomery(order, &z), &w))
    let second = fromMontgomery(order, &fieldMultiply(order, &toMontgomery(order, &r), &w))
    let sum = multiplyTwo(group, &group.base, &first, &affinePoint(self), &second, order.bits)
    let point = match affine(group, &sum) {
      Option<Point>.Some { value } => value
      Option<Point>.None => {
        return Result<(), EcError>.failResult(EcError.InvalidSignature)
      }
    }
    let x = fromMontgomery(&group.field, &point.x)
    let v = fieldReduce(order, &x, group.field.bits)
    if equalBit(&v, &r, order.length) == 0 {
      return Result<(), EcError>.failResult(EcError.InvalidSignature)
    }
    return Result<(), EcError>.succeed(())
  }
}

impl EcPrivateKey {
  /// Returns a new key on `group`, with a secret from the ambient `Random`.
  ///
  /// The secret is uniform from 1 to `n - 1`. The time of the public point does not depend on
  /// the secret. The `Random` provider must be cryptographically secure.
  pub effect fn generate(group: &EcGroup) -> EcPrivateKey
    ? &mut Random {
    let secret = run randomScalar(group)
    return keyFor(group, &secret)
  }

  /// Returns the private key for the big-endian secret `secret` on `group`, and computes its
  /// public point, as Node.js `ecdh.setPrivateKey` does. Leading zero bytes are allowed.
  ///
  /// The time depends only on the length of `secret`.
  ///
  /// # Errors
  /// - `InvalidKey` if the secret is 0 or not less than `n`.
  pub fn fromBytes(group: &EcGroup, secret: &[u8]) -> Result<EcPrivateKey, EcError> {
    let mut start: usize = 0
    let mut overflow: u8 = 0
    if secret.length > 72 {
      start = secret.length - 72
      let mut i: usize = 0
      while i < start {
        overflow = u8.bitOr(overflow, secret[i])
        i = i + 1
      }
    }
    let value = limbsFromBytes(Slice.view<u8>(secret, start, secret.length - start))
    let order = &group.order
    let mut high: u64 = 0
    let mut i = order.length
    while i < LIMBS {
      high = u64.bitOr(high, value.words[i])
      i = i + 1
    }
    let valid = u64.bitAnd(
      u64.bitAnd(zeroWord(u64.bitOr(high, u8.toU64(overflow))), u64.bitXor(isZeroBit(&value, order.length), 1)),
      lessBit(&value, &order.modulus, order.length),
    )
    if valid == 0 {
      return Result<EcPrivateKey, EcError>.failResult(EcError.InvalidKey)
    }
    return Result<EcPrivateKey, EcError>.succeed(keyFor(group, &value))
  }

  /// Returns the group of the key.
  pub fn group(self: &Self) -> EcGroup {
    return self.public.domain
  }

  /// Returns the public half of the key.
  pub fn publicKey(self: &Self) -> EcPublicKey {
    return self.public
  }

  /// Writes the secret to all of `output`, big-endian with leading zero bytes, as Node.js
  /// `ecdh.getPrivateKey` does.
  ///
  /// # Errors
  /// - `InvalidLength` if `output` is not [`EcGroup.secretLength`] bytes.
  ///
  /// # Gotchas
  /// The bytes are the private key. Keep them secret.
  pub fn writeSecret(self: &Self, output: &mut [u8]) -> Result<(), EcError> {
    if output.length != self.public.domain.orderBytes {
      return Result<(), EcError>.failResult(EcError.InvalidLength)
    }
    limbsToBytes(&self.secret, &mut output)
    return Result<(), EcError>.succeed(())
  }

  /// Signs the message with the digest `digest` with ECDSA and writes the signature to
  /// `signature` in the `r || s` form. It reads the per-signature secret `k` from the ambient
  /// `Random`.
  ///
  /// A digest longer than `n` keeps its leftmost [`EcGroup.orderBits`] bits, as OpenSSL does. The
  /// time does not depend on the secret or on `k`.
  ///
  /// # Errors
  /// - `InvalidLength` if `signature` is not [`EcGroup.signatureLength`] bytes.
  ///
  /// # Gotchas
  /// The `Random` provider must be cryptographically secure: a repeated or biased `k` reveals
  /// the private key.
  pub effect fn signDigest(self: &Self, digest: &[u8], signature: &mut [u8]) -> ()
    ! EcError
    ? &mut Random {
    let group = &self.public.domain
    let half = group.orderBytes
    if signature.length != 2 * half {
      fail EcError.InvalidLength
    }
    let order = &group.order
    let z = toMontgomery(order, &digestScalar(group, digest))
    let d = toMontgomery(order, &self.secret)
    while true {
      let k = run randomScalar(group)
      let point = match affine(group, &multiplyPoint(group, &group.base, &k, order.bits)) {
        Option<Point>.Some { value } => value
        Option<Point>.None => Intrinsic.trap("signDigest: kG is at infinity")
      }
      let r = fieldReduce(order, &fromMontgomery(&group.field, &point.x), group.field.bits)
      if isZeroBit(&r, order.length) == 1 {
        continue
      }
      let inverse = fieldInvert(order, &toMontgomery(order, &k))
      let sum = fieldAdd(order, &z, &fieldMultiply(order, &toMontgomery(order, &r), &d))
      let s = fromMontgomery(order, &fieldMultiply(order, &inverse, &sum))
      if isZeroBit(&s, order.length) == 1 {
        continue
      }
      limbsToBytes(&r, Slice.viewMut<u8>(&mut signature, 0, half))
      limbsToBytes(&s, Slice.viewMut<u8>(&mut signature, half, half))
      return ()
    }
  }

  /// Writes the shared secret with the peer key `peer` to `output`: the x-coordinate of `dQ`,
  /// big-endian and [`EcGroup.fieldBytes`] bytes, as Node.js `ecdh.computeSecret` and
  /// `crypto.diffieHellman` do.
  ///
  /// The time does not depend on the secret.
  ///
  /// # Errors
  /// - `InvalidLength` if `output` is not [`EcGroup.fieldBytes`] bytes.
  /// - `InvalidPoint` if `peer` is on another curve.
  /// - `InvalidSharedSecret` if the shared point is the point at infinity.
  ///
  /// # Gotchas
  /// Pass the secret through a key derivation function, such as `silk.crypto.hkdf`, before you
  /// use it as a key.
  pub fn agree(self: &Self, peer: &EcPublicKey, output: &mut [u8]) -> Result<(), EcError> {
    let group = &self.public.domain
    if output.length != group.fieldBytes {
      return Result<(), EcError>.failResult(EcError.InvalidLength)
    }
    if peer.domain.curveName != group.curveName {
      return Result<(), EcError>.failResult(EcError.InvalidPoint)
    }
    let product = multiplyPoint(group, &affinePoint(peer), &self.secret, group.order.bits)
    let point = match affine(group, &product) {
      Option<Point>.Some { value } => value
      Option<Point>.None => {
        return Result<(), EcError>.failResult(EcError.InvalidSharedSecret)
      }
    }
    limbsToBytes(&fromMontgomery(&group.field, &point.x), &mut output)
    return Result<(), EcError>.succeed(())
  }
}

impl EcSignature {
  /// Returns the length of the DER form of the `r || s` signature `signature`.
  ///
  /// # Gotchas
  /// The program traps if `signature` has an odd length or is longer than 144 bytes.
  pub fn derLength(signature: &[u8]) -> usize {
    let half = halfOf(signature)
    let content = signatureContentLength(signature, half)
    return headerLength(content) + content
  }

  /// Writes the DER form of the `r || s` signature `signature` to the start of `output`, and
  /// returns its length, which is [`EcSignature.derLength`]. The bytes of `output` after the DER
  /// do not change.
  ///
  /// # Errors
  /// - `InvalidLength` if `output` is shorter than the DER.
  ///
  /// # Gotchas
  /// The program traps if `signature` has an odd length or is longer than 144 bytes.
  pub fn toDer(signature: &[u8], output: &mut [u8]) -> Result<usize, EcError> {
    let half = halfOf(signature)
    let content = signatureContentLength(signature, half)
    if output.length < headerLength(content) + content {
      return Result<usize, EcError>.failResult(EcError.InvalidLength)
    }
    let mut at = writeHeader(&mut output, 0, 48, content)
    at = writeInteger(&mut output, at, Slice.view<u8>(signature, 0, half))
    at = writeInteger(&mut output, at, Slice.view<u8>(signature, half, half))
    return Result<usize, EcError>.succeed(at)
  }

  /// Reads the DER signature `der` and writes it to all of `output` in the `r || s` form, each
  /// half `output.length / 2` bytes, such as [`EcGroup.signatureLength`].
  ///
  /// # Errors
  /// - `InvalidEncoding` if `der` is not strict DER of two non-negative integers.
  /// - `InvalidSignature` if `r` or `s` is 0 or does not fit in half of `output`.
  /// - `InvalidLength` if `output` has an odd length.
  pub fn fromDer(der: &[u8], output: &mut [u8]) -> Result<(), EcError> {
    if output.length % 2 != 0 {
      return Result<(), EcError>.failResult(EcError.InvalidLength)
    }
    let half = output.length / 2
    let sequence = readDer(der, 0, der.length, 48)
    if !sequence.valid || sequence.end != der.length {
      return Result<(), EcError>.failResult(EcError.InvalidEncoding)
    }
    let r = readInteger(der, sequence.start, sequence.end)
    if !r.valid {
      return Result<(), EcError>.failResult(EcError.InvalidEncoding)
    }
    let s = readInteger(der, r.end, sequence.end)
    if !s.valid || s.end != sequence.end {
      return Result<(), EcError>.failResult(EcError.InvalidEncoding)
    }
    let rBytes = significant(Slice.view<u8>(der, r.start, r.end - r.start))
    let sBytes = significant(Slice.view<u8>(der, s.start, s.end - s.start))
    if rBytes.length == 0 || sBytes.length == 0 || rBytes.length > half || sBytes.length > half {
      return Result<(), EcError>.failResult(EcError.InvalidSignature)
    }
    let mut i: usize = 0
    while i < output.length {
      output[i] = 0
      i = i + 1
    }
    i = 0
    while i < rBytes.length {
      output[half - rBytes.length + i] = rBytes[i]
      i = i + 1
    }
    i = 0
    while i < sBytes.length {
      output[output.length - sBytes.length + i] = sBytes[i]
      i = i + 1
    }
    return Result<(), EcError>.succeed(())
  }
}

fn halfOf(signature: &[u8]) -> usize {
  if signature.length % 2 != 0 || signature.length > 144 {
    Intrinsic.trap("EcSignature: the signature is not r || s")
  }
  return signature.length / 2
}

// Skips leading zero bytes. Only for public values: the time depends on the count.
fn significant<'a>(bytes: &'a [u8]) -> &'a [u8] {
  let mut start: usize = 0
  while start < bytes.length && bytes[start] == 0 {
    start = start + 1
  }
  return Slice.view<u8>(bytes, start, bytes.length - start)
}

// The content length of a DER INTEGER for big-endian bytes.
fn integerContentLength(bytes: &[u8]) -> usize {
  let value = significant(bytes)
  if value.length == 0 {
    return 1
  }
  if value[0] >= 128 {
    return value.length + 1
  }
  return value.length
}

fn signatureContentLength(signature: &[u8], half: usize) -> usize {
  let r = integerContentLength(Slice.view<u8>(signature, 0, half))
  let s = integerContentLength(Slice.view<u8>(signature, half, half))
  return headerLength(r) + r + headerLength(s) + s
}

fn headerLength(length: usize) -> usize {
  if length < 128 {
    return 2
  }
  return 3
}

fn writeHeader(output: &mut [u8], position: usize, tag: u8, length: usize) -> usize {
  output[position] = tag
  if length < 128 {
    output[position + 1] = usize.toU8(length)
    return position + 2
  }
  output[position + 1] = 129
  output[position + 2] = usize.toU8(length)
  return position + 3
}

fn writeInteger(output: &mut [u8], position: usize, bytes: &[u8]) -> usize {
  let value = significant(bytes)
  let content = integerContentLength(bytes)
  let mut at = writeHeader(&mut output, position, 2, content)
  if content > value.length {
    output[at] = 0
    at = at + 1
  }
  let mut i: usize = 0
  while i < value.length {
    output[at + i] = value[i]
    i = i + 1
  }
  return at + value.length
}

struct DerValue {
  start: usize,
  end: usize,
  valid: bool,
}

fn invalidDer() -> DerValue {
  return DerValue { start: 0, end: 0, valid: false }
}

// Reads the element with `tag` at `offset` that must end by `limit`, with a length below 256.
fn readDer(bytes: &[u8], offset: usize, limit: usize, tag: u8) -> DerValue {
  if limit > bytes.length || offset >= limit || limit - offset < 2 || bytes[offset] != tag {
    return invalidDer()
  }
  let first = bytes[offset + 1]
  let mut start = offset + 2
  let mut length = u8.toUsize(first)
  if first == 129 {
    if limit - start < 1 || bytes[start] < 128 {
      return invalidDer()
    }
    length = u8.toUsize(bytes[start])
    start = start + 1
  } else if first >= 128 {
    return invalidDer()
  }
  if length > limit - start {
    return invalidDer()
  }
  return DerValue { start: start, end: start + length, valid: true }
}

// Reads a minimal, non-negative DER INTEGER.
fn readInteger(bytes: &[u8], offset: usize, limit: usize) -> DerValue {
  let value = readDer(bytes, offset, limit, 2)
  if !value.valid || value.start == value.end || bytes[value.start] >= 128 {
    return invalidDer()
  }
  if bytes[value.start] == 0 && value.end - value.start > 1 && bytes[value.start + 1] < 128 {
    return invalidDer()
  }
  return move value
}

fn curveData(curve: EcCurve) -> CurveData {
  return match curve {
    EcCurve.Secp112r1 => CurveData {
