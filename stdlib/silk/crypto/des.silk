// PC-1 and PC-2 of FIPS 46-3, as source bit numbers counted from the least significant bit.
const CHOICE1: [u8; 56] = [7, 15, 23, 31, 39, 47, 55, 63, 6, 14, 22, 30, 38, 46, 54, 62, 5, 13, 21, 29, 37, 45, 53, 61, 4, 12, 20, 28, 1, 9, 17, 25, 33, 41, 49, 57, 2, 10, 18, 26, 34, 42, 50, 58, 3, 11, 19, 27, 35, 43, 51, 59, 36, 44, 52, 60]
const CHOICE2: [u8; 48] = [42, 39, 45, 32, 55, 51, 53, 28, 41, 50, 35, 46, 33, 37, 44, 52, 30, 48, 40, 49, 29, 36, 43, 54, 15, 4, 25, 19, 9, 1, 26, 16, 5, 11, 23, 8, 12, 7, 17, 0, 22, 3, 10, 14, 6, 20, 27, 24]
const ROTATIONS: [u8; 16] = [1, 1, 2, 2, 2, 2, 2, 2, 1, 2, 2, 2, 2, 2, 2, 1]

/// A Triple DES (EDE) key schedule.
///
/// # Details
///
/// Make one with [`TripleDes.make`] and run it in a mode from `silk.crypto.block_cipher`, or call
/// `encryptBlock` and `decryptBlock` of `BlockCipher`, which use the first 8 bytes of the array.
pub struct TripleDes {
  first: [u64; 16],
  second: [u64; 16],
  third: [u64; 16],
}

impl TripleDes {
  /// Returns the key schedule of `key`: 24 bytes for K1, K2, K3, or 16 bytes for K1, K2 with K3 =
  /// K1.
  ///
  /// # Errors
  ///
  /// - `InvalidKeyLength` if `key` is not 16 or 24 bytes.
  pub fn make(key: &[u8]) -> Result<TripleDes, BlockCipherError> {
    if key.length != 16 && key.length != 24 {
      return Result<TripleDes, BlockCipherError>.failResult(BlockCipherError.InvalidKeyLength)
    }
    let first = subkeys(key, 0)
    let second = subkeys(key, 8)
    let mut third = first
    if key.length == 24 {
      third = subkeys(key, 16)
    }
    return Result<TripleDes, BlockCipherError>.succeed(TripleDes { first: first, second: second, third: third })
  }
}

impl BlockCipher for TripleDes {
  /// Returns 8.
  fn blockLength(self: &Self) -> usize {
    return 8
  }

  /// Encrypts the first 8 bytes of `block` in place.
  fn encryptBlock(self: &Self, block: &mut [u8; 16]) -> () {
    let mut value = load(&block.*)
    value = crypt(&self.first, value, false)
    value = crypt(&self.second, value, true)
    value = crypt(&self.third, value, false)
    store(&mut block, value)
  }

  /// Decrypts the first 8 bytes of `block` in place.
  fn decryptBlock(self: &Self, block: &mut [u8; 16]) -> () {
    let mut value = load(&block.*)
    value = crypt(&self.third, value, true)
    value = crypt(&self.second, value, false)
    value = crypt(&self.first, value, true)
    store(&mut block, value)
  }
}

fn load(block: &[u8; 16]) -> u64 {
  let mut value: u64 = 0
  let mut index: usize = 0
  while index < 8 {
    value = u64.bitOr(u64.shiftLeft(value, 8), u8.toU64(block[index]))
    index = index + 1
  }
  return value
}

fn store(block: &mut [u8; 16], value: u64) -> () {
  let mut index: usize = 0
  while index < 8 {
    block[index] = u64.toU8(u64.bitAnd(u64.shiftRight(value, usize.toU64(56 - 8 * index)), 255))
    index = index + 1
  }
}

// Bit `n` of the result, counted from the most significant of `count` bits, is bit `table[n]` of
// `source`, counted from the least significant.
fn permute(source: u64, table: &[u8], count: usize) -> u64 {
  let mut result: u64 = 0
  let mut position: usize = 0
  while position < count {
    let bit = u64.bitAnd(u64.shiftRight(source, u8.toU64(table[position])), 1)
    result = u64.bitOr(result, u64.shiftLeft(bit, usize.toU64(count - 1 - position)))
    position = position + 1
  }
  return result
}

// The 16 round keys of the DES key at `offset` of `key`. Each 48-bit key is spread over 8 bytes,
// one 6-bit group per byte, in the order that `feistel` reads them.
fn subkeys(key: &[u8], offset: usize) -> [u64; 16] {
  let mut packed: u64 = 0
  let mut index: usize = 0
  while index < 8 {
    packed = u64.bitOr(u64.shiftLeft(packed, 8), u8.toU64(key[offset + index]))
    index = index + 1
  }
  let chosen = permute(packed, &CHOICE1, 56)
  let mut left = u64.toU32(u64.shiftRight(chosen, 28))
  let mut right = u64.toU32(u64.bitAnd(chosen, 0x0fffffff))
  let mut keys: [u64; 16] = [0; 16]
  let mut round: usize = 0
  while round < 16 {
    let shift = u8.toU32(ROTATIONS[round])
    left = u32.bitAnd(u32.bitOr(u32.shiftLeft(left, shift), u32.shiftRight(left, 28 - shift)), 0x0fffffff)
    right = u32.bitAnd(u32.bitOr(u32.shiftLeft(right, shift), u32.shiftRight(right, 28 - shift)), 0x0fffffff)
    let combined = u64.bitOr(u64.shiftLeft(u32.toU64(left), 28), u32.toU64(right))
    let chosenKey = permute(combined, &CHOICE2, 48)
    keys[round] = spread(chosenKey)
    round = round + 1
  }
  return keys
}

fn spread(key: u64) -> u64 {
  let groups: [u64; 8] = [1, 3, 5, 7, 0, 2, 4, 6]
  let mut result: u64 = 0
  let mut index: usize = 0
  while index < 8 {
    let group = u64.bitAnd(u64.shiftRight(key, 6 * groups[index]), 255)
    result = u64.bitOr(result, u64.shiftLeft(group, usize.toU64(8 * index)))
    index = index + 1
  }
  return result
}

fn box(table: usize, index: u32) -> u32 {
  return FEISTEL[table * 64 + u32.toUsize(u32.bitAnd(index, 63))]
}

// Two DES rounds: `left` takes the round function of `right` under `first`, then `right` takes
// that of the new `left` under `second`.
fn feistel(left: u32, right: u32, first: u64, second: u64) -> [u32; 2] {
  let mut l = left
  let mut r = right
  let mut t = u32.bitXor(r, u64.toU32(u64.shiftRight(first, 32)))
  l = u32.bitXor(l, u32.bitXor(u32.bitXor(box(7, t), box(5, u32.shiftRight(t, 8))), u32.bitXor(box(3, u32.shiftRight(t, 16)), box(1, u32.shiftRight(t, 24)))))
  t = u32.bitXor(u32.rotateLeft(r, 28), u64.toU32(u64.bitAnd(first, 0xffffffff)))
  l = u32.bitXor(l, u32.bitXor(u32.bitXor(box(6, t), box(4, u32.shiftRight(t, 8))), u32.bitXor(box(2, u32.shiftRight(t, 16)), box(0, u32.shiftRight(t, 24)))))
  t = u32.bitXor(l, u64.toU32(u64.shiftRight(second, 32)))
  r = u32.bitXor(r, u32.bitXor(u32.bitXor(box(7, t), box(5, u32.shiftRight(t, 8))), u32.bitXor(box(3, u32.shiftRight(t, 16)), box(1, u32.shiftRight(t, 24)))))
  t = u32.bitXor(u32.rotateLeft(l, 28), u64.toU32(u64.bitAnd(second, 0xffffffff)))
  r = u32.bitXor(r, u32.bitXor(u32.bitXor(box(6, t), box(4, u32.shiftRight(t, 8))), u32.bitXor(box(2, u32.shiftRight(t, 16)), box(0, u32.shiftRight(t, 24)))))
  return [l, r]
}

// One DES encryption or decryption of the 64-bit block `value` with the round keys `keys`.
fn crypt(keys: &[u64; 16], value: u64, decrypting: bool) -> u64 {
  let permuted = initial(value)
  let mut left = u32.rotateLeft(u64.toU32(u64.shiftRight(permuted, 32)), 1)
  let mut right = u32.rotateLeft(u64.toU32(u64.bitAnd(permuted, 0xffffffff)), 1)
  let mut pair: usize = 0
  while pair < 8 {
    let mut first = keys[2 * pair]
    let mut second = keys[2 * pair + 1]
    if decrypting {
      first = keys[15 - 2 * pair]
      second = keys[14 - 2 * pair]
    }
    let next = feistel(left, right, first, second)
    left = next[0]
    right = next[1]
    pair = pair + 1
  }
  left = u32.rotateRight(left, 1)
  right = u32.rotateRight(right, 1)
  return final(u64.bitOr(u64.shiftLeft(u32.toU64(right), 32), u32.toU64(left)))
}

// Swaps the bits selected by `mask` with those `shift` places above them.
fn exchange(value: u64, mask: u64, shift: u64) -> u64 {
  let delta = u64.bitAnd(u64.bitXor(u64.shiftRight(value, shift), value), mask)
  return u64.bitXor(value, u64.bitXor(delta, u64.shiftLeft(delta, shift)))
}

// The initial permutation IP as a sequence of bit-group exchanges.
fn initial(value: u64) -> u64 {
  let mut block = value
  block = exchange(block, 0xffff, 48)
  block = exchange(block, 0xff00ff00, 24)
  block = exchange(block, 0x0000f0f00000f0f0, 12)
  block = exchange(block, 0x00cc00cc00cc00cc, 6)
  block = exchange(block, 0x55555555, 33)
  return block
}

// The final permutation, the inverse of `initial`.
fn final(value: u64) -> u64 {
  let mut block = value
  block = exchange(block, 0x55555555, 33)
  block = exchange(block, 0x00cc00cc00cc00cc, 6)
  block = exchange(block, 0x0000f0f00000f0f0, 12)
  block = exchange(block, 0xff00ff00, 24)
  block = exchange(block, 0xffff, 48)
  return block
}
