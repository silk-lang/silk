impl Digest for Ripemd160 {
  /// Returns a RIPEMD-160 state for an empty message.
  make: Ripemd160.make
  /// Adds `bytes` to the end of the message.
  update: Ripemd160.update
  /// Returns 64, the RIPEMD-160 block length in bytes.
  fn blockLength(self: &Self) -> usize {
    return 64
  }
  /// Returns 20, the RIPEMD-160 digest length in bytes.
  fn digestLength(self: &Self) -> usize {
    return 20
  }
  /// Returns the content bytes of the RIPEMD-160 object identifier, 1.3.36.3.2.1.
  fn objectIdentifier(self: &Self) -> &[u8] {
    return b"\x2b\x24\x03\x02\x01"
  }
  /// Returns an independent copy of the state.
  fn copy(self: &Self) -> Self {
    return Ripemd160 {words: self.words, buffer: self.buffer, used: self.used, length: self.length}
  }
  /// Writes the 20-byte RIPEMD-160 digest to the start of `output` and consumes the state.
  fn finishInto(self: Self, output: &mut [u8]) -> () {
    let digest = Ripemd160.finish(move self)
    writeDigest(&digest, move output)
  }
}

// Writes `digest` to the start of `output` for `Digest.finishInto`.
fn writeDigest(digest: &[u8], output: &mut [u8]) -> () {
  let mut index: usize = 0
  while index < digest.length {
    output[index] = digest[index]
    index = index + 1
  }
}
