//! Compute RIPEMD-160 digests for formats that name them, such as Bitcoin addresses.
//!
//! # When to use
//! Use [`Ripemd160`] only where a format requires RIPEMD-160. Use SHA-256 for new protocols.
//!
//! # Details
//! The streaming state does not allocate. Call `make`, `update`, and `finish`, or use `hash`. The
//! digest is 20 bytes.
//!
//! # Examples
//! ## Hash a message in parts
//! ```silk
//! import silk.crypto.ripemd160 { Ripemd160 }
//!
//! pub fn main() -> i32 {
//!   let mut state = Ripemd160.make()
//!   state.update(b"a")
//!   state.update(b"bc")
//!   let digest = state.finish()
//!   // RIPEMD-160("abc") is 8eb208f7...0bfc.
//!   if digest[0] != 0x8e || digest[19] != 0xfc {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! # See also
//! [The RIPEMD-160 page](https://homes.esat.kuleuven.be/~bosselae/ripemd160.html) defines the
//! algorithm and its test vectors.
//!
//! @category Cryptography

import silk.num.u32
import silk.crypto.digest {Digest}
import silk.num.u64
import silk.collections.slice { Slice }
import silk.num.u8
import silk.num.usize
import silk.encoding.endian

/// A streaming RIPEMD-160 state that returns a 20-byte digest. It does not allocate.
pub struct Ripemd160 {
  words: [u32; 5],
  buffer: [u8; 64],
  used: usize,
  length: u64,
}

impl Ripemd160 {
  /// Returns a state for an empty message.
  pub fn make() -> Self {
    return Ripemd160 {
      words: [0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476, 0xc3d2e1f0],
      buffer: [0; 64],
      used: 0,
      length: 0
    }
  }

  /// Adds bytes to the message. The length in bits wraps modulo 2^64, as RIPEMD-160 requires.
  pub fn update(self: &mut Self, bytes: &[u8]) -> () {
    self.length = u64.wrappingAdd(self.length, u64.wrappingMultiply(usize.toU64(bytes.length), 8))
    // Fill a partial block first, then compress whole blocks straight from `bytes`, and keep the
    // rest. Each byte is copied at most once.
    let mut index: usize = 0
    if self.used > 0 {
      let mut take = 64 - self.used
      if take > bytes.length { take = bytes.length }
      Slice.copyInto<u8>(&mut self.buffer, self.used, Slice.view<u8>(bytes, 0, take))
      self.used = self.used + take
      index = take
      if self.used < 64 { return () }
      let block = self.buffer
      compress(&mut self.words, &block, 0)
      self.used = 0
    }
    while bytes.length - index >= 64 {
      compress(&mut self.words, bytes, index)
      index = index + 64
    }
    if index < bytes.length {
      Slice.copyInto<u8>(&mut self.buffer, 0, Slice.view<u8>(bytes, index, bytes.length - index))
      self.used = bytes.length - index
    }
    return ()
  }

  /// Consumes the state and returns its 20-byte digest.
  pub fn finish(self: Self) -> [u8; 20] {
    let mut state = move self
    let bits = state.length
    let mut padding: [u8; 64] = [0; 64]
    padding[0] = 128
    let mut count: usize = 120 - state.used
    if state.used < 56 {
      count = 56 - state.used
    }
    state.update(Slice.view<u8>(&padding, 0, count))
    let mut lengthBytes: [u8; 8] = [0; 8]
    let mut index: usize = 0
    while index < 8 {
      lengthBytes[index] = u64.toU8(u64.bitAnd(u64.shiftRight(bits, usize.toU64(index * 8)), 255))
      index = index + 1
    }
    state.update(&lengthBytes)
    let mut digest: [u8; 20] = [0; 20]
    index = 0
    while index < 20 {
      digest[index] = u32.toU8(
        u32.bitAnd(
          u32.shiftRight(state.words[index / 4], usize.toU32(usize.remainder(index, 4) * 8)),
          255
        )
      )
      index = index + 1
    }
    return digest
  }

  /// Returns the 20-byte RIPEMD-160 digest of `bytes`. It does not allocate.
  pub fn hash(bytes: &[u8]) -> [u8; 20] {
    let mut state = Ripemd160.make()
    state.update(bytes)
    return state.finish()
  }
}

// Compresses the 64-byte block at `offset` in `bytes` into `words`. Both lines of 80 steps are
// unrolled, with the word orders, shifts and constants of the RIPEMD-160 specification inline.
fn compress(words: &mut [u32; 5], bytes: &[u8], offset: usize) -> () {
  let block = Slice.view<u8>(bytes, offset, 64)
  let m0 = endian.readU32LittleEndian(block, 0)
  let m1 = endian.readU32LittleEndian(block, 4)
  let m2 = endian.readU32LittleEndian(block, 8)
  let m3 = endian.readU32LittleEndian(block, 12)
  let m4 = endian.readU32LittleEndian(block, 16)
  let m5 = endian.readU32LittleEndian(block, 20)
  let m6 = endian.readU32LittleEndian(block, 24)
  let m7 = endian.readU32LittleEndian(block, 28)
  let m8 = endian.readU32LittleEndian(block, 32)
  let m9 = endian.readU32LittleEndian(block, 36)
  let m10 = endian.readU32LittleEndian(block, 40)
  let m11 = endian.readU32LittleEndian(block, 44)
  let m12 = endian.readU32LittleEndian(block, 48)
  let m13 = endian.readU32LittleEndian(block, 52)
  let m14 = endian.readU32LittleEndian(block, 56)
  let m15 = endian.readU32LittleEndian(block, 60)
  // `zero` is always zero, because a slice offset is below 2^63, but the optimizer cannot prove it.
  // Mixing it into each constant keeps the constant with the message word, which is ready early.
  let zero = u32.wrappingSubtract(0, u64.toU32(u64.shiftRight(usize.toU64(offset), 63)))
  let mut al = words[0]
  let mut bl = words[1]
  let mut cl = words[2]
  let mut dl = words[3]
  let mut el = words[4]
  let mut ar = words[0]
  let mut br = words[1]
  let mut cr = words[2]
  let mut dr = words[3]
  let mut er = words[4]
  let tl0 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(al, m0), u32.bitXor(u32.bitXor(bl, cl), dl)), 11), el)
  al = el
  el = dl
  dl = u32.rotateLeft(cl, 10)
  cl = bl
  bl = tl0
  let tr0 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(ar, u32.wrappingAdd(m5, u32.bitXor(0x50a28be6, zero))), u32.bitXor(br, u32.bitOr(cr, u32.bitNot(dr)))), 8), er)
  ar = er
  er = dr
  dr = u32.rotateLeft(cr, 10)
  cr = br
  br = tr0
  let tl1 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(al, m1), u32.bitXor(u32.bitXor(bl, cl), dl)), 14), el)
  al = el
  el = dl
  dl = u32.rotateLeft(cl, 10)
  cl = bl
  bl = tl1
  let tr1 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(ar, u32.wrappingAdd(m14, u32.bitXor(0x50a28be6, zero))), u32.bitXor(br, u32.bitOr(cr, u32.bitNot(dr)))), 9), er)
  ar = er
  er = dr
  dr = u32.rotateLeft(cr, 10)
  cr = br
  br = tr1
  let tl2 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(al, m2), u32.bitXor(u32.bitXor(bl, cl), dl)), 15), el)
  al = el
  el = dl
  dl = u32.rotateLeft(cl, 10)
  cl = bl
  bl = tl2
  let tr2 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(ar, u32.wrappingAdd(m7, u32.bitXor(0x50a28be6, zero))), u32.bitXor(br, u32.bitOr(cr, u32.bitNot(dr)))), 9), er)
  ar = er
  er = dr
  dr = u32.rotateLeft(cr, 10)
  cr = br
  br = tr2
  let tl3 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(al, m3), u32.bitXor(u32.bitXor(bl, cl), dl)), 12), el)
  al = el
  el = dl
  dl = u32.rotateLeft(cl, 10)
  cl = bl
  bl = tl3
  let tr3 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(ar, u32.wrappingAdd(m0, u32.bitXor(0x50a28be6, zero))), u32.bitXor(br, u32.bitOr(cr, u32.bitNot(dr)))), 11), er)
  ar = er
  er = dr
  dr = u32.rotateLeft(cr, 10)
  cr = br
  br = tr3
  let tl4 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(al, m4), u32.bitXor(u32.bitXor(bl, cl), dl)), 5), el)
  al = el
  el = dl
  dl = u32.rotateLeft(cl, 10)
  cl = bl
  bl = tl4
  let tr4 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(ar, u32.wrappingAdd(m9, u32.bitXor(0x50a28be6, zero))), u32.bitXor(br, u32.bitOr(cr, u32.bitNot(dr)))), 13), er)
  ar = er
  er = dr
  dr = u32.rotateLeft(cr, 10)
  cr = br
  br = tr4
  let tl5 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(al, m5), u32.bitXor(u32.bitXor(bl, cl), dl)), 8), el)
  al = el
  el = dl
  dl = u32.rotateLeft(cl, 10)
  cl = bl
  bl = tl5
  let tr5 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(ar, u32.wrappingAdd(m2, u32.bitXor(0x50a28be6, zero))), u32.bitXor(br, u32.bitOr(cr, u32.bitNot(dr)))), 15), er)
  ar = er
  er = dr
  dr = u32.rotateLeft(cr, 10)
  cr = br
  br = tr5
  let tl6 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(al, m6), u32.bitXor(u32.bitXor(bl, cl), dl)), 7), el)
  al = el
  el = dl
  dl = u32.rotateLeft(cl, 10)
  cl = bl
  bl = tl6
  let tr6 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(ar, u32.wrappingAdd(m11, u32.bitXor(0x50a28be6, zero))), u32.bitXor(br, u32.bitOr(cr, u32.bitNot(dr)))), 15), er)
  ar = er
  er = dr
  dr = u32.rotateLeft(cr, 10)
  cr = br
  br = tr6
  let tl7 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(al, m7), u32.bitXor(u32.bitXor(bl, cl), dl)), 9), el)
  al = el
  el = dl
  dl = u32.rotateLeft(cl, 10)
  cl = bl
  bl = tl7
  let tr7 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(ar, u32.wrappingAdd(m4, u32.bitXor(0x50a28be6, zero))), u32.bitXor(br, u32.bitOr(cr, u32.bitNot(dr)))), 5), er)
  ar = er
  er = dr
  dr = u32.rotateLeft(cr, 10)
  cr = br
  br = tr7
  let tl8 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(al, m8), u32.bitXor(u32.bitXor(bl, cl), dl)), 11), el)
  al = el
  el = dl
  dl = u32.rotateLeft(cl, 10)
  cl = bl
  bl = tl8
  let tr8 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(ar, u32.wrappingAdd(m13, u32.bitXor(0x50a28be6, zero))), u32.bitXor(br, u32.bitOr(cr, u32.bitNot(dr)))), 7), er)
  ar = er
  er = dr
  dr = u32.rotateLeft(cr, 10)
  cr = br
  br = tr8
  let tl9 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(al, m9), u32.bitXor(u32.bitXor(bl, cl), dl)), 13), el)
  al = el
  el = dl
  dl = u32.rotateLeft(cl, 10)
  cl = bl
  bl = tl9
  let tr9 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(ar, u32.wrappingAdd(m6, u32.bitXor(0x50a28be6, zero))), u32.bitXor(br, u32.bitOr(cr, u32.bitNot(dr)))), 7), er)
  ar = er
  er = dr
  dr = u32.rotateLeft(cr, 10)
  cr = br
  br = tr9
  let tl10 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(al, m10), u32.bitXor(u32.bitXor(bl, cl), dl)), 14), el)
  al = el
  el = dl
  dl = u32.rotateLeft(cl, 10)
  cl = bl
  bl = tl10
  let tr10 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(ar, u32.wrappingAdd(m15, u32.bitXor(0x50a28be6, zero))), u32.bitXor(br, u32.bitOr(cr, u32.bitNot(dr)))), 8), er)
  ar = er
  er = dr
  dr = u32.rotateLeft(cr, 10)
  cr = br
  br = tr10
  let tl11 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(al, m11), u32.bitXor(u32.bitXor(bl, cl), dl)), 15), el)
  al = el
  el = dl
  dl = u32.rotateLeft(cl, 10)
  cl = bl
  bl = tl11
  let tr11 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(ar, u32.wrappingAdd(m8, u32.bitXor(0x50a28be6, zero))), u32.bitXor(br, u32.bitOr(cr, u32.bitNot(dr)))), 11), er)
  ar = er
  er = dr
  dr = u32.rotateLeft(cr, 10)
  cr = br
  br = tr11
  let tl12 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(al, m12), u32.bitXor(u32.bitXor(bl, cl), dl)), 6), el)
  al = el
  el = dl
  dl = u32.rotateLeft(cl, 10)
  cl = bl
  bl = tl12
  let tr12 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(ar, u32.wrappingAdd(m1, u32.bitXor(0x50a28be6, zero))), u32.bitXor(br, u32.bitOr(cr, u32.bitNot(dr)))), 14), er)
  ar = er
  er = dr
  dr = u32.rotateLeft(cr, 10)
  cr = br
  br = tr12
  let tl13 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(al, m13), u32.bitXor(u32.bitXor(bl, cl), dl)), 7), el)
  al = el
  el = dl
  dl = u32.rotateLeft(cl, 10)
  cl = bl
  bl = tl13
  let tr13 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(ar, u32.wrappingAdd(m10, u32.bitXor(0x50a28be6, zero))), u32.bitXor(br, u32.bitOr(cr, u32.bitNot(dr)))), 14), er)
  ar = er
  er = dr
  dr = u32.rotateLeft(cr, 10)
  cr = br
  br = tr13
  let tl14 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(al, m14), u32.bitXor(u32.bitXor(bl, cl), dl)), 9), el)
  al = el
  el = dl
  dl = u32.rotateLeft(cl, 10)
  cl = bl
  bl = tl14
  let tr14 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(ar, u32.wrappingAdd(m3, u32.bitXor(0x50a28be6, zero))), u32.bitXor(br, u32.bitOr(cr, u32.bitNot(dr)))), 12), er)
  ar = er
  er = dr
  dr = u32.rotateLeft(cr, 10)
  cr = br
  br = tr14
  let tl15 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(al, m15), u32.bitXor(u32.bitXor(bl, cl), dl)), 8), el)
  al = el
  el = dl
  dl = u32.rotateLeft(cl, 10)
  cl = bl
  bl = tl15
  let tr15 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(ar, u32.wrappingAdd(m12, u32.bitXor(0x50a28be6, zero))), u32.bitXor(br, u32.bitOr(cr, u32.bitNot(dr)))), 6), er)
  ar = er
  er = dr
  dr = u32.rotateLeft(cr, 10)
  cr = br
  br = tr15
  let tl16 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(al, u32.wrappingAdd(m7, u32.bitXor(0x5a827999, zero))), u32.bitXor(dl, u32.bitAnd(bl, u32.bitXor(cl, dl)))), 7), el)
  al = el
  el = dl
  dl = u32.rotateLeft(cl, 10)
  cl = bl
  bl = tl16
  let tr16 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(ar, u32.wrappingAdd(m6, u32.bitXor(0x5c4dd124, zero))), u32.bitXor(cr, u32.bitAnd(dr, u32.bitXor(br, cr)))), 9), er)
  ar = er
  er = dr
  dr = u32.rotateLeft(cr, 10)
  cr = br
  br = tr16
  let tl17 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(al, u32.wrappingAdd(m4, u32.bitXor(0x5a827999, zero))), u32.bitXor(dl, u32.bitAnd(bl, u32.bitXor(cl, dl)))), 6), el)
  al = el
  el = dl
  dl = u32.rotateLeft(cl, 10)
  cl = bl
  bl = tl17
  let tr17 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(ar, u32.wrappingAdd(m11, u32.bitXor(0x5c4dd124, zero))), u32.bitXor(cr, u32.bitAnd(dr, u32.bitXor(br, cr)))), 13), er)
  ar = er
  er = dr
  dr = u32.rotateLeft(cr, 10)
  cr = br
  br = tr17
  let tl18 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(al, u32.wrappingAdd(m13, u32.bitXor(0x5a827999, zero))), u32.bitXor(dl, u32.bitAnd(bl, u32.bitXor(cl, dl)))), 8), el)
  al = el
  el = dl
  dl = u32.rotateLeft(cl, 10)
  cl = bl
  bl = tl18
  let tr18 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(ar, u32.wrappingAdd(m3, u32.bitXor(0x5c4dd124, zero))), u32.bitXor(cr, u32.bitAnd(dr, u32.bitXor(br, cr)))), 15), er)
  ar = er
  er = dr
  dr = u32.rotateLeft(cr, 10)
  cr = br
  br = tr18
  let tl19 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(al, u32.wrappingAdd(m1, u32.bitXor(0x5a827999, zero))), u32.bitXor(dl, u32.bitAnd(bl, u32.bitXor(cl, dl)))), 13), el)
  al = el
  el = dl
  dl = u32.rotateLeft(cl, 10)
  cl = bl
  bl = tl19
  let tr19 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(ar, u32.wrappingAdd(m7, u32.bitXor(0x5c4dd124, zero))), u32.bitXor(cr, u32.bitAnd(dr, u32.bitXor(br, cr)))), 7), er)
  ar = er
  er = dr
  dr = u32.rotateLeft(cr, 10)
  cr = br
  br = tr19
  let tl20 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(al, u32.wrappingAdd(m10, u32.bitXor(0x5a827999, zero))), u32.bitXor(dl, u32.bitAnd(bl, u32.bitXor(cl, dl)))), 11), el)
  al = el
  el = dl
  dl = u32.rotateLeft(cl, 10)
  cl = bl
  bl = tl20
  let tr20 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(ar, u32.wrappingAdd(m0, u32.bitXor(0x5c4dd124, zero))), u32.bitXor(cr, u32.bitAnd(dr, u32.bitXor(br, cr)))), 12), er)
  ar = er
  er = dr
  dr = u32.rotateLeft(cr, 10)
  cr = br
  br = tr20
  let tl21 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(al, u32.wrappingAdd(m6, u32.bitXor(0x5a827999, zero))), u32.bitXor(dl, u32.bitAnd(bl, u32.bitXor(cl, dl)))), 9), el)
  al = el
  el = dl
  dl = u32.rotateLeft(cl, 10)
  cl = bl
  bl = tl21
  let tr21 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(ar, u32.wrappingAdd(m13, u32.bitXor(0x5c4dd124, zero))), u32.bitXor(cr, u32.bitAnd(dr, u32.bitXor(br, cr)))), 8), er)
  ar = er
  er = dr
  dr = u32.rotateLeft(cr, 10)
  cr = br
  br = tr21
  let tl22 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(al, u32.wrappingAdd(m15, u32.bitXor(0x5a827999, zero))), u32.bitXor(dl, u32.bitAnd(bl, u32.bitXor(cl, dl)))), 7), el)
  al = el
  el = dl
  dl = u32.rotateLeft(cl, 10)
  cl = bl
  bl = tl22
  let tr22 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(ar, u32.wrappingAdd(m5, u32.bitXor(0x5c4dd124, zero))), u32.bitXor(cr, u32.bitAnd(dr, u32.bitXor(br, cr)))), 9), er)
  ar = er
  er = dr
  dr = u32.rotateLeft(cr, 10)
  cr = br
  br = tr22
  let tl23 = u32.wrappingAdd(u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(al, u32.wrappingAdd(m3, u32.bitXor(0x5a827999, zero))), u32.bitXor(dl, u32.bitAnd(bl, u32.bitXor(cl, dl)))), 15), el)
  al = el
  el = dl
  dl = u32.rotateLeft(cl, 10)
