  v1 = u64.wrappingAdd(u64.wrappingAdd(v1, v5), m3)
  v13 = u64.rotateRight(u64.bitXor(v13, v1), 16)
  v9 = u64.wrappingAdd(v9, v13)
  v5 = u64.rotateRight(u64.bitXor(v5, v9), 63)
  v2 = u64.wrappingAdd(u64.wrappingAdd(v2, v6), m4)
  v14 = u64.rotateRight(u64.bitXor(v14, v2), 32)
  v10 = u64.wrappingAdd(v10, v14)
  v6 = u64.rotateRight(u64.bitXor(v6, v10), 24)
  v2 = u64.wrappingAdd(u64.wrappingAdd(v2, v6), m5)
  v14 = u64.rotateRight(u64.bitXor(v14, v2), 16)
  v10 = u64.wrappingAdd(v10, v14)
