//! Portable BLAKE2b-512 state for the unkeyed 64-byte cryptographic digest of RFC 7693.
//!
//! # When to use
//! Use [`Blake2b512`] where a format names BLAKE2b with a 64-byte digest, such as prehashed
//! minisign signatures. Use `silk.crypto.sha2` where a protocol names SHA-2. Use
//! `silk.collections.hash` only for collection keys. It is not a cryptographic hash.
//!
//! # Details
//! The state supports incremental input through `update`, consuming finalization through `finish`,
//! and one-shot input through `hash`. It uses only inline storage and allocates no memory. The
//! digest is the little-endian encoding of the final state words, as RFC 7693 specifies.
//!
//! # Gotchas
//! Keyed hashing, salts, personalization and digest lengths other than 64 bytes are not supported.
//! If an update makes the message longer than 2^128 - 1 bytes, the program traps. `finish`
//! consumes its state, so the program cannot update or finish that state again.
//!
//! # Examples
//! ## Hash a short message
//! ```silk
//! import silk.crypto.blake2b {Blake2b512}
//!
//! pub fn main() -> i32 {
//!   let message: [u8; 3] = [97, 98, 99]
//!   let digest = Blake2b512.hash(&message)
//!   if digest[0] != 186 || digest[63] != 35 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Cryptography

import silk.num.u8
import silk.crypto.digest {Digest}
import silk.num.u64
import silk.num.usize
import silk.encoding.endian
import silk.collections.slice {Slice}

/// An incremental unkeyed BLAKE2b state with a 64-byte digest (RFC 7693).
///
/// # When to use
///
/// Use it where a format names BLAKE2b with a 64-byte digest, such as prehashed minisign
/// signatures. Use `silk.crypto.sha2` where a protocol names SHA-2. Use `silk.collections.hash`
/// only for collection keys. It is not a cryptographic hash.
///
/// # Details
///
/// Give input in parts with [`Blake2b512.update`] and get the digest with [`Blake2b512.finish`],
/// or hash one slice with [`Blake2b512.hash`]. The state uses only inline storage and allocates no
/// memory. The digest is the little-endian encoding of the final state words.
///
/// # Gotchas
///
/// Keyed hashing, salts, personalization and digest lengths other than 64 bytes are not supported.
/// If an update makes the message longer than 2^128 - 1 bytes, the program traps.
pub struct Blake2b512 {
  words: [u64; 8],
  buffer: [u8; 128],
  buffered: usize,
  countLow: u64,
  countHigh: u64,
}

impl Blake2b512 {
  /// Creates an empty BLAKE2b-512 state.
  pub fn make() -> Blake2b512 {
    let mut words = initial()

    // Parameter block word zero: digest length 64, no key, fanout 1, depth 1.
    words[0] = u64.bitXor(words[0], 0x01010040)
    return Blake2b512 {
      words: words,
      buffer: [0; 128],
      buffered: usize.ZERO,
      countLow: 0,
      countHigh: 0
    }
  }

  /// Adds `bytes` to this state in source order. An empty slice does not change the state.
  ///
  /// # Details
  /// A full block is compressed only when more input follows it, because the final block is
  /// compressed with the finalization flag. It allocates no memory.
  ///
  /// # Gotchas
  /// If an update makes the message longer than 2^128 - 1 bytes, the program traps.
  pub fn update(self: &mut Self, bytes: &[u8]) -> () {
    // The last block is compressed with the final flag, so a full block stays buffered until more
    // bytes follow. Whole blocks with more bytes after them are compressed straight from `bytes`.
    let mut index = usize.ZERO
    if self.buffered > usize.ZERO {
      let mut take = 128 - self.buffered
      if take > bytes.length { take = bytes.length }
      Slice.copyInto<u8>(&mut self.buffer, self.buffered, Slice.view<u8>(bytes, usize.ZERO, take))
      self.buffered = self.buffered + take
      index = take
      if index == bytes.length { return () }
      advance(&mut self.*, 128)
      compress(&mut self.words, &self.buffer, usize.ZERO, self.countLow, self.countHigh, false)
      self.buffered = usize.ZERO
    }
    while bytes.length - index > 128 {
      advance(&mut self.*, 128)
      compress(&mut self.words, bytes, index, self.countLow, self.countHigh, false)
      index = index + 128
    }
    Slice.copyInto<u8>(&mut self.buffer, usize.ZERO, Slice.view<u8>(bytes, index, bytes.length - index))
    self.buffered = bytes.length - index
    return ()
  }


  /// Consumes this state and returns its 64-byte digest.
  ///
  /// # Gotchas
  ///
  /// The state is consumed, so the program cannot update or finish it again. Use
  /// [`Blake2b512.hash`] for one slice.
  pub fn finish(self: Self) -> [u8; 64] {
    let mut state = move self
    let buffered = state.buffered
    advance(&mut state, usize.toU64(buffered))
    let mut index = buffered
    while index < 128 {
      state.buffer[index] = 0
      index = index + usize.ONE
    }
    compress(&mut state.words, &state.buffer, usize.ZERO, state.countLow, state.countHigh, true)
    let mut digest: [u8; 64] = [0; 64]
    index = usize.ZERO
    while index < 64 {
      let shift = usize.toU64((index % 8) * 8)
      digest[index] = u64.toU8(u64.bitAnd(u64.shiftRight(state.words[index / 8], shift), 255))
      index = index + usize.ONE
    }
    return digest
  }

  /// Returns the 64-byte BLAKE2b digest of `bytes`.
  pub fn hash(bytes: &[u8]) -> [u8; 64] {
    let mut state = Blake2b512.make()
    state.update(bytes)
    return state.finish()
  }
}

// Adds `count` bytes to the 128-bit message counter, trapping past its domain.
fn advance(state: &mut Blake2b512, count: u64) -> () {
  let low = u64.wrappingAdd(state.countLow, count)
  if low < state.countLow {
    if state.countHigh == u64.MAX {
      Intrinsic.trap("Blake2b512.update: the total input is longer than 2^128 bytes")
    }
    state.countHigh = state.countHigh + 1
  }
  state.countLow = low
  return ()
}

// Compresses the 128-byte block at `offset` in `bytes` into `words`, with the 128-bit byte count
// `countLow` and `countHigh` and the final-block flag `last`. The rounds are unrolled.
fn compress(words: &mut [u64; 8], bytes: &[u8], offset: usize, countLow: u64, countHigh: u64, last: bool) -> () {
  let block = Slice.view<u8>(bytes, offset, 128)
  let m0 = endian.readU64LittleEndian(block, 0)
  let m1 = endian.readU64LittleEndian(block, 8)
  let m2 = endian.readU64LittleEndian(block, 16)
  let m3 = endian.readU64LittleEndian(block, 24)
  let m4 = endian.readU64LittleEndian(block, 32)
  let m5 = endian.readU64LittleEndian(block, 40)
  let m6 = endian.readU64LittleEndian(block, 48)
  let m7 = endian.readU64LittleEndian(block, 56)
  let m8 = endian.readU64LittleEndian(block, 64)
  let m9 = endian.readU64LittleEndian(block, 72)
  let m10 = endian.readU64LittleEndian(block, 80)
  let m11 = endian.readU64LittleEndian(block, 88)
  let m12 = endian.readU64LittleEndian(block, 96)
  let m13 = endian.readU64LittleEndian(block, 104)
  let m14 = endian.readU64LittleEndian(block, 112)
  let m15 = endian.readU64LittleEndian(block, 120)
  let start = initial()
  let mut v0 = words[0]
  let mut v1 = words[1]
  let mut v2 = words[2]
  let mut v3 = words[3]
  let mut v4 = words[4]
  let mut v5 = words[5]
  let mut v6 = words[6]
  let mut v7 = words[7]
  let mut v8 = start[0]
  let mut v9 = start[1]
  let mut v10 = start[2]
  let mut v11 = start[3]
  let mut v12 = u64.bitXor(start[4], countLow)
  let mut v13 = u64.bitXor(start[5], countHigh)
  let mut v14 = start[6]
  let mut v15 = start[7]
  if last {
    v14 = u64.bitNot(v14)
  }
  v0 = u64.wrappingAdd(u64.wrappingAdd(v0, v4), m0)
  v12 = u64.rotateRight(u64.bitXor(v12, v0), 32)
  v8 = u64.wrappingAdd(v8, v12)
  v4 = u64.rotateRight(u64.bitXor(v4, v8), 24)
  v0 = u64.wrappingAdd(u64.wrappingAdd(v0, v4), m1)
  v12 = u64.rotateRight(u64.bitXor(v12, v0), 16)
  v8 = u64.wrappingAdd(v8, v12)
