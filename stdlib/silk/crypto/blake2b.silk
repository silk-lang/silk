//! Portable BLAKE2b-512 state for the unkeyed 64-byte cryptographic digest of RFC 7693.
//!
//! # When to use
//! Use [`Blake2b512`] where a format names BLAKE2b with a 64-byte digest, such as prehashed
//! minisign signatures. Use `silk.crypto.sha2` where a protocol names SHA-2. Use `silk.collections.hash` only for
//! collection keys. It is not a cryptographic hash.
//!
//! # Details
//! The state supports incremental input through `update`, consuming finalization through `finish`,
//! and one-shot input through `hash`. It uses only inline storage and allocates no memory. The
//! digest is the little-endian encoding of the final state words, as RFC 7693 specifies.
//!
//! # Gotchas
//! Keyed hashing, salts, personalization and digest lengths other than 64 bytes are not supported.
//! If an update makes the message longer than 2^128 - 1 bytes, the program traps. `finish`
//! consumes its state, so the program cannot update or finish that state again.
//!
//! # Examples
//! ## Hash a short message
//! ```silk
//! import silk.crypto.blake2b {Blake2b512}
//!
//! pub fn main() -> i32 {
//!   let message: [u8; 3] = [97, 98, 99]
//!   let digest = Blake2b512.hash(&message)
//!   if digest[0] != 186 || digest[63] != 35 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Cryptography

import silk.num.u8
import silk.num.u64
import silk.num.usize

/// An incremental unkeyed BLAKE2b state with a 64-byte digest (RFC 7693).
///
/// # When to use
///
/// Use it where a format names BLAKE2b with a 64-byte digest, such as prehashed minisign
/// signatures. Use `silk.crypto.sha2` where a protocol names SHA-2. Use `silk.collections.hash` only for collection
/// keys. It is not a cryptographic hash.
///
/// # Details
///
/// Give input in parts with [`Blake2b512.update`] and get the digest with [`Blake2b512.finish`],
/// or hash one slice with [`Blake2b512.hash`]. The state uses only inline storage and allocates no
/// memory. The digest is the little-endian encoding of the final state words.
///
/// # Gotchas
///
/// Keyed hashing, salts, personalization and digest lengths other than 64 bytes are not supported.
/// If an update makes the message longer than 2^128 - 1 bytes, the program traps.
pub struct Blake2b512 {
  words: [u64; 8],
  buffer: [u8; 128],
  buffered: usize,
  countLow: u64,
  countHigh: u64,
}

impl Blake2b512 {
  /// Creates an empty BLAKE2b-512 state.
  pub fn make() -> Blake2b512 {
    let mut words = initial()

    // Parameter block word zero: digest length 64, no key, fanout 1, depth 1.
    words[0] = u64.bitXor(words[0], 0x01010040)
    return Blake2b512 {
      words: words,
      buffer: [0; 128],
      buffered: usize.ZERO,
      countLow: 0,
      countHigh: 0
    }
  }

  /// Adds `bytes` to this state in source order. An empty slice does not change the state.
  ///
  /// # Details
  /// A full block is compressed only when more input follows it, because the final block is
  /// compressed with the finalization flag. It allocates no memory.
  ///
  /// # Gotchas
  /// If an update makes the message longer than 2^128 - 1 bytes, the program traps.
  pub fn update(self: &mut Self, bytes: &[u8]) -> () {
    let mut index = usize.ZERO
    while index < bytes.length {
      if self.buffered == 128 {
        advance(&mut self.*, 128)
        compress(&mut self.*, false)
        self.buffered = usize.ZERO
      }
      self.buffer[self.buffered] = bytes[index]
      self.buffered = self.buffered + usize.ONE
      index = index + usize.ONE
    }
    return ()
  }

  /// Consumes this state and returns its 64-byte digest.
  ///
  /// # Gotchas
  ///
  /// The state is consumed, so the program cannot update or finish it again. Use
  /// [`Blake2b512.hash`] for one slice.
  pub fn finish(self: Self) -> [u8; 64] {
    let mut state = move self
    let buffered = state.buffered
    advance(&mut state, usize.toU64(buffered))
    let mut index = buffered
    while index < 128 {
      state.buffer[index] = 0
      index = index + usize.ONE
    }
    compress(&mut state, true)
    let mut digest: [u8; 64] = [0; 64]
    index = usize.ZERO
    while index < 64 {
      let shift = usize.toU64((index % 8) * 8)
      digest[index] = u64.toU8(u64.bitAnd(u64.shiftRight(state.words[index / 8], shift), 255))
      index = index + usize.ONE
    }
    return digest
  }

  /// Returns the 64-byte BLAKE2b digest of `bytes`.
  pub fn hash(bytes: &[u8]) -> [u8; 64] {
    let mut state = Blake2b512.make()
    state.update(bytes)
    return state.finish()
  }
}

// Adds `count` bytes to the 128-bit message counter, trapping past its domain.
fn advance(state: &mut Blake2b512, count: u64) -> () {
  let low = u64.wrappingAdd(state.countLow, count)
  if low < state.countLow {
    if state.countHigh == u64.MAX {
      Intrinsic.trap("Blake2b512.update: the total input is longer than 2^128 bytes")
    }
    state.countHigh = state.countHigh + 1
  }
  state.countLow = low
  return ()
}

fn compress(state: &mut Blake2b512, last: bool) -> () {
  let mut message: [u64; 16] = [0; 16]
  let mut index = usize.ZERO
  while index < 16 {
    let mut word: u64 = 0
    let mut byte = usize.ZERO
    while byte < 8 {
      let value = u8.toU64(state.buffer[index * 8 + byte])
      word = u64.bitOr(word, u64.shiftLeft(value, usize.toU64(byte * 8)))
      byte = byte + usize.ONE
    }
    message[index] = word
    index = index + usize.ONE
  }
  let start = initial()
  let mut v: [u64; 16] = [0; 16]
  index = usize.ZERO
  while index < 8 {
    v[index] = state.words[index]
    v[index + 8] = start[index]
    index = index + usize.ONE
  }
  v[12] = u64.bitXor(v[12], state.countLow)
  v[13] = u64.bitXor(v[13], state.countHigh)
  if last {
    v[14] = u64.bitNot(v[14])
  }
  let schedule = sigma()
  let mut round = usize.ZERO
  while round < 12 {
    let base = (round % 10) * 16
    mix(
      &mut v,
      0,
      4,
      8,
      12,
      message[u8.toUsize(schedule[base])],
      message[u8.toUsize(schedule[base + 1])]
    )
    mix(
      &mut v,
      1,
      5,
      9,
      13,
      message[u8.toUsize(schedule[base + 2])],
      message[u8.toUsize(schedule[base + 3])]
    )
    mix(
      &mut v,
      2,
      6,
      10,
      14,
      message[u8.toUsize(schedule[base + 4])],
      message[u8.toUsize(schedule[base + 5])]
    )
    mix(
      &mut v,
      3,
      7,
      11,
      15,
      message[u8.toUsize(schedule[base + 6])],
      message[u8.toUsize(schedule[base + 7])]
    )
    mix(
      &mut v,
      0,
      5,
      10,
      15,
      message[u8.toUsize(schedule[base + 8])],
      message[u8.toUsize(schedule[base + 9])]
    )
    mix(
      &mut v,
      1,
      6,
      11,
      12,
      message[u8.toUsize(schedule[base + 10])],
      message[u8.toUsize(schedule[base + 11])]
    )
    mix(
      &mut v,
      2,
      7,
      8,
      13,
      message[u8.toUsize(schedule[base + 12])],
      message[u8.toUsize(schedule[base + 13])]
    )
    mix(
      &mut v,
      3,
      4,
      9,
      14,
      message[u8.toUsize(schedule[base + 14])],
      message[u8.toUsize(schedule[base + 15])]
    )
    round = round + usize.ONE
  }
  index = usize.ZERO
  while index < 8 {
    state.words[index] = u64.bitXor(state.words[index], u64.bitXor(v[index], v[index + 8]))
    index = index + usize.ONE
  }
  return ()
}

// The G function of RFC 7693 section 3.1.
fn mix(v: &mut [u64; 16], a: usize, b: usize, c: usize, d: usize, x: u64, y: u64) -> () {
  v[a] = u64.wrappingAdd(u64.wrappingAdd(v[a], v[b]), x)
  v[d] = u64.rotateRight(u64.bitXor(v[d], v[a]), 32)
  v[c] = u64.wrappingAdd(v[c], v[d])
  v[b] = u64.rotateRight(u64.bitXor(v[b], v[c]), 24)
  v[a] = u64.wrappingAdd(u64.wrappingAdd(v[a], v[b]), y)
  v[d] = u64.rotateRight(u64.bitXor(v[d], v[a]), 16)
  v[c] = u64.wrappingAdd(v[c], v[d])
  v[b] = u64.rotateRight(u64.bitXor(v[b], v[c]), 63)
  return ()
}

// The initialization vector, shared with SHA-512.
fn initial() -> [u64; 8] {
  return [
    0x6A09E667F3BCC908,
    0xBB67AE8584CAA73B,
    0x3C6EF372FE94F82B,
    0xA54FF53A5F1D36F1,
    0x510E527FADE682D1,
    0x9B05688C2B3E6C1F,
    0x1F83D9ABFB41BD6B,
    0x5BE0CD19137E2179,
  ]
}

// The ten message schedule permutations of RFC 7693 section 2.7, one row of 16 after another.
fn sigma() -> [u8; 160] {
