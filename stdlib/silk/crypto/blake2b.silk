// The initialization vector, shared with SHA-512.
fn initial() -> [u64; 8] {
  return [
    0x6A09E667F3BCC908,
    0xBB67AE8584CAA73B,
    0x3C6EF372FE94F82B,
    0xA54FF53A5F1D36F1,
    0x510E527FADE682D1,
    0x9B05688C2B3E6C1F,
    0x1F83D9ABFB41BD6B,
    0x5BE0CD19137E2179,
  ]
}

impl Digest for Blake2b512 {
  /// Returns a BLAKE2b-512 state for an empty message.
  make: Blake2b512.make
  /// Adds `bytes` to the end of the message.
  update: Blake2b512.update
  /// Returns 128, the BLAKE2b-512 block length in bytes.
  fn blockLength(self: &Self) -> usize {
    return 128
  }
  /// Returns 64, the BLAKE2b-512 digest length in bytes.
  fn digestLength(self: &Self) -> usize {
    return 64
  }
  /// Returns the content bytes of the BLAKE2b-512 object identifier, 1.3.6.1.4.1.1722.12.2.1.16.
  fn objectIdentifier(self: &Self) -> &[u8] {
    return b"\x2b\x06\x01\x04\x01\x8d\x3a\x0c\x02\x01\x10"
  }
  /// Returns an independent copy of the state.
  fn copy(self: &Self) -> Self {
    return Blake2b512 {words: self.words, buffer: self.buffer, buffered: self.buffered, countLow: self.countLow, countHigh: self.countHigh}
  }
  /// Writes the 64-byte BLAKE2b-512 digest to the start of `output` and consumes the state.
  fn finishInto(self: Self, output: &mut [u8]) -> () {
    let digest = Blake2b512.finish(move self)
    writeDigest(&digest, move output)
  }
}

// Writes `digest` to the start of `output` for `Digest.finishInto`.
fn writeDigest(digest: &[u8], output: &mut [u8]) -> () {
  let mut index: usize = 0
  while index < digest.length {
    output[index] = digest[index]
    index = index + 1
  }
}
