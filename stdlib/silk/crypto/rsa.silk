//! RSA keys, signatures, and encryption: PKCS #1 v1.5 and PSS signatures, OAEP and PKCS #1 v1.5
//! encryption, and key generation (RFC 8017).
//!
//! # When to use
//! Use [`RsaPrivateKey`] to sign, to decrypt, or to generate a key, and [`RsaPublicKey`] to
//! verify and to encrypt, for example for `crypto.sign` and `crypto.publicEncrypt` in Node.js or
//! for a JSON Web Token with `RS256` or `PS256`. Use [`RsaPublicKey.verifyCertificate`] for the
//! signature of an X.509 certificate.
//!
//! # Details
//! A key has a modulus of 512 to 8192 bits and an odd public exponent of 3 or more, such as
//! 65537. Make a key from its big-endian parts with [`RsaPublicKey.fromComponents`] or
//! [`RsaPrivateKey.fromComponents`], or generate one with [`RsaPrivateKey.generate`].
//!
//! The signature functions take the digest of the message, not the message, and the hash as a
//! type argument that implements `silk.crypto.digest.Digest`, such as `Sha256`. PSS and OAEP use
//! MGF1 with the same hash. A signature or a ciphertext has the length in bytes of the modulus.
//!
//! The private operations use the Chinese remainder theorem and the constant-time arithmetic of
//! `silk.crypto.modular`, and check each result with the public key, so a fault does not leak
//! the key. OAEP decryption checks the padding without a branch on secret data.
//!
//! # Errors
//! - [`RsaError`] for a key, a parameter, a length, a signature, or a ciphertext that is not valid.
//!
//! # Gotchas
//! A valid signature proves only that the holder of the private key signed the message. It does
//! not prove that you can trust the key. To check a certificate chain, use the `silk.tls.trust_*`
//! modules. PKCS #1 v1.5 encryption is here only for old formats. Its decryption uses implicit
//! rejection, so a bad ciphertext gives a wrong message instead of an error. Use OAEP for new
//! formats.
//!
//! # Examples
//! ## Sign and verify with a generated key
//! ```silk
//! import silk.core.effect { Effect }
//! import silk.core.option { Option }
//! import silk.core.result { Result }
//! import silk.crypto.rsa { RsaError, RsaPrivateKey }
//! import silk.crypto.sha2 { Sha256 }
//! import silk.num.u64
//! import silk.system.random { Random }
//!
//! // A test provider. Never use it for keys.
//! struct Counter {
//!   state: u64,
//! }
//!
//! impl Random for Counter {
//!   effect fn fillBytes(self: &mut Self, output: &mut [u8]) -> () {
//!     let mut index: usize = 0
//!     while index < output.length {
//!       self.state = u64.wrappingAdd(u64.wrappingMultiply(self.state, 6364136223846793005), 1)
//!       output[index] = u64.toU8(u64.shiftRight(self.state, 56))
//!       index = index + 1
//!     }
//!   }
//! }
//!
//! effect fn signAndVerify() -> i32 ! RsaError ? &mut Random {
//!   let key = run RsaPrivateKey.generate(1024, 65537)
//!   let digest = Sha256.hash(b"hello")
//!   let mut signature: [u8; 128] = [0; 128]
//!   run key.signPss<Sha256>(&digest, 32, &mut signature)
//!   let publicKey = key.publicKey()
//!   return match publicKey.verifyPss<Sha256>(&digest, &signature, Option<usize>.some(32)) {
//!     Result<(), RsaError>.Success { value: _ } => 0
//!     Result<(), RsaError>.Failure { error: _ } => 1
//!   }
//! }
//!
//! pub effect fn main() -> i32 ! RsaError {
//!   let mut random = Counter { state: 1 }
//!   return run signAndVerify() |> Effect.provideMut<Random>(&mut random)
//! }
//! ```
//!
//! @category Cryptography

import silk.text.format { Debug, Format, Formatter }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.crypto.digest { Digest }
import silk.crypto.hmac { HmacSha256 }
import silk.crypto.modular { ModularError, Modulus, Natural }
import silk.crypto.sha2 { Sha256 }
import silk.collections.slice { Slice }
import silk.system.random { Random }
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silk.io.writer { Writer, WriterError }

/// The reason that an RSA key, parameter, signature, or ciphertext was rejected.
pub enum RsaError {
  /// A key part is not valid: the modulus is even or not 512 to 8192 bits, the exponent is even,
  /// below 3, or not below the modulus, or the private parts do not match the public key.
  InvalidKey,
  /// A DER value is not valid, not minimal, or has bytes after it.
  InvalidEncoding,
  /// An algorithm identifier, a key size, or an exponent is not supported.
  InvalidParameters,
  /// An input or output does not have the required length, such as a signature that is not as
  /// long as the modulus, or a digest that is not as long as the hash output.
  InvalidLength,
  /// The message is too long to encrypt with this key.
  MessageTooLong,
  /// The key is too short for the hash, the salt, or the padding.
  KeyTooSmall,
  /// The signature does not match the digest and the key.
  InvalidSignature,
  /// The ciphertext is not valid for this key and padding.
  InvalidCiphertext,
}

impl Debug for RsaError {
  /// Writes the name of the variant, such as `InvalidKey`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return match &self.* {
      RsaError.InvalidKey => run Format.write(&mut formatter, b"InvalidKey")
      RsaError.InvalidEncoding => run Format.write(&mut formatter, b"InvalidEncoding")
      RsaError.InvalidParameters => run Format.write(&mut formatter, b"InvalidParameters")
      RsaError.InvalidLength => run Format.write(&mut formatter, b"InvalidLength")
      RsaError.MessageTooLong => run Format.write(&mut formatter, b"MessageTooLong")
      RsaError.KeyTooSmall => run Format.write(&mut formatter, b"KeyTooSmall")
      RsaError.InvalidSignature => run Format.write(&mut formatter, b"InvalidSignature")
      RsaError.InvalidCiphertext => run Format.write(&mut formatter, b"InvalidCiphertext")
    }
  }
}

/// An RSA public key: a modulus of 512 to 8192 bits and an odd public exponent.
///
/// # When to use
/// Use it to verify PKCS #1 v1.5 and PSS signatures and to encrypt with OAEP or PKCS #1 v1.5.
///
/// # Details
/// Make one from its parts with [`RsaPublicKey.fromComponents`], from a certificate with
/// [`RsaPublicKey.fromCertificateKey`], or from a private key with [`RsaPrivateKey.publicKey`].
///
/// # Gotchas
/// A valid signature proves only that the holder of the private key signed the message. It does
/// not prove that you can trust the key. It is a fixed-size value of about 3 KiB.
pub struct RsaPublicKey {
  n: Modulus,
  e: Natural,
  width: usize,
}

/// An RSA private key with its two primes and the values that speed up its operations.
///
/// # When to use
/// Use it to sign with PKCS #1 v1.5 or PSS and to decrypt OAEP or PKCS #1 v1.5. Get its public
/// half with [`RsaPrivateKey.publicKey`].
///
/// # Details
/// Make one from its parts with [`RsaPrivateKey.fromComponents`], or generate one with
/// [`RsaPrivateKey.generate`]. It holds two primes, so multi-prime keys are not supported.
///
/// # Gotchas
/// It does not erase its memory when dropped. It is a fixed-size value of about 11 KiB.
pub struct RsaPrivateKey {
  public: RsaPublicKey,
  d: Natural,
  p: Modulus,
  q: Modulus,
  dp: Natural,
  dq: Natural,
  qInverse: Natural,
}

// The largest modulus is 8192 bits, so every encoded block fits in 1024 bytes.
const BLOCK: usize = 1024

fn natural(bytes: &[u8]) -> Natural {
  return match Natural.fromBytes(bytes) {
    Result<Natural, ModularError>.Success { value } => value
    Result<Natural, ModularError>.Failure { .. } => Intrinsic.trap("RSA input above 8192 bits")
  }
}

fn resized(value: &Natural, length: usize) -> Natural {
  return match value.resize(length) {
    Result<Natural, ModularError>.Success { value: fitted } => fitted
    Result<Natural, ModularError>.Failure { .. } => Intrinsic.trap("RSA value does not fit")
  }
}

fn product(left: &Natural, right: &Natural) -> Natural {
  return match left.multiply(right) {
    Result<Natural, ModularError>.Success { value } => value
    Result<Natural, ModularError>.Failure { .. } => Intrinsic.trap("RSA product above 8192 bits")
  }
}

fn sum(left: &Natural, right: &Natural) -> Natural {
  return match left.add(right) {
    Result<Natural, ModularError>.Success { value } => value
    Result<Natural, ModularError>.Failure { .. } => Intrinsic.trap("RSA sum above 8192 bits")
  }
}

fn difference(left: &Natural, right: &Natural) -> Natural {
  return match left.subtract(right) {
    Result<Natural, ModularError>.Success { value } => value
    Result<Natural, ModularError>.Failure { .. } => Intrinsic.trap("RSA difference below zero")
  }
}

fn writeFixed(value: &Natural, output: &mut [u8]) -> () {
  match value.writeBytes(move output) {
    Result<(), ModularError>.Success { .. } => {}
    Result<(), ModularError>.Failure { .. } => {
      Intrinsic.trap("RSA value wider than the modulus")
    }
  }
}

// Skips leading zero bytes. Only for public values: the time depends on the count.
fn significantStart(bytes: &[u8]) -> usize {
  let mut start: usize = 0
  while start < bytes.length && bytes[start] == 0 {
    start = start + 1
  }
  return start
}

fn byteMask(condition: u32) -> u8 {
  return u32.toU8(u32.bitAnd(u32.wrappingSubtract(0, condition), 255))
}

// 1 when the byte is zero, else 0.
fn zeroByte(value: u8) -> u32 {
  return u32.shiftRight(u32.wrappingSubtract(u8.toU32(value), 1), 31)
}

fn equalByte(left: u8, right: u8) -> u32 {
  return zeroByte(u8.bitXor(left, right))
}

fn digestLength<H: Digest>() -> usize {
  let state: H = Digest.make()
  return state.digestLength()
}

fn hashInto<H: Digest>(bytes: &[u8], output: &mut [u8]) -> () {
  let mut state: H = Digest.make()
  state.update(bytes)
  state.finishInto(move output)
}

// XORs MGF1(seed) with the hash H into all of `output`.
fn maskWith<H: Digest>(seed: &[u8], output: &mut [u8]) -> () {
  let mut counter: u32 = 0
  let mut offset: usize = 0
  while offset < output.length {
    let mut state: H = Digest.make()
    state.update(seed)
    let block: [u8; 4] = [
      u32.toU8(u32.shiftRight(counter, 24)),
      u32.toU8(u32.bitAnd(u32.shiftRight(counter, 16), 255)),
      u32.toU8(u32.bitAnd(u32.shiftRight(counter, 8), 255)),
      u32.toU8(u32.bitAnd(counter, 255)),
    ]
    state.update(&block)
    let length = state.digestLength()
    let mut mask: [u8; 64] = [0; 64]
    state.finishInto(&mut mask)
    let mut i: usize = 0
    while i < length && offset + i < output.length {
      output[offset + i] = u8.bitXor(output[offset + i], mask[i])
      i = i + 1
    }
    offset = offset + length
    counter = counter + 1
  }
}

fn publicKeyFrom(modulusBytes: &[u8], exponentBytes: &[u8]) -> Result<RsaPublicKey, RsaError> {
  let modulusStart = significantStart(modulusBytes)
  let exponentStart = significantStart(exponentBytes)
  let width = modulusBytes.length - modulusStart
  if width < 64 || width > BLOCK || exponentBytes.length - exponentStart > BLOCK {
    return Result<RsaPublicKey, RsaError>.failResult(RsaError.InvalidKey)
  }
  let modulusValue = natural(
    Slice.view<u8>(modulusBytes, modulusStart, modulusBytes.length - modulusStart),
  )
  let exponent = natural(
    Slice.view<u8>(exponentBytes, exponentStart, exponentBytes.length - exponentStart),
  )
  let bits = modulusValue.bitLength()
  if bits < 512 || exponent.bit(0) == 0 || exponent.bitLength() < 2
    || !exponent.lessThan(&modulusValue) {
    return Result<RsaPublicKey, RsaError>.failResult(RsaError.InvalidKey)
  }
  let modulus = match Modulus.make(&modulusValue) {
    Result<Modulus, ModularError>.Success { value } => move value
    Result<Modulus, ModularError>.Failure { .. } => {
      return Result<RsaPublicKey, RsaError>.failResult(RsaError.InvalidKey)
    }
  }
  return Result<RsaPublicKey, RsaError>.succeed(
    RsaPublicKey { n: move modulus, e: exponent, width: width },
  )
}

// Returns the input as a number if it is as long as the modulus and below it.
fn representative(key: &RsaPublicKey, input: &[u8]) -> Option<Natural> {
  if input.length != key.width {
    return Option<Natural>.none()
  }
  let value = natural(input)
  let modulusValue = key.n.natural()
  if !value.lessThan(&modulusValue) {
    return Option<Natural>.none()
  }
  return Option<Natural>.some(value)
}

fn publicOperation(key: &RsaPublicKey, value: &Natural) -> Natural {
  return key.n.powerPublic(value, &key.e)
}

// Computes value^d modulo n with the primes, then checks the result with the public exponent.
fn privateOperation(key: &RsaPrivateKey, value: &Natural) -> Result<Natural, RsaError> {
  let first = &key.p
  let second = &key.q
  let firstPart = first.power(&first.reduce(value), &key.dp)
  let secondPart = second.power(&second.reduce(value), &key.dq)
  let delta = first.subtract(&firstPart, &first.reduce(&secondPart))
  let lift = first.multiply(&key.qInverse, &delta)
  let secondValue = second.natural()
  let combined = sum(&secondPart, &product(&lift, &secondValue))
  let result = key.public.n.reduce(&combined)
  let check = publicOperation(&key.public, &result)
  if !check.equals(value) || !combined.equals(&result) {
    return Result<Natural, RsaError>.failResult(RsaError.InvalidKey)
  }
  return Result<Natural, RsaError>.succeed(result)
}

fn digestInfoLength(oidLength: usize, hashLength: usize) -> usize {
  return 2 + 2 + 2 + oidLength + 2 + 2 + hashLength
}

// Writes EMSA-PKCS1-v1_5 of the digest to all of `encoded`.
fn pkcs1Encode<H: Digest>(digest: &[u8], encoded: &mut [u8]) -> Result<(), RsaError> {
  let state: H = Digest.make()
  let hashLength = state.digestLength()
  let oid = state.objectIdentifier()
  if digest.length != hashLength {
    return Result<(), RsaError>.failResult(RsaError.InvalidLength)
  }
  let infoLength = digestInfoLength(oid.length, hashLength)
  if encoded.length < infoLength + 11 {
    return Result<(), RsaError>.failResult(RsaError.KeyTooSmall)
  }
  let start = encoded.length - infoLength
  encoded[0] = 0
  encoded[1] = 1
  let mut i: usize = 2
  while i < start - 1 {
    encoded[i] = 255
    i = i + 1
  }
  encoded[start - 1] = 0
  encoded[start] = 48
  encoded[start + 1] = usize.toU8(infoLength - 2)
  encoded[start + 2] = 48
  encoded[start + 3] = usize.toU8(oid.length + 4)
  encoded[start + 4] = 6
  encoded[start + 5] = usize.toU8(oid.length)
  i = 0
  while i < oid.length {
    encoded[start + 6 + i] = oid[i]
    i = i + 1
  }
  let tail = start + 6 + oid.length
  encoded[tail] = 5
  encoded[tail + 1] = 0
  encoded[tail + 2] = 4
  encoded[tail + 3] = usize.toU8(hashLength)
  i = 0
  while i < hashLength {
    encoded[tail + 4 + i] = digest[i]
    i = i + 1
  }
  return Result<(), RsaError>.succeed(())
}

// Writes EMSA-PSS of the digest and salt to all of `encoded`, which holds `bits` - 1 bits.
fn pssEncode<H: Digest>(digest: &[u8], salt: &[u8], bits: usize, encoded: &mut [u8]) -> () {
  let hashLength = digestLength<H>()
  let dbLength = encoded.length - hashLength - 1
  let zeros: [u8; 8] = [0; 8]
  let mut state: H = Digest.make()
  state.update(&zeros)
  state.update(digest)
  state.update(salt)
  let mut hashed: [u8; 64] = [0; 64]
  state.finishInto(&mut hashed)
  let mut i: usize = 0
  while i < dbLength {
    encoded[i] = 0
    i = i + 1
  }
  encoded[dbLength - salt.length - 1] = 1
  i = 0
  while i < salt.length {
    encoded[dbLength - salt.length + i] = salt[i]
    i = i + 1
  }
  let seed = Slice.view<u8>(&hashed, 0, hashLength)
  maskWith<H>(seed, Slice.viewMut<u8>(&mut encoded, 0, dbLength))
  let unused = 8 * encoded.length - (bits - 1)
  encoded[0] = u8.bitAnd(encoded[0], u32.toU8(u32.shiftRight(255, usize.toU32(unused))))
  i = 0
  while i < hashLength {
    encoded[dbLength + i] = hashed[i]
    i = i + 1
  }
  encoded[encoded.length - 1] = 188
}

// Checks EMSA-PSS: `encoded` holds the `bits` - 1 low bits of the recovered representative.
fn pssVerify<H: Digest>(
  digest: &[u8],
  encoded: &mut [u8],
  bits: usize,
  saltLength: Option<usize>,
) -> bool {
  let hashLength = digestLength<H>()
  if encoded.length < hashLength + 2 || encoded[encoded.length - 1] != 188 {
    return false
  }
  let dbLength = encoded.length - hashLength - 1
  let unused = 8 * encoded.length - (bits - 1)
  let topMask = u32.toU8(u32.shiftRight(255, usize.toU32(unused)))
  if u8.bitAnd(encoded[0], u8.bitNot(topMask)) != 0 {
    return false
  }
  let mut hashed: [u8; 64] = [0; 64]
  let mut i: usize = 0
  while i < hashLength {
    hashed[i] = encoded[dbLength + i]
    i = i + 1
  }
  maskWith<H>(Slice.view<u8>(&hashed, 0, hashLength), Slice.viewMut<u8>(&mut encoded, 0, dbLength))
  encoded[0] = u8.bitAnd(encoded[0], topMask)
  let mut start: usize = 0
  while start < dbLength && encoded[start] == 0 {
    start = start + 1
  }
  if start == dbLength || encoded[start] != 1 {
    return false
  }
  let found = dbLength - start - 1
  if let Option<usize>.Some { value: expected } = saltLength {
    if expected != found {
      return false
    }
  }
  let zeros: [u8; 8] = [0; 8]
  let mut state: H = Digest.make()
  state.update(&zeros)
  state.update(digest)
  state.update(Slice.view<u8>(&encoded, start + 1, found))
  let mut expectedHash: [u8; 64] = [0; 64]
  state.finishInto(&mut expectedHash)
  i = 0
  while i < hashLength {
    if expectedHash[i] != hashed[i] {
      return false
    }
    i = i + 1
  }
  return true
}

// Recovers the representative of a signature into the last `width` bytes of `block`.
fn recoverSignature(key: &RsaPublicKey, signature: &[u8], block: &mut [u8; 1024]) -> Result<
  (),
  RsaError,
> {
  if signature.length != key.width {
    return Result<(), RsaError>.failResult(RsaError.InvalidLength)
  }
  let value = match representative(key, signature) {
    Option<Natural>.Some { value } => value
    Option<Natural>.None => {
      return Result<(), RsaError>.failResult(RsaError.InvalidSignature)
    }
  }
  let recovered = publicOperation(key, &value)
  writeFixed(&recovered, Slice.viewMut<u8>(&mut block, 0, key.width))
  return Result<(), RsaError>.succeed(())
}

fn verifyPkcs1Digest<H: Digest>(key: &RsaPublicKey, digest: &[u8], signature: &[u8]) -> Result<
  (),
  RsaError,
> {
  let mut expected: [u8; 1024] = [0; 1024]
  let encoded = pkcs1Encode<H>(digest, Slice.viewMut<u8>(&mut expected, 0, key.width))
  if let Result<(), RsaError>.Failure { error } = move encoded {
    return Result<(), RsaError>.failResult(error)
  }
  let mut block: [u8; 1024] = [0; 1024]
  let recovered = recoverSignature(key, signature, &mut block)
  if let Result<(), RsaError>.Failure { error } = move recovered {
    return Result<(), RsaError>.failResult(error)
  }
  let mut difference: u8 = 0
  let mut i: usize = 0
  while i < key.width {
    difference = u8.bitOr(difference, u8.bitXor(block[i], expected[i]))
    i = i + 1
  }
  if difference != 0 {
    return Result<(), RsaError>.failResult(RsaError.InvalidSignature)
  }
  return Result<(), RsaError>.succeed(())
}

fn verifyPssDigest<H: Digest>(
  key: &RsaPublicKey,
  digest: &[u8],
  signature: &[u8],
  saltLength: Option<usize>,
) -> Result<(), RsaError> {
  if digest.length != digestLength<H>() {
    return Result<(), RsaError>.failResult(RsaError.InvalidLength)
  }
  let mut block: [u8; 1024] = [0; 1024]
  let recovered = recoverSignature(key, signature, &mut block)
  if let Result<(), RsaError>.Failure { error } = move recovered {
    return Result<(), RsaError>.failResult(error)
  }
  let bits = key.n.bitLength()
  let encodedLength = (bits + 6) / 8
  let offset = key.width - encodedLength
  if offset == 1 && block[0] != 0 {
    return Result<(), RsaError>.failResult(RsaError.InvalidSignature)
  }
  let encoded = Slice.viewMut<u8>(&mut block, offset, encodedLength)
  if !pssVerify<H>(digest, move encoded, bits, saltLength) {
    return Result<(), RsaError>.failResult(RsaError.InvalidSignature)
  }
  return Result<(), RsaError>.succeed(())
}

fn encryptBlock(key: &RsaPublicKey, block: &[u8; 1024], output: &mut [u8]) -> () {
  let value = natural(Slice.view<u8>(block, 0, key.width))
  writeFixed(&publicOperation(key, &value), move output)
}

impl RsaPublicKey {
  /// Returns the key for the big-endian `modulus` and `exponent` bytes. Leading zero bytes are
  /// allowed.
  ///
  /// The modulus must be odd and have 512 to 8192 significant bits. The exponent must be odd, 3
  /// or more, and less than the modulus.
  ///
  /// # Errors
  /// - `InvalidKey` if a value is not in this range.
  pub fn fromComponents(modulus: &[u8], exponent: &[u8]) -> Result<RsaPublicKey, RsaError> {
    return publicKeyFrom(modulus, exponent)
  }

  /// Returns the number of significant bits of the modulus, such as 2048.
  pub fn bitLength(self: &RsaPublicKey) -> usize {
    return self.n.bitLength()
  }

  /// Returns the length in bytes of the modulus, which is the length of every signature and
  /// ciphertext of the key.
  pub fn byteLength(self: &RsaPublicKey) -> usize {
    return self.width
  }

  /// Returns the modulus as a number.
  pub fn modulus(self: &RsaPublicKey) -> Natural {
    return self.n.natural()
  }

  /// Returns the public exponent as a number.
  pub fn exponent(self: &RsaPublicKey) -> Natural {
    return self.e
  }

  /// Checks that `signature` is a valid RSASSA-PKCS1-v1_5 signature of the message with the
  /// digest `digest`, made with the hash `H`.
  ///
  /// # Errors
  /// - `InvalidLength` if `digest` is not as long as the output of `H`, or `signature` is not as
  ///   long as the modulus.
  /// - `KeyTooSmall` if the key cannot hold the digest of `H`.
  /// - `InvalidSignature` if the signature does not match.
  pub fn verifyPkcs1<H: Digest>(self: &RsaPublicKey, digest: &[u8], signature: &[u8]) -> Result<
    (),
    RsaError,
  > {
    return verifyPkcs1Digest<H>(self, digest, signature)
  }

  /// Checks that `signature` is a valid RSASSA-PSS signature of the message with the digest
  /// `digest`, made with the hash `H` and MGF1 with `H`.
  ///
  /// With `Some`, `saltLength` is the salt length that the signature must have. With `None`, the
  /// salt can have any length, as with `RSA_PSS_SALTLEN_AUTO` in Node.js.
  ///
  /// # Errors
  /// - `InvalidLength` if `digest` is not as long as the output of `H`, or `signature` is not as
  ///   long as the modulus.
  /// - `InvalidSignature` if the signature does not match.
  pub fn verifyPss<H: Digest>(
    self: &RsaPublicKey,
    digest: &[u8],
    signature: &[u8],
    saltLength: Option<usize>,
  ) -> Result<(), RsaError> {
    return verifyPssDigest<H>(self, digest, signature, saltLength)
  }

  /// Returns the longest PSS salt that fits with the hash `H`: the modulus length less the
  /// digest length less 2, or 0 if the key is too short for `H`.
  pub fn maximumPssSaltLength<H: Digest>(self: &RsaPublicKey) -> usize {
    let encodedLength = (self.n.bitLength() + 6) / 8
    let needed = digestLength<H>() + 2
    if encodedLength < needed {
      return 0
    }
    return encodedLength - needed
  }

  /// Encrypts `message` with RSAES-OAEP, the hash `H`, MGF1 with `H`, and `label`, and writes the
  /// ciphertext to `output`. It reads the seed from the ambient `Random`.
  ///
  /// The message can have up to the modulus length less twice the digest length less 2 bytes.
  ///
  /// # Errors
  /// - `InvalidLength` if `output` is not as long as the modulus.
  /// - `KeyTooSmall` if the key is too short for `H`.
  /// - `MessageTooLong` if `message` is too long.
  pub effect fn encryptOaep<H: Digest>(
    self: &RsaPublicKey,
    label: &[u8],
    message: &[u8],
    output: &mut [u8],
  ) -> ()
    ! RsaError
    ? &mut Random {
    let width = self.width
    let hashLength = digestLength<H>()
    if output.length != width {
      fail RsaError.InvalidLength
    }
    if width < 2 * hashLength + 2 {
      fail RsaError.KeyTooSmall
    }
    if message.length > width - 2 * hashLength - 2 {
      fail RsaError.MessageTooLong
    }
    let mut block: [u8; 1024] = [0; 1024]
    let dbLength = width - hashLength - 1
    hashInto<H>(label, Slice.viewMut<u8>(&mut block, 1 + hashLength, hashLength))
    block[width - message.length - 1] = 1
    let mut i: usize = 0
    while i < message.length {
      block[width - message.length + i] = message[i]
      i = i + 1
    }
    run Random.fillBytes(Slice.viewMut<u8>(&mut block, 1, hashLength))
    let mut seed: [u8; 64] = [0; 64]
    i = 0
    while i < hashLength {
      seed[i] = block[1 + i]
      i = i + 1
    }
    maskWith<H>(
      Slice.view<u8>(&seed, 0, hashLength),
      Slice.viewMut<u8>(&mut block, 1 + hashLength, dbLength),
    )
    let mut maskedDb: [u8; 1024] = [0; 1024]
    i = 0
    while i < dbLength {
      maskedDb[i] = block[1 + hashLength + i]
      i = i + 1
    }
    maskWith<H>(
      Slice.view<u8>(&maskedDb, 0, dbLength),
      Slice.viewMut<u8>(&mut block, 1, hashLength),
    )
    encryptBlock(self, &block, move output)
  }

  /// Encrypts `message` with RSAES-PKCS1-v1_5 and writes the ciphertext to `output`. It reads the
  /// padding from the ambient `Random`.
  ///
  /// The message can have up to the modulus length less 11 bytes.
  ///
  /// # Errors
  /// - `InvalidLength` if `output` is not as long as the modulus.
  /// - `MessageTooLong` if `message` is too long.
  ///
  /// # Gotchas
  /// Use it only for formats that require it. Prefer [`RsaPublicKey.encryptOaep`]: PKCS #1 v1.5
  /// padding has a long history of padding-oracle attacks.
  pub effect fn encryptPkcs1(self: &RsaPublicKey, message: &[u8], output: &mut [u8]) -> ()
    ! RsaError
    ? &mut Random {
    let width = self.width
    if output.length != width {
      fail RsaError.InvalidLength
    }
    if message.length > width - 11 {
      fail RsaError.MessageTooLong
    }
    let mut block: [u8; 1024] = [0; 1024]
    block[1] = 2
    let paddingEnd = width - message.length - 1
    run Random.fillBytes(Slice.viewMut<u8>(&mut block, 2, paddingEnd - 2))
    let mut i: usize = 2
    while i < paddingEnd {
      // Draws again for each zero byte, so the padding is uniform over the nonzero bytes.
      while block[i] == 0 {
        run Random.fillBytes(Slice.viewMut<u8>(&mut block, i, 1))
      }
      i = i + 1
    }
    i = 0
    while i < message.length {
      block[width - message.length + i] = message[i]
      i = i + 1
    }
    encryptBlock(self, &block, move output)
  }

  /// Computes `input`^e modulo n without padding (RSAEP, `RSA_NO_PADDING` in Node.js) and writes
  /// it to `output`.
  ///
  /// # Errors
  /// - `InvalidLength` if `input` or `output` is not as long as the modulus.
  /// - `InvalidCiphertext` if `input` is not less than the modulus.
  ///
  /// # Gotchas
  /// Raw RSA is not secure on its own. Use it only to build a padding scheme.
  pub fn encryptRaw(self: &RsaPublicKey, input: &[u8], output: &mut [u8]) -> Result<(), RsaError> {
    if input.length != self.width || output.length != self.width {
      return Result<(), RsaError>.failResult(RsaError.InvalidLength)
    }
    let value = match representative(self, input) {
      Option<Natural>.Some { value } => value
      Option<Natural>.None => {
        return Result<(), RsaError>.failResult(RsaError.InvalidCiphertext)
      }
    }
    writeFixed(&publicOperation(self, &value), move output)
    return Result<(), RsaError>.succeed(())
  }
}

impl RsaPrivateKey {
  /// Returns the private key for its big-endian parts, as in a PKCS #1 `RSAPrivateKey`: the
  /// modulus n, the public exponent e, the private exponent d, the primes p and q, d mod (p - 1),
  /// d mod (q - 1), and the inverse of q modulo p.
  ///
  /// It checks that n is p * q and that the coefficient is the inverse of q. A wrong exponent is
  /// found by the check of each result, which then fails with `InvalidKey`.
  ///
  /// # Errors
  /// - `InvalidKey` if the public key is not valid, a prime is even or below 3, n is not p * q,
  ///   or the coefficient is not the inverse of q modulo p.
  pub fn fromComponents(
    modulus: &[u8],
    publicExponent: &[u8],
    privateExponent: &[u8],
    firstPrime: &[u8],
    secondPrime: &[u8],
    firstExponent: &[u8],
    secondExponent: &[u8],
    coefficient: &[u8],
  ) -> Result<RsaPrivateKey, RsaError> {
    let public = match publicKeyFrom(modulus, publicExponent) {
      Result<RsaPublicKey, RsaError>.Success { value } => move value
      Result<RsaPublicKey, RsaError>.Failure { error } => {
        return Result<RsaPrivateKey, RsaError>.failResult(error)
      }
    }
    if privateExponent.length > BLOCK || firstPrime.length > BLOCK || secondPrime.length > BLOCK {
      return Result<RsaPrivateKey, RsaError>.failResult(RsaError.InvalidKey)
    }
    if firstExponent.length > BLOCK || secondExponent.length > BLOCK || coefficient.length > BLOCK {
      return Result<RsaPrivateKey, RsaError>.failResult(RsaError.InvalidKey)
    }
    let firstValue = natural(firstPrime)
    let secondValue = natural(secondPrime)
    let first = match Modulus.make(&firstValue) {
      Result<Modulus, ModularError>.Success { value } => move value
      Result<Modulus, ModularError>.Failure { .. } => {
        return Result<RsaPrivateKey, RsaError>.failResult(RsaError.InvalidKey)
      }
    }
    let second = match Modulus.make(&secondValue) {
      Result<Modulus, ModularError>.Success { value } => move value
      Result<Modulus, ModularError>.Failure { .. } => {
        return Result<RsaPrivateKey, RsaError>.failResult(RsaError.InvalidKey)
      }
    }
    let modulusValue = public.n.natural()
    let primeProduct = match first.natural().multiply(&second.natural()) {
      Result<Natural, ModularError>.Success { value } => value
      Result<Natural, ModularError>.Failure { .. } => {
        return Result<RsaPrivateKey, RsaError>.failResult(RsaError.InvalidKey)
      }
    }
    if !primeProduct.equals(&modulusValue) {
      return Result<RsaPrivateKey, RsaError>.failResult(RsaError.InvalidKey)
    }
    let reducedCoefficient = first.reduce(&natural(coefficient))
    let check = first.multiply(&first.reduce(&second.natural()), &reducedCoefficient)
    if !check.equals(&Natural.fromU64(1)) {
      return Result<RsaPrivateKey, RsaError>.failResult(RsaError.InvalidKey)
    }
    return Result<RsaPrivateKey, RsaError>.succeed(
      RsaPrivateKey {
        public: move public,
        d: natural(privateExponent),
        p: move first,
        q: move second,
        dp: natural(firstExponent),
        dq: natural(secondExponent),
        qInverse: reducedCoefficient,
      },
    )
  }

  /// Returns a new key with a modulus of `bits` bits and the public exponent `exponent`, from
  /// the ambient `Random`, as `generateKeyPair('rsa')` does in Node.js.
  ///
  /// The primes have half the bits each, with the top two bits set, and pass trial division and
  /// Miller-Rabin tests with random bases (64 rounds, or 128 for primes above 2048 bits). The
  /// first prime is the larger. The private exponent is the inverse of e modulo (p - 1)(q - 1).
  ///
  /// # Errors
  /// - `InvalidParameters` if `bits` is not 512 to 8192, or `exponent` is even or below 3.
  ///
  /// # Gotchas
  /// It takes a random time, about a second for 2048 bits and much longer for 4096 bits. The
  /// `Random` provider must be cryptographically secure.
  pub effect fn generate(bits: usize, exponent: u32) -> RsaPrivateKey
    ! RsaError
    ? &mut Random {
    if bits < 512 || bits > 8192 || exponent < 3 || u32.bitAnd(exponent, 1) == 0 {
      fail RsaError.InvalidParameters
    }
    let firstBits = (bits + 1) / 2
    let secondBits = bits - firstBits
    let primes = smallPrimes()
    while true {
      let mut first = run generatePrime(firstBits, exponent, &primes)
      let mut second = run generatePrime(secondBits, exponent, &primes)
      if first.lessThan(&second) {
        let swapped = first
        first = second
        second = swapped
      }

      // FIPS 186-5 A.1.3: the primes must differ above their low 100 bits.
      let gap = difference(&first, &second)
      if gap.bitLength() <= secondBits - 100 {
        continue
      }
      return keyFromPrimes(&first, &second, exponent)
    }
    Intrinsic.trap("unreachable")
  }

  /// Returns the public half of the key.
  pub fn publicKey(self: &RsaPrivateKey) -> RsaPublicKey {
    return RsaPublicKey { n: self.public.n, e: self.public.e, width: self.public.width }
  }

  /// Returns the private exponent d.
  pub fn privateExponent(self: &RsaPrivateKey) -> Natural {
    return self.d
  }

  /// Returns the first prime p.
  pub fn firstPrime(self: &RsaPrivateKey) -> Natural {
    return self.p.natural()
  }

  /// Returns the second prime q.
  pub fn secondPrime(self: &RsaPrivateKey) -> Natural {
    return self.q.natural()
  }

  /// Returns d mod (p - 1).
  pub fn firstExponent(self: &RsaPrivateKey) -> Natural {
    return self.dp
  }

  /// Returns d mod (q - 1).
  pub fn secondExponent(self: &RsaPrivateKey) -> Natural {
    return self.dq
  }

  /// Returns the inverse of q modulo p.
  pub fn coefficient(self: &RsaPrivateKey) -> Natural {
    return self.qInverse
  }

  /// Signs the message with the digest `digest` with RSASSA-PKCS1-v1_5 and the hash `H`, and
  /// writes the signature to `signature`.
  ///
  /// # Errors
  /// - `InvalidLength` if `digest` is not as long as the output of `H`, or `signature` is not as
  ///   long as the modulus.
  /// - `KeyTooSmall` if the key cannot hold the digest of `H`.
  /// - `InvalidKey` if the private parts do not match the public key.
  pub fn signPkcs1<H: Digest>(self: &RsaPrivateKey, digest: &[u8], signature: &mut [u8]) -> Result<
    (),
    RsaError,
  > {
    let width = self.public.width
    if signature.length != width {
      return Result<(), RsaError>.failResult(RsaError.InvalidLength)
    }
    let mut block: [u8; 1024] = [0; 1024]
    let encoded = pkcs1Encode<H>(digest, Slice.viewMut<u8>(&mut block, 0, width))
    if let Result<(), RsaError>.Failure { error } = move encoded {
      return Result<(), RsaError>.failResult(error)
    }
    return signBlock(self, &block, move signature)
  }

  /// Signs the message with the digest `digest` with RSASSA-PSS, the hash `H`, MGF1 with `H`,
  /// and a random salt of `saltLength` bytes from the ambient `Random`, and writes the signature
  /// to `signature`.
  ///
  /// A salt as long as the digest is the common choice. [`RsaPublicKey.maximumPssSaltLength`]
  /// gives the longest, which Node.js uses by default.
  ///
  /// # Errors
  /// - `InvalidLength` if `digest` is not as long as the output of `H`, or `signature` is not as
  ///   long as the modulus.
  /// - `KeyTooSmall` if the key cannot hold the digest of `H` and the salt.
  /// - `InvalidKey` if the private parts do not match the public key.
  pub effect fn signPss<H: Digest>(
    self: &RsaPrivateKey,
    digest: &[u8],
    saltLength: usize,
    signature: &mut [u8],
  ) -> ()
    ! RsaError
    ? &mut Random {
    let width = self.public.width
    let hashLength = digestLength<H>()
    if signature.length != width || digest.length != hashLength {
      fail RsaError.InvalidLength
    }
    let bits = self.public.n.bitLength()
    let encodedLength = (bits + 6) / 8
    if saltLength > BLOCK || encodedLength < hashLength + saltLength + 2 {
      fail RsaError.KeyTooSmall
    }
    let mut salt: [u8; 1024] = [0; 1024]
    run Random.fillBytes(Slice.viewMut<u8>(&mut salt, 0, saltLength))
    let mut block: [u8; 1024] = [0; 1024]
    let offset = width - encodedLength
    pssEncode<H>(
      digest,
      Slice.view<u8>(&salt, 0, saltLength),
      bits,
      Slice.viewMut<u8>(&mut block, offset, encodedLength),
    )
    let signed = signBlock(self, &block, move signature)
    if let Result<(), RsaError>.Failure { error } = move signed {
      fail error
    }
  }

  /// Decrypts an RSAES-OAEP `ciphertext` made with the hash `H`, MGF1 with `H`, and `label`, and
  /// returns the length of the message that it writes to the start of `output`.
  ///
  /// It checks the padding without a branch on secret data and has one error for every bad
  /// ciphertext, so the errors do not reveal the plaintext.
  ///
  /// # Errors
  /// - `InvalidLength` if `ciphertext` is not as long as the modulus, or `output` is shorter than
  ///   the longest message for the key: the modulus length less twice the digest length less 2.
  /// - `KeyTooSmall` if the key is too short for `H`.
  /// - `InvalidCiphertext` if the ciphertext is not valid.
  /// - `InvalidKey` if the private parts do not match the public key.
  pub fn decryptOaep<H: Digest>(
    self: &RsaPrivateKey,
    label: &[u8],
    ciphertext: &[u8],
    output: &mut [u8],
  ) -> Result<usize, RsaError> {
    let width = self.public.width
    let hashLength = digestLength<H>()
    if width < 2 * hashLength + 2 {
      return Result<usize, RsaError>.failResult(RsaError.KeyTooSmall)
    }
    if ciphertext.length != width || output.length < width - 2 * hashLength - 2 {
      return Result<usize, RsaError>.failResult(RsaError.InvalidLength)
    }
    let mut block: [u8; 1024] = [0; 1024]
    let opened = openBlock(self, ciphertext, &mut block)
    if let Result<(), RsaError>.Failure { error } = move opened {
      return Result<usize, RsaError>.failResult(error)
    }
    let dbLength = width - hashLength - 1
    let mut maskedDb: [u8; 1024] = [0; 1024]
    let mut i: usize = 0
    while i < dbLength {
      maskedDb[i] = block[1 + hashLength + i]
      i = i + 1
    }
    maskWith<H>(
      Slice.view<u8>(&maskedDb, 0, dbLength),
      Slice.viewMut<u8>(&mut block, 1, hashLength),
    )
    let mut seed: [u8; 64] = [0; 64]
    i = 0
    while i < hashLength {
      seed[i] = block[1 + i]
      i = i + 1
    }
    maskWith<H>(
      Slice.view<u8>(&seed, 0, hashLength),
      Slice.viewMut<u8>(&mut block, 1 + hashLength, dbLength),
    )
    let mut labelHash: [u8; 64] = [0; 64]
    hashInto<H>(label, &mut labelHash)
    let mut good = zeroByte(block[0])
    i = 0
    while i < hashLength {
      good = u32.bitAnd(good, equalByte(block[1 + hashLength + i], labelHash[i]))
      i = i + 1
    }

    // Finds the 0x01 after the zero padding without a branch on the bytes.
    let mut looking: u32 = 1
    let mut invalid: u32 = 0
    let mut index: usize = 0
    i = 1 + 2 * hashLength
    while i < width {
      let isOne = equalByte(block[i], 1)
      let isZero = zeroByte(block[i])
      let take = u32.bitAnd(looking, isOne)
      let mask = usize.wrappingSubtract(0, u32.toUsize(take))
      index = usize.bitOr(usize.bitAnd(index, usize.bitNot(mask)), usize.bitAnd(i, mask))
      invalid = u32.bitOr(
        invalid,
        u32.bitAnd(looking, u32.bitAnd(u32.bitXor(isOne, 1), u32.bitXor(isZero, 1))),
      )
      looking = u32.bitAnd(looking, u32.bitXor(isOne, 1))
      i = i + 1
    }
    good = u32.bitAnd(good, u32.bitAnd(u32.bitXor(looking, 1), u32.bitXor(invalid, 1)))
    if good != 1 {
      return Result<usize, RsaError>.failResult(RsaError.InvalidCiphertext)
    }
    let length = width - index - 1
    i = 0
    while i < length {
      output[i] = block[index + 1 + i]
      i = i + 1
    }
    return Result<usize, RsaError>.succeed(length)
  }

  /// Computes `input`^d modulo n without padding (RSADP, `RSA_NO_PADDING` in Node.js) and writes
  /// it to `output`.
  ///
  /// # Errors
  /// - `InvalidLength` if `input` or `output` is not as long as the modulus.
  /// - `InvalidCiphertext` if `input` is not less than the modulus.
  /// - `InvalidKey` if the private parts do not match the public key.
  ///
  /// # Gotchas
  /// Raw RSA is not secure on its own. Use it only to build a padding scheme.
  pub fn decryptRaw(self: &RsaPrivateKey, input: &[u8], output: &mut [u8]) -> Result<
    (),
    RsaError,
  > {
    let width = self.public.width
    if input.length != width || output.length != width {
      return Result<(), RsaError>.failResult(RsaError.InvalidLength)
    }
    let mut block: [u8; 1024] = [0; 1024]
    let opened = openBlock(self, input, &mut block)
    if let Result<(), RsaError>.Failure { error } = move opened {
      return Result<(), RsaError>.failResult(error)
    }
    let mut i: usize = 0
    while i < width {
      output[i] = block[i]
      i = i + 1
    }
    return Result<(), RsaError>.succeed(())
  }
}

fn signBlock(key: &RsaPrivateKey, block: &[u8; 1024], signature: &mut [u8]) -> Result<
  (),
  RsaError,
> {
  let value = natural(Slice.view<u8>(block, 0, key.public.width))
  let signed = match privateOperation(key, &value) {
    Result<Natural, RsaError>.Success { value: result } => result
    Result<Natural, RsaError>.Failure { error } => {
      return Result<(), RsaError>.failResult(error)
    }
  }
  writeFixed(&signed, move signature)
  return Result<(), RsaError>.succeed(())
}

// Writes input^d modulo n to the first `width` bytes of `block`.
fn openBlock(key: &RsaPrivateKey, input: &[u8], block: &mut [u8; 1024]) -> Result<(), RsaError> {
  let value = match representative(&key.public, input) {
    Option<Natural>.Some { value } => value
    Option<Natural>.None => {
      return Result<(), RsaError>.failResult(RsaError.InvalidCiphertext)
    }
  }
  let opened = match privateOperation(key, &value) {
    Result<Natural, RsaError>.Success { value: result } => result
    Result<Natural, RsaError>.Failure { error } => {
      return Result<(), RsaError>.failResult(error)
    }
  }
  writeFixed(&opened, Slice.viewMut<u8>(&mut block, 0, key.public.width))
  return Result<(), RsaError>.succeed(())
}

// The odd primes below 4096, which trial division uses.
struct SmallPrimes {
  values: [u32; 563],
  reciprocals: [u64; 563],
}

fn smallPrimes() -> SmallPrimes {
  let mut composite: [bool; 4096] = [false; 4096]
  let mut primes = SmallPrimes { values: [0; 563], reciprocals: [0; 563] }
  let mut count: usize = 0
  let mut candidate: usize = 3
  while candidate < 4096 {
    if !composite[candidate] {
      primes.values[count] = usize.toU32(candidate)
      primes.reciprocals[count] = u64.MAX / usize.toU64(candidate)
      count = count + 1
      let mut multiple = candidate * candidate
      while multiple < 4096 {
        composite[multiple] = true
        multiple = multiple + 2 * candidate
      }
    }
    candidate = candidate + 2
  }
  return move primes
}

// Returns a random odd number of exactly `bits` bits with the top two bits set.
effect fn randomCandidate(bits: usize) -> Natural
  ? &mut Random {
  let length = (bits + 7) / 8
  let mut bytes: [u8; 512] = [0; 512]
  let view = Slice.viewMut<u8>(&mut bytes, 0, length)
  run Random.fillBytes(move view)
  let excess = 8 * length - bits
  bytes[0] = u8.bitAnd(bytes[0], u32.toU8(u32.shiftRight(255, usize.toU32(excess))))
  if bits % 8 == 1 {
    bytes[0] = 1
    bytes[1] = u8.bitOr(bytes[1], 128)
  } else {
    bytes[0] = u8.bitOr(bytes[0], u32.toU8(u32.shiftRight(192, usize.toU32(excess))))
  }
  bytes[length - 1] = u8.bitOr(bytes[length - 1], 1)
  return natural(Slice.view<u8>(&bytes, 0, length))
}

// Returns a random number from 2 to `limit` - 2, for an odd limit of `bits` bits.
effect fn randomBase(limit: &Natural, bits: usize) -> Natural
  ? &mut Random {
  let length = (bits + 7) / 8
  let excess = 8 * length - bits
  let lowest = Natural.fromU64(2)
  let highest = difference(limit, &lowest)
  while true {
    let mut bytes: [u8; 512] = [0; 512]
    run Random.fillBytes(Slice.viewMut<u8>(&mut bytes, 0, length))
    bytes[0] = u8.bitAnd(bytes[0], u32.toU8(u32.shiftRight(255, usize.toU32(excess))))
    let value = natural(Slice.view<u8>(&bytes, 0, length))
    if !value.lessThan(&lowest) && !highest.lessThan(&value) {
      return value
    }
  }
  Intrinsic.trap("unreachable")
}

// Miller-Rabin with random bases on an odd candidate of `bits` bits above 3.
effect fn probablyPrime(candidate: &Natural, bits: usize) -> bool
  ? &mut Random {
  let modulus = match Modulus.make(candidate) {
    Result<Modulus, ModularError>.Success { value } => move value
    Result<Modulus, ModularError>.Failure { .. } => {
      return false
    }
  }
  let one = Natural.fromU64(1)
  let minusOne = difference(candidate, &one)
  let mut shift: usize = 1
  while minusOne.bit(shift) == 0 {
    shift = shift + 1
  }
  let odd = minusOne.shiftRight(shift)
  let mut rounds: usize = 64
  if bits > 2048 {
    rounds = 128
  }
  let mut round: usize = 0
  while round < rounds {
    let base = run randomBase(candidate, bits)
    let mut value = modulus.power(&base, &odd)
    if !value.equals(&one) && !value.equals(&minusOne) {
      let mut step: usize = 1
      let mut witness = true
      while step < shift && witness {
        value = modulus.multiply(&value, &value)
        if value.equals(&minusOne) {
          witness = false
        }
        step = step + 1
      }
      if witness {
        return false
      }
    }
    round = round + 1
  }
  return true
}

struct SmallInverse {
  value: u32,
  found: bool,
}

// Returns the inverse of `value` modulo the odd `modulus` with a fixed number of steps of the
// binary extended Euclidean algorithm. `found` is false when they share a factor.
fn invertSmall(value: u32, modulus: u32) -> SmallInverse {
  let m = u32.toU64(modulus)
  let mut a = u32.toU64(value)
  let mut b = m
  let mut u: u64 = 1
  let mut v: u64 = 0
  let mut step: usize = 0
  while step < 64 {
    let odd = u64.bitAnd(a, 1)
    let below = u64.shiftRight(u64.wrappingSubtract(a, b), 63)
    let swap = u64.wrappingSubtract(0, u64.bitAnd(odd, below))
    let swapAB = u64.bitAnd(u64.bitXor(a, b), swap)
    a = u64.bitXor(a, swapAB)
    b = u64.bitXor(b, swapAB)
    let swapUV = u64.bitAnd(u64.bitXor(u, v), swap)
    u = u64.bitXor(u, swapUV)
    v = u64.bitXor(v, swapUV)
    let subtract = u64.wrappingSubtract(0, odd)
    a = u64.wrappingSubtract(a, u64.bitAnd(b, subtract))
    let reduced = u64.wrappingSubtract(u, u64.bitAnd(v, subtract))
    let negative = u64.wrappingSubtract(0, u64.shiftRight(reduced, 63))
    u = u64.wrappingAdd(reduced, u64.bitAnd(m, negative))
    a = u64.shiftRight(a, 1)
    let half = u64.wrappingSubtract(0, u64.bitAnd(u, 1))
    u = u64.shiftRight(u64.wrappingAdd(u, u64.bitAnd(m, half)), 1)
    step = step + 1
  }
  return SmallInverse { value: u64.toU32(v), found: b == 1 }
}

// Returns a prime of `bits` bits with gcd(prime - 1, exponent) = 1. It steps from a random odd
// start past multiples of the small primes, then tests with Miller-Rabin.
effect fn generatePrime(bits: usize, exponent: u32, primes: &SmallPrimes) -> Natural
  ? &mut Random {
  while true {
    let start = run randomCandidate(bits)
    let mut residues: [u32; 563] = [0; 563]
    let mut i: usize = 0
    while i < 563 {
      residues[i] = start.remainderWord(primes.values[i])
      i = i + 1
    }
    let mut offset: u32 = 0
    while offset < 65536 {
      let mut divisible = false
      i = 0
      while i < 563 && !divisible {
        if residues[i] == 0 {
          divisible = true
        }
        i = i + 1
      }
      if !divisible {
        let candidate = sum(&start, &Natural.fromU64(u32.toU64(offset)))
        let fitted = resized(&candidate, start.wordLength())
        if fitted.bitLength() != bits {
          break
        }
        let inverse = invertSmall(
          previousResidue(fitted.remainderWord(exponent), exponent),
          exponent,
        )
        if inverse.found && run probablyPrime(&fitted, bits) {
          return fitted
        }
      }
      i = 0
      while i < 563 {
        let next = residues[i] + 2
        let over = u32.bitXor(u32.shiftRight(u32.wrappingSubtract(next, primes.values[i]), 31), 1)
        residues[i] = next - u32.bitAnd(primes.values[i], u32.wrappingSubtract(0, over))
        i = i + 1
      }
      offset = offset + 2
    }
  }
  Intrinsic.trap("unreachable")
}

// Returns (residue - 1) modulo the modulus without a branch.
fn previousResidue(residue: u32, modulus: u32) -> u32 {
  let value = u64.wrappingAdd(u32.toU64(residue), u32.toU64(modulus) - 1)
  let over = u64.bitXor(u64.shiftRight(u64.wrappingSubtract(value, u32.toU64(modulus)), 63), 1)
  return u64.toU32(
    u64.wrappingSubtract(value, u64.bitAnd(u32.toU64(modulus), u64.wrappingSubtract(0, over))),
  )
}

// Returns (1 + base * (e - (base mod e)^-1)) / e, the inverse of e modulo `base`, with the
// length of `base`. gcd(base, e) must be 1.
fn inverseModulo(base: &Natural, exponent: u32) -> Natural {
  let inverse = invertSmall(base.remainderWord(exponent), exponent)
  let factor = Natural.fromU64(u32.toU64(exponent - inverse.value))
  let numerator = sum(&product(base, &factor), &Natural.fromU64(1))
  return resized(&numerator.divideWord(exponent), base.wordLength())
}

fn keyFromPrimes(first: &Natural, second: &Natural, exponent: u32) -> RsaPrivateKey {
  let one = Natural.fromU64(1)
  let firstLess = difference(first, &one)
  let secondLess = difference(second, &one)
  let totient = product(&firstLess, &secondLess)
  let modulusValue = product(first, second)
  let length = (modulusValue.bitLength() + 31) / 32
  let firstModulus = match Modulus.make(first) {
    Result<Modulus, ModularError>.Success { value } => move value
    Result<Modulus, ModularError>.Failure { .. } => Intrinsic.trap("RSA prime is not odd")
  }
  let secondModulus = match Modulus.make(second) {
    Result<Modulus, ModularError>.Success { value } => move value
    Result<Modulus, ModularError>.Failure { .. } => Intrinsic.trap("RSA prime is not odd")
  }
  let modulus = match Modulus.make(&modulusValue) {
    Result<Modulus, ModularError>.Success { value } => move value
    Result<Modulus, ModularError>.Failure { .. } => Intrinsic.trap("RSA modulus is not odd")
  }
  let coefficient = firstModulus.invertPrime(&firstModulus.reduce(second))
  return RsaPrivateKey {
    public: RsaPublicKey {
      n: move modulus,
      e: Natural.fromU64(u32.toU64(exponent)),
      width: (modulusValue.bitLength() + 7) / 8,
    },
    d: resized(&inverseModulo(&totient, exponent), length),
    p: move firstModulus,
    q: move secondModulus,
    dp: inverseModulo(&firstLess, exponent),
    dq: inverseModulo(&secondLess, exponent),
    qInverse: coefficient,
  }
}

struct DerValue {
  start: usize,
  end: usize,
  valid: bool,
}

fn readDer(bytes: &[u8], offset: usize, limit: usize, tag: u8) -> DerValue {
  let invalid = DerValue { start: 0, end: 0, valid: false }
  if limit > bytes.length || offset >= limit || limit - offset < 2 {
    return move invalid
  }
  if bytes[offset] != tag {
    return move invalid
  }
  let first = bytes[offset + 1]
  let mut start = offset + 2
  let mut length = u8.toUsize(first)
  if first >= 128 {
    let count = u8.toUsize(first - 128)
    if count == 0 || count > 4 || count > limit - start || bytes[start] == 0 {
      return move invalid
    }
    length = 0
    let mut i: usize = 0
    while i < count {
      let byte = u8.toUsize(bytes[start + i])
      if length > (usize.MAX - byte) / 256 {
        return move invalid
      }
      length = length * 256 + byte
      i = i + 1
    }
    if length < 128 {
      return move invalid
    }
    start = start + count
  }
  if length > limit - start {
    return move invalid
  }
  return DerValue { start: start, end: start + length, valid: true }
}

fn contentEqual(bytes: &[u8], value: &DerValue, expected: &[u8]) -> bool {
  if !value.valid || value.end - value.start != expected.length {
    return false
  }
  let mut i: usize = 0
  while i < expected.length {
    if bytes[value.start + i] != expected[i] {
      return false
    }
    i = i + 1
  }
  return true
}

fn rsaAlgorithm(bytes: &[u8], suffix: u8, requireNull: bool) -> bool {
  let sequence = readDer(bytes, 0, bytes.length, 48)
  if !sequence.valid || sequence.end != bytes.length {
    return false
  }
  let oid = readDer(bytes, sequence.start, sequence.end, 6)
  let expected: [u8; 9] = [42, 134, 72, 134, 247, 13, 1, 1, suffix]
  if !contentEqual(bytes, &oid, &expected) {
    return false
  }
  if oid.end == sequence.end {
    return !requireNull
  }
  let nullValue = readDer(bytes, oid.end, sequence.end, 5)
  return nullValue.valid && nullValue.start == nullValue.end && nullValue.end == sequence.end
}

fn sha256Algorithm(bytes: &[u8], offset: usize, limit: usize) -> bool {
  let sequence = readDer(bytes, offset, limit, 48)
  if !sequence.valid || sequence.end != limit {
    return false
  }
  let oid = readDer(bytes, sequence.start, sequence.end, 6)
  let expected: [u8; 9] = [96, 134, 72, 1, 101, 3, 4, 2, 1]
  if !contentEqual(bytes, &oid, &expected) {
    return false
  }
  if oid.end == sequence.end {
    return true
  }
  let nullValue = readDer(bytes, oid.end, sequence.end, 5)
  return nullValue.valid && nullValue.start == nullValue.end && nullValue.end == sequence.end
}

fn pssAlgorithm(bytes: &[u8]) -> bool {
  let sequence = readDer(bytes, 0, bytes.length, 48)
  if !sequence.valid || sequence.end != bytes.length {
    return false
  }
  let oid = readDer(bytes, sequence.start, sequence.end, 6)
  let expected: [u8; 9] = [42, 134, 72, 134, 247, 13, 1, 1, 10]
  if !contentEqual(bytes, &oid, &expected) {
    return false
  }
  let parameters = readDer(bytes, oid.end, sequence.end, 48)
  if !parameters.valid || parameters.end != sequence.end {
    return false
  }

  // Defaults are SHA-1/MGF1-SHA-1/salt20; this profile requires the first three fields.
  let hash = readDer(bytes, parameters.start, parameters.end, 160)
  if !hash.valid || !sha256Algorithm(bytes, hash.start, hash.end) {
    return false
  }
  let mask = readDer(bytes, hash.end, parameters.end, 161)
  if !mask.valid {
    return false
  }
  let maskSequence = readDer(bytes, mask.start, mask.end, 48)
  if !maskSequence.valid || maskSequence.end != mask.end {
    return false
  }
  let maskOid = readDer(bytes, maskSequence.start, maskSequence.end, 6)
  let mgf: [u8; 9] = [42, 134, 72, 134, 247, 13, 1, 1, 8]
  if !contentEqual(bytes, &maskOid, &mgf)
    || !sha256Algorithm(bytes, maskOid.end, maskSequence.end) {
    return false
  }
  let salt = readDer(bytes, mask.end, parameters.end, 162)
  if !salt.valid {
    return false
  }
  let saltInteger = readDer(bytes, salt.start, salt.end, 2)
  let saltExpected: [u8; 1] = [32]
  if !contentEqual(bytes, &saltInteger, &saltExpected) || saltInteger.end != salt.end {
    return false
  }
  if salt.end == parameters.end {
    return true
  }
  let trailer = readDer(bytes, salt.end, parameters.end, 163)
  if !trailer.valid || trailer.end != parameters.end {
    return false
  }
  let trailerInteger = readDer(bytes, trailer.start, trailer.end, 2)
  let trailerExpected: [u8; 1] = [1]
  return contentEqual(bytes, &trailerInteger, &trailerExpected) && trailerInteger.end == trailer.end
}

impl RsaPublicKey {
  /// Returns the key in the `subjectPublicKeyInfo` of a certificate.
  ///
  /// Pass the algorithm DER, the BIT STRING bytes, and the unused-bit count from
  /// `silk.tls.certificate` as they are. The algorithm must be `rsaEncryption` with no parameters
  /// or NULL. The key must have a modulus of 2048 to 4096 bits with no leading zero byte, and the
  /// exponent 65537.
  ///
  /// # Errors
  /// - `InvalidEncoding` if the DER is not valid.
  /// - `InvalidParameters` if the algorithm is wrong.
  /// - `InvalidLength` if `unusedBits` is not 0.
  /// - `InvalidKey` if the key is not in the profile.
  pub fn fromCertificateKey(algorithmDer: &[u8], keyDer: &[u8], unusedBits: u8) -> Result<
    RsaPublicKey,
    RsaError,
  > {
    if unusedBits != 0 {
      return Result<RsaPublicKey, RsaError>.failResult(RsaError.InvalidLength)
    }
    if !rsaAlgorithm(algorithmDer, 1, false) {
      return Result<RsaPublicKey, RsaError>.failResult(RsaError.InvalidParameters)
    }
    let sequence = readDer(keyDer, 0, keyDer.length, 48)
    if !sequence.valid || sequence.end != keyDer.length {
      return Result<RsaPublicKey, RsaError>.failResult(RsaError.InvalidEncoding)
    }
    let modulus = readDer(keyDer, sequence.start, sequence.end, 2)
    if !modulus.valid || modulus.start == modulus.end {
      return Result<RsaPublicKey, RsaError>.failResult(RsaError.InvalidEncoding)
    }
    let mut start = modulus.start
    if keyDer[start] == 0 {
      start = start + 1
      if start == modulus.end || keyDer[start] < 128 {
        return Result<RsaPublicKey, RsaError>.failResult(RsaError.InvalidEncoding)
      }
    } else {
      if keyDer[start] >= 128 {
        return Result<RsaPublicKey, RsaError>.failResult(RsaError.InvalidEncoding)
      }
    }
    let exponent = readDer(keyDer, modulus.end, sequence.end, 2)
    if !exponent.valid || exponent.start == exponent.end || exponent.end != sequence.end {
      return Result<RsaPublicKey, RsaError>.failResult(RsaError.InvalidEncoding)
    }
    let mut exponentStart = exponent.start
    if keyDer[exponentStart] == 0 {
      exponentStart = exponentStart + 1
      if exponentStart == exponent.end || keyDer[exponentStart] < 128 {
        return Result<RsaPublicKey, RsaError>.failResult(RsaError.InvalidEncoding)
      }
    } else {
      if keyDer[exponentStart] >= 128 {
        return Result<RsaPublicKey, RsaError>.failResult(RsaError.InvalidEncoding)
      }
    }
    let modulusBytes = Slice.view<u8>(keyDer, start, modulus.end - start)
    let exponentBytes = Slice.view<u8>(keyDer, exponentStart, exponent.end - exponentStart)
    let profile: [u8; 3] = [1, 0, 1]
    if modulusBytes.length < 256 || modulusBytes.length > 512
      || !contentEqual(
        keyDer,
        &DerValue { start: exponentStart, end: exponent.end, valid: true },
        &profile,
      ) {
      return Result<RsaPublicKey, RsaError>.failResult(RsaError.InvalidKey)
    }
    let imported = publicKeyFrom(modulusBytes, exponentBytes)
    if let Result<RsaPublicKey, RsaError>.Success { value } = &imported {
      if value.n.bitLength() < 2048 {
        return Result<RsaPublicKey, RsaError>.failResult(RsaError.InvalidKey)
      }
    }
    return move imported
  }

  /// Verifies a certificate signature with this key.
  ///
  /// `message` is the signed part of the certificate (the TBSCertificate DER), `algorithmDer` is
  /// its signature AlgorithmIdentifier, and `signature` and `unusedBits` come from its signature
  /// BIT STRING. It accepts `sha256WithRSAEncryption` (PKCS #1 v1.5) and RSASSA-PSS with
  /// SHA-256, MGF1 with SHA-256, and a 32-byte salt.
  ///
  /// # Errors
  /// - `InvalidLength` if `unusedBits` is not 0.
  /// - `InvalidParameters` if the algorithm or its parameters are not supported.
  /// - `InvalidLength` if `signature` does not have the length of the modulus.
  /// - `InvalidSignature` if the signature does not match.
  ///
  /// # Gotchas
  /// It checks only this one signature. It does not check the chain, the dates, or the names.
  pub fn verifyCertificate(
    self: &RsaPublicKey,
    message: &[u8],
    algorithmDer: &[u8],
    signature: &[u8],
    unusedBits: u8,
  ) -> Result<(), RsaError> {
    if unusedBits != 0 {
      return Result<(), RsaError>.failResult(RsaError.InvalidLength)
    }
    let digest = Sha256.hash(message)
    if pssAlgorithm(algorithmDer) {
      return verifyPssDigest<Sha256>(self, &digest, signature, Option<usize>.some(32))
    }
    if rsaAlgorithm(algorithmDer, 11, false) {
      return verifyPkcs1Digest<Sha256>(self, &digest, signature)
    }
    return Result<(), RsaError>.failResult(RsaError.InvalidParameters)
  }
}

// The rsaEncryption AlgorithmIdentifier with NULL parameters.
fn rsaEncryptionDer() -> [u8; 15] {
  return [48, 13, 6, 9, 42, 134, 72, 134, 247, 13, 1, 1, 1, 5, 0]
}

// Reads a minimal, non-negative DER INTEGER. `start` skips the sign byte of a value whose top
// bit is set.
fn readInteger(bytes: &[u8], offset: usize, limit: usize) -> DerValue {
  let invalid = DerValue { start: 0, end: 0, valid: false }
  let value = readDer(bytes, offset, limit, 2)
  if !value.valid || value.start == value.end || bytes[value.start] >= 128 {
    return move invalid
  }
  if bytes[value.start] == 0 && value.end - value.start > 1 {
    if bytes[value.start + 1] < 128 {
      return move invalid
    }
    return DerValue { start: value.start + 1, end: value.end, valid: true }
  }
  return move value
}

fn integerBytes<'bytes>(bytes: &'bytes [u8], value: &DerValue) -> &'bytes [u8] {
  return Slice.view<u8>(bytes, value.start, value.end - value.start)
}

fn publicFromSequence(der: &[u8]) -> Result<RsaPublicKey, RsaError> {
  let sequence = readDer(der, 0, der.length, 48)
  if !sequence.valid || sequence.end != der.length {
    return Result<RsaPublicKey, RsaError>.failResult(RsaError.InvalidEncoding)
  }
  let modulus = readInteger(der, sequence.start, sequence.end)
  if !modulus.valid {
    return Result<RsaPublicKey, RsaError>.failResult(RsaError.InvalidEncoding)
  }
  let exponent = readInteger(der, modulus.end, sequence.end)
  if !exponent.valid || exponent.end != sequence.end {
    return Result<RsaPublicKey, RsaError>.failResult(RsaError.InvalidEncoding)
  }
  return publicKeyFrom(integerBytes(der, &modulus), integerBytes(der, &exponent))
}

fn privateFromSequence(der: &[u8]) -> Result<RsaPrivateKey, RsaError> {
  let sequence = readDer(der, 0, der.length, 48)
  if !sequence.valid || sequence.end != der.length {
    return Result<RsaPrivateKey, RsaError>.failResult(RsaError.InvalidEncoding)
  }
  let version = readInteger(der, sequence.start, sequence.end)
  if !version.valid || version.end - version.start != 1 {
    return Result<RsaPrivateKey, RsaError>.failResult(RsaError.InvalidEncoding)
  }
  if der[version.start] != 0 {
    // Version 1 is a multi-prime key.
    return Result<RsaPrivateKey, RsaError>.failResult(RsaError.InvalidParameters)
  }
  let mut values: [DerValue; 8] = [
    DerValue { start: 0, end: 0, valid: false },
    DerValue { start: 0, end: 0, valid: false },
    DerValue { start: 0, end: 0, valid: false },
    DerValue { start: 0, end: 0, valid: false },
    DerValue { start: 0, end: 0, valid: false },
    DerValue { start: 0, end: 0, valid: false },
    DerValue { start: 0, end: 0, valid: false },
    DerValue { start: 0, end: 0, valid: false },
  ]
  let mut offset = version.end
  let mut i: usize = 0
  while i < 8 {
    let value = readInteger(der, offset, sequence.end)
    if !value.valid {
      return Result<RsaPrivateKey, RsaError>.failResult(RsaError.InvalidEncoding)
    }
    offset = value.end
    values[i] = move value
    i = i + 1
  }
  if offset != sequence.end {
    return Result<RsaPrivateKey, RsaError>.failResult(RsaError.InvalidEncoding)
  }
  return RsaPrivateKey.fromComponents(
    integerBytes(der, &values[0]),
    integerBytes(der, &values[1]),
    integerBytes(der, &values[2]),
    integerBytes(der, &values[3]),
    integerBytes(der, &values[4]),
    integerBytes(der, &values[5]),
    integerBytes(der, &values[6]),
    integerBytes(der, &values[7]),
  )
}

fn headerLength(length: usize) -> usize {
  if length < 128 {
    return 2
  }
  if length < 256 {
    return 3
  }
  if length < 65536 {
    return 4
  }
  return 5
}

// The content length of a DER INTEGER for the value: its bytes and a sign byte when the top
// bit is set, which together is always the bit length / 8 + 1.
fn integerContentLength(value: &Natural) -> usize {
  return value.bitLength() / 8 + 1
}

fn integerLength(value: &Natural) -> usize {
  let content = integerContentLength(value)
  return headerLength(content) + content
}

fn writeHeader(output: &mut [u8], position: usize, tag: u8, length: usize) -> usize {
  output[position] = tag
  let size = headerLength(length)
  if size == 2 {
    output[position + 1] = usize.toU8(length)
    return position + 2
  }
  output[position + 1] = usize.toU8(128 + size - 2)
  let mut i: usize = 0
  while i < size - 2 {
    let shift = 8 * (size - 3 - i)
    output[position + 2 + i] = usize.toU8(usize.bitAnd(usize.shiftRight(length, shift), 255))
    i = i + 1
  }
  return position + size
}

fn writeInteger(output: &mut [u8], position: usize, value: &Natural) -> usize {
  let content = integerContentLength(value)
  let start = writeHeader(&mut output, position, 2, content)
  writeFixed(value, Slice.viewMut<u8>(&mut output, start, content))
  return start + content
}

fn publicContentLength(key: &RsaPublicKey) -> usize {
  return integerLength(&key.n.natural()) + integerLength(&key.e)
}

fn writePublicSequence(key: &RsaPublicKey, output: &mut [u8], position: usize) -> usize {
  let mut at = writeHeader(&mut output, position, 48, publicContentLength(key))
  at = writeInteger(&mut output, at, &key.n.natural())
  return writeInteger(&mut output, at, &key.e)
}

fn spkiContentLength(key: &RsaPublicKey) -> usize {
  let bits = 1 + headerLength(publicContentLength(key)) + publicContentLength(key)
  return 15 + headerLength(bits) + bits
}

fn privateParts(key: &RsaPrivateKey) -> [Natural; 8] {
  return [
    key.public.n.natural(),
    key.public.e,
    key.d,
    key.p.natural(),
    key.q.natural(),
    key.dp,
    key.dq,
    key.qInverse,
  ]
}

fn privateContentLength(key: &RsaPrivateKey) -> usize {
  let parts = privateParts(key)
  let mut length: usize = 3
  let mut i: usize = 0
  while i < 8 {
    length = length + integerLength(&parts[i])
    i = i + 1
  }
  return length
}

fn writePrivateSequence(key: &RsaPrivateKey, output: &mut [u8], position: usize) -> usize {
  let parts = privateParts(key)
  let mut at = writeHeader(&mut output, position, 48, privateContentLength(key))
  at = writeInteger(&mut output, at, &Natural.zero())
  let mut i: usize = 0
  while i < 8 {
    at = writeInteger(&mut output, at, &parts[i])
    i = i + 1
  }
  return at
}

fn pkcs8ContentLength(key: &RsaPrivateKey) -> usize {
  let inner = headerLength(privateContentLength(key)) + privateContentLength(key)
  return 3 + 15 + headerLength(inner) + inner
}

fn writeAlgorithm(output: &mut [u8], position: usize) -> usize {
  let algorithm = rsaEncryptionDer()
  let mut i: usize = 0
  while i < 15 {
    output[position + i] = algorithm[i]
    i = i + 1
  }
  return position + 15
}

impl RsaPublicKey {
  /// Returns the key in a DER PKCS #1 `RSAPublicKey`: a SEQUENCE of the modulus and the
  /// exponent, as in a PEM `RSA PUBLIC KEY`.
  ///
  /// # Errors
  /// - `InvalidEncoding` if the DER is not valid, not minimal, or has bytes after it.
  /// - `InvalidKey` if the key is not valid, as with [`RsaPublicKey.fromComponents`].
  pub fn fromPkcs1Der(der: &[u8]) -> Result<RsaPublicKey, RsaError> {
    return publicFromSequence(der)
  }

  /// Returns the key in a DER `SubjectPublicKeyInfo` with the `rsaEncryption` algorithm, as in a
  /// PEM `PUBLIC KEY`.
  ///
  /// # Errors
  /// - `InvalidEncoding` if the DER is not valid, or the BIT STRING has unused bits.
  /// - `InvalidParameters` if the algorithm is not `rsaEncryption` with NULL or no parameters.
  /// - `InvalidKey` if the key is not valid, as with [`RsaPublicKey.fromComponents`].
  pub fn fromSpkiDer(der: &[u8]) -> Result<RsaPublicKey, RsaError> {
    let sequence = readDer(der, 0, der.length, 48)
    if !sequence.valid || sequence.end != der.length {
      return Result<RsaPublicKey, RsaError>.failResult(RsaError.InvalidEncoding)
    }
    let algorithm = readDer(der, sequence.start, sequence.end, 48)
    if !algorithm.valid {
      return Result<RsaPublicKey, RsaError>.failResult(RsaError.InvalidEncoding)
    }
    let algorithmDer = Slice.view<u8>(der, sequence.start, algorithm.end - sequence.start)
    if !rsaAlgorithm(algorithmDer, 1, false) {
      return Result<RsaPublicKey, RsaError>.failResult(RsaError.InvalidParameters)
    }
    let bits = readDer(der, algorithm.end, sequence.end, 3)
    if !bits.valid || bits.end != sequence.end || bits.start == bits.end || der[bits.start] != 0 {
      return Result<RsaPublicKey, RsaError>.failResult(RsaError.InvalidEncoding)
    }
    return publicFromSequence(Slice.view<u8>(der, bits.start + 1, bits.end - bits.start - 1))
  }

  /// Returns the length in bytes of [`RsaPublicKey.writePkcs1Der`].
  pub fn pkcs1DerLength(self: &RsaPublicKey) -> usize {
    let content = publicContentLength(self)
    return headerLength(content) + content
  }

  /// Writes the key as a DER PKCS #1 `RSAPublicKey` to the start of `output` and returns its
  /// length.
  ///
  /// # Errors
  /// - `InvalidLength` if `output` is shorter than [`RsaPublicKey.pkcs1DerLength`].
  pub fn writePkcs1Der(self: &RsaPublicKey, output: &mut [u8]) -> Result<usize, RsaError> {
    if output.length < self.pkcs1DerLength() {
      return Result<usize, RsaError>.failResult(RsaError.InvalidLength)
    }
    return Result<usize, RsaError>.succeed(writePublicSequence(self, &mut output, 0))
  }

  /// Returns the length in bytes of [`RsaPublicKey.writeSpkiDer`].
  pub fn spkiDerLength(self: &RsaPublicKey) -> usize {
    let content = spkiContentLength(self)
    return headerLength(content) + content
  }

  /// Writes the key as a DER `SubjectPublicKeyInfo` with `rsaEncryption` to the start of
  /// `output` and returns its length.
  ///
  /// # Errors
  /// - `InvalidLength` if `output` is shorter than [`RsaPublicKey.spkiDerLength`].
  pub fn writeSpkiDer(self: &RsaPublicKey, output: &mut [u8]) -> Result<usize, RsaError> {
    if output.length < self.spkiDerLength() {
      return Result<usize, RsaError>.failResult(RsaError.InvalidLength)
    }
    let mut at = writeHeader(&mut output, 0, 48, spkiContentLength(self))
    at = writeAlgorithm(&mut output, at)
    let public = publicContentLength(self)
    at = writeHeader(&mut output, at, 3, 1 + headerLength(public) + public)
    output[at] = 0
    return Result<usize, RsaError>.succeed(writePublicSequence(self, &mut output, at + 1))
  }
}

impl RsaPrivateKey {
  /// Returns the key in a DER PKCS #1 `RSAPrivateKey`, as in a PEM `RSA PRIVATE KEY`.
  ///
  /// # Errors
  /// - `InvalidEncoding` if the DER is not valid, not minimal, or has bytes after it.
  /// - `InvalidParameters` if it is a multi-prime key (version 1).
  /// - `InvalidKey` if the parts are not valid, as with [`RsaPrivateKey.fromComponents`].
  pub fn fromPkcs1Der(der: &[u8]) -> Result<RsaPrivateKey, RsaError> {
    return privateFromSequence(der)
  }

  /// Returns the key in a DER PKCS #8 `PrivateKeyInfo` with the `rsaEncryption` algorithm, as
  /// in a PEM `PRIVATE KEY`. Attributes and a public key after the private key are skipped.
  ///
  /// # Errors
  /// - `InvalidEncoding` if the DER is not valid, or the version is not 0 or 1.
  /// - `InvalidParameters` if the algorithm is not `rsaEncryption` with NULL or no parameters,
  ///   or the key is multi-prime.
  /// - `InvalidKey` if the parts are not valid, as with [`RsaPrivateKey.fromComponents`].
  ///
  /// # Gotchas
  /// It does not decrypt an `ENCRYPTED PRIVATE KEY`.
  pub fn fromPkcs8Der(der: &[u8]) -> Result<RsaPrivateKey, RsaError> {
    let sequence = readDer(der, 0, der.length, 48)
    if !sequence.valid || sequence.end != der.length {
      return Result<RsaPrivateKey, RsaError>.failResult(RsaError.InvalidEncoding)
    }
    let version = readInteger(der, sequence.start, sequence.end)
    if !version.valid || version.end - version.start != 1 || der[version.start] > 1 {
      return Result<RsaPrivateKey, RsaError>.failResult(RsaError.InvalidEncoding)
    }
    let algorithm = readDer(der, version.end, sequence.end, 48)
    if !algorithm.valid {
      return Result<RsaPrivateKey, RsaError>.failResult(RsaError.InvalidEncoding)
    }
    let algorithmDer = Slice.view<u8>(der, version.end, algorithm.end - version.end)
    if !rsaAlgorithm(algorithmDer, 1, false) {
      return Result<RsaPrivateKey, RsaError>.failResult(RsaError.InvalidParameters)
    }
    let key = readDer(der, algorithm.end, sequence.end, 4)
    if !key.valid {
      return Result<RsaPrivateKey, RsaError>.failResult(RsaError.InvalidEncoding)
    }

    // Skips [0] attributes and the [1] public key of version 2 (RFC 5958).
    let mut offset = key.end
    let attributes = readDer(der, offset, sequence.end, 160)
    if attributes.valid {
      offset = attributes.end
    }
    let publicKey = readDer(der, offset, sequence.end, 129)
    if publicKey.valid {
      offset = publicKey.end
    }
    if offset != sequence.end {
      return Result<RsaPrivateKey, RsaError>.failResult(RsaError.InvalidEncoding)
    }
    return privateFromSequence(Slice.view<u8>(der, key.start, key.end - key.start))
  }

  /// Returns the length in bytes of [`RsaPrivateKey.writePkcs1Der`].
  pub fn pkcs1DerLength(self: &RsaPrivateKey) -> usize {
    let content = privateContentLength(self)
    return headerLength(content) + content
  }

  /// Writes the key as a DER PKCS #1 `RSAPrivateKey` to the start of `output` and returns its
  /// length.
  ///
  /// # Errors
  /// - `InvalidLength` if `output` is shorter than [`RsaPrivateKey.pkcs1DerLength`].
  pub fn writePkcs1Der(self: &RsaPrivateKey, output: &mut [u8]) -> Result<usize, RsaError> {
    if output.length < self.pkcs1DerLength() {
      return Result<usize, RsaError>.failResult(RsaError.InvalidLength)
    }
    return Result<usize, RsaError>.succeed(writePrivateSequence(self, &mut output, 0))
  }

  /// Returns the length in bytes of [`RsaPrivateKey.writePkcs8Der`].
  pub fn pkcs8DerLength(self: &RsaPrivateKey) -> usize {
    let content = pkcs8ContentLength(self)
    return headerLength(content) + content
  }

  /// Writes the key as a DER PKCS #8 `PrivateKeyInfo` (version 0, `rsaEncryption`) to the start
  /// of `output` and returns its length.
  ///
  /// # Errors
  /// - `InvalidLength` if `output` is shorter than [`RsaPrivateKey.pkcs8DerLength`].
  pub fn writePkcs8Der(self: &RsaPrivateKey, output: &mut [u8]) -> Result<usize, RsaError> {
    if output.length < self.pkcs8DerLength() {
      return Result<usize, RsaError>.failResult(RsaError.InvalidLength)
    }
    let mut at = writeHeader(&mut output, 0, 48, pkcs8ContentLength(self))
    at = writeInteger(&mut output, at, &Natural.zero())
    at = writeAlgorithm(&mut output, at)
    let inner = privateContentLength(self)
    at = writeHeader(&mut output, at, 4, headerLength(inner) + inner)
    return Result<usize, RsaError>.succeed(writePrivateSequence(self, &mut output, at))
  }
}

// The pseudorandom function of implicit rejection: HMAC-SHA256 blocks of the counter, the label,
// and the output length in bits, written to all of `output`.
fn rejectionBytes(derivationKey: &[u8; 32], label: &[u8], output: &mut [u8]) -> () {
  let bits = 8 * output.length
  let suffix: [u8; 2] = [usize.toU8(usize.shiftRight(bits, 8)), usize.toU8(usize.bitAnd(bits, 255))]
  let mut counter: usize = 0
  let mut offset: usize = 0
  while offset < output.length {
    let mut mac = HmacSha256.make(derivationKey)
    let prefix: [u8; 2] = [
      usize.toU8(usize.shiftRight(counter, 8)),
      usize.toU8(usize.bitAnd(counter, 255)),
    ]
    mac.update(&prefix)
    mac.update(label)
    mac.update(&suffix)
    let block = mac.finish()
    let mut i: usize = 0
    while i < 32 && offset + i < output.length {
      output[offset + i] = block[i]
      i = i + 1
    }
    offset = offset + 32
    counter = counter + 1
  }
}

fn selectByte(condition: u32, whenTrue: u8, whenFalse: u8) -> u8 {
  return u8.bitXor(whenFalse, u8.bitAnd(byteMask(condition), u8.bitXor(whenTrue, whenFalse)))
}

fn selectLength(condition: u32, whenTrue: usize, whenFalse: usize) -> usize {
  let mask = usize.wrappingSubtract(0, u32.toUsize(condition))
  return usize.bitXor(whenFalse, usize.bitAnd(mask, usize.bitXor(whenTrue, whenFalse)))
}

// 1 when left < right, for values below 2^63.
fn lessBit(left: usize, right: usize) -> u32 {
  return u64.toU32(u64.shiftRight(u64.wrappingSubtract(usize.toU64(left), usize.toU64(right)), 63))
}

impl RsaPrivateKey {
  /// Decrypts an RSAES-PKCS1-v1_5 `ciphertext` with implicit rejection and returns the length of
  /// the message that it writes to the start of `output`.
  ///
  /// When the padding is not valid, it returns a message derived from the private key and the
  /// ciphertext instead of an error, as OpenSSL 3.2 and later and Node.js do, so a padding oracle
  /// does not reveal the plaintext. The check and the choice run without a branch on secret
  /// data. The bytes of `output` after the message are zero.
  ///
  /// # Errors
  /// - `InvalidLength` if `ciphertext` is not as long as the modulus, or `output` is shorter than
  ///   the modulus length less 11.
  /// - `InvalidCiphertext` if `ciphertext` is not less than the modulus.
  /// - `InvalidKey` if the private parts do not match the public key.
  ///
  /// # Gotchas
  /// A wrong key or a changed ciphertext gives a wrong message, not an error. Use it only for
  /// formats that require PKCS #1 v1.5, and check the message with something else, such as its
  /// expected length or a MAC.
  pub fn decryptPkcs1(self: &RsaPrivateKey, ciphertext: &[u8], output: &mut [u8]) -> Result<
    usize,
    RsaError,
  > {
    let width = self.public.width
    if ciphertext.length != width || output.length < width - 11 {
      return Result<usize, RsaError>.failResult(RsaError.InvalidLength)
    }
    let mut block: [u8; 1024] = [0; 1024]
    let opened = openBlock(self, ciphertext, &mut block)
    if let Result<(), RsaError>.Failure { error } = move opened {
      return Result<usize, RsaError>.failResult(error)
    }

    // The synthetic message: KDK = HMAC-SHA256(SHA-256(d), ciphertext).
    let mut exponentBytes: [u8; 1024] = [0; 1024]
    writeFixed(&self.d, Slice.viewMut<u8>(&mut exponentBytes, 0, width))
    let exponentHash = Sha256.hash(Slice.view<u8>(&exponentBytes, 0, width))
    let mut derivation = HmacSha256.make(&exponentHash)
    derivation.update(ciphertext)
    let derivationKey = derivation.finish()
    let mut synthetic: [u8; 1024] = [0; 1024]
    rejectionBytes(&derivationKey, b"message", Slice.viewMut<u8>(&mut synthetic, 0, width))
    let mut candidates: [u8; 256] = [0; 256]
    rejectionBytes(&derivationKey, b"length", &mut candidates)
    let limit = width - 10
    let mut mask: usize = 1
    while mask < limit {
      mask = mask * 2 + 1
    }
    let mut syntheticLength: usize = 0
    let mut i: usize = 0
    while i < 128 {
      let candidate = usize.bitAnd(
        u8.toUsize(candidates[2 * i]) * 256 + u8.toUsize(candidates[2 * i + 1]),
        mask,
      )
      syntheticLength = selectLength(lessBit(candidate, limit), candidate, syntheticLength)
      i = i + 1
    }

    // The real message: 00 02, at least eight nonzero bytes, 00, then the message.
    let mut good = u32.bitAnd(zeroByte(block[0]), equalByte(block[1], 2))
    let mut looking: u32 = 1
    let mut separator: usize = 0
    i = 2
    while i < width {
      let take = u32.bitAnd(looking, zeroByte(block[i]))
      separator = selectLength(take, i, separator)
      looking = u32.bitAnd(looking, u32.bitXor(take, 1))
      i = i + 1
    }
    good = u32.bitAnd(good, u32.bitXor(looking, 1))
    good = u32.bitAnd(good, u32.bitXor(lessBit(separator, 10), 1))
    let length = selectLength(good, width - separator - 1, syntheticLength)

    // Both messages end the block, so pick bytes, then shift the last width - 11 bytes left.
    let window = width - 11
    let mut shifted: [u8; 1024] = [0; 1024]
    i = 0
    while i < window {
      shifted[i] = selectByte(good, block[11 + i], synthetic[11 + i])
      i = i + 1
    }
    let shift = window - length
    let mut step: usize = 1
    let mut bitIndex: usize = 0
    while step < window {
      let bit = usize.toU32(usize.bitAnd(usize.shiftRight(shift, bitIndex), 1))
      bitIndex = bitIndex + 1
      i = 0
      while i < window {
        let mut moved: u8 = 0
        if i + step < window {
          moved = shifted[i + step]
        }
        shifted[i] = selectByte(bit, moved, shifted[i])
        i = i + 1
      }
      step = step * 2
    }
    i = 0
    while i < output.length {
      if i < window {
        output[i] = selectByte(lessBit(i, length), shifted[i], 0)
      } else {
        output[i] = 0
      }
      i = i + 1
    }
    return Result<usize, RsaError>.succeed(length)
  }
}
