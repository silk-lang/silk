//! Derive keys from passwords with PBKDF2 (RFC 8018 section 5.2) over HMAC with any hash.
//!
//! # When to use
//! Use [`Pbkdf2.derive`] when a format or protocol names PBKDF2, such as `crypto.pbkdf2` in
//! Node.js, PKCS #5, or a stored password hash. For new password storage, prefer a memory-hard
//! function such as `silk.crypto.scrypt`.
//!
//! # Details
//! The hash is a type argument, such as `Pbkdf2.derive<Sha256>` or `Pbkdf2.derive<Sha1>`. The
//! output can have any length up to (2^32 - 1) times the digest length. Each iteration costs two
//! compressions of the hash, because the keyed HMAC prefix is computed once. Nothing allocates.
//!
//! # Errors
//! [`Pbkdf2.derive`] returns a [`Pbkdf2Error`] and leaves `output` unchanged when the iteration
//! count is zero or the output is too long.
//!
//! # Gotchas
//! The time grows with `iterations`, so a count that an attacker controls can take a long time.
//! The function does not erase its copies of the password.
//!
//! # Examples
//! ## Derive a key with PBKDF2-HMAC-SHA-256
//! ```silk
//! import silk.crypto.pbkdf2 { Pbkdf2, Pbkdf2Error }
//! import silk.crypto.sha2 { Sha256 }
//! import silk.core.result { Result }
//!
//! pub fn main() -> i32 {
//!   let mut key: [u8; 32] = [0; 32]
//!   let derived = Pbkdf2.derive<Sha256>(b"password", b"salt", 1, &mut key)
//!   if let Result.Failure { error: _ } = move derived {
//!     return 1
//!   }
//!   // RFC 7914 section 11: PBKDF2-HMAC-SHA-256 of these inputs starts with 120fb6cf.
//!   if key[0] != 0x12 || key[1] != 0x0f || key[2] != 0xb6 || key[3] != 0xcf {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Cryptography

import silk.text.format { Debug, Format, Formatter }
import silk.core.result { Result }
import silk.crypto.digest { Digest }
import silk.crypto.hmac { Hmac }
import silk.collections.slice { Slice }
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silk.io.writer { Writer, WriterError }

/// The reason that [`Pbkdf2.derive`] rejected a call. The output does not change.
pub union Pbkdf2Error {
  /// The iteration count is zero.
  ZeroIterations,
  /// The output is longer than (2^32 - 1) times the digest length of the hash.
  OutputTooLong,
}

impl Debug for Pbkdf2Error {
  /// Writes the name of the variant, such as `ZeroIterations`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return match &self.* {
      Pbkdf2Error.ZeroIterations => run Format.write(&mut formatter, b"ZeroIterations")
      Pbkdf2Error.OutputTooLong => run Format.write(&mut formatter, b"OutputTooLong")
    }
  }
}

/// Functions that derive keys from passwords with PBKDF2 (RFC 8018).
///
/// # When to use
///
/// Use [`Pbkdf2.derive`] when a format or protocol names PBKDF2. For new password storage, prefer
/// `silk.crypto.scrypt`.
pub struct Pbkdf2 {}

impl Pbkdf2 {
  /// Fills `output` with the PBKDF2-HMAC key of `password` and `salt` over the hash `H`, with
  /// `iterations` rounds.
  ///
  /// Any password and salt length is valid, also 0. The output can have any length, also 0. The
  /// first bytes do not depend on how long `output` is, so a shorter output is a prefix of a longer
  /// one. Nothing allocates.
  ///
  /// # Errors
  ///
  /// On an error, `output` does not change.
  ///
  /// - `ZeroIterations` if `iterations` is 0.
  /// - `OutputTooLong` if `output` is longer than (2^32 - 1) times the digest length of `H`.
  ///
  /// # Gotchas
  ///
  /// The time grows with `iterations`. The function does not erase its copies of the password.
  pub fn derive<H: Digest>(
    password: &[u8],
    salt: &[u8],
    iterations: u32,
    output: &mut [u8],
  ) -> Result<(), Pbkdf2Error,> {
    if iterations == 0 {
      return Result<(), Pbkdf2Error>.failResult(Pbkdf2Error.ZeroIterations)
    }
    let keyed = Hmac<H>.make(password)
    let length = keyed.tagLength()
    if usize.toU64(output.length) > u64.wrappingMultiply(4294967295, usize.toU64(length)) {
      return Result<(), Pbkdf2Error>.failResult(Pbkdf2Error.OutputTooLong)
    }
    let mut offset: usize = 0
    let mut index: u32 = 1
    while offset < output.length {
      let counter: [u8; 4] = [
        u32.toU8(u32.shiftRight(index, 24)),
        u32.toU8(u32.bitAnd(u32.shiftRight(index, 16), 255)),
        u32.toU8(u32.bitAnd(u32.shiftRight(index, 8), 255)),
        u32.toU8(u32.bitAnd(index, 255)),
      ]
      let mut first = keyed.copy()
      first.update(salt)
      first.update(&counter)
      let mut chained: [u8; 64] = [0; 64]
      first.finishInto(&mut chained)
      let mut block = chained
      let mut round: u32 = 1
      while round < iterations {
        let mut next = keyed.copy()
        next.update(Slice.view<u8>(&chained, 0, length))
        next.finishInto(&mut chained)
        let mut lane: usize = 0
        while lane < length {
          block[lane] = u8.bitXor(block[lane], chained[lane])
          lane = lane + 1
        }
        round = round + 1
      }
      let mut lane: usize = 0
      while lane < length && offset < output.length {
        output[offset] = block[lane]
        offset = offset + 1
        lane = lane + 1
      }
      index = u32.wrappingAdd(index, 1)
    }
    return Result<(), Pbkdf2Error>.succeed(())
  }
}
