//! Encrypt and authenticate data with AES-CCM (NIST SP 800-38C, RFC 3610).
//!
//! # When to use
//! Use [`AesCcm`] where a protocol names CCM, such as Bluetooth, Zigbee, some TLS 1.2 suites, or
//! Node's `aes-128-ccm`. For new designs, `silk.crypto.aes_gcm` is faster and more common.
//!
//! # Details
//! The key is 16, 24, or 32 bytes. The nonce is 7 to 13 bytes, and a shorter nonce leaves more room
//! for the message length: a message is at most 2^(8 * (15 - nonce length)) - 1 bytes. The tag is
//! 4, 6, 8, 10, 12, 14, or 16 bytes and is separate from the ciphertext. The associated data
//! (`aad`) is authenticated but not encrypted. CCM needs the whole message to start, so there is no
//! streaming form. Nothing allocates.
//!
//! # Errors
//! The functions return an [`AesCcmError`]. All checks come before the first write, and on any
//! error the output buffers do not change. [`AesCcm.open`] writes no plaintext unless the tag is
//! correct.
//!
//! # Gotchas
//! The same key and nonce must never encrypt two messages. Authentication does not stop replay.
//! The functions do not erase their copies of the key.
//!
//! # Examples
//! ## Encrypt and decrypt
//! ```silk
//! import silk.crypto.aes_ccm { AesCcm, AesCcmError }
//! import silk.core.result { Result }
//!
//! pub fn main() -> i32 {
//!   let key: [u8; 16] = [3; 16]
//!   let nonce: [u8; 12] = [9; 12]
//!   let mut ciphertext: [u8; 5] = [0; 5]
//!   let mut tag: [u8; 16] = [0; 16]
//!   if let Result.Failure { error: _ } = AesCcm.seal(&key, &nonce, b"v1", b"hello", &mut ciphertext, &mut tag) {
//!     return 1
//!   }
//!   let mut plaintext: [u8; 5] = [0; 5]
//!   if let Result.Failure { error: _ } = AesCcm.open(&key, &nonce, b"v1", &ciphertext, &tag, &mut plaintext) {
//!     return 1
//!   }
//!   if plaintext[0] != 104 {
//!     return 1
//!   }
//!   return match AesCcm.open(&key, &nonce, b"v2", &ciphertext, &tag, &mut plaintext) {
//!     Result<(), AesCcmError>.Failure { error: AesCcmError.AuthenticationFailed } => 0
//!     _ => 1
//!   }
//! }
//! ```
//!
//! @category Cryptography

import silk.text.format { Debug, Format, Formatter }
import silk.core.result { Result }
import silk.crypto.aes { Aes, AesError }
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silk.io.writer { Writer, WriterError }

/// The reason that [`AesCcm.seal`] or [`AesCcm.open`] rejected a call. The checks run in the order
/// of the variants, and the first failure is returned.
pub enum AesCcmError {
  /// The key is not 16, 24, or 32 bytes.
  InvalidKeyLength,
  /// The nonce is not 7 to 13 bytes.
  InvalidNonceLength,
  /// The tag is not 4, 6, 8, 10, 12, 14, or 16 bytes.
  InvalidTagLength,
  /// The output is shorter than the input message.
  OutputTooSmall,
  /// The message is too long for the length field that the nonce length leaves.
  LimitExceeded,
  /// The tag is not correct for the key, nonce, associated data, and ciphertext.
  AuthenticationFailed,
}

impl Debug for AesCcmError {
  /// Writes the name of the variant, such as `InvalidKeyLength`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      AesCcmError.InvalidKeyLength => run Format.write(&mut formatter, b"InvalidKeyLength")
      AesCcmError.InvalidNonceLength => run Format.write(&mut formatter, b"InvalidNonceLength")
      AesCcmError.InvalidTagLength => run Format.write(&mut formatter, b"InvalidTagLength")
      AesCcmError.OutputTooSmall => run Format.write(&mut formatter, b"OutputTooSmall")
      AesCcmError.LimitExceeded => run Format.write(&mut formatter, b"LimitExceeded")
      AesCcmError.AuthenticationFailed => run Format.write(&mut formatter, b"AuthenticationFailed")
    }
  }
}

/// Functions that encrypt and authenticate with AES-CCM (NIST SP 800-38C).
///
/// # Details
///
/// The key is 16, 24, or 32 bytes, the nonce 7 to 13 bytes, and the tag 4 to 16 bytes in steps of
/// two. The ciphertext has the same length as the plaintext. Nothing allocates. All checks come
/// before the first write.
///
/// # Gotchas
///
/// The same key and nonce must never encrypt two messages.
pub struct AesCcm {}

impl AesCcm {
  /// Encrypts `plaintext` into `ciphertext` and writes the tag to `tag`, whose length picks the tag
  /// length.
  ///
  /// # Errors
  ///
  /// - `InvalidKeyLength` if `key` is not 16, 24, or 32 bytes.
  /// - `InvalidNonceLength` if `nonce` is not 7 to 13 bytes.
  /// - `InvalidTagLength` if `tag` is not 4, 6, 8, 10, 12, 14, or 16 bytes.
  /// - `OutputTooSmall` if `ciphertext` is shorter than `plaintext`.
  /// - `LimitExceeded` if `plaintext` does not fit the length field.
  pub fn seal(key: &[u8], nonce: &[u8], aad: &[u8], plaintext: &[u8], ciphertext: &mut [u8], tag: &mut [u8]) -> Result<(), AesCcmError> {
    match move preflight(key, nonce, tag.length, ciphertext.length, plaintext.length) {
      Result<Aes, AesCcmError>.Failure { error } => { return Result<(), AesCcmError>.failResult(move error) }
      Result<Aes, AesCcmError>.Success { value } => {
        let cipher = move value
        let mac = authenticate(&cipher, nonce, aad, plaintext, tag.length, false)
        crypt(&cipher, nonce, plaintext, &mut ciphertext)
        let mask = cipher.encryptBlock(&counterBlock(nonce, 0))
        let mut index: usize = 0
        while index < tag.length {
          tag[index] = u8.bitXor(mac[index], mask[index])
          index = index + 1
        }
      }
    }
    return Result<(), AesCcmError>.succeed(())
  }

  /// Checks `tag`, and if it is correct, decrypts `ciphertext` into `plaintext`.
  ///
  /// The function checks the tag before it writes `plaintext`, so it runs the key stream twice.
  ///
  /// # Errors
  ///
  /// - `InvalidKeyLength` if `key` is not 16, 24, or 32 bytes.
  /// - `InvalidNonceLength` if `nonce` is not 7 to 13 bytes.
  /// - `InvalidTagLength` if `tag` is not 4, 6, 8, 10, 12, 14, or 16 bytes.
  /// - `OutputTooSmall` if `plaintext` is shorter than `ciphertext`.
  /// - `LimitExceeded` if `ciphertext` does not fit the length field.
  /// - `AuthenticationFailed` if the tag is not correct. `plaintext` does not change.
  pub fn open(key: &[u8], nonce: &[u8], aad: &[u8], ciphertext: &[u8], tag: &[u8], plaintext: &mut [u8]) -> Result<(), AesCcmError> {
    match move preflight(key, nonce, tag.length, plaintext.length, ciphertext.length) {
      Result<Aes, AesCcmError>.Failure { error } => { return Result<(), AesCcmError>.failResult(move error) }
      Result<Aes, AesCcmError>.Success { value } => {
        let cipher = move value
        let mac = authenticate(&cipher, nonce, aad, ciphertext, tag.length, true)
        let mask = cipher.encryptBlock(&counterBlock(nonce, 0))
        let mut difference: u32 = 0
        let mut index: usize = 0
        while index < tag.length {
          difference = u32.bitOr(difference, u8.toU32(u8.bitXor(u8.bitXor(mac[index], mask[index]), tag[index])))
          index = index + 1
        }
        if difference != 0 {
          return Result<(), AesCcmError>.failResult(AesCcmError.AuthenticationFailed)
        }
        crypt(&cipher, nonce, ciphertext, &mut plaintext)
      }
    }
    return Result<(), AesCcmError>.succeed(())
  }
}

fn preflight(key: &[u8], nonce: &[u8], tag: usize, capacity: usize, payload: usize) -> Result<Aes, AesCcmError> {
  if key.length != 16 && key.length != 24 && key.length != 32 {
    return Result<Aes, AesCcmError>.failResult(AesCcmError.InvalidKeyLength)
  }
  if nonce.length < 7 || nonce.length > 13 {
    return Result<Aes, AesCcmError>.failResult(AesCcmError.InvalidNonceLength)
  }
  if tag < 4 || tag > 16 || tag % 2 != 0 {
    return Result<Aes, AesCcmError>.failResult(AesCcmError.InvalidTagLength)
  }
  if capacity < payload {
    return Result<Aes, AesCcmError>.failResult(AesCcmError.OutputTooSmall)
  }
  let lengthBytes = 15 - nonce.length
  if lengthBytes < 8 && u64.shiftRight(usize.toU64(payload), usize.toU64(lengthBytes * 8)) != 0 {
    return Result<Aes, AesCcmError>.failResult(AesCcmError.LimitExceeded)
  }
  return match Aes.make(key) {
    Result<Aes, AesError>.Success { value } => Result<Aes, AesCcmError>.succeed(move value)
    Result<Aes, AesError>.Failure { error: _ } => Result<Aes, AesCcmError>.failResult(AesCcmError.InvalidKeyLength)
  }
}

// The counter block A_i: the flags byte L - 1, the nonce, and `index` in the last L bytes.
fn counterBlock(nonce: &[u8], index: u64) -> [u8; 16] {
  let lengthBytes = 15 - nonce.length
  let mut block: [u8; 16] = [0; 16]
  block[0] = usize.toU8(lengthBytes - 1)
  let mut position: usize = 0
  while position < nonce.length {
    block[1 + position] = nonce[position]
    position = position + 1
  }
  position = 0
  while position < lengthBytes && position < 8 {
    block[15 - position] = u64.toU8(u64.bitAnd(u64.shiftRight(index, usize.toU64(position * 8)), 255))
    position = position + 1
  }
  return block
}

// XORs `input` with the key stream that starts at counter 1.
fn crypt(cipher: &Aes, nonce: &[u8], input: &[u8], output: &mut [u8]) -> () {
  let mut offset: usize = 0
  let mut counter: u64 = 1
  while offset < input.length {
    let stream = cipher.encryptBlock(&counterBlock(nonce, counter))
    let mut index: usize = 0
    while index < 16 && offset + index < input.length {
      output[offset + index] = u8.bitXor(input[offset + index], stream[index])
      index = index + 1
    }
    offset = offset + 16
    counter = counter + 1
  }
}

// A CBC-MAC that takes bytes one at a time.
struct Mac {
  block: [u8; 16],
  used: usize,
}

fn macByte(cipher: &Aes, mac: &mut Mac, value: u8) -> () {
  mac.block[mac.used] = u8.bitXor(mac.block[mac.used], value)
  mac.used = mac.used + 1
  if mac.used == 16 {
    mac.block = cipher.encryptBlock(&mac.block)
    mac.used = 0
  }
}

// Ends a field: zero padding up to the block boundary is a no-op for the XOR, so only an open
// block needs its encryption.
fn macPad(cipher: &Aes, mac: &mut Mac) -> () {
  if mac.used != 0 {
    mac.block = cipher.encryptBlock(&mac.block)
    mac.used = 0
  }
}

// Returns the CBC-MAC of the formatted input. With `decrypting`, `text` is the ciphertext, and each
// block is decrypted on the fly so no plaintext is written before the tag is checked.
fn authenticate(cipher: &Aes, nonce: &[u8], aad: &[u8], text: &[u8], tagLength: usize, decrypting: bool) -> [u8; 16] {
  let lengthBytes = 15 - nonce.length
  let mut flags = usize.toU8(lengthBytes - 1 + ((tagLength - 2) / 2) * 8)
  if aad.length > 0 {
    flags = u8.bitOr(flags, 64)
  }
  let mut first: [u8; 16] = counterBlock(nonce, usize.toU64(text.length))
  first[0] = flags
  let mut mac = Mac { block: cipher.encryptBlock(&first), used: 0 }
  if aad.length > 0 {
    let length = usize.toU64(aad.length)
    if length < 65280 {
      macByte(cipher, &mut mac, u64.toU8(u64.shiftRight(length, 8)))
      macByte(cipher, &mut mac, u64.toU8(u64.bitAnd(length, 255)))
    } else if length <= 4294967295 {
      macByte(cipher, &mut mac, 255)
      macByte(cipher, &mut mac, 254)
      let mut shift: u64 = 32
      while shift > 0 {
        shift = shift - 8
        macByte(cipher, &mut mac, u64.toU8(u64.bitAnd(u64.shiftRight(length, shift), 255)))
      }
    } else {
      macByte(cipher, &mut mac, 255)
      macByte(cipher, &mut mac, 255)
      let mut shift: u64 = 64
      while shift > 0 {
        shift = shift - 8
        macByte(cipher, &mut mac, u64.toU8(u64.bitAnd(u64.shiftRight(length, shift), 255)))
      }
    }
    let mut index: usize = 0
    while index < aad.length {
      macByte(cipher, &mut mac, aad[index])
      index = index + 1
    }
    macPad(cipher, &mut mac)
  }
  let mut offset: usize = 0
  let mut counter: u64 = 1
  while offset < text.length {
    let mut stream: [u8; 16] = [0; 16]
    if decrypting {
      stream = cipher.encryptBlock(&counterBlock(nonce, counter))
    }
    let mut index: usize = 0
    while index < 16 && offset + index < text.length {
      macByte(cipher, &mut mac, u8.bitXor(text[offset + index], stream[index]))
      index = index + 1
    }
    offset = offset + 16
    counter = counter + 1
  }
  macPad(cipher, &mut mac)
  return mac.block
}
