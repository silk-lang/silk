//! Constant-time arithmetic on unsigned integers of up to 8192 bits, and modulo an odd number.
//!
//! # When to use
//! Use it to build public-key cryptography that works on large numbers, such as RSA and finite
//! field Diffie-Hellman. `silk.crypto.rsa` uses it. For a fixed curve, use that curve's module,
//! such as `silk.crypto.p256`, which is faster.
//!
//! # Details
//! A [`Natural`] holds a value below 2^8192 in 32-bit words. It also has a length in words, which
//! [`Natural.fromBytes`] takes from the number of input bytes, not from the value. A [`Modulus`]
//! holds an odd number of 3 or more and the constants for Montgomery multiplication modulo it.
//!
//! Every operation takes the same time for all values of the same lengths: it has no branch and
//! no memory access that depends on a value. The time depends only on the word lengths of the
//! inputs and the bit length of the modulus. [`Modulus.powerPublic`] is the one exception: its
//! time depends on the exponent, so use it only for a public exponent.
//!
//! # Errors
//! - [`ModularError`] for a value that does not fit, a subtraction below zero, or a modulus that is
//!   even or below 3.
//!
//! # Gotchas
//! The operations of a [`Modulus`] need inputs that are less than the modulus. Reduce a value with
//! [`Modulus.reduce`] first if it may be larger. The values stay in memory after use; nothing
//! erases them.
//!
//! # Examples
//! ## Compute a power modulo a prime
//! ```silk
//! import silk.core.ownership { Copy }
import silk.core.result { Result }
//! import silk.crypto.modular { ModularError, Modulus, Natural }
//!
//! pub fn main() -> i32 {
//!   let modulus = match Modulus.make(&Natural.fromU64(1000003)) {
//!     Result<Modulus, ModularError>.Success { value } => move value
//!     Result<Modulus, ModularError>.Failure { error: _ } => {
//!       return 1
//!     }
//!   }
//!   // 2^1000002 is 1 modulo the prime 1000003.
//!   let result = modulus.power(&Natural.fromU64(2), &Natural.fromU64(1000002))
//!   let mut bytes: [u8; 4] = [0; 4]
//!   match result.writeBytes(&mut bytes) {
//!     Result<(), ModularError>.Success { value: _ } => {}
//!     Result<(), ModularError>.Failure { error: _ } => {
//!       return 2
//!     }
//!   }
//!   if bytes[0] != 0 || bytes[1] != 0 || bytes[2] != 0 || bytes[3] != 1 {
//!     return 3
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Cryptography
import silk.text.format { Debug, Format, Formatter }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silk.io.writer { Writer, WriterError }

/// The number of 32-bit words in a [`Natural`]: 256 words hold 8192 bits.
pub const NATURAL_WORDS: usize = 256

/// The reason that a modular operation failed.
pub enum ModularError {
  /// A value does not fit in 8192 bits, or in the output.
  TooLarge,
  /// A subtraction would give a value below zero.
  Negative,
  /// A modulus is even or below 3.
  InvalidModulus,
}

impl Debug for ModularError {
  /// Writes the name of the variant, such as `TooLarge`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return match &self.* {
      ModularError.TooLarge => run Format.write(&mut formatter, b"TooLarge")
      ModularError.Negative => run Format.write(&mut formatter, b"Negative")
      ModularError.InvalidModulus => run Format.write(&mut formatter, b"InvalidModulus")
    }
  }
}

/// An unsigned integer below 2^8192 with a length in 32-bit words.
///
/// # When to use
/// Use it for the values of public-key cryptography: keys, messages, and signatures as numbers.
///
/// # Details
/// The length sets how many words the operations read, and so how long they take. It comes from
/// the size of the input, not from the value: [`Natural.fromBytes`] with 256 bytes gives 64 words
/// even when the value is small. Results of arithmetic have the length that holds any result of
/// inputs of those lengths.
///
/// # Gotchas
/// It is a fixed-size value of about 1 KiB. Pass it by reference.
pub struct Natural {
  words: [u32; 256],
  length: usize,
}

impl Copy for Natural {}

/// An odd modulus of 3 or more, with the constants for Montgomery multiplication modulo it.
///
/// # When to use
/// Make one with [`Modulus.make`] for each modulus, such as an RSA modulus, an RSA prime, or a
/// Diffie-Hellman prime, and keep it for all the operations with that modulus.
///
/// # Details
/// Making a modulus of `k` words computes 2^(64 * `k`) modulo it, which takes about as long as
/// two multiplications of `k`-word numbers per bit of the modulus. The operations then take
/// inputs below the modulus and return results below it, with the word length of the modulus.
///
/// # Gotchas
/// It is a fixed-size value of about 2 KiB. Pass it by reference.
pub struct Modulus {
  value: Natural,
  squared: Natural,
  inverse: u32,
  bits: usize,
}

impl Copy for Modulus {}

fn low(value: u64) -> u32 {
  return u64.toU32(u64.bitAnd(value, 4294967295))
}

fn high(value: u64) -> u64 {
  return u64.shiftRight(value, 32)
}

fn maskOf(bit: u32) -> u32 {
  return u32.wrappingSubtract(0, bit)
}

fn nonzeroBit(value: u32) -> u32 {
  return u32.shiftRight(u32.bitOr(value, u32.wrappingSubtract(0, value)), 31)
}

fn zeroNatural(length: usize) -> Natural {
  return Natural { words: [0; 256], length: length }
}

fn largerLength(left: &Natural, right: &Natural) -> usize {
  if left.length > right.length {
    return left.length
  }
  return right.length
}

// Returns 1 when left < right over the first `length` words.
fn belowBit(left: &Natural, right: &Natural, length: usize) -> u32 {
  let mut borrow: u64 = 0
  let mut i: usize = 0
  while i < length {
    let difference = u64.wrappingSubtract(
      u64.wrappingSubtract(u32.toU64(left.words[i]), u32.toU64(right.words[i])),
      borrow,
    )
    borrow = u64.shiftRight(difference, 63)
    i = i + 1
  }
  return u64.toU32(borrow)
}

// Subtracts `modulus` from the first `length` words of `value` when `bit` is 1, dropping the
// final borrow.
fn subtractMasked(value: &mut Natural, modulus: &Natural, length: usize, bit: u32) -> () {
  let mask = maskOf(bit)
  let mut borrow: u64 = 0
  let mut i: usize = 0
  while i < length {
    let difference = u64.wrappingSubtract(
      u64.wrappingSubtract(
        u32.toU64(value.words[i]),
        u32.toU64(u32.bitAnd(modulus.words[i], mask)),
      ),
      borrow,
    )
    value.words[i] = low(difference)
    borrow = u64.shiftRight(difference, 63)
    i = i + 1
  }
}

// Adds `modulus` to the first `length` words of `value` when `bit` is 1, dropping the final
// carry.
fn addMasked(value: &mut Natural, modulus: &Natural, length: usize, bit: u32) -> () {
  let mask = maskOf(bit)
  let mut carry: u64 = 0
  let mut i: usize = 0
  while i < length {
    let sum = u64.wrappingAdd(
      u64.wrappingAdd(u32.toU64(value.words[i]), u32.toU64(u32.bitAnd(modulus.words[i], mask))),
      carry,
    )
    value.words[i] = low(sum)
    carry = high(sum)
    i = i + 1
  }
}

// `value` has `length` words and an extra top bit `extra`, and is below twice the modulus.
// Subtracts the modulus once if the value is not below it.
fn reduceOnce(value: &mut Natural, modulus: &Natural, length: usize, extra: u32) -> () {
  let below = belowBit(&value.*, modulus, length)
  let subtract = u32.bitOr(extra, u32.bitXor(below, 1))
  subtractMasked(&mut value, modulus, length, subtract)
}

fn shiftInBit(value: &mut Natural, bit: u32, modulus: &Natural, length: usize) -> () {
  let mut carry = bit
  let mut i: usize = 0
  while i < length {
    let word = value.words[i]
    value.words[i] = u32.bitOr(u32.shiftLeft(word, 1), carry)
    carry = u32.shiftRight(word, 31)
    i = i + 1
  }
  reduceOnce(&mut value, modulus, length, carry)
}

struct WordStep {
  quotient: u32,
  remainder: u32,
}

fn wordReciprocal(divisor: u32) -> u64 {
  if divisor == 0 {
    Intrinsic.trap("division by zero")
  }
  return u64.MAX / u32.toU64(divisor)
}

// Divides remainder * 2^32 + word by the divisor, for remainder below it. The reciprocal is
// floor((2^64 - 1) / divisor), so the estimate is at most one below the quotient.
fn divideStep(remainder: u64, word: u32, divisor: u32, reciprocal: u64) -> WordStep {
  let value = u64.bitOr(u64.shiftLeft(remainder, 32), u32.toU64(word))
  let estimate = u64.multiplyHigh(value, reciprocal)
  let rest = u64.wrappingSubtract(value, u64.wrappingMultiply(estimate, u32.toU64(divisor)))
  let over = u64.bitXor(u64.shiftRight(u64.wrappingSubtract(rest, u32.toU64(divisor)), 63), 1)
  return WordStep {
    quotient: u64.toU32(u64.wrappingAdd(estimate, over)),
    remainder: u64.toU32(
      u64.wrappingSubtract(rest, u64.bitAnd(u32.toU64(divisor), u64.wrappingSubtract(0, over))),
    ),
  }
}

impl Natural {
  /// Returns 0 with a length of 0 words.
  pub fn zero() -> Natural {
    return zeroNatural(0)
  }

  /// Returns `value` with a length of 2 words.
  pub fn fromU64(value: u64) -> Natural {
    let mut result = zeroNatural(2)
    result.words[0] = low(value)
    result.words[1] = u64.toU32(high(value))
    return result
  }

  /// Returns the big-endian `bytes` as a number with a length of `bytes.length / 4` words,
  /// rounded up.
  ///
  /// Leading zero bytes are allowed. The time depends only on `bytes.length`.
  ///
  /// # Errors
  /// - `TooLarge` if the value is 2^8192 or more.
  pub fn fromBytes(bytes: &[u8]) -> Result<Natural, ModularError> {
    let mut overflow: u32 = 0
    let mut used = bytes.length
    if used > 1024 {
      let mut i: usize = 0
      while i < bytes.length - 1024 {
        overflow = u32.bitOr(overflow, u8.toU32(bytes[i]))
        i = i + 1
      }
      used = 1024
    }
    if overflow != 0 {
      return Result<Natural, ModularError>.failResult(ModularError.TooLarge)
    }
    let mut result = zeroNatural((used + 3) / 4)
    let mut i: usize = 0
    while i < used {
      let byte = u8.toU32(bytes[bytes.length - 1 - i])
      result.words[i / 4] = u32.bitOr(
        result.words[i / 4],
        u32.shiftLeft(byte, usize.toU32(8 * (i % 4))),
      )
      i = i + 1
    }
    return Result<Natural, ModularError>.succeed(result)
  }

  /// Writes the value big-endian to all of `output`, with leading zero bytes as needed.
  ///
  /// The time depends only on `output.length` and the length of the value.
  ///
  /// # Errors
  /// - `TooLarge` if the value does not fit in `output.length` bytes. `output` may then hold part
  ///   of the value.
  pub fn writeBytes(self: &Natural, output: &mut [u8]) -> Result<(), ModularError> {
    let mut overflow: u32 = 0
    let mut i: usize = 0
    while i < self.length * 4 {
      let byte = u32.bitAnd(u32.shiftRight(self.words[i / 4], usize.toU32(8 * (i % 4))), 255)
      if i < output.length {
        output[output.length - 1 - i] = u32.toU8(byte)
      } else {
        overflow = u32.bitOr(overflow, byte)
      }
      i = i + 1
    }
    while i < output.length {
      output[output.length - 1 - i] = 0
      i = i + 1
    }
    if overflow != 0 {
      return Result<(), ModularError>.failResult(ModularError.TooLarge)
    }
    return Result<(), ModularError>.succeed(())
  }

  /// Returns the length in 32-bit words, which sets the time of the operations.
  pub fn wordLength(self: &Natural) -> usize {
    return self.length
  }

  /// Returns the number of significant bits: 0 for 0, and `n` for a value from 2^(`n` - 1) to
  /// 2^`n` - 1. The time depends only on the length.
  pub fn bitLength(self: &Natural) -> usize {
    let mut result: u32 = 0
    let mut i: usize = 0
    while i < self.length {
      let word = self.words[i]
      let candidate = usize.toU32(32 * i) + 32 - u32.leadingZeros(word)
      let mask = maskOf(nonzeroBit(word))
      result = u32.bitXor(result, u32.bitAnd(mask, u32.bitXor(result, candidate)))
      i = i + 1
    }
    return u32.toUsize(result)
  }

  /// Returns bit `index`, counted from the least significant bit, as 0 or 1. Bits at or above
  /// the length are 0.
  pub fn bit(self: &Natural, index: usize) -> u32 {
    if index >= self.length * 32 {
      return 0
    }
    return u32.bitAnd(u32.shiftRight(self.words[index / 32], usize.toU32(index % 32)), 1)
  }

  /// Returns whether the value is 0. The time depends only on the length.
  pub fn isZero(self: &Natural) -> bool {
    let mut combined: u32 = 0
    let mut i: usize = 0
    while i < self.length {
      combined = u32.bitOr(combined, self.words[i])
      i = i + 1
    }
    return nonzeroBit(combined) == 0
  }

  /// Returns whether the two values are equal. The time depends only on the lengths.
  pub fn equals(self: &Natural, other: &Natural) -> bool {
    let length = largerLength(self, other)
    let mut combined: u32 = 0
    let mut i: usize = 0
    while i < length {
      combined = u32.bitOr(combined, u32.bitXor(self.words[i], other.words[i]))
      i = i + 1
    }
    return nonzeroBit(combined) == 0
  }

  /// Returns whether this value is less than `other`. The time depends only on the lengths.
  pub fn lessThan(self: &Natural, other: &Natural) -> bool {
    return belowBit(self, other, largerLength(self, other)) == 1
  }

  /// Returns the value with a length of `length` words.
  ///
  /// # Errors
  /// - `TooLarge` if `length` is above 256 or the value does not fit in `length` words.
  pub fn resize(self: &Natural, length: usize) -> Result<Natural, ModularError> {
    if length > NATURAL_WORDS {
      return Result<Natural, ModularError>.failResult(ModularError.TooLarge)
    }
    let mut overflow: u32 = 0
    let mut result = zeroNatural(length)
    let mut i: usize = 0
    while i < self.length {
      if i < length {
        result.words[i] = self.words[i]
      } else {
        overflow = u32.bitOr(overflow, self.words[i])
      }
      i = i + 1
    }
    if overflow != 0 {
      return Result<Natural, ModularError>.failResult(ModularError.TooLarge)
    }
    return Result<Natural, ModularError>.succeed(result)
  }

  /// Returns the value divided by 2^`count`, rounded down, with the same length. The time
  /// depends only on `count` and the length.
  pub fn shiftRight(self: &Natural, count: usize) -> Natural {
    let mut result = zeroNatural(self.length)
    let wordShift = count / 32
    let bitShift = usize.toU32(count % 32)
    let mut i: usize = 0
    while i + wordShift < self.length {
      let source = i + wordShift
      let mut word = u32.shiftRight(self.words[source], bitShift)
      if bitShift != 0 && source + 1 < self.length {
        word = u32.bitOr(word, u32.shiftLeft(self.words[source + 1], 32 - bitShift))
      }
      result.words[i] = word
      i = i + 1
    }
    return result
  }

  /// Returns the value divided by `divisor`, rounded down, with the same length. The time
  /// depends only on the length.
  ///
  /// # Gotchas
  /// The program traps if `divisor` is 0.
  pub fn divideWord(self: &Natural, divisor: u32) -> Natural {
    let mut result = zeroNatural(self.length)
    let reciprocal = wordReciprocal(divisor)
    let mut remainder: u64 = 0
    let mut i = self.length
    while i > 0 {
      i = i - 1
      let step = divideStep(remainder, self.words[i], divisor, reciprocal)
      result.words[i] = step.quotient
      remainder = u32.toU64(step.remainder)
    }
    return result
  }

  /// Returns the remainder of the value divided by `divisor`. The time depends only on the
  /// length.
  ///
  /// # Gotchas
  /// The program traps if `divisor` is 0.
  pub fn remainderWord(self: &Natural, divisor: u32) -> u32 {
    let reciprocal = wordReciprocal(divisor)
    let mut remainder: u64 = 0
    let mut i = self.length
    while i > 0 {
      i = i - 1
      let step = divideStep(remainder, self.words[i], divisor, reciprocal)
      remainder = u32.toU64(step.remainder)
    }
    return u64.toU32(remainder)
  }

  /// Returns the sum, with a length of one word more than the longer input, up to 256 words.
  ///
  /// # Errors
  /// - `TooLarge` if the sum is 2^8192 or more.
  pub fn add(self: &Natural, other: &Natural) -> Result<Natural, ModularError> {
    let length = largerLength(self, other)
    let mut result = zeroNatural(length)
    let mut carry: u64 = 0
    let mut i: usize = 0
    while i < length {
      let sum = u64.wrappingAdd(
        u64.wrappingAdd(u32.toU64(self.words[i]), u32.toU64(other.words[i])),
        carry,
      )
      result.words[i] = low(sum)
      carry = high(sum)
      i = i + 1
    }
    if length < NATURAL_WORDS {
      result.words[length] = u64.toU32(carry)
      result.length = length + 1
    } else {
      if carry != 0 {
        return Result<Natural, ModularError>.failResult(ModularError.TooLarge)
      }
    }
    return Result<Natural, ModularError>.succeed(result)
  }

  /// Returns this value minus `other`, with the length of the longer input.
  ///
  /// # Errors
  /// - `Negative` if `other` is larger.
  pub fn subtract(self: &Natural, other: &Natural) -> Result<Natural, ModularError> {
    let length = largerLength(self, other)
    let mut result = zeroNatural(length)
    let mut borrow: u64 = 0
    let mut i: usize = 0
    while i < length {
      let difference = u64.wrappingSubtract(
        u64.wrappingSubtract(u32.toU64(self.words[i]), u32.toU64(other.words[i])),
        borrow,
      )
      result.words[i] = low(difference)
      borrow = u64.shiftRight(difference, 63)
      i = i + 1
    }
    if borrow != 0 {
      return Result<Natural, ModularError>.failResult(ModularError.Negative)
    }
    return Result<Natural, ModularError>.succeed(result)
  }

  /// Returns the product, with the sum of the input lengths, up to 256 words.
  ///
  /// # Errors
  /// - `TooLarge` if the product is 2^8192 or more.
  pub fn multiply(self: &Natural, other: &Natural) -> Result<Natural, ModularError> {
    let mut product: [u32; 512] = [0; 512]
    let mut i: usize = 0
    while i < self.length {
      let factor = u32.toU64(self.words[i])
      let mut carry: u64 = 0
      let mut j: usize = 0
      while j < other.length {
        let sum = u64.wrappingAdd(
          u64.wrappingAdd(
            u64.wrappingMultiply(factor, u32.toU64(other.words[j])),
            u32.toU64(product[i + j]),
          ),
          carry,
        )
        product[i + j] = low(sum)
        carry = high(sum)
        j = j + 1
      }
      product[i + other.length] = u64.toU32(carry)
      i = i + 1
    }
    let length = self.length + other.length
    let mut overflow: u32 = 0
    i = NATURAL_WORDS
    while i < length {
      overflow = u32.bitOr(overflow, product[i])
      i = i + 1
    }
    if overflow != 0 {
      return Result<Natural, ModularError>.failResult(ModularError.TooLarge)
    }
    let mut kept = length
    if kept > NATURAL_WORDS {
      kept = NATURAL_WORDS
    }
    let mut result = zeroNatural(kept)
    i = 0
    while i < result.length {
      result.words[i] = product[i]
      i = i + 1
    }
    return Result<Natural, ModularError>.succeed(result)
  }
}

// Returns left * right / 2^(32k) modulo the modulus, for left and right below it.
fn montgomery(left: &Natural, right: &Natural, modulus: &Modulus) -> Natural {
  let length = modulus.value.length
  let mut t: [u32; 258] = [0; 258]
  let mut i: usize = 0
  while i < length {
    let factor = u32.toU64(left.words[i])
    let mut carry: u64 = 0
    let mut j: usize = 0
    while j < length {
      // A product of two words plus two words fits in 64 bits.
      let sum = u64.wrappingAdd(
        u64.wrappingAdd(u64.wrappingMultiply(factor, u32.toU64(right.words[j])), u32.toU64(t[j])),
        carry,
      )
      t[j] = low(sum)
      carry = high(sum)
      j = j + 1
    }
    let top = u64.wrappingAdd(u32.toU64(t[length]), carry)
    t[length] = low(top)
    t[length + 1] = u64.toU32(high(top))
    let reducer = u32.toU64(u32.wrappingMultiply(t[0], modulus.inverse))
    let first = u64.wrappingAdd(
      u64.wrappingMultiply(reducer, u32.toU64(modulus.value.words[0])),
      u32.toU64(t[0]),
    )
    carry = high(first)
    j = 1
    while j < length {
      let sum = u64.wrappingAdd(
        u64.wrappingAdd(
          u64.wrappingMultiply(reducer, u32.toU64(modulus.value.words[j])),
          u32.toU64(t[j]),
        ),
        carry,
      )
      t[j - 1] = low(sum)
      carry = high(sum)
      j = j + 1
    }
    let last = u64.wrappingAdd(u32.toU64(t[length]), carry)
    t[length - 1] = low(last)
    t[length] = u32.wrappingAdd(t[length + 1], u64.toU32(high(last)))
    t[length + 1] = 0
    i = i + 1
  }
  let mut result = zeroNatural(length)
  i = 0
  while i < length {
    result.words[i] = t[i]
    i = i + 1
  }
  reduceOnce(&mut result, &modulus.value, length, t[length])
  return result
}

fn storeEntry(table: &mut [u32; 4096], index: usize, value: &Natural, length: usize) -> () {
  let mut i: usize = 0
  while i < length {
    table[index * 256 + i] = value.words[i]
    i = i + 1
  }
}

// Reads entry `digit` of the table, touching every entry.
fn loadEntry(table: &[u32; 4096], digit: u32, length: usize) -> Natural {
  let mut result = zeroNatural(length)
  let mut index: u32 = 0
  while index < 16 {
    let mask = maskOf(u32.bitXor(nonzeroBit(u32.bitXor(index, digit)), 1))
    let base = u32.toUsize(index) * 256
    let mut i: usize = 0
    while i < length {
      result.words[i] = u32.bitOr(result.words[i], u32.bitAnd(table[base + i], mask))
      i = i + 1
    }
    index = index + 1
  }
  return result
}

impl Modulus {
  /// Returns the modulus `value`, which must be odd and 3 or more.
  ///
  /// The word length of the modulus is that of its value without leading zero words, so the time
  /// of this call and of later operations depends on the bit length of the value, but not on its
  /// other bits.
  ///
  /// # Errors
  /// - `InvalidModulus` if `value` is even or below 3.
  pub fn make(value: &Natural) -> Result<Modulus, ModularError> {
    let mut length = value.length
    while length > 0 && value.words[length - 1] == 0 {
      length = length - 1
    }
    if length == 0 || u32.bitAnd(value.words[0], 1) == 0 || (length == 1 && value.words[0] < 3) {
      return Result<Modulus, ModularError>.failResult(ModularError.InvalidModulus)
    }
    let mut normalized = zeroNatural(length)
    let mut i: usize = 0
    while i < length {
      normalized.words[i] = value.words[i]
      i = i + 1
    }

    // Newton's iteration doubles the correct low bits of the inverse: 3, 6, 12, 24, 48.
    let first = normalized.words[0]
    let mut inverse = first
    i = 0
    while i < 4 {
      inverse = u32.wrappingMultiply(
        inverse,
        u32.wrappingSubtract(2, u32.wrappingMultiply(first, inverse)),
      )
      i = i + 1
    }

    // 2^(64k) modulo the modulus, one doubling at a time from 1.
    let mut squared = zeroNatural(length)
    squared.words[0] = 1
    i = 0
    while i < 64 * length {
      shiftInBit(&mut squared, 0, &normalized, length)
      i = i + 1
    }
    let bits = normalized.bitLength()
    return Result<Modulus, ModularError>.succeed(
      Modulus {
        value: normalized,
        squared: squared,
        inverse: u32.wrappingSubtract(0, inverse),
        bits: bits,
      },
    )
  }

  /// Returns a copy of the modulus as a number, with the word length of the modulus.
  pub fn natural(self: &Modulus) -> Natural {
    return self.value
  }

  /// Returns the number of significant bits of the modulus.
  pub fn bitLength(self: &Modulus) -> usize {
    return self.bits
  }

  /// Returns the word length of the modulus and of the results of its operations.
  pub fn wordLength(self: &Modulus) -> usize {
    return self.value.length
  }

  /// Returns `value` modulo the modulus, for any value. The time depends on the length of `value`.
  pub fn reduce(self: &Modulus, value: &Natural) -> Natural {
    let length = self.value.length
    let mut result = zeroNatural(length)
    let mut index = value.length * 32
    while index > 0 {
      index = index - 1
      shiftInBit(&mut result, value.bit(index), &self.value, length)
    }
    return result
  }

  /// Returns `left` + `right` modulo the modulus. Both must be less than the modulus.
  pub fn add(self: &Modulus, left: &Natural, right: &Natural) -> Natural {
    let length = self.value.length
    let mut result = zeroNatural(length)
    let mut carry: u64 = 0
    let mut i: usize = 0
    while i < length {
      let sum = u64.wrappingAdd(
        u64.wrappingAdd(u32.toU64(left.words[i]), u32.toU64(right.words[i])),
        carry,
      )
      result.words[i] = low(sum)
      carry = high(sum)
      i = i + 1
    }
    reduceOnce(&mut result, &self.value, length, u64.toU32(carry))
    return result
  }

  /// Returns `left` - `right` modulo the modulus. Both must be less than the modulus.
  pub fn subtract(self: &Modulus, left: &Natural, right: &Natural) -> Natural {
    let length = self.value.length
    let mut result = zeroNatural(length)
    let mut borrow: u64 = 0
    let mut i: usize = 0
    while i < length {
      let difference = u64.wrappingSubtract(
        u64.wrappingSubtract(u32.toU64(left.words[i]), u32.toU64(right.words[i])),
        borrow,
      )
      result.words[i] = low(difference)
      borrow = u64.shiftRight(difference, 63)
      i = i + 1
    }
    addMasked(&mut result, &self.value, length, u64.toU32(borrow))
    return result
  }

  /// Returns `left` * `right` modulo the modulus. Both must be less than the modulus.
  pub fn multiply(self: &Modulus, left: &Natural, right: &Natural) -> Natural {
    let product = montgomery(left, right, self)
    return montgomery(&product, &self.squared, self)
  }

  /// Returns `base` to the power `exponent` modulo the modulus. `base` must be less than the
  /// modulus; `exponent` can be any value.
  ///
  /// The time depends only on the bit length of the modulus and the length of `exponent`, so the
  /// base and the exponent can be secret. A zero exponent gives 1.
  pub fn power(self: &Modulus, base: &Natural, exponent: &Natural) -> Natural {
    let length = self.value.length
    let one = Natural.fromU64(1)
    let mut table: [u32; 4096] = [0; 4096]
    let unit = montgomery(&one, &self.squared, self)
    storeEntry(&mut table, 0, &unit, length)
    let factor = montgomery(base, &self.squared, self)
    storeEntry(&mut table, 1, &factor, length)
    let mut previous = factor
    let mut index: usize = 2
    while index < 16 {
      let next = montgomery(&previous, &factor, self)
      storeEntry(&mut table, index, &next, length)
      previous = next
      index = index + 1
    }
    let mut accumulator = unit
    let mut word = exponent.length
    while word > 0 {
      word = word - 1
      let bits = exponent.words[word]
      let mut digit: usize = 8
      while digit > 0 {
        digit = digit - 1
        let mut square: usize = 0
        while square < 4 {
          accumulator = montgomery(&accumulator, &accumulator, self)
          square = square + 1
        }
        let entry = loadEntry(
          &table,
          u32.bitAnd(u32.shiftRight(bits, usize.toU32(4 * digit)), 15),
          length,
        )
        accumulator = montgomery(&accumulator, &entry, self)
      }
    }
    return montgomery(&accumulator, &one, self)
  }

  /// Returns `base` to the power `exponent` modulo the modulus, faster than [`Modulus.power`]
  /// for a short exponent. `base` must be less than the modulus.
  ///
  /// # Gotchas
  /// Its time depends on the bits of `exponent`, so use it only for a public exponent, such as an
  /// RSA public exponent. The time does not depend on `base`.
  pub fn powerPublic(self: &Modulus, base: &Natural, exponent: &Natural) -> Natural {
    let one = Natural.fromU64(1)
    let factor = montgomery(base, &self.squared, self)
    let mut accumulator = montgomery(&one, &self.squared, self)
    let mut index = exponent.bitLength()
    while index > 0 {
      index = index - 1
      accumulator = montgomery(&accumulator, &accumulator, self)
      if exponent.bit(index) == 1 {
        accumulator = montgomery(&accumulator, &factor, self)
      }
    }
    return montgomery(&accumulator, &one, self)
  }

  /// Returns the inverse of `value` modulo the modulus, which must be prime: the number that
  /// gives 1 when multiplied by `value`. `value` must be less than the modulus. 0 gives 0.
  ///
  /// It computes `value` to the power modulus - 2, in the time of [`Modulus.power`].
  pub fn invertPrime(self: &Modulus, value: &Natural) -> Natural {
    let mut exponent = self.value
    let length = exponent.length
    subtractMasked(&mut exponent, &Natural.fromU64(2), length, 1)
    return self.power(value, &exponent)
  }
}
