// The key schedule constants CK1, CK2, and CK3, high half first.
const CONSTANTS: [u64; 6] = [
  0x517cc1b727220a94,
  0xfe13abe8fa9a6ee0,
  0x6db14acc9e21c820,
  0xff28b1d5ef5de2b0,
  0xdb92371d2126e970,
  0x0324977504e8c90e,
]

/// An ARIA key schedule.
///
/// # Details
///
/// Make one with [`Aria.make`] and run it in a mode from `silk.crypto.block_cipher`, or call
/// `encryptBlock` and `decryptBlock` of `BlockCipher` on one 16-byte block.
pub struct Aria {
  encryption: [[u8; 16]; 17],
  decryption: [[u8; 16]; 17],
  rounds: usize,
}

impl Aria {
  /// Returns the key schedule of `key`, which is 16, 24, or 32 bytes.
  ///
  /// # Errors
  ///
  /// - `InvalidKeyLength` if `key` is not 16, 24, or 32 bytes.
  pub fn make(key: &[u8]) -> Result<Aria, BlockCipherError> {
    if key.length != 16 && key.length != 24 && key.length != 32 {
      return Result<Aria, BlockCipherError>.failResult(BlockCipherError.InvalidKeyLength)
    }
    let rounds = 12 + (key.length - 16) / 4
    let mut left: [u8; 16] = [0; 16]
    let mut right: [u8; 16] = [0; 16]
    let mut index: usize = 0
    while index < 16 {
      left[index] = key[index]
      if 16 + index < key.length {
        right[index] = key[16 + index]
      }
      index = index + 1
    }
    // The constants start at CK1, CK2, or CK3 for a 16, 24, or 32-byte key.
    let first = (key.length - 16) / 8
    let w0 = left
    let w1 = xor(&odd(&w0, &constant(first)), &right)
    let w2 = xor(&even(&w1, &constant((first + 1) % 3)), &w0)
    let w3 = xor(&odd(&w2, &constant((first + 2) % 3)), &w1)
    let words: [[u8; 16]; 4] = [w0, w1, w2, w3]
    let mut encryption: [[u8; 16]; 17] = [[0; 16]; 17]
    // ek1 to ek4 rotate right by 19, ek5 to ek8 by 31, then left by 61, 31, and 19.
    let shifts: [usize; 5] = [128 - 19, 128 - 31, 61, 31, 19]
    let mut slot: usize = 0
    while slot <= rounds {
      let word = slot % 4
      encryption[slot] = xor(&words[word], &rotateLeft(&words[(word + 1) % 4], shifts[slot / 4]))
      slot = slot + 1
    }
    // Decryption: the keys in reverse order, with the diffusion layer applied to the inner ones.
    let mut decryption: [[u8; 16]; 17] = [[0; 16]; 17]
    decryption[0] = encryption[rounds]
    slot = 1
    while slot < rounds {
      decryption[slot] = diffuse(&encryption[rounds - slot])
      slot = slot + 1
    }
    decryption[rounds] = encryption[0]
    return Result<Aria, BlockCipherError>.succeed(Aria { encryption: encryption, decryption: decryption, rounds: rounds })
  }
}

impl BlockCipher for Aria {
  /// Returns 16.
  fn blockLength(self: &Self) -> usize {
    return 16
  }

  /// Encrypts the 16 bytes of `block` in place.
  fn encryptBlock(self: &Self, block: &mut [u8; 16]) -> () {
    block.* = crypt(&self.encryption, self.rounds, &block.*)
  }

  /// Decrypts the 16 bytes of `block` in place.
  fn decryptBlock(self: &Self, block: &mut [u8; 16]) -> () {
    block.* = crypt(&self.decryption, self.rounds, &block.*)
  }
}

fn constant(index: usize) -> [u8; 16] {
  let mut result: [u8; 16] = [0; 16]
  let mut byte: usize = 0
  while byte < 16 {
    let word = CONSTANTS[2 * index + byte / 8]
    result[byte] = u64.toU8(u64.bitAnd(u64.shiftRight(word, usize.toU64(56 - 8 * (byte % 8))), 255))
    byte = byte + 1
  }
  return result
}

fn xor(left: &[u8; 16], right: &[u8; 16]) -> [u8; 16] {
  let mut result: [u8; 16] = [0; 16]
  let mut index: usize = 0
  while index < 16 {
    result[index] = u8.bitXor(left[index], right[index])
    index = index + 1
  }
  return result
}

// `value` as a 128-bit big-endian number rotated left by `count` bits, 0 < `count` < 128.
fn rotateLeft(value: &[u8; 16], count: usize) -> [u8; 16] {
  let bytes = count / 8
  let bits = usize.toU8(count % 8)
  let mut result: [u8; 16] = [0; 16]
  let mut index: usize = 0
  while index < 16 {
    let high = value[(index + bytes) % 16]
    let low = value[(index + bytes + 1) % 16]
    if bits == 0 {
      result[index] = high
    } else {
      result[index] = u8.bitOr(u8.shiftLeft(high, bits), u8.shiftRight(low, 8 - bits))
    }
    index = index + 1
  }
  return result
}

// The substitution layer of an odd round (SB1, SB2, SB3, SB4) or of an even round (SB3, SB4,
// SB1, SB2).
fn substitute(x: &[u8; 16], oddRound: bool) -> [u8; 16] {
  let mut result: [u8; 16] = [0; 16]
  let mut index: usize = 0
  while index < 16 {
    let mut lane = index % 4
    if oddRound == false {
      lane = (lane + 2) % 4
    }
    let value = u8.toUsize(x[index])
    if lane == 0 {
      result[index] = SB1[value]
    } else if lane == 1 {
      result[index] = SB2[value]
    } else if lane == 2 {
      result[index] = SB3[value]
    } else {
      result[index] = SB4[value]
    }
    index = index + 1
  }
  return result
}

// The diffusion layer A of RFC 5794 section 2.4.3, an involution.
fn diffuse(x: &[u8; 16]) -> [u8; 16] {
  let mut result: [u8; 16] = [0; 16]
  result[0] = u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(x[3], x[4]), x[6]), x[8]), x[9]), x[13]), x[14])
  result[1] = u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(x[2], x[5]), x[7]), x[8]), x[9]), x[12]), x[15])
  result[2] = u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(x[1], x[4]), x[6]), x[10]), x[11]), x[12]), x[15])
  result[3] = u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(x[0], x[5]), x[7]), x[10]), x[11]), x[13]), x[14])
  result[4] = u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(x[0], x[2]), x[5]), x[8]), x[11]), x[14]), x[15])
  result[5] = u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(x[1], x[3]), x[4]), x[9]), x[10]), x[14]), x[15])
  result[6] = u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(x[0], x[2]), x[7]), x[9]), x[10]), x[12]), x[13])
  result[7] = u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(x[1], x[3]), x[6]), x[8]), x[11]), x[12]), x[13])
  result[8] = u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(x[0], x[1]), x[4]), x[7]), x[10]), x[13]), x[15])
  result[9] = u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(x[0], x[1]), x[5]), x[6]), x[11]), x[12]), x[14])
  result[10] = u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(x[2], x[3]), x[5]), x[6]), x[8]), x[13]), x[15])
  result[11] = u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(x[2], x[3]), x[4]), x[7]), x[9]), x[12]), x[14])
  result[12] = u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(x[1], x[2]), x[6]), x[7]), x[9]), x[11]), x[12])
  result[13] = u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(x[0], x[3]), x[6]), x[7]), x[8]), x[10]), x[13])
  result[14] = u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(x[0], x[3]), x[4]), x[5]), x[9]), x[11]), x[14])
  result[15] = u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(u8.bitXor(x[1], x[2]), x[4]), x[5]), x[8]), x[10]), x[15])
  return result
}

fn odd(state: &[u8; 16], key: &[u8; 16]) -> [u8; 16] {
  return diffuse(&substitute(&xor(state, key), true))
}

fn even(state: &[u8; 16], key: &[u8; 16]) -> [u8; 16] {
  return diffuse(&substitute(&xor(state, key), false))
}

fn crypt(keys: &[[u8; 16]; 17], rounds: usize, block: &[u8; 16]) -> [u8; 16] {
  let mut state = block.*
  let mut round: usize = 0
  while round + 1 < rounds {
    if round % 2 == 0 {
      state = odd(&state, &keys[round])
    } else {
      state = even(&state, &keys[round])
    }
    round = round + 1
  }
  // The last round has no diffusion layer and ends with the final key.
  return xor(&substitute(&xor(&state, &keys[rounds - 1]), false), &keys[rounds])
}
