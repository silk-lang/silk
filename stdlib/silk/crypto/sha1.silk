  let next17 = u32.wrappingAdd(u32.wrappingAdd(u32.wrappingAdd(e, u32.wrappingAdd(w1, u32.bitXor(0x5a827999, zero))), u32.bitXor(d, u32.bitAnd(b, u32.bitXor(c, d)))), u32.rotateLeft(a, 5))
