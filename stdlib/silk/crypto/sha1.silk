  let mut a = words[0]
  let mut b = words[1]
  let mut c = words[2]
  let mut d = words[3]
  let mut e = words[4]
  let next0 = u32.wrappingAdd(u32.wrappingAdd(u32.wrappingAdd(e, u32.wrappingAdd(w0, u32.bitXor(0x5a827999, zero))), u32.bitXor(d, u32.bitAnd(b, u32.bitXor(c, d)))), u32.rotateLeft(a, 5))
  e = d
  d = c
  c = u32.rotateLeft(b, 30)
  b = a
  a = next0
  let next1 = u32.wrappingAdd(u32.wrappingAdd(u32.wrappingAdd(e, u32.wrappingAdd(w1, u32.bitXor(0x5a827999, zero))), u32.bitXor(d, u32.bitAnd(b, u32.bitXor(c, d)))), u32.rotateLeft(a, 5))
  e = d
  d = c
  c = u32.rotateLeft(b, 30)
  b = a
  a = next1
  let next2 = u32.wrappingAdd(u32.wrappingAdd(u32.wrappingAdd(e, u32.wrappingAdd(w2, u32.bitXor(0x5a827999, zero))), u32.bitXor(d, u32.bitAnd(b, u32.bitXor(c, d)))), u32.rotateLeft(a, 5))
  e = d
  d = c
  c = u32.rotateLeft(b, 30)
  b = a
  a = next2
  let next3 = u32.wrappingAdd(u32.wrappingAdd(u32.wrappingAdd(e, u32.wrappingAdd(w3, u32.bitXor(0x5a827999, zero))), u32.bitXor(d, u32.bitAnd(b, u32.bitXor(c, d)))), u32.rotateLeft(a, 5))
  e = d
  d = c
  c = u32.rotateLeft(b, 30)
  b = a
  a = next3
  let next4 = u32.wrappingAdd(u32.wrappingAdd(u32.wrappingAdd(e, u32.wrappingAdd(w4, u32.bitXor(0x5a827999, zero))), u32.bitXor(d, u32.bitAnd(b, u32.bitXor(c, d)))), u32.rotateLeft(a, 5))
  e = d
  d = c
  c = u32.rotateLeft(b, 30)
  b = a
  a = next4
  let next5 = u32.wrappingAdd(u32.wrappingAdd(u32.wrappingAdd(e, u32.wrappingAdd(w5, u32.bitXor(0x5a827999, zero))), u32.bitXor(d, u32.bitAnd(b, u32.bitXor(c, d)))), u32.rotateLeft(a, 5))
