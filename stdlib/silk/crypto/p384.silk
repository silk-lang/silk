//!   // The same signature does not match another message.
//!   return match EcdsaP384Sha384.verify(&publicKey, b"hellp", &signature) {
//!     Result<(), P384SignatureError>.Failure { error: P384SignatureError.AuthenticationFailed } => 0
//!     _ => 1
//!   }
