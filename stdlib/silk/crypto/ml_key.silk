//! Read and write ML-KEM and ML-DSA keys in DER: PKCS #8 private keys and SubjectPublicKeyInfo
//! public keys, in the IETF LAMPS profiles for X.509 (draft-ietf-lamps-dilithium-certificates
//! and draft-ietf-lamps-kyber-certificates).
//!
//! # When to use
//! Use [`MlKeyDer`] to load an ML-KEM or ML-DSA key that OpenSSL, Node.js, or another library
//! wrote, or to export one in those forms. The reader tells you the algorithm; pass the bytes to
//! `silk.crypto.ml_kem` or `silk.crypto.ml_dsa`.
//!
//! # Details
//! A public key is the `PUBLIC KEY` form: the algorithm identifier and the raw encapsulation key in
//! a BIT STRING. A private key is the `PRIVATE KEY` form of RFC 5958 whose inner value is one of
//! three choices:
//! - the seed alone, with the context tag `[0]`: 64 bytes `d || z` for ML-KEM, 32 bytes for
//!   ML-DSA;
//! - the expanded private key alone, in an OCTET STRING;
//! - both, as a SEQUENCE of the seed and the expanded key.
//!
//! The algorithm identifiers have no parameters. The readers return views into the DER and do not
//! copy. Nothing allocates. PEM is DER in Base64 between header lines; use `silk.encoding.pem`
//! for it.
//!
//! # Errors
//! - [`MlKeyError`] for DER that is not valid, for another algorithm, or for a key of the wrong
//!   length.
//!
//! # Gotchas
//! The readers check the structure and the lengths, but not the values. A private key with both
//! forms can hold an expanded key that does not belong to its seed. Expand the seed with
//! `MlKem.keyPairFromSeed` or `MlDsa.keyPairFromSeed` and compare when that matters, as the
//! profiles ask. Check an ML-KEM expanded key alone with `MlKem.checkDecapsulationKey`.
//!
//! # Examples
//! ## Write and read an ML-KEM-768 private key seed
//! ```silk
//! import silk.collections.slice { Slice }
//! import silk.core.option { Option }
//! import silk.core.result { Result }
//! import silk.crypto.ml_key { MlKeyAlgorithm, MlKeyDer, MlKeyError, MlPrivateKeyDer }
//!
//! pub fn main() -> i32 {
//!   let seed: [u8; 64] = [9; 64]
//!   let mut der: [u8; 86] = [0; 86]
//!   let none = Option<&[u8]>.none()
//!   let length = match MlKeyDer.writePkcs8(MlKeyAlgorithm.MlKem768, Option<&[u8]>.some(&seed), none, &mut der) {
//!     Result<usize, MlKeyError>.Success { value } => value
//!     Result<usize, MlKeyError>.Failure {..} => {
//!       return 1
//!     }
//!   }
//!   // The seed form of PKCS #8 is 86 bytes.
//!   if length != 86 {
//!     return 1
//!   }
//!   return match MlKeyDer.readPkcs8(Slice.view<u8>(&der, 0, length)) {
//!     Result<MlPrivateKeyDer, MlKeyError>.Success { value } => {
//!       if value.algorithm == MlKeyAlgorithm.MlKem768 {
//!         return 0
//!       }
//!       return 1
//!     }
//!     Result<MlPrivateKeyDer, MlKeyError>.Failure {..} => 1
//!   }
//! }
//! ```
//!
//! @category Cryptography

import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.crypto.ml_dsa { MlDsaParameters }
import silk.crypto.ml_kem { MlKemParameters }
import silk.io.writer { Writer, WriterError }
import silk.num.u8
import silk.num.usize
import silk.text.format { Debug, Format, Formatter }

/// An algorithm whose keys [`MlKeyDer`] reads and writes.
pub enum MlKeyAlgorithm {
  MlKem512,
  MlKem768,
  MlKem1024,
  MlDsa44,
  MlDsa65,
  MlDsa87,
}

impl MlKeyAlgorithm {
  /// Returns the algorithm of an ML-KEM parameter set.
  pub fn fromMlKem(parameters: MlKemParameters) -> MlKeyAlgorithm {
    return match parameters {
      MlKemParameters.MlKem512 => MlKeyAlgorithm.MlKem512
      MlKemParameters.MlKem768 => MlKeyAlgorithm.MlKem768
      MlKemParameters.MlKem1024 => MlKeyAlgorithm.MlKem1024
    }
  }

  /// Returns the algorithm of an ML-DSA parameter set.
  pub fn fromMlDsa(parameters: MlDsaParameters) -> MlKeyAlgorithm {
    return match parameters {
      MlDsaParameters.MlDsa44 => MlKeyAlgorithm.MlDsa44
      MlDsaParameters.MlDsa65 => MlKeyAlgorithm.MlDsa65
      MlDsaParameters.MlDsa87 => MlKeyAlgorithm.MlDsa87
    }
  }

  /// Returns the ML-KEM parameter set, or `None` for an algorithm that is not ML-KEM.
  pub fn mlKemParameters(self: &Self) -> Option<MlKemParameters> {
    return match &self.* {
      MlKeyAlgorithm.MlKem512 => Option<MlKemParameters>.some(MlKemParameters.MlKem512)
      MlKeyAlgorithm.MlKem768 => Option<MlKemParameters>.some(MlKemParameters.MlKem768)
      MlKeyAlgorithm.MlKem1024 => Option<MlKemParameters>.some(MlKemParameters.MlKem1024)
      _ => Option<MlKemParameters>.none()
    }
  }

  /// Returns the ML-DSA parameter set, or `None` for an algorithm that is not ML-DSA.
  pub fn mlDsaParameters(self: &Self) -> Option<MlDsaParameters> {
    return match &self.* {
      MlKeyAlgorithm.MlDsa44 => Option<MlDsaParameters>.some(MlDsaParameters.MlDsa44)
      MlKeyAlgorithm.MlDsa65 => Option<MlDsaParameters>.some(MlDsaParameters.MlDsa65)
      MlKeyAlgorithm.MlDsa87 => Option<MlDsaParameters>.some(MlDsaParameters.MlDsa87)
      _ => Option<MlDsaParameters>.none()
    }
  }

  /// Returns the length of the private key seed: 64 bytes for ML-KEM and 32 for ML-DSA.
  pub fn seedLength(self: &Self) -> usize {
    return match &self.* {
      MlKeyAlgorithm.MlKem512 => 64
      MlKeyAlgorithm.MlKem768 => 64
      MlKeyAlgorithm.MlKem1024 => 64
      _ => 32
    }
  }

  /// Returns the length of the expanded private key: the ML-KEM decapsulation key, or the ML-DSA
  /// private key.
  pub fn expandedKeyLength(self: &Self) -> usize {
    return match &self.* {
      MlKeyAlgorithm.MlKem512 => MlKemParameters.MlKem512.decapsulationKeyLength()
      MlKeyAlgorithm.MlKem768 => MlKemParameters.MlKem768.decapsulationKeyLength()
      MlKeyAlgorithm.MlKem1024 => MlKemParameters.MlKem1024.decapsulationKeyLength()
      MlKeyAlgorithm.MlDsa44 => MlDsaParameters.MlDsa44.privateKeyLength()
      MlKeyAlgorithm.MlDsa65 => MlDsaParameters.MlDsa65.privateKeyLength()
      MlKeyAlgorithm.MlDsa87 => MlDsaParameters.MlDsa87.privateKeyLength()
    }
  }

  /// Returns the length of the public key: the ML-KEM encapsulation key, or the ML-DSA public key.
  pub fn publicKeyLength(self: &Self) -> usize {
    return match &self.* {
      MlKeyAlgorithm.MlKem512 => MlKemParameters.MlKem512.encapsulationKeyLength()
      MlKeyAlgorithm.MlKem768 => MlKemParameters.MlKem768.encapsulationKeyLength()
      MlKeyAlgorithm.MlKem1024 => MlKemParameters.MlKem1024.encapsulationKeyLength()
      MlKeyAlgorithm.MlDsa44 => MlDsaParameters.MlDsa44.publicKeyLength()
      MlKeyAlgorithm.MlDsa65 => MlDsaParameters.MlDsa65.publicKeyLength()
      MlKeyAlgorithm.MlDsa87 => MlDsaParameters.MlDsa87.publicKeyLength()
    }
  }

  /// Returns the DER content of the object identifier, without the tag and length.
  pub fn objectIdentifier(self: &Self) -> &[u8] {
    return match &self.* {
      MlKeyAlgorithm.MlKem512 => b"\x60\x86\x48\x01\x65\x03\x04\x04\x01"
      MlKeyAlgorithm.MlKem768 => b"\x60\x86\x48\x01\x65\x03\x04\x04\x02"
      MlKeyAlgorithm.MlKem1024 => b"\x60\x86\x48\x01\x65\x03\x04\x04\x03"
      MlKeyAlgorithm.MlDsa44 => b"\x60\x86\x48\x01\x65\x03\x04\x03\x11"
      MlKeyAlgorithm.MlDsa65 => b"\x60\x86\x48\x01\x65\x03\x04\x03\x12"
      MlKeyAlgorithm.MlDsa87 => b"\x60\x86\x48\x01\x65\x03\x04\x03\x13"
    }
  }
}

impl Debug for MlKeyAlgorithm {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return match &self.* {
      MlKeyAlgorithm.MlKem512 => run Format.write(&mut formatter, b"MlKem512")
      MlKeyAlgorithm.MlKem768 => run Format.write(&mut formatter, b"MlKem768")
      MlKeyAlgorithm.MlKem1024 => run Format.write(&mut formatter, b"MlKem1024")
      MlKeyAlgorithm.MlDsa44 => run Format.write(&mut formatter, b"MlDsa44")
      MlKeyAlgorithm.MlDsa65 => run Format.write(&mut formatter, b"MlDsa65")
      MlKeyAlgorithm.MlDsa87 => run Format.write(&mut formatter, b"MlDsa87")
    }
  }
}

/// Why [`MlKeyDer`] refused a key.
pub enum MlKeyError {
  /// The bytes are not the DER structure of the key, or an output buffer is too short.
  InvalidEncoding,
  /// The algorithm identifier names another algorithm.
  UnsupportedAlgorithm,
  /// A key has the wrong length for its algorithm, or a private key has neither form.
  InvalidLength,
}

impl Debug for MlKeyError {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return match &self.* {
      MlKeyError.InvalidEncoding => run Format.write(&mut formatter, b"InvalidEncoding")
      MlKeyError.UnsupportedAlgorithm => run Format.write(&mut formatter, b"UnsupportedAlgorithm")
      MlKeyError.InvalidLength => run Format.write(&mut formatter, b"InvalidLength")
    }
  }
}

/// A private key read from PKCS #8: views into the DER. At least one of `seed` and `expandedKey`
/// is `Some`, and each has the length of the algorithm.
pub struct MlPrivateKeyDer<'a> {
  pub algorithm: MlKeyAlgorithm,
  pub seed: Option<&'a [u8]>,
  pub expandedKey: Option<&'a [u8]>,
}

/// A public key read from SubjectPublicKeyInfo: a view into the DER.
pub struct MlPublicKeyDer<'a> {
  pub algorithm: MlKeyAlgorithm,
  pub publicKey: &'a [u8],
}

/// Reads and writes ML-KEM and ML-DSA keys as PKCS #8 and SubjectPublicKeyInfo DER.
pub struct MlKeyDer {}

impl MlKeyDer {
  /// Reads a PKCS #8 `PRIVATE KEY` in any of the three private key forms.
  ///
  /// The version can be 0 or 1, and attributes are skipped. A version 1 public key is refused,
  /// since the profile has none.
  ///
  /// # Errors
  /// - `InvalidEncoding`, `UnsupportedAlgorithm`, or `InvalidLength`.
  pub fn readPkcs8<'a>(der: &'a [u8]) -> Result<MlPrivateKeyDer<'a>, MlKeyError> {
    let outer = element(der, 0, der.length)
    if !outer.valid || outer.tag != 48 || outer.next != der.length {
      return Result<MlPrivateKeyDer<'a>, MlKeyError>.failResult(MlKeyError.InvalidEncoding)
    }
    let version = element(der, outer.start, outer.end)
    if !version.valid || version.tag != 2 || version.end != version.start + 1
      || der[version.start] > 1 {
      return Result<MlPrivateKeyDer<'a>, MlKeyError>.failResult(MlKeyError.InvalidEncoding)
    }
    let found = match move readAlgorithm(der, version.next, outer.end) {
      Result<AlgorithmAt, MlKeyError>.Success { value } => value
      Result<AlgorithmAt, MlKeyError>.Failure { error } => {
        return Result<MlPrivateKeyDer<'a>, MlKeyError>.failResult(error)
      }
    }
    let wrapped = element(der, found.next, outer.end)
    if !wrapped.valid || wrapped.tag != 4 {
      return Result<MlPrivateKeyDer<'a>, MlKeyError>.failResult(MlKeyError.InvalidEncoding)
    }
    let mut position = wrapped.next
    if position < outer.end && der[position] == 160 {
      let attributes = element(der, position, outer.end)
      if !attributes.valid {
        return Result<MlPrivateKeyDer<'a>, MlKeyError>.failResult(MlKeyError.InvalidEncoding)
      }
      position = attributes.next
    }
    if position != outer.end {
      return Result<MlPrivateKeyDer<'a>, MlKeyError>.failResult(MlKeyError.InvalidEncoding)
    }
    let algorithm = found.algorithm
    let inner = element(der, wrapped.start, wrapped.end)
    if !inner.valid || inner.next != wrapped.end {
      return Result<MlPrivateKeyDer<'a>, MlKeyError>.failResult(MlKeyError.InvalidEncoding)
    }
    let mut seed = Option<&'a [u8]>.none()
    let mut expandedKey = Option<&'a [u8]>.none()
    if inner.tag == 128 {
      if inner.end - inner.start != algorithm.seedLength() {
        return Result<MlPrivateKeyDer<'a>, MlKeyError>.failResult(MlKeyError.InvalidLength)
      }
      seed = Option<&'a [u8]>.some(Slice.view<u8>(der, inner.start, inner.end - inner.start))
    } else if inner.tag == 4 {
      if inner.end - inner.start != algorithm.expandedKeyLength() {
        return Result<MlPrivateKeyDer<'a>, MlKeyError>.failResult(MlKeyError.InvalidLength)
      }
      expandedKey = Option<&'a [u8]>.some(Slice.view<u8>(der, inner.start, inner.end - inner.start))
    } else if inner.tag == 48 {
      let first = element(der, inner.start, inner.end)
      if !first.valid || first.tag != 4 {
        return Result<MlPrivateKeyDer<'a>, MlKeyError>.failResult(MlKeyError.InvalidEncoding)
      }
      let second = element(der, first.next, inner.end)
      if !second.valid || second.tag != 4 || second.next != inner.end {
        return Result<MlPrivateKeyDer<'a>, MlKeyError>.failResult(MlKeyError.InvalidEncoding)
      }
      if first.end - first.start != algorithm.seedLength()
        || second.end - second.start != algorithm.expandedKeyLength() {
        return Result<MlPrivateKeyDer<'a>, MlKeyError>.failResult(MlKeyError.InvalidLength)
      }
      seed = Option<&'a [u8]>.some(Slice.view<u8>(der, first.start, first.end - first.start))
      expandedKey = Option<&'a [u8]>.some(Slice.view<u8>(der, second.start, second.end - second.start))
    } else {
      return Result<MlPrivateKeyDer<'a>, MlKeyError>.failResult(MlKeyError.InvalidEncoding)
    }
    return Result<MlPrivateKeyDer<'a>, MlKeyError>.succeed(
      MlPrivateKeyDer { algorithm: algorithm, seed: move seed, expandedKey: move expandedKey },
    )
  }

  /// Reads a SubjectPublicKeyInfo `PUBLIC KEY`.
  ///
  /// # Errors
  /// - `InvalidEncoding`, `UnsupportedAlgorithm`, or `InvalidLength`.
  pub fn readSpki<'a>(der: &'a [u8]) -> Result<MlPublicKeyDer<'a>, MlKeyError> {
    let outer = element(der, 0, der.length)
    if !outer.valid || outer.tag != 48 || outer.next != der.length {
      return Result<MlPublicKeyDer<'a>, MlKeyError>.failResult(MlKeyError.InvalidEncoding)
    }
    let found = match move readAlgorithm(der, outer.start, outer.end) {
      Result<AlgorithmAt, MlKeyError>.Success { value } => value
      Result<AlgorithmAt, MlKeyError>.Failure { error } => {
        return Result<MlPublicKeyDer<'a>, MlKeyError>.failResult(error)
      }
    }
    let bits = element(der, found.next, outer.end)
    if !bits.valid || bits.tag != 3 || bits.next != outer.end || bits.end == bits.start
      || der[bits.start] != 0 {
      return Result<MlPublicKeyDer<'a>, MlKeyError>.failResult(MlKeyError.InvalidEncoding)
    }
    if bits.end - bits.start - 1 != found.algorithm.publicKeyLength() {
      return Result<MlPublicKeyDer<'a>, MlKeyError>.failResult(MlKeyError.InvalidLength)
    }
    return Result<MlPublicKeyDer<'a>, MlKeyError>.succeed(
      MlPublicKeyDer {
        algorithm: found.algorithm,
        publicKey: Slice.view<u8>(der, bits.start + 1, bits.end - bits.start - 1),
      },
    )
  }

  /// Returns the length of the PKCS #8 DER that [`MlKeyDer.writePkcs8`] writes for the forms
  /// that are present.
  pub fn pkcs8Length(algorithm: MlKeyAlgorithm, hasSeed: bool, hasExpandedKey: bool) -> usize {
    let inner = innerLength(algorithm, hasSeed, hasExpandedKey)
    let content = 3 + 13 + headerLength(inner) + inner
    return headerLength(content) + content
  }

  /// Writes a PKCS #8 `PRIVATE KEY` into `output` and returns its length. With `seed` alone it
  /// writes the seed form, with `expandedKey` alone the expanded form, and with both the form
  /// that holds both.
  ///
  /// # Errors
  /// - `InvalidLength` if neither is given, or one has the wrong length.
  /// - `InvalidEncoding` if `output` is shorter than [`MlKeyDer.pkcs8Length`].
  pub fn writePkcs8(
    algorithm: MlKeyAlgorithm,
    seed: Option<&[u8]>,
    expandedKey: Option<&[u8]>,
    output: &mut [u8],
  ) -> Result<usize, MlKeyError> {
    let seedLength = match &seed {
      Option<&[u8]>.Some { value } => value.length
      Option<&[u8]>.None => 0
    }
    let keyLength = match &expandedKey {
      Option<&[u8]>.Some { value } => value.length
      Option<&[u8]>.None => 0
    }
    let hasSeed = isSome(&seed)
    let hasKey = isSome(&expandedKey)
    if (!hasSeed && !hasKey) || (hasSeed && seedLength != algorithm.seedLength())
      || (hasKey && keyLength != algorithm.expandedKeyLength()) {
      return Result<usize, MlKeyError>.failResult(MlKeyError.InvalidLength)
    }
    let total = MlKeyDer.pkcs8Length(algorithm, hasSeed, hasKey)
    if output.length < total {
      return Result<usize, MlKeyError>.failResult(MlKeyError.InvalidEncoding)
    }
    let inner = innerLength(algorithm, hasSeed, hasKey)
    let mut position = writeHeader(&mut output, 0, 48, 3 + 13 + headerLength(inner) + inner)
    position = writeBytes(&mut output, position, b"\x02\x01\x00")
    position = writeAlgorithm(algorithm, &mut output, position)
    position = writeHeader(&mut output, position, 4, inner)
    if hasSeed && hasKey {
      position = writeHeader(&mut output, position, 48, bothLength(algorithm))
    }
    match &seed {
      Option<&[u8]>.Some { value } => {
        let tag: u8 = if hasKey { 4 } else { 128 }
        position = writeHeader(&mut output, position, tag, value.length)
        position = writeBytes(&mut output, position, value)
      }
      Option<&[u8]>.None => {}
    }
    match &expandedKey {
      Option<&[u8]>.Some { value } => {
        position = writeHeader(&mut output, position, 4, value.length)
        position = writeBytes(&mut output, position, value)
      }
      Option<&[u8]>.None => {}
    }
    return Result<usize, MlKeyError>.succeed(position)
  }

  /// Returns the length of the SubjectPublicKeyInfo DER for `algorithm`.
  pub fn spkiLength(algorithm: MlKeyAlgorithm) -> usize {
    let bits = algorithm.publicKeyLength() + 1
    let content = 13 + headerLength(bits) + bits
    return headerLength(content) + content
  }

  /// Writes a SubjectPublicKeyInfo `PUBLIC KEY` into `output` and returns its length.
  ///
  /// # Errors
  /// - `InvalidLength` if `publicKey` has the wrong length.
  /// - `InvalidEncoding` if `output` is shorter than [`MlKeyDer.spkiLength`].
  pub fn writeSpki(algorithm: MlKeyAlgorithm, publicKey: &[u8], output: &mut [u8]) -> Result<
    usize,
    MlKeyError,
  > {
    if publicKey.length != algorithm.publicKeyLength() {
      return Result<usize, MlKeyError>.failResult(MlKeyError.InvalidLength)
    }
    let total = MlKeyDer.spkiLength(algorithm)
    if output.length < total {
      return Result<usize, MlKeyError>.failResult(MlKeyError.InvalidEncoding)
    }
    let bits = publicKey.length + 1
    let mut position = writeHeader(&mut output, 0, 48, 13 + headerLength(bits) + bits)
    position = writeAlgorithm(algorithm, &mut output, position)
    position = writeHeader(&mut output, position, 3, bits)
    output[position] = 0
    position = writeBytes(&mut output, position + 1, publicKey)
    return Result<usize, MlKeyError>.succeed(position)
  }
}

fn isSome(value: &Option<&[u8]>) -> bool {
  return match &value.* {
    Option<&[u8]>.Some { .. } => true
    Option<&[u8]>.None => false
  }
}

// The length of the inner private key value, with its own header.
fn innerLength(algorithm: MlKeyAlgorithm, hasSeed: bool, hasExpandedKey: bool) -> usize {
  let seed = algorithm.seedLength()
  let key = algorithm.expandedKeyLength()
  let seedElement = headerLength(seed) + seed
  let keyElement = headerLength(key) + key
  if hasSeed && hasExpandedKey {
    let content = bothLength(algorithm)
    return headerLength(content) + content
  }
  if hasSeed {
    return seedElement
  }
  return keyElement
}

// The content length of the SEQUENCE that holds the seed and the expanded key.
fn bothLength(algorithm: MlKeyAlgorithm) -> usize {
  let seed = algorithm.seedLength()
  let key = algorithm.expandedKeyLength()
  return headerLength(seed) + seed + headerLength(key) + key
}

// The length of a DER tag and length for `length` content bytes, below 64 KiB.
fn headerLength(length: usize) -> usize {
  if length < 128 {
    return 2
  }
  if length < 256 {
    return 3
  }
  return 4
}

// One DER element: the tag, the content range, and the offset after it.
struct Element {
  tag: u8,
  start: usize,
  end: usize,
  next: usize,
  valid: bool,
}

// Reads the element at `offset` that must end by `limit`. Lengths use the shortest form, and the
// keys here are below 64 KiB.
fn element(bytes: &[u8], offset: usize, limit: usize) -> Element {
  let invalid = Element { tag: 0, start: 0, end: 0, next: 0, valid: false }
  if limit > bytes.length || offset >= limit || limit - offset < 2 {
    return move invalid
  }
  let first = bytes[offset + 1]
  let mut start = offset + 2
  let mut length = u8.toUsize(first)
  if first == 129 {
    if limit - start < 1 || bytes[start] < 128 {
      return move invalid
    }
    length = u8.toUsize(bytes[start])
    start = start + 1
  } else if first == 130 {
    if limit - start < 2 || bytes[start] == 0 {
      return move invalid
    }
    length = u8.toUsize(bytes[start]) * 256 + u8.toUsize(bytes[start + 1])
    if length < 256 {
      return move invalid
    }
    start = start + 2
  } else if first >= 128 {
    return move invalid
  }
  if length > limit - start {
    return move invalid
  }
  return Element {
    tag: bytes[offset],
    start: start,
    end: start + length,
    next: start + length,
    valid: true,
  }
}

fn sameBytes(bytes: &[u8], start: usize, end: usize, expected: &[u8]) -> bool {
  if end - start != expected.length {
    return false
  }
  let mut i: usize = 0
  while i < expected.length {
    if bytes[start + i] != expected[i] {
      return false
    }
    i = i + 1
  }
  return true
}

struct AlgorithmAt {
  algorithm: MlKeyAlgorithm,
  next: usize,
}

impl Copy for AlgorithmAt {}

// AlgorithmIdentifier with absent parameters, at `offset`.
fn readAlgorithm(bytes: &[u8], offset: usize, limit: usize) -> Result<AlgorithmAt, MlKeyError> {
  let sequence = element(bytes, offset, limit)
  if !sequence.valid || sequence.tag != 48 {
    return Result<AlgorithmAt, MlKeyError>.failResult(MlKeyError.InvalidEncoding)
  }
  let identifier = element(bytes, sequence.start, sequence.end)
  if !identifier.valid || identifier.tag != 6 {
    return Result<AlgorithmAt, MlKeyError>.failResult(MlKeyError.InvalidEncoding)
  }
  let candidates: [MlKeyAlgorithm; 6] = [
    MlKeyAlgorithm.MlKem512,
    MlKeyAlgorithm.MlKem768,
    MlKeyAlgorithm.MlKem1024,
    MlKeyAlgorithm.MlDsa44,
    MlKeyAlgorithm.MlDsa65,
    MlKeyAlgorithm.MlDsa87,
  ]
  let mut index: usize = 0
  while index < 6 {
    let candidate = candidates[index]
    if sameBytes(bytes, identifier.start, identifier.end, candidate.objectIdentifier()) {
      if identifier.next != sequence.end {
        return Result<AlgorithmAt, MlKeyError>.failResult(MlKeyError.InvalidEncoding)
      }
      return Result<AlgorithmAt, MlKeyError>.succeed(
        AlgorithmAt { algorithm: candidate, next: sequence.next },
      )
    }
    index = index + 1
  }
  return Result<AlgorithmAt, MlKeyError>.failResult(MlKeyError.UnsupportedAlgorithm)
}

// Writes a tag and the shortest DER length.
fn writeHeader(output: &mut [u8], position: usize, tag: u8, length: usize) -> usize {
  output[position] = tag
  if length < 128 {
    output[position + 1] = usize.toU8(length)
    return position + 2
  }
  if length < 256 {
    output[position + 1] = 129
    output[position + 2] = usize.toU8(length)
    return position + 3
  }
  output[position + 1] = 130
  output[position + 2] = usize.toU8(length / 256)
  output[position + 3] = usize.toU8(length % 256)
  return position + 4
}

fn writeBytes(output: &mut [u8], position: usize, bytes: &[u8]) -> usize {
  let mut i: usize = 0
  while i < bytes.length {
    output[position + i] = bytes[i]
    i = i + 1
  }
  return position + bytes.length
}

// SEQUENCE { OBJECT IDENTIFIER }: 13 bytes for the nine-byte identifiers here.
fn writeAlgorithm(algorithm: MlKeyAlgorithm, output: &mut [u8], position: usize) -> usize {
  let identifier = algorithm.objectIdentifier()
  let mut at = writeHeader(&mut output, position, 48, identifier.length + 2)
  at = writeHeader(&mut output, at, 6, identifier.length)
  return writeBytes(&mut output, at, identifier)
}
