//!     0x15,
//!     0x0c,
//!     0x67,
//!     0x70,
//!     0x4d,
//!     0xd2,
//!     0x5a,
//!     0xe7,
//!     0x05,
//!     0x52,
//!     0x05,
//!     0x74,
//!     0x4b,
//!     0x6f,
//!     0x31,
//!     0xbf,
//!     0x40,
//!     0x70,
//!     0x74,
//!     0x58,
//!     0x72,
//!     0xd0,
//!     0xe6
//!   ]
//!   let signature: [u8; 72] = [
//!     0x30,
//!     0x46,
//!     0x02,
//!     0x21,
//!     0x00,
//!     0xc9,
//!     0x70,
//!     0x75,
//!     0x86,
