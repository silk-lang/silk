//! Key agreement (ECDH), and ECDSA signing and verification on the NIST P-256 curve (secp256r1).
//!
//! # When to use
//! Use [`P256`] for an ECDH key exchange where a protocol needs P-256, such as a TLS 1.3 key share
//! `secp256r1`. For a new design, `silk.crypto.x25519` is simpler. Use [`EcdsaP256Sha256`] to verify an
//! ECDSA signature with SHA-256, for example the signature of a certificate or a JSON Web Token
//! with `ES256`.
//!
//! # Details
//! Public keys are 65 bytes in uncompressed SEC1 form: `0x04`, then the X and Y coordinates, each
//! 32 bytes big-endian. Secrets are 32 bytes big-endian. [`P256.agree`] returns the X coordinate of
//! the shared point and consumes the key. Signatures are in DER form, as in X.509 and TLS. Nothing
//! allocates. This module cannot sign.
//!
//! # Errors
//! - [`P256Error`] for a secret or a peer public key that is not valid.
//! - [`P256SignatureError`] for a signature that is not valid, or that does not match.
//!
//! # Gotchas
//! A valid signature proves only that the holder of the private key signed the message. It does not
//! prove that you can trust the key. To check a certificate chain, use the `silk.tls.trust_*` modules.
//! The key exchange does not authenticate the peer. Pass the shared secret through `silk.crypto.hkdf`
//! before you use it as a key. The secret is not erased when it is dropped.
//!
//! # Examples
//! ## Agree on a shared secret
//! ```silk
//! import silk.crypto.p256 { P256, P256Error }
//! import silk.core.result { Result }
//!
//! pub fn main() -> i32 {
//!   // Real programs use `P256.generate()` with a secure `Random` provider.
//!   let mut one: [u8; 32] = [0; 32]
//!   one[31] = 1
//!   let mut two: [u8; 32] = [0; 32]
//!   two[31] = 2
//!   let alice = match P256.fromBytes(&one) {
//!     Result<P256, P256Error>.Success { value } => move value
//!     Result<P256, P256Error>.Failure {..} => {
//!       return 1
//!     }
//!   }
//!   let bob = match P256.fromBytes(&two) {
//!     Result<P256, P256Error>.Success { value } => move value
//!     Result<P256, P256Error>.Failure {..} => {
//!       return 1
//!     }
//!   }
//!   let alicePublic = P256.publicKey(&alice)
//!   let bobPublic = P256.publicKey(&bob)
//!
//!   // The public key of the secret 1 is the base point, with X = 6b17d1f2...
//!   if alicePublic[0] != 0x04 || alicePublic[1] != 0x6b {
//!     return 1
//!   }
//!   let fromAlice = match P256.agree(move alice, &bobPublic) {
//!     Result<[u8; 32], P256Error>.Success { value } => value
//!     Result<[u8; 32], P256Error>.Failure {..} => {
//!       return 1
//!     }
//!   }
//!   let fromBob = match P256.agree(move bob, &alicePublic) {
//!     Result<[u8; 32], P256Error>.Success { value } => value
//!     Result<[u8; 32], P256Error>.Failure {..} => {
//!       return 1
//!     }
//!   }
//!   if fromAlice[0] != fromBob[0] || fromAlice[31] != fromBob[31] {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! ## Verify a signature
//! ```silk
//! import silk.crypto.p256 { EcdsaP256Sha256, P256SignatureError }
//! import silk.core.result { Result }
//!
//! pub fn main() -> i32 {
//!   // A public key and a signature of "hello" that another program made.
//!   let publicKey: [u8; 65] = [
//!     0x04,
//!     0x26,
//!     0xef,
//!     0xce,
//!     0xbd,
//!     0x0e,
//!     0xe9,
//!     0xe3,
//!     0x4a,
//!     0x66,
//!     0x91,
//!     0x87,
//!     0xe1,
//!     0x8b,
//!     0x3a,
//!     0x91,
//!     0x22,
//!     0xb2,
//!     0xf7,
//!     0x33,
//!     0x94,
//!     0x5b,
