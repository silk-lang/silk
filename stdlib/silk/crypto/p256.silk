//!     0xc5,
//!     0x7a,
//!     0x30,
//!     0x9d,
//!     0x1c,
//!     0x02,
//!     0x21,
//!     0x00,
//!     0x88,
//!     0x3f,
//!     0xb1,
//!     0x3c,
//!     0x3b,
//!     0x44,
//!     0x28,
//!     0x70,
//!     0x2e,
//!     0xc4,
//!     0x88,
//!     0x52,
//!     0xf8,
//!     0x5e,
//!     0xe5,
//!     0x63,
//!     0x1a,
//!     0xec,
//!     0x2f,
//!     0x25,
//!     0x23,
//!     0xe3,
//!     0xd7,
//!     0x18,
//!     0xf8,
//!     0xae,
//!     0x33,
//!     0x25,
//!     0xe0,
//!     0x00,
//!     0xdc,
//!     0xa8
//!   ]
//!   match EcdsaP256Sha256.verify(&publicKey, b"hello", &signature) {
//!     Result<(), P256SignatureError>.Success {..} => {}
//!     Result<(), P256SignatureError>.Failure {..} => {
//!       return 1
//!     }
//!   }
//!
//!   // The same signature does not match another message.
//!   return match EcdsaP256Sha256.verify(&publicKey, b"hellp", &signature) {
//!     Result<(), P256SignatureError>.Failure { error: P256SignatureError.AuthenticationFailed } => 0
//!     _ => 1
//!   }
//! }
//! ```
//!
//! @category Cryptography

import silk.tls.certificate {AlgorithmView, BitStringView}
import silk.text.format {Debug, Format, Formatter}
import silk.core.option {Option}
import silk.core.ownership {Copy}
import silk.collections.list {List}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.crypto.hmac {HmacSha256}
import silk.crypto.sha2 {Sha256}
