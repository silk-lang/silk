//! Compute the 36-byte MD5-SHA1 digest that TLS 1.0 and 1.1 use: MD5 followed by SHA-1.
//!
//! # When to use
//! Use [`Md5Sha1`] only where a legacy format names it, such as Node's `md5-sha1` hash or the
//! TLS 1.0 and 1.1 RSA signatures. Use SHA-256 elsewhere.
//!
//! # Details
//! The digest is the 16-byte MD5 digest of the message followed by its 20-byte SHA-1 digest. The
//! streaming state does not allocate. Call `make`, `update`, and `finish`, or use `hash`.
//!
//! # Gotchas
//! MD5 and SHA-1 both permit deliberate collisions, so the pair does not protect data against
//! tampering. The hash has no object identifier, so [`Digest.objectIdentifier`] returns an empty
//! slice.
//!
//! # Examples
//! ## Hash a message
//! ```silk
//! import silk.crypto.md5_sha1 { Md5Sha1 }
//!
//! pub fn main() -> i32 {
//!   let digest = Md5Sha1.hash(b"abc")
//!   // MD5("abc") starts with 90 and SHA-1("abc") with a9.
//!   if digest[0] != 0x90 || digest[16] != 0xa9 || digest[35] != 0x9d {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Cryptography

import silk.crypto.digest {Digest}
import silk.crypto.md5 {Md5}
import silk.crypto.sha1 {Sha1}

/// A streaming MD5-SHA1 state that returns a 36-byte digest. It does not allocate.
pub struct Md5Sha1 {
  md5: Md5,
  sha1: Sha1,
}

impl Md5Sha1 {
  /// Returns a state for an empty message.
  pub fn make() -> Self {
    return Md5Sha1 {md5: Md5.make(), sha1: Sha1.make()}
  }

  /// Adds bytes to the message.
  pub fn update(self: &mut Self, bytes: &[u8]) -> () {
    self.md5.update(bytes)
    self.sha1.update(bytes)
    return ()
  }

  /// Consumes the state and returns the MD5 digest followed by the SHA-1 digest.
  pub fn finish(self: Self) -> [u8; 36] {
    let state = move self
    let first = state.md5.finish()
    let second = state.sha1.finish()
    let mut digest: [u8; 36] = [0; 36]
    let mut index: usize = 0
    while index < 16 {
      digest[index] = first[index]
      index = index + 1
    }
    index = 0
    while index < 20 {
      digest[16 + index] = second[index]
      index = index + 1
    }
    return digest
  }

  /// Returns the 36-byte MD5-SHA1 digest of `bytes`. It does not allocate.
  pub fn hash(bytes: &[u8]) -> [u8; 36] {
    let mut state = Md5Sha1.make()
    state.update(bytes)
    return state.finish()
  }
}

impl Digest for Md5Sha1 {
  /// Returns an MD5-SHA1 state for an empty message.
  make: Md5Sha1.make
  /// Adds `bytes` to the end of the message.
  update: Md5Sha1.update
  /// Returns 64, the block length of both MD5 and SHA-1 in bytes.
  fn blockLength(self: &Self) -> usize {
    return 64
  }
  /// Returns 36, the MD5-SHA1 digest length in bytes.
  fn digestLength(self: &Self) -> usize {
    return 36
  }
  /// Returns an empty slice, because MD5-SHA1 has no object identifier.
  fn objectIdentifier(self: &Self) -> &[u8] {
    return b""
  }
  /// Returns an independent copy of the state.
  fn copy(self: &Self) -> Self {
    return Md5Sha1 {md5: self.md5.copy(), sha1: self.sha1.copy()}
  }
  /// Writes the 36-byte MD5-SHA1 digest to the start of `output` and consumes the state.
  fn finishInto(self: Self, output: &mut [u8]) -> () {
    let digest = Md5Sha1.finish(move self)
    let mut index: usize = 0
    while index < 36 {
      output[index] = digest[index]
      index = index + 1
    }
  }
}
