//! Compute MD5 digests for legacy formats, including UUID version 3.
//!
//! # When to use
//! Use [`Md5`] only for a format that requires MD5. Use SHA-256 for new cryptographic protocols.
//!
//! # Details
//! The streaming state does not allocate. Call `make`, `update`, and `finish`, or use `hash`.
//!
//! # Gotchas
//! MD5 permits deliberate collisions. It does not protect data against tampering.
//!
//! # Examples
//! ## Hash a message in parts
//! ```silk
//! import silk.crypto.md5 { Md5 }
//!
//! pub fn main() -> i32 {
//!   let mut state = Md5.make()
//!   state.update(b"a")
//!   state.update(b"bc")
//!   let digest = state.finish()
//!   if digest[0] != 0x90 || digest[15] != 0x72 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! # See also
//! [RFC 1321](https://www.rfc-editor.org/rfc/rfc1321.html) defines the MD5 algorithm.
//!
//! @category Cryptography

import silk.num.u32
import silk.crypto.digest {Digest}
import silk.num.u64
import silk.collections.slice { Slice }
import silk.num.u8
import silk.num.usize
import silk.encoding.endian

/// A streaming MD5 state. It does not allocate and is unsuitable for security checks.
pub struct Md5 {
  words: [u32; 4],
  buffer: [u8; 64],
  used: usize,
  length: u64,
}

impl Md5 {
  /// Returns a state for an empty message.
  pub fn make() -> Self {
    return Md5 {
      words: [0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476],
      buffer: [0; 64],
      used: 0,
      length: 0
    }
  }

  /// Adds bytes to the message. The length in bits wraps modulo 2^64, as MD5 requires.
  pub fn update(self: &mut Self, bytes: &[u8]) -> () {
    self.length = u64.wrappingAdd(self.length, u64.wrappingMultiply(usize.toU64(bytes.length), 8))
    // Fill a partial block first, then compress whole blocks straight from `bytes`, and keep the
    // rest. Each byte is copied at most once.
    let mut index: usize = 0
    if self.used > 0 {
      let mut take = 64 - self.used
      if take > bytes.length { take = bytes.length }
      Slice.copyInto<u8>(&mut self.buffer, self.used, Slice.view<u8>(bytes, 0, take))
      self.used = self.used + take
      index = take
      if self.used < 64 { return () }
      let block = self.buffer
      compress(&mut self.words, &block, 0)
      self.used = 0
    }
    while bytes.length - index >= 64 {
      compress(&mut self.words, bytes, index)
      index = index + 64
    }
    if index < bytes.length {
      Slice.copyInto<u8>(&mut self.buffer, 0, Slice.view<u8>(bytes, index, bytes.length - index))
      self.used = bytes.length - index
    }
    return ()
  }


  /// Consumes the state and returns its 16-byte digest in MD5 byte order.
  pub fn finish(self: Self) -> [u8; 16] {
    let mut state = move self
    let bits = state.length
    let mut padding: [u8; 64] = [0; 64]
    padding[0] = 128
    let mut count: usize = 120 - state.used
    if state.used < 56 {
      count = 56 - state.used
    }
    state.update(Slice.view<u8>(&padding, 0, count))
    let mut lengthBytes: [u8; 8] = [0; 8]
    let mut index: usize = 0
    while index < 8 {
      lengthBytes[index] = u64.toU8(u64.bitAnd(u64.shiftRight(bits, usize.toU64(index * 8)), 255))
      index = index + 1
    }
    state.update(&lengthBytes)
    let mut digest: [u8; 16] = [0; 16]
    index = 0
    while index < 16 {
      digest[index] = u32.toU8(
        u32.bitAnd(
          u32.shiftRight(state.words[index / 4], usize.toU32(usize.remainder(index, 4) * 8)),
          255
        )
      )
      index = index + 1
    }
    return digest
  }

  /// Returns the 16-byte MD5 digest of `bytes`. It does not allocate.
  pub fn hash(bytes: &[u8]) -> [u8; 16] {
    let mut state = Md5.make()
    state.update(bytes)
    return state.finish()
  }
}

// Compresses the 64-byte block at `offset` in `bytes` into `words`. The 64 steps are unrolled, with
// the constants of RFC 1321 inline.
fn compress(words: &mut [u32; 4], bytes: &[u8], offset: usize) -> () {
  let block = Slice.view<u8>(bytes, offset, 64)
  // `zero` is always zero, because a slice offset is below 2^63, but the optimizer cannot prove it.
  // Mixing it into each constant keeps the constant with the message word, which is ready early.
  // Otherwise the optimizer adds the constant after the round function, one more step on the
  // dependency chain of each of the 64 steps.
  let zero = u32.wrappingSubtract(0, u64.toU32(u64.shiftRight(usize.toU64(offset), 63)))
  let m0 = endian.readU32LittleEndian(block, 0)
  let m1 = endian.readU32LittleEndian(block, 4)
  let m2 = endian.readU32LittleEndian(block, 8)
  let m3 = endian.readU32LittleEndian(block, 12)
  let m4 = endian.readU32LittleEndian(block, 16)
  let m5 = endian.readU32LittleEndian(block, 20)
  let m6 = endian.readU32LittleEndian(block, 24)
  let m7 = endian.readU32LittleEndian(block, 28)
  let m8 = endian.readU32LittleEndian(block, 32)
  let m9 = endian.readU32LittleEndian(block, 36)
  let m10 = endian.readU32LittleEndian(block, 40)
  let m11 = endian.readU32LittleEndian(block, 44)
  let m12 = endian.readU32LittleEndian(block, 48)
  let m13 = endian.readU32LittleEndian(block, 52)
  let m14 = endian.readU32LittleEndian(block, 56)
  let m15 = endian.readU32LittleEndian(block, 60)
  let mut a = words[0]
  let mut b = words[1]
  let mut c = words[2]
  let mut d = words[3]
  a = u32.wrappingAdd(b, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(a, u32.wrappingAdd(m0, u32.bitXor(0xd76aa478, zero))), u32.bitXor(d, u32.bitAnd(b, u32.bitXor(c, d)))), 7))
  d = u32.wrappingAdd(a, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(d, u32.wrappingAdd(m1, u32.bitXor(0xe8c7b756, zero))), u32.bitXor(c, u32.bitAnd(a, u32.bitXor(b, c)))), 12))
  c = u32.wrappingAdd(d, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(c, u32.wrappingAdd(m2, u32.bitXor(0x242070db, zero))), u32.bitXor(b, u32.bitAnd(d, u32.bitXor(a, b)))), 17))
  b = u32.wrappingAdd(c, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(b, u32.wrappingAdd(m3, u32.bitXor(0xc1bdceee, zero))), u32.bitXor(a, u32.bitAnd(c, u32.bitXor(d, a)))), 22))
  a = u32.wrappingAdd(b, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(a, u32.wrappingAdd(m4, u32.bitXor(0xf57c0faf, zero))), u32.bitXor(d, u32.bitAnd(b, u32.bitXor(c, d)))), 7))
  d = u32.wrappingAdd(a, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(d, u32.wrappingAdd(m5, u32.bitXor(0x4787c62a, zero))), u32.bitXor(c, u32.bitAnd(a, u32.bitXor(b, c)))), 12))
  c = u32.wrappingAdd(d, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(c, u32.wrappingAdd(m6, u32.bitXor(0xa8304613, zero))), u32.bitXor(b, u32.bitAnd(d, u32.bitXor(a, b)))), 17))
  b = u32.wrappingAdd(c, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(b, u32.wrappingAdd(m7, u32.bitXor(0xfd469501, zero))), u32.bitXor(a, u32.bitAnd(c, u32.bitXor(d, a)))), 22))
  a = u32.wrappingAdd(b, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(a, u32.wrappingAdd(m8, u32.bitXor(0x698098d8, zero))), u32.bitXor(d, u32.bitAnd(b, u32.bitXor(c, d)))), 7))
  d = u32.wrappingAdd(a, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(d, u32.wrappingAdd(m9, u32.bitXor(0x8b44f7af, zero))), u32.bitXor(c, u32.bitAnd(a, u32.bitXor(b, c)))), 12))
  c = u32.wrappingAdd(d, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(c, u32.wrappingAdd(m10, u32.bitXor(0xffff5bb1, zero))), u32.bitXor(b, u32.bitAnd(d, u32.bitXor(a, b)))), 17))
  b = u32.wrappingAdd(c, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(b, u32.wrappingAdd(m11, u32.bitXor(0x895cd7be, zero))), u32.bitXor(a, u32.bitAnd(c, u32.bitXor(d, a)))), 22))
  a = u32.wrappingAdd(b, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(a, u32.wrappingAdd(m12, u32.bitXor(0x6b901122, zero))), u32.bitXor(d, u32.bitAnd(b, u32.bitXor(c, d)))), 7))
  d = u32.wrappingAdd(a, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(d, u32.wrappingAdd(m13, u32.bitXor(0xfd987193, zero))), u32.bitXor(c, u32.bitAnd(a, u32.bitXor(b, c)))), 12))
  c = u32.wrappingAdd(d, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(c, u32.wrappingAdd(m14, u32.bitXor(0xa679438e, zero))), u32.bitXor(b, u32.bitAnd(d, u32.bitXor(a, b)))), 17))
  b = u32.wrappingAdd(c, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(b, u32.wrappingAdd(m15, u32.bitXor(0x49b40821, zero))), u32.bitXor(a, u32.bitAnd(c, u32.bitXor(d, a)))), 22))
  a = u32.wrappingAdd(b, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(u32.wrappingAdd(a, u32.wrappingAdd(m1, u32.bitXor(0xf61e2562, zero))), u32.bitAnd(c, u32.bitNot(d))), u32.bitAnd(b, d)), 5))
  d = u32.wrappingAdd(a, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(u32.wrappingAdd(d, u32.wrappingAdd(m6, u32.bitXor(0xc040b340, zero))), u32.bitAnd(b, u32.bitNot(c))), u32.bitAnd(a, c)), 9))
  c = u32.wrappingAdd(d, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(u32.wrappingAdd(c, u32.wrappingAdd(m11, u32.bitXor(0x265e5a51, zero))), u32.bitAnd(a, u32.bitNot(b))), u32.bitAnd(d, b)), 14))
  b = u32.wrappingAdd(c, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(u32.wrappingAdd(b, u32.wrappingAdd(m0, u32.bitXor(0xe9b6c7aa, zero))), u32.bitAnd(d, u32.bitNot(a))), u32.bitAnd(c, a)), 20))
  a = u32.wrappingAdd(b, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(u32.wrappingAdd(a, u32.wrappingAdd(m5, u32.bitXor(0xd62f105d, zero))), u32.bitAnd(c, u32.bitNot(d))), u32.bitAnd(b, d)), 5))
  d = u32.wrappingAdd(a, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(u32.wrappingAdd(d, u32.wrappingAdd(m10, u32.bitXor(0x02441453, zero))), u32.bitAnd(b, u32.bitNot(c))), u32.bitAnd(a, c)), 9))
  c = u32.wrappingAdd(d, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(u32.wrappingAdd(c, u32.wrappingAdd(m15, u32.bitXor(0xd8a1e681, zero))), u32.bitAnd(a, u32.bitNot(b))), u32.bitAnd(d, b)), 14))
  b = u32.wrappingAdd(c, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(u32.wrappingAdd(b, u32.wrappingAdd(m4, u32.bitXor(0xe7d3fbc8, zero))), u32.bitAnd(d, u32.bitNot(a))), u32.bitAnd(c, a)), 20))
  a = u32.wrappingAdd(b, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(u32.wrappingAdd(a, u32.wrappingAdd(m9, u32.bitXor(0x21e1cde6, zero))), u32.bitAnd(c, u32.bitNot(d))), u32.bitAnd(b, d)), 5))
  d = u32.wrappingAdd(a, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(u32.wrappingAdd(d, u32.wrappingAdd(m14, u32.bitXor(0xc33707d6, zero))), u32.bitAnd(b, u32.bitNot(c))), u32.bitAnd(a, c)), 9))
  c = u32.wrappingAdd(d, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(u32.wrappingAdd(c, u32.wrappingAdd(m3, u32.bitXor(0xf4d50d87, zero))), u32.bitAnd(a, u32.bitNot(b))), u32.bitAnd(d, b)), 14))
  b = u32.wrappingAdd(c, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(u32.wrappingAdd(b, u32.wrappingAdd(m8, u32.bitXor(0x455a14ed, zero))), u32.bitAnd(d, u32.bitNot(a))), u32.bitAnd(c, a)), 20))
  a = u32.wrappingAdd(b, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(u32.wrappingAdd(a, u32.wrappingAdd(m13, u32.bitXor(0xa9e3e905, zero))), u32.bitAnd(c, u32.bitNot(d))), u32.bitAnd(b, d)), 5))
  d = u32.wrappingAdd(a, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(u32.wrappingAdd(d, u32.wrappingAdd(m2, u32.bitXor(0xfcefa3f8, zero))), u32.bitAnd(b, u32.bitNot(c))), u32.bitAnd(a, c)), 9))
  c = u32.wrappingAdd(d, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(u32.wrappingAdd(c, u32.wrappingAdd(m7, u32.bitXor(0x676f02d9, zero))), u32.bitAnd(a, u32.bitNot(b))), u32.bitAnd(d, b)), 14))
  b = u32.wrappingAdd(c, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(u32.wrappingAdd(b, u32.wrappingAdd(m12, u32.bitXor(0x8d2a4c8a, zero))), u32.bitAnd(d, u32.bitNot(a))), u32.bitAnd(c, a)), 20))
  a = u32.wrappingAdd(b, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(a, u32.wrappingAdd(m5, u32.bitXor(0xfffa3942, zero))), u32.bitXor(b, u32.bitXor(c, d))), 4))
  d = u32.wrappingAdd(a, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(d, u32.wrappingAdd(m8, u32.bitXor(0x8771f681, zero))), u32.bitXor(a, u32.bitXor(b, c))), 11))
  c = u32.wrappingAdd(d, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(c, u32.wrappingAdd(m11, u32.bitXor(0x6d9d6122, zero))), u32.bitXor(d, u32.bitXor(a, b))), 16))
  b = u32.wrappingAdd(c, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(b, u32.wrappingAdd(m14, u32.bitXor(0xfde5380c, zero))), u32.bitXor(c, u32.bitXor(d, a))), 23))
  a = u32.wrappingAdd(b, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(a, u32.wrappingAdd(m1, u32.bitXor(0xa4beea44, zero))), u32.bitXor(b, u32.bitXor(c, d))), 4))
  d = u32.wrappingAdd(a, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(d, u32.wrappingAdd(m4, u32.bitXor(0x4bdecfa9, zero))), u32.bitXor(a, u32.bitXor(b, c))), 11))
  c = u32.wrappingAdd(d, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(c, u32.wrappingAdd(m7, u32.bitXor(0xf6bb4b60, zero))), u32.bitXor(d, u32.bitXor(a, b))), 16))
  b = u32.wrappingAdd(c, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(b, u32.wrappingAdd(m10, u32.bitXor(0xbebfbc70, zero))), u32.bitXor(c, u32.bitXor(d, a))), 23))
  a = u32.wrappingAdd(b, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(a, u32.wrappingAdd(m13, u32.bitXor(0x289b7ec6, zero))), u32.bitXor(b, u32.bitXor(c, d))), 4))
  d = u32.wrappingAdd(a, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(d, u32.wrappingAdd(m0, u32.bitXor(0xeaa127fa, zero))), u32.bitXor(a, u32.bitXor(b, c))), 11))
  c = u32.wrappingAdd(d, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(c, u32.wrappingAdd(m3, u32.bitXor(0xd4ef3085, zero))), u32.bitXor(d, u32.bitXor(a, b))), 16))
  b = u32.wrappingAdd(c, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(b, u32.wrappingAdd(m6, u32.bitXor(0x04881d05, zero))), u32.bitXor(c, u32.bitXor(d, a))), 23))
  a = u32.wrappingAdd(b, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(a, u32.wrappingAdd(m9, u32.bitXor(0xd9d4d039, zero))), u32.bitXor(b, u32.bitXor(c, d))), 4))
  d = u32.wrappingAdd(a, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(d, u32.wrappingAdd(m12, u32.bitXor(0xe6db99e5, zero))), u32.bitXor(a, u32.bitXor(b, c))), 11))
  c = u32.wrappingAdd(d, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(c, u32.wrappingAdd(m15, u32.bitXor(0x1fa27cf8, zero))), u32.bitXor(d, u32.bitXor(a, b))), 16))
  b = u32.wrappingAdd(c, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(b, u32.wrappingAdd(m2, u32.bitXor(0xc4ac5665, zero))), u32.bitXor(c, u32.bitXor(d, a))), 23))
  a = u32.wrappingAdd(b, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(a, u32.wrappingAdd(m0, u32.bitXor(0xf4292244, zero))), u32.bitXor(c, u32.bitOr(b, u32.bitNot(d)))), 6))
  d = u32.wrappingAdd(a, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(d, u32.wrappingAdd(m7, u32.bitXor(0x432aff97, zero))), u32.bitXor(b, u32.bitOr(a, u32.bitNot(c)))), 10))
  c = u32.wrappingAdd(d, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(c, u32.wrappingAdd(m14, u32.bitXor(0xab9423a7, zero))), u32.bitXor(a, u32.bitOr(d, u32.bitNot(b)))), 15))
  b = u32.wrappingAdd(c, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(b, u32.wrappingAdd(m5, u32.bitXor(0xfc93a039, zero))), u32.bitXor(d, u32.bitOr(c, u32.bitNot(a)))), 21))
  a = u32.wrappingAdd(b, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(a, u32.wrappingAdd(m12, u32.bitXor(0x655b59c3, zero))), u32.bitXor(c, u32.bitOr(b, u32.bitNot(d)))), 6))
  d = u32.wrappingAdd(a, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(d, u32.wrappingAdd(m3, u32.bitXor(0x8f0ccc92, zero))), u32.bitXor(b, u32.bitOr(a, u32.bitNot(c)))), 10))
  c = u32.wrappingAdd(d, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(c, u32.wrappingAdd(m10, u32.bitXor(0xffeff47d, zero))), u32.bitXor(a, u32.bitOr(d, u32.bitNot(b)))), 15))
  b = u32.wrappingAdd(c, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(b, u32.wrappingAdd(m1, u32.bitXor(0x85845dd1, zero))), u32.bitXor(d, u32.bitOr(c, u32.bitNot(a)))), 21))
  a = u32.wrappingAdd(b, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(a, u32.wrappingAdd(m8, u32.bitXor(0x6fa87e4f, zero))), u32.bitXor(c, u32.bitOr(b, u32.bitNot(d)))), 6))
  d = u32.wrappingAdd(a, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(d, u32.wrappingAdd(m15, u32.bitXor(0xfe2ce6e0, zero))), u32.bitXor(b, u32.bitOr(a, u32.bitNot(c)))), 10))
  c = u32.wrappingAdd(d, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(c, u32.wrappingAdd(m6, u32.bitXor(0xa3014314, zero))), u32.bitXor(a, u32.bitOr(d, u32.bitNot(b)))), 15))
  b = u32.wrappingAdd(c, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(b, u32.wrappingAdd(m13, u32.bitXor(0x4e0811a1, zero))), u32.bitXor(d, u32.bitOr(c, u32.bitNot(a)))), 21))
  a = u32.wrappingAdd(b, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(a, u32.wrappingAdd(m4, u32.bitXor(0xf7537e82, zero))), u32.bitXor(c, u32.bitOr(b, u32.bitNot(d)))), 6))
  d = u32.wrappingAdd(a, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(d, u32.wrappingAdd(m11, u32.bitXor(0xbd3af235, zero))), u32.bitXor(b, u32.bitOr(a, u32.bitNot(c)))), 10))
  c = u32.wrappingAdd(d, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(c, u32.wrappingAdd(m2, u32.bitXor(0x2ad7d2bb, zero))), u32.bitXor(a, u32.bitOr(d, u32.bitNot(b)))), 15))
  b = u32.wrappingAdd(c, u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(b, u32.wrappingAdd(m9, u32.bitXor(0xeb86d391, zero))), u32.bitXor(d, u32.bitOr(c, u32.bitNot(a)))), 21))
  words[0] = u32.wrappingAdd(words[0], a)
  words[1] = u32.wrappingAdd(words[1], b)
  words[2] = u32.wrappingAdd(words[2], c)
  words[3] = u32.wrappingAdd(words[3], d)
}

impl Digest for Md5 {
  /// Returns a MD5 state for an empty message.
  make: Md5.make
  /// Adds `bytes` to the end of the message.
  update: Md5.update
  /// Returns 64, the MD5 block length in bytes.
  fn blockLength(self: &Self) -> usize {
    return 64
  }
  /// Returns 16, the MD5 digest length in bytes.
  fn digestLength(self: &Self) -> usize {
    return 16
  }
  /// Returns the content bytes of the MD5 object identifier, 1.2.840.113549.2.5.
  fn objectIdentifier(self: &Self) -> &[u8] {
    return b"\x2a\x86\x48\x86\xf7\x0d\x02\x05"
  }
  /// Returns an independent copy of the state.
  fn copy(self: &Self) -> Self {
    return Md5 {words: self.words, buffer: self.buffer, used: self.used, length: self.length}
  }
  /// Writes the 16-byte MD5 digest to the start of `output` and consumes the state.
  fn finishInto(self: Self, output: &mut [u8]) -> () {
    let digest = Md5.finish(move self)
    writeDigest(&digest, move output)
  }
}

// Writes `digest` to the start of `output` for `Digest.finishInto`.
fn writeDigest(digest: &[u8], output: &mut [u8]) -> () {
  let mut index: usize = 0
  while index < digest.length {
    output[index] = digest[index]
    index = index + 1
  }
}
