//! Compute MD5 digests for legacy formats, including UUID version 3.
//!
//! # When to use
//! Use [`Md5`] only for a format that requires MD5. Use SHA-256 for new cryptographic protocols.
//!
//! # Details
//! The streaming state does not allocate. Call `make`, `update`, and `finish`, or use `hash`.
//!
//! # Gotchas
//! MD5 permits deliberate collisions. It does not protect data against tampering.
//!
//! # Examples
//! ## Hash a message in parts
//! ```silk
//! import silk.crypto.md5 { Md5 }
//!
//! pub fn main() -> i32 {
//!   let mut state = Md5.make()
//!   state.update(b"a")
//!   state.update(b"bc")
//!   let digest = state.finish()
//!   if digest[0] != 0x90 || digest[15] != 0x72 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! # See also
//! [RFC 1321](https://www.rfc-editor.org/rfc/rfc1321.html) defines the MD5 algorithm.
//!
//! @category Cryptography

import silk.num.u32
import silk.num.u64
import silk.collections.slice { Slice }
import silk.num.u8
import silk.num.usize

/// A streaming MD5 state. It does not allocate and is unsuitable for security checks.
pub struct Md5 {
  words: [u32; 4],
  buffer: [u8; 64],
  used: usize,
  length: u64,
}

impl Md5 {
  /// Returns a state for an empty message.
  pub fn make() -> Self {
    return Md5 {
      words: [0x67452301, 0xefcdab89, 0x98badcfe, 0x10325476],
      buffer: [0; 64],
      used: 0,
      length: 0
    }
  }

  /// Adds bytes to the message. The length in bits wraps modulo 2^64, as MD5 requires.
  pub fn update(self: &mut Self, bytes: &[u8]) -> () {
    self.length = u64.wrappingAdd(self.length, u64.wrappingMultiply(usize.toU64(bytes.length), 8))
    let mut index: usize = 0
    while index < bytes.length {
      self.buffer[self.used] = bytes[index]
      self.used = self.used + 1
      index = index + 1
      if self.used == 64 {
        let block = self.buffer
        compress(&mut self, &block)
        self.used = 0
      }
    }
    return ()
  }

  /// Consumes the state and returns its 16-byte digest in MD5 byte order.
  pub fn finish(self: Self) -> [u8; 16] {
    let mut state = move self
    let bits = state.length
    let mut padding: [u8; 64] = [0; 64]
    padding[0] = 128
    let mut count: usize = 120 - state.used
    if state.used < 56 {
      count = 56 - state.used
    }
    state.update(Slice.view<u8>(&padding, 0, count))
    let mut lengthBytes: [u8; 8] = [0; 8]
    let mut index: usize = 0
    while index < 8 {
      lengthBytes[index] = u64.toU8(u64.bitAnd(u64.shiftRight(bits, usize.toU64(index * 8)), 255))
      index = index + 1
    }
    state.update(&lengthBytes)
    let mut digest: [u8; 16] = [0; 16]
    index = 0
    while index < 16 {
      digest[index] = u32.toU8(
        u32.bitAnd(
          u32.shiftRight(state.words[index / 4], usize.toU32(usize.remainder(index, 4) * 8)),
          255
        )
      )
      index = index + 1
    }
    return digest
  }

  /// Returns the 16-byte MD5 digest of `bytes`. It does not allocate.
  pub fn hash(bytes: &[u8]) -> [u8; 16] {
    let mut state = Md5.make()
    state.update(bytes)
    return state.finish()
  }
}

fn compress(state: &mut Md5, block: &[u8]) -> () {
  let constants: [u32; 64] = [
    0xd76aa478,
    0xe8c7b756,
    0x242070db,
    0xc1bdceee,
    0xf57c0faf,
    0x4787c62a,
    0xa8304613,
    0xfd469501,
    0x698098d8,
    0x8b44f7af,
    0xffff5bb1,
    0x895cd7be,
    0x6b901122,
    0xfd987193,
    0xa679438e,
    0x49b40821,
    0xf61e2562,
    0xc040b340,
    0x265e5a51,
    0xe9b6c7aa,
    0xd62f105d,
    0x2441453,
    0xd8a1e681,
    0xe7d3fbc8,
    0x21e1cde6,
    0xc33707d6,
    0xf4d50d87,
    0x455a14ed,
    0xa9e3e905,
    0xfcefa3f8,
    0x676f02d9,
    0x8d2a4c8a,
    0xfffa3942,
    0x8771f681,
    0x6d9d6122,
    0xfde5380c,
    0xa4beea44,
    0x4bdecfa9,
    0xf6bb4b60,
    0xbebfbc70,
    0x289b7ec6,
    0xeaa127fa,
    0xd4ef3085,
    0x4881d05,
    0xd9d4d039,
    0xe6db99e5,
    0x1fa27cf8,
    0xc4ac5665,
    0xf4292244,
    0x432aff97,
    0xab9423a7,
    0xfc93a039,
    0x655b59c3,
    0x8f0ccc92,
    0xffeff47d,
    0x85845dd1,
    0x6fa87e4f,
    0xfe2ce6e0,
    0xa3014314,
    0x4e0811a1,
    0xf7537e82,
    0xbd3af235,
    0x2ad7d2bb,
    0xeb86d391
  ]
  let shifts: [u32; 64] = [
    7,
    12,
    17,
    22,
    7,
    12,
    17,
    22,
    7,
    12,
    17,
    22,
    7,
    12,
    17,
    22,
    5,
    9,
    14,
    20,
    5,
    9,
    14,
    20,
    5,
    9,
    14,
    20,
    5,
    9,
    14,
    20,
    4,
    11,
    16,
    23,
    4,
    11,
    16,
    23,
    4,
    11,
    16,
    23,
    4,
    11,
    16,
    23,
    6,
    10,
    15,
    21,
    6,
    10,
    15,
    21,
    6,
    10,
    15,
    21,
    6,
    10,
    15,
    21
  ]
  let mut words: [u32; 16] = [0; 16]
  let mut index: usize = 0
  while index < 64 {
    let slot = index / 4
    words[slot] = u32.bitOr(
      words[slot],
      u32.shiftLeft(u8.toU32(block[index]), usize.toU32(usize.remainder(index, 4) * 8))
    )
    index = index + 1
  }
  let mut a = state.words[0]
  let mut b = state.words[1]
  let mut c = state.words[2]
  let mut d = state.words[3]
  index = 0
  while index < 64 {
    let mut f: u32 = 0
    let mut g = index
    if index < 16 {
      f = u32.bitOr(u32.bitAnd(b, c), u32.bitAnd(u32.bitNot(b), d))
    } else if index < 32 {
      f = u32.bitOr(u32.bitAnd(d, b), u32.bitAnd(u32.bitNot(d), c))
      g = usize.remainder(5 * index + 1, 16)
    } else if index < 48 {
      f = u32.bitXor(u32.bitXor(b, c), d)
      g = usize.remainder(3 * index + 5, 16)
    } else {
      f = u32.bitXor(c, u32.bitOr(b, u32.bitNot(d)))
      g = usize.remainder(7 * index, 16)
    }
    let sum = u32.wrappingAdd(u32.wrappingAdd(a, f), u32.wrappingAdd(constants[index], words[g]))
    a = d
    d = c
    c = b
    b = u32.wrappingAdd(b, u32.rotateLeft(sum, shifts[index]))
    index = index + 1
  }
  state.words[0] = u32.wrappingAdd(state.words[0], a)
  state.words[1] = u32.wrappingAdd(state.words[1], b)
  state.words[2] = u32.wrappingAdd(state.words[2], c)
  state.words[3] = u32.wrappingAdd(state.words[3], d)
  return ()
}
