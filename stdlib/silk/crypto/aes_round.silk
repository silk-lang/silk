//! The steps of an AES round on one 16-byte state, computed with portable code: SubBytes,
//! ShiftRows and MixColumns, and their inverses.
//!
//! # When to use
//! Use this module to check or replace the AES instructions of `silk.simd.x86` and
//! `silk.simd.aarch64` on a CPU without them. To encrypt data, use `silk.crypto.aes_gcm`.
//!
//! # Details
//! A state holds the AES state matrix column by column, as FIPS 197 and the AES instructions
//! do: lane `4 * c + r` is row `r` of column `c`. SubBytes computes each byte's inverse in
//! GF(2^8) instead of reading a table, so its time does not depend on the data.
//!
//! # Examples
//! ## Substitute one state
//! ```silk
//! import silk.crypto.aes_round
//! import silk.simd.u8x16
//!
//! pub fn main() -> i32 {
//!   let substituted = aes_round.subBytes(u8x16.splat(0))
//!   if u8x16.extract(substituted, 5) != 99 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Cryptography

import silk.simd.u8x16
import silk.simd.u32x4
import silk.num.u32

// One independent GF(2^8) element in each byte. Multiplying a 0-or-1 bit
// in each byte by a byte constant cannot carry into the next element.
const LOW_BITS: u32 = 0x01010101

fn xtime(value: u32) -> u32 {
  let high = u32.shiftRight(value, 7) & LOW_BITS
  return (u32.shiftLeft(value, 1) & 0xfefefefe) ^ u32.wrappingMultiply(high, 0x1b)
}

fn multiply(left: u32, right: u32) -> u32 {
  let mut a = left
  let mut b = right
  let mut result: u32 = 0
  let mut index: usize = 0
  while index < 8 {
    let mask = u32.wrappingMultiply(b & LOW_BITS, 255)
    result = u32.bitXor(result, u32.bitAnd(a, mask))
    a = xtime(a)
    b = u32.shiftRight(b, 1)
    index = index + 1
  }
  return result
}

// Squaring in GF(2^8) doubles each polynomial exponent. The low nibble spreads
// into bits 0, 2, 4 and 6. Modulo the AES polynomial 0x11b, the four high bits
// contribute x^8, x^10, x^12 and x^14, respectively.
fn square(value: u32) -> u32 {
  let low = value & 0x0f0f0f0f
  let pairs = (low | u32.shiftLeft(low, 2)) & 0x33333333
  let even = (pairs | u32.shiftLeft(pairs, 1)) & 0x55555555
  let b4 = u32.wrappingMultiply(u32.shiftRight(value, 4) & LOW_BITS, 0x1b)
  let b5 = u32.wrappingMultiply(u32.shiftRight(value, 5) & LOW_BITS, 0x6c)
  let b6 = u32.wrappingMultiply(u32.shiftRight(value, 6) & LOW_BITS, 0xab)
  let b7 = u32.wrappingMultiply(u32.shiftRight(value, 7) & LOW_BITS, 0x9a)
  return even ^ b4 ^ b5 ^ b6 ^ b7
}

// x^254 is the multiplicative inverse, and maps zero to zero. This addition
// chain takes seven squarings and four general multiplications.
fn inverse(value: u32) -> u32 {
  let x2 = square(value)
  let x3 = multiply(value, x2)
  let x12 = square(square(x3))
  let x15 = multiply(x12, x3)
  let x240 = square(square(square(square(x15))))
  return multiply(multiply(x240, x12), x2)
}

// Rotates each byte left by count bits. The mask keeps the two shifts within each byte.
fn rotate(value: u32, count: u32) -> u32 {
  let low = u32.wrappingMultiply(u32.shiftLeft(1, count) - 1, LOW_BITS)
  return (u32.shiftLeft(value, count) & u32.bitNot(low)) | (u32.shiftRight(value, 8 - count) & low)
}

fn substitute(value: u32) -> u32 {
  let x = inverse(value)
  let affine = u32.bitXor(u32.bitXor(x, rotate(x, 1)), u32.bitXor(u32.bitXor(rotate(x, 2), rotate(x, 3)), rotate(x, 4)))
  return u32.bitXor(affine, 0x63636363)
}

fn substituteInverse(value: u32) -> u32 {
  let affine = u32.bitXor(u32.bitXor(rotate(value, 1), rotate(value, 3)), rotate(value, 6))
  return inverse(u32.bitXor(affine, 0x05050505))
}

/// SubBytes: each byte replaced by its AES S-box value.
///
/// It computes each byte's inverse in GF(2^8) instead of reading a table, so its time does not
/// depend on the data.
pub fn subBytes(state: simd<u8, 16>) -> simd<u8, 16> {
  let mut columns = u32x4.toArray(u8x16.bitcastToU32x4(state))
  let mut at: usize = 0
  while at < 4 {
    columns[at] = substitute(columns[at])
    at = at + 1
  }
  return u32x4.bitcastToU8x16(u32x4.fromArray(columns))
}

/// InvSubBytes: each byte replaced by its inverse S-box value.
///
/// It computes each byte's inverse in GF(2^8) instead of reading a table, so its time does not
/// depend on the data.
pub fn inverseSubBytes(state: simd<u8, 16>) -> simd<u8, 16> {
  let mut columns = u32x4.toArray(u8x16.bitcastToU32x4(state))
  let mut at: usize = 0
  while at < 4 {
    columns[at] = substituteInverse(columns[at])
    at = at + 1
  }
  return u32x4.bitcastToU8x16(u32x4.fromArray(columns))
}

/// ShiftRows: row `r` rotated left by `r` columns.
///
/// The state holds the AES state matrix column by column: lane `4 * c + r` is row `r` of column
/// `c`, as in FIPS 197.
pub fn shiftRows(state: simd<u8, 16>) -> simd<u8, 16> {
  return u8x16.shuffle(state, state, [0, 5, 10, 15, 4, 9, 14, 3, 8, 13, 2, 7, 12, 1, 6, 11])
}

/// InvShiftRows: row `r` rotated right by `r` columns.
///
/// The state holds the AES state matrix column by column: lane `4 * c + r` is row `r` of column
/// `c`, as in FIPS 197.
pub fn inverseShiftRows(state: simd<u8, 16>) -> simd<u8, 16> {
  return u8x16.shuffle(state, state, [0, 13, 10, 7, 4, 1, 14, 11, 8, 5, 2, 15, 12, 9, 6, 3])
}

// For a column a,b,c,d, the first row is a ^ (a^b^c^d) ^ xtime(a^b).
// Rotating one byte supplies each row's neighbor; rotating two pairs the differences.
fn mixColumn(column: u32) -> u32 {
  let adjacent = column ^ u32.rotateRight(column, 8)
  return column ^ adjacent ^ u32.rotateRight(adjacent, 16) ^ xtime(adjacent)
}

/// MixColumns: each column multiplied by the AES MixColumns matrix.
///
/// The state holds the AES state matrix column by column: lane `4 * c + r` is row `r` of column
/// `c`, as in FIPS 197.
pub fn mixColumns(state: simd<u8, 16>) -> simd<u8, 16> {
  let mut columns = u32x4.toArray(u8x16.bitcastToU32x4(state))
  let mut at: usize = 0
  while at < 4 {
    columns[at] = mixColumn(columns[at])
    at = at + 1
  }
  return u32x4.bitcastToU8x16(u32x4.fromArray(columns))
}

/// InvMixColumns: each column multiplied by the inverse MixColumns matrix.
///
/// The state holds the AES state matrix column by column: lane `4 * c + r` is row `r` of column
/// `c`, as in FIPS 197.
pub fn inverseMixColumns(state: simd<u8, 16>) -> simd<u8, 16> {
  let mut columns = u32x4.toArray(u8x16.bitcastToU32x4(state))
  let mut at: usize = 0
  while at < 4 {
    let column = columns[at]
    // Preconditioning opposite rows with 4*(a^c) and 4*(b^d) gives the inverse matrix.
    columns[at] = mixColumn(column ^ xtime(xtime(column ^ u32.rotateRight(column, 16))))
    at = at + 1
  }
  return u32x4.bitcastToU8x16(u32x4.fromArray(columns))
}
