//! The steps of an AES round on one 16-byte state, computed with portable code: SubBytes,
//! ShiftRows and MixColumns, and their inverses.
//!
//! # When to use
//! Use this module to check or replace the AES instructions of `silk.simd.x86` and
//! `silk.simd.aarch64` on a CPU without them. To encrypt data, use `silk.crypto.aes_gcm`.
//!
//! # Details
//! A state holds the AES state matrix column by column, as FIPS 197 and the AES instructions
//! do: lane `4 * c + r` is row `r` of column `c`. SubBytes computes each byte's inverse in
//! GF(2^8) instead of reading a table, so its time does not depend on the data.
//!
//! # Examples
//! ## Substitute one state
//! ```silk
//! import silk.crypto.aes_round
//! import silk.simd.u8x16
//!
//! pub fn main() -> i32 {
//!   let substituted = aes_round.subBytes(u8x16.splat(0))
//!   if u8x16.extract(substituted, 5) != 99 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Cryptography

import silk.simd.u8x16
import silk.num.u8
import silk.num.u32

// All GF(2^8) values stay in the low byte.
fn xtime(value: u32) -> u32 {
  let mask = u32.wrappingSubtract(0, u32.shiftRight(value, 7))
  return u32.bitAnd(u32.bitXor(u32.shiftLeft(value, 1), u32.bitAnd(mask, 27)), 255)
}

fn multiply(left: u32, right: u32) -> u32 {
  let mut a = left
  let mut b = right
  let mut result: u32 = 0
  let mut index: usize = 0
  while index < 8 {
    let mask = u32.wrappingSubtract(0, u32.bitAnd(b, 1))
    result = u32.bitXor(result, u32.bitAnd(a, mask))
    a = xtime(a)
    b = u32.shiftRight(b, 1)
    index = index + 1
  }
  return result
}

// x^254 is the multiplicative inverse, and maps zero to zero.
fn inverse(value: u32) -> u32 {
  let x2 = multiply(value, value)
  let x4 = multiply(x2, x2)
  let x8 = multiply(x4, x4)
  let x16 = multiply(x8, x8)
  let x32 = multiply(x16, x16)
  let x64 = multiply(x32, x32)
  let x128 = multiply(x64, x64)
  let a = multiply(multiply(x2, x4), multiply(x8, x16))
  let b = multiply(multiply(x32, x64), x128)
  return multiply(a, b)
}

// The byte `value` rotated left by `count` bits.
fn rotate(value: u32, count: u32) -> u32 {
  return u32.bitAnd(u32.bitOr(u32.shiftLeft(value, count), u32.shiftRight(value, 8 - count)), 255)
}

fn substitute(value: u32) -> u32 {
  let x = inverse(value)
  let affine = u32.bitXor(u32.bitXor(x, rotate(x, 1)), u32.bitXor(u32.bitXor(rotate(x, 2), rotate(x, 3)), rotate(x, 4)))
  return u32.bitXor(affine, 99)
}

fn substituteInverse(value: u32) -> u32 {
  let affine = u32.bitXor(u32.bitXor(rotate(value, 1), rotate(value, 3)), rotate(value, 6))
  return inverse(u32.bitXor(affine, 5))
}

/// SubBytes: each byte replaced by its AES S-box value.
///
/// It computes each byte's inverse in GF(2^8) instead of reading a table, so its time does not
/// depend on the data.
pub fn subBytes(state: simd<u8, 16>) -> simd<u8, 16> {
  let mut lanes = u8x16.toArray(state)
  let mut at: usize = 0
  while at < 16 {
    lanes[at] = u32.toU8(substitute(u8.toU32(lanes[at])))
    at = at + 1
  }
  return u8x16.fromArray(lanes)
}

/// InvSubBytes: each byte replaced by its inverse S-box value.
///
/// It computes each byte's inverse in GF(2^8) instead of reading a table, so its time does not
/// depend on the data.
pub fn inverseSubBytes(state: simd<u8, 16>) -> simd<u8, 16> {
  let mut lanes = u8x16.toArray(state)
  let mut at: usize = 0
  while at < 16 {
    lanes[at] = u32.toU8(substituteInverse(u8.toU32(lanes[at])))
    at = at + 1
  }
  return u8x16.fromArray(lanes)
}

/// ShiftRows: row `r` rotated left by `r` columns.
///
/// The state holds the AES state matrix column by column: lane `4 * c + r` is row `r` of column
/// `c`, as in FIPS 197.
pub fn shiftRows(state: simd<u8, 16>) -> simd<u8, 16> {
  return u8x16.shuffle(state, state, [0, 5, 10, 15, 4, 9, 14, 3, 8, 13, 2, 7, 12, 1, 6, 11])
}

/// InvShiftRows: row `r` rotated right by `r` columns.
///
/// The state holds the AES state matrix column by column: lane `4 * c + r` is row `r` of column
/// `c`, as in FIPS 197.
pub fn inverseShiftRows(state: simd<u8, 16>) -> simd<u8, 16> {
  return u8x16.shuffle(state, state, [0, 13, 10, 7, 4, 1, 14, 11, 8, 5, 2, 15, 12, 9, 6, 3])
}

// Each column times the circulant matrix whose first row is `first`, `second`, `third`, `fourth`.
fn mixWith(state: simd<u8, 16>, first: u32, second: u32, third: u32, fourth: u32) -> simd<u8, 16> {
  let input = u8x16.toArray(state)
  let mut lanes = u8x16.toArray(state)
  let mut column: usize = 0
  while column < 16 {
    let mut row: usize = 0
    while row < 4 {
      let a = u8.toU32(input[column + row])
      let b = u8.toU32(input[column + (row + 1) % 4])
      let c = u8.toU32(input[column + (row + 2) % 4])
      let d = u8.toU32(input[column + (row + 3) % 4])
      let mixed = u32.bitXor(u32.bitXor(multiply(a, first), multiply(b, second)), u32.bitXor(multiply(c, third), multiply(d, fourth)))
      lanes[column + row] = u32.toU8(mixed)
      row = row + 1
    }
    column = column + 4
  }
  return u8x16.fromArray(lanes)
}

/// MixColumns: each column multiplied by the AES MixColumns matrix.
///
/// The state holds the AES state matrix column by column: lane `4 * c + r` is row `r` of column
/// `c`, as in FIPS 197.
pub fn mixColumns(state: simd<u8, 16>) -> simd<u8, 16> {
  return mixWith(state, 2, 3, 1, 1)
}

/// InvMixColumns: each column multiplied by the inverse MixColumns matrix.
///
/// The state holds the AES state matrix column by column: lane `4 * c + r` is row `r` of column
/// `c`, as in FIPS 197.
pub fn inverseMixColumns(state: simd<u8, 16>) -> simd<u8, 16> {
  return mixWith(state, 14, 11, 13, 9)
}
