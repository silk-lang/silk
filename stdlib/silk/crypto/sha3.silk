  /// Returns a SHA3-256 state for an empty message.
  make: Sha3_256.make
  /// Adds `bytes` to the end of the message.
  update: Sha3_256.update
  /// Returns 136, the SHA3-256 block length in bytes.
  fn blockLength(self: &Self) -> usize {
