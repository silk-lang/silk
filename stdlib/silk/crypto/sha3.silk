//! Compute SHA-3 digests (SHA3-224, SHA3-256, SHA3-384, SHA3-512) and the SHAKE128 and SHAKE256
//! extendable-output functions (FIPS 202).
//!
//! # When to use
//! Use these types when a protocol names SHA-3. For a general cryptographic hash,
//! `silk.crypto.sha2` is more common. Use `silk.collections.hash` for the keys of a hash map.
//!
//! # Details
//! [`Sha3_224`], [`Sha3_256`], [`Sha3_384`], and [`Sha3_512`] return 28, 32, 48, and 64 bytes. Each
//! type has the same functions: `hash` returns the digest of one slice, and `make`, `update`, and
//! `finish` hash a message that arrives in parts. The states are fixed-size values and nothing
//! allocates. There is no length limit.
//!
//! [`Shake128`] and [`Shake256`] return as many bytes as the caller asks for. `finishInto` fills
//! the whole output slice, so a 16-byte slice gives the 16-byte SHAKE128 output that Node's
//! `createHash("shake128")` returns by default. A shorter output is a prefix of a longer one.
//!
//! # Gotchas
//! SHA-3 is not Keccak-256 as Ethereum uses it: the padding is different, so the digests are
//! different.
//!
//! # Examples
//! ## Hash a message in one call and in parts
//! ```silk
//! import silk.crypto.sha3 { Sha3_256 }
//!
//! pub fn main() -> i32 {
//!   let oneShot = Sha3_256.hash(b"abc")
//!   let mut state = Sha3_256.make()
//!   state.update(b"a")
//!   state.update(b"bc")
//!   let streamed = state.finish()
//!
//!   // SHA3-256("abc") is 3a985da7...1532.
//!   if oneShot[0] != 0x3a || oneShot[31] != 0x32 || streamed[31] != oneShot[31] {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Cryptography

import silk.num.u64
import silk.crypto.digest {Digest}
import silk.num.u8
import silk.num.usize
import silk.encoding.endian
import silk.core.target {Arch, Target}
import silk.simd.cpu {CpuFeatures}

struct Sponge {
  lanes: [u64; 25],
  offset: usize,
}

fn emptyLanes() -> [u64; 25] {
  return [0; 25]
}

fn makeSponge() -> Sponge {
  return Sponge {lanes: emptyLanes(), offset: usize.ZERO}
}

fn roundConstants() -> [u64; 24] {
  return [
    0x0000000000000001,
    0x0000000000008082,
    0x800000000000808a,
    0x8000000080008000,
    0x000000000000808b,
    0x0000000080000001,
    0x8000000080008081,
    0x8000000000008009,
    0x000000000000008a,
    0x0000000000000088,
    0x0000000080008009,
    0x000000008000000a,
    0x000000008000808b,
    0x800000000000008b,
    0x8000000000008089,
    0x8000000000008003,
    0x8000000000008002,
    0x8000000000000080,
    0x000000000000800a,
    0x800000008000000a,
    0x8000000080008081,
    0x8000000000008080,
    0x0000000080000001,
    0x8000000080008008,
  ]
}

// Keccak-f[1600] on the 25 lanes, with BMI1 and BMI2 when the machine has them.
fn permute(lanes: &mut [u64; 25]) -> () {
  static if Target.arch() == Arch.X86_64 {
    if CpuFeatures.available("bmi") && CpuFeatures.available("bmi2") {
      unsafe permuteBmi(&mut lanes)
      return ()
    }
  }
  permutePortable(&mut lanes)
}

// Keccak-f[1600] on the 25 lanes. Two rounds per iteration move the state between the `a` and
// `e` lanes, one plane at a time, so few values are live at once. Six lanes are complemented
// inside, which removes most NOT operations from chi (the lane complementing transform).
fn permutePortable(lanes: &mut [u64; 25]) -> () {
  let constants = roundConstants()
  let mut a0 = lanes[0]
  let mut a1 = u64.bitNot(lanes[1])
  let mut a2 = u64.bitNot(lanes[2])
  let mut a3 = lanes[3]
  let mut a4 = lanes[4]
  let mut a5 = lanes[5]
  let mut a6 = lanes[6]
  let mut a7 = lanes[7]
  let mut a8 = u64.bitNot(lanes[8])
  let mut a9 = lanes[9]
  let mut a10 = lanes[10]
  let mut a11 = lanes[11]
  let mut a12 = u64.bitNot(lanes[12])
  let mut a13 = lanes[13]
  let mut a14 = lanes[14]
  let mut a15 = lanes[15]
  let mut a16 = lanes[16]
  let mut a17 = u64.bitNot(lanes[17])
  let mut a18 = lanes[18]
  let mut a19 = lanes[19]
  let mut a20 = u64.bitNot(lanes[20])
  let mut a21 = lanes[21]
  let mut a22 = lanes[22]
  let mut a23 = lanes[23]
  let mut a24 = lanes[24]
  let mut e0: u64 = 0
  let mut e1: u64 = 0
  let mut e2: u64 = 0
  let mut e3: u64 = 0
  let mut e4: u64 = 0
  let mut e5: u64 = 0
  let mut e6: u64 = 0
  let mut e7: u64 = 0
  let mut e8: u64 = 0
  let mut e9: u64 = 0
  let mut e10: u64 = 0
  let mut e11: u64 = 0
  let mut e12: u64 = 0
  let mut e13: u64 = 0
  let mut e14: u64 = 0
  let mut e15: u64 = 0
  let mut e16: u64 = 0
  let mut e17: u64 = 0
  let mut e18: u64 = 0
  let mut e19: u64 = 0
  let mut e20: u64 = 0
  let mut e21: u64 = 0
  let mut e22: u64 = 0
  let mut e23: u64 = 0
  let mut e24: u64 = 0
  let mut round = usize.ZERO
  while round < 24 {
    let cp0 = u64.bitXor(u64.bitXor(u64.bitXor(a0, a5), u64.bitXor(a10, a15)), a20)
    let cp1 = u64.bitXor(u64.bitXor(u64.bitXor(a1, a6), u64.bitXor(a11, a16)), a21)
    let cp2 = u64.bitXor(u64.bitXor(u64.bitXor(a2, a7), u64.bitXor(a12, a17)), a22)
    let cp3 = u64.bitXor(u64.bitXor(u64.bitXor(a3, a8), u64.bitXor(a13, a18)), a23)
    let cp4 = u64.bitXor(u64.bitXor(u64.bitXor(a4, a9), u64.bitXor(a14, a19)), a24)
    let dp0 = u64.bitXor(cp4, u64.rotateLeft(cp1, 1))
    let dp1 = u64.bitXor(cp0, u64.rotateLeft(cp2, 1))
    let dp2 = u64.bitXor(cp1, u64.rotateLeft(cp3, 1))
    let dp3 = u64.bitXor(cp2, u64.rotateLeft(cp4, 1))
    let dp4 = u64.bitXor(cp3, u64.rotateLeft(cp0, 1))
    let bp00 = u64.bitXor(a0, dp0)
    let bp01 = u64.rotateLeft(u64.bitXor(a6, dp1), 44)
    let bp02 = u64.rotateLeft(u64.bitXor(a12, dp2), 43)
    let bp03 = u64.rotateLeft(u64.bitXor(a18, dp3), 21)
    let bp04 = u64.rotateLeft(u64.bitXor(a24, dp4), 14)
    e0 = u64.bitXor(u64.bitXor(bp00, u64.bitOr(bp01, bp02)), constants[round])
    e1 = u64.bitXor(bp01, u64.bitOr(u64.bitNot(bp02), bp03))
    e2 = u64.bitXor(bp02, u64.bitAnd(bp03, bp04))
    e3 = u64.bitXor(bp03, u64.bitOr(bp04, bp00))
    e4 = u64.bitXor(bp04, u64.bitAnd(bp00, bp01))
    let bp10 = u64.rotateLeft(u64.bitXor(a3, dp3), 28)
    let bp11 = u64.rotateLeft(u64.bitXor(a9, dp4), 20)
    let bp12 = u64.rotateLeft(u64.bitXor(a10, dp0), 3)
    let bp13 = u64.rotateLeft(u64.bitXor(a16, dp1), 45)
    let bp14 = u64.rotateLeft(u64.bitXor(a22, dp2), 61)
    e5 = u64.bitXor(bp10, u64.bitOr(bp11, bp12))
    e6 = u64.bitXor(bp11, u64.bitAnd(bp12, bp13))
    e7 = u64.bitXor(bp12, u64.bitOr(bp13, u64.bitNot(bp14)))
    e8 = u64.bitXor(bp13, u64.bitOr(bp14, bp10))
    e9 = u64.bitXor(bp14, u64.bitAnd(bp10, bp11))
    let bp20 = u64.rotateLeft(u64.bitXor(a1, dp1), 1)
    let bp21 = u64.rotateLeft(u64.bitXor(a7, dp2), 6)
    let bp22 = u64.rotateLeft(u64.bitXor(a13, dp3), 25)
    let bp23 = u64.rotateLeft(u64.bitXor(a19, dp4), 8)
    let bp24 = u64.rotateLeft(u64.bitXor(a20, dp0), 18)
    e10 = u64.bitXor(bp20, u64.bitOr(bp21, bp22))
    e11 = u64.bitXor(bp21, u64.bitAnd(bp22, bp23))
    e12 = u64.bitXor(bp22, u64.bitAnd(u64.bitNot(bp23), bp24))
    e13 = u64.bitXor(u64.bitNot(bp23), u64.bitOr(bp24, bp20))
    e14 = u64.bitXor(bp24, u64.bitAnd(bp20, bp21))
    let bp30 = u64.rotateLeft(u64.bitXor(a4, dp4), 27)
    let bp31 = u64.rotateLeft(u64.bitXor(a5, dp0), 36)
    let bp32 = u64.rotateLeft(u64.bitXor(a11, dp1), 10)
    let bp33 = u64.rotateLeft(u64.bitXor(a17, dp2), 15)
    let bp34 = u64.rotateLeft(u64.bitXor(a23, dp3), 56)
    e15 = u64.bitXor(bp30, u64.bitAnd(bp31, bp32))
    e16 = u64.bitXor(bp31, u64.bitOr(bp32, bp33))
    e17 = u64.bitXor(bp32, u64.bitOr(u64.bitNot(bp33), bp34))
    e18 = u64.bitXor(u64.bitNot(bp33), u64.bitAnd(bp34, bp30))
    e19 = u64.bitXor(bp34, u64.bitOr(bp30, bp31))
    let bp40 = u64.rotateLeft(u64.bitXor(a2, dp2), 62)
    let bp41 = u64.rotateLeft(u64.bitXor(a8, dp3), 55)
    let bp42 = u64.rotateLeft(u64.bitXor(a14, dp4), 39)
    let bp43 = u64.rotateLeft(u64.bitXor(a15, dp0), 41)
    let bp44 = u64.rotateLeft(u64.bitXor(a21, dp1), 2)
    e20 = u64.bitXor(bp40, u64.bitAnd(u64.bitNot(bp41), bp42))
    e21 = u64.bitXor(u64.bitNot(bp41), u64.bitOr(bp42, bp43))
    e22 = u64.bitXor(bp42, u64.bitAnd(bp43, bp44))
    e23 = u64.bitXor(bp43, u64.bitOr(bp44, bp40))
    e24 = u64.bitXor(bp44, u64.bitAnd(bp40, bp41))
    let cq0 = u64.bitXor(u64.bitXor(u64.bitXor(e0, e5), u64.bitXor(e10, e15)), e20)
    let cq1 = u64.bitXor(u64.bitXor(u64.bitXor(e1, e6), u64.bitXor(e11, e16)), e21)
    let cq2 = u64.bitXor(u64.bitXor(u64.bitXor(e2, e7), u64.bitXor(e12, e17)), e22)
    let cq3 = u64.bitXor(u64.bitXor(u64.bitXor(e3, e8), u64.bitXor(e13, e18)), e23)
    let cq4 = u64.bitXor(u64.bitXor(u64.bitXor(e4, e9), u64.bitXor(e14, e19)), e24)
    let dq0 = u64.bitXor(cq4, u64.rotateLeft(cq1, 1))
    let dq1 = u64.bitXor(cq0, u64.rotateLeft(cq2, 1))
    let dq2 = u64.bitXor(cq1, u64.rotateLeft(cq3, 1))
    let dq3 = u64.bitXor(cq2, u64.rotateLeft(cq4, 1))
    let dq4 = u64.bitXor(cq3, u64.rotateLeft(cq0, 1))
    let bq00 = u64.bitXor(e0, dq0)
    let bq01 = u64.rotateLeft(u64.bitXor(e6, dq1), 44)
    let bq02 = u64.rotateLeft(u64.bitXor(e12, dq2), 43)
    let bq03 = u64.rotateLeft(u64.bitXor(e18, dq3), 21)
    let bq04 = u64.rotateLeft(u64.bitXor(e24, dq4), 14)
    a0 = u64.bitXor(u64.bitXor(bq00, u64.bitOr(bq01, bq02)), constants[round + 1])
    a1 = u64.bitXor(bq01, u64.bitOr(u64.bitNot(bq02), bq03))
    a2 = u64.bitXor(bq02, u64.bitAnd(bq03, bq04))
    a3 = u64.bitXor(bq03, u64.bitOr(bq04, bq00))
    a4 = u64.bitXor(bq04, u64.bitAnd(bq00, bq01))
    let bq10 = u64.rotateLeft(u64.bitXor(e3, dq3), 28)
    let bq11 = u64.rotateLeft(u64.bitXor(e9, dq4), 20)
    let bq12 = u64.rotateLeft(u64.bitXor(e10, dq0), 3)
    let bq13 = u64.rotateLeft(u64.bitXor(e16, dq1), 45)
    let bq14 = u64.rotateLeft(u64.bitXor(e22, dq2), 61)
    a5 = u64.bitXor(bq10, u64.bitOr(bq11, bq12))
    a6 = u64.bitXor(bq11, u64.bitAnd(bq12, bq13))
    a7 = u64.bitXor(bq12, u64.bitOr(bq13, u64.bitNot(bq14)))
    a8 = u64.bitXor(bq13, u64.bitOr(bq14, bq10))
    a9 = u64.bitXor(bq14, u64.bitAnd(bq10, bq11))
    let bq20 = u64.rotateLeft(u64.bitXor(e1, dq1), 1)
    let bq21 = u64.rotateLeft(u64.bitXor(e7, dq2), 6)
    let bq22 = u64.rotateLeft(u64.bitXor(e13, dq3), 25)
    let bq23 = u64.rotateLeft(u64.bitXor(e19, dq4), 8)
    let bq24 = u64.rotateLeft(u64.bitXor(e20, dq0), 18)
    a10 = u64.bitXor(bq20, u64.bitOr(bq21, bq22))
    a11 = u64.bitXor(bq21, u64.bitAnd(bq22, bq23))
    a12 = u64.bitXor(bq22, u64.bitAnd(u64.bitNot(bq23), bq24))
    a13 = u64.bitXor(u64.bitNot(bq23), u64.bitOr(bq24, bq20))
    a14 = u64.bitXor(bq24, u64.bitAnd(bq20, bq21))
    let bq30 = u64.rotateLeft(u64.bitXor(e4, dq4), 27)
    let bq31 = u64.rotateLeft(u64.bitXor(e5, dq0), 36)
    let bq32 = u64.rotateLeft(u64.bitXor(e11, dq1), 10)
    let bq33 = u64.rotateLeft(u64.bitXor(e17, dq2), 15)
    let bq34 = u64.rotateLeft(u64.bitXor(e23, dq3), 56)
    a15 = u64.bitXor(bq30, u64.bitAnd(bq31, bq32))
    a16 = u64.bitXor(bq31, u64.bitOr(bq32, bq33))
    a17 = u64.bitXor(bq32, u64.bitOr(u64.bitNot(bq33), bq34))
    a18 = u64.bitXor(u64.bitNot(bq33), u64.bitAnd(bq34, bq30))
    a19 = u64.bitXor(bq34, u64.bitOr(bq30, bq31))
    let bq40 = u64.rotateLeft(u64.bitXor(e2, dq2), 62)
    let bq41 = u64.rotateLeft(u64.bitXor(e8, dq3), 55)
    let bq42 = u64.rotateLeft(u64.bitXor(e14, dq4), 39)
    let bq43 = u64.rotateLeft(u64.bitXor(e15, dq0), 41)
    let bq44 = u64.rotateLeft(u64.bitXor(e21, dq1), 2)
    a20 = u64.bitXor(bq40, u64.bitAnd(u64.bitNot(bq41), bq42))
    a21 = u64.bitXor(u64.bitNot(bq41), u64.bitOr(bq42, bq43))
    a22 = u64.bitXor(bq42, u64.bitAnd(bq43, bq44))
    a23 = u64.bitXor(bq43, u64.bitOr(bq44, bq40))
    a24 = u64.bitXor(bq44, u64.bitAnd(bq40, bq41))
    round = round + 2
  }
  lanes[0] = a0
  lanes[1] = u64.bitNot(a1)
  lanes[2] = u64.bitNot(a2)
  lanes[3] = a3
  lanes[4] = a4
  lanes[5] = a5
  lanes[6] = a6
  lanes[7] = a7
  lanes[8] = u64.bitNot(a8)
  lanes[9] = a9
  lanes[10] = a10
  lanes[11] = a11
  lanes[12] = u64.bitNot(a12)
  lanes[13] = a13
  lanes[14] = a14
  lanes[15] = a15
  lanes[16] = a16
  lanes[17] = u64.bitNot(a17)
  lanes[18] = a18
  lanes[19] = a19
  lanes[20] = u64.bitNot(a20)
  lanes[21] = a21
  lanes[22] = a22
  lanes[23] = a23
  lanes[24] = a24
}


static if Target.arch() == Arch.X86_64 {
  @features("bmi", "bmi2")
  unsafe fn permuteBmi(lanes: &mut [u64; 25]) -> () {
    let constants = roundConstants()
    let mut a0 = lanes[0]
    let mut a1 = lanes[1]
    let mut a2 = lanes[2]
    let mut a3 = lanes[3]
    let mut a4 = lanes[4]
    let mut a5 = lanes[5]
    let mut a6 = lanes[6]
    let mut a7 = lanes[7]
    let mut a8 = lanes[8]
    let mut a9 = lanes[9]
    let mut a10 = lanes[10]
    let mut a11 = lanes[11]
    let mut a12 = lanes[12]
    let mut a13 = lanes[13]
    let mut a14 = lanes[14]
    let mut a15 = lanes[15]
    let mut a16 = lanes[16]
    let mut a17 = lanes[17]
    let mut a18 = lanes[18]
    let mut a19 = lanes[19]
    let mut a20 = lanes[20]
    let mut a21 = lanes[21]
    let mut a22 = lanes[22]
    let mut a23 = lanes[23]
    let mut a24 = lanes[24]
    let mut e0: u64 = 0
    let mut e1: u64 = 0
    let mut e2: u64 = 0
    let mut e3: u64 = 0
    let mut e4: u64 = 0
    let mut e5: u64 = 0
    let mut e6: u64 = 0
    let mut e7: u64 = 0
    let mut e8: u64 = 0
    let mut e9: u64 = 0
    let mut e10: u64 = 0
    let mut e11: u64 = 0
    let mut e12: u64 = 0
    let mut e13: u64 = 0
    let mut e14: u64 = 0
    let mut e15: u64 = 0
    let mut e16: u64 = 0
    let mut e17: u64 = 0
    let mut e18: u64 = 0
    let mut e19: u64 = 0
    let mut e20: u64 = 0
    let mut e21: u64 = 0
    let mut e22: u64 = 0
    let mut e23: u64 = 0
    let mut e24: u64 = 0
    let mut round = usize.ZERO
    while round < 24 {
      let cp0 = u64.bitXor(u64.bitXor(u64.bitXor(a0, a5), u64.bitXor(a10, a15)), a20)
      let cp1 = u64.bitXor(u64.bitXor(u64.bitXor(a1, a6), u64.bitXor(a11, a16)), a21)
      let cp2 = u64.bitXor(u64.bitXor(u64.bitXor(a2, a7), u64.bitXor(a12, a17)), a22)
      let cp3 = u64.bitXor(u64.bitXor(u64.bitXor(a3, a8), u64.bitXor(a13, a18)), a23)
      let cp4 = u64.bitXor(u64.bitXor(u64.bitXor(a4, a9), u64.bitXor(a14, a19)), a24)
      let dp0 = u64.bitXor(cp4, u64.rotateLeft(cp1, 1))
      let dp1 = u64.bitXor(cp0, u64.rotateLeft(cp2, 1))
      let dp2 = u64.bitXor(cp1, u64.rotateLeft(cp3, 1))
      let dp3 = u64.bitXor(cp2, u64.rotateLeft(cp4, 1))
      let dp4 = u64.bitXor(cp3, u64.rotateLeft(cp0, 1))
      let bp00 = u64.bitXor(a0, dp0)
      let bp01 = u64.rotateLeft(u64.bitXor(a6, dp1), 44)
      let bp02 = u64.rotateLeft(u64.bitXor(a12, dp2), 43)
      let bp03 = u64.rotateLeft(u64.bitXor(a18, dp3), 21)
      let bp04 = u64.rotateLeft(u64.bitXor(a24, dp4), 14)
      e0 = u64.bitXor(u64.bitXor(bp00, u64.bitAnd(u64.bitNot(bp01), bp02)), constants[round])
      e1 = u64.bitXor(bp01, u64.bitAnd(u64.bitNot(bp02), bp03))
      e2 = u64.bitXor(bp02, u64.bitAnd(u64.bitNot(bp03), bp04))
      e3 = u64.bitXor(bp03, u64.bitAnd(u64.bitNot(bp04), bp00))
      e4 = u64.bitXor(bp04, u64.bitAnd(u64.bitNot(bp00), bp01))
      let bp10 = u64.rotateLeft(u64.bitXor(a3, dp3), 28)
      let bp11 = u64.rotateLeft(u64.bitXor(a9, dp4), 20)
      let bp12 = u64.rotateLeft(u64.bitXor(a10, dp0), 3)
      let bp13 = u64.rotateLeft(u64.bitXor(a16, dp1), 45)
      let bp14 = u64.rotateLeft(u64.bitXor(a22, dp2), 61)
      e5 = u64.bitXor(bp10, u64.bitAnd(u64.bitNot(bp11), bp12))
      e6 = u64.bitXor(bp11, u64.bitAnd(u64.bitNot(bp12), bp13))
      e7 = u64.bitXor(bp12, u64.bitAnd(u64.bitNot(bp13), bp14))
      e8 = u64.bitXor(bp13, u64.bitAnd(u64.bitNot(bp14), bp10))
      e9 = u64.bitXor(bp14, u64.bitAnd(u64.bitNot(bp10), bp11))
      let bp20 = u64.rotateLeft(u64.bitXor(a1, dp1), 1)
      let bp21 = u64.rotateLeft(u64.bitXor(a7, dp2), 6)
      let bp22 = u64.rotateLeft(u64.bitXor(a13, dp3), 25)
      let bp23 = u64.rotateLeft(u64.bitXor(a19, dp4), 8)
      let bp24 = u64.rotateLeft(u64.bitXor(a20, dp0), 18)
      e10 = u64.bitXor(bp20, u64.bitAnd(u64.bitNot(bp21), bp22))
      e11 = u64.bitXor(bp21, u64.bitAnd(u64.bitNot(bp22), bp23))
      e12 = u64.bitXor(bp22, u64.bitAnd(u64.bitNot(bp23), bp24))
      e13 = u64.bitXor(bp23, u64.bitAnd(u64.bitNot(bp24), bp20))
      e14 = u64.bitXor(bp24, u64.bitAnd(u64.bitNot(bp20), bp21))
      let bp30 = u64.rotateLeft(u64.bitXor(a4, dp4), 27)
      let bp31 = u64.rotateLeft(u64.bitXor(a5, dp0), 36)
      let bp32 = u64.rotateLeft(u64.bitXor(a11, dp1), 10)
      let bp33 = u64.rotateLeft(u64.bitXor(a17, dp2), 15)
      let bp34 = u64.rotateLeft(u64.bitXor(a23, dp3), 56)
      e15 = u64.bitXor(bp30, u64.bitAnd(u64.bitNot(bp31), bp32))
      e16 = u64.bitXor(bp31, u64.bitAnd(u64.bitNot(bp32), bp33))
      e17 = u64.bitXor(bp32, u64.bitAnd(u64.bitNot(bp33), bp34))
      e18 = u64.bitXor(bp33, u64.bitAnd(u64.bitNot(bp34), bp30))
      e19 = u64.bitXor(bp34, u64.bitAnd(u64.bitNot(bp30), bp31))
      let bp40 = u64.rotateLeft(u64.bitXor(a2, dp2), 62)
      let bp41 = u64.rotateLeft(u64.bitXor(a8, dp3), 55)
      let bp42 = u64.rotateLeft(u64.bitXor(a14, dp4), 39)
      let bp43 = u64.rotateLeft(u64.bitXor(a15, dp0), 41)
      let bp44 = u64.rotateLeft(u64.bitXor(a21, dp1), 2)
      e20 = u64.bitXor(bp40, u64.bitAnd(u64.bitNot(bp41), bp42))
      e21 = u64.bitXor(bp41, u64.bitAnd(u64.bitNot(bp42), bp43))
      e22 = u64.bitXor(bp42, u64.bitAnd(u64.bitNot(bp43), bp44))
      e23 = u64.bitXor(bp43, u64.bitAnd(u64.bitNot(bp44), bp40))
      e24 = u64.bitXor(bp44, u64.bitAnd(u64.bitNot(bp40), bp41))
      let cq0 = u64.bitXor(u64.bitXor(u64.bitXor(e0, e5), u64.bitXor(e10, e15)), e20)
      let cq1 = u64.bitXor(u64.bitXor(u64.bitXor(e1, e6), u64.bitXor(e11, e16)), e21)
      let cq2 = u64.bitXor(u64.bitXor(u64.bitXor(e2, e7), u64.bitXor(e12, e17)), e22)
      let cq3 = u64.bitXor(u64.bitXor(u64.bitXor(e3, e8), u64.bitXor(e13, e18)), e23)
      let cq4 = u64.bitXor(u64.bitXor(u64.bitXor(e4, e9), u64.bitXor(e14, e19)), e24)
      let dq0 = u64.bitXor(cq4, u64.rotateLeft(cq1, 1))
      let dq1 = u64.bitXor(cq0, u64.rotateLeft(cq2, 1))
      let dq2 = u64.bitXor(cq1, u64.rotateLeft(cq3, 1))
      let dq3 = u64.bitXor(cq2, u64.rotateLeft(cq4, 1))
      let dq4 = u64.bitXor(cq3, u64.rotateLeft(cq0, 1))
      let bq00 = u64.bitXor(e0, dq0)
      let bq01 = u64.rotateLeft(u64.bitXor(e6, dq1), 44)
      let bq02 = u64.rotateLeft(u64.bitXor(e12, dq2), 43)
      let bq03 = u64.rotateLeft(u64.bitXor(e18, dq3), 21)
      let bq04 = u64.rotateLeft(u64.bitXor(e24, dq4), 14)
      a0 = u64.bitXor(u64.bitXor(bq00, u64.bitAnd(u64.bitNot(bq01), bq02)), constants[round + 1])
      a1 = u64.bitXor(bq01, u64.bitAnd(u64.bitNot(bq02), bq03))
      a2 = u64.bitXor(bq02, u64.bitAnd(u64.bitNot(bq03), bq04))
      a3 = u64.bitXor(bq03, u64.bitAnd(u64.bitNot(bq04), bq00))
      a4 = u64.bitXor(bq04, u64.bitAnd(u64.bitNot(bq00), bq01))
      let bq10 = u64.rotateLeft(u64.bitXor(e3, dq3), 28)
      let bq11 = u64.rotateLeft(u64.bitXor(e9, dq4), 20)
      let bq12 = u64.rotateLeft(u64.bitXor(e10, dq0), 3)
      let bq13 = u64.rotateLeft(u64.bitXor(e16, dq1), 45)
      let bq14 = u64.rotateLeft(u64.bitXor(e22, dq2), 61)
      a5 = u64.bitXor(bq10, u64.bitAnd(u64.bitNot(bq11), bq12))
      a6 = u64.bitXor(bq11, u64.bitAnd(u64.bitNot(bq12), bq13))
      a7 = u64.bitXor(bq12, u64.bitAnd(u64.bitNot(bq13), bq14))
      a8 = u64.bitXor(bq13, u64.bitAnd(u64.bitNot(bq14), bq10))
      a9 = u64.bitXor(bq14, u64.bitAnd(u64.bitNot(bq10), bq11))
      let bq20 = u64.rotateLeft(u64.bitXor(e1, dq1), 1)
      let bq21 = u64.rotateLeft(u64.bitXor(e7, dq2), 6)
      let bq22 = u64.rotateLeft(u64.bitXor(e13, dq3), 25)
      let bq23 = u64.rotateLeft(u64.bitXor(e19, dq4), 8)
      let bq24 = u64.rotateLeft(u64.bitXor(e20, dq0), 18)
      a10 = u64.bitXor(bq20, u64.bitAnd(u64.bitNot(bq21), bq22))
      a11 = u64.bitXor(bq21, u64.bitAnd(u64.bitNot(bq22), bq23))
      a12 = u64.bitXor(bq22, u64.bitAnd(u64.bitNot(bq23), bq24))
      a13 = u64.bitXor(bq23, u64.bitAnd(u64.bitNot(bq24), bq20))
      a14 = u64.bitXor(bq24, u64.bitAnd(u64.bitNot(bq20), bq21))
      let bq30 = u64.rotateLeft(u64.bitXor(e4, dq4), 27)
      let bq31 = u64.rotateLeft(u64.bitXor(e5, dq0), 36)
      let bq32 = u64.rotateLeft(u64.bitXor(e11, dq1), 10)
      let bq33 = u64.rotateLeft(u64.bitXor(e17, dq2), 15)
      let bq34 = u64.rotateLeft(u64.bitXor(e23, dq3), 56)
      a15 = u64.bitXor(bq30, u64.bitAnd(u64.bitNot(bq31), bq32))
      a16 = u64.bitXor(bq31, u64.bitAnd(u64.bitNot(bq32), bq33))
      a17 = u64.bitXor(bq32, u64.bitAnd(u64.bitNot(bq33), bq34))
      a18 = u64.bitXor(bq33, u64.bitAnd(u64.bitNot(bq34), bq30))
      a19 = u64.bitXor(bq34, u64.bitAnd(u64.bitNot(bq30), bq31))
      let bq40 = u64.rotateLeft(u64.bitXor(e2, dq2), 62)
      let bq41 = u64.rotateLeft(u64.bitXor(e8, dq3), 55)
      let bq42 = u64.rotateLeft(u64.bitXor(e14, dq4), 39)
      let bq43 = u64.rotateLeft(u64.bitXor(e15, dq0), 41)
      let bq44 = u64.rotateLeft(u64.bitXor(e21, dq1), 2)
      a20 = u64.bitXor(bq40, u64.bitAnd(u64.bitNot(bq41), bq42))
      a21 = u64.bitXor(bq41, u64.bitAnd(u64.bitNot(bq42), bq43))
      a22 = u64.bitXor(bq42, u64.bitAnd(u64.bitNot(bq43), bq44))
      a23 = u64.bitXor(bq43, u64.bitAnd(u64.bitNot(bq44), bq40))
      a24 = u64.bitXor(bq44, u64.bitAnd(u64.bitNot(bq40), bq41))
      round = round + 2
    }
    lanes[0] = a0
    lanes[1] = a1
    lanes[2] = a2
    lanes[3] = a3
    lanes[4] = a4
    lanes[5] = a5
    lanes[6] = a6
    lanes[7] = a7
    lanes[8] = a8
    lanes[9] = a9
    lanes[10] = a10
    lanes[11] = a11
    lanes[12] = a12
    lanes[13] = a13
    lanes[14] = a14
    lanes[15] = a15
    lanes[16] = a16
    lanes[17] = a17
    lanes[18] = a18
    lanes[19] = a19
    lanes[20] = a20
    lanes[21] = a21
    lanes[22] = a22
    lanes[23] = a23
    lanes[24] = a24
  }

}

fn absorbByte(state: &mut Sponge, value: u8, offset: usize) -> () {
  let lane = offset / 8
  let shift = usize.toU64((offset % 8) * 8)
  let positioned = u64.shiftLeft(u8.toU64(value), shift)
  state.lanes[lane] = u64.bitXor(state.lanes[lane], positioned)
}

// Absorbs a partial block byte by byte, then whole blocks a lane at a time straight from `bytes`,
// then the rest byte by byte.
fn absorb(state: &mut Sponge, bytes: &[u8], rate: usize) -> () {
  let mut index = usize.ZERO
  while state.offset != usize.ZERO && index < bytes.length {
    let offset = state.offset
    absorbByte(&mut state.*, bytes[index], offset)
    state.offset = offset + 1
    if state.offset == rate {
      permute(&mut state.lanes)
      state.offset = usize.ZERO
    }
    index = index + 1
  }
  let lanes = rate / 8
  while bytes.length - index >= rate {
    let mut lane = usize.ZERO
    while lane < lanes {
      state.lanes[lane] = u64.bitXor(state.lanes[lane], endian.readU64LittleEndian(bytes, index + lane * 8))
      lane = lane + 1
    }
    permute(&mut state.lanes)
    index = index + rate
  }
  while index < bytes.length {
    let offset = state.offset
    absorbByte(&mut state.*, bytes[index], offset)
    state.offset = offset + 1
    index = index + 1
  }
}

fn finalize(state: &mut Sponge, rate: usize) -> () {
  return pad(&mut state.*, rate, u8.toU8(0x06))
}

// Pads the message with the domain bits `suffix` (0x06 for SHA-3, 0x1f for SHAKE) and the final
// bit of pad10*1, then permutes so the first output block is ready.
fn pad(state: &mut Sponge, rate: usize, suffix: u8) -> () {
  let offset = state.offset
  absorbByte(&mut state.*, suffix, offset)
  absorbByte(&mut state.*, u8.toU8(0x80), rate - 1)
  permute(&mut state.lanes)
  state.offset = usize.ZERO
}

fn outputByte(state: &Sponge, offset: usize) -> u8 {
  let lane = offset / 8
  let shift = usize.toU64((offset % 8) * 8)
  return u64.toU8(u64.bitAnd(u64.shiftRight(state.lanes[lane], shift), 0xff))
}

// Writes the next `output.length` bytes of the padded sponge's output, permuting after each
// `rate` bytes. Whole lanes are written as words.
fn squeeze(state: &mut Sponge, output: &mut [u8], rate: usize) -> () {
  let mut index = usize.ZERO
  while index < output.length {
    if state.offset == rate {
      permute(&mut state.lanes)
      state.offset = usize.ZERO
    }
    let offset = state.offset
    if offset % 8 == 0 && output.length - index >= 8 {
      endian.writeU64LittleEndian(&mut output, index, state.lanes[offset / 8])
      state.offset = offset + 8
      index = index + 8
    } else {
      output[index] = outputByte(&state.*, offset)
      state.offset = offset + 1
      index = index + 1
    }
  }
}

fn emptyOutput28() -> [u8; 28] {
  return [0; 28]
}

fn emptyOutput32() -> [u8; 32] {
  return [0; 32]
}

fn emptyOutput48() -> [u8; 48] {
  return [0; 48]
}

fn emptyOutput64() -> [u8; 64] {
  return [0; 64]
}

fn output28(state: &Sponge) -> [u8; 28] {
  let mut output = emptyOutput28()
  let mut index = usize.ZERO
  while index < 28 {
    output[index] = outputByte(state, index)
    index = index + 1
  }
  return output
}

fn output32(state: &Sponge) -> [u8; 32] {
  let mut output = emptyOutput32()
  let mut index = usize.ZERO
  while index < 32 {
    output[index] = outputByte(state, index)
    index = index + 1
  }
  return output
}

fn output48(state: &Sponge) -> [u8; 48] {
  let mut output = emptyOutput48()
  let mut index = usize.ZERO
  while index < 48 {
    output[index] = outputByte(state, index)
    index = index + 1
  }
  return output
}

fn output64(state: &Sponge) -> [u8; 64] {
  let mut output = emptyOutput64()
  let mut index = usize.ZERO
  while index < 64 {
    output[index] = outputByte(state, index)
    index = index + 1
  }
  return output
}

/// A streaming SHA3-224 state that returns a 28-byte digest.
///
/// Call [`Sha3_224.update`] for each part of the message, then [`Sha3_224.finish`]. Use
/// [`Sha3_224.hash`] when the full message is in one slice. The state is a fixed-size value and
/// does not allocate.
///
/// # Gotchas
/// It is not Keccak-256 as Ethereum uses it: the padding is different, so the digests are
/// different.
pub struct Sha3_224 {
  sponge: Sponge,
}

impl Sha3_224 {
  /// Returns a SHA3-224 state for an empty message.
  pub fn make() -> Sha3_224 {
    return Sha3_224 {sponge: makeSponge()}
  }
  /// Adds `bytes` to the end of the message. Any split of the message into parts gives the same
  /// digest. An empty slice changes nothing.
  pub fn update(self: &mut Self, bytes: &[u8]) -> () {
    return absorb(&mut self.sponge, bytes, 144)
  }
  /// Returns the 28-byte SHA3-224 digest of the message and consumes the state.
  pub fn finish(self: Self) -> [u8; 28] {
    let mut state = move self.sponge
    finalize(&mut state, 144)
    return output28(&state)
  }
  /// Returns the 28-byte SHA3-224 digest of `bytes`.
  pub fn hash(bytes: &[u8]) -> [u8; 28] {
    let mut state = Sha3_224.make()
    state.update(bytes)
    return state.finish()
  }
}

