  let tt2_12 = u32.wrappingAdd(u32.wrappingAdd(u32.bitXor(u32.bitXor(e, f), g), h), u32.wrappingAdd(ss1_12, w12))
  d = c
  c = u32.rotateLeft(b, 9)
  b = a
