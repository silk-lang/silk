  let ss1_5 = u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(rotated5, e), 0x3988a32f), 7)
  let tt1_5 = u32.wrappingAdd(u32.wrappingAdd(u32.bitXor(u32.bitXor(a, b), c), d), u32.wrappingAdd(u32.bitXor(ss1_5, rotated5), u32.bitXor(w5, w9)))
  let tt2_5 = u32.wrappingAdd(u32.wrappingAdd(u32.bitXor(u32.bitXor(e, f), g), h), u32.wrappingAdd(ss1_5, w5))
