//! Compute SM3 digests (GB/T 32905-2016), the hash of the Chinese commercial cryptography suite.
//!
//! # When to use
//! Use [`Sm3`] where a protocol or format names SM3, such as SM2 signatures or the TLS 1.3
//! ShangMi suites of RFC 8998. Use SHA-256 elsewhere.
//!
//! # Details
//! The streaming state does not allocate. Call `make`, `update`, and `finish`, or use `hash`. The
//! digest is 32 bytes.
//!
//! # Examples
//! ## Hash a message in parts
//! ```silk
//! import silk.crypto.sm3 { Sm3 }
//!
//! pub fn main() -> i32 {
//!   let mut state = Sm3.make()
//!   state.update(b"a")
//!   state.update(b"bc")
//!   let digest = state.finish()
//!   // SM3("abc") is 66c7f0f4...a8e0.
//!   if digest[0] != 0x66 || digest[31] != 0xe0 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! # See also
//! [RFC 8998](https://www.rfc-editor.org/rfc/rfc8998.html) and the
//! [SM3 draft](https://datatracker.ietf.org/doc/html/draft-sca-cfrg-sm3) describe the algorithm.
//!
//! @category Cryptography

import silk.num.u32
import silk.crypto.digest {Digest}
import silk.num.u64
import silk.collections.slice { Slice }
import silk.num.u8
import silk.num.usize

/// A streaming SM3 state that returns a 32-byte digest. It does not allocate.
pub struct Sm3 {
  words: [u32; 8],
  buffer: [u8; 64],
  used: usize,
  length: u64,
}

impl Sm3 {
  /// Returns a state for an empty message.
  pub fn make() -> Self {
    return Sm3 {
      words: [0x7380166f, 0x4914b2b9, 0x172442d7, 0xda8a0600, 0xa96f30bc, 0x163138aa, 0xe38dee4d, 0xb0fb0e4e],
      buffer: [0; 64],
      used: 0,
      length: 0
    }
  }

  /// Adds bytes to the message. The length in bits wraps modulo 2^64.
  pub fn update(self: &mut Self, bytes: &[u8]) -> () {
    self.length = u64.wrappingAdd(self.length, u64.wrappingMultiply(usize.toU64(bytes.length), 8))
    let mut index: usize = 0
    while index < bytes.length {
      self.buffer[self.used] = bytes[index]
      self.used = self.used + 1
      index = index + 1
      if self.used == 64 {
        let block = self.buffer
        compress(&mut self, &block)
        self.used = 0
      }
    }
    return ()
  }

  /// Consumes the state and returns its 32-byte digest.
  pub fn finish(self: Self) -> [u8; 32] {
    let mut state = move self
    let bits = state.length
    let mut padding: [u8; 64] = [0; 64]
    padding[0] = 128
    let mut count: usize = 120 - state.used
    if state.used < 56 {
      count = 56 - state.used
    }
    state.update(Slice.view<u8>(&padding, 0, count))
    let mut lengthBytes: [u8; 8] = [0; 8]
    let mut index: usize = 0
    while index < 8 {
      lengthBytes[index] = u64.toU8(u64.bitAnd(u64.shiftRight(bits, usize.toU64((7 - index) * 8)), 255))
      index = index + 1
    }
    state.update(&lengthBytes)
    let mut digest: [u8; 32] = [0; 32]
    index = 0
    while index < 32 {
      let shift = usize.toU32((3 - usize.remainder(index, 4)) * 8)
      digest[index] = u32.toU8(u32.bitAnd(u32.shiftRight(state.words[index / 4], shift), 255))
      index = index + 1
    }
    return digest
  }

  /// Returns the 32-byte SM3 digest of `bytes`. It does not allocate.
  pub fn hash(bytes: &[u8]) -> [u8; 32] {
    let mut state = Sm3.make()
    state.update(bytes)
    return state.finish()
  }
}

fn permuteZero(x: u32) -> u32 {
  return u32.bitXor(u32.bitXor(x, u32.rotateLeft(x, 9)), u32.rotateLeft(x, 17))
}

fn permuteOne(x: u32) -> u32 {
  return u32.bitXor(u32.bitXor(x, u32.rotateLeft(x, 15)), u32.rotateLeft(x, 23))
}

fn compress(state: &mut Sm3, block: &[u8]) -> () {
  let mut expanded: [u32; 68] = [0; 68]
  let mut index: usize = 0
  while index < 16 {
    let base = index * 4
    expanded[index] = u32.bitOr(
      u32.bitOr(u32.shiftLeft(u8.toU32(block[base]), 24), u32.shiftLeft(u8.toU32(block[base + 1]), 16)),
      u32.bitOr(u32.shiftLeft(u8.toU32(block[base + 2]), 8), u8.toU32(block[base + 3]))
    )
    index = index + 1
  }
  while index < 68 {
    let mixed = u32.bitXor(
      u32.bitXor(expanded[index - 16], expanded[index - 9]),
      u32.rotateLeft(expanded[index - 3], 15)
    )
    expanded[index] = u32.bitXor(
      u32.bitXor(permuteOne(mixed), u32.rotateLeft(expanded[index - 13], 7)),
      expanded[index - 6]
    )
    index = index + 1
  }
  let mut a = state.words[0]
  let mut b = state.words[1]
  let mut c = state.words[2]
  let mut d = state.words[3]
  let mut e = state.words[4]
  let mut f = state.words[5]
  let mut g = state.words[6]
  let mut h = state.words[7]
  let mut step: usize = 0
  while step < 64 {
    let mut constant: u32 = 0x7a879d8a
    if step < 16 {
      constant = 0x79cc4519
    }
    let rotatedA = u32.rotateLeft(a, 12)
    let ss1 = u32.rotateLeft(
      u32.wrappingAdd(u32.wrappingAdd(rotatedA, e), u32.rotateLeft(constant, usize.toU32(step % 32))),
      7
    )
    let ss2 = u32.bitXor(ss1, rotatedA)
    let mut ff = u32.bitXor(u32.bitXor(a, b), c)
    let mut gg = u32.bitXor(u32.bitXor(e, f), g)
    if step >= 16 {
      ff = u32.bitOr(u32.bitOr(u32.bitAnd(a, b), u32.bitAnd(a, c)), u32.bitAnd(b, c))
      gg = u32.bitOr(u32.bitAnd(e, f), u32.bitAnd(u32.bitNot(e), g))
    }
    let paired = u32.bitXor(expanded[step], expanded[step + 4])
    let tt1 = u32.wrappingAdd(u32.wrappingAdd(ff, d), u32.wrappingAdd(ss2, paired))
    let tt2 = u32.wrappingAdd(u32.wrappingAdd(gg, h), u32.wrappingAdd(ss1, expanded[step]))
    d = c
    c = u32.rotateLeft(b, 9)
    b = a
    a = tt1
    h = g
    g = u32.rotateLeft(f, 19)
    f = e
    e = permuteZero(tt2)
    step = step + 1
  }
  state.words[0] = u32.bitXor(state.words[0], a)
  state.words[1] = u32.bitXor(state.words[1], b)
  state.words[2] = u32.bitXor(state.words[2], c)
  state.words[3] = u32.bitXor(state.words[3], d)
  state.words[4] = u32.bitXor(state.words[4], e)
  state.words[5] = u32.bitXor(state.words[5], f)
  state.words[6] = u32.bitXor(state.words[6], g)
  state.words[7] = u32.bitXor(state.words[7], h)
  return ()
}

impl Digest for Sm3 {
  /// Returns an SM3 state for an empty message.
  make: Sm3.make
  /// Adds `bytes` to the end of the message.
  update: Sm3.update
  /// Returns 64, the SM3 block length in bytes.
  fn blockLength(self: &Self) -> usize {
    return 64
  }
  /// Returns 32, the SM3 digest length in bytes.
  fn digestLength(self: &Self) -> usize {
    return 32
  }
  /// Returns the content bytes of the SM3 object identifier, 1.2.156.10197.1.401.
  fn objectIdentifier(self: &Self) -> &[u8] {
    return b"\x2a\x81\x1c\xcf\x55\x01\x83\x11"
  }
  /// Returns an independent copy of the state.
  fn copy(self: &Self) -> Self {
    return Sm3 {words: self.words, buffer: self.buffer, used: self.used, length: self.length}
  }
  /// Writes the 32-byte SM3 digest to the start of `output` and consumes the state.
  fn finishInto(self: Self, output: &mut [u8]) -> () {
    let digest = Sm3.finish(move self)
    writeDigest(&digest, move output)
  }
}

// Writes `digest` to the start of `output` for `Digest.finishInto`.
fn writeDigest(digest: &[u8], output: &mut [u8]) -> () {
  let mut index: usize = 0
  while index < digest.length {
    output[index] = digest[index]
    index = index + 1
  }
}
