  h = g
  g = u32.rotateLeft(f, 19)
  f = e
  e = u32.bitXor(u32.bitXor(tt2_12, u32.rotateLeft(tt2_12, 9)), u32.rotateLeft(tt2_12, 17))
  let mixed17 = u32.bitXor(u32.bitXor(w1, w8), u32.rotateLeft(w14, 15))
  w1 = u32.bitXor(u32.bitXor(u32.bitXor(u32.bitXor(mixed17, u32.rotateLeft(mixed17, 15)), u32.rotateLeft(mixed17, 23)), u32.rotateLeft(w4, 7)), w11)
