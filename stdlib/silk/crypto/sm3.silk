  a = tt1_3
  h = g
  g = u32.rotateLeft(f, 19)
  f = e
  e = u32.bitXor(u32.bitXor(tt2_3, u32.rotateLeft(tt2_3, 9)), u32.rotateLeft(tt2_3, 17))
  let rotated4 = u32.rotateLeft(a, 12)
  let ss1_4 = u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(rotated4, e), 0x9cc45197), 7)
  let tt1_4 = u32.wrappingAdd(u32.wrappingAdd(u32.bitXor(u32.bitXor(a, b), c), d), u32.wrappingAdd(u32.bitXor(ss1_4, rotated4), u32.bitXor(w4, w8)))
  let tt2_4 = u32.wrappingAdd(u32.wrappingAdd(u32.bitXor(u32.bitXor(e, f), g), h), u32.wrappingAdd(ss1_4, w4))
  d = c
  c = u32.rotateLeft(b, 9)
  b = a
  a = tt1_4
  h = g
  g = u32.rotateLeft(f, 19)
  f = e
  e = u32.bitXor(u32.bitXor(tt2_4, u32.rotateLeft(tt2_4, 9)), u32.rotateLeft(tt2_4, 17))
