  let tt1_16 = u32.wrappingAdd(u32.wrappingAdd(u32.bitXor(b, u32.bitAnd(u32.bitXor(a, b), u32.bitXor(b, c))), d), u32.wrappingAdd(u32.bitXor(ss1_16, rotated16), u32.bitXor(w0, w4)))
  let tt2_16 = u32.wrappingAdd(u32.wrappingAdd(u32.bitXor(g, u32.bitAnd(e, u32.bitXor(f, g))), h), u32.wrappingAdd(ss1_16, w0))
  d = c
  c = u32.rotateLeft(b, 9)
  b = a
  a = tt1_16
