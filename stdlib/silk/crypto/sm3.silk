  let tt1_6 = u32.wrappingAdd(u32.wrappingAdd(u32.bitXor(u32.bitXor(a, b), c), d), u32.wrappingAdd(u32.bitXor(ss1_6, rotated6), u32.bitXor(w6, w10)))
  let tt2_6 = u32.wrappingAdd(u32.wrappingAdd(u32.bitXor(u32.bitXor(e, f), g), h), u32.wrappingAdd(ss1_6, w6))
  d = c
  c = u32.rotateLeft(b, 9)
  b = a
  a = tt1_6
  h = g
  g = u32.rotateLeft(f, 19)
  f = e
  e = u32.bitXor(u32.bitXor(tt2_6, u32.rotateLeft(tt2_6, 9)), u32.rotateLeft(tt2_6, 17))
  let rotated7 = u32.rotateLeft(a, 12)
  let ss1_7 = u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(rotated7, e), 0xe6228cbc), 7)
  let tt1_7 = u32.wrappingAdd(u32.wrappingAdd(u32.bitXor(u32.bitXor(a, b), c), d), u32.wrappingAdd(u32.bitXor(ss1_7, rotated7), u32.bitXor(w7, w11)))
  let tt2_7 = u32.wrappingAdd(u32.wrappingAdd(u32.bitXor(u32.bitXor(e, f), g), h), u32.wrappingAdd(ss1_7, w7))
  d = c
  c = u32.rotateLeft(b, 9)
  b = a
  a = tt1_7
  h = g
  g = u32.rotateLeft(f, 19)
  f = e
  e = u32.bitXor(u32.bitXor(tt2_7, u32.rotateLeft(tt2_7, 9)), u32.rotateLeft(tt2_7, 17))
  let rotated8 = u32.rotateLeft(a, 12)
  let ss1_8 = u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(rotated8, e), 0xcc451979), 7)
  let tt1_8 = u32.wrappingAdd(u32.wrappingAdd(u32.bitXor(u32.bitXor(a, b), c), d), u32.wrappingAdd(u32.bitXor(ss1_8, rotated8), u32.bitXor(w8, w12)))
  let tt2_8 = u32.wrappingAdd(u32.wrappingAdd(u32.bitXor(u32.bitXor(e, f), g), h), u32.wrappingAdd(ss1_8, w8))
  d = c
  c = u32.rotateLeft(b, 9)
  b = a
  a = tt1_8
  h = g
  g = u32.rotateLeft(f, 19)
  f = e
  e = u32.bitXor(u32.bitXor(tt2_8, u32.rotateLeft(tt2_8, 9)), u32.rotateLeft(tt2_8, 17))
  let rotated9 = u32.rotateLeft(a, 12)
  let ss1_9 = u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(rotated9, e), 0x988a32f3), 7)
  let tt1_9 = u32.wrappingAdd(u32.wrappingAdd(u32.bitXor(u32.bitXor(a, b), c), d), u32.wrappingAdd(u32.bitXor(ss1_9, rotated9), u32.bitXor(w9, w13)))
  let tt2_9 = u32.wrappingAdd(u32.wrappingAdd(u32.bitXor(u32.bitXor(e, f), g), h), u32.wrappingAdd(ss1_9, w9))
  d = c
  c = u32.rotateLeft(b, 9)
  b = a
  a = tt1_9
  h = g
  g = u32.rotateLeft(f, 19)
  f = e
  e = u32.bitXor(u32.bitXor(tt2_9, u32.rotateLeft(tt2_9, 9)), u32.rotateLeft(tt2_9, 17))
