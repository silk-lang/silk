  e = u32.bitXor(u32.bitXor(tt2_10, u32.rotateLeft(tt2_10, 9)), u32.rotateLeft(tt2_10, 17))
  let rotated11 = u32.rotateLeft(a, 12)
  let ss1_11 = u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(rotated11, e), 0x6228cbce), 7)
  let tt1_11 = u32.wrappingAdd(u32.wrappingAdd(u32.bitXor(u32.bitXor(a, b), c), d), u32.wrappingAdd(u32.bitXor(ss1_11, rotated11), u32.bitXor(w11, w15)))
  let tt2_11 = u32.wrappingAdd(u32.wrappingAdd(u32.bitXor(u32.bitXor(e, f), g), h), u32.wrappingAdd(ss1_11, w11))
