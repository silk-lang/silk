  w4 = u32.bitXor(u32.bitXor(u32.bitXor(u32.bitXor(mixed20, u32.rotateLeft(mixed20, 15)), u32.rotateLeft(mixed20, 23)), u32.rotateLeft(w7, 7)), w14)
  let rotated16 = u32.rotateLeft(a, 12)
