//! Compute SM3 digests (GB/T 32905-2016), the hash of the Chinese commercial cryptography suite.
//!
//! # When to use
//! Use [`Sm3`] where a protocol or format names SM3, such as SM2 signatures or the TLS 1.3
//! ShangMi suites of RFC 8998. Use SHA-256 elsewhere.
//!
//! # Details
//! The streaming state does not allocate. Call `make`, `update`, and `finish`, or use `hash`. The
//! digest is 32 bytes.
//!
//! # Examples
//! ## Hash a message in parts
//! ```silk
//! import silk.crypto.sm3 { Sm3 }
//!
//! pub fn main() -> i32 {
//!   let mut state = Sm3.make()
//!   state.update(b"a")
//!   state.update(b"bc")
//!   let digest = state.finish()
//!   // SM3("abc") is 66c7f0f4...a8e0.
//!   if digest[0] != 0x66 || digest[31] != 0xe0 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! # See also
//! [RFC 8998](https://www.rfc-editor.org/rfc/rfc8998.html) and the
//! [SM3 draft](https://datatracker.ietf.org/doc/html/draft-sca-cfrg-sm3) describe the algorithm.
//!
//! @category Cryptography

import silk.num.u32
import silk.crypto.digest {Digest}
import silk.num.u64
import silk.collections.slice { Slice }
import silk.num.u8
import silk.num.usize
import silk.encoding.endian

/// A streaming SM3 state that returns a 32-byte digest. It does not allocate.
pub struct Sm3 {
  words: [u32; 8],
  buffer: [u8; 64],
  used: usize,
  length: u64,
}

impl Sm3 {
  /// Returns a state for an empty message.
  pub fn make() -> Self {
    return Sm3 {
      words: [0x7380166f, 0x4914b2b9, 0x172442d7, 0xda8a0600, 0xa96f30bc, 0x163138aa, 0xe38dee4d, 0xb0fb0e4e],
      buffer: [0; 64],
      used: 0,
      length: 0
    }
  }

  /// Adds bytes to the message. The length in bits wraps modulo 2^64.
  pub fn update(self: &mut Self, bytes: &[u8]) -> () {
    self.length = u64.wrappingAdd(self.length, u64.wrappingMultiply(usize.toU64(bytes.length), 8))
    // Fill a partial block first, then compress whole blocks straight from `bytes`, and keep the
    // rest. Each byte is copied at most once.
    let mut index: usize = 0
    if self.used > 0 {
      let mut take = 64 - self.used
      if take > bytes.length { take = bytes.length }
      Slice.copyInto<u8>(&mut self.buffer, self.used, Slice.view<u8>(bytes, 0, take))
      self.used = self.used + take
      index = take
      if self.used < 64 { return () }
      let block = self.buffer
      compress(&mut self.words, &block, 0)
      self.used = 0
    }
    while bytes.length - index >= 64 {
      compress(&mut self.words, bytes, index)
      index = index + 64
    }
    if index < bytes.length {
      Slice.copyInto<u8>(&mut self.buffer, 0, Slice.view<u8>(bytes, index, bytes.length - index))
      self.used = bytes.length - index
    }
    return ()
  }


  /// Consumes the state and returns its 32-byte digest.
  pub fn finish(self: Self) -> [u8; 32] {
    let mut state = move self
    let bits = state.length
    let mut padding: [u8; 64] = [0; 64]
    padding[0] = 128
    let mut count: usize = 120 - state.used
    if state.used < 56 {
      count = 56 - state.used
    }
    state.update(Slice.view<u8>(&padding, 0, count))
    let mut lengthBytes: [u8; 8] = [0; 8]
    let mut index: usize = 0
    while index < 8 {
      lengthBytes[index] = u64.toU8(u64.bitAnd(u64.shiftRight(bits, usize.toU64((7 - index) * 8)), 255))
      index = index + 1
    }
    state.update(&lengthBytes)
    let mut digest: [u8; 32] = [0; 32]
    index = 0
    while index < 32 {
      let shift = usize.toU32((3 - usize.remainder(index, 4)) * 8)
      digest[index] = u32.toU8(u32.bitAnd(u32.shiftRight(state.words[index / 4], shift), 255))
      index = index + 1
    }
    return digest
  }

  /// Returns the 32-byte SM3 digest of `bytes`. It does not allocate.
  pub fn hash(bytes: &[u8]) -> [u8; 32] {
    let mut state = Sm3.make()
    state.update(bytes)
    return state.finish()
  }
}

// Compresses the 64-byte block at `offset` in `bytes` into `words`. The 64 steps are unrolled, and
// the message expansion runs four words ahead of the step that needs it.
fn compress(words: &mut [u32; 8], bytes: &[u8], offset: usize) -> () {
  let block = Slice.view<u8>(bytes, offset, 64)
  let mut w0 = endian.readU32BigEndian(block, 0)
  let mut w1 = endian.readU32BigEndian(block, 4)
  let mut w2 = endian.readU32BigEndian(block, 8)
  let mut w3 = endian.readU32BigEndian(block, 12)
  let mut w4 = endian.readU32BigEndian(block, 16)
  let mut w5 = endian.readU32BigEndian(block, 20)
  let mut w6 = endian.readU32BigEndian(block, 24)
  let mut w7 = endian.readU32BigEndian(block, 28)
  let mut w8 = endian.readU32BigEndian(block, 32)
  let mut w9 = endian.readU32BigEndian(block, 36)
  let mut w10 = endian.readU32BigEndian(block, 40)
  let mut w11 = endian.readU32BigEndian(block, 44)
  let mut w12 = endian.readU32BigEndian(block, 48)
  let mut w13 = endian.readU32BigEndian(block, 52)
  let mut w14 = endian.readU32BigEndian(block, 56)
  let mut w15 = endian.readU32BigEndian(block, 60)
  let mut a = words[0]
  let mut b = words[1]
  let mut c = words[2]
  let mut d = words[3]
  let mut e = words[4]
  let mut f = words[5]
  let mut g = words[6]
  let mut h = words[7]
  let rotated0 = u32.rotateLeft(a, 12)
  let ss1_0 = u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(rotated0, e), 0x79cc4519), 7)
  let tt1_0 = u32.wrappingAdd(u32.wrappingAdd(u32.bitXor(u32.bitXor(a, b), c), d), u32.wrappingAdd(u32.bitXor(ss1_0, rotated0), u32.bitXor(w0, w4)))
  let tt2_0 = u32.wrappingAdd(u32.wrappingAdd(u32.bitXor(u32.bitXor(e, f), g), h), u32.wrappingAdd(ss1_0, w0))
  d = c
  c = u32.rotateLeft(b, 9)
  b = a
  a = tt1_0
  h = g
  g = u32.rotateLeft(f, 19)
  f = e
  e = u32.bitXor(u32.bitXor(tt2_0, u32.rotateLeft(tt2_0, 9)), u32.rotateLeft(tt2_0, 17))
  let rotated1 = u32.rotateLeft(a, 12)
  let ss1_1 = u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(rotated1, e), 0xf3988a32), 7)
  let tt1_1 = u32.wrappingAdd(u32.wrappingAdd(u32.bitXor(u32.bitXor(a, b), c), d), u32.wrappingAdd(u32.bitXor(ss1_1, rotated1), u32.bitXor(w1, w5)))
  let tt2_1 = u32.wrappingAdd(u32.wrappingAdd(u32.bitXor(u32.bitXor(e, f), g), h), u32.wrappingAdd(ss1_1, w1))
  d = c
  c = u32.rotateLeft(b, 9)
  b = a
  a = tt1_1
  h = g
  g = u32.rotateLeft(f, 19)
  f = e
  e = u32.bitXor(u32.bitXor(tt2_1, u32.rotateLeft(tt2_1, 9)), u32.rotateLeft(tt2_1, 17))
  let rotated2 = u32.rotateLeft(a, 12)
  let ss1_2 = u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(rotated2, e), 0xe7311465), 7)
  let tt1_2 = u32.wrappingAdd(u32.wrappingAdd(u32.bitXor(u32.bitXor(a, b), c), d), u32.wrappingAdd(u32.bitXor(ss1_2, rotated2), u32.bitXor(w2, w6)))
  let tt2_2 = u32.wrappingAdd(u32.wrappingAdd(u32.bitXor(u32.bitXor(e, f), g), h), u32.wrappingAdd(ss1_2, w2))
  d = c
  c = u32.rotateLeft(b, 9)
  b = a
  a = tt1_2
  h = g
  g = u32.rotateLeft(f, 19)
  f = e
  e = u32.bitXor(u32.bitXor(tt2_2, u32.rotateLeft(tt2_2, 9)), u32.rotateLeft(tt2_2, 17))
  let rotated3 = u32.rotateLeft(a, 12)
  let ss1_3 = u32.rotateLeft(u32.wrappingAdd(u32.wrappingAdd(rotated3, e), 0xce6228cb), 7)
  let tt1_3 = u32.wrappingAdd(u32.wrappingAdd(u32.bitXor(u32.bitXor(a, b), c), d), u32.wrappingAdd(u32.bitXor(ss1_3, rotated3), u32.bitXor(w3, w7)))
  let tt2_3 = u32.wrappingAdd(u32.wrappingAdd(u32.bitXor(u32.bitXor(e, f), g), h), u32.wrappingAdd(ss1_3, w3))
