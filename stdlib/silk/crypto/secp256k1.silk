//! Key agreement (ECDH) and ECDSA signatures on the curve secp256k1 of SEC 2.
//!
//! # When to use
//! Use [`Secp256k1`] for an ECDH key exchange or an ECDSA signature on secp256k1, such as Node.js
//! `crypto.createECDH('secp256k1')`, `crypto.sign` with a secp256k1 key, or an `ES256K` JSON Web
//! Token. Use [`EcdsaSecp256k1`] to verify.
//!
//! # Details
//! Public keys are 65 bytes in uncompressed SEC1 form: `0x04`, then the X and Y coordinates, each
//! 32 bytes big-endian. [`Secp256k1.compressPublicKey`] and [`Secp256k1.decompressPublicKey`]
//! convert to and from the 33-byte compressed form. Secrets are 32 bytes big-endian.
//! [`Secp256k1.agree`] returns the X coordinate of the shared point and consumes the key.
//! [`Secp256k1.sign`] returns `r` and `s`, each 32 bytes, with the deterministic nonce of RFC 6979,
//! as OpenSSL does; it does not lower `s` as Bitcoin requires. [`EcdsaSecp256k1.toDer`] and
//! [`EcdsaSecp256k1.fromDer`] convert signatures to and from DER. Nothing allocates.
//!
//! # Errors
//! - [`Secp256k1Error`] for a secret or a peer public key that is not valid.
//! - [`Secp256k1SignatureError`] for a key or signature that is not valid, or that does not match.
//!
//! # Gotchas
//! A valid signature proves only that the holder of the private key signed the message. It does not
//! prove that you can trust the key. Both high and low `s` values verify. The key exchange does not
//! authenticate the peer. Pass the shared secret through `silk.crypto.hkdf` before you use it as a
//! key. The secret is not erased when it is dropped.
//!
//! # Examples
//! ## Verify a signature
//! ```silk
//! import silk.crypto.secp256k1 { EcdsaSecp256k1, Secp256k1SignatureError }
//! import silk.crypto.sha2 { Sha256 }
//! import silk.core.result { Result }
//!
//! pub fn main() -> i32 {
//!   // A public key and a signature of "hello" that another program made.
//!   let publicKey = b"\x04\x8d\x3a\x31\x0b\x0d\xfa\x35\xd0\x46\x47\x18\x5c\x42\x12\xca\xe0\xcf\xb0\x3b\xf6\xa2\x9c\x77\xce\xef\x34\xdf\x21\x05\x63\x4d\xa8\x9b\x8d\x7a\x59\x80\x90\x82\xf5\x78\x25\x8a\xa3\x02\xed\xdd\x75\x0c\x2e\xff\xa8\x88\x86\xc3\x1e\x48\xe9\x28\xd1\x26\x06\x9e\x29"
//!   let signature = b"\xcc\x0f\x61\x5e\xc2\xc1\x99\x4f\xcf\xfc\xb5\xb2\xf0\x06\xda\x4b\xe4\x95\x62\x5f\x1d\xcb\x59\xcc\xed\xbc\xdb\xfa\xf9\x0b\x4a\x19\x58\x1b\x69\x32\x83\xad\x38\x65\x3f\x3f\xe6\x13\xbf\x23\xd8\x17\x2a\x22\x94\xdd\x3d\x1c\x4f\x38\xa1\xfb\xe8\x8a\x79\x28\x6b\x9d"
//!   match EcdsaSecp256k1.verify<Sha256>(publicKey, b"hello", signature) {
//!     Result<(), Secp256k1SignatureError>.Success {..} => {}
//!     Result<(), Secp256k1SignatureError>.Failure {..} => {
//!       return 1
//!     }
//!   }
//!   return match EcdsaSecp256k1.verify<Sha256>(publicKey, b"hellp", signature) {
//!     Result<(), Secp256k1SignatureError>.Failure { error: Secp256k1SignatureError.AuthenticationFailed } => 0
//!     _ => 1
//!   }
//! }
//! ```
//!
//! ## Sign and agree
//! ```silk
//! import silk.crypto.secp256k1 { EcdsaSecp256k1, Secp256k1, Secp256k1Error, Secp256k1SignatureError }
//! import silk.crypto.sha2 { Sha256 }
//! import silk.core.result { Result }
//!
//! pub fn main() -> i32 {
//!   // Real programs use `Secp256k1.generate()` with a secure `Random` provider.
//!   let mut secret: [u8; 32] = [0; 32]
//!   secret[31] = 7
//!   let key = match Secp256k1.fromBytes(&secret) {
//!     Result<Secp256k1, Secp256k1Error>.Success { value } => move value
//!     Result<Secp256k1, Secp256k1Error>.Failure {..} => {
//!       return 1
//!     }
//!   }
//!   let publicKey = key.publicKey()
//!   let signature = key.sign<Sha256>(b"hello")
//!   return match EcdsaSecp256k1.verify<Sha256>(&publicKey, b"hello", &signature) {
//!     Result<(), Secp256k1SignatureError>.Success {..} => 0
//!     Result<(), Secp256k1SignatureError>.Failure {..} => 1
//!   }
//! }
//! ```
//!
//! @category Cryptography

import silk.text.format {Debug, Format, Formatter}
import silk.core.ownership {Copy}
import silk.collections.slice {Slice}
import silk.crypto.digest {Digest}
import silk.crypto.hmac {Hmac}
import silk.system.random {Random}
import silk.core.result {Result}
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.usize
import silk.io.writer {Writer, WriterError}

/// The reason that a secp256k1 secret or public key is not valid. It holds no secret bytes.
pub enum Secp256k1Error {
  /// A secret is not 32 bytes, or a public key is not 65 bytes.
  InvalidLength,
  /// The secret is 0, or not less than the order of the curve.
  InvalidScalar,
  /// The public key does not start with `0x04`. Compressed keys are not supported.
  InvalidEncoding,
  /// A coordinate is not less than the field prime, or the point is not on the curve.
  InvalidPoint,
}

impl Debug for Secp256k1Error {
  /// Writes the name of the variant, such as `InvalidLength`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      Secp256k1Error.InvalidLength => run Format.write(&mut formatter, b"InvalidLength")
      Secp256k1Error.InvalidScalar => run Format.write(&mut formatter, b"InvalidScalar")
      Secp256k1Error.InvalidEncoding => run Format.write(&mut formatter, b"InvalidEncoding")
      Secp256k1Error.InvalidPoint => run Format.write(&mut formatter, b"InvalidPoint")
    }
  }
}

/// A secp256k1 secret, for key agreement and for ECDSA signatures. It is not `Copy`.
///
/// # When to use
/// Use it for an ECDH key exchange or an ECDSA signature on secp256k1, such as Node.js
/// `crypto.createECDH('secp256k1')` or an `ES256K` JSON Web Token.
///
/// # Details
/// [`Secp256k1.agree`] consumes it, so make a new one for each exchange. [`Secp256k1.sign`] does
/// not. Public keys are 65 bytes in uncompressed SEC1 form: `0x04`, then the X and Y coordinates, each 32 bytes big-endian. Secrets
/// are 32 bytes big-endian. Nothing allocates.
///
/// # Gotchas
/// The key exchange does not authenticate the peer. Pass the shared secret through
/// `silk.crypto.hkdf` before you use it as a key. The secret is not erased when it is dropped.
pub struct Secp256k1 {
  secret: [u8; 32],
}

impl Secp256k1 {
  /// Checks that `publicKey` is a valid uncompressed secp256k1 public key.
  ///
  /// It must be 65 bytes: `0x04`, then X and Y, each 32 bytes big-endian and less than the field
  /// prime, and the point must be on the curve.
  ///
  /// # Errors
  /// - `InvalidLength`, `InvalidEncoding`, or `InvalidPoint`.
  pub fn validatePublicKey(publicKey: &[u8]) -> Result<(), Secp256k1Error> {
    let admitted = admitPoint(publicKey)
    return match move admitted {
      Result<Point, Secp256k1Error>.Success {..} => Result<(), Secp256k1Error>.succeed(())
      Result<Point, Secp256k1Error>.Failure {error} => Result<(), Secp256k1Error>.failResult(error)
    }
  }
  /// Returns the secret for the 32 big-endian bytes `bytes`.
  ///
  /// # Errors
  /// - `InvalidLength` if `bytes` is not 32 bytes.
  /// - `InvalidScalar` if the value is 0, or not less than the order of the curve.
  pub fn fromBytes(bytes: &[u8]) -> Result<Secp256k1, Secp256k1Error> {
    if bytes.length != 32 {
      return Result<Secp256k1, Secp256k1Error>.failResult(Secp256k1Error.InvalidLength)
    }
    let value = decode(bytes, 0)
    if nonzero(value) == 0 || below(value, order()) == 0 {
      return Result<Secp256k1, Secp256k1Error>.failResult(Secp256k1Error.InvalidScalar)
    }
    let secret = encode(value)
    return Result<Secp256k1, Secp256k1Error>.succeed(Secp256k1 {secret: secret})
  }
  /// Returns a new random secret, with bytes from the ambient `Random`.
  ///
  /// It draws 32 bytes again until the value is valid, so the result is uniform. The `Random`
  /// provider must be cryptographically secure. If it fails, the program stops.
  pub effect fn generate() -> Secp256k1 ? &mut Random {
    let mut bytes = emptyBytes()
    run Random.fillBytes(&mut bytes)
    let mut value = decode(&bytes, 0)
    while nonzero(value) == 0 || below(value, order()) == 0 {
      run Random.fillBytes(&mut bytes)
      value = decode(&bytes, 0)
    }
    return Secp256k1 {secret: bytes}
  }
  /// Returns the 65-byte uncompressed public key to send to the peer. It does not consume the
  /// secret.
  pub fn publicKey(self: &Self) -> [u8; 65] {
    let point = affine(multiply(basePoint(), &self.secret))
    let x = encode(fromMontgomery(point.x))
    let y = encode(fromMontgomery(point.y))
    let mut output: [u8; 65] = [0; 65]
    output[0] = 4
    let mut i: usize = 0
    while i < 32 {
      output[i + 1] = x[i]
      output[i + 33] = y[i]
      i = i + 1
    }
    return output
  }
  /// Returns the 32-byte shared secret for the public key `peer`, and consumes the secret.
  ///
  /// The result is the big-endian X coordinate of the shared point.
  ///
  /// # Errors
  /// - `InvalidLength`, `InvalidEncoding`, or `InvalidPoint` if `peer` is not a valid uncompressed
  ///   public key. The secret is consumed also when it fails.
  ///
  /// # Gotchas
  /// Pass the result through `silk.crypto.hkdf` before you use it as a key.
  pub fn agree(self: Self, peer: &[u8]) -> Result<[u8; 32], Secp256k1Error> {
    let admitted = admitPoint(peer)
    return match move admitted {
      Result<Point, Secp256k1Error>.Success {value} => {
        let point = affine(multiply(value, &self.secret))
        return Result<[u8; 32], Secp256k1Error>.succeed(encode(fromMontgomery(point.x)))
      }
      Result<Point, Secp256k1Error>.Failure {error} => Result<[u8; 32], Secp256k1Error>.failResult(error)
    }
  }
  /// Returns the 32 big-endian bytes of the secret, the input of [`Secp256k1.fromBytes`].
  ///
  /// # Gotchas
  /// The bytes are the private key. Keep them secret.
  pub fn toBytes(self: &Self) -> [u8; 32] {
    return self.secret
  }
  /// Returns the ECDSA signature of `message`, hashed with `H`, as 64 bytes: `r`, then `s`, each
  /// 32 bytes big-endian.
  ///
  /// The nonce is deterministic (RFC 6979) with HMAC over `H`, so the same key, hash, and message
  /// always give the same signature. [`EcdsaSecp256k1.toDer`] converts the result to DER.
  ///
  /// # Gotchas
  /// The program traps if `message` is longer than `H` allows.
  pub fn sign<H: Digest>(self: &Self, message: &[u8]) -> [u8; 64] {
    let mut state: H = Digest.make()
    let length = state.digestLength()
    state.update(message)
    let mut digest: [u8; 64] = [0; 64]
    state.finishInto(&mut digest)
    return self.signDigest<H>(Slice.view<u8>(&digest, 0, length))
  }
  /// Returns the ECDSA signature of a message whose digest is `digest`, as 64 bytes: `r`, then
  /// `s`, each 32 bytes big-endian.
  ///
  /// `H` is the hash for the RFC 6979 nonce, normally the hash that made `digest`. A digest longer
  /// than 32 bytes is cut to its first 32 bytes, as ECDSA requires.
  pub fn signDigest<H: Digest>(self: &Self, digest: &[u8]) -> [u8; 64] {
    let z = digestScalar(digest)
    let secret = self.secret
    let digestBytes = encode(z)
    let dm = scalarToMontgomery(decode(&secret, 0))
    let zm = scalarToMontgomery(z)
    let mut nonce = nonceStart<H>(&secret, &digestBytes)
    while true {
      let k = nonceNext<H>(&mut nonce)
      let kBytes = encode(k)
      let point = affine(multiply(basePoint(), &kBytes))
      let r = reduceMod(fromMontgomery(point.x), 0, order())
      // r is public. Both retries happen with probability near 2^-256.
      if nonzero(r) != 0 {
        let sum = addMod(zm, scalarMul(scalarToMontgomery(r), dm), order())
        let s = scalarFromMontgomery(scalarMul(sum, scalarInvert(scalarToMontgomery(k))))
        if nonzero(s) != 0 {
          return joinScalars(r, s)
        }
      }
    }
    return joinScalars(zero(), zero())
  }
  /// Returns the 33-byte compressed form of the uncompressed public key `publicKey`: `0x02` or
  /// `0x03` for the parity of Y, then X.
  ///
  /// # Errors
  /// - `InvalidLength`, `InvalidEncoding`, or `InvalidPoint` if `publicKey` is not a valid
  ///   uncompressed public key.
  pub fn compressPublicKey(publicKey: &[u8]) -> Result<[u8; 33], Secp256k1Error> {
    let admitted = admitPoint(publicKey)
    return match move admitted {
      Result<Point, Secp256k1Error>.Success {..} => {
        let mut output: [u8; 33] = [0; 33]
        output[0] = 2 + u8.bitAnd(publicKey[64], 1)
        let mut i: usize = 0
        while i < 32 {
          output[i + 1] = publicKey[i + 1]
          i = i + 1
        }
        return Result<[u8; 33], Secp256k1Error>.succeed(output)
      }
      Result<Point, Secp256k1Error>.Failure {error} => Result<[u8; 33], Secp256k1Error>.failResult(error)
    }
  }
  /// Returns the 65-byte uncompressed form of the compressed public key `publicKey`.
  ///
  /// # Errors
  /// - `InvalidLength` if `publicKey` is not 33 bytes.
  /// - `InvalidEncoding` if it does not start with `0x02` or `0x03`.
  /// - `InvalidPoint` if X is not less than the field prime, or no point has that X.
  pub fn decompressPublicKey(publicKey: &[u8]) -> Result<[u8; 65], Secp256k1Error> {
    if publicKey.length != 33 {
      return Result<[u8; 65], Secp256k1Error>.failResult(Secp256k1Error.InvalidLength)
    }
    if publicKey[0] != 2 && publicKey[0] != 3 {
      return Result<[u8; 65], Secp256k1Error>.failResult(Secp256k1Error.InvalidEncoding)
    }
    let x = decode(publicKey, 1)
    if below(x, prime()) == 0 {
      return Result<[u8; 65], Secp256k1Error>.failResult(Secp256k1Error.InvalidPoint)
    }
    let mx = toMontgomery(x)
    let rhs = curveRight(mx)
    let root = power(rhs, squareRootExponent())
    if nonzero(sub(square(root), rhs)) != 0 {
      return Result<[u8; 65], Secp256k1Error>.failResult(Secp256k1Error.InvalidPoint)
    }
    let mut y = fromMontgomery(root)
    if u32.bitAnd(y.limbs[0], 1) != u8.toU32(publicKey[0] - 2) {
      y = sub(zero(), y)
    }
    let xBytes = encode(x)
    let yBytes = encode(y)
    let mut output: [u8; 65] = [0; 65]
    output[0] = 4
    let mut i: usize = 0
    while i < 32 {
      output[i + 1] = xBytes[i]
      output[i + 33] = yBytes[i]
      i = i + 1
    }
    return Result<[u8; 65], Secp256k1Error>.succeed(output)
  }
}


// Canonical residues use twelve little-endian 32-bit limbs. Field operations return Montgomery
// residues. Fixed arrays make every loop and temporary independent of input magnitude.
struct Field {
  limbs: [u32; 8],
}

impl Copy for Field {}

struct Point {
  x: Field,
  y: Field,
  z: Field,
}

impl Copy for Point {}

fn prime() -> Field {
  return Field {limbs: [4294966319, 4294967294, 4294967295, 4294967295, 4294967295, 4294967295, 4294967295, 4294967295]}
}

fn order() -> Field {
  return Field {limbs: [3493216577, 3218235020, 2940772411, 3132021990, 4294967294, 4294967295, 4294967295, 4294967295]}
}

fn one() -> Field {
  return Field {limbs: [977, 1, 0, 0, 0, 0, 0, 0]}
}

fn rSquared() -> Field {
  return Field {limbs: [954529, 1954, 1, 0, 0, 0, 0, 0]}
}

fn curveB() -> Field {
  return Field {limbs: [6839, 7, 0, 0, 0, 0, 0, 0]}
}

fn curveB3() -> Field {
  return Field {limbs: [20517, 21, 0, 0, 0, 0, 0, 0]}
}

fn baseX() -> Field {
  return Field {limbs: [1216225431, 3610652250, 700212955, 589179219, 872223388, 2543798464, 3909656392, 2575427139]}
}

fn baseY() -> Field {
  return Field {limbs: [3554388962, 2975770322, 522045005, 2382126429, 2887369014, 1891022234, 3567616726, 3477046559]}
}

fn inverseExponent() -> Field {
  return Field {limbs: [4294966317, 4294967294, 4294967295, 4294967295, 4294967295, 4294967295, 4294967295, 4294967295]}
}

fn zero() -> Field {
  return Field {limbs: [0, 0, 0, 0, 0, 0, 0, 0]}
}

fn basePoint() -> Point {
  return Point {x: baseX(), y: baseY(), z: one()}
}

fn identity() -> Point {
  return Point {x: zero(), y: one(), z: zero()}
}

fn emptyBytes() -> [u8; 32] {
  return [0; 32]
}

fn decode(bytes: &[u8], start: usize) -> Field {
  let mut result = zero()
  let mut i: usize = 0
  while i < 32 {
    let index = (31 - i) / 4
    result.limbs[index] = u32.bitOr(
      u32.shiftLeft(result.limbs[index], 8),
      u8.toU32(bytes[start + i]),
    )
    i = i + 1
  }
  return result
}

fn encode(value: Field) -> [u8; 32] {
  let mut output = emptyBytes()
  let mut i: usize = 0
  while i < 32 {
    let word = value.limbs[i / 4]
    output[31 - i] = u32.toU8(u32.bitAnd(u32.shiftRight(word, usize.toU32(i % 4) * 8), 255))
    i = i + 1
  }
  return output
}

fn low(value: u64) -> u32 {
  return u64.toU32(u64.bitAnd(value, 4294967295))
}

fn nonzero(value: Field) -> u32 {
  let mut combined: u32 = 0
  let mut i: usize = 0
  while i < 8 {
    combined = u32.bitOr(combined, value.limbs[i])
    i = i + 1
  }
  return u32.shiftRight(u32.bitOr(combined, u32.wrappingSubtract(0, combined)), 31)
}

fn below(left: Field, right: Field) -> u32 {
  let mut borrow: u64 = 0
  let mut i: usize = 0
  while i < 8 {
    let difference = u64.wrappingSubtract(
      u64.wrappingSubtract(u32.toU64(left.limbs[i]), u32.toU64(right.limbs[i])),
      borrow,
    )
    borrow = u64.shiftRight(difference, 63)
    i = i + 1
  }
  return u64.toU32(borrow)
}

fn select(left: Field, right: Field, bit: u32) -> Field {
  let mask = u32.wrappingSubtract(0, bit)
  let mut result = zero()
  let mut i: usize = 0
  while i < 8 {
    result.limbs[i] = u32.bitXor(
      left.limbs[i],
      u32.bitAnd(mask, u32.bitXor(left.limbs[i], right.limbs[i])),
    )
    i = i + 1
  }
  return result
}

// Input is below 2p and carries at most one extra bit. Subtraction chooses its canonical residue.
fn reduce(value: Field, high: u64) -> Field {
  return reduceMod(value, high, prime())
}

fn reduceMod(value: Field, high: u64, p: Field) -> Field {
  let mut result = zero()
  let mut borrow: u64 = 0
  let mut i: usize = 0
  while i < 8 {
    let difference = u64.wrappingSubtract(
      u64.wrappingSubtract(u32.toU64(value.limbs[i]), u32.toU64(p.limbs[i])),
      borrow,
    )
    result.limbs[i] = low(difference)
    borrow = u64.shiftRight(difference, 63)
    i = i + 1
  }
  let underflow = u64.shiftRight(u64.wrappingSubtract(high, borrow), 63)
  return select(result, value, u64.toU32(underflow))
}

fn add(left: Field, right: Field) -> Field {
  return addMod(left, right, prime())
}

fn addMod(left: Field, right: Field, p: Field) -> Field {
  let mut result = zero()
  let mut carry: u64 = 0
  let mut i: usize = 0
  while i < 8 {
    let sum = u64.wrappingAdd(
      u64.wrappingAdd(u32.toU64(left.limbs[i]), u32.toU64(right.limbs[i])),
      carry,
    )
    result.limbs[i] = low(sum)
    carry = u64.shiftRight(sum, 32)
    i = i + 1
  }
  return reduceMod(result, carry, p)
}

fn sub(left: Field, right: Field) -> Field {
  let mut result = zero()
  let mut borrow: u64 = 0
  let mut i: usize = 0
  while i < 8 {
    let difference = u64.wrappingSubtract(
      u64.wrappingSubtract(u32.toU64(left.limbs[i]), u32.toU64(right.limbs[i])),
      borrow,
    )
    result.limbs[i] = low(difference)
    borrow = u64.shiftRight(difference, 63)
    i = i + 1
  }
  let mask = u32.wrappingSubtract(0, u64.toU32(borrow))
  let p = prime()
  let mut carry: u64 = 0
  i = 0
  while i < 8 {
    let sum = u64.wrappingAdd(
      u64.wrappingAdd(u32.toU64(result.limbs[i]), u32.toU64(u32.bitAnd(p.limbs[i], mask))),
      carry,
    )
    result.limbs[i] = low(sum)
    carry = u64.shiftRight(sum, 32)
    i = i + 1
  }
  return result
}

fn mul(left: Field, right: Field) -> Field {
  return mulMod(left, right, prime(), 3525653809)
}

fn mulMod(left: Field, right: Field, p: Field, inverse: u32) -> Field {
  let mut words: [u64; 17] = [0; 17]
  let mut i: usize = 0
  while i < 8 {
    let mut carry: u64 = 0
    let mut j: usize = 0
    while j < 8 {
      // Product plus two 32-bit values fits u64, including the all-ones boundary.
      let product = u64.wrappingAdd(
        u64.wrappingAdd(
          u64.wrappingMultiply(u32.toU64(left.limbs[i]), u32.toU64(right.limbs[j])),
          words[i + j],
        ),
        carry,
      )
      words[i + j] = u64.bitAnd(product, 4294967295)
      carry = u64.shiftRight(product, 32)
      j = j + 1
    }
    words[i + 8] = carry
    i = i + 1
  }
  i = 0
  while i < 8 {
    let factor = u32.toU64(u32.wrappingMultiply(low(words[i]), inverse))
    let mut carry: u64 = 0
    let mut j: usize = 0
    while j < 8 {
      let product = u64.wrappingAdd(
        u64.wrappingAdd(u64.wrappingMultiply(factor, u32.toU64(p.limbs[j])), words[i + j]),
        carry,
      )
      words[i + j] = u64.bitAnd(product, 4294967295)
      carry = u64.shiftRight(product, 32)
      j = j + 1
    }
    let mut k = i + 8
    while k < 17 {
      let sum = u64.wrappingAdd(words[k], carry)
      words[k] = u64.bitAnd(sum, 4294967295)
      carry = u64.shiftRight(sum, 32)
      k = k + 1
    }
    i = i + 1
  }
  let mut result = zero()
  i = 0
  while i < 8 {
    result.limbs[i] = low(words[i + 8])
    i = i + 1
  }
  return reduceMod(result, words[16], p)
}

fn square(value: Field) -> Field {
  return mul(value, value)
}

fn toMontgomery(value: Field) -> Field {
  return mul(value, rSquared())
}

fn fromMontgomery(value: Field) -> Field {
  return mul(value, Field {limbs: [1, 0, 0, 0, 0, 0, 0, 0]})
}

fn invert(value: Field) -> Field {
  return power(value, inverseExponent())
}

// value^exponent for a Montgomery residue. The time does not depend on either input.
fn power(value: Field, exponent: Field) -> Field {
  let mut result = one()
  let mut i: usize = 256
  while i > 0 {
    i = i - 1
    result = square(result)
    let candidate = mul(result, value)
    let bit = u32.bitAnd(u32.shiftRight(exponent.limbs[i / 32], usize.toU32(i % 32)), 1)
    result = select(result, candidate, bit)
  }
  return result
}

fn selectPoint(left: Point, right: Point, bit: u32) -> Point {
  return Point {
    x: select(left.x, right.x, bit),
    y: select(left.y, right.y, bit),
    z: select(left.z, right.z, bit),
  }
}

fn double(point: Point) -> Point {
  return pointAdd(point, point)
}

fn pointAdd(left: Point, right: Point) -> Point {
  // Complete projective addition for a=0: Renes, Costello and Batina (2015/1060),
  // Algorithm 7, with b3 = 3b = 21. Coordinates represent (X/Z, Y/Z), with identity (0:1:0).
  // The same arithmetic handles equal, inverse, and identity points without classification.
  let b3 = curveB3()
  let mut t0 = mul(left.x, right.x)
  let mut t1 = mul(left.y, right.y)
  let mut t2 = mul(left.z, right.z)
  let mut t3 = add(left.x, left.y)
  let mut t4 = add(right.x, right.y)
  t3 = mul(t3, t4)
  t4 = add(t0, t1)
  t3 = sub(t3, t4)
  t4 = add(left.y, left.z)
  let mut x = add(right.y, right.z)
  t4 = mul(t4, x)
  x = add(t1, t2)
  t4 = sub(t4, x)
  x = add(left.x, left.z)
  let mut y = add(right.x, right.z)
  x = mul(x, y)
  y = add(t0, t2)
  y = sub(x, y)
  x = add(t0, t0)
  t0 = add(x, t0)
  t2 = mul(b3, t2)
  let mut z = add(t1, t2)
  t1 = sub(t1, t2)
  y = mul(b3, y)
  x = mul(t4, y)
  t2 = mul(t3, t1)
  x = sub(t2, x)
  y = mul(y, t0)
  t1 = mul(t1, z)
  y = add(t1, y)
  t0 = mul(t0, t3)
  z = mul(z, t4)
  z = add(z, t0)
  return Point {x: x, y: y, z: z}
}

fn multiply(point: Point, scalar: &([u8; 32])) -> Point {
  let bytes = scalar.*
  let mut result = identity()
  let mut i: usize = 0
  while i < 256 {
    result = double(result)
    let candidate = pointAdd(result, point)
    let bit = u32.bitAnd(u32.shiftRight(u8.toU32(bytes[i / 8]), usize.toU32(7 - i % 8)), 1)
    result = selectPoint(result, candidate, bit)
    i = i + 1
  }
  return result
}

fn affine(point: Point) -> Point {
  let z = invert(point.z)
  return Point {x: mul(point.x, z), y: mul(point.y, z), z: one()}
}

// Order residues share the bounded Montgomery core with field arithmetic; no public bigint API.
fn scalarMul(left: Field, right: Field) -> Field {
  return mulMod(left, right, order(), 1435021631)
}

fn scalarToMontgomery(value: Field) -> Field {
  return scalarMul(value, Field {limbs: [1742197056, 2305618452, 243071096, 1947506370, 1540163526, 3868718564, 2177276869, 2640780501]})
}

fn scalarFromMontgomery(value: Field) -> Field {
  return scalarMul(value, Field {limbs: [1, 0, 0, 0, 0, 0, 0, 0]})
}

fn scalarInvert(value: Field) -> Field {
  let exponent = Field {limbs: [3493216575, 3218235020, 2940772411, 3132021990, 4294967294, 4294967295, 4294967295, 4294967295]}
  let mut result = Field {limbs: [801750719, 1076732275, 1354194884, 1162945305, 1, 0, 0, 0]}
  let mut i: usize = 256
  while i > 0 {
    i = i - 1
    result = scalarMul(result, result)
    let candidate = scalarMul(result, value)
    let bit = u32.bitAnd(u32.shiftRight(exponent.limbs[i / 32], usize.toU32(i % 32)), 1)
    result = select(result, candidate, bit)
  }
  return result
}

/// The reason that an ECDSA secp256k1 verification failed.
pub enum Secp256k1SignatureError {
  /// The public key is not a valid uncompressed secp256k1 key.
  InvalidKey,
  /// The signature is not strict DER, or `r` or `s` is not between 1 and the order of the curve.
  InvalidEncoding,
  /// The inputs are valid, but the signature does not match the message and the key.
  AuthenticationFailed,
}

impl Debug for Secp256k1SignatureError {
  /// Writes the name of the variant, such as `InvalidKey`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      Secp256k1SignatureError.InvalidKey => run Format.write(&mut formatter, b"InvalidKey")
      Secp256k1SignatureError.InvalidEncoding => run Format.write(&mut formatter, b"InvalidEncoding")
      Secp256k1SignatureError.AuthenticationFailed => run Format.write(&mut formatter, b"AuthenticationFailed")
    }
  }
}

// Zero denotes failure here: a DER scalar is valid only when strictly positive.
fn signatureInteger(bytes: &[u8], start: usize, length: usize) -> Field {
  if length == 0 || length > 33 || start + length > bytes.length {
    return zero()
  }
  if bytes[start] >= 128 {
    return zero()
  }
  let mut offset = start
  let mut size = length
  if bytes[start] == 0 {
    if length == 1 || bytes[start + 1] < 128 {
      return zero()
    }
    offset = offset + 1
    size = size - 1
  }
  if size > 32 {
    return zero()
  }
  let mut padded = emptyBytes()
  let mut i: usize = 0
  while i < size {
    padded[32 - size + i] = bytes[offset + i]
    i = i + 1
  }
  let value = decode(&padded, 0)
  if below(value, order()) == 0 {
    return zero()
  }
  return value
}

fn parseDer(signature: &[u8]) -> Result<[u8; 64], Secp256k1SignatureError> {
  if signature.length < 8 || signature.length > 72 {
    return Result<[u8; 64], Secp256k1SignatureError>.failResult(Secp256k1SignatureError.InvalidEncoding)
  }
  if signature[0] != 48 || u8.toUsize(signature[1]) != signature.length - 2 || signature[2] != 2 {
    return Result<[u8; 64], Secp256k1SignatureError>.failResult(Secp256k1SignatureError.InvalidEncoding)
  }
  let rLength = u8.toUsize(signature[3])
  let sHeader: usize = 4 + rLength
  if sHeader + 2 > signature.length {
    return Result<[u8; 64], Secp256k1SignatureError>.failResult(Secp256k1SignatureError.InvalidEncoding)
  }
  let sLength = u8.toUsize(signature[sHeader + 1])
  if signature[sHeader] != 2 || sHeader + 2 + sLength != signature.length {
    return Result<[u8; 64], Secp256k1SignatureError>.failResult(Secp256k1SignatureError.InvalidEncoding)
  }
  let r = signatureInteger(signature, 4, rLength)
  let s = signatureInteger(signature, sHeader + 2, sLength)
  if nonzero(r) == 0 || nonzero(s) == 0 {
    return Result<[u8; 64], Secp256k1SignatureError>.failResult(Secp256k1SignatureError.InvalidEncoding)
  }
  return Result<[u8; 64], Secp256k1SignatureError>.succeed(joinScalars(r, s))
}

// `signature` is the fixed form: r, then s, each 32 bytes big-endian.
fn verifyScalars(publicPoint: Point, z: Field, signature: &[u8]) -> Result<(), Secp256k1SignatureError> {
  if signature.length != 64 {
    return Result<(), Secp256k1SignatureError>.failResult(Secp256k1SignatureError.InvalidEncoding)
  }
  let r = decode(signature, 0)
  let s = decode(signature, 32)
  if nonzero(r) == 0 || nonzero(s) == 0 || below(r, order()) == 0 || below(s, order()) == 0 {
    return Result<(), Secp256k1SignatureError>.failResult(Secp256k1SignatureError.InvalidEncoding)
  }
  let inverse = scalarInvert(scalarToMontgomery(s))
  let u1 = encode(scalarFromMontgomery(scalarMul(scalarToMontgomery(z), inverse)))
  let u2 = encode(scalarFromMontgomery(scalarMul(scalarToMontgomery(r), inverse)))
  let result = pointAdd(multiply(basePoint(), &u1), multiply(publicPoint, &u2))
  if nonzero(result.z) == 0 {
    return Result<(), Secp256k1SignatureError>.failResult(Secp256k1SignatureError.AuthenticationFailed)
  }
  let reducedX = reduceMod(fromMontgomery(affine(result).x), 0, order())
  if nonzero(sub(reducedX, r)) != 0 {
    return Result<(), Secp256k1SignatureError>.failResult(Secp256k1SignatureError.AuthenticationFailed)
  }
  return Result<(), Secp256k1SignatureError>.succeed(())
}

fn admitPoint(peer: &[u8]) -> Result<Point, Secp256k1Error> {
  if peer.length != 65 {
    return Result<Point, Secp256k1Error>.failResult(Secp256k1Error.InvalidLength)
  }
  if peer[0] != 4 {
    return Result<Point, Secp256k1Error>.failResult(Secp256k1Error.InvalidEncoding)
  }
  let x = decode(peer, 1)
  let y = decode(peer, 33)
  if below(x, prime()) == 0 || below(y, prime()) == 0 {
    return Result<Point, Secp256k1Error>.failResult(Secp256k1Error.InvalidPoint)
  }
  let mx = toMontgomery(x)
  let my = toMontgomery(y)
  let rhs = curveRight(mx)
  if nonzero(sub(square(my), rhs)) != 0 {
    return Result<Point, Secp256k1Error>.failResult(Secp256k1Error.InvalidPoint)
  }

  return Result<Point, Secp256k1Error>.succeed(Point {x: mx, y: my, z: one()})
}

fn squareRootExponent() -> Field {
  return Field {limbs: [3221225228, 4294967295, 4294967295, 4294967295, 4294967295, 4294967295, 4294967295, 1073741823]}
}

// x^3 + 7 for a Montgomery residue x.
fn curveRight(x: Field) -> Field {
  return add(mul(square(x), x), curveB())
}

// bits2int of RFC 6979 for a 256-bit order, reduced once below the order.
fn digestScalar(digest: &[u8]) -> Field {
  let mut padded = emptyBytes()
  let mut length = digest.length
  if length > 32 {
    length = 32
  }
  let mut i: usize = 0
  while i < length {
    padded[32 - length + i] = digest[i]
    i = i + 1
  }
  return reduceMod(decode(&padded, 0), 0, order())
}

fn joinScalars(r: Field, s: Field) -> [u8; 64] {
  let rBytes = encode(r)
  let sBytes = encode(s)
  let mut output: [u8; 64] = [0; 64]
  let mut i: usize = 0
  while i < 32 {
    output[i] = rBytes[i]
    output[i + 32] = sBytes[i]
    i = i + 1
  }
  return output
}

// HMAC_DRBG state of RFC 6979, section 3.2. Only the first `length` bytes of K and V are used.
struct Nonce {
  key: [u8; 64],
  value: [u8; 64],
  length: usize,
  started: bool,
}

fn nonceStart<H: Digest>(secret: &([u8; 32]), digest: &([u8; 32])) -> Nonce {
  let probe: H = Digest.make()
  let mut nonce = Nonce {key: [0; 64], value: [1; 64], length: probe.digestLength(), started: false}
  nonceUpdate<H>(&mut nonce, 0, secret, digest)
  nonceUpdate<H>(&mut nonce, 1, secret, digest)
  return move nonce
}

// K = HMAC_K(V || marker || secret || digest), then V = HMAC_K(V).
fn nonceUpdate<H: Digest>(nonce: &mut Nonce, marker: u8, secret: &[u8], digest: &[u8]) -> () {
  let mut state = Hmac<H>.make(Slice.view<u8>(&nonce.key, 0, nonce.length))
  state.update(Slice.view<u8>(&nonce.value, 0, nonce.length))
  let markerBytes: [u8; 1] = [marker]
  state.update(&markerBytes)
  state.update(secret)
  state.update(digest)
  state.finishInto(&mut nonce.key)
  nonceStep<H>(&mut nonce)
}

// V = HMAC_K(V).
fn nonceStep<H: Digest>(nonce: &mut Nonce) -> () {
  let mut state = Hmac<H>.make(Slice.view<u8>(&nonce.key, 0, nonce.length))
  state.update(Slice.view<u8>(&nonce.value, 0, nonce.length))
  state.finishInto(&mut nonce.value)
}

// The next candidate k between 1 and the order minus 1.
fn nonceNext<H: Digest>(nonce: &mut Nonce) -> Field {
  while true {
    if nonce.started {
      nonceUpdate<H>(&mut nonce, 0, b"", b"")
    }
    nonce.started = true
    let mut candidate = emptyBytes()
    let mut filled: usize = 0
    while filled < 32 {
      nonceStep<H>(&mut nonce)
      let mut i: usize = 0
      while i < nonce.length && filled < 32 {
        candidate[filled] = nonce.value[i]
        filled = filled + 1
        i = i + 1
      }
    }
    let k = decode(&candidate, 0)
    if nonzero(k) != 0 && below(k, order()) != 0 {
      return k
    }
  }
  return zero()
}

/// ECDSA verification on secp256k1 with any hash, and conversion between the two signature forms.
///
/// # When to use
/// Use it to verify a signature in the fixed 64-byte form (`r`, then `s`), as in `ES256K` JSON Web
/// Tokens. [`EcdsaSecp256k1.fromDer`] turns a DER signature, as Node.js `crypto.verify` takes it,
/// into that form. To sign, use [`Secp256k1.sign`].
///
/// # Details
/// Public keys are 65 bytes in uncompressed SEC1 form. A fixed-form signature is 64 bytes. A DER
/// signature is a SEQUENCE of the two INTEGERs, at most 72 bytes. Nothing allocates.
///
/// # Gotchas
/// A valid signature proves only that the holder of the private key signed the message. It does not
/// prove that you can trust the key.
pub struct EcdsaSecp256k1 {}

impl EcdsaSecp256k1 {
  /// Checks that `signature`, in the fixed 64-byte form, is a valid signature of `message`,
  /// hashed with `H`, by `publicKey`.
  ///
  /// Both high and low `s` values are accepted.
  ///
  /// # Errors
  /// - `InvalidKey` if `publicKey` is not a valid uncompressed key.
  /// - `InvalidEncoding` if `signature` is not 64 bytes, or `r` or `s` is not between 1 and the
  ///   order of the curve.
  /// - `AuthenticationFailed` if the signature does not match.
  ///
  /// # Gotchas
  /// The program traps if `message` is longer than `H` allows.
  pub fn verify<H: Digest>(publicKey: &[u8], message: &[u8], signature: &[u8]) -> Result<
    (),
    Secp256k1SignatureError,
  > {
    let mut state: H = Digest.make()
    let length = state.digestLength()
    state.update(message)
    let mut digest: [u8; 64] = [0; 64]
    state.finishInto(&mut digest)
    return EcdsaSecp256k1.verifyDigest(publicKey, Slice.view<u8>(&digest, 0, length), signature)
  }
  /// Checks that `signature`, in the fixed 64-byte form, is a valid signature by `publicKey` of a
  /// message whose digest is `digest`.
  ///
  /// A digest longer than 32 bytes is cut to its first 32 bytes, as ECDSA requires.
  ///
  /// # Errors
  /// - `InvalidKey`, `InvalidEncoding`, or `AuthenticationFailed`, as for [`EcdsaSecp256k1.verify`].
  pub fn verifyDigest(publicKey: &[u8], digest: &[u8], signature: &[u8]) -> Result<
    (),
    Secp256k1SignatureError,
  > {
    let admitted = admitPoint(publicKey)
    return match move admitted {
      Result<Point, Secp256k1Error>.Success {value} => verifyScalars(value, digestScalar(digest), signature)
      Result<Point, Secp256k1Error>.Failure {..} => Result<(), Secp256k1SignatureError>.failResult(
        Secp256k1SignatureError.InvalidKey,
      )
    }
  }
  /// Returns the fixed 64-byte form of the DER signature `signature`.
  ///
  /// # Errors
  /// - `InvalidEncoding` if `signature` is not strict DER, or `r` or `s` is not between 1 and the
  ///   order of the curve.
  pub fn fromDer(signature: &[u8]) -> Result<[u8; 64], Secp256k1SignatureError> {
    return parseDer(signature)
  }
  /// Writes the DER form of the fixed 64-byte signature `signature` to the start of `output`, and
  /// returns its length, at most 72 bytes.
  ///
  /// It does not check the values of `r` and `s`. The bytes of `output` after the DER do not
  /// change.
  ///
  /// # Gotchas
  /// The program traps if `signature` is not 64 bytes, or `output` is shorter than the DER.
  pub fn toDer(signature: &[u8], output: &mut [u8]) -> usize {
    if signature.length != 64 {
      Intrinsic.trap("EcdsaSecp256k1.toDer: the signature is not 64 bytes")
    }
    let rLength = derIntegerLength(signature, 0, 32)
    let sLength = derIntegerLength(signature, 32, 32)
    output[0] = 48
    output[1] = usize.toU8(rLength + sLength + 4)
    let mut position: usize = 2
    position = writeDerInteger(signature, 0, 32, rLength, &mut output, position)
    position = writeDerInteger(signature, 32, 32, sLength, &mut output, position)
    return position
  }
}

// The length of the DER INTEGER content for the `size` big-endian bytes at `start`.
fn derIntegerLength(raw: &[u8], start: usize, size: usize) -> usize {
  let mut skip: usize = 0
  while skip + 1 < size && raw[start + skip] == 0 {
    skip = skip + 1
  }
  if raw[start + skip] >= 128 {
    return size + 1 - skip
  }
  return size - skip
}

fn writeDerInteger(
  raw: &[u8],
  start: usize,
  size: usize,
  length: usize,
  output: &mut [u8],
  position: usize,
) -> usize {
  output[position] = 2
  output[position + 1] = usize.toU8(length)
  let mut at = position + 2
  let mut source = start
  if length > size {
    output[at] = 0
    at = at + 1
  } else {
    source = start + size - length
  }
  while source < start + size {
    output[at] = raw[source]
    at = at + 1
    source = source + 1
  }
  return at
}
