fn fillDigest32(state: &State32, output: &mut [u8]) -> () {
  let mut index = usize.ZERO
  while index < output.length {
    output[index] = digestByte32(state, index)
    index = index + usize.ONE
  }
  return ()
}

fn fillDigest64(state: &State64, output: &mut [u8]) -> () {
  let mut index = usize.ZERO
  while index < output.length {
    output[index] = digestByte64(state, index)
    index = index + usize.ONE
  }
  return ()
}

