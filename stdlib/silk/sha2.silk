//! Portable SHA-2 states for six fixed-output cryptographic digest algorithms.
//!
//! # When to use
//! Use [`Sha224`] or [`Sha256`] for a 28-byte or 32-byte digest with 32-bit processing. Use
//! [`Sha384`], [`Sha512`], [`Sha512_224`], or [`Sha512_256`] for SHA-512-family processing.
//! Use `silk.hash` only for collection keys. It is not a cryptographic hash.
//!
//! # Details
//! Each actor supports incremental input through `update`, consuming finalization through
//! `finish`, and one-shot input through `hash`. The states use only inline storage and allocate no
//! memory. Each digest uses the standardized big-endian byte order.
//! [`Sha256.checkpoint`] and [`Sha384.checkpoint`] also return a digest without consuming the
//! streaming state. Use these operations for exact protocol transcript boundaries.
//!
//! # Gotchas
//! If an update exceeds the algorithm's standard bit-length domain, the program traps. `finish`
//! consumes its state, so the program cannot update or finish that state again.
//!
//! # Examples
//! ## Compare incremental and one-shot SHA-256
//! ```silk
//! import silk.sha2 {Sha256}
//!
//! pub fn main() -> i32 {
//!   let message: [u8; 3] = [97, 98, 99]
//!   let mut state = Sha256.make()
//!   state.update(&message)
//!   let incremental = state.finish()
//!   let oneShot = Sha256.hash(&message)
//!   if incremental[0] != 186 || oneShot[0] != 186 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```

import silk.static_sequence { StaticSequence }
import silk.u32
import silk.u64
import silk.u8
import silk.usize

/// An allocation-free incremental SHA-224 state that returns a 28-byte digest.
pub struct Sha224 {
  state: State32
}

impl Sha224 {
  /// Creates an empty SHA-224 state.
  pub fn make() -> Sha224 {
    return Sha224 {state: makeState32(sha224Initial())}
  }
  /// Adds `bytes` to this SHA-224 state in source order. An empty slice does not change the state.
  /// If the complete message exceeds the 64-bit bit-length domain, the program traps.
  pub fn update(self: &mut Self, bytes: &[u8]) -> () {
    return update32(&mut self.state, bytes)
  }
  /// Consumes this SHA-224 state and returns its 28-byte digest in big-endian byte order.
  pub fn finish(self: Self) -> [u8; 28] {
    let state = finish32(move self.state)
    return digest32_28(&state)
  }
  /// Returns the 28-byte SHA-224 digest of `bytes`. If the message is too long, the program traps.
  pub fn hash(bytes: &[u8]) -> [u8; 28] {
    let mut state = Sha224.make()
    state.update(bytes)
    return state.finish()
  }
}

/// An allocation-free incremental SHA-256 state that returns a 32-byte digest.
pub struct Sha256 {
  state: State32
}

impl Sha256 {
  /// Creates an empty SHA-256 state.
  pub fn make() -> Sha256 {
    return Sha256 {state: makeState32(sha256Initial())}
  }
  /// Adds `bytes` to this SHA-256 state in source order. An empty slice does not change the state.
  /// If the complete message exceeds the 64-bit bit-length domain, the program traps.
  pub fn update(self: &mut Self, bytes: &[u8]) -> () {
    return update32(&mut self.state, bytes)
  }
  /// Returns the SHA-256 digest of all bytes supplied so far without consuming this state.
  ///
  /// # Details
  ///
  /// The operation copies the fixed inline state. A later `update` or `checkpoint` continues from
  /// the same original byte sequence.
  pub fn checkpoint(self: &Self) -> [u8; 32] {
    let copied = copyState32(&self.state)
    let finished = finish32(move copied)
    return digest32_32(&finished)
  }
  /// Consumes this SHA-256 state and returns its 32-byte digest in big-endian byte order.
  pub fn finish(self: Self) -> [u8; 32] {
    let state = finish32(move self.state)
    return digest32_32(&state)
  }
  /// Returns the 32-byte SHA-256 digest of `bytes`. If the message is too long, the program traps.
  pub fn hash(bytes: &[u8]) -> [u8; 32] {
    let mut state = Sha256.make()
    state.update(bytes)
    return state.finish()
  }
}

/// An allocation-free incremental SHA-384 state that returns a 48-byte digest.
pub struct Sha384 {
  state: State64
}

impl Sha384 {
  /// Creates an empty SHA-384 state.
  pub fn make() -> Sha384 {
    return Sha384 {state: makeState64(sha384Initial())}
  }
  /// Adds `bytes` to this SHA-384 state in source order. An empty slice does not change the state.
  /// If the complete message exceeds the 128-bit bit-length domain, the program traps.
  pub fn update(self: &mut Self, bytes: &[u8]) -> () {
    return update64(&mut self.state, bytes)
  }
  /// Returns the SHA-384 digest of all bytes supplied so far without consuming this state.
  ///
  /// # Details
  ///
  /// The operation copies the fixed inline state. A later `update` or `checkpoint` continues from
  /// the same original byte sequence.
  pub fn checkpoint(self: &Self) -> [u8; 48] {
    let copied = copyState64(&self.state)
    let finished = finish64(move copied)
    return digest64_48(&finished)
  }
  /// Consumes this SHA-384 state and returns its 48-byte digest in big-endian byte order.
  pub fn finish(self: Self) -> [u8; 48] {
    let state = finish64(move self.state)
    return digest64_48(&state)
  }
  /// Returns the 48-byte SHA-384 digest of `bytes`. If the message is too long, the program traps.
  pub fn hash(bytes: &[u8]) -> [u8; 48] {
    let mut state = Sha384.make()
    state.update(bytes)
    return state.finish()
  }
}

/// An allocation-free incremental SHA-512 state that returns a 64-byte digest.
pub struct Sha512 {
  state: State64
}

impl Sha512 {
  /// Creates an empty SHA-512 state.
  pub fn make() -> Sha512 {
    return Sha512 {state: makeState64(sha512Initial())}
  }
  /// Adds `bytes` to this SHA-512 state in source order. An empty slice does not change the state.
  /// If the complete message exceeds the 128-bit bit-length domain, the program traps.
  pub fn update(self: &mut Self, bytes: &[u8]) -> () {
    return update64(&mut self.state, bytes)
  }
  /// Consumes this SHA-512 state and returns its 64-byte digest in big-endian byte order.
  pub fn finish(self: Self) -> [u8; 64] {
    let state = finish64(move self.state)
    return digest64_64(&state)
  }
  /// Returns the 64-byte SHA-512 digest of `bytes`. If the message is too long, the program traps.
  pub fn hash(bytes: &[u8]) -> [u8; 64] {
    let mut state = Sha512.make()
    state.update(bytes)
    return state.finish()
  }
}

/// An allocation-free incremental SHA-512/224 state that returns a 28-byte digest.
pub struct Sha512_224 {
  state: State64
}

impl Sha512_224 {
  /// Creates an empty SHA-512/224 state.
  pub fn make() -> Sha512_224 {
    return Sha512_224 {state: makeState64(sha512_224Initial())}
  }
  /// Adds `bytes` to this SHA-512/224 state in source order. An empty slice does not change the
  /// state. If the complete message exceeds the 128-bit bit-length domain, the program traps.
  pub fn update(self: &mut Self, bytes: &[u8]) -> () {
    return update64(&mut self.state, bytes)
  }
  /// Consumes this SHA-512/224 state and returns its 28-byte digest in big-endian byte order.
  pub fn finish(self: Self) -> [u8; 28] {
    let state = finish64(move self.state)
    return digest64_28(&state)
  }
  /// Returns the 28-byte SHA-512/224 digest of `bytes`. If the message is too long, the program
  /// traps.
  pub fn hash(bytes: &[u8]) -> [u8; 28] {
    let mut state = Sha512_224.make()
    state.update(bytes)
    return state.finish()
  }
}

/// An allocation-free incremental SHA-512/256 state that returns a 32-byte digest.
pub struct Sha512_256 {
  state: State64
}

impl Sha512_256 {
  /// Creates an empty SHA-512/256 state.
  pub fn make() -> Sha512_256 {
    return Sha512_256 {state: makeState64(sha512_256Initial())}
  }
  /// Adds `bytes` to this SHA-512/256 state in source order. An empty slice does not change the
  /// state. If the complete message exceeds the 128-bit bit-length domain, the program traps.
  pub fn update(self: &mut Self, bytes: &[u8]) -> () {
    return update64(&mut self.state, bytes)
  }
  /// Consumes this SHA-512/256 state and returns its 32-byte digest in big-endian byte order.
  pub fn finish(self: Self) -> [u8; 32] {
    let state = finish64(move self.state)
    return digest64_32(&state)
  }
  /// Returns the 32-byte SHA-512/256 digest of `bytes`. If the message is too long, the program
  /// traps.
  pub fn hash(bytes: &[u8]) -> [u8; 32] {
    let mut state = Sha512_256.make()
    state.update(bytes)
    return state.finish()
  }
}

struct State32 {
  words: [u32; 8]
  buffer: [u8; 64]
  buffered: usize
  bitLength: u64
}

struct State64 {
  words: [u64; 8]
  buffer: [u8; 128]
  buffered: usize
  bitLengthHigh: u64
  bitLengthLow: u64
}

struct Length64Transition {
  high: u64
  low: u64
  overflow: bool
}

fn copyState32(state: &State32) -> State32 {
  return State32 {
    words: state.words,
    buffer: state.buffer,
    buffered: state.buffered,
    bitLength: state.bitLength,
  }
}

fn copyState64(state: &State64) -> State64 {
  return State64 {
    words: state.words,
    buffer: state.buffer,
    buffered: state.buffered,
    bitLengthHigh: state.bitLengthHigh,
    bitLengthLow: state.bitLengthLow,
  }
}

fn length64Transition(high: u64, low: u64, byteLength: u64) -> Length64Transition {
  let highIncrement = u64.shiftRight(byteLength, 61)
  let lowIncrement = u64.shiftLeft(byteLength, 3)
  if high > u64.MAX - highIncrement {
    return Length64Transition {high: u64.MIN, low: u64.MIN, overflow: true}
  }
  let mut nextHigh = high + highIncrement
  let nextLow = u64.wrappingAdd(low, lowIncrement)
  if nextLow < low {
    if nextHigh == u64.MAX {
      return Length64Transition {high: u64.MIN, low: u64.MIN, overflow: true}
    }
    nextHigh = nextHigh + 1
  }
  return Length64Transition {high: nextHigh, low: nextLow, overflow: false}
}

fn makeState32(words: [u32; 8]) -> State32 {
  return State32 {words: words, buffer: zeroBlock32(), buffered: usize.ZERO, bitLength: u64.MIN}
}

fn makeState64(words: [u64; 8]) -> State64 {
  return State64 {
    words: words,
    buffer: zeroBlock64(),
    buffered: usize.ZERO,
    bitLengthHigh: u64.MIN,
    bitLengthLow: u64.MIN,
  }
}

fn update32(state: &mut State32, bytes: &[u8]) -> () {
  let byteLength = usize.toU64(bytes.length)
  if byteLength > u64.shiftRight(u64.MAX, 3) {
    let overlong = 1 / 0
  }
  let increment = u64.shiftLeft(byteLength, 3)
  if state.bitLength > u64.MAX - increment {
    let overlong = 1 / 0
  }
  state.bitLength = state.bitLength + increment

  let mut index = usize.ZERO
  while index < bytes.length {
    state.buffer[state.buffered] = bytes[index]
    state.buffered = state.buffered + usize.ONE
    index = index + usize.ONE
    if state.buffered == 64 {
      compress32(&mut state)
      state.buffered = usize.ZERO
    }
  }
  return ()
}

fn update64(state: &mut State64, bytes: &[u8]) -> () {
  let byteLength = usize.toU64(bytes.length)
  let transition = length64Transition(state.bitLengthHigh, state.bitLengthLow, byteLength)
  if transition.overflow {
    let overlong = 1 / 0
  }
  state.bitLengthHigh = transition.high
  state.bitLengthLow = transition.low

  let mut index = usize.ZERO
  while index < bytes.length {
    state.buffer[state.buffered] = bytes[index]
    state.buffered = state.buffered + usize.ONE
    index = index + usize.ONE
    if state.buffered == 128 {
      compress64(&mut state)
      state.buffered = usize.ZERO
    }
  }
  return ()
}

fn finish32(mut state: State32) -> State32 {
  state.buffer[state.buffered] = 128
  state.buffered = state.buffered + usize.ONE
  if state.buffered > 56 {
    let buffered = state.buffered
    zero32(&mut state, buffered)
    compress32(&mut state)
    state.buffered = usize.ZERO
  }
  let buffered = state.buffered
  zero32(&mut state, buffered)
  let bitLength = state.bitLength
  writeU64BigEndian(&mut state.buffer, 56, bitLength)
  compress32(&mut state)
  return move state
}

fn finish64(mut state: State64) -> State64 {
  state.buffer[state.buffered] = 128
  state.buffered = state.buffered + usize.ONE
  if state.buffered > 112 {
    let buffered = state.buffered
    zero64(&mut state, buffered)
    compress64(&mut state)
    state.buffered = usize.ZERO
  }
  let buffered = state.buffered
  zero64(&mut state, buffered)
  let bitLengthHigh = state.bitLengthHigh
  let bitLengthLow = state.bitLengthLow
  writeU64BigEndian(&mut state.buffer, 112, bitLengthHigh)
  writeU64BigEndian(&mut state.buffer, 120, bitLengthLow)
  compress64(&mut state)
  return move state
}

fn zero32(state: &mut State32, start: usize) -> () {
  let mut index = start
  while index < 64 {
    state.buffer[index] = 0
    index = index + usize.ONE
  }
  return ()
}

fn zero64(state: &mut State64, start: usize) -> () {
  let mut index = start
  while index < 128 {
    state.buffer[index] = 0
    index = index + usize.ONE
  }
  return ()
}

fn writeU64BigEndian(output: &mut [u8], offset: usize, value: u64) -> () {
  let mut index = usize.ZERO
  while index < 8 {
    let shift = usize.toU64((7 - index) * 8)
    output[offset + index] = u64.toU8(u64.bitAnd(u64.shiftRight(value, shift), 255))
    index = index + usize.ONE
  }
  return ()
}

