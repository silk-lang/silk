fn digestByte32(state: &State32, index: usize) -> u8 {
  let wordIndex = index / 4
  let shift = usize.toU32((3 - index % 4) * 8)
  return u32.toU8(u32.bitAnd(u32.shiftRight(state.words[wordIndex], shift), 255))
}

fn digestByte64(state: &State64, index: usize) -> u8 {
  let wordIndex = index / 8
  let shift = usize.toU64((7 - index % 8) * 8)
  return u64.toU8(u64.bitAnd(u64.shiftRight(state.words[wordIndex], shift), 255))
}

