//! Atomic memory operations on raw pointers, with explicit memory orderings.
//!
//! # When to use
//!
//! Use these operations to build synchronization: counters, flags, lock words, and queues that
//! several threads read and write at once.
//!
//! # Details
//!
//! Each operation is one indivisible access to a naturally aligned integer or data pointer. The
//! [`MemoryOrder`] argument is static, so an operation and its ordering are fixed at compile time.
//! The model is the C++20 one: an acquire load that reads a release store makes every write before
//! that store visible after the load.
//!
//! # Gotchas
//!
//! A plain access that races with any other access to the same location is undefined behavior,
//! even when the other access is atomic. Every access to a shared location must be atomic, and
//! all of them must use the same width.

import silk.ownership { Copy }

/// The ordering constraint of one atomic operation.
pub enum MemoryOrder {
  /// Atomicity only; orders nothing else.
  Relaxed,
  /// A load that later reads and writes cannot move before.
  Acquire,
  /// A store that earlier reads and writes cannot move after.
  Release,
  /// Both acquire and release; for read-modify-write operations and fences.
  AcquireRelease,
  /// Acquire and release, plus one total order over every sequentially consistent operation.
  SequentiallyConsistent,
}

// The static text the atomic intrinsics take for `order`.
static fn spelling(order: MemoryOrder) -> string<'static> {
  if order == MemoryOrder.Relaxed { return "relaxed" }
  if order == MemoryOrder.Acquire { return "acquire" }
  if order == MemoryOrder.Release { return "release" }
  if order == MemoryOrder.AcquireRelease { return "acquireRelease" }
  return "sequentiallyConsistent"
}

/// The outcome of a compare-exchange.
pub union CompareExchange<T> {
  /// The pointee equaled the expected value and now holds the desired one.
  Exchanged,
  /// The pointee held `value`, and nothing was stored.
  Observed {
    /// The value read instead of the expected one.
    pub value: T
  }
}

/// The atomic operations over raw pointers.
///
/// # Details
///
/// `T` is one of `u8`, `u16`, `u32`, `u64`, `usize`, `i8`, `i16`, `i32`, `i64`, `isize`, or a data
/// pointer for `load`, `store`, `swap`, and the compare-exchanges. The arithmetic and bitwise
/// operations take integers only and wrap on overflow.
pub struct Atomic {}

impl Atomic {
  /// Reads the pointee atomically.
  ///
  /// # Safety
  ///
  /// The pointer must address live, initialized, naturally aligned storage for `T`. The order must
  /// be `Relaxed`, `Acquire`, or `SequentiallyConsistent`.
  pub unsafe fn load<T: Copy>(pointer: *const T, static order: MemoryOrder) -> T {
    let static spelled = spelling(order)
    unsafe { return Intrinsic.atomicLoad<T>(pointer, spelled) }
  }

  /// Writes `value` to the pointee atomically.
  ///
  /// # Safety
  ///
  /// The pointer must address live, naturally aligned, writable storage for `T`. The order must be
  /// `Relaxed`, `Release`, or `SequentiallyConsistent`.
  pub unsafe fn store<T: Copy>(pointer: *mut T, value: T, static order: MemoryOrder) -> () {
    let static spelled = spelling(order)
    unsafe { return Intrinsic.atomicStore<T>(pointer, value, spelled) }
  }

  /// Replaces the pointee with `value` and returns the previous value.
  ///
  /// # Safety
  ///
  /// The pointer must address live, initialized, naturally aligned, writable storage for `T`.
  pub unsafe fn swap<T: Copy>(pointer: *mut T, value: T, static order: MemoryOrder) -> T {
    let static spelled = spelling(order)
    unsafe { return Intrinsic.atomicSwap<T>(pointer, value, spelled) }
  }

  /// Stores `desired` when the pointee equals `expected`, or reports the value it held instead.
  ///
  /// # Details
  ///
  /// `success` orders the exchange; `failure` orders the read when nothing is stored, and must be
  /// `Relaxed`, `Acquire`, or `SequentiallyConsistent`.
  ///
  /// # Safety
  ///
  /// The pointer must address live, initialized, naturally aligned, writable storage for `T`.
  pub unsafe fn compareExchange<T: Copy>(pointer: *mut T, expected: T, desired: T, static success: MemoryOrder,
    static failure: MemoryOrder) -> CompareExchange<T> {
    let static onSuccess = spelling(success)
    let static onFailure = spelling(failure)
    let mut observed = expected
    let exchanged = unsafe Intrinsic.atomicCompareExchange<T>(pointer, Intrinsic.pointerFromMutRef<T>(&mut observed), desired,
      onSuccess, onFailure)
    if exchanged { return CompareExchange<T>.Exchanged }
    return CompareExchange<T>.Observed {value: observed}
  }

  /// Like [`Atomic.compareExchange`], but may report `Observed` with a value equal to `expected`.
  ///
  /// # Details
  ///
  /// The spurious failure lets a load-linked, store-conditional target use one attempt per
  /// call. Call it in a loop that retries on any observed value.
  ///
  /// # Safety
  ///
  /// The pointer must address live, initialized, naturally aligned, writable storage for `T`.
  pub unsafe fn compareExchangeWeak<T: Copy>(pointer: *mut T, expected: T, desired: T, static success: MemoryOrder,
    static failure: MemoryOrder) -> CompareExchange<T> {
    let static onSuccess = spelling(success)
    let static onFailure = spelling(failure)
    let mut observed = expected
    let exchanged = unsafe Intrinsic.atomicCompareExchangeWeak<T>(pointer, Intrinsic.pointerFromMutRef<T>(&mut observed),
      desired, onSuccess, onFailure)
    if exchanged { return CompareExchange<T>.Exchanged }
    return CompareExchange<T>.Observed {value: observed}
  }

  /// Adds `value` to the pointee, wrapping on overflow, and returns the previous value.
  ///
  /// # Safety
  ///
  /// The pointer must address live, initialized, naturally aligned, writable storage for `T`.
  pub unsafe fn fetchAdd<T: Copy>(pointer: *mut T, value: T, static order: MemoryOrder) -> T {
    let static spelled = spelling(order)
    unsafe { return Intrinsic.atomicFetchAdd<T>(pointer, value, spelled) }
  }

  /// Subtracts `value` from the pointee, wrapping on overflow, and returns the previous value.
  ///
  /// # Safety
  ///
  /// The pointer must address live, initialized, naturally aligned, writable storage for `T`.
  pub unsafe fn fetchSubtract<T: Copy>(pointer: *mut T, value: T, static order: MemoryOrder) -> T {
    let static spelled = spelling(order)
    unsafe { return Intrinsic.atomicFetchSubtract<T>(pointer, value, spelled) }
  }

  /// Stores the bitwise and of the pointee and `value`, and returns the previous value.
  ///
  /// # Safety
  ///
  /// The pointer must address live, initialized, naturally aligned, writable storage for `T`.
  pub unsafe fn fetchBitAnd<T: Copy>(pointer: *mut T, value: T, static order: MemoryOrder) -> T {
    let static spelled = spelling(order)
    unsafe { return Intrinsic.atomicFetchBitAnd<T>(pointer, value, spelled) }
  }

  /// Stores the bitwise or of the pointee and `value`, and returns the previous value.
  ///
  /// # Safety
  ///
  /// The pointer must address live, initialized, naturally aligned, writable storage for `T`.
  pub unsafe fn fetchBitOr<T: Copy>(pointer: *mut T, value: T, static order: MemoryOrder) -> T {
    let static spelled = spelling(order)
    unsafe { return Intrinsic.atomicFetchBitOr<T>(pointer, value, spelled) }
  }

  /// Stores the bitwise exclusive or of the pointee and `value`, and returns the previous value.
  ///
  /// # Safety
  ///
  /// The pointer must address live, initialized, naturally aligned, writable storage for `T`.
  pub unsafe fn fetchBitXor<T: Copy>(pointer: *mut T, value: T, static order: MemoryOrder) -> T {
    let static spelled = spelling(order)
    unsafe { return Intrinsic.atomicFetchBitXor<T>(pointer, value, spelled) }
  }

  /// Stores the smaller of the pointee and `value`, and returns the previous value.
  ///
  /// # Safety
  ///
  /// The pointer must address live, initialized, naturally aligned, writable storage for `T`.
  pub unsafe fn fetchMinimum<T: Copy>(pointer: *mut T, value: T, static order: MemoryOrder) -> T {
    let static spelled = spelling(order)
    unsafe { return Intrinsic.atomicFetchMinimum<T>(pointer, value, spelled) }
  }

  /// Stores the larger of the pointee and `value`, and returns the previous value.
  ///
  /// # Safety
  ///
  /// The pointer must address live, initialized, naturally aligned, writable storage for `T`.
  pub unsafe fn fetchMaximum<T: Copy>(pointer: *mut T, value: T, static order: MemoryOrder) -> T {
    let static spelled = spelling(order)
    unsafe { return Intrinsic.atomicFetchMaximum<T>(pointer, value, spelled) }
  }

  /// Orders memory accesses around this point without accessing memory itself.
  ///
  /// # Details
  ///
  /// The order must not be `Relaxed`. A release fence before a relaxed store, paired with an
  /// acquire fence after a relaxed load that reads it, synchronizes like a release store and an
  /// acquire load.
  pub fn fence(static order: MemoryOrder) -> () {
    let static spelled = spelling(order)
    return Intrinsic.atomicFence(spelled)
  }
}
