//! Days of the year without a year: the [`PlainMonthDay`] type, such as November 19.
//!
//! # When to use
//!
//! Use [`PlainMonthDay`] for a day that comes back every year: a birthday, an anniversary, a
//! fixed holiday. [`PlainMonthDay.atYear`] gives the date in one year.
//!
//! # Details
//!
//! The month and the day are in the ISO 8601 calendar. February 29 is a valid value. The text
//! form is `MM-DD`.
//!
//! # Examples
//!
//! ## Find a birthday in two years
//!
//! ```silk
//! import silk.core.option { Option }
//! import silk.time.period { Overflow }
//! import silk.time.plain_date { PlainDate }
//! import silk.time.plain_month_day { PlainMonthDay }
//!
//! pub fn main() -> i32 {
//!   let birthday = PlainMonthDay.make(2, 29)
//!   match birthday.atYear(2028, Overflow.Reject) {
//!     Option<PlainDate>.Some { value } => {
//!       if value.day() != 29 {
//!         return 1
//!       }
//!     }
//!     Option<PlainDate>.None => {
//!       return 2
//!     }
//!   }
//!   // 2027 has no February 29.
//!   match birthday.atYear(2027, Overflow.Constrain) {
//!     Option<PlainDate>.Some { value } => {
//!       if value.day() != 28 {
//!         return 3
//!       }
//!     }
//!     Option<PlainDate>.None => {
//!       return 4
//!     }
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Time
import silk.collections.slice { Slice }
import silk.core.equal { Equal }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.text.format { Debug, Display, Format, Formatter }
import silk.text.string { String }
import silk.time.civil as Civil
import silk.time.period { Overflow }
import silk.time.plain_date { PlainDate }
import silk.time.text as Text
import silk.time.text { OffsetKind, Scanner, TimeParseError, TimeParseReason }
import silk.num.u32
import silk.num.u8

/// A month and a day of the month, without a year, in the ISO 8601 calendar.
///
/// # Details
///
/// `==` and `!=` compare the month and the day. There is no order, because a day of the year
/// is neither before nor after another without a year. `Display` writes `MM-DD`.
pub struct PlainMonthDay {
  isoMonth: u8,
  isoDay: u8,
}

impl Copy for PlainMonthDay {}

impl PlainMonthDay {
  /// Returns day `day` of month `month`, from 1 to 12.
  ///
  /// # Gotchas
  ///
  /// A day that no year has, such as February 30, traps. [`PlainMonthDay.checkedMake`] returns
  /// `None` instead.
  pub fn make(month: u8, day: u8) -> PlainMonthDay {
    match PlainMonthDay.checkedMake(month, day) {
      Option<PlainMonthDay>.Some { value } => {
        return value
      }
      Option<PlainMonthDay>.None => {
        return Intrinsic.trap("PlainMonthDay.make: no year has that day")
      }
    }
  }

  /// Returns day `day` of month `month`, from 1 to 12, or `None` when no year has that day.
  /// February 29 is valid.
  pub fn checkedMake(month: u8, day: u8) -> Option<PlainMonthDay> {
    // 1972 is a leap year.
    if month < 1 || month > 12 || day < 1 || day > Civil.daysInMonth(1972, month) {
      return Option<PlainMonthDay>.none()
    }
    return Option<PlainMonthDay>.some(PlainMonthDay { isoMonth: month, isoDay: day })
  }

  /// Returns the month and the day of `date`.
  pub fn fromDate(date: PlainDate) -> PlainMonthDay {
    return PlainMonthDay { isoMonth: date.month(), isoDay: date.day() }
  }

  /// Returns the month, from 1 for January to 12 for December.
  pub fn month(self: Self) -> u8 {
    return self.isoMonth
  }

  /// Returns the day of the month, from 1.
  pub fn day(self: Self) -> u8 {
    return self.isoDay
  }

  /// Returns the date of this day in the year `year`, or `None` when the date is outside the
  /// range of `PlainDate`, or when the year has no such day and `overflow` is `Reject`.
  ///
  /// # Details
  ///
  /// Only February 29 can be absent from a year. `Overflow.Constrain` then gives February 28.
  pub fn atYear(self: Self, year: i32, overflow: Overflow) -> Option<PlainDate> {
    if year < -271821 || year > 275760 {
      return Option<PlainDate>.none()
    }
    let mut day = self.isoDay
    let last = Civil.daysInMonth(year, self.isoMonth)
    if day > last {
      match overflow {
        Overflow.Constrain => {
          day = last
        }
        Overflow.Reject => {
          return Option<PlainDate>.none()
        }
      }
    }
    return PlainDate.checkedMake(year, self.isoMonth, day)
  }

  /// Reads a month and a day from ISO 8601 text such as `11-19`.
  ///
  /// # Details
  ///
  /// The text is `MM-DD` or `MMDD`, optionally after `--`, as in `--11-19`. Bracketed
  /// annotations can follow. The text can also be a whole date, with or without a time, in the
  /// form that `PlainDate.parse` reads; the year is checked and then ignored.
  ///
  /// # Errors
  ///
  /// - `TimeParseReason.UnexpectedEnd` or `UnexpectedCharacter` if the text does not have that
  ///   form.
  /// - `TimeParseReason.OutOfRange` if no year has that month and day.
  /// - `TimeParseReason.UtcNotAllowed` if the text has the UTC designator `Z`.
  /// - `TimeParseReason.UnsupportedCalendar` if a calendar annotation is not `[u-ca=iso8601]`.
  /// - `TimeParseReason.UnknownCriticalAnnotation` if an annotation with an unknown key starts
  ///   with `!`.
  pub fn parse(text: string) -> Result<PlainMonthDay, TimeParseError> {
    return PlainMonthDay.parseBytes(String.utf8Bytes(text))
  }

  /// Reads a month and a day from the bytes of ISO 8601 text such as `11-19`.
  ///
  /// # Details
  ///
  /// The form is the one of [`PlainMonthDay.parse`].
  ///
  /// # Errors
  ///
  /// - The errors of [`PlainMonthDay.parse`].
  pub fn parseBytes(bytes: &[u8]) -> Result<PlainMonthDay, TimeParseError> {
    let mut month: u32 = 0
    let mut day: u32 = 0
    let mut dayAt: usize = 0
    let mut whole = Scanner.make(bytes)
    let parsed = whole.dateTime()
    match whole.failure() {
      Option<TimeParseError>.None => {
        match parsed.offset.kind {
          OffsetKind.Utc => {
            return Result<PlainMonthDay, TimeParseError>.failResult(
              TimeParseError { reason: TimeParseReason.UtcNotAllowed, offset: 0 },
            )
          }
          _ => {}
        }
        month = u8.toU32(parsed.date.month)
        day = u8.toU32(parsed.date.day)
      }
      Option<TimeParseError>.Some { value: _ } => {
        let mut short = Scanner.make(bytes)
        if short.accept(45) {
          short.expect(45)
        }
        let monthAt = short.position()
        month = short.digits(2)
        drop short.accept(45)
        dayAt = short.position()
        day = short.digits(2)
        short.annotations()
        short.end()
        if month < 1 || month > 12 {
          short.reject(TimeParseReason.OutOfRange, monthAt)
        }
        match short.failure() {
          Option<TimeParseError>.Some { value } => {
            return Result<PlainMonthDay, TimeParseError>.failResult(value)
          }
          Option<TimeParseError>.None => {}
        }
      }
    }
    match PlainMonthDay.checkedMake(u32.toU8(month), u32.toU8(day)) {
      Option<PlainMonthDay>.Some { value } => {
        return Result<PlainMonthDay, TimeParseError>.succeed(value)
      }
      Option<PlainMonthDay>.None => {
        return Result<PlainMonthDay, TimeParseError>.failResult(
          TimeParseError { reason: TimeParseReason.OutOfRange, offset: dayAt },
        )
      }
    }
  }

  fn same(left: &PlainMonthDay, right: &PlainMonthDay) -> bool {
    return left.isoMonth == right.isoMonth && left.isoDay == right.isoDay
  }
}

impl Equal for PlainMonthDay {
  equals: PlainMonthDay.same
}

/// Writes the month and the day as `MM-DD`, as in `11-19`.
impl Display for PlainMonthDay {
  effect fn display(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    let mut output: [u8; 5] = [0; 5]
    let mut length = Text.writeTwo(&mut output, 0, self.isoMonth)
    output[length] = 45
    length = Text.writeTwo(&mut output, length + 1, self.isoDay)
    return run Format.write(&mut formatter, Slice.view<u8>(&output, 0, length))
  }
}

/// Writes the same text as `Display`: the month and the day as `MM-DD`.
impl Debug for PlainMonthDay {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return run Display.display(self, &mut formatter)
  }
}
