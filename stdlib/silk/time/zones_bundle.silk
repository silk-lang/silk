//! A `TimeZones` provider over the bytes of a time zone bundle: one file with every zone of a
//! release of the IANA time zone database.
//!
//! # When to use
//!
//! Use [`ZoneBundle`] in a program that ships or downloads its own bundle, for example a newer
//! release than the one inside the standard library. Use `BundledTimeZones` of
//! `silk.time.zones_bundled` for the bundle that the standard library carries, and `OsTimeZones`
//! of `silk.time.zones_native` for the zones of the operating system.
//!
//! # Details
//!
//! A bundle is the file that `scripts/time/generate-tzdb` of the Silk repository writes. It
//! holds the names of all zones and links, one TZif file for each distinct zone, the name of the
//! release, and the table that maps the zone names of Windows to IANA names.
//! [`ZoneBundle.fromBytes`] checks the tables one time, and a lookup then reads only the entry
//! and the TZif file of one zone.
//!
//! # Examples
//!
//! ## Read a zone from a bundle file
//!
//! ```silk,ignore
//! import silk.build.source { Source }
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.core.effect { Effect }
//! import silk.time.zone { Zone }
//! import silk.time.zones { TimeZones, ZoneLookupError }
//! import silk.time.zones_bundle { ZoneBundle }
//!
//! effect fn rome() -> Zone ! ZoneLookupError | OutOfMemoryError ? &mut Allocator {
//!   let mut zones = run ZoneBundle.fromBytes(Source.read("data/tzdb.bin"))
//!   return run TimeZones.zone("Europe/Rome") |> Effect.provideMut<TimeZones>(&mut zones)
//! }
//! ```
//!
//! @category Time
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.encoding.endian { readU32BigEndian }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }
import silk.time.zone { Zone, ZoneDataError }
import silk.time.zones { TimeZones, ZoneLookupError, ZoneLookupReason }
import silk.num.u32
import silk.num.usize

const HEADER: usize = 40
const NAME_ENTRY: usize = 12
const DATA_ENTRY: usize = 8
const WINDOWS_ENTRY: usize = 12

/// A `TimeZones` provider over the bytes of one time zone bundle. It owns the bytes.
///
/// # Details
///
/// The provider gives every zone and link of the bundle, and `UTC` and fixed offsets as every
/// provider does. Names are compared without letter case, and a zone has the name as the bundle
/// spells it. [`ZoneBundle.windowsZone`] gives the IANA name for a zone name of Windows.
pub struct ZoneBundle {
  data: Bytes,
  zoneCount: usize,
  namesAt: usize,
  dataCount: usize,
  dataAt: usize,
  windowsCount: usize,
  windowsAt: usize,
}

impl ZoneBundle {
  /// Returns a provider over a copy of the bundle `data`.
  ///
  /// # Errors
  ///
  /// - `ZoneLookupError` with the reason `InvalidData` if `data` is not a bundle or one of its
  ///   tables points outside the data.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the copy.
  pub effect fn fromBytes(data: &[u8]) -> ZoneBundle ! ZoneLookupError | OutOfMemoryError ? &mut Allocator {
    return run ZoneBundle.fromOwned(run Bytes.copy(data))
  }

  /// Returns a provider over the bundle `data`, which it takes over without a copy.
  ///
  /// # Errors
  ///
  /// - `ZoneLookupError` with the reason `InvalidData` if `data` is not a bundle or one of its
  ///   tables points outside the data.
  pub effect fn fromOwned(data: Bytes) -> ZoneBundle ! ZoneLookupError {
    let mut bundle = ZoneBundle {
      data: move data,
      zoneCount: 0,
      namesAt: 0,
      dataCount: 0,
      dataAt: 0,
      windowsCount: 0,
      windowsAt: 0,
    }
    if !bundle.readTables() {
      fail TimeZones.lookupFailure(ZoneLookupReason.InvalidData)
    }
    return move bundle
  }

  /// Returns the IANA zone name for the zone name of Windows `name`, such as `Europe/Berlin`
  /// for `W. Europe Standard Time`, or `None` if the bundle does not list the name. Letter case
  /// does not matter.
  ///
  /// # Details
  ///
  /// The table is the one of the Unicode CLDR project, with the default zone of each Windows
  /// name.
  pub fn windowsZone(self: &Self, name: &[u8]) -> Option<&[u8]> {
    let bytes = Bytes.asSlice(&self.data)
    let mut index = usize.ZERO
    while index < self.windowsCount {
      let entry = self.windowsAt + index * WINDOWS_ENTRY
      if sameText(span(bytes, entry), name) {
        let target = u32.toUsize(readU32BigEndian(bytes, entry + 8))
        return Option<&[u8]>.some(span(bytes, self.namesAt + target * NAME_ENTRY))
      }
      index = index + 1
    }
    return Option<&[u8]>.none()
  }

  /// Returns the number of zone names in the bundle, with the links.
  pub fn nameCount(self: &Self) -> usize {
    return self.zoneCount
  }

  /// Returns the name of the release of the time zone database, such as `2026b`.
  pub fn release(self: &Self) -> &[u8] {
    return span(Bytes.asSlice(&self.data), 8)
  }

  // Reads the header and checks that every entry of every table stays inside the data.
  fn readTables(self: &mut Self) -> bool {
    let bytes = Bytes.asSlice(&self.data)
    if bytes.length < HEADER {
      return false
    }
    let magic = b"SILKTZ1\x00"
    let mut index = usize.ZERO
    while index < magic.length {
      if bytes[index] != magic[index] {
        return false
      }
      index = index + 1
    }
    if !inside(bytes, 8) {
      return false
    }
    self.zoneCount = u32.toUsize(readU32BigEndian(bytes, 16))
    self.namesAt = u32.toUsize(readU32BigEndian(bytes, 20))
    self.dataCount = u32.toUsize(readU32BigEndian(bytes, 24))
    self.dataAt = u32.toUsize(readU32BigEndian(bytes, 28))
    self.windowsCount = u32.toUsize(readU32BigEndian(bytes, 32))
    self.windowsAt = u32.toUsize(readU32BigEndian(bytes, 36))
    if !tableInside(bytes, self.namesAt, self.zoneCount, NAME_ENTRY)
      || !tableInside(bytes, self.dataAt, self.dataCount, DATA_ENTRY)
      || !tableInside(bytes, self.windowsAt, self.windowsCount, WINDOWS_ENTRY) {
      return false
    }
    index = 0
    while index < self.zoneCount {
      let entry = self.namesAt + index * NAME_ENTRY
      if !inside(bytes, entry) || u32.toUsize(readU32BigEndian(bytes, entry + 8)) >= self.dataCount {
        return false
      }
      index = index + 1
    }
    index = 0
    while index < self.dataCount {
      if !inside(bytes, self.dataAt + index * DATA_ENTRY) {
        return false
      }
      index = index + 1
    }
    index = 0
    while index < self.windowsCount {
      let entry = self.windowsAt + index * WINDOWS_ENTRY
      if !inside(bytes, entry) || u32.toUsize(readU32BigEndian(bytes, entry + 8)) >= self.zoneCount {
        return false
      }
      index = index + 1
    }
    return true
  }

  effect fn zoneBytes(self: &mut Self, name: &[u8]) -> Zone ! ZoneLookupError | OutOfMemoryError ? &mut Allocator {
    if let Option<Zone>.Some { value } = move TimeZones.fixedZone(name) {
      return move value
    }
    if !TimeZones.isValidName(name) {
      fail TimeZones.lookupFailure(ZoneLookupReason.InvalidName)
    }
    let bytes = Bytes.asSlice(&self.data)
    let mut index = usize.ZERO
    while index < self.zoneCount {
      let entry = self.namesAt + index * NAME_ENTRY
      let listed = span(bytes, entry)
      if TimeZones.sameName(listed, name) {
        let file = span(bytes, self.dataAt + u32.toUsize(readU32BigEndian(bytes, entry + 8)) * DATA_ENTRY)
        // The generator wrote the names, and they are ASCII.
        let made = run Effect.result(Zone.fromTzif(unsafe String.fromUtf8Unchecked(listed), file))
        return match move made {
          Result<Zone, ZoneDataError | OutOfMemoryError>.Success { value } => move value
          Result<Zone, ZoneDataError | OutOfMemoryError>.Failure { error } => match move error {
            ZoneDataError _ => {
              fail TimeZones.lookupFailure(ZoneLookupReason.InvalidData)
            }
            OutOfMemoryError exhausted => {
              fail move exhausted
            }
          }
        }
      }
      index = index + 1
    }
    fail TimeZones.lookupFailure(ZoneLookupReason.UnknownZone)
  }

  effect fn names(self: &mut Self) -> List<Bytes> ! ZoneLookupError | OutOfMemoryError ? &mut Allocator {
    // The generator sorted the names by their bytes.
    let bytes = Bytes.asSlice(&self.data)
    let mut result = List<Bytes>.make()
    let mut index = usize.ZERO
    while index < self.zoneCount {
      run List<Bytes>.append(&mut result, run Bytes.copy(span(bytes, self.namesAt + index * NAME_ENTRY)))
      index = index + 1
    }
    return move result
  }

  effect fn version(self: &mut Self) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    return run Bytes.copy(self.release())
  }
}

impl TimeZones for ZoneBundle {
  zoneBytes: ZoneBundle.zoneBytes
  names: ZoneBundle.names
  version: ZoneBundle.version
}

// True if the offset and length that `bytes` holds at `at` name a range inside `bytes`.
fn inside(bytes: &[u8], at: usize) -> bool {
  let start = u32.toUsize(readU32BigEndian(bytes, at))
  let length = u32.toUsize(readU32BigEndian(bytes, at + 4))
  return start <= bytes.length && length <= bytes.length - start
}

// True if a table of `count` entries of `size` bytes at `at` is inside `bytes`.
fn tableInside(bytes: &[u8], at: usize, count: usize, size: usize) -> bool {
  return at <= bytes.length && count <= (bytes.length - at) / size
}

// The range that `bytes` names with the offset and length at `at`. `readTables` checked it.
fn span(bytes: &[u8], at: usize) -> &[u8] {
  return Slice.view<u8>(
    bytes,
    u32.toUsize(readU32BigEndian(bytes, at)),
    u32.toUsize(readU32BigEndian(bytes, at + 4)),
  )
}

fn lower(byte: u8) -> u8 {
  if byte >= 65 && byte <= 90 {
    return byte + 32
  }
  return byte
}

fn sameText(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut index = usize.ZERO
  while index < left.length {
    if lower(left[index]) != lower(right[index]) {
      return false
    }
    index = index + 1
  }
  return true
}
