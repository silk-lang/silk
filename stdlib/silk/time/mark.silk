//! Readings of a monotonic clock: the [`Mark`] type.
//!
//! # When to use
//!
//! Use a [`Mark`] to measure how long something takes and to hold a deadline. A mark comes from a
//! clock that never goes back, such as `silk.system.monotonic_clock`. For a date and time that
//! you show, store, or send, use `silk.time.instant`.
//!
//! # Details
//!
//! A mark is a point on the timeline of one clock. The origin of that timeline is not specified,
//! so a mark has no date. It has a meaning only next to another mark of the same clock: the later
//! one minus the earlier one is the [`Duration`](silk.time.duration.Duration) between them, and a
//! mark plus a span is a deadline. Marks are ordered, so `&now >= &deadline` tests a deadline.
//!
//! # Gotchas
//!
//! The compiler cannot stop a program from comparing marks of two different clocks. The result of
//! such a comparison has no meaning.
//!
//! # Examples
//!
//! ## Compute a deadline and the time left
//!
//! ```silk
//! import silk.time.duration { Duration }
//! import silk.time.mark { Mark }
//!
//! pub fn main() -> i32 {
//!   // A test clock can make marks from plain numbers. A real clock returns them from `now`.
//!   let start = Mark.make(100, 0)
//!   let deadline = start + Duration.fromMilliseconds(1500)
//!   let now = Mark.make(101, 0)
//!   if &now >= &deadline {
//!     return 1
//!   }
//!   if &(deadline - now) != &Duration.fromMilliseconds(500) {
//!     return 2
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Time
import silk.core.equal { Equal }
import silk.core.ops { Add, Subtract }
import silk.core.option { Option }
import silk.core.order { Order, Ordering }
import silk.core.ownership { Copy }
import silk.io.writer { Writer, WriterError }
import silk.text.format { Debug, Format, Formatter }
import silk.time.duration { Duration }

/// A reading of a monotonic clock, with nanosecond precision.
///
/// # Details
///
/// A mark is the time since the origin of its clock, which is not specified and can be before or
/// after the start of the program. `==`, `!=`, `<`, `<=`, `>`, and `>=` compare marks.
/// `mark + span` and `mark - span` return a mark, and `later - earlier` returns the span between
/// two marks. They trap when the result is outside the range, which is the range of a
/// [`Duration`](silk.time.duration.Duration).
pub struct Mark {
  elapsed: Duration,
}

impl Copy for Mark {}

impl Mark {
  /// Returns the mark `seconds` seconds plus `nanoseconds` nanoseconds after the origin of a clock.
  ///
  /// # When to use
  ///
  /// A clock provider calls it to build the marks that it returns, and a test calls it for fixed
  /// marks. Other code gets marks from a clock.
  ///
  /// # Details
  ///
  /// Whole seconds in `nanoseconds` move into the seconds, and both parts can be negative. A total
  /// outside the `i64` seconds range traps.
  pub fn make(seconds: i64, nanoseconds: i64) -> Mark {
    return Mark { elapsed: Duration.make(seconds, nanoseconds) }
  }

  /// Returns the mark at the origin of a clock.
  pub fn origin() -> Mark {
    return Mark { elapsed: Duration.zero() }
  }

  /// Returns the time from the origin of the clock to this mark.
  pub fn sinceOrigin(self: Self) -> Duration {
    return self.elapsed
  }

  /// Returns the whole seconds from the origin of the clock, rounded toward negative infinity.
  pub fn seconds(self: Self) -> i64 {
    return self.elapsed.wholeSeconds()
  }

  /// Returns the nanosecond part, from 0 to 999,999,999.
  pub fn subsecondNanoseconds(self: Self) -> u32 {
    return self.elapsed.subsecondNanoseconds()
  }

  /// Returns the mark `span` later, or earlier for a negative span, or `None` when it is outside
  /// the range.
  pub fn checkedAdd(self: Self, span: Duration) -> Option<Mark> {
    match self.elapsed.checkedAdd(span) {
      Option<Duration>.Some { value } => {
        return Option<Mark>.some(Mark { elapsed: value })
      }
      Option<Duration>.None => {
        return Option<Mark>.none()
      }
    }
  }

  /// Returns the mark `span` earlier, or later for a negative span, or `None` when it is outside
  /// the range.
  pub fn checkedSubtract(self: Self, span: Duration) -> Option<Mark> {
    match self.elapsed.checkedSubtract(span) {
      Option<Duration>.Some { value } => {
        return Option<Mark>.some(Mark { elapsed: value })
      }
      Option<Duration>.None => {
        return Option<Mark>.none()
      }
    }
  }

  /// Returns the span from `earlier` to this mark. It is negative when `earlier` is later.
  ///
  /// # Gotchas
  ///
  /// Both marks must come from the same clock. A span outside the `Duration` range traps.
  pub fn since(self: Self, earlier: Mark) -> Duration {
    return self.elapsed - earlier.elapsed
  }

  /// Returns the span from this mark to `later`. It is negative when `later` is earlier.
  ///
  /// # Gotchas
  ///
  /// Both marks must come from the same clock. A span outside the `Duration` range traps.
  pub fn until(self: Self, later: Mark) -> Duration {
    return later.elapsed - self.elapsed
  }

  fn same(left: &Mark, right: &Mark) -> bool {
    return &left.elapsed == &right.elapsed
  }

  fn compare(left: &Mark, right: &Mark) -> Ordering {
    return Order.compare(&left.elapsed, &right.elapsed)
  }

  fn addOperator(left: Mark, right: Duration) -> Mark {
    return Mark { elapsed: left.elapsed + right }
  }

  fn subtractOperator(left: Mark, right: Duration) -> Mark {
    return Mark { elapsed: left.elapsed - right }
  }

  fn differenceOperator(left: Mark, right: Mark) -> Duration {
    return left.elapsed - right.elapsed
  }
}

impl Equal for Mark {
  equals: Mark.same
}

impl Order for Mark {
  compare: Mark.compare
}

impl Add<Duration, Mark> for Mark {
  add: Mark.addOperator
}

impl Subtract<Duration, Mark> for Mark {
  subtract: Mark.subtractOperator
}

impl Subtract<Mark, Duration> for Mark {
  subtract: Mark.differenceOperator
}

/// Writes the mark as `Mark { elapsed: ... }` with the ISO 8601 text of the span.
impl Debug for Mark {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return run Format.debugFields(self, "Mark", &mut formatter)
  }
}
