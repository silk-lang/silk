//! Writes and reads dates and times with `strftime` patterns, such as `%Y-%m-%d %H:%M:%S %z`.
//!
//! # When to use
//!
//! Use [`TimePattern`] for a date format that is not ISO 8601: a log line, a file name, a date
//! in a form that a person typed, or the format of another program. For ISO 8601 text, the
//! `parse` and `Display` of the time types are shorter and faster.
//!
//! # Details
//!
//! A pattern is literal text and directives. A directive is `%`, optional flags, an optional
//! width, and one letter.
//!
//! | Directive | Meaning | Example |
//! | --- | --- | --- |
//! | `%Y` | Year, four digits or more | `2026` |
//! | `%C` | Century, the year divided by 100 | `20` |
//! | `%y` | Year in the century, 00 to 99 | `26` |
//! | `%m` | Month, 01 to 12 | `11` |
//! | `%B`, `%b`, `%h` | English month name, full or three letters | `November`, `Nov` |
//! | `%d` | Day of the month, 01 to 31 | `09` |
//! | `%e` | Day of the month, padded with a space | ` 9` |
//! | `%j` | Day of the year, 001 to 366 | `323` |
//! | `%A`, `%a` | English weekday name, full or three letters | `Thursday`, `Thu` |
//! | `%u` | Weekday, 1 for Monday to 7 for Sunday | `4` |
//! | `%w` | Weekday, 0 for Sunday to 6 for Saturday | `4` |
//! | `%G`, `%g` | Year of the ISO 8601 week, whole or two digits | `2026`, `26` |
//! | `%V` | ISO 8601 week, 01 to 53 | `47` |
//! | `%U` | Week of the year with Sunday first, 00 to 53 | `46` |
//! | `%W` | Week of the year with Monday first, 00 to 53 | `46` |
//! | `%H` | Hour, 00 to 23 | `18` |
//! | `%k` | Hour, 0 to 23, padded with a space | `18` |
//! | `%I` | Hour of the 12-hour clock, 01 to 12 | `06` |
//! | `%l` | Hour of the 12-hour clock, padded with a space | ` 6` |
//! | `%p`, `%P` | `AM` or `PM`, and `am` or `pm` | `PM`, `pm` |
//! | `%M` | Minute, 00 to 59 | `36` |
//! | `%S` | Second, 00 to 59 | `22` |
//! | `%f` | Fraction of a second, without zeros at the end | `5` |
//! | `%N` | Fraction of a second, nine digits | `500000000` |
//! | `%z` | UTC offset; `%:z` has a colon, `%::z` has seconds | `+0100`, `+01:00` |
//! | `%Z` | Abbreviation of the time zone. It cannot be read. | `CET` |
//! | `%s` | Seconds from the Unix epoch | `1795109782` |
//! | `%F` | `%Y-%m-%d` | `2026-11-19` |
//! | `%T`, `%X` | `%H:%M:%S` | `18:36:22` |
//! | `%R` | `%H:%M` | `18:36` |
//! | `%D`, `%x` | `%m/%d/%y` | `11/19/26` |
//! | `%r` | `%I:%M:%S %p` | `06:36:22 PM` |
//! | `%c` | `%a %b %e %H:%M:%S %Y` | `Thu Nov 19 18:36:22 2026` |
//! | `%n`, `%t`, `%%` | A line feed, a tab, and `%` | |
//!
//! The flags are `-` for no padding, `_` for padding with spaces, `0` for padding with zeros, and
//! `^` for upper case. A width, such as the `3` of `%3f`, sets the least number of characters,
//! and for `%f` and `%N` the exact number of digits. `%.f` writes a point and the fraction, and
//! nothing for a whole second.
//!
//! A pattern that is a constant is checked when the program is compiled: an unknown directive, or
//! a directive that the value cannot supply, such as `%H` for a `PlainDate`, is a compile error.
//! The functions with `Dynamic` in the name take a pattern that is known only at run time and
//! report the same problems as a [`PatternError`].
//!
//! A year before 0 has a minus sign before its digits, as in `-0044`, and a width counts the
//! sign.
//!
//! Reading is lenient about digits and space: a number can have fewer digits than its width,
//! white space in the pattern matches any amount of white space, a directive that is padded
//! with spaces (`%e`, `%k`, `%l`, or the flag `_`) can have spaces before it, and names match in
//! any case, in the full or the short form. A year can have a sign, and then up to six digits.
//! `%z` reads `Z`, `+01`, `+0100`, `+01:00`, and the forms with seconds. The text must end where
//! the pattern ends.
//!
//! A date is read from a year with a month and a day, a day of the year, or a week and a weekday.
//! A two-digit year without a century is from 1969 to 2068. A time of day needs an hour; the
//! minute and the second are 0 if the pattern has none.
//!
//! # Gotchas
//!
//! The names are English only. Names in other languages belong to a locale library.
//!
//! # Examples
//!
//! ## Read a date and write it in another form
//!
//! ```silk
//! import silk.core.effect { Effect }
//! import silk.core.result { Result }
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.text.string { String }
//! import silk.time.pattern { TimePattern }
//! import silk.time.plain_date { PlainDate }
//! import silk.time.text { TimeParseError }
//!
//! effect fn long(text: string) -> String ! OutOfMemoryError ? &mut Allocator {
//!   return match TimePattern.parse<PlainDate>("%d/%m/%Y", text) {
//!     Result<PlainDate, TimeParseError>.Success { value } => run TimePattern.format("%A, %B %-d, %Y", &value)
//!     Result<PlainDate, TimeParseError>.Failure {..} => run String.copy("not a date")
//!   }
//! }
//!
//! pub effect fn main() -> i32 ! OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let written = run long("19/11/2026") |> Effect.provideMut<Allocator>(&mut allocator)
//!   return if written.view() == "Thursday, November 19, 2026" { 0 } else { 1 }
//! }
//! ```
//!
//! @category Time
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.core.static_sequence { StaticSequence }
import silk.core.static_text { StaticText }
import silk.io.writer { Writer, WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.i32
import silk.num.i64
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.u8
import silk.num.usize
import silk.text.format { Debug, Format, Formatter }
import silk.text.string { String }
import silk.time.civil as Civil
import silk.time.instant { Instant }
import silk.time.offset { UtcOffset }
import silk.time.plain_date { PlainDate, Weekday }
import silk.time.plain_date_time { PlainDateTime }
import silk.time.plain_time { PlainTime }
import silk.time.text { TimeParseError, TimeParseReason }
import silk.time.zoned { ZonedDateTime }

// The longest width of a directive, and the room one directive needs.
const WIDEST: usize = 64
const ROOM: usize = 96

// Problems of a directive, as `checkSpec` and `unresolved` return them. 0 is no problem.
const UNKNOWN: u8 = 1
const UNFINISHED: u8 = 2
const MODIFIER: u8 = 3
const TOO_WIDE: u8 = 4
const NO_DATE: u8 = 5
const NO_TIME: u8 = 6
const NO_OFFSET: u8 = 7

// What a parsed text holds, as bits of `ParsedFields.set`.
const SET_YEAR: u32 = 1
const SET_CENTURY: u32 = 2
const SET_SHORT_YEAR: u32 = 4
const SET_MONTH: u32 = 8
const SET_DAY: u32 = 16
const SET_ORDINAL: u32 = 32
const SET_WEEK_YEAR: u32 = 64
const SET_SHORT_WEEK_YEAR: u32 = 128
const SET_ISO_WEEK: u32 = 256
const SET_SUNDAY_WEEK: u32 = 512
const SET_MONDAY_WEEK: u32 = 1024
const SET_WEEKDAY: u32 = 2048
const SET_HOUR: u32 = 4096
const SET_HOUR12: u32 = 8192
const SET_HALF: u32 = 16384
const SET_MINUTE: u32 = 32768
const SET_SECOND: u32 = 65536
const SET_FRACTION: u32 = 131072
const SET_OFFSET: u32 = 262144
const SET_UNIX: u32 = 524288

/// The cause of a [`PatternError`].
pub enum PatternReason {
  /// The letter after `%` is not a directive.
  UnknownDirective,
  /// The pattern ends after `%`, a flag, or a width.
  UnfinishedDirective,
  /// A `:` is before a directive other than `%z`, or a `.` is before a directive other than `%f`
  /// and `%N`.
  InvalidModifier,
  /// A width is above 64.
  WidthTooLarge,
  /// The directive needs a part that the value does not have, such as `%H` for a `PlainDate`.
  NotAvailable,
  /// The directive is `%Z`, which can be written and cannot be read.
  NotReadable,
  /// The pattern does not give a date, and the type needs one.
  MissingDate,
  /// The pattern does not give a time of day, and the type needs one.
  MissingTime,
  /// The pattern does not give a UTC offset, and the type needs one.
  MissingOffset,
}

impl Debug for PatternReason {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return match &self.* {
      PatternReason.UnknownDirective => run Format.write(&mut formatter, b"UnknownDirective")
      PatternReason.UnfinishedDirective => run Format.write(&mut formatter, b"UnfinishedDirective")
      PatternReason.InvalidModifier => run Format.write(&mut formatter, b"InvalidModifier")
      PatternReason.WidthTooLarge => run Format.write(&mut formatter, b"WidthTooLarge")
      PatternReason.NotAvailable => run Format.write(&mut formatter, b"NotAvailable")
      PatternReason.NotReadable => run Format.write(&mut formatter, b"NotReadable")
      PatternReason.MissingDate => run Format.write(&mut formatter, b"MissingDate")
      PatternReason.MissingTime => run Format.write(&mut formatter, b"MissingTime")
      PatternReason.MissingOffset => run Format.write(&mut formatter, b"MissingOffset")
    }
  }
}

/// The error of a pattern that is known only at run time: why the pattern cannot be used and
/// where.
pub struct PatternError {
  /// The cause.
  pub reason: PatternReason,
  /// The byte offset of the directive in the pattern. For a missing part it is the length of the
  /// pattern.
  pub offset: usize,
}

impl Copy for PatternError {}

impl Debug for PatternError {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return run Format.debugFields(self, "PatternError", &mut formatter)
  }
}

/// The parts of a value that directives can write.
pub struct PatternParts {
  /// The value has a date.
  pub date: bool,
  /// The value has a time of day.
  pub time: bool,
  /// The value has a UTC offset.
  pub offset: bool,
  /// The value has a time zone abbreviation.
  pub zone: bool,
}

impl Copy for PatternParts {}

/// What a type needs from a pattern to be read from text.
pub enum PatternKind {
  /// A date.
  Date,
  /// A time of day.
  Time,
  /// A date. The time of day is midnight if the pattern has none.
  DateTime,
  /// A date, a time of day and a UTC offset, or the seconds from the Unix epoch.
  Instant,
}

/// The fields of a date and time that directives write.
///
/// # When to use
///
/// Return it from [`PatternSource.fields`] to make a type of your own writable with a pattern.
/// Fields that the type does not have can hold any value, because the directives that read them
/// are refused for the type.
pub struct TimeFields {
  /// The year.
  pub year: i32,
  /// The month, 1 to 12.
  pub month: u8,
  /// The day of the month, 1 to 31.
  pub day: u8,
  /// The hour, 0 to 23.
  pub hour: u8,
  /// The minute, 0 to 59.
  pub minute: u8,
  /// The second, 0 to 59.
  pub second: u8,
  /// The nanoseconds in the second.
  pub nanosecond: u32,
  /// The UTC offset in seconds.
  pub offsetSeconds: i32,
  /// The time zone abbreviation, in the first `abbreviationLength` bytes.
  pub abbreviation: [u8; 12],
  /// The length of the abbreviation.
  pub abbreviationLength: usize,
}

impl Copy for TimeFields {}

impl TimeFields {
  /// Returns the fields of `date` at midnight UTC.
  pub fn ofDate(date: PlainDate) -> TimeFields {
    return TimeFields {
      year: date.year(), month: date.month(), day: date.day(),
      hour: 0, minute: 0, second: 0, nanosecond: 0,
      offsetSeconds: 0, abbreviation: [0; 12], abbreviationLength: 0,
    }
  }

  /// Returns the fields with the time of day `time`.
  pub fn withTime(self: Self, time: PlainTime) -> TimeFields {
    return TimeFields {
      year: self.year, month: self.month, day: self.day,
      hour: time.hour(), minute: time.minute(), second: time.second(),
      nanosecond: time.subsecondNanoseconds(),
      offsetSeconds: self.offsetSeconds, abbreviation: self.abbreviation,
      abbreviationLength: self.abbreviationLength,
    }
  }

  /// Returns the fields with the UTC offset `offset` and the time zone abbreviation `name`, of
  /// which the first 12 bytes are kept.
  pub fn withZone(self: Self, offset: UtcOffset, name: string) -> TimeFields {
    let bytes = String.utf8Bytes(name)
    let mut kept: [u8; 12] = [0; 12]
    let mut length: usize = 0
    while length < bytes.length && length < 12 {
      kept[length] = bytes[length]
      length = length + 1
    }
    return TimeFields {
      year: self.year, month: self.month, day: self.day,
      hour: self.hour, minute: self.minute, second: self.second, nanosecond: self.nanosecond,
      offsetSeconds: offset.totalSeconds(), abbreviation: kept, abbreviationLength: length,
    }
  }
}

/// A value that a pattern can write.
///
/// # Details
///
/// It is implemented for `PlainDate`, `PlainTime`, `PlainDateTime`, `Instant`, which is written
/// in UTC, and `ZonedDateTime`.
pub interface PatternSource {
  /// Returns the parts that the type has. A directive that needs another part is refused.
  static fn parts() -> PatternParts

  /// Returns the fields of the value.
  fn fields(self: &Self) -> TimeFields
}

impl PatternSource for PlainDate {
  /// A date only.
  static fn parts() -> PatternParts {
    return PatternParts { date: true, time: false, offset: false, zone: false }
  }

  /// Returns the date at midnight.
  fn fields(self: &Self) -> TimeFields {
    return TimeFields.ofDate(self.*)
  }
}

impl PatternSource for PlainTime {
  /// A time of day only.
  static fn parts() -> PatternParts {
    return PatternParts { date: false, time: true, offset: false, zone: false }
  }

  /// Returns the time of day.
  fn fields(self: &Self) -> TimeFields {
    return TimeFields.ofDate(PlainDate.make(1970, 1, 1)).withTime(self.*)
  }
}

impl PatternSource for PlainDateTime {
  /// A date and a time of day.
  static fn parts() -> PatternParts {
    return PatternParts { date: true, time: true, offset: false, zone: false }
  }

  /// Returns the date and the time of day.
  fn fields(self: &Self) -> TimeFields {
    return TimeFields.ofDate(self.date()).withTime(self.time())
  }
}

impl PatternSource for Instant {
  /// Every part: the date and time in UTC, the offset zero and the abbreviation `UTC`.
  static fn parts() -> PatternParts {
    return PatternParts { date: true, time: true, offset: true, zone: true }
  }

  /// Returns the date and time in UTC.
  fn fields(self: &Self) -> TimeFields {
    let reading = self.toUtc()
    return TimeFields.ofDate(reading.date()).withTime(reading.time()).withZone(UtcOffset.utc(), "UTC")
  }
}

impl<'z> PatternSource for ZonedDateTime<'z> {
  /// Every part.
  static fn parts() -> PatternParts {
    return PatternParts { date: true, time: true, offset: true, zone: true }
  }

  /// Returns the local date and time, the offset and the abbreviation of the zone.
  fn fields(self: &Self) -> TimeFields {
    return TimeFields.ofDate(self.date()).withTime(self.time()).withZone(self.offset(), self.abbreviation())
  }
}

/// A type that a pattern can read.
///
/// # Details
///
/// It is implemented for `PlainDate`, `PlainTime`, `PlainDateTime` and `Instant`. To read a
/// `ZonedDateTime`, read a `PlainDateTime` and give it a zone with `ZonedDateTime.fromLocal`.
pub interface PatternTarget {
  /// Returns what the type needs from a pattern.
  static fn kind() -> PatternKind

  /// Returns the value that the fields name.
  ///
  /// # Errors
  ///
  /// - `TimeParseError` if a part is missing or names no real value.
  fn resolve(parsed: &ParsedFields) -> Result<Self, TimeParseError>
}

impl PatternTarget for PlainDate {
  /// A date.
  static fn kind() -> PatternKind {
    return PatternKind.Date
  }

  /// Returns the date.
  fn resolve(parsed: &ParsedFields) -> Result<PlainDate, TimeParseError> {
    return parsed.date()
  }
}

impl PatternTarget for PlainTime {
  /// A time of day.
  static fn kind() -> PatternKind {
    return PatternKind.Time
  }

  /// Returns the time of day.
  fn resolve(parsed: &ParsedFields) -> Result<PlainTime, TimeParseError> {
    return parsed.time()
  }
}

impl PatternTarget for PlainDateTime {
  /// A date, with a time of day if the pattern has one.
  static fn kind() -> PatternKind {
    return PatternKind.DateTime
  }

  /// Returns the date and time.
  fn resolve(parsed: &ParsedFields) -> Result<PlainDateTime, TimeParseError> {
    return parsed.dateTime()
  }
}

impl PatternTarget for Instant {
  /// A date, a time of day and an offset, or the seconds from the Unix epoch.
  static fn kind() -> PatternKind {
    return PatternKind.Instant
  }

  /// Returns the instant.
  fn resolve(parsed: &ParsedFields) -> Result<Instant, TimeParseError> {
    return parsed.instant()
  }
}

/// What a pattern read from a text, before it becomes a value.
///
/// # When to use
///
/// Get it from [`TimePattern.parseFields`] to read a text that has more than one value, such as a
/// local date and time with its offset, or to accept a text that can leave parts out.
pub struct ParsedFields {
  set: u32,
  year: i32,
  century: i32,
  shortYear: i32,
  month: u8,
  day: u8,
  ordinal: u16,
  weekYear: i32,
  week: u8,
  dayOfWeek: u8,
  hour: u8,
  half: u8,
  minute: u8,
  second: u8,
  nanosecond: u32,
  offsetSeconds: i32,
  unix: i64,
  length: usize,
}

impl Copy for ParsedFields {}

fn failed<T>(reason: TimeParseReason, offset: usize) -> Result<T, TimeParseError> {
  return Result<T, TimeParseError>.failResult(TimeParseError { reason: reason, offset: offset })
}

impl ParsedFields {
  fn has(self: &Self, bits: u32) -> bool {
    return (self.set & bits) == bits
  }

  fn fromUnix(self: &Self) -> Option<PlainDateTime> {
    return match Instant.checkedMake(self.unix, u32.toI64(self.nanosecond)) {
      Option<Instant>.Some { value } => Option<PlainDateTime>.some(value.toUtc())
      Option<Instant>.None => Option<PlainDateTime>.none()
    }
  }

  // The calendar year, from `%Y`, or `%C` and `%y`, or `%y` alone.
  fn calendarYear(self: &Self) -> i32 {
    if self.has(SET_YEAR) { return self.year }
    if self.has(SET_CENTURY) { return self.century * 100 + self.shortYear }
    if self.shortYear < 69 { return 2000 + self.shortYear }
    return 1900 + self.shortYear
  }

  /// Returns the weekday that the text names, or `None` if the pattern has no weekday.
  pub fn weekday(self: &Self) -> Option<Weekday> {
    if !self.has(SET_WEEKDAY) { return Option<Weekday>.none() }
    return Weekday.fromNumber(self.dayOfWeek)
  }

  /// Returns the UTC offset that the text names, or `None` if the pattern has no `%z`.
  pub fn offset(self: &Self) -> Option<UtcOffset> {
    if !self.has(SET_OFFSET) { return Option<UtcOffset>.none() }
    return UtcOffset.checkedFromSeconds(self.offsetSeconds)
  }

  /// Returns the date that the text names.
  ///
  /// # Details
  ///
  /// The date is the year with the month and the day, or with the day of the year, or with a
  /// week of `%U` or `%W` and a weekday, or the ISO 8601 week year with `%V` and a weekday. A
  /// text with only `%s` gives the date in UTC.
  ///
  /// # Errors
  ///
  /// - `TimeParseReason.MissingDate` if the pattern does not give a date.
  /// - `TimeParseReason.OutOfRange` if the date does not exist, or a weekday in the text is not
  ///   the weekday of the date.
  pub fn date(self: &Self) -> Result<PlainDate, TimeParseError> {
    if unresolved(PatternKind.Date, self.set) != 0 {
      return failed<PlainDate>(TimeParseReason.MissingDate, self.length)
    }
    let mut found = Option<PlainDate>.none()
    let hasYear = self.has(SET_YEAR) || self.has(SET_SHORT_YEAR)
    if hasYear && self.has(SET_MONTH | SET_DAY) {
      found = PlainDate.checkedMake(self.calendarYear(), self.month, self.day)
    } else if hasYear && self.has(SET_ORDINAL) {
      let year = self.calendarYear()
      if self.ordinal >= 1 && self.ordinal <= Civil.daysInYear(year) {
        found = PlainDate.fromEpochDays(Civil.daysFromCivil(year, 1, 1) + u16.toI64(self.ordinal) - 1)
      }
    } else if self.has(SET_ISO_WEEK | SET_WEEKDAY) && (self.has(SET_WEEK_YEAR) || self.has(SET_SHORT_WEEK_YEAR)) {
      let mut year = self.weekYear
      if !self.has(SET_WEEK_YEAR) {
        year = if self.weekYear < 69 { 2000 + self.weekYear } else { 1900 + self.weekYear }
      }
      // January 4 is always in week 1.
      let fourth = Civil.daysFromCivil(year, 1, 4)
      let monday = fourth - (u8.toI64(Civil.weekdayFromDays(fourth)) - 1)
      let days = monday + (u8.toI64(self.week) - 1) * 7 + u8.toI64(self.dayOfWeek) - 1
      match PlainDate.fromEpochDays(days) {
        Option<PlainDate>.Some { value } => {
          if self.week >= 1 && value.yearOfWeek() == year { found = Option<PlainDate>.some(value) }
        }
        Option<PlainDate>.None => {}
      }
    } else if hasYear && self.has(SET_WEEKDAY) && (self.has(SET_SUNDAY_WEEK) || self.has(SET_MONDAY_WEEK)) {
      let year = self.calendarYear()
      let first = Civil.daysFromCivil(year, 1, 1)
      // The day of the week of January 1 and of the wanted day, counted from the first day of
      // the week: Sunday for `%U`, Monday for `%W`.
      let mut firstIndex = u8.toI64(Civil.weekdayFromDays(first)) - 1
      let mut wanted = u8.toI64(self.dayOfWeek) - 1
      if self.has(SET_SUNDAY_WEEK) {
        firstIndex = (firstIndex + 1) % 7
        wanted = (wanted + 1) % 7
      }
      // Week 1 starts on the first such day of the year; the days before it are week 0.
      let weekOne = first + (7 - firstIndex) % 7
      let days = weekOne + (u8.toI64(self.week) - 1) * 7 + wanted
      match PlainDate.fromEpochDays(days) {
        Option<PlainDate>.Some { value } => {
          if value.year() == year { found = Option<PlainDate>.some(value) }
        }
        Option<PlainDate>.None => {}
      }
    } else {
      match self.fromUnix() {
        Option<PlainDateTime>.Some { value } => { found = Option<PlainDate>.some(value.date()) }
        Option<PlainDateTime>.None => {}
      }
    }
    match found {
      Option<PlainDate>.Some { value } => {
        if self.has(SET_WEEKDAY) && value.weekday().number() != self.dayOfWeek {
          return failed<PlainDate>(TimeParseReason.OutOfRange, self.length)
        }
        return Result<PlainDate, TimeParseError>.succeed(value)
      }
      Option<PlainDate>.None => {
        return failed<PlainDate>(TimeParseReason.OutOfRange, self.length)
      }
    }
  }

  /// Returns the time of day that the text names.
  ///
  /// # Details
  ///
  /// The hour is `%H`, or `%I` with `%p`; `%I` without `%p` is before noon. The minute, the
  /// second and the fraction are 0 if the pattern has none. A text with only `%s` gives the time
  /// in UTC.
  ///
  /// # Errors
  ///
  /// - `TimeParseReason.MissingTime` if the pattern does not give an hour.
  /// - `TimeParseReason.OutOfRange` if the time does not exist, such as hour 24 or second 60.
  pub fn time(self: &Self) -> Result<PlainTime, TimeParseError> {
    if unresolved(PatternKind.Time, self.set) != 0 {
      return failed<PlainTime>(TimeParseReason.MissingTime, self.length)
    }
    let mut hour = self.hour
    if !self.has(SET_HOUR) {
      if !self.has(SET_HOUR12) {
        return match self.fromUnix() {
          Option<PlainDateTime>.Some { value } => Result<PlainTime, TimeParseError>.succeed(value.time())
          Option<PlainDateTime>.None => failed<PlainTime>(TimeParseReason.OutOfRange, self.length)
        }
      }
      if self.hour < 1 || self.hour > 12 {
        return failed<PlainTime>(TimeParseReason.OutOfRange, self.length)
      }
      hour = self.hour % 12
      if self.has(SET_HALF) && self.half == 1 { hour = hour + 12 }
    }
    return match PlainTime.checkedMake(hour, self.minute, self.second, self.nanosecond) {
      Option<PlainTime>.Some { value } => Result<PlainTime, TimeParseError>.succeed(value)
      Option<PlainTime>.None => failed<PlainTime>(TimeParseReason.OutOfRange, self.length)
    }
  }

  /// Returns the date and time that the text names. The time is midnight if the pattern has no
  /// time of day.
  ///
  /// # Errors
  ///
  /// - `TimeParseReason.MissingDate` if the pattern does not give a date.
  /// - `TimeParseReason.OutOfRange` if the date or the time does not exist.
  pub fn dateTime(self: &Self) -> Result<PlainDateTime, TimeParseError> {
    let date = match self.date() {
      Result<PlainDate, TimeParseError>.Success { value } => value
      Result<PlainDate, TimeParseError>.Failure { error } => {
        return Result<PlainDateTime, TimeParseError>.failResult(error)
      }
    }
    if unresolved(PatternKind.Time, self.set) != 0 {
      return Result<PlainDateTime, TimeParseError>.succeed(PlainDateTime.make(date, PlainTime.midnight()))
    }
    return match self.time() {
      Result<PlainTime, TimeParseError>.Success { value } => Result<PlainDateTime, TimeParseError>.succeed(
        PlainDateTime.make(date, value),
      )
      Result<PlainTime, TimeParseError>.Failure { error } => Result<PlainDateTime, TimeParseError>.failResult(error)
    }
  }

  /// Returns the instant that the text names: the seconds of `%s`, or the date and time at the
  /// offset of `%z`.
  ///
  /// # Errors
  ///
  /// - `TimeParseReason.MissingDate`, `MissingTime` or `MissingOffset` if the pattern does not
  ///   give that part and has no `%s`.
  /// - `TimeParseReason.OutOfRange` if the date or the time does not exist, or the instant is
  ///   outside the range of `Instant`.
  pub fn instant(self: &Self) -> Result<Instant, TimeParseError> {
    if self.has(SET_UNIX) {
      return match Instant.checkedMake(self.unix, u32.toI64(self.nanosecond)) {
        Option<Instant>.Some { value } => Result<Instant, TimeParseError>.succeed(value)
        Option<Instant>.None => failed<Instant>(TimeParseReason.OutOfRange, self.length)
      }
    }
    let missing = unresolved(PatternKind.Instant, self.set)
    if missing == NO_DATE { return failed<Instant>(TimeParseReason.MissingDate, self.length) }
    if missing == NO_TIME { return failed<Instant>(TimeParseReason.MissingTime, self.length) }
    if missing == NO_OFFSET { return failed<Instant>(TimeParseReason.MissingOffset, self.length) }
    let local = match self.dateTime() {
      Result<PlainDateTime, TimeParseError>.Success { value } => value
      Result<PlainDateTime, TimeParseError>.Failure { error } => {
        return Result<Instant, TimeParseError>.failResult(error)
      }
    }
    let seconds = local.toEpochSeconds() - i32.toI64(self.offsetSeconds)
    return match Instant.checkedMake(seconds, u32.toI64(self.nanosecond)) {
      Option<Instant>.Some { value } => Result<Instant, TimeParseError>.succeed(value)
      Option<Instant>.None => failed<Instant>(TimeParseReason.OutOfRange, self.length)
    }
  }
}

// Returns the part that a pattern with the fields `set` does not give to a type of `kind`, or 0.
fn unresolved(kind: PatternKind, set: u32) -> u8 {
  let unix = (set & SET_UNIX) != 0
  let year = (set & (SET_YEAR | SET_SHORT_YEAR)) != 0
  let weekday = (set & SET_WEEKDAY) != 0
  let monthDay = (set & (SET_MONTH | SET_DAY)) == (SET_MONTH | SET_DAY)
  let weeks = weekday && (set & (SET_SUNDAY_WEEK | SET_MONDAY_WEEK)) != 0
  let isoWeeks = weekday && (set & SET_ISO_WEEK) != 0 && (set & (SET_WEEK_YEAR | SET_SHORT_WEEK_YEAR)) != 0
  let date = unix || isoWeeks || (year && (monthDay || (set & SET_ORDINAL) != 0 || weeks))
  let time = unix || (set & (SET_HOUR | SET_HOUR12)) != 0
  return match kind {
    PatternKind.Date => if date { 0 } else { NO_DATE }
    PatternKind.Time => if time { 0 } else { NO_TIME }
    PatternKind.DateTime => if date { 0 } else { NO_DATE }
    PatternKind.Instant => {
      if unix { return 0 }
      if !date { return NO_DATE }
      if !time { return NO_TIME }
      if (set & SET_OFFSET) == 0 { return NO_OFFSET }
      return 0
    }
  }
}

// Returns the fields that the directive `letter` sets when it is read.
fn setBy(letter: u8) -> u32 {
  return match letter {
    89 => SET_YEAR
    67 => SET_CENTURY
    121 => SET_SHORT_YEAR
    109 => SET_MONTH
    66 => SET_MONTH
    98 => SET_MONTH
    104 => SET_MONTH
    100 => SET_DAY
    101 => SET_DAY
    106 => SET_ORDINAL
    71 => SET_WEEK_YEAR
    103 => SET_SHORT_WEEK_YEAR
    86 => SET_ISO_WEEK
    85 => SET_SUNDAY_WEEK
    87 => SET_MONDAY_WEEK
    65 => SET_WEEKDAY
    97 => SET_WEEKDAY
    117 => SET_WEEKDAY
    119 => SET_WEEKDAY
    72 => SET_HOUR
    107 => SET_HOUR
    73 => SET_HOUR12
    108 => SET_HOUR12
    112 => SET_HALF
    80 => SET_HALF
    77 => SET_MINUTE
    83 => SET_SECOND
    102 => SET_FRACTION
    78 => SET_FRACTION
    122 => SET_OFFSET
    115 => SET_UNIX
    _ => 0
  }
}

// Returns the pattern that a directive stands for, or the empty text for a directive that is not
// a short form.
fn expansion(letter: u8) -> string<'static> {
  return match letter {
    70 => "%Y-%m-%d"
    68 => "%m/%d/%y"
    120 => "%m/%d/%y"
    84 => "%H:%M:%S"
    88 => "%H:%M:%S"
    82 => "%H:%M"
    114 => "%I:%M:%S %p"
    99 => "%a %b %e %H:%M:%S %Y"
    _ => ""
  }
}

fn isShort(letter: u8) -> bool {
  return letter == 70 || letter == 68 || letter == 120 || letter == 84 || letter == 88 || letter == 82 ||
    letter == 114 || letter == 99
}

// Returns which part of a value the directive `letter` needs: 1 a date, 2 a time of day, 4 an
// offset, 8 a zone abbreviation. 0 is a directive without a field, and 255 is no directive.
fn needs(letter: u8) -> u8 {
  return match letter {
    89 => 1
    67 => 1
    121 => 1
    109 => 1
    66 => 1
    98 => 1
    104 => 1
    100 => 1
    101 => 1
    106 => 1
    71 => 1
    103 => 1
    86 => 1
    85 => 1
    87 => 1
    65 => 1
    97 => 1
    117 => 1
    119 => 1
    72 => 2
    107 => 2
    73 => 2
    108 => 2
    112 => 2
    80 => 2
    77 => 2
    83 => 2
    102 => 2
    78 => 2
    122 => 4
    90 => 8
    115 => 7
    110 => 0
    116 => 0
    37 => 0
    _ => 255
  }
}

// Returns the problem of a directive, or 0.
fn checkSpec(letter: u8, width: usize, colons: u8, dot: bool) -> u8 {
  if needs(letter) == 255 && !isShort(letter) { return UNKNOWN }
  if colons > 0 && (letter != 122 || colons > 2) { return MODIFIER }
  if dot && letter != 102 && letter != 78 { return MODIFIER }
  if width > WIDEST { return TOO_WIDE }
  return 0
}

fn reasonOf(problem: u8) -> PatternReason {
  return match problem {
    1 => PatternReason.UnknownDirective
    2 => PatternReason.UnfinishedDirective
    3 => PatternReason.InvalidModifier
    4 => PatternReason.WidthTooLarge
    5 => PatternReason.MissingDate
    6 => PatternReason.MissingTime
    _ => PatternReason.MissingOffset
  }
}

fn available(parts: PatternParts, need: u8) -> bool {
  if (need & 1) != 0 && !parts.date { return false }
  if (need & 2) != 0 && !parts.time { return false }
  if (need & 4) != 0 && !parts.offset { return false }
  if (need & 8) != 0 && !parts.zone { return false }
  return true
}

// One directive of a pattern, or a run of literal text when `letter` is 0.
struct Step {
  literal: string<'static>,
  letter: u8,
  flag: u8,
  width: usize,
  colons: u8,
  dot: bool,
}

static fn problemText(problem: u8) -> string<'static> {
  if problem == UNKNOWN { return "is not a directive" }
  if problem == UNFINISHED { return "ends the pattern before its letter" }
  if problem == MODIFIER { return "has `:` or `.`, which only `%z`, `%f` and `%N` take" }
  return "has a width above 64"
}

// Splits a constant pattern into steps, with short forms such as `%F` written out, and reports a
// malformed directive as a compile error.
static fn steps(pattern: string<'static>) -> Intrinsic.StaticSequence<Step> {
  let mut found = StaticSequence.empty<Step>()
  let length = StaticText.byteLength(pattern)
  let mut at = usize.ZERO
  let mut literalStart = usize.ZERO
  while at < length {
    if StaticText.byteAt(pattern, at) != 37 {
      at = at + 1
    } else {
      if literalStart < at {
        found = Intrinsic.staticSequenceAppend<Step>(move found, Step {
          literal: StaticText.slice(pattern, literalStart, at), letter: 0, flag: 0, width: 0, colons: 0, dot: false,
        })
      }
      let start = at
      at = at + 1
      let mut flag: u8 = 0
      let mut width = usize.ZERO
      let mut colons: u8 = 0
      let mut dot = false
      let mut letter: u8 = 0
      while at < length && letter == 0 {
        let byte = StaticText.byteAt(pattern, at)
        if byte == 45 || byte == 95 || byte == 94 || (byte == 48 && width == 0) {
          flag = byte
        } else if byte >= 48 && byte <= 57 {
          if width <= WIDEST { width = width * 10 + u8.toUsize(byte - 48) }
        } else if byte == 58 {
          colons = colons + 1
        } else if byte == 46 {
          dot = true
        } else {
          letter = byte
        }
        at = at + 1
      }
      let mut problem = UNFINISHED
      if letter != 0 { problem = checkSpec(letter, width, colons, dot) }
      if problem != 0 {
        compileError(
          StaticText.concat(
            "the directive `",
            StaticText.concat(StaticText.slice(pattern, start, at), StaticText.concat("` ", problemText(problem)))
          )
        )
      }
      let short = expansion(letter)
      if StaticText.byteLength(short) != 0 {
        found = StaticSequence.concat<Step>(found, steps(short))
      } else {
        found = Intrinsic.staticSequenceAppend<Step>(move found, Step {
          literal: StaticText.slice(pattern, start, at), letter: letter, flag: flag, width: width, colons: colons, dot: dot,
        })
      }
      literalStart = at
    }
  }
  if literalStart < length {
    found = Intrinsic.staticSequenceAppend<Step>(move found, Step {
      literal: StaticText.slice(pattern, literalStart, length), letter: 0, flag: 0, width: 0, colons: 0, dot: false,
    })
  }
  return found
}

static fn lacking(parts: PatternParts, need: u8) -> string<'static> {
  if (need & 1) != 0 && !parts.date { return "` needs a date, and the value has none" }
  if (need & 2) != 0 && !parts.time { return "` needs a time of day, and the value has none" }
  if (need & 4) != 0 && !parts.offset { return "` needs a UTC offset, and the value has none" }
  return "` needs a time zone, and the value has none"
}

// The steps of a constant pattern that writes a `T`.
static fn writeSteps<T: PatternSource>(pattern: string<'static>) -> Intrinsic.StaticSequence<Step> {
  let found = steps(pattern)
  let parts: PatternParts = PatternSource.parts()
  let count = StaticSequence.length<Step>(found)
  let mut at = usize.ZERO
  while at < count {
    let step = StaticSequence.at<Step>(found, at)
    if step.letter != 0 && !available(parts, needs(step.letter)) {
      compileError(
        StaticText.concat("the directive `", StaticText.concat(step.literal, lacking(parts, needs(step.letter))))
      )
    }
    at = at + 1
  }
  return found
}

// The steps of a constant pattern that reads a value of `kind`.
static fn readSteps(pattern: string<'static>, kind: PatternKind, checked: bool) -> Intrinsic.StaticSequence<Step> {
  let found = steps(pattern)
  let count = StaticSequence.length<Step>(found)
  let mut set: u32 = 0
  let mut at = usize.ZERO
  while at < count {
    let step = StaticSequence.at<Step>(found, at)
    if step.letter == 90 {
      compileError("the directive `%Z` can be written and cannot be read")
    }
    set = set | setBy(step.letter)
    at = at + 1
  }
  if checked {
    let missing = unresolved(kind, set)
    if missing == NO_DATE {
      compileError("the pattern does not give a date: it needs a year with a month and a day, a day of the year, or a week and a weekday")
    }
    if missing == NO_TIME { compileError("the pattern does not give a time of day: it needs `%H`, or `%I`") }
    if missing == NO_OFFSET { compileError("the pattern does not give a UTC offset: it needs `%z`, or `%s`") }
  }
  return found
}

static fn kindOf<T: PatternTarget>() -> PatternKind {
  return PatternTarget.kind()
}

// One directive of a pattern that is read at run time.
struct Spec {
  letter: u8,
  flag: u8,
  width: usize,
  colons: u8,
  dot: bool,
  next: usize,
  problem: u8,
}

impl Copy for Spec {}

// Reads the directive whose `%` is at `pattern[at]`.
fn specAt(pattern: &[u8], at: usize) -> Spec {
  let mut index = at + 1
  let mut flag: u8 = 0
  let mut width = usize.ZERO
  let mut colons: u8 = 0
  let mut dot = false
  let mut letter: u8 = 0
  while index < pattern.length && letter == 0 {
    let byte = pattern[index]
    if byte == 45 || byte == 95 || byte == 94 || (byte == 48 && width == 0) {
      flag = byte
    } else if byte >= 48 && byte <= 57 {
      if width <= WIDEST { width = width * 10 + u8.toUsize(byte - 48) }
    } else if byte == 58 {
      if colons < 3 { colons = colons + 1 }
    } else if byte == 46 {
      dot = true
    } else {
      letter = byte
    }
    index = index + 1
  }
  let mut problem = UNFINISHED
  if letter != 0 { problem = checkSpec(letter, width, colons, dot) }
  return Spec { letter: letter, flag: flag, width: width, colons: colons, dot: dot, next: index, problem: problem }
}

fn monthName(month: u8) -> string<'static> {
  return match month {
    1 => "January"
    2 => "February"
    3 => "March"
    4 => "April"
    5 => "May"
    6 => "June"
    7 => "July"
    8 => "August"
    9 => "September"
    10 => "October"
    11 => "November"
    _ => "December"
  }
}

fn dayName(weekday: u8) -> string<'static> {
  return match weekday {
    1 => "Monday"
    2 => "Tuesday"
    3 => "Wednesday"
    4 => "Thursday"
    5 => "Friday"
    6 => "Saturday"
    _ => "Sunday"
  }
}

// Writes `value` with at least `least` characters, padded with `pad`, or not padded when `pad`
// is 0.
fn putNumber(output: &mut [u8; 96], at: usize, value: u64, least: usize, pad: u8) -> usize {
  let mut digits: [u8; 20] = [0; 20]
  let mut count: usize = 0
  let mut rest = value
  while rest > 0 || count == 0 {
    digits[count] = 48 + u64.toU8(rest % 10)
    rest = rest / 10
    count = count + 1
  }
  let mut to = at
  if pad != 0 {
    let mut filled = count
    while filled < least {
      output[to] = pad
      to = to + 1
      filled = filled + 1
    }
  }
  while count > 0 {
    count = count - 1
    output[to] = digits[count]
    to = to + 1
  }
  return to
}

fn putText(output: &mut [u8; 96], at: usize, text: &[u8], length: usize, flag: u8, width: usize) -> usize {
  let mut to = at
  let mut filled = length
  while flag != 45 && filled < width {
    output[to] = if flag == 48 { 48 } else { 32 }
    to = to + 1
    filled = filled + 1
  }
  let mut index: usize = 0
  while index < length {
    let mut byte = text[index]
    if flag == 94 && byte >= 97 && byte <= 122 { byte = byte - 32 }
    output[to] = byte
    to = to + 1
    index = index + 1
  }
  return to
}

// Writes the number of a directive whose usual form has `least` characters padded with `usual`.
fn putField(output: &mut [u8; 96], value: i64, least: usize, usual: u8, flag: u8, width: usize) -> usize {
  let mut pad = usual
  if flag == 45 { pad = 0 }
  if flag == 95 { pad = 32 }
  if flag == 48 { pad = 48 }
  let mut size = least
  if width != 0 { size = width }
  let mut to: usize = 0
  let mut magnitude = value
  if value < 0 {
    // The sign goes after spaces and before zeros.
    magnitude = -value
    if pad == 32 {
      let mut digits: usize = 1
      let mut rest = magnitude / 10
      while rest > 0 {
        digits = digits + 1
        rest = rest / 10
      }
      while digits + 1 < size {
        output[to] = 32
        to = to + 1
        size = size - 1
      }
      pad = 0
    }
    output[to] = 45
    to = to + 1
    // A width counts the sign. The usual form of a year has its digits after the sign.
    if width != 0 && size > 0 { size = size - 1 }
  }
  return putNumber(&mut output, to, i64.toU64(magnitude), size, pad)
}

// Writes one directive into `output` and returns the length.
fn render(letter: u8, flag: u8, width: usize, colons: u8, dot: bool, fields: &TimeFields, output: &mut [u8; 96]) -> usize {
  let days = Civil.daysFromCivil(fields.year, fields.month, fields.day)
  let weekday = Civil.weekdayFromDays(days)
  let ordinal = days - Civil.daysFromCivil(fields.year, 1, 1) + 1
  let year = i32.toI64(fields.year)
  // Years before 0 keep the century and the year in it together: -44 is century -1, year 56.
  let mut century = year / 100
  let mut inCentury = year % 100
  if inCentury < 0 {
    century = century - 1
    inCentury = inCentury + 100
  }
  let mut hour12 = u8.toI64(fields.hour) % 12
  if hour12 == 0 { hour12 = 12 }
  return match letter {
    89 => putField(&mut output, year, 4, 48, flag, width)
    67 => putField(&mut output, century, 2, 48, flag, width)
    121 => putField(&mut output, inCentury, 2, 48, flag, width)
    109 => putField(&mut output, u8.toI64(fields.month), 2, 48, flag, width)
    100 => putField(&mut output, u8.toI64(fields.day), 2, 48, flag, width)
    101 => putField(&mut output, u8.toI64(fields.day), 2, 32, flag, width)
    106 => putField(&mut output, ordinal, 3, 48, flag, width)
    117 => putField(&mut output, u8.toI64(weekday), 1, 48, flag, width)
    119 => putField(&mut output, u8.toI64(weekday) % 7, 1, 48, flag, width)
    85 => putField(&mut output, (ordinal + 6 - u8.toI64(weekday) % 7) / 7, 2, 48, flag, width)
    87 => putField(&mut output, (ordinal + 6 - (u8.toI64(weekday) + 6) % 7) / 7, 2, 48, flag, width)
    71 => {
      let date = PlainDate.make(fields.year, fields.month, fields.day)
      return putField(&mut output, i32.toI64(date.yearOfWeek()), 4, 48, flag, width)
    }
    103 => {
      let date = PlainDate.make(fields.year, fields.month, fields.day)
      let mut short = i32.toI64(date.yearOfWeek()) % 100
      if short < 0 { short = short + 100 }
      return putField(&mut output, short, 2, 48, flag, width)
    }
    86 => {
      let date = PlainDate.make(fields.year, fields.month, fields.day)
      return putField(&mut output, u8.toI64(date.weekOfYear()), 2, 48, flag, width)
    }
    66 => {
      let name = String.utf8Bytes(monthName(fields.month))
      return putText(&mut output, 0, name, name.length, flag, width)
    }
    98 => putText(&mut output, 0, String.utf8Bytes(monthName(fields.month)), 3, flag, width)
    104 => putText(&mut output, 0, String.utf8Bytes(monthName(fields.month)), 3, flag, width)
    65 => {
      let name = String.utf8Bytes(dayName(weekday))
      return putText(&mut output, 0, name, name.length, flag, width)
    }
    97 => putText(&mut output, 0, String.utf8Bytes(dayName(weekday)), 3, flag, width)
    72 => putField(&mut output, u8.toI64(fields.hour), 2, 48, flag, width)
    107 => putField(&mut output, u8.toI64(fields.hour), 2, 32, flag, width)
    73 => putField(&mut output, hour12, 2, 48, flag, width)
    108 => putField(&mut output, hour12, 2, 32, flag, width)
    77 => putField(&mut output, u8.toI64(fields.minute), 2, 48, flag, width)
    83 => putField(&mut output, u8.toI64(fields.second), 2, 48, flag, width)
    112 => {
      if fields.hour < 12 { return putText(&mut output, 0, b"AM", 2, 0, width) }
      return putText(&mut output, 0, b"PM", 2, 0, width)
    }
    80 => {
      if fields.hour < 12 { return putText(&mut output, 0, b"am", 2, flag, width) }
      return putText(&mut output, 0, b"pm", 2, flag, width)
    }
    102 => renderFraction(fields.nanosecond, width, dot, false, &mut output)
    78 => renderFraction(fields.nanosecond, width, dot, true, &mut output)
    122 => {
      let mut seconds = i32.toI64(fields.offsetSeconds)
      output[0] = 43
      if seconds < 0 {
        output[0] = 45
        seconds = -seconds
      }
      let mut to = putNumber(&mut output, 1, i64.toU64(seconds / 3600), 2, 48)
      if colons > 0 {
        output[to] = 58
        to = to + 1
      }
      to = putNumber(&mut output, to, i64.toU64(seconds / 60 % 60), 2, 48)
      if colons == 2 {
        output[to] = 58
        to = putNumber(&mut output, to + 1, i64.toU64(seconds % 60), 2, 48)
      }
      return to
    }
    90 => putText(&mut output, 0, &fields.abbreviation, fields.abbreviationLength, flag, width)
    115 => {
      let seconds = days * 86400 + u8.toI64(fields.hour) * 3600 + u8.toI64(fields.minute) * 60 +
        u8.toI64(fields.second) - i32.toI64(fields.offsetSeconds)
      return putField(&mut output, seconds, 1, 48, flag, width)
    }
    110 => {
      output[0] = 10
      return 1
    }
    116 => {
      output[0] = 9
      return 1
    }
    _ => {
      output[0] = 37
      return 1
    }
  }
}

fn renderFraction(nanosecond: u32, width: usize, dot: bool, whole: bool, output: &mut [u8; 96]) -> usize {
  let mut digits: [u8; 9] = [48; 9]
  let mut rest = nanosecond
  let mut index: usize = 9
  while index > 0 {
    index = index - 1
    digits[index] = 48 + u32.toU8(rest % 10)
    rest = rest / 10
  }
  let mut count: usize = 9
  if width != 0 {
    count = if width > 9 { 9 } else { width }
  } else if !whole {
    while count > 1 && digits[count - 1] == 48 {
      count = count - 1
    }
    if dot && nanosecond == 0 { return 0 }
  }
  let mut to: usize = 0
  if dot {
    output[0] = 46
    to = 1
  }
  index = 0
  while index < count {
    output[to] = digits[index]
    to = to + 1
    index = index + 1
  }
  return to
}

// The place in a text that is read, and the first problem.
struct Cursor<'t> {
  bytes: &'t [u8],
  at: usize,
  failed: bool,
  reason: TimeParseReason,
}

fn isSpace(byte: u8) -> bool {
  return byte == 32 || (byte >= 9 && byte <= 13)
}

fn lower(byte: u8) -> u8 {
  if byte >= 65 && byte <= 90 { return byte + 32 }
  return byte
}

impl<'t> Cursor<'t> {
  fn stop(self: &mut Self, reason: TimeParseReason) -> () {
    if !self.failed {
      self.failed = true
      self.reason = reason
    }
    return ()
  }

  fn stopHere(self: &mut Self) -> () {
    if self.at >= self.bytes.length {
      return self.stop(TimeParseReason.UnexpectedEnd)
    }
    return self.stop(TimeParseReason.UnexpectedCharacter)
  }

  fn skipSpace(self: &mut Self) -> () {
    while self.at < self.bytes.length && isSpace(self.bytes[self.at]) {
      self.at = self.at + 1
    }
    return ()
  }

  // Reads literal pattern text. White space matches any amount of white space.
  fn literal(self: &mut Self, text: &[u8]) -> () {
    let mut index: usize = 0
    while index < text.length && !self.failed {
      if isSpace(text[index]) {
        self.skipSpace()
      } else if self.at < self.bytes.length && self.bytes[self.at] == text[index] {
        self.at = self.at + 1
      } else {
        self.stopHere()
      }
      index = index + 1
    }
    return ()
  }

  // Reads 1 to `most` digits.
  fn number(self: &mut Self, most: usize) -> i64 {
    let mut value: i64 = 0
    let mut count: usize = 0
    while count < most && self.at < self.bytes.length && self.bytes[self.at] >= 48 && self.bytes[self.at] <= 57 {
      value = value * 10 + u8.toI64(self.bytes[self.at] - 48)
      self.at = self.at + 1
      count = count + 1
    }
    if count == 0 { self.stopHere() }
    return value
  }

  // Reads a number that can have a sign, which then allows `more` digits.
  fn signed(self: &mut Self, most: usize, more: usize) -> i64 {
    if self.at < self.bytes.length && (self.bytes[self.at] == 45 || self.bytes[self.at] == 43) {
      let negative = self.bytes[self.at] == 45
      self.at = self.at + 1
      let value = self.number(more)
      if negative { return -value }
      return value
    }
    return self.number(most)
  }

  // Reads a number from `low` to `high`.
  fn within(self: &mut Self, most: usize, low: i64, high: i64) -> i64 {
    let value = self.number(most)
    if !self.failed && (value < low || value > high) { self.stop(TimeParseReason.OutOfRange) }
    return value
  }

  // Returns `true` and passes the text if it starts with `name` in any case.
  fn word(self: &mut Self, name: &[u8], length: usize) -> bool {
    if self.bytes.length - self.at < length { return false }
    let mut index: usize = 0
    while index < length {
      if lower(self.bytes[self.at + index]) != lower(name[index]) { return false }
      index = index + 1
    }
    self.at = self.at + length
    return true
  }

  // Reads a month name and returns 1 to 12.
  fn month(self: &mut Self) -> u8 {
    let mut month: u8 = 1
    while month <= 12 {
      let name = String.utf8Bytes(monthName(month))
      if self.word(name, name.length) || self.word(name, 3) { return month }
      month = month + 1
    }
    self.stopHere()
    return 1
  }

  // Reads a weekday name and returns 1 to 7.
  fn day(self: &mut Self) -> u8 {
    let mut day: u8 = 1
    while day <= 7 {
      let name = String.utf8Bytes(dayName(day))
      if self.word(name, name.length) || self.word(name, 3) { return day }
      day = day + 1
    }
    self.stopHere()
    return 1
  }

  // Reads an offset: `Z`, or a sign, two digits of hours, and minutes and seconds with or without
  // colons.
  fn offset(self: &mut Self) -> i32 {
    if self.at >= self.bytes.length {
      self.stopHere()
      return 0
    }
    let sign = self.bytes[self.at]
    if sign == 90 || sign == 122 {
      self.at = self.at + 1
      return 0
    }
    if sign != 43 && sign != 45 {
      self.stopHere()
      return 0
    }
    self.at = self.at + 1
    let mut parts: [i64; 3] = [0; 3]
    let mut count: usize = 0
    while count < 3 && !self.failed {
      if count > 0 {
        let colon = self.at < self.bytes.length && self.bytes[self.at] == 58
        let next = if colon { self.at + 1 } else { self.at }
        if next >= self.bytes.length || self.bytes[next] < 48 || self.bytes[next] > 57 { break }
        self.at = next
      }
      let start = self.at
      parts[count] = self.number(2)
      if !self.failed && self.at - start != 2 { self.stopHere() }
      count = count + 1
    }
    if self.failed { return 0 }
    if parts[0] > 23 || parts[1] > 59 || parts[2] > 59 {
      self.stop(TimeParseReason.OutOfRange)
      return 0
    }
    let seconds = parts[0] * 3600 + parts[1] * 60 + parts[2]
    if sign == 45 { return i64.toI32(-seconds) }
    return i64.toI32(seconds)
  }

  // Reads the fraction of a second and returns nanoseconds.
  fn fraction(self: &mut Self, width: usize, dot: bool) -> u32 {
    if dot {
      if self.at >= self.bytes.length || self.bytes[self.at] != 46 { return 0 }
      self.at = self.at + 1
    }
    let most: usize = if width != 0 && width < 9 { width } else { 9 }
    let start = self.at
    let mut value = self.number(most)
    let mut count = self.at - start
    while count < 9 {
      value = value * 10
      count = count + 1
    }
    return i64.toU32(value)
  }
}

// Reads one directive from the text into `parsed`.
fn take(letter: u8, flag: u8, width: usize, dot: bool, cursor: &mut Cursor<'_>, parsed: &mut ParsedFields) -> () {
  // A field that is padded with spaces can have spaces before it.
  if flag == 95 { cursor.skipSpace() }
  let two: usize = if width != 0 { width } else { 2 }
  let four: usize = if width != 0 { width } else { 4 }
  match letter {
    89 => {
      let year = cursor.signed(four, 6)
      parsed.year = i64.toI32(year)
    }
    67 => { parsed.century = i64.toI32(cursor.signed(two, 4)) }
    121 => { parsed.shortYear = i64.toI32(cursor.within(two, 0, 99)) }
    109 => { parsed.month = i64.toU8(cursor.within(two, 1, 12)) }
    66 => { parsed.month = cursor.month() }
    98 => { parsed.month = cursor.month() }
    104 => { parsed.month = cursor.month() }
    100 => { parsed.day = i64.toU8(cursor.within(two, 1, 31)) }
    101 => {
      cursor.skipSpace()
      parsed.day = i64.toU8(cursor.within(two, 1, 31))
    }
    106 => { parsed.ordinal = i64.toU16(cursor.within(if width != 0 { width } else { 3 }, 1, 366)) }
    71 => { parsed.weekYear = i64.toI32(cursor.signed(four, 6)) }
    103 => { parsed.weekYear = i64.toI32(cursor.within(two, 0, 99)) }
    86 => { parsed.week = i64.toU8(cursor.within(two, 1, 53)) }
    85 => { parsed.week = i64.toU8(cursor.within(two, 0, 53)) }
    87 => { parsed.week = i64.toU8(cursor.within(two, 0, 53)) }
    65 => { parsed.dayOfWeek = cursor.day() }
    97 => { parsed.dayOfWeek = cursor.day() }
    117 => { parsed.dayOfWeek = i64.toU8(cursor.within(1, 1, 7)) }
    119 => {
      let day = cursor.within(1, 0, 6)
      parsed.dayOfWeek = if day == 0 { 7 } else { i64.toU8(day) }
    }
    72 => { parsed.hour = i64.toU8(cursor.within(two, 0, 23)) }
    107 => {
      cursor.skipSpace()
      parsed.hour = i64.toU8(cursor.within(two, 0, 23))
    }
    73 => { parsed.hour = i64.toU8(cursor.within(two, 1, 12)) }
    108 => {
      cursor.skipSpace()
      parsed.hour = i64.toU8(cursor.within(two, 1, 12))
    }
    112 => { parsed.half = takeHalf(&mut cursor) }
    80 => { parsed.half = takeHalf(&mut cursor) }
    77 => { parsed.minute = i64.toU8(cursor.within(two, 0, 59)) }
    83 => { parsed.second = i64.toU8(cursor.within(two, 0, 59)) }
    102 => { parsed.nanosecond = cursor.fraction(width, dot) }
    78 => { parsed.nanosecond = cursor.fraction(width, dot) }
    122 => { parsed.offsetSeconds = cursor.offset() }
    115 => { parsed.unix = cursor.signed(18, 18) }
    110 => { cursor.skipSpace() }
    116 => { cursor.skipSpace() }
    _ => { cursor.literal(b"%") }
  }
  parsed.set = parsed.set | setBy(letter)
  return ()
}

fn takeHalf(cursor: &mut Cursor<'_>) -> u8 {
  if cursor.word(b"am", 2) { return 0 }
  if cursor.word(b"pm", 2) { return 1 }
  cursor.stopHere()
  return 0
}

fn emptyFields() -> ParsedFields {
  return ParsedFields {
    set: 0, year: 0, century: 0, shortYear: 0, month: 1, day: 1, ordinal: 1, weekYear: 0, week: 1, dayOfWeek: 1,
    hour: 0, half: 0, minute: 0, second: 0, nanosecond: 0, offsetSeconds: 0, unix: 0, length: 0,
  }
}

// Ends a read: the text must be used up.
fn finish(cursor: &mut Cursor<'_>, parsed: &mut ParsedFields) -> Result<ParsedFields, TimeParseError> {
  if !cursor.failed && cursor.at < cursor.bytes.length { cursor.stop(TimeParseReason.UnexpectedCharacter) }
  if cursor.failed {
    return Result<ParsedFields, TimeParseError>.failResult(TimeParseError { reason: cursor.reason, offset: cursor.at })
  }
  parsed.length = cursor.bytes.length
  return Result<ParsedFields, TimeParseError>.succeed(parsed.*)
}

// Reads `text` with a pattern that `checkPattern` accepted.
fn readDynamic(pattern: &[u8], cursor: &mut Cursor<'_>, parsed: &mut ParsedFields) -> () {
  let mut at: usize = 0
  while at < pattern.length && !cursor.failed {
    if pattern[at] != 37 {
      cursor.literal(Slice.view<u8>(pattern, at, 1))
      at = at + 1
    } else {
      let spec = specAt(pattern, at)
      let short = expansion(spec.letter)
      if String.utf8Bytes(short).length != 0 {
        readDynamic(String.utf8Bytes(short), &mut cursor, &mut parsed)
      } else {
        take(spec.letter, spec.flag, spec.width, spec.dot, &mut cursor, &mut parsed)
      }
      at = spec.next
    }
  }
  return ()
}

fn patternFailure<T>(reason: PatternReason, offset: usize) -> Result<T, PatternError> {
  return Result<T, PatternError>.failResult(PatternError { reason: reason, offset: offset })
}

// Checks a pattern that is read at run time and returns the fields that it sets.
fn checkPattern(pattern: &[u8], writing: bool, parts: PatternParts) -> Result<u32, PatternError> {
  let mut set: u32 = 0
  let mut at: usize = 0
  while at < pattern.length {
    if pattern[at] != 37 {
      at = at + 1
    } else {
      let spec = specAt(pattern, at)
      if spec.problem != 0 { return patternFailure<u32>(reasonOf(spec.problem), at) }
      let short = String.utf8Bytes(expansion(spec.letter))
      if short.length != 0 {
        match checkPattern(short, writing, parts) {
          Result<u32, PatternError>.Success { value } => { set = set | value }
          Result<u32, PatternError>.Failure {..} => { return patternFailure<u32>(PatternReason.NotAvailable, at) }
        }
      } else {
        if writing && !available(parts, needs(spec.letter)) { return patternFailure<u32>(PatternReason.NotAvailable, at) }
        if !writing && spec.letter == 90 { return patternFailure<u32>(PatternReason.NotReadable, at) }
        set = set | setBy(spec.letter)
      }
      at = spec.next
    }
  }
  return Result<u32, PatternError>.succeed(set)
}

effect fn appendDynamic(pattern: &[u8], fields: &TimeFields, output: &mut List<u8>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut at: usize = 0
  let mut literalStart: usize = 0
  while at < pattern.length {
    if pattern[at] != 37 {
      at = at + 1
    } else {
      if literalStart < at { run List.appendBytes(&mut output.*, Slice.view<u8>(pattern, literalStart, at - literalStart)) }
      let spec = specAt(pattern, at)
      let short = String.utf8Bytes(expansion(spec.letter))
      if short.length != 0 {
        run appendDynamic(short, fields, &mut output.*)
      } else {
        let mut room: [u8; 96] = [0; 96]
        let length = render(spec.letter, spec.flag, spec.width, spec.colons, spec.dot, fields, &mut room)
        run List.appendBytes(&mut output.*, Slice.view<u8>(&room, usize.ZERO, length))
      }
      at = spec.next
      literalStart = at
    }
  }
  if literalStart < at { run List.appendBytes(&mut output.*, Slice.view<u8>(pattern, literalStart, at - literalStart)) }
  return ()
}

effect fn textOf(bytes: List<u8>) -> String ! OutOfMemoryError ? &mut Allocator {
  // A pattern is UTF-8 and the directives write ASCII, so the bytes are UTF-8.
  return run String.copy(unsafe Intrinsic.stringFromUtf8Unchecked(bytes.asSlice()))
}

/// Functions that write and read dates and times with `strftime` patterns.
pub struct TimePattern {}

impl TimePattern {
  /// Writes `value` with the constant pattern `pattern` to the `Writer`.
  ///
  /// # Details
  ///
  /// The pattern is checked when the program is compiled. A directive that is not known, or that
  /// needs a part `value` does not have, is a compile error.
  ///
  /// # Errors
  ///
  /// - `WriterError` if the `Writer` fails.
  pub effect fn write<T: PatternSource>(static pattern: string<'static>, value: &T) -> ()
    ! WriterError
    ? &mut Writer {
    let fields = PatternSource.fields(value)
    static for step in writeSteps<T>(pattern) {
      static if step.letter == 0 {
        run Writer.writeAll(String.utf8Bytes(step.literal))
      } else {
        let mut room: [u8; 96] = [0; 96]
        let length = render(step.letter, step.flag, step.width, step.colons, step.dot, &fields, &mut room)
        run Writer.writeAll(Slice.view<u8>(&room, usize.ZERO, length))
      }
    }
    return ()
  }

  /// Returns `value` written with the constant pattern `pattern`.
  ///
  /// # Details
  ///
  /// The pattern is checked when the program is compiled, as [`TimePattern.write`] checks it.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the text.
  pub effect fn format<T: PatternSource>(static pattern: string<'static>, value: &T) -> String
    ! OutOfMemoryError
    ? &mut Allocator {
    let fields = PatternSource.fields(value)
    let mut output = List<u8>.make()
    static for step in writeSteps<T>(pattern) {
      static if step.letter == 0 {
        run List.appendBytes(&mut output, String.utf8Bytes(step.literal))
      } else {
        let mut room: [u8; 96] = [0; 96]
        let length = render(step.letter, step.flag, step.width, step.colons, step.dot, &fields, &mut room)
        run List.appendBytes(&mut output, Slice.view<u8>(&room, usize.ZERO, length))
      }
    }
    return run textOf(move output)
  }

  /// Reads a `T` from `text` with the constant pattern `pattern`.
  ///
  /// # Details
  ///
  /// The pattern is checked when the program is compiled. A directive that is not known, `%Z`,
  /// or a pattern that does not give what `T` needs, such as a `PlainDate` without a year, is a
  /// compile error.
  ///
  /// # Errors
  ///
  /// - `TimeParseReason.UnexpectedEnd` or `UnexpectedCharacter` if `text` does not have the form
  ///   of the pattern.
  /// - `TimeParseReason.OutOfRange` if a field names no real value, such as month 13 or February
  ///   30, or a weekday that is not the weekday of the date.
  pub fn parse<T: PatternTarget>(static pattern: string<'static>, text: string) -> Result<T, TimeParseError> {
    let mut cursor = Cursor { bytes: String.utf8Bytes(text), at: 0, failed: false, reason: TimeParseReason.UnexpectedEnd }
    let mut parsed = emptyFields()
    static for step in readSteps(pattern, kindOf<T>(), true) {
      static if step.letter == 0 {
        cursor.literal(String.utf8Bytes(step.literal))
      } else {
        take(step.letter, step.flag, step.width, step.dot, &mut cursor, &mut parsed)
      }
    }
    return match finish(&mut cursor, &mut parsed) {
      Result<ParsedFields, TimeParseError>.Success { value } => PatternTarget.resolve(&value)
      Result<ParsedFields, TimeParseError>.Failure { error } => Result<T, TimeParseError>.failResult(error)
    }
  }

  /// Reads the fields of `text` with the constant pattern `pattern`, without making a value.
  ///
  /// # When to use
  ///
  /// Use it for a text that has more than one value, or parts that a single type does not hold,
  /// and take the values with [`ParsedFields.date`], [`ParsedFields.time`] and the others.
  ///
  /// # Errors
  ///
  /// - `TimeParseReason.UnexpectedEnd` or `UnexpectedCharacter` if `text` does not have the form
  ///   of the pattern.
  /// - `TimeParseReason.OutOfRange` if a field is outside its range, such as month 13.
  pub fn parseFields(static pattern: string<'static>, text: string) -> Result<ParsedFields, TimeParseError> {
    let mut cursor = Cursor { bytes: String.utf8Bytes(text), at: 0, failed: false, reason: TimeParseReason.UnexpectedEnd }
    let mut parsed = emptyFields()
    static for step in readSteps(pattern, PatternKind.Date, false) {
      static if step.letter == 0 {
        cursor.literal(String.utf8Bytes(step.literal))
      } else {
        take(step.letter, step.flag, step.width, step.dot, &mut cursor, &mut parsed)
      }
    }
    return finish(&mut cursor, &mut parsed)
  }

  /// Checks a pattern that is known only at run time, for writing a `T`.
  ///
  /// # Errors
  ///
  /// - `PatternError` if a directive is malformed or unknown, or needs a part that `T` does not
  ///   have.
  pub fn validate<T: PatternSource>(pattern: string) -> Result<(), PatternError> {
    return match checkPattern(String.utf8Bytes(pattern), true, partsOf<T>()) {
      Result<u32, PatternError>.Success {..} => Result<(), PatternError>.succeed(())
      Result<u32, PatternError>.Failure { error } => Result<(), PatternError>.failResult(error)
    }
  }

  /// Returns `value` written with a pattern that is known only at run time.
  ///
  /// # Errors
  ///
  /// - `PatternError` as the `Result` failure if a directive is malformed or unknown, or needs a
  ///   part that `value` does not have.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the text.
  pub effect fn formatDynamic<T: PatternSource>(pattern: string, value: &T) -> Result<String, PatternError>
    ! OutOfMemoryError
    ? &mut Allocator {
    let bytes = String.utf8Bytes(pattern)
    match checkPattern(bytes, true, partsOf<T>()) {
      Result<u32, PatternError>.Success {..} => {}
      Result<u32, PatternError>.Failure { error } => {
        return Result<String, PatternError>.failResult(error)
      }
    }
    let fields = PatternSource.fields(value)
    let mut output = List<u8>.make()
    run appendDynamic(bytes, &fields, &mut output)
    return Result<String, PatternError>.succeed(run textOf(move output))
  }

  /// Reads the fields of `text` with a pattern that is known only at run time.
  ///
  /// # Details
  ///
  /// The outer `Result` fails for a pattern that cannot be used, and the inner one for a text
  /// that does not have the form of the pattern.
  ///
  /// # Errors
  ///
  /// - `PatternError` if a directive is malformed or unknown, or is `%Z`.
  /// - `TimeParseError` in the inner `Result`, as [`TimePattern.parseFields`] returns it.
  pub fn parseFieldsDynamic(pattern: string, text: string) -> Result<Result<ParsedFields, TimeParseError>, PatternError> {
    let bytes = String.utf8Bytes(pattern)
    let none = PatternParts { date: false, time: false, offset: false, zone: false }
    match checkPattern(bytes, false, none) {
      Result<u32, PatternError>.Success {..} => {}
      Result<u32, PatternError>.Failure { error } => {
        return Result<Result<ParsedFields, TimeParseError>, PatternError>.failResult(error)
      }
    }
    let mut cursor = Cursor { bytes: String.utf8Bytes(text), at: 0, failed: false, reason: TimeParseReason.UnexpectedEnd }
    let mut parsed = emptyFields()
    readDynamic(bytes, &mut cursor, &mut parsed)
    return Result<Result<ParsedFields, TimeParseError>, PatternError>.succeed(finish(&mut cursor, &mut parsed))
  }

  /// Reads a `T` from `text` with a pattern that is known only at run time.
  ///
  /// # Details
  ///
  /// The outer `Result` fails for a pattern that cannot be used, and the inner one for a text
  /// that does not have the form of the pattern.
  ///
  /// # Errors
  ///
  /// - `PatternError` if a directive is malformed or unknown, or is `%Z`, or the pattern does
  ///   not give what `T` needs.
  /// - `TimeParseError` in the inner `Result`, as [`TimePattern.parse`] returns it.
  pub fn parseDynamic<T: PatternTarget>(pattern: string, text: string) -> Result<Result<T, TimeParseError>, PatternError> {
    let bytes = String.utf8Bytes(pattern)
    let none = PatternParts { date: false, time: false, offset: false, zone: false }
    match checkPattern(bytes, false, none) {
      Result<u32, PatternError>.Success { value } => {
        let missing = unresolved(targetOf<T>(), value)
        if missing != 0 {
          return Result<Result<T, TimeParseError>, PatternError>.failResult(
            PatternError { reason: reasonOf(missing), offset: bytes.length },
          )
        }
      }
      Result<u32, PatternError>.Failure { error } => {
        return Result<Result<T, TimeParseError>, PatternError>.failResult(error)
      }
    }
    let mut cursor = Cursor { bytes: String.utf8Bytes(text), at: 0, failed: false, reason: TimeParseReason.UnexpectedEnd }
    let mut parsed = emptyFields()
    readDynamic(bytes, &mut cursor, &mut parsed)
    return match finish(&mut cursor, &mut parsed) {
      Result<ParsedFields, TimeParseError>.Success { value } => Result<Result<T, TimeParseError>, PatternError>.succeed(
        PatternTarget.resolve(&value),
      )
      Result<ParsedFields, TimeParseError>.Failure { error } => Result<Result<T, TimeParseError>, PatternError>.succeed(
        Result<T, TimeParseError>.failResult(error),
      )
    }
  }
}

// The parts and the kind of a type, for the functions that take a pattern at run time.
fn partsOf<T: PatternSource>() -> PatternParts {
  let static parts: PatternParts = sourceParts<T>()
  return parts
}

static fn sourceParts<T: PatternSource>() -> PatternParts {
  return PatternSource.parts()
}

fn targetOf<T: PatternTarget>() -> PatternKind {
  let static kind: PatternKind = kindOf<T>()
  return kind
}
