//! Dates in other calendars than ISO 8601: [`Calendar`], [`CalendarDate`], [`Era`], and
//! [`MonthCode`].
//!
//! # When to use
//!
//! Use [`CalendarDate`] to show a day to a person who reads another calendar, to read a date that
//! a person gives in one, and to count years and months as that calendar counts them. For the
//! dates that programs store and exchange, use `PlainDate` of `silk.time.plain_date`.
//!
//! # Details
//!
//! A [`CalendarDate`] is a `PlainDate` seen in one of 16 calendars. [`CalendarDate.of`] converts a
//! `PlainDate`, and [`CalendarDate.date`] gives it back. The text form is the ISO 8601 date with
//! the calendar in an annotation, as in `2026-11-19[u-ca=hebrew]`, which is the form of RFC 9557
//! and of ECMAScript Temporal.
//!
//! The fields and the arithmetic follow ECMAScript Temporal:
//!
//! - [`CalendarDate.year`] is one count through all eras, and [`CalendarDate.era`] and
//!   [`CalendarDate.eraYear`] give the year as people write it.
//! - [`CalendarDate.month`] is the number of the month in its year. [`CalendarDate.monthCode`] is
//!   the name of the month that does not change when a year has a leap month.
//! - [`CalendarDate.checkedAdd`] and [`CalendarDate.until`] count the years and the months of the
//!   calendar.
//!
//! The Hebrew calendar, the Islamic calendars by rule, and the Coptic, Ethiopic, Indian, and
//! Persian calendars are computed for every date of `PlainDate`. The Persian calendar follows the
//! 33-year rule with the corrections of Unicode ICU, which keep it on the astronomical calendar of
//! Iran. The Umm al-Qura calendar has a table for the years 1300 to 1600 of the Hijra, and the
//! Chinese and Dangi calendars have tables for 1800 to 2200; they are in
//! `silk.time.calendar_data`.
//!
//! # Gotchas
//!
//! The Chinese and Dangi calendars have no data outside 1800-01-25 to 2201-02-03. A date outside
//! gives `CalendarError.OutOfRange`.
//!
//! The Japanese calendar has the eras from Meiji on, and Meiji starts on 1873-01-01, the day
//! Japan took the Gregorian calendar. Earlier dates have the eras `ce` and `bce`.
//!
//! # Examples
//!
//! ## Show a date in the Hebrew calendar
//!
//! ```silk
//! import silk.core.result { Result }
//! import silk.time.calendar { Calendar, CalendarDate, CalendarError }
//! import silk.time.plain_date { PlainDate }
//!
//! pub fn main() -> i32 {
//!   return match CalendarDate.of(Calendar.Hebrew, PlainDate.make(2026, 11, 19)) {
//!     Result<CalendarDate, CalendarError>.Success { value } => {
//!       // 9 Kislev 5787. Kislev is the third month.
//!       if value.year() != 5787 || value.month() != 3 || value.day() != 9 {
//!         return 1
//!       }
//!       if value.monthCode().number != 3 || value.monthCode().leap {
//!         return 2
//!       }
//!       return 0
//!     }
//!     Result<CalendarDate, CalendarError>.Failure {..} => 3
//!   }
//! }
//! ```
//!
//! ## Read a date that a person gives in the Japanese calendar
//!
//! ```silk
//! import silk.core.option { Option }
//! import silk.core.result { Result }
//! import silk.time.calendar { Calendar, CalendarDate, CalendarError, Era }
//! import silk.time.period { Overflow }
//! import silk.time.plain_date { PlainDate }
//!
//! pub fn main() -> i32 {
//!   // Reiwa 8, month 11, day 19.
//!   let year = match Calendar.Japanese.yearOfEra(Era.Reiwa, 8) {
//!     Option<i32>.Some { value } => value
//!     Option<i32>.None => {
//!       return 1
//!     }
//!   }
//!   return match CalendarDate.fromFields(Calendar.Japanese, year, 11, 19, Overflow.Reject) {
//!     Result<CalendarDate, CalendarError>.Success { value } => {
//!       let date = value.date()
//!       let expected = PlainDate.make(2026, 11, 19)
//!       if &date != &expected {
//!         return 2
//!       }
//!       return 0
//!     }
//!     Result<CalendarDate, CalendarError>.Failure {..} => 3
//!   }
//! }
//! ```
//!
//! ## Add a year in a calendar with leap months
//!
//! ```silk
//! import silk.core.result { Result }
//! import silk.time.calendar { Calendar, CalendarDate, CalendarError, MonthCode }
//! import silk.time.period { Overflow, Period }
//! import silk.time.plain_date { PlainDate }
//!
//! pub fn main() -> i32 {
//!   // 30 Adar I 5784. The year 5785 has no Adar I, so one year later is in Adar.
//!   let start = match CalendarDate.fromMonthCode(Calendar.Hebrew, 5784, MonthCode.make(5, true), 30, Overflow.Reject) {
//!     Result<CalendarDate, CalendarError>.Success { value } => value
//!     Result<CalendarDate, CalendarError>.Failure {..} => {
//!       return 1
//!     }
//!   }
//!   return match start.checkedAdd(Period.ofYears(1), Overflow.Constrain) {
//!     Result<CalendarDate, CalendarError>.Success { value } => {
//!       // Adar has 29 days.
//!       if value.monthCode().number != 6 || value.day() != 29 {
//!         return 2
//!       }
//!       return 0
//!     }
//!     Result<CalendarDate, CalendarError>.Failure {..} => 3
//!   }
//! }
//! ```
//!
//! @category Time
import silk.core.equal { Equal }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.text.format { Debug, Display, Format, Formatter }
import silk.text.string { String }
import silk.collections.slice { Slice }
import silk.time.calendar_data as CalendarData
import silk.time.civil as Civil
import silk.time.period { DateUnit, Overflow, Period }
import silk.time.plain_date { PlainDate }
import silk.time.duration { Duration }
import silk.time.text as Text
import silk.time.text { OffsetKind, Scanner, TimeParseError, TimeParseReason }
import silk.num.i32
import silk.num.i64
import silk.num.u16
import silk.num.u8
import silk.num.usize

// No date of the PlainDate range has a calendar year outside this limit.
const YEAR_LIMIT: i64 = 400000
// No period between two dates of the range has more months than this.
const MONTH_LIMIT: i64 = 8000000

// Days from 1970-01-01 to the first day of year 1 of each calendar.
const COPTIC_EPOCH: i64 = -615558
const ETHIOPIC_EPOCH: i64 = -716367
const HEBREW_EPOCH: i64 = -2092590
const PERSIAN_EPOCH: i64 = -492268
const ISLAMIC_EPOCH: i64 = -492148

const K_ISO: i32 = 0
const K_GREGORY: i32 = 1
const K_BUDDHIST: i32 = 2
const K_ROC: i32 = 3
const K_JAPANESE: i32 = 4
const K_COPTIC: i32 = 5
const K_ETHIOPIC: i32 = 6
const K_ETHIOAA: i32 = 7
const K_HEBREW: i32 = 8
const K_INDIAN: i32 = 9
const K_PERSIAN: i32 = 10
const K_CIVIL: i32 = 11
const K_TABULAR: i32 = 12
const K_UMALQURA: i32 = 13
const K_CHINESE: i32 = 14
const K_DANGI: i32 = 15

/// A calendar: a way to name a day with a year, a month, and a day of the month.
///
/// # Details
///
/// The names are the calendar identifiers of Unicode CLDR, which ECMAScript Temporal and the
/// `[u-ca=...]` annotation of RFC 9557 use.
pub enum Calendar {
  /// `iso8601`: the calendar of `PlainDate`, with the Gregorian leap year rule for every year and
  /// no eras.
  Iso8601,
  /// `gregory`: the ISO 8601 calendar with the eras `ce` and `bce`.
  Gregory,
  /// `buddhist`: the Thai solar calendar, the ISO 8601 calendar with years counted from 543 BCE.
  Buddhist,
  /// `roc`: the calendar of the Republic of China, the ISO 8601 calendar with years counted from
  /// 1912.
  Roc,
  /// `japanese`: the ISO 8601 calendar with the eras of Japan from Meiji on.
  Japanese,
  /// `coptic`: 12 months of 30 days and a 13th month of 5 or 6 days.
  Coptic,
  /// `ethiopic`: the Coptic months with years counted from the year 8 CE, the era `am`.
  Ethiopic,
  /// `ethioaa`: the Ethiopic calendar with years counted from the creation of the world, the era
  /// `aa`, 5500 years earlier.
  EthiopicAmeteAlem,
  /// `hebrew`: the lunisolar Hebrew calendar, with a 13th month in 7 years of each 19.
  Hebrew,
  /// `indian`: the Indian national calendar, with years of the Shaka era.
  Indian,
  /// `persian`: the Solar Hijri calendar of Iran and Afghanistan.
  Persian,
  /// `islamic-civil`: the Islamic calendar by rule, with 11 leap years in each 30 and a Friday
  /// epoch.
  IslamicCivil,
  /// `islamic-tbla`: the Islamic calendar by rule with a Thursday epoch, one day earlier than
  /// `islamic-civil`.
  IslamicTabular,
  /// `islamic-umalqura`: the Umm al-Qura calendar of Saudi Arabia. Outside the years 1300 to 1600
  /// of the Hijra it is the same as `islamic-civil`.
  IslamicUmmAlQura,
  /// `chinese`: the lunisolar Chinese calendar, for the dates 1800-01-25 to 2201-02-03.
  Chinese,
  /// `dangi`: the lunisolar Korean calendar, for the dates 1800-01-25 to 2201-02-03.
  Dangi,
}

/// An era of a calendar: the point from which the years of a date are counted.
pub enum Era {
  /// `ce`: the Common Era of `gregory` and `japanese`.
  Ce,
  /// `bce`: before the Common Era, in `gregory` and `japanese`. Year 1 is the year before 1 CE.
  Bce,
  /// `be`: the Buddhist Era of `buddhist`.
  Be,
  /// `am`: the Era of the Martyrs of `coptic`, the Incarnation Era of `ethiopic`, and Anno Mundi of
  /// `hebrew`.
  Am,
  /// `aa`: Amete Alem, the era of `ethioaa` and of the `ethiopic` years before `am`.
  Aa,
  /// `shaka`: the Shaka era of `indian`.
  Shaka,
  /// `ap`: Anno Persico of `persian`.
  Ap,
  /// `ah`: the era of the Hijra in the Islamic calendars.
  Ah,
  /// `bh`: before the Hijra, in the Islamic calendars. Year 1 is the year before 1 AH.
  Bh,
  /// `roc`: the era of the Republic of China, from 1912.
  Roc,
  /// `broc`: before the Republic of China. Year 1 is 1911.
  Broc,
  /// `meiji`: from 1873-01-01, when Japan took the Gregorian calendar, as year 6.
  Meiji,
  /// `taisho`: from 1912-07-30.
  Taisho,
  /// `showa`: from 1926-12-25.
  Showa,
  /// `heisei`: from 1989-01-08.
  Heisei,
  /// `reiwa`: from 2019-05-01.
  Reiwa,
}

/// Why a calendar date cannot be made.
pub enum CalendarError {
  /// The date is outside the range of `PlainDate`, or the calendar has no data for it. The
  /// `chinese` and `dangi` calendars have data for 1800-01-25 to 2201-02-03 only.
  OutOfRange,
  /// The year has no such month: the number is 0 or too high, the month code names a month that
  /// the calendar does not have, or it names a leap month in a year without it and the overflow
  /// rule is `Overflow.Reject`.
  NoSuchMonth,
  /// The month has no such day, and the day is 0 or the overflow rule is `Overflow.Reject`.
  NoSuchDay,
  /// The era is not an era of the calendar.
  NoSuchEra,
  /// The two dates of an operation are in different calendars.
  CalendarMismatch,
}

/// The name of a month that is the same in every year, such as `M05` or `M05L`.
///
/// # Details
///
/// In a calendar with leap months, the number of a month in the year changes: the Hebrew month
/// Nisan is month 7 of a common year and month 8 of a leap year. The month code does not change:
/// Nisan is always `M07`. A leap month has the number of the month before it and the letter `L`.
/// In the Hebrew calendar the only leap month is `M05L`, Adar I. In the Chinese and Dangi
/// calendars a leap month can follow any month.
pub struct MonthCode {
  /// The number in the code, from 1.
  pub number: u8,
  /// `true` for a leap month, written with `L`.
  pub leap: bool,
}

impl Copy for MonthCode {}

/// A day in one calendar.
///
/// # Details
///
/// A `CalendarDate` holds a `PlainDate` and a [`Calendar`]. The year, the month, and the day are
/// the fields of that day in the calendar. Two values are equal when they name the same day in
/// the same calendar.
///
/// The year is the year that arithmetic uses. It can be zero or negative. Calendars with eras also
/// give an [`Era`] and a year of the era, which is what people write.
pub struct CalendarDate {
  system: Calendar,
  iso: PlainDate,
  fieldYear: i32,
  fieldMonth: u8,
  fieldDay: u8,
}

impl Copy for CalendarDate {}

struct Fields {
  year: i64,
  month: i64,
  day: i64,
}

impl Copy for Fields {}

struct Code {
  number: i64,
  leap: bool,
}

impl Copy for Code {}

fn floorDiv(a: i64, b: i64) -> i64 {
  let quotient = a / b
  if a % b < 0 {
    return quotient - 1
  }
  return quotient
}

fn floorMod(a: i64, b: i64) -> i64 {
  let rest = a % b
  if rest < 0 {
    return rest + b
  }
  return rest
}

fn kindOf(calendar: Calendar) -> i32 {
  return match calendar {
    Calendar.Iso8601 => K_ISO
    Calendar.Gregory => K_GREGORY
    Calendar.Buddhist => K_BUDDHIST
    Calendar.Roc => K_ROC
    Calendar.Japanese => K_JAPANESE
    Calendar.Coptic => K_COPTIC
    Calendar.Ethiopic => K_ETHIOPIC
    Calendar.EthiopicAmeteAlem => K_ETHIOAA
    Calendar.Hebrew => K_HEBREW
    Calendar.Indian => K_INDIAN
    Calendar.Persian => K_PERSIAN
    Calendar.IslamicCivil => K_CIVIL
    Calendar.IslamicTabular => K_TABULAR
    Calendar.IslamicUmmAlQura => K_UMALQURA
    Calendar.Chinese => K_CHINESE
    Calendar.Dangi => K_DANGI
  }
}

fn calendarOfKind(kind: i32) -> Calendar {
  return match kind {
    0 => Calendar.Iso8601
    1 => Calendar.Gregory
    2 => Calendar.Buddhist
    3 => Calendar.Roc
    4 => Calendar.Japanese
    5 => Calendar.Coptic
    6 => Calendar.Ethiopic
    7 => Calendar.EthiopicAmeteAlem
    8 => Calendar.Hebrew
    9 => Calendar.Indian
    10 => Calendar.Persian
    11 => Calendar.IslamicCivil
    12 => Calendar.IslamicTabular
    13 => Calendar.IslamicUmmAlQura
    14 => Calendar.Chinese
    _ => Calendar.Dangi
  }
}

fn calendarName(kind: i32) -> &'static [u8] {
  return match kind {
    0 => b"iso8601"
    1 => b"gregory"
    2 => b"buddhist"
    3 => b"roc"
    4 => b"japanese"
    5 => b"coptic"
    6 => b"ethiopic"
    7 => b"ethioaa"
    8 => b"hebrew"
    9 => b"indian"
    10 => b"persian"
    11 => b"islamic-civil"
    12 => b"islamic-tbla"
    13 => b"islamic-umalqura"
    14 => b"chinese"
    _ => b"dangi"
  }
}

fn eraIndex(era: Era) -> i32 {
  return match era {
    Era.Ce => 0
    Era.Bce => 1
    Era.Be => 2
    Era.Am => 3
    Era.Aa => 4
    Era.Shaka => 5
    Era.Ap => 6
    Era.Ah => 7
    Era.Bh => 8
    Era.Roc => 9
    Era.Broc => 10
    Era.Meiji => 11
    Era.Taisho => 12
    Era.Showa => 13
    Era.Heisei => 14
    Era.Reiwa => 15
  }
}

fn eraOfIndex(index: i32) -> Era {
  return match index {
    0 => Era.Ce
    1 => Era.Bce
    2 => Era.Be
    3 => Era.Am
    4 => Era.Aa
    5 => Era.Shaka
    6 => Era.Ap
    7 => Era.Ah
    8 => Era.Bh
    9 => Era.Roc
    10 => Era.Broc
    11 => Era.Meiji
    12 => Era.Taisho
    13 => Era.Showa
    14 => Era.Heisei
    _ => Era.Reiwa
  }
}

fn eraName(index: i32) -> &'static [u8] {
  return match index {
    0 => b"ce"
    1 => b"bce"
    2 => b"be"
    3 => b"am"
    4 => b"aa"
    5 => b"shaka"
    6 => b"ap"
    7 => b"ah"
    8 => b"bh"
    9 => b"roc"
    10 => b"broc"
    11 => b"meiji"
    12 => b"taisho"
    13 => b"showa"
    14 => b"heisei"
    _ => b"reiwa"
  }
}

fn lower(byte: u8) -> u8 {
  if byte >= 65 && byte <= 90 {
    return byte + 32
  }
  return byte
}

// `true` when `text` is `name` in any letter case.
fn sameName(text: &[u8], name: &[u8]) -> bool {
  if text.length != name.length {
    return false
  }
  let mut index: usize = 0
  while index < name.length {
    if lower(text[index]) != name[index] {
      return false
    }
    index = index + 1
  }
  return true
}

fn isoBased(kind: i32) -> bool {
  return kind <= K_JAPANESE
}

fn lunar(kind: i32) -> bool {
  return kind == K_CHINESE || kind == K_DANGI
}

fn copticFamily(kind: i32) -> bool {
  return kind == K_COPTIC || kind == K_ETHIOPIC || kind == K_ETHIOAA
}

fn islamic(kind: i32) -> bool {
  return kind == K_CIVIL || kind == K_TABULAR || kind == K_UMALQURA
}

// The calendar year minus the ISO 8601 year, for the calendars with the ISO 8601 months.
fn isoOffset(kind: i32) -> i64 {
  if kind == K_BUDDHIST {
    return 543
  }
  if kind == K_ROC {
    return -1911
  }
  return 0
}

// The table entry of a lunar year, or -1 when the table does not have the year.
fn lunarEntry(kind: i32, year: i64) -> i32 {
  let index = year - i32.toI64(CalendarData.LUNAR_FIRST_YEAR)
  if index < 0 || index > 400 {
    return -1
  }
  if kind == K_DANGI {
    return CalendarData.DANGI_YEARS[i64.toUsize(index)]
  }
  return CalendarData.CHINESE_YEARS[i64.toUsize(index)]
}

fn lunarLeap(entry: i32) -> i64 {
  return i32.toI64(i32.shiftRight(entry, 6) & 15)
}

fn lunarLength(entry: i32, index: i64) -> i64 {
  if (i32.shiftRight(entry, 10 + i64.toI32(index)) & 1) != 0 {
    return 30
  }
  return 29
}

// `true` when the calendar can tell the months of `year`.
fn hasYear(kind: i32, year: i64) -> bool {
  if year < -YEAR_LIMIT || year > YEAR_LIMIT {
    return false
  }
  if lunar(kind) {
    return lunarEntry(kind, year) >= 0
  }
  return true
}

fn hebrewLeap(year: i64) -> bool {
  return floorMod(7 * year + 1, 19) < 7
}

// The day of the Hebrew new year, in days from the first new moon of the calendar.
fn hebrewStart(year: i64) -> i64 {
  let months = floorDiv(235 * year - 234, 19)
  let parts = months * 13753 + 12084
  let whole = floorDiv(parts, 25920)
  let mut day = months * 29 + whole
  let rest = parts - whole * 25920
  let weekday = floorMod(day, 7)
  if weekday == 2 || weekday == 4 || weekday == 6 {
    day = day + 1
  } else if weekday == 1 && rest >= 16404 && !hebrewLeap(year) {
    day = day + 2
  } else if weekday == 0 && rest >= 23269 && hebrewLeap(year - 1) {
    day = day + 1
  }
  return day
}

fn islamicLeap(year: i64) -> bool {
  return floorMod(11 * year + 14, 30) < 11
}

fn umalquraTable(year: i64) -> bool {
  let first = i32.toI64(CalendarData.UMALQURA_FIRST_YEAR)
  return year >= first && year <= first + 300
}

fn persianEarly(year: i64) -> i64 {
  if year < 1503 || year > 2988 {
    return 0
  }
  let mut index: usize = 0
  while index < CalendarData.PERSIAN_EARLY_YEARS.length {
    let entry = i32.toI64(CalendarData.PERSIAN_EARLY_YEARS[index])
    if entry == year {
      return 1
    }
    if entry > year {
      return 0
    }
    index = index + 1
  }
  return 0
}

// Days from 1970-01-01 to the first day of `year`. The year must pass `hasYear`.
fn yearStart(kind: i32, year: i64) -> i64 {
  if isoBased(kind) {
    return Civil.daysFromCivil(i64.toI32(year - isoOffset(kind)), 1, 1)
  }
  if kind == K_COPTIC {
    return COPTIC_EPOCH + 365 * (year - 1) + floorDiv(year, 4)
  }
  if kind == K_ETHIOPIC {
    return ETHIOPIC_EPOCH + 365 * (year - 1) + floorDiv(year, 4)
  }
  if kind == K_ETHIOAA {
    return ETHIOPIC_EPOCH + 365 * (year - 5501) + floorDiv(year - 5500, 4)
  }
  if kind == K_HEBREW {
    return HEBREW_EPOCH + hebrewStart(year)
  }
  if kind == K_INDIAN {
    let isoYear = i64.toI32(year + 78)
    if Civil.isLeapYear(isoYear) {
      return Civil.daysFromCivil(isoYear, 3, 21)
    }
    return Civil.daysFromCivil(isoYear, 3, 22)
  }
  if kind == K_PERSIAN {
    return PERSIAN_EPOCH + 365 * (year - 1) + floorDiv(8 * year + 21, 33) - persianEarly(year)
  }
  if lunar(kind) {
    let entry = lunarEntry(kind, year)
    return Civil.daysFromCivil(
      i64.toI32(year),
      i32.toU8((entry & 1) + 1),
      i32.toU8((i32.shiftRight(entry, 1) & 31) + 1),
    )
  }
  if kind == K_UMALQURA && umalquraTable(year) {
    let index = i64.toUsize(year - i32.toI64(CalendarData.UMALQURA_FIRST_YEAR))
    return ISLAMIC_EPOCH + i32.toI64(CalendarData.UMALQURA_STARTS[index])
  }
  let start = ISLAMIC_EPOCH + 354 * (year - 1) + floorDiv(11 * year + 3, 30)
  if kind == K_TABULAR {
    return start - 1
  }
  return start
}

fn monthsIn(kind: i32, year: i64) -> i64 {
  if copticFamily(kind) {
    return 13
  }
  if kind == K_HEBREW {
    if hebrewLeap(year) {
      return 13
    }
    return 12
  }
  if lunar(kind) && lunarLeap(lunarEntry(kind, year)) != 0 {
    return 13
  }
  return 12
}

fn yearLength(kind: i32, year: i64) -> i64 {
  if lunar(kind) {
    let entry = lunarEntry(kind, year)
    let months = monthsIn(kind, year)
    let mut days: i64 = 0
    let mut index: i64 = 0
    while index < months {
      days = days + lunarLength(entry, index)
      index = index + 1
    }
    return days
  }
  return yearStart(kind, year + 1) - yearStart(kind, year)
}

// The days of a month that the year has.
fn monthLength(kind: i32, year: i64, month: i64) -> i64 {
  if isoBased(kind) {
    return u8.toI64(Civil.daysInMonth(i64.toI32(year - isoOffset(kind)), i64.toU8(month)))
  }
  if copticFamily(kind) {
    if month < 13 {
      return 30
    }
    return yearLength(kind, year) - 360
  }
  if kind == K_PERSIAN {
    if month <= 6 {
      return 31
    }
    if month <= 11 {
      return 30
    }
    return yearLength(kind, year) - 336
  }
  if kind == K_INDIAN {
    if month == 1 {
      return yearLength(kind, year) - 335
    }
    if month <= 6 {
      return 31
    }
    return 30
  }
  if lunar(kind) {
    return lunarLength(lunarEntry(kind, year), month - 1)
  }
  if kind == K_HEBREW {
    let leap = hebrewLeap(year)
    let length = yearLength(kind, year)
    if month == 1 || month == 5 {
      return 30
    }
    if month == 2 {
      if length == 355 || length == 385 {
        return 30
      }
      return 29
    }
    if month == 3 {
      if length == 353 || length == 383 {
        return 29
      }
      return 30
    }
    if month == 4 {
      return 29
    }
    if leap == (month % 2 == 0) {
      return 30
    }
    return 29
  }
  if kind == K_UMALQURA && umalquraTable(year) {
    let index = i64.toUsize(year - i32.toI64(CalendarData.UMALQURA_FIRST_YEAR))
    let bits = CalendarData.UMALQURA_MONTHS[index]
    return 29 + i32.toI64(i32.shiftRight(bits, 12 - i64.toI32(month)) & 1)
  }
  if month == 12 {
    if islamicLeap(year) {
      return 30
    }
    return 29
  }
  if month % 2 == 1 {
    return 30
  }
  return 29
}

fn daysBefore(kind: i32, year: i64, month: i64) -> i64 {
  let mut days: i64 = 0
  let mut index: i64 = 1
  while index < month {
    days = days + monthLength(kind, year, index)
    index = index + 1
  }
  return days
}

// The calendar year that has the day `day` from 1970-01-01, or `None` for a lunar calendar when
// the table does not have it.
fn yearOfDay(kind: i32, day: i64) -> Option<i64> {
  let mut year: i64 = 0
  if isoBased(kind) {
    return Option<i64>.some(i32.toI64(Civil.civilFromDays(day).year) + isoOffset(kind))
  }
  if kind == K_COPTIC {
    year = floorDiv(4 * (day - COPTIC_EPOCH), 1461) + 1
  } else if kind == K_ETHIOPIC {
    year = floorDiv(4 * (day - ETHIOPIC_EPOCH), 1461) + 1
  } else if kind == K_ETHIOAA {
    year = floorDiv(4 * (day - ETHIOPIC_EPOCH), 1461) + 5501
  } else if kind == K_HEBREW {
    let months = floorDiv((day - HEBREW_EPOCH) * 25920, 765433)
    year = floorDiv(19 * months + 234, 235) + 1
  } else if kind == K_PERSIAN {
    year = floorDiv(33 * (day - PERSIAN_EPOCH) + 3, 12053) + 1
  } else if kind == K_INDIAN {
    year = i32.toI64(Civil.civilFromDays(day).year) - 78
  } else if lunar(kind) {
    year = i32.toI64(Civil.civilFromDays(day).year)
    if !hasYear(kind, year) {
      // The days before the new year of the first year after the table are in the last year.
      if !hasYear(kind, year - 1) {
        return Option<i64>.none()
      }
      year = year - 1
      if day >= yearStart(kind, year) + yearLength(kind, year) {
        return Option<i64>.none()
      }
      return Option<i64>.some(year)
    }
    if day < yearStart(kind, year) {
      if !hasYear(kind, year - 1) {
        return Option<i64>.none()
      }
      year = year - 1
    }
    return Option<i64>.some(year)
  } else {
    year = floorDiv(30 * (day - ISLAMIC_EPOCH) + 10646, 10631)
  }
  // The estimate is at most a few years away.
  while yearStart(kind, year) > day {
    year = year - 1
  }
  while yearStart(kind, year + 1) <= day {
    year = year + 1
  }
  return Option<i64>.some(year)
}

fn fieldsOfDay(kind: i32, day: i64) -> Option<Fields> {
  if isoBased(kind) {
    let civil = Civil.civilFromDays(day)
    return Option<Fields>.some(
      Fields {
        year: i32.toI64(civil.year) + isoOffset(kind),
        month: u8.toI64(civil.month),
        day: u8.toI64(civil.day),
      },
    )
  }
  match yearOfDay(kind, day) {
    Option<i64>.Some { value } => {
      let mut rest = day - yearStart(kind, value)
      let months = monthsIn(kind, value)
      let mut month: i64 = 1
      while month < months {
        let length = monthLength(kind, value, month)
        if rest < length {
          break
        }
        rest = rest - length
        month = month + 1
      }
      return Option<Fields>.some(Fields { year: value, month: month, day: rest + 1 })
    }
    Option<i64>.None => {
      return Option<Fields>.none()
    }
  }
}

// The number of the leap month of the year, which the month after it repeats, or 0.
fn leapNumber(kind: i32, year: i64) -> i64 {
  if kind == K_HEBREW {
    if hebrewLeap(year) {
      return 5
    }
    return 0
  }
  if lunar(kind) {
    return lunarLeap(lunarEntry(kind, year))
  }
  return 0
}

fn codeOf(kind: i32, year: i64, month: i64) -> Code {
  let leap = leapNumber(kind, year)
  if leap == 0 || month <= leap {
    return Code { number: month, leap: false }
  }
  if month == leap + 1 {
    return Code { number: leap, leap: true }
  }
  return Code { number: month - 1, leap: false }
}

// `true` when some year of the calendar can have a month with this code.
fn validCode(kind: i32, code: Code) -> bool {
  let mut most: i64 = 12
  if copticFamily(kind) {
    most = 13
  }
  if code.number < 1 || code.number > most {
    return false
  }
  if !code.leap {
    return true
  }
  if lunar(kind) {
    return true
  }
  return kind == K_HEBREW && code.number == 5
}

// The number in the year of the month with this code, or 0 when the year does not have it.
fn monthOf(kind: i32, year: i64, code: Code) -> i64 {
  let leap = leapNumber(kind, year)
  if code.leap {
    if leap == code.number {
      return leap + 1
    }
    return 0
  }
  if leap != 0 && code.number > leap {
    return code.number + 1
  }
  return code.number
}

// The month with this code, or the month that takes its place in a year without it: Adar for
// the Hebrew Adar I, and the month with the same number for a Chinese or Dangi leap month.
fn monthOfConstrained(kind: i32, year: i64, code: Code) -> i64 {
  let found = monthOf(kind, year, code)
  if found != 0 {
    return found
  }
  if kind == K_HEBREW {
    return 6
  }
  return monthOf(kind, year, Code { number: code.number, leap: false })
}

fn dayOf(kind: i32, year: i64, month: i64, day: i64) -> i64 {
  return yearStart(kind, year) + daysBefore(kind, year, month) + day - 1
}

fn resolve(kind: i32, year: i64, month: i64, day: i64, overflow: Overflow) -> Result<CalendarDate, CalendarError> {
  if !hasYear(kind, year) {
    return Result<CalendarDate, CalendarError>.failResult(CalendarError.OutOfRange)
  }
  let months = monthsIn(kind, year)
  let mut reachedMonth = month
  if month < 1 {
    return Result<CalendarDate, CalendarError>.failResult(CalendarError.NoSuchMonth)
  }
  if month > months {
    match overflow {
      Overflow.Constrain => {
        reachedMonth = months
      }
      Overflow.Reject => {
        return Result<CalendarDate, CalendarError>.failResult(CalendarError.NoSuchMonth)
      }
    }
  }
  let length = monthLength(kind, year, reachedMonth)
  let mut reachedDay = day
  if day < 1 {
    return Result<CalendarDate, CalendarError>.failResult(CalendarError.NoSuchDay)
  }
  if day > length {
    match overflow {
      Overflow.Constrain => {
        reachedDay = length
      }
      Overflow.Reject => {
        return Result<CalendarDate, CalendarError>.failResult(CalendarError.NoSuchDay)
      }
    }
  }
  match PlainDate.fromEpochDays(dayOf(kind, year, reachedMonth, reachedDay)) {
    Option<PlainDate>.Some { value } => {
      return Result<CalendarDate, CalendarError>.succeed(
        CalendarDate {
          system: calendarOfKind(kind),
          iso: value,
          fieldYear: i64.toI32(year),
          fieldMonth: i64.toU8(reachedMonth),
          fieldDay: i64.toU8(reachedDay),
        },
      )
    }
    Option<PlainDate>.None => {
      return Result<CalendarDate, CalendarError>.failResult(CalendarError.OutOfRange)
    }
  }
}

// The year and the month that `month` names when it counts on from `year` past the ends of the
// years, or `None` outside the years of the calendar.
fn balance(kind: i32, year: i64, month: i64) -> Option<Fields> {
  let mut reachedYear = year
  let mut reachedMonth = month
  if !hasYear(kind, reachedYear) {
    return Option<Fields>.none()
  }
  while reachedMonth > monthsIn(kind, reachedYear) {
    reachedMonth = reachedMonth - monthsIn(kind, reachedYear)
    reachedYear = reachedYear + 1
    if !hasYear(kind, reachedYear) {
      return Option<Fields>.none()
    }
  }
  while reachedMonth < 1 {
    reachedYear = reachedYear - 1
    if !hasYear(kind, reachedYear) {
      return Option<Fields>.none()
    }
    reachedMonth = reachedMonth + monthsIn(kind, reachedYear)
  }
  return Option<Fields>.some(Fields { year: reachedYear, month: reachedMonth, day: 1 })
}

fn compareFields(y1: i64, m1: i64, d1: i64, y2: i64, m2: i64, d2: i64) -> i64 {
  if y1 != y2 {
    if y1 < y2 {
      return -1
    }
    return 1
  }
  if m1 != m2 {
    if m1 < m2 {
      return -1
    }
    return 1
  }
  if d1 != d2 {
    if d1 < d2 {
      return -1
    }
    return 1
  }
  return 0
}

fn compareCodes(y1: i64, c1: Code, d1: i64, y2: i64, c2: Code, d2: i64) -> i64 {
  if y1 != y2 {
    if y1 < y2 {
      return -1
    }
    return 1
  }
  if c1.number != c2.number {
    if c1.number < c2.number {
      return -1
    }
    return 1
  }
  if c1.leap != c2.leap {
    if c1.leap {
      return 1
    }
    return -1
  }
  return compareFields(0, 0, d1, 0, 0, d2)
}

fn japaneseEra(year: i32, month: u8, day: u8) -> i32 {
  if year <= 0 {
    return 1
  }
  if year < 1873 {
    return 0
  }
  if year < 1912 || (year == 1912 && (month < 7 || (month == 7 && day < 30))) {
    return 11
  }
  if year < 1926 || (year == 1926 && (month < 12 || day < 25)) {
    return 12
  }
  if year < 1989 || (year == 1989 && month == 1 && day < 8) {
    return 13
  }
  if year < 2019 || (year == 2019 && month < 5) {
    return 14
  }
  return 15
}

// The ISO 8601 year before year 1 of a Japanese era.
fn japaneseOffset(era: i32) -> i64 {
  return match era {
    11 => 1867
    12 => 1911
    13 => 1925
    14 => 1988
    15 => 2018
    _ => 0
  }
}

// The index of the era of a date, or -1 for a calendar without eras.
fn eraOf(kind: i32, date: PlainDate, year: i64) -> i32 {
  if kind == K_GREGORY {
    if date.year() >= 1 {
      return 0
    }
    return 1
  }
  if kind == K_BUDDHIST {
    return 2
  }
  if kind == K_ROC {
    if date.year() >= 1912 {
      return 9
    }
    return 10
  }
  if kind == K_JAPANESE {
    return japaneseEra(date.year(), date.month(), date.day())
  }
  if kind == K_COPTIC || kind == K_HEBREW {
    return 3
  }
  if kind == K_ETHIOPIC {
    if year >= 1 {
      return 3
    }
    return 4
  }
  if kind == K_ETHIOAA {
    return 4
  }
  if kind == K_INDIAN {
    return 5
  }
  if kind == K_PERSIAN {
    return 6
  }
  if islamic(kind) {
    if year >= 1 {
      return 7
    }
    return 8
  }
  return -1
}

fn eraYearOf(kind: i32, era: i32, date: PlainDate, year: i64) -> i64 {
  let isoYear = i32.toI64(date.year())
  if kind == K_GREGORY || kind == K_JAPANESE {
    if era == 1 {
      return 1 - isoYear
    }
    return isoYear - japaneseOffset(era)
  }
  if kind == K_ROC {
    if era == 10 {
      return 1912 - isoYear
    }
    return isoYear - 1911
  }
  if kind == K_ETHIOPIC && era == 4 {
    return year + 5500
  }
  if era == 8 {
    return 1 - year
  }
  return year
}

fn writeCode(output: &mut [u8], at: usize, code: MonthCode) -> usize {
  output[at] = 77
  output[at + 1] = 48 + code.number / 10 % 10
  output[at + 2] = 48 + code.number % 10
  if code.leap {
    output[at + 3] = 76
    return at + 4
  }
  return at + 3
}

fn publicCode(code: Code) -> MonthCode {
  return MonthCode { number: i64.toU8(code.number), leap: code.leap }
}

fn privateCode(code: MonthCode) -> Code {
  return Code { number: u8.toI64(code.number), leap: code.leap }
}

fn refuse(error: CalendarError) -> Result<CalendarDate, CalendarError> {
  return Result<CalendarDate, CalendarError>.failResult(error)
}

fn parseFail(reason: TimeParseReason, offset: usize) -> Result<CalendarDate, TimeParseError> {
  return Result<CalendarDate, TimeParseError>.failResult(
    TimeParseError { reason: reason, offset: offset },
  )
}

impl Calendar {
  /// Returns the calendar with the given identifier, such as `hebrew`, in any letter case, or
  /// `None` for a name that is not one of the 16 calendars.
  ///
  /// # Details
  ///
  /// `ethiopic-amete-alem` is another name of `ethioaa`, and `islamicc` of `islamic-civil`.
  pub fn named(name: string) -> Option<Calendar> {
    return Calendar.namedBytes(String.utf8Bytes(name))
  }

  /// Returns the calendar with the identifier in `name`, such as `hebrew`, in any letter case, or
  /// `None` for a name that is not one of the 16 calendars.
  pub fn namedBytes(name: &[u8]) -> Option<Calendar> {
    let mut kind: i32 = 0
    while kind < 16 {
      if sameName(name, calendarName(kind)) {
        return Option<Calendar>.some(calendarOfKind(kind))
      }
      kind = kind + 1
    }
    if sameName(name, b"ethiopic-amete-alem") {
      return Option<Calendar>.some(Calendar.EthiopicAmeteAlem)
    }
    if sameName(name, b"islamicc") {
      return Option<Calendar>.some(Calendar.IslamicCivil)
    }
    return Option<Calendar>.none()
  }

  /// Returns the identifier of the calendar, such as `hebrew` or `islamic-umalqura`.
  pub fn name(self: Self) -> string<'static> {
    return unsafe Intrinsic.stringFromUtf8Unchecked(calendarName(kindOf(self)))
  }

  /// Returns the number of months in `year`, or `None` when the calendar has no data for the
  /// year.
  ///
  /// # Details
  ///
  /// It is 12 in most calendars, 13 in the Coptic and Ethiopic calendars, and 12 or 13 in the
  /// Hebrew, Chinese, and Dangi calendars.
  pub fn monthsInYear(self: Self, year: i32) -> Option<u8> {
    let kind = kindOf(self)
    if !hasYear(kind, i32.toI64(year)) {
      return Option<u8>.none()
    }
    return Option<u8>.some(i64.toU8(monthsIn(kind, i32.toI64(year))))
  }

  /// Returns the number of days in the month with the number `month` in `year`, or `None` when
  /// the year has no such month or the calendar has no data for the year.
  pub fn daysInMonth(self: Self, year: i32, month: u8) -> Option<u8> {
    let kind = kindOf(self)
    let wide = i32.toI64(year)
    if !hasYear(kind, wide) || month < 1 || u8.toI64(month) > monthsIn(kind, wide) {
      return Option<u8>.none()
    }
    return Option<u8>.some(i64.toU8(monthLength(kind, wide, u8.toI64(month))))
  }

  /// Returns the number of days in `year`, or `None` when the calendar has no data for the year.
  pub fn daysInYear(self: Self, year: i32) -> Option<u16> {
    let kind = kindOf(self)
    if !hasYear(kind, i32.toI64(year)) {
      return Option<u16>.none()
    }
    return Option<u16>.some(i64.toU16(yearLength(kind, i32.toI64(year))))
  }

  /// Returns `true` when `year` is longer than a common year of the calendar, or `None` when the
  /// calendar has no data for the year.
  ///
  /// # Details
  ///
  /// A leap year has a 13th month in the Hebrew, Chinese, and Dangi calendars, and one more day
  /// in the others.
  pub fn isLeapYear(self: Self, year: i32) -> Option<bool> {
    let kind = kindOf(self)
    let wide = i32.toI64(year)
    if !hasYear(kind, wide) {
      return Option<bool>.none()
    }
    if kind == K_HEBREW || lunar(kind) {
      return Option<bool>.some(monthsIn(kind, wide) == 13)
    }
    let length = yearLength(kind, wide)
    return Option<bool>.some(length == 366 || length == 355)
  }

  /// Returns the code of the month with the number `month` in `year`, or `None` when the year has
  /// no such month or the calendar has no data for the year.
  pub fn monthCode(self: Self, year: i32, month: u8) -> Option<MonthCode> {
    let kind = kindOf(self)
    let wide = i32.toI64(year)
    if !hasYear(kind, wide) || month < 1 || u8.toI64(month) > monthsIn(kind, wide) {
      return Option<MonthCode>.none()
    }
    return Option<MonthCode>.some(publicCode(codeOf(kind, wide, u8.toI64(month))))
  }

  /// Returns the number in `year` of the month with the code `code`, or `None` when the year has
  /// no month with that code or the calendar has no data for the year.
  pub fn monthOfCode(self: Self, year: i32, code: MonthCode) -> Option<u8> {
    let kind = kindOf(self)
    let wide = i32.toI64(year)
    if !hasYear(kind, wide) || !validCode(kind, privateCode(code)) {
      return Option<u8>.none()
    }
    let month = monthOf(kind, wide, privateCode(code))
    if month == 0 {
      return Option<u8>.none()
    }
    return Option<u8>.some(i64.toU8(month))
  }

  /// Returns `true` when the dates of the calendar have an era.
  pub fn hasEras(self: Self) -> bool {
    let kind = kindOf(self)
    return kind != K_ISO && !lunar(kind)
  }

  /// Returns the year that `eraYear` of `era` is in the calendar, or `None` when `era` is not an
  /// era of the calendar.
  ///
  /// # Details
  ///
  /// The result is the year that [`CalendarDate.year`] returns and [`CalendarDate.fromFields`]
  /// takes. Year 1 of an era that counts back, such as `bce`, is year 0.
  ///
  /// `ad` and `bc` are not separate eras: use `Era.Ce` and `Era.Bce`.
  pub fn yearOfEra(self: Self, era: Era, eraYear: i32) -> Option<i32> {
    let kind = kindOf(self)
    let index = eraIndex(era)
    let count = i32.toI64(eraYear)
    let mut year = count
    let mut valid = false
    if kind == K_GREGORY || kind == K_JAPANESE {
      valid = index <= 1 || (kind == K_JAPANESE && index >= 11)
      if index == 1 {
        year = 1 - count
      } else {
        year = count + japaneseOffset(index)
      }
    } else if kind == K_ROC {
      valid = index == 9 || index == 10
      if index == 10 {
        year = 1 - count
      }
    } else if kind == K_ETHIOPIC {
      valid = index == 3 || index == 4
      if index == 4 {
        year = count - 5500
      }
    } else if islamic(kind) {
      valid = index == 7 || index == 8
      if index == 8 {
        year = 1 - count
      }
    } else {
      valid = (kind == K_BUDDHIST && index == 2) || ((kind == K_COPTIC || kind == K_HEBREW) && index == 3)
        || (kind == K_ETHIOAA && index == 4)
        || (kind == K_INDIAN && index == 5)
        || (kind == K_PERSIAN && index == 6)
    }
    if !valid || year < -YEAR_LIMIT || year > YEAR_LIMIT {
      return Option<i32>.none()
    }
    return Option<i32>.some(i64.toI32(year))
  }

  /// Returns the ISO 8601 date that stands for a month and a day of the calendar without a year,
  /// or `None` when no year has that day, or the overflow rule is `Overflow.Reject` and the day
  /// does not exist as given.
  ///
  /// # Details
  ///
  /// This is the reference date of an ECMAScript `Temporal.PlainMonthDay`. For the calendars with
  /// the ISO 8601 months it is in 1972. For the others it is the last day with that month code
  /// and day at or before the end of 1972, except a few days that need an earlier or a later
  /// year. With `Overflow.Constrain`, a day past the longest form of the month becomes its last
  /// day, and a leap month that no year has with that day becomes the common month.
  pub fn monthDayReference(self: Self, code: MonthCode, day: u8, overflow: Overflow) -> Option<PlainDate> {
    let kind = kindOf(self)
    let constrain = match overflow {
      Overflow.Constrain => true
      Overflow.Reject => false
    }
    let mut wanted = privateCode(code)
    let mut wantedDay = u8.toI64(day)
    if !validCode(kind, wanted) || wantedDay < 1 {
      return Option<PlainDate>.none()
    }
    if isoBased(kind) {
      let length = u8.toI64(Civil.daysInMonth(1972, code.number))
      if wantedDay > length {
        if !constrain {
          return Option<PlainDate>.none()
        }
        wantedDay = length
      }
      return PlainDate.checkedMake(1972, code.number, i64.toU8(wantedDay))
    }
    let mut longest: i64 = 30
    if lunar(kind) {
      if wanted.leap {
        let number = wanted.number
        if number == 1 || number == 12 || (wantedDay >= 30 && (number == 2 || (number >= 8 && number <= 11))) {
          if !constrain {
            return Option<PlainDate>.none()
          }
          wanted = Code { number: number, leap: false }
        } else {
          // The years of the table in the order of preference: 1972 back to 1900, then 1973 on,
          // then 1899 back to 1800.
          let mut bestLength: i64 = 0
          let mut bestYear: i64 = 1972
          let mut phase: i32 = 0
          while phase < 3 {
            let mut year: i64 = 1972
            if phase == 1 {
              year = 1973
            } else if phase == 2 {
              year = 1899
            }
            let mut more = true
            while more {
              let entry = lunarEntry(kind, year)
              if (phase == 0 && year < 1900) || entry < 0 {
                more = false
              } else {
                if lunarLeap(entry) == number {
                  let length = monthLength(kind, year, number + 1)
                  if length >= wantedDay {
                    return PlainDate.fromEpochDays(dayOf(kind, year, number + 1, wantedDay))
                  }
                  if length > bestLength {
                    bestLength = length
                    bestYear = year
                  }
                }
                if phase == 1 {
                  year = year + 1
                } else {
                  year = year - 1
                }
              }
            }
            phase = phase + 1
          }
          if !constrain {
            return Option<PlainDate>.none()
          }
          if bestLength >= 30 {
            return PlainDate.fromEpochDays(dayOf(kind, bestYear, number + 1, bestLength))
          }
          wanted = Code { number: number, leap: false }
        }
      }
    } else if kind == K_HEBREW {
      if !wanted.leap && wanted.number != 1 && wanted.number != 2 && wanted.number != 3 && wanted.number % 2 == 0 {
        longest = 29
      }
    } else if kind == K_CIVIL || kind == K_TABULAR {
      if wanted.number != 12 && wanted.number % 2 == 0 {
        longest = 29
      }
    } else if kind == K_PERSIAN || kind == K_INDIAN {
      if wanted.number <= 6 {
        longest = 31
      }
    } else if copticFamily(kind) {
      if wanted.number == 13 {
        longest = 6
      }
    }
    if wantedDay > longest {
      if !constrain {
        return Option<PlainDate>.none()
      }
      wantedDay = longest
    }
    let mut referenceYear: i32 = 1972
    if kind == K_HEBREW {
      if wanted.leap {
        referenceYear = 1970
      } else if (wanted.number == 2 || wanted.number == 3) && wantedDay == 30 {
        referenceYear = 1971
      }
    } else if (kind == K_CIVIL || kind == K_TABULAR) && wanted.number == 12 && wantedDay == 30 {
      referenceYear = 1971
    }
    match fieldsOfDay(kind, Civil.daysFromCivil(referenceYear, 12, 31)) {
      Option<Fields>.Some { value } => {
        let last = codeOf(kind, value.year, value.month)
        let mut year = value.year - 1
        if compareCodes(0, last, value.day, 0, wanted, wantedDay) >= 0 {
          year = value.year
        }
        let stop = year - 5000
        while year >= stop && year >= 1 && hasYear(kind, year) {
          let month = monthOf(kind, year, wanted)
          if month != 0 && wantedDay <= monthLength(kind, year, month) {
            return PlainDate.fromEpochDays(dayOf(kind, year, month, wantedDay))
          }
          year = year - 1
        }
        return Option<PlainDate>.none()
      }
      Option<Fields>.None => {
        return Option<PlainDate>.none()
      }
    }
  }

  fn same(left: &Calendar, right: &Calendar) -> bool {
    return kindOf(left.*) == kindOf(right.*)
  }
}

impl Equal for Calendar {
  equals: Calendar.same
}

/// Writes the identifier of the calendar, such as `hebrew`.
impl Display for Calendar {
  effect fn display(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return run Format.write(&mut formatter, calendarName(kindOf(self.*)))
  }
}

/// Writes the same text as `Display`: the identifier of the calendar.
impl Debug for Calendar {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return run Format.write(&mut formatter, calendarName(kindOf(self.*)))
  }
}

impl Era {
  /// Returns the era with the given code, such as `ce` or `reiwa`, in any letter case, or `None`
  /// for a name that is not an era code. `ad` is `Era.Ce` and `bc` is `Era.Bce`.
  pub fn named(name: string) -> Option<Era> {
    let bytes = String.utf8Bytes(name)
    let mut index: i32 = 0
    while index < 16 {
      if sameName(bytes, eraName(index)) {
        return Option<Era>.some(eraOfIndex(index))
      }
      index = index + 1
    }
    if sameName(bytes, b"ad") {
      return Option<Era>.some(Era.Ce)
    }
    if sameName(bytes, b"bc") {
      return Option<Era>.some(Era.Bce)
    }
    return Option<Era>.none()
  }

  /// Returns the code of the era, such as `ce` or `reiwa`.
  pub fn name(self: Self) -> string<'static> {
    return unsafe Intrinsic.stringFromUtf8Unchecked(eraName(eraIndex(self)))
  }

  fn same(left: &Era, right: &Era) -> bool {
    return eraIndex(left.*) == eraIndex(right.*)
  }
}

impl Equal for Era {
  equals: Era.same
}

/// Writes the code of the era, such as `ce`.
impl Display for Era {
  effect fn display(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return run Format.write(&mut formatter, eraName(eraIndex(self.*)))
  }
}

/// Writes the same text as `Display`: the code of the era.
impl Debug for Era {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return run Format.write(&mut formatter, eraName(eraIndex(self.*)))
  }
}

impl Debug for CalendarError {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return match &self.* {
      CalendarError.OutOfRange => run Format.write(&mut formatter, b"OutOfRange")
      CalendarError.NoSuchMonth => run Format.write(&mut formatter, b"NoSuchMonth")
      CalendarError.NoSuchDay => run Format.write(&mut formatter, b"NoSuchDay")
      CalendarError.NoSuchEra => run Format.write(&mut formatter, b"NoSuchEra")
      CalendarError.CalendarMismatch => run Format.write(&mut formatter, b"CalendarMismatch")
    }
  }
}

impl MonthCode {
  /// Returns the month code with the given number and leap mark. It does not check that a
  /// calendar has such a month.
  pub fn make(number: u8, leap: bool) -> MonthCode {
    return MonthCode { number: number, leap: leap }
  }

  /// Reads a month code such as `M05` or `M05L`: the letter `M`, two digits, and `L` for a leap
  /// month. Returns `None` for any other text, and for `M00`.
  pub fn parse(text: string) -> Option<MonthCode> {
    let bytes = String.utf8Bytes(text)
    if bytes.length != 3 && bytes.length != 4 {
      return Option<MonthCode>.none()
    }
    if bytes[0] != 77 || bytes[1] < 48 || bytes[1] > 57 || bytes[2] < 48 || bytes[2] > 57 {
      return Option<MonthCode>.none()
    }
    if bytes.length == 4 && bytes[3] != 76 {
      return Option<MonthCode>.none()
    }
    let number = (bytes[1] - 48) * 10 + (bytes[2] - 48)
    if number == 0 {
      return Option<MonthCode>.none()
    }
    return Option<MonthCode>.some(MonthCode { number: number, leap: bytes.length == 4 })
  }

  fn same(left: &MonthCode, right: &MonthCode) -> bool {
    return left.number == right.number && left.leap == right.leap
  }
}

impl Equal for MonthCode {
  equals: MonthCode.same
}

/// Writes the code as `M`, two digits, and `L` for a leap month, as in `M05L`.
impl Display for MonthCode {
  effect fn display(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    let mut output: [u8; 4] = [0; 4]
    let length = writeCode(&mut output, 0, self.*)
    return run Format.write(&mut formatter, Slice.view<u8>(&output, 0, length))
  }
}

/// Writes the same text as `Display`, such as `M05L`.
impl Debug for MonthCode {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return run Display.display(self, &mut formatter)
  }
}

impl CalendarDate {
  /// Returns `date` in `calendar`.
  ///
  /// # Errors
  ///
  /// - `CalendarError.OutOfRange` if the calendar has no data for the date. Only `Chinese` and
  ///   `Dangi` have a limit: 1800-01-25 to 2201-02-03.
  pub fn of(calendar: Calendar, date: PlainDate) -> Result<CalendarDate, CalendarError> {
    match fieldsOfDay(kindOf(calendar), date.toEpochDays()) {
      Option<Fields>.Some { value } => {
        return Result<CalendarDate, CalendarError>.succeed(
          CalendarDate {
            system: calendar,
            iso: date,
            fieldYear: i64.toI32(value.year),
            fieldMonth: i64.toU8(value.month),
            fieldDay: i64.toU8(value.day),
          },
        )
      }
      Option<Fields>.None => {
        return refuse(CalendarError.OutOfRange)
      }
    }
  }

  /// Returns the date with the given year, number of the month in the year, and day of the month.
  ///
  /// # Details
  ///
  /// `year` is the year that [`CalendarDate.year`] returns. For a year of an era, convert it with
  /// [`Calendar.yearOfEra`] first. `month` counts the months of that year from 1, so in a leap
  /// year of a calendar with leap months it is not the number in the month code.
  ///
  /// # Errors
  ///
  /// - `CalendarError.NoSuchMonth` if `month` is 0, or the year has fewer months and `overflow`
  ///   is `Overflow.Reject`. With `Overflow.Constrain` the last month is used.
  /// - `CalendarError.NoSuchDay` if `day` is 0, or the month has fewer days and `overflow` is
  ///   `Overflow.Reject`. With `Overflow.Constrain` the last day is used.
  /// - `CalendarError.OutOfRange` if the date is outside the range of `PlainDate` or the calendar
  ///   has no data for the year.
  pub fn fromFields(calendar: Calendar, year: i32, month: u8, day: u8, overflow: Overflow) -> Result<CalendarDate, CalendarError> {
    return resolve(kindOf(calendar), i32.toI64(year), u8.toI64(month), u8.toI64(day), overflow)
  }

  /// Returns the date with the given year, month code, and day of the month.
  ///
  /// # Details
  ///
  /// With `Overflow.Constrain`, a leap month in a year without it becomes the month that takes
  /// its place: Adar (`M06`) for the Hebrew `M05L`, and the month with the same number for a
  /// Chinese or Dangi leap month.
  ///
  /// # Errors
  ///
  /// - `CalendarError.NoSuchMonth` if no year of the calendar has a month with that code, or
  ///   this year does not have it and `overflow` is `Overflow.Reject`.
  /// - `CalendarError.NoSuchDay` if `day` is 0, or the month has fewer days and `overflow` is
  ///   `Overflow.Reject`.
  /// - `CalendarError.OutOfRange` if the date is outside the range of `PlainDate` or the calendar
  ///   has no data for the year.
  pub fn fromMonthCode(calendar: Calendar, year: i32, code: MonthCode, day: u8, overflow: Overflow) -> Result<CalendarDate, CalendarError> {
    let kind = kindOf(calendar)
    let wide = i32.toI64(year)
    let wanted = privateCode(code)
    if !validCode(kind, wanted) {
      return refuse(CalendarError.NoSuchMonth)
    }
    if !hasYear(kind, wide) {
      return refuse(CalendarError.OutOfRange)
    }
    let mut month = monthOf(kind, wide, wanted)
    if month == 0 {
      match overflow {
        Overflow.Constrain => {
          month = monthOfConstrained(kind, wide, wanted)
        }
        Overflow.Reject => {
          return refuse(CalendarError.NoSuchMonth)
        }
      }
    }
    return resolve(kind, wide, month, u8.toI64(day), overflow)
  }

  /// Returns the calendar of the date.
  pub fn calendar(self: Self) -> Calendar {
    return self.system
  }

  /// Returns the same day in the ISO 8601 calendar.
  pub fn date(self: Self) -> PlainDate {
    return self.iso
  }

  /// Returns the same day in `calendar`.
  ///
  /// # Errors
  ///
  /// - `CalendarError.OutOfRange` if the calendar has no data for the day.
  pub fn withCalendar(self: Self, calendar: Calendar) -> Result<CalendarDate, CalendarError> {
    return CalendarDate.of(calendar, self.iso)
  }

  /// Returns the year, counted on one line through all eras. It can be zero or negative.
  ///
  /// # Details
  ///
  /// It is the year of the main era of the calendar where that era applies: the ISO 8601 year for
  /// `gregory` and `japanese`, the year of the Hijra for the Islamic calendars. For `chinese` and
  /// `dangi`, which do not number their years, it is the ISO 8601 year in which the year starts.
  pub fn year(self: Self) -> i32 {
    return self.fieldYear
  }

  /// Returns the number of the month in its year, from 1.
  pub fn month(self: Self) -> u8 {
    return self.fieldMonth
  }

  /// Returns the code of the month, which is the same in every year.
  pub fn monthCode(self: Self) -> MonthCode {
    return publicCode(codeOf(kindOf(self.system), i32.toI64(self.fieldYear), u8.toI64(self.fieldMonth)))
  }

  /// Returns the day of the month, from 1.
  pub fn day(self: Self) -> u8 {
    return self.fieldDay
  }

  /// Returns the era of the date, or `None` for `iso8601`, `chinese`, and `dangi`, which have no
  /// eras.
  pub fn era(self: Self) -> Option<Era> {
    let index = eraOf(kindOf(self.system), self.iso, i32.toI64(self.fieldYear))
    if index < 0 {
      return Option<Era>.none()
    }
    return Option<Era>.some(eraOfIndex(index))
  }

  /// Returns the year in the era of the date, or `None` for a calendar without eras.
  pub fn eraYear(self: Self) -> Option<i32> {
    let kind = kindOf(self.system)
    let index = eraOf(kind, self.iso, i32.toI64(self.fieldYear))
    if index < 0 {
      return Option<i32>.none()
    }
    return Option<i32>.some(i64.toI32(eraYearOf(kind, index, self.iso, i32.toI64(self.fieldYear))))
  }

  /// Returns the day of the year, from 1.
  pub fn dayOfYear(self: Self) -> u16 {
    let kind = kindOf(self.system)
    return i64.toU16(self.iso.toEpochDays() - yearStart(kind, i32.toI64(self.fieldYear)) + 1)
  }

  /// Returns the number of days in the month of the date.
  pub fn daysInMonth(self: Self) -> u8 {
    return i64.toU8(monthLength(kindOf(self.system), i32.toI64(self.fieldYear), u8.toI64(self.fieldMonth)))
  }

  /// Returns the number of days in the year of the date.
  pub fn daysInYear(self: Self) -> u16 {
    return i64.toU16(yearLength(kindOf(self.system), i32.toI64(self.fieldYear)))
  }

  /// Returns the number of months in the year of the date.
  pub fn monthsInYear(self: Self) -> u8 {
    return i64.toU8(monthsIn(kindOf(self.system), i32.toI64(self.fieldYear)))
  }

  /// Returns `true` when the year of the date is a leap year of the calendar: a year with a 13th
  /// month in the Hebrew, Chinese, and Dangi calendars, and a year with one more day in the
  /// others.
  pub fn inLeapYear(self: Self) -> bool {
    let kind = kindOf(self.system)
    let year = i32.toI64(self.fieldYear)
    if kind == K_HEBREW || lunar(kind) {
      return monthsIn(kind, year) == 13
    }
    let length = yearLength(kind, year)
    return length == 366 || length == 355
  }

  /// Returns the date that `period` leads to from this date, counted in the calendar.
  ///
  /// # Details
  ///
  /// The years are added first and keep the month code: one year after Nisan is Nisan. Then the
  /// months are added by counting months of the calendar through the years. If the month reached
  /// has no such day, `Overflow.Constrain` uses its last day. Then the weeks and the days are
  /// added, with the whole days of the time part of the period. This is the rule of ECMAScript
  /// Temporal.
  ///
  /// With `Overflow.Constrain`, a leap month that the year reached does not have becomes the
  /// month that takes its place, as in [`CalendarDate.fromMonthCode`].
  ///
  /// # Errors
  ///
  /// - `CalendarError.NoSuchMonth` or `NoSuchDay` if `overflow` is `Overflow.Reject` and the
  ///   month or the day does not exist in the year or the month reached.
  /// - `CalendarError.OutOfRange` if the result is outside the range of `PlainDate` or the
  ///   calendar has no data for it.
  pub fn checkedAdd(self: Self, period: Period, overflow: Overflow) -> Result<CalendarDate, CalendarError> {
    let kind = kindOf(self.system)
    if isoBased(kind) {
      match self.iso.checkedAddPeriod(period, overflow) {
        Option<PlainDate>.Some { value } => {
          return CalendarDate.of(self.system, value)
        }
        Option<PlainDate>.None => {
          match self.iso.checkedAddPeriod(period, Overflow.Constrain) {
            Option<PlainDate>.Some {..} => {
              return refuse(CalendarError.NoSuchDay)
            }
            Option<PlainDate>.None => {
              return refuse(CalendarError.OutOfRange)
            }
          }
        }
      }
    }
    if period.years() < -YEAR_LIMIT * 2 || period.years() > YEAR_LIMIT * 2 || period.months() < -MONTH_LIMIT
      || period.months() > MONTH_LIMIT {
      return refuse(CalendarError.OutOfRange)
    }
    let mut year = i32.toI64(self.fieldYear) + period.years()
    let mut month = u8.toI64(self.fieldMonth)
    if !hasYear(kind, year) {
      return refuse(CalendarError.OutOfRange)
    }
    if period.years() != 0 {
      let code = codeOf(kind, i32.toI64(self.fieldYear), month)
      month = monthOf(kind, year, code)
      if month == 0 {
        match overflow {
          Overflow.Constrain => {
            month = monthOfConstrained(kind, year, code)
          }
          Overflow.Reject => {
            return refuse(CalendarError.NoSuchMonth)
          }
        }
      }
    }
    if period.months() != 0 {
      match balance(kind, year, month + period.months()) {
        Option<Fields>.Some { value } => {
          year = value.year
          month = value.month
        }
        Option<Fields>.None => {
          return refuse(CalendarError.OutOfRange)
        }
      }
    }
    let mut day = u8.toI64(self.fieldDay)
    let length = monthLength(kind, year, month)
    if day > length {
      match overflow {
        Overflow.Constrain => {
          day = length
        }
        Overflow.Reject => {
          return refuse(CalendarError.NoSuchDay)
        }
      }
    }
    let seconds = period.time().absolute().wholeSeconds() / 86400
    let timeDays = if period.time().sign() < 0 { -seconds } else { seconds }
    match PlainDate.fromEpochDays(dayOf(kind, year, month, day) + period.weeks() * 7 + period.days() + timeDays) {
      Option<PlainDate>.Some { value } => {
        return CalendarDate.of(self.system, value)
      }
      Option<PlainDate>.None => {
        return refuse(CalendarError.OutOfRange)
      }
    }
  }

  /// Returns the span from this date to `other`, counted in the calendar in `largest` units
  /// first. It is negative when `other` is earlier, and its time part is empty.
  ///
  /// # Details
  ///
  /// With `DateUnit.Year`, the result has the most whole years that can be added to this date
  /// without passing `other`, then the most whole months, then the days that are left. With
  /// `DateUnit.Month` it has months and days, with `DateUnit.Week` weeks and days, and with
  /// `DateUnit.Day` only days. Adding the result to this date with [`CalendarDate.checkedAdd`]
  /// gives `other`. This is the rule of ECMAScript Temporal.
  ///
  /// # Errors
  ///
  /// - `CalendarError.CalendarMismatch` if `other` is in another calendar. Convert one of the
  ///   dates with [`CalendarDate.withCalendar`] first.
  pub fn until(self: Self, other: CalendarDate, largest: DateUnit) -> Result<Period, CalendarError> {
    let kind = kindOf(self.system)
    if kind != kindOf(other.system) {
      return Result<Period, CalendarError>.failResult(CalendarError.CalendarMismatch)
    }
    if isoBased(kind) {
      return Result<Period, CalendarError>.succeed(self.iso.periodUntil(other.iso, largest))
    }
    let total = other.iso.toEpochDays() - self.iso.toEpochDays()
    let mut wantYears = false
    let mut wantMonths = false
    let mut wantWeeks = false
    match largest {
      DateUnit.Year => {
        wantYears = true
        wantMonths = true
      }
      DateUnit.Month => {
        wantMonths = true
      }
      DateUnit.Week => {
        wantWeeks = true
      }
      DateUnit.Day => {}
    }
    if total == 0 || !wantMonths {
      if wantWeeks {
        return Result<Period, CalendarError>.succeed(Period.make(0, 0, total / 7, total % 7, Duration.zero()))
      }
      return Result<Period, CalendarError>.succeed(Period.ofDays(total))
    }
    let sign: i64 = if total > 0 { 1 } else { -1 }
    let startYear = i32.toI64(self.fieldYear)
    let startDay = u8.toI64(self.fieldDay)
    let startCode = codeOf(kind, startYear, u8.toI64(self.fieldMonth))
    let endYear = i32.toI64(other.fieldYear)
    let endMonth = u8.toI64(other.fieldMonth)
    let endDay = u8.toI64(other.fieldDay)
    let endCode = codeOf(kind, endYear, endMonth)
    let mut years: i64 = 0
    let mut year = startYear
    let mut month = u8.toI64(self.fieldMonth)
    if wantYears {
      years = endYear - startYear
      if compareCodes(0, endCode, endDay, 0, startCode, startDay) * sign < 0 {
        years = years - sign
      }
      if years != 0 {
        let reached = monthOfConstrained(kind, startYear + years, startCode)
        let order = compareFields(startYear + years, reached, startDay, endYear, endMonth, endDay)
        if order * sign > 0 {
          years = years - sign
        }
      }
      year = startYear + years
      month = monthOfConstrained(kind, year, startCode)
    }
    let mut months: i64 = 0
    let mut more = true
    while more {
      if sign > 0 && year + 1 < endYear && month <= 12 {
        months = months + monthsIn(kind, year)
        year = year + 1
      } else if sign < 0 && year - 1 > endYear && month <= 12 {
        months = months + monthsIn(kind, year - 1)
        year = year - 1
      } else {
        match balance(kind, year, month + sign) {
          Option<Fields>.Some { value } => {
            let code = codeOf(kind, value.year, value.month)
            if compareCodes(value.year, code, startDay, endYear, endCode, endDay) * sign > 0 {
              more = false
            } else {
              months = months + 1
              year = value.year
              month = value.month
            }
          }
          Option<Fields>.None => {
            more = false
          }
        }
      }
    }
    let mut day = startDay
    let length = monthLength(kind, year, month)
    if day > length {
      day = length
    }
    let days = other.iso.toEpochDays() - dayOf(kind, year, month, day)
    return Result<Period, CalendarError>.succeed(Period.make(years, months * sign, 0, days, Duration.zero()))
  }

  /// Reads a date with a calendar annotation, such as `2026-11-19[u-ca=hebrew]`.
  ///
  /// # Details
  ///
  /// The text is the one that `PlainDate.parse` reads: the date is always written in the ISO 8601
  /// calendar, and the annotation names the calendar of the result. A text without a calendar
  /// annotation gives a date in `Calendar.Iso8601`.
  ///
  /// # Errors
  ///
  /// - The errors of `PlainDate.parse` for the date.
  /// - `TimeParseReason.UnsupportedCalendar` if the annotation names no calendar of
  ///   [`Calendar`].
  /// - `TimeParseReason.OutOfRange` if the calendar has no data for the date.
  pub fn parse(text: string) -> Result<CalendarDate, TimeParseError> {
    return CalendarDate.parseBytes(String.utf8Bytes(text))
  }

  /// Reads a date with a calendar annotation from the bytes of a text such as
  /// `2026-11-19[u-ca=hebrew]`.
  ///
  /// # Errors
  ///
  /// - The errors of `PlainDate.parseBytes` for the date.
  /// - `TimeParseReason.UnsupportedCalendar` if the annotation names no calendar of
  ///   [`Calendar`].
  /// - `TimeParseReason.OutOfRange` if the calendar has no data for the date.
  pub fn parseBytes(bytes: &[u8]) -> Result<CalendarDate, TimeParseError> {
    let mut scanner = Scanner.make(bytes)
    scanner.allowCalendars()
    let parsed = scanner.dateTime()
    match scanner.failure() {
      Option<TimeParseError>.Some { value } => {
        return Result<CalendarDate, TimeParseError>.failResult(value)
      }
      Option<TimeParseError>.None => {}
    }
    match parsed.offset.kind {
      OffsetKind.Utc => {
        return parseFail(TimeParseReason.UtcNotAllowed, 0)
      }
      _ => {}
    }
    let name = scanner.calendarAnnotation()
    let mut calendar = Calendar.Iso8601
    if name.length != 0 {
      match Calendar.namedBytes(name) {
        Option<Calendar>.Some { value } => {
          calendar = value
        }
        Option<Calendar>.None => {
          return parseFail(TimeParseReason.UnsupportedCalendar, 0)
        }
      }
    }
    match PlainDate.checkedMake(parsed.date.year, parsed.date.month, parsed.date.day) {
      Option<PlainDate>.Some { value } => {
        match fieldsOfDay(kindOf(calendar), value.toEpochDays()) {
          Option<Fields>.Some { value: fields } => {
            return Result<CalendarDate, TimeParseError>.succeed(
              CalendarDate {
                system: calendar,
                iso: value,
                fieldYear: i64.toI32(fields.year),
                fieldMonth: i64.toU8(fields.month),
                fieldDay: i64.toU8(fields.day),
              },
            )
          }
          Option<Fields>.None => {
            return parseFail(TimeParseReason.OutOfRange, 0)
          }
        }
      }
      Option<PlainDate>.None => {
        return parseFail(TimeParseReason.OutOfRange, 0)
      }
    }
  }

  fn same(left: &CalendarDate, right: &CalendarDate) -> bool {
    return kindOf(left.system) == kindOf(right.system) && left.iso.toEpochDays() == right.iso.toEpochDays()
  }
}

impl Equal for CalendarDate {
  equals: CalendarDate.same
}

/// Writes the ISO 8601 date and the calendar annotation, as in `2026-11-19[u-ca=hebrew]`. A date
/// in `Calendar.Iso8601` has no annotation.
impl Display for CalendarDate {
  effect fn display(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    let mut output: [u8; 40] = [0; 40]
    let mut length = Text.writeDate(&mut output, 0, self.iso.toCivil())
    let kind = kindOf(self.system)
    if kind != K_ISO {
      let prefix = b"[u-ca="
      let name = calendarName(kind)
      let mut index: usize = 0
      while index < prefix.length {
        output[length] = prefix[index]
        length = length + 1
        index = index + 1
      }
      index = 0
      while index < name.length {
        output[length] = name[index]
        length = length + 1
        index = index + 1
      }
      output[length] = 93
      length = length + 1
    }
    return run Format.write(&mut formatter, Slice.view<u8>(&output, 0, length))
  }
}

/// Writes the same text as `Display`, such as `2026-11-19[u-ca=hebrew]`.
impl Debug for CalendarDate {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return run Display.display(self, &mut formatter)
  }
}
