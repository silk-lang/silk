//! Periods measured from a starting point: [`RelativeTo`] rounds a `Period`, gives its total in one
//! unit, and changes its largest unit.
//!
//! # When to use
//!
//! Use [`RelativeTo`] for a question about a `Period` whose answer depends on where the period
//! starts: how many months 100 days are, what `P1M45D` is in months and days, or what a period is
//! when rounded to whole weeks. Months and years have different lengths, and in a time zone a day
//! has 23 or 25 hours on the day of a change, so a period alone cannot answer.
//!
//! To round an exact span, use `Duration.round`. To get the period between two dates, use the
//! `periodUntil` function of the date types.
//!
//! # Details
//!
//! A [`RelativeTo`] is a starting point: a `PlainDate`, where every day is 24 hours, or a
//! `ZonedDateTime`, where days have the length that they have in the zone. Each function moves
//! from the starting point by the whole period, as `addPeriod` does, and measures the way to the
//! point reached.
//!
//! The functions follow `Temporal.Duration.prototype.round` and `total` of ECMAScript Temporal
//! with a `relativeTo` option.
//!
//! # Examples
//!
//! ## Count, balance, and round a period from a date
//!
//! ```silk
//! import silk.core.option { Option }
//! import silk.time.period { DateUnit, Period }
//! import silk.time.plain_date { PlainDate }
//! import silk.time.relative { PeriodRounding, RelativeTo }
//! import silk.time.rounding { RoundingMode }
//!
//! pub fn main() -> i32 {
//!   let start = RelativeTo.date(PlainDate.make(2027, 1, 1))
//!   // January has 31 days and February has 28, so 45 days are one and a half months.
//!   if let Option<f64>.Some { value: months } = start.total(Period.ofDays(45), DateUnit.Month) {
//!     if months != 1.5 {
//!       return 1
//!     }
//!   }
//!   if let Option<Period>.Some { value: balanced } = start.balance(Period.ofDays(45), DateUnit.Month) {
//!     if balanced.months() != 1 || balanced.days() != 14 {
//!       return 2
//!     }
//!   }
//!   let toMonths = PeriodRounding.toUnit(DateUnit.Month, RoundingMode.HalfExpand)
//!   if let Option<Period>.Some { value: rounded } = start.round(Period.ofDays(45), toMonths) {
//!     if rounded.months() != 2 || rounded.days() != 0 {
//!       return 3
//!     }
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Time
import silk.core.option { Option }
import silk.core.order { Ordering }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.time.duration { Duration }
import silk.time.instant { Instant }
import silk.time.period { DateUnit, Overflow, Period }
import silk.time.plain_date { PlainDate }
import silk.time.plain_date_time { PlainDateTime }
import silk.time.plain_time { PlainTime }
import silk.time.rounding { RoundingMode, TimeIncrement, TimeUnit }
import silk.time.zone { Disambiguation, LocalTimeError, Zone }
import silk.time.zoned { ZonedDateTime }
import silk.num.i32
import silk.num.i64
import silk.num.u32

// The place of a unit among the units of a period: years first, and the time part last.
const YEAR: i32 = 0
const MONTH: i32 = 1
const WEEK: i32 = 2
const DAY: i32 = 3
const TIME: i32 = 4

/// How [`RelativeTo.round`] rounds a period: the smallest unit or step that stays, the mode, and
/// the largest unit of the result.
///
/// # Details
///
/// [`PeriodRounding.toUnit`] rounds to whole years, months, weeks, or days, and
/// [`PeriodRounding.toStep`] rounds the time part to a step such as 15 minutes.
///
/// Without [`PeriodRounding.upTo`] or [`PeriodRounding.asTime`], the largest unit of the result
/// is the largest unit of the period that is not zero, or the unit that the period is rounded
/// to when that is larger.
pub struct PeriodRounding {
  largest: i32,
  smallest: i32,
  count: u32,
  step: TimeIncrement,
  mode: RoundingMode,
}

impl Copy for PeriodRounding {}

impl PeriodRounding {
  /// Returns the rounding to whole units of `unit`.
  pub fn toUnit(unit: DateUnit, mode: RoundingMode) -> PeriodRounding {
    return PeriodRounding {
      largest: -1,
      smallest: place(unit),
      count: 1,
      step: TimeIncrement.one(TimeUnit.Nanosecond),
      mode: mode,
    }
  }

  /// Returns the rounding of the time part to a multiple of `step`.
  ///
  /// # Details
  ///
  /// A step of one day is the rounding to whole days, as with `toUnit(DateUnit.Day, mode)`.
  /// `TimeIncrement.one(TimeUnit.Nanosecond)` rounds nothing, and is the way to change only the
  /// largest unit.
  pub fn toStep(step: TimeIncrement, mode: RoundingMode) -> PeriodRounding {
    if step.nanoseconds() == TimeIncrement.one(TimeUnit.Day).nanoseconds() {
      return PeriodRounding.toUnit(DateUnit.Day, mode)
    }
    return PeriodRounding { largest: -1, smallest: TIME, count: 1, step: step, mode: mode }
  }

  /// Returns this rounding to a multiple of `count` units, such as every 3 months. It has an
  /// effect only on a rounding from [`PeriodRounding.toUnit`].
  ///
  /// # Gotchas
  ///
  /// A `count` of 0 traps. With a count above 1, the result must have one unit: a rounding
  /// whose largest unit is not the rounded unit has no result, because the larger units would
  /// take parts of the multiple.
  pub fn every(self: Self, count: u32) -> PeriodRounding {
    if count == 0 {
      return Intrinsic.trap("PeriodRounding.every: the count is 0")
    }
    return PeriodRounding {
      largest: self.largest,
      smallest: self.smallest,
      count: count,
      step: self.step,
      mode: self.mode,
    }
  }

  /// Returns this rounding with `largest` as the largest unit of the result.
  ///
  /// # Details
  ///
  /// With `DateUnit.Month`, a result has months, days, and a time part, and no years or weeks.
  /// A largest unit that is smaller than the unit of the rounding has no result.
  pub fn upTo(self: Self, largest: DateUnit) -> PeriodRounding {
    return PeriodRounding {
      largest: place(largest),
      smallest: self.smallest,
      count: self.count,
      step: self.step,
      mode: self.mode,
    }
  }

  /// Returns this rounding with a result that has only a time part: the exact span of the
  /// period from the starting point. It has no result with a rounding from
  /// [`PeriodRounding.toUnit`].
  pub fn asTime(self: Self) -> PeriodRounding {
    return PeriodRounding {
      largest: TIME,
      smallest: self.smallest,
      count: self.count,
      step: self.step,
      mode: self.mode,
    }
  }
}

/// A starting point that periods are measured from.
///
/// # Details
///
/// [`RelativeTo.date`] starts at midnight of a date and counts every day as 24 hours.
/// [`RelativeTo.zoned`] starts at a `ZonedDateTime` and counts days on the calendar of its zone.
///
/// Every function has no result when a date that it needs is outside the range of the date
/// types.
pub struct RelativeTo<'z> {
  start: PlainDateTime,
  zone: Option<&'z Zone>,
  // The start on the timeline: the span from the Unix epoch, or for a date from
  // `1970-01-01T00:00:00` with days of 24 hours.
  origin: Duration,
}

impl<'z> Copy for RelativeTo<'z> {}

// One result of a rounding step: the period, the point that it reaches, and whether the unit
// that was rounded went up.
struct Nudge {
  period: Period,
  reached: Duration,
  expanded: bool,
  total: f64,
}

impl Copy for Nudge {}

impl<'z> RelativeTo<'z> {
  /// Returns the starting point at midnight of `date`, with days of 24 hours.
  pub fn date(date: PlainDate) -> RelativeTo<'static> {
    // Noon keeps the first date of the range inside the range of `PlainDateTime`, and the time
    // of day of the start has no effect when every day is 24 hours.
    let start = PlainDateTime.make(date, PlainTime.make(12, 0, 0, 0))
    return RelativeTo {
      start: start,
      zone: Option<&'static Zone>.none(),
      origin: Duration.make(start.toEpochSeconds(), 0),
    }
  }

  /// Returns the starting point at `value`, in its zone.
  pub fn zoned(value: ZonedDateTime<'z>) -> RelativeTo<'z> {
    let at = value.instant()
    return RelativeTo {
      start: value.toPlainDateTime(),
      zone: Option<&'z Zone>.some(value.zone()),
      origin: Duration.make(at.unixSeconds(), u32.toI64(at.subsecondNanoseconds())),
    }
  }

  /// Returns the exact span from the starting point to the point that `period` reaches.
  ///
  /// # Details
  ///
  /// From a date, one day is 24 hours. From a `ZonedDateTime`, the span of `P1D` is 23 or 25
  /// hours over a daylight saving change.
  pub fn span(self: Self, period: Period) -> Option<Duration> {
    return match self.destination(period) {
      Option<Duration>.Some { value } => value.checkedSubtract(self.origin)
      Option<Duration>.None => Option<Duration>.none()
    }
  }

  /// Returns `period` as a count of `unit`, with a fraction for the part of a unit.
  ///
  /// # Details
  ///
  /// The whole units are counted on the calendar from the starting point, and the fraction is
  /// the part of the next unit that the rest covers: from January 1, 45 days are 1 month and 14
  /// of the 28 days of February, so 1.5 months. The result is negative for a negative period.
  pub fn total(self: Self, period: Period, unit: DateUnit) -> Option<f64> {
    let destination = match self.destination(period) {
      Option<Duration>.Some { value } => value
      Option<Duration>.None => {
        return Option<f64>.none()
      }
    }
    let direction = sign(destination, self.origin)
    if direction == 0 {
      return Option<f64>.some(0.0)
    }
    let whole = match self.difference(destination, unit) {
      Option<Period>.Some { value } => value
      Option<Period>.None => {
        return Option<f64>.none()
      }
    }
    return match self.nudgeCalendar(direction, whole, destination, 1, place(unit), RoundingMode.Trunc) {
      Option<Nudge>.Some { value } => Option<f64>.some(value.total)
      Option<Nudge>.None => Option<f64>.none()
    }
  }

  /// Returns the period from the starting point to the point that `period` reaches, with
  /// `largest` as its largest unit.
  ///
  /// # Details
  ///
  /// From January 1, `P45D` with `DateUnit.Month` is `P1M14D`, and `P1M14D` with `DateUnit.Day`
  /// is `P45D`. A time part of 24 hours or more moves into the days.
  pub fn balance(self: Self, period: Period, largest: DateUnit) -> Option<Period> {
    return match self.destination(period) {
      Option<Duration>.Some { value } => self.difference(value, largest)
      Option<Duration>.None => Option<Period>.none()
    }
  }

  /// Returns `period` rounded as `rounding` says.
  ///
  /// # Details
  ///
  /// The period is first put in the units from the largest unit of the rounding down, as
  /// [`RelativeTo.balance`] does. The rounded unit then takes one of the two values around the
  /// period: for whole months, the result is the number of months before the point reached or
  /// the next one, by the part of that month that the rest covers. A unit that reaches the
  /// next larger unit moves into it: `P11M20D` rounded to months is `P1Y`.
  ///
  /// `RoundingMode.HalfExpand` rounds to the nearest value, and away from zero from the middle.
  ///
  /// # Gotchas
  ///
  /// There is no result when the largest unit of the rounding is smaller than its smallest
  /// unit, or when [`PeriodRounding.every`] has a count above 1 and the largest unit is not the
  /// rounded unit.
  pub fn round(self: Self, period: Period, rounding: PeriodRounding) -> Option<Period> {
    let destination = match self.destination(period) {
      Option<Duration>.Some { value } => value
      Option<Duration>.None => {
        return Option<Period>.none()
      }
    }
    let mut largest = rounding.largest
    if largest < 0 {
      largest = largestOf(period)
      if rounding.smallest < largest {
        largest = rounding.smallest
      }
    }
    if largest > rounding.smallest {
      return Option<Period>.none()
    }
    if rounding.smallest != TIME && rounding.count > 1 && largest != rounding.smallest {
      return Option<Period>.none()
    }
    if largest == TIME {
      return match destination.checkedSubtract(self.origin) {
        Option<Duration>.Some { value } => match value.checkedRound(rounding.step, rounding.mode) {
          Option<Duration>.Some { value: rounded } => Option<Period>.some(Period.ofTime(rounded))
          Option<Duration>.None => Option<Period>.none()
        }
        Option<Duration>.None => Option<Period>.none()
      }
    }
    let whole = match self.difference(destination, unitAt(largest)) {
      Option<Period>.Some { value } => value
      Option<Period>.None => {
        return Option<Period>.none()
      }
    }
    let direction = sign(destination, self.origin)
    if direction == 0 {
      return Option<Period>.some(Period.zero())
    }
    let mut found = Option<Nudge>.none()
    if rounding.smallest != TIME {
      found = self.nudgeCalendar(direction, whole, destination, rounding.count, rounding.smallest, rounding.mode)
    } else if rounding.step.nanoseconds() == 1 {
      return Option<Period>.some(whole)
    } else if self.zone.isSome() {
      found = self.nudgeZonedTime(direction, whole, rounding.step, rounding.mode)
    } else {
      found = nudgeTime(whole, destination, rounding.step, rounding.mode)
    }
    let nudge = match found {
      Option<Nudge>.Some { value } => value
      Option<Nudge>.None => {
        return Option<Period>.none()
      }
    }
    if !nudge.expanded || rounding.smallest == WEEK {
      return Option<Period>.some(nudge.period)
    }
    let from = if rounding.smallest < DAY { rounding.smallest } else { DAY }
    return self.bubble(direction, nudge.period, nudge.reached, largest, from)
  }

  // The point on the timeline of a local date and time. The start stands for itself, also when
  // it is the later of two equal local times.
  fn stamp(self: Self, local: PlainDateTime) -> Option<Duration> {
    if &local == &self.start {
      return Option<Duration>.some(self.origin)
    }
    match self.zone {
      Option<&'z Zone>.Some { value } => {
        return match value.resolve(local, Disambiguation.Compatible) {
          Result<Instant, LocalTimeError>.Success { value: at } => Option<Duration>.some(
            Duration.make(at.unixSeconds(), u32.toI64(at.subsecondNanoseconds())),
          )
          Result<Instant, LocalTimeError>.Failure { error: _ } => Option<Duration>.none()
        }
      }
      Option<&'z Zone>.None => {
        return Option<Duration>.some(
          Duration.make(local.toEpochSeconds(), u32.toI64(local.time().subsecondNanoseconds())),
        )
      }
    }
  }

  // The point that is `years`, `months`, `weeks`, and `days` from the start on the calendar, at
  // the time of day of the start.
  fn reach(self: Self, years: i64, months: i64, weeks: i64, days: i64) -> Option<Duration> {
    let moved = match Period.checkedMake(years, months, weeks, days, Duration.zero()) {
      Option<Period>.Some { value } => value
      Option<Period>.None => {
        return Option<Duration>.none()
      }
    }
    let date = match self.start.date().checkedAddPeriod(moved, Overflow.Constrain) {
      Option<PlainDate>.Some { value } => value
      Option<PlainDate>.None => {
        return Option<Duration>.none()
      }
    }
    return match PlainDateTime.checkedMake(date, self.start.time()) {
      Option<PlainDateTime>.Some { value } => self.stamp(value)
      Option<PlainDateTime>.None => Option<Duration>.none()
    }
  }

  // The point that `period` reaches from the start.
  fn destination(self: Self, period: Period) -> Option<Duration> {
    match self.zone {
      Option<&'z Zone>.Some { value } => {
        if period.isZero() {
          return Option<Duration>.some(self.origin)
        }
        return match self.asZoned(self.origin, value).checkedAddPeriod(period, Overflow.Constrain) {
          Option<ZonedDateTime<'z>>.Some { value: reached } => Option<Duration>.some(
            Duration.make(reached.instant().unixSeconds(), u32.toI64(reached.instant().subsecondNanoseconds())),
          )
          Option<ZonedDateTime<'z>>.None => Option<Duration>.none()
        }
      }
      Option<&'z Zone>.None => {
        return match self.start.checkedAddPeriod(period, Overflow.Constrain) {
          Option<PlainDateTime>.Some { value: reached } => self.stamp(reached)
          Option<PlainDateTime>.None => Option<Duration>.none()
        }
      }
    }
  }

  fn asZoned(self: Self, at: Duration, zone: &'z Zone) -> ZonedDateTime<'z> {
    return ZonedDateTime.make(Instant.make(at.wholeSeconds(), u32.toI64(at.subsecondNanoseconds())), zone)
  }

  // The period from the start to the point `destination`, with `largest` as its largest unit.
  fn difference(self: Self, destination: Duration, largest: DateUnit) -> Option<Period> {
    match self.zone {
      Option<&'z Zone>.Some { value } => {
        return Option<Period>.some(
          self.asZoned(self.origin, value).periodUntil(self.asZoned(destination, value), largest),
        )
      }
      Option<&'z Zone>.None => {
        return match PlainDateTime.fromEpochSeconds(destination.wholeSeconds(), destination.subsecondNanoseconds()) {
          Option<PlainDateTime>.Some { value: reached } => Option<Period>.some(
            self.start.periodUntil(reached, largest),
          )
          Option<PlainDateTime>.None => Option<Period>.none()
        }
      }
    }
  }

  // Rounds the unit at `unit` of `whole` to a multiple of `count`: to the value toward zero or
  // to the next one, by the part of the way between their two points that `destination` covers.
  fn nudgeCalendar(
    self: Self,
    direction: i32,
    whole: Period,
    destination: Duration,
    count: u32,
    unit: i32,
    mode: RoundingMode
  ) -> Option<Nudge> {
    let step = u32.toI64(count)
    let toward = i32.toI64(direction)
    let mut years = whole.years()
    let mut months = whole.months()
    let mut weeks = whole.weeks()
    let mut days = whole.days()
    let mut lower: i64 = 0
    if unit == YEAR {
      lower = years / step * step
      years = lower
      months = 0
      weeks = 0
      days = 0
    } else if unit == MONTH {
      lower = months / step * step
      months = lower
      weeks = 0
      days = 0
    } else if unit == WEEK {
      // The days that are whole weeks after the years and months count as weeks.
      lower = (weeks + days / 7) / step * step
      weeks = lower
      days = 0
    } else {
      lower = days / step * step
      days = lower
    }
    let upper = lower + step * toward
    let mut startPoint = Option<Duration>.none()
    let mut endPoint = Option<Duration>.none()
    if unit == YEAR {
      startPoint = self.reach(lower, 0, 0, 0)
      endPoint = self.reach(upper, 0, 0, 0)
    } else if unit == MONTH {
      startPoint = self.reach(years, lower, 0, 0)
      endPoint = self.reach(years, upper, 0, 0)
    } else if unit == WEEK {
      startPoint = self.reach(years, months, lower, 0)
      endPoint = self.reach(years, months, upper, 0)
    } else {
      startPoint = self.reach(years, months, weeks, lower)
      endPoint = self.reach(years, months, weeks, upper)
    }
    let from = match startPoint {
      Option<Duration>.Some { value } => value
      Option<Duration>.None => {
        return Option<Nudge>.none()
      }
    }
    let to = match endPoint {
      Option<Duration>.Some { value } => value
      Option<Duration>.None => {
        return Option<Nudge>.none()
      }
    }
    let length = distance(from, to)
    if length.isZero() {
      return Option<Nudge>.none()
    }
    // The part of the way that is covered, held between the two points.
    let mut covered = Duration.zero()
    if sign(destination, from) == direction {
      covered = distance(from, destination)
      if &covered > &length {
        covered = length
      }
    }
    let left = length - covered
    let total = i64.toF64(lower) + covered.toSecondsF64() / length.toSecondsF64() * i64.toF64(step * toward)
    let mut expanded = false
    if covered.isZero() {
      expanded = false
    } else if left.isZero() {
      expanded = true
    } else if direction > 0 {
      expanded = mode.roundsUp(false, order(covered, left), (lower / step) % 2 != 0)
    } else {
      expanded = !mode.roundsUp(true, order(left, covered), (upper / step) % 2 != 0)
    }
    let chosen = if expanded { upper } else { lower }
    let mut made = Option<Period>.none()
    if unit == YEAR {
      made = Period.checkedMake(chosen, 0, 0, 0, Duration.zero())
    } else if unit == MONTH {
      made = Period.checkedMake(years, chosen, 0, 0, Duration.zero())
    } else if unit == WEEK {
      made = Period.checkedMake(years, months, chosen, 0, Duration.zero())
    } else {
      made = Period.checkedMake(years, months, weeks, chosen, Duration.zero())
    }
    return match made {
      Option<Period>.Some { value } => Option<Nudge>.some(
        Nudge { period: value, reached: if expanded { to } else { from }, expanded: expanded, total: total },
      )
      Option<Period>.None => Option<Nudge>.none()
    }
  }

  // Rounds the time part of `whole` in a zone, where the day that the time part is in can be
  // shorter or longer than 24 hours.
  fn nudgeZonedTime(self: Self, direction: i32, whole: Period, step: TimeIncrement, mode: RoundingMode) -> Option<Nudge> {
    let toward = i32.toI64(direction)
    let dayStart = match self.reach(whole.years(), whole.months(), whole.weeks(), whole.days()) {
      Option<Duration>.Some { value } => value
      Option<Duration>.None => {
        return Option<Nudge>.none()
      }
    }
    let dayEnd = match self.reachDayAfter(whole, toward) {
      Option<Duration>.Some { value } => value
      Option<Duration>.None => {
        return Option<Nudge>.none()
      }
    }
    let mut rounded = match whole.time().checkedRound(step, mode) {
      Option<Duration>.Some { value } => value
      Option<Duration>.None => {
        return Option<Nudge>.none()
      }
    }
    let beyond = rounded - (dayEnd - dayStart)
    let mut days = whole.days()
    let mut reached = dayStart
    let expanded = beyond.sign() != -direction
    if expanded {
      // The rounded time is at or past the end of its day, so it counts from that end.
      rounded = match beyond.checkedRound(step, mode) {
        Option<Duration>.Some { value } => value
        Option<Duration>.None => {
          return Option<Nudge>.none()
        }
      }
      days = days + toward
      reached = dayEnd
    }
    return match Period.checkedMake(whole.years(), whole.months(), whole.weeks(), days, rounded) {
      Option<Period>.Some { value } => Option<Nudge>.some(
        Nudge { period: value, reached: reached + rounded, expanded: expanded, total: 0.0 },
      )
      Option<Period>.None => Option<Nudge>.none()
    }
  }

  // The point one day after the date part of `whole`, in its direction. The day is added to the
  // date that the years, months, weeks, and days reach.
  fn reachDayAfter(self: Self, whole: Period, toward: i64) -> Option<Duration> {
    let date = match self.start.date().checkedAddPeriod(whole.dateOnly(), Overflow.Constrain) {
      Option<PlainDate>.Some { value } => value
      Option<PlainDate>.None => {
        return Option<Duration>.none()
      }
    }
    let next = match date.checkedAddDays(toward) {
      Option<PlainDate>.Some { value } => value
      Option<PlainDate>.None => {
        return Option<Duration>.none()
      }
    }
    return match PlainDateTime.checkedMake(next, self.start.time()) {
      Option<PlainDateTime>.Some { value } => self.stamp(value)
      Option<PlainDateTime>.None => Option<Duration>.none()
    }
  }

  // Moves a unit that the rounding filled into the next larger unit, as far as `largest`: when
  // the point reached is at or past one more of the larger unit, the period is that unit alone.
  fn bubble(self: Self, direction: i32, rounded: Period, reached: Duration, largest: i32, from: i32) -> Option<Period> {
    let toward = i32.toI64(direction)
    let mut result = rounded
    let mut unit = from - 1
    while unit >= largest {
      if unit != WEEK || largest == WEEK {
        let mut years = result.years()
        let mut months: i64 = 0
        let mut weeks: i64 = 0
        if unit == YEAR {
          years = years + toward
        } else if unit == MONTH {
          months = result.months() + toward
        } else {
          months = result.months()
          weeks = result.weeks() + toward
        }
        let end = match self.reach(years, months, weeks, 0) {
          Option<Duration>.Some { value } => value
          Option<Duration>.None => {
            return Option<Period>.none()
          }
        }
        if sign(reached, end) == -direction {
          return Option<Period>.some(result)
        }
        result = match Period.checkedMake(years, months, weeks, 0, Duration.zero()) {
          Option<Period>.Some { value } => value
          Option<Period>.None => {
            return Option<Period>.none()
          }
        }
      }
      unit = unit - 1
    }
    return Option<Period>.some(result)
  }
}

// Rounds the days and the time part of `whole` together, with days of 24 hours.
fn nudgeTime(whole: Period, destination: Duration, step: TimeIncrement, mode: RoundingMode) -> Option<Nudge> {
  let time = match Duration.checkedMake(whole.days() * 86400, 0) {
    Option<Duration>.Some { value } => value + whole.time()
    Option<Duration>.None => {
      return Option<Nudge>.none()
    }
  }
  let rounded = match time.checkedRound(step, mode) {
    Option<Duration>.Some { value } => value
    Option<Duration>.None => {
      return Option<Nudge>.none()
    }
  }
  let days = wholeDays(rounded)
  let change = days - wholeDays(time)
  let expanded = change != 0 && (change < 0) == time.isNegative()
  let rest = rounded - Duration.make(days * 86400, 0)
  return match Period.checkedMake(whole.years(), whole.months(), whole.weeks(), days, rest) {
    Option<Period>.Some { value } => Option<Nudge>.some(
      Nudge { period: value, reached: destination + (rounded - time), expanded: expanded, total: 0.0 },
    )
    Option<Period>.None => Option<Nudge>.none()
  }
}

// The whole days of 24 hours in a span, rounded toward zero.
fn wholeDays(span: Duration) -> i64 {
  let mut seconds = span.wholeSeconds()
  if seconds < 0 && span.subsecondNanoseconds() != 0 {
    seconds = seconds + 1
  }
  return seconds / 86400
}

fn place(unit: DateUnit) -> i32 {
  return match unit {
    DateUnit.Year => YEAR
    DateUnit.Month => MONTH
    DateUnit.Week => WEEK
    DateUnit.Day => DAY
  }
}

fn unitAt(at: i32) -> DateUnit {
  if at == YEAR {
    return DateUnit.Year
  }
  if at == MONTH {
    return DateUnit.Month
  }
  if at == WEEK {
    return DateUnit.Week
  }
  return DateUnit.Day
}

// The place of the largest unit of a period that is not zero.
fn largestOf(period: Period) -> i32 {
  if period.years() != 0 {
    return YEAR
  }
  if period.months() != 0 {
    return MONTH
  }
  if period.weeks() != 0 {
    return WEEK
  }
  if period.days() != 0 {
    return DAY
  }
  return TIME
}

// `1` when `point` is after `from`, `-1` when it is before, and `0` when they are equal.
fn sign(point: Duration, from: Duration) -> i32 {
  if &point > &from {
    return 1
  }
  if &point < &from {
    return -1
  }
  return 0
}

// The length of the way between two points.
fn distance(from: Duration, to: Duration) -> Duration {
  if &to > &from {
    return to - from
  }
  return from - to
}

fn order(left: Duration, right: Duration) -> Ordering {
  if &left < &right {
    return Ordering.Less
  }
  if &left > &right {
    return Ordering.Greater
  }
  return Ordering.Equal
}
