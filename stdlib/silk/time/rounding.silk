//! How `silk.time` rounds: the [`RoundingMode`], the [`TimeUnit`], and the [`TimeIncrement`] that
//! the `round` functions of the time types take.
//!
//! # When to use
//!
//! Use these types to round a time to a step, such as the nearest 15 minutes or the second
//! below. `Duration.round`, `PlainTime.round`, `PlainDateTime.round`, `Instant.round`, and
//! `ZonedDateTime.round` each take a [`TimeIncrement`] and a [`RoundingMode`].
//!
//! # Details
//!
//! A [`TimeIncrement`] is a count of one unit, such as 15 minutes or 250 milliseconds. It must
//! divide one day of 24 hours evenly, so the steps start again at each midnight: 90 minutes and
//! 6 hours are steps, and 7 hours is not.
//!
//! The nine modes are the ones of ECMAScript Temporal and of `Intl.NumberFormat`. Four of them
//! always round in one direction, and five round to the nearest step and differ only for a
//! value exactly between two steps.
//!
//! # Examples
//!
//! ## Round a time of day to a quarter of an hour
//!
//! ```silk
//! import silk.time.plain_time { PlainTime }
//! import silk.time.rounding { RoundingMode, TimeIncrement, TimeUnit }
//!
//! pub fn main() -> i32 {
//!   let quarter = TimeIncrement.of(15, TimeUnit.Minute)
//!   let time = PlainTime.make(17, 38, 0, 0)
//!   let nearest = time.round(quarter, RoundingMode.HalfExpand)
//!   let below = time.round(quarter, RoundingMode.Floor)
//!   if nearest.hour() != 17 || nearest.minute() != 45 {
//!     return 1
//!   }
//!   if below.hour() != 17 || below.minute() != 30 {
//!     return 2
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Time
import silk.core.option { Option }
import silk.core.order { Ordering }
import silk.core.ownership { Copy }
import silk.num.i64
import silk.num.u32

const DAY: i64 = 86400000000000

/// Which of the two nearest steps a rounded value takes.
///
/// # Details
///
/// "Up" is toward positive infinity, or later in time. "Away from zero" and "toward zero" are
/// different from up and down only for a negative `Duration`; for a time, a date, or an instant
/// they are up and down.
pub enum RoundingMode {
  /// Up.
  Ceil,
  /// Down.
  Floor,
  /// Away from zero.
  Expand,
  /// Toward zero.
  Trunc,
  /// To the nearest step, and up from the middle.
  HalfCeil,
  /// To the nearest step, and down from the middle.
  HalfFloor,
  /// To the nearest step, and away from zero from the middle. This is the rounding of school
  /// arithmetic.
  HalfExpand,
  /// To the nearest step, and toward zero from the middle.
  HalfTrunc,
  /// To the nearest step, and from the middle to the step that is an even multiple.
  HalfEven,
}

impl RoundingMode {
  /// Returns `true` if a value between two steps rounds to the upper one.
  ///
  /// # Details
  ///
  /// `negative` says that the value is below zero. `half` compares the distance from the lower
  /// step with half a step: `Less` when the value is nearer to the lower step, `Equal` in the
  /// middle. `lowerIsOdd` says that the lower step is an odd multiple of the step size.
  pub fn roundsUp(self: Self, negative: bool, half: Ordering, lowerIsOdd: bool) -> bool {
    let nearest = match self {
      RoundingMode.Ceil => {
        return true
      }
      RoundingMode.Floor => {
        return false
      }
      RoundingMode.Expand => {
        return !negative
      }
      RoundingMode.Trunc => {
        return negative
      }
      _ => half
    }
    match nearest {
      Ordering.Less => {
        return false
      }
      Ordering.Greater => {
        return true
      }
      Ordering.Equal => {}
    }
    return match self {
      RoundingMode.HalfCeil => true
      RoundingMode.HalfFloor => false
      RoundingMode.HalfExpand => !negative
      RoundingMode.HalfTrunc => negative
      _ => lowerIsOdd
    }
  }

  /// Returns the mode that rounds every value as this mode rounds a positive value.
  ///
  /// # Details
  ///
  /// `Expand` becomes `Ceil`, `Trunc` becomes `Floor`, `HalfExpand` becomes `HalfCeil`, and
  /// `HalfTrunc` becomes `HalfFloor`. A point on a timeline, such as an `Instant` before 1970,
  /// rounds this way: "away from zero" means later in time on both sides of the epoch.
  pub fn asIfPositive(self: Self) -> RoundingMode {
    return match self {
      RoundingMode.Expand => RoundingMode.Ceil
      RoundingMode.Trunc => RoundingMode.Floor
      RoundingMode.HalfExpand => RoundingMode.HalfCeil
      RoundingMode.HalfTrunc => RoundingMode.HalfFloor
      _ => self
    }
  }

  /// Returns `value` rounded to a multiple of `step`, or `None` when `step` is not positive or
  /// the result does not fit an `i64`.
  pub fn roundToMultiple(self: Self, value: i64, step: i64) -> Option<i64> {
    if step <= 0 {
      return Option<i64>.none()
    }
    let mut quotient = value / step
    let mut rest = value % step
    if rest < 0 {
      rest = rest + step
      quotient = quotient - 1
    }
    if rest == 0 {
      return Option<i64>.some(value)
    }
    // `rest` and `step - rest` are both below `step`, so the comparison cannot overflow.
    let half = if rest < step - rest { Ordering.Less } else { if rest > step - rest { Ordering.Greater } else { Ordering.Equal } }
    if self.roundsUp(value < 0, half, quotient % 2 != 0) {
      // `step - rest` is from 1 to `step`.
      return i64.checkedAdd(value, step - rest)
    }
    return i64.checkedSubtract(value, rest)
  }
}

/// A unit of time of a fixed length.
pub enum TimeUnit {
  /// 24 hours.
  Day,
  /// 60 minutes.
  Hour,
  /// 60 seconds.
  Minute,
  /// One second.
  Second,
  /// A thousandth of a second.
  Millisecond,
  /// A millionth of a second.
  Microsecond,
  /// A billionth of a second.
  Nanosecond,
}

impl TimeUnit {
  /// Returns the length of the unit in nanoseconds.
  pub fn nanoseconds(self: Self) -> i64 {
    return match self {
      TimeUnit.Day => DAY
      TimeUnit.Hour => 3600000000000
      TimeUnit.Minute => 60000000000
      TimeUnit.Second => 1000000000
      TimeUnit.Millisecond => 1000000
      TimeUnit.Microsecond => 1000
      TimeUnit.Nanosecond => 1
    }
  }
}

/// A step that times are rounded to: a count of one [`TimeUnit`] that divides one day evenly.
pub struct TimeIncrement {
  length: i64,
}

impl Copy for TimeIncrement {}

impl TimeIncrement {
  /// Returns the step of `count` units, such as 15 minutes.
  ///
  /// # Gotchas
  ///
  /// A step that is empty or does not divide 24 hours evenly, such as 7 hours, traps.
  /// [`TimeIncrement.checkedOf`] returns `None` instead.
  pub fn of(count: u32, unit: TimeUnit) -> TimeIncrement {
    match TimeIncrement.checkedOf(count, unit) {
      Option<TimeIncrement>.Some { value } => {
        return value
      }
      Option<TimeIncrement>.None => {
        return Intrinsic.trap("TimeIncrement.of: the step is empty or does not divide one day evenly")
      }
    }
  }

  /// Returns the step of `count` units, or `None` when `count` is 0 or the step does not divide
  /// 24 hours evenly.
  pub fn checkedOf(count: u32, unit: TimeUnit) -> Option<TimeIncrement> {
    // A unit is at most 8.64e13 nanoseconds and a count at most 4.3e9, so the product can pass
    // the `i64` range only for a day, which no count above 1 divides.
    if count == 0 || (count > 86400 && unit.nanoseconds() >= 1000000000) {
      return Option<TimeIncrement>.none()
    }
    let length = unit.nanoseconds() * u32.toI64(count)
    if length > DAY || DAY % length != 0 {
      return Option<TimeIncrement>.none()
    }
    return Option<TimeIncrement>.some(TimeIncrement { length: length })
  }

  /// Returns the step of one `unit`.
  pub fn one(unit: TimeUnit) -> TimeIncrement {
    return TimeIncrement { length: unit.nanoseconds() }
  }

  /// Returns the length of the step in nanoseconds.
  pub fn nanoseconds(self: Self) -> i64 {
    return self.length
  }

  /// Returns `value`, a count of nanoseconds from 0 to one day, rounded to this step. The result
  /// is from 0 to one day.
  ///
  /// # Details
  ///
  /// `negative` and `days` are for a value that is the part of a larger count above a whole
  /// number of days: `negative` says that the whole count is below zero, and `days` is the number
  /// of whole days below this part. [`RoundingMode.HalfEven`] counts the steps from the start of
  /// the whole count. For a time of day, pass `false` and `0`.
  pub fn roundDayPart(self: Self, value: i64, mode: RoundingMode, negative: bool, days: i64) -> i64 {
    let rest = value % self.length
    if rest == 0 {
      return value
    }
    let half = if rest < self.length - rest { Ordering.Less } else { if rest > self.length - rest { Ordering.Greater } else { Ordering.Equal } }
    let baseIsOdd = days % 2 != 0 && (DAY / self.length) % 2 != 0
    let lowerIsOdd = ((value / self.length) % 2 != 0) != baseIsOdd
    if mode.roundsUp(negative, half, lowerIsOdd) {
      return value - rest + self.length
    }
    return value - rest
  }
}
