//! Times of day without a date or a time zone: the [`PlainTime`] type.
//!
//! # When to use
//!
//! Use [`PlainTime`] for a wall-clock time that is not tied to a day, such as an opening hour or
//! an alarm at 07:30. For a time on a given day, use `silk.time.plain_date_time`. For a point in
//! time, use `silk.time.instant`.
//!
//! # Details
//!
//! A `PlainTime` has an hour from 0 to 23, a minute and a second from 0 to 59, and a nanosecond
//! part from 0 to 999,999,999. It has no leap second: second 60 in a text reads as 59.
//!
//! # Examples
//!
//! ## Parse a time and add to it past midnight
//!
//! ```silk
//! import silk.core.result { Result }
//! import silk.time.duration { Duration }
import silk.time.rounding { RoundingMode, TimeIncrement }
//! import silk.time.plain_time { PlainTime }
//! import silk.time.text { TimeParseError }
//!
//! pub fn main() -> i32 {
//!   match PlainTime.parse("23:30") {
//!     Result<PlainTime, TimeParseError>.Success { value } => {
//!       let later = value.addWrapping(Duration.fromMinutes(45))
//!       if later.hour() != 0 || later.minute() != 15 {
//!         return 1
//!       }
//!       return 0
//!     }
//!     Result<PlainTime, TimeParseError>.Failure { error: _ } => {
//!       return 2
//!     }
//!   }
//! }
//! ```
//!
//! @category Time
import silk.core.equal { Equal }
import silk.core.option { Option }
import silk.core.order { Order, Ordering }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.text.format { Debug, Display, Format, Formatter }
import silk.text.string { String }
import silk.collections.slice { Slice }
import silk.time.duration { Duration }
import silk.time.text as Text
import silk.time.text { ClockTime, OffsetKind, ParsedDateTime, Scanner, TimeParseError, TimeParseReason }
import silk.num.i64
import silk.num.u32
import silk.num.u8

const DAY_NANOSECONDS: i64 = 86400000000000

/// A time of day with nanosecond precision, with no date and no time zone.
///
/// # Details
///
/// The hour is from 0 to 23, the minute and the second from 0 to 59, and the nanosecond part from
/// 0 to 999,999,999. `==`, `!=`, `<`, `<=`, `>`, and `>=` compare times from midnight forward.
/// `Display` writes `HH:MM:SS`, with a fraction when the nanosecond part is not zero.
pub struct PlainTime {
  hourOfDay: u8,
  minuteOfHour: u8,
  secondOfMinute: u8,
  nanosecond: u32,
}

impl Copy for PlainTime {}

impl PlainTime {
  /// Returns the time with the given hour from 0 to 23, minute and second from 0 to 59, and
  /// nanosecond part from 0 to 999,999,999.
  ///
  /// # Gotchas
  ///
  /// A field outside its range traps. [`PlainTime.checkedMake`] returns `None` instead.
  pub fn make(hour: u8, minute: u8, second: u8, nanosecond: u32) -> PlainTime {
    match PlainTime.checkedMake(hour, minute, second, nanosecond) {
      Option<PlainTime>.Some { value } => {
        return value
      }
      Option<PlainTime>.None => {
        return Intrinsic.trap("PlainTime.make: a field is outside its range")
      }
    }
  }

  /// Returns the time with the given hour from 0 to 23, minute and second from 0 to 59, and
  /// nanosecond part from 0 to 999,999,999, or `None` when a field is outside its range.
  pub fn checkedMake(hour: u8, minute: u8, second: u8, nanosecond: u32) -> Option<PlainTime> {
    if hour > 23 || minute > 59 || second > 59 || nanosecond > 999999999 {
      return Option<PlainTime>.none()
    }
    return Option<PlainTime>.some(
      PlainTime { hourOfDay: hour, minuteOfHour: minute, secondOfMinute: second, nanosecond: nanosecond },
    )
  }

  /// Returns midnight, `00:00:00`, the first time of a day.
  pub fn midnight() -> PlainTime {
    return PlainTime { hourOfDay: 0, minuteOfHour: 0, secondOfMinute: 0, nanosecond: 0 }
  }

  /// Returns the time that is `nanoseconds` nanoseconds after midnight, or `None` when the count is
  /// negative or is a whole day or more.
  pub fn fromDayNanoseconds(nanoseconds: i64) -> Option<PlainTime> {
    if nanoseconds < 0 || nanoseconds >= DAY_NANOSECONDS {
      return Option<PlainTime>.none()
    }
    return Option<PlainTime>.some(fromCount(nanoseconds))
  }

  /// Returns the number of nanoseconds from midnight to this time, from 0 to 86,399,999,999,999.
  pub fn toDayNanoseconds(self: Self) -> i64 {
    let seconds = u8.toI64(self.hourOfDay) * 3600 + u8.toI64(self.minuteOfHour) * 60 + u8.toI64(self.secondOfMinute)
    return seconds * 1000000000 + u32.toI64(self.nanosecond)
  }

  /// Returns the hour, from 0 to 23.
  pub fn hour(self: Self) -> u8 {
    return self.hourOfDay
  }

  /// Returns the minute, from 0 to 59.
  pub fn minute(self: Self) -> u8 {
    return self.minuteOfHour
  }

  /// Returns the second, from 0 to 59.
  pub fn second(self: Self) -> u8 {
    return self.secondOfMinute
  }

  /// Returns the fraction of the second in nanoseconds, from 0 to 999,999,999.
  pub fn subsecondNanoseconds(self: Self) -> u32 {
    return self.nanosecond
  }

  /// Returns the hour, minute, second, and nanosecond part as plain numbers.
  pub fn toClock(self: Self) -> ClockTime {
    return ClockTime {
      hour: self.hourOfDay,
      minute: self.minuteOfHour,
      second: self.secondOfMinute,
      nanosecond: self.nanosecond,
    }
  }

  /// Returns the span from midnight to this time.
  pub fn sinceMidnight(self: Self) -> Duration {
    return Duration.fromNanoseconds(self.toDayNanoseconds())
  }

  /// Returns the time `span` later on a clock, or earlier for a negative span. The result wraps
  /// around midnight.
  ///
  /// # Details
  ///
  /// Whole days in `span` have no effect: `23:30` plus 45 minutes is `00:15`, and so is `23:30`
  /// plus 24 hours and 45 minutes.
  pub fn addWrapping(self: Self, span: Duration) -> PlainTime {
    // Reduce the span to less than a day first, so that the sum fits an i64.
    let mut seconds = span.wholeSeconds() % 86400
    if seconds < 0 {
      seconds = seconds + 86400
    }
    let offset = seconds * 1000000000 + u32.toI64(span.subsecondNanoseconds())
    return fromCount((self.toDayNanoseconds() + offset) % DAY_NANOSECONDS)
  }

  /// Returns the time rounded to a multiple of `step` from midnight, going around midnight.
  ///
  /// # Details
  ///
  /// `23:59:40` rounded to the nearest minute is `00:00`. To keep the day that the rounding
  /// reaches, round a `PlainDateTime`.
  ///
  /// # Examples
  ///
  /// ```silk
  /// import silk.time.plain_time { PlainTime }
  /// import silk.time.rounding { RoundingMode, TimeIncrement, TimeUnit }
  ///
  /// pub fn main() -> i32 {
  ///   let time = PlainTime.make(9, 7, 31, 0)
  ///   let rounded = time.round(TimeIncrement.of(5, TimeUnit.Minute), RoundingMode.HalfExpand)
  ///   if &rounded != &PlainTime.make(9, 10, 0, 0) {
  ///     return 1
  ///   }
  ///   return 0
  /// }
  /// ```
  pub fn round(self: Self, step: TimeIncrement, mode: RoundingMode) -> PlainTime {
    return fromCount(step.roundDayPart(self.toDayNanoseconds(), mode, false, 0) % DAY_NANOSECONDS)
  }

  /// Returns the span from this time to `other` on the same day. It is negative when `other` is
  /// earlier.
  pub fn until(self: Self, other: PlainTime) -> Duration {
    return Duration.fromNanoseconds(other.toDayNanoseconds() - self.toDayNanoseconds())
  }

  /// Reads a time from ISO 8601 text such as `17:36:22.5`.
  ///
  /// # Details
  ///
  /// The text is `HH`, `HH:MM`, `HH:MM:SS`, `HHMM`, or `HHMMSS`, with an optional fraction of one
  /// to nine digits after the seconds and an optional prefix `T`. Second `60` reads as `59`. A
  /// numeric UTC offset and bracketed annotations can follow; they are checked and then ignored.
  /// The text can also be a full date and time such as `2026-11-19T17:36:22`, from which the time
  /// is taken.
  ///
  /// # Errors
  ///
  /// - `TimeParseReason.UnexpectedEnd` or `UnexpectedCharacter` if the text does not have that
  ///   form.
  /// - `TimeParseReason.OutOfRange` if a field names no real value, such as hour 24.
  /// - `TimeParseReason.MissingTime` if the text is a date without a time.
  /// - `TimeParseReason.Ambiguous` if the text has no prefix `T` and is also a valid year and
  ///   month or month and day, such as `1214` or `2026-11`.
  /// - `TimeParseReason.UtcNotAllowed` if the text has the UTC designator `Z`.
  /// - `TimeParseReason.UnsupportedCalendar` if a calendar annotation is not `[u-ca=iso8601]`.
  /// - `TimeParseReason.UnknownCriticalAnnotation` if an annotation with an unknown key starts
  ///   with `!`.
  pub fn parse(text: string) -> Result<PlainTime, TimeParseError> {
    return PlainTime.parseBytes(String.utf8Bytes(text))
  }

  /// Reads a time from the bytes of ISO 8601 text such as `17:36:22.5`.
  ///
  /// # Details
  ///
  /// The text is `HH`, `HH:MM`, `HH:MM:SS`, `HHMM`, or `HHMMSS`, with an optional fraction of one
  /// to nine digits after the seconds and an optional prefix `T`. Second `60` reads as `59`. A
  /// numeric UTC offset and bracketed annotations can follow; they are checked and then ignored.
  /// The text can also be a full date and time such as `2026-11-19T17:36:22`, from which the time
  /// is taken.
  ///
  /// # Errors
  ///
  /// - `TimeParseReason.UnexpectedEnd` or `UnexpectedCharacter` if the text does not have that
  ///   form.
  /// - `TimeParseReason.OutOfRange` if a field names no real value, such as hour 24.
  /// - `TimeParseReason.MissingTime` if the text is a date without a time.
  /// - `TimeParseReason.Ambiguous` if the text has no prefix `T` and is also a valid year and
  ///   month or month and day, such as `1214` or `2026-11`.
  /// - `TimeParseReason.UtcNotAllowed` if the text has the UTC designator `Z`.
  /// - `TimeParseReason.UnsupportedCalendar` if a calendar annotation is not `[u-ca=iso8601]`.
  /// - `TimeParseReason.UnknownCriticalAnnotation` if an annotation with an unknown key starts
  ///   with `!`.
  pub fn parseBytes(bytes: &[u8]) -> Result<PlainTime, TimeParseError> {
    let prefixed = bytes.length > 0 && (bytes[0] == 84 || bytes[0] == 116)
    if !prefixed {
      // A full date and time comes first: `2026-11-19T17:36` is never a bare time.
      let mut whole = Scanner.make(bytes)
      let parsed = whole.dateTime()
      if whole.failure().isNone() {
        if !parsed.hasTime {
          return Result<PlainTime, TimeParseError>.failResult(
            TimeParseError { reason: TimeParseReason.MissingTime, offset: bytes.length },
          )
        }
        return finish(parsed)
      }
    }
    let mut scanner = Scanner.make(bytes)
    let parsed = scanner.timeOfDay()
    match scanner.failure() {
      Option<TimeParseError>.Some { value } => {
        return Result<PlainTime, TimeParseError>.failResult(value)
      }
      Option<TimeParseError>.None => {
        return finish(parsed)
      }
    }
  }

  fn same(left: &PlainTime, right: &PlainTime) -> bool {
    return left.hourOfDay == right.hourOfDay && left.minuteOfHour == right.minuteOfHour && left.secondOfMinute == right.secondOfMinute
      && left.nanosecond == right.nanosecond
  }

  fn compare(left: &PlainTime, right: &PlainTime) -> Ordering {
    let a = PlainTime.toDayNanoseconds(left.*)
    let b = PlainTime.toDayNanoseconds(right.*)
    if a < b {
      return Ordering.Less
    }
    if a > b {
      return Ordering.Greater
    }
    return Ordering.Equal
  }
}

impl Equal for PlainTime {
  equals: PlainTime.same
}

impl Order for PlainTime {
  compare: PlainTime.compare
}

/// Writes the time as `HH:MM:SS`, with a fraction without zeros at the end when the nanosecond
/// part is not zero, as in `17:36:22` or `17:36:22.5`.
impl Display for PlainTime {
  effect fn display(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    let mut output: [u8; 18] = [0; 18]
    let length = Text.writeTime(&mut output, 0, PlainTime.toClock(self.*))
    return run Format.write(&mut formatter, Slice.view<u8>(&output, 0, length))
  }
}

/// Writes the same text as `Display`: the time as `HH:MM:SS` with an optional fraction.
impl Debug for PlainTime {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return run Display.display(self, &mut formatter)
  }
}

// The time `count` nanoseconds after midnight, for a count from 0 to less than a day.
fn fromCount(count: i64) -> PlainTime {
  let seconds = count / 1000000000
  return PlainTime {
    hourOfDay: i64.toU8(seconds / 3600),
    minuteOfHour: i64.toU8(seconds / 60 % 60),
    secondOfMinute: i64.toU8(seconds % 60),
    nanosecond: i64.toU32(count % 1000000000),
  }
}

fn finish(parsed: ParsedDateTime) -> Result<PlainTime, TimeParseError> {
  match parsed.offset.kind {
    OffsetKind.Utc => {
      return Result<PlainTime, TimeParseError>.failResult(
        TimeParseError { reason: TimeParseReason.UtcNotAllowed, offset: 0 },
      )
    }
    _ => {}
  }
  return Result<PlainTime, TimeParseError>.succeed(
    PlainTime {
      hourOfDay: parsed.time.hour,
      minuteOfHour: parsed.time.minute,
      secondOfMinute: parsed.time.second,
      nanosecond: parsed.time.nanosecond,
    },
  )
}
