//! Exact elapsed time: the [`Duration`] type, a signed span of seconds and nanoseconds.
//!
//! # When to use
//!
//! Use [`Duration`] for a timeout, a measured time, or the distance between two instants. It
//! counts real time only, so an hour is always 3600 seconds. A span in calendar units, such as
//! "one month", has no fixed length and is not a `Duration`.
//!
//! # Details
//!
//! A `Duration` holds signed whole seconds and a nanosecond part from 0 to 999,999,999. Two equal
//! spans always have equal fields, so `==` and `<` compare spans. `+`, `-`, unary `-`, and `*` by
//! an `i64` are exact and trap when the result leaves the range. The `checked` functions return
//! `None` instead.
//!
//! # Examples
//!
//! ## Add two spans and read the parts
//!
//! ```silk
//! import silk.time.duration { Duration }
//!
//! pub fn main() -> i32 {
//!   let total = Duration.fromSeconds(90) + Duration.fromMilliseconds(1500)
//!   if total.wholeSeconds() != 91 || total.subsecondNanoseconds() != 500000000 {
//!     return 1
//!   }
//!   if !(&Duration.fromMinutes(1) < &total) {
//!     return 2
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Time
import silk.core.equal { Equal }
import silk.core.ops { Add, Multiply, Negate, Subtract }
import silk.core.option { Option }
import silk.core.order { Order, Ordering }
import silk.core.ownership { Copy }
import silk.io.writer { Writer, WriterError }
import silk.text.format { Debug, Display, Format, Formatter }
import silk.collections.slice { Slice }
import silk.time.rounding { RoundingMode, TimeIncrement }
import silk.num.i32
import silk.num.i64
import silk.num.u32
import silk.num.u64
import silk.num.u8
import silk.num.usize

const BILLION: i64 = 1000000000

/// A signed span of exact time with nanosecond precision.
///
/// # Details
///
/// The span is `wholeSeconds` seconds plus `subsecondNanoseconds` nanoseconds. The nanosecond part
/// is always from 0 to 999,999,999, also for a negative span: one nanosecond before zero is `-1`
/// second plus 999,999,999 nanoseconds. Equal spans have equal parts. The seconds cover the whole
/// `i64` range, about 292 billion years in each direction.
///
/// `==`, `!=`, `<`, `<=`, `>`, and `>=` compare spans. `+`, `-`, unary `-`, and `*` by an `i64`
/// trap when the result is outside the range.
pub struct Duration {
  seconds: i64,
  nanoseconds: u32,
}

impl Copy for Duration {}

impl Duration {
  /// Returns the empty span.
  pub fn zero() -> Duration {
    return Duration { seconds: 0, nanoseconds: 0 }
  }

  /// Returns the span of `seconds` seconds plus `nanoseconds` nanoseconds.
  ///
  /// # Details
  ///
  /// Whole seconds in `nanoseconds` move into the seconds, and `nanoseconds` can be negative. So
  /// `Duration.make(0, 1500000000)` is 1.5 seconds and `Duration.make(1, -1)` is one nanosecond
  /// less than a second.
  ///
  /// # Gotchas
  ///
  /// A total outside the `i64` seconds range traps. [`Duration.checkedMake`] returns `None`
  /// instead.
  pub fn make(seconds: i64, nanoseconds: i64) -> Duration {
    match Duration.checkedMake(seconds, nanoseconds) {
      Option<Duration>.Some { value } => {
        return value
      }
      Option<Duration>.None => {
        return Intrinsic.trap("Duration.make: the span is outside the Duration range")
      }
    }
  }

  /// Returns the span of `seconds` seconds plus `nanoseconds` nanoseconds, or `None` when the total
  /// is outside the `i64` seconds range.
  ///
  /// # Details
  ///
  /// Whole seconds in `nanoseconds` move into the seconds, and `nanoseconds` can be negative.
  pub fn checkedMake(seconds: i64, nanoseconds: i64) -> Option<Duration> {
    let mut carried = nanoseconds / BILLION
    let mut remainder = nanoseconds % BILLION
    if remainder < 0 {
      carried = carried - 1
      remainder = remainder + BILLION
    }
    match i64.checkedAdd(seconds, carried) {
      Option<i64>.Some { value } => {
        return Option<Duration>.some(Duration { seconds: value, nanoseconds: i64.toU32(remainder) })
      }
      Option<i64>.None => {
        return Option<Duration>.none()
      }
    }
  }

  /// Returns the span of `hours` hours of 3600 seconds each. A total outside the range traps.
  pub fn fromHours(hours: i64) -> Duration {
    return Duration.fromSeconds(scaled(hours, 3600, "Duration.fromHours"))
  }

  /// Returns the span of `minutes` minutes of 60 seconds each. A total outside the range traps.
  pub fn fromMinutes(minutes: i64) -> Duration {
    return Duration.fromSeconds(scaled(minutes, 60, "Duration.fromMinutes"))
  }

  /// Returns the span of `seconds` seconds.
  pub fn fromSeconds(seconds: i64) -> Duration {
    return Duration { seconds: seconds, nanoseconds: 0 }
  }

  /// Returns the span of `milliseconds` milliseconds. Each `i64` value is in range.
  pub fn fromMilliseconds(milliseconds: i64) -> Duration {
    return split(milliseconds, 1000, 1000000)
  }

  /// Returns the span of `microseconds` microseconds. Each `i64` value is in range.
  pub fn fromMicroseconds(microseconds: i64) -> Duration {
    return split(microseconds, 1000000, 1000)
  }

  /// Returns the span of `nanoseconds` nanoseconds. Each `i64` value is in range.
  pub fn fromNanoseconds(nanoseconds: i64) -> Duration {
    return split(nanoseconds, BILLION, 1)
  }

  /// Returns the whole seconds of the span, rounded toward negative infinity.
  ///
  /// # Details
  ///
  /// The span is this value plus [`Duration.subsecondNanoseconds`]. For -1.5 seconds the result is
  /// `-2`, and the nanosecond part is 500,000,000.
  pub fn wholeSeconds(self: Self) -> i64 {
    return self.seconds
  }

  /// Returns the nanosecond part of the span, from 0 to 999,999,999.
  ///
  /// # Details
  ///
  /// The part counts forward from [`Duration.wholeSeconds`], also for a negative span. For -1.5
  /// seconds the whole seconds are `-2` and this part is 500,000,000.
  pub fn subsecondNanoseconds(self: Self) -> u32 {
    return self.nanoseconds
  }

  /// Returns the span rounded to a multiple of `step`.
  ///
  /// # Details
  ///
  /// A day is 24 hours. `RoundingMode.HalfExpand` is the rounding of school arithmetic: to the
  /// nearest step, and away from zero from the middle.
  ///
  /// # Gotchas
  ///
  /// A result outside the range traps. [`Duration.checkedRound`] returns `None` instead.
  ///
  /// # Examples
  ///
  /// ```silk
  /// import silk.time.duration { Duration }
  /// import silk.time.rounding { RoundingMode, TimeIncrement, TimeUnit }
  ///
  /// pub fn main() -> i32 {
  ///   let span = Duration.make(3 * 3600 + 52 * 60 + 30, 0)
  ///   let quarter = TimeIncrement.of(15, TimeUnit.Minute)
  ///   let rounded = span.round(quarter, RoundingMode.HalfExpand)
  ///   if &rounded != &Duration.make(4 * 3600, 0) {
  ///     return 1
  ///   }
  ///   let down = (-span).round(TimeIncrement.one(TimeUnit.Hour), RoundingMode.Trunc)
  ///   if &down != &Duration.make(-3 * 3600, 0) {
  ///     return 2
  ///   }
  ///   return 0
  /// }
  /// ```
  pub fn round(self: Self, step: TimeIncrement, mode: RoundingMode) -> Duration {
    match self.checkedRound(step, mode) {
      Option<Duration>.Some { value } => {
        return value
      }
      Option<Duration>.None => {
        return Intrinsic.trap("Duration.round: the result is outside the Duration range")
      }
    }
  }

  /// Returns the span rounded to a multiple of `step`, or `None` when the result is outside the
  /// range.
  pub fn checkedRound(self: Self, step: TimeIncrement, mode: RoundingMode) -> Option<Duration> {
    let mut days = self.seconds / 86400
    let mut rest = self.seconds % 86400
    if rest < 0 {
      rest = rest + 86400
      days = days - 1
    }
    let part = rest * BILLION + u32.toI64(self.nanoseconds)
    let rounded = step.roundDayPart(part, mode, self.seconds < 0, days)
    return Duration.checkedMake(self.seconds, u32.toI64(self.nanoseconds) + rounded - part)
  }

  /// Returns the span in whole milliseconds, rounded toward zero, or `None` when the count does not
  /// fit an `i64`.
  pub fn toMilliseconds(self: Self) -> Option<i64> {
    return total(self, 1000, 1000000)
  }

  /// Returns the span in whole microseconds, rounded toward zero, or `None` when the count does not
  /// fit an `i64`.
  pub fn toMicroseconds(self: Self) -> Option<i64> {
    return total(self, 1000000, 1000)
  }

  /// Returns the span in nanoseconds, or `None` when the count does not fit an `i64`.
  ///
  /// # Details
  ///
  /// An `i64` holds about 292 years of nanoseconds in each direction.
  pub fn toNanoseconds(self: Self) -> Option<i64> {
    return total(self, BILLION, 1)
  }

  /// Returns the span in seconds as a float. Spans above 2^53 nanoseconds lose precision.
  pub fn toSecondsF64(self: Self) -> f64 {
    return i64.toF64(self.seconds) + u32.toF64(self.nanoseconds) / 1000000000.0
  }

  /// Returns `true` if the span is empty.
  pub fn isZero(self: Self) -> bool {
    return self.seconds == 0 && self.nanoseconds == 0
  }

  /// Returns `true` if the span is less than zero.
  pub fn isNegative(self: Self) -> bool {
    return self.seconds < 0
  }

  /// Returns `-1` for a negative span, `0` for the empty span, and `1` for a positive span.
  pub fn sign(self: Self) -> i32 {
    if self.seconds < 0 {
      return -1
    }
    if self.seconds == 0 && self.nanoseconds == 0 {
      return 0
    }
    return 1
  }

  /// Returns the span with the opposite sign, or `None` when it is outside the range.
  ///
  /// # Details
  ///
  /// Only spans within one second of the most negative value have no opposite.
  pub fn checkedNegate(self: Self) -> Option<Duration> {
    if self.nanoseconds == 0 {
      if self.seconds == i64.MIN {
        return Option<Duration>.none()
      }
      return Option<Duration>.some(Duration { seconds: -self.seconds, nanoseconds: 0 })
    }
    // -(s + n/1e9) = (-s - 1) + (1e9 - n)/1e9, and -s - 1 never overflows.
    return Option<Duration>.some(
      Duration { seconds: -(self.seconds + 1), nanoseconds: 1000000000 - self.nanoseconds },
    )
  }

  /// Returns the span without its sign, or `None` when it is outside the range.
  ///
  /// # Details
  ///
  /// Only spans within one second of the most negative value have no absolute value.
  pub fn checkedAbsolute(self: Self) -> Option<Duration> {
    if self.seconds < 0 {
      return self.checkedNegate()
    }
    return Option<Duration>.some(self)
  }

  /// Returns the span without its sign. A result outside the range traps.
  pub fn absolute(self: Self) -> Duration {
    return orTrap(self.checkedAbsolute(), "Duration.absolute: the span is outside the Duration range")
  }

  /// Returns `self + other`, or `None` when the sum is outside the range.
  pub fn checkedAdd(self: Self, other: Duration) -> Option<Duration> {
    let mut nanoseconds = self.nanoseconds + other.nanoseconds
    let mut carry: i64 = 0
    if nanoseconds >= 1000000000 {
      nanoseconds = nanoseconds - 1000000000
      carry = 1
    }
    // Add the carry to the operand that it cannot push out of range before the other is added:
    // the sum of the two seconds overflows upward only when both are positive.
    match i64.checkedAdd(self.seconds, other.seconds) {
      Option<i64>.Some { value } => {
        match i64.checkedAdd(value, carry) {
          Option<i64>.Some { value: sum } => {
            return Option<Duration>.some(Duration { seconds: sum, nanoseconds: nanoseconds })
          }
          Option<i64>.None => {
            return Option<Duration>.none()
          }
        }
      }
      Option<i64>.None => {
        // The seconds alone leave the range. Only a negative overflow by exactly one second can
        // come back in range through the carry.
        if carry == 1 && self.seconds < 0 && other.seconds < 0
          && i64.wrappingAdd(self.seconds, other.seconds) == i64.MAX {
          return Option<Duration>.some(Duration { seconds: i64.MIN, nanoseconds: nanoseconds })
        }
        return Option<Duration>.none()
      }
    }
  }

  /// Returns `self - other`, or `None` when the difference is outside the range.
  pub fn checkedSubtract(self: Self, other: Duration) -> Option<Duration> {
    let mut nanoseconds: i64 = u32.toI64(self.nanoseconds) - u32.toI64(other.nanoseconds)
    let mut borrow: i64 = 0
    if nanoseconds < 0 {
      nanoseconds = nanoseconds + BILLION
      borrow = 1
    }
    match i64.checkedSubtract(self.seconds, other.seconds) {
      Option<i64>.Some { value } => {
        match i64.checkedSubtract(value, borrow) {
          Option<i64>.Some { value: difference } => {
            return Option<Duration>.some(
              Duration { seconds: difference, nanoseconds: i64.toU32(nanoseconds) },
            )
          }
          Option<i64>.None => {
            return Option<Duration>.none()
          }
        }
      }
      Option<i64>.None => {
        // Only a positive overflow by exactly one second can come back in range through the
        // borrow.
        if borrow == 1 && self.seconds >= 0 && other.seconds < 0
          && i64.wrappingSubtract(self.seconds, other.seconds) == i64.MIN {
          return Option<Duration>.some(
            Duration { seconds: i64.MAX, nanoseconds: i64.toU32(nanoseconds) },
          )
        }
        return Option<Duration>.none()
      }
    }
  }

  /// Returns the span `factor` times, or `None` when the product is outside the range.
  pub fn checkedMultiply(self: Self, factor: i64) -> Option<Duration> {
    // factor = high * 1e9 + low with |low| < 1e9. Then
    // nanoseconds * factor = (nanoseconds * high) seconds + (nanoseconds * low) nanoseconds,
    // and both products fit an i64: nanoseconds < 1e9, |high| < 9.3e9, |low| < 1e9.
    let nanoseconds = u32.toI64(self.nanoseconds)
    let high = factor / BILLION
    let low = factor % BILLION
    match i64.checkedMultiply(self.seconds, factor) {
      Option<i64>.Some { value } => {
        match i64.checkedAdd(value, nanoseconds * high) {
          Option<i64>.Some { value: seconds } => {
            return Duration.checkedMake(seconds, nanoseconds * low)
          }
          Option<i64>.None => {
            return Option<Duration>.none()
          }
        }
      }
      Option<i64>.None => {
        return Option<Duration>.none()
      }
    }
  }

  fn same(left: &Duration, right: &Duration) -> bool {
    return left.seconds == right.seconds && left.nanoseconds == right.nanoseconds
  }

  fn compare(left: &Duration, right: &Duration) -> Ordering {
    if left.seconds < right.seconds {
      return Ordering.Less
    }
    if left.seconds > right.seconds {
      return Ordering.Greater
    }
    if left.nanoseconds < right.nanoseconds {
      return Ordering.Less
    }
    if left.nanoseconds > right.nanoseconds {
      return Ordering.Greater
    }
    return Ordering.Equal
  }

  fn addOperator(left: Duration, right: Duration) -> Duration {
    return orTrap(left.checkedAdd(right), "Duration: the sum is outside the Duration range")
  }

  fn subtractOperator(left: Duration, right: Duration) -> Duration {
    return orTrap(
      left.checkedSubtract(right),
      "Duration: the difference is outside the Duration range",
    )
  }

  fn multiplyOperator(left: Duration, right: i64) -> Duration {
    return orTrap(left.checkedMultiply(right), "Duration: the product is outside the Duration range")
  }

  fn multiplyOperator32(left: Duration, right: i32) -> Duration {
    return Duration.multiplyOperator(left, i32.toI64(right))
  }

  fn negateOperator(value: Duration) -> Duration {
    return orTrap(value.checkedNegate(), "Duration: the opposite is outside the Duration range")
  }
}

impl Equal for Duration {
  equals: Duration.same
}

impl Order for Duration {
  compare: Duration.compare
}

impl Add<Duration, Duration> for Duration {
  add: Duration.addOperator
}

impl Subtract<Duration, Duration> for Duration {
  subtract: Duration.subtractOperator
}

impl Multiply<i64, Duration> for Duration {
  multiply: Duration.multiplyOperator
}

impl Multiply<i32, Duration> for Duration {
  multiply: Duration.multiplyOperator32
}

impl Negate<Duration> for Duration {
  negate: Duration.negateOperator
}

/// Writes the span as an ISO 8601 duration in hours, minutes, and seconds, such as `PT1H30M`,
/// `PT0.5S`, or `-PT45S`. The empty span is `PT0S`.
impl Display for Duration {
  effect fn display(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    let mut output: [u8; 40] = [0; 40]
    let length = writeIso(self.*, &mut output)
    return run Format.write(&mut formatter, Slice.view<u8>(&output, 0, length))
  }
}

/// Writes the same text as `Display`: an ISO 8601 duration such as `PT1H30M`.
impl Debug for Duration {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return run Display.display(self, &mut formatter)
  }
}

fn orTrap(result: Option<Duration>, message: string<'static>) -> Duration {
  match result {
    Option<Duration>.Some { value } => {
      return value
    }
    Option<Duration>.None => {
      return Intrinsic.trap(message)
    }
  }
}

fn scaled(count: i64, factor: i64, name: string<'static>) -> i64 {
  match i64.checkedMultiply(count, factor) {
    Option<i64>.Some { value } => {
      return value
    }
    Option<i64>.None => {
      return Intrinsic.trap(name)
    }
  }
}

// The span of `count` units, where `perSecond` units make a second and one unit is `unit`
// nanoseconds.
fn split(count: i64, perSecond: i64, unit: i64) -> Duration {
  let mut seconds = count / perSecond
  let mut rest = count % perSecond
  if rest < 0 {
    seconds = seconds - 1
    rest = rest + perSecond
  }
  return Duration { seconds: seconds, nanoseconds: i64.toU32(rest * unit) }
}

// The span in units of `unit` nanoseconds, rounded toward zero, where `perSecond` units make a
// second.
fn total(span: Duration, perSecond: i64, unit: i64) -> Option<i64> {
  let mut seconds = span.seconds
  let mut nanoseconds = u32.toI64(span.nanoseconds)
  // Move a negative span to sign-and-magnitude form so that the division rounds toward zero.
  if seconds < 0 && nanoseconds > 0 {
    seconds = seconds + 1
    nanoseconds = nanoseconds - BILLION
  }
  match i64.checkedMultiply(seconds, perSecond) {
    Option<i64>.Some { value } => {
      return i64.checkedAdd(value, nanoseconds / unit)
    }
    Option<i64>.None => {
      return Option<i64>.none()
    }
  }
}

fn writeDigits(output: &mut [u8; 40], start: usize, value: u64) -> usize {
  let mut digits: [u8; 20] = [0; 20]
  let mut at: usize = 20
  let mut rest = value
  while true {
    at = at - 1
    digits[at] = u64.toU8(rest % 10) + 48
    rest = rest / 10
    if rest == 0 {
      break
    }
  }
  let mut to = start
  while at < 20 {
    output[to] = digits[at]
    to = to + 1
    at = at + 1
  }
  return to
}

// Writes the ISO 8601 text of `span` into `output` and returns its length. The longest text is
// `-PT2562047788015215H30M8.999999999S`, 35 bytes.
fn writeIso(span: Duration, output: &mut [u8; 40]) -> usize {
  let mut at: usize = 0
  // Magnitude in unsigned seconds and nanoseconds, which also holds the most negative span.
  let mut seconds: u64 = 0
  let mut nanoseconds: u32 = span.nanoseconds
  if span.seconds < 0 {
    output[at] = 45
    at = at + 1
    if nanoseconds == 0 {
      seconds = u64.wrappingSubtract(0, i64.wrappingToU64(span.seconds))
    } else {
      seconds = u64.wrappingSubtract(0, i64.wrappingToU64(span.seconds)) - 1
      nanoseconds = 1000000000 - nanoseconds
    }
  } else {
    seconds = i64.toU64(span.seconds)
  }
  output[at] = 80
  output[at + 1] = 84
  at = at + 2
  let hours = seconds / 3600
  let minutes = (seconds % 3600) / 60
  let rest = seconds % 60
  if hours != 0 {
    at = writeDigits(&mut output, at, hours)
    output[at] = 72
    at = at + 1
  }
  if minutes != 0 {
    at = writeDigits(&mut output, at, minutes)
    output[at] = 77
    at = at + 1
  }
  if rest != 0 || nanoseconds != 0 || (hours == 0 && minutes == 0) {
    at = writeDigits(&mut output, at, rest)
    if nanoseconds != 0 {
      output[at] = 46
      at = at + 1
      let mut divisor: u32 = 100000000
      let mut left = nanoseconds
      while left != 0 {
        output[at] = u32.toU8(left / divisor) + 48
        at = at + 1
        left = left % divisor
        divisor = divisor / 10
      }
    }
    output[at] = 83
    at = at + 1
  }
  return at
}
