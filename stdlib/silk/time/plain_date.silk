//! Calendar dates without a time or a time zone: the [`PlainDate`] type and [`Weekday`].
//!
//! # When to use
//!
//! Use [`PlainDate`] for a day that means the same thing everywhere, such as a birthday, a due
//! date, or a date in a file. It is not a point in time: the same date starts at different
//! instants in different time zones. For a point in time, use `silk.time.instant`.
//!
//! # Details
//!
//! Dates are in the ISO 8601 calendar, which applies the Gregorian leap year rule to every year.
//! The range is `-271821-04-19` to `+275760-09-13`, the range of ECMAScript Temporal. Values are
//! always valid dates: a `PlainDate` cannot hold February 30.
//!
//! # Examples
//!
//! ## Parse a date, move it, and print it
//!
//! ```silk
//! import silk.core.result { Result }
//! import silk.time.plain_date { PlainDate, Weekday }
//! import silk.time.text { TimeParseError }
//!
//! pub fn main() -> i32 {
//!   match PlainDate.parse("2026-11-19") {
//!     Result<PlainDate, TimeParseError>.Success { value } => {
//!       let later = value.addDays(45)
//!       if later.year() != 2027 || later.month() != 1 || later.day() != 3 {
//!         return 1
//!       }
//!       if value.daysUntil(later) != 45 {
//!         return 2
//!       }
//!       match value.weekday() {
//!         Weekday.Thursday => {
//!           return 0
//!         }
//!         _ => {
//!           return 3
//!         }
//!       }
//!     }
//!     Result<PlainDate, TimeParseError>.Failure { error: _ } => {
//!       return 4
//!     }
//!   }
//! }
//! ```
//!
//! @category Time
import silk.core.equal { Equal }
import silk.core.option { Option }
import silk.core.order { Order, Ordering }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.text.format { Debug, Display, Format, Formatter }
import silk.text.string { String }
import silk.collections.slice { Slice }
import silk.time.civil as Civil
import silk.time.civil { CivilDate }
import silk.time.duration { Duration }
import silk.time.period { DateUnit, Overflow, Period }
import silk.time.text as Text
import silk.time.text { OffsetKind, Scanner, TimeParseError, TimeParseReason }
import silk.num.i32
import silk.num.i64
import silk.num.u16
import silk.num.u8

// Days from 1970-01-01 to the first and the last date of the range.
const MIN_DAYS: i64 = -100000001
const MAX_DAYS: i64 = 100000000

/// A day of the week.
pub enum Weekday {
  /// Day 1 of the ISO 8601 week.
  Monday,
  /// Day 2 of the ISO 8601 week.
  Tuesday,
  /// Day 3 of the ISO 8601 week.
  Wednesday,
  /// Day 4 of the ISO 8601 week.
  Thursday,
  /// Day 5 of the ISO 8601 week.
  Friday,
  /// Day 6 of the ISO 8601 week.
  Saturday,
  /// Day 7 of the ISO 8601 week.
  Sunday,
}

impl Weekday {
  /// Returns the ISO 8601 number of the day: 1 for Monday to 7 for Sunday.
  pub fn number(self: Self) -> u8 {
    return match self {
      Weekday.Monday => 1
      Weekday.Tuesday => 2
      Weekday.Wednesday => 3
      Weekday.Thursday => 4
      Weekday.Friday => 5
      Weekday.Saturday => 6
      Weekday.Sunday => 7
    }
  }

  /// Returns the day with the ISO 8601 number `number`, 1 for Monday to 7 for Sunday, or `None`
  /// for another number.
  pub fn fromNumber(number: u8) -> Option<Weekday> {
    return match number {
      1 => Option<Weekday>.some(Weekday.Monday)
      2 => Option<Weekday>.some(Weekday.Tuesday)
      3 => Option<Weekday>.some(Weekday.Wednesday)
      4 => Option<Weekday>.some(Weekday.Thursday)
      5 => Option<Weekday>.some(Weekday.Friday)
      6 => Option<Weekday>.some(Weekday.Saturday)
      7 => Option<Weekday>.some(Weekday.Sunday)
      _ => Option<Weekday>.none()
    }
  }

  /// Returns the English name of the day, such as `Monday`.
  pub fn name(self: Self) -> string<'static> {
    return match self {
      Weekday.Monday => "Monday"
      Weekday.Tuesday => "Tuesday"
      Weekday.Wednesday => "Wednesday"
      Weekday.Thursday => "Thursday"
      Weekday.Friday => "Friday"
      Weekday.Saturday => "Saturday"
      Weekday.Sunday => "Sunday"
    }
  }
}

/// Writes the English name of the day, such as `Monday`.
impl Debug for Weekday {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return run Format.writeText(&mut formatter, Weekday.name(self.*))
  }
}

/// A calendar date in the ISO 8601 calendar: a year, a month, and a day, with no time and no time
/// zone.
///
/// # Details
///
/// A value is always a date that exists, from `-271821-04-19` to `+275760-09-13`. Year 0 is the
/// year before year 1. `==`, `!=`, `<`, `<=`, `>`, and `>=` compare dates in calendar order.
/// `Display` writes `YYYY-MM-DD`, with a sign and six digits for a year outside 0 to 9999.
pub struct PlainDate {
  isoYear: i32,
  isoMonth: u8,
  isoDay: u8,
}

impl Copy for PlainDate {}

impl PlainDate {
  /// Returns the date with the given year, month from 1 to 12, and day of the month from 1.
  ///
  /// # Gotchas
  ///
  /// A date that does not exist, such as February 30, or a date outside the range traps.
  /// [`PlainDate.checkedMake`] returns `None` instead.
  pub fn make(year: i32, month: u8, day: u8) -> PlainDate {
    return orTrap(
      PlainDate.checkedMake(year, month, day),
      "PlainDate.make: the date does not exist or is outside the PlainDate range",
    )
  }

  /// Returns the date with the given year, month from 1 to 12, and day of the month from 1, or
  /// `None` when that date does not exist or is outside `-271821-04-19` to `+275760-09-13`.
  pub fn checkedMake(year: i32, month: u8, day: u8) -> Option<PlainDate> {
    if month < 1 || month > 12 || day < 1 || year < -271821 || year > 275760 {
      return Option<PlainDate>.none()
    }
    if day > Civil.daysInMonth(year, month) {
      return Option<PlainDate>.none()
    }
    if year == -271821 || year == 275760 {
      let days = Civil.daysFromCivil(year, month, day)
      if days < MIN_DAYS || days > MAX_DAYS {
        return Option<PlainDate>.none()
      }
    }
    return Option<PlainDate>.some(PlainDate { isoYear: year, isoMonth: month, isoDay: day })
  }

  /// Returns the first date of the range, `-271821-04-19`.
  pub fn min() -> PlainDate {
    return PlainDate { isoYear: -271821, isoMonth: 4, isoDay: 19 }
  }

  /// Returns the last date of the range, `+275760-09-13`.
  pub fn max() -> PlainDate {
    return PlainDate { isoYear: 275760, isoMonth: 9, isoDay: 13 }
  }

  /// Returns the date that is `days` days after `1970-01-01`, or `None` when it is outside the
  /// range. `days` can be negative.
  pub fn fromEpochDays(days: i64) -> Option<PlainDate> {
    if days < MIN_DAYS || days > MAX_DAYS {
      return Option<PlainDate>.none()
    }
    let civil = Civil.civilFromDays(days)
    return Option<PlainDate>.some(
      PlainDate { isoYear: civil.year, isoMonth: civil.month, isoDay: civil.day },
    )
  }

  /// Returns the number of days from `1970-01-01` to this date. It is negative for an earlier
  /// date.
  pub fn toEpochDays(self: Self) -> i64 {
    return Civil.daysFromCivil(self.isoYear, self.isoMonth, self.isoDay)
  }

  /// Returns the year. Year 0 is the year before year 1.
  pub fn year(self: Self) -> i32 {
    return self.isoYear
  }

  /// Returns the month, from 1 for January to 12 for December.
  pub fn month(self: Self) -> u8 {
    return self.isoMonth
  }

  /// Returns the day of the month, from 1.
  pub fn day(self: Self) -> u8 {
    return self.isoDay
  }

  /// Returns the year, month, and day as plain numbers.
  pub fn toCivil(self: Self) -> CivilDate {
    return CivilDate { year: self.isoYear, month: self.isoMonth, day: self.isoDay }
  }

  /// Returns the day of the week.
  pub fn weekday(self: Self) -> Weekday {
    return weekdayOf(Civil.weekdayFromDays(self.toEpochDays()))
  }

  /// Returns the day of the year: 1 for January 1, up to 365, or 366 in a leap year.
  pub fn dayOfYear(self: Self) -> u16 {
    return Civil.dayOfYear(self.isoYear, self.isoMonth, self.isoDay)
  }

  /// Returns the ISO 8601 week number of the date, from 1 to 53.
  ///
  /// # Details
  ///
  /// Weeks start on Monday, and week 1 is the week with the first Thursday of the year. So the
  /// first days of January can be in week 52 or 53 of the year before, and the last days of
  /// December can be in week 1 of the next year. [`PlainDate.yearOfWeek`] gives the year that the
  /// week belongs to.
  pub fn weekOfYear(self: Self) -> u8 {
    return i32.toU8(isoWeek(self, false))
  }

  /// Returns the year that the ISO 8601 week of the date belongs to.
  ///
  /// # Details
  ///
  /// It differs from [`PlainDate.year`] for the days of January in the last week of the year
  /// before, and the days of December in week 1 of the next year. `2027-01-01` is in week 53 of
  /// 2026.
  pub fn yearOfWeek(self: Self) -> i32 {
    return isoWeek(self, true)
  }

  /// Returns the number of days in the month of the date, from 28 to 31.
  pub fn daysInMonth(self: Self) -> u8 {
    return Civil.daysInMonth(self.isoYear, self.isoMonth)
  }

  /// Returns the number of days in the year of the date: 366 in a leap year, 365 otherwise.
  pub fn daysInYear(self: Self) -> u16 {
    return Civil.daysInYear(self.isoYear)
  }

  /// Returns `true` if the year of the date is a leap year.
  pub fn inLeapYear(self: Self) -> bool {
    return Civil.isLeapYear(self.isoYear)
  }

  /// Returns the date `days` days later, or earlier for a negative count, or `None` when it is
  /// outside the range.
  pub fn checkedAddDays(self: Self, days: i64) -> Option<PlainDate> {
    match i64.checkedAdd(self.toEpochDays(), days) {
      Option<i64>.Some { value } => {
        return PlainDate.fromEpochDays(value)
      }
      Option<i64>.None => {
        return Option<PlainDate>.none()
      }
    }
  }

  /// Returns the date `days` days later, or earlier for a negative count.
  ///
  /// # Gotchas
  ///
  /// A result outside the range traps. [`PlainDate.checkedAddDays`] returns `None` instead.
  pub fn addDays(self: Self, days: i64) -> PlainDate {
    return orTrap(
      self.checkedAddDays(days),
      "PlainDate.addDays: the date is outside the PlainDate range",
    )
  }

  /// Returns the number of days from this date to `other`. It is negative when `other` is earlier.
  pub fn daysUntil(self: Self, other: PlainDate) -> i64 {
    return other.toEpochDays() - self.toEpochDays()
  }

  /// Returns the date that `period` leads to from this date, or `None` when it is outside the
  /// range, or when `overflow` is `Reject` and the day does not exist in the month reached.
  ///
  /// # Details
  ///
  /// The years and months are added first. If the month reached has no such day, as for one
  /// month after January 31, `Overflow.Constrain` uses the last day of that month. Then the
  /// weeks and days are added, with the whole days of the time part of the period; the rest of
  /// the time part is dropped. This is the rule of ECMAScript Temporal.
  ///
  /// # Gotchas
  ///
  /// The order matters, so adding and then subtracting the same period does not always return
  /// the first date: January 31 plus one month is the end of February, and one month before
  /// that is January 28 or 29.
  pub fn checkedAddPeriod(self: Self, period: Period, overflow: Overflow) -> Option<PlainDate> {
    let seconds = period.time().absolute().wholeSeconds() / 86400
    let timeDays = if period.time().sign() < 0 { -seconds } else { seconds }
    return self.checkedAddParts(
      period.years(),
      period.months(),
      period.weeks() * 7 + period.days() + timeDays,
      overflow,
    )
  }

  /// Returns the date that `period` leads to from this date, with a day that does not exist in
  /// the month reached replaced by the last day of that month.
  ///
  /// # Details
  ///
  /// The rule is the one of [`PlainDate.checkedAddPeriod`] with `Overflow.Constrain`. To go
  /// back, add `period.negate()`.
  ///
  /// # Gotchas
  ///
  /// A result outside the range traps. [`PlainDate.checkedAddPeriod`] returns `None` instead.
  pub fn addPeriod(self: Self, period: Period) -> PlainDate {
    return orTrap(
      self.checkedAddPeriod(period, Overflow.Constrain),
      "PlainDate.addPeriod: the date is outside the PlainDate range",
    )
  }

  /// Returns the date `years` years and `months` months from this date, and then `days` days
  /// from there, or `None` when it is outside the range, or when `overflow` is `Reject` and the
  /// day does not exist in the month reached.
  ///
  /// # Details
  ///
  /// It is [`PlainDate.checkedAddPeriod`] for counts that can have different signs, such as one
  /// month later and one day earlier.
  pub fn checkedAddParts(self: Self, years: i64, months: i64, days: i64, overflow: Overflow) -> Option<PlainDate> {
    // No count of days brings a year outside this limit back into the range.
    if years < -300000000 || years > 300000000 || months < -3600000000 || months > 3600000000 {
      return Option<PlainDate>.none()
    }
    let total = (i32.toI64(self.isoYear) + years) * 12 + u8.toI64(self.isoMonth) - 1 + months
    let mut year = total / 12
    let mut month = total % 12
    if month < 0 {
      month = month + 12
      year = year - 1
    }
    if year < -600000000 || year > 600000000 {
      return Option<PlainDate>.none()
    }
    let reachedYear = i64.toI32(year)
    let reachedMonth = i64.toU8(month + 1)
    let mut day = self.isoDay
    let last = Civil.daysInMonth(reachedYear, reachedMonth)
    if day > last {
      match overflow {
        Overflow.Constrain => {
          day = last
        }
        Overflow.Reject => {
          return Option<PlainDate>.none()
        }
      }
    }
    match i64.checkedAdd(Civil.daysFromCivil(reachedYear, reachedMonth, day), days) {
      Option<i64>.Some { value } => {
        return PlainDate.fromEpochDays(value)
      }
      Option<i64>.None => {
        return Option<PlainDate>.none()
      }
    }
  }

  /// Returns the calendar span from this date to `other`, counted in `largest` units first. It
  /// is negative when `other` is earlier, and its time part is empty.
  ///
  /// # Details
  ///
  /// With `DateUnit.Year` or `DateUnit.Month`, the result has the most whole months that can be
  /// added to this date without passing `other`, and then the days that are left. With
  /// `DateUnit.Week`, it has whole weeks and days, and with `DateUnit.Day`, only days. Adding
  /// the result to this date with [`PlainDate.addPeriod`] gives `other`. This is the rule of
  /// ECMAScript Temporal.
  ///
  /// # Gotchas
  ///
  /// The span from `other` back to this date is not always the negated result. From
  /// 2023-01-29 to 2023-03-01 is 1 month and 1 day, and from 2023-03-01 back to 2023-01-29 is 1
  /// month and 3 days.
  pub fn periodUntil(self: Self, other: PlainDate, largest: DateUnit) -> Period {
    let direction: i64 = match PlainDate.compare(&self, &other) {
      Ordering.Less => 1
      Ordering.Equal => 0
      Ordering.Greater => -1
    }
    if direction == 0 {
      return Period.zero()
    }
    let mut months: i64 = 0
    match largest {
      DateUnit.Year => {
        months = self.wholeMonthsUntil(other, direction)
      }
      DateUnit.Month => {
        months = self.wholeMonthsUntil(other, direction)
      }
      _ => {}
    }
    let mut from = self.toEpochDays()
    if months != 0 {
      match self.checkedAddParts(0, months, 0, Overflow.Constrain) {
        Option<PlainDate>.Some { value } => {
          from = value.toEpochDays()
        }
        Option<PlainDate>.None => {}
      }
    }
    let days = other.toEpochDays() - from
    return match largest {
      DateUnit.Year => Period.make(months / 12, months % 12, 0, days, Duration.zero())
      DateUnit.Month => Period.make(0, months, 0, days, Duration.zero())
      DateUnit.Week => Period.make(0, 0, days / 7, days % 7, Duration.zero())
      DateUnit.Day => Period.make(0, 0, 0, days, Duration.zero())
    }
  }

  // The most months, in `direction`, that lead from this date to a year, month, and day that is
  // not past `other`. The day is compared as written, also when the month reached is shorter.
  fn wholeMonthsUntil(self: Self, other: PlainDate, direction: i64) -> i64 {
    let months = (i32.toI64(other.isoYear) - i32.toI64(self.isoYear)) * 12
      + u8.toI64(other.isoMonth) - u8.toI64(self.isoMonth)
    if direction * (u8.toI64(self.isoDay) - u8.toI64(other.isoDay)) > 0 {
      return months - direction
    }
    return months
  }

  /// Reads a date from ISO 8601 text such as `2026-11-19`.
  ///
  /// # Details
  ///
  /// The text is `YYYY-MM-DD` or `YYYYMMDD`; a year outside 0 to 9999 has a sign and six digits.
  /// A time, a numeric UTC offset, and bracketed annotations can follow, as in
  /// `2026-11-19T17:36:22+01:00[Europe/Rome]`. They are checked and then ignored.
  ///
  /// # Errors
  ///
  /// - `TimeParseReason.UnexpectedEnd` or `UnexpectedCharacter` if the text does not have that
  ///   form.
  /// - `TimeParseReason.OutOfRange` if a field names no real value, such as month 13 or February
  ///   30, or the date is outside `-271821-04-19` to `+275760-09-13`.
  /// - `TimeParseReason.UtcNotAllowed` if the text has the UTC designator `Z`.
  /// - `TimeParseReason.UnsupportedCalendar` if a calendar annotation is not `[u-ca=iso8601]`.
  /// - `TimeParseReason.UnknownCriticalAnnotation` if an annotation with an unknown key starts
  ///   with `!`.
  pub fn parse(text: string) -> Result<PlainDate, TimeParseError> {
    return PlainDate.parseBytes(String.utf8Bytes(text))
  }

  /// Reads a date from the bytes of ISO 8601 text such as `2026-11-19`.
  ///
  /// # Details
  ///
  /// The text is `YYYY-MM-DD` or `YYYYMMDD`; a year outside 0 to 9999 has a sign and six digits.
  /// A time, a numeric UTC offset, and bracketed annotations can follow. They are checked and then
  /// ignored.
  ///
  /// # Errors
  ///
  /// - `TimeParseReason.UnexpectedEnd` or `UnexpectedCharacter` if the text does not have that
  ///   form.
  /// - `TimeParseReason.OutOfRange` if a field names no real value, such as month 13 or February
  ///   30, or the date is outside `-271821-04-19` to `+275760-09-13`.
  /// - `TimeParseReason.UtcNotAllowed` if the text has the UTC designator `Z`.
  /// - `TimeParseReason.UnsupportedCalendar` if a calendar annotation is not `[u-ca=iso8601]`.
  /// - `TimeParseReason.UnknownCriticalAnnotation` if an annotation with an unknown key starts
  ///   with `!`.
  pub fn parseBytes(bytes: &[u8]) -> Result<PlainDate, TimeParseError> {
    let mut scanner = Scanner.make(bytes)
    let parsed = scanner.dateTime()
    match scanner.failure() {
      Option<TimeParseError>.Some { value } => {
        return Result<PlainDate, TimeParseError>.failResult(value)
      }
      Option<TimeParseError>.None => {}
    }
    match parsed.offset.kind {
      OffsetKind.Utc => {
        return Result<PlainDate, TimeParseError>.failResult(
          TimeParseError { reason: TimeParseReason.UtcNotAllowed, offset: 0 },
        )
      }
      _ => {}
    }
    match PlainDate.checkedMake(parsed.date.year, parsed.date.month, parsed.date.day) {
      Option<PlainDate>.Some { value } => {
        return Result<PlainDate, TimeParseError>.succeed(value)
      }
      Option<PlainDate>.None => {
        return Result<PlainDate, TimeParseError>.failResult(
          TimeParseError { reason: TimeParseReason.OutOfRange, offset: 0 },
        )
      }
    }
  }

  fn same(left: &PlainDate, right: &PlainDate) -> bool {
    return left.isoYear == right.isoYear && left.isoMonth == right.isoMonth && left.isoDay == right.isoDay
  }

  fn compare(left: &PlainDate, right: &PlainDate) -> Ordering {
    if left.isoYear != right.isoYear {
      if left.isoYear < right.isoYear {
        return Ordering.Less
      }
      return Ordering.Greater
    }
    if left.isoMonth != right.isoMonth {
      if left.isoMonth < right.isoMonth {
        return Ordering.Less
      }
      return Ordering.Greater
    }
    if left.isoDay < right.isoDay {
      return Ordering.Less
    }
    if left.isoDay > right.isoDay {
      return Ordering.Greater
    }
    return Ordering.Equal
  }
}

impl Equal for PlainDate {
  equals: PlainDate.same
}

impl Order for PlainDate {
  compare: PlainDate.compare
}

/// Writes the date as `YYYY-MM-DD`, with a sign and six digits for a year outside 0 to 9999, as in
/// `2026-11-19` or `-000044-03-15`.
impl Display for PlainDate {
  effect fn display(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    let mut output: [u8; 13] = [0; 13]
    let length = Text.writeDate(&mut output, 0, PlainDate.toCivil(self.*))
    return run Format.write(&mut formatter, Slice.view<u8>(&output, 0, length))
  }
}

/// Writes the same text as `Display`: the date as `YYYY-MM-DD`.
impl Debug for PlainDate {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return run Display.display(self, &mut formatter)
  }
}

fn orTrap(result: Option<PlainDate>, message: string<'static>) -> PlainDate {
  match result {
    Option<PlainDate>.Some { value } => {
      return value
    }
    Option<PlainDate>.None => {
      return Intrinsic.trap(message)
    }
  }
}

fn weekdayOf(number: u8) -> Weekday {
  return match number {
    1 => Weekday.Monday
    2 => Weekday.Tuesday
    3 => Weekday.Wednesday
    4 => Weekday.Thursday
    5 => Weekday.Friday
    6 => Weekday.Saturday
    _ => Weekday.Sunday
  }
}

// The ISO 8601 weeks in `year`: 53 when January 1 is a Thursday, or a Wednesday in a leap year.
fn weeksInYear(year: i32) -> i32 {
  let first = Civil.weekdayFromDays(Civil.daysFromCivil(year, 1, 1))
  if first == 4 || (first == 3 && Civil.isLeapYear(year)) {
    return 53
  }
  return 52
}

// The ISO 8601 week of `date`: the year the week belongs to if `wantYear`, else the week number.
fn isoWeek(date: PlainDate, wantYear: bool) -> i32 {
  let ordinal = u16.toI32(Civil.dayOfYear(date.isoYear, date.isoMonth, date.isoDay))
  let weekday = u8.toI32(Civil.weekdayFromDays(date.toEpochDays()))
  let mut year = date.isoYear
  let mut week = (ordinal - weekday + 10) / 7
  if week < 1 {
    year = year - 1
    week = weeksInYear(year)
  } else if week == 53 && weeksInYear(year) == 52 {
    year = year + 1
    week = 1
  }
  if wantYear {
    return year
  }
  return week
}
