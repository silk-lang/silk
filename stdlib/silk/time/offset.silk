//! Fixed offsets from UTC: the [`UtcOffset`] type.
//!
//! # When to use
//!
//! Use [`UtcOffset`] for the `+01:00` part of a timestamp: how far a local clock is ahead of or
//! behind UTC at one moment. It is not a time zone. A zone such as `Europe/Rome` has different
//! offsets in summer and in winter.
//!
//! # Details
//!
//! An offset is a whole number of seconds east of UTC, less than 24 hours in each direction.
//! Local time is UTC plus the offset, so `17:00` at `+01:00` is `16:00` UTC.
//!
//! # Examples
//!
//! ## Parse an offset and read it
//!
//! ```silk
//! import silk.core.result { Result }
//! import silk.time.offset { UtcOffset }
//! import silk.time.text { TimeParseError }
//!
//! pub fn main() -> i32 {
//!   match UtcOffset.parse("-03:30") {
//!     Result<UtcOffset, TimeParseError>.Success { value } => {
//!       if value.totalSeconds() != -12600 {
//!         return 1
//!       }
//!       return 0
//!     }
//!     Result<UtcOffset, TimeParseError>.Failure { error: _ } => {
//!       return 2
//!     }
//!   }
//! }
//! ```
//!
//! @category Time
import silk.core.equal { Equal }
import silk.core.option { Option }
import silk.core.order { Order, Ordering }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.text.format { Debug, Display, Format, Formatter }
import silk.text.string { String }
import silk.collections.slice { Slice }
import silk.time.duration { Duration }
import silk.time.text as Text
import silk.time.text { OffsetKind, Scanner, TimeParseError, TimeParseReason }
import silk.num.i32
import silk.num.u8

/// A fixed offset from UTC in whole seconds, less than 24 hours in each direction.
///
/// # Details
///
/// The offset is positive east of UTC: local time is UTC plus the offset. `==`, `!=`, `<`, `<=`,
/// `>`, and `>=` compare the number of seconds. `Display` writes `+HH:MM`, or `+HH:MM:SS` when the
/// offset has a seconds part.
pub struct UtcOffset {
  seconds: i32,
}

impl Copy for UtcOffset {}

impl UtcOffset {
  /// Returns the zero offset, which is UTC.
  pub fn utc() -> UtcOffset {
    return UtcOffset { seconds: 0 }
  }

  /// Returns the offset of `seconds` seconds east of UTC, or west for a negative count.
  ///
  /// # Gotchas
  ///
  /// An offset of 24 hours or more traps. [`UtcOffset.checkedFromSeconds`] returns `None` instead.
  pub fn fromSeconds(seconds: i32) -> UtcOffset {
    match UtcOffset.checkedFromSeconds(seconds) {
      Option<UtcOffset>.Some { value } => {
        return value
      }
      Option<UtcOffset>.None => {
        return Intrinsic.trap("UtcOffset.fromSeconds: the offset is 24 hours or more")
      }
    }
  }

  /// Returns the offset of `seconds` seconds east of UTC, or west for a negative count, or `None`
  /// when it is 24 hours or more in either direction.
  pub fn checkedFromSeconds(seconds: i32) -> Option<UtcOffset> {
    if seconds <= -86400 || seconds >= 86400 {
      return Option<UtcOffset>.none()
    }
    return Option<UtcOffset>.some(UtcOffset { seconds: seconds })
  }

  /// Returns the offset of `minutes` minutes east of UTC, or west for a negative count.
  ///
  /// # Gotchas
  ///
  /// An offset of 24 hours or more traps.
  pub fn fromMinutes(minutes: i32) -> UtcOffset {
    if minutes <= -1440 || minutes >= 1440 {
      return Intrinsic.trap("UtcOffset.fromMinutes: the offset is 24 hours or more")
    }
    return UtcOffset { seconds: minutes * 60 }
  }

  /// Returns the offset in seconds east of UTC. It is negative west of UTC.
  pub fn totalSeconds(self: Self) -> i32 {
    return self.seconds
  }

  /// Returns `true` if the offset is zero.
  pub fn isUtc(self: Self) -> bool {
    return self.seconds == 0
  }

  /// Returns the offset as a span: positive east of UTC.
  pub fn toDuration(self: Self) -> Duration {
    return Duration.fromSeconds(i32.toI64(self.seconds))
  }

  /// Reads an offset from text such as `+01:00`, `-0330`, or `Z`.
  ///
  /// # Details
  ///
  /// The text is `Z` or `z` for UTC, or a sign and `HH`, `HH:MM`, `HHMM`, `HH:MM:SS`, or `HHMMSS`.
  ///
  /// # Errors
  ///
  /// - `TimeParseReason.UnexpectedEnd` or `UnexpectedCharacter` if the text does not have that
  ///   form.
  /// - `TimeParseReason.OutOfRange` if the hour is above 23 or the minute or second is above 59.
  pub fn parse(text: string) -> Result<UtcOffset, TimeParseError> {
    let mut scanner = Scanner.make(String.utf8Bytes(text))
    let parsed = scanner.offset()
    scanner.end()
    match scanner.failure() {
      Option<TimeParseError>.Some { value } => {
        return Result<UtcOffset, TimeParseError>.failResult(value)
      }
      Option<TimeParseError>.None => {}
    }
    match parsed.kind {
      OffsetKind.Absent => {
        // An empty text. Other texts without an offset fail in `end`.
        return Result<UtcOffset, TimeParseError>.failResult(
          TimeParseError { reason: TimeParseReason.UnexpectedEnd, offset: 0 },
        )
      }
      _ => {
        return Result<UtcOffset, TimeParseError>.succeed(UtcOffset { seconds: parsed.seconds })
      }
    }
  }

  fn same(left: &UtcOffset, right: &UtcOffset) -> bool {
    return left.seconds == right.seconds
  }

  fn compare(left: &UtcOffset, right: &UtcOffset) -> Ordering {
    if left.seconds < right.seconds {
      return Ordering.Less
    }
    if left.seconds > right.seconds {
      return Ordering.Greater
    }
    return Ordering.Equal
  }
}

impl Equal for UtcOffset {
  equals: UtcOffset.same
}

impl Order for UtcOffset {
  compare: UtcOffset.compare
}

/// Writes the offset as `+HH:MM`, or `+HH:MM:SS` when it has a seconds part, with `-` west of UTC.
/// The zero offset is `+00:00`.
impl Display for UtcOffset {
  effect fn display(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    let mut output: [u8; 9] = [0; 9]
    let length = Text.writeOffset(&mut output, 0, self.seconds)
    return run Format.write(&mut formatter, Slice.view<u8>(&output, 0, length))
  }
}

/// Writes the same text as `Display`: the offset as `+HH:MM` or `+HH:MM:SS`.
impl Debug for UtcOffset {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return run Display.display(self, &mut formatter)
  }
}
