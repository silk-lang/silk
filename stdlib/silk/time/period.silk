//! Calendar spans: the [`Period`] type, a number of years, months, weeks, and days with an exact
//! time part, as in "1 month and 2 days".
//!
//! # When to use
//!
//! Use [`Period`] for a span that a person counts on a calendar: a monthly bill, an age, three
//! weeks of leave. Its length in seconds depends on where it starts, because months and years
//! differ in length and a day in a time zone can have 23 or 25 hours. For a span of a fixed
//! length, such as a timeout, use `Duration` of `silk.time.duration`.
//!
//! # Details
//!
//! A `Period` has four calendar fields and one `Duration` for the time below a day. All parts
//! that are not zero have the same sign. The calendar fields are not balanced: 14 months stay
//! 14 months, and 1 month is not equal to 30 days. The time part is exact, so 90 minutes and
//! 1 hour 30 minutes are the same value.
//!
//! The text form is the ISO 8601 duration, such as `P1Y2M3DT4H30M`. `PlainDate.addPeriod` and
//! `PlainDate.periodUntil` of `silk.time.plain_date`, and the same functions of
//! `silk.time.plain_date_time`, apply a period to a date and measure one.
//!
//! # Examples
//!
//! ## Read a period and look at its parts
//!
//! ```silk
//! import silk.core.result { Result }
//! import silk.time.period { Period }
//! import silk.time.text { TimeParseError }
//!
//! pub fn main() -> i32 {
//!   match Period.parse("P1Y2M10DT2H30M") {
//!     Result<Period, TimeParseError>.Success { value } => {
//!       if value.years() != 1 || value.months() != 2 || value.weeks() != 0 || value.days() != 10 {
//!         return 1
//!       }
//!       if value.time().wholeSeconds() != 9000 {
//!         return 2
//!       }
//!       if value.negate().sign() != -1 {
//!         return 3
//!       }
//!       return 0
//!     }
//!     Result<Period, TimeParseError>.Failure { error: _ } => {
//!       return 4
//!     }
//!   }
//! }
//! ```
//!
//! @category Time
import silk.collections.slice { Slice }
import silk.core.equal { Equal }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.text.format { Debug, Display, Format, Formatter }
import silk.text.string { String }
import silk.time.duration { Duration }
import silk.time.text { TimeParseError, TimeParseReason }
import silk.num.i32
import silk.num.i64
import silk.num.u32
import silk.num.u64
import silk.num.u8
import silk.num.usize

// The largest count of years, months, or weeks, as in ECMAScript Temporal.
const MAX_FIELD: i64 = 4294967295
// The largest count of days: the days in 2^53 seconds.
const MAX_DAYS: i64 = 104249991374
// The days and the time part together are less than 2^53 seconds.
const MAX_SECONDS: u64 = 9007199254740992

/// The largest calendar unit of a measured [`Period`].
///
/// # Details
///
/// `PlainDate.periodUntil` counts in this unit first and in the smaller units after it. With
/// `Month`, the span from January 1 of one year to March 1 of the next is 14 months; with
/// `Year`, it is 1 year and 2 months; with `Day`, it is 424 or 425 days.
pub enum DateUnit {
  /// Years, then months, then days.
  Year,
  /// Months, then days.
  Month,
  /// Weeks, then days.
  Week,
  /// Days only.
  Day,
}

/// What to do when a date that a period leads to does not exist, such as February 30.
pub enum Overflow {
  /// Use the last day of that month.
  Constrain,
  /// Give no result.
  Reject,
}

/// A calendar span: years, months, weeks, days, and an exact time part.
///
/// # Details
///
/// All parts that are not zero have the same sign. `==` and `!=` compare part by part, so
/// `P1M` and `P30D` are not equal, and neither are `P7D` and `P1W`.
///
/// `Display` writes an ISO 8601 duration, such as `P1Y2M3DT4H30M`, `-P3W`, or `PT0S` for the
/// empty period.
pub struct Period {
  yearCount: i64,
  monthCount: i64,
  weekCount: i64,
  dayCount: i64,
  timePart: Duration,
}

impl Copy for Period {}

impl Period {
  /// Returns the empty period.
  pub fn zero() -> Period {
    return Period { yearCount: 0, monthCount: 0, weekCount: 0, dayCount: 0, timePart: Duration.zero() }
  }

  /// Returns the period with the given parts.
  ///
  /// # Gotchas
  ///
  /// Parts with different signs, or a part outside the range, trap. [`Period.checkedMake`]
  /// returns `None` instead.
  pub fn make(years: i64, months: i64, weeks: i64, days: i64, time: Duration) -> Period {
    match Period.checkedMake(years, months, weeks, days, time) {
      Option<Period>.Some { value } => {
        return value
      }
      Option<Period>.None => {
        return Intrinsic.trap("Period.make: the parts have different signs or are outside the Period range")
      }
    }
  }

  /// Returns the period with the given parts, or `None` when two parts have different signs or
  /// a part is outside the range.
  ///
  /// # Details
  ///
  /// Years, months, and weeks are at most 4,294,967,295 in each direction. The days, as 24
  /// hours each, and the time part are together less than 2^53 seconds. These are the limits of
  /// ECMAScript Temporal.
  pub fn checkedMake(years: i64, months: i64, weeks: i64, days: i64, time: Duration) -> Option<Period> {
    if !within(years, MAX_FIELD) || !within(months, MAX_FIELD) || !within(weeks, MAX_FIELD) || !within(days, MAX_DAYS) {
      return Option<Period>.none()
    }
    let mut positive = false
    let mut negative = false
    if years > 0 || months > 0 || weeks > 0 || days > 0 || time.sign() > 0 {
      positive = true
    }
    if years < 0 || months < 0 || weeks < 0 || days < 0 || time.sign() < 0 {
      negative = true
    }
    if positive && negative {
      return Option<Period>.none()
    }
    match time.checkedAbsolute() {
      Option<Duration>.Some { value } => {
        let dayCount = if days < 0 { i64.toU64(-days) } else { i64.toU64(days) }
        if dayCount * 86400 + i64.toU64(value.wholeSeconds()) >= MAX_SECONDS {
          return Option<Period>.none()
        }
      }
      Option<Duration>.None => {
        return Option<Period>.none()
      }
    }
    return Option<Period>.some(
      Period { yearCount: years, monthCount: months, weekCount: weeks, dayCount: days, timePart: time },
    )
  }

  /// Returns a period of `years` years. A count outside the range traps.
  pub fn ofYears(years: i64) -> Period {
    return Period.make(years, 0, 0, 0, Duration.zero())
  }

  /// Returns a period of `months` months. A count outside the range traps.
  pub fn ofMonths(months: i64) -> Period {
    return Period.make(0, months, 0, 0, Duration.zero())
  }

  /// Returns a period of `weeks` weeks. A count outside the range traps.
  pub fn ofWeeks(weeks: i64) -> Period {
    return Period.make(0, 0, weeks, 0, Duration.zero())
  }

  /// Returns a period of `days` calendar days. A count outside the range traps.
  pub fn ofDays(days: i64) -> Period {
    return Period.make(0, 0, 0, days, Duration.zero())
  }

  /// Returns a period with only the time part `time`. A span of 2^53 seconds or more traps.
  pub fn ofTime(time: Duration) -> Period {
    return Period.make(0, 0, 0, 0, time)
  }

  /// Returns the number of years. It is negative in a negative period.
  pub fn years(self: Self) -> i64 {
    return self.yearCount
  }

  /// Returns the number of months. It is not limited to 11.
  pub fn months(self: Self) -> i64 {
    return self.monthCount
  }

  /// Returns the number of weeks.
  pub fn weeks(self: Self) -> i64 {
    return self.weekCount
  }

  /// Returns the number of days. It does not include the days of the weeks.
  pub fn days(self: Self) -> i64 {
    return self.dayCount
  }

  /// Returns the time part: the hours, minutes, seconds, and nanoseconds as one exact span. It
  /// is not limited to 24 hours.
  pub fn time(self: Self) -> Duration {
    return self.timePart
  }

  /// Returns `true` if every part is zero.
  pub fn isZero(self: Self) -> bool {
    return self.sign() == 0
  }

  /// Returns `true` if the years, months, weeks, and days are all zero.
  pub fn isTimeOnly(self: Self) -> bool {
    return self.yearCount == 0 && self.monthCount == 0 && self.weekCount == 0 && self.dayCount == 0
  }

  /// Returns -1 for a negative period, 0 for the empty period, and 1 for a positive period.
  pub fn sign(self: Self) -> i32 {
    if self.yearCount > 0 || self.monthCount > 0 || self.weekCount > 0 || self.dayCount > 0 {
      return 1
    }
    if self.yearCount < 0 || self.monthCount < 0 || self.weekCount < 0 || self.dayCount < 0 {
      return -1
    }
    return self.timePart.sign()
  }

  /// Returns the period with the sign of every part changed.
  pub fn negate(self: Self) -> Period {
    return Period {
      yearCount: -self.yearCount,
      monthCount: -self.monthCount,
      weekCount: -self.weekCount,
      dayCount: -self.dayCount,
      timePart: -self.timePart,
    }
  }

  /// Returns the period without its sign.
  pub fn absolute(self: Self) -> Period {
    if self.sign() < 0 {
      return self.negate()
    }
    return self
  }

  /// Returns the sum of this period and `other`, part by part, or `None` when the parts of the
  /// sum have different signs or a part is outside the range.
  ///
  /// # Details
  ///
  /// Nothing is balanced: `P1M` plus `P20D` is `P1M20D`. `P1M` plus `-P1D` has no result,
  /// because the length of the sum depends on the month.
  pub fn checkedAdd(self: Self, other: Period) -> Option<Period> {
    match self.timePart.checkedAdd(other.timePart) {
      Option<Duration>.Some { value } => {
        // Each field is far inside the `i64` range, so the sums do not overflow.
        return Period.checkedMake(
          self.yearCount + other.yearCount,
          self.monthCount + other.monthCount,
          self.weekCount + other.weekCount,
          self.dayCount + other.dayCount,
          value,
        )
      }
      Option<Duration>.None => {
        return Option<Period>.none()
      }
    }
  }

  /// Returns this period without its time part.
  pub fn dateOnly(self: Self) -> Period {
    return Period {
      yearCount: self.yearCount,
      monthCount: self.monthCount,
      weekCount: self.weekCount,
      dayCount: self.dayCount,
      timePart: Duration.zero(),
    }
  }

  /// Reads a period from an ISO 8601 duration such as `P1Y2M3DT4H30M`.
  ///
  /// # Details
  ///
  /// The text is an optional sign, `P`, and then counts with the designators `Y`, `M`, `W`, and
  /// `D`, then `T` and counts with `H`, `M`, and `S`, in that order. Each part can be absent,
  /// but at least one is present. The last time count can have a fraction of one to nine digits
  /// after `.` or `,`, as in `PT1.5H` or `PT0.25S`. Letter case does not matter. A leading `-`
  /// makes every part negative.
  ///
  /// # Errors
  ///
  /// - `TimeParseReason.UnexpectedEnd` or `UnexpectedCharacter` if the text does not have that
  ///   form.
  /// - `TimeParseReason.OutOfRange` if the parts are outside the range of
  ///   [`Period.checkedMake`].
  pub fn parse(text: string) -> Result<Period, TimeParseError> {
    return Period.parseBytes(String.utf8Bytes(text))
  }

  /// Reads a period from the bytes of an ISO 8601 duration such as `P1Y2M3DT4H30M`.
  ///
  /// # Details
  ///
  /// The form is the one of [`Period.parse`].
  ///
  /// # Errors
  ///
  /// - The errors of [`Period.parse`].
  pub fn parseBytes(bytes: &[u8]) -> Result<Period, TimeParseError> {
    let mut reader = Reader { bytes: bytes, at: 0, failed: false, reason: TimeParseReason.UnexpectedEnd, failedAt: 0 }
    let parsed = reader.period()
    if reader.failed {
      return Result<Period, TimeParseError>.failResult(
        TimeParseError { reason: reader.reason, offset: reader.failedAt },
      )
    }
    return Result<Period, TimeParseError>.succeed(parsed)
  }

  /// Writes the ISO 8601 text of the period into `output` from index `at` and returns the index
  /// after the last byte written. The text is at most 100 bytes.
  ///
  /// # Gotchas
  ///
  /// An `output` with less room than the text needs traps.
  pub fn write(self: Self, output: &mut [u8], at: usize) -> usize {
    let mut next = at
    let negative = self.sign() < 0
    if negative {
      output[next] = 45
      next = next + 1
    }
    output[next] = 80
    next = next + 1
    next = writeField(&mut output, next, self.yearCount, 89)
    next = writeField(&mut output, next, self.monthCount, 77)
    next = writeField(&mut output, next, self.weekCount, 87)
    next = writeField(&mut output, next, self.dayCount, 68)
    let prefix: usize = if negative { 2 } else { 1 }
    if self.timePart.isZero() && next > at + prefix {
      return next
    }
    // Magnitude of the time part in unsigned seconds and nanoseconds.
    let whole = self.timePart.wholeSeconds()
    let mut nanoseconds = self.timePart.subsecondNanoseconds()
    let mut seconds: u64 = 0
    if whole < 0 {
      if nanoseconds == 0 {
        seconds = u64.wrappingSubtract(0, i64.wrappingToU64(whole))
      } else {
        seconds = u64.wrappingSubtract(0, i64.wrappingToU64(whole)) - 1
        nanoseconds = 1000000000 - nanoseconds
      }
    } else {
      seconds = i64.toU64(whole)
    }
    output[next] = 84
    next = next + 1
    let hours = seconds / 3600
    let minutes = (seconds % 3600) / 60
    let rest = seconds % 60
    if hours != 0 {
      next = writeDigits(&mut output, next, hours)
      output[next] = 72
      next = next + 1
    }
    if minutes != 0 {
      next = writeDigits(&mut output, next, minutes)
      output[next] = 77
      next = next + 1
    }
    if rest != 0 || nanoseconds != 0 || (hours == 0 && minutes == 0) {
      next = writeDigits(&mut output, next, rest)
      if nanoseconds != 0 {
        output[next] = 46
        next = next + 1
        let mut divisor: u32 = 100000000
        let mut left = nanoseconds
        while left != 0 {
          output[next] = u32.toU8(left / divisor) + 48
          next = next + 1
          left = left % divisor
          divisor = divisor / 10
        }
      }
      output[next] = 83
      next = next + 1
    }
    return next
  }

  fn same(left: &Period, right: &Period) -> bool {
    return left.yearCount == right.yearCount
      && left.monthCount == right.monthCount
      && left.weekCount == right.weekCount
      && left.dayCount == right.dayCount
      && &left.timePart == &right.timePart
  }
}

impl Equal for Period {
  equals: Period.same
}

/// Writes the period as an ISO 8601 duration, such as `P1Y2M3DT4H30M`, `-P3W`, or `PT0.5S`. The
/// empty period is `PT0S`.
impl Display for Period {
  effect fn display(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    let mut output: [u8; 100] = [0; 100]
    let length = Period.write(self.*, &mut output, 0)
    return run Format.write(&mut formatter, Slice.view<u8>(&output, 0, length))
  }
}

/// Writes the same text as `Display`: an ISO 8601 duration such as `P1Y2M3DT4H30M`.
impl Debug for Period {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return run Display.display(self, &mut formatter)
  }
}

fn within(value: i64, limit: i64) -> bool {
  return value >= -limit && value <= limit
}

// Writes the magnitude of `value` and `designator` if `value` is not zero.
fn writeField(output: &mut [u8], at: usize, value: i64, designator: u8) -> usize {
  if value == 0 {
    return at
  }
  let magnitude = if value < 0 { i64.toU64(-value) } else { i64.toU64(value) }
  let next = writeDigits(&mut output, at, magnitude)
  output[next] = designator
  return next + 1
}

fn writeDigits(output: &mut [u8], start: usize, value: u64) -> usize {
  let mut digits: [u8; 20] = [0; 20]
  let mut count: usize = 0
  let mut left = value
  if left == 0 {
    digits[0] = 48
    count = 1
  }
  while left != 0 {
    digits[count] = u64.toU8(left % 10) + 48
    count = count + 1
    left = left / 10
  }
  let mut at = start
  while count != 0 {
    count = count - 1
    output[at] = digits[count]
    at = at + 1
  }
  return at
}

// The reader of the text of a period. After the first failure, each reader does nothing.
struct Reader<'text> {
  bytes: &'text [u8],
  at: usize,
  failed: bool,
  reason: TimeParseReason,
  failedAt: usize,
}

// One count of the text: the whole part, the fraction in billionths, and the designator in
// upper case.
struct Count {
  whole: u64,
  fraction: u32,
  hasFraction: bool,
  designator: u8,
  startsAt: usize,
}

impl Copy for Count {}

impl<'text> Reader<'text> {
  fn reject(self: &mut Self, reason: TimeParseReason, offset: usize) -> () {
    if !self.failed {
      self.failed = true
      self.reason = reason
      self.failedAt = offset
    }
    return ()
  }

  fn rejectHere(self: &mut Self) -> () {
    let where = self.at
    if where >= self.bytes.length {
      self.reject(TimeParseReason.UnexpectedEnd, where)
    } else {
      self.reject(TimeParseReason.UnexpectedCharacter, where)
    }
    return ()
  }

  fn peekUpper(self: &Self) -> u8 {
    if self.at >= self.bytes.length {
      return 0
    }
    let byte = self.bytes[self.at]
    if byte >= 97 && byte <= 122 {
      return byte - 32
    }
    return byte
  }

  // Reads digits, an optional fraction, and a designator letter.
  fn count(self: &mut Self) -> Count {
    let mut result = Count { whole: 0, fraction: 0, hasFraction: false, designator: 0, startsAt: self.at }
    let mut digits: usize = 0
    while self.at < self.bytes.length && self.bytes[self.at] >= 48 && self.bytes[self.at] <= 57 {
      // 2^53 has 16 digits; a longer count is outside every range.
      if digits >= 17 {
        self.reject(TimeParseReason.OutOfRange, result.startsAt)
        return result
      }
      result.whole = result.whole * 10 + u8.toU64(self.bytes[self.at] - 48)
      digits = digits + 1
      self.at = self.at + 1
    }
    if digits == 0 {
      self.rejectHere()
      return result
    }
    if self.at < self.bytes.length && (self.bytes[self.at] == 46 || self.bytes[self.at] == 44) {
      self.at = self.at + 1
      result.hasFraction = true
      let mut scale: u32 = 100000000
      let mut places: usize = 0
      while self.at < self.bytes.length && self.bytes[self.at] >= 48 && self.bytes[self.at] <= 57 {
        if places == 9 {
          let where = self.at
          self.reject(TimeParseReason.UnexpectedCharacter, where)
          return result
        }
        result.fraction = result.fraction + u8.toU32(self.bytes[self.at] - 48) * scale
        scale = scale / 10
        places = places + 1
        self.at = self.at + 1
      }
      if places == 0 {
        self.rejectHere()
        return result
      }
    }
    let designator = self.peekUpper()
    if designator < 65 || designator > 90 {
      self.rejectHere()
      return result
    }
    result.designator = designator
    self.at = self.at + 1
    return result
  }

  fn period(self: &mut Self) -> Period {
    let mut negative = false
    if self.at < self.bytes.length && (self.bytes[self.at] == 45 || self.bytes[self.at] == 43) {
      negative = self.bytes[self.at] == 45
      self.at = self.at + 1
    }
    if self.peekUpper() != 80 {
      self.rejectHere()
      return Period.zero()
    }
    self.at = self.at + 1
    let mut fields: [i64; 4] = [0; 4]
    // The index of the next designator that may come: Y, M, W, D.
    let mut order: usize = 0
    let mut parts: usize = 0
    while !self.failed && self.at < self.bytes.length && self.peekUpper() != 84 {
      let read = self.count()
      if self.failed {
        return Period.zero()
      }
      let mut index: usize = 4
      if read.designator == 89 { index = 0 }
      if read.designator == 77 { index = 1 }
      if read.designator == 87 { index = 2 }
      if read.designator == 68 { index = 3 }
      if index == 4 || index < order || read.hasFraction {
        let where = if read.hasFraction { read.startsAt } else { self.at - 1 }
        self.reject(TimeParseReason.UnexpectedCharacter, where)
        return Period.zero()
      }
      let limit = if index == 3 { MAX_DAYS } else { MAX_FIELD }
      if read.whole > i64.toU64(limit) {
        self.reject(TimeParseReason.OutOfRange, read.startsAt)
        return Period.zero()
      }
      fields[index] = u64.toI64(read.whole)
      order = index + 1
      parts = parts + 1
    }
    // The time part in whole seconds and nanoseconds.
    let mut seconds: u64 = 0
    let mut nanoseconds: u64 = 0
    if self.peekUpper() == 84 {
      self.at = self.at + 1
      let mut timeOrder: usize = 0
      let mut timeParts: usize = 0
      let mut closed = false
      while !self.failed && self.at < self.bytes.length {
        let read = self.count()
        if self.failed {
          return Period.zero()
        }
        let mut index: usize = 3
        let mut unit: u64 = 0
        if read.designator == 72 {
          index = 0
          unit = 3600
        }
        if read.designator == 77 {
          index = 1
          unit = 60
        }
        if read.designator == 83 {
          index = 2
          unit = 1
        }
        // Only the last count has a fraction.
        if index == 3 || index < timeOrder || closed {
          let where = if closed { read.startsAt } else { self.at - 1 }
          self.reject(TimeParseReason.UnexpectedCharacter, where)
          return Period.zero()
        }
        if read.whole > MAX_SECONDS / unit {
          self.reject(TimeParseReason.OutOfRange, read.startsAt)
          return Period.zero()
        }
        seconds = seconds + read.whole * unit
        // A billionth of an hour is 3,600 nanoseconds, so the fraction is exact.
        nanoseconds = nanoseconds + u32.toU64(read.fraction) * unit
        if seconds >= MAX_SECONDS {
          self.reject(TimeParseReason.OutOfRange, read.startsAt)
          return Period.zero()
        }
        closed = read.hasFraction
        timeOrder = index + 1
        timeParts = timeParts + 1
      }
      if timeParts == 0 {
        self.rejectHere()
        return Period.zero()
      }
      parts = parts + timeParts
    }
    if self.failed {
      return Period.zero()
    }
    if parts == 0 {
      self.rejectHere()
      return Period.zero()
    }
    seconds = seconds + nanoseconds / 1000000000
    nanoseconds = nanoseconds % 1000000000
    if u64.wrappingAdd(i64.toU64(fields[3]) * 86400, seconds) >= MAX_SECONDS {
      self.reject(TimeParseReason.OutOfRange, 0)
      return Period.zero()
    }
    let mut time = Duration.make(u64.toI64(seconds), u64.toI64(nanoseconds))
    if negative {
      time = -time
      fields[0] = -fields[0]
      fields[1] = -fields[1]
      fields[2] = -fields[2]
      fields[3] = -fields[3]
    }
    return Period { yearCount: fields[0], monthCount: fields[1], weekCount: fields[2], dayCount: fields[3], timePart: time }
  }
}
