//! The time zone database that the standard library carries: a `TimeZones` provider with the same
//! zones on every target.
//!
//! # When to use
//!
//! Provide [`BundledTimeZones`] when the result must not depend on the machine, or when the
//! machine may have no zone files, as in a slim container. `OsTimeZones` of
//! `silk.time.zones_native` already uses it on Windows, WASI, and browsers, where the system
//! has no zone files, and `PreferSystemTimeZones` uses it when the system does not know a zone.
//! Use `ZoneBundle` of `silk.time.zones_bundle` for a bundle that the program supplies.
//!
//! # Details
//!
//! The data is one release of the IANA time zone database, compiled to TZif files, with every
//! zone and link. The program holds it compressed, about 60 KB, and only a program that names
//! this provider holds it. The first lookup expands it one time, to about 230 KB, and the
//! provider keeps it. [`TimeZones.version`] names the release.
//!
//! # Gotchas
//!
//! - The release is the one of the Silk version that built the program. A zone rule that changed
//!   after that release is only in the files of the operating system.
//!
//! # Examples
//!
//! ## Read a zone on any target
//!
//! ```silk
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.core.effect { Effect }
//! import silk.time.instant { Instant }
//! import silk.time.zoned { ZonedDateTime }
//! import silk.time.zones { TimeZones, ZoneLookupError }
//! import silk.time.zones_bundled { BundledTimeZones }
//!
//! // The hour in Rome at `at`.
//! effect fn romeHour(at: Instant) -> u8 ! ZoneLookupError | OutOfMemoryError ? &mut TimeZones | &mut Allocator {
//!   let rome = run TimeZones.zone("Europe/Rome")
//!   return ZonedDateTime.make(at, &rome).time().hour()
//! }
//!
//! effect fn failed(error: ZoneLookupError | OutOfMemoryError) -> u8 {
//!   return 255
//! }
//!
//! pub effect fn main() -> i32 {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let mut zones = BundledTimeZones.make()
//!   let hour = run Effect.catchAll(romeHour(Instant.fromUnixSeconds(1795109782)), failed)
//!     |> Effect.provideMut<TimeZones>(&mut zones)
//!     |> Effect.provideMut<Allocator>(&mut allocator)
//!   if hour != 18 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Time
import silk.build.source { Compressed, Source }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.time.zone { Zone }
import silk.time.zones { TimeZones, ZoneLookupError, ZoneLookupReason }
import silk.time.zones_bundle { ZoneBundle }

/// The `TimeZones` provider with the time zone database inside the program.
///
/// # Details
///
/// [`BundledTimeZones.make`] does no work. The first operation expands the data, and the
/// provider keeps it until it is dropped, so make one provider for the program and not one for
/// each lookup.
pub struct BundledTimeZones {
  loaded: Option<ZoneBundle>,
}

impl BundledTimeZones {
  /// Returns a provider. It does not expand the data yet.
  pub fn make() -> BundledTimeZones {
    return BundledTimeZones { loaded: Option<ZoneBundle>.none() }
  }

  /// Returns the IANA zone name for the zone name of Windows `name`, such as `Europe/Berlin`
  /// for `W. Europe Standard Time`, or `None` if the table does not list the name. Letter case
  /// does not matter.
  ///
  /// # Errors
  ///
  /// - `ZoneLookupError` with the reason `InvalidData` if the data of the program is damaged.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the data or the name.
  pub effect fn windowsZone(self: &mut Self, name: &[u8]) -> Option<Bytes>
    ! ZoneLookupError | OutOfMemoryError
    ? &mut Allocator {
    run self.load()
    if let Option<ZoneBundle>.Some { value: bundle } = &self.loaded {
      if let Option<&[u8]>.Some { value: found } = move bundle.windowsZone(name) {
        return Option<Bytes>.some(run Bytes.copy(found))
      }
    }
    return Option<Bytes>.none()
  }

  // Expands the data at the first call.
  effect fn load(self: &mut Self) -> () ! ZoneLookupError | OutOfMemoryError ? &mut Allocator {
    if let Option<ZoneBundle>.Some { .. } = &self.loaded {
      return ()
    }
    let packed = Source.compressed("silk/time/data/tzdb.bin")
    let data = run Compressed.bytes(&packed)
    self.loaded = Option<ZoneBundle>.some(run ZoneBundle.fromOwned(move data))
    return ()
  }

  effect fn zoneBytes(self: &mut Self, name: &[u8]) -> Zone ! ZoneLookupError | OutOfMemoryError ? &mut Allocator {
    // `UTC` and the offsets need no data.
    if let Option<Zone>.Some { value } = move TimeZones.fixedZone(name) {
      return move value
    }
    run self.load()
    if let Option<ZoneBundle>.Some { value: bundle } = &mut self.loaded {
      return run TimeZones.zoneBytes(name) |> Effect.provideMut<TimeZones>(&mut bundle)
    }
    fail TimeZones.lookupFailure(ZoneLookupReason.Unreadable)
  }

  effect fn names(self: &mut Self) -> List<Bytes> ! ZoneLookupError | OutOfMemoryError ? &mut Allocator {
    run self.load()
    if let Option<ZoneBundle>.Some { value: bundle } = &mut self.loaded {
      return run TimeZones.names() |> Effect.provideMut<TimeZones>(&mut bundle)
    }
    fail TimeZones.lookupFailure(ZoneLookupReason.Unreadable)
  }

  effect fn version(self: &mut Self) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    // The operation cannot report damaged data, so the release then has no name.
    let loading = run Effect.result(self.load())
    match move loading {
      Result<(), ZoneLookupError | OutOfMemoryError>.Success { .. } => {}
      Result<(), ZoneLookupError | OutOfMemoryError>.Failure { error } => match move error {
        ZoneLookupError _ => {
          return Bytes.make()
        }
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
      }
    }
    if let Option<ZoneBundle>.Some { value: bundle } = &self.loaded {
      return run Bytes.copy(bundle.release())
    }
    return Bytes.make()
  }
}

impl TimeZones for BundledTimeZones {
  zoneBytes: BundledTimeZones.zoneBytes
  names: BundledTimeZones.names
  version: BundledTimeZones.version
}
