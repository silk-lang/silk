//! Codecs that read and write the `silk.time` types in any data format of `silk.schema`: as ISO
//! 8601 text with [`TimeText`], or as a Unix time with [`UnixSeconds`] and [`UnixMilliseconds`].
//!
//! # When to use
//!
//! Use these codecs for a date or time in a field of a type that implements `Schema`. Wrap the
//! value in a type of your own, and call `Schemas.readVia`, `Schemas.writeVia` and
//! `Schemas.shapeVia` with the codec from its `read`, `write` and `shape`. Put a codec in a chain
//! of `silk.schema.codec` to trim the text first or to check the value afterwards.
//!
//! To read a TOML date or time that is not text, use the TOML codecs of `silk.toml.codec`.
//!
//! # Details
//!
//! `TimeText<T>` is implemented for `Instant`, `PlainDate`, `PlainTime`, `PlainDateTime`,
//! `PlainYearMonth`, `PlainMonthDay`, `Period` and `UtcOffset`. Decoding calls the `parse` of the
//! type, so it accepts the same text, and fails with `IssueReason.InvalidValue` for other text.
//! Encoding writes the text that `Display` writes, which `parse` reads back to the same value.
//!
//! # Gotchas
//!
//! A Unix time has no fraction below its unit: [`UnixSeconds`] drops the part of an `Instant` below
//! one second when it encodes, and [`UnixMilliseconds`] the part below one millisecond.
//!
//! # Examples
//!
//! ## Decode a date and write it back
//!
//! ```silk
//! import silk.core.effect { Effect }
//! import silk.core.result { Result }
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.schema.codec { Codec }
//! import silk.schema.issue { Issue }
//! import silk.text.string { String }
//! import silk.time.codec { TimeText }
//! import silk.time.plain_date { PlainDate }
//!
//! effect fn nextDay(text: string) -> String ! Issue | OutOfMemoryError ? &mut Allocator {
//!   let codec = TimeText<PlainDate>.make()
//!   let date = run Codec.decode(&codec, run String.copy(text))
//!   return run Codec.encode(&codec, &date.addDays(1))
//! }
//!
//! pub effect fn main() -> i32 ! OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let written = run Effect.result(nextDay("2026-12-31")) |> Effect.provideMut<Allocator>(&mut allocator)
//!   return match move written {
//!     Result<String, Issue | OutOfMemoryError>.Success {value} => if value.view() == "2027-01-01" { 0 } else { 1 }
//!     Result<String, Issue | OutOfMemoryError>.Failure {..} => 2
//!   }
//! }
//! ```
//!
//! @category Time
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.i64
import silk.num.usize
import silk.schema.codec { Codec }
import silk.schema.issue { Issue }
import silk.schema.shape { Constraint }
import silk.text.format { Display, Format }
import silk.text.string { String }
import silk.time.instant { Instant }
import silk.time.offset { UtcOffset }
import silk.time.period { Period }
import silk.time.plain_date { PlainDate }
import silk.time.plain_date_time { PlainDateTime }
import silk.time.plain_month_day { PlainMonthDay }
import silk.time.plain_time { PlainTime }
import silk.time.plain_year_month { PlainYearMonth }
import silk.time.text { TimeParseError }

/// The codec between a `silk.time` value `T` and its ISO 8601 text.
///
/// # Details
///
/// It is implemented for `Instant`, `PlainDate`, `PlainTime`, `PlainDateTime`, `PlainYearMonth`,
/// `PlainMonthDay`, `Period` and `UtcOffset`. Decoding accepts the text that the `parse` of `T`
/// accepts, and fails with `IssueReason.InvalidValue` for other text. Encoding writes the text
/// that `Display` writes for `T`.
pub struct TimeText<T> {
  /// Empty. It names the time type.
  pub kind: [T; 0],
}

impl<T> TimeText<T> {
  /// Returns the codec for the time type `T`.
  pub fn make() -> TimeText<T> {
    return TimeText<T> {kind: []}
  }
}

// The longest text is a `Period` with ten fields of up to 20 characters each.
struct Capture {
  bytes: [u8; 256],
  length: usize,
}

impl Writer for Capture {
  effect fn writeAll(self: &mut Self, value: &[u8]) -> () ! WriterError ? &mut Writer {
    let mut index: usize = 0
    while index < value.length && self.length < 256 {
      self.bytes[self.length] = value[index]
      self.length = self.length + 1
      index = index + 1
    }
    return ()
  }

  effect fn flush(self: &mut Self) -> () ! WriterError ? &mut Writer {
    return ()
  }
}

effect fn written<T: Display>(value: &T) -> String ! OutOfMemoryError ? &mut Allocator {
  let mut capture = Capture {bytes: [0; 256], length: 0}
  let shown = run Effect.result(Format.display<T>(value)) |> Effect.provideMut<Writer>(&mut capture)
  match move shown {
    Result<(), WriterError>.Success {..} => {}
    Result<(), WriterError>.Failure {..} => {}
  }
  return run String.copy(unsafe Intrinsic.stringFromUtf8Unchecked(Slice.view<u8>(&capture.bytes, usize.ZERO, capture.length)))
}

effect fn textHints(constraints: &mut List<Constraint>, notes: &mut List<string<'static>>, onWire: bool, expected: string<'static>)
  -> () ! OutOfMemoryError ? &mut Allocator {
  if onWire { return run List<Constraint>.append(&mut constraints.*, Constraint.Expected {text: expected}) }
  return run List<string<'static>>.append(&mut notes.*, expected)
}

impl Codec<Instant, String> for TimeText<Instant> {
  /// Parses a date and time with an offset, such as `2026-11-19T18:36:22Z`.
  effect fn decode(self: &Self, input: String) -> Instant ! Issue | OutOfMemoryError ? &mut Allocator {
    return match Instant.parse(input.view()) {
      Result<Instant, TimeParseError>.Success {value} => value
      Result<Instant, TimeParseError>.Failure {..} => { fail Issue.invalidValue("an RFC 3339 date and time with an offset") }
    }
  }

  /// Writes the instant in UTC, such as `2026-11-19T17:36:22Z`.
  effect fn encode(self: &Self, value: &Instant) -> String ! OutOfMemoryError ? &mut Allocator {
    return run written<Instant>(value)
  }

  /// Reports that the text is an RFC 3339 date and time with an offset.
  effect fn hints(self: &Self, constraints: &mut List<Constraint>, notes: &mut List<string<'static>>, onWire: bool)
    -> () ! OutOfMemoryError ? &mut Allocator {
    return run textHints(&mut constraints.*, &mut notes.*, onWire, "an RFC 3339 date and time with an offset")
  }
}

impl Codec<PlainDate, String> for TimeText<PlainDate> {
  /// Parses a date, such as `2026-11-19`.
  effect fn decode(self: &Self, input: String) -> PlainDate ! Issue | OutOfMemoryError ? &mut Allocator {
    return match PlainDate.parse(input.view()) {
      Result<PlainDate, TimeParseError>.Success {value} => value
      Result<PlainDate, TimeParseError>.Failure {..} => { fail Issue.invalidValue("an ISO 8601 date") }
    }
  }

  /// Writes the date as `YYYY-MM-DD`.
  effect fn encode(self: &Self, value: &PlainDate) -> String ! OutOfMemoryError ? &mut Allocator {
    return run written<PlainDate>(value)
  }

  /// Reports that the text is an ISO 8601 date.
  effect fn hints(self: &Self, constraints: &mut List<Constraint>, notes: &mut List<string<'static>>, onWire: bool)
    -> () ! OutOfMemoryError ? &mut Allocator {
    return run textHints(&mut constraints.*, &mut notes.*, onWire, "an ISO 8601 date")
  }
}

impl Codec<PlainTime, String> for TimeText<PlainTime> {
  /// Parses a time of day, such as `18:36:22.5`.
  effect fn decode(self: &Self, input: String) -> PlainTime ! Issue | OutOfMemoryError ? &mut Allocator {
    return match PlainTime.parse(input.view()) {
      Result<PlainTime, TimeParseError>.Success {value} => value
      Result<PlainTime, TimeParseError>.Failure {..} => { fail Issue.invalidValue("an ISO 8601 time of day") }
    }
  }

  /// Writes the time as `HH:MM:SS` with the fraction it has.
  effect fn encode(self: &Self, value: &PlainTime) -> String ! OutOfMemoryError ? &mut Allocator {
    return run written<PlainTime>(value)
  }

  /// Reports that the text is an ISO 8601 time of day.
  effect fn hints(self: &Self, constraints: &mut List<Constraint>, notes: &mut List<string<'static>>, onWire: bool)
    -> () ! OutOfMemoryError ? &mut Allocator {
    return run textHints(&mut constraints.*, &mut notes.*, onWire, "an ISO 8601 time of day")
  }
}

impl Codec<PlainDateTime, String> for TimeText<PlainDateTime> {
  /// Parses a date and time without an offset, such as `2026-11-19T18:36:22`.
  effect fn decode(self: &Self, input: String) -> PlainDateTime ! Issue | OutOfMemoryError ? &mut Allocator {
    return match PlainDateTime.parse(input.view()) {
      Result<PlainDateTime, TimeParseError>.Success {value} => value
      Result<PlainDateTime, TimeParseError>.Failure {..} => { fail Issue.invalidValue("an ISO 8601 date and time") }
    }
  }

  /// Writes the date, `T`, and the time.
  effect fn encode(self: &Self, value: &PlainDateTime) -> String ! OutOfMemoryError ? &mut Allocator {
    return run written<PlainDateTime>(value)
  }

  /// Reports that the text is an ISO 8601 date and time.
  effect fn hints(self: &Self, constraints: &mut List<Constraint>, notes: &mut List<string<'static>>, onWire: bool)
    -> () ! OutOfMemoryError ? &mut Allocator {
    return run textHints(&mut constraints.*, &mut notes.*, onWire, "an ISO 8601 date and time")
  }
}

impl Codec<PlainYearMonth, String> for TimeText<PlainYearMonth> {
  /// Parses a year and month, such as `2026-11`.
  effect fn decode(self: &Self, input: String) -> PlainYearMonth ! Issue | OutOfMemoryError ? &mut Allocator {
    return match PlainYearMonth.parse(input.view()) {
      Result<PlainYearMonth, TimeParseError>.Success {value} => value
      Result<PlainYearMonth, TimeParseError>.Failure {..} => { fail Issue.invalidValue("an ISO 8601 year and month") }
    }
  }

  /// Writes the month as `YYYY-MM`.
  effect fn encode(self: &Self, value: &PlainYearMonth) -> String ! OutOfMemoryError ? &mut Allocator {
    return run written<PlainYearMonth>(value)
  }

  /// Reports that the text is an ISO 8601 year and month.
  effect fn hints(self: &Self, constraints: &mut List<Constraint>, notes: &mut List<string<'static>>, onWire: bool)
    -> () ! OutOfMemoryError ? &mut Allocator {
    return run textHints(&mut constraints.*, &mut notes.*, onWire, "an ISO 8601 year and month")
  }
}

impl Codec<PlainMonthDay, String> for TimeText<PlainMonthDay> {
  /// Parses a month and day, such as `11-19` or `--11-19`.
  effect fn decode(self: &Self, input: String) -> PlainMonthDay ! Issue | OutOfMemoryError ? &mut Allocator {
    return match PlainMonthDay.parse(input.view()) {
      Result<PlainMonthDay, TimeParseError>.Success {value} => value
      Result<PlainMonthDay, TimeParseError>.Failure {..} => { fail Issue.invalidValue("an ISO 8601 month and day") }
    }
  }

  /// Writes the day as `MM-DD`.
  effect fn encode(self: &Self, value: &PlainMonthDay) -> String ! OutOfMemoryError ? &mut Allocator {
    return run written<PlainMonthDay>(value)
  }

  /// Reports that the text is an ISO 8601 month and day.
  effect fn hints(self: &Self, constraints: &mut List<Constraint>, notes: &mut List<string<'static>>, onWire: bool)
    -> () ! OutOfMemoryError ? &mut Allocator {
    return run textHints(&mut constraints.*, &mut notes.*, onWire, "an ISO 8601 month and day")
  }
}

impl Codec<Period, String> for TimeText<Period> {
  /// Parses a duration, such as `P1Y2M3DT4H`.
  effect fn decode(self: &Self, input: String) -> Period ! Issue | OutOfMemoryError ? &mut Allocator {
    return match Period.parse(input.view()) {
      Result<Period, TimeParseError>.Success {value} => value
      Result<Period, TimeParseError>.Failure {..} => { fail Issue.invalidValue("an ISO 8601 duration") }
    }
  }

  /// Writes the period as an ISO 8601 duration.
  effect fn encode(self: &Self, value: &Period) -> String ! OutOfMemoryError ? &mut Allocator {
    return run written<Period>(value)
  }

  /// Reports that the text is an ISO 8601 duration.
  effect fn hints(self: &Self, constraints: &mut List<Constraint>, notes: &mut List<string<'static>>, onWire: bool)
    -> () ! OutOfMemoryError ? &mut Allocator {
    return run textHints(&mut constraints.*, &mut notes.*, onWire, "an ISO 8601 duration")
  }
}

impl Codec<UtcOffset, String> for TimeText<UtcOffset> {
  /// Parses an offset, such as `+01:00` or `Z`.
  effect fn decode(self: &Self, input: String) -> UtcOffset ! Issue | OutOfMemoryError ? &mut Allocator {
    return match UtcOffset.parse(input.view()) {
      Result<UtcOffset, TimeParseError>.Success {value} => value
      Result<UtcOffset, TimeParseError>.Failure {..} => { fail Issue.invalidValue("a UTC offset") }
    }
  }

  /// Writes the offset, such as `+01:00`.
  effect fn encode(self: &Self, value: &UtcOffset) -> String ! OutOfMemoryError ? &mut Allocator {
    return run written<UtcOffset>(value)
  }

  /// Reports that the text is a UTC offset.
  effect fn hints(self: &Self, constraints: &mut List<Constraint>, notes: &mut List<string<'static>>, onWire: bool)
    -> () ! OutOfMemoryError ? &mut Allocator {
    return run textHints(&mut constraints.*, &mut notes.*, onWire, "a UTC offset")
  }
}

/// The codec between an `Instant` and a count of whole seconds from the Unix epoch.
///
/// # Details
///
/// Decoding fails with `IssueReason.InvalidValue` for a count outside the range of `Instant`.
/// Encoding rounds down to the second, so an instant before 1970 with a fraction gives the second
/// before it.
pub struct UnixSeconds {}

impl Codec<Instant, i64> for UnixSeconds {
  /// Returns the instant `input` seconds from the Unix epoch.
  effect fn decode(self: &Self, input: i64) -> Instant ! Issue | OutOfMemoryError ? &mut Allocator {
    return match Instant.checkedMake(input, 0) {
      Option<Instant>.Some {value} => value
      Option<Instant>.None => { fail Issue.invalidValue("a Unix time in seconds in the range of Instant") }
    }
  }

  /// Returns the whole seconds from the Unix epoch to `value`.
  effect fn encode(self: &Self, value: &Instant) -> i64 ! OutOfMemoryError ? &mut Allocator {
    return value.unixSeconds()
  }

  /// Reports that the number is a Unix time in seconds.
  effect fn hints(self: &Self, constraints: &mut List<Constraint>, notes: &mut List<string<'static>>, onWire: bool)
    -> () ! OutOfMemoryError ? &mut Allocator {
    return run textHints(&mut constraints.*, &mut notes.*, onWire, "a Unix time in seconds")
  }
}

/// The codec between an `Instant` and a count of whole milliseconds from the Unix epoch, the time
/// value of JavaScript.
///
/// # Details
///
/// Decoding fails with `IssueReason.InvalidValue` for a count outside the range of `Instant`.
/// Encoding rounds down to the millisecond.
pub struct UnixMilliseconds {}

impl Codec<Instant, i64> for UnixMilliseconds {
  /// Returns the instant `input` milliseconds from the Unix epoch.
  effect fn decode(self: &Self, input: i64) -> Instant ! Issue | OutOfMemoryError ? &mut Allocator {
    let mut seconds = input / 1000
    let mut rest = input % 1000
    if rest < 0 {
      seconds = seconds - 1
      rest = rest + 1000
    }
    return match Instant.checkedMake(seconds, rest * 1000000) {
      Option<Instant>.Some {value} => value
      Option<Instant>.None => { fail Issue.invalidValue("a Unix time in milliseconds in the range of Instant") }
    }
  }

  /// Returns the whole milliseconds from the Unix epoch to `value`.
  effect fn encode(self: &Self, value: &Instant) -> i64 ! OutOfMemoryError ? &mut Allocator {
    return value.unixMilliseconds()
  }

  /// Reports that the number is a Unix time in milliseconds.
  effect fn hints(self: &Self, constraints: &mut List<Constraint>, notes: &mut List<string<'static>>, onWire: bool)
    -> () ! OutOfMemoryError ? &mut Allocator {
    return run textHints(&mut constraints.*, &mut notes.*, onWire, "a Unix time in milliseconds")
  }
}
