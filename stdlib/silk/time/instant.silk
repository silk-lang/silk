//! Points in time: the [`Instant`] type, a moment on the UTC timeline with nanosecond precision.
//!
//! # When to use
//!
//! Use [`Instant`] for when something happened or will happen, the same for every observer: a
//! timestamp in a log, an expiry, the time a file changed. `SystemClock.now` in
//! `silk.system.system_clock` reads the current one. To show an instant to a person, convert it
//! with [`Instant.toUtc`] or [`Instant.toOffset`].
//!
//! # Details
//!
//! An `Instant` counts seconds and nanoseconds from the Unix epoch, `1970-01-01T00:00:00Z`, and
//! ignores leap seconds, as Unix time does. The range is 100 million days in each direction,
//! `-271821-04-20T00:00:00Z` to `+275760-09-13T00:00:00Z`, the range of ECMAScript Temporal.
//!
//! `instant + duration` and `instant - duration` move along the timeline, and
//! `instant - instant` gives the `Duration` between two points.
//!
//! # Examples
//!
//! ## Parse a timestamp, add a span, and print it
//!
//! ```silk
//! import silk.core.result { Result }
//! import silk.time.duration { Duration }
//! import silk.time.instant { Instant }
//! import silk.time.text { TimeParseError }
//!
//! pub fn main() -> i32 {
//!   match Instant.parse("2026-11-19T18:36:22+01:00") {
//!     Result<Instant, TimeParseError>.Success { value } => {
//!       if value.unixSeconds() != 1795109782 {
//!         return 1
//!       }
//!       let later = value + Duration.fromHours(7)
//!       let reading = later.toUtc()
//!       if reading.date().day() != 20 || reading.time().hour() != 0 {
//!         return 2
//!       }
//!       if &(later - value) != &Duration.fromSeconds(25200) {
//!         return 3
//!       }
//!       return 0
//!     }
//!     Result<Instant, TimeParseError>.Failure { error: _ } => {
//!       return 4
//!     }
//!   }
//! }
//! ```
//!
//! @category Time
import silk.core.equal { Equal }
import silk.core.ops { Add, Subtract }
import silk.core.option { Option }
import silk.core.order { Order, Ordering }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.text.format { Debug, Display, Format, Formatter }
import silk.text.string { String }
import silk.collections.slice { Slice }
import silk.time.duration { Duration }
import silk.time.offset { UtcOffset }
import silk.time.plain_date { PlainDate }
import silk.time.plain_date_time { PlainDateTime }
import silk.time.plain_time { PlainTime }
import silk.time.text as Text
import silk.time.text { OffsetKind, Scanner, TimeParseError, TimeParseReason }
import silk.num.i32
import silk.num.i64
import silk.num.u32
import silk.num.usize

const BILLION: i64 = 1000000000

// 100 million days in seconds, the distance from the epoch to each end of the range.
const LIMIT: i64 = 8640000000000

/// A point on the UTC timeline with nanosecond precision.
///
/// # Details
///
/// The value is whole seconds since `1970-01-01T00:00:00Z`, rounded toward negative infinity, and
/// a nanosecond part from 0 to 999,999,999 that counts forward, also before 1970. Leap seconds
/// are not counted, as in Unix time. The range is `-271821-04-20T00:00:00Z` to
/// `+275760-09-13T00:00:00Z`.
///
/// `==`, `!=`, `<`, `<=`, `>`, and `>=` compare positions on the timeline. `+` and `-` with a
/// `Duration` move the instant and trap when the result is outside the range. `-` between two
/// instants gives a `Duration`. `Display` writes the reading in UTC with the suffix `Z`.
pub struct Instant {
  seconds: i64,
  nanoseconds: u32,
}

impl Copy for Instant {}

impl Instant {
  /// Returns the instant `seconds` seconds plus `nanoseconds` nanoseconds after the Unix epoch.
  ///
  /// # Details
  ///
  /// Whole seconds in `nanoseconds` move into the seconds, and both arguments can be negative. So
  /// `Instant.make(0, 5000000000)` is five seconds after the epoch and `Instant.make(0, -1)` is
  /// one nanosecond before it.
  ///
  /// # Gotchas
  ///
  /// An instant outside the range traps. [`Instant.checkedMake`] returns `None` instead.
  pub fn make(seconds: i64, nanoseconds: i64) -> Instant {
    return orTrap(
      Instant.checkedMake(seconds, nanoseconds),
      "Instant.make: the instant is outside the Instant range",
    )
  }

  /// Returns the instant `seconds` seconds plus `nanoseconds` nanoseconds after the Unix epoch, or
  /// `None` when it is outside `-271821-04-20T00:00:00Z` to `+275760-09-13T00:00:00Z`.
  ///
  /// # Details
  ///
  /// Whole seconds in `nanoseconds` move into the seconds, and both arguments can be negative.
  pub fn checkedMake(seconds: i64, nanoseconds: i64) -> Option<Instant> {
    let mut carried = nanoseconds / BILLION
    let mut remainder = nanoseconds % BILLION
    if remainder < 0 {
      carried = carried - 1
      remainder = remainder + BILLION
    }
    match i64.checkedAdd(seconds, carried) {
      Option<i64>.Some { value } => {
        return inRange(value, i64.toU32(remainder))
      }
      Option<i64>.None => {
        return Option<Instant>.none()
      }
    }
  }

  /// Returns the Unix epoch, `1970-01-01T00:00:00Z`.
  pub fn epoch() -> Instant {
    return Instant { seconds: 0, nanoseconds: 0 }
  }

  /// Returns the first instant of the range, `-271821-04-20T00:00:00Z`.
  pub fn min() -> Instant {
    return Instant { seconds: -LIMIT, nanoseconds: 0 }
  }

  /// Returns the last instant of the range, `+275760-09-13T00:00:00Z`.
  pub fn max() -> Instant {
    return Instant { seconds: LIMIT, nanoseconds: 0 }
  }

  /// Returns the instant `seconds` seconds after the Unix epoch, or before it for a negative count.
  ///
  /// # Gotchas
  ///
  /// An instant outside the range traps. [`Instant.checkedMake`] returns `None` instead.
  pub fn fromUnixSeconds(seconds: i64) -> Instant {
    return Instant.make(seconds, 0)
  }

  /// Returns the instant `milliseconds` milliseconds after the Unix epoch, or before it for a
  /// negative count.
  ///
  /// # Gotchas
  ///
  /// An instant outside the range traps.
  pub fn fromUnixMilliseconds(milliseconds: i64) -> Instant {
    let mut seconds = milliseconds / 1000
    let mut rest = milliseconds % 1000
    if rest < 0 {
      seconds = seconds - 1
      rest = rest + 1000
    }
    return Instant.make(seconds, rest * 1000000)
  }

  /// Returns the instant `microseconds` microseconds after the Unix epoch, or before it for a
  /// negative count.
  ///
  /// # Gotchas
  ///
  /// An instant outside the range traps.
  pub fn fromUnixMicroseconds(microseconds: i64) -> Instant {
    let mut seconds = microseconds / 1000000
    let mut rest = microseconds % 1000000
    if rest < 0 {
      seconds = seconds - 1
      rest = rest + 1000000
    }
    return Instant.make(seconds, rest * 1000)
  }

  /// Returns the instant `nanoseconds` nanoseconds after the Unix epoch, or before it for a
  /// negative count. Each `i64` value is in range: it covers the years 1677 to 2262.
  pub fn fromUnixNanoseconds(nanoseconds: i64) -> Instant {
    return Instant.make(0, nanoseconds)
  }

  /// Returns the whole seconds since the Unix epoch, rounded toward negative infinity.
  ///
  /// # Details
  ///
  /// The instant is this value plus [`Instant.subsecondNanoseconds`]. Half a second before the
  /// epoch has `-1` whole seconds and a nanosecond part of 500,000,000.
  pub fn unixSeconds(self: Self) -> i64 {
    return self.seconds
  }

  /// Returns the nanosecond part of the instant, from 0 to 999,999,999.
  ///
  /// # Details
  ///
  /// The part counts forward from [`Instant.unixSeconds`], also before the epoch.
  pub fn subsecondNanoseconds(self: Self) -> u32 {
    return self.nanoseconds
  }

  /// Returns the whole milliseconds since the Unix epoch, rounded toward negative infinity.
  pub fn unixMilliseconds(self: Self) -> i64 {
    return self.seconds * 1000 + u32.toI64(self.nanoseconds / 1000000)
  }

  /// Returns the whole microseconds since the Unix epoch, rounded toward negative infinity.
  pub fn unixMicroseconds(self: Self) -> i64 {
    return self.seconds * 1000000 + u32.toI64(self.nanoseconds / 1000)
  }

  /// Returns the nanoseconds since the Unix epoch, or `None` when the count does not fit an `i64`,
  /// which is the case before the year 1677 and after the year 2262.
  pub fn unixNanoseconds(self: Self) -> Option<i64> {
    return Duration.make(self.seconds, u32.toI64(self.nanoseconds)).toNanoseconds()
  }

  /// Returns the instant `span` later, or earlier for a negative span, or `None` when it is
  /// outside the range.
  pub fn checkedAdd(self: Self, span: Duration) -> Option<Instant> {
    let mut nanoseconds = self.nanoseconds + span.subsecondNanoseconds()
    let mut carry: i64 = 0
    if nanoseconds >= 1000000000 {
      nanoseconds = nanoseconds - 1000000000
      carry = 1
    }
    // The seconds of an instant are within 8.64e12 of zero, so adding the carry cannot overflow.
    match i64.checkedAdd(self.seconds + carry, span.wholeSeconds()) {
      Option<i64>.Some { value } => {
        return inRange(value, nanoseconds)
      }
      Option<i64>.None => {
        return Option<Instant>.none()
      }
    }
  }

  /// Returns the instant `span` earlier, or later for a negative span, or `None` when it is
  /// outside the range.
  pub fn checkedSubtract(self: Self, span: Duration) -> Option<Instant> {
    let mut nanoseconds = u32.toI64(self.nanoseconds) - u32.toI64(span.subsecondNanoseconds())
    let mut borrow: i64 = 0
    if nanoseconds < 0 {
      nanoseconds = nanoseconds + BILLION
      borrow = 1
    }
    match i64.checkedSubtract(self.seconds - borrow, span.wholeSeconds()) {
      Option<i64>.Some { value } => {
        return inRange(value, i64.toU32(nanoseconds))
      }
      Option<i64>.None => {
        return Option<Instant>.none()
      }
    }
  }

  /// Returns the span from `earlier` to this instant. It is negative when `earlier` is later.
  pub fn since(self: Self, earlier: Instant) -> Duration {
    return Duration.make(
      self.seconds - earlier.seconds,
      u32.toI64(self.nanoseconds) - u32.toI64(earlier.nanoseconds),
    )
  }

  /// Returns the span from this instant to `later`. It is negative when `later` is earlier.
  pub fn until(self: Self, later: Instant) -> Duration {
    return later.since(self)
  }

  /// Returns the date and time that a clock in UTC shows at this instant.
  pub fn toUtc(self: Self) -> PlainDateTime {
    return self.toOffset(UtcOffset.utc())
  }

  /// Returns the date and time that a clock `offset` ahead of UTC shows at this instant.
  pub fn toOffset(self: Self, offset: UtcOffset) -> PlainDateTime {
    match PlainDateTime.fromEpochSeconds(
      self.seconds + i32.toI64(offset.totalSeconds()),
      self.nanoseconds,
    ) {
      Option<PlainDateTime>.Some { value } => {
        return value
      }
      Option<PlainDateTime>.None => {
        // Not reachable: the PlainDateTime range is one day wider than the Instant range at each
        // end, and an offset is less than a day.
        return Intrinsic.trap("Instant.toOffset: the reading is outside the PlainDateTime range")
      }
    }
  }

  /// Returns the instant at which a clock in UTC shows `reading`, or `None` when it is outside the
  /// range.
  pub fn fromUtc(reading: PlainDateTime) -> Option<Instant> {
    return Instant.fromLocal(reading, UtcOffset.utc())
  }

  /// Returns the instant at which a clock `offset` ahead of UTC shows `reading`, or `None` when
  /// it is outside the range.
  pub fn fromLocal(reading: PlainDateTime, offset: UtcOffset) -> Option<Instant> {
    return inRange(
      reading.toEpochSeconds() - i32.toI64(offset.totalSeconds()),
      reading.time().subsecondNanoseconds(),
    )
  }

  /// Returns the instant at which a clock in UTC shows the given date and time, or `None` when a
  /// field does not exist, such as month 13, February 30, or hour 24, or when the instant is
  /// outside the range.
  pub fn fromUtcFields(year: i32, month: u8, day: u8, hour: u8, minute: u8, second: u8) -> Option<Instant> {
    match PlainDate.checkedMake(year, month, day) {
      Option<PlainDate>.Some { value } => {
        match PlainTime.checkedMake(hour, minute, second, 0) {
          Option<PlainTime>.Some { value: time } => {
            match PlainDateTime.checkedMake(value, time) {
              Option<PlainDateTime>.Some { value: reading } => {
                return Instant.fromUtc(reading)
              }
              Option<PlainDateTime>.None => {}
            }
          }
          Option<PlainTime>.None => {}
        }
      }
      Option<PlainDate>.None => {}
    }
    return Option<Instant>.none()
  }

  /// Reads an instant from RFC 3339 or ISO 8601 text such as `2026-11-19T17:36:22.5Z`.
  ///
  /// # Details
  ///
  /// The text is a date, `YYYY-MM-DD` or `YYYYMMDD`, then `T`, `t`, or a space, then a time:
  /// `HH`, `HH:MM`, `HH:MM:SS`, `HHMM`, or `HHMMSS`, with an optional fraction of one to nine
  /// digits, then `Z` or a numeric offset such as `+01:00`. Second `60` reads as `59`. Bracketed
  /// annotations can follow, as in `2026-11-19T18:36:22+01:00[Europe/Rome]`. They are checked and
  /// then ignored: the offset alone decides the instant.
  ///
  /// # Errors
  ///
  /// - `TimeParseReason.UnexpectedEnd` or `UnexpectedCharacter` if the text does not have that
  ///   form.
  /// - `TimeParseReason.OutOfRange` if a field names no real value, such as month 13 or hour 24,
  ///   or the instant is outside the range.
  /// - `TimeParseReason.MissingTime` if the text has no time of day.
  /// - `TimeParseReason.MissingOffset` if the text has neither `Z` nor a numeric offset.
  /// - `TimeParseReason.UnsupportedCalendar` if a calendar annotation is not `[u-ca=iso8601]`.
  /// - `TimeParseReason.UnknownCriticalAnnotation` if an annotation with an unknown key starts
  ///   with `!`.
  pub fn parse(text: string) -> Result<Instant, TimeParseError> {
    return Instant.parseBytes(String.utf8Bytes(text))
  }

  /// Reads an instant from the bytes of RFC 3339 or ISO 8601 text such as
  /// `2026-11-19T17:36:22.5Z`.
  ///
  /// # Details
  ///
  /// The text is a date, `YYYY-MM-DD` or `YYYYMMDD`, then `T`, `t`, or a space, then a time:
  /// `HH`, `HH:MM`, `HH:MM:SS`, `HHMM`, or `HHMMSS`, with an optional fraction of one to nine
  /// digits, then `Z` or a numeric offset such as `+01:00`. Second `60` reads as `59`. Bracketed
  /// annotations can follow. They are checked and then ignored: the offset alone decides the
  /// instant.
  ///
  /// # Errors
  ///
  /// - `TimeParseReason.UnexpectedEnd` or `UnexpectedCharacter` if the text does not have that
  ///   form.
  /// - `TimeParseReason.OutOfRange` if a field names no real value, such as month 13 or hour 24,
  ///   or the instant is outside the range.
  /// - `TimeParseReason.MissingTime` if the text has no time of day.
  /// - `TimeParseReason.MissingOffset` if the text has neither `Z` nor a numeric offset.
  /// - `TimeParseReason.UnsupportedCalendar` if a calendar annotation is not `[u-ca=iso8601]`.
  /// - `TimeParseReason.UnknownCriticalAnnotation` if an annotation with an unknown key starts
  ///   with `!`.
  pub fn parseBytes(bytes: &[u8]) -> Result<Instant, TimeParseError> {
    let mut scanner = Scanner.make(bytes)
    let parsed = scanner.dateTime()
    match scanner.failure() {
      Option<TimeParseError>.Some { value } => {
        return Result<Instant, TimeParseError>.failResult(value)
      }
      Option<TimeParseError>.None => {}
    }
    if !parsed.hasTime {
      return Result<Instant, TimeParseError>.failResult(
        TimeParseError { reason: TimeParseReason.MissingTime, offset: bytes.length },
      )
    }
    match parsed.offset.kind {
      OffsetKind.Absent => {
        return Result<Instant, TimeParseError>.failResult(
          TimeParseError { reason: TimeParseReason.MissingOffset, offset: bytes.length },
        )
      }
      _ => {}
    }
    let time = PlainTime.make(
      parsed.time.hour,
      parsed.time.minute,
      parsed.time.second,
      parsed.time.nanosecond,
    )
    match PlainDate.checkedMake(parsed.date.year, parsed.date.month, parsed.date.day) {
      Option<PlainDate>.Some { value } => {
        match PlainDateTime.checkedMake(value, time) {
          Option<PlainDateTime>.Some { value: reading } => {
            match Instant.fromLocal(reading, UtcOffset.fromSeconds(parsed.offset.seconds)) {
              Option<Instant>.Some { value: instant } => {
                return Result<Instant, TimeParseError>.succeed(instant)
              }
              Option<Instant>.None => {}
            }
          }
          Option<PlainDateTime>.None => {}
        }
      }
      Option<PlainDate>.None => {}
    }
    return Result<Instant, TimeParseError>.failResult(
      TimeParseError { reason: TimeParseReason.OutOfRange, offset: 0 },
    )
  }

  /// Writes the instant as the reading in UTC with the suffix `Z`, as in `2026-11-19T17:36:22Z`,
  /// at `output[at]`, and returns the offset after it.
  ///
  /// # Details
  ///
  /// The text is valid RFC 3339 for the years 0 to 9999. It has a fraction, without zeros at the
  /// end, when the nanosecond part is not zero. It is at most 33 bytes.
  pub fn writeUtc(self: Self, output: &mut [u8], at: usize) -> usize {
    let to = self.toUtc().write(&mut output, at)
    output[to] = 90
    return to + 1
  }

  /// Writes the instant as the reading of a clock `offset` ahead of UTC, followed by that offset,
  /// as in `2026-11-19T18:36:22+01:00`, at `output[at]`, and returns the offset after it.
  ///
  /// # Details
  ///
  /// The text is valid RFC 3339 for the years 0 to 9999 when the offset has no seconds part. The
  /// zero offset is written `+00:00`. The text is at most 41 bytes.
  pub fn writeWithOffset(self: Self, offset: UtcOffset, output: &mut [u8], at: usize) -> usize {
    let to = self.toOffset(offset).write(&mut output, at)
    return Text.writeOffset(&mut output, to, offset.totalSeconds())
  }

  fn same(left: &Instant, right: &Instant) -> bool {
    return left.seconds == right.seconds && left.nanoseconds == right.nanoseconds
  }

  fn compare(left: &Instant, right: &Instant) -> Ordering {
    if left.seconds < right.seconds {
      return Ordering.Less
    }
    if left.seconds > right.seconds {
      return Ordering.Greater
    }
    if left.nanoseconds < right.nanoseconds {
      return Ordering.Less
    }
    if left.nanoseconds > right.nanoseconds {
      return Ordering.Greater
    }
    return Ordering.Equal
  }

  fn addOperator(left: Instant, right: Duration) -> Instant {
    return orTrap(left.checkedAdd(right), "Instant: the sum is outside the Instant range")
  }

  fn subtractOperator(left: Instant, right: Duration) -> Instant {
    return orTrap(left.checkedSubtract(right), "Instant: the difference is outside the Instant range")
  }

  fn differenceOperator(left: Instant, right: Instant) -> Duration {
    return left.since(right)
  }
}

impl Equal for Instant {
  equals: Instant.same
}

impl Order for Instant {
  compare: Instant.compare
}

impl Add<Duration, Instant> for Instant {
  add: Instant.addOperator
}

impl Subtract<Duration, Instant> for Instant {
  subtract: Instant.subtractOperator
}

impl Subtract<Instant, Duration> for Instant {
  subtract: Instant.differenceOperator
}

/// Writes the instant as the reading in UTC with the suffix `Z`, as in `2026-11-19T17:36:22Z` or
/// `2026-11-19T17:36:22.5Z`.
impl Display for Instant {
  effect fn display(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    let mut output: [u8; 33] = [0; 33]
    let length = Instant.writeUtc(self.*, &mut output, 0)
    return run Format.write(&mut formatter, Slice.view<u8>(&output, 0, length))
  }
}

/// Writes the same text as `Display`: the reading in UTC with the suffix `Z`.
impl Debug for Instant {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return run Display.display(self, &mut formatter)
  }
}

fn inRange(seconds: i64, nanoseconds: u32) -> Option<Instant> {
  if seconds < -LIMIT || seconds > LIMIT || (seconds == LIMIT && nanoseconds != 0) {
    return Option<Instant>.none()
  }
  return Option<Instant>.some(Instant { seconds: seconds, nanoseconds: nanoseconds })
}

fn orTrap(result: Option<Instant>, message: string<'static>) -> Instant {
  match result {
    Option<Instant>.Some { value } => {
      return value
    }
    Option<Instant>.None => {
      return Intrinsic.trap(message)
    }
  }
}
