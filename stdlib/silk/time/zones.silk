//! Where time zones come from: the `TimeZones` effect, which gives a `Zone` for a name, and the
//! `LocalZone` effect, which names the zone of this machine.
//!
//! # When to use
//!
//! Require `&mut TimeZones` in code that needs the rules of a named zone, such as
//! `America/Sao_Paulo`. Require `&mut LocalZone` in code that needs to know which zone the
//! machine is set to. A program provides both with `silk.time.zones_native`, which has one
//! implementation for each operating system. A test provides [`FixedTimeZones`] and
//! [`FixedLocalZone`], so its result does not depend on the machine.
//!
//! # Details
//!
//! The two effects are separate because they come from different places. On some systems the
//! name of the local zone comes from the operating system, and the rules of all zones come from
//! data inside the program.
//!
//! [`TimeZones.zone`] returns an owned `Zone`. Load a zone one time and keep it; a
//! `ZonedDateTime` of `silk.time.zoned` borrows it. Every provider gives the zone `UTC` and
//! fixed offsets such as `+05:30` without any data.
//!
//! There is no default zone. Code that wants the local time shows `&mut LocalZone` in its
//! signature.
//!
//! # Errors
//!
//! - [`ZoneLookupError`] from [`TimeZones`], with a reason: the zone is not known, the name is
//!   not valid, or the data cannot be read or is damaged.
//! - [`NoLocalZoneError`] from [`LocalZone`] if the machine does not say which zone it is in.
//!   The caller decides what to use then; no provider answers `UTC` in silence.
//!
//! # Examples
//!
//! ## Provide fixed zones in a test
//!
//! ```silk
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.collections.bytes { Bytes }
//! import silk.core.effect { Effect }
//! import silk.time.instant { Instant }
//! import silk.time.zone { ZoneDataError }
//! import silk.time.zoned { ZonedDateTime }
//! import silk.time.zones { FixedLocalZone, FixedTimeZones, LocalZone, NoLocalZoneError, TimeZones, ZoneLookupError }
//!
//! // The hour that the local clock shows at `at`.
//! effect fn localHour(at: Instant) -> u8
//!   ! ZoneLookupError | NoLocalZoneError | OutOfMemoryError
//!   ? &mut TimeZones | &mut LocalZone | &mut Allocator {
//!   let name = run LocalZone.name()
//!   let zone = run TimeZones.zoneBytes(Bytes.asSlice(&name))
//!   return ZonedDateTime.make(at, &zone).time().hour()
//! }
//!
//! effect fn check() -> i32
//!   ! ZoneDataError | ZoneLookupError | NoLocalZoneError | OutOfMemoryError
//!   ? &mut Allocator {
//!   let mut zones = FixedTimeZones.make()
//!   run zones.addPosixRule("Europe/Rome", "CET-1CEST,M3.5.0,M10.5.0/3")
//!   let mut here = run FixedLocalZone.make("Europe/Rome")
//!   let hour = run localHour(Instant.fromUnixSeconds(1795109782))
//!     |> Effect.provideMut<TimeZones>(&mut zones)
//!     |> Effect.provideMut<LocalZone>(&mut here)
//!   if hour != 18 {
//!     return 1
//!   }
//!   return 0
//! }
//!
//! effect fn failed(error: ZoneDataError | ZoneLookupError | NoLocalZoneError | OutOfMemoryError) -> i32 {
//!   return 2
//! }
//!
//! pub effect fn main() -> i32 {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   return run Effect.catchAll(check(), failed) |> Effect.provideMut<Allocator>(&mut allocator)
//! }
//! ```
//!
//! @category Time
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.format { Debug, Format, Formatter }
import silk.text.string { InvalidUtf8, String }
import silk.time.offset { UtcOffset }
import silk.time.text { TimeParseError }
import silk.time.zone { Zone, ZoneDataError }
import silk.num.usize

/// The cause of a [`ZoneLookupError`].
pub enum ZoneLookupReason {
  /// The provider has no zone with that name.
  UnknownZone,
  /// The name cannot be a zone name: it is empty or too long, or it has a character other than
  /// ASCII letters, digits, `/`, `_`, `-`, `+`, and `.`, or a part that is empty, `.`, or `..`.
  InvalidName,
  /// The provider could not read its data.
  Unreadable,
  /// The data of the zone is damaged.
  InvalidData,
}

impl Debug for ZoneLookupReason {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return match &self.* {
      ZoneLookupReason.UnknownZone => run Format.write(&mut formatter, b"UnknownZone")
      ZoneLookupReason.InvalidName => run Format.write(&mut formatter, b"InvalidName")
      ZoneLookupReason.Unreadable => run Format.write(&mut formatter, b"Unreadable")
      ZoneLookupReason.InvalidData => run Format.write(&mut formatter, b"InvalidData")
    }
  }
}

/// The error of the [`TimeZones`] effect: why the provider cannot answer.
pub struct ZoneLookupError {
  /// The cause.
  pub reason: ZoneLookupReason,
}

impl Copy for ZoneLookupError {}

impl Debug for ZoneLookupError {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    run Format.write(&mut formatter, b"ZoneLookupError(")
    run Debug.debug(&self.reason, &mut formatter)
    return run Format.write(&mut formatter, b")")
  }
}

/// The error of the [`LocalZone`] effect: the machine does not say which zone it is in.
pub struct NoLocalZoneError {}

impl Copy for NoLocalZoneError {}

impl Debug for NoLocalZoneError {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return run Format.write(&mut formatter, b"NoLocalZoneError")
  }
}

/// The effect that gives the rules of a time zone for its name.
///
/// # Details
///
/// A name is an identifier of the IANA time zone database, such as `America/Sao_Paulo`. Names
/// are compared without letter case, and a link such as `Asia/Calcutta` is accepted. The zone
/// has the name as the provider spells it, so `america/sao_paulo` gives a zone named
/// `America/Sao_Paulo`, and a link keeps its own name. `UTC` and an offset such as `+05:30` or
/// `-03` give a zone with that fixed offset from every provider.
///
/// A provider is the choice of where the rules come from: the files of the operating system
/// (`OsTimeZones` of `silk.time.zones_native`), or zones that the program supplies
/// ([`FixedTimeZones`]).
pub service TimeZones {
  /// Returns the zone named by the bytes `name`.
  ///
  /// # Errors
  ///
  /// - [`ZoneLookupError`] with the reason `UnknownZone` if the provider has no such zone,
  ///   `InvalidName` if `name` cannot be a zone name, `Unreadable` if the provider cannot read
  ///   its data, or `InvalidData` if the data of the zone is damaged.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the zone.
  effect fn zoneBytes(
    name: &[u8]
  ) -> Zone ! ZoneLookupError | OutOfMemoryError ? &mut TimeZones | &mut Allocator
  /// Returns copies of the names of all zones of the provider, sorted by their bytes. `UTC` and
  /// the fixed offsets are not in the list.
  ///
  /// # Errors
  ///
  /// - [`ZoneLookupError`] with the reason `Unreadable` if the provider cannot list its zones.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the copies.
  effect fn names() -> List<Bytes> ! ZoneLookupError | OutOfMemoryError ? &mut TimeZones | &mut Allocator
  /// Returns the version of the time zone database that the provider uses, such as `2026b`, or
  /// empty bytes if the provider does not know it.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the copy.
  effect fn version() -> Bytes ! OutOfMemoryError ? &mut TimeZones | &mut Allocator
}

impl TimeZones {
  /// Returns the zone named `name`, such as `America/Sao_Paulo`.
  ///
  /// # Errors
  ///
  /// - [`ZoneLookupError`] and `OutOfMemoryError`, as for [`TimeZones.zoneBytes`].
  pub effect fn zone(
    name: string
  ) -> Zone ! ZoneLookupError | OutOfMemoryError ? &mut TimeZones | &mut Allocator {
    return run TimeZones.zoneBytes(String.utf8Bytes(name))
  }

  /// Returns the zone for a name that needs no data: `UTC` in any letter case, or an offset
  /// such as `+05:30`, `-0300`, or `+01`. Returns `None` for other names. Providers call it
  /// first.
  pub fn fixedZone(name: &[u8]) -> Option<Zone> {
    if name.length == 3 && lower(name[0]) == 117 && lower(name[1]) == 116 && lower(name[2]) == 99 {
      return Option<Zone>.some(Zone.utc())
    }
    if name.length == 0 || (name[0] != 43 && name[0] != 45) {
      return Option<Zone>.none()
    }
    let text = match String.fromUtf8(name) {
      Result<string, InvalidUtf8>.Success { value } => value
      Result<string, InvalidUtf8>.Failure { .. } => {
        return Option<Zone>.none()
      }
    }
    return match UtcOffset.parse(text) {
      Result<UtcOffset, TimeParseError>.Success { value } => Option<Zone>.some(Zone.fixed(value))
      Result<UtcOffset, TimeParseError>.Failure { .. } => Option<Zone>.none()
    }
  }

  /// Returns `true` if `name` has the form of a zone name: 1 to 255 bytes of ASCII letters,
  /// digits, `/`, `_`, `-`, `+`, and `.`, in parts separated by `/`, where no part is empty, `.`,
  /// or `..`.
  ///
  /// # When to use
  ///
  /// A provider that turns a name into a file path calls it first, so that a name cannot leave
  /// the directory of the zones.
  pub fn isValidName(name: &[u8]) -> bool {
    if name.length == 0 || name.length > 255 {
      return false
    }
    let mut partStart = usize.ZERO
    let mut index = usize.ZERO
    while index <= name.length {
      if index == name.length || name[index] == 47 {
        let length = index - partStart
        if length == 0 {
          return false
        }
        if name[partStart] == 46 && (length == 1 || (length == 2 && name[partStart + 1] == 46)) {
          return false
        }
        partStart = index + 1
      } else {
        let byte = name[index]
        let letter = (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122)
        let digit = byte >= 48 && byte <= 57
        if !letter && !digit && byte != 95 && byte != 45 && byte != 43 && byte != 46 {
          return false
        }
      }
      index = index + 1
    }
    return true
  }

  /// Returns `true` if `left` and `right` are the same zone name, without letter case.
  pub fn sameName(left: &[u8], right: &[u8]) -> bool {
    if left.length != right.length {
      return false
    }
    let mut index = usize.ZERO
    while index < left.length {
      if lower(left[index]) != lower(right[index]) {
        return false
      }
      index = index + 1
    }
    return true
  }

  /// Returns a [`ZoneLookupError`] with the reason `reason`. Providers use it.
  pub fn lookupFailure(reason: ZoneLookupReason) -> ZoneLookupError {
    return ZoneLookupError { reason: reason }
  }
}

/// The effect that names the time zone of this machine.
///
/// # Details
///
/// The answer is a zone name to give to [`TimeZones.zoneBytes`], such as `America/Sao_Paulo`. It
/// is read at each call, so a program sees a change of the setting.
pub service LocalZone {
  /// Returns a copy of the name of the zone that this machine is set to.
  ///
  /// # Errors
  ///
  /// - [`NoLocalZoneError`] if the machine does not say which zone it is in.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the copy.
  effect fn name() -> Bytes ! NoLocalZoneError | OutOfMemoryError ? &mut LocalZone | &mut Allocator
}

impl LocalZone {
  /// Returns a [`NoLocalZoneError`]. Providers use it.
  pub fn unknown() -> NoLocalZoneError {
    return NoLocalZoneError {}
  }
}

fn lower(byte: u8) -> u8 {
  if byte >= 65 && byte <= 90 {
    return byte + 32
  }
  return byte
}

// One zone of a `FixedTimeZones`: a name and either a TZif file or a POSIX rule.
struct FixedEntry {
  name: Bytes,
  data: Bytes,
  isRule: bool,
}

/// A `TimeZones` provider with the zones that the program gives it, for tests and for programs
/// that carry their own zone data.
///
/// # Details
///
/// Add each zone with [`FixedTimeZones.addTzif`] or [`FixedTimeZones.addPosixRule`]. The
/// provider keeps a copy of the data and makes the zone at each lookup. A name that is added
/// again replaces the earlier one.
pub struct FixedTimeZones {
  entries: List<FixedEntry>,
  release: Bytes,
}

impl FixedTimeZones {
  /// Returns a provider with no zones. It does not allocate.
  pub fn make() -> FixedTimeZones {
    return FixedTimeZones { entries: List<FixedEntry>.make(), release: Bytes.make() }
  }

  /// Sets the database version that [`TimeZones.version`] returns, such as `2026b`.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the copy.
  pub effect fn setVersion(self: &mut Self, version: string) -> () ! OutOfMemoryError ? &mut Allocator {
    self.release = run Bytes.copy(String.utf8Bytes(version))
    return ()
  }

  /// Adds the zone `name` with the bytes of a TZif file, the format of the files under
  /// `/usr/share/zoneinfo`.
  ///
  /// # Errors
  ///
  /// - `ZoneDataError` if `data` is not a valid TZif file.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the copy.
  pub effect fn addTzif(self: &mut Self, name: string, data: &[u8]) -> ()
    ! ZoneDataError | OutOfMemoryError
    ? &mut Allocator {
    // Make the zone one time so that bad data fails here, not at a lookup.
    let checked = run Zone.fromTzif(name, data)
    drop checked
    return run self.add(name, data, false)
  }

  /// Adds the zone `name` with a POSIX `TZ` rule such as `CET-1CEST,M3.5.0,M10.5.0/3`. See
  /// `Zone.fromPosixRule` for the form of a rule.
  ///
  /// # Errors
  ///
  /// - `ZoneDataError` if `rule` is not a valid rule.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the copy.
  pub effect fn addPosixRule(self: &mut Self, name: string, rule: string) -> ()
    ! ZoneDataError | OutOfMemoryError
    ? &mut Allocator {
    let checked = run Zone.fromPosixRule(rule)
    drop checked
    return run self.add(name, String.utf8Bytes(rule), true)
  }

  effect fn add(self: &mut Self, name: string, data: &[u8], isRule: bool) -> () ! OutOfMemoryError ? &mut Allocator {
    let nameBytes = String.utf8Bytes(name)
    let entry = FixedEntry { name: run Bytes.copy(nameBytes), data: run Bytes.copy(data), isRule: isRule }
    let mut index = usize.ZERO
    while index < List<FixedEntry>.length(&self.entries) {
      if TimeZones.sameName(Bytes.asSlice(&List<FixedEntry>.asSlice(&self.entries)[index].name), nameBytes) {
        List<FixedEntry>.set(&mut self.entries, index, move entry)
        return ()
      }
      index = index + 1
    }
    return run List<FixedEntry>.append(&mut self.entries, move entry)
  }

  effect fn zoneBytes(self: &mut Self, name: &[u8]) -> Zone ! ZoneLookupError | OutOfMemoryError ? &mut Allocator {
    if let Option<Zone>.Some { value } = move TimeZones.fixedZone(name) {
      return move value
    }
    let entries = List<FixedEntry>.asSlice(&self.entries)
    let mut index = usize.ZERO
    while index < entries.length {
      if TimeZones.sameName(Bytes.asSlice(&entries[index].name), name) {
        return run made(&entries[index])
      }
      index = index + 1
    }
    if !TimeZones.isValidName(name) {
      fail TimeZones.lookupFailure(ZoneLookupReason.InvalidName)
    }
    fail TimeZones.lookupFailure(ZoneLookupReason.UnknownZone)
  }

  effect fn names(self: &mut Self) -> List<Bytes> ! ZoneLookupError | OutOfMemoryError ? &mut Allocator {
    let entries = List<FixedEntry>.asSlice(&self.entries)
    let mut result = List<Bytes>.make()
    let mut index = usize.ZERO
    while index < entries.length {
      run List<Bytes>.append(&mut result, run Bytes.copy(Bytes.asSlice(&entries[index].name)))
      index = index + 1
    }
    return run sortedNames(move result)
  }

  effect fn version(self: &mut Self) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    return run Bytes.copy(Bytes.asSlice(&self.release))
  }
}

impl TimeZones for FixedTimeZones {
  zoneBytes: FixedTimeZones.zoneBytes
  names: FixedTimeZones.names
  version: FixedTimeZones.version
}

// Makes the zone of `entry`, with the name as it was added.
effect fn made(entry: &FixedEntry) -> Zone ! ZoneLookupError | OutOfMemoryError ? &mut Allocator {
  // The name was added as a `string`, so the bytes are valid UTF-8.
  let name = unsafe String.fromUtf8Unchecked(Bytes.asSlice(&entry.name))
  let attempt = if entry.isRule {
    run Effect.result(ruleZone(name, Bytes.asSlice(&entry.data)))
  } else {
    run Effect.result(Zone.fromTzif(name, Bytes.asSlice(&entry.data)))
  }
  return match move attempt {
    Result<Zone, ZoneDataError | OutOfMemoryError>.Success { value } => move value
    Result<Zone, ZoneDataError | OutOfMemoryError>.Failure { error } => match move error {
      ZoneDataError _ => {
        fail TimeZones.lookupFailure(ZoneLookupReason.InvalidData)
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}

effect fn ruleZone(name: string, rule: &[u8]) -> Zone ! ZoneDataError | OutOfMemoryError ? &mut Allocator {
  // The rule was added as a `string`, so the bytes are valid UTF-8.
  return run Zone.fromPosixRuleNamed(name, unsafe String.fromUtf8Unchecked(rule))
}

/// Returns `names` sorted by their bytes. Providers use it for [`TimeZones.names`].
///
/// # Errors
///
/// - `OutOfMemoryError` if the `Allocator` cannot supply the sorted list.
pub effect fn sortedNames(names: List<Bytes>) -> List<Bytes> ! OutOfMemoryError ? &mut Allocator {
  let mut source = move names
  let mut result = run List<Bytes>.makeWithCapacity(List<Bytes>.length(&source))
  // Take the least name each time. The lists are a few hundred names.
  while List<Bytes>.length(&source) > 0 {
    let items = List<Bytes>.asSlice(&source)
    let mut least = usize.ZERO
    let mut index = usize.ONE
    while index < items.length {
      if before(Bytes.asSlice(&items[index]), Bytes.asSlice(&items[least])) {
        least = index
      }
      index = index + 1
    }
    let taken = List<Bytes>.remove(&mut source, least)
    run List<Bytes>.append(&mut result, move taken)
  }
  return move result
}

fn before(left: &[u8], right: &[u8]) -> bool {
  let mut index = usize.ZERO
  while index < left.length && index < right.length {
    if left[index] != right[index] {
      return left[index] < right[index]
    }
    index = index + 1
  }
  return left.length < right.length
}

/// A `LocalZone` provider that always answers with one name, for tests.
pub struct FixedLocalZone {
  zone: Bytes,
}

impl FixedLocalZone {
  /// Returns a provider that answers `name`.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the copy.
  pub effect fn make(name: string) -> FixedLocalZone ! OutOfMemoryError ? &mut Allocator {
    return FixedLocalZone { zone: run Bytes.copy(String.utf8Bytes(name)) }
  }

  effect fn name(self: &mut Self) -> Bytes ! NoLocalZoneError | OutOfMemoryError ? &mut Allocator {
    return run Bytes.copy(Bytes.asSlice(&self.zone))
  }
}

impl LocalZone for FixedLocalZone {
  name: FixedLocalZone.name
}
