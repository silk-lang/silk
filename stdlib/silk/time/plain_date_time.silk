//! Dates with a time of day and no time zone: the [`PlainDateTime`] type.
//!
//! # When to use
//!
//! Use [`PlainDateTime`] for a wall-clock reading that is not tied to a place, such as "the
//! meeting is on 2026-11-19 at 17:30" before the place is known, or a timestamp in a file that
//! states no offset. It is not a point in time. For a point in time, use `silk.time.instant`, and
//! convert with `Instant.toOffset` and `Instant.fromLocal`.
//!
//! # Details
//!
//! A `PlainDateTime` is a `PlainDate` and a `PlainTime`. The range is
//! `-271821-04-19T00:00:00.000000001` to `+275760-09-13T23:59:59.999999999`, the range of
//! ECMAScript Temporal.
//!
//! # Examples
//!
//! ## Parse a date and time and add an exact span
//!
//! ```silk
//! import silk.core.result { Result }
//! import silk.time.duration { Duration }
//! import silk.time.plain_date_time { PlainDateTime }
//! import silk.time.text { TimeParseError }
//!
//! pub fn main() -> i32 {
//!   match PlainDateTime.parse("2026-12-31T23:30:00") {
//!     Result<PlainDateTime, TimeParseError>.Success { value } => {
//!       let later = value.add(Duration.fromHours(1))
//!       if later.date().year() != 2027 || later.time().minute() != 30 {
//!         return 1
//!       }
//!       return 0
//!     }
//!     Result<PlainDateTime, TimeParseError>.Failure { error: _ } => {
//!       return 2
//!     }
//!   }
//! }
//! ```
//!
//! @category Time
import silk.core.equal { Equal }
import silk.core.option { Option }
import silk.core.order { Order, Ordering }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.text.format { Debug, Display, Format, Formatter }
import silk.text.string { String }
import silk.collections.slice { Slice }
import silk.time.duration { Duration }
import silk.time.plain_date { PlainDate }
import silk.time.plain_time { PlainTime }
import silk.time.text as Text
import silk.time.text { OffsetKind, Scanner, TimeParseError, TimeParseReason }
import silk.num.i64
import silk.num.u32
import silk.num.u8
import silk.num.usize

/// A calendar date and a time of day in the ISO 8601 calendar, with no time zone.
///
/// # Details
///
/// The range is `-271821-04-19T00:00:00.000000001` to `+275760-09-13T23:59:59.999999999`. `==`,
/// `!=`, `<`, `<=`, `>`, and `>=` compare the date first and then the time. `Display` writes
/// `YYYY-MM-DDTHH:MM:SS`, with a fraction when the nanosecond part is not zero.
pub struct PlainDateTime {
  datePart: PlainDate,
  timePart: PlainTime,
}

impl Copy for PlainDateTime {}

impl PlainDateTime {
  /// Returns `time` on the day `date`.
  ///
  /// # Gotchas
  ///
  /// Midnight on the first date of the range, `-271821-04-19`, is outside the range and traps.
  /// [`PlainDateTime.checkedMake`] returns `None` instead.
  pub fn make(date: PlainDate, time: PlainTime) -> PlainDateTime {
    return orTrap(
      PlainDateTime.checkedMake(date, time),
      "PlainDateTime.make: the value is outside the PlainDateTime range",
    )
  }

  /// Returns `time` on the day `date`, or `None` for midnight on the first date of the range,
  /// `-271821-04-19`, which is the one combination outside the range.
  pub fn checkedMake(date: PlainDate, time: PlainTime) -> Option<PlainDateTime> {
    if &date == &PlainDate.min() && time.toDayNanoseconds() == 0 {
      return Option<PlainDateTime>.none()
    }
    return Option<PlainDateTime>.some(PlainDateTime { datePart: date, timePart: time })
  }

  /// Returns the date and time with the given fields: the year, the month from 1 to 12, the day
  /// of the month from 1, the hour from 0 to 23, and the minute and second from 0 to 59.
  ///
  /// # Gotchas
  ///
  /// A field outside its range, a date that does not exist, or a value outside the range traps.
  pub fn fromFields(year: i32, month: u8, day: u8, hour: u8, minute: u8, second: u8) -> PlainDateTime {
    return PlainDateTime.make(PlainDate.make(year, month, day), PlainTime.make(hour, minute, second, 0))
  }

  /// Returns the date part.
  pub fn date(self: Self) -> PlainDate {
    return self.datePart
  }

  /// Returns the time of day.
  pub fn time(self: Self) -> PlainTime {
    return self.timePart
  }

  /// Returns the whole seconds from `1970-01-01T00:00:00` to this date and time, rounded toward
  /// negative infinity, with every day counted as 86,400 seconds.
  ///
  /// # Details
  ///
  /// When the value is a reading in UTC, the result is its Unix time. The rest of the value is
  /// the nanosecond part of [`PlainDateTime.time`].
  pub fn toEpochSeconds(self: Self) -> i64 {
    let time = self.timePart
    return self.datePart.toEpochDays() * 86400 + u8.toI64(time.hour()) * 3600
      + u8.toI64(time.minute()) * 60
      + u8.toI64(time.second())
  }

  /// Returns the date and time that is `seconds` seconds plus `nanosecond` nanoseconds after
  /// `1970-01-01T00:00:00`, with every day counted as 86,400 seconds, or `None` when it is outside
  /// the range or `nanosecond` is above 999,999,999.
  ///
  /// # Details
  ///
  /// `seconds` can be negative; the nanosecond part always counts forward. With a Unix time, the
  /// result is the reading in UTC.
  pub fn fromEpochSeconds(seconds: i64, nanosecond: u32) -> Option<PlainDateTime> {
    if nanosecond > 999999999 {
      return Option<PlainDateTime>.none()
    }
    let mut days = seconds / 86400
    let mut ofDay = seconds % 86400
    if ofDay < 0 {
      days = days - 1
      ofDay = ofDay + 86400
    }
    match PlainDate.fromEpochDays(days) {
      Option<PlainDate>.Some { value } => {
        return PlainDateTime.checkedMake(
          value,
          PlainTime.make(
            i64.toU8(ofDay / 3600),
            i64.toU8(ofDay / 60 % 60),
            i64.toU8(ofDay % 60),
            nanosecond,
          ),
        )
      }
      Option<PlainDate>.None => {
        return Option<PlainDateTime>.none()
      }
    }
  }

  /// Returns the date and time `span` later, or earlier for a negative span, or `None` when it is
  /// outside the range.
  ///
  /// # Details
  ///
  /// Every day counts as 24 hours. A `PlainDateTime` has no time zone, so the result does not
  /// account for a daylight saving change.
  pub fn checkedAdd(self: Self, span: Duration) -> Option<PlainDateTime> {
    let mut nanosecond = self.timePart.subsecondNanoseconds() + span.subsecondNanoseconds()
    let mut carry: i64 = 0
    if nanosecond >= 1000000000 {
      nanosecond = nanosecond - 1000000000
      carry = 1
    }
    // The epoch seconds are within 8.7e12 of zero, so adding the carry cannot overflow.
    match i64.checkedAdd(self.toEpochSeconds() + carry, span.wholeSeconds()) {
      Option<i64>.Some { value } => {
        return PlainDateTime.fromEpochSeconds(value, nanosecond)
      }
      Option<i64>.None => {
        return Option<PlainDateTime>.none()
      }
    }
  }

  /// Returns the date and time `span` later, or earlier for a negative span. Every day counts as
  /// 24 hours.
  ///
  /// # Gotchas
  ///
  /// A result outside the range traps. [`PlainDateTime.checkedAdd`] returns `None` instead.
  pub fn add(self: Self, span: Duration) -> PlainDateTime {
    return orTrap(
      self.checkedAdd(span),
      "PlainDateTime.add: the value is outside the PlainDateTime range",
    )
  }

  /// Returns the exact span from this date and time to `other`, with every day counted as 24
  /// hours. It is negative when `other` is earlier.
  pub fn until(self: Self, other: PlainDateTime) -> Duration {
    return Duration.make(
      other.toEpochSeconds() - self.toEpochSeconds(),
      u32.toI64(other.timePart.subsecondNanoseconds()) - u32.toI64(self.timePart.subsecondNanoseconds()),
    )
  }

  /// Reads a date and time from ISO 8601 text such as `2026-11-19T17:36:22.5`.
  ///
  /// # Details
  ///
  /// The text is a date, `YYYY-MM-DD` or `YYYYMMDD`, then optionally `T`, `t`, or a space and a
  /// time: `HH`, `HH:MM`, `HH:MM:SS`, `HHMM`, or `HHMMSS`, with an optional fraction of one to
  /// nine digits. A text without a time reads as midnight. Second `60` reads as `59`. A numeric
  /// UTC offset and bracketed annotations can follow, as in
  /// `2026-11-19T17:36:22+01:00[Europe/Rome]`. They are checked and then ignored.
  ///
  /// # Errors
  ///
  /// - `TimeParseReason.UnexpectedEnd` or `UnexpectedCharacter` if the text does not have that
  ///   form.
  /// - `TimeParseReason.OutOfRange` if a field names no real value, such as month 13 or hour 24,
  ///   or the value is outside the range.
  /// - `TimeParseReason.UtcNotAllowed` if the text has the UTC designator `Z`.
  /// - `TimeParseReason.UnsupportedCalendar` if a calendar annotation is not `[u-ca=iso8601]`.
  /// - `TimeParseReason.UnknownCriticalAnnotation` if an annotation with an unknown key starts
  ///   with `!`.
  pub fn parse(text: string) -> Result<PlainDateTime, TimeParseError> {
    return PlainDateTime.parseBytes(String.utf8Bytes(text))
  }

  /// Reads a date and time from the bytes of ISO 8601 text such as `2026-11-19T17:36:22.5`.
  ///
  /// # Details
  ///
  /// The text is a date, `YYYY-MM-DD` or `YYYYMMDD`, then optionally `T`, `t`, or a space and a
  /// time: `HH`, `HH:MM`, `HH:MM:SS`, `HHMM`, or `HHMMSS`, with an optional fraction of one to
  /// nine digits. A text without a time reads as midnight. Second `60` reads as `59`. A numeric
  /// UTC offset and bracketed annotations can follow. They are checked and then ignored.
  ///
  /// # Errors
  ///
  /// - `TimeParseReason.UnexpectedEnd` or `UnexpectedCharacter` if the text does not have that
  ///   form.
  /// - `TimeParseReason.OutOfRange` if a field names no real value, such as month 13 or hour 24,
  ///   or the value is outside the range.
  /// - `TimeParseReason.UtcNotAllowed` if the text has the UTC designator `Z`.
  /// - `TimeParseReason.UnsupportedCalendar` if a calendar annotation is not `[u-ca=iso8601]`.
  /// - `TimeParseReason.UnknownCriticalAnnotation` if an annotation with an unknown key starts
  ///   with `!`.
  pub fn parseBytes(bytes: &[u8]) -> Result<PlainDateTime, TimeParseError> {
    let mut scanner = Scanner.make(bytes)
    let parsed = scanner.dateTime()
    match scanner.failure() {
      Option<TimeParseError>.Some { value } => {
        return Result<PlainDateTime, TimeParseError>.failResult(value)
      }
      Option<TimeParseError>.None => {}
    }
    match parsed.offset.kind {
      OffsetKind.Utc => {
        return Result<PlainDateTime, TimeParseError>.failResult(
          TimeParseError { reason: TimeParseReason.UtcNotAllowed, offset: 0 },
        )
      }
      _ => {}
    }
    let time = PlainTime.make(
      parsed.time.hour,
      parsed.time.minute,
      parsed.time.second,
      parsed.time.nanosecond,
    )
    match PlainDate.checkedMake(parsed.date.year, parsed.date.month, parsed.date.day) {
      Option<PlainDate>.Some { value } => {
        match PlainDateTime.checkedMake(value, time) {
          Option<PlainDateTime>.Some { value: result } => {
            return Result<PlainDateTime, TimeParseError>.succeed(result)
          }
          Option<PlainDateTime>.None => {}
        }
      }
      Option<PlainDate>.None => {}
    }
    return Result<PlainDateTime, TimeParseError>.failResult(
      TimeParseError { reason: TimeParseReason.OutOfRange, offset: 0 },
    )
  }

  /// Writes the date and time as `YYYY-MM-DDTHH:MM:SS` at `output[at]`, with a fraction when the
  /// nanosecond part is not zero, and returns the offset after it. The text is at most 32 bytes.
  pub fn write(self: Self, output: &mut [u8], at: usize) -> usize {
    let mut to = Text.writeDate(&mut output, at, self.datePart.toCivil())
    output[to] = 84
    return Text.writeTime(&mut output, to + 1, self.timePart.toClock())
  }

  fn same(left: &PlainDateTime, right: &PlainDateTime) -> bool {
    return &left.datePart == &right.datePart && &left.timePart == &right.timePart
  }

  fn compare(left: &PlainDateTime, right: &PlainDateTime) -> Ordering {
    if &left.datePart < &right.datePart {
      return Ordering.Less
    }
    if &left.datePart > &right.datePart {
      return Ordering.Greater
    }
    if &left.timePart < &right.timePart {
      return Ordering.Less
    }
    if &left.timePart > &right.timePart {
      return Ordering.Greater
    }
    return Ordering.Equal
  }
}

impl Equal for PlainDateTime {
  equals: PlainDateTime.same
}

impl Order for PlainDateTime {
  compare: PlainDateTime.compare
}

/// Writes the date and time as `YYYY-MM-DDTHH:MM:SS`, with a fraction without zeros at the end
/// when the nanosecond part is not zero, as in `2026-11-19T17:36:22.5`.
impl Display for PlainDateTime {
  effect fn display(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    let mut output: [u8; 32] = [0; 32]
    let length = PlainDateTime.write(self.*, &mut output, 0)
    return run Format.write(&mut formatter, Slice.view<u8>(&output, 0, length))
  }
}

/// Writes the same text as `Display`: `YYYY-MM-DDTHH:MM:SS` with an optional fraction.
impl Debug for PlainDateTime {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return run Display.display(self, &mut formatter)
  }
}

fn orTrap(result: Option<PlainDateTime>, message: string<'static>) -> PlainDateTime {
  match result {
    Option<PlainDateTime>.Some { value } => {
      return value
    }
    Option<PlainDateTime>.None => {
      return Intrinsic.trap(message)
    }
  }
}
