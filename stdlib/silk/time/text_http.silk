//! The date and time format of HTTP header fields such as `Date`, `Last-Modified`, and `Expires`.
//!
//! # When to use
//!
//! Use [`HttpDate.write`] for a header field that a program sends and [`HttpDate.parse`] for one
//! that it receives. For timestamps in other protocols and in files, use `Instant.parse` and
//! `Instant.writeUtc`, which read and write RFC 3339.
//!
//! # Details
//!
//! [`HttpDate.write`] writes the one form that RFC 9110 allows a sender, which is always 29 bytes:
//! `Sun, 06 Nov 1994 08:49:37 GMT`.
//!
//! [`HttpDate.parse`] reads the three forms that RFC 9110 requires of a recipient:
//!
//! - `Sun, 06 Nov 1994 08:49:37 GMT`
//! - `Sunday, 06-Nov-94 08:49:37 GMT`, where the years `70` to `99` are 1970 to 1999 and the
//!   years `00` to `69` are 2000 to 2069
//! - `Sun Nov  6 08:49:37 1994`
//!
//! Names are case-sensitive. The name of the day must be a real day name, and the parser does not
//! check that it is the day of the date. Second `60` reads as `59`.
//!
//! # Examples
//!
//! ## Write and read a header value
//!
//! ```silk
//! import silk.collections.slice { Slice }
//! import silk.core.result { Result }
//! import silk.time.instant { Instant }
//! import silk.time.text { TimeParseError }
//! import silk.time.text_http { HttpDate }
//!
//! pub fn main() -> i32 {
//!   let mut text: [u8; 29] = [0; 29]
//!   let length = HttpDate.write(Instant.fromUnixSeconds(784111777), &mut text, 0)
//!   // `text` is now `Sun, 06 Nov 1994 08:49:37 GMT`.
//!   match HttpDate.parseBytes(Slice.view<u8>(&text, 0, length)) {
//!     Result<Instant, TimeParseError>.Success { value } => {
//!       if value.unixSeconds() == 784111777 {
//!         return 0
//!       }
//!       return 1
//!     }
//!     Result<Instant, TimeParseError>.Failure { error: _ } => {
//!       return 2
//!     }
//!   }
//! }
//! ```
//!
//! @category Time
import silk.core.option { Option }
import silk.core.result { Result }
import silk.text.string { String }
import silk.time.instant { Instant }
import silk.time.plain_date { Weekday }
import silk.time.text as Text
import silk.time.text { Scanner, TimeParseError, TimeParseReason }
import silk.num.u32
import silk.num.u8
import silk.num.usize

/// Functions that write and read the date and time format of HTTP header fields.
pub struct HttpDate {}

impl HttpDate {
  /// Writes `instant` as `Sun, 06 Nov 1994 08:49:37 GMT` at `output[at]` and returns `at + 29`.
  ///
  /// # Details
  ///
  /// The format has whole seconds, so a fraction of a second is dropped. The year of `instant` in
  /// UTC must be from 0 to 9999, or the function traps.
  pub fn write(instant: Instant, output: &mut [u8], at: usize) -> usize {
    let reading = instant.toUtc()
    let date = reading.date()
    let time = reading.time()
    let year = date.year()
    if year < 0 || year > 9999 {
      return Intrinsic.trap("HttpDate.write: the year is outside 0 to 9999")
    }
    let dayName = String.utf8Bytes(date.weekday().name())
    output[at] = dayName[0]
    output[at + 1] = dayName[1]
    output[at + 2] = dayName[2]
    output[at + 3] = 44
    output[at + 4] = 32
    let mut to = Text.writeTwo(&mut output, at + 5, date.day())
    output[to] = 32
    let month = (u8.toUsize(date.month()) - 1) * 3
    output[to + 1] = MONTHS[month]
    output[to + 2] = MONTHS[month + 1]
    output[to + 3] = MONTHS[month + 2]
    output[to + 4] = 32
    to = Text.writeYear(&mut output, to + 5, year)
    output[to] = 32
    to = Text.writeTwo(&mut output, to + 1, time.hour())
    output[to] = 58
    to = Text.writeTwo(&mut output, to + 1, time.minute())
    output[to] = 58
    to = Text.writeTwo(&mut output, to + 1, time.second())
    output[to] = 32
    output[to + 1] = 71
    output[to + 2] = 77
    output[to + 3] = 84
    return to + 4
  }

  /// Reads an instant from the value of an HTTP date header field, in any of the three forms of
  /// RFC 9110.
  ///
  /// # Errors
  /// - `UnexpectedEnd` or `UnexpectedCharacter` if `text` is not in one of the three forms.
  /// - `OutOfRange` if the date or the time does not exist, such as `30 Feb` or hour `24`.
  pub fn parse(text: string) -> Result<Instant, TimeParseError> {
    return HttpDate.parseBytes(String.utf8Bytes(text))
  }

  /// Reads an instant from the bytes of the value of an HTTP date header field, in any of the
  /// three forms of RFC 9110.
  ///
  /// # Errors
  /// - `UnexpectedEnd` or `UnexpectedCharacter` if `bytes` is not in one of the three forms.
  /// - `OutOfRange` if the date or the time does not exist, such as `30 Feb` or hour `24`.
  pub fn parseBytes(bytes: &[u8]) -> Result<Instant, TimeParseError> {
    let mut scanner = Scanner.make(bytes)
    let dayName = scanner.letters()
    let mut year: u32 = 0
    let mut month: u8 = 0
    let mut day: u32 = 0
    let mut clock = Clock { hour: 0, minute: 0, second: 0 }
    if scanner.accept(44) {
      scanner.expect(32)
      day = scanner.digits(2)
      if dayName.length == 3 {
        checkDayName(&mut scanner, dayName, false)
        scanner.expect(32)
        month = monthName(&mut scanner)
        scanner.expect(32)
        year = scanner.digits(4)
      } else {
        checkDayName(&mut scanner, dayName, true)
        scanner.expect(45)
        month = monthName(&mut scanner)
        scanner.expect(45)
        year = scanner.digits(2)
        if year >= 70 {
          year = year + 1900
        } else {
          year = year + 2000
        }
      }
      scanner.expect(32)
      clock = clockTime(&mut scanner)
      scanner.expect(32)
      scanner.expect(71)
      scanner.expect(77)
      scanner.expect(84)
    } else {
      checkDayName(&mut scanner, dayName, false)
      scanner.expect(32)
      month = monthName(&mut scanner)
      scanner.expect(32)
      if scanner.accept(32) {
        day = scanner.digits(1)
      } else {
        day = scanner.digits(2)
      }
      scanner.expect(32)
      clock = clockTime(&mut scanner)
      scanner.expect(32)
      year = scanner.digits(4)
    }
    scanner.end()
    match scanner.failure() {
      Option<TimeParseError>.Some { value } => {
        return Result<Instant, TimeParseError>.failResult(value)
      }
      Option<TimeParseError>.None => {}
    }
    match Instant.fromUtcFields(
      u32.toI32(year),
      month,
      u32.toU8(day),
      clock.hour,
      clock.minute,
      clock.second,
    ) {
      Option<Instant>.Some { value } => {
        return Result<Instant, TimeParseError>.succeed(value)
      }
      Option<Instant>.None => {
        return Result<Instant, TimeParseError>.failResult(
          TimeParseError { reason: TimeParseReason.OutOfRange, offset: 0 },
        )
      }
    }
  }
}

const MONTHS: &'static [u8] = b"JanFebMarAprMayJunJulAugSepOctNovDec"

struct Clock {
  hour: u8,
  minute: u8,
  second: u8,
}

// Reads `HH:MM:SS`. Second 60 reads as 59.
fn clockTime(scanner: &mut Scanner<'_>) -> Clock {
  let hour = scanner.digits(2)
  scanner.expect(58)
  let minute = scanner.digits(2)
  scanner.expect(58)
  let mut second = scanner.digits(2)
  if second == 60 {
    second = 59
  }
  return Clock { hour: u32.toU8(hour), minute: u32.toU8(minute), second: u32.toU8(second) }
}

// Reads a three-letter month name and returns its number from 1 to 12.
fn monthName(scanner: &mut Scanner<'_>) -> u8 {
  let start = scanner.position()
  let name = scanner.letters()
  if name.length == 3 {
    let mut month: usize = 0
    while month < 12 {
      if name[0] == MONTHS[month * 3] && name[1] == MONTHS[month * 3 + 1] && name[2] == MONTHS[month * 3 + 2] {
        return usize.toU8(month + 1)
      }
      month = month + 1
    }
  }
  scanner.reject(TimeParseReason.UnexpectedCharacter, start)
  return 1
}

// Fails unless `name`, the letters at the start of the text, is the name of a day of the week.
fn checkDayName(scanner: &mut Scanner<'_>, name: &[u8], long: bool) -> () {
  if isDayName(name, long) {
    return ()
  }
  if name.length == 0 && scanner.atEnd() {
    scanner.reject(TimeParseReason.UnexpectedEnd, 0)
  } else {
    scanner.reject(TimeParseReason.UnexpectedCharacter, 0)
  }
  return ()
}

// Returns `true` if `name` is the name of a day of the week: the full name when `long` is set,
// and otherwise its first three letters.
fn isDayName(name: &[u8], long: bool) -> bool {
  let mut number: u8 = 1
  while number <= 7 {
    let full = String.utf8Bytes(dayOfNumber(number).name())
    let length = if long { full.length } else { 3 }
    if name.length == length {
      let mut index: usize = 0
      while index < length && name[index] == full[index] {
        index = index + 1
      }
      if index == length {
        return true
      }
    }
    number = number + 1
  }
  return false
}

fn dayOfNumber(number: u8) -> Weekday {
  return Weekday.fromNumber(number).unwrapOr(Weekday.Monday)
}
