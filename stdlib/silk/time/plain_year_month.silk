//! Months of specific years: the [`PlainYearMonth`] type, such as November 2026.
//!
//! # When to use
//!
//! Use [`PlainYearMonth`] for a value that names a whole month: the month of a bill, the expiry
//! of a card, a page of a calendar. For one day, use `PlainDate` of `silk.time.plain_date`.
//!
//! # Details
//!
//! Months are in the ISO 8601 calendar. The range is `-271821-04` to `+275760-09`, the months
//! in which `PlainDate` has dates. The text form is `YYYY-MM`.
//!
//! # Examples
//!
//! ## Go through the months of a subscription
//!
//! ```silk
//! import silk.core.option { Option }
//! import silk.time.plain_date { PlainDate }
//! import silk.time.plain_year_month { PlainYearMonth }
//!
//! pub fn main() -> i32 {
//!   let start = PlainYearMonth.fromDate(PlainDate.make(2026, 11, 19))
//!   let end = start.addMonths(3)
//!   if end.year() != 2027 || end.month() != 2 || end.daysInMonth() != 28 {
//!     return 1
//!   }
//!   if start.monthsUntil(end) != 3 || !(&start < &end) {
//!     return 2
//!   }
//!   match end.atDay(28) {
//!     Option<PlainDate>.Some { value } => {
//!       if value.dayOfYear() != 59 {
//!         return 3
//!       }
//!     }
//!     Option<PlainDate>.None => {
//!       return 4
//!     }
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Time
import silk.collections.slice { Slice }
import silk.core.equal { Equal }
import silk.core.option { Option }
import silk.core.order { Order, Ordering }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.io.writer { Writer, WriterError }
import silk.text.format { Debug, Display, Format, Formatter }
import silk.text.string { String }
import silk.time.civil as Civil
import silk.time.plain_date { PlainDate }
import silk.time.text as Text
import silk.time.text { OffsetKind, Scanner, TimeParseError, TimeParseReason }
import silk.num.i32
import silk.num.i64
import silk.num.u16
import silk.num.u32
import silk.num.u8

// Months from year 0, month 1 to the first and the last month of the range.
const MIN_INDEX: i64 = -3261849
const MAX_INDEX: i64 = 3309128

/// A month of one year, in the ISO 8601 calendar.
///
/// # Details
///
/// `==`, `!=`, `<`, `<=`, `>`, and `>=` compare in time order. `Display` writes `YYYY-MM`, with
/// a sign and six digits for a year outside 0 to 9999.
pub struct PlainYearMonth {
  isoYear: i32,
  isoMonth: u8,
}

impl Copy for PlainYearMonth {}

impl PlainYearMonth {
  /// Returns the month `month`, from 1 to 12, of the year `year`.
  ///
  /// # Gotchas
  ///
  /// A month that does not exist or is outside the range traps. [`PlainYearMonth.checkedMake`]
  /// returns `None` instead.
  pub fn make(year: i32, month: u8) -> PlainYearMonth {
    return orTrap(
      PlainYearMonth.checkedMake(year, month),
      "PlainYearMonth.make: the month does not exist or is outside the PlainYearMonth range",
    )
  }

  /// Returns the month `month`, from 1 to 12, of the year `year`, or `None` when the month does
  /// not exist or is outside `-271821-04` to `+275760-09`.
  pub fn checkedMake(year: i32, month: u8) -> Option<PlainYearMonth> {
    if month < 1 || month > 12 || year < -271821 || year > 275760 {
      return Option<PlainYearMonth>.none()
    }
    let index = i32.toI64(year) * 12 + u8.toI64(month) - 1
    if index < MIN_INDEX || index > MAX_INDEX {
      return Option<PlainYearMonth>.none()
    }
    return Option<PlainYearMonth>.some(PlainYearMonth { isoYear: year, isoMonth: month })
  }

  /// Returns the month that `date` is in.
  pub fn fromDate(date: PlainDate) -> PlainYearMonth {
    return PlainYearMonth { isoYear: date.year(), isoMonth: date.month() }
  }

  /// Returns the year. Year 0 is the year before year 1.
  pub fn year(self: Self) -> i32 {
    return self.isoYear
  }

  /// Returns the month, from 1 for January to 12 for December.
  pub fn month(self: Self) -> u8 {
    return self.isoMonth
  }

  /// Returns the number of days in the month, from 28 to 31.
  pub fn daysInMonth(self: Self) -> u8 {
    return Civil.daysInMonth(self.isoYear, self.isoMonth)
  }

  /// Returns the number of days in the year, 365 or 366.
  pub fn daysInYear(self: Self) -> u16 {
    return Civil.daysInYear(self.isoYear)
  }

  /// Returns `true` if the year is a leap year.
  pub fn inLeapYear(self: Self) -> bool {
    return Civil.isLeapYear(self.isoYear)
  }

  /// Returns the date of day `day` of this month, or `None` when the month has no such day or
  /// the date is outside the range of `PlainDate`.
  pub fn atDay(self: Self, day: u8) -> Option<PlainDate> {
    return PlainDate.checkedMake(self.isoYear, self.isoMonth, day)
  }

  /// Returns the month `months` months later, or earlier for a negative count, or `None` when
  /// it is outside the range.
  pub fn checkedAddMonths(self: Self, months: i64) -> Option<PlainYearMonth> {
    if months < -7000000 || months > 7000000 {
      return Option<PlainYearMonth>.none()
    }
    let index = self.index() + months
    if index < MIN_INDEX || index > MAX_INDEX {
      return Option<PlainYearMonth>.none()
    }
    let mut year = index / 12
    let mut month = index % 12
    if month < 0 {
      month = month + 12
      year = year - 1
    }
    return Option<PlainYearMonth>.some(
      PlainYearMonth { isoYear: i64.toI32(year), isoMonth: i64.toU8(month + 1) },
    )
  }

  /// Returns the month `months` months later, or earlier for a negative count.
  ///
  /// # Gotchas
  ///
  /// A result outside the range traps. [`PlainYearMonth.checkedAddMonths`] returns `None`
  /// instead.
  pub fn addMonths(self: Self, months: i64) -> PlainYearMonth {
    return orTrap(
      self.checkedAddMonths(months),
      "PlainYearMonth.addMonths: the month is outside the PlainYearMonth range",
    )
  }

  /// Returns the number of months from this month to `other`. It is negative when `other` is
  /// earlier.
  pub fn monthsUntil(self: Self, other: PlainYearMonth) -> i64 {
    return other.index() - self.index()
  }

  /// Reads a month from ISO 8601 text such as `2026-11`.
  ///
  /// # Details
  ///
  /// The text is `YYYY-MM` or `YYYYMM`; a year outside 0 to 9999 has a sign and six digits.
  /// Bracketed annotations can follow. The text can also be a whole date, with or without a
  /// time, in the form that `PlainDate.parse` reads; the day is checked and then ignored.
  ///
  /// # Errors
  ///
  /// - `TimeParseReason.UnexpectedEnd` or `UnexpectedCharacter` if the text does not have that
  ///   form.
  /// - `TimeParseReason.OutOfRange` if the month is not from 1 to 12 or is outside the range.
  /// - `TimeParseReason.UtcNotAllowed` if the text has the UTC designator `Z`.
  /// - `TimeParseReason.UnsupportedCalendar` if a calendar annotation is not `[u-ca=iso8601]`.
  /// - `TimeParseReason.UnknownCriticalAnnotation` if an annotation with an unknown key starts
  ///   with `!`.
  pub fn parse(text: string) -> Result<PlainYearMonth, TimeParseError> {
    return PlainYearMonth.parseBytes(String.utf8Bytes(text))
  }

  /// Reads a month from the bytes of ISO 8601 text such as `2026-11`.
  ///
  /// # Details
  ///
  /// The form is the one of [`PlainYearMonth.parse`].
  ///
  /// # Errors
  ///
  /// - The errors of [`PlainYearMonth.parse`].
  pub fn parseBytes(bytes: &[u8]) -> Result<PlainYearMonth, TimeParseError> {
    let mut year: i32 = 0
    let mut month: u32 = 0
    let mut whole = Scanner.make(bytes)
    let parsed = whole.dateTime()
    match whole.failure() {
      Option<TimeParseError>.None => {
        match parsed.offset.kind {
          OffsetKind.Utc => {
            return Result<PlainYearMonth, TimeParseError>.failResult(
              TimeParseError { reason: TimeParseReason.UtcNotAllowed, offset: 0 },
            )
          }
          _ => {}
        }
        year = parsed.date.year
        month = u8.toU32(parsed.date.month)
      }
      Option<TimeParseError>.Some { value: _ } => {
        let mut short = Scanner.make(bytes)
        year = short.year()
        drop short.accept(45)
        let monthAt = short.position()
        month = short.digits(2)
        short.annotations()
        short.end()
        if month < 1 || month > 12 {
          short.reject(TimeParseReason.OutOfRange, monthAt)
        }
        match short.failure() {
          Option<TimeParseError>.Some { value } => {
            return Result<PlainYearMonth, TimeParseError>.failResult(value)
          }
          Option<TimeParseError>.None => {}
        }
      }
    }
    match PlainYearMonth.checkedMake(year, u32.toU8(month)) {
      Option<PlainYearMonth>.Some { value } => {
        return Result<PlainYearMonth, TimeParseError>.succeed(value)
      }
      Option<PlainYearMonth>.None => {
        return Result<PlainYearMonth, TimeParseError>.failResult(
          TimeParseError { reason: TimeParseReason.OutOfRange, offset: 0 },
        )
      }
    }
  }

  // Months from year 0, month 1.
  fn index(self: Self) -> i64 {
    return i32.toI64(self.isoYear) * 12 + u8.toI64(self.isoMonth) - 1
  }

  fn same(left: &PlainYearMonth, right: &PlainYearMonth) -> bool {
    return left.isoYear == right.isoYear && left.isoMonth == right.isoMonth
  }

  fn compare(left: &PlainYearMonth, right: &PlainYearMonth) -> Ordering {
    let first = PlainYearMonth.index(left.*)
    let second = PlainYearMonth.index(right.*)
    if first < second {
      return Ordering.Less
    }
    if first > second {
      return Ordering.Greater
    }
    return Ordering.Equal
  }
}

impl Equal for PlainYearMonth {
  equals: PlainYearMonth.same
}

impl Order for PlainYearMonth {
  compare: PlainYearMonth.compare
}

/// Writes the month as `YYYY-MM`, with a sign and six digits for a year outside 0 to 9999, as in
/// `2026-11` or `-000044-03`.
impl Display for PlainYearMonth {
  effect fn display(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    let mut output: [u8; 10] = [0; 10]
    let mut length = Text.writeYear(&mut output, 0, self.isoYear)
    output[length] = 45
    length = Text.writeTwo(&mut output, length + 1, self.isoMonth)
    return run Format.write(&mut formatter, Slice.view<u8>(&output, 0, length))
  }
}

/// Writes the same text as `Display`: the month as `YYYY-MM`.
impl Debug for PlainYearMonth {
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return run Display.display(self, &mut formatter)
  }
}

fn orTrap(result: Option<PlainYearMonth>, message: string<'static>) -> PlainYearMonth {
  match result {
    Option<PlainYearMonth>.Some { value } => {
      return value
    }
    Option<PlainYearMonth>.None => {
      return Intrinsic.trap(message)
    }
  }
}
