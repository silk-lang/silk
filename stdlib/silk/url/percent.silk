//! Percent-encode and percent-decode text with the encode sets of the WHATWG URL Standard.
//!
//! # When to use
//! Use [`UrlPercent`] to build a component of a URL for a browser-compatible URL, or to read
//! `application/x-www-form-urlencoded` text. For RFC 3986 URIs, use `silk.uri.percent`.
//!
//! # Details
//! Encoding works on UTF-8 bytes. Each byte that is in the selected [`UrlEncodeSet`] becomes
//! `%XX` with uppercase hexadecimal digits; bytes 0x80 and above are in every set. Decoding is
//! lenient, as the URL Standard specifies: a `%` that does not start a valid escape stays as it
//! is.
//!
//! # Examples
//! ## Encode a query value
//! ```silk
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.core.effect { Effect }
//! import silk.collections.bytes { Bytes }
//! import silk.text.string { String }
//! import silk.url.percent { UrlEncodeSet, UrlPercent }
//!
//! pub effect fn main() -> i32
//!   ! OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let mut output = Bytes.make()
//!   run UrlPercent.appendEncoded(&mut output, String.utf8Bytes("a b&c"), UrlEncodeSet.Component)
//!     |> Effect.provideMut<Allocator>(&mut allocator)
//!   if Bytes.asSlice(&output) != b"a%20b%26c" {
//!     return 1
//!   }
//!   return 0
//! }
//! ```

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.ownership { Copy }
import silk.collections.bytes { Bytes }
import silk.collections.slice { Slice }
import silk.text.string { String }
import silk.num.u8
import silk.num.u32
import silk.num.usize

/// A percent-encode set of the URL Standard. Each set holds the bytes that become `%XX`.
///
/// # Details
/// Every set holds the C0 controls (0x00 to 0x1F) and the bytes 0x7F and above. Each set after
/// `C0Control` holds the bytes of the set before it, except `FormUrlencoded`, which holds those of
/// `Component`.
pub enum UrlEncodeSet {
  /// The C0 control percent-encode set: only the C0 controls and 0x7F and above.
  C0Control,
  /// The fragment set: adds space, `"`, `<`, `>`, and `` ` ``.
  Fragment,
  /// The query set: adds space, `"`, `#`, `<`, and `>` to `C0Control`.
  Query,
  /// The special-query set, for the query of a special URL: adds `'` to `Query`.
  SpecialQuery,
  /// The path set: adds `?`, `^`, `` ` ``, `{`, and `}` to `Query`.
  Path,
  /// The userinfo set: adds `/`, `:`, `;`, `=`, `@`, `[` to `^`, and `|` to `Path`.
  Userinfo,
  /// The component set: adds `$`, `%`, `&`, `+`, and `,` to `Userinfo`. It encodes `%`.
  Component,
  /// The `application/x-www-form-urlencoded` set: adds `!`, `'` to `)`, and `~` to `Component`.
  /// Space is encoded as `+` when the caller asks for it.
  FormUrlencoded,
}

/// Functions that percent-encode and percent-decode with the URL Standard's rules.
pub struct UrlPercent {}

impl UrlPercent {
  /// Returns whether `value` is in `set`, so that encoding writes it as `%XX`.
  pub fn encodes(value: u8, set: UrlEncodeSet) -> bool {
    return inSet(value, set)
  }

  /// Appends `values` encoded with `set` to `output`.
  ///
  /// # Details
  /// A `%` in `values` stays as it is in every set except `Component` and `FormUrlencoded`, so text
  /// that is already encoded does not change in the other sets.
  ///
  /// # Errors
  /// - `OutOfMemoryError` if the `Allocator` fails.
  pub effect fn appendEncoded(output: &mut Bytes, values: &[u8], set: UrlEncodeSet) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return run appendEncodedWith(&mut output.*, values, set, false)
  }

  /// Appends `values` encoded with `set` to `output`, and writes each space as `+`.
  ///
  /// # Details
  /// It is the `application/x-www-form-urlencoded` serializer's encoding of a name or a value when
  /// `set` is `FormUrlencoded`.
  ///
  /// # Errors
  /// - `OutOfMemoryError` if the `Allocator` fails.
  pub effect fn appendFormEncoded(output: &mut Bytes, values: &[u8], set: UrlEncodeSet) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return run appendEncodedWith(&mut output.*, values, set, true)
  }

  /// Appends the bytes of `values` with each valid `%XX` escape decoded to `output`.
  ///
  /// # Details
  /// A `%` that is not followed by two hexadecimal digits stays as it is. When `plusIsSpace` is
  /// `true`, each `+` becomes a space first, as form decoding does. The result is not always valid
  /// UTF-8.
  ///
  /// # Errors
  /// - `OutOfMemoryError` if the `Allocator` fails.
  pub effect fn appendDecoded(output: &mut Bytes, values: &[u8], plusIsSpace: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run Bytes.reserve(&mut output.*, values.length)
    let mut i: usize = 0
    while i < values.length {
      let c = values[i]
      if c == 37 && i + 2 < values.length && hexValue(values[i + 1]) < 16
        && hexValue(values[i + 2]) < 16 {
        let decoded = [hexValue(values[i + 1]) * 16 + hexValue(values[i + 2])]
        run Bytes.append(&mut output.*, &decoded)
        i = i + 3
        continue
      }
      let single = [
        if plusIsSpace && c == 43 {
          u8.toU8(32)
        } else {
          c
        },
      ]
      run Bytes.append(&mut output.*, &single)
      i = i + 1
    }
    return ()
  }

  /// Appends the text of `values` to `output`: the percent-decoded bytes, read as UTF-8.
  ///
  /// # Details
  /// It is the URL Standard's percent-decode followed by UTF-8 decode without BOM. Each invalid
  /// UTF-8 sequence becomes U+FFFD, and a leading byte order mark stays. When `plusIsSpace` is
  /// `true`, each `+` becomes a space first, as form decoding does.
  ///
  /// # Errors
  /// - `OutOfMemoryError` if the `Allocator` fails.
  pub effect fn appendDecodedText(output: &mut String, values: &[u8], plusIsSpace: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut decoded = Bytes.make()
    run UrlPercent.appendDecoded(&mut decoded, values, plusIsSpace)
    return run UrlPercent.appendUtf8Lossy(&mut output.*, Bytes.asSlice(&decoded))
  }

  /// Appends `values` read as UTF-8 to `output`, with each invalid sequence replaced by U+FFFD.
  ///
  /// # Details
  /// It is the Encoding Standard's UTF-8 decode without BOM: a maximal invalid subpart becomes one
  /// U+FFFD, and a leading byte order mark stays.
  ///
  /// # Errors
  /// - `OutOfMemoryError` if the `Allocator` fails.
  pub effect fn appendUtf8Lossy(output: &mut String, values: &[u8]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut bytes = run Bytes.makeWithCapacity(values.length)
    let mut i: usize = 0
    while i < values.length {
      let start = i
      let valid = validSequence(values, &mut i)
      if valid {
        run Bytes.append(&mut bytes, Slice.view<u8>(values, start, i - start))
      } else {
        run Bytes.append(&mut bytes, b"\xEF\xBF\xBD")
      }
    }
    let text = unsafe String.fromBytesUnchecked(move bytes)
    return run String.appendOwned(&mut output.*, move text)
  }
}

// Advances past one UTF-8 sequence or one maximal invalid subpart, and returns whether it was
// valid.
fn validSequence(values: &[u8], index: &mut usize) -> bool {
  let i = index.*
  let first = values[i]
  index.* = i + 1
  if first < 0x80 {
    return true
  }
  let mut count: usize = 0
  let mut lower: u8 = 0x80
  let mut upper: u8 = 0xBF
  if first >= 0xC2 && first <= 0xDF {
    count = 1
  } else if first >= 0xE0 && first <= 0xEF {
    count = 2
    if first == 0xE0 {
      lower = 0xA0
    }
    if first == 0xED {
      upper = 0x9F
    }
  } else if first >= 0xF0 && first <= 0xF4 {
    count = 3
    if first == 0xF0 {
      lower = 0x90
    }
    if first == 0xF4 {
      upper = 0x8F
    }
  } else {
    return false
  }
  let mut j: usize = 0
  while j < count {
    let at = i + 1 + j
    if at >= values.length {
      return false
    }
    let next = values[at]
    if next < lower || next > upper {
      return false
    }
    lower = 0x80
    upper = 0xBF
    index.* = at + 1
    j = j + 1
  }
  return true
}

effect fn appendEncodedWith(output: &mut Bytes, values: &[u8], set: UrlEncodeSet, plus: bool) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run Bytes.reserve(&mut output.*, values.length)
  let mut i: usize = 0
  while i < values.length {
    let start = i
    while i < values.length && !inSet(values[i], set) && !(plus && values[i] == 32) {
      i = i + 1
    }
    if i > start {
      run Bytes.append(&mut output.*, Slice.view<u8>(values, start, i - start))
    }
    if i < values.length {
      let c = values[i]
      if plus && c == 32 {
        run Bytes.append(&mut output.*, b"+")
      } else {
        let escaped = [u8.toU8(37), hexDigit(c / 16), hexDigit(c % 16)]
        run Bytes.append(&mut output.*, &escaped)
      }
      i = i + 1
    }
  }
  return ()
}

fn hexDigit(value: u8) -> u8 {
  if value < 10 {
    return value + 48
  }
  return value + 55
}

fn hexValue(value: u8) -> u8 {
  if value >= 48 && value <= 57 {
    return value - 48
  }
  if value >= 65 && value <= 70 {
    return value - 55
  }
  if value >= 97 && value <= 102 {
    return value - 87
  }
  return 255
}

// Bit `n` of entry `c` is set when byte `c` is in the set with `setBit` `n`.
fn table() -> &'static [u8] {
  return b"\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xfe\x80\xfe\xfc\xc0\xc0\xc0\x88\x80\x80\x00\xc0\xc0\x00\x00\xe0\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xe0\xe0\xfe\xe0\xfe\xf0\xe0\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xe0\xe0\xe0\xf0\x00\xf2\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\x00\xf0\xe0\xf0\x80\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff\xff"
}

fn setBit(set: UrlEncodeSet) -> u8 {
  return match set {
    UrlEncodeSet.C0Control => 1
    UrlEncodeSet.Fragment => 2
    UrlEncodeSet.Query => 4
    UrlEncodeSet.SpecialQuery => 8
    UrlEncodeSet.Path => 16
    UrlEncodeSet.Userinfo => 32
    UrlEncodeSet.Component => 64
    UrlEncodeSet.FormUrlencoded => 128
  }
}

fn inSet(value: u8, set: UrlEncodeSet) -> bool {
  return (table()[u8.toUsize(value)] & setBit(set)) != 0
}
