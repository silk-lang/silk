//! Read and write `application/x-www-form-urlencoded` text, the format of HTML form bodies and of
//! URL queries such as `a=1&b=two+words`.
//!
//! # When to use
//! Use [`UrlForm.parse`] to read the fields of a form body or a URL query, and
//! [`UrlForm.serialize`] to write them. The rules are those of the WHATWG URL Standard, which
//! JavaScript's `URLSearchParams` uses.
//!
//! # Details
//! The text is split at `&`, and each part at its first `=`. Empty parts are skipped. In names and
//! values, `+` is a space and `%XX` escapes are decoded; invalid escapes stay as they are. The
//! decoded bytes are read as UTF-8, with U+FFFD for each invalid sequence.
//!
//! # Examples
//! ## Read and write a query
//! ```silk
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.core.effect { Effect }
//! import silk.collections.list { List }
//! import silk.text.string { String }
//! import silk.url.form { UrlForm, UrlFormPair }
//!
//! pub effect fn main() -> i32
//!   ! OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let pairs = run UrlForm.parse("q=silk+lang&page=2") |> Effect.provideMut<Allocator>(&mut allocator)
//!   if List<UrlFormPair>.length(&pairs) != 2 || String.view(&List<UrlFormPair>.asSlice(&pairs)[0].value) != "silk lang" {
//!     return 1
//!   }
//!   let text = run UrlForm.serialize(List<UrlFormPair>.asSlice(&pairs)) |> Effect.provideMut<Allocator>(&mut allocator)
//!   if String.view(&text) != "q=silk+lang&page=2" {
//!     return 1
//!   }
//!   return 0
//! }
//! ```

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.text.string { String }
import silk.url.percent { UrlPercent, UrlEncodeSet }
import silk.num.usize

/// One name and value of form text.
pub struct UrlFormPair {
  /// The decoded name.
  pub name: String,
  /// The decoded value. It is empty when the part has no `=`.
  pub value: String,
}

/// Functions that read and write `application/x-www-form-urlencoded` text.
pub struct UrlForm {}

impl UrlForm {
  /// Returns the names and values of the form text `input`, in order.
  ///
  /// # Errors
  /// - `OutOfMemoryError` if the `Allocator` fails.
  pub effect fn parse(input: string) -> List<UrlFormPair>
    ! OutOfMemoryError
    ? &mut Allocator {
    return run UrlForm.parseBytes(String.utf8Bytes(input))
  }

  /// Returns the names and values of the form bytes `input`, in order. `input` does not need to be
  /// UTF-8.
  ///
  /// # Errors
  /// - `OutOfMemoryError` if the `Allocator` fails.
  pub effect fn parseBytes(input: &[u8]) -> List<UrlFormPair>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut pairs = List<UrlFormPair>.make()
    let mut start: usize = 0
    while start <= input.length {
      let mut end = start
      while end < input.length && input[end] != 38 {
        end = end + 1
      }
      if end > start {
        let part = Slice.view<u8>(input, start, end - start)
        let mut equals = part.length
        let mut i: usize = 0
        while i < part.length {
          if part[i] == 61 {
            equals = i
            break
          }
          i = i + 1
        }
        let mut name = String.make()
        run UrlPercent.appendDecodedText(&mut name, Slice.view<u8>(part, 0, equals), true)
        let mut value = String.make()
        if equals < part.length {
          run UrlPercent.appendDecodedText(
            &mut value,
            Slice.view<u8>(part, equals + 1, part.length - equals - 1),
            true,
          )
        }
        run List<UrlFormPair>.append(&mut pairs, UrlFormPair { name: move name, value: move value })
      }
      start = end + 1
    }
    return move pairs
  }

  /// Returns `pairs` as form text: each name and value encoded, joined by `=`, and the pairs
  /// joined by `&`.
  ///
  /// # Details
  /// Space becomes `+`. Letters, digits, `*`, `-`, `.`, and `_` stay as they are, and every other
  /// byte becomes `%XX`.
  ///
  /// # Errors
  /// - `OutOfMemoryError` if the `Allocator` fails.
  pub effect fn serialize(pairs: &[UrlFormPair]) -> String
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut output = Bytes.make()
    let mut i: usize = 0
    while i < pairs.length {
      if i > 0 {
        run Bytes.append(&mut output, b"&")
      }
      run UrlPercent.appendFormEncoded(
        &mut output,
        String.ownedUtf8Bytes(&pairs[i].name),
        UrlEncodeSet.FormUrlencoded,
      )
      run Bytes.append(&mut output, b"=")
      run UrlPercent.appendFormEncoded(
        &mut output,
        String.ownedUtf8Bytes(&pairs[i].value),
        UrlEncodeSet.FormUrlencoded,
      )
      i = i + 1
    }
    return unsafe String.fromBytesUnchecked(move output)
  }
}
