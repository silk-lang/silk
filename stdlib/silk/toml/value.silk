//! Parse a TOML document into an owned tree of values, and read fields from it.
//!
//! # When to use
//! Use [`Toml.parse`] to read a configuration file or any other complete TOML document. Read
//! members with [`Toml.field`] and [`Toml.fieldAt`], array elements with [`Toml.item`], and text
//! with [`Toml.asString`]. Use `silk.toml.codec` to convert a value to a number, a boolean, or an
//! owned string, and `silk.toml.output` to write a tree back as TOML.
//!
//! # Details
//! The parser follows TOML 1.1.0. Tables keep the order of the source. Integers, floats, dates, and
//! times keep their validated source text, so no precision is lost. Strings are decoded to UTF-8
//! text when the document is parsed. The root of a parsed document is always a [`Value.Table`]. If
//! parsing fails, everything that was built is released.
//!
//! # Errors
//! - `TomlError` if the input is not valid TOML, defines a key two times, defines a table that
//!   conflicts with an earlier value, or nests more than `MAX_DEPTH` (64) arrays or inline tables.
//!   `offset` gives the byte position of the problem.
//! - `OutOfMemoryError` if the `Allocator` cannot supply the tree.
//!
//! # Gotchas
//! A borrowed field or string cannot live longer than the [`Value`] that owns it. The read
//! functions return `None` for a missing key and for a value of a different kind. They do not tell
//! you which case occurred.
//!
//! # Examples
//! ## Read a nested string and an array element
//! ```silk
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.core.effect { Effect }
//! import silk.option { Option }
//! import silk.toml.scanner { TomlError }
//! import silk.toml.value { Toml, Value }
//!
//! pub effect fn main() -> i32
//!   ! TomlError | OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let source = b"tags = [\"fast\", \"small\"]\n\n[owner]\nname = \"Ada\"\n"
//!   let document = run Toml.parse(source) |> Effect.provideMut<Allocator>(&mut allocator)
//!   let name = Toml.field(&document, "owner") |> Toml.fieldAt("name") |> Toml.asString
//!     |> Option<string>.unwrapOr("")
//!   let tags = Toml.field(&document, "tags")
//!   let second = match move tags {
//!     Option<&Value>.Some { value } => Toml.item(value, 1) |> Toml.asString
//!       |> Option<string>.unwrapOr("")
//!     Option<&Value>.None => ""
//!   }
//!   if name != "Ada" || second != "small" {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! ## Report the position of a syntax error
//! ```silk
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.core.effect { Effect }
//! import silk.toml.scanner { TomlError, TomlReason }
//! import silk.toml.value { Toml }
//!
//! effect fn load() -> usize
//!   ! TomlError | OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let document = run Toml.parse(b"name = \"Ada\"\nname = \"Grace\"\n")
//!     |> Effect.provideMut<Allocator>(&mut allocator)
//!   return 0
//! }
//!
//! effect fn offsetOf(error: TomlError | OutOfMemoryError) -> usize {
//!   return match move error {
//!     TomlError { reason: TomlReason.DuplicateKey, offset } => offset
//!     _ => 0
//!   }
//! }
//!
//! pub fn main() -> i32 {
//!   // The second `name` starts at byte 13.
//!   let offset = run Effect.catchAll(load(), offsetOf)
//!   if offset != 13 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Data formats

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.box { Box }
import silk.collections.bytes { Bytes }
import silk.option { Option }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.text.string { String }
import silk.toml.scanner { TomlError, TomlReason, TomlScalarKind, TomlScanner, TomlSpan, TomlToken }
import silk.toml.text { TomlText }
import silk.num.u8
import silk.num.usize
import silk.collections.list { List }

/// How a table got its first definition. The parser uses it to reject a later definition that TOML
/// does not allow.
pub enum TableKind {
  /// A table that exists only because a header named a table inside it, such as `a` for `[a.b]`. A
  /// later `[a]` header can still define it.
  Implicit,
  /// A table that a dotted key made, such as `a` for `a.b = 1`.
  Dotted,
  /// A table that a `[header]` defined. The root table also has this kind.
  Explicit,
  /// A table written inside braces, such as `{ x = 1 }`. It is closed: no later line can add
  /// members to it.
  Inline,
}

/// One member of a table: a key and its value.
pub struct TomlEntry {
  /// The decoded key. Quotes and escapes are removed.
  pub key: String,
  /// The value of the member.
  pub value: Value,
}

/// One element of the child list of an array or a table. Arrays hold [`TomlChild.Item`] and tables
/// hold [`TomlChild.Member`].
pub union TomlChild {
  /// An array element. It has no key.
  Item {
    /// The element.
    pub value: Value
  },
  /// A table member.
  Member {
    /// The key and value of the member.
    pub entry: TomlEntry
  },
}

/// An owned TOML value.
///
/// Integers, floats, dates, and times hold their source text, which the parser validated. Convert
/// them with `silk.toml.codec`, or copy the text to keep the full precision. Strings are decoded to
/// UTF-8 text when the document is parsed. Tables keep the order of the source.
///
/// # Gotchas
/// A borrowed field or string cannot live longer than the `Value` that owns it.
pub union Value {
  /// An integer, such as `42`, `-17`, `1_000`, or `0xff`.
  Integer {
    /// The source text of the integer, with signs, prefixes, and underscores.
    pub text: String
  },
  /// A float, such as `3.14`, `6e-3`, `inf`, or `nan`.
  Float {
    /// The source text of the float.
    pub text: String
  },
  /// `true` or `false`.
  Boolean {
    /// The boolean.
    pub value: bool
  },
  /// A date and time with a UTC offset, such as `1979-05-27T07:32:00Z`.
  OffsetDateTime {
    /// The source text, with all fractional seconds.
    pub text: String
  },
  /// A date and time without an offset, such as `1979-05-27T07:32:00`.
  LocalDateTime {
    /// The source text, with all fractional seconds.
    pub text: String
  },
  /// A calendar date, such as `1979-05-27`.
  LocalDate {
    /// The source text.
    pub text: String
  },
  /// A time of day without a date, such as `07:32:00`.
  LocalTime {
    /// The source text, with all fractional seconds.
    pub text: String
  },
  /// A string. Escapes are decoded and the delimiters are removed.
  String {
    /// The decoded UTF-8 text.
    pub text: String
  },
  /// An array of values, or an array of tables that `[[header]]` lines made.
  Array {
    /// The elements in source order. Each one is a [`TomlChild.Item`].
    pub values: Box<List<TomlChild>>,
    /// `true` if `[[header]]` lines made the array. Such an array holds only tables, and a later
    /// `key = [...]` cannot replace it.
    pub tables: bool
  },
  /// A table of key and value members.
  Table {
    /// The members in source order. Each one is a [`TomlChild.Member`].
    pub entries: Box<List<TomlChild>>,
    /// How the table got its first definition.
    pub kind: TableKind
  },
}

struct KeyPart {
  name: String,
  offset: usize,
}

/// Functions that parse and read TOML documents.
///
/// # When to use
/// Use [`Toml.parse`] to read a configuration file or any other complete TOML document. Read
/// members with [`Toml.field`] and [`Toml.fieldAt`], array elements with [`Toml.item`], and text
/// with [`Toml.asString`]. Use `silk.toml.codec` to convert a value to a number, a boolean, or an
/// owned string, and `silk.toml.output` to write a tree back as TOML.
///
/// # Gotchas
/// The read functions return `None` for a missing key and for a value of a different kind. They do
/// not tell you which case occurred.
pub struct Toml {}

impl Toml {
  /// Parses a complete UTF-8 TOML document and returns its root table.
  ///
  /// The parser first validates the full input with `TomlScanner.validate`, and then builds the
  /// tree.
  ///
  /// # Errors
  /// - `TomlError` if the input is not valid TOML 1.1.0, or if a key or table is defined in a way
  ///   that TOML does not allow. `offset` is the byte position of the problem.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the tree. Everything that was built is
  ///   released.
  pub effect fn parse(bytes: &[u8]) -> Value ! TomlError | OutOfMemoryError ? &mut Allocator {
    let mut scanner = TomlScanner.make(bytes)
    let valid = TomlScanner.validate(&mut scanner)
    match move valid {
      Result<bool, TomlError>.Failure { error } => { fail move error }
      Result<bool, TomlError>.Success { value: _ } => {}
    }
    let mut root = run table(TableKind.Explicit)
    let mut current = List<KeyPart>.make()
    while true {
      let at = TomlScanner.offset(&scanner)
      let first = run next(&mut scanner)
      match move first {
        TomlToken.EndOfInput => { return move root }
        TomlToken.Newline => {}
        TomlToken.ArrayBegin => {
          let second = run next(&mut scanner)
          let mut array = false
          let mut keyFirst = move second
          match &keyFirst {
            TomlToken.ArrayBegin => { array = true }
            _ => {}
          }
          if array { keyFirst = run next(&mut scanner) }
          let parsed = run key(&mut scanner, move keyFirst)
          let ParsedKey { parts, delimiter } = move parsed
          let previous = Intrinsic.replace(current, move parts)
          drop previous
          match move delimiter {
            TomlToken.ArrayEnd => {}
            _ => { fail problem(TomlReason.UnexpectedByte, at) }
          }
          if array {
            let close = run next(&mut scanner)
            match move close {
              TomlToken.ArrayEnd => {}
              _ => { fail problem(TomlReason.UnexpectedByte, at) }
            }
          }
          let path = List<KeyPart>.asSlice(&current)
          let updated = run defineHeader(move root, path, usize.ZERO, array)
          root = move updated
        }
        TomlToken.Text { span } => {
          let updated = run assignment(&mut scanner, move root, &current, TomlToken.Text { span: span }, at)
          root = move updated
        }
        TomlToken.String { span, literal, multiline } => {
          let updated = run assignment(&mut scanner, move root, &current,
            TomlToken.String { span: span, literal: literal, multiline: multiline }, at)
          root = move updated
        }
        _ => { fail problem(TomlReason.UnexpectedByte, at) }
      }
    }
    fail problem(TomlReason.UnexpectedEnd, bytes.length)
  }

  /// Returns the member `name` of the table `self`.
  ///
  /// Returns `None` if the table has no member with that key, or if `self` is not a table. `name`
  /// is the decoded key, without quotes.
  pub fn field<'a>(self: &'a Value, name: string) -> Option<&'a Value> {
    return match &self.* {
      Value.Table { entries, kind: _ } => {
        let boxed = Box<List<TomlChild>>.get(&entries)
        return find(&boxed[0], name)
      }
      _ => Option<&'a Value>.none()
    }
  }

  /// Returns the member `name` of an optional table. Use it to chain lookups with `|>`.
  ///
  /// Returns `None` if `self` is `None`, or for the same cases as [`Toml.field`].
  pub fn fieldAt<'a>(self: Option<&'a Value>, name: string) -> Option<&'a Value> {
    return match move self {
      Option<&'a Value>.None => Option<&'a Value>.none()
      Option<&'a Value>.Some { value } => Toml.field(value, name)
    }
  }

  /// Returns the element at `index` of the array `self`. The first element has index 0.
  ///
  /// Returns `None` if `index` is out of range, or if `self` is not an array. In an array of
  /// tables, each element is a [`Value.Table`].
  pub fn item<'a>(self: &'a Value, index: usize) -> Option<&'a Value> {
    return match &self.* {
      Value.Array { values, tables: _ } => {
        let boxed = Box<List<TomlChild>>.get(&values)
        let items = List<TomlChild>.asSlice(&boxed[0])
        if index >= items.length { return Option<&'a Value>.none() }
        return match &items[index] {
          TomlChild.Item { value } => Option<&'a Value>.some(&value)
          _ => Option<&'a Value>.none()
        }
      }
      _ => Option<&'a Value>.none()
    }
  }

  /// Returns the decoded text of an optional string value.
  ///
  /// Returns `None` if `self` is `None` or is not a [`Value.String`]. The text borrows from the
  /// value.
  pub fn asString<'a>(self: Option<&'a Value>) -> Option<string<'a>> {
    return match move self {
      Option<&'a Value>.None => Option<string<'a>>.none()
      Option<&'a Value>.Some { value } => match &value.* {
        Value.String { text } => Option<string<'a>>.some(String.view(&text))
        _ => Option<string<'a>>.none()
      }
    }
  }
}

struct ParsedKey {
  parts: List<KeyPart>,
  delimiter: TomlToken,
}

effect fn assignment(scanner: &mut TomlScanner, root: Value,
  current: &List<KeyPart>, first: TomlToken, at: usize)
  -> Value ! TomlError | OutOfMemoryError ? &mut Allocator {
  let parsed = run key(&mut scanner.*, move first)
  let ParsedKey { parts, delimiter } = move parsed
  match move delimiter {
    TomlToken.Equals => {}
    _ => { fail problem(TomlReason.UnexpectedByte, at) }
  }
  let valueToken = run next(&mut scanner.*)
  let value = run parseValue(&mut scanner.*, move valueToken)
  return run insertAt(move root, List<KeyPart>.asSlice(current), usize.ZERO,
    List<KeyPart>.asSlice(&parts), usize.ZERO, move value, false)
}

effect fn key(scanner: &mut TomlScanner, first: TomlToken)
  -> ParsedKey ! TomlError | OutOfMemoryError ? &mut Allocator {
  return run keyRest(&mut scanner.*, List<KeyPart>.make(), move first)
}

effect fn keyRest(scanner: &mut TomlScanner, parts: List<KeyPart>, token: TomlToken)
  -> ParsedKey ! TomlError | OutOfMemoryError ? &mut Allocator {
  let mut owned = move parts
  let trailingDot = run appendKeyToken(&mut scanner.*, &mut owned, move token)
  let separator = run next(&mut scanner.*)
  if trailingDot { return run keyRest(&mut scanner.*, move owned, move separator) }
  return match move separator {
    TomlToken.Dot => {
      let part = run next(&mut scanner.*)
      return run keyRest(&mut scanner.*, move owned, move part)
    }
    TomlToken.Equals => ParsedKey { parts: move owned, delimiter: TomlToken.Equals }
    TomlToken.ArrayEnd => ParsedKey { parts: move owned, delimiter: TomlToken.ArrayEnd }
    TomlToken.Comma => ParsedKey { parts: move owned, delimiter: TomlToken.Comma }
    _ => { fail problem(TomlReason.UnexpectedByte, TomlScanner.offset(&scanner.*)) }
  }
}

effect fn appendKeyToken(scanner: &mut TomlScanner, parts: &mut List<KeyPart>, token: TomlToken)
  -> bool ! TomlError | OutOfMemoryError ? &mut Allocator {
  return match move token {
    TomlToken.Text { span } => {
      let raw = TomlScanner.slice(&scanner.*, span)
      let mut start = usize.ZERO
      let mut at = usize.ZERO
      while at < raw.length {
        if raw[at] == 46 {
          if at == start { fail problem(TomlReason.UnexpectedByte, span.offset + at) }
          let segment = Slice.view<u8>(raw, start, at - start)
          run appendPart(&mut parts.*, segment, span.offset + start)
          start = at + usize.ONE
        }
        at = at + usize.ONE
      }
      if start < raw.length {
        run appendPart(&mut parts.*, Slice.view<u8>(raw, start, raw.length - start), span.offset + start)
        return false
      }
      return true
    }
    TomlToken.String { span, literal, multiline } => {
      let raw = TomlScanner.slice(&scanner.*, span)
      let decoded = run TomlText.decode(raw, literal, multiline)
      let name = unsafe String.fromBytesUnchecked(move decoded)
      run List<KeyPart>.append(&mut parts.*, KeyPart { name: move name, offset: span.offset })
      return false
    }
    _ => { fail problem(TomlReason.UnexpectedByte, TomlScanner.offset(&scanner.*)) }
  }
}

effect fn appendPart(parts: &mut List<KeyPart>, raw: &[u8], offset: usize)
  -> () ! OutOfMemoryError ? &mut Allocator {
  let owned = run TomlText.copy(raw)
  let name = unsafe String.fromBytesUnchecked(move owned)
  return run List<KeyPart>.append(&mut parts.*, KeyPart { name: move name, offset: offset })
}

effect fn parseValue(scanner: &mut TomlScanner, token: TomlToken)
  -> Value ! TomlError | OutOfMemoryError ? &mut Allocator {
  return match move token {
    TomlToken.String { span, literal, multiline } => {
      let raw = TomlScanner.slice(&scanner.*, span)
      let bytes = run TomlText.decode(raw, literal, multiline)
      return Value.String { text: unsafe String.fromBytesUnchecked(move bytes) }
    }
    TomlToken.Text { span } => {
      let kind = TomlScanner.scalarKind(&scanner.*, span)
      let classified = match move kind {
        Option<TomlScalarKind>.Some { value } => move value
        Option<TomlScalarKind>.None => { fail problem(TomlReason.UnexpectedByte, span.offset) }
      }
      let raw = TomlScanner.slice(&scanner.*, span)
      let boolean = match classified {
        TomlScalarKind.Boolean => true
        _ => false
      }
      if boolean { return Value.Boolean { value: raw[0] == 116 } }
      let copied = run TomlText.copy(raw)
      let text = unsafe String.fromBytesUnchecked(move copied)
      return match move classified {
        TomlScalarKind.Integer => Value.Integer { text: move text }
        TomlScalarKind.Float => Value.Float { text: move text }
        TomlScalarKind.OffsetDateTime => Value.OffsetDateTime { text: move text }
        TomlScalarKind.LocalDateTime => Value.LocalDateTime { text: move text }
        TomlScalarKind.LocalDate => Value.LocalDate { text: move text }
        TomlScalarKind.LocalTime => Value.LocalTime { text: move text }
        TomlScalarKind.Boolean => Value.Boolean { value: true }
      }
    }
    TomlToken.ArrayBegin => run parseArray(&mut scanner.*)
    TomlToken.InlineBegin => run parseInline(&mut scanner.*)
    _ => { fail problem(TomlReason.UnexpectedByte, TomlScanner.offset(&scanner.*)) }
  }
}

effect fn parseArray(scanner: &mut TomlScanner)
  -> Value ! TomlError | OutOfMemoryError ? &mut Allocator {
  let mut children = List<TomlChild>.make()
  while true {
    let token = run next(&mut scanner.*)
    match move token {
      TomlToken.ArrayEnd => {
        let boxed = run Box<List<TomlChild>>.make(move children)
        return Value.Array { values: move boxed, tables: false }
      }
      TomlToken.Text { span } => {
        let value = run parseValue(&mut scanner.*, TomlToken.Text { span: span })
        run List<TomlChild>.append(&mut children, TomlChild.Item { value: move value })
      }
      TomlToken.String { span, literal, multiline } => {
        let value = run parseValue(&mut scanner.*, TomlToken.String {
          span: span, literal: literal, multiline: multiline })
        run List<TomlChild>.append(&mut children, TomlChild.Item { value: move value })
      }
      TomlToken.ArrayBegin => {
        let value = run parseArray(&mut scanner.*)
        run List<TomlChild>.append(&mut children, TomlChild.Item { value: move value })
      }
      TomlToken.InlineBegin => {
        let value = run parseInline(&mut scanner.*)
        run List<TomlChild>.append(&mut children, TomlChild.Item { value: move value })
      }
      _ => { fail problem(TomlReason.UnexpectedByte, TomlScanner.offset(&scanner.*)) }
    }
    let separator = run next(&mut scanner.*)
    match move separator {
      TomlToken.Comma => {}
      TomlToken.ArrayEnd => {
        let boxed = run Box<List<TomlChild>>.make(move children)
        return Value.Array { values: move boxed, tables: false }
      }
      _ => { fail problem(TomlReason.UnexpectedByte, TomlScanner.offset(&scanner.*)) }
    }
  }
  fail problem(TomlReason.UnexpectedEnd, TomlScanner.offset(&scanner.*))
}

effect fn parseInline(scanner: &mut TomlScanner)
  -> Value ! TomlError | OutOfMemoryError ? &mut Allocator {
  let mut value = run table(TableKind.Inline)
  while true {
    let token = run next(&mut scanner.*)
    let parsed = match move token {
      TomlToken.InlineEnd => { return move value }
      TomlToken.Text { span } => run key(&mut scanner.*, TomlToken.Text { span: span })
      TomlToken.String { span, literal, multiline } => run key(&mut scanner.*, TomlToken.String {
        span: span, literal: literal, multiline: multiline })
      _ => { fail problem(TomlReason.UnexpectedByte, TomlScanner.offset(&scanner.*)) }
    }
    let ParsedKey { parts, delimiter } = move parsed
    match move delimiter {
      TomlToken.Equals => {}
      _ => { fail problem(TomlReason.UnexpectedByte, TomlScanner.offset(&scanner.*)) }
    }
    let nextValue = run next(&mut scanner.*)
    let item = run parseValue(&mut scanner.*, move nextValue)
    let updated = run insertKey(move value, List<KeyPart>.asSlice(&parts), usize.ZERO, move item, true)
    value = move updated
    let separator = run next(&mut scanner.*)
    match move separator {
      TomlToken.Comma => {}
      TomlToken.InlineEnd => { return move value }
      _ => { fail problem(TomlReason.UnexpectedByte, TomlScanner.offset(&scanner.*)) }
    }
  }
  fail problem(TomlReason.UnexpectedEnd, TomlScanner.offset(&scanner.*))
}

effect fn table(kind: TableKind) -> Value ! OutOfMemoryError ? &mut Allocator {
  let entries = run Box<List<TomlChild>>.make(List<TomlChild>.make())
  return Value.Table { entries: move entries, kind: move kind }
}

fn find<'a>(entries: &'a List<TomlChild>, name: string) -> Option<&'a Value> {
  let children = List<TomlChild>.asSlice(entries)
  let mut at = usize.ZERO
  while at < children.length {
    match &children[at] {
      TomlChild.Member { entry } => {
        if String.view(&entry.key) == name { return Option<&'a Value>.some(&entry.value) }
      }
      _ => {}
    }
    at = at + usize.ONE
  }
  return Option<&'a Value>.none()
}

fn indexOf(entries: &List<TomlChild>, name: string) -> Option<usize> {
  let children = List<TomlChild>.asSlice(entries)
  let mut at = usize.ZERO
  while at < children.length {
    match &children[at] {
      TomlChild.Member { entry } => {
        if String.view(&entry.key) == name { return Option<usize>.some(at) }
      }
      _ => {}
    }
    at = at + usize.ONE
  }
  return Option<usize>.none()
}

effect fn insertAt(root: Value, current: &[KeyPart], at: usize,
  parts: &[KeyPart], keyAt: usize, value: Value, inline: bool)
  -> Value ! TomlError | OutOfMemoryError ? &mut Allocator {
  if at == current.length { return run insertKey(move root, parts, keyAt, move value, inline) }
  let mut owned = move root
  match &mut owned {
    Value.Table { entries, kind: _ } => {
      let mut boxed = Box<List<TomlChild>>.getMut(&mut entries)
      let found = indexOf(&boxed[0], String.view(&current[at].name))
      let index = match move found {
        Option<usize>.Some { value: position } => position
        Option<usize>.None => { fail problem(TomlReason.TableConflict, current[at].offset) }
      }
      let removed = List<TomlChild>.remove(&mut boxed[0], index)
      let entry = match move removed {
        TomlChild.Member { entry } => move entry
        _ => { fail problem(TomlReason.TableConflict, current[at].offset) }
      }
      let updated = run insertAt(move entry.value, current, at + usize.ONE, parts, keyAt, move value, inline)
      run List<TomlChild>.insert(&mut boxed[0], index, TomlChild.Member {
        entry: TomlEntry { key: move entry.key, value: move updated }
      })
    }
    Value.Array { values, tables } => {
      if tables {} else { fail problem(TomlReason.TableConflict, current[at].offset) }
      let mut boxed = Box<List<TomlChild>>.getMut(&mut values)
      let index = List<TomlChild>.length(&boxed[0]) - usize.ONE
      let removed = List<TomlChild>.remove(&mut boxed[0], index)
      let child = match move removed {
        TomlChild.Item { value: item } => move item
        _ => { fail problem(TomlReason.TableConflict, current[at].offset) }
      }
      let updated = run insertAt(move child, current, at, parts, keyAt, move value, inline)
      run List<TomlChild>.insert(&mut boxed[0], index, TomlChild.Item { value: move updated })
    }
    _ => { fail problem(TomlReason.TableConflict, current[at].offset) }
  }
  return move owned
}

effect fn insertKey(root: Value, parts: &[KeyPart], at: usize, value: Value, inline: bool)
  -> Value ! TomlError | OutOfMemoryError ? &mut Allocator {
  let mut owned = move root
  match &mut owned {
    Value.Table { entries, kind } => {
      let closed = match kind {
        TableKind.Inline => true
        _ => false
      }
      if closed && !inline { fail problem(TomlReason.TableConflict, parts[at].offset) }
      let mut boxed = Box<List<TomlChild>>.getMut(&mut entries)
      let found = indexOf(&boxed[0], String.view(&parts[at].name))
      if at + usize.ONE == parts.length {
        match move found {
          Option<usize>.Some { value: _ } => { fail problem(TomlReason.DuplicateKey, parts[at].offset) }
          Option<usize>.None => {
            let name = run String.copy(String.view(&parts[at].name))
            run List<TomlChild>.append(&mut boxed[0], TomlChild.Member {
              entry: TomlEntry { key: move name, value: move value }
            })
          }
        }
      } else {
        let next = indexOf(&boxed[0], String.view(&parts[at].name))
        let mut index = usize.ZERO
        match move next {
          Option<usize>.Some { value: position } => { index = position }
          Option<usize>.None => {
            let child = run table(TableKind.Dotted)
            let name = run String.copy(String.view(&parts[at].name))
            run List<TomlChild>.append(&mut boxed[0], TomlChild.Member {
              entry: TomlEntry { key: move name, value: move child }
            })
            index = List<TomlChild>.length(&boxed[0]) - usize.ONE
          }
        }
        let removed = List<TomlChild>.remove(&mut boxed[0], index)
        let entry = match move removed {
          TomlChild.Member { entry } => move entry
          _ => { fail problem(TomlReason.TableConflict, parts[at].offset) }
        }
        let updated = run insertKey(move entry.value, parts, at + usize.ONE, move value, inline)
        run List<TomlChild>.insert(&mut boxed[0], index, TomlChild.Member {
          entry: TomlEntry { key: move entry.key, value: move updated }
        })
      }
    }
    Value.Array { values, tables } => {
      if tables {} else { fail problem(TomlReason.TableConflict, parts[at].offset) }
      let mut boxed = Box<List<TomlChild>>.getMut(&mut values)
      let index = List<TomlChild>.length(&boxed[0]) - usize.ONE
      let removed = List<TomlChild>.remove(&mut boxed[0], index)
      let child = match move removed {
        TomlChild.Item { value: item } => move item
        _ => { fail problem(TomlReason.TableConflict, parts[at].offset) }
      }
      let updated = run insertKey(move child, parts, at, move value, inline)
      run List<TomlChild>.insert(&mut boxed[0], index, TomlChild.Item { value: move updated })
    }
    _ => { fail problem(TomlReason.TableConflict, parts[at].offset) }
  }
  return move owned
}

effect fn defineHeader(root: Value, parts: &[KeyPart], at: usize, array: bool)
  -> Value ! TomlError | OutOfMemoryError ? &mut Allocator {
  let mut owned = move root
  match &mut owned {
    Value.Table { entries, kind } => {
      let closed = match kind {
        TableKind.Inline => true
        _ => false
      }
      if closed { fail problem(TomlReason.TableConflict, parts[at].offset) }
      let mut boxed = Box<List<TomlChild>>.getMut(&mut entries)
      let found = indexOf(&boxed[0], String.view(&parts[at].name))
      if at + usize.ONE == parts.length {
        match move found {
          Option<usize>.None => {
            let name = run String.copy(String.view(&parts[at].name))
            if array {
              let child = run tableArray()
              run List<TomlChild>.append(&mut boxed[0], TomlChild.Member {
                entry: TomlEntry { key: move name, value: move child }
              })
            } else {
              let child = run table(TableKind.Explicit)
              run List<TomlChild>.append(&mut boxed[0], TomlChild.Member {
                entry: TomlEntry { key: move name, value: move child }
              })
            }
          }
          Option<usize>.Some { value: index } => {
            let removed = List<TomlChild>.remove(&mut boxed[0], index)
            let entry = match move removed {
              TomlChild.Member { entry } => move entry
              _ => { fail problem(TomlReason.TableConflict, parts[at].offset) }
            }
            let mut child = move entry.value
            match &mut child {
              Value.Table { entries: _, kind: childKind } => {
                let implicit = match childKind {
                  TableKind.Implicit => true
                  _ => false
                }
                if array || !implicit {
                  fail problem(TomlReason.TableConflict, parts[at].offset)
                }
              }
              Value.Array { values, tables } => {
                if !array { fail problem(TomlReason.TableConflict, parts[at].offset) }
                if tables {} else { fail problem(TomlReason.TableConflict, parts[at].offset) }
                let mut boxedArray = Box<List<TomlChild>>.getMut(&mut values)
                let tableValue = run table(TableKind.Explicit)
                run List<TomlChild>.append(&mut boxedArray[0], TomlChild.Item { value: move tableValue })
              }
              _ => { fail problem(TomlReason.TableConflict, parts[at].offset) }
            }
            let defined = match move child {
              Value.Table { entries: tableEntries, kind: _ } => Value.Table { entries: move tableEntries, kind: TableKind.Explicit }
              Value.Array { values, tables } => Value.Array { values: move values, tables: tables }
              _ => { fail problem(TomlReason.TableConflict, parts[at].offset) }
            }
            run List<TomlChild>.insert(&mut boxed[0], index, TomlChild.Member {
              entry: TomlEntry { key: move entry.key, value: move defined }
            })
          }
        }
      } else {
        let next = indexOf(&boxed[0], String.view(&parts[at].name))
        let mut index = usize.ZERO
        match move next {
          Option<usize>.Some { value: position } => { index = position }
          Option<usize>.None => {
            let child = run table(TableKind.Implicit)
            let name = run String.copy(String.view(&parts[at].name))
            run List<TomlChild>.append(&mut boxed[0], TomlChild.Member {
              entry: TomlEntry { key: move name, value: move child }
            })
            index = List<TomlChild>.length(&boxed[0]) - usize.ONE
          }
        }
        let removed = List<TomlChild>.remove(&mut boxed[0], index)
        let entry = match move removed {
          TomlChild.Member { entry } => move entry
          _ => { fail problem(TomlReason.TableConflict, parts[at].offset) }
        }
        let updated = run defineHeader(move entry.value, parts, at + usize.ONE, array)
        run List<TomlChild>.insert(&mut boxed[0], index, TomlChild.Member {
          entry: TomlEntry { key: move entry.key, value: move updated }
        })
      }
    }
    Value.Array { values, tables } => {
      if tables {} else { fail problem(TomlReason.TableConflict, parts[at].offset) }
      let mut boxed = Box<List<TomlChild>>.getMut(&mut values)
      let index = List<TomlChild>.length(&boxed[0]) - usize.ONE
      let removed = List<TomlChild>.remove(&mut boxed[0], index)
      let child = match move removed {
        TomlChild.Item { value } => move value
        _ => { fail problem(TomlReason.TableConflict, parts[at].offset) }
      }
      let updated = run defineHeader(move child, parts, at, array)
      run List<TomlChild>.insert(&mut boxed[0], index, TomlChild.Item { value: move updated })
    }
    _ => { fail problem(TomlReason.TableConflict, parts[at].offset) }
  }
  return move owned
}

effect fn tableArray() -> Value ! OutOfMemoryError ? &mut Allocator {
  let mut values = List<TomlChild>.make()
  let first = run table(TableKind.Explicit)
  run List<TomlChild>.append(&mut values, TomlChild.Item { value: move first })
  let boxed = run Box<List<TomlChild>>.make(move values)
  return Value.Array { values: move boxed, tables: true }
}

effect fn next(scanner: &mut TomlScanner) -> TomlToken ! TomlError {
  while true {
    let token = TomlScanner.next(&mut scanner.*)
    match move token {
      Result<TomlToken, TomlError>.Success { value } => {
        let newline = match &value {
          TomlToken.Newline => true
          _ => false
        }
        if !newline { return move value }
      }
      Result<TomlToken, TomlError>.Failure { error } => { fail move error }
    }
  }
  fail problem(TomlReason.UnexpectedEnd, TomlScanner.offset(&scanner.*))
}

fn problem(reason: TomlReason, offset: usize) -> TomlError {
  return TomlError { reason: move reason, offset: offset }
}
