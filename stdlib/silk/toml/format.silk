//! Format TOML documents without changing comments, value spellings, or declaration order.
//!
//! # When to use
//! Use `TomlFormat` before saving edited TOML text. Use `silk.toml.output` to serialize a value tree.
//!
//! @category Data formats

import silk.collections.bytes { Bytes }
import silk.collections.slice { Slice }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.usize
import silk.text.string { String }
import silk.toml.scanner { TomlError, TomlScanner, TomlToken }
import silk.toml.value { Toml }

struct Layout {
  output: Bytes,
  depth: usize,
  lines: usize,
  space: bool,
  value: bool,
  header: bool,
  previous: u8,
}

// Whitespace is delayed so no line can end with formatter-generated spaces.
effect fn emit(layout: &mut Layout, text: &[u8]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if Bytes.length(&layout.output) > usize.ZERO {
    if layout.lines > usize.ZERO {
      run Bytes.append(&mut layout.output, b"\n")
      if layout.lines > usize.ONE {
        run Bytes.append(&mut layout.output, b"\n")
      }
    } else if layout.space {
      run Bytes.append(&mut layout.output, b" ")
    }
  }
  if layout.lines > usize.ZERO || Bytes.length(&layout.output) == usize.ZERO {
    let mut level = usize.ZERO
    while level < layout.depth {
      run Bytes.append(&mut layout.output, b"  ")
      level = level + usize.ONE
    }
  }
  run Bytes.append(&mut layout.output, text)
  layout.lines = usize.ZERO
  layout.space = false
}

// The scanner skips comments. Recover them from the gap before each returned token.
effect fn comments(layout: &mut Layout, source: &[u8], start: usize, end: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut at = start
  while at < end {
    if source[at] == 35 {
      let first = at
      while at < end && source[at] != 10 && source[at] != 13 {
        at = at + usize.ONE
      }
      let mut last = at
      while last > first && (source[last - usize.ONE] == 32 || source[last - usize.ONE] == 9) {
        last = last - usize.ONE
      }
      layout.space = true
      run emit(&mut layout.*, Slice.view<u8>(source, first, last - first))
    } else {
      at = at + usize.ONE
    }
  }
}

/// A comment-preserving TOML formatter with two-space indentation for nested values.
pub struct TomlFormat {}

impl TomlFormat {
  /// Returns formatted TOML text, preserving comments, literal spellings, and declaration order.
  ///
  /// # Details
  /// Spaces surround `=` and follow commas. Inline tables have spaces inside their braces.
  /// Nested values use two-space indentation. Existing line breaks inside arrays and inline tables remain.
  /// Dotted keys have no spaces around dots. Blank runs become one blank line, and nonempty output ends with LF.
  /// String contents remain byte-for-byte unchanged, including embedded line endings. Other line endings become LF.
  /// Repeated formatting returns the same text. Empty or whitespace-only input produces an empty string.
  ///
  /// # Errors
  /// - `TomlError` if the input is invalid TOML, including duplicate keys and conflicting tables.
  /// - `OutOfMemoryError` if validation or output allocation fails. The input remains unchanged.
  pub effect fn format(source: string) -> String
    ! TomlError | OutOfMemoryError
    ? &mut Allocator {
    let output = run TomlFormat.formatBytes(String.utf8Bytes(source))
    return unsafe String.fromBytesUnchecked(move output)
  }

  /// Returns formatted TOML file bytes, preserving comments, literal spellings, and declaration order.
  ///
  /// # Details
  /// Spaces surround `=` and follow commas; inline tables have spaces inside braces.
  /// Nested values use two-space indentation. Existing array and inline-table line breaks remain.
  /// Dotted keys have no spaces around dots. Blank runs become one blank line; nonempty output ends with LF.
  /// String contents remain byte-for-byte unchanged. Other line endings become LF.
  /// Repeated formatting returns the same bytes. Empty or whitespace-only input produces empty output.
  ///
  /// # Errors
  /// - `TomlError` if the bytes are invalid UTF-8 or invalid TOML, including duplicate keys and conflicting tables.
  /// - `OutOfMemoryError` if validation or output allocation fails. The input remains unchanged.
  pub effect fn formatBytes(source: &[u8]) -> Bytes
    ! TomlError | OutOfMemoryError
    ? &mut Allocator {
    drop run Toml.parse(source)
    let mut scanner = TomlScanner.make(source)
    let mut layout = Layout {
      output: Bytes.make(),
      depth: usize.ZERO,
      lines: usize.ZERO,
      space: false,
      value: false,
      header: false,
      previous: 0,
    }
    while true {
      let before = TomlScanner.offset(&scanner)
      let token = match move TomlScanner.next(&mut scanner) {
        Result<TomlToken, TomlError>.Success { value } => value
        Result<TomlToken, TomlError>.Failure { error } => {
          fail error
        }
      }
      let after = TomlScanner.offset(&scanner)
      let mut start = after
      match token {
        TomlToken.Text { span } => {
          start = span.offset
        }
        TomlToken.String { span, literal: _, multiline: _ } => {
          start = span.offset
        }
        TomlToken.EndOfInput => {}
        _ => {
          start = after - usize.ONE
        }
      }
      run comments(&mut layout, source, before, start)
      match token {
        TomlToken.EndOfInput => {
          break
        }
        TomlToken.Newline => {
          if layout.lines < usize.add(0, 2) {
            layout.lines = layout.lines + usize.ONE
          }
          layout.space = false
          if layout.depth == usize.ZERO {
            layout.value = false
            layout.header = false
          }
          continue
        }
        TomlToken.Equals => {
          layout.space = true
        }
        TomlToken.Dot => {
          layout.space = false
        }
        TomlToken.Comma => {
          layout.space = false
        }
        TomlToken.ArrayBegin => {
          if !layout.value {
            layout.header = true
          }
        }
        TomlToken.ArrayEnd => {
          layout.space = false
          if !layout.header {
            layout.depth = layout.depth - usize.ONE
          }
        }
        TomlToken.InlineEnd => {
          layout.depth = layout.depth - usize.ONE
          layout.space = layout.previous != 123
        }
        _ => {}
      }
      run emit(&mut layout, Slice.view<u8>(source, start, after - start))
      match token {
        TomlToken.Equals => {
          layout.space = true
          layout.value = true
        }
        TomlToken.Comma => {
          layout.space = true
        }
        TomlToken.InlineBegin => {
          layout.space = true
          layout.depth = layout.depth + usize.ONE
        }
        TomlToken.ArrayBegin => {
          if !layout.header {
            layout.depth = layout.depth + usize.ONE
          }
        }
        _ => {}
      }
      layout.previous = source[start]
    }
    if Bytes.length(&layout.output) > usize.ZERO {
      run Bytes.append(&mut layout.output, b"\n")
    }
    return move layout.output
  }
}
