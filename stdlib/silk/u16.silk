//! Sixteen-bit unsigned integers with explicit arithmetic and conversion failure policies.
//!
//! # When to use
//! Use `u16` when a file format, protocol, or compact data structure specifies exactly sixteen
//! unsigned bits. Use `usize` for in-memory lengths and indices that follow the target.
//!
//! # Details
//! Ordinary arithmetic, narrowing conversions, division by zero, and invalid shift counts trap.
//! `checked*` reports invalid arithmetic with [`Option`], `wrapping*` computes modulo 2^16, and
//! `saturating*` clamps at [`MIN`] or [`MAX`]. Right shift inserts zero bits.
//!
//! Decimal [`parse`] consumes the entire input and distinguishes malformed text from range
//! overflow. Use [`Format`] with `Format.display` for defaults or `Format.displayWith` for explicit
//! options. Both operations stream through a mutable `Writer` without `Allocator`.
//!
//! # Examples
//! ## Recover from a narrowing conversion
//! ```silk
//! import silk.option { Option }
//!
//! import silk.u16
//!
//! import silk.u8
//!
//! pub fn main() -> i32 {
//!   let narrowed = u16.checkedToU8(300)
//!   let value = move narrowed
//!     |> Option<u8>.unwrapOr(42)
//!   return u8.toI32(value)
//! }
//! ```

import silk.bool
import silk.f32
import silk.f64
import silk.format { Format, ParseError }
import silk.i16
import silk.i32
import silk.i64
import silk.i8
import silk.isize
import silk.option { Option }
import silk.result { Result }
import silk.u32
import silk.u64
import silk.u8
import silk.usize

/// The largest `u16` value.
pub const MAX: u16 = 65535

/// The smallest `u16` value.
pub const MIN: u16 = 0

/// The fixed width of `u16`, in bits.
pub const BITS: u32 = 16

/// Converts `value` to `u8`. Traps if `value` is outside the `u8` range. Use
/// this function when an out-of-range value is a program error.
pub fn toU8(value: u16) -> u8 {
  return Intrinsic.u16ToU8(value)
}

/// Converts `value` to `u8`, or returns `None` if `value` is outside the `u8`
/// range. Use this function when an out-of-range value is input data.
pub fn checkedToU8(value: u16) -> Option<u8> {
  return Intrinsic.u16CheckedToU8<Option<u8>>(value, Option.some, Option.none)
}

/// Returns `value` unchanged as `u16`. Use this function when generic conversion code
/// can select `u16` as both source and destination.
pub fn toU16(value: u16) -> u16 {
  return Intrinsic.u16ToU16(value)
}

/// Returns `Some` with `value` unchanged as `u16`. Use this function when generic
/// checked-conversion code can select the same source and destination type.
pub fn checkedToU16(value: u16) -> Option<u16> {
  return Intrinsic.u16CheckedToU16<Option<u16>>(value, Option.some, Option.none)
}

/// Converts `value` exactly to `u32`. Every `u16` value is representable.
pub fn toU32(value: u16) -> u32 {
  return Intrinsic.u16ToU32(value)
}

/// Converts `value` exactly to `u32` and returns `Some`. Every `u16` value is
/// representable.
pub fn checkedToU32(value: u16) -> Option<u32> {
  return Intrinsic.u16CheckedToU32<Option<u32>>(value, Option.some, Option.none)
}

/// Converts `value` exactly to `u64`. Every `u16` value is representable.
pub fn toU64(value: u16) -> u64 {
  return Intrinsic.u16ToU64(value)
}

/// Converts `value` exactly to `u64` and returns `Some`. Every `u16` value is
/// representable.
pub fn checkedToU64(value: u16) -> Option<u64> {
  return Intrinsic.u16CheckedToU64<Option<u64>>(value, Option.some, Option.none)
}

/// Converts `value` exactly to `usize`. Every `u16` value is representable.
pub fn toUsize(value: u16) -> usize {
  return Intrinsic.u16ToUsize(value)
}

/// Converts `value` exactly to `usize` and returns `Some`. Every `u16` value is
/// representable.
pub fn checkedToUsize(value: u16) -> Option<usize> {
  return Intrinsic.u16CheckedToUsize<Option<usize>>(value, Option.some, Option.none)
}

/// Converts `value` to `i8`. Traps if `value` is outside the `i8` range. Use
/// this function when an out-of-range value is a program error.
pub fn toI8(value: u16) -> i8 {
  return Intrinsic.u16ToI8(value)
}

/// Converts `value` to `i8`, or returns `None` if `value` is outside the `i8`
/// range. Use this function when an out-of-range value is input data.
pub fn checkedToI8(value: u16) -> Option<i8> {
  return Intrinsic.u16CheckedToI8<Option<i8>>(value, Option.some, Option.none)
}

/// Converts `value` to `i16`. Traps if `value` is outside the `i16` range. Use
/// this function when an out-of-range value is a program error.
pub fn toI16(value: u16) -> i16 {
  return Intrinsic.u16ToI16(value)
}

/// Converts `value` to `i16`, or returns `None` if `value` is outside the `i16`
/// range. Use this function when an out-of-range value is input data.
pub fn checkedToI16(value: u16) -> Option<i16> {
  return Intrinsic.u16CheckedToI16<Option<i16>>(value, Option.some, Option.none)
}

/// Converts `value` exactly to `i32`. Every `u16` value is representable.
pub fn toI32(value: u16) -> i32 {
  return Intrinsic.u16ToI32(value)
}

/// Converts `value` exactly to `i32` and returns `Some`. Every `u16` value is
/// representable.
pub fn checkedToI32(value: u16) -> Option<i32> {
  return Intrinsic.u16CheckedToI32<Option<i32>>(value, Option.some, Option.none)
}

/// Converts `value` exactly to `i64`. Every `u16` value is representable.
pub fn toI64(value: u16) -> i64 {
  return Intrinsic.u16ToI64(value)
}

/// Converts `value` exactly to `i64` and returns `Some`. Every `u16` value is
/// representable.
pub fn checkedToI64(value: u16) -> Option<i64> {
  return Intrinsic.u16CheckedToI64<Option<i64>>(value, Option.some, Option.none)
}

/// Converts `value` exactly to `isize`. Every `u16` value is representable.
pub fn toIsize(value: u16) -> isize {
  return Intrinsic.u16ToIsize(value)
}

/// Converts `value` exactly to `isize` and returns `Some`. Every `u16` value is
/// representable.
pub fn checkedToIsize(value: u16) -> Option<isize> {
  return Intrinsic.u16CheckedToIsize<Option<isize>>(value, Option.some, Option.none)
}

/// Converts `value` exactly to `f32`. Every `u16` value is below `2^24` and so is exactly
/// representable.
pub fn toF32(value: u16) -> f32 {
  return Intrinsic.u16ToF32(value)
}

/// Converts `value` exactly to `f64`. Every `u16` value is below `2^53` and so is exactly
/// representable.
pub fn toF64(value: u16) -> f64 {
  return Intrinsic.u16ToF64(value)
}

/// Returns `left + right` and traps if the result is outside the `u16` range. Use this function
/// when overflow is a program error.
pub fn add(left: u16, right: u16) -> u16 {
  return Intrinsic.u16Add(left, right)
}

/// Returns `left - right` and traps if the result is outside the `u16` range. Use this function
/// when overflow is a program error.
pub fn subtract(left: u16, right: u16) -> u16 {
  return Intrinsic.u16Subtract(left, right)
}

/// Returns `left * right` and traps if the result is outside the `u16` range. Use this function
/// when overflow is a program error.
pub fn multiply(left: u16, right: u16) -> u16 {
  return Intrinsic.u16Multiply(left, right)
}

/// Returns `left / right`. Traps if `right` is zero. Use this function when a zero
/// divisor is a program error.
pub fn divide(left: u16, right: u16) -> u16 {
  return Intrinsic.u16Divide(left, right)
}

/// Returns the remainder of `left / right`. Traps if `right` is zero. Use this function
/// when a zero divisor is a program error.
pub fn remainder(left: u16, right: u16) -> u16 {
  return Intrinsic.u16Remainder(left, right)
}

/// Returns the bitwise AND of `left` and `right`.
pub fn bitAnd(left: u16, right: u16) -> u16 {
  return Intrinsic.u16BitAnd(left, right)
}

/// Returns the bitwise OR of `left` and `right`.
pub fn bitOr(left: u16, right: u16) -> u16 {
  return Intrinsic.u16BitOr(left, right)
}

/// Returns the bitwise exclusive OR of `left` and `right`.
pub fn bitXor(left: u16, right: u16) -> u16 {
  return Intrinsic.u16BitXor(left, right)
}

/// Returns `value` with each bit inverted.
pub fn bitNot(value: u16) -> u16 {
  return Intrinsic.u16BitNot(value)
}

/// Shifts `left` bits left by `right` positions. Traps if `right` is not less than [`BITS`].
pub fn shiftLeft(left: u16, right: u16) -> u16 {
  return Intrinsic.u16ShiftLeft(left, right)
}

/// Shifts `left` bits right by `right` positions and inserts zero bits. Traps if `right` is
/// not less than [`BITS`].
pub fn shiftRight(left: u16, right: u16) -> u16 {
  return Intrinsic.u16ShiftRight(left, right)
}

/// Rotates the bits of `left` left by `right` positions.
pub fn rotateLeft(left: u16, right: u16) -> u16 {
  return Intrinsic.u16RotateLeft(left, right)
}

/// Rotates the bits of `left` right by `right` positions.
pub fn rotateRight(left: u16, right: u16) -> u16 {
  return Intrinsic.u16RotateRight(left, right)
}

/// Returns `left + right`, wrapped to the `u16` range. Use this function for
/// deliberate modulo arithmetic.
pub fn wrappingAdd(left: u16, right: u16) -> u16 {
  return Intrinsic.u16WrappingAdd(left, right)
}

/// Returns `left - right`, wrapped to the `u16` range. Use this function for
/// deliberate modulo arithmetic.
pub fn wrappingSubtract(left: u16, right: u16) -> u16 {
  return Intrinsic.u16WrappingSubtract(left, right)
}

/// Returns `left * right`, wrapped to the `u16` range. Use this function for
/// deliberate modulo arithmetic.
pub fn wrappingMultiply(left: u16, right: u16) -> u16 {
  return Intrinsic.u16WrappingMultiply(left, right)
}

/// Returns `left + right`, clamped to [`MIN`] or [`MAX`]. Use this function when a
/// boundary value is the required overflow result.
pub fn saturatingAdd(left: u16, right: u16) -> u16 {
  return Intrinsic.u16SaturatingAdd(left, right)
}

/// Returns `left - right`, clamped to [`MIN`] or [`MAX`]. Use this function when a
/// boundary value is the required overflow result.
pub fn saturatingSubtract(left: u16, right: u16) -> u16 {
  return Intrinsic.u16SaturatingSubtract(left, right)
}

/// Returns `left * right`, clamped to [`MIN`] or [`MAX`]. Use this function when a
/// boundary value is the required overflow result.
pub fn saturatingMultiply(left: u16, right: u16) -> u16 {
  return Intrinsic.u16SaturatingMultiply(left, right)
}

/// Returns `Some` with `left + right`, or `None` if the result is outside the `u16` range.
/// Use this function when overflow is input data.
pub fn checkedAdd(left: u16, right: u16) -> Option<u16> {
  return Intrinsic.u16CheckedAdd<Option<u16>>(left, right, Option.some, Option.none)
}

/// Returns `Some` with `left - right`, or `None` if the result is outside the `u16` range.
/// Use this function when overflow is input data.
pub fn checkedSubtract(left: u16, right: u16) -> Option<u16> {
  return Intrinsic.u16CheckedSubtract<Option<u16>>(left, right, Option.some, Option.none)
}

/// Returns `Some` with `left * right`, or `None` if the result is outside the `u16` range.
/// Use this function when overflow is input data.
pub fn checkedMultiply(left: u16, right: u16) -> Option<u16> {
  return Intrinsic.u16CheckedMultiply<Option<u16>>(left, right, Option.some, Option.none)
}

/// Returns `Some` with `left / right`, or `None` if `right` is zero. Use this
/// function when a zero divisor is input data.
pub fn checkedDivide(left: u16, right: u16) -> Option<u16> {
  return Intrinsic.u16CheckedDivide<Option<u16>>(left, right, Option.some, Option.none)
}

/// Returns `Some` with the remainder, or `None` if `right` is zero. Use this function
/// when a zero divisor is input data.
pub fn checkedRemainder(left: u16, right: u16) -> Option<u16> {
  return Intrinsic.u16CheckedRemainder<Option<u16>>(left, right, Option.some, Option.none)
}

/// Returns `true` when `left` and `right` are equal.
pub fn equals(left: u16, right: u16) -> bool {
  return Intrinsic.u16Equals(left, right)
}

/// Returns `true` when `left` and `right` are not equal.
pub fn notEquals(left: u16, right: u16) -> bool {
  return Intrinsic.u16NotEquals(left, right)
}

/// Returns `true` when `left` is less than `right`.
pub fn lessThan(left: u16, right: u16) -> bool {
  return Intrinsic.u16LessThan(&left, &right)
}

/// Returns `true` when `left` is less than or equal to `right`.
pub fn lessOrEqual(left: u16, right: u16) -> bool {
  return Intrinsic.u16LessOrEqual(left, right)
}

/// Returns `true` when `left` is greater than `right`.
pub fn greaterThan(left: u16, right: u16) -> bool {
  return Intrinsic.u16GreaterThan(left, right)
}

/// Returns `true` when `left` is greater than or equal to `right`.
pub fn greaterOrEqual(left: u16, right: u16) -> bool {
  return Intrinsic.u16GreaterOrEqual(left, right)
}

/// Reads the complete text as an unsigned decimal `u16`.
///
/// # Details
///
/// A failure contains `silk.format.NotANumber` for empty text, a sign, a non-digit, or trailing
/// bytes. It contains `silk.format.OutOfRange` if the number is outside the `u16` range.
pub fn parse(text: string) -> Result<u16, ParseError> {
  return Format.u16Value(text)
}
