//! Byte size and alignment values that describe the memory to request from an allocator.
//!
//! # When to use
//! Use [`Layout.of`] for memory that holds a Silk type. Use [`Layout.repeat`] for an array of
//! elements. Use [`Layout.make`] only when the code knows a byte size and alignment but no type,
//! such as at a foreign boundary.
//!
//! # Details
//! An alignment is always a power of two and never zero. A [`Layout`] only describes memory. It
//! does not allocate or initialize memory. [`Layout.make`] and [`Layout.repeat`] check their
//! inputs and return an error value instead of an invalid layout.
//!
//! # Examples
//! ## Size storage for repeated values
//! ```silk
//! import silk.mem.layout { Layout, LayoutOverflow }
//! import silk.num.usize
//!
//! pub fn main() -> i32 {
//!   let element = Layout.of<i32>()
//!   let bytes = match move Layout.repeat(move element, 3) {
//!     Layout { bytes, alignment } => bytes
//!     LayoutOverflow {} => usize.ZERO
//!   }
//!   if bytes != 12 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Memory

import silk.core.option { Option }
import silk.num.usize

/// A byte size and an alignment that describe one block of memory.
///
/// # Details
///
/// Make a layout with [`Layout.of`], [`Layout.make`], or [`Layout.repeat`]. These functions make
/// sure that `alignment` is a power of two and never zero. A struct literal does not check the
/// fields. A layout only describes memory. It does not allocate or initialize memory.
pub struct Layout {
  /// The number of bytes in the block. It can be zero.
  pub bytes: usize,
  /// The alignment of the block in bytes. The start address must be a multiple of this value. It is
  /// a power of two.
  pub alignment: usize,
}

impl Layout {
  /// Returns the byte size and alignment of one value of type `T`.
  pub fn of<T>() -> Layout {
    return Intrinsic.layoutOf<T>()
  }

  /// Returns a layout with `size` bytes and the given `alignment`, or [`InvalidAlignment`] if
  /// `alignment` is not valid.
  ///
  /// # When to use
  ///
  /// Use `make` when the code has a byte size and alignment but no Silk type. Use [`Layout.of`]
  /// when a type is available.
  ///
  /// # Errors
  ///
  /// - [`InvalidAlignment`] if `alignment` is zero or is not a power of two.
  pub fn make(size: usize, alignment: usize) -> Layout | InvalidAlignment {
    if alignment == 0 {
      return InvalidAlignment { alignment: alignment }
    }
    let previous = alignment - 1
    if usize.bitAnd(alignment, previous) != 0 {
      return InvalidAlignment { alignment: alignment }
    }
    return Layout { bytes: size, alignment: alignment }
  }

  /// Returns the layout of `count` consecutive blocks of `layout`, or [`LayoutOverflow`] if the
  /// size is too large.
  ///
  /// # Details
  ///
  /// The result has `layout.bytes * count` bytes and the alignment of `layout`. A `count` of zero
  /// gives a layout of zero bytes.
  ///
  /// # Errors
  ///
  /// - [`LayoutOverflow`] if `layout.bytes * count` is more than the maximum `usize`.
  pub fn repeat(layout: Layout, count: usize) -> Layout | LayoutOverflow {
    return match move usize.checkedMultiply(layout.bytes, count) {
      Option<usize>.None => LayoutOverflow {}
      Option<usize>.Some { value } => Layout { bytes: value, alignment: layout.alignment }
    }
  }
}

/// The error value of [`Layout.make`] for an alignment that is zero or not a power of two.
pub struct InvalidAlignment {
  /// The alignment that [`Layout.make`] did not accept.
  pub alignment: usize,
}

/// The error value of [`Layout.repeat`] when the total byte size is more than the maximum `usize`.
pub struct LayoutOverflow {}

