//! The C variadic arguments of an `export "C"` function, read one at a time.
//!
//! # When to use
//! Use [`VaList`] in the body of an `export "C"` function whose parameters end with `...`, such as
//! a C library entry point like `uv_loop_configure(loop, option, ...)` that a C program calls with
//! extra arguments.
//!
//! # Details
//! The function's C entry starts its `va_list` before the body runs. `Intrinsic.variadicArguments()`
//! answers its address in that body only, and [`VaList.of`] wraps it. Each [`VaList.next`] reads
//! the next argument as the C caller passed it, under the target's C ABI: System V x86-64 and AAPCS
//! ARM64 read the register save area and then the stack, while Darwin ARM64, Windows and
//! WebAssembly read consecutive stack slots. A type implements [`VariadicArgument`] to say how C
//! passes it; the integer types, `f64` and the raw pointers of [`VaList.nextPointer`] are covered.
//!
//! C promotes a variadic `char` or `short` to `int` and a `float` to `double`, so read those as
//! `i32` and `f64`.
//!
//! # Gotchas
//! Nothing checks the C caller: reading more arguments than it passed, or a type other than the
//! one it passed, reads unrelated memory. The list lives in the C entry's frame, so it is valid only
//! until the function returns; do not keep it or its address.
//!
//! # Examples
//! ## Read one `int` when the option asks for it
//! ```silk
//! import silk.mem.va_list { VaList }
//!
//! pub unsafe export "C" fn configure(target: *mut u8, option: i32, ...) -> i32 as "example_configure" {
//!   if option != 0 {
//!     return 0
//!   }
//!   unsafe {
//!     let mut arguments = VaList.of(Intrinsic.variadicArguments())
//!     return arguments.next<i32>()
//!   }
//! }
//!
//! pub fn main() -> i32 {
//!   return 0
//! }
//! ```
//!
//! @category Memory

import silk.core.ownership { Copy }
import silk.core.target { Arch, OperatingSystem, Target, pointerBits }
import silk.mem.pointer { Pointer }
import silk.num.i32
import silk.num.u32

/// The C variadic arguments of the running `export "C"` function, read in order.
///
/// # Details
///
/// Make one with [`VaList.of`] from `Intrinsic.variadicArguments()` in the body of an `export "C"`
/// function whose parameters end with `...`. Each [`VaList.next`] reads one argument under the
/// target's C ABI and moves past it. The list lives in the function's C entry frame and is valid
/// until the function returns.
pub struct VaList {
  list: *mut u64,
}

/// How C passes a variadic argument of type `T`: in an integer or a floating-point slot, and how
/// many bytes the value has.
///
/// # Details
///
/// [`VariadicArgument`] answers one for each type that [`VaList.next`] reads.
pub struct VariadicSlot<T> {
  /// Whether C passes the value in a floating-point register when one is free.
  pub floating: bool,
  /// The value's size in bytes: 4 or 8.
  pub bytes: usize,
  owner: [T; 0],
}

impl<T> VariadicSlot<T> {
  /// The slot of an integer or pointer of `bytes` bytes, 4 or 8.
  pub fn integer(bytes: usize) -> VariadicSlot<T> {
    return VariadicSlot<T> {floating: false, bytes: bytes, owner: []}
  }

  /// The slot of a `double`.
  pub fn float() -> VariadicSlot<T> {
    return VariadicSlot<T> {floating: true, bytes: 8, owner: []}
  }
}

/// A type that a C caller can pass as a variadic argument after C's default promotions, so that
/// [`VaList.next`] can read it.
///
/// # Details
///
/// `i32`, `u32`, `i64`, `u64`, `isize`, `usize` and `f64` implement it. A narrower C integer arrives
/// as `int` (`i32`), and a `float` arrives as `double` (`f64`).
pub interface VariadicArgument {
  /// How C passes a value of this type.
  fn variadicSlot() -> VariadicSlot<Self>
}

impl VariadicArgument for i32 {
  fn variadicSlot() -> VariadicSlot<i32> { return VariadicSlot<i32>.integer(4) }
}

impl VariadicArgument for u32 {
  fn variadicSlot() -> VariadicSlot<u32> { return VariadicSlot<u32>.integer(4) }
}

impl VariadicArgument for i64 {
  fn variadicSlot() -> VariadicSlot<i64> { return VariadicSlot<i64>.integer(8) }
}

impl VariadicArgument for u64 {
  fn variadicSlot() -> VariadicSlot<u64> { return VariadicSlot<u64>.integer(8) }
}

impl VariadicArgument for isize {
  fn variadicSlot() -> VariadicSlot<isize> { return VariadicSlot<isize>.integer(u32.toUsize(pointerBits / 8)) }
}

impl VariadicArgument for usize {
  fn variadicSlot() -> VariadicSlot<usize> { return VariadicSlot<usize>.integer(u32.toUsize(pointerBits / 8)) }
}

impl VariadicArgument for f64 {
  fn variadicSlot() -> VariadicSlot<f64> { return VariadicSlot<f64>.float() }
}

impl VaList {
  /// Wraps the `va_list` at `list`, the address `Intrinsic.variadicArguments()` answers in the
  /// body of an `export "C"` function whose parameters end with `...`.
  ///
  /// # Details
  ///
  /// The list starts at the first variadic argument. It lives in the function's C entry frame, so
  /// the result is valid until the function returns.
  pub unsafe fn of(list: *mut u64) -> VaList {
    return VaList {list: list}
  }

  /// Reads the next variadic argument as a `T` and moves past it.
  ///
  /// # Details
  ///
  /// It follows the target's C ABI for a value that C passed as `T` after the default promotions:
  /// a `char` or `short` arrives as `i32` and a `float` as `f64`. The caller must have passed an
  /// argument of this type in this position; nothing checks it.
  pub unsafe fn next<T: VariadicArgument + Copy>(self: &mut Self) -> T {
    unsafe {
      let slot: VariadicSlot<T> = VariadicArgument.variadicSlot()
      let at = nextSlot(self.list, slot.floating, slot.bytes)
      return Pointer.readUnaligned<T>(Intrinsic.pointerReinterpret<*const u8, *const align(1) T>(at))
    }
  }

  /// Reads the next variadic argument as a raw pointer to `T`, which may be null, and moves past
  /// it.
  ///
  /// # Details
  ///
  /// The caller must have passed a pointer in this position; nothing checks it.
  pub unsafe fn nextPointer<T>(self: &mut Self) -> ?*mut T {
    unsafe {
      let at = nextSlot(self.list, false, u32.toUsize(pointerBits / 8))
      return Pointer.readUnaligned<?*mut T>(Intrinsic.pointerReinterpret<*const u8, *const align(1) ?*mut T>(at))
    }
  }
}

// The address of the next argument of a slot of `bytes` bytes, floating or not, and the list moved
// past it, under the target's C ABI.
unsafe fn nextSlot(list: *mut u64, floating: bool, bytes: usize) -> *const u8 {
  unsafe {
    static if Target.arch() == Arch.X86_64 && Target.operatingSystem() != OperatingSystem.Windows {
      return systemVSlot(list, floating)
    }
    static if Target.arch() == Arch.Aarch64 && Target.operatingSystem() == OperatingSystem.Linux {
      return aapcsSlot(list, floating)
    }
    return stackSlot(list, bytes)
  }
}

// System V x86-64: `{gp_offset: u32, fp_offset: u32, overflow_arg_area, reg_save_area}`. The save
// area holds the six integer registers (48 bytes) and then the eight vector registers (16 bytes
// each, up to 176); an argument past them is in the next 8-byte stack slot.
unsafe fn systemVSlot(list: *mut u64, floating: bool) -> *const u8 {
  unsafe {
    let words = Pointer.assumeManyMut<u64>(list)
    let offsets = Pointer.assumeManyMut<u32>(Intrinsic.pointerReinterpret<*mut u64, *mut u32>(list))
    let saved = Pointer.read<[*]const u8>(Intrinsic.pointerReinterpret<*mut u64, *mut [*]const u8>(Pointer.atMut<u64>(words, 2)))
    if floating {
      let used = Pointer.read<u32>(Pointer.atMut<u32>(offsets, 1))
      if used <= 160 {
        Pointer.write<u32>(Pointer.atMut<u32>(offsets, 1), used + 16)
        return Pointer.at<u8>(saved, u32.toUsize(used))
      }
    } else {
      let used = Pointer.read<u32>(Pointer.atMut<u32>(offsets, 0))
      if used <= 40 {
        Pointer.write<u32>(Pointer.atMut<u32>(offsets, 0), used + 8)
        return Pointer.at<u8>(saved, u32.toUsize(used))
      }
    }
    return nextStackWord(Pointer.atMut<u64>(words, 1))
  }
}

// AAPCS ARM64 (Linux): `{stack, gr_top, vr_top, gr_offs: i32, vr_offs: i32}`. A negative offset
// counts back from the top of the general (8 bytes each) or vector (16 bytes each) save area; an
// offset that reaches zero moves on to the next 8-byte stack slot.
unsafe fn aapcsSlot(list: *mut u64, floating: bool) -> *const u8 {
  unsafe {
    let words = Pointer.assumeManyMut<u64>(list)
    let offsets = Pointer.assumeManyMut<i32>(Intrinsic.pointerReinterpret<*mut u64, *mut i32>(list))
    let mut index: usize = 6
    let mut top: usize = 1
    let mut size: i32 = 8
    if floating {
      index = 7
      top = 2
      size = 16
    }
    let offset = Pointer.read<i32>(Pointer.atMut<i32>(offsets, index))
    if offset < 0 {
      let next = offset + size
      Pointer.write<i32>(Pointer.atMut<i32>(offsets, index), next)
      if next <= 0 {
        let end = Pointer.read<[*]const u8>(Intrinsic.pointerReinterpret<*mut u64, *mut [*]const u8>(Pointer.atMut<u64>(words, top)))
        return Pointer.at<u8>(end, i32.wrappingToUsize(offset))
      }
    }
    return nextStackWord(Pointer.atMut<u64>(words, 0))
  }
}

// A `va_list` that is one pointer to the next argument (Darwin ARM64, Windows, WebAssembly): Darwin
// and Windows give every argument an 8-byte slot, and WebAssembly lays each argument out at its own
// size and alignment.
unsafe fn stackSlot(list: *mut u64, bytes: usize) -> *const u8 {
  unsafe {
    static if Target.arch() == Arch.Wasm32 || Target.arch() == Arch.Wasm64 {
      let cursor = Intrinsic.pointerReinterpret<*mut u64, *mut [*]const u8>(list)
      let current = Pointer.read<[*]const u8>(cursor)
      let address = Pointer.addressMany<u8>(current)
      let skip = (bytes - address % bytes) % bytes
      let at = Pointer.assumeMany<u8>(Pointer.at<u8>(current, skip))
      Pointer.write<[*]const u8>(cursor, Pointer.assumeMany<u8>(Pointer.at<u8>(at, bytes)))
      return Pointer.at<u8>(at, 0)
    }
    return nextStackWord(list)
  }
}

// The 8-byte stack slot that the pointer at `cursor` names, with the pointer moved past it.
unsafe fn nextStackWord(cursor: *mut u64) -> *const u8 {
  unsafe {
    let slot = Intrinsic.pointerReinterpret<*mut u64, *mut [*]const u8>(cursor)
    let current = Pointer.read<[*]const u8>(slot)
    Pointer.write<[*]const u8>(slot, Pointer.assumeMany<u8>(Pointer.at<u8>(current, 8)))
    return Pointer.at<u8>(current, 0)
  }
}
