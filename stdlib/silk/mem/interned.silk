//! Handles to values that never change and are never freed, so a handle is a plain pointer.
//!
//! # When to use
//! Use [`Interned`] for values that live as long as the program phase that makes them, such as the
//! hash-consed types of one compiler check. Copying a handle touches no memory, and a value can be
//! read from any thread once its handle is published.
//!
//! # Gotchas
//! The value is never dropped. Use `silk.mem.frozen.Frozen` for a value that should be freed.
//!
//! # Examples
//! ## Copy a handle and read through both
//! ```silk
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.core.effect { Effect }
//! import silk.mem.interned { Interned }
//!
//! pub effect fn main() -> i32
//!   ! OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let first = run Interned<i32>.make(40) |> Effect.provideMut<Allocator>(&mut allocator)
//!   let second = Interned<i32>.clone(&first)
//!   let sum = Interned<i32>.get(&first).* + Interned<i32>.get(&second).*
//!   if sum != 80 || !Interned<i32>.same(&first, &second) { return 1 }
//!   return 0
//! }
//! ```
//!
//! @category Memory

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.box { Box }
import silk.mem.pointer { Pointer }
import silk.num.usize
import silk.concurrency.thread {Transferable, Concurrent}

// Heap storage that owns itself, as in `silk.concurrency.sync`: `pin` moves the box into the value's
// own `root`, where it stays.
struct Unrooted {}
struct Root<T> { storage: Box<Pinned<T>> }
struct Pinned<T> {
  value: T,
  root: Unrooted | Root<T>,
}


effect<'env> fn pin<'env, T>(value: T) -> *mut Pinned<T> ! OutOfMemoryError ? &mut Allocator {
  let mut storage = run Box<Pinned<T>>.make(Pinned<T> { value: move value, root: Unrooted {} })
  let pinned = Pointer.fromMutRef(&mut storage.getMut()[0])
  let mut anchor = ()
  unsafe {
    let fresh = Pointer.borrowMut(&mut anchor, pinned)
    fresh.root = Root<T> { storage: move storage }
  }
  return pinned
}

// The caller proves `pinned` came from `pin`, is unpinned once, and that nothing uses it after.
unsafe fn unpin<T>(pinned: *mut Pinned<T>) -> () {
  let mut anchor = ()
  let held = unsafe Pointer.borrowMut(&mut anchor, pinned)
  let root = Intrinsic.replace(held.root, Unrooted {})
  match move root {
    Root<T> { storage } => release<T>(move storage)
    Unrooted _nothing => ()
  }
  return ()
}

fn release<T>(storage: Box<Pinned<T>>) -> () { return () }

/// A handle to one value of type `T` that never changes and is never freed.
pub struct Interned<T> {
  cell: *mut Pinned<T>,
}

// The pointee is fully constructed before publication, never mutated through this handle,
// and never dropped. Concurrent excludes thread-local mutable/refcounted descendants.
impl<T: Transferable + Concurrent> Transferable for Interned<T> {}
impl<T: Transferable + Concurrent> Concurrent for Interned<T> {}

impl<T> Interned<T> {
  /// Allocates storage that is never freed and moves `value` into it.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the storage. `value` is dropped.
  pub effect<'env> fn make<'env>(value: T) -> Interned<T> ! OutOfMemoryError ? &mut Allocator {
    let cell = run pin<T>(move value)
    return Interned<T> { cell: cell }
  }

  /// Frees a value that no other handle refers to, such as one made only to look up an equal value
  /// that already has a handle.
  ///
  /// # Safety
  ///
  /// `handle` is the only handle to its value: it was never cloned.
  pub unsafe fn discard(handle: Interned<T>) -> () {
    unsafe unpin<T>(handle.cell)
    return ()
  }

  /// Returns another handle to the same value. It copies one pointer.
  pub fn clone(self: &Self) -> Interned<T> {
    return Interned<T> { cell: self.cell }
  }

  /// Borrows the value for as long as this handle is borrowed.
  pub fn get<'a>(self: &'a Self) -> &'a T {
    let state = unsafe Pointer.borrow(self, self.cell)
    return &state.value
  }

  /// Calls `use` one time with a shared borrow of the value and returns the result of `use`.
  pub fn with<A>(self: &Self, use: once fn(&T) -> A) -> A {
    return use(Interned<T>.get(self))
  }

  /// The address of the value, which every handle to it shares.
  pub fn address(self: &Self) -> usize {
    return Pointer.address<Pinned<T>>(self.cell)
  }

  /// Whether both handles refer to the same value.
  pub fn same(left: &Self, right: &Self) -> bool {
    return Pointer.address<Pinned<T>>(left.cell) == Pointer.address<Pinned<T>>(right.cell)
  }
}
