//! One owned value on the heap, for recursive data and for values that must have a fixed-size
//! handle.
//!
//! # When to use
//! Use [`Box`] when a type must contain itself, such as a tree node that owns child nodes. A field
//! of type `Box<Node>` has a fixed size, so the compiler can lay out `Node`. Use [`make`] to
//! allocate, [`get`] or [`getMut`] to borrow the value, and [`into`] to get the value back.
//!
//! # Details
//! A box owns one allocation and one value. [`get`] and [`getMut`] return a slice of length 1,
//! because a Silk function cannot return a bare borrowed value. Dropping a box drops its value and
//! releases the allocation. [`into`] moves the value out and releases the allocation one time.
//!
//! # Gotchas
//! Dropping a chain of boxes uses one stack frame for each link. For a very long chain, take the
//! links apart with [`into`] in a loop.
//!
//! # Examples
//! ## Store and recover one owned value
//! ```silk
//! import silk.mem.box { Box }
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.core.effect { Effect }
//!
//! pub effect fn main() -> i32
//!   ! OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let mut boxed = run Box<i32>.make(40) |> Effect.provideMut<Allocator>(&mut allocator)
//!   let mut slot = Box<i32>.getMut(&mut boxed)
//!   slot[0] = slot[0] + 2
//!   drop slot
//!   let value = Box<i32>.into(move boxed)
//!   if value != 42 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Memory

// One owned heap indirection holding exactly one value. Ordinary Silk: no compiler phase knows
// this type, and every capability it uses is available to user code.
//
// A struct may reach itself through a Box because RawBuffer's representation is the same whatever
// it holds, so the holder's layout never needs the held type's layout. The same fact is why the
// Drop hook below has work to do: releasing a RawBuffer releases the block without descending into
// the element, so a box that did not drop its own element would abandon every level beneath it.
//
// The occupancy marker is what lets the hook and `into` agree. `into` hands the value out and
// marks the box vacant, so the hook that still runs when the emptied box leaves scope drops
// nothing, and the buffer releases exactly once either way. The marker is deliberately not generic
// over T: a `[T; 0]` anchor of the kind List uses would be an inline reach into T and would make
// a struct holding `Box` of itself recursive again.

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.allocator { OutOfMemoryError }
import silk.mem.layout { Layout }
import silk.core.ownership { Drop }
import silk.mem.raw_buffer { RawBuffer }
import silk.mem.slot { Slot }
import silk.num.usize

/// The state marker of a [`Box`] whose value [`into`] has moved out. User code does not use it.
pub struct Vacant {}

/// The state marker of a [`Box`] that owns its value. User code does not use it.
pub struct Occupied {}

/// An owner of one heap-allocated value of type `T`.
///
/// # When to use
///
/// Use a box when a type must contain itself, such as a tree node that owns child nodes. A field
/// of type `Box<Node>` has a fixed size, so the compiler can lay out `Node`. Use [`make`] to
/// allocate, [`get`] or [`getMut`] to borrow the value, and [`into`] to get the value back.
///
/// # Details
///
/// The size of `Box<T>` does not depend on `T`, so a type can contain a box of itself. Dropping a
/// box drops the value and then releases the allocation. A box is affine. It is not `Copy`.
///
/// # Gotchas
///
/// Dropping a chain of boxes uses one stack frame for each link. For a very long chain, take the
/// links apart with [`into`] in a loop.
pub struct Box<T> {
  buffer: Intrinsic.RawBuffer<T>,
  state: Vacant | Occupied,
}

impl<T> Box<T> {
  /// Allocates space for one `T`, moves `value` into it, and returns the box.
  ///
  /// # Details
  ///
  /// The allocation comes from the active `Allocator`. The box owns the value and the allocation.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the memory. No box is made, and `value`
  ///   is dropped.
  pub effect<'env> fn make<'env>(value: T) -> Box<T> ! OutOfMemoryError ? &mut Allocator {
    let layout = Layout.of<T>()
    let recipe = Allocator.allocate(move layout)
    let allocation = run recipe
    let buffer = freshBuffer<T>(move allocation)
    return Box<T> { buffer: writeFirst<T>(move buffer, move value), state: Occupied {} }
  }

  /// Returns a shared borrow of the value, as a slice of length 1.
  ///
  /// # Details
  ///
  /// Read the value as `slice[0]`. The slice borrows the box. The box cannot change or move while
  /// the slice is live.
  pub fn get(self: &Self) -> &[T] {
    // A live box is always occupied: `make` writes slot zero and only `into`, which consumes the
    // box, takes it.
    return unsafe RawBuffer.view<T>(&self.buffer, usize.ZERO, usize.ONE)
  }

  /// Returns an exclusive borrow of the value, as a slice of length 1.
  ///
  /// # Details
  ///
  /// Change the value through `slice[0]`. The slice borrows the box exclusively. No other use of
  /// the box is possible while the slice is live. Drop the slice to end the borrow early.
  pub fn getMut(self: &mut Self) -> &mut [T] {
    // A live box is always occupied, as in `get`.
    return unsafe RawBuffer.viewMut<T>(&mut self.buffer, usize.ZERO, usize.ONE)
  }

  /// Moves the value out of the box, releases the allocation, and returns the value.
  ///
  /// # When to use
  ///
  /// Use `into` when the caller needs the value itself, not a borrow. Use it in a loop to take
  /// apart a long chain of boxes without deep recursion. A plain drop of such a chain uses one
  /// stack frame for each link.
  pub fn into(self: Self) -> T {
    let mut owned = move self
    let state = Intrinsic.replace(owned.state, Vacant {})
    return match move state {
      Vacant nothing => absurd<T>()
      Occupied held => takeElement<T>(&mut owned.buffer)
    }
  }
}

// Diverges on the arms the surrounding logic has already proven impossible.
fn absurd<T>() -> T {
  return Intrinsic.trap("Box: an internal state the surrounding logic ruled out was reached")
}

fn freshBuffer<T>(allocation: Intrinsic.Allocation) -> Intrinsic.RawBuffer<T> {
  unsafe {
    let made = RawBuffer.from<T>(move allocation, usize.ONE)
    return move made
  }
  return absurd<Intrinsic.RawBuffer<T>>()
}

fn writeFirst<T>(buffer: Intrinsic.RawBuffer<T>, value: T) -> Intrinsic.RawBuffer<T> {
  unsafe {
    let mut owned = move buffer
    let selected = RawBuffer.slot<T>(&mut owned, usize.ZERO)
    let written = Slot.write<T>(move selected, move value)
    return move owned
  }
  return absurd<Intrinsic.RawBuffer<T>>()
}

// The held value is borrowed as a one-element view rather than as a bare reference: a function
// may return a lexical slice borrowed from one parameter, and no Silk function may return `&T`.

// Marking the box vacant first is what keeps the value from being dropped twice: the box still
// runs its hook when this scope ends, and by then it holds nothing to drop.

fn takeElement<T>(buffer: &mut Intrinsic.RawBuffer<T>) -> T {
  unsafe {
    let selected = RawBuffer.slot<T>(move buffer, usize.ZERO)
    return Slot.take<T>(move selected)
  }
  return absurd<T>()
}

// The hook drops the element only. The buffer belongs to the field cleanup the plan runs straight
// after this returns, so the storage releases exactly once whichever way the box was emptied.
impl<T> Drop for Box<T> {
  fn drop(self: &mut Box<T>) -> () {
    let state = Intrinsic.replace(self.state, Vacant {})
    return match move state {
      Vacant nothing => ()
      Occupied held => dropElement<T>(&mut self.buffer)
    }
  }
}

fn dropElement<T>(buffer: &mut Intrinsic.RawBuffer<T>) -> () {
  unsafe {
    let selected = RawBuffer.slot<T>(move buffer, usize.ZERO)
    let cleared = Slot.dropValue<T>(move selected)
  }
  return ()
}
