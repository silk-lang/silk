//! Actors: a machine that performs the effects its transitions queue.
//!
//! A transition never does work. It queues effects as values, and an actor hands each one to a
//! performer, in the order they were queued. The performer is an effect function of the program,
//! so its requirement row names every service the machine's effects use. It can send events back
//! with [`Reply.send`], for example the result of a request.
//!
//! [`Actors`] keeps the snapshot in memory. [`Durable`] has the same functions and saves the
//! snapshot after every change.
//!
//! @category State machines

import silk.machine.chart { Machine }
import silk.machine.snapshot { Snapshot, Status, Steps, TransitionLoopError }
import silk.collections.list { List }
import silk.concurrency.channel { Receiver, Sender }
import silk.concurrency.fiber { Fiber }
import silk.concurrency.scheduler { Scheduler, TaskIdExhaustedError }
import silk.core.option { Option }
import silk.num.i64
import silk.num.u32
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.monotonic_clock { MonotonicClock }
import silk.system.system_clock { SystemClock }

/// Events a performer sends back to its own actor.
pub struct Reply<E> {
  events: List<E>,
}

impl<E> Reply<E> {
  /// Returns a reply without events.
  pub fn make() -> Reply<E> {
    return Reply<E> { events: List<E>.make() }
  }

  /// Returns the events sent so far and consumes the reply.
  pub fn take(self: Self) -> List<E> {
    return move self.events
  }

  /// Puts `event` at the end of the actor's mailbox.
  pub effect fn send(self: &mut Self, event: E) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run List<E>.append(&mut self.events, move event)
    return ()
  }
}

/// What a running actor receives on its channel.
pub union Signal<E> {
  /// An event for the machine.
  Event { pub event: E },
  /// A timer may be due. The actor sends this to itself.
  Tick,
  /// Stops the actor. Its snapshot keeps the state it had.
  Stop,
}

// Waits, then tells the actor that a timer may be due.
effect fn alarm<E>(sender: Sender<Signal<E>>, nanoseconds: u64) -> ()
  ? &mut MonotonicClock {
  run MonotonicClock.waitFor(nanoseconds)
  drop run sender.send(Signal<E>.Tick)
  drop sender
  return ()
}

effect fn wallClock() -> u64
  ? &mut SystemClock {
  let now = run SystemClock.now()
  let seconds = now.unixSeconds()
  if seconds < 0 {
    return 0
  }
  return i64.toU64(seconds) * 1s + u32.toU64(now.subsecondNanoseconds())
}

pub struct Actors {}

impl Actors {
  /// Performs every queued effect and processes every event in the mailbox, until both are empty.
  ///
  /// # Details
  /// Effects run one at a time, in the order they were queued, and before the next event of the
  /// mailbox is processed. An effect leaves the snapshot before it is performed, so a failure of
  /// the performer does not perform it a second time.
  pub effect fn settle<'env, S: Machine<E, C, X>, E, C, X, F, ? R>(
    snapshot: &mut Snapshot<S, E, C, X>,
    perform: effect fn<'env>(X, &mut Reply<E>) -> () ! F ? R,
  ) -> ()
    ! F | OutOfMemoryError | TransitionLoopError
    ? R | &mut Allocator {
    return run Durable.settle(&mut snapshot.*, perform, unsaved)
  }

  /// Processes `event`, then settles the actor with [`settle`].
  pub effect fn send<'env, S: Machine<E, C, X>, E, C, X, F, ? R>(
    snapshot: &mut Snapshot<S, E, C, X>,
    event: E,
    perform: effect fn<'env>(X, &mut Reply<E>) -> () ! F ? R,
  ) -> ()
    ! F | OutOfMemoryError | TransitionLoopError
    ? R | &mut Allocator {
    return run Durable.send(&mut snapshot.*, move event, perform, unsaved)
  }

  /// Moves the actor's clock to `now`, in nanoseconds of wall clock time, takes the delayed
  /// transitions that are due, then settles the actor with [`settle`].
  pub effect fn advance<'env, S: Machine<E, C, X>, E, C, X, F, ? R>(
    snapshot: &mut Snapshot<S, E, C, X>,
    now: u64,
    perform: effect fn<'env>(X, &mut Reply<E>) -> () ! F ? R,
  ) -> ()
    ! F | OutOfMemoryError | TransitionLoopError
    ? R | &mut Allocator {
    return run Durable.advance(&mut snapshot.*, now, perform, unsaved)
  }

  /// Runs the actor on events from `inbox` until the machine finishes or the channel closes.
  ///
  /// # Details
  /// The actor settles first, so effects left in a restored snapshot are performed before the
  /// first event. Fork this effect as a fiber to run the actor beside other work.
  ///
  /// # Gotchas
  /// It does not take delayed transitions. Use [`drive`] for a machine that has them.
  pub effect fn serve<'env, S: Machine<E, C, X>, E, C, X, F, ? R>(
    snapshot: &mut Snapshot<S, E, C, X>,
    inbox: &Receiver<E>,
    perform: effect fn<'env>(X, &mut Reply<E>) -> () ! F ? R,
  ) -> ()
    ! F | OutOfMemoryError | TransitionLoopError
    ? R | &mut Allocator {
    return run Durable.serve(&mut snapshot.*, inbox, perform, unsaved)
  }

  /// Runs the actor with its timers until the machine finishes, a `Signal.Stop` arrives, or the
  /// channel closes.
  ///
  /// # Details
  /// The actor reads the wall clock from `SystemClock` before each signal and takes the delayed
  /// transitions that are due. While it waits, a child fiber sleeps until the next deadline and
  /// then sends `Signal.Tick` through `sender`, so a delayed transition is taken on time without
  /// another event. `sender` must send to the channel of `inbox`.
  ///
  /// # Gotchas
  /// The actor holds a `Sender`, so its channel does not close when the other senders are
  /// dropped. Send `Signal.Stop` to end an actor whose machine has no final state.
  pub effect fn drive<'env, S: Machine<E, C, X>, E: 'static, C, X, F, ? R>(
    snapshot: &mut Snapshot<S, E, C, X>,
    sender: &Sender<Signal<E>>,
    inbox: &Receiver<Signal<E>>,
    perform: effect fn<'env>(X, &mut Reply<E>) -> () ! F ? R,
  ) -> ()
    ! F | OutOfMemoryError | TransitionLoopError | TaskIdExhaustedError
    ? R | &mut Allocator | &mut Scheduler | &mut SystemClock {
    return run Durable.drive(&mut snapshot.*, sender, inbox, perform, unsaved)
  }
}

// The `save` of an actor that is not durable.
effect fn unsaved<S, E, C, X>(snapshot: &Snapshot<S, E, C, X>) -> () {
  return ()
}

/// Actors that save their snapshot after every change, so a program that stops can start again
/// from the last save.
///
/// # When to use
/// Use `Durable` in place of [`Actors`] for a machine that must survive a restart: a workflow, an
/// order, a session. Each function takes one more argument, `save`, an effect function that
/// stores the snapshot, for example as JSON in a file or a database row. To start again, decode
/// the stored snapshot and pass it to [`Durable.drive`] or [`Durable.serve`], which first perform
/// the effects that were still queued.
///
/// # Gotchas
/// An effect is performed at least one time, not exactly one time: when the program stops while
/// the performer runs, the effect is performed again after the restart. Make effects safe to
/// repeat. An event that was received and not yet saved is lost with the program.
pub struct Durable {}

impl Durable {
  /// Performs every queued effect and processes every event in the mailbox, until both are
  /// empty, and saves the snapshot after each of them.
  ///
  /// # Details
  /// `save` gets the snapshot after each event is processed, with the effects that step queued,
  /// and again after each effect is performed, with the events the performer sent back. A
  /// program that stops between two saves starts again from the last one: an effect that was
  /// being performed is still queued there and is performed again.
  pub effect fn settle<'env, S: Machine<E, C, X>, E, C, X, F, G, ? R, ? Q>(
    snapshot: &mut Snapshot<S, E, C, X>,
    perform: effect fn<'env>(X, &mut Reply<E>) -> () ! F ? R,
    save: effect fn<'env>(&Snapshot<S, E, C, X>) -> () ! G ? Q,
  ) -> ()
    ! F | G | OutOfMemoryError | TransitionLoopError
    ? R | Q | &mut Allocator {
    while true {
      if snapshot.pending.length() != 0 {
        let queued = List<X>.remove(&mut snapshot.pending, 0)
        let mut reply = Reply<E> { events: List<E>.make() }
        run perform(move queued, &mut reply)
        while reply.events.length() != 0 {
          run List<E>.append(&mut snapshot.mailbox, List<E>.remove(&mut reply.events, 0))
        }
        run save(&snapshot.*)
        continue
      }
      if snapshot.mailbox.length() == 0 {
        break
      }
      let event = List<E>.remove(&mut snapshot.mailbox, 0)
      drop run Steps.send<S, E, C, X>(&mut snapshot.*, move event)
      run save(&snapshot.*)
    }
    return ()
  }

  /// Processes `event`, then settles the actor with [`Durable.settle`].
  pub effect fn send<'env, S: Machine<E, C, X>, E, C, X, F, G, ? R, ? Q>(
    snapshot: &mut Snapshot<S, E, C, X>,
    event: E,
    perform: effect fn<'env>(X, &mut Reply<E>) -> () ! F ? R,
    save: effect fn<'env>(&Snapshot<S, E, C, X>) -> () ! G ? Q,
  ) -> ()
    ! F | G | OutOfMemoryError | TransitionLoopError
    ? R | Q | &mut Allocator {
    run List<E>.append(&mut snapshot.mailbox, move event)
    run Durable.settle<S, E, C, X, F, G, R, Q>(&mut snapshot.*, perform, save)
    return ()
  }

  /// Moves the actor's clock to `now`, in nanoseconds of wall clock time, takes the delayed
  /// transitions that are due, saves the snapshot when one was taken, then settles the actor
  /// with [`Durable.settle`].
  pub effect fn advance<'env, S: Machine<E, C, X>, E, C, X, F, G, ? R, ? Q>(
    snapshot: &mut Snapshot<S, E, C, X>,
    now: u64,
    perform: effect fn<'env>(X, &mut Reply<E>) -> () ! F ? R,
    save: effect fn<'env>(&Snapshot<S, E, C, X>) -> () ! G ? Q,
  ) -> ()
    ! F | G | OutOfMemoryError | TransitionLoopError
    ? R | Q | &mut Allocator {
    if run Steps.advance<S, E, C, X>(&mut snapshot.*, now) {
      run save(&snapshot.*)
    }
    run Durable.settle<S, E, C, X, F, G, R, Q>(&mut snapshot.*, perform, save)
    return ()
  }

  /// Runs the actor on events from `inbox` until the machine finishes or the channel closes.
  ///
  /// # Details
  /// The actor settles first, so effects left in a restored snapshot are performed before the
  /// first event. Fork this effect as a fiber to run the actor beside other work.
  ///
  /// # Gotchas
  /// It does not take delayed transitions. Use [`Durable.drive`] for a machine that has them.
  pub effect fn serve<'env, S: Machine<E, C, X>, E, C, X, F, G, ? R, ? Q>(
    snapshot: &mut Snapshot<S, E, C, X>,
    inbox: &Receiver<E>,
    perform: effect fn<'env>(X, &mut Reply<E>) -> () ! F ? R,
    save: effect fn<'env>(&Snapshot<S, E, C, X>) -> () ! G ? Q,
  ) -> ()
    ! F | G | OutOfMemoryError | TransitionLoopError
    ? R | Q | &mut Allocator {
    run Durable.settle<S, E, C, X, F, G, R, Q>(&mut snapshot.*, perform, save)
    while true {
      match &snapshot.status {
        Status.Active => {}
        _ => {
          break
        }
      }
      match run inbox.receive() {
        Option<E>.Some { value } => {
          run Durable.send<S, E, C, X, F, G, R, Q>(&mut snapshot.*, move value, perform, save)
        }
        Option<E>.None => {
          break
        }
      }
    }
    return ()
  }

  /// Runs the actor with its timers until the machine finishes, a `Signal.Stop` arrives, or the
  /// channel closes, saving the snapshot after each change.
  ///
  /// # Details
  /// The actor reads the wall clock from `SystemClock` before each signal and takes the delayed
  /// transitions that are due. While it waits, a child fiber sleeps until the next deadline and
  /// then sends `Signal.Tick` through `sender`, so a delayed transition is taken on time without
  /// another event. `sender` must send to the channel of `inbox`.
  ///
  /// # Gotchas
  /// The actor holds a `Sender`, so its channel does not close when the other senders are
  /// dropped. Send `Signal.Stop` to end an actor whose machine has no final state.
  pub effect fn drive<'env, S: Machine<E, C, X>, E: 'static, C, X, F, G, ? R, ? Q>(
    snapshot: &mut Snapshot<S, E, C, X>,
    sender: &Sender<Signal<E>>,
    inbox: &Receiver<Signal<E>>,
    perform: effect fn<'env>(X, &mut Reply<E>) -> () ! F ? R,
    save: effect fn<'env>(&Snapshot<S, E, C, X>) -> () ! G ? Q,
  ) -> ()
    ! F | G | OutOfMemoryError | TransitionLoopError | TaskIdExhaustedError
    ? R | Q | &mut Allocator | &mut Scheduler | &mut SystemClock {
    // The deadline the sleeping child fiber was started for, or 0 when none is expected.
    let mut armed: u64 = 0
    while true {
      let now = run wallClock()
      run Durable.advance<S, E, C, X, F, G, R, Q>(&mut snapshot.*, now, perform, save)
      match &snapshot.status {
        Status.Active => {}
        _ => {
          break
        }
      }
      match Steps.nextDeadline<S, E, C, X>(&snapshot.*) {
        Option<u64>.Some { value: deadline } => {
          if armed == 0 || deadline < armed {
            let mut wait: u64 = 0
            if deadline > now {
              wait = deadline - now
            }
            drop run Fiber<(), never>.forkChild(alarm<E>(run sender.clone(), wait))
            armed = deadline
          }
        }
        Option<u64>.None => {}
      }
      match run inbox.receive() {
        Option<Signal<E>>.Some { value } => {
          match move value {
            Signal<E>.Event { event } => {
              run Durable.send<S, E, C, X, F, G, R, Q>(&mut snapshot.*, move event, perform, save)
            }
            Signal<E>.Tick => {
              armed = 0
            }
            Signal<E>.Stop => {
              snapshot.status = Status.Stopped
              run save(&snapshot.*)
              break
            }
          }
        }
        Option<Signal<E>>.None => {
          break
        }
      }
    }
    return ()
  }
}
