//! Promises a machine keeps on every path, written once with their reason: [`Rules`].
//!
//! # When to use
//! Use this module for a promise that covers many rows of a chart, such as "reading never
//! writes a file". Write the promise as a rule, walk the machine with the
//! `silk.machine.explore` module, and let [`Rules.broken`] find every run that breaks it. A
//! test then fails with the reason of the rule, whatever row caused it.
//!
//! # Details
//! A rule is about one event and one effect. It is checked on each run of the event: the step
//! that takes the event and the steps of the answers of the world that follow it, see
//! `Walk.runs`. Two effects are the same when `Values.write` writes them as the same text.
//!
//! @category State machines

import silk.collections.list { List }
import silk.core.reflect { Reflect }
import silk.core.static_sequence { StaticSequence }
import silk.machine.chart { Guard, Guards, Machine }
import silk.machine.definition { Values }
import silk.machine.explore { Run, Walk }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }

const NEVER: u8 = 0

const ALWAYS: u8 = 1

/// One promise of a [`Rules`] table.
pub struct Rule<X> {
  kind: u8,
  /// The name of the event the rule is about, or an empty string for every event.
  pub event: string<'static>,
  guard: Intrinsic.StaticSequence<Guard>,
  left: Intrinsic.StaticSequence<X>,
  /// Why the promise holds, in words. A broken rule is reported with it.
  pub reason: string<'static>,
}

/// A run that breaks a rule.
pub struct Broken {
  /// The reason of the rule.
  pub reason: string<'static>,
  /// The position of the run in the list given to [`Rules.broken`].
  pub position: usize,
}

/// A static table of promises about the effects of a machine with the events `E`, the context
/// `C` and the effects `X`.
///
/// # When to use
/// Build one in a static function with [`Rules.of`] and the builders, as a chart is built:
/// `Rules<Typed, Disk, Mark>.of() |> Rules.never("Read", writes, "reading never writes")`.
/// Check it with [`Rules.broken`].
pub struct Rules<E, C, X> {
  pub items: Intrinsic.StaticSequence<Rule<X>>,
}

impl<E, C, X> Rules<E, C, X> {
  /// Returns a table without rules.
  pub static fn of() -> Rules<E, C, X> {
    return Rules<E, C, X> { items: StaticSequence.empty<Rule<X>>() }
  }

  /// Adds the promise that no run of `event` leaves `effect_`, for the reason `reason`.
  pub static fn never(
    rules: Rules<E, C, X>,
    event: Intrinsic.VariantName<E>,
    effect_: X,
    reason: string<'static>,
  ) -> Rules<E, C, X> {
    return Rules.add(
      rules,
      NEVER,
      Reflect.variantNameText<E>(event),
      StaticSequence.empty<Guard>(),
      effect_,
      reason,
    )
  }

  /// Adds the promise that no run of `event` leaves `effect_` when `guard` holds, for the
  /// reason `reason`. `guard` is a function `fn(&C, &E) -> bool` or a `Guard`. It sees the
  /// context as it was before the event, and the event.
  pub static fn neverWhen<G>(
    rules: Rules<E, C, X>,
    event: Intrinsic.VariantName<E>,
    guard: G,
    effect_: X,
    reason: string<'static>,
  ) -> Rules<E, C, X> {
    return Rules.add(
      rules,
      NEVER,
      Reflect.variantNameText<E>(event),
      StaticSequence.append<Guard>(StaticSequence.empty<Guard>(), Guards.from<G>(guard)),
      effect_,
      reason,
    )
  }

  /// Adds the promise that no run of any event leaves `effect_`, for the reason `reason`.
  pub static fn neverAny(
    rules: Rules<E, C, X>,
    effect_: X,
    reason: string<'static>,
  ) -> Rules<E, C, X> {
    return Rules.add(rules, NEVER, "", StaticSequence.empty<Guard>(), effect_, reason)
  }

  /// Adds the promise that every run of `event` leaves `effect_`, for the reason `reason`.
  pub static fn always(
    rules: Rules<E, C, X>,
    event: Intrinsic.VariantName<E>,
    effect_: X,
    reason: string<'static>,
  ) -> Rules<E, C, X> {
    return Rules.add(
      rules,
      ALWAYS,
      Reflect.variantNameText<E>(event),
      StaticSequence.empty<Guard>(),
      effect_,
      reason,
    )
  }

  /// Adds the promise that every run of `event` leaves `effect_` when `guard` holds, for the
  /// reason `reason`. `guard` is a function `fn(&C, &E) -> bool` or a `Guard`. It sees the
  /// context as it was before the event, and the event.
  pub static fn alwaysWhen<G>(
    rules: Rules<E, C, X>,
    event: Intrinsic.VariantName<E>,
    guard: G,
    effect_: X,
    reason: string<'static>,
  ) -> Rules<E, C, X> {
    return Rules.add(
      rules,
      ALWAYS,
      Reflect.variantNameText<E>(event),
      StaticSequence.append<Guard>(StaticSequence.empty<Guard>(), Guards.from<G>(guard)),
      effect_,
      reason,
    )
  }

  static fn add(
    rules: Rules<E, C, X>,
    kind: u8,
    event: string<'static>,
    guard: Intrinsic.StaticSequence<Guard>,
    effect_: X,
    reason: string<'static>,
  ) -> Rules<E, C, X> {
    if reason == "" {
      compileError("a rule needs its reason")
    }
    let mut changed = rules
    changed.items = StaticSequence.append<Rule<X>>(
      rules.items,
      Rule<X> {
        kind: kind,
        event: event,
        guard: guard,
        left: StaticSequence.append<X>(StaticSequence.empty<X>(), effect_),
        reason: reason,
      },
    )
    return changed
  }

  /// Appends to `reasons` the reason of each rule of `rules` that is about `event` and whose
  /// guard holds for `context` and `event`, in the order of the table.
  pub effect fn applying(
    static rules: Rules<E, C, X>,
    context: &C,
    event: &E,
    reasons: &mut List<string<'static>>,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    static for rule in rules.items {
      if Rules.applies(rule, context, event) {
        run List<string<'static>>.append(&mut reasons.*, rule.reason)
      }
    }
    return ()
  }

  // Whether `rule` is about `event` and its guard holds.
  fn applies(static rule: Rule<X>, context: &C, event: &E) -> bool {
    let mut named = false
    static if rule.event == "" {
      named = true
    } else {
      static for on in Reflect.variants<E>() {
        static if rule.event == Reflect.variantLabel(on) {
          if Reflect.isVariant(event, on) {
            named = true
          }
        }
      }
    }
    if !named {
      return false
    }
    static for guard in rule.guard {
      return Guards.holds<C, E>(guard, context, event)
    }
    return true
  }

  /// Returns the runs of `runs` that break a rule of `rules`, each with the reason of the
  /// rule it breaks.
  ///
  /// # Details
  /// `walk` is the walk the runs come from, see `Walk.runs`, and `events` the list of events
  /// the walk was made with. A rule is checked on a run when it is about the event of the
  /// first step of the run and its guard holds for the context the run starts from.
  pub effect fn broken<S: Machine<E, C, X>>(
    static rules: Rules<E, C, X>,
    walk: &Walk<S, E, C, X>,
    runs: &[Run],
    events: &[E],
  ) -> List<Broken>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut found = List<Broken>.make()
    let nodes = walk.nodes.asSlice()
    let steps = walk.steps.asSlice()
    let mut index: usize = 0
    while index < runs.length {
      let first = &steps[runs[index].steps.asSlice()[0]]
      let context = &nodes[first.from].snapshot.context
      let event = &events[first.event]
      static for rule in rules.items {
        if Rules.applies(rule, context, event) {
          let mut wanted = String.make()
          static for value in rule.left {
            let effect_: X = value
            run Values.write<X>(&effect_, &mut wanted)
          }
          let mut left = false
          let taken = runs[index].steps.asSlice()
          let mut position: usize = 0
          while position < taken.length {
            let effects = steps[taken[position]].effects.asSlice()
            let mut at: usize = 0
            while at < effects.length {
              let mut text = String.make()
              run Values.write<X>(&effects[at], &mut text)
              if text.view() == wanted.view() {
                left = true
              }
              at = at + 1
            }
            position = position + 1
          }
          static if rule.kind == NEVER {
            if left {
              run List<Broken>.append(&mut found, Broken { reason: rule.reason, position: index })
            }
          } else {
            if !left {
              run List<Broken>.append(&mut found, Broken { reason: rule.reason, position: index })
            }
          }
        }
      }
      index = index + 1
    }
    return move found
  }
}
