//! Child machines: a machine that a parent starts, sends events to and stops.
//!
//! # When to use
//! Put a [`Child`] in the parent's context for each machine the parent owns. Start it in the
//! parent's `enter`, stop it in `exit` to tie it to a state as xstate's `invoke` does, or start
//! and stop it in `handle` to tie it to the parent as `spawn` does.
//!
//! # Details
//! A child is a `Snapshot` inside the parent's context, so the parent's snapshot holds its
//! children and they are saved and restored with it. A child takes its steps inside the parent's
//! step, in the order the parent calls it, so the whole tree stays deterministic.
//!
//! A child queues effects of its own type. [`Child.drain`] moves them into the parent's queue,
//! wrapped in a variant of the parent's effect type, and the parent's performer hands them to the
//! child's performer. [`Replies.forward`] wraps the events that performer sends back, so they
//! reach the parent, which passes them to the child with [`Child.send`].
//!
//! A child's delayed transitions use the parent's clock. Start the child with `enq.clock`,
//! return [`Child.nextDeadline`] from the parent's `Machine.deadline`, and call
//! [`Child.advance`] and [`Child.drain`] in the parent's `Machine.tick`. The parent's snapshot
//! then reports the child's deadline as its own, and an actor wakes up for it.
//!
//! @category State machines

import silk.machine.actor { Reply }
import silk.machine.chart { Enqueue, Machine }
import silk.machine.snapshot { Snapshot, Status, Steps, TransitionLoopError }
import silk.collections.list { List }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.schema.schema { Schema }

/// A child machine of states `S`, events `E`, context `C` and effects `X`. It is absent until
/// it is started and after it is stopped.
pub struct Child<S, E, C, X> {
  pub snapshot: Option<Snapshot<S, E, C, X>>,
}

impl<S: Schema, E: Schema, C: Schema, X: Schema> Schema for Child<S, E, C, X> {}

impl<S: Machine<E, C, X>, E, C, X> Child<S, E, C, X> {
  /// Returns a child that is not started.
  pub fn absent() -> Child<S, E, C, X> {
    return Child<S, E, C, X> { snapshot: Option<Snapshot<S, E, C, X>>.None }
  }

  /// Starts the child with `context` at the wall clock time `now`, in nanoseconds. A child that
  /// was running is replaced.
  pub effect fn start(self: &mut Self, context: C, now: u64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let begun = run Effect.result(Steps.begin<S, E, C, X>(move context, now))
    match move begun {
      Result<Snapshot<S, E, C, X>, OutOfMemoryError | TransitionLoopError>.Success { value } => {
        self.snapshot = Option<Snapshot<S, E, C, X>>.Some { value: move value }
      }
      Result<Snapshot<S, E, C, X>, OutOfMemoryError | TransitionLoopError>.Failure { error } => {
        self.snapshot = Option<Snapshot<S, E, C, X>>.None
        match move error {
          OutOfMemoryError { .. } => {
            fail OutOfMemoryError {}
          }
          TransitionLoopError { .. } => {}
        }
      }
    }
    return ()
  }

  /// Stops the child and drops its state.
  pub fn stop(self: &mut Self) -> () {
    self.snapshot = Option<Snapshot<S, E, C, X>>.None
    return ()
  }

  /// Returns whether the child is started and can still take events.
  pub fn isActive(self: &Self) -> bool {
    return match &self.snapshot {
      Option<Snapshot<S, E, C, X>>.Some { value } => match &value.status {
        Status.Active => true
        _ => false
      }
      Option<Snapshot<S, E, C, X>>.None => false
    }
  }

  /// Returns whether the child reached a final state.
  pub fn isDone(self: &Self) -> bool {
    return match &self.snapshot {
      Option<Snapshot<S, E, C, X>>.Some { value } => match &value.status {
        Status.Done => true
        _ => false
      }
      Option<Snapshot<S, E, C, X>>.None => false
    }
  }

  /// Sends `event` to the child and returns whether one of its states handled it. A child that
  /// is absent or finished handles nothing. A child stuck in eventless transitions is marked
  /// `Status.Failed`.
  pub effect fn send(self: &mut Self, event: E) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    match &mut self.snapshot {
      Option<Snapshot<S, E, C, X>>.Some { value } => {
        let sent = run Effect.result(Steps.send<S, E, C, X>(&mut value, move event))
        match move sent {
          Result<bool, OutOfMemoryError | TransitionLoopError>.Success { value: handled } => {
            return handled
          }
          Result<bool, OutOfMemoryError | TransitionLoopError>.Failure { error } => {
            match move error {
              OutOfMemoryError { .. } => {
                fail OutOfMemoryError {}
              }
              TransitionLoopError { .. } => {
                value.status = Status.Failed
              }
            }
          }
        }
      }
      Option<Snapshot<S, E, C, X>>.None => {
        drop event
      }
    }
    return false
  }

  /// Moves the child's clock to `now` and takes its delayed transitions that are due. Returns
  /// whether one was taken.
  pub effect fn advance(self: &mut Self, now: u64) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    match &mut self.snapshot {
      Option<Snapshot<S, E, C, X>>.Some { value } => {
        let advanced = run Effect.result(Steps.advance<S, E, C, X>(&mut value, now))
        match move advanced {
          Result<bool, OutOfMemoryError | TransitionLoopError>.Success { value: taken } => {
            return taken
          }
          Result<bool, OutOfMemoryError | TransitionLoopError>.Failure { error } => {
            match move error {
              OutOfMemoryError { .. } => {
                fail OutOfMemoryError {}
              }
              TransitionLoopError { .. } => {
                value.status = Status.Failed
              }
            }
          }
        }
      }
      Option<Snapshot<S, E, C, X>>.None => {}
    }
    return false
  }

  /// Returns the deadline of the child's timer that fires first, in nanoseconds of wall clock
  /// time. Return it from the parent's `Machine.deadline`, and call [`Child.advance`] in the
  /// parent's `Machine.tick`, so the parent's actor wakes up for the child's delayed transitions.
  pub fn nextDeadline(self: &Self) -> Option<u64> {
    return match &self.snapshot {
      Option<Snapshot<S, E, C, X>>.Some { value } => match &value.status {
        Status.Active => Steps.nextDeadline<S, E, C, X>(&value)
        _ => Option<u64>.None
      }
      Option<Snapshot<S, E, C, X>>.None => Option<u64>.None
    }
  }

  /// Moves the effects the child queued into the parent's queue, each wrapped by `wrap`.
  pub effect fn drain<PE, PX>(
    self: &mut Self,
    enq: &mut Enqueue<PE, PX>,
    wrap: fn<'static>(X) -> PX,
  ) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    match &mut self.snapshot {
      Option<Snapshot<S, E, C, X>>.Some { value } => {
        while value.pending.length() != 0 {
          run enq.perform(wrap(List<X>.remove(&mut value.pending, 0)))
        }
      }
      Option<Snapshot<S, E, C, X>>.None => {}
    }
    return ()
  }
}

pub struct Replies {}

impl Replies {
  /// Returns an empty reply for a child's performer to fill.
  pub fn make<E>() -> Reply<E> {
    return Reply<E>.make()
  }

  /// Moves the events a child's performer sent into the parent's reply, each wrapped by `wrap`.
  pub effect fn forward<E, PE>(from: Reply<E>, to: &mut Reply<PE>, wrap: fn<'static>(E) -> PE) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut events = from.take()
    while events.length() != 0 {
      run to.send(wrap(List<E>.remove(&mut events, 0)))
    }
    return ()
  }
}
