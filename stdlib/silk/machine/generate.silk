//! Silk source from a `Definition`: the transition table of each chart as a static function.
//!
//! # Details
//! The program owns its types: the state union, the event union, the context and the effects,
//! with the names `<Name>`, `<Name>Event`, `<Name>Context` and `<Name>Effect`, and one state
//! union per region chart, named after the chart. It also owns the guard functions, named
//! `guard<State><Event>` for a transition on an event and `when<State>` for an eventless one.
//! In the chart of a region the chart's name comes first: `guard<Chart><State><Event>` and
//! `when<Chart><State>`. The generated module imports all of them from the module passed as
//! `types` and declares one `pub static fn <chart>Chart()` per chart, which the program returns
//! from `Machine.chart` of that chart's state union.
//!
//! The initial state and the target of a transition are written as values, such as
//! `Editor.Open { bold: Bold.Off, italic: Italic.Plain }`: the state, with each region at the
//! initial state of its chart. A state that holds data of its own cannot be generated, because
//! a definition does not have that data.
//!
//! A state with a history gets a `Chart.history` or `Chart.shallowHistory` row that names a
//! field of the context, a `History` of the chart's state union, and a transition to the
//! history is written with `Chart.resume`.
//!
//! Every state, event and region field name in the definition is checked against the unions
//! when the generated module is compiled, so a definition that names a state the program does
//! not have fails there.
//!
//! # Gotchas
//! Several guarded transitions of one state on one event share one guard function name. Give
//! them one function, or edit the definition so that they differ.
//!
//! @category State machines

import silk.machine.definition {
  ChartDefinition,
  Definition,
  Definitions,
  Durations,
  RememberDefinition,
  StateDefinition
}
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.io.writer { Writer, WriterError }
import silk.num.u64
import silk.text.string { String }

pub struct Generate {}

impl Generate {
  /// Writes the Silk module for `definition`. `types` is the module path that declares the
  /// program's types and guard functions, for example `"light"`.
  pub effect fn write(definition: &Definition, types: string) -> ()
    ! WriterError
    ? &mut Writer {
    let name = definition.name.view()
    let charts = definition.charts.asSlice()
    run put("//! Generated from the definition of ")
    run put(name)
    run put(". Do not edit: change the definition and generate again.\n\n")
    run put("import silk.machine.chart { Chart }\nimport ")
    run put(types)
    run put(" { ")
    run put(name)
    run put(", ")
    run put(name)
    run put("Context, ")
    run put(name)
    run put("Effect, ")
    run put(name)
    run put("Event")
    let mut position: usize = 0
    while position < charts.length {
      let chart = &charts[position]
      if chart.name.view() != name {
        run put(", ")
        run put(chart.name.view())
      }
      let states = chart.states.asSlice()
      let mut index: usize = 0
      while index < states.length {
        run guardImports(prefix(chart, name), states, index)
        index = index + 1
      }
      position = position + 1
    }
    run put(" }\n")
    position = 0
    while position < charts.length {
      run function(definition, &charts[position], name)
      position = position + 1
    }
    return ()
  }
}

// What comes before the state in a guard name: nothing in the machine's own chart, the chart's
// name in the chart of a region.
fn prefix<'a>(chart: &'a ChartDefinition, machine: string) -> string<'a> {
  if chart.name.view() == machine {
    return ""
  }
  return chart.name.view()
}

effect fn function(definition: &Definition, chart: &ChartDefinition, machine: string) -> ()
  ! WriterError
  ? &mut Writer {
  let states = chart.states.asSlice()
  run put("\npub static fn ")
  run lowerFirst(chart.name.view())
  run put("Chart() -> ")
  run chartType(chart.name.view(), machine)
  run put(" {\n  return ")
  run chartType(chart.name.view(), machine)
  run put(".of()\n    |> Chart.initial(")
  run value(definition, chart, chart.initial.view(), 0)
  run put(")\n")
  let mut index: usize = 0
  while index < states.length {
    run regionRows(states, index)
    index = index + 1
  }
  index = 0
  while index < states.length {
    run historyRow(&states[index])
    run tagRows(&states[index])
    run metaRows(&states[index])
    index = index + 1
  }
  index = 0
  while index < states.length {
    run rows(definition, chart, prefix(chart, machine), &states[index])
    index = index + 1
  }
  run put("}\n")
  return ()
}

effect fn chartType(name: string, machine: string) -> ()
  ! WriterError
  ? &mut Writer {
  run put("Chart<")
  run put(name)
  run put(", ")
  run put(machine)
  run put("Event, ")
  run put(machine)
  run put("Context, ")
  run put(machine)
  run put("Effect>")
  return ()
}

// The tags of `state`.
effect fn tagRows(state: &StateDefinition) -> ()
  ! WriterError
  ? &mut Writer {
  let tags = state.tags.asSlice()
  let mut position: usize = 0
  while position < tags.length {
    run put("    |> Chart.tag(\"")
    run put(state.name.view())
    run put("\", \"")
    run put(tags[position].view())
    run put("\")\n")
    position = position + 1
  }
  return ()
}

// The meta data of `state`.
effect fn metaRows(state: &StateDefinition) -> ()
  ! WriterError
  ? &mut Writer {
  let meta = state.meta.asSlice()
  let mut position: usize = 0
  while position < meta.length {
    run put("    |> Chart.meta(\"")
    run put(state.name.view())
    run put("\", \"")
    run quoted(meta[position].key.view())
    run put("\", \"")
    run quoted(meta[position].value.view())
    run put("\")\n")
    position = position + 1
  }
  return ()
}

// Writes `value` as the inside of a Silk string literal.
effect fn quoted(value: string) -> ()
  ! WriterError
  ? &mut Writer {
  let bytes = String.utf8Bytes(value)
  let mut index: usize = 0
  while index < bytes.length {
    let byte = bytes[index]
    if byte == 34 {
      run put("\\\"")
    } else if byte == 92 {
      run put("\\\\")
    } else if byte == 10 {
      run put("\\n")
    } else {
      run Writer.writeAll(Slice.view(bytes, index, 1))
    }
    index = index + 1
  }
  return ()
}

// The history of `state`, when it has one.
effect fn historyRow(state: &StateDefinition) -> ()
  ! WriterError
  ? &mut Writer {
  match &state.remember {
    Option<RememberDefinition>.Some { value } => {
      if value.deep {
        run put("    |> Chart.history(\"")
      } else {
        run put("    |> Chart.shallowHistory(\"")
      }
      run put(state.name.view())
      run put("\", \"")
      run put(value.field.view())
      run put("\")\n")
    }
    Option<RememberDefinition>.None => {}
  }
  return ()
}

// The region fields of state `index`, each field name one time in the chart.
effect fn regionRows(states: &[StateDefinition], index: usize) -> ()
  ! WriterError
  ? &mut Writer {
  let regions = states[index].regions.asSlice()
  let mut position: usize = 0
  while position < regions.length {
    if !regionSeen(states, index, position) {
      run put("    |> Chart.region(\"")
      run put(regions[position].field.view())
      run put("\")\n")
    }
    position = position + 1
  }
  return ()
}

fn regionSeen(states: &[StateDefinition], index: usize, position: usize) -> bool {
  let field = states[index].regions.asSlice()[position].field.view()
  let mut state: usize = 0
  while state <= index {
    let regions = states[state].regions.asSlice()
    let mut earlier: usize = 0
    while earlier < regions.length && (state < index || earlier < position) {
      if regions[earlier].field.view() == field {
        return true
      }
      earlier = earlier + 1
    }
    state = state + 1
  }
  return false
}

// The guard functions of state `index`, each name one time.
effect fn guardImports(prefix: string, states: &[StateDefinition], index: usize) -> ()
  ! WriterError
  ? &mut Writer {
  let state = &states[index]
  let on = state.on.asSlice()
  let mut position: usize = 0
  while position < on.length {
    if on[position].guarded && !guardSeen(state, position) && !unguardedForm(state, position) {
      run put(", guard")
      run put(prefix)
      run put(state.name.view())
      run put(eventName(on[position].event.view()))
    }
    position = position + 1
  }
  let always = state.always.asSlice()
  position = 0
  while position < always.length {
    if always[position].guarded {
      run put(", when")
      run put(prefix)
      run put(state.name.view())
      break
    }
    position = position + 1
  }
  return ()
}

// The event's part of a guard name: the event, or `Any` for the event `*`.
fn eventName(event: string) -> string {
  if event == "*" {
    return "Any"
  }
  return event
}

// `Chart.stayAny` has no guarded form, and neither has a history transition on any event.
fn unguardedForm(state: &StateDefinition, position: usize) -> bool {
  let on = state.on.asSlice()
  return on[position].event.view() == "*" && on[position].target.view() == ""
}

fn guardSeen(state: &StateDefinition, position: usize) -> bool {
  let on = state.on.asSlice()
  let mut earlier: usize = 0
  while earlier < position {
    if on[earlier].guarded && on[earlier].event.view() == on[position].event.view() {
      return true
    }
    earlier = earlier + 1
  }
  return false
}

effect fn rows(
  definition: &Definition,
  chart: &ChartDefinition,
  prefix: string,
  state: &StateDefinition,
) -> ()
  ! WriterError
  ? &mut Writer {
  let name = state.name.view()
  let on = state.on.asSlice()
  let mut position: usize = 0
  while position < on.length {
    let any = on[position].event.view() == "*"
    let stays = on[position].target.view() == ""
    let guarded = on[position].guarded

    // The builder: stay, on or resume, with Any for the event `*` and When for a guard.
    if stays {
      run put("    |> Chart.stay")
    } else {
      if on[position].history {
        run put("    |> Chart.resume")
      } else {
        run put("    |> Chart.on")
      }
    }
    if any {
      run put("Any")
    }
    if guarded && !(stays && any) {
      run put("When")
    }
    run put("(\"")
    run put(name)
    if !any {
      run put("\", \"")
      run put(on[position].event.view())
    }
    run put("\"")
    if !stays {
      run put(", ")
      run value(definition, chart, on[position].target.view(), 0)
    }
    if guarded && !(stays && any) {
      run put(", guard")
      run put(prefix)
      run put(name)
      run put(eventName(on[position].event.view()))
    }
    run put(")\n")
    let meta = on[position].meta.asSlice()
    let mut entry: usize = 0
    while entry < meta.length {
      if any {
        run put("    |> Chart.metaOnAny(\"")
        run put(name)
      } else {
        run put("    |> Chart.metaOn(\"")
        run put(name)
        run put("\", \"")
        run put(on[position].event.view())
      }
      run put("\", \"")
      run quoted(meta[entry].key.view())
      run put("\", \"")
      run quoted(meta[entry].value.view())
      run put("\")\n")
      entry = entry + 1
    }
    position = position + 1
  }
  let always = state.always.asSlice()
  position = 0
  while position < always.length {
    if always[position].guarded {
      run put("    |> Chart.alwaysWhen(\"")
    } else {
      run put("    |> Chart.always(\"")
    }
    run put(name)
    run put("\", ")
    run value(definition, chart, always[position].target.view(), 0)
    if always[position].guarded {
      run put(", when")
      run put(prefix)
      run put(name)
    }
    run put(")\n")
    position = position + 1
  }
  let after = state.after.asSlice()
  position = 0
  while position < after.length {
    run put("    |> Chart.after(\"")
    run put(name)
    run put("\", ")
    run duration(after[position].duration)
    run put(", ")
    run value(definition, chart, after[position].target.view(), 0)
    run put(")\n")
    position = position + 1
  }
  if state.done.view() != "" {
    run put("    |> Chart.onDone(\"")
    run put(name)
    run put("\", ")
    run value(definition, chart, state.done.view(), 0)
    run put(")\n")
  }
  if state.final {
    run put("    |> Chart.final(\"")
    run put(name)
    run put("\")\n")
  }
  return ()
}

// The value of state `name` of `chart`: the variant, with each region at the initial state of
// its chart. Regions deeper than 16 levels are left out, which a definition that contains
// itself would otherwise never end.
effect fn value(definition: &Definition, chart: &ChartDefinition, name: string, depth: usize) -> ()
  ! WriterError
  ? &mut Writer {
  run put(chart.name.view())
  run put(".")
  run put(name)
  let states = chart.states.asSlice()
  let charts = definition.charts.asSlice()
  let mut index: usize = 0
  while index < states.length {
    if states[index].name.view() == name {
      let regions = states[index].regions.asSlice()
      if regions.length != 0 && depth < 16 {
        run put(" { ")
        let mut position: usize = 0
        while position < regions.length {
          if position != 0 {
            run put(", ")
          }
          run put(regions[position].field.view())
          run put(": ")
          let inner = Definitions.find(definition, regions[position].chart.view())
          if inner < charts.length {
            run value(definition, &charts[inner], charts[inner].initial.view(), depth + 1)
          }
          position = position + 1
        }
        run put(" }")
      }
      break
    }
    index = index + 1
  }
  return ()
}

effect fn put(value: string) -> ()
  ! WriterError
  ? &mut Writer {
  return run Writer.writeAll(String.utf8Bytes(value))
}

// Writes `name` with its first letter in lower case, when that letter is A to Z.
effect fn lowerFirst(name: string) -> ()
  ! WriterError
  ? &mut Writer {
  let bytes = String.utf8Bytes(name)
  if bytes.length == 0 {
    return ()
  }
  let mut first: [u8; 1] = [bytes[0]]
  if first[0] >= 65 && first[0] <= 90 {
    first[0] = first[0] + 32
  }
  run Writer.writeAll(&first)
  run Writer.writeAll(Slice.view(bytes, 1, bytes.length - 1))
  return ()
}

effect fn duration(value: u64) -> ()
  ! WriterError
  ? &mut Writer {
  let mut buffer: [u8; 48] = [0; 48]
  let length = Durations.literal(value, &mut buffer)
  run Writer.writeAll(Slice.view(&buffer, 0, length))
  return ()
}

effect fn number(value: u64) -> ()
  ! WriterError
  ? &mut Writer {
  let mut digits: [u8; 20] = [0; 20]
  let mut start: usize = 20
  let mut rest = value
  while true {
    start = start - 1
    digits[start] = u64.toU8(rest % 10) + 48
    rest = rest / 10
    if rest == 0 {
      break
    }
  }
  run Writer.writeAll(Slice.view(&digits, start, 20 - start))
  return ()
}
