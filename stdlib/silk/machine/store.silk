//! Stores: a context and one function that changes it for each event.
//!
//! # When to use
//! Use a store for state that has no modes: a counter, a form, a cart. Implement [`Reducer`]
//! for the context, start the store with [`Stores.begin`] and send it events with
//! [`Stores.send`]. Reach for a machine when what an event does depends on a state.
//!
//! # Details
//! A store is a machine with one state, [`Only`], so a [`Store`] is a `Snapshot`. It is written
//! to JSON and read back like any snapshot, and `Actors` and `Durable` run it and perform the
//! effects its reducer queues.
//!
//! @category State machines

import silk.machine.chart { Chart, Enqueue, Machine, Next }
import silk.machine.snapshot { Snapshot, Steps, TransitionLoopError }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.schema.schema { Schema }

/// The one state of a store whose context is `C`.
pub union Only<C> {
  Active,
}

impl<C> Schema for Only<C> {}

/// A context that changes itself for each event of type `E` and can queue effects of type `X`.
pub interface Reducer<E, X> {
  /// Applies `event` to the context. `enq` takes effects to perform and events to process
  /// next.
  effect fn reduce(self: &mut Self, event: &E, enq: &mut Enqueue<E, X>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator
}

impl<E, C: Reducer<E, X>, X> Machine<E, C, X> for Only<C> {
  static fn chart() -> Chart<Only<C>, E, C, X> {
    return Chart<Only<C>, E, C, X>.of() |> Chart.initial(Only<C>.Active)
  }

  effect fn handle(state: &Only<C>, context: &mut C, event: &E, enq: &mut Enqueue<E, X>) -> Next<
    Only<C>
  >
    ! OutOfMemoryError
    ? &mut Allocator {
    run Reducer.reduce(&mut context.*, event, &mut enq.*)
    return Next<Only<C>>.Stay
  }
}

/// A store of events `E`, context `C` and effects `X`. The context is `store.context`.
pub type Store<E, C, X> = Snapshot<Only<C>, E, C, X>

pub struct Stores {}

impl Stores {
  /// Returns a store that starts with `context`.
  pub effect fn begin<E, C: Reducer<E, X>, X>(context: C) -> Store<E, C, X>
    ! OutOfMemoryError | TransitionLoopError
    ? &mut Allocator {
    return run Steps.begin<Only<C>, E, C, X>(move context, 0)
  }

  /// Applies `event` to the store, then every event the reducer raised. Effects the reducer
  /// queued wait in `store.pending`. Use `Actors.send` in its place to perform them.
  pub effect fn send<E, C: Reducer<E, X>, X>(store: &mut Store<E, C, X>, event: E) -> ()
    ! OutOfMemoryError | TransitionLoopError
    ? &mut Allocator {
    drop run Steps.send<Only<C>, E, C, X>(&mut store.*, move event)
    return ()
  }
}
