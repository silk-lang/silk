//! The whole chart as data: a `Definition` can be written to JSON and read back, so external
//! tools can show a machine, and a build step can generate Silk source from one.
//!
//! # Gotchas
//! A definition names the state a transition enters and nothing more. The data a target value
//! holds, and a target that enters a region at a state other than the region's initial one,
//! are not part of it.
//!
//! @category State machines

import silk.machine.chart { Chart, Edge, Machine, hasCondition, hasGuard }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.reflect { Reflect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.u64
import silk.schema.schema { Schema }
import silk.text.string { String }

/// A transition taken on an event.
pub struct TransitionDefinition {
  /// The event's name, or `*` for a transition that any event takes.
  pub event: String,
  /// The target state, or an empty string for a transition that takes the event and stays.
  pub target: String,
  /// Whether a guard function decides if the transition is taken.
  pub guarded: bool,
  /// Whether the target is entered from its history, as it was when its chart last left it.
  pub history: bool,
  /// The meta data of the transition.
  pub meta: List<MetaDefinition>,
}

/// A transition taken without an event, as soon as its state is active.
pub struct AlwaysDefinition {
  pub target: String,
  pub guarded: bool,
}

/// A transition taken after its state stayed active for `duration`, in nanoseconds.
pub struct DelayDefinition {
  pub duration: u64,
  pub target: String,
}

/// A region of a state: a chart of its own that is active while the state is.
pub struct RegionDefinition {
  /// The name of the field of the state that holds the region.
  pub field: String,
  /// The name of the region's chart, one of the `charts` of the definition.
  pub chart: String,
}

/// The history of a state: its value is kept when its chart leaves it.
pub struct RememberDefinition {
  /// The name of the field of the context that keeps the value.
  pub field: String,
  /// Whether the regions come back whole (deep history) or only their own states (shallow).
  pub deep: bool,
}

/// One entry of the meta data of a state or of a transition.
pub struct MetaDefinition {
  pub key: String,
  pub value: String,
}

/// One state of a chart with the transitions that leave it.
pub struct StateDefinition {
  pub name: String,
  pub final: bool,
  pub tags: List<String>,
  pub meta: List<MetaDefinition>,
  pub on: List<TransitionDefinition>,
  pub always: List<AlwaysDefinition>,
  pub after: List<DelayDefinition>,
  /// The state taken when every region of this one is in a final state, see `Chart.onDone`, or
  /// an empty string when there is none.
  pub done: String,
  /// The regions of the state: none for an atomic state, one for a compound state, several for
  /// a parallel state.
  pub regions: List<RegionDefinition>,
  /// The history of the state, when it has one.
  pub remember: Option<RememberDefinition>,
}

/// A chart: its states and which one is entered first.
pub struct ChartDefinition {
  pub name: String,
  pub initial: String,
  pub states: List<StateDefinition>,
}

/// A machine: its chart and the charts of every region below it, each one time.
///
/// The charts are a flat list and a region names its chart, so a chart that several states
/// hold as a region is written one time. The first chart is the machine's own.
pub struct Definition {
  pub name: String,
  pub charts: List<ChartDefinition>,
}

impl Schema for MetaDefinition {}

impl Schema for TransitionDefinition {}

impl Schema for AlwaysDefinition {}

impl Schema for DelayDefinition {}

impl Schema for RegionDefinition {}

impl Schema for RememberDefinition {}

impl Schema for StateDefinition {}

impl Schema for ChartDefinition {}

impl Schema for Definition {}

static fn chartOf<S: Machine<E, C, X>, E, C, X>() -> Chart<S, E, C, X> {
  return Machine.chart()
}

pub struct Durations {}

impl Durations {
  /// Writes `duration`, in nanoseconds, as a duration literal such as `1m30s` at the start of
  /// `buffer`, and returns the length of the text. Zero is `0ns`.
  pub fn literal(duration: u64, buffer: &mut [u8; 48]) -> usize {
    let units: [u64; 8] = [1w, 1d, 1h, 1m, 1s, 1ms, 1us, 1ns]
    let names: [string; 8] = ["w", "d", "h", "m", "s", "ms", "us", "ns"]
    let mut length: usize = 0
    let mut rest = duration
    let mut unit: usize = 0
    while unit < 8 {
      let amount = rest / units[unit]
      rest = rest % units[unit]
      if amount != 0 || (unit == 7 && length == 0) {
        let mut digits: [u8; 20] = [0; 20]
        let mut start: usize = 20
        let mut left = amount
        while true {
          start = start - 1
          digits[start] = u64.toU8(left % 10) + 48
          left = left / 10
          if left == 0 {
            break
          }
        }
        while start < 20 {
          buffer[length] = digits[start]
          length = length + 1
          start = start + 1
        }
        let name = String.utf8Bytes(names[unit])
        let mut index: usize = 0
        while index < name.length {
          buffer[length] = name[index]
          length = length + 1
          index = index + 1
        }
      }
      unit = unit + 1
    }
    return length
  }
}

pub struct Definitions {}

impl Definitions {
  /// Returns the definition of the machine `S`: its chart first, then the chart of each region.
  pub effect fn of<S: Machine<E, C, X>, E, C, X>() -> Definition
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut charts = List<ChartDefinition>.make()
    run collect<S, E, C, X>(&mut charts)
    return Definition { name: run String.copy(Reflect.typeName<S>()), charts: move charts }
  }

  /// Returns the position in `definition.charts` of the chart called `name`, or the number of
  /// charts when there is none.
  pub fn find(definition: &Definition, name: string) -> usize {
    let charts = definition.charts.asSlice()
    let mut index: usize = 0
    while index < charts.length {
      if charts[index].name.view() == name {
        return index
      }
      index = index + 1
    }
    return charts.length
  }
}

fn known(charts: &List<ChartDefinition>, name: string) -> bool {
  let slice = charts.asSlice()
  let mut index: usize = 0
  while index < slice.length {
    if slice[index].name.view() == name {
      return true
    }
    index = index + 1
  }
  return false
}

// The name of the variant of `value`.
fn labelOf<S>(value: &S) -> string<'static> {
  static for variant in Reflect.variants<S>() {
    if Reflect.isVariant(value, variant) {
      return Reflect.variantLabel(variant)
    }
  }
  return ""
}

// The name of the state `edge` enters, or an empty string when it stays.
fn targetLabel<S>(static edge: Edge<S>) -> string<'static> {
  static for value in edge.target {
    return labelOf<S>(&value)
  }
  return ""
}

// The name of the state a chart starts in.
fn startLabel<S>(static start: Intrinsic.StaticSequence<S>) -> string<'static> {
  static for value in start {
    return labelOf<S>(&value)
  }
  return ""
}

// Appends the chart of `S`, then the charts of its regions, each when `charts` does not have it.
effect fn collect<S: Machine<E, C, X>, E, C, X>(charts: &mut List<ChartDefinition>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if known(&charts.*, Reflect.typeName<S>()) {
    return ()
  }
  let static chart = chartOf<S, E, C, X>()
  let mut states = List<StateDefinition>.make()
  static for variant in Reflect.variants<S>() {
    let mut on = List<TransitionDefinition>.make()
    static for edge in chart.edges {
      static if edge.state == Reflect.variantLabel(variant) {
        let mut notes = List<MetaDefinition>.make()
        static for item in edge.meta {
          run List<MetaDefinition>.append(
            &mut notes,
            MetaDefinition { key: run String.copy(item.key), value: run String.copy(item.value) },
          )
        }
        run List<TransitionDefinition>.append(
          &mut on,
          TransitionDefinition {
            event: run String.copy(edge.event),
            target: run String.copy(targetLabel<S>(edge)),
            guarded: hasGuard(edge),
            history: edge.history,
            meta: move notes,
          },
        )
      }
    }
    let mut always = List<AlwaysDefinition>.make()
    static for eventless in chart.eventless {
      static if eventless.state == Reflect.variantLabel(variant) {
        run List<AlwaysDefinition>.append(
          &mut always,
          AlwaysDefinition {
            target: run String.copy(labelOf<S>(&eventless.target)),
            guarded: hasCondition(eventless),
          },
        )
      }
    }
    let mut after = List<DelayDefinition>.make()
    static for delay in chart.delays {
      static if delay.state == Reflect.variantLabel(variant) {
        run List<DelayDefinition>.append(
          &mut after,
          DelayDefinition {
            duration: delay.duration,
            target: run String.copy(labelOf<S>(&delay.target)),
          },
        )
      }
    }
    let mut done = run String.copy("")
    static for item in chart.dones {
      static if item.state == Reflect.variantLabel(variant) {
        if done.view() == "" {
          done = run String.copy(labelOf<S>(&item.target))
        }
      }
    }
    let mut regions = List<RegionDefinition>.make()
    static for field in Reflect.variantFields(variant) {
      static if Chart.isRegion(chart, Reflect.fieldLabel(field)) {
        run List<RegionDefinition>.append(
          &mut regions,
          RegionDefinition {
            field: run String.copy(Reflect.fieldLabel(field)),
            chart: run String.copy(regionName(chart, field)),
          },
        )
      }
    }
    let mut tags = List<String>.make()
    static for item in chart.tags {
      static if item.state == Reflect.variantLabel(variant) {
        run List<String>.append(&mut tags, run String.copy(item.tag))
      }
    }
    let mut meta = List<MetaDefinition>.make()
    static for item in chart.metas {
      static if item.state == Reflect.variantLabel(variant) {
        run List<MetaDefinition>.append(
          &mut meta,
          MetaDefinition { key: run String.copy(item.key), value: run String.copy(item.value) },
        )
      }
    }
    let mut remember = Option<RememberDefinition>.None
    static for item in chart.histories {
      static if item.state == Reflect.variantLabel(variant) {
        remember = Option<RememberDefinition>.Some {
          value: RememberDefinition { field: run String.copy(item.field), deep: item.deep }
        }
      }
    }
    run List<StateDefinition>.append(
      &mut states,
      StateDefinition {
        name: run String.copy(Reflect.variantLabel(variant)),
        final: Chart.isFinal(chart, Reflect.variantLabel(variant)),
        tags: move tags,
        meta: move meta,
        on: move on,
        always: move always,
        after: move after,
        done: move done,
        regions: move regions,
        remember: move remember,
      },
    )
  }
  run List<ChartDefinition>.append(
    &mut charts.*,
    ChartDefinition {
      name: run String.copy(Reflect.typeName<S>()),
      initial: run String.copy(startLabel<S>(chart.start)),
      states: move states,
    },
  )
  static for variant in Reflect.variants<S>() {
    static for field in Reflect.variantFields(variant) {
      static if Chart.isRegion(chart, Reflect.fieldLabel(field)) {
        run collectRegion(chart, field, &mut charts.*)
      }
    }
  }
  return ()
}

static fn regionName<S, V, E, C, X>(
  chart: Chart<S, E, C, X>,
  field: Intrinsic.Field<S, V>,
) -> string<'static> {
  return Reflect.typeName<V>()
}

effect fn collectRegion<S, V: Machine<E, C, X>, E, C, X>(
  static chart: Chart<S, E, C, X>,
  static field: Intrinsic.Field<S, V>,
  charts: &mut List<ChartDefinition>,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  return run collect<V, E, C, X>(&mut charts.*)
}
