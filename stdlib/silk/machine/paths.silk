//! Paths through a chart: how to reach each state, and which states cannot be reached.
//!
//! # When to use
//! Use [`Paths.shortest`] to write one test per state without working out the events by hand,
//! and [`Paths.unreachable`] in a test or a build step to catch a state that no transition
//! leads to.
//!
//! # Details
//! A path is found in one chart of a `Definition`, from its initial state, with the fewest
//! steps. Every transition counts as possible, guarded or not, so a path says how a state can
//! be reached when the guards allow it. A step is the event's name, `always` for an eventless
//! transition, or `after <duration>` for a delayed one, such as `after 2s`. The transition
//! that any event takes is the step `*`.
//!
//! # Gotchas
//! Regions are charts of their own. A path does not cross from a chart into the chart of a
//! region: ask for the region's chart by its name.
//!
//! @category State machines

import silk.machine.definition { ChartDefinition, Definition, Definitions, Durations, StateDefinition }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }

/// The steps that lead from the initial state of a chart to `state`.
pub struct Path {
  pub state: String,
  /// One entry per transition, in order. Empty for the initial state.
  pub steps: List<String>,
}

pub struct Paths {}

const NONE: usize = 18446744073709551615

impl Paths {
  /// Returns a shortest path to every state of the chart called `chart` that can be reached,
  /// the initial state first. A chart the definition does not have gives no paths.
  pub effect fn shortest(definition: &Definition, chart: string) -> List<Path>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut paths = List<Path>.make()
    let charts = definition.charts.asSlice()
    let position = Definitions.find(definition, chart)
    if position == charts.length {
      return move paths
    }
    let states = charts[position].states.asSlice()
    let search = run explore(&charts[position])
    let order = search.order.asSlice()
    let mut index: usize = 0
    while index < order.length {
      let state = order[index]

      // Walk back to the initial state, then turn the steps around.
      let mut steps = List<String>.make()
      let mut at = state
      while search.from.asSlice()[at] != NONE {
        run List<String>.insert(&mut steps, 0, run label(states, search.from.asSlice()[at], at))
        at = search.from.asSlice()[at]
      }
      run List<Path>.append(
        &mut paths,
        Path { state: run String.copy(states[state].name.view()), steps: move steps },
      )
      index = index + 1
    }
    return move paths
  }

  /// Returns the names of the states of the chart called `chart` that no path reaches.
  pub effect fn unreachable(definition: &Definition, chart: string) -> List<String>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut names = List<String>.make()
    let charts = definition.charts.asSlice()
    let position = Definitions.find(definition, chart)
    if position == charts.length {
      return move names
    }
    let states = charts[position].states.asSlice()
    let search = run explore(&charts[position])
    let mut index: usize = 0
    while index < states.length {
      if !search.seen.asSlice()[index] {
        run List<String>.append(&mut names, run String.copy(states[index].name.view()))
      }
      index = index + 1
    }
    return move names
  }
}

struct Search {
  // The states in the order they were reached.
  order: List<usize>,
  // For each state, the state it was reached from, or NONE.
  from: List<usize>,
  seen: List<bool>,
}

fn indexOf(states: &[StateDefinition], name: string) -> usize {
  let mut index: usize = 0
  while index < states.length {
    if states[index].name.view() == name {
      return index
    }
    index = index + 1
  }
  return NONE
}

// Breadth first from the initial state, so the first way a state is reached is a shortest one.
effect fn explore(chart: &ChartDefinition) -> Search
  ! OutOfMemoryError
  ? &mut Allocator {
  let states = chart.states.asSlice()
  let mut search = Search {
    order: List<usize>.make(),
    from: List<usize>.make(),
    seen: List<bool>.make(),
  }
  run List<usize>.appendRepeated(&mut search.from, NONE, states.length)
  run List<bool>.appendRepeated(&mut search.seen, false, states.length)
  let start = indexOf(states, chart.initial.view())
  if start == NONE {
    return move search
  }
  search.seen.set(start, true)
  run List<usize>.append(&mut search.order, start)
  let mut next: usize = 0
  while next < search.order.length() {
    let state = search.order.asSlice()[next]
    next = next + 1
    let on = states[state].on.asSlice()
    let mut index: usize = 0
    while index < on.length {
      run reach(&mut search, states, state, on[index].target.view())
      index = index + 1
    }
    let always = states[state].always.asSlice()
    index = 0
    while index < always.length {
      run reach(&mut search, states, state, always[index].target.view())
      index = index + 1
    }
    let after = states[state].after.asSlice()
    index = 0
    while index < after.length {
      run reach(&mut search, states, state, after[index].target.view())
      index = index + 1
    }
  }
  return move search
}

effect fn reach(search: &mut Search, states: &[StateDefinition], from: usize, name: string) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let target = indexOf(states, name)
  if target == NONE || search.seen.asSlice()[target] {
    return ()
  }
  search.seen.set(target, true)
  search.from.set(target, from)
  run List<usize>.append(&mut search.order, target)
  return ()
}

// The step of the first transition from `from` to `to`, in the order `explore` tries them.
effect fn label(states: &[StateDefinition], from: usize, to: usize) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let name = states[to].name.view()
  let on = states[from].on.asSlice()
  let mut index: usize = 0
  while index < on.length {
    if on[index].target.view() == name {
      return run String.copy(on[index].event.view())
    }
    index = index + 1
  }
  let always = states[from].always.asSlice()
  index = 0
  while index < always.length {
    if always[index].target.view() == name {
      return run String.copy("always")
    }
    index = index + 1
  }
  let after = states[from].after.asSlice()
  index = 0
  while index < after.length {
    if after[index].target.view() == name {
      let mut step = run String.copy("after ")
      let mut buffer: [u8; 48] = [0; 48]
      let length = Durations.literal(after[index].duration, &mut buffer)
      unsafe {
        run step.append(String.fromUtf8Unchecked(Slice.view(&buffer, 0, length)))
      }
      return move step
    }
    index = index + 1
  }
  return run String.copy("")
}
