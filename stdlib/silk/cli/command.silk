//! Static descriptions of a command line: the command, its options, its positional arguments, and
//! its subcommands.
//!
//! # When to use
//! Describe a type with `impl CommandLine for T`, returning a [`Command`] built with [`Opt`], then
//! give the type to `silk.cli.parse.Cli.parse` or `Cli.read`.
//!
//! # Details
//! Every operation here is `static`, so a description is a compile-time value. A description names
//! fields by their labels, written as string literals that the compiler checks against the type,
//! so `Command<Git>.make(...) |> Command.option("quiet", ...)` stops compilation at `"quiet"` when
//! `Git` has no field `quiet`. The field types choose how each value is read; the description only
//! adds names, aliases, help text, defaults, and whether a field is positional, a subcommand, or
//! required. A field that the description does not mention is still an option, named after its
//! label.
//!
//! A union describes subcommands: each variant is one, named after its label in kebab case, and
//! its fields are that subcommand's options and arguments. A struct or variant field marked with
//! `Command.subcommand` holds such a union.
//!
//! @category Command line

import silk.core.option { Option }
import silk.core.reflect { Reflect }
import silk.core.static_sequence { StaticSequence }
import silk.core.static_text { StaticText }

/// The description of one struct field as an option or a positional argument.
pub struct OptionSpec {
  /// The label of the struct field that receives the value.
  pub field: string<'static>,
  /// The long name without dashes. Empty means the kebab-case form of `field`.
  pub long: string<'static>,
  /// The one-letter alias without the dash. Empty means no alias.
  pub short: string<'static>,
  /// The help text.
  pub description: string<'static>,
  /// Whether the command line must give this value.
  pub required: bool,
  /// Whether the value comes from a positional argument instead of a named option.
  pub positional: bool,
  /// Whether the field is a subcommand: a union with `CommandLine`, whose variants are the
  /// subcommands.
  pub subcommand: bool,
  /// The text read when neither the command line nor the environment gives a value. Empty
  /// means none: the field keeps the value that `ArgValue.initial` returns.
  pub fallback: string<'static>,
  /// The values the option accepts. Empty means any value its field type reads.
  pub choices: Intrinsic.StaticSequence<string<'static>>,
  /// The environment variable that supplies the value when the command line does not. Empty
  /// means none.
  pub env: string<'static>,
  /// The check a value must pass, a `fn(&V) -> bool` for the field type `V`, if any.
  pub check: Option<Intrinsic.FunctionRef>,
}

/// The description of one variant of a subcommand union.
pub struct VariantSpec {
  /// The label of the variant.
  pub label: string<'static>,
  /// The help text.
  pub description: string<'static>,
}

/// A type that the command line can build: a struct of options and positional arguments, or a
/// union whose variants are subcommands.
///
/// # Details
///
/// `command` describes the type. The default describes nothing, so every field is an option named
/// after its label and every variant is a subcommand named after its label, in kebab case. Write
/// `impl CommandLine for T {}` to take the default, or give `command` to add names, help text, and
/// positional arguments.
pub interface CommandLine {
  /// Returns the description of the type.
  static fn command() -> Command<Self> {
    return Command<Self>.make("", "")
  }
}

/// The description of a command whose parsed values fill `T`: a struct, or a union whose
/// variants are subcommands.
pub struct Command<T> {
  /// The program name shown in the usage line.
  pub name: string<'static>,
  /// The help text shown under the usage line.
  pub description: string<'static>,
  /// The text that `--version` prints. Empty means the command has no `--version`.
  pub version: string<'static>,
  /// The options and positional arguments, in the order they were added. For a union, these
  /// describe the fields of its variants.
  pub options: Intrinsic.StaticSequence<OptionSpec>,
  /// The help text of the variants of a union.
  pub variants: Intrinsic.StaticSequence<VariantSpec>,
}

impl<T> Command<T> {
  /// Returns a command named `name` with the help text `description` and no options.
  pub static fn make(name: string<'static>, description: string<'static>) -> Command<T> {
    return Command<T> {
      name: name,
      description: description,
      version: "",
      options: StaticSequence.empty<OptionSpec>(),
      variants: StaticSequence.empty<VariantSpec>(),
    }
  }

  /// Returns `command` with a `--version` option that prints `version`.
  pub static fn withVersion(command: Command<T>, version: string<'static>) -> Command<T> {
    return Command<T> {
      name: command.name,
      description: command.description,
      version: version,
      options: command.options,
      variants: command.variants,
    }
  }

  /// Returns `command` with the field `field` read as a named option, described by `option`.
  ///
  /// # Details
  ///
  /// `field` is checked against the fields of `T` where it is written, so a misspelled name is a
  /// compile error at the name. For a union, `field` names a field of any of its variants.
  pub static fn option(
    command: Command<T>,
    field: Intrinsic.FieldName<T>,
    option: OptionSpec,
  ) -> Command<T> {
    let label = Reflect.fieldNameText(field)
    return Command<T>.added(command, withPlace(option, label, false))
  }

  /// Returns `command` with the field `field` read as a positional argument, described by
  /// `argument`. Positional arguments are read in the order they are added. A `List` field takes
  /// every remaining positional argument.
  pub static fn arg(
    command: Command<T>,
    field: Intrinsic.FieldName<T>,
    argument: OptionSpec,
  ) -> Command<T> {
    let label = Reflect.fieldNameText(field)
    return Command<T>.added(command, withPlace(argument, label, true))
  }

  /// Returns `command` with the field `field` read as a subcommand. The field's type is a union
  /// with `CommandLine`, and the command line names one of its variants in kebab case, such as
  /// `remote` for the variant `Remote`.
  pub static fn subcommand(command: Command<T>, field: Intrinsic.FieldName<T>) -> Command<T> {
    let label = Reflect.fieldNameText(field)
    let entry = OptionSpec {
      field: label,
      long: "",
      short: "",
      description: "",
      required: true,
      positional: false,
      subcommand: true,
      fallback: "",
      choices: StaticSequence.empty<string<'static>>(),
      env: "",
      check: Option<Intrinsic.FunctionRef>.None,
    }
    return Command<T>.added(command, entry)
  }

  /// Returns `command` with the help text `description` for the variant `variant`, for a union
  /// whose variants are subcommands.
  pub static fn variant(
    command: Command<T>,
    variant: Intrinsic.VariantName<T>,
    description: string<'static>,
  ) -> Command<T> {
    let spec = VariantSpec { label: Reflect.variantNameText(variant), description: description }
    return Command<T> {
      name: command.name,
      description: command.description,
      version: command.version,
      options: command.options,
      variants: StaticSequence.append<VariantSpec>(command.variants, spec),
    }
  }

  static fn added(command: Command<T>, option: OptionSpec) -> Command<T> {
    return Command<T> {
      name: command.name,
      description: command.description,
      version: command.version,
      options: StaticSequence.append<OptionSpec>(command.options, option),
      variants: command.variants,
    }
  }

  /// Returns the description of `field`: the one added to `command`, or the default option named
  /// after the field.
  pub static fn find(command: Command<T>, field: string<'static>) -> OptionSpec {
    let count = StaticSequence.length<OptionSpec>(command.options)
    let mut index: usize = 0
    while index < count {
      let option = StaticSequence.at<OptionSpec>(command.options, index)
      if option.field == field {
        return option
      }
      index = index + 1
    }
    return withPlace(Opt.plain(), field, false)
  }

  /// Returns the description of `field`, as [`Command.find`] does, with the first line of the
  /// field's `///` comment as its help text when the description gives none.
  pub static fn field<V>(command: Command<T>, field: Intrinsic.Field<T, V>) -> OptionSpec {
    let option = Command.find(command, Reflect.fieldLabel(field))
    if option.description != "" {
      return option
    }
    return Opt.describe(option, firstLine(Reflect.fieldDoc(field)))
  }

  /// Returns the help text of the variant labeled `label`, or empty text.
  pub static fn describeVariant(command: Command<T>, label: string<'static>) -> string<'static> {
    static for variant in command.variants {
      if variant.label == label {
        return variant.description
      }
    }
    return ""
  }

  /// Returns the zero-based position of `field` among the positional arguments of `command` that
  /// belong to `fields`.
  pub static fn position(
    command: Command<T>,
    fields: Intrinsic.Fields<T>,
    field: string<'static>,
  ) -> usize {
    let mut position: usize = 0
    static for option in command.options {
      if option.field == field {
        return position
      }
      if option.positional && hasField<T>(fields, option.field) {
        position = position + 1
      }
    }
    return position
  }

  /// Returns the number of entries of `command` among `fields` that are positional arguments, or
  /// with `subcommands`, that are subcommands.
  pub static fn count(
    command: Command<T>,
    fields: Intrinsic.Fields<T>,
    subcommands: bool,
  ) -> usize {
    let mut found: usize = 0
    static for field in fields {
      let option = Command<T>.find(command, Reflect.fieldLabel(field))
      if (subcommands && option.subcommand) || (!subcommands && option.positional) {
        found = found + 1
      }
    }
    return found
  }

  /// Checks the entries of `command` among `fields` and stops compilation with a message when two
  /// clash. Returns `true` when they do not. Field names are already checked where they are
  /// written.
  pub static fn validate(command: Command<T>, fields: Intrinsic.Fields<T>) -> bool {
    let count = StaticSequence.length<OptionSpec>(command.options)
    let mut index: usize = 0
    while index < count {
      let option = StaticSequence.at<OptionSpec>(command.options, index)
      let mut other = index + 1
      while other < count {
        let next = StaticSequence.at<OptionSpec>(command.options, other)
        if next.field == option.field {
          compileError(StaticText.concat("field described twice: ", option.field))
        }
        if hasField<T>(fields, option.field) && hasField<T>(fields, next.field) {
          if !option.positional && !next.positional && !option.subcommand && !next.subcommand
            && OptionSpec.longFlag(next) == OptionSpec.longFlag(option) {
            compileError(StaticText.concat(
              "two options share the name ",
              OptionSpec.longFlag(option),
            ))
          }
          if option.short != "" && next.short == option.short {
            compileError(StaticText.concat("two options share the alias -", option.short))
          }
        }
        other = other + 1
      }
      if option.short != "" && StaticText.byteLength(option.short) != 1 {
        compileError(StaticText.concat("an alias is one letter: -", option.short))
      }
      if option.positional && option.short != "" {
        compileError(StaticText.concat("a positional argument has no alias: ", option.field))
      }
      if option.short == "h" {
        compileError("-h is the help option")
      }
      if option.positional && option.env != "" {
        compileError(StaticText.concat(
          "a positional argument reads no environment variable: ",
          option.field,
        ))
      }
      index = index + 1
    }
    if Command<T>.count(command, fields, false) != 0
      && Command<T>.count(command, fields, true) != 0 {
      compileError(StaticText.concat(
        "a command with subcommands takes no positional arguments: ",
        command.name,
      ))
    }
    if Command<T>.count(command, fields, true) > 1 {
      compileError(StaticText.concat("a command has at most one subcommand field: ", command.name))
    }
    return true
  }
}

static fn hasField<T>(fields: Intrinsic.Fields<T>, label: string<'static>) -> bool {
  static for field in fields {
    if Reflect.fieldLabel(field) == label {
      return true
    }
  }
  return false
}

impl OptionSpec {
  /// Returns `--` and the long name of `option`.
  pub static fn longFlag(option: OptionSpec) -> string<'static> {
    if option.long == "" {
      return StaticText.concat("--", kebab(option.field))
    }
    return StaticText.concat("--", option.long)
  }

  /// Returns `-` and the alias of `option`, or empty text when it has none.
  pub static fn shortFlag(option: OptionSpec) -> string<'static> {
    if option.short == "" {
      return ""
    }
    return StaticText.concat("-", option.short)
  }

  /// Returns the name of a positional argument in the usage line, such as `<files>`.
  pub static fn placeholder(option: OptionSpec) -> string<'static> {
    let mut name = option.long
    if name == "" {
      name = kebab(option.field)
    }
    return StaticText.concat(StaticText.concat("<", name), ">")
  }
}

/// The static builders of the description of one option or positional argument. Start with
/// [`Opt.about`] or [`Opt.plain`] and give the result to `Command.option` or `Command.arg`.
pub struct Opt {}

impl Opt {
  /// Returns a description with the help text `description` and nothing else.
  pub static fn about(description: string<'static>) -> OptionSpec {
    return Opt.describe(Opt.plain(), description)
  }

  /// Returns a description with no help text. The option is named `--` and the kebab-case form
  /// of its field.
  pub static fn plain() -> OptionSpec {
    return OptionSpec {
      field: "",
      long: "",
      short: "",
      description: "",
      required: false,
      positional: false,
      subcommand: false,
      fallback: "",
      choices: StaticSequence.empty<string<'static>>(),
      env: "",
      check: Option<Intrinsic.FunctionRef>.None,
    }
  }

  /// Returns `option` with the one-letter alias `short`, written without the dash.
  pub static fn short(option: OptionSpec, short: string<'static>) -> OptionSpec {
    let mut changed = option
    changed.short = short
    return changed
  }

  /// Returns `option` with the long name `long`, written without the dashes.
  pub static fn long(option: OptionSpec, long: string<'static>) -> OptionSpec {
    let mut changed = option
    changed.long = long
    return changed
  }

  /// Returns `option` with the help text `description`.
  pub static fn describe(option: OptionSpec, description: string<'static>) -> OptionSpec {
    let mut changed = option
    changed.description = description
    return changed
  }

  /// Returns `option` as one that the command line must give.
  pub static fn required(option: OptionSpec) -> OptionSpec {
    let mut changed = option
    changed.required = true
    return changed
  }

  /// Returns `option` that also accepts the value `value`. Once an option has a choice, the
  /// command line can give only one of its choices, and the help text lists them.
  pub static fn choice(option: OptionSpec, value: string<'static>) -> OptionSpec {
    let mut changed = option
    changed.choices = StaticSequence.append<string<'static>>(option.choices, value)
    return changed
  }

  /// Returns `option` that reads `text` when neither the command line nor the environment gives a
  /// value, such as `Opt.default("1")` for a count. The help text shows it.
  pub static fn default(option: OptionSpec, text: string<'static>) -> OptionSpec {
    let mut changed = option
    changed.fallback = text
    return changed
  }

  /// Returns `option` that reads the environment variable `name` when the command line does not
  /// give it. Only `Cli.fromHost` and `Cli.parseWith` read the environment.
  pub static fn env(option: OptionSpec, name: string<'static>) -> OptionSpec {
    let mut changed = option
    changed.env = name
    return changed
  }

  /// Returns `option` whose value must pass `check`, an ordinary function of the field's value,
  /// such as `Opt.check<u32>(positive)` for a `u32` field. A value that fails it is an invalid
  /// value; the parser calls `check` directly.
  pub static fn check<V>(option: OptionSpec, check: fn<'static>(&V) -> bool) -> OptionSpec {
    let mut changed = option
    changed.check = Option<Intrinsic.FunctionRef>.Some {
      value: Intrinsic.functionRef<fn<'static>(&V) -> bool>(check)
    }
    return changed
  }
}

static fn withPlace(option: OptionSpec, field: string<'static>, positional: bool) -> OptionSpec {
  let mut changed = option
  changed.field = field
  changed.positional = positional
  return changed
}

// The text of `text` before its first newline.
static fn firstLine(text: string<'static>) -> string<'static> {
  let length = StaticText.byteLength(text)
  let mut index: usize = 0
  while index < length {
    if StaticText.byteAt(text, index) == 10 {
      return StaticText.slice(text, 0, index)
    }
    index = index + 1
  }
  return text
}

pub static fn kebab(label: string<'static>) -> string<'static> {
  let upper = "ABCDEFGHIJKLMNOPQRSTUVWXYZ"
  let lower = "abcdefghijklmnopqrstuvwxyz"
  let length = StaticText.byteLength(label)
  let mut result = ""
  let mut index: usize = 0
  while index < length {
    let byte = StaticText.byteAt(label, index)
    let mut letter: usize = 0
    let mut replaced = false
    while letter < 26 {
      if StaticText.byteAt(upper, letter) == byte {
        if index != 0 {
          result = StaticText.concat(result, "-")
        }
        result = StaticText.concat(result, StaticText.slice(lower, letter, letter + 1))
        replaced = true
      }
      letter = letter + 1
    }
    if !replaced {
      result = StaticText.concat(result, StaticText.slice(label, index, index + 1))
    }
    index = index + 1
  }
  return result
}
