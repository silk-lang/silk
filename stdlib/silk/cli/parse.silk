//! Parse a command line into a struct, and write the help text of a command.
//!
//! # When to use
//! Call [`Cli.read`] from `main` to read the process arguments and print help, the version, or
//! errors, [`Cli.fromHost`] to handle those yourself, or [`Cli.parse`] to parse a list of
//! arguments that you already have, such as in a test.
//!
//! # Details
//! The type to parse has `CommandLine`, which describes it. The description and the type are
//! checked against each other during compilation. The loops over the fields and variants are
//! expanded during compilation too, so the parser that runs only compares each argument with the
//! option names and calls the reader of the matching field type. The parser builds the value
//! after it has read the whole command line, so a subcommand that was not chosen never exists, and
//! a field that the command line does not give takes its `Opt.default`, its environment variable,
//! or `ArgValue.initial`.
//!
//! Subcommands are the variants of a union, named in kebab case: a field marked with
//! `Command.subcommand` holds the variant that the command line chose.
//!
//! The parser accepts `--name value`, `--name=value`, `-n value`, `-n5`, flags such as `--loud`,
//! grouped one-letter flags such as `-abc`, positional arguments, and `--`, after which every
//! argument is positional. An option that takes one value, or a flag, may be given once; a
//! `List` field takes each occurrence. An unknown option names the closest option, when one is
//! close. `--help` and `-h` give
//! [`Parsed.Help`], and `--version` gives [`Parsed.Version`] when the command has a version.
//!
//! @category Command line

import silk.cli.command { Command, CommandLine, OptionSpec, kebab }
import silk.cli.value { Arg, ArgValue }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.system.host_input { HostInput, HostInputError }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.core.effect { Effect }
import silk.core.ownership { Copy }
import silk.core.reflect { Reflect, namedKind, unionKind }
import silk.core.result { Result }
import silk.core.static_sequence { StaticSequence }
import silk.core.static_text { StaticText }
import silk.text.edit_distance
import silk.text.string { String }
import silk.text.utf8_scan
import silk.io.writer { Writer, WriterError }
import silk.io.writer_native { StderrWriter, StdoutWriter }

/// Why a command line was not accepted.
pub union CliError {
  /// An argument looks like an option, but no option has that name.
  UnknownOption {
    /// The argument as given.
    pub token: String,
    /// The option whose name is closest to the argument, such as `--name` for `--nmae`, or empty
    /// when no name is close.
    pub suggestion: string<'static>
  },
  /// An option that takes one value, or a flag, is given more than once.
  Repeated {
    /// The option, such as `--name`.
    pub option: string<'static>
  },
  /// An option that takes a value is the last argument.
  MissingValue {
    /// The option, such as `--name`.
    pub option: string<'static>
  },
  /// The value of an option or positional argument is not one of its choices.
  NotAChoice {
    /// The option, such as `--format`, or the positional argument, such as `<format>`.
    pub option: string<'static>,
    /// The value as given.
    pub token: String,
    /// The choices, separated by commas, such as `json, text`.
    pub choices: string<'static>
  },
  /// The value of an option or positional argument is not valid for its field type.
  InvalidValue {
    /// The option, such as `--times`, or the positional argument, such as `<files>`.
    pub option: string<'static>,
    /// The value as given.
    pub token: String
  },
  /// A flag was given a value with `=`.
  UnexpectedValue {
    /// The flag, such as `--loud`.
    pub option: string<'static>
  },
  /// A required option or positional argument is missing.
  MissingRequired {
    /// The option, such as `--name`, or the positional argument, such as `<files>`.
    pub option: string<'static>
  },
  /// There are more positional arguments than the command takes.
  UnexpectedArgument {
    /// The argument as given.
    pub token: String
  },
  /// A command with subcommands was given none.
  MissingCommand {
    /// The command, such as `git remote`.
    pub command: string<'static>
  },
  /// An argument names no subcommand.
  UnknownCommand {
    /// The command, such as `git remote`.
    pub command: string<'static>,
    /// The argument as given.
    pub token: String
  }
}

/// The result of parsing a command line.
pub union Parsed<T> {
  /// The command line was accepted. `value` holds the parsed fields.
  Run {
    /// The parsed struct.
    pub value: T
  },
  /// The command line asked for the help text.
  Help {
    /// The subcommand path whose help was asked for, such as `remote.add`, in the names the
    /// command line uses. Empty for the root command. Give it to [`Cli.writeHelp`].
    pub command: string<'static>
  },
  /// The command line asked for the version.
  Version,
  /// The command line was not accepted.
  Failed {
    /// Why.
    pub error: CliError
  }
}

/// One environment variable, for [`Cli.parseWith`].
pub struct Variable<'a> {
  /// The variable name, such as `HOME`.
  pub name: string<'a>,
  /// The variable value.
  pub value: string<'a>,
}

impl<'a> Copy for Variable<'a> {}

/// The owner type of the parser. It has no fields and is never constructed.
pub struct Cli {}

impl Cli {
  /// Parses `arguments` into a `T`, as `T`'s `CommandLine` description says. `arguments[0]` is
  /// the program name and is skipped.
  ///
  /// # Details
  ///
  /// Each field of `T` is an option unless the description marks it positional or a subcommand.
  /// A description that names a field `T` does not have, or a field type without `ArgValue`, is a
  /// compile error.
  pub effect fn parse<T: CommandLine>(arguments: &[string]) -> Parsed<T>
    ! OutOfMemoryError
    ? &mut Allocator {
    let environment: [Variable<'static>; 0] = []
    return run Cli.parseWith<T>(arguments, &environment)
  }

  /// Parses like [`Cli.parse`], and reads an option that the command line does not give from
  /// `environment` when the option names a variable with `Opt.env`. The command line wins over the
  /// environment, and the environment wins over `Opt.default`.
  pub effect fn parseWith<T: CommandLine>(
    arguments: &[string],
    environment: &[Variable<'_>],
  ) -> Parsed<T>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut listed = List<Arg>.make()
    let mut at: usize = 0
    while at < arguments.length {
      run List<Arg>.append(&mut listed, textArg(arguments[at]))
      at = at + 1
    }
    return run parsedFrom<T>(List<Arg>.asSlice(&listed), environment)
  }

  /// Parses like [`Cli.parseWith`], from arguments as the program received them, such as
  /// `HostInput.arguments`. A `Bytes` field takes its argument's exact bytes; every other field
  /// reads the argument as text, where each byte that is not valid UTF-8 reads as `?`.
  pub effect fn parseBytes<T: CommandLine>(
    arguments: &[Bytes],
    environment: &[Variable<'_>],
  ) -> Parsed<T>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut texts = List<Bytes>.make()
    let mut at: usize = 0
    while at < arguments.length {
      run List<Bytes>.append(&mut texts, run readable(Bytes.asSlice(&arguments[at])))
      at = at + 1
    }
    let mut listed = List<Arg>.make()
    at = 0
    while at < arguments.length {
      let text = match String.fromUtf8(Bytes.asSlice(&List<Bytes>.asSlice(&texts)[at])) {
        Result.Success { value } => value
        Result.Failure { error: _ } => ""
      }
      run List<Arg>.append(&mut listed, Arg { text: text, bytes: Bytes.asSlice(&arguments[at]) })
      at = at + 1
    }
    return run parsedFrom<T>(List<Arg>.asSlice(&listed), environment)
  }

  /// Reads the process arguments, and the environment variables that `T`'s description names,
  /// and parses them with [`Cli.parseWith`].
  ///
  /// # Errors
  ///
  /// - `HostInputError` if the arguments cannot be read.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the copies.
  pub effect fn fromHost<T: CommandLine>() -> Parsed<T>
    ! HostInputError | OutOfMemoryError
    ? &mut HostInput | &mut Allocator {
    let raw = run HostInput.arguments()
    let mut names = List<string>.make()
    let static command = commandOf<T>()
    run environmentNames<T>(command, &mut names)
    let mut found = List<Bytes>.make()
    let mut known = List<string>.make()
    let mut at: usize = 0
    while at < List<string>.length(&names) {
      let name = List<string>.asSlice(&names)[at]
      match run HostInput.variableNamed(name) {
        Option.Some { value: bytes } => {
          run List<string>.append(&mut known, name)
          run List<Bytes>.append(&mut found, move bytes)
        }
        Option.None => {}
      }
      at = at + 1
    }
    let mut environment = List<Variable>.make()
    at = 0
    while at < List<Bytes>.length(&found) {
      match HostInput.text(Bytes.asSlice(&List<Bytes>.asSlice(&found)[at])) {
        Result.Success { value: text } => {
          let variable = Variable { name: List<string>.asSlice(&known)[at], value: text }
          run List<Variable>.append(&mut environment, variable)
        }
        Result.Failure { error: _ } => {}
      }
      at = at + 1
    }
    return run Cli.parseBytes<T>(List<Bytes>.asSlice(&raw), List<Variable>.asSlice(&environment))
  }

  /// Reads the command line like [`Cli.fromHost`], and handles everything but a value: it writes
  /// the help text or the version to standard output, or the error to standard error. Returns the
  /// value, or in `Result.Failure` the exit code for `main` to return: 0 after help or the
  /// version, 2 after an error.
  ///
  /// # Errors
  ///
  /// - `HostInputError` if the arguments cannot be read.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the copies.
  /// - `WriterError` if standard output or standard error fails.
  pub effect fn read<T: CommandLine>() -> Result<T, i32>
    ! HostInputError | OutOfMemoryError | WriterError
    ? &mut HostInput | &mut Allocator {
    let parsed = run Cli.fromHost<T>()
    let mut out = StdoutWriter.make()
    let mut err = StderrWriter.make()
    match move parsed {
      Parsed.Run { value } => {
        return Result<T, i32>.Success { value: move value }
      }
      Parsed.Help { command } => {
        run Cli.writeHelp<T>(command) |> Effect.provideMut<Writer>(&mut out)
        return Result<T, i32>.Failure { error: 0 }
      }
      Parsed.Version => {
        run Cli.writeVersion<T>() |> Effect.provideMut<Writer>(&mut out)
        return Result<T, i32>.Failure { error: 0 }
      }
      Parsed.Failed { error } => {
        run Cli.writeError(&error) |> Effect.provideMut<Writer>(&mut err)
        return Result<T, i32>.Failure { error: 2 }
      }
    }
  }

  /// Writes the help text of the command or subcommand at `path` (from [`Parsed.Help`]; empty
  /// for the root command) of `T`.
  ///
  /// # Errors
  ///
  /// - `WriterError` if the `Writer` fails.
  pub effect fn writeHelp<T: CommandLine>(path: string) -> ()
    ! WriterError
    ? &mut Writer {
    let static command = commandOf<T>()
    static if isUnion<T>() {
      return run writeChoiceHelp<T>(command, "", command.name, command.description, path)
    } else {
      return run writeLevelHelp<T>(
        command,
        Reflect.fields<T>(),
        "",
        command.name,
        command.description,
        command.version,
        path,
      )
    }
  }

  /// Writes the version of `T`'s command and a line break.
  ///
  /// # Errors
  ///
  /// - `WriterError` if the `Writer` fails.
  pub effect fn writeVersion<T: CommandLine>() -> ()
    ! WriterError
    ? &mut Writer {
    let static command = commandOf<T>()
    run Writer.writeString(command.name)
    run Writer.writeString(" ")
    run Writer.writeString(command.version)
    run Writer.writeString("\n")
  }

  /// Writes a one-line message for `error`, such as `error: unknown option --nmae`.
  ///
  /// # Errors
  ///
  /// - `WriterError` if the `Writer` fails.
  pub effect fn writeError(error: &CliError) -> ()
    ! WriterError
    ? &mut Writer {
    run Writer.writeString("error: ")
    let pieces = parts(error)
    let mut at: usize = 0
    while at < pieces.length {
      run Writer.writeString(pieces[at])
      at = at + 1
    }
    run Writer.writeString("\n")
  }

  /// Returns the message for `error` that [`Cli.writeError`] writes, without `error: ` and the
  /// line break, such as `unknown option --nmae; did you mean --name?`.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the text.
  pub effect fn message(error: &CliError) -> String
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut text = String.make()
    let pieces = parts(error)
    let mut at: usize = 0
    while at < pieces.length {
      run String.append(&mut text, pieces[at])
      at = at + 1
    }
    return move text
  }
}

// The message for `error`, in pieces to write in order; unused pieces are empty.
fn parts<'a>(error: &'a CliError) -> [string<'a>; 7] {
  return match &error.* {
    CliError.UnknownOption { token, suggestion } => {
      if suggestion == "" {
        return ["unknown option ", String.view(&token), "", "", "", "", ""]
      }
      return ["unknown option ", String.view(&token), "; did you mean ", suggestion, "?", "", ""]
    }
    CliError.Repeated { option } => [option, " is given more than once", "", "", "", "", ""]
    CliError.MissingValue { option } => [option, " needs a value", "", "", "", "", ""]
    CliError.NotAChoice { option, token, choices } => [
      "invalid value '",
      String.view(&token),
      "' for ",
      option,
      " (choose from ",
      choices,
      ")",
    ]
    CliError.InvalidValue { option, token } => [
      "invalid value '",
      String.view(&token),
      "' for ",
      option,
      "",
      "",
      "",
    ]
    CliError.UnexpectedValue { option } => [option, " takes no value", "", "", "", "", ""]
    CliError.MissingRequired { option } => ["missing ", option, "", "", "", "", ""]
    CliError.UnexpectedArgument { token } => [
      "unexpected argument ",
      String.view(&token),
      "",
      "",
      "",
      "",
      "",
    ]
    CliError.MissingCommand { command } => [command, " needs a command", "", "", "", "", ""]
    CliError.UnknownCommand { command, token } => [
      "unknown command ",
      String.view(&token),
      " for ",
      command,
      "",
      "",
      "",
    ]
  }
}

// `bytes` with each byte that is not part of valid UTF-8 replaced by `?`, so the text has the same
// length as `bytes` and an offset into one is an offset into the other.
effect fn readable(bytes: &[u8]) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut text = Bytes.make()
  let mut at: usize = 0
  while at < bytes.length {
    let decoded = utf8_scan.decode(bytes, at)
    if decoded.next == at + 1 && bytes[at] >= 128 {
      run Bytes.append(&mut text, b"?")
    } else {
      run Bytes.append(&mut text, Slice.view<u8>(bytes, at, decoded.next - at))
    }
    at = decoded.next
  }
  return move text
}

// Why reading stopped before a value was built.
union Stop {
  Help { command: string<'static> },
  Version,
  Error { error: CliError }
}

// One argument that the command line gave for the field `label` at subcommand depth `depth`: the
// text of `arguments[at]` from byte `from`. A flag's text is empty. A subcommand's text is the
// variant name.
struct Given {
  depth: usize,
  label: string<'static>,
  at: usize,
  from: usize,
}

impl Copy for Given {}

static fn commandOf<T: CommandLine>() -> Command<T> {
  return CommandLine.command()
}

static fn isUnion<T>() -> bool {
  return Reflect.typeKind(Reflect.typeOf<T>()) == unionKind
}

fn givenText<'a>(arguments: &[Arg<'a>], given: Given) -> string<'a> {
  let token = arguments[given.at].text
  return String.slice(token, given.from, String.byteLength(token) - given.from)
}

// The argument `given` names, from its byte `from`. The text and the bytes have the same length,
// so the same offset starts both.
fn givenArg<'a>(arguments: &[Arg<'a>], given: Given) -> Arg<'a> {
  let whole = arguments[given.at]
  return Arg {
    text: String.slice(whole.text, given.from, String.byteLength(whole.text) - given.from),
    bytes: Slice.view<u8>(whole.bytes, given.from, whole.bytes.length - given.from),
  }
}

// The argument `text`, whose bytes are its own, such as an environment variable or a default.
fn textArg<'a>(text: string<'a>) -> Arg<'a> {
  return Arg { text: text, bytes: String.utf8Bytes(text) }
}

effect fn parsedFrom<T: CommandLine>(arguments: &[Arg<'_>], environment: &[Variable<'_>]) -> Parsed<
  T
>
  ! OutOfMemoryError
  ? &mut Allocator {
  let result = run Effect.result(readCommand<T>(arguments, environment))
  match move result {
    Result.Success { value } => {
      return Parsed<T>.Run { value: move value }
    }
    Result.Failure { error } => {
      match move error {
        Stop.Help { command } => {
          return Parsed<T>.Help { command: command }
        }
        Stop.Version => {
          return Parsed<T>.Version
        }
        Stop.Error { error: failure } => {
          return Parsed<T>.Failed { error: move failure }
        }
        OutOfMemoryError {} => {
          fail OutOfMemoryError {}
        }
      }
    }
  }
}

effect fn readCommand<T: CommandLine>(arguments: &[Arg<'_>], environment: &[Variable<'_>]) -> T
  ! Stop | OutOfMemoryError
  ? &mut Allocator {
  let static command = commandOf<T>()
  let mut given = List<Given>.make()
  static if isUnion<T>() {
    run collectChoice<T>(command, "", command.name, 0, "", true, arguments, 1, &mut given)
    return run choiceValue<T>(command, "", 0, arguments, List<Given>.asSlice(&given), environment)
  } else {
    static if Reflect.typeKind(Reflect.typeOf<T>()) != namedKind {
      compileError("Cli.parse needs a struct with named fields or a union")
    }
    run collect<T>(
      command,
      Reflect.fields<T>(),
      "",
      command.name,
      0,
      true,
      arguments,
      1,
      &mut given,
    )
    return T {
      static for field in Reflect.fields<T>() { [field]: run fieldValue(
        command,
        field,
        0,
        "",
        arguments,
        List<Given>.asSlice(&given),
        environment,
      ) },
    }
  }
}

// Reads the command line from `start` for the fields `fields` of `command`, at subcommand depth
// `depth`. `path` is the subcommand path for help, and `name` the command name for errors.
effect fn collect<Owner>(
  static command: Command<Owner>,
  static fields: Intrinsic.Fields<Owner>,
  static path: string<'static>,
  static name: string<'static>,
  static depth: usize,
  static root: bool,
  arguments: &[Arg<'_>],
  start: usize,
  given: &mut List<Given>,
) -> ()
  ! Stop | OutOfMemoryError
  ? &mut Allocator {
  static if !Command.validate(command, fields) {
    compileError("the command description does not match its type")
  }
  let mut positionalOnly = false
  let mut positional: usize = 0
  let mut index = start
  while index < arguments.length {
    let token = arguments[index].text
    index = index + 1
    if !positionalOnly && token == "--" {
      positionalOnly = true
      continue
    }
    if !positionalOnly && (token == "--help" || token == "-h") {
      fail Stop.Help { command: path }
    }
    static if root && command.version != "" {
      if !positionalOnly && token == "--version" {
        fail Stop.Version
      }
    }
    if !positionalOnly && String.startsWith(token, "-") && token != "-" {
      if String.startsWith(token, "--") || String.byteLength(token) == 2 {
        let mut flag = token
        let mut from = String.byteLength(token)
        let mut hasInline = false
        if String.startsWith(token, "--") {
          match String.find(token, "=") {
            Option.Some { value: at } => {
              flag = String.slice(token, 0, at)
              hasInline = true
              from = at + 1
            }
            Option.None => {}
          }
        }
        let applied = run applyOption<Owner>(
          command,
          fields,
          depth,
          "",
          flag,
          false,
          index - 1,
          from,
          hasInline,
          arguments,
          &mut index,
          &mut given,
        )
        if !applied {
          let suggestion = run closest(flag, longNames<Owner>(command, fields))
          fail Stop.Error {
            error: CliError.UnknownOption { token: run String.copy(token), suggestion: suggestion },
          }
        }
        continue
      }

      // A group of one-letter options, such as `-abc`. An option that takes a value takes the rest
      // of the group, such as `-n5`, or else the next argument.
      let length = String.byteLength(token)
      let at = index - 1
      let mut letter: usize = 1
      while letter < length {
        if String.utf8Bytes(token)[letter] >= 128 {
          fail Stop.Error {
            error: CliError.UnknownOption { token: run String.copy(token), suggestion: "" },
          }
        }
        let before = List<Given>.length(&given)
        let applied = run applyOption<Owner>(
          command,
          fields,
          depth,
          "",
          String.slice(token, letter, 1),
          true,
          at,
          letter + 1,
          letter + 1 < length,
          arguments,
          &mut index,
          &mut given,
        )
        if !applied {
          fail Stop.Error {
            error: CliError.UnknownOption { token: run String.copy(token), suggestion: "" },
          }
        }

        // A flag's entry is the empty text at the end of the group; an option that took a value
        // ends the group.
        let added = List<Given>.asSlice(&given)[before]
        if added.at == at && added.from == length {
          letter = letter + 1
        } else {
          letter = length
        }
      }
      continue
    }
    static if Command.count(command, fields, true) != 0 {
      static for field in fields {
        let static option = Command.field(command, field)
        static if option.subcommand {
          return run collectSubcommand(field, path, name, depth, arguments, index - 1, &mut given)
        }
      }
    }
    let mut taken = false
    static for field in fields {
      let static option = Command.field(command, field)
      static if option.positional {
        let static at = Command.position(command, fields, option.field)
        if !taken && (positional == at || (repeats(field) && positional > at)) {
          taken = true
          static if StaticSequence.length<string<'static>>(option.choices) != 0 {
            if !isChoice(option, token) {
              let static placeholder = OptionSpec.placeholder(option)
              fail Stop.Error {
                error: CliError.NotAChoice {
                  option: placeholder,
                  token: run String.copy(token),
                  choices: choiceList(option),
                },
              }
            }
          }
          run List<Given>.append(
            &mut given,
            Given { depth: depth, label: option.field, at: index - 1, from: 0 },
          )
        }
      }
    }
    if !taken {
      fail Stop.Error { error: CliError.UnexpectedArgument { token: run String.copy(token) } }
    }
    positional = positional + 1
  }
  static if Command.count(command, fields, true) != 0 {
    fail Stop.Error { error: CliError.MissingCommand { command: name } }
  }
}

effect fn collectSubcommand<Owner, Sub: CommandLine>(
  static field: Intrinsic.Field<Owner, Sub>,
  static path: string<'static>,
  static name: string<'static>,
  static depth: usize,
  arguments: &[Arg<'_>],
  at: usize,
  given: &mut List<Given>,
) -> ()
  ! Stop | OutOfMemoryError
  ? &mut Allocator {
  static if !isUnion<Sub>() {
    compileError("a subcommand field holds a union whose variants are the subcommands")
  }
  return run collectChoice<Sub>(
    commandOf<Sub>(),
    path,
    name,
    depth,
    Reflect.fieldLabel(field),
    false,
    arguments,
    at,
    &mut given,
  )
}

// Reads the subcommand at `arguments[at]`, one of the variants of `U`, and the rest of the command
// line for its fields.
effect fn collectChoice<U>(
  static command: Command<U>,
  static path: string<'static>,
  static name: string<'static>,
  static depth: usize,
  static label: string<'static>,
  static root: bool,
  arguments: &[Arg<'_>],
  at: usize,
  given: &mut List<Given>,
) -> ()
  ! Stop | OutOfMemoryError
  ? &mut Allocator {
  if at >= arguments.length {
    fail Stop.Error { error: CliError.MissingCommand { command: name } }
  }
  let token = arguments[at].text
  if token == "--help" || token == "-h" {
    fail Stop.Help { command: path }
  }
  static if root && command.version != "" {
    if token == "--version" {
      fail Stop.Version
    }
  }
  static for variant in Reflect.variants<U>() {
    let static word = kebab(Reflect.variantLabel(variant))
    if token == word {
      run List<Given>.append(&mut given, Given { depth: depth, label: label, at: at, from: 0 })
      return run collect<U>(
        command,
        Reflect.variantFields(variant),
        joinPath(path, word),
        joinName(name, word),
        depth + 1,
        false,
        arguments,
        at + 1,
        &mut given,
      )
    }
  }
  fail Stop.Error {
    error: CliError.UnknownCommand { command: name, token: run String.copy(token) },
  }
}

// Records the option `flag` among `fields`: a long name or an alias with its dash, or with
// `letter`, an alias letter alone. With `hasAttached`, the value is `arguments[at]` from byte
// `from`: the text after `=` or after the letter. Returns `false` when no option has that name.
effect fn applyOption<Owner>(
  static command: Command<Owner>,
  static fields: Intrinsic.Fields<Owner>,
  static depth: usize,
  static prefix: string<'static>,
  flag: string,
  letter: bool,
  at: usize,
  from: usize,
  hasAttached: bool,
  arguments: &[Arg<'_>],
  index: &mut usize,
  given: &mut List<Given>,
) -> bool
  ! Stop | OutOfMemoryError
  ? &mut Allocator {
  static for field in fields {
    let static option = Command.field(command, field)
    static if option.flatten {
      if run applyGroup(
        field,
        depth,
        joinPath(prefix, option.field),
        flag,
        letter,
        at,
        from,
        hasAttached,
        arguments,
        &mut index,
        &mut given,
      ) {
        return true
      }
    } else {
      static if !option.positional && !option.subcommand {
        let static long = OptionSpec.longFlag(option)
        let static short = OptionSpec.shortFlag(option)
        let mut hit = false
        if letter {
          hit = option.short != "" && flag == option.short
        } else {
          hit = flag == long || (short != "" && flag == short)
        }
        if hit {
          let static label = joinPath(prefix, option.field)
          let mut entry = Given {
            depth: depth,
            label: label,
            at: at,
            from: String.byteLength(arguments[at].text),
          }
          if takesValue(field) {
            if hasAttached {
              entry.from = from
              if letter && String.startsWith(givenText(arguments, entry), "=") {
                entry.from = from + 1
              }
            } else {
              if index.* >= arguments.length {
                fail Stop.Error { error: CliError.MissingValue { option: long } }
              }
              entry.at = index.*
              entry.from = 0
              index.* = index.* + 1
            }
            static if StaticSequence.length<string<'static>>(option.choices) != 0 {
              let text = givenText(arguments, entry)
              if !isChoice(option, text) {
                fail Stop.Error {
                  error: CliError.NotAChoice {
                    option: long,
                    token: run String.copy(text),
                    choices: choiceList(option),
                  },
                }
              }
            }
          } else {
            if hasAttached && !letter {
              fail Stop.Error { error: CliError.UnexpectedValue { option: long } }
            }
          }
          if !repeats(field) {
            let earlier = List<Given>.asSlice(&given)
            let mut seen: usize = 0
            while seen < earlier.length {
              if earlier[seen].depth == depth && earlier[seen].label == label {
                fail Stop.Error { error: CliError.Repeated { option: long } }
              }
              seen = seen + 1
            }
          }
          run List<Given>.append(&mut given, entry)
          return true
        }
      }
    }
  }
  return false
}

// Records the option `flag` among the options of the group `field`, whose entries are labeled
// below `prefix`, as `applyOption` does for a command's own options.
effect fn applyGroup<Owner, Group: CommandLine>(
  static field: Intrinsic.Field<Owner, Group>,
  static depth: usize,
  static prefix: string<'static>,
  flag: string,
  letter: bool,
  at: usize,
  from: usize,
  hasAttached: bool,
  arguments: &[Arg<'_>],
  index: &mut usize,
  given: &mut List<Given>,
) -> bool
  ! Stop | OutOfMemoryError
  ? &mut Allocator {
  let static group = commandOf<Group>()
  static if !isGroup<Group>(group) {
    compileError("an option group is a struct of named options, without positional arguments or subcommands")
  }
  return run applyOption<Group>(
    group,
    Reflect.fields<Group>(),
    depth,
    prefix,
    flag,
    letter,
    at,
    from,
    hasAttached,
    arguments,
    &mut index,
    &mut given,
  )
}

// Whether `Group` can be an option group: a struct whose fields are all named options or groups.
static fn isGroup<Group>(command: Command<Group>) -> bool {
  if Reflect.typeKind(Reflect.typeOf<Group>()) != namedKind {
    return false
  }
  return Command.count(command, Reflect.fields<Group>(), false) == 0
    && Command.count(command, Reflect.fields<Group>(), true) == 0
}

// Builds the value of `field` of `command`, whose entries are labeled below `prefix` when
// `command` is an option group.
effect fn fieldValue<Owner, Value>(
  static command: Command<Owner>,
  static field: Intrinsic.Field<Owner, Value>,
  static depth: usize,
  static prefix: string<'static>,
  arguments: &[Arg<'_>],
  given: &[Given],
  environment: &[Variable<'_>],
) -> Value
  ! Stop | OutOfMemoryError
  ? &mut Allocator {
  let static option = Command.field(command, field)
  static if option.subcommand {
    return run subcommandValue(field, depth, arguments, given, environment)
  } else {
    static if option.flatten {
      return run groupValue(
        field,
        depth,
        joinPath(prefix, option.field),
        arguments,
        given,
        environment,
      )
    } else {
      return run argumentValue(command, field, depth, prefix, arguments, given, environment)
    }
  }
}

// Builds the option group `field` from the entries labeled below `prefix`.
effect fn groupValue<Owner, Group: CommandLine>(
  static field: Intrinsic.Field<Owner, Group>,
  static depth: usize,
  static prefix: string<'static>,
  arguments: &[Arg<'_>],
  given: &[Given],
  environment: &[Variable<'_>],
) -> Group
  ! Stop | OutOfMemoryError
  ? &mut Allocator {
  let static group = commandOf<Group>()
  return Group {
    static for member in Reflect.fields<Group>() { [member]: run fieldValue(
      group,
      member,
      depth,
      prefix,
      arguments,
      given,
      environment,
    ) },
  }
}

effect fn subcommandValue<Owner, Sub: CommandLine>(
  static field: Intrinsic.Field<Owner, Sub>,
  static depth: usize,
  arguments: &[Arg<'_>],
  given: &[Given],
  environment: &[Variable<'_>],
) -> Sub
  ! Stop | OutOfMemoryError
  ? &mut Allocator {
  return run choiceValue<Sub>(
    commandOf<Sub>(),
    Reflect.fieldLabel(field),
    depth,
    arguments,
    given,
    environment,
  )
}

// Whether the command line chose the subcommand `word` for `label` at `depth`.
fn chosen(
  arguments: &[Arg<'_>],
  given: &[Given],
  depth: usize,
  label: string,
  word: string,
) -> bool {
  let mut at: usize = 0
  while at < given.length {
    if given[at].depth == depth && given[at].label == label {
      return givenText(arguments, given[at]) == word
    }
    at = at + 1
  }
  return false
}

// Builds the variant of `U` that the command line chose for `label` at `depth`.
effect fn choiceValue<U>(
  static command: Command<U>,
  static label: string<'static>,
  static depth: usize,
  arguments: &[Arg<'_>],
  given: &[Given],
  environment: &[Variable<'_>],
) -> U
  ! Stop | OutOfMemoryError
  ? &mut Allocator {
  static for variant in Reflect.variants<U>() {
    let static word = kebab(Reflect.variantLabel(variant))
    if chosen(arguments, given, depth, label, word) {
      return U.[variant] {
        static for field in Reflect.variantFields(variant) { [field]: run fieldValue(
          command,
          field,
          depth + 1,
          "",
          arguments,
          given,
          environment,
        ) },
      }
    }
  }
  fail Stop.Error { error: CliError.MissingCommand { command: command.name } }
}

// Builds the value of an option or positional argument from what the command line gave, then the
// environment, then the option's default.
effect fn argumentValue<Owner, Value: ArgValue>(
  static command: Command<Owner>,
  static field: Intrinsic.Field<Owner, Value>,
  static depth: usize,
  static prefix: string<'static>,
  arguments: &[Arg<'_>],
  given: &[Given],
  environment: &[Variable<'_>],
) -> Value
  ! Stop | OutOfMemoryError
  ? &mut Allocator {
  let static option = Command.field(command, field)
  let static shown = shownName(option)
  let static label = joinPath(prefix, option.field)
  let mut value = run ArgValue.initial()
  let mut seen = false
  let mut at: usize = 0
  while at < given.length {
    if given[at].depth == depth && given[at].label == label {
      seen = true
      let text = givenText(arguments, given[at])
      if !(run ArgValue.accept(&mut value, givenArg(arguments, given[at])))
        || !passes<Value>(option, &value) {
        fail Stop.Error {
          error: CliError.InvalidValue { option: shown, token: run String.copy(text) },
        }
      }
    }
    at = at + 1
  }
  static if option.env != "" {
    let mut index: usize = 0
    while !seen && index < environment.length {
      if environment[index].name == option.env {
        let text = environment[index].value
        if ArgValue.takesValue() {
          seen = true
          static if StaticSequence.length<string<'static>>(option.choices) != 0 {
            if !isChoice(option, text) {
              fail Stop.Error {
                error: CliError.NotAChoice {
                  option: option.env,
                  token: run String.copy(text),
                  choices: choiceList(option),
                },
              }
            }
          }
          if !(run ArgValue.accept(&mut value, textArg(text))) || !passes<Value>(option, &value) {
            fail Stop.Error {
              error: CliError.InvalidValue { option: option.env, token: run String.copy(text) },
            }
          }
        } else {
          if text != "" && text != "0" && text != "false" {
            seen = true
            let _flagged = run ArgValue.accept(&mut value, textArg(""))
          }
        }
      }
      index = index + 1
    }
  }
  static if option.fallback != "" {
    if !seen {
      seen = true
      if !(run ArgValue.accept(&mut value, textArg(option.fallback)))
        || !passes<Value>(option, &value) {
        fail Stop.Error {
          error: CliError.InvalidValue { option: shown, token: run String.copy(option.fallback) },
        }
      }
    }
  }
  static if option.required {
    if !seen {
      fail Stop.Error { error: CliError.MissingRequired { option: shown } }
    }
  }
  return move value
}

// Whether `value` passes the check of `option`; a value of an option with no check always does.
// The check is an ordinary function, called directly.
fn passes<Value>(static option: OptionSpec, value: &Value) -> bool {
  static if hasCheck(option) {
    let static check = checkOf<Value>(option)
    return check(value)
  }
  return true
}

static fn hasCheck(option: OptionSpec) -> bool {
  return match option.check {
    Option<Intrinsic.FunctionRef>.Some { .. } => true
    Option<Intrinsic.FunctionRef>.None => false
  }
}

static fn checkOf<Value>(option: OptionSpec) -> fn<'static>(&Value) -> bool {
  return Intrinsic.functionAs<fn<'static>(&Value) -> bool>(referenceOf(option))
}

// The check of `option`, which `passes` reads only when the option has one.
static fn referenceOf(option: OptionSpec) -> Intrinsic.FunctionRef {
  if let Option<Intrinsic.FunctionRef>.Some { value } = option.check {
    return value
  }
  return Intrinsic.functionRef<fn<'static>(&bool) -> bool>(unchecked)
}

fn unchecked(value: &bool) -> bool {
  return true
}

// The name of `option` in messages: `<name>` for a positional argument, `--name` for an option.
static fn shownName(option: OptionSpec) -> string<'static> {
  if option.positional {
    return OptionSpec.placeholder(option)
  }
  return OptionSpec.longFlag(option)
}

fn isChoice(static option: OptionSpec, text: string) -> bool {
  static for choice in option.choices {
    if text == choice {
      return true
    }
  }
  return false
}

static fn choiceList(option: OptionSpec) -> string<'static> {
  let mut list = ""
  static for choice in option.choices {
    if list != "" {
      list = StaticText.concat(list, ", ")
    }
    list = StaticText.concat(list, choice)
  }
  return list
}

// Appends the environment variables that `command` and its subcommands name.
effect fn environmentNames<Owner>(static command: Command<Owner>, names: &mut List<string>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  static if isUnion<Owner>() {
    static for variant in Reflect.variants<Owner>() {
      run environmentNamesOf<Owner>(command, Reflect.variantFields(variant), &mut names)
    }
  } else {
    run environmentNamesOf<Owner>(command, Reflect.fields<Owner>(), &mut names)
  }
}

effect fn environmentNamesOf<Owner>(
  static command: Command<Owner>,
  static fields: Intrinsic.Fields<Owner>,
  names: &mut List<string>,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  static for field in fields {
    let static option = Command.field(command, field)
    static if option.subcommand {
      run subcommandNames(field, &mut names)
    } else {
      static if option.flatten {
        run groupNames(field, &mut names)
      } else {
        static if option.env != "" {
          run List<string>.append(&mut names, option.env)
        }
      }
    }
  }
}

effect fn subcommandNames<Owner, Sub: CommandLine>(
  static field: Intrinsic.Field<Owner, Sub>,
  names: &mut List<string>,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let static command = commandOf<Sub>()
  return run environmentNames<Sub>(command, &mut names)
}

effect fn groupNames<Owner, Group: CommandLine>(
  static field: Intrinsic.Field<Owner, Group>,
  names: &mut List<string>,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  return run environmentNamesOf<Group>(commandOf<Group>(), Reflect.fields<Group>(), &mut names)
}

static fn joinPath(path: string<'static>, word: string<'static>) -> string<'static> {
  if path == "" {
    return word
  }
  return StaticText.concat(StaticText.concat(path, "."), word)
}

static fn joinName(name: string<'static>, word: string<'static>) -> string<'static> {
  if name == "" {
    return word
  }
  return StaticText.concat(StaticText.concat(name, " "), word)
}

// Writes the help of the level at `at`, or of the subcommand below it that `path` names.
effect fn writeLevelHelp<Owner>(
  static command: Command<Owner>,
  static fields: Intrinsic.Fields<Owner>,
  static at: string<'static>,
  static name: string<'static>,
  static description: string<'static>,
  static version: string<'static>,
  path: string,
) -> ()
  ! WriterError
  ? &mut Writer {
  static for field in fields {
    let static option = Command.field(command, field)
    static if option.subcommand {
      if path != at {
        return run writeSubcommandHelp(field, at, name, path)
      }
    }
  }
  return run writeCommandHelp<Owner>(command, fields, name, description, version)
}

effect fn writeSubcommandHelp<Owner, Sub: CommandLine>(
  static field: Intrinsic.Field<Owner, Sub>,
  static at: string<'static>,
  static name: string<'static>,
  path: string,
) -> ()
  ! WriterError
  ? &mut Writer {
  let static command = commandOf<Sub>()
  return run writeChoiceHelp<Sub>(command, at, name, "", path)
}

// Writes the help of the subcommand that `path` names among the variants of `U`, below `at`. A
// path that names none writes the help of the command at `at`, whose help text is `description`.
effect fn writeChoiceHelp<U>(
  static command: Command<U>,
  static at: string<'static>,
  static name: string<'static>,
  static description: string<'static>,
  path: string,
) -> ()
  ! WriterError
  ? &mut Writer {
  static for variant in Reflect.variants<U>() {
    let static word = kebab(Reflect.variantLabel(variant))
    let static below = joinPath(at, word)
    if path == below || String.startsWith(path, StaticText.concat(below, ".")) {
      return run writeLevelHelp<U>(
        command,
        Reflect.variantFields(variant),
        below,
        joinName(name, word),
        Command.describeVariant(command, Reflect.variantLabel(variant)),
        "",
        path,
      )
    }
  }

  // Only a root union lands here: the help of the program itself.
  let static usage = StaticText.concat(StaticText.concat("Usage: ", name), " <command>\n")
  run Writer.writeString(usage)
  static if description != "" {
    run Writer.writeString("\n")
    run Writer.writeString(description)
    run Writer.writeString("\n")
  }
  run Writer.writeString("\nOptions:\n")
  run Writer.writeString("  -h, --help")
  run pad(12, variantColumn<U>(command))
  run Writer.writeString("Print this help\n")
  static if command.version != "" && at == "" {
    run Writer.writeString("      --version")
    run pad(15, variantColumn<U>(command))
    run Writer.writeString("Print the version\n")
  }
  run writeVariants<U>(command, variantColumn<U>(command))
}

effect fn writeVariants<U>(static command: Command<U>, static column: usize) -> ()
  ! WriterError
  ? &mut Writer {
  run Writer.writeString("\nCommands:\n")
  static for variant in Reflect.variants<U>() {
    let static word = kebab(Reflect.variantLabel(variant))
    let static about = Command.describeVariant(command, Reflect.variantLabel(variant))
    run Writer.writeString("  ")
    run Writer.writeString(word)
    static if about != "" {
      run pad(2 + String.byteLength(word), column)
      run Writer.writeString(about)
    }
    run Writer.writeString("\n")
  }
}

effect fn writeSubcommandList<Owner, Sub: CommandLine>(
  static field: Intrinsic.Field<Owner, Sub>,
  static column: usize,
) -> ()
  ! WriterError
  ? &mut Writer {
  return run writeVariants<Sub>(commandOf<Sub>(), column)
}

effect fn writeCommandHelp<Owner>(
  static command: Command<Owner>,
  static fields: Intrinsic.Fields<Owner>,
  static name: string<'static>,
  static description: string<'static>,
  static version: string<'static>,
) -> ()
  ! WriterError
  ? &mut Writer {
  let static usage = usageLine<Owner>(command, fields, name)
  let static column = optionColumn<Owner>(command, fields)
  run Writer.writeString(usage)
  static if description != "" {
    run Writer.writeString("\n")
    run Writer.writeString(description)
    run Writer.writeString("\n")
  }
  run Writer.writeString("\nOptions:\n")
  run writeOptionLines<Owner>(command, fields, column)
  run Writer.writeString("  -h, --help")
  run pad(12, column)
  run Writer.writeString("Print this help\n")
  static if version != "" {
    run Writer.writeString("      --version")
    run pad(15, column)
    run Writer.writeString("Print the version\n")
  }
  run writeArgumentLines<Owner>(command, fields, column)
}

// Writes one help line for each named option of `command` among `fields`, the options of its
// groups included, in the order of the fields.
effect fn writeOptionLines<Owner>(
  static command: Command<Owner>,
  static fields: Intrinsic.Fields<Owner>,
  static column: usize,
) -> ()
  ! WriterError
  ? &mut Writer {
  static for field in fields {
    let static option = Command.field(command, field)
    static if option.flatten {
      run writeGroupLines(field, column)
    } else {
      static if !option.positional && !option.subcommand {
        let static short = OptionSpec.shortFlag(option)
        let static long = OptionSpec.longFlag(option)
        let mut width: usize = 6 + String.byteLength(long)
        static if short != "" {
          run Writer.writeString("  ")
          run Writer.writeString(short)
          run Writer.writeString(", ")
        } else {
          run Writer.writeString("      ")
        }
        run Writer.writeString(long)
        if takesValue(field) {
          run Writer.writeString(" <value>")
          width = width + 8
        }
        static if hasNotes(option) {
          run pad(width, column)
        }
        run Writer.writeString(option.description)
        static if option.required {
          run Writer.writeString(" (required)")
        }
        run writeNotes(option)
        run Writer.writeString("\n")
      }
    }
  }
}

effect fn writeGroupLines<Owner, Group: CommandLine>(
  static field: Intrinsic.Field<Owner, Group>,
  static column: usize,
) -> ()
  ! WriterError
  ? &mut Writer {
  return run writeOptionLines<Group>(commandOf<Group>(), Reflect.fields<Group>(), column)
}

// Writes the positional arguments and the subcommands of `command` among `fields`.
effect fn writeArgumentLines<Owner>(
  static command: Command<Owner>,
  static fields: Intrinsic.Fields<Owner>,
  static column: usize,
) -> ()
  ! WriterError
  ? &mut Writer {
  static if Command.count(command, fields, false) != 0 {
    run Writer.writeString("\nArguments:\n")
    static for field in fields {
      let static option = Command.field(command, field)
      static if option.positional {
        let static placeholder = OptionSpec.placeholder(option)
        run Writer.writeString("  ")
        run Writer.writeString(placeholder)
        static if hasNotes(option) {
          run pad(2 + String.byteLength(placeholder), column)
        }
        run Writer.writeString(option.description)
        static if option.required {
          static if option.description == "" {
            run Writer.writeString("(required)")
          } else {
            run Writer.writeString(" (required)")
          }
        }
        run writeNotes(option)
        run Writer.writeString("\n")
      }
    }
  }
  static for field in fields {
    let static option = Command.field(command, field)
    static if option.subcommand {
      run writeSubcommandList(field, column)
    }
  }
}

// Whether the help line of `option` has text after its name.
static fn hasNotes(option: OptionSpec) -> bool {
  return option.description != "" || option.required
    || StaticSequence.length<string<'static>>(option.choices) != 0
    || option.env != ""
    || option.fallback != ""
}

// Writes the choices, the environment variable, and the default of `option` after its help text.
effect fn writeNotes(static option: OptionSpec) -> ()
  ! WriterError
  ? &mut Writer {
  static if StaticSequence.length<string<'static>>(option.choices) != 0 {
    static if option.description != "" || option.required {
      run Writer.writeString(" ")
    }
    run Writer.writeString("[choices: ")
    run Writer.writeString(choiceList(option))
    run Writer.writeString("]")
  }
  static if option.env != "" {
    static if option.description != "" || option.required
      || StaticSequence.length<string<'static>>(option.choices) != 0 {
      run Writer.writeString(" ")
    }
    run Writer.writeString("[env: ")
    run Writer.writeString(option.env)
    run Writer.writeString("]")
  }
  static if option.fallback != "" {
    static if option.description != "" || option.required
      || StaticSequence.length<string<'static>>(option.choices) != 0
      || option.env != "" {
      run Writer.writeString(" ")
    }
    run Writer.writeString("[default: ")
    run Writer.writeString(option.fallback)
    run Writer.writeString("]")
  }
}

fn takesValue<Owner, Value: ArgValue>(static field: Intrinsic.Field<Owner, Value>) -> bool {
  return ArgValue.takesValue()
}

fn repeats<Owner, Value: ArgValue>(static field: Intrinsic.Field<Owner, Value>) -> bool {
  return ArgValue.repeats()
}

effect fn pad(used: usize, column: usize) -> ()
  ! WriterError
  ? &mut Writer {
  let mut at = used
  if at + 2 > column {
    run Writer.writeString("  ")
    return
  }
  while at < column {
    run Writer.writeString(" ")
    at = at + 1
  }
}

// The column where option descriptions start: the widest `-n, --long <value>` plus two spaces.
static fn optionColumn<T>(command: Command<T>, fields: Intrinsic.Fields<T>) -> usize {
  return optionWidth<T>(command, fields) + 2
}

// The widest `-n, --long <value>` or positional name of `command` among `fields`, its groups
// included, and at least 15.
static fn optionWidth<T>(command: Command<T>, fields: Intrinsic.Fields<T>) -> usize {
  let mut widest: usize = 15
  static for field in fields {
    let option = Command.field(command, field)
    let mut width = 6 + StaticText.byteLength(OptionSpec.longFlag(option)) + 8
    if option.subcommand {
      width = 0
    }
    static if option.flatten {
      width = groupWidth(field)
    }
    if option.positional {
      width = 2 + StaticText.byteLength(OptionSpec.placeholder(option))
    }
    if width > widest {
      widest = width
    }
  }
  return widest
}

static fn groupWidth<Owner, Group: CommandLine>(field: Intrinsic.Field<Owner, Group>) -> usize {
  return optionWidth<Group>(commandOf<Group>(), Reflect.fields<Group>())
}

// The column where the help text of the variants of `U` starts.
static fn variantColumn<U>(command: Command<U>) -> usize {
  let mut widest: usize = 15
  static for variant in Reflect.variants<U>() {
    let width = 2 + StaticText.byteLength(kebab(Reflect.variantLabel(variant)))
    if width > widest {
      widest = width
    }
  }
  return widest + 2
}

// The long names of the options of `command` among `fields`, its groups included, each followed
// by a space.
static fn longNames<T>(command: Command<T>, fields: Intrinsic.Fields<T>) -> string<'static> {
  let mut names = ""
  static for field in fields {
    let option = Command.field(command, field)
    static if option.flatten {
      names = StaticText.concat(names, groupLongNames(field))
    } else {
      static if !option.positional && !option.subcommand {
        names = StaticText.concat(StaticText.concat(names, OptionSpec.longFlag(option)), " ")
      }
    }
  }
  return names
}

static fn groupLongNames<Owner, Group: CommandLine>(field: Intrinsic.Field<Owner, Group>) -> string<
  'static
> {
  return longNames<Group>(commandOf<Group>(), Reflect.fields<Group>())
}

// The name among `names` (each followed by a space) closest to `flag`: within two edits, and
// closer than half its length. Empty when none is.
effect fn closest(flag: string, names: string<'static>) -> string<'static>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut best = ""
  let mut limit = String.byteLength(flag) / 2 + 1
  if limit > 3 {
    limit = 3
  }
  let mut start: usize = 0
  let mut at: usize = 0
  let bytes = String.utf8Bytes(names)
  while at < bytes.length {
    if bytes[at] == 32 {
      let name = String.slice(names, start, at - start)
      let apart = run edit_distance.damerauLevenshtein(name, flag)
      if apart < limit {
        limit = apart
        best = name
      }
      start = at + 1
    }
    at = at + 1
  }
  return best
}

static fn usageLine<T>(
  command: Command<T>,
  fields: Intrinsic.Fields<T>,
  name: string<'static>,
) -> string<'static> {
  let mut line = StaticText.concat(StaticText.concat("Usage: ", name), " [options]")
  static for field in fields {
    let option = Command.field(command, field)
    if option.positional {
      line = StaticText.concat(StaticText.concat(line, " "), OptionSpec.placeholder(option))
    }
  }
  if Command.count(command, fields, true) != 0 {
    line = StaticText.concat(line, " <command>")
  }
  return StaticText.concat(line, "\n")
}
