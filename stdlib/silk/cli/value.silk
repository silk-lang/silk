impl ArgValue for bool {
  fn takesValue() -> bool {
    return false
  }

  fn repeats() -> bool {
    return false
  }

  effect fn initial() -> Self
    ! OutOfMemoryError
    ? &mut Allocator {
    return false
  }

  effect fn accept(self: &mut Self, text: string) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    self.* = true
    return true
  }
}

impl<T: FromArg> ArgValue for Option<T> {
  fn takesValue() -> bool {
    return true
  }

  fn repeats() -> bool {
    return false
  }

  effect fn initial() -> Self
    ! OutOfMemoryError
    ? &mut Allocator {
    return Option<T>.none()
  }

  effect fn accept(self: &mut Self, text: string) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    match run readArg<T>(text) {
      Result<T, bool>.Success { value } => {
        self.* = Option<T>.some(move value)
        return true
      }
      Result<T, bool>.Failure { error: _ } => {
        return false
      }
    }
  }
}

impl<T: FromArg> ArgValue for List<T> {
  fn takesValue() -> bool {
    return true
  }

  fn repeats() -> bool {
    return true
  }

  effect fn initial() -> Self
    ! OutOfMemoryError
    ? &mut Allocator {
    return List<T>.make()
  }

  effect fn accept(self: &mut Self, text: string) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    match run readArg<T>(text) {
      Result<T, bool>.Success { value } => {
        run List<T>.append(&mut self, move value)
        return true
      }
      Result<T, bool>.Failure { error: _ } => {
        return false
      }
    }
  }
}

fn accepted<T, E>(parsed: Result<T, E>) -> Result<T, bool> {
  match move parsed {
    Result.Success { value } => {
      return Result<T, bool>.Success { value: move value }
    }
    Result.Failure { error: _ } => {
      return Result<T, bool>.Failure { error: false }
    }
  }
}

effect fn readArg<T: FromArg>(text: string) -> Result<T, bool>
  ! OutOfMemoryError
  ? &mut Allocator {
  return run FromArg.fromArg(text)
}
