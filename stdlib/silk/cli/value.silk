impl FromArg for Bytes {
  effect fn fromArg(arg: Arg<'_>) -> Result<Bytes, bool>
    ! OutOfMemoryError
    ? &mut Allocator {
    return Result<Bytes, bool>.Success { value: run Bytes.copy(arg.bytes) }
  }
}

impl ArgValue for Bytes {
  fn takesValue() -> bool {
    return true
  }

  fn repeats() -> bool {
    return false
  }

  effect fn initial() -> Self
    ! OutOfMemoryError
    ? &mut Allocator {
    return Bytes.make()
  }

  effect fn accept(self: &mut Self, arg: Arg<'_>) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    self.* = run Bytes.copy(arg.bytes)
    return true
  }
}

impl ArgValue for String {
  fn takesValue() -> bool {
    return true
  }

  fn repeats() -> bool {
    return false
  }

  effect fn initial() -> Self
    ! OutOfMemoryError
    ? &mut Allocator {
    return String.make()
  }

  effect fn accept(self: &mut Self, arg: Arg<'_>) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    match run readArg<String>(arg) {
      Result<String, bool>.Success { value } => {
        self.* = move value
        return true
      }
      Result<String, bool>.Failure { error: _ } => {
        return false
      }
    }
  }
}

