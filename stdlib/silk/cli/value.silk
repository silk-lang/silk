//! How a struct field reads its value from the command line.
//!
//! # When to use
//! Every field of a command struct needs [`ArgValue`]. This module implements it for `String`,
//! `Bytes`, `bool`, the integer types, `Option<T>`, and `List<T>`. Implement it for your own type
//! to read that type from an argument.
//!
//! # Details
//! A `bool` field is a flag: it takes no value and becomes `true` when the flag is present. An
//! `Option<T>` field becomes present when the option is given. A `List<T>` field collects every
//! occurrence, and as a positional argument it takes every remaining argument. A `Bytes` field
//! takes the argument's exact bytes, so it also reads a path that is not valid UTF-8; every other
//! type reads [`Arg.text`], where each byte that is not valid UTF-8 reads as `?`.
//!
//! @category Command line

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.text.string { String }
import silk.num.i8
import silk.num.i16
import silk.num.i32
import silk.num.i64
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.usize

/// One argument, or the part of one after `=` or after an option letter.
pub struct Arg<'a> {
  /// The argument as text. Each byte that is not valid UTF-8 reads as `?`, so the text has the
  /// same length as `bytes`.
  pub text: string<'a>,
  /// The argument's exact bytes, as the program received them.
  pub bytes: &'a [u8],
}

impl<'a> Copy for Arg<'a> {}

/// A type that reads one value from command-line text.
pub interface FromArg {
  /// Returns the value that `arg` spells, or `false` in `Result.Failure` when it is not a valid
  /// value.
  effect fn fromArg(arg: Arg<'_>) -> Result<Self, bool> ! OutOfMemoryError ? &mut Allocator
}

/// A field type that the parser can fill from the command line.
pub interface ArgValue {
  /// Whether an occurrence of the option takes a value. `false` makes the option a flag.
  fn takesValue() -> bool

  /// Whether the field accepts more than one occurrence.
  fn repeats() -> bool

  /// Returns the value of a field that the command line does not give: empty text, zero,
  /// `false`, `none`, or an empty list.
  effect fn initial() -> Self ! OutOfMemoryError ? &mut Allocator

  /// Stores one occurrence. `arg` is empty for a flag. Returns `false` when it is not a valid
  /// value.
  effect fn accept(self: &mut Self, arg: Arg<'_>) -> bool ! OutOfMemoryError ? &mut Allocator
}

impl FromArg for String {
  effect fn fromArg(arg: Arg<'_>) -> Result<String, bool>
    ! OutOfMemoryError
    ? &mut Allocator {
    return Result<String, bool>.Success { value: run String.copy(arg.text) }
  }
}

impl FromArg for i8 {
  effect fn fromArg(arg: Arg<'_>) -> Result<i8, bool>
    ! OutOfMemoryError
    ? &mut Allocator {
    return accepted(i8.parse(arg.text))
  }
}

impl FromArg for i16 {
  effect fn fromArg(arg: Arg<'_>) -> Result<i16, bool>
    ! OutOfMemoryError
    ? &mut Allocator {
    return accepted(i16.parse(arg.text))
