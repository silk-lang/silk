  }
}

impl ArgValue for String {
  fn takesValue() -> bool {
    return true
  }

  fn repeats() -> bool {
    return false
  }

  effect fn initial() -> Self
    ! OutOfMemoryError
    ? &mut Allocator {
    return String.make()
  }

  effect fn accept(self: &mut Self, text: string) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    match run readArg<String>(text) {
      Result<String, bool>.Success { value } => {
        self.* = move value
        return true
      }
      Result<String, bool>.Failure { error: _ } => {
        return false
      }
    }
  }
}

impl ArgValue for i8 {
  fn takesValue() -> bool {
    return true
  }

  fn repeats() -> bool {
    return false
  }

  effect fn initial() -> Self
    ! OutOfMemoryError
    ? &mut Allocator {
    return 0
  }

  effect fn accept(self: &mut Self, text: string) -> bool
