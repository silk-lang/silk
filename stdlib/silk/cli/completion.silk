//! Shell completion scripts for a command, written during compilation from its description.
//!
//! # When to use
//! Give your program a way to print the script, such as a `--completions bash` option, and tell
//! users to load it: `source <(mytool --completions bash)` in `~/.bashrc`, the same with `zsh` in
//! `~/.zshrc`, or `mytool --completions fish | source` in `~/.config/fish/config.fish`.
//!
//! # Details
//! The script completes subcommand names, option names and aliases, and the choices of an option
//! or positional argument (see `Opt.choice`). It follows the subcommands already typed, so
//! `git remote <Tab>` offers the options and subcommands of `remote`. Where a command takes
//! positional arguments without choices, the script completes file names too. The zsh script
//! loads zsh's completion system and its bash support if needed, and uses the bash script.
//!
//! @category Command line

import silk.cli.command { Command, CommandLine, OptionSpec, kebab }
import silk.core.reflect { Reflect, unionKind }
import silk.core.static_sequence { StaticSequence }
import silk.core.static_text { StaticText }
import silk.io.writer { Writer, WriterError }

/// The owner type of the completion writers. It has no fields and is never constructed.
pub struct Completion {}

impl Completion {
  /// Writes a bash completion script for the command that `T` describes.
  ///
  /// # Errors
  ///
  /// - `WriterError` if the `Writer` fails.
  pub effect fn writeBash<T: CommandLine>() -> ()
    ! WriterError
    ? &mut Writer {
    let static command = commandOf<T>()
    let static function = StaticText.concat("_", functionName(command.name))
    run Writer.writeString(function)
    run Writer.writeString("() {\n")
    run Writer.writeString("  local cur prev path words files i\n")
    run Writer.writeString("  cur=\"${COMP_WORDS[COMP_CWORD]}\"\n")
    run Writer.writeString("  prev=\"${COMP_WORDS[COMP_CWORD-1]}\"\n")
    run Writer.writeString("  path=\"\"\n")
    run Writer.writeString("  files=\"\"\n")
    run Writer.writeString("  for ((i = 1; i < COMP_CWORD; i++)); do\n")
    run Writer.writeString("    case \"$path:${COMP_WORDS[i]}\" in\n")
    run rootTransitions<T>(command, false)
    run Writer.writeString("    esac\n")
    run Writer.writeString("  done\n")
    run Writer.writeString("  case \"$path\" in\n")
    run rootWords<T>(command, false)
    run Writer.writeString("  esac\n")
    run Writer.writeString("  case \"$path:$prev\" in\n")
    run rootChoices<T>(command, false)
    run Writer.writeString("  esac\n")
    run Writer.writeString("  COMPREPLY=($(compgen -W \"$words\" -- \"$cur\"))\n")
    run Writer.writeString("  if [ -n \"$files\" ]; then\n")
    run Writer.writeString("    COMPREPLY+=($(compgen -f -- \"$cur\"))\n")
    run Writer.writeString("  fi\n")
    run Writer.writeString("}\n")
    run Writer.writeString("complete -F ")
    run Writer.writeString(function)
    run Writer.writeString(" ")
    run Writer.writeString(command.name)
    run Writer.writeString("\n")
  }

  /// Writes a zsh completion script for the command that `T` describes.
  ///
  /// # Errors
  ///
  /// - `WriterError` if the `Writer` fails.
  pub effect fn writeZsh<T: CommandLine>() -> ()
    ! WriterError
    ? &mut Writer {
    run Writer.writeString(
      "(( $+functions[compdef] )) || { autoload -U +X compinit && compinit; }\n",
    )
    run Writer.writeString("autoload -U +X bashcompinit && bashcompinit\n")
    run Completion.writeBash<T>()
  }

  /// Writes a fish completion script for the command that `T` describes.
  ///
  /// # Errors
  ///
  /// - `WriterError` if the `Writer` fails.
  pub effect fn writeFish<T: CommandLine>() -> ()
    ! WriterError
    ? &mut Writer {
    let static command = commandOf<T>()
    let static function = StaticText.concat("__", functionName(command.name))
    run Writer.writeString("function ")
    run Writer.writeString(function)
    run Writer.writeString("\n")
    run Writer.writeString("  set -l words (commandline -opc)\n")
    run Writer.writeString("  set -l path ''\n")
    run Writer.writeString("  set -l files ''\n")
    run Writer.writeString("  for word in $words[2..-1]\n")
    run Writer.writeString("    switch \"$path:$word\"\n")
    run rootTransitions<T>(command, true)
    run Writer.writeString("    end\n")
    run Writer.writeString("  end\n")
    run Writer.writeString("  switch \"$path:$words[-1]\"\n")
    run rootChoices<T>(command, true)
    run Writer.writeString("  end\n")
    run Writer.writeString("  switch \"$path\"\n")
    run rootWords<T>(command, true)
    run Writer.writeString("  end\n")
    run Writer.writeString("  if test -n \"$files\"\n")
    run Writer.writeString("    __fish_complete_path (commandline -ct)\n")
    run Writer.writeString("  end\n")
    run Writer.writeString("end\n")
    run Writer.writeString("complete -c ")
    run Writer.writeString(command.name)
    run Writer.writeString(" -f -a '(")
    run Writer.writeString(function)
    run Writer.writeString(")'\n")
  }
}

// Writes the start of a `case` arm that matches `pattern`, in bash or fish.
effect fn writeArm(pattern: string, fish: bool) -> ()
  ! WriterError
  ? &mut Writer {
  if fish {
    run Writer.writeString("case '")
    run Writer.writeString(pattern)
    run Writer.writeString("'\n")
  } else {
    run Writer.writeString("\"")
    run Writer.writeString(pattern)
    run Writer.writeString("\") ")
  }
}

// Writes `words` as the completions of an arm: an assignment in bash, printed lines in fish.
effect fn writeWordList(words: string, fish: bool) -> ()
  ! WriterError
  ? &mut Writer {
  if fish {
    run Writer.writeString("      printf '%s\\n' ")
    run Writer.writeString(words)
    run Writer.writeString("\n")
  } else {
    run Writer.writeString("words=\"")
    run Writer.writeString(words)
    run Writer.writeString("\" ;;\n")
  }
}

static fn commandOf<T: CommandLine>() -> Command<T> {
  return CommandLine.command()
}

static fn isUnion<T>() -> bool {
  return Reflect.typeKind(Reflect.typeOf<T>()) == unionKind
}

effect fn rootTransitions<T>(static command: Command<T>, static fish: bool) -> ()
  ! WriterError
  ? &mut Writer {
  static if isUnion<T>() {
    run choiceTransitions<T>(command, "", fish)
  } else {
    run writeTransitions<T>(command, Reflect.fields<T>(), "", fish)
  }
}

// Writes one arm per subcommand below the fields `fields`: typing its name at `at` moves to its
// path.
effect fn writeTransitions<Owner>(
  static command: Command<Owner>,
  static fields: Intrinsic.Fields<Owner>,
  static at: string<'static>,
  static fish: bool,
) -> ()
  ! WriterError
  ? &mut Writer {
  static for field in fields {
    let static option = Command.field(command, field)
    static if option.subcommand {
      run subcommandTransitions(field, at, fish)
    }
  }
}

effect fn subcommandTransitions<Owner, Sub: CommandLine>(
  static field: Intrinsic.Field<Owner, Sub>,
  static at: string<'static>,
  static fish: bool,
) -> ()
  ! WriterError
  ? &mut Writer {
  let static command = commandOf<Sub>()
  return run choiceTransitions<Sub>(command, at, fish)
}

effect fn choiceTransitions<U>(
  static command: Command<U>,
  static at: string<'static>,
  static fish: bool,
) -> ()
  ! WriterError
  ? &mut Writer {
  static for variant in Reflect.variants<U>() {
    let static word = kebab(Reflect.variantLabel(variant))
    let static below = joinPath(at, word)
    run Writer.writeString("      ")
    run writeArm(StaticText.concat(StaticText.concat(at, ":"), word), fish)
    static if fish {
      run Writer.writeString("        set path ")
      run Writer.writeString(below)
      run Writer.writeString("\n")
    } else {
      run Writer.writeString("path=\"")
      run Writer.writeString(below)
      run Writer.writeString("\" ;;\n")
    }
    run writeTransitions<U>(command, Reflect.variantFields(variant), below, fish)
  }
}

effect fn rootWords<T>(static command: Command<T>, static fish: bool) -> ()
  ! WriterError
  ? &mut Writer {
  static if isUnion<T>() {
    let static words = StaticText.concat(variantWords<T>(), helpWords(command.version))
    run Writer.writeString("    ")
    run writeArm("", fish)
    run writeWordList(words, fish)
    run variantArms<T>(command, "", fish)
  } else {
    run writeWords<T>(command, Reflect.fields<T>(), "", command.version, fish)
  }
}

// Writes the arm of the words that complete at `at`, then the arms of its subcommands.
effect fn writeWords<Owner>(
  static command: Command<Owner>,
  static fields: Intrinsic.Fields<Owner>,
  static at: string<'static>,
  static version: string<'static>,
  static fish: bool,
) -> ()
  ! WriterError
  ? &mut Writer {
  let static own = StaticText.concat(wordsOf<Owner>(command, fields), helpWords(version))
  static if Command.count(command, fields, true) != 0 {
    static for field in fields {
      let static option = Command.field(command, field)
      static if option.subcommand {
        run subcommandWords(field, own, at, fish)
      }
    }
  } else {
    run Writer.writeString("    ")
    run writeArm(at, fish)
    static if takesFiles<Owner>(command, fields) {
      static if fish {
        run Writer.writeString("      set files 1\n")
      } else {
        run Writer.writeString("files=1; ")
      }
    }
    run writeWordList(own, fish)
  }
}

effect fn subcommandWords<Owner, Sub: CommandLine>(
  static field: Intrinsic.Field<Owner, Sub>,
  static own: string<'static>,
  static at: string<'static>,
  static fish: bool,
) -> ()
  ! WriterError
  ? &mut Writer {
  let static command = commandOf<Sub>()
  run Writer.writeString("    ")
  run writeArm(at, fish)
  run writeWordList(StaticText.concat(variantWords<Sub>(), own), fish)
  return run variantArms<Sub>(command, at, fish)
}

effect fn variantArms<U>(
  static command: Command<U>,
  static at: string<'static>,
  static fish: bool,
) -> ()
  ! WriterError
  ? &mut Writer {
  static for variant in Reflect.variants<U>() {
    let static below = joinPath(at, kebab(Reflect.variantLabel(variant)))
    run writeWords<U>(command, Reflect.variantFields(variant), below, "", fish)
  }
}

effect fn rootChoices<T>(static command: Command<T>, static fish: bool) -> ()
  ! WriterError
  ? &mut Writer {
  static if isUnion<T>() {
    run choiceChoices<T>(command, "", fish)
  } else {
    run writeChoices<T>(command, Reflect.fields<T>(), "", fish)
  }
}

effect fn groupChoices<Owner, Group: CommandLine>(
  static field: Intrinsic.Field<Owner, Group>,
  static at: string<'static>,
  static fish: bool,
) -> ()
  ! WriterError
  ? &mut Writer {
  return run writeChoices<Group>(commandOf<Group>(), Reflect.fields<Group>(), at, fish)
}

// Writes one arm per option with choices: after the option, only its choices complete.
effect fn writeChoices<Owner>(
  static command: Command<Owner>,
  static fields: Intrinsic.Fields<Owner>,
  static at: string<'static>,
  static fish: bool,
) -> ()
  ! WriterError
  ? &mut Writer {
  static for field in fields {
    let static option = Command.field(command, field)
    static if option.subcommand {
      run subcommandChoices(field, at, fish)
    } else {
      static if option.flatten {
        run groupChoices(field, at, fish)
      } else {
        static if !option.positional
          && StaticSequence.length<string<'static>>(option.choices) != 0 {
          let static long = StaticText.concat(
            StaticText.concat(at, ":"),
            OptionSpec.longFlag(option),
          )
          run Writer.writeString("    ")
          static if option.short != "" {
            let static short = StaticText.concat(
              StaticText.concat(at, ":"),
              OptionSpec.shortFlag(option),
            )
            static if fish {
              run Writer.writeString("case '")
              run Writer.writeString(long)
              run Writer.writeString("' '")
              run Writer.writeString(short)
              run Writer.writeString("'\n")
            } else {
              run Writer.writeString("\"")
              run Writer.writeString(long)
              run Writer.writeString("\"|\"")
              run Writer.writeString(short)
              run Writer.writeString("\") ")
            }
          } else {
            run writeArm(long, fish)
          }
          run writeWordList(choiceWords(option), fish)
          static if fish {
            run Writer.writeString("      return\n")
          }
        }
      }
    }
  }
}

effect fn subcommandChoices<Owner, Sub: CommandLine>(
  static field: Intrinsic.Field<Owner, Sub>,
  static at: string<'static>,
  static fish: bool,
) -> ()
  ! WriterError
  ? &mut Writer {
  let static command = commandOf<Sub>()
  return run choiceChoices<Sub>(command, at, fish)
}

effect fn choiceChoices<U>(
  static command: Command<U>,
  static at: string<'static>,
  static fish: bool,
) -> ()
  ! WriterError
  ? &mut Writer {
  static for variant in Reflect.variants<U>() {
    let static below = joinPath(at, kebab(Reflect.variantLabel(variant)))
    run writeChoices<U>(command, Reflect.variantFields(variant), below, fish)
  }
}

// The subcommand names of the variants of `U`, each followed by a space.
static fn variantWords<U>() -> string<'static> {
  let mut words = ""
  static for variant in Reflect.variants<U>() {
    words = StaticText.concat(StaticText.concat(words, kebab(Reflect.variantLabel(variant))), " ")
  }
  return words
}

static fn helpWords(version: string<'static>) -> string<'static> {
  if version != "" {
    return "--help -h --version"
  }
  return "--help -h"
}

// The words that complete among `fields`: options with their aliases, and the choices of
// positional arguments, each followed by a space.
static fn wordsOf<T>(command: Command<T>, fields: Intrinsic.Fields<T>) -> string<'static> {
  let mut words = ""
  static for field in fields {
    let option = Command.field(command, field)
    static if option.flatten {
      words = StaticText.concat(words, groupWords(field))
    } else {
      static if !option.subcommand {
        if option.positional {
          static for choice in option.choices {
            words = StaticText.concat(StaticText.concat(words, choice), " ")
          }
        } else {
          words = StaticText.concat(StaticText.concat(words, OptionSpec.longFlag(option)), " ")
          if option.short != "" {
            words = StaticText.concat(StaticText.concat(words, OptionSpec.shortFlag(option)), " ")
          }
        }
      }
    }
  }
  return words
}

static fn groupWords<Owner, Group: CommandLine>(field: Intrinsic.Field<Owner, Group>) -> string<
  'static
> {
  return wordsOf<Group>(commandOf<Group>(), Reflect.fields<Group>())
}

// Whether `fields` hold a positional argument without choices, which completes file names.
static fn takesFiles<T>(command: Command<T>, fields: Intrinsic.Fields<T>) -> bool {
  let mut files = false
  static for field in fields {
    let option = Command.field(command, field)
    if option.positional && StaticSequence.length<string<'static>>(option.choices) == 0 {
      files = true
    }
  }
  return files
}

static fn choiceWords(option: OptionSpec) -> string<'static> {
  let mut words = ""
  static for choice in option.choices {
    if words != "" {
      words = StaticText.concat(words, " ")
    }
    words = StaticText.concat(words, choice)
  }
  return words
}

static fn joinPath(path: string<'static>, label: string<'static>) -> string<'static> {
  if path == "" {
    return label
  }
  return StaticText.concat(StaticText.concat(path, "."), label)
}

// The command name with every byte that a shell function name cannot hold replaced by `_`.
static fn functionName(name: string<'static>) -> string<'static> {
  let allowed = "abcdefghijklmnopqrstuvwxyzABCDEFGHIJKLMNOPQRSTUVWXYZ0123456789_"
  let length = StaticText.byteLength(name)
  let mut result = ""
  let mut index: usize = 0
  while index < length {
    let byte = StaticText.byteAt(name, index)
    let mut kept = false
    let mut at: usize = 0
    while at < 63 {
      if StaticText.byteAt(allowed, at) == byte {
        kept = true
      }
      at = at + 1
    }
    if kept {
      result = StaticText.concat(result, StaticText.slice(name, index, index + 1))
    } else {
      result = StaticText.concat(result, "_")
    }
    index = index + 1
  }
  return result
}
