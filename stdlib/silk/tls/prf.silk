//! The TLS 1.2 pseudorandom function (RFC 5246 section 5) and the secrets that TLS 1.2 derives
//! with it: the extended master secret (RFC 7627), the key block, and Finished.
//!
//! # When to use
//! `silk.tls.client` and `silk.tls.server` use this module for TLS 1.2 handshakes. Use [`TlsPrf`]
//! directly only when you build your own TLS 1.2 endpoint, or to export keying material.
//!
//! # Details
//! The PRF is `P_SHA256` or `P_SHA384` over HMAC, selected by the cipher suite's hash. The master
//! secret is always the extended master secret, over the hash of the handshake messages through
//! ClientKeyExchange; this module has no form for the legacy master secret.
//!
//! # Gotchas
//! The functions do not check that the secrets came from a handshake. Secrets are not erased.
//!
//! # Examples
//! ## Expand a secret with the SHA-256 PRF
//! ```silk
//! import silk.tls.prf { TlsPrf }
//!
//! pub fn main() -> i32 {
//!   let secret: [u8; 16] = [155, 190, 67, 107, 169, 64, 240, 23, 177, 118, 82, 132, 154, 113, 219, 53]
//!   let seed: [u8; 16] = [160, 186, 159, 147, 108, 218, 49, 24, 39, 166, 247, 150, 255, 213, 25, 140]
//!   let mut output: [u8; 100] = [0; 100]
//!   TlsPrf.expand(32, &secret, "test label", &seed, &mut output)
//!   // The first bytes of the widely used TLS 1.2 PRF test vector.
//!   if output[0] != 227 || output[1] != 242 || output[99] == 0 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category TLS and certificates

import silk.crypto.hmac {HmacSha256, HmacSha384}
import silk.core.ownership {Copy}
import silk.tls.record {CipherSuite}
import silk.text.string {String}

/// The length of TLS 1.2 Finished `verify_data`.
pub const VERIFY_DATA_LENGTH: usize = 12

/// The TLS 1.2 traffic keys of one connection, from the key block (RFC 5246 section 6.3).
///
/// # Details
/// The key fields hold `keyLength` bytes and the IV fields hold `ivLength` bytes, followed by
/// zeros. The IV is the 4-byte salt for AES-GCM and the 12-byte IV for ChaCha20-Poly1305.
pub struct Tls12Keys {
  /// The client's write key.
  pub clientKey: [u8; 32],
  /// The server's write key.
  pub serverKey: [u8; 32],
  /// The client's fixed IV.
  pub clientIv: [u8; 12],
  /// The server's fixed IV.
  pub serverIv: [u8; 12],
  /// The key length: 16 for AES-128-GCM, 32 otherwise.
  pub keyLength: usize,
  /// The IV length: 4 for AES-GCM, 12 for ChaCha20-Poly1305.
  pub ivLength: usize,
}

impl Copy for Tls12Keys {}

/// The TLS 1.2 PRF and the secrets derived with it.
pub struct TlsPrf {}

impl TlsPrf {
  /// Fills `output` with `PRF(secret, label, seed)` (RFC 5246 section 5), with HMAC-SHA384 when
  /// `hashLength` is 48 and HMAC-SHA256 otherwise.
  pub fn expand(hashLength: usize, secret: &[u8], label: string, seed: &[u8], output: &mut [u8]) -> () {
    return TlsPrf.expandBytes(hashLength, secret, String.utf8Bytes(label), seed, move output)
  }

  /// Fills `output` with `PRF(secret, label, seed)`, as [`TlsPrf.expand`] does, for a label given
  /// as bytes.
  pub fn expandBytes(
    hashLength: usize,
    secret: &[u8],
    label: &[u8],
    seed: &[u8],
    output: &mut [u8],
  ) -> () {
    if hashLength == 48 {
      return expand384(secret, label, seed, move output)
    }
    return expand256(secret, label, seed, move output)
  }

  /// Returns the extended master secret (RFC 7627 section 4) for the suite's PRF, from the
  /// ECDHE shared secret `preMaster` and `sessionHash`, the hash of the handshake messages through
  /// ClientKeyExchange.
  pub fn extendedMasterSecret(suite: CipherSuite, preMaster: &[u8], sessionHash: &[u8]) -> [u8; 48] {
    let mut master: [u8; 48] = [0; 48]
    TlsPrf.expandBytes(
      suite.hashLength(),
      preMaster,
      b"extended master secret",
      sessionHash,
      &mut master,
    )
    return master
  }

  /// Returns the traffic keys of `suite` from the master secret and the two hello random values
  /// (RFC 5246 section 6.3).
  pub fn keys(
    suite: CipherSuite,
    master: &[u8; 48],
    clientRandom: &[u8; 32],
    serverRandom: &[u8; 32],
  ) -> Tls12Keys {
    let keyLength = suite.keyLength()
    let ivLength = suite.tls12IvLength()
    let mut seed: [u8; 64] = [0; 64]
    let mut index: usize = 0
    while index < 32 {
      seed[index] = serverRandom[index]
      seed[32 + index] = clientRandom[index]
      index = index + 1
    }
    let mut block: [u8; 88] = [0; 88]
    TlsPrf.expandBytes(suite.hashLength(), master, b"key expansion", &seed, &mut block)
    let mut keys = Tls12Keys {
      clientKey: [0; 32],
      serverKey: [0; 32],
      clientIv: [0; 12],
      serverIv: [0; 12],
      keyLength: keyLength,
      ivLength: ivLength,
    }
    index = 0
    while index < keyLength {
      keys.clientKey[index] = block[index]
      keys.serverKey[index] = block[keyLength + index]
      index = index + 1
    }
    index = 0
    while index < ivLength {
      keys.clientIv[index] = block[2 * keyLength + index]
      keys.serverIv[index] = block[2 * keyLength + ivLength + index]
      index = index + 1
    }
    return keys
  }

  /// Returns the Finished `verify_data` (RFC 5246 section 7.4.9) that the client sends when
  /// `client` is `true`, and the server's otherwise, over `handshakeHash`, the hash of the
  /// handshake messages before that Finished.
  pub fn finished(
    suite: CipherSuite,
    master: &[u8; 48],
    client: bool,
    handshakeHash: &[u8],
  ) -> [u8; 12] {
    let mut output: [u8; 12] = [0; 12]
    if client {
      TlsPrf.expandBytes(suite.hashLength(), master, b"client finished", handshakeHash, &mut output)
    } else {
      TlsPrf.expandBytes(suite.hashLength(), master, b"server finished", handshakeHash, &mut output)
    }
    return output
  }
}

fn expand256(secret: &[u8], label: &[u8], seed: &[u8], output: &mut [u8]) -> () {
  let mut first = HmacSha256.make(secret)
  first.update(label)
  first.update(seed)
  let mut chain = first.finish()
  let mut written: usize = 0
  while written < output.length {
    let mut block = HmacSha256.make(secret)
    block.update(&chain)
    block.update(label)
    block.update(seed)
    let bytes = block.finish()
    let mut index: usize = 0
    while index < 32 && written < output.length {
      output[written] = bytes[index]
      written = written + 1
      index = index + 1
    }
    chain = HmacSha256.authenticate(secret, &chain)
  }
  return ()
}

fn expand384(secret: &[u8], label: &[u8], seed: &[u8], output: &mut [u8]) -> () {
  let mut first = HmacSha384.make(secret)
  first.update(label)
  first.update(seed)
  let mut chain = first.finish()
  let mut written: usize = 0
  while written < output.length {
    let mut block = HmacSha384.make(secret)
    block.update(&chain)
    block.update(label)
    block.update(seed)
    let bytes = block.finish()
    let mut index: usize = 0
    while index < 48 && written < output.length {
      output[written] = bytes[index]
      written = written + 1
      index = index + 1
    }
    chain = HmacSha384.authenticate(secret, &chain)
  }
  return ()
}
