//! A trust anchor: a CA certificate that you trust, with optional limits that you add.
//!
//! # When to use
//! Make a [`TrustAnchor`] for each root CA that can start a certificate chain, and put the anchors
//! in a `TrustSnapshot`. Use [`TrustAnchor.fromCertificate`] to trust a certificate as it is. Use
//! [`TrustAnchor.fromCertificateWithConstraints`] to limit it more, for example to a maximum chain
//! length or to names under `example.com`.
//!
//! # Details
//! The anchor owns its certificate. The limits that you add are kept apart from the limits inside
//! the certificate, and path validation applies both.
//!
//! # Errors
//! - `ProfileError` from [`TrustAnchor.fromCertificateWithConstraints`] if the name constraints
//!   that you give are not valid or go over a limit.
//! - `OutOfMemoryError` if the `Allocator` fails.
//!
//! # Gotchas
//! Making an anchor gives a certificate full authority. It does not check the certificate, its
//! self-signature, or its dates. Anchor only certificates that you trust.
//!
//! @category TLS and certificates

import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.tls.certificate {Certificate}
import silk.tls.certificate_profile {
  CertificateProfile,
  ProfileClass,
  ProfileError,
  ProfileLimits,
  ProfileOffsetSpace,
  ProfileReason,
}
import silk.core.option {Option}
import silk.core.result {Result}
import silk.num.usize

/// A CA certificate that you trust, with optional limits on chain length and names.
///
/// # When to use
/// Make one for each root CA that can start a certificate chain, and put the anchors in a
/// `TrustSnapshot`. Use [`TrustAnchor.fromCertificate`] to trust a certificate as it is. Use
/// [`TrustAnchor.fromCertificateWithConstraints`] to limit it more.
///
/// # Details
/// The anchor owns its certificate. The limits that you add are kept apart from the limits inside
/// the certificate, and path validation applies both.
///
/// # Gotchas
/// Making an anchor gives a certificate full authority. It does not check the certificate, its
/// self-signature, or its dates. Anchor only certificates that you trust.
pub struct TrustAnchor {
  certificateValue: Certificate,
  hasPathLength: bool,
  pathLengthValue: usize,
  hasNameConstraints: bool,
  nameConstraintsValue: Bytes,
  encodedBytesValue: usize,
}

impl TrustAnchor {
  /// Returns an anchor for `certificate`, with no limits that you add. It does not allocate or
  /// check the certificate.
  pub fn fromCertificate(certificate: Certificate) -> TrustAnchor {
    let encoded = Certificate.der(&certificate).length
    return TrustAnchor {
      certificateValue: move certificate,
      hasPathLength: false,
      pathLengthValue: usize.ZERO,
      hasNameConstraints: false,
      nameConstraintsValue: Bytes.make(),
      encodedBytesValue: encoded,
    }
  }

  /// Returns an anchor for `certificate`, with a maximum chain length and name constraints that you
  /// add.
  ///
  /// `maximumPathLength` works like the `pathLenConstraint` of a basic constraints extension.
  /// `configuredNameConstraints` is the DER of a NameConstraints value. Only DNS and IP address
  /// constraints are supported. The anchor keeps a copy of it.
  ///
  /// # Errors
  /// - `Failure` with a `ProfileError` if the name constraints are not valid or go over `limits`.
  ///   The certificate is dropped.
  /// - `OutOfMemoryError` if the `Allocator` fails.
  pub effect fn fromCertificateWithConstraints(
    certificate: Certificate,
    maximumPathLength: Option<usize>,
    configuredNameConstraints: Option<&[u8]>,
    limits: ProfileLimits,
  ) -> Result<TrustAnchor, ProfileError>
  ! OutOfMemoryError
  ? &mut Allocator {
    let certificateBytes = Certificate.der(&certificate).length
    let pathPresent = match & maximumPathLength {
      Option<usize>.Some {..} => true
      Option<usize>.None => false
    }
    let pathValue = match move maximumPathLength {
      Option<usize>.Some {value} => value
      Option<usize>.None => usize.ZERO
    }
    return match move configuredNameConstraints {
      Option<&[u8]>.None => Result<TrustAnchor, ProfileError>.succeed(
        TrustAnchor {
          certificateValue: move certificate,
          hasPathLength: pathPresent,
          pathLengthValue: pathValue,
          hasNameConstraints: false,
          nameConstraintsValue: Bytes.make(),
          encodedBytesValue: certificateBytes,
        },
      )
      Option<&[u8]>.Some {value} => {
        let checked = CertificateProfile.validateConfiguredNameConstraints(value, limits)
        match move checked {
          Result<(), ProfileError>.Failure {error} => {
            return Result<TrustAnchor, ProfileError>.failResult(move error)
          }
          Result<(), ProfileError>.Success {..} => {}
        }
        let total = match move usize.checkedAdd(certificateBytes, value.length) {
          Option<usize>.Some {value: totalValue} => totalValue
          Option<usize>.None => {
            return Result<TrustAnchor, ProfileError>.failResult(
              ProfileError {
                kind: ProfileClass.ResourceLimit,
                reason: ProfileReason.SizeOverflow,
                extensionIndex: Option<usize>.none(),
                offsetSpace: ProfileOffsetSpace.ConfiguredConstraintDer,
                offset: 0,
              },
            )
          }
        }
        let copied = run Bytes.copy(value)
        return Result<TrustAnchor, ProfileError>.succeed(
          TrustAnchor {
            certificateValue: move certificate,
            hasPathLength: pathPresent,
            pathLengthValue: pathValue,
            hasNameConstraints: true,
            nameConstraintsValue: move copied,
            encodedBytesValue: total,
          },
        )
      }
    }
  }

  /// Returns a copy of the anchor, with its certificate and limits.
  ///
  /// # Errors
  /// - `OutOfMemoryError` if the `Allocator` fails. The original does not change.
  pub effect fn clone(self: &Self) -> TrustAnchor ! OutOfMemoryError ? &mut Allocator {
    let certificate = run Certificate.copy(&self.certificateValue)
    let constraints = run Bytes.copy(Bytes.asSlice(&self.nameConstraintsValue))
    return TrustAnchor {
      certificateValue: move certificate,
      hasPathLength: self.hasPathLength,
      pathLengthValue: self.pathLengthValue,
      hasNameConstraints: self.hasNameConstraints,
      nameConstraintsValue: move constraints,
      encodedBytesValue: self.encodedBytesValue,
    }
  }

  /// Returns the certificate of the anchor.
  pub fn certificate(self: &Self) -> &Certificate { return &self.certificateValue }

  /// Returns the maximum chain length that you added, or `None`.
  pub fn configuredPathLength(self: &Self) -> Option<usize> {
    if self.hasPathLength { return Option<usize>.some(self.pathLengthValue) }
    return Option<usize>.none()
  }

  /// Returns the DER of the name constraints that you added, or `None`.
  pub fn configuredNameConstraints(self: &Self) -> Option<&[u8]> {
    if self.hasNameConstraints {
      return Option<&[u8]>.some(Bytes.asSlice(&self.nameConstraintsValue))
    }
    return Option<&[u8]>.none()
  }

  /// Returns the size of the certificate DER plus the name constraint DER. Snapshot limits count
  /// this value.
  pub fn encodedBytes(self: &Self) -> usize { return self.encodedBytesValue }
}
