//! Decode a PEM file with one or more certificates, such as a certificate chain or a CA bundle.
//!
//! # When to use
//! Use [`CertificateBundle.decodePem`] for a chain file, such as the `fullchain.pem` of a server.
//! Use [`CertificateBundle.decodeAnnotatedPem`] for a CA bundle with comment lines between the
//! blocks, such as the files in `/etc/ssl/certs`. For exactly one certificate, use
//! `silk.tls.certificate`.
//!
//! # Details
//! A [`CertificateBundle`] keeps the certificates in input order, with duplicates. Each certificate
//! owns its DER. If any block fails, the call returns no bundle and releases what it decoded.
//!
//! # Errors
//! - `DecodeError` if a block is not valid or the input goes over a limit. `certificateIndex` tells
//!   you which block failed.
//! - `OutOfMemoryError` if the `Allocator` fails.
//!
//! # Gotchas
//! Decoding checks only the structure. It does not verify the signature, the chain, the names, or
//! the dates. Use `silk.tls.certificate_path` for that. The order of a bundle is the order of the file,
//! not a chain order.
//!
//! # Examples
//! ## Reject an empty file
//! ```silk
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.tls.certificate { DecodeError, DecodeLimits, DecodeReason }
//! import silk.tls.certificate_bundle { CertificateBundle }
//! import silk.core.effect { Effect }
//! import silk.core.result { Result }
//!
//! pub effect fn main() -> i32
//!   ! OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let decoded = run CertificateBundle.decodePem(b"\n", DecodeLimits.defaults())
//!     |> Effect.provideMut<Allocator>(&mut allocator)
//!   return match move decoded {
//!     Result<CertificateBundle, DecodeError>.Failure { error } => {
//!       if error.reason != DecodeReason.EmptyInput {
//!         return 1
//!       }
//!       return 0
//!     }
//!     Result<CertificateBundle, DecodeError>.Success { value: _ } => 1
//!   }
//! }
//! ```
//!
//! @category TLS and certificates

import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.tls.certificate {
  Certificate,
  DecodeLimits,
  DecodeError,
  DecodeClass,
  DecodeReason,
  DecodeOffsetSpace,
}
import silk.layout {Layout, LayoutOverflow}
import silk.option {Option}
import silk.core.result {Result}
import silk.tls.certificate_pem {Pem, PemBlock}
import silk.num.usize
import silk.collections.list {List}

/// A list of decoded certificates in input order. It owns them, and duplicates stay as separate
/// entries.
///
/// # When to use
///
/// Make one with [`CertificateBundle.decodePem`] for a chain file, such as the `fullchain.pem` of a
/// server, or with [`CertificateBundle.decodeAnnotatedPem`] for a CA bundle with comment lines
/// between the blocks. For exactly one certificate, use `silk.tls.certificate`.
///
/// # Gotchas
///
/// Decoding checks only the structure. It does not verify the signature, the chain, the names, or
/// the dates. Use `silk.tls.certificate_path` for that. The order is the order of the file, not a chain
/// order.
pub struct CertificateBundle {
  certificates: List<Certificate>,
}

impl CertificateBundle {
  /// Decodes all `CERTIFICATE` blocks of `input`, such as a chain file, in input order.
  ///
  /// Only `CERTIFICATE` blocks and spaces, tabs, CR, and LF between them are allowed. The limits
  /// count the whitespace and each duplicate.
  ///
  /// # Errors
  /// - `Failure` with a `DecodeError` for text outside the blocks, another label, a block that is
  ///   not valid, or a limit. No bundle is returned. `certificateIndex` tells which block failed.
  /// - `OutOfMemoryError` if the `Allocator` fails.
  ///
  /// # Gotchas
  /// Decoding checks only the structure. It does not verify the signature, the chain, the names,
  /// or the dates. Use `silk.tls.certificate_path` for that. The order is the order of the file, not a
  /// chain order.
  pub effect fn decodePem(input: &[u8], limits: DecodeLimits) -> Result<
    CertificateBundle,
    DecodeError,
  > ! OutOfMemoryError ? &mut Allocator {
    return run CertificateBundle.decodeDocument(input, limits, false)
  }

  /// Decodes all `CERTIFICATE` blocks of a CA file that has comment lines between them.
  ///
  /// Lines of printable text outside the blocks are ignored, and count toward `inputBytes`. Each
  /// block is decoded strictly.
  ///
  /// # Errors
  /// - `Failure` with a `DecodeError` for a block that is not valid, another label, a limit, or a
  ///   file without a block. No certificate is skipped.
  /// - `OutOfMemoryError` if the `Allocator` fails.
  ///
  /// # Gotchas
  /// Use it only for a CA file that you trust. Use [`CertificateBundle.decodePem`] for input from a
  /// peer.
  pub effect fn decodeAnnotatedPem(input: &[u8], limits: DecodeLimits) -> Result<CertificateBundle, DecodeError>
  ! OutOfMemoryError ? &mut Allocator {
    return run CertificateBundle.decodeDocument(input, limits, true)
  }

  effect fn decodeDocument(input: &[u8], limits: DecodeLimits, annotated: bool) -> Result<CertificateBundle, DecodeError>
  ! OutOfMemoryError ? &mut Allocator {
    if input.length > limits.inputBytes {
      return failed(DecodeClass.ResourceLimit, DecodeReason.InputBytes, 0, limits.inputBytes)
    }
    let mut offset = separator(input, 0, annotated)
    if offset == input.length {
      return failed(DecodeClass.Malformed, DecodeReason.EmptyInput, 0, offset)
    }
    let mut certificates = List<Certificate>.make()
    let mut total = usize.ZERO
    let mut capacity = usize.ZERO
    while offset < input.length {
      let index = List<Certificate>.length(&certificates)
      let next = run Pem.decodeNext(input, offset, limits, index, total)
      let block = match move next {
        Result<PemBlock, DecodeError>.Failure {error} => {
          return Result<CertificateBundle, DecodeError>.failResult(move error)
        }
        Result<PemBlock, DecodeError>.Success {value} => move value
      }
      let size = Bytes.length(&block.bytes)
      if size > usize.MAX - total {
        return failed(DecodeClass.ResourceLimit, DecodeReason.SizeOverflow, index, offset)
      }
      if total > limits.totalDerBytes || size > limits.totalDerBytes - total {
        return failed(DecodeClass.ResourceLimit, DecodeReason.TotalDerBytes, index, offset)
      }
      let mut remaining = limits
      remaining.totalDerBytes = limits.totalDerBytes - total
      let decoded = run Certificate.decodeDer(Bytes.asSlice(&block.bytes), remaining)
      let certificate = match move decoded {
        Result<Certificate, DecodeError>.Failure {error} => {
          let mut located = move error
          located.certificateIndex = index
          located.offsetSpace = DecodeOffsetSpace.Der
          return Result<CertificateBundle, DecodeError>.failResult(move located)
        }
        Result<Certificate, DecodeError>.Success {value} => move value
      }
      // Preflight geometric growth so no unchecked List growth arithmetic is reachable.
      if index == capacity {
        if capacity > usize.MAX / 2 {
          return failed(DecodeClass.ResourceLimit, DecodeReason.SizeOverflow, index, offset)
        }
        let mut nextCapacity = capacity * 2
        if nextCapacity == 0 {
          nextCapacity = 1
        }
        if nextCapacity > limits.certificates {
          nextCapacity = limits.certificates
        }
        let validLayout = match move Layout.repeat(Layout.of<Certificate>(), nextCapacity) {
          Layout ready => true
          LayoutOverflow overflow => false
        }
        if !validLayout {
          return failed(DecodeClass.ResourceLimit, DecodeReason.SizeOverflow, index, offset)
        }
        let reserved = run List<Certificate>.reserveExact(&mut certificates, nextCapacity - index)
        capacity = nextCapacity
      }
      let appended = run List<Certificate>.append(&mut certificates, move certificate)
      total = total + size
      offset = separator(input, block.nextOffset, annotated)
    }
    return Result<CertificateBundle, DecodeError>.succeed(
      CertificateBundle {certificates: move certificates},
    )
  }
  /// Returns the number of certificates, with duplicates.
  pub fn length(self: &Self) -> usize {
    return List<Certificate>.length(&self.certificates)
  }
  /// Returns the certificate at `index`, or `None` if `index` is out of range.
  pub fn get<'a>(self: &'a Self, index: usize) -> Option<&'a Certificate> {
    let values = List<Certificate>.asSlice(&self.certificates)
    if index >= values.length {
      return Option<&'a Certificate>.none()
    }
    return Option<&'a Certificate>.some(&values[index])
  }

  /// Returns the certificates as a list and consumes the bundle. It does not copy them.
  pub fn intoCertificates(self: Self) -> List<Certificate> {
    return match move self {
      CertificateBundle {certificates} => move certificates
    }
  }
}

fn failed(kind: DecodeClass, reason: DecodeReason, index: usize, offset: usize) -> Result<
  CertificateBundle,
  DecodeError,
> {
  return Result<CertificateBundle, DecodeError>.failResult(
    DecodeError {
      kind: kind,
      reason: reason,
      certificateIndex: index,
      offsetSpace: DecodeOffsetSpace.Input,
      offset: offset,
    },
  )
}

fn separator(input: &[u8], offset: usize, annotated: bool) -> usize {
  if annotated { return Pem.skipAnnotations(input, offset) }
  return Pem.skipWhitespace(input, offset)
}
