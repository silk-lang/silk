//! A fixed list of trust anchors: the root CAs that certificate path validation starts from.
//!
//! # When to use
//! Make a [`TrustSnapshot`] from your CA certificates with [`TrustSnapshot.fromPem`], or from
//! anchors with limits with [`TrustSnapshot.fromAnchors`]. Pass it to path validation or to a TLS
//! client. Use [`TrustSnapshot.combine`] to add your own CAs to another snapshot.
//!
//! # Details
//! A snapshot keeps its anchors in input order, with duplicates, and does not change after you make
//! it. [`SnapshotLimits`] and [`TrustLoadLimits`] bound its size. An empty snapshot is valid: it
//! trusts no certificate.
//!
//! # Errors
//! - [`TrustSourceError`] if a certificate is not valid, or a limit is exceeded.
//! - `OutOfMemoryError` if the `Allocator` fails.
//!
//! # Gotchas
//! A snapshot is only a list of authorities. It does not check chains, names, dates, or revocation,
//! and it is not the trust store of the operating system.
//!
//! # Examples
//! ## Make an empty snapshot
//! ```silk
//! import silk.collections.list { List }
//! import silk.core.result { Result }
//! import silk.tls.trust_anchor { TrustAnchor }
//! import silk.tls.trust_snapshot { SnapshotLimits, TrustSnapshot, TrustSourceError }
//!
//! pub fn main() -> i32 {
//!   return match TrustSnapshot.fromAnchors(List<TrustAnchor>.make(), SnapshotLimits.defaults()) {
//!     Result<TrustSnapshot, TrustSourceError>.Success { value } => {
//!       // An empty snapshot is valid, but no certificate chains to it.
//!       if TrustSnapshot.anchors(&value).length != 0 {
//!         return 1
//!       }
//!       return 0
//!     }
//!     Result<TrustSnapshot, TrustSourceError>.Failure { error: _ } => 1
//!   }
//! }
//! ```
//!
//! @category TLS and certificates

import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.tls.certificate {Certificate, DecodeError, DecodeLimits}
import silk.tls.certificate_bundle {CertificateBundle}
import silk.system.filesystem {FileError}
import silk.format {Debug, Format, Formatter}
import silk.layout {Layout, LayoutOverflow}
import silk.option {Option}
import silk.core.ownership {Copy}
import silk.core.result {Result}
import silk.tls.trust_anchor {TrustAnchor}
import silk.num.usize
import silk.collections.list {List}
import silk.io.writer {Writer, WriterError}

/// The limits for one snapshot. Each limit is inclusive, and 0 allows nothing.
pub struct SnapshotLimits {
  /// The maximum number of anchors, with duplicates.
  pub anchors: usize,
  /// The maximum size of all anchors, as [`TrustAnchor.encodedBytes`] counts it.
  pub encodedBytes: usize,
}

impl Copy for SnapshotLimits {}

impl SnapshotLimits {
  /// Returns the default limits: 1024 anchors and 8 MiB.
  pub fn defaults() -> SnapshotLimits {
    return SnapshotLimits {anchors: 1024, encodedBytes: 8388608}
  }
}

/// The limits for loading trust: the certificate decoder limits and the snapshot limits.
pub struct TrustLoadLimits {
  /// The limits for decoding PEM and certificates.
  pub decode: DecodeLimits,
  /// The limits for the snapshot.
  pub snapshot: SnapshotLimits,
}

impl Copy for TrustLoadLimits {}

impl TrustLoadLimits {
  /// Returns `DecodeLimits.defaults()` and [`SnapshotLimits.defaults`].
  pub fn defaults() -> TrustLoadLimits {
    return TrustLoadLimits {decode: DecodeLimits.defaults(), snapshot: SnapshotLimits.defaults()}
  }
}

/// The limit that a trust load exceeded.
pub enum TrustLimitKind {
  /// The number of anchors.
  AnchorCount,
  /// The size of all anchors.
  EncodedBytes,
  /// The size of a file that a native trust source reads.
  InputBytes
}

impl Debug for TrustLimitKind {
  /// Writes the name of the variant, such as `AnchorCount`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      TrustLimitKind.AnchorCount => run Format.write(&mut formatter, b"AnchorCount")
      TrustLimitKind.EncodedBytes => run Format.write(&mut formatter, b"EncodedBytes")
      TrustLimitKind.InputBytes => run Format.write(&mut formatter, b"InputBytes")
    }
  }
}

/// The reason that the configuration of a native trust source is not valid.
pub enum TrustConfigurationReason {
  /// A root file path is empty.
  EmptyRoot,
  /// A root file path is not absolute.
  NonAbsoluteRoot,
  /// A root file path contains a zero byte.
  NulRoot,
  /// A root file path is too long.
  PathBytes
}

impl Debug for TrustConfigurationReason {
  /// Writes the name of the variant, such as `EmptyRoot`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      TrustConfigurationReason.EmptyRoot => run Format.write(&mut formatter, b"EmptyRoot")
      TrustConfigurationReason.NonAbsoluteRoot => run Format.write(&mut formatter, b"NonAbsoluteRoot")
      TrustConfigurationReason.NulRoot => run Format.write(&mut formatter, b"NulRoot")
      TrustConfigurationReason.PathBytes => run Format.write(&mut formatter, b"PathBytes")
    }
  }
}

/// The file step that failed in a native trust source.
pub enum TrustFileOperation {
  /// Opening the trust file.
  Open,
  /// Reading the trust file.
  Read,
  /// Closing the trust file.
  Close
}

impl Debug for TrustFileOperation {
  /// Writes the name of the variant, such as `Open`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      TrustFileOperation.Open => run Format.write(&mut formatter, b"Open")
      TrustFileOperation.Read => run Format.write(&mut formatter, b"Read")
      TrustFileOperation.Close => run Format.write(&mut formatter, b"Close")
    }
  }
}

/// The reason that loading trust failed. An allocation failure is an `OutOfMemoryError` instead.
pub union TrustSourceError {
  /// A certificate or its PEM is not valid.
  Decode {
    /// The decoder error, with its position.
    pub error: DecodeError,
  },
  /// A limit was exceeded.
  LimitExceeded {
    /// The limit.
    pub kind: TrustLimitKind,
    /// The value of the limit.
    pub limit: usize,
  },
  /// The configuration of a native trust source is not valid.
  InvalidConfiguration {
    /// The problem.
    pub reason: TrustConfigurationReason,
  },
  /// A file operation of a native trust source failed.
  File {
    /// The step that failed.
    pub operation: TrustFileOperation,
    /// The file error.
    pub error: FileError,
  }
}

impl Debug for TrustSourceError {
  /// Writes the name of the variant and its fields, such as `Decode { ... }`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      TrustSourceError.Decode { error } => {
        let mut record = run Format.debugRecord("Decode", &mut formatter)
        run Format.debugField(&mut record, "error", &error, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      TrustSourceError.LimitExceeded { kind, limit } => {
        let mut record = run Format.debugRecord("LimitExceeded", &mut formatter)
        run Format.debugField(&mut record, "kind", &kind, &mut formatter)
        run Format.debugField(&mut record, "limit", &limit, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      TrustSourceError.InvalidConfiguration { reason } => {
        let mut record = run Format.debugRecord("InvalidConfiguration", &mut formatter)
        run Format.debugField(&mut record, "reason", &reason, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      TrustSourceError.File { operation, error } => {
        let mut record = run Format.debugRecord("File", &mut formatter)
        run Format.debugField(&mut record, "operation", &operation, &mut formatter)
        run Format.debugField(&mut record, "error", &error, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
    }
  }
}

/// A list of trust anchors that does not change. It owns them and keeps their order and duplicates.
///
/// # When to use
/// Make one from your CA certificates with [`TrustSnapshot.fromPem`], or from anchors with limits
/// with [`TrustSnapshot.fromAnchors`]. Pass it to path validation or to a TLS client. Use
/// [`TrustSnapshot.combine`] to add your own CAs to another snapshot.
///
/// # Details
/// [`SnapshotLimits`] and [`TrustLoadLimits`] bound its size. An empty snapshot is valid: it trusts
/// no certificate.
///
/// # Gotchas
/// A snapshot is only a list of authorities. It does not check chains, names, dates, or
/// revocation, and it is not the trust store of the operating system.
pub struct TrustSnapshot {
  anchorsValue: List<TrustAnchor>,
}

impl TrustSnapshot {
  /// Returns a snapshot with `anchors`, in their order. It does not copy them.
  ///
  /// An empty list is valid.
  ///
  /// # Errors
  /// - `LimitExceeded` if `anchors` goes over `limits`. The anchors are dropped.
  pub fn fromAnchors(
    anchors: List<TrustAnchor>,
    limits: SnapshotLimits,
  ) -> Result<TrustSnapshot, TrustSourceError> {
    let exceeded = validateAnchors(List<TrustAnchor>.asSlice(&anchors), limits)
    return match move exceeded {
      Option<TrustLimitKind>.Some {value: kind} => {
        return limitFailure(kind, selectedLimit(kind, limits))
      }
      Option<TrustLimitKind>.None => {
        return Result<TrustSnapshot, TrustSourceError>.succeed(
          TrustSnapshot {anchorsValue: move anchors},
        )
      }
    }
  }

  /// Returns a snapshot with one anchor without limits for each `CERTIFICATE` block of `input`.
  ///
  /// # Errors
  /// - `Failure` with `Decode` if the PEM or a certificate is not valid. The decoder is strict, and
  ///   an empty file is an error.
  /// - `Failure` with `LimitExceeded` if a limit is exceeded.
  /// - `OutOfMemoryError` if the `Allocator` fails.
  pub effect fn fromPem(
    input: &[u8],
    limits: TrustLoadLimits,
  ) -> Result<TrustSnapshot, TrustSourceError>
  ! OutOfMemoryError
  ? &mut Allocator {
    let decoded = run CertificateBundle.decodePem(input, limits.decode)
    return run TrustSnapshot.importBundle(move decoded, limits)
  }

  /// Returns a snapshot from a CA file that has comment lines between the blocks.
  ///
  /// It uses `CertificateBundle.decodeAnnotatedPem`. A certificate that is not valid fails the
  /// whole call. None are skipped.
  ///
  /// # Errors
  /// - The same errors as [`TrustSnapshot.fromPem`].
  ///
  /// # Gotchas
  /// Use it only for a CA file that you configured and trust, never for data from a peer.
  pub effect fn fromAnnotatedPem(input: &[u8], limits: TrustLoadLimits) -> Result<TrustSnapshot, TrustSourceError>
  ! OutOfMemoryError ? &mut Allocator {
    let decoded = run CertificateBundle.decodeAnnotatedPem(input, limits.decode)
    return run TrustSnapshot.importBundle(move decoded, limits)
  }

  effect fn importBundle(decoded: Result<CertificateBundle, DecodeError>, limits: TrustLoadLimits) -> Result<TrustSnapshot, TrustSourceError>
  ! OutOfMemoryError ? &mut Allocator {
    let bundle = match move decoded {
      Result<CertificateBundle, DecodeError>.Failure {error} => {
        return Result<TrustSnapshot, TrustSourceError>.failResult(
          TrustSourceError.Decode {error: move error},
        )
      }
      Result<CertificateBundle, DecodeError>.Success {value} => move value
    }
    let mut certificates = CertificateBundle.intoCertificates(move bundle)
    let total = List<Certificate>.length(&certificates)
    if total > limits.snapshot.anchors {
      return limitFailure(TrustLimitKind.AnchorCount, limits.snapshot.anchors)
    }
    if !validateAnchorLayout(total) {
      return limitFailure(TrustLimitKind.AnchorCount, limits.snapshot.anchors)
    }
    if !validateCertificateBytes(&certificates, limits.snapshot.encodedBytes) {
      return limitFailure(TrustLimitKind.EncodedBytes, limits.snapshot.encodedBytes)
    }
    let mut anchors = List<TrustAnchor>.make()
    let reserved = run List<TrustAnchor>.reserveExact(&mut anchors, total)
    let mut moved = usize.ZERO
    while moved < total {
      let certificate = List<Certificate>.remove(&mut certificates, usize.ZERO)
      let anchor = TrustAnchor.fromCertificate(move certificate)
      let appended = run List<TrustAnchor>.append(&mut anchors, move anchor)
      moved = moved + usize.ONE
    }
    return TrustSnapshot.fromAnchors(move anchors, limits.snapshot)
  }

  /// Returns the anchors in their order, with duplicates.
  pub fn anchors(self: &Self) -> &[TrustAnchor] {
    return List<TrustAnchor>.asSlice(&self.anchorsValue)
  }

  /// Returns a copy of the snapshot that is checked against `limits`.
  ///
  /// # Errors
  /// - `Failure` with `LimitExceeded` if the snapshot goes over `limits`.
  /// - `OutOfMemoryError` if the `Allocator` fails.
  pub effect fn copy(
    self: &Self,
    limits: SnapshotLimits,
  ) -> Result<TrustSnapshot, TrustSourceError>
  ! OutOfMemoryError
  ? &mut Allocator {
    let values = TrustSnapshot.anchors(self)
    let exceeded = validateAnchors(values, limits)
    match move exceeded {
      Option<TrustLimitKind>.Some {value: kind} => {
        return limitFailure(kind, selectedLimit(kind, limits))
      }
      Option<TrustLimitKind>.None => {}
    }
    if !validateAnchorLayout(values.length) {
      return limitFailure(TrustLimitKind.AnchorCount, limits.anchors)
    }
    let mut copied = List<TrustAnchor>.make()
    let reserved = run List<TrustAnchor>.reserveExact(&mut copied, values.length)
    let mut index = usize.ZERO
    while index < values.length {
      let anchor = run TrustAnchor.clone(&values[index])
      let appended = run List<TrustAnchor>.append(&mut copied, move anchor)
      index = index + usize.ONE
    }
    return Result<TrustSnapshot, TrustSourceError>.succeed(
      TrustSnapshot {anchorsValue: move copied},
    )
  }

  /// Returns a new snapshot with the anchors of `primary` and then those of `additional`.
  ///
  /// Duplicates are kept. Equal certificates are not merged.
  ///
  /// # Errors
  /// - `Failure` with `LimitExceeded` if the result goes over `limits`.
  /// - `OutOfMemoryError` if the `Allocator` fails.
  ///
  /// # Gotchas
  /// An anchor in `additional` with fewer limits than the same certificate in `primary` makes the
  /// trust wider.
  pub effect fn combine(
    primary: &TrustSnapshot,
    additional: &TrustSnapshot,
    limits: SnapshotLimits,
  ) -> Result<TrustSnapshot, TrustSourceError>
  ! OutOfMemoryError
  ? &mut Allocator {
    let first = TrustSnapshot.anchors(primary)
    let second = TrustSnapshot.anchors(additional)
    let count = match move usize.checkedAdd(first.length, second.length) {
      Option<usize>.Some {value} => value
      Option<usize>.None => {
        return limitFailure(TrustLimitKind.AnchorCount, limits.anchors)
      }
    }
    if count > limits.anchors {
      return limitFailure(TrustLimitKind.AnchorCount, limits.anchors)
    }
    if !validateAnchorLayout(count) {
      return limitFailure(TrustLimitKind.AnchorCount, limits.anchors)
    }
    if !validateCombined(first, second, limits.encodedBytes) {
      return limitFailure(TrustLimitKind.EncodedBytes, limits.encodedBytes)
    }
    let mut combined = List<TrustAnchor>.make()
    let reserved = run List<TrustAnchor>.reserveExact(&mut combined, count)
    let mut firstIndex = usize.ZERO
    while firstIndex < first.length {
      let anchor = run TrustAnchor.clone(&first[firstIndex])
      let appended = run List<TrustAnchor>.append(&mut combined, move anchor)
      firstIndex = firstIndex + usize.ONE
    }
    let mut secondIndex = usize.ZERO
    while secondIndex < second.length {
      let anchor = run TrustAnchor.clone(&second[secondIndex])
      let appended = run List<TrustAnchor>.append(&mut combined, move anchor)
      secondIndex = secondIndex + usize.ONE
    }
    return Result<TrustSnapshot, TrustSourceError>.succeed(
      TrustSnapshot {anchorsValue: move combined},
    )
  }
}

fn validateAnchors(
  anchors: &[TrustAnchor],
  limits: SnapshotLimits,
) -> Option<TrustLimitKind> {
  if anchors.length > limits.anchors {
    return Option<TrustLimitKind>.some(TrustLimitKind.AnchorCount)
  }
  let encoded = validateEncoded(anchors, limits.encodedBytes, usize.ZERO)
  return match move encoded {
    Result<usize, TrustLimitKind>.Failure {error: kind} => {
      return Option<TrustLimitKind>.some(kind)
    }
    Result<usize, TrustLimitKind>.Success {value: ignored} => {
      return Option<TrustLimitKind>.none()
    }
  }
}

fn validateAnchorLayout(count: usize) -> bool {
  let planned = Layout.repeat(Layout.of<TrustAnchor>(), count)
  return match move planned {
    Layout ready => true
    LayoutOverflow overflow => false
  }
}

fn validateCertificateBytes(
  certificates: &List<Certificate>,
  limit: usize,
) -> bool {
  let values = List<Certificate>.asSlice(certificates)
  let mut total = usize.ZERO
  let mut index = usize.ZERO
  while index < values.length {
    let size = Certificate.der(&values[index]).length
    total = match move usize.checkedAdd(total, size) {
      Option<usize>.Some {value} => value
      Option<usize>.None => { return false }
    }
    if total > limit {
      return false
    }
    index = index + usize.ONE
  }
  return true
}

fn validateCombined(
  primary: &[TrustAnchor],
  additional: &[TrustAnchor],
  limit: usize,
) -> bool {
  let first = validateEncoded(primary, limit, usize.ZERO)
  let subtotal = match move first {
    Result<usize, TrustLimitKind>.Failure {error} => { return false }
    Result<usize, TrustLimitKind>.Success {value} => value
  }
  let second = validateEncoded(additional, limit, subtotal)
  return match move second {
    Result<usize, TrustLimitKind>.Failure {error} => false
    Result<usize, TrustLimitKind>.Success {value: ignored} => true
  }
}

fn validateEncoded(
  anchors: &[TrustAnchor],
  limit: usize,
  initial: usize,
) -> Result<usize, TrustLimitKind> {
  let mut total = initial
  let mut index = usize.ZERO
  while index < anchors.length {
    total = match move usize.checkedAdd(total, TrustAnchor.encodedBytes(&anchors[index])) {
      Option<usize>.Some {value} => value
      Option<usize>.None => {
        return Result<usize, TrustLimitKind>.failResult(TrustLimitKind.EncodedBytes)
      }
    }
    if total > limit {
      return Result<usize, TrustLimitKind>.failResult(TrustLimitKind.EncodedBytes)
    }
    index = index + usize.ONE
  }
  return Result<usize, TrustLimitKind>.succeed(total)
}

fn selectedLimit(kind: TrustLimitKind, limits: SnapshotLimits) -> usize {
  if kind == TrustLimitKind.AnchorCount { return limits.anchors }
  return limits.encodedBytes
}

fn limitFailure(
  kind: TrustLimitKind,
  limit: usize,
) -> Result<TrustSnapshot, TrustSourceError> {
  return Result<TrustSnapshot, TrustSourceError>.failResult(
    TrustSourceError.LimitExceeded {kind: kind, limit: limit},
  )
}
