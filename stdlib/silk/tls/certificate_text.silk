//! Text forms of certificate fields as OpenSSL prints them: object names, distinguished names,
//! validity times, and serial numbers.
//!
//! # When to use
//! Use it to show a certificate the way OpenSSL and Node.js do, such as `X509Certificate.subject`,
//! `issuer`, `validFrom`, `serialNumber`, and `signatureAlgorithm` in Node.js, or the `DirName`
//! entries of `subjectAltName`.
//!
//! # Details
//! [`CertificateText.objectName`] looks up the short and long names of an object identifier in
//! the object table of OpenSSL 3.0, and [`CertificateText.writeObjectIdentifier`] writes the
//! dotted form, such as `1.2.840.113549.1.1.11`.
//!
//! [`CertificateText.writeName`] writes a DER `Name`, such as [`Certificate.subjectDer`], in one
//! of the [`NameTextFormat`] layouts. It decodes BMPString, UniversalString, and the 8-bit string
//! types to UTF-8 and escapes as RFC 2253 does. It checks the strings as OpenSSL does when it
//! reads a name, so a name that OpenSSL rejects is an error here too.
//!
//! [`CertificateText.writeTime`] writes a [`CertificateTime`] as `Jan  2 03:04:05 2025 GMT`, and
//! [`CertificateText.writeSerial`] writes a serial number in upper-case hexadecimal.
//!
//! # Errors
//! - [`CertificateTextError`] for DER that is not valid, or an output that is too short.
//!
//! # Gotchas
//! The text is for display and logs. Compare names by their DER, not by this text: two
//! different names can print the same. The object table is the one of OpenSSL 3.0, so a
//! newer identifier prints in dotted form.
//!
//! # Examples
//! ## Print a subject
//! ```silk
//! import silk.core.result { Result }
//! import silk.collections.slice { Slice }
//! import silk.tls.certificate_text { CertificateText, CertificateTextError, NameTextFormat }
//!
//! pub fn main() -> i32 {
//!   // SEQUENCE { SET { SEQUENCE { commonName, UTF8String "a,b" } } }
//!   let name = b"\x30\x0e\x31\x0c\x30\x0a\x06\x03\x55\x04\x03\x0c\x03\x61\x2c\x62"
//!   let mut text: [u8; 16] = [0; 16]
//!   let length = match CertificateText.writeName(name, NameTextFormat.Multiline, &mut text) {
//!     Result<usize, CertificateTextError>.Success { value } => value
//!     Result<usize, CertificateTextError>.Failure { error: _ } => {
//!       return 1
//!     }
//!   }
//!   // The comma is escaped: CN=a\,b
//!   if length != 7 || text[4] != 92 {
//!     return 2
//!   }
//!   return 42
//! }
//! ```
//!
//! @category TLS and certificates

import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.tls.certificate { CertificateTime }
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.usize

/// The reason that a certificate field could not be written as text.
pub enum CertificateTextError {
  /// The DER is not valid, not minimal, has bytes after it, or holds a string that OpenSSL
  /// rejects, such as a UTF8String that is not UTF-8.
  InvalidEncoding,
  /// The output is shorter than the text. Its first bytes may have been written.
  OutputTooSmall,
}

/// How [`CertificateText.writeName`] lays out a distinguished name.
pub enum NameTextFormat {
  /// One attribute per line in the order of the DER, such as `C=US\nO=Example\nCN=example.com`,
  /// with ` + ` between the attributes of one RDN. Control characters are escaped as `\XX`.
  /// Node.js uses it for `X509Certificate.subject` and `issuer` (OpenSSL's
  /// `XN_FLAG_SEP_MULTILINE` with `ASN1_STRFLGS_ESC_2253`, `ESC_CTRL`, and `UTF8_CONVERT`).
  Multiline,
  /// RFC 2253: the RDNs in reverse order, separated by `,`, with `+` inside an RDN, such as
  /// `CN=example.com,O=Example,C=US`. An attribute with an unknown type, or a value that is not
  /// a string, is written as `#` and the hexadecimal DER of the value. Control characters are
  /// not escaped. Node.js uses it for the `DirName` entries of `subjectAltName` (OpenSSL's
  /// `XN_FLAG_RFC2253` without `ESC_CTRL` and `ESC_MSB`).
  Rfc2253,
}

/// The names of an object identifier in the object table of OpenSSL.
pub struct ObjectName {
  /// The DER content of the object identifier, such as `\x55\x04\x03` for 2.5.4.3.
  pub identifier: &'static [u8],
  /// The short name, such as `CN` or `RSA-SHA256`.
  pub shortName: &'static [u8],
  /// The long name, such as `commonName` or `sha256WithRSAEncryption`.
  pub longName: &'static [u8],
}

impl Copy for ObjectName {}

/// Functions that write certificate fields as text.
pub struct CertificateText {}

impl CertificateText {
  /// Returns the names of the object identifier whose DER content is `identifier`, or `None`
  /// when the object table of OpenSSL has no entry for it.
  pub fn objectName(identifier: &[u8]) -> Option<ObjectName> {
    let table = objectTable()
    let mut offset: usize = 0
    while offset < table.length {
      let entry = tableEntry(table, offset)
      if equal(entry.name.identifier, identifier) {
        return Option<ObjectName>.some(entry.name)
      }
      offset = entry.next
    }
    return Option<ObjectName>.none()
  }

  /// Returns the object whose short name or long name is `name`, as OpenSSL's `OBJ_txt2nid`
  /// finds it: short names first, then long names. The match is exact and case-sensitive.
  pub fn namedObject(name: &[u8]) -> Option<ObjectName> {
    let table = objectTable()
    let mut pass: usize = 0
    while pass < 2 {
      let mut offset: usize = 0
      while offset < table.length {
        let entry = tableEntry(table, offset)
        let candidate = if pass == 0 { entry.name.shortName } else { entry.name.longName }
        if equal(candidate, name) {
          return Option<ObjectName>.some(entry.name)
        }
        offset = entry.next
      }
      pass = pass + 1
    }
    return Option<ObjectName>.none()
  }

  /// Returns the length in bytes of [`CertificateText.writeObjectIdentifier`].
  ///
  /// # Errors
  /// - `InvalidEncoding` as with [`CertificateText.writeObjectIdentifier`].
  pub fn objectIdentifierLength(identifier: &[u8]) -> Result<usize, CertificateTextError> {
    let mut scratch: [u8; 1] = [0; 1]
    return finished(writeIdentifier(identifier, Slice.viewMut<u8>(&mut scratch, 0, 0), 0), 0, true)
  }

  /// Writes the dotted form of the object identifier whose DER content is `identifier`, such as
  /// `2.5.4.3`, to the start of `output` and returns its length, as OpenSSL's `OBJ_obj2txt`
  /// does with numeric output.
  ///
  /// # Errors
  /// - `InvalidEncoding` if `identifier` is empty, a sub-identifier has a leading `0x80` byte or
  ///   is not finished, or an arc has more than 1024 decimal digits.
  /// - `OutputTooSmall` if `output` is shorter than the text.
  pub fn writeObjectIdentifier(identifier: &[u8], output: &mut [u8]) -> Result<
    usize,
    CertificateTextError,
  > {
    let capacity = output.length
    return finished(writeIdentifier(identifier, &mut output, 0), capacity, false)
  }

  /// Returns the length in bytes of [`CertificateText.writeName`].
  ///
  /// # Errors
  /// - `InvalidEncoding` as with [`CertificateText.writeName`].
  pub fn nameLength(name: &[u8], format: NameTextFormat) -> Result<usize, CertificateTextError> {
    let mut scratch: [u8; 1] = [0; 1]
    return finished(writeNameText(name, format, Slice.viewMut<u8>(&mut scratch, 0, 0)), 0, true)
  }

  /// Writes the DER `Name` `name` as text in `format` to the start of `output` and returns its
  /// length. An empty name is empty text.
  ///
  /// # Details
  /// Each attribute is its short name from the object table, or its dotted identifier, then `=`
  /// and the value. A UTF8String is written as it is, the 8-bit string types as Latin-1, and
  /// BMPString and UniversalString as UTF-8. `"`, `+`, `,`, `;`, `<`, `>`, and `\` are escaped
  /// with `\`, and so are a leading space or `#` and a trailing space.
  ///
  /// # Errors
  /// - `InvalidEncoding` if the DER is not valid or not minimal, or a value is a type or string
  ///   that OpenSSL rejects in a name: a UTF8String that is not UTF-8, a BMPString or
  ///   UniversalString with a surrogate or a bad length, or a tag such as INTEGER.
  /// - `OutputTooSmall` if `output` is shorter than the text.
  pub fn writeName(name: &[u8], format: NameTextFormat, output: &mut [u8]) -> Result<
    usize,
    CertificateTextError,
  > {
    let capacity = output.length
    return finished(writeNameText(name, format, &mut output), capacity, false)
  }

  /// Writes `time` as OpenSSL's `ASN1_TIME_print` does, such as `Jan  2 03:04:05 2025 GMT`, to
  /// the start of `output` and returns its length. The day is padded to two places with a
  /// space and the year is not padded.
  pub fn writeTime(time: CertificateTime, output: &mut [u8; 24]) -> usize {
    let months = b"JanFebMarAprMayJunJulAugSepOctNovDec"
    let month = u8.toUsize(time.month) - 1
    let mut at: usize = 0
    while at < 3 {
      output[at] = months[3 * month + at]
      at = at + 1
    }
    output[3] = 32
    if time.day < 10 {
      output[4] = 32
    } else {
      output[4] = 48 + time.day / 10
    }
    output[5] = 48 + time.day % 10
    output[6] = 32
    twoDigits(&mut output, 7, time.hour)
    output[9] = 58
    twoDigits(&mut output, 10, time.minute)
    output[12] = 58
    twoDigits(&mut output, 13, time.second)
    output[15] = 32
    at = 16
    let mut divisor: u16 = 1000
    let mut started = false
    while divisor > 0 {
      let digit = (time.year / divisor) % 10
      if digit != 0 || started || divisor == 1 {
        output[at] = 48 + u16.toU8(digit)
        at = at + 1
        started = true
      }
      divisor = divisor / 10
    }
    output[at] = 32
    output[at + 1] = 71
    output[at + 2] = 77
    output[at + 3] = 84
    return at + 4
  }

  /// Returns the length in bytes of [`CertificateText.writeSerial`].
  ///
  /// # Errors
  /// - `InvalidEncoding` if `serial` is empty.
  pub fn serialLength(serial: &[u8]) -> Result<usize, CertificateTextError> {
    let mut scratch: [u8; 1] = [0; 1]
    return finished(writeSerialText(serial, Slice.viewMut<u8>(&mut scratch, 0, 0)), 0, true)
  }

  /// Writes the big-endian signed integer `serial`, such as [`Certificate.serial`], in
  /// upper-case hexadecimal to the start of `output` and returns its length, as OpenSSL's
  /// `BN_bn2hex` does: whole bytes without leading zero bytes, such as `0A1B`, `0` for zero,
  /// and `-` before the magnitude of a negative number.
  ///
  /// # Errors
  /// - `InvalidEncoding` if `serial` is empty.
  /// - `OutputTooSmall` if `output` is shorter than the text.
  pub fn writeSerial(serial: &[u8], output: &mut [u8]) -> Result<usize, CertificateTextError> {
    let capacity = output.length
    return finished(writeSerialText(serial, &mut output), capacity, false)
  }
}

// Turns the full text length into the result of a write into `capacity` bytes.
fn finished(length: Option<usize>, capacity: usize, measuring: bool) -> Result<
  usize,
  CertificateTextError,
> {
  return match length {
    Option<usize>.None => Result<usize, CertificateTextError>.failResult(
      CertificateTextError.InvalidEncoding,
    )
    Option<usize>.Some { value } => {
      if value > capacity && !measuring {
        return Result<usize, CertificateTextError>.failResult(CertificateTextError.OutputTooSmall)
      }
      Result<usize, CertificateTextError>.succeed(value)
    }
  }
}

fn equal(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut i: usize = 0
  while i < left.length {
    if left[i] != right[i] {
      return false
    }
    i = i + 1
  }
  return true
}

struct TableEntry {
  name: ObjectName,
  next: usize,
}

fn tableEntry(table: &'static [u8], offset: usize) -> TableEntry {
  let identifierLength = u8.toUsize(table[offset])
  let shortAt = offset + 1 + identifierLength
  let shortLength = u8.toUsize(table[shortAt])
  let longAt = shortAt + 1 + shortLength
  let longLength = u8.toUsize(table[longAt])
  return TableEntry {
    name: ObjectName {
      identifier: Slice.view<u8>(table, offset + 1, identifierLength),
      shortName: Slice.view<u8>(table, shortAt + 1, shortLength),
      longName: Slice.view<u8>(table, longAt + 1, longLength),
    },
    next: longAt + 1 + longLength,
  }
}

// Writes `byte` at `at` when it fits and returns the next position. The writers below keep
// counting past the end of `output`, so the same code measures and writes.
fn put(output: &mut [u8], at: usize, byte: u8) -> usize {
  if at < output.length {
    output[at] = byte
  }
  return at + 1
}

fn putAll(output: &mut [u8], at: usize, bytes: &[u8]) -> usize {
  let mut position = at
  let mut i: usize = 0
  while i < bytes.length {
    position = put(&mut output, position, bytes[i])
    i = i + 1
  }
  return position
}

fn hexDigit(value: u8) -> u8 {
  if value < 10 {
    return 48 + value
  }
  return 55 + value
}

fn putHex(output: &mut [u8], at: usize, byte: u8) -> usize {
  let position = put(&mut output, at, hexDigit(byte / 16))
  return put(&mut output, position, hexDigit(byte % 16))
}

fn twoDigits(output: &mut [u8; 24], at: usize, value: u8) -> () {
  output[at] = 48 + value / 10
  output[at + 1] = 48 + value % 10
}

// The decimal digits of one arc, least significant first.
struct Decimal {
  digits: [u8; 1024],
  count: usize,
}

// Writes the decimal form of the base-128 sub-identifier identifier[start..end]. The first
// sub-identifier holds two arcs, 40 * X + Y, and writes both.
fn writeArc(
  identifier: &[u8],
  start: usize,
  end: usize,
  first: bool,
  output: &mut [u8],
  at: usize,
) -> Option<usize> {
  let mut decimal = Decimal { digits: [0; 1024], count: 0 }
  let mut i = start
  while i < end {
    let mut carry = u8.toU32(u8.bitAnd(identifier[i], 127))
    let mut d: usize = 0
    while d < decimal.count {
      let value = u8.toU32(decimal.digits[d]) * 128 + carry
      decimal.digits[d] = u32.toU8(value % 10)
      carry = value / 10
      d = d + 1
    }
    while carry > 0 {
      if decimal.count == 1024 {
        return Option<usize>.none()
      }
      decimal.digits[decimal.count] = u32.toU8(carry % 10)
      decimal.count = decimal.count + 1
      carry = carry / 10
    }
    i = i + 1
  }
  let mut position = at
  if first {
    let mut small: u32 = 80
    if decimal.count <= 2 {
      small = 0
      if decimal.count == 2 {
        small = u8.toU32(decimal.digits[1]) * 10
      }
      if decimal.count >= 1 {
        small = small + u8.toU32(decimal.digits[0])
      }
    }
    if small < 80 {
      position = put(&mut output, position, 48 + u32.toU8(small / 40))
      position = put(&mut output, position, 46)
      let rest = small % 40
      if rest >= 10 {
        position = put(&mut output, position, 48 + u32.toU8(rest / 10))
      }
      return Option<usize>.some(put(&mut output, position, 48 + u32.toU8(rest % 10)))
    }
    position = put(&mut output, position, 50)
    position = put(&mut output, position, 46)
    // Subtracts 80 from the digits.
    let subtrahend: [u8; 2] = [0, 8]
    let mut borrow: u8 = 0
    let mut d: usize = 0
    while d < decimal.count {
      let mut take = borrow
      if d < 2 {
        take = take + subtrahend[d]
      }
      if decimal.digits[d] >= take {
        decimal.digits[d] = decimal.digits[d] - take
        borrow = 0
      } else {
        decimal.digits[d] = decimal.digits[d] + 10 - take
        borrow = 1
      }
      d = d + 1
    }
    while decimal.count > 1 && decimal.digits[decimal.count - 1] == 0 {
      decimal.count = decimal.count - 1
    }
  }
  if decimal.count == 0 {
    return Option<usize>.some(put(&mut output, position, 48))
  }
  let mut d = decimal.count
  while d > 0 {
    d = d - 1
    position = put(&mut output, position, 48 + decimal.digits[d])
  }
  return Option<usize>.some(position)
}

fn writeIdentifier(identifier: &[u8], output: &mut [u8], at: usize) -> Option<usize> {
  if identifier.length == 0 || identifier[identifier.length - 1] >= 128 {
    return Option<usize>.none()
  }
  let mut position = at
  let mut start: usize = 0
  while start < identifier.length {
    if identifier[start] == 128 {
      return Option<usize>.none()
    }
    let mut end = start
    while identifier[end] >= 128 {
      end = end + 1
    }
    end = end + 1
    if start > 0 {
      position = put(&mut output, position, 46)
    }
    position = match writeArc(identifier, start, end, start == 0, &mut output, position) {
      Option<usize>.Some { value } => value
      Option<usize>.None => {
        return Option<usize>.none()
      }
    }
    start = end
  }
  return Option<usize>.some(position)
}

// A DER value: its tag, where it starts, and where its content starts and ends.
struct Tlv {
  valid: bool,
  tag: u8,
  header: usize,
  start: usize,
  end: usize,
}

impl Copy for Tlv {}

fn invalidTlv() -> Tlv {
  return Tlv { valid: false, tag: 0, header: 0, start: 0, end: 0 }
}

// Reads a DER value with a minimal definite length that ends by `limit`.
fn readTlv(bytes: &[u8], offset: usize, limit: usize) -> Tlv {
  if limit > bytes.length || offset >= limit || limit - offset < 2 {
    return invalidTlv()
  }
  let tag = bytes[offset]
  if u8.bitAnd(tag, 31) == 31 {
    return invalidTlv()
  }
  let first = bytes[offset + 1]
  let mut start = offset + 2
  let mut length = u8.toUsize(first)
  if first >= 128 {
    let count = u8.toUsize(first - 128)
    if count == 0 || count > 4 || count > limit - start || bytes[start] == 0 {
      return invalidTlv()
    }
    length = 0
    let mut i: usize = 0
    while i < count {
      length = length * 256 + u8.toUsize(bytes[start + i])
      i = i + 1
    }
    if length < 128 {
      return invalidTlv()
    }
    start = start + count
  }
  if length > limit - start {
    return invalidTlv()
  }
  return Tlv { valid: true, tag: tag, header: offset, start: start, end: start + length }
}

fn utf8Valid(bytes: &[u8], start: usize, end: usize) -> bool {
  let mut i = start
  while i < end {
    let lead = bytes[i]
    if lead < 128 {
      i = i + 1
      continue
    }
    let mut count: usize = 0
    let mut value: u32 = 0
    let mut minimum: u32 = 0
    if lead >= 194 && lead < 224 {
      count = 1
      value = u8.toU32(u8.bitAnd(lead, 31))
      minimum = 128
    } else if lead >= 224 && lead < 240 {
      count = 2
      value = u8.toU32(u8.bitAnd(lead, 15))
      minimum = 2048
    } else if lead >= 240 && lead < 245 {
      count = 3
      value = u8.toU32(u8.bitAnd(lead, 7))
      minimum = 65536
    } else {
      return false
    }
    if count > end - i - 1 {
      return false
    }
    let mut k: usize = 1
    while k <= count {
      let next = bytes[i + k]
      if u8.bitAnd(next, 192) != 128 {
        return false
      }
      value = value * 64 + u8.toU32(u8.bitAnd(next, 63))
      k = k + 1
    }
    if value < minimum || value > 1114111 || (value >= 55296 && value < 57344) {
      return false
    }
    i = i + count + 1
  }
  return true
}

// The width in bytes of one character of a string tag: 0 for UTF8String, which is copied byte
// by byte, 1 for the 8-bit types, 2 for BMPString, and 4 for UniversalString. Other tags are not
// strings.
fn stringWidth(tag: u8) -> Option<usize> {
  if tag == 12 {
    return Option<usize>.some(0)
  }
  if tag == 18 || tag == 19 || tag == 20 || tag == 22 {
    return Option<usize>.some(1)
  }
  if tag == 30 {
    return Option<usize>.some(2)
  }
  if tag == 28 {
    return Option<usize>.some(4)
  }
  return Option<usize>.none()
}

fn isString(tag: u8) -> bool {
  return match stringWidth(tag) {
    Option<usize>.Some { .. } => true
    Option<usize>.None => false
  }
}

fn character(bytes: &[u8], at: usize, width: usize) -> u32 {
  if width == 2 {
    return u8.toU32(bytes[at]) * 256 + u8.toU32(bytes[at + 1])
  }
  if width == 4 {
    return u8.toU32(bytes[at]) * 16777216 + u8.toU32(bytes[at + 1]) * 65536
      + u8.toU32(bytes[at + 2]) * 256 + u8.toU32(bytes[at + 3])
  }
  return u8.toU32(bytes[at])
}

// Checks a value as OpenSSL does when it reads a name entry: only these tags, and strings that
// it can convert to UTF-8.
fn valueValid(bytes: &[u8], value: &Tlv) -> bool {
  let tag = value.tag
  let length = value.end - value.start
  if tag == 12 {
    return utf8Valid(bytes, value.start, value.end)
  }
  if tag == 30 || tag == 28 {
    let width: usize = if tag == 30 { 2 } else { 4 }
    if length % width != 0 {
      return false
    }
    let mut i = value.start
    while i < value.end {
      let c = character(bytes, i, width)
      if c > 1114111 || (c >= 55296 && c < 57344) {
        return false
      }
      i = i + width
    }
    return true
  }
  if tag == 3 {
    if length == 0 || bytes[value.start] > 7 {
      return false
    }
    return length > 1 || bytes[value.start] == 0
  }
  return tag == 7 || tag == 8 || tag == 9 || tag == 11 || tag == 13 || tag == 14 || tag == 15
    || tag == 18 || tag == 19 || tag == 20 || tag == 22 || tag == 29 || tag == 48
}

// The last content byte of a BIT STRING with its unused bits cleared, as OpenSSL stores it.
fn valueByte(bytes: &[u8], value: &Tlv, at: usize) -> u8 {
  let byte = bytes[at]
  if value.tag == 3 && at == value.end - 1 && at > value.start {
    let unused = bytes[value.start]
    return u8.bitAnd(byte, u8.shiftLeft(255, unused))
  }
  return byte
}

fn putUtf8(output: &mut [u8], at: usize, c: u32) -> usize {
  if c < 128 {
    return put(&mut output, at, u32.toU8(c))
  }
  if c < 2048 {
    let position = put(&mut output, at, u32.toU8(192 + c / 64))
    return put(&mut output, position, u32.toU8(128 + c % 64))
  }
  if c < 65536 {
    let mut position = put(&mut output, at, u32.toU8(224 + c / 4096))
    position = put(&mut output, position, u32.toU8(128 + (c / 64) % 64))
    return put(&mut output, position, u32.toU8(128 + c % 64))
  }
  let mut position = put(&mut output, at, u32.toU8(240 + c / 262144))
  position = put(&mut output, position, u32.toU8(128 + (c / 4096) % 64))
  position = put(&mut output, position, u32.toU8(128 + (c / 64) % 64))
  return put(&mut output, position, u32.toU8(128 + c % 64))
}

// Writes one character of a value. `first` and `last` say where it is, as OpenSSL's `do_buf`
// marks them: the last mark wins for a value of one character.
fn putCharacter(
  output: &mut [u8],
  at: usize,
  c: u32,
  rawBytes: bool,
  first: bool,
  last: bool,
  format: NameTextFormat,
) -> usize {
  if c >= 128 {
    if rawBytes {
      return put(&mut output, at, u32.toU8(c))
    }
    return putUtf8(&mut output, at, c)
  }
  let byte = u32.toU8(c)
  let special = byte == 34 || byte == 43 || byte == 44 || byte == 59 || byte == 60
    || byte == 62 || byte == 92
  let leading = first && !last && (byte == 32 || byte == 35)
  let trailing = last && byte == 32
  if special || leading || trailing {
    let position = put(&mut output, at, 92)
    return put(&mut output, position, byte)
  }
  if format == NameTextFormat.Multiline && (byte < 32 || byte == 127) {
    let position = put(&mut output, at, 92)
    return putHex(&mut output, position, byte)
  }
  return put(&mut output, at, byte)
}

fn writeValue(
  bytes: &[u8],
  value: &Tlv,
  known: bool,
  format: NameTextFormat,
  output: &mut [u8],
  at: usize,
) -> usize {
  let mut position = at
  if format == NameTextFormat.Rfc2253 && (!known || !isString(value.tag)) {
    position = put(&mut output, position, 35)
    let mut i = value.header
    while i < value.end {
      position = putHex(&mut output, position, valueByte(bytes, value, i))
      i = i + 1
    }
    return position
  }
  let width = match stringWidth(value.tag) {
    Option<usize>.Some { value: found } => found
    Option<usize>.None => 1
  }
  // A value that is not a string is printed byte by byte: a SEQUENCE with its tag and length,
  // a BIT STRING without its unused-bit count, and other types by their content.
  let mut start = value.start
  if value.tag == 48 {
    start = value.header
  }
  if value.tag == 3 {
    start = value.start + 1
  }
  let step: usize = if width == 0 { 1 } else { width }
  let mut i = start
  while i < value.end {
    let c = if width <= 1 { u8.toU32(valueByte(bytes, value, i)) } else { character(bytes, i, width) }
    position = putCharacter(&mut output, position, c, width == 0, i == start, i + step == value.end, format)
    i = i + step
  }
  return position
}

// Where one attribute of a name is: its RDN and its AttributeTypeAndValue.
struct Attribute {
  valid: bool,
  rdn: usize,
  identifier: Tlv,
  value: Tlv,
}

impl Copy for Attribute {}

// Finds attribute `index` of the name, or the count of attributes when `index` is past the
// end, in `rdn` of an invalid result. `valid` is false and `rdn` is `usize.MAX` for bad DER.
fn findAttribute(name: &[u8], index: usize) -> Attribute {
  let none = Attribute { valid: false, rdn: usize.MAX, identifier: invalidTlv(), value: invalidTlv() }
  let sequence = readTlv(name, 0, name.length)
  if !sequence.valid || sequence.tag != 48 || sequence.end != name.length {
    return none
  }
  let mut count: usize = 0
  let mut rdn: usize = 0
  let mut offset = sequence.start
  while offset < sequence.end {
    let set = readTlv(name, offset, sequence.end)
    if !set.valid || set.tag != 49 {
      return none
    }
    let mut inner = set.start
    while inner < set.end {
      let pair = readTlv(name, inner, set.end)
      if !pair.valid || pair.tag != 48 {
        return none
      }
      let identifier = readTlv(name, pair.start, pair.end)
      if !identifier.valid || identifier.tag != 6 {
        return none
      }
      let value = readTlv(name, identifier.end, pair.end)
      if !value.valid || value.end != pair.end || !valueValid(name, &value) {
        return none
      }
      if count == index {
        return Attribute { valid: true, rdn: rdn, identifier: identifier, value: value }
      }
      count = count + 1
      inner = pair.end
    }
    rdn = rdn + 1
    offset = set.end
  }
  return Attribute { valid: false, rdn: count, identifier: invalidTlv(), value: invalidTlv() }
}

fn writeNameText(name: &[u8], format: NameTextFormat, output: &mut [u8]) -> Option<usize> {
  let total = findAttribute(name, usize.MAX)
  if total.rdn == usize.MAX {
    return Option<usize>.none()
  }
  let count = total.rdn
  let mut position: usize = 0
  let mut previous: usize = usize.MAX
  let mut k: usize = 0
  while k < count {
    let index = if format == NameTextFormat.Rfc2253 { count - 1 - k } else { k }
    let attribute = findAttribute(name, index)
    if k > 0 {
      if attribute.rdn == previous {
        if format == NameTextFormat.Multiline {
          position = putAll(&mut output, position, b" + ")
        } else {
          position = put(&mut output, position, 43)
        }
      } else if format == NameTextFormat.Multiline {
        position = put(&mut output, position, 10)
      } else {
        position = put(&mut output, position, 44)
      }
    }
    previous = attribute.rdn
    let identifier = Slice.view<u8>(
      name,
      attribute.identifier.start,
      attribute.identifier.end - attribute.identifier.start,
    )
    let mut known = false
    match CertificateText.objectName(identifier) {
      Option<ObjectName>.Some { value } => {
        position = putAll(&mut output, position, value.shortName)
        known = true
      }
      Option<ObjectName>.None => {
        position = match writeIdentifier(identifier, &mut output, position) {
          Option<usize>.Some { value } => value
          Option<usize>.None => {
            return Option<usize>.none()
          }
        }
      }
    }
    position = put(&mut output, position, 61)
    position = writeValue(name, &attribute.value, known, format, &mut output, position)
    k = k + 1
  }
  return Option<usize>.some(position)
}

fn writeSerialText(serial: &[u8], output: &mut [u8]) -> Option<usize> {
  if serial.length == 0 {
    return Option<usize>.none()
  }
  let negative = serial[0] >= 128
  // The magnitude of a negative number is its two's complement: bytes below the last nonzero
  // byte flip, that byte is negated, and the zero bytes after it stay zero.
  let mut lastNonzero: usize = 0
  let mut i: usize = 0
  while i < serial.length {
    if serial[i] != 0 {
      lastNonzero = i
    }
    i = i + 1
  }
  let mut position: usize = 0
  if negative {
    position = put(&mut output, position, 45)
  }
  let mut started = false
  i = 0
  while i < serial.length {
    let mut byte = serial[i]
    if negative {
      if i < lastNonzero {
        byte = 255 - byte
      } else if i == lastNonzero {
        byte = u32.toU8(256 - u8.toU32(byte))
      }
    }
    if byte != 0 || started {
      position = putHex(&mut output, position, byte)
      started = true
    }
    i = i + 1
  }
  if !started {
    position = put(&mut output, position, 48)
  }
  return Option<usize>.some(position)
}

