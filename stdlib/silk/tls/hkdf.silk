//! The TLS 1.3 key schedule functions `HKDF-Expand-Label` and `Derive-Secret` (RFC 8446, section
//! 7.1).
//!
//! # When to use
//! Use [`TlsHkdfSha256`] or [`TlsHkdfSha384`] to derive TLS 1.3 secrets, keys, and IVs, or keys for
//! a protocol that reuses the TLS key schedule, such as QUIC. For other uses, use `silk.crypto.hkdf`.
//!
//! # Details
//! [`TlsHkdfSha256.expandLabel`] adds the prefix `tls13 ` to the label and fills the output.
//! [`TlsHkdfSha256.deriveSecret`] hashes the handshake messages and expands with that hash.
//! [`TlsHkdfSha256.deriveSecretFromHash`] takes a transcript hash that you already have. Nothing
//! allocates.
//!
//! # Errors
//! - [`LabelError`] if the label is not 1 to 249 bytes, the context is longer than 255 bytes, the
//!   output is too long, or the messages are too long. The output does not change.
//!
//! # Gotchas
//! Give the label without `tls13 `, because it is always added. You choose the labels and build the
//! transcript. Secrets are not erased.
//!
//! # Examples
//! ## Derive a secret from messages or from their hash
//! ```silk
//! import silk.core.result { Result }
//! import silk.crypto.sha2 { Sha256 }
//! import silk.tls.hkdf { LabelError, TlsHkdfSha256 }
//!
//! pub fn main() -> i32 {
//!   let secret: [u8; 32] = [7; 32]
//!   let fromMessages = match TlsHkdfSha256.deriveSecret(&secret, b"derived", b"") {
//!     Result<[u8; 32], LabelError>.Success { value } => value
//!     Result<[u8; 32], LabelError>.Failure {..} => {
//!       return 1
//!     }
//!   }
//!
//!   // An empty transcript is the hash of no bytes, not 32 zero bytes.
//!   let emptyHash = Sha256.hash(b"")
//!   let fromHash = match TlsHkdfSha256.deriveSecretFromHash(&secret, b"derived", &emptyHash) {
//!     Result<[u8; 32], LabelError>.Success { value } => value
//!     Result<[u8; 32], LabelError>.Failure {..} => {
//!       return 1
//!     }
//!   }
//!   let mut index: usize = 0
//!   while index < 32 {
//!     if fromMessages[index] != fromHash[index] {
//!       return 1
//!     }
//!     index = index + 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category TLS and certificates

import silk.text.format {Debug, Format, Formatter}
import silk.crypto.hkdf {HkdfSha256, HkdfSha384, OutputTooLongError}
import silk.core.result {Result}
import silk.crypto.sha2 {Sha256, Sha384}
import silk.collections.slice {Slice}
import silk.num.usize
import silk.num.u64
import silk.io.writer {Writer, WriterError}

/// A length that the key schedule does not accept. It holds no secret bytes.
pub union LabelError {
  /// The label is empty or longer than 249 bytes.
  LabelLength {
    /// The requested length in bytes.
    pub requested: usize,
    /// The largest accepted length in bytes.
    pub maximum: usize,
  },
  /// The context is longer than 255 bytes.
  ContextLength {
    /// The requested length in bytes.
    pub requested: usize,
    /// The largest accepted length in bytes.
    pub maximum: usize,
  },
  /// The output is longer than 255 hash blocks.
  OutputLength {
    /// The requested length in bytes.
    pub requested: usize,
    /// The largest accepted length in bytes.
    pub maximum: usize,
  },
  /// The messages are longer than SHA-256 allows.
  MessageTooLong {
    /// The requested length in bytes.
    pub requested: u64,
    /// The largest accepted length in bytes.
    pub maximum: u64,
  },
}

impl Debug for LabelError {
  /// Writes the name of the variant and its fields, such as `LabelLength { ... }`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      LabelError.LabelLength { requested, maximum } => {
        let mut record = run Format.debugRecord("LabelLength", &mut formatter)
        run Format.debugField(&mut record, "requested", &requested, &mut formatter)
        run Format.debugField(&mut record, "maximum", &maximum, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      LabelError.ContextLength { requested, maximum } => {
        let mut record = run Format.debugRecord("ContextLength", &mut formatter)
        run Format.debugField(&mut record, "requested", &requested, &mut formatter)
        run Format.debugField(&mut record, "maximum", &maximum, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      LabelError.OutputLength { requested, maximum } => {
        let mut record = run Format.debugRecord("OutputLength", &mut formatter)
        run Format.debugField(&mut record, "requested", &requested, &mut formatter)
        run Format.debugField(&mut record, "maximum", &maximum, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      LabelError.MessageTooLong { requested, maximum } => {
        let mut record = run Format.debugRecord("MessageTooLong", &mut formatter)
        run Format.debugField(&mut record, "requested", &requested, &mut formatter)
        run Format.debugField(&mut record, "maximum", &maximum, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
    }
  }
}

// Admission uses a numeric boundary so it can be checked without constructing impossible slices.
fn sha256MessageLengthAdmitted(length: u64) -> bool {
  return length <= u64.shiftRight(u64.MAX, 3)
}

fn validate(label: &[u8], contextLength: usize, outputLength: usize, maximum: usize) -> Result<
  (),
  LabelError,
> {
  if label.length == 0 || label.length > 249 {
    return Result<(), LabelError>.failResult(
      LabelError.LabelLength {requested: label.length, maximum: 249},
    )
  }
  if contextLength > 255 {
    return Result<(), LabelError>.failResult(
      LabelError.ContextLength {requested: contextLength, maximum: 255},
    )
  }
  if outputLength > maximum {
    return Result<(), LabelError>.failResult(
      LabelError.OutputLength {requested: outputLength, maximum: maximum},
    )
  }
  return Result<(), LabelError>.succeed(())
}

// Length validation precedes every call. All offsets fit in the fixed framing buffer.
fn frame(label: &[u8], context: &[u8], outputLength: usize, info: &mut [u8]) -> usize {
  info[0] = usize.toU8(outputLength / 256)
  info[1] = usize.toU8(outputLength % 256)
  info[2] = usize.toU8(6 + label.length)
  info[3] = 116
  info[4] = 108
  info[5] = 115
  info[6] = 49
  info[7] = 51
  info[8] = 32
  let mut index: usize = 0
  while index < label.length {
    info[9 + index] = label[index]
    index = index + 1
  }
  let contextOffset = 9 + label.length
  info[contextOffset] = usize.toU8(context.length)
  index = 0
  while index < context.length {
    info[contextOffset + 1 + index] = context[index]
    index = index + 1
  }
  return contextOffset + 1 + context.length
}

/// The TLS 1.3 key schedule with SHA-256: `HKDF-Expand-Label` and `Derive-Secret` (RFC 8446,
/// section 7.1). Secrets and transcript hashes are 32 bytes.
///
/// # When to use
/// Use it to derive TLS 1.3 secrets, keys, and IVs, or keys for a protocol that reuses the TLS key
/// schedule, such as QUIC. For other uses, use `silk.crypto.hkdf`.
///
/// # Details
/// `expandLabel` adds the prefix `tls13 ` to the label and fills the output. `deriveSecret` hashes
/// the handshake messages and expands with that hash. `deriveSecretFromHash` takes a transcript
/// hash that you already have. Nothing allocates.
///
/// # Gotchas
/// Give the label without `tls13 `, because it is always added. You choose the labels and build
/// the transcript. Secrets are not erased.
pub struct TlsHkdfSha256 {}

