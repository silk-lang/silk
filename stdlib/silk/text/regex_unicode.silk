const unicode_prop_table_len: usize = 57

fn unicode_prop_table(index: usize) -> &'static [u8] {
  return match index {
    0 => unicode_prop_Hyphen_table()
    1 => unicode_prop_Other_Math_table()
    2 => unicode_prop_Other_Alphabetic_table()
    3 => unicode_prop_Other_Lowercase_table()
    4 => unicode_prop_Other_Uppercase_table()
    5 => unicode_prop_Other_Grapheme_Extend_table()
    6 => unicode_prop_Other_Default_Ignorable_Code_Point_table()
    7 => unicode_prop_Other_ID_Start_table()
    8 => unicode_prop_Other_ID_Continue_table()
    9 => unicode_prop_Prepended_Concatenation_Mark_table()
    10 => unicode_prop_ID_Continue1_table()
    11 => unicode_prop_XID_Start1_table()
    12 => unicode_prop_XID_Continue1_table()
    13 => unicode_prop_Changes_When_Titlecased1_table()
    14 => unicode_prop_Changes_When_Casefolded1_table()
    15 => unicode_prop_Changes_When_NFKC_Casefolded1_table()
    16 => unicode_prop_Basic_Emoji1_table()
    17 => unicode_prop_Basic_Emoji2_table()
    18 => unicode_prop_RGI_Emoji_Modifier_Sequence_table()
    19 => unicode_prop_RGI_Emoji_Flag_Sequence_table()
    20 => unicode_prop_Emoji_Keycap_Sequence_table()
    21 => unicode_prop_ASCII_Hex_Digit_table()
    22 => unicode_prop_Bidi_Control_table()
    23 => unicode_prop_Dash_table()
    24 => unicode_prop_Deprecated_table()
    25 => unicode_prop_Diacritic_table()
    26 => unicode_prop_Extender_table()
    27 => unicode_prop_Hex_Digit_table()
    28 => unicode_prop_IDS_Unary_Operator_table()
    29 => unicode_prop_IDS_Binary_Operator_table()
    30 => unicode_prop_IDS_Trinary_Operator_table()
    31 => unicode_prop_Ideographic_table()
    32 => unicode_prop_Join_Control_table()
    33 => unicode_prop_Logical_Order_Exception_table()
    34 => unicode_prop_Modifier_Combining_Mark_table()
    35 => unicode_prop_Noncharacter_Code_Point_table()
    36 => unicode_prop_Pattern_Syntax_table()
    37 => unicode_prop_Pattern_White_Space_table()
    38 => unicode_prop_Quotation_Mark_table()
    39 => unicode_prop_Radical_table()
    40 => unicode_prop_Regional_Indicator_table()
    41 => unicode_prop_Sentence_Terminal_table()
    42 => unicode_prop_Soft_Dotted_table()
    43 => unicode_prop_Terminal_Punctuation_table()
    44 => unicode_prop_Unified_Ideograph_table()
    45 => unicode_prop_Variation_Selector_table()
