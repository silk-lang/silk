//! Unicode 17.0.0 case folding, property and range tables for `silk.text.regex`.
//!
//! # When to use
//! Use `silk.text.regex` in application code. This module is the regular-expression engine's
//! Unicode support: ECMAScript case folding, the property sets `\p{...}` names, and the range
//! arithmetic that builds character classes.
//!
//! # Details
//! The tables are compact range encodings, generated from the Unicode 17.0.0 Character Database
//! (Unicode License v3) by SilkJS's `scripts/generate_unicode.py`. The encoding started from
//! QuickJS, Copyright (c) 2017-2021 Fabrice Bellard and Charlie Gordon, under the MIT license in
//! `licenses/quickjs.txt`.
//!
//! @category Text

import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.num.i32
import silk.num.u32
import silk.num.u8
import silk.num.usize
import silk.text.string { String }

// From SilkJS src/unicode_case.silk.
/// The full Unicode case-fold mapping of one scalar, with at most three scalar values.
/// Only the first `length` entries of `points` are part of the result.
pub struct CaseMapping {
  /// The mapped scalars, followed by zero entries that are not part of the result.
  pub points: [u32; 3],
  /// The number of mapped scalars, from one through three.
  pub length: usize
}

/// ECMAScript case canonicalization and character classes over Unicode scalars.
pub struct UnicodeCase {}

// Run tags are the libunicode.c case-conversion encoding, not Unicode properties.
const RUN_U: u32 = 0

const RUN_L: u32 = 1

const RUN_UF: u32 = 2

const RUN_LF: u32 = 3

const RUN_UL: u32 = 4

const RUN_LSU: u32 = 5

const RUN_U2L_399_EXT2: u32 = 6

const RUN_UF_D20: u32 = 7

const RUN_UF_D1_EXT: u32 = 8

const RUN_U_EXT: u32 = 9

const RUN_LF_EXT: u32 = 10

const RUN_UF_EXT2: u32 = 11

const RUN_LF_EXT2: u32 = 12

fn single(c: u32) -> CaseMapping {
  return CaseMapping { points: [c, 0, 0], length: 1 }
}

fn entryIndex(c: u32) -> usize {
  let mut low: usize = 0
  let mut high = case_conv_table1_len
  while low < high {
    let middle = low + (high - low) / 2
    let value = case_conv_table1(middle)
    let code = u32.shiftRight(value, 15)
    let length = u32.shiftRight(value, 8) & 0x7f
    if c < code {
      high = middle
    } else if c >= code + length {
      low = middle + 1
    } else {
      return middle
    }
  }
  return case_conv_table1_len
}

fn convertEntry(c: u32, mode: u32, index: usize, value: u32) -> CaseMapping {
  let lower = mode != 0
  let kind = u32.shiftRight(value, 4) & 0xf
  let data = u32.shiftLeft(value & 0xf, 8) | u8.toU32(case_conv_table2()[index])
  let code = u32.shiftRight(value, 15)
  if kind == RUN_U || kind == RUN_L || kind == RUN_UF || kind == RUN_LF {
    if mode == (kind & 1) || (kind >= RUN_UF && mode == 2) {
      return single(c - code + u32.shiftRight(case_conv_table1(u32.toUsize(data)), 15))
    }
  } else if kind == RUN_UL {
    let relative = c - code
    if (lower && (relative & 1) == 0) || (!lower && (relative & 1) == 1) {
      return single((relative ^ 1) + code)
    }
  } else if kind == RUN_LSU {
    let relative = c - code
    if relative == 1 {
      if lower {
        return single(c + 1)
      }
      return single(c - 1)
    }
    if lower && relative == 0 {
      return single(c + 2)
    }
    if !lower && relative == 2 {
      return single(c - 2)
    }
  } else if kind == RUN_U2L_399_EXT2 {
    if !lower {
      return CaseMapping {
        points: [c - code + case_conv_ext(u32.toUsize(u32.shiftRight(data, 6))), 0x399, 0],
        length: 2,
      }
    }
    return single(c - code + case_conv_ext(u32.toUsize(data & 0x3f)))
  } else if kind == RUN_UF_D20 {
    if mode != 1 {
      if mode == 2 {
        return single(data + 0x20)
      }
      return single(data)
    }
  } else if kind == RUN_UF_D1_EXT {
    if mode != 1 {
      let point = case_conv_ext(u32.toUsize(data))
      if mode == 2 {
        return single(point + 1)
      }
      return single(point)
    }
  } else if kind == RUN_U_EXT || kind == RUN_LF_EXT {
    if (lower && kind == RUN_LF_EXT) || (!lower && kind == RUN_U_EXT) {
      return single(case_conv_ext(u32.toUsize(data)))
    }
  } else if kind == RUN_LF_EXT2 {
    if lower {
      return CaseMapping {
        points: [
          c - code + case_conv_ext(u32.toUsize(u32.shiftRight(data, 6))),
          case_conv_ext(u32.toUsize(data & 0x3f)),
          0,
        ],
        length: 2,
      }
    }
  } else if kind == RUN_UF_EXT2 {
    if mode != 1 {
      let mut first = c - code + case_conv_ext(u32.toUsize(u32.shiftRight(data, 6)))
      let mut second = case_conv_ext(u32.toUsize(data & 0x3f))
      if mode == 2 {
        let firstLower = UnicodeCase.convert(first, 1)
        let secondLower = UnicodeCase.convert(second, 1)
        first = firstLower.points[0]
        second = secondLower.points[0]
      }
      return CaseMapping { points: [first, second, 0], length: 2 }
    }
  } else {
    // RUN_TYPE_UF_EXT3 is also the upstream default for the remaining run tags.
    if mode != 1 {
      let mut first = case_conv_ext(u32.toUsize(u32.shiftRight(data, 8)))
      let mut second = case_conv_ext(u32.toUsize(u32.shiftRight(data, 4) & 0xf))
      let mut third = case_conv_ext(u32.toUsize(data & 0xf))
      if mode == 2 {
        let firstLower = UnicodeCase.convert(first, 1)
        let secondLower = UnicodeCase.convert(second, 1)
        let thirdLower = UnicodeCase.convert(third, 1)
        first = firstLower.points[0]
        second = secondLower.points[0]
        third = thirdLower.points[0]
      }
      return CaseMapping { points: [first, second, third], length: 3 }
    }
  }
  return single(c)
}

impl UnicodeCase {
  /// Returns the full, locale-independent Unicode 17.0.0 case fold of `c`.
  ///
  /// # Details
  ///
  /// The result contains one through three scalars. An unmapped value is returned unchanged.
  /// Use this mapping for caseless text comparison; it can expand one scalar into several scalars.
  pub fn fold(c: u32) -> CaseMapping {
    let mapped = UnicodeCase.convert(c, 2)
    if mapped.length == 1 && mapped.points[0] != c {
      return UnicodeCase.convert(mapped.points[0], 2)
    }
    return move mapped
  }

  /// Maps one code point: mode 0 uppercases, 1 lowercases, and 2 fully case-folds.
  fn convert(c: u32, mode: u32) -> CaseMapping {
    if c < 128 {
      if mode != 0 {
        if c >= 0x41 && c <= 0x5a {
          return single(c + 0x20)
        }
      } else if c >= 0x61 && c <= 0x7a {
        return single(c - 0x20)
      }
      return single(c)
    }
    let index = entryIndex(c)
    if index == case_conv_table1_len {
      return single(c)
    }
    return convertEntry(c, mode, index, case_conv_table1(index))
  }

  /// Applies ECMAScript RegExp canonicalization, which never expands a code point.
  pub fn canonicalize(c: u32, isUnicode: bool) -> u32 {
    if c < 128 {
      if isUnicode {
        if c >= 0x41 && c <= 0x5a {
          return c + 0x20
        }
      } else if c >= 0x61 && c <= 0x7a {
        return c - 0x20
      }
      return c
    }
    let index = entryIndex(c)
    if index == case_conv_table1_len {
      return c
    }
    let value = case_conv_table1(index)
    if isUnicode {
      let mapped = convertEntry(c, 2, index, value)
      if mapped.length == 1 {
        return mapped.points[0]
      }
      if c == 0xfb06 {
        return 0xfb05
      }
      if c == 0x1fd3 {
        return 0x390
      }
      if c == 0x1fe3 {
        return 0x3b0
      }
    } else {
      let mapped = convertEntry(c, 0, index, value)
      if mapped.length == 1 && mapped.points[0] >= 128 {
        return mapped.points[0]
      }
    }
    return c
  }

  fn isCased(code: u32) -> bool {
    return entryIndex(code) != case_conv_table1_len
      || UnicodeIndex.contains(code, unicode_prop_Cased1_table(), unicode_prop_Cased1_index())
  }

  fn isCaseIgnorable(code: u32) -> bool {
    return UnicodeIndex.contains(
      code,
      unicode_prop_Case_Ignorable_table(),
      unicode_prop_Case_Ignorable_index(),
    )
  }

  fn isSoftDotted(code: u32) -> bool {
    return UnicodeIndex.contains(
      code,
      unicode_prop_Soft_Dotted_table(),
      unicode_prop_Soft_Dotted_index(),
    )
  }

  /// Tests Unicode ID_Start, without ECMAScript's extra dollar sign and underscore.
  fn isIdStart(code: u32) -> bool {
    return UnicodeIndex.contains(code, unicode_prop_ID_Start_table(), unicode_prop_ID_Start_index())
  }

  fn isIdContinue(code: u32) -> bool {
    return UnicodeCase.isIdStart(code)
      || UnicodeIndex.contains(
        code,
        unicode_prop_ID_Continue1_table(),
        unicode_prop_ID_Continue1_index(),
      )
  }

  fn isSpaceByte(code: u32) -> bool {
    return (code >= 9 && code <= 13) || code == 0x20 || code == 0xa0
  }

  fn isSpaceNonAscii(code: u32) -> bool {
    return code == 0xa0 || code == 0x1680 || (code >= 0x2000 && code <= 0x200a) || code == 0x2028
      || code == 0x2029
      || code == 0x202f
      || code == 0x205f
      || code == 0x3000
      || code == 0xfeff
  }

  /// Tests ECMAScript whitespace, including BOM but excluding NEXT LINE.
  pub fn isSpace(code: u32) -> bool {
    if code < 256 {
      return UnicodeCase.isSpaceByte(code)
    }
    return UnicodeCase.isSpaceNonAscii(code)
  }

  fn isIdStartByte(code: u32) -> bool {
    return (code >= 0x41 && code <= 0x5a) || (code >= 0x61 && code <= 0x7a) || code == 0x5f
      || code == 0x24
  }

  fn isIdContinueByte(code: u32) -> bool {
    return UnicodeCase.isIdStartByte(code) || (code >= 0x30 && code <= 0x39)
  }

  /// Tests the ASCII word characters `\w` matches: letters, digits and `_`.
  pub fn isWordByte(code: u32) -> bool {
    return (code >= 0x41 && code <= 0x5a) || (code >= 0x61 && code <= 0x7a)
      || (code >= 0x30 && code <= 0x39)
      || code == 0x5f
  }

  /// Tests whether `code` can start an ECMAScript identifier, as a capture name requires.
  pub fn isIdentifierStart(code: u32) -> bool {
    if code < 128 {
      return UnicodeCase.isIdStartByte(code)
    }
    return UnicodeCase.isIdStart(code)
  }

  /// Tests whether `code` can continue an ECMAScript identifier, including ZWNJ and ZWJ.
  pub fn isIdentifierContinue(code: u32) -> bool {
    if code < 128 {
      return UnicodeCase.isIdContinueByte(code)
    }
    if code == 0x200c || code == 0x200d {
      return true
    }
    return UnicodeCase.isIdContinue(code)
  }
}

// From SilkJS src/unicode_properties.silk.
/// The failure for a property name or value that is not an exact supported alias.
pub struct UnknownProperty {}

/// The character sets that `\p{...}` and `\P{...}` name.
pub struct UnicodeProperties {}

impl UnicodeProperties {
  /// Returns whether `name` is a script name or alias that `\p{Script=name}` accepts.
  ///
  /// # Details
  /// A static function, for checking a pattern while it compiles. It reads the name table the
  /// engine's own script lookup reads.
  pub static fn isScriptName(name: string) -> bool {
    return staticScript(name) != u32.MAX
  }

  /// Returns whether `name` is a general category name or alias that `\p{gc=name}` accepts.
  ///
  /// # Details
  /// A static function, for checking a pattern while it compiles. It reads the name table the
  /// engine's own category lookup reads.
  pub static fn isCategoryName(name: string) -> bool {
    return staticCategory(name) != u32.MAX
  }

  /// Returns whether `name` is a binary property name or alias that `\p{name}` accepts.
  ///
  /// # Details
  /// A static function, for checking a pattern while it compiles. It reads the name table the
  /// engine's own property lookup reads, and admits only the properties it can build.
  pub static fn isBinaryName(name: string) -> bool {
    let found = staticProperty(name)
    if found == u32.MAX {
      return false
    }
    return binarySupported(found + UNICODE_PROP_ASCII_Hex_Digit)
  }

  /// Resolves exact Unicode script names and aliases; optionally applies Script_Extensions.
  ///
  /// # Errors
  /// - `UnknownProperty` if `name` is not an exact supported alias.
  /// - `OutOfMemoryError` if the allocator cannot supply the set.
  pub effect fn script(name: string, extensions: bool) -> CharRange
    ! OutOfMemoryError | UnknownProperty
    ? &mut Allocator {
    let script = findIn(&SCRIPT_NAMES, &SCRIPT_ENTRIES, name)
    if script == u32.MAX {
      fail UnknownProperty {}
    }
    let common = script == UNICODE_SCRIPT_Common || script == UNICODE_SCRIPT_Inherited
    let mut result = CharRange.make()
    let table = unicode_script_table()
    let mut offset: usize = 0
    let mut code: u32 = 0
    while offset < table.length {
      let byte = nextByte(table, &mut offset)
      let mut length = byte & 127
      if length >= 96 {
        if length < 112 {
          length = (length - 96) * 256 + nextByte(table, &mut offset) + 96
        } else {
          length = (length - 112) * 65536 + nextByte(table, &mut offset) * 256
          length = length + nextByte(table, &mut offset) + 96 + 4096
        }
      }
      let end = code + length + 1
      if byte >= 128 {
        let value = nextByte(table, &mut offset)
        if value == script || script == UNICODE_SCRIPT_Unknown {
          run result.addInterval(code, end)
        }
      }
      code = end
    }
    if script == UNICODE_SCRIPT_Unknown {
      run result.invert()
    }
    if !extensions {
      return move result
    }
    let ext = unicode_script_ext_table()
    let mut additions = CharRange.make()
    offset = 0
    code = 0
    while offset < ext.length {
      let length = extendedLength(ext, &mut offset)
      let end = code + length + 1
      let count = u32.toUsize(nextByte(ext, &mut offset))
      let mut found = common && count != 0
      if !common {
        let mut i: usize = 0
        while i < count {
          if u8.toU32(ext[offset + i]) == script {
            found = true
          }
          i = i + 1
        }
      }
      if found {
        run additions.addInterval(code, end)
      }
      offset = offset + count
      code = end
    }
    let mut operation = RangeOperation.Union
    if common {
      operation = RangeOperation.Subtract
    }
    return run result.combine(&additions, operation)
  }

  /// Resolves exact short/long category aliases and aggregate categories.
  ///
  /// # Errors
  /// - `UnknownProperty` if `name` is not an exact supported alias.
  /// - `OutOfMemoryError` if the allocator cannot supply the set.
  pub effect fn generalCategory(name: string) -> CharRange
    ! OutOfMemoryError | UnknownProperty
    ? &mut Allocator {
    let category = findIn(&GC_NAMES, &GC_ENTRIES, name)
    if category == u32.MAX {
      fail UnknownProperty {}
    }
    return run categoryRanges(categoryMask(category))
  }

  /// Resolves the supported binary property names and aliases.
  ///
  /// # Errors
  /// - `UnknownProperty` if `name` is not an exact supported alias.
  /// - `OutOfMemoryError` if the allocator cannot supply the set.
  pub effect fn property(name: string) -> CharRange
    ! OutOfMemoryError | UnknownProperty
    ? &mut Allocator {
    let found = findIn(&PROPERTY_NAMES, &PROPERTY_ENTRIES, name)
    if found == u32.MAX || !binarySupported(found + UNICODE_PROP_ASCII_Hex_Digit) {
      fail UnknownProperty {}
    }
    let property = found + UNICODE_PROP_ASCII_Hex_Digit
    if property == UNICODE_PROP_ASCII || property == UNICODE_PROP_Any {
      let mut result = CharRange.make()
      let mut end: u32 = 1114112
      if property == UNICODE_PROP_ASCII {
        end = 128
      }
      run result.addInterval(0, end)
      return move result
    }
    if property == UNICODE_PROP_Assigned {
      let mut result = run categoryRanges(bit(UNICODE_GC_Cn))
      run result.invert()
      return move result
    }
    if property == UNICODE_PROP_Math || property == UNICODE_PROP_Lowercase
      || property == UNICODE_PROP_Uppercase {
      let mut category = UNICODE_GC_Sm
      let mut extra = UNICODE_PROP_Other_Math
      if property == UNICODE_PROP_Lowercase {
        category = UNICODE_GC_Ll
        extra = UNICODE_PROP_Other_Lowercase
      }
      if property == UNICODE_PROP_Uppercase {
        category = UNICODE_GC_Lu
        extra = UNICODE_PROP_Other_Uppercase
      }
      let mut result = run categoryRanges(bit(category))
      run applyProperty(&mut result, extra, RangeOperation.Union)
      return move result
    }
    if property == UNICODE_PROP_Cased || property == UNICODE_PROP_Alphabetic {
      let mut mask = letterNumberMask()
      if property == UNICODE_PROP_Cased {
        mask = categoryMask(UNICODE_GC_LC)
      }
      let mut result = run categoryRanges(mask)
      run applyProperty(&mut result, UNICODE_PROP_Other_Uppercase, RangeOperation.Union)
      run applyProperty(&mut result, UNICODE_PROP_Other_Lowercase, RangeOperation.Union)
      if property == UNICODE_PROP_Alphabetic {
        run applyProperty(&mut result, UNICODE_PROP_Other_Alphabetic, RangeOperation.Union)
      }
      return move result
    }
    if property == UNICODE_PROP_Grapheme_Base || property == UNICODE_PROP_Grapheme_Extend {
      let mut mask = bit(UNICODE_GC_Me) | bit(UNICODE_GC_Mn)
      if property == UNICODE_PROP_Grapheme_Base {
        mask = mask | categoryMask(UNICODE_GC_C) | bit(UNICODE_GC_Zl) | bit(UNICODE_GC_Zp)
      }
      let mut result = run categoryRanges(mask)
      run applyProperty(&mut result, UNICODE_PROP_Other_Grapheme_Extend, RangeOperation.Union)
      if property == UNICODE_PROP_Grapheme_Base {
        run result.invert()
      }
      return move result
    }
    if property == UNICODE_PROP_XID_Start || property == UNICODE_PROP_XID_Continue {
      let continuing = property == UNICODE_PROP_XID_Continue
      let mut mask = letterNumberMask()
      if continuing {
        mask = mask | bit(UNICODE_GC_Mn) | bit(UNICODE_GC_Mc) | bit(UNICODE_GC_Nd)
          | bit(UNICODE_GC_Pc)
      }
      let mut result = run categoryRanges(mask)
      run applyProperty(&mut result, UNICODE_PROP_Other_ID_Start, RangeOperation.Union)
      if continuing {
        run applyProperty(&mut result, UNICODE_PROP_Other_ID_Continue, RangeOperation.Union)
      }
      let mut excluded = run propertyRanges(UNICODE_PROP_Pattern_Syntax)
      run applyProperty(&mut excluded, UNICODE_PROP_Pattern_White_Space, RangeOperation.Union)
      let mut extra = UNICODE_PROP_XID_Start1
      if continuing {
        extra = UNICODE_PROP_XID_Continue1
      }
      run applyProperty(&mut excluded, extra, RangeOperation.Union)
      return run result.combine(&excluded, RangeOperation.Subtract)
    }
    if property == UNICODE_PROP_Changes_When_Uppercased {
      return run caseChanges(1)
    }
    if property == UNICODE_PROP_Changes_When_Lowercased {
      return run caseChanges(2)
    }
    if property == UNICODE_PROP_Changes_When_Casemapped {
      return run caseChanges(7)
    }
    if property == UNICODE_PROP_Changes_When_Titlecased
      || property == UNICODE_PROP_Changes_When_Casefolded
      || property == UNICODE_PROP_Changes_When_NFKC_Casefolded {
      let mut mask: u32 = 4
      let mut extra = UNICODE_PROP_Changes_When_Casefolded1
      if property == UNICODE_PROP_Changes_When_Titlecased {
        mask = 1
        extra = UNICODE_PROP_Changes_When_Titlecased1
      }
      if property == UNICODE_PROP_Changes_When_NFKC_Casefolded {
        extra = UNICODE_PROP_Changes_When_NFKC_Casefolded1
      }
      let mut result = run caseChanges(mask)
      run applyProperty(&mut result, extra, RangeOperation.Xor)
      return move result
    }
    if property == UNICODE_PROP_ID_Continue {
      let mut result = run propertyRanges(UNICODE_PROP_ID_Start)
      run applyProperty(&mut result, UNICODE_PROP_ID_Continue1, RangeOperation.Xor)
      return move result
    }

    // Recognized aliases without a supported table are still UnknownProperty upstream.
    if u32.toUsize(property) >= unicode_prop_table_len {
      fail UnknownProperty {}
    }
    return run propertyRanges(property)
  }

  /// Visits all sequences in upstream order. The borrowed stack buffer lasts only for the call.
  ///
  /// # Errors
  /// - `UnknownProperty` if `name` is not an exact supported alias.
  /// - Any failure of `visit`.
  /// - `OutOfMemoryError` if the allocator cannot supply the set.
  pub effect fn sequences<'env, E, ? R>(
    name: string,
    mut visit: for<use 'call> mut fn<'env>(&[u32]) -> once Effect<'call & 'env; () ! E ? R>,
  ) -> ()
    ! OutOfMemoryError | UnknownProperty | E
    ? &mut Allocator | R {
    let requested = findName(unicode_sequence_prop_name_table(), name)
    if requested == u32.MAX || requested >= UNICODE_SEQUENCE_PROP_COUNT {
      fail UnknownProperty {}
    }
    let aggregate = requested == UNICODE_SEQUENCE_PROP_RGI_Emoji
    let mut kind = requested
    let mut last = requested
    if aggregate {
      kind = UNICODE_SEQUENCE_PROP_Basic_Emoji
      last = UNICODE_SEQUENCE_PROP_RGI_Emoji_ZWJ_Sequence
    }
    let mut seq: [u32; 16] = [0; 16]
    let mut ranges = CharRange.make()
    while kind <= last {
      if kind == UNICODE_SEQUENCE_PROP_RGI_Emoji_ZWJ_Sequence {
        let table = unicode_rgi_emoji_zwj_sequence()
        let mut offset: usize = 0
        while offset < table.length {
          let count = nextByte(table, &mut offset)
          let mut length: usize = 0
          let mut modifier: u32 = 0
          let mut modifierCount: usize = 0
          let mut modifierPositions: [usize; 2] = [0; 2]
          let mut hairPosition: usize = 16
          let mut j: u32 = 0
          while j < count {
            let packed = nextByte(table, &mut offset) + nextByte(table, &mut offset) * 256
            let presentation = packed & 32768 != 0
            let modKind = u32.shiftRight(packed, 13) & 3
            let code = packed & 8191
            let mut scalar = 126976 + code - 4096
            if code < 4096 {
              scalar = code + 8192
            }
            if scalar == 129456 {
              hairPosition = length
            }
            seq[length] = scalar
            length = length + 1
            if modKind != 0 {
              modifier = modKind
              modifierPositions[modifierCount] = length
              modifierCount = modifierCount + 1
              seq[length] = 0
              length = length + 1
            }
            if presentation {
              seq[length] = 65039
              length = length + 1
            }
            if j + 1 < count {
              seq[length] = 8205
              length = length + 1
            }
            j = j + 1
          }
          let mut modifierVariants: u32 = 1
          if modifier == 1 {
            modifierVariants = 5
          }
          if modifier == 2 {
            modifierVariants = 25
          }
          if modifier == 3 {
            modifierVariants = 20
          }
          let mut hairVariants: u32 = 1
          if hairPosition < 16 {
            hairVariants = 4
          }
          let mut hair: u32 = 0
          while hair < hairVariants {
            let mut modIndex: u32 = 0
            while modIndex < modifierVariants {
              if hairPosition < 16 {
                seq[hairPosition] = 129456 + hair
              }
              if modifier == 1 {
                seq[modifierPositions[0]] = 127995 + modIndex
              }
              if modifier == 2 || modifier == 3 {
                let mut first = modIndex / 5
                let second = modIndex % 5
                if modifier == 3 && first >= second {
                  first = first + 1
                }
                seq[modifierPositions[0]] = 127995 + first
                seq[modifierPositions[1]] = 127995 + second
              }
              run visit(Slice.view<u32>(&seq, 0, length))
              modIndex = modIndex + 1
            }
            hair = hair + 1
          }
        }
      } else {
        if kind == UNICODE_SEQUENCE_PROP_RGI_Emoji_Tag_Sequence {
          let table = unicode_rgi_emoji_tag_sequence()
          let mut offset: usize = 0
          while offset < table.length {
            let mut length: usize = 1
            seq[0] = 127988
            let mut byte = nextByte(table, &mut offset)
            while byte != 0 {
              seq[length] = 917504 + byte
              length = length + 1
              byte = nextByte(table, &mut offset)
            }
            seq[length] = 917631
            length = length + 1
            run visit(Slice.view<u32>(&seq, 0, length))
          }
        } else {
          let mut passes: u32 = 1
          if kind == UNICODE_SEQUENCE_PROP_Basic_Emoji {
            passes = 2
          }
          let mut pass: u32 = 0
          while pass < passes {
            let mut property = UNICODE_PROP_Basic_Emoji1 + pass
            if kind == UNICODE_SEQUENCE_PROP_Emoji_Keycap_Sequence {
              property = UNICODE_PROP_Emoji_Keycap_Sequence
            }
            if kind == UNICODE_SEQUENCE_PROP_RGI_Emoji_Modifier_Sequence {
              property = UNICODE_PROP_Emoji_Modifier_Base
            }
            if kind == UNICODE_SEQUENCE_PROP_RGI_Emoji_Flag_Sequence {
              property = UNICODE_PROP_RGI_Emoji_Flag_Sequence
            }
            ranges.clear()
            run decodeProperty(&mut ranges, property)
            let points = ranges.points()
            let mut i: usize = 0
            while i < points.length {
              let mut code = points[i]
              while code < points[i + 1] {
                seq[0] = code
                if kind == UNICODE_SEQUENCE_PROP_RGI_Emoji_Modifier_Sequence {
                  let mut modifier: u32 = 0
                  while modifier < 5 {
                    seq[1] = 127995 + modifier
                    run visit(Slice.view<u32>(&seq, 0, 2))
                    modifier = modifier + 1
                  }
                } else {
                  let mut length: usize = 1
                  if kind == UNICODE_SEQUENCE_PROP_RGI_Emoji_Flag_Sequence {
                    seq[0] = 127462 + code / 26
                    seq[1] = 127462 + code % 26
                    length = 2
                  }
                  if kind == UNICODE_SEQUENCE_PROP_Basic_Emoji && pass == 1 {
                    seq[1] = 65039
                    length = 2
                  }
                  if kind == UNICODE_SEQUENCE_PROP_Emoji_Keycap_Sequence {
                    seq[1] = 65039
                    seq[2] = 8419
                    length = 3
                  }
                  run visit(Slice.view<u32>(&seq, 0, length))
                }
                code = code + 1
              }
              i = i + 2
            }
            pass = pass + 1
          }
        }
      }
      kind = kind + 1
    }
  }
}

fn findName(table: &[u8], name: string) -> u32 {
  let bytes = String.utf8Bytes(name)
  let mut offset: usize = 0
  let mut index: u32 = 0
  while offset < table.length && table[offset] != 0 {
    let start = offset
    while offset < table.length && table[offset] != 0 && table[offset] != 44 {
      offset = offset + 1
    }
    if offset - start == bytes.length {
      let mut equal = true
      let mut i: usize = 0
      while i < bytes.length {
        if table[start + i] != bytes[i] {
          equal = false
        }
        i = i + 1
      }
      if equal {
        return index
      }
    }
    if offset == table.length {
      break
    }
    if table[offset] == 0 {
      index = index + 1
    }
    offset = offset + 1
  }
  return u32.MAX
}

// The table entry of a property name, or u32.MAX: the runtime lookup.
fn findIn(names: &[string<'static>], entries: &[u8], name: string) -> u32 {
  let mut i: usize = 0
  while i < names.length {
    if names[i] == name {
      return u8.toU32(entries[i])
    }
    i = i + 1
  }
  return u32.MAX
}

// findIn for static code, one per table: static code reads the module arrays directly.
static fn staticScript(name: string) -> u32 {
  let mut i: usize = 0
  while i < SCRIPT_NAME_COUNT {
    if SCRIPT_NAMES[i] == name {
      return u8.toU32(SCRIPT_ENTRIES[i])
    }
    i = i + 1
  }
  return u32.MAX
}

static fn staticCategory(name: string) -> u32 {
  let mut i: usize = 0
  while i < GC_NAME_COUNT {
    if GC_NAMES[i] == name {
      return u8.toU32(GC_ENTRIES[i])
    }
    i = i + 1
  }
  return u32.MAX
}

static fn staticProperty(name: string) -> u32 {
  let mut i: usize = 0
  while i < PROPERTY_NAME_COUNT {
    if PROPERTY_NAMES[i] == name {
      return u8.toU32(PROPERTY_ENTRIES[i])
    }
    i = i + 1
  }
  return u32.MAX
}

// Whether the engine builds the binary property at this index of the property table: every
// property with its own range table, and the derived ones `property` computes.
fn binarySupported(property: u32) -> bool {
  return u32.toUsize(property) < unicode_prop_table_len || property == UNICODE_PROP_ASCII
    || property == UNICODE_PROP_Alphabetic
    || property == UNICODE_PROP_Any
    || property == UNICODE_PROP_Assigned
    || property == UNICODE_PROP_Cased
    || property == UNICODE_PROP_Changes_When_Casefolded
    || property == UNICODE_PROP_Changes_When_Casemapped
    || property == UNICODE_PROP_Changes_When_Lowercased
    || property == UNICODE_PROP_Changes_When_NFKC_Casefolded
    || property == UNICODE_PROP_Changes_When_Titlecased
    || property == UNICODE_PROP_Changes_When_Uppercased
    || property == UNICODE_PROP_Grapheme_Base
    || property == UNICODE_PROP_Grapheme_Extend
    || property == UNICODE_PROP_ID_Continue
    || property == UNICODE_PROP_Lowercase
    || property == UNICODE_PROP_Math
    || property == UNICODE_PROP_Uppercase
    || property == UNICODE_PROP_XID_Continue
    || property == UNICODE_PROP_XID_Start
}

fn nextByte(table: &[u8], offset: &mut usize) -> u32 {
  let value = u8.toU32(table[offset.*])
  offset.* = offset.* + 1
  return value
}

// Script extensions and extended category lengths share this three-width encoding.
fn extendedLength(table: &[u8], offset: &mut usize) -> u32 {
  let byte = nextByte(table, &mut offset.*)
  if byte < 128 {
    return byte
  }
  if byte < 192 {
    return (byte - 128) * 256 + nextByte(table, &mut offset.*) + 128
  }
  let high = (byte - 192) * 65536 + nextByte(table, &mut offset.*) * 256
  return high + nextByte(table, &mut offset.*) + 128 + 16384
}

fn bit(category: u32) -> u32 {
  return u32.shiftLeft(1, category)
}

fn categoryMask(category: u32) -> u32 {
  if category <= UNICODE_GC_Co {
    return bit(category)
  }
  if category == UNICODE_GC_LC {
    return bit(UNICODE_GC_Lu) | bit(UNICODE_GC_Ll) | bit(UNICODE_GC_Lt)
  }
  if category == UNICODE_GC_L {
    return categoryMask(UNICODE_GC_LC) | bit(UNICODE_GC_Lm) | bit(UNICODE_GC_Lo)
  }
  if category == UNICODE_GC_M {
    return bit(UNICODE_GC_Mn) | bit(UNICODE_GC_Mc) | bit(UNICODE_GC_Me)
  }
  if category == UNICODE_GC_N {
    return bit(UNICODE_GC_Nd) | bit(UNICODE_GC_Nl) | bit(UNICODE_GC_No)
  }
  if category == UNICODE_GC_S {
    return bit(UNICODE_GC_Sm) | bit(UNICODE_GC_Sc) | bit(UNICODE_GC_Sk) | bit(UNICODE_GC_So)
  }
  if category == UNICODE_GC_P {
    return bit(UNICODE_GC_Pc) | bit(UNICODE_GC_Pd) | bit(UNICODE_GC_Ps) | bit(UNICODE_GC_Pe)
      | bit(UNICODE_GC_Pi)
      | bit(UNICODE_GC_Pf)
      | bit(UNICODE_GC_Po)
  }
  if category == UNICODE_GC_Z {
    return bit(UNICODE_GC_Zs) | bit(UNICODE_GC_Zl) | bit(UNICODE_GC_Zp)
  }
  return bit(UNICODE_GC_Cc) | bit(UNICODE_GC_Cf) | bit(UNICODE_GC_Cs) | bit(UNICODE_GC_Co)
    | bit(UNICODE_GC_Cn)
}

fn letterNumberMask() -> u32 {
  return categoryMask(UNICODE_GC_L) | bit(UNICODE_GC_Nl)
}

effect fn categoryRanges(mask: u32) -> CharRange
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut result = CharRange.make()
  let table = unicode_gc_table()
  let mut offset: usize = 0
  let mut code: u32 = 0
  let letterMask = bit(UNICODE_GC_Lu) | bit(UNICODE_GC_Ll)
  while offset < table.length {
    let byte = nextByte(table, &mut offset)
    let mut length = u32.shiftRight(byte, 5)
    let category = byte & 31
    if length == 7 {
      length = extendedLength(table, &mut offset) + 7
    }
    let end = code + length + 1
    if category == 31 {
      let selected = mask & letterMask
      if selected == letterMask {
        run result.addInterval(code, end)
      } else {
        if selected != 0 {
          let mut c = code
          if mask & bit(UNICODE_GC_Ll) != 0 {
            c = c + 1
          }
          while c < end {
            run result.addInterval(c, c + 1)
            c = c + 2
          }
        }
      }
    } else {
      if mask & bit(category) != 0 {
        run result.addInterval(code, end)
      }
    }
    code = end
  }
  return move result
}

effect fn propertyRanges(property: u32) -> CharRange
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut result = CharRange.make()
  run decodeProperty(&mut result, property)
  return move result
}

effect fn applyProperty(result: &mut CharRange, property: u32, operation: RangeOperation) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let other = run propertyRanges(property)
  return run result.apply(&other, operation)
}

effect fn decodeProperty(result: &mut CharRange, property: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let table = unicode_prop_table(u32.toUsize(property))
  let mut offset: usize = 0
  let mut code: u32 = 0
  let mut inside = false
  while offset < table.length {
    let mut start = code
    let byte = nextByte(table, &mut offset)
    if byte < 64 {
      code = code + u32.shiftRight(byte, 3) + 1
      if inside {
        run result.addInterval(start, code)
      }
      inside = !inside
      start = code
      code = code + (byte & 7) + 1
    } else {
      if byte >= 128 {
        code = code + byte - 128 + 1
      } else {
        if byte < 96 {
          code = code + (byte - 64) * 256 + nextByte(table, &mut offset) + 1
        } else {
          code = code + (byte - 96) * 65536 + nextByte(table, &mut offset) * 256
          code = code + nextByte(table, &mut offset) + 1
        }
      }
    }
    if inside {
      run result.addInterval(start, code)
    }
    inside = !inside
  }
}

// From SilkJS src/unicode_ranges.silk.
/// How `CharRange.apply` combines two sets.
pub enum RangeOperation {
  /// Characters in either set.
  Union,
  /// Characters in both sets.
  Intersection,
  /// Characters in exactly one set.
  Xor,
  /// Characters in the first set and not the second.
  Subtract,
}

/// Sorted, disjoint half-open intervals over u32 character values.
/// Inversion uses an exclusive UINT32_MAX sentinel, not 0x110000.
pub struct CharRange {
  boundaries: List<u32>
}

impl CharRange {
  /// Returns an empty set.
  pub fn make() -> CharRange {
    return CharRange { boundaries: List<u32>.make() }
  }

  /// Returns the interval boundaries: each even index starts an interval, each odd index ends one.
  pub fn points(self: &Self) -> &[u32] {
    return self.boundaries.asSlice()
  }

  /// Removes every interval and keeps the storage.
  pub fn clear(self: &mut Self) -> () {
    self.boundaries.clear()
  }

  fn contains(self: &Self, code: u32) -> bool {
    let points = self.points()
    let mut low: usize = 0
    let mut high = points.length
    while low < high {
      let middle = low + (high - low) / 2
      if points[middle] <= code {
        low = middle + 1
      } else {
        high = middle
      }
    }
    return low % 2 != 0
  }

  /// Reserves room for `additional` more boundaries.
  ///
  /// # Errors
  /// - `OutOfMemoryError` if the allocator cannot grow the storage.
  pub effect fn reserve(self: &mut Self, additional: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return run self.boundaries.reserve(additional)
  }

  effect fn copy(self: &Self) -> CharRange
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut result = CharRange.make()
    let points = self.points()
    run result.reserve(points.length)
    let mut i: usize = 0
    while i < points.length {
      run result.boundaries.append(points[i])
      i = i + 1
    }
    return move result
  }

  /// Unions a half-open interval, merging overlaps and adjacent intervals.
  ///
  /// # Errors
  /// - `OutOfMemoryError` if the allocator cannot supply the set.
  pub effect fn addInterval(self: &mut Self, start: u32, end: u32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if start >= end {
      return ()
    }
    let count = self.boundaries.length()
    if count == 0 || self.boundaries.get(count - 1) < start {
      run self.reserve(2)
      run self.boundaries.append(start)
      run self.boundaries.append(end)
      return ()
    }
    if self.boundaries.get(count - 2) <= start {
      if self.boundaries.get(count - 1) < end {
        self.boundaries.set(count - 1, end)
      }
      return ()
    }
    let mut first: usize = 0
    while first < count && self.boundaries.get(first + 1) < start {
      first = first + 2
    }
    let mut mergedStart = start
    let mut mergedEnd = end
    let mut after = first
    while after < count && self.boundaries.get(after) <= mergedEnd {
      if self.boundaries.get(after) < mergedStart {
        mergedStart = self.boundaries.get(after)
      }
      if self.boundaries.get(after + 1) > mergedEnd {
        mergedEnd = self.boundaries.get(after + 1)
      }
      after = after + 2
    }
    if after == first {
      run self.reserve(2)
      run self.boundaries.insert(first, mergedStart)
      run self.boundaries.insert(first + 1, mergedEnd)
    } else {
      self.boundaries.set(first, mergedStart)
      self.boundaries.set(first + 1, mergedEnd)
      let mut source = after
      let mut target = first + 2
      while source < count {
        let point = self.boundaries.get(source)
        self.boundaries.set(target, point)
        source = source + 1
        target = target + 1
      }
      self.boundaries.truncate(target)
    }
  }

  /// Interval union uses inclusive endpoints and unsigned wrapping.
  ///
  /// # Errors
  /// - `OutOfMemoryError` if the allocator cannot supply the set.
  pub effect fn unionInterval(self: &mut Self, first: u32, last: u32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    return run self.addInterval(first, u32.wrappingAdd(last, 1))
  }

  effect fn combine(self: &Self, other: &CharRange, operation: RangeOperation) -> CharRange
    ! OutOfMemoryError
    ? &mut Allocator {
    let a = self.points()
    let b = other.points()
    let mut result = CharRange.make()
    let mut ai: usize = 0
    let mut bi: usize = 0
    let mut inside = false
    while ai < a.length || bi < b.length {
      let mut point: u32 = 0
      if ai < a.length && (bi == b.length || a[ai] < b[bi]) {
        point = a[ai]
        ai = ai + 1
      } else {
        if bi < b.length && (ai == a.length || b[bi] < a[ai]) {
          point = b[bi]
          bi = bi + 1
        } else {
          point = a[ai]
          ai = ai + 1
          bi = bi + 1
        }
      }
      let inA = ai % 2 != 0
      let inB = bi % 2 != 0
      let next = match operation {
        RangeOperation.Union => inA || inB
        RangeOperation.Intersection => inA && inB
        RangeOperation.Xor => inA != inB
        RangeOperation.Subtract => inA && !inB
      }
      if inside != next {
        run result.boundaries.append(point)
        inside = next
      }
    }
    return move result
  }

  /// Replaces this set with its combination with `other`.
  ///
  /// # Errors
  /// - `OutOfMemoryError` if the allocator cannot supply the result.
  pub effect fn apply(self: &mut Self, other: &CharRange, operation: RangeOperation) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let result = run self.combine(other, operation)
    self.* = move result
  }

  /// Replaces this set with its complement over all `u32` values.
  ///
  /// # Errors
  /// - `OutOfMemoryError` if the allocator cannot grow the storage.
  pub effect fn invert(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let count = self.boundaries.length()
    let startsAtZero = count != 0 && self.boundaries.get(0) == 0
    let endsAtMax = count != 0 && self.boundaries.get(count - 1) == u32.MAX
    if !startsAtZero && !endsAtMax {
      run self.reserve(2)
    }
    if endsAtMax {
      self.boundaries.truncate(count - 1)
    }
    if startsAtZero {
      let _removed = self.boundaries.remove(0)
    } else {
      run self.boundaries.insert(0, 0)
    }
    if !endsAtMax {
      run self.boundaries.append(u32.MAX)
    }
  }

  /// Canonicalizes only case-changing table runs, never the whole character domain.
  ///
  /// # Errors
  /// - `OutOfMemoryError` if the allocator cannot supply the set.
  pub effect fn canonicalize(self: &mut Self, isUnicode: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut caseMask: u32 = 1
    if isUnicode {
      caseMask = 4
    }
    let mask = run caseChanges(caseMask)
    let changed = run self.combine(&mask, RangeOperation.Intersection)
    let unchanged = run self.combine(&mask, RangeOperation.Subtract)
    let mut mapped = CharRange.make()
    let points = changed.points()
    let mut i: usize = 0
    let mut hasRun = false
    let mut start: u32 = 0
    let mut end: u32 = 0
    while i < points.length {
      let mut c = points[i]
      while c < points[i + 1] {
        let d = UnicodeCase.canonicalize(c, isUnicode)
        if hasRun && d == end {
          end = end + 1
        } else {
          if hasRun {
            run appendPair(&mut mapped, start, end)
          }
          start = d
          end = d + 1
          hasRun = true
        }
        c = c + 1
      }
      i = i + 2
    }
    if hasRun {
      run appendPair(&mut mapped, start, end)
    }
    sortAndMerge(&mut mapped)
    let result = run mapped.combine(&unchanged, RangeOperation.Union)
    self.* = move result
  }
}

// Append unsorted pairs only for the subsequent in-place heap sort.
effect fn appendPair(range: &mut CharRange, start: u32, end: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run range.reserve(2)
  run range.boundaries.append(start)
  run range.boundaries.append(end)
}

fn swapPair(points: &mut [u32], a: usize, b: usize) -> () {
  let start = points[a * 2]
  let end = points[a * 2 + 1]
  points[a * 2] = points[b * 2]
  points[a * 2 + 1] = points[b * 2 + 1]
  points[b * 2] = start
  points[b * 2 + 1] = end
}

fn siftDown(points: &mut [u32], root: usize, count: usize) -> () {
  let mut parent = root
  while parent < count / 2 {
    let mut child = parent * 2 + 1
    if child + 1 < count && points[child * 2] < points[(child + 1) * 2] {
      child = child + 1
    }
    if points[parent * 2] >= points[child * 2] {
      return ()
    }
    swapPair(&mut points, parent, child)
    parent = child
  }
}

fn sortAndMerge(range: &mut CharRange) -> () {
  let count = range.boundaries.length() / 2
  if count < 2 {
    return ()
  }
  let mut root = count / 2
  while root > 0 {
    root = root - 1
    siftDown(range.boundaries.asMutSlice(), root, count)
  }
  let mut end = count
  while end > 1 {
    end = end - 1
    swapPair(range.boundaries.asMutSlice(), 0, end)
    siftDown(range.boundaries.asMutSlice(), 0, end)
  }
  let mut source: usize = 0
  let mut target: usize = 0
  while source < count * 2 {
    let start = range.boundaries.get(source)
    let mut finish = range.boundaries.get(source + 1)
    source = source + 2
    while source < count * 2 && range.boundaries.get(source) <= finish {
      if range.boundaries.get(source + 1) > finish {
        finish = range.boundaries.get(source + 1)
      }
      source = source + 2
    }
    if start < finish {
      range.boundaries.set(target, start)
      range.boundaries.set(target + 1, finish)
      target = target + 2
    }
  }
  range.boundaries.truncate(target)
}

/// Table-derived characters changed by upper (1), lower (2), or fold (4).
effect fn caseChanges(caseMask: u32) -> CharRange
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut result = CharRange.make()

  // RUN_TYPE bit masks in the table's descriptor order.
  let masks: [u32; 3] = [11253, 5242, 15868]
  let mut mask: u32 = 0
  if caseMask & 1 != 0 {
    mask = mask | masks[0]
  }
  if caseMask & 2 != 0 {
    mask = mask | masks[1]
  }
  if caseMask & 4 != 0 {
    mask = mask | masks[2]
  }
  let mut index: usize = 0
  while index < case_conv_table1_len {
    let entry = case_conv_table1(index)
    let kind = u32.shiftRight(entry, 4) & 15
    let mut code = u32.shiftRight(entry, 15)
    let length = u32.shiftRight(entry, 8) & 127
    if u32.shiftRight(mask, kind) & 1 != 0 {
      if kind == 4 && !(caseMask & 1 != 0 && caseMask & 6 != 0) {
        if caseMask & 1 != 0 {
          code = code + 1
        }
        let mut i: u32 = 0
        while i < length {
          run result.addInterval(code + i, code + i + 1)
          i = i + 2
        }
      } else {
        if kind == 5 && !(caseMask & 1 != 0 && caseMask & 6 != 0) {
          if caseMask & 1 == 0 {
            run result.addInterval(code, code + 1)
          }
          run result.addInterval(code + 1, code + 2)
          if caseMask & 1 != 0 {
            run result.addInterval(code + 2, code + 3)
          }
        } else {
          run result.addInterval(code, code + length)
        }
      }
    }
    index = index + 1
  }
  return move result
}

// From SilkJS src/unicode_index.silk.
struct IndexPosition {
  pub code: u32,
  pub offset: i32
}

struct UnicodeIndex {}

fn littleEndian24(bytes: &[u8], offset: usize) -> u32 {
  return u8.toU32(bytes[offset]) | u32.shiftLeft(u8.toU32(bytes[offset + 1]), 8)
    | u32.shiftLeft(u8.toU32(bytes[offset + 2]), 16)
}

impl UnicodeIndex {
  /// Locates a block in a packed Unicode index; -1 means outside the table.
  fn position(c: u32, index: &[u8]) -> IndexPosition {
    let first = littleEndian24(index, 0) & 0x1fffff
    if c < first {
      return IndexPosition { code: 0, offset: 0 }
    }
    let mut low: usize = 0
    let mut high = index.length / 3 - 1
    if c >= littleEndian24(index, high * 3) {
      return IndexPosition { code: 0, offset: -1 }
    }
    while high - low > 1 {
      let middle = (high + low) / 2
      let code = littleEndian24(index, middle * 3) & 0x1fffff
      if c < code {
        high = middle
      } else {
        low = middle
      }
    }
    let value = littleEndian24(index, low * 3)
    return IndexPosition {
      code: value & 0x1fffff,
      offset: usize.toI32((low + 1) * 32) + u32.toI32(u32.shiftRight(value, 21)),
    }
  }

  /// Decodes alternating false/true runs from a property table.
  fn contains(c: u32, table: &[u8], index: &[u8]) -> bool {
    let location = UnicodeIndex.position(c, index)
    if location.offset < 0 {
      return false
    }
    let mut offset = i32.toUsize(location.offset)
    let mut code = location.code
    let mut bit = false
    while true {
      let byte = u8.toU32(table[offset])
      offset = offset + 1
      if byte < 64 {
        code = code + u32.shiftRight(byte, 3) + 1
        if c < code {
          return bit
        }
        bit = !bit
        code = code + (byte & 7) + 1
      } else if byte >= 0x80 {
        code = code + byte - 0x80 + 1
      } else if byte < 0x60 {
        code = code + (u32.shiftLeft(byte - 0x40, 8) | u8.toU32(table[offset])) + 1
        offset = offset + 1
      } else {
        code = code
          + (u32.shiftLeft(byte - 0x60, 16) | u32.shiftLeft(u8.toU32(table[offset]), 8)
            | u8.toU32(table[offset + 1]))
          + 1
        offset = offset + 2
      }
      if c < code {
        return bit
      }
      bit = !bit
    }
    return false
  }
}

