    47 => unicode_prop_Bidi_Mirrored_table()
    48 => unicode_prop_Emoji_table()
    49 => unicode_prop_Emoji_Component_table()
    50 => unicode_prop_Emoji_Modifier_table()
    51 => unicode_prop_Emoji_Modifier_Base_table()
    52 => unicode_prop_Emoji_Presentation_table()
    53 => unicode_prop_Extended_Pictographic_table()
    54 => unicode_prop_Default_Ignorable_Code_Point_table()
    55 => unicode_prop_ID_Start_table()
    56 => unicode_prop_Case_Ignorable_table()
    _ => invalidPropertyIndex()
  }
}

fn invalidPropertyIndex() -> &'static [u8] {
  return Intrinsic.trap("regex invariant violated")
}
