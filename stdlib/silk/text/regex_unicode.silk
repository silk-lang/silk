fn word(bytes: &[u8], at: usize) -> u32 {
  return u8.toU32(bytes[at]) * 16777216 + u8.toU32(bytes[at + 1]) * 65536
    + u8.toU32(bytes[at + 2]) * 256 + u8.toU32(bytes[at + 3])
}

/// Resolves an exact Unicode alias; kind 0 is lone/binary, 1 category, 2 script, 3 extensions.
/// Zero means that the alias is not permitted in ECMAScript Unicode mode.
pub fn lookup(kind: usize, name: string) -> usize {
  let table = match kind {
    1 => categoryNames()
    2 => scriptNames()
    3 => extensionNames()
    _ => loneNames()
  }
  let bytes = String.utf8Bytes(name)
  let mut at: usize = 0
  while at < table.length {
    let start = at
    while table[at] != 0 { at = at + 1 }
    let mut equal = at - start == bytes.length
    let mut i: usize = 0
    while equal && i < bytes.length {
      if table[start + i] != bytes[i] { equal = false }
      i = i + 1
    }
    if equal { return u32.toUsize(word(table, at + 1)) }
    at = at + 5
  }
  return 0
}

/// Tests one Unicode code point against a property ID returned by `lookup`.
pub fn contains(id: usize, cp: u32) -> bool {
  if id == 0 || id + 1 >= offsets().length / 4 { return false }
  let mut low = u32.toUsize(word(offsets(), id * 4))
  let mut high = u32.toUsize(word(offsets(), (id + 1) * 4))
  let bytes = propertyRanges()
  while low < high {
    let mid = low + (high - low) / 2
    if cp < word(bytes, mid * 8) { high = mid }
    else if cp > word(bytes, mid * 8 + 4) { low = mid + 1 }
    else { return true }
  }
  return false
}

/// Returns member `index` of the scalar's simple-fold equivalence class, or U+110000 at its end.
pub fn equivalent(cp: u32, index: usize) -> u32 {
  if index >= 4 { return 0x110000 }
  let bytes = folds()
  let mut low: usize = 0
  let mut high = bytes.length / 20
  while low < high {
    let mid = low + (high - low) / 2
    let key = word(bytes, mid * 20)
    if cp < key { high = mid }
    else if cp > key { low = mid + 1 }
    else { return word(bytes, mid * 20 + 4 + index * 4) }
  }
  if index == 0 { return cp }
  return 0x110000
}

/// Tests the Unicode ID_Start property, including ECMAScript's `$` and `_` additions.
pub fn identifierStart(cp: u32) -> bool {
  return cp == 36 || cp == 95 || contains(33, cp)
}

/// Tests Unicode ID_Continue, including ECMAScript's `$`, `_`, ZWNJ and ZWJ additions.
pub fn identifierContinue(cp: u32) -> bool {
  return cp == 36 || cp == 95 || cp == 0x200c || cp == 0x200d || contains(32, cp)
}
