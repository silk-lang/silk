fn word(b: &[u8], i: usize) -> u32 {
  return u8.toU32(b[i]) + u8.toU32(b[i + 1]) * 256 + u8.toU32(b[i + 2]) * 65536 + u8.toU32(b[i + 3]) * 16777216
}
/// Returns the table row for a Unicode scalar, for use by `status` and `replacement`.
pub fn row(cp: u32) -> usize {
  let b = mappings()
  let mut lo: usize = 0
  let mut hi = b.length / 11
  while lo + 1 < hi {
    let mid = lo + (hi - lo) / 2
    if word(b, mid * 11) <= cp { lo = mid } else { hi = mid }
  }
  return lo * 11
}
/// Returns 0 for unchanged, 1 for ignored, 2 for mapped, and 3 for disallowed scalars.
pub fn status(row: usize) -> u8 { return mappings()[row + 8] }
/// Returns the UTF-8 replacement of a mapped row; the returned view is static.
pub fn replacement(row: usize) -> string<'static> {
  let b = mappings()
  let start = u32.toUsize(word(b, row + 4))
  let length = u8.toUsize(b[row + 9]) + u8.toUsize(b[row + 10]) * 256
  return unsafe String.fromUtf8Unchecked(Slice.view<u8>(mappedText(), start, length))
}
/// Returns the IDNA2008 PVALID property, excluding characters requiring contextual checks.
pub fn pvalid(cp: u32) -> bool {
  let b = ranges()
  let mut lo: usize = 0
  let mut hi = b.length / 8
  while lo < hi {
    let mid = lo + (hi - lo) / 2
    if cp < word(b, mid * 8) { hi = mid }
    else if cp >= word(b, mid * 8 + 4) { lo = mid + 1 }
    else { return true }
  }
  return false
}
