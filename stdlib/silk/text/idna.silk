//! Convert international domain names with UTS #46 processing (Unicode 18.0.0), and encode and
//! decode Punycode (RFC 3492).
//!
//! # When to use
//! Use [`Idna.toAscii`] to turn a domain name that a person typed, such as `Bücher.example`, into
//! the ASCII form that DNS and URLs use (`xn--bcher-kva.example`). Use [`Idna.toUnicode`] to show
//! an ASCII domain name to a person. Use [`Punycode`] for the label encoding alone.
//!
//! # Details
//! Processing is nontransitional: `ß`, `ς`, U+200C, and U+200D stay as they are. [`IdnaOptions`]
//! selects the optional checks of UTS #46 section 4. The mapping table is from Unicode 18.0.0, and
//! normalization uses the NFC data of `silk.text.unicode`.
//!
//! # Examples
//! ## Convert a domain name to ASCII
//! ```silk
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.core.effect { Effect }
//! import silk.text.string { String }
//! import silk.text.idna { Idna, IdnaOptions }
//!
//! pub effect fn main() -> i32
//!   ! OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let mut output = String.make()
//!   let valid = run Idna.toAscii("Bücher.example", IdnaOptions.lenient(), &mut output)
//!     |> Effect.provideMut<Allocator>(&mut allocator)
//!   if !valid || String.view(&output) != "xn--bcher-kva.example" {
//!     return 1
//!   }
//!   return 0
//! }
//! ```

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.ownership { Copy }
import silk.collections.list { List }
import silk.text.string { String }
import silk.text.unicode { Unicode }
import silk.text.unicode_properties { BidiClass, JoiningType, CanonicalCombiningClass }
import silk.text.idna_data
import silk.collections.slice { Slice }
import silk.num.u8
import silk.num.u32
import silk.num.usize

/// The optional checks of UTS #46 processing.
///
/// # Details
/// Each field turns on one check of UTS #46 section 4. A domain name that fails a check that is on
/// is not valid.
pub struct IdnaOptions {
  /// Reject labels that start or end with `-`, or that have `--` in positions 3 and 4.
  pub checkHyphens: bool,
  /// Apply the bidirectional rule of RFC 5893 to each label of a domain name that has
  /// right-to-left characters.
  pub checkBidi: bool,
  /// Apply the CONTEXTJ rules of RFC 5892 to U+200C and U+200D.
  pub checkJoiners: bool,
  /// Allow only `a`-`z`, `0`-`9`, and `-` as ASCII characters in a label.
  pub useStd3AsciiRules: bool,
  /// Reject empty labels, labels longer than 63 bytes, and names longer than 253 bytes.
  pub verifyDnsLength: bool,
}

impl Copy for IdnaOptions {}

impl IdnaOptions {
  /// Returns the options of the URL Standard's domain to ASCII: bidi and joiner checks on, and the
  /// hyphen, STD3, and DNS length checks off.
  pub fn lenient() -> IdnaOptions {
    return IdnaOptions {
      checkHyphens: false,
      checkBidi: true,
      checkJoiners: true,
      useStd3AsciiRules: false,
      verifyDnsLength: false,
    }
  }

  /// Returns the options for a host name that DNS must accept: all checks on.
  pub fn strict() -> IdnaOptions {
    return IdnaOptions {
      checkHyphens: true,
      checkBidi: true,
      checkJoiners: true,
      useStd3AsciiRules: true,
      verifyDnsLength: true,
    }
  }
}

/// Functions that convert domain names with UTS #46 processing.
pub struct Idna {}

impl Idna {
  /// Appends the ASCII form of `domain` to `output`, and returns whether `domain` is valid.
  ///
  /// # Details
  /// It maps, normalizes, and checks `domain`, then encodes each label that has non-ASCII
  /// characters as `xn--` and Punycode. The options select the optional checks. When the result is
  /// `false`, `output` holds the converted text, which must not be used as a domain name.
  ///
  /// # Errors
  /// - `OutOfMemoryError` if the `Allocator` fails.
  pub effect fn toAscii(domain: string, options: IdnaOptions, output: &mut String) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    return run process(domain, options, &mut output.*, true)
  }

  /// Appends the Unicode form of `domain` to `output`, and returns whether `domain` is valid.
  ///
  /// # Details
  /// It maps, normalizes, and checks `domain`, and decodes each `xn--` label. A label that does not
  /// decode stays as it is. The options select the optional checks. Even when the result is
  /// `false`, `output` holds the converted text, as UTS #46 ToUnicode specifies.
  ///
  /// # Errors
  /// - `OutOfMemoryError` if the `Allocator` fails.
  pub effect fn toUnicode(domain: string, options: IdnaOptions, output: &mut String) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    return run process(domain, options, &mut output.*, false)
  }
}

/// Functions that encode and decode Punycode (RFC 3492), the label encoding of IDNA.
pub struct Punycode {}

impl Punycode {
  /// Decodes the Punycode `text`, without the `xn--` prefix, and appends the code points to
  /// `output`. Returns `false` if `text` is not valid Punycode; `output` then holds a part of the
  /// result.
  ///
  /// # Details
  /// Letters can be uppercase or lowercase. A result that is not a Unicode scalar value is not
  /// valid.
  ///
  /// # Errors
  /// - `OutOfMemoryError` if the `Allocator` fails.
  pub effect fn decode(text: &[u8], output: &mut List<u32>) -> bool
    ! OutOfMemoryError
    ? &mut Allocator {
    let first = List<u32>.length(&output.*)
    let mut basic: usize = 0
    let mut j: usize = 0
    while j < text.length {
      if text[j] == 45 {
        basic = j + 1
      }
      j = j + 1
    }
    if basic > 0 {
      j = 0
      while j + 1 < basic {
        if text[j] >= 128 {
          return false
        }
        run List<u32>.append(&mut output.*, u8.toU32(text[j]))
        j = j + 1
      }
    }
    let mut offset = basic
    let mut n: u32 = 128
    let mut index: u32 = 0
    let mut bias: u32 = 72
    while offset < text.length {
      let old = index
      let mut weight: u32 = 1
      let mut k: u32 = 36
      while true {
        if offset == text.length {
          return false
        }
        let c = text[offset]
        offset = offset + 1
        let mut d: u32 = 36
        if c >= 97 && c <= 122 {
          d = u8.toU32(c) - 97
        }
        if c >= 65 && c <= 90 {
          d = u8.toU32(c) - 65
        }
        if c >= 48 && c <= 57 {
          d = u8.toU32(c) - 22
        }
        if d >= 36 || d > (4294967295 - index) / weight {
          return false
        }
        index = index + d * weight
        let t = threshold(k, bias)
        if d < t {
          break
        }
        if weight > 4294967295 / (36 - t) {
          return false
        }
        weight = weight * (36 - t)
        k = k + 36
      }
      let count64 = List<u32>.length(&output.*) - first + 1
      if count64 > 0x10FFFF {
        return false
      }
      let count = usize.toU32(count64)
      bias = adapt(index - old, count, old == 0)
      if index / count > 0x10FFFF - n {
        return false
      }
      n = n + index / count
      if n > 0x10FFFF || (n >= 0xD800 && n <= 0xDFFF) {
        return false
      }
      index = index % count
      run List<u32>.insert(&mut output.*, first + u32.toUsize(index), n)
      index = index + 1
    }
    return true
  }

  /// Encodes `points` as Punycode, without the `xn--` prefix, and appends it to `output`.
  ///
  /// # Details
  /// Digits are lowercase letters and `0`-`9`. Each value must be a Unicode scalar value.
  ///
  /// # Errors
  /// - `OutOfMemoryError` if the `Allocator` fails.
  pub effect fn encode(points: &[u32], output: &mut String) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut handled: u32 = 0
    let mut j: usize = 0
    while j < points.length {
      if points[j] < 128 {
        run appendScalar(&mut output.*, points[j])
        handled = handled + 1
      }
      j = j + 1
    }
    let basic = handled
    if basic > 0 {
      run String.append(&mut output.*, "-")
    }
    let mut n: u32 = 128
    let mut delta: u32 = 0
    let mut bias: u32 = 72
    while handled < usize.toU32(points.length) {
      let mut minimum: u32 = 0x10FFFF
      j = 0
      while j < points.length {
        let cp = points[j]
        if cp >= n && cp < minimum {
          minimum = cp
        }
        j = j + 1
      }
      delta = delta + (minimum - n) * (handled + 1)
      n = minimum
      j = 0
      while j < points.length {
        let cp = points[j]
        if cp < n {
          delta = delta + 1
        }
        if cp == n {
          let mut q = delta
          let mut k: u32 = 36
          while true {
            let t = threshold(k, bias)
            if q < t {
              break
            }
            run encodeDigit(&mut output.*, t + (q - t) % (36 - t))
            q = (q - t) / (36 - t)
            k = k + 36
          }
          run encodeDigit(&mut output.*, q)
          bias = adapt(delta, handled + 1, handled == basic)
          delta = 0
          handled = handled + 1
        }
        j = j + 1
      }
      delta = delta + 1
      n = n + 1
    }
    return ()
  }
}

fn adapt(delta: u32, points: u32, first: bool) -> u32 {
  let mut d = delta / 2
  if first {
    d = delta / 700
  }
  d = d + d / points
  let mut k: u32 = 0
  while d > 455 {
    d = d / 35
    k = k + 36
  }
  return k + 36 * d / (d + 38)
}

fn threshold(k: u32, bias: u32) -> u32 {
  if k <= bias {
    return 1
  }
  if k >= bias + 26 {
    return 26
  }
  return k - bias
}

effect fn encodeDigit(output: &mut String, digit: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let digits = "abcdefghijklmnopqrstuvwxyz0123456789"
  return run String.append(&mut output.*, String.slice(digits, u32.toUsize(digit), 1))
}

effect fn appendScalar(output: &mut String, cp: u32) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut bytes: [u8; 4] = [0; 4]
  let mut length: usize = 1
  if cp < 128 {
    bytes[0] = u32.toU8(cp)
  } else if cp < 2048 {
    bytes[0] = u32.toU8(192 + cp / 64)
    bytes[1] = u32.toU8(128 + cp % 64)
    length = 2
  } else if cp < 65536 {
    bytes[0] = u32.toU8(224 + cp / 4096)
    bytes[1] = u32.toU8(128 + cp / 64 % 64)
    bytes[2] = u32.toU8(128 + cp % 64)
    length = 3
  } else {
    bytes[0] = u32.toU8(240 + cp / 262144)
    bytes[1] = u32.toU8(128 + cp / 4096 % 64)
    bytes[2] = u32.toU8(128 + cp / 64 % 64)
    bytes[3] = u32.toU8(128 + cp % 64)
    length = 4
  }
  let text = unsafe String.fromUtf8Unchecked(Slice.view<u8>(&bytes, 0, length))
  return run String.append(&mut output.*, text)
}

// Decodes the scalar at `index` of valid UTF-8 and advances `index`.
fn nextPoint(b: &[u8], index: &mut usize) -> u32 {
  let i = index.*
  let c = u8.toU32(b[i])
  if c < 0x80 {
    index.* = i + 1
    return c
  }
  if c < 0xE0 {
    index.* = i + 2
    return u32.shiftLeft(c & 31, 6) | (u8.toU32(b[i + 1]) & 63)
  }
  if c < 0xF0 {
    index.* = i + 3
    return u32.shiftLeft(c & 15, 12) | u32.shiftLeft(u8.toU32(b[i + 1]) & 63, 6)
      | (u8.toU32(b[i + 2]) & 63)
  }
  index.* = i + 4
  return u32.shiftLeft(c & 7, 18) | u32.shiftLeft(u8.toU32(b[i + 1]) & 63, 12)
    | u32.shiftLeft(u8.toU32(b[i + 2]) & 63, 6)
    | (u8.toU32(b[i + 3]) & 63)
}

// Separates labels in the code point list; it is not a Unicode scalar value.
const SEPARATOR: u32 = 0xFFFFFFFF

fn isRtl(cp: u32) -> bool {
  let d = BidiClass.of(cp)
  return d == BidiClass.R || d == BidiClass.AL || d == BidiClass.AN
}

// UTS #46 sections 4.1 to 4.3: map, normalize, convert and check each label, then join the labels
// in ASCII or Unicode form.
effect fn process(domain: string, options: IdnaOptions, output: &mut String, ascii: bool) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut ok = true
  let mut mapped = run String.makeWithCapacity(String.byteLength(domain))
  let source = String.utf8Bytes(domain)
  let mut i: usize = 0
  while i < source.length {
    let start = i
    let cp = nextPoint(source, &mut i)
    let row = idna_data.row(cp)
    let status = idna_data.status(row)
    if status == 1 {
      continue
    }
    if status == 2 {
      run String.append(&mut mapped, idna_data.replacement(row))
    } else {
      if status == 3 {
        ok = false
      }
      run String.append(&mut mapped, String.slice(domain, start, i - start))
    }
  }
  let normalized = run Unicode.normalizeNfc(String.view(&mapped))
  let text = String.view(&normalized)
  let bytes = String.utf8Bytes(text)

  // Every label's code points, each label followed by SEPARATOR. Bidi checks need all labels
  // first, because one right-to-left label makes the rule apply to every label.
  let mut points = run List<u32>.makeWithCapacity(bytes.length + 1)
  let mut rtl = false
  let mut start: usize = 0
  i = 0
  while i <= bytes.length {
    if i < bytes.length && bytes[i] != 46 {
      i = i + 1
      continue
    }
    let labelStart = List<u32>.length(&points)
    let label = Slice.view<u8>(bytes, start, i - start)
    let alabel = label.length >= 4 && label[0] == 120 && label[1] == 110 && label[2] == 45
      && label[3] == 45
    let mut decoded = false
    if alabel {
      let mut nonascii = false
      let mut j: usize = 0
      while j < label.length {
        if label[j] >= 128 {
          nonascii = true
        }
        j = j + 1
      }
      if nonascii {
        ok = false
      } else if !(run Punycode.decode(Slice.view<u8>(label, 4, label.length - 4), &mut points)) {
        ok = false
        List<u32>.truncate(&mut points, labelStart)
      } else {
        decoded = true
        let mut allAscii = true
        j = labelStart
        while j < List<u32>.length(&points) {
          if List<u32>.get(&points, j) >= 128 {
            allAscii = false
          }
          j = j + 1
        }
        if allAscii || List<u32>.length(&points) == labelStart {
          ok = false
        }
      }
    }
    if !decoded {
      // Keep the label's own text: an undecodable A-label stays as it is.
      List<u32>.truncate(&mut points, labelStart)
      let mut j: usize = 0
      while j < label.length {
        run List<u32>.append(&mut points, nextPoint(label, &mut j))
      }
    }
    let labelEnd = List<u32>.length(&points)
    let labelPoints = Slice.view<u32>(List<u32>.asSlice(&points), labelStart, labelEnd - labelStart)
    if decoded || !alabel {
      let labelValid = run valid(labelPoints, options, decoded)
      if !labelValid {
        ok = false
      }
    }
    let mut j: usize = 0
    while j < labelPoints.length {
      if isRtl(labelPoints[j]) {
        rtl = true
      }
      j = j + 1
    }
    if options.verifyDnsLength && labelEnd == labelStart && i < bytes.length {
      ok = false
    }
    run List<u32>.append(&mut points, SEPARATOR)
    start = i + 1
    i = i + 1
  }
  if options.verifyDnsLength && bytes.length == 0 {
    ok = false
  }

  // Join the labels.
  let base = String.ownedByteLength(&output.*)
  let all = List<u32>.asSlice(&points)
  let mut labelStart: usize = 0
  let mut index: usize = 0
  let mut first = true
  while index < all.length {
    if all[index] != SEPARATOR {
      index = index + 1
      continue
    }
    let labelPoints = Slice.view<u32>(all, labelStart, index - labelStart)
    if !first {
      run String.append(&mut output.*, ".")
    }
    first = false
    if options.checkBidi && rtl && labelPoints.length > 0 && !bidi(labelPoints) {
      ok = false
    }
    let labelOutput = String.ownedByteLength(&output.*)
    let mut nonascii = false
    let mut j: usize = 0
    while j < labelPoints.length {
      if labelPoints[j] >= 128 {
        nonascii = true
      }
      j = j + 1
    }
    if ascii && nonascii {
      run String.append(&mut output.*, "xn--")
      run Punycode.encode(labelPoints, &mut output.*)
    } else {
      j = 0
      while j < labelPoints.length {
        run appendScalar(&mut output.*, labelPoints[j])
        j = j + 1
      }
    }
    if options.verifyDnsLength && ascii {
      let length = String.ownedByteLength(&output.*) - labelOutput
      if length > 63 {
        ok = false
      }
    }
    index = index + 1
    labelStart = index
  }
  if options.verifyDnsLength && ascii {
    let mut total = String.ownedByteLength(&output.*) - base

    // A trailing dot (the root label) does not count.
    if total > 0 && String.ownedUtf8Bytes(&output.*)[base + total - 1] == 46 {
      total = total - 1
    }
    if total == 0 || total > 253 {
      ok = false
    }
  }
  return ok
}

// UTS #46 section 4.1 validity criteria for nontransitional processing. `decoded` labels came from
// Punycode, so they are not yet known to be NFC or to have only valid code points.
effect fn valid(label: &[u32], options: IdnaOptions, decoded: bool) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let n = label.length
  if n == 0 {
    return true
  }
  if decoded {
    let mut text = String.make()
    let mut i: usize = 0
    while i < n {
      run appendScalar(&mut text, label[i])
      i = i + 1
    }
    let nfc = run Unicode.normalizeNfc(String.view(&text))
    if String.view(&nfc) != String.view(&text) {
      return false
    }
  }
  if options.checkHyphens {
    if label[0] == 45 || label[n - 1] == 45 {
      return false
    }
    if n >= 4 && label[2] == 45 && label[3] == 45 {
      return false
    }
  } else if n >= 4 && label[0] == 120 && label[1] == 110 && label[2] == 45 && label[3] == 45 {
    return false
  }
  if Unicode.isMark(label[0]) {
    return false
  }
  let mut i: usize = 0
  while i < n {
    let cp = label[i]
    if cp == 46 {
      return false
    }
    if decoded && idna_data.status(idna_data.row(cp)) != 0 {
      return false
    }
    if options.useStd3AsciiRules && cp < 128 && !(cp >= 97 && cp <= 122) && !(cp >= 48 && cp <= 57)
      && cp != 45 {
      return false
    }
    if options.checkJoiners && (cp == 0x200C || cp == 0x200D) && !joiner(label, i) {
      return false
    }
    i = i + 1
  }
  return true
}

// The CONTEXTJ rules of RFC 5892 appendix A.1 and A.2.
fn joiner(label: &[u32], i: usize) -> bool {
  let cp = label[i]
  let n = label.length
  if i > 0 && CanonicalCombiningClass.number(CanonicalCombiningClass.of(label[i - 1])) == 9 {
    return true
  }
  if cp == 0x200D {
    return false
  }
  let mut j = i
  let mut left = false
  while j > 0 {
    j = j - 1
    let joining = JoiningType.of(label[j])
    if joining != JoiningType.T {
      left = joining == JoiningType.L || joining == JoiningType.D
      break
    }
  }
  if !left {
    return false
  }
  j = i + 1
  while j < n {
    let joining = JoiningType.of(label[j])
    if joining != JoiningType.T {
      return joining == JoiningType.R || joining == JoiningType.D
    }
    j = j + 1
  }
  return false
}

// The six conditions of the bidi rule, RFC 5893 section 2.
fn bidi(label: &[u32]) -> bool {
  let first = BidiClass.of(label[0])
  let rtl = first == BidiClass.R || first == BidiClass.AL
  if !rtl && first != BidiClass.L {
    return false
  }
  let mut end = false
  let mut european = false
  let mut arabic = false
  let mut i: usize = 0
  while i < label.length {
    let d = BidiClass.of(label[i])
    if d == BidiClass.EN {
      european = true
    }
    if d == BidiClass.AN {
      arabic = true
    }
    let neutral = d == BidiClass.EN || d == BidiClass.ES || d == BidiClass.CS || d == BidiClass.ET
      || d == BidiClass.ON
      || d == BidiClass.BN
      || d == BidiClass.NSM
    if rtl {
      if !neutral && d != BidiClass.R && d != BidiClass.AL && d != BidiClass.AN {
        return false
      }
      if d != BidiClass.NSM {
        end = d == BidiClass.R || d == BidiClass.AL || d == BidiClass.EN || d == BidiClass.AN
      }
    } else {
      if !neutral && d != BidiClass.L {
        return false
      }
      if d != BidiClass.NSM {
        end = d == BidiClass.L || d == BidiClass.EN
      }
    }
    i = i + 1
  }
  return end && (!rtl || !european || !arabic)
}
