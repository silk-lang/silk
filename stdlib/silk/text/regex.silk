//! ECMAScript Unicode regular expressions for text and JSON Schema patterns.
//!
//! # When to use
//! Use `Regex.compile` and `Regex.test` to reuse a `Pattern` across many searches. Use
//! `Regex.validate` to check syntax or `Regex.matches` for a one-off unanchored search. Patterns
//! use the ECMA-262 Unicode (`u`) grammar, not shell glob syntax.
//!
//! # Details
//! The engine is the QuickJS regular-expression compiler and backtracking matcher as SilkJS ports
//! it to Silk (QuickJS is Copyright (c) 2017-2021 Fabrice Bellard and Charlie Gordon, under the MIT
//! license in `licenses/quickjs.txt`). A pattern compiles to bytecode once; a search then runs it
//! with search hints (literal runs, anchors and first-character sets) and a heap backtracking
//! stack, so long text never exhausts the native stack. Matching supports captures, named and
//! numeric backreferences, forward and backward assertions, alternation, character classes, Unicode
//! properties, greedy and lazy repetition, and scoped `i`, `m`, and `s` modifiers. Unicode
//! properties and case folding use Unicode 17.0.0.
//!
//! Text is UTF-8. ASCII text is matched in place; other text is converted to UTF-16 for the
//! search, and a surrogate pair is one character, as in ECMAScript's `u` mode. Syntax failures
//! and exhausted resource limits are errors, never a negative match.
//!
//! @category Text

import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.mem.stack { Stack }
import silk.num.i32
import silk.num.i64
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.u8
import silk.num.usize
import silk.simd.i64x2
import silk.simd.mask16
import silk.simd.mask8
import silk.simd.u16x8
import silk.simd.u8x16
import silk.text.regex_unicode {
  CharRange,
  RangeOperation,
  UnicodeCase,
  UnicodeProperties,
  UnknownProperty
}
import silk.text.string { String }
import silk.text.utf8_scan

/// The kind of failure a regular expression reports.
pub enum RegexReason {
  /// The pattern does not follow the ECMAScript Unicode (`u`) grammar.
  Syntax,
  /// The pattern exceeds 65,536 bytes, nests groups deeper than 255 levels, or has 255 or more
  /// captures, too many class ranges or too many nested quantifiers.
  PatternLimit,
  /// A search exhausted its work budget of about 1,000,000 backtracking steps.
  MatchLimit,
}

/// A structured regex failure, distinct from a valid pattern that does not match.
pub struct RegexError {
  /// The syntax or resource-limit failure.
  pub reason: RegexReason,
  /// What is wrong, in the words of the ECMAScript grammar; empty for a resource limit.
  pub message: string<'static>,
  /// The byte offset in the pattern where the failure was detected; zero for a resource limit.
  pub offset: usize,
}

/// An owned, immutable ECMAScript Unicode regular-expression program.
///
/// # Details
/// Construct it with `Regex.compile` and search any number of strings with `Regex.test`. It owns
/// its bytecode and does not borrow the source pattern. Matching does not mutate it.
pub struct Pattern {
  program: RegExpProgram
}

/// The owner of ECMAScript Unicode pattern validation and unanchored matching operations.
pub struct Regex {}

impl Regex {
  /// Compiles an ECMAScript Unicode (`u`) pattern for repeated unanchored searches.
  ///
  /// # Details
  /// Patterns have no surrounding slashes or flags. Scoped `(?ims-ims:...)` modifiers are
  /// supported. Captures, backreferences, lookarounds and Unicode property escapes compile to
  /// bytecode; property aliases and case folding use Unicode 17.0.0. The result owns its program
  /// and does not borrow `pattern`.
  ///
  /// # Errors
  /// - `RegexError` with `Syntax` for invalid syntax, or `PatternLimit` for more than 65,536
  ///   pattern bytes, groups nested deeper than 255 levels, 255 or more captures, or too many
  ///   class ranges or nested quantifiers.
  /// - `OutOfMemoryError` if the allocator cannot supply the program.
  pub effect fn compile(pattern: string) -> Pattern
    ! RegexError | OutOfMemoryError
    ? &mut Allocator {
    let bytes = String.utf8Bytes(pattern)
    if bytes.length > 65536 {
      fail RegexError { reason: RegexReason.PatternLimit, message: "", offset: 0 }
    }
    let compiled = run Effect.catch<RegExpStackOverflow>(
      Effect.catch<RegExpSyntaxError>(
        RegExpCompiler.compile(bytes, FLAG_UNICODE, 256, 0),
        syntaxFailure,
      ),
      nestingFailure,
    )
    return Pattern { program: move compiled }
  }

  /// Checks the entire pattern against the ECMAScript Unicode (`u`) grammar.
  ///
  /// # Details
  /// There are no surrounding slashes or flags. Scoped `(?ims-ims:...)` modifiers are accepted.
  /// Unicode property names and values are exact, case-sensitive Unicode 17.0.0 aliases. Legacy
  /// octal and identity escapes are not accepted in Unicode mode.
  ///
  /// # Errors
  /// - `RegexError` with `Syntax` for invalid syntax, or `PatternLimit` for more than 65,536
  ///   pattern bytes, groups nested deeper than 255 levels, 255 or more captures, or too many
  ///   class ranges or nested quantifiers.
  /// - `OutOfMemoryError` if the allocator cannot supply the program.
  pub effect fn validate(pattern: string) -> ()
    ! RegexError | OutOfMemoryError
    ? &mut Allocator {
    let compiled = run Regex.compile(pattern)
    drop compiled
    return ()
  }

  /// Returns whether any substring of `text` matches an ECMAScript Unicode (`u`) pattern.
  ///
  /// # Details
  /// The pattern has no surrounding slashes or flags. Matching is case-sensitive, with `.` excluding
  /// LF, CR, U+2028 and U+2029, unless scoped `i`, `m` or `s` modifiers change those rules. Without
  /// `m`, `^` and `$` mean the actual beginning and end, including when text ends in a newline.
  /// `\d` and `\w` are ASCII classes; `\s` is ECMAScript whitespace and line terminators.
  /// Captures, backreferences and repetition have ECMAScript backtracking order.
  ///
  /// # Errors
  /// - `RegexError` for an invalid pattern, as `Regex.compile` reports it, or `MatchLimit` when
  ///   the search exhausts its work budget. Exhaustion is never reported as `false`.
  /// - `OutOfMemoryError` if the allocator cannot supply the program or matcher state.
  pub effect fn matches(pattern: string, text: string) -> bool
    ! RegexError | OutOfMemoryError
    ? &mut Allocator {
    let compiled = run Regex.compile(pattern)
    return run Regex.test(&compiled, text)
  }

  /// Searches `text` with a previously compiled ECMAScript Unicode pattern.
  ///
  /// # Details
  /// Searches are unanchored unless the pattern supplies anchors. Captures and repetition use
  /// ECMAScript backtracking order. ASCII text is searched in place; other text is first converted
  /// to UTF-16 in storage that belongs to this call. The pattern is immutable.
  ///
  /// # Errors
  /// - `RegexError` with `MatchLimit` after about 1,000,000 backtracking steps. Exhaustion is
  ///   never reported as `false`.
  /// - `OutOfMemoryError` if the allocator cannot supply converted text or backtracking storage.
  pub effect fn test(pattern: &Pattern, text: string) -> bool
    ! RegexError | OutOfMemoryError
    ? &mut Allocator {
    let code = pattern.program.asSlice()
    let bytes = String.utf8Bytes(text)
    let mut ascii = true
    let mut at: usize = 0
    while at < bytes.length {
      if bytes[at] >= 128 {
        ascii = false
        break
      }
      at = at + 1
    }
    if ascii {
      return run Effect.catch<RegExpTimeout>(searchNarrow(code, bytes), budgetFailure)
    }
    let mut units = List<u16>.make()
    run units.reserve(bytes.length)
    at = 0
    while at < bytes.length {
      let decoded = utf8_scan.decode(bytes, at)
      let scalar = decoded.scalar
      if scalar < 65536 {
        run units.append(u32.toU16(scalar))
      } else {
        run units.append(u32.toU16(55232 + u32.shiftRight(scalar, 10)))
        run units.append(u32.toU16(56320 + u32.bitAnd(scalar, 1023)))
      }
      at = decoded.next
    }
    return run Effect.catch<RegExpTimeout>(searchWide(code, units.asSlice()), budgetFailure)
  }
}

// The matcher polls its interrupt callback once per 10,000 backtracking events; a search gives
// up after MATCH_POLLS polls.
const MATCH_POLLS: usize = 100

fn spend(polls: &mut usize) -> bool {
  polls.* = polls.* + 1
  return polls.* > MATCH_POLLS
}

// Each closure literal instantiates its own copy of the matcher, so each width has one call site.
effect fn searchNarrow(code: &[u8], text: &[u8]) -> bool
  ! OutOfMemoryError | RegExpTimeout
  ? &mut Allocator {
  let mut polls: usize = 0
  let mut captures = Captures.empty()
  return run RegExpExecutor.match8(
    code,
    text,
    0,
    effect fn() -> bool
      ? &mut Allocator {
      return spend(&mut polls)
    },
    &mut captures,
  )
}

effect fn searchWide(code: &[u8], text: &[u16]) -> bool
  ! OutOfMemoryError | RegExpTimeout
  ? &mut Allocator {
  let mut polls: usize = 0
  let mut captures = Captures.empty()
  return run RegExpExecutor.match16(
    code,
    text,
    0,
    effect fn() -> bool
      ? &mut Allocator {
      return spend(&mut polls)
    },
    &mut captures,
  )
}

effect fn syntaxFailure(error: RegExpSyntaxError) -> RegExpProgram
  ! RegexError {
  let message = error.message
  if message == "too many captures" || message == "too many ranges"
    || message == "too many imbricated quantifiers" {
    fail RegexError { reason: RegexReason.PatternLimit, message: message, offset: 0 }
  }
  fail RegexError { reason: RegexReason.Syntax, message: message, offset: error.offset }
}

effect fn nestingFailure(error: RegExpStackOverflow) -> RegExpProgram
  ! RegexError {
  drop error
  fail RegexError { reason: RegexReason.PatternLimit, message: "", offset: 0 }
}

effect fn budgetFailure(error: RegExpTimeout) -> bool
  ! RegexError {
  drop error
  fail RegexError { reason: RegexReason.MatchLimit, message: "", offset: 0 }
}

// From SilkJS src/regexp_types.silk.
const FLAG_IGNORECASE: u32 = 2

const FLAG_MULTILINE: u32 = 4

const FLAG_DOTALL: u32 = 8

const FLAG_UNICODE: u32 = 16

const FLAG_STICKY: u32 = 32

const FLAG_NAMED_GROUPS: u32 = 128

const FLAG_UNICODE_SETS: u32 = 256

/// Internal header bit, never a JS flag: the program ends with a search hint
/// (HINT_LENGTH bytes before the program's end, after its unreachable final
/// REOP_match): HINT_OPCODE, the kind, then the u16 offset of a run of REOP_char
/// steps and a u16 whose low byte is the run's length (at most 255) and whose
/// high byte is the index of its least common unit, which long searches scan for.
/// Then the search prefix's plan: the u16 offset of the first consuming step
/// after the prefix and any zero-width steps (0 when the program has no
/// prefix), and that step's opcode when the executor can skip to positions
/// where it may match (char, char_i, line_start, space, not_space, the class
/// and range steps), else 0.
const FLAG_HINT: u32 = 512

const HINT_OPCODE: u8 = 45

const HINT_LENGTH: usize = 9

/// The whole match is the run: a substring search finds it.
const HINT_LITERAL: u8 = 1

/// Every match contains the run at or after its start: a search from the start
/// position that does not find it cannot match.
const HINT_REQUIRED: u8 = 2

/// The pattern starts with ^ (not multiline): only position 0 can match, so
/// a search from 0 needs no prefix and one from later fails.
const HINT_ANCHORED: u8 = 3

/// Set in the kind when HINT_SET_LENGTH bytes before the trailer hold a bitmap
/// of the Latin-1 units a match can start with (any unit above 255 may start
/// one): a search skips positions whose unit is not in it.
const HINT_FIRST_SET: u8 = 128

const HINT_SET_LENGTH: usize = 32

/// Set in the kind of a literal or required run whose units are all Latin-1:
/// the run's count units are also stored as bytes just before the first-unit
/// bitmap (just before the trailer when there is none), so a search compares a
/// candidate a word at a time.
const HINT_RUN_BYTES: u8 = 64

/// A literal run with a unit above 255 keeps its units instead, two bytes each
/// (low byte first), in the same place; the kind byte's low five bits are the kind.
const HINT_RUN_UNITS: u8 = 32

/// Narrow classes as the compiler emits them: REOP_range (REOP_CLASS_I:
/// REOP_range_i) followed by a CLASS_BITS_LENGTH-byte bitmap of the Latin-1
/// units the class matches (after case folding for REOP_CLASS_I), so the
/// executor tests those units with one load. Units above 255 use the table.
const REOP_CLASS: u8 = 46

const REOP_CLASS_I: u8 = 47

const CLASS_BITS_LENGTH: usize = 32

/// Greedy loops over one one-character step x, as the compiler marks them:
/// REOP_STAR replaces the REOP_split_next_first of `split, x, goto split`
/// (x*), REOP_PLUS the REOP_split_goto_first back edge right after x (x+).
/// Same operands as the split; when every character is one unit the
/// executor runs x in place and keeps one frame for the whole run.
const REOP_STAR: u8 = 48

const REOP_PLUS: u8 = 49

/// Compiler-produced bytecode with its original QuickJS header and name trailer.
/// Bytecode passed to the executor must be a complete, unmodified compiler result.
struct RegExpProgram {
  pub bytecode: List<u8>
}

impl RegExpProgram {
  fn asSlice(self: &Self) -> &[u8] {
    return self.bytecode.asSlice()
  }

  fn flags(self: &Self) -> u32 {
    return u16.toU32(readU16(self.bytecode.asSlice(), 0))
  }

  fn captureCount(self: &Self) -> usize {
    return u8.toUsize(self.bytecode.get(2))
  }

  fn allocCount(self: &Self) -> usize {
    return self.captureCount() * 2 + u8.toUsize(self.bytecode.get(3))
  }

  /// Named capture records: UTF-8 name text, NUL, one scope byte. Empty when absent.
  fn groupNames(self: &Self) -> &[u8] {
    if self.flags() & FLAG_NAMED_GROUPS == 0 {
      return b""
    }
    let data = self.bytecode.asSlice()
    let offset = u32.toUsize(readU32(data, 4)) + 8
    return Slice.view(data, offset, data.length - offset)
  }
}

struct RegExpSyntaxError {
  pub message: string<'static>,
  pub offset: usize
}

struct RegExpStackOverflow {}

struct RegExpTimeout {}

/// Successful captures contain start/end code-unit offsets for every group,
/// including group zero. An unmatched group has -1 in both slots.
struct RegExpMatch {
  pub matched: bool,
  pub captures: Captures
}

/// Capture offsets: up to INLINE_CAPTURES in place, more in their own list.
const INLINE_CAPTURES: usize = 24

struct Captures {
  count: usize,
  inline: [i32; 24],
  spill: List<i32>
}

impl Captures {
  fn empty() -> Captures {
    return Captures { count: 0, inline: [0; 24], spill: List<i32>.make() }
  }

  /// count offsets, all set to -1; the spill list is reserved when count exceeds the inline room.
  effect fn unset(count: usize) -> Captures
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut made = Captures { count: count, inline: [-1; 24], spill: List<i32>.make() }
    if count > INLINE_CAPTURES {
      run made.spill.appendRepeated(-1, count)
    }
    return move made
  }

  /// count (at most INLINE_CAPTURES) offsets held in place.
  fn fromInline(count: usize, inline: [i32; 24]) -> Captures {
    if count > INLINE_CAPTURES {
      Intrinsic.trap("Captures.fromInline: too many offsets")
    }
    return Captures { count: count, inline: inline, spill: List<i32>.make() }
  }

  /// The offsets in spill, more than INLINE_CAPTURES of them.
  fn fromSpill(spill: List<i32>) -> Captures {
    if spill.length() <= INLINE_CAPTURES {
      Intrinsic.trap("Captures.fromSpill: too few offsets")
    }
    return Captures { count: spill.length(), inline: [0; 24], spill: move spill }
  }

  /// Makes self count (at most INLINE_CAPTURES) offsets held in place, dropping
  /// any spill list, and returns them for the caller to write.
  @inlineAlways
  fn placeInline(self: &mut Self, count: usize) -> &mut [i32; 24] {
    if count > INLINE_CAPTURES {
      Intrinsic.trap("Captures.placeInline: too many offsets")
    }
    if self.count > INLINE_CAPTURES {
      let old = Intrinsic.replace(self.spill, List<i32>.make())
      drop old
    }
    self.count = count
    return &mut self.inline
  }

  fn length(self: &Self) -> usize {
    return self.count
  }

  fn get(self: &Self, index: usize) -> i32 {
    if index >= self.count {
      Intrinsic.trap("Captures.get: index out of range")
    }
    if self.count > INLINE_CAPTURES {
      return self.spill.get(index)
    }
    return self.inline[index]
  }

  fn set(self: &mut Self, index: usize, value: i32) -> () {
    if index >= self.count {
      Intrinsic.trap("Captures.set: index out of range")
    }
    if self.count > INLINE_CAPTURES {
      self.spill.set(index, value)
    } else {
      self.inline[index] = value
    }
  }

  fn asSlice(self: &Self) -> &[i32] {
    if self.count > INLINE_CAPTURES {
      return self.spill.asSlice()
    }
    return Slice.view<i32>(&self.inline, 0, self.count)
  }
}

// From SilkJS src/regexp_opcodes.silk.
const REOP_invalid: u8 = 0

const REOP_char: u8 = 1

const REOP_char_i: u8 = 2

const REOP_char32: u8 = 3

const REOP_char32_i: u8 = 4

const REOP_dot: u8 = 5

const REOP_any: u8 = 6

const REOP_space: u8 = 7

const REOP_not_space: u8 = 8

const REOP_line_start: u8 = 9

const REOP_line_start_m: u8 = 10

const REOP_line_end: u8 = 11

const REOP_line_end_m: u8 = 12

const REOP_goto: u8 = 13

const REOP_split_goto_first: u8 = 14

const REOP_split_next_first: u8 = 15

const REOP_match: u8 = 16

const REOP_lookahead_match: u8 = 17

const REOP_negative_lookahead_match: u8 = 18

const REOP_save_start: u8 = 19

const REOP_save_end: u8 = 20

const REOP_save_reset: u8 = 21

const REOP_loop: u8 = 22

const REOP_loop_split_goto_first: u8 = 23

const REOP_loop_split_next_first: u8 = 24

const REOP_loop_check_adv_split_goto_first: u8 = 25

const REOP_loop_check_adv_split_next_first: u8 = 26

const REOP_set_i32: u8 = 27

const REOP_word_boundary: u8 = 28

const REOP_word_boundary_i: u8 = 29

const REOP_not_word_boundary: u8 = 30

const REOP_not_word_boundary_i: u8 = 31

const REOP_back_reference: u8 = 32

const REOP_back_reference_i: u8 = 33

const REOP_backward_back_reference: u8 = 34

const REOP_backward_back_reference_i: u8 = 35

const REOP_range: u8 = 36

const REOP_range_i: u8 = 37

const REOP_range32: u8 = 38

const REOP_range32_i: u8 = 39

const REOP_lookahead: u8 = 40

const REOP_negative_lookahead: u8 = 41

const REOP_set_char_pos: u8 = 42

const REOP_check_advance: u8 = 43

const REOP_prev: u8 = 44

const RE_HEADER_FLAGS: usize = 0

const RE_HEADER_CAPTURE_COUNT: usize = 2

const RE_HEADER_REGISTER_COUNT: usize = 3

const RE_HEADER_BYTECODE_LEN: usize = 4

const RE_HEADER_LEN: usize = 8

const CAPTURE_COUNT_MAX: usize = 255

const REGISTER_COUNT_MAX: usize = 255

fn opcodeSize(opcode: u8) -> usize {
  let sizes = b"\x01\x03\x03\x05\x05\x01\x01\x01\x01\x01\x01\x01\x01\x05\x05\x05\x01\x01\x01\x02\x02\x03\x06\x0a\x0a\x0a\x0a\x06\x01\x01\x01\x01\x02\x02\x02\x02\x03\x03\x03\x03\x05\x05\x02\x02\x01"
  return u8.toUsize(sizes[u8.toUsize(opcode)])
}

// From SilkJS src/regexp_compile.silk.
struct RegExpCompiler {}

struct CompilerState {
  code: ByteBuffer,
  names: ByteBuffer,
  cursor: usize,
  flags: u32,
  captures: usize,
  totalCaptures: usize,
  hasNamed: bool,
  scope: u8,
  depth: usize,
  maxDepth: usize,
  stackLimit: usize
}

fn byte(input: &[u8], at: usize) -> u8 {
  if at >= input.length {
    return 0
  }
  return input[at]
}

fn unicode(flags: u32) -> bool {
  return (flags & (FLAG_UNICODE | FLAG_UNICODE_SETS)) != 0
}

fn relative(target: usize, after: usize) -> u32 {
  return u32.wrappingSubtract(usize.toU32(target), usize.toU32(after))
}

impl RegExpCompiler {
  // maxDepth bounds logical nesting. stackLimit is the downward native-frame
  // bound; zero disables the physical check without changing the depth policy.
  effect fn compile(pattern: &[u8], flags: u32, maxDepth: usize, stackLimit: usize) -> RegExpProgram
    ! OutOfMemoryError | RegExpSyntaxError | RegExpStackOverflow
    ? &mut Allocator {
    let mut state = CompilerState {
      code: ByteBuffer.make(),
      names: ByteBuffer.make(),
      cursor: 0,
      flags: flags,
      captures: 1,
      totalCaptures: 0,
      hasNamed: false,
      scope: 0,
      depth: 0,
      maxDepth: maxDepth,
      stackLimit: stackLimit,
    }
    run state.code.writeU16(u32.toU16(flags))
    run state.code.append(0)
    run state.code.append(0)
    run state.code.writeU32(0)
    if (flags & FLAG_STICKY) == 0 {
      let _unused = run state.emit32(REOP_split_goto_first, 6)
      run state.code.append(REOP_any)
      let _jump = run state.emit32(REOP_goto, u32.wrappingSubtract(0, 11))
    }
    run state.emit8(REOP_save_start, 0)
    run state.disjunction(pattern, false)
    run state.emit8(REOP_save_end, 0)
    run state.code.append(REOP_match)
    if state.cursor != pattern.length {
      fail RegExpSyntaxError { message: "extraneous characters at the end", offset: state.cursor }
    }
    let registers = run allocateRegisters(&mut state.code)
    let programEnd = state.code.length()
    state.code.set(RE_HEADER_CAPTURE_COUNT, usize.toU8(state.captures))
    state.code.set(RE_HEADER_REGISTER_COUNT, usize.toU8(registers))
    if (flags & FLAG_STICKY) == 0 {
      let mut hint = searchHint(state.code.asSlice())

      // The count shares its u16 with the pivot, so runs are capped at 255
      // units; a capped whole-pattern literal is only required.
      if hint.count > 255 {
        hint.count = 255
        if hint.kind == HINT_LITERAL {
          hint.kind = HINT_REQUIRED
        }
      }
      let mut kind = hint.kind
      let mut set = FirstSet { bits: [0; 4], visits: 0 }
      let withSet = kind != HINT_ANCHORED && kind != HINT_LITERAL
        && firstSet(state.code.asSlice(), RE_HEADER_LEN + 11, &mut set)
        && set.useful()
      if kind == HINT_LITERAL || kind == HINT_REQUIRED {
        let mut latin = true
        let mut k: usize = 0
        while k < hint.count {
          if readU16(state.code.asSlice(), hint.at + k * 3 + 1) > 255 {
            latin = false
          }
          k = k + 1
        }
        if latin {
          k = 0
          while k < hint.count {
            let unit = u16.toU8(readU16(state.code.asSlice(), hint.at + k * 3 + 1))
            run state.code.append(unit)
            k = k + 1
          }
          kind = u8.bitOr(kind, HINT_RUN_BYTES)
        } else {
          k = 0
          while k < hint.count {
            let unit = readU16(state.code.asSlice(), hint.at + k * 3 + 1)
            run state.code.writeU16(unit)
            k = k + 1
          }
          kind = u8.bitOr(kind, HINT_RUN_UNITS)
        }
      }
      if withSet {
        let mut word: usize = 0
        while word < 4 {
          let mut b: usize = 0
          while b < 8 {
            run state.code.append(
              u64.toU8(u64.bitAnd(u64.shiftRight(set.bits[word], usize.toU64(b * 8)), 255)),
            )
            b = b + 1
          }
          word = word + 1
        }
        kind = u8.bitOr(kind, HINT_FIRST_SET)
      }
      let plan = skipPlan(state.code.asSlice())

      // The trailer stores offsets as u16; a longer program searches without a hint, and the
      // run bytes and bitmap above stay unread after its unreachable final REOP_match.
      if (kind != 0 || plan.first != 0) && hint.at <= 65535 && plan.first <= 65535 {
        let pivot = literalPivot(state.code.asSlice(), hint.at, hint.count)
        run state.code.append(HINT_OPCODE)
        run state.code.append(kind)
        run state.code.writeU16(usize.toU16(hint.at))
        run state.code.writeU16(usize.toU16(hint.count + pivot * 256))
        run state.code.writeU16(usize.toU16(plan.first))
        run state.code.append(plan.opcode)
        state.code.patchU16(RE_HEADER_FLAGS, u32.toU16(flags | FLAG_HINT))
      }
    }

    // Last, since the walks above read the plain splits.
    markStars(&mut state.code, programEnd)
    let bytecodeLength = usize.toU32(state.code.length() - RE_HEADER_LEN)
    state.code.patchU32(RE_HEADER_BYTECODE_LEN, bytecodeLength)
    if state.names.length() > (state.captures - 1) * 2 {
      run state.code.appendSlice(state.names.asSlice())
      let current = u16.toU32(readU16(state.code.asSlice(), RE_HEADER_FLAGS))
      state.code.patchU16(RE_HEADER_FLAGS, u32.toU16(current | FLAG_NAMED_GROUPS))
    }
    let CompilerState {
      code,
      names: _names,
      cursor: _cursor,
      flags: _savedFlags,
      captures: _captures,
      totalCaptures: _totalCaptures,
      hasNamed: _hasNamed,
      scope: _scope,
      depth: _depth,
      maxDepth: _savedMaxDepth,
      stackLimit: _savedStackLimit
    } = move state
    return RegExpProgram { bytecode: code.intoList() }
  }
}

impl CompilerState {
  effect fn emit8(self: &mut Self, opcode: u8, value: u8) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.code.append(opcode)
    run self.code.append(value)
  }

  effect fn emit32(self: &mut Self, opcode: u8, value: u32) -> usize
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.code.append(opcode)
    let at = self.code.length()
    run self.code.writeU32(value)
    return at
  }

  effect fn jump(self: &mut Self, opcode: u8, target: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let offset = relative(target, self.code.length() + 5)
    let _unused = run self.emit32(opcode, offset)
  }

  fn patchEnd(self: &mut Self, at: usize) -> () {
    let offset = relative(self.code.length(), at + 4)
    self.code.patchU32(at, offset)
  }

  effect fn emitChar(self: &mut Self, value: u32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut opcode = REOP_char
    if value > 65535 {
      opcode = REOP_char32
    }

    // No other character folds to an ASCII non-letter, so ignoring case
    // changes nothing for one: the plain step joins literal runs and searches.
    let caseless = value < 128
      && !((value >= 0x41 && value <= 0x5a) || (value >= 0x61 && value <= 0x7a))
    if (self.flags & FLAG_IGNORECASE) != 0 && !caseless {
      opcode = opcode + 1
    }
    run self.code.append(opcode)
    if value <= 65535 {
      run self.code.writeU16(u32.toU16(value))
    } else {
      run self.code.writeU32(value)
    }
  }

  effect fn emitRange(self: &mut Self, range: &CharRange) -> ()
    ! OutOfMemoryError | RegExpSyntaxError
    ? &mut Allocator {
    let points = range.points()
    let count = points.length / 2
    if count >= 65535 {
      fail RegExpSyntaxError { message: "too many ranges", offset: self.cursor }
    }
    if count == 0 {
      let _unused = run self.emit32(REOP_char32, u32.MAX)
      return
    }
    let mut high = points[points.length - 1]
    if high == u32.MAX {
      high = points[points.length - 2]
    }
    let narrow = high <= 65535
    let mut opcode = REOP_range32
    if narrow {
      opcode = REOP_range
    }
    if (self.flags & FLAG_IGNORECASE) != 0 {
      opcode = opcode + 1
    }
    if narrow {
      opcode = REOP_CLASS
      if (self.flags & FLAG_IGNORECASE) != 0 {
        opcode = REOP_CLASS_I
      }
    }
    run self.code.append(opcode)
    run self.code.writeU16(usize.toU16(count))
    let mut i: usize = 0
    while i < points.length {
      high = points[i + 1] - 1
      if narrow {
        if high == u32.MAX - 1 {
          high = 65535
        }
        run self.code.writeU16(u32.toU16(points[i]))
        run self.code.writeU16(u32.toU16(high))
      } else {
        run self.code.writeU32(points[i])
        run self.code.writeU32(high)
      }
      i = i + 2
    }
    if narrow {
      // The Latin-1 bitmap: unit c matches when its folded form (what the
      // executor's classRange tests) is in the table.
      let unicode = (self.flags & (FLAG_UNICODE | FLAG_UNICODE_SETS)) != 0
      let fold = (self.flags & FLAG_IGNORECASE) != 0
      let mut map: [u8; 32] = [0; 32]
      if !fold {
        // Unfolded units match their own ranges: fill each range's Latin-1 part.
        let mut k: usize = 0
        while k + 1 < points.length && points[k] < 256 {
          let mut end = points[k + 1]
          if end > 256 {
            end = 256
          }
          let mut c = points[k]
          while c < end {
            let at = u32.toUsize(u32.shiftRight(c, 3))
            map[at] = map[at] | u32.toU8(u32.shiftLeft(1, c & 7))
            c = c + 1
          }
          k = k + 2
        }
      } else {
        let mut c: u32 = 0
        while c < 256 {
          if pointsContain(points, UnicodeCase.canonicalize(c, unicode)) {
            let at = u32.toUsize(u32.shiftRight(c, 3))
            map[at] = map[at] | u32.toU8(u32.shiftLeft(1, c & 7))
          }
          c = c + 1
        }
      }
      let mut byte: usize = 0
      while byte < 32 {
        run self.code.append(map[byte])
        byte = byte + 1
      }
    }
  }

  effect fn emitStrings(self: &mut Self, set: &RegExpStrings) -> ()
    ! OutOfMemoryError | RegExpSyntaxError
    ? &mut Allocator {
    if set.strings.length() == 0 {
      return run self.emitRange(&set.ranges)
    }

    // Sort indices, not owned strings. Longest alternatives precede shorter ones.
    let strings = set.strings.asSlice()
    let mut order = List<usize>.make()
    let mut empty = false
    let mut i: usize = 0
    while i < strings.length {
      if strings[i].length() == 0 {
        empty = true
      } else {
        run order.append(i)
      }
      i = i + 1
    }
    sortStringIndices(&mut order, strings)
    let hasRange = set.ranges.points().length != 0
    let mut chain: u32 = u32.MAX
    i = 0
    while i < order.length() {
      let last = !empty && !hasRange && i + 1 == order.length()
      let mut split: usize = 0
      if !last {
        split = run self.emit32(REOP_split_next_first, 0)
      }
      let text = strings[order.get(i)].asSlice()
      let mut j: usize = 0
      while j < text.length {
        run self.emitChar(text[j])
        j = j + 1
      }
      if !last {
        let at = run self.emit32(REOP_goto, chain)
        chain = usize.toU32(at)
        self.patchEnd(split)
      }
      i = i + 1
    }
    if hasRange {
      let mut split: usize = 0
      if empty {
        split = run self.emit32(REOP_split_next_first, 0)
      }
      run self.emitRange(&set.ranges)
      if empty {
        self.patchEnd(split)
      }
    }
    while chain != u32.MAX {
      let at = u32.toUsize(chain)
      chain = readU32(self.code.asSlice(), at)
      self.patchEnd(at)
    }
  }

  effect fn expect(self: &mut Self, input: &[u8], value: u8) -> ()
    ! RegExpSyntaxError {
    if byte(input, self.cursor) != value {
      let message = match value {
        41 => "expecting ')'"
        58 => "expecting ':'"
        125 => "expecting '}'"
        _ => "syntax error"
      }
      fail RegExpSyntaxError { message: message, offset: self.cursor }
    }
    self.cursor = self.cursor + 1
  }

  effect fn modifiers(self: &mut Self, input: &[u8]) -> u32
    ! RegExpSyntaxError {
    let mut mask: u32 = 0
    while true {
      let c = byte(input, self.cursor)
      let value = match c {
        105 => FLAG_IGNORECASE
        109 => FLAG_MULTILINE
        115 => FLAG_DOTALL
        _ => 0
      }
      if value == 0 {
        return mask
      }
      if (mask & value) != 0 {
        let message = match c {
          105 => "duplicate modifier: 'i'"
          109 => "duplicate modifier: 'm'"
          _ => "duplicate modifier: 's'"
        }
        fail RegExpSyntaxError { message: message, offset: self.cursor }
      }
      mask = mask | value
      self.cursor = self.cursor + 1
    }
  }

  effect fn countCaptures(self: &mut Self, input: &[u8]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.totalCaptures != 0 {
      return ()
    }
    let mut count: usize = 1
    let mut p: usize = 0
    while p < input.length {
      let c = input[p]
      if c == 40 {
        if byte(input, p + 1) != 63 {
          count = count + 1
        } else if byte(input, p + 2) == 60 && byte(input, p + 3) != 61 && byte(input, p + 3) != 33 {
          self.hasNamed = true
          count = count + 1
        }
        if count >= CAPTURE_COUNT_MAX {
          break
        }
      } else if c == 92 {
        p = p + 1
      } else if c == 91 {
        p = p + 1
        while p < input.length && input[p] != 93 {
          if input[p] == 92 {
            p = p + 1
          }
          p = p + 1
        }
      }
      p = p + 1
    }
    self.totalCaptures = count
  }

  fn duplicateName(self: &Self, name: &[u8]) -> bool {
    let data = self.names.asSlice()
    let mut p: usize = 0
    while p < data.length {
      let start = p
      while data[p] != 0 {
        p = p + 1
      }
      let mut equal = p - start == name.length
      let mut i: usize = 0
      while equal && i < name.length {
        equal = data[start + i] == name[i]
        i = i + 1
      }
      if equal && data[p + 1] == self.scope {
        return true
      }
      p = p + 2
    }
    return false
  }

  effect fn namedIndices(self: &mut Self, input: &[u8], name: &[u8]) -> List<u8>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut result = List<u8>.make()
    let data = self.names.asSlice()
    let mut index: usize = 1
    let mut p: usize = 0
    while p < data.length {
      let start = p
      while data[p] != 0 {
        p = p + 1
      }
      let mut equal = p - start == name.length
      let mut i: usize = 0
      while equal && i < name.length {
        equal = data[start + i] == name[i]
        i = i + 1
      }
      if equal {
        run result.append(usize.toU8(index))
      }
      p = p + 2
      index = index + 1
    }
    if result.length() != 0 {
      return move result
    }
    index = 1
    p = 0
    while p < input.length {
      let c = input[p]
      if c == 40 {
        if byte(input, p + 1) != 63 {
          index = index + 1
        } else if byte(input, p + 2) == 60 && byte(input, p + 3) != 61 && byte(input, p + 3) != 33 {
          let parsed = run tryGroupName(input, p + 3)
          match move parsed {
            Option<GroupName>.Some { value } => {
              if (value.bytes.asSlice() == name) {
                run result.append(usize.toU8(index))
              }
              p = value.next
            }
            Option<GroupName>.None => {
              p = p + 3
            }
          }
          index = index + 1
        }
        if index >= CAPTURE_COUNT_MAX {
          break
        }
      } else if c == 92 {
        p = p + 1
      } else if c == 91 {
        p = p + 1
        while p < input.length && input[p] != 93 {
          if input[p] == 92 {
            p = p + 1
          }
          p = p + 1
        }
      }
      p = p + 1
    }
    return move result
  }
}

const GROUP_TOP: u8 = 0

const GROUP_PLAIN: u8 = 1

const GROUP_LOOKAROUND: u8 = 2

// A disjunction the parser has open: the pattern itself or a group, the alternative it is in, and
// what ends it.
struct OpenGroup {
  kind: u8,
  // The direction of the disjunction: backward inside a lookbehind.
  backward: bool,
  // Where the current alternative's code starts, and the gotos waiting for the end.
  altStart: usize,
  lastJump: usize,
  // Where the group's term starts in the enclosing alternative, and the captures before it.
  termStart: usize,
  termCaptures: usize,
  // A plain group: whether it captures, as which index, and the flags to restore.
  capture: bool,
  index: usize,
  savedFlags: u32,
  // A lookaround: the opening instruction to patch and the closing opcode.
  jump: usize,
  endOpcode: u8
}

impl Copy for OpenGroup {}

impl OpenGroup {
  fn top(altStart: usize, backward: bool) -> OpenGroup {
    return OpenGroup {
      kind: GROUP_TOP,
      backward: backward,
      altStart: altStart,
      lastJump: 0,
      termStart: 0,
      termCaptures: 0,
      capture: false,
      index: 0,
      savedFlags: 0,
      jump: 0,
      endOpcode: 0,
    }
  }

  fn group(backward: bool, capture: bool, index: usize, savedFlags: u32) -> OpenGroup {
    return OpenGroup {
      kind: GROUP_PLAIN,
      backward: backward,
      altStart: 0,
      lastJump: 0,
      termStart: 0,
      termCaptures: 0,
      capture: capture,
      index: index,
      savedFlags: savedFlags,
      jump: 0,
      endOpcode: 0,
    }
  }

  fn lookaround(behind: bool, jump: usize, endOpcode: u8) -> OpenGroup {
    return OpenGroup {
      kind: GROUP_LOOKAROUND,
      backward: behind,
      altStart: 0,
      lastJump: 0,
      termStart: 0,
      termCaptures: 0,
      capture: false,
      index: 0,
      savedFlags: 0,
      jump: jump,
      endOpcode: endOpcode,
    }
  }
}

impl CompilerState {
  // Counts one more open disjunction, failing past maxDepth (or below stackLimit).
  effect fn enter(self: &mut Self) -> ()
    ! RegExpStackOverflow {
    if self.depth >= self.maxDepth
      || (self.stackLimit != 0 && currentFrameAddress() < self.stackLimit) {
      fail RegExpStackOverflow {}
    }
    self.depth = self.depth + 1
  }

  // QuickJS parses a group's disjunction by recursion, a few native frames per level, which a
  // wasm engine's call stack holds only so many of. This parser keeps the open groups in a list
  // instead, so nesting costs heap rather than stack and maxDepth is the only nesting bound.
  effect fn disjunction(self: &mut Self, input: &[u8], backward: bool) -> ()
    ! OutOfMemoryError | RegExpSyntaxError | RegExpStackOverflow
    ? &mut Allocator {
    run self.enter()
    let mut current = OpenGroup.top(self.code.length(), backward)
    let mut parents = List<OpenGroup>.make()
    while true {
      let c = byte(input, self.cursor)
      if self.cursor < input.length && c != 124 && c != 41 {
        // One more term of the current alternative.
        let termStart = self.code.length()
        if c == 40 {
          let captures = self.captures
          let mut inner = run self.openGroup(input, current.backward)
          run self.enter()
          inner.altStart = self.code.length()
          inner.termStart = termStart
          inner.termCaptures = captures
          run parents.append(current)
          current = inner
        } else {
          run self.term(input, current.backward)
          self.placeTerm(&current, termStart)
        }
      } else if c == 124 {
        // a|b|c becomes split(b) a goto(end) split(c) b goto(end) c: each choice
        // pushes one frame, and the first alternative runs after one split, not
        // one per alternative. Until the end is known, each goto's operand holds
        // the previous goto's operand offset plus one (0 for none).
        self.cursor = self.cursor + 1
        let length = self.code.length() - current.altStart
        run self.code.insertZeroes(current.altStart, 5)
        self.code.set(current.altStart, REOP_split_next_first)
        self.code.patchU32(current.altStart + 1, usize.toU32(length + 5))
        let jump = run self.emit32(REOP_goto, usize.toU32(current.lastJump))
        current.lastJump = jump + 1
        current.altStart = self.code.length()
        self.scope = u8.wrappingAdd(self.scope, 1)
      } else {
        while current.lastJump != 0 {
          let jump = current.lastJump - 1
          current.lastJump = u32.toUsize(readU32(self.code.asSlice(), jump))
          self.patchEnd(jump)
        }
        self.depth = self.depth - 1
        match move parents.pop() {
          Option<OpenGroup>.None => {
            return ()
          }
          Option<OpenGroup>.Some { value: parent } => {
            let closed = current
            let quantifiable = run self.closeGroup(input, &closed)
            run self.finishTerm(input, closed.termStart, closed.termCaptures, quantifiable)
            current = parent
            self.placeTerm(&current, closed.termStart)
          }
        }
      }
    }
  }

  // In a backward alternative, rotates the term just compiled at termStart to the front.
  fn placeTerm(self: &mut Self, alternative: &OpenGroup, termStart: usize) -> () {
    if alternative.backward {
      // Rotate the newly compiled term to the front without a temporary allocation.
      let end = self.code.length()
      reverseBytes(&mut self.code, alternative.altStart, termStart)
      reverseBytes(&mut self.code, termStart, end)
      reverseBytes(&mut self.code, alternative.altStart, end)
    }
  }

  effect fn normalAtom(self: &mut Self, input: &[u8], backward: bool) -> ()
    ! OutOfMemoryError | RegExpSyntaxError
    ? &mut Allocator {
    let at = self.cursor
    let atom = run parseClassAtom(input, at, self.flags, false, true)
    self.cursor = atom.next
    if backward {
      run self.code.append(REOP_prev)
    }
    if atom.isSet {
      if byte(input, at) == 92 && byte(input, at + 1) == 115 {
        run self.code.append(REOP_space)
      } else if byte(input, at) == 92 && byte(input, at + 1) == 83 {
        run self.code.append(REOP_not_space)
      } else {
        run self.emitStrings(&atom.set)
      }
    } else {
      let mut value = atom.codePoint
      if (self.flags & FLAG_IGNORECASE) != 0 {
        value = UnicodeCase.canonicalize(value, unicode(self.flags))
      }
      run self.emitChar(value)
    }
    if backward {
      run self.code.append(REOP_prev)
    }
  }

  effect fn reference(self: &mut Self, indices: &[u8], backward: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut opcode = REOP_back_reference
    if backward {
      opcode = REOP_backward_back_reference
    }
    if (self.flags & FLAG_IGNORECASE) != 0 {
      opcode = opcode + 1
    }
    run self.emit8(opcode, usize.toU8(indices.length))
    run self.code.appendSlice(indices)
  }

  effect fn namedReference(self: &mut Self, input: &[u8], backward: bool) -> ()
    ! OutOfMemoryError | RegExpSyntaxError
    ? &mut Allocator {
    run self.countCaptures(input)
    let strict = unicode(self.flags) || self.hasNamed
    if byte(input, self.cursor + 2) != 60 {
      if strict {
        fail RegExpSyntaxError { message: "expecting group name", offset: self.cursor }
      }
      return run self.normalAtom(input, backward)
    }
    let parsed = run tryGroupName(input, self.cursor + 3)
    match move parsed {
      Option<GroupName>.None => {
        if strict {
          fail RegExpSyntaxError { message: "invalid group name", offset: self.cursor }
        }
        return run self.normalAtom(input, backward)
      }
      Option<GroupName>.Some { value } => {
        let indices = run self.namedIndices(input, value.bytes.asSlice())
        if indices.length() == 0 {
          if strict {
            fail RegExpSyntaxError { message: "group name not defined", offset: self.cursor }
          }
          return run self.normalAtom(input, backward)
        }
        run self.reference(indices.asSlice(), backward)
        self.cursor = value.next
      }
    }
  }

  // Opens the group at the cursor, emitting what precedes its disjunction.
  effect fn openGroup(self: &mut Self, input: &[u8], backward: bool) -> OpenGroup
    ! OutOfMemoryError | RegExpSyntaxError
    ? &mut Allocator {
    let p = self.cursor
    let mut capture = true
    let mut named = false
    let savedFlags = self.flags
    if byte(input, p + 1) == 63 {
      let c = byte(input, p + 2)
      if c == 58 {
        self.cursor = p + 3
        capture = false
      } else if c == 105 || c == 109 || c == 115 || c == 45 {
        self.cursor = p + 2
        let add = run self.modifiers(input)
        let mut remove: u32 = 0
        if byte(input, self.cursor) == 45 {
          self.cursor = self.cursor + 1
          remove = run self.modifiers(input)
        }
        if (add == 0 && remove == 0) || (add & remove) != 0 {
          fail RegExpSyntaxError { message: "invalid modifiers", offset: self.cursor }
        }
        run self.expect(input, 58)
        self.flags = (self.flags | add) & (u32.MAX ^ remove)
        capture = false
      } else if c == 61 || c == 33
        || (c == 60 && (byte(input, p + 3) == 61 || byte(input, p + 3) == 33)) {
        let behind = c == 60
        let mut negative = c == 33
        self.cursor = p + 3
        if behind {
          negative = byte(input, p + 3) == 33
          self.cursor = p + 4
        }
        let mut opcode = REOP_lookahead
        let mut endOpcode = REOP_lookahead_match
        if negative {
          opcode = REOP_negative_lookahead
          endOpcode = REOP_negative_lookahead_match
        }
        let jump = run self.emit32(opcode, 0)
        return OpenGroup.lookaround(behind, jump, endOpcode)
      } else if c == 60 {
        let name = run parseGroupName(input, p + 3)
        if self.duplicateName(name.bytes.asSlice()) {
          fail RegExpSyntaxError { message: "duplicate group name", offset: p }
        }
        run self.names.appendSlice(name.bytes.asSlice())
        run self.names.append(0)
        run self.names.append(self.scope)
        self.hasNamed = true
        self.cursor = name.next
        named = true
      } else {
        fail RegExpSyntaxError { message: "invalid group", offset: p }
      }
    } else {
      self.cursor = p + 1
    }
    let index = self.captures
    if capture {
      if !named {
        run self.names.append(0)
        run self.names.append(0)
      }
      if index >= CAPTURE_COUNT_MAX {
        fail RegExpSyntaxError { message: "too many captures", offset: p }
      }
      self.captures = self.captures + 1
      let mut opcode = REOP_save_start
      if backward {
        opcode = REOP_save_end
      }
      run self.emit8(opcode, usize.toU8(index))
    }
    return OpenGroup.group(backward, capture, index, savedFlags)
  }

  // Ends the group `open` after its disjunction; whether a quantifier may follow it.
  effect fn closeGroup(self: &mut Self, input: &[u8], open: &OpenGroup) -> bool
    ! OutOfMemoryError | RegExpSyntaxError
    ? &mut Allocator {
    if open.kind == GROUP_LOOKAROUND {
      run self.expect(input, 41)
      run self.code.append(open.endOpcode)
      self.patchEnd(open.jump)
      return !unicode(self.flags) && !open.backward
    }
    if open.capture {
      let mut opcode = REOP_save_end
      if open.backward {
        opcode = REOP_save_start
      }
      run self.emit8(opcode, usize.toU8(open.index))
    }
    run self.expect(input, 41)
    self.flags = open.savedFlags
    return true
  }

  // A term other than a group, which the disjunction opens itself.
  effect fn term(self: &mut Self, input: &[u8], backward: bool) -> ()
    ! OutOfMemoryError | RegExpSyntaxError | RegExpStackOverflow
    ? &mut Allocator {
    let start = self.code.length()
    let captures = self.captures
    let p = self.cursor
    let c = byte(input, p)
    let mut quantifiable = true
    if c == 94 || c == 36 {
      let mut opcode = REOP_line_start
      if c == 36 {
        opcode = REOP_line_end
      }
      if (self.flags & FLAG_MULTILINE) != 0 {
        opcode = opcode + 1
      }
      run self.code.append(opcode)
      self.cursor = p + 1
      quantifiable = false
    } else if c == 46 {
      if backward {
        run self.code.append(REOP_prev)
      }
      let mut opcode = REOP_dot
      if (self.flags & FLAG_DOTALL) != 0 {
        opcode = REOP_any
      }
      run self.code.append(opcode)
      if backward {
        run self.code.append(REOP_prev)
      }
      self.cursor = p + 1
    } else if c == 42 || c == 43 || c == 63 {
      fail RegExpSyntaxError { message: "nothing to repeat", offset: p }
    } else if c == 123 {
      if unicode(self.flags) {
        fail RegExpSyntaxError { message: "syntax error", offset: p }
      }
      if digit(byte(input, p + 1)) {
        let number = parseDigits(input, p + 1, true)
        let mut end = number.next
        if byte(input, end) == 44 {
          end = end + 1
          if digit(byte(input, end)) {
            let maximum = parseDigits(input, end, true)
            end = maximum.next
          }
        }
        if byte(input, end) == 125 {
          fail RegExpSyntaxError { message: "nothing to repeat", offset: p }
        }
      }
      run self.normalAtom(input, backward)
    } else if c == 91 {
      let parsed = run parseClass(input, p, self.flags, self.maxDepth - self.depth, self.stackLimit)
      self.cursor = parsed.next
      if backward {
        run self.code.append(REOP_prev)
      }
      run self.emitStrings(&parsed.set)
      if backward {
        run self.code.append(REOP_prev)
      }
    } else if c == 92 && (byte(input, p + 1) == 98 || byte(input, p + 1) == 66) {
      let mut opcode = REOP_word_boundary
      if byte(input, p + 1) == 66 {
        opcode = REOP_not_word_boundary
      }
      if unicode(self.flags) && (self.flags & FLAG_IGNORECASE) != 0 {
        opcode = opcode + 1
      }
      run self.code.append(opcode)
      self.cursor = p + 2
      quantifiable = false
    } else if c == 92 && byte(input, p + 1) == 107 {
      run self.namedReference(input, backward)
    } else if c == 92 && byte(input, p + 1) >= 49 && byte(input, p + 1) <= 57 {
      let number = parseDigits(input, p + 1, false)
      if number.value < 0 || i32.toUsize(number.value) >= self.captures {
        run self.countCaptures(input)
      }
      if number.value < 0
        || (i32.toUsize(number.value) >= self.captures
          && i32.toUsize(number.value) >= self.totalCaptures) {
        if unicode(self.flags) {
          fail RegExpSyntaxError {
            message: "back reference out of range in regular expression",
            offset: p,
          }
        }
        run self.normalAtom(input, backward)
      } else {
        let index = i32.toU8(number.value)
        run self.reference(&[index], backward)
        self.cursor = number.next
      }
    } else {
      if (c == 93 || c == 125) && unicode(self.flags) {
        fail RegExpSyntaxError { message: "syntax error", offset: p }
      }
      if c == 92 && byte(input, p + 1) == 48 && unicode(self.flags) && digit(byte(input, p + 2)) {
        fail RegExpSyntaxError {
          message: "invalid decimal escape in regular expression",
          offset: p,
        }
      }
      run self.normalAtom(input, backward)
    }
    run self.finishTerm(input, start, captures, quantifiable)
  }

  // Applies a quantifier after the term at start, which began with captures groups seen.
  effect fn finishTerm(
    self: &mut Self,
    input: &[u8],
    start: usize,
    captures: usize,
    quantifiable: bool,
  ) -> ()
    ! OutOfMemoryError | RegExpSyntaxError
    ? &mut Allocator {
    if quantifiable {
      run self.quantifier(input, start, captures)
    }
    if self.code.length() > 1073741823 {
      fail OutOfMemoryError {}
    }
  }
}

fn reverseBytes(code: &mut ByteBuffer, start: usize, end: usize) -> () {
  let mut left = start
  let mut right = end
  while left < right {
    right = right - 1
    if left >= right {
      break
    }
    let value = code.get(left)
    let opposite = code.get(right)
    code.set(left, opposite)
    code.set(right, value)
    left = left + 1
  }
}

struct AtomAnalysis {
  advanceCheck: bool,
  captureReset: bool
}

/// Whether c is in the [start, end) pairs of a CharRange's points.
fn pointsContain(points: &[u32], c: u32) -> bool {
  let mut i: usize = 0
  while i + 1 < points.length {
    if c < points[i] {
      return false
    }
    if c < points[i + 1] {
      return true
    }
    i = i + 2
  }
  return false
}

fn instructionLength(bytes: &[u8], at: usize) -> usize {
  let opcode = bytes[at]
  if opcode == REOP_CLASS || opcode == REOP_CLASS_I {
    return 3 + u16.toUsize(readU16(bytes, at + 1)) * 4 + CLASS_BITS_LENGTH
  }
  let mut length = opcodeSize(opcode)
  if opcode == REOP_range || opcode == REOP_range_i {
    length = length + u16.toUsize(readU16(bytes, at + 1)) * 4
  } else if opcode == REOP_range32 || opcode == REOP_range32_i {
    length = length + u16.toUsize(readU16(bytes, at + 1)) * 8
  } else if opcode >= REOP_back_reference && opcode <= REOP_backward_back_reference_i {
    length = length + u8.toUsize(bytes[at + 1])
  }
  return length
}

fn analyzeAtom(bytes: &[u8], start: usize) -> AtomAnalysis {
  let mut at = start
  let mut advance = true
  let mut capture = false
  while at < bytes.length {
    let opcode = bytes[at]
    if (opcode >= REOP_char && opcode <= REOP_not_space)
      || (opcode >= REOP_range && opcode <= REOP_range32_i)
      || opcode == REOP_CLASS
      || opcode == REOP_CLASS_I {
      advance = false
    } else if opcode >= REOP_back_reference && opcode <= REOP_backward_back_reference_i {
      capture = true
    } else if !((opcode >= REOP_line_start && opcode <= REOP_line_end_m)
      || (opcode >= REOP_save_start && opcode <= REOP_save_reset)
      || (opcode >= REOP_word_boundary && opcode <= REOP_not_word_boundary_i)
      || opcode == REOP_set_i32
      || opcode == REOP_set_char_pos
      || opcode == REOP_prev) {
      capture = true
      break
    }
    at = at + instructionLength(bytes, at)
  }
  return AtomAnalysis { advanceCheck: advance, captureReset: capture }
}

/// The Latin-1 units a search program's match can start with, gathered by
/// firstSet; units above 255 are never excluded.
struct FirstSet {
  bits: [u64; 4],
  visits: usize
}

impl FirstSet {
  fn add(self: &mut Self, unit: usize) -> () {
    if unit > 255 {
      return ()
    }
    self.bits[unit / 64] = u64.bitOr(self.bits[unit / 64], u64.shiftLeft(1, usize.toU64(unit & 63)))
  }

  fn addRange(self: &mut Self, low: usize, high: usize) -> () {
    let mut unit = low
    while unit <= high && unit <= 255 {
      self.add(unit)
      unit = unit + 1
    }
  }

  /// Whether skipping by the set can pay: it leaves out enough units.
  fn useful(self: &Self) -> bool {
    let mut count: usize = 0
    let mut unit: usize = 0
    while unit < 256 {
      if u64.bitAnd(u64.shiftRight(self.bits[unit / 64], usize.toU64(unit & 63)), 1) != 0 {
        count = count + 1
      }
      unit = unit + 1
    }
    return count <= 160
  }
}

/// The target of the jump at at (goto or a split).
/// The size of the step at at when it matches exactly one character (one unit
/// when the input's characters are), so a greedy loop over it can run in
/// place, else 0.
fn starStep(code: &[u8], at: usize) -> usize {
  if at >= code.length {
    return 0
  }
  let opcode = code[at]
  if opcode == REOP_char || opcode == REOP_char_i {
    return 3
  }
  if opcode >= REOP_dot && opcode <= REOP_not_space {
    return 1
  }
  if opcode == REOP_CLASS || opcode == REOP_CLASS_I || opcode == REOP_range
    || opcode == REOP_range_i
    || opcode == REOP_range32
    || opcode == REOP_range32_i {
    return instructionLength(code, at)
  }
  return 0
}

/// Marks the program's greedy loops over one one-character step (REOP_STAR,
/// REOP_PLUS), so the executor need not recognize them on every dispatch.
fn markStars(code: &mut ByteBuffer, end: usize) {
  let mut at = RE_HEADER_LEN
  while at < end {
    let bytes = code.asSlice()
    let opcode = bytes[at]
    let length = instructionLength(bytes, at)
    let mut mark: u8 = 0
    if opcode == REOP_split_next_first {
      let size = starStep(bytes, at + 5)
      let jump = at + 5 + size
      if size != 0 && jumpTarget(bytes, at) == jump + 5 && jump < end && bytes[jump] == REOP_goto
        && jumpTarget(bytes, jump) == at {
        mark = REOP_STAR
      }
    } else if opcode == REOP_split_goto_first {
      let target = jumpTarget(bytes, at)
      if target < at {
        let size = starStep(bytes, target)
        if size != 0 && target + size == at {
          mark = REOP_PLUS
        }
      }
    }
    if mark != 0 {
      code.set(at, mark)
    }
    at = at + length
  }
}

fn jumpTarget(code: &[u8], at: usize) -> usize {
  let displacement = readU32(code, at + 1)
  if displacement < 0x80000000 {
    return usize.wrappingAdd(at + 5, u32.toUsize(displacement))
  }
  return usize.wrappingSubtract(at + 5, u32.toUsize(0xffffffff - displacement) + 1)
}

/// Adds to set every Latin-1 unit a match can consume first from at, the
/// program's save_start 0 or any step after it. False when that is not a
/// bounded set: the path can match empty, or meets a step this walk does not
/// follow (lookaround, loops, back references, folded or 32-bit classes).
fn firstSet(code: &[u8], start: usize, set: &mut FirstSet) -> bool {
  let mut at = start
  while at < code.length {
    set.visits = set.visits + 1
    if set.visits > 64 {
      return false
    }
    let opcode = code[at]
    if opcode == REOP_char {
      set.add(u16.toUsize(readU16(code, at + 1)))
      return true
    }
    if opcode == REOP_char_i {
      let unit = u16.toUsize(readU16(code, at + 1))
      if unit >= 128 {
        return false
      }
      set.add(unit)
      if unit >= 0x41 && unit <= 0x5a {
        set.add(unit + 0x20)
      }
      if unit >= 0x61 && unit <= 0x7a {
        set.add(unit - 0x20)
      }
      return true
    }
    if opcode == REOP_char32 {
      return true
    }
    if opcode == REOP_space || opcode == REOP_not_space {
      let mut unit: usize = 0
      while unit < 256 {
        let space = (unit >= 9 && unit <= 13) || unit == 32 || unit == 0xa0
        if space == (opcode == REOP_space) {
          set.add(unit)
        }
        unit = unit + 1
      }
      return true
    }
    if opcode == REOP_CLASS || opcode == REOP_CLASS_I {
      // The bitmap is exactly the Latin-1 units the class matches.
      let bitsAt = at + 3 + u16.toUsize(readU16(code, at + 1)) * 4
      let mut unit: usize = 0
      while unit < 256 {
        if (u8.toU32(code[bitsAt + unit / 8]) & u32.shiftLeft(1, usize.toU32(unit & 7))) != 0 {
          set.add(unit)
        }
        unit = unit + 1
      }
      return true
    }
    if opcode == REOP_range {
      let count = u16.toUsize(readU16(code, at + 1))
      let mut i: usize = 0
      while i < count {
        set.addRange(
          u16.toUsize(readU16(code, at + 3 + i * 4)),
          u16.toUsize(readU16(code, at + 5 + i * 4)),
        )
        i = i + 1
      }
      return true
    }

    // $ matches only at the end, which a search always tries. ^ matches only at
    // the input's start, which the search tries before it skips at all.
    if opcode == REOP_line_end || opcode == REOP_line_start {
      return true
    }
    if opcode == REOP_line_end_m {
      set.add(10)
      set.add(13)
      return true
    }
    if opcode == REOP_save_start || opcode == REOP_save_end || opcode == REOP_save_reset
      || (opcode >= REOP_word_boundary && opcode <= REOP_not_word_boundary_i) {
      at = at + instructionLength(code, at)
    } else if opcode == REOP_goto {
      at = jumpTarget(code, at)
    } else if opcode == REOP_split_goto_first || opcode == REOP_split_next_first {
      if !firstSet(code, at + 5, &mut set) {
        return false
      }
      at = jumpTarget(code, at)
    } else {
      return false
    }
  }
  return false
}

struct SearchHint {
  kind: u8,
  at: usize,
  count: usize
}

/// The index in the count REOP_char steps at at of the least common unit (the
/// first of the rarest), which a long search scans for.
fn literalPivot(code: &[u8], at: usize, count: usize) -> usize {
  let mut pivot: usize = 0
  if count < 2 {
    return 0
  }
  let mut best = rarity(u16.toU32(readU16(code, at + 1)))
  let mut k: usize = 1
  while k < count {
    let score = rarity(u16.toU32(readU16(code, at + k * 3 + 1)))
    if score < best {
      best = score
      pivot = k
    }
    k = k + 1
  }
  return pivot
}

/// How common unit is in typical text, markup and JSON, from 2 (rare) to 9.
fn rarity(unit: u32) -> u32 {
  if unit == 32 || unit == 0x65 || unit == 0x74 || unit == 0x61 || unit == 0x6f || unit == 0x69
    || unit == 0x6e
    || unit == 0x73
    || unit == 0x72 {
    return 9
  }
  if unit >= 0x61 && unit <= 0x7a {
    return 7
  }
  if unit == 0x22 || unit == 0x2c || unit == 0x2e || unit == 0x3a || unit == 0x2f || unit == 0x2d
    || unit == 0x5f
    || unit == 0x27
    || unit == 0x3d {
    return 7
  }
  if unit >= 0x30 && unit <= 0x39 {
    return 6
  }
  if unit >= 0x41 && unit <= 0x5a {
    return 4
  }
  if unit > 0x20 && unit < 0x7f {
    return 3
  }
  return 2
}

/// The forward target of a jumping instruction at at, or 0 when it does not jump.
fn forwardTarget(code: &[u8], at: usize) -> usize {
  let opcode = code[at]
  let mut after: usize = 0
  if opcode == REOP_goto || opcode == REOP_split_goto_first || opcode == REOP_split_next_first
    || opcode == REOP_lookahead
    || opcode == REOP_negative_lookahead {
    after = at + 5
  } else if opcode >= REOP_loop && opcode <= REOP_loop_check_adv_split_next_first {
    after = at + 6
  } else {
    return 0
  }
  let displacement = readU32(code, after - 4)
  if displacement >= 0x80000000 {
    return 0
  }
  return after + u32.toUsize(displacement)
}

/// A search program's hint (see FLAG_HINT): the longest run of
/// REOP_char steps that every match executes, that is, that no earlier forward
/// jump skips (lookaround bodies sit behind one too). Kind 0 when there is no
/// useful one: none, or a run that is already the first step (the search
/// prefix skips to it). A pattern anchored at ^ gets HINT_ANCHORED instead.
struct SkipPlan {
  first: usize,
  opcode: u8
}

/// The search prefix's plan (FLAG_HINT): after the prefix
/// (split_goto_first, any, goto, save_start 0), zero-width steps (a group's
/// start, \b, \B) leave the position where the first consuming step must
/// match. The program ends in save_end and match, so the walk stays inside it.
fn skipPlan(code: &[u8]) -> SkipPlan {
  let base = RE_HEADER_LEN
  let mut first = base + 13
  if !(code.length > first + 3 && code[base] == REOP_split_goto_first && code[base + 5] == REOP_any
    && code[base + 6] == REOP_goto
    && code[base + 11] == REOP_save_start) {
    return SkipPlan { first: 0, opcode: 0 }
  }
  let mut opcode = code[first]
  while opcode == REOP_save_start
    || (opcode >= REOP_word_boundary && opcode <= REOP_not_word_boundary_i) {
    if opcode == REOP_save_start {
      first = first + 2
    } else {
      first = first + 1
    }
    opcode = code[first]
  }
  if (opcode == REOP_char || opcode == REOP_char_i || opcode == REOP_line_start
    || opcode == REOP_space
    || opcode == REOP_not_space
    || opcode == REOP_CLASS
    || opcode == REOP_CLASS_I
    || (opcode >= REOP_range && opcode <= REOP_range32_i))
    && code.length > first + 3 {
    return SkipPlan { first: first, opcode: opcode }
  }
  return SkipPlan { first: first, opcode: 0 }
}

fn searchHint(code: &[u8]) -> SearchHint {
  let base = RE_HEADER_LEN
  let first = base + 13
  if code.length <= first + 3 || code[base] != REOP_split_goto_first
    || code[base + 11] != REOP_save_start
    || code[base + 12] != 0 {
    return SearchHint { kind: 0, at: 0, count: 0 }
  }
  let mut reach = base
  let mut at = base
  let mut best = SearchHint { kind: 0, at: 0, count: 0 }
  let mut runAt: usize = 0
  let mut runCount: usize = 0
  while at < code.length {
    let opcode = code[at]
    if opcode == REOP_char && at >= reach {
      if runCount == 0 {
        runAt = at
      }
      runCount = runCount + 1
      if runCount > best.count {
        best = SearchHint { kind: HINT_REQUIRED, at: runAt, count: runCount }
      }
    } else {
      runCount = 0
    }
    if opcode == REOP_match {
      break
    }
    let target = forwardTarget(code, at)
    if target > reach {
      reach = target
    }
    at = at + instructionLength(code, at)
  }
  if code[first] == REOP_line_start {
    return SearchHint { kind: HINT_ANCHORED, at: 0, count: 0 }
  }
  if best.count == 0 || best.count > 0xffff {
    return SearchHint { kind: 0, at: 0, count: 0 }
  }
  let end = best.at + best.count * 3
  if best.at == first && end + 3 <= code.length && code[end] == REOP_save_end && code[end + 1] == 0
    && code[end + 2] == REOP_match {
    return SearchHint { kind: HINT_LITERAL, at: best.at, count: best.count }
  }
  if best.at == first {
    return SearchHint { kind: 0, at: 0, count: 0 }
  }
  return move best
}

effect fn allocateRegisters(code: &mut ByteBuffer) -> usize
  ! RegExpSyntaxError {
  let mut size: usize = 0
  let mut maximum: usize = 0
  let mut at = RE_HEADER_LEN
  while at < code.length() {
    let opcode = code.get(at)
    let length = instructionLength(code.asSlice(), at)
    if opcode == REOP_set_i32 || opcode == REOP_set_char_pos {
      if size >= REGISTER_COUNT_MAX {
        fail RegExpSyntaxError { message: "too many imbricated quantifiers", offset: 0 }
      }
      code.set(at + 1, usize.toU8(size))
      size = size + 1
      if size > maximum {
        maximum = size
      }
    } else if opcode == REOP_check_advance || opcode == REOP_loop
      || opcode == REOP_loop_split_goto_first
      || opcode == REOP_loop_split_next_first {
      size = size - 1
      code.set(at + 1, usize.toU8(size))
    } else if opcode == REOP_loop_check_adv_split_goto_first
      || opcode == REOP_loop_check_adv_split_next_first {
      size = size - 2
      code.set(at + 1, usize.toU8(size))
    }
    at = at + length
  }
  return maximum
}

impl CompilerState {
  effect fn quantifier(self: &mut Self, input: &[u8], atomStart: usize, captureStart: usize) -> ()
    ! OutOfMemoryError | RegExpSyntaxError
    ? &mut Allocator {
    let original = self.cursor
    let c = byte(input, original)
    let mut minimum: u32 = 0
    let mut maximum: u32 = 0
    if c == 42 {
      maximum = 2147483647
      self.cursor = original + 1
    } else if c == 43 {
      minimum = 1
      maximum = 2147483647
      self.cursor = original + 1
    } else if c == 63 {
      maximum = 1
      self.cursor = original + 1
    } else if c == 123 {
      if !digit(byte(input, original + 1)) {
        if unicode(self.flags) {
          fail RegExpSyntaxError { message: "invalid repetition count", offset: original }
        }
        return
      }
      let low = parseDigits(input, original + 1, true)
      minimum = i32.toU32(low.value)
      maximum = minimum
      self.cursor = low.next
      if byte(input, self.cursor) == 44 {
        self.cursor = self.cursor + 1
        maximum = 2147483647
        if digit(byte(input, self.cursor)) {
          let high = parseDigits(input, self.cursor, true)
          maximum = i32.toU32(high.value)
          self.cursor = high.next
          if maximum < minimum {
            fail RegExpSyntaxError { message: "invalid repetition count", offset: self.cursor }
          }
        }
      }
      if byte(input, self.cursor) != 125 && !unicode(self.flags) {
        self.cursor = original
        return
      }
      run self.expect(input, 125)
    } else {
      return ()
    }
    let mut greedy = true
    if byte(input, self.cursor) == 63 {
      greedy = false
      self.cursor = self.cursor + 1
    }
    let mut split = REOP_split_goto_first
    if greedy {
      split = REOP_split_next_first
    }
    let analysis = analyzeAtom(self.code.asSlice(), atomStart)
    let mut advance = analysis.advanceCheck
    let mut start = atomStart

    // A quantifier that runs its atom at most once needs no capture reset: the
    // captures inside it are still unset when it starts (only the atom sets
    // them, and an enclosing repeat resets them per iteration), and undo
    // restores them on backtracking.
    let resets = captureStart != self.captures && maximum > 1
    if analysis.captureReset && resets {
      run self.code.insertZeroes(start, 3)
      self.code.set(start, REOP_save_reset)
      self.code.set(start + 1, usize.toU8(captureStart))
      self.code.set(start + 2, usize.toU8(self.captures - 1))
    }
    let length = self.code.length() - start
    if minimum == 0 {
      if !analysis.captureReset && resets {
        run self.code.insertZeroes(start, 3)
        self.code.set(start, REOP_save_reset)
        self.code.set(start + 1, usize.toU8(captureStart))
        self.code.set(start + 2, usize.toU8(self.captures - 1))
        start = start + 3
      }
      if maximum == 0 {
        self.code.truncate(start)
      } else if maximum == 1 || maximum == 2147483647 {
        let mut checkSize: usize = 0
        if advance {
          checkSize = 2
        }
        let mut gotoSize: usize = 0
        if maximum == 2147483647 {
          gotoSize = 5
        }
        run self.code.insertZeroes(start, 5 + checkSize)
        self.code.set(start, split)
        self.code.patchU32(start + 1, usize.toU32(length + gotoSize + checkSize * 2))
        if advance {
          self.code.set(start + 5, REOP_set_char_pos)
          run self.emit8(REOP_check_advance, 0)
        }
        if gotoSize != 0 {
          run self.jump(REOP_goto, start)
        }
      } else {
        let mut checkSize: usize = 0
        if advance {
          checkSize = 2
        }
        run self.code.insertZeroes(start, 11 + checkSize)
        self.code.set(start, split)
        self.code.patchU32(start + 1, usize.toU32(6 + checkSize + length + 10))
        self.code.set(start + 5, REOP_set_i32)
        self.code.patchU32(start + 7, maximum)
        start = start + 11
        if advance {
          self.code.set(start, REOP_set_char_pos)
        }
        run self.loopSplit(start, maximum, advance, greedy)
      }
    } else if minimum == 1 && maximum == 2147483647 && !advance {
      let mut opcode = REOP_split_next_first
      if greedy {
        opcode = REOP_split_goto_first
      }
      run self.jump(opcode, start)
    } else {
      if minimum == maximum {
        advance = false
      }
      let mut checkSize: usize = 0
      if advance {
        checkSize = 2
      }
      run self.code.insertZeroes(start, 6 + checkSize)
      self.code.set(start, REOP_set_i32)
      self.code.patchU32(start + 2, maximum)
      start = start + 6
      if advance {
        self.code.set(start, REOP_set_char_pos)
      }
      if minimum == maximum {
        run self.emit8(REOP_loop, 0)
        let offset = relative(start, self.code.length() + 4)
        run self.code.writeU32(offset)
      } else {
        run self.loopSplit(start, maximum - minimum, advance, greedy)
      }
    }
  }

  effect fn loopSplit(self: &mut Self, target: usize, limit: u32, advance: bool, greedy: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut opcode = REOP_loop_split_next_first
    if advance {
      opcode = REOP_loop_check_adv_split_next_first
    }
    if greedy {
      opcode = opcode - 1
    }
    run self.emit8(opcode, 0)
    run self.code.writeU32(limit)
    let offset = relative(target, self.code.length() + 4)
    run self.code.writeU32(offset)
  }
}

// A min-heap yields descending lengths without copying strings or allocating sort scratch.
fn sortStringIndices(order: &mut List<usize>, strings: &[List<u32>]) -> () {
  let count = order.length()
  let mut parent = order.length() / 2
  while parent != 0 {
    parent = parent - 1
    siftStringIndex(&mut order, strings, parent, count)
  }
  let mut end = order.length()
  while end > 1 {
    end = end - 1
    let first = order.get(0)
    let last = order.get(end)
    order.set(0, last)
    order.set(end, first)
    siftStringIndex(&mut order, strings, 0, end)
  }
}

fn siftStringIndex(order: &mut List<usize>, strings: &[List<u32>], start: usize, end: usize) -> () {
  let mut root = start
  while root < end / 2 {
    let mut child = root * 2 + 1
    if child + 1 < end
      && strings[order.get(child + 1)].length() < strings[order.get(child)].length() {
      child = child + 1
    }
    if strings[order.get(root)].length() <= strings[order.get(child)].length() {
      return ()
    }
    let value = order.get(root)
    let below = order.get(child)
    order.set(root, below)
    order.set(child, value)
    root = child
  }
}

// From SilkJS src/regexp_parse_escape.silk.
struct EscapeResult {
  pub codePoint: i32,
  pub next: usize
}

struct DecimalResult {
  pub value: i32,
  pub next: usize
}

struct GroupName {
  pub bytes: List<u8>,
  pub next: usize
}

fn byteAt(input: &[u8], offset: usize) -> u32 {
  if offset >= input.length {
    return 0
  }
  return u8.toU32(input[offset])
}

fn hexValue(c: u32) -> i32 {
  if c >= 48 && c <= 57 {
    return u32.toI32(c - 48)
  }
  if c >= 65 && c <= 70 {
    return u32.toI32(c - 65 + 10)
  }
  if c >= 97 && c <= 102 {
    return u32.toI32(c - 97 + 10)
  }
  return -1
}

/// Offset points after the backslash. Failure leaves next equal to offset.
/// Modes 0/1 allow legacy octal; modes 1/2 allow braced Unicode; mode 2 joins pairs.
fn parseEscape(input: &[u8], offset: usize, allowUtf16: u32) -> EscapeResult {
  let malformed = EscapeResult { codePoint: -1, next: offset }
  if offset >= input.length {
    return EscapeResult { codePoint: -2, next: offset }
  }
  let mut p = offset + 1
  let mut c = byteAt(input, offset)
  match c {
    98 => {
      c = 8
    }
    102 => {
      c = 12
    }
    110 => {
      c = 10
    }
    114 => {
      c = 13
    }
    116 => {
      c = 9
    }
    118 => {
      c = 11
    }
    120 => {
      let h0 = hexValue(byteAt(input, p))
      if h0 < 0 {
        return move malformed
      }
      let h1 = hexValue(byteAt(input, p + 1))
      if h1 < 0 {
        return move malformed
      }
      c = i32.toU32(h0 * 16 + h1)
      p = p + 2
    }
    117 => {
      c = 0
      if byteAt(input, p) == 123 && allowUtf16 != 0 {
        p = p + 1
        while true {
          let h = hexValue(byteAt(input, p))
          if h < 0 {
            return move malformed
          }
          c = c * 16 + i32.toU32(h)
          p = p + 1
          if c > 0x10ffff {
            return move malformed
          }
          if byteAt(input, p) == 125 {
            break
          }
        }
        p = p + 1
      } else {
        let mut i: usize = 0
        while i < 4 {
          let h = hexValue(byteAt(input, p))
          if h < 0 {
            return move malformed
          }
          c = c * 16 + i32.toU32(h)
          p = p + 1
          i = i + 1
        }
        if c >= 0xd800 && c <= 0xdbff && allowUtf16 == 2 && byteAt(input, p) == 92
          && byteAt(input, p + 1) == 117 {
          let mut second: u32 = 0
          i = 0
          while i < 4 {
            let h = hexValue(byteAt(input, p + 2 + i))
            if h < 0 {
              break
            }
            second = second * 16 + i32.toU32(h)
            i = i + 1
          }
          if i == 4 && second >= 0xdc00 && second <= 0xdfff {
            c = 0x10000 + (c - 0xd800) * 1024 + second - 0xdc00
            p = p + 6
          }
        }
      }
    }
    _ => {
      if c < 48 || c > 55 {
        return EscapeResult { codePoint: -2, next: offset }
      }
      c = c - 48
      if allowUtf16 == 2 {
        let following = byteAt(input, p)
        if c != 0 || (following >= 48 && following <= 57) {
          return move malformed
        }
      } else {
        let following = byteAt(input, p)
        if following >= 48 && following <= 55 {
          c = c * 8 + following - 48
          p = p + 1
          if c < 32 {
            let third = byteAt(input, p)
            if third >= 48 && third <= 55 {
              c = c * 8 + third - 48
              p = p + 1
            }
          }
        }
      }
    }
  }
  return EscapeResult { codePoint: u32.toI32(c), next: p }
}

/// Matches upstream's >= INT32_MAX boundary; disallowed overflow leaves next unchanged.
fn parseDigits(input: &[u8], offset: usize, allowOverflow: bool) -> DecimalResult {
  let mut p = offset
  let mut value: i32 = 0
  while p < input.length {
    let c = byteAt(input, p)
    if c < 48 || c > 57 {
      break
    }
    let digit = u32.toI32(c - 48)
    if value > 214748364 || (value == 214748364 && digit >= 7) {
      if !allowOverflow {
        return DecimalResult { value: -1, next: offset }
      }
      value = 2147483647
    } else {
      value = value * 10 + digit
    }
    p = p + 1
  }
  return DecimalResult { value: value, next: p }
}

fn decodeAt(input: &[u8], offset: usize) -> Option<Decoded> {
  if offset >= input.length {
    return Option<Decoded>.none()
  }
  return Utf8.decode(Slice.view<u8>(input, offset, input.length - offset))
}

/// Offset follows '<'; next follows '>'. Invalid names return None without allocation.
/// The 128-byte upstream scratch bound reserves six encoding bytes plus a terminator
/// before each character. Returned bytes contain neither terminator nor scope trailer.
effect fn tryGroupName(input: &[u8], offset: usize) -> Option<GroupName>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut buffer: [u8; 128] = [0; 128]
  let mut length: usize = 0
  let mut p = offset
  while true {
    if p >= input.length {
      return Option<GroupName>.none()
    }
    let mut c = byteAt(input, p)
    if c == 62 {
      break
    }
    if c == 92 {
      p = p + 1
      if byteAt(input, p) != 117 {
        return Option<GroupName>.none()
      }
      let escaped = parseEscape(input, p, 2)
      if escaped.codePoint < 0 {
        return Option<GroupName>.none()
      }
      c = i32.toU32(escaped.codePoint)
      p = escaped.next
    } else if c >= 128 {
      let decoded = match move decodeAt(input, p) {
        Option<Decoded>.Some { value } => move value
        Option<Decoded>.None => {
          return Option<GroupName>.none()
        }
      }
      c = decoded.codePoint
      p = p + decoded.length
      if c >= 0xd800 && c <= 0xdbff {
        match move decodeAt(input, p) {
          Option<Decoded>.Some { value } => {
            if value.codePoint >= 0xdc00 && value.codePoint <= 0xdfff {
              c = 0x10000 + (c - 0xd800) * 1024 + value.codePoint - 0xdc00
              p = p + value.length
            }
          }
          Option<Decoded>.None => {}
        }
      }
    } else {
      p = p + 1
    }
    if c > 0x10ffff {
      return Option<GroupName>.none()
    }
    if length == 0 {
      if !UnicodeCase.isIdentifierStart(c) {
        return Option<GroupName>.none()
      }
    } else {
      if !UnicodeCase.isIdentifierContinue(c) {
        return Option<GroupName>.none()
      }
    }
    if length + 7 > 128 {
      return Option<GroupName>.none()
    }
    if c < 128 {
      buffer[length] = u32.toU8(c)
      length = length + 1
    } else {
      let mut encoded: [u8; 6] = [0; 6]
      let count = Utf8.encode(c, &mut encoded)
      let mut i: usize = 0
      while i < count {
        buffer[length] = encoded[i]
        length = length + 1
        i = i + 1
      }
    }
  }
  if length == 0 {
    return Option<GroupName>.none()
  }
  let mut bytes = List<u8>.make()
  run bytes.reserveExact(length)
  let mut i: usize = 0
  while i < length {
    run bytes.append(buffer[i])
    i = i + 1
  }
  return Option<GroupName>.some(GroupName { bytes: move bytes, next: p + 1 })
}

effect fn parseGroupName(input: &[u8], offset: usize) -> GroupName
  ! OutOfMemoryError | RegExpSyntaxError
  ? &mut Allocator {
  let result = run tryGroupName(input, offset)
  return match move result {
    Option<GroupName>.Some { value } => move value
    Option<GroupName>.None => {
      fail RegExpSyntaxError { message: "invalid group name", offset: offset }
    }
  }
}

// From SilkJS src/regexp_parse_sets.silk.
struct ClassResult {
  pub set: RegExpStrings,
  pub next: usize
}

struct AtomResult {
  pub set: RegExpStrings,
  pub codePoint: u32,
  pub isSet: bool,
  pub next: usize
}

fn byteAt8(input: &[u8], offset: usize) -> u8 {
  if offset >= input.length {
    return 0
  }
  return input[offset]
}

fn unicodeMode(flags: u32) -> bool {
  return flags & (FLAG_UNICODE | FLAG_UNICODE_SETS) != 0
}

fn setLiteral(code: u32, next: usize) -> AtomResult {
  return AtomResult { set: RegExpStrings.make(), codePoint: code, isSet: false, next: next }
}

fn setAtom(set: RegExpStrings, next: usize) -> AtomResult {
  return AtomResult { set: move set, codePoint: 0x40000000, isSet: true, next: next }
}

fn propertyByte(c: u8) -> bool {
  return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
}

fn propertyName(input: &[u8], start: usize, length: usize) -> string {
  // The caller has admitted only ASCII letters, digits, and underscore.
  unsafe {
    return String.fromUtf8Unchecked(Slice.view<u8>(input, start, length))
  }
}

effect fn propertyFailure(
  error: UnknownProperty,
  offset: usize,
  message: string<'static>,
) -> CharRange
  ! RegExpSyntaxError {
  fail RegExpSyntaxError { message: message, offset: offset }
}

effect fn sequenceFailure(error: UnknownProperty, offset: usize) -> ()
  ! RegExpSyntaxError {
  fail RegExpSyntaxError { message: "unknown unicode property name", offset: offset }
}

effect fn addSequence(values: &[u32], set: &mut RegExpStrings) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  return run set.add(values)
}

effect fn sequenceProperty(
  error: UnknownProperty,
  name: string,
  inverted: bool,
  flags: u32,
  offset: usize,
) -> RegExpStrings
  ! OutOfMemoryError | RegExpSyntaxError
  ? &mut Allocator {
  if inverted || flags & FLAG_UNICODE_SETS == 0 {
    fail RegExpSyntaxError { message: "unknown unicode property name", offset: offset }
  }
  let mut set = RegExpStrings.make()
  run UnicodeProperties.sequences(name, addSequence(&mut set))
    |> Effect.catch<UnknownProperty>(sequenceFailure(offset))
  return move set
}

effect fn binaryProperty(
  error: UnknownProperty,
  name: string,
  inverted: bool,
  flags: u32,
  offset: usize,
) -> RegExpStrings
  ! OutOfMemoryError | RegExpSyntaxError
  ? &mut Allocator {
  return run binaryPropertySet(name)
    |> Effect.catch<UnknownProperty>(sequenceProperty(name, inverted, flags, offset))
}

effect fn binaryPropertySet(name: string) -> RegExpStrings
  ! OutOfMemoryError | UnknownProperty
  ? &mut Allocator {
  let mut set = RegExpStrings.make()
  set.ranges = run UnicodeProperties.property(name)
  return move set
}

effect fn categoryPropertySet(name: string) -> RegExpStrings
  ! OutOfMemoryError | UnknownProperty
  ? &mut Allocator {
  let mut set = RegExpStrings.make()
  set.ranges = run UnicodeProperties.generalCategory(name)
  return move set
}

effect fn parseUnicodeProperty(
  input: &[u8],
  offset: usize,
  flags: u32,
  inverted: bool,
) -> ClassResult
  ! OutOfMemoryError | RegExpSyntaxError
  ? &mut Allocator {
  if byteAt8(input, offset) != 123 {
    fail RegExpSyntaxError { message: "expecting '{' after \\p", offset: offset }
  }
  let start = offset + 1
  let mut p = start
  while propertyByte(byteAt8(input, p)) {
    if p - start >= 63 {
      fail RegExpSyntaxError { message: "unknown unicode property name", offset: p }
    }
    p = p + 1
  }
  let name = propertyName(input, start, p - start)
  let mut valueStart = p
  let mut valueLength: usize = 0
  if byteAt8(input, p) == 61 {
    p = p + 1
    valueStart = p
    while propertyByte(byteAt8(input, p)) {
      if p - valueStart >= 63 {
        fail RegExpSyntaxError { message: "unknown unicode property value", offset: p }
      }
      p = p + 1
    }
    valueLength = p - valueStart
  }
  if byteAt8(input, p) != 125 {
    fail RegExpSyntaxError { message: "expecting '}'", offset: p }
  }
  let value = propertyName(input, valueStart, valueLength)
  let mut set = RegExpStrings.make()
  if name == "Script" || name == "sc" || name == "Script_Extensions" || name == "scx" {
    let extensions = name == "Script_Extensions" || name == "scx"
    set.ranges = run UnicodeProperties.script(value, extensions)
      |> Effect.catch<UnknownProperty>(propertyFailure(offset, "unknown unicode script"))
  } else if name == "General_Category" || name == "gc" {
    set.ranges = run UnicodeProperties.generalCategory(value)
      |> Effect.catch<UnknownProperty>(propertyFailure(offset, "unknown unicode general category"))
  } else if valueLength == 0 {
    set = run categoryPropertySet(name)
      |> Effect.catch<UnknownProperty>(binaryProperty(name, inverted, flags, offset))
  } else {
    fail RegExpSyntaxError { message: "unknown unicode property name", offset: offset }
  }

  // v folds before complement; u folds after complement, exactly as upstream.
  if flags & FLAG_IGNORECASE != 0 && flags & FLAG_UNICODE_SETS != 0 {
    run set.canonicalize(unicodeMode(flags))
  }
  if inverted {
    run set.ranges.invert()
  }
  if flags & FLAG_IGNORECASE != 0 && flags & FLAG_UNICODE_SETS == 0 {
    run set.canonicalize(unicodeMode(flags))
  }
  return ClassResult { set: move set, next: p + 1 }
}

effect fn builtinClass(c: u8) -> RegExpStrings
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut set = RegExpStrings.make()
  if c == 100 || c == 68 {
    run set.ranges.addInterval(48, 58)
  } else if c == 119 || c == 87 {
    run set.ranges.addInterval(48, 58)
    run set.ranges.addInterval(65, 91)
    run set.ranges.addInterval(95, 96)
    run set.ranges.addInterval(97, 123)
  } else {
    let points: [u32; 20] = [
      9,
      14,
      32,
      33,
      160,
      161,
      5760,
      5761,
      8192,
      8203,
      8232,
      8234,
      8239,
      8240,
      8287,
      8288,
      12288,
      12289,
      65279,
      65280,
    ]
    let mut i: usize = 0
    while i < 20 {
      run set.ranges.addInterval(points[i], points[i + 1])
      i = i + 2
    }
  }
  if c == 68 || c == 83 || c == 87 {
    run set.ranges.invert()
  }
  return move set
}

effect fn parseClassStringDisjunction(input: &[u8], offset: usize, flags: u32) -> ClassResult
  ! OutOfMemoryError | RegExpSyntaxError
  ? &mut Allocator {
  if byteAt8(input, offset) != 123 {
    fail RegExpSyntaxError { message: "expecting '{' after \\q", offset: offset }
  }
  let mut p = offset + 1
  let mut values = List<u32>.make()
  let mut set = RegExpStrings.make()
  while true {
    values.clear()
    while byteAt8(input, p) != 125 && byteAt8(input, p) != 124 {
      let atom = run parseClassAtom(input, p, flags, false, false)
      run values.append(atom.codePoint)
      p = atom.next
    }
    run set.add(values.asSlice())
    if byteAt8(input, p) == 125 {
      break
    }
    p = p + 1
  }
  if flags & FLAG_IGNORECASE != 0 {
    run set.canonicalize(true)
  }
  return ClassResult { set: move set, next: p + 1 }
}

// offset includes the backslash for an escape; next is the first unconsumed byte.
effect fn parseClassAtom(
  input: &[u8],
  offset: usize,
  flags: u32,
  inClass: bool,
  allowSets: bool,
) -> AtomResult
  ! OutOfMemoryError | RegExpSyntaxError
  ? &mut Allocator {
  if offset >= input.length {
    fail RegExpSyntaxError { message: "unexpected end", offset: offset }
  }
  let unicode = unicodeMode(flags)
  let sets = flags & FLAG_UNICODE_SETS != 0
  let mut p = offset
  let mut c = byteAt8(input, p)
  if c == 92 {
    p = p + 1
    if p >= input.length {
      fail RegExpSyntaxError { message: "unexpected end", offset: p }
    }
    c = input[p]
    p = p + 1
    if allowSets && (c == 100 || c == 68 || c == 115 || c == 83 || c == 119 || c == 87) {
      return setAtom(run builtinClass(c), p)
    }
    if c == 99 {
      let control = byteAt8(input, p)
      if (control >= 65 && control <= 90) || (control >= 97 && control <= 122)
        || (inClass && !unicode && ((control >= 48 && control <= 57) || control == 95)) {
        return setLiteral(u8.toU32(control) & 31, p + 1)
      }
      if unicode {
        fail RegExpSyntaxError {
          message: "invalid escape sequence in regular expression",
          offset: offset,
        }
      }
      return setLiteral(92, p - 1)
    }
    if c == 45 {
      if !inClass && unicode {
        fail RegExpSyntaxError {
          message: "invalid escape sequence in regular expression",
          offset: offset,
        }
      }
      return setLiteral(45, p)
    }
    if c == 94 || c == 36 || c == 92 || c == 46 || c == 42 || c == 43 || c == 63 || c == 40
      || c == 41
      || c == 91
      || c == 93
      || c == 123
      || c == 125
      || c == 124
      || c == 47 {
      return setLiteral(u8.toU32(c), p)
    }
    if (c == 112 || c == 80) && unicode && allowSets {
      let result = run parseUnicodeProperty(input, p, flags, c == 80)
      return setAtom(move result.set, result.next)
    }
    if c == 113 && sets && allowSets && inClass {
      let result = run parseClassStringDisjunction(input, p, flags)
      return setAtom(move result.set, result.next)
    }
    p = p - 1
    let mut allowUtf16: u32 = 0
    if unicode {
      allowUtf16 = 2
    }
    let escaped = parseEscape(input, p, allowUtf16)
    if escaped.codePoint >= 0 {
      return setLiteral(i32.toU32(escaped.codePoint), escaped.next)
    }
    if unicode {
      fail RegExpSyntaxError {
        message: "invalid escape sequence in regular expression",
        offset: offset,
      }
    }
  } else if inClass && sets {
    if c == 40 || c == 41 || c == 91 || c == 93 || c == 123 || c == 125 || c == 47 || c == 45
      || c == 124 {
      fail RegExpSyntaxError {
        message: "invalid character in class in regular expression",
        offset: p,
      }
    }
    if (c == 38 || c == 33 || c == 35 || c == 36 || c == 37 || c == 42 || c == 43 || c == 44
      || c == 46
      || c == 58
      || c == 59
      || c == 60
      || c == 61
      || c == 62
      || c == 63
      || c == 64
      || c == 94
      || c == 96
      || c == 126)
      && byteAt8(input, p + 1) == c {
      fail RegExpSyntaxError {
        message: "invalid class set operation in regular expression",
        offset: p,
      }
    }
  }
  if c < 128 {
    return setLiteral(u8.toU32(c), p + 1)
  }
  let decoded = Utf8.decode(Slice.view<u8>(input, p, input.length - p))
  if let Option<Decoded>.Some { value } = move decoded {
    if value.codePoint > 0xffff && !unicode {
      fail RegExpSyntaxError { message: "malformed unicode char", offset: p }
    }
    return setLiteral(value.codePoint, p + value.length)
  }
  fail RegExpSyntaxError { message: "malformed unicode char", offset: p }
}

effect fn parseSetOperand(
  input: &[u8],
  offset: usize,
  flags: u32,
  maxDepth: usize,
  stackLimit: usize,
) -> ClassResult
  ! OutOfMemoryError | RegExpSyntaxError | RegExpStackOverflow
  ? &mut Allocator {
  if byteAt8(input, offset) == 91 {
    return run parseClass(input, offset, flags, maxDepth, stackLimit)
  }
  let mut atom = run parseClassAtom(input, offset, flags, true, true)
  if !atom.isSet {
    let mut code = atom.codePoint
    if flags & FLAG_IGNORECASE != 0 {
      code = UnicodeCase.canonicalize(code, unicodeMode(flags))
    }
    run atom.set.ranges.unionInterval(code, code)
  }
  return ClassResult { set: move atom.set, next: atom.next }
}

// stackLimit is the same downward native-frame bound as RegExpCompiler.compile.
effect fn parseClass(
  input: &[u8],
  offset: usize,
  flags: u32,
  maxDepth: usize,
  stackLimit: usize,
) -> ClassResult
  ! OutOfMemoryError | RegExpSyntaxError | RegExpStackOverflow
  ? &mut Allocator {
  if maxDepth == 0 || (stackLimit != 0 && currentFrameAddress() < stackLimit) {
    fail RegExpStackOverflow {}
  }
  if byteAt8(input, offset) != 91 {
    fail RegExpSyntaxError { message: "expecting '['", offset: offset }
  }
  let mut p = offset + 1
  let invert = byteAt8(input, p) == 94
  if invert {
    p = p + 1
  }
  let mut set = RegExpStrings.make()
  let mut first = true
  let sets = flags & FLAG_UNICODE_SETS != 0
  let unicode = unicodeMode(flags)
  let ignoreCase = flags & FLAG_IGNORECASE != 0
  while byteAt8(input, p) != 93 {
    if byteAt8(input, p) == 91 && sets {
      let nested = run parseClass(input, p, flags, maxDepth - 1, stackLimit)
      run set.apply(&nested.set, RangeOperation.Union)
      p = nested.next
    } else {
      let atom = run parseClassAtom(input, p, flags, true, true)
      p = atom.next
      let mut hasRange = false
      if byteAt8(input, p) == 45 && byteAt8(input, p + 1) != 93
        && !(sets && first && byteAt8(input, p + 1) == 45) {
        if atom.isSet {
          if unicode {
            fail RegExpSyntaxError { message: "invalid class range", offset: p }
          }
        } else {
          let end = run parseClassAtom(input, p + 1, flags, true, true)
          if end.isSet {
            if unicode {
              fail RegExpSyntaxError { message: "invalid class range", offset: p }
            }
          } else {
            if end.codePoint < atom.codePoint {
              fail RegExpSyntaxError { message: "invalid class range", offset: p }
            }
            p = end.next
            if ignoreCase {
              let mut range = CharRange.make()
              run range.unionInterval(atom.codePoint, end.codePoint)
              run range.canonicalize(unicode)
              run set.ranges.apply(&range, RangeOperation.Union)
            } else {
              run set.ranges.unionInterval(atom.codePoint, end.codePoint)
            }
            first = false
            hasRange = true
          }
        }
      }
      if !hasRange {
        if atom.isSet {
          run set.apply(&atom.set, RangeOperation.Union)
        } else {
          let mut code = atom.codePoint
          if ignoreCase {
            code = UnicodeCase.canonicalize(code, unicode)
          }
          run set.ranges.unionInterval(code, code)
        }
      }
    }
    if sets && first {
      let intersection = byteAt8(input, p) == 38 && byteAt8(input, p + 1) == 38
        && byteAt8(input, p + 2) != 38
      let subtraction = byteAt8(input, p) == 45 && byteAt8(input, p + 1) == 45
      if intersection || subtraction {
        let mut operation = RangeOperation.Subtract
        if intersection {
          operation = RangeOperation.Intersection
        }
        while byteAt8(input, p) != 93 {
          let validIntersection = intersection && byteAt8(input, p) == 38
            && byteAt8(input, p + 1) == 38
            && byteAt8(input, p + 2) != 38
          let validSubtraction = subtraction && byteAt8(input, p) == 45
            && byteAt8(input, p + 1) == 45
          if !validIntersection && !validSubtraction {
            fail RegExpSyntaxError { message: "invalid operation in regular expression", offset: p }
          }
          let operand = run parseSetOperand(input, p + 2, flags, maxDepth - 1, stackLimit)
          run set.apply(&operand.set, operation)
          p = operand.next
        }
      }
    }
    first = false
  }
  if invert {
    if set.strings.length() != 0 {
      fail RegExpSyntaxError {
        message: "negated character class with strings in regular expression debugger eval code",
        offset: p,
      }
    }
    run set.ranges.invert()
  }
  return ClassResult { set: move set, next: p + 1 }
}

// From SilkJS src/regexp_strings.silk.
// Length-one strings live only in ranges. Other lengths, including zero, use
// an open-addressed index; slots hold string indices plus one (zero is empty).
struct RegExpStrings {
  pub ranges: CharRange,
  pub strings: List<List<u32>>,
  slots: List<usize>
}

fn stringHash(values: &[u32]) -> usize {
  let mut hash: u32 = 1
  let mut i: usize = 0
  while i < values.length {
    hash = u32.wrappingAdd(u32.wrappingMultiply(hash, 263), values[i])
    i = i + 1
  }
  return u32.toUsize(u32.wrappingMultiply(hash, 0x61c88647))
}

fn equalString(a: &[u32], b: &[u32]) -> bool {
  if a.length != b.length {
    return false
  }
  let mut i: usize = 0
  while i < a.length {
    if a[i] != b[i] {
      return false
    }
    i = i + 1
  }
  return true
}

impl RegExpStrings {
  fn make() -> RegExpStrings {
    return RegExpStrings {
      ranges: CharRange.make(),
      strings: List<List<u32>>.make(),
      slots: List<usize>.make(),
    }
  }

  fn slot(self: &Self, values: &[u32]) -> usize {
    let mask = self.slots.length() - 1
    let mut index = stringHash(values) & mask
    while self.slots.get(index) != 0 {
      let stringIndex = self.slots.get(index) - 1
      if equalString(self.strings.asSlice()[stringIndex].asSlice(), values) {
        return index
      }
      index = (index + 1) & mask
    }
    return index
  }

  fn containsString(self: &Self, values: &[u32]) -> bool {
    if self.slots.length() == 0 {
      return false
    }
    return self.slots.get(self.slot(values)) != 0
  }

  effect fn reserveIndex(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if (self.strings.length() + 1) * 2 <= self.slots.length() {
      return ()
    }
    let mut capacity = self.slots.length() * 2
    if capacity < 16 {
      capacity = 16
    }
    let mut slots = List<usize>.make()
    run slots.reserve(capacity)
    let mut i: usize = 0
    while i < capacity {
      run slots.append(0)
      i = i + 1
    }
    i = 0
    while i < self.strings.length() {
      let mut slot = stringHash(self.strings.asSlice()[i].asSlice()) & (capacity - 1)
      while slots.get(slot) != 0 {
        slot = (slot + 1) & (capacity - 1)
      }
      slots.set(slot, i + 1)
      i = i + 1
    }
    self.slots = move slots
  }

  effect fn addOwned(self: &mut Self, values: List<u32>) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if values.length() == 1 {
      return run self.ranges.unionInterval(values.get(0), values.get(0))
    }
    if self.containsString(values.asSlice()) {
      return ()
    }
    run self.reserveIndex()
    let slot = self.slot(values.asSlice())
    run self.strings.append(move values)
    self.slots.set(slot, self.strings.length())
  }

  effect fn add(self: &mut Self, values: &[u32]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if values.length == 1 {
      return run self.ranges.unionInterval(values[0], values[0])
    }
    if self.containsString(values) {
      return ()
    }
    run self.reserveIndex()
    let slot = self.slot(values)
    let mut owned = List<u32>.make()
    run owned.reserve(values.length)
    let mut i: usize = 0
    while i < values.length {
      run owned.append(values[i])
      i = i + 1
    }
    run self.strings.append(move owned)
    self.slots.set(slot, self.strings.length())
  }

  effect fn canonicalize(self: &mut Self, unicode: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.ranges.canonicalize(unicode)
    if self.strings.length() == 0 {
      return ()
    }
    let mut mapped = RegExpStrings.make()
    while self.strings.length() != 0 {
      let last = self.strings.length() - 1
      let mut values = self.strings.remove(last)
      let mut i: usize = 0
      while i < values.length() {
        let mappedValue = UnicodeCase.canonicalize(values.get(i), unicode)
        values.set(i, mappedValue)
        i = i + 1
      }
      run mapped.addOwned(move values)
    }
    self.strings = move mapped.strings
    self.slots = move mapped.slots
  }

  effect fn apply(self: &mut Self, other: &RegExpStrings, operation: RangeOperation) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.ranges.apply(&other.ranges, operation)
    if operation == RangeOperation.Union {
      let mut i: usize = 0
      while i < other.strings.length() {
        run self.add(other.strings.asSlice()[i].asSlice())
        i = i + 1
      }
      return ()
    }
    let mut selected = RegExpStrings.make()
    if operation == RangeOperation.Xor {
      let mut i: usize = 0
      while i < other.strings.length() {
        let values = other.strings.asSlice()[i].asSlice()
        if !self.containsString(values) {
          run selected.add(values)
        }
        i = i + 1
      }
    }
    while self.strings.length() != 0 {
      let last = self.strings.length() - 1
      let values = self.strings.remove(last)
      let present = other.containsString(values.asSlice())
      let keep = match operation {
        RangeOperation.Intersection => present
        _ => !present
      }
      if keep {
        run selected.addOwned(move values)
      }
    }
    self.strings = move selected.strings
    self.slots = move selected.slots
  }
}

// From SilkJS src/regexp_exec.silk.
//! Native execution of the pinned QuickJS RegExp bytecode, including its undo-log VM.
//! Inputs are Latin-1 bytes or UTF-16 code units, never UTF-8. Capture offsets are
//! code-unit indices; -1 denotes an unset capture. Valid compiler bytecode and a
//! start index no greater than the input length are preconditions. In Unicode
//! modes a start inside a surrogate pair moves back to the high surrogate.
//! Timeout callbacks run after each 10,000 upstream polling events: taken goto,
//! unconditional loop iteration, or successful backtracking, not every opcode.
//! Polling callbacks inherit the execution allocator capability for reentrant host work.

const STATE_SPLIT: i64 = 0

const STATE_LOOKAHEAD: i64 = 1

const STATE_NEGATIVE_LOOKAHEAD: i64 = 2

// A greedy one-character loop's pending exits (greedyLoop): the frame's pc word
// holds the exit pc in its low 32 bits and the lowest position in the high ones;
// its position word is the next position to resume at, counting down.
const STATE_STAR: i64 = 3

const INTERRUPT_COUNTER_INIT: u32 = 10000

// Undo-log words kept on the native stack before the log moves to the heap.
const UNDO_INLINE: usize = 256

// Code units of the subject string. Each width gets its own copy of the engine,
// so the per-character width test and the slice bounds checks fold away.
interface Units {
  fn holdsWords(self: &Self) -> bool

  // `position` is below the input length; every caller checks it first.
  fn codeUnitAt(self: &Self, position: usize) -> u32

  // The first position from `from` below `length` holding `unit`, or `length`.
  fn findUnit(self: &Self, unit: u32, from: usize, length: usize) -> usize

  // The first position from `from` below `length` holding a, b or c (each at
  // most 255) or a unit above 255, or `length`.
  fn findAny(self: &Self, a: u32, b: u32, c: u32, from: usize, length: usize) -> usize

  // Whether the count units from at equal the count bytes at bytes (the caller
  // keeps at + count within the input).
  fn equalsBytes(self: &Self, at: usize, bytes: [*]const u8, count: usize) -> bool

  // Whether the count units from at equal the count two-byte units (low byte
  // first) at bytes, under equalsBytes's bounds.
  fn equalsUnits(self: &Self, at: usize, bytes: [*]const u8, count: usize) -> bool
}

struct Narrow {
  bytes: ?[*]const u8
}

struct Wide {
  words: ?[*]const u16
}

impl Units for Narrow {
  @inlineAlways
  fn holdsWords(self: &Self) -> bool {
    return false
  }

  @inlineAlways
  fn codeUnitAt(self: &Self, position: usize) -> u32 {
    unsafe {
      return u8.toU32(
        Pointer.read<u8>(
          Pointer.at<u8>(
            Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(self.bytes),
            position,
          ),
        ),
      )
    }
  }

  // Sixteen bytes a step: one compare and mask per vector.
  @inlineAlways
  fn findUnit(self: &Self, unit: u32, from: usize, length: usize) -> usize {
    if unit > 255 {
      return length
    }
    let base = unsafe Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(self.bytes)
    let pattern = u8x16.splat(u32.toU8(unit))
    let mut at = from
    while at < length && length - at >= 16 {
      let hits = mask16.toBits(
        u8x16.lanesEqual(
          unsafe u8x16.loadUnchecked(
            unsafe Pointer.assumeMany<u8>(unsafe Pointer.at<u8>(base, at)),
          ),
          pattern,
        ),
      )
      if hits != 0 {
        return at + u32.toUsize(u64.trailingZeros(hits))
      }
      at = at + 16
    }

    // The last block overlaps the one before: the vector ending at length, with
    // the lanes before at masked off.
    if at < length && length >= 16 {
      let block = length - 16
      let hits = u64.shiftRight(
        mask16.toBits(
          u8x16.lanesEqual(
            unsafe u8x16.loadUnchecked(
              unsafe Pointer.assumeMany<u8>(unsafe Pointer.at<u8>(base, block)),
            ),
            pattern,
          ),
        ),
        usize.toU64(at - block),
      )
      if hits != 0 {
        return at + u32.toUsize(u64.trailingZeros(hits))
      }
      return length
    }
    while at < length
      && u8.toU32(unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(base, at))) != unit {
      at = at + 1
    }
    return at
  }

  fn equalsBytes(self: &Self, at: usize, bytes: [*]const u8, count: usize) -> bool {
    let base = unsafe Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(self.bytes)
    let mut k: usize = 0
    while count - k >= 8 {
      let left = unsafe Pointer.readUnaligned<u64>(
        unsafe Intrinsic.pointerReinterpret<*const u8, *const align (1) u64>(
          unsafe Pointer.at<u8>(base, usize.wrappingAdd(at, k)),
        ),
      )
      let right = unsafe Pointer.readUnaligned<u64>(
        unsafe Intrinsic.pointerReinterpret<*const u8, *const align (1) u64>(
          unsafe Pointer.at<u8>(bytes, k),
        ),
      )
      if left != right {
        return false
      }
      k = k + 8
    }
    if count - k >= 4 {
      let left = unsafe Pointer.readUnaligned<u32>(
        unsafe Intrinsic.pointerReinterpret<*const u8, *const align (1) u32>(
          unsafe Pointer.at<u8>(base, usize.wrappingAdd(at, k)),
        ),
      )
      let right = unsafe Pointer.readUnaligned<u32>(
        unsafe Intrinsic.pointerReinterpret<*const u8, *const align (1) u32>(
          unsafe Pointer.at<u8>(bytes, k),
        ),
      )
      if left != right {
        return false
      }
      k = k + 4
    }
    while k < count {
      if unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(base, usize.wrappingAdd(at, k)))
        != unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(bytes, k)) {
        return false
      }
      k = k + 1
    }
    return true
  }

  // The run holds a unit above 255 (see HINT_RUN_UNITS), so it compares unit by unit.
  fn equalsUnits(self: &Self, at: usize, bytes: [*]const u8, count: usize) -> bool {
    let mut k: usize = 0
    while k < count {
      let low = u8.toU32(unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(bytes, k + k)))
      let high = u8.toU32(unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(bytes, k + k + 1)))
      if self.codeUnitAt(usize.wrappingAdd(at, k)) != low + high * 256 {
        return false
      }
      k = k + 1
    }
    return true
  }

  fn findAny(self: &Self, a: u32, b: u32, c: u32, from: usize, length: usize) -> usize {
    let base = unsafe Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(self.bytes)
    let first = u8x16.splat(u32.toU8(a))
    let second = u8x16.splat(u32.toU8(b))
    let third = u8x16.splat(u32.toU8(c))
    let mut at = from
    while at < length && length - at >= 16 {
      let block = unsafe u8x16.loadUnchecked(
        unsafe Pointer.assumeMany<u8>(unsafe Pointer.at<u8>(base, at)),
      )
      let hits = u64.bitOr(
        u64.bitOr(
          mask16.toBits(u8x16.lanesEqual(block, first)),
          mask16.toBits(u8x16.lanesEqual(block, second)),
        ),
        mask16.toBits(u8x16.lanesEqual(block, third)),
      )
      if hits != 0 {
        return at + u32.toUsize(u64.trailingZeros(hits))
      }
      at = at + 16
    }

    // The overlapping last block, as findUnit.
    if at < length && length >= 16 {
      let block = length - 16
      let tail = unsafe u8x16.loadUnchecked(
        unsafe Pointer.assumeMany<u8>(unsafe Pointer.at<u8>(base, block)),
      )
      let hits = u64.shiftRight(
        u64.bitOr(
          u64.bitOr(
            mask16.toBits(u8x16.lanesEqual(tail, first)),
            mask16.toBits(u8x16.lanesEqual(tail, second)),
          ),
          mask16.toBits(u8x16.lanesEqual(tail, third)),
        ),
        usize.toU64(at - block),
      )
      if hits != 0 {
        return at + u32.toUsize(u64.trailingZeros(hits))
      }
      return length
    }
    while at < length {
      let code = u8.toU32(unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(base, at)))
      if code == a || code == b || code == c {
        return at
      }
      at = at + 1
    }
    return at
  }
}

impl Units for Wide {
  @inlineAlways
  fn holdsWords(self: &Self) -> bool {
    return true
  }

  @inlineAlways
  fn codeUnitAt(self: &Self, position: usize) -> u32 {
    unsafe {
      return u16.toU32(
        Pointer.read<u16>(
          Pointer.at<u16>(
            Intrinsic.pointerRequalify<?[*]const u16, [*]const u16>(self.words),
            position,
          ),
        ),
      )
    }
  }

  // Eight units a step, as Narrow.findUnit.
  @inlineAlways
  fn findUnit(self: &Self, unit: u32, from: usize, length: usize) -> usize {
    if unit > 0xffff {
      return length
    }
    let base = unsafe Intrinsic.pointerRequalify<?[*]const u16, [*]const u16>(self.words)
    let pattern = u16x8.splat(u32.toU16(unit))
    let mut at = from
    while at < length && length - at >= 8 {
      let hits = mask8.toBits(
        u16x8.lanesEqual(
          unsafe u16x8.loadUnchecked(
            unsafe Pointer.assumeMany<u16>(unsafe Pointer.at<u16>(base, at)),
          ),
          pattern,
        ),
      )
      if hits != 0 {
        return at + u32.toUsize(u64.trailingZeros(hits))
      }
      at = at + 8
    }
    while at < length && self.codeUnitAt(at) != unit {
      at = at + 1
    }
    return at
  }

  fn equalsBytes(self: &Self, at: usize, bytes: [*]const u8, count: usize) -> bool {
    let mut k: usize = 0
    while k < count {
      if self.codeUnitAt(usize.wrappingAdd(at, k))
        != u8.toU32(unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(bytes, k))) {
        return false
      }
      k = k + 1
    }
    return true
  }

  // Four units a step as one 64-bit word, then units.
  fn equalsUnits(self: &Self, at: usize, bytes: [*]const u8, count: usize) -> bool {
    let base = unsafe Intrinsic.pointerReinterpret<[*]const u16, [*]const u8>(
      unsafe Intrinsic.pointerRequalify<?[*]const u16, [*]const u16>(self.words),
    )
    let from = usize.wrappingAdd(at, at)
    let total = count + count
    let mut k: usize = 0
    while total - k >= 8 {
      let left = unsafe Pointer.readUnaligned<u64>(
        unsafe Intrinsic.pointerReinterpret<*const u8, *const align (1) u64>(
          unsafe Pointer.at<u8>(base, usize.wrappingAdd(from, k)),
        ),
      )
      let right = unsafe Pointer.readUnaligned<u64>(
        unsafe Intrinsic.pointerReinterpret<*const u8, *const align (1) u64>(
          unsafe Pointer.at<u8>(bytes, k),
        ),
      )
      if left != right {
        return false
      }
      k = k + 8
    }
    while k < total {
      if unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(base, usize.wrappingAdd(from, k)))
        != unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(bytes, k)) {
        return false
      }
      k = k + 1
    }
    return true
  }

  fn findAny(self: &Self, a: u32, b: u32, c: u32, from: usize, length: usize) -> usize {
    let base = unsafe Intrinsic.pointerRequalify<?[*]const u16, [*]const u16>(self.words)
    let first = u16x8.splat(u32.toU16(a))
    let second = u16x8.splat(u32.toU16(b))
    let third = u16x8.splat(u32.toU16(c))
    let latin = u16x8.splat(255)
    let mut at = from
    while at < length && length - at >= 8 {
      let block = unsafe u16x8.loadUnchecked(
        unsafe Pointer.assumeMany<u16>(unsafe Pointer.at<u16>(base, at)),
      )
      let hits = u64.bitOr(
        u64.bitOr(
          mask8.toBits(u16x8.lanesEqual(block, first)),
          mask8.toBits(u16x8.lanesEqual(block, second)),
        ),
        u64.bitOr(
          mask8.toBits(u16x8.lanesEqual(block, third)),
          mask8.toBits(u16x8.lanesGreater(block, latin)),
        ),
      )
      if hits != 0 {
        return at + u32.toUsize(u64.trailingZeros(hits))
      }
      at = at + 8
    }
    while at < length {
      let code = self.codeUnitAt(at)
      if code == a || code == b || code == c || code > 255 {
        return at
      }
      at = at + 1
    }
    return at
  }
}

struct ExecInput<U> {
  units: U,
  unicode: bool,
  length: usize
}

struct Character {
  code: u32,
  position: usize
}

fn isHighSurrogate(code: u32) -> bool {
  return code >= 0xd800 && code <= 0xdbff
}

fn isLowSurrogate(code: u32) -> bool {
  return code >= 0xdc00 && code <= 0xdfff
}

@inlineAlways
fn unitAt<U: Units>(input: &ExecInput<U>, position: usize) -> u32 {
  return input.units.codeUnitAt(position)
}

@inlineAlways
fn stepForward<U: Units>(input: &ExecInput<U>, position: usize, end: usize) -> Character {
  let mut code = unitAt(input, position)
  let mut next = position + 1
  if input.units.holdsWords() && input.unicode && isHighSurrogate(code) && next < end {
    let low = unitAt(input, next)
    if isLowSurrogate(low) {
      code = 0x10000 + (code - 0xd800) * 1024 + low - 0xdc00
      next = next + 1
    }
  }
  return Character { code: code, position: next }
}

@inlineAlways
fn stepBackward<U: Units>(input: &ExecInput<U>, position: usize, start: usize) -> Character {
  let mut next = position - 1
  let mut code = unitAt(input, next)
  if input.units.holdsWords() && input.unicode && isLowSurrogate(code) && next > start {
    let high = unitAt(input, next - 1)
    if isHighSurrogate(high) {
      code = 0x10000 + (high - 0xd800) * 1024 + code - 0xdc00
      next = next - 1
    }
  }
  return Character { code: code, position: next }
}

@inlineAlways
fn slots(words: ?*mut i64) -> [*]mut i64 {
  unsafe {
    return Pointer.assumeManyMut<i64>(Intrinsic.pointerRequalify<?*mut i64, *mut i64>(words))
  }
}

// Backing memory for the undo log and the register file, a local of `execute`
// that never moves. The first UNDO_INLINE undo words and 32 registers live on the
// native stack, as in libregexp.c; a full 765-word register array cost a 6 KB fill
// on every exec, so only the header's live count is reset. The undo words are
// uninitialized stack (written before read): with only 32 of them, common
// patterns grew a heap log on every exec. The machine holds raw pointers into
// this storage and no pointer to itself, which lets LLVM keep its fields in registers.
struct Storage {
  inlineWords: ?*mut i64,
  heap: List<i64>,
  inlineValues: ?*mut i64,
  spill: List<i64>
}

@inlineAlways
fn registerStore(values: ?*mut i64, index: usize, value: i64) -> () {
  unsafe {
    Pointer.write<i64>(Pointer.atMut<i64>(slots(values), index), value)
  }
}

@inlineAlways
fn registerAt(values: ?*mut i64, index: usize) -> i64 {
  unsafe {
    return Pointer.read<i64>(Pointer.atMut<i64>(slots(values), index))
  }
}

struct Grown {
  words: ?*mut i64,
  capacity: usize
}

// Doubles the undo log. The heap copy keeps its high-water mark, so a log that
// shrinks and grows again reuses it without reallocating. Cold: the matcher's
// save and push arms call it inline, and its blocks belong out of their hot path.
@cold
effect fn growUndo(storage: ?*mut Storage, capacity: usize) -> Grown
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut anchor: u8 = 0
  unsafe {
    let place = Pointer.borrowMut<u8, Storage>(
      &mut anchor,
      Intrinsic.pointerRequalify<?*mut Storage, *mut Storage>(storage),
    )
    if List<i64>.length(&place.heap) == 0 {
      run List<i64>.reserveExact(&mut place.heap, capacity * 2)
      let mut index: usize = 0
      while index < capacity {
        let value = registerAt(place.inlineWords, index)
        run List<i64>.append(&mut place.heap, value)
        index = index + 1
      }
    }
    let filled = List<i64>.length(&place.heap)
    run List<i64>.appendRepeated(&mut place.heap, 0, capacity * 2 - filled)
    let grown = List<i64>.length(&place.heap)
    return Grown {
      words: Pointer.fromMutRef<i64>(&mut List<i64>.asMutSlice(&mut place.heap)[0]),
      capacity: grown,
    }
  }
}

// A register file of more than 32 registers, all unset, in storage's spill list.
@cold
effect fn spillRegisters(storage: &mut Storage, registerCount: usize) -> ?*mut i64
  ! OutOfMemoryError
  ? &mut Allocator {
  run List<i64>.reserveExact(&mut storage.spill, registerCount)
  run List<i64>.appendRepeated(&mut storage.spill, -1, registerCount)
  return Pointer.fromMutRef<i64>(&mut List<i64>.asMutSlice(&mut storage.spill)[0])
}

struct Frame {
  pc: usize,
  position: usize,
  kind: i64
}

struct Resume {
  exists: bool,
  pc: usize,
  position: usize
}

struct Machine {
  // Header limits are 255 captures and 255 registers. An integer representation
  // distinguishes unset (-1) from a capture at input offset zero without pointers.
  values: ?*mut i64,
  words: ?*mut i64,
  capacity: usize,
  length: usize,
  base: usize,
  storage: ?*mut Storage
}

impl Machine {
  // `storage` must outlive the machine and stay in place.
  @inlineAlways
  effect fn make(storage: &mut Storage, registerCount: usize) -> Self
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut values = storage.inlineValues
    if registerCount <= 32 {
      // Only the live registers start unset: filling all 32 cost every exec. The
      // first eight (of the 32 inline) are four vector stores, so the common
      // small program does not call memset.
      let unset = i64x2.splat(-1)
      let base = slots(values)
      unsafe {
        i64x2.storeUnchecked(base, unset)
        i64x2.storeUnchecked(Pointer.assumeManyMut<i64>(Pointer.atMut<i64>(base, 2)), unset)
        i64x2.storeUnchecked(Pointer.assumeManyMut<i64>(Pointer.atMut<i64>(base, 4)), unset)
        i64x2.storeUnchecked(Pointer.assumeManyMut<i64>(Pointer.atMut<i64>(base, 6)), unset)
      }
      let mut index: usize = 8
      while index < registerCount {
        registerStore(values, index, -1)
        index = index + 1
      }
    } else {
      values = run spillRegisters(&mut storage, registerCount)
    }
    return Machine {
      values: values,
      words: storage.inlineWords,
      capacity: UNDO_INLINE,
      length: 0,
      base: 0,
      storage: Pointer.fromMutRef<Storage>(&mut storage),
    }
  }

  // Register indices come from validated bytecode and stay below the live count.
  @inlineAlways
  fn register(self: &Self, index: usize) -> i64 {
    return registerAt(self.values, index)
  }

  @inlineAlways
  fn setRegister(self: &mut Self, index: usize, value: i64) -> () {
    unsafe {
      Pointer.write<i64>(Pointer.atMut<i64>(slots(self.values), index), value)
    }
  }

  // Undo-log indices stay below `length`, which never exceeds `capacity`.
  @inlineAlways
  fn word(self: &Self, index: usize) -> i64 {
    unsafe {
      return Pointer.read<i64>(Pointer.atMut<i64>(slots(self.words), index))
    }
  }

  @inlineAlways
  fn setWord(self: &mut Self, index: usize, value: i64) -> () {
    unsafe {
      Pointer.write<i64>(Pointer.atMut<i64>(slots(self.words), index), value)
    }
  }

  // Makes room for `count` (at most 32) more words and returns the current
  // length, where the caller writes them before advancing `length`.
  @inlineAlways
  effect fn reserve(self: &mut Self, count: usize) -> usize
    ! OutOfMemoryError
    ? &mut Allocator {
    let at = self.length
    if usize.wrappingSubtract(self.capacity, at) < count {
      let grown = run growUndo(self.storage, self.capacity)
      self.words = grown.words
      self.capacity = grown.capacity
    }
    return at
  }

  @inlineAlways
  effect fn save(self: &mut Self, index: usize, value: i64, check: bool) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    // Writing the value a register already holds changes nothing to undo (a
    // reset of captures that are still unset, mostly).
    let previous = Machine.register(&self, index)
    if previous == value {
      return ()
    }
    let mut saved = false
    if check {
      let mut cursor = self.length
      while cursor > self.base {
        if Machine.word(&self, cursor - 2) == usize.wrappingToI64(index) {
          saved = true
          break
        }
        cursor = cursor - 2
      }
    }
    if !saved {
      let at = run Machine.reserve(&mut self, 2)
      Machine.setWord(&mut self, at, usize.wrappingToI64(index))
      Machine.setWord(&mut self, usize.wrappingAdd(at, 1), previous)
      self.length = usize.wrappingAdd(at, 2)
    }
    Machine.setRegister(&mut self, index, value)
  }

  @inlineAlways
  effect fn pushFrame(self: &mut Self, pc: usize, position: usize, kind: i64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    // The log holds fewer than 2^61 words, so the link cannot overflow.
    let link = usize.wrappingToI64(usize.shiftLeft(self.base, 2)) + kind
    let at = run Machine.reserve(&mut self, 3)
    Machine.setWord(&mut self, at, usize.wrappingToI64(pc))
    Machine.setWord(&mut self, usize.wrappingAdd(at, 1), usize.wrappingToI64(position))
    Machine.setWord(&mut self, usize.wrappingAdd(at, 2), link)
    self.length = usize.wrappingAdd(at, 3)
    self.base = usize.wrappingAdd(at, 3)
  }

  // A STATE_STAR frame: its first word packs the loop's start position above its exit pc, in 64
  // bits on every target, so the pair fits where a 32-bit usize would not.
  @inlineAlways
  effect fn pushStar(self: &mut Self, exit: usize, start: usize, position: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let link = usize.wrappingToI64(usize.shiftLeft(self.base, 2)) + STATE_STAR
    let at = run Machine.reserve(&mut self, 3)
    let packed = u64.bitOr(u64.shiftLeft(usize.toU64(start), 32), usize.toU64(exit))
    Machine.setWord(&mut self, at, u64.wrappingToI64(packed))
    Machine.setWord(&mut self, usize.wrappingAdd(at, 1), usize.wrappingToI64(position))
    Machine.setWord(&mut self, usize.wrappingAdd(at, 2), link)
    self.length = usize.wrappingAdd(at, 3)
    self.base = usize.wrappingAdd(at, 3)
  }

  @inlineAlways
  fn undo(self: &mut Self) -> () {
    while self.length > self.base {
      let top = self.length
      let index = i64.wrappingToUsize(Machine.word(&self, usize.wrappingSubtract(top, 2)))
      let previous = Machine.word(&self, usize.wrappingSubtract(top, 1))
      Machine.setRegister(&mut self, index, previous)
      self.length = usize.wrappingSubtract(top, 2)
    }
  }

  @inlineAlways
  fn popFrame(self: &mut Self) -> Frame {
    let top = self.base

    // A frame is three words, so base is at least 3.
    let link = Machine.word(&self, usize.wrappingSubtract(top, 1))
    let pc = i64.wrappingToUsize(Machine.word(&self, usize.wrappingSubtract(top, 3)))
    let position = i64.wrappingToUsize(Machine.word(&self, usize.wrappingSubtract(top, 2)))
    self.length = usize.wrappingSubtract(top, 3)

    // Links are base * 4 + kind with a nonnegative base.
    let bits = i64.wrappingToUsize(link)
    self.base = usize.shiftRight(bits, 2)
    return Frame { pc: pc, position: position, kind: usize.wrappingToI64(usize.bitAnd(bits, 3)) }
  }

  @inlineAlways
  fn backtrack(self: &mut Self) -> Resume {
    while self.base != 0 {
      Machine.undo(&mut self)
      let top = self.base
      if usize.bitAnd(i64.wrappingToUsize(Machine.word(&self, usize.wrappingSubtract(top, 1))), 3)
        == 3 {
        // STATE_STAR: resume at the exit one position lower, keeping the frame
        // while lower positions remain.
        let packed = i64.wrappingToU64(Machine.word(&self, usize.wrappingSubtract(top, 3)))
        let position = i64.wrappingToUsize(Machine.word(&self, usize.wrappingSubtract(top, 2)))
        if position > u64.wrappingToUsize(u64.shiftRight(packed, 32)) {
          Machine.setWord(
            &mut self,
            usize.wrappingSubtract(top, 2),
            usize.wrappingToI64(position - 1),
          )
        } else {
          let finished = Machine.popFrame(&mut self)
        }
        return Resume {
          exists: true,
          pc: u64.wrappingToUsize(u64.bitAnd(packed, 0xffffffff)),
          position: position,
        }
      }
      let frame = Machine.popFrame(&mut self)
      if frame.kind != STATE_LOOKAHEAD {
        return Resume { exists: true, pc: frame.pc, position: frame.position }
      }
    }
    return Resume { exists: false, pc: 0, position: 0 }
  }

  @inlineAlways
  fn finishPositive(self: &mut Self) -> Frame {
    let top = self.length
    let mut resumePc: usize = 0
    let mut resumePosition: usize = 0
    while true {
      let next = self.length
      let linkIndex = self.base - 1
      let frame = Machine.popFrame(&mut self)

      // Replace discarded frame links with endpoints of their undo-log spans.
      Machine.setWord(&mut self, linkIndex, usize.wrappingToI64(next))
      if frame.kind == STATE_LOOKAHEAD {
        resumePc = frame.pc
        resumePosition = frame.position
        break
      }
    }
    if self.length != 0 {
      let mut source = self.length
      let mut target = source
      while source < top {
        let next = i64.wrappingToUsize(Machine.word(&self, source + 2))
        source = source + 3
        while source < next {
          let value = Machine.word(&self, source)
          Machine.setWord(&mut self, target, value)
          target = target + 1
          source = source + 1
        }
      }
      self.length = target
    }
    return Frame { pc: resumePc, position: resumePosition, kind: STATE_LOOKAHEAD }
  }

  @inlineAlways
  fn finishNegative(self: &mut Self) -> () {
    while true {
      Machine.undo(&mut self)
      let frame = Machine.popFrame(&mut self)
      if frame.kind == STATE_NEGATIVE_LOOKAHEAD {
        return
      }
    }
  }
}

// Valid bytecode keeps every jump target inside the program.
@inlineAlways
fn branch(base: usize, displacement: u32) -> usize {
  if displacement < 0x80000000 {
    return usize.wrappingAdd(base, u32.toUsize(displacement))
  }
  return usize.wrappingSubtract(base, u32.toUsize(0xffffffff - displacement) + 1)
}

fn isLineTerminator(code: u32) -> bool {
  return code == 0x0a || code == 0x0d || code == 0x2028 || code == 0x2029
}

fn isWord(code: u32, ignoreCase: bool) -> bool {
  if code < 256 {
    return UnicodeCase.isWordByte(code)
  }
  return ignoreCase && (code == 0x017f || code == 0x212a)
}

fn rangeContains(bytecode: &[u8], offset: usize, count: usize, code: u32, wide: bool) -> bool {
  if count == 0 {
    return false
  }
  let mut stride: usize = 4
  if wide {
    stride = 8
  }
  if offset > bytecode.length || (bytecode.length - offset) / stride < count {
    Intrinsic.trap("QuickJS invariant violated")
  }

  // The whole table is in bounds, so the search reads it without per-entry checks.
  let table = unsafe Pointer.at<u8>(
    unsafe Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(Pointer.fromSlice<u8>(bytecode)),
    offset,
  )
  let many = unsafe Pointer.assumeMany<u8>(table)
  if !wide && code >= 0xffff && unsafe rangeU16(many, (count - 1) * 4 + 2) == 0xffff {
    return true
  }

  // A Latin-1 unit is decided by the table's first few ranges (they are sorted),
  // so a forward scan beats the binary search's longer steps.
  if !wide && code < 256 {
    let mut i: usize = 0
    while i < count {
      if code < u16.toU32(unsafe rangeU16(many, i * 4)) {
        return false
      }
      if code <= u16.toU32(unsafe rangeU16(many, i * 4 + 2)) {
        return true
      }
      i = i + 1
    }
    return false
  }
  let mut low: usize = 0
  let mut high = count
  while low < high {
    let middle = low + (high - low) / 2
    let mut first: u32 = 0
    let mut last: u32 = 0
    if wide {
      first = unsafe rangeU32(many, middle * 8)
      last = unsafe rangeU32(many, middle * 8 + 4)
    } else {
      first = u16.toU32(unsafe rangeU16(many, middle * 4))
      last = u16.toU32(unsafe rangeU16(many, middle * 4 + 2))
    }
    if code < first {
      high = middle
    } else if code > last {
      low = middle + 1
    } else {
      return true
    }
  }
  return false
}

// Valid compiler bytecode is a precondition of every exec, and the RegExp
// bytecode never comes from outside the compiler, so the VM reads opcodes and
// operands through an unchecked pointer instead of bounds-checking each one.
@inlineAlways
fn opcodes(bytecode: &[u8]) -> [*]const u8 {
  unsafe {
    return Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(Pointer.fromSlice<u8>(bytecode))
  }
}

@inlineAlways
unsafe fn op8(table: [*]const u8, index: usize) -> u8 {
  return unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(table, index))
}

@inlineAlways
unsafe fn rangeU16(table: [*]const u8, index: usize) -> u16 {
  let at = unsafe Intrinsic.pointerReinterpret<*const u8, *const align (1) u16>(
    unsafe Pointer.at<u8>(table, index),
  )
  return unsafe Pointer.readUnaligned<u16>(at)
}

@inlineAlways
unsafe fn rangeU32(table: [*]const u8, index: usize) -> u32 {
  let at = unsafe Intrinsic.pointerReinterpret<*const u8, *const align (1) u32>(
    unsafe Pointer.at<u8>(table, index),
  )
  return unsafe Pointer.readUnaligned<u32>(at)
}

struct Advance {
  position: usize,
  failed: bool
}

@inlineAlways
fn consume<U: Units>(input: &ExecInput<U>, position: usize, fold: bool) -> Character {
  let character = stepForward(input, position, input.length)
  if fold {
    return Character { code: foldCode(character.code, input.unicode), position: character.position }
  }
  return move character
}

/// UnicodeCase.canonicalize with its ASCII case inline.
@inlineAlways
fn foldCode(c: u32, unicode: bool) -> u32 {
  if c >= 128 {
    return UnicodeCase.canonicalize(c, unicode)
  }
  if unicode {
    if c >= 0x41 && c <= 0x5a {
      return c + 0x20
    }
  } else if c >= 0x61 && c <= 0x7a {
    return c - 0x20
  }
  return c
}

@inlineAlways
fn literal<U: Units>(input: &ExecInput<U>, position: usize, value: u32, fold: bool) -> Advance {
  if position >= input.length {
    return Advance { position: position, failed: true }
  }
  let character = consume(input, position, fold)
  return Advance { position: character.position, failed: value != character.code }
}

@inlineAlways
fn classRange<U: Units>(
  bytecode: &[u8],
  pc: usize,
  count: usize,
  input: &ExecInput<U>,
  position: usize,
  wide: bool,
  fold: bool,
) -> Advance {
  if position >= input.length {
    return Advance { position: position, failed: true }
  }
  let character = consume(input, position, fold)
  return Advance {
    position: character.position,
    failed: !rangeContains(bytecode, pc, count, character.code, wide),
  }
}

/// Whether the REOP_CLASS(_I) class whose count-range table is at table holds
/// code: by its bitmap for a Latin-1 unit (already folded for REOP_CLASS_I),
/// else by the table, folding first when fold.
@inlineAlways
fn classHas(
  bytecode: &[u8],
  ops: [*]const u8,
  table: usize,
  count: usize,
  code: u32,
  fold: bool,
  unicode: bool,
) -> bool {
  if code <= 255 {
    return (u32.shiftRight(
      u8.toU32(unsafe op8(ops, table + count * 4 + u32.toUsize(u32.shiftRight(code, 3)))),
      code & 7,
    )
      & 1)
      != 0
  }
  if fold {
    return rangeContains(bytecode, table, count, foldCode(code, unicode), false)
  }
  return rangeContains(bytecode, table, count, code, false)
}

@inlineAlways
fn atWordBoundary<U: Units>(input: &ExecInput<U>, position: usize, ignoreCase: bool) -> bool {
  let mut before = false
  let mut after = false
  if position != 0 {
    before = isWord(stepBackward(input, position, 0).code, ignoreCase)
  }
  if position < input.length {
    after = isWord(stepForward(input, position, input.length).code, ignoreCase)
  }
  return before != after
}

fn backReference<U: Units>(
  bytecode: &[u8],
  candidates: usize,
  count: usize,
  registers: ?*mut i64,
  captureCount: usize,
  input: &ExecInput<U>,
  start: usize,
  backward: bool,
  ignoreCase: bool,
) -> Advance {
  let ops = opcodes(bytecode)
  let mut position = start
  let mut candidate: usize = 0
  while candidate < count {
    let capture = u8.toUsize(unsafe op8(ops, candidates + candidate))
    if capture >= captureCount {
      return Advance { position: position, failed: true }
    }
    let savedStart = registerAt(registers, capture * 2)
    let savedEnd = registerAt(registers, capture * 2 + 1)
    if savedStart >= 0 && savedEnd >= 0 {
      let captureStart = i64.toUsize(savedStart)
      let captureEnd = i64.toUsize(savedEnd)
      let mut cursor = captureStart
      if backward {
        cursor = captureEnd
      }
      while (!backward && cursor < captureEnd) || (backward && cursor > captureStart) {
        if (!backward && position >= input.length) || (backward && position == 0) {
          return Advance { position: position, failed: true }
        }
        let mut first: u32 = 0
        let mut second: u32 = 0
        if backward {
          let a = stepBackward(input, cursor, captureStart)
          let b = stepBackward(input, position, 0)
          cursor = a.position
          position = b.position
          first = a.code
          second = b.code
        } else {
          let a = stepForward(input, cursor, captureEnd)
          let b = stepForward(input, position, input.length)
          cursor = a.position
          position = b.position
          first = a.code
          second = b.code
        }
        if ignoreCase {
          first = foldCode(first, input.unicode)
          second = foldCode(second, input.unicode)
        }
        if first != second {
          return Advance { position: position, failed: true }
        }
      }
      return Advance { position: position, failed: false }
    }
    candidate = candidate + 1
  }
  return Advance { position: position, failed: false }
}

struct Jump {
  pc: usize,
  failed: bool,
  poll: bool
}

/// The four loop_*split opcodes; `pc` points at their register operand.
@inlineAlways
effect fn loopSplit(
  machine: &mut Machine,
  bytecode: &[u8],
  pc: usize,
  registerBase: usize,
  position: usize,
  checkAdvance: bool,
  gotoFirst: bool,
) -> Jump
  ! OutOfMemoryError
  ? &mut Allocator {
  let ops = opcodes(bytecode)
  let index = registerBase + u8.toUsize(unsafe op8(ops, pc))
  let limit = unsafe rangeU32(ops, pc + 1)
  let displacement = unsafe rangeU32(ops, pc + 5)
  let next = pc + 9
  let counter = u32.wrappingSubtract(i64.toU32(Machine.register(&machine, index)), 1)
  run Machine.save(&mut machine, index, u32.toI64(counter), true)
  if counter > limit {
    return Jump { pc: branch(next, displacement), failed: false, poll: true }
  }
  if checkAdvance && Machine.register(&machine, index + 1) == usize.wrappingToI64(position)
    && counter != limit {
    return Jump { pc: next, failed: true, poll: false }
  }
  if counter == 0 {
    return Jump { pc: next, failed: false, poll: false }
  }
  if gotoFirst {
    run Machine.pushFrame(&mut machine, next, position, STATE_SPLIT)
    return Jump { pc: branch(next, displacement), failed: false, poll: false }
  }
  run Machine.pushFrame(&mut machine, branch(next, displacement), position, STATE_SPLIT)
  return Jump { pc: next, failed: false, poll: false }
}

struct RegExpExecutor {}

impl RegExpExecutor {
  /// Executes compiler bytecode against Latin-1 code units, starting at `start`.
  effect fn execute8<'env>(
    bytecode: &[u8],
    input: &[u8],
    start: usize,
    mut interrupted: for<use 'call> mut fn<'env>() -> once Effect<
      'call & 'env; bool
      ? &mut Allocator
    >,
  ) -> RegExpMatch
    ! OutOfMemoryError | RegExpTimeout
    ? &mut Allocator {
    let mut captures = Captures.empty()
    let matched = run RegExpExecutor.match8(bytecode, input, start, move interrupted, &mut captures)
    if !matched {
      return RegExpMatch { matched: false, captures: Captures.empty() }
    }
    return RegExpMatch { matched: true, captures: move captures }
  }

  /// Executes against UTF-16; captures always count code units, including in u/v modes.
  effect fn execute16<'env>(
    bytecode: &[u8],
    input: &[u16],
    start: usize,
    mut interrupted: for<use 'call> mut fn<'env>() -> once Effect<
      'call & 'env; bool
      ? &mut Allocator
    >,
  ) -> RegExpMatch
    ! OutOfMemoryError | RegExpTimeout
    ? &mut Allocator {
    let mut captures = Captures.empty()
    let matched = run RegExpExecutor.match16(
      bytecode,
      input,
      start,
      move interrupted,
      &mut captures,
    )
    if !matched {
      return RegExpMatch { matched: false, captures: Captures.empty() }
    }
    return RegExpMatch { matched: true, captures: move captures }
  }

  /// execute8 that writes a match's offsets into out (left as it was without a
  /// match) and returns whether there was one, so no match record is copied.
  @inlineAlways
  effect fn match8<'env>(
    bytecode: &[u8],
    input: &[u8],
    start: usize,
    mut interrupted: for<use 'call> mut fn<'env>() -> once Effect<
      'call & 'env; bool
      ? &mut Allocator
    >,
    out: &mut Captures,
  ) -> bool
    ! OutOfMemoryError | RegExpTimeout
    ? &mut Allocator {
    let flags = u16.toU32(readU16(bytecode, RE_HEADER_FLAGS))
    let view = ExecInput<Narrow> {
      units: Narrow { bytes: Pointer.fromSlice<u8>(input) },
      unicode: (flags & (FLAG_UNICODE | FLAG_UNICODE_SETS)) != 0,
      length: input.length,
    }
    return run execute(bytecode, &view, start, move interrupted, &mut out)
  }

  /// The unit count of a program whose whole match is one run of Latin-1 units
  /// (HINT_LITERAL with HINT_RUN_BYTES), else 0. findLiteral8 then finds its
  /// matches in Latin-1 input without the matcher.
  fn literalCount(bytecode: &[u8]) -> usize {
    let at = literalHint(bytecode)
    if at == 0 {
      return 0
    }
    return u16.toUsize(readU16(bytecode, at + 4)) & 255
  }

  /// The first position at or after start where a literalCount program matches
  /// Latin-1 input, or -1.
  fn findLiteral8(bytecode: &[u8], input: &[u8], start: usize) -> i64 {
    let hint = literalHint(bytecode)
    if hint == 0 {
      Intrinsic.trap("findLiteral8 needs a literal program")
    }
    let packed = u16.toUsize(readU16(bytecode, hint + 4))
    let count = packed & 255
    let view = ExecInput<Narrow> {
      units: Narrow { bytes: Pointer.fromSlice<u8>(input) },
      unicode: false,
      length: input.length,
    }
    return literalSearch(
      opcodes(bytecode),
      u16.toUsize(readU16(bytecode, hint + 2)),
      count,
      packed / 256,
      hint - count,
      false,
      &view,
      start,
    )
  }

  /// execute16 in match8's form.
  @inlineAlways
  effect fn match16<'env>(
    bytecode: &[u8],
    input: &[u16],
    start: usize,
    mut interrupted: for<use 'call> mut fn<'env>() -> once Effect<
      'call & 'env; bool
      ? &mut Allocator
    >,
    out: &mut Captures,
  ) -> bool
    ! OutOfMemoryError | RegExpTimeout
    ? &mut Allocator {
    let flags = u16.toU32(readU16(bytecode, RE_HEADER_FLAGS))
    let view = ExecInput<Wide> {
      units: Wide { words: Pointer.fromSlice<u16>(input) },
      unicode: (flags & (FLAG_UNICODE | FLAG_UNICODE_SETS)) != 0,
      length: input.length,
    }
    return run execute(bytecode, &view, start, move interrupted, &mut out)
  }
}

/// The trailer offset of a literalCount program's hint, else 0.
fn literalHint(bytecode: &[u8]) -> usize {
  if bytecode.length <= RE_HEADER_LEN {
    return 0
  }
  if (u16.toU32(readU16(bytecode, RE_HEADER_FLAGS)) & FLAG_HINT) == 0 {
    return 0
  }
  let hint = RE_HEADER_LEN + u32.toUsize(readU32(bytecode, RE_HEADER_BYTECODE_LEN)) - HINT_LENGTH
  let kindByte = bytecode[hint + 1]
  if u8.bitAnd(kindByte, 31) != HINT_LITERAL || u8.bitAnd(kindByte, HINT_RUN_BYTES) == 0 {
    return 0
  }
  return hint
}

/// The first position from position on where the step at first (opcode op, a
/// search's first consuming step) can match, or the input's end; every
/// character is one unit.
@inlineNever
fn skipAhead<U: Units>(
  bytecode: &[u8],
  first: usize,
  op: u8,
  input: &ExecInput<U>,
  position: usize,
) -> usize {
  let ops = opcodes(bytecode)
  let mut at = position
  if op == REOP_line_start {
    return input.length
  }
  if op == REOP_char {
    return input.units.findUnit(u16.toU32(unsafe rangeU16(ops, first + 1)), at, input.length)
  }
  if op == REOP_space {
    while at < input.length && !UnicodeCase.isSpace(unitAt(input, at)) {
      at = usize.wrappingAdd(at, 1)
    }
    return at
  }
  if op == REOP_not_space {
    while at < input.length && UnicodeCase.isSpace(unitAt(input, at)) {
      at = usize.wrappingAdd(at, 1)
    }
    return at
  }
  if op == REOP_char_i {
    let unit = u16.toU32(unsafe rangeU16(ops, first + 1))
    while at < input.length && literal(input, at, unit, true).failed {
      at = usize.wrappingAdd(at, 1)
    }
    return at
  }
  let count = u16.toUsize(unsafe rangeU16(ops, first + 1))
  if op == REOP_CLASS || op == REOP_CLASS_I {
    let fold = op == REOP_CLASS_I
    while at < input.length
      && !classHas(bytecode, ops, first + 3, count, unitAt(input, at), fold, input.unicode) {
      at = usize.wrappingAdd(at, 1)
    }
    return at
  }
  if op == REOP_range {
    let bits = latinClass(ops, first + 3, count)
    while at < input.length && !inClass(&bits, bytecode, first + 3, count, input, at) {
      at = usize.wrappingAdd(at, 1)
    }
    return at
  }
  let wide = op == REOP_range32 || op == REOP_range32_i
  let ignoreCase = op == REOP_range_i || op == REOP_range32_i
  while at < input.length
    && classRange(bytecode, first + 3, count, input, at, wide, ignoreCase).failed {
    at = usize.wrappingAdd(at, 1)
  }
  return at
}

/// The Latin-1 members of the count-range REOP_range table at table, one bit
/// per code unit.
@inlineAlways
fn latinClass(ops: [*]const u8, table: usize, count: usize) -> [u64; 4] {
  let mut bits: [u64; 4] = [0; 4]
  let mut i: usize = 0
  while i < count {
    let low = u16.toUsize(unsafe rangeU16(ops, table + i * 4))
    if low > 255 {
      break
    }
    let mut high = u16.toUsize(unsafe rangeU16(ops, table + i * 4 + 2))
    if high > 255 {
      high = 255
    }

    // Bits from..to of a word are 2^(to+1) - 2^from (mod 2^64); rotating 1
    // never traps, unlike a shift, so the mask needs no range checks.
    let mut word = low / 64
    let last = high / 64
    while word <= last {
      let mut from: usize = 0
      if word == low / 64 {
        from = low & 63
      }
      let mut to: usize = 63
      if word == last {
        to = high & 63
      }
      let top = u64.rotateLeft(1, usize.toU64(to))
      bits[word] = u64.bitOr(
        bits[word],
        u64.wrappingAdd(u64.wrappingSubtract(top, u64.rotateLeft(1, usize.toU64(from))), top),
      )
      word = word + 1
    }
    i = i + 1
  }
  return bits
}

@inlineAlways
fn inClass<U: Units>(
  bits: &[u64; 4],
  bytecode: &[u8],
  table: usize,
  count: usize,
  input: &ExecInput<U>,
  position: usize,
) -> bool {
  let code = unitAt(input, position)
  if code <= 255 {
    return u64.bitAnd(u64.shiftRight(bits[u32.toUsize(code / 64)], u32.toU64(code & 63)), 1) != 0
  }
  return rangeContains(bytecode, table, count, code, false)
}

/// The first position from position on whose unit is above 255 or in the
/// compiler's first-unit bitmap at setAt (HINT_FIRST_SET), or the input's end.
@inlineNever
fn skipToSet<U: Units>(
  ops: [*]const u8,
  setAt: usize,
  input: &ExecInput<U>,
  position: usize,
) -> usize {
  let mut bits: [u64; 4] = [0; 4]
  let mut word: usize = 0
  while word < 4 {
    bits[word] = unsafe Pointer.readUnaligned<u64>(
      unsafe Intrinsic.pointerReinterpret<*const u8, *const align (1) u64>(
        unsafe Pointer.at<u8>(ops, setAt + word * 8),
      ),
    )
    word = word + 1
  }

  // A set of at most three units (a letter's two cases, say) is searched for
  // sixteen units at a time.
  let members = u32.toUsize(u64.countOnes(bits[0])) + u32.toUsize(u64.countOnes(bits[1]))
    + u32.toUsize(u64.countOnes(bits[2]))
    + u32.toUsize(u64.countOnes(bits[3]))
  if members >= 1 && members <= 3 {
    let mut units: [u32; 3] = [0; 3]
    let mut found: usize = 0
    word = 0
    while word < 4 {
      let mut rest = bits[word]
      while rest != 0 {
        units[found] = usize.toU32(word * 64 + u32.toUsize(u64.trailingZeros(rest)))
        found = found + 1
        rest = u64.bitAnd(rest, u64.wrappingSubtract(rest, 1))
      }
      word = word + 1
    }
    if found < 2 {
      units[1] = units[0]
    }
    if found < 3 {
      units[2] = units[0]
    }
    return input.units.findAny(units[0], units[1], units[2], position, input.length)
  }
  let mut at = position
  while at < input.length {
    let code = unitAt(input, at)
    if code > 255
      || u64.bitAnd(u64.shiftRight(bits[u32.toUsize(code / 64)], u32.toU64(code & 63)), 1) != 0 {
      return at
    }
    at = usize.wrappingAdd(at, 1)
  }
  return at
}

/// The position after matching the one-character step at at (see regexp_compile's
/// starStep) as
/// many times as it matches from position on.
@inlineNever
fn greedyRun<U: Units>(
  bytecode: &[u8],
  ops: [*]const u8,
  at: usize,
  input: &ExecInput<U>,
  position: usize,
) -> usize {
  let opcode = unsafe op8(ops, at)
  let mut end = position
  if opcode == REOP_char {
    let unit = u16.toU32(unsafe rangeU16(ops, at + 1))
    while end < input.length && unitAt(input, end) == unit {
      end = usize.wrappingAdd(end, 1)
    }
  } else if opcode == REOP_char_i {
    let unit = u16.toU32(unsafe rangeU16(ops, at + 1))
    while !literal(input, end, unit, true).failed {
      end = usize.wrappingAdd(end, 1)
    }
  } else if opcode == REOP_dot {
    while end < input.length && !isLineTerminator(unitAt(input, end)) {
      end = usize.wrappingAdd(end, 1)
    }
  } else if opcode == REOP_any {
    end = input.length
  } else if opcode == REOP_space {
    while end < input.length && UnicodeCase.isSpace(unitAt(input, end)) {
      end = usize.wrappingAdd(end, 1)
    }
  } else if opcode == REOP_not_space {
    while end < input.length && !UnicodeCase.isSpace(unitAt(input, end)) {
      end = usize.wrappingAdd(end, 1)
    }
  } else if opcode == REOP_CLASS || opcode == REOP_CLASS_I {
    let count = u16.toUsize(unsafe rangeU16(ops, at + 1))
    let fold = opcode == REOP_CLASS_I
    while end < input.length
      && classHas(bytecode, ops, at + 3, count, unitAt(input, end), fold, input.unicode) {
      end = usize.wrappingAdd(end, 1)
    }
  } else if opcode == REOP_range {
    let count = u16.toUsize(unsafe rangeU16(ops, at + 1))
    let bits = latinClass(ops, at + 3, count)
    while end < input.length && inClass(&bits, bytecode, at + 3, count, input, end) {
      end = usize.wrappingAdd(end, 1)
    }
  } else {
    let count = u16.toUsize(unsafe rangeU16(ops, at + 1))
    let wide = opcode == REOP_range32 || opcode == REOP_range32_i
    let fold = opcode == REOP_range_i || opcode == REOP_range32_i
    while !classRange(bytecode, at + 3, count, input, end, wide, fold).failed {
      end = usize.wrappingAdd(end, 1)
    }
  }
  return end
}

/// The first position at or after start where the count REOP_char steps from
/// first match, or -1; every character is one unit.
fn literalSearch<U: Units>(
  ops: [*]const u8,
  first: usize,
  count: usize,
  pivotAt: usize,
  runAt: usize,
  runUnits: bool,
  input: &ExecInput<U>,
  start: usize,
) -> i64 {
  if count > input.length {
    return -1
  }

  // Candidates start at or below last.
  let last = input.length - count
  if start > last {
    return -1
  }

  // One unit (a separator such as `=`): the scan alone. Positions stay below
  // the input's length, so the wrapping adds never wrap.
  if count == 1 {
    let hit = input.units.findUnit(
      u16.toU32(unsafe rangeU16(ops, usize.wrappingAdd(first, 1))),
      start,
      input.length,
    )
    if hit >= input.length {
      return -1
    }
    return usize.toI64(hit)
  }

  // Over a long input the scan looks for the literal's least common unit (the
  // compiler's pivot), so that a frequent first unit (a quote in JSON, say)
  // stops it less often.
  let mut pivot: usize = 0
  if last - start >= 64 {
    pivot = pivotAt
  }
  let unit = u16.toU32(unsafe rangeU16(ops, first + pivot * 3 + 1))
  let mut at = start
  while at <= last {
    // Up to the input's end, so the vector scan covers the whole tail.
    let hit = input.units.findUnit(unit, at + pivot, input.length)
    if hit > last + pivot {
      return -1
    }
    at = hit - pivot

    // The run's bytes (HINT_RUN_BYTES) compare a word at a time.
    if runUnits {
      if input.units.equalsUnits(
        at,
        unsafe Pointer.assumeMany<u8>(unsafe Pointer.at<u8>(ops, runAt)),
        count,
      ) {
        return usize.toI64(at)
      }
    } else if runAt != usize.MAX {
      if input.units.equalsBytes(
        at,
        unsafe Pointer.assumeMany<u8>(unsafe Pointer.at<u8>(ops, runAt)),
        count,
      ) {
        return usize.toI64(at)
      }
    } else {
      let mut k: usize = 0
      while k < count
        && unitAt(input, usize.wrappingAdd(at, k))
          == u16.toU32(unsafe rangeU16(ops, first + k * 3 + 1)) {
        k = k + 1
      }
      if k == count {
        return usize.toI64(at)
      }
    }
    at = usize.wrappingAdd(at, 1)
  }
  return -1
}

/// Whether a whole-pattern literal search found position (not -1), with its
/// offsets in out.
fn literalMatch(position: i64, count: usize, out: &mut Captures) -> bool {
  if position < 0 {
    return false
  }
  let slots = out.placeInline(2)
  slots[0] = i64.toI32(position)
  slots[1] = i64.toI32(position + usize.toI64(count))
  return true
}

effect fn execute<U: Units, 'env>(
  bytecode: &[u8],
  input: &ExecInput<U>,
  start: usize,
  mut interrupted: for<use 'call> mut fn<'env>() -> once Effect<
    'call & 'env; bool
    ? &mut Allocator
  >,
  out: &mut Captures,
) -> bool
  ! OutOfMemoryError | RegExpTimeout
  ? &mut Allocator {
  if bytecode.length <= RE_HEADER_LEN {
    Intrinsic.trap("QuickJS invariant violated")
  }
  let ops = opcodes(bytecode)

  // The compiler's search hint (FLAG_HINT).
  let mut startPc = RE_HEADER_LEN

  // The first-unit bitmap's offset (HINT_FIRST_SET), when there is one.
  let mut setAt = usize.MAX
  let mut planFirst: usize = 0
  let mut planOp: u8 = 0
  if (u16.toU32(unsafe rangeU16(ops, RE_HEADER_FLAGS)) & FLAG_HINT) != 0 {
    let hint = RE_HEADER_LEN + u32.toUsize(unsafe rangeU32(ops, RE_HEADER_BYTECODE_LEN))
      - HINT_LENGTH
    let kindByte = unsafe op8(ops, hint + 1)
    planFirst = u16.toUsize(unsafe rangeU16(ops, hint + 6))
    planOp = unsafe op8(ops, hint + 8)
    let kind = u8.bitAnd(kindByte, 31)
    if u8.bitAnd(kindByte, HINT_FIRST_SET) != 0 {
      setAt = hint - HINT_SET_LENGTH
    }
    if kind == HINT_ANCHORED {
      // Only position 0 can match (a u/v-mode start inside a surrogate pair
      // moves back to the pair, so that case takes the search). From 0 the
      // search prefix would only retry later positions.
      if start == 0 {
        startPc = RE_HEADER_LEN + 11
      } else if !(input.units.holdsWords() && input.unicode) {
        return false
      }
    } else if (kind == HINT_LITERAL || kind == HINT_REQUIRED)
      && !(input.units.holdsWords() && input.unicode) {
      // A run of REOP_char steps, each one unit here.
      let literalAt = u16.toUsize(unsafe rangeU16(ops, hint + 2))

      // The count's high byte is the pivot (see FLAG_HINT).
      let packed = u16.toUsize(unsafe rangeU16(ops, hint + 4))
      let literalCount = packed & 255

      // The run's bytes sit before the bitmap, or before the trailer without one.
      let mut runAt = usize.MAX
      let mut runWidth: usize = 0
      if u8.bitAnd(kindByte, HINT_RUN_BYTES) != 0 {
        runWidth = 1
      } else if u8.bitAnd(kindByte, HINT_RUN_UNITS) != 0 {
        runWidth = 2
      }
      if runWidth != 0 {
        runAt = hint - literalCount * runWidth
        if setAt != usize.MAX {
          runAt = setAt - literalCount * runWidth
        }
      }
      let found = literalSearch(
        ops,
        literalAt,
        literalCount,
        packed / 256,
        runAt,
        runWidth == 2,
        input,
        start,
      )
      if found < 0 || kind == HINT_LITERAL {
        return literalMatch(found, literalCount, &mut out)
      }
    }
  }
  let base = RE_HEADER_LEN
  let mut first = base + 13
  let mut skipPc = usize.MAX
  let mut skipOp: u8 = 0

  // A search (no sticky flag) starts with the compiler's `[\s\S]*?` prefix:
  // split_goto_first, any, goto, then save_start 0. When every character is
  // one unit and the pattern starts with a literal, a class or `^`, the
  // prefix's any (whose operand ends at skipPc) moves straight to the next
  // position where that first step can match: the pattern fails at every
  // position in between. The compiler found that step (FLAG_HINT's
  // plan); without one, the compiler's set of first units serves, as skipOp 0.
  if planFirst != 0 && !(input.units.holdsWords() && input.unicode) {
    if planOp != 0 {
      first = planFirst
      skipOp = planOp
      skipPc = base + 6
    } else if setAt != usize.MAX {
      skipPc = base + 6
    }
  }

  // The bitmap is cheaper to test than a class's ranges or \s; a literal's
  // word-at-a-time search is cheaper still.
  let viaSet = skipPc != usize.MAX && setAt != usize.MAX && skipOp != REOP_char
    && skipOp != REOP_line_start
  let mut position = start

  // A first step that is a character or class must match where the match
  // starts, so the search can start at the first position where it can, and
  // fails without running when there is none.
  if skipPc != usize.MAX && skipOp != 0 && skipOp != REOP_line_start {
    if viaSet {
      position = skipToSet(ops, setAt, input, start)
    } else {
      position = skipAhead(bytecode, first, skipOp, input, start)
    }
    if position >= input.length {
      return false
    }
  }
  let captureCount = u8.toUsize(unsafe op8(ops, RE_HEADER_CAPTURE_COUNT))
  let registerBase = captureCount * 2

  // Every character is one unit: greedy one-character loops run in place.
  let oneUnit = !(input.units.holdsWords() && input.unicode)
  let liveRegisters = registerBase + u8.toUsize(unsafe op8(ops, RE_HEADER_REGISTER_COUNT))
  let undo = unsafe Intrinsic.pointerRequalify<[*]mut i64, *mut i64>(
    unsafe Intrinsic.stackAllocate<i64>(UNDO_INLINE),
  )
  let registers = unsafe Intrinsic.pointerRequalify<[*]mut i64, *mut i64>(
    unsafe Intrinsic.stackAllocate<i64>(32),
  )
  let mut storage = Storage {
    inlineWords: undo,
    heap: List<i64>.make(),
    inlineValues: registers,
    spill: List<i64>.make(),
  }
  let mut machine = run Machine.make(&mut storage, liveRegisters)
  let mut pc = startPc
  let mut interruptCounter = INTERRUPT_COUNTER_INIT
  if input.units.holdsWords() && input.unicode && position > 0 && position < input.length {
    if isLowSurrogate(unitAt(input, position)) && isHighSurrogate(unitAt(input, position - 1)) {
      position = position - 1
    }
  }
  while true {
    let opcode = unsafe op8(ops, pc)
    pc = usize.wrappingAdd(pc, 1)
    let mut failed = false
    let mut poll = false

    // Every opcode gets its own arm so LLVM lowers the dispatch to one jump table;
    // the mask (opcodes are below 64) lets every index have an arm, so the table
    // needs no range check.
    match u8.bitAnd(opcode, 63) {
      16 => { // REOP_match
        if registerBase <= INLINE_CAPTURES {
          // Offsets fit in i32: inputs are shorter than 2^30 units.
          let slots = out.placeInline(registerBase)
          let mut slot: usize = 0
          while slot < registerBase {
            slots[slot] = u64.wrappingToI32(i64.wrappingToU64(Machine.register(&machine, slot)))
            slot = slot + 1
          }
          return true
        }
        let mut spill = List<i32>.make()
        run spill.reserveExact(registerBase)
        let mut index: usize = 0
        while index < registerBase {
          run spill.append(u64.wrappingToI32(i64.wrappingToU64(Machine.register(&machine, index))))
          index = index + 1
        }
        let previous = Intrinsic.replace(out.*, Captures.fromSpill(move spill))
        drop previous
        return true
      }
      17 => { // REOP_lookahead_match
        let frame = Machine.finishPositive(&mut machine)
        pc = frame.pc
        position = frame.position
      }
      18 => { // REOP_negative_lookahead_match
        Machine.finishNegative(&mut machine)
        failed = true
      }
      1 => { // REOP_char
        if input.units.holdsWords() && input.unicode {
          let step = literal(input, position, u16.toU32(unsafe rangeU16(ops, pc)), false)
          pc = usize.wrappingAdd(pc, 2)
          position = step.position
          failed = step.failed
        } else {
          // One code unit per character: match a run of REOP_char in one go.
          while true {
            if position >= input.length
              || unitAt(input, position) != u16.toU32(unsafe rangeU16(ops, pc)) {
              failed = true
              break
            }
            position = usize.wrappingAdd(position, 1)
            pc = usize.wrappingAdd(pc, 2)
            if unsafe op8(ops, pc) != 1 {
              break
            }
            pc = usize.wrappingAdd(pc, 1)
          }
        }
      }
      2 => { // REOP_char_i
        let step = literal(input, position, u16.toU32(unsafe rangeU16(ops, pc)), true)
        pc = usize.wrappingAdd(pc, 2)
        position = step.position
        failed = step.failed
      }
      3 => { // REOP_char32
        let step = literal(input, position, unsafe rangeU32(ops, pc), false)
        pc = usize.wrappingAdd(pc, 4)
        position = step.position
        failed = step.failed
      }
      4 => { // REOP_char32_i
        let step = literal(input, position, unsafe rangeU32(ops, pc), true)
        pc = usize.wrappingAdd(pc, 4)
        position = step.position
        failed = step.failed
      }
      14 => { // REOP_split_goto_first
        run Machine.pushFrame(&mut machine, pc + 4, position, STATE_SPLIT)
        pc = branch(pc + 4, unsafe rangeU32(ops, pc))
      }
      15 => { // REOP_split_next_first
        pc = usize.wrappingAdd(pc, 4)
        run Machine.pushFrame(
          &mut machine,
          branch(pc, unsafe rangeU32(ops, pc - 4)),
          position,
          STATE_SPLIT,
        )
      }
      49 => { // REOP_PLUS: the greedy x+ loop's back edge right after x
        let target = branch(pc + 4, unsafe rangeU32(ops, pc))
        if oneUnit {
          let end = greedyRun(bytecode, ops, target, input, position)
          if end > position {
            run Machine.pushStar(&mut machine, pc + 4, position, end - 1)
          }
          pc = pc + 4
          position = end
        } else {
          run Machine.pushFrame(&mut machine, pc + 4, position, STATE_SPLIT)
          pc = target
        }
      }
      48 => { // REOP_STAR: a greedy x* loop, split, x, goto back
        pc = usize.wrappingAdd(pc, 4)
        let exit = branch(pc, unsafe rangeU32(ops, pc - 4))
        if oneUnit {
          let end = greedyRun(bytecode, ops, pc, input, position)
          if end > position {
            run Machine.pushStar(&mut machine, exit, position, end - 1)
          }
          pc = exit
          position = end
        } else {
          run Machine.pushFrame(&mut machine, exit, position, STATE_SPLIT)
        }
      }
      40 => { // REOP_lookahead
        pc = usize.wrappingAdd(pc, 4)
        run Machine.pushFrame(
          &mut machine,
          branch(pc, unsafe rangeU32(ops, pc - 4)),
          position,
          STATE_LOOKAHEAD,
        )
      }
      41 => { // REOP_negative_lookahead
        pc = usize.wrappingAdd(pc, 4)
        run Machine.pushFrame(
          &mut machine,
          branch(pc, unsafe rangeU32(ops, pc - 4)),
          position,
          STATE_NEGATIVE_LOOKAHEAD,
        )
      }
      13 => { // REOP_goto
        pc = branch(pc + 4, unsafe rangeU32(ops, pc))
        poll = true
      }
      9 => {
        failed = position != 0
      } // REOP_line_start
      10 => { // REOP_line_start_m
        if position != 0 {
          failed = !isLineTerminator(stepBackward(input, position, 0).code)
        }
      }
      11 => {
        failed = position != input.length
      } // REOP_line_end
      12 => { // REOP_line_end_m
        if position != input.length {
          failed = !isLineTerminator(stepForward(input, position, input.length).code)
        }
      }
      5 => { // REOP_dot
        if position == input.length {
          failed = true
        } else {
          let character = stepForward(input, position, input.length)
          position = character.position
          failed = isLineTerminator(character.code)
        }
      }
      6 => { // REOP_any
        if position == input.length {
          failed = true
        } else if pc == skipPc {
          if viaSet {
            position = skipToSet(ops, setAt, input, usize.wrappingAdd(position, 1))
          } else {
            position = skipAhead(bytecode, first, skipOp, input, usize.wrappingAdd(position, 1))
          }
        } else {
          position = stepForward(input, position, input.length).position
        }
      }
      7 => { // REOP_space
        if position == input.length {
          failed = true
        } else {
          let character = stepForward(input, position, input.length)
          position = character.position
          failed = !UnicodeCase.isSpace(character.code)
        }
      }
      8 => { // REOP_not_space
        if position == input.length {
          failed = true
        } else {
          let character = stepForward(input, position, input.length)
          position = character.position
          failed = UnicodeCase.isSpace(character.code)
        }
      }
      19 => { // REOP_save_start
        let index = u8.toUsize(unsafe op8(ops, pc)) * 2
        pc = usize.wrappingAdd(pc, 1)
        run Machine.save(&mut machine, index, usize.wrappingToI64(position), false)
      }
      20 => { // REOP_save_end
        let index = u8.toUsize(unsafe op8(ops, pc)) * 2 + 1
        pc = usize.wrappingAdd(pc, 1)
        run Machine.save(&mut machine, index, usize.wrappingToI64(position), false)
      }
      21 => { // REOP_save_reset
        let mut index = u8.toUsize(unsafe op8(ops, pc)) * 2
        let end = (u8.toUsize(unsafe op8(ops, pc + 1)) + 1) * 2
        pc = usize.wrappingAdd(pc, 2)
        while index < end {
          run Machine.save(&mut machine, index, -1, false)
          index = index + 1
        }
      }
      27 => { // REOP_set_i32
        let index = registerBase + u8.toUsize(unsafe op8(ops, pc))
        let value = unsafe rangeU32(ops, pc + 1)
        pc = usize.wrappingAdd(pc, 5)
        run Machine.save(&mut machine, index, u32.toI64(value), true)
      }
      22 => { // REOP_loop
        let index = registerBase + u8.toUsize(unsafe op8(ops, pc))
        let displacement = unsafe rangeU32(ops, pc + 1)
        pc = usize.wrappingAdd(pc, 5)
        let counter = u32.wrappingSubtract(i64.toU32(Machine.register(&machine, index)), 1)
        run Machine.save(&mut machine, index, u32.toI64(counter), true)
        if counter != 0 {
          pc = branch(pc, displacement)
          poll = true
        }
      }
      23 => { // REOP_loop_split_goto_first
        let jump = run loopSplit(&mut machine, bytecode, pc, registerBase, position, false, true)
        pc = jump.pc
        failed = jump.failed
        poll = jump.poll
      }
      24 => { // REOP_loop_split_next_first
        let jump = run loopSplit(&mut machine, bytecode, pc, registerBase, position, false, false)
        pc = jump.pc
        failed = jump.failed
        poll = jump.poll
      }
      25 => { // REOP_loop_check_adv_split_goto_first
        let jump = run loopSplit(&mut machine, bytecode, pc, registerBase, position, true, true)
        pc = jump.pc
        failed = jump.failed
        poll = jump.poll
      }
      26 => { // REOP_loop_check_adv_split_next_first
        let jump = run loopSplit(&mut machine, bytecode, pc, registerBase, position, true, false)
        pc = jump.pc
        failed = jump.failed
        poll = jump.poll
      }
      42 => { // REOP_set_char_pos
        let index = registerBase + u8.toUsize(unsafe op8(ops, pc))
        pc = usize.wrappingAdd(pc, 1)
        run Machine.save(&mut machine, index, usize.wrappingToI64(position), true)
      }
      43 => { // REOP_check_advance
        let index = registerBase + u8.toUsize(unsafe op8(ops, pc))
        pc = usize.wrappingAdd(pc, 1)
        failed = Machine.register(&machine, index) == usize.wrappingToI64(position)
      }
      28 => {
        failed = !atWordBoundary(input, position, false)
      } // REOP_word_boundary
      29 => {
        failed = !atWordBoundary(input, position, true)
      } // REOP_word_boundary_i
      30 => {
        failed = atWordBoundary(input, position, false)
      } // REOP_not_word_boundary
      31 => {
        failed = atWordBoundary(input, position, true)
      } // REOP_not_word_boundary_i
      32 => { // REOP_back_reference
        let count = u8.toUsize(unsafe op8(ops, pc))
        let step = backReference(
          bytecode,
          pc + 1,
          count,
          machine.values,
          captureCount,
          input,
          position,
          false,
          false,
        )
        pc = usize.wrappingAdd(pc, 1) + count
        position = step.position
        failed = step.failed
      }
      33 => { // REOP_back_reference_i
        let count = u8.toUsize(unsafe op8(ops, pc))
        let step = backReference(
          bytecode,
          pc + 1,
          count,
          machine.values,
          captureCount,
          input,
          position,
          false,
          true,
        )
        pc = usize.wrappingAdd(pc, 1) + count
        position = step.position
        failed = step.failed
      }
      34 => { // REOP_backward_back_reference
        let count = u8.toUsize(unsafe op8(ops, pc))
        let step = backReference(
          bytecode,
          pc + 1,
          count,
          machine.values,
          captureCount,
          input,
          position,
          true,
          false,
        )
        pc = usize.wrappingAdd(pc, 1) + count
        position = step.position
        failed = step.failed
      }
      35 => { // REOP_backward_back_reference_i
        let count = u8.toUsize(unsafe op8(ops, pc))
        let step = backReference(
          bytecode,
          pc + 1,
          count,
          machine.values,
          captureCount,
          input,
          position,
          true,
          true,
        )
        pc = usize.wrappingAdd(pc, 1) + count
        position = step.position
        failed = step.failed
      }
      36 => { // REOP_range
        let count = u16.toUsize(unsafe rangeU16(ops, pc))
        let step = classRange(bytecode, pc + 2, count, input, position, false, false)
        pc = usize.wrappingAdd(pc, 2) + count * 4
        position = step.position
        failed = step.failed
      }
      37 => { // REOP_range_i
        let count = u16.toUsize(unsafe rangeU16(ops, pc))
        let step = classRange(bytecode, pc + 2, count, input, position, false, true)
        pc = usize.wrappingAdd(pc, 2) + count * 4
        position = step.position
        failed = step.failed
      }
      38 => { // REOP_range32
        let count = u16.toUsize(unsafe rangeU16(ops, pc))
        let step = classRange(bytecode, pc + 2, count, input, position, true, false)
        pc = usize.wrappingAdd(pc, 2) + count * 8
        position = step.position
        failed = step.failed
      }
      39 => { // REOP_range32_i
        let count = u16.toUsize(unsafe rangeU16(ops, pc))
        let step = classRange(bytecode, pc + 2, count, input, position, true, true)
        pc = usize.wrappingAdd(pc, 2) + count * 8
        position = step.position
        failed = step.failed
      }
      44 => { // REOP_prev
        if position == 0 {
          failed = true
        } else {
          position = stepBackward(input, position, 0).position
        }
      }

      // REOP_invalid and unknown bytes violate the compiler-bytecode precondition.
      0 => {
        Intrinsic.trap("QuickJS invariant violated")
      }
      45 => {
        Intrinsic.trap("QuickJS invariant violated")
      }
      46 => { // REOP_CLASS
        let count = u16.toUsize(unsafe rangeU16(ops, pc))
        if position >= input.length {
          failed = true
        } else {
          let character = stepForward(input, position, input.length)
          failed = !classHas(bytecode, ops, pc + 2, count, character.code, false, input.unicode)
          position = character.position
        }
        pc = usize.wrappingAdd(pc, 2) + count * 4 + CLASS_BITS_LENGTH
      }
      47 => { // REOP_CLASS_I
        let count = u16.toUsize(unsafe rangeU16(ops, pc))
        if position >= input.length {
          failed = true
        } else {
          let character = stepForward(input, position, input.length)
          failed = !classHas(bytecode, ops, pc + 2, count, character.code, true, input.unicode)
          position = character.position
        }
        pc = usize.wrappingAdd(pc, 2) + count * 4 + CLASS_BITS_LENGTH
      }
      50 => {
        Intrinsic.trap("QuickJS invariant violated")
      }
      51 => {
        Intrinsic.trap("QuickJS invariant violated")
      }
      52 => {
        Intrinsic.trap("QuickJS invariant violated")
      }
      53 => {
        Intrinsic.trap("QuickJS invariant violated")
      }
      54 => {
        Intrinsic.trap("QuickJS invariant violated")
      }
      55 => {
        Intrinsic.trap("QuickJS invariant violated")
      }
      56 => {
        Intrinsic.trap("QuickJS invariant violated")
      }
      57 => {
        Intrinsic.trap("QuickJS invariant violated")
      }
      58 => {
        Intrinsic.trap("QuickJS invariant violated")
      }
      59 => {
        Intrinsic.trap("QuickJS invariant violated")
      }
      60 => {
        Intrinsic.trap("QuickJS invariant violated")
      }
      61 => {
        Intrinsic.trap("QuickJS invariant violated")
      }
      62 => {
        Intrinsic.trap("QuickJS invariant violated")
      }
      63 => {
        Intrinsic.trap("QuickJS invariant violated")
      }
      _ => {
        Intrinsic.trap("QuickJS invariant violated")
      }
    }
    if failed {
      let resume = Machine.backtrack(&mut machine)
      if !resume.exists {
        return false
      }
      pc = resume.pc
      position = resume.position
      poll = true
    }
    if poll {
      interruptCounter = u32.wrappingSubtract(interruptCounter, 1)
      if interruptCounter == 0 {
        interruptCounter = INTERRUPT_COUNTER_INIT
        if run interrupted() {
          fail RegExpTimeout {}
        }
      }
    }
  }
  return false
}

// From SilkJS src/byte_buffer.silk.
/// Owned growable bytes. Growth failures preserve the previous buffer contents.
/// The list is kept zero-filled to its capacity, so writes within the spare region
/// need no allocator; `count` is the used length.
struct ByteBuffer {
  bytes: List<u8>,
  count: usize
}

impl ByteBuffer {
  fn make() -> ByteBuffer {
    return ByteBuffer { bytes: List<u8>.make(), count: 0 }
  }

  fn length(self: &Self) -> usize {
    return self.count
  }

  fn capacity(self: &Self) -> usize {
    return self.bytes.length()
  }

  fn asSlice(self: &Self) -> &[u8] {
    return Slice.view(self.bytes.asSlice(), 0, self.count)
  }

  fn asMutSlice(self: &mut Self) -> &mut [u8] {
    self.bytes.truncate(self.count)
    return self.bytes.asMutSlice()
  }

  fn get(self: &Self, index: usize) -> u8 {
    if index >= self.count {
      Intrinsic.trap("ByteBuffer.get: index out of range")
    }
    return self.bytes.get(index)
  }

  fn set(self: &mut Self, index: usize, value: u8) -> () {
    if index >= self.count {
      Intrinsic.trap("ByteBuffer.set: index out of range")
    }
    self.bytes.set(index, value)
  }

  fn truncate(self: &mut Self, length: usize) -> () {
    if length < self.count {
      self.count = length
    }
  }

  fn clear(self: &mut Self) -> () {
    self.count = 0
  }

  fn intoList(self: Self) -> List<u8> {
    return match move self {
      ByteBuffer { bytes, count } => {
        let mut list = move bytes
        list.truncate(count)
        return move list
      }
    }
  }

  /// Releases the spare capacity of a finished buffer, so a long-lived copy keeps
  /// only its used bytes. On failure the buffer is unchanged.
  effect fn shrinkToFit(self: &mut Self) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.bytes.capacity() == self.count {
      return ()
    }
    self.bytes.truncate(self.count)
    run self.bytes.shrinkToFit()
  }

  /// Makes `count + additional` bytes writable, growing geometrically.
  // Inline room check; growth stays out of line.
  @inlineAlways
  effect fn ensure(self: &mut Self, additional: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let writable = self.bytes.length()
    if self.count <= writable && additional <= writable - self.count {
      return ()
    }
    run self.grow(additional)
  }

  @inlineNever
  effect fn grow(self: &mut Self, additional: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let needed = match move usize.checkedAdd(self.count, additional) {
      Option<usize>.Some { value } => value
      Option<usize>.None => run Allocator.outOfMemory()
    }
    let writable = self.bytes.length()
    if needed <= writable {
      return ()
    }
    run self.bytes.reserve(needed - writable)

    // Zero only a quarter past what is needed, not the whole doubled capacity:
    // untouched capacity costs no page faults, and the writable end still
    // moves geometrically.
    let mut fill = needed + needed / 4 + 16
    if fill > self.bytes.capacity() {
      fill = self.bytes.capacity()
    }
    run self.bytes.appendRepeated(0, fill - writable)
  }

  effect fn reserve(self: &mut Self, additional: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.ensure(additional)
  }

  /// Reserves additional bytes without applying a second geometric growth policy.
  effect fn reserveExact(self: &mut Self, additional: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let needed = match move usize.checkedAdd(self.count, additional) {
      Option<usize>.Some { value } => value
      Option<usize>.None => run Allocator.outOfMemory()
    }
    let writable = self.bytes.length()
    if needed <= writable {
      return ()
    }
    run self.bytes.reserveExact(needed - writable)
    let spare = self.bytes.capacity() - writable
    run self.bytes.appendRepeated(0, spare)
  }

  /// Appends without allocating; returns false when no spare byte is writable.
  fn appendWithin(self: &mut Self, value: u8) -> bool {
    let index = self.count
    if index >= self.bytes.length() {
      return false
    }
    self.bytes.set(index, value)
    self.count = index + 1
    return true
  }

  // Appends all of value within the current capacity, or nothing and false.
  @inlineAlways
  fn appendSliceWithin(self: &mut Self, value: &[u8]) -> bool {
    let base = self.count
    let count = value.length
    let dest = self.bytes.asMutSlice()
    if base > dest.length || count > dest.length - base {
      return false
    }
    copyBytes(&mut dest, base, value)
    self.count = base + count
    return true
  }

  @inlineAlways
  fn appendWithinU16(self: &mut Self, value: u16) -> bool {
    let index = self.count
    let dest = self.bytes.asMutSlice()
    if dest.length - index < 2 {
      return false
    }

    // One range check for the operand: LLVM merges the byte stores.
    let base = operandMut(&mut dest, index, 2)
    unsafe {
      Pointer.write<u8>(Pointer.atMut<u8>(base, 0), u16.toU8(value & 255))
      Pointer.write<u8>(Pointer.atMut<u8>(base, 1), u16.toU8(u16.shiftRight(value, 8)))
    }
    self.count = index + 2
    return true
  }

  @inlineAlways
  fn appendWithinU32(self: &mut Self, value: u32) -> bool {
    let index = self.count
    let dest = self.bytes.asMutSlice()
    if dest.length - index < 4 {
      return false
    }
    let base = operandMut(&mut dest, index, 4)
    storeU32(base, value)
    self.count = index + 4
    return true
  }

  effect fn append(self: &mut Self, value: u8) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    if self.appendWithin(value) {
      return ()
    }
    run self.ensure(1)
    let index = self.count
    self.bytes.set(index, value)
    self.count = index + 1
  }

  effect fn appendSlice(self: &mut Self, value: &[u8]) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.ensure(value.length)
    let base = self.count
    let count = value.length

    // One borrow of the filled storage instead of a checked List.set per byte.
    let dest = self.bytes.asMutSlice()
    if dest.length < base + count {
      Intrinsic.trap("ByteBuffer.appendSlice: storage too short")
    }
    copyBytes(&mut dest, base, value)
    self.count = base + count
  }

  /// Copies a range of the original contents to the end, surviving relocation.
  /// offset and length must describe a range entirely within the old contents.
  effect fn appendSelf(self: &mut Self, offset: usize, length: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let size = self.count
    if offset > size || length > size - offset {
      Intrinsic.trap("QuickJS invariant violated")
    }
    run self.ensure(length)

    // The source range ends at or before the old length, so it never overlaps the destination.
    let dest = self.bytes.asMutSlice()
    if dest.length - size < length {
      Intrinsic.trap("ByteBuffer.appendSelf: storage too short")
    }
    if length == 0 {
      return ()
    }

    // One borrow covers the source range through the end of the copy.
    let start = operandMut(&mut dest, offset, size + length - offset)
    let gap = size - offset
    unsafe {
      let mut i: usize = 0
      while i < length {
        Pointer.write<u8>(
          Pointer.atMut<u8>(start, gap + i),
          Pointer.read<u8>(Pointer.atMut<u8>(start, i)),
        )
        i = i + 1
      }
    }
    self.count = size + length
  }

  /// Inserts zero-filled bytes, shifting the suffix exactly once.
  effect fn insertZeroes(self: &mut Self, offset: usize, length: usize) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let oldLength = self.count
    if offset > oldLength {
      Intrinsic.trap("QuickJS invariant violated")
    }
    if length == 0 {
      return ()
    }
    run self.ensure(length)
    let mut i = oldLength
    while i > offset {
      i = i - 1
      let byte = self.bytes.get(i)
      self.bytes.set(i + length, byte)
    }
    i = 0
    while i < length {
      self.bytes.set(offset + i, 0)
      i = i + 1
    }
    self.count = oldLength + length
  }

  /// Appends a fixed-width little-endian operand without partial writes on OOM.
  effect fn writeU16(self: &mut Self, value: u16) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.ensure(2)
    drop self.appendWithinU16(value)
  }

  effect fn writeU32(self: &mut Self, value: u32) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.ensure(4)
    drop self.appendWithinU32(value)
  }

  effect fn writeU64(self: &mut Self, value: u64) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    run self.ensure(8)
    let base = self.count
    let mut i: usize = 0
    while i < 8 {
      self.bytes.set(base + i, u64.toU8(u64.shiftRight(value, usize.toU64(i * 8)) & 255))
      i = i + 1
    }
    self.count = base + 8
  }

  fn patchU16(self: &mut Self, offset: usize, value: u16) -> () {
    if offset >= self.count || self.count - offset < 2 {
      Intrinsic.trap("ByteBuffer.set: index out of range")
    }
    let dest = self.bytes.asMutSlice()
    let base = operandMut(&mut dest, offset, 2)
    unsafe {
      Pointer.write<u8>(Pointer.atMut<u8>(base, 0), u16.toU8(value & 255))
      Pointer.write<u8>(Pointer.atMut<u8>(base, 1), u16.toU8(u16.shiftRight(value, 8)))
    }
  }

  fn patchU32(self: &mut Self, offset: usize, value: u32) -> () {
    if offset >= self.count || self.count - offset < 4 {
      Intrinsic.trap("ByteBuffer.set: index out of range")
    }
    let dest = self.bytes.asMutSlice()
    storeU32(operandMut(&mut dest, offset, 4), value)
  }
}

/// The start of the width-byte operand at offset, trapping unless it is in bytes.
@inlineAlways
fn operandMut(bytes: &mut [u8], offset: usize, width: usize) -> [*]mut u8 {
  if offset >= bytes.length || bytes.length - offset < width {
    Intrinsic.trap("ByteBuffer: operand past the end")
  }
  unsafe {
    let start = Intrinsic.pointerRequalify<?[*]mut u8, [*]mut u8>(
      Pointer.fromMutSlice<u8>(&mut bytes),
    )
    return Pointer.assumeManyMut<u8>(Pointer.atMut<u8>(start, offset))
  }
}

/// Stores value little-endian at base, which the caller checked holds 4 bytes.
@inlineAlways
fn storeU32(base: [*]mut u8, value: u32) -> () {
  unsafe {
    Pointer.write<u8>(Pointer.atMut<u8>(base, 0), u32.toU8(value & 255))
    Pointer.write<u8>(Pointer.atMut<u8>(base, 1), u32.toU8(u32.shiftRight(value, 8) & 255))
    Pointer.write<u8>(Pointer.atMut<u8>(base, 2), u32.toU8(u32.shiftRight(value, 16) & 255))
    Pointer.write<u8>(Pointer.atMut<u8>(base, 3), u32.toU8(u32.shiftRight(value, 24)))
  }
}

// Slice.copyInto (dev.23) adds offset + index with an overflow check inside its
// loop, which keeps LLVM from vectorizing the copy. Offsetting the base once
// leaves a plain loop that LLVM vectorizes.
@inlineAlways
fn copyBytes(destination: &mut [u8], offset: usize, source: &[u8]) -> () {
  let count = source.length
  if offset > destination.length || count > destination.length - offset {
    Intrinsic.trap("ByteBuffer: copy past the end")
  }
  if count == 0 {
    return ()
  }

  // Both slices are nonempty, and offset + count is within destination.
  unsafe {
    let output = Intrinsic.pointerRequalify<?[*]mut u8, [*]mut u8>(
      Pointer.fromMutSlice<u8>(&mut destination),
    )
    let start = Pointer.assumeManyMut<u8>(Pointer.atMut<u8>(output, offset))
    let input = Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(Pointer.fromSlice<u8>(source))
    let mut index: usize = 0
    while index < count {
      Pointer.write<u8>(
        Pointer.atMut<u8>(start, index),
        Pointer.read<u8>(Pointer.at<u8>(input, index)),
      )
      index = index + 1
    }
  }
}

/// Reads a little-endian operand. The complete operand must be within bytes.
/// One range check covers the operand, so LLVM can combine the byte loads.
@inlineAlways
fn readU16(bytes: &[u8], offset: usize) -> u16 {
  let base = operand(bytes, offset, 2)
  unsafe {
    return u8.toU16(Pointer.read<u8>(Pointer.at<u8>(base, 0)))
      | u16.shiftLeft(u8.toU16(Pointer.read<u8>(Pointer.at<u8>(base, 1))), 8)
  }
}

@inlineAlways
fn readU32(bytes: &[u8], offset: usize) -> u32 {
  let base = operand(bytes, offset, 4)
  unsafe {
    return u8.toU32(Pointer.read<u8>(Pointer.at<u8>(base, 0)))
      | u32.shiftLeft(u8.toU32(Pointer.read<u8>(Pointer.at<u8>(base, 1))), 8)
      | u32.shiftLeft(u8.toU32(Pointer.read<u8>(Pointer.at<u8>(base, 2))), 16)
      | u32.shiftLeft(u8.toU32(Pointer.read<u8>(Pointer.at<u8>(base, 3))), 24)
  }
}

/// The start of the width-byte operand at offset, trapping unless it is in bytes.
@inlineAlways
fn operand(bytes: &[u8], offset: usize, width: usize) -> [*]const u8 {
  if offset >= bytes.length || bytes.length - offset < width {
    Intrinsic.trap("ByteBuffer: operand past the end")
  }
  unsafe {
    let start = Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(Pointer.fromSlice<u8>(bytes))
    return Pointer.assumeMany<u8>(Pointer.at<u8>(start, offset))
  }
}

// From SilkJS src/utf8.silk.
/// One decoded QuickJS code point and the number of input bytes consumed.
struct Decoded {
  pub codePoint: u32,
  pub length: usize
}

/// QuickJS's extended UTF-8 codec, including surrogates and 31-bit values.
/// This is not a validator for Silk strings: five/six-byte sequences and isolated
/// surrogates are deliberately accepted, matching unicode_from_utf8 upstream.
struct Utf8 {}

impl Utf8 {
  /// Writes one shortest-form encoding. Returns zero without writing when the
  /// code point exceeds 31 bits. Only the returned prefix of output is changed.
  fn encode(codePoint: u32, output: &mut [u8; 6]) -> usize {
    if codePoint >= 0x80000000 {
      return 0
    }
    if codePoint < 0x80 {
      output[0] = u32.toU8(codePoint)
      return 1
    }
    let mut length: usize = 6
    if codePoint < 0x800 {
      length = 2
    } else if codePoint < 0x10000 {
      length = 3
    } else if codePoint < 0x200000 {
      length = 4
    } else if codePoint < 0x4000000 {
      length = 5
    }
    let prefix: u32 = match length {
      2 => 0xc0
      3 => 0xe0
      4 => 0xf0
      5 => 0xf8
      _ => 0xfc
    }
    let mut remaining = codePoint
    let mut at = length - 1
    while at > 0 {
      output[at] = u32.toU8((remaining & 0x3f) | 0x80)
      remaining = u32.shiftRight(remaining, 6)
      at = at - 1
    }
    output[0] = u32.toU8(prefix | remaining)
    return length
  }

  /// Decodes the first sequence. Empty, truncated, overlong, or malformed input
  /// returns None. Trailing input is not consumed; length identifies the next byte.
  fn decode(input: &[u8]) -> Option<Decoded> {
    if input.length == 0 {
      return Option<Decoded>.none()
    }
    return unsafe Utf8.decodePointer(Pointer.fromRef<u8>(&input[0]), input.length)
  }

  /// Reads at most one sequence from a live immutable byte range; never copies it.
  unsafe fn decodePointer(input: *const u8, available: usize) -> Option<Decoded> {
    if available == 0 {
      return Option<Decoded>.none()
    }
    let first = u8.toU32(unsafe Pointer.read<u8>(input))
    if first < 0x80 {
      return Option<Decoded>.some(Decoded { codePoint: first, length: 1 })
    }
    if first < 0xc0 || first >= 0xfe {
      return Option<Decoded>.none()
    }
    let mut length: usize = 6
    if first < 0xe0 {
      length = 2
    } else if first < 0xf0 {
      length = 3
    } else if first < 0xf8 {
      length = 4
    } else if first < 0xfc {
      length = 5
    }
    if available < length {
      return Option<Decoded>.none()
    }
    let minimum: u32 = match length {
      2 => 0x80
      3 => 0x800
      4 => 0x10000
      5 => 0x200000
      _ => 0x4000000
    }
    let mask = u32.shiftRight(0x7f, usize.toU32(length))
    let mut codePoint = first & mask
    let mut at: usize = 1
    while at < length {
      let byte = u8.toU32(
        unsafe Pointer.read<u8>(unsafe Pointer.at<u8>(unsafe Pointer.assumeMany<u8>(input), at)),
      )
      if byte < 0x80 || byte >= 0xc0 {
        return Option<Decoded>.none()
      }
      codePoint = u32.shiftLeft(codePoint, 6) | (byte & 0x3f)
      at = at + 1
    }
    if codePoint < minimum {
      return Option<Decoded>.none()
    }
    return Option<Decoded>.some(Decoded { codePoint: codePoint, length: length })
  }
}

// From SilkJS src/ascii.silk.
//! ASCII byte classification and case mapping for parsers of tags, dates and
//! option strings. Bytes outside ASCII are never letters or digits.

/// Whether `c` is `0`-`9`.
fn digit(c: u8) -> bool {
  return c >= 48 && c <= 57
}

/// `c` with `A`-`Z` mapped to `a`-`z`.
fn lower(c: u8) -> u8 {
  if c >= 65 && c <= 90 {
    return c + 32
  }
  return c
}

/// `c` with `a`-`z` mapped to `A`-`Z`.
fn upper(c: u8) -> u8 {
  if c >= 97 && c <= 122 {
    return c - 32
  }
  return c
}

// From SilkJS src/native_stack.silk.
//! Native frame sampling for QuickJS's downward-growing stack guards.

/// Returns this call site's current native frame address, not a dereferenceable pointer.
/// Compare samples only within the same running native stack; inlining can merge frames.
fn currentFrameAddress() -> usize {
  return Pointer.addressMany<u8>(Stack.frameAddress())
}
