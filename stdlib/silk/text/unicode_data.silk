// 20496 bytes; leaf block 16, middle block 32.
/// Returns the General_Category of `cp` as a packed number. `GeneralCategory.of` gives the typed
/// value.
///
/// # Details
/// A value past U+10FFFF gets the Unicode default, 2.
@inlineAlways
pub fn generalCategory(cp: u32) -> u32 {
  if cp >= 1114110 {
    return 2
  }
  let u = u32.toUsize(cp)
  let first = u8.toUsize(generalCategory0()[u / 512])
  let block = u32.toUsize(be16(generalCategory1(), (first * 32 + ((u / 16) & 31)) * 2))
  return u8.toU32(generalCategory2()[block * 16 + (u & 15)])
