  let u = u32.toUsize(cp)
  let first = u8.toUsize(verticalDelta0()[u / 512])
  let block = u8.toUsize(verticalDelta1()[first * 64 + ((u / 8) & 63)])
  return be32(verticalDelta2(), (block * 8 + (u & 7)) * 4)
