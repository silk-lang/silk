// 4064 bytes; leaf block 16, middle block 64.
/// Returns the Vertical_Orientation of `cp` as a packed number. `VerticalOrientation.of` gives the
/// typed value.
///
/// # Details
/// A value past U+10FFFF gets the Unicode default, 0.
@inlineAlways
pub fn verticalOrientation(cp: u32) -> u32 {
  if cp >= 1114110 {
    return 0
  }
  let u = u32.toUsize(cp)
  let first = u8.toUsize(verticalOrientation0()[u / 1024])
  let block = u8.toUsize(verticalOrientation1()[first * 64 + ((u / 16) & 63)])
  return u8.toU32(verticalOrientation2()[block * 16 + (u & 15)])
}

