// 2300 bytes; leaf block 4, middle block 64.
/// Returns the wrapping difference from `cp` to its Bidi_Mirroring_Glyph, or 0 when `cp` has none.
///
/// # Details
/// A value past U+10FFFF gets the Unicode default, 0.
@inlineAlways
pub fn mirrorDelta(cp: u32) -> u32 {
  if cp >= 121617 {
    return 0
  }
  let u = u32.toUsize(cp)
  let first = u8.toUsize(mirrorDelta0()[u / 256])
  let block = u8.toUsize(mirrorDelta1()[first * 64 + ((u / 4) & 63)])
  return be32(mirrorDelta2(), (block * 4 + (u & 3)) * 4)
}

