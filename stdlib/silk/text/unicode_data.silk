// BMP: 7312 bytes; leaf block 16.
// 5124 bytes; leaf block 16, middle block 64.
/// Returns the grapheme record of `cp`: Grapheme_Cluster_Break in bits 0 to 4, Indic_Conjunct_Break
/// in bits 5 and 6, and Extended_Pictographic in bit 7.
///
/// # Details
/// A value past U+10FFFF gets the Unicode default, 16.
@inlineAlways
pub fn graphemeInfo(cp: u32) -> u32 {
  if cp < 0x10000 {
    let block = u8.toUsize(graphemeInfoBmp0()[u32.toUsize(cp) / 16])
    return u8.toU32(graphemeInfoBmp1()[block * 16 + (u32.toUsize(cp) & 15)])
  }
  if cp >= 921600 {
    return 16
  }
  let u = u32.toUsize(cp)
  let first = u8.toUsize(graphemeInfo0()[u / 1024])
  let block = u8.toUsize(graphemeInfo1()[first * 64 + ((u / 16) & 63)])
  return u8.toU32(graphemeInfo2()[block * 16 + (u & 15)])
}

/// Returns the big-endian unsigned 16-bit number at byte `index` of `data`.
@inlineAlways
pub fn be16(data: &[u8], index: usize) -> u32 {
  return u32.shiftLeft(u8.toU32(data[index + 0]), 8) | u8.toU32(data[index + 1])
}

/// Returns the big-endian unsigned 32-bit number at byte `index` of `data`.
@inlineAlways
pub fn be32(data: &[u8], index: usize) -> u32 {
  return u32.shiftLeft(u8.toU32(data[index + 0]), 24) | u32.shiftLeft(u8.toU32(data[index + 1]), 16)
    | u32.shiftLeft(u8.toU32(data[index + 2]), 8)
    | u8.toU32(data[index + 3])
}

