// 6353 bytes; leaf block 8, middle block 64.
/// Returns the Joining_Type of `cp` as a packed number. `JoiningType.of` gives the typed value.
///
/// # Details
/// A value past U+10FFFF gets the Unicode default, 5.
@inlineAlways
pub fn joiningType(cp: u32) -> u32 {
  if cp >= 918000 {
    return 5
  }
  let u = u32.toUsize(cp)
  let first = u8.toUsize(joiningType0()[u / 512])
  let block = u8.toUsize(joiningType1()[first * 64 + ((u / 8) & 63)])
  return u8.toU32(joiningType2()[block * 8 + (u & 7)])
}

