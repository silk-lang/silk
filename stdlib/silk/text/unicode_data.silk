// 5248 bytes; leaf block 16, middle block 64.
/// Returns the East_Asian_Width of `cp` as a packed number. `EastAsianWidth.of` gives the typed
/// value.
///
/// # Details
/// A value past U+10FFFF gets the Unicode default, 3.
@inlineAlways
pub fn eastAsianWidth(cp: u32) -> u32 {
  if cp >= 1114110 {
    return 3
  }
  let u = u32.toUsize(cp)
  let first = u8.toUsize(eastAsianWidth0()[u / 1024])
  let block = u8.toUsize(eastAsianWidth1()[first * 64 + ((u / 16) & 63)])
  return u8.toU32(eastAsianWidth2()[block * 16 + (u & 15)])
