  }
  let u = u32.toUsize(cp)
  let first = u8.toUsize(joiningGroup0()[u / 512])
  let block = u8.toUsize(joiningGroup1()[first * 32 + ((u / 16) & 31)])
  return u8.toU32(joiningGroup2()[block * 16 + (u & 15)])
