// 6369 bytes; leaf block 8, middle block 64.
/// Returns the Indic_Conjunct_Break of `cp` as a packed number. `IndicConjunctBreak.of` gives the
/// typed value.
///
/// # Details
/// A value past U+10FFFF gets the Unicode default, 0.
@inlineAlways
pub fn indicConjunctBreak(cp: u32) -> u32 {
  if cp >= 918000 {
    return 0
  }
  let u = u32.toUsize(cp)
  let first = u8.toUsize(indicConjunctBreak0()[u / 512])
  let block = u8.toUsize(indicConjunctBreak1()[first * 64 + ((u / 8) & 63)])
  return u8.toU32(indicConjunctBreak2()[block * 8 + (u & 7)])
}

