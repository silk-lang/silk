// 23488 bytes; leaf block 8, middle block 32.
/// Returns the line breaking record of `cp`: the resolved Line_Break class in bits 0 to 5 and the
/// flags that `silk.text.line_break` reads in bits 6 to 14.
///
/// # Details
/// A value past U+10FFFF gets the Unicode default, 1026.
@inlineAlways
pub fn lineBreakInfo(cp: u32) -> u32 {
  if cp < 128 {
    return be16(lineBreakInfoAscii(), u32.toUsize(cp) * 2)
  }
  if cp >= 1114110 {
    return 1026
  }
  let u = u32.toUsize(cp)
  let first = u8.toUsize(lineBreakInfo0()[u / 256])
  let block = u32.toUsize(be16(lineBreakInfo1(), (first * 32 + ((u / 8) & 31)) * 2))
  return be16(lineBreakInfo2(), (block * 8 + (u & 7)) * 2)
