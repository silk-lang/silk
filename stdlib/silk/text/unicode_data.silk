// 27522 bytes; leaf block 8, middle block 32.
/// Returns the index of the Script_Extensions set of `cp` in `scriptSetOffsets`.
///
/// # Details
/// A value past U+10FFFF gets the Unicode default, 177.
@inlineAlways
pub fn scriptExtensions(cp: u32) -> u32 {
  if cp >= 918000 {
    return 177
  }
  let u = u32.toUsize(cp)
  let first = u8.toUsize(scriptExtensions0()[u / 256])
  let block = u32.toUsize(be16(scriptExtensions1(), (first * 32 + ((u / 8) & 31)) * 2))
  return be16(scriptExtensions2(), (block * 8 + (u & 7)) * 2)
