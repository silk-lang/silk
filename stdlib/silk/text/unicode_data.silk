// 1185 bytes; leaf block 32, middle block 64.
/// Returns 1 when `cp` has the Emoji_Component property, otherwise 0.
///
/// # Details
/// A value past U+10FFFF gets the Unicode default, 0.
@inlineAlways
pub fn isEmojiComponent(cp: u32) -> u32 {
  if cp >= 917632 {
    return 0
  }
  let u = u32.toUsize(cp)
  let first = u8.toUsize(isEmojiComponent0()[u / 2048])
  let block = u8.toUsize(isEmojiComponent1()[first * 64 + ((u / 32) & 63)])
  return u8.toU32(isEmojiComponent2()[block * 32 + (u & 31)])
}

