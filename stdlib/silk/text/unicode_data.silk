/// Returns the wrapping difference from `cp` to its vertical presentation form, or 0 when `cp` has
/// none.
///
/// # Details
/// A value past U+10FFFF gets the Unicode default, 0.
@inlineAlways
pub fn verticalDelta(cp: u32) -> u32 {
  if cp >= 65374 {
