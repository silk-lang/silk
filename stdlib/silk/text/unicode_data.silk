// 1570 bytes; leaf block 32, middle block 64.
/// Returns 1 when `cp` has the Default_Ignorable_Code_Point property, otherwise 0.
///
/// # Details
/// A value past U+10FFFF gets the Unicode default, 0.
@inlineAlways
pub fn isDefaultIgnorable(cp: u32) -> u32 {
  if cp >= 921600 {
    return 0
  }
  let u = u32.toUsize(cp)
  let first = u8.toUsize(isDefaultIgnorable0()[u / 2048])
  let block = u8.toUsize(isDefaultIgnorable1()[first * 64 + ((u / 32) & 63)])
  return u8.toU32(isDefaultIgnorable2()[block * 32 + (u & 31)])
}

