// 800 bytes; leaf block 16, middle block 16.
/// Returns the Bidi_Paired_Bracket_Type of `cp`: 0 for none, 1 for an opening and 2 for a closing
/// bracket.
///
/// # Details
/// A value past U+10FFFF gets the Unicode default, 0.
@inlineAlways
pub fn bidiPairedBracketType(cp: u32) -> u32 {
  if cp >= 65380 {
    return 0
  }
  let u = u32.toUsize(cp)
  let first = u8.toUsize(bidiPairedBracketType0()[u / 256])
  let block = u8.toUsize(bidiPairedBracketType1()[first * 16 + ((u / 16) & 15)])
  return u8.toU32(bidiPairedBracketType2()[block * 16 + (u & 15)])
