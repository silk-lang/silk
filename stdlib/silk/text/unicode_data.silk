// BMP: 12736 bytes; leaf block 64.
// 7465 bytes; leaf block 8, middle block 64.
/// Returns the Sentence_Break of `cp` as a packed number. `SentenceBreak.of` gives the typed value.
///
/// # Details
/// A value past U+10FFFF gets the Unicode default, 14.
@inlineAlways
pub fn sentenceBreak(cp: u32) -> u32 {
  if cp < 128 {
    return u8.toU32(sentenceBreakAscii()[u32.toUsize(cp)])
  }
  if cp < 0x10000 {
    let block = u8.toUsize(sentenceBreakBmp0()[u32.toUsize(cp) / 64])
    return u8.toU32(sentenceBreakBmp1()[block * 64 + (u32.toUsize(cp) & 63)])
  }
  if cp >= 918000 {
    return 14
  }
  let u = u32.toUsize(cp)
  let first = u8.toUsize(sentenceBreak0()[u / 512])
  let block = u8.toUsize(sentenceBreak1()[first * 64 + ((u / 8) & 63)])
  return u8.toU32(sentenceBreak2()[block * 8 + (u & 7)])
}

