// 1747 bytes; leaf block 8, middle block 32.
/// Returns 1 when `cp` has the Emoji property, otherwise 0.
///
/// # Details
/// A value past U+10FFFF gets the Unicode default, 0.
@inlineAlways
pub fn isEmoji(cp: u32) -> u32 {
  if cp >= 129787 {
    return 0
  }
  let u = u32.toUsize(cp)
  let first = u8.toUsize(isEmoji0()[u / 256])
  let block = u8.toUsize(isEmoji1()[first * 32 + ((u / 8) & 31)])
  return u8.toU32(isEmoji2()[block * 8 + (u & 7)])
}

