// 3883 bytes; leaf block 8, middle block 16.
/// Returns the Canonical_Combining_Class of `cp`, from 0 to 254.
///
/// # Details
/// A value past U+10FFFF gets the Unicode default, 0.
@inlineAlways
pub fn combiningClass(cp: u32) -> u32 {
  if cp >= 125259 {
    return 0
  }
  let u = u32.toUsize(cp)
  let first = u8.toUsize(combiningClass0()[u / 128])
  let block = u8.toUsize(combiningClass1()[first * 16 + ((u / 8) & 15)])
  return u8.toU32(combiningClass2()[block * 8 + (u & 7)])
}

