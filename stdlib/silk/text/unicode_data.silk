// 1215 bytes; leaf block 4, middle block 32.
/// Returns the wrapping difference from `cp` to its Bidi_Paired_Bracket, or 0 when `cp` has none.
///
/// # Details
/// A value past U+10FFFF gets the Unicode default, 0.
@inlineAlways
pub fn bracketDelta(cp: u32) -> u32 {
  if cp >= 65380 {
    return 0
  }
  let u = u32.toUsize(cp)
  let first = u8.toUsize(bracketDelta0()[u / 128])
  let block = u8.toUsize(bracketDelta1()[first * 32 + ((u / 4) & 31)])
  return be32(bracketDelta2(), (block * 4 + (u & 3)) * 4)
}

