// 18753 bytes; leaf block 16, middle block 32.
/// Returns the Line_Break class of `cp` as a packed number. `LineBreak.of` gives the typed value.
///
/// # Details
/// A value past U+10FFFF gets the Unicode default, 46.
@inlineAlways
pub fn lineBreak(cp: u32) -> u32 {
  if cp >= 918000 {
    return 46
  }
  let u = u32.toUsize(cp)
  let first = u8.toUsize(lineBreak0()[u / 512])
  let block = u32.toUsize(be16(lineBreak1(), (first * 32 + ((u / 16) & 31)) * 2))
  return u8.toU32(lineBreak2()[block * 16 + (u & 15)])
