// 7444 bytes; leaf block 16, middle block 64.
/// Returns the Grapheme_Cluster_Break of `cp` as a packed number. `GraphemeBreak.of` gives the
/// typed value.
///
/// # Details
/// A value past U+10FFFF gets the Unicode default, 16.
@inlineAlways
pub fn graphemeBreak(cp: u32) -> u32 {
  if cp >= 921600 {
    return 16
  }
  let u = u32.toUsize(cp)
  let first = u8.toUsize(graphemeBreak0()[u / 1024])
  let block = u8.toUsize(graphemeBreak1()[first * 64 + ((u / 16) & 63)])
  return u8.toU32(graphemeBreak2()[block * 16 + (u & 15)])
