// 8864 bytes; leaf block 8, middle block 128.
/// Returns the Bidi_Class of `cp` as a packed number. `BidiClass.of` gives the typed value.
///
/// # Details
/// A value past U+10FFFF gets the Unicode default, 3.
@inlineAlways
pub fn bidiClass(cp: u32) -> u32 {
  if cp >= 1114110 {
    return 3
  }
  let u = u32.toUsize(cp)
  let first = u8.toUsize(bidiClass0()[u / 1024])
  let block = u8.toUsize(bidiClass1()[first * 128 + ((u / 8) & 127)])
  return u8.toU32(bidiClass2()[block * 8 + (u & 7)])
