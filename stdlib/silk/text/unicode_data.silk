// BMP: 8064 bytes; leaf block 16.
// 6225 bytes; leaf block 16, middle block 64.
/// Returns the Word_Break of `cp` as a packed number. `WordBreak.of` gives the typed value.
///
/// # Details
/// A value past U+10FFFF gets the Unicode default, 21.
@inlineAlways
pub fn wordBreak(cp: u32) -> u32 {
  if cp < 128 {
    return u8.toU32(wordBreakAscii()[u32.toUsize(cp)])
  }
  if cp < 0x10000 {
    let block = u8.toUsize(wordBreakBmp0()[u32.toUsize(cp) / 16])
    return u8.toU32(wordBreakBmp1()[block * 16 + (u32.toUsize(cp) & 15)])
  }
  if cp >= 918000 {
    return 21
  }
  let u = u32.toUsize(cp)
  let first = u8.toUsize(wordBreak0()[u / 1024])
  let block = u8.toUsize(wordBreak1()[first * 64 + ((u / 16) & 63)])
  return u8.toU32(wordBreak2()[block * 16 + (u & 15)])
