// 1054 bytes; leaf block 16, middle block 16.
/// Returns 1 when `cp` is the second scalar of a primary composite in `compositions`, otherwise 0.
///
/// # Details
/// A value past U+10FFFF gets the Unicode default, 0.
@inlineAlways
pub fn composesAsSecond(cp: u32) -> u32 {
  if cp >= 93544 {
    return 0
  }
  let u = u32.toUsize(cp)
  let first = u8.toUsize(composesAsSecond0()[u / 256])
  let block = u8.toUsize(composesAsSecond1()[first * 16 + ((u / 16) & 15)])
  return u8.toU32(composesAsSecond2()[block * 16 + (u & 15)])
}

