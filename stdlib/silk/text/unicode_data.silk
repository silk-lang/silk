// 8126 bytes; leaf block 16, middle block 32.
/// Returns the index of the one-step canonical decomposition of `cp` in `decompositions`, or 0 when
/// `cp` has none. Hangul syllables are not in the table.
///
/// # Details
/// A value past U+10FFFF gets the Unicode default, 0.
@inlineAlways
pub fn decomposition(cp: u32) -> u32 {
  if cp >= 195102 {
    return 0
  }
  let u = u32.toUsize(cp)
  let first = u8.toUsize(decomposition0()[u / 512])
  let block = u8.toUsize(decomposition1()[first * 32 + ((u / 16) & 31)])
  return be16(decomposition2(), (block * 16 + (u & 15)) * 2)
