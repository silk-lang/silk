//! Character orientation in vertical text (UAX #50), with data from Unicode 18.0.0.
//!
//! # When to use
//! Use [`orientations`] to lay out vertical text, such as vertical Japanese: it splits the text
//! into runs that stand upright and runs that are rotated.
//!
//! # Details
//! The orientation belongs to a whole extended grapheme cluster, so combining marks and emoji
//! sequences never split. An enclosing mark makes its cluster upright. The runs are byte ranges of
//! the text, appended to a caller-owned list.
//!
//! # Gotchas
//! The result is the fallback orientation, without font data. A character with
//! `Vertical_Orientation` `Tu` or `Tr` needs its vertical alternate glyph when the font has one.
//! Read `VerticalOrientation.of` in `silk.text.unicode_properties` for that.
//!
//! # Examples
//! ## Find the rotated part of vertical text
//! ```silk
//! import silk.collections.list { List }
//! import silk.core.effect { Effect }
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.text.vertical_text
//! import silk.text.vertical_text { Orientation, OrientationRun }
//!
//! pub effect fn main() -> i32
//!   ! OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let mut runs = List<OrientationRun>.make()
//!   // Two kanji, then Latin letters.
//!   run vertical_text.orientations("\u{65e5}\u{672c}abc", &mut runs)
//!     |> Effect.provideMut<Allocator>(&mut allocator)
//!   let items = runs.asSlice()
//!   if items.length != 2 || items[0].orientation != Orientation.Upright || items[1].start != 6
//!     || items[1].orientation != Orientation.Rotated {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Text

// Reference: https://www.unicode.org/reports/tr50/#grapheme_clusters

import silk.text.unicode_properties { GeneralCategory, VerticalOrientation }
import silk.text.segmentation { GraphemeCursor }
import silk.text.string { String }
import silk.text.utf8_scan
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.core.ownership { Copy }

/// The fallback orientation of a character in vertical text.
pub enum Orientation {
  /// The glyph stands upright, as in the code charts.
  Upright,
  /// The glyph is rotated 90 degrees clockwise.
  Rotated,
}

/// A maximal range of a text with one fallback orientation, as [`orientations`] gives it.
pub struct OrientationRun {
  /// The byte offset where the run starts.
  pub start: usize,
  /// The byte offset where the run ends.
  pub end: usize,
  /// The fallback orientation of the run.
  pub orientation: Orientation,
}

impl Copy for OrientationRun {}

fn fallback(cp: u32) -> Orientation {
  let property = VerticalOrientation.of(cp)
  return match &property {
    VerticalOrientation.U => Orientation.Upright
    VerticalOrientation.Tu => Orientation.Upright
    VerticalOrientation.R => Orientation.Rotated
    VerticalOrientation.Tr => Orientation.Rotated
  }
}

/// Appends the runs of fallback orientation of `text` for vertical layout to `output`.
///
/// # Details
///
/// The orientation follows UAX #50 for whole extended grapheme clusters: the first scalar of a
/// cluster decides, but an enclosing mark (General_Category `Me`) makes the cluster upright.
/// `Vertical_Orientation` `U` and `Tu` give [`Orientation.Upright`], and `R` and `Tr` give
/// [`Orientation.Rotated`]. The runs are not empty, they cover the text in order without gaps, and
/// empty text gives none. The function does not clear `output`, so clear it first to reuse its
/// storage.
///
/// # Errors
///
/// - `OutOfMemoryError` if the `Allocator` cannot grow `output`.
///
/// # Gotchas
///
/// `Tu` and `Tr` characters need a vertical alternate glyph when the font has one; the fallback
/// orientation applies only without it. Read `VerticalOrientation.of` in
/// `silk.text.unicode_properties` to tell them apart from `U` and `R`.
pub effect fn orientations(text: string, output: &mut List<OrientationRun>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run orientationsOf(String.utf8Bytes(text), &mut output)
}

effect fn orientationsOf(text: &[u8], output: &mut List<OrientationRun>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut at: usize = 0
  let mut start: usize = 0
  let mut previous = Orientation.Upright
  let mut graphemes = GraphemeCursor.make()
  while at < text.length {
    let end = graphemes.nextBytes(text)
    let first = utf8_scan.decode(text, at)
    let mut orientation = fallback(first.scalar)
    let mut cp = first.scalar
    let mut next = first.next
    while true {
      if GeneralCategory.of(cp) == GeneralCategory.Me {
        orientation = Orientation.Upright
        break
      }
      if next >= end {
        break
      }
      let decoded = utf8_scan.decode(text, next)
      cp = decoded.scalar
      next = decoded.next
    }
    if at > 0 && previous != orientation {
      run List<OrientationRun>.append(
        &mut output,
        OrientationRun { start: start, end: at, orientation: previous },
      )
      start = at
    }
    previous = orientation
    at = end
  }
  if start < text.length {
    run List<OrientationRun>.append(
      &mut output,
      OrientationRun { start: start, end: text.length, orientation: previous },
    )
  }
}
