  /// Returns the value for the packed number `value` from `unicode_data.graphemeBreak`. An unknown
  /// number gives `Other`.
  @inlineAlways
  pub fn fromTableValue(value: u32) -> GraphemeBreak {
    return match value {
      0 => GraphemeBreak.Control
      1 => GraphemeBreak.CR
      2 => GraphemeBreak.E_Base
      3 => GraphemeBreak.E_Base_GAZ
      4 => GraphemeBreak.E_Modifier
      5 => GraphemeBreak.Extend
      6 => GraphemeBreak.Glue_After_Zwj
      7 => GraphemeBreak.L
      8 => GraphemeBreak.LF
      9 => GraphemeBreak.LV
      10 => GraphemeBreak.LVT
      11 => GraphemeBreak.Prepend
      12 => GraphemeBreak.Regional_Indicator
      13 => GraphemeBreak.SpacingMark
      14 => GraphemeBreak.T
      15 => GraphemeBreak.V
      17 => GraphemeBreak.ZWJ
      _ => GraphemeBreak.Other
    }
  }
}

