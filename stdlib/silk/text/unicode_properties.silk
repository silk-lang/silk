  /// L.
  L,
  /// LF.
  LF,
  /// LV.
  LV,
  /// LVT.
  LVT,
  /// Prepend (also `PP`).
  Prepend,
  /// Regional Indicator (also `RI`).
  Regional_Indicator,
  /// SpacingMark (also `SM`).
  SpacingMark,
  /// T.
  T,
  /// V.
  V,
  /// Other (also `XX`).
  Other,
  /// ZWJ.
  ZWJ,
}

impl GraphemeBreak {
  /// Returns the `Grapheme_Cluster_Break` of the code point `cp`. A value past U+10FFFF gets
  /// `Other`.
  @inlineAlways
  pub fn of(cp: u32) -> GraphemeBreak {
