/// The Unicode `Line_Break` property: the line breaking class of a character, which the Unicode
/// Line Breaking Algorithm (UAX #14) reads.
///
/// # Details
/// [`LineBreak.of`] reads the value of one code point. A code point with no explicit value, or a
/// value past U+10FFFF, gets the Unicode default, `XX`.
pub enum LineBreak {
  /// Ambiguous.
  AI,
  /// Aksara.
  AK,
  /// Alphabetic.
  AL,
  /// Aksara Prebase.
  AP,
  /// Aksara Start.
  AS,
  /// Break Both.
  B2,
  /// Break After.
  BA,
  /// Break Before.
  BB,
  /// Mandatory Break.
  BK,
  /// Contingent Break.
  CB,
  /// Conditional Japanese Starter.
  CJ,
  /// Close Punctuation.
  CL,
  /// Combining Mark.
  CM,
  /// Close Parenthesis.
  CP,
  /// Carriage Return.
  CR,
  /// E Base.
  EB,
  /// E Modifier.
  EM,
  /// Exclamation.
  EX,
  /// Glue.
  GL,
  /// H2.
  H2,
  /// H3.
  H3,
  /// Unambiguous Hyphen.
  HH,
  /// Hebrew Letter.
  HL,
  /// Hyphen.
  HY,
  /// Ideographic.
  ID,
  /// Inseparable (also `Inseperable`).
  IN,
  /// Infix Numeric.
  IS,
  /// JL.
  JL,
  /// JT.
  JT,
  /// JV.
  JV,
  /// Line Feed.
  LF,
  /// Next Line.
  NL,
  /// Nonstarter.
  NS,
  /// Numeric.
  NU,
  /// Open Punctuation.
  OP,
  /// Postfix Numeric.
  PO,
  /// Prefix Numeric.
  PR,
  /// Quotation.
  QU,
  /// Regional Indicator.
  RI,
  /// Complex Context.
  SA,
  /// Surrogate.
  SG,
  /// Space.
  SP,
  /// Break Symbols.
  SY,
  /// Virama Final.
  VF,
  /// Virama.
  VI,
  /// Word Joiner.
  WJ,
  /// Unknown.
  XX,
  /// ZWSpace.
  ZW,
  /// ZWJ.
  ZWJ,
}

impl LineBreak {
  /// Returns the `Line_Break` of the code point `cp`. A value past U+10FFFF gets `XX`.
  @inlineAlways
  pub fn of(cp: u32) -> LineBreak {
    return LineBreak.fromTableValue(unicode_data.lineBreak(cp))
  }

  /// Returns the value for the packed number `value` from `unicode_data.lineBreak`. An unknown
  /// number gives `XX`.
  @inlineAlways
  pub fn fromTableValue(value: u32) -> LineBreak {
    return match value {
      0 => LineBreak.AI
      1 => LineBreak.AK
      2 => LineBreak.AL
      3 => LineBreak.AP
      4 => LineBreak.AS
      5 => LineBreak.B2
      6 => LineBreak.BA
      7 => LineBreak.BB
      8 => LineBreak.BK
      9 => LineBreak.CB
      10 => LineBreak.CJ
      11 => LineBreak.CL
      12 => LineBreak.CM
      13 => LineBreak.CP
      14 => LineBreak.CR
      15 => LineBreak.EB
      16 => LineBreak.EM
      17 => LineBreak.EX
      18 => LineBreak.GL
      19 => LineBreak.H2
      20 => LineBreak.H3
      21 => LineBreak.HH
      22 => LineBreak.HL
      23 => LineBreak.HY
      24 => LineBreak.ID
      25 => LineBreak.IN
      26 => LineBreak.IS
      27 => LineBreak.JL
      28 => LineBreak.JT
      29 => LineBreak.JV
      30 => LineBreak.LF
      31 => LineBreak.NL
      32 => LineBreak.NS
      33 => LineBreak.NU
      34 => LineBreak.OP
      35 => LineBreak.PO
      36 => LineBreak.PR
      37 => LineBreak.QU
      38 => LineBreak.RI
      39 => LineBreak.SA
      40 => LineBreak.SG
      41 => LineBreak.SP
      42 => LineBreak.SY
      43 => LineBreak.VF
      44 => LineBreak.VI
      45 => LineBreak.WJ
      47 => LineBreak.ZW
      48 => LineBreak.ZWJ
      _ => LineBreak.XX
    }
  }

  /// Returns the row and column of the class in `unicode_data.linePairs`.
  @inlineAlways
  pub fn tableIndex(self: Self) -> usize {
    return match self {
      LineBreak.AI => 0
      LineBreak.AK => 1
      LineBreak.AL => 2
      LineBreak.AP => 3
      LineBreak.AS => 4
      LineBreak.B2 => 5
      LineBreak.BA => 6
      LineBreak.BB => 7
      LineBreak.BK => 8
      LineBreak.CB => 9
      LineBreak.CJ => 10
      LineBreak.CL => 11
      LineBreak.CM => 12
      LineBreak.CP => 13
      LineBreak.CR => 14
      LineBreak.EB => 15
      LineBreak.EM => 16
      LineBreak.EX => 17
      LineBreak.GL => 18
      LineBreak.H2 => 19
      LineBreak.H3 => 20
      LineBreak.HH => 21
      LineBreak.HL => 22
      LineBreak.HY => 23
      LineBreak.ID => 24
      LineBreak.IN => 25
      LineBreak.IS => 26
      LineBreak.JL => 27
      LineBreak.JT => 28
      LineBreak.JV => 29
      LineBreak.LF => 30
      LineBreak.NL => 31
      LineBreak.NS => 32
      LineBreak.NU => 33
      LineBreak.OP => 34
      LineBreak.PO => 35
      LineBreak.PR => 36
      LineBreak.QU => 37
      LineBreak.RI => 38
      LineBreak.SA => 39
      LineBreak.SG => 40
      LineBreak.SP => 41
      LineBreak.SY => 42
      LineBreak.VF => 43
      LineBreak.VI => 44
      LineBreak.WJ => 45
      LineBreak.XX => 46
      LineBreak.ZW => 47
      LineBreak.ZWJ => 48
    }
  }
}

/// The Unicode `East_Asian_Width` property: the width of a character in East Asian typography (UAX
/// #11).
///
/// # Details
/// [`EastAsianWidth.of`] reads the value of one code point. A code point with no explicit value, or
/// a value past U+10FFFF, gets the Unicode default, `N`.
pub enum EastAsianWidth {
  /// Ambiguous.
  A,
  /// Fullwidth.
  F,
  /// Halfwidth.
  H,
  /// Neutral.
  N,
  /// Narrow.
  Na,
  /// Wide.
  W,
}

impl EastAsianWidth {
  /// Returns the `East_Asian_Width` of the code point `cp`. A value past U+10FFFF gets `N`.
  @inlineAlways
  pub fn of(cp: u32) -> EastAsianWidth {
    return EastAsianWidth.fromTableValue(unicode_data.eastAsianWidth(cp))
  }

  /// Returns the value for the packed number `value` from `unicode_data.eastAsianWidth`. An unknown
  /// number gives `N`.
  @inlineAlways
  pub fn fromTableValue(value: u32) -> EastAsianWidth {
    return match value {
      0 => EastAsianWidth.A
      1 => EastAsianWidth.F
      2 => EastAsianWidth.H
      4 => EastAsianWidth.Na
      5 => EastAsianWidth.W
      _ => EastAsianWidth.N
    }
  }
}

