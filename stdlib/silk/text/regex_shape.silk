//! The structure of an ECMAScript Unicode regular expression, read during compilation.
//!
//! # When to use
//! Use `RegexShape.of` in static code that needs to know whether a pattern is valid and which
//! capture groups it has before the program runs, such as a library that types a pattern's
//! captures. Use `silk.text.regex` to compile and search at run time.
//!
//! # Details
//! `RegexShape.of` reads a pattern the way `Regex.compile` does: the same ECMAScript Unicode (`u`)
//! grammar, the same error messages and offsets, and the same Unicode property names. It builds no
//! program. Two resource limits are checked only by `Regex.compile`, because only the program
//! reveals them: too many class ranges and too many nested quantifiers.
//!
//! A typed pattern names its groups after fields, so a group name here must be an ASCII
//! identifier written out; a name with a `\u` escape or a non-ASCII character is reported as an
//! error even though `Regex.compile` accepts it.
//!
//! Reading a pattern is static work and counts against the static evaluation budget: a run of
//! plain characters costs a few dozen steps a byte, and a group or quantified term a few hundred,
//! so patterns of several hundred bytes fit comfortably while one with hundreds of groups does
//! not.
//!
//! # Examples
//! ## Read a pattern's groups at compile time
//! ```silk
//! import silk.core.static_sequence { StaticSequence }
//! import silk.text.regex_shape { RegexGroup, RegexShape }
//!
//! static fn secondName() -> string<'static> {
//!   let shape = RegexShape.of("(?<year>\\d{4})-(?<month>\\d{2})?")
//!   if !shape.valid {
//!     compileError(shape.message)
//!   }
//!   let month = StaticSequence.at<RegexGroup>(shape.groups, 1)
//!   if !month.optional {
//!     compileError("month sits under ?")
//!   }
//!   return month.name
//! }
//!
//! pub fn main() -> i32 {
//!   if secondName() != "month" {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Text

import silk.core.static_sequence { StaticSequence }
import silk.core.static_text { StaticText }
import silk.num.i32
import silk.num.u32
import silk.num.u8
import silk.text.regex_unicode { UnicodeProperties }

/// One capture group of a pattern.
pub struct RegexGroup {
  /// The group's number: 1 for the first group that captures, counting each `(` in pattern order.
  pub number: usize,
  /// The name in `(?<name>...)`, or empty for an unnamed group.
  pub name: string<'static>,
  /// The byte offset of the group's `(` in the pattern.
  pub offset: usize,
  /// Whether a match can leave the group unset: it sits under `?`, `*` or a `{0,n}` repetition,
  /// in one alternative of a `|`, or inside a negative lookaround.
  pub optional: bool
}

/// Whether a pattern is valid and, when it is, its capture groups.
pub struct RegexShape {
  /// Whether `Regex.compile` would accept the pattern.
  pub valid: bool,
  /// For an invalid pattern, whether it exceeds a resource limit rather than breaking the grammar.
  pub limit: bool,
  /// What is wrong, as `RegexError.message` words it; empty for a valid pattern and a size limit.
  pub message: string<'static>,
  /// The byte offset in the pattern where the problem was found, as `RegexError.offset` gives it.
  pub offset: usize,
  /// The capture groups in number order, group 1 first; empty for an invalid pattern.
  pub groups: Intrinsic.StaticSequence<RegexGroup>
}

// The limits Regex.compile applies.
const MAX_PATTERN_BYTES: usize = 65536

const MAX_DEPTH: usize = 256

const MAX_CAPTURES: usize = 255

// ASCII bytes that stand for themselves outside a class: everything but the syntax characters.
const PLAIN: [bool; 128] = [
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  false,
  true,
  true,
  true,
  false,
  false,
  false,
  false,
  true,
  true,
  false,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  false,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  false,
  false,
  false,
  false,
  true,
  true,
