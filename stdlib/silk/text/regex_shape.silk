  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  true,
  false,
  false,
  false,
  true,
  true,
]

const FRAME_TOP: u8 = 0

const FRAME_GROUP: u8 = 1

const FRAME_LOOKAROUND: u8 = 2

// The outcome of reading one piece of a pattern: a failure, or where reading stopped and, for an
// atom, the character or whether it is a set.
struct Piece {
  failed: bool,
  message: string<'static>,
  offset: usize,
  next: usize,
  code: u32,
  isSet: bool
}

static fn fails(message: string<'static>, offset: usize) -> Piece {
  return Piece {
    failed: true,
    message: message,
    offset: offset,
    next: offset,
    code: 0,
    isSet: false,
  }
}

static fn literal(code: u32, next: usize) -> Piece {
  return Piece { failed: false, message: "", offset: 0, next: next, code: code, isSet: false }
}

static fn set(next: usize) -> Piece {
  return Piece { failed: false, message: "", offset: 0, next: next, code: 0, isSet: true }
}

// A group name the way the engine reads it: ok, and the name's bytes and the offset after `>`.
struct Name {
  ok: bool,
  plain: bool,
  start: usize,
  end: usize,
  next: usize
}

static fn failure(message: string<'static>, offset: usize) -> RegexShape {
  return RegexShape {
    valid: false,
    limit: false,
    message: message,
    offset: offset,
    groups: StaticSequence.empty<RegexGroup>(),
  }
}

static fn limited(message: string<'static>) -> RegexShape {
  return RegexShape {
    valid: false,
    limit: true,
    message: message,
    offset: 0,
    groups: StaticSequence.empty<RegexGroup>(),
  }
}

// The byte at index, or 0 past the end, as the engine reads it.
static fn at(pattern: string, length: usize, index: usize) -> u8 {
  if index >= length {
    return 0
  }
  return StaticText.byteAt(pattern, index)
}

static fn isDigit(c: u8) -> bool {
  return c >= 48 && c <= 57
}

static fn hexValue(c: u8) -> i32 {
  if c >= 48 && c <= 57 {
    return u8.toI32(c - 48)
  }
  if c >= 65 && c <= 70 {
    return u8.toI32(c - 55)
  }
  if c >= 97 && c <= 102 {
    return u8.toI32(c - 87)
  }
  return -1
}

static fn isPropertyByte(c: u8) -> bool {
  return (c >= 48 && c <= 57) || (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95
}

static fn isNameStart(c: u8) -> bool {
  return (c >= 65 && c <= 90) || (c >= 97 && c <= 122) || c == 95 || c == 36
}

static fn isNameContinue(c: u8) -> bool {
  return isNameStart(c) || (c >= 48 && c <= 57)
}

// A run of decimal digits from offset: its value, capped at i32.MAX when overflow is allowed and
// -1 (with next at offset) when it is not.
struct Digits {
  value: i32,
  next: usize
}

static fn digits(pattern: string, length: usize, offset: usize, allowOverflow: bool) -> Digits {
  let mut p = offset
  let mut value: i32 = 0
  while p < length && isDigit(StaticText.byteAt(pattern, p)) {
    let digit = u8.toI32(StaticText.byteAt(pattern, p) - 48)
    if value > 214748364 || (value == 214748364 && digit >= 7) {
      if !allowOverflow {
        return Digits { value: -1, next: offset }
      }
      value = 2147483647
    } else {
      value = value * 10 + digit
    }
    p = p + 1
  }
  return Digits { value: value, next: p }
}

// One UTF-8 scalar starting at offset; the pattern is a Silk string, so it is well formed.
static fn scalar(pattern: string, offset: usize) -> Piece {
  let lead = u8.toU32(StaticText.byteAt(pattern, offset))
  if lead < 128 {
    return literal(lead, offset + 1)
  }
  let mut count: usize = 2
  let mut code = lead & 31
  if lead >= 240 {
    count = 4
    code = lead & 7
  } else if lead >= 224 {
    count = 3
    code = lead & 15
  }
  let mut i: usize = 1
  while i < count {
    code = code * 64 + (u8.toU32(StaticText.byteAt(pattern, offset + i)) & 63)
    i = i + 1
  }
  return literal(code, offset + count)
}

// The engine's parseEscape in Unicode mode; offset follows the backslash. A code of -1 or -2
// in a failed piece means the escape is malformed or is not a character escape.
static fn escape(pattern: string, length: usize, offset: usize) -> Piece {
  let c = at(pattern, length, offset)
  let mut p = offset + 1
  if c == 98 {
    return literal(8, p)
  }
  if c == 102 {
    return literal(12, p)
  }
  if c == 110 {
    return literal(10, p)
  }
  if c == 114 {
    return literal(13, p)
  }
  if c == 116 {
    return literal(9, p)
  }
  if c == 118 {
    return literal(11, p)
  }
  if c == 120 {
    let high = hexValue(at(pattern, length, p))
    let low = hexValue(at(pattern, length, p + 1))
    if high < 0 || low < 0 {
      return fails("", offset)
    }
    return literal(i32.toU32(high * 16 + low), p + 2)
  }
  if c == 117 {
    let mut code: u32 = 0
    if at(pattern, length, p) == 123 {
      p = p + 1
      while true {
        let h = hexValue(at(pattern, length, p))
        if h < 0 {
          return fails("", offset)
        }
        code = code * 16 + i32.toU32(h)
        p = p + 1
        if code > 1114111 {
          return fails("", offset)
        }
        if at(pattern, length, p) == 125 {
          break
        }
      }
      return literal(code, p + 1)
    }
    let mut i: usize = 0
    while i < 4 {
      let h = hexValue(at(pattern, length, p))
      if h < 0 {
        return fails("", offset)
      }
      code = code * 16 + i32.toU32(h)
      p = p + 1
      i = i + 1
    }
    if code >= 55296 && code <= 56319 && at(pattern, length, p) == 92
      && at(pattern, length, p + 1) == 117 {
      let mut second: u32 = 0
      i = 0
      while i < 4 {
        let h = hexValue(at(pattern, length, p + 2 + i))
        if h < 0 {
          break
        }
        second = second * 16 + i32.toU32(h)
        i = i + 1
      }
      if i == 4 && second >= 56320 && second <= 57343 {
        code = 65536 + (code - 55296) * 1024 + second - 56320
        p = p + 6
      }
    }
    return literal(code, p)
  }
  if c < 48 || c > 55 {
    return fails("", offset)
  }
  if c != 48 || isDigit(at(pattern, length, p)) {
    return fails("", offset)
  }
  return literal(0, p)
}

// The engine's parseUnicodeProperty; offset follows the `p` or `P`.
static fn property(pattern: string, length: usize, offset: usize) -> Piece {
  if at(pattern, length, offset) != 123 {
    return fails("expecting '{' after \\p", offset)
  }
  let start = offset + 1
  let mut p = start
  while isPropertyByte(at(pattern, length, p)) {
    if p - start >= 63 {
      return fails("unknown unicode property name", p)
    }
    p = p + 1
  }
  let name = StaticText.slice(pattern, start, p)
  let mut valueStart = p
  let mut valueLength: usize = 0
  if at(pattern, length, p) == 61 {
    p = p + 1
    valueStart = p
    while isPropertyByte(at(pattern, length, p)) {
      if p - valueStart >= 63 {
        return fails("unknown unicode property value", p)
      }
      p = p + 1
    }
    valueLength = p - valueStart
  }
  if at(pattern, length, p) != 125 {
    return fails("expecting '}'", p)
  }
  let value = StaticText.slice(pattern, valueStart, valueStart + valueLength)
  if name == "Script" || name == "sc" || name == "Script_Extensions" || name == "scx" {
    if !UnicodeProperties.isScriptName(value) {
      return fails("unknown unicode script", offset)
    }
  } else if name == "General_Category" || name == "gc" {
    if !UnicodeProperties.isCategoryName(value) {
      return fails("unknown unicode general category", offset)
    }
  } else if valueLength == 0 {
    if !UnicodeProperties.isCategoryName(name) && !UnicodeProperties.isBinaryName(name) {
      return fails("unknown unicode property name", offset)
    }
  } else {
    return fails("unknown unicode property name", offset)
  }
  return set(p + 1)
}

// The engine's parseClassAtom in Unicode mode without class sets; offset is the atom's first
// byte, its backslash for an escape.
static fn atom(pattern: string, length: usize, offset: usize, inClass: bool) -> Piece {
  if offset >= length {
    return fails("unexpected end", offset)
  }
  let mut p = offset
  let mut c = StaticText.byteAt(pattern, p)
  if c != 92 {
    return scalar(pattern, p)
  }
  p = p + 1
  if p >= length {
    return fails("unexpected end", p)
  }
  c = StaticText.byteAt(pattern, p)
  p = p + 1
  if c == 100 || c == 68 || c == 115 || c == 83 || c == 119 || c == 87 {
    return set(p)
  }
  if c == 99 {
    let control = at(pattern, length, p)
    if (control >= 65 && control <= 90) || (control >= 97 && control <= 122) {
      return literal(u8.toU32(control) & 31, p + 1)
    }
    return fails("invalid escape sequence in regular expression", offset)
  }
  if c == 45 {
    if !inClass {
      return fails("invalid escape sequence in regular expression", offset)
    }
    return literal(45, p)
  }
  if c == 94 || c == 36 || c == 92 || c == 46 || c == 42 || c == 43 || c == 63 || c == 40 || c == 41
    || c == 91
    || c == 93
    || c == 123
    || c == 125
    || c == 124
    || c == 47 {
    return literal(u8.toU32(c), p)
  }
  if c == 112 || c == 80 {
    return property(pattern, length, p)
  }
  let escaped = escape(pattern, length, p - 1)
  if escaped.failed {
    return fails("invalid escape sequence in regular expression", offset)
  }
  return move escaped
}

// The engine's parseClass in Unicode mode without class sets; offset is the `[`.
static fn class(pattern: string, length: usize, offset: usize) -> Piece {
  let mut p = offset + 1
  if at(pattern, length, p) == 94 {
    p = p + 1
  }
  while at(pattern, length, p) != 93 {
    let first = atom(pattern, length, p, true)
    if first.failed {
      return move first
    }
    p = first.next
    if at(pattern, length, p) == 45 && at(pattern, length, p + 1) != 93 {
      if first.isSet {
        return fails("invalid class range", p)
      }
      let last = atom(pattern, length, p + 1, true)
      if last.failed {
        return move last
      }
      if last.isSet || last.code < first.code {
        return fails("invalid class range", p)
      }
      p = last.next
    }
  }
  return set(p + 1)
}

// The engine's tryGroupName; offset follows the `<`. A name with an escape or a non-ASCII
// character is not plain.
static fn groupName(pattern: string, length: usize, offset: usize) -> Name {
  let mut p = offset
  let mut count: usize = 0
  while true {
    if p >= length {
      return Name { ok: false, plain: true, start: offset, end: offset, next: offset }
    }
    let c = StaticText.byteAt(pattern, p)
    if c == 62 {
      break
    }
    if c == 92 || c >= 128 {
      return Name { ok: false, plain: false, start: offset, end: offset, next: offset }
    }
    if (count == 0 && !isNameStart(c)) || (count != 0 && !isNameContinue(c)) || count + 7 > 128 {
      return Name { ok: false, plain: true, start: offset, end: offset, next: offset }
    }
    count = count + 1
    p = p + 1
  }
  if count == 0 {
    return Name { ok: false, plain: true, start: offset, end: offset, next: offset }
  }
  return Name { ok: true, plain: true, start: offset, end: p, next: p + 1 }
}

// The engine's countCaptures: the groups the whole pattern opens, counting group 0, capped at
// the capture limit.
static fn countCaptures(pattern: string, length: usize) -> usize {
  let mut count: usize = 1
  let mut p: usize = 0
  while p < length {
    let c = StaticText.byteAt(pattern, p)
    if c == 40 {
      if at(pattern, length, p + 1) != 63 {
        count = count + 1
      } else if at(pattern, length, p + 2) == 60 && at(pattern, length, p + 3) != 61
        && at(pattern, length, p + 3) != 33 {
        count = count + 1
      }
      if count >= MAX_CAPTURES {
        break
      }
    } else if c == 92 {
      p = p + 1
    } else if c == 91 {
      p = p + 1
      while p < length && StaticText.byteAt(pattern, p) != 93 {
        if StaticText.byteAt(pattern, p) == 92 {
          p = p + 1
        }
        p = p + 1
      }
    }
    p = p + 1
  }
  return count
}

static fn sameText(
  pattern: string,
  start: usize,
  end: usize,
  otherStart: usize,
  otherEnd: usize,
) -> bool {
  if end - start != otherEnd - otherStart {
    return false
  }
  let mut i: usize = 0
  while i < end - start {
    if StaticText.byteAt(pattern, start + i) != StaticText.byteAt(pattern, otherStart + i) {
      return false
    }
    i = i + 1
  }
  return true
}

// Whether a group named like pattern[start, end) appears anywhere in the pattern, for a
// reference that comes before its group.
static fn nameAnywhere(pattern: string, length: usize, start: usize, end: usize) -> bool {
  let mut index: usize = 1
  let mut p: usize = 0
  while p < length {
    let c = StaticText.byteAt(pattern, p)
    if c == 40 {
      if at(pattern, length, p + 1) != 63 {
        index = index + 1
      } else if at(pattern, length, p + 2) == 60 && at(pattern, length, p + 3) != 61
        && at(pattern, length, p + 3) != 33 {
        let name = groupName(pattern, length, p + 3)
        if name.ok {
          if sameText(pattern, name.start, name.end, start, end) {
            return true
          }
          p = name.next - 1
        } else {
          p = p + 2
        }
        index = index + 1
      }
      if index >= MAX_CAPTURES {
        break
      }
    } else if c == 92 {
      p = p + 1
    } else if c == 91 {
      p = p + 1
      while p < length && StaticText.byteAt(pattern, p) != 93 {
        if StaticText.byteAt(pattern, p) == 92 {
          p = p + 1
        }
        p = p + 1
      }
    }
    p = p + 1
  }
  return false
}

// The engine's quantifier in Unicode mode, after a term: where it ends and its minimum count
// (code), or no quantifier (next at offset, code 1).
static fn quantifier(pattern: string, length: usize, offset: usize) -> Piece {
  let c = at(pattern, length, offset)
  let mut p = offset
  let mut minimum: u32 = 1
  if c == 42 || c == 63 {
    minimum = 0
    p = offset + 1
  } else if c == 43 {
    p = offset + 1
  } else if c == 123 {
    if !isDigit(at(pattern, length, offset + 1)) {
      return fails("invalid repetition count", offset)
    }
    let low = digits(pattern, length, offset + 1, true)
    minimum = i32.toU32(low.value)
    p = low.next
    if at(pattern, length, p) == 44 {
      p = p + 1
      if isDigit(at(pattern, length, p)) {
        let high = digits(pattern, length, p, true)
        p = high.next
        if high.value < low.value {
          return fails("invalid repetition count", p)
        }
      }
    }
    if at(pattern, length, p) != 125 {
      return fails("expecting '}'", p)
    }
    p = p + 1
  } else {
    return literal(1, offset)
  }
  if at(pattern, length, p) == 63 {
    p = p + 1
  }
  return literal(minimum, p)
}

// What modifiers like `ims` at offset read as: a bit mask in code, or a duplicate.
static fn modifiers(pattern: string, length: usize, offset: usize) -> Piece {
  let mut mask: u32 = 0
  let mut p = offset
  while true {
    let c = at(pattern, length, p)
    let mut value: u32 = 0
    if c == 105 {
      value = 1
    } else if c == 109 {
      value = 2
    } else if c == 115 {
      value = 4
    }
    if value == 0 {
      return literal(mask, p)
    }
    if (mask & value) != 0 {
      if c == 105 {
        return fails("duplicate modifier: 'i'", p)
      }
      if c == 109 {
        return fails("duplicate modifier: 'm'", p)
      }
      return fails("duplicate modifier: 's'", p)
    }
    mask = mask | value
    p = p + 1
  }
  return literal(mask, p)
}

impl RegexShape {
  /// Reads an ECMAScript Unicode (`u`) pattern as `Regex.compile` would, without compiling it.
  ///
  /// # Details
  /// A valid pattern lists every capture group, named or not, in number order. An invalid one
  /// carries the message and offset `Regex.compile` would report, and `limit` for a pattern
  /// longer than 65,536 bytes, groups nested deeper than 255 levels, or 255 or more captures.
  /// Group names must be ASCII identifiers written out, as the module documentation explains.
  pub static fn of(pattern: string) -> RegexShape {
    let length = StaticText.byteLength(pattern)
    if length > MAX_PATTERN_BYTES {
      return limited("")
    }

    // Open disjunctions, the pattern itself at depth 0: their kind, whether a lookaround is
    // negative, the first capture inside, and whether a `|` split them.
    let mut kinds: [u8; 257] = [0; 257]
    let mut negative: [bool; 257] = [false; 257]
    let mut firstCapture: [usize; 257] = [0; 257]
    let mut split: [bool; 257] = [false; 257]
    let mut termCaptures: [usize; 257] = [0; 257]

    // Capture groups by number.
    let mut nameStart: [usize; 256] = [0; 256]
    let mut nameEnd: [usize; 256] = [0; 256]
    let mut scopes: [u8; 256] = [0; 256]
    let mut openings: [usize; 256] = [0; 256]
    let mut optional: [bool; 256] = [false; 256]

    let mut depth: usize = 0
    let mut captures: usize = 1
    let mut scope: u8 = 0
    let mut cursor: usize = 0
    kinds[0] = FRAME_TOP
    firstCapture[0] = 1
    while true {
      let c = at(pattern, length, cursor)
      if cursor < length && c != 124 && c != 41 {
        let p = cursor
        let before = captures
        if c == 40 {
          // A group: read its opening, then its disjunction as the new innermost frame.
          let mut kind = FRAME_GROUP
          let mut isNegative = false
          let mut capture = true
          let mut named = false
          let mut name = Name { ok: false, plain: true, start: 0, end: 0, next: 0 }
          if at(pattern, length, p + 1) == 63 {
            let next = at(pattern, length, p + 2)
            if next == 58 {
              cursor = p + 3
              capture = false
            } else if next == 105 || next == 109 || next == 115 || next == 45 {
              let add = modifiers(pattern, length, p + 2)
              if add.failed {
                return failure(add.message, add.offset)
              }
              cursor = add.next
              let mut remove: u32 = 0
              if at(pattern, length, cursor) == 45 {
                let removed = modifiers(pattern, length, cursor + 1)
                if removed.failed {
                  return failure(removed.message, removed.offset)
                }
                remove = removed.code
                cursor = removed.next
              }
              if (add.code == 0 && remove == 0) || (add.code & remove) != 0 {
                return failure("invalid modifiers", cursor)
              }
              if at(pattern, length, cursor) != 58 {
                return failure("expecting ':'", cursor)
              }
              cursor = cursor + 1
              capture = false
            } else if next == 61 || next == 33
              || (next == 60
                && (at(pattern, length, p + 3) == 61 || at(pattern, length, p + 3) == 33)) {
              kind = FRAME_LOOKAROUND
              capture = false
              cursor = p + 3
              isNegative = next == 33
              if next == 60 {
                isNegative = at(pattern, length, p + 3) == 33
                cursor = p + 4
              }
            } else if next == 60 {
              name = groupName(pattern, length, p + 3)
              if !name.ok {
                if !name.plain {
                  return failure(
                    "a typed pattern's group name must be an ASCII identifier, without escapes",
                    p + 3,
                  )
                }
                return failure("invalid group name", p + 3)
              }
              let mut other: usize = 1
              while other < captures {
                if nameEnd[other] != 0 && scopes[other] == scope
                  && sameText(pattern, nameStart[other], nameEnd[other], name.start, name.end) {
                  return failure("duplicate group name", p)
                }
                other = other + 1
              }
              cursor = name.next
              named = true
            } else {
              return failure("invalid group", p)
            }
          } else {
            cursor = p + 1
          }
          if capture {
            if captures >= MAX_CAPTURES {
              return limited("too many captures")
            }
            if named {
              nameStart[captures] = name.start
              nameEnd[captures] = name.end
            }
            scopes[captures] = scope
            openings[captures] = p
            captures = captures + 1
          }
          if depth + 1 >= MAX_DEPTH {
            return limited("")
          }
          depth = depth + 1
          kinds[depth] = kind
          negative[depth] = isNegative
          firstCapture[depth] = captures
          split[depth] = false
          termCaptures[depth] = before
        } else {
          // Any other term, then its quantifier.
          let mut quantifiable = true
          if c < 128 && PLAIN[u8.toUsize(c)] {
            // A run of plain characters, read at once: only the last can take a quantifier.
            cursor = p + 1
            while cursor < length {
              let d = StaticText.byteAt(pattern, cursor)
              if d >= 128 || !PLAIN[u8.toUsize(d)] {
                break
              }
              cursor = cursor + 1
            }
          } else if c == 94 || c == 36 {
            cursor = p + 1
            quantifiable = false
          } else if c == 46 {
            cursor = p + 1
          } else if c == 42 || c == 43 || c == 63 {
            return failure("nothing to repeat", p)
          } else if c == 123 {
            return failure("syntax error", p)
          } else if c == 91 {
            let read = class(pattern, length, p)
            if read.failed {
              return failure(read.message, read.offset)
            }
            cursor = read.next
          } else if c == 92
            && (at(pattern, length, p + 1) == 98 || at(pattern, length, p + 1) == 66) {
            cursor = p + 2
            quantifiable = false
          } else if c == 92 && at(pattern, length, p + 1) == 107 {
            if at(pattern, length, p + 2) != 60 {
              return failure("expecting group name", p)
            }
            let name = groupName(pattern, length, p + 3)
            if !name.ok {
              return failure("invalid group name", p)
            }
            let mut found = false
            let mut other: usize = 1
            while other < captures && !found {
              found = nameEnd[other] != 0
                && sameText(pattern, nameStart[other], nameEnd[other], name.start, name.end)
              other = other + 1
            }
            if !found && !nameAnywhere(pattern, length, name.start, name.end) {
              return failure("group name not defined", p)
            }
            cursor = name.next
          } else if c == 92 && at(pattern, length, p + 1) >= 49
            && at(pattern, length, p + 1) <= 57 {
            let number = digits(pattern, length, p + 1, false)
            if number.value < 0
              || (i32.toUsize(number.value) >= captures
                && i32.toUsize(number.value) >= countCaptures(pattern, length)) {
              return failure("back reference out of range in regular expression", p)
            }
            cursor = number.next
          } else {
            if c == 93 || c == 125 {
              return failure("syntax error", p)
            }
            if c == 92 && at(pattern, length, p + 1) == 48 && isDigit(at(pattern, length, p + 2)) {
              return failure("invalid decimal escape in regular expression", p)
            }
            let read = atom(pattern, length, p, false)
            if read.failed {
              return failure(read.message, read.offset)
            }
            cursor = read.next
          }
          if quantifiable {
            let repeat = quantifier(pattern, length, cursor)
            if repeat.failed {
              return failure(repeat.message, repeat.offset)
            }
            cursor = repeat.next
          }
        }
      } else if c == 124 {
        cursor = cursor + 1
        split[depth] = true

        // The engine's scope byte wraps.
        if scope == 255 {
          scope = 0
        } else {
          scope = scope + 1
        }
      } else {
        // The end of the innermost disjunction.
        if split[depth] || (kinds[depth] == FRAME_LOOKAROUND && negative[depth]) {
          let mut index = firstCapture[depth]
          while index < captures {
            optional[index] = true
            index = index + 1
          }
        }
        if depth == 0 {
          if cursor != length {
            return failure("extraneous characters at the end", cursor)
          }
          let mut groups = StaticSequence.empty<RegexGroup>()
          let mut number: usize = 1
          while number < captures {
            groups = StaticSequence.append<RegexGroup>(
              move groups,
              RegexGroup {
                number: number,
                name: StaticText.slice(pattern, nameStart[number], nameEnd[number]),
                offset: openings[number],
                optional: optional[number],
              },
            )
            number = number + 1
          }
          return RegexShape {
            valid: true,
            limit: false,
            message: "",
            offset: 0,
            groups: move groups,
          }
        }
        if at(pattern, length, cursor) != 41 {
          return failure("expecting ')'", cursor)
        }
        cursor = cursor + 1
        let closed = depth
        depth = depth - 1
        if kinds[closed] != FRAME_LOOKAROUND {
          let repeat = quantifier(pattern, length, cursor)
          if repeat.failed {
            return failure(repeat.message, repeat.offset)
          }
          cursor = repeat.next
          if repeat.code == 0 {
            let mut index = termCaptures[closed]
            while index < captures {
              optional[index] = true
              index = index + 1
            }
          }
        }
      }
    }
    return failure("unexpected end", length)
  }
}
