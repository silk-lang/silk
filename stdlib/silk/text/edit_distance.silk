//! Edit distances: the smallest number of single-character edits that turn one text into another.
//!
//! # When to use
//! Use these functions to find the closest spelling to a misspelled name, such as a suggestion
//! for an unknown command-line option, to rank fuzzy search results, or to find near-duplicate
//! keys. [`damerauLevenshtein`] is the usual choice for typing errors, because a swap of two
//! neighbouring characters, such as `nmae` for `name`, counts as one edit.
//!
//! # Details
//! Each function counts four kinds of edit: insert one character, delete one character, replace
//! one character, and swap two neighbouring characters.
//!
//! - [`damerauLevenshtein`] is the true Damerau-Levenshtein distance. An edit can change text
//!   that an earlier edit made, so `ca` to `abc` is two edits: swap to `ac`, then insert `b`.
//! - [`optimalStringAlignment`] does not edit a substring more than once, so `ca` to `abc` is
//!   three edits. It is a little faster, and it is the variant that many libraries call
//!   "Damerau-Levenshtein".
//!
//! The `string` forms count Unicode scalar values. The `Bytes` forms count bytes, which is
//! faster and correct for ASCII text, identifiers, and binary data.
//!
//! The distances are symmetric, and they are zero only for equal inputs. The text that the two
//! inputs share at the start and at the end is skipped before the main work. Both functions
//! use memory proportional to the shorter length. [`damerauLevenshtein`] takes time proportional
//! to the product of the two lengths. [`optimalStringAlignment`] processes 64 characters of the
//! shorter input at a time with bit operations, so it is much faster on long inputs. Inputs of
//! at most 64 characters each, after the shared start and end, do not allocate.
//!
//! # Examples
//! ## Suggest the closest known name
//! ```silk
//! import silk.text.edit_distance
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.core.effect { Effect }
//!
//! effect fn suggest() -> i32 ! OutOfMemoryError ? &mut Allocator {
//!   let known = ["build", "check", "format", "test"]
//!   let written = "fromat"
//!   let mut best: usize = 0
//!   let mut bestDistance = run edit_distance.damerauLevenshtein(written, known[0])
//!   let mut at: usize = 1
//!   while at < known.length {
//!     let distance = run edit_distance.damerauLevenshtein(written, known[at])
//!     if distance < bestDistance {
//!       best = at
//!       bestDistance = distance
//!     }
//!     at = at + 1
//!   }
//!   if best != 2 || bestDistance != 1 {
//!     return 1
//!   }
//!   return 0
//! }
//!
//! effect fn exhausted(error: OutOfMemoryError) -> i32 {
//!   drop error
//!   return 2
//! }
//!
//! pub fn main() -> i32 {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   return run Effect.catchAll(suggest(), exhausted) |> Effect.provideMut<Allocator>(&mut allocator)
//! }
//! ```
//!
//! @category Text

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.text.string { String }
import silk.num.u8
import silk.num.u32
import silk.num.u64
import silk.num.usize

/// Returns the Damerau-Levenshtein distance between `left` and `right`, counted in Unicode scalar
/// values.
///
/// # When to use
///
/// Use this function to measure how far apart two texts are when people type them, for example to
/// suggest the closest known name for a misspelled one.
///
/// # Details
///
/// The result is the smallest number of edits that turn `left` into `right`. An edit inserts,
/// deletes, or replaces one scalar value, or swaps two neighbouring scalar values. Later edits can
/// change text that earlier edits made, so `"ca"` to `"abc"` is 2. The time is proportional to the
/// product of the lengths and the memory to the shorter length.
///
/// # Errors
///
/// - `OutOfMemoryError` if the `Allocator` cannot supply the scratch rows. ASCII inputs of at
///   most 64 bytes each, after the shared start and end, do not allocate.
///
/// # Gotchas
///
/// A scalar value is not always one visible character: `"é"` written as `e` followed by a
/// combining accent is two scalar values. Normalize both texts first if that matters.
///
/// # Examples
///
/// ## Count a swap as one edit
///
/// ```silk
/// import silk.text.edit_distance
/// import silk.mem.allocator { Allocator, OutOfMemoryError }
/// import silk.core.effect { Effect }
///
/// effect fn check() -> i32 ! OutOfMemoryError ? &mut Allocator {
///   let swapped = run edit_distance.damerauLevenshtein("nmae", "name")
///   let replaced = run edit_distance.damerauLevenshtein("café", "cafe")
///   let rebuilt = run edit_distance.damerauLevenshtein("ca", "abc")
///   if swapped != 1 || replaced != 1 || rebuilt != 2 {
///     return 1
///   }
///   return 0
/// }
///
/// effect fn exhausted(error: OutOfMemoryError) -> i32 {
///   drop error
///   return 2
/// }
///
/// pub fn main() -> i32 {
///   let mut allocator = Allocator.systemAllocatorProvider()
///   return run Effect.catchAll(check(), exhausted) |> Effect.provideMut<Allocator>(&mut allocator)
/// }
/// ```
pub effect fn damerauLevenshtein(left: string, right: string) -> usize
  ! OutOfMemoryError
  ? &mut Allocator {
  return run measure(String.utf8Bytes(left), String.utf8Bytes(right), true, true)
}

/// Returns the Damerau-Levenshtein distance between `left` and `right`, counted in bytes.
///
/// # When to use
///
/// Use this function for ASCII text, identifiers, and binary data. For text that can contain other
/// characters, use [`damerauLevenshtein`], which counts Unicode scalar values.
///
/// # Details
///
/// The result is the smallest number of edits that turn `left` into `right`. An edit inserts,
/// deletes, or replaces one byte, or swaps two neighbouring bytes. Later edits can change bytes
/// that earlier edits made, so `ca` to `abc` is 2. The time is proportional to the product of the
/// lengths and the memory to the shorter length.
///
/// # Errors
///
/// - `OutOfMemoryError` if the `Allocator` cannot supply the scratch rows. Inputs of at most 64
///   bytes each, after the shared start and end, do not allocate.
///
/// # Examples
///
/// ## Measure two byte strings
///
/// ```silk
/// import silk.text.edit_distance
/// import silk.mem.allocator { Allocator, OutOfMemoryError }
/// import silk.core.effect { Effect }
///
/// effect fn check() -> i32 ! OutOfMemoryError ? &mut Allocator {
///   let swapped = run edit_distance.damerauLevenshteinBytes(b"--relaese", b"--release")
///   let plural = run edit_distance.damerauLevenshteinBytes(b"dependency", b"dependencies")
///   let empty = run edit_distance.damerauLevenshteinBytes(b"", b"abc")
///   if swapped != 1 || plural != 3 || empty != 3 {
///     return 1
///   }
///   return 0
/// }
///
/// effect fn exhausted(error: OutOfMemoryError) -> i32 {
///   drop error
///   return 2
/// }
///
/// pub fn main() -> i32 {
///   let mut allocator = Allocator.systemAllocatorProvider()
///   return run Effect.catchAll(check(), exhausted) |> Effect.provideMut<Allocator>(&mut allocator)
/// }
/// ```
pub effect fn damerauLevenshteinBytes(left: &[u8], right: &[u8]) -> usize
  ! OutOfMemoryError
  ? &mut Allocator {
  return run measure(left, right, false, true)
}

/// Returns the optimal string alignment distance between `left` and `right`, counted in Unicode
/// scalar values.
///
/// # When to use
///
/// Use this function when the variant of Damerau-Levenshtein distance that many other libraries
/// compute is needed, or when speed matters more than the exact distance. For the true
/// Damerau-Levenshtein distance, use [`damerauLevenshtein`].
///
/// # Details
///
/// The result is the smallest number of edits that turn `left` into `right`, when no substring is
/// edited more than once. An edit inserts, deletes, or replaces one scalar value, or swaps two
/// neighbouring scalar values. Because no substring is edited twice, `"ca"` to `"abc"` is 3. The
/// result is never less than [`damerauLevenshtein`]'s. The shorter text is processed 64 scalar
/// values at a time with bit operations, so the time is proportional to the longer length times
/// the shorter length divided by 64.
///
/// # Errors
///
/// - `OutOfMemoryError` if the `Allocator` cannot supply the scratch rows. ASCII inputs of at
///   most 64 bytes each, after the shared start and end, do not allocate.
///
/// # Gotchas
///
/// The distance does not obey the triangle inequality: `"ca"` to `"ac"` is 1 and `"ac"` to
/// `"abc"` is 1, but `"ca"` to `"abc"` is 3.
///
/// # Examples
///
/// ## Compare the two variants
///
/// ```silk
/// import silk.text.edit_distance
/// import silk.mem.allocator { Allocator, OutOfMemoryError }
/// import silk.core.effect { Effect }
///
/// effect fn check() -> i32 ! OutOfMemoryError ? &mut Allocator {
///   let aligned = run edit_distance.optimalStringAlignment("ca", "abc")
///   let exact = run edit_distance.damerauLevenshtein("ca", "abc")
///   let swapped = run edit_distance.optimalStringAlignment("naïve", "nalve")
///   if aligned != 3 || exact != 2 || swapped != 1 {
///     return 1
///   }
///   return 0
/// }
///
/// effect fn exhausted(error: OutOfMemoryError) -> i32 {
///   drop error
///   return 2
/// }
///
/// pub fn main() -> i32 {
///   let mut allocator = Allocator.systemAllocatorProvider()
///   return run Effect.catchAll(check(), exhausted) |> Effect.provideMut<Allocator>(&mut allocator)
/// }
/// ```
pub effect fn optimalStringAlignment(left: string, right: string) -> usize
  ! OutOfMemoryError
  ? &mut Allocator {
  return run measure(String.utf8Bytes(left), String.utf8Bytes(right), true, false)
}

/// Returns the optimal string alignment distance between `left` and `right`, counted in bytes.
///
/// # When to use
///
/// Use this function for ASCII text, identifiers, and binary data when the variant of
/// Damerau-Levenshtein distance that many other libraries compute is needed. For the true
/// distance, use [`damerauLevenshteinBytes`].
///
/// # Details
///
/// The result is the smallest number of edits that turn `left` into `right`, when no substring is
/// edited more than once. An edit inserts, deletes, or replaces one byte, or swaps two neighbouring
/// bytes. Because no substring is edited twice, `ca` to `abc` is 3. The shorter input is processed
/// 64 bytes at a time with bit operations, so the time is proportional to the longer length times
/// the shorter length divided by 64.
///
/// # Errors
///
/// - `OutOfMemoryError` if the `Allocator` cannot supply the scratch rows. Inputs of at most 64
///   bytes each, after the shared start and end, do not allocate.
///
/// # Examples
///
/// ## Measure two byte strings
///
/// ```silk
/// import silk.text.edit_distance
/// import silk.mem.allocator { Allocator, OutOfMemoryError }
/// import silk.core.effect { Effect }
///
/// effect fn check() -> i32 ! OutOfMemoryError ? &mut Allocator {
///   let swapped = run edit_distance.optimalStringAlignmentBytes(b"pakcage", b"package")
///   let rebuilt = run edit_distance.optimalStringAlignmentBytes(b"ca", b"abc")
///   if swapped != 1 || rebuilt != 3 {
///     return 1
///   }
///   return 0
/// }
///
/// effect fn exhausted(error: OutOfMemoryError) -> i32 {
///   drop error
///   return 2
/// }
///
/// pub fn main() -> i32 {
///   let mut allocator = Allocator.systemAllocatorProvider()
///   return run Effect.catchAll(check(), exhausted) |> Effect.provideMut<Allocator>(&mut allocator)
/// }
/// ```
pub effect fn optimalStringAlignmentBytes(left: &[u8], right: &[u8]) -> usize
  ! OutOfMemoryError
  ? &mut Allocator {
  return run measure(left, right, false, false)
}

// The distance between `left` and `right`, which are UTF-8 text when `text` is set: the true
// Damerau-Levenshtein distance when `unrestricted` is set, else the optimal string alignment.
effect fn measure(left: &[u8], right: &[u8], text: bool, unrestricted: bool) -> usize
  ! OutOfMemoryError
  ? &mut Allocator {
  // The shared start and end change no distance, so only the middles are compared. In text they
  // end on scalar boundaries; the bytes that agree are the same in both, so one check covers both.
  let shortest = smaller(left.length, right.length)
  let mut start: usize = 0
  while start < shortest && left[start] == right[start] {
    start = start + 1
  }
  if text {
    while start > 0 && start < left.length && continuation(left[start]) {
      start = start - 1
    }
  }
  let mut end: usize = 0
  while end < shortest - start && left[left.length - end - 1] == right[right.length - end - 1] {
    end = end + 1
  }
  if text {
    while end > 0 && continuation(left[left.length - end]) {
      end = end - 1
    }
  }
  let leftMiddle = Slice.view<u8>(left, start, left.length - start - end)
  let rightMiddle = Slice.view<u8>(right, start, right.length - start - end)
  if leftMiddle.length == 0 || rightMiddle.length == 0 {
    if !text {
      return leftMiddle.length + rightMiddle.length
    }
    return scalars(leftMiddle) + scalars(rightMiddle)
  }

  // Symbols are bytes, or for text that is not ASCII, dense numbers for its scalar values.
  let mut wide = false
  if text {
    let mut at: usize = 0
    while at < leftMiddle.length && !wide {
      wide = leftMiddle[at] >= 128
      at = at + 1
    }
    at = 0
    while at < rightMiddle.length && !wide {
      wide = rightMiddle[at] >= 128
      at = at + 1
    }
  }

  // Up to 128 symbols, and rows for up to 64 columns, stay on the stack.
  let mut stackSymbols: [u32; 128] = [0; 128]
  let mut heapSymbols = List<u32>.make()
  let mut leftLength = leftMiddle.length
  let mut rightLength = rightMiddle.length
  let mut alphabet: usize = 256
  if wide {
    leftLength = run appendScalars(&mut heapSymbols, leftMiddle)
    rightLength = run appendScalars(&mut heapSymbols, rightMiddle)
    alphabet = run numberSymbols(&mut heapSymbols)
  } else if leftLength + rightLength > 128 {
    run List<u32>.reserveExact(&mut heapSymbols, leftLength + rightLength)
    run appendBytes(&mut heapSymbols, leftMiddle)
    run appendBytes(&mut heapSymbols, rightMiddle)
  } else {
    widen(&mut stackSymbols, 0, leftMiddle)
    widen(&mut stackSymbols, leftLength, rightMiddle)
  }
  let mut symbols: &[u32] = &stackSymbols
  if List<u32>.length(&heapSymbols) > 0 {
    symbols = List<u32>.asSlice(&heapSymbols)
  }

  // The rows run along the longer side and hold one cell per symbol of the shorter side.
  let mut rows = Slice.view<u32>(symbols, 0, leftLength)
  let mut columns = Slice.view<u32>(symbols, leftLength, rightLength)
  if rows.length < columns.length {
    let swapped = rows
    rows = columns
    columns = swapped
  }
  if unrestricted {
    return run unrestrictedDistance(rows, columns, alphabet)
  }
  return run alignmentDistance(rows, columns, alphabet)
}

effect fn unrestrictedDistance(rows: &[u32], columns: &[u32], alphabet: usize) -> usize
  ! OutOfMemoryError
  ? &mut Allocator {
  let width = columns.length + 2
  let mut stackLast: [usize; 256] = [0; 256]
  let mut heapLast = List<usize>.make()
  if alphabet > 256 {
    run List<usize>.appendRepeated(&mut heapLast, 0, alphabet)
  }
  if width <= 66 {
    let mut first: [usize; 66] = [0; 66]
    let mut second: [usize; 66] = [0; 66]
    let mut saved: [usize; 66] = [0; 66]
    let a = Slice.viewMut<usize>(&mut first, 0, width)
    let b = Slice.viewMut<usize>(&mut second, 0, width)
    let s = Slice.viewMut<usize>(&mut saved, 0, width)
    if alphabet > 256 {
      return zhao(rows, columns, move a, move b, move s, List<usize>.asMutSlice(&mut heapLast))
    }
    return zhao(rows, columns, move a, move b, move s, &mut stackLast)
  }
  let mut first = List<usize>.make()
  let mut second = List<usize>.make()
  let mut saved = List<usize>.make()
  run List<usize>.appendRepeated(&mut first, 0, width)
  run List<usize>.appendRepeated(&mut second, 0, width)
  run List<usize>.appendRepeated(&mut saved, 0, width)
  let a = List<usize>.asMutSlice(&mut first)
  let b = List<usize>.asMutSlice(&mut second)
  let s = List<usize>.asMutSlice(&mut saved)
  if alphabet > 256 {
    return zhao(rows, columns, move a, move b, move s, List<usize>.asMutSlice(&mut heapLast))
  }
  return zhao(rows, columns, move a, move b, move s, &mut stackLast)
}

// The true Damerau-Levenshtein distance in linear memory, after Zhao and Sahni, "String
// correction using the Damerau-Levenshtein distance" (2019). `rows` is the longer side and
// `columns` is not empty. `first`, `second` and `saved` each hold `columns.length + 2` cells, one
// per column from column -1: the first two are rows of the table, which take turns, and `saved`
// holds for each column the table value at its last match. `last` holds, for each symbol, the
// last row whose symbol it is, or 0; it starts as zeros.
fn zhao(
  rows: &[u32],
  columns: &[u32],
  first: &mut [usize],
  second: &mut [usize],
  saved: &mut [usize],
  last: &mut [usize],
) -> usize {
  // Larger than every distance, so that a transposition with no earlier match never wins.
  let far = rows.length + 1
  first[0] = far
  second[0] = far
  saved[0] = far
  let mut column: usize = 0
  while column <= columns.length {
    first[column + 1] = column
    second[column + 1] = far
    saved[column + 1] = far
    column = column + 1
  }

  // Row 0 is in `first`; the rows then alternate between `second` and `first`.
  let mut row: usize = 1
  while row < rows.length {
    zhaoRow(row, rows[row - 1], columns, &mut first, &mut second, &mut saved, &mut last, far)
    last[u32.toUsize(rows[row - 1])] = row
    zhaoRow(row + 1, rows[row], columns, &mut second, &mut first, &mut saved, &mut last, far)
    last[u32.toUsize(rows[row])] = row + 1
    row = row + 2
  }
  if row == rows.length {
    zhaoRow(row, rows[row - 1], columns, &mut first, &mut second, &mut saved, &mut last, far)
    return second[columns.length + 1]
  }
  return first[columns.length + 1]
}

// Fills `current`, row `row` of the table for the symbol `symbol`, from `previous`. `current`
// holds row `row - 2` on entry.
// The cells stay below twice the longer length, so wrapping arithmetic never wraps.
fn zhaoRow(
  row: usize,
  symbol: u32,
  columns: &[u32],
  previous: &mut [usize],
  current: &mut [usize],
  saved: &mut [usize],
  last: &mut [usize],
  far: usize,
) -> () {
  // Equal lengths let the optimizer drop the bounds checks in the loop.
  let width = columns.length + 2
  if previous.length != width || current.length != width || saved.length != width {
    return ()
  }

  // The last column in this row whose symbol is `symbol`, or 0.
  let mut matched: usize = 0

  // The table two rows up, one column left of the current column.
  let mut above = current[1]
  current[1] = row

  // The table two rows up, left of the last match in this row.
  let mut swapBase = far

  // `previous` one column left of the current column, and at it.
  let mut diagonal = previous[1]
  let mut left = row
  let mut column: usize = 1
  while column <= columns.length {
    let other = columns[column - 1]
    let up = previous[column + 1]
    let mut best = diagonal
    if symbol != other {
      best = usize.wrappingAdd(best, 1)
    }
    let inserted = usize.wrappingAdd(left, 1)
    if inserted < best {
      best = inserted
    }
    let deleted = usize.wrappingAdd(up, 1)
    if deleted < best {
      best = deleted
    }
    if symbol == other {
      matched = column
      saved[column + 1] = previous[column - 1]
      swapBase = above
    } else {
      let lastRow = last[u32.toUsize(other)]
      if usize.wrappingSubtract(column, matched) == 1 {
        let swapped = usize.wrappingAdd(saved[column + 1], usize.wrappingSubtract(row, lastRow))
        if swapped < best {
          best = swapped
        }
      } else if usize.wrappingSubtract(row, lastRow) == 1 {
        let swapped = usize.wrappingAdd(swapBase, usize.wrappingSubtract(column, matched))
        if swapped < best {
          best = swapped
        }
      }
    }
    above = current[column + 1]
    current[column + 1] = best
    diagonal = up
    left = best
    column = column + 1
  }
}

effect fn alignmentDistance(rows: &[u32], columns: &[u32], alphabet: usize) -> usize
  ! OutOfMemoryError
  ? &mut Allocator {
  if columns.length <= 64 {
    let mut stackMatches: [u64; 256] = [0; 256]
    if alphabet > 256 {
      let mut heapMatches = List<u64>.make()
      run List<u64>.appendRepeated(&mut heapMatches, 0, alphabet)
      return alignmentWord(rows, columns, List<u64>.asMutSlice(&mut heapMatches))
    }
    return alignmentWord(rows, columns, &mut stackMatches)
  }
  let words = (columns.length + 63) / 64
  let mut matches = List<u64>.make()
  run List<u64>.appendRepeated(&mut matches, 0, alphabet * words)
  let mut first = List<u64>.make()
  let mut second = List<u64>.make()
  run List<u64>.appendRepeated(&mut first, 0, 4 * (words + 1))
  run List<u64>.appendRepeated(&mut second, 0, 4 * (words + 1))
  return alignmentWords(
    rows,
    columns,
    List<u64>.asMutSlice(&mut matches),
    List<u64>.asMutSlice(&mut first),
    List<u64>.asMutSlice(&mut second),
  )
}

// The optimal string alignment distance for at most 64 `columns`, one row of the table per word,
// after Hyyrö, "A bit-vector algorithm for computing Levenshtein and Damerau edit distances"
// (2003). Bit `i` of a word stands for column `i`. `matches` starts as zeros.
fn alignmentWord(rows: &[u32], columns: &[u32], matches: &mut [u64]) -> usize {
  let mut column: usize = 0
  while column < columns.length {
    let symbol = u32.toUsize(columns[column])
    matches[symbol] = matches[symbol] | u64.shiftLeft(1, usize.toU64(column))
    column = column + 1
  }

  // The columns where the table rises or falls by one from the row above.
  let mut rising = u64.MAX
  let mut falling: u64 = 0

  // The columns where the table keeps its diagonal value.
  let mut diagonal: u64 = 0
  let mut before: u64 = 0
  let mut distance = columns.length
  let top = u64.shiftLeft(1, usize.toU64(columns.length - 1))
  let mut row: usize = 0
  while row < rows.length {
    let found = matches[u32.toUsize(rows[row])]
    let swapped = u64.shiftLeft(u64.bitNot(diagonal) & found, 1) & before
    diagonal = u64.bitXor(u64.wrappingAdd(found & rising, rising), rising) | found | falling
      | swapped
    let mut up = falling | u64.bitNot(diagonal | rising)
    let down = diagonal & rising
    if up & top != 0 {
      distance = distance + 1
    }
    if down & top != 0 {
      distance = distance - 1
    }
    up = u64.shiftLeft(up, 1) | 1
    rising = u64.shiftLeft(down, 1) | u64.bitNot(diagonal | up)
    falling = up & diagonal
    before = found
    row = row + 1
  }
  return distance
}

// The optimal string alignment distance for more than 64 `columns`, in blocks of 64 columns. Word
// `w` of symbol `s` is `matches[s * words + w]` and starts as zeros. `first` and `second` hold
// the state of one row, which take turns: for each block from block -1, the rising, falling,
// diagonal and match words, all zeros on entry.
fn alignmentWords(
  rows: &[u32],
  columns: &[u32],
  matches: &mut [u64],
  first: &mut [u64],
  second: &mut [u64],
) -> usize {
  let words = (columns.length + 63) / 64
  let mut column: usize = 0
  while column < columns.length {
    let at = u32.toUsize(columns[column]) * words + column / 64
    matches[at] = matches[at] | u64.shiftLeft(1, usize.toU64(column % 64))
    column = column + 1
  }
  let mut block: usize = 0
  while block <= words {
    first[4 * block] = u64.MAX
    second[4 * block] = u64.MAX
    block = block + 1
  }
  let top = u64.shiftLeft(1, usize.toU64((columns.length - 1) % 64))
  let mut distance = columns.length
  let mut row: usize = 0
  while row < rows.length {
    distance = alignmentBlocks(
      &mut matches,
      u32.toUsize(rows[row]) * words,
      words,
      top,
      distance,
      &mut first,
      &mut second,
    )
    row = row + 1
    if row < rows.length {
      distance = alignmentBlocks(
        &mut matches,
        u32.toUsize(rows[row]) * words,
        words,
        top,
        distance,
        &mut second,
        &mut first,
      )
      row = row + 1
    }
  }
  return distance
}

// Advances `distance` by one row whose match words start at `matches[offset]`, from the state
// `before` into the state `after`.
fn alignmentBlocks(
  matches: &mut [u64],
  offset: usize,
  words: usize,
  top: u64,
  distance: usize,
  before: &mut [u64],
  after: &mut [u64],
) -> usize {
  let mut result = distance
  let mut risingCarry: u64 = 1
  let mut fallingCarry: u64 = 0
  let mut block: usize = 0
  while block < words {
    let at = 4 * (block + 1)
    let rising = before[at]
    let falling = before[at + 1]
    let diagonal = before[at + 2]
    let found = matches[offset + block]

    // Swaps reach across the block boundary through the top bit of the block below.
    let swapped = (u64.shiftLeft(u64.bitNot(diagonal) & found, 1)
      | u64.shiftRight(u64.bitNot(before[at - 2]) & after[at - 1], 63))
      & before[at + 3]
    let entering = found | fallingCarry
    let reached = u64.bitXor(u64.wrappingAdd(entering & rising, rising), rising) | entering
      | falling
      | swapped
    let mut up = falling | u64.bitNot(reached | rising)
    let mut down = reached & rising
    if block + 1 == words {
      if up & top != 0 {
        result = result + 1
      }
      if down & top != 0 {
        result = result - 1
      }
    }
    let upCarry = u64.shiftRight(up, 63)
    up = u64.shiftLeft(up, 1) | risingCarry
    risingCarry = upCarry
    let downCarry = u64.shiftRight(down, 63)
    down = u64.shiftLeft(down, 1) | fallingCarry
    fallingCarry = downCarry
    after[at] = down | u64.bitNot(reached | up)
    after[at + 1] = up & reached
    after[at + 2] = reached
    after[at + 3] = found
    block = block + 1
  }
  return result
}

// Whether `byte` continues a UTF-8 sequence.
fn continuation(byte: u8) -> bool {
  return byte >= 128 && byte < 192
}

// The number of scalar values in the UTF-8 text `bytes`.
fn scalars(bytes: &[u8]) -> usize {
  let mut count: usize = 0
  let mut at: usize = 0
  while at < bytes.length {
    if !continuation(bytes[at]) {
      count = count + 1
    }
    at = at + 1
  }
  return count
}

// Writes `bytes` as symbols into `symbols` from `offset`.
fn widen(symbols: &mut [u32], offset: usize, bytes: &[u8]) -> () {
  let mut at: usize = 0
  while at < bytes.length {
    symbols[offset + at] = u8.toU32(bytes[at])
    at = at + 1
  }
}

// Appends `bytes` as symbols to `symbols`.
effect fn appendBytes(symbols: &mut List<u32>, bytes: &[u8]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut at: usize = 0
  while at < bytes.length {
    run List<u32>.append(&mut symbols.*, u8.toU32(bytes[at]))
    at = at + 1
  }
}

// Appends one key per scalar value of the UTF-8 text `bytes` to `symbols`, and returns how many.
// A key packs the scalar's bytes into one word, so equal keys are equal scalar values.
effect fn appendScalars(symbols: &mut List<u32>, bytes: &[u8]) -> usize
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut count: usize = 0
  let mut at: usize = 0
  while at < bytes.length {
    let mut key = u8.toU32(bytes[at])
    at = at + 1
    while at < bytes.length && continuation(bytes[at]) {
      key = u32.shiftLeft(key, 8) | u8.toU32(bytes[at])
      at = at + 1
    }
    run List<u32>.append(&mut symbols.*, key)
    count = count + 1
  }
  return count
}

// Replaces each key in `symbols` with its rank among the distinct keys, and returns how many
// distinct keys there are.
effect fn numberSymbols(keys: &mut List<u32>) -> usize
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut distinct = List<u32>.make()
  run List<u32>.appendSlice(&mut distinct, List<u32>.asSlice(&keys.*))
  run List<u32>.sort(&mut distinct)
  let sorted = List<u32>.asMutSlice(&mut distinct)
  let mut kept: usize = 0
  let mut at: usize = 0
  while at < sorted.length {
    if kept == 0 || sorted[kept - 1] != sorted[at] {
      sorted[kept] = sorted[at]
      kept = kept + 1
    }
    at = at + 1
  }
  List<u32>.truncate(&mut distinct, kept)
  let symbols = List<u32>.asMutSlice(&mut keys.*)
  at = 0
  while at < symbols.length {
    symbols[at] = match List<u32>.binarySearch(&distinct, symbols[at]) {
      Option<usize>.Some { value } => usize.toU32(value)
      Option<usize>.None => 0
    }
    at = at + 1
  }
  return kept
}

fn smaller(left: usize, right: usize) -> usize {
  if left < right {
    return left
  }
  return right
}
