impl Debug for f32 {
  /// Writes the same text as `Display`, but a whole number ends in `.0`, as `1.0` and `-0.0`, so
  /// that it reads as a float. A set precision writes the same text as `Display`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    if f32.isNaN(self.*) { return run writeNonfinite(&mut formatter, false, "NaN") }
    if f32.isInfinite(self.*) {
      return run writeNonfinite(&mut formatter, f32.isSignNegative(self.*), "Infinity")
    }
    return run floatDisplay(&mut formatter,
      u32.toU64(u32.bitAnd(f32.toBits(self.*), 2147483647)),
      f32.isSignNegative(self.*), true, true)
  }
}

impl Debug for f64 {
  /// Writes the same text as `Display`, but a whole number ends in `.0`, as `1.0` and `-0.0`, so
  /// that it reads as a float. A set precision writes the same text as `Display`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    if f64.isNaN(self.*) { return run writeNonfinite(&mut formatter, false, "NaN") }
    if f64.isInfinite(self.*) {
      return run writeNonfinite(&mut formatter, f64.isSignNegative(self.*), "Infinity")
    }
    return run floatDisplay(&mut formatter,
      u64.bitAnd(f64.toBits(self.*), 9223372036854775807),
      f64.isSignNegative(self.*), false, true)
  }
}

// Narrowing is the checked conversion rather than a comparison against the target's MAX, so every
// type reads the same way. It is also the only form that works at every width: `usize.MAX` and
// `isize.MAX` are target-dependent, so a comparison against them would be a different comparison
// per target, while the checked conversion is one range test whatever the pointer width.

fn narrowU8(value: u64) -> Result<u8, ParseError> {
  return match move u64.checkedToU8(value) {
    Option<u8>.None => outOfRange<u8>()
    Option<u8>.Some { value: narrowed } => Result<u8, ParseError>.succeed(narrowed)
  }
}

fn narrowU16(value: u64) -> Result<u16, ParseError> {
  return match move u64.checkedToU16(value) {
    Option<u16>.None => outOfRange<u16>()
    Option<u16>.Some { value: narrowed } => Result<u16, ParseError>.succeed(narrowed)
  }
}

fn narrowU32(value: u64) -> Result<u32, ParseError> {
  return match move u64.checkedToU32(value) {
    Option<u32>.None => outOfRange<u32>()
    Option<u32>.Some { value: narrowed } => Result<u32, ParseError>.succeed(narrowed)
  }
}

fn narrowUsize(value: u64) -> Result<usize, ParseError> {
  return match move u64.checkedToUsize(value) {
    Option<usize>.None => outOfRange<usize>()
    Option<usize>.Some { value: narrowed } => Result<usize, ParseError>.succeed(narrowed)
  }
}

fn narrowI8(value: i64) -> Result<i8, ParseError> {
  return match move i64.checkedToI8(value) {
    Option<i8>.None => outOfRange<i8>()
    Option<i8>.Some { value: narrowed } => Result<i8, ParseError>.succeed(narrowed)
  }
}

fn narrowI16(value: i64) -> Result<i16, ParseError> {
  return match move i64.checkedToI16(value) {
    Option<i16>.None => outOfRange<i16>()
    Option<i16>.Some { value: narrowed } => Result<i16, ParseError>.succeed(narrowed)
