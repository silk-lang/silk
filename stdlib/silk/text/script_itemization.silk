//! Script itemization: the split of a text into runs of one script each (UAX #24), with data from
//! Unicode 18.0.0.
//!
//! # When to use
//! Use [`scripts`] before font shaping, which needs one script per run, or to find the scripts that
//! a text uses.
//!
//! # Details
//! Common and Inherited characters, such as spaces, digits and combining marks, join the run around
//! them. `Script_Extensions` sets are intersected across a run, combining marks stay with their
//! base, and a closing bracket takes the script of its opening bracket. The runs are byte ranges of
//! the text, appended to a caller-owned list. Only ambiguous script sets and open brackets use
//! scratch storage.
//!
//! # Examples
//! ## Split mixed Latin and Greek text
//! ```silk
//! import silk.collections.list { List }
//! import silk.core.effect { Effect }
//! import silk.core.option { Option }
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.text.script_itemization
//! import silk.text.script_itemization { ScriptRun }
//! import silk.text.unicode_script { Script }
//!
//! pub effect fn main() -> i32
//!   ! OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let mut runs = List<ScriptRun>.make()
//!   run script_itemization.scripts("abc \u{3b1}\u{3b2}\u{3b3}", &mut runs)
//!     |> Effect.provideMut<Allocator>(&mut allocator)
//!   let greek = Script.parse("Grek") |> Option<Script>.unwrapOr(Script.unknown())
//!   // The space joins the Latin run, so the Greek run starts at byte 4.
//!   let items = runs.asSlice()
//!   if items.length != 2 || items[1].start != 4 || &items[1].script != &greek {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Text

// Reference: https://www.unicode.org/reports/tr24/tr24-41.html#Implementation. ICU's
// release-78.1 extra/scrptrun/scrptrun.cpp is a useful comparison for neutral and bracket
// behavior, but it does not intersect Script_Extensions.

import silk.text.unicode { Unicode }
import silk.text.unicode_properties { BidiPairedBracketType }
import silk.text.unicode_script { Script, ScriptSet }
import silk.text.string { String }
import silk.text.utf8_scan
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.ownership { Copy }

/// A maximal range of a text in one script, as [`scripts`] gives it.
pub struct ScriptRun {
  /// The byte offset where the run starts.
  pub start: usize,
  /// The byte offset where the run ends.
  pub end: usize,
  /// The script of the run. It is never `Zyyy` (Common) or `Zinh` (Inherited) unless the whole text
  /// has no other script.
  pub script: Script,
}

impl Copy for ScriptRun {}

struct Opening {
  close: u32,
  runIndex: usize,
}

impl Copy for Opening {}

// The usual singleton script requires no scratch allocation. Only ambiguous
// extension sets allocate alternatives, retaining that capacity across runs.
struct Candidates {
  first: Script,
  alternatives: List<Script>,
}

fn neutral(script: Script) -> bool {
  return script.value == 0x5a797979 || script.value == 0x5a696e68
}

fn matches(script: Script, extensions: &ScriptSet, forced: u32) -> bool {
  if forced != 0 {
    return script.value == forced
  }
  return ScriptSet.contains(extensions, script)
}

fn resolved(candidates: &Candidates) -> Script {
  if candidates.first.value == 0 {
    return Script { value: 0x5a797979 }
  }
  return candidates.first
}

// A failed intersection leaves candidates intact so the caller can emit them.
fn intersect(candidates: &mut Candidates, extensions: &ScriptSet, forced: u32) -> bool {
  let mut chosen = candidates.first
  if !matches(chosen, extensions, forced) {
    chosen = Script { value: 0 }
    let alternatives = List<Script>.asSlice(&candidates.alternatives)
    let mut i: usize = 0
    while i < alternatives.length {
      if matches(alternatives[i], extensions, forced) {
        chosen = alternatives[i]
        break
      }
      i = i + 1
    }
    if chosen.value == 0 {
      return false
    }
  }
  let mut count: usize = 0
  if true {
    let alternatives = List<Script>.asMutSlice(&mut candidates.alternatives)
    let mut i: usize = 0
    while i < alternatives.length {
      let value = alternatives[i]
      if value.value != chosen.value && matches(value, extensions, forced) {
        alternatives[count] = value
        count = count + 1
      }
      i = i + 1
    }
  }
  List<Script>.truncate(&mut candidates.alternatives, count)
  candidates.first = chosen
  return true
}

effect fn initialize(
  candidates: &mut Candidates,
  extensions: &ScriptSet,
  primary: Script,
  forced: u32,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  List<Script>.clear(&mut candidates.alternatives)
  if forced != 0 {
    candidates.first = Script { value: forced }
    return
  }
  let length = ScriptSet.length(extensions)
  let mut chosen = Script { value: 0 }
  let mut i: usize = 0
  while i < length {
    let value = ScriptSet.get(extensions, i) |> Option<Script>.unwrapOr(Script { value: 0 })
    if !neutral(value) && (chosen.value == 0 || value.value < chosen.value) {
      chosen = value
    }
    i = i + 1
  }
  if !neutral(primary) && ScriptSet.contains(extensions, primary) {
    chosen = primary
  }
  candidates.first = chosen
  i = 0
  while i < length {
    let value = ScriptSet.get(extensions, i) |> Option<Script>.unwrapOr(Script { value: 0 })
    if !neutral(value) && value.value != chosen.value {
      run List<Script>.append(&mut candidates.alternatives, value)
    }
    i = i + 1
  }
}

// U+2329/U+232A and U+3008/U+3009 are canonical-equivalent bracket pairs.
fn canonicalBracket(cp: u32) -> u32 {
  if cp == 0x232a {
    return 0x3009
  }
  return cp
}

/// Appends the script runs of `text` to `output`.
///
/// # When to use
///
/// Use `scripts` to split text into runs that a font shaper can shape with one script each.
///
/// # Details
///
/// The runs follow UAX #24. They are not empty, they cover the text in order without gaps, and
/// empty text gives none. Common and Inherited characters join the run around them: leading ones
/// take the following script, others the preceding one. The `Script_Extensions` sets of a run are
/// intersected before its script is chosen; an ambiguous set prefers the primary script of its
/// first character, then the lowest ISO 15924 tag. Combining marks stay with their base, and a
/// closing bracket takes the script of its opening bracket. The function does not clear `output`,
/// so clear it first to reuse its storage.
///
/// # Errors
///
/// - `OutOfMemoryError` if the `Allocator` cannot grow `output` or the scratch storage for
///   brackets and ambiguous sets.
///
/// # Gotchas
///
/// Quotation marks whose pairing depends on the language are not treated as brackets.
pub effect fn scripts(text: string, output: &mut List<ScriptRun>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  run scriptsOf(String.utf8Bytes(text), &mut output)
}

effect fn scriptsOf(text: &[u8], output: &mut List<ScriptRun>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut candidates = Candidates { first: Script { value: 0 }, alternatives: List<Script>.make() }
  let mut openings = List<Opening>.make()
  let mut start: usize = 0
  let mut at: usize = 0
  while at < text.length {
    let decoded = utf8_scan.decode(text, at)
    let primary = Script.of(decoded.scalar)
    let extensions = Script.extensions(decoded.scalar)
    let bracket = BidiPairedBracketType.of(decoded.scalar)
    let mut forced: u32 = 0
    let mut matchedCurrent = false
    match &bracket {
      BidiPairedBracketType.Close => {
        let mut depth = List<Opening>.length(&openings)
        let close = canonicalBracket(decoded.scalar)
        while depth > 0 {
          depth = depth - 1
          let opening = List<Opening>.asSlice(&openings)[depth]
          if opening.close == close {
            if opening.runIndex < List<ScriptRun>.length(&output.*) {
              let script = List<ScriptRun>.asSlice(&output.*)[opening.runIndex].script
              if !neutral(script) {
                forced = script.value
              }
            } else {
              matchedCurrent = true
            }
            break
          }
        }

        // Discard mismatched inner openings, and consume the matching opening.
        // An unmatched close empties the stack, as in ICU's script-run iterator.
        List<Opening>.truncate(&mut openings, depth)
      }
      _ => {}
    }
    let wildcard = matchedCurrent || (at > 0 && Unicode.isMark(decoded.scalar))
      || (forced == 0
        && (ScriptSet.contains(&extensions, Script { value: 0x5a797979 })
          || ScriptSet.contains(&extensions, Script { value: 0x5a696e68 })))
    if !wildcard {
      if candidates.first.value == 0 {
        run initialize(&mut candidates, &extensions, primary, forced)
      } else if !intersect(&mut candidates, &extensions, forced) {
        run List<ScriptRun>.append(
          &mut output,
          ScriptRun { start: start, end: at, script: resolved(&candidates) },
        )
        start = at
        run initialize(&mut candidates, &extensions, primary, forced)
      }
    }
    match &bracket {
      BidiPairedBracketType.Open => {
        run List<Opening>.append(
          &mut openings,
          Opening {
            close: canonicalBracket(Unicode.bidiPairedBracket(decoded.scalar)),
            runIndex: List<ScriptRun>.length(&output.*),
          },
        )
      }
      _ => {}
    }
    at = decoded.next
  }
  if start < text.length {
    run List<ScriptRun>.append(
      &mut output,
      ScriptRun { start: start, end: text.length, script: resolved(&candidates) },
    )
  }
}
