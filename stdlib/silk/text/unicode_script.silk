//! Unicode scripts as ISO 15924 values, and the Script and Script_Extensions properties, with data
//! from Unicode 18.0.0.
//!
//! # When to use
//! Use [`Script.of`] to find the script of a character, such as Latin or Arabic. Use
//! [`Script.extensions`] when a character is shared by several scripts, such as the Arabic comma.
//! Use [`Script.parse`] to read a four-letter script code from text.
//!
//! # Details
//! A [`Script`] holds a big-endian ISO 15924 tag: `Latn` is `0x4c61746e`. The lookups take a code
//! point as a `u32` and do not allocate. A code point with no script, or a value past U+10FFFF,
//! gets `Zzzz` (Unknown). Common characters get `Zyyy` and inherited marks get `Zinh`.
//!
//! # Examples
//! ## Read the script of a character
//! ```silk
//! import silk.core.option { Option }
//! import silk.text.unicode_script { Script }
//!
//! pub fn main() -> i32 {
//!   let latin = Script.parse("Latn") |> Option<Script>.unwrapOr(Script.unknown())
//!   let letter = Script.of(0x41)
//!   if &letter != &latin {
//!     return 1
//!   }
//!   // U+060C ARABIC COMMA is shared by Arabic, Syriac, Thaana and other scripts.
//!   let arabic = Script.parse("Arab") |> Option<Script>.unwrapOr(Script.unknown())
//!   if !Script.extensions(0x60c).contains(arabic) {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Text

import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.core.equal { Equal }
import silk.text.string { String }
import silk.text.unicode_data
import silk.num.u8
import silk.num.u32

/// A Unicode script, held as its big-endian ISO 15924 tag.
///
/// # Details
///
/// `value` holds the four ASCII letters of the tag, first letter in the highest byte: `Latn` is
/// `0x4c61746e`. [`Script.of`] gives the script of a code point. Two scripts are equal when their
/// tags are equal.
pub struct Script {
  /// The big-endian ISO 15924 tag, such as `0x4c61746e` for `Latn`.
  pub value: u32,
}

impl Copy for Script {}

impl Equal for Script {
  equals: Script.same
}

fn same(left: &Script, right: &Script) -> bool {
  return left.value == right.value
}

impl Script {
  /// Returns `Zzzz` (Unknown), the script of characters that Unicode does not assign to a script.
  pub fn unknown() -> Script {
    return Script { value: 0x5a7a7a7a }
  }

  /// Returns `Zyyy` (Common), the script of characters that several scripts use, such as digits and
  /// punctuation.
  pub fn common() -> Script {
    return Script { value: 0x5a797979 }
  }

  /// Returns `Zinh` (Inherited), the script of combining marks that take the script of their base
  /// character.
  pub fn inherited() -> Script {
    return Script { value: 0x5a696e68 }
  }

  /// Returns the Unicode `Script` property of the code point `cp`. A code point with no script, or
  /// a value past U+10FFFF, gives [`Script.unknown`].
  @inlineAlways
  pub fn of(cp: u32) -> Script {
    return Script { value: unicode_data.script(cp) }
  }

  /// Returns the Unicode `Script_Extensions` property of the code point `cp`: each script that
  /// uses the character.
  ///
  /// # Details
  ///
  /// A character without an explicit `Script_Extensions` value gets the set with only its
  /// [`Script.of`] value. The set is sorted by tag and borrows static data, so the call does not
  /// allocate.
  @inlineAlways
  pub fn extensions(cp: u32) -> ScriptSet {
    let index = u32.toUsize(unicode_data.scriptExtensions(cp)) * 4
    return ScriptSet {
      start: u32.toUsize(unicode_data.be32(unicode_data.scriptSetOffsets(), index)),
      end: u32.toUsize(unicode_data.be32(unicode_data.scriptSetOffsets(), index + 4)),
    }
  }

  /// Returns the script for the ISO 15924 tag `value`, or `None` if `value` is 0.
  ///
  /// # Details
  ///
  /// The letter case is normalized, so `0x4c41544e` (`LATN`) gives `Latn`. A value that is not
  /// four ASCII letters gives [`Script.unknown`]. Historical and variant tags map to the script
  /// that Unicode uses for their characters: `Hans` and `Hant` give `Hani`, `Jamo` gives `Hang`,
  /// `Latf` and `Latg` give `Latn`, `Cyrs` gives `Cyrl`, `Geok` gives `Geor`, `Aran` gives `Arab`,
  /// and `Syre`, `Syrj` and `Syrn` give `Syrc`.
  pub fn fromIso15924Tag(value: u32) -> Option<Script> {
    if value == 0 {
      return Option<Script>.None
    }
    let mut result = (value & 0xdfdfdfdf) | 0x00202020
    if (result & 0xe0e0e0e0) != 0x40606060 {
      result = 0x5a7a7a7a
    }
    result = match result {
      0x4172616e => 0x41726162
      0x43797273 => 0x4379726c
      0x47656f6b => 0x47656f72
      0x48616e73 => 0x48616e69
      0x48616e74 => 0x48616e69
      0x4a616d6f => 0x48616e67
      0x4c617466 => 0x4c61746e
      0x4c617467 => 0x4c61746e
      0x53797265 => 0x53797263
      0x5379726a => 0x53797263
      0x5379726e => 0x53797263
      _ => result
    }
    return Option<Script>.some(Script { value: result })
  }

  /// Returns the script for the ISO 15924 code `text`, such as `"Latn"`, or `None` for empty text.
  ///
  /// # Details
  ///
  /// The function reads the first four bytes of `text`, pads a shorter code with spaces, and
  /// normalizes it as [`Script.fromIso15924Tag`] does: `"latn"` gives `Latn`, and a code that is
  /// not four ASCII letters gives [`Script.unknown`].
  pub fn parse(text: string) -> Option<Script> {
    let bytes = String.utf8Bytes(text)
    let mut value: u32 = 0
    let mut i: usize = 0
    while i < 4 {
      value = value * 256
      if i < bytes.length {
        value = value + u8.toU32(bytes[i])
      } else {
        value = value + 32
      }
      i = i + 1
    }
    return Script.fromIso15924Tag(value)
  }
}

/// A set of scripts that borrows static data, as [`Script.extensions`] gives it.
///
/// # Details
///
/// The scripts are sorted by ISO 15924 tag. The set is never empty. It is `Copy` and does not own
/// storage.
pub struct ScriptSet {
  start: usize,
  end: usize,
}

impl Copy for ScriptSet {}

impl ScriptSet {
  /// Returns the number of scripts in the set. It is at least 1.
  @inlineAlways
  pub fn length(self: &Self) -> usize {
    return self.end - self.start
  }

  /// Returns the script at position `index`, or `None` if `index` is not less than
  /// [`ScriptSet.length`]. The scripts are sorted by tag.
  pub fn get(self: &Self, index: usize) -> Option<Script> {
    if index >= self.length() {
      return Option<Script>.None
    }
    return Option<Script>.some(
      Script {
        value: unicode_data.be32(unicode_data.scriptSetMembers(), (self.start + index) * 4),
      },
    )
  }

  /// Returns true if `script` is in the set.
  pub fn contains(self: &Self, script: Script) -> bool {
    let mut index = self.start
    while index < self.end {
      if unicode_data.be32(unicode_data.scriptSetMembers(), index * 4) == script.value {
        return true
      }
      index = index + 1
    }
    return false
  }
}
