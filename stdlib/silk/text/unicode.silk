//! Unicode canonical normalization (NFC and NFD), canonical composition, and the Boolean and mapping
//! character properties, with data from Unicode 18.0.0.
//!
//! # When to use
//! Use normalization where text with different encodings of the same characters must compare equal,
//! such as user names or file names from different systems. Use [`Unicode.normalizeNfc`] for
//! storage and comparison. Use [`Unicode.normalizeNfd`] when a consumer needs the decomposed form.
//! Use the property functions, such as [`Unicode.isEmoji`] or [`Unicode.mirror`], to classify one
//! code point.
//!
//! # Details
//! Normalization is explicit. `string` equality compares the exact UTF-8 bytes and does not
//! normalize. Each normalization function returns a new [`String`] and needs an `Allocator`. The
//! results are the same on each target. [`Unicode.dataVersion`] gives the Unicode version of the
//! data. The property functions take a code point as a `u32`, do not allocate, and give the Unicode
//! default for a value past U+10FFFF.
//!
//! The typed properties, such as the general category, are in `silk.text.unicode_properties`.
//! Scripts are in `silk.text.unicode_script`.
//!
//! # Gotchas
//! This module implements canonical normalization only. It does not implement compatibility
//! normalization (NFKC or NFKD), locale-sensitive comparison, or case folding. Grapheme
//! segmentation is in `silk.text.segmentation`.
//!
//! # Examples
//! ## Make two encodings of the same text compare equal
//! ```silk
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.core.effect { Effect }
//! import silk.text.string { String }
//! import silk.text.unicode { Unicode }
//!
//! pub effect fn main() -> i32
//!   ! OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!
//!   // "e" followed by a combining acute accent, and the precomposed "é".
//!   let composed = run Unicode.normalizeNfc("e\u{301}")
//!     |> Effect.provideMut<Allocator>(&mut allocator)
//!   let decomposed = run Unicode.normalizeNfd("é") |> Effect.provideMut<Allocator>(&mut allocator)
//!   if String.view(&composed) != "é" || String.view(&decomposed) != "e\u{301}" {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Text

// Unicode policy lives here rather than in the compiler, and it is explicitly invoked. Nothing on
// this path runs unless a program calls it: ordinary `string` equality still compares exact bytes,
// so a precomposed `é` and a decomposed `é` stay unequal until source normalizes them.
//
// The data these algorithms read is generated into `silk/text/unicode_data` by `scripts/unicode/generate-unicode` from a pinned
// Unicode database. A later Unicode version regenerates that module and nothing else: no compiler type
// identity and no target ABI mentions it.
//
// The scalar buffers move through the helpers rather than being borrowed into them, because a
// borrow has to come from a direct binding and a reference parameter cannot be reborrowed. Moving
// a List is a move of its three fields, not a copy of its storage, so the buffer is built once
// and handed along.

import silk.core.bool
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.allocator { OutOfMemoryError }
import silk.core.result { Result }
import silk.text.string { String, InvalidUtf8 }
import silk.num.u32
import silk.num.u8
import silk.text.unicode_data
import silk.text.unicode_properties { GeneralCategory }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.num.usize
import silk.collections.list { List }

/// One step of a canonical decomposition, as [`Unicode.decompose`] gives it.
pub union Decomposed {
  /// The code point decomposes to one other scalar, such as U+212B ANGSTROM SIGN to U+00C5.
  Singleton {
    /// The scalar of the decomposition.
    pub scalar: u32,
  },
  /// The code point decomposes to two scalars, such as U+00E9 to U+0065 and U+0301.
  Pair {
    /// The first scalar, a starter or a scalar that decomposes further.
    pub first: u32,
    /// The second scalar, which does not decompose further.
    pub second: u32,
  },
}

impl Copy for Decomposed {}

/// The owner type of the Unicode normalization, composition and character property operations. It
/// has no fields and is never constructed.
///
/// # When to use
/// Use normalization where text with different encodings of the same characters must compare
/// equal, such as user names or file names from different systems. Use [`Unicode.normalizeNfc`]
/// for storage and comparison. Use [`Unicode.normalizeNfd`] when a consumer needs the decomposed
/// form. Use the property functions to classify one code point.
///
/// # Details
/// Normalization is explicit. `string` equality compares the exact UTF-8 bytes and does not
/// normalize. The results are the same on each target. The property functions take a code point as
/// a `u32`, do not allocate, and give the Unicode default for a value past U+10FFFF. The data is
/// from Unicode 18.0.0.
///
/// # Gotchas
/// Only canonical normalization is implemented. There is no compatibility normalization (NFKC or
/// NFKD), locale-sensitive comparison, or case folding.
pub struct Unicode {}

impl Unicode {
  /// Returns the Unicode version of the character data, `"18.0.0"`.
  ///
  /// # Details
  ///
  /// A later version of the data can change normalization results and properties for new
  /// characters.
  pub fn dataVersion() -> string<'static> {
    return unicode_data.dataVersion()
  }

  /// Returns the maximum number of scalars in the full canonical decomposition of one scalar.
  pub fn longestDecomposition() -> usize {
    return unicode_data.longestDecomposition()
  }

  /// Returns the one-step canonical decomposition of the code point `cp`, or `None` if `cp` has no
  /// canonical decomposition.
  ///
  /// # Details
  ///
  /// The result is one step, not the full decomposition: decompose each result scalar again for
  /// NFD. Hangul syllables decompose by the UAX #15 formula into a leading and vowel pair, or an LV
  /// syllable and trailing jamo. A value past U+10FFFF gives `None`.
  pub fn decompose(cp: u32) -> Option<Decomposed> {
    let result = decomposeStep(cp)
    if result.first == 0 {
      return Option<Decomposed>.None
    }
    if result.second == 0 {
      return Option<Decomposed>.some(Decomposed.Singleton { scalar: result.first })
    }
    return Option<Decomposed>.some(Decomposed.Pair { first: result.first, second: result.second })
  }

  /// Returns the primary composite of the code points `first` and `second`, or `None` if they do
  /// not compose.
  ///
  /// # Details
  ///
  /// The result is the canonical composition that NFC applies to a starter and a following
  /// unblocked scalar. Composition exclusions never compose. Hangul jamo compose by the UAX #15
  /// formula.
  pub fn compose(first: u32, second: u32) -> Option<u32> {
    let result = composePair(first, second)
    if result == 0 {
      return Option<u32>.None
    }
    return Option<u32>.some(result)
  }

  /// Returns true if `cp` is the second scalar of a table composition, so [`Unicode.compose`] can
  /// give a result for it. Hangul jamo, which compose by formula, give false.
  ///
  /// # When to use
  ///
  /// Use `composesAsSecond` as a fast filter in a hot loop before a call to [`Unicode.compose`].
  @inlineAlways
  pub fn composesAsSecond(cp: u32) -> bool {
    return unicode_data.composesAsSecond(cp) != 0
  }

  /// Returns true if the general category of `cp` is a mark: `Mn`, `Mc` or `Me`.
  @inlineAlways
  pub fn isMark(cp: u32) -> bool {
    let category = GeneralCategory.of(cp)
    return category == GeneralCategory.Mn || category == GeneralCategory.Mc
      || category == GeneralCategory.Me
  }

  /// Returns true if `cp` has the Unicode `Emoji` property.
  ///
  /// # Gotchas
  ///
  /// Digits, `#` and `*` have the property, because they start keycap sequences. Use
  /// [`Unicode.isEmojiPresentation`] to find characters that show as emoji by default.
  @inlineAlways
  pub fn isEmoji(cp: u32) -> bool {
    return unicode_data.isEmoji(cp) != 0
  }

  /// Returns true if `cp` has the Unicode `Emoji_Presentation` property: it shows as an emoji by
  /// default, without a variation selector.
  @inlineAlways
  pub fn isEmojiPresentation(cp: u32) -> bool {
    return unicode_data.isEmojiPresentation(cp) != 0
  }

  /// Returns true if `cp` has the Unicode `Emoji_Modifier` property, as the skin tone modifiers
  /// U+1F3FB to U+1F3FF do.
  @inlineAlways
  pub fn isEmojiModifier(cp: u32) -> bool {
    return unicode_data.isEmojiModifier(cp) != 0
  }

  /// Returns true if `cp` has the Unicode `Emoji_Modifier_Base` property: an emoji modifier can
  /// follow it.
  @inlineAlways
  pub fn isEmojiModifierBase(cp: u32) -> bool {
    return unicode_data.isEmojiModifierBase(cp) != 0
  }

  /// Returns true if `cp` has the Unicode `Emoji_Component` property: it can be part of an emoji
  /// sequence, such as a keycap or a tag.
  @inlineAlways
  pub fn isEmojiComponent(cp: u32) -> bool {
    return unicode_data.isEmojiComponent(cp) != 0
  }

  /// Returns true if `cp` has the Unicode `Extended_Pictographic` property, which grapheme and
  /// line segmentation read for emoji sequences.
  @inlineAlways
  pub fn isExtendedPictographic(cp: u32) -> bool {
    return unicode_data.isExtendedPictographic(cp) != 0
  }

  /// Returns true if `cp` is a regional indicator, U+1F1E6 to U+1F1FF. Two regional indicators make
  /// a flag.
  @inlineAlways
  pub fn isRegionalIndicator(cp: u32) -> bool {
    return unicode_data.isRegionalIndicator(cp) != 0
  }

  /// Returns true if `cp` has the Unicode `Variation_Selector` property, such as U+FE0F.
  @inlineAlways
  pub fn isVariationSelector(cp: u32) -> bool {
    return unicode_data.isVariationSelector(cp) != 0
  }

  /// Returns true if `cp` has the Unicode `Default_Ignorable_Code_Point` property: a renderer
  /// without special support shows nothing for it.
  @inlineAlways
  pub fn isDefaultIgnorable(cp: u32) -> bool {
    return unicode_data.isDefaultIgnorable(cp) != 0
  }

  /// Returns the Unicode `Bidi_Mirroring_Glyph` of `cp`, such as `)` for `(`, or `cp` itself if it
  /// has none.
  @inlineAlways
  pub fn mirror(cp: u32) -> u32 {
    return u32.wrappingAdd(cp, unicode_data.mirrorDelta(cp))
  }

  /// Returns the Unicode `Bidi_Paired_Bracket` of `cp`, or `cp` itself if it is not a paired
  /// bracket.
  ///
  /// # Details
  ///
  /// `BidiPairedBracketType.of` in `silk.text.unicode_properties` says if `cp` opens or closes.
  @inlineAlways
  pub fn bidiPairedBracket(cp: u32) -> u32 {
    return u32.wrappingAdd(cp, unicode_data.bracketDelta(cp))
  }

  /// Returns the vertical presentation form of `cp`, such as U+FE10 for U+FF0C FULLWIDTH COMMA, or
  /// `cp` itself if it has none.
  ///
  /// # Details
  ///
  /// The map joins the single-character `<vertical>` decompositions with their `<wide>` sources,
  /// so ASCII punctuation maps through its fullwidth form. U+FE4F WAVY LOW LINE maps to U+FE34.
  ///
  /// # Gotchas
  ///
  /// This is a presentation map, not the UAX #50 orientation. Use `VerticalOrientation.of` in
  /// `silk.text.unicode_properties` for the orientation.
  @inlineAlways
  pub fn verticalForm(cp: u32) -> u32 {
    return u32.wrappingAdd(cp, unicode_data.verticalDelta(cp))
  }

  /// Returns the Normalization Form D (NFD) of `value`: each character fully decomposed, with marks
  /// in canonical order.
  ///
  /// # When to use
  ///
  /// Use `normalizeNfd` when a consumer needs base characters and marks as separate scalars. Use
  /// [`Unicode.normalizeNfc`] for storage and comparison.
  ///
  /// # Details
  ///
  /// The function does not change `value`. Two canonically equivalent inputs give equal output.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the storage for the result.
  pub effect fn normalizeNfd(value: string) -> String
    ! OutOfMemoryError
    ? &mut Allocator {
    let scalars = run decomposedScalars(value)
    return run encodeOwned(move scalars)
  }

  /// Returns the Normalization Form C (NFC) of `value`: decomposed, put in canonical order, and
  /// then composed again.
  ///
  /// # When to use
  ///
  /// Use `normalizeNfc` before you store or compare text that can come in different encodings. Most
  /// text from keyboards and the web is already NFC.
  ///
  /// # Details
  ///
  /// The function does not change `value`. Two canonically equivalent inputs give equal output.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the storage for the result.
  pub effect fn normalizeNfc(value: string) -> String
    ! OutOfMemoryError
    ? &mut Allocator {
    let scalars = run decomposedScalars(value)
    let composed = composeInPlace(move scalars)
    return run encodeOwned(move composed)
  }
}

/// Hangul syllables decompose and compose arithmetically rather than through a table, so UAX #15
/// names these constants instead of tabulating eleven thousand rows.
const HANGUL_SYLLABLE_BASE: u32 = 44032

const HANGUL_LEADING_BASE: u32 = 4352

const HANGUL_VOWEL_BASE: u32 = 4449

const HANGUL_TRAILING_BASE: u32 = 4519

const HANGUL_LEADING_COUNT: u32 = 19

const HANGUL_VOWEL_COUNT: u32 = 21

const HANGUL_TRAILING_COUNT: u32 = 28

const HANGUL_SYLLABLE_COUNT: u32 = 11172

/// A combining class no scalar carries. Composition uses it for "the starter is still untouched".
const NO_COMBINING_CLASS: u32 = 256

/// Room for the trailing components a full decomposition can stack up.
///
/// A decomposition recurses through its first component only, so the stack holds one fewer entry
/// than the longest full decomposition. `namesLongestDecomposition` in the test suite pins the
/// generated bound against this constant, so a Unicode version that decomposes more deeply fails
/// loudly rather than silently overrunning.
const PENDING_CAPACITY: usize = 4

fn isHangulSyllable(scalar: u32) -> bool {
  if scalar < HANGUL_SYLLABLE_BASE {
    return false
  }
  return scalar < HANGUL_SYLLABLE_BASE + HANGUL_SYLLABLE_COUNT
}

/// Appends one scalar, then moves it back past any preceding mark of a higher combining class.
///
/// Canonical ordering is a stable sort by combining class. Doing it as each scalar arrives keeps
/// the buffer behind the cursor always in order, so no separate ordering pass is needed.
effect fn appendOrdered(buffer: List<u32>, scalar: u32) -> List<u32>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut ordered = move buffer
  let _appended = run List<u32>.append(&mut ordered, scalar)
  let class = unicode_data.combiningClass(scalar)
  if class == 0 {
    return move ordered
  }
  let mut index = List<u32>.length(&ordered) - usize.ONE
  while usize.ZERO < index {
    let previous = List<u32>.get(&ordered, index - usize.ONE)
    let previousClass = unicode_data.combiningClass(previous)
    if previousClass == 0 {
      return move ordered
    }
    if previousClass <= class {
      return move ordered
    }
    List<u32>.set(&mut ordered, index - usize.ONE, scalar)
    List<u32>.set(&mut ordered, index, previous)
    index = index - usize.ONE
  }
  return move ordered
}

/// Appends a Hangul syllable's canonical decomposition, which is arithmetic rather than tabulated.
effect fn decomposeHangul(buffer: List<u32>, scalar: u32) -> List<u32>
  ! OutOfMemoryError
  ? &mut Allocator {
  let index = scalar - HANGUL_SYLLABLE_BASE
  let leading = HANGUL_LEADING_BASE + index / (HANGUL_VOWEL_COUNT * HANGUL_TRAILING_COUNT)
  let vowel = HANGUL_VOWEL_BASE
    + (index % (HANGUL_VOWEL_COUNT * HANGUL_TRAILING_COUNT)) / HANGUL_TRAILING_COUNT
  let trailing = index % HANGUL_TRAILING_COUNT
  let withLeading = run appendOrdered(move buffer, leading)
  let withVowel = run appendOrdered(move withLeading, vowel)
  if trailing == 0 {
    return move withVowel
  }
  return run appendOrdered(move withVowel, HANGUL_TRAILING_BASE + trailing)
}

/// Appends one scalar's full canonical decomposition in canonical order.
///
/// Decomposition recurses through a mapping's first component only. The generator proves no second
/// component decomposes further, so the trailing components collect on a small stack and unwind
/// once the innermost starter is emitted.
effect fn decomposeInto(buffer: List<u32>, scalar: u32) -> List<u32>
  ! OutOfMemoryError
  ? &mut Allocator {
  if isHangulSyllable(scalar) {
    return run decomposeHangul(move buffer, scalar)
  }
  let mut pending = [scalar, scalar, scalar, scalar]
  let mut depth = usize.ZERO
  let mut current = scalar
  while true {
    let mapping = tableDecomposition(current)
    if mapping.first == 0 {
      break
    }
    if mapping.second != 0 {
      pending[depth] = mapping.second
      depth = depth + usize.ONE
    }
    current = mapping.first
  }
  let mut decomposed = run appendOrdered(move buffer, current)
  while usize.ZERO < depth {
    depth = depth - usize.ONE
    let extended = run appendOrdered(move decomposed, pending[depth])
    decomposed = move extended
  }
  return move decomposed
}

/// Composes a starter with the scalar following it, or returns zero when they do not compose.
fn composePair(starter: u32, following: u32) -> u32 {
  if HANGUL_LEADING_BASE <= starter {
    if starter < HANGUL_LEADING_BASE + HANGUL_LEADING_COUNT {
      if HANGUL_VOWEL_BASE <= following {
        if following < HANGUL_VOWEL_BASE + HANGUL_VOWEL_COUNT {
          let leading = starter - HANGUL_LEADING_BASE
          let vowel = following - HANGUL_VOWEL_BASE
          return HANGUL_SYLLABLE_BASE
            + (leading * HANGUL_VOWEL_COUNT + vowel) * HANGUL_TRAILING_COUNT
        }
      }
    }
  }
  if isHangulSyllable(starter) {
    if (starter - HANGUL_SYLLABLE_BASE) % HANGUL_TRAILING_COUNT == 0 {
      if HANGUL_TRAILING_BASE < following {
        if following < HANGUL_TRAILING_BASE + HANGUL_TRAILING_COUNT {
          return starter + (following - HANGUL_TRAILING_BASE)
        }
      }
    }
  }
  return tableComposition(starter, following)
}

/// One step of a canonical decomposition. Both scalars are 0 when there is none, and `second` is 0
/// for a singleton.
struct Step {
  first: u32,
  second: u32,
}

impl Copy for Step {}

/// Reads the table decomposition of a non-Hangul scalar.
fn tableDecomposition(scalar: u32) -> Step {
  let index = u32.toUsize(unicode_data.decomposition(scalar)) * 8
  return Step {
    first: unicode_data.be32(unicode_data.decompositions(), index),
    second: unicode_data.be32(unicode_data.decompositions(), index + 4),
  }
}

/// One canonical decomposition step, with Hangul syllables by formula.
fn decomposeStep(scalar: u32) -> Step {
  if isHangulSyllable(scalar) {
    let index = scalar - HANGUL_SYLLABLE_BASE
    let trailing = index % HANGUL_TRAILING_COUNT
    if trailing != 0 {
      return Step { first: scalar - trailing, second: HANGUL_TRAILING_BASE + trailing }
    }
    return Step {
      first: HANGUL_LEADING_BASE + index / (HANGUL_VOWEL_COUNT * HANGUL_TRAILING_COUNT),
      second: HANGUL_VOWEL_BASE
        + (index % (HANGUL_VOWEL_COUNT * HANGUL_TRAILING_COUNT)) / HANGUL_TRAILING_COUNT,
    }
  }
  return tableDecomposition(scalar)
}

/// Binary-searches the sorted composition rows, or returns zero when the pair does not compose.
fn tableComposition(first: u32, second: u32) -> u32 {
  if unicode_data.composesAsSecond(second) == 0 {
    return 0
  }
  let data = unicode_data.compositions()
  let mut low = usize.ZERO
  let mut high = data.length / 12
  while low < high {
    let middle = low + (high - low) / 2
    let rowFirst = unicode_data.be32(data, middle * 12)
    let rowSecond = unicode_data.be32(data, middle * 12 + 4)
    if rowFirst < first || (rowFirst == first && rowSecond < second) {
      low = middle + usize.ONE
    } else if rowFirst == first && rowSecond == second {
      return unicode_data.be32(data, middle * 12 + 8)
    } else {
      high = middle
    }
  }
  return 0
}

/// Rewrites a canonically ordered buffer as its canonical composition.
///
/// This is the UAX #15 composition pass. A starter absorbs each following scalar it composes with,
/// and a scalar blocked from its starter by an equal or higher combining class is kept as written.
fn composeInPlace(buffer: List<u32>) -> List<u32> {
  let mut composed = move buffer
  if List<u32>.length(&composed) == usize.ZERO {
    return move composed
  }
  let mut starterIndex = usize.ZERO
  let mut starter = List<u32>.get(&composed, usize.ZERO)
  let mut written = usize.ONE
  let mut lastClass = unicode_data.combiningClass(starter)
  if lastClass != 0 {
    lastClass = NO_COMBINING_CLASS
  }
  let mut index = usize.ONE
  while index < List<u32>.length(&composed) {
    let scalar = List<u32>.get(&composed, index)
    let class = unicode_data.combiningClass(scalar)
    let composite = composePair(starter, scalar)
    let mut absorbed = false
    if composite != 0 {
      if lastClass < class {
        absorbed = true
      }
      if lastClass == 0 {
        absorbed = true
      }
    }
    if absorbed {
      List<u32>.set(&mut composed, starterIndex, composite)
      starter = composite
    } else {
      if class == 0 {
        starterIndex = written
        starter = scalar
      }
      lastClass = class
      List<u32>.set(&mut composed, written, scalar)
      written = written + usize.ONE
    }
    index = index + usize.ONE
  }
  List<u32>.truncate(&mut composed, written)
  return move composed
}

// The UTF-8 encoding of each scalar is appended to a buffer the caller owns directly, against a
// local binding rather than in a helper that takes the buffer, because a reference parameter
// cannot be reborrowed and threading the buffer through by move hit a native backend defect: a
// vector rebound by `buffer = move helper(move buffer)` inside a loop reads stale once the loop
// ends and the buffer is borrowed.

/// Decodes valid UTF-8 into scalars, decomposing and canonically ordering as it goes.
///
/// The input is a `string`, so it is already valid UTF-8 and the decode needs no validation. The
/// validating decoder is `String.fromUtf8` in `silk.text.string`.
effect fn decomposedScalars(value: string) -> List<u32>
  ! OutOfMemoryError
  ? &mut Allocator {
  let bytes = String.utf8Bytes(value)
  let mut buffer = List<u32>.make()
  let mut offset = usize.ZERO
  while offset < bytes.length {
    let first = u8.toU32(bytes[offset])
    let mut scalar = first
    let mut width = usize.ONE
    if first > 193 {
      if first <= 223 {
        scalar = (first - 192) * 64 + u8.toU32(bytes[offset + usize.ONE]) - 128
        width = 2
      } else {
        if first <= 239 {
          scalar = (first - 224) * 4096 + (u8.toU32(bytes[offset + usize.ONE]) - 128) * 64
            + u8.toU32(bytes[offset + 2])
            - 128
          width = 3
        } else {
          scalar = (first - 240) * 262144 + (u8.toU32(bytes[offset + usize.ONE]) - 128) * 4096
            + (u8.toU32(bytes[offset + 2]) - 128) * 64
            + u8.toU32(bytes[offset + 3])
            - 128
          width = 4
        }
      }
    }
    let extended = run decomposeInto(move buffer, scalar)
    buffer = move extended
    offset = offset + width
  }
  return move buffer
}

/// Copies a scalar sequence into owned text.
///
/// The encoder writes only well-formed UTF-8, so the validation in `String.copyUtf8` cannot fail
/// here. The failure arm returns empty text. This module does not use the unchecked constructor,
/// because the saved scan is small.
effect fn encodeOwned(scalars: List<u32>) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let source = move scalars
  let mut bytes = List<u8>.make()
  let mut index = usize.ZERO
  while index < List<u32>.length(&source) {
    let scalar = List<u32>.get(&source, index)
    if scalar < 128 {
      let _only = run List<u8>.append(&mut bytes, u32.toU8(scalar))
    } else {
      if scalar < 2048 {
        let _lead = run List<u8>.append(&mut bytes, u32.toU8(192 + scalar / 64))
        let _last = run List<u8>.append(&mut bytes, u32.toU8(128 + scalar % 64))
      } else {
        if scalar < 65536 {
          let _lead = run List<u8>.append(&mut bytes, u32.toU8(224 + scalar / 4096))
          let _middle = run List<u8>.append(&mut bytes, u32.toU8(128 + (scalar / 64) % 64))
          let _last = run List<u8>.append(&mut bytes, u32.toU8(128 + scalar % 64))
        } else {
          let _lead = run List<u8>.append(&mut bytes, u32.toU8(240 + scalar / 262144))
          let _second = run List<u8>.append(&mut bytes, u32.toU8(128 + (scalar / 4096) % 64))
          let _third = run List<u8>.append(&mut bytes, u32.toU8(128 + (scalar / 64) % 64))
          let _last = run List<u8>.append(&mut bytes, u32.toU8(128 + scalar % 64))
        }
      }
    }
    index = index + usize.ONE
  }
  let owned = run String.copyUtf8(List<u8>.asSlice(&bytes))
  return match move owned {
    Result<String, InvalidUtf8>.Success { value } => move value
    Result<String, InvalidUtf8>.Failure {..} => String.make()
  }
}
