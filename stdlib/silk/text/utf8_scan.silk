//! Random-access decoding of one Unicode scalar from UTF-8 bytes, for text algorithms that scan by
//! byte offset.
//!
//! # When to use
//! Use [`decode`] in a hot loop that keeps byte offsets, such as a segmentation or line breaking
//! scan. Use `String.nextScalar` in `silk.text.string` for ordinary iteration over a `string`, and
//! `silk.text.utf8_decoder` for bytes that arrive in pieces.
//!
//! # Details
//! [`decode`] reads the scalar at a byte offset and gives the offset after it. It accepts only the
//! well-formed sequences of RFC 3629. An ill-formed byte, or a sequence that ends early, gives
//! U+FFFD and moves one byte, so a scan always moves forward. The function does not allocate.
//!
//! # Examples
//! ## Decode the scalars of a byte string
//! ```silk
//! import silk.text.utf8_scan
//!
//! pub fn main() -> i32 {
//!   let bytes = b"a\xc3\xa9\xff"
//!   let first = utf8_scan.decode(bytes, 0)
//!   let second = utf8_scan.decode(bytes, first.next)
//!   let third = utf8_scan.decode(bytes, second.next)
//!   if first.scalar != 0x61 || second.scalar != 0xe9 || third.scalar != 0xfffd || third.next != 4 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Text

import silk.core.ownership { Copy }
import silk.collections.slice { Slice }
import silk.num.u8
import silk.num.u32

/// One decoded scalar and the byte offset after it, as [`decode`] gives it.
pub struct Decoded {
  /// The scalar value, or U+FFFD for an ill-formed byte.
  pub scalar: u32,
  /// The byte offset after the scalar: the offset of the next scalar, or the length of the bytes.
  pub next: usize,
}

impl Copy for Decoded {}

/// Decodes the UTF-8 scalar that starts at byte offset `at` of `bytes`.
///
/// # Details
///
/// A well-formed sequence gives its scalar and the offset after it. An ill-formed byte, an
/// overlong form, a surrogate, a value past U+10FFFF, or a sequence that ends early gives U+FFFD
/// and `at + 1`. At or past the end of `bytes`, the result is U+FFFD and the length of `bytes`.
/// ASCII decodes inline; longer sequences take one call.
@inlineAlways
pub fn decode(bytes: &[u8], at: usize) -> Decoded {
  if at < bytes.length && bytes[at] < 128 {
    return Decoded { scalar: u8.toU32(bytes[at]), next: at + 1 }
  }
  return decodeMultibyte(bytes, at)
}

@inlineAlways
fn isContinuation(byte: u8) -> bool {
  return (byte & 0xc0) == 0x80
}

@inlineAlways
fn payload(byte: u8, mask: u8, shift: u32) -> u32 {
  return u32.shiftLeft(u8.toU32(byte & mask), shift)
}

// RFC 3629 well-formed sequences only: no overlongs, surrogates or values past U+10FFFF.
// Checking the decoded value is equivalent to RFC 3629's second-byte ranges.
@inlineAlways
fn decodeMultibyte(bytes: &[u8], at: usize) -> Decoded {
  if at >= bytes.length {
    return Decoded { scalar: 0xfffd, next: bytes.length }
  }

  // Indexing a view by constants lets the length checks below cover every access.
  let rest = Slice.view<u8>(bytes, at, bytes.length - at)
  let lead = rest[0]
  if lead >= 0xe0 {
    if lead < 0xf0 {
      if rest.length >= 3 && isContinuation(rest[1]) && isContinuation(rest[2]) {
        let cp = payload(lead, 0x0f, 12) | payload(rest[1], 0x3f, 6) | payload(rest[2], 0x3f, 0)
        if cp >= 0x800 && (cp < 0xd800 || cp > 0xdfff) {
          return Decoded { scalar: cp, next: at + 3 }
        }
      }
    } else if lead <= 0xf4 {
      if rest.length >= 4 && isContinuation(rest[1]) && isContinuation(rest[2])
        && isContinuation(rest[3]) {
        let cp = payload(lead, 0x07, 18) | payload(rest[1], 0x3f, 12) | payload(rest[2], 0x3f, 6)
          | payload(rest[3], 0x3f, 0)
        if cp >= 0x10000 && cp <= 0x10ffff {
          return Decoded { scalar: cp, next: at + 4 }
        }
      }
    }
  } else if lead >= 0xc2 {
    if rest.length >= 2 && isContinuation(rest[1]) {
      return Decoded { scalar: payload(lead, 0x1f, 6) | payload(rest[1], 0x3f, 0), next: at + 2 }
    }
  }
  return Decoded { scalar: 0xfffd, next: at + 1 }
}
