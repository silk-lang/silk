@inlineAlways
fn special(c: u8) -> bool {
  return SPECIAL[u8.toUsize(c)] != 0
}

fn previousScalar(data: &[u8], pos: usize) -> u32 {
  if pos == 0 {
    return 10
  }
  let mut i = pos - 1
  while i > 0 && data[i] >= 128 && data[i] < 192 {
    i = i - 1
  }
  return utf8_scan.decode(data, i).scalar
}

effect fn tickCache(state: &mut Inline, data: &[u8]) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut i: usize = 0
  while i < data.length {
    if data[i] != 96 {
      i = i + 1
      continue
    }
    let start = i
    while i < data.length && data[i] == 96 {
      i = i + 1
    }
    run List<Backtick>.append(
      &mut state.ticks,
      Backtick { start: start, length: i - start, next: NONE, shorter: NONE },
    )
  }

  // Each run links to the nearest later run of its length and of one byte less; the shorter link
  // closes a run whose first backtick is backslash-escaped.
  let mut index = List<Backtick>.length(&state.ticks)
  while index > 0 {
    index = index - 1
    let mut tick = List<Backtick>.get(&state.ticks, index)
    if let Option<usize>.Some { value } = HashMap<usize, usize>.get(&state.tickIndex, tick.length) {
      tick.next = value
    }
    if let Option<usize>.Some { value } = HashMap<usize, usize>.get(
      &state.tickIndex,
      tick.length - 1,
    ) {
      tick.shorter = value
    }
    List<Backtick>.set(&mut state.ticks, index, tick)
    drop run HashMap<usize, usize>.insert(&mut state.tickIndex, tick.length, index)
  }
}

fn tickAt(state: &Inline, pos: usize) -> Backtick {
  let ticks = List<Backtick>.asSlice(&state.ticks)
  let mut low: usize = 0
  let mut high = ticks.length
  while low < high {
    let mid = low + (high - low) / 2
    if ticks[mid].start < pos {
      low = mid + 1
    } else {
      high = mid
    }
  }
  if low < ticks.length && ticks[low].start == pos {
    return ticks[low]
  }

  // A backslash escape consumed the first backtick of the preceding run.
  let whole = ticks[low - 1]
  let length = whole.start + whole.length - pos
  return Backtick {
    start: pos,
    length: length,
    next: if pos == whole.start + 1 {
      whole.shorter
    } else {
      NONE
    },
    shorter: NONE,
  }
}

fn autolinkEnd(data: &[u8], pos: usize) -> usize {
  let mut i = pos + 1
  let mut colon = NONE
  let mut email = false
  while i < data.length && data[i] != 62 {
    if data[i] <= 32 || data[i] == 60 {
      return pos
    }
    if data[i] == 58 && colon == NONE {
      colon = i
    }
    if data[i] == 64 {
      email = true
    }
    i = i + 1
  }
  if i == data.length {
    return pos
  }
  if colon != NONE && colon - pos >= 3 && colon - pos <= 33 && alpha(data[pos + 1]) {
    let mut j = pos + 2
    while j < colon {
      let c = data[j]
      if !alpha(c) && !(c >= 48 && c <= 57) && c != 43 && c != 45 && c != 46 {
        return pos
      }
      j = j + 1
    }
    return i + 1
  }
  if email {
    let mut j = pos + 1
    while j < i && data[j] != 64 {
      let c = data[j]
      if !alpha(c) && !(c >= 48 && c <= 57) && c != 46 && c != 33 && c != 35 && c != 36 && c != 37
        && c != 38
        && c != 39
        && c != 42
        && c != 43
        && c != 47
        && c != 61
        && c != 63
        && c != 94
        && c != 95
        && c != 96
        && c != 123
        && c != 124
        && c != 125
        && c != 126
        && c != 45 {
        return pos
      }
      j = j + 1
    }
    if j == pos + 1 || j == i {
      return pos
    }
    j = j + 1
    while j < i {
      let start = j
      if !alpha(data[j]) && !(data[j] >= 48 && data[j] <= 57) {
        return pos
      }
      while j < i && (alpha(data[j]) || data[j] >= 48 && data[j] <= 57 || data[j] == 45) {
        j = j + 1
      }
      if j - start > 63 || data[j - 1] == 45 {
        return pos
      }
      if j < i {
        if data[j] != 46 {
          return pos
        }
        j = j + 1
        if j == i {
          return pos
        }
      }
    }
    return i + 1
  }
  return pos
}

effect fn inlines(p: &mut Parser<'_>, parent: usize, input: &Input, begin: usize) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let data = Bytes.asSlice(&input.data)
  let mut end = data.length
  while end > begin && space(data[end - 1]) {
    end = end - 1
  }
  let mut pos = begin
  while pos < end && space(data[pos]) {
    pos = pos + 1
  }
  let mut state = Intrinsic.replace(p.inlineState, makeInline())
  List<Delimiter>.clear(&mut state.delimiters)
  List<Bracket>.clear(&mut state.brackets)
  List<Backtick>.clear(&mut state.ticks)
  HashMap<usize, usize>.clear(&mut state.tickIndex)
  Bytes.clear(&mut state.normalized)
  state.last = NONE
  state.work = usize.saturatingAdd(usize.saturatingMultiply(data.length, 16), 1024)
  run tickCache(&mut state, bytes(data, 0, end))
  while pos < end {
    let start = pos
    let c = data[pos]
    if !inlineSpecial(c, &p.options) {
      pos = pos + 1
      while pos < end && !inlineSpecial(data[pos], &p.options) {
        pos = pos + 1
      }

      // Trailing spaces belong to a line break, not to its preceding Text node.
      let mut finish = pos
      if pos < end && (data[pos] == 10 || data[pos] == 13) {
        while finish > start && (data[finish - 1] == 32 || data[finish - 1] == 9) {
          finish = finish - 1
        }
      }
      if finish > start {
        drop run appendText(&mut p.doc, input, parent, start, finish)
      }
      continue
    }
    if p.options.autolinkLiterals && (c == 119 || lower(c) == 104 || lower(c) == 102)
      && List<Bracket>.length(&state.brackets) == 0
      && p.options.maxNesting > 0 {
      let finish = literalUrlEnd(bytes(data, 0, end), pos, &mut state.work)
      if finish > pos {
        let prefix = if c == 119 {
          "http://"
        } else {
          ""
        }
        run literalLink(&mut p.doc, input, parent, pos, finish, prefix)
        pos = finish
        continue
      }
    }
    if c == 0 || c == 38 || c == 92 && pos + 1 < end && punctuation(data[pos + 1]) {
      let mut finish = pos + 1
      let mut replacement: string = ""
      let found = entity(data, pos)
      if c == 38 && found.end > pos {
        finish = found.end
        replacement = found.named
      } else if c == 92 {
        finish = pos + 2
      }
      if c == 38 && found.end == pos {
        drop run appendText(&mut p.doc, input, parent, pos, finish)
      } else {
        let valueStart = Bytes.length(&p.doc.storage)
        if c == 0 {
          run scalar(&mut p.doc.storage, 0xfffd)
        } else if c == 92 {
          run Bytes.append(&mut p.doc.storage, bytes(data, pos + 1, finish))
        } else if String.byteLength(replacement) != 0 {
          run Bytes.append(&mut p.doc.storage, String.utf8Bytes(replacement))
        } else {
          run scalar(&mut p.doc.storage, found.scalar)
        }
        let value = TextRange {
          span: MarkdownSpan { start: valueStart, end: Bytes.length(&p.doc.storage) },
          side: true,
        }
        drop run appendRange(&mut p.doc, parent, value, inputSpan(input, pos, finish))
      }
      pos = finish
      continue
    }
    if c == 10 || c == 13
      || c == 92 && pos + 1 < end && (data[pos + 1] == 10 || data[pos + 1] == 13) {
      let mut kind = MarkdownNodeKind.SoftBreak
      let mut spanStart = pos
      if c == 92 {
        kind = MarkdownNodeKind.HardBreak
        pos = pos + 1
      } else {
        let mut spaces = pos
        while spaces > begin && data[spaces - 1] == 32 {
          spaces = spaces - 1
        }
        if pos - spaces >= 2 {
          kind = MarkdownNodeKind.HardBreak
          spanStart = spaces
        }
      }
      if data[pos] == 13 && pos + 1 < end && data[pos + 1] == 10 {
        pos = pos + 1
      }
      pos = pos + 1
      let id = run add(&mut p.doc, parent, kind, position(input, spanStart, false))
      let mut n = node(&p.doc, id)
      n.span = inputSpan(input, spanStart, pos)
      n.depth = 0
      set(&mut p.doc, id, n)
      while pos < end && (data[pos] == 32 || data[pos] == 9) {
        pos = pos + 1
      }
      continue
    }
    if c == 96 {
      let tick = tickAt(&state, pos)
      pos = pos + tick.length
      if tick.next == NONE {
        drop run appendText(&mut p.doc, input, parent, start, pos)
        continue
      }
      let closing = List<Backtick>.get(&state.ticks, tick.next)
      let valueStart = Bytes.length(&p.doc.storage)
      run decodeInto(&mut p.doc.storage, bytes(data, pos, closing.start), false, true)
      let mut valueEnd = Bytes.length(&p.doc.storage)
      let mut valueBegin = valueStart
      let valueBytes = Bytes.asSlice(&p.doc.storage)
      if valueEnd > valueBegin + 1 && valueBytes[valueBegin] == 32
        && valueBytes[valueEnd - 1] == 32 {
        let mut allSpaces = true
        let mut i = valueBegin
        while i < valueEnd {
          if valueBytes[i] != 32 {
            allSpaces = false
            break
          }
          i = i + 1
        }
        if !allSpaces {
          valueBegin = valueBegin + 1
          valueEnd = valueEnd - 1
        }
      }
      drop valueBytes
      let mut value = TextRange {
        span: MarkdownSpan { start: valueBegin, end: valueEnd },
        side: true,
      }

      // Preserve a view when normalization and trimming do not change the code content.
      let trimStart = pos + valueBegin - valueStart
      let trimEnd = closing.start - (Bytes.length(&p.doc.storage) - valueEnd)
      let original = bytes(data, trimStart, trimEnd)
      if same(original, bytes(Bytes.asSlice(&p.doc.storage), valueBegin, valueEnd)) {
        Bytes.truncate(&mut p.doc.storage, valueStart)
        value = run inputText(&mut p.doc, input, trimStart, trimEnd)
      }
      pos = closing.start + closing.length
      let id = run add(&mut p.doc, parent, MarkdownNodeKind.Code, position(input, start, false))
      let mut n = node(&p.doc, id)
      n.span = inputSpan(input, start, pos)
      n.value = value
      n.depth = 0
      set(&mut p.doc, id, n)
      continue
    }
    if c == 42 || c == 95 || c == 126 && p.options.strikethrough {
      while pos < end && data[pos] == c {
        pos = pos + 1
      }
      let mut beforePosition = start
      let mut afterPosition = pos
      if c != 126 && p.options.strikethrough {
        // cmark-gfm excludes adjacent extension delimiters from emphasis flanking.
        while beforePosition > 0 && data[beforePosition - 1] == 126 {
          beforePosition = beforePosition - 1
        }
        while afterPosition < end && data[afterPosition] == 126 {
          afterPosition = afterPosition + 1
        }
      }
      let before = previousScalar(data, beforePosition)
      let after = if afterPosition < end {
        utf8_scan.decode(data, afterPosition).scalar
      } else {
        10
      }
      let left = !whiteScalar(after)
        && (!punctScalar(after) || whiteScalar(before) || punctScalar(before))
      let right = !whiteScalar(before)
        && (!punctScalar(before) || whiteScalar(after) || punctScalar(after))
      let canOpen = left && (c != 95 || !right || punctScalar(before))
      let canClose = right && (c != 95 || !left || punctScalar(after))
      let id = run textNode(&mut p.doc, input, parent, start, pos)
      if (canOpen || canClose) && (c != 126 || pos - start <= 2) {
        let index = List<Delimiter>.length(&state.delimiters)
        if state.last != NONE {
          let mut last = List<Delimiter>.get(&state.delimiters, state.last)
          last.next = index
          List<Delimiter>.set(&mut state.delimiters, state.last, last)
        }
        run List<Delimiter>.append(
          &mut state.delimiters,
          Delimiter {
            node: id,
            byte: c,
            length: pos - start,
            original: pos - start,
            canOpen: canOpen,
            canClose: canClose,
            previous: state.last,
            next: NONE,
            active: true,
          },
        )
        state.last = index
      }
      continue
    }
    if c == 33 && p.options.footnotes && at(data, pos + 1, "[^") {
      pos = pos + 1
      drop run appendText(&mut p.doc, input, parent, start, pos)
      continue
    }
    if c == 91 && p.options.footnotes && at(data, pos, "[^") {
      let closing = labelClose(bytes(data, 0, end), pos + 2)
      if closing != NONE && closing > pos + 2 {
        // An explicit inline or reference link takes precedence over a footnote reference.
        let mut linked = false
        if closing + 1 < end && data[closing + 1] == 40 {
          let parts = linkParts(bytes(data, 0, end), closing + 2, false, &mut state.work)
          linked = parts.end > closing + 2
        }
        if closing + 1 < end && data[closing + 1] == 91 {
          let labelEnd = labelClose(bytes(data, 0, end), closing + 2)
          if labelEnd != NONE && labelEnd > closing + 2 {
            run normalizeLabel(&mut state.normalized, bytes(data, closing + 2, labelEnd))
            linked = findReference(&p.*, Bytes.asSlice(&state.normalized)) != NONE
          }
        }
        run normalizeLabel(&mut state.normalized, bytes(data, pos + 2, closing))
        let definition = findFootnote(&p.*, Bytes.asSlice(&state.normalized))
        if definition != NONE && !linked {
          let id = run add(
            &mut p.doc,
            parent,
            MarkdownNodeKind.FootnoteReference,
            position(input, pos, false),
          )
          let mut n = node(&p.doc, id)
          n.span = inputSpan(input, pos, closing + 1)
          n.head = definition
          n.extra = run inputText(&mut p.doc, input, pos + 2, closing)
          n.depth = 0
          set(&mut p.doc, id, n)
          pos = closing + 1
          continue
        }
      }
    }
    if c == 91 || c == 33 && pos + 1 < end && data[pos + 1] == 91 {
      let image = c == 33
      pos = pos + 1
      if image {
        pos = pos + 1
      }
      let id = run textNode(&mut p.doc, input, parent, start, pos)
      let length = List<Bracket>.length(&state.brackets)
      if length > 0 {
        let mut last = List<Bracket>.get(&state.brackets, length - 1)
        last.after = true
        List<Bracket>.set(&mut state.brackets, length - 1, last)
      }
      run List<Bracket>.append(
        &mut state.brackets,
        Bracket {
          node: id,
          position: start,
          image: image,
          delimiter: state.last,
          active: true,
          after: false,
        },
      )
      continue
    }
    if c == 93 && List<Bracket>.length(&state.brackets) > 0 {
      let bracket = match List<Bracket>.pop(&mut state.brackets) {
        Option<Bracket>.Some { value } => value
        _ => {
          pos = pos + 1
          continue
        }
      }
      let mut parts = LinkParts {
        end: pos,
        destinationStart: 0,
        destinationEnd: 0,
        titleStart: 0,
        titleEnd: 0,
        hasTitle: false,
      }
      let mut reference = NONE
      let labelStart = bracket.position
        + if bracket.image {
          usize.toUsize(2)
        } else {
          usize.toUsize(1)
        }
      let mut labelEnd = pos
      let mut explicit = false
      if bracket.active && state.work > 0
        && List<Bracket>.length(&state.brackets) < p.options.maxNesting {
        if pos + 1 < end && data[pos + 1] == 40 {
          parts = linkParts(bytes(data, 0, end), pos + 2, false, &mut state.work)
        }
        if parts.end == pos || parts.end == pos + 2 {
          parts.end = pos
          let mut begin = labelStart
          if pos + 1 < end && data[pos + 1] == 91 {
            let i = labelClose(bytes(data, 0, end), pos + 2)
            if i != NONE {
              explicit = true
              parts.end = i + 1
              if i != pos + 2 {
                begin = pos + 2
                labelEnd = i
              }
            }
          }
          if (explicit || !bracket.after) && labelFits(bytes(data, begin, labelEnd)) {
            run normalizeLabel(&mut state.normalized, bytes(data, begin, labelEnd))
            reference = findReference(&p.*, Bytes.asSlice(&state.normalized))
            if reference != NONE {
              let entry = List<Reference>.get(&p.references, reference)
              let expansion = entry.destination.span.end - entry.destination.span.start
                + entry.title.span.end
                - entry.title.span.start
              if expansion > p.referenceWork {
                reference = NONE
              } else {
                p.referenceWork = p.referenceWork - expansion
              }
            }
            if reference != NONE && !explicit {
              parts.end = pos + 1
            }
          }
          if reference == NONE {
            parts.end = pos
          }
        }
      }
      if parts.end > pos {
        run emphasis(&mut p.*, &mut state, bracket.delimiter)
        let opening = node(&p.doc, bracket.node)
        let first = opening.next
        let last = node(&p.doc, parent).last
        let mut child = first
        let mut depth: usize = 0
        while child != NONE {
          let n = node(&p.doc, child)
          depth = maximum(depth, n.depth)
          child = n.next
        }
        if depth >= p.options.maxNesting {
          pos = pos + 1
          drop run appendText(&mut p.doc, input, parent, start, pos)
          continue
        }
        let mut kind = MarkdownNodeKind.Link
        if bracket.image {
          kind = MarkdownNodeKind.Image
        }
        let span = inputSpan(input, bracket.position, parts.end)
        let mut id: usize = NONE
        if first != NONE {
          id = run wrap(&mut p.doc, first, last, kind, span)
          unlink(&mut p.doc, bracket.node)
        } else {
          id = bracket.node
          let mut n = opening
          n.kind = kind
          n.value = emptyText()
          n.span = span
          n.depth = 1
          set(&mut p.doc, id, n)
        }
        let mut target = emptyText()
        let mut title = emptyText()
        let mut hasTitle = parts.hasTitle
        if reference != NONE {
          let entry = List<Reference>.get(&p.references, reference)
          target = entry.destination
          title = entry.title
          hasTitle = entry.hasTitle
        } else {
          target = run decodedInput(&mut p.doc, input, parts.destinationStart, parts.destinationEnd)
          if parts.hasTitle {
            title = run decodedInput(&mut p.doc, input, parts.titleStart, parts.titleEnd)
          }
        }
        let mut n = node(&p.doc, id)
        n.target = target
        n.extra = title
        n.hasTitle = hasTitle
        set(&mut p.doc, id, n)
        if !bracket.image {
          let brackets = List<Bracket>.asMutSlice(&mut state.brackets)
          let mut i = brackets.length
          while i > 0 {
            i = i - 1
            if !brackets[i].active {
              break
            }
            if !brackets[i].image {
              brackets[i].active = false
            }
          }
        }
        pos = parts.end
        continue
      }
      pos = pos + 1
      drop run appendText(&mut p.doc, input, parent, start, pos)
      continue
    }
    if c == 60 && state.work > 0 {
      let finish = autolinkEnd(bytes(data, 0, end), pos)
      if finish > pos && p.options.maxNesting > 0 {
        let targetStart = pos + 1
        let targetEnd = finish - 1
        let targetBytes = bytes(data, targetStart, targetEnd)
        let mut email = true
        let mut i: usize = 0
        while i < targetBytes.length {
          if targetBytes[i] == 58 {
            email = false
            break
          }
          i = i + 1
        }
        let mut target = run inputText(&mut p.doc, input, targetStart, targetEnd)
        if email {
          let begin = Bytes.length(&p.doc.storage)
          run Bytes.append(&mut p.doc.storage, b"mailto:")
          run Bytes.append(&mut p.doc.storage, targetBytes)
          target = TextRange {
            span: MarkdownSpan { start: begin, end: Bytes.length(&p.doc.storage) },
            side: true,
          }
        }
        let id = run add(&mut p.doc, parent, MarkdownNodeKind.Link, position(input, start, false))
        let mut n = node(&p.doc, id)
        n.span = inputSpan(input, start, finish)
        n.target = target
        n.depth = 1
        set(&mut p.doc, id, n)
        drop run textNode(&mut p.doc, input, id, targetStart, targetEnd)
        pos = finish
        continue
      }
      if state.work > 0 {
        let finish = htmlEnd(bytes(data, 0, end), pos, &mut state.work)
        if finish > pos {
          let value = run literalInput(&mut p.doc, input, pos, finish)
          let id = run add(
            &mut p.doc,
            parent,
            MarkdownNodeKind.HtmlInline,
            position(input, start, false),
          )
          let mut n = node(&p.doc, id)
          n.span = inputSpan(input, start, finish)
          n.value = value
          n.depth = 0
          set(&mut p.doc, id, n)
          pos = finish
          continue
        }
      }
    }
    pos = pos + 1
    drop run appendText(&mut p.doc, input, parent, start, pos)
  }
  run emphasis(&mut p.*, &mut state, NONE)
  p.inlineState = move state
}

fn coalesce(doc: &mut MarkdownDocument<'_>) {
  let mut parent: usize = 0
  while parent < List<MarkdownNode>.length(&doc.arena) {
    let mut id = node(&doc.*, parent).first
    while id != NONE {
      let mut n = node(&doc.*, id)
      if n.kind == MarkdownNodeKind.Text {
        while n.next != NONE {
          let next = node(&doc.*, n.next)
          if next.kind != MarkdownNodeKind.Text || n.value.side != next.value.side
            || n.value.span.end != next.value.span.start {
            break
          }
          let removed = n.next
          n.value.span.end = next.value.span.end
          n.span.end = next.span.end
          unlink(&mut doc.*, removed)
          n.next = node(&doc.*, id).next
          set(&mut doc.*, id, n)
        }
      }
      id = n.next
    }
    parent = parent + 1
  }
}

fn preorderNext(doc: &MarkdownDocument<'_>, id: usize) -> usize {
  let n = node(doc, id)
  if n.first != NONE {
    return n.first
  }
  let mut index = id
  while index != NONE {
    let n = node(doc, index)
    if n.next != NONE {
      return n.next
    }
    index = n.parent
  }
  return NONE
}

fn remap(mapping: &[usize], index: usize) -> usize {
  if index == NONE {
    return NONE
  }
  return mapping[index]
}

effect fn compact(doc: &mut MarkdownDocument<'_>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  coalesce(&mut doc.*)
  let count = List<MarkdownNode>.length(&doc.arena)
  let mut mapping = List<usize>.make()
  run List<usize>.appendRepeated(&mut mapping, NONE, count)
  let mut arena = run List<MarkdownNode>.makeWithCapacity(count)
  let mut id: usize = 0
  while id != NONE {
    List<usize>.set(&mut mapping, id, List<MarkdownNode>.length(&arena))
    run List<MarkdownNode>.append(&mut arena, node(&doc.*, id))
    id = preorderNext(&doc.*, id)
  }
  let map = List<usize>.asSlice(&mapping)
  let nodes = List<MarkdownNode>.asMutSlice(&mut arena)
  let mut i: usize = 0
  while i < nodes.length {
    nodes[i].parent = remap(map, nodes[i].parent)
    nodes[i].first = remap(map, nodes[i].first)
    nodes[i].last = remap(map, nodes[i].last)
    nodes[i].next = remap(map, nodes[i].next)
    nodes[i].previous = remap(map, nodes[i].previous)
    if nodes[i].kind == MarkdownNodeKind.FootnoteReference {
      nodes[i].head = remap(map, nodes[i].head)
    }
    i = i + 1
  }
  doc.arena = move arena
}

effect fn parseDocument<'a>(value: string<'a>, options: &MarkdownOptions) -> MarkdownDocument<'a>
  ! OutOfMemoryError
  ? &mut Allocator {
  let data = String.utf8Bytes(value)
  let mut p = Parser<'a> {
    doc: MarkdownDocument<'a> {
      source: value,
      storage: Bytes.make(),
      arena: run List<MarkdownNode>.makeWithCapacity(data.length / 24 + 1),
    },
    chunks: List<Chunk>.make(),
    open: List<usize>.make(),
    references: List<Reference>.make(),
    referenceIndex: HashMap<u64, usize>.make(Hash.seed(0)),
    footnoteIndex: HashMap<u64, usize>.make(Hash.seed(0)),
    options: options.*,
    referenceWork: usize.saturatingAdd(usize.saturatingMultiply(data.length, 16), 65536),
    input: makeInput(),
    inlineState: makeInline(),
    labelBuffer: Bytes.make(),
  }
  drop run add(&mut p.doc, NONE, MarkdownNodeKind.Document, 0)
  run List<usize>.append(&mut p.open, 0)
  let mut pos: usize = 0
  if options.frontmatter && (at(data, 0, "---") || at(data, 0, "+++")) {
    let first = readLine(data, 0)
    if first.end == 3 {
      let mut scan = first.after
      while scan < data.length {
        let line = readLine(data, scan)
        if line.end - line.start == 3
          && same(bytes(data, line.start, line.end), bytes(data, 0, 3)) {
          let id = run add(&mut p.doc, 0, MarkdownNodeKind.Frontmatter, 0)
          let mut n = node(&p.doc, id)
          n.span.end = line.after
          n.marker = data[0]
          n.value = TextRange {
            span: MarkdownSpan { start: first.after, end: line.start },
            side: false,
          }
          set(&mut p.doc, id, n)
          pos = line.after
          break
        }
        scan = line.after
      }
    }
  }
  while pos < data.length {
    let end = match byte_search.find2(bytes(data, pos, data.length), 10, 13) {
      Option<usize>.Some { value: found } => pos + found
      _ => data.length
    }
    let mut after = end
    if after < data.length && data[after] == 13 {
      after = after + 1
    }
    if after < data.length && data[after] == 10 {
      after = after + 1
    }
    let line = Line { start: pos, end: end, after: after }
    run blockLine(&mut p, &line)
    let open = List<usize>.asSlice(&p.open)
    let mut i: usize = 0
    while i < open.length {
      let mut n = node(&p.doc, open[i])
      n.span.end = after
      set(&mut p.doc, open[i], n)
      i = i + 1
    }
    pos = after
  }
  let mut rootNode = node(&p.doc, 0)
  rootNode.span.end = data.length
  set(&mut p.doc, 0, rootNode)
  closeTo(&mut p, 1)
  let blocks = List<MarkdownNode>.length(&p.doc.arena)
  let mut id: usize = 1

  // Register every footnote before inline references resolve. Duplicate labels keep the first definition.
  if options.footnotes {
    while id < blocks {
      let n = node(&p.doc, id)
      if n.kind == MarkdownNodeKind.FootnoteDefinition {
        run normalizeLabel(&mut p.labelBuffer, String.utf8Bytes(text(&p.doc, n.extra)))
        let label = Bytes.asSlice(&p.labelBuffer)
        if findFootnote(&p, label) == NONE {
          let hash = labelHash(label)
          let mut definition = n
          definition.target = run store(&mut p.doc, label)
          definition.tail = match HashMap<u64, usize>.get(&p.footnoteIndex, hash) {
            Option<usize>.Some { value: prior } => prior
            _ => NONE
          }
          set(&mut p.doc, id, definition)
          drop run HashMap<u64, usize>.insert(&mut p.footnoteIndex, hash, id)
        }
      }
      id = id + 1
    }
    id = 1
  }

  // Extract every definition before any inline leaf resolves reference links.
  while id < blocks {
    let n = node(&p.doc, id)
    if n.kind == MarkdownNodeKind.Paragraph {
      let previous = Intrinsic.replace(p.input, makeInput())
      let input = run gather(&p, id, move previous)
      let consumed = run referenceDefinitions(&mut p, &input)
      let mut n = node(&p.doc, id)
      n.fenceLength = consumed
      if consumed < Bytes.length(&input.data) {
        n.span.start = position(&input, consumed, false)
      }
      set(&mut p.doc, id, n)
      if consumed == Bytes.length(&input.data) {
        unlink(&mut p.doc, id)
      }
      p.input = move input
    }
    id = id + 1
  }
  id = 1
  while id < blocks {
    let mut n = node(&p.doc, id)
    if n.kind == MarkdownNodeKind.Paragraph || n.kind == MarkdownNodeKind.Heading
      || n.kind == MarkdownNodeKind.TableCell {
      if n.parent != NONE {
        let previous = Intrinsic.replace(p.input, makeInput())
        let input = run gather(&p, id, move previous)
        let mut begin = n.fenceLength
        if p.options.taskLists && n.kind == MarkdownNodeKind.Paragraph {
          let mut item = node(&p.doc, n.parent)
          let raw = Bytes.asSlice(&input.data)
          if item.kind == MarkdownNodeKind.ListItem && item.first == id && begin + 3 < raw.length
            && raw[begin] == 91
            && raw[begin + 2] == 93
            && (raw[begin + 3] == 32 || raw[begin + 3] == 9)
            && (raw[begin + 1] == 32 || lower(raw[begin + 1]) == 120) {
            item.htmlType = if raw[begin + 1] == 32 {
              1
            } else {
              2
            }
            set(&mut p.doc, n.parent, item)
            begin = begin + 3
          }
        }
        run inlines(&mut p, id, &input, begin)
        p.input = move input
      }
    } else if n.kind == MarkdownNodeKind.CodeBlock || n.kind == MarkdownNodeKind.HtmlBlock {
      let previous = Intrinsic.replace(p.input, makeInput())
      let input = run gather(&p, id, move previous)
      let raw = Bytes.asSlice(&input.data)
      let mut end = raw.length
      if n.kind == MarkdownNodeKind.CodeBlock && !n.fenced {
        // Remove blank lines at the end of an indented block, retaining its final content newline.
        let mut lastContent: usize = 0
        let mut i: usize = 0
        while i < end {
          let line = i
          while i < end && raw[i] != 10 && raw[i] != 13 {
            i = i + 1
          }
          let mut content = line
          while content < i && (raw[content] == 32 || raw[content] == 9) {
            content = content + 1
          }
          let nonblank = content < i
          if i < end && raw[i] == 13 {
            i = i + 1
          }
          if i < end && raw[i] == 10 {
            i = i + 1
          }
          if nonblank {
            lastContent = i
          }
        }
        end = lastContent
      }
      let begin = Bytes.length(&p.doc.storage)
      run decodeInto(&mut p.doc.storage, bytes(raw, 0, end), false, false)
      if n.kind == MarkdownNodeKind.CodeBlock && end > 0 && raw[end - 1] != 10
        && raw[end - 1] != 13 {
        run Bytes.append(&mut p.doc.storage, b"\n")
      }
      let finish = Bytes.length(&p.doc.storage)
      n.value = TextRange { span: MarkdownSpan { start: begin, end: finish }, side: true }
      if same(bytes(raw, 0, end), bytes(Bytes.asSlice(&p.doc.storage), begin, finish)) {
        Bytes.truncate(&mut p.doc.storage, begin)
        n.value = run inputText(&mut p.doc, &input, 0, end)
      }
      set(&mut p.doc, id, n)
      p.input = move input
    }
    id = id + 1
  }
  if options.autolinkLiterals && options.maxNesting > 0 {
    coalesce(&mut p.doc)
    run emailLiterals(&mut p.doc)
  }
  if options.footnotes {
    run orderFootnotes(&mut p.doc)
  }
  run compact(&mut p.doc)
  return move p.doc
}

fn minimum(a: usize, b: usize) -> usize {
  if a < b {
    return a
  }
  return b
}

fn maximum(a: usize, b: usize) -> usize {
  if a > b {
    return a
  }
  return b
}

fn closeLast(p: &mut Parser<'_>) {
  let length = List<usize>.length(&p.open)
  closeTo(&mut p.*, length - 1)
}

fn beforeBlock(p: &mut Parser<'_>, parent: usize) {
  let mut n = node(&p.doc, parent)
  if n.blank && n.first != NONE {
    let mut ancestor = parent
    while ancestor != NONE {
      let mut container = node(&p.doc, ancestor)
      if container.kind == MarkdownNodeKind.List {
        container.tight = false
        set(&mut p.doc, ancestor, container)
        break
      }
      ancestor = container.parent
    }
  }
  n.blank = false
  set(&mut p.doc, parent, n)
}

fn makeInput() -> Input {
  return Input { data: Bytes.make(), pieces: List<Piece>.make() }
}

fn makeInline() -> Inline {
  return Inline {
    delimiters: List<Delimiter>.make(),
    last: NONE,
    brackets: List<Bracket>.make(),
    ticks: List<Backtick>.make(),
    tickIndex: HashMap<usize, usize>.make(Hash.seed(0)),
    normalized: Bytes.make(),
    work: 0,
  }
}

// Link labels are limited in Unicode characters, not UTF-8 bytes. Escapes retain both source characters.
fn labelClose(data: &[u8], start: usize) -> usize {
  let mut pos = start
  let mut count: usize = 0
  while pos < data.length {
    let c = data[pos]
    if c == 93 {
      return pos
    }
    if c == 91 || count >= 999 {
      return NONE
    }
    if c == 92 && pos + 1 < data.length && punctuation(data[pos + 1]) {
      pos = pos + 2
      count = count + 2
      if count > 999 {
        return NONE
      }
    } else {
      pos = utf8_scan.decode(data, pos).next
      count = count + 1
    }
  }
  return NONE
}

fn labelFits(data: &[u8]) -> bool {
  if data.length <= 999 {
    return true
  }
  let mut pos: usize = 0
  let mut count: usize = 0
  while pos < data.length && count < 999 {
    pos = utf8_scan.decode(data, pos).next
    count = count + 1
  }
  return pos == data.length
}

effect fn appendText(
  doc: &mut MarkdownDocument<'_>,
  input: &Input,
  parent: usize,
  start: usize,
  end: usize,
) -> usize
  ! OutOfMemoryError
  ? &mut Allocator {
  let value = run inputText(&mut doc.*, input, start, end)
  return run appendRange(&mut doc.*, parent, value, inputSpan(input, start, end))
}

effect fn appendRange(
  doc: &mut MarkdownDocument<'_>,
  parent: usize,
  value: TextRange,
  span: MarkdownSpan,
) -> usize
  ! OutOfMemoryError
  ? &mut Allocator {
  let last = node(&doc.*, parent).last
  if last != NONE {
    let mut n = node(&doc.*, last)
    if n.kind == MarkdownNodeKind.Text && n.marker == 0 && n.value.side == value.side
      && n.value.span.end == value.span.start
      && n.span.end == span.start {
      n.value.span.end = value.span.end
      n.span.end = span.end
      set(&mut doc.*, last, n)
      return last
    }
  }
  let id = run add(&mut doc.*, parent, MarkdownNodeKind.Text, span.start)
  let mut n = node(&doc.*, id)
  n.value = value
  n.span = span
  n.depth = 0
  set(&mut doc.*, id, n)
  return id
}

effect fn literalInput(
  doc: &mut MarkdownDocument<'_>,
  input: &Input,
  start: usize,
  end: usize,
) -> TextRange
  ! OutOfMemoryError
  ? &mut Allocator {
  let data = bytes(Bytes.asSlice(&input.data), start, end)
  let mut i: usize = 0
  while i < data.length && data[i] != 0 && data[i] != 13 {
    i = i + 1
  }
  if i == data.length {
    return run inputText(&mut doc.*, input, start, end)
  }
  let begin = Bytes.length(&doc.storage)
  run decodeInto(&mut doc.storage, data, false, false)
  return TextRange {
    span: MarkdownSpan { start: begin, end: Bytes.length(&doc.storage) },
    side: true,
  }
}

fn readLine(data: &[u8], start: usize) -> Line {
  let end = match byte_search.find2(bytes(data, start, data.length), 10, 13) {
    Option<usize>.Some { value } => start + value
    _ => data.length
  }
  let mut after = end
  if after < data.length && data[after] == 13 {
    after = after + 1
  }
  if after < data.length && data[after] == 10 {
    after = after + 1
  }
  return Line { start: start, end: end, after: after }
}

fn alertMarker(data: &[u8], start: usize, end: usize) -> u8 {
  let mut finish = end
  while finish > start && (data[finish - 1] == 32 || data[finish - 1] == 9) {
    finish = finish - 1
  }
  let value = bytes(data, start, finish)
  if value.length == 7 && foldedAt(value, 0, "[!note]") {
    return 1
  }
  if value.length == 6 && foldedAt(value, 0, "[!tip]") {
    return 2
  }
  if value.length == 12 && foldedAt(value, 0, "[!important]") {
    return 3
  }
  if value.length == 10 && foldedAt(value, 0, "[!warning]") {
    return 4
  }
  if value.length == 10 && foldedAt(value, 0, "[!caution]") {
    return 5
  }
  return 0
}

// A single forward pass splits cells. An escaped pipe never splits, including in code spans.
effect fn splitRow(data: &[u8], start: usize, end: usize) -> List<MarkdownSpan>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut cells = List<MarkdownSpan>.make()
  let mut begin = start
  let mut finish = end
  while begin < finish && (data[begin] == 32 || data[begin] == 9) {
    begin = begin + 1
  }
  while finish > begin && (data[finish - 1] == 32 || data[finish - 1] == 9) {
    finish = finish - 1
  }
  if begin < finish && data[begin] == 124 {
    begin = begin + 1
    if begin == finish {
      return move cells
    }
  }
  let mut pos = begin
  let mut lastPipe = false
  while pos < finish {
    if data[pos] == 92 && pos + 1 < finish && data[pos + 1] == 124 {
      pos = pos + 2
      lastPipe = false
      continue
    }
    if data[pos] == 124 {
      run List<MarkdownSpan>.append(&mut cells, trimmedCell(data, begin, pos))
      begin = pos + 1
      lastPipe = true
    } else {
      lastPipe = false
    }
    pos = pos + 1
  }
  if !lastPipe || begin < finish {
    run List<MarkdownSpan>.append(&mut cells, trimmedCell(data, begin, finish))
  }
  return move cells
}

fn trimmedCell(data: &[u8], start: usize, end: usize) -> MarkdownSpan {
  let mut begin = start
  let mut finish = end
  while begin < finish && (data[begin] == 32 || data[begin] == 9) {
    begin = begin + 1
  }
  while finish > begin && (data[finish - 1] == 32 || data[finish - 1] == 9) {
    finish = finish - 1
  }
  return MarkdownSpan { start: begin, end: finish }
}

fn delimiterAlignment(data: &[u8], span: MarkdownSpan) -> u8 {
  let mut pos = span.start
  let mut end = span.end
  let mut left = false
  let mut right = false
  if pos < end && data[pos] == 58 {
    left = true
    pos = pos + 1
  }
  if pos < end && data[end - 1] == 58 {
    right = true
    end = end - 1
  }
  if pos == end {
    return 255
  }
  while pos < end {
    if data[pos] != 45 {
      return 255
    }
    pos = pos + 1
  }
  if left && right {
    return 2
  }
  if left {
    return 1
  }
  if right {
    return 3
  }
  return 0
}

effect fn tableStart(p: &mut Parser<'_>, paragraph: usize, start: usize, line: &Line) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let data = source(&p.doc)

  // Reject ordinary paragraph lines without allocating split buffers.
  let mut scan = start
  while scan < line.end {
    let c = data[scan]
    if c != 45 && c != 58 && c != 124 && c != 32 && c != 9 {
      return false
    }
    scan = scan + 1
  }
  let old = node(&p.doc, paragraph)
  if old.tail == NONE {
    return false
  }
  let tail = List<Chunk>.get(&p.chunks, old.tail)
  let mut end = tail.end
  while end > tail.start && (data[end - 1] == 10 || data[end - 1] == 13) {
    end = end - 1
  }
  let delimiters = run splitRow(data, start, line.end)
  let headers = run splitRow(data, tail.start, end)
  let count = List<MarkdownSpan>.length(&headers)
  if count == 0 || count > 65535 || count != List<MarkdownSpan>.length(&delimiters) {
    return false
  }

  let mut i: usize = 0
  while i < count {
    if delimiterAlignment(data, List<MarkdownSpan>.get(&delimiters, i)) == 255 {
      return false
    }
    i = i + 1
  }
  drop data
  let mut table = paragraph
  if old.head != old.tail {
    let mut previous = old.head
    while List<Chunk>.get(&p.chunks, previous).next != old.tail {
      previous = List<Chunk>.get(&p.chunks, previous).next
    }
    let mut part = List<Chunk>.get(&p.chunks, previous)
    part.next = NONE
    List<Chunk>.set(&mut p.chunks, previous, part)
    let mut n = old
    n.tail = previous
    n.span.end = part.end
    set(&mut p.doc, paragraph, n)
    closeLast(&mut p.*)
    table = run push(&mut p.*, MarkdownNodeKind.Table, tail.start)
  }
  let mut tableNode = node(&p.doc, table)
  tableNode.kind = MarkdownNodeKind.Table
  tableNode.head = NONE
  tableNode.tail = NONE
  tableNode.start = count
  tableNode.span.start = tail.start
  tableNode.span.end = line.after
  set(&mut p.doc, table, tableNode)
  run tableRow(&mut p.*, table, tail.start, end, tail.end, true)
  let mut cell = node(&p.doc, node(&p.doc, table).first).first
  let alignmentStart = Bytes.length(&p.doc.storage)
  i = 0
  while i < count {
    let mut n = node(&p.doc, cell)
    n.marker = delimiterAlignment(source(&p.doc), List<MarkdownSpan>.get(&delimiters, i))
    run Bytes.append(&mut p.doc.storage, &[n.marker])
    set(&mut p.doc, cell, n)
    cell = n.next
    i = i + 1
  }
  tableNode = node(&p.doc, table)
  tableNode.target = TextRange {
    span: MarkdownSpan { start: alignmentStart, end: Bytes.length(&p.doc.storage) },
    side: true,
  }
  set(&mut p.doc, table, tableNode)
  return true
}

effect fn tableRow(
  p: &mut Parser<'_>,
  table: usize,
  start: usize,
  end: usize,
  after: usize,
  header: bool,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let cells = run splitRow(source(&p.doc), start, end)
  let count = node(&p.doc, table).start
  let row = run add(&mut p.doc, table, MarkdownNodeKind.TableRow, start)
  let mut n = node(&p.doc, row)
  n.ordered = header
  n.span.end = after
  set(&mut p.doc, row, n)
  let mut template = node(&p.doc, node(&p.doc, table).first).first
  let mut i: usize = 0
  while i < count {
    let span = if i < List<MarkdownSpan>.length(&cells) {
      List<MarkdownSpan>.get(&cells, i)
    } else {
      MarkdownSpan { start: end, end: end }
    }
    let cell = run add(&mut p.doc, row, MarkdownNodeKind.TableCell, span.start)
    let mut c = node(&p.doc, cell)
    c.span = span
    if !header {
      c.marker = node(&p.doc, template).marker
      template = node(&p.doc, template).next
    }
    set(&mut p.doc, cell, c)
    i = i + 1
  }
  let mut tableNode = node(&p.doc, table)
  tableNode.span.end = maximum(tableNode.span.end, after)
  let present = minimum(count, List<MarkdownSpan>.length(&cells))
  tableNode.indent = tableNode.indent + count - present
  set(&mut p.doc, table, tableNode)
}

@inlineAlways
fn inlineSpecial(c: u8, options: &MarkdownOptions) -> bool {
  return special(c) || options.strikethrough && c == 126
    || options.autolinkLiterals && (c == 119 || lower(c) == 104 || lower(c) == 102)
}

fn hostCharacter(c: u32) -> bool {
  return !whiteScalar(c) && !punctScalar(c)
}

// Every forward lookahead consumes the leaf's linear work allowance.
fn literalUrlEnd(data: &[u8], start: usize, work: &mut usize) -> usize {
  let www = at(data, start, "www.")
  let mut host = start
  if www {
    if start > 0 && !space(data[start - 1]) && data[start - 1] != 42 && data[start - 1] != 95
      && data[start - 1] != 126
      && data[start - 1] != 40 {
      return start
    }
  } else {
    if start > 0 && alpha(data[start - 1]) {
      return start
    }
    if foldedAt(data, start, "http://") {
      host = start + 7
    } else if foldedAt(data, start, "https://") {
      host = start + 8
    } else if foldedAt(data, start, "ftp://") {
      host = start + 6
    } else {
      return start
    }
    if host >= data.length || !hostCharacter(utf8_scan.decode(data, host).scalar) {
      return start
    }
  }
  let mut pos = utf8_scan.decode(data, host).next
  let mut dots: usize = 0
  let mut previousUnderscores: usize = 0
  let mut underscores: usize = 0
  while pos + 1 < data.length {
    if work.* == 0 {
      return start
    }
    work.* = work.* - 1
    if data[pos] == 92 && pos + 2 < data.length {
      pos = pos + 1
    }
    if data[pos] == 95 {
      underscores = underscores + 1
    } else if data[pos] == 46 {
      previousUnderscores = underscores
      underscores = 0
      dots = dots + 1
    } else if data[pos] != 45 && !hostCharacter(utf8_scan.decode(data, pos).scalar) {
      break
    }
    let decoded = utf8_scan.decode(data, pos)
    pos = decoded.next
  }
  if (underscores > 0 || previousUnderscores > 0) && dots <= 10 {
    return start
  }
  if www && dots == 0 {
    return start
  }
  while pos < data.length && !space(data[pos]) && data[pos] != 60 {
    if work.* == 0 {
      return start
    }
    work.* = work.* - 1
    pos = pos + 1
  }
  return trimUrl(data, start, pos)
}

fn trimUrl(data: &[u8], start: usize, end: usize) -> usize {
  let mut opening: usize = 0
  let mut closing: usize = 0
  let mut pos = start
  while pos < end {
    if data[pos] == 40 {
      opening = opening + 1
    }
    if data[pos] == 41 {
      closing = closing + 1
    }
    pos = pos + 1
  }
  let mut finish = end
  while finish > start {
    let c = data[finish - 1]
    if c == 41 && closing > opening {
      closing = closing - 1
      finish = finish - 1
    } else if c == 63 || c == 33 || c == 46 || c == 44 || c == 58 || c == 42 || c == 95 || c == 126
      || c == 39
      || c == 34 {
      finish = finish - 1
    } else if c == 59 {
      let mut scan = finish - 1
      while scan > start && alpha(data[scan - 1]) {
        scan = scan - 1
      }
      if scan < finish - 1 && scan > start && data[scan - 1] == 38 {
        finish = scan - 1
      } else {
        finish = finish - 1
      }
    } else {
      break
    }
  }
  return finish
}

effect fn literalLink(
  doc: &mut MarkdownDocument<'_>,
  input: &Input,
  parent: usize,
  start: usize,
  end: usize,
  prefix: string,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut target = run literalInput(&mut doc.*, input, start, end)
  if prefix != "" {
    let begin = Bytes.length(&doc.storage)
    run Bytes.append(&mut doc.storage, String.utf8Bytes(prefix))
    run Bytes.append(&mut doc.storage, bytes(Bytes.asSlice(&input.data), start, end))
    target = TextRange {
      span: MarkdownSpan { start: begin, end: Bytes.length(&doc.storage) },
      side: true,
    }
  }
  let id = run add(&mut doc.*, parent, MarkdownNodeKind.Link, position(input, start, false))
  let mut n = node(&doc.*, id)
  n.span = inputSpan(input, start, end)
  n.target = target
  n.depth = 1
  set(&mut doc.*, id, n)
  let child = run add(&mut doc.*, id, MarkdownNodeKind.Text, n.span.start)
  let mut childNode = node(&doc.*, child)
  childNode.span = n.span
  childNode.value = run literalInput(&mut doc.*, input, start, end)
  childNode.depth = 0
  set(&mut doc.*, child, childNode)
}

fn emailLocal(c: u8) -> bool {
  return alpha(c) || c >= 48 && c <= 57 || c == 46 || c == 43 || c == 45 || c == 95
}

// Consolidate adjacent visible text for email matching, including text decoded from entities and escapes.
effect fn emailLiterals(doc: &mut MarkdownDocument<'_>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut id: usize = 0
  let mut input = makeInput()
  while id != NONE {
    let n = node(&doc.*, id)
    let mut following = if n.kind == MarkdownNodeKind.Link {
      subtreeNext(&doc.*, id)
    } else {
      preorderNext(&doc.*, id)
    }
    if n.kind == MarkdownNodeKind.Text {
      // Own the scan buffer before appending destinations to the document's side storage.
      Bytes.clear(&mut input.data)
      List<Piece>.clear(&mut input.pieces)
      let mut last = id
      let mut current = id
      while current != NONE && node(&doc.*, current).kind == MarkdownNodeKind.Text {
        let part = node(&doc.*, current)
        let base = Bytes.length(&input.data)
        run Bytes.append(&mut input.data, String.utf8Bytes(text(&doc.*, part.value)))
        run emailPieces(&doc.*, part, &mut input, base)
        last = current
        current = part.next
      }
      following = subtreeNext(&doc.*, last)
      let data = Bytes.asSlice(&input.data)
      let mut pos: usize = 0
      let mut consumed: usize = 0
      while pos < data.length {
        let found = emailMatch(data, &mut pos)
        if found.end == 0 {
          break
        }
        if found.start > consumed {
          drop run appendEmailPart(&mut doc.*, id, &input, consumed, found.start, false, "")
        }
        let prefix = if found.prefixed {
          ""
        } else {
          "mailto:"
        }
        drop run appendEmailPart(&mut doc.*, id, &input, found.start, found.end, true, prefix)
        consumed = found.end
      }
      if consumed > 0 {
        if consumed < data.length {
          drop run appendEmailPart(&mut doc.*, id, &input, consumed, data.length, false, "")
        }
        let mut removed = id
        while true {
          let after = node(&doc.*, removed).next
          unlink(&mut doc.*, removed)
          if removed == last {
            break
          }
          removed = after
        }
      }
    }
    id = following
  }
}

fn subtreeNext(doc: &MarkdownDocument<'_>, root: usize) -> usize {
  let mut id = root
  while id != NONE {
    let n = node(doc, id)
    if n.next != NONE {
      return n.next
    }
    id = n.parent
  }
  return NONE
}

// Map decoded text positions once. Splitting a long decoded email sequence remains linear.
effect fn emailPieces(
  doc: &MarkdownDocument<'_>,
  n: MarkdownNode,
  input: &mut Input,
  base: usize,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  if !n.value.side {
    run List<Piece>.append(
      &mut input.pieces,
      Piece {
        input: base,
        start: n.value.span.start,
        length: n.value.span.end - n.value.span.start,
        atomic: false,
      },
    )
    return
  }
  let data = source(doc)
  let mut pos = n.span.start
  let mut offset = base
  while pos < n.span.end && offset < Bytes.length(&input.data) {
    let begin = pos
    let mut length: usize = 1
    if data[pos] == 92 && pos + 1 < n.span.end && punctuation(data[pos + 1]) {
      pos = pos + 2
    } else if data[pos] == 38 {
      let found = entity(data, pos)
      if found.end > pos && found.end <= n.span.end {
        pos = found.end
        if found.named != "" {
          length = String.byteLength(found.named)
        } else if found.scalar == 0 || found.scalar > 0x10ffff
          || found.scalar >= 0xd800 && found.scalar <= 0xdfff {
          length = 3
        } else if found.scalar >= 65536 {
          length = 4
        } else if found.scalar >= 2048 {
          length = 3
        } else if found.scalar >= 128 || found.scalar == 0 {
          length = 2
          if found.scalar == 0 {
            length = 3
          }
        }
      } else {
        pos = pos + 1
      }
    } else if data[pos] == 0 {
      pos = pos + 1
      length = 3
    } else {
      let decoded = utf8_scan.decode(data, pos)
      pos = decoded.next
      length = pos - begin
    }
    run List<Piece>.append(
      &mut input.pieces,
      Piece { input: offset, start: begin, length: pos - begin, atomic: true },
    )
    offset = offset + length
  }
}

effect fn appendEmailPart(
  doc: &mut MarkdownDocument<'_>,
  before: usize,
  input: &Input,
  start: usize,
  end: usize,
  linked: bool,
  prefix: string,
) -> usize
  ! OutOfMemoryError
  ? &mut Allocator {
  let parent = node(&doc.*, before).parent
  let mut id: usize = NONE
  if linked {
    run literalLink(&mut doc.*, input, parent, start, end, prefix)
    id = node(&doc.*, parent).last
  } else {
    id = run textNode(&mut doc.*, input, parent, start, end)
  }

  // add() appends; move the new node immediately before the old text node.
  unlink(&mut doc.*, id)
  let mut n = node(&doc.*, id)
  let mut old = node(&doc.*, before)
  n.parent = parent
  n.previous = old.previous
  n.next = before
  if old.previous != NONE {
    let mut previous = node(&doc.*, old.previous)
    previous.next = id
    set(&mut doc.*, old.previous, previous)
  } else {
    let mut p = node(&doc.*, parent)
    p.first = id
    set(&mut doc.*, parent, p)
  }
  old.previous = id
  set(&mut doc.*, before, old)
  set(&mut doc.*, id, n)
  return id
}

fn footnoteClose(data: &[u8], start: usize, end: usize) -> usize {
  if !at(data, start, "[^") {
    return NONE
  }
  let closing = labelClose(bytes(data, 0, end), start + 2)
  if closing == NONE || closing == start + 2 || closing + 1 >= end || data[closing + 1] != 58 {
    return NONE
  }
  return closing
}

fn findFootnote(p: &Parser<'_>, label: &[u8]) -> usize {
  let mut index = match HashMap<u64, usize>.get(&p.footnoteIndex, labelHash(label)) {
    Option<usize>.Some { value } => value
    _ => NONE
  }
  while index != NONE {
    let n = node(&p.doc, index)
    if same(String.utf8Bytes(text(&p.doc, n.target)), label) {
      return index
    }
    index = n.tail
  }
  return NONE
}

// Number references once in source-tree order, including references inside definitions, before moving definitions.
effect fn orderFootnotes(doc: &mut MarkdownDocument<'_>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut definitions = List<usize>.make()
  let mut queue = List<usize>.make()
  let mut id: usize = 1
  while id < List<MarkdownNode>.length(&doc.arena) {
    let mut n = node(&doc.*, id)
    if n.kind == MarkdownNodeKind.FootnoteDefinition {
      n.indent = 0
      set(&mut doc.*, id, n)
      run List<usize>.append(&mut definitions, id)
    }
    id = id + 1
  }
  id = 0
  while id != NONE {
    let mut n = node(&doc.*, id)
    if n.kind == MarkdownNodeKind.FootnoteReference {
      let mut definition = node(&doc.*, n.head)
      if definition.start == 0 {
        run List<usize>.append(&mut queue, n.head)
        definition.start = List<usize>.length(&queue)
      }
      definition.indent = definition.indent + 1
      n.start = definition.start
      n.indent = definition.indent
      set(&mut doc.*, n.head, definition)
      set(&mut doc.*, id, n)
    }
    id = preorderNext(&doc.*, id)
  }
  id = 0
  while id < List<usize>.length(&definitions) {
    unlink(&mut doc.*, List<usize>.get(&definitions, id))
    id = id + 1
  }
  id = 0
  while id < List<usize>.length(&queue) {
    appendExisting(&mut doc.*, 0, List<usize>.get(&queue, id))
    id = id + 1
  }
  id = 0
  while id < List<usize>.length(&definitions) {
    let definition = List<usize>.get(&definitions, id)
    if node(&doc.*, definition).start == 0 {
      appendExisting(&mut doc.*, 0, definition)
    }
    id = id + 1
  }
}

fn appendExisting(doc: &mut MarkdownDocument<'_>, parent: usize, id: usize) {
  let mut n = node(&doc.*, id)
  let mut p = node(&doc.*, parent)
  n.parent = parent
  n.previous = p.last
  n.next = NONE
  if p.last != NONE {
    let mut last = node(&doc.*, p.last)
    last.next = id
    set(&mut doc.*, p.last, last)
  } else {
    p.first = id
  }
  p.last = id
  set(&mut doc.*, parent, p)
  set(&mut doc.*, id, n)
}

struct EmailMatch {
  start: usize,
  end: usize,
  prefixed: bool,
}

fn emailAlnum(c: u8) -> bool {
  return alpha(c) || c >= 48 && c <= 57
}

fn emailProtocol(
  data: &[u8],
  atSign: usize,
  rewind: usize,
  limit: usize,
  protocol: string,
) -> bool {
  let length = String.byteLength(protocol)
  if length > limit - rewind {
    return false
  }
  let start = atSign - rewind - length
  if !at(data, start, protocol) {
    return false
  }
  return length == limit - rewind || !emailAlnum(data[start - 1])
}

// Each '@' advances the scan boundary. A segment is scanned at most once in each direction.
fn emailMatch(data: &[u8], cursor: &mut usize) -> EmailMatch {
  while cursor.* < data.length {
    let mut atSign = cursor.*
    while atSign < data.length && data[atSign] != 64 {
      atSign = atSign + 1
    }
    if atSign == data.length {
      cursor.* = data.length
      break
    }
    let mut limit = atSign - cursor.*
    let mut prefixed = false
    let mut xmpp = false
    while true {
      let mut rewind: usize = 0
      while rewind < limit {
        let c = data[atSign - rewind - 1]
        if emailLocal(c) {
          rewind = rewind + 1
          continue
        }
        if c == 58 && emailProtocol(data, atSign, rewind, limit, "mailto:") {
          prefixed = true
          rewind = rewind + 1
          continue
        }
        if c == 58 && emailProtocol(data, atSign, rewind, limit, "xmpp:") {
          prefixed = true
          xmpp = true
          rewind = rewind + 1
          continue
        }
        break
      }
      if rewind == 0 {
        cursor.* = atSign + 1
        break
      }
      let mut end = atSign + 1
      let mut dots: usize = 0
      while end < data.length {
        let c = data[end]
        if emailAlnum(c) {
          end = end + 1
        } else if c == 64 {
          break
        } else if c == 46 && end + 1 < data.length && emailAlnum(data[end + 1]) {
          dots = dots + 1
          end = end + 1
        } else if c == 45 || c == 95 || xmpp && c == 47 {
          end = end + 1
        } else {
          break
        }
      }
      if end < data.length && data[end] == 64 {
        cursor.* = atSign + 1
        limit = end - atSign - 1
        atSign = end
        continue
      }
      cursor.* = end
      if end > atSign + 1 && dots > 0 && alpha(data[end - 1]) {
        return EmailMatch { start: atSign - rewind, end: end, prefixed: prefixed }
      }
      break
    }
  }
  return EmailMatch { start: 0, end: 0, prefixed: false }
}

fn alignmentValue(value: u8) -> MarkdownAlignment {
  return match value {
    1 => MarkdownAlignment.Left
    2 => MarkdownAlignment.Center
    3 => MarkdownAlignment.Right
    _ => MarkdownAlignment.None
  }
}
