//! Sixty-four-bit signed integers for large fixed-width values and exact integer protocols.
//!
//! # When to use
//! Use `i64` when a stable signed 64-bit range is part of storage, interchange, or arithmetic.
//! Prefer `isize` only for target-sized offsets; its width changes with the compilation target.
//!
//! # Details
//! Ordinary arithmetic, narrowing conversions, division by zero, and invalid shift counts trap.
//! `checked*` returns [`Option`] instead, `wrapping*` uses arithmetic modulo 2^64, and `saturating*`
//! clamps at [`MIN`] or [`MAX`]. Signed right shifts preserve the sign bit.
//!
//! Decimal [`parse`] consumes the whole input and reports syntax separately from range overflow.
//! Use [`Format`] with `Format.display` for defaults or `Format.displayWith` for explicit options.
//! Both operations stream through a mutable `Writer` without `Allocator`. Conversion to `f32` or
//! `f64` can round large integers.
//!
//! # Gotchas
//! [`MIN`] has no positive i64 counterpart. Use [`wrappingNegate`] or [`saturatingNegate`] for its
//! negation boundary. Use [`checkedDivide`] when division by `-1` can receive [`MIN`].
//!
//! # Examples
//! ## Parse a complete signed decimal value
//! ```silk
//! import silk.format { Format, ParseError }
//!
//! import silk.i64
//!
//! import silk.result { Result }
//!
//! pub fn main() -> i32 {
//!   let parsed = i64.parse("-42")
//!   let value = move parsed
//!     |> Result<i64, ParseError>.unwrapOr(0)
//!   return i64.toI32(value + 84)
//! }
//! ```

import silk.bool
import silk.f32
import silk.f64
import silk.format { Format, ParseError }
import silk.i16
import silk.i32
import silk.i8
import silk.isize
import silk.option { Option }
import silk.result { Result }
import silk.u16
import silk.u32
import silk.u64
import silk.u8
import silk.usize

/// The largest `i64` value.
pub const MAX: i64 = 9223372036854775807

/// The smallest `i64` value.
pub const MIN: i64 = -9223372036854775808

/// The fixed width of `i64`, in bits.
pub const BITS: u32 = 64

/// Returns the arithmetic negation of `value` and traps when `value` is [`MIN`]. Use
/// this function when that boundary is a program error.
pub fn negate(value: i64) -> i64 {
  return Intrinsic.i64Negate(value)
}

/// Returns the arithmetic negation of `value`, wrapped to the `i64` range. [`MIN`]
/// stays [`MIN`]. Use this function for deliberate modulo arithmetic.
pub fn wrappingNegate(value: i64) -> i64 {
  return Intrinsic.i64WrappingNegate(value)
}

/// Returns the arithmetic negation of `value`, clamped to the `i64` range. [`MIN`]
/// becomes [`MAX`]. Use this function when the positive boundary is required.
pub fn saturatingNegate(value: i64) -> i64 {
  return Intrinsic.i64SaturatingNegate(value)
}

/// Converts `value` to `u8`. Traps if `value` is outside the `u8` range. Use
/// this function when an out-of-range value is a program error.
pub fn toU8(value: i64) -> u8 {
  return Intrinsic.i64ToU8(value)
}

/// Converts `value` to `u8`, or returns `None` if `value` is outside the `u8`
/// range. Use this function when an out-of-range value is input data.
pub fn checkedToU8(value: i64) -> Option<u8> {
  return Intrinsic.i64CheckedToU8<Option<u8>>(value, Option.some, Option.none)
}

/// Converts `value` to `u16`. Traps if `value` is outside the `u16` range. Use
/// this function when an out-of-range value is a program error.
pub fn toU16(value: i64) -> u16 {
  return Intrinsic.i64ToU16(value)
}

/// Converts `value` to `u16`, or returns `None` if `value` is outside the `u16`
/// range. Use this function when an out-of-range value is input data.
pub fn checkedToU16(value: i64) -> Option<u16> {
  return Intrinsic.i64CheckedToU16<Option<u16>>(value, Option.some, Option.none)
}

/// Converts `value` to `u32`. Traps if `value` is outside the `u32` range. Use
/// this function when an out-of-range value is a program error.
pub fn toU32(value: i64) -> u32 {
  return Intrinsic.i64ToU32(value)
}

/// Converts `value` to `u32`, or returns `None` if `value` is outside the `u32`
/// range. Use this function when an out-of-range value is input data.
pub fn checkedToU32(value: i64) -> Option<u32> {
  return Intrinsic.i64CheckedToU32<Option<u32>>(value, Option.some, Option.none)
}

/// Converts `value` to `u64`. Traps if `value` is outside the `u64` range. Use
/// this function when an out-of-range value is a program error.
pub fn toU64(value: i64) -> u64 {
  return Intrinsic.i64ToU64(value)
}

/// Converts `value` to `u64`, or returns `None` if `value` is outside the `u64`
/// range. Use this function when an out-of-range value is input data.
pub fn checkedToU64(value: i64) -> Option<u64> {
  return Intrinsic.i64CheckedToU64<Option<u64>>(value, Option.some, Option.none)
}

/// Converts `value` to `usize`. Traps if `value` is outside the `usize` range. Use
/// this function when an out-of-range value is a program error.
pub fn toUsize(value: i64) -> usize {
  return Intrinsic.i64ToUsize(value)
}

/// Converts `value` to `usize`, or returns `None` if `value` is outside the `usize`
/// range. Use this function when an out-of-range value is input data.
pub fn checkedToUsize(value: i64) -> Option<usize> {
  return Intrinsic.i64CheckedToUsize<Option<usize>>(value, Option.some, Option.none)
}

/// Converts `value` to `i8`. Traps if `value` is outside the `i8` range. Use
/// this function when an out-of-range value is a program error.
pub fn toI8(value: i64) -> i8 {
  return Intrinsic.i64ToI8(value)
}

/// Converts `value` to `i8`, or returns `None` if `value` is outside the `i8`
/// range. Use this function when an out-of-range value is input data.
pub fn checkedToI8(value: i64) -> Option<i8> {
  return Intrinsic.i64CheckedToI8<Option<i8>>(value, Option.some, Option.none)
}

/// Converts `value` to `i16`. Traps if `value` is outside the `i16` range. Use
/// this function when an out-of-range value is a program error.
pub fn toI16(value: i64) -> i16 {
  return Intrinsic.i64ToI16(value)
}

/// Converts `value` to `i16`, or returns `None` if `value` is outside the `i16`
/// range. Use this function when an out-of-range value is input data.
pub fn checkedToI16(value: i64) -> Option<i16> {
  return Intrinsic.i64CheckedToI16<Option<i16>>(value, Option.some, Option.none)
}

/// Converts `value` to `i32`. Traps if `value` is outside the `i32` range. Use
/// this function when an out-of-range value is a program error.
pub fn toI32(value: i64) -> i32 {
  return Intrinsic.i64ToI32(value)
}

/// Converts `value` to `i32`, or returns `None` if `value` is outside the `i32`
/// range. Use this function when an out-of-range value is input data.
pub fn checkedToI32(value: i64) -> Option<i32> {
  return Intrinsic.i64CheckedToI32<Option<i32>>(value, Option.some, Option.none)
}

/// Returns `value` unchanged as `i64`. Use this function when generic conversion code
/// can select `i64` as both source and destination.
pub fn toI64(value: i64) -> i64 {
  return Intrinsic.i64ToI64(value)
}

/// Returns `Some` with `value` unchanged as `i64`. Use this function when generic
/// checked-conversion code can select the same source and destination type.
pub fn checkedToI64(value: i64) -> Option<i64> {
  return Intrinsic.i64CheckedToI64<Option<i64>>(value, Option.some, Option.none)
}

/// Converts `value` to `isize`. Traps if `value` is outside the `isize` range. Use
/// this function when an out-of-range value is a program error.
pub fn toIsize(value: i64) -> isize {
  return Intrinsic.i64ToIsize(value)
}

/// Converts `value` to `isize`, or returns `None` if `value` is outside the `isize`
/// range. Use this function when an out-of-range value is input data.
pub fn checkedToIsize(value: i64) -> Option<isize> {
  return Intrinsic.i64CheckedToIsize<Option<isize>>(value, Option.some, Option.none)
}

/// Converts `value` to the nearest `f32` value, with ties to even. Only magnitudes below `2^24` are
/// exactly representable, so a larger `i64` rounds.
pub fn toF32(value: i64) -> f32 {
  return Intrinsic.i64ToF32(value)
}

/// Converts `value` to the nearest `f64` value, with ties to even. Only magnitudes below `2^53` are
/// exactly representable, so a larger `i64` rounds.
pub fn toF64(value: i64) -> f64 {
  return Intrinsic.i64ToF64(value)
}

/// Returns `left + right` and traps if the result is outside the `i64` range. Use this function
/// when overflow is a program error.
pub fn add(left: i64, right: i64) -> i64 {
  return Intrinsic.i64Add(left, right)
}

/// Returns `left - right` and traps if the result is outside the `i64` range. Use this function
/// when overflow is a program error.
pub fn subtract(left: i64, right: i64) -> i64 {
  return Intrinsic.i64Subtract(left, right)
}

/// Returns `left * right` and traps if the result is outside the `i64` range. Use this function
/// when overflow is a program error.
pub fn multiply(left: i64, right: i64) -> i64 {
  return Intrinsic.i64Multiply(left, right)
}

/// Returns `left / right`, rounded toward zero. Traps if `right` is zero or [`MIN`] is
/// divided by `-1`. Use this function when an invalid quotient is a program error.
pub fn divide(left: i64, right: i64) -> i64 {
  return Intrinsic.i64Divide(left, right)
}

/// Returns the remainder with the sign of `left`. Traps if `right` is zero or [`MIN`] is
/// divided by `-1`. Use this function when invalid division is a program error.
pub fn remainder(left: i64, right: i64) -> i64 {
  return Intrinsic.i64Remainder(left, right)
}

/// Returns the bitwise AND of `left` and `right`.
pub fn bitAnd(left: i64, right: i64) -> i64 {
  return Intrinsic.i64BitAnd(left, right)
}

/// Returns the bitwise OR of `left` and `right`.
pub fn bitOr(left: i64, right: i64) -> i64 {
  return Intrinsic.i64BitOr(left, right)
}

/// Returns the bitwise exclusive OR of `left` and `right`.
pub fn bitXor(left: i64, right: i64) -> i64 {
  return Intrinsic.i64BitXor(left, right)
}

/// Returns `value` with each bit inverted.
pub fn bitNot(value: i64) -> i64 {
  return Intrinsic.i64BitNot(value)
}

/// Shifts `left` bits left by `right` positions. Traps if `right` is negative or not less than
/// [`BITS`].
pub fn shiftLeft(left: i64, right: i64) -> i64 {
  return Intrinsic.i64ShiftLeft(left, right)
}

/// Shifts `left` bits right by `right` positions and preserves its sign. Traps if `right` is
/// negative or not less than [`BITS`].
pub fn shiftRight(left: i64, right: i64) -> i64 {
  return Intrinsic.i64ShiftRight(left, right)
}

/// Rotates the bits of `left` left by `right` positions.
pub fn rotateLeft(left: i64, right: i64) -> i64 {
  return Intrinsic.i64RotateLeft(left, right)
}

/// Rotates the bits of `left` right by `right` positions.
pub fn rotateRight(left: i64, right: i64) -> i64 {
  return Intrinsic.i64RotateRight(left, right)
}

/// Returns `left + right`, wrapped to the `i64` range. Use this function for
/// deliberate modulo arithmetic.
pub fn wrappingAdd(left: i64, right: i64) -> i64 {
  return Intrinsic.i64WrappingAdd(left, right)
}

/// Returns `left - right`, wrapped to the `i64` range. Use this function for
/// deliberate modulo arithmetic.
pub fn wrappingSubtract(left: i64, right: i64) -> i64 {
  return Intrinsic.i64WrappingSubtract(left, right)
}

/// Returns `left * right`, wrapped to the `i64` range. Use this function for
/// deliberate modulo arithmetic.
pub fn wrappingMultiply(left: i64, right: i64) -> i64 {
  return Intrinsic.i64WrappingMultiply(left, right)
}

/// Returns `left + right`, clamped to [`MIN`] or [`MAX`]. Use this function when a
/// boundary value is the required overflow result.
pub fn saturatingAdd(left: i64, right: i64) -> i64 {
  return Intrinsic.i64SaturatingAdd(left, right)
}

/// Returns `left - right`, clamped to [`MIN`] or [`MAX`]. Use this function when a
/// boundary value is the required overflow result.
pub fn saturatingSubtract(left: i64, right: i64) -> i64 {
  return Intrinsic.i64SaturatingSubtract(left, right)
}

/// Returns `left * right`, clamped to [`MIN`] or [`MAX`]. Use this function when a
/// boundary value is the required overflow result.
pub fn saturatingMultiply(left: i64, right: i64) -> i64 {
  return Intrinsic.i64SaturatingMultiply(left, right)
}

/// Returns `Some` with `left + right`, or `None` if the result is outside the `i64` range.
/// Use this function when overflow is input data.
pub fn checkedAdd(left: i64, right: i64) -> Option<i64> {
  return Intrinsic.i64CheckedAdd<Option<i64>>(left, right, Option.some, Option.none)
}

/// Returns `Some` with `left - right`, or `None` if the result is outside the `i64` range.
/// Use this function when overflow is input data.
pub fn checkedSubtract(left: i64, right: i64) -> Option<i64> {
  return Intrinsic.i64CheckedSubtract<Option<i64>>(left, right, Option.some, Option.none)
}

/// Returns `Some` with `left * right`, or `None` if the result is outside the `i64` range.
/// Use this function when overflow is input data.
pub fn checkedMultiply(left: i64, right: i64) -> Option<i64> {
  return Intrinsic.i64CheckedMultiply<Option<i64>>(left, right, Option.some, Option.none)
}

/// Returns `Some` with `left / right`, or `None` if `right` is zero or [`MIN`] is
/// divided by `-1`. Use this function when an invalid quotient is input data.
pub fn checkedDivide(left: i64, right: i64) -> Option<i64> {
  return Intrinsic.i64CheckedDivide<Option<i64>>(left, right, Option.some, Option.none)
}

/// Returns `Some` with the remainder, or `None` if `right` is zero or [`MIN`] is
/// divided by `-1`. Use this function when invalid division is input data.
pub fn checkedRemainder(left: i64, right: i64) -> Option<i64> {
  return Intrinsic.i64CheckedRemainder<Option<i64>>(left, right, Option.some, Option.none)
}

/// Returns `true` when `left` and `right` are equal.
pub fn equals(left: i64, right: i64) -> bool {
  return Intrinsic.i64Equals(left, right)
}

/// Returns `true` when `left` and `right` are not equal.
pub fn notEquals(left: i64, right: i64) -> bool {
  return Intrinsic.i64NotEquals(left, right)
}

/// Returns `true` when `left` is less than `right`.
pub fn lessThan(left: i64, right: i64) -> bool {
  return Intrinsic.i64LessThan(&left, &right)
}

/// Returns `true` when `left` is less than or equal to `right`.
pub fn lessOrEqual(left: i64, right: i64) -> bool {
  return Intrinsic.i64LessOrEqual(left, right)
}

/// Returns `true` when `left` is greater than `right`.
pub fn greaterThan(left: i64, right: i64) -> bool {
  return Intrinsic.i64GreaterThan(left, right)
}

/// Returns `true` when `left` is greater than or equal to `right`.
pub fn greaterOrEqual(left: i64, right: i64) -> bool {
  return Intrinsic.i64GreaterOrEqual(left, right)
}

/// Reads the complete text as a signed decimal `i64`.
///
/// # Details
///
/// A failure contains `silk.format.NotANumber` for empty text, a leading `+`, a non-digit, or
/// trailing bytes. It contains `silk.format.OutOfRange` if the number is outside the `i64` range.
pub fn parse(text: string) -> Result<i64, ParseError> {
  return Format.i64Value(text)
}
