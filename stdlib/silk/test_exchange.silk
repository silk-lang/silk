//! Strict binary plans and receipts for private control of the ordinary Silk test runner.
//! Test output uses inherited stdout and stderr and has no result authority.

import silk.allocator { Allocator, OutOfMemoryError }
import silk.bytes { Bytes }
import silk.option { Option }
import silk.sha2 { Sha256 }
import silk.slice { Slice }
import silk.string { String }
import silk.u32
import silk.u64
import silk.u8
import silk.usize

const VERSION: u32 = 1
const PER_TEST: u32 = 1
const UNCACHED: u32 = 2
const COMPACT_BYTES: usize = 256
const HARD_MAXIMUM_BYTES: usize = 16777216

/// A cursor over one borrowed host plan.
pub struct Plan<'a> {
  bytes: &'a [u8]
  cursor: usize
  modeValue: u32
  failedValue: bool
}

/// One borrowed per-test plan entry.
pub struct Entry<'a> {
  executionBytes: &'a [u8]
  actionValue: u8
  validValue: bool
}

/// An owned receipt under construction.
pub struct Receipt {
  bytes: Bytes
  modeValue: u32
}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut different: u8 = 0
  let mut index = usize.ZERO
  while index < left.length {
    different = u8.bitOr(different, u8.bitXor(left[index], right[index]))
    index = index + usize.ONE
  }
  return different == 0
}

fn reject(plan: &mut Plan) -> () { plan.failedValue = true }

fn take<'a>(plan: &mut Plan<'a>, length: usize) -> &'a [u8] {
  if plan.failedValue || length > plan.bytes.length - plan.cursor {
    reject(&mut plan)
    return Slice.view<u8>(plan.bytes, usize.ZERO, usize.ZERO)
  }
  let result = Slice.view<u8>(plan.bytes, plan.cursor, length)
  plan.cursor = plan.cursor + length
  return result
}

fn readU8(plan: &mut Plan) -> u8 {
  let bytes = take(&mut plan, usize.ONE)
  if plan.failedValue { return 0 }
  return bytes[usize.ZERO]
}

fn readU32(plan: &mut Plan) -> u32 {
  let bytes = take(&mut plan, 4)
  if plan.failedValue { return 0 }
  let mut result: u32 = 0
  let mut index = usize.ZERO
  while index < 4 {
    result = u32.bitOr(result, u32.shiftLeft(u8.toU32(bytes[index]), usize.toU32(index * 8)))
    index = index + usize.ONE
  }
  return result
}

fn readU64(plan: &mut Plan) -> u64 {
  let bytes = take(&mut plan, 8)
  if plan.failedValue { return 0 }
  let mut result: u64 = 0
  let mut index = usize.ZERO
  while index < 8 {
    result = u64.bitOr(result, u64.shiftLeft(u8.toU64(bytes[index]), usize.toU64(index * 8)))
    index = index + usize.ONE
  }
  return result
}

fn readText<'a>(plan: &mut Plan<'a>) -> &'a [u8] {
  let length = readU64(&mut plan)
  let narrowed = u64.checkedToUsize(length)
  return match move narrowed {
    Option<usize>.Some { value } => take(&mut plan, value)
    Option<usize>.None => rejectedEmpty(&mut plan)
  }
}

fn rejectedEmpty<'a>(plan: &mut Plan<'a>) -> &'a [u8] {
  reject(&mut plan)
  return Slice.view<u8>(plan.bytes, usize.ZERO, usize.ZERO)
}

effect fn append(out: &mut Bytes, bytes: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  return run Bytes.append(&mut out, bytes)
}

effect fn appendU8(out: &mut Bytes, value: u8) -> () ! OutOfMemoryError ? &mut Allocator {
  let one = [value]
  return run append(&mut out, &one)
}

effect fn appendU32(out: &mut Bytes, value: u32) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut index = usize.ZERO
  while index < 4 {
    let shifted = u32.shiftRight(value, usize.toU32(index * 8))
    run appendU8(&mut out, u32.toU8(u32.bitAnd(shifted, 255)))
    index = index + usize.ONE
  }
  return ()
}

effect fn appendU64(out: &mut Bytes, value: u64) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut index = usize.ZERO
  while index < 8 {
    let shifted = u64.shiftRight(value, usize.toU64(index * 8))
    run appendU8(&mut out, u64.toU8(u64.bitAnd(shifted, 255)))
    index = index + usize.ONE
  }
  return ()
}

effect fn appendText(out: &mut Bytes, value: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  run appendU64(&mut out, usize.toU64(value.length))
  return run append(&mut out, value)
}

/// Opens a plan and validates its common magic, version, mode, and nonce framing.
pub fn openPlan<'a>(bytes: &'a [u8]) -> Plan<'a> {
  let mut plan = Plan<'a> {bytes: bytes, cursor: usize.ZERO, modeValue: 0, failedValue: false}
  let magic = take(&mut plan, 8)
  let version = readU32(&mut plan)
  let mode = readU32(&mut plan)
  let nonce = take(&mut plan, 32)
  drop nonce
  if same(magic, b"SLKTPLN1") == false || version != VERSION || (mode != PER_TEST && mode != UNCACHED) {
    reject(&mut plan)
  }
  plan.modeValue = mode
  return move plan
}

/// Returns true when this is the bounded per-test mode.
pub fn isPerTest(plan: &Plan) -> bool { return plan.modeValue == PER_TEST }

/// Returns true when this is the fixed-size uncached mode.
pub fn isUncached(plan: &Plan) -> bool { return plan.modeValue == UNCACHED }

/// Returns whether parsing has rejected the plan.
pub fn failed(plan: &Plan) -> bool { return plan.failedValue }

/// Validates the per-test count and complete-file bound before any test body may run.
pub fn beginPerTest(plan: &mut Plan, expectedDiscovered: u64) -> bool {
  if !isPerTest(&plan) { reject(&mut plan) return false }
  let discovered = readU64(&mut plan)
  if discovered != expectedDiscovered { reject(&mut plan) return false }
  let count = match move u64.checkedToUsize(discovered) {
    Option<usize>.Some { value } => value
    Option<usize>.None => { reject(&mut plan) return false }
  }
  let mut bound = HARD_MAXIMUM_BYTES
  if count <= (HARD_MAXIMUM_BYTES - 4096) / 256 { bound = 4096 + count * 256 }
  if bound < 84 || plan.bytes.length > bound - 84 { reject(&mut plan) return false }
  return !plan.failedValue
}

/// Reads and validates the next canonical catalog entry.
pub fn readEntry<'a>(
  plan: &mut Plan<'a>,
  expectedOrdinal: u64,
  expectedDeclaration: &[u8],
) -> Entry<'a> {
  if isUncached(&plan) { return uncachedEntry(plan.bytes) }
  let ordinal = readU64(&mut plan)
  let declaration = readText(&mut plan)
  let execution = readText(&mut plan)
  let action = readU8(&mut plan)
  let valid = !plan.failedValue
    && ordinal == expectedOrdinal
    && declaration.length != usize.ZERO
    && same(declaration, expectedDeclaration)
    && (action == 0 || action == 1)
    && (action == 0 || execution.length != usize.ZERO)
  if !valid { reject(&mut plan) }
  return Entry<'a> {executionBytes: execution, actionValue: action, validValue: valid}
}

/// Returns true when an entry is a validated cache hit.
pub fn cached(entry: &Entry) -> bool { return entry.validValue && entry.actionValue == 1 }

/// Borrows the opaque execution identity carried by an entry.
pub fn executionIdentity<'a>(entry: &Entry<'a>) -> &'a [u8] { return entry.executionBytes }

/// Returns the empty non-cached entry used by aggregate uncached execution.
pub fn uncachedEntry<'a>(bytes: &'a [u8]) -> Entry<'a> {
  return Entry<'a> {
    executionBytes: Slice.view<u8>(bytes, usize.ZERO, usize.ZERO),
    actionValue: 0,
    validValue: true,
  }
}

/// Requires the complete per-test plan to end exactly after the catalog.
pub fn finishPerTest(plan: &mut Plan) -> bool {
  if plan.cursor != plan.bytes.length { reject(&mut plan) }
  return !plan.failedValue
}

/// Validates an exact 256-byte compact plan, including catalog binding and zero padding.
pub fn validateUncached(
  plan: &mut Plan,
  expectedCatalogDigest: &[u8],
  expectedDiscovered: u64,
) -> bool {
  if failed(&plan) || !isUncached(&plan) || plan.bytes.length != COMPACT_BYTES {
    reject(&mut plan)
    return false
  }
  let digest = take(&mut plan, 32)
  let discovered = readU64(&mut plan)
  if failed(&plan) { return false }
  if !same(digest, expectedCatalogDigest) || discovered != expectedDiscovered {
    reject(&mut plan)
    return false
  }
  while plan.cursor < plan.bytes.length {
    if readU8(&mut plan) != 0 {
      reject(&mut plan)
      return false
    }
  }
  return !plan.failedValue
}

/// Frames one catalog identity into the compact-mode catalog digest.
pub fn updateCatalogDigest(state: &mut Sha256, ordinal: u64, identity: &[u8]) -> () {
  let mut ordinalBytes: [u8; 8] = [0, 0, 0, 0, 0, 0, 0, 0]
  let mut lengthBytes: [u8; 8] = [0, 0, 0, 0, 0, 0, 0, 0]
  let mut index = usize.ZERO
  while index < 8 {
    ordinalBytes[index] = u64.toU8(u64.bitAnd(u64.shiftRight(ordinal, usize.toU64(index * 8)), 255))
    lengthBytes[index] = u64.toU8(u64.bitAnd(u64.shiftRight(usize.toU64(identity.length), usize.toU64(index * 8)), 255))
    index = index + usize.ONE
  }
  Sha256.update(&mut state.*, &ordinalBytes)
  Sha256.update(&mut state.*, &lengthBytes)
  return Sha256.update(&mut state.*, identity)
}

/// Starts a receipt bound to the complete plan bytes and invocation nonce.
pub effect fn beginReceipt(
  plan: &[u8],
  perTest: bool,
  selected: u64,
) -> Receipt ! OutOfMemoryError ? &mut Allocator {
  let mut bytes = Bytes.make()
  run append(&mut bytes, b"SLKTRCP1")
  run appendU32(&mut bytes, VERSION)
  let mut mode = UNCACHED
  if perTest { mode = PER_TEST }
  run appendU32(&mut bytes, mode)
  run append(&mut bytes, Slice.view<u8>(plan, 16, 32))
  let digest = Sha256.hash(plan)
  run append(&mut bytes, &digest)
  if perTest { run appendU64(&mut bytes, selected) }
  return Receipt {bytes: move bytes, modeValue: mode}
}

/// Appends one selected per-test result in canonical ordinal order.
pub effect fn appendResult(
  receipt: &mut Receipt,
  ordinal: u64,
  declaration: &[u8],
  execution: &[u8],
  disposition: u8,
) -> () ! OutOfMemoryError ? &mut Allocator {
  if receipt.modeValue != PER_TEST || disposition > 2 { let invalid = 1 / 0 }
  run appendU64(&mut receipt.bytes, ordinal)
  run appendText(&mut receipt.bytes, declaration)
  run appendText(&mut receipt.bytes, execution)
  return run appendU8(&mut receipt.bytes, disposition)
}

/// Finishes a complete receipt. Compact mode is padded to exactly 256 bytes.
pub effect fn finishReceipt(
  receipt: Receipt,
  discovered: u64,
  selected: u64,
  cachedCount: u64,
  executed: u64,
  passed: u64,
  failedCount: u64,
  status: u32,
) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut owned = move receipt
  run appendU64(&mut owned.bytes, discovered)
  run appendU64(&mut owned.bytes, selected)
  run appendU64(&mut owned.bytes, cachedCount)
  run appendU64(&mut owned.bytes, executed)
  run appendU64(&mut owned.bytes, passed)
  run appendU64(&mut owned.bytes, failedCount)
  run appendU32(&mut owned.bytes, status)
  if owned.modeValue == UNCACHED {
    while owned.bytes.length() < COMPACT_BYTES { run appendU8(&mut owned.bytes, 0) }
    if owned.bytes.length() != COMPACT_BYTES { let invalid = 1 / 0 }
  }
  return move owned.bytes
}
