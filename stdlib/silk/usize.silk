/// Converts `value` to the nearest `f32` value, with ties to even. Only magnitudes below `2^24` are
/// exactly representable, so a larger `usize` rounds.
pub fn toF32(value: usize) -> f32 {
  return Intrinsic.usizeToF32(value)
}

/// Converts `value` to the nearest `f64` value, with ties to even. Only magnitudes below `2^53` are
/// exactly representable, so a larger `usize` rounds. Every `usize` is exact on a 32-bit target.
pub fn toF64(value: usize) -> f64 {
  return Intrinsic.usizeToF64(value)
}

/// Converts `value` to `u8` modulo 2^8. Keeps the low 8 bits of the two's complement
/// form of `value` and reads them as `u8`, so it never traps. Use this function for deliberate
/// truncation, sign extension, or bit reinterpretation, such as reading a signed field.
pub fn wrappingToU8(value: usize) -> u8 {
  return u64.wrappingToU8(wrappingToU64(value))
}

/// Converts `value` to `u16` modulo 2^16. Keeps the low 16 bits of the two's complement
/// form of `value` and reads them as `u16`, so it never traps. Use this function for deliberate
/// truncation, sign extension, or bit reinterpretation, such as reading a signed field.
pub fn wrappingToU16(value: usize) -> u16 {
  return u64.wrappingToU16(wrappingToU64(value))
}

/// Converts `value` to `u32` modulo 2^32. Keeps the low 32 bits of the two's complement
/// form of `value` and reads them as `u32`, so it never traps. Use this function for deliberate
/// truncation, sign extension, or bit reinterpretation, such as reading a signed field.
pub fn wrappingToU32(value: usize) -> u32 {
  return u64.wrappingToU32(wrappingToU64(value))
}

/// Converts `value` to `u64` modulo 2^64. Keeps the low 64 bits of the two's complement
/// form of `value` and reads them as `u64`, so it never traps. Use this function for deliberate
/// truncation, sign extension, or bit reinterpretation, such as reading a signed field.
pub fn wrappingToU64(value: usize) -> u64 {
  return toU64(value)
}

/// Returns `value` unchanged. Use this function when generic wrapping-conversion code
/// can select `usize` as both source and destination.
pub fn wrappingToUsize(value: usize) -> usize {
  return value
}

/// Converts `value` to `i8` modulo 2^8. Keeps the low 8 bits of the two's complement
/// form of `value` and reads them as `i8`, so it never traps. Use this function for deliberate
/// truncation, sign extension, or bit reinterpretation, such as reading a signed field.
pub fn wrappingToI8(value: usize) -> i8 {
  return u64.wrappingToI8(wrappingToU64(value))
}

/// Converts `value` to `i16` modulo 2^16. Keeps the low 16 bits of the two's complement
/// form of `value` and reads them as `i16`, so it never traps. Use this function for deliberate
/// truncation, sign extension, or bit reinterpretation, such as reading a signed field.
pub fn wrappingToI16(value: usize) -> i16 {
  return u64.wrappingToI16(wrappingToU64(value))
}

/// Converts `value` to `i32` modulo 2^32. Keeps the low 32 bits of the two's complement
/// form of `value` and reads them as `i32`, so it never traps. Use this function for deliberate
/// truncation, sign extension, or bit reinterpretation, such as reading a signed field.
pub fn wrappingToI32(value: usize) -> i32 {
  return u64.wrappingToI32(wrappingToU64(value))
}

/// Converts `value` to `i64` modulo 2^64. Keeps the low 64 bits of the two's complement
/// form of `value` and reads them as `i64`, so it never traps. Use this function for deliberate
/// truncation, sign extension, or bit reinterpretation, such as reading a signed field.
pub fn wrappingToI64(value: usize) -> i64 {
  return u64.wrappingToI64(wrappingToU64(value))
}

/// Converts `value` to `isize` modulo 2^`isize.BITS`. Keeps the low `isize.BITS` bits of the two's
/// complement form of `value` and reads them as `isize`, so it never traps. Use this function for
/// deliberate truncation, sign extension, or bit reinterpretation, such as reading a signed field.
pub fn wrappingToIsize(value: usize) -> isize {
  return u64.wrappingToIsize(wrappingToU64(value))
}

/// Returns `left + right` and traps if the result is outside the `usize` range. Use this function
/// when overflow is a program error.
pub fn add(left: usize, right: usize) -> usize {
  return Intrinsic.usizeAdd(left, right)
}

/// Returns `left - right` and traps if the result is outside the `usize` range. Use this function
/// when overflow is a program error.
pub fn subtract(left: usize, right: usize) -> usize {
  return Intrinsic.usizeSubtract(left, right)
}

/// Returns `left * right` and traps if the result is outside the `usize` range. Use this function
/// when overflow is a program error.
pub fn multiply(left: usize, right: usize) -> usize {
  return Intrinsic.usizeMultiply(left, right)
}

/// Returns `left / right`. Traps if `right` is zero. Use this function when a zero
/// divisor is a program error.
pub fn divide(left: usize, right: usize) -> usize {
  return Intrinsic.usizeDivide(left, right)
}

/// Returns the remainder of `left / right`. Traps if `right` is zero. Use this function
/// when a zero divisor is a program error.
pub fn remainder(left: usize, right: usize) -> usize {
  return Intrinsic.usizeRemainder(left, right)
}

/// Returns the bitwise AND of `left` and `right`.
pub fn bitAnd(left: usize, right: usize) -> usize {
  return Intrinsic.usizeBitAnd(left, right)
}

/// Returns the bitwise OR of `left` and `right`.
pub fn bitOr(left: usize, right: usize) -> usize {
  return Intrinsic.usizeBitOr(left, right)
}

/// Returns the bitwise exclusive OR of `left` and `right`.
pub fn bitXor(left: usize, right: usize) -> usize {
  return Intrinsic.usizeBitXor(left, right)
}

/// Returns `value` with each bit inverted.
pub fn bitNot(value: usize) -> usize {
  return Intrinsic.usizeBitNot(value)
}

/// Shifts `left` bits left by `right` positions. Traps if `right` is not less than [`BITS`].
pub fn shiftLeft(left: usize, right: usize) -> usize {
  return Intrinsic.usizeShiftLeft(left, right)
}

/// Shifts `left` bits right by `right` positions and inserts zero bits. Traps if `right` is
/// not less than [`BITS`].
pub fn shiftRight(left: usize, right: usize) -> usize {
  return Intrinsic.usizeShiftRight(left, right)
}

/// Rotates the bits of `left` left by `right` positions. The count is reduced modulo [`BITS`], so
/// each count is valid.
pub fn rotateLeft(left: usize, right: usize) -> usize {
  return Intrinsic.usizeRotateLeft(left, right)
}

/// Rotates the bits of `left` right by `right` positions. The count is reduced modulo [`BITS`], so
/// each count is valid.
pub fn rotateRight(left: usize, right: usize) -> usize {
  return Intrinsic.usizeRotateRight(left, right)
}

/// Returns the number of one bits in `value`.
pub fn countOnes(value: usize) -> u32 {
  return u64.countOnes(toU64(value))
}

/// Returns the number of zero bits above the highest one bit of `value`. Returns [`BITS`] for
/// zero.
pub fn leadingZeros(value: usize) -> u32 {
  return u64.leadingZeros(toU64(value)) - (64 - BITS)
}

/// Returns the number of zero bits below the lowest one bit of `value`. Returns [`BITS`] for zero.
pub fn trailingZeros(value: usize) -> u32 {
  if value == 0 { return BITS }
  return u64.trailingZeros(toU64(value))
}

/// Returns `left + right`, wrapped to the `usize` range. Use this function for
/// deliberate modulo arithmetic.
pub fn wrappingAdd(left: usize, right: usize) -> usize {
  return Intrinsic.usizeWrappingAdd(left, right)
}

/// Returns `left - right`, wrapped to the `usize` range. Use this function for
/// deliberate modulo arithmetic.
pub fn wrappingSubtract(left: usize, right: usize) -> usize {
  return Intrinsic.usizeWrappingSubtract(left, right)
}

/// Returns `left * right`, wrapped to the `usize` range. Use this function for
/// deliberate modulo arithmetic.
pub fn wrappingMultiply(left: usize, right: usize) -> usize {
  return Intrinsic.usizeWrappingMultiply(left, right)
}

/// Returns `left + right`, clamped to [`MIN`] or [`MAX`]. Use this function when a
/// boundary value is the required overflow result.
pub fn saturatingAdd(left: usize, right: usize) -> usize {
  return Intrinsic.usizeSaturatingAdd(left, right)
}

/// Returns `left - right`, clamped to [`MIN`] or [`MAX`]. Use this function when a
/// boundary value is the required overflow result.
pub fn saturatingSubtract(left: usize, right: usize) -> usize {
  return Intrinsic.usizeSaturatingSubtract(left, right)
}

/// Returns `left * right`, clamped to [`MIN`] or [`MAX`]. Use this function when a
/// boundary value is the required overflow result.
pub fn saturatingMultiply(left: usize, right: usize) -> usize {
  return Intrinsic.usizeSaturatingMultiply(left, right)
}

/// Returns `Some` with `left + right`, or `None` if the result is outside the `usize` range.
/// Use this function when overflow is input data.
pub fn checkedAdd(left: usize, right: usize) -> Option<usize> {
  return Intrinsic.usizeCheckedAdd<Option<usize>>(left, right, Option.some, Option.none)
}

/// Returns `Some` with `left - right`, or `None` if the result is outside the `usize` range.
/// Use this function when overflow is input data.
pub fn checkedSubtract(left: usize, right: usize) -> Option<usize> {
  return Intrinsic.usizeCheckedSubtract<Option<usize>>(left, right, Option.some, Option.none)
}

/// Returns `Some` with `left * right`, or `None` if the result is outside the `usize` range.
/// Use this function when overflow is input data.
pub fn checkedMultiply(left: usize, right: usize) -> Option<usize> {
  return Intrinsic.usizeCheckedMultiply<Option<usize>>(left, right, Option.some, Option.none)
}

/// Returns `Some` with `left / right`, or `None` if `right` is zero. Use this
/// function when a zero divisor is input data.
pub fn checkedDivide(left: usize, right: usize) -> Option<usize> {
  return Intrinsic.usizeCheckedDivide<Option<usize>>(left, right, Option.some, Option.none)
}

/// Returns `Some` with the remainder, or `None` if `right` is zero. Use this function
/// when a zero divisor is input data.
pub fn checkedRemainder(left: usize, right: usize) -> Option<usize> {
  return Intrinsic.usizeCheckedRemainder<Option<usize>>(left, right, Option.some, Option.none)
}

/// Returns `true` if `left` and `right` are equal.
pub fn equals(left: usize, right: usize) -> bool {
  return Intrinsic.usizeEquals(left, right)
}

/// Returns `true` if `left` and `right` are not equal.
pub fn notEquals(left: usize, right: usize) -> bool {
  return Intrinsic.usizeNotEquals(left, right)
}

/// Returns `true` if `left` is less than `right`.
pub fn lessThan(left: usize, right: usize) -> bool {
  return Intrinsic.usizeLessThan(&left, &right)
}

/// Returns `true` if `left` is less than or equal to `right`.
pub fn lessOrEqual(left: usize, right: usize) -> bool {
  return Intrinsic.usizeLessOrEqual(left, right)
}

/// Returns `true` if `left` is greater than `right`.
pub fn greaterThan(left: usize, right: usize) -> bool {
  return Intrinsic.usizeGreaterThan(left, right)
}

/// Returns `true` if `left` is greater than or equal to `right`.
pub fn greaterOrEqual(left: usize, right: usize) -> bool {
  return Intrinsic.usizeGreaterOrEqual(left, right)
}

/// Returns the `usize` value of the decimal text `text`, or a `ParseError`.
///
/// # Details
///
/// The complete text must be one decimal number. This function does not skip spaces and does not
/// accept digit separators.
///
/// # Errors
///
/// - `ParseError` with reason `silk.format.NotANumber` if `text` is empty, has a sign, contains a
///   byte that is not a digit, or has bytes after the number. `offset` gives the byte position
///   where the read stopped.
/// - `ParseError` with reason `silk.format.OutOfRange` if the number is outside the range of
///   `usize` on the target.
pub fn parse(text: string) -> Result<usize, ParseError> {
  return Format.usizeValue(text)
}
