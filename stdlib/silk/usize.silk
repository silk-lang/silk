//! Pointer-width unsigned integers for lengths, indices, capacities, and allocation sizes.
//!
//! # When to use
//! Use `usize` for values that index target memory or describe its layout. Use a fixed-width
//! integer for serialized data, protocols, and persistent identifiers whose range must not change
//! between 32-bit and 64-bit targets.
//!
//! # Details
//! Each arithmetic operation has four forms with different overflow rules:
//!
//! - The plain form, such as [`add`], traps on overflow. Use it when overflow is a program error.
//! - The `checked` form, such as [`checkedAdd`], returns `None` on overflow. Use it when input data
//!   controls the operands.
//! - The `wrapping` form, such as [`wrappingAdd`], computes the result modulo two to the power of
//!   [`BITS`].
//! - The `saturating` form, such as [`saturatingAdd`], returns [`MIN`] or [`MAX`] on overflow.
//!
//! Division and remainder by zero trap. [`checkedDivide`] and [`checkedRemainder`] return `None`.
//! The shift count must be in the range 0 to `BITS - 1`. Otherwise, the program traps. A rotate
//! reduces its count modulo [`BITS`], so each count is valid. A right shift inserts zero bits.
//!
//! A `to` conversion, such as `toU8`, traps if the value is out of the range of the destination
//! type. A `checkedTo` conversion returns `None` instead. Conversion to `f32` or `f64` rounds to
//! the nearest value if the integer has more significant bits than the float.
//!
//! A `wrappingTo` conversion, such as `wrappingToI16`, never traps. It keeps the low bits of the
//! two's complement form of the value, like a cast in C or Rust, so it truncates, sign-extends, or
//! reinterprets bits.
//!
//! [`countOnes`], [`leadingZeros`], and [`trailingZeros`] count the bits of the value. For
//! zero, both zero counts return [`BITS`].
//!
//! [`BITS`], [`MIN`], and [`MAX`] depend on the target: 32 bits on `wasm32` and 64 bits on the
//! other targets.
//!
//! Use [`ZERO`] and [`ONE`] where a literal has no type context, because a literal without context
//! is an `i32`.
//!
//! [`parse`] reads decimal text. A sign is not valid. To write a value as text, use
//! `silk.format.Format.display` or `Format.displayWith` with a `Writer`. Neither needs an
//! `Allocator`.
//!
//! # Gotchas
//! A value valid as usize on a 64-bit target can be out of range on a 32-bit target.
//!
//! # Examples
//! ## Keep a count within the target range
//! ```silk
//! import silk.option { Option }
//! import silk.usize
//!
//! pub fn main() -> i32 {
//!   let next = usize.checkedAdd(usize.MAX, usize.ONE)
//!   let recovered = move next |> Option<usize>.unwrapOr(42)
//!   let result = usize.toI32(recovered)
//!   if result != 42 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! ## Parse decimal text and reject invalid text
//! ```silk
//! import silk.format { ParseError }
//! import silk.result { Result }
//! import silk.usize
//!
//! pub fn main() -> i32 {
//!   let parsed = usize.parse("42") |> Result<usize, ParseError>.unwrapOr(0)
//!   let invalid = usize.parse("4x2") |> Result<usize, ParseError>.unwrapOr(0)
//!   if parsed != 42 || invalid != 0 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Numbers

import silk.bool
import silk.f32
import silk.f64
import silk.format { Format, ParseError }
import silk.i16
import silk.i32
import silk.i64
import silk.i8
import silk.isize
import silk.option { Option }
import silk.result { Result }
import silk.target { pointerBits, usizeMax }
import silk.u16
import silk.u32
import silk.u64
import silk.u8

/// The largest `usize` value for the compilation target.
///
/// # Details
///
/// This is 4294967295 on a 32-bit target and 18446744073709551615 on a 64-bit target. Checked
/// arithmetic rejects results above it.
pub const MAX: usize = usizeMax

/// The smallest `usize` value, which is zero at each pointer width.
pub const MIN: usize = 0

/// The width of `usize` in bits, which is the compilation target's pointer width.
pub const BITS: u32 = pointerBits

/// The `usize` zero value for a count without a typed context.
pub const ZERO: usize = 0

/// The `usize` value one for a step or count that has no other type context.
pub const ONE: usize = 1

/// Converts `value` to `u8`. Traps if `value` is outside the `u8` range. Use
/// this function when an out-of-range value is a program error.
pub fn toU8(value: usize) -> u8 {
  if let Option<u8>.Some {value: converted} = checkedToU8(value) { return converted }
  return Intrinsic.trap("usize.toU8: the value is outside the u8 range")
}

/// Converts `value` to `u8`, or returns `None` if `value` is outside the `u8`
/// range. Use this function when an out-of-range value is input data.
pub fn checkedToU8(value: usize) -> Option<u8> {
  return Intrinsic.usizeCheckedToU8<Option<u8>>(value, Option.some, Option.none)
}

/// Converts `value` to `u16`. Traps if `value` is outside the `u16` range. Use
/// this function when an out-of-range value is a program error.
pub fn toU16(value: usize) -> u16 {
  if let Option<u16>.Some {value: converted} = checkedToU16(value) { return converted }
  return Intrinsic.trap("usize.toU16: the value is outside the u16 range")
}

/// Converts `value` to `u16`, or returns `None` if `value` is outside the `u16`
/// range. Use this function when an out-of-range value is input data.
pub fn checkedToU16(value: usize) -> Option<u16> {
  return Intrinsic.usizeCheckedToU16<Option<u16>>(value, Option.some, Option.none)
}

/// Converts `value` to `u32`. Traps if `value` is outside the `u32` range. Use
/// this function when an out-of-range value is a program error.
pub fn toU32(value: usize) -> u32 {
  if let Option<u32>.Some {value: converted} = checkedToU32(value) { return converted }
  return Intrinsic.trap("usize.toU32: the value is outside the u32 range")
}

/// Converts `value` to `u32`, or returns `None` if `value` is outside the `u32`
/// range. Use this function when an out-of-range value is input data.
pub fn checkedToU32(value: usize) -> Option<u32> {
  return Intrinsic.usizeCheckedToU32<Option<u32>>(value, Option.some, Option.none)
}

/// Converts `value` exactly to `u64`. Every `usize` value is representable.
pub fn toU64(value: usize) -> u64 {
  if let Option<u64>.Some {value: converted} = checkedToU64(value) { return converted }
  return Intrinsic.trap("usize.toU64: the value is outside the u64 range")
}

/// Converts `value` exactly to `u64` and returns `Some`. Every `usize` value is
/// representable.
pub fn checkedToU64(value: usize) -> Option<u64> {
  return Intrinsic.usizeCheckedToU64<Option<u64>>(value, Option.some, Option.none)
}

/// Returns `value` unchanged as `usize`. Use this function when generic conversion code
/// can select `usize` as both source and destination.
pub fn toUsize(value: usize) -> usize {
  return Intrinsic.usizeToUsize(value)
}

/// Returns `Some` with `value` unchanged as `usize`. Use this function when generic
/// checked-conversion code can select the same source and destination type.
pub fn checkedToUsize(value: usize) -> Option<usize> {
  return Intrinsic.usizeCheckedToUsize<Option<usize>>(value, Option.some, Option.none)
}

