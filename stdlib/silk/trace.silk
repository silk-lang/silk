//! Distributed tracing and metrics for code with or without an effect requirement.

import silk.concurrency.ambient_table { TraceContext }
import silk.core.option { Option }
import silk.core.ownership { Copy, Drop }
import silk.num.u64
import silk.trace.context as Context
import silk.trace.perfetto as Perfettos
import silk.trace.record as Records
import silk.trace.sink as Sinks

/// Owns the bounded storage for spans, logs and metrics.
pub type Recorder = Records.Recorder
/// Configures resource identity, sampling and recording capacity.
pub type Config = Records.Config
/// Keeps exported spans, log records and metric points in process.
pub type Memory = Records.Memory
/// A sink that writes telemetry as JSON through the active writer.
pub type Console = Sinks.Console
/// An OTLP/HTTP JSON collector destination.
pub type Otlp<'url> = Sinks.Otlp<'url>
/// A sink that writes telemetry as Perfetto trace packets through the active writer.
pub type Perfetto = Perfettos.Perfetto

/// Identifiers and trace flags that can be propagated to another service.
pub type SpanContext = Context.SpanContext
/// An owned W3C traceparent header value.
pub type Traceparent = Context.Traceparent

/// The OpenTelemetry relationship between a span and the operation it represents.
pub enum SpanKind { Internal, Server, Client, Producer, Consumer }

/// The static source location and instrumentation scope of a traced declaration.
pub struct Place {
  pub function: string<'static>,
  pub file: string<'static>,
  pub line: u64,
  pub packageName: string<'static>,
  pub packageVersion: string<'static>,
}
impl Copy for Place {}

const MANUAL: Place = Place {function: "", file: "", line: 0, packageName: "", packageVersion: ""}

/// Receives span observations in the dynamic scope of a provided recorder.
pub ambient service Tracer default Off {
  effect fn enter<Args>(static name: string<'static>, static kind: SpanKind, static place: Place, args: &Args, remote: Option<SpanContext>) -> () ? &Tracer
  effect fn exit() -> () ? &Tracer
  effect fn failed(static error: string<'static>) -> () ? &Tracer
  effect fn cancelled() -> () ? &Tracer
  effect fn attribute<V>(static key: string<'static>, value: &V) -> () ? &Tracer
  effect fn event<Args>(static name: string<'static>, args: &Args) -> () ? &Tracer
  effect fn recordError<V>(value: &V) -> () ? &Tracer
  effect fn link(context: &SpanContext) -> () ? &Tracer
}

/// Receives instrument measurements independently of span recording.
pub ambient service Meter default Off {
  effect fn add<Args>(static name: string<'static>, amount: u64, args: &Args) -> () ? &Meter
  effect fn adjust<Args>(static name: string<'static>, amount: i64, args: &Args) -> () ? &Meter
  effect fn gauge<Args>(static name: string<'static>, value: f64, args: &Args) -> () ? &Meter
  effect fn record<Args>(static name: string<'static>, value: f64, args: &Args) -> () ? &Meter
}

/// The default provider discards observations.
pub struct Off {}
impl Tracer for Off {
  @inlineAlways
  effect fn enter<Args>(self: &Self, static name: string<'static>, static kind: SpanKind, static place: Place, args: &Args, remote: Option<SpanContext>) -> () {}
  @inlineAlways
  effect fn exit(self: &Self) -> () {}
  @inlineAlways
  effect fn failed(self: &Self, static error: string<'static>) -> () {}
  @inlineAlways
  effect fn cancelled(self: &Self) -> () {}
  @inlineAlways
  effect fn attribute<V>(self: &Self, static key: string<'static>, value: &V) -> () {}
  @inlineAlways
  effect fn event<Args>(self: &Self, static name: string<'static>, args: &Args) -> () {}
  @inlineAlways
  effect fn recordError<V>(self: &Self, value: &V) -> () {}
  @inlineAlways
  effect fn link(self: &Self, context: &SpanContext) -> () {}
}
impl Meter for Off {
  @inlineAlways
  effect fn add<Args>(self: &Self, static name: string<'static>, amount: u64, args: &Args) -> () {}
  @inlineAlways
  effect fn adjust<Args>(self: &Self, static name: string<'static>, amount: i64, args: &Args) -> () {}
  @inlineAlways
  effect fn gauge<Args>(self: &Self, static name: string<'static>, value: f64, args: &Args) -> () {}
  @inlineAlways
  effect fn record<Args>(self: &Self, static name: string<'static>, value: f64, args: &Args) -> () {}
}

/// Closes a manual span when dropped in its opening ambient scope.
/// Nested guards must drop in reverse order. A mismatched drop traps before modifying the recorder.
pub struct SpanGuard { previous: TraceContext, table: usize, owner: u64, span: u64, record: u64 }

impl SpanGuard {
  @inlineAlways
  fn off() -> SpanGuard {
    return SpanGuard {previous: TraceContext.empty(), table: 0, owner: 0, span: 0, record: 0}
  }
}

impl Drop for SpanGuard {
  @inlineAlways
  fn drop(self: &mut Self) -> () {
    static if Intrinsic.ambientCount<Tracer>() > 0 {
      if !TraceContext.mayClose(&self.previous, self.table, self.owner, self.span, self.record) { return () }
    }
    run Tracer.exit()
    static if Intrinsic.ambientCount<Tracer>() > 0 {
      unsafe TraceContext.install(&self.previous)
    }
  }
}

/// Opens spans, annotates the current span and propagates trace context.
pub struct Trace {}
impl Trace {
  /// Opens an internal span until the returned guard drops.
  @inlineAlways
  pub fn span(static name: string<'static>) -> SpanGuard {
    return Trace.spanOf(name, SpanKind.Internal)
  }

  /// Opens a span of the selected OpenTelemetry kind.
  @inlineAlways
  pub fn spanOf(static name: string<'static>, static kind: SpanKind) -> SpanGuard {
    return Trace.open(name, kind, Option<SpanContext>.none())
  }

  /// Opens a server span with a remote parent.
  @inlineAlways
  pub fn spanFrom(remote: &SpanContext, static name: string<'static>) -> SpanGuard {
    static if Intrinsic.ambientCount<Tracer>() > 0 {
      return Trace.open(name, SpanKind.Server, Option<SpanContext>.some(remote.*))
    } else { return Trace.open(name, SpanKind.Server, Option<SpanContext>.none()) }
  }

  @inlineAlways
  fn snapshot() -> TraceContext {
    static if Intrinsic.ambientCount<Tracer>() > 0 { return TraceContext.read() }
    else { return TraceContext.empty() }
  }

  @inlineAlways
  fn open(static name: string<'static>, static kind: SpanKind, remote: Option<SpanContext>) -> SpanGuard {
    let previous = Trace.snapshot()
    run Tracer.enter(name, kind, MANUAL, &(), move remote)
    static if Intrinsic.ambientCount<Tracer>() > 0 {
      let active = TraceContext.read()
      return SpanGuard {previous: previous, table: TraceContext.tableAddress(), owner: active.owner,
        span: active.span, record: active.record}
    } else { return SpanGuard.off() }
  }

  /// Returns a copy of the active identifiers and flags, including for unsampled spans.
  @inlineAlways
  pub fn current() -> Option<SpanContext> {
    static if Intrinsic.ambientCount<Tracer>() > 0 {
      let context = TraceContext.read()
      if context.span == 0 { return Option<SpanContext>.none() }
      return Option<SpanContext>.some(SpanContext {traceHigh: context.traceHigh, traceLow: context.traceLow,
        span: context.span, flags: u64.toU8(u64.bitAnd(context.flags, 255))})
    } else { return Option<SpanContext>.none() }
  }

  /// Records an attribute on the current sampled span.
  @inlineAlways
  pub fn set<V>(static key: string<'static>, value: &V) -> () { run Tracer.attribute(key, value) }

  /// Adds a timed event to the current span.
  @inlineAlways
  pub fn event(static name: string<'static>) -> () { run Tracer.event(name, &()) }

  /// Adds a timed event with named fields to the current span.
  @inlineAlways
  pub fn eventWith<Args>(static name: string<'static>, args: &Args) -> () { run Tracer.event(name, args) }

  /// Sets the active span's status to error.
  @inlineAlways
  pub fn setError<V>(value: &V) -> () { run Tracer.recordError(value) }

  /// Links the active span to another span.
  @inlineAlways
  pub fn link(context: &SpanContext) -> () { run Tracer.link(context) }

  /// Encodes a context for a W3C traceparent header.
  pub fn traceparent(context: &SpanContext) -> Traceparent { return Context.traceparent(context) }

  /// Reads a remote context from a W3C traceparent header.
  pub fn parseTraceparent(text: string) -> Option<SpanContext> { return Context.parseTraceparent(text) }
}

/// Records cumulative instrument measurements through the active Meter.
pub struct Metric {}
impl Metric {
  /// Adds a nonnegative count.
  @inlineAlways
  pub fn count(static name: string<'static>, amount: u64) -> () {
    run Meter.add(name, amount, &())
  }
  /// Adds a nonnegative count for the supplied attribute set.
  @inlineAlways
  pub fn countWith<Args>(static name: string<'static>, amount: u64, args: &Args) -> () {
    run Meter.add(name, amount, args)
  }
  /// Adjusts a signed counter.
  @inlineAlways
  pub fn adjust(static name: string<'static>, amount: i64) -> () {
    run Meter.adjust(name, amount, &())
  }
  /// Adjusts a signed counter for the supplied attribute set.
  @inlineAlways
  pub fn adjustWith<Args>(static name: string<'static>, amount: i64, args: &Args) -> () {
    run Meter.adjust(name, amount, args)
  }
  /// Sets the latest gauge measurement.
  @inlineAlways
  pub fn gauge(static name: string<'static>, value: f64) -> () {
    run Meter.gauge(name, value, &())
  }
  /// Sets the latest gauge measurement for the supplied attribute set.
  @inlineAlways
  pub fn gaugeWith<Args>(static name: string<'static>, value: f64, args: &Args) -> () {
    run Meter.gauge(name, value, args)
  }
  /// Adds a histogram observation.
  @inlineAlways
  pub fn record(static name: string<'static>, value: f64) -> () {
    run Meter.record(name, value, &())
  }
  /// Adds a histogram observation for the supplied attribute set.
  @inlineAlways
  pub fn recordWith<Args>(static name: string<'static>, value: f64, args: &Args) -> () {
    run Meter.record(name, value, args)
  }
}
