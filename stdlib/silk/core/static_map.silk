//! Maps from text keys to values that exist only during static evaluation.
//!
//! # When to use
//! Use [`StaticMap`] to look values up by name while a `static fn` runs, such as the options a
//! command line parser derives from its declared fields. Use `silk.collections.hash_map.HashMap`
//! for a map at runtime.
//!
//! # Details
//! A static map has no runtime value. It keeps its keys in insertion order, and each operation
//! returns a new map without changing its input. A lookup compares keys one by one, which suits the
//! few dozen entries a static description holds.
//!
//! # Examples
//! ## Count the options of each kind
//! ```silk
//! import silk.core.option { Option }
//! import silk.core.static_map { StaticMap }
//!
//! static fn shorts() -> StaticMap<u8> {
//!   let mut result = StaticMap<u8>.empty()
//!   result = StaticMap<u8>.insert(move result, "verbose", 118)
//!   result = StaticMap<u8>.insert(move result, "quiet", 113)
//!   return move result
//! }
//!
//! static fn shortOf(name: string<'static>) -> u8 {
//!   let map = shorts()
//!   return match StaticMap<u8>.get(&map, name) {
//!     Option<u8>.Some {value} => value
//!     Option<u8>.None => 0
//!   }
//! }
//!
//! pub fn main() -> i32 {
//!   static if shortOf("quiet") != 113 { compileError("quiet has no short form") }
//!   return 0
//! }
//! ```
//!
//! @category Core
import silk.core.option {Option}
import silk.core.static_sequence {StaticSequence}

/// An immutable map from `string<'static>` keys to `Value` values, built during static evaluation.
///
/// # Details
///
/// Every operation is `static`. Inserting a key that is already present replaces its value and
/// keeps its position.
pub struct StaticMap<Value> {
  names: Intrinsic.StaticSequence<string<'static>>,
  entries: Intrinsic.StaticSequence<Value>,
}

impl<Value> StaticMap<Value> {
  /// Returns a map with no entries.
  pub static fn empty() -> Self {
    return StaticMap<Value> {
      names: StaticSequence.empty<string<'static>>(),
      entries: StaticSequence.empty<Value>(),
    }
  }
  /// Returns the number of entries in `self`.
  pub static fn length(self: &Self) -> usize {
    return StaticSequence.length<string<'static>>(self.names)
  }
  /// Returns the position of `key` in insertion order, if `self` has it.
  pub static fn position(self: &Self, key: string<'static>) -> Option<usize> {
    let count = StaticSequence.length<string<'static>>(self.names)
    let mut at: usize = 0
    while at < count {
      if StaticSequence.at<string<'static>>(self.names, at) == key { return Option<usize>.some(at) }
      at = at + 1
    }
    return Option<usize>.none()
  }
  /// Whether `self` has an entry for `key`.
  pub static fn contains(self: &Self, key: string<'static>) -> bool {
    return match StaticMap<Value>.position(self, key) {
      Option<usize>.Some {..} => true
      Option<usize>.None => false
    }
  }
  /// Returns the value for `key`, if `self` has it.
  pub static fn get(self: &Self, key: string<'static>) -> Option<Value> {
    return match StaticMap<Value>.position(self, key) {
      Option<usize>.Some {value: at} => Option<Value>.some(StaticSequence.at<Value>(self.entries, at))
      Option<usize>.None => Option<Value>.none()
    }
  }
  /// Returns a map with the entries of `self` and `key` mapped to `value`.
  ///
  /// # Details
  ///
  /// A key already present keeps its position and takes the new value. To build a map in a loop,
  /// assign the result back to the same binding, as in `map = StaticMap<u8>.insert(move map, "a", 1)`.
  pub static fn insert(self: Self, key: string<'static>, value: Value) -> Self {
    let found = StaticMap<Value>.position(&self, key)
    if let Option<usize>.Some {value: replaced} = found {
      let count = StaticSequence.length<Value>(self.entries)
      let mut values = StaticSequence.empty<Value>()
      let mut at: usize = 0
      while at < count {
        if at == replaced {
          values = StaticSequence.append<Value>(move values, value)
        } else {
          values = StaticSequence.append<Value>(move values, StaticSequence.at<Value>(self.entries, at))
        }
        at = at + 1
      }
      return StaticMap<Value> {names: self.names, entries: move values}
    }
    return StaticMap<Value> {
      names: StaticSequence.append<string<'static>>(self.names, key),
      entries: StaticSequence.append<Value>(self.entries, move value),
    }
  }
  /// Returns the keys of `self` in insertion order.
  pub static fn keys(self: &Self) -> Intrinsic.StaticSequence<string<'static>> {
    return self.names
  }
  /// Returns the values of `self` in the order of their keys.
  pub static fn values(self: &Self) -> Intrinsic.StaticSequence<Value> {
    return self.entries
  }
}
