//! Facts about the target machine of the current compilation: architecture, operating system, ABI,
//! and pointer width.
//!
//! # When to use
//! Use [`Target`] with `static if` to select code for a machine, such as a system call for Linux or
//! Darwin. Use [`pointerBits`], [`usizeMax`], and the other constants for pointer-sized arithmetic.
//! Use `silk.core.compilation` for build choices, such as the artifact kind or the safety policy.
//!
//! # Details
//! The compiler fixes these facts before static evaluation, from the selected target. They do not
//! depend on the host machine. They have no runtime storage, so a selection adds no runtime cost.
//!
//! # Examples
//! ## Select a value for the pointer width
//! ```silk
//! import silk.core.target { Target, Arch }
//!
//! fn wordBytes() -> i32 {
//!   static if Target.arch() == Arch.Wasm32 {
//!     return 4
//!   }
//!   return 8
//! }
//!
//! pub fn main() -> i32 {
//!   let bytes = wordBytes()
//!   if bytes != 4 && bytes != 8 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Core

/// The instruction set architectures that the compiler supports.
///
/// # Details
///
/// Read the target value with [`Target.arch`].
pub enum Arch {
  /// 64-bit Arm (AArch64).
  Aarch64,
  /// 32-bit WebAssembly.
  Wasm32,
  /// 64-bit x86 (x86-64).
  X86_64,
}

/// The operating systems that the compiler supports.
///
/// # Details
///
/// Read the target value with [`Target.operatingSystem`].
pub enum OperatingSystem {
  /// Darwin (macOS).
  Darwin,
  /// Linux.
  Linux,
  /// No operating system, such as WebAssembly without a host interface.
  Freestanding,
  /// The WebAssembly System Interface (WASI).
  Wasi,
}

/// The platform calling conventions that the compiler supports.
///
/// # Details
///
/// Read the target value with [`Target.abi`].
pub enum Abi {
  /// The Apple calling convention.
  Apple,
  /// The GNU calling convention.
  Gnu,
  /// The WebAssembly calling convention.
  Wasm,
}

/// The object file formats that the compiler supports.
///
/// # Details
///
/// Read the target value with [`Target.objectFormat`].
pub enum ObjectFormat {
  /// Mach-O, the format of Darwin.
  MachO,
  /// ELF, the format of Linux.
  Elf,
  /// The WebAssembly binary format.
  Wasm,
}

/// The byte orders that the compiler supports.
///
/// # Details
///
/// Read the target value with [`Target.endianness`].
pub enum Endianness {
  /// Little-endian. The least significant byte is at the lowest address.
  Little,
}

static fn selectedUsizeMax() -> usize {
  static if Intrinsic.targetPointerBits() == 32 {
    return 4294967295
  } else {
    return 18446744073709551615
  }
}

static fn selectedIsizeMax() -> isize {
  static if Intrinsic.targetPointerBits() == 32 {
    return 2147483647
  } else {
    return 9223372036854775807
  }
}

static fn selectedIsizeMin() -> isize {
  static if Intrinsic.targetPointerBits() == 32 {
    return -2147483648
  } else {
    return -9223372036854775808
  }
}

/// The width of a pointer on the target, in bits: 32 or 64.
pub const pointerBits: u32 = Intrinsic.targetPointerBits()

/// The maximum `usize` value on the target: `2^32 - 1` or `2^64 - 1`.
pub const usizeMax: usize = selectedUsizeMax()

/// The maximum `isize` value on the target: `2^31 - 1` or `2^63 - 1`.
pub const isizeMax: isize = selectedIsizeMax()

/// The minimum `isize` value on the target: `-2^31` or `-2^63`.
pub const isizeMin: isize = selectedIsizeMin()

/// The alignment of a data pointer on the target, in bytes.
pub const pointerAlignment: u32 = Intrinsic.targetPointerAlignment()

/// The owner type of the target queries. It has no fields and is never constructed.
///
/// # Details
///
/// Each operation is `static`. Use it in a `static if`, a `static fn`, or a `const` initializer.
pub struct Target {}

impl Target {
  /// Returns the instruction set architecture of the target.
  pub static fn arch() -> Arch {
    let selected = Intrinsic.targetArchitecture()
    if selected == "aarch64" {
      return Arch.Aarch64
    }
    if selected == "wasm32" {
      return Arch.Wasm32
    }
    if selected == "x86_64" {
      return Arch.X86_64
    }
    compileError("Unknown Arch fact")
  }
  /// Returns the operating system of the target.
  pub static fn operatingSystem() -> OperatingSystem {
    let selected = Intrinsic.targetOperatingSystem()
    if selected == "darwin" {
      return OperatingSystem.Darwin
    }
    if selected == "linux" {
      return OperatingSystem.Linux
    }
    if selected == "wasi" { return OperatingSystem.Wasi }
    if selected == "freestanding" {
      return OperatingSystem.Freestanding
    }
    compileError("Unknown OperatingSystem fact")
  }
  /// Returns the calling convention of the target.
  pub static fn abi() -> Abi {
    let selected = Intrinsic.targetAbi()
    if selected == "apple" {
      return Abi.Apple
    }
    if selected == "gnu" {
      return Abi.Gnu
    }
    if selected == "wasm" {
      return Abi.Wasm
    }
    compileError("Unknown Abi fact")
  }
  /// Returns the object file format of the target.
  pub static fn objectFormat() -> ObjectFormat {
    let selected = Intrinsic.targetObjectFormat()
    if selected == "macho" {
      return ObjectFormat.MachO
    }
    if selected == "elf" {
      return ObjectFormat.Elf
    }
    if selected == "wasm" {
      return ObjectFormat.Wasm
    }
    compileError("Unknown ObjectFormat fact")
  }
  /// Returns the byte order of the target.
  pub static fn endianness() -> Endianness {
    let selected = Intrinsic.targetEndianness()
    if selected == "little" {
      return Endianness.Little
    }
    compileError("Unknown Endianness fact")
  }
  /// Returns the name of the CPU model that the build selects, as written in the compilation
  /// profile.
  pub static fn cpu() -> string<'static> {
    return Intrinsic.profileText("cpu")
  }
  /// Returns the minimum platform version that the build selects, as written in the compilation
  /// profile.
  pub static fn deployment() -> string<'static> {
    return Intrinsic.profileText("deployment")
  }
  /// Returns `true` if the build enables the CPU feature `value`.
  ///
  /// # Details
  ///
  /// `value` is a canonical feature name of the target, as written in the compilation profile.
  pub static fn hasCpuFeature(value: string<'static>) -> bool {
    return Intrinsic.profileContains("cpu-features", value)
  }
}
