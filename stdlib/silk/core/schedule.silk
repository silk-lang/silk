//! Schedules: policies that say when to run an effect again, and when to stop.
//!
//! # When to use
//! Use a [`Schedule`] to retry a failed effect with a delay, or to repeat an effect on a timer.
//! The drivers are `Effect.retry`, `Effect.retryWhile` and `Effect.repeat` in `silk.core.effect`.
//!
//! | Constructor | Delay before recurrence `n` (from 0) |
//! |---|---|
//! | [`Schedule.spaced`] | the same delay each time, counted from the end of the last run |
//! | [`Schedule.fixed`] | the time to the next multiple of the interval since the start |
//! | [`Schedule.exponential`] | `base * 2^n` |
//! | [`Schedule.exponentialBy`] | `base * factor^n` |
//! | [`Schedule.fibonacci`] | `base`, `base`, `2 * base`, `3 * base`, `5 * base`, ... |
//! | [`Schedule.linear`] | `base * (n + 1)` |
//! | [`Schedule.forever`] | no delay, with no limit |
//! | [`Schedule.recurs`] | no delay, at most `times` recurrences |
//!
//! [`Schedule.limit`], [`Schedule.capDelay`], [`Schedule.upTo`], [`Schedule.jittered`] and
//! [`Schedule.jitteredBetween`] change a schedule.
//!
//! # Details
//! A Schedule is a plain value. It holds no clock and no progress, so one value can drive any
//! number of runs. A driver keeps the progress of one run in a [`ScheduleState`] that
//! [`Schedule.start`] makes, and asks [`Schedule.next`] for each delay. A custom driver, such as
//! one that honours a server's `Retry-After`, uses the same two operations.
//!
//! Durations are `u64` nanoseconds, so a duration literal such as `250ms` works.
//!
//! # Gotchas
//! - A recurrence is a run after the first one. `Schedule.recurs(3)` with `Effect.repeat` runs the
//!   effect four times, and with `Effect.retry` makes at most four attempts.
//! - Jitter draws from the `InsecureRandom` effect, so the same seed gives the same delays. The
//!   drivers require `&mut InsecureRandom` even when the schedule has no jitter.
//!
//! # Examples
//! ## Repeat on a fixed beat
//! ```silk
//! import silk.core.effect { Effect }
//! import silk.core.schedule { Schedule }
//! import silk.system.insecure_random { InsecureRandom }
//! import silk.system.monotonic_clock { MonotonicClock }
//! import silk.system.system_clock { Instant, SystemClock }
//!
//! struct TestClock {
//!   mark: Instant,
//! }
//!
//! impl MonotonicClock for TestClock {
//!   effect fn now(self: &mut Self) -> Instant {
//!     return SystemClock.make(SystemClock.seconds(&self.mark), SystemClock.nanoseconds(&self.mark))
//!   }
//!
//!   effect fn getResolution(self: &mut Self) -> u64 {
//!     return 1
//!   }
//!
//!   effect fn waitUntil(self: &mut Self, when: Instant) -> () {
//!     self.mark = move when
//!     return ()
//!   }
//!
//!   effect fn waitFor(self: &mut Self, howLong: u64) -> () {
//!     self.mark = MonotonicClock.deadlineAfter(&self.mark, howLong)
//!     return ()
//!   }
//! }
//!
//! struct Beats {
//!   count: i32,
//! }
//!
//! effect fn beat(beats: &mut Beats) -> () {
//!   beats.count = beats.count + 1
//!   return ()
//! }
//!
//! pub fn main() -> i32 {
//!   let mut clock = TestClock { mark: SystemClock.make(0, 0) }
//!   let mut random = InsecureRandom.seeded(1)
//!   let mut beats = Beats { count: 0 }
//!   // One run, then three more, each on the next 500ms beat.
//!   let steady = Schedule.fixed(500ms) |> Schedule.limit(3)
//!   run Effect.repeat(beat(&mut beats), &steady)
//!     |> Effect.provideMut<InsecureRandom>(&mut random)
//!     |> Effect.provideMut<MonotonicClock>(&mut clock)
//!   if beats.count != 4 || SystemClock.seconds(&clock.mark) != 1 || SystemClock.nanoseconds(&clock.mark) != 500000000 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Core

import silk.core.option { Option }
import silk.num.f64
import silk.num.u64
import silk.system.insecure_random { InsecureRandom }
import silk.system.system_clock { Instant, SystemClock }

/// A policy that says how long to wait before each recurrence, and when to stop.
///
/// # When to use
///
/// Pass a Schedule to `Effect.retry`, `Effect.retryWhile` or `Effect.repeat`. Make one with a
/// constructor such as [`Schedule.spaced`] or [`Schedule.exponential`], and change it with
/// [`Schedule.limit`], [`Schedule.capDelay`], [`Schedule.upTo`] or [`Schedule.jittered`].
///
/// # Details
///
/// A Schedule holds no progress, so one value can drive any number of runs. Durations are `u64`
/// nanoseconds.
///
/// # Examples
///
/// ## Back off exponentially, at most five times
/// ```silk
/// import silk.core.schedule { Schedule }
///
/// pub fn main() -> i32 {
///   let policy = Schedule.exponential(100ms) |> Schedule.capDelay(2s) |> Schedule.limit(5)
///   drop policy
///   return 0
/// }
/// ```
pub struct Schedule {
  base: u64,
  growth: Growth,
  maxRecurrences: Option<u64>,
  maxDelay: Option<u64>,
  maxElapsed: Option<u64>,
  jitter: Option<Jitter>,
}

/// The progress of one run of a [`Schedule`]: how many recurrences it has made, and when it began.
///
/// # When to use
///
/// Only a driver needs it. Make one with [`Schedule.start`] when the run begins, and pass it to
/// each [`Schedule.next`] of the same run.
pub struct ScheduleState {
  recurrences: u64,
  previous: u64,
  current: u64,
  start: Instant,
}

union Growth {
  Spaced,
  Fixed,
  Exponential { factor: f64 },
  Fibonacci,
  Linear,
}

struct Jitter {
  min: f64,
  max: f64,
}

impl Schedule {
  /// Recurs with no delay and no limit.
  ///
  /// # Gotchas
  ///
  /// `Effect.repeat` with this schedule never stops unless the effect fails, and `Effect.retry`
  /// never stops unless the effect succeeds. Add [`Schedule.limit`] or [`Schedule.upTo`] to stop.
  pub fn forever() -> Schedule {
    return make(0, Growth.Spaced)
  }

  /// Recurs with no delay, at most `times` times.
  ///
  /// # Details
  ///
  /// With `Effect.repeat`, the effect runs `times + 1` times. With `Effect.retry`, it makes at most
  /// `times + 1` attempts.
  pub fn recurs(times: u64) -> Schedule {
    return make(0, Growth.Spaced) |> Schedule.limit(times)
  }

  /// Waits the same `delay` before each recurrence.
  ///
  /// # Details
  ///
  /// The delay counts from the end of the run before, so the time the effect takes adds to the
  /// period. Use [`Schedule.fixed`] to keep a steady beat.
  pub fn spaced(delay: u64) -> Schedule {
    return make(delay, Growth.Spaced)
  }

  /// Recurs on each multiple of `interval` after the start of the run.
  ///
  /// # When to use
  ///
  /// Use it for a steady beat, such as a poll every second or a note every eighth of a bar. The
  /// time each run takes does not move later recurrences.
  ///
  /// # Details
  ///
  /// Before each recurrence, the delay is the time from now to the next multiple of `interval`
  /// since [`Schedule.start`]. If a run takes longer than `interval`, the next recurrence waits
  /// for the next multiple, so missed beats do not pile up. An `interval` of 0 recurs at once.
  pub fn fixed(interval: u64) -> Schedule {
    return make(interval, Growth.Fixed)
  }

  /// Waits `base * 2^n` before recurrence `n`, counted from 0.
  pub fn exponential(base: u64) -> Schedule {
    return make(base, Growth.Exponential { factor: 2.0 })
  }

  /// Waits `base * factor^n` before recurrence `n`, counted from 0.
  ///
  /// # Details
  ///
  /// A `factor` between 0 and 1 makes the delays shorter each time. A delay that is more than a
  /// `u64` can hold becomes `u64.MAX`.
  pub fn exponentialBy(base: u64, factor: f64) -> Schedule {
    return make(base, Growth.Exponential { factor: factor })
  }

  /// Waits `base` times the next Fibonacci number: `base`, `base`, `2 * base`, `3 * base`, ...
  pub fn fibonacci(base: u64) -> Schedule {
    return make(base, Growth.Fibonacci)
  }

  /// Waits `base * (n + 1)` before recurrence `n`, counted from 0.
  pub fn linear(base: u64) -> Schedule {
    return make(base, Growth.Linear)
  }

  /// Stops `self` after at most `times` recurrences.
  ///
  /// # Details
  ///
  /// When `self` already has a smaller limit, that limit stays.
  pub fn limit(self: Schedule, times: u64) -> Schedule {
    let mut next = move self
    next.maxRecurrences = smaller(next.maxRecurrences, times)
    return move next
  }

  /// Makes each delay of `self` at most `most`.
  ///
  /// # Details
  ///
  /// The cap applies after jitter. When `self` already has a smaller cap, that cap stays.
  pub fn capDelay(self: Schedule, most: u64) -> Schedule {
    let mut next = move self
    next.maxDelay = smaller(next.maxDelay, most)
    return move next
  }

  /// Stops `self` when `howLong` has passed since the start of the run.
  ///
  /// # Details
  ///
  /// The check happens before each recurrence. A run that is already in progress is not stopped.
  /// When `self` already has a shorter time, that time stays.
  pub fn upTo(self: Schedule, howLong: u64) -> Schedule {
    let mut next = move self
    next.maxElapsed = smaller(next.maxElapsed, howLong)
    return move next
  }

  /// Multiplies each delay of `self` by a random factor between 0.8 and 1.2.
  ///
  /// # When to use
  ///
  /// Use it so that many clients that retry at the same time spread out.
  pub fn jittered(self: Schedule) -> Schedule {
    return Schedule.jitteredBetween(move self, 0.8, 1.2)
  }

  /// Multiplies each delay of `self` by a random factor between `min` and `max`.
  ///
  /// # Details
  ///
  /// The factor is uniform in `[min, max)`, from one `InsecureRandom.nextU64` for each delay.
  pub fn jitteredBetween(self: Schedule, min: f64, max: f64) -> Schedule {
    let mut next = move self
    next.jitter = Option<Jitter>.some(Jitter { min: min, max: max })
    return move next
  }

  /// Begins one run of `self` at `now`.
  ///
  /// # When to use
  ///
  /// Only a driver needs it. Read the clock when the run begins, before the first run of the
  /// effect, and pass the state to each [`Schedule.next`] of the run.
  pub fn start(self: &Schedule, now: Instant) -> ScheduleState {
    return ScheduleState { recurrences: 0, previous: 0, current: self.base, start: move now }
  }

  /// Decides the next recurrence of a run: the delay to wait before it, or `None` to stop.
  ///
  /// # Details
  ///
  /// Pass the time of the decision as `now`. A `Some` counts one recurrence in `state`. The draw
  /// from `InsecureRandom` happens only when `self` has jitter.
  pub effect fn next(self: &Schedule, state: &mut ScheduleState, now: &Instant) -> Option<u64>
    ? &mut InsecureRandom {
    let passed = elapsed(&state.start, now)
    if let Option<u64>.Some { value: most } = self.maxRecurrences {
      if state.recurrences >= most {
        return Option<u64>.none()
      }
    }
    if let Option<u64>.Some { value: most } = self.maxElapsed {
      if passed >= most {
        return Option<u64>.none()
      }
    }
    let n = state.recurrences
    let mut delay = match &self.growth {
      Growth.Spaced => self.base
      Growth.Fixed => untilNextMultiple(self.base, passed)
      Growth.Exponential { factor } => saturate(
        u64.toF64(self.base) * f64.pow(factor, u64.toF64(n)),
      )
      Growth.Fibonacci => advanceFibonacci(&mut state.*)
      Growth.Linear => u64.saturatingMultiply(self.base, n + 1)
    }
    if let Option<Jitter>.Some { value: jitter } = &self.jitter {
      let sample = run InsecureRandom.nextU64()
      let unit = u64.toF64(u64.shiftRight(sample, 11)) / 9007199254740992.0
      delay = saturate(u64.toF64(delay) * (jitter.min + unit * (jitter.max - jitter.min)))
    }
    if let Option<u64>.Some { value: most } = self.maxDelay {
      if delay > most {
        delay = most
      }
    }
    state.recurrences = state.recurrences + 1
    return Option<u64>.some(delay)
  }
}

fn make(base: u64, growth: Growth) -> Schedule {
  return Schedule {
    base: base,
    growth: move growth,
    maxRecurrences: Option<u64>.none(),
    maxDelay: Option<u64>.none(),
    maxElapsed: Option<u64>.none(),
    jitter: Option<Jitter>.none(),
  }
}

fn untilNextMultiple(interval: u64, passed: u64) -> u64 {
  if interval == 0 {
    return 0
  }
  return interval - passed % interval
}

fn advanceFibonacci(state: &mut ScheduleState) -> u64 {
  let value = state.current
  let following = u64.saturatingAdd(state.previous, state.current)
  state.previous = state.current
  state.current = following
  return value
}

fn smaller(current: Option<u64>, candidate: u64) -> Option<u64> {
  return match current {
    Option<u64>.Some { value } => Option<u64>.some(
      if value < candidate {
        value
      } else {
        candidate
      },
    )
    Option<u64>.None => Option<u64>.some(candidate)
  }
}

fn saturate(value: f64) -> u64 {
  return match f64.checkedToU64(value) {
    Option<u64>.Some { value: converted } => converted
    Option<u64>.None => if value > 0.0 {
      u64.MAX
    } else {
      0
    }
  }
}

fn elapsed(start: &Instant, now: &Instant) -> u64 {
  let seconds = SystemClock.seconds(now) - SystemClock.seconds(start)
  let nanoseconds = SystemClock.nanoseconds(now) - SystemClock.nanoseconds(start)
  let total = seconds * 1000000000 + nanoseconds
  if total < 0 {
    return 0
  }
  return Intrinsic.i64ToU64(total)
}
