//! Read npm's configuration the way npm does: the built-in, global, user, and project `.npmrc`
//! files, `npm_config_*` environment variables, and command-line values, with `${VAR}` expansion,
//! scoped registries, and registry credentials.
//!
//! # When to use
//! Use [`NpmConfig.load`] in a tool that talks to an npm registry and must honor the user's
//! `.npmrc` files, such as a package manager or a publish script. Read a key with
//! [`NpmConfig.text`], choose a registry for a package with [`NpmConfig.registryFor`], and get the
//! credentials for a request URL with [`NpmConfig.credentialsFor`]. To parse one ini text without
//! layers, use `silk.npm.ini`.
//!
//! # Details
//! A configuration is a list of layers. When two layers set a key, the one with the higher priority
//! wins. From highest to lowest, the layers are:
//!
//! 1. [`NpmConfigSource.CommandLine`]: values the caller passes, such as parsed `--key=value`
//!    options.
//! 2. [`NpmConfigSource.Environment`]: each variable `npm_config_<name>` (any case) with a
//!    non-empty value. In `<name>`, each `_` after the first character becomes `-` and letters
//!    become lowercase, unless the name starts with `//`.
//! 3. [`NpmConfigSource.Project`]: `.npmrc` in the project directory. That is the `prefix` from the
//!    command line, or else the nearest directory, from the working directory up, that has a
//!    `package.json` file or a `node_modules` directory. If a directory above it has a
//!    `package.json` whose `workspaces` patterns include it, that workspace root is used instead.
//!    The project file is skipped in global mode (`global` is `true` or `location` is `global`) and
//!    when it is the same file as the user file.
//! 4. [`NpmConfigSource.User`]: the `userconfig` file, by default `~/.npmrc`.
//! 5. [`NpmConfigSource.Global`]: the `globalconfig` file, by default `<prefix>/etc/npmrc`.
//! 6. [`NpmConfigSource.Builtin`]: the `npmrc` file in npm's own install directory, if the caller
//!    names it.
//!
//! In every layer, `${NAME}` in a key or a text value is replaced by the environment variable
//! `NAME`. An unset variable leaves `${NAME}` as it is. A `\` before `$` stops the expansion, and
//! each pair of `\` before it becomes one `\`. As in npm, the items of a `key[]` list are expanded
//! only for npm's own list options: `ca`, `cidr`, `diff`, `include`, `noproxy`, `omit`, `package`,
//! and `workspace`. A file that cannot be read is an empty layer, as in npm. Keys inside an ini
//! `[section]` are ignored, as npm does not read them.
//!
//! # Errors
//! - `HostInputError` if the environment or the working directory cannot be read.
//! - `FileError` if the working directory is not a valid absolute path.
//! - `OutOfMemoryError` if the `Allocator` cannot supply the configuration.
//!
//! # Gotchas
//! Values are not checked or converted with npm's table of option types: a value is text, a
//! boolean, a null, or a list, as the ini text gives it. npm's default values are not included,
//! except the default registry `https://registry.npmjs.org/`. npm finds its global prefix from the
//! path of the `node` program; here it comes from [`NpmConfigOptions`], the `PREFIX` environment
//! variable, or a `prefix` key. Paths use the `/` form of `silk.system.filesystem`; on Windows pass
//! the paths in [`NpmConfigOptions`].
//!
//! # Examples
//! ## Find the registry and the token for a scoped package
//! ```silk
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.core.effect { Effect }
//! import silk.core.option { Option }
//! import silk.collections.bytes { Bytes }
//! import silk.collections.list { List }
//! import silk.system.host_input { HostInput, HostInputError }
//! import silk.npm.config { NpmConfig, NpmConfigSource, NpmCredentials }
//! import silk.system.filesystem { Path }
//!
//! struct NoEnvironment {}
//!
//! effect fn argumentCount(self: &mut NoEnvironment) -> usize ! HostInputError { return 0 }
//!
//! effect fn argument(self: &mut NoEnvironment, index: usize) -> Option<Bytes>
//!   ! HostInputError | OutOfMemoryError ? &mut Allocator {
//!   return Option<Bytes>.none()
//! }
//!
//! effect fn variable(self: &mut NoEnvironment, name: &[u8]) -> Option<Bytes>
//!   ! HostInputError | OutOfMemoryError ? &mut Allocator {
//!   return Option<Bytes>.none()
//! }
//!
//! effect fn variableNames(self: &mut NoEnvironment) -> List<Bytes>
//!   ! HostInputError | OutOfMemoryError ? &mut Allocator {
//!   return List<Bytes>.make()
//! }
//!
//! effect fn workingDirectory(self: &mut NoEnvironment) -> Bytes
//!   ! HostInputError | OutOfMemoryError ? &mut Allocator {
//!   return run Bytes.copy(b"/")
//! }
//!
//! impl HostInput for NoEnvironment {
//!   argumentCount: NoEnvironment.argumentCount
//!   argument: NoEnvironment.argument
//!   variable: NoEnvironment.variable
//!   variableNames: NoEnvironment.variableNames
//!   workingDirectory: NoEnvironment.workingDirectory
//! }
//!
//! effect fn check() -> bool ! HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator {
//!   let mut config = NpmConfig.make()
//!   let text = b"@acme:registry=https://npm.acme.test/\n//npm.acme.test/:_authToken=secret\n"
//!   let layer = run NpmConfig.parseLayer(NpmConfigSource.User, Option<Path>.none(), text)
//!   run NpmConfig.addLayer(&mut config, move layer)
//!   let registry = NpmConfig.registryFor(&config, "@acme/widgets")
//!   let credentials = run NpmConfig.credentialsFor(&config, "https://npm.acme.test/@acme%2fwidgets", registry)
//!   return match move credentials {
//!     Option<NpmCredentials>.Some { value } => registry == "https://npm.acme.test/"
//!       && &NpmCredentials.token(&value) == &Option<string>.some("secret")
//!     Option<NpmCredentials>.None => false
//!   }
//! }
//!
//! pub effect fn main() -> i32 ! HostInputError | OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let mut environment = NoEnvironment {}
//!   let found = run check() |> Effect.provideMut<HostInput>(&mut environment)
//!     |> Effect.provideMut<Allocator>(&mut allocator)
//!   if !found {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Data formats

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.encoding.base64 { Base64, Base64Error }
import silk.json.scanner { JsonError }
import silk.json.value { Json, Value }
import silk.npm.ini { NpmEntry, NpmIni, NpmScalar }
import silk.system.filesystem { DirectoryInfo, FileError, FileInfo, FileSystem, Path }
import silk.system.host_input { HostInput, HostInputError }
import silk.text.glob { Dots, Pattern }
import silk.text.string { String }
import silk.url.percent { UrlPercent }
import silk.url.url { Url }
import silk.num.u32
import silk.num.u8
import silk.num.usize

/// The registry npm uses when no `registry` key is set.
pub const DEFAULT_REGISTRY: string<'static> = "https://registry.npmjs.org/"

/// Where a layer of the configuration comes from. A later variant has a higher priority.
pub enum NpmConfigSource {
  /// The `npmrc` file in npm's own install directory.
  Builtin,
  /// The global file, `globalconfig`, by default `<prefix>/etc/npmrc`.
  Global,
  /// The user file, `userconfig`, by default `~/.npmrc`.
  User,
  /// The `.npmrc` file in the project directory.
  Project,
  /// The `npm_config_*` environment variables.
  Environment,
  /// Values the caller passes, such as options from the command line.
  CommandLine,
}

/// One layer of the configuration: the entries from one file, the environment, or the caller.
pub struct NpmConfigLayer {
  /// Where the layer comes from.
  pub source: NpmConfigSource,
  /// The file of the layer, or `None` for the environment and command-line layers.
  pub file: Option<Path>,
  /// The error that stopped the file from being read, such as `NotFound`. The layer then has no
  /// entries.
  pub error: Option<FileError>,
  /// The entries, with `${NAME}` expanded in keys and text values (for a list, only for npm's own
  /// list options). Keys inside an ini `[section]` are left out. A key appears once.
  pub entries: List<NpmEntry>,
}

/// Paths and values for [`NpmConfig.load`]. Each field can be left out.
pub struct NpmConfigOptions {
  /// The directory to start the project search from. By default, the working directory of
  /// `HostInput`.
  pub workingDirectory: Option<Path>,
  /// The home directory, for `~/` in paths and the default user file `~/.npmrc`. By default, the
  /// `HOME` environment variable, or `USERPROFILE` if `HOME` is not set.
  pub home: Option<Path>,
  /// The global prefix, for the default global file `<prefix>/etc/npmrc`. By default, the `PREFIX`
  /// environment variable. A `prefix` key in a layer wins over both.
  pub globalPrefix: Option<Path>,
  /// npm's built-in `npmrc` file, in npm's install directory. It is not read if left out.
  pub builtinFile: Option<Path>,
  /// The command-line layer, such as `NpmIni.parse(b"registry=https://example.test/\n")`.
  pub commandLine: Option<List<NpmEntry>>,
}

/// The credentials that npm sends to a registry.
///
/// # Details
///
/// npm sends `Authorization: Bearer <token>` if there is a token, or else `Authorization: Basic
/// <basic>` if there is a basic value. [`NpmCredentials.authorization`] gives that header value.
/// A client certificate can come with either one, or alone.
pub struct NpmCredentials {
  /// The key prefix that had the credentials, such as `//registry.npmjs.org/`.
  pub registryKey: String,
  /// The value of `<registryKey>:_authToken`.
  pub bearer: Option<String>,
  /// The Base64 text for basic authentication: `<registryKey>:_auth` as written, or else
  /// `<registryKey>:username` and the Base64-decoded `<registryKey>:_password` joined by `:` and
  /// encoded.
  pub basic: Option<String>,
  /// The value of `<registryKey>:certfile`, a path to a PEM client certificate. It is set only
  /// together with [`NpmCredentials.keyFile`].
  pub certificateFile: Option<String>,
  /// The value of `<registryKey>:keyfile`, a path to the PEM key of the client certificate.
  pub keyFile: Option<String>,
}

impl NpmCredentials {
  /// Returns the bearer token, or `None` if the credentials have no token. The text borrows from
  /// `self`.
  pub fn token<'a>(self: &'a NpmCredentials) -> Option<string<'a>> {
    return match &self.bearer {
      Option<String>.Some { value } => Option<string<'a>>.some(String.view(&value))
      Option<String>.None => Option<string<'a>>.none()
    }
  }

  /// Returns the value of the `Authorization` header npm sends: `Bearer <token>`, or else `Basic
  /// <basic>`, or `None` if the credentials are only a client certificate.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the text.
  pub effect fn authorization(self: &NpmCredentials) -> Option<String>
    ! OutOfMemoryError
    ? &mut Allocator {
    let mut header = String.make()
    match &self.bearer {
      Option<String>.Some { value } => {
        run String.append(&mut header, "Bearer ")
        run String.append(&mut header, String.view(&value))
        return Option<String>.some(move header)
      }
      Option<String>.None => {}
    }
    match &self.basic {
      Option<String>.Some { value } => {
        run String.append(&mut header, "Basic ")
        run String.append(&mut header, String.view(&value))
        return Option<String>.some(move header)
      }
      Option<String>.None => {}
    }
    return Option<String>.none()
  }
}

/// npm's configuration: layers of keys, from the command line down to npm's built-in file.
///
/// # When to use
///
/// Use [`NpmConfig.load`] to read the configuration that npm would use in a directory. Use
/// [`NpmConfig.make`], [`NpmConfig.parseLayer`], and [`NpmConfig.addLayer`] to build one from your
/// own text, for example in a test.
///
/// # Details
///
/// When two layers set a key, the higher one wins. From highest to lowest: command line,
/// environment, project, user, global, built-in.
pub struct NpmConfig {
  stack: List<NpmConfigLayer>,
  home: Option<Path>,
  workingDirectory: Option<Path>,
}

impl NpmConfig {
  /// Returns a configuration with no layers, no home directory, and no working directory.
  pub fn make() -> NpmConfig {
    return NpmConfig {
      stack: List<NpmConfigLayer>.make(),
      home: Option<Path>.none(),
      workingDirectory: Option<Path>.none(),
    }
  }

  /// Reads npm's configuration for the working directory, from all files, the environment, and
  /// the command-line values in `options`.
  ///
  /// # Details
  ///
  /// The layers are read in npm's order: built-in file, command line, environment, project file,
  /// user file, global file. A later file is found with the layers before it:
  ///
  /// - The project directory is `prefix` from the command line, or else the nearest directory, from
  ///   the working directory up, with a `package.json` file or a `node_modules` directory, or else
  ///   the working directory. If a directory above it has a `package.json` whose `workspaces`
  ///   patterns name it, that directory is used, unless `workspaces` is `false` on the command
  ///   line. The project file is skipped in global mode (`global` is `true` or `location` is
  ///   `global`), and when it is the user file.
  /// - The user file is `userconfig`, by default `~/.npmrc`.
  /// - The global file is `globalconfig`, by default `<prefix>/etc/npmrc`, where `prefix` is the key
  ///   or else the global prefix of `options` or the `PREFIX` environment variable.
  ///
  /// A file that cannot be read, for any reason, is a layer with no entries, and its error is
  /// kept in [`NpmConfigLayer.error`]. A user or global file that is the same path as a file read
  /// before it is skipped; npm stops with an error in that case. Keys and text values have
  /// `${NAME}` expanded.
  ///
  /// # Errors
  ///
  /// - `HostInputError` if the environment or the working directory cannot be read.
  /// - `FileError` with reason `InvalidPath` if the working directory of `HostInput` is not an
  ///   absolute `/` path. Pass `workingDirectory` in `options` to avoid it.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the configuration.
  pub effect fn load(options: NpmConfigOptions) -> NpmConfig
    ! HostInputError | FileError | OutOfMemoryError
    ? &mut FileSystem | &mut HostInput | &mut Allocator {
    let NpmConfigOptions {
      workingDirectory,
      home,
      globalPrefix,
      builtinFile,
      commandLine
    } = move options
    let working = match move workingDirectory {
      Option<Path>.Some { value } => move value
      Option<Path>.None => {
        let bytes = run HostInput.workingDirectory()
        run Path.fromBytes(Bytes.asSlice(&bytes))
      }
    }
    let homePath = match move home {
      Option<Path>.Some { value } => Option<Path>.some(move value)
      Option<Path>.None => run homeDirectory()
    }
    let mut config = NpmConfig {
      stack: List<NpmConfigLayer>.make(),
      home: move homePath,
      workingDirectory: Option<Path>.some(move working),
    }
    match move builtinFile {
      Option<Path>.Some { value } => {
        let layer = run NpmConfig.readLayer(NpmConfigSource.Builtin, move value)
        run NpmConfig.addLayer(&mut config, move layer)
      }
      Option<Path>.None => {}
    }
    match move commandLine {
      Option<List<NpmEntry>>.Some { value } => {
        let entries = run expandEntries(&value)
        run NpmConfig.addLayer(
          &mut config,
          NpmConfigLayer {
            source: NpmConfigSource.CommandLine,
            file: Option<Path>.none(),
            error: Option<FileError>.none(),
            entries: move entries,
          },
        )
      }
      Option<List<NpmEntry>>.None => {}
    }
    let environment = run NpmConfig.environmentLayer()
    run NpmConfig.addLayer(&mut config, move environment)

    let userFile = run NpmConfig.userFile(&config)
    if !globalMode(&config) {
      let projectDirectory = run projectDirectory(&config)
      let projectFile = run Path.join(&projectDirectory, ".npmrc")
      if !samePath(Option<&Path>.some(&projectFile), optionRef(&userFile)) {
        let layer = run NpmConfig.readLayer(NpmConfigSource.Project, move projectFile)
        run NpmConfig.addLayer(&mut config, move layer)
      }
    }
    let user = run NpmConfig.userFile(&config)
    match move user {
      Option<Path>.Some { value } => {
        if !alreadyRead(&config, &value) {
          let layer = run NpmConfig.readLayer(NpmConfigSource.User, move value)
          run NpmConfig.addLayer(&mut config, move layer)
        }
      }
      Option<Path>.None => {}
    }
    drop userFile
    let global = run NpmConfig.globalFile(&config, move globalPrefix)
    match move global {
      Option<Path>.Some { value } => {
        if !alreadyRead(&config, &value) {
          let layer = run NpmConfig.readLayer(NpmConfigSource.Global, move value)
          run NpmConfig.addLayer(&mut config, move layer)
        }
      }
      Option<Path>.None => {}
    }
    return move config
  }

  /// Returns the layer for the ini text `bytes`, with `${NAME}` expanded in keys and text values.
  ///
  /// # When to use
  ///
  /// Use it to add text that is not in a file, such as values from your own command line, or to
  /// build a configuration in a test. Add the result with [`NpmConfig.addLayer`].
  ///
  /// # Details
  ///
  /// The text is parsed with `NpmIni.parse`. Keys inside an ini `[section]` are left out. Keys
  /// and text values have `${NAME}` expanded with [`NpmConfig.expand`]; the items of a `key[]` list
  /// are expanded only for npm's list options `ca`, `cidr`, `diff`, `include`, `noproxy`, `omit`,
  /// `package`, and `workspace`, as in npm. If two keys are the same after expansion, the later one
  /// wins. `file` is recorded in the layer as it is.
  ///
  /// # Errors
  ///
  /// - `HostInputError` if an environment variable cannot be read.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the layer.
  pub effect fn parseLayer(
    source: NpmConfigSource,
    file: Option<Path>,
    bytes: &[u8],
  ) -> NpmConfigLayer
    ! HostInputError | OutOfMemoryError
    ? &mut HostInput | &mut Allocator {
    let parsed = run NpmIni.parse(bytes)
    let entries = run expandEntries(&parsed)
    return NpmConfigLayer {
      source: source,
      file: move file,
      error: Option<FileError>.none(),
      entries: move entries,
    }
  }

  /// Reads the file `path` as the layer `source`.
  ///
  /// # Details
  ///
  /// If the file cannot be read, for any reason, the layer has no entries and keeps the error in
  /// [`NpmConfigLayer.error`], as npm ignores such a file. Otherwise it is the same as
  /// [`NpmConfig.parseLayer`] for the contents.
  ///
  /// # Errors
  ///
  /// - `HostInputError` if an environment variable cannot be read.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the layer.
  pub effect fn readLayer(source: NpmConfigSource, path: Path) -> NpmConfigLayer
    ! HostInputError | OutOfMemoryError
    ? &mut FileSystem | &mut HostInput | &mut Allocator {
    let read = run Effect.result(FileSystem.readFile(&path))
    return match move read {
      Result<Bytes, FileError | OutOfMemoryError>.Success { value } => run NpmConfig.parseLayer(
        source,
        Option<Path>.some(move path),
        Bytes.asSlice(&value),
      )
      Result<Bytes, FileError | OutOfMemoryError>.Failure { error } => match move error {
        FileError failure => NpmConfigLayer {
          source: source,
          file: Option<Path>.some(move path),
          error: Option<FileError>.some(move failure),
          entries: List<NpmEntry>.make(),
        }
        OutOfMemoryError exhausted => {
          fail move exhausted
        }
      }
    }
  }

  /// Returns the environment layer: one entry for each variable `npm_config_<name>` with a
  /// non-empty value.
  ///
  /// # Details
  ///
  /// The prefix `npm_config_` matches in any case. Unless `<name>` starts with `//`, each `_` after
  /// its first character becomes `-` and ASCII letters become lowercase, so `NPM_CONFIG_SAVE_EXACT`
  /// sets `save-exact`. The text `true`, `false`, and `null` become a boolean or a null. Keys and
  /// text values have `${NAME}` expanded. If two variables give the same key, the later one in the
  /// order of the host wins.
  ///
  /// # Errors
  ///
  /// - `HostInputError` if the environment cannot be read.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the layer.
  pub effect fn environmentLayer() -> NpmConfigLayer
    ! HostInputError | OutOfMemoryError
    ? &mut HostInput | &mut Allocator {
    let names = run HostInput.variableNames()
    let all = List<Bytes>.asSlice(&names)
    let mut entries = List<NpmEntry>.make()
    let mut index = usize.ZERO
    while index < all.length {
      let name = Bytes.asSlice(&all[index])
      index = index + usize.ONE
      if name.length < 11 || !prefixIgnoringCase(name, b"npm_config_") {
        continue
      }
      let found = run HostInput.variable(name)
      let value = match move found {
        Option<Bytes>.Some { value } => move value
        Option<Bytes>.None => {
          continue
        }
      }
      if Bytes.length(&value) == usize.ZERO {
        continue
      }
      let rest = Slice.view<u8>(name, 11, name.length - 11)
      let mut key = Bytes.make()
      let nerfed = rest.length >= 2 && rest[0] == 47 && rest[1] == 47
      let mut at = usize.ZERO
      while at < rest.length {
        let mut byte = rest[at]
        if !nerfed {
          if byte == 95 && at > usize.ZERO {
            byte = 45
          }
          if byte >= 65 && byte <= 90 {
            byte = byte + 32
          }
        }
        let one = [byte]
        run Bytes.append(&mut key, &one)
        at = at + usize.ONE
      }
      let mut keyText = String.make()
      run UrlPercent.appendUtf8Lossy(&mut keyText, Bytes.asSlice(&key))
      let mut valueText = String.make()
      run UrlPercent.appendUtf8Lossy(&mut valueText, Bytes.asSlice(&value))
      let expandedKey = run NpmConfig.expand(String.view(&keyText))
      let expandedValue = run NpmConfig.expand(String.view(&valueText))
      run put(&mut entries, move expandedKey, scalarOf(move expandedValue), false)
    }
    return NpmConfigLayer {
      source: NpmConfigSource.Environment,
      file: Option<Path>.none(),
      error: Option<FileError>.none(),
      entries: move entries,
    }
  }

  /// Adds `layer` to the configuration. A layer with the same source is replaced.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply room for the layer.
  pub effect fn addLayer(self: &mut NpmConfig, layer: NpmConfigLayer) -> ()
    ! OutOfMemoryError
    ? &mut Allocator {
    let rank = sourceRank(layer.source)
    let layers = List<NpmConfigLayer>.asSlice(&self.stack)
    let mut index = usize.ZERO
    while index < layers.length && sourceRank(layers[index].source) < rank {
      index = index + usize.ONE
    }
    if index < layers.length && sourceRank(layers[index].source) == rank {
      let previous = List<NpmConfigLayer>.remove(&mut self.stack, index)
      drop previous
    }
    run List<NpmConfigLayer>.insert(&mut self.stack, index, move layer)
  }

  /// Returns the layers, from the lowest priority to the highest.
  pub fn layers<'a>(self: &'a NpmConfig) -> &'a [NpmConfigLayer] {
    return List<NpmConfigLayer>.asSlice(&self.stack)
  }

  /// Returns the entry for `key` from the layer with the highest priority that sets it, or `None`
  /// if no layer sets it.
  ///
  /// # Details
  ///
  /// `key` is compared byte for byte, after `${NAME}` expansion of the keys in the layers. For a
  /// list, leave out the `[]`.
  pub fn get<'a>(self: &'a NpmConfig, key: string) -> Option<&'a NpmEntry> {
    let layers = List<NpmConfigLayer>.asSlice(&self.stack)
    let mut index = layers.length
    while index > usize.ZERO {
      index = index - usize.ONE
      match NpmIni.find(&layers[index].entries, key) {
        Option<&'a NpmEntry>.Some { value } => {
          return Option<&'a NpmEntry>.some(value)
        }
        Option<&'a NpmEntry>.None => {}
      }
    }
    return Option<&'a NpmEntry>.none()
  }

  /// Returns the text of the first value of `key`, from the layer with the highest priority that
  /// sets it.
  ///
  /// # Details
  ///
  /// Returns `None` if no layer sets `key`, or if the winning value is a boolean or a null. The text
  /// borrows from `self`.
  pub fn text<'a>(self: &'a NpmConfig, key: string) -> Option<string<'a>> {
    return match NpmConfig.get(self, key) {
      Option<&'a NpmEntry>.Some { value } => NpmIni.firstText(value)
      Option<&'a NpmEntry>.None => Option<string<'a>>.none()
    }
  }

  /// Returns the boolean value of `key`, from the layer with the highest priority that sets it.
  ///
  /// Returns `None` if no layer sets `key`, or if the winning value is not `true` or `false`.
  pub fn flag(self: &NpmConfig, key: string) -> Option<bool> {
    return match NpmConfig.get(self, key) {
      Option<&NpmEntry>.Some { value } => {
        let values = List<NpmScalar>.asSlice(&value.values)
        if value.list || values.length == usize.ZERO {
          return Option<bool>.none()
        }
        return match &values[0] {
          NpmScalar.Boolean { value: set } => Option<bool>.some(set)
          _ => Option<bool>.none()
        }
      }
      Option<&NpmEntry>.None => Option<bool>.none()
    }
  }

  /// Returns the text value of `key` as a path, as npm reads its path options.
  ///
  /// # Details
  ///
  /// A value that starts with `~/` is resolved in the home directory. Any other relative value is
  /// resolved in the working directory, and an absolute value is normalized. Returns `None` if no
  /// layer sets `key` as text, or if the value needs a home or working directory that the
  /// configuration does not have.
  ///
  /// # Errors
  ///
  /// - `FileError` with reason `InvalidPath` if the value has a NUL byte or goes above the root.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the path.
  pub effect fn path(self: &NpmConfig, key: string) -> Option<Path>
    ! FileError | OutOfMemoryError
    ? &mut Allocator {
    return match NpmConfig.text(self, key) {
      Option<string>.Some { value } => run resolvePath(self, value)
      Option<string>.None => Option<Path>.none()
    }
  }

  /// Returns the user file: the `userconfig` path, or else `.npmrc` in the home directory, or
  /// `None` if neither is known.
  ///
  /// # Errors
  ///
  /// - `FileError` with reason `InvalidPath` if `userconfig` has a NUL byte or goes above the root.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the path.
  pub effect fn userFile(self: &NpmConfig) -> Option<Path>
    ! FileError | OutOfMemoryError
    ? &mut Allocator {
    let configured = run NpmConfig.path(self, "userconfig")
    if Option<Path>.isSome(&configured) {
      return move configured
    }
    return match &self.home {
      Option<Path>.Some { value } => Option<Path>.some(run Path.join(&value, ".npmrc"))
      Option<Path>.None => Option<Path>.none()
    }
  }

  /// Returns the global file: the `globalconfig` path, or else `etc/npmrc` in the global prefix.
  ///
  /// # Details
  ///
  /// The global prefix is the `prefix` path, or else `globalPrefix`, or else the `PREFIX`
  /// environment variable. Returns `None` if none of them is known.
  ///
  /// # Errors
  ///
  /// - `HostInputError` if the environment cannot be read.
  /// - `FileError` with reason `InvalidPath` if a path has a NUL byte or goes above the root.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the path.
  pub effect fn globalFile(self: &NpmConfig, globalPrefix: Option<Path>) -> Option<Path>
    ! HostInputError | FileError | OutOfMemoryError
    ? &mut HostInput | &mut Allocator {
    let configured = run NpmConfig.path(self, "globalconfig")
    if Option<Path>.isSome(&configured) {
      return move configured
    }
    let mut prefix = run NpmConfig.path(self, "prefix")
    if Option<Path>.isNone(&prefix) {
      prefix = move globalPrefix
    }
    if Option<Path>.isNone(&prefix) {
      let variable = run HostInput.variableNamed("PREFIX")
      match move variable {
        Option<Bytes>.Some { value } => {
          let mut text = String.make()
          run UrlPercent.appendUtf8Lossy(&mut text, Bytes.asSlice(&value))
          prefix = run resolvePath(self, String.view(&text))
        }
        Option<Bytes>.None => {}
      }
    }
    return match move prefix {
      Option<Path>.Some { value } => Option<Path>.some(run Path.join(&value, "etc/npmrc"))
      Option<Path>.None => Option<Path>.none()
    }
  }

  /// Returns the registry URL for the package `name`, as npm chooses it.
  ///
  /// # Details
  ///
  /// For a scoped name such as `@acme/widgets`, it is the text of `@acme:registry` if that is set
  /// and not empty. Otherwise it is the text of `registry`, or [`DEFAULT_REGISTRY`]. `name` can
  /// also be a spec such as `@acme/widgets@^2`; only the scope before the first `/` is read. The
  /// text borrows from `self`.
  pub fn registryFor<'a>(self: &'a NpmConfig, name: string) -> string<'a> {
    let bytes = String.utf8Bytes(name)
    if bytes.length > usize.ZERO && bytes[0] == 64 {
      let mut slash = usize.ONE
      while slash < bytes.length && bytes[slash] != 47 {
        slash = slash + usize.ONE
      }
      if slash < bytes.length {
        let scoped = scopedText(self, String.slice(name, usize.ZERO, slash))
        if String.byteLength(scoped) > usize.ZERO {
          return scoped
        }
      }
    }
    return NpmConfig.registry(self)
  }

  /// Returns the text of `registry`, or [`DEFAULT_REGISTRY`] if it is not set or empty. The text
  /// borrows from `self`.
  pub fn registry<'a>(self: &'a NpmConfig) -> string<'a> {
    return match NpmConfig.text(self, "registry") {
      Option<string<'a>>.Some { value } => {
        if String.byteLength(value) == usize.ZERO {
          return DEFAULT_REGISTRY
        }
        return value
      }
      Option<string<'a>>.None => DEFAULT_REGISTRY
    }
  }

  /// Returns the credentials npm would send with a request to `url`, or `None` if there are none.
  ///
  /// # Details
  ///
  /// The lookup starts with the key prefix `//<host>/<path>` of `url`, without the scheme, the user,
  /// the query, and the fragment, and with a default port left out. While the prefix is longer than
  /// `//`, it checks `<prefix>:_authToken`, then `<prefix>:_auth`, then `<prefix>:username` with
  /// `<prefix>:_password`, then `<prefix>:certfile` with `<prefix>:keyfile`, and stops at the first
  /// prefix that has one of them set to a non-empty value. Otherwise it removes the last path name
  /// or the last `/` and tries again. So `//npm.test/team/:_authToken` covers
  /// `https://npm.test/team/pkg`.
  ///
  /// If no prefix has credentials, and `registry` is a different URL on the same host and port as
  /// `url`, the credentials of `registry` are used, as npm does for tarball URLs. Pass the result of
  /// [`NpmConfig.registryFor`] for the package as `registry`.
  ///
  /// Credentials only for a host-wide key, such as an `_authToken` with no `//host/` prefix, are not
  /// used, as npm 9 and later refuse them.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the credentials.
  ///
  /// # Gotchas
  ///
  /// It returns `None` if `url` is not a valid absolute URL.
  pub effect fn credentialsFor(self: &NpmConfig, url: string, registry: string) -> Option<
    NpmCredentials
  >
    ! OutOfMemoryError
    ? &mut Allocator {
    let direct = run credentialsAt(self, url)
    if Option<NpmCredentials>.isSome(&direct) || url == registry {
      return move direct
    }
    if !run sameHost(url, registry) {
      return move direct
    }
    return run credentialsAt(self, registry)
  }

  /// Returns the key prefix npm uses for the credentials of `url`, such as `//registry.npmjs.org/`
  /// for `https://registry.npmjs.org/some/pkg`.
  ///
  /// # Details
  ///
  /// It is `//`, the host with a port that is not the default, and the path up to and with its
  /// last `/`. The scheme, the user, the query, and the fragment are left out. Returns `None` if
  /// `url` is not a valid absolute URL.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the text.
  pub effect fn nerfDart(url: string) -> Option<String>
    ! OutOfMemoryError
    ? &mut Allocator {
    let parsed = run Url.parse(url, Option<&Url>.none())
    return match move parsed {
      Option<Url>.Some { value } => {
        let mut key = String.make()
        run String.append(&mut key, "//")
        run String.append(&mut key, Url.host(&value))
        let pathname = Url.pathname(&value)
        let bytes = String.utf8Bytes(pathname)
        let mut end = bytes.length
        while end > usize.ZERO && bytes[end - usize.ONE] != 47 {
          end = end - usize.ONE
        }
        run String.append(&mut key, String.slice(pathname, usize.ZERO, end))
        if end == usize.ZERO {
          run String.append(&mut key, "/")
        }
        Option<String>.some(move key)
      }
      Option<Url>.None => Option<String>.none()
    }
  }

  /// Returns `text` with each `${NAME}` replaced by the value of the environment variable `NAME`,
  /// as npm expands `.npmrc` keys and values.
  ///
  /// # Details
  ///
  /// `NAME` is one or more characters other than `$`, `{`, and `}`. An unset variable leaves
  /// `${NAME}` as it is; a variable set to empty text gives empty text. For `k` backslashes right
  /// before `$`: if `k` is even, `k / 2` backslashes stay and the variable is expanded; if `k` is
  /// odd, `(k + 1) / 2` backslashes are removed and `${NAME}` stays.
  ///
  /// # Errors
  ///
  /// - `HostInputError` if an environment variable cannot be read.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the text.
  pub effect fn expand(text: string) -> String
    ! HostInputError | OutOfMemoryError
    ? &mut HostInput | &mut Allocator {
    let bytes = String.utf8Bytes(text)
    let mut output = Bytes.make()
    let mut copied = usize.ZERO
    let mut index = usize.ZERO
    while index + 3 < bytes.length + usize.ONE && index < bytes.length {
      if bytes[index] != 36 || index + usize.ONE >= bytes.length
        || bytes[index + usize.ONE] != 123 {
        index = index + usize.ONE
        continue
      }
      let mut close = index + 2
      while close < bytes.length && bytes[close] != 125 && bytes[close] != 36
        && bytes[close] != 123 {
        close = close + usize.ONE
      }
      if close >= bytes.length || bytes[close] != 125 || close == index + 2 {
        index = index + usize.ONE
        continue
      }
      let mut start = index
      while start > copied && bytes[start - usize.ONE] == 92 {
        start = start - usize.ONE
      }
      let escapes = index - start
      run Bytes.append(&mut output, Slice.view<u8>(bytes, copied, start - copied))
      if escapes % 2 == usize.ONE {
        let kept = start + (escapes + usize.ONE) / 2
        run Bytes.append(&mut output, Slice.view<u8>(bytes, kept, close + usize.ONE - kept))
      } else {
        run Bytes.append(&mut output, Slice.view<u8>(bytes, start, escapes / 2))
        let name = Slice.view<u8>(bytes, index + 2, close - index - 2)
        let found = run HostInput.variable(name)
        match move found {
          Option<Bytes>.Some { value } => {
            let mut decoded = String.make()
            run UrlPercent.appendUtf8Lossy(&mut decoded, Bytes.asSlice(&value))
            run Bytes.append(&mut output, String.ownedUtf8Bytes(&decoded))
          }
          Option<Bytes>.None => {
            run Bytes.append(&mut output, Slice.view<u8>(bytes, index, close + usize.ONE - index))
          }
        }
      }
      copied = close + usize.ONE
      index = copied
    }
    run Bytes.append(&mut output, Slice.view<u8>(bytes, copied, bytes.length - copied))
    return unsafe String.fromBytesUnchecked(move output)
  }
}

fn sourceRank(source: NpmConfigSource) -> usize {
  return match source {
    NpmConfigSource.Builtin => 0
    NpmConfigSource.Global => 1
    NpmConfigSource.User => 2
    NpmConfigSource.Project => 3
    NpmConfigSource.Environment => 4
    NpmConfigSource.CommandLine => 5
  }
}

fn optionRef<'a>(value: &'a Option<Path>) -> Option<&'a Path> {
  return match &value.* {
    Option<Path>.Some { value: path } => Option<&'a Path>.some(&path)
    Option<Path>.None => Option<&'a Path>.none()
  }
}

fn samePath(left: Option<&Path>, right: Option<&Path>) -> bool {
  return match move left {
    Option<&Path>.Some { value: first } => match move right {
      Option<&Path>.Some { value: second } => sameBytes(Path.rawBytes(first), Path.rawBytes(second))
      Option<&Path>.None => false
    }
    Option<&Path>.None => false
  }
}

// npm refuses to read one file as two layers; this reader skips the second one.
fn alreadyRead(config: &NpmConfig, path: &Path) -> bool {
  let layers = List<NpmConfigLayer>.asSlice(&config.stack)
  let mut index = usize.ZERO
  while index < layers.length {
    if samePath(optionRef(&layers[index].file), Option<&Path>.some(path)) {
      return true
    }
    index = index + usize.ONE
  }
  return false
}

fn sameBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut index = usize.ZERO
  while index < left.length {
    if left[index] != right[index] {
      return false
    }
    index = index + usize.ONE
  }
  return true
}

fn prefixIgnoringCase(bytes: &[u8], prefix: &[u8]) -> bool {
  if bytes.length < prefix.length {
    return false
  }
  let mut index = usize.ZERO
  while index < prefix.length {
    let mut byte = bytes[index]
    if byte >= 65 && byte <= 90 {
      byte = byte + 32
    }
    if byte != prefix[index] {
      return false
    }
    index = index + usize.ONE
  }
  return true
}

// In global mode npm skips the project file.
fn globalMode(config: &NpmConfig) -> bool {
  if &NpmConfig.flag(config, "global") == &Option<bool>.some(true) {
    return true
  }
  return &NpmConfig.text(config, "location") == &Option<string>.some("global")
}

fn scopedText<'a>(config: &'a NpmConfig, scope: string) -> string<'a> {
  let layers = List<NpmConfigLayer>.asSlice(&config.stack)
  let mut index = layers.length
  while index > usize.ZERO {
    index = index - usize.ONE
    let entries = List<NpmEntry>.asSlice(&layers[index].entries)
    let mut at = usize.ZERO
    while at < entries.length {
      if isScopedRegistry(String.view(&entries[at].key), scope) {
        return NpmIni.firstText(&entries[at]) |> Option<string<'a>>.unwrapOr("")
      }
      at = at + usize.ONE
    }
  }
  return ""
}

fn isScopedRegistry(key: string, scope: string) -> bool {
  let scopeLength = String.byteLength(scope)
  return String.byteLength(key) == scopeLength + 9 && String.startsWith(key, scope)
    && String.endsWith(key, ":registry")
}

// JavaScript truth of a configuration value: non-empty text, `true`, or any list.
fn truthy(entry: Option<&NpmEntry>) -> bool {
  return match move entry {
    Option<&NpmEntry>.None => false
    Option<&NpmEntry>.Some { value } => {
      if value.list {
        return true
      }
      let values = List<NpmScalar>.asSlice(&value.values)
      if values.length == usize.ZERO {
        return false
      }
      return match &values[0] {
        NpmScalar.Null => false
        NpmScalar.Boolean { value: set } => set
        NpmScalar.Text { text } => String.ownedByteLength(&text) != usize.ZERO
      }
    }
  }
}

// The value as JavaScript turns it into text in a template: a boolean or null by its name.
effect fn valueText(entry: Option<&NpmEntry>) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  return match move entry {
    Option<&NpmEntry>.None => String.make()
    Option<&NpmEntry>.Some { value } => {
      let values = List<NpmScalar>.asSlice(&value.values)
      let mut text = String.make()
      let mut index = usize.ZERO
      while index < values.length {
        if index > usize.ZERO {
          run String.append(&mut text, ",")
        }
        match &values[index] {
          NpmScalar.Null => {
            if !value.list {
              run String.append(&mut text, "null")
            }
          }
          NpmScalar.Boolean { value: set } => {
            if set {
              run String.append(&mut text, "true")
            } else {
              run String.append(&mut text, "false")
            }
          }
          NpmScalar.Text { text: part } => {
            run String.append(&mut text, String.view(&part))
          }
        }
        index = index + usize.ONE
      }
      move text
    }
  }
}

effect fn lookupKey<'a>(config: &'a NpmConfig, prefix: string, suffix: string) -> Option<
  &'a NpmEntry
>
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut key = String.make()
  run String.append(&mut key, prefix)
  run String.append(&mut key, suffix)
  return NpmConfig.get(config, String.view(&key))
}

effect fn credentialsAt(config: &NpmConfig, url: string) -> Option<NpmCredentials>
  ! OutOfMemoryError
  ? &mut Allocator {
  let parsed = run Url.parse(url, Option<&Url>.none())
  let location = match move parsed {
    Option<Url>.Some { value } => move value
    Option<Url>.None => {
      return Option<NpmCredentials>.none()
    }
  }
  let mut key = String.make()
  run String.append(&mut key, "//")
  run String.append(&mut key, Url.host(&location))
  run String.append(&mut key, Url.pathname(&location))
  while String.ownedByteLength(&key) > 2 {
    let prefix = String.view(&key)
    let token = run lookupKey(config, prefix, ":_authToken")
    let auth = run lookupKey(config, prefix, ":_auth")
    let username = run lookupKey(config, prefix, ":username")
    let password = run lookupKey(config, prefix, ":_password")
    let certificate = run lookupKey(config, prefix, ":certfile")
    let keyFile = run lookupKey(config, prefix, ":keyfile")
    let basicPair = truthy(username) && truthy(password)
    let certificatePair = truthy(certificate) && truthy(keyFile)
    if truthy(token) || truthy(auth) || basicPair || certificatePair {
      let mut credentials = NpmCredentials {
        registryKey: run String.copy(prefix),
        bearer: Option<String>.none(),
        basic: Option<String>.none(),
        certificateFile: Option<String>.none(),
        keyFile: Option<String>.none(),
      }
      if truthy(token) {
        credentials.bearer = Option<String>.some(run valueText(token))
      } else if truthy(auth) {
        credentials.basic = Option<String>.some(run valueText(auth))
      } else if basicPair {
        let user = run valueText(username)
        let encoded = run valueText(password)
        credentials.basic = Option<String>.some(
          run basicCredentials(String.view(&user), String.view(&encoded)),
        )
      }
      if certificatePair {
        credentials.certificateFile = Option<String>.some(run valueText(certificate))
        credentials.keyFile = Option<String>.some(run valueText(keyFile))
      }
      return Option<NpmCredentials>.some(move credentials)
    }

    // Remove the last path name, or else the last `/`, as `/([^/]+|\/)$/` does.
    let bytes = String.ownedUtf8Bytes(&key)
    let mut end = bytes.length
    if bytes[end - usize.ONE] == 47 {
      end = end - usize.ONE
    } else {
      while end > usize.ZERO && bytes[end - usize.ONE] != 47 {
        end = end - usize.ONE
      }
    }
    let mut shorter = String.make()
    run String.append(&mut shorter, String.slice(String.view(&key), usize.ZERO, end))
    key = move shorter
  }
  return Option<NpmCredentials>.none()
}

effect fn sameHost(left: string, right: string) -> bool
  ! OutOfMemoryError
  ? &mut Allocator {
  let first = run Url.parse(left, Option<&Url>.none())
  let second = run Url.parse(right, Option<&Url>.none())
  return match &first {
    Option<Url>.Some { value: a } => match &second {
      Option<Url>.Some { value: b } => Url.host(&a) == Url.host(&b)
      Option<Url>.None => false
    }
    Option<Url>.None => false
  }
}

// `username:password` in Base64, where `password` is the Base64 text of the password, decoded as
// Node's lenient Base64 decoder does.
effect fn basicCredentials(username: string, encodedPassword: string) -> String
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut plain = Bytes.make()
  run Bytes.append(&mut plain, String.utf8Bytes(username))
  run Bytes.append(&mut plain, b":")
  let password = run lenientBase64Decode(String.utf8Bytes(encodedPassword))
  let mut text = String.make()
  run UrlPercent.appendUtf8Lossy(&mut text, Bytes.asSlice(&password))
  run Bytes.append(&mut plain, String.ownedUtf8Bytes(&text))
  let input = Bytes.asSlice(&plain)
  let length = Base64.encodedLength(input.length) |> Result<usize, Base64Error>.unwrapOr(usize.ZERO)
  let mut output = run Bytes.zeroed(length)
  let _written = Base64.encodeInto(Bytes.asMutSlice(&mut output), input)
  return unsafe String.fromBytesUnchecked(move output)
}

// Node's `Buffer.from(text, 'base64')`: it accepts the standard and URL-safe alphabets, skips other
// bytes, and stops at the first `=`.
effect fn lenientBase64Decode(input: &[u8]) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut output = Bytes.make()
  let mut bits: u32 = 0
  let mut count: u32 = 0
  let mut index = usize.ZERO
  while index < input.length {
    let byte = input[index]
    index = index + usize.ONE
    if byte == 61 {
      break
    }
    let mut digit: u32 = 64
    if byte >= 65 && byte <= 90 {
      digit = u8.toU32(byte - 65)
    } else if byte >= 97 && byte <= 122 {
      digit = u8.toU32(byte - 97) + 26
    } else if byte >= 48 && byte <= 57 {
      digit = u8.toU32(byte - 48) + 52
    } else if byte == 43 || byte == 45 {
      digit = 62
    } else if byte == 47 || byte == 95 {
      digit = 63
    }
    if digit == 64 {
      continue
    }
    bits = bits * 64 + digit
    count = count + 6
    if count >= 8 {
      count = count - 8
      let mut divisor: u32 = 1
      if count == 2 {
        divisor = 4
      } else if count == 4 {
        divisor = 16
      }
      let one = [u32.toU8(bits / divisor)]
      run Bytes.append(&mut output, &one)
      bits = bits % divisor
    }
  }
  return move output
}

effect fn homeDirectory() -> Option<Path>
  ! HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  let mut found = run HostInput.variableNamed("HOME")
  if Option<Bytes>.isNone(&found) {
    found = run HostInput.variableNamed("USERPROFILE")
  }
  return match move found {
    Option<Bytes>.Some { value } => {
      let made = run Effect.result(Path.fromBytes(Bytes.asSlice(&value)))
      match move made {
        Result<Path, FileError | OutOfMemoryError>.Success { value: path } => Option<Path>.some(
          move path,
        )
        Result<Path, FileError | OutOfMemoryError>.Failure { error } => match move error {
          FileError invalid => Option<Path>.none()
          OutOfMemoryError exhausted => {
            fail move exhausted
          }
        }
      }
    }
    Option<Bytes>.None => Option<Path>.none()
  }
}

effect fn resolvePath(config: &NpmConfig, text: string) -> Option<Path>
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  let bytes = String.utf8Bytes(text)
  if bytes.length >= 2 && bytes[0] == 126 && bytes[1] == 47 {
    return match &config.home {
      Option<Path>.Some { value } => Option<Path>.some(
        run Path.resolve(&value, trimSlashes(String.slice(text, 2, bytes.length - 2))),
      )
      Option<Path>.None => Option<Path>.none()
    }
  }
  if bytes.length > usize.ZERO && bytes[0] == 47 {
    let root = run Path.root()
    return Option<Path>.some(run Path.resolve(&root, trimSlashes(text)))
  }
  return match &config.workingDirectory {
    Option<Path>.Some { value } => Option<Path>.some(run Path.resolve(&value, text))
    Option<Path>.None => Option<Path>.none()
  }
}

fn trimSlashes(text: string) -> string {
  let bytes = String.utf8Bytes(text)
  let mut start = usize.ZERO
  while start < bytes.length && bytes[start] == 47 {
    start = start + usize.ONE
  }
  return String.slice(text, start, bytes.length - start)
}

// npm's local prefix: `prefix` from the command line, or the nearest directory with a
// `package.json` or `node_modules`, moved up to a workspace root that names it.
effect fn projectDirectory(config: &NpmConfig) -> Path
  ! FileError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let layers = List<NpmConfigLayer>.asSlice(&config.stack)
  let mut index = usize.ZERO
  let mut workspaces = true
  while index < layers.length {
    match layers[index].source {
      NpmConfigSource.CommandLine => {
        match NpmIni.text(&layers[index].entries, "prefix") {
          Option<string>.Some { value } => {
            match move run resolvePath(config, value) {
              Option<Path>.Some { value: path } => {
                return move path
              }
              Option<Path>.None => {}
            }
          }
          Option<string>.None => {}
        }
        match NpmIni.find(&layers[index].entries, "workspaces") {
          Option<&NpmEntry>.Some { value } => {
            match &List<NpmScalar>.asSlice(&value.values)[0] {
              NpmScalar.Boolean { value: set } => {
                workspaces = set
              }
              _ => {}
            }
          }
          Option<&NpmEntry>.None => {}
        }
      }
      _ => {}
    }
    index = index + usize.ONE
  }
  let working = match &config.workingDirectory {
    Option<Path>.Some { value } => run Path.resolve(&value, "")
    Option<Path>.None => run Path.root()
  }
  let mut current = run Path.resolve(&working, "")
  let mut found = Option<Path>.none()
  while true {
    let manifest = run Path.join(&current, "package.json")
    let hasManifest = run isFile(&manifest)
    if Option<Path>.isNone(&found) {
      let modules = run Path.join(&current, "node_modules")
      if hasManifest || run isDirectory(&modules) {
        found = Option<Path>.some(run Path.resolve(&current, ""))
        if !workspaces || globalMode(config) {
          break
        }
      }
    } else if hasManifest {
      let local = match &found {
        Option<Path>.Some { value } => run Path.resolve(&value, "")
        Option<Path>.None => run Path.root()
      }
      if run workspaceIncludes(&current, &manifest, &local) {
        return move current
      }
    }
    let parent = run Path.parent(&current)
    match move parent {
      Option<Path>.Some { value } => {
        current = move value
      }
      Option<Path>.None => {
        break
      }
    }
  }
  return match move found {
    Option<Path>.Some { value } => move value
    Option<Path>.None => move working
  }
}

effect fn isFile(path: &Path) -> bool
  ! OutOfMemoryError
  ? &mut FileSystem {
  return match move run Effect.result(FileSystem.stat(path)) {
    Result<FileInfo | DirectoryInfo, FileError>.Success { value } => match move value {
      FileInfo _file => true
      DirectoryInfo _folder => false
    }
    Result<FileInfo | DirectoryInfo, FileError>.Failure { error } => {
      drop error
      false
    }
  }
}

effect fn isDirectory(path: &Path) -> bool
  ! OutOfMemoryError
  ? &mut FileSystem {
  return match move run Effect.result(FileSystem.stat(path)) {
    Result<FileInfo | DirectoryInfo, FileError>.Success { value } => match move value {
      FileInfo _file => false
      DirectoryInfo _folder => true
    }
    Result<FileInfo | DirectoryInfo, FileError>.Failure { error } => {
      drop error
      false
    }
  }
}

// Whether the `workspaces` patterns in `manifest` (an array, or an object with a `packages` array)
// name `local`, a directory under `root` that has its own `package.json`. A pattern that starts with
// `!` removes the directories it names.
effect fn workspaceIncludes(root: &Path, manifest: &Path, local: &Path) -> bool
  ! OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let localManifest = run Effect.result(Path.join(local, "package.json"))
  let ownManifest = match move localManifest {
    Result<Path, FileError | OutOfMemoryError>.Success { value } => move value
    Result<Path, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError invalid => {
        return false
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  if !run isFile(&ownManifest) {
    return false
  }
  let rootBytes = Path.rawBytes(root)
  let localBytes = Path.rawBytes(local)
  let mut skip = rootBytes.length + usize.ONE
  if Path.isRoot(root) {
    skip = usize.ONE
  }
  if localBytes.length <= skip {
    return false
  }
  let mut relative = String.make()
  run UrlPercent.appendUtf8Lossy(
    &mut relative,
    Slice.view<u8>(localBytes, skip, localBytes.length - skip),
  )
  let read = run Effect.result(FileSystem.readFile(manifest))
  let contents = match move read {
    Result<Bytes, FileError | OutOfMemoryError>.Success { value } => move value
    Result<Bytes, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError unreadable => {
        return false
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let parsed = run Effect.result(Json.parse(Bytes.asSlice(&contents)))
  let document = match move parsed {
    Result<Value, JsonError | OutOfMemoryError>.Success { value } => move value
    Result<Value, JsonError | OutOfMemoryError>.Failure { error } => match move error {
      JsonError invalid => {
        return false
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  let mut patterns = Json.field(&document, "workspaces")
  match Json.fieldAt(Json.field(&document, "workspaces"), "packages") {
    Option<&Value>.Some { value } => {
      patterns = Option<&Value>.some(value)
    }
    Option<&Value>.None => {}
  }
  let list = match move patterns {
    Option<&Value>.Some { value } => value
    Option<&Value>.None => {
      return false
    }
  }
  let mut included = false
  let mut index = usize.ZERO
  while true {
    let item = Json.item(list, index)
    let pattern = match Json.asString(move item) {
      Option<string>.Some { value } => value
      Option<string>.None => {
        break
      }
    }
    index = index + usize.ONE
    let mut text = pattern
    let mut negated = false
    if String.startsWith(text, "!") {
      negated = true
      text = String.slice(text, usize.ONE, String.byteLength(text) - usize.ONE)
    }
    while String.startsWith(text, "./") {
      text = String.slice(text, 2, String.byteLength(text) - 2)
    }
    while String.endsWith(text, "/") {
      text = String.slice(text, usize.ZERO, String.byteLength(text) - usize.ONE)
    }
    let compiled = run Pattern.make(text)
    let result = run Pattern.matches(&compiled, String.view(&relative), Dots.Hide)
    if result.matches {
      included = !negated
    }
  }
  return included
}

// Expands `${NAME}` in the keys and text values of the top-level entries; later keys win.
effect fn expandEntries(parsed: &List<NpmEntry>) -> List<NpmEntry>
  ! HostInputError | OutOfMemoryError
  ? &mut HostInput | &mut Allocator {
  let all = List<NpmEntry>.asSlice(parsed)
  let mut entries = List<NpmEntry>.make()
  let mut index = usize.ZERO
  while index < all.length {
    let entry = &all[index]
    index = index + usize.ONE
    if entry.sectioned {
      continue
    }
    let key = run NpmConfig.expand(String.view(&entry.key))

    // npm expands the items of a list only for its own list options.
    let expandText = !entry.list || listOption(String.view(&key))
    let source = List<NpmScalar>.asSlice(&entry.values)
    let mut values = List<NpmScalar>.make()
    let mut at = usize.ZERO
    while at < source.length {
      let copied = match &source[at] {
        NpmScalar.Null => NpmScalar.Null
        NpmScalar.Boolean { value } => NpmScalar.Boolean { value: value }
        NpmScalar.Text { text } => {
          if expandText {
            NpmScalar.Text { text: run NpmConfig.expand(String.view(&text)) }
          } else {
            NpmScalar.Text { text: run String.copy(String.view(&text)) }
          }
        }
      }
      run List<NpmScalar>.append(&mut values, move copied)
      at = at + usize.ONE
    }
    run replace(&mut entries, move key, move values, entry.list)
  }
  return move entries
}

// The options npm defines with a list type.
fn listOption(key: string) -> bool {
  return key == "ca" || key == "cidr" || key == "diff" || key == "include" || key == "noproxy"
    || key == "omit"
    || key == "package"
    || key == "workspace"
}

fn scalarOf(text: String) -> NpmScalar {
  let view = String.view(&text)
  if view == "true" {
    return NpmScalar.Boolean { value: true }
  }
  if view == "false" {
    return NpmScalar.Boolean { value: false }
  }
  if view == "null" {
    return NpmScalar.Null
  }
  return NpmScalar.Text { text: move text }
}

effect fn put(entries: &mut List<NpmEntry>, key: String, value: NpmScalar, list: bool) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let mut values = List<NpmScalar>.make()
  run List<NpmScalar>.append(&mut values, move value)
  run replace(&mut entries.*, move key, move values, list)
}

effect fn replace(
  entries: &mut List<NpmEntry>,
  key: String,
  values: List<NpmScalar>,
  list: bool,
) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
  let all = List<NpmEntry>.asMutSlice(&mut entries.*)
  let mut index = usize.ZERO
  while index < all.length {
    if String.view(&all[index].key) == String.view(&key) {
      all[index].values = move values
      all[index].list = list
      return ()
    }
    index = index + usize.ONE
  }
  run List<NpmEntry>.append(
    &mut entries.*,
    NpmEntry {
      section: String.make(),
      sectioned: false,
      key: move key,
      values: move values,
      list: list,
    },
  )
}
