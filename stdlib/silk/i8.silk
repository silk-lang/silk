//! Eight-bit signed integers for compact values, byte-level formats, and narrow arithmetic.
//!
//! # When to use
//! Use `i8` when an external format or data structure requires exactly eight signed bits. Prefer a
//! wider integer for general arithmetic: the small range makes accidental overflow easy.
//!
//! # Details
//! Ordinary arithmetic, narrowing conversions, division by zero, and invalid shift counts trap.
//! Choose `checked*` when failure is data, `wrapping*` for arithmetic modulo 2^8, or `saturating*`
//! when results should clamp to [`MIN`] or [`MAX`]. Signed right shifts preserve the sign bit.
//!
//! Decimal [`parse`] consumes the complete input and distinguishes malformed text from a value
//! outside the i8 range. Use [`Format`] with `Format.display` for defaults or `Format.displayWith`
//! for explicit options. Both operations stream through a mutable `Writer` without `Allocator`.
//!
//! # Gotchas
//! [`MIN`] has no positive i8 counterpart, so ordinary [`negate`] traps for that one value.
//!
//! # Examples
//! ## Select the boundary policy for negation
//! ```silk
//! import silk.i8
//!
//! pub fn main() -> i32 {
//!   if i8.wrappingNegate(i8.MIN) != i8.MIN {
//!     return 1
//!   }
//!   if i8.saturatingNegate(i8.MIN) != i8.MAX {
//!     return 2
//!   }
//!   return 42
//! }
//! ```

import silk.bool
import silk.f32
import silk.f64
import silk.format { Format, ParseError }
import silk.i16
import silk.i32
import silk.i64
import silk.isize
import silk.option { Option }
import silk.result { Result }
import silk.u16
import silk.u32
import silk.u64
import silk.u8
import silk.usize

/// The largest `i8` value.
pub const MAX: i8 = 127

/// The smallest `i8` value.
pub const MIN: i8 = -128

/// The fixed width of `i8`, in bits.
pub const BITS: u32 = 8

/// Returns the arithmetic negation of `value` and traps when `value` is [`MIN`]. Use
/// this function when that boundary is a program error.
pub fn negate(value: i8) -> i8 {
  return Intrinsic.i8Negate(value)
}

/// Returns the arithmetic negation of `value`, wrapped to the `i8` range. [`MIN`]
/// stays [`MIN`]. Use this function for deliberate modulo arithmetic.
pub fn wrappingNegate(value: i8) -> i8 {
  return Intrinsic.i8WrappingNegate(value)
}

/// Returns the arithmetic negation of `value`, clamped to the `i8` range. [`MIN`]
/// becomes [`MAX`]. Use this function when the positive boundary is required.
pub fn saturatingNegate(value: i8) -> i8 {
  return Intrinsic.i8SaturatingNegate(value)
}

/// Converts `value` to `u8`. Traps if `value` is outside the `u8` range. Use
/// this function when an out-of-range value is a program error.
pub fn toU8(value: i8) -> u8 {
  return Intrinsic.i8ToU8(value)
}

/// Converts `value` to `u8`, or returns `None` if `value` is outside the `u8`
/// range. Use this function when an out-of-range value is input data.
pub fn checkedToU8(value: i8) -> Option<u8> {
  return Intrinsic.i8CheckedToU8<Option<u8>>(value, Option.some, Option.none)
}

/// Converts `value` to `u16`. Traps if `value` is outside the `u16` range. Use
/// this function when an out-of-range value is a program error.
pub fn toU16(value: i8) -> u16 {
  return Intrinsic.i8ToU16(value)
}

/// Converts `value` to `u16`, or returns `None` if `value` is outside the `u16`
/// range. Use this function when an out-of-range value is input data.
pub fn checkedToU16(value: i8) -> Option<u16> {
  return Intrinsic.i8CheckedToU16<Option<u16>>(value, Option.some, Option.none)
}

/// Converts `value` to `u32`. Traps if `value` is outside the `u32` range. Use
/// this function when an out-of-range value is a program error.
pub fn toU32(value: i8) -> u32 {
  return Intrinsic.i8ToU32(value)
}

/// Converts `value` to `u32`, or returns `None` if `value` is outside the `u32`
/// range. Use this function when an out-of-range value is input data.
pub fn checkedToU32(value: i8) -> Option<u32> {
  return Intrinsic.i8CheckedToU32<Option<u32>>(value, Option.some, Option.none)
}

/// Converts `value` to `u64`. Traps if `value` is outside the `u64` range. Use
/// this function when an out-of-range value is a program error.
pub fn toU64(value: i8) -> u64 {
  return Intrinsic.i8ToU64(value)
}

/// Converts `value` to `u64`, or returns `None` if `value` is outside the `u64`
/// range. Use this function when an out-of-range value is input data.
pub fn checkedToU64(value: i8) -> Option<u64> {
  return Intrinsic.i8CheckedToU64<Option<u64>>(value, Option.some, Option.none)
}

/// Converts `value` to `usize`. Traps if `value` is outside the `usize` range. Use
/// this function when an out-of-range value is a program error.
pub fn toUsize(value: i8) -> usize {
  return Intrinsic.i8ToUsize(value)
}

/// Converts `value` to `usize`, or returns `None` if `value` is outside the `usize`
/// range. Use this function when an out-of-range value is input data.
pub fn checkedToUsize(value: i8) -> Option<usize> {
  return Intrinsic.i8CheckedToUsize<Option<usize>>(value, Option.some, Option.none)
}

/// Returns `value` unchanged as `i8`. Use this function when generic conversion code
/// can select `i8` as both source and destination.
pub fn toI8(value: i8) -> i8 {
  return Intrinsic.i8ToI8(value)
}

/// Returns `Some` with `value` unchanged as `i8`. Use this function when generic
/// checked-conversion code can select the same source and destination type.
pub fn checkedToI8(value: i8) -> Option<i8> {
  return Intrinsic.i8CheckedToI8<Option<i8>>(value, Option.some, Option.none)
}

/// Converts `value` exactly to `i16`. Every `i8` value is representable.
pub fn toI16(value: i8) -> i16 {
  return Intrinsic.i8ToI16(value)
}

/// Converts `value` exactly to `i16` and returns `Some`. Every `i8` value is
/// representable.
pub fn checkedToI16(value: i8) -> Option<i16> {
  return Intrinsic.i8CheckedToI16<Option<i16>>(value, Option.some, Option.none)
}

/// Converts `value` exactly to `i32`. Every `i8` value is representable.
pub fn toI32(value: i8) -> i32 {
  return Intrinsic.i8ToI32(value)
}

/// Converts `value` exactly to `i32` and returns `Some`. Every `i8` value is
/// representable.
pub fn checkedToI32(value: i8) -> Option<i32> {
  return Intrinsic.i8CheckedToI32<Option<i32>>(value, Option.some, Option.none)
}

/// Converts `value` exactly to `i64`. Every `i8` value is representable.
pub fn toI64(value: i8) -> i64 {
  return Intrinsic.i8ToI64(value)
}

/// Converts `value` exactly to `i64` and returns `Some`. Every `i8` value is
/// representable.
pub fn checkedToI64(value: i8) -> Option<i64> {
  return Intrinsic.i8CheckedToI64<Option<i64>>(value, Option.some, Option.none)
}

/// Converts `value` exactly to `isize`. Every `i8` value is representable.
pub fn toIsize(value: i8) -> isize {
  return Intrinsic.i8ToIsize(value)
}

/// Converts `value` exactly to `isize` and returns `Some`. Every `i8` value is
/// representable.
pub fn checkedToIsize(value: i8) -> Option<isize> {
  return Intrinsic.i8CheckedToIsize<Option<isize>>(value, Option.some, Option.none)
}

/// Converts `value` exactly to `f32`. Every `i8` magnitude is below `2^24` and so is exactly
/// representable.
pub fn toF32(value: i8) -> f32 {
  return Intrinsic.i8ToF32(value)
}

/// Converts `value` exactly to `f64`. Every `i8` magnitude is below `2^53` and so is exactly
/// representable.
pub fn toF64(value: i8) -> f64 {
  return Intrinsic.i8ToF64(value)
}

/// Returns `left + right` and traps if the result is outside the `i8` range. Use this function
/// when overflow is a program error.
pub fn add(left: i8, right: i8) -> i8 {
  return Intrinsic.i8Add(left, right)
}

/// Returns `left - right` and traps if the result is outside the `i8` range. Use this function
/// when overflow is a program error.
pub fn subtract(left: i8, right: i8) -> i8 {
  return Intrinsic.i8Subtract(left, right)
}

/// Returns `left * right` and traps if the result is outside the `i8` range. Use this function
/// when overflow is a program error.
pub fn multiply(left: i8, right: i8) -> i8 {
  return Intrinsic.i8Multiply(left, right)
}

/// Returns `left / right`, rounded toward zero. Traps if `right` is zero or [`MIN`] is
/// divided by `-1`. Use this function when an invalid quotient is a program error.
pub fn divide(left: i8, right: i8) -> i8 {
  return Intrinsic.i8Divide(left, right)
}

/// Returns the remainder with the sign of `left`. Traps if `right` is zero or [`MIN`] is
/// divided by `-1`. Use this function when invalid division is a program error.
pub fn remainder(left: i8, right: i8) -> i8 {
  return Intrinsic.i8Remainder(left, right)
}

/// Returns the bitwise AND of `left` and `right`.
pub fn bitAnd(left: i8, right: i8) -> i8 {
  return Intrinsic.i8BitAnd(left, right)
}

/// Returns the bitwise OR of `left` and `right`.
pub fn bitOr(left: i8, right: i8) -> i8 {
  return Intrinsic.i8BitOr(left, right)
}

/// Returns the bitwise exclusive OR of `left` and `right`.
pub fn bitXor(left: i8, right: i8) -> i8 {
  return Intrinsic.i8BitXor(left, right)
}

/// Returns `value` with each bit inverted.
pub fn bitNot(value: i8) -> i8 {
  return Intrinsic.i8BitNot(value)
}

/// Shifts `left` bits left by `right` positions. Traps if `right` is negative or not less than
/// [`BITS`].
pub fn shiftLeft(left: i8, right: i8) -> i8 {
  return Intrinsic.i8ShiftLeft(left, right)
}

/// Shifts `left` bits right by `right` positions and preserves its sign. Traps if `right` is
/// negative or not less than [`BITS`].
pub fn shiftRight(left: i8, right: i8) -> i8 {
  return Intrinsic.i8ShiftRight(left, right)
}

/// Rotates the bits of `left` left by `right` positions.
pub fn rotateLeft(left: i8, right: i8) -> i8 {
  return Intrinsic.i8RotateLeft(left, right)
}

/// Rotates the bits of `left` right by `right` positions.
pub fn rotateRight(left: i8, right: i8) -> i8 {
  return Intrinsic.i8RotateRight(left, right)
}

/// Returns `left + right`, wrapped to the `i8` range. Use this function for
/// deliberate modulo arithmetic.
pub fn wrappingAdd(left: i8, right: i8) -> i8 {
  return Intrinsic.i8WrappingAdd(left, right)
}

/// Returns `left - right`, wrapped to the `i8` range. Use this function for
/// deliberate modulo arithmetic.
pub fn wrappingSubtract(left: i8, right: i8) -> i8 {
  return Intrinsic.i8WrappingSubtract(left, right)
}

/// Returns `left * right`, wrapped to the `i8` range. Use this function for
/// deliberate modulo arithmetic.
pub fn wrappingMultiply(left: i8, right: i8) -> i8 {
  return Intrinsic.i8WrappingMultiply(left, right)
}

/// Returns `left + right`, clamped to [`MIN`] or [`MAX`]. Use this function when a
/// boundary value is the required overflow result.
pub fn saturatingAdd(left: i8, right: i8) -> i8 {
  return Intrinsic.i8SaturatingAdd(left, right)
}

/// Returns `left - right`, clamped to [`MIN`] or [`MAX`]. Use this function when a
/// boundary value is the required overflow result.
pub fn saturatingSubtract(left: i8, right: i8) -> i8 {
  return Intrinsic.i8SaturatingSubtract(left, right)
}

/// Returns `left * right`, clamped to [`MIN`] or [`MAX`]. Use this function when a
/// boundary value is the required overflow result.
pub fn saturatingMultiply(left: i8, right: i8) -> i8 {
  return Intrinsic.i8SaturatingMultiply(left, right)
}

/// Returns `Some` with `left + right`, or `None` if the result is outside the `i8` range.
/// Use this function when overflow is input data.
pub fn checkedAdd(left: i8, right: i8) -> Option<i8> {
  return Intrinsic.i8CheckedAdd<Option<i8>>(left, right, Option.some, Option.none)
}

/// Returns `Some` with `left - right`, or `None` if the result is outside the `i8` range.
/// Use this function when overflow is input data.
pub fn checkedSubtract(left: i8, right: i8) -> Option<i8> {
  return Intrinsic.i8CheckedSubtract<Option<i8>>(left, right, Option.some, Option.none)
}

/// Returns `Some` with `left * right`, or `None` if the result is outside the `i8` range.
/// Use this function when overflow is input data.
pub fn checkedMultiply(left: i8, right: i8) -> Option<i8> {
  return Intrinsic.i8CheckedMultiply<Option<i8>>(left, right, Option.some, Option.none)
}

/// Returns `Some` with `left / right`, or `None` if `right` is zero or [`MIN`] is
/// divided by `-1`. Use this function when an invalid quotient is input data.
pub fn checkedDivide(left: i8, right: i8) -> Option<i8> {
  return Intrinsic.i8CheckedDivide<Option<i8>>(left, right, Option.some, Option.none)
}

/// Returns `Some` with the remainder, or `None` if `right` is zero or [`MIN`] is
/// divided by `-1`. Use this function when invalid division is input data.
pub fn checkedRemainder(left: i8, right: i8) -> Option<i8> {
  return Intrinsic.i8CheckedRemainder<Option<i8>>(left, right, Option.some, Option.none)
}

/// Returns `true` when `left` and `right` are equal.
pub fn equals(left: i8, right: i8) -> bool {
  return Intrinsic.i8Equals(left, right)
}

/// Returns `true` when `left` and `right` are not equal.
pub fn notEquals(left: i8, right: i8) -> bool {
  return Intrinsic.i8NotEquals(left, right)
}

/// Returns `true` when `left` is less than `right`.
pub fn lessThan(left: i8, right: i8) -> bool {
  return Intrinsic.i8LessThan(&left, &right)
}

/// Returns `true` when `left` is less than or equal to `right`.
pub fn lessOrEqual(left: i8, right: i8) -> bool {
  return Intrinsic.i8LessOrEqual(left, right)
}

/// Returns `true` when `left` is greater than `right`.
pub fn greaterThan(left: i8, right: i8) -> bool {
  return Intrinsic.i8GreaterThan(left, right)
}

/// Returns `true` when `left` is greater than or equal to `right`.
pub fn greaterOrEqual(left: i8, right: i8) -> bool {
  return Intrinsic.i8GreaterOrEqual(left, right)
}

/// Reads the complete text as a signed decimal `i8`.
///
/// # Details
///
/// A failure contains `silk.format.NotANumber` for empty text, a leading `+`, a non-digit, or
/// trailing bytes. It contains `silk.format.OutOfRange` if the number is outside the `i8` range.
pub fn parse(text: string) -> Result<i8, ParseError> {
  return Format.i8Value(text)
}
