//! IEEE binary32 values with deterministic representation, classification, and math operations.
//!
//! # When to use
//! Use `f32` when binary32 storage, interchange, or bandwidth is part of the contract. Use `f64`
//! for general floating-point work and unconstrained literals. It preserves substantially more
//! precision and is Silk's default floating type.
//!
//! # Details
//! Basic arithmetic rounds to nearest with ties to even and never enables implicit fast-math
//! assumptions. Division by zero and overflow produce IEEE infinities or NaNs rather than integer-
//! style traps. Ordinary ordered comparisons return false for NaN and treat both zeros as equal;
//! [`totalOrder`] distinguishes every encoding when deterministic ordering is required. The
//! `Order` conformance of `f32` uses the same total order, so `List<f32>.sort` puts negative NaNs
//! first, then `-0.0` before `+0.0`, and positive NaNs last.
//!
//! [`toBits`] and [`fromBits`] expose the exact binary32 representation, including signed zero and
//! NaN payloads. The source-defined rounding, extrema, sign, and square-root helpers canonicalize
//! NaN results so native and WebAssembly execution agree on their bits.
//!
//! The trigonometric, inverse trigonometric, exponential, logarithmic, power, cube root, [`hypot`],
//! and [`fma`] functions never call a host math library. Each states its error bound in units in
//! the last place, returns the same bits on every target, WebAssembly included, and gives the
//! canonical quiet NaN for every NaN result.
//!
//! # Gotchas
//! Converting to an integer discards the fractional part and traps for NaN, infinity, or a value
//! outside the destination range. The `checkedTo*` counterparts return `None` on exactly those
//! inputs instead of trapping. Converting a large integer to f32 can round it.
//!
//! # Examples
//! ## Inspect a binary32 boundary by its bits
//! ```silk
//! import silk.num.f32
//!
//! pub fn main() -> i32 {
//!   let rounded = f32.round(-0.25)
//!   if f32.toBits(rounded) != f32.toBits(-0.0) {
//!     return 1
//!   }
//!   if !f32.isNaN(f32.sqrt(-1.0)) {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Numbers

import silk.core.bool
import silk.num.f64
import silk.num.i16
import silk.num.i32
import silk.num.i64
import silk.num.i8
import silk.num.isize
import silk.core.option { Option }
import silk.core.target { Target, pointerBits }
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.u8
import silk.num.usize

/// The largest finite `f32` value.
pub const MAX: f32 = 3.4028235e38

/// The most negative finite `f32` value, which is the negation of [`MAX`].
pub const MIN: f32 = -3.4028235e38

/// The distance from `1.0` to the next larger `f32` value.
pub const EPSILON: f32 = 1.1920929e-7

/// Positive infinity with the binary32 bit pattern `0x7F800000`.
///
/// # Details
///
/// No source literal spells infinity, and a literal that rounds to infinity is rejected. Doubling
/// [`MAX`] overflows to the infinity encoding.
pub const INFINITY: f32 = MAX * 2.0

/// The ratio of a circle's circumference to its diameter, rounded to the nearest `f32` value.
pub const PI: f32 = 3.1415927

/// Euler's number, rounded to the nearest `f32` value.
pub const E: f32 = 2.7182817

/// Returns `value` with its sign reversed.
pub fn negate(value: f32) -> f32 {
  return Intrinsic.f32Negate(value)
}

/// Returns `left + right`, rounded to nearest with ties to even. Overflow produces infinity. It
/// does not trap.
pub fn add(left: f32, right: f32) -> f32 {
  return Intrinsic.f32Add(left, right)
}

/// Returns `left - right`, rounded to nearest with ties to even. Overflow produces infinity. It
/// does not trap.
pub fn subtract(left: f32, right: f32) -> f32 {
  return Intrinsic.f32Subtract(left, right)
}

/// Returns `left * right`, rounded to nearest with ties to even. Overflow produces infinity. It
/// does not trap.
pub fn multiply(left: f32, right: f32) -> f32 {
  return Intrinsic.f32Multiply(left, right)
}

/// Returns `left / right`, rounded to nearest with ties to even. Division by zero produces
/// infinity or NaN. It does not trap.
pub fn divide(left: f32, right: f32) -> f32 {
  return Intrinsic.f32Divide(left, right)
}

/// Returns `left - trunc(left / right) * right`. A zero `right`, infinite `left`, or NaN operand
/// produces NaN. It does not trap.
pub fn remainder(left: f32, right: f32) -> f32 {
  return Intrinsic.f32Remainder(left, right)
}

/// Returns `true` when both values compare equal. Returns `false` if either value is NaN.
pub fn equals(left: f32, right: f32) -> bool {
  return Intrinsic.f32Equals(left, right)
}

/// Returns `true` when values do not compare equal, including when either value is NaN.
pub fn notEquals(left: f32, right: f32) -> bool {
  return Intrinsic.f32NotEquals(left, right)
}

/// Returns `true` when `left` is less than `right`. Returns `false` if either value is NaN.
pub fn lessThan(left: f32, right: f32) -> bool {
  return Intrinsic.f32LessThan(&left, &right)
}

/// Returns `true` when `left` is less than or equal to `right`. Returns `false` for NaN.
pub fn lessOrEqual(left: f32, right: f32) -> bool {
  return Intrinsic.f32LessOrEqual(left, right)
}

/// Returns `true` when `left` is greater than `right`. Returns `false` if either value is NaN.
pub fn greaterThan(left: f32, right: f32) -> bool {
  return Intrinsic.f32GreaterThan(left, right)
}

/// Returns `true` when `left` is greater than or equal to `right`. Returns `false` for NaN.
pub fn greaterOrEqual(left: f32, right: f32) -> bool {
  return Intrinsic.f32GreaterOrEqual(left, right)
}

/// Returns `true` when `value` is a NaN.
pub fn isNaN(value: f32) -> bool {
  return Intrinsic.f32IsNaN(value)
}

/// Returns `true` when `value` is positive or negative infinity.
pub fn isInfinite(value: f32) -> bool {
  return Intrinsic.f32IsInfinite(value)
}

/// Returns `true` when `value` is neither infinity nor NaN.
pub fn isFinite(value: f32) -> bool {
  return Intrinsic.f32IsFinite(value)
}

/// Returns `true` when `value` is finite, nonzero, and not subnormal.
pub fn isNormal(value: f32) -> bool {
  return Intrinsic.f32IsNormal(value)
}

/// Returns `true` when `value` is finite and has subnormal magnitude.
pub fn isSubnormal(value: f32) -> bool {
  return Intrinsic.f32IsSubnormal(value)
}

/// Returns `true` when the sign bit of `value` is set, including for zero and NaN.
pub fn isSignNegative(value: f32) -> bool {
  return Intrinsic.f32IsSignNegative(value)
}

/// Reports whether `left` precedes or equals `right` in the IEEE total order.
///
/// # When to use
///
/// Use this function for deterministic ordering that includes NaNs and distinguishes signed zero.
///
/// # Details
///
/// Unlike ordinary comparison, this order distinguishes negative and positive zero and provides a
/// deterministic position for NaN encodings.
///
/// The order is: negative NaNs, negative infinity, the negative numbers, `-0.0`, `+0.0`, the
/// positive numbers, positive infinity, then positive NaNs. The `Order` conformance of `f32`, which
/// sorting and binary search use, follows it.
pub fn totalOrder(left: f32, right: f32) -> bool {
  return Intrinsic.f32TotalOrder(left, right)
}

/// Reinterprets a value as its exact 32-bit IEEE representation.
///
/// # When to use
///
/// Use this function to inspect or preserve representation bits. It does not convert the number.
pub fn toBits(value: f32) -> u32 {
  return Intrinsic.f32ToBits(value)
}

/// Reinterprets an arbitrary 32-bit pattern as `f32` without numeric conversion.
///
/// # When to use
///
/// Use this function to construct a value from representation bits, including NaN and signed zero.
pub fn fromBits(value: u32) -> f32 {
  return Intrinsic.f32FromBits(value)
}

// One stable NaN result for source-defined operations whose public contract requires canonical
// bits across all execution engines.
fn canonicalNaN() -> f32 {
  return fromBits(2143289344)
}

/// Computes the correctly rounded square root and preserves either signed zero.
///
/// # Details
///
/// IEEE requires square root to be correctly rounded, so its native and WebAssembly instructions
/// have one admissible numeric result.
///
/// # Gotchas
///
/// NaN and negative nonzero inputs return the canonical quiet NaN. Negative zero is not treated as
/// negative and returns unchanged.
pub fn sqrt(value: f32) -> f32 {
  if Intrinsic.f32IsNaN(value) { return canonicalNaN() }
  // Negative zero compares equal to zero and so passes through to the primitive, which returns it
  // unchanged as IEEE-754 requires.
  if value < 0.0 { return canonicalNaN() }
  return Intrinsic.f32Sqrt(value)
}

/// Returns the magnitude of `value`, which clears the sign bit. A NaN input gives the canonical
/// NaN.
pub fn abs(value: f32) -> f32 {
  if Intrinsic.f32IsNaN(value) { return canonicalNaN() }
  return fromBits(u32.bitAnd(toBits(value), 2147483647))
}

/// Returns the magnitude of `magnitude` with the sign bit of `sign`. A NaN `magnitude` gives the
/// canonical NaN rather than a signed NaN.
pub fn copysign(magnitude: f32, sign: f32) -> f32 {
  if Intrinsic.f32IsNaN(magnitude) { return canonicalNaN() }
  let carried = u32.bitAnd(toBits(magnitude), 2147483647)
  let transferred = u32.bitAnd(toBits(sign), 2147483648)
  return fromBits(u32.bitOr(carried, transferred))
}

/// Rounds toward zero while preserving the sign of a zero result.
///
/// # Details
///
/// A value in `(-1.0, -0.0]` becomes negative zero. A NaN becomes the canonical quiet NaN, while
/// either infinity is already integral and returns unchanged.
pub fn trunc(value: f32) -> f32 {
  if Intrinsic.f32IsNaN(value) { return canonicalNaN() }
  let bits = toBits(value)
  let biased = u32.bitAnd(u32.shiftRight(bits, 23), 255)
  // Below 1.0 nothing integral survives, so only the sign is kept.
  if biased < 127 { return fromBits(u32.bitAnd(bits, 2147483648)) }
  // At or past 2^23 every representable value is already an integer, infinities included.
  if biased >= 150 { return value }
  let discarded = u32.subtract(150, biased)
  let kept = u32.bitNot(u32.shiftLeft(1, discarded) - 1)
  return fromBits(u32.bitAnd(bits, kept))
}

/// Returns the largest integral `f32` that is not greater than `value`. A NaN input gives the
/// canonical NaN.
pub fn floor(value: f32) -> f32 {
  if Intrinsic.f32IsNaN(value) { return canonicalNaN() }
  let truncated = trunc(value)
  // Only a negative non-integral value truncates upward, and it is always below 2^23, so the
  // subtraction is exact.
  if truncated > value { return truncated - 1.0 }
  return truncated
}

/// Returns the smallest integral `f32` that is not less than `value`. A NaN input gives the
/// canonical NaN.
pub fn ceil(value: f32) -> f32 {
  if Intrinsic.f32IsNaN(value) { return canonicalNaN() }
  let truncated = trunc(value)
  if truncated < value { return truncated + 1.0 }
  return truncated
}

/// Rounds to the nearest integral f32, with a half rounded away from zero.
///
/// # Details
///
/// This differs from the ties-to-even policy used by basic arithmetic. A zero result keeps its
/// input sign, and a NaN becomes the canonical quiet NaN.
pub fn round(value: f32) -> f32 {
  if Intrinsic.f32IsNaN(value) { return canonicalNaN() }
  let truncated = trunc(value)
  // Exact: below 2^23 the difference is representable, and at or past it the fraction is zero.
  // An infinity leaves a NaN here, whose comparison is false, so the truncated infinity stands.
  let fraction = value - truncated
  if abs(fraction) < 0.5 { return truncated }
  return truncated + copysign(1.0, value)
}

/// Returns the lesser value and orders negative zero below positive zero. If an operand is NaN,
/// returns the canonical NaN.
pub fn min(left: f32, right: f32) -> f32 {
  // Ordered operands take one comparison (#2566); the NaN and zero tests run only when neither
  // is less than the other.
  if left < right { return left }
  if right < left { return right }
  // Equal operands differ at most in a zero's sign, and or-ing their bits keeps the negative one.
  if left == right { return fromBits(u32.bitOr(toBits(left), toBits(right))) }
  return canonicalNaN()
}

/// Returns the greater value and orders positive zero above negative zero. If an operand is NaN,
/// returns the canonical NaN.
pub fn max(left: f32, right: f32) -> f32 {
  if left > right { return left }
  if right > left { return right }
  // And-ing equal operands' bits keeps the positive zero.
  if left == right { return fromBits(u32.bitAnd(toBits(left), toBits(right))) }
  return canonicalNaN()
}

/// Approximates sine within four units in the last place using deterministic result bits.
///
/// # Details
///
/// NaN and either infinity return the canonical quiet NaN. Either signed zero returns unchanged.
pub fn sin(value: f32) -> f32 {
  return Intrinsic.f32Sin(value)
}

/// Approximates cosine within four units in the last place using deterministic result bits.
///
/// # Details
///
/// NaN and either infinity return the canonical quiet NaN. Either signed zero returns positive one.
pub fn cos(value: f32) -> f32 {
  return Intrinsic.f32Cos(value)
}

// The functions from `tan` through `hypot` evaluate the binary64 algorithm and round its result
// once to binary32, which keeps the error within one unit in the last place.

/// Approximates tangent within one unit in the last place using deterministic result bits.
///
/// # Details
///
/// The tangent is computed in binary64 and rounded once to binary32, so the result stays accurate
/// for every finite input, including the largest. NaN and either infinity return the canonical
/// quiet NaN. Either signed zero returns unchanged.
pub fn tan(value: f32) -> f32 {
  return narrow(f64.tan(toF64(value)))
}

/// Approximates arctangent within one unit in the last place using deterministic result bits.
///
/// # Details
///
/// The result is in `[-pi/2, pi/2]`. NaN returns the canonical quiet NaN, either signed zero
/// returns unchanged, and an infinity returns pi/2 with its sign.
pub fn atan(value: f32) -> f32 {
  return narrow(f64.atan(toF64(value)))
}

/// Approximates the angle of the point `(x, y)` from the positive x axis within one unit in the
/// last place using deterministic result bits.
///
/// # When to use
///
/// Use this function instead of `atan(y / x)` to get the angle of a vector in every quadrant,
/// including when `x` is zero.
///
/// # Details
///
/// The result is in `[-pi, pi]` and takes the sign of `y`, including a signed zero `y`. A zero
/// `y` returns itself when `x` is positive or `+0.0`, and pi with the sign of `y` when `x` is
/// negative or `-0.0`. A zero `x` with nonzero `y` gives pi/2 with the sign of `y`. Two
/// infinities give an odd multiple of pi/4. A NaN in either operand returns the canonical quiet
/// NaN.
pub fn atan2(y: f32, x: f32) -> f32 {
  return narrow(f64.atan2(toF64(y), toF64(x)))
}

/// Approximates arcsine within one unit in the last place using deterministic result bits.
///
/// # Details
///
/// The result is in `[-pi/2, pi/2]`. Either signed zero returns unchanged. NaN and any argument
/// outside `[-1, 1]` return the canonical quiet NaN.
pub fn asin(value: f32) -> f32 {
  return narrow(f64.asin(toF64(value)))
}

/// Approximates arccosine within one unit in the last place using deterministic result bits.
///
/// # Details
///
/// The result is in `[0, pi]`. One returns positive zero. NaN and any argument outside `[-1, 1]`
/// return the canonical quiet NaN.
pub fn acos(value: f32) -> f32 {
  return narrow(f64.acos(toF64(value)))
}

/// Approximates `e` raised to `value` within one unit in the last place using deterministic result
/// bits.
///
/// # Details
///
/// A result too large for `f32` is positive infinity, and one too small is positive zero.
/// Negative infinity returns positive zero, positive infinity returns itself, and NaN returns the
/// canonical quiet NaN. Either signed zero returns one.
pub fn exp(value: f32) -> f32 {
  return narrow(f64.exp(toF64(value)))
}

/// Approximates the natural logarithm within one unit in the last place using deterministic result
/// bits.
///
/// # Details
///
/// Either signed zero returns negative infinity, and one returns positive zero. Positive infinity
/// returns itself. NaN and any negative argument return the canonical quiet NaN.
pub fn log(value: f32) -> f32 {
  return narrow(f64.log(toF64(value)))
}

/// Approximates `base` raised to `exponent` within one unit in the last place using deterministic
/// result bits.
///
/// # Details
///
/// A negative `base` has a real power only for an integer `exponent`, and an odd integer gives a
/// negative result. A result too large for `f32` is an infinity, and one too small is a zero, each
/// with that sign.
///
/// # Gotchas
///
/// The special cases follow IEEE-754 `pow`:
///
/// - A zero `exponent` returns one for every `base`, NaN included, and a `base` of one returns one
///   for every `exponent`, NaN included.
/// - A `base` of negative one with an infinite `exponent` returns one.
/// - A zero `base` with a negative `exponent` returns an infinity, negative only for `-0.0` with an
///   odd integer `exponent`. With a positive `exponent` it returns a zero signed the same way.
/// - With an infinite `exponent`, a `base` whose magnitude is below one gives positive zero for
///   positive infinity and positive infinity for negative infinity. A magnitude above one gives the
///   reverse.
/// - A negative finite `base` with a finite non-integer `exponent`, and any other NaN operand,
///   returns the canonical quiet NaN.
pub fn pow(base: f32, exponent: f32) -> f32 {
  return narrow(f64.pow(toF64(base), toF64(exponent)))
}

/// Approximates the real cube root within one unit in the last place using deterministic result
/// bits.
///
/// # Details
///
/// The result has the sign of `value`, so a negative argument has a negative root. Either signed
/// zero and either infinity return unchanged. NaN returns the canonical quiet NaN.
pub fn cbrt(value: f32) -> f32 {
  return narrow(f64.cbrt(toF64(value)))
}

/// Approximates `sqrt(x * x + y * y)` within one unit in the last place using deterministic
/// result bits, without intermediate overflow or underflow.
///
/// # When to use
///
/// Use this function for the length of a vector or the distance between two points. It stays
/// accurate where squaring an operand would overflow to infinity or underflow to zero.
///
/// # Details
///
/// The result is never negative, and the signs of the operands do not matter. An infinite
/// operand returns positive infinity even when the other is NaN. Otherwise a NaN operand returns
/// the canonical quiet NaN.
pub fn hypot(x: f32, y: f32) -> f32 {
  return narrow(f64.hypot(toF64(x), toF64(y)))
}

/// Computes `left * right + addend` with a single rounding, as the IEEE-754 fused multiply-add.
///
/// # When to use
///
/// Use this function for exact dot products, polynomial evaluation, and error terms, where
/// rounding the product separately loses the low half that the addend should cancel.
///
/// # Details
///
/// The result is correctly rounded on every target, so it has one admissible value. Targets with a
/// fused multiply-add instruction, AArch64 and x86-64 with the `fma` CPU feature, compute it with
/// that instruction. Other targets, WebAssembly included, compute it with binary64 arithmetic.
///
/// # Gotchas
///
/// A NaN operand, or an infinite product with a zero operand or an infinite addend of the other
/// sign, returns the canonical quiet NaN.
pub fn fma(left: f32, right: f32, addend: f32) -> f32 {
  static if Target.hasCpuFeature("fma") || Target.hasCpuFeature("fp-armv8") {
    let lanes = Intrinsic.simdMulAdd<simd<f32, 4>>(Intrinsic.simdSplat<simd<f32, 4>>(left),
      Intrinsic.simdSplat<simd<f32, 4>>(right), Intrinsic.simdSplat<simd<f32, 4>>(addend))
    let result = Intrinsic.simdExtract<simd<f32, 4>>(lanes, 0)
    if Intrinsic.f32IsNaN(result) { return canonicalNaN() }
    return result
  } else {
    // The binary64 product is exact, so only the sum rounds. Rounding that sum to odd, by moving an
    // even inexact result one unit toward the exact value, leaves the final rounding to binary32
    // as the only one that decides the result.
    let product = toF64(left) * toF64(right)
    let wideAddend = toF64(addend)
    let sum = product + wideAddend
    let addendPart = sum - product
    let error = (product - (sum - addendPart)) + (wideAddend - addendPart)
    let bits = f64.toBits(sum)
    if Intrinsic.f64IsFinite(sum) && error != 0.0 && u64.bitAnd(bits, 1) == 0 {
      if (error > 0.0) == (sum > 0.0) { return narrow(f64.fromBits(bits + 1)) }
      return narrow(f64.fromBits(bits - 1))
    }
    return narrow(sum)
  }
}

// Rounds a binary64 result to binary32, with the canonical NaN for every NaN.
fn narrow(value: f64) -> f32 {
  if Intrinsic.f64IsNaN(value) { return canonicalNaN() }
  return Intrinsic.f64ToF32(value)
}

/// Returns the same binary32 value unchanged.
pub fn toF32(value: f32) -> f32 {
  return Intrinsic.f32ToF32(value)
}

/// Converts binary32 to the exactly equivalent `f64` value.
pub fn toF64(value: f32) -> f64 {
  return Intrinsic.f32ToF64(value)
}

/// Converts `value` toward zero to `u8`. Traps for NaN, infinity, or a result
/// outside the `u8` range.
pub fn toU8(value: f32) -> u8 {
  if let Option<u8>.Some {value: converted} = checkedToU8(value) { return converted }
  return Intrinsic.trap("f32.toU8: the value is NaN, infinite, or outside the u8 range")
}

// The pointer-width conversion bounds, as exact powers of two in binary32. They are
// selected from the target's pointer width rather than converted from `usize.MAX`/`isize.MAX`,
// which would round outward and admit an overflowing value.
fn usizeBound() -> f32 {
  if pointerBits == 32 { return 4294967296.0 }
  return 18446744073709551616.0
}

fn isizeUpperBound() -> f32 {
  if pointerBits == 32 { return 2147483648.0 }
  return 9223372036854775808.0
}

// The largest f32 below the `isize` range's truncated lower end, the exclusive lower bound
// of the conversion test: one below `isize.MIN` when that is exact, else the next f32 below it.
fn isizeLowerBound() -> f32 {
  if pointerBits == 32 { return -2147483904.0 }
  return -9223373136366403584.0
}

/// Converts `value` toward zero to `u8`, or returns `None` when the truncated result is out of
/// range.
///
/// # When to use
///
/// Use this function when a NaN, an infinity, or an out-of-range magnitude is input data rather
/// than a program error. [`toU8`] traps on exactly the inputs this function reports as `None`.
///
/// # Details
///
/// The fraction is discarded first, so the range test applies to the truncated value: a magnitude
/// below one is in range and yields zero. The truncated value is accepted when it is at least zero
/// and below `2^8`. Both bounds are powers of two and so are exact in binary32. A bound converted
/// from `u8.MAX` would round outward and wrongly admit an overflowing value.
///
/// # Gotchas
///
/// NaN and either infinity return `None`. A value in `(-1.0, -0.0]` truncates to negative zero and
/// converts to `0`, so its sign is discarded rather than rejected.
pub fn checkedToU8(value: f32) -> Option<u8> {
  // The hardware conversion truncates, so the range test runs on `value` itself with the lower
  // bound widened to the float below the truncated range. NaN and both infinities fail it.
  if !(value > -1.0 && value < 256.0) { return Option<u8>.none() }
  return Option<u8>.some(Intrinsic.f32ToU8(value))
}

/// Converts `value` toward zero to `u16`. Traps for NaN, infinity, or a result
/// outside the `u16` range.
pub fn toU16(value: f32) -> u16 {
  if let Option<u16>.Some {value: converted} = checkedToU16(value) { return converted }
  return Intrinsic.trap("f32.toU16: the value is NaN, infinite, or outside the u16 range")
}

/// Converts `value` toward zero to `u16`, or returns `None` when the truncated result is out of
/// range.
///
/// # When to use
///
/// Use this function when a NaN, an infinity, or an out-of-range magnitude is input data rather
/// than a program error. [`toU16`] traps on exactly the inputs this function reports as `None`.
///
/// # Details
///
/// The fraction is discarded first, so the range test applies to the truncated value: a magnitude
/// below one is in range and yields zero. The truncated value is accepted when it is at least zero
/// and below `2^16`. Both bounds are powers of two and so are exact in binary32. A bound converted
/// from `u16.MAX` would round outward and wrongly admit an overflowing value.
///
/// # Gotchas
///
/// NaN and either infinity return `None`. A value in `(-1.0, -0.0]` truncates to negative zero and
/// converts to `0`, so its sign is discarded rather than rejected.
pub fn checkedToU16(value: f32) -> Option<u16> {
  // The hardware conversion truncates, so the range test runs on `value` itself with the lower
  // bound widened to the float below the truncated range. NaN and both infinities fail it.
  if !(value > -1.0 && value < 65536.0) { return Option<u16>.none() }
  return Option<u16>.some(Intrinsic.f32ToU16(value))
}

/// Converts `value` toward zero to `u32`. Traps for NaN, infinity, or a result
/// outside the `u32` range.
pub fn toU32(value: f32) -> u32 {
  if let Option<u32>.Some {value: converted} = checkedToU32(value) { return converted }
  return Intrinsic.trap("f32.toU32: the value is NaN, infinite, or outside the u32 range")
}

/// Converts `value` toward zero to `u32`, or returns `None` when the truncated result is out of
/// range.
///
/// # When to use
///
/// Use this function when a NaN, an infinity, or an out-of-range magnitude is input data rather
/// than a program error. [`toU32`] traps on exactly the inputs this function reports as `None`.
///
/// # Details
///
/// The fraction is discarded first, so the range test applies to the truncated value: a magnitude
/// below one is in range and yields zero. The truncated value is accepted when it is at least zero
/// and below `2^32`. Both bounds are powers of two and so are exact in binary32. A bound converted
/// from `u32.MAX` would round outward and wrongly admit an overflowing value.
///
/// # Gotchas
///
/// NaN and either infinity return `None`. A value in `(-1.0, -0.0]` truncates to negative zero and
/// converts to `0`, so its sign is discarded rather than rejected.
pub fn checkedToU32(value: f32) -> Option<u32> {
  // The hardware conversion truncates, so the range test runs on `value` itself with the lower
  // bound widened to the float below the truncated range. NaN and both infinities fail it.
  if !(value > -1.0 && value < 4294967296.0) { return Option<u32>.none() }
  return Option<u32>.some(Intrinsic.f32ToU32(value))
}

/// Converts `value` toward zero to `u64`. Traps for NaN, infinity, or a result
/// outside the `u64` range.
pub fn toU64(value: f32) -> u64 {
  if let Option<u64>.Some {value: converted} = checkedToU64(value) { return converted }
  return Intrinsic.trap("f32.toU64: the value is NaN, infinite, or outside the u64 range")
}

/// Converts `value` toward zero to `u64`, or returns `None` when the truncated result is out of
/// range.
///
/// # When to use
///
/// Use this function when a NaN, an infinity, or an out-of-range magnitude is input data rather
/// than a program error. [`toU64`] traps on exactly the inputs this function reports as `None`.
///
/// # Details
///
/// The fraction is discarded first, so the range test applies to the truncated value: a magnitude
/// below one is in range and yields zero. The truncated value is accepted when it is at least zero
/// and below `2^64`. Both bounds are powers of two and so are exact in binary32. A bound converted
/// from `u64.MAX` would round outward and wrongly admit an overflowing value.
///
/// # Gotchas
///
/// NaN and either infinity return `None`. A value in `(-1.0, -0.0]` truncates to negative zero and
/// converts to `0`, so its sign is discarded rather than rejected.
pub fn checkedToU64(value: f32) -> Option<u64> {
  // The hardware conversion truncates, so the range test runs on `value` itself with the lower
  // bound widened to the float below the truncated range. NaN and both infinities fail it.
  if !(value > -1.0 && value < 18446744073709551616.0) { return Option<u64>.none() }
  return Option<u64>.some(Intrinsic.f32ToU64(value))
}

/// Converts `value` toward zero to `usize`. Traps for NaN, infinity, or a result
/// outside the `usize` range.
pub fn toUsize(value: f32) -> usize {
  if let Option<usize>.Some {value: converted} = checkedToUsize(value) { return converted }
  return Intrinsic.trap("f32.toUsize: the value is NaN, infinite, or outside the usize range")
}

/// Converts `value` toward zero to `usize`, or returns `None` when the truncated result is out of
/// range.
///
/// # When to use
///
/// Use this function when a NaN, an infinity, or an out-of-range magnitude is input data rather
/// than a program error. [`toUsize`] traps on exactly the inputs this function reports as `None`.
///
/// # Details
///
/// The fraction is discarded first, so the range test applies to the truncated value: a magnitude
/// below one is in range and yields zero. `usize` follows the selected target's pointer width, so
/// the bounds follow it too. The truncated value is accepted when it is at least zero and below
/// `2^32` on a 32-bit target or `2^64` on a 64-bit one.
///
/// Every bound is a power of two and so is exact in binary32. A bound converted from `usize.MAX`
/// would round outward and wrongly admit an overflowing value, and a bound fixed at 64-bit width
/// would admit values that trap on a 32-bit target.
///
/// # Gotchas
///
/// NaN and either infinity return `None`. A value in `(-1.0, -0.0]` truncates to negative zero and
/// converts to `0`, so its sign is discarded rather than rejected.
pub fn checkedToUsize(value: f32) -> Option<usize> {
  // The hardware conversion truncates, so the range test runs on `value` itself with the lower
  // bound widened to the float below the truncated range. NaN and both infinities fail it.
  if !(value > -1.0 && value < usizeBound()) { return Option<usize>.none() }
  return Option<usize>.some(Intrinsic.f32ToUsize(value))
}

