//! Pointer-width signed integers for offsets whose range follows the selected compilation target.
//!
//! # When to use
//! Use `isize` for offsets paired with target-sized counts or addresses. Use a fixed-width integer
//! for files, protocols, persistent data, or any value that must mean the same thing on 32-bit and
//! 64-bit targets.
//!
//! # Details
//! Each arithmetic operation has four forms with different overflow rules:
//!
//! - The plain form, such as [`add`], traps on overflow. Use it when overflow is a program error.
//! - The `checked` form, such as [`checkedAdd`], returns `None` on overflow. Use it when input data
//!   controls the operands.
//! - The `wrapping` form, such as [`wrappingAdd`], computes the result modulo two to the power of
//!   [`BITS`].
//! - The `saturating` form, such as [`saturatingAdd`], returns [`MIN`] or [`MAX`] on overflow.
//!
//! Division and remainder by zero trap, and so does [`MIN`] divided by `-1`. [`checkedDivide`] and
//! [`checkedRemainder`] return `None` for these inputs. The shift count must be in the range 0 to
//! `BITS - 1`. Otherwise, the program traps. A rotate reduces its count modulo [`BITS`], so each
//! count is valid. A signed right shift copies the sign bit into the new high bits.
//!
//! A `to` conversion, such as `toU8`, traps if the value is out of the range of the destination
//! type. A `checkedTo` conversion returns `None` instead. Conversion to `f32` or `f64` rounds to
//! the nearest value if the integer has more significant bits than the float.
//!
//! A `wrappingTo` conversion, such as `wrappingToI16`, never traps. It keeps the low bits of the
//! two's complement form of the value, like a cast in C or Rust, so it truncates, sign-extends, or
//! reinterprets bits.
//!
//! [`countOnes`], [`leadingZeros`], and [`trailingZeros`] count the bits of the value in its two's
//! complement form. For zero, both zero counts return [`BITS`].
//!
//! [`BITS`], [`MIN`], and [`MAX`] depend on the target: 32 bits on `wasm32` and 64 bits on the
//! other targets.
//!
//! [`parse`] reads decimal text. A leading `-` is valid, and a leading `+` is not valid. To write a
//! value as text, use `silk.text.format.Format.display` or `Format.displayWith` with a `Writer`. Neither
//! needs an `Allocator`.
//!
//! # Gotchas
//! Code that succeeds at a 64-bit boundary can fail or trap when compiled for a 32-bit target.
//! [`MIN`] also has no positive counterpart. Use [`checkedDivide`] when division by `-1` can
//! receive that value.
//!
//! # Examples
//! ## Clamp an offset at the target boundary
//! ```silk
//! import silk.num.isize
//!
//! pub fn main() -> i32 {
//!   if isize.saturatingAdd(isize.MAX, 1) != isize.MAX {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! ## Parse decimal text and reject invalid text
//! ```silk
//! import silk.text.format { ParseError }
//! import silk.core.result { Result }
//! import silk.num.isize
//!
//! pub fn main() -> i32 {
//!   let parsed = isize.parse("42") |> Result<isize, ParseError>.unwrapOr(0)
//!   let invalid = isize.parse("4x2") |> Result<isize, ParseError>.unwrapOr(0)
//!   if parsed != 42 || invalid != 0 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Numbers

import silk.core.bool
import silk.num.f32
import silk.num.f64
import silk.text.format { Format, ParseError }
import silk.num.i16
import silk.num.i32
import silk.num.i64
import silk.num.i8
import silk.core.option { Option }
import silk.core.result { Result }
import silk.core.target { pointerBits, isizeMax, isizeMin }
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.u8
import silk.num.usize

/// The largest `isize` value for the compilation target.
///
/// # Details
///
/// This is 2147483647 on a 32-bit target and 9223372036854775807 on a 64-bit target. Checked
/// arithmetic rejects results above it.
pub const MAX: isize = isizeMax

/// The smallest `isize` value for the compilation target.
///
/// # Details
///
/// This is -2147483648 on a 32-bit target and -9223372036854775808 on a 64-bit target.
pub const MIN: isize = isizeMin

/// The width of `isize` in bits, which is the compilation target's pointer width.
pub const BITS: u32 = pointerBits

/// Returns the arithmetic negation of `value` and traps when `value` is [`MIN`]. Use
/// this function when that boundary is a program error.
pub fn negate(value: isize) -> isize {
  return Intrinsic.isizeNegate(value)
}

/// Returns the arithmetic negation of `value`, wrapped to the `isize` range. [`MIN`]
/// stays [`MIN`]. Use this function for deliberate modulo arithmetic.
pub fn wrappingNegate(value: isize) -> isize {
  return Intrinsic.isizeWrappingNegate(value)
}

/// Returns the arithmetic negation of `value`, clamped to the `isize` range. [`MIN`]
/// becomes [`MAX`]. Use this function when the positive boundary is required.
pub fn saturatingNegate(value: isize) -> isize {
  return Intrinsic.isizeSaturatingNegate(value)
}

/// Converts `value` to `u8`. Traps if `value` is outside the `u8` range. Use
/// this function when an out-of-range value is a program error.
@inlineAlways
pub fn toU8(value: isize) -> u8 {
  if let Option<u8>.Some {value: converted} = checkedToU8(value) { return converted }
  return Intrinsic.trap("isize.toU8: the value is outside the u8 range")
}

/// Converts `value` to `u8`, or returns `None` if `value` is outside the `u8`
/// range. Use this function when an out-of-range value is input data.
pub fn checkedToU8(value: isize) -> Option<u8> {
  return Intrinsic.isizeCheckedToU8<Option<u8>>(value, Option.some, Option.none)
}

