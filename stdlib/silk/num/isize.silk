/// Converts `value` to `i32`. Traps if `value` is outside the `i32` range. Use
/// this function when an out-of-range value is a program error.
@inlineAlways
pub fn toI32(value: isize) -> i32 {
  if let Option<i32>.Some {value: converted} = checkedToI32(value) { return converted }
  return Intrinsic.trap("isize.toI32: the value is outside the i32 range")
}

/// Converts `value` to `i32`, or returns `None` if `value` is outside the `i32`
/// range. Use this function when an out-of-range value is input data.
pub fn checkedToI32(value: isize) -> Option<i32> {
  return Intrinsic.isizeCheckedToI32<Option<i32>>(value, Option.some, Option.none)
}

/// Converts `value` exactly to `i64`. Every `isize` value is representable.
@inlineAlways
pub fn toI64(value: isize) -> i64 {
  if let Option<i64>.Some {value: converted} = checkedToI64(value) { return converted }
  return Intrinsic.trap("isize.toI64: the value is outside the i64 range")
}

/// Converts `value` exactly to `i64` and returns `Some`. Every `isize` value is
/// representable.
pub fn checkedToI64(value: isize) -> Option<i64> {
  return Intrinsic.isizeCheckedToI64<Option<i64>>(value, Option.some, Option.none)
}

/// Returns `value` unchanged as `isize`. Use this function when generic conversion code
/// can select `isize` as both source and destination.
pub fn toIsize(value: isize) -> isize {
  return Intrinsic.isizeToIsize(value)
}

/// Returns `Some` with `value` unchanged as `isize`. Use this function when generic
/// checked-conversion code can select the same source and destination type.
pub fn checkedToIsize(value: isize) -> Option<isize> {
  return Intrinsic.isizeCheckedToIsize<Option<isize>>(value, Option.some, Option.none)
}

/// Converts `value` to the nearest `f32` value, with ties to even. Only magnitudes below `2^24` are
/// exactly representable, so a larger `isize` rounds.
pub fn toF32(value: isize) -> f32 {
  return Intrinsic.isizeToF32(value)
}

/// Converts `value` to the nearest `f64` value, with ties to even. Only magnitudes below `2^53` are
/// exactly representable, so a larger `isize` rounds. Every `isize` is exact on a 32-bit target.
pub fn toF64(value: isize) -> f64 {
  return Intrinsic.isizeToF64(value)
}

/// Converts `value` to `u8` modulo 2^8. Keeps the low 8 bits of the two's complement
/// form of `value` and reads them as `u8`, so it never traps. Use this function for deliberate
/// truncation, sign extension, or bit reinterpretation, such as reading a signed field.
pub fn wrappingToU8(value: isize) -> u8 {
  return u64.wrappingToU8(wrappingToU64(value))
}

/// Converts `value` to `u16` modulo 2^16. Keeps the low 16 bits of the two's complement
/// form of `value` and reads them as `u16`, so it never traps. Use this function for deliberate
/// truncation, sign extension, or bit reinterpretation, such as reading a signed field.
pub fn wrappingToU16(value: isize) -> u16 {
  return u64.wrappingToU16(wrappingToU64(value))
}

/// Converts `value` to `u32` modulo 2^32. Keeps the low 32 bits of the two's complement
/// form of `value` and reads them as `u32`, so it never traps. Use this function for deliberate
/// truncation, sign extension, or bit reinterpretation, such as reading a signed field.
pub fn wrappingToU32(value: isize) -> u32 {
  return u64.wrappingToU32(wrappingToU64(value))
}

/// Converts `value` to `u64` modulo 2^64. Keeps the low 64 bits of the two's complement
/// form of `value` and reads them as `u64`, so it never traps. Use this function for deliberate
/// truncation, sign extension, or bit reinterpretation, such as reading a signed field.
pub fn wrappingToU64(value: isize) -> u64 {
  if value >= 0 { return toU64(value) }
  return u64.bitNot(toU64(negate(value + 1)))
}

/// Converts `value` to `usize` modulo 2^`usize.BITS`. Keeps the low `usize.BITS` bits of the two's
/// complement form of `value` and reads them as `usize`, so it never traps. Use this function for
/// deliberate truncation, sign extension, or bit reinterpretation, such as reading a signed field.
pub fn wrappingToUsize(value: isize) -> usize {
  return u64.wrappingToUsize(wrappingToU64(value))
}

/// Converts `value` to `i8` modulo 2^8. Keeps the low 8 bits of the two's complement
/// form of `value` and reads them as `i8`, so it never traps. Use this function for deliberate
/// truncation, sign extension, or bit reinterpretation, such as reading a signed field.
pub fn wrappingToI8(value: isize) -> i8 {
  return u64.wrappingToI8(wrappingToU64(value))
}

/// Converts `value` to `i16` modulo 2^16. Keeps the low 16 bits of the two's complement
/// form of `value` and reads them as `i16`, so it never traps. Use this function for deliberate
/// truncation, sign extension, or bit reinterpretation, such as reading a signed field.
pub fn wrappingToI16(value: isize) -> i16 {
  return u64.wrappingToI16(wrappingToU64(value))
}

/// Converts `value` to `i32` modulo 2^32. Keeps the low 32 bits of the two's complement
/// form of `value` and reads them as `i32`, so it never traps. Use this function for deliberate
/// truncation, sign extension, or bit reinterpretation, such as reading a signed field.
pub fn wrappingToI32(value: isize) -> i32 {
  return u64.wrappingToI32(wrappingToU64(value))
}

/// Converts `value` to `i64` modulo 2^64. Keeps the low 64 bits of the two's complement
/// form of `value` and reads them as `i64`, so it never traps. Use this function for deliberate
/// truncation, sign extension, or bit reinterpretation, such as reading a signed field.
pub fn wrappingToI64(value: isize) -> i64 {
  return u64.wrappingToI64(wrappingToU64(value))
}

/// Returns `value` unchanged. Use this function when generic wrapping-conversion code
/// can select `isize` as both source and destination.
pub fn wrappingToIsize(value: isize) -> isize {
  return value
}

/// Returns `left + right` and traps if the result is outside the `isize` range. Use this function
/// when overflow is a program error.
pub fn add(left: isize, right: isize) -> isize {
  return Intrinsic.isizeAdd(left, right)
}

/// Returns `left - right` and traps if the result is outside the `isize` range. Use this function
/// when overflow is a program error.
pub fn subtract(left: isize, right: isize) -> isize {
  return Intrinsic.isizeSubtract(left, right)
}

/// Returns `left * right` and traps if the result is outside the `isize` range. Use this function
/// when overflow is a program error.
pub fn multiply(left: isize, right: isize) -> isize {
  return Intrinsic.isizeMultiply(left, right)
}

/// Returns `left / right`, rounded toward zero. Traps if `right` is zero or [`MIN`] is
/// divided by `-1`. Use this function when an invalid quotient is a program error.
pub fn divide(left: isize, right: isize) -> isize {
  return Intrinsic.isizeDivide(left, right)
}

/// Returns the remainder with the sign of `left`. Traps if `right` is zero or [`MIN`] is
/// divided by `-1`. Use this function when invalid division is a program error.
pub fn remainder(left: isize, right: isize) -> isize {
  return Intrinsic.isizeRemainder(left, right)
}

/// Returns the bitwise AND of `left` and `right`.
pub fn bitAnd(left: isize, right: isize) -> isize {
  return Intrinsic.isizeBitAnd(left, right)
}

/// Returns the bitwise OR of `left` and `right`.
pub fn bitOr(left: isize, right: isize) -> isize {
  return Intrinsic.isizeBitOr(left, right)
}

/// Returns the bitwise exclusive OR of `left` and `right`.
pub fn bitXor(left: isize, right: isize) -> isize {
  return Intrinsic.isizeBitXor(left, right)
}

/// Returns `value` with each bit inverted.
pub fn bitNot(value: isize) -> isize {
  return Intrinsic.isizeBitNot(value)
}

/// Shifts `left` bits left by `right` positions. Traps if `right` is negative or not less than
/// [`BITS`].
pub fn shiftLeft(left: isize, right: isize) -> isize {
  return Intrinsic.isizeShiftLeft(left, right)
}

/// Shifts `left` bits right by `right` positions and preserves its sign. Traps if `right` is
/// negative or not less than [`BITS`].
pub fn shiftRight(left: isize, right: isize) -> isize {
  return Intrinsic.isizeShiftRight(left, right)
}

/// Rotates the bits of `left` left by `right` positions. The count is reduced modulo [`BITS`], so
/// each count is valid.
pub fn rotateLeft(left: isize, right: isize) -> isize {
  return Intrinsic.isizeRotateLeft(left, right)
}

/// Rotates the bits of `left` right by `right` positions. The count is reduced modulo [`BITS`], so
/// each count is valid.
pub fn rotateRight(left: isize, right: isize) -> isize {
  return Intrinsic.isizeRotateRight(left, right)
}

/// Returns the number of one bits in the two's complement form of `value`.
pub fn countOnes(value: isize) -> u32 {
  return usize.countOnes(wrappingToUsize(value))
}

/// Returns the number of zero bits above the highest one bit of the two's complement form of
/// `value`. Returns [`BITS`] for zero and 0 for a negative value.
pub fn leadingZeros(value: isize) -> u32 {
  return usize.leadingZeros(wrappingToUsize(value))
}

/// Returns the number of zero bits below the lowest one bit of `value`. Returns [`BITS`] for zero.
pub fn trailingZeros(value: isize) -> u32 {
  return usize.trailingZeros(wrappingToUsize(value))
}

/// Returns `left + right`, wrapped to the `isize` range. Use this function for
/// deliberate modulo arithmetic.
pub fn wrappingAdd(left: isize, right: isize) -> isize {
  return Intrinsic.isizeWrappingAdd(left, right)
}

/// Returns `left - right`, wrapped to the `isize` range. Use this function for
/// deliberate modulo arithmetic.
pub fn wrappingSubtract(left: isize, right: isize) -> isize {
  return Intrinsic.isizeWrappingSubtract(left, right)
}

/// Returns `left * right`, wrapped to the `isize` range. Use this function for
/// deliberate modulo arithmetic.
pub fn wrappingMultiply(left: isize, right: isize) -> isize {
  return Intrinsic.isizeWrappingMultiply(left, right)
}

/// Returns `left + right`, clamped to [`MIN`] or [`MAX`]. Use this function when a
/// boundary value is the required overflow result.
pub fn saturatingAdd(left: isize, right: isize) -> isize {
  return Intrinsic.isizeSaturatingAdd(left, right)
}

/// Returns `left - right`, clamped to [`MIN`] or [`MAX`]. Use this function when a
/// boundary value is the required overflow result.
pub fn saturatingSubtract(left: isize, right: isize) -> isize {
  return Intrinsic.isizeSaturatingSubtract(left, right)
}

/// Returns `left * right`, clamped to [`MIN`] or [`MAX`]. Use this function when a
/// boundary value is the required overflow result.
pub fn saturatingMultiply(left: isize, right: isize) -> isize {
  return Intrinsic.isizeSaturatingMultiply(left, right)
}

/// Returns the high half of the exact double-width product `left * right`. It never overflows.
///
/// # When to use
///
/// Use this function with [`wrappingMultiply`], which returns the low half, when an algorithm
/// needs the full product, such as multi-word arithmetic, multiply-shift hashing, or division by
/// a precomputed reciprocal.
///
/// # Details
///
/// The width is the target word: the high 64 bits of a 128-bit product on a 64-bit target, and
/// the high 32 bits of a 64-bit product on a 32-bit target.
///
/// The product is signed, so the high half carries its sign: `multiplyHigh(-1, 1)` is `-1`. The
/// full product is the high half times 2 to the power of the word width, plus the low half read
/// as unsigned bits.
pub fn multiplyHigh(left: isize, right: isize) -> isize {
  return Intrinsic.isizeMultiplyHigh(left, right)
}

/// Returns `Some` with `left + right`, or `None` if the result is outside the `isize` range.
/// Use this function when overflow is input data.
pub fn checkedAdd(left: isize, right: isize) -> Option<isize> {
  return Intrinsic.isizeCheckedAdd<Option<isize>>(left, right, Option.some, Option.none)
}

/// Returns `Some` with `left - right`, or `None` if the result is outside the `isize` range.
/// Use this function when overflow is input data.
pub fn checkedSubtract(left: isize, right: isize) -> Option<isize> {
  return Intrinsic.isizeCheckedSubtract<Option<isize>>(left, right, Option.some, Option.none)
}

/// Returns `Some` with `left * right`, or `None` if the result is outside the `isize` range.
/// Use this function when overflow is input data.
pub fn checkedMultiply(left: isize, right: isize) -> Option<isize> {
  return Intrinsic.isizeCheckedMultiply<Option<isize>>(left, right, Option.some, Option.none)
}

/// Returns `Some` with `left / right`, or `None` if `right` is zero or [`MIN`] is
/// divided by `-1`. Use this function when an invalid quotient is input data.
pub fn checkedDivide(left: isize, right: isize) -> Option<isize> {
  return Intrinsic.isizeCheckedDivide<Option<isize>>(left, right, Option.some, Option.none)
}

/// Returns `Some` with the remainder, or `None` if `right` is zero or [`MIN`] is
/// divided by `-1`. Use this function when invalid division is input data.
pub fn checkedRemainder(left: isize, right: isize) -> Option<isize> {
  return Intrinsic.isizeCheckedRemainder<Option<isize>>(left, right, Option.some, Option.none)
}

/// Returns `true` if `left` and `right` are equal.
pub fn equals(left: isize, right: isize) -> bool {
  return Intrinsic.isizeEquals(left, right)
}

/// Returns `true` if `left` and `right` are not equal.
pub fn notEquals(left: isize, right: isize) -> bool {
  return Intrinsic.isizeNotEquals(left, right)
}

/// Returns `true` if `left` is less than `right`.
pub fn lessThan(left: isize, right: isize) -> bool {
  return Intrinsic.isizeLessThan(&left, &right)
}

/// Returns `true` if `left` is less than or equal to `right`.
pub fn lessOrEqual(left: isize, right: isize) -> bool {
  return Intrinsic.isizeLessOrEqual(left, right)
}

/// Returns `true` if `left` is greater than `right`.
pub fn greaterThan(left: isize, right: isize) -> bool {
  return Intrinsic.isizeGreaterThan(left, right)
}

/// Returns `true` if `left` is greater than or equal to `right`.
pub fn greaterOrEqual(left: isize, right: isize) -> bool {
  return Intrinsic.isizeGreaterOrEqual(left, right)
}

/// Returns the `isize` value of the decimal text `text`, or a `ParseError`.
///
/// # Details
///
/// The complete text must be one decimal number, with an optional leading `-`. This function does
/// not skip spaces and does not accept digit separators.
///
/// # Errors
///
/// - `ParseError` with reason `silk.text.format.NotANumber` if `text` is empty, starts with `+`,
///   contains a byte that is not a digit, or has bytes after the number. `offset` gives the byte
///   position where the read stopped.
/// - `ParseError` with reason `silk.text.format.OutOfRange` if the number is outside the range of
///   `isize` on the target.
pub fn parse(text: string) -> Result<isize, ParseError> {
  return Format.isizeValue(text)
}
