@inlineAlways
pub fn toU16(value: isize) -> u16 {
  if let Option<u16>.Some {value: converted} = checkedToU16(value) { return converted }
  return Intrinsic.trap("isize.toU16: the value is outside the u16 range")
}

/// Converts `value` to `u16`, or returns `None` if `value` is outside the `u16`
/// range. Use this function when an out-of-range value is input data.
pub fn checkedToU16(value: isize) -> Option<u16> {
  return Intrinsic.isizeCheckedToU16<Option<u16>>(value, Option.some, Option.none)
}

