//! Sixteen-bit signed integers with explicit overflow, conversion, and text policies.
//!
//! # When to use
//! Use `i16` for data whose public representation is exactly sixteen signed bits, such as a binary
//! field or compact sample. Use `i32` or `i64` when the range is not itself part of the contract.
//!
//! # Details
//! Each arithmetic operation has four forms with different overflow rules:
//!
//! - The plain form, such as [`add`], traps on overflow. Use it when overflow is a program error.
//! - The `checked` form, such as [`checkedAdd`], returns `None` on overflow. Use it when input data
//!   controls the operands.
//! - The `wrapping` form, such as [`wrappingAdd`], computes the result modulo 2^16.
//! - The `saturating` form, such as [`saturatingAdd`], returns [`MIN`] or [`MAX`] on overflow.
//!
//! Division and remainder by zero trap, and so does [`MIN`] divided by `-1`. [`checkedDivide`] and
//! [`checkedRemainder`] return `None` for these inputs. The shift count must be in the range 0 to
//! `BITS - 1`. Otherwise, the program traps. A rotate reduces its count modulo [`BITS`], so each
//! count is valid. A signed right shift copies the sign bit into the new high bits.
//!
//! A `to` conversion, such as `toU8`, traps if the value is out of the range of the destination
//! type. A `checkedTo` conversion returns `None` instead. Conversion to `f32` or `f64` is exact.
//!
//! A `wrappingTo` conversion, such as `wrappingToI16`, never traps. It keeps the low bits of the
//! two's complement form of the value, like a cast in C or Rust, so it truncates, sign-extends, or
//! reinterprets bits.
//!
//! [`countOnes`], [`leadingZeros`], and [`trailingZeros`] count the bits of the value in its two's
//! complement form. For zero, both zero counts return [`BITS`].
//!
//! [`parse`] reads decimal text. A leading `-` is valid, and a leading `+` is not valid. To write a
//! value as text, use `silk.format.Format.display` or `Format.displayWith` with a `Writer`. Neither
//! needs an `Allocator`.
//!
//! # Gotchas
//! [`MIN`] cannot be represented as a positive i16, so ordinary [`negate`] traps for that value.
//!
//! # Examples
//! ## Preserve the sign during a right shift
//! ```silk
//! import silk.num.i16
//!
//! pub fn main() -> i32 {
//!   let shifted = i16.shiftRight(-84, 1)
//!   let result = i16.toI32(i16.negate(shifted))
//!   if result != 42 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! ## Parse decimal text and reject invalid text
//! ```silk
//! import silk.format { ParseError }
//! import silk.core.result { Result }
//! import silk.num.i16
//!
//! pub fn main() -> i32 {
//!   let parsed = i16.parse("42") |> Result<i16, ParseError>.unwrapOr(0)
//!   let invalid = i16.parse("4x2") |> Result<i16, ParseError>.unwrapOr(0)
//!   if parsed != 42 || invalid != 0 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Numbers

import silk.core.bool
import silk.num.f32
import silk.num.f64
import silk.format { Format, ParseError }
import silk.num.i32
import silk.num.i64
import silk.num.i8
import silk.num.isize
import silk.option { Option }
import silk.core.result { Result }
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.u8
import silk.num.usize

/// The largest `i16` value.
pub const MAX: i16 = 32767

/// The smallest `i16` value.
pub const MIN: i16 = -32768

/// The fixed width of `i16`, in bits.
pub const BITS: u32 = 16

/// Returns the arithmetic negation of `value` and traps when `value` is [`MIN`]. Use
/// this function when that boundary is a program error.
pub fn negate(value: i16) -> i16 {
  return Intrinsic.i16Negate(value)
}

/// Returns the arithmetic negation of `value`, wrapped to the `i16` range. [`MIN`]
/// stays [`MIN`]. Use this function for deliberate modulo arithmetic.
pub fn wrappingNegate(value: i16) -> i16 {
  return Intrinsic.i16WrappingNegate(value)
}

/// Returns the arithmetic negation of `value`, clamped to the `i16` range. [`MIN`]
/// becomes [`MAX`]. Use this function when the positive boundary is required.
pub fn saturatingNegate(value: i16) -> i16 {
  return Intrinsic.i16SaturatingNegate(value)
}

/// Converts `value` to `u8`. Traps if `value` is outside the `u8` range. Use
/// this function when an out-of-range value is a program error.
pub fn toU8(value: i16) -> u8
with Intrinsic.inlineAlways() {
  if let Option<u8>.Some {value: converted} = checkedToU8(value) { return converted }
  return Intrinsic.trap("i16.toU8: the value is outside the u8 range")
}

/// Converts `value` to `u8`, or returns `None` if `value` is outside the `u8`
/// range. Use this function when an out-of-range value is input data.
pub fn checkedToU8(value: i16) -> Option<u8> {
  return Intrinsic.i16CheckedToU8<Option<u8>>(value, Option.some, Option.none)
}

/// Converts `value` to `u16`. Traps if `value` is outside the `u16` range. Use
/// this function when an out-of-range value is a program error.
pub fn toU16(value: i16) -> u16
with Intrinsic.inlineAlways() {
  if let Option<u16>.Some {value: converted} = checkedToU16(value) { return converted }
  return Intrinsic.trap("i16.toU16: the value is negative")
}

/// Converts `value` to `u16`, or returns `None` if `value` is outside the `u16`
/// range. Use this function when an out-of-range value is input data.
pub fn checkedToU16(value: i16) -> Option<u16> {
  return Intrinsic.i16CheckedToU16<Option<u16>>(value, Option.some, Option.none)
}

