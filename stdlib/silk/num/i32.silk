@inlineAlways
pub fn toU64(value: i32) -> u64 {
  if let Option<u64>.Some {value: converted} = checkedToU64(value) { return converted }
  return Intrinsic.trap("i32.toU64: the value is negative")
}

/// Converts `value` to `u64`, or returns `None` if `value` is outside the `u64`
/// range. Use this function when an out-of-range value is input data.
pub fn checkedToU64(value: i32) -> Option<u64> {
  return Intrinsic.i32CheckedToU64<Option<u64>>(value, Option.some, Option.none)
}

