//! Thirty-two-bit signed integers and the default type of context-free integer literals.
//!
//! # When to use
//! Use `i32` for ordinary signed whole-number calculations whose range is known to fit, and when a
//! stable 32-bit representation matters. Choose `isize` for pointer-sized offsets and `i64` for a
//! wider fixed range.
//!
//! # Details
//! Each arithmetic operation has four forms with different overflow rules:
//!
//! - The plain form, such as [`add`], traps on overflow. Use it when overflow is a program error.
//! - The `checked` form, such as [`checkedAdd`], returns `None` on overflow. Use it when input data
//!   controls the operands.
//! - The `wrapping` form, such as [`wrappingAdd`], computes the result modulo 2^32.
//! - The `saturating` form, such as [`saturatingAdd`], returns [`MIN`] or [`MAX`] on overflow.
//!
//! Division and remainder by zero trap, and so does [`MIN`] divided by `-1`. [`checkedDivide`] and
//! [`checkedRemainder`] return `None` for these inputs. The shift count must be in the range 0 to
//! `BITS - 1`. Otherwise, the program traps. A rotate reduces its count modulo [`BITS`], so each
//! count is valid. A signed right shift copies the sign bit into the new high bits.
//!
//! A `to` conversion, such as `toU8`, traps if the value is out of the range of the destination
//! type. A `checkedTo` conversion returns `None` instead. Conversion to `f32` or `f64` rounds to
//! the nearest value if the integer has more significant bits than the float.
//!
//! A `wrappingTo` conversion, such as `wrappingToI16`, never traps. It keeps the low bits of the
//! two's complement form of the value, like a cast in C or Rust, so it truncates, sign-extends, or
//! reinterprets bits.
//!
//! [`countOnes`], [`leadingZeros`], and [`trailingZeros`] count the bits of the value in its two's
//! complement form. For zero, both zero counts return [`BITS`].
//!
//! [`parse`] reads decimal text. A leading `-` is valid, and a leading `+` is not valid. To write a
//! value as text, use `silk.text.format.Format.display` or `Format.displayWith` with a `Writer`. Neither
//! needs an `Allocator`.
//!
//! # Gotchas
//! [`MIN`] has no positive i32 counterpart. Use [`wrappingNegate`] or [`saturatingNegate`] for its
//! negation boundary. Use [`checkedDivide`] when division by `-1` can receive [`MIN`].
//!
//! # Examples
//! ## Select an overflow result explicitly
//! ```silk
//! import silk.num.i32
//! import silk.core.option { Option }
//!
//! pub fn main() -> i32 {
//!   let checked = i32.checkedAdd(i32.MAX, 1)
//!   let recovered = move checked |> Option<i32>.unwrapOr(42)
//!   if i32.wrappingAdd(i32.MAX, 1) != i32.MIN {
//!     return 1
//!   }
//!   if i32.saturatingAdd(i32.MAX, 1) != i32.MAX {
//!     return 1
//!   }
//!   if recovered != 42 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! ## Parse decimal text and reject invalid text
//! ```silk
//! import silk.text.format { ParseError }
//! import silk.core.result { Result }
//! import silk.num.i32
//!
//! pub fn main() -> i32 {
//!   let parsed = i32.parse("42") |> Result<i32, ParseError>.unwrapOr(0)
//!   let invalid = i32.parse("4x2") |> Result<i32, ParseError>.unwrapOr(0)
//!   if parsed != 42 || invalid != 0 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Numbers

import silk.core.bool
import silk.num.f32
import silk.num.f64
import silk.text.format { Format, ParseError }
import silk.num.i16
import silk.num.i64
import silk.num.i8
import silk.num.isize
import silk.core.option { Option }
import silk.core.result { Result }
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.u8
import silk.num.usize

/// The largest `i32` value.
pub const MAX: i32 = 2147483647

/// The smallest `i32` value.
pub const MIN: i32 = -2147483648

/// The fixed width of `i32`, in bits.
pub const BITS: u32 = 32

/// Returns the arithmetic negation of `value` and traps when `value` is [`MIN`]. Use
/// this function when that boundary is a program error.
pub fn negate(value: i32) -> i32 {
  return Intrinsic.i32Negate(value)
}

/// Returns the arithmetic negation of `value`, wrapped to the `i32` range. [`MIN`]
/// stays [`MIN`]. Use this function for deliberate modulo arithmetic.
pub fn wrappingNegate(value: i32) -> i32 {
  return Intrinsic.i32WrappingNegate(value)
}

/// Returns the arithmetic negation of `value`, clamped to the `i32` range. [`MIN`]
/// becomes [`MAX`]. Use this function when the positive boundary is required.
pub fn saturatingNegate(value: i32) -> i32 {
  return Intrinsic.i32SaturatingNegate(value)
}

/// Converts `value` to `u8`. Traps if `value` is outside the `u8` range. Use
/// this function when an out-of-range value is a program error.
@inlineAlways
pub fn toU8(value: i32) -> u8 {
  if let Option<u8>.Some {value: converted} = checkedToU8(value) { return converted }
  return Intrinsic.trap("i32.toU8: the value is outside the u8 range")
}

/// Converts `value` to `u8`, or returns `None` if `value` is outside the `u8`
/// range. Use this function when an out-of-range value is input data.
pub fn checkedToU8(value: i32) -> Option<u8> {
  return Intrinsic.i32CheckedToU8<Option<u8>>(value, Option.some, Option.none)
}

/// Converts `value` to `u16`. Traps if `value` is outside the `u16` range. Use
/// this function when an out-of-range value is a program error.
@inlineAlways
pub fn toU16(value: i32) -> u16 {
  if let Option<u16>.Some {value: converted} = checkedToU16(value) { return converted }
  return Intrinsic.trap("i32.toU16: the value is outside the u16 range")
}

/// Converts `value` to `u16`, or returns `None` if `value` is outside the `u16`
/// range. Use this function when an out-of-range value is input data.
pub fn checkedToU16(value: i32) -> Option<u16> {
  return Intrinsic.i32CheckedToU16<Option<u16>>(value, Option.some, Option.none)
}

/// Converts `value` to `u32`. Traps if `value` is outside the `u32` range. Use
/// this function when an out-of-range value is a program error.
@inlineAlways
pub fn toU32(value: i32) -> u32 {
  if let Option<u32>.Some {value: converted} = checkedToU32(value) { return converted }
  return Intrinsic.trap("i32.toU32: the value is negative")
}

/// Converts `value` to `u32`, or returns `None` if `value` is outside the `u32`
/// range. Use this function when an out-of-range value is input data.
pub fn checkedToU32(value: i32) -> Option<u32> {
  return Intrinsic.i32CheckedToU32<Option<u32>>(value, Option.some, Option.none)
}

