//! IEEE binary64 values and Silk's default floating-point arithmetic.
//!
//! # When to use
//! Use `f64` for general floating-point calculations and literals without another numeric context.
//! Choose `f32` when binary32 storage or interchange is an explicit constraint, not merely as a
//! speculative optimization.
//!
//! # Details
//! Basic arithmetic rounds to nearest with ties to even and never enables implicit fast-math
//! assumptions. Division by zero and overflow produce IEEE infinities or NaNs rather than integer-
//! style traps. Ordinary ordered comparisons return false for NaN and treat both zeros as equal;
//! [`totalOrder`] distinguishes every encoding when deterministic ordering is required. The
//! `Order` conformance of `f64` uses the same total order, so `List<f64>.sort` puts negative NaNs
//! first, then `-0.0` before `+0.0`, and positive NaNs last.
//!
//! [`toBits`] and [`fromBits`] expose the exact binary64 representation, including signed zero and
//! NaN payloads. The source-defined rounding, extrema, sign, and square-root helpers canonicalize
//! NaN results so native and WebAssembly execution agree on their bits.
//!
//! The trigonometric, inverse trigonometric, exponential, logarithmic, power, cube root, [`hypot`],
//! and [`fma`] functions never call a host math library. Each states its error bound in units in
//! the last place, returns the same bits on every target, WebAssembly included, and gives the
//! canonical quiet NaN for every NaN result.
//!
//! # Gotchas
//! Converting to an integer discards the fractional part and traps for NaN, infinity, or a value
//! outside the destination range. The `checkedTo*` counterparts return `None` on exactly those
//! inputs instead of trapping. [`toF32`] can round a finite value or produce infinity.
//!
//! # Examples
//! ## Check floating-point boundaries without losing their representation
//! ```silk
//! import silk.num.f64
//!
//! pub fn main() -> i32 {
//!   if f64.toBits(f64.round(-0.25)) != f64.toBits(-0.0) {
//!     return 1
//!   }
//!   if !f64.isNaN(f64.sqrt(-1.0)) {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Numbers

import silk.core.bool
import silk.num.f32
import silk.num.i16
import silk.num.i32
import silk.num.i64
import silk.num.i8
import silk.num.isize
import silk.core.option { Option }
import silk.core.target { Target, pointerBits }
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.u8
import silk.num.usize

/// The largest finite `f64` value.
pub const MAX: f64 = 1.7976931348623157e308

/// The most negative finite `f64` value, which is the negation of [`MAX`].
pub const MIN: f64 = -1.7976931348623157e308

/// The distance from `1.0` to the next larger `f64` value.
pub const EPSILON: f64 = 2.220446049250313e-16

/// Positive infinity with the binary64 bit pattern `0x7FF0000000000000`.
///
/// # Details
///
/// No source literal spells infinity directly. This initializer deliberately exceeds [`MAX`], and
/// decimal-to-binary64 rounding produces the infinity encoding.
pub const INFINITY: f64 = 1e999

/// The ratio of a circle's circumference to its diameter, rounded to the nearest `f64` value.
pub const PI: f64 = 3.141592653589793

/// Euler's number, rounded to the nearest `f64` value.
pub const E: f64 = 2.718281828459045

/// Returns `value` with its sign reversed.
pub fn negate(value: f64) -> f64 {
  return Intrinsic.f64Negate(value)
}

/// Returns `left + right`, rounded to nearest with ties to even. Overflow produces infinity. It
/// does not trap.
pub fn add(left: f64, right: f64) -> f64 {
  return Intrinsic.f64Add(left, right)
}

/// Returns `left - right`, rounded to nearest with ties to even. Overflow produces infinity. It
/// does not trap.
pub fn subtract(left: f64, right: f64) -> f64 {
  return Intrinsic.f64Subtract(left, right)
}

/// Returns `left * right`, rounded to nearest with ties to even. Overflow produces infinity. It
/// does not trap.
pub fn multiply(left: f64, right: f64) -> f64 {
  return Intrinsic.f64Multiply(left, right)
}

/// Returns `left / right`, rounded to nearest with ties to even. Division by zero produces
/// infinity or NaN. It does not trap.
pub fn divide(left: f64, right: f64) -> f64 {
  return Intrinsic.f64Divide(left, right)
}

/// Returns `left - trunc(left / right) * right`. A zero `right`, infinite `left`, or NaN operand
/// produces NaN. It does not trap.
pub fn remainder(left: f64, right: f64) -> f64 {
  return Intrinsic.f64Remainder(left, right)
}

/// Returns `true` when both values compare equal. Returns `false` if either value is NaN.
pub fn equals(left: f64, right: f64) -> bool {
  return Intrinsic.f64Equals(left, right)
}

/// Returns `true` when values do not compare equal, including when either value is NaN.
pub fn notEquals(left: f64, right: f64) -> bool {
  return Intrinsic.f64NotEquals(left, right)
}

/// Returns `true` when `left` is less than `right`. Returns `false` if either value is NaN.
pub fn lessThan(left: f64, right: f64) -> bool {
  return Intrinsic.f64LessThan(&left, &right)
}

/// Returns `true` when `left` is less than or equal to `right`. Returns `false` for NaN.
pub fn lessOrEqual(left: f64, right: f64) -> bool {
  return Intrinsic.f64LessOrEqual(left, right)
}

/// Returns `true` when `left` is greater than `right`. Returns `false` if either value is NaN.
pub fn greaterThan(left: f64, right: f64) -> bool {
  return Intrinsic.f64GreaterThan(left, right)
}

/// Returns `true` when `left` is greater than or equal to `right`. Returns `false` for NaN.
pub fn greaterOrEqual(left: f64, right: f64) -> bool {
  return Intrinsic.f64GreaterOrEqual(left, right)
}

/// Returns `true` when `value` is a NaN.
pub fn isNaN(value: f64) -> bool {
  return Intrinsic.f64IsNaN(value)
}

/// Returns `true` when `value` is positive or negative infinity.
pub fn isInfinite(value: f64) -> bool {
  return Intrinsic.f64IsInfinite(value)
}

/// Returns `true` when `value` is neither infinity nor NaN.
pub fn isFinite(value: f64) -> bool {
  return Intrinsic.f64IsFinite(value)
}

/// Returns `true` when `value` is finite, nonzero, and not subnormal.
pub fn isNormal(value: f64) -> bool {
  return Intrinsic.f64IsNormal(value)
}

/// Returns `true` when `value` is finite and has subnormal magnitude.
pub fn isSubnormal(value: f64) -> bool {
  return Intrinsic.f64IsSubnormal(value)
}

/// Returns `true` when the sign bit of `value` is set, including for zero and NaN.
pub fn isSignNegative(value: f64) -> bool {
  return Intrinsic.f64IsSignNegative(value)
}

/// Reports whether `left` precedes or equals `right` in the IEEE total order.
///
/// # When to use
///
/// Use this function for deterministic ordering that includes NaNs and distinguishes signed zero.
///
/// # Details
///
/// Unlike ordinary comparison, this order distinguishes negative and positive zero and provides a
/// deterministic position for NaN encodings.
///
/// The order is: negative NaNs, negative infinity, the negative numbers, `-0.0`, `+0.0`, the
/// positive numbers, positive infinity, then positive NaNs. The `Order` conformance of `f64`, which
/// sorting and binary search use, follows it.
pub fn totalOrder(left: f64, right: f64) -> bool {
  return Intrinsic.f64TotalOrder(left, right)
}

/// Reinterprets a value as its exact 64-bit IEEE representation.
///
/// # When to use
///
/// Use this function to inspect or preserve representation bits. It does not convert the number.
pub fn toBits(value: f64) -> u64 {
  return Intrinsic.f64ToBits(value)
}

/// Reinterprets an arbitrary 64-bit pattern as `f64` without numeric conversion.
///
/// # When to use
///
/// Use this function to construct a value from representation bits, including NaN and signed zero.
pub fn fromBits(value: u64) -> f64 {
  return Intrinsic.f64FromBits(value)
}

// One stable NaN result for source-defined operations whose public contract requires canonical
// bits across all execution engines.
fn canonicalNaN() -> f64 {
  return fromBits(9221120237041090560)
}

/// Computes the correctly rounded square root and preserves either signed zero.
///
/// # Details
///
/// IEEE requires square root to be correctly rounded, so its native and WebAssembly instructions
/// have one admissible numeric result.
///
/// # Gotchas
///
/// NaN and negative nonzero inputs return the canonical quiet NaN. Negative zero is not treated as
/// negative and returns unchanged.
pub fn sqrt(value: f64) -> f64 {
  if Intrinsic.f64IsNaN(value) { return canonicalNaN() }
  // Negative zero compares equal to zero and so passes through to the primitive, which returns it
  // unchanged as IEEE-754 requires.
  if value < 0.0 { return canonicalNaN() }
  return Intrinsic.f64Sqrt(value)
}

/// Returns the magnitude of `value`, which clears the sign bit. A NaN input gives the canonical
/// NaN.
pub fn abs(value: f64) -> f64 {
  if Intrinsic.f64IsNaN(value) { return canonicalNaN() }
  return fromBits(u64.bitAnd(toBits(value), 9223372036854775807))
}

/// Returns the magnitude of `magnitude` with the sign bit of `sign`. A NaN `magnitude` gives the
/// canonical NaN rather than a signed NaN.
pub fn copysign(magnitude: f64, sign: f64) -> f64 {
  if Intrinsic.f64IsNaN(magnitude) { return canonicalNaN() }
  let carried = u64.bitAnd(toBits(magnitude), 9223372036854775807)
  let transferred = u64.bitAnd(toBits(sign), 9223372036854775808)
  return fromBits(u64.bitOr(carried, transferred))
}

/// Rounds toward zero while preserving the sign of a zero result.
///
/// # Details
///
/// A value in `(-1.0, -0.0]` becomes negative zero. A NaN becomes the canonical quiet NaN, while
/// either infinity is already integral and returns unchanged.
pub fn trunc(value: f64) -> f64 {
  if Intrinsic.f64IsNaN(value) { return canonicalNaN() }
  let bits = toBits(value)
  let biased = u64.bitAnd(u64.shiftRight(bits, 52), 2047)
  // Below 1.0 nothing integral survives, so only the sign is kept.
  if biased < 1023 { return fromBits(u64.bitAnd(bits, 9223372036854775808)) }
  // At or past 2^52 every representable value is already an integer, infinities included.
  if biased >= 1075 { return value }
  let discarded = u64.subtract(1075, biased)
  let kept = u64.bitNot(u64.shiftLeft(1, discarded) - 1)
  return fromBits(u64.bitAnd(bits, kept))
}

/// Returns the largest integral `f64` that is not greater than `value`. A NaN input gives the
/// canonical NaN.
pub fn floor(value: f64) -> f64 {
  if Intrinsic.f64IsNaN(value) { return canonicalNaN() }
  let truncated = trunc(value)
  // Only a negative non-integral value truncates upward, and it is always below 2^52, so the
  // subtraction is exact.
  if truncated > value { return truncated - 1.0 }
  return truncated
}

/// Returns the smallest integral `f64` that is not less than `value`. A NaN input gives the
/// canonical NaN.
pub fn ceil(value: f64) -> f64 {
  if Intrinsic.f64IsNaN(value) { return canonicalNaN() }
  let truncated = trunc(value)
  if truncated < value { return truncated + 1.0 }
  return truncated
}

/// Rounds to the nearest integral f64, with a half rounded away from zero.
///
/// # Details
///
/// This differs from the ties-to-even policy used by basic arithmetic. A zero result keeps its
/// input sign, and a NaN becomes the canonical quiet NaN.
pub fn round(value: f64) -> f64 {
  if Intrinsic.f64IsNaN(value) { return canonicalNaN() }
  let truncated = trunc(value)
  // Exact: below 2^52 the difference is representable, and at or past it the fraction is zero.
  // An infinity leaves a NaN here, whose comparison is false, so the truncated infinity stands.
  let fraction = value - truncated
  if abs(fraction) < 0.5 { return truncated }
  return truncated + copysign(1.0, value)
}

/// Returns the lesser value and orders negative zero below positive zero. If an operand is NaN,
/// returns the canonical NaN.
pub fn min(left: f64, right: f64) -> f64 {
  if Intrinsic.f64IsNaN(left) { return canonicalNaN() }
  if Intrinsic.f64IsNaN(right) { return canonicalNaN() }
  if left < right { return left }
  if right < left { return right }
  // The operands compare equal, so only a zero's sign is left to separate them.
  if Intrinsic.f64IsSignNegative(left) { return left }
  return right
}

/// Returns the greater value and orders positive zero above negative zero. If an operand is NaN,
/// returns the canonical NaN.
pub fn max(left: f64, right: f64) -> f64 {
  if Intrinsic.f64IsNaN(left) { return canonicalNaN() }
  if Intrinsic.f64IsNaN(right) { return canonicalNaN() }
  if left > right { return left }
  if right > left { return right }
  if Intrinsic.f64IsSignNegative(left) { return right }
  return left
}

/// Approximates sine within four units in the last place using deterministic result bits.
///
/// # Details
///
/// NaN and either infinity return the canonical quiet NaN. Either signed zero returns unchanged.
pub fn sin(value: f64) -> f64 {
  return Intrinsic.f64Sin(value)
}

/// Approximates cosine within four units in the last place using deterministic result bits.
///
/// # Details
///
/// NaN and either infinity return the canonical quiet NaN. Either signed zero returns positive one.
pub fn cos(value: f64) -> f64 {
  return Intrinsic.f64Cos(value)
}

// The functions from `tan` through `fma` port musl's libm: fdlibm for `tan`, the inverse
// trigonometric functions and `cbrt`, Arm Optimized Routines for `exp`, `log` and `pow`, and musl's
// own `hypot` and `fma`. Each uses only binary64 arithmetic in a fixed order, which Silk never
// contracts or reassociates, so every target computes the same bits. Three choices differ from
// musl. `tan` reduces every moderate argument with the medium `__rem_pio2` path, skipping musl's
// fast paths below 9pi/4, so a few results there differ from musl by one unit. Large `tan`
// arguments are reduced with integer arithmetic instead of musl's `__rem_pio2_large`. `fma` with a
// zero addend returns the product, which keeps the IEEE sign of an underflowing product where
// musl gives positive zero. See licenses/musl-math.txt.

/// Approximates tangent within one unit in the last place using deterministic result bits.
///
/// # Details
///
/// The argument is reduced by pi/2 with up to 1,216 bits of 2/pi, so the result stays accurate for
/// every finite input, including the largest. NaN and either infinity return the canonical
/// quiet NaN. Either signed zero returns unchanged.
pub fn tan(value: f64) -> f64 {
  let magnitude = highWord(value) & 0x7FFFFFFF
  // Within about pi/4 no reduction is needed, and below 2^-27 the tangent rounds to the argument.
  if magnitude <= 0x3FE921FB {
    if magnitude < 0x3E400000 { return value }
    return tangentKernel(value, 0.0, false)
  }
  if magnitude >= 0x7FF00000 { return canonicalNaN() }
  let reduced = reduceHalfPi(value)
  return tangentKernel(reduced.head, reduced.tail, u32.bitAnd(reduced.quadrant, 1) == 1)
}

/// Approximates arctangent within one unit in the last place using deterministic result bits.
///
/// # Details
///
/// The result is in `[-pi/2, pi/2]`. NaN returns the canonical quiet NaN, either signed zero
/// returns unchanged, and an infinity returns pi/2 with its sign.
pub fn atan(value: f64) -> f64 {
  let high = highWord(value)
  let negative = high >= 0x80000000
  let magnitude = high & 0x7FFFFFFF
  // At or above 2^66 the arctangent rounds to pi/2.
  if magnitude >= 0x44100000 {
    if Intrinsic.f64IsNaN(value) { return canonicalNaN() }
    if negative { return -1.5707963267948966 }
    return 1.5707963267948966
  }
  let mut x = value
  let mut part: usize = 4
  if magnitude < 0x3FDC0000 {
    if magnitude < 0x3E400000 { return value }
  } else {
    // Reduce to a small argument around one of atan(0.5), atan(1), atan(1.5) or atan(inf).
    x = magnitudeOf(value)
    if magnitude < 0x3FF30000 {
      if magnitude < 0x3FE60000 {
        part = 0
        x = (2.0 * x - 1.0) / (2.0 + x)
      } else {
        part = 1
        x = (x - 1.0) / (x + 1.0)
      }
    } else if magnitude < 0x40038000 {
      part = 2
      x = (x - 1.5) / (1.0 + 1.5 * x)
    } else {
      part = 3
      x = -1.0 / x
    }
  }
  let z = x * x
  let w = z * z
  let odd = z * (3.33333333333329318027e-01 + w * (1.42857142725034663711e-01 + w * (9.09088713343650656196e-02
    + w * (6.66107313738753120669e-02 + w * (4.97687799461593236017e-02 + w * 1.62858201153657823623e-02)))))
  let even = w * (-1.99999999998764832476e-01 + w * (-1.11111104054623557880e-01 + w * (-7.69187620504482999495e-02
    + w * (-5.83357013379057348645e-02 + w * -3.65315727442169155270e-02))))
  if part == 4 { return x - x * (odd + even) }
  let high_parts = &ATAN_HIGH
  let low_parts = &ATAN_LOW
  let result = high_parts[part] - (x * (odd + even) - low_parts[part] - x)
  if negative { return -result }
  return result
}

/// Approximates the angle of the point `(x, y)` from the positive x axis within two units in the
/// last place using deterministic result bits.
///
/// # When to use
///
/// Use this function instead of `atan(y / x)` to get the angle of a vector in every quadrant,
/// including when `x` is zero.
///
/// # Details
///
/// The result is in `[-pi, pi]` and takes the sign of `y`, including a signed zero `y`. A zero
/// `y` returns itself when `x` is positive or `+0.0`, and pi with the sign of `y` when `x` is
/// negative or `-0.0`. A zero `x` with nonzero `y` gives pi/2 with the sign of `y`. Two
/// infinities give an odd multiple of pi/4. A NaN in either operand returns the canonical quiet
/// NaN.
pub fn atan2(y: f64, x: f64) -> f64 {
  if Intrinsic.f64IsNaN(x) || Intrinsic.f64IsNaN(y) { return canonicalNaN() }
  let xBits = toBits(x)
  let yBits = toBits(y)
  if xBits == 0x3FF0000000000000 { return atan(y) }
  let xHigh = u64.wrappingToU32(u64.shiftRight(xBits, 32))
  let yHigh = u64.wrappingToU32(u64.shiftRight(yBits, 32))
  // Bit 0 is the sign of y and bit 1 the sign of x.
  let quadrant = u32.shiftRight(yHigh, 31) | (u32.shiftRight(xHigh, 30) & 2)
  let xMagnitude = xHigh & 0x7FFFFFFF
  let yMagnitude = yHigh & 0x7FFFFFFF
  if u64.shiftLeft(yBits, 1) == 0 {
    if quadrant < 2 { return y }
    if quadrant == 2 { return PI }
    return -PI
  }
  if u64.shiftLeft(xBits, 1) == 0 {
    if quadrant & 1 == 1 { return -PI / 2.0 }
    return PI / 2.0
  }
  if xMagnitude == 0x7FF00000 {
    if yMagnitude == 0x7FF00000 {
      if quadrant == 0 { return PI / 4.0 }
      if quadrant == 1 { return -PI / 4.0 }
      if quadrant == 2 { return 3.0 * PI / 4.0 }
      return -3.0 * PI / 4.0
    }
    if quadrant == 0 { return 0.0 }
    if quadrant == 1 { return -0.0 }
    if quadrant == 2 { return PI }
    return -PI
  }
  // Past a ratio of 2^64 the angle rounds to pi/2.
  if xMagnitude + 0x4000000 < yMagnitude || yMagnitude == 0x7FF00000 {
    if quadrant & 1 == 1 { return -PI / 2.0 }
    return PI / 2.0
  }
  let mut z = 0.0
  // A ratio below 2^-64 with negative x leaves pi, and dividing could underflow.
  if quadrant < 2 || yMagnitude + 0x4000000 >= xMagnitude { z = atan(magnitudeOf(y / x)) }
  if quadrant == 0 { return z }
  if quadrant == 1 { return -z }
  if quadrant == 2 { return PI - (z - 1.2246467991473531772e-16) }
  return (z - 1.2246467991473531772e-16) - PI
}

/// Approximates arcsine within one unit in the last place using deterministic result bits.
///
/// # Details
///
/// The result is in `[-pi/2, pi/2]`. Either signed zero returns unchanged. NaN and any argument
/// outside `[-1, 1]` return the canonical quiet NaN.
pub fn asin(value: f64) -> f64 {
  let high = highWord(value)
  let magnitude = high & 0x7FFFFFFF
  if magnitude >= 0x3FF00000 {
    if magnitudeBits(value) == 0x3FF0000000000000 { return value * 1.57079632679489655800e+00 }
    return canonicalNaN()
  }
  if magnitude < 0x3FE00000 {
    if magnitude < 0x3E500000 && magnitude >= 0x00100000 { return value }
    return value + value * arcsineRatio(value * value)
  }
  // Near one, asin(x) = pi/2 - 2 asin(sqrt((1 - x) / 2)).
  let z = (1.0 - magnitudeOf(value)) * 0.5
  let s = Intrinsic.f64Sqrt(z)
  let r = arcsineRatio(z)
  let mut result = 0.0
  if magnitude >= 0x3FEF3333 {
    result = 1.57079632679489655800e+00 - (2.0 * (s + s * r) - 6.12323399573676603587e-17)
  } else {
    // f + c is the square root to more than double precision.
    let f = withoutLowWord(s)
    let c = (z - f * f) / (s + f)
    result = 0.5 * 1.57079632679489655800e+00
      - (2.0 * s * r - (6.12323399573676603587e-17 - 2.0 * c) - (0.5 * 1.57079632679489655800e+00 - 2.0 * f))
  }
  if high >= 0x80000000 { return -result }
  return result
}

/// Approximates arccosine within one unit in the last place using deterministic result bits.
///
/// # Details
///
/// The result is in `[0, pi]`. One returns positive zero. NaN and any argument outside `[-1, 1]`
/// return the canonical quiet NaN.
pub fn acos(value: f64) -> f64 {
  let high = highWord(value)
  let magnitude = high & 0x7FFFFFFF
  if magnitude >= 0x3FF00000 {
    if magnitudeBits(value) == 0x3FF0000000000000 {
      if high >= 0x80000000 { return 2.0 * 1.57079632679489655800e+00 }
      return 0.0
    }
    return canonicalNaN()
  }
  if magnitude < 0x3FE00000 {
    if magnitude <= 0x3C600000 { return 1.57079632679489655800e+00 }
    return 1.57079632679489655800e+00 - (value - (6.12323399573676603587e-17 - value * arcsineRatio(value * value)))
  }
  if high >= 0x80000000 {
    let z = (1.0 + value) * 0.5
    let s = Intrinsic.f64Sqrt(z)
    let w = arcsineRatio(z) * s - 6.12323399573676603587e-17
    return 2.0 * (1.57079632679489655800e+00 - (s + w))
  }
  let z = (1.0 - value) * 0.5
  let s = Intrinsic.f64Sqrt(z)
  let f = withoutLowWord(s)
  let c = (z - f * f) / (s + f)
  let w = arcsineRatio(z) * s + c
  return 2.0 * (f + w)
}

/// Approximates `e` raised to `value` within one unit in the last place using deterministic result
/// bits.
///
/// # Details
///
/// A result too large for `f64` is positive infinity, and one too small is positive zero.
/// Negative infinity returns positive zero, positive infinity returns itself, and NaN returns the
/// canonical quiet NaN. Either signed zero returns one.
pub fn exp(value: f64) -> f64 {
  if Intrinsic.f64IsNaN(value) { return canonicalNaN() }
  return exponential(value, 0.0, 0)
}

/// Approximates the natural logarithm within one unit in the last place using deterministic result
/// bits.
///
/// # Details
///
/// Either signed zero returns negative infinity, and one returns positive zero. Positive infinity
/// returns itself. NaN and any negative argument return the canonical quiet NaN.
pub fn log(value: f64) -> f64 {
  let mut bits = toBits(value)
  let top = u64.wrappingToU32(u64.shiftRight(bits, 48))
  // Close to one, a polynomial in x - 1 avoids cancellation against the table's log(c).
  if u64.wrappingSubtract(bits, 0x3FEE000000000000) < 0x3FF1090000000000 - 0x3FEE000000000000 {
    if bits == 0x3FF0000000000000 { return 0.0 }
    let r = value - 1.0
    let r2 = r * r
    let r3 = r * r2
    let mut y = r3 * (0.3333333333333352 + r * -0.24999999999998432 + r2 * 0.19999999999320328
      + r3 * (-0.16666666669929706 + r * 0.14285715076560868 + r2 * -0.12499997863982555
      + r3 * (0.11110712032936046 + r * -0.10000486757818193 + r2 * 0.09181994006195467 + r3 * -0.08328363062289341)))
    // The leading -r*r/2 is computed to double the precision through a split of r.
    let mut w = r * 134217728.0
    let rhi = r + w - w
    let rlo = r - rhi
    w = rhi * rhi * -0.5
    let hi = r + w
    let mut lo = r - hi + w
    lo = lo + -0.5 * rlo * (rhi + r)
    y = y + lo
    y = y + hi
    return y
  }
  if u32.wrappingSubtract(top, 0x0010) >= 0x7FF0 - 0x0010 {
    if u64.shiftLeft(bits, 1) == 0 { return -INFINITY }
    if bits == 0x7FF0000000000000 { return value }
    if top & 0x8000 != 0 || top & 0x7FF0 == 0x7FF0 { return canonicalNaN() }
    // A subnormal is scaled into the normal range and its exponent corrected.
    bits = u64.wrappingSubtract(toBits(value * 4503599627370496.0), 0x0340000000000000)
  }
  // value = 2^k z with z in [0x1.6p-1, 0x1.6p0), and z near the center c of table entry i.
  let offset = u64.wrappingSubtract(bits, 0x3FE6000000000000)
  let index = u64.toUsize(u64.bitAnd(u64.shiftRight(offset, 45), 127)) * 2
  let k = i64.shiftRight(u64.wrappingToI64(offset), 52)
  let z = fromBits(u64.wrappingSubtract(bits, offset & 0xFFF0000000000000))
  let table = &LOG_TABLE
  let centers = &LOG_CENTERS
  let inverse = fromBits(table[index])
  let logCenter = fromBits(table[index + 1])
  let r = (z - fromBits(centers[index]) - fromBits(centers[index + 1])) * inverse
  let kd = i64.toF64(k)
  let w = kd * 0.6931471805598903 + logCenter
  let hi = w + r
  let lo = w - hi + r + kd * 5.497923018708371e-14
  let r2 = r * r
  return lo + r2 * -0.5000000000000001 + r * r2 * (0.33333333331825593 + r * -0.2499999999622955
    + r2 * (0.20000304511814496 + r * -0.16667054827627667)) + hi
}

/// Approximates `base` raised to `exponent` within one unit in the last place using deterministic
/// result bits.
///
/// # Details
///
/// A negative `base` has a real power only for an integer `exponent`, and an odd integer gives a
/// negative result. A result too large for `f64` is an infinity, and one too small is a zero, each
/// with that sign.
///
/// # Gotchas
///
/// The special cases follow IEEE-754 `pow`:
///
/// - A zero `exponent` returns one for every `base`, NaN included, and a `base` of one returns one
///   for every `exponent`, NaN included.
/// - A `base` of negative one with an infinite `exponent` returns one.
/// - A zero `base` with a negative `exponent` returns an infinity, negative only for `-0.0` with an
///   odd integer `exponent`. With a positive `exponent` it returns a zero signed the same way.
/// - With an infinite `exponent`, a `base` whose magnitude is below one gives positive zero for
///   positive infinity and positive infinity for negative infinity. A magnitude above one gives the
///   reverse.
/// - A negative finite `base` with a finite non-integer `exponent`, and any other NaN operand,
///   returns the canonical quiet NaN.
pub fn pow(base: f64, exponent: f64) -> f64 {
  let mut signBias: u64 = 0
  let mut baseBits = toBits(base)
  let exponentBits = toBits(exponent)
  let mut baseTop = u64.wrappingToU32(u64.shiftRight(baseBits, 52))
  let exponentTop = u64.wrappingToU32(u64.shiftRight(exponentBits, 52))
  // Special cases: a base below 2^-1022, infinite or NaN, or an exponent magnitude below 2^-65, at
  // or above 2^63, or NaN.
  if u32.wrappingSubtract(baseTop, 0x001) >= 0x7FF - 0x001
    || u32.wrappingSubtract(exponentTop & 0x7FF, 0x3BE) >= 0x43E - 0x3BE {
    if isZeroInfiniteOrNaN(exponentBits) {
      if u64.shiftLeft(exponentBits, 1) == 0 { return 1.0 }
      if baseBits == 0x3FF0000000000000 { return 1.0 }
      if u64.shiftLeft(baseBits, 1) > 0xFFE0000000000000 || u64.shiftLeft(exponentBits, 1) > 0xFFE0000000000000 {
        return canonicalNaN()
      }
      if u64.shiftLeft(baseBits, 1) == 0x7FE0000000000000 { return 1.0 }
      if (u64.shiftLeft(baseBits, 1) < 0x7FE0000000000000) == (exponentBits < 0x8000000000000000) { return 0.0 }
      return exponent * exponent
    }
    if isZeroInfiniteOrNaN(baseBits) {
      if Intrinsic.f64IsNaN(base) { return canonicalNaN() }
      let mut squared = base * base
      if baseBits >= 0x8000000000000000 && integerKind(exponentBits) == 1 { squared = -squared }
      if exponentBits >= 0x8000000000000000 { return 1.0 / squared }
      return squared
    }
    // Here both operands are nonzero and finite.
    if baseBits >= 0x8000000000000000 {
      let kind = integerKind(exponentBits)
      if kind == 0 { return canonicalNaN() }
      if kind == 1 { signBias = 0x40000 }
      baseBits = baseBits & 0x7FFFFFFFFFFFFFFF
      baseTop = baseTop & 0x7FF
    }
    if u32.wrappingSubtract(exponentTop & 0x7FF, 0x3BE) >= 0x43E - 0x3BE {
      // The exponent is not odd here, so the sign bias is zero.
      if baseBits == 0x3FF0000000000000 { return 1.0 }
      if exponentTop & 0x7FF < 0x3BE {
        if baseBits > 0x3FF0000000000000 { return 1.0 + exponent }
        return 1.0 - exponent
      }
      if (baseBits > 0x3FF0000000000000) == (exponentTop < 0x800) { return INFINITY }
      return 0.0
    }
    if baseTop == 0 {
      // A subnormal base is normalized so that its exponent becomes negative.
      baseBits = toBits(base * 4503599627370496.0) & 0x7FFFFFFFFFFFFFFF
      baseBits = u64.wrappingSubtract(baseBits, 0x0340000000000000)
    }
  }
  let logged = powerLog(baseBits)
  // exponent * log(base) as head + tail, through 26-bit splits so the products are exact.
  let exponentHead = fromBits(exponentBits & 0xFFFFFFFFF8000000)
  let exponentTail = exponent - exponentHead
  let logHead = fromBits(toBits(logged.head) & 0xFFFFFFFFF8000000)
  let logTail = logged.head - logHead + logged.tail
  let productHead = exponentHead * logHead
  let productTail = exponentTail * logHead + exponent * logTail
  return exponential(productHead, productTail, signBias)
}

/// Approximates the real cube root within one unit in the last place using deterministic result
/// bits.
///
/// # Details
///
/// The result has the sign of `value`, so a negative argument has a negative root. Either signed
/// zero and either infinity return unchanged. NaN returns the canonical quiet NaN.
pub fn cbrt(value: f64) -> f64 {
  let bits = toBits(value)
  let mut high = u64.wrappingToU32(u64.shiftRight(bits, 32)) & 0x7FFFFFFF
  if high >= 0x7FF00000 {
    if Intrinsic.f64IsNaN(value) { return canonicalNaN() }
    return value
  }
  // A first estimate to 5 bits divides the biased exponent by three in the bit pattern.
  if high < 0x00100000 {
    high = u64.wrappingToU32(u64.shiftRight(toBits(value * 18014398509481984.0), 32)) & 0x7FFFFFFF
    if high == 0 { return value }
    high = high / 3 + 696219795
  } else {
    high = high / 3 + 715094163
  }
  let mut t = fromBits(u64.bitOr(bits & 0x8000000000000000, u64.shiftLeft(u32.toU64(high), 32)))
  // A polynomial in t^3 / value refines the estimate to 23 bits.
  let mut r = t * t * (t / value)
  t = t * ((1.87595182427177009643 + r * (-1.88497979543377169875 + r * 1.621429720105354466140))
    + r * r * r * (-0.758397934778766047437 + r * 0.145996192886612446982))
  // Rounding away from zero to 23 bits makes t * t exact for the Newton step.
  t = fromBits(u64.wrappingAdd(toBits(t), 0x80000000) & 0xFFFFFFFFC0000000)
  let s = t * t
  r = value / s
  let w = t + t
  r = (r - t) / (w + r)
  return t + t * r
}

/// Approximates `sqrt(x * x + y * y)` within one unit in the last place using deterministic
/// result bits, without intermediate overflow or underflow.
///
/// # When to use
///
/// Use this function for the length of a vector or the distance between two points. It stays
/// accurate where squaring an operand would overflow to infinity or underflow to zero.
///
/// # Details
///
/// The result is never negative, and the signs of the operands do not matter. An infinite
/// operand returns positive infinity even when the other is NaN. Otherwise a NaN operand returns
/// the canonical quiet NaN.
pub fn hypot(x: f64, y: f64) -> f64 {
  let mut larger = toBits(x) & 0x7FFFFFFFFFFFFFFF
  let mut smaller = toBits(y) & 0x7FFFFFFFFFFFFFFF
  if larger < smaller {
    let swapped = larger
    larger = smaller
    smaller = swapped
  }
  let largerExponent = u64.wrappingToI32(u64.shiftRight(larger, 52))
  let smallerExponent = u64.wrappingToI32(u64.shiftRight(smaller, 52))
  let mut a = fromBits(larger)
  let mut b = fromBits(smaller)
  // NaN orders above infinity, so an infinite smaller operand means no operand is a finite number.
  if smallerExponent == 0x7FF {
    if Intrinsic.f64IsNaN(b) { return canonicalNaN() }
    return b
  }
  if largerExponent == 0x7FF || smaller == 0 {
    if Intrinsic.f64IsNaN(a) { return canonicalNaN() }
    return a
  }
  if largerExponent - smallerExponent > 64 { return a + b }
  // Scale so that the squares neither overflow nor lose their low halves to underflow.
  let mut scale = 1.0
  if largerExponent > 0x3FF + 510 {
    scale = fromBits(0x6BB0000000000000)
    a = a * fromBits(0x1430000000000000)
    b = b * fromBits(0x1430000000000000)
  } else if smallerExponent < 0x3FF - 450 {
    scale = fromBits(0x1430000000000000)
    a = a * fromBits(0x6BB0000000000000)
    b = b * fromBits(0x6BB0000000000000)
  }
  let largerSquare = exactSquare(a)
  let smallerSquare = exactSquare(b)
  return scale * Intrinsic.f64Sqrt(smallerSquare.tail + largerSquare.tail + smallerSquare.head + largerSquare.head)
}

/// Computes `left * right + addend` with a single rounding, as the IEEE-754 fused multiply-add.
///
/// # When to use
///
/// Use this function for exact dot products, polynomial evaluation, and error terms, where
/// rounding the product separately loses the low half that the addend should cancel.
///
/// # Details
///
/// The result is correctly rounded on every target, so it has one admissible value. Targets with a
/// fused multiply-add instruction, AArch64 and x86-64 with the `fma` CPU feature, compute it with
/// that instruction. Other targets, WebAssembly included, compute it with integer arithmetic.
///
/// # Gotchas
///
/// A NaN operand, or an infinite product with a zero operand or an infinite addend of the other
/// sign, returns the canonical quiet NaN.
pub fn fma(left: f64, right: f64, addend: f64) -> f64 {
  let mut result = 0.0
  static if Target.hasCpuFeature("fma") || Target.hasCpuFeature("fp-armv8") {
    let lanes = Intrinsic.simdMulAdd<simd<f64, 2>>(Intrinsic.simdSplat<simd<f64, 2>>(left),
      Intrinsic.simdSplat<simd<f64, 2>>(right), Intrinsic.simdSplat<simd<f64, 2>>(addend))
    result = Intrinsic.simdExtract<simd<f64, 2>>(lanes, 0)
  } else {
    result = fusedMultiplyAdd(left, right, addend)
  }
  if Intrinsic.f64IsNaN(result) { return canonicalNaN() }
  return result
}

fn highWord(value: f64) -> u32 {
  return u64.wrappingToU32(u64.shiftRight(toBits(value), 32))
}

fn magnitudeBits(value: f64) -> u64 {
  return toBits(value) & 0x7FFFFFFFFFFFFFFF
}

// The magnitude of a value known not to be NaN.
fn magnitudeOf(value: f64) -> f64 {
  return fromBits(magnitudeBits(value))
}

// The value with the low 32 bits of its significand cleared, which leaves 21 significant bits.
fn withoutLowWord(value: f64) -> f64 {
  return fromBits(toBits(value) & 0xFFFFFFFF00000000)
}

// An unevaluated sum `head + tail` whose tail carries the bits rounded off the head.
struct Wide {
  head: f64,
  tail: f64,
}

// The remainder of an argument after removing the nearest multiple of pi/2, as `head + tail`, and
// the low bits of that multiple.
struct HalfPiRemainder {
  head: f64,
  tail: f64,
  quadrant: u32,
}

// atan(0.5), atan(1), atan(1.5) and atan(inf), each split into a head and a tail.
const ATAN_HIGH: [f64; 4] = [
  4.63647609000806093515e-01, 7.85398163397448278999e-01, 9.82793723247329054082e-01, 1.57079632679489655800e+00,
]

const ATAN_LOW: [f64; 4] = [
  2.26987774529616870924e-17, 3.06161699786838301793e-17, 1.39033110312309984516e-17, 6.12323399573676603587e-17,
]

// tan(head + tail) for |head + tail| below about pi/4, or -1/tan(head + tail) when `odd`.
fn tangentKernel(head: f64, tail: f64, odd: bool) -> f64 {
  let mut x = head
  let mut y = tail
  let high = highWord(x)
  let negative = high >= 0x80000000
  // Above 0.6744 the polynomial converges slowly, so tan(pi/4 - x) is computed instead.
  let big = high & 0x7FFFFFFF >= 0x3FE59428
  if big {
    if negative {
      x = -x
      y = -y
    }
    x = (7.85398163397448278999e-01 - x) + (3.06161699786838301793e-17 - y)
    y = 0.0
  }
  let z = x * x
  let w = z * z
  let mut r = 1.33333333333201242699e-01 + w * (2.18694882948595424599e-02 + w * (3.59207910759131235356e-03
    + w * (5.88041240820264096874e-04 + w * (7.81794442939557092300e-05 + w * -1.85586374855275456654e-05))))
  let v = z * (5.39682539762260521377e-02 + w * (8.86323982359930005737e-03 + w * (1.45620945432529025516e-03
    + w * (2.46463134818469906812e-04 + w * (7.14072491382608190305e-05 + w * 2.59073051863633712884e-05)))))
  let s = z * x
  r = y + z * (s * (r + v) + y) + s * 3.33333333333334091986e-01
  let sum = x + r
  if big {
    let mut sign = 1.0
    if odd { sign = -1.0 }
    let result = sign - 2.0 * (x + (r - sum * sum / (sum + sign)))
    if negative { return -result }
    return result
  }
  if !odd { return sum }
  // -1/sum has up to two units of error, so it is computed from split operands.
  let sumHead = withoutLowWord(sum)
  let sumTail = r - (sumHead - x)
  let inverse = -1.0 / sum
  let inverseHead = withoutLowWord(inverse)
  return inverseHead + inverse * (1.0 + inverseHead * sumHead + inverseHead * sumTail)
}

fn reduceHalfPi(value: f64) -> HalfPiRemainder {
  let magnitude = highWord(value) & 0x7FFFFFFF
  if magnitude >= 0x413921FB { return reduceHalfPiLarge(value) }
  // Below 2^20 pi/2, Cody-Waite reduction with up to three 33-bit parts of pi/2 is exact enough.
  // Adding 1.5 * 2^52 rounds the quotient to an integer held in the low significand bits.
  let shifted = value * 6.36619772367581382433e-01 + 6755399441055744.0
  let quotient = shifted - 6755399441055744.0
  let mut remainder = value - quotient * 1.57079632673412561417e+00
  let mut correction = quotient * 6.07710050650619224932e-11
  let mut head = remainder - correction
  let exponent = u32.toI32(u32.shiftRight(magnitude, 20))
  if exponent - biasedExponent(head) > 16 {
    let previous = remainder
    correction = quotient * 6.07710050630396597660e-11
    remainder = previous - correction
    correction = quotient * 2.02226624879595063154e-21 - ((previous - remainder) - correction)
    head = remainder - correction
    if exponent - biasedExponent(head) > 49 {
      let before = remainder
      correction = quotient * 2.02226624871116645580e-21
      remainder = before - correction
      correction = quotient * 8.47842766036889956997e-32 - ((before - remainder) - correction)
      head = remainder - correction
    }
  }
  return HalfPiRemainder {head: head, tail: (remainder - head) - correction, quadrant: u64.wrappingToU32(toBits(shifted))}
}

fn biasedExponent(value: f64) -> i32 {
  return u64.wrappingToI32(u64.shiftRight(toBits(value), 52) & 0x7FF)
}

// Payne-Hanek reduction for magnitudes at or above 2^20 pi/2. With value = m * 2^e for an integer
// m below 2^53, only 256 bits of 2/pi, starting where the earlier bits would contribute multiples of
// four, affect value * 2/pi modulo 4 to 138 fractional bits. The fraction is then multiplied by a
// 128-bit pi/2. Every step is exact integer arithmetic except the final conversion.
fn reduceHalfPiLarge(value: f64) -> HalfPiRemainder {
  let bits = toBits(value)
  let mantissa = u64.bitOr(bits & 0xFFFFFFFFFFFFF, 0x10000000000000)
  let exponent = u64.wrappingToI64(u64.shiftRight(bits, 52) & 0x7FF) - 1075
  let mut first: i64 = 0
  if exponent >= 2 { first = (exponent - 2) / 64 }
  let table = &TWO_OVER_PI
  let start = i64.toUsize(first)
  // The product of the mantissa and words start .. start + 3, least significant limb first.
  let low0 = u64.wrappingMultiply(mantissa, table[start + 3])
  let high0 = u64.multiplyHigh(mantissa, table[start + 3])
  let low1 = u64.wrappingMultiply(mantissa, table[start + 2])
  let high1 = u64.multiplyHigh(mantissa, table[start + 2])
  let low2 = u64.wrappingMultiply(mantissa, table[start + 1])
  let high2 = u64.multiplyHigh(mantissa, table[start + 1])
  let low3 = u64.wrappingMultiply(mantissa, table[start])
  let high3 = u64.multiplyHigh(mantissa, table[start])
  let limb1 = u64.wrappingAdd(high0, low1)
  let carry1 = carryOf(limb1, low1)
  let partial2 = u64.wrappingAdd(high1, low2)
  let limb2 = u64.wrappingAdd(partial2, carry1)
  let carry2 = carryOf(partial2, low2) + carryOf(limb2, carry1)
  let partial3 = u64.wrappingAdd(high2, low3)
  let limb3 = u64.wrappingAdd(partial3, carry2)
  let carry3 = carryOf(partial3, low3) + carryOf(limb3, carry2)
  let limbs: [u64; 5] = [low0, limb1, limb2, limb3, high3 + carry3]
  // The binary point of value * 2/pi sits below bit `point` of the product.
  let point = i64.toU64(64 * (first + 4) - exponent)
  let mut quadrant = u64.wrappingToU32(productWindow(&limbs, point)) & 3
  let mut high = productWindow(&limbs, point - 64)
  let mut low = productWindow(&limbs, point - 128)
  let mut negative = false
  if high >= 0x8000000000000000 {
    // A fraction of at least one half rounds the quotient up and leaves a negative remainder.
    quadrant = (quadrant + 1) & 3
    negative = true
    low = u64.wrappingSubtract(0, low)
    high = u64.bitNot(high)
    if low == 0 { high = u64.wrappingAdd(high, 1) }
  }
  // Normalize the 128-bit fraction so that its top bit is set.
  let mut shift: u64 = 0
  if high == 0 {
    high = low
    low = 0
    shift = 64
  }
  let zeros = u32.toU64(u64.leadingZeros(high))
  if zeros > 0 {
    high = u64.bitOr(u64.shiftLeft(high, zeros), u64.shiftRight(low, 64 - zeros))
    low = u64.shiftLeft(low, zeros)
  }
  shift = shift + zeros
  // pi/2 * 2^127, rounded to an integer.
  let product = multiplyTop(high, low, 0xC90FDAA22168C234, 0xC4C6628B80DC1CD1)
  // The remainder is (product.high + product.low * 2^-64) * 2^-(63 + shift).
  let headBits = product.high & 0xFFFFFFFFFFFFF800
  let headPart = u64.toF64(headBits)
  let rest = u64.toF64(product.high & 0x7FF) + u64.toF64(product.low) * fromBits(0x3BF0000000000000)
  let mut head = headPart + rest
  let mut tail = rest - (head - headPart)
  let scale = fromBits(u64.shiftLeft(1023 - 63 - shift, 52))
  head = head * scale
  tail = tail * scale
  if negative != (bits >= 0x8000000000000000) {
    head = -head
    tail = -tail
  }
  if bits >= 0x8000000000000000 { quadrant = u32.wrappingSubtract(0, quadrant) & 3 }
  return HalfPiRemainder {head: head, tail: tail, quadrant: quadrant}
}

fn carryOf(sum: u64, addend: u64) -> u64 {
  if sum < addend { return 1 }
  return 0
}

// Bits `low` through `low + 63` of a 320-bit product held least significant limb first.
fn productWindow(limbs: &[u64; 5], low: u64) -> u64 {
  let index = u64.toUsize(low / 64)
  let offset = low % 64
  let base = u64.shiftRight(limbs[index], offset)
  if offset == 0 || index + 1 >= 5 { return base }
  return u64.bitOr(base, u64.shiftLeft(limbs[index + 1], 64 - offset))
}

struct WideWord {
  high: u64,
  low: u64,
}

// The upper 128 bits of the 256-bit product of two 128-bit integers.
fn multiplyTop(leftHigh: u64, leftLow: u64, rightHigh: u64, rightLow: u64) -> WideWord {
  let lowLow = u64.multiplyHigh(leftLow, rightLow)
  let lowHighLow = u64.wrappingMultiply(leftLow, rightHigh)
  let lowHighHigh = u64.multiplyHigh(leftLow, rightHigh)
  let highLowLow = u64.wrappingMultiply(leftHigh, rightLow)
  let highLowHigh = u64.multiplyHigh(leftHigh, rightLow)
  let highHighLow = u64.wrappingMultiply(leftHigh, rightHigh)
  let highHighHigh = u64.multiplyHigh(leftHigh, rightHigh)
  let first = u64.wrappingAdd(lowLow, lowHighLow)
  let second = u64.wrappingAdd(first, highLowLow)
  let carry = carryOf(first, lowHighLow) + carryOf(second, highLowLow)
  let third = u64.wrappingAdd(lowHighHigh, highLowHigh)
  let fourth = u64.wrappingAdd(third, highHighLow)
  let fifth = u64.wrappingAdd(fourth, carry)
  let upper = highHighHigh + carryOf(third, highLowHigh) + carryOf(fourth, highHighLow) + carryOf(fifth, carry)
  return WideWord {high: upper, low: fifth}
}

// The rational approximation of (asin(x) - x) / x^3 at z = x^2 for |x| below 0.5.
fn arcsineRatio(z: f64) -> f64 {
  let p = z * (1.66666666666666657415e-01 + z * (-3.25565818622400915405e-01 + z * (2.01212532134862925881e-01
    + z * (-4.00555345006794114027e-02 + z * (7.91534994289814532176e-04 + z * 3.47933107596021167570e-05)))))
  let q = 1.0 + z * (-2.40339491173441421878e+00 + z * (2.02094576023350569471e+00 + z * (-6.88283971605453293030e-01
    + z * 7.70381505559019352791e-02)))
  return p / q
}

// sign * exp(x + tail) for |tail| below 2^-15 and |tail| at most |x|. `signBias` is 0x40000 for a
// negative result, which reaches the sign bit when added to the scaled exponent.
fn exponential(x: f64, tail: f64, signBias: u64) -> f64 {
  let mut top = u64.wrappingToU32(u64.shiftRight(toBits(x), 52)) & 0x7FF
  if u32.wrappingSubtract(top, 0x3C9) >= 0x408 - 0x3C9 {
    // Below 2^-54 the result rounds to one.
    if u32.wrappingSubtract(top, 0x3C9) >= 0x80000000 {
      let one = 1.0 + x
      if signBias != 0 { return -one }
      return one
    }
    // At or above 1024 in magnitude the result overflows or underflows.
    if top >= 0x409 {
      if toBits(x) >= 0x8000000000000000 {
        if signBias != 0 { return -0.0 }
        return 0.0
      }
      if signBias != 0 { return -INFINITY }
      return INFINITY
    }
    // Between 512 and 1024 the scale needs special handling below.
    top = 0
  }
  // exp(x) = 2^(k/128) exp(r) with r in [-ln2/256, ln2/256]. Adding 1.5 * 2^52 rounds k into the
  // low significand bits.
  let z = 184.6649652337873 * x
  let shifted = z + 6755399441055744.0
  let k = toBits(shifted)
  let kd = shifted - 6755399441055744.0
  let mut r = x + kd * -0.005415212348111709 + kd * -1.2864023111638346e-14
  r = r + tail
  let index = u64.toUsize(k & 127) * 2
  let table = &EXP_TABLE
  let scaleTail = fromBits(table[index])
  let scaleBits = u64.wrappingAdd(table[index + 1], u64.shiftLeft(u64.wrappingAdd(k, signBias), 45))
  let r2 = r * r
  let sum = scaleTail + r + r2 * (0.49999999999996786 + r * 0.16666666666665886)
    + r2 * r2 * (0.0416666808410674 + r * 0.008333335853059549)
  if top == 0 { return scaledExponential(sum, scaleBits, k) }
  let scale = fromBits(scaleBits)
  return scale + scale * sum
}

// scale * (1 + sum) for a scale whose exponent field may have overflowed or must be subnormal,
// rounded once.
fn scaledExponential(sum: f64, scaleBits: u64, k: u64) -> f64 {
  if k & 0x80000000 == 0 {
    // k > 0, and the exponent of the scale may have overflowed by at most 460.
    let scale = fromBits(u64.wrappingSubtract(scaleBits, 0x3F10000000000000))
    return fromBits(0x7F00000000000000) * (scale + scale * sum)
  }
  let adjusted = u64.wrappingAdd(scaleBits, 0x3FE0000000000000)
  let scale = fromBits(adjusted)
  let mut y = scale + scale * sum
  if magnitudeOf(y) < 1.0 {
    // Round to the final precision before scaling into the subnormal range, to avoid rounding
    // twice.
    let mut one = 1.0
    if y < 0.0 { one = -1.0 }
    let mut lo = scale - y + scale * sum
    let hi = one + y
    lo = one - hi + y + lo
    y = (hi + lo) - one
    if y == 0.0 { y = fromBits(adjusted & 0x8000000000000000) }
  }
  return fromBits(0x0010000000000000) * y
}

// log(x) as head + tail with about 15 more bits than a double. `bits` is the representation of a
// positive x, with a subnormal x normalized to a negative exponent field.
fn powerLog(bits: u64) -> Wide {
  let offset = u64.wrappingSubtract(bits, 0x3FE6955500000000)
  let index = u64.toUsize(u64.bitAnd(u64.shiftRight(offset, 45), 127)) * 3
  let k = i64.shiftRight(u64.wrappingToI64(offset), 52)
  let reduced = u64.wrappingSubtract(bits, offset & 0xFFF0000000000000)
  let z = fromBits(reduced)
  let kd = i64.toF64(k)
  let table = &POW_LOG_TABLE
  let inverse = fromBits(table[index])
  let logCenter = fromBits(table[index + 1])
  let logCenterTail = fromBits(table[index + 2])
  // z / c - 1 is exact, computed as rhi + rlo with rhi * rhi exact.
  let zhi = fromBits(u64.wrappingAdd(reduced, 0x80000000) & 0xFFFFFFFF00000000)
  let zlo = z - zhi
  let rhi = zhi * inverse - 1.0
  let rlo = zlo * inverse
  let r = rhi + rlo
  let t1 = kd * 0.6931471805598903 + logCenter
  let t2 = t1 + r
  let lo1 = kd * 5.497923018708371e-14 + logCenterTail
  let lo2 = t1 - t2 + r
  let ar = -0.5 * r
  let ar2 = r * ar
  let ar3 = r * ar2
  let arhi = -0.5 * rhi
  let arhi2 = rhi * arhi
  let hi = t2 + arhi2
  let lo3 = rlo * (ar + arhi)
  let lo4 = t2 - hi + arhi2
  let p = ar3 * (-0.6666666666666679 + r * 0.5000000000000007 + ar2 * (0.7999999995323976 + r * -0.6666666663487739
    + ar2 * (-1.142909628459501 + r * 1.0000415263675542)))
  let lo = lo1 + lo2 + lo3 + lo4 + p
  let y = hi + lo
  return Wide {head: y, tail: hi - y + lo}
}

// 0 if `bits` is not an integer, 1 for an odd integer, and 2 for an even integer, for a nonzero
// finite value.
fn integerKind(bits: u64) -> u32 {
  let field = u64.shiftRight(bits, 52) & 0x7FF
  if field < 0x3FF { return 0 }
  if field > 0x3FF + 52 { return 2 }
  let unit = u64.shiftLeft(1, 0x3FF + 52 - field)
  if bits & (unit - 1) != 0 { return 0 }
  if bits & unit != 0 { return 1 }
  return 2
}

fn isZeroInfiniteOrNaN(bits: u64) -> bool {
  return u64.wrappingSubtract(u64.shiftLeft(bits, 1), 1) >= 0xFFE0000000000000 - 1
}

// value * value as head + tail, exact through a 26-bit split of the value.
fn exactSquare(value: f64) -> Wide {
  let scaled = value * 134217729.0
  let high = value - scaled + scaled
  let low = value - high
  let head = value * value
  return Wide {head: head, tail: high * high - head + 2.0 * high * low + low * low}
}

// A finite nonzero value as m * 2^exponent with m in [2^53, 2^54) and its low bit clear.
struct Unpacked {
  mantissa: u64,
  exponent: i32,
  negative: bool,
}

// Exponents at or above this mark a zero, an infinity or NaN.
const UNPACKED_SPECIAL: i32 = 0x7FF - 0x3FF - 52 - 1

fn unpack(value: f64) -> Unpacked {
  let mut bits = toBits(value)
  let mut field = u64.wrappingToI32(u64.shiftRight(bits, 52) & 0x7FF)
  let negative = bits >= 0x8000000000000000
  if field == 0 {
    // A subnormal is scaled by 2^63 into the normal range, and a zero stays special.
    bits = toBits(value * 9223372036854775808.0)
    field = u64.wrappingToI32(u64.shiftRight(bits, 52) & 0x7FF)
    if field == 0 { field = 0x800 } else { field = field - 63 }
  }
  let mantissa = u64.shiftLeft(u64.bitOr(bits & 0xFFFFFFFFFFFFF, 0x10000000000000), 1)
  return Unpacked {mantissa: mantissa, exponent: field - (0x3FF + 52 + 1), negative: negative}
}

// One when any of `value` is set, which keeps a shifted-out tail as a sticky bit.
fn sticky(value: u64) -> u64 {
  if value != 0 { return 1 }
  return 0
}

// The correctly rounded fused multiply-add in integer arithmetic.
fn fusedMultiplyAdd(left: f64, right: f64, addend: f64) -> f64 {
  let x = unpack(left)
  let y = unpack(right)
  let z = unpack(addend)
  // A zero, infinite or NaN factor makes the product exact.
  if x.exponent >= UNPACKED_SPECIAL || y.exponent >= UNPACKED_SPECIAL { return left * right + addend }
  if z.exponent >= UNPACKED_SPECIAL {
    // With a zero addend the result is the product rounded once, which keeps the sign of a product
    // that underflows to zero. An infinite or NaN addend is the result.
    if z.exponent > UNPACKED_SPECIAL { return left * right }
    return addend
  }
  // The product as rhi : rlo, whose top 20 or 21 bits and last two bits are zero.
  let mut rlo = u64.wrappingMultiply(x.mantissa, y.mantissa)
  let mut rhi = u64.multiplyHigh(x.mantissa, y.mantissa)
  let mut zhi: u64 = 0
  let mut zlo: u64 = 0
  // Align the exponents by shifting the addend left or the product right, sticky bits kept.
  let mut e = x.exponent + y.exponent
  let mut d = z.exponent - e
  if d > 0 {
    if d < 64 {
      zlo = u64.shiftLeft(z.mantissa, i32.toU64(d))
      zhi = u64.shiftRight(z.mantissa, i32.toU64(64 - d))
    } else {
      zhi = z.mantissa
      e = z.exponent - 64
      d = d - 64
      if d == 0 {
      } else if d < 64 {
        let amount = i32.toU64(d)
        rlo = u64.bitOr(u64.bitOr(u64.shiftLeft(rhi, 64 - amount), u64.shiftRight(rlo, amount)),
          sticky(u64.shiftLeft(rlo, 64 - amount)))
        rhi = u64.shiftRight(rhi, amount)
      } else {
        rlo = 1
        rhi = 0
      }
    }
  } else {
    d = -d
    if d == 0 {
      zlo = z.mantissa
    } else if d < 64 {
      let amount = i32.toU64(d)
      zlo = u64.bitOr(u64.shiftRight(z.mantissa, amount), sticky(u64.shiftLeft(z.mantissa, 64 - amount)))
    } else {
      zlo = 1
    }
  }
  let mut negative = x.negative != y.negative
  let mut nonzero = true
  if negative == z.negative {
    rlo = u64.wrappingAdd(rlo, zlo)
    rhi = u64.wrappingAdd(u64.wrappingAdd(rhi, zhi), carryOf(rlo, zlo))
  } else {
    let before = rlo
    rlo = u64.wrappingSubtract(rlo, zlo)
    rhi = u64.wrappingSubtract(u64.wrappingSubtract(rhi, zhi), carryOf(before, rlo))
    if rhi >= 0x8000000000000000 {
      rlo = u64.wrappingSubtract(0, rlo)
      rhi = u64.wrappingSubtract(u64.wrappingSubtract(0, rhi), sticky(rlo))
      negative = !negative
    }
    nonzero = rhi != 0
  }
  // Leave the top 63 bits of the sum in rhi, the last one sticky.
  if nonzero {
    e = e + 64
    d = u32.toI32(u64.leadingZeros(rhi)) - 1
    let amount = i32.toU64(d)
    rhi = u64.bitOr(u64.bitOr(u64.shiftLeft(rhi, amount), u64.shiftRight(rlo, 64 - amount)),
      sticky(u64.shiftLeft(rlo, amount)))
  } else if rlo != 0 {
    d = u32.toI32(u64.leadingZeros(rlo)) - 1
    if d < 0 {
      rhi = u64.bitOr(u64.shiftRight(rlo, 1), rlo & 1)
    } else {
      rhi = u64.shiftLeft(rlo, i32.toU64(d))
    }
  } else {
    // An exact zero, whose sign IEEE arithmetic gives.
    return left * right + addend
  }
  e = e - d
  // Convert, rounding once. rhi is in [2^62, 2^63).
  let mut integer = u64.wrappingToI64(rhi)
  if negative { integer = -integer }
  let mut result = i64.toF64(integer)
  if e < -1022 - 62 {
    // The result is subnormal before rounding, so arrange for scaling to be the only rounding.
    if e == -1022 - 63 {
      let mut bound = 9223372036854775808.0
      if negative { bound = -bound }
      if result != bound && u64.shiftLeft(rhi, 53) != 0 {
        // Scaling loses one more bit, so add a top bit to round only once at the conversion.
        integer = u64.wrappingToI64(u64.bitOr(u64.bitOr(u64.shiftRight(rhi, 1), rhi & 1), 0x4000000000000000))
        if negative { integer = -integer }
        result = i64.toF64(integer)
        result = 2.0 * result - bound
      }
    } else {
      integer = u64.wrappingToI64(u64.shiftLeft(u64.bitOr(u64.shiftRight(rhi, 10), sticky(u64.shiftLeft(rhi, 54))), 10))
      if negative { integer = -integer }
      result = i64.toF64(integer)
    }
  }
  return scaleByPowerOfTwo(result, e)
}

// value * 2^exponent, rounded once even when the result is subnormal.
fn scaleByPowerOfTwo(value: f64, exponent: i32) -> f64 {
  let mut y = value
  let mut n = exponent
  if n > 1023 {
    y = y * fromBits(0x7FE0000000000000)
    n = n - 1023
    if n > 1023 {
      y = y * fromBits(0x7FE0000000000000)
      n = n - 1023
      if n > 1023 { n = 1023 }
    }
  } else if n < -1022 {
    // Leave a final exponent below -53 so that subnormal results round once.
    y = y * fromBits(0x0360000000000000)
    n = n + 1022 - 53
    if n < -1022 {
      y = y * fromBits(0x0360000000000000)
      n = n + 1022 - 53
      if n < -1022 { n = -1022 }
    }
  }
  return y * fromBits(u64.shiftLeft(i32.toU64(0x3FF + n), 52))
}

/// Converts to binary32 with round-to-nearest ties-to-even.
///
/// # Details
///
/// A finite value too large for binary32 becomes infinity; NaN remains NaN.
pub fn toF32(value: f64) -> f32 {
  return Intrinsic.f64ToF32(value)
}

/// Returns the same binary64 value unchanged.
pub fn toF64(value: f64) -> f64 {
  return Intrinsic.f64ToF64(value)
}

/// Converts `value` toward zero to `u8`. Traps for NaN, infinity, or a result
/// outside the `u8` range.
pub fn toU8(value: f64) -> u8 {
  if let Option<u8>.Some {value: converted} = checkedToU8(value) { return converted }
  return Intrinsic.trap("f64.toU8: the value is NaN, infinite, or outside the u8 range")
}

// The pointer-width conversion bounds, as exact powers of two in binary64. They are
// selected from the target's pointer width rather than converted from `usize.MAX`/`isize.MAX`,
// which would round outward and admit an overflowing value.
fn usizeBound() -> f64 {
  if pointerBits == 32 { return 4294967296.0 }
  return 18446744073709551616.0
}

fn isizeUpperBound() -> f64 {
  if pointerBits == 32 { return 2147483648.0 }
  return 9223372036854775808.0
}

fn isizeLowerBound() -> f64 {
  if pointerBits == 32 { return -2147483648.0 }
  return -9223372036854775808.0
}

/// Converts `value` toward zero to `u8`, or returns `None` when the truncated result is out of
/// range.
///
/// # When to use
///
/// Use this function when a NaN, an infinity, or an out-of-range magnitude is input data rather
/// than a program error. [`toU8`] traps on exactly the inputs this function reports as `None`.
///
/// # Details
///
/// The fraction is discarded first, so the range test applies to the truncated value: a magnitude
/// below one is in range and yields zero. The truncated value is accepted when it is at least zero
/// and below `2^8`. Both bounds are powers of two and so are exact in binary64. A bound converted
/// from `u8.MAX` would round outward and wrongly admit an overflowing value.
///
/// # Gotchas
///
/// NaN and either infinity return `None`. A value in `(-1.0, -0.0]` truncates to negative zero and
/// converts to `0`, so its sign is discarded rather than rejected.
pub fn checkedToU8(value: f64) -> Option<u8> {
  if Intrinsic.f64IsNaN(value) { return Option<u8>.none() }
  if Intrinsic.f64IsInfinite(value) { return Option<u8>.none() }
  let truncated = trunc(value)
  if truncated < 0.0 { return Option<u8>.none() }
  if truncated >= 256.0 { return Option<u8>.none() }
  return Option<u8>.some(Intrinsic.f64ToU8(truncated))
}

/// Converts `value` toward zero to `u16`. Traps for NaN, infinity, or a result
/// outside the `u16` range.
pub fn toU16(value: f64) -> u16 {
  if let Option<u16>.Some {value: converted} = checkedToU16(value) { return converted }
  return Intrinsic.trap("f64.toU16: the value is NaN, infinite, or outside the u16 range")
}

