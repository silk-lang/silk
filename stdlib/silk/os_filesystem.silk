//! Native [`FileSystem`] provider confined beneath one explicitly owned platform root.
//!
//! # When to use
//! Construct [`OsFileSystem`] at a native application edge and provide it to portable filesystem
//! code. Supply an in-memory [`FileSystem`] in tests or on targets without native OS access.
//!
//! # Details
//! Portable `/` denotes the provider root rather than the host filesystem root. The native boundary
//! rejects malformed portable paths and never follows symlinks below the configured root.
//! Ordinary writes retain create-or-truncate semantics and can leave a partial file on failure.
//! Exclusive creation refuses every existing entry with AlreadyExists; once claimed, a write or
//! close failure leaves the new, possibly partial file in place. Atomic writes instead publish
//! complete contents with renameat (replace) or linkat/unlinkat (create-new), staging in the same
//! directory under an exclusively claimed temporary name. Replace can replace a final symlink
//! entry itself, never its referent; directories and other unsupported destination kinds are refused.
//! Directory listings sort complete child paths deterministically. Low-level failures become
//! portable [`FileError`] values with retained native codes.
//!
//! Newly created or atomically published inodes use mode 0666 filtered by the process umask and
//! normal filesystem inheritance. Atomic replacement preserves no old permission bits, ownership,
//! ACLs, extended attributes or hard-link identity; existing hard links retain the old inode.
//! Synchronized atomic writes fsync the actual staged descriptor before publication, then fsync
//! the owned parent after publication and staging cleanup. `FileSystem.syncDirectory` also uses fsync.
//! On Darwin and GNU/Linux these are ordinary filesystem synchronization, not F_FULLFSYNC or
//! guarantees about hardware caches or physical power-loss recovery. Unsupported synchronization
//! fails explicitly rather than silently downgrading.
//!
//! [`make`] copies its root. The root must be an absolute, non-empty, NUL-free native path. A root
//! that violates this precondition traps. Open handles close on success and failure; close is never
//! retried after EINTR. An earlier failure takes precedence over close failure. [`AtomicWriteError`]
//! distinguishes failure before publication from failure after complete new contents became visible,
//! and retains a separate staging-cleanup failure plus its exact residual temporary leaf name.
//! The configured root and its ancestors must be trusted; confinement does not promise protection
//! against hostile directory renames, privileged mount changes, or tampering with staging entries.
//!
//! Constructing the provider performs no filesystem operation beyond owning the root bytes.
//! Portable code uses `FileSystem` operations after the application supplies `&mut OsFileSystem`
//! for the `&mut FileSystem` requirement.
//!
//! # Gotchas
//! This module publishes its provider only for the supported native profiles.
//! WebAssembly selection leaves the module empty.
//!
//! # Examples
//! ## Construct a provider without accessing the filesystem
//!
//! ```silk
//! import silk.allocator { Allocator, OutOfMemoryError }
//!
//! import silk.effect { Effect }
//!
//! import silk.os_filesystem { OsFileSystem }
//!
//! effect fn program() -> i32
//! ! OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let provider = run OsFileSystem.make(b"/tmp")
//!     |> Effect.provideMut<Allocator>(&mut allocator)
//!   drop provider
//!   return 42
//! }
//!
//! effect fn recover(error: OutOfMemoryError) -> i32 {
//!   return 0
//! }
//!
//! pub fn main() -> i32 {
//!   return run Effect.catchAll(program(), recover)
//! }
//! ```

static if (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText("libc") == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
  import silk.native_filesystem { NativeFileSystem, FileHandle, DirectoryHandle }
  import silk.u64
  import silk.bool
  import silk.effect { Effect }
  import silk.bytes { Bytes }
  import silk.allocator { Allocator, OutOfMemoryError }
  import silk.filesystem { DirectoryEntry, DirectoryInfo, FileError, FileInfo, FileOperation, FileReason, FileSystem, Path, PublicationPolicy, Durability, AtomicWriteError }
  import silk.i32
  import silk.result { Result }
  import silk.u8
  import silk.usize
  import silk.vector { Vector }

  /// A native [`FileSystem`] provider confined beneath one independently owned platform root.
  ///
  /// # Details
  ///
  /// Portable absolute paths resolve inside this root. The provider never exposes the root as a
  /// [`Path`], and operations reject lexical or symbolic-link escape from the root.
  pub struct OsFileSystem {
    root: Bytes
    counter: u64
  }

  impl OsFileSystem {
    effect fn readFile(
      self: &mut Self,
      path: &Path
    ) -> Bytes ! FileError | OutOfMemoryError ? &mut Allocator {
      let mut handle = run NativeFileSystem.openFile(Bytes.asSlice(&self.root), Path.rawBytes(path), false, 0)
      let attempted = run Effect.result(readLoop(&mut handle))
      let closed = run Effect.result(NativeFileSystem.closeFile(move handle, FileSystem.readFileOperation()))
      return match move attempted {
        Result<Bytes, FileError | OutOfMemoryError>.Success { value: bytes } => match move closed {
          Result<(), FileError>.Success { value: completed } => move bytes
          Result<(), FileError>.Failure { error: closeFailure } => run discardThenReroute<Bytes>(move bytes, move closeFailure)
        }
        Result<Bytes, FileError | OutOfMemoryError>.Failure { error: primary } => match move primary {
          FileError failure => run preserveFile(move failure, move closed)
          OutOfMemoryError exhausted => run preserveOutOfMemory(move exhausted, move closed)
        }
      }
    }

    effect fn writeFile(self: &mut Self, path: &Path, bytes: &[u8]) -> () ! FileError {
      let mut handle = run NativeFileSystem.openFile(Bytes.asSlice(&self.root), Path.rawBytes(path), true, 1)
      let attempted = run Effect.result(writeLoop(&mut handle, bytes))
      let closed = run Effect.result(NativeFileSystem.closeFile(move handle, FileSystem.writeFileOperation()))
      return match move attempted {
        Result<(), FileError>.Success { value: completed } => match move closed {
          Result<(), FileError>.Success { value: closedValue } => ()
          Result<(), FileError>.Failure { error: closeFailure } => run rerouteFile(move closeFailure)
        }
        Result<(), FileError>.Failure { error: primary } => run preserveFile(move primary, move closed)
      }
    }

    /// Claims an absent entry exclusively; later write or close failure leaves the new file in place.
    effect fn createFile(self: &mut Self, path: &Path, bytes: &[u8]) -> () ! FileError {
      return run NativeFileSystem.createFile(Bytes.asSlice(&self.root), Path.rawBytes(path), bytes)
    }

    /// Publishes complete contents with explicit replacement, synchronization and failure-phase policy.
    ///
    /// This is one-file atomic visibility, not a transaction over several paths. A published failure
    /// must not be blindly retried: new contents are already visible even if synchronization failed.
    effect fn writeFileAtomic(
      self: &mut Self,
      path: &Path,
      bytes: &[u8],
      policy: PublicationPolicy,
      durability: Durability
    ) -> () ! AtomicWriteError {
      let mut counter = self.counter
      let attempted = run Effect.result(NativeFileSystem.writeFileAtomic(Bytes.asSlice(&self.root), Path.rawBytes(path), bytes, policy.code, durability.code, &mut counter))
      self.counter = counter
      match move attempted {
        Result<(), AtomicWriteError>.Success { value } => ()
        Result<(), AtomicWriteError>.Failure { error } => { fail move error }
      }
    }

    /// Synchronizes a no-follow directory descriptor; unsupported filesystem guarantees fail explicitly.
    effect fn syncDirectory(self: &mut Self, path: &Path) -> () ! FileError {
      return run NativeFileSystem.syncDirectory(Bytes.asSlice(&self.root), Path.rawBytes(path))
    }

    effect fn stat(self: &mut Self, path: &Path) -> FileInfo | DirectoryInfo ! FileError {
      let mut kind = 0
      let mut byteLength = usize.ZERO
      run NativeFileSystem.inspect(Bytes.asSlice(&self.root), Path.rawBytes(path), &mut kind, &mut byteLength, 2)
      if kind == 0 { return FileSystem.fileInfo(byteLength) }
      return FileSystem.directoryInfo()
    }

    effect fn listDirectory(
      self: &mut Self,
      path: &Path
    ) -> Vector<DirectoryEntry> ! FileError | OutOfMemoryError ? &mut Allocator {
      let mut handle = run NativeFileSystem.openDirectory(Bytes.asSlice(&self.root), Path.rawBytes(path), 3)
      let attempted = run Effect.result(listLoop(&mut handle, path))
      let closed = run Effect.result(NativeFileSystem.closeDirectory(move handle, FileSystem.listDirectoryOperation()))
      return match move attempted {
        Result<Vector<DirectoryEntry>, FileError | OutOfMemoryError>.Success { value: entries } => match move closed {
          Result<(), FileError>.Success { value: completed } => move entries
          Result<(), FileError>.Failure { error: closeFailure } => run discardThenReroute<Vector<DirectoryEntry>>(move entries, move closeFailure)
        }
        Result<Vector<DirectoryEntry>, FileError | OutOfMemoryError>.Failure { error: primary } => match move primary {
          FileError failure => run preserveFile(move failure, move closed)
          OutOfMemoryError exhausted => run preserveOutOfMemory(move exhausted, move closed)
        }
      }
    }

    /// Creates one uniquely named FileSystem.directory under `parent` and returns its complete Path.
    ///
    /// The provider chooses the name's unique part, so the created name comes back rather than going
    /// in. A buffer too small for that name creates nothing and reports the capacity it needs, which
    /// is why the retry below is safe to take.
    effect fn createTemporaryDirectory(
      self: &mut Self,
      parent: &Path,
      prefix: &[u8]
    ) -> Path ! FileError | OutOfMemoryError ? &mut Allocator {
      let mut buffer = run Bytes.zeroed(64)
      let mut required: usize = 0
      let mut length: usize = 0
      let mut complete = false
      while complete == false {
        let mut counter = self.counter
        let attempted = run Effect.result(NativeFileSystem.createUnique(Bytes.asSlice(&self.root), Path.rawBytes(parent), prefix, &mut counter, Bytes.asMutSlice(&mut buffer), &mut length, &mut required, 8))
        self.counter = counter
        complete = match move attempted {
          Result<bool, FileError>.Success { value } => value
          Result<bool, FileError>.Failure { error } => run rerouteFile(move error)
        }
        if complete == false { buffer = run Bytes.zeroed(required) }
      }
      let mut name = Bytes.make()
      let view = Bytes.asSlice(&buffer)
      let mut index: usize = 0
      while index < length {
        let one = [view[index]]
        run Bytes.append(&mut name, &one)
        index = index + 1
      }
      return run Path.joinBytes(parent, Bytes.asSlice(&name))
    }

    effect fn createDirectory(self: &mut Self, path: &Path) -> () ! FileError {
      return run command(move self, path, FileSystem.createDirectoryOperation(), 0)
    }

    effect fn removeFile(self: &mut Self, path: &Path) -> () ! FileError {
      return run command(move self, path, FileSystem.removeFileOperation(), 1)
    }

    effect fn removeDirectory(self: &mut Self, path: &Path) -> () ! FileError {
      return run command(move self, path, FileSystem.removeDirectoryOperation(), 2)
    }
  }

  impl OsFileSystem {
    /// Copies one absolute native root and creates a confined filesystem provider.
    ///
    /// # When to use
    ///
    /// Use this function at a native application edge. Provide the result as `&mut FileSystem` to code
    /// that uses the portable filesystem service.
    ///
    /// # Details
    ///
    /// Construction owns the root bytes but does not open the directory. Portable `/` then denotes
    /// this provider root instead of the host filesystem root.
    ///
    /// # Gotchas
    ///
    /// `root` must be non-empty, absolute, and NUL-free. A value that violates this precondition traps.
    /// Allocation failure leaves no provider value.
    pub effect fn make(root: &[u8]) -> OsFileSystem ! OutOfMemoryError ? &mut Allocator {
      let rootBytes = root
      if rootBytes.length == usize.ZERO { let invalid = 1 / 0 }
      if rootBytes[usize.ZERO] != u8.toU8(47) { let invalid = 1 / 0 }
      let mut index = usize.ZERO
      while index < rootBytes.length {
        if rootBytes[index] == u8.toU8(0) { let invalid = 1 / 0 }
        index = index + usize.ONE
      }
      let owned = run Bytes.copy(rootBytes)
      return OsFileSystem { root: move owned, counter: 0 }
    }
  }

  fn pathBytes(path: &Path) -> &[u8] {
    return Path.rawBytes(path)
  }

  fn ignoreClose(result: Result<(), FileError>) -> () {
    return match move result {
      Result<(), FileError>.Success { value: completed } => ()
      Result<(), FileError>.Failure { error: failure } => ()
    }
  }

  effect fn rerouteFile(error: FileError) -> never ! FileError { fail move error }
  effect fn rerouteOutOfMemory(error: OutOfMemoryError) -> never ! OutOfMemoryError { fail move error }

  effect<'env> fn discardThenReroute<T: 'env, 'env>(value: T, error: FileError) -> never ! FileError {
    drop value
    fail move error
  }

  effect fn preserveFile(error: FileError, closed: Result<(), FileError>) -> never ! FileError {
    let ignored = ignoreClose(move closed)
    fail move error
  }

  effect fn preserveOutOfMemory(
    error: OutOfMemoryError,
    closed: Result<(), FileError>
  ) -> never ! OutOfMemoryError {
    let ignored = ignoreClose(move closed)
    fail move error
  }

  effect fn readLoop(handle: &mut FileHandle) -> Bytes ! FileError | OutOfMemoryError ? &mut Allocator {
    let mut result = Bytes.make()
    let mut buffer = run Bytes.zeroed(256)
    let mut complete = false
    while complete == false {
      let length = run NativeFileSystem.readFile(&mut handle, Bytes.asMutSlice(&mut buffer), 0)
      if length == 0 { complete = true } else {
        let view = Bytes.asSlice(&buffer)
        let mut index: usize = 0
        while index < length {
          let one = [view[index]]
          run Bytes.append(&mut result, &one)
          index = index + 1
        }
      }
    }
    return move result
  }

  effect fn writeLoop(handle: &mut FileHandle, bytes: &[u8]) -> () ! FileError {
    return run NativeFileSystem.writeFile(move handle, bytes, 1)
  }

  effect fn listLoop(
    handle: &mut DirectoryHandle,
    parent: &Path
  ) -> Vector<DirectoryEntry> ! FileError | OutOfMemoryError ? &mut Allocator {
    let mut entries = Vector<DirectoryEntry>.make()
    let initialBuffer = Bytes.zeroed(64)
    let mut buffer = run initialBuffer
    let mut complete = false
    while complete == false {
      let mut kind = 0
      let mut required = usize.ZERO
      let mut length = usize.ZERO
      let next = run NativeFileSystem.next(&mut handle, Bytes.asMutSlice(&mut buffer), &mut length, &mut required, &mut kind, 3)
      if next == false {
        buffer = run Bytes.zeroed(required)
      } else {
        if length == usize.ZERO {
          complete = true
        } else {
          let view = Bytes.asSlice(&buffer)
          let mut name = Bytes.make()
          let mut index = usize.ZERO
          while index < length {
            let one = [view[index]]
            let appended = run Bytes.append(&mut name, &one)
            index = index + usize.ONE
          }
          let child = run Path.joinBytes(parent, Bytes.asSlice(&name))
          let mut entryKind = FileSystem.directory()
          if kind == 0 { entryKind = FileSystem.file() }
          let insertion = insertionFor(&child, Vector<DirectoryEntry>.asSlice(&entries))
          let inserted = run Vector<DirectoryEntry>.insert(
            &mut entries,
            insertion,
            FileSystem.directoryEntry(move child, move entryKind)
          )
        }
      }
    }
    return move entries
  }

  fn insertionFor(child: &Path, existing: &[DirectoryEntry]) -> usize {
    let mut insertion = usize.ZERO
    while insertion < existing.length {
      let before = match &existing[insertion] {
        DirectoryEntry { path, kind } => pathLess(child, &path)
      }
      if before { return insertion }
      insertion = insertion + usize.ONE
    }
    return insertion
  }

  fn pathLess(left: &Path, right: &Path) -> bool {
    let leftBytes = pathBytes(left)
    let rightBytes = pathBytes(right)
    let mut index = usize.ZERO
    while index < leftBytes.length {
      if rightBytes.length <= index { return false }
      if leftBytes[index] < rightBytes[index] { return true }
      if rightBytes[index] < leftBytes[index] { return false }
      index = index + usize.ONE
    }
    if leftBytes.length < rightBytes.length { return true }
    return false
  }

  effect fn command(
    self: &mut OsFileSystem,
    path: &Path,
    operation: FileOperation,
    selector: i32
  ) -> () ! FileError {
    return run NativeFileSystem.command(Bytes.asSlice(&self.root), Path.rawBytes(path), selector, operation.code)
  }

  impl FileSystem for OsFileSystem {
    readFile: OsFileSystem.readFile
    writeFile: OsFileSystem.writeFile
    createFile: OsFileSystem.createFile
    writeFileAtomic: OsFileSystem.writeFileAtomic
    syncDirectory: OsFileSystem.syncDirectory
    stat: OsFileSystem.stat
    listDirectory: OsFileSystem.listDirectory
    createDirectory: OsFileSystem.createDirectory
    removeFile: OsFileSystem.removeFile
    removeDirectory: OsFileSystem.removeDirectory
    createTemporaryDirectory: OsFileSystem.createTemporaryDirectory
  }
}
