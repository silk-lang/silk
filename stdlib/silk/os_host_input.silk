//! Native HostInput provider backed by an owned process-input snapshot.
//!
//! # When to use
//! Capture NativeHostInput at the application boundary and move it into this provider. Portable
//! code receives it through the mutable HostInput service and obtains independent owned results.
//!
//! # Details
//! Arguments and environment retain their captured bytes. Working-directory lookup observes the
//! current process directory on each call. Dropping the provider releases the complete snapshot.
//!
//! # Gotchas
//! Available only on the supported native libc profiles. Capturing foreign input requires that
//! its storage remain readable and unchanged throughout capture.

static if (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText("libc") == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
  import silk.allocator { Allocator, OutOfMemoryError }
  import silk.bytes { Bytes }
  import silk.host_input { HostInput, HostInputError }
  import silk.native_host_input { NativeHostInput }
  import silk.option { Option }
  import silk.string { String }

  /// An affine HostInput provider owning its argument and environment snapshot.
  pub struct OsHostInput { inputs: NativeHostInput }

  impl OsHostInput {
    /// Moves an already captured snapshot into the portable service provider.
    ///
    /// # Details
    /// Construction reads no foreign state and performs no allocation.
    pub fn make(inputs: NativeHostInput) -> OsHostInput {
      return OsHostInput { inputs: move inputs }
    }

    effect fn argumentCount(self: &mut Self) -> usize ! HostInputError {
      return NativeHostInput.argumentCount(&self.inputs)
    }

    effect fn argument(self: &mut Self, index: usize) -> Option<Bytes> ! HostInputError | OutOfMemoryError ? &mut Allocator {
      return run fetch(&self.inputs, true, index, String.utf8Bytes(""))
    }

    effect fn variable(self: &mut Self, name: &[u8]) -> Option<Bytes> ! HostInputError | OutOfMemoryError ? &mut Allocator {
      return run fetch(&self.inputs, false, 0, name)
    }

    effect fn workingDirectory(self: &mut Self) -> Bytes ! HostInputError | OutOfMemoryError ? &mut Allocator {
      return run NativeHostInput.workingDirectory()
    }
  }

  fn lookup(inputs: &NativeHostInput, argument: bool, index: usize, name: &[u8], output: &mut [u8]) -> Option<usize> {
    if argument { return NativeHostInput.argument(inputs, index, move output) }
    return NativeHostInput.variable(inputs, name, move output)
  }

  effect fn fetch(inputs: &NativeHostInput, argument: bool, index: usize, name: &[u8]) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
    let mut empty = Bytes.make()
    let found = lookup(inputs, argument, index, name, Bytes.asMutSlice(&mut empty))
    return match move found {
      Option<usize>.None => Option<Bytes>.none()
      Option<usize>.Some { value: length } => {
        let mut bytes = run Bytes.zeroed(length)
        let copied = lookup(inputs, argument, index, name, Bytes.asMutSlice(&mut bytes))
        return Option<Bytes>.some(move bytes)
      }
    }
  }

  impl HostInput for OsHostInput {
    argumentCount: OsHostInput.argumentCount
    argument: OsHostInput.argument
    variable: OsHostInput.variable
    workingDirectory: OsHostInput.workingDirectory
  }
}
