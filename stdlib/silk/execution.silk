//! Independently owned, caller-funded lazy computations with explicit external parking.
//!
//! # When to use
//! Use [`make`] when a lazy Effect must outlive the caller which constructs it and be resumed by a
//! later owner. Use [`park`] inside the body when readiness comes from an external registration.
//! Use [`drive`] for the initial activation and each later eligible activation.
//!
//! # Details
//! Construction obtains one combined package from the selected `Allocator`
//! and does not start the Effect. The body representation, continuation, and fixed readiness
//! endpoint remain private. A nested `Effect.suspend` transfers execution
//! immediately. In contrast, [`park`] relinquishes the Execution until one [`Wake`] makes it
//! eligible. The readiness phase and the park generation are ordinary source policy kept together
//! in one package control word; the compiler only loads, stores and compare-exchanges it. A Wake
//! may be signaled from another thread: every transition is one compare-exchange of that word,
//! and readiness is published before the endpoint runs (EXEC-009).
//!
//! Use [`makeTransferable`] for an Execution that a thread-capable owner moves between threads.
//! Its handle is a [`TransferableExecution`], and its body parks with [`parkTransferable`], whose
//! [`TransferableWake`] may be signaled from any thread (EXEC-010).
//!
//! # Gotchas
//! `Execution` is affine. The readiness callback must be detached and non-parking. [`make`] can
//! report package allocation refusal. Later private execution-stack growth is a fatal trap.
//! Dropping a dormant Execution cancels it. A retained Wake keeps the complete inert package alive
//! until the Wake is consumed or dropped. [`drive`] returns continued ownership only to
//! `onSuspend`.

import silk.allocator { Allocator, OutOfMemoryError }
import silk.thread { Concurrent, Transferable }

// Control word 0 holds the park generation times `PHASES` plus the readiness phase, so one
// compare-exchange checks a Wake's generation and moves its phase together.
const STATE: usize = 0
const PHASES: usize = 8

const INITIAL: usize = 0
const INITIAL_READY: usize = 1
const RUNNING: usize = 2
const REGISTERING: usize = 3
const LATCHED: usize = 4
const DORMANT: usize = 5
const ELIGIBLE: usize = 6

// Control word 1 records how the package was made. Only `makeTransferable` sets it, before the
// handle leaves the constructor, so a set word proves the body and endpoint passed its bounds.
const MODE: usize = 1
const TRANSFERABLE: usize = 1

/// The affine readiness authority for one parked generation of one Execution.
///
/// # Details
///
/// [`Execution.park`] passes the generation's only Wake to its registration callback.
/// [`Execution.wake`] consumes it and makes that generation eligible at most once.
///
/// # Gotchas
///
/// Dropping a Wake publishes nothing. A retained Wake keeps the inert package allocation alive
/// after the Execution is dropped, until the Wake is consumed or dropped.
pub struct Wake {
  reference: Intrinsic.ExecutionRef
  generation: usize
}

/// A Wake that may move to another thread and be signaled there.
///
/// # Details
///
/// [`Execution.parkTransferable`] passes the generation's only TransferableWake to its
/// registration callback. [`Execution.wakeTransferable`] consumes it from any thread.
///
/// # Gotchas
///
/// It has the same lifetime rules as [`Wake`]: dropping it publishes nothing, and a retained one
/// keeps the inert package allocation alive.
pub struct TransferableWake {
  wake: Wake
}

// Only `parkTransferable` builds one, and only for a package made by `makeTransferable`, whose
// endpoint is Transferable and Concurrent, so the endpoint may run on the signaling thread.
impl Transferable for TransferableWake {}

/// The owner of an Execution made by [`Execution.makeTransferable`], which may move to another thread.
///
/// # Details
///
/// [`local`] gives back the `Intrinsic.Execution<A>` handle that [`Execution.drive`] takes, and
/// [`adopt`] wraps a handle again, such as the dormant one `onSuspend` receives. The wrapper is
/// `Transferable` when `A` is.
///
/// # Gotchas
///
/// Adopting a handle that [`Execution.make`] created is a fatal trap.
pub struct TransferableExecution<A> {
  execution: Intrinsic.Execution<A>
}

// The body, result and endpoint passed `makeTransferable`'s thread bounds, and the package
// protocol is atomic (EXEC-009), so the handle may be driven and dropped on another thread.
impl<A: Transferable> Transferable for TransferableExecution<A> {}

impl<A> TransferableExecution<A> {
  /// Wraps a handle to a package made by [`Execution.makeTransferable`].
  ///
  /// # Gotchas
  ///
  /// A handle made by [`Execution.make`] is a fatal state trap.
  pub fn adopt(execution: Intrinsic.Execution<A>) -> TransferableExecution<A> {
    let reference = Intrinsic.executionRefOf<A>(&execution)
    if Intrinsic.executionLoad(&reference, MODE) != TRANSFERABLE { invalidState() }
    return TransferableExecution<A> { execution: move execution }
  }

  /// Gives back the handle so the current thread can drive or drop it.
  pub fn local(self: Self) -> Intrinsic.Execution<A> {
    let TransferableExecution<A> { execution } = move self
    return move execution
  }

  /// Notifies the fixed readiness endpoint for one `Initial` Execution exactly once.
  ///
  /// # Details
  ///
  /// This is [`Execution.notifyInitial`] for the wrapped handle.
  pub fn notifyInitial(self: &mut Self) -> () {
    Execution.notifyInitial<A>(&mut self.execution)
    return ()
  }
}

/// The owner of the execution lifecycle operations.
///
/// # Details
///
/// This struct carries no data and is never constructed by the library. Every operation is an
/// inherent member declared in `impl Execution`, so `import silk.execution { Execution }` is the
/// one import that reaches `Execution.make(...)` and the rest. It is unrelated to the builtin
/// `Intrinsic.Execution<A>` type.
pub struct Execution {}

impl Execution {
  /// Allocates one combined package and transfers the lazy body and fixed endpoint into it.
  ///
  /// # Details
  ///
  /// The returned Execution is `Initial`. The body does not start during this call. Allocation refusal
  /// produces no Execution and leaves every input under ordinary Effect cleanup. Later private stack
  /// growth is a fatal trap and is not a `OutOfMemoryError`.
  pub effect<'static> fn make<
    A,
    F: once Effect<'static; A> + Intrinsic.Detached,
    O: Intrinsic.Detached,
    R: fn<'static>(&O) -> () + Intrinsic.Detached + Intrinsic.NonParking
  >(body: F, readyState: O, onReady: R) -> Intrinsic.Execution<A>
  ! OutOfMemoryError
  ? &mut Allocator {
    let layout = Intrinsic.executionLayout<A, F, O, R>()
    let allocation = run Allocator.allocate(move layout)
    unsafe {
      return Intrinsic.executionFromAllocation<A, F, O, R>(
        move allocation,
        move body,
        move readyState,
        move onReady
      )
    }
    return absurd<Intrinsic.Execution<A>>()
  }

  /// Allocates one package whose handle and Wakes may move to other threads.
  ///
  /// # Details
  ///
  /// This is [`make`] with thread bounds. The body and result must be `Transferable`, because the
  /// body may resume on any thread that drives it. The endpoint and its state must be
  /// `Transferable` and `Concurrent`, because each [`TransferableWake`] runs the endpoint on the
  /// thread that signals it. The body parks with [`parkTransferable`].
  ///
  /// # Gotchas
  ///
  /// Values the body creates itself need no bound: Silk has no thread-local or global storage, so
  /// nothing outside the body can reach them while it moves between threads.
  pub effect<'static> fn makeTransferable<
    A: Transferable,
    F: once Effect<'static; A> + Intrinsic.Detached + Transferable,
    O: Intrinsic.Detached + Transferable + Concurrent,
    R: fn<'static>(&O) -> () + Intrinsic.Detached + Intrinsic.NonParking + Transferable + Concurrent
  >(body: F, readyState: O, onReady: R) -> TransferableExecution<A>
  ! OutOfMemoryError
  ? &mut Allocator {
    let execution = run Execution.make<A, F, O, R>(move body, move readyState, move onReady)
    let reference = Intrinsic.executionRefOf<A>(&execution)
    Intrinsic.executionStore(&reference, MODE, TRANSFERABLE)
    return TransferableExecution<A> { execution: move execution }
  }

  /// Drives one `Initial`, `InitialReady`, or `Eligible` activation and transfers `branchState` to one outcome callback.
  ///
  /// # Details
  ///
  /// Completion calls `onComplete`. Relinquishment calls `onSuspend` with the dormant Execution.
  /// Each activation calls exactly one callback. Nested transfer can complete in the same drive.
  /// External parking relinquishes ownership until the fixed readiness endpoint reports eligibility.
  /// The body starts an independent diagnostic invocation. Install observation inside the body to
  /// retain it across parking. Outcome callbacks run in the driving caller's diagnostic context.
  ///
  /// # Gotchas
  ///
  /// Driving a dormant, notifying, completed, or destroyed Execution is a fatal state trap.
  pub effect<'env> fn drive<
    'env,
    A: 'env,
    D: 'env,
    C: once fn<'env>(D, A) -> () + Intrinsic.NonParking,
    S: once fn<'env>(D, Intrinsic.Execution<A>) -> () + Intrinsic.NonParking
  >(
    execution: Intrinsic.Execution<A>,
    branchState: D,
    onComplete: C,
    onSuspend: S
  ) -> () {
    let reference = Intrinsic.executionRefOf<A>(&execution)
    let state = Intrinsic.executionLoad(&reference, STATE)
    let phase = state % PHASES
    if phase != INITIAL && phase != INITIAL_READY && phase != ELIGIBLE { invalidState() }
    Intrinsic.executionStore(&reference, STATE, state - phase + RUNNING)
    run Intrinsic.executionDrive<A, D, C, S>(
      move execution,
      move branchState,
      move onComplete,
      move onSuspend
    )
    // A parked body left its generation Registering. Its frames are stored and its owner holds it
    // again, so it becomes Dormant now, or Eligible if a signal was latched meanwhile.
    if Intrinsic.executionLive(&reference) {
      let parked = Intrinsic.executionLoad(&reference, STATE)
      let base = parked - parked % PHASES
      if parked % PHASES == REGISTERING {
        let observed = Intrinsic.executionCompareExchange(&reference, STATE, parked, base + DORMANT)
        if observed == base + LATCHED { notifyReady(&reference, observed) }
      } else if parked % PHASES == LATCHED {
        notifyReady(&reference, parked)
      }
    }
    return ()
  }

  /// Notifies the fixed readiness endpoint for one `Initial` Execution exactly once.
  ///
  /// # Details
  ///
  /// This operation changes the package to `InitialReady` before it invokes the endpoint. It is
  /// synchronous, does not park, and does not run the body. A later [`drive`] starts the body.
  ///
  /// # Gotchas
  ///
  /// The Execution must still be `Initial`. Calling this operation again, or calling it after the
  /// Execution has been driven, parked, completed, or destroyed, is a fatal state trap.
  pub fn notifyInitial<A>(execution: &mut Intrinsic.Execution<A>) -> () {
    let reference = Intrinsic.executionRefOf<A>(&execution.*)
    if Intrinsic.executionCompareExchange(&reference, STATE, INITIAL, INITIAL_READY) != INITIAL { invalidState() }
    Intrinsic.executionNotify(&reference)
    return ()
  }

  /// Relinquishes the currently Running Execution until one external readiness signal arrives.
  ///
  /// # Details
  ///
  /// The registration callback receives the generation's sole affine [`Wake`]. Its returned guard
  /// is retained while dormant and dropped immediately before source continues after this call.
  /// A Wake signaled during registration is latched until [`drive`] returns this Execution to its
  /// owner, which then notifies. The Wake invokes the fixed readiness endpoint at most one time.
  ///
  /// # Gotchas
  ///
  /// A caller that keeps a cancelled Wake also keeps the complete inert Execution package alive.
  /// Consuming or dropping that Wake releases the final package authority.
  pub effect fn park<
    'env,
    G,
    F: once fn<'env>(Wake) -> G + Intrinsic.NonParking
  >(register: F) -> () {
    let reference = run Intrinsic.executionCurrent()
    // Only this body writes the word while it runs, and no Wake for the new generation exists yet.
    let state = Intrinsic.executionLoad(&reference, STATE)
    let generation = state / PHASES + 1
    Intrinsic.executionStore(&reference, STATE, generation * PHASES + REGISTERING)
    let wakeReference = run Intrinsic.executionCurrent()
    let guard = register(Wake { reference: move wakeReference, generation: generation })
    // The generation stays Registering, or Latched, until drive holds the relinquished Execution.
    drop reference
    run Intrinsic.relinquish()
    drop guard
    return ()
  }

  /// Relinquishes the currently Running Execution and passes a [`TransferableWake`] to `register`.
  ///
  /// # Details
  ///
  /// This is [`park`] for a body made by [`makeTransferable`]. The Wake may be sent to another
  /// thread and signaled there with [`wakeTransferable`].
  ///
  /// # Gotchas
  ///
  /// Calling it from a body made by [`make`] is a fatal state trap, since that endpoint may not
  /// run on another thread.
  pub effect fn parkTransferable<
    'env,
    G,
    F: once fn<'env>(TransferableWake) -> G + Intrinsic.NonParking
  >(register: F) -> () {
    let reference = run Intrinsic.executionCurrent()
    if Intrinsic.executionLoad(&reference, MODE) != TRANSFERABLE { invalidState() }
    let state = Intrinsic.executionLoad(&reference, STATE)
    let generation = state / PHASES + 1
    Intrinsic.executionStore(&reference, STATE, generation * PHASES + REGISTERING)
    let wakeReference = run Intrinsic.executionCurrent()
    let wake = Wake { reference: move wakeReference, generation: generation }
    let guard = register(TransferableWake { wake: move wake })
    drop reference
    run Intrinsic.relinquish()
    drop guard
    return ()
  }

  /// Consumes one TransferableWake on any thread and makes its parked generation eligible.
  ///
  /// # Details
  ///
  /// This is [`wake`]; when it publishes readiness, the endpoint runs on the calling thread.
  pub fn wakeTransferable(wake: TransferableWake) -> () {
    let TransferableWake { wake: inner } = move wake
    Execution.wake(move inner)
    return ()
  }

  /// Consumes one Wake and makes its parked generation eligible.
  ///
  /// # Details
  ///
  /// A Wake signaled while its generation is still registering is latched until the owner receives
  /// the Execution back from [`drive`]. A Wake signaled while its generation is dormant makes the
  /// Execution eligible and synchronously invokes its fixed readiness endpoint. Signaling never
  /// drives the Execution.
  ///
  /// # Gotchas
  ///
  /// A Wake for a dropped or completed Execution, or for an earlier generation, publishes nothing
  /// and only releases its package authority.
  pub fn wake(wake: Wake) -> () {
    let Wake { reference, generation } = move wake
    if !Intrinsic.executionLive(&reference) { return () }
    let base = generation * PHASES
    let latching = Intrinsic.executionCompareExchange(&reference, STATE, base + REGISTERING, base + LATCHED)
    if latching == base + REGISTERING { return () }
    if latching == base + DORMANT { notifyReady(&reference, latching) }
    return ()
  }
}

// Publishes `Eligible` for the generation in `state`, then runs the endpoint. Readiness is visible
// before the endpoint queues the Execution, so its next owner may drive it at once (EXEC-009).
// Only the transition's winner notifies.
fn notifyReady(reference: &Intrinsic.ExecutionRef, state: usize) -> () {
  let eligible = state - state % PHASES + ELIGIBLE
  if Intrinsic.executionCompareExchange(reference, STATE, state, eligible) != state { return () }
  Intrinsic.executionNotify(reference)
  return ()
}

fn invalidState() -> () {
  let invalid = 1 / 0
  return ()
}

fn absurd<T>() -> T {
  let boom = 1 / 0
  return absurd<T>()
}
