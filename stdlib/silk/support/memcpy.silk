//! Word-wise compiler support with explicit C linkage and no runtime services.

import silk.pointer { Pointer }

/// Copies `count` bytes and returns the original destination address.
///
/// # Details
///
/// Bytes move eight at a time through unaligned word accesses, then one at a time for the tail.
///
/// # Gotchas
///
/// The caller must provide live readable source bytes and writable destination bytes.
/// The ranges must not overlap.
export "C" fn memcpy(destination: ?[*]mut u8, source: ?[*]const u8, count: usize) -> ?[*]mut u8 {
  if count == 0 { return destination }
  unsafe {
    let output = Intrinsic.pointerRequalify<?[*]mut u8, [*]mut u8>(destination)
    let input = Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(source)
    let mut index: usize = 0
    while count - index >= 8 {
      Pointer.writeUnaligned<u64>(wordAtMut(output, index), Pointer.readUnaligned<u64>(wordAt(input, index)))
      index = index + 8
    }
    while index < count {
      Pointer.write<u8>(Pointer.atMut<u8>(output, index), Pointer.read<u8>(Pointer.at<u8>(input, index)))
      index = index + 1
    }
    return destination
  }
}

unsafe fn wordAt(base: [*]const u8, index: usize) -> *const align(1) u64 {
  unsafe { return Intrinsic.pointerReinterpret<*const u8, *const align(1) u64>(Pointer.at<u8>(base, index)) }
}

unsafe fn wordAtMut(base: [*]mut u8, index: usize) -> *mut align(1) u64 {
  unsafe { return Intrinsic.pointerReinterpret<*mut u8, *mut align(1) u64>(Pointer.atMut<u8>(base, index)) }
}
