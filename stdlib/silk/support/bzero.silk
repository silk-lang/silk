//! Source-owned word-wise clearing for the Darwin LLVM zero-fill helper.

import silk.pointer { Pointer }

/// Writes zero to each of the `count` destination bytes.
///
/// # Details
///
/// Zero is written eight bytes at a time through unaligned word accesses, then one byte at a
/// time for the tail.
///
/// # Gotchas
///
/// The caller must provide a live writable range of `count` bytes.
export "C" fn bzero(destination: ?[*]mut u8, count: usize) -> () {
  if count == 0 { return () }
  unsafe {
    let output = Intrinsic.pointerRequalify<?[*]mut u8, [*]mut u8>(destination)
    let mut index: usize = 0
    while count - index >= 8 {
      Pointer.writeUnaligned<u64>(wordAtMut(output, index), 0)
      index = index + 8
    }
    while index < count {
      Pointer.write<u8>(Pointer.atMut<u8>(output, index), 0)
      index = index + 1
    }
  }
  return ()
}

unsafe fn wordAtMut(base: [*]mut u8, index: usize) -> *mut align(1) u64 {
  unsafe { return Intrinsic.pointerReinterpret<*mut u8, *mut align(1) u64>(Pointer.atMut<u8>(base, index)) }
}
