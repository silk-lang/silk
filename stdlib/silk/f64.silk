  return Option<i32>.some(Intrinsic.f64ToI32(truncated))
}

/// Converts `value` toward zero to `i64`. Traps for NaN, infinity, or a result
/// outside the `i64` range.
pub fn toI64(value: f64) -> i64 {
  return Intrinsic.f64ToI64(value)
}

/// Converts `value` toward zero to `i64`, or returns `None` when the truncated result is out of
/// range.
///
/// # When to use
///
/// Use this function when a NaN, an infinity, or an out-of-range magnitude is input data rather
/// than a program error. [`toI64`] traps on exactly the inputs this function reports as `None`.
///
/// # Details
///
/// The fraction is discarded first, so the range test applies to the truncated value: a magnitude
/// below one is in range and yields zero. The truncated value is accepted when it is at least
/// `-2^63` and below `2^63`. Both bounds are powers of two and so are exact in binary64; a bound
/// converted from `i64.MAX` would round outward and wrongly admit an overflowing value.
///
/// # Gotchas
///
/// NaN and either infinity return `None`. A value in `(-1.0, -0.0]` truncates to negative zero and
/// converts to `0`, so its sign is discarded rather than rejected.
pub fn checkedToI64(value: f64) -> Option<i64> {
  if Intrinsic.f64IsNaN(value) { return Option<i64>.none() }
  if Intrinsic.f64IsInfinite(value) { return Option<i64>.none() }
  let truncated = trunc(value)
  if truncated < -9223372036854775808.0 { return Option<i64>.none() }
  if truncated >= 9223372036854775808.0 { return Option<i64>.none() }
  return Option<i64>.some(Intrinsic.f64ToI64(truncated))
}

/// Converts `value` toward zero to `isize`. Traps for NaN, infinity, or a result
/// outside the `isize` range.
pub fn toIsize(value: f64) -> isize {
  return Intrinsic.f64ToIsize(value)
}

/// Converts `value` toward zero to `isize`, or returns `None` when the truncated result is out of
/// range.
///
/// # When to use
///
/// Use this function when a NaN, an infinity, or an out-of-range magnitude is input data rather
/// than a program error. [`toIsize`] traps on exactly the inputs this function reports as `None`.
///
/// # Details
///
/// The fraction is discarded first, so the range test applies to the truncated value: a magnitude
/// below one is in range and yields zero. `isize` follows the selected target's pointer width, so
/// the bounds follow it too. The truncated value is accepted when it is at least `-2^31` and below
/// `2^31` on a 32-bit target, or at least `-2^63` and below `2^63` on a 64-bit one.
///
/// Every bound is a power of two and so is exact in binary64. A bound converted from `isize.MAX`
/// would round outward and wrongly admit an overflowing value, and a bound fixed at 64-bit width
/// would admit values that trap on a 32-bit target.
///
/// # Gotchas
///
/// NaN and either infinity return `None`. A value in `(-1.0, -0.0]` truncates to negative zero and
/// converts to `0`, so its sign is discarded rather than rejected.
pub fn checkedToIsize(value: f64) -> Option<isize> {
  if Intrinsic.f64IsNaN(value) { return Option<isize>.none() }
  if Intrinsic.f64IsInfinite(value) { return Option<isize>.none() }
  let truncated = trunc(value)
  if truncated < isizeLowerBound() { return Option<isize>.none() }
  if truncated >= isizeUpperBound() { return Option<isize>.none() }
  return Option<isize>.some(Intrinsic.f64ToIsize(truncated))
}
