//! IEEE binary64 values and Silk's default floating-point arithmetic.
//!
//! # When to use
//! Use `f64` for general floating-point calculations and literals without another numeric context.
//! Choose `f32` when binary32 storage or interchange is an explicit constraint, not merely as a
//! speculative optimization.
//!
//! # Details
//! Basic arithmetic rounds to nearest with ties to even and never enables implicit fast-math
//! assumptions. Division by zero and overflow produce IEEE infinities or NaNs rather than integer-
//! style traps. Ordinary ordered comparisons return false for NaN and treat both zeros as equal;
//! [`totalOrder`] distinguishes every encoding when deterministic ordering is required.
//!
//! [`toBits`] and [`fromBits`] expose the exact binary64 representation, including signed zero and
//! NaN payloads. The source-defined rounding, extrema, sign, and square-root helpers canonicalize
//! NaN results so native and WebAssembly execution agree on their bits.
//!
//! # Gotchas
//! Converting to an integer discards the fractional part and traps for NaN, infinity, or a value
//! outside the destination range. The `checkedTo*` counterparts return `None` on exactly those
//! inputs instead of trapping. [`toF32`] can round a finite value or produce infinity.
//!
//! # Examples
//! ## Check floating-point boundaries without losing their representation
//! ```silk
//! import silk.f64
//!
//! pub fn main() -> i32 {
//!   if f64.toBits(f64.round(-0.25)) != f64.toBits(-0.0) {
//!     return 1
//!   }
//!   if !f64.isNaN(f64.sqrt(-1.0)) {
//!     return 2
//!   }
//!   return 42
//! }
//! ```

import silk.bool
import silk.f32
import silk.i16
import silk.i32
import silk.i64
import silk.i8
import silk.isize
import silk.option { Option }
import silk.target { pointerBits }
import silk.u16
import silk.u32
import silk.u64
import silk.u8
import silk.usize

/// The largest finite `f64` value.
pub const MAX: f64 = 1.7976931348623157e308

/// The most negative finite `f64` value, which is the negation of [`MAX`].
pub const MIN: f64 = -1.7976931348623157e308

/// The distance from `1.0` to the next larger `f64` value.
pub const EPSILON: f64 = 2.220446049250313e-16

/// Positive infinity with the binary64 bit pattern `0x7FF0000000000000`.
///
/// # Details
///
/// No source literal spells infinity directly. This initializer deliberately exceeds [`MAX`], and
/// decimal-to-binary64 rounding produces the infinity encoding.
pub const INFINITY: f64 = 1e999

/// The ratio of a circle's circumference to its diameter, rounded to the nearest `f64` value.
pub const PI: f64 = 3.141592653589793

/// Euler's number, rounded to the nearest `f64` value.
pub const E: f64 = 2.718281828459045

/// Returns `value` with its sign reversed.
pub fn negate(value: f64) -> f64 {
  return Intrinsic.f64Negate(value)
}

/// Returns `left + right`, rounded to nearest with ties to even. Overflow produces infinity; it
/// does not trap.
pub fn add(left: f64, right: f64) -> f64 {
  return Intrinsic.f64Add(left, right)
}

/// Returns `left - right`, rounded to nearest with ties to even. Overflow produces infinity; it
/// does not trap.
pub fn subtract(left: f64, right: f64) -> f64 {
  return Intrinsic.f64Subtract(left, right)
}

/// Returns `left * right`, rounded to nearest with ties to even. Overflow produces infinity; it
/// does not trap.
pub fn multiply(left: f64, right: f64) -> f64 {
  return Intrinsic.f64Multiply(left, right)
}

/// Returns `left / right`, rounded to nearest with ties to even. Division by zero produces
/// infinity or NaN; it does not trap.
pub fn divide(left: f64, right: f64) -> f64 {
  return Intrinsic.f64Divide(left, right)
}

/// Returns `left - trunc(left / right) * right`. A zero `right`, infinite `left`, or NaN operand
/// produces NaN; it does not trap.
pub fn remainder(left: f64, right: f64) -> f64 {
  return Intrinsic.f64Remainder(left, right)
}

/// Returns `true` when both values compare equal. Returns `false` if either value is NaN.
pub fn equals(left: f64, right: f64) -> bool {
  return Intrinsic.f64Equals(left, right)
}

/// Returns `true` when values do not compare equal, including when either value is NaN.
pub fn notEquals(left: f64, right: f64) -> bool {
  return Intrinsic.f64NotEquals(left, right)
}

/// Returns `true` when `left` is less than `right`. Returns `false` if either value is NaN.
pub fn lessThan(left: f64, right: f64) -> bool {
  return Intrinsic.f64LessThan(&left, &right)
}

/// Returns `true` when `left` is less than or equal to `right`. Returns `false` for NaN.
pub fn lessOrEqual(left: f64, right: f64) -> bool {
  return Intrinsic.f64LessOrEqual(left, right)
}

/// Returns `true` when `left` is greater than `right`. Returns `false` if either value is NaN.
pub fn greaterThan(left: f64, right: f64) -> bool {
  return Intrinsic.f64GreaterThan(left, right)
}

/// Returns `true` when `left` is greater than or equal to `right`. Returns `false` for NaN.
pub fn greaterOrEqual(left: f64, right: f64) -> bool {
  return Intrinsic.f64GreaterOrEqual(left, right)
}

/// Returns `true` when `value` is a NaN.
pub fn isNaN(value: f64) -> bool {
  return Intrinsic.f64IsNaN(value)
}

/// Returns `true` when `value` is positive or negative infinity.
pub fn isInfinite(value: f64) -> bool {
  return Intrinsic.f64IsInfinite(value)
}

/// Returns `true` when `value` is neither infinity nor NaN.
pub fn isFinite(value: f64) -> bool {
  return Intrinsic.f64IsFinite(value)
}

/// Returns `true` when `value` is finite, nonzero, and not subnormal.
pub fn isNormal(value: f64) -> bool {
  return Intrinsic.f64IsNormal(value)
}

/// Returns `true` when `value` is finite and has subnormal magnitude.
pub fn isSubnormal(value: f64) -> bool {
  return Intrinsic.f64IsSubnormal(value)
}

/// Returns `true` when the sign bit of `value` is set, including for zero and NaN.
pub fn isSignNegative(value: f64) -> bool {
  return Intrinsic.f64IsSignNegative(value)
}

/// Reports whether `left` precedes or equals `right` in the IEEE total order.
///
/// # When to use
///
/// Use this function for deterministic ordering that includes NaNs and distinguishes signed zero.
///
/// # Details
///
/// Unlike ordinary comparison, this order distinguishes negative and positive zero and provides a
/// deterministic position for NaN encodings.
pub fn totalOrder(left: f64, right: f64) -> bool {
  return Intrinsic.f64TotalOrder(left, right)
}

/// Reinterprets a value as its exact 64-bit IEEE representation.
///
/// # When to use
///
/// Use this function to inspect or preserve representation bits. It does not convert the number.
pub fn toBits(value: f64) -> u64 {
  return Intrinsic.f64ToBits(value)
}

/// Reinterprets an arbitrary 64-bit pattern as `f64` without numeric conversion.
///
/// # When to use
///
/// Use this function to construct a value from representation bits, including NaN and signed zero.
pub fn fromBits(value: u64) -> f64 {
  return Intrinsic.f64FromBits(value)
}

// One stable NaN result for source-defined operations whose public contract requires canonical
// bits across all execution engines.
fn canonicalNaN() -> f64 {
  return fromBits(9221120237041090560)
}

/// Computes the correctly rounded square root and preserves either signed zero.
///
/// # Details
///
/// IEEE requires square root to be correctly rounded, so its native and WebAssembly instructions
/// have one admissible numeric result.
///
/// # Gotchas
///
/// NaN and negative nonzero inputs return the canonical quiet NaN. Negative zero is not treated as
/// negative and returns unchanged.
pub fn sqrt(value: f64) -> f64 {
  if Intrinsic.f64IsNaN(value) { return canonicalNaN() }
  // Negative zero compares equal to zero and so passes through to the primitive, which returns it
  // unchanged as IEEE-754 requires.
  if value < 0.0 { return canonicalNaN() }
  return Intrinsic.f64Sqrt(value)
}

/// Returns the magnitude of `value`, which clears the sign bit. A NaN input gives the canonical
/// NaN.
pub fn abs(value: f64) -> f64 {
  if Intrinsic.f64IsNaN(value) { return canonicalNaN() }
  return fromBits(u64.bitAnd(toBits(value), 9223372036854775807))
}

/// Returns the magnitude of `magnitude` with the sign bit of `sign`. A NaN `magnitude` gives the
/// canonical NaN rather than a signed NaN.
pub fn copysign(magnitude: f64, sign: f64) -> f64 {
  if Intrinsic.f64IsNaN(magnitude) { return canonicalNaN() }
  let carried = u64.bitAnd(toBits(magnitude), 9223372036854775807)
  let transferred = u64.bitAnd(toBits(sign), 9223372036854775808)
  return fromBits(u64.bitOr(carried, transferred))
}

/// Rounds toward zero while preserving the sign of a zero result.
///
/// # Details
///
/// A value in `(-1.0, -0.0]` becomes negative zero. A NaN becomes the canonical quiet NaN, while
/// either infinity is already integral and returns unchanged.
pub fn trunc(value: f64) -> f64 {
  if Intrinsic.f64IsNaN(value) { return canonicalNaN() }
  let bits = toBits(value)
  let biased = u64.bitAnd(u64.shiftRight(bits, 52), 2047)
  // Below 1.0 nothing integral survives, so only the sign is kept.
  if biased < 1023 { return fromBits(u64.bitAnd(bits, 9223372036854775808)) }
  // At or past 2^52 every representable value is already an integer, infinities included.
  if biased >= 1075 { return value }
  let discarded = u64.subtract(1075, biased)
  let kept = u64.bitNot(u64.shiftLeft(1, discarded) - 1)
  return fromBits(u64.bitAnd(bits, kept))
}

/// Returns the largest integral `f64` that is not greater than `value`. A NaN input gives the
/// canonical NaN.
pub fn floor(value: f64) -> f64 {
  if Intrinsic.f64IsNaN(value) { return canonicalNaN() }
  let truncated = trunc(value)
  // Only a negative non-integral value truncates upward, and it is always below 2^52, so the
  // subtraction is exact.
  if truncated > value { return truncated - 1.0 }
  return truncated
}

/// Returns the smallest integral `f64` that is not less than `value`. A NaN input gives the
/// canonical NaN.
pub fn ceil(value: f64) -> f64 {
  if Intrinsic.f64IsNaN(value) { return canonicalNaN() }
  let truncated = trunc(value)
  if truncated < value { return truncated + 1.0 }
  return truncated
}

/// Rounds to the nearest integral f64, with a half rounded away from zero.
///
/// # Details
///
/// This differs from the ties-to-even policy used by basic arithmetic. A zero result keeps its
/// input sign, and a NaN becomes the canonical quiet NaN.
pub fn round(value: f64) -> f64 {
  if Intrinsic.f64IsNaN(value) { return canonicalNaN() }
  let truncated = trunc(value)
  // Exact: below 2^52 the difference is representable, and at or past it the fraction is zero.
  // An infinity leaves a NaN here, whose comparison is false, so the truncated infinity stands.
  let fraction = value - truncated
  if abs(fraction) < 0.5 { return truncated }
  return truncated + copysign(1.0, value)
}

/// Returns the lesser value and orders negative zero below positive zero. If an operand is NaN,
/// returns the canonical NaN.
pub fn min(left: f64, right: f64) -> f64 {
  if Intrinsic.f64IsNaN(left) { return canonicalNaN() }
  if Intrinsic.f64IsNaN(right) { return canonicalNaN() }
  if left < right { return left }
  if right < left { return right }
  // The operands compare equal, so only a zero's sign is left to separate them.
  if Intrinsic.f64IsSignNegative(left) { return left }
  return right
}

/// Returns the greater value and orders positive zero above negative zero. If an operand is NaN,
/// returns the canonical NaN.
pub fn max(left: f64, right: f64) -> f64 {
  if Intrinsic.f64IsNaN(left) { return canonicalNaN() }
  if Intrinsic.f64IsNaN(right) { return canonicalNaN() }
  if left > right { return left }
  if right > left { return right }
  if Intrinsic.f64IsSignNegative(left) { return right }
  return left
}

/// Approximates sine within four units in the last place using deterministic result bits.
///
/// # Details
///
/// NaN and either infinity return the canonical quiet NaN. Either signed zero returns unchanged.
pub fn sin(value: f64) -> f64 {
  return Intrinsic.f64Sin(value)
}

/// Approximates cosine within four units in the last place using deterministic result bits.
///
/// # Details
///
/// NaN and either infinity return the canonical quiet NaN. Either signed zero returns positive one.
pub fn cos(value: f64) -> f64 {
  return Intrinsic.f64Cos(value)
}

/// Converts to binary32 with round-to-nearest ties-to-even.
///
/// # Details
///
/// A finite value too large for binary32 becomes infinity; NaN remains NaN.
pub fn toF32(value: f64) -> f32 {
  return Intrinsic.f64ToF32(value)
}

/// Returns the same binary64 value unchanged.
pub fn toF64(value: f64) -> f64 {
  return Intrinsic.f64ToF64(value)
}

/// Converts `value` toward zero to `u8`. Traps for NaN, infinity, or a result
/// outside the `u8` range.
pub fn toU8(value: f64) -> u8 {
  return Intrinsic.f64ToU8(value)
}

// The pointer-width conversion bounds, as exact powers of two in binary64. They are
// selected from the target's pointer width rather than converted from `usize.MAX`/`isize.MAX`,
// which would round outward and admit an overflowing value.
fn usizeBound() -> f64 {
  if pointerBits == 32 { return 4294967296.0 }
  return 18446744073709551616.0
}

fn isizeUpperBound() -> f64 {
  if pointerBits == 32 { return 2147483648.0 }
  return 9223372036854775808.0
}

fn isizeLowerBound() -> f64 {
  if pointerBits == 32 { return -2147483648.0 }
  return -9223372036854775808.0
}

/// Converts `value` toward zero to `u8`, or returns `None` when the truncated result is out of
/// range.
///
/// # When to use
///
/// Use this function when a NaN, an infinity, or an out-of-range magnitude is input data rather
/// than a program error. [`toU8`] traps on exactly the inputs this function reports as `None`.
///
/// # Details
///
/// The fraction is discarded first, so the range test applies to the truncated value: a magnitude
/// below one is in range and yields zero. The truncated value is accepted when it is at least zero
/// and below `2^8`. Both bounds are powers of two and so are exact in binary64; a bound converted
/// from `u8.MAX` would round outward and wrongly admit an overflowing value.
///
/// # Gotchas
///
/// NaN and either infinity return `None`. A value in `(-1.0, -0.0]` truncates to negative zero and
/// converts to `0`, so its sign is discarded rather than rejected.
pub fn checkedToU8(value: f64) -> Option<u8> {
  if Intrinsic.f64IsNaN(value) { return Option<u8>.none() }
  if Intrinsic.f64IsInfinite(value) { return Option<u8>.none() }
  let truncated = trunc(value)
  if truncated < 0.0 { return Option<u8>.none() }
  if truncated >= 256.0 { return Option<u8>.none() }
  return Option<u8>.some(Intrinsic.f64ToU8(truncated))
}

/// Converts `value` toward zero to `u16`. Traps for NaN, infinity, or a result
/// outside the `u16` range.
pub fn toU16(value: f64) -> u16 {
  return Intrinsic.f64ToU16(value)
}

/// Converts `value` toward zero to `u16`, or returns `None` when the truncated result is out of
/// range.
///
/// # When to use
///
/// Use this function when a NaN, an infinity, or an out-of-range magnitude is input data rather
