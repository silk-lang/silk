  if Intrinsic.f64IsInfinite(value) { return Option<u32>.none() }
  let truncated = trunc(value)
  if truncated < 0.0 { return Option<u32>.none() }
  if truncated >= 4294967296.0 { return Option<u32>.none() }
  return Option<u32>.some(Intrinsic.f64ToU32(truncated))
