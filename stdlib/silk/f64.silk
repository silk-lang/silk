/// NaN and either infinity return `None`. A value in `(-1.0, -0.0]` truncates to negative zero and
/// converts to `0`, so its sign is discarded rather than rejected.
pub fn checkedToI16(value: f64) -> Option<i16> {
  if Intrinsic.f64IsNaN(value) { return Option<i16>.none() }
  if Intrinsic.f64IsInfinite(value) { return Option<i16>.none() }
  let truncated = trunc(value)
  if truncated < -32768.0 { return Option<i16>.none() }
  if truncated >= 32768.0 { return Option<i16>.none() }
  return Option<i16>.some(Intrinsic.f64ToI16(truncated))
}

