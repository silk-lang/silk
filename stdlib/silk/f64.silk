pub fn checkedToU16(value: f64) -> Option<u16> {
  if Intrinsic.f64IsNaN(value) { return Option<u16>.none() }
  if Intrinsic.f64IsInfinite(value) { return Option<u16>.none() }
  let truncated = trunc(value)
  if truncated < 0.0 { return Option<u16>.none() }
  if truncated >= 65536.0 { return Option<u16>.none() }
  return Option<u16>.some(Intrinsic.f64ToU16(truncated))
}

/// Converts `value` toward zero to `u32`. Traps for NaN, infinity, or a result
/// outside the `u32` range.
pub fn toU32(value: f64) -> u32 {
  return Intrinsic.f64ToU32(value)
