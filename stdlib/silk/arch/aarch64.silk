//! AArch64 NEON instructions that the portable `silk.simd` operations do not express: table
//! lookups, dot products, and pairwise sums.
//!
//! # When to use
//! Use this module in kernels such as UTF-8 validation, base64 decoding, and checksums, where
//! one of these instructions replaces several portable steps. Use `silk.simd` for everything
//! else.
//!
//! # Details
//! Each function names the instruction it stands for and the CPU feature that instruction
//! needs. When the build targets AArch64 with that feature, the function compiles to the one
//! instruction. Otherwise it computes the same lanes with portable code, which is correct on
//! every target but slower. Every AArch64 build has NEON; the dot products need the `dotprod`
//! feature.
//!
//! # Examples
//! ## Look up bytes in a table
//! ```silk
//! import silk.arch.aarch64
//! import silk.simd.u8x16
//!
//! pub fn main() -> i32 {
//!   let squares = u8x16.fromArray([0, 1, 4, 9, 16, 25, 36, 49, 64, 81, 100, 121, 144, 169, 196, 225])
//!   let picked = aarch64.tableLookup(squares, u8x16.splat(12))
//!   if u8x16.extract(picked, 0) != 144 || u8x16.extract(aarch64.tableLookup(squares, u8x16.splat(16)), 0) != 0 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```

import silk.simd.i8x16
import silk.simd.i32x4
import silk.simd.u8x16
import silk.simd.u16x8
import silk.simd.u32x4
import silk.target {Arch, Target}
import silk.i8
import silk.i32
import silk.u8
import silk.u16
import silk.u32

/// `tbl` (NEON): lane `i` is `table[indices[i]]`, or `0` when `indices[i]` is 16 or more.
pub fn tableLookup(table: simd<u8, 16>, indices: simd<u8, 16>) -> simd<u8, 16> {
  static if Target.arch() == Arch.Aarch64 && Target.hasCpuFeature("neon") {
    return Intrinsic.aarch64TableLookup<simd<u8, 16>>(table, indices)
  }
  let lanes = u8x16.toArray(table)
  let picks = u8x16.toArray(indices)
  let mut result = u8x16.toArray(u8x16.splat(0))
  let mut at: usize = 0
  while at < 16 {
    if picks[at] < 16 {
      result[at] = lanes[u8.toUsize(picks[at])]
    }
    at = at + 1
  }
  return u8x16.fromArray(result)
}

/// `udot` (dotprod): lane `i` of `sum` plus the products of bytes `4 * i` to `4 * i + 3` of
/// `left` and `right`, wrapping.
pub fn dotProduct(sum: simd<u32, 4>, left: simd<u8, 16>, right: simd<u8, 16>) -> simd<u32, 4> {
  static if Target.arch() == Arch.Aarch64 && Target.hasCpuFeature("dotprod") {
    return Intrinsic.aarch64DotProduct<simd<u32, 4>>(sum, left, right)
  }
  let mut result = u32x4.toArray(sum)
  let a = u8x16.toArray(left)
  let b = u8x16.toArray(right)
  let mut at: usize = 0
  while at < 16 {
    result[at / 4] = u32.wrappingAdd(result[at / 4], u8.toU32(a[at]) * u8.toU32(b[at]))
    at = at + 1
  }
  return u32x4.fromArray(result)
}

/// `sdot` (dotprod): [`dotProduct`] over signed lanes.
pub fn dotProductSigned(sum: simd<i32, 4>, left: simd<i8, 16>, right: simd<i8, 16>) -> simd<i32, 4> {
  static if Target.arch() == Arch.Aarch64 && Target.hasCpuFeature("dotprod") {
    return Intrinsic.aarch64DotProduct<simd<i32, 4>>(sum, left, right)
  }
  let mut result = i32x4.toArray(sum)
  let a = i8x16.toArray(left)
  let b = i8x16.toArray(right)
  let mut at: usize = 0
  while at < 16 {
    result[at / 4] = i32.wrappingAdd(result[at / 4], i8.toI32(a[at]) * i8.toI32(b[at]))
    at = at + 1
  }
  return i32x4.fromArray(result)
}

/// `addp` (NEON): the wrapping sums of adjacent lane pairs of `left`, then of `right`.
pub fn pairwiseAdd8(left: simd<u8, 16>, right: simd<u8, 16>) -> simd<u8, 16> {
  static if Target.arch() == Arch.Aarch64 && Target.hasCpuFeature("neon") {
    return Intrinsic.aarch64PairwiseAdd<simd<u8, 16>>(left, right)
  }
  let a = u8x16.toArray(left)
  let b = u8x16.toArray(right)
  let mut result = u8x16.toArray(u8x16.splat(0))
  let mut at: usize = 0
  while at < 8 {
    result[at] = u8.wrappingAdd(a[2 * at], a[2 * at + 1])
    result[at + 8] = u8.wrappingAdd(b[2 * at], b[2 * at + 1])
    at = at + 1
  }
  return u8x16.fromArray(result)
}

/// `addp` (NEON): [`pairwiseAdd8`] over sixteen-bit lanes.
pub fn pairwiseAdd16(left: simd<u16, 8>, right: simd<u16, 8>) -> simd<u16, 8> {
  static if Target.arch() == Arch.Aarch64 && Target.hasCpuFeature("neon") {
    return Intrinsic.aarch64PairwiseAdd<simd<u16, 8>>(left, right)
  }
  let a = u16x8.toArray(left)
  let b = u16x8.toArray(right)
  let mut result = u16x8.toArray(u16x8.splat(0))
  let mut at: usize = 0
  while at < 4 {
    result[at] = u16.wrappingAdd(a[2 * at], a[2 * at + 1])
    result[at + 4] = u16.wrappingAdd(b[2 * at], b[2 * at + 1])
    at = at + 1
  }
  return u16x8.fromArray(result)
}

/// `addp` (NEON): [`pairwiseAdd8`] over 32-bit lanes.
pub fn pairwiseAdd32(left: simd<u32, 4>, right: simd<u32, 4>) -> simd<u32, 4> {
  static if Target.arch() == Arch.Aarch64 && Target.hasCpuFeature("neon") {
    return Intrinsic.aarch64PairwiseAdd<simd<u32, 4>>(left, right)
  }
  let a = u32x4.toArray(left)
  let b = u32x4.toArray(right)
  let mut result = u32x4.toArray(u32x4.splat(0))
  let mut at: usize = 0
  while at < 2 {
    result[at] = u32.wrappingAdd(a[2 * at], a[2 * at + 1])
    result[at + 2] = u32.wrappingAdd(b[2 * at], b[2 * at + 1])
    at = at + 1
  }
  return u32x4.fromArray(result)
}
