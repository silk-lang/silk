//! Parse an absolute URI (RFC 3986), and resolve relative references against it.
//!
//! # When to use
//! Use [`Uri.parse`] when the text must have a scheme, such as a URL that a user gives you or the
//! base URL of a page. Use [`Uri.resolveOwned`] or [`Uri.resolveInto`] to turn a relative link,
//! such as `../img/logo.png`, into a full URI. For text that can be relative, use
//! `silk.uri.reference`.
//!
//! # Details
//! [`Uri`] borrows its text and does not allocate. Its component functions are the same as those of
//! `UriReference`, but [`Uri.scheme`] always has a value. Resolution follows section 5.2 of RFC
//! 3986: it takes components from the base or the reference, and removes `.` and `..` path
//! segments. It does not change the case of letters or the spelling of `%XX` escapes. It does not
//! apply scheme rules, such as a default port.
//!
//! # Errors
//! - `ParseError` if the text is not a valid URI. A text without a scheme gives `MissingScheme` at
//!   offset 0.
//! - `OutOfMemoryError` from the functions that allocate.
//!
//! # Examples
//! ## Read the parts of a URL
//! ```silk
//! import silk.core.option { Option }
//! import silk.core.result { Result }
//! import silk.uri.uri { Uri }
//! import silk.uri.reference { ParseError }
//!
//! pub fn main() -> i32 {
//!   let uri = match Uri.parse("https://ada@example.com:8443/docs?page=2#intro") {
//!     Result<Uri, ParseError>.Success { value } => value
//!     Result<Uri, ParseError>.Failure {..} => {
//!       return 1
//!     }
//!   }
//!   let host = Uri.host(&uri) |> Option<string>.unwrapOr("")
//!   let port = Uri.port(&uri) |> Option<string>.unwrapOr("")
//!   if Uri.scheme(&uri) != "https" || host != "example.com" || port != "8443"
//!     || Uri.path(&uri) != "/docs" {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! ## Resolve a relative link
//! ```silk
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.core.effect { Effect }
//! import silk.core.result { Result }
//! import silk.uri.uri { OwnedUri, Uri }
//! import silk.uri.reference { ParseError, UriReference }
//!
//! pub effect fn main() -> i32
//!   ! OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let base = match Uri.parse("https://example.com/docs/guide/intro.html") {
//!     Result<Uri, ParseError>.Success { value } => value
//!     Result<Uri, ParseError>.Failure {..} => {
//!       return 1
//!     }
//!   }
//!   let link = match UriReference.parse("../img/logo.png") {
//!     Result<UriReference, ParseError>.Success { value } => value
//!     Result<UriReference, ParseError>.Failure {..} => {
//!       return 1
//!     }
//!   }
//!   let resolved = run Uri.resolveOwned(&base, &link) |> Effect.provideMut<Allocator>(&mut allocator)
//!   return match move resolved {
//!     Result<OwnedUri, ParseError>.Success { value } => {
//!       let view = OwnedUri.view(&value)
//!       if Uri.format(&view) != "https://example.com/docs/img/logo.png" {
//!         return 1
//!       }
//!       return 0
//!     }
//!     Result<OwnedUri, ParseError>.Failure {..} => 1
//!   }
//! }
//! ```
//!
//! @category Data formats

import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.text.format {Debug, Format, Formatter}
import silk.core.option {Option}
import silk.core.ownership {Copy}
import silk.core.result {Result}
import silk.text.string {String}
import silk.collections.bytes {Bytes}
import silk.collections.slice {Slice}
import silk.uri.reference {
  UriReference,
  OwnedUriReference,
  ParseError,
  ParseReason,
  Component,
  HostKind,
}
import silk.num.usize
import silk.num.u8
import silk.io.writer {Writer, WriterError}

/// A parsed URI with a scheme. It borrows its text.
///
/// It is `Copy` and does not allocate. It cannot live longer than its text. Use [`Uri.copy`] or
/// [`Uri.parseOwned`] to get an [`OwnedUri`]. [`Uri.scheme`] always has a value. The component
/// functions return slices of the text, so nothing is decoded or normalized.
///
/// [`Uri.resolveOwned`] and [`Uri.resolveInto`] follow section 5.2 of RFC 3986: they take
/// components from the base or the reference, and remove `.` and `..` path segments. They do not
/// change the case of letters or the spelling of `%XX` escapes, and do not apply scheme rules, such
/// as a default port.
pub struct Uri<'text> {
  reference: UriReference<'text>,
}

impl<'text> Copy for Uri<'text> {}

impl<'text> Uri<'text> {
  /// Parses `text` as a URI that has a scheme. It does not allocate, decode, or normalize.
  ///
  /// # Errors
  /// - `ParseError` with `MissingScheme` at offset 0 if `text` has no scheme, such as `/path` or
  ///   `example.com`.
  /// - `ParseError` for other syntax problems, with the component and byte position.
  pub fn parse(text: string<'text>) -> Result<Uri<'text>, ParseError> {
    if !hasScheme(text) {
      return Result<Uri<'text>, ParseError>.failResult(missingScheme())
    }
    let parsed = UriReference.parse(text)
    return match move parsed {
      Result<UriReference<'text>, ParseError>.Success {value} => Result<
        Uri<'text>,
        ParseError,
      >.succeed(Uri<'text> {reference: value})
      Result<UriReference<'text>, ParseError>.Failure {error} => Result<
        Uri<'text>,
        ParseError,
      >.failResult(error)
    }
  }
  /// Returns an [`OwnedUri`] with a copy of the text. It does not parse again.
  ///
  /// # Errors
  /// - `OutOfMemoryError` if the `Allocator` fails.
  pub effect fn copy(self: &Self) -> OwnedUri ! OutOfMemoryError ? &mut Allocator {
    let reference = run UriReference.copy(&self.reference)
    return OwnedUri {reference: move reference}
  }
  /// Parses `text` and returns an [`OwnedUri`] with a copy of it.
  ///
  /// # Errors
  /// - `Failure` with a `ParseError` if `text` is not valid. Nothing is allocated.
  /// - `OutOfMemoryError` if the `Allocator` fails.
  pub effect fn parseOwned(text: string<'text>) -> Result<OwnedUri, ParseError>
  ! OutOfMemoryError
  ? &mut Allocator {
    let parsed = Uri.parse(text)
    return match move parsed {
      Result<Uri<'text>, ParseError>.Failure {error} => Result<OwnedUri, ParseError>.failResult(
        error,
      )
      Result<Uri<'text>, ParseError>.Success {value} => {
        let owned = run Uri.copy(&value)
        return Result<OwnedUri, ParseError>.succeed(move owned)
      }
    }
  }
  /// Returns the full text of the URI, as it was parsed.
  pub fn format(self: &Self) -> string<'text> {
    return UriReference.format(&self.reference)
  }
  /// Returns the URI as a `UriReference`, for functions that accept any reference. It does not
  /// parse again.
  pub fn asReference(self: &Self) -> UriReference<'text> {
    return self.reference
  }
  /// Returns the scheme without the `:`. The case of the letters does not change.
  pub fn scheme(self: &Self) -> string<'text> {
    return Option<string>.unwrapOr(UriReference.scheme(&self.reference), "")
  }
  /// Returns the authority without the `//`. Returns `None` if the component is absent. A component
  /// that is present but empty, such as the query of `http://a/?`, returns `Some("")`.
  pub fn authority(self: &Self) -> Option<string<'text>> {
    return UriReference.authority(&self.reference)
  }
  /// Returns the user information without the `@`. Returns `None` if the component is absent. A
  /// component that is present but empty, such as the query of `http://a/?`, returns `Some("")`.
  pub fn userinfo(self: &Self) -> Option<string<'text>> {
    return UriReference.userinfo(&self.reference)
  }
  /// Returns the host, with the brackets of an IP literal. Returns `None` if there is no authority.
  /// The host of `file:///x` is present and empty.
  pub fn host(self: &Self) -> Option<string<'text>> {
    return UriReference.host(&self.reference)
  }
  /// Returns the `HostKind` of the host, or `None` if there is no authority.
  pub fn hostKind(self: &Self) -> Option<HostKind> {
    return UriReference.hostKind(&self.reference)
  }
  /// Returns the port digits without the `:`. Returns `None` if the component is absent. A
  /// component that is present but empty, such as the query of `http://a/?`, returns `Some("")`.
  pub fn port(self: &Self) -> Option<string<'text>> {
    return UriReference.port(&self.reference)
  }
  /// Returns the path. It can be empty.
  pub fn path(self: &Self) -> string<'text> {
    return UriReference.path(&self.reference)
  }
  /// Returns the query without the `?`. Returns `None` if the component is absent. A component that
  /// is present but empty, such as the query of `http://a/?`, returns `Some("")`.
  pub fn query(self: &Self) -> Option<string<'text>> {
    return UriReference.query(&self.reference)
  }
  /// Returns the fragment without the `#`. Returns `None` if the component is absent. A component
  /// that is present but empty, such as the query of `http://a/?`, returns `Some("")`.
  pub fn fragment(self: &Self) -> Option<string<'text>> {
    return UriReference.fragment(&self.reference)
  }
  /// Resolves `reference` against `base` (RFC 3986, section 5.2) and writes the result to `output`.
  ///
  /// It replaces the contents of `output`. If `output` has enough capacity, it does not allocate.
  /// To read the result, call [`Uri.parse`] on the bytes of `output`.
  ///
  /// # Errors
  /// - `Failure` with a `ParseError` if the result is not a valid URI. This can occur when dot
  ///   segment removal makes the path start with `//`. Then `output` holds the text that failed.
  /// - `OutOfMemoryError` if the `Allocator` fails. `output` does not change.
  ///
  /// # Gotchas
  /// `output` must not share storage with the text of `base` or `reference`.
  pub effect fn resolveInto(output: &mut Bytes, base: &Uri, reference: &UriReference) -> Result<
    (),
    ParseError,
  > ! OutOfMemoryError ? &mut Allocator {
    let combined = run addSize(
      String.byteLength(Uri.format(base)),
      String.byteLength(UriReference.format(reference)),
    )
    let bound = run addSize(combined, 1)
    let oldLength = Bytes.length(&output)
    if bound > oldLength {
      let _reserved = run Bytes.reserveExact(&mut output, bound - oldLength)
    }
    let _cleared = Bytes.clear(&mut output)
    let ownScheme = isPresent<string>(UriReference.scheme(reference))
    let ownAuthority = isPresent<string>(UriReference.authority(reference))
    let scheme = Option<string>.unwrapOr(UriReference.scheme(reference), Uri.scheme(base))
    let _wroteScheme = run appendText(&mut output, scheme)
    let _wroteColon = run appendText(&mut output, ":")
    let mut authority = Uri.authority(base)
    if ownScheme || ownAuthority {
      authority = UriReference.authority(reference)
    }
    let _wroteAuthority = run appendOptional(&mut output, move authority, "//")
    let pathStart = Bytes.length(&output)
    let path = UriReference.path(reference)
    let mut query = UriReference.query(reference)
    let mut normalize = true
    if ownScheme || ownAuthority {
      let _wrotePath = run appendText(&mut output, path)
    } else if String.byteLength(path) == 0 {
      let _wrotePath = run appendText(&mut output, Uri.path(base))
      normalize = false
      if !isPresent<string>(UriReference.query(reference)) {
        query = Uri.query(base)
      }
    } else {
      let bytes = String.utf8Bytes(path)
      if bytes[0] != 47 {
        let baseBytes = String.utf8Bytes(Uri.path(base))
        if isPresent<string>(Uri.authority(base)) && baseBytes.length == 0 {
          let _slash = run appendText(&mut output, "/")
        } else {
          let mut end: usize = 0
          let mut index: usize = 0
          while index < baseBytes.length {
            if baseBytes[index] == 47 {
              end = index + 1
            }
            index = index + 1
          }
          let prefix = Slice.view<u8>(baseBytes, 0, end)
          let _wrotePrefix = run Bytes.append(&mut output, prefix)
        }
      }
      let _wrotePath = run appendText(&mut output, path)
    }
    if normalize {
      let end = removeDots(Bytes.asMutSlice(&mut output), pathStart)
      let _truncated = Bytes.truncate(&mut output, end)
    }
    let _wroteQuery = run appendOptional(&mut output, move query, "?")
    let _wroteFragment = run appendOptional(&mut output, UriReference.fragment(reference), "#")
    // All emitted bytes came from validated ASCII components or ASCII delimiters.
    let text = unsafe String.fromUtf8Unchecked(Bytes.asSlice(&output))
    return validateResolved(text)
  }
  /// Resolves `reference` against `base` (RFC 3986, section 5.2) and returns a new [`OwnedUri`].
  ///
  /// It allocates one buffer. Use [`Uri.resolveInto`] to reuse a buffer that you already have.
  ///
  /// # Errors
  /// - `Failure` with a `ParseError` if the result is not a valid URI.
  /// - `OutOfMemoryError` if the `Allocator` fails.
  pub effect fn resolveOwned(base: &Uri, reference: &UriReference) -> Result<OwnedUri, ParseError>
  ! OutOfMemoryError
  ? &mut Allocator {
    let mut output = Bytes.make()
    let resolved = run Uri.resolveInto(&mut output, base, reference)
    return match move resolved {
      Result<(), ParseError>.Failure {error} => Result<OwnedUri, ParseError>.failResult(error)
      Result<(), ParseError>.Success {..} => {
        // Successful strict validation proves this initialized byte buffer is ASCII UTF-8.
        let text = unsafe String.fromBytesUnchecked(move output)
        return OwnedUri.fromString(move text)
      }
    }
  }
}

/// A URI that owns its text and its parsed ranges.
///
/// [`OwnedUri.view`] returns a [`Uri`] that borrows it, and the view cannot live longer than the
/// `OwnedUri`.
pub struct OwnedUri {
  reference: OwnedUriReference,
}

impl Debug for OwnedUri {
  /// Writes the text, as `OwnedUri { text: "https://example.com/" }`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    let mut record = run Format.debugRecord("OwnedUri", &mut formatter)
    run Format.debugField(&mut record, "text", &Uri.format(&OwnedUri.view(self)), &mut formatter)
    return run Format.debugFinish(record, &mut formatter)
  }
}

impl OwnedUri {
  /// Parses `text` as a URI with a scheme and keeps it, without a copy or an allocation.
  ///
  /// # Errors
  /// - `Failure` with a `ParseError` if `text` is not valid or has no scheme.
  ///
  /// # Gotchas
  /// It consumes `text` also when it fails.
  pub fn fromString(text: String) -> Result<OwnedUri, ParseError> {
    if !hasScheme(String.view(&text)) {
      return Result<OwnedUri, ParseError>.failResult(missingScheme())
    }
    let parsed = OwnedUriReference.fromString(move text)
    return match move parsed {
      Result<OwnedUriReference, ParseError>.Failure {error} => Result<
        OwnedUri,
        ParseError,
      >.failResult(error)
      Result<OwnedUriReference, ParseError>.Success {value} => Result<OwnedUri, ParseError>.succeed(
        OwnedUri {reference: move value},
      )
    }
  }
  /// Returns a [`Uri`] that borrows this value. It does not parse again or allocate.
  pub fn view(self: &Self) -> Uri {
    return Uri {reference: OwnedUriReference.view(&self.reference)}
  }
  /// Returns the text and consumes the value. It does not copy.
  pub fn intoString(self: Self) -> String {
    return match move self {
      OwnedUri {reference} => OwnedUriReference.intoString(move reference)
    }
  }
}

fn missingScheme() -> ParseError {
  return ParseError {reason: ParseReason.MissingScheme, component: Component.Scheme, offset: 0}
}

fn hasScheme(text: string) -> bool {
  let bytes = String.utf8Bytes(text)
  let mut index = usize.ZERO
  while index < bytes.length {
    let value = bytes[index]
    if value == u8.toU8(58) {
      return true
    }
    if value == u8.toU8(47) || value == u8.toU8(63) || value == u8.toU8(35) {
      return false
    }
    index = index + usize.ONE
  }
  return false
}

fn isPresent<T>(value: Option<T>) -> bool {
  return match move value {
    Option<T>.Some {..} => true
    Option<T>.None => false
  }
}

effect fn addSize(left: usize, right: usize) -> usize ! OutOfMemoryError {
  return match move usize.checkedAdd(left, right) {
    Option<usize>.Some {value} => value
    Option<usize>.None => run Allocator.outOfMemory()
  }
}

effect fn appendText(output: &mut Bytes, text: string) -> () ! OutOfMemoryError ? &mut Allocator {
  return run Bytes.append(&mut output, String.utf8Bytes(text))
}

effect fn appendOptional(output: &mut Bytes, value: Option<string>, delimiter: string) -> ()
! OutOfMemoryError
? &mut Allocator {
  match move value {
    Option<string>.Some {value: text} => {
      let _wroteDelimiter = run appendText(&mut output, delimiter)
      let _wroteValue = run appendText(&mut output, text)
    }
    Option<string>.None => {}
  }
  return ()
}

fn startsAt(bytes: &[u8], index: usize, prefix: string) -> bool {
  let expected = String.utf8Bytes(prefix)
  if bytes.length - index < expected.length {
    return false
  }
  let mut cursor: usize = 0
  while cursor < expected.length {
    if bytes[index + cursor] != expected[cursor] {
      return false
    }
    cursor = cursor + 1
  }
  return true
}

fn previousSegment(bytes: &[u8], start: usize, end: usize) -> usize {
  let mut previous = end
  while previous > start {
    previous = previous - 1
    if bytes[previous] == 47 {
      break
    }
  }
  return previous
}

// RFC 5.2.4 in-place compaction: written never exceeds read, so unread input is retained.
fn removeDots(bytes: &mut [u8], start: usize) -> usize {
  let mut read = start
  let mut written = start
  while read < bytes.length {
    if startsAt(&bytes, read, "../") {
      read = read + 3
    } else if startsAt(&bytes, read, "./") {
      read = read + 2
    } else if startsAt(&bytes, read, "/./") {
      read = read + 2
    } else if startsAt(&bytes, read, "/.") && bytes.length - read == 2 {
      bytes[written] = 47
      written = written + 1
      read = bytes.length
    } else if startsAt(&bytes, read, "/../") {
      written = previousSegment(&bytes, start, written)
      read = read + 3
    } else if startsAt(&bytes, read, "/..") && bytes.length - read == 3 {
      written = previousSegment(&bytes, start, written)
      bytes[written] = 47
      written = written + 1
      read = bytes.length
    } else if (startsAt(&bytes, read, ".") && bytes.length - read == 1) || (startsAt(
      &bytes,
      read,
      "..",
    ) && bytes.length - read == 2) {
      read = bytes.length
    } else {
      bytes[written] = bytes[read]
      written = written + 1
      read = read + 1
      while read < bytes.length && bytes[read] != 47 {
        bytes[written] = bytes[read]
        written = written + 1
        read = read + 1
      }
    }
  }
  return written
}

fn validateResolved<'text>(text: string<'text>) -> Result<(), ParseError> {
  return match move Uri.parse(text) {
    Result<Uri<'text>, ParseError>.Success {..} => Result<(), ParseError>.succeed(())
    Result<Uri<'text>, ParseError>.Failure {error} => Result<(), ParseError>.failResult(error)
  }
}
