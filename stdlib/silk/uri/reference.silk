//! Parse a URI or a relative reference (RFC 3986) and read its components without allocation.
//!
//! # When to use
//! Use [`UriReference.parse`] for text that can be relative, such as an HTML `href`, a redirect
//! `Location`, or a request target like `/search?q=silk`. Use `silk.uri.uri` when the text must have a
//! scheme. To change components or build a reference, use `silk.uri.components`. To decode the
//! escapes in a component, use `silk.uri.percent`.
//!
//! # Details
//! [`UriReference.parse`] checks the generic syntax of RFC 3986 and returns a view that borrows the
//! input. The component functions return slices of the input, so nothing is decoded or normalized:
//! the case of letters and the spelling of `%XX` escapes do not change. An absent component and an
//! empty component are different: `http://a/` has no query, but `http://a/?` has an empty query.
//! [`OwnedUriReference`] holds the text and the parsed ranges together, for a value that lives
//! longer than its input.
//!
//! # Errors
//! [`UriReference.parse`] returns a [`ParseError`] with the cause, the component, and the byte
//! position.
//!
//! # Gotchas
//! The parser checks syntax only. It does not check that a scheme is known, that a host exists, or
//! that a port is in range. Raw non-ASCII bytes, spaces, and IPv6 zone identifiers are not valid
//! RFC 3986 syntax. Encode them with `silk.uri.percent` first.
//!
//! # Examples
//! ## Read the parts of a relative reference
//! ```silk
//! import silk.core.option { Option }
//! import silk.core.result { Result }
//! import silk.uri.reference { ParseError, UriReference }
//!
//! pub fn main() -> i32 {
//!   let reference = match UriReference.parse("/search?q=silk#results") {
//!     Result<UriReference, ParseError>.Success { value } => value
//!     Result<UriReference, ParseError>.Failure {..} => {
//!       return 1
//!     }
//!   }
//!   let relative = match UriReference.scheme(&reference) {
//!     Option<string>.Some {..} => false
//!     Option<string>.None => true
//!   }
//!   let query = UriReference.query(&reference) |> Option<string>.unwrapOr("")
//!   if !relative || UriReference.path(&reference) != "/search" || query != "q=silk" {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! ## Find the position of a syntax error
//! ```silk
//! import silk.core.result { Result }
//! import silk.uri.reference { Component, ParseError, ParseReason, UriReference }
//!
//! pub fn main() -> i32 {
//!   return match UriReference.parse("http://example.com:80a/") {
//!     Result<UriReference, ParseError>.Failure { error } => {
//!       if error.reason != ParseReason.InvalidPort || error.component != Component.Port
//!         || error.offset != 21 {
//!         return 1
//!       }
//!       return 0
//!     }
//!     Result<UriReference, ParseError>.Success {..} => 1
//!   }
//! }
//! ```
//!
//! @category Data formats

import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.text.format {Debug, Format, Formatter}
import silk.core.option {Option}
import silk.core.ownership {Copy}
import silk.core.result {Result}
import silk.text.string {String}
import silk.collections.slice {Slice}
import silk.num.usize
import silk.num.u8
import silk.io.writer {Writer, WriterError}

/// The form of a host, from [`UriReference.hostKind`].
pub enum HostKind {
  /// A registered name, such as `example.com`. An empty host also has this kind.
  RegName,
  /// An IPv4 address in dotted decimal form, such as `192.0.2.1`. An octet with more than one digit
  /// must not start with 0.
  Ipv4,
  /// An IPv6 address in brackets, such as `[2001:db8::1]`. A zone identifier is not allowed.
  Ipv6,
  /// A future IP literal in brackets, such as `[v1.x]`.
  IpvFuture,
}

impl Debug for HostKind {
  /// Writes the name of the variant, such as `RegName`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      HostKind.RegName => run Format.write(&mut formatter, b"RegName")
      HostKind.Ipv4 => run Format.write(&mut formatter, b"Ipv4")
      HostKind.Ipv6 => run Format.write(&mut formatter, b"Ipv6")
      HostKind.IpvFuture => run Format.write(&mut formatter, b"IpvFuture")
    }
  }
}

/// A component of a URI reference.
pub enum Component {
  /// The scheme, such as `https`, without the `:`.
  Scheme,
  /// The authority after `//`: user information, host, and port.
  Authority,
  /// The user information before `@`.
  Userinfo,
  /// The registered name or IP literal.
  Host,
  /// The decimal port after the `:` of the authority.
  Port,
  /// The path, up to `?` or `#`.
  Path,
  /// The query after `?`.
  Query,
  /// The fragment after `#`.
  Fragment,
}

impl Debug for Component {
  /// Writes the name of the variant, such as `Scheme`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      Component.Scheme => run Format.write(&mut formatter, b"Scheme")
      Component.Authority => run Format.write(&mut formatter, b"Authority")
      Component.Userinfo => run Format.write(&mut formatter, b"Userinfo")
      Component.Host => run Format.write(&mut formatter, b"Host")
      Component.Port => run Format.write(&mut formatter, b"Port")
      Component.Path => run Format.write(&mut formatter, b"Path")
      Component.Query => run Format.write(&mut formatter, b"Query")
      Component.Fragment => run Format.write(&mut formatter, b"Fragment")
    }
  }
}

/// The cause of a [`ParseError`].
pub enum ParseReason {
  /// A byte that the component does not allow, such as a space or a non-ASCII byte.
  InvalidCharacter,
  /// A `%` that is not followed by two hexadecimal digits.
  InvalidPercentEscape,
  /// A scheme that is empty or does not start with a letter followed by letters, digits, `+`, `-`,
  /// or `.`.
  InvalidScheme,
  /// An IP literal or a host that does not follow the host grammar.
  InvalidHost,
  /// A port that has a byte that is not a decimal digit.
  InvalidPort,
  /// The text has no scheme, but a function such as `Uri.parse` needs one.
  MissingScheme,
}

impl Debug for ParseReason {
  /// Writes the name of the variant, such as `InvalidCharacter`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      ParseReason.InvalidCharacter => run Format.write(&mut formatter, b"InvalidCharacter")
      ParseReason.InvalidPercentEscape => run Format.write(&mut formatter, b"InvalidPercentEscape")
      ParseReason.InvalidScheme => run Format.write(&mut formatter, b"InvalidScheme")
      ParseReason.InvalidHost => run Format.write(&mut formatter, b"InvalidHost")
      ParseReason.InvalidPort => run Format.write(&mut formatter, b"InvalidPort")
      ParseReason.MissingScheme => run Format.write(&mut formatter, b"MissingScheme")
    }
  }
}

/// A URI syntax error: the cause, the component, and the byte position.
pub struct ParseError {
  /// The cause of the error.
  pub reason: ParseReason,
  /// The component that has the error.
  pub component: Component,
  /// The position of the byte that is not valid, from the start of the text. If required syntax is
  /// missing, it is the position where it must be.
  pub offset: usize,
}

impl Copy for ParseError {}

impl Debug for ParseError {
  /// Writes the fields, as `ParseError { reason: ..., component: ..., ... }`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return run Format.debugFields(self, "ParseError", &mut formatter)
  }
}

struct Range {
  present: bool,
  start: usize,
  end: usize,
}

impl Copy for Range {}

struct Parts {
  scheme: Range,
  authority: Range,
  userinfo: Range,
  host: Range,
  port: Range,
  path: Range,
  query: Range,
  fragment: Range,
  hostKind: HostKind,
}

impl Copy for Parts {}

/// A parsed URI reference that borrows its text.
///
/// It is `Copy` and does not allocate. It cannot live longer than its text. Use
/// [`UriReference.copy`] or [`UriReference.parseOwned`] to get an [`OwnedUriReference`].
///
/// The component functions return slices of the input, so nothing is decoded or normalized: the
/// case of letters and the spelling of `%XX` escapes do not change. An absent component and an
/// empty component are different: `http://a/` has no query, but `http://a/?` has an empty query.
///
/// # Gotchas
/// The parser checks syntax only. It does not check that a scheme is known, that a host exists, or
/// that a port is in range.
pub struct UriReference<'text> {
  text: string<'text>,
  parts: Parts,
}

impl<'text> Copy for UriReference<'text> {}

impl<'text> UriReference<'text> {
  /// Parses `text` as a URI reference: a URI with a scheme, or a relative reference.
  ///
  /// It does not allocate, decode, or normalize. If a host is a valid IPv4 address, its kind is
  /// `Ipv4`, not `RegName`.
  ///
  /// # Errors
  /// - [`ParseError`] for the first syntax problem, with its component and byte position.
  pub fn parse(text: string<'text>) -> Result<UriReference<'text>, ParseError> {
    let mut parts = emptyParts()
    let error = validate(text, &mut parts)
    match move error {
      Option<ParseError>.Some {value} => {
        return Result<UriReference<'text>, ParseError>.failResult(value)
      }
      Option<ParseError>.None => {}
    }
    return Result<UriReference<'text>, ParseError>.succeed(
      UriReference<'text> {text: text, parts: parts},
    )
  }
  /// Checks that `text` is valid encoded text for one `component`, and returns the error or `None`.
  ///
  /// The error `offset` is a position in `text`. A host can be a registered name or an IP literal
  /// in brackets, but not user information or a port. An empty host or port is valid.
  ///
  /// # Gotchas
  /// For a path, it checks only the bytes. Some paths are not valid in every position, for example
  /// a path that starts with `//` when there is no authority.
  pub fn validateComponent(text: string, component: Component) -> Option<ParseError> {
    let bytes = String.utf8Bytes(text)
    let length = bytes.length
    if component == Component.Scheme {
      return schemeError(bytes, 0, length)
    }
    if component == Component.Port {
      let mut index: usize = 0
      while index < length {
        if !digit(bytes[index]) {
          return failure(ParseReason.InvalidPort, component, index)
        }
        index = index + 1
      }
      return Option<ParseError>.none()
    }
    if component == Component.Authority {
      let mut parts = emptyParts()
      return authorityError(bytes, 0, length, &mut parts)
    }
    if component == Component.Host && length > 0 && bytes[0] == 91 {
      let mut parts = emptyParts()
      let error = authorityError(bytes, 0, length, &mut parts)
      match move error {
        Option<ParseError>.Some {value} => {
          return Option<ParseError>.some(value)
        }
        Option<ParseError>.None => {}
      }
      if parts.port.present || parts.userinfo.present {
        return failure(ParseReason.InvalidHost, component, parts.host.end)
      }
      return Option<ParseError>.none()
    }
    return componentError(bytes, 0, length, component)
  }
  /// Returns an [`OwnedUriReference`] with a copy of the text. It does not parse again.
  ///
  /// # Errors
  /// - `OutOfMemoryError` if the `Allocator` fails.
  pub effect fn copy(self: &Self) -> OwnedUriReference ! OutOfMemoryError ? &mut Allocator {
    let text = run String.copy(self.text)
    return OwnedUriReference {text: move text, parts: self.parts}
  }
  /// Parses `text` and returns an [`OwnedUriReference`] with a copy of it.
  ///
  /// # Errors
  /// - `Failure` with a [`ParseError`] if `text` is not valid. Nothing is allocated.
  /// - `OutOfMemoryError` if the `Allocator` fails.
  pub effect fn parseOwned(text: string<'text>) -> Result<OwnedUriReference, ParseError>
  ! OutOfMemoryError
  ? &mut Allocator {
    let parsed = UriReference.parse(text)
    return match move parsed {
      Result<UriReference<'text>, ParseError>.Failure {error} => Result<
        OwnedUriReference,
        ParseError,
      >.failResult(error)
      Result<UriReference<'text>, ParseError>.Success {value} => {
        let owned = run UriReference.copy(&value)
        return Result<OwnedUriReference, ParseError>.succeed(move owned)
      }
    }
  }
  /// Returns the full text of the reference, as it was parsed.
  pub fn format(self: &Self) -> string<'text> {
    return self.text
  }
  /// Returns the scheme without the `:`, or `None` for a relative reference. The case of the
  /// letters does not change.
  pub fn scheme(self: &Self) -> Option<string<'text>> {
    return optional(self, self.parts.scheme)
  }
  /// Returns the authority without the `//`. Returns `None` if the component is absent. A component
  /// that is present but empty, such as the query of `http://a/?`, returns `Some("")`.
  pub fn authority(self: &Self) -> Option<string<'text>> {
    return optional(self, self.parts.authority)
  }
  /// Returns the user information without the `@`. Returns `None` if the component is absent. A
  /// component that is present but empty, such as the query of `http://a/?`, returns `Some("")`.
  ///
  /// The text is not split at `:` into a user name and a password.
  pub fn userinfo(self: &Self) -> Option<string<'text>> {
    return optional(self, self.parts.userinfo)
  }
  /// Returns the host, with the brackets of an IP literal. Returns `None` if there is no authority.
  ///
  /// The host of `file:///x` is present and empty.
  pub fn host(self: &Self) -> Option<string<'text>> {
    return optional(self, self.parts.host)
  }
  /// Returns the port digits without the `:`. Returns `None` if the component is absent. A
  /// component that is present but empty, such as the query of `http://a/?`, returns `Some("")`.
  ///
  /// It does not convert the port to a number or check its range.
  pub fn port(self: &Self) -> Option<string<'text>> {
    return optional(self, self.parts.port)
  }
  /// Returns the path. The path is always present, but it can be empty.
  pub fn path(self: &Self) -> string<'text> {
    return portion(self, self.parts.path)
  }
  /// Returns the query without the `?`. Returns `None` if the component is absent. A component that
  /// is present but empty, such as the query of `http://a/?`, returns `Some("")`.
  pub fn query(self: &Self) -> Option<string<'text>> {
    return optional(self, self.parts.query)
  }
  /// Returns the fragment without the `#`. Returns `None` if the component is absent. A component
  /// that is present but empty, such as the query of `http://a/?`, returns `Some("")`.
  pub fn fragment(self: &Self) -> Option<string<'text>> {
    return optional(self, self.parts.fragment)
  }
  /// Returns the [`HostKind`] of the host, or `None` if there is no authority.
  pub fn hostKind(self: &Self) -> Option<HostKind> {
    if self.parts.authority.present {
      return Option<HostKind>.some(self.parts.hostKind)
    }
    return Option<HostKind>.none()
  }
}

/// A URI reference that owns its text and its parsed ranges.
///
/// Get one from [`UriReference.copy`], [`UriReference.parseOwned`], or
/// [`OwnedUriReference.fromString`]. [`OwnedUriReference.view`] returns a [`UriReference`] without
/// parsing again.
pub struct OwnedUriReference {
  text: String,
  parts: Parts,
}

impl OwnedUriReference {
  /// Parses `text` and keeps it, without a copy or an allocation.
  ///
  /// # Errors
  /// - `Failure` with a [`ParseError`] if `text` is not valid.
  ///
  /// # Gotchas
  /// It consumes `text` also when it fails.
  pub fn fromString(text: String) -> Result<OwnedUriReference, ParseError> {
    let mut parts = emptyParts()
    let error = validate(String.view(&text), &mut parts)
    match move error {
      Option<ParseError>.Some {value} => {
        return Result<OwnedUriReference, ParseError>.failResult(value)
      }
      Option<ParseError>.None => {}
    }
    return Result<OwnedUriReference, ParseError>.succeed(
      OwnedUriReference {text: move text, parts: parts},
    )
  }
  /// Returns a [`UriReference`] that borrows this value. It does not parse again or allocate.
  pub fn view(self: &Self) -> UriReference {
    return UriReference {text: String.view(&self.text), parts: self.parts}
  }
  /// Returns the text and consumes the value. It does not copy.
  pub fn intoString(self: Self) -> String {
    return match move self {
      OwnedUriReference {text, parts: _} => move text
    }
  }
}

fn portion<'text>(self: &UriReference<'text>, range: Range) -> string<'text> {
  let bytes = String.utf8Bytes(self.text)
  let selected = Slice.view<u8>(bytes, range.start, range.end - range.start)
  // Validation guarantees ASCII and ranges within the immutable original input.
  return unsafe String.fromUtf8Unchecked(selected)
}

fn optional<'text>(self: &UriReference<'text>, range: Range) -> Option<string<'text>> {
  if range.present {
    return Option<string<'text>>.some(portion(self, range))
  }
  return Option<string<'text>>.none()
}

fn absent() -> Range {
  return Range {present: false, start: 0, end: 0}
}

fn range(start: usize, end: usize) -> Range {
  return Range {present: true, start: start, end: end}
}

fn emptyParts() -> Parts {
  return Parts {
    scheme: absent(),
    authority: absent(),
    userinfo: absent(),
    host: absent(),
    port: absent(),
    path: absent(),
    query: absent(),
    fragment: absent(),
    hostKind: HostKind.RegName,
  }
}

fn failure(reason: ParseReason, component: Component, offset: usize) -> Option<ParseError> {
  return Option<ParseError>.some(ParseError {reason: reason, component: component, offset: offset})
}

fn alpha(c: u8) -> bool {
  return (c >= 65 && c <= 90) || (c >= 97 && c <= 122)
}

fn digit(c: u8) -> bool {
  return c >= 48 && c <= 57
}

fn hex(c: u8) -> bool {
  return digit(c) || (c >= 65 && c <= 70) || (c >= 97 && c <= 102)
}

fn unreserved(c: u8) -> bool {
  return alpha(c) || digit(c) || c == 45 || c == 46 || c == 95 || c == 126
}

fn subdelim(c: u8) -> bool {
  return c == 33 || c == 36 || c == 38 || c == 39 || c == 40 || c == 41 || c == 42 || c == 43 || c == 44 || c == 59 || c == 61
}

// Percent sequences stay lexical. Their payload never participates in delimiter recognition.
fn componentError(bytes: &[u8], start: usize, end: usize, component: Component) -> Option<
  ParseError,
> {
  let mut i = start
  while i < end {
    let c = bytes[i]
    if c == 37 {
      if end - i < 3 {
        return failure(ParseReason.InvalidPercentEscape, component, i)
      }
      if hex(bytes[i + 1]) == false {
        return failure(ParseReason.InvalidPercentEscape, component, i + 1)
      }
      if hex(bytes[i + 2]) == false {
        return failure(ParseReason.InvalidPercentEscape, component, i + 2)
      }
      i = i + 3
    } else {
      let allowed = unreserved(c) || subdelim(c) || match component {
        Component.Userinfo => c == 58
        Component.Path => c == 58 || c == 64 || c == 47
        Component.Query => c == 58 || c == 64 || c == 47 || c == 63
        Component.Fragment => c == 58 || c == 64 || c == 47 || c == 63
        Component.Scheme => false
        Component.Authority => false
        Component.Host => false
        Component.Port => false
      }
      if allowed == false {
        return failure(ParseReason.InvalidCharacter, component, i)
      }
      i = i + 1
    }
  }
  return Option<ParseError>.none()
}

fn schemeError(bytes: &[u8], start: usize, end: usize) -> Option<ParseError> {
  if start == end || !alpha(bytes[start]) {
    return failure(ParseReason.InvalidScheme, Component.Scheme, start)
  }
  let mut index = start + 1
  while index < end {
    let c = bytes[index]
    if !alpha(c) && !digit(c) && c != 43 && c != 45 && c != 46 {
      return failure(ParseReason.InvalidScheme, Component.Scheme, index)
    }
    index = index + 1
  }
  return Option<ParseError>.none()
}

fn validate(text: string, parts: &mut Parts) -> Option<ParseError> {
  let bytes = String.utf8Bytes(text)
  let n = bytes.length
  let mut i = usize.ZERO
  while i < n && bytes[i] != 58 && bytes[i] != 47 && bytes[i] != 63 && bytes[i] != 35 {
    i = i + 1
  }
  let mut pathStart = usize.ZERO
  if i < n && bytes[i] == 58 {
    let error = schemeError(bytes, 0, i)
    match move error {
      Option<ParseError>.Some {value} => {
        return Option<ParseError>.some(value)
      }
      Option<ParseError>.None => {}
    }
    parts.scheme = range(0, i)
    pathStart = i + 1
  }
  i = pathStart
  if n - i >= 2 && bytes[i] == 47 && bytes[i + 1] == 47 {
    let start = i + 2
    i = start
    while i < n && bytes[i] != 47 && bytes[i] != 63 && bytes[i] != 35 {
      i = i + 1
    }
    parts.authority = range(start, i)
    let error = authorityError(bytes, start, i, &mut parts)
    match move error {
      Option<ParseError>.Some {value} => {
        return Option<ParseError>.some(value)
      }
      Option<ParseError>.None => {}
    }
    pathStart = i
  }
  i = pathStart
  while i < n && bytes[i] != 63 && bytes[i] != 35 {
    i = i + 1
  }
  parts.path = range(pathStart, i)
  let pathError = componentError(bytes, pathStart, i, Component.Path)
  match move pathError {
    Option<ParseError>.Some {value} => {
      return Option<ParseError>.some(value)
    }
    Option<ParseError>.None => {}
  }
  if i < n && bytes[i] == 63 {
    let start = i + 1
    i = start
    while i < n && bytes[i] != 35 {
      i = i + 1
    }
    parts.query = range(start, i)
    let error = componentError(bytes, start, i, Component.Query)
    match move error {
      Option<ParseError>.Some {value} => {
        return Option<ParseError>.some(value)
      }
      Option<ParseError>.None => {}
    }
  }
  if i < n {
    parts.fragment = range(i + 1, n)
    return componentError(bytes, i + 1, n, Component.Fragment)
  }
  return Option<ParseError>.none()
}

fn authorityError(bytes: &[u8], start: usize, end: usize, parts: &mut Parts) -> Option<ParseError> {
  let mut i = start
  let mut hostStart = start
  while i < end {
    if bytes[i] == 64 {
      if parts.userinfo.present {
        return failure(ParseReason.InvalidCharacter, Component.Authority, i)
      }
      parts.userinfo = range(start, i)
      hostStart = i + 1
    }
    i = i + 1
  }
  if parts.userinfo.present {
    let error = componentError(bytes, start, hostStart - 1, Component.Userinfo)
    match move error {
      Option<ParseError>.Some {value} => {
        return Option<ParseError>.some(value)
      }
      Option<ParseError>.None => {}
    }
  }
  let mut hostEnd = end
  if hostStart < end && bytes[hostStart] == 91 {
    i = hostStart + 1
    while i < end && bytes[i] != 93 {
      i = i + 1
    }
    if i == end {
      return failure(ParseReason.InvalidHost, Component.Host, end)
    }
    hostEnd = i + 1
    let literalStart = hostStart + 1
    if literalStart < i && (bytes[literalStart] == 118 || bytes[literalStart] == 86) {
      let bad = ipvFutureError(bytes, literalStart, i)
      if bad < i + 1 {
        return failure(ParseReason.InvalidHost, Component.Host, bad)
      }
      parts.hostKind = HostKind.IpvFuture
    } else {
      let bad = ipv6Error(bytes, literalStart, i)
      if bad < i + 1 {
        return failure(ParseReason.InvalidHost, Component.Host, bad)
      }
      parts.hostKind = HostKind.Ipv6
    }
    if hostEnd < end && bytes[hostEnd] != 58 {
      return failure(ParseReason.InvalidHost, Component.Host, hostEnd)
    }
  } else {
    i = hostStart
    while i < end && bytes[i] != 58 {
      i = i + 1
    }
    hostEnd = i
    let error = componentError(bytes, hostStart, hostEnd, Component.Host)
    match move error {
      Option<ParseError>.Some {value} => {
        return Option<ParseError>.some(value)
      }
      Option<ParseError>.None => {}
    }
    if ipv4(bytes, hostStart, hostEnd) {
      parts.hostKind = HostKind.Ipv4
    }
  }
  parts.host = range(hostStart, hostEnd)
  if hostEnd < end {
    parts.port = range(hostEnd + 1, end)
    i = hostEnd + 1
    while i < end {
      if digit(bytes[i]) == false {
        return failure(ParseReason.InvalidPort, Component.Port, i)
      }
      i = i + 1
    }
  }
  return Option<ParseError>.none()
}

fn ipv4(bytes: &[u8], start: usize, end: usize) -> bool {
  let mut i = start
  let mut groups = usize.ZERO
  while i < end {
    let begin = i
    let mut value = 0
    while i < end && digit(bytes[i]) {
      if i - begin == 3 {
        return false
      }
      value = value * 10 + u8.toI32(bytes[i]) - 48
      i = i + 1
    }
    if i == begin || value > 255 {
      return false
    }
    if i - begin > 1 && bytes[begin] == 48 {
      return false
    }
    groups = groups + 1
    if i < end {
      if bytes[i] != 46 {
        return false
      }
      i = i + 1
      if i == end {
        return false
      }
    }
  }
  return groups == 4
}

// Success uses end + 1 so an error at a missing terminal byte remains representable.
fn ipvFutureError(bytes: &[u8], start: usize, end: usize) -> usize {
  let mut i = start + 1
  let version = i
  while i < end && hex(bytes[i]) {
    i = i + 1
  }
  if i == version || i == end {
    return i
  }
  if bytes[i] != 46 {
    return i
  }
  i = i + 1
  if i == end {
    return i
  }
  while i < end {
    let c = bytes[i]
    if unreserved(c) == false && subdelim(c) == false && c != 58 {
      return i
    }
    i = i + 1
  }
  return end + 1
}

// Count h16 groups; a terminal IPv4 tail occupies two groups. Compression must omit at least one.
fn ipv6Error(bytes: &[u8], start: usize, end: usize) -> usize {
  let mut i = start
  let mut groups = usize.ZERO
  let mut compressed = false
  if i == end {
    return i
  }
  if bytes[i] == 58 {
    if end - i < 2 || bytes[i + 1] != 58 {
      return i
    }
    compressed = true
    i = i + 2
  }
  while i < end {
    let begin = i
    while i < end && bytes[i] != 58 {
      i = i + 1
    }
    let mut j = begin
    let mut dotted = false
    while j < i {
      if bytes[j] == 46 {
        dotted = true
      }
      j = j + 1
    }
    if dotted {
      if i != end || ipv4(bytes, begin, i) == false {
        return begin
      }
      groups = groups + 2
    } else {
      if i == begin {
        return i
      }
      j = begin
      while j < i {
        if j - begin == 4 || hex(bytes[j]) == false {
          return j
        }
        j = j + 1
      }
      groups = groups + 1
    }
    if groups > 8 {
      return begin
    }
    if i < end {
      i = i + 1
      if i < end && bytes[i] == 58 {
        if compressed {
          return i
        }
        compressed = true
        i = i + 1
      } else {
        if i == end {
          return i
        }
      }
    }
  }
  if compressed {
    if groups < 8 {
      return end + 1
    }
  } else {
    if groups == 8 {
      return end + 1
    }
  }
  return end
}
