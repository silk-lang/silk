static if Intrinsic.targetOperatingSystem() == "windows" {
  import silk.platform.windows.winsock { WinsockSession }

  /// The type of a raw socket handle: a Windows `SOCKET`.
  pub type RawSocket = usize
  type SocketSession = WinsockSession
  unsafe extern "C" fn WSAGetLastError() -> i32
  unsafe extern "C" fn GetLastError() -> u32
  unsafe extern "C" fn WSASocketW(
    family: i32,
    kind: i32,
    protocol: i32,
    information: ?*mut u8,
    group: u32,
    flags: u32,
  ) -> usize
  unsafe extern "C" fn closesocket(fd: usize) -> i32
  @foreign(noCapture: .("value"))
  unsafe extern "C" fn ioctlsocket(fd: usize, command: i32, value: *mut u32) -> i32
  @foreign(noCapture: .("fds"))
  unsafe extern "C" fn WSAPoll(fds: ?[*]mut PollFd, count: u32, timeout: i32) -> i32
  @foreign(noCapture: ("buffer", "address"))
  unsafe extern "C" fn windowsSendTo(
    fd: usize,
    buffer: ?[*]const u8,
    length: i32,
    flags: i32,
    address: ?[*]const u8,
    addressLength: i32,
  ) -> i32 as "sendto"
  @foreign(noCapture: ("buffer", "address", "addressLength"))
  unsafe extern "C" fn windowsReceiveFrom(
    fd: usize,
    buffer: ?[*]mut u8,
    length: i32,
    flags: i32,
    address: ?[*]mut u8,
    addressLength: *mut i32,
  ) -> i32 as "recvfrom"
} else {
  /// The type of a raw socket handle: a file descriptor.
  pub type RawSocket = i32
  struct SocketSession {}
  @foreign(noCapture: ("buffer", "address"))
  unsafe extern "C" fn unixSendTo(
    fd: i32,
    buffer: ?[*]const u8,
    length: usize,
    flags: i32,
    address: ?[*]const u8,
    addressLength: u32,
  ) -> isize as "sendto"
  @foreign(noCapture: ("buffer", "address", "addressLength"))
  unsafe extern "C" fn unixReceiveFrom(
    fd: i32,
    buffer: ?[*]mut u8,
    length: usize,
    flags: i32,
    address: ?[*]mut u8,
    addressLength: *mut u32,
  ) -> isize as "recvfrom"
  unsafe extern "C" fn unixClose(fd: i32) -> i32 as "close"
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    unsafe extern "C" fn __error() -> *mut i32
    unsafe extern "C" fn unixSocket(domain: i32, socketType: i32, protocol: i32) -> i32 as "socket"
    unsafe extern "C" fn fcntl(fd: i32, command: i32, ...) -> i32
    @foreign(noCapture: .("fds"))
    unsafe extern "C" fn unixPoll(fds: ?[*]mut PollFd, count: u32, timeout: i32) -> i32 as "poll"
  } else {
    unsafe extern "C" fn __errno_location() -> *mut i32
    unsafe extern "C" fn unixSocket(domain: i32, socketType: i32, protocol: i32) -> i32 as "socket"
    @foreign(noCapture: .("fds"))
    unsafe extern "C" fn unixPoll(fds: ?[*]mut PollFd, count: usize, timeout: i32) -> i32 as "poll"
  }
}

