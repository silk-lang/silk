// struct ipv6_mreq.
extern "C" struct Ipv6GroupRequest {
  group: [u8; 16],
  index: u32,
}

// struct group_source_req. macOS packs it to 4 bytes; Linux and Windows align the sockaddr_storage
// fields to 8.
static if Intrinsic.targetOperatingSystem() == "darwin" {
  extern "C" struct SourceGroupRequest {
    index: u32,
    group: [u8; 128],
    source: [u8; 128],
  }
} else {
  extern "C" struct SourceGroupRequest {
    index: u32,
    padding: u32,
    group: [u8; 128],
    source: [u8; 128],
  }
}

extern "C" struct PollFd {
  fd: RawSocket,
  events: i16,
  revents: i16,
}

/// The address family of a socket.
pub enum Family {
  /// IPv4.
  V4,
  /// IPv6.
  V6,
}

/// The network interface for multicast traffic, in [`NativeUdpSocket.setMulticastInterface`] and
/// the group calls such as [`NativeUdpSocket.joinGroup`].
pub union MulticastInterface {
  /// The interface that the system chooses.
  Default,
  /// The IPv4 interface with this local address. Use it with IPv4 groups.
  V4 {
    /// The local address of the interface.
    pub address: Ipv4Address,
  },
  /// The IPv6 interface with this index, as `if_nametoindex` returns it. Use it with IPv6 groups.
  V6 {
    /// The index of the interface.
    pub index: u32,
  },
}

impl Copy for MulticastInterface {}

/// The system call that failed.
pub enum DatagramOperation {
  /// Making the socket.
  Socket,
  /// Making the socket nonblocking and not inherited by child processes.
  Configure,
  /// Binding a local address.
  Bind,
  /// Connecting to a peer.
  Connect,
  /// Sending a datagram.
  Send,
  /// Receiving a datagram.
  Receive,
  /// Reading the local address.
  LocalAddress,
  /// Reading the address of the connected peer.
  PeerAddress,
  /// Removing the connected peer.
  Disconnect,
  /// Reading or setting a socket option, such as the TTL or a multicast group.
  Option,
  /// Waiting for a datagram.
  Wait,
}

impl Debug for DatagramOperation {
  /// Writes the name of the variant, such as `Send`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return match &self.* {
      DatagramOperation.Socket => run Format.write(&mut formatter, b"Socket")
      DatagramOperation.Configure => run Format.write(&mut formatter, b"Configure")
      DatagramOperation.Bind => run Format.write(&mut formatter, b"Bind")
      DatagramOperation.Connect => run Format.write(&mut formatter, b"Connect")
      DatagramOperation.Send => run Format.write(&mut formatter, b"Send")
      DatagramOperation.Receive => run Format.write(&mut formatter, b"Receive")
      DatagramOperation.LocalAddress => run Format.write(&mut formatter, b"LocalAddress")
      DatagramOperation.PeerAddress => run Format.write(&mut formatter, b"PeerAddress")
      DatagramOperation.Disconnect => run Format.write(&mut formatter, b"Disconnect")
      DatagramOperation.Option => run Format.write(&mut formatter, b"Option")
      DatagramOperation.Wait => run Format.write(&mut formatter, b"Wait")
    }
  }
}

/// The error from a UDP socket operation.
pub union DatagramError {
  /// The peer reported that its port is closed. On Linux and macOS only a connected socket gets
  /// this; on Windows any socket can.
  ConnectionRefused {
    /// The operation that saw the report.
    pub operation: DatagramOperation,
  },
  /// The local address is in use.
  AddressInUse,
  /// The system does not allow the operation, for example a bind to a privileged port.
  PermissionDenied,
  /// The network or host of the peer cannot be reached.
  NetworkUnreachable,
  /// The datagram is too long to send, or, on Windows, too long for the receive buffer.
  MessageTooLarge,
  /// The address family is not supported or not enabled.
  FamilyUnsupported,
  /// The system returned an address that is not IPv4 or IPv6.
  InvalidNativeAddress,
  /// Another system error.
  NativeFailure {
    /// The operation that failed.
    pub operation: DatagramOperation,
    /// The `errno` value, or the Winsock error code on Windows.
    pub code: i32,
  },
}

impl Debug for DatagramError {
  /// Writes the name of the variant and its fields, such as `NativeFailure { ... }`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return match &self.* {
      DatagramError.ConnectionRefused { operation } => {
        let mut record = run Format.debugRecord("ConnectionRefused", &mut formatter)
        run Format.debugField(&mut record, "operation", &operation, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      DatagramError.AddressInUse => run Format.write(&mut formatter, b"AddressInUse")
      DatagramError.PermissionDenied => run Format.write(&mut formatter, b"PermissionDenied")
      DatagramError.NetworkUnreachable => run Format.write(&mut formatter, b"NetworkUnreachable")
      DatagramError.MessageTooLarge => run Format.write(&mut formatter, b"MessageTooLarge")
      DatagramError.FamilyUnsupported => run Format.write(&mut formatter, b"FamilyUnsupported")
      DatagramError.InvalidNativeAddress => run Format.write(
        &mut formatter,
        b"InvalidNativeAddress",
      )
      DatagramError.NativeFailure { operation, code } => {
        let mut record = run Format.debugRecord("NativeFailure", &mut formatter)
        run Format.debugField(&mut record, "operation", &operation, &mut formatter)
        run Format.debugField(&mut record, "code", &code, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
    }
  }
}

/// The result of a send.
pub union Sent {
  /// The system took the whole datagram.
  Count {
    /// The number of bytes sent, which is the length of the datagram.
    pub count: usize,
  },
  /// The send buffer is full. Try again later.
  WouldBlock,
}

/// The result of a receive.
pub union Received {
  /// One datagram is at the start of the buffer.
  Datagram {
    /// The number of bytes of the datagram in the buffer. A longer datagram is cut to the buffer
    /// length on Linux and macOS.
    pub count: usize,
    /// The address that sent the datagram.
    pub from: Endpoint,
  },
  /// No datagram is waiting. Try again later.
  WouldBlock,
}

/// A nonblocking UDP socket. It is closed when it is dropped.
pub struct NativeUdpSocket {
  fd: RawSocket,
  familyValue: Family,
  session: Option<SocketSession>,
}

impl Copy for PollFd {}

impl Drop for NativeUdpSocket {
  fn drop(self: &mut NativeUdpSocket) -> () {
    let fd = Intrinsic.replace(self.fd, invalidSocket())
    if fd != invalidSocket() {
      let _ignored = unsafe closeRaw(fd)
    }
  }
}

fn invalidSocket() -> RawSocket {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    return usize.MAX
  } else {
    return -1
  }
}

fn ipv6Family() -> i32 {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    return 23
  } else {
    static if Intrinsic.targetOperatingSystem() == "darwin" {
      return 30
    } else {
      return 10
    }
  }
}

fn ipv6OnlyOption() -> i32 {
  static if Intrinsic.targetOperatingSystem() == "linux" {
    return 26
  } else {
    return 27
  }
}

// Option levels and names. Linux uses its own numbers; macOS and Windows share the BSD numbers for
// most of them.
fn socketLevel() -> i32 {
  static if Intrinsic.targetOperatingSystem() == "linux" { return 1 } else { return 65535 }
}

fn reuseAddressOption() -> i32 {
  static if Intrinsic.targetOperatingSystem() == "linux" { return 2 } else { return 4 }
}

fn broadcastOption() -> i32 {
  static if Intrinsic.targetOperatingSystem() == "linux" { return 6 } else { return 32 }
}

fn sendBufferOption() -> i32 {
  static if Intrinsic.targetOperatingSystem() == "linux" { return 7 } else { return 4097 }
}

fn receiveBufferOption() -> i32 {
  static if Intrinsic.targetOperatingSystem() == "linux" { return 8 } else { return 4098 }
}

const IP_LEVEL: i32 = 0
const IPV6_LEVEL: i32 = 41

// IP_TTL, IP_MULTICAST_IF, IP_MULTICAST_TTL, IP_MULTICAST_LOOP, IP_ADD_MEMBERSHIP,
// IP_DROP_MEMBERSHIP, IP_ADD_SOURCE_MEMBERSHIP and IP_DROP_SOURCE_MEMBERSHIP, in that order.
fn ipv4Option(index: usize) -> i32 {
  static if Intrinsic.targetOperatingSystem() == "linux" {
    let names = [2, 32, 33, 34, 35, 36, 39, 40]
    return names[index]
  } else {
    static if Intrinsic.targetOperatingSystem() == "darwin" {
      let names = [4, 9, 10, 11, 12, 13, 70, 71]
      return names[index]
    } else {
      let names = [4, 9, 10, 11, 12, 13, 15, 16]
      return names[index]
    }
  }
}

// IPV6_UNICAST_HOPS, IPV6_MULTICAST_IF, IPV6_MULTICAST_HOPS, IPV6_MULTICAST_LOOP,
// IPV6_JOIN_GROUP, IPV6_LEAVE_GROUP, MCAST_JOIN_SOURCE_GROUP and MCAST_LEAVE_SOURCE_GROUP.
fn ipv6Option(index: usize) -> i32 {
  static if Intrinsic.targetOperatingSystem() == "linux" {
    let names = [16, 17, 18, 19, 20, 21, 46, 47]
    return names[index]
  } else {
    static if Intrinsic.targetOperatingSystem() == "darwin" {
      let names = [4, 9, 10, 11, 12, 13, 82, 83]
      return names[index]
    } else {
      let names = [4, 9, 10, 11, 12, 13, 45, 46]
      return names[index]
    }
  }
}

const TTL_OPTION: usize = 0
const MULTICAST_INTERFACE_OPTION: usize = 1
const MULTICAST_TTL_OPTION: usize = 2
const MULTICAST_LOOP_OPTION: usize = 3
const JOIN_OPTION: usize = 4
const LEAVE_OPTION: usize = 5
const JOIN_SOURCE_OPTION: usize = 6
const LEAVE_SOURCE_OPTION: usize = 7

// Error codes: errno on Linux and macOS, Winsock codes on Windows.
fn wouldBlockCode() -> i32 {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    return 10035
  } else {
    static if Intrinsic.targetOperatingSystem() == "darwin" {
      return 35
    } else {
      return 11
    }
  }
}

fn interruptedCode() -> i32 {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    return 10004
  } else {
    return 4
  }
}

fn refusedCode() -> i32 {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    return 10054
  } else {
    static if Intrinsic.targetOperatingSystem() == "darwin" {
      return 61
    } else {
      return 111
    }
  }
}

fn addressInUseCode() -> i32 {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    return 10048
  } else {
    static if Intrinsic.targetOperatingSystem() == "darwin" {
      return 48
    } else {
      return 98
    }
  }
}

fn permissionCode() -> i32 {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    return 10013
  } else {
    return 13
  }
}

fn networkUnreachableCode() -> i32 {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    return 10051
  } else {
    static if Intrinsic.targetOperatingSystem() == "darwin" {
      return 51
    } else {
      return 101
    }
  }
}

fn hostUnreachableCode() -> i32 {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    return 10065
  } else {
    static if Intrinsic.targetOperatingSystem() == "darwin" {
      return 65
    } else {
      return 113
    }
  }
}

fn messageSizeCode() -> i32 {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    return 10040
  } else {
    static if Intrinsic.targetOperatingSystem() == "darwin" {
      return 40
    } else {
      return 90
    }
  }
}

fn familyCode() -> i32 {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    return 10047
  } else {
    static if Intrinsic.targetOperatingSystem() == "darwin" {
      return 47
    } else {
      return 97
    }
  }
}

unsafe fn lastError() -> i32 {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    return unsafe WSAGetLastError()
  } else {
    static if Intrinsic.targetOperatingSystem() == "darwin" {
      unsafe {
        return Pointer.read<i32>(__error())
      }
    } else {
      unsafe {
        return Pointer.read<i32>(__errno_location())
      }
    }
  }
}

unsafe fn closeRaw(fd: RawSocket) -> i32 {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    return unsafe closesocket(fd)
  } else {
    return unsafe unixClose(fd)
  }
}

fn classify(operation: DatagramOperation, code: i32) -> DatagramError {
  if code == refusedCode() {
    return DatagramError.ConnectionRefused { operation: operation }
  }
  if code == addressInUseCode() {
    return DatagramError.AddressInUse
  }
  if code == permissionCode() {
    return DatagramError.PermissionDenied
  }
  if code == networkUnreachableCode() || code == hostUnreachableCode() {
    return DatagramError.NetworkUnreachable
  }
  if code == messageSizeCode() {
    return DatagramError.MessageTooLarge
  }
  if code == familyCode() {
    return DatagramError.FamilyUnsupported
  }
  return DatagramError.NativeFailure { operation: operation, code: code }
}

// A socket address in native layout, and its length.
struct NativeAddress {
  bytes: [u8; 28],
  length: u32,
}

fn encodeAddress(endpoint: &Endpoint) -> NativeAddress {
  let mut bytes: [u8; 28] = [0; 28]
  let port = Port.value(&Endpoint.port(endpoint))
  bytes[2] = u16.toU8(port / 256)
  bytes[3] = u16.toU8(port % 256)
  let mut family: i32 = 2
  let mut length: u32 = 16
  match Endpoint.address(endpoint) {
    IpAddress.V4 { value } => {
      let octets = Ipv4Address.octets(&value)
      let mut index: usize = 0
      while index < 4 {
        bytes[4 + index] = octets[index]
        index = index + 1
      }
    }
    IpAddress.V6 { value } => {
      family = ipv6Family()
      length = 28
      let octets = Ipv6Address.octets(&value)
      let mut index: usize = 0
      while index < 16 {
        bytes[8 + index] = octets[index]
        index = index + 1
      }
    }
  }
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    bytes[0] = u32.toU8(length)
    bytes[1] = i32.toU8(family)
  } else {
    bytes[0] = i32.toU8(family)
  }
  return NativeAddress { bytes: bytes, length: length }
}

fn decodeAddress(bytes: &[u8; 128], length: usize) -> Result<Endpoint, DatagramError> {
  let mut family: i32 = 0
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    family = u8.toI32(bytes[1])
  } else {
    family = u8.toI32(bytes[0]) + u8.toI32(bytes[1]) * 256
  }
  let port = Port.fromU16(u8.toU16(bytes[2]) * 256 + u8.toU16(bytes[3]))
  if family == 2 && length >= 16 {
    let octets = [bytes[4], bytes[5], bytes[6], bytes[7]]
    return Result<Endpoint, DatagramError>.succeed(
      Endpoint.make(IpAddress.V4 { value: Ipv4Address.fromOctets(octets) }, port),
    )
  }
  if family == ipv6Family() && length >= 24 {
    let mut octets: [u8; 16] = [0; 16]
    let mut index: usize = 0
    while index < 16 {
      octets[index] = bytes[8 + index]
      index = index + 1
    }
    return Result<Endpoint, DatagramError>.succeed(
      Endpoint.make(IpAddress.V6 { value: Ipv6Address.fromOctets(octets) }, port),
    )
  }
  return Result<Endpoint, DatagramError>.failResult(DatagramError.InvalidNativeAddress)
}

effect fn session() -> SocketSession
  ! DatagramError {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    return match move WinsockSession.make() {
      Result<WinsockSession, i32>.Success { value } => move value
      Result<WinsockSession, i32>.Failure { error } => {
        fail DatagramError.NativeFailure { operation: DatagramOperation.Socket, code: error }
      }
    }
  } else {
    return SocketSession {}
  }
}

// Makes `fd` nonblocking and keeps it from child processes, where the socket call cannot.
unsafe fn configure(fd: RawSocket) -> i32 {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    let mut nonblocking: u32 = 1

    // FIONBIO uses Win32's signed 32-bit long, even on Win64.
    if unsafe ioctlsocket(fd, -2147195266, Pointer.fromMutRef(&mut nonblocking)) != 0 {
      return unsafe WSAGetLastError()
    }
    return 0
  } else {
    static if Intrinsic.targetOperatingSystem() == "darwin" {
      // F_GETFL, F_SETFL with O_NONBLOCK, then F_GETFD, F_SETFD with FD_CLOEXEC.
      let status = unsafe fcntl(fd, 3)
      if status < 0 || unsafe fcntl(fd, 4, i32.bitOr(status, 4)) < 0 {
        return unsafe lastError()
      }
      let flags = unsafe fcntl(fd, 1)
      if flags < 0 || unsafe fcntl(fd, 2, i32.bitOr(flags, 1)) < 0 {
        return unsafe lastError()
      }
      return 0
    } else {
      return 0
    }
  }
}

unsafe fn openRaw(family: i32) -> RawSocket {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    // SOCK_DGRAM, IPPROTO_UDP, WSA_FLAG_NO_HANDLE_INHERIT.
    return unsafe WSASocketW(family, 2, 17, Pointer.null<u8>(), 0, 128)
  } else {
    static if Intrinsic.targetOperatingSystem() == "darwin" {
      return unsafe unixSocket(family, 2, 17)
    } else {
      // SOCK_DGRAM | SOCK_NONBLOCK | SOCK_CLOEXEC.
      return unsafe unixSocket(family, 2 + 2048 + 524288, 17)
    }
  }
}

// Converts `deadline` to a poll timeout in milliseconds, rounded up, at most one minute so that a far
// deadline is checked again.
fn pollMilliseconds(now: &Instant, deadline: &Instant) -> i32 {
  let seconds = SystemClock.seconds(deadline) - SystemClock.seconds(now)
  let nanoseconds = SystemClock.nanoseconds(deadline) - SystemClock.nanoseconds(now)
  let total = seconds * 1000 + (nanoseconds + 999999) / 1000000
  if total <= 0 {
    return 0
  }
  if total > 60000 {
    return 60000
  }
  return i64.toI32(total)
}

fn reached(now: &Instant, deadline: &Instant) -> bool {
  if SystemClock.seconds(now) != SystemClock.seconds(deadline) {
    return SystemClock.seconds(now) > SystemClock.seconds(deadline)
  }
  return SystemClock.nanoseconds(now) >= SystemClock.nanoseconds(deadline)
}

impl NativeUdpSocket {
  /// Makes an unbound UDP socket for `family`. It is nonblocking, and child processes do not get it.
  ///
  /// # Errors
  /// - `FamilyUnsupported` if the system has no support for `family`.
  /// - Another `DatagramError` if the system cannot make the socket.
  pub effect fn open(family: Family) -> NativeUdpSocket
    ! DatagramError {
    static if !((Intrinsic.targetOperatingSystem() == "windows"
      && Intrinsic.targetArchitecture() == "x86_64"
      && Intrinsic.targetAbi() == "msvc")
      || (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetAbi() == "apple")
      || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu")) {
      compileError("NativeUdpSocket requires Linux with GNU libc, macOS, or Windows on x86_64")
    }
    let held = run session()
    let mut native: i32 = 2
    if family == Family.V6 {
      native = ipv6Family()
    }
    let fd = unsafe openRaw(native)
    if fd == invalidSocket() {
      fail classify(DatagramOperation.Socket, unsafe lastError())
    }
    let socket = NativeUdpSocket {
      fd: fd,
      familyValue: family,
      session: Option<SocketSession>.some(move held),
    }
    let code = unsafe configure(fd)
    if code != 0 {
      fail classify(DatagramOperation.Configure, code)
    }
    if family == Family.V6 {
      let on: [u8; 4] = [1, 0, 0, 0]
      if unsafe setsockopt(fd, 41, ipv6OnlyOption(), Pointer.fromSlice<u8>(&on), 4) != 0 {
        fail classify(DatagramOperation.Configure, unsafe lastError())
      }
    }
    return move socket
  }

  /// Takes an open UDP socket of `family`, such as one that another process sent, and makes it
  /// nonblocking and kept from child processes. The returned socket owns `fd` and closes it when
  /// it is dropped.
  ///
  /// # When to use
  /// Use it for a socket descriptor that this program did not make, as Node's `dgram` does for a
  /// socket shared by a cluster primary. Use [`NativeUdpSocket.open`] for a new socket.
  ///
  /// # Safety
  /// `fd` must be an open UDP socket of `family` that nothing else closes.
  ///
  /// # Errors
  /// - A `DatagramError` with operation `Configure` if the system cannot set the socket flags. The
  ///   socket is closed then.
  pub unsafe effect fn adopt(fd: RawSocket, family: Family) -> NativeUdpSocket
    ! DatagramError {
    static if !((Intrinsic.targetOperatingSystem() == "windows"
      && Intrinsic.targetArchitecture() == "x86_64"
      && Intrinsic.targetAbi() == "msvc")
      || (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetAbi() == "apple")
      || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu")) {
      compileError("NativeUdpSocket requires Linux with GNU libc, macOS, or Windows on x86_64")
    }
    let held = run session()
    let socket = NativeUdpSocket {
      fd: fd,
      familyValue: family,
      session: Option<SocketSession>.some(move held),
    }
    let code = unsafe configure(fd)
    if code != 0 {
      fail classify(DatagramOperation.Configure, code)
    }
    return move socket
  }

  /// Returns the family of the socket.
  pub fn family(self: &Self) -> Family {
    return self.familyValue
  }

  /// Returns the raw handle of the socket, for example to register it with an event loop. The socket
  /// still owns it: do not close it.
  pub fn rawDescriptor(self: &Self) -> RawSocket {
    return self.fd
  }

  /// Binds the socket to the local address `endpoint`. Port 0 lets the system choose a free port.
  ///
  /// # Errors
  /// - `AddressInUse`, `PermissionDenied`, or another `DatagramError` from the system.
  /// - `FamilyUnsupported` if `endpoint` is not of the family of the socket.
  pub effect fn bind(self: &mut Self, endpoint: Endpoint) -> ()
    ! DatagramError {
    run checkFamily(&self.*, &endpoint)
    let address = encodeAddress(&endpoint)
    if unsafe bindSocket(self.fd, Pointer.fromSlice<u8>(&address.bytes), address.length) != 0 {
      fail classify(DatagramOperation.Bind, unsafe lastError())
    }
  }

  /// Connects the socket to `endpoint`: [`NativeUdpSocket.send`] then goes there, and the system
  /// drops datagrams from other addresses.
  ///
  /// # Errors
  /// - `NetworkUnreachable`, or another `DatagramError` from the system.
  /// - `FamilyUnsupported` if `endpoint` is not of the family of the socket.
  pub effect fn connect(self: &mut Self, endpoint: Endpoint) -> ()
    ! DatagramError {
    run checkFamily(&self.*, &endpoint)
    let address = encodeAddress(&endpoint)
    if unsafe connectSocket(self.fd, Pointer.fromSlice<u8>(&address.bytes), address.length) != 0 {
      fail classify(DatagramOperation.Connect, unsafe lastError())
    }
  }

  /// Returns the local address of the socket, such as the port that the system chose.
  ///
  /// # Errors
  /// - A `DatagramError` from the system.
  pub effect fn localEndpoint(self: &Self) -> Endpoint
    ! DatagramError {
    let mut bytes: [u8; 128] = [0; 128]
    let mut length: u32 = 128
    if unsafe socketName(
      self.fd,
      Pointer.fromMutSlice<u8>(&mut bytes),
      Pointer.fromMutRef<u32>(&mut length),
    )
      != 0 {
      fail classify(DatagramOperation.LocalAddress, unsafe lastError())
    }
    return match decodeAddress(&bytes, u32.toUsize(length)) {
      Result<Endpoint, DatagramError>.Success { value } => value
      Result<Endpoint, DatagramError>.Failure { error } => {
        fail move error
      }
    }
  }

  /// Returns the address of the peer that [`NativeUdpSocket.connect`] set.
  ///
  /// # Errors
  /// - A `DatagramError` from the system, such as `NativeFailure` with operation `PeerAddress` and
  ///   `ENOTCONN` when the socket is not connected.
  pub effect fn peerEndpoint(self: &Self) -> Endpoint
    ! DatagramError {
    let mut bytes: [u8; 128] = [0; 128]
    let mut length: u32 = 128
    if unsafe peerName(self.fd, Pointer.fromMutSlice<u8>(&mut bytes), Pointer.fromMutRef<u32>(&mut length)) != 0 {
      fail classify(DatagramOperation.PeerAddress, unsafe lastError())
    }
    return match decodeAddress(&bytes, u32.toUsize(length)) {
      Result<Endpoint, DatagramError>.Success { value } => value
      Result<Endpoint, DatagramError>.Failure { error } => {
        fail move error
      }
    }
  }

  /// Removes the peer that [`NativeUdpSocket.connect`] set, so that the socket can send to and
  /// receive from any address again. The socket stays bound to its local address.
  ///
  /// # Errors
  /// - A `DatagramError` from the system.
  pub effect fn disconnect(self: &mut Self) -> ()
    ! DatagramError {
    // An address of family AF_UNSPEC removes the peer. Windows takes the any address of the
    // family of the socket instead.
    let mut bytes: [u8; 28] = [0; 28]
    let mut length: u32 = 16
    static if Intrinsic.targetOperatingSystem() == "windows" {
      if self.familyValue == Family.V6 {
        length = 28
        bytes[0] = i32.toU8(ipv6Family())
      } else {
        bytes[0] = 2
      }
    } else {
      static if Intrinsic.targetOperatingSystem() == "darwin" {
        bytes[0] = 16
      }
    }
    if unsafe connectSocket(self.fd, Pointer.fromSlice<u8>(&bytes), length) != 0 {
      let code = unsafe lastError()
      // macOS reports EAFNOSUPPORT, but it removes the peer.
      static if Intrinsic.targetOperatingSystem() == "darwin" {
        if code == familyCode() {
          return ()
        }
      }
      fail classify(DatagramOperation.Disconnect, code)
    }
  }

  /// Sets whether an IPv6 socket takes only IPv6 traffic (`IPV6_V6ONLY`). [`NativeUdpSocket.open`]
  /// turns it on. Turn it off before [`NativeUdpSocket.bind`] to take IPv4 traffic too, as
  /// IPv4-mapped IPv6 addresses.
  ///
  /// # Errors
  /// - `FamilyUnsupported` for an IPv4 socket.
  /// - A `DatagramError` from the system.
  pub effect fn setIpv6Only(self: &mut Self, enabled: bool) -> ()
    ! DatagramError {
    if self.familyValue != Family.V6 {
      fail DatagramError.FamilyUnsupported
    }
    run setInteger(self.fd, IPV6_LEVEL, ipv6OnlyOption(), flag(enabled))
  }

  /// Sets whether other sockets can bind the same address and port, as several receivers of one
  /// multicast group do. Call it before [`NativeUdpSocket.bind`].
  ///
  /// # Details
  /// It sets `SO_REUSEADDR`. On macOS it also sets `SO_REUSEPORT`, which macOS needs to share a
  /// port.
  ///
  /// # Errors
  /// - A `DatagramError` from the system.
  pub effect fn setReuseAddress(self: &mut Self, enabled: bool) -> ()
    ! DatagramError {
    run setInteger(self.fd, socketLevel(), reuseAddressOption(), flag(enabled))
    static if Intrinsic.targetOperatingSystem() == "darwin" {
      // SO_REUSEPORT.
      run setInteger(self.fd, socketLevel(), 512, flag(enabled))
    }
  }

  /// Sets whether the socket can send to broadcast addresses (`SO_BROADCAST`).
  ///
  /// # Errors
  /// - A `DatagramError` from the system.
  pub effect fn setBroadcast(self: &mut Self, enabled: bool) -> ()
    ! DatagramError {
    run setInteger(self.fd, socketLevel(), broadcastOption(), flag(enabled))
  }

  /// Sets the hop limit of unicast datagrams: `IP_TTL` for an IPv4 socket and
  /// `IPV6_UNICAST_HOPS` for an IPv6 socket.
  ///
  /// # Errors
  /// - A `DatagramError` from the system, such as `NativeFailure` with `EINVAL` for 0 on some
  ///   systems.
  pub effect fn setTtl(self: &mut Self, hops: u8) -> ()
    ! DatagramError {
    if self.familyValue == Family.V6 {
      run setInteger(self.fd, IPV6_LEVEL, ipv6Option(TTL_OPTION), u8.toI32(hops))
    } else {
      run setInteger(self.fd, IP_LEVEL, ipv4Option(TTL_OPTION), u8.toI32(hops))
    }
  }

  /// Sets the hop limit of multicast datagrams: `IP_MULTICAST_TTL` for an IPv4 socket and
  /// `IPV6_MULTICAST_HOPS` for an IPv6 socket. 0 keeps them on this host.
  ///
  /// # Errors
  /// - A `DatagramError` from the system.
  pub effect fn setMulticastTtl(self: &mut Self, hops: u8) -> ()
    ! DatagramError {
    if self.familyValue == Family.V6 {
      run setInteger(self.fd, IPV6_LEVEL, ipv6Option(MULTICAST_TTL_OPTION), u8.toI32(hops))
    } else {
      run setIpv4Byte(self.fd, ipv4Option(MULTICAST_TTL_OPTION), hops)
    }
  }

  /// Sets whether this host gets the multicast datagrams that the socket sends:
  /// `IP_MULTICAST_LOOP` or `IPV6_MULTICAST_LOOP`.
  ///
  /// # Errors
  /// - A `DatagramError` from the system.
  pub effect fn setMulticastLoopback(self: &mut Self, enabled: bool) -> ()
    ! DatagramError {
    if self.familyValue == Family.V6 {
      run setInteger(self.fd, IPV6_LEVEL, ipv6Option(MULTICAST_LOOP_OPTION), flag(enabled))
    } else {
      let mut value: u8 = 0
      if enabled {
        value = 1
      }
      run setIpv4Byte(self.fd, ipv4Option(MULTICAST_LOOP_OPTION), value)
    }
  }

  /// Sets the interface that sends the multicast datagrams of the socket: `IP_MULTICAST_IF` or
  /// `IPV6_MULTICAST_IF`. `Default` lets the system choose again.
  ///
  /// # Errors
  /// - `FamilyUnsupported` if `via` is `V4` for an IPv6 socket, or `V6` for an IPv4 socket.
  /// - A `DatagramError` from the system, such as `NativeFailure` with `EADDRNOTAVAIL` when no
  ///   interface has the address.
  pub effect fn setMulticastInterface(self: &mut Self, via: MulticastInterface) -> ()
    ! DatagramError {
    if self.familyValue == Family.V6 {
      let index = run interfaceIndex(via)
      return run setInteger(self.fd, IPV6_LEVEL, ipv6Option(MULTICAST_INTERFACE_OPTION), u32.toI32(index))
    }
    let address = run interfaceAddress(via)
    run setBytes(self.fd, IP_LEVEL, ipv4Option(MULTICAST_INTERFACE_OPTION), &address)
  }

  /// Joins the multicast group `group` on `via`, so that the socket gets its datagrams.
  ///
  /// # Details
  /// The family of `group` chooses the option: `IP_ADD_MEMBERSHIP` for IPv4 and `IPV6_JOIN_GROUP`
  /// for IPv6. Bind the socket to the port of the group first.
  ///
  /// # Errors
  /// - `FamilyUnsupported` if `via` is of the other family than `group`.
  /// - A `DatagramError` from the system, such as `NativeFailure` with `EINVAL` when `group` is not
  ///   a multicast address, or `EADDRINUSE` when the socket is already a member.
  pub effect fn joinGroup(self: &mut Self, group: IpAddress, via: MulticastInterface) -> ()
    ! DatagramError {
    run membership(self.fd, group, via, JOIN_OPTION)
  }

  /// Leaves the multicast group `group` on `via`, which [`NativeUdpSocket.joinGroup`] joined.
  ///
  /// # Errors
  /// - `FamilyUnsupported` if `via` is of the other family than `group`.
  /// - A `DatagramError` from the system, such as `NativeFailure` with `EADDRNOTAVAIL` when the
  ///   socket is not a member.
  pub effect fn leaveGroup(self: &mut Self, group: IpAddress, via: MulticastInterface) -> ()
    ! DatagramError {
    run membership(self.fd, group, via, LEAVE_OPTION)
  }

  /// Joins the multicast group `group` on `via` for datagrams from `source` only
  /// (source-specific multicast).
  ///
  /// # Details
  /// IPv4 uses `IP_ADD_SOURCE_MEMBERSHIP`. IPv6 uses `MCAST_JOIN_SOURCE_GROUP`.
  ///
  /// # Errors
  /// - `FamilyUnsupported` if `group`, `source`, and `via` are not all of one family.
  /// - A `DatagramError` from the system.
  pub effect fn joinSourceGroup(
    self: &mut Self,
    group: IpAddress,
    source: IpAddress,
    via: MulticastInterface,
  ) -> ()
    ! DatagramError {
    run sourceMembership(self.fd, group, source, via, JOIN_SOURCE_OPTION)
  }

  /// Leaves the source-specific group that [`NativeUdpSocket.joinSourceGroup`] joined.
  ///
  /// # Errors
  /// - `FamilyUnsupported` if `group`, `source`, and `via` are not all of one family.
  /// - A `DatagramError` from the system.
  pub effect fn leaveSourceGroup(
    self: &mut Self,
    group: IpAddress,
    source: IpAddress,
    via: MulticastInterface,
  ) -> ()
    ! DatagramError {
    run sourceMembership(self.fd, group, source, via, LEAVE_SOURCE_OPTION)
  }

  /// Returns the size of the receive buffer of the socket in bytes (`SO_RCVBUF`).
  ///
  /// # Details
  /// Linux reports twice the size that [`NativeUdpSocket.setReceiveBufferSize`] set, because it
  /// counts its bookkeeping.
  ///
  /// # Errors
  /// - A `DatagramError` from the system.
  pub effect fn receiveBufferSize(self: &Self) -> usize
    ! DatagramError {
    return run getSize(self.fd, receiveBufferOption())
  }

  /// Asks the system for a receive buffer of `size` bytes (`SO_RCVBUF`). The system can round or
  /// cap it.
  ///
  /// # Errors
  /// - `NativeFailure` with operation `Option` and `EINVAL` if `size` does not fit in an `int`.
  /// - Another `DatagramError` from the system.
  pub effect fn setReceiveBufferSize(self: &mut Self, size: usize) -> ()
    ! DatagramError {
    run setSize(self.fd, receiveBufferOption(), size)
  }

  /// Returns the size of the send buffer of the socket in bytes (`SO_SNDBUF`).
  ///
  /// # Details
  /// Linux reports twice the size that [`NativeUdpSocket.setSendBufferSize`] set, because it
  /// counts its bookkeeping.
  ///
  /// # Errors
  /// - A `DatagramError` from the system.
  pub effect fn sendBufferSize(self: &Self) -> usize
    ! DatagramError {
    return run getSize(self.fd, sendBufferOption())
  }

  /// Asks the system for a send buffer of `size` bytes (`SO_SNDBUF`). The system can round or cap
  /// it.
  ///
  /// # Errors
  /// - `NativeFailure` with operation `Option` and `EINVAL` if `size` does not fit in an `int`.
  /// - Another `DatagramError` from the system.
  pub effect fn setSendBufferSize(self: &mut Self, size: usize) -> ()
    ! DatagramError {
    run setSize(self.fd, sendBufferOption(), size)
  }

  /// Sends `datagram` to the connected peer.
  ///
  /// # Errors
  /// - `ConnectionRefused` if the peer reported a closed port for an earlier datagram.
  /// - `MessageTooLarge`, or another `DatagramError` from the system.
  pub effect fn send(self: &mut Self, datagram: &[u8]) -> Sent
    ! DatagramError {
    let none: [u8; 0] = []
    return run sendRaw(&mut self.*, datagram, &none, 0)
  }

  /// Sends `datagram` to `endpoint`.
  ///
  /// # Errors
  /// - `FamilyUnsupported` if `endpoint` is not of the family of the socket.
  /// - `MessageTooLarge`, `NetworkUnreachable`, or another `DatagramError` from the system.
  pub effect fn sendTo(self: &mut Self, datagram: &[u8], endpoint: Endpoint) -> Sent
    ! DatagramError {
    run checkFamily(&self.*, &endpoint)
    let address = encodeAddress(&endpoint)
    return run sendRaw(&mut self.*, datagram, &address.bytes, address.length)
  }

  /// Receives one datagram into `buffer`, if one is waiting.
  ///
  /// # Details
  /// A datagram longer than `buffer` is cut to its length on Linux and macOS. Use a buffer of 65535
  /// bytes to get every datagram whole.
  ///
  /// # Errors
  /// - `ConnectionRefused` if the socket is connected and the peer reported a closed port.
  /// - `MessageTooLarge` on Windows, for a datagram longer than `buffer`.
  /// - Another `DatagramError` from the system.
  pub effect fn receive(self: &mut Self, buffer: &mut [u8]) -> Received
    ! DatagramError {
    let mut address: [u8; 128] = [0; 128]
    let size = buffer.length
    let data = Pointer.fromMutSlice<u8>(move buffer)
    while true {
      static if Intrinsic.targetOperatingSystem() == "windows" {
        let mut length: i32 = 128
        let mut capacity = size
        if capacity > 2147483647 {
          capacity = 2147483647
        }
        let count = unsafe windowsReceiveFrom(
          self.fd,
          data,
          usize.toI32(capacity),
          0,
          Pointer.fromMutSlice<u8>(&mut address),
          Pointer.fromMutRef<i32>(&mut length),
        )
        if count >= 0 {
          return run received(i32.toUsize(count), &address, i32.toUsize(length))
        }
      } else {
        let mut length: u32 = 128
        let count = unsafe unixReceiveFrom(
          self.fd,
          data,
          size,
          0,
          Pointer.fromMutSlice<u8>(&mut address),
          Pointer.fromMutRef<u32>(&mut length),
        )
        if count >= 0 {
          return run received(isize.toUsize(count), &address, u32.toUsize(length))
        }
      }
      let code = unsafe lastError()
      if code == wouldBlockCode() {
        return Received.WouldBlock
      }
      if code != interruptedCode() {
        fail classify(DatagramOperation.Receive, code)
      }
    }
    return Received.WouldBlock
  }

  /// Waits until a datagram or an error is waiting on the socket, or until `deadline` on the
  /// `MonotonicClock`. Returns `false` if the deadline passed first.
  ///
  /// # When to use
  /// Use it in a program without an event loop. It blocks the thread.
  ///
  /// # Errors
  /// - A `DatagramError` from the system.
  pub effect fn waitReadable(self: &Self, deadline: Instant) -> bool
    ! DatagramError
    ? &mut MonotonicClock {
    while true {
      let now = run MonotonicClock.now()
      if reached(&now, &deadline) {
        return false
      }
      let timeout = pollMilliseconds(&now, &deadline)
      let ready = unsafe pollReadable(self.fd, timeout)
      if ready > 0 {
        return true
      }
      if ready < 0 {
        let code = unsafe lastError()
        if code != interruptedCode() {
          fail classify(DatagramOperation.Wait, code)
        }
      }
    }
    return false
  }
}

/// Waits until a datagram or an error is waiting on any of `sockets`, or until `deadline` on the
/// `MonotonicClock`. Returns `false` if the deadline passed first.
///
/// # When to use
/// Use it in a program without an event loop, then call [`NativeUdpSocket.receive`] on each socket:
/// a socket that has nothing returns `Received.WouldBlock`. It blocks the thread.
///
/// # Errors
/// - A `DatagramError` from the system.
/// - `OutOfMemoryError` if the `Allocator` cannot supply the list of sockets for the system.
pub effect fn waitAny(sockets: &[NativeUdpSocket], deadline: Instant) -> bool
  ! DatagramError | OutOfMemoryError
  ? &mut MonotonicClock | &mut Allocator {
  let mut entries = run List<PollFd>.makeWithCapacity(sockets.length)
  let mut index: usize = 0
  while index < sockets.length {
    run List<PollFd>.append(
      &mut entries,
      PollFd { fd: sockets[index].fd, events: readableEvent(), revents: 0 },
    )
    index = index + 1
  }
  while true {
    let now = run MonotonicClock.now()
    if reached(&now, &deadline) {
      return false
    }
    let timeout = pollMilliseconds(&now, &deadline)
    let slice = List<PollFd>.asMutSlice(&mut entries)
    let count = slice.length
    let ready = unsafe pollMany(Pointer.fromMutSlice<PollFd>(move slice), count, timeout)
    if ready > 0 {
      return true
    }
    if ready < 0 {
      let code = unsafe lastError()
      if code != interruptedCode() {
        fail classify(DatagramOperation.Wait, code)
      }
    }
  }
  return false
}

fn readableEvent() -> i16 {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    return 256
  } else {
    return 1
  }
}

unsafe fn pollMany(entries: ?[*]mut PollFd, count: usize, timeout: i32) -> i32 {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    return unsafe WSAPoll(entries, usize.toU32(count), timeout)
  } else {
    static if Intrinsic.targetOperatingSystem() == "darwin" {
      return unsafe unixPoll(entries, usize.toU32(count), timeout)
    } else {
      return unsafe unixPoll(entries, count, timeout)
    }
  }
}

unsafe fn pollReadable(fd: RawSocket, timeout: i32) -> i32 {
  let mut entries = [PollFd { fd: fd, events: readableEvent(), revents: 0 }]
  return unsafe pollMany(Pointer.fromMutSlice<PollFd>(&mut entries), 1, timeout)
}

fn flag(enabled: bool) -> i32 {
  if enabled {
    return 1
  }
  return 0
}

fn invalidArgumentCode() -> i32 {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    return 10022
  } else {
    return 22
  }
}

effect fn setBytes(fd: RawSocket, level: i32, option: i32, value: &[u8]) -> ()
  ! DatagramError {
  if unsafe setsockopt(fd, level, option, Pointer.fromSlice<u8>(value), usize.toU32(value.length)) != 0 {
    fail classify(DatagramOperation.Option, unsafe lastError())
  }
}

effect fn setRecord<T>(fd: RawSocket, level: i32, option: i32, value: &T, length: u32) -> ()
  ! DatagramError {
  if unsafe setsockopt(fd, level, option, unsafe Pointer.bytes<T>(Pointer.fromRef<T>(value)), length) != 0 {
    fail classify(DatagramOperation.Option, unsafe lastError())
  }
}

effect fn setInteger(fd: RawSocket, level: i32, option: i32, value: i32) -> ()
  ! DatagramError {
  run setRecord<i32>(fd, level, option, &value, 4)
}

// IPv4 multicast TTL and loop take one byte on macOS, and an int on Windows. Linux takes both.
effect fn setIpv4Byte(fd: RawSocket, option: i32, value: u8) -> ()
  ! DatagramError {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    let bytes = [value]
    run setBytes(fd, IP_LEVEL, option, &bytes)
  } else {
    run setInteger(fd, IP_LEVEL, option, u8.toI32(value))
  }
}

effect fn getSize(fd: RawSocket, option: i32) -> usize
  ! DatagramError {
  let mut value: i32 = 0
  let mut length: u32 = 4
  if unsafe getsockopt(fd, socketLevel(), option, Pointer.fromMutRef<i32>(&mut value), Pointer.fromMutRef<u32>(&mut length)) != 0 {
    fail classify(DatagramOperation.Option, unsafe lastError())
  }
  return i32.toUsize(value)
}

effect fn setSize(fd: RawSocket, option: i32, size: usize) -> ()
  ! DatagramError {
  if size > 2147483647 {
    fail DatagramError.NativeFailure { operation: DatagramOperation.Option, code: invalidArgumentCode() }
  }
  run setInteger(fd, socketLevel(), option, usize.toI32(size))
}

// The interface address of an IPv4 multicast option: 0.0.0.0 for `Default`.
effect fn interfaceAddress(via: MulticastInterface) -> [u8; 4]
  ! DatagramError {
  return match via {
    MulticastInterface.Default => [0, 0, 0, 0]
    MulticastInterface.V4 { address } => Ipv4Address.octets(&address)
    MulticastInterface.V6 { .. } => {
      fail DatagramError.FamilyUnsupported
    }
  }
}

// The interface index of an IPv6 multicast option: 0 for `Default`.
effect fn interfaceIndex(via: MulticastInterface) -> u32
  ! DatagramError {
  return match via {
    MulticastInterface.Default => 0
    MulticastInterface.V6 { index } => index
    MulticastInterface.V4 { .. } => {
      fail DatagramError.FamilyUnsupported
    }
  }
}

effect fn membership(fd: RawSocket, group: IpAddress, via: MulticastInterface, option: usize) -> ()
  ! DatagramError {
  match group {
    IpAddress.V4 { value } => {
      // struct ip_mreq: the group, then the interface address.
      let local = run interfaceAddress(via)
      let octets = Ipv4Address.octets(&value)
      let request = [octets[0], octets[1], octets[2], octets[3], local[0], local[1], local[2], local[3]]
      run setBytes(fd, IP_LEVEL, ipv4Option(option), &request)
    }
    IpAddress.V6 { value } => {
      let request = Ipv6GroupRequest { group: Ipv6Address.octets(&value), index: run interfaceIndex(via) }
      run setRecord<Ipv6GroupRequest>(fd, IPV6_LEVEL, ipv6Option(option), &request, 20)
    }
  }
}

effect fn sourceMembership(
  fd: RawSocket,
  group: IpAddress,
  source: IpAddress,
  via: MulticastInterface,
  option: usize,
) -> ()
  ! DatagramError {
  match group {
    IpAddress.V4 { value } => {
      let sender = match source {
        IpAddress.V4 { value: address } => Ipv4Address.octets(&address)
        IpAddress.V6 { .. } => {
          fail DatagramError.FamilyUnsupported
        }
      }
      let local = run interfaceAddress(via)
      let octets = Ipv4Address.octets(&value)
      // struct ip_mreq_source: Linux puts the interface before the source, macOS and Windows
      // after it.
      static if Intrinsic.targetOperatingSystem() == "linux" {
        let request = [
          octets[0], octets[1], octets[2], octets[3],
          local[0], local[1], local[2], local[3],
          sender[0], sender[1], sender[2], sender[3],
        ]
        run setBytes(fd, IP_LEVEL, ipv4Option(option), &request)
      } else {
        let request = [
          octets[0], octets[1], octets[2], octets[3],
          sender[0], sender[1], sender[2], sender[3],
          local[0], local[1], local[2], local[3],
        ]
        run setBytes(fd, IP_LEVEL, ipv4Option(option), &request)
      }
    }
    IpAddress.V6 { .. } => {
      if IpAddress.isV4(&source) {
        fail DatagramError.FamilyUnsupported
      }
      let groupAddress = encodeAddress(&Endpoint.make(group, Port.fromU16(0)))
      let sourceAddress = encodeAddress(&Endpoint.make(source, Port.fromU16(0)))
      let mut groupStorage: [u8; 128] = [0; 128]
      let mut sourceStorage: [u8; 128] = [0; 128]
      let mut at: usize = 0
      while at < 28 {
        groupStorage[at] = groupAddress.bytes[at]
        sourceStorage[at] = sourceAddress.bytes[at]
        at = at + 1
      }
      let index = run interfaceIndex(via)
      static if Intrinsic.targetOperatingSystem() == "darwin" {
        let request = SourceGroupRequest { index: index, group: groupStorage, source: sourceStorage }
        run setRecord<SourceGroupRequest>(fd, IPV6_LEVEL, ipv6Option(option), &request, 260)
      } else {
        let request = SourceGroupRequest { index: index, padding: 0, group: groupStorage, source: sourceStorage }
        run setRecord<SourceGroupRequest>(fd, IPV6_LEVEL, ipv6Option(option), &request, 264)
      }
    }
  }
}

effect fn checkFamily(socket: &NativeUdpSocket, endpoint: &Endpoint) -> ()
  ! DatagramError {
  let isV4 = IpAddress.isV4(&Endpoint.address(endpoint))
  if isV4 != (socket.familyValue == Family.V4) {
    fail DatagramError.FamilyUnsupported
  }
}

effect fn received(count: usize, address: &[u8; 128], length: usize) -> Received
  ! DatagramError {
  return match decodeAddress(address, length) {
    Result<Endpoint, DatagramError>.Success { value } => Received.Datagram {
      count: count,
      from: value,
    }
    Result<Endpoint, DatagramError>.Failure { error } => {
      fail move error
    }
  }
}

effect fn sendRaw(
  socket: &mut NativeUdpSocket,
  datagram: &[u8],
  address: &[u8],
  addressLength: u32,
) -> Sent
  ! DatagramError {
  let mut target = Pointer.fromSlice<u8>(address)
  if addressLength == 0 {
    target = unsafe Intrinsic.pointerRequalify<?*mut u8, ?[*]const u8>(Pointer.null<u8>())
  }
  while true {
    static if Intrinsic.targetOperatingSystem() == "windows" {
      if datagram.length > 2147483647 {
        fail DatagramError.MessageTooLarge
      }
      let count = unsafe windowsSendTo(
        socket.fd,
        Pointer.fromSlice<u8>(datagram),
        usize.toI32(datagram.length),
        0,
        target,
        u32.toI32(addressLength),
      )
      if count >= 0 {
        return Sent.Count { count: i32.toUsize(count) }
      }
    } else {
      let count = unsafe unixSendTo(
        socket.fd,
        Pointer.fromSlice<u8>(datagram),
        datagram.length,
        0,
        target,
        addressLength,
      )
      if count >= 0 {
        return Sent.Count { count: isize.toUsize(count) }
      }
    }
    let code = unsafe lastError()
    if code == wouldBlockCode() {
      return Sent.WouldBlock
    }
    if code != interruptedCode() {
      fail classify(DatagramOperation.Send, code)
    }
  }
  return Sent.WouldBlock
}
