//! TCP connections and listeners through WASI Preview 2 network capabilities.
//!
//! # When to use
//! Use `Network.make` to acquire the host-granted network, then connect or listen. Connections
//! provide `ByteDuplex` for portable HTTP, TLS, and other stream protocols.
//!
//! # Details
//! The host decides which addresses may be used. Socket operations retain WASI network error
//! codes. Polling honors deadlines on the supplied monotonic clock. Closing a connection drops
//! its streams before its parent socket; drop also closes every remaining resource.
//!
//! @category Networking

static if Intrinsic.profileText("target") == "wasm32-wasip2" {
  import silk.platform.wasi.preview2 as host
  import silk.platform.wasi.component as abi { ResultArea, Pollable }
  import silk.platform.wasi.stream { InputStream, OutputStream, StreamError }
  import silk.io.byte_duplex { ByteDuplex, ByteIoError, ByteIoOperation, ReadTransfer }
  import silk.core.effect { Effect }
  import silk.system.monotonic_clock { MonotonicClock }
  import silk.system.system_clock { Instant }
  import silk.net.address { Endpoint, IpAddress, Ipv4Address, Ipv6Address, Port }
  import silk.option { Option }
  import silk.core.ownership { Drop }
  import silk.core.result { Result }
  import silk.num.u8
  import silk.num.u16
  import silk.num.u32
  import silk.num.usize

  /// A WASI network error. `code` is the ordinal of `wasi:sockets/network.error-code`.
  /// In particular 1 is access denied, 5 timeout, 8 would block, and 14 connection refused.
  pub struct SocketError { pub code: u32 }

  /// An IP socket address, including IPv6 flow information and interface scope.
  pub struct SocketAddress {
    /// The IP address and port.
    pub endpoint: Endpoint,
    /// IPv6 flow information. Ignored for IPv4.
    pub flowInfo: u32,
    /// IPv6 interface scope. Ignored for IPv4.
    pub scopeId: u32,
  }

  impl SocketAddress {
    /// Makes an address with zero IPv6 flow information and scope.
    pub fn make(endpoint: Endpoint) -> SocketAddress {
      return SocketAddress {endpoint: endpoint, flowInfo: 0, scopeId: 0}
    }

    /// Returns the twelve flattened canonical lanes of an `ip-socket-address`.
    pub fn lanes(self: &Self) -> [u32; 12] {
      let mut result: [u32; 12] = [0; 12]
      result[1] = u16.toU32(Port.value(&Endpoint.port(&self.endpoint)))
      match Endpoint.address(&self.endpoint) {
        IpAddress.V4 {value} => {
          let bytes = Ipv4Address.octets(&value)
          let mut at: usize = 0
          while at < 4 { result[at + 2] = u8.toU32(bytes[at]) at = at + 1 }
        }
        IpAddress.V6 {value} => {
          result[0] = 1
          result[2] = self.flowInfo
          let bytes = Ipv6Address.octets(&value)
          let mut at: usize = 0
          while at < 8 {
            result[at + 3] = u8.toU32(bytes[at * 2]) * 256 + u8.toU32(bytes[at * 2 + 1])
            at = at + 1
          }
          result[11] = self.scopeId
        }
      }
      return result
    }
  }

  /// Decodes an initialized canonical `ip-socket-address` at `offset` in a result area.
  /// The record and its tag must be a valid host result.
  pub unsafe fn decodeAddress(result: &ResultArea, offset: usize) -> SocketAddress {
    let port = Port.fromU16(ResultArea.word16(result, offset + 4))
    if ResultArea.byte(result, offset) == 0 {
      let bytes = [ResultArea.byte(result, offset + 6), ResultArea.byte(result, offset + 7),
        ResultArea.byte(result, offset + 8), ResultArea.byte(result, offset + 9)]
      return SocketAddress.make(Endpoint.make(IpAddress.V4 {value: Ipv4Address.fromOctets(bytes)}, port))
    }
    let mut bytes: [u8; 16] = [0; 16]
    let mut at: usize = 0
    while at < 8 {
      let part = ResultArea.word16(result, offset + 12 + at * 2)
      bytes[at * 2] = u16.toU8(part / 256)
      bytes[at * 2 + 1] = u16.toU8(part % 256)
      at = at + 1
    }
    return SocketAddress {endpoint: Endpoint.make(IpAddress.V6 {value: Ipv6Address.fromOctets(bytes)}, port),
      flowInfo: ResultArea.word32(result, offset + 8), scopeId: ResultArea.word32(result, offset + 28)}
  }

  /// An owned default-network capability. The runtime controls the addresses it grants.
  pub struct Network { handleValue: u32 }

  impl Network {
    /// Acquires the host's default network capability. This does not grant additional access.
    pub fn make() -> Network {
      return Network {handleValue: unsafe host.sockets_instance_network_instance_network()}
    }

    /// Borrows the network handle for unsafe WASI operations. Ownership stays with this value.
    pub fn handle(self: &Self) -> u32 { return self.handleValue }

    /// Opens a TCP connection to `address`, or fails with the host error or timeout code 5.
    pub effect fn connect(self: &Self, address: &SocketAddress, deadline: Option<Instant>) -> Connection
      ! SocketError ? &mut MonotonicClock {
      if run abi.expired(&deadline) { fail SocketError {code: 5} }
      let lanes = SocketAddress.lanes(address)
      let socket = run Socket.create(lanes[0])
      let handle = Socket.handle(&socket)
      let mut result = ResultArea.make()
      unsafe host.sockets_tcp_tcp_socket_start_connect(handle, self.handleValue,
        lanes[0], lanes[1], lanes[2], lanes[3], lanes[4], lanes[5], lanes[6], lanes[7], lanes[8], lanes[9], lanes[10], lanes[11],
        abi.address(&mut result))
      run unit(&result)
      while true {
        unsafe host.sockets_tcp_tcp_socket_finish_connect(handle, abi.address(&mut result))
        if ResultArea.byte(&result, 0) == 0 {
          return Connection {socket: move socket,
            input: Option<InputStream>.some(unsafe InputStream.take(ResultArea.word32(&result, 4))),
            output: Option<OutputStream>.some(unsafe OutputStream.take(ResultArea.word32(&result, 8)))}
        }
        let code = u8.toU32(ResultArea.byte(&result, 4))
        if code != 8 { fail SocketError {code: code} }
        run Socket.wait(&socket, &deadline)
      }
    }

    /// Binds and starts a TCP listener, using the host's default backlog.
    /// Port zero asks the host to choose a port; `Listener.address` returns it after binding.
    pub effect fn listen(self: &Self, address: &SocketAddress, deadline: Option<Instant>) -> Listener
      ! SocketError ? &mut MonotonicClock {
      if run abi.expired(&deadline) { fail SocketError {code: 5} }
      let lanes = SocketAddress.lanes(address)
      let socket = run Socket.create(lanes[0])
      let handle = Socket.handle(&socket)
      let mut result = ResultArea.make()
      unsafe host.sockets_tcp_tcp_socket_start_bind(handle, self.handleValue,
        lanes[0], lanes[1], lanes[2], lanes[3], lanes[4], lanes[5], lanes[6], lanes[7], lanes[8], lanes[9], lanes[10], lanes[11],
        abi.address(&mut result))
      run unit(&result)
      while true {
        unsafe host.sockets_tcp_tcp_socket_finish_bind(handle, abi.address(&mut result))
        if ResultArea.byte(&result, 0) == 0 { break }
        let code = u8.toU32(ResultArea.byte(&result, 1))
        if code != 8 { fail SocketError {code: code} }
        run Socket.wait(&socket, &deadline)
      }
      unsafe host.sockets_tcp_tcp_socket_start_listen(handle, abi.address(&mut result))
      run unit(&result)
      while true {
        unsafe host.sockets_tcp_tcp_socket_finish_listen(handle, abi.address(&mut result))
        if ResultArea.byte(&result, 0) == 0 { break }
        let code = u8.toU32(ResultArea.byte(&result, 1))
        if code != 8 { fail SocketError {code: code} }
        run Socket.wait(&socket, &deadline)
      }
      return Listener {socket: move socket}
    }
  }

  impl Drop for Network {
    fn drop(self: &mut Self) -> () { unsafe host.sockets_network_drop_network(self.handleValue) }
  }

  effect fn unit(result: &ResultArea) -> () ! SocketError {
    if ResultArea.byte(result, 0) != 0 { fail SocketError {code: u8.toU32(ResultArea.byte(result, 1))} }
  }

  struct Socket { handleValue: Option<u32> }

  impl Socket {
    effect fn create(family: u32) -> Socket ! SocketError {
      let mut result = ResultArea.make()
      unsafe host.sockets_tcp_create_socket_create_tcp_socket(family, abi.address(&mut result))
      if ResultArea.byte(&result, 0) != 0 { fail SocketError {code: u8.toU32(ResultArea.byte(&result, 4))} }
      return Socket {handleValue: Option<u32>.some(ResultArea.word32(&result, 4))}
    }

    fn handle(self: &Self) -> u32 {
      return match &self.handleValue {
        Option<u32>.Some {value} => value
        Option<u32>.None => Intrinsic.trap("closed WASI socket")
      }
    }

    effect fn wait(self: &Self, deadline: &Option<Instant>) -> () ! SocketError ? &mut MonotonicClock {
      let pollableHandle = unsafe host.sockets_tcp_tcp_socket_subscribe(Socket.handle(self))
      let pollable = unsafe Pollable.take(pollableHandle)
      if !run Pollable.wait(&pollable, deadline) { fail SocketError {code: 5} }
    }

    fn close(self: &mut Self) -> () {
      let handle = Intrinsic.replace(self.handleValue, Option<u32>.none())
      if let Option<u32>.Some {value} = move handle { unsafe host.sockets_tcp_drop_tcp_socket(value) }
    }

    effect fn address(self: &Self, remote: bool) -> SocketAddress ! SocketError {
      let mut result = ResultArea.make()
      if remote { unsafe host.sockets_tcp_tcp_socket_remote_address(Socket.handle(self), abi.address(&mut result)) }
      else { unsafe host.sockets_tcp_tcp_socket_local_address(Socket.handle(self), abi.address(&mut result)) }
      if ResultArea.byte(&result, 0) != 0 { fail SocketError {code: u8.toU32(ResultArea.byte(&result, 4))} }
      return unsafe decodeAddress(&result, 4)
    }
  }

  impl Drop for Socket {
    fn drop(self: &mut Self) -> () { Socket.close(&mut self.*) }
  }

  /// An owned TCP listener. Drop closes it. Accepted connections own their sockets independently.
  pub struct Listener { socket: Socket }

  impl Listener {
    /// Returns the bound local address, including the port the host chose for a port-zero bind.
    pub effect fn address(self: &Self) -> SocketAddress ! SocketError {
      return run Socket.address(&self.socket, false)
    }

    /// Accepts a connection, polling until one arrives or the deadline expires.
    pub effect fn accept(self: &mut Self, deadline: Option<Instant>) -> Connection
      ! SocketError ? &mut MonotonicClock {
      while true {
        if run abi.expired(&deadline) { fail SocketError {code: 5} }
        let mut result = ResultArea.make()
        unsafe host.sockets_tcp_tcp_socket_accept(Socket.handle(&self.socket), abi.address(&mut result))
        if ResultArea.byte(&result, 0) == 0 {
          return Connection {socket: Socket {handleValue: Option<u32>.some(ResultArea.word32(&result, 4))},
            input: Option<InputStream>.some(unsafe InputStream.take(ResultArea.word32(&result, 8))),
            output: Option<OutputStream>.some(unsafe OutputStream.take(ResultArea.word32(&result, 12)))}
        }
        let code = u8.toU32(ResultArea.byte(&result, 4))
        if code != 8 { fail SocketError {code: code} }
        run Socket.wait(&self.socket, &deadline)
      }
    }
  }

  /// An owned TCP connection providing portable `ByteDuplex` operations.
  /// Close and drop release input and output streams before releasing their parent socket.
  pub struct Connection {
    socket: Socket,
    input: Option<InputStream>,
    output: Option<OutputStream>,
  }

  fn streamFailure(error: StreamError, operation: ByteIoOperation) -> ByteIoError {
    return match error {
      StreamError.Timeout => ByteDuplex.timeout(operation)
      StreamError.Closed => ByteDuplex.closed(operation)
      StreamError.Host => ByteDuplex.provider(operation, -1)
    }
  }

  impl Connection {
    /// Closes the connection. Repeated calls do nothing.
    pub fn close(self: &mut Self) -> () {
      let input = Intrinsic.replace(self.input, Option<InputStream>.none())
      let output = Intrinsic.replace(self.output, Option<OutputStream>.none())
      drop input
      drop output
      Socket.close(&mut self.socket)
    }

    /// Returns the remote peer address. Calling it on a closed connection fails with code 9.
    pub effect fn peer(self: &Self) -> SocketAddress ! SocketError {
      if let Option<u32>.None = &self.socket.handleValue { fail SocketError {code: 9} }
      return run Socket.address(&self.socket, true)
    }

    /// Returns the local address. Calling it on a closed connection fails with code 9.
    pub effect fn address(self: &Self) -> SocketAddress ! SocketError {
      if let Option<u32>.None = &self.socket.handleValue { fail SocketError {code: 9} }
      return run Socket.address(&self.socket, false)
    }
  }

  impl Drop for Connection {
    fn drop(self: &mut Self) -> () { Connection.close(&mut self.*) }
  }

  impl ByteDuplex for Connection {
    unsafe effect fn readSomeRaw(self: &mut Self, output: &mut [u8], deadline: Option<Instant>) -> ReadTransfer
      ! ByteIoError ? &mut MonotonicClock {
      if let Option<InputStream>.Some {value} = &mut self.input {
        return match move run Effect.result(InputStream.read(&mut value, move output, move deadline)) {
          Result<ReadTransfer, StreamError>.Success {value: transfer} => move transfer
          Result<ReadTransfer, StreamError>.Failure {error} => { fail streamFailure(error, ByteIoOperation.Read) }
        }
      }
      fail ByteDuplex.closed(ByteIoOperation.Read)
    }

    unsafe effect fn writeSomeRaw(self: &mut Self, input: &[u8], deadline: Option<Instant>) -> usize
      ! ByteIoError ? &mut MonotonicClock {
      if let Option<OutputStream>.Some {value} = &mut self.output {
        return match move run Effect.result(OutputStream.write(&mut value, input, move deadline)) {
          Result<usize, StreamError>.Success {value: count} => count
          Result<usize, StreamError>.Failure {error} => { fail streamFailure(error, ByteIoOperation.Write) }
        }
      }
      fail ByteDuplex.closed(ByteIoOperation.Write)
    }

    unsafe effect fn writeSomeVectoredRaw(self: &mut Self, inputs: &[&[u8]], deadline: Option<Instant>) -> usize
      ! ByteIoError ? &mut MonotonicClock {
      unsafe { return run Connection.writeSomeRaw(&mut self.*, ByteDuplex.firstNonEmpty(inputs), move deadline) }
    }

    unsafe effect fn flushRaw(self: &mut Self, deadline: Option<Instant>) -> ()
      ! ByteIoError ? &mut MonotonicClock {
      if let Option<OutputStream>.Some {value} = &mut self.output {
        match move run Effect.result(OutputStream.flush(&mut value, move deadline)) {
          Result<(), StreamError>.Success {value: _} => { return () }
          Result<(), StreamError>.Failure {error} => { fail streamFailure(error, ByteIoOperation.Flush) }
        }
      }
      fail ByteDuplex.closed(ByteIoOperation.Flush)
    }

    unsafe effect fn shutdownWriteRaw(self: &mut Self, deadline: Option<Instant>) -> ()
      ! ByteIoError ? &mut MonotonicClock {
      drop deadline
      if let Option<u32>.None = &self.socket.handleValue { fail ByteDuplex.closed(ByteIoOperation.ShutdownWrite) }
      if let Option<OutputStream>.None = &self.output { return () }
      let output = Intrinsic.replace(self.output, Option<OutputStream>.none())
      drop output
      let mut result = ResultArea.make()
      unsafe host.sockets_tcp_tcp_socket_shutdown(Socket.handle(&self.socket), 1, abi.address(&mut result))
      if ResultArea.byte(&result, 0) != 0 {
        fail ByteDuplex.provider(ByteIoOperation.ShutdownWrite, u32.toI32(u8.toU32(ResultArea.byte(&result, 1))))
      }
    }

    unsafe effect fn closeRaw(self: &mut Self) -> () ! ByteIoError with Intrinsic.nonParking() {
      Connection.close(&mut self.*)
    }
  }
}
