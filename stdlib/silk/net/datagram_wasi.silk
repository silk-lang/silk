//! Owned UDP sockets and complete datagrams through WASI Preview 2.
//!
//! # Details
//! A socket owns its incoming and outgoing datagram streams and drops them before the socket.
//! The host controls network access. Datagram boundaries are preserved; receive returns the whole
//! payload, and send returns only after the host accepts the datagram. Deadlines use the supplied clock.
//!
//! @category Networking

static if Intrinsic.profileText("target") == "wasm32-wasip2" {
  import silk.platform.wasi.preview2 as host
  import silk.platform.wasi.component as abi { ResultArea, Pollable }
  import silk.net.socket_wasi
  import silk.net.socket_wasi { Network, SocketAddress, SocketError }
  import silk.mem.allocator { Allocator, OutOfMemoryError }
  import silk.collections.bytes { Bytes }
  import silk.system.monotonic_clock { MonotonicClock }
  import silk.system.system_clock { Instant }
  import silk.net.address { Endpoint, IpAddress, Ipv4Address, Ipv6Address, Port }
  import silk.core.option { Option }
  import silk.core.ownership { Copy, Drop }
  import silk.mem.pointer { Pointer }
  import silk.num.u8
  import silk.num.u32
  import silk.num.usize

  extern "C" struct Address { words: [u32; 8] }
  impl Copy for Address {}

  fn encode(address: &SocketAddress) -> Address {
    let lanes = SocketAddress.lanes(address)
    let mut words: [u32; 8] = [0; 8]
    words[0] = lanes[0]
    words[1] = lanes[1]
    if lanes[0] == 0 {
      words[1] = words[1] + lanes[2] * 65536 + lanes[3] * 16777216
      words[2] = lanes[4] + lanes[5] * 256
    } else {
      words[2] = lanes[2]
      let mut at: usize = 0
      while at < 4 { words[at + 3] = lanes[at * 2 + 3] + lanes[at * 2 + 4] * 65536 at = at + 1 }
      words[7] = lanes[11]
    }
    return Address {words: words}
  }

  fn decode(address: &Address) -> SocketAddress {
    let words = &address.words
    let port = Port.fromU16(u32.toU16(words[1] % 65536))
    if words[0] == 0 {
      let octets = [u32.toU8(words[1] / 65536 % 256), u32.toU8(words[1] / 16777216),
        u32.toU8(words[2] % 256), u32.toU8(words[2] / 256 % 256)]
      return SocketAddress.make(Endpoint.make(IpAddress.V4 {value: Ipv4Address.fromOctets(octets)}, port))
    }
    let mut octets: [u8; 16] = [0; 16]
    let mut at: usize = 0
    while at < 4 {
      let word = words[at + 3]
      octets[at * 4] = u32.toU8(word / 256 % 256)
      octets[at * 4 + 1] = u32.toU8(word % 256)
      octets[at * 4 + 2] = u32.toU8(word / 16777216)
      octets[at * 4 + 3] = u32.toU8(word / 65536 % 256)
      at = at + 1
    }
    return SocketAddress {endpoint: Endpoint.make(IpAddress.V6 {value: Ipv6Address.fromOctets(octets)}, port),
      flowInfo: words[2], scopeId: words[7]}
  }

  extern "C" struct Incoming { data: ?[*]mut u8, length: u32, remote: Address }
  impl Copy for Incoming {}
  extern "C" struct IncomingResult { tag: u8, data: ?[*]mut Incoming, length: u32 }
  extern "C" struct Outgoing { data: ?[*]const u8, length: u32, hasRemote: u8, remote: Address }

  unsafe extern "C" fn freeBytes(pointer: ?[*]mut u8) -> () as "free"
  unsafe extern "C" fn freeIncoming(pointer: ?[*]mut Incoming) -> () as "free"

  impl IncomingResult {
    fn make() -> IncomingResult {
      let empty = unsafe Intrinsic.pointerRequalify<?*mut Incoming, ?[*]mut Incoming>(Pointer.null<Incoming>())
      return IncomingResult {tag: 0, data: empty, length: 0}
    }
  }

  impl Drop for IncomingResult {
    fn drop(self: &mut Self) -> () {
      if self.tag == 0 && self.length > 0 {
        let pointer = match move Pointer.nonNullMany(self.data) {
          Option<[*]const Incoming>.Some {value} => value
          Option<[*]const Incoming>.None => Intrinsic.trap("null WASI datagram list")
        }
        let mut at: usize = 0
        while at < u32.toUsize(self.length) {
          unsafe {
            let packet = Pointer.read(Pointer.at(pointer, at))
            if packet.length > 0 { freeBytes(packet.data) }
          }
          at = at + 1
        }
        unsafe freeIncoming(self.data)
      }
    }
  }

  struct SocketHandle { handle: Option<u32> }
  impl Drop for SocketHandle {
    fn drop(self: &mut Self) -> () {
      if let Option<u32>.Some {value} = &self.handle { unsafe host.sockets_udp_drop_udp_socket(value) }
    }
  }

  /// One complete received datagram, owning its bytes and sender address.
  pub struct Datagram {
    /// The complete datagram payload, including a possible empty payload.
    pub data: Bytes,
    /// The sender's socket address.
    pub source: SocketAddress,
  }

  /// An owned UDP socket and its receive/send streams. Close and drop release all three resources.
  pub struct UdpSocket { socket: SocketHandle, incoming: u32, outgoing: u32, closed: bool }

  effect fn checked(result: &ResultArea, errorOffset: usize) -> () ! SocketError {
    if ResultArea.byte(result, 0) != 0 { fail SocketError {code: u8.toU32(ResultArea.byte(result, errorOffset))} }
  }

  effect fn wait(handle: u32, deadline: &Option<Instant>) -> () ! SocketError ? &mut MonotonicClock {
    let pollable = unsafe Pollable.take(handle)
    if !run Pollable.wait(&pollable, deadline) { fail SocketError {code: 5} }
  }

  impl UdpSocket {
    /// Binds a UDP socket to `local`. A remote address restricts incoming traffic and supplies the
    /// default send destination; absent means unconnected UDP. Port zero chooses a local port.
    pub effect fn bind(network: &Network, local: &SocketAddress, remote: Option<&SocketAddress>, deadline: Option<Instant>) -> UdpSocket
      ! SocketError ? &mut MonotonicClock {
      if run abi.expired(&deadline) { fail SocketError {code: 5} }
      let lanes = SocketAddress.lanes(local)
      let mut result = ResultArea.make()
      unsafe host.sockets_udp_create_socket_create_udp_socket(lanes[0], abi.address(&mut result))
      run checked(&result, 4)
      let handle = ResultArea.word32(&result, 4)
      let socket = SocketHandle {handle: Option<u32>.some(handle)}
      unsafe host.sockets_udp_udp_socket_start_bind(handle, Network.handle(network),
        lanes[0], lanes[1], lanes[2], lanes[3], lanes[4], lanes[5], lanes[6], lanes[7], lanes[8], lanes[9], lanes[10], lanes[11],
        abi.address(&mut result))
      run checked(&result, 1)
      while true {
        unsafe host.sockets_udp_udp_socket_finish_bind(handle, abi.address(&mut result))
        if ResultArea.byte(&result, 0) == 0 { break }
        if ResultArea.byte(&result, 1) != 8 { run checked(&result, 1) }
        let pollable = unsafe host.sockets_udp_udp_socket_subscribe(handle)
        run wait(pollable, &deadline)
      }
      let mut peer: [u32; 12] = [0; 12]
      let mut present: u32 = 0
      if let Option<&SocketAddress>.Some {value} = &remote { peer = SocketAddress.lanes(value) present = 1 }
      unsafe host.sockets_udp_udp_socket_stream(handle, present,
        peer[0], peer[1], peer[2], peer[3], peer[4], peer[5], peer[6], peer[7], peer[8], peer[9], peer[10], peer[11],
        abi.address(&mut result))
      run checked(&result, 4)
      return UdpSocket {socket: move socket, incoming: ResultArea.word32(&result, 4), outgoing: ResultArea.word32(&result, 8), closed: false}
    }

    /// Returns the bound local address. A closed socket fails with code 9.
    pub effect fn address(self: &Self) -> SocketAddress ! SocketError {
      if self.closed { fail SocketError {code: 9} }
      let handle = match &self.socket.handle { Option<u32>.Some {value} => value Option<u32>.None => Intrinsic.trap("closed UDP socket") }
      let mut result = ResultArea.make()
      unsafe host.sockets_udp_udp_socket_local_address(handle, abi.address(&mut result))
      run checked(&result, 4)
      return unsafe socket_wasi.decodeAddress(&result, 4)
    }

    /// Sends one complete datagram. Unconnected sockets require a destination; connected sockets
    /// may use none. Empty payloads are valid datagrams. A closed socket fails with code 9.
    pub effect fn send(self: &mut Self, bytes: &[u8], remote: Option<&SocketAddress>, deadline: Option<Instant>) -> ()
      ! SocketError ? &mut MonotonicClock {
      if self.closed { fail SocketError {code: 9} }
      let mut packet = Outgoing {data: Pointer.fromSlice(bytes), length: usize.toU32(bytes.length),
        hasRemote: 0, remote: Address {words: [0; 8]}}
      if let Option<&SocketAddress>.Some {value} = &remote { packet.hasRemote = 1 packet.remote = encode(value) }
      while true {
        let mut result = ResultArea.make()
        if run abi.expired(&deadline) { fail SocketError {code: 5} }
        unsafe host.sockets_udp_outgoing_datagram_stream_check_send(self.outgoing, abi.address(&mut result))
        run checked(&result, 8)
        if ResultArea.word64(&result, 8) > 0 {
          unsafe host.sockets_udp_outgoing_datagram_stream_send(self.outgoing, abi.address(&mut packet), 1, abi.address(&mut result))
          if ResultArea.byte(&result, 0) == 0 {
            if ResultArea.word64(&result, 8) == 1 { return () }
          } else if ResultArea.byte(&result, 8) != 8 { run checked(&result, 8) }
        }
        let pollable = unsafe host.sockets_udp_outgoing_datagram_stream_subscribe(self.outgoing)
        run wait(pollable, &deadline)
      }
    }

    /// Receives one complete datagram and owns its payload. Waits until data arrives or the
    /// deadline expires. Allocation failure releases all buffers the host returned.
    pub effect fn receive(self: &mut Self, deadline: Option<Instant>) -> Datagram
      ! SocketError | OutOfMemoryError ? &mut MonotonicClock | &mut Allocator {
      if self.closed { fail SocketError {code: 9} }
      while true {
        if run abi.expired(&deadline) { fail SocketError {code: 5} }
        let mut result = IncomingResult.make()
        unsafe host.sockets_udp_incoming_datagram_stream_receive(self.incoming, 1, abi.address(&mut result))
        if result.tag != 0 { fail SocketError {code: u8.toU32(unsafe abi.byte(&result, 4))} }
        if result.length > 0 {
          if result.length != 1 { Intrinsic.trap("WASI returned more datagrams than requested") }
          let pointer = match move Pointer.nonNullMany(result.data) {
            Option<[*]const Incoming>.Some {value} => value
            Option<[*]const Incoming>.None => Intrinsic.trap("null WASI datagram list")
          }
          let packetPointer = unsafe Pointer.at(pointer, 0)
          let packet = unsafe Pointer.read(packetPointer)
          let mut data = run Bytes.zeroed(u32.toUsize(packet.length))
          if packet.length > 0 {
            let bytes = match move Pointer.nonNullMany(packet.data) {
              Option<[*]const u8>.Some {value} => value
              Option<[*]const u8>.None => Intrinsic.trap("null WASI datagram payload")
            }
            let output = Bytes.asMutSlice(&mut data)
            let mut at: usize = 0
            while at < output.length { unsafe { output[at] = Pointer.read(Pointer.at(bytes, at)) } at = at + 1 }
          }
          return Datagram {data: move data, source: decode(&packet.remote)}
        }
        let pollable = unsafe host.sockets_udp_incoming_datagram_stream_subscribe(self.incoming)
        run wait(pollable, &deadline)
      }
    }

    /// Closes both datagram streams and then their parent socket. Repeated calls do nothing.
    pub fn close(self: &mut Self) -> () {
      if self.closed { return () }
      self.closed = true
      unsafe host.sockets_udp_drop_incoming_datagram_stream(self.incoming)
      unsafe host.sockets_udp_drop_outgoing_datagram_stream(self.outgoing)
      let handle = Intrinsic.replace(self.socket.handle, Option<u32>.none())
      if let Option<u32>.Some {value} = move handle { unsafe host.sockets_udp_drop_udp_socket(value) }
    }
  }

  impl Drop for UdpSocket {
    fn drop(self: &mut Self) -> () { UdpSocket.close(&mut self.*) }
  }
}
