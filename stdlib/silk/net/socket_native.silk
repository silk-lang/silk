unsafe fn currentError() -> i32 {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    unsafe { return Pointer.read<i32>(__error()) }
  } else {
    unsafe { return Pointer.read<i32>(__errno_location()) }
  }
}
unsafe fn closeSocket(fd: i32) -> i32 {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    return unsafe darwinCloseSocket(fd)
  } else {
    return unsafe gnuCloseSocket(fd)
  }
}
fn socketType() -> i32 {
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    return STREAM_SOCKET
  } else {
    return i32.bitOr(STREAM_SOCKET, i32.bitOr(nativeNonblock(), nativeCloseOnExec()))
  }
}
fn sendFlags() -> i32 {
  static if Intrinsic.targetOperatingSystem() == "darwin" { return 0 } else { return 16384 }
}
fn emptySocketVectors() -> [SocketVector; 8] {
  let nothing: [u8; 0] = []
  let base = Pointer.fromSlice<u8>(&nothing)
  return [
    SocketVector {base: base, length: 0},
    SocketVector {base: base, length: 0},
    SocketVector {base: base, length: 0},
    SocketVector {base: base, length: 0},
    SocketVector {base: base, length: 0},
    SocketVector {base: base, length: 0},
    SocketVector {base: base, length: 0},
    SocketVector {base: base, length: 0},
  ]
}
// One `send` for one slice. Several slices go in one `writev` on Darwin, where the socket has
// `SO_NOSIGPIPE`, and in one `sendmsg` with `MSG_NOSIGNAL` on Linux.
unsafe fn sendVectors(fd: i32, vectors: &[SocketVector; 8], used: usize) -> isize {
  if used == 1 { return unsafe send(fd, vectors[0].base, vectors[0].length, sendFlags()) }
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    return unsafe darwinWritev(fd, Pointer.fromSlice<SocketVector>(vectors), usize.toI32(used))
  } else {
    let message = [GnuMessageHeader {
      name: Pointer.null<u8>(),
      nameLength: 0,
      vectors: Pointer.fromSlice<SocketVector>(vectors),
      vectorCount: used,
      control: Pointer.null<u8>(),
      controlLength: 0,
      flags: 0,
    }]
    return unsafe gnuSendMessage(fd, Pointer.fromSlice<GnuMessageHeader>(&message), sendFlags())
  }
}
