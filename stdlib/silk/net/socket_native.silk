struct Descriptor { fd: i32 }

impl Drop for Descriptor {
  fn drop(self: &mut Descriptor) -> () {
  static if (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText("libc") == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
      let fd = Intrinsic.replace(self.fd, -1)
      if fd >= 0 { let ignored = unsafe closeSocket(fd) }

  } else {
    compileError("NativeSocket requires a supported Darwin or GNU libc profile")
  }
}
}

/// An open socket connection. It provides `ByteDuplex`, so `silk.http.exchange`,
/// `silk.http.server`, and `silk.io.buffered_duplex` can use it.
///
/// # Details
/// The socket is nonblocking. When it is not ready, an operation waits for the poll interval with
/// `MonotonicClock`, then tries again. So an idle wait costs about one check for each interval. A
/// flush means that the kernel accepted the bytes, not that the peer got them.
pub struct Connection {
  descriptor: Descriptor,
  phaseValue: ConnectionPhase,
  readEnded: bool,
  options: ConnectOptions,
}

/// A listening socket and its local address.
pub struct Listener {
  descriptor: Descriptor,
  phaseValue: ListenerPhase,
  boundValue: BoundAddress,
  options: ListenOptions,
}

/// A connection from [`accept`], with the address of the client. Use it with [`withAccepted`].
pub struct Accepted {
  connection: Connection,
  peerValue: PeerAddress,
}

/// The connection and the client address that [`withAccepted`] lends to its callback.
pub struct AcceptedView<'a> {
  /// The connection. It is valid only in the callback.
  pub connection: &'a mut Connection,
  /// The address of the client.
  pub peer: &'a PeerAddress,
}

/// A value that serves one accepted connection. See [`withAcceptedContext`].
///
/// # Details
/// Implement it when the code that serves the connection owns state that is moved in, such as a
/// handler. `use` gets the value one time.
pub interface AcceptedContext<A, E, ?CallbackRequirements, ?ContextRequirements> {
  /// Serves the connection in `view`, with `context`.
  effect<'call> fn use<'call>(
    context: Self,
    view: &'call mut AcceptedView<'call>,
  ) -> A ! E ? CallbackRequirements | ContextRequirements
}

struct AcceptedUsingOwner<C> {
  accepted: Accepted,
  context: Option<C>,
}

impl Connection {
  /// Returns the state of the connection.
  pub fn phase(self: &Self) -> ConnectionPhase { return self.phaseValue }

  /// Closes the connection. A second call does nothing.
  ///
  /// The scoped functions close the connection too, and ignore a close error.
  pub effect fn close(self: &mut Self) -> () ! NativeSocketError {
  static if (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText("libc") == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
      let fd = Intrinsic.replace(self.descriptor.fd, -1)
      self.phaseValue = ConnectionPhase.Closed
      self.readEnded = true
      if fd < 0 { return () }
      let status = unsafe closeSocket(fd)
      if status == 0 { return () }
      let code = unsafe currentError()
      static if Intrinsic.targetOperatingSystem() == "darwin" {
        if code == INTERRUPTED || code == nativeInProgress() { return () }
      }
      fail NativeSocketError.NativeFailure {
        operation: NativeSocketOperation.Close,
        errno: code,
      }

  } else {
    compileError("NativeSocket requires a supported Darwin or GNU libc profile")
  }
}
}

impl Listener {
  /// Returns the state of the listener.
  pub fn phase(self: &Self) -> ListenerPhase { return self.phaseValue }
  /// Returns the local address of the listener.
  pub fn boundAddress(self: &Self) -> BoundAddress { return self.boundValue }

  /// Closes the listener. A second call does nothing. It does not remove a Unix socket file.
  pub effect fn close(self: &mut Self) -> () ! NativeSocketError {
  static if (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText("libc") == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
      let fd = Intrinsic.replace(self.descriptor.fd, -1)
      self.phaseValue = ListenerPhase.Closed
      if fd < 0 { return () }
      let status = unsafe closeSocket(fd)
      if status == 0 { return () }
      let code = unsafe currentError()
      static if Intrinsic.targetOperatingSystem() == "darwin" {
        if code == INTERRUPTED || code == nativeInProgress() { return () }
      }
      fail NativeSocketError.NativeFailure {
        operation: NativeSocketOperation.Close,
        errno: code,
      }

  } else {
    compileError("NativeSocket requires a supported Darwin or GNU libc profile")
  }
}
}

impl Accepted {
  /// Returns the address of the client.
  pub fn peer(self: &Self) -> PeerAddress { return self.peerValue }
  /// Returns the state of the connection.
  pub fn connectionPhase(self: &Self) -> ConnectionPhase {
    return Connection.phase(&self.connection)
  }
}

