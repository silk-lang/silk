//! TCP and Unix socket connections and listeners, as `ByteDuplex` providers.
//!
//! # When to use
//! - To connect, call [`connectResolved`] with endpoints from `silk.net.resolver`, or [`connectUnix`]
//!   with a socket path. The connection is lent to a callback and closed after it. Use
//!   [`connectResolvedOwned`] or [`connectUnixOwned`] to keep the [`Connection`] yourself.
//! - To serve, call [`listen`] or [`listenUnix`], then [`accept`] for each client. Use
//!   [`withAccepted`] to get the connection and the peer address, and close them after.
//!
//! A [`Connection`] provides `ByteDuplex`, so `silk.http.exchange`, `silk.http.server`, and
//! `silk.io.buffered_duplex` can use it.
//!
//! # Details
//! All sockets are nonblocking. When a socket is not ready, the operation waits for the poll
//! interval with `MonotonicClock`, then tries again. So an idle wait costs about one check for each
//! interval. One deadline covers all attempts of one connect or accept.
//!
//! A connect tries the endpoints in their order, until one connects or the attempt limit is
//! reached. A flush means that the kernel accepted the bytes, not that the peer got them.
//!
//! # Errors
//! [`NativeSocketError`] tells the rule, the system error, or the deadline. When all endpoints
//! fail, `AttemptsExhausted` has the error of the last attempt.
//!
//! # Gotchas
//! - With a deadline of `None`, a connect or accept can wait forever.
//! - Closing a Unix listener does not remove its socket file. Remove it yourself.
//! - Scoped functions close the socket on return, error, and cancellation. A trap does not.
//! - On Darwin, socket setup is not safe against a `fork` in another thread.
//! - A call fails to compile on targets other than Darwin on aarch64, and Linux with GNU libc on
//!   x86_64 or aarch64. The option types still compile.
//!
//! # Examples
//! ## Connect to a local listener
//! ```silk
//! import silk.io.byte_duplex { ByteDuplex, ByteIoError, ReadTransfer }
//! import silk.core.effect { Effect }
//! import silk.system.monotonic_clock { MonotonicClock }
//! import silk.net.socket_native {
//!   AcceptedView,
//!   BoundAddress,
//!   ConnectOptions,
//!   Connection,
//!   ListenOptions,
//!   Listener,
//!   NativeSocketError,
//!   accept,
//!   connectResolvedOwned,
//!   listen,
//!   withAccepted,
//! }
//! import silk.net.address { Endpoint, IpAddress, Ipv4Address, Port }
//! import silk.core.option { Option }
//! import silk.system.monotonic_clock_native { OsMonotonicClock }
//! import silk.system.system_clock { Instant }
//!
//! // Reads one byte from the client and answers with one byte.
//! effect fn answer<'call>(view: &'call mut AcceptedView<'call>) -> i32
//!   ! ByteIoError
//!   ? &mut MonotonicClock {
//!   let mut input: [u8; 1] = [0]
//!   match move run ByteDuplex.readSome(&mut input, Option<Instant>.none())
//!     |> Effect.provideMut<ByteDuplex>(&mut view.connection.*) {
//!     ReadTransfer.Data { count } => {
//!       if count != 1 || input[0] != 120 {
//!         return 1
//!       }
//!     }
//!     ReadTransfer.End => {
//!       return 1
//!     }
//!   }
//!
//!   // One byte is always written at once, or the call fails.
//!   let written = run ByteDuplex.writeSome(b"y", Option<Instant>.none())
//!     |> Effect.provideMut<ByteDuplex>(&mut view.connection.*)
//!   if written != 1 {
//!     return 1
//!   }
//!   return 0
//! }
//!
//! effect fn program() -> i32
//!   ! NativeSocketError | ByteIoError
//!   ? &mut MonotonicClock {
//!   // Port 0 asks the system for a free port.
//!   let local = Endpoint.make(
//!     IpAddress.V4 { value: Ipv4Address.fromOctets([127, 0, 0, 1]) },
//!     Port.fromU16(0)
//!   )
//!   let mut listener = run listen(local, ListenOptions.defaults())
//!   let bound = match Listener.boundAddress(&listener) {
//!     BoundAddress.Tcp { endpoint } => endpoint
//!     _ => {
//!       return 1
//!     }
//!   }
//!   let targets = [bound]
//!   let mut client = run connectResolvedOwned(
//!     &targets,
//!     ConnectOptions.defaults(),
//!     Option<Instant>.none()
//!   )
//!   let sent = run ByteDuplex.writeSome(b"x", Option<Instant>.none())
//!     |> Effect.provideMut<ByteDuplex>(&mut client)
//!   if sent != 1 {
//!     return 1
//!   }
//!   let accepted = run accept(&mut listener, Option<Instant>.none())
//!   run Listener.close(&mut listener)
//!   let served = run withAccepted<i32, ByteIoError>(move accepted, answer)
//!   let mut reply: [u8; 1] = [0]
//!   let read = run ByteDuplex.readSome(&mut reply, Option<Instant>.none())
//!     |> Effect.provideMut<ByteDuplex>(&mut client)
//!   run Connection.close(&mut client)
//!   return match move read {
//!     ReadTransfer.Data { count } => {
//!       if served != 0 || count != 1 || reply[0] != 121 {
//!         return 1
//!       }
//!       return 0
//!     }
//!     ReadTransfer.End => 1
//!   }
//! }
//!
//! effect fn failed<E>(error: E) -> i32 {
//!   drop error
//!   return 1
//! }
//!
//! pub fn main() -> i32 {
//!   let mut clock = OsMonotonicClock.make()
//!   return run Effect.catchAll(program(), failed) |> Effect.provideMut<MonotonicClock>(&mut clock)
//! }
//! ```
//!
//! @category Networking

import silk.io.byte_duplex {ByteDuplex, ByteIoError, ByteIoOperation, ReadTransfer}
import silk.core.effect {Effect}
import silk.text.format {Debug, Format, Formatter}
import silk.num.i16
import silk.num.i32
import silk.num.i64
import silk.num.isize
import silk.system.monotonic_clock {MonotonicClock}
import silk.net.address {Endpoint, IpAddress, Ipv4Address, Ipv6Address, Port}
import silk.core.option {Option}
import silk.core.ownership {Copy, Drop}
import silk.mem.pointer {Pointer}
import silk.core.result {Result}
import silk.collections.slice {Slice}
import silk.system.system_clock {Instant, SystemClock}
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.u8
import silk.num.usize
import silk.io.writer {Writer, WriterError}

/// The state of a [`Connection`].
pub enum ConnectionPhase {
  /// The connect has not finished.
  Connecting,
  /// Reads and writes are allowed.
  Open,
  /// The write side is shut down. Reads are still allowed.
  WriteClosed,
  /// The socket is closed.
  Closed,
}

/// The system call that failed.
pub enum NativeSocketOperation {
  /// `socket`: create the socket.
  Socket,
  /// Set descriptor flags or socket options.
  Configure,
  /// `connect`.
  Connect,
  /// `bind`.
  Bind,
  /// `listen`.
  Listen,
  /// `getsockname`: read the bound address.
  GetSocketName,
  /// `accept`.
  Accept,
  /// Convert an address that the system returned.
  ConvertAddress,
  /// `poll`: check if the socket is ready.
  Poll,
  /// `getsockopt`: read the error of the socket.
  GetSocketOption,
  /// `read`.
  Read,
  /// `write`.
  Write,
  /// `shutdown` of the write side.
  ShutdownWrite,
  /// `close`.
  Close,
}

impl Debug for NativeSocketOperation {
  /// Writes the name of the variant, such as `Socket`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      NativeSocketOperation.Socket => run Format.write(&mut formatter, b"Socket")
      NativeSocketOperation.Configure => run Format.write(&mut formatter, b"Configure")
      NativeSocketOperation.Connect => run Format.write(&mut formatter, b"Connect")
      NativeSocketOperation.Bind => run Format.write(&mut formatter, b"Bind")
      NativeSocketOperation.Listen => run Format.write(&mut formatter, b"Listen")
      NativeSocketOperation.GetSocketName => run Format.write(&mut formatter, b"GetSocketName")
      NativeSocketOperation.Accept => run Format.write(&mut formatter, b"Accept")
      NativeSocketOperation.ConvertAddress => run Format.write(&mut formatter, b"ConvertAddress")
      NativeSocketOperation.Poll => run Format.write(&mut formatter, b"Poll")
      NativeSocketOperation.GetSocketOption => run Format.write(&mut formatter, b"GetSocketOption")
      NativeSocketOperation.Read => run Format.write(&mut formatter, b"Read")
      NativeSocketOperation.Write => run Format.write(&mut formatter, b"Write")
      NativeSocketOperation.ShutdownWrite => run Format.write(&mut formatter, b"ShutdownWrite")
      NativeSocketOperation.Close => run Format.write(&mut formatter, b"Close")
    }
  }
}

/// The state of a [`Listener`].
pub enum ListenerPhase {
  /// The listener accepts clients.
  Open,
  /// The listener is closed.
  Closed,
}

/// The [`ListenOptions`] value that is not valid.
pub enum ListenOptionsReason {
  /// The backlog is not 1 through 65535.
  KernelBacklog,
  /// The poll interval is not 1 nanosecond through 1 second.
  PollInterval,
}

impl Debug for ListenOptionsReason {
  /// Writes the name of the variant, such as `KernelBacklog`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      ListenOptionsReason.KernelBacklog => run Format.write(&mut formatter, b"KernelBacklog")
      ListenOptionsReason.PollInterval => run Format.write(&mut formatter, b"PollInterval")
    }
  }
}

/// The error of [`ListenOptions.make`].
pub struct ListenOptionsError {
  /// The value that is not valid.
  pub reason: ListenOptionsReason,
  /// The value that you gave.
  pub value: u64,
}

impl Debug for ListenOptionsError {
  /// Writes the fields, as `ListenOptionsError { reason: ..., value: ... }`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return run Format.debugFields(self, "ListenOptionsError", &mut formatter)
  }
}

/// Why a Unix socket path for [`listenUnix`] is not valid.
pub enum InvalidBindReason {
  /// The path is empty.
  EmptyPath,
  /// The path does not start with `/`.
  RelativePath,
  /// The path has a NUL byte.
  NulPath,
  /// The path is an abstract socket address, which is not supported.
  AbstractPath,
}

impl Debug for InvalidBindReason {
  /// Writes the name of the variant, such as `EmptyPath`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      InvalidBindReason.EmptyPath => run Format.write(&mut formatter, b"EmptyPath")
      InvalidBindReason.RelativePath => run Format.write(&mut formatter, b"RelativePath")
      InvalidBindReason.NulPath => run Format.write(&mut formatter, b"NulPath")
      InvalidBindReason.AbstractPath => run Format.write(&mut formatter, b"AbstractPath")
    }
  }
}

/// The [`ConnectOptions`] value that is not valid.
pub enum ConnectOptionsReason {
  /// The poll interval is not 1 nanosecond through 1 second.
  PollInterval,
  /// The attempt limit is not 1 through 1024.
  MaxAttempts,
}

impl Debug for ConnectOptionsReason {
  /// Writes the name of the variant, such as `PollInterval`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      ConnectOptionsReason.PollInterval => run Format.write(&mut formatter, b"PollInterval")
      ConnectOptionsReason.MaxAttempts => run Format.write(&mut formatter, b"MaxAttempts")
    }
  }
}

/// The error of [`ConnectOptions.make`].
pub struct ConnectOptionsError {
  /// The value that is not valid.
  pub reason: ConnectOptionsReason,
  /// The value that you gave.
  pub value: u64,
}

impl Debug for ConnectOptionsError {
  /// Writes the fields, as `ConnectOptionsError { reason: ..., value: ... }`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return run Format.debugFields(self, "ConnectOptionsError", &mut formatter)
  }
}

/// Why the endpoints or the Unix socket path of a connect are not valid.
pub enum InvalidEndpointReason {
  /// The endpoint list is empty.
  EmptyEndpoints,
  /// There are more endpoints than the attempt limit.
  TooManyEndpoints,
  /// The path is empty.
  EmptyPath,
  /// The path does not start with `/`.
  RelativePath,
  /// The path has a NUL byte.
  NulPath,
  /// The path is too long for a socket address.
  PathTooLong,
  /// The path is an abstract socket address, which is not supported.
  AbstractPath,
}

impl Debug for InvalidEndpointReason {
  /// Writes the name of the variant, such as `EmptyEndpoints`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      InvalidEndpointReason.EmptyEndpoints => run Format.write(&mut formatter, b"EmptyEndpoints")
      InvalidEndpointReason.TooManyEndpoints => run Format.write(&mut formatter, b"TooManyEndpoints")
      InvalidEndpointReason.EmptyPath => run Format.write(&mut formatter, b"EmptyPath")
      InvalidEndpointReason.RelativePath => run Format.write(&mut formatter, b"RelativePath")
      InvalidEndpointReason.NulPath => run Format.write(&mut formatter, b"NulPath")
      InvalidEndpointReason.PathTooLong => run Format.write(&mut formatter, b"PathTooLong")
      InvalidEndpointReason.AbstractPath => run Format.write(&mut formatter, b"AbstractPath")
    }
  }
}

/// The error of the last connect attempt, in `AttemptsExhausted`.
pub union AttemptFailure {
  /// The peer refused the connection.
  ConnectionRefused,
  /// The network cannot be reached.
  NetworkUnreachable,
  /// The address is not available.
  AddressUnavailable,
  /// Another system error.
  NativeFailure {
    /// The system call that failed.
    pub operation: NativeSocketOperation,
    /// The `errno` value.
    pub errno: i32,
  },
}

impl Debug for AttemptFailure {
  /// Writes the name of the variant and its fields, such as `ConnectionRefused`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      AttemptFailure.ConnectionRefused => run Format.write(&mut formatter, b"ConnectionRefused")
      AttemptFailure.NetworkUnreachable => run Format.write(&mut formatter, b"NetworkUnreachable")
      AttemptFailure.AddressUnavailable => run Format.write(&mut formatter, b"AddressUnavailable")
      AttemptFailure.NativeFailure { operation, errno } => {
        let mut record = run Format.debugRecord("NativeFailure", &mut formatter)
        run Format.debugField(&mut record, "operation", &operation, &mut formatter)
        run Format.debugField(&mut record, "errno", &errno, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
    }
  }
}

/// The error of a socket operation: the rule that failed, the system error, or the deadline.
pub union NativeSocketError {
  /// All connect attempts failed.
  AttemptsExhausted {
    /// The number of attempts.
    pub attempted: usize,
    /// The error of the last attempt.
    pub last: AttemptFailure,
  },
  /// The time of the next check does not fit in an `Instant`.
  TimeRangeError,
  /// The endpoints or the socket path of a connect are not valid.
  InvalidEndpoint {
    /// The rule that failed.
    pub reason: InvalidEndpointReason,
    /// The byte position of the problem in the path.
    pub offset: usize,
    /// The largest allowed value.
    pub limit: usize,
  },
  /// The socket path of [`listenUnix`] is not valid.
  InvalidBindAddress {
    /// The rule that failed.
    pub reason: InvalidBindReason,
    /// The byte position of the problem in the path.
    pub offset: usize,
  },
  /// The socket path is too long for a socket address.
  PathTooLong {
    /// The length of the path.
    pub length: usize,
    /// The largest allowed length.
    pub limit: usize,
  },
  /// The local address is in use.
  AddressInUse,
  /// The system returned an address with a wrong family or length.
  InvalidNativeAddress {
    /// The address family, or -1 if the address is too short.
    pub family: i32,
    /// The length of the address.
    pub length: usize,
  },
  /// The peer has an address form that is not supported.
  UnsupportedPeerAddress {
    /// The address family, or -1 if the address is too short.
    pub family: i32,
    /// The length of the address.
    pub length: usize,
  },
  /// The system does not support the address family.
  FamilyUnsupported,
  /// The system denied the operation.
  PermissionDenied,
  /// The peer refused the connection.
  ConnectionRefused,
  /// The network cannot be reached.
  NetworkUnreachable,
  /// The address is not available.
  AddressUnavailable,
  /// The system does not have the resources, such as descriptors.
  SystemResources,
  /// The deadline passed.
  Timeout,
  /// The socket is closed.
  Closed,
  /// The write side is shut down.
  WriteClosed,
  /// The system returned a transfer count that is not valid.
  InvalidTransferCount {
    /// The operation.
    pub operation: ByteIoOperation,
    /// The count that the system returned.
    pub count: usize,
    /// The largest valid count.
    pub limit: usize,
  },
  /// Another system error.
  NativeFailure {
    /// The system call that failed.
    pub operation: NativeSocketOperation,
    /// The `errno` value.
    pub errno: i32,
  },
}

impl Debug for NativeSocketError {
  /// Writes the name of the variant and its fields, such as `AttemptsExhausted { ... }`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      NativeSocketError.AttemptsExhausted { attempted, last } => {
        let mut record = run Format.debugRecord("AttemptsExhausted", &mut formatter)
        run Format.debugField(&mut record, "attempted", &attempted, &mut formatter)
        run Format.debugField(&mut record, "last", &last, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      NativeSocketError.TimeRangeError => run Format.write(&mut formatter, b"TimeRangeError")
      NativeSocketError.InvalidEndpoint { reason, offset, limit } => {
        let mut record = run Format.debugRecord("InvalidEndpoint", &mut formatter)
        run Format.debugField(&mut record, "reason", &reason, &mut formatter)
        run Format.debugField(&mut record, "offset", &offset, &mut formatter)
        run Format.debugField(&mut record, "limit", &limit, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      NativeSocketError.InvalidBindAddress { reason, offset } => {
        let mut record = run Format.debugRecord("InvalidBindAddress", &mut formatter)
        run Format.debugField(&mut record, "reason", &reason, &mut formatter)
        run Format.debugField(&mut record, "offset", &offset, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      NativeSocketError.PathTooLong { length, limit } => {
        let mut record = run Format.debugRecord("PathTooLong", &mut formatter)
        run Format.debugField(&mut record, "length", &length, &mut formatter)
        run Format.debugField(&mut record, "limit", &limit, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      NativeSocketError.AddressInUse => run Format.write(&mut formatter, b"AddressInUse")
      NativeSocketError.InvalidNativeAddress { family, length } => {
        let mut record = run Format.debugRecord("InvalidNativeAddress", &mut formatter)
        run Format.debugField(&mut record, "family", &family, &mut formatter)
        run Format.debugField(&mut record, "length", &length, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      NativeSocketError.UnsupportedPeerAddress { family, length } => {
        let mut record = run Format.debugRecord("UnsupportedPeerAddress", &mut formatter)
        run Format.debugField(&mut record, "family", &family, &mut formatter)
        run Format.debugField(&mut record, "length", &length, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      NativeSocketError.FamilyUnsupported => run Format.write(&mut formatter, b"FamilyUnsupported")
      NativeSocketError.PermissionDenied => run Format.write(&mut formatter, b"PermissionDenied")
      NativeSocketError.ConnectionRefused => run Format.write(&mut formatter, b"ConnectionRefused")
      NativeSocketError.NetworkUnreachable => run Format.write(&mut formatter, b"NetworkUnreachable")
      NativeSocketError.AddressUnavailable => run Format.write(&mut formatter, b"AddressUnavailable")
      NativeSocketError.SystemResources => run Format.write(&mut formatter, b"SystemResources")
      NativeSocketError.Timeout => run Format.write(&mut formatter, b"Timeout")
      NativeSocketError.Closed => run Format.write(&mut formatter, b"Closed")
      NativeSocketError.WriteClosed => run Format.write(&mut formatter, b"WriteClosed")
      NativeSocketError.InvalidTransferCount { operation, count, limit } => {
        let mut record = run Format.debugRecord("InvalidTransferCount", &mut formatter)
        run Format.debugField(&mut record, "operation", &operation, &mut formatter)
        run Format.debugField(&mut record, "count", &count, &mut formatter)
        run Format.debugField(&mut record, "limit", &limit, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      NativeSocketError.NativeFailure { operation, errno } => {
        let mut record = run Format.debugRecord("NativeFailure", &mut formatter)
        run Format.debugField(&mut record, "operation", &operation, &mut formatter)
        run Format.debugField(&mut record, "errno", &errno, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
    }
  }
}

/// An empty marker type for this module.
pub struct NativeSocket {}

/// The settings of a connect: Nagle, the poll interval, and the attempt limit.
pub struct ConnectOptions {
  noDelayValue: bool,
  pollIntervalNanoseconds: u64,
  maxAttemptsValue: usize,
}

/// The settings of a listener: the backlog, address reuse, and the poll interval of accept.
pub struct ListenOptions {
  kernelBacklogValue: usize,
  reuseAddressValue: bool,
  pollIntervalNanoseconds: u64,
}

/// A copy of a Unix socket path, at most 108 bytes.
pub struct UnixSocketPath {
  bytesValue: [u8; 108],
  lengthValue: usize,
}

/// The local address of a [`Listener`].
pub union BoundAddress {
  /// A TCP listener.
  Tcp {
    /// The address and port. With port 0 in [`listen`], this is the port that the system chose.
    pub endpoint: Endpoint,
  },
  /// A Unix socket listener.
  Unix {
    /// The socket path.
    pub path: UnixSocketPath,
  },
}

/// The address of a Unix socket client.
pub union UnixPeerAddress {
  /// The client socket has no path. This is normal for a client.
  Unnamed,
  /// The client socket has a path.
  Pathname {
    /// The path.
    pub path: UnixSocketPath,
  },
}

/// The address of an accepted client.
pub union PeerAddress {
  /// A TCP client.
  Tcp {
    /// The address and port of the client.
    pub endpoint: Endpoint,
  },
  /// A Unix socket client.
  Unix {
    /// The address of the client.
    pub peer: UnixPeerAddress,
  },
}

impl Copy for ConnectOptionsError {}
impl Copy for AttemptFailure {}
impl Copy for NativeSocketError {}
impl Copy for ConnectOptions {}
impl Copy for ListenOptionsError {}
impl Copy for ListenOptions {}
impl Copy for UnixSocketPath {}
impl Copy for BoundAddress {}
impl Copy for UnixPeerAddress {}
impl Copy for PeerAddress {}

impl ConnectOptions {
  /// Returns connect options.
  ///
  /// # Errors
  /// `ConnectOptionsError` if `pollIntervalNanoseconds` is not 1 through 1000000000, or
  /// `maxAttempts` is not 1 through 1024.
  pub fn make(
    noDelay: bool,
    pollIntervalNanoseconds: u64,
    maxAttempts: usize,
  ) -> Result<ConnectOptions, ConnectOptionsError> {
    if pollIntervalNanoseconds == 0 || pollIntervalNanoseconds > 1000000000 {
      return Result<ConnectOptions, ConnectOptionsError>.failResult(ConnectOptionsError {
        reason: ConnectOptionsReason.PollInterval,
        value: pollIntervalNanoseconds,
      })
    }
    if maxAttempts == usize.ZERO || maxAttempts > 1024 {
      return Result<ConnectOptions, ConnectOptionsError>.failResult(ConnectOptionsError {
        reason: ConnectOptionsReason.MaxAttempts,
        value: usize.toU64(maxAttempts),
      })
    }
    return Result<ConnectOptions, ConnectOptionsError>.succeed(ConnectOptions {
      noDelayValue: noDelay,
      pollIntervalNanoseconds: pollIntervalNanoseconds,
      maxAttemptsValue: maxAttempts,
    })
  }

  /// Returns the default connect options: Nagle on, a 1 ms poll interval, and 64 attempts.
  pub fn defaults() -> ConnectOptions {
    return ConnectOptions {
      noDelayValue: false,
      pollIntervalNanoseconds: 1000000,
      maxAttemptsValue: 64,
    }
  }

  /// Returns whether Nagle is off (`TCP_NODELAY`).
  pub fn noDelay(self: &Self) -> bool { return self.noDelayValue }
  /// Returns the poll interval, in nanoseconds.
  pub fn pollInterval(self: &Self) -> u64 { return self.pollIntervalNanoseconds }
  /// Returns the attempt limit.
  pub fn maxAttempts(self: &Self) -> usize { return self.maxAttemptsValue }
}

impl ListenOptions {
  /// Returns listen options.
  ///
  /// # Errors
  /// `ListenOptionsError` if `kernelBacklog` is not 1 through 65535, or `pollIntervalNanoseconds`
  /// is not 1 through 1000000000.
  pub fn make(
    kernelBacklog: usize,
    reuseAddress: bool,
    pollIntervalNanoseconds: u64,
  ) -> Result<ListenOptions, ListenOptionsError> {
    if kernelBacklog == usize.ZERO || kernelBacklog > 65535 {
      return Result<ListenOptions, ListenOptionsError>.failResult(ListenOptionsError {
        reason: ListenOptionsReason.KernelBacklog,
        value: usize.toU64(kernelBacklog),
      })
    }
    if pollIntervalNanoseconds == 0 || pollIntervalNanoseconds > 1000000000 {
      return Result<ListenOptions, ListenOptionsError>.failResult(ListenOptionsError {
        reason: ListenOptionsReason.PollInterval,
        value: pollIntervalNanoseconds,
      })
    }
    return Result<ListenOptions, ListenOptionsError>.succeed(ListenOptions {
      kernelBacklogValue: kernelBacklog,
      reuseAddressValue: reuseAddress,
      pollIntervalNanoseconds: pollIntervalNanoseconds,
    })
  }

  /// Returns the default listen options: a backlog of 128, no address reuse, and a 1 ms poll
  /// interval.
  pub fn defaults() -> ListenOptions {
    return ListenOptions {
      kernelBacklogValue: 128,
      reuseAddressValue: false,
      pollIntervalNanoseconds: 1000000,
    }
  }

  /// Returns the backlog of the kernel.
  pub fn kernelBacklog(self: &Self) -> usize { return self.kernelBacklogValue }
  /// Returns whether the listener sets `SO_REUSEADDR`.
  pub fn reuseAddress(self: &Self) -> bool { return self.reuseAddressValue }
  /// Returns the poll interval of accept, in nanoseconds.
  pub fn pollInterval(self: &Self) -> u64 { return self.pollIntervalNanoseconds }
}

impl UnixSocketPath {
  /// Returns the path bytes.
  pub fn bytes(self: &Self) -> &[u8] {
    return Slice.view<u8>(&self.bytesValue, usize.ZERO, self.lengthValue)
  }
}

