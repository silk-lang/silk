//! Turn a host and a port into a list of endpoints to connect to.
//!
//! # When to use
//! Make a [`ResolveRequest`] from a `Host` and a `Port`, and call [`Resolver.resolve`]. A numeric
//! host gives one endpoint without a lookup. A domain name goes to the `Resolver` provider. Use
//! `silk.net.resolver_native` in a native program, or give your own provider, for example in tests.
//!
//! # Details
//! The result keeps the order of the provider, removes exact duplicates, and keeps only the
//! addresses of the [`FamilySelection`]. It holds at most the `maxResults` of the request, and
//! never more than 64.
//!
//! # Errors
//! - `NoAddress` if no address of the selected family remains.
//! - `LimitExceeded` if there are more distinct endpoints than `maxResults`. The result is never
//!   cut short.
//! - `Timeout` if the deadline of a numeric request has passed.
//! - Other [`ResolverError`] values come from the provider.
//!
//! # Gotchas
//! For a domain name, the provider decides how to use the deadline. `NativeSystemResolver` cannot
//! stop a lookup, so it returns `DeadlineUnsupported` for a domain request with a deadline.
//! `maxResults` limits only the result, not the work of the provider.
//!
//! # Examples
//! ## Resolve with a test provider
//! This provider returns the same endpoints for every name. The duplicate and the IPv6 address are
//! removed from the result.
//!
//! ```silk
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.core.effect { Effect }
//! import silk.system.monotonic_clock { MonotonicClock }
//! import silk.net.address {
//!   AddressError,
//!   DomainHost,
//!   Endpoint,
//!   Host,
//!   IpAddress,
//!   Ipv4Address,
//!   Ipv6Address,
//!   Port
//! }
//! import silk.core.option { Option }
//! import silk.core.result { Result }
//! import silk.net.resolver { FamilySelection, ResolveRequest, ResolvedEndpoints, Resolver, ResolverError }
//! import silk.system.system_clock { Instant, SystemClock }
//! import silk.num.u64
//!
//! struct FixedResolver {}
//!
//! impl FixedResolver {
//!   effect fn resolveDomain(
//!     self: &mut Self,
//!     request: &ResolveRequest,
//!     domain: &DomainHost,
//!   ) -> ResolvedEndpoints
//!     ! ResolverError | OutOfMemoryError
//!     ? &mut Allocator {
//!     drop domain
//!     let port = ResolveRequest.port(request)
//!     let mut result = match ResolvedEndpoints.make(8) {
//!       Result<ResolvedEndpoints, ResolverError>.Success { value } => move value
//!       Result<ResolvedEndpoints, ResolverError>.Failure { error } => {
//!         fail move error
//!       }
//!     }
//!     let first = IpAddress.V4 { value: Ipv4Address.fromOctets([192, 0, 2, 1]) }
//!     let second = IpAddress.V6 { value: Ipv6Address.fromOctets([0; 16]) }
//!     let added = run ResolvedEndpoints.admit(&mut result, Endpoint.make(first, port))
//!     let same = run ResolvedEndpoints.admit(&mut result, Endpoint.make(first, port))
//!     let other = run ResolvedEndpoints.admit(&mut result, Endpoint.make(second, port))
//!     return move result
//!   }
//! }
//!
//! impl Resolver for FixedResolver {
//!   resolveDomain: FixedResolver.resolveDomain
//! }
//!
//! struct FixedMonotonic {}
//!
//! impl MonotonicClock for FixedMonotonic {
//!   effect fn now(self: &mut Self) -> Instant {
//!     return SystemClock.make(0, 0)
//!   }
//!
//!   effect fn getResolution(self: &mut Self) -> u64 {
//!     return u64.toU64(1)
//!   }
//!
//!   effect fn waitUntil(self: &mut Self, when: Instant) -> () {
//!     drop when
//!     return ()
//!   }
//!
//!   effect fn waitFor(self: &mut Self, howLong: u64) -> () {
//!     drop howLong
//!     return ()
//!   }
//! }
//!
//! effect fn program() -> i32
//!   ! ResolverError | OutOfMemoryError {
//!   let host = match Host.parse("example.com") {
//!     Result<Host, AddressError>.Success { value } => value
//!     Result<Host, AddressError>.Failure {..} => {
//!       return 1
//!     }
//!   }
//!   let request = match ResolveRequest.make(
//!     host,
//!     Port.fromU16(443),
//!     FamilySelection.V4,
//!     4,
//!     Option<Instant>.none(),
//!   ) {
//!     Result<ResolveRequest, ResolverError>.Success { value } => move value
//!     Result<ResolveRequest, ResolverError>.Failure {..} => {
//!       return 1
//!     }
//!   }
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   let mut resolver = FixedResolver {}
//!   let mut clock = FixedMonotonic {}
//!   let endpoints = run Resolver.resolve(&request) |> Effect.provideMut<Resolver>(&mut resolver)
//!     |> Effect.provideMut<MonotonicClock>(&mut clock)
//!     |> Effect.provideMut<Allocator>(&mut allocator)
//!   if ResolvedEndpoints.length(&endpoints) != 1 {
//!     return 1
//!   }
//!   let endpoint = ResolvedEndpoints.get(&endpoints, 0)
//!   let address = Endpoint.address(&endpoint)
//!   if !IpAddress.isV4(&address) || Port.value(&Endpoint.port(&endpoint)) != 443 {
//!     return 1
//!   }
//!   return 0
//! }
//!
//! effect fn failed<E>(error: E) -> i32 {
//!   drop error
//!   return 1
//! }
//!
//! pub fn main() -> i32 {
//!   return run Effect.catchAll(program(), failed)
//! }
//! ```
//!
//! @category Networking

import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.text.format {Debug, Format, Formatter}
import silk.system.monotonic_clock {MonotonicClock}
import silk.net.address {DomainHost, Endpoint, Host, IpAddress, Port}
import silk.core.option {Option}
import silk.core.result {Result}
import silk.system.system_clock {Instant, SystemClock}
import silk.collections.list {List}
import silk.num.usize
import silk.io.writer {Writer, WriterError}

/// The address families to keep in a result.
pub enum FamilySelection {
  /// Keep IPv4 and IPv6 addresses.
  Any,
  /// Keep only IPv4 addresses.
  V4,
  /// Keep only IPv6 addresses.
  V6,
}

/// The reason that a `maxResults` value is not valid.
pub enum ResolverInputReason {
  /// `maxResults` is 0.
  ZeroResults,
  /// `maxResults` is more than 64.
  TooManyResults,
}

impl Debug for ResolverInputReason {
  /// Writes the name of the variant, such as `ZeroResults`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      ResolverInputReason.ZeroResults => run Format.write(&mut formatter, b"ZeroResults")
      ResolverInputReason.TooManyResults => run Format.write(&mut formatter, b"TooManyResults")
    }
  }
}

/// The system call that failed in a native provider.
pub enum NativeResolverOperation {
  /// Initialize the host networking service before resolving an address.
  Initialize,
  /// The `getaddrinfo` call.
  GetAddrInfo,
}

impl Debug for NativeResolverOperation {
  /// Writes the name of the variant, such as `GetAddrInfo`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      NativeResolverOperation.Initialize => run Format.write(&mut formatter, b"Initialize")
      NativeResolverOperation.GetAddrInfo => run Format.write(&mut formatter, b"GetAddrInfo")
    }
  }
}

/// The reason that a native provider rejected a successful `getaddrinfo` result.
pub enum NativeResultReason {
  /// A successful native lookup returned no result chain.
  NullChain,
  /// A native result contains an unsupported address family.
  UnknownFamily,
  /// A native result has no address pointer.
  NullAddress,
  /// A native address is shorter than its family requires.
  ShortAddress,
}

impl Debug for NativeResultReason {
  /// Writes the name of the variant, such as `NullChain`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      NativeResultReason.NullChain => run Format.write(&mut formatter, b"NullChain")
      NativeResultReason.UnknownFamily => run Format.write(&mut formatter, b"UnknownFamily")
      NativeResultReason.NullAddress => run Format.write(&mut formatter, b"NullAddress")
      NativeResultReason.ShortAddress => run Format.write(&mut formatter, b"ShortAddress")
    }
  }
}

/// The error from a resolution.
pub union ResolverError {
  /// The `maxResults` of the request is not valid.
  InvalidInput {
    /// The rule that failed.
    pub reason: ResolverInputReason,
    /// The `maxResults` that you gave.
    pub value: usize,
  },
  /// The provider does not support this form of host.
  UnsupportedForm,
  /// The deadline of the request has passed.
  Timeout,
  /// The provider cannot stop a lookup at a deadline, so it did not start.
  DeadlineUnsupported,
  /// No address of the selected family was found.
  NoAddress,
  /// The name does not exist.
  NameNotFound,
  /// The lookup failed for a temporary reason, for example a DNS server timeout. Try again later.
  TemporaryFailure,
  /// The system does not support the selected family.
  FamilyUnsupported,
  /// The system did not have the resources, such as memory, for the lookup.
  SystemResources,
  /// A host resolver failed with a provider-specific code, such as a WASI network error ordinal.
  Provider {
    /// The code reported by the provider. Its provider module defines the domain.
    pub code: i32,
  },
  /// The lookup found more distinct endpoints than `maxResults`.
  LimitExceeded {
    /// The `maxResults` of the request.
    pub maximum: usize,
  },
  /// The system returned a result that is not valid.
  InvalidNativeResult {
    /// The problem in the result.
    pub reason: NativeResultReason,
    /// The position of the bad entry in the result list, from 0.
    pub index: usize,
  },
  /// The system lookup failed with a code that has no other variant.
  NativeFailure {
    /// The call that failed.
    pub operation: NativeResolverOperation,
    /// The `EAI_*` code from `getaddrinfo`.
    pub eai: i32,
    /// The `errno` value, when the code is `EAI_SYSTEM`.
    pub errno: Option<i32>,
  },
}

impl Debug for ResolverError {
  /// Writes the name of the variant and its fields, such as `InvalidInput { ... }`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match &self.* {
      ResolverError.InvalidInput { reason, value } => {
        let mut record = run Format.debugRecord("InvalidInput", &mut formatter)
        run Format.debugField(&mut record, "reason", &reason, &mut formatter)
        run Format.debugField(&mut record, "value", &value, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      ResolverError.UnsupportedForm => run Format.write(&mut formatter, b"UnsupportedForm")
      ResolverError.Timeout => run Format.write(&mut formatter, b"Timeout")
      ResolverError.DeadlineUnsupported => run Format.write(&mut formatter, b"DeadlineUnsupported")
      ResolverError.NoAddress => run Format.write(&mut formatter, b"NoAddress")
      ResolverError.NameNotFound => run Format.write(&mut formatter, b"NameNotFound")
      ResolverError.TemporaryFailure => run Format.write(&mut formatter, b"TemporaryFailure")
      ResolverError.FamilyUnsupported => run Format.write(&mut formatter, b"FamilyUnsupported")
      ResolverError.SystemResources => run Format.write(&mut formatter, b"SystemResources")
      ResolverError.Provider {code} => {
        let mut record = run Format.debugRecord("Provider", &mut formatter)
        run Format.debugField(&mut record, "code", &code, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      ResolverError.LimitExceeded { maximum } => {
        let mut record = run Format.debugRecord("LimitExceeded", &mut formatter)
        run Format.debugField(&mut record, "maximum", &maximum, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      ResolverError.InvalidNativeResult { reason, index } => {
        let mut record = run Format.debugRecord("InvalidNativeResult", &mut formatter)
        run Format.debugField(&mut record, "reason", &reason, &mut formatter)
        run Format.debugField(&mut record, "index", &index, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
      ResolverError.NativeFailure { operation, eai, errno } => {
        let mut record = run Format.debugRecord("NativeFailure", &mut formatter)
        run Format.debugField(&mut record, "operation", &operation, &mut formatter)
        run Format.debugField(&mut record, "eai", &eai, &mut formatter)
        run Format.debugField(&mut record, "errno", &errno, &mut formatter)
        return run Format.debugFinish(record, &mut formatter)
      }
    }
  }
}

/// What to resolve: a host, a port, the families to keep, the maximum result count, and an optional
/// deadline. Make it with [`ResolveRequest.make`].
pub struct ResolveRequest {
  hostValue: Host,
  portValue: Port,
  familyValue: FamilySelection,
  maxResultsValue: usize,
  deadlineValue: Option<Instant>,
}

/// The endpoints of a resolution, without duplicates, in the order of the provider.
pub struct ResolvedEndpoints {
  values: List<Endpoint>,
  maximum: usize,
}

/// The result of [`ResolvedEndpoints.admit`].
pub enum Admission {
  /// The endpoint was added.
  Added,
  /// An equal endpoint is already in the list, so nothing changed.
  Duplicate,
}

fn validateMaximum(maximum: usize) -> Result<usize, ResolverError> {
  if maximum == usize.ZERO {
    return Result<usize, ResolverError>.failResult(ResolverError.InvalidInput {
      reason: ResolverInputReason.ZeroResults,
      value: maximum,
    })
  }
  if maximum > 64 {
    return Result<usize, ResolverError>.failResult(ResolverError.InvalidInput {
      reason: ResolverInputReason.TooManyResults,
      value: maximum,
    })
  }
  return Result<usize, ResolverError>.succeed(maximum)
}

fn familyAllows(selection: FamilySelection, address: &IpAddress) -> bool {
  return match selection {
    FamilySelection.Any => true
    FamilySelection.V4 => IpAddress.isV4(address)
    FamilySelection.V6 => !IpAddress.isV4(address)
  }
}

fn deadlineReached(now: &Instant, deadline: &Instant) -> bool {
  let nowSeconds = SystemClock.seconds(now)
  let deadlineSeconds = SystemClock.seconds(deadline)
  if nowSeconds > deadlineSeconds { return true }
  if nowSeconds < deadlineSeconds { return false }
  return SystemClock.nanoseconds(now) >= SystemClock.nanoseconds(deadline)
}

impl ResolveRequest {
  /// Returns a request.
  ///
  /// `maxResults` is from 1 to 64. `deadline` is a time on the `MonotonicClock`.
  ///
  /// # Errors
  /// - `InvalidInput` if `maxResults` is 0 or more than 64.
  pub fn make(
    host: Host,
    port: Port,
    family: FamilySelection,
    maxResults: usize,
    deadline: Option<Instant>,
  ) -> Result<ResolveRequest, ResolverError> {
    return match move validateMaximum(maxResults) {
      Result<usize, ResolverError>.Failure {error} => {
        return Result<ResolveRequest, ResolverError>.failResult(move error)
      }
      Result<usize, ResolverError>.Success {value} => Result<ResolveRequest, ResolverError>.succeed(ResolveRequest {
          hostValue: move host,
          portValue: move port,
          familyValue: move family,
          maxResultsValue: value,
          deadlineValue: move deadline,
        })
    }
  }

  /// Returns the host.
  pub fn host(self: &Self) -> Host { return self.hostValue }

  /// Returns the port.
  pub fn port(self: &Self) -> Port { return self.portValue }

  /// Returns the families to keep.
  pub fn family(self: &Self) -> FamilySelection { return self.familyValue }

  /// Returns the maximum number of endpoints in the result.
  pub fn maxResults(self: &Self) -> usize { return self.maxResultsValue }

  /// Returns `true` if the request has a deadline.
  pub fn hasDeadline(self: &Self) -> bool {
    return match & self.deadlineValue {
      Option<Instant>.None => false
      Option<Instant>.Some {..} => true
    }
  }

  /// Returns the deadline, if there is one. A provider that cannot keep it returns
  /// `DeadlineUnsupported`.
  pub fn deadline(self: &Self) -> Option<Instant> {
    return match & self.deadlineValue {
      Option<Instant>.None => Option<Instant>.none()
      Option<Instant>.Some {value} => Option<Instant>.some(SystemClock.make(
        SystemClock.seconds(&value),
        SystemClock.nanoseconds(&value),
      ))
    }
  }
}

impl ResolvedEndpoints {
  /// Returns an empty list that holds at most `maximum` endpoints, from 1 to 64.
  pub fn make(maximum: usize) -> Result<ResolvedEndpoints, ResolverError> {
    return match move validateMaximum(maximum) {
      Result<usize, ResolverError>.Failure {error} => {
        return Result<ResolvedEndpoints, ResolverError>.failResult(move error)
      }
      Result<usize, ResolverError>.Success {value} => Result<ResolvedEndpoints, ResolverError>.succeed(ResolvedEndpoints {
          values: List<Endpoint>.make(),
          maximum: value,
        })
    }
  }

  /// Returns the number of endpoints.
  pub fn length(self: &Self) -> usize { return List<Endpoint>.length(&self.values) }

  /// Returns the endpoint at `index`. `index` must be less than [`ResolvedEndpoints.length`].
  pub fn get(self: &Self, index: usize) -> Endpoint {
    return List<Endpoint>.get(&self.values, index)
  }

  /// Returns the endpoints as a slice.
  pub fn asSlice(self: &Self) -> &[Endpoint] {
    return List<Endpoint>.asSlice(&self.values)
  }

  /// Adds `endpoint` to the end of the list, if it is not in the list yet.
  ///
  /// # Errors
  /// - `LimitExceeded` if the list is full and `endpoint` is new.
  pub effect fn admit(self: &mut Self, endpoint: Endpoint) -> Admission
  ! ResolverError | OutOfMemoryError
  ? &mut Allocator {
    let values = List<Endpoint>.asSlice(&self.values)
    let mut index = usize.ZERO
    while index < values.length {
      if Endpoint.equals(&values[index], &endpoint) { return Admission.Duplicate }
      index = index + usize.ONE
    }
    if values.length >= self.maximum {
      fail ResolverError.LimitExceeded {maximum: self.maximum}
    }
    run List<Endpoint>.append(&mut self.values, move endpoint)
    return Admission.Added
  }
}

/// The service that looks up domain names. [`Resolver.resolve`] calls it only for domain names.
///
/// # When to use
/// Require `&mut Resolver` in code that connects by name, and call [`Resolver.resolve`]. Provide
/// `silk.net.resolver_native.NativeSystemResolver` in a native program, or your own provider, for
/// example in tests.
///
/// # Gotchas
/// For a domain name, the provider decides how to use the deadline. `NativeSystemResolver` cannot
/// stop a lookup, so it returns `DeadlineUnsupported` for a domain request with a deadline.
pub service Resolver {
  /// Looks up `domain` and returns its endpoints, with the port of `request`. [`Resolver.resolve`]
  /// filters the families and removes duplicates after this call.
  effect fn resolveDomain(
    request: &ResolveRequest,
    domain: &DomainHost,
  ) -> ResolvedEndpoints
  ! ResolverError | OutOfMemoryError
  ? &mut Resolver | &mut Allocator
}

impl Resolver {
  /// Returns the endpoints for `request`.
  ///
  /// A numeric host gives one endpoint, without the provider. A domain name calls
  /// [`Resolver.resolveDomain`] on the provider. The result keeps the order of the provider,
  /// removes exact duplicates, and keeps only the addresses of the [`FamilySelection`]. It holds at
  /// most the `maxResults` of the request, and never more than 64.
  ///
  /// # Errors
  /// - `NoAddress` if no address of the selected family remains.
  /// - `LimitExceeded` if there are more distinct endpoints than `maxResults`. The result is never
  ///   cut short.
  /// - `Timeout` if the deadline of a numeric request has passed.
  /// - Other [`ResolverError`] values come from the provider.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the result.
  ///
  /// # Gotchas
  /// `maxResults` limits only the result, not the work of the provider.
  pub effect fn resolve(request: &ResolveRequest) -> ResolvedEndpoints
  ! ResolverError | OutOfMemoryError
  ? &mut Resolver | &mut Allocator | &mut MonotonicClock {
    let checked = validateMaximum(request.maxResultsValue)
    match move checked {
      Result<usize, ResolverError>.Failure {error} => { fail move error }
      Result<usize, ResolverError>.Success {..} => {}
    }
    return match & request.hostValue {
      Host.Domain {value: domain} => {
        let provided = run Resolver.resolveDomain(request, &domain)
        let made = ResolvedEndpoints.make(request.maxResultsValue)
        let mut resolved = match move made {
          Result<ResolvedEndpoints, ResolverError>.Failure {error} => { fail move error }
          Result<ResolvedEndpoints, ResolverError>.Success {value} => move value
        }
        let mut index = usize.ZERO
        while index < ResolvedEndpoints.length(&provided) {
          let endpoint = ResolvedEndpoints.get(&provided, index)
          let address = Endpoint.address(&endpoint)
          if familyAllows(request.familyValue, &address) {
            let _admitted = run ResolvedEndpoints.admit(&mut resolved, move endpoint)
          }
          index = index + usize.ONE
        }
        if ResolvedEndpoints.length(&resolved) == usize.ZERO {
          fail ResolverError.NoAddress
        }
        return move resolved
      }
      Host.Ipv4 {value: address} => {
        return run numeric(request, IpAddress.V4 {value: address})
      }
      Host.Ipv6 {value: address} => {
        return run numeric(request, IpAddress.V6 {value: address})
      }
    }
  }
}

effect fn numeric(request: &ResolveRequest, address: IpAddress) -> ResolvedEndpoints
! ResolverError | OutOfMemoryError
? &mut Allocator | &mut MonotonicClock {
  match & request.deadlineValue {
    Option<Instant>.None => {}
    Option<Instant>.Some {value: deadline} => {
      let now = run MonotonicClock.now()
      if deadlineReached(&now, &deadline) { fail ResolverError.Timeout }
    }
  }
  if !familyAllows(request.familyValue, &address) { fail ResolverError.NoAddress }
  let made = ResolvedEndpoints.make(request.maxResultsValue)
  let mut resolved = match move made {
    Result<ResolvedEndpoints, ResolverError>.Failure {error} => { fail move error }
    Result<ResolvedEndpoints, ResolverError>.Success {value} => move value
  }
  let _admitted = run ResolvedEndpoints.admit(
    &mut resolved,
    Endpoint.make(move address, request.portValue),
  )
  return move resolved
}
