//! Resolves host filesystem paths through symbolic links without changing the working directory.

import silk.collections.bytes { Bytes }
import silk.collections.slice { Slice }
import silk.core.option { Option }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.num.usize
static if Intrinsic.targetOperatingSystem() == "windows" { import silk.platform.windows.host_path as WindowsHostPath }

fn contains(bytes: &[u8], byte: u8) -> bool {
  let mut at = usize.ZERO
  while at < bytes.length {
    if bytes[at] == byte { return true }
    at = at + usize.ONE
  }
  return false
}

// Intel macOS names the POSIX 2008 `realpath` `realpath$DARWIN_EXTSN`; the plain name is the
// legacy one.
static if Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "x86_64" {
  @foreign(noCapture: ("path", "resolved"))
  unsafe extern "C" fn realpath(path: ?[*]const u8, resolved: ?[*]mut u8) -> ?[*]mut u8 as "realpath$DARWIN_EXTSN"
} else {
  @foreign(noCapture: ("path", "resolved"))
  unsafe extern "C" fn realpath(path: ?[*]const u8, resolved: ?[*]mut u8) -> ?[*]mut u8
}

// At least PATH_MAX on every supported host (4096 on Linux, 1024 on macOS), so `realpath` never
// writes past the buffer.
fn resolvedCapacity() -> usize {
  return usize.add(0, 4096)
}


fn isNull(answer: ?[*]mut u8) -> bool {
  unsafe {
    return Pointer.isNullMany<u8>(Intrinsic.pointerRequalify<?[*]mut u8, ?[*]const u8>(answer))
  }
}

/// The canonical path of `path` with every symbolic link resolved, or `None` when the host cannot
/// resolve it.
pub effect fn canonicalBytes(path: &[u8]) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
  static if Intrinsic.targetOperatingSystem() == "windows" { return run WindowsHostPath.canonicalBytes(path) }
  if contains(path, 0) {
    return Option<Bytes>.none()
  }
  // WASI resolves no symbolic links outside the guest's own paths, so a path is its own canonical
  // spelling.
  static if Intrinsic.targetOperatingSystem() == "wasi" { return Option<Bytes>.some(run Bytes.copy(path)) } else {
  let mut request = run Bytes.copy(path)
  let ending: [u8; 1] = [0]
  run Bytes.append(&mut request, &ending)
  let mut buffer = run Bytes.zeroed(resolvedCapacity())
  let answer = unsafe realpath(
    Pointer.fromSlice<u8>(Bytes.asSlice(&request)),
    Pointer.fromMutSlice<u8>(Bytes.asMutSlice(&mut buffer)),
  )
  if isNull(answer) {
    return Option<Bytes>.none()
  }
  let written = Bytes.asSlice(&buffer)
  let mut length = usize.ZERO
  while length < written.length && written[length] != 0 {
    length = length + usize.ONE
  }
  return Option<Bytes>.some(run Bytes.copy(Slice.view<u8>(written, usize.ZERO, length)))
  }
}

