//! Read the size of a terminal, and switch it between its normal mode and raw mode.
//!
//! # When to use
//! Use [`Terminal`] for a program that draws on the terminal or reads keys one at a time, such as
//! an editor, a prompt, or the REPL of a JavaScript runtime. Read the mode with [`Terminal.mode`]
//! before you change it, and give it back with [`Terminal.setMode`] before the program ends.
//!
//! # Details
//! The functions take a raw descriptor of a terminal, such as 0 for standard input. They never
//! open, close, or wait on the descriptor. A [`TerminalMode`] is a copy of the terminal settings
//! (`struct termios`); [`TerminalMode.raw`] returns the same settings in raw mode, as libuv and
//! Node.js define it: no line editing, no echo, no signals from keys such as Control-C, and reads
//! that return each byte at once.
//!
//! # Errors
//! Each function fails with [`TerminalError`]: the native error code, such as 25 (`ENOTTY`) for a
//! descriptor that is not a terminal.
//!
//! # Gotchas
//! - A raw terminal stays raw after the program ends. Give back the earlier mode first.
//! - Listen for `SIGWINCH` with `silk.system.signal_watch` to learn when the size changes.
//! - The module is empty on targets other than Darwin on x86_64 or aarch64, and Linux with GNU libc
//!   on x86_64 or aarch64.
//!
//! # Examples
//! ## Ask a descriptor that is not a terminal
//! ```silk
//! import silk.core.effect { Effect }
//! import silk.mem.pointer { Pointer }
//! import silk.core.result { Result }
//! import silk.system.terminal { Terminal, TerminalError, WindowSize }
//!
//! @foreign(noCapture: .("fds"))
//! unsafe extern "C" fn pipe(fds: ?[*]mut i32) -> i32
//!
//! pub effect fn main() -> i32 {
//!   let mut fds: [i32; 2] = [-1, -1]
//!   if unsafe pipe(Pointer.fromMutSlice<i32>(&mut fds)) != 0 { return 1 }
//!   if Terminal.isTerminal(fds[0]) { return 1 }
//!   return match run Effect.result(Terminal.windowSize(fds[0])) {
//!     Result<WindowSize, TerminalError>.Success { .. } => 1
//!     // ENOTTY is 25 on Linux and Darwin.
//!     Result<WindowSize, TerminalError>.Failure { error } => if error.code == 25 { 0 } else { 1 }
//!   }
//! }
//! ```
//!
//! @category System

static if (Intrinsic.targetOperatingSystem() == "darwin" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64") && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText("libc") == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
import silk.mem.pointer { Pointer }
import silk.core.ownership { Copy }
import silk.platform.native.descriptor { isatty }

/// A failed terminal operation, with the native error code.
///
/// # Details
/// `code` is the `errno` value of the failed system call, such as 25 (`ENOTTY`) for a descriptor
/// that is not a terminal, or 9 (`EBADF`) for one that is not open.
pub struct TerminalError {
  /// The native error code.
  pub code: i32,
}

/// The size of a terminal in character cells.
pub struct WindowSize {
  /// The number of columns.
  pub columns: u16,
  /// The number of rows.
  pub rows: u16,
}

impl Copy for WindowSize {}

/// A copy of the settings of a terminal, from [`Terminal.mode`].
///
/// # Details
/// Keep the mode that you read first, and give it back with [`Terminal.setMode`]. Make a raw copy
/// with [`TerminalMode.raw`].
pub struct TerminalMode {
  settings: Settings,
}

impl Copy for TerminalMode {}

impl TerminalMode {
  /// Returns these settings in raw mode, as libuv and Node.js define it.
  ///
  /// # Details
  /// Raw mode turns off line editing, echo, the signals from keys such as Control-C and
  /// Control-Z, the translation of a carriage return to a newline on input, flow control with
  /// Control-S and Control-Q, and parity checks. Characters are 8 bits, and a read returns as soon
  /// as one byte is there. Output still turns a newline into a carriage return and a newline.
  pub fn raw(self: &Self) -> TerminalMode {
    let mut settings = self.settings
    settings.input = settings.input & ~(BREAK_INTERRUPT | CARRIAGE_TO_NEWLINE | PARITY_CHECK | STRIP | FLOW_CONTROL)
    settings.output = settings.output | NEWLINE_TO_RETURN
    settings.control = settings.control | EIGHT_BITS
    settings.local = settings.local & ~(ECHO | CANONICAL | EXTENDED | SIGNALS)
    settings.characters[MINIMUM] = 1
    settings.characters[TIME] = 0
    return TerminalMode { settings: settings }
  }
}

/// Functions on a terminal descriptor.
pub struct Terminal {}

impl Terminal {
  /// Returns whether `fd` is an open descriptor of a terminal.
  pub fn isTerminal(fd: i32) -> bool {
    return unsafe isatty(fd) == 1
  }

  /// Returns the size of the terminal `fd` in character cells.
  ///
  /// # Errors
  /// [`TerminalError`] with code 25 (`ENOTTY`) if `fd` is not a terminal, or 9 (`EBADF`) if it is
  /// not open.
  pub effect fn windowSize(fd: i32) -> WindowSize ! TerminalError {
    let mut size = Winsize { rows: 0, columns: 0, width: 0, height: 0 }
    while unsafe ioctl(fd, WINDOW_SIZE, Pointer.fromMutRef<Winsize>(&mut size)) != 0 {
      let code = unsafe currentError()
      if code != 4 { fail TerminalError { code: code } }
    }
    return WindowSize { columns: size.columns, rows: size.rows }
  }

  /// Returns the current settings of the terminal `fd`.
  ///
  /// # Errors
  /// [`TerminalError`] with code 25 (`ENOTTY`) if `fd` is not a terminal, or 9 (`EBADF`) if it is
  /// not open.
  pub effect fn mode(fd: i32) -> TerminalMode ! TerminalError {
    let mut settings = emptySettings()
    if unsafe tcgetattr(fd, Pointer.fromMutRef<Settings>(&mut settings)) != 0 {
      fail TerminalError { code: unsafe currentError() }
    }
    return TerminalMode { settings: settings }
  }

  /// Applies `mode` to the terminal `fd`, after the output that was written to it is sent.
  ///
  /// # Errors
  /// [`TerminalError`] with code 25 (`ENOTTY`) if `fd` is not a terminal, 9 (`EBADF`) if it is not
  /// open, or 5 (`EIO`) if the process is in the background of the terminal.
  pub effect fn setMode(fd: i32, mode: &TerminalMode) -> () ! TerminalError {
    while unsafe tcsetattr(fd, DRAIN, Pointer.fromRef<Settings>(&mode.settings)) != 0 {
      let code = unsafe currentError()
      if code != 4 { fail TerminalError { code: code } }
    }
    return ()
  }
}

// The C `struct winsize`.
extern "C" struct Winsize { rows: u16, columns: u16, width: u16, height: u16 }

@foreign(noCapture: .("settings"))
unsafe extern "C" fn tcgetattr(fd: i32, settings: *mut Settings) -> i32
@foreign(noCapture: .("settings"))
unsafe extern "C" fn tcsetattr(fd: i32, action: i32, settings: *const Settings) -> i32
unsafe extern "C" fn ioctl(fd: i32, request: u64, ...) -> i32

// `TCSADRAIN` is 1 on Linux and Darwin.
const DRAIN: i32 = 1

static if Intrinsic.targetOperatingSystem() == "darwin" {
  unsafe extern "C" fn __error() -> *mut i32
  unsafe fn currentError() -> i32 { unsafe { return Pointer.read<i32>(__error()) } }

  // The C `struct termios` of Darwin: `tcflag_t` and `speed_t` are `unsigned long`.
  extern "C" struct Settings {
    input: u64,
    output: u64,
    control: u64,
    local: u64,
    characters: [u8; 20],
    inputSpeed: u64,
    outputSpeed: u64,
  }
  impl Copy for Settings {}
  fn emptySettings() -> Settings {
    return Settings { input: 0, output: 0, control: 0, local: 0, characters: [0; 20], inputSpeed: 0, outputSpeed: 0 }
  }
  const WINDOW_SIZE: u64 = 1074295912
  const BREAK_INTERRUPT: u64 = 2
  const CARRIAGE_TO_NEWLINE: u64 = 256
  const PARITY_CHECK: u64 = 16
  const STRIP: u64 = 32
  const FLOW_CONTROL: u64 = 512
  const NEWLINE_TO_RETURN: u64 = 2
  const EIGHT_BITS: u64 = 768
  const ECHO: u64 = 8
  const CANONICAL: u64 = 256
  const EXTENDED: u64 = 1024
  const SIGNALS: u64 = 128
  const MINIMUM: usize = 16
  const TIME: usize = 17
} else {
  unsafe extern "C" fn __errno_location() -> *mut i32
  unsafe fn currentError() -> i32 { unsafe { return Pointer.read<i32>(__errno_location()) } }

  // The C `struct termios` of glibc.
  extern "C" struct Settings {
    input: u32,
    output: u32,
    control: u32,
    local: u32,
    line: u8,
    characters: [u8; 32],
    inputSpeed: u32,
    outputSpeed: u32,
  }
  impl Copy for Settings {}
  fn emptySettings() -> Settings {
    return Settings { input: 0, output: 0, control: 0, local: 0, line: 0, characters: [0; 32], inputSpeed: 0, outputSpeed: 0 }
  }
  const WINDOW_SIZE: u64 = 21523
  const BREAK_INTERRUPT: u32 = 2
  const CARRIAGE_TO_NEWLINE: u32 = 256
  const PARITY_CHECK: u32 = 16
  const STRIP: u32 = 32
  const FLOW_CONTROL: u32 = 1024
  const NEWLINE_TO_RETURN: u32 = 4
  const EIGHT_BITS: u32 = 48
  const ECHO: u32 = 8
  const CANONICAL: u32 = 2
  const EXTENDED: u32 = 32768
  const SIGNALS: u32 = 1
  const MINIMUM: usize = 6
  const TIME: usize = 5
}
}
