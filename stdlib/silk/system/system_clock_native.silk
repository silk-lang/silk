//! The native provider of the `SystemClock` effect: the time of day, as seconds since 1970.
//!
//! # When to use
//! Provide [`OsSystemClock`] for `SystemClock` in a native program, for timestamps. In a test,
//! provide a fake that returns a fixed time.
//!
//! # Details
//! Each call reads the real-time clock of the system. A failure of the clock is a trap.
//!
//! # Gotchas
//! - This clock can go back when the system time is set. Use `silk.system.monotonic_clock_native` to measure
//!   durations.
//! - On Linux, it needs glibc 2.17 or later.
//! - The provider exists on WASI, Windows on x86_64, Darwin on aarch64, and GNU Linux on x86_64 or aarch64.
//!
//! # Examples
//! ## Read the time
//! ```silk
//! import silk.core.effect { Effect }
//! import silk.system.system_clock_native { OsSystemClock }
//! import silk.system.system_clock { Instant, SystemClock }
//!
//! pub fn main() -> i32 {
//!   let mut clock = OsSystemClock.make()
//!   let now = run SystemClock.now() |> Effect.provideMut<SystemClock>(&mut clock)
//!
//!   // Seconds since 1970. 1600000000 is in September 2020.
//!   let nanoseconds = SystemClock.nanoseconds(&now)
//!   if SystemClock.seconds(&now) < 1600000000 || nanoseconds < 0 || nanoseconds >= 1000000000 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category System


static if (Intrinsic.targetOperatingSystem() == "windows" && Intrinsic.targetArchitecture() == "x86_64" && Intrinsic.targetAbi() == "msvc" && Intrinsic.profileText("libc") == "system") || Intrinsic.targetOperatingSystem() == "wasi" || (Intrinsic.targetOperatingSystem() == "darwin" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64") && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText("libc") == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
  import silk.platform.native.clock { NativeClock }
  import silk.system.system_clock { Instant }
  import silk.system.system_clock { SystemClock }

  /// The native `SystemClock` provider: the time of day, as seconds since 1970. It has no state. A
  /// failure is a trap.
  ///
  /// # Gotchas
  /// - This clock can go back when the system time is set. Use `silk.system.monotonic_clock_native` to
  ///   measure durations.
  /// - On Linux, it needs glibc 2.17 or later.
  pub struct OsSystemClock {}

  impl OsSystemClock {
    /// Returns a clock. It does not read the time.
    pub fn make() -> OsSystemClock { return OsSystemClock {} }
  }

  impl SystemClock for OsSystemClock {
    effect fn now(self: &mut Self) -> Instant { return run NativeClock.now(false) }
    effect fn getResolution(self: &mut Self) -> u64 { return run NativeClock.resolution(false) }
  }
}
