//! The `InsecureSeed` effect: one fixed 128-bit value that a program reads when it starts.
//!
//! # When to use
//! Read [`InsecureSeed.get`] while you set up a runtime or a data structure that needs a seed, for
//! example to make hash collisions harder to cause. Provide [`InsecureSeed.fixed`] for repeatable
//! runs, or [`InsecureSeed.fromRandom`] when secure randomness is available.
//!
//! # Details
//! Each read returns the same [`Seed`]. [`InsecureSeed.fromRandom`] reads two `u64` values from
//! `Random` one time and keeps them.
//!
//! # Gotchas
//! It is not a sequence of random values and is not secure. The hash collections of the standard
//! library do not read it. Give them a seed with `silk.collections.hash.Hash.seed`.
//!
//! # Examples
//! ## Provide a fixed seed
//! ```silk
//! import silk.core.effect { Effect }
//! import silk.system.insecure_seed { InsecureSeed }
//!
//! pub fn main() -> i32 {
//!   let provider = InsecureSeed.fixed(20, 22)
//!   let seed = run InsecureSeed.get() |> Effect.provide<InsecureSeed>(&provider)
//!   if InsecureSeed.first(&seed) + InsecureSeed.second(&seed) != 42 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category System

import silk.core.ownership { Copy }
import silk.system.random { Random }
import silk.num.u64

/// A seed of two `u64` words. Read them with [`InsecureSeed.first`] and [`InsecureSeed.second`].
pub struct Seed {
  first: u64,
  second: u64,
}

impl Copy for Seed {}

/// The effect that returns the same 128-bit [`Seed`] on each read. It needs only shared access.
///
/// # When to use
/// Read [`InsecureSeed.get`] while you set up a runtime or a data structure that needs a seed, for
/// example to make hash collisions harder to cause. Provide [`InsecureSeed.fixed`] for repeatable
/// runs, or [`InsecureSeed.fromRandom`] when secure randomness is available.
///
/// # Gotchas
/// It is not a sequence of random values and is not secure. The hash collections of the standard
/// library do not read it. Give them a seed with `silk.collections.hash.Hash.seed`.
pub service InsecureSeed {
  /// Returns the seed of the provider. Each read returns the same seed.
  effect fn get() -> Seed ? &InsecureSeed
}

impl InsecureSeed {
  /// Returns the first word of `seed`.
  pub fn first(seed: &Seed) -> u64 {
    return seed.first
  }

  /// Returns the second word of `seed`.
  pub fn second(seed: &Seed) -> u64 {
    return seed.second
  }

  /// Returns a provider with the seed `first`, `second`. It does not use randomness.
  pub fn fixed(first: u64, second: u64) -> FixedInsecureSeed {
    return FixedInsecureSeed { seed: Seed { first: first, second: second } }
  }

  /// Returns a provider with a seed from two `u64` values of `Random`. It reads `Random` one time,
  /// and the provider keeps the same seed after that.
  pub effect fn fromRandom() -> FixedInsecureSeed ? &mut Random {
    let first = run Random.nextU64()
    let second = run Random.nextU64()
    return InsecureSeed.fixed(first, second)
  }
}

/// A provider that holds one seed. Make one with [`InsecureSeed.fixed`] or
/// [`InsecureSeed.fromRandom`].
pub struct FixedInsecureSeed {
  seed: Seed,
}

impl FixedInsecureSeed {
  effect fn fixedGet(self: &Self) -> Seed {
    return self.seed
  }
}

impl InsecureSeed for FixedInsecureSeed {
  get: FixedInsecureSeed.fixedGet
}

