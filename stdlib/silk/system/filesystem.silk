//! Files and directories through the `FileSystem` effect: paths, whole-file reads and writes,
//! atomic writes, directory listings, and temporary directories.
//!
//! # When to use
//! Make a [`Path`] with [`Path.make`], [`Path.join`], or [`Path.resolve`]. Then require `&mut
//! FileSystem` and call [`FileSystem.readFile`], [`FileSystem.writeFile`], and the other
//! operations. Native programs provide `silk.system.filesystem_native`. Tests can provide a file system in
//! memory.
//!
//! Use [`FileSystem.writeFileAtomic`] when a reader must never see a partly written file, such as
//! for a configuration file. Use [`FileSystem.temporaryDirectory`] for scratch space.
//!
//! # Details
//! Each `Path` is absolute and normalized. It starts with `/`, and it has no empty components, no
//! `.` or `..` components, no NUL byte, and no trailing `/` (except the root `/` itself). `/` is
//! the root of the provider, which is not always the root of the host.
//!
//! A path is bytes, not text, because host paths do not have to be valid UTF-8. Use
//! [`Path.rawBytes`] to pass a path on without loss. [`Path.view`] and [`Path.name`] return text
//! only for valid UTF-8.
//!
//! Directory listings are sorted by the bytes of the path, so they are the same on each host.
//!
//! # Errors
//! - [`FileError`] for each failed operation. It has the operation, a portable reason, and an
//!   optional code from the provider. Recover by the reason: `NotFound`, `AlreadyExists`,
//!   `PermissionDenied`, `InvalidPath`, `WrongType`, `NotEmpty`, `NoSpace`, `TooLarge`,
//!   `Unsupported`, or `Other`.
//! - [`AtomicWriteError`] from [`FileSystem.writeFileAtomic`].
//! - `OutOfMemoryError` from operations that return owned paths or bytes.
//!
//! # Gotchas
//! A temporary directory is not removed when it is dropped. Call [`FileSystem.release`] or
//! [`FileSystem.releaseIgnored`]. Operations on more than one path, such as
//! [`FileSystem.writeFileWithParents`], are not transactions. A failure can leave part of the work
//! done.
//!
//! # Examples
//! ## Make, join, and resolve paths
//! ```silk
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.core.effect { Effect }
//! import silk.system.filesystem { FileError, Path }
//! import silk.option { Option }
//!
//! effect fn paths() -> bool
//!   ! FileError | OutOfMemoryError
//!   ? &mut Allocator {
//!   let project = run Path.make("/workspace/app")
//!   let source = run Path.join(&project, "src/main.silk")
//!   let sibling = run Path.resolve(&project, "../docs")
//!   let name = Path.name(&source)
//!   let sourceOk = match move name {
//!     Option<string>.Some { value } => value == "main.silk"
//!     Option<string>.None => false
//!   }
//!   return sourceOk && Path.rawBytes(&sibling).length == 15
//! }
//!
//! pub effect fn main() -> i32
//!   ! FileError | OutOfMemoryError {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   if !run paths() |> Effect.provideMut<Allocator>(&mut allocator) {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! # See also
//! - `silk.system.filesystem_native` for the native provider.
//! - `silk.system.host_input` for the working directory of the process.
//!
//! @category System

import silk.core.bool
import silk.collections.bytes { Bytes }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.allocator { OutOfMemoryError }
import silk.core.effect { Effect }
import silk.format { Debug, Format, Formatter }
import silk.num.i32
import silk.option { Option }
import silk.core.result { Result }
import silk.text.string { InvalidUtf8, String }
import silk.num.u8
import silk.num.usize
import silk.collections.list { List }
import silk.io.writer { Writer, WriterError }

/// An owned, normalized, absolute path.
///
/// # Details
///
/// Each `Path` starts with `/`, and it has no empty components, no `.` or `..` components, no NUL
/// byte, and no trailing `/` (except the root `/` itself). The only way to make one is through
/// [`Path.make`], [`Path.fromBytes`], [`Path.root`], [`Path.join`], or [`Path.resolve`], which
/// check these rules. `/` is the root of the `FileSystem` provider, which is not always the root
/// of the host.
///
/// A path is bytes, not text, because host paths do not have to be valid UTF-8. Use
/// [`Path.rawBytes`] to pass a path on without loss. [`Path.view`] and [`Path.name`] return text
/// only for valid UTF-8.
pub struct Path {
  bytes: Bytes,
  nameBytes: Bytes,
}

impl Path {
  /// Returns a copy of `value` as a [`Path`].
  ///
  /// # Details
  ///
  /// `value` must start with `/`. Except for `/` itself, it must not end with `/`, and it must not
  /// contain NUL, empty components, `.`, or `..`. To interpret `.` and `..`, use [`Path.resolve`].
  ///
  /// # Errors
  ///
  /// - `FileError` with reason `InvalidPath` if `value` does not follow these rules.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the path.
  pub effect fn make(value: string) -> Path ! FileError | OutOfMemoryError ? &mut Allocator {
    let values = String.utf8Bytes(value)
    if validAbsolute(values) == false { return run rejectPath() }
    let copied = run appendRange(Bytes.make(), values, usize.ZERO, values.length)
    return run finishPath(move copied)
  }

  /// Returns a copy of `values` as a [`Path`]. The bytes do not have to be valid UTF-8.
  ///
  /// # When to use
  ///
  /// Use it for a path that you got from the host as bytes, such as a program argument, so you can
  /// pass it back without changes.
  ///
  /// # Details
  ///
  /// `values` must start with `/`. Except for `/` itself, it must not end with `/`, and it must not
  /// contain NUL, empty components, `.`, or `..`. The result can have no text view.
  ///
  /// # Errors
  ///
  /// - `FileError` with reason `InvalidPath` if `values` does not follow the path rules.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the path.
  pub effect fn fromBytes(values: &[u8]) -> Path ! FileError | OutOfMemoryError ? &mut Allocator {
    if validAbsolute(values) == false { return run rejectPath() }
    let copied = run appendRange(Bytes.make(), values, usize.ZERO, values.length)
    return run finishPath(move copied)
  }

  /// Returns the root path `/`.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the path.
  pub effect fn root() -> Path ! OutOfMemoryError ? &mut Allocator {
    let mut copied = Bytes.make()
    let appended = run Bytes.append(&mut copied, String.utf8Bytes("/"))
    return run finishPath(move copied)
  }

  /// Returns the bytes of the path. This view works for every path, also when the bytes are not
  /// valid UTF-8.
  pub fn rawBytes(self: &Self) -> &[u8] {
    return pathBytes(self)
  }

  /// Returns the path as text. Returns an absent option if the bytes are not valid UTF-8.
  ///
  /// # Details
  ///
  /// Paths from [`Path.make`], [`Path.join`], [`Path.joinUtf8`], and [`Path.resolve`] are always
  /// valid UTF-8. Paths from [`Path.fromBytes`] and [`Path.joinBytes`] are not always.
  pub fn view(self: &Self) -> Option<string> {
    return utf8View(pathBytes(self))
  }

  /// Returns `true` if the path is the root `/`.
  pub fn isRoot(self: &Self) -> bool { return Bytes.asSlice(&self.bytes).length == usize.ONE }

  /// Returns the last component as text, such as `"main.silk"` for `/app/main.silk`. Returns an
  /// absent option if the bytes are not valid UTF-8.
  ///
  /// # Details
  ///
  /// For the root, the result is empty text. It does not allocate.
  pub fn name(self: &Self) -> Option<string> {
    return utf8View(Bytes.asSlice(&self.nameBytes))
  }

  /// Returns `base` followed by `/` and `fragment`.
  ///
  /// # Details
  ///
  /// `fragment` is relative and can have more than one component, such as `"src/main.silk"`. It
  /// must not be empty, start or end with `/`, or contain NUL, empty components, `.`, or `..`. To
  /// interpret `.` and `..`, use [`Path.resolve`].
  ///
  /// # Errors
  ///
  /// - `FileError` with reason `InvalidPath` if `fragment` does not follow these rules.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the path.
  pub effect fn join(
    base: &Path,
    fragment: string
  ) -> Path ! FileError | OutOfMemoryError ? &mut Allocator {
    return run Path.joinBytes(base, String.utf8Bytes(fragment))
  }

  /// Returns `base` followed by `/` and `fragment`, where `fragment` is bytes that must be valid
  /// UTF-8.
  ///
  /// # When to use
  ///
  /// Use it for a name that you got as bytes, when the result must have a text view.
  ///
  /// # Errors
  ///
  /// - `FileError` with reason `InvalidPath` if `fragment` is not valid UTF-8, or if it is empty,
  ///   starts or ends with `/`, or contains NUL, empty components, `.`, or `..`.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the path.
  pub effect fn joinUtf8(
    base: &Path,
    fragment: &[u8]
  ) -> Path ! FileError | OutOfMemoryError ? &mut Allocator {
    if validUtf8(fragment) == false { return run rejectPath() }
    return run Path.joinBytes(base, fragment)
  }

  /// Returns `base` followed by `/` and `fragment`. The bytes do not have to be valid UTF-8.
  ///
  /// # When to use
  ///
  /// Use it for a name from a directory listing on the host, to keep the exact bytes.
  ///
  /// # Errors
  ///
  /// - `FileError` with reason `InvalidPath` if `fragment` is empty, starts or ends with `/`, or
  ///   contains NUL, empty components, `.`, or `..`.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the path.
  pub effect fn joinBytes(
    base: &Path,
    fragment: &[u8]
  ) -> Path ! FileError | OutOfMemoryError ? &mut Allocator {
    if validRelativeFragment(fragment) == false { return run rejectPath() }
    let baseBytes = pathBytes(base)
    let mut combined = run appendRange(Bytes.make(), baseBytes, usize.ZERO, baseBytes.length)
    if Path.isRoot(base) == false {
      let slash = run Bytes.append(&mut combined, String.utf8Bytes("/"))
    }
    let beforeChild = Intrinsic.replace(combined, Bytes.make())
    combined = run appendRange(move beforeChild, fragment, usize.ZERO, fragment.length)
    return run finishPath(move combined)
  }

  /// Returns the path that `relativeText` names when you start at `base`.
  ///
  /// # Details
  ///
  /// Each `..` removes one component, `.` and empty text keep the current path, and other
  /// components are added. For example, `"../docs"` from `/workspace/app` gives `/workspace/docs`.
  /// A single trailing `/` is ignored, so `"docs/"` gives the same path as `"docs"`. It only
  /// computes the path. It does not access the file system, so it does not follow links.
  ///
  /// # Errors
  ///
  /// - `FileError` with reason `InvalidPath` if `relativeText` starts with `/`, contains NUL or an
  ///   empty component such as `"a//b"`, or goes above the root.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the path.
  pub effect fn resolve(
    base: &Path,
    relativeText: string
  ) -> Path ! FileError | OutOfMemoryError ? &mut Allocator {
    let relative = String.utf8Bytes(relativeText)
    if containsNul(relative) { return run rejectPath() }
    if usize.ZERO < relative.length {
      if byte(relative[usize.ZERO]) == 47 { return run rejectPath() }
    }
    let baseBytes = pathBytes(base)
    let mut keptBase = componentCount(baseBytes)
    let mut relativeDepth = usize.ZERO
    let mut start = usize.ZERO
    let mut index = usize.ZERO
    while index <= relative.length {
      let mut boundary = false
      if index == relative.length {
        boundary = true
      } else {
        if byte(relative[index]) == 47 { boundary = true }
      }
      if boundary {
        if start == index {
          if index != relative.length { return run rejectPath() }
        } else {
          if isDotDot(relative, start, index) {
            if usize.ZERO < relativeDepth {
              relativeDepth = relativeDepth - usize.ONE
            } else {
              if keptBase == usize.ZERO { return run rejectPath() }
              keptBase = keptBase - usize.ONE
            }
          } else {
            if isDot(relative, start, index) == false {
              relativeDepth = relativeDepth + usize.ONE
            }
          }
        }
        start = index + usize.ONE
      }
      index = index + usize.ONE
    }

    let mut combined = Bytes.make()
    let rooted = run Bytes.append(&mut combined, String.utf8Bytes("/"))
    let mut included = usize.ZERO
    start = usize.ONE
    index = usize.ONE
    while index <= baseBytes.length {
      let mut boundary = false
      if index == baseBytes.length {
        boundary = true
      } else {
        if byte(baseBytes[index]) == 47 { boundary = true }
      }
      if boundary {
        if included < keptBase {
          if usize.ZERO < included {
            let slash = run Bytes.append(&mut combined, String.utf8Bytes("/"))
          }
          let beforeBaseComponent = Intrinsic.replace(combined, Bytes.make())
          combined = run appendRange(move beforeBaseComponent, baseBytes, start, index)
          included = included + usize.ONE
        }
        start = index + usize.ONE
      }
      index = index + usize.ONE
    }

    start = usize.ZERO
    index = usize.ZERO
    while index <= relative.length {
      let mut boundary = false
      if index == relative.length {
        boundary = true
      } else {
        if byte(relative[index]) == 47 { boundary = true }
      }
      if boundary {
        if start < index {
          if isDot(relative, start, index) == false {
            if isDotDot(relative, start, index) == false {
              if survivingRelative(relative, index + usize.ONE) {
                if usize.ZERO < included {
                  let slash = run Bytes.append(&mut combined, String.utf8Bytes("/"))
                }
                let beforeRelativeComponent = Intrinsic.replace(combined, Bytes.make())
                combined = run appendRange(move beforeRelativeComponent, relative, start, index)
                included = included + usize.ONE
              }
            }
          }
        }
        start = index + usize.ONE
      }
      index = index + usize.ONE
    }
    return run finishPath(move combined)
  }

  /// Returns the parent of the path. Returns an absent option for the root.
  ///
  /// # Details
  ///
  /// The parent of a direct child of the root is the root. The result is a new path that does not
  /// borrow `self`.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the path.
  pub effect fn parent(
    self: &Self
  ) -> Option<Path> ! OutOfMemoryError ? &mut Allocator {
    if Path.isRoot(self) { return Option<Path>.none() }
    let values = pathBytes(self)
    let nameStart = finalNameStart(values)
    let mut end = usize.ONE
    if nameStart != usize.ONE { end = nameStart - usize.ONE }
    let copied = run appendRange(Bytes.make(), values, usize.ZERO, end)
    let owned = run finishPath(move copied)
    return Option<Path>.some(move owned)
  }
}

/// Information about a regular file.
pub struct FileInfo {
  /// The length of the file in bytes.
  pub byteLength: usize,
}

/// Information about a directory. It has no fields. The type tells you that the path is a
/// directory.
pub struct DirectoryInfo {}

/// The kind of a directory entry: a file, a directory, or a symbolic link. Compare with
/// [`FileSystem.file`], [`FileSystem.directory`], and [`FileSystem.symbolicLink`].
pub struct DirectoryEntryKind {
  /// The kind code: 0 for a file, 1 for a directory, 2 for a symbolic link.
  pub code: i32,
}

/// One child in a directory listing.
pub struct DirectoryEntry {
  /// The full path of the child. The entry owns it.
  pub path: Path,
  /// The kind of the child.
  pub kind: DirectoryEntryKind,
}

/// The operation that failed, as recorded in a [`FileError`]. Compare its code with the
/// constructors such as [`FileSystem.readFileOperation`].
pub struct FileOperation {
  /// The operation code.
  pub code: i32,
}

impl Debug for FileOperation {
  /// Writes the name of the code, such as `ReadFile`, or the code when it has no name.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match fileOperationName(self.code) {
      Option<string<'static>>.Some { value } => run Format.writeText(&mut formatter, value)
      Option<string<'static>>.None => run Format.debugFields(self, "FileOperation", &mut formatter)
    }
  }
}

// The name of a `FileOperation` code, in the form of a variant name.
fn fileOperationName(code: i32) -> Option<string<'static>> {
  if code == 0 { return Option<string<'static>>.some("ReadFile") }
  if code == 1 { return Option<string<'static>>.some("WriteFile") }
  if code == 2 { return Option<string<'static>>.some("Stat") }
  if code == 3 { return Option<string<'static>>.some("ListDirectory") }
  if code == 4 { return Option<string<'static>>.some("CreateDirectory") }
  if code == 5 { return Option<string<'static>>.some("RemoveFile") }
  if code == 6 { return Option<string<'static>>.some("RemoveDirectory") }
  if code == 7 { return Option<string<'static>>.some("Path") }
  if code == 8 { return Option<string<'static>>.some("CreateTemporaryDirectory") }
  if code == 9 { return Option<string<'static>>.some("CreateFile") }
  if code == 10 { return Option<string<'static>>.some("WriteFileAtomic") }
  if code == 11 { return Option<string<'static>>.some("SyncFile") }
  if code == 12 { return Option<string<'static>>.some("SyncDirectory") }
  return Option<string<'static>>.none()
}

/// The portable reason for a [`FileError`]. Compare its code with the constructors such as
/// [`FileSystem.notFound`].
pub struct FileReason {
  /// The reason code.
  pub code: i32,
}

impl Debug for FileReason {
  /// Writes the name of the code, such as `NotFound`, or the code when it has no name.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return match fileReasonName(self.code) {
      Option<string<'static>>.Some { value } => run Format.writeText(&mut formatter, value)
      Option<string<'static>>.None => run Format.debugFields(self, "FileReason", &mut formatter)
    }
  }
}

// The name of a `FileReason` code, in the form of a variant name.
fn fileReasonName(code: i32) -> Option<string<'static>> {
  if code == 0 { return Option<string<'static>>.some("NotFound") }
  if code == 1 { return Option<string<'static>>.some("AlreadyExists") }
  if code == 2 { return Option<string<'static>>.some("PermissionDenied") }
  if code == 3 { return Option<string<'static>>.some("InvalidPath") }
  if code == 4 { return Option<string<'static>>.some("WrongType") }
  if code == 5 { return Option<string<'static>>.some("NotEmpty") }
  if code == 6 { return Option<string<'static>>.some("NoSpace") }
  if code == 7 { return Option<string<'static>>.some("TooLarge") }
  if code == 8 { return Option<string<'static>>.some("Unsupported") }
  if code == 9 { return Option<string<'static>>.some("Other") }
  return Option<string<'static>>.none()
}

/// The error from a file system operation.
///
/// # Details
///
/// Decide how to recover from `reason`, for example with `FileSystem.reasonCode(error.reason) ==
/// FileSystem.reasonCode(FileSystem.notFound())`. The provider code from
/// [`FileSystem.providerCode`] is for diagnostics only, because it is different on each host.
pub struct FileError {
  /// The operation that failed.
  pub operation: FileOperation,
  /// The portable reason. Use it to decide how to recover.
  pub reason: FileReason,
  providerCodeValue: i32,
  hasProviderCode: bool,
}

impl Debug for FileError {
  /// Writes the fields, as `FileError { operation: ReadFile, reason: NotFound, providerCode: 2 }`.
  /// It leaves out `providerCode` when there is none.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    let mut record = run Format.debugRecord("FileError", &mut formatter)
    run Format.debugField(&mut record, "operation", &self.operation, &mut formatter)
    run Format.debugField(&mut record, "reason", &self.reason, &mut formatter)
    if self.hasProviderCode {
      run Format.debugField(&mut record, "providerCode", &self.providerCodeValue, &mut formatter)
    }
    return run Format.debugFinish(record, &mut formatter)
  }
}

/// What [`FileSystem.writeFileAtomic`] does when the destination exists.
///
/// # Details
///
/// Make one with [`FileSystem.replaceExisting`] or [`FileSystem.createNew`].
pub struct PublicationPolicy {
  /// 0 replaces an existing destination. 1 fails if the destination exists.
  pub code: i32,
}

/// If [`FileSystem.writeFileAtomic`] synchronizes the data to storage.
///
/// # Details
///
/// Make one with [`FileSystem.buffered`] or [`FileSystem.synchronized`].
pub struct Durability {
  /// 0 does not synchronize. 1 synchronizes the file before it becomes visible and the directory
  /// after.
  pub code: i32,
}

/// The error from [`FileSystem.writeFileAtomic`].
///
/// # Details
///
/// If `published` is `false`, the destination did not change. If `published` is `true`, the new
/// contents are visible, but a later step failed, such as a synchronization or the removal of the
/// temporary file.
///
/// # Gotchas
///
/// Do not retry a write that has `published` set to `true`. With the create-new policy, the retry
/// fails with `AlreadyExists`, because the first write created the file.
pub struct AtomicWriteError {
  /// `true` if the new contents became visible at the destination.
  pub published: bool,
  /// The first failure.
  pub cause: FileError,
  /// A second failure when the temporary file could not be removed, if one happened.
  pub cleanupError: Option<FileError>,
  /// The name of the temporary file that is still in the destination directory if the removal
  /// failed. Empty otherwise.
  pub stagingName: Bytes,
}

impl Debug for AtomicWriteError {
  /// Writes the fields, as `AtomicWriteError { published: ..., cause: ..., ... }`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    return run Format.debugFields(self, "AtomicWriteError", &mut formatter)
  }
}

/// Reads the stable directory-entry kind code through a borrow.
fn borrowedKindCode(kind: &DirectoryEntryKind) -> i32 { return kind.code }

effect fn raise(error: FileError) -> never ! FileError { fail move error }

effect fn rejectPath() -> never ! FileError {
  fail FileSystem.error(FileSystem.pathOperation(), FileSystem.invalidPath())
}

fn byte(value: u8) -> i32 { return u8.toI32(value) }

fn containsNul(values: &[u8]) -> bool {
  let mut index = usize.ZERO
  while index < values.length {
    if values[index] == u8.toU8(0) { return true }
    index = index + usize.ONE
  }
  return false
}

// Borrows bytes as text when they are valid UTF-8.
fn utf8View(values: &[u8]) -> Option<string> {
  return match move String.fromUtf8(values) {
    Result<string, InvalidUtf8>.Success { value: text } => Option<string>.some(text)
    Result<string, InvalidUtf8>.Failure { error: invalid } => Option<string>.none()
  }
}

fn validUtf8(values: &[u8]) -> bool {
  let decoded = String.fromUtf8(values)
  return match move decoded {
    Result<string, InvalidUtf8>.Success { value: text } => true
    Result<string, InvalidUtf8>.Failure { error: invalid } => false
  }
}

fn isDot(values: &[u8], start: usize, end: usize) -> bool {
  if end - start != usize.ONE { return false }
  return byte(values[start]) == 46
}

fn isDotDot(values: &[u8], start: usize, end: usize) -> bool {
  if end - start != 2 { return false }
  if byte(values[start]) != 46 { return false }
  return byte(values[start + usize.ONE]) == 46
}

fn validAbsolute(values: &[u8]) -> bool {
  if values.length == usize.ZERO { return false }
  if byte(values[usize.ZERO]) != 47 { return false }
  if containsNul(values) { return false }
  if values.length == usize.ONE { return true }
  let mut start = usize.ONE
  let mut index = usize.ONE
  while index <= values.length {
    if index == values.length {
      if start == index { return false }
      if isDot(values, start, index) { return false }
      if isDotDot(values, start, index) { return false }
      return true
    }
    if byte(values[index]) == 47 {
      if start == index { return false }
      if isDot(values, start, index) { return false }
      if isDotDot(values, start, index) { return false }
      start = index + usize.ONE
    }
    index = index + usize.ONE
  }
  return false
}

fn validRelativeFragment(values: &[u8]) -> bool {
  if values.length == usize.ZERO { return false }
  if byte(values[usize.ZERO]) == 47 { return false }
  if containsNul(values) { return false }
  let mut start = usize.ZERO
  let mut index = usize.ZERO
  while index <= values.length {
    if index == values.length {
      if start == index { return false }
      if isDot(values, start, index) { return false }
      if isDotDot(values, start, index) { return false }
      return true
    }
    if byte(values[index]) == 47 {
      if start == index { return false }
      if isDot(values, start, index) { return false }
      if isDotDot(values, start, index) { return false }
      start = index + usize.ONE
    }
    index = index + usize.ONE
  }
  return false
}

effect fn appendRange(
  target: Bytes,
  source: &[u8],
  start: usize,
  end: usize
) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  let mut result = move target
  let mut index = start
  while index < end {
    let one = [source[index]]
    let appended = run Bytes.append(&mut result, &one)
    index = index + usize.ONE
  }
  return move result
}

fn finalNameStart(values: &[u8]) -> usize {
  if values.length == usize.ONE { return usize.ONE }
  let mut index = values.length
  while usize.ZERO < index {
    index = index - usize.ONE
    if byte(values[index]) == 47 { return index + usize.ONE }
  }
  return usize.ZERO
}

effect fn finishPath(bytes: Bytes) -> Path ! OutOfMemoryError ? &mut Allocator {
  let view = Bytes.asSlice(&bytes)
  let start = finalNameStart(view)
  let nameBytes = run appendRange(Bytes.make(), view, start, view.length)
  return Path { bytes: move bytes, nameBytes: move nameBytes }
}

fn pathBytes(self: &Path) -> &[u8] { return Bytes.asSlice(&self.bytes) }

fn componentCount(values: &[u8]) -> usize {
  if values.length == usize.ONE { return usize.ZERO }
  let mut count = usize.ONE
  let mut index = usize.ONE
  while index < values.length {
    if byte(values[index]) == 47 { count = count + usize.ONE }
    index = index + usize.ONE
  }
  return count
}

fn survivingRelative(values: &[u8], after: usize) -> bool {
  let mut depth = usize.ONE
  let mut start = after
  let mut index = after
  while index <= values.length {
    let mut boundary = false
    if index == values.length {
      boundary = true
    } else {
      if byte(values[index]) == 47 { boundary = true }
    }
    if boundary {
      if start < index {
        if isDotDot(values, start, index) {
          depth = depth - usize.ONE
          if depth == usize.ZERO { return false }
        } else {
          if isDot(values, start, index) == false { depth = depth + usize.ONE }
        }
      }
      start = index + usize.ONE
    }
    index = index + usize.ONE
  }
  return true
}

/// The effect for file system operations: whole-file reads and writes, atomic writes, directory
/// listings, and temporary directories.
///
/// # When to use
///
/// Make a [`Path`], then require `&mut FileSystem` and call [`FileSystem.readFile`],
/// [`FileSystem.writeFile`], and the other operations. Use [`FileSystem.writeFileAtomic`] when a
/// reader must never see a partly written file, such as for a configuration file. Use
/// [`FileSystem.temporaryDirectory`] for scratch space.
///
/// # Details
///
/// Provide one with `Effect.provideMut<FileSystem>(&mut provider)`. Native programs use
/// `silk.system.filesystem_native`. Each provider must use the portable error reasons, replace the whole file
/// on [`FileSystem.writeFile`], and sort directory listings by path bytes, so they are the same on
/// each host.
///
/// # Errors
///
/// - [`FileError`] for each failed operation. It has the operation, a portable reason, and an
///   optional code from the provider. Recover by the reason: `NotFound`, `AlreadyExists`,
///   `PermissionDenied`, `InvalidPath`, `WrongType`, `NotEmpty`, `NoSpace`, `TooLarge`,
///   `Unsupported`, or `Other`.
/// - [`AtomicWriteError`] from [`FileSystem.writeFileAtomic`].
/// - `OutOfMemoryError` from operations that return owned paths or bytes.
///
/// # Gotchas
///
/// A temporary directory is not removed when it is dropped. Call [`FileSystem.release`] or
/// [`FileSystem.releaseIgnored`]. Operations on more than one path, such as
/// [`FileSystem.writeFileWithParents`], are not transactions. A failure can leave part of the work
/// done.
pub service FileSystem {
  /// Returns a copy of the contents of the regular file at `path`.
  ///
  /// # Errors
  ///
  /// - `FileError` with reason `NotFound`, `PermissionDenied`, or `WrongType` (for a directory), or
  ///   another reason from the provider.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the contents.
  effect fn readFile(
    path: &Path
  ) -> Bytes ! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator
  /// Writes `bytes` to the file at `path`. It creates the file, or replaces all of the contents of
  /// an existing file.
  ///
  /// # Errors
  ///
  /// - `FileError` with reason `NotFound` if the parent directory does not exist, `WrongType` if
  ///   `path` is a directory, or another reason from the provider.
  ///
  /// # Gotchas
  ///
  /// It does not create parent directories. Use [`FileSystem.writeFileWithParents`] for that. A
  /// reader can see the file while it is partly written. Use [`FileSystem.writeFileAtomic`] if that
  /// is a problem.
  effect fn writeFile(path: &Path, bytes: &[u8]) -> () ! FileError ? &mut FileSystem
  /// Creates a new file at `path` with the contents `bytes`. It never replaces an existing entry.
  ///
  /// # Details
  ///
  /// The check that the name is free and the creation are one atomic step. It does not follow a
  /// symbolic link at `path`.
  ///
  /// # Errors
  ///
  /// - `FileError` with reason `AlreadyExists` if any entry exists at `path`.
  /// - `FileError` with another reason if the write or close fails. The new file stays, and it can
  ///   be incomplete.
  ///
  /// # Gotchas
  ///
  /// A reader can see the file while it is partly written. To create a file that appears only when
  /// it is complete, use [`FileSystem.writeFileAtomic`] with [`FileSystem.createNew`].
  effect fn createFile(path: &Path, bytes: &[u8]) -> () ! FileError ? &mut FileSystem
  /// Writes `bytes` to `path` so that a reader sees either the old contents or all of the new
  /// contents, never a partial file.
  ///
  /// # Details
  ///
  /// The provider writes a temporary file in the same directory and then renames it to `path` in
  /// one step. With [`FileSystem.replaceExisting`], it replaces a regular file or creates a missing
  /// one. A native provider replaces a symbolic link itself, not its target. With
  /// [`FileSystem.createNew`], it fails if any entry exists, and the check is part of the atomic
  /// rename.
  ///
  /// With [`FileSystem.synchronized`], the provider synchronizes the temporary file before the
  /// rename and the directory after it. This is normal file system synchronization. It does not
  /// protect against hardware caches that lose data at power loss.
  ///
  /// A native provider creates a new file with mode `0666` minus the process umask. The new file
  /// does not keep the mode, owner, ACLs, extended attributes, or hard links of the old file.
  ///
  /// # Errors
  ///
  /// - `AtomicWriteError` with `published` set to `false` if the write failed before the rename.
  ///   The destination did not change.
  /// - `AtomicWriteError` with `published` set to `true` if a step after the rename failed.
  /// - The cause has reason `WrongType` if `path` is a directory, `AlreadyExists` for create-new
  ///   when the destination exists, or `Unsupported` if the provider cannot give the requested
  ///   guarantees. A provider never falls back to a normal write.
  ///
  /// # Gotchas
  ///
  /// It makes one file visible atomically. It is not a transaction across more than one file.
  effect fn writeFileAtomic(
    path: &Path,
    bytes: &[u8],
    policy: PublicationPolicy,
    durability: Durability
  ) -> () ! AtomicWriteError ? &mut FileSystem
  /// Synchronizes the directory at `path`, so that entries created or removed in it are on storage.
  ///
  /// # When to use
  ///
  /// After you create or remove an entry, synchronize its parent directory. After you create a
  /// directory, synchronize its parent too. This does not synchronize the contents of files.
  ///
  /// # Errors
  ///
  /// - `FileError` with reason `Unsupported` if the provider cannot synchronize directories, or
  ///   another reason from the provider.
  effect fn syncDirectory(path: &Path) -> () ! FileError ? &mut FileSystem
  /// Returns [`FileInfo`] for a regular file or [`DirectoryInfo`] for a directory. It does not open
  /// the file.
  ///
  /// # Errors
  ///
  /// - `FileError` with reason `NotFound` if nothing exists at `path`, or another reason from the
  ///   provider. It does not fail with `WrongType`.
  effect fn stat(path: &Path) -> FileInfo | DirectoryInfo ! FileError ? &mut FileSystem
  /// Returns the direct children of the directory at `path`, sorted by path bytes.
  ///
  /// # Details
  ///
  /// The listing does not include children of children. Each entry owns its path, so you can keep
  /// it after you drop the list. An entry that is a symbolic link has the kind
  /// [`FileSystem.symbolicLink`], whatever it points to.
  ///
  /// # Errors
  ///
  /// - `FileError` with reason `NotFound`, `WrongType` (for a file), or another reason from the
  ///   provider.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the list.
  effect fn listDirectory(
    path: &Path
  ) -> List<DirectoryEntry> ! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator
  /// Creates the directory `path`. Its parent must exist.
  ///
  /// # Errors
  ///
  /// - `FileError` with reason `AlreadyExists` if an entry exists at `path`, or `NotFound` if the
  ///   parent does not exist. To create the missing parents too, use
  ///   [`FileSystem.createDirectoriesRecursively`].
  effect fn createDirectory(path: &Path) -> () ! FileError ? &mut FileSystem
  /// Removes the regular file or symbolic link at `path`. A link is removed itself, not what it
  /// points to.
  ///
  /// # Errors
  ///
  /// - `FileError` with reason `NotFound`, `WrongType` (for a directory), or another reason from
  ///   the provider.
  effect fn removeFile(path: &Path) -> () ! FileError ? &mut FileSystem
  /// Removes the empty directory at `path`.
  ///
  /// # Errors
  ///
  /// - `FileError` with reason `NotEmpty` if the directory has entries. To remove it with all of
  ///   its contents, use [`FileSystem.removeDirectoryRecursively`].
  effect fn removeDirectory(path: &Path) -> () ! FileError ? &mut FileSystem
  /// Creates a new directory in `parent` with a unique name that starts with `prefix`, and returns
  /// its path.
  ///
  /// # Details
  ///
  /// The provider chooses the rest of the name and creates the directory in one step, so no other
  /// process can take the same name. Most code uses [`FileSystem.temporaryDirectory`] instead.
  ///
  /// # Errors
  ///
  /// - `FileError` if the provider cannot create the directory.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the path.
  effect fn createTemporaryDirectory(
    parent: &Path,
    prefix: &[u8]
  ) -> Path ! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator
}

impl FileSystem {
  /// Returns the policy that replaces an existing destination or creates a missing one.
  pub fn replaceExisting() -> PublicationPolicy { return PublicationPolicy { code: 0 } }

  /// Returns the policy that fails with `AlreadyExists` if the destination exists.
  pub fn createNew() -> PublicationPolicy { return PublicationPolicy { code: 1 } }

  /// Returns the durability that makes the new file visible atomically but does not synchronize it
  /// to storage.
  pub fn buffered() -> Durability { return Durability { code: 0 } }

  /// Returns the durability that synchronizes the file before it becomes visible and the directory
  /// after.
  pub fn synchronized() -> Durability { return Durability { code: 1 } }

  /// Constructs the regular-file [`DirectoryEntryKind`].
  pub fn file() -> DirectoryEntryKind { return DirectoryEntryKind { code: 0 } }

  /// Constructs the directory [`DirectoryEntryKind`].
  pub fn directory() -> DirectoryEntryKind { return DirectoryEntryKind { code: 1 } }

  /// Constructs the symbolic-link [`DirectoryEntryKind`]. A listing reports a link itself, not
  /// what it points to, so a walk of the tree does not follow it.
  pub fn symbolicLink() -> DirectoryEntryKind { return DirectoryEntryKind { code: 2 } }

  /// Returns the code of `kind`: 0 for a file, 1 for a directory, 2 for a symbolic link.
  pub fn entryKindCode(kind: DirectoryEntryKind) -> i32 { return kind.code }

  /// Returns [`FileInfo`] for a file of `byteLength` bytes. Providers use it.
  pub fn fileInfo(byteLength: usize) -> FileInfo {
    return FileInfo { byteLength: byteLength }
  }

  /// Returns [`DirectoryInfo`]. Providers use it.
  pub fn directoryInfo() -> DirectoryInfo { return DirectoryInfo {} }

  /// Returns a [`DirectoryEntry`] that owns `path`. Providers use it.
  pub fn directoryEntry(path: Path, kind: DirectoryEntryKind) -> DirectoryEntry {
    return DirectoryEntry { path: move path, kind: move kind }
  }

  /// Selects the read-file operation.
  pub fn readFileOperation() -> FileOperation { return FileOperation { code: 0 } }

  /// Selects the write-file operation.
  pub fn writeFileOperation() -> FileOperation { return FileOperation { code: 1 } }

  /// Selects the stat operation.
  pub fn statOperation() -> FileOperation { return FileOperation { code: 2 } }

  /// Selects the list-directory operation.
  pub fn listDirectoryOperation() -> FileOperation { return FileOperation { code: 3 } }

  /// Selects the create-directory operation.
  pub fn createDirectoryOperation() -> FileOperation { return FileOperation { code: 4 } }

  /// Selects the remove-file operation.
  pub fn removeFileOperation() -> FileOperation { return FileOperation { code: 5 } }

  /// Selects the remove-directory operation.
  pub fn removeDirectoryOperation() -> FileOperation { return FileOperation { code: 6 } }

  /// Selects path construction and resolution.
  pub fn pathOperation() -> FileOperation { return FileOperation { code: 7 } }

  /// Selects the create-temporary-directory operation.
  pub fn createTemporaryDirectoryOperation() -> FileOperation { return FileOperation { code: 8 } }

  /// Selects exclusive regular-file creation.
  pub fn createFileOperation() -> FileOperation { return FileOperation { code: 9 } }

  /// Selects atomic whole-file publication.
  pub fn writeFileAtomicOperation() -> FileOperation { return FileOperation { code: 10 } }

  /// Selects synchronization of an owned file descriptor.
  pub fn syncFileOperation() -> FileOperation { return FileOperation { code: 11 } }

  /// Selects directory synchronization.
  pub fn syncDirectoryOperation() -> FileOperation { return FileOperation { code: 12 } }

  /// Returns the code of `operation`.
  pub fn operationCode(operation: FileOperation) -> i32 { return operation.code }

  /// Constructs the `NotFound` recovery reason.
  pub fn notFound() -> FileReason { return FileReason { code: 0 } }

  /// Constructs the `AlreadyExists` recovery reason.
  pub fn alreadyExists() -> FileReason { return FileReason { code: 1 } }

  /// Constructs the `PermissionDenied` recovery reason.
  pub fn permissionDenied() -> FileReason { return FileReason { code: 2 } }

  /// Constructs the `InvalidPath` recovery reason.
  pub fn invalidPath() -> FileReason { return FileReason { code: 3 } }

  /// Constructs the `WrongType` recovery reason.
  pub fn wrongType() -> FileReason { return FileReason { code: 4 } }

  /// Constructs the `NotEmpty` recovery reason.
  pub fn notEmpty() -> FileReason { return FileReason { code: 5 } }

  /// Constructs the `NoSpace` recovery reason.
  pub fn noSpace() -> FileReason { return FileReason { code: 6 } }

  /// Constructs the `TooLarge` recovery reason.
  pub fn tooLarge() -> FileReason { return FileReason { code: 7 } }

  /// Constructs the `Unsupported` recovery reason.
  pub fn unsupported() -> FileReason { return FileReason { code: 8 } }

  /// Returns the `Other` reason, for a failure that has no portable reason.
  pub fn other() -> FileReason { return FileReason { code: 9 } }

  /// Returns the code of `reason`. Compare it with the code of a reason constructor, such as
  /// `FileSystem.reasonCode(FileSystem.notFound())`.
  pub fn reasonCode(reason: FileReason) -> i32 { return reason.code }

  /// Returns a [`FileError`] with no provider code. Providers use it.
  pub fn error(operation: FileOperation, reason: FileReason) -> FileError {
    return FileError {
      operation: move operation,
      reason: move reason,
      providerCodeValue: 0,
      hasProviderCode: false,
    }
  }

  /// Returns a [`FileError`] with a provider code, such as an `errno` value. Providers use it.
  ///
  /// # Details
  ///
  /// The code is for diagnostics. Callers decide how to recover from `operation` and `reason`.
  pub fn errorWithCode(operation: FileOperation, reason: FileReason, code: i32) -> FileError {
    return FileError {
      operation: move operation,
      reason: move reason,
      providerCodeValue: code,
      hasProviderCode: true,
    }
  }

  /// Returns the provider code of `error`, if it has one.
  pub fn providerCode(error: &FileError) -> Option<i32> {
    if error.hasProviderCode { return Option<i32>.some(error.providerCodeValue) }
    return Option<i32>.none()
  }

  /// Creates a new directory in `parent` with a unique name that starts with `prefix`, and returns
  /// its owner.
  ///
  /// # Details
  ///
  /// Nothing removes the directory until you call [`FileSystem.release`] or
  /// [`FileSystem.releaseIgnored`]. Dropping the owner does not remove it.
  ///
  /// # Errors
  ///
  /// - `FileError` if the provider cannot create the directory.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the path.
  pub effect fn temporaryDirectory(
    parent: &Path,
    prefix: string
  ) -> TemporaryDirectory ! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
    let created = run FileSystem.createTemporaryDirectory(parent, String.utf8Bytes(prefix))
    return TemporaryDirectory { path: move created }
  }

  /// Removes the temporary directory and everything in it.
  ///
  /// # When to use
  ///
  /// Use `release` when you must know if the removal failed. Use [`FileSystem.releaseIgnored`] as a
  /// finalizer with `Effect.ensuring`.
  ///
  /// # Errors
  ///
  /// - `FileError` if a removal fails. Some files can be removed already.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the storage for the walk.
  ///
  /// # Gotchas
  ///
  /// `self` is consumed also when the removal fails. Copy the path first if you need it to report
  /// the failure.
  pub effect fn release(
    self: TemporaryDirectory
  ) -> () ! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
    let owned = move self
    let removed = run FileSystem.removeDirectoryRecursively(&owned.path)
    drop owned
    return ()
  }

  /// Removes the temporary directory and everything in it, and ignores a failure.
  ///
  /// # When to use
  ///
  /// Use it with `Effect.ensuring`, which needs a finalizer that cannot fail. Use
  /// [`FileSystem.release`] when you must know if the removal failed.
  ///
  /// # Gotchas
  ///
  /// The finalizer consumes the directory, so the protected code cannot borrow it. Get the paths
  /// that the protected code needs before you pass the owner to the finalizer.
  pub effect fn releaseIgnored(
    self: TemporaryDirectory
  ) -> () ? &mut FileSystem | &mut Allocator {
    return run Effect.catchAll(FileSystem.release(move self), discardReleaseFailure)
  }

  /// Removes the directory at `path`, all files in it, and all directories in it.
  ///
  /// # Details
  ///
  /// It removes the files first and then the directories, deepest first. It does not recurse, so a
  /// deep tree uses list memory, not stack. A symbolic link in the tree is removed itself; what it
  /// points to stays.
  ///
  /// # Errors
  ///
  /// - `FileError` if a removal fails.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the storage for the walk.
  ///
  /// # Gotchas
  ///
  /// It is not a transaction. If it fails, the removals that completed stay completed, and the rest
  /// of the tree stays.
  pub effect fn removeDirectoryRecursively(
    path: &Path
  ) -> () ! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
    let mut recorded = List<Path>.make()
    let seed = run Path.fromBytes(Path.rawBytes(path))
    let noted = run List<Path>.append(&mut recorded, move seed)
    let mut index = usize.ZERO
    while index < List<Path>.length(&recorded) {
      let current = run recordedCopy(&recorded, index)
      let entries = run FileSystem.listDirectory(&current)
      let listed = List<DirectoryEntry>.asSlice(&entries)
      let mut cursor = usize.ZERO
      while cursor < listed.length {
        let childKind = match &listed[cursor] {
          DirectoryEntry { path: childPath, kind: childEntryKind } => borrowedKindCode(&childEntryKind)
        }
        if childKind != 1 {
          let unlinked = match &listed[cursor] {
            DirectoryEntry { path: childPath, kind: childEntryKind } =>
              run FileSystem.removeFile(&childPath)
          }
        } else {
          let toRemove = match &listed[cursor] {
            DirectoryEntry { path: childPath, kind: childEntryKind } =>
              run Path.fromBytes(Path.rawBytes(&childPath))
          }
          let notedChild = run List<Path>.append(&mut recorded, move toRemove)
        }
        cursor = cursor + usize.ONE
      }
      index = index + usize.ONE
    }
    while usize.ZERO < List<Path>.length(&recorded) {
      let taken = List<Path>.pop(&mut recorded)
      let emptied = match move taken {
        Option<Path>.Some { value: selected } => move selected
        Option<Path>.None => run Path.fromBytes(Path.rawBytes(path))
      }
      let removed = run FileSystem.removeDirectory(&emptied)
    }
    return ()
  }

  /// Creates the directory `path` and each missing parent. Existing directories are kept.
  ///
  /// # Errors
  ///
  /// - `FileError` with reason `WrongType` if a component is a regular file, or another reason from
  ///   the provider.
  ///
  /// # Gotchas
  ///
  /// It checks and then creates each component. If another process changes the same directories at
  /// the same time, the result depends on the provider.
  pub effect fn createDirectoriesRecursively(
    path: &Path
  ) -> () ! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
    let values = pathBytes(path)
    let mut index = usize.ONE
    while index <= values.length {
      let mut boundary = false
      if index == values.length {
        boundary = true
      } else {
        if byte(values[index]) == 47 { boundary = true }
      }
      if boundary {
        let prefixBytes = run appendRange(Bytes.make(), values, usize.ZERO, index)
        let prefix = run finishPath(move prefixBytes)
        let completed = run Effect.result(statForResult(&prefix))
        let decision = classifyDirectory(move completed)
        let ensured = match move decision {
          DirectoryPresent {} => ()
          DirectoryMissing {} => run createMissingDirectory(&prefix)
          DirectoryWrongType {} => run raise(FileSystem.error(FileSystem.statOperation(), FileSystem.wrongType()))
          DirectoryStatFailure { error: failure } => run raise(move failure)
        }
      }
      index = index + usize.ONE
    }
    return ()
  }

  /// Creates the missing parent directories of `path` and then writes `bytes` to it with
  /// [`FileSystem.writeFile`].
  ///
  /// # Errors
  ///
  /// - `FileError` from the directory creation or the write. For the root path, the write normally
  ///   fails with `WrongType`.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the parent paths.
  ///
  /// # Gotchas
  ///
  /// It is not a transaction. If the write fails, the new parent directories stay.
  pub effect fn writeFileWithParents(
    path: &Path,
    bytes: &[u8]
  ) -> () ! FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
    if Path.isRoot(path) { return run FileSystem.writeFile(path, bytes) }
    let pathValues = pathBytes(path)
    let nameStart = finalNameStart(pathValues)
    let mut parentEnd = usize.ONE
    if nameStart != usize.ONE { parentEnd = nameStart - usize.ONE }
    let parentBytes = run appendRange(Bytes.make(), pathValues, usize.ZERO, parentEnd)
    let ownedParent = run finishPath(move parentBytes)
    let values = pathBytes(&ownedParent)
    let mut index = usize.ONE
    while index <= values.length {
      let mut boundary = false
      if index == values.length {
        boundary = true
      } else {
        if byte(values[index]) == 47 { boundary = true }
      }
      if boundary {
        let prefixBytes = run appendRange(Bytes.make(), values, usize.ZERO, index)
        let prefix = run finishPath(move prefixBytes)
        let completed = run Effect.result(statForResult(&prefix))
        let decision = classifyDirectory(move completed)
        let ensured = match move decision {
          DirectoryPresent {} => ()
          DirectoryMissing {} => run createMissingDirectory(&prefix)
          DirectoryWrongType {} => run raise(FileSystem.error(FileSystem.statOperation(), FileSystem.wrongType()))
          DirectoryStatFailure { error: failure } => run raise(move failure)
        }
      }
      index = index + usize.ONE
    }
    return run FileSystem.writeFile(path, bytes)
  }

  /// Returns `true` if a file or directory exists at `path`.
  ///
  /// # Errors
  ///
  /// - `FileError` for each failure other than `NotFound`, such as `PermissionDenied`. So a path
  ///   that you cannot access does not look like a missing path.
  pub effect fn exists(path: &Path) -> bool ! FileError ? &mut FileSystem {
    let completed = run Effect.result(statForResult(path))
    return match move completed {
      Result<FileInfo | DirectoryInfo, FileError>.Success { value: info } => true
      Result<FileInfo | DirectoryInfo, FileError>.Failure { error: failure } => run existsFailure(move failure)
    }
  }
}

/// A directory that you own, with everything in it. Make one with
/// [`FileSystem.temporaryDirectory`].
///
/// # Details
///
/// Dropping it does not remove the directory, because removal can fail and needs the `FileSystem`
/// effect. Call [`FileSystem.release`] to remove it. To remove it when a computation ends in any
/// way, use `Effect.ensuring` with [`FileSystem.releaseIgnored`].
pub struct TemporaryDirectory {
  /// The path of the directory.
  pub path: Path,
}

effect fn discardReleaseFailure(error: FileError | OutOfMemoryError) -> () { return () }

/// Copies one recorded Path out of the walk's own record.
///
/// The walk appends to the same record it is reading, so it reads through a copy rather than
/// through a borrow that the next append would invalidate.
effect fn recordedCopy(
  recorded: &List<Path>,
  index: usize
) -> Path ! FileError | OutOfMemoryError ? &mut Allocator {
  return match &List<Path>.asSlice(recorded)[index] {
    Path { bytes, nameBytes } => run Path.fromBytes(Bytes.asSlice(&bytes))
  }
}

struct DirectoryPresent {}
struct DirectoryMissing {}
struct DirectoryWrongType {}
struct DirectoryStatFailure { error: FileError }

fn classifyStatFailure(
  failure: FileError
) -> DirectoryMissing | DirectoryStatFailure {
  if failure.reason.code == 0 { return DirectoryMissing {} }
  return DirectoryStatFailure { error: move failure }
}

fn classifyDirectory(
  outcome: Result<FileInfo | DirectoryInfo, FileError>
) -> DirectoryPresent | DirectoryMissing | DirectoryWrongType | DirectoryStatFailure {
  return match move outcome {
    Result<FileInfo | DirectoryInfo, FileError>.Success { value: info } => match move info {
      DirectoryInfo {} => DirectoryPresent {}
      FileInfo { byteLength } => DirectoryWrongType {}
    }
    Result<FileInfo | DirectoryInfo, FileError>.Failure { error: failure } => classifyStatFailure(move failure)
  }
}

fn retainStatInfo(info: FileInfo | DirectoryInfo) -> FileInfo | DirectoryInfo {
  return move info
}

// Creates the directory at `path`, found missing. Another process can create it in between, which
// leaves the directory wanted.
effect fn createMissingDirectory(path: &Path) -> () ! FileError ? &mut FileSystem {
  let created = run Effect.result(FileSystem.createDirectory(path))
  match move created {
    Result<(), FileError>.Success {value: _} => {}
    Result<(), FileError>.Failure {error} => {
      if error.reason.code != FileSystem.alreadyExists().code { run raise(move error) }
      let rechecked = run Effect.result(statForResult(path))
      match move classifyDirectory(move rechecked) {
        DirectoryPresent {} => {}
        DirectoryMissing {} => run raise(move error)
        DirectoryWrongType {} => run raise(move error)
        DirectoryStatFailure { error: failure } => {
          drop failure
          run raise(move error)
        }
      }
    }
  }
  return ()
}

effect fn statForResult(
  path: &Path
) -> FileInfo | DirectoryInfo ! FileError ? &mut FileSystem {
  let info = run FileSystem.stat(path)
  return retainStatInfo(move info)
}

effect fn existsFailure(failure: FileError) -> bool ! FileError {
  if failure.reason.code == 0 { return false }
  return run raise(move failure)
}

