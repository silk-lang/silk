//! Exclusive advisory file locks released automatically with their owning handle.

import silk.collections.bytes { Bytes }
import silk.core.ownership { Drop }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.mem.pointer { Pointer }
import silk.system.filesystem { FileError, FileSystem, Path }

static if Intrinsic.targetOperatingSystem() == "linux" || Intrinsic.targetOperatingSystem() == "darwin" {
  @foreign(noCapture: .("path"))
  unsafe extern "C" fn open(path: ?[*]const u8, flags: i32, ...) -> i32
  unsafe extern "C" fn close(fd: i32) -> i32
  unsafe extern "C" fn flock(fd: i32, operation: i32) -> i32
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    unsafe extern "C" fn __error() -> *mut i32
    fn errorCode() -> i32 { unsafe { return Pointer.read<i32>(__error()) } }
    const CREATE: i32 = 512
    const CLOEXEC: i32 = 16777216
  } else {
    unsafe extern "C" fn __errno_location() -> *mut i32
    fn errorCode() -> i32 { unsafe { return Pointer.read<i32>(__errno_location()) } }
    const CREATE: i32 = 64
    const CLOEXEC: i32 = 524288
  }

  /// Owns an exclusive advisory lock. Dropping it releases the lock; the lock file remains.
  pub struct FileLock {descriptor: i32}
  impl Drop for FileLock {
    fn drop(self: &mut Self) -> () { let _closed = unsafe close(self.descriptor) }
  }
  impl FileLock {
    /// Creates or opens the lock file and waits for its exclusive lock.
    /// The parent directory must exist. All participants must lock the same persistent file.
    pub effect fn exclusive(path: &Path) -> Self ! FileError | OutOfMemoryError ? &mut Allocator {
      let mut terminated = run Bytes.copy(Path.rawBytes(path))
      run terminated.append(&[0])
      let descriptor = unsafe open(Pointer.fromSlice<u8>(terminated.asSlice()), 2 + CREATE + CLOEXEC, 438)
      if descriptor < 0 { fail FileSystem.errorWithCode(FileSystem.createFileOperation(), FileSystem.other(), errorCode()) }
      let held = FileLock {descriptor: descriptor}
      while true {
        if unsafe flock(descriptor, 2) == 0 { return move held }
        let code = errorCode()
        if code != 4 { fail FileSystem.errorWithCode(FileSystem.createFileOperation(), FileSystem.other(), code) }
      }
      return move held
    }
  }
} else {
static if Intrinsic.targetOperatingSystem() == "windows" {
  import silk.platform.windows.host_path as HostPath
  import silk.collections.list { List }
  import silk.core.option { Option }
  import silk.num.usize
  extern "C" struct Overlapped {internal: usize, transferred: usize, offset: u32, offsetHigh: u32, event: ?*mut u8}
  @foreign(noCapture: ("name", "security"))
  unsafe extern "C" fn CreateFileW(name: ?[*]const u16, access: u32, sharing: u32, security: ?*mut u8,
    creation: u32, flags: u32, template: ?*mut u8) -> ?*mut u8
  unsafe extern "C" fn CloseHandle(handle: ?*mut u8) -> i32
  @foreign(noCapture: .("overlapped"))
  unsafe extern "C" fn LockFileEx(handle: ?*mut u8, flags: u32, reserved: u32, low: u32, high: u32, overlapped: *mut Overlapped) -> i32
  /// Owns an exclusive advisory lock. Dropping it releases the lock; the lock file remains.
  pub struct FileLock {handle: ?*mut u8}
  impl Drop for FileLock {
    fn drop(self: &mut Self) -> () { let _closed = unsafe CloseHandle(self.handle) }
  }
  impl FileLock {
    /// Creates or opens the lock file and waits for its exclusive lock.
    /// The parent directory must exist. All participants must lock the same persistent file.
    pub effect fn exclusive(path: &Path) -> Self ! FileError | OutOfMemoryError ? &mut Allocator {
      let name = match move run HostPath.wide(path) {
        Option<List<u16>>.Some {value} => move value
        Option<List<u16>>.None => { fail FileSystem.error(FileSystem.pathOperation(), FileSystem.invalidPath()) }
      }
      let raw = unsafe CreateFileW(Pointer.fromSlice(name.asSlice()), 3221225472, 3, Pointer.null<u8>(), 4, 128, Pointer.null<u8>())
      if Pointer.isNull(raw) || Pointer.address(raw) == usize.MAX { fail FileSystem.error(FileSystem.createFileOperation(), FileSystem.other()) }
      let held = FileLock {handle: raw}
      let mut position = Overlapped {internal: 0, transferred: 0, offset: 0, offsetHigh: 0, event: Pointer.null<u8>()}
      if unsafe LockFileEx(raw, 2, 0, 1, 0, Pointer.fromMutRef(&mut position)) == 0 {
        fail FileSystem.error(FileSystem.createFileOperation(), FileSystem.other())
      }
      return move held
    }
  }
} else {
  /// The lock type on a host without native file locks. Acquisition always fails as unsupported.
  pub struct FileLock {}
  impl FileLock {
    /// Refuses acquisition because this host has no supported advisory locking API.
    pub effect fn exclusive(path: &Path) -> Self ! FileError | OutOfMemoryError ? &mut Allocator {
      fail FileSystem.error(FileSystem.createFileOperation(), FileSystem.unsupported())
    }
  }
}
}
