//! Resolves a program name against the process search path without starting it.

import silk.collections.bytes { Bytes }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.platform.windows.path { WindowsPath }
import silk.system.filesystem { DirectoryInfo, FileError, FileInfo, FileSystem, Path }
import silk.system.host_input { HostInput, HostInputError }
import silk.text.string { String }

fn onWindows() -> bool {
  static if Intrinsic.targetOperatingSystem() == "windows" { return true } else { return false }
}

/// Resolves a program spelled as host bytes. A path names the program directly; a name searches
/// `PATH`, with an additional `.exe` candidate on Windows. Only files count, so a directory of the
/// same name is skipped. Missing programs return `None`.
pub effect fn findBytes(written: &[u8]) -> Option<Path> ! HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  if written.length == 0 { return Option<Path>.none() }
  let windows = onWindows()
  let mut at: usize = 0
  while at < written.length {
    if written[at] == 47 || (windows && written[at] == 92) { return run existing(written) }
    at = at + 1
  }
  let searched = match move run HostInput.variableNamed("PATH") {
    Option<Bytes>.Some { value } => move value
    Option<Bytes>.None => { return Option<Path>.none() }
  }
  let separator: u8 = if windows { 59 } else { 58 }
  let directories = Bytes.asSlice(&searched)
  let mut start: usize = 0
  while start <= directories.length {
    let mut end = start
    while end < directories.length && directories[end] != separator { end = end + 1 }
    if end > start {
      let mut candidate = run Bytes.copy(Slice.view<u8>(directories, start, end - start))
      run Bytes.append(&mut candidate, if windows { b"\\" } else { b"/" })
      run Bytes.append(&mut candidate, written)
      if let Option<Path>.Some { value } = move run existing(Bytes.asSlice(&candidate)) { return Option<Path>.some(move value) }
      if windows {
        run Bytes.append(&mut candidate, b".exe")
        if let Option<Path>.Some { value } = move run existing(Bytes.asSlice(&candidate)) { return Option<Path>.some(move value) }
      }
    }
    start = end + 1
  }
  return Option<Path>.none()
}

/// Resolves a program name or path without starting it. Relative paths use the working directory.
pub effect fn find(written: string) -> Option<Path> ! HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  return run findBytes(String.utf8Bytes(written))
}

effect fn resolve(spelled: &[u8], cwd: &[u8]) -> Path ! FileError | OutOfMemoryError ? &mut Allocator {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    let base = run WindowsPath.fromNativeBytes(cwd)
    return run WindowsPath.resolveBytes(&base, spelled)
  } else {
    if spelled.length > 0 && spelled[0] == 47 { return run Path.fromBytes(spelled) }
    let base = run Path.fromBytes(cwd)
    return run Path.resolveBytes(&base, spelled)
  }
}

effect fn existing(spelled: &[u8]) -> Option<Path> ! HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator | &mut FileSystem {
  let cwd = run HostInput.workingDirectory()
  let path = match move run Effect.result(resolve(spelled, cwd.asSlice())) {
    Result<Path, FileError | OutOfMemoryError>.Success { value } => move value
    Result<Path, FileError | OutOfMemoryError>.Failure { error } => match move error {
      FileError invalid => {
        drop invalid
        return Option<Path>.none()
      }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
  // Only a file can be a program. A directory of the same name on `PATH`, such as Visual Studio's
  // `Team Explorer\git` beside Git for Windows, is passed over.
  return match move run Effect.result(FileSystem.stat(&path)) {
    Result<FileInfo | DirectoryInfo, FileError>.Success { value } => match move value {
      FileInfo _file => Option<Path>.some(move path)
      DirectoryInfo _folder => Option<Path>.none()
    }
    Result<FileInfo | DirectoryInfo, FileError>.Failure { error } => {
      drop error
      Option<Path>.none()
    }
  }
}

