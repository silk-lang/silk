//! The `InsecureRandom` effect: a fast pseudorandom sequence that repeats for the same seed.
//!
//! # When to use
//! Require `&mut InsecureRandom` for simulations, games, shuffles in tests, and other uses where
//! the same seed must give the same results. Provide [`InsecureRandom.seeded`] with a seed. Never
//! use it for keys, nonces, tokens, passwords, or protection against hash collisions. Use
//! `silk.system.random` for those.
//!
//! # Details
//! A provider implements [`InsecureRandom.nextU64`]. [`InsecureRandom.nextBool`],
//! [`InsecureRandom.below`], and [`InsecureRandom.fillBytes`] use it in a fixed way, so the results
//! are the same on each target. [`InsecureRandom.seeded`] returns a [`Xoshiro256StarStar`]
//! generator. It expands the seed with SplitMix64.
//!
//! # Gotchas
//! The output is predictable. An observer who sees a few values can compute the next values.
//!
//! # Examples
//! ## Get the same first value from the same seed
//! ```silk
//! import silk.core.effect { Effect }
//! import silk.system.insecure_random { InsecureRandom }
//!
//! pub fn main() -> i32 {
//!   let mut provider = InsecureRandom.seeded(0)
//!   let first = run InsecureRandom.nextU64() |> Effect.provideMut<InsecureRandom>(&mut provider)
//!   if first != 0x99ec5f36cb75f2b4 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category System

import silk.core.option { Option }
import silk.num.u64
import silk.num.u8
import silk.num.usize

/// The effect for a fast pseudorandom sequence that is not secure and repeats for the same seed.
///
/// # When to use
///
/// Require `&mut InsecureRandom` for simulations, games, shuffles in tests, and other uses where
/// the same seed must give the same results. Provide [`InsecureRandom.seeded`] with a seed. Use
/// `silk.system.random` for secrets.
///
/// # Details
///
/// A provider implements [`InsecureRandom.nextU64`]. [`InsecureRandom.nextBool`],
/// [`InsecureRandom.below`], and [`InsecureRandom.fillBytes`] use it in a fixed way, so the results
/// are the same on each target. The provider owns its state. Each call moves only the provider of
/// the current effect forward.
///
/// # Gotchas
///
/// Do not use it for secrets, keys, nonces, tokens, passwords, or protection against hash
/// collisions. The output is predictable: an observer who sees a few values can compute the next
/// values.
pub service InsecureRandom {
  /// Returns the next `u64` of the sequence.
  effect fn nextU64() -> u64 ? &mut InsecureRandom
}

impl InsecureRandom {
  /// Returns a [`Xoshiro256StarStar`] generator that starts from `seed`.
  ///
  /// # Details
  ///
  /// The same seed gives the same sequence on each target. Each seed works, also 0, because the
  /// seed is expanded with four SplitMix64 steps.
  pub fn seeded(seed: u64) -> Xoshiro256StarStar {
    let first = splitMix64(seed)
    let second = splitMix64(first.state)
    let third = splitMix64(second.state)
    let fourth = splitMix64(third.state)
    return Xoshiro256StarStar {
      state0: first.value,
      state1: second.value,
      state2: third.value,
      state3: fourth.value,
    }
  }

  /// Returns `true` if the highest bit of the next `u64` is set.
  pub effect fn nextBool() -> bool ? &mut InsecureRandom {
    let word = run InsecureRandom.nextU64()
    return u64.shiftRight(word, 63) == 1
  }

  /// Returns a value from 0 to `upperExclusive - 1`, with the same chance for each value. Returns
  /// an absent option if `upperExclusive` is 0.
  ///
  /// # Details
  ///
  /// It drops `u64` values that would make some results more likely than others, so it can read
  /// more than one value.
  pub effect fn below(upperExclusive: u64) -> Option<u64> ? &mut InsecureRandom {
    if upperExclusive == u64.MIN {
      return Option<u64>.none()
    }

    let threshold = u64.remainder(u64.wrappingSubtract(u64.MIN, upperExclusive), upperExclusive)
    let mut word = run InsecureRandom.nextU64()
    while word < threshold {
      word = run InsecureRandom.nextU64()
    }
    return Option<u64>.some(u64.remainder(word, upperExclusive))
  }

  /// Fills `output` with bytes from the sequence. Each `u64` gives 8 bytes, least significant byte
  /// first.
  ///
  /// # Details
  ///
  /// An empty slice reads nothing. If the length is not a multiple of 8, the last `u64` is read in
  /// full and its extra bytes are dropped.
  pub effect fn fillBytes(output: &mut [u8]) -> () ? &mut InsecureRandom {
    let mut index = usize.ZERO
    while index < output.length {
      let mut word = run InsecureRandom.nextU64()
      let mut byteIndex = u64.MIN
      while byteIndex < 8 {
        if index == output.length {
          return ()
        }
        output[index] = u64.toU8(u64.bitAnd(word, 255))
        word = u64.shiftRight(word, 8)
        index = index + usize.ONE
        byteIndex = byteIndex + 1
      }
    }
    return ()
  }
}

/// A xoshiro256** generator. Make one with [`InsecureRandom.seeded`] and provide it as
/// `InsecureRandom`.
///
/// # Details
///
/// The sequence is the same on each target. It is not secure: an observer who sees a few values
/// can compute the next values.
pub struct Xoshiro256StarStar {
  state0: u64,
  state1: u64,
  state2: u64,
  state3: u64,
}

struct SplitMix64Step {
  state: u64,
  value: u64,
}

fn splitMix64(state: u64) -> SplitMix64Step {
  let next = u64.wrappingAdd(state, 0x9e3779b97f4a7c15)
  let first = u64.bitXor(next, u64.shiftRight(next, 30))
  let spread = u64.wrappingMultiply(first, 0xbf58476d1ce4e5b9)
  let second = u64.bitXor(spread, u64.shiftRight(spread, 27))
  let respread = u64.wrappingMultiply(second, 0x94d049bb133111eb)
  return SplitMix64Step {
    state: next,
    value: u64.bitXor(respread, u64.shiftRight(respread, 31)),
  }
}

effect fn xoshiroNext(self: &mut Xoshiro256StarStar) -> u64 {
  let multiplied = u64.wrappingMultiply(self.state1, 5)
  let result = u64.wrappingMultiply(u64.rotateLeft(multiplied, 7), 9)
  let shifted = u64.shiftLeft(self.state1, 17)

  self.state2 = u64.bitXor(self.state2, self.state0)
  self.state3 = u64.bitXor(self.state3, self.state1)
  self.state1 = u64.bitXor(self.state1, self.state2)
  self.state0 = u64.bitXor(self.state0, self.state3)
  self.state2 = u64.bitXor(self.state2, shifted)
  self.state3 = u64.rotateLeft(self.state3, 45)

  return result
}

impl InsecureRandom for Xoshiro256StarStar {
  nextU64: Xoshiro256StarStar.xoshiroNext
}
