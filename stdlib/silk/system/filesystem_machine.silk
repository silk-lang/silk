//! A filesystem provider for absolute paths in the host machine namespace.
//!
//! # When to use
//! Use `MachineFileSystem` in host tools that must access more than one directory.
//! Unix paths use `/...`; Windows drive paths use `/C:/...`. This provider is not confined
//! to an application directory. Use `OsFileSystem` for a confined root instead.
//!
//! @category System

static if (Intrinsic.targetOperatingSystem() == "windows" && Intrinsic.targetArchitecture() == "x86_64" && Intrinsic.targetAbi() == "msvc" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText("libc") == "gnu") {
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { FileSystem, Path, FileError, FileOperation, FileInfo, DirectoryInfo, DirectoryEntry, DirectoryEntryKind, PublicationPolicy, Durability, AtomicWriteError }
import silk.system.filesystem_native { OsFileSystem }
import silk.num.u8

/// The native filesystem in the absolute machine namespace.
///
/// # Details
///
/// Unix paths retain their absolute spelling. Windows paths select a drive explicitly,
/// such as `/C:/work/main.silk`; drive letters are case insensitive and other bytes retain
/// their case and canonical WTF-8 spelling. Windows requires local NTFS and refuses followed
/// reparse points, UNC roots, directory synchronization, and synchronized publication.
/// The path `/` has no Windows volume and fails with `InvalidPath`.
/// Each drive retains its own temporary-name counter for the provider's lifetime.
pub struct MachineFileSystem { volumes: List<OsFileSystem> }

struct Routed { volume: usize, path: Path }

effect fn route(path: &Path, operation: FileOperation) -> Routed
! FileError | OutOfMemoryError ? &mut Allocator {
  let bytes = Path.rawBytes(path)
  static if Intrinsic.targetOperatingSystem() == "windows" {
    if bytes.length >= 5 && bytes[1] == 85 && bytes[2] == 78 && bytes[3] == 67 && bytes[4] == 47 {
      fail FileSystem.error(move operation, FileSystem.unsupported())
    }
    if bytes.length < 3 || bytes[2] != 58 || (bytes.length > 3 && bytes[3] != 47) {
      fail FileSystem.error(move operation, FileSystem.invalidPath())
    }
    let mut letter = bytes[1]
    if letter >= 97 && letter <= 122 { letter = letter - 32 }
    if letter < 65 || letter > 90 { fail FileSystem.error(move operation, FileSystem.invalidPath()) }
    let local = if bytes.length == 3 { run Path.root() } else {
      run Path.fromBytes(Slice.view(bytes, 3, bytes.length - 3))
    }
    return Routed { volume: u8.toUsize(letter - 65), path: move local }
  } else {
    return Routed { volume: 0, path: run Path.fromBytes(bytes) }
  }
}

effect fn routeOwned(path: &Path, operation: FileOperation) -> Routed ! FileError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let code = operation.code
  let attempted = run Effect.result(route(path, move operation)) |> Effect.provideMut<Allocator>(&mut allocator)
  return match move attempted {
    Result<Routed, FileError | OutOfMemoryError>.Success {value} => move value
    Result<Routed, FileError | OutOfMemoryError>.Failure {error} => match move error {
      FileError failure => { fail move failure }
      OutOfMemoryError exhausted => { fail FileSystem.error(FileOperation {code: code}, FileSystem.noSpace()) }
    }
  }
}

effect fn machinePath(source: &Path, local: &Path) -> Path
! FileError | OutOfMemoryError ? &mut Allocator {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    let mut bytes = run Bytes.copy(Slice.view(Path.rawBytes(source), 0, 3))
    if !Path.isRoot(local) { run Bytes.append(&mut bytes, Path.rawBytes(local)) }
    return run Path.fromBytes(Bytes.asSlice(&bytes))
  } else {
    return run Path.fromBytes(Path.rawBytes(local))
  }
}

impl MachineFileSystem {
  /// Creates a provider for the machine's absolute paths without opening any directories.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the provider's roots cannot be allocated.
  pub effect fn make() -> MachineFileSystem ! OutOfMemoryError ? &mut Allocator {
    let mut volumes = List<OsFileSystem>.make()
    static if Intrinsic.targetOperatingSystem() == "windows" {
      let mut letter: u8 = 65
      while letter <= 90 {
        let root: [u8; 3] = [letter, 58, 92]
        run List<OsFileSystem>.append(&mut volumes, run OsFileSystem.makeBytes(&root))
        letter = letter + 1
      }
    } else {
      run List<OsFileSystem>.append(&mut volumes, run OsFileSystem.make("/"))
    }
    return MachineFileSystem { volumes: move volumes }
  }

  effect fn readFile(self: &mut Self, path: &Path) -> Bytes
  ! FileError | OutOfMemoryError ? &mut Allocator {
    static if Intrinsic.targetOperatingSystem() != "windows" {
      return run FileSystem.readFile(path)
        |> Effect.provideMut<FileSystem>(&mut List<OsFileSystem>.asMutSlice(&mut self.volumes)[0])
    } else {
      let routed = run route(path, FileSystem.readFileOperation())
      return run FileSystem.readFile(&routed.path)
        |> Effect.provideMut<FileSystem>(&mut List<OsFileSystem>.asMutSlice(&mut self.volumes)[routed.volume])
    }
  }

  effect fn listDirectory(self: &mut Self, path: &Path) -> List<DirectoryEntry>
  ! FileError | OutOfMemoryError ? &mut Allocator {
    static if Intrinsic.targetOperatingSystem() != "windows" {
      return run FileSystem.listDirectory(path)
        |> Effect.provideMut<FileSystem>(&mut List<OsFileSystem>.asMutSlice(&mut self.volumes)[0])
    } else {
      let routed = run route(path, FileSystem.listDirectoryOperation())
      let entries = run FileSystem.listDirectory(&routed.path)
        |> Effect.provideMut<FileSystem>(&mut List<OsFileSystem>.asMutSlice(&mut self.volumes)[routed.volume])
      let mut result = List<DirectoryEntry>.make()
      let listed = List<DirectoryEntry>.asSlice(&entries)
      let mut at: usize = 0
      while at < listed.length {
        run List<DirectoryEntry>.append(&mut result, FileSystem.directoryEntry(
          run machinePath(path, &listed[at].path), DirectoryEntryKind {code: listed[at].kind.code}))
        at = at + 1
      }
      return move result
    }
  }

  effect fn createTemporaryDirectory(self: &mut Self, parent: &Path, prefix: &[u8]) -> Path
  ! FileError | OutOfMemoryError ? &mut Allocator {
    static if Intrinsic.targetOperatingSystem() != "windows" {
      return run FileSystem.createTemporaryDirectory(parent, prefix)
        |> Effect.provideMut<FileSystem>(&mut List<OsFileSystem>.asMutSlice(&mut self.volumes)[0])
    } else {
      let routed = run route(parent, FileSystem.createTemporaryDirectoryOperation())
      let local = run FileSystem.createTemporaryDirectory(&routed.path, prefix)
        |> Effect.provideMut<FileSystem>(&mut List<OsFileSystem>.asMutSlice(&mut self.volumes)[routed.volume])
      return run machinePath(parent, &local)
    }
  }

  effect fn writeFileAtomic(self: &mut Self, path: &Path, bytes: &[u8], policy: PublicationPolicy, durability: Durability)
  -> () ! AtomicWriteError {
    static if Intrinsic.targetOperatingSystem() != "windows" {
      return run FileSystem.writeFileAtomic(path, bytes, move policy, move durability)
        |> Effect.provideMut<FileSystem>(&mut List<OsFileSystem>.asMutSlice(&mut self.volumes)[0])
    } else {
      let routed = match move run Effect.result(routeOwned(path, FileSystem.writeFileAtomicOperation())) {
        Result<Routed, FileError>.Success {value} => move value
        Result<Routed, FileError>.Failure {error} => {
          fail AtomicWriteError { published: false, cause: move error,
            cleanupError: Option<FileError>.none(), stagingName: Bytes.make() }
        }
      }
      return run FileSystem.writeFileAtomic(&routed.path, bytes, move policy, move durability)
        |> Effect.provideMut<FileSystem>(&mut List<OsFileSystem>.asMutSlice(&mut self.volumes)[routed.volume])
    }
  }

  effect fn writeFile(self: &mut Self, path: &Path, bytes: &[u8]) -> ()  ! FileError {
    static if Intrinsic.targetOperatingSystem() != "windows" {
      return run FileSystem.writeFile(path, bytes)
        |> Effect.provideMut<FileSystem>(&mut List<OsFileSystem>.asMutSlice(&mut self.volumes)[0])
    } else {
      let routed = run routeOwned(path, FileSystem.writeFileOperation())
      return run FileSystem.writeFile(&routed.path, bytes)
        |> Effect.provideMut<FileSystem>(&mut List<OsFileSystem>.asMutSlice(&mut self.volumes)[routed.volume])
    }
  }

  effect fn createFile(self: &mut Self, path: &Path, bytes: &[u8]) -> ()  ! FileError {
    static if Intrinsic.targetOperatingSystem() != "windows" {
      return run FileSystem.createFile(path, bytes)
        |> Effect.provideMut<FileSystem>(&mut List<OsFileSystem>.asMutSlice(&mut self.volumes)[0])
    } else {
      let routed = run routeOwned(path, FileSystem.createFileOperation())
      return run FileSystem.createFile(&routed.path, bytes)
        |> Effect.provideMut<FileSystem>(&mut List<OsFileSystem>.asMutSlice(&mut self.volumes)[routed.volume])
    }
  }

  effect fn stat(self: &mut Self, path: &Path) -> FileInfo | DirectoryInfo ! FileError {
    static if Intrinsic.targetOperatingSystem() != "windows" {
      return run FileSystem.stat(path)
        |> Effect.provideMut<FileSystem>(&mut List<OsFileSystem>.asMutSlice(&mut self.volumes)[0])
    } else {
      let routed = run routeOwned(path, FileSystem.statOperation())
      return run FileSystem.stat(&routed.path)
        |> Effect.provideMut<FileSystem>(&mut List<OsFileSystem>.asMutSlice(&mut self.volumes)[routed.volume])
    }
  }

  effect fn syncDirectory(self: &mut Self, path: &Path) -> () ! FileError {
    static if Intrinsic.targetOperatingSystem() != "windows" {
      return run FileSystem.syncDirectory(path)
        |> Effect.provideMut<FileSystem>(&mut List<OsFileSystem>.asMutSlice(&mut self.volumes)[0])
    } else {
      let routed = run routeOwned(path, FileSystem.syncDirectoryOperation())
      return run FileSystem.syncDirectory(&routed.path)
        |> Effect.provideMut<FileSystem>(&mut List<OsFileSystem>.asMutSlice(&mut self.volumes)[routed.volume])
    }
  }

  effect fn createDirectory(self: &mut Self, path: &Path) -> () ! FileError {
    static if Intrinsic.targetOperatingSystem() != "windows" {
      return run FileSystem.createDirectory(path)
        |> Effect.provideMut<FileSystem>(&mut List<OsFileSystem>.asMutSlice(&mut self.volumes)[0])
    } else {
      let routed = run routeOwned(path, FileSystem.createDirectoryOperation())
      return run FileSystem.createDirectory(&routed.path)
        |> Effect.provideMut<FileSystem>(&mut List<OsFileSystem>.asMutSlice(&mut self.volumes)[routed.volume])
    }
  }

  effect fn removeFile(self: &mut Self, path: &Path) -> () ! FileError {
    static if Intrinsic.targetOperatingSystem() != "windows" {
      return run FileSystem.removeFile(path)
        |> Effect.provideMut<FileSystem>(&mut List<OsFileSystem>.asMutSlice(&mut self.volumes)[0])
    } else {
      let routed = run routeOwned(path, FileSystem.removeFileOperation())
      return run FileSystem.removeFile(&routed.path)
        |> Effect.provideMut<FileSystem>(&mut List<OsFileSystem>.asMutSlice(&mut self.volumes)[routed.volume])
    }
  }

  effect fn removeDirectory(self: &mut Self, path: &Path) -> () ! FileError {
    static if Intrinsic.targetOperatingSystem() != "windows" {
      return run FileSystem.removeDirectory(path)
        |> Effect.provideMut<FileSystem>(&mut List<OsFileSystem>.asMutSlice(&mut self.volumes)[0])
    } else {
      let routed = run routeOwned(path, FileSystem.removeDirectoryOperation())
      return run FileSystem.removeDirectory(&routed.path)
        |> Effect.provideMut<FileSystem>(&mut List<OsFileSystem>.asMutSlice(&mut self.volumes)[routed.volume])
    }
  }
}
impl FileSystem for MachineFileSystem {
  readFile: MachineFileSystem.readFile
  writeFile: MachineFileSystem.writeFile
  createFile: MachineFileSystem.createFile
  writeFileAtomic: MachineFileSystem.writeFileAtomic
  syncDirectory: MachineFileSystem.syncDirectory
  stat: MachineFileSystem.stat
  listDirectory: MachineFileSystem.listDirectory
  createDirectory: MachineFileSystem.createDirectory
  removeFile: MachineFileSystem.removeFile
  removeDirectory: MachineFileSystem.removeDirectory
  createTemporaryDirectory: MachineFileSystem.createTemporaryDirectory
}
}
