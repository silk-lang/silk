//! A filesystem provider for absolute paths in the host machine namespace.
//!
//! # When to use
//! Use `MachineFileSystem` in host tools that must access more than one directory.
//! Unix paths use `/...`; Windows paths use `/C:/...` or `/UNC/server/share/...`. This provider is not confined
//! to an application directory. Use `OsFileSystem` for a confined root instead.
//!
//! @category System

static if (Intrinsic.targetOperatingSystem() == "windows" && Intrinsic.targetArchitecture() == "x86_64" && Intrinsic.targetAbi() == "msvc" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "darwin" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64") && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText("libc") == "gnu") {
import silk.core.effect { Effect }
import silk.core.option { Option }
import silk.core.result { Result }
import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.collections.slice { Slice }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.system.filesystem { FileSystem, Path, FileError, FileOperation, FileInfo, DirectoryInfo, DirectoryEntry, DirectoryEntryKind, PublicationPolicy, Durability, AtomicWriteError }
import silk.system.filesystem_native { OsFileSystem }
import silk.num.u8
static if Intrinsic.targetOperatingSystem() == "windows" {
  import silk.platform.windows.filesystem { WindowsFileSystem }
}

/// The native filesystem in the absolute machine namespace.
///
/// # Details
///
/// Unix paths retain their absolute spelling. Windows paths select a drive or UNC share,
/// such as `/C:/work/main.silk` or `/UNC/server/share/main.silk`; drive letters are case insensitive
/// and other bytes retain their case and canonical WTF-8 spelling. Windows requires NTFS.
/// Relative symbolic links resolve inside their drive or share; absolute links must name that root
/// with matching spelling except drive-letter case. Unknown reparse tags and other-root targets
/// are unsupported. Resolution stops after 40 links with `InvalidPath`. Remote atomic publication,
/// directory synchronization, and synchronized publication are unsupported; deletion requires
/// the server's POSIX disposition support. Ordinary UNC reads, writes, creation, and listing are supported.
/// The path `/` has no Windows volume and fails with `InvalidPath`.
/// Each drive or share retains its own temporary-name counter for the provider's lifetime.
pub struct MachineFileSystem { volumes: List<Volume> }
// Fixed drive slots need no lookup key. Appended UNC providers retain their machine root spelling.
struct Volume { root: Bytes, filesystem: OsFileSystem }

struct Routed { volume: usize, path: Path }

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at: usize = 0
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + 1
  }
  return true
}

// The end of the server/share root. Paths reaching this actor already have portable separators.
fn shareEnd(bytes: &[u8]) -> usize {
  let mut at: usize = 5
  while at < bytes.length && bytes[at] != 47 { at = at + 1 }
  if at == 5 || at == bytes.length { return 0 }
  let share = at + 1
  at = share
  while at < bytes.length && bytes[at] != 47 { at = at + 1 }
  if at == share { return 0 }
  return at
}

effect fn route(self: &mut MachineFileSystem, path: &Path, operation: FileOperation) -> Routed
! FileError | OutOfMemoryError ? &mut Allocator {
  let bytes = Path.rawBytes(path)
  static if Intrinsic.targetOperatingSystem() == "windows" {
    if bytes.length >= 5 && bytes[1] == 85 && bytes[2] == 78 && bytes[3] == 67 && bytes[4] == 47 {
      let end = shareEnd(bytes)
      if end == 0 { fail FileSystem.error(move operation, FileSystem.invalidPath()) }
      let root = Slice.view(bytes, 0, end)
      let local = if end == bytes.length { run Path.root() } else {
        run Path.fromBytes(Slice.view(bytes, end, bytes.length - end))
      }
      let mut volume: usize = 26
      while volume < List<Volume>.length(&self.volumes) {
        if same(Bytes.asSlice(&List<Volume>.asSlice(&self.volumes)[volume].root), root) {
          return Routed {volume: volume, path: move local}
        }
        volume = volume + 1
      }
      let mut native = run Bytes.copy(b"\\\\")
      run Bytes.append(&mut native, Slice.view(bytes, 5, end - 5))
      let view = Bytes.asMutSlice(&mut native)
      let mut at: usize = 2
      while at < view.length {
        if view[at] == 47 { view[at] = 92 }
        at = at + 1
      }
      drop view
      if !WindowsFileSystem.validRootBytes(Bytes.asSlice(&native)) {
        fail FileSystem.error(move operation, FileSystem.invalidPath())
      }
      let filesystem = run OsFileSystem.makeBytes(Bytes.asSlice(&native))
      run List<Volume>.append(&mut self.volumes, Volume {root: run Bytes.copy(root), filesystem: move filesystem})
      return Routed {volume: volume, path: move local}
    }
    if bytes.length < 3 || bytes[2] != 58 || (bytes.length > 3 && bytes[3] != 47) {
      fail FileSystem.error(move operation, FileSystem.invalidPath())
    }
    let mut letter = bytes[1]
    if letter >= 97 && letter <= 122 { letter = letter - 32 }
    if letter < 65 || letter > 90 { fail FileSystem.error(move operation, FileSystem.invalidPath()) }
    let local = if bytes.length == 3 { run Path.root() } else {
      run Path.fromBytes(Slice.view(bytes, 3, bytes.length - 3))
    }
    return Routed { volume: u8.toUsize(letter - 65), path: move local }
  } else {
    return Routed { volume: 0, path: run Path.fromBytes(bytes) }
  }
}

effect fn routeOwned(self: &mut MachineFileSystem, path: &Path, operation: FileOperation) -> Routed ! FileError {
  let mut allocator = Allocator.systemAllocatorProvider()
  let code = operation.code
  let attempted = run Effect.result(route(&mut self.*, path, move operation)) |> Effect.provideMut<Allocator>(&mut allocator)
  return match move attempted {
    Result<Routed, FileError | OutOfMemoryError>.Success {value} => move value
    Result<Routed, FileError | OutOfMemoryError>.Failure {error} => match move error {
      FileError failure => { fail move failure }
      OutOfMemoryError _exhausted => { fail FileSystem.error(FileOperation {code: code}, FileSystem.noSpace()) }
    }
  }
}

effect fn machinePath(source: &Path, local: &Path) -> Path
! FileError | OutOfMemoryError ? &mut Allocator {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    let from = Path.rawBytes(source)
    let length = if from.length >= 5 && from[1] == 85 && from[2] == 78 && from[3] == 67 && from[4] == 47 { shareEnd(from) } else { 3 }
    let mut bytes = run Bytes.copy(Slice.view(from, 0, length))
    if !Path.isRoot(local) { run Bytes.append(&mut bytes, Path.rawBytes(local)) }
    return run Path.fromBytes(Bytes.asSlice(&bytes))
  } else {
    return run Path.fromBytes(Path.rawBytes(local))
  }
}

impl MachineFileSystem {
  /// Creates a provider for the machine's absolute paths without opening any directories.
  ///
  /// # Errors
  ///
  /// - `OutOfMemoryError` if the provider's roots cannot be allocated.
  pub effect fn make() -> MachineFileSystem ! OutOfMemoryError ? &mut Allocator {
    let mut volumes = List<Volume>.make()
    static if Intrinsic.targetOperatingSystem() == "windows" {
      let mut letter: u8 = 65
      while letter <= 90 {
        let root: [u8; 3] = [letter, 58, 92]
        run List<Volume>.append(&mut volumes, Volume {root: Bytes.make(), filesystem: run OsFileSystem.makeBytes(&root)})
        letter = letter + 1
      }
    } else {
      run List<Volume>.append(&mut volumes, Volume {root: Bytes.make(), filesystem: run OsFileSystem.make("/")})
    }
    return MachineFileSystem { volumes: move volumes }
  }

  effect fn readFile(self: &mut Self, path: &Path) -> Bytes
  ! FileError | OutOfMemoryError ? &mut Allocator {
    static if Intrinsic.targetOperatingSystem() != "windows" {
      return run FileSystem.readFile(path)
        |> Effect.provideMut<FileSystem>(&mut List<Volume>.asMutSlice(&mut self.volumes)[0].filesystem)
    } else {
      let routed = run route(&mut self.*, path, FileSystem.readFileOperation())
      return run FileSystem.readFile(&routed.path)
        |> Effect.provideMut<FileSystem>(&mut List<Volume>.asMutSlice(&mut self.volumes)[routed.volume].filesystem)
    }
  }

  effect fn listDirectory(self: &mut Self, path: &Path) -> List<DirectoryEntry>
  ! FileError | OutOfMemoryError ? &mut Allocator {
    static if Intrinsic.targetOperatingSystem() != "windows" {
      return run FileSystem.listDirectory(path)
        |> Effect.provideMut<FileSystem>(&mut List<Volume>.asMutSlice(&mut self.volumes)[0].filesystem)
    } else {
      let routed = run route(&mut self.*, path, FileSystem.listDirectoryOperation())
      let entries = run FileSystem.listDirectory(&routed.path)
        |> Effect.provideMut<FileSystem>(&mut List<Volume>.asMutSlice(&mut self.volumes)[routed.volume].filesystem)
      let mut result = List<DirectoryEntry>.make()
      let listed = List<DirectoryEntry>.asSlice(&entries)
      let mut at: usize = 0
      while at < listed.length {
        run List<DirectoryEntry>.append(&mut result, FileSystem.directoryEntry(
          run machinePath(path, &listed[at].path), DirectoryEntryKind {code: listed[at].kind.code}))
        at = at + 1
      }
      return move result
    }
  }

  effect fn createTemporaryDirectory(self: &mut Self, parent: &Path, prefix: &[u8]) -> Path
  ! FileError | OutOfMemoryError ? &mut Allocator {
    static if Intrinsic.targetOperatingSystem() != "windows" {
      return run FileSystem.createTemporaryDirectory(parent, prefix)
        |> Effect.provideMut<FileSystem>(&mut List<Volume>.asMutSlice(&mut self.volumes)[0].filesystem)
    } else {
      let routed = run route(&mut self.*, parent, FileSystem.createTemporaryDirectoryOperation())
      let local = run FileSystem.createTemporaryDirectory(&routed.path, prefix)
        |> Effect.provideMut<FileSystem>(&mut List<Volume>.asMutSlice(&mut self.volumes)[routed.volume].filesystem)
      return run machinePath(parent, &local)
    }
  }

  effect fn writeFileAtomic(self: &mut Self, path: &Path, bytes: &[u8], policy: PublicationPolicy, durability: Durability)
  -> () ! AtomicWriteError {
    static if Intrinsic.targetOperatingSystem() != "windows" {
      return run FileSystem.writeFileAtomic(path, bytes, move policy, move durability)
        |> Effect.provideMut<FileSystem>(&mut List<Volume>.asMutSlice(&mut self.volumes)[0].filesystem)
    } else {
      let routed = match move run Effect.result(routeOwned(&mut self.*, path, FileSystem.writeFileAtomicOperation())) {
        Result<Routed, FileError>.Success {value} => move value
        Result<Routed, FileError>.Failure {error} => {
          fail AtomicWriteError { published: false, cause: move error,
            cleanupError: Option<FileError>.none(), stagingName: Bytes.make() }
        }
      }
      return run FileSystem.writeFileAtomic(&routed.path, bytes, move policy, move durability)
        |> Effect.provideMut<FileSystem>(&mut List<Volume>.asMutSlice(&mut self.volumes)[routed.volume].filesystem)
    }
  }

  effect fn writeFile(self: &mut Self, path: &Path, bytes: &[u8]) -> ()  ! FileError {
    static if Intrinsic.targetOperatingSystem() != "windows" {
      return run FileSystem.writeFile(path, bytes)
        |> Effect.provideMut<FileSystem>(&mut List<Volume>.asMutSlice(&mut self.volumes)[0].filesystem)
    } else {
      let routed = run routeOwned(&mut self.*, path, FileSystem.writeFileOperation())
      return run FileSystem.writeFile(&routed.path, bytes)
        |> Effect.provideMut<FileSystem>(&mut List<Volume>.asMutSlice(&mut self.volumes)[routed.volume].filesystem)
    }
  }

  effect fn createFile(self: &mut Self, path: &Path, bytes: &[u8]) -> ()  ! FileError {
    static if Intrinsic.targetOperatingSystem() != "windows" {
      return run FileSystem.createFile(path, bytes)
        |> Effect.provideMut<FileSystem>(&mut List<Volume>.asMutSlice(&mut self.volumes)[0].filesystem)
    } else {
      let routed = run routeOwned(&mut self.*, path, FileSystem.createFileOperation())
      return run FileSystem.createFile(&routed.path, bytes)
        |> Effect.provideMut<FileSystem>(&mut List<Volume>.asMutSlice(&mut self.volumes)[routed.volume].filesystem)
    }
  }

  effect fn stat(self: &mut Self, path: &Path) -> FileInfo | DirectoryInfo ! FileError {
    static if Intrinsic.targetOperatingSystem() != "windows" {
      return run FileSystem.stat(path)
        |> Effect.provideMut<FileSystem>(&mut List<Volume>.asMutSlice(&mut self.volumes)[0].filesystem)
    } else {
      let routed = run routeOwned(&mut self.*, path, FileSystem.statOperation())
      return run FileSystem.stat(&routed.path)
        |> Effect.provideMut<FileSystem>(&mut List<Volume>.asMutSlice(&mut self.volumes)[routed.volume].filesystem)
    }
  }

  effect fn syncDirectory(self: &mut Self, path: &Path) -> () ! FileError {
    static if Intrinsic.targetOperatingSystem() != "windows" {
      return run FileSystem.syncDirectory(path)
        |> Effect.provideMut<FileSystem>(&mut List<Volume>.asMutSlice(&mut self.volumes)[0].filesystem)
    } else {
      let routed = run routeOwned(&mut self.*, path, FileSystem.syncDirectoryOperation())
      return run FileSystem.syncDirectory(&routed.path)
        |> Effect.provideMut<FileSystem>(&mut List<Volume>.asMutSlice(&mut self.volumes)[routed.volume].filesystem)
    }
  }

  effect fn createDirectory(self: &mut Self, path: &Path) -> () ! FileError {
    static if Intrinsic.targetOperatingSystem() != "windows" {
      return run FileSystem.createDirectory(path)
        |> Effect.provideMut<FileSystem>(&mut List<Volume>.asMutSlice(&mut self.volumes)[0].filesystem)
    } else {
      let routed = run routeOwned(&mut self.*, path, FileSystem.createDirectoryOperation())
      return run FileSystem.createDirectory(&routed.path)
        |> Effect.provideMut<FileSystem>(&mut List<Volume>.asMutSlice(&mut self.volumes)[routed.volume].filesystem)
    }
  }

  effect fn removeFile(self: &mut Self, path: &Path) -> () ! FileError {
    static if Intrinsic.targetOperatingSystem() != "windows" {
      return run FileSystem.removeFile(path)
        |> Effect.provideMut<FileSystem>(&mut List<Volume>.asMutSlice(&mut self.volumes)[0].filesystem)
    } else {
      let routed = run routeOwned(&mut self.*, path, FileSystem.removeFileOperation())
      return run FileSystem.removeFile(&routed.path)
        |> Effect.provideMut<FileSystem>(&mut List<Volume>.asMutSlice(&mut self.volumes)[routed.volume].filesystem)
    }
  }

  effect fn removeDirectory(self: &mut Self, path: &Path) -> () ! FileError {
    static if Intrinsic.targetOperatingSystem() != "windows" {
      return run FileSystem.removeDirectory(path)
        |> Effect.provideMut<FileSystem>(&mut List<Volume>.asMutSlice(&mut self.volumes)[0].filesystem)
    } else {
      let routed = run routeOwned(&mut self.*, path, FileSystem.removeDirectoryOperation())
      return run FileSystem.removeDirectory(&routed.path)
        |> Effect.provideMut<FileSystem>(&mut List<Volume>.asMutSlice(&mut self.volumes)[routed.volume].filesystem)
    }
  }
}
impl FileSystem for MachineFileSystem {
  readFile: MachineFileSystem.readFile
  writeFile: MachineFileSystem.writeFile
  createFile: MachineFileSystem.createFile
  writeFileAtomic: MachineFileSystem.writeFileAtomic
  syncDirectory: MachineFileSystem.syncDirectory
  stat: MachineFileSystem.stat
  listDirectory: MachineFileSystem.listDirectory
  createDirectory: MachineFileSystem.createDirectory
  removeFile: MachineFileSystem.removeFile
  removeDirectory: MachineFileSystem.removeDirectory
  createTemporaryDirectory: MachineFileSystem.createTemporaryDirectory
}
}
