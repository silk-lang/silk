//! The native provider of the `Random` effect: secure random bytes from the operating system.
//!
//! # When to use
//! Provide [`OsRandom`] for `Random` in a native program, for keys, nonces, and other secrets. In a
//! test, provide a fake that returns fixed bytes.
//!
//! # Details
//! Each fill gets bytes from the secure random source of the system: `random_get` on WASI,
//! `getrandom` on Linux, and `arc4random_buf` on macOS. An empty buffer does nothing.
//!
//! # Gotchas
//! - A failure of the source is a trap, because weak bytes are not safe. Part of the buffer can be
//!   changed before the trap.
//! - On Linux, it needs glibc 2.25 and Linux 3.17 or later.
//! - [`OsRandom.make`] fails to compile on targets other than WASI, Darwin on aarch64, and Linux with GNU libc on x86_64 or aarch64.
//!
//! # Examples
//! ## Make a random key
//! ```silk
//! import silk.core.effect { Effect }
//! import silk.system.random_native { OsRandom }
//! import silk.system.random { Random }
//!
//! pub fn main() -> i32 {
//!   let mut random = OsRandom.make()
//!   let mut key: [u8; 32] = [0; 32]
//!   run Random.fillBytes(&mut key) |> Effect.provideMut<Random>(&mut random)
//!
//!   // 32 zero bytes from a secure source are practically impossible.
//!   let mut index: usize = 0
//!   while index < 32 {
//!     if key[index] != 0 {
//!       return 0
//!     }
//!     index = index + 1
//!   }
//!   return 1
//! }
//! ```
//!
//! @category System

import silk.system.random { Random }
import silk.num.usize
static if Intrinsic.targetOperatingSystem() == "wasi" { import silk.platform.wasi.preview1 as wasi }
import silk.mem.pointer { Pointer }
import silk.num.isize

@foreign(noCapture: ("buffer",))
unsafe extern "C" fn arc4random_buf(buffer: ?[*]mut u8, count: usize) -> ()
@foreign(noCapture: ("buffer",))
unsafe extern "C" fn getrandom(buffer: ?[*]mut u8, count: usize, flags: u32) -> isize
unsafe extern "C" fn __errno_location() -> *mut i32
unsafe fn currentError() -> i32 { unsafe { return Pointer.read<i32>(__errno_location()) } }

/// The native `Random` provider: secure random bytes from the operating system. It has no state.
///
/// # Details
/// Each fill gets bytes from `random_get` on WASI, `getrandom` on Linux, and `arc4random_buf` on macOS. An empty buffer
/// does nothing.
///
/// # Gotchas
/// - A failure of the source is a trap, because weak bytes are not safe. Part of the buffer can be
///   changed before the trap.
/// - On Linux, it needs glibc 2.25 and Linux 3.17 or later.
pub struct OsRandom {}

impl OsRandom {
  /// Returns a provider. It does not read random bytes.
  pub fn make() -> OsRandom {
    static if Intrinsic.targetOperatingSystem() == "wasi" || (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText("libc") == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
      return OsRandom {}
    } else { compileError("OsRandom requires a supported WASI, Darwin or GNU libc profile") }
  }
}

impl Random for OsRandom {
  effect fn fillBytes(self: &mut Self, output: &mut [u8]) -> () {
    static if Intrinsic.targetOperatingSystem() == "wasi" || (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText("libc") == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
      static if Intrinsic.targetOperatingSystem() == "wasi" {
        let length = output.length
        if length != 0 {
          let status = unsafe wasi.random_get(Pointer.fromMutSlice(move output), usize.toU32(length))
          if status != 0 { Intrinsic.trap("OsRandom: the WASI random_get call failed") }
        }
        return ()
      } else {
      let length = output.length
      if length == 0 { return () }
      let pointer = Pointer.fromMutSlice<u8>(move output)
      static if Intrinsic.targetOperatingSystem() == "darwin" {
        unsafe arc4random_buf(pointer, length)
      } else {
        let base = unsafe Intrinsic.pointerRequalify<?[*]mut u8, [*]mut u8>(pointer)
        let mut filled: usize = 0
        while filled < length {
          let mut requested = length - filled
          if requested > 256 { requested = 256 }
          let start = unsafe Pointer.atMut<u8>(base, filled)
          let buffer = unsafe Pointer.assumeManyMut<u8>(start)
          let count = unsafe getrandom(buffer, requested, 1)
          if count < 0 {
            let nativeError = unsafe currentError()
            if nativeError != 4 { Intrinsic.trap("OsRandom: the operating system random call failed") }
          } else {
            let transferred = isize.toUsize(count)
            if transferred == 0 || transferred > requested { Intrinsic.trap("OsRandom: the operating system returned an invalid byte count") }
            filled = filled + transferred
          }
        }
      }
      return ()
      }
    } else { compileError("OsRandom requires a supported WASI, Darwin or GNU libc profile") }
  }
}
