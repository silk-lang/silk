//! The native provider of the `HostInput` effect: command-line arguments, environment, and the
//! working directory.
//!
//! # When to use
//! A native `main` that requires `&mut HostInput` gets this provider from `silk.platform.native.start`. To
//! make one yourself, capture a `NativeHostInput` from `silk.platform.native.host_input`, and pass it to
//! [`OsHostInput.make`].
//!
//! # Details
//! The arguments and the environment come from the snapshot, so they do not change. The working
//! directory is read from the process at each call. Each result is a new owned copy.
//!
//! # Gotchas
//! The provider exists only on Darwin on aarch64, and Linux with GNU libc on x86_64 or aarch64.
//!
//! # Examples
//! ## Read the working directory
//! ```silk
//! import silk.mem.allocator { Allocator, OutOfMemoryError }
//! import silk.collections.bytes { Bytes }
//! import silk.core.effect { Effect }
//! import silk.system.host_input { HostInput, HostInputError }
//! import silk.platform.native.host_input { NativeHostInput }
//! import silk.system.host_input_native { OsHostInput }
//!
//! effect fn program() -> i32
//!   ! HostInputError | OutOfMemoryError
//!   ? &mut Allocator {
//!   // A snapshot of the environment, with no arguments. No other code changes the environment now.
//!   let snapshot = run unsafe NativeHostInput.environmentSnapshot()
//!   let mut inputs = OsHostInput.make(move snapshot)
//!   let count = run HostInput.argumentCount() |> Effect.provideMut<HostInput>(&mut inputs)
//!   let directory = run HostInput.workingDirectory() |> Effect.provideMut<HostInput>(&mut inputs)
//!
//!   // The working directory is an absolute path.
//!   let path = Bytes.asSlice(&directory)
//!   if count != 0 || path.length == 0 || path[0] != 47 {
//!     return 1
//!   }
//!   return 0
//! }
//!
//! effect fn failed<E>(error: E) -> i32 {
//!   drop error
//!   return 1
//! }
//!
//! pub fn main() -> i32 {
//!   let mut allocator = Allocator.systemAllocatorProvider()
//!   return run Effect.catchAll(program(), failed) |> Effect.provideMut<Allocator>(&mut allocator)
//! }
//! ```
//!
//! @category System

static if (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText("libc") == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
  import silk.mem.allocator { Allocator, OutOfMemoryError }
  import silk.collections.bytes { Bytes }
  import silk.system.host_input { HostInput, HostInputError }
  import silk.platform.native.host_input { NativeHostInput }
  import silk.option { Option }
  import silk.text.string { String }

  /// The native `HostInput` provider. It owns a snapshot of the arguments and the environment.
  ///
  /// A native `main` that requires `&mut HostInput` gets one from `silk.platform.native.start`. The
  /// arguments and the environment come from the snapshot, so they do not change. The working
  /// directory is read from the process at each call. Each result is a new owned copy.
  pub struct OsHostInput { inputs: NativeHostInput }

  impl OsHostInput {
    /// Returns a provider that uses `inputs`. It does not allocate or read the process.
    pub fn make(inputs: NativeHostInput) -> OsHostInput {
      return OsHostInput { inputs: move inputs }
    }

    effect fn argumentCount(self: &mut Self) -> usize ! HostInputError {
      return NativeHostInput.argumentCount(&self.inputs)
    }

    effect fn argument(self: &mut Self, index: usize) -> Option<Bytes> ! HostInputError | OutOfMemoryError ? &mut Allocator {
      return run fetch(&self.inputs, true, index, String.utf8Bytes(""))
    }

    effect fn variable(self: &mut Self, name: &[u8]) -> Option<Bytes> ! HostInputError | OutOfMemoryError ? &mut Allocator {
      return run fetch(&self.inputs, false, 0, name)
    }

    effect fn workingDirectory(self: &mut Self) -> Bytes ! HostInputError | OutOfMemoryError ? &mut Allocator {
      return run NativeHostInput.workingDirectory()
    }
  }

  fn lookup(inputs: &NativeHostInput, argument: bool, index: usize, name: &[u8], output: &mut [u8]) -> Option<usize> {
    if argument { return NativeHostInput.argument(inputs, index, move output) }
    return NativeHostInput.variable(inputs, name, move output)
  }

  effect fn fetch(inputs: &NativeHostInput, argument: bool, index: usize, name: &[u8]) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
    let mut empty = Bytes.make()
    let found = lookup(inputs, argument, index, name, Bytes.asMutSlice(&mut empty))
    return match move found {
      Option<usize>.None => Option<Bytes>.none()
      Option<usize>.Some { value: length } => {
        let mut bytes = run Bytes.zeroed(length)
        let copied = lookup(inputs, argument, index, name, Bytes.asMutSlice(&mut bytes))
        return Option<Bytes>.some(move bytes)
      }
    }
  }

  impl HostInput for OsHostInput {
    argumentCount: OsHostInput.argumentCount
    argument: OsHostInput.argument
    variable: OsHostInput.variable
    workingDirectory: OsHostInput.workingDirectory
  }
}
