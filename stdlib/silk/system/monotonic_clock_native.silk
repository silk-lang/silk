//! The system provider of the `MonotonicClock` effect: a clock that never goes back.
//!
//! # When to use
//! Provide [`OsMonotonicClock`] for `MonotonicClock` in a program, to measure time and to wait for
//! deadlines. The same provider works on each supported target, a browser included. In a test,
//! provide a fake clock that you advance yourself.
//!
//! # Details
//! `waitUntil` blocks until the deadline. `waitFor` reads the clock one time, adds the duration,
//! and then waits until that deadline. `waitReady` waits in one `poll` for the handles, so it goes
//! on as soon as a socket is ready.
//!
//! # Gotchas
//! - An `Instant` from this clock means nothing to other clocks. Do not mix it with `SystemClock`
//!   times.
//! - A wait blocks the whole thread. It does not let another fiber run.
//! - A failure of the clock is a trap.
//! - On Linux, the clock stops while the system sleeps, and needs glibc 2.17 or later. On macOS, it
//!   counts the time of sleep. Windows QPC also includes system suspend; waits round up to
//!   milliseconds.
//! - On `wasm32-unknown-unknown`, it reads the host's `silk.clock` import (`performance.now()`).
//!   A JavaScript host cannot block, so a wait reads the clock until the deadline, and `waitReady`
//!   with handles traps.
//! - [`OsMonotonicClock.make`] requires a JavaScript host, WASI, Windows x86_64 with system
//!   libraries, Darwin x86_64 or aarch64, or GNU Linux x86_64 or aarch64.
//!
//! # Examples
//! ## Measure a wait
//! ```silk
//! import silk.core.effect { Effect }
//! import silk.system.monotonic_clock { MonotonicClock }
//! import silk.system.monotonic_clock_native { OsMonotonicClock }
//! import silk.system.system_clock { Instant, SystemClock }
//!
//! // Returns the nanoseconds from `start` to `end`.
//! fn elapsed(start: &Instant, end: &Instant) -> i64 {
//!   return (SystemClock.seconds(end) - SystemClock.seconds(start)) * 1000000000
//!     + SystemClock.nanoseconds(end)
//!     - SystemClock.nanoseconds(start)
//! }
//!
//! effect fn measure() -> i32
//!   ? &mut MonotonicClock {
//!   let start = run MonotonicClock.now()
//!
//!   // Wait for 1 millisecond.
//!   run MonotonicClock.waitFor(1000000)
//!   let end = run MonotonicClock.now()
//!   if elapsed(&start, &end) < 1000000 {
//!     return 1
//!   }
//!   return 0
//! }
//!
//! pub fn main() -> i32 {
//!   let mut clock = OsMonotonicClock.make()
//!   return run measure() |> Effect.provideMut<MonotonicClock>(&mut clock)
//! }
//! ```
//!
//! @category System

import silk.platform.native.clock { NativeClock }
import silk.system.system_clock { Instant }
import silk.system.monotonic_clock { MonotonicClock, ReadyWatch }
import silk.core.option { Option }

/// The system `MonotonicClock` provider. It has no state. A failure is a trap.
///
/// # Details
/// `waitUntil` blocks until the deadline. `waitFor` reads the clock one time, adds the duration,
/// and then waits until that deadline.
///
/// # Gotchas
/// - An `Instant` from this clock means nothing to other clocks. Do not mix it with `SystemClock`
///   times.
/// - A wait blocks the whole thread. It does not let another fiber run.
/// - On Linux, the clock stops while the system sleeps, and needs glibc 2.17 or later. On macOS, it
///   counts the time of sleep. Windows QPC also includes system suspend; waits round up to
///   milliseconds.
pub struct OsMonotonicClock {}

impl OsMonotonicClock {
  /// Returns a clock. It does not read the time.
  pub fn make() -> OsMonotonicClock {
    static if (Intrinsic.targetObjectFormat() == "wasm" && Intrinsic.targetOperatingSystem() != "wasi") || (Intrinsic.targetOperatingSystem() == "windows" && Intrinsic.targetArchitecture() == "x86_64" && Intrinsic.targetAbi() == "msvc" && Intrinsic.profileText("libc") == "system") || Intrinsic.targetOperatingSystem() == "wasi" || (Intrinsic.targetOperatingSystem() == "darwin" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64") && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText("libc") == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
      return OsMonotonicClock {}
    } else { compileError("OsMonotonicClock requires a JavaScript host, WASI, Windows, Darwin or a GNU libc profile") }
  }
}

impl MonotonicClock for OsMonotonicClock {
  effect fn now(self: &mut Self) -> Instant { return run NativeClock.now(true) }
  effect fn getResolution(self: &mut Self) -> u64 { return run NativeClock.resolution(true) }
  effect fn waitUntil(self: &mut Self, when: Instant) -> () {
    return run NativeClock.waitUntil(move when)
  }
  effect fn waitFor(self: &mut Self, howLong: u64) -> () {
    let start = run NativeClock.now(true)
    let deadline = MonotonicClock.deadlineAfter(&start, howLong)
    return run NativeClock.waitUntil(move deadline)
  }
  effect fn waitReady(self: &mut Self, watch: &mut [ReadyWatch], until: Option<Instant>) -> usize {
    return run NativeClock.waitReady(&mut watch, move until)
  }
}

impl OsMonotonicClock {
  /// Polls `watch` once without waiting, and returns how many handles are ready.
  ///
  /// # When to use
  ///
  /// A test clock that moves its own time calls it in its `waitReady`, so that real sockets still
  /// make progress.
  pub fn pollNow(watch: &mut [ReadyWatch]) -> usize {
    return NativeClock.pollNow(&mut watch)
  }
}
