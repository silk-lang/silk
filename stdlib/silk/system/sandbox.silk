//! Constructs operating-system sandbox requests for declared tool inputs and outputs.

import silk.system.host_path as HostPath
import silk.system.child_process { ChildProcess, ProcessRequest }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.option { Option }
import silk.num.usize

// The system directories a sandboxed step reads: programs, libraries, their configuration and the
// device and process files every program expects.
fn systemDirectories() -> [&'static [u8]; 7] {
  return [b"/usr", b"/bin", b"/lib", b"/lib64", b"/etc", b"/dev", b"/proc"]
}

/// Runs `program` sandboxed in `writable[0]`, its working directory, through
/// `silkc sandbox-exec` (`launcher`) on Linux, and through `sandbox-exec -p <profile>` (`launcher`)
/// on macOS. It reads the system's programs and libraries, `program` and `readable`, writes only
/// below `writable` and opens no TCP connection.
pub effect fn request(launcher: &Path, program: &Path, readable: &[Path], writable: &[&Path]) -> ProcessRequest
! FileError | OutOfMemoryError ? &mut Allocator {
  if writable.length == usize.ZERO { fail FileSystem.error(FileSystem.pathOperation(), FileSystem.invalidPath()) }
  static if Intrinsic.targetOperatingSystem() == "darwin" {
    let mut sandboxed = run ChildProcess.requestWithin(launcher, writable[usize.ZERO])
    run ChildProcess.addArgumentBytes(&mut sandboxed, b"-p")
    let profile = run darwinProfile(program, readable, writable)
    run ChildProcess.addArgumentBytes(&mut sandboxed, Bytes.asSlice(&profile))
    run ChildProcess.addArgumentBytes(&mut sandboxed, Path.rawBytes(program))
    return move sandboxed
  }
  let mut sandboxed = run ChildProcess.requestWithin(launcher, writable[usize.ZERO])
  run ChildProcess.addArgumentBytes(&mut sandboxed, b"sandbox-exec")
  let system = systemDirectories()
  let mut place = usize.ZERO
  while place < usize.add(0, 7) {
    run ChildProcess.addArgumentBytes(&mut sandboxed, b"--read")
    run ChildProcess.addArgumentBytes(&mut sandboxed, system[place])
    place = place + usize.ONE
  }
  run ChildProcess.addArgumentBytes(&mut sandboxed, b"--read")
  run ChildProcess.addArgumentBytes(&mut sandboxed, Path.rawBytes(program))
  place = usize.ZERO
  while place < readable.length {
    run ChildProcess.addArgumentBytes(&mut sandboxed, b"--read")
    run ChildProcess.addArgumentBytes(&mut sandboxed, Path.rawBytes(&readable[place]))
    place = place + usize.ONE
  }
  place = usize.ZERO
  while place < writable.length {
    run ChildProcess.addArgumentBytes(&mut sandboxed, b"--write")
    run ChildProcess.addArgumentBytes(&mut sandboxed, Path.rawBytes(writable[place]))
    place = place + usize.ONE
  }
  run ChildProcess.addArgumentBytes(&mut sandboxed, b"--write")
  run ChildProcess.addArgumentBytes(&mut sandboxed, b"/dev/null")
  run ChildProcess.addArgumentBytes(&mut sandboxed, b"--")
  run ChildProcess.addArgumentBytes(&mut sandboxed, Path.rawBytes(program))
  return move sandboxed
}

// `path` resolved through symbolic links, as the macOS sandbox matches paths (`/tmp` is
// `/private/tmp`); `path` itself when it cannot be.
effect fn real(path: &[u8]) -> Bytes ! OutOfMemoryError ? &mut Allocator {
  if let Option<Bytes>.Some { value } = move run HostPath.canonicalBytes(path) { return move value }
  return run Bytes.copy(path)
}

// Appends `(subpath "<path>")` with `path` resolved and quoted for the sandbox profile language.
effect fn appendSubpath(profile: &mut Bytes, path: &[u8]) -> () ! OutOfMemoryError ? &mut Allocator {
  let resolved = run real(path)
  let text = Bytes.asSlice(&resolved)
  run Bytes.append(&mut profile.*, b" (subpath \"")
  let mut at = usize.ZERO
  while at < text.length {
    if text[at] == 34 || text[at] == 92 { run Bytes.append(&mut profile.*, b"\\") }
    run Bytes.append(&mut profile.*, &[text[at]])
    at = at + usize.ONE
  }
  run Bytes.append(&mut profile.*, b"\")")
  return ()
}

// The macOS sandbox profile of a step: everything denied but running programs, reading the system,
// its program and inputs, and reading and writing its output directory. No network rule is
// granted, so the step has none.
effect fn darwinProfile(program: &Path, readable: &[Path], writable: &[&Path]) -> Bytes ! FileError | OutOfMemoryError ? &mut Allocator {
  let mut profile = run Bytes.copy(b"(version 1)(deny default)(allow process-fork process-exec)(allow signal (target same-sandbox))")
  run Bytes.append(&mut profile, b"(allow sysctl-read)(allow file-read-metadata)")
  run Bytes.append(&mut profile, b"(allow mach-lookup (global-name \"com.apple.system.logger\") (global-name \"com.apple.system.notification_center\") (global-name \"com.apple.system.opendirectoryd.libinfo\"))")
  run Bytes.append(&mut profile, b"(allow ipc-posix-shm-read-data (ipc-posix-name \"apple.shm.notification_center\"))")
  run Bytes.append(&mut profile, b"(allow file-read* (literal \"/\") (subpath \"/usr\") (subpath \"/bin\") (subpath \"/sbin\") (subpath \"/System\") (subpath \"/Library/Apple\") (subpath \"/private/etc\") (subpath \"/private/var/db/timezone\") (subpath \"/private/var/select\") (subpath \"/dev\")")
  run appendSubpath(&mut profile, Path.rawBytes(program))
  let mut at = usize.ZERO
  while at < readable.length {
    run appendSubpath(&mut profile, Path.rawBytes(&readable[at]))
    at = at + usize.ONE
  }
  run Bytes.append(&mut profile, b")(allow file-read* file-write* (literal \"/dev/null\") (literal \"/dev/zero\") (literal \"/dev/tty\")")
  at = usize.ZERO
  while at < writable.length {
    run appendSubpath(&mut profile, Path.rawBytes(writable[at]))
    at = at + usize.ONE
  }
  run Bytes.append(&mut profile, b")")
  return move profile
}

