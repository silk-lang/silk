//! The `MonotonicClock` effect: time that never goes back, for durations, timeouts, and waits.
//!
//! # When to use
//! Require `&mut MonotonicClock` to measure how long something takes, to compute a deadline, or to
//! wait, for a time or for a socket. Use `silk.system.system_clock` when you need the date and time
//! of day.
//!
//! # Details
//! [`MonotonicClock.now`] returns an [`Instant`] from an origin that is not specified, such as the
//! start of the computer. Each read is equal to or later than the read before it. A mark or a
//! deadline has a meaning only for the clock that made it.
//!
//! Durations are `u64` nanoseconds. A duration literal such as `300ms` has this type.
//! [`MonotonicClock.deadlineAfter`] adds a duration to a mark.
//!
//! [`MonotonicClock.waitReady`] waits until a socket in a slice of [`ReadyWatch`] is ready, or a
//! mark is reached. All socket waits go through it, so the provider decides how a wait happens: the
//! native clock blocks the thread in `poll`, and a task scheduler parks only the task.
//!
//! # Gotchas
//! `Instant` is also the type of system time. The compiler cannot stop you from mixing marks of
//! different clocks, or a mark with system time. The native provider blocks the thread when it
//! waits. A task scheduler provides a clock whose waits pause only one task. A test clock can move
//! its time forward without sleeping. If a provider returns a value that is not valid, the program
//! traps, because this effect has no error type.
//!
//! # Examples
//! ## Use a test clock that moves forward without sleeping
//! ```silk
//! import silk.core.effect { Effect }
//! import silk.core.option { Option }
import silk.core.ownership { Copy }
//! import silk.system.monotonic_clock { MonotonicClock, ReadyWatch }
//! import silk.system.system_clock { Instant, SystemClock }
//!
//! struct VirtualClock {
//!   mark: Instant,
//! }
//!
//! impl MonotonicClock for VirtualClock {
//!   effect fn now(self: &mut Self) -> Instant {
//!     return SystemClock.make(SystemClock.seconds(&self.mark), SystemClock.nanoseconds(&self.mark))
//!   }
//!
//!   effect fn getResolution(self: &mut Self) -> u64 {
//!     return 1
//!   }
//!
//!   effect fn waitUntil(self: &mut Self, when: Instant) -> () {
//!     self.mark = move when
//!     return ()
//!   }
//!
//!   effect fn waitFor(self: &mut Self, howLong: u64) -> () {
//!     self.mark = MonotonicClock.deadlineAfter(&self.mark, howLong)
//!     return ()
//!   }
//!
//!   // No handle is ever ready on this clock, so a wait moves to `until`.
//!   effect fn waitReady(self: &mut Self, watch: &mut [ReadyWatch], until: Option<Instant>) -> usize {
//!     match move until {
//!       Option<Instant>.Some {value} => { self.mark = move value }
//!       Option<Instant>.None => Intrinsic.trap("VirtualClock: no handle will be ready")
//!     }
//!     return 0
//!   }
//! }
//!
//! pub fn main() -> i32 {
//!   let mut clock = VirtualClock { mark: SystemClock.make(0, 900000000) }
//!   run MonotonicClock.waitFor(300ms) |> Effect.provideMut<MonotonicClock>(&mut clock)
//!   if SystemClock.seconds(&clock.mark) != 1 || SystemClock.nanoseconds(&clock.mark) != 200000000 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category System

import silk.num.i64
import silk.core.option { Option }
import silk.system.system_clock { SystemClock }
import silk.system.system_clock { Instant }
import silk.num.u64
import silk.num.i32
import silk.num.usize

/// The effect for a clock that never goes back, for durations, timeouts, and waits.
///
/// # When to use
///
/// Require `&mut MonotonicClock` to measure how long something takes, to compute a deadline, or to
/// wait. Use `silk.system.system_clock` when you need the date and time of day.
///
/// # Details
///
/// [`MonotonicClock.now`] returns an `Instant` from an origin that is not specified, such as the
/// start of the computer. Durations are `u64` nanoseconds. A duration literal such as `300ms` has
/// this type. A provider implements all five operations on one timeline. Exclusive access lets
/// a test provider move its own time forward and record waits.
///
/// # Gotchas
///
/// A mark or a deadline has a meaning only for the clock that made it. `Instant` is also the type
/// of system time, and the compiler cannot stop you from mixing marks of different clocks, or a
/// mark with system time. The native provider blocks the thread when it waits. A task scheduler
/// provides a clock whose waits pause only one task. If a provider returns a value that is not
/// valid, the program traps, because this effect has no error type.
pub service MonotonicClock {
  /// Returns the current mark. It is equal to or later than each earlier mark of the same clock.
  effect fn now() -> Instant ? &mut MonotonicClock

  /// Returns the tick of the clock in nanoseconds. It is at least 1. The real precision can be
  /// lower.
  effect fn getResolution() -> u64 ? &mut MonotonicClock

  /// Returns when the clock reaches `when`. If `when` is in the past, it returns at once.
  ///
  /// # Gotchas
  ///
  /// `when` must be a mark of the same clock. The native provider blocks the calling thread.
  effect fn waitUntil(when: Instant) -> () ? &mut MonotonicClock

  /// Returns when at least `howLong` nanoseconds have passed on the clock.
  ///
  /// # Gotchas
  ///
  /// A duration of 0 can return at once. If the deadline does not fit in an `Instant`, the provider
  /// traps.
  effect fn waitFor(howLong: u64) -> () ? &mut MonotonicClock

  /// Returns when a handle in `watch` is ready, or when the clock reaches `until`, and returns how
  /// many handles are ready.
  ///
  /// # Details
  ///
  /// The provider first clears the events of each watch, then sets the events that came. A return
  /// of 0 means that `until` was reached. With `until` of `None`, it waits until a handle is ready.
  /// With an empty `watch`, it waits until `until`, as [`waitUntil`] does.
  ///
  /// # Gotchas
  ///
  /// The native provider blocks the calling thread in one `poll`. A task scheduler parks only the
  /// task. An empty `watch` with `until` of `None` would wait forever, so it traps.
  effect fn waitReady(watch: &mut [ReadyWatch], until: Option<Instant>) -> usize ? &mut MonotonicClock
}

impl MonotonicClock {
  /// Returns the mark that is `howLong` nanoseconds after `start`.
  ///
  /// # When to use
  ///
  /// Use it to compute a deadline for operations that take one, such as
  /// `silk.io.byte_duplex.ByteDuplex.readSome`: `MonotonicClock.deadlineAfter(&now, 5000ms)`.
  ///
  /// # Details
  ///
  /// Every `u64` duration works when the result fits in an `Instant`.
  ///
  /// # Gotchas
  ///
  /// It traps if the seconds of the result do not fit in `i64`. Use `start` from the same clock
  /// that will use the deadline.
  pub fn deadlineAfter(start: &Instant, howLong: u64) -> Instant {
    let startSeconds = SystemClock.seconds(start)
    let startNanoseconds = SystemClock.nanoseconds(start)
    let billion = u64.toU64(1000000000)
    let wholeSeconds = requireI64(u64.checkedToI64(howLong / billion))
    let fraction = u64.toI64(howLong % billion)
    let mut deadlineNanoseconds = startNanoseconds + fraction
    let mut carry = i64.toI64(0)
    if deadlineNanoseconds >= 1000000000 {
      deadlineNanoseconds = deadlineNanoseconds - 1000000000
      carry = i64.toI64(1)
    }
    let extended = requireI64(i64.checkedAdd(startSeconds, wholeSeconds))
    let deadlineSeconds = requireI64(i64.checkedAdd(extended, carry))
    return SystemClock.make(deadlineSeconds, deadlineNanoseconds)
  }
}

static if Intrinsic.targetOperatingSystem() == "windows" {
  type ReadyHandle = usize
  const READ_EVENTS: i16 = 256
  const WRITE_EVENTS: i16 = 16
  const ERROR_EVENTS: i16 = 1
  const HANGUP_EVENTS: i16 = 2
  const INVALID_EVENTS: i16 = 4
} else {
  type ReadyHandle = i32
  const READ_EVENTS: i16 = 1
  const WRITE_EVENTS: i16 = 4
  const ERROR_EVENTS: i16 = 8
  const HANGUP_EVENTS: i16 = 16
  const INVALID_EVENTS: i16 = 32
}

/// One operating system handle that [`MonotonicClock.waitReady`] watches: the events to wait for,
/// and the events that came.
///
/// # When to use
///
/// Make one with [`ReadyWatch.forRead`] or [`ReadyWatch.forWrite`] for a socket that is not ready,
/// and give a slice of them to `waitReady`. After the wait, ask each watch what came.
///
/// # Details
///
/// The layout is the C `struct pollfd` of the target, so the native provider polls the slice in
/// place. A handle is a file descriptor, or a socket on Windows.
///
/// # Gotchas
///
/// [`ReadyWatch.hungUp`], [`ReadyWatch.failed`] and [`ReadyWatch.invalid`] can be set even
/// though the watch did not ask for them. The next read or write on the handle tells the error.
pub extern "C" struct ReadyWatch {
  handleValue: ReadyHandle,
  interestValue: i16,
  eventsValue: i16,
}

impl Copy for ReadyWatch {}

impl ReadyWatch {
  /// Returns a watch that waits until `handle` can be read, or has reached its end.
  pub fn forRead(handle: usize) -> ReadyWatch {
    return ReadyWatch {handleValue: readyHandle(handle), interestValue: READ_EVENTS, eventsValue: 0}
  }

  /// Returns a watch that waits until `handle` can be written.
  pub fn forWrite(handle: usize) -> ReadyWatch {
    return ReadyWatch {handleValue: readyHandle(handle), interestValue: WRITE_EVENTS, eventsValue: 0}
  }

  /// Returns the handle that the watch waits for.
  pub fn handle(self: &Self) -> usize {
    static if Intrinsic.targetOperatingSystem() == "windows" { return self.handleValue }
    else { return i32.toUsize(self.handleValue) }
  }

  /// Returns whether the watch waits for reading.
  pub fn wantsRead(self: &Self) -> bool { return (self.interestValue & READ_EVENTS) != 0 }

  /// Returns whether the watch waits for writing.
  pub fn wantsWrite(self: &Self) -> bool { return (self.interestValue & WRITE_EVENTS) != 0 }

  /// Returns whether any event came in the last wait.
  pub fn isReady(self: &Self) -> bool { return self.eventsValue != 0 }

  /// Returns whether the handle can be read.
  pub fn canRead(self: &Self) -> bool { return (self.eventsValue & READ_EVENTS) != 0 }

  /// Returns whether the handle can be written.
  pub fn canWrite(self: &Self) -> bool { return (self.eventsValue & WRITE_EVENTS) != 0 }

  /// Returns whether the peer closed the connection.
  pub fn hungUp(self: &Self) -> bool { return (self.eventsValue & HANGUP_EVENTS) != 0 }

  /// Returns whether the handle has a pending error.
  pub fn failed(self: &Self) -> bool { return (self.eventsValue & ERROR_EVENTS) != 0 }

  /// Returns whether the handle is not open.
  pub fn invalid(self: &Self) -> bool { return (self.eventsValue & INVALID_EVENTS) != 0 }

  /// Clears the events, before a new wait.
  pub fn clear(self: &mut Self) -> () {
    self.eventsValue = 0
    return ()
  }

  /// Marks the events that the watch asked for as come. A test clock uses it to report readiness.
  pub fn markReady(self: &mut Self) -> () {
    self.eventsValue = self.interestValue
    return ()
  }

  /// Copies the events of `source` into this watch. A scheduler uses it to hand back the result of
  /// a wait that it forwarded.
  pub fn takeEvents(self: &mut Self, source: &ReadyWatch) -> () {
    self.eventsValue = source.eventsValue
    return ()
  }
}

fn readyHandle(handle: usize) -> ReadyHandle {
  static if Intrinsic.targetOperatingSystem() == "windows" { return handle }
  else {
    if handle > 2147483647 { Intrinsic.trap("ReadyWatch: the handle does not fit in a file descriptor") }
    return usize.toI32(handle)
  }
}

fn invalidI64() -> i64 {
  return Intrinsic.trap("MonotonicClock: the time does not fit in i64 nanoseconds")
}

fn requireI64(value: Option<i64>) -> i64 {
  return match move value {
    Option<i64>.None => invalidI64()
    Option<i64>.Some { value: present } => present
  }
}

