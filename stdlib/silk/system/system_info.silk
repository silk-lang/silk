//! The `SystemInfo` effect: facts about the computer and the running process that the operating
//! system reports, such as the host name, the memory, the processors, the network interfaces, the
//! current user, and the resource usage of the process.
//!
//! # When to use
//! Require `&mut SystemInfo` in code that reports on the host or on its own process, such as an
//! `os` module of a language runtime, a status page, or a tool that sizes its work to the memory.
//! A test can provide fixed values. `silk.system.system_info_native` has the provider for native
//! programs.
//!
//! # Details
//! Each operation asks the operating system again, so two calls can give different values. The
//! operations never wait for an event: each one makes a few system calls or reads a few files of
//! the system, and returns.
//!
//! Text that the system reports, such as a host name, a path, or a user name, is returned as
//! owned `Bytes`, because the system does not promise UTF-8. Use `String.fromUtf8` when you need
//! text.
//!
//! Environment variables are not read. A runtime that follows `HOME` or `TMPDIR` reads them with
//! `silk.system.host_input`, and uses [`UserInfo`] when `HOME` is not set.
//!
//! # Errors
//! - [`SystemInfoError`] when the system cannot answer: the [`SystemInfoOperation`] and the native
//!   error code.
//! - `OutOfMemoryError` when the `Allocator` cannot supply a returned value.
//!
//! # Examples
//! ## Read the memory of the computer
//! ```silk
//! import silk.core.effect { Effect }
//! import silk.core.result { Result }
//! import silk.system.system_info { MemoryInfo, SystemInfo, SystemInfoError }
//! import silk.system.system_info_native { OsSystemInfo }
//!
//! pub effect fn main() -> i32 {
//!   let mut provider = OsSystemInfo.make()
//!   let result = run Effect.result(SystemInfo.memory()) |> Effect.provideMut<SystemInfo>(&mut provider)
//!   return match move result {
//!     Result<MemoryInfo, SystemInfoError>.Success { value } => {
//!       // The free memory is never more than the total.
//!       if value.total == 0 || value.free > value.total { 1 } else { 0 }
//!     }
//!     Result<MemoryInfo, SystemInfoError>.Failure { .. } => 1
//!   }
//! }
//! ```
//!
//! @category System

import silk.collections.bytes { Bytes }
import silk.collections.list { List }
import silk.core.option { Option }
import silk.core.ownership { Copy }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.net.address { IpAddress }

/// The operation of [`SystemInfo`] that failed.
pub enum SystemInfoOperation {
  /// Reading the host name, in [`SystemInfo.hostName`].
  HostName,
  /// Reading the kernel names, in [`SystemInfo.kernel`].
  Kernel,
  /// Reading the time since boot, in [`SystemInfo.uptime`].
  Uptime,
  /// Reading the load averages, in [`SystemInfo.loadAverage`].
  LoadAverage,
  /// Reading the memory counts, in [`SystemInfo.memory`].
  Memory,
  /// Reading the processors, in [`SystemInfo.processors`].
  Processors,
  /// Reading the processors that the process may use, in [`SystemInfo.availableParallelism`].
  Parallelism,
  /// Reading the network interfaces, in [`SystemInfo.networkInterfaces`].
  NetworkInterfaces,
  /// Reading a user account, in [`SystemInfo.currentUser`] or [`SystemInfo.user`].
  User,
  /// Reading a scheduling priority, in [`SystemInfo.priority`].
  Priority,
  /// Changing a scheduling priority, in [`SystemInfo.setPriority`].
  SetPriority,
  /// Reading resource usage, in [`SystemInfo.resourceUsage`].
  ResourceUsage,
  /// Reading the resident memory of the process, in [`SystemInfo.residentSetSize`].
  ResidentSetSize,
  /// Reading the path of the program file, in [`SystemInfo.executablePath`].
  ExecutablePath,
}

/// A failed [`SystemInfo`] operation: which one, and the native error code.
///
/// # Details
/// `code` is the `errno` value of the failed call, such as 2 (`ENOENT`) for a user id that has no
/// account, 3 (`ESRCH`) for a process that does not exist, or 13 (`EACCES`) for a priority that
/// the process may not set. For a failed Mach call on macOS, it is the `kern_return_t` value. It
/// is 0 when the system answered with data that is not valid.
pub struct SystemInfoError {
  /// The operation that failed.
  pub operation: SystemInfoOperation,
  /// The native error code, or 0 for data that is not valid.
  pub code: i32,
}

impl Copy for SystemInfoError {}

/// The names of the running kernel, as `uname` reports them.
///
/// # Details
/// On Linux, `name` is `Linux`, and on macOS it is `Darwin`. `release` is the kernel release, such
/// as `6.8.0-45-generic`, `version` is the build text of the kernel, and `machine` is the hardware
/// name, such as `x86_64` or `arm64`.
pub struct KernelInfo {
  /// The kernel name, such as `Linux` or `Darwin`.
  pub name: Bytes,
  /// The kernel release, such as `6.8.0-45-generic`.
  pub release: Bytes,
  /// The build text of the kernel.
  pub version: Bytes,
  /// The hardware name, such as `x86_64` or `arm64`.
  pub machine: Bytes,
}

/// A memory limit of a control group, and the memory that the group uses now.
///
/// # Details
/// Linux reports it for a process in a cgroup with a `memory.max` (cgroup v2) or a
/// `memory.limit_in_bytes` (cgroup v1) limit, such as in a container.
pub struct MemoryLimit {
  /// The limit, in bytes.
  pub bytes: u64,
  /// The memory that the group uses now, in bytes, without the inactive file cache that the
  /// kernel drops before the group reaches its limit.
  pub used: u64,
}

impl Copy for MemoryLimit {}

/// The memory of the computer, in bytes.
///
/// # Details
/// `free` is memory that nothing uses. `available` also counts memory that the system can take
/// back at once, such as file caches, so it is at least `free` on Linux (`MemAvailable`). On
/// macOS, `available` is the free page count, the same as `free`.
///
/// `limit` is the memory limit of the control group of the process, when it has one. A process
/// with a limit can use at most `limit.bytes - limit.used` more bytes, also when `available` is
/// larger.
pub struct MemoryInfo {
  /// The physical memory, in bytes.
  pub total: u64,
  /// The memory that nothing uses, in bytes.
  pub free: u64,
  /// The memory that a new allocation can get without swapping, in bytes.
  pub available: u64,
  /// The memory limit of the control group of the process, if there is one.
  pub limit: Option<MemoryLimit>,
}

impl Copy for MemoryInfo {}

/// The time that one processor spent in each state since boot, in milliseconds.
pub struct ProcessorTimes {
  /// Time in user mode.
  pub user: u64,
  /// Time in user mode for processes with a lower priority.
  pub nice: u64,
  /// Time in kernel mode.
  pub system: u64,
  /// Time with nothing to do.
  pub idle: u64,
  /// Time spent on hardware interrupts. It is 0 on macOS.
  pub interrupt: u64,
}

impl Copy for ProcessorTimes {}

/// One logical processor: its model, its speed, and its times.
///
/// # Details
/// `model` is the model text of the system, such as `Intel(R) Xeon(R) CPU @ 2.20GHz`, or `unknown`
/// when the system has none. `speed` is the current clock speed in MHz, or 0 when the system does
/// not report it, as on Apple silicon.
pub struct ProcessorInfo {
  /// The model text, or `unknown`.
  pub model: Bytes,
  /// The clock speed in MHz, or 0 when it is not known.
  pub speed: u32,
  /// The time that the processor spent in each state since boot.
  pub times: ProcessorTimes,
}

/// One address of a network interface that is up.
///
/// # Details
/// An interface with more than one address gives one entry for each address, with the same name.
/// `mac` is the hardware address of the interface, or all zeros when it has none, such as a
/// loopback interface. `internal` is true for a loopback interface. `scopeId` is the scope of an
/// IPv6 address, such as the interface index of a link-local address, and 0 for IPv4.
pub struct NetworkInterface {
  /// The interface name, such as `eth0` or `en0`.
  pub name: Bytes,
  /// The address.
  pub address: IpAddress,
  /// The network mask, of the same family as the address.
  pub netmask: IpAddress,
  /// The hardware address, or all zeros.
  pub mac: [u8; 6],
  /// True for a loopback interface.
  pub internal: bool,
  /// The IPv6 scope, or 0.
  pub scopeId: u32,
}

/// A user account, from the user database of the system.
///
/// # Details
/// `home` and `shell` are empty when the account has none.
pub struct UserInfo {
  /// The login name.
  pub name: Bytes,
  /// The user id.
  pub uid: u32,
  /// The id of the primary group.
  pub gid: u32,
  /// The home directory.
  pub home: Bytes,
  /// The login shell.
  pub shell: Bytes,
}

/// Which resource usage [`SystemInfo.resourceUsage`] reports.
pub enum UsageScope {
  /// The whole process: all its threads.
  Process,
  /// The calling thread.
  Thread,
}

/// The resources that a process or a thread used, as `getrusage` reports them.
///
/// # Details
/// Times are in microseconds. `maxResidentBytes` is the largest resident memory so far, in bytes
/// on every system. The counters that a system does not keep are 0: Linux keeps no
/// `sharedMemory`, `unsharedData`, `unsharedStack`, `swaps`, `messagesSent`, `messagesReceived`,
/// or `signals`. For [`UsageScope.Thread`] on macOS, only the two times are reported.
pub struct ResourceUsage {
  /// CPU time in user mode, in microseconds.
  pub userMicroseconds: u64,
  /// CPU time in kernel mode, in microseconds.
  pub systemMicroseconds: u64,
  /// The largest resident memory so far, in bytes.
  pub maxResidentBytes: u64,
  /// The integral shared memory size (`ru_ixrss`).
  pub sharedMemory: u64,
  /// The integral unshared data size (`ru_idrss`).
  pub unsharedData: u64,
  /// The integral unshared stack size (`ru_isrss`).
  pub unsharedStack: u64,
  /// Page faults that needed no input or output.
  pub minorFaults: u64,
  /// Page faults that needed input or output.
  pub majorFaults: u64,
  /// Times the process was swapped out.
  pub swaps: u64,
  /// Block input operations.
  pub blockInputs: u64,
  /// Block output operations.
  pub blockOutputs: u64,
  /// IPC messages sent.
  pub messagesSent: u64,
  /// IPC messages received.
  pub messagesReceived: u64,
  /// Signals received.
  pub signals: u64,
  /// Context switches because the process waited.
  pub voluntaryContextSwitches: u64,
  /// Context switches because a higher priority process ran, or the time slice ended.
  pub involuntaryContextSwitches: u64,
}

impl Copy for ResourceUsage {}

/// The effect that reads facts about the computer and the running process from the operating
/// system.
///
/// # When to use
///
/// Require `&mut SystemInfo` in code that reports on the host or on its own process, such as an
/// `os` module of a language runtime. A test can provide fixed values. Use the provider in
/// `silk.system.system_info_native` in a native program.
///
/// # Details
///
/// Each operation asks the system again and returns without waiting for an event. Text that the
/// system reports is owned `Bytes`, because the system does not promise UTF-8. Environment
/// variables are not read: a runtime that follows `HOME` or `TMPDIR` reads them with
/// `silk.system.host_input`. Only [`SystemInfo.setPriority`] changes the system.
pub service SystemInfo {
  /// Returns the host name of the computer.
  ///
  /// # Errors
  ///
  /// - [`SystemInfoError`] with `HostName` if the system cannot report it.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the copy.
  effect fn hostName() -> Bytes ! SystemInfoError | OutOfMemoryError ? &mut SystemInfo | &mut Allocator

  /// Returns the names of the running kernel: name, release, version, and hardware.
  ///
  /// # Errors
  ///
  /// - [`SystemInfoError`] with `Kernel` if the system cannot report them.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the copies.
  effect fn kernel() -> KernelInfo ! SystemInfoError | OutOfMemoryError ? &mut SystemInfo | &mut Allocator

  /// Returns the time since the computer started, in nanoseconds. It counts time asleep.
  ///
  /// # Errors
  ///
  /// - [`SystemInfoError`] with `Uptime` if the system cannot report it.
  effect fn uptime() -> u64 ! SystemInfoError ? &mut SystemInfo

  /// Returns the 1, 5, and 15 minute load averages, in this order.
  ///
  /// # Details
  ///
  /// A load average is the mean number of threads that ran or waited to run.
  ///
  /// # Errors
  ///
  /// - [`SystemInfoError`] with `LoadAverage` if the system cannot report them.
  effect fn loadAverage() -> [f64; 3] ! SystemInfoError ? &mut SystemInfo

  /// Returns the total, free, and available memory of the computer, and the memory limit of the
  /// process when it has one.
  ///
  /// # Errors
  ///
  /// - [`SystemInfoError`] with `Memory` if the system cannot report them.
  effect fn memory() -> MemoryInfo ! SystemInfoError ? &mut SystemInfo

  /// Returns one entry for each logical processor that is online, in the order of the system.
  ///
  /// # Errors
  ///
  /// - [`SystemInfoError`] with `Processors` if the system cannot report them.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the list.
  effect fn processors() -> List<ProcessorInfo> ! SystemInfoError | OutOfMemoryError ? &mut SystemInfo | &mut Allocator

  /// Returns the number of processors that the process may run on, at least 1.
  ///
  /// # Details
  ///
  /// On Linux, it counts the CPU affinity mask of the process, so it can be less than the number
  /// of processors online. On macOS, it is the number of processors online.
  ///
  /// # Errors
  ///
  /// - [`SystemInfoError`] with `Parallelism` if the system cannot report it.
  effect fn availableParallelism() -> usize ! SystemInfoError ? &mut SystemInfo

  /// Returns one entry for each address of each network interface that is up and running.
  ///
  /// # Details
  ///
  /// Only IPv4 and IPv6 addresses are listed. An interface with no address is not listed.
  ///
  /// # Errors
  ///
  /// - [`SystemInfoError`] with `NetworkInterfaces` if the system cannot report them.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the list.
  effect fn networkInterfaces() -> List<NetworkInterface> ! SystemInfoError | OutOfMemoryError ? &mut SystemInfo | &mut Allocator

  /// Returns the account of the effective user of the process.
  ///
  /// # Errors
  ///
  /// - [`SystemInfoError`] with `User` if the account cannot be read, with code 2 (`ENOENT`) if the
  ///   user id has no account.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the copies.
  effect fn currentUser() -> UserInfo ! SystemInfoError | OutOfMemoryError ? &mut SystemInfo | &mut Allocator

  /// Returns the account of user id `uid`.
  ///
  /// # Errors
  ///
  /// - [`SystemInfoError`] with `User` if the account cannot be read, with code 2 (`ENOENT`) if
  ///   `uid` has no account.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the copies.
  effect fn user(uid: u32) -> UserInfo ! SystemInfoError | OutOfMemoryError ? &mut SystemInfo | &mut Allocator

  /// Returns the scheduling priority of process `pid`, from -20 (first) to 19 (last). Process 0 is
  /// the calling process.
  ///
  /// # Errors
  ///
  /// - [`SystemInfoError`] with `Priority`, with code 3 (`ESRCH`) if no process has the id.
  effect fn priority(pid: i32) -> i32 ! SystemInfoError ? &mut SystemInfo

  /// Sets the scheduling priority of process `pid` to `value`, from -20 (first) to 19 (last).
  /// Process 0 is the calling process. The system limits a value outside the range to it.
  ///
  /// # Errors
  ///
  /// - [`SystemInfoError`] with `SetPriority`, with code 3 (`ESRCH`) if no process has the id, or
  ///   13 (`EACCES`) or 1 (`EPERM`) if the process may not set that priority.
  effect fn setPriority(pid: i32, value: i32) -> () ! SystemInfoError ? &mut SystemInfo

  /// Returns the resources that the process or the calling thread used.
  ///
  /// # Errors
  ///
  /// - [`SystemInfoError`] with `ResourceUsage` if the system cannot report them.
  effect fn resourceUsage(scope: UsageScope) -> ResourceUsage ! SystemInfoError ? &mut SystemInfo

  /// Returns the resident memory of the process now, in bytes.
  ///
  /// # Errors
  ///
  /// - [`SystemInfoError`] with `ResidentSetSize` if the system cannot report it.
  effect fn residentSetSize() -> u64 ! SystemInfoError ? &mut SystemInfo

  /// Returns the absolute path of the program file of the process, with links resolved.
  ///
  /// # Errors
  ///
  /// - [`SystemInfoError`] with `ExecutablePath` if the system cannot report it.
  /// - `OutOfMemoryError` if the `Allocator` cannot supply the copy.
  effect fn executablePath() -> Bytes ! SystemInfoError | OutOfMemoryError ? &mut SystemInfo | &mut Allocator

  /// Returns the id of the process.
  effect fn processId() -> i32 ? &mut SystemInfo

  /// Returns the id of the parent process.
  effect fn parentProcessId() -> i32 ? &mut SystemInfo
}

impl SystemInfo {
  /// Returns a [`SystemInfoError`] for `operation` and the native error code `code`. Providers use
  /// it when an operation fails.
  pub fn failure(operation: SystemInfoOperation, code: i32) -> SystemInfoError {
    return SystemInfoError { operation: operation, code: code }
  }
}
