//! The built-in test runner that `silk test` selects. It runs tests one at a time.
//!
//! # Details
//! This module is a normal Silk application made from the public static test primitives. It finds
//! the tests in the compilation, applies the filters, runs each selected test in order, and writes
//! a receipt (see `silk.test_exchange`).
//!
//! The host passes these options. Each takes one value:
//!
//! | Option | Meaning |
//! |---|---|
//! | `--file` | Run only the tests in the file with exactly this path |
//! | `--filter` | Run only the tests whose `module::name` contains this text |
//! | `--silk-test-plan` | Path of the plan file. Required. |
//! | `--silk-test-result` | Path of the receipt file. Required. |
//! | `--silk-test-progress` | Path of the progress file. Optional. |
//! | `--silk-test-timeout` | Each test's time limit in whole seconds. Optional; `0` or absent is none. |
//!
//! The runner checks the complete plan before any test body runs.
//!
//! With `--silk-test-progress`, the runner writes a progress record (see `silk.test_exchange`)
//! before each test body runs, and removes the file when every test has finished. If the file
//! already holds a record when the runner starts, the test it names stopped an earlier runner
//! process, for example with a trap. The runner then reports that test as failed, skips the tests
//! before it, and continues with the next one, so its summary and receipt count the whole run.
//!
//! With a time limit on a native target with a C library, the runner sets an alarm before each test
//! body runs. A test that outlives it ends the process with `SIGALRM`, which the host reports as a
//! timeout before it continues with the next test.
//!
//! # Errors
//! The exit status is `0` if all selected tests pass, `1` if a test fails, and `2` for a usage
//! error, a plan that is not valid, or an I/O failure.
//!
//! @category Testing

import silk.allocator { Allocator, OutOfMemoryError }
import silk.bytes { Bytes }
import silk.effect { Effect }
import silk.filesystem { DirectoryInfo, FileError, FileInfo, FileSystem, Path }
import silk.format { Format }
import silk.host_input { HostInput, HostInputError }
import silk.monotonic_clock { MonotonicClock }
import silk.os_filesystem { OsFileSystem }
import silk.os_monotonic_clock { OsMonotonicClock }
import silk.option { Option }
import silk.os_writer { StdoutWriter }
import silk.result { Result }
import silk.sha2 { Sha256 }
import silk.string { InvalidUtf8, String }
import silk.system_clock { Instant, SystemClock }
import silk.test_exchange as TestExchange
import silk.testing { AssertionError, Testing }
import silk.u32
import silk.u64
import silk.u8
import silk.list { List }
import silk.writer { Writer, WriterError }
import silk.usize

struct TestOutcome<T> {}

interface CompleteTest<T> {
  fn passed(value: T) -> bool
}

impl CompleteTest<()> for TestOutcome<()> {
  fn passed(value: ()) -> bool { return true }
}

effect<'env> fn testFailed<E: 'env, 'env>(error: E) -> bool {
  drop error
  let status = Intrinsic.observeUnhandled()
  drop status
  return false
}

effect fn testSucceeded(value: ()) -> bool { return true }

// Adds `AssertionError` to a test's failure row, so the runner can select it whether or not the
// test can fail with one.
effect fn mayAssert(value: ()) -> () ! AssertionError<'static> { return value }

effect fn ignoreWriteFailure(error: WriterError) -> () {
  drop error
  return ()
}

effect fn writeAssertion(message: string) -> () ! WriterError ? &mut Writer {
  run Writer.writeString("    assertion failed: ")
  run Writer.writeString(message)
  return run Writer.writeString("\n")
}

// A failed expectation reports only its message under the test's name. The runner handles the
// failure, so it is not reported as an unhandled error.
effect fn assertionFailed(error: AssertionError<'static>) -> bool {
  let mut writer = StdoutWriter.make()
  let written = writeAssertion(Testing.assertionMessage(&error))
    |> Effect.provideMut<Writer>(&mut writer)
  run Effect.catchAll(move written, ignoreWriteFailure)
  drop error
  return false
}

impl<'env, E> CompleteTest<Effect<'env; () ! E>> for TestOutcome<Effect<'env; () ! E>> {
  fn passed(value: Effect<'env; () ! E>) -> bool {
    let checked = Effect.flatMap(move value, mayAssert)
    let completed = Effect.flatMap(move checked, testSucceeded)
    let asserted = Effect.catch<AssertionError<'static>>(move completed, assertionFailed)
    return run Effect.catchAll(move asserted, testFailed)
  }
}

fn selectOutcome<T>(value: &T) -> TestOutcome<T> { return TestOutcome<T> {} }

fn completeTest<T, P: CompleteTest<T>>(value: T, provider: P) -> bool {
  return CompleteTest<T>.passed(move value)
}

static if (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.profileText("libc") == "gnu") {
  unsafe extern "C" fn alarm(seconds: u32) -> u32

  // Schedules `SIGALRM` after `seconds`, replacing an earlier alarm; 0 cancels it.
  fn setAlarm(seconds: u32) -> () {
    let previous = unsafe alarm(seconds)
    drop previous
    return ()
  }
} else {
  // Without a C library the runner has no alarm, so tests have no time limit.
  fn setAlarm(seconds: u32) -> () { return () }
}

// The whole seconds that `text` spells in decimal digits, or `None`.
fn seconds(text: string) -> Option<u32> {
  let bytes = String.utf8Bytes(text)
  if bytes.length == usize.ZERO || bytes.length > 6 { return Option<u32>.none() }
  let mut value: u32 = 0
  let mut at = usize.ZERO
  while at < bytes.length {
    if bytes[at] < 48 || bytes[at] > 57 { return Option<u32>.none() }
    value = value * 10 + u8.toU32(bytes[at] - 48)
    at = at + usize.ONE
  }
  return Option<u32>.some(value)
}

fn elapsedNanoseconds(start: &Instant, end: &Instant) -> i64 {
  let seconds = SystemClock.seconds(end) - SystemClock.seconds(start)
  let nanoseconds = SystemClock.nanoseconds(end) - SystemClock.nanoseconds(start)
  return seconds * 1000000000 + nanoseconds
}

effect fn writeDuration(nanoseconds: i64) -> () ! WriterError ? &mut Writer {
  if nanoseconds < 1000 {
    return run Writer.writeString("<1 us")
  }
  if nanoseconds < 1000000 {
    let microseconds = nanoseconds / 1000
    run Format.display(&microseconds)
    return run Writer.writeString(" us")
  }
  let milliseconds = nanoseconds / 1000000
  run Format.display(&milliseconds)
  return run Writer.writeString(" ms")
}

effect fn writeResult(passed: bool, nanoseconds: i64) -> () ! WriterError ? &mut Writer {
  if passed {
    run Writer.writeString("    PASS  ")
  } else {
    run Writer.writeString("    FAIL  ")
  }
  run writeDuration(nanoseconds)
  return run Writer.writeString("\n")
}

fn discoveredCount() -> u64 {
  let mut discovered: u64 = 0
  static for descriptor in Intrinsic.tests() { discovered = discovered + 1 }
  return discovered
}

fn catalogDigest() -> [u8; 32] {
  let mut state = Sha256.make()
  let mut ordinal: u64 = 0
  static for descriptor in Intrinsic.tests() {
    let identity = Intrinsic.testInfo(descriptor).identity
    TestExchange.updateCatalogDigest(&mut state, ordinal, String.utf8Bytes(identity))
    ordinal = ordinal + 1
  }
  return state.finish()
}

fn validatePlan(bytes: &[u8], discovered: u64) -> i32 {
  let mut plan = TestExchange.openPlan(bytes)
  if TestExchange.isPerTest(&plan) {
    if !TestExchange.beginPerTest(&mut plan, discovered) { return 11 }
    let mut ordinal: u64 = 0
    static for descriptor in Intrinsic.tests() {
      let identity = Intrinsic.testInfo(descriptor).identity
      let entry = TestExchange.readEntry(&mut plan, ordinal, String.utf8Bytes(identity))
      drop entry
      if TestExchange.failed(&plan) { return 12 }
      ordinal = ordinal + 1
    }
    if TestExchange.finishPerTest(&mut plan) { return 0 }
    return 13
  }
  if TestExchange.isUncached(&plan) {
    let digest = catalogDigest()
    if TestExchange.validateUncached(&mut plan, &digest, discovered) { return 0 }
    return 21
  }
  return 1
}

fn selectedCount<'file, 'name>(fileFilter: string<'file>, nameFilter: string<'name>) -> u64 {
  let mut selected: u64 = 0
  static for descriptor in Intrinsic.tests() {
    if Testing.matchesQualified(
      Intrinsic.testInfo(descriptor).path,
      Intrinsic.testInfo(descriptor).module,
      Intrinsic.testInfo(descriptor).name,
      fileFilter,
      nameFilter,
    ) { selected = selected + 1 }
  }
  return selected
}

// Records that the test at `ordinal` is starting, after the given counts, so that a later runner can
// continue after it if it stops the process.
effect fn recordProgress(path: &Option<Path>, progress: TestExchange.Progress) -> ()
! OutOfMemoryError | FileError
? &mut Allocator | &mut FileSystem {
  if let Option<Path>.Some { value } = &path.* {
    let record = run TestExchange.progressRecord(&progress)
    run FileSystem.writeFile(&value, Bytes.asSlice(&record))
  }
  return ()
}

// The record an earlier runner left in the progress file, or `None` when there is none.
effect fn resumedProgress(path: &Option<Path>) -> Option<TestExchange.Progress> ? &mut FileSystem | &mut Allocator {
  if let Option<Path>.Some { value } = &path.* {
    let read = run Effect.result(FileSystem.readFile(&value))
    if let Result<Bytes, FileError | OutOfMemoryError>.Success { value: bytes } = &read {
      return TestExchange.readProgress(Bytes.asSlice(&bytes))
    }
    drop read
  }
  return Option<TestExchange.Progress>.none()
}

effect fn runSelected<'file, 'name>(
  fileFilter: string<'file>,
  nameFilter: string<'name>,
  planBytes: &[u8],
  resultPath: &Path,
  progressPath: Option<Path>,
  limit: u32,
) -> i32
! OutOfMemoryError | FileError | WriterError
? &mut Allocator | &mut FileSystem | &mut Writer {
  let discovered = discoveredCount()
  if validatePlan(planBytes, discovered) != 0 { return 2 }
  let opened = TestExchange.openPlan(planBytes)
  let perTest = TestExchange.isPerTest(&opened)
  drop opened
  let selected = selectedCount(fileFilter, nameFilter)
  let mut receipt = run TestExchange.beginReceipt(planBytes, perTest, selected)
  let mut plan = TestExchange.openPlan(planBytes)
  if perTest {
    let began = TestExchange.beginPerTest(&mut plan, discovered)
    drop began
  }
  let mut ordinal: u64 = 0
  let mut cached: u64 = 0
  let mut executed: u64 = 0
  let mut passed: u64 = 0
  let mut failed: u64 = 0
  // The test that stopped an earlier runner failed; the tests before it already ran there.
  let mut resumed = false
  let mut stopped: u64 = 0
  if let Option<TestExchange.Progress>.Some { value } = run resumedProgress(&progressPath) {
    resumed = true
    stopped = value.ordinal
    cached = value.cachedCount
    executed = value.executed + 1
    passed = value.passed
    failed = value.failedCount + 1
  }
  let mut clock = OsMonotonicClock.make()
  let started = run MonotonicClock.now()
    |> Effect.provideMut<MonotonicClock>(&mut clock)
  static for descriptor in Intrinsic.tests() {
    let declaration = String.utf8Bytes(Intrinsic.testInfo(descriptor).identity)
    let entry = TestExchange.readEntry(&mut plan, ordinal, declaration)
    if resumed && ordinal <= stopped {
      // The earlier runner already wrote this test's name; its trap report followed.
      if ordinal == stopped { run Writer.writeString("    FAIL  stopped the test process\n") }
    } else if Testing.matchesQualified(
      Intrinsic.testInfo(descriptor).path,
      Intrinsic.testInfo(descriptor).module,
      Intrinsic.testInfo(descriptor).name,
      fileFilter,
      nameFilter,
    ) {
      let module = Intrinsic.testInfo(descriptor).module
      let name = Intrinsic.testInfo(descriptor).name
      let identity = .{module: module, name: name}
      run Format.format("  {module}::{name}\n", &identity)
      if perTest && TestExchange.cached(&entry) {
        run Writer.writeString("    CACHED\n")
        run TestExchange.appendResult(
          &mut receipt,
          ordinal,
          declaration,
          TestExchange.executionIdentity(&entry),
          0,
        )
        cached = cached + 1
        passed = passed + 1
      } else {
        run recordProgress(&progressPath, TestExchange.Progress {
          ordinal: ordinal, cachedCount: cached, executed: executed, passed: passed, failedCount: failed,
        })
        let body = Intrinsic.testFunction(descriptor)
        let testStarted = run MonotonicClock.now()
          |> Effect.provideMut<MonotonicClock>(&mut clock)
        setAlarm(limit)
        let value = body()
        let provider = selectOutcome(&value)
        let ok = completeTest(move value, move provider)
        setAlarm(0)
        let testFinished = run MonotonicClock.now()
          |> Effect.provideMut<MonotonicClock>(&mut clock)
        run writeResult(ok, elapsedNanoseconds(&testStarted, &testFinished))
        executed = executed + 1
        if ok { passed = passed + 1 } else { failed = failed + 1 }
        if perTest {
          let mut disposition: u8 = 2
          if ok { disposition = 1 }
          run TestExchange.appendResult(
            &mut receipt,
            ordinal,
            declaration,
            TestExchange.executionIdentity(&entry),
            disposition,
          )
        }
      }
    }
    drop entry
    ordinal = ordinal + 1
  }
  // The file is missing when no test body ran.
  if let Option<Path>.Some { value } = &progressPath {
    let removed = run Effect.result(FileSystem.removeFile(&value))
    drop removed
  }
  let summary = .{
    discovered: discovered,
    selected: selected,
    cached: cached,
    executed: executed,
    passed: passed,
    failed: failed,
  }
  let finished = run MonotonicClock.now()
    |> Effect.provideMut<MonotonicClock>(&mut clock)
  run Writer.writeString("\n")
  run Format.format(
    "Tests  {passed} passed, {failed} failed ({cached} cached, {executed} executed, {selected} selected, {discovered} discovered)\n",
    &summary,
  )
  run Writer.writeString("Time   ")
  run writeDuration(elapsedNanoseconds(&started, &finished))
  run Writer.writeString("\n")
  let mut status: u32 = 1
  if failed == 0 { status = 0 }
  let bytes = run TestExchange.finishReceipt(
    move receipt,
    discovered,
    selected,
    cached,
    executed,
    passed,
    failed,
    status,
  )
  run FileSystem.writeFile(resultPath, Bytes.asSlice(&bytes))
  if status == 0 { return 0 }
  return 1
}

fn argumentText<'arguments>(arguments: &'arguments [Bytes], index: usize) -> Result<string<'arguments>, InvalidUtf8> {
  return HostInput.text(Bytes.asSlice(&arguments[index]))
}

fn argumentOrEmpty<'arguments>(
  arguments: &'arguments [Bytes],
  index: usize,
) -> Result<string<'arguments>, InvalidUtf8> {
  if index == usize.ZERO {
    return Result<string<'arguments>, InvalidUtf8>.succeed("")
  }
  return argumentText(arguments, index)
}

effect fn executeArguments<'arguments>(values: &'arguments [Bytes]) -> i32
! FileError | OutOfMemoryError | WriterError {
  let mut fileIndex = usize.ZERO
  let mut nameIndex = usize.ZERO
  let mut planIndex = usize.ZERO
  let mut resultIndex = usize.ZERO
  let mut progressIndex = usize.ZERO
  let mut timeoutIndex = usize.ZERO
  let mut index = usize.ONE
  while index < values.length {
    let option = match move argumentText(values, index) {
      Result<string, InvalidUtf8>.Success { value } => move value
      Result<string, InvalidUtf8>.Failure { error } => { drop error return 2 }
    }
    if index + usize.ONE >= values.length { return 2 }
    if Intrinsic.stringEqualsExact(option, "--file") {
      fileIndex = index + usize.ONE
    } else {
      if Intrinsic.stringEqualsExact(option, "--filter") {
        nameIndex = index + usize.ONE
      } else {
        if Intrinsic.stringEqualsExact(option, "--silk-test-plan") {
          planIndex = index + usize.ONE
        } else {
          if Intrinsic.stringEqualsExact(option, "--silk-test-result") {
            resultIndex = index + usize.ONE
          } else {
            if Intrinsic.stringEqualsExact(option, "--silk-test-progress") {
              progressIndex = index + usize.ONE
            } else {
              if Intrinsic.stringEqualsExact(option, "--silk-test-timeout") {
                timeoutIndex = index + usize.ONE
              } else {
                return 2
              }
            }
          }
        }
      }
    }
    index = index + 2
  }
  let fileFilter = match move argumentOrEmpty(values, fileIndex) {
    Result<string, InvalidUtf8>.Success { value } => move value
    Result<string, InvalidUtf8>.Failure { error } => { drop error return 2 }
  }
  let nameFilter = match move argumentOrEmpty(values, nameIndex) {
    Result<string, InvalidUtf8>.Success { value } => move value
    Result<string, InvalidUtf8>.Failure { error } => { drop error return 2 }
  }
  if planIndex == usize.ZERO || resultIndex == usize.ZERO { return 2 }
  let planText = match move argumentText(values, planIndex) {
    Result<string, InvalidUtf8>.Success { value } => move value
    Result<string, InvalidUtf8>.Failure { error } => { drop error return 2 }
  }
  let resultText = match move argumentText(values, resultIndex) {
    Result<string, InvalidUtf8>.Success { value } => move value
    Result<string, InvalidUtf8>.Failure { error } => { drop error return 2 }
  }
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut fileSystem = run OsFileSystem.make("/")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let planPath = run Path.make(planText)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let resultPath = run Path.make(resultText)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut limit: u32 = 0
  if timeoutIndex != usize.ZERO {
    let timeoutText = match move argumentText(values, timeoutIndex) {
      Result<string, InvalidUtf8>.Success { value } => move value
      Result<string, InvalidUtf8>.Failure { error } => { drop error return 2 }
    }
    limit = match move seconds(timeoutText) {
      Option<u32>.Some { value } => value
      Option<u32>.None => { return 2 }
    }
  }
  let mut progressPath = Option<Path>.none()
  if progressIndex != usize.ZERO {
    let progressText = match move argumentText(values, progressIndex) {
      Result<string, InvalidUtf8>.Success { value } => move value
      Result<string, InvalidUtf8>.Failure { error } => { drop error return 2 }
    }
    progressPath = Option<Path>.some(run Path.make(progressText)
      |> Effect.provideMut<Allocator>(&mut allocator))
  }
  let metadata = run FileSystem.stat(&planPath)
    |> Effect.provideMut<FileSystem>(&mut fileSystem)
  let planLength = match move metadata {
    FileInfo { byteLength } => byteLength
    DirectoryInfo {} => usize.MAX
  }
  if planLength > 16777216 { return 2 }
  let mut reading = FileSystem.readFile(&planPath)
    |> Effect.provideMut<FileSystem>(&mut fileSystem)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let planBytes = run reading
  let mut writer = StdoutWriter.make()
  return run runSelected(fileFilter, nameFilter, Bytes.asSlice(&planBytes), &resultPath, move progressPath, limit)
    |> Effect.provideMut<Allocator>(&mut allocator)
    |> Effect.provideMut<FileSystem>(&mut fileSystem)
    |> Effect.provideMut<Writer>(&mut writer)
}

effect fn execute() -> i32
! FileError | HostInputError | OutOfMemoryError | WriterError
? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut collected = HostInput.arguments()
    |> Effect.provideMut<Allocator>(&mut allocator)
  let arguments = run collected
  return run executeArguments(List.asSlice(&arguments))
}

effect<'env> fn operationalFailure<E: 'env, 'env>(error: E) -> i32 {
  drop error
  return 2
}

/// Runs each selected test in order and returns the exit status (`0`, `1` or `2`).
pub effect fn main() -> i32 ? &mut HostInput {
  return run Effect.catchAll(execute(), operationalFailure)
}
