//! Runtime detection of the CPU features that the running machine has, to choose a kernel at
//! run time.
//!
//! # When to use
//! Use [`CpuFeatures.available`] when one binary must pick a faster kernel on machines that have
//! a feature the build does not select. Use `Target.hasCpuFeature` with `static if` when the
//! build itself selects the feature, which costs nothing at run time.
//!
//! # Details
//! A [`CpuFeatures`] value is a set of feature names of the target architecture, spelled as in
//! the compilation profile, such as `"avx2"`, `"dotprod"` or `"simd128"`. [`CpuFeatures.selected`]
//! is the set the build selects. [`CpuFeatures.machine`] is the set the running machine has, which
//! always includes the selected set:
//!
//! - x86-64 reads `cpuid`, and counts AVX and AVX-512 features only when the operating system
//!   saves their registers (`xgetbv`).
//! - AArch64 Linux with GNU libc reads `getauxval`. AArch64 Darwin reads `sysctlbyname`.
//! - wasm32 cannot ask the engine, and other profiles cannot ask the system, so they report
//!   the selected set.
//!
//! The first question in a process asks the machine and keeps the answer, so later questions
//! cost one memory read. [`CpuFeatures.available`] answers for one feature named at compile time:
//! it is `true` at compile time when the build selects the feature.
//!
//! A kernel that uses a feature's instructions is an `unsafe fn` compiled with `@features`.
//! Calling it is safe once `available` answered `true` for each of its features.
//!
//! # Gotchas
//! - A name from another architecture, or an unknown name, is never present.
//! - A detected feature does not make `Target.hasCpuFeature` true, also inside a function with
//!   `@features`. Such a function calls the feature's `Intrinsic` operations itself.
//!
//! # Examples
//! ## Choose a kernel at run time
//! ```silk
//! import silk.simd.cpu { CpuFeatures }
//! import silk.num.u64
//!
//! static if Intrinsic.targetArchitecture() == "x86_64" {
//!   @features("popcnt")
//!   unsafe fn countFast(value: u64) -> u32 {
//!     return u64.countOnes(value)
//!   }
//! }
//!
//! fn count(value: u64) -> u32 {
//!   static if Intrinsic.targetArchitecture() == "x86_64" {
//!     if CpuFeatures.available("popcnt") {
//!       return unsafe countFast(value)
//!     }
//!   }
//!   return u64.countOnes(value)
//! }
//!
//! pub fn main() -> i32 {
//!   if count(255) != 8 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! ## Compare the machine with the build
//! ```silk
//! import silk.simd.cpu { CpuFeatures }
//!
//! pub fn main() -> i32 {
//!   let machine = CpuFeatures.machine()
//!   let build = CpuFeatures.selected()
//!   // The machine has every feature the build selects.
//!   if !CpuFeatures.containsAll(&machine, &build) {
//!     return 1
//!   }
//!   if CpuFeatures.has(&machine, "no-such-feature") {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category SIMD

import silk.concurrency.atomic { Atomic, MemoryOrder }
import silk.core.ownership { Copy }
import silk.core.static_sequence { StaticSequence }
import silk.mem.pointer { Pointer }
import silk.core.target { Arch, ObjectFormat, Target }
import silk.num.u64

/// A set of CPU features of the target architecture.
///
/// # When to use
///
/// Use [`CpuFeatures.available`] when one binary must pick a faster kernel on machines that have
/// a feature the build does not select. Use `Target.hasCpuFeature` with `static if` when the
/// build itself selects the feature, which costs nothing at run time.
///
/// # Details
///
/// The names are spelled as in the compilation profile, such as `"avx2"`, `"dotprod"` or
/// `"simd128"`. [`CpuFeatures.selected`] is the set the build selects. [`CpuFeatures.machine`] is
/// the set the running machine has, asked once per process, and always includes the selected set.
///
/// # Gotchas
///
/// - A name from another architecture, or an unknown name, is never present.
/// - A detected feature does not make `Target.hasCpuFeature` true. Code that uses the feature's
///   instructions must still be compiled for it, in an `unsafe fn` with `@features`.
pub struct CpuFeatures {
  bits: u64,
}

impl Copy for CpuFeatures {}

impl CpuFeatures {
  /// Returns the features that the build selects, from the compilation profile.
  pub fn selected() -> CpuFeatures {
    let mut bits: u64 = 0
    let mut at: u64 = 0
    static for name in catalog() {
      static if Target.hasCpuFeature(name) {
        bits = bits | bit(at)
      }
      at = at + 1
    }
    return CpuFeatures { bits: bits }
  }
  /// Returns the features of the running machine, which include [`CpuFeatures.selected`].
  ///
  /// # Details
  ///
  /// The first call in a process asks the machine and keeps the answer in process-wide storage,
  /// so later calls cost one memory read:
  ///
  /// - x86-64 reads `cpuid`, and counts AVX and AVX-512 features only when the operating system
  ///   saves their registers (`xgetbv`).
  /// - AArch64 Linux with GNU libc reads `getauxval`. AArch64 Darwin reads `sysctlbyname`.
  /// - wasm32 cannot ask the engine, and other profiles cannot ask the system, so they report the
  ///   selected set.
  ///
  /// Threads that call it at the same time may each ask the machine once. They get the same
  /// answer.
  ///
  /// # Gotchas
  ///
  /// A detected feature does not make `Target.hasCpuFeature` true. Code that uses the feature's
  /// instructions must still be compiled for it, for example in an `unsafe fn` with
  /// `@features`.
  pub fn machine() -> CpuFeatures {
    return CpuFeatures { bits: u64.bitAnd(machineBits(), u64.bitNot(ready())) }
  }
  /// Returns the features of the running machine, asking it again on every call.
  ///
  /// # When to use
  ///
  /// Use [`CpuFeatures.machine`], which asks once per process. Use `detect` only where a cached
  /// answer must not be used.
  ///
  /// # Details
  ///
  /// The result is the same set that [`CpuFeatures.machine`] returns, and includes
  /// [`CpuFeatures.selected`]. Asking the machine can take thousands of cycles in a virtual
  /// machine.
  pub fn detect() -> CpuFeatures {
    return CpuFeatures { bits: detectBits() }
  }
  /// Returns `true` if the running machine has the CPU feature `name`, to choose a kernel at run
  /// time.
  ///
  /// # When to use
  ///
  /// Use it in front of an `unsafe fn` compiled with `@features(name)`: call the function only
  /// when this returns `true`.
  ///
  /// # Details
  ///
  /// When the build selects `name` (`Target.hasCpuFeature`), the answer is `true` at compile
  /// time and costs nothing. Otherwise it reads the answer that [`CpuFeatures.machine`] keeps,
  /// which is one memory read and one bit test after the first call in the process. On wasm32
  /// and other profiles that cannot ask the machine, it is `false` at compile time.
  ///
  /// # Gotchas
  ///
  /// A name from another architecture, or an unknown name, is never available.
  pub fn available(static name: string<'static>) -> bool {
    static if Target.hasCpuFeature(name) {
      return true
    }
    let static at = slot(name)
    static if at == 64 || !detects() {
      return false
    }
    return hasBit(machineBits(), at)
  }
  /// Returns `true` if the set contains the feature `name`.
  pub fn has(self: &Self, name: string) -> bool {
    let at = index(name)
    if at == 64 {
      return false
    }
    return hasBit(self.bits, at)
  }
  /// Returns `true` if the set contains every feature of `other`.
  pub fn containsAll(self: &Self, other: &CpuFeatures) -> bool {
    return (self.bits & other.bits) == other.bits
  }
}

fn hasBit(word: u64, index: u64) -> bool {
  return (u64.shiftRight(word, index) & 1) == 1
}

fn bit(index: u64) -> u64 {
  return u64.shiftLeft(1, index)
}

// The bit that marks a cached answer, so that a zero word means "not asked yet". No catalog has
// 63 features.
fn ready() -> u64 {
  return bit(63)
}

// Whether this profile can ask the running machine for more than the selected features.
static fn detects() -> bool {
  static if (Intrinsic.targetOperatingSystem() == "linux" || Intrinsic.targetOperatingSystem() == "darwin") && Intrinsic.targetArchitecture() == "x86_64" {
    return true
  }
  static if Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.profileText("libc") == "gnu" {
    return true
  }
  static if Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.profileText("libc") == "system" {
    return true
  }
  return false
}

// The running machine's features with the `ready` bit set, asked once per process. Racing first
// calls each ask and store the same answer.
fn machineBits() -> u64 {
  static if !detects() {
    return u64.bitOr(CpuFeatures.selected().bits, ready())
  }
  let word = Intrinsic.processWord()
  let cached = unsafe Atomic.load<u64>(word, MemoryOrder.Relaxed)
  if cached != 0 {
    return cached
  }
  return askMachine(word)
}

@inlineNever
fn askMachine(word: *mut u64) -> u64 {
  let bits = u64.bitOr(detectBits(), ready())
  unsafe Atomic.store<u64>(word, bits, MemoryOrder.Relaxed)
  return bits
}

fn detectBits() -> u64 {
  let mut bits = CpuFeatures.selected().bits
  static if (Intrinsic.targetOperatingSystem() == "linux" || Intrinsic.targetOperatingSystem() == "darwin") && Intrinsic.targetArchitecture() == "x86_64" {
    bits = bits | unsafe x86Bits()
  }
  static if Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.profileText("libc") == "gnu" {
    bits = bits | unsafe aarch64LinuxBits()
  }
  static if Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.profileText("libc") == "system" {
    bits = bits | unsafe aarch64DarwinBits()
  }
  return bits
}

// The feature catalog of the target: the feature at position `i` is bit `i` of a set.
static fn catalog() -> Intrinsic.StaticSequence<string<'static>> {
  let mut names = StaticSequence.empty<string<'static>>()
  static if Target.arch() == Arch.X86_64 {
    names = StaticSequence.append<string<'static>>(move names, "aes")
    names = StaticSequence.append<string<'static>>(move names, "avx")
    names = StaticSequence.append<string<'static>>(move names, "avx2")
    names = StaticSequence.append<string<'static>>(move names, "avx512bw")
    names = StaticSequence.append<string<'static>>(move names, "avx512cd")
    names = StaticSequence.append<string<'static>>(move names, "avx512dq")
    names = StaticSequence.append<string<'static>>(move names, "avx512f")
    names = StaticSequence.append<string<'static>>(move names, "avx512vbmi")
    names = StaticSequence.append<string<'static>>(move names, "avx512vl")
    names = StaticSequence.append<string<'static>>(move names, "bmi")
    names = StaticSequence.append<string<'static>>(move names, "bmi2")
    names = StaticSequence.append<string<'static>>(move names, "cx16")
    names = StaticSequence.append<string<'static>>(move names, "f16c")
    names = StaticSequence.append<string<'static>>(move names, "fma")
    names = StaticSequence.append<string<'static>>(move names, "lzcnt")
    names = StaticSequence.append<string<'static>>(move names, "movbe")
    names = StaticSequence.append<string<'static>>(move names, "pclmul")
    names = StaticSequence.append<string<'static>>(move names, "popcnt")
    names = StaticSequence.append<string<'static>>(move names, "sha")
    names = StaticSequence.append<string<'static>>(move names, "sse2")
    names = StaticSequence.append<string<'static>>(move names, "sse3")
    names = StaticSequence.append<string<'static>>(move names, "sse4.1")
    names = StaticSequence.append<string<'static>>(move names, "sse4.2")
    names = StaticSequence.append<string<'static>>(move names, "ssse3")
    names = StaticSequence.append<string<'static>>(move names, "xsave")
  }
  static if Target.arch() == Arch.Aarch64 {
    names = StaticSequence.append<string<'static>>(move names, "aes")
    names = StaticSequence.append<string<'static>>(move names, "crc")
    names = StaticSequence.append<string<'static>>(move names, "crypto")
    names = StaticSequence.append<string<'static>>(move names, "dotprod")
    names = StaticSequence.append<string<'static>>(move names, "fp-armv8")
    names = StaticSequence.append<string<'static>>(move names, "fullfp16")
    names = StaticSequence.append<string<'static>>(move names, "i8mm")
    names = StaticSequence.append<string<'static>>(move names, "lse")
    names = StaticSequence.append<string<'static>>(move names, "neon")
    names = StaticSequence.append<string<'static>>(move names, "rdm")
    names = StaticSequence.append<string<'static>>(move names, "sha2")
    names = StaticSequence.append<string<'static>>(move names, "sha3")
  }
  static if Target.objectFormat() == ObjectFormat.Wasm {
    names = StaticSequence.append<string<'static>>(move names, "atomics")
    names = StaticSequence.append<string<'static>>(move names, "bulk-memory")
    names = StaticSequence.append<string<'static>>(move names, "mutable-globals")
    names = StaticSequence.append<string<'static>>(move names, "relaxed-simd")
    names = StaticSequence.append<string<'static>>(move names, "sign-ext")
    names = StaticSequence.append<string<'static>>(move names, "simd128")
  }
  return names
}

// The position of `name` in the catalog, or 64 when it is not listed.
static fn slot(name: string<'static>) -> u64 {
  let mut at: u64 = 0
  static for listed in catalog() {
    if listed == name {
      return at
    }
    at = at + 1
  }
  return 64
}

// The position of `name` in the catalog, or 64 when it is not listed.
fn index(name: string) -> u64 {
  let mut at: u64 = 0
  static for listed in catalog() {
    if name == listed {
      return at
    }
    at = at + 1
  }
  return 64
}

unsafe extern "C" fn getauxval(kind: u64) -> u64
@foreign(noCapture: ("name", "value", "length", "replacement"))
unsafe extern "C" fn sysctlbyname(name: ?[*]const u8, value: *mut i32, length: *mut usize, replacement: ?*mut u8, replacementLength: usize) -> i32

static if (Intrinsic.targetOperatingSystem() == "linux" || Intrinsic.targetOperatingSystem() == "darwin") && Intrinsic.targetArchitecture() == "x86_64" {
  // `cpuid` overwrites rbx, which LLVM may reserve, so each read saves it in r8.
  unsafe fn cpuidA(leaf: u64, sub: u64) -> u64 {
    return unsafe Intrinsic.assembly<u64>(
      "movq %rbx, %r8; movl %r9d, %ecx; cpuid; movq %r8, %rbx",
      "={rax},0,{r9}",
      "rcx,rdx,r8,flags",
      "none",
      false,
      false, (leaf, sub),
    )
  }
  unsafe fn cpuidB(leaf: u64, sub: u64) -> u64 {
    return unsafe Intrinsic.assembly<u64>(
      "movq %rbx, %r8; movl %r9d, %ecx; cpuid; movl %ebx, %eax; movq %r8, %rbx",
      "={rax},0,{r9}",
      "rcx,rdx,r8,flags",
      "none",
      false,
      false, (leaf, sub),
    )
  }
  unsafe fn cpuidC(leaf: u64, sub: u64) -> u64 {
    return unsafe Intrinsic.assembly<u64>(
      "movq %rbx, %r8; movl %r9d, %ecx; cpuid; movl %ecx, %eax; movq %r8, %rbx",
      "={rax},0,{r9}",
      "rcx,rdx,r8,flags",
      "none",
      false,
      false, (leaf, sub),
    )
  }
  unsafe fn cpuidD(leaf: u64, sub: u64) -> u64 {
    return unsafe Intrinsic.assembly<u64>(
      "movq %rbx, %r8; movl %r9d, %ecx; cpuid; movl %edx, %eax; movq %r8, %rbx",
      "={rax},0,{r9}",
      "rcx,rdx,r8,flags",
      "none",
      false,
      false, (leaf, sub),
    )
  }
  // Extended control register 0: which register files the operating system saves.
  unsafe fn xgetbv(register: u64) -> u64 {
    return unsafe Intrinsic.assembly<u64>(
      "xgetbv",
      "={rax},{rcx}",
      "rdx",
      "none",
      false,
      false, .(register),
    )
  }
  unsafe fn x86Bits() -> u64 {
    let mut bits: u64 = 0
    let highest = unsafe cpuidA(0, 0)
    let leaf1c = unsafe cpuidC(1, 0)
    let leaf1d = unsafe cpuidD(1, 0)
    let mut leaf7b: u64 = 0
    let mut leaf7c: u64 = 0
    if highest >= 7 {
      leaf7b = unsafe cpuidB(7, 0)
      leaf7c = unsafe cpuidC(7, 0)
    }
    let mut extendedc: u64 = 0
    if unsafe cpuidA(2147483648, 0) >= 2147483649 {
      extendedc = unsafe cpuidC(2147483649, 0)
    }
    let mut avxState = false
    let mut avx512State = false
    if hasBit(leaf1c, 27) {
      // Bits 1 and 2 are SSE and AVX state; bits 5 through 7 are AVX-512 state.
      let state = unsafe xgetbv(0)
      avxState = (state & 6) == 6
      avx512State = (state & 230) == 230
    }
    if hasBit(leaf1c, 25) {
      bits = bits | bit(slot("aes"))
    }
    if hasBit(leaf1c, 28) && avxState {
      bits = bits | bit(slot("avx"))
    }
    if hasBit(leaf7b, 5) && avxState {
      bits = bits | bit(slot("avx2"))
    }
    if hasBit(leaf7b, 30) && avx512State {
      bits = bits | bit(slot("avx512bw"))
    }
    if hasBit(leaf7b, 28) && avx512State {
      bits = bits | bit(slot("avx512cd"))
    }
    if hasBit(leaf7b, 17) && avx512State {
      bits = bits | bit(slot("avx512dq"))
    }
    if hasBit(leaf7b, 16) && avx512State {
      bits = bits | bit(slot("avx512f"))
    }
    if hasBit(leaf7c, 1) && avx512State {
      bits = bits | bit(slot("avx512vbmi"))
    }
    if hasBit(leaf7b, 31) && avx512State {
      bits = bits | bit(slot("avx512vl"))
    }
    if hasBit(leaf7b, 3) {
      bits = bits | bit(slot("bmi"))
    }
    if hasBit(leaf7b, 8) {
      bits = bits | bit(slot("bmi2"))
    }
    if hasBit(leaf1c, 13) {
      bits = bits | bit(slot("cx16"))
    }
    if hasBit(leaf1c, 29) && avxState {
      bits = bits | bit(slot("f16c"))
    }
    if hasBit(leaf1c, 12) && avxState {
      bits = bits | bit(slot("fma"))
    }
    if hasBit(extendedc, 5) {
      bits = bits | bit(slot("lzcnt"))
    }
    if hasBit(leaf1c, 22) {
      bits = bits | bit(slot("movbe"))
    }
    if hasBit(leaf1c, 1) {
      bits = bits | bit(slot("pclmul"))
    }
    if hasBit(leaf1c, 23) {
      bits = bits | bit(slot("popcnt"))
    }
    if hasBit(leaf7b, 29) {
      bits = bits | bit(slot("sha"))
    }
    if hasBit(leaf1d, 26) {
      bits = bits | bit(slot("sse2"))
    }
    if hasBit(leaf1c, 0) {
      bits = bits | bit(slot("sse3"))
    }
    if hasBit(leaf1c, 19) {
      bits = bits | bit(slot("sse4.1"))
    }
    if hasBit(leaf1c, 20) {
      bits = bits | bit(slot("sse4.2"))
    }
    if hasBit(leaf1c, 9) {
      bits = bits | bit(slot("ssse3"))
    }
    if hasBit(leaf1c, 26) {
      bits = bits | bit(slot("xsave"))
    }
    return bits
  }
}

static if Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.profileText("libc") == "gnu" {
  unsafe fn aarch64LinuxBits() -> u64 {
    // AT_HWCAP and AT_HWCAP2.
    let hwcap: u64 = unsafe getauxval(16)
    let hwcap2: u64 = unsafe getauxval(26)
    let mut bits: u64 = 0
    if hasBit(hwcap, 3) {
      bits = bits | bit(slot("aes"))
    }
    if hasBit(hwcap, 7) {
      bits = bits | bit(slot("crc"))
    }
    if hasBit(hwcap, 3) && hasBit(hwcap, 6) {
      bits = bits | bit(slot("crypto"))
    }
    if hasBit(hwcap, 20) {
      bits = bits | bit(slot("dotprod"))
    }
    if hasBit(hwcap, 0) {
      bits = bits | bit(slot("fp-armv8"))
    }
    if hasBit(hwcap, 9) && hasBit(hwcap, 10) {
      bits = bits | bit(slot("fullfp16"))
    }
    if hasBit(hwcap2, 13) {
      bits = bits | bit(slot("i8mm"))
    }
    if hasBit(hwcap, 8) {
      bits = bits | bit(slot("lse"))
    }
    if hasBit(hwcap, 1) {
      bits = bits | bit(slot("neon"))
    }
    if hasBit(hwcap, 12) {
      bits = bits | bit(slot("rdm"))
    }
    if hasBit(hwcap, 6) {
      bits = bits | bit(slot("sha2"))
    }
    if hasBit(hwcap, 17) {
      bits = bits | bit(slot("sha3"))
    }
    return bits
  }
}

static if Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.profileText("libc") == "system" {
  /// Reads one `hw.optional` flag. `name` ends with a zero byte.
  fn darwinFlag(name: &[u8]) -> bool {
    let mut value: i32 = 0
    let mut length: usize = 4
    let status = unsafe sysctlbyname(Pointer.fromSlice<u8>(name), Pointer.fromMutRef<i32>(&mut value), Pointer.fromMutRef<usize>(&mut length), Pointer.null<u8>(), 0)
    return status == 0 && value != 0
  }
  unsafe fn aarch64DarwinBits() -> u64 {
    let mut bits: u64 = 0
    if darwinFlag(b"hw.optional.arm.FEAT_AES\0") {
      bits = bits | bit(slot("aes"))
    }
    if darwinFlag(b"hw.optional.armv8_crc32\0") {
      bits = bits | bit(slot("crc"))
    }
    if darwinFlag(b"hw.optional.arm.FEAT_AES\0") && darwinFlag(b"hw.optional.arm.FEAT_SHA256\0") {
      bits = bits | bit(slot("crypto"))
    }
    if darwinFlag(b"hw.optional.arm.FEAT_DotProd\0") {
      bits = bits | bit(slot("dotprod"))
    }
    if darwinFlag(b"hw.optional.floatingpoint\0") {
      bits = bits | bit(slot("fp-armv8"))
    }
    if darwinFlag(b"hw.optional.arm.FEAT_FP16\0") {
      bits = bits | bit(slot("fullfp16"))
    }
    if darwinFlag(b"hw.optional.arm.FEAT_I8MM\0") {
      bits = bits | bit(slot("i8mm"))
    }
    if darwinFlag(b"hw.optional.arm.FEAT_LSE\0") {
      bits = bits | bit(slot("lse"))
    }
    if darwinFlag(b"hw.optional.neon\0") {
      bits = bits | bit(slot("neon"))
    }
    if darwinFlag(b"hw.optional.arm.FEAT_RDM\0") {
      bits = bits | bit(slot("rdm"))
    }
    if darwinFlag(b"hw.optional.arm.FEAT_SHA256\0") {
      bits = bits | bit(slot("sha2"))
    }
    if darwinFlag(b"hw.optional.arm.FEAT_SHA3\0") {
      bits = bits | bit(slot("sha3"))
    }
    return bits
  }
}
