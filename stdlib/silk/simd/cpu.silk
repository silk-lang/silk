//! Runtime detection of the CPU features that the running machine has.
//!
//! # When to use
//! Use [`CpuFeatures.detect`] when one binary must pick a faster kernel on machines that have a
//! feature the build does not select. Use `Target.hasCpuFeature` with `static if` when the build
//! itself selects the feature, which costs nothing at run time.
//!
//! # Details
//! A [`CpuFeatures`] value is a set of feature names of the target architecture, spelled as in
//! the compilation profile, such as `"avx2"`, `"dotprod"` or `"simd128"`. [`CpuFeatures.selected`]
//! is the set the build selects. [`CpuFeatures.detect`] asks the machine and always includes the
//! selected set:
//!
//! - x86-64 reads `cpuid`, and counts AVX and AVX-512 features only when the operating system
//!   saves their registers (`xgetbv`).
//! - AArch64 Linux with GNU libc reads `getauxval`. AArch64 Darwin reads `sysctlbyname`.
//! - wasm32 cannot ask the engine, and other profiles cannot ask the system, so they report
//!   the selected set.
//!
//! Silk has no mutable global storage, so detection is not cached. Call `detect` once at start
//! and keep the value, for example in a service.
//!
//! # Gotchas
//! - A name from another architecture, or an unknown name, is never present.
//! - A detected feature does not make `Target.hasCpuFeature` true. Code that uses the feature's
//!   instructions must still be compiled for it.
//!
//! # Examples
//! ## Ask the machine once
//! ```silk
//! import silk.simd.cpu { CpuFeatures }
//!
//! pub fn main() -> i32 {
//!   let machine = CpuFeatures.detect()
//!   let build = CpuFeatures.selected()
//!   // The machine has every feature the build selects.
//!   if CpuFeatures.has(&build, "sse2") && !CpuFeatures.has(&machine, "sse2") {
//!     return 1
//!   }
//!   if !CpuFeatures.containsAll(&machine, &build) {
//!     return 1
//!   }
//!   if CpuFeatures.has(&machine, "no-such-feature") {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category SIMD

import silk.core.ownership { Copy }
import silk.mem.pointer { Pointer }
import silk.core.target { Arch, Target }
import silk.num.u64

/// A set of CPU features of the target architecture.
///
/// # When to use
///
/// Use [`CpuFeatures.detect`] when one binary must pick a faster kernel on machines that have a
/// feature the build does not select. Use `Target.hasCpuFeature` with `static if` when the build
/// itself selects the feature, which costs nothing at run time.
///
/// # Details
///
/// The names are spelled as in the compilation profile, such as `"avx2"`, `"dotprod"` or
/// `"simd128"`. [`CpuFeatures.selected`] is the set the build selects. [`CpuFeatures.detect`] asks
/// the machine and always includes the selected set.
///
/// # Gotchas
///
/// - A name from another architecture, or an unknown name, is never present.
/// - A detected feature does not make `Target.hasCpuFeature` true. Code that uses the feature's
///   instructions must still be compiled for it.
pub struct CpuFeatures {
  bits: u64,
}

impl Copy for CpuFeatures {}

impl CpuFeatures {
  /// Returns the features that the build selects, from the compilation profile.
  pub fn selected() -> CpuFeatures {
    let mut bits: u64 = 0
    static if Target.arch() == Arch.X86_64 {
      static if Target.hasCpuFeature("aes") {
        bits = bits | bit(0)
      }
      static if Target.hasCpuFeature("avx") {
        bits = bits | bit(1)
      }
      static if Target.hasCpuFeature("avx2") {
        bits = bits | bit(2)
      }
      static if Target.hasCpuFeature("avx512bw") {
        bits = bits | bit(3)
      }
      static if Target.hasCpuFeature("avx512cd") {
        bits = bits | bit(4)
      }
      static if Target.hasCpuFeature("avx512dq") {
        bits = bits | bit(5)
      }
      static if Target.hasCpuFeature("avx512f") {
        bits = bits | bit(6)
      }
      static if Target.hasCpuFeature("avx512vbmi") {
        bits = bits | bit(7)
      }
      static if Target.hasCpuFeature("avx512vl") {
        bits = bits | bit(8)
      }
      static if Target.hasCpuFeature("bmi") {
        bits = bits | bit(9)
      }
      static if Target.hasCpuFeature("bmi2") {
        bits = bits | bit(10)
      }
      static if Target.hasCpuFeature("cx16") {
        bits = bits | bit(11)
      }
      static if Target.hasCpuFeature("f16c") {
        bits = bits | bit(12)
      }
      static if Target.hasCpuFeature("fma") {
        bits = bits | bit(13)
      }
      static if Target.hasCpuFeature("lzcnt") {
        bits = bits | bit(14)
      }
      static if Target.hasCpuFeature("movbe") {
        bits = bits | bit(15)
      }
      static if Target.hasCpuFeature("pclmul") {
        bits = bits | bit(16)
      }
      static if Target.hasCpuFeature("popcnt") {
        bits = bits | bit(17)
      }
      static if Target.hasCpuFeature("sha") {
        bits = bits | bit(18)
      }
      static if Target.hasCpuFeature("sse2") {
        bits = bits | bit(19)
      }
      static if Target.hasCpuFeature("sse3") {
        bits = bits | bit(20)
      }
      static if Target.hasCpuFeature("sse4.1") {
        bits = bits | bit(21)
      }
      static if Target.hasCpuFeature("sse4.2") {
        bits = bits | bit(22)
      }
      static if Target.hasCpuFeature("ssse3") {
        bits = bits | bit(23)
      }
      static if Target.hasCpuFeature("xsave") {
        bits = bits | bit(24)
      }
    }
    static if Target.arch() == Arch.Aarch64 {
      static if Target.hasCpuFeature("aes") {
        bits = bits | bit(0)
      }
      static if Target.hasCpuFeature("crc") {
        bits = bits | bit(1)
      }
      static if Target.hasCpuFeature("crypto") {
        bits = bits | bit(2)
      }
      static if Target.hasCpuFeature("dotprod") {
        bits = bits | bit(3)
      }
      static if Target.hasCpuFeature("fp-armv8") {
        bits = bits | bit(4)
      }
      static if Target.hasCpuFeature("fullfp16") {
        bits = bits | bit(5)
      }
      static if Target.hasCpuFeature("i8mm") {
        bits = bits | bit(6)
      }
      static if Target.hasCpuFeature("lse") {
        bits = bits | bit(7)
      }
      static if Target.hasCpuFeature("neon") {
        bits = bits | bit(8)
      }
      static if Target.hasCpuFeature("rdm") {
        bits = bits | bit(9)
      }
      static if Target.hasCpuFeature("sha2") {
        bits = bits | bit(10)
      }
      static if Target.hasCpuFeature("sha3") {
        bits = bits | bit(11)
      }
    }
    static if Target.arch() == Arch.Wasm32 {
      static if Target.hasCpuFeature("atomics") {
        bits = bits | bit(0)
      }
      static if Target.hasCpuFeature("bulk-memory") {
        bits = bits | bit(1)
      }
      static if Target.hasCpuFeature("mutable-globals") {
        bits = bits | bit(2)
      }
      static if Target.hasCpuFeature("relaxed-simd") {
        bits = bits | bit(3)
      }
      static if Target.hasCpuFeature("sign-ext") {
        bits = bits | bit(4)
      }
      static if Target.hasCpuFeature("simd128") {
        bits = bits | bit(5)
      }
    }
    return CpuFeatures { bits: bits }
  }
  /// Returns the features of the running machine, which include [`CpuFeatures.selected`].
  ///
  /// # Details
  ///
  /// Each call asks the machine again:
  ///
  /// - x86-64 reads `cpuid`, and counts AVX and AVX-512 features only when the operating system
  ///   saves their registers (`xgetbv`).
  /// - AArch64 Linux with GNU libc reads `getauxval`. AArch64 Darwin reads `sysctlbyname`.
  /// - wasm32 cannot ask the engine, and other profiles cannot ask the system, so they report the
  ///   selected set.
  ///
  /// Silk has no mutable global storage, so the result is not cached. Call `detect` once at start
  /// and keep the value, for example in a service.
  ///
  /// # Gotchas
  ///
  /// A detected feature does not make `Target.hasCpuFeature` true. Code that uses the feature's
  /// instructions must still be compiled for it.
  pub fn detect() -> CpuFeatures {
    let mut bits = CpuFeatures.selected().bits
    static if Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetArchitecture() == "x86_64" {
      bits = bits | unsafe x86Bits()
    }
    static if Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.profileText("libc") == "gnu" {
      bits = bits | unsafe aarch64LinuxBits()
    }
    static if Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.profileText("libc") == "system" {
      bits = bits | unsafe aarch64DarwinBits()
    }
    return CpuFeatures { bits: bits }
  }
  /// Returns `true` if the set contains the feature `name`.
  pub fn has(self: &Self, name: string) -> bool {
    let at = index(name)
    if at == 64 {
      return false
    }
    return hasBit(self.bits, at)
  }
  /// Returns `true` if the set contains every feature of `other`.
  pub fn containsAll(self: &Self, other: &CpuFeatures) -> bool {
    return (self.bits & other.bits) == other.bits
  }
}

fn hasBit(word: u64, index: u64) -> bool {
  return (u64.shiftRight(word, index) & 1) == 1
}

fn bit(index: u64) -> u64 {
  return u64.shiftLeft(1, index)
}

/// The position of `name` in the feature catalog of the target, or 64 when it is not listed.
fn index(name: string) -> u64 {
  static if Target.arch() == Arch.X86_64 {
    if name == "aes" {
      return 0
    }
    if name == "avx" {
      return 1
    }
    if name == "avx2" {
      return 2
    }
    if name == "avx512bw" {
      return 3
    }
    if name == "avx512cd" {
      return 4
    }
    if name == "avx512dq" {
      return 5
    }
    if name == "avx512f" {
      return 6
    }
    if name == "avx512vbmi" {
      return 7
    }
    if name == "avx512vl" {
      return 8
    }
    if name == "bmi" {
      return 9
    }
    if name == "bmi2" {
      return 10
    }
    if name == "cx16" {
      return 11
    }
    if name == "f16c" {
      return 12
    }
    if name == "fma" {
      return 13
    }
    if name == "lzcnt" {
      return 14
    }
    if name == "movbe" {
      return 15
    }
    if name == "pclmul" {
      return 16
    }
    if name == "popcnt" {
      return 17
    }
    if name == "sha" {
      return 18
    }
    if name == "sse2" {
      return 19
    }
    if name == "sse3" {
      return 20
    }
    if name == "sse4.1" {
      return 21
    }
    if name == "sse4.2" {
      return 22
    }
    if name == "ssse3" {
      return 23
    }
    if name == "xsave" {
      return 24
    }
  }
  static if Target.arch() == Arch.Aarch64 {
    if name == "aes" {
      return 0
    }
    if name == "crc" {
      return 1
    }
    if name == "crypto" {
      return 2
    }
    if name == "dotprod" {
      return 3
    }
    if name == "fp-armv8" {
      return 4
    }
    if name == "fullfp16" {
      return 5
    }
    if name == "i8mm" {
      return 6
    }
    if name == "lse" {
      return 7
    }
    if name == "neon" {
      return 8
    }
    if name == "rdm" {
      return 9
    }
    if name == "sha2" {
      return 10
    }
    if name == "sha3" {
      return 11
    }
  }
  static if Target.arch() == Arch.Wasm32 {
    if name == "atomics" {
      return 0
    }
    if name == "bulk-memory" {
      return 1
    }
    if name == "mutable-globals" {
      return 2
    }
    if name == "relaxed-simd" {
      return 3
    }
    if name == "sign-ext" {
      return 4
    }
    if name == "simd128" {
      return 5
    }
  }
  return 64
}

unsafe extern "C" fn getauxval(kind: u64) -> u64
unsafe extern "C" fn sysctlbyname(name: ?[*]const u8, value: *mut i32, length: *mut usize, replacement: ?*mut u8, replacementLength: usize) -> i32 with Intrinsic.foreign(noCapture: ("name", "value", "length", "replacement"))

static if Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetArchitecture() == "x86_64" {
  // `cpuid` overwrites rbx, which LLVM may reserve, so each read saves it in r8.
  unsafe fn cpuidA(leaf: u64, sub: u64) -> u64 {
    return unsafe Intrinsic.assembly<u64>(
      "movq %rbx, %r8; movl %r9d, %ecx; cpuid; movq %r8, %rbx",
      "={rax},0,{r9}",
      "rcx,rdx,r8,flags",
      "none",
      false,
      false, (leaf, sub),
    )
  }
  unsafe fn cpuidB(leaf: u64, sub: u64) -> u64 {
    return unsafe Intrinsic.assembly<u64>(
      "movq %rbx, %r8; movl %r9d, %ecx; cpuid; movl %ebx, %eax; movq %r8, %rbx",
      "={rax},0,{r9}",
      "rcx,rdx,r8,flags",
      "none",
      false,
      false, (leaf, sub),
    )
  }
  unsafe fn cpuidC(leaf: u64, sub: u64) -> u64 {
    return unsafe Intrinsic.assembly<u64>(
      "movq %rbx, %r8; movl %r9d, %ecx; cpuid; movl %ecx, %eax; movq %r8, %rbx",
      "={rax},0,{r9}",
      "rcx,rdx,r8,flags",
      "none",
      false,
      false, (leaf, sub),
    )
  }
  unsafe fn cpuidD(leaf: u64, sub: u64) -> u64 {
    return unsafe Intrinsic.assembly<u64>(
      "movq %rbx, %r8; movl %r9d, %ecx; cpuid; movl %edx, %eax; movq %r8, %rbx",
      "={rax},0,{r9}",
      "rcx,rdx,r8,flags",
      "none",
      false,
      false, (leaf, sub),
    )
  }
  // Extended control register 0: which register files the operating system saves.
  unsafe fn xgetbv(register: u64) -> u64 {
    return unsafe Intrinsic.assembly<u64>(
      "xgetbv",
      "={rax},{rcx}",
      "rdx",
      "none",
      false,
      false, (register,),
    )
  }
  unsafe fn x86Bits() -> u64 {
    let mut bits: u64 = 0
    let highest = unsafe cpuidA(0, 0)
    let leaf1c = unsafe cpuidC(1, 0)
    let leaf1d = unsafe cpuidD(1, 0)
    let mut leaf7b: u64 = 0
    let mut leaf7c: u64 = 0
    if highest >= 7 {
      leaf7b = unsafe cpuidB(7, 0)
      leaf7c = unsafe cpuidC(7, 0)
    }
    let mut extendedc: u64 = 0
    if unsafe cpuidA(2147483648, 0) >= 2147483649 {
      extendedc = unsafe cpuidC(2147483649, 0)
    }
    let mut avxState = false
    let mut avx512State = false
    if hasBit(leaf1c, 27) {
      // Bits 1 and 2 are SSE and AVX state; bits 5 through 7 are AVX-512 state.
      let state = unsafe xgetbv(0)
      avxState = (state & 6) == 6
      avx512State = (state & 230) == 230
    }
    if hasBit(leaf1c, 25) {
      bits = bits | bit(0)
    }
    if hasBit(leaf1c, 28) && avxState {
      bits = bits | bit(1)
    }
    if hasBit(leaf7b, 5) && avxState {
      bits = bits | bit(2)
    }
    if hasBit(leaf7b, 30) && avx512State {
      bits = bits | bit(3)
    }
    if hasBit(leaf7b, 28) && avx512State {
      bits = bits | bit(4)
    }
    if hasBit(leaf7b, 17) && avx512State {
      bits = bits | bit(5)
    }
    if hasBit(leaf7b, 16) && avx512State {
      bits = bits | bit(6)
    }
    if hasBit(leaf7c, 1) && avx512State {
      bits = bits | bit(7)
    }
    if hasBit(leaf7b, 31) && avx512State {
      bits = bits | bit(8)
    }
    if hasBit(leaf7b, 3) {
      bits = bits | bit(9)
    }
    if hasBit(leaf7b, 8) {
      bits = bits | bit(10)
    }
    if hasBit(leaf1c, 13) {
      bits = bits | bit(11)
    }
    if hasBit(leaf1c, 29) && avxState {
      bits = bits | bit(12)
    }
    if hasBit(leaf1c, 12) && avxState {
      bits = bits | bit(13)
    }
    if hasBit(extendedc, 5) {
      bits = bits | bit(14)
    }
    if hasBit(leaf1c, 22) {
      bits = bits | bit(15)
    }
    if hasBit(leaf1c, 1) {
      bits = bits | bit(16)
    }
    if hasBit(leaf1c, 23) {
      bits = bits | bit(17)
    }
    if hasBit(leaf7b, 29) {
      bits = bits | bit(18)
    }
    if hasBit(leaf1d, 26) {
      bits = bits | bit(19)
    }
    if hasBit(leaf1c, 0) {
      bits = bits | bit(20)
    }
    if hasBit(leaf1c, 19) {
      bits = bits | bit(21)
    }
    if hasBit(leaf1c, 20) {
      bits = bits | bit(22)
    }
    if hasBit(leaf1c, 9) {
      bits = bits | bit(23)
    }
    if hasBit(leaf1c, 26) {
      bits = bits | bit(24)
    }
    return bits
  }
}

static if Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.profileText("libc") == "gnu" {
  unsafe fn aarch64LinuxBits() -> u64 {
    // AT_HWCAP and AT_HWCAP2.
    let hwcap: u64 = unsafe getauxval(16)
    let hwcap2: u64 = unsafe getauxval(26)
    let mut bits: u64 = 0
    if hasBit(hwcap, 3) {
      bits = bits | bit(0)
    }
    if hasBit(hwcap, 7) {
      bits = bits | bit(1)
    }
    if hasBit(hwcap, 3) && hasBit(hwcap, 6) {
      bits = bits | bit(2)
    }
    if hasBit(hwcap, 20) {
      bits = bits | bit(3)
    }
    if hasBit(hwcap, 0) {
      bits = bits | bit(4)
    }
    if hasBit(hwcap, 9) && hasBit(hwcap, 10) {
      bits = bits | bit(5)
    }
    if hasBit(hwcap2, 13) {
      bits = bits | bit(6)
    }
    if hasBit(hwcap, 8) {
      bits = bits | bit(7)
    }
    if hasBit(hwcap, 1) {
      bits = bits | bit(8)
    }
    if hasBit(hwcap, 12) {
      bits = bits | bit(9)
    }
    if hasBit(hwcap, 6) {
      bits = bits | bit(10)
    }
    if hasBit(hwcap, 17) {
      bits = bits | bit(11)
    }
    return bits
  }
}

static if Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.profileText("libc") == "system" {
  /// Reads one `hw.optional` flag. `name` ends with a zero byte.
  fn darwinFlag(name: &[u8]) -> bool {
    let mut value: i32 = 0
    let mut length: usize = 4
    let status = unsafe sysctlbyname(Pointer.fromSlice<u8>(name), Pointer.fromMutRef<i32>(&mut value), Pointer.fromMutRef<usize>(&mut length), Pointer.null<u8>(), 0)
    return status == 0 && value != 0
  }
  unsafe fn aarch64DarwinBits() -> u64 {
    let mut bits: u64 = 0
    if darwinFlag(b"hw.optional.arm.FEAT_AES\0") {
      bits = bits | bit(0)
    }
    if darwinFlag(b"hw.optional.armv8_crc32\0") {
      bits = bits | bit(1)
    }
    if darwinFlag(b"hw.optional.arm.FEAT_AES\0") && darwinFlag(b"hw.optional.arm.FEAT_SHA256\0") {
      bits = bits | bit(2)
    }
    if darwinFlag(b"hw.optional.arm.FEAT_DotProd\0") {
      bits = bits | bit(3)
    }
    if darwinFlag(b"hw.optional.floatingpoint\0") {
      bits = bits | bit(4)
    }
    if darwinFlag(b"hw.optional.arm.FEAT_FP16\0") {
      bits = bits | bit(5)
    }
    if darwinFlag(b"hw.optional.arm.FEAT_I8MM\0") {
      bits = bits | bit(6)
    }
    if darwinFlag(b"hw.optional.arm.FEAT_LSE\0") {
      bits = bits | bit(7)
    }
    if darwinFlag(b"hw.optional.neon\0") {
      bits = bits | bit(8)
    }
    if darwinFlag(b"hw.optional.arm.FEAT_RDM\0") {
      bits = bits | bit(9)
    }
    if darwinFlag(b"hw.optional.arm.FEAT_SHA256\0") {
      bits = bits | bit(10)
    }
    if darwinFlag(b"hw.optional.arm.FEAT_SHA3\0") {
      bits = bits | bit(11)
    }
    return bits
  }
}
