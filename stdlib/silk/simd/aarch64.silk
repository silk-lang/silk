//! AArch64 NEON instructions that the portable `silk.simd.simd` operations do not express: table
//! lookups, dot products, pairwise sums, and AES round steps.
//!
//! # When to use
//! Use this module in kernels such as UTF-8 validation, base64 decoding, and checksums, where
//! one of these instructions replaces several portable steps. Use `silk.simd.simd` for everything
//! else.
//!
//! # Details
//! Each function names the instruction it stands for and the CPU feature that instruction
//! needs. When the build targets AArch64 with that feature, the function compiles to the one
//! instruction. Otherwise it computes the same lanes with portable code, which is correct on
//! every target but slower. Every AArch64 build has NEON; the dot products need the `dotprod`
//! feature, and the AES steps the `aes` feature.
//!
//! # Examples
//! ## Look up bytes in a table
//! ```silk
//! import silk.simd.aarch64
//! import silk.simd.u8x16
//!
//! pub fn main() -> i32 {
//!   let squares = u8x16.fromArray([0, 1, 4, 9, 16, 25, 36, 49, 64, 81, 100, 121, 144, 169, 196, 225])
//!   let picked = aarch64.tableLookup(squares, u8x16.splat(12))
//!   if u8x16.extract(picked, 0) != 144 || u8x16.extract(aarch64.tableLookup(squares, u8x16.splat(16)), 0) != 0 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category SIMD

import silk.simd.i8x16
import silk.simd.i32x4
import silk.simd.u8x16
import silk.simd.u16x8
import silk.simd.u32x4
import silk.crypto.aes_round
import silk.core.target {Arch, Target}
import silk.num.i8
import silk.num.i32
import silk.num.u8
import silk.num.u16
import silk.num.u32

/// `tbl` (NEON): lane `i` is `table[indices[i]]`, or `0` when `indices[i]` is 16 or more.
///
/// Every AArch64 build has NEON, so on AArch64 it compiles to this one instruction. On another
/// target it computes the same lanes with portable code, which is correct but slower.
pub fn tableLookup(table: simd<u8, 16>, indices: simd<u8, 16>) -> simd<u8, 16> {
  static if Target.arch() == Arch.Aarch64 && Target.hasCpuFeature("neon") {
    return Intrinsic.aarch64TableLookup<simd<u8, 16>>(table, indices)
  }
  let lanes = u8x16.toArray(table)
  let picks = u8x16.toArray(indices)
  let mut result = u8x16.toArray(u8x16.splat(0))
  let mut at: usize = 0
  while at < 16 {
    if picks[at] < 16 {
      result[at] = lanes[u8.toUsize(picks[at])]
    }
    at = at + 1
  }
  return u8x16.fromArray(result)
}

/// `udot` (dotprod): lane `i` of `sum` plus the products of bytes `4 * i` to `4 * i + 3` of
/// `left` and `right`, wrapping.
///
/// When the build targets AArch64 with the `dotprod` feature, it compiles to this one instruction.
/// Otherwise it computes the same lanes with portable code, which is correct but slower.
pub fn dotProduct(sum: simd<u32, 4>, left: simd<u8, 16>, right: simd<u8, 16>) -> simd<u32, 4> {
  static if Target.arch() == Arch.Aarch64 && Target.hasCpuFeature("dotprod") {
    return Intrinsic.aarch64DotProduct<simd<u32, 4>>(sum, left, right)
  }
  let mut result = u32x4.toArray(sum)
  let a = u8x16.toArray(left)
  let b = u8x16.toArray(right)
  let mut at: usize = 0
  while at < 16 {
    result[at / 4] = u32.wrappingAdd(result[at / 4], u8.toU32(a[at]) * u8.toU32(b[at]))
    at = at + 1
  }
  return u32x4.fromArray(result)
}

/// `sdot` (dotprod): lane `i` of `sum` plus the products of signed bytes `4 * i` to `4 * i + 3` of
/// `left` and `right`, wrapping.
///
/// When the build targets AArch64 with the `dotprod` feature, it compiles to this one instruction.
/// Otherwise it computes the same lanes with portable code, which is correct but slower.
pub fn dotProductSigned(sum: simd<i32, 4>, left: simd<i8, 16>, right: simd<i8, 16>) -> simd<i32, 4> {
  static if Target.arch() == Arch.Aarch64 && Target.hasCpuFeature("dotprod") {
    return Intrinsic.aarch64DotProduct<simd<i32, 4>>(sum, left, right)
  }
  let mut result = i32x4.toArray(sum)
  let a = i8x16.toArray(left)
  let b = i8x16.toArray(right)
  let mut at: usize = 0
  while at < 16 {
    result[at / 4] = i32.wrappingAdd(result[at / 4], i8.toI32(a[at]) * i8.toI32(b[at]))
    at = at + 1
  }
  return i32x4.fromArray(result)
}

/// `addp` (NEON): the wrapping sums of adjacent lane pairs of `left`, then of `right`.
///
/// Every AArch64 build has NEON, so on AArch64 it compiles to this one instruction. On another
/// target it computes the same lanes with portable code, which is correct but slower.
pub fn pairwiseAdd8(left: simd<u8, 16>, right: simd<u8, 16>) -> simd<u8, 16> {
  static if Target.arch() == Arch.Aarch64 && Target.hasCpuFeature("neon") {
    return Intrinsic.aarch64PairwiseAdd<simd<u8, 16>>(left, right)
  }
  let a = u8x16.toArray(left)
  let b = u8x16.toArray(right)
  let mut result = u8x16.toArray(u8x16.splat(0))
  let mut at: usize = 0
  while at < 8 {
    result[at] = u8.wrappingAdd(a[2 * at], a[2 * at + 1])
    result[at + 8] = u8.wrappingAdd(b[2 * at], b[2 * at + 1])
    at = at + 1
  }
  return u8x16.fromArray(result)
}

/// `addp` (NEON): the wrapping sums of adjacent sixteen-bit lane pairs of `left`, then of `right`.
///
/// Every AArch64 build has NEON, so on AArch64 it compiles to this one instruction. On another
/// target it computes the same lanes with portable code, which is correct but slower.
pub fn pairwiseAdd16(left: simd<u16, 8>, right: simd<u16, 8>) -> simd<u16, 8> {
  static if Target.arch() == Arch.Aarch64 && Target.hasCpuFeature("neon") {
    return Intrinsic.aarch64PairwiseAdd<simd<u16, 8>>(left, right)
  }
  let a = u16x8.toArray(left)
  let b = u16x8.toArray(right)
  let mut result = u16x8.toArray(u16x8.splat(0))
  let mut at: usize = 0
  while at < 4 {
    result[at] = u16.wrappingAdd(a[2 * at], a[2 * at + 1])
    result[at + 4] = u16.wrappingAdd(b[2 * at], b[2 * at + 1])
    at = at + 1
  }
  return u16x8.fromArray(result)
}

/// `addp` (NEON): the wrapping sums of adjacent 32-bit lane pairs of `left`, then of `right`.
///
/// Every AArch64 build has NEON, so on AArch64 it compiles to this one instruction. On another
/// target it computes the same lanes with portable code, which is correct but slower.
pub fn pairwiseAdd32(left: simd<u32, 4>, right: simd<u32, 4>) -> simd<u32, 4> {
  static if Target.arch() == Arch.Aarch64 && Target.hasCpuFeature("neon") {
    return Intrinsic.aarch64PairwiseAdd<simd<u32, 4>>(left, right)
  }
  let a = u32x4.toArray(left)
  let b = u32x4.toArray(right)
  let mut result = u32x4.toArray(u32x4.splat(0))
  let mut at: usize = 0
  while at < 2 {
    result[at] = u32.wrappingAdd(a[2 * at], a[2 * at + 1])
    result[at + 2] = u32.wrappingAdd(b[2 * at], b[2 * at + 1])
    at = at + 1
  }
  return u32x4.fromArray(result)
}

/// `aese` (AES): `key` added to `state`, then ShiftRows and SubBytes. An encryption round is
/// [`aesMixColumns`] of this result.
///
/// When the build targets AArch64 with the `aes` feature, it compiles to this one instruction.
/// Otherwise it computes the same lanes with portable code, which is correct but slower.
pub fn aesEncrypt(state: simd<u8, 16>, key: simd<u8, 16>) -> simd<u8, 16> {
  static if Target.arch() == Arch.Aarch64 && Target.hasCpuFeature("aes") {
    return Intrinsic.aarch64AesEncrypt<simd<u8, 16>>(state, key)
  }
  return aes_round.subBytes(aes_round.shiftRows(state ^ key))
}

/// `aesd` (AES): `key` added to `state`, then InvShiftRows and InvSubBytes.
///
/// When the build targets AArch64 with the `aes` feature, it compiles to this one instruction.
/// Otherwise it computes the same lanes with portable code, which is correct but slower.
pub fn aesDecrypt(state: simd<u8, 16>, key: simd<u8, 16>) -> simd<u8, 16> {
  static if Target.arch() == Arch.Aarch64 && Target.hasCpuFeature("aes") {
    return Intrinsic.aarch64AesDecrypt<simd<u8, 16>>(state, key)
  }
  return aes_round.inverseSubBytes(aes_round.inverseShiftRows(state ^ key))
}

/// `aesmc` (AES): AES MixColumns.
///
/// When the build targets AArch64 with the `aes` feature, it compiles to this one instruction.
/// Otherwise it computes the same lanes with portable code, which is correct but slower.
pub fn aesMixColumns(state: simd<u8, 16>) -> simd<u8, 16> {
  static if Target.arch() == Arch.Aarch64 && Target.hasCpuFeature("aes") {
    return Intrinsic.aarch64AesMixColumns<simd<u8, 16>>(state)
  }
  return aes_round.mixColumns(state)
}

/// `aesimc` (AES): AES InvMixColumns.
///
/// When the build targets AArch64 with the `aes` feature, it compiles to this one instruction.
/// Otherwise it computes the same lanes with portable code, which is correct but slower.
pub fn aesInverseMixColumns(state: simd<u8, 16>) -> simd<u8, 16> {
  static if Target.arch() == Arch.Aarch64 && Target.hasCpuFeature("aes") {
    return Intrinsic.aarch64AesInverseMixColumns<simd<u8, 16>>(state)
  }
  return aes_round.inverseMixColumns(state)
}

// The SHA-256 functions of FIPS 180-4, section 4.1.2.
fn bigSigma0(x: u32) -> u32 {
  return u32.bitXor(u32.bitXor(u32.rotateRight(x, 2), u32.rotateRight(x, 13)), u32.rotateRight(x, 22))
}

fn bigSigma1(x: u32) -> u32 {
  return u32.bitXor(u32.bitXor(u32.rotateRight(x, 6), u32.rotateRight(x, 11)), u32.rotateRight(x, 25))
}

fn smallSigma0(x: u32) -> u32 {
  return u32.bitXor(u32.bitXor(u32.rotateRight(x, 7), u32.rotateRight(x, 18)), u32.shiftRight(x, 3))
}

fn smallSigma1(x: u32) -> u32 {
  return u32.bitXor(u32.bitXor(u32.rotateRight(x, 17), u32.rotateRight(x, 19)), u32.shiftRight(x, 10))
}

// Four SHA-256 rounds over A..D and E..H (lane 0 first), returning the new A..D when
// `first`, else the new E..H.
fn sha256Rounds(abcd: simd<u32, 4>, efgh: simd<u32, 4>, wk: simd<u32, 4>, first: bool) -> simd<u32, 4> {
  let x = u32x4.toArray(abcd)
  let y = u32x4.toArray(efgh)
  let schedule = u32x4.toArray(wk)
  let mut a = x[0]
  let mut b = x[1]
  let mut c = x[2]
  let mut d = x[3]
  let mut e = y[0]
  let mut f = y[1]
  let mut g = y[2]
  let mut h = y[3]
  let mut round: usize = 0
  while round < 4 {
    let choose = u32.bitXor(u32.bitAnd(e, f), u32.bitAnd(u32.bitNot(e), g))
    let majority = u32.bitXor(u32.bitXor(u32.bitAnd(a, b), u32.bitAnd(a, c)), u32.bitAnd(b, c))
    let t1 = u32.wrappingAdd(u32.wrappingAdd(h, bigSigma1(e)), u32.wrappingAdd(choose, schedule[round]))
    let t2 = u32.wrappingAdd(bigSigma0(a), majority)
    h = g
    g = f
    f = e
    e = u32.wrappingAdd(d, t1)
    d = c
    c = b
    b = a
    a = u32.wrappingAdd(t1, t2)
    round = round + 1
  }
  if first {
    return u32x4.fromArray([a, b, c, d])
  }
  return u32x4.fromArray([e, f, g, h])
}

/// `sha256h` (SHA2): four SHA-256 rounds over A..D in `abcd` and E..H in `efgh`, with the
/// four message words plus round constants in `wk`. Returns the new A..D.
///
/// When the build targets AArch64 with the `sha2` feature, it compiles to this one instruction.
/// Otherwise it computes the same lanes with portable code, which is correct but slower.
pub fn sha256Hash(abcd: simd<u32, 4>, efgh: simd<u32, 4>, wk: simd<u32, 4>) -> simd<u32, 4> {
  static if Target.arch() == Arch.Aarch64 && Target.hasCpuFeature("sha2") {
    return Intrinsic.aarch64Sha256Hash<simd<u32, 4>>(abcd, efgh, wk)
  }
  return sha256Rounds(abcd, efgh, wk, true)
}

/// `sha256h2` (SHA2): the same four rounds as [`sha256Hash`], with `efgh` first, returning
/// the new E..H. Pass the A..D from before `sha256Hash`.
///
/// When the build targets AArch64 with the `sha2` feature, it compiles to this one instruction.
/// Otherwise it computes the same lanes with portable code, which is correct but slower.
pub fn sha256Hash2(efgh: simd<u32, 4>, abcd: simd<u32, 4>, wk: simd<u32, 4>) -> simd<u32, 4> {
  static if Target.arch() == Arch.Aarch64 && Target.hasCpuFeature("sha2") {
    return Intrinsic.aarch64Sha256Hash2<simd<u32, 4>>(efgh, abcd, wk)
  }
  return sha256Rounds(abcd, efgh, wk, false)
}

/// `sha256su0` (SHA2): the first step of the next four SHA-256 message words. With `W[0..3]`
/// in `left` and `W[4]` in lane 0 of `right`, lane `i` is `W[i] + sigma0(W[i + 1])`.
///
/// When the build targets AArch64 with the `sha2` feature, it compiles to this one instruction.
/// Otherwise it computes the same lanes with portable code, which is correct but slower.
pub fn sha256ScheduleUpdate0(left: simd<u32, 4>, right: simd<u32, 4>) -> simd<u32, 4> {
  static if Target.arch() == Arch.Aarch64 && Target.hasCpuFeature("sha2") {
    return Intrinsic.aarch64Sha256ScheduleUpdate0<simd<u32, 4>>(left, right)
  }
  let a = u32x4.toArray(left)
  let next = u32x4.extract(right, 0)
  let w0 = u32.wrappingAdd(a[0], smallSigma0(a[1]))
  let w1 = u32.wrappingAdd(a[1], smallSigma0(a[2]))
  let w2 = u32.wrappingAdd(a[2], smallSigma0(a[3]))
  let w3 = u32.wrappingAdd(a[3], smallSigma0(next))
  return u32x4.fromArray([w0, w1, w2, w3])
}

/// `sha256su1` (SHA2): the next four message words `W[16..19]`, from the
/// [`sha256ScheduleUpdate0`] result `partial`, `W[8..11]` in `middle` and `W[12..15]` in `last`.
///
/// When the build targets AArch64 with the `sha2` feature, it compiles to this one instruction.
/// Otherwise it computes the same lanes with portable code, which is correct but slower.
pub fn sha256ScheduleUpdate1(partial: simd<u32, 4>, middle: simd<u32, 4>, last: simd<u32, 4>) -> simd<u32, 4> {
  static if Target.arch() == Arch.Aarch64 && Target.hasCpuFeature("sha2") {
    return Intrinsic.aarch64Sha256ScheduleUpdate1<simd<u32, 4>>(partial, middle, last)
  }
  let p = u32x4.toArray(partial)
  let m = u32x4.toArray(middle)
  let l = u32x4.toArray(last)
  let w16 = u32.wrappingAdd(u32.wrappingAdd(p[0], m[1]), smallSigma1(l[2]))
  let w17 = u32.wrappingAdd(u32.wrappingAdd(p[1], m[2]), smallSigma1(l[3]))
  let w18 = u32.wrappingAdd(u32.wrappingAdd(p[2], m[3]), smallSigma1(w16))
  let w19 = u32.wrappingAdd(u32.wrappingAdd(p[3], l[0]), smallSigma1(w17))
  return u32x4.fromArray([w16, w17, w18, w19])
}
