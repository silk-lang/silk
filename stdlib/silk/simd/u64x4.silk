//! Operations on `simd<u64, 4>`: four unsigned 64-bit integer lanes in one 256-bit vector.
//!
//! # When to use
//! Use this module to work on four `u64` values at once. Use [`load`] and [`store`]
//! to move lanes between a slice and a vector, a lane comparison such as [`lanesEqual`] to make
//! a `mask<4>`, and `silk.simd.mask4` to test that mask.
//!
//! # Details
//! The operators `+`, `-`, `*`, `/`, `%`, `&`, `|`, `^` and `~` apply lane by lane and trap
//! exactly where the `u64` operator traps. Use [`wrappingAdd`] or [`saturatingAdd`] when
//! overflow is expected. `==` is true only when every lane is equal.
//! Lane `0` is at the lowest address in memory.
//!
//! # Examples
//! ## Find the first matching lane
//! ```silk
//! import silk.simd.mask4
//! import silk.simd.u64x4
//!
//! pub fn main() -> i32 {
//!   let mut values: [u64; 4] = u64x4.toArray(u64x4.splat(0))
//!   values[3] = 3
//!   let hits = u64x4.lanesEqual(u64x4.fromArray(values), u64x4.splat(3))
//!   if !mask4.any(hits) || mask4.firstSet(hits) != 3 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category SIMD

// Generated by .github/scripts/generate-simd-modules.mjs; edit the script, not this file.

