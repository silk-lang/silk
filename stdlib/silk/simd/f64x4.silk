//! Operations on `simd<f64, 4>`: four 64-bit float lanes in one 256-bit vector.
//!
//! # When to use
//! Use this module to work on four `f64` values at once. Use [`load`] and [`store`]
//! to move lanes between a slice and a vector, a lane comparison such as [`lanesEqual`] to make
//! a `mask<4>`, and `silk.simd.mask4` to test that mask.
//!
//! # Details
//! The operators `+`, `-`, `*`, `/` and `%` apply lane by lane and follow IEEE 754 as the
//! `f64` operators do. `==` is true only when every lane is equal, and a NaN lane is never
//! equal. [`reduceAdd`] adds lanes in order, so it gives the same result on every target.
//! Lane `0` is at the lowest address in memory.
//!
//! # Examples
//! ## Scale every lane and add the results
//! ```silk
//! import silk.simd.f64x4
//!
//! pub fn main() -> i32 {
//!   let values = f64x4.fromArray([1.0, 2.0, 3.0, 4.0])
//!   let doubled = f64x4.mulAdd(values, f64x4.splat(2.0), f64x4.splat(0.0))
//!   if f64x4.reduceAdd(doubled) != 20.0 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category SIMD

// Generated by .github/scripts/generate-simd-modules.mjs; edit the script, not this file.

/// The number of lanes in a vector.
pub const LANES: usize = 4

