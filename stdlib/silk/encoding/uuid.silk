//! UUID values and constructors for versions 1 through 8, with RFC 9562 byte order.
//!
//! # When to use
//! Use [`Uuid.v4`] for random identifiers and [`Uuid.v7`] for identifiers ordered by Unix milliseconds.
//! Use [`Uuid.v3`] or [`Uuid.v5`] for names in an existing namespace.
//!
//! # Details
//! Values store 16 bytes in network order. Parsing preserves every bit, including unknown versions and variants.
//! Constructors set the RFC variant. Version 2 uses the legacy DCE Security layout, outside RFC 9562.
//! Operations do not allocate. `formatInto` returns a borrowed text view into the supplied buffer.
//!
//! # Gotchas
//! UUIDs are identifiers, not secrets or authorization tokens. Name hashes do not resist deliberate collisions.
//! Time-based constructors do not persist a clock sequence or enforce monotonicity.
//!
//! # Examples
//! ## Create a stable identifier for a DNS name
//! ```silk
//! import silk.core.result { Result }
//! import silk.encoding.uuid { Uuid, UuidError }
//!
//! pub fn main() -> i32 {
//!   let namespace = Uuid.namespaceDns()
//!   let id = Uuid.v5(&namespace, "www.example.com")
//!   let mut output: [u8; 36] = [0; 36]
//!   return match Uuid.formatInto(&id, &mut output) {
//!     Result<string, UuidError>.Success { value } => {
//!       if value != "2ed6657d-e927-568b-95e1-2665a8aea6a2" {
//!         return 1
//!       }
//!       return 0
//!     }
//!     Result<string, UuidError>.Failure { error: _ } => 1
//!   }
//! }
//! ```
//!
//! # See also
//! [RFC 9562](https://www.rfc-editor.org/rfc/rfc9562.html) defines the UUID layouts and namespace rules.
//!
//! @category Data formats

import silk.equal { Equal }
import silk.format { Debug, Display, Format, Formatter }
import silk.io.writer { Writer, WriterError }
import silk.collections.hash { Hash, HashKey, HashSeed }
import silk.crypto.md5 { Md5 }
import silk.option { Option }
import silk.order { Order, Ordering }
import silk.core.ownership { Copy }
import silk.system.random { Random }
import silk.core.result { Result }
import silk.crypto.sha1 { Sha1 }
import silk.text.string { String }
import silk.collections.slice { Slice }
import silk.num.u8
import silk.num.u16
import silk.num.u32
import silk.num.u64
import silk.num.usize

/// A UUID as 16 bytes in network order. All bit patterns, including Nil and Max, are representable.
///
/// Equality and ordering compare the unsigned bytes in network order. Version 1 is not ordered by time.
pub struct Uuid {
  bytes: [u8; 16],
}

/// A rejected UUID input or a field that exceeds its format's bit width.
pub enum UuidError {
  /// Text is not exactly 36 ASCII characters in the 8-4-4-4-12 hexadecimal form.
  InvalidText,
  /// An output buffer has fewer than the required 36 or 45 bytes.
  BufferTooSmall,
  /// A timestamp exceeds 60 bits for versions 1, 2, and 6, or 48 bits for version 7.
  TimestampOutOfRange,
  /// A clock sequence exceeds 14 bits, or 6 bits for version 2.
  ClockSequenceOutOfRange,
  /// A DCE local domain is not person (0), group (1), or organization (2).
  InvalidDomain,
}

/// The UUID variant, determined by the leading bits of byte 8.
pub enum UuidVariant {
  /// The legacy Apollo NCS variant, with leading bit 0. This includes Nil.
  Ncs,
  /// The RFC 9562 variant, with leading bits 10.
  Rfc,
  /// The legacy Microsoft variant, with leading bits 110.
  Microsoft,
  /// The reserved variant, with leading bits 111. This includes Max.
  Reserved,
}

impl Copy for Uuid {}

impl Uuid {
  /// Returns the all-zero UUID, which has no version.
  pub fn nil() -> Self {
    return Uuid { bytes: [0; 16] }
  }

  /// Returns the all-one UUID, which has no version.
  pub fn max() -> Self {
    return Uuid { bytes: [255; 16] }
  }

  /// Returns the standard DNS namespace. Names use canonical DNS text chosen by the caller.
  pub fn namespaceDns() -> Self {
    return namespace(0x10)
  }

  /// Returns the standard URL namespace. The caller supplies the canonical URL spelling.
  pub fn namespaceUrl() -> Self {
    return namespace(0x11)
  }

  /// Returns the standard ISO OID namespace. Names use canonical OID text chosen by the caller.
  pub fn namespaceOid() -> Self {
    return namespace(0x12)
  }

  /// Returns the standard X.500 distinguished-name namespace. The caller chooses the canonical name encoding.
  pub fn namespaceX500() -> Self {
    return namespace(0x14)
  }

  /// Copies all 16 bytes in network order without validation or bit changes.
  pub fn fromBytes(bytes: [u8; 16]) -> Self {
    return Uuid { bytes: bytes }
  }

  /// Returns all 16 bytes in network order. No mixed-endian GUID conversion occurs.
  pub fn toBytes(self: &Self) -> [u8; 16] {
    return self.bytes
  }

  /// Returns whether all 128 bits are zero.
  pub fn isNil(self: &Self) -> bool {
    return same(&self, &Uuid.nil())
  }

  /// Returns whether all 128 bits are one.
  pub fn isMax(self: &Self) -> bool {
    return same(&self, &Uuid.max())
  }

  /// Returns the variant, including the NCS and reserved variants of Nil and Max.
  pub fn variant(self: &Self) -> UuidVariant {
    let byte = self.bytes[8]
    if byte < 128 {
      return UuidVariant.Ncs
    }
    if byte < 192 {
      return UuidVariant.Rfc
    }
    if byte < 224 {
      return UuidVariant.Microsoft
    }
    return UuidVariant.Reserved
  }

  /// Returns the version nibble for the RFC variant, including reserved version numbers.
  /// Otherwise, returns `None`.
  pub fn version(self: &Self) -> Option<u8> {
    if u8.bitAnd(self.bytes[8], 192) != 128 {
      return Option<u8>.none()
    }
    return Option<u8>.some(u8.shiftRight(self.bytes[6], 4))
  }

  /// Parses exactly 36 hexadecimal characters with hyphens at positions 8, 13, 18, and 23.
  ///
  /// Uppercase and lowercase digits are accepted. Whitespace, braces, and URN prefixes return `InvalidText`.
  /// All versions and variants are preserved, including Nil and Max.
  pub fn parse(text: string) -> Result<Self, UuidError> {
    return Uuid.parseBytes(String.utf8Bytes(text))
  }

  /// Parses the 36-byte ASCII UUID form, accepting both hex cases and preserving every bit.
  ///
  /// Invalid length, hex digits, or hyphen positions return `InvalidText`. Whitespace and prefixes are rejected.
  pub fn parseBytes(text: &[u8]) -> Result<Self, UuidError> {
    if text.length != 36 {
      return Result<Self, UuidError>.failResult(UuidError.InvalidText)
    }
    let mut bytes: [u8; 16] = [0; 16]
    let mut at: usize = 0
    let mut index: usize = 0
    while at < 36 {
      if at == 8 || at == 13 || at == 18 || at == 23 {
        if text[at] != 45 {
          return Result<Self, UuidError>.failResult(UuidError.InvalidText)
        }
        at = at + 1
      } else {
        let high = hex(text[at])
        let low = hex(text[at + 1])
        if high > 15 || low > 15 {
          return Result<Self, UuidError>.failResult(UuidError.InvalidText)
        }
        bytes[index] = high * 16 + low
        index = index + 1
        at = at + 2
      }
    }
    return Result<Self, UuidError>.succeed(Uuid { bytes: bytes })
  }

  /// Parses a `urn:uuid:` prefix, without case sensitivity, followed by the 36-character UUID form.
  ///
  /// Invalid syntax returns `InvalidText`. No percent decoding or whitespace removal occurs.
  pub fn parseUrn(text: string) -> Result<Self, UuidError> {
    let bytes = String.utf8Bytes(text)
    let prefix = b"urn:uuid:"
    if bytes.length != 45 {
      return Result<Self, UuidError>.failResult(UuidError.InvalidText)
    }
    let mut index: usize = 0
    while index < 9 {
      let mut byte = bytes[index]
      if byte >= 65 && byte <= 90 {
        byte = byte + 32
      }
      if byte != prefix[index] {
        return Result<Self, UuidError>.failResult(UuidError.InvalidText)
      }
      index = index + 1
    }
    return Uuid.parseBytes(Slice.view<u8>(bytes, 9, 36))
  }

  /// Writes lowercase UUID text and returns a view of the first 36 output bytes.
  ///
  /// `BufferTooSmall` leaves the output unchanged. Bytes after position 35 are unchanged.
  pub fn formatInto<'a>(self: &Self, output: &'a mut [u8]) -> Result<string<'a>, UuidError> {
    if output.length < 36 {
      return Result<string, UuidError>.failResult(UuidError.BufferTooSmall)
    }
    writeText(&self, &mut output, 0)
    let text = unsafe String.fromUtf8Unchecked(Slice.view<u8>(&output, 0, 36))
    return Result<string, UuidError>.succeed(text)
  }

  /// Writes lowercase `urn:uuid:` text and returns a view of the first 45 output bytes.
  ///
  /// `BufferTooSmall` leaves the output unchanged. Bytes after position 44 are unchanged.
  pub fn formatUrnInto<'a>(self: &Self, output: &'a mut [u8]) -> Result<string<'a>, UuidError> {
    if output.length < 45 {
      return Result<string, UuidError>.failResult(UuidError.BufferTooSmall)
    }
    let prefix = b"urn:uuid:"
    let mut index: usize = 0
    while index < 9 {
      output[index] = prefix[index]
      index = index + 1
    }
    writeText(&self, &mut output, 9)
    let text = unsafe String.fromUtf8Unchecked(Slice.view<u8>(&output, 0, 45))
    return Result<string, UuidError>.succeed(text)
  }

  /// Constructs version 1 from 100-nanosecond ticks since 1582-10-15, a 14-bit sequence, and a network-order node.
  ///
  /// Oversized timestamp or sequence fields return their range error. The caller must prevent repeated field combinations.
  /// Persist the sequence across restarts and change it when the clock moves backwards. For random nodes, set bit 0 of the first byte.
  pub fn v1(timestamp: u64, clockSequence: u16, node: [u8; 6]) -> Result<Self, UuidError> {
    return timeUuid(timestamp, clockSequence, node, 1)
  }

  /// Constructs version 6 from 100-nanosecond ticks since 1582-10-15, a 14-bit sequence, and a network-order node.
  ///
  /// Oversized timestamp or sequence fields return their range error. The caller must prevent repeated field combinations.
  /// Persist the sequence across restarts and change it when the clock moves backwards. For random nodes, set bit 0 of the first byte.
  pub fn v6(timestamp: u64, clockSequence: u16, node: [u8; 6]) -> Result<Self, UuidError> {
    return timeUuid(timestamp, clockSequence, node, 6)
  }

  /// Constructs a legacy DCE version 2 UUID with a local identifier and domain 0, 1, or 2.
  ///
  /// The timestamp uses Gregorian 100-nanosecond ticks. Its low 32 bits are replaced by the identifier.
  /// The sequence has only 6 bits. The caller must prevent repeats within each approximately 429-second timestamp interval.
  /// Invalid timestamp, sequence, or domain fields return the corresponding `UuidError`.
  pub fn v2(
    timestamp: u64,
    clockSequence: u8,
    node: [u8; 6],
    localDomain: u8,
    localId: u32
  ) -> Result<Self, UuidError> {
    if clockSequence > 63 {
      return Result<Self, UuidError>.failResult(UuidError.ClockSequenceOutOfRange)
    }
    if localDomain > 2 {
      return Result<Self, UuidError>.failResult(UuidError.InvalidDomain)
    }
    let mut value = match timeUuid(timestamp, u8.toU16(clockSequence) * 256, node, 1) {
      Result<Self, UuidError>.Success { value } => value
      Result<Self, UuidError>.Failure { error } => {
        return Result<Self, UuidError>.failResult(error)
      }
    }
    put(&mut value.bytes, 0, 4, u32.toU64(localId))
    value.bytes[9] = localDomain
    return Result<Self, UuidError>.succeed(stamp(value.bytes, 2))
  }

  /// Returns version 3 from MD5 of the namespace bytes followed by the name's UTF-8 bytes.
  ///
  /// No case folding or Unicode normalization occurs. MD5 does not resist deliberate collisions.
  pub fn v3(namespace: &Self, name: string) -> Self {
    return Uuid.v3Bytes(namespace, String.utf8Bytes(name))
  }

  /// Returns version 3 from MD5 of network-order namespace bytes followed by the exact name bytes.
  ///
  /// The caller selects the canonical encoding. MD5 does not resist deliberate collisions.
  pub fn v3Bytes(namespace: &Self, name: &[u8]) -> Self {
    let mut state = Md5.make()
    state.update(&namespace.bytes)
    state.update(name)
    return stamp(state.finish(), 3)
  }

  /// Returns version 5 from SHA-1 of the namespace bytes followed by the name's UTF-8 bytes.
  ///
  /// No case folding or Unicode normalization occurs. SHA-1 does not resist deliberate collisions.
  pub fn v5(namespace: &Self, name: string) -> Self {
    return Uuid.v5Bytes(namespace, String.utf8Bytes(name))
  }

  /// Returns version 5 from SHA-1 of network-order namespace bytes followed by the exact name bytes.
  ///
  /// The caller selects the canonical encoding. SHA-1 does not resist deliberate collisions.
  pub fn v5Bytes(namespace: &Self, name: &[u8]) -> Self {
    let mut state = Sha1.make()
    state.update(&namespace.bytes)
    state.update(name)
    let digest = state.finish()
    let mut bytes: [u8; 16] = [0; 16]
    let mut index: usize = 0
    while index < 16 {
      bytes[index] = digest[index]
      index = index + 1
    }
    return stamp(bytes, 5)
  }

  /// Returns version 4 using 16 bytes from `Random`, retaining 122 random bits after version and variant substitution.
  pub effect fn v4() -> Self
    ? &mut Random {
    let mut bytes: [u8; 16] = [0; 16]
    run Random.fillBytes(&mut bytes)
    return stamp(bytes, 4)
  }

  /// Constructs version 4 from 16 caller-supplied random bytes, overwriting only version and variant bits.
  ///
  /// The caller must supply fresh cryptographically secure randomness for each identifier.
  pub fn v4FromRandom(random: [u8; 16]) -> Self {
    return stamp(random, 4)
  }

  /// Returns version 7 with a 48-bit Unix millisecond timestamp and 74 bits from `Random`.
  ///
  /// An oversized timestamp returns `TimestampOutOfRange` before reading randomness.
  /// Calls within one millisecond are randomly ordered. Clock rollback can produce values smaller than earlier values.
  pub effect fn v7(unixMilliseconds: u64) -> Result<Self, UuidError>
    ? &mut Random {
    if unixMilliseconds > 0xffffffffffff {
      return Result<Self, UuidError>.failResult(UuidError.TimestampOutOfRange)
    }
    let mut random: [u8; 10] = [0; 10]
    run Random.fillBytes(&mut random)
    return Uuid.v7FromRandom(unixMilliseconds, random)
  }

  /// Constructs version 7 from Unix milliseconds and 10 random bytes, retaining 74 random bits.
  ///
  /// An oversized timestamp returns `TimestampOutOfRange`. The caller supplies fresh secure randomness for each identifier.
  /// The version replaces the first random byte's high nibble.
  /// The variant replaces the third byte's two high bits.
  pub fn v7FromRandom(unixMilliseconds: u64, random: [u8; 10]) -> Result<Self, UuidError> {
    if unixMilliseconds > 0xffffffffffff {
      return Result<Self, UuidError>.failResult(UuidError.TimestampOutOfRange)
    }
    let mut bytes: [u8; 16] = [0; 16]
    put(&mut bytes, 0, 6, unixMilliseconds)
    let mut index: usize = 0
    while index < 10 {
      bytes[index + 6] = random[index]
      index = index + 1
    }
    return Result<Self, UuidError>.succeed(stamp(bytes, 7))
  }

  /// Constructs version 8 from application-defined bytes, overwriting only the version and variant bits.
  ///
  /// The remaining 122 bits have no standard interpretation. The caller defines their encoding and uniqueness policy.
  pub fn v8(custom: [u8; 16]) -> Self {
    return stamp(custom, 8)
  }

  /// Returns Gregorian 100-nanosecond ticks for RFC versions 1 and 6.
  /// Otherwise, returns `None`.
  ///
  /// Version 2 cannot recover the original timestamp because its low 32 bits hold the local identifier.
  pub fn gregorianTimestamp(self: &Self) -> Option<u64> {
    if isVersion(&self, 1) {
      let low = get(&self.bytes, 0, 4)
      let mid = get(&self.bytes, 4, 2)
      let high = u64.bitAnd(get(&self.bytes, 6, 2), 4095)
      return Option<u64>.some(
        u64.bitOr(low, u64.bitOr(u64.shiftLeft(mid, 32), u64.shiftLeft(high, 48)))
      )
    }
    if isVersion(&self, 6) {
      return Option<u64>.some(
        u64.bitOr(
          u64.shiftLeft(get(&self.bytes, 0, 6), 12),
          u64.bitAnd(get(&self.bytes, 6, 2), 4095)
        )
      )
    }
    return Option<u64>.none()
  }

  /// Returns the Unix millisecond timestamp for RFC version 7.
  /// Otherwise, returns `None`.
  pub fn unixMilliseconds(self: &Self) -> Option<u64> {
    if !isVersion(&self, 7) {
      return Option<u64>.none()
    }
    return Option<u64>.some(get(&self.bytes, 0, 6))
  }

  /// Returns the 14-bit clock sequence for RFC versions 1 and 6, or the 6-bit sequence for version 2.
  ///
  /// Other versions and variants return `None`.
  pub fn clockSequence(self: &Self) -> Option<u16> {
    if isVersion(&self, 2) {
      return Option<u16>.some(u8.toU16(u8.bitAnd(self.bytes[8], 63)))
    }
    if !isVersion(&self, 1) && !isVersion(&self, 6) {
      return Option<u16>.none()
    }
    return Option<u16>.some(u64.toU16(u64.bitAnd(get(&self.bytes, 8, 2), 16383)))
  }

  /// Returns the network-order node for RFC versions 1, 2, and 6.
  /// Otherwise, returns `None`.
  pub fn node(self: &Self) -> Option<[u8; 6]> {
    if !isVersion(&self, 1) && !isVersion(&self, 2) && !isVersion(&self, 6) {
      return Option<[u8; 6]>.none()
    }
    return Option<[u8; 6]>.some(
      [
        self.bytes[10],
        self.bytes[11],
        self.bytes[12],
        self.bytes[13],
        self.bytes[14],
        self.bytes[15]
      ]
    )
  }

  /// Returns the local identifier for RFC version 2.
  /// Otherwise, returns `None`.
  pub fn localId(self: &Self) -> Option<u32> {
    if !isVersion(&self, 2) {
      return Option<u32>.none()
    }
    return Option<u32>.some(u64.toU32(get(&self.bytes, 0, 4)))
  }

  /// Returns the local domain byte for RFC version 2, including unknown domains.
  /// Otherwise, returns `None`.
  pub fn localDomain(self: &Self) -> Option<u8> {
    if !isVersion(&self, 2) {
      return Option<u8>.none()
    }
    return Option<u8>.some(self.bytes[9])
  }

  /// Converts RFC version 1 to version 6 without changing its timestamp, sequence, or node.
  /// Otherwise, returns `None`.
  pub fn toV6(self: &Self) -> Option<Self> {
    return convertTime(&self, 1, 6)
  }

  /// Converts RFC version 6 to version 1 without changing its timestamp, sequence, or node.
  /// Otherwise, returns `None`.
  pub fn toV1(self: &Self) -> Option<Self> {
    return convertTime(&self, 6, 1)
  }
}

fn namespace(last: u8) -> Uuid {
  return Uuid {
    bytes: [
      0x6b,
      0xa7,
      0xb8,
      last,
      0x9d,
      0xad,
      0x11,
      0xd1,
      0x80,
      0xb4,
      0,
      0xc0,
      0x4f,
      0xd4,
      0x30,
      0xc8
    ]
  }
}

fn stamp(bytes: [u8; 16], version: u8) -> Uuid {
  let mut value = bytes
  value[6] = u8.bitOr(u8.bitAnd(value[6], 15), version * 16)
  value[8] = u8.bitOr(u8.bitAnd(value[8], 63), 128)
  return Uuid { bytes: value }
}

fn hex(byte: u8) -> u8 {
  if byte >= 48 && byte <= 57 {
    return byte - 48
  }
  if byte >= 65 && byte <= 70 {
    return byte - 55
  }
  if byte >= 97 && byte <= 102 {
    return byte - 87
  }
  return 255
}

fn writeText(value: &Uuid, output: &mut [u8], start: usize) -> () {
  let digits = b"0123456789abcdef"
  let mut index: usize = 0
  let mut at = start
  while index < 16 {
    if index == 4 || index == 6 || index == 8 || index == 10 {
      output[at] = 45
      at = at + 1
    }
    output[at] = digits[u8.toUsize(u8.shiftRight(value.bytes[index], 4))]
    output[at + 1] = digits[u8.toUsize(u8.bitAnd(value.bytes[index], 15))]
    at = at + 2
    index = index + 1
  }
  return ()
}

fn put(bytes: &mut [u8], start: usize, length: usize, value: u64) -> () {
  let mut index: usize = 0
  while index < length {
    bytes[start + index] = u64.toU8(
      u64.bitAnd(u64.shiftRight(value, usize.toU64((length - index - 1) * 8)), 255)
    )
    index = index + 1
  }
  return ()
}

fn get(bytes: &[u8], start: usize, length: usize) -> u64 {
  let mut value: u64 = 0
  let mut index: usize = 0
  while index < length {
    value = u64.bitOr(u64.shiftLeft(value, 8), u8.toU64(bytes[start + index]))
    index = index + 1
  }
  return value
}

fn timeUuid(timestamp: u64, sequence: u16, node: [u8; 6], version: u8) -> Result<Uuid, UuidError> {
  if timestamp > 0xfffffffffffffff {
    return Result<Uuid, UuidError>.failResult(UuidError.TimestampOutOfRange)
  }
  if sequence > 16383 {
    return Result<Uuid, UuidError>.failResult(UuidError.ClockSequenceOutOfRange)
  }
  let mut bytes: [u8; 16] = [0; 16]
  if version == 1 {
    put(&mut bytes, 0, 4, u64.bitAnd(timestamp, 0xffffffff))
    put(&mut bytes, 4, 2, u64.bitAnd(u64.shiftRight(timestamp, 32), 65535))
    put(&mut bytes, 6, 2, u64.shiftRight(timestamp, 48))
  } else {
    put(&mut bytes, 0, 6, u64.shiftRight(timestamp, 12))
    put(&mut bytes, 6, 2, u64.bitAnd(timestamp, 4095))
  }
  put(&mut bytes, 8, 2, u16.toU64(sequence))
  let mut index: usize = 0
  while index < 6 {
    bytes[index + 10] = node[index]
    index = index + 1
  }
  return Result<Uuid, UuidError>.succeed(stamp(bytes, version))
}

fn isVersion(value: &Uuid, version: u8) -> bool {
  return u8.bitAnd(value.bytes[8], 192) == 128 && u8.shiftRight(value.bytes[6], 4) == version
}

fn convertTime(value: &Uuid, from: u8, to: u8) -> Option<Uuid> {
  if !isVersion(value, from) {
    return Option<Uuid>.none()
  }
  let timestamp = Uuid.gregorianTimestamp(value) |> Option<u64>.unwrapOr(0)
  let sequence = Uuid.clockSequence(value) |> Option<u16>.unwrapOr(0)
  let node = Uuid.node(value) |> Option<[u8; 6]>.unwrapOr([0; 6])
  return match timeUuid(timestamp, sequence, node, to) {
    Result<Uuid, UuidError>.Success { value: converted } => Option<Uuid>.some(converted)
    Result<Uuid, UuidError>.Failure { error: _ } => Option<Uuid>.none()
  }
}

fn same(left: &Uuid, right: &Uuid) -> bool {
  let mut index: usize = 0
  while index < 16 {
    if left.bytes[index] != right.bytes[index] {
      return false
    }
    index = index + 1
  }
  return true
}

fn compare(left: &Uuid, right: &Uuid) -> Ordering {
  let mut index: usize = 0
  while index < 16 {
    if left.bytes[index] < right.bytes[index] {
      return Ordering.Less
    }
    if left.bytes[index] > right.bytes[index] {
      return Ordering.Greater
    }
    index = index + 1
  }
  return Ordering.Equal
}

fn hash(value: &Uuid, seed: &HashSeed) -> u64 {
  return Hash.combine(Hash.mix(seed, get(&value.bytes, 0, 8)), get(&value.bytes, 8, 8))
}

impl Equal for Uuid {
  equals: Uuid.same
}

impl Order for Uuid {
  compare: Uuid.compare
}

impl HashKey for Uuid {
  equals: Uuid.same

  hash: Uuid.hash
}

impl Display for Uuid {
  /// Writes the lowercase 36-character UUID form. Writer failures propagate unchanged.
  effect fn display(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    let mut output: [u8; 36] = [0; 36]
    writeText(self, &mut output, 0)
    return run Format.write(&mut formatter, &output)
  }
}

impl Debug for Uuid {
  /// Writes the lowercase 36-character UUID form. Writer failures propagate unchanged.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> ()
    ! WriterError
    ? &mut Writer {
    return run Display.display(self, &mut formatter)
  }
}
