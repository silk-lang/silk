//! Read and write 16-, 32- and 64-bit integers as little-endian or big-endian bytes in a slice.
//!
//! # When to use
//! Use these functions to read words from a byte buffer in a fixed byte order, for example the
//! message words of a hash block, or to write the fields of a binary format.
//!
//! # Details
//! Each call checks the bounds once and then moves the whole word, so a loop over a buffer
//! compiles to word loads and stores, and a big-endian access to one byte swap. The offset needs no
//! alignment. Nothing allocates.
//!
//! # Gotchas
//! A call traps when the word does not fit in the slice at `offset`. Check the length first when
//! the input comes from outside.
//!
//! # Examples
//! ## Read and write words in both byte orders
//! ```silk
//! import silk.encoding.endian
//!
//! pub fn main() -> i32 {
//!   let mut bytes: [u8; 8] = [0; 8]
//!   endian.writeU32BigEndian(&mut bytes, 0, 0x01020304)
//!   endian.writeU32LittleEndian(&mut bytes, 4, 0x01020304)
//!   if bytes[0] != 1 || bytes[3] != 4 || bytes[4] != 4 || bytes[7] != 1 {
//!     return 1
//!   }
//!   if endian.readU16BigEndian(&bytes, 1) != 0x0203 {
//!     return 2
//!   }
//!   if endian.readU64LittleEndian(&bytes, 0) != 0x0102030404030201 {
//!     return 3
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Encoding

import silk.mem.pointer {Pointer}
import silk.num.u16
import silk.num.u32
import silk.num.u64

/// Returns the little-endian `u16` in the 2 bytes of `bytes` at `offset`.
///
/// # Gotchas
/// Traps unless `offset + 2` is at most `bytes.length`.
pub fn readU16LittleEndian(bytes: &[u8], offset: usize) -> u16 {
  check(bytes.length, offset, 2)
  unsafe {
    return Pointer.readUnaligned<u16>(Intrinsic.pointerReinterpret<*const u8, *const align(1) u16>(at(bytes, offset)))
  }
}

/// Returns the big-endian `u16` in the 2 bytes of `bytes` at `offset`.
///
/// # Gotchas
/// Traps unless `offset + 2` is at most `bytes.length`.
pub fn readU16BigEndian(bytes: &[u8], offset: usize) -> u16 {
  return swap16(readU16LittleEndian(bytes, offset))
}

/// Returns the little-endian `u32` in the 4 bytes of `bytes` at `offset`.
///
/// # Gotchas
/// Traps unless `offset + 4` is at most `bytes.length`.
pub fn readU32LittleEndian(bytes: &[u8], offset: usize) -> u32 {
  check(bytes.length, offset, 4)
  unsafe {
    return Pointer.readUnaligned<u32>(Intrinsic.pointerReinterpret<*const u8, *const align(1) u32>(at(bytes, offset)))
  }
}

/// Returns the big-endian `u32` in the 4 bytes of `bytes` at `offset`.
///
/// # Gotchas
/// Traps unless `offset + 4` is at most `bytes.length`.
pub fn readU32BigEndian(bytes: &[u8], offset: usize) -> u32 {
  return swap32(readU32LittleEndian(bytes, offset))
}

/// Returns the little-endian `u64` in the 8 bytes of `bytes` at `offset`.
///
/// # Gotchas
/// Traps unless `offset + 8` is at most `bytes.length`.
pub fn readU64LittleEndian(bytes: &[u8], offset: usize) -> u64 {
  check(bytes.length, offset, 8)
  unsafe {
    return Pointer.readUnaligned<u64>(Intrinsic.pointerReinterpret<*const u8, *const align(1) u64>(at(bytes, offset)))
  }
}

/// Returns the big-endian `u64` in the 8 bytes of `bytes` at `offset`.
///
/// # Gotchas
/// Traps unless `offset + 8` is at most `bytes.length`.
pub fn readU64BigEndian(bytes: &[u8], offset: usize) -> u64 {
  return swap64(readU64LittleEndian(bytes, offset))
}

/// Writes `value` as 2 little-endian bytes into `bytes` at `offset`.
///
/// # Gotchas
/// Traps unless `offset + 2` is at most `bytes.length`.
pub fn writeU16LittleEndian(bytes: &mut [u8], offset: usize, value: u16) -> () {
  check(bytes.length, offset, 2)
  unsafe {
    Pointer.writeUnaligned<u16>(Intrinsic.pointerReinterpret<*mut u8, *mut align(1) u16>(atMut(&mut bytes, offset)), value)
  }
}

/// Writes `value` as 2 big-endian bytes into `bytes` at `offset`.
///
/// # Gotchas
/// Traps unless `offset + 2` is at most `bytes.length`.
pub fn writeU16BigEndian(bytes: &mut [u8], offset: usize, value: u16) -> () {
  writeU16LittleEndian(&mut bytes, offset, swap16(value))
}

/// Writes `value` as 4 little-endian bytes into `bytes` at `offset`.
///
/// # Gotchas
/// Traps unless `offset + 4` is at most `bytes.length`.
pub fn writeU32LittleEndian(bytes: &mut [u8], offset: usize, value: u32) -> () {
  check(bytes.length, offset, 4)
  unsafe {
    Pointer.writeUnaligned<u32>(Intrinsic.pointerReinterpret<*mut u8, *mut align(1) u32>(atMut(&mut bytes, offset)), value)
  }
}

/// Writes `value` as 4 big-endian bytes into `bytes` at `offset`.
///
/// # Gotchas
/// Traps unless `offset + 4` is at most `bytes.length`.
pub fn writeU32BigEndian(bytes: &mut [u8], offset: usize, value: u32) -> () {
  writeU32LittleEndian(&mut bytes, offset, swap32(value))
}

/// Writes `value` as 8 little-endian bytes into `bytes` at `offset`.
///
/// # Gotchas
/// Traps unless `offset + 8` is at most `bytes.length`.
pub fn writeU64LittleEndian(bytes: &mut [u8], offset: usize, value: u64) -> () {
  check(bytes.length, offset, 8)
  unsafe {
    Pointer.writeUnaligned<u64>(Intrinsic.pointerReinterpret<*mut u8, *mut align(1) u64>(atMut(&mut bytes, offset)), value)
  }
}

/// Writes `value` as 8 big-endian bytes into `bytes` at `offset`.
///
/// # Gotchas
/// Traps unless `offset + 8` is at most `bytes.length`.
pub fn writeU64BigEndian(bytes: &mut [u8], offset: usize, value: u64) -> () {
  writeU64LittleEndian(&mut bytes, offset, swap64(value))
}

// Silk targets are little-endian (`Target.endianness` has no other value), so an unaligned load
// gives the little-endian value.
fn check(length: usize, offset: usize, size: usize) -> () {
  if offset > length || length - offset < size {
    Intrinsic.trap("silk.encoding.endian: the word ends past the end of the slice")
  }
}

// The checks above prove that the slice is not empty, so its pointer is not null.
unsafe fn at(bytes: &[u8], offset: usize) -> *const u8 {
  unsafe {
    let base = Intrinsic.pointerRequalify<?[*]const u8, [*]const u8>(Pointer.fromSlice<u8>(bytes))
    return Pointer.at<u8>(base, offset)
  }
}

unsafe fn atMut(bytes: &mut [u8], offset: usize) -> *mut u8 {
  unsafe {
    let base = Intrinsic.pointerRequalify<?[*]mut u8, [*]mut u8>(Pointer.fromMutSlice<u8>(&mut bytes))
    return Pointer.atMut<u8>(base, offset)
  }
}

// LLVM turns these shift patterns into one byte swap instruction.
fn swap16(value: u16) -> u16 {
  return u16.bitOr(u16.shiftLeft(value, 8), u16.shiftRight(value, 8))
}

fn swap32(value: u32) -> u32 {
  return u32.bitOr(
    u32.bitOr(u32.shiftLeft(value, 24), u32.bitAnd(u32.shiftLeft(value, 8), 0x00ff0000)),
    u32.bitOr(u32.bitAnd(u32.shiftRight(value, 8), 0x0000ff00), u32.shiftRight(value, 24)),
  )
}

fn swap64(value: u64) -> u64 {
  let high = u64.toU32(u64.shiftRight(value, 32))
  let low = u64.toU32(u64.bitAnd(value, 0xffffffff))
  return u64.bitOr(u64.shiftLeft(u32.toU64(swap32(low)), 32), u32.toU64(swap32(high)))
}
