//! Compile-time descriptions of the fields of a struct or tuple type, for generic code that visits
//! each field.
//!
//! # When to use
//! Use [`Reflect`] to write one generic function that works on the fields of many types, such as a
//! serializer or a formatter. Use [`Reflect.fields`] with `static for` to visit each field, and
//! [`Reflect.borrowField`] to read the value of a field at runtime, or [`Reflect.borrowFieldMut`]
//! to change it.
//!
//! # Details
//! Descriptors exist only during static evaluation. They have no runtime value, so reflection adds
//! no runtime cost. The compiler expands a `static for` over [`Reflect.fields`] into one copy of
//! the loop body for each field, in declaration order. In each copy, the field has its own type.
//!
//! A descriptor shows only the fields that are visible from the module that calls the reflection
//! operation. Private fields of a type from another module are not in the list.
//!
//! # Examples
//! ## Add all fields of a struct
//! ```silk
//! import silk.reflect { Reflect }
//!
//! struct Pair {
//!   pub first: i32,
//!   pub second: i32,
//! }
//!
//! fn sum(owner: &Pair) -> i32 {
//!   let mut total = 0
//!   static for field in Reflect.fields<Pair>() {
//!     total = total + Reflect.borrowField<Pair, i32>(owner, field).*
//!   }
//!   return total
//! }
//!
//! pub fn main() -> i32 {
//!   let pair = Pair { first: 20, second: 22 }
//!   if sum(&pair) != 42 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Core

/// The [`Reflect.typeKind`] result for a declared struct with named fields.
pub const namedKind: u8 = 0

/// The [`Reflect.typeKind`] result for a declared tuple type with positional fields.
pub const positionalKind: u8 = 1

/// The [`Reflect.typeKind`] result for an anonymous record with named fields.
pub const anonymousNamedKind: u8 = 2

/// The [`Reflect.typeKind`] result for an anonymous tuple with positional fields.
pub const anonymousPositionalKind: u8 = 3

/// The [`Reflect.typeKind`] result for a fixed array, such as `[i32; 3]`. It has no fields.
pub const arrayKind: u8 = 4

/// The [`Reflect.typeKind`] result for every other type, such as `i32`, `string`, a slice, an
/// enum, or a union. It has no fields.
pub const otherKind: u8 = 5

/// The [`Reflect.fieldKind`] result for a field with a name. Read the name with
/// [`Reflect.fieldLabel`].
pub const labeledFieldKind: u8 = 0

/// The [`Reflect.fieldKind`] result for a field with a position. Read the position with
/// [`Reflect.fieldOrdinal`].
pub const positionalFieldKind: u8 = 1

/// The owner type of the reflection operations. It has no fields and is never constructed.
///
/// # Details
///
/// Each operation except [`Reflect.borrowField`] and [`Reflect.borrowFieldMut`] is `static`. It
/// runs only during static evaluation, such as in a `static for`, a `static if`, or a `static fn`.
pub struct Reflect {}

impl Reflect {
  /// Returns the compile-time descriptor of the struct or tuple type `Owner`.
  ///
  /// # Details
  ///
  /// Give the descriptor to [`Reflect.typeKind`] to find the kind of type.
  pub static fn typeOf<Owner>() -> Intrinsic.Type<Owner> {
    return Intrinsic.reflectType<Owner>()
  }
  /// Returns the compile-time descriptors of the fields of `Owner`, in declaration order.
  ///
  /// # Details
  ///
  /// Use the result as the sequence of a `static for`. Each element has the type
  /// `Intrinsic.Field<Owner, Value>`, where `Value` is the type of that field.
  ///
  /// # Gotchas
  ///
  /// The list contains only the `pub` fields, even when the caller is the module that declares
  /// `Owner`, because visibility is judged from `silk/reflect`. Call `Intrinsic.reflectFields<Owner>()`
  /// directly to list the fields that the calling module can see.
  pub static fn fields<Owner>() -> Intrinsic.Fields<Owner> {
    return Intrinsic.reflectFields<Owner>()
  }
  /// Returns the kind of type that `descriptor` describes: [`namedKind`], [`positionalKind`],
  /// [`anonymousNamedKind`], [`anonymousPositionalKind`], [`arrayKind`], or [`otherKind`]. Every
  /// type has a kind, so a generic function can branch on the kind of its type parameter.
  pub static fn typeKind<Owner>(descriptor: Intrinsic.Type<Owner>) -> u8 {
    return Intrinsic.reflectTypeKind<Owner>(descriptor)
  }
  /// Returns [`labeledFieldKind`] for a named field, or [`positionalFieldKind`] for a positional
  /// field.
  pub static fn fieldKind<Owner, Value>(field: Intrinsic.Field<Owner, Value>) -> u8 {
    return Intrinsic.reflectFieldKind<Owner, Value>(field)
  }
  /// Returns the name of a named field, as written in the type declaration.
  ///
  /// # Gotchas
  ///
  /// Use this function only for a field where [`Reflect.fieldKind`] is [`labeledFieldKind`].
  pub static fn fieldLabel<Owner, Value>(field: Intrinsic.Field<Owner, Value>) -> string<'static> {
    return Intrinsic.reflectFieldLabel<Owner, Value>(field)
  }
  /// Returns the zero-based position of a positional field.
  ///
  /// # Gotchas
  ///
  /// Use this function only for a field where [`Reflect.fieldKind`] is [`positionalFieldKind`].
  pub static fn fieldOrdinal<Owner, Value>(field: Intrinsic.Field<Owner, Value>) -> usize {
    return Intrinsic.reflectFieldOrdinal<Owner, Value>(field)
  }
  /// Returns a shared borrow of the field of `owner` that `field` describes.
  ///
  /// # Details
  ///
  /// `field` is a static argument, so the compiler selects the field during specialization. At
  /// runtime this function is a plain field access. The borrow lives as long as the borrow of
  /// `owner`.
  ///
  /// # Gotchas
  ///
  /// `field` must come from [`Reflect.fields`] for the same `Owner` type. This function cannot move
  /// a field out of an owned value.
  pub fn borrowField<Owner, Value>(owner: &Owner, static field: Intrinsic.Field<Owner, Value>) -> &Value {
    return Intrinsic.borrowField<Owner, Value>(owner, field)
  }
  /// Returns a mutable borrow of the field of `owner` that `field` describes.
  ///
  /// # Details
  ///
  /// `field` is a static argument, so the compiler selects the field during specialization. At
  /// runtime this function is a plain field access. The borrow lives as long as the mutable borrow
  /// of `owner`, and `owner` cannot be used while the field borrow is live.
  ///
  /// # Examples
  ///
  /// ```silk
  /// import silk.reflect { Reflect }
  ///
  /// struct Counters {
  ///   pub hits: i32,
  ///   pub misses: i32,
  /// }
  ///
  /// fn reset(counters: &mut Counters) -> () {
  ///   static for field in Reflect.fields<Counters>() {
  ///     let place = Reflect.borrowFieldMut<Counters, i32>(&mut counters.*, field)
  ///     place.* = 0
  ///   }
  ///   return ()
  /// }
  ///
  /// pub fn main() -> i32 {
  ///   let mut counters = Counters { hits: 4, misses: 2 }
  ///   reset(&mut counters)
  ///   return counters.hits + counters.misses
  /// }
  /// ```
  ///
  /// # Gotchas
  ///
  /// `field` must come from [`Reflect.fields`] for the same `Owner` type. `owner` must be a mutable
  /// borrow; a shared borrow is refused.
  pub fn borrowFieldMut<Owner, Value>(owner: &mut Owner, static field: Intrinsic.Field<Owner, Value>) -> &mut Value {
    return Intrinsic.borrowFieldMut<Owner, Value>(owner, field)
  }
}
