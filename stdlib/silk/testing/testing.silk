//! Assertions for tests, and the filter rules that the test runner uses to select tests.
//!
//! # When to use
//! Use [`Testing.expect`] in a `test` function to check a condition. Use [`Testing.matches`] or
//! [`Testing.matchesQualified`] in a custom test runner that must select tests with the same rules
//! as the built-in runner.
//!
//! # Details
//! An assertion failure is an ordinary typed failure, [`AssertionError`]. It needs no service and
//! holds the message of the caller. A failed `expect` stops the test with that failure.
//!
//! The filters compare the file path exactly. They compare the test name as an ASCII substring and
//! ignore ASCII case. They do not fold non-ASCII letters.
//!
//! # Examples
//! ## Check a condition in a test function
//! ```silk
//! import silk.testing.testing { AssertionError, Testing }
//!
//! fn double(value: i32) -> i32 {
//!   return value * 2
//! }
//!
//! test effect fn doubleAddsTheValueToItself() -> ()
//!   ! AssertionError<'static> {
//!   run Testing.expect(double(21) == 42, "double(21) is 42")
//! }
//!
//! pub fn main() -> i32 {
//!   return 0
//! }
//! ```
//!
//! @category Testing

import silk.format { Debug, Format, Formatter }
import silk.text.string { String }
import silk.num.u8
import silk.num.u32
import silk.num.usize
import silk.io.writer { Writer, WriterError }

/// The failure of a [`Testing.expect`] check. It holds the message of the caller.
///
/// # Details
///
/// Read the message with [`Testing.assertionMessage`].
pub struct AssertionError<'message> {
  message: string<'message>,
}

impl<'message> Debug for AssertionError<'message> {
  /// Writes the message, as `AssertionError { message: "..." }`.
  effect fn debug(self: &Self, formatter: &mut Formatter) -> () ! WriterError ? &mut Writer {
    let mut record = run Format.debugRecord("AssertionError", &mut formatter)
    run Format.debugField(&mut record, "message", &self.message, &mut formatter)
    return run Format.debugFinish(record, &mut formatter)
  }
}

/// The owner type of the test helpers. It has no fields and is never constructed.
pub struct Testing {}

impl Testing {
  /// Fails with an [`AssertionError`] that holds `message` if `condition` is `false`.
  ///
  /// # Details
  ///
  /// If `condition` is `true`, this function does nothing. Write `message` as the expected fact,
  /// such as `"list is empty"`, so that a failure report reads as the broken expectation.
  ///
  /// # Errors
  ///
  /// - [`AssertionError`] if `condition` is `false`.
  pub effect fn expect<'message>(
    condition: bool,
    message: string<'message>
  ) -> () ! AssertionError<'message> {
    if condition == false {
      fail AssertionError<'message> { message: message }
    }
    return ()
  }

  /// Returns the message of an [`AssertionError`].
  pub fn assertionMessage<'message>(error: &'message AssertionError<'message>) -> string<'message> {
    return error.message
  }

  /// Returns `true` if a test with file `path` and name `name` passes both filters.
  ///
  /// # Details
  ///
  /// - `fileFilter` must be equal to `path`, byte for byte. An empty `fileFilter` passes each file.
  /// - `nameFilter` must occur in `name`. The comparison ignores ASCII case. An empty `nameFilter`
  ///   passes each name.
  ///
  /// # Gotchas
  ///
  /// The name comparison folds only ASCII letters. Other letters must match exactly.
  pub fn matches(
    path: string,
    name: string,
    fileFilter: string,
    nameFilter: string,
  ) -> bool {
    if String.byteLength(fileFilter) != usize.ZERO && !equal(path, fileFilter) {
      return false
    }
    return containsAsciiFolded(name, nameFilter)
  }

  /// Returns `true` if a test passes both filters, where the name filter applies to the qualified
  /// name `module::name`.
  ///
  /// # When to use
  ///
  /// Use this function in a custom runner that reports tests by qualified name, as the built-in
  /// runner does. Use [`Testing.matches`] to match the plain name only.
  ///
  /// # Details
  ///
  /// `fileFilter` must be equal to `path`, byte for byte. An empty `fileFilter` passes each file.
  /// `nameFilter` can occur anywhere in
  /// `module::name`, also across the `::` separator. The comparison ignores ASCII case.
  pub fn matchesQualified(
    path: string,
    module: string,
    name: string,
    fileFilter: string,
    nameFilter: string,
  ) -> bool {
    if String.byteLength(fileFilter) != usize.ZERO && !equal(path, fileFilter) {
      return false
    }
    return containsQualified(String.utf8Bytes(module), String.utf8Bytes(name), String.utf8Bytes(nameFilter))
  }
}

fn equal(left: string, right: string) -> bool {
  let leftBytes = String.utf8Bytes(left)
  let rightBytes = String.utf8Bytes(right)
  if leftBytes.length != rightBytes.length { return false }
  let mut index = usize.ZERO
  while index < leftBytes.length {
    if leftBytes[index] != rightBytes[index] { return false }
    index = index + usize.ONE
  }
  return true
}

fn asciiFold(value: u8) -> u8 {
  if u8.toU32(value) < 65 || u8.toU32(value) > 90 { return value }
  return u32.toU8(u8.toU32(value) + 32)
}

// The byte at `index` of `module::name`, without building it.
fn qualifiedAt(module: &[u8], name: &[u8], index: usize) -> u8 {
  if index < module.length { return module[index] }
  if index < module.length + 2 { return 58 }
  return name[index - module.length - 2]
}

fn containsQualified(module: &[u8], name: &[u8], search: &[u8]) -> bool {
  if search.length == usize.ZERO { return true }
  let length = module.length + 2 + name.length
  if length < search.length { return false }
  let mut start = usize.ZERO
  while start <= length - search.length {
    let mut offset = usize.ZERO
    let mut matched = true
    while offset < search.length {
      if asciiFold(qualifiedAt(module, name, start + offset)) != asciiFold(search[offset]) {
        matched = false
        offset = search.length
      } else {
        offset = offset + usize.ONE
      }
    }
    if matched { return true }
    start = start + usize.ONE
  }
  return false
}

fn containsAsciiFolded(value: string, pattern: string) -> bool {
  let source = String.utf8Bytes(value)
  let search = String.utf8Bytes(pattern)
  if search.length == usize.ZERO { return true }
  if source.length < search.length { return false }
  let mut start = usize.ZERO
  while start <= source.length - search.length {
    let mut offset = usize.ZERO
    let mut matched = true
    while offset < search.length {
      if asciiFold(source[start + offset]) != asciiFold(search[offset]) {
        matched = false
        offset = search.length
      } else {
        offset = offset + usize.ONE
      }
    }
    if matched { return true }
    start = start + usize.ONE
  }
  return false
}
