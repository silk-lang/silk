//! The built-in test runner that `silk test` selects. It runs tests one at a time.
//!
//! # Details
//! This module is a normal Silk application made from the public static test primitives. It finds
//! the tests in the compilation, applies the filters, runs each selected test in order, and writes
//! a receipt (see `silk.testing.exchange`).
//!
//! The host passes these options. Each takes one value:
//!
//! | Option | Meaning |
//! |---|---|
//! | `--file` | Run only the tests in the file with exactly this path |
//! | `--filter` | Run only the tests whose `module::name` contains this text |
//! | `--silk-test-plan` | Path of the plan file. Required. |
//! | `--silk-test-result` | Path of the receipt file. Required. |
//! | `--silk-test-progress` | Path of the progress file. Optional. |
//! | `--silk-test-timeout` | Each test's time limit in whole seconds. Optional; `0` or absent is none. |
//!
//! The runner checks the complete plan before any test body runs.
//!
//! On a native target, a failed test's report goes to standard output under the test's name: the
//! message of a failed expectation, an unhandled error, or a fatal trap, with the call path that led
//! to it.
//!
//! With `--silk-test-progress`, the runner writes a progress record (see `silk.testing.exchange`)
//! before each test body runs, and removes the file when every test has finished. If the file
//! already holds a record when the runner starts, the test it names stopped an earlier runner
//! process, for example with a trap. The runner then reports that test as failed, skips the tests
//! before it, and continues with the next one, so its summary and receipt count the whole run.
//!
//! With a time limit on a native target with a C library, the runner sets an alarm before each test
//! body runs. A test that outlives it ends the process with `SIGALRM`, which the host reports as a
//! timeout before it continues with the next test.
//!
//! # Errors
//! The exit status is `0` if all selected tests pass, `1` if a test fails, and `2` for a usage
//! error, a plan that is not valid, or an I/O failure.
//!
//! @category Testing

import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.system.filesystem { DirectoryInfo, FileError, FileInfo, FileSystem, Path }
import silk.format { Format }
import silk.system.host_input { HostInput, HostInputError }
import silk.system.monotonic_clock { MonotonicClock }
import silk.system.filesystem_native { OsFileSystem }
import silk.system.monotonic_clock_native { OsMonotonicClock }
import silk.option { Option }
import silk.io.writer_native { StdoutWriter }
import silk.core.result { Result }
import silk.crypto.sha2 { Sha256 }
import silk.text.string { InvalidUtf8, String }
import silk.system.system_clock { Instant, SystemClock }
import silk.testing.exchange as TestExchange
import silk.testing.testing { AssertionError, Testing }
import silk.num.u32
import silk.num.u64
import silk.num.u8
import silk.collections.list { List }
import silk.io.writer { Writer, WriterError }
import silk.num.usize

struct TestOutcome<T> {}

interface CompleteTest<T> {
  fn passed(value: T) -> bool
}

impl CompleteTest<()> for TestOutcome<()> {
  fn passed(value: ()) -> bool { return true }
}

effect<'env> fn testFailed<E: 'env, 'env>(error: E) -> bool {
  drop error
  let status = Intrinsic.observeUnhandled()
  drop status
  return false
}

// Runs a test's Effect and passes when it succeeds. Its failure row adds `AssertionError`, so the
// runner can select it whether or not the test can fail with one.
effect<'env> fn attempted<E: 'env, 'env>(value: Effect<'env; () ! E>) -> bool ! E | AssertionError<'static> {
  run value
  return true
}

effect fn ignoreWriteFailure(error: WriterError) -> () {
  drop error
  return ()
}

effect fn writeAssertion(message: string) -> () ! WriterError ? &mut Writer {
  run Writer.writeString("    assertion failed: ")
  run Writer.writeString(message)
  return run Writer.writeString("\n")
}

// A failed expectation reports its message and call path under the test's name. The runner
// handles the failure, so it is not reported as an unhandled error.
effect fn assertionFailed(error: AssertionError<'static>) -> bool {
  let mut writer = StdoutWriter.make()
  let written = writeAssertion(Testing.assertionMessage(&error))
    |> Effect.provideMut<Writer>(&mut writer)
  run Effect.catchAll(move written, ignoreWriteFailure)
  drop error
  // The observer adds where the failure came from, under the message.
  let status = Intrinsic.observeHandled()
  drop status
  return false
}

impl<'env, E> CompleteTest<Effect<'env; () ! E>> for TestOutcome<Effect<'env; () ! E>> {
  fn passed(value: Effect<'env; () ! E>) -> bool {
    // The intrinsic itself, not `Effect.catch`, which would add one function per test.
    let asserted = Intrinsic.catchFailure<AssertionError<'static>>(attempted(move value), assertionFailed)
    return run Effect.catchAll(move asserted, testFailed)
  }
}

fn selectOutcome<T>(value: &T) -> TestOutcome<T> { return TestOutcome<T> {} }

fn completeTest<T, P: CompleteTest<T>>(value: T, provider: P) -> bool {
  return CompleteTest<T>.passed(move value)
}

static if (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.profileText("libc") == "gnu") {
  unsafe extern "C" fn alarm(seconds: u32) -> u32

  // Schedules `SIGALRM` after `seconds`, replacing an earlier alarm; 0 cancels it.
  fn setAlarm(seconds: u32) -> () {
    let previous = unsafe alarm(seconds)
    drop previous
    return ()
  }
} else {
  // Without a C library the runner has no alarm, so tests have no time limit.
  fn setAlarm(seconds: u32) -> () { return () }
}

// The whole seconds that `text` spells in decimal digits, or `None`.
fn seconds(text: string) -> Option<u32> {
  let bytes = String.utf8Bytes(text)
  if bytes.length == usize.ZERO || bytes.length > 6 { return Option<u32>.none() }
  let mut value: u32 = 0
  let mut at = usize.ZERO
  while at < bytes.length {
    if bytes[at] < 48 || bytes[at] > 57 { return Option<u32>.none() }
    value = value * 10 + u8.toU32(bytes[at] - 48)
    at = at + usize.ONE
  }
  return Option<u32>.some(value)
}

fn elapsedNanoseconds(start: &Instant, end: &Instant) -> i64 {
  let seconds = SystemClock.seconds(end) - SystemClock.seconds(start)
  let nanoseconds = SystemClock.nanoseconds(end) - SystemClock.nanoseconds(start)
  return seconds * 1000000000 + nanoseconds
}

effect fn writeDuration(nanoseconds: i64) -> () ! WriterError ? &mut Writer {
  if nanoseconds < 1000 {
    return run Writer.writeString("<1 us")
  }
  if nanoseconds < 1000000 {
    let microseconds = nanoseconds / 1000
    run Format.display(&microseconds)
    return run Writer.writeString(" us")
  }
  let milliseconds = nanoseconds / 1000000
  run Format.display(&milliseconds)
  return run Writer.writeString(" ms")
}

effect fn writeResult(passed: bool, nanoseconds: i64) -> () ! WriterError ? &mut Writer {
  if passed {
    run Writer.writeString("    PASS  ")
  } else {
    run Writer.writeString("    FAIL  ")
  }
  run writeDuration(nanoseconds)
  return run Writer.writeString("\n")
}

// One discovered test's metadata, read from its descriptor once.
struct CatalogTest {
  identity: string<'static>,
  path: string<'static>,
  module: string<'static>,
  name: string<'static>,
}

// Collects the catalog. A service rather than a `&mut` argument, so the catalog loop holds no loan:
// the loop has one iteration per test, and every loan in one function adds to the cost of its
// borrow check for all the others.
service CatalogSink {
  effect fn add(test: CatalogTest) -> () ! OutOfMemoryError ? &mut CatalogSink | &mut Allocator
}

struct Catalog {
  tests: List<CatalogTest>,
}

impl CatalogSink for Catalog {
  effect fn add(self: &mut Self, test: CatalogTest) -> () ! OutOfMemoryError ? &mut Allocator {
    return run List<CatalogTest>.append(&mut self.tests, move test)
  }
}

effect fn collect() -> () ! OutOfMemoryError ? &mut CatalogSink | &mut Allocator {
  static for descriptor in Intrinsic.tests() {
    run CatalogSink.add(CatalogTest {
      identity: Intrinsic.testInfo(descriptor).identity,
      path: Intrinsic.testInfo(descriptor).path,
      module: Intrinsic.testInfo(descriptor).module,
      name: Intrinsic.testInfo(descriptor).name,
    })
  }
}

// Every discovered test's metadata in catalog order. Each test adds one call to the collecting
// loop, so the runner's generated code grows linearly with the test count; everything else runs
// over this list.
effect fn catalog() -> List<CatalogTest> ! OutOfMemoryError ? &mut Allocator {
  let mut sink = Catalog {tests: List<CatalogTest>.make()}
  run collect() |> Effect.provideMut<CatalogSink>(&mut sink)
  return move sink.tests
}

fn catalogDigest(tests: &[CatalogTest]) -> [u8; 32] {
  let mut state = Sha256.make()
  let mut index = usize.ZERO
  while index < tests.length {
    TestExchange.updateCatalogDigest(&mut state, usize.toU64(index), String.utf8Bytes(tests[index].identity))
    index = index + usize.ONE
  }
  return state.finish()
}

fn validatePlan(bytes: &[u8], tests: &[CatalogTest]) -> i32 {
  let discovered = usize.toU64(tests.length)
  let mut plan = TestExchange.openPlan(bytes)
  if TestExchange.isPerTest(&plan) {
    if !TestExchange.beginPerTest(&mut plan, discovered) { return 11 }
    let mut index = usize.ZERO
    while index < tests.length {
      let entry = TestExchange.readEntry(&mut plan, usize.toU64(index), String.utf8Bytes(tests[index].identity))
      drop entry
      if TestExchange.failed(&plan) { return 12 }
      index = index + usize.ONE
    }
    if TestExchange.finishPerTest(&mut plan) { return 0 }
    return 13
  }
  if TestExchange.isUncached(&plan) {
    let digest = catalogDigest(tests)
    if TestExchange.validateUncached(&mut plan, &digest, discovered) { return 0 }
    return 21
  }
  return 1
}

// Which tests the filters select, in catalog order.
effect fn selection<'file, 'name>(
  tests: &[CatalogTest],
  fileFilter: string<'file>,
  nameFilter: string<'name>,
) -> List<bool> ! OutOfMemoryError ? &mut Allocator {
  let mut selected = List<bool>.make()
  let mut index = usize.ZERO
  while index < tests.length {
    let matched = Testing.matchesQualified(tests[index].path, tests[index].module, tests[index].name, fileFilter, nameFilter)
    run List<bool>.append(&mut selected, matched)
    index = index + usize.ONE
  }
  return move selected
}

fn selectedCount(selected: &[bool]) -> u64 {
  let mut count: u64 = 0
  let mut index = usize.ZERO
  while index < selected.length {
    if selected[index] { count = count + 1 }
    index = index + usize.ONE
  }
  return count
}

// Records that the test at `ordinal` is starting, after the given counts, so that a later runner can
// continue after it if it stops the process.
effect fn recordProgress(path: &Option<Path>, progress: TestExchange.Progress) -> ()
! OutOfMemoryError | FileError
? &mut Allocator | &mut FileSystem {
  if let Option<Path>.Some { value } = &path.* {
    let record = run TestExchange.progressRecord(&progress)
    run FileSystem.writeFile(&value, Bytes.asSlice(&record))
  }
  return ()
}

// The record an earlier runner left in the progress file, or `None` when there is none.
effect fn resumedProgress(path: &Option<Path>) -> Option<TestExchange.Progress> ? &mut FileSystem | &mut Allocator {
  if let Option<Path>.Some { value } = &path.* {
    let read = run Effect.result(FileSystem.readFile(&value))
    if let Result<Bytes, FileError | OutOfMemoryError>.Success { value: bytes } = &read {
      return TestExchange.readProgress(Bytes.asSlice(&bytes))
    }
    drop read
  }
  return Option<TestExchange.Progress>.none()
}

// The state of one run as it walks the catalog.
struct Session<'plan> {
  tests: List<CatalogTest>,
  selected: List<bool>,
  plan: TestExchange.Plan<'plan>,
  // The plan entry of the test at `ordinal`, once `beginTest` has read it.
  entry: TestExchange.Entry<'plan>,
  receipt: TestExchange.Receipt,
  progressPath: Option<Path>,
  clock: OsMonotonicClock,
  testStarted: Instant,
  limit: u32,
  perTest: bool,
  // The test that stopped an earlier runner failed; the tests before it already ran there.
  resumed: bool,
  stopped: u64,
  ordinal: u64,
  cached: u64,
  executed: u64,
  passed: u64,
  failed: u64,
}

// Reports the next catalog test and returns whether its body should run now. A cached, filtered,
// or already finished test is handled here and returns false.
effect fn beginTest(session: &mut Session) -> bool
! OutOfMemoryError | FileError | WriterError
? &mut Allocator | &mut FileSystem | &mut Writer {
  let ordinal = session.ordinal
  let index = u64.toUsize(ordinal)
  let declaration = String.utf8Bytes(List<CatalogTest>.asSlice(&session.tests)[index].identity)
  session.entry = TestExchange.readEntry(&mut session.plan, ordinal, declaration)
  if session.resumed && ordinal <= session.stopped {
    // The earlier runner already wrote this test's name; its trap report followed.
    if ordinal == session.stopped { run Writer.writeString("    FAIL  stopped the test process\n") }
    session.ordinal = ordinal + 1
    return false
  }
  if !List<bool>.asSlice(&session.selected)[index] {
    session.ordinal = ordinal + 1
    return false
  }
  let module = List<CatalogTest>.asSlice(&session.tests)[index].module
  let name = List<CatalogTest>.asSlice(&session.tests)[index].name
  let identity = .{module: module, name: name}
  run Format.format("  {module}::{name}\n", &identity)
  if session.perTest && TestExchange.cached(&session.entry) {
    run Writer.writeString("    CACHED\n")
    run TestExchange.appendResult(
      &mut session.receipt,
      ordinal,
      declaration,
      TestExchange.executionIdentity(&session.entry),
      0,
    )
    session.cached = session.cached + 1
    session.passed = session.passed + 1
    session.ordinal = ordinal + 1
    return false
  }
  run recordProgress(&session.progressPath, TestExchange.Progress {
    ordinal: ordinal, cachedCount: session.cached, executed: session.executed, passed: session.passed,
    failedCount: session.failed,
  })
  session.testStarted = run MonotonicClock.now()
    |> Effect.provideMut<MonotonicClock>(&mut session.clock)
  setAlarm(session.limit)
  return true
}

// Records the outcome of the test body that `beginTest` started.
effect fn endTest(session: &mut Session, ok: bool) -> ()
! OutOfMemoryError | WriterError
? &mut Allocator | &mut Writer {
  setAlarm(0)
  let testFinished = run MonotonicClock.now()
    |> Effect.provideMut<MonotonicClock>(&mut session.clock)
  run writeResult(ok, elapsedNanoseconds(&session.testStarted, &testFinished))
  session.executed = session.executed + 1
  if ok { session.passed = session.passed + 1 } else { session.failed = session.failed + 1 }
  let ordinal = session.ordinal
  if session.perTest {
    let mut disposition: u8 = 2
    if ok { disposition = 1 }
    let declaration = String.utf8Bytes(List<CatalogTest>.asSlice(&session.tests)[u64.toUsize(ordinal)].identity)
    run TestExchange.appendResult(
      &mut session.receipt,
      ordinal,
      declaration,
      TestExchange.executionIdentity(&session.entry),
      disposition,
    )
  }
  session.ordinal = ordinal + 1
  return ()
}

// Runs the session's tests. Like the catalog, the loop reaches the session as a service, so it
// holds no loan per test.
service TestSession {
  effect fn begin() -> bool ! OutOfMemoryError | FileError | WriterError
    ? &mut TestSession | &mut Allocator | &mut FileSystem | &mut Writer
  effect fn end(ok: bool) -> () ! OutOfMemoryError | WriterError ? &mut TestSession | &mut Allocator | &mut Writer
}

impl<'plan> TestSession for Session<'plan> {
  effect fn begin(self: &mut Self) -> bool ! OutOfMemoryError | FileError | WriterError
    ? &mut Allocator | &mut FileSystem | &mut Writer {
    return run beginTest(&mut self)
  }
  effect fn end(self: &mut Self, ok: bool) -> () ! OutOfMemoryError | WriterError ? &mut Allocator | &mut Writer {
    return run endTest(&mut self, ok)
  }
}

effect fn runAll() -> () ! OutOfMemoryError | FileError | WriterError
  ? &mut TestSession | &mut Allocator | &mut FileSystem | &mut Writer {
  static for descriptor in Intrinsic.tests() {
    if run TestSession.begin() { run TestSession.end(invokeTest(descriptor)) }
  }
}

static if (Intrinsic.targetOperatingSystem() == "darwin" && Intrinsic.targetArchitecture() == "aarch64" && Intrinsic.targetAbi() == "apple" && Intrinsic.profileText("libc") == "system") || (Intrinsic.targetOperatingSystem() == "linux" && Intrinsic.targetAbi() == "gnu" && Intrinsic.profileText("libc") == "gnu" && (Intrinsic.targetArchitecture() == "aarch64" || Intrinsic.targetArchitecture() == "x86_64")) {
  import silk.platform.native.diagnostics { NativeDiagnostics }
  import silk.platform.native.report { NativeReport }

  // Runs the tests under an observer that writes to standard output like the runner, so the report
  // of a failed test, with its call path, appears under the test's name.
  effect fn observedTests() -> () ! OutOfMemoryError | FileError | WriterError
    ? &mut TestSession | &mut Allocator | &mut FileSystem | &mut Writer {
    let observer = run NativeDiagnostics.make(NativeReport.indented(1, 4096, 32, "    "), 64)
    let finished = run NativeDiagnostics.observe(move observer, Effect.result(runAll()))
    return match move finished {
      Result<(), OutOfMemoryError | FileError | WriterError>.Success {value} => value
      Result<(), OutOfMemoryError | FileError | WriterError>.Failure {error} => { fail move error }
    }
  }
} else {
  effect fn observedTests() -> () ! OutOfMemoryError | FileError | WriterError
    ? &mut TestSession | &mut Allocator | &mut FileSystem | &mut Writer {
    return run runAll()
  }
}

// Runs one test body. Each test gets its own copy of this function, so the code generated for a
// test does not depend on how many other tests there are.
fn invokeTest<F>(static descriptor: Intrinsic.Test<F>) -> bool {
  let body = Intrinsic.testFunction(descriptor)
  let value = body()
  let provider = selectOutcome(&value)
  return completeTest(move value, move provider)
}

effect fn runSelected<'file, 'name>(
  fileFilter: string<'file>,
  nameFilter: string<'name>,
  planBytes: &[u8],
  resultPath: &Path,
  progressPath: Option<Path>,
  limit: u32,
) -> i32
! OutOfMemoryError | FileError | WriterError
? &mut Allocator | &mut FileSystem | &mut Writer {
  let tests = run catalog()
  let discovered = usize.toU64(tests.length())
  if validatePlan(planBytes, List<CatalogTest>.asSlice(&tests)) != 0 { return 2 }
  let opened = TestExchange.openPlan(planBytes)
  let perTest = TestExchange.isPerTest(&opened)
  drop opened
  let chosen = run selection(List<CatalogTest>.asSlice(&tests), fileFilter, nameFilter)
  let selected = selectedCount(List<bool>.asSlice(&chosen))
  let receipt = run TestExchange.beginReceipt(planBytes, perTest, selected)
  let mut plan = TestExchange.openPlan(planBytes)
  if perTest {
    let began = TestExchange.beginPerTest(&mut plan, discovered)
    drop began
  }
  let mut resumed = false
  let mut stopped: u64 = 0
  let mut cached: u64 = 0
  let mut executed: u64 = 0
  let mut passed: u64 = 0
  let mut failed: u64 = 0
  if let Option<TestExchange.Progress>.Some { value } = run resumedProgress(&progressPath) {
    resumed = true
    stopped = value.ordinal
    cached = value.cachedCount
    executed = value.executed + 1
    passed = value.passed
    failed = value.failedCount + 1
  }
  let mut clock = OsMonotonicClock.make()
  let started = run MonotonicClock.now()
    |> Effect.provideMut<MonotonicClock>(&mut clock)
  let mut session = Session {
    tests: move tests,
    selected: move chosen,
    plan: move plan,
    entry: TestExchange.uncachedEntry(planBytes),
    receipt: move receipt,
    progressPath: move progressPath,
    clock: move clock,
    testStarted: SystemClock.make(SystemClock.seconds(&started), SystemClock.nanoseconds(&started)),
    limit: limit,
    perTest: perTest,
    resumed: resumed,
    stopped: stopped,
    ordinal: 0,
    cached: cached,
    executed: executed,
    passed: passed,
    failed: failed,
  }
  run observedTests() |> Effect.provideMut<TestSession>(&mut session)
  // The file is missing when no test body ran.
  if let Option<Path>.Some { value } = &session.progressPath {
    let removed = run Effect.result(FileSystem.removeFile(&value))
    drop removed
  }
  let summary = .{
    discovered: discovered,
    selected: selected,
    cached: session.cached,
    executed: session.executed,
    passed: session.passed,
    failed: session.failed,
  }
  let finished = run MonotonicClock.now()
    |> Effect.provideMut<MonotonicClock>(&mut session.clock)
  run Writer.writeString("\n")
  run Format.format(
    "Tests  {passed} passed, {failed} failed ({cached} cached, {executed} executed, {selected} selected, {discovered} discovered)\n",
    &summary,
  )
  run Writer.writeString("Time   ")
  run writeDuration(elapsedNanoseconds(&started, &finished))
  run Writer.writeString("\n")
  let mut status: u32 = 1
  if session.failed == 0 { status = 0 }
  let bytes = run TestExchange.finishReceipt(
    move session.receipt,
    discovered,
    selected,
    session.cached,
    session.executed,
    session.passed,
    session.failed,
    status,
  )
  run FileSystem.writeFile(resultPath, Bytes.asSlice(&bytes))
  if status == 0 { return 0 }
  return 1
}

fn argumentText<'arguments>(arguments: &'arguments [Bytes], index: usize) -> Result<string<'arguments>, InvalidUtf8> {
  return HostInput.text(Bytes.asSlice(&arguments[index]))
}

fn argumentOrEmpty<'arguments>(
  arguments: &'arguments [Bytes],
  index: usize,
) -> Result<string<'arguments>, InvalidUtf8> {
  if index == usize.ZERO {
    return Result<string<'arguments>, InvalidUtf8>.succeed("")
  }
  return argumentText(arguments, index)
}

effect fn executeArguments<'arguments>(values: &'arguments [Bytes]) -> i32
! FileError | OutOfMemoryError | WriterError {
  let mut fileIndex = usize.ZERO
  let mut nameIndex = usize.ZERO
  let mut planIndex = usize.ZERO
  let mut resultIndex = usize.ZERO
  let mut progressIndex = usize.ZERO
  let mut timeoutIndex = usize.ZERO
  let mut index = usize.ONE
  while index < values.length {
    let option = match move argumentText(values, index) {
      Result<string, InvalidUtf8>.Success { value } => move value
      Result<string, InvalidUtf8>.Failure { error } => { drop error return 2 }
    }
    if index + usize.ONE >= values.length { return 2 }
    if Intrinsic.stringEqualsExact(option, "--file") {
      fileIndex = index + usize.ONE
    } else {
      if Intrinsic.stringEqualsExact(option, "--filter") {
        nameIndex = index + usize.ONE
      } else {
        if Intrinsic.stringEqualsExact(option, "--silk-test-plan") {
          planIndex = index + usize.ONE
        } else {
          if Intrinsic.stringEqualsExact(option, "--silk-test-result") {
            resultIndex = index + usize.ONE
          } else {
            if Intrinsic.stringEqualsExact(option, "--silk-test-progress") {
              progressIndex = index + usize.ONE
            } else {
              if Intrinsic.stringEqualsExact(option, "--silk-test-timeout") {
                timeoutIndex = index + usize.ONE
              } else {
                return 2
              }
            }
          }
        }
      }
    }
    index = index + 2
  }
  let fileFilter = match move argumentOrEmpty(values, fileIndex) {
    Result<string, InvalidUtf8>.Success { value } => move value
    Result<string, InvalidUtf8>.Failure { error } => { drop error return 2 }
  }
  let nameFilter = match move argumentOrEmpty(values, nameIndex) {
    Result<string, InvalidUtf8>.Success { value } => move value
    Result<string, InvalidUtf8>.Failure { error } => { drop error return 2 }
  }
  if planIndex == usize.ZERO || resultIndex == usize.ZERO { return 2 }
  let planText = match move argumentText(values, planIndex) {
    Result<string, InvalidUtf8>.Success { value } => move value
    Result<string, InvalidUtf8>.Failure { error } => { drop error return 2 }
  }
  let resultText = match move argumentText(values, resultIndex) {
    Result<string, InvalidUtf8>.Success { value } => move value
    Result<string, InvalidUtf8>.Failure { error } => { drop error return 2 }
  }
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut fileSystem = run OsFileSystem.make("/")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let planPath = run Path.make(planText)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let resultPath = run Path.make(resultText)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut limit: u32 = 0
  if timeoutIndex != usize.ZERO {
    let timeoutText = match move argumentText(values, timeoutIndex) {
      Result<string, InvalidUtf8>.Success { value } => move value
      Result<string, InvalidUtf8>.Failure { error } => { drop error return 2 }
    }
    limit = match move seconds(timeoutText) {
      Option<u32>.Some { value } => value
      Option<u32>.None => { return 2 }
    }
  }
  let mut progressPath = Option<Path>.none()
  if progressIndex != usize.ZERO {
    let progressText = match move argumentText(values, progressIndex) {
      Result<string, InvalidUtf8>.Success { value } => move value
      Result<string, InvalidUtf8>.Failure { error } => { drop error return 2 }
    }
    progressPath = Option<Path>.some(run Path.make(progressText)
      |> Effect.provideMut<Allocator>(&mut allocator))
  }
  let metadata = run FileSystem.stat(&planPath)
    |> Effect.provideMut<FileSystem>(&mut fileSystem)
  let planLength = match move metadata {
    FileInfo { byteLength } => byteLength
    DirectoryInfo {} => usize.MAX
  }
  if planLength > 16777216 { return 2 }
  let mut reading = FileSystem.readFile(&planPath)
    |> Effect.provideMut<FileSystem>(&mut fileSystem)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let planBytes = run reading
  let mut writer = StdoutWriter.make()
  return run runSelected(fileFilter, nameFilter, Bytes.asSlice(&planBytes), &resultPath, move progressPath, limit)
    |> Effect.provideMut<Allocator>(&mut allocator)
    |> Effect.provideMut<FileSystem>(&mut fileSystem)
    |> Effect.provideMut<Writer>(&mut writer)
}

effect fn execute() -> i32
! FileError | HostInputError | OutOfMemoryError | WriterError
? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut collected = HostInput.arguments()
    |> Effect.provideMut<Allocator>(&mut allocator)
  let arguments = run collected
  return run executeArguments(List.asSlice(&arguments))
}

effect<'env> fn operationalFailure<E: 'env, 'env>(error: E) -> i32 {
  drop error
  return 2
}

/// Runs each selected test in order and returns the exit status (`0`, `1` or `2`).
pub effect fn main() -> i32 ? &mut HostInput {
  return run Effect.catchAll(execute(), operationalFailure)
}
