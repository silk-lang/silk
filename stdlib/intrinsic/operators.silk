impl Order for char {
  fn compare(left: &Self, right: &Self) -> Ordering {
    if left.* < right.* { return Ordering.Less }
    if right.* < left.* { return Ordering.Greater }
    return Ordering.Equal
  }
}

impl<'text> Equal for string<'text> {
  fn equals(left: &Self, right: &Self) -> bool {
    return left.* == right.*
  }
}

// Byte-wise lexicographic order of the UTF-8 encodings, which is also the order of the Unicode
// scalar values. A text that is a prefix of another comes first.
impl<'text> Order for string<'text> {
  fn compare(left: &Self, right: &Self) -> Ordering {
    let leftBytes = Intrinsic.stringUtf8Bytes(left.*)
    let rightBytes = Intrinsic.stringUtf8Bytes(right.*)
    let mut index: usize = 0
    while index < leftBytes.length && index < rightBytes.length {
      let leftByte = leftBytes[index]
      let rightByte = rightBytes[index]
      if leftByte < rightByte { return Ordering.Less }
      if rightByte < leftByte { return Ordering.Greater }
      index = index + 1
    }
    if leftBytes.length < rightBytes.length { return Ordering.Less }
    if rightBytes.length < leftBytes.length { return Ordering.Greater }
    return Ordering.Equal
  }
}

// Element by element, so two slices are equal when they have the same length and equal elements.
impl<'items, T: Equal> Equal for &'items [T] {
  fn equals(left: &Self, right: &Self) -> bool {
    let leftItems = left.*
    let rightItems = right.*
    if leftItems.length != rightItems.length { return false }
    let mut index: usize = 0
    while index < leftItems.length {
      if !Equal.equals(&leftItems[index], &rightItems[index]) { return false }
      index = index + 1
    }
    return true
  }
}

// Lexicographic: the first unequal element decides, and a slice that is a prefix of another comes
// first.
impl<'items, T: Order> Order for &'items [T] {
  fn compare(left: &Self, right: &Self) -> Ordering {
    let leftItems = left.*
    let rightItems = right.*
    let mut index: usize = 0
    while index < leftItems.length && index < rightItems.length {
      let ordering = Order.compare(&leftItems[index], &rightItems[index])
      if ordering != Ordering.Equal { return ordering }
      index = index + 1
    }
    if leftItems.length < rightItems.length { return Ordering.Less }
    if rightItems.length < leftItems.length { return Ordering.Greater }
    return Ordering.Equal
  }
}

// IEEE 754 totalOrder: negative NaNs, negative infinity, negative numbers, `-0.0`, `+0.0`,
// positive numbers, positive infinity, positive NaNs. Two values compare equal only when their
// bits are the same.
impl Order for f32 {
  fn compare(left: &Self, right: &Self) -> Ordering {
    if !Intrinsic.f32TotalOrder(right.*, left.*) { return Ordering.Less }
    if !Intrinsic.f32TotalOrder(left.*, right.*) { return Ordering.Greater }
    return Ordering.Equal
  }
}

impl Order for f64 {
  fn compare(left: &Self, right: &Self) -> Ordering {
    if !Intrinsic.f64TotalOrder(right.*, left.*) { return Ordering.Less }
    if !Intrinsic.f64TotalOrder(left.*, right.*) { return Ordering.Greater }
    return Ordering.Equal
  }
}
