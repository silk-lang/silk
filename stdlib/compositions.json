{
  "standard": {
    "layout": "silk/mem/layout",
    "option": "silk/core/option",
    "ops": "silk/core/ops",
    "equal": "silk/core/equal",
    "order": "silk/core/order"
  },
  "runtimes": [
    {
      "targets": ["aarch64-apple-darwin"],
      "libc": "system",
      "name": "hosted",
      "module": "silk/platform/native/start"
    },
    {
      "targets": ["aarch64-unknown-linux-gnu", "x86_64-unknown-linux-gnu"],
      "libc": "gnu",
      "name": "hosted",
      "module": "silk/platform/native/start"
    },
    {
      "targets": ["wasm32-unknown-unknown"],
      "libc": "none",
      "name": "standalone",
      "module": "silk/platform/wasm/start"
    },
    {
      "targets": ["wasm32-wasip1", "wasm32-wasip2"],
      "libc": "none",
      "name": "wasi",
      "module": "silk/platform/wasi/start"
    }
  ],
  "components": [
    {
      "capability": "execution-storage",
      "bindings": [
        {
          "operation": "create",
          "module": "silk/concurrency/execution_storage",
          "declaration": "silk_execution_storage_create"
        },
        {
          "operation": "acquire",
          "module": "silk/concurrency/execution_storage",
          "declaration": "silk_execution_storage_acquire"
        },
        {
          "operation": "release",
          "module": "silk/concurrency/execution_storage",
          "declaration": "silk_execution_storage_release"
        },
        {
          "operation": "destroy",
          "module": "silk/concurrency/execution_storage",
          "declaration": "silk_execution_storage_destroy"
        }
      ]
    }
  ]
}
