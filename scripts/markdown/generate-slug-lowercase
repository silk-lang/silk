#!/usr/bin/env python3
"""Generate Unicode 17 lowercase differences from the stdlib's full case-fold mapping."""
import argparse
import hashlib
from pathlib import Path
import urllib.request

ROOT = Path(__file__).resolve().parents[2]
PINS = {'UnicodeData.txt': '2e1efc1dcb59c575eedf5ccae60f95229f706ee6d031835247d843c11d96470c', 'SpecialCasing.txt': 'efc25faf19de21b92c1194c111c932e03d2a5eaf18194e33f1156e96de4c9588', 'CaseFolding.txt': 'ff8d8fefbf123574205085d6714c36149eb946d717a0c585c27f0f4ef58c4183'}


def generate():
    sources = {}
    for name, digest in PINS.items():
        path = ROOT / "build/markdown" / name
        if path.exists():
            data = path.read_bytes()
        else:
            with urllib.request.urlopen("https://www.unicode.org/Public/17.0.0/ucd/" + name, timeout=60) as response:
                data = response.read()
        if hashlib.sha256(data).hexdigest() != digest:
            raise SystemExit(name + " does not match its pinned SHA-256")
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(data)
        sources[name] = data.decode()
    lower, fold = {}, {}
    for line in sources["UnicodeData.txt"].splitlines():
        fields = line.split(";")
        if fields[13]:
            lower[int(fields[0], 16)] = [int(fields[13], 16)]
    for line in sources["SpecialCasing.txt"].splitlines():
        fields = line.split("#")[0].split(";")
        if len(fields) > 4 and not fields[4].strip():
            lower[int(fields[0], 16)] = [int(point, 16) for point in fields[1].split()]
    for line in sources["CaseFolding.txt"].splitlines():
        fields = line.split("#")[0].split(";")
        if len(fields) > 2 and fields[1].strip() in ("C", "F"):
            fold[int(fields[0], 16)] = [int(point, 16) for point in fields[2].split()]
    ranges = []
    for point in sorted(lower.keys() | fold.keys()):
        mapped = lower.get(point, [point])
        if mapped == fold.get(point, [point]):
            continue
        assert len(mapped) == 1
        delta = (mapped[0] - point) % 2**32
        if ranges and point == ranges[-1][1] + 1 and delta == ranges[-1][2]:
            ranges[-1][1] = point
        else:
            ranges.append([point, point, delta])
    values = [value for row in ranges for value in row]
    body = "// Unicode 17.0.0; generated by scripts/markdown/generate-slug-lowercase.\n"
    body += "// Pinned UnicodeData, SpecialCasing, and CaseFolding inputs; see the generator for SHA-256 values.\n"
    body += f"const LOWERCASE_EXCEPTIONS: [u32; {len(values)}] = [\n"
    body += "".join(f"  {value},\n" for value in values) + "]\n"
    return body


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true")
    args = parser.parse_args()
    path = ROOT / "stdlib/silk/markdown/text.silk"
    source = path.read_text()
    start = source.index("// BEGIN GENERATED LOWERCASE EXCEPTIONS\n") + len("// BEGIN GENERATED LOWERCASE EXCEPTIONS\n")
    end = source.index("// END GENERATED LOWERCASE EXCEPTIONS")
    wanted = source[:start] + generate() + source[end:]
    if args.check:
        if wanted != source:
            raise SystemExit("Markdown lowercase exceptions are stale")
    else:
        path.write_text(wanted)


if __name__ == "__main__":
    main()
