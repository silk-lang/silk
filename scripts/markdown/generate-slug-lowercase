#!/usr/bin/env python3
"""Generate Unicode 17 lowercase differences from the stdlib's full case-fold mapping."""
import argparse
import hashlib
from pathlib import Path
import urllib.request

ROOT = Path(__file__).resolve().parents[2]
PINS = {'DerivedCoreProperties.txt': '24c7fed1195c482faaefd5c1e7eb821c5ee1fb6de07ecdbaa64b56a99da22c08', 'UnicodeData.txt': '2e1efc1dcb59c575eedf5ccae60f95229f706ee6d031835247d843c11d96470c', 'SpecialCasing.txt': 'efc25faf19de21b92c1194c111c932e03d2a5eaf18194e33f1156e96de4c9588', 'CaseFolding.txt': 'ff8d8fefbf123574205085d6714c36149eb946d717a0c585c27f0f4ef58c4183'}


def generate():
    sources = {}
    for name, digest in PINS.items():
        path = ROOT / "build/markdown" / name
        if path.exists():
            data = path.read_bytes()
        else:
            with urllib.request.urlopen("https://www.unicode.org/Public/17.0.0/ucd/" + name, timeout=60) as response:
                data = response.read()
        if hashlib.sha256(data).hexdigest() != digest:
            raise SystemExit(name + " does not match its pinned SHA-256")
        path.parent.mkdir(parents=True, exist_ok=True)
        path.write_bytes(data)
        sources[name] = data.decode()
    lower, fold = {}, {}
    for line in sources["UnicodeData.txt"].splitlines():
        fields = line.split(";")
        if fields[13]:
            lower[int(fields[0], 16)] = [int(fields[13], 16)]
    for line in sources["SpecialCasing.txt"].splitlines():
        fields = line.split("#")[0].split(";")
        if len(fields) > 4 and not fields[4].strip():
            lower[int(fields[0], 16)] = [int(point, 16) for point in fields[1].split()]
    for line in sources["CaseFolding.txt"].splitlines():
        fields = line.split("#")[0].split(";")
        if len(fields) > 2 and fields[1].strip() in ("C", "F"):
            fold[int(fields[0], 16)] = [int(point, 16) for point in fields[2].split()]
    ranges = []
    for point in sorted(lower.keys() | fold.keys()):
        mapped = lower.get(point, [point])
        if mapped == fold.get(point, [point]):
            continue
        assert len(mapped) == 1
        delta = (mapped[0] - point) % 2**32
        if ranges and point == ranges[-1][1] + 1 and delta == ranges[-1][2]:
            ranges[-1][1] = point
        else:
            ranges.append([point, point, delta])
    values = [value for row in ranges for value in row]
    body = "// Unicode 17.0.0; generated by scripts/markdown/generate-slug-lowercase.\n"
    body += "// Pinned UnicodeData, SpecialCasing, and CaseFolding inputs; see the generator for SHA-256 values.\n"
    body += f"const LOWERCASE_EXCEPTIONS: [u32; {len(values)}] = [\n"
    body += "".join(f"  {value},\n" for value in values) + "]\n"
    # Store only differences from the stdlib's general-category classification.
    categories = {}
    begin = None
    for line in sources["UnicodeData.txt"].splitlines():
        fields = line.split(";")
        point = int(fields[0], 16)
        if fields[1].endswith(", First>"):
            begin = point
        elif fields[1].endswith(", Last>"):
            for code in range(begin, point + 1):
                categories[code] = fields[2]
            begin = None
        else:
            categories[point] = fields[2]
    properties = {"Cased": set(), "Case_Ignorable": set()}
    for line in sources["DerivedCoreProperties.txt"].splitlines():
        fields = line.split("#")[0].strip().split(";")
        if len(fields) < 2 or fields[1].strip() not in properties:
            continue
        ends = [int(value, 16) for value in fields[0].strip().split("..")]
        properties[fields[1].strip()].update(range(ends[0], ends[-1] + 1))
    for name, categories_used in [("Cased", {"Lu", "Ll", "Lt"}), ("Case_Ignorable", {"Mn", "Me", "Cf", "Lm", "Sk"})]:
        differences = []
        expected = properties[name]
        for point in range(0x110000):
            base = categories.get(point) in categories_used
            wanted = point in expected
            if base == wanted:
                continue
            if differences and point == differences[-1][1] + 1 and wanted == differences[-1][2]:
                differences[-1][1] = point
            else:
                differences.append([point, point, int(wanted)])
        values = [value for row in differences for value in row]
        body += f"\nconst {name.upper()}_EXCEPTIONS: [u32; {len(values)}] = [\n"
        body += "".join(f"  {value},\n" for value in values) + "]\n"
    return body


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true")
    args = parser.parse_args()
    path = ROOT / "stdlib/silk/markdown/text.silk"
    source = path.read_text()
    start = source.index("// BEGIN GENERATED LOWERCASE EXCEPTIONS\n") + len("// BEGIN GENERATED LOWERCASE EXCEPTIONS\n")
    end = source.index("// END GENERATED LOWERCASE EXCEPTIONS")
    wanted = source[:start] + generate() + source[end:]
    if args.check:
        if wanted != source:
            raise SystemExit("Markdown lowercase exceptions are stale")
    else:
        path.write_text(wanted)


if __name__ == "__main__":
    main()
