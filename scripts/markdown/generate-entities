#!/usr/bin/env python3
"""Generate Markdown's allocation-free HTML5 entity lookup from checksum-pinned WHATWG data."""
import argparse
import hashlib
import json
from pathlib import Path
import urllib.request

ROOT = Path(__file__).resolve().parents[2]
URL = "https://html.spec.whatwg.org/entities.json"
SHA256 = "d741d877ac77c4194c4ad526b5b4a19aef8dfe411ab840a466891cdbb9f362e6"
CACHE = ROOT / "build/markdown/entities.json"


def main():
    argparse.ArgumentParser(description=__doc__).parse_args()
    if CACHE.exists():
        data = CACHE.read_bytes()
    else:
        with urllib.request.urlopen(URL, timeout=60) as response:
            data = response.read()
    if hashlib.sha256(data).hexdigest() != SHA256:
        raise SystemExit("entities.json does not match its pinned SHA-256; remove a corrupt cache explicitly")
    CACHE.parent.mkdir(parents=True, exist_ok=True)
    CACHE.write_bytes(data)
    entries = sorted((name[1:], value["characters"]) for name, value in json.loads(data).items())
    assert len(entries) == 2231
    # NUL-delimited UTF-8 records plus little-endian u32 offsets avoid thousands of constants.
    records = bytearray()
    offsets = bytearray()
    for name, value in entries:
        offsets.extend(len(records).to_bytes(4, "little"))
        records.extend(name.encode() + b"\0" + value.encode() + b"\0")
    def literal(data):
        return 'b"' + ''.join(f'\\x{b:02x}' for b in data) + '"'
    source = '''// THIS FILE IS GENERATED by scripts/markdown/generate-entities from SHA256-pinned WHATWG entities.json.
//! HTML5 named character references for Markdown text decoding.
//!
//! # Details
//! The sorted table contains all 2231 WHATWG names. Markdown requires a terminal semicolon.
//! The lookup returns static UTF-8 and does not allocate.
//!
//! @category Data formats

import silk.collections.slice { Slice }
import silk.text.string { String }
import silk.num.u8

/// Returns the replacement for `name`, including its semicolon, or empty text if the name is unknown.
/// The result has static storage. Matching is case-sensitive.
pub fn lookup(name: string) -> string<'static> {
  let key = String.utf8Bytes(name)
  let data = records()
  let index = offsets()
  let mut low: usize = 0
  let mut high: usize = 2231
  while low < high {
    let mid = low + (high - low) / 2
    let at = mid * 4
    let start = u8.toUsize(index[at]) + u8.toUsize(index[at + 1]) * 256
      + u8.toUsize(index[at + 2]) * 65536
      + u8.toUsize(index[at + 3]) * 16777216
    let mut i: usize = 0
    while i < key.length && data[start + i] != 0 && data[start + i] == key[i] {
      i = i + 1
    }
    if i == key.length && data[start + i] == 0 {
      let value = start + i + 1
      let mut end = value
      while data[end] != 0 {
        end = end + 1
      }

      // Generated values are complete UTF-8 strings from the authoritative JSON.
      return unsafe String.fromUtf8Unchecked(Slice.view<u8>(data, value, end - value))
    }
    if i < key.length && data[start + i] != 0 && data[start + i] > key[i] {
      high = mid
    } else if i == key.length {
      high = mid
    } else {
      low = mid + 1
    }
  }
  return ""
}

'''
    source += 'fn records() -> &\'static [u8] {\n  return ' + literal(records) + '\n}\n\n'
    source += 'fn offsets() -> &\'static [u8] {\n  return ' + literal(offsets) + '\n}\n'
    (ROOT / 'stdlib/silk/markdown/entities.silk').write_text(source)


if __name__ == '__main__':
    main()
