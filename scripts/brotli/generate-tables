#!/usr/bin/env python3
"""Generate stdlib/silk/compress/brotli_tables.silk from checksum-pinned google/brotli sources.

The tables are the RFC 7932 static dictionary, its word transforms, and the literal context
lookup table. The sources are fetched once into build/brotli/<revision>.
"""
import argparse
import codecs
import hashlib
from pathlib import Path
import re
import urllib.request

ROOT = Path(__file__).resolve().parents[2]
REVISION = "v1.1.0"
CACHE = ROOT / "build/brotli" / REVISION
BASE = f"https://raw.githubusercontent.com/google/brotli/{REVISION}/"
SOURCES = {
    "LICENSE": "3d180008e36922a4e8daec11c34c7af264fed5962d07924aea928c38e8663c94",
    "c/common/dictionary.c": "03e47c2060c511144045e1cedc0174a8ae076941aaa8060ac3a65bcb33ab392b",
    "c/common/transform.c": "9f91d725dd2e6cbfd886ece385bed079edd2288a610031384f985dba38839486",
    "c/common/transform.h": "3a28f38539e661f22b8f7cd6478b76f1916903caa5b6ae708577c62ef3559122",
    "c/common/context.c": "ecad01b8542ea42f0f58408cd73ceb2aa24feb814ba2f8c2ace6bb173a8179be",
}
OUTPUT = ROOT / "stdlib/silk/compress/brotli_tables.silk"


def fetch(name):
    path = CACHE / name
    if not path.exists():
        path.parent.mkdir(parents=True, exist_ok=True)
        with urllib.request.urlopen(BASE + name) as response:
            path.write_bytes(response.read())
    data = path.read_bytes()
    digest = hashlib.sha256(data).hexdigest()
    expected = SOURCES[name]
    if digest != expected:
        raise SystemExit(f"{name}: sha256 {digest} does not match {expected}")
    return data.decode("latin-1")


def numbers(text, start, stop="};"):
    begin = text.index(start)
    body = text[text.index("{", begin) + 1:text.index(stop, begin)]
    body = re.sub(r"/\*.*?\*/", "", body, flags=re.S)
    return [int(value, 0) for value in re.findall(r"0x[0-9A-Fa-f]+|\d+", body)]


def byte_string(data):
    out = []
    for value in data:
        if 0x20 <= value < 0x7F and value not in (0x22, 0x5C):
            out.append(chr(value))
        else:
            out.append("\\x%02x" % value)
    return 'b"' + "".join(out) + '"'


def array(name, kind, values):
    """Lays out a constant array as `silk format` writes it."""
    head = f"const {name}: [{kind}; {len(values)}] = "
    line = head + "[" + ", ".join(str(value) for value in values) + "]"
    if len(line) <= 100:
        return line + "\n"
    return head + "[\n" + "".join(f"  {value},\n" for value in values) + "]\n"


def generate():
    dictionary = fetch("c/common/dictionary.c")
    transform = fetch("c/common/transform.c")
    header = fetch("c/common/transform.h")
    context = fetch("c/common/context.c")
    fetch("LICENSE")

    words = bytes(numbers(dictionary, "kBrotliDictionaryData[] =", "}\n/* GENERATED CODE END"))
    assert len(words) == 122784, len(words)
    tail = dictionary[dictionary.index("/* size_bits_by_length */"):]
    size_bits = numbers(tail, "size_bits_by_length", "}")[:25]
    offsets = numbers(tail, "offsets_by_length", "}")[:26]
    assert offsets[25] == len(words)

    literal = transform[transform.index("kPrefixSuffix[217] ="):transform.index(";", transform.index("kPrefixSuffix[217] ="))]
    pieces = re.findall(r'"((?:[^"\\]|\\.)*)"', literal)
    affixes = codecs.decode("".join(pieces), "unicode_escape").encode("latin-1") + b"\0"
    assert len(affixes) == 217, len(affixes)
    affix_map = numbers(transform, "kPrefixSuffixMap[50] =")
    assert len(affix_map) == 50

    kinds = dict((name, int(value)) for name, value in re.findall(r"BROTLI_TRANSFORM_([A-Z_0-9]+) = (\d+)", header))
    body = transform[transform.index("kTransformsData[] = {"):]
    body = body[:body.index("};")]
    triples = re.findall(r"(\d+),\s*BROTLI_TRANSFORM_([A-Z_0-9]+),\s*(\d+)", body)
    assert len(triples) == 121, len(triples)
    transforms = []
    for prefix, kind, suffix in triples:
        transforms += [int(prefix), kinds[kind], int(suffix)]

    lookup = bytes(numbers(context, "_kBrotliContextLookupTable[2048] ="))
    assert len(lookup) == 2048

    text = f'''//! The static dictionary, word transforms, and literal context lookup table of Brotli (RFC 7932).
//!
//! # When to use
//! Use `silk.compress.brotli` to decode Brotli. Use this module only to read the raw tables, for
//! example in a custom Brotli encoder.
//!
//! # Details
//! The tables are static byte strings and arrays. The lookups do not allocate.
//!
//! @category Data formats

// THIS FILE IS GENERATED by scripts/brotli/generate-tables from google/brotli {REVISION}
// (c/common/dictionary.c, transform.c, context.c), pinned by checksum. Do not edit it.
// The data is the static dictionary and the tables of RFC 7932, under the google/brotli MIT
// license in licenses/brotli.txt.
import silk.num.u8
import silk.num.u32

{array("WORD_SIZE_BITS", "u32", size_bits)}
{array("WORD_OFFSETS", "u32", offsets)}
{array("AFFIX_OFFSETS", "u32", affix_map)}
{array("TRANSFORMS", "u8", transforms)}
/// The number of word transforms, 121.
pub fn transformCount() -> usize {{
  return 121
}}

/// Returns the 122,784 bytes of the static dictionary: for each word length from 4 to 24, all
/// words of that length, one after another.
pub fn words() -> &'static [u8] {{
  return {byte_string(words)}
}}

/// Returns the base-2 logarithm of the number of dictionary words of `length` bytes, or 0 when
/// there are none (lengths below 4 or above 24).
pub fn wordSizeBits(length: usize) -> u32 {{
  if length > 24 {{
    return 0
  }}
  return WORD_SIZE_BITS[length]
}}

/// Returns where the words of `length` bytes start in [`words`], for lengths from 4 to 24.
pub fn wordOffset(length: usize) -> usize {{
  return u32.toUsize(WORD_OFFSETS[length])
}}

/// Returns the prefixes and suffixes of the word transforms. Each one is a length byte followed by
/// its bytes.
pub fn affixes() -> &'static [u8] {{
  return {byte_string(affixes)}
}}

/// Returns where affix `index` (0 to 49) starts in [`affixes`].
pub fn affixOffset(index: usize) -> usize {{
  return u32.toUsize(AFFIX_OFFSETS[index])
}}

/// Returns the prefix affix index of transform `index` (0 to 120).
pub fn transformPrefix(index: usize) -> usize {{
  return u8.toUsize(TRANSFORMS[index * 3])
}}

/// Returns the kind of transform `index`: 0 for identity, 1 to 9 to drop that many last bytes, 10
/// to uppercase the first character, 11 to uppercase all, and 12 to 20 to drop 1 to 9 first bytes.
pub fn transformKind(index: usize) -> u32 {{
  return u8.toU32(TRANSFORMS[index * 3 + 1])
}}

/// Returns the suffix affix index of transform `index` (0 to 120).
pub fn transformSuffix(index: usize) -> usize {{
  return u8.toUsize(TRANSFORMS[index * 3 + 2])
}}

/// Returns the context lookup table: for context mode `m`, the context of a literal after bytes
/// `p1` (last) and `p2` is `table[m * 512 + p1] | table[m * 512 + 256 + p2]`.
pub fn contextLookup() -> &'static [u8] {{
  return {byte_string(lookup)}
}}
'''
    OUTPUT.write_text(text)
    print(f"wrote {OUTPUT.relative_to(ROOT)}")


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.parse_args()
    generate()


if __name__ == "__main__":
    main()
