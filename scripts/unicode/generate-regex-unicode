#!/usr/bin/env python3
"""Regenerate native ECMAScript Unicode tables from checksum-pinned Unicode 17.0.0 UCD.

Generation uses Python's standard library only. The emitted Silk has no foreign runtime
or network dependency. Unicode source data is distributed under Unicode License v3.
Run from any directory: scripts/unicode/generate-regex-unicode
"""
from collections import defaultdict
import hashlib
from pathlib import Path
import urllib.request

ROOT = Path(__file__).resolve().parents[2]
VERSION = "17.0.0"
CACHE = ROOT / "build" / "unicode" / VERSION
OUTPUT = ROOT / "stdlib" / "silk" / "text" / "regex_unicode.silk"
BASE = f"https://www.unicode.org/Public/{VERSION}/ucd/"
SOURCES = {'CaseFolding.txt': 'ff8d8fefbf123574205085d6714c36149eb946d717a0c585c27f0f4ef58c4183', 'DerivedCoreProperties.txt': '24c7fed1195c482faaefd5c1e7eb821c5ee1fb6de07ecdbaa64b56a99da22c08', 'DerivedNormalizationProps.txt': '71fd6a206a2c0cdd41feb6b7f656aa31091db45e9cedc926985d718397f9e488', 'PropList.txt': '130dcddcaadaf071008bdfce1e7743e04fdfbc910886f017d9f9ac931d8c64dd', 'PropertyAliases.txt': '4441f573caf952ffece1d7c892e7715bd7136dfc26f96eb6f268bf1e474715fb', 'PropertyValueAliases.txt': '64e9a5f76f7a1e8b5a47d6a1f9a26522a251208f5276bdfa1559dac7cf2e827a', 'ScriptExtensions.txt': 'ec2107e58825a1586acee8e0911ce18260394ac8b87e535ca325f1ccbeb06bc6', 'Scripts.txt': '9f5e50d3abaee7d6ce09480f325c706f485ae3240912527e651954d2d6b035bf', 'UnicodeData.txt': '2e1efc1dcb59c575eedf5ccae60f95229f706ee6d031835247d843c11d96470c', 'emoji/emoji-data.txt': '2cb2bb9455cda83e8481541ecf5b6dfda66a3bb89efa3fa7c5297eccf607b72b', 'extracted/DerivedBinaryProperties.txt': '13dd09d35a9377e33eb388a01e6581d4bfec6b2685316078c341982fa444071a'}
# ECMA-262 Table 66; accepting other UCD binary properties is a syntax error.
ALLOWED = ['ASCII', 'ASCII_Hex_Digit', 'Alphabetic', 'Any', 'Assigned', 'Bidi_Control', 'Bidi_Mirrored', 'Case_Ignorable', 'Cased', 'Changes_When_Casefolded', 'Changes_When_Casemapped', 'Changes_When_Lowercased', 'Changes_When_NFKC_Casefolded', 'Changes_When_Titlecased', 'Changes_When_Uppercased', 'Dash', 'Default_Ignorable_Code_Point', 'Deprecated', 'Diacritic', 'Emoji', 'Emoji_Component', 'Emoji_Modifier', 'Emoji_Modifier_Base', 'Emoji_Presentation', 'Extended_Pictographic', 'Extender', 'Grapheme_Base', 'Grapheme_Extend', 'Hex_Digit', 'IDS_Binary_Operator', 'IDS_Trinary_Operator', 'ID_Continue', 'ID_Start', 'Ideographic', 'Join_Control', 'Logical_Order_Exception', 'Lowercase', 'Math', 'Noncharacter_Code_Point', 'Pattern_Syntax', 'Pattern_White_Space', 'Quotation_Mark', 'Radical', 'Regional_Indicator', 'Sentence_Terminal', 'Soft_Dotted', 'Terminal_Punctuation', 'Unified_Ideograph', 'Uppercase', 'Variation_Selector', 'White_Space', 'XID_Continue', 'XID_Start']
HELPERS = "//! Unicode 17.0.0 property and simple-fold tables used by the ECMAScript regex parser.\n//!\n//! # Details\n//! Property aliases are exact and case-sensitive. Only ECMA-262 Table 65/66 properties are\n//! accepted. Data comes from https://www.unicode.org/Public/17.0.0/ucd/ under Unicode License v3.\n//! @category Text\n\nimport silk.text.string { String }\nimport silk.num.u8\nimport silk.num.u32\n\n// Source SHA-256 digests (UTF-8 UCD files):\n// CaseFolding.txt ff8d8fefbf123574205085d6714c36149eb946d717a0c585c27f0f4ef58c4183\n// DerivedCoreProperties.txt 24c7fed1195c482faaefd5c1e7eb821c5ee1fb6de07ecdbaa64b56a99da22c08\n// DerivedNormalizationProps.txt 71fd6a206a2c0cdd41feb6b7f656aa31091db45e9cedc926985d718397f9e488\n// PropList.txt 130dcddcaadaf071008bdfce1e7743e04fdfbc910886f017d9f9ac931d8c64dd\n// PropertyAliases.txt 4441f573caf952ffece1d7c892e7715bd7136dfc26f96eb6f268bf1e474715fb\n// PropertyValueAliases.txt 64e9a5f76f7a1e8b5a47d6a1f9a26522a251208f5276bdfa1559dac7cf2e827a\n// ScriptExtensions.txt ec2107e58825a1586acee8e0911ce18260394ac8b87e535ca325f1ccbeb06bc6\n// Scripts.txt 9f5e50d3abaee7d6ce09480f325c706f485ae3240912527e651954d2d6b035bf\n// UnicodeData.txt 2e1efc1dcb59c575eedf5ccae60f95229f706ee6d031835247d843c11d96470c\n// emoji/emoji-data.txt 2cb2bb9455cda83e8481541ecf5b6dfda66a3bb89efa3fa7c5297eccf607b72b\n// extracted/DerivedBinaryProperties.txt 13dd09d35a9377e33eb388a01e6581d4bfec6b2685316078c341982fa444071a\n\nfn word(bytes: &[u8], at: usize) -> u32 {\n  return u8.toU32(bytes[at]) * 16777216 + u8.toU32(bytes[at + 1]) * 65536\n    + u8.toU32(bytes[at + 2]) * 256 + u8.toU32(bytes[at + 3])\n}\n\n/// Resolves an exact Unicode alias; kind 0 is lone/binary, 1 category, 2 script, 3 extensions.\n/// Zero means that the alias is not permitted in ECMAScript Unicode mode.\npub fn lookup(kind: usize, name: string) -> usize {\n  let table = match kind {\n    1 => categoryNames()\n    2 => scriptNames()\n    3 => extensionNames()\n    _ => loneNames()\n  }\n  let bytes = String.utf8Bytes(name)\n  let mut at: usize = 0\n  while at < table.length {\n    let start = at\n    while table[at] != 0 { at = at + 1 }\n    let mut equal = at - start == bytes.length\n    let mut i: usize = 0\n    while equal && i < bytes.length {\n      if table[start + i] != bytes[i] { equal = false }\n      i = i + 1\n    }\n    if equal { return u32.toUsize(word(table, at + 1)) }\n    at = at + 5\n  }\n  return 0\n}\n\n/// Tests one Unicode code point against a property ID returned by `lookup`.\npub fn contains(id: usize, cp: u32) -> bool {\n  if id == 0 || id + 1 >= offsets().length / 4 { return false }\n  let mut low = u32.toUsize(word(offsets(), id * 4))\n  let mut high = u32.toUsize(word(offsets(), (id + 1) * 4))\n  let bytes = propertyRanges()\n  while low < high {\n    let mid = low + (high - low) / 2\n    if cp < word(bytes, mid * 8) { high = mid }\n    else if cp > word(bytes, mid * 8 + 4) { low = mid + 1 }\n    else { return true }\n  }\n  return false\n}\n\n/// Returns member `index` of the scalar's simple-fold equivalence class, or U+110000 at its end.\npub fn equivalent(cp: u32, index: usize) -> u32 {\n  if index >= 4 { return 0x110000 }\n  let bytes = folds()\n  let mut low: usize = 0\n  let mut high = bytes.length / 20\n  while low < high {\n    let mid = low + (high - low) / 2\n    let key = word(bytes, mid * 20)\n    if cp < key { high = mid }\n    else if cp > key { low = mid + 1 }\n    else { return word(bytes, mid * 20 + 4 + index * 4) }\n  }\n  if index == 0 { return cp }\n  return 0x110000\n}\n\n/// Tests the Unicode ID_Start property, including ECMAScript's `$` and `_` additions.\npub fn identifierStart(cp: u32) -> bool {\n  return cp == 36 || cp == 95 || contains(@ID_START@, cp)\n}\n\n/// Tests Unicode ID_Continue, including ECMAScript's `$`, `_`, ZWNJ and ZWJ additions.\npub fn identifierContinue(cp: u32) -> bool {\n  return cp == 36 || cp == 95 || cp == 0x200c || cp == 0x200d || contains(@ID_CONTINUE@, cp)\n}\n"


def fetch():
    sources = {}
    for name, digest in SOURCES.items():
        path = CACHE / name
        if path.exists():
            raw = path.read_bytes()
        else:
            with urllib.request.urlopen(BASE + name, timeout=120) as response:
                raw = response.read()
        actual = hashlib.sha256(raw).hexdigest()
        if actual != digest:
            raise SystemExit(f"SHA-256 mismatch for {name}: expected {digest}, got {actual}")
        if not path.exists():
            path.parent.mkdir(parents=True, exist_ok=True)
            temporary = path.with_suffix(path.suffix + ".download")
            temporary.write_bytes(raw)
            temporary.replace(path)
        sources[name] = raw.decode("utf-8")
    return sources


def records(text):
    for line in text.splitlines():
        row = [field.strip() for field in line.split("#")[0].split(";")]
        if len(row) > 1 and row[0]:
            yield row


def points(span):
    bounds = span.split("..")
    return range(int(bounds[0], 16), int(bounds[-1], 16) + 1)


def ranges(values):
    result = []
    for cp in sorted(values):
        if result and result[-1][1] + 1 == cp:
            result[-1][1] = cp
        else:
            result.append([cp, cp])
    return result


def be(value):
    return value.to_bytes(4, "big")


def literal(name, blob):
    return "fn " + name + "() -> &'static [u8] {\n  return b\"" + "".join(f"\\x{b:02x}" for b in blob) + "\"\n}\n"


def generate(ucd):
    props = defaultdict(set)
    for name in ["DerivedCoreProperties.txt", "PropList.txt", "DerivedNormalizationProps.txt",
                 "emoji/emoji-data.txt", "extracted/DerivedBinaryProperties.txt"]:
        for row in records(ucd[name]):
            props[row[1]].update(points(row[0]))
    category = ["Cn"] * 0x110000
    first = 0
    for row in records(ucd["UnicodeData.txt"]):
        cp = int(row[0], 16)
        if row[1].endswith(", First>"):
            first = cp
        elif row[1].endswith(", Last>"):
            category[first:cp + 1] = [row[2]] * (cp - first + 1)
        else:
            category[cp] = row[2]
    for cp, cat in enumerate(category):
        props["gc=" + cat].add(cp)
        props["gc=" + cat[0]].add(cp)
        if cat in ["Lu", "Ll", "Lt"]:
            props["gc=LC"].add(cp)
    props["ASCII"] = set(range(128))
    props["Any"] = set(range(0x110000))
    props["Assigned"] = set(range(0x110000)) - props["gc=Cn"]
    script_alias = {}
    category_alias = {}
    binary_alias = {}
    for row in records(ucd["PropertyValueAliases.txt"]):
        if row[0] == "sc":
            for alias in row[1:]:
                script_alias[alias] = row[1]
        if row[0] == "gc":
            for alias in row[1:]:
                category_alias[alias] = row[1]
    for row in records(ucd["PropertyAliases.txt"]):
        for alias in row:
            binary_alias[alias] = row[1]
    for key in list(props):
        if key in binary_alias and key != binary_alias[key]:
            props[binary_alias[key]].update(props[key])
    for key in ALLOWED:
        if not props[key]:
            raise SystemExit(f"missing Unicode property data: {key}")
    script = ["Zzzz"] * 0x110000
    for row in records(ucd["Scripts.txt"]):
        span = points(row[0])
        script[span.start:span.stop] = [script_alias[row[1]]] * len(span)
    for cp, value in enumerate(script):
        props["sc=" + value].add(cp)
        props["scx=" + value].add(cp)
    for row in records(ucd["ScriptExtensions.txt"]):
        for cp in points(row[0]):
            props["scx=" + script[cp]].discard(cp)
            for value in row[1].split():
                props["scx=" + value].add(cp)
    keys = sorted(set(ALLOWED) | {"gc=" + v for v in category_alias.values()}
                  | {"sc=" + v for v in script_alias.values()}
                  | {"scx=" + v for v in script_alias.values()})
    ids = {key: index + 1 for index, key in enumerate(keys)}
    data = bytearray()
    offsets = [0, 0]
    for key in keys:
        for low, high in ranges(props[key]):
            data += be(low) + be(high)
        offsets.append(len(data) // 8)
    aliases = [{}, {}, {}, {}]
    for name in ALLOWED:
        aliases[0][name] = ids[name]
    for alias, name in binary_alias.items():
        # UCD defines WSpace; ECMA-262 Table 66 permits only White_Space and space.
        if name in ALLOWED and alias != "WSpace":
            aliases[0][alias] = ids[name]
    for alias, name in category_alias.items():
        aliases[0][alias] = ids["gc=" + name]
        aliases[1][alias] = ids["gc=" + name]
    for alias, name in script_alias.items():
        aliases[2][alias] = ids["sc=" + name]
        aliases[3][alias] = ids["scx=" + name]
    fold = {int(r[0], 16): int(r[2], 16) for r in records(ucd["CaseFolding.txt"])
            if r[1] in ["C", "S"]}
    groups = defaultdict(set)
    for a, b in fold.items():
        groups[b].update([a, b])
    folded = bytearray()
    for cp in sorted(set().union(*groups.values())):
        group = sorted(groups[fold.get(cp, cp)])
        if len(group) > 4:
            raise SystemExit("case-fold equivalence group exceeds the native four-member layout")
        folded += be(cp) + b"".join(be(x) for x in group + [0x110000] * (4 - len(group)))
    result = HELPERS.replace("@ID_START@", str(ids["ID_Start"]))
    result = result.replace("@ID_CONTINUE@", str(ids["ID_Continue"]))
    result += literal("offsets", b"".join(be(n) for n in offsets))
    result += literal("propertyRanges", data)
    for name, mapping in zip(["loneNames", "categoryNames", "scriptNames", "extensionNames"], aliases):
        blob = b"".join(key.encode("ascii") + b"\0" + be(value)
                        for key, value in sorted(mapping.items()))
        result += literal(name, blob)
    result += literal("folds", folded)
    return result


if __name__ == "__main__":
    OUTPUT.write_text(generate(fetch()), encoding="utf-8")
    print(OUTPUT.relative_to(ROOT))
