#!/usr/bin/env python3
"""Generate allocation-free Unicode 18 properties from SHA256-pinned UCD files."""
from array import array
from pathlib import Path
import re
import runpy
import struct
import textwrap

ROOT = Path(__file__).resolve().parents[2]
LIMIT = 0x110000
CACHE = ROOT / "build/unicode/18.0.0"
HEADER = "// THIS FILE IS GENERATED by scripts/unicode/generate-unicode from the Unicode 18.0.0 files pinned in\n// scripts/unicode/unicode-18.0.0.sha256. Do not edit it. Unicode data: Unicode License v3.\n"


def rows(name):
    for line in (CACHE / name).read_text().splitlines():
        body = line.split("#", 1)[0].strip()
        if body:
            yield [field.strip() for field in body.split(";")]


def bounds(text):
    fields = text.split("..")
    return int(fields[0], 16), int(fields[-1], 16) + 1


def fill(values, span, value):
    start, end = bounds(span)
    values[start:end] = array("I", [value]) * (end - start)


def aliases():
    result = {}
    for fields in rows("PropertyValueAliases.txt"):
        result.setdefault(fields[0], []).append(fields[1:])
    return result


def property_values(name, default, convert, selector=None):
    values = array("I", [convert(default)]) * LIMIT
    if selector is None:
        for line in (CACHE / name).read_text().splitlines():
            if "@missing:" in line:
                fields = [f.strip() for f in line.split("@missing:", 1)[1].split("#", 1)[0].split(";")]
                fill(values, fields[0], convert(fields[-1]))
    for fields in rows(name):
        if selector is None:
            fill(values, fields[0], convert(fields[1]))
        elif fields[1] == selector:
            fill(values, fields[0], convert(fields[2] if len(fields) > 2 else "Y"))
    return values


def load():
    names = aliases()
    props, enums = {}, {}
    gc_names = "Cc Cf Cn Co Cs Ll Lm Lo Lt Lu Mc Me Mn Nd Nl No Pc Pd Pe Pf Pi Po Ps Sc Sk Sm So Zl Zp Zs".split()
    enums["generalCategory"] = ("GeneralCategory", gc_names, list(range(len(gc_names))), "Cn")
    props["generalCategory"] = array("I", [gc_names.index("Cn")]) * LIMIT
    ccc = [(int(fields[0]), fields[-1]) for fields in names["ccc"]]
    enums["combiningClass"] = ("CanonicalCombiningClass", [name for _, name in ccc], [v for v, _ in ccc], "Not_Reordered")
    props["combiningClass"] = array("I", [0]) * LIMIT
    decompositions, vertical, wide = {}, {}, {}
    first = None
    for fields in rows("UnicodeData.txt"):
        cp = int(fields[0], 16)
        if fields[1].endswith(", First>"):
            first = cp
            continue
        start = first if fields[1].endswith(", Last>") else cp
        first = None
        props["generalCategory"][start:cp + 1] = array("I", [gc_names.index(fields[2])]) * (cp + 1 - start)
        props["combiningClass"][start:cp + 1] = array("I", [int(fields[3])]) * (cp + 1 - start)
        decomposition = fields[5].split()
        if decomposition and not decomposition[0].startswith("<"):
            parts = tuple(int(v, 16) for v in decomposition)
            assert 1 <= len(parts) <= 2
            decompositions[cp] = parts + (0,) * (2 - len(parts))
        if decomposition and decomposition[0] == "<vertical>" and len(decomposition) == 2:
            vertical.setdefault(int(decomposition[1], 16), cp)
        if decomposition and decomposition[0] == "<wide>" and len(decomposition) == 2:
            wide[int(decomposition[1], 16)] = cp
    # Preserve the presentation-form mapping: ASCII punctuation uses its fullwidth
    # counterpart; the duplicate low-line forms distinguish straight and wavy lines.
    vertical = {wide.get(cp, cp): target for cp, target in vertical.items()}
    vertical[0xfe4f] = 0xfe34
    script_aliases = {alias: fields[0] for fields in names["sc"] for alias in fields}
    tag = lambda name: int.from_bytes(script_aliases[name].encode("ascii"), "big")
    props["script"] = property_values("Scripts.txt", "Unknown", tag)
    specs = [
        ("bidiClass", "BidiClass", "bc", "extracted/DerivedBidiClass.txt", "L", False),
        ("joiningType", "JoiningType", "jt", "extracted/DerivedJoiningType.txt", "U", False),
        ("joiningGroup", "JoiningGroup", "jg", "extracted/DerivedJoiningGroup.txt", "No_Joining_Group", True),
        ("lineBreak", "LineBreak", "lb", "LineBreak.txt", "XX", False),
        ("eastAsianWidth", "EastAsianWidth", "ea", "EastAsianWidth.txt", "N", False),
        ("graphemeBreak", "GraphemeBreak", "GCB", "auxiliary/GraphemeBreakProperty.txt", "Other", True),
        ("wordBreak", "WordBreak", "WB", "auxiliary/WordBreakProperty.txt", "Other", True),
        ("sentenceBreak", "SentenceBreak", "SB", "auxiliary/SentenceBreakProperty.txt", "Other", True),
        ("verticalOrientation", "VerticalOrientation", "vo", "VerticalOrientation.txt", "R", False),
    ]
    for fn, typ, alias, source, default, long_names in specs:
        variants = [fields[1] if long_names else fields[0] for fields in names[alias]]
        mapping = {value: i for i, fields in enumerate(names[alias]) for value in fields}
        props[fn] = property_values(source, default, mapping.__getitem__)
        enums[fn] = (typ, variants, list(range(len(variants))), variants[mapping[default]])
    variants = ["None", "Consonant", "Extend", "Linker"]
    props["indicConjunctBreak"] = property_values("DerivedCoreProperties.txt", "None", variants.index, "InCB")
    enums["indicConjunctBreak"] = ("IndicConjunctBreak", variants, list(range(4)), "None")
    props["bidiPairedBracketType"] = array("I", [0]) * LIMIT
    props["bracketDelta"] = array("I", [0]) * LIMIT
    enums["bidiPairedBracketType"] = ("BidiPairedBracketType", ["None", "Open", "Close"], [0, 1, 2], "None")
    for cp, paired, kind in rows("BidiBrackets.txt"):
        u = int(cp, 16)
        props["bracketDelta"][u] = (int(paired, 16) - u) & 0xffffffff
        props["bidiPairedBracketType"][u] = {"o": 1, "c": 2}[kind]
    props["mirrorDelta"] = array("I", [0]) * LIMIT
    for cp, paired in rows("BidiMirroring.txt"):
        u = int(cp, 16)
        props["mirrorDelta"][u] = (int(paired, 16) - u) & 0xffffffff
    props["verticalDelta"] = array("I", [0]) * LIMIT
    for cp, target in vertical.items():
        props["verticalDelta"][cp] = (target - cp) & 0xffffffff
    booleans = [
        ("isEmoji", "emoji/emoji-data.txt", "Emoji"),
        ("isEmojiPresentation", "emoji/emoji-data.txt", "Emoji_Presentation"),
        ("isEmojiModifier", "emoji/emoji-data.txt", "Emoji_Modifier"),
        ("isEmojiModifierBase", "emoji/emoji-data.txt", "Emoji_Modifier_Base"),
        ("isEmojiComponent", "emoji/emoji-data.txt", "Emoji_Component"),
        ("isExtendedPictographic", "emoji/emoji-data.txt", "Extended_Pictographic"),
        ("isRegionalIndicator", "PropList.txt", "Regional_Indicator"),
        ("isVariationSelector", "PropList.txt", "Variation_Selector"),
        ("isDefaultIgnorable", "DerivedCoreProperties.txt", "Default_Ignorable_Code_Point"),
    ]
    for fn, source, prop in booleans:
        props[fn] = property_values(source, "N", lambda value: int(value == "Y"), prop)
    # Include singleton script sets in the same packed pool as explicit extensions.
    sets = [(value,) for value in sorted(set(props["script"]))]
    set_ids = {value: i for i, value in enumerate(sets)}
    props["scriptExtensions"] = array("I", (set_ids[(value,)] for value in props["script"]))
    for span, scripts in rows("ScriptExtensions.txt"):
        value = tuple(sorted(tag(name) for name in scripts.split()))
        if value not in set_ids:
            set_ids[value] = len(sets)
            sets.append(value)
        fill(props["scriptExtensions"], span, set_ids[value])
    excluded = property_values("DerivedNormalizationProps.txt", "N", lambda value: int(value == "Y"), "Full_Composition_Exclusion")
    compositions = sorted((a, b, cp) for cp, (a, b) in decompositions.items() if b and not excluded[cp])
    pairs = [(0, 0)] + sorted(set(decompositions.values()))
    pair_ids = {pair: i for i, pair in enumerate(pairs)}
    props["decomposition"] = array("I", [0]) * LIMIT
    for cp, pair in decompositions.items():
        props["decomposition"][cp] = pair_ids[pair]
    props["composesAsSecond"] = array("I", [0]) * LIMIT
    for _, second, _ in compositions:
        props["composesAsSecond"][second] = 1
    derive_algorithm_tables(props, enums)
    defaults = {fn: values[-1] for fn, values in props.items()}
    defaults["scriptExtensions"] = set_ids[(tag("Unknown"),)]
    return props, enums, defaults, sets, pairs, compositions


# Packed per-algorithm records, so each scalar needs one lookup in the hot loops.
# Keep the bit layouts in sync with stdlib/silk/text/line_break.silk and segmentation.silk.
LINE_EAST, LINE_CURRENCY_WIDE, LINE_PI, LINE_PF, LINE_WORD, LINE_EMOJI, LINE_SA, LINE_CJ, LINE_ZWJ = (1 << bit for bit in range(6, 15))


def derive_algorithm_tables(props, enums):
    index = lambda fn: {name: i for i, name in enumerate(enums[fn][1])}
    lb, gc, ea, gcb = index("lineBreak"), index("generalCategory"), index("eastAsianWidth"), index("graphemeBreak")
    assert len(lb) <= 64 and len(gcb) <= 32
    letters = {gc[name] for name in ("Lu", "Ll", "Lt", "Lm", "Lo")}
    marks = {gc["Mn"], gc["Mc"]}
    east = {ea[name] for name in ("F", "W", "H")}
    currency_wide = {ea[name] for name in ("A", "F", "W")}
    alphabetic = {lb[name] for name in ("AI", "SG", "XX")}
    line = array("I", [0]) * LIMIT
    grapheme = array("I", [0]) * LIMIT
    pictographic = props["isExtendedPictographic"]
    for cp in range(LIMIT):
        raw, category, width = props["lineBreak"][cp], props["generalCategory"][cp], props["eastAsianWidth"][cp]
        cls, flags = raw, 0
        if raw in alphabetic:
            cls = lb["AL"]
        elif raw == lb["SA"]:
            cls = lb["CM"] if category in marks else lb["AL"]
            if cls != lb["CM"]:
                flags |= LINE_SA
        elif raw == lb["CJ"]:
            cls, flags = lb["NS"], LINE_CJ
        flags |= LINE_EAST if width in east else 0
        flags |= LINE_CURRENCY_WIDE if width in currency_wide else 0
        flags |= LINE_PI if category == gc["Pi"] else 0
        flags |= LINE_PF if category == gc["Pf"] else 0
        # Word characters for keep-all; loose line breaking turns CJ into ID.
        word = category in letters or raw == lb["CJ"] or cls in (lb["AL"], lb["HL"], lb["NU"], lb["ID"])
        flags |= LINE_WORD if word else 0
        flags |= LINE_ZWJ if cls == lb["ZWJ"] else 0
        flags |= LINE_EMOJI if category == gc["Cn"] and pictographic[cp] else 0
        line[cp] = cls | flags
        grapheme[cp] = props["graphemeBreak"][cp] | props["indicConjunctBreak"][cp] << 5 | pictographic[cp] << 7
    props["lineBreakInfo"] = line
    props["graphemeInfo"] = grapheme


# Context-free line-break pair decisions under the untailored profile, indexed
# [left * classes + right]. RULES pairs fall back to stdlib/silk/text/line_break.silk,
# whose rules this walk mirrors in order; keep the two in sync.
LINE_RULES, LINE_KEEP, LINE_BREAK = 0, 1, 2


def line_pairs(enums):
    names = enums["lineBreak"][1]
    def decide(a, b):
        hard = lambda c: c in ("BK", "CR", "LF", "NL")
        alpha = lambda c: c in ("AL", "HL")
        hangul = lambda c: c in ("JL", "JV", "JT", "H2", "H3")
        aksara = ("AK", "AS", "AL")  # AL: U+25CC counts as an aksara.
        # Resolved before tokens reach the segmenter.
        if a in ("AI", "SA", "SG", "XX", "CJ", "CM", "ZWJ") or b in ("AI", "SA", "SG", "XX", "CJ", "CM", "ZWJ"):
            return LINE_RULES
        if (alpha(a) or a == "NU") and (alpha(b) or b == "NU"):
            return LINE_KEEP
        if a == "CR" and b == "LF":
            return LINE_KEEP
        if hard(a):
            return LINE_BREAK
        if hard(b) or b in ("SP", "ZW"):
            return LINE_KEEP
        # Past a space the rules depend on the last non-space class.
        if a == "SP":
            return LINE_RULES
        if a == "ZW":
            return LINE_BREAK
        if a in ("WJ", "GL") or b == "WJ":
            return LINE_KEEP
        if b == "GL" and a not in ("HY", "HH"):
            return LINE_KEEP
        if b in ("CL", "CP", "SY", "EX"):
            return LINE_KEEP
        if a == "OP":
            return LINE_KEEP
        # Quotation rules read Pi/Pf, East Asian width and neighbours.
        if a == "QU" or b == "QU":
            return LINE_RULES
        if b == "IS":
            return LINE_KEEP
        if a in ("CL", "CP") and b == "NS":
            return LINE_KEEP
        if a == "B2" and b == "B2":
            return LINE_KEEP
        if a == "CB" or b == "CB":
            return LINE_BREAK
        # LB20a and LB21a look at the class before the hyphen.
        if a in ("HY", "HH") and alpha(b):
            return LINE_RULES
        if b in ("BA", "HH", "HY", "NS"):
            return LINE_KEEP
        if a == "BB":
            return LINE_KEEP
        if a in ("HY", "HH"):
            return LINE_RULES
        if a == "SY" and b == "HL":
            return LINE_KEEP
        if b == "IN":
            return LINE_KEEP
        if a == "PR" and b in ("ID", "EB", "EM"):
            return LINE_KEEP
        if a in ("ID", "EB", "EM") and b == "PO":
            return LINE_KEEP
        if (a in ("PR", "PO") and alpha(b)) or (alpha(a) and b in ("PR", "PO")):
            return LINE_KEEP
        # LB25's numeric suffix: NU decides alone, SY/IS/CL/CP need history.
        if b in ("PO", "PR"):
            if a == "NU":
                return LINE_KEEP
            if a in ("SY", "IS", "CL", "CP"):
                return LINE_RULES
        if a in ("PR", "PO"):
            if b == "NU":
                return LINE_KEEP
            if b == "OP":
                return LINE_RULES
        if b == "NU":
            if a in ("HY", "IS", "NU"):
                return LINE_KEEP
            if a == "SY":
                return LINE_RULES
        if (a == "JL" and b in ("JL", "JV", "H2", "H3")) or (a in ("JV", "H2") and b in ("JV", "JT")) \
                or (a in ("JT", "H3") and b == "JT") or (hangul(a) and b == "PO") or (a == "PR" and hangul(b)):
            return LINE_KEEP
        # LB28a reads the code point (U+25CC) and the tokens around the pair.
        if a == "AP" and b in ("AK", "AS"):
            return LINE_KEEP
        if a in ("AK", "AS") and b in ("VF", "VI"):
            return LINE_KEEP
        if (a == "AP" and b == "AL") or (a == "AL" and b in ("VF", "VI")) or (a == "VI" and b in ("AK", "AL")) \
                or (a in aksara and b in aksara):
            return LINE_RULES
        if a == "IS" and alpha(b):
            return LINE_KEEP
        # LB30 reads East Asian width, LB30a the regional indicator count.
        if ((alpha(a) or a == "NU") and b == "OP") or (a == "CP" and (alpha(b) or b == "NU")) or (a == b == "RI"):
            return LINE_RULES
        if a == "EB" and b == "EM":
            return LINE_KEEP
        # Unassigned pictographs carry an emoji flag.
        if b == "EM":
            return LINE_RULES
        return LINE_BREAK
    return bytes(decide(a, b) for a in names for b in names)


def width(values):
    largest = max(values, default=0)
    return 1 if largest < 256 else 2 if largest < 65536 else 4


def packed(values):
    size = width(values)
    return b"".join(value.to_bytes(size, "big") for value in values), size


def unique_blocks(values, size, default):
    ids, blocks, indexes = {}, [], []
    for start in range(0, len(values), size):
        block = tuple(values[start:start + size])
        block += (default,) * (size - len(block))
        if block not in ids:
            ids[block] = len(blocks) // size
            blocks.extend(block)
        indexes.append(ids[block])
    return indexes, blocks


def table(values, default):
    end = len(values)
    while end and values[end - 1] == default:
        end -= 1
    values = values[:end]
    candidates = []
    for shift in range(2, 10):
        indexes, leaves = unique_blocks(values, 1 << shift, default)
        candidates.append((len(indexes) * width(indexes) + len(leaves) * width(leaves), shift, 0, [indexes, leaves]))
        for middle_shift in range(2, 9):
            top, middle = unique_blocks(indexes, 1 << middle_shift, 0)
            stages = [top, middle, leaves]
            candidates.append((sum(len(s) * width(s) for s in stages), shift, middle_shift, stages))
    cost, shift, middle_shift, stages = min(candidates, key=lambda item: item[:3])
    return end, cost, shift, middle_shift, stages


ASCII_TABLES = {"lineBreakInfo", "wordBreak", "sentenceBreak"}
# Hot per-scalar tables also get a two-stage BMP table: one load fewer than the trie.
BMP_TABLES = {"graphemeInfo", "sentenceBreak", "wordBreak"}


def bmp_table(values, default):
    bmp = [values[cp] if cp < len(values) else default for cp in range(0x10000)]
    candidates = []
    for shift in range(4, 9):
        indexes, leaves = unique_blocks(bmp, 1 << shift, default)
        candidates.append((len(indexes) * width(indexes) + len(leaves) * width(leaves), shift, [indexes, leaves]))
    return min(candidates, key=lambda item: item[:2])


def byte_function(name, data, doc=None):
    literal = "".join(f"\\x{byte:02x}" for byte in data)
    if doc is None:
        return f'fn {name}() -> &\'static [u8] {{\n  return b"{literal}"\n}}\n\n'
    return f'{doc}pub fn {name}() -> &\'static [u8] {{\n  return b"{literal}"\n}}\n\n'


