def variant_doc(fn, variant, names):
    rows = names.get(ALIAS_KEYS[fn], [])
    for fields in rows:
        if variant in fields:
            readable = next((field for field in fields if "_" in field or (len(field) > 3 and not field.isupper())), variant).replace("_", " ")
            labels = [field for field in fields if field and field != variant and not field.isdigit() and field.replace("_", " ") != readable]
            spelled = ", ".join(f"`{label}`" for label in dict.fromkeys(labels))
            return f"{readable}" + (f" (also {spelled})" if spelled else "") + "."
    return variant.replace("_", " ") + "."


def wrap_docs(text):
    lines = []
    for line in text.split("\n"):
        stripped = line.lstrip(" ")
        if len(line) > 100 and stripped.startswith("/// "):
            indent = line[:len(line) - len(stripped)] + "/// "
            lines.extend(textwrap.wrap(stripped[4:], 100, initial_indent=indent, subsequent_indent=indent, break_on_hyphens=False, break_long_words=False))
        else:
            lines.append(line)
    return "\n".join(lines)


def longest_decomposition(props, pairs):
    table = props["decomposition"]
    memo = {}
    def length(cp):
        if cp in memo:
            return memo[cp]
        index = table[cp] if cp < len(table) else 0
        if index == 0:
            result = 1
        else:
            first, second = pairs[index]
            result = length(first) + (length(second) if second else 0)
        memo[cp] = result
        return result
    # Hangul syllables decompose by formula into at most three jamo.
    return max([3] + [length(cp) for cp in range(LIMIT) if table[cp]])


def generate():
    runpy.run_path(str(ROOT / "scripts/unicode/fetch-unicode"))["fetch"]()
    names = aliases()
    props, enums, defaults, sets, pairs, compositions = load()
    data = [HEADER, DATA_HEADER, "import silk.num.u8\nimport silk.num.u32\n\n"]
    api = [HEADER, PROPERTIES_HEADER, "import silk.text.unicode_data\n\n"]
    data.append('/// Returns the version of the Unicode Character Database that the tables come from, `"18.0.0"`.\n'
                'pub fn dataVersion() -> string<\'static> {\n  return "18.0.0"\n}\n\n')
    data.append('/// Returns the largest number of scalars in the full canonical decomposition of one scalar.\n'
                f'pub fn longestDecomposition() -> usize {{\n  return {longest_decomposition(props, pairs)}\n}}\n\n')
    def read_expr(stage, size, index):
        if size == 1:
            return f"u8.toUsize({stage}()[{index}])"
        return f"u32.toUsize(be{size * 8}({stage}(), ({index}) * {size}))"
    for fn, values in props.items():
        default = defaults[fn]
        full = values
        # The trie only answers supplementary scalars for tables with a BMP stage.
        trie = [default] * 0x10000 + list(values[0x10000:]) if fn in BMP_TABLES else values
        end, cost, shift, middle_shift, stages = table(trie, default)
        widths = []
        for i, values in enumerate(stages):
            payload, size = packed(values)
            widths.append(size)
            data.append(byte_function(fn + str(i), payload))
        read_ascii = None
        if fn in ASCII_TABLES:
            # Text-algorithm loops mostly see ASCII; one direct load skips the trie.
            payload, size = packed([full[cp] if cp < len(full) else default for cp in range(128)])
            data.append(byte_function(fn + "Ascii", payload))
            read_ascii = f"u8.toU32({fn}Ascii()[u32.toUsize(cp)])" if size == 1 else f"be{size * 8}({fn}Ascii(), u32.toUsize(cp) * {size})"
        if fn in BMP_TABLES:
            bmp_cost, bmp_shift, bmp_stages = bmp_table(full, default)
            bmp_widths = []
            for i, values in enumerate(bmp_stages):
                payload, size = packed(values)
                bmp_widths.append(size)
                data.append(byte_function(fn + "Bmp" + str(i), payload))
            data.append(f"// BMP: {bmp_cost} bytes; leaf block {1 << bmp_shift}.\n")
        data.append(f"// {cost} bytes; leaf block {1 << shift}" + (f", middle block {1 << middle_shift}" if middle_shift else "") + ".\n")
        data.append(f"/// Returns {RAW_DOCS[fn]}.\n///\n/// # Details\n/// A value past U+10FFFF gets the Unicode default, {default}.\n")
        data.append(f"@inlineAlways\npub fn {fn}(cp: u32) -> u32 {{\n")
        if read_ascii:
            data.append(f"  if cp < 128 {{\n    return {read_ascii}\n  }}\n")
        if fn in BMP_TABLES:
            block = read_expr(fn + "Bmp0", bmp_widths[0], f"u32.toUsize(cp) / {1 << bmp_shift}")
            index = f"block * {1 << bmp_shift} + (u32.toUsize(cp) & {(1 << bmp_shift) - 1})"
            leaf = f"u8.toU32({fn}Bmp1()[{index}])" if bmp_widths[1] == 1 else f"be{bmp_widths[1] * 8}({fn}Bmp1(), ({index}) * {bmp_widths[1]})"
            data.append(f"  if cp < 0x10000 {{\n    let block = {block}\n    return {leaf}\n  }}\n")
        data.append(f"  if cp >= {end} {{\n    return {default}\n  }}\n  let u = u32.toUsize(cp)\n")
        if middle_shift:
            first = read_expr(fn + "0", widths[0], f"u / {1 << (shift + middle_shift)}")
            data.append(f"  let first = {first}\n")
            second = read_expr(fn + "1", widths[1], f"first * {1 << middle_shift} + ((u / {1 << shift}) & {(1 << middle_shift) - 1})")
            data.append(f"  let block = {second}\n")
        else:
            data.append(f"  let block = {read_expr(fn + '0', widths[0], f'u / {1 << shift}')}\n")
        leaf_name = fn + str(len(stages) - 1)
        index = f"block * {1 << shift} + (u & {(1 << shift) - 1})"
        result = f"u8.toU32({leaf_name}()[{index}])" if widths[-1] == 1 else f"be{widths[-1] * 8}({leaf_name}(), ({index}) * {widths[-1]})"
        data.append(f"  return {result}\n}}\n\n")
        if fn in enums:
            typ, variants, numbers, fallback = enums[fn]
            prop, summary = ENUM_DOCS[fn]
            api.append(f"/// The Unicode `{prop}` property: {summary}.\n///\n/// # Details\n"
                       f"/// [`{typ}.of`] reads the value of one code point. A code point with no explicit value, or a value past U+10FFFF, gets the Unicode default, `{fallback}`.\n")
            api.append(f"pub enum {typ} {{\n" + "".join(f"  /// {variant_doc(fn, v, names)}\n  {v},\n" for v in variants) + "}\n\n")
            api.append(f"impl {typ} {{\n")
            api.append(f"  /// Returns the `{prop}` of the code point `cp`. A value past U+10FFFF gets `{fallback}`.\n"
                       f"  @inlineAlways\n  pub fn of(cp: u32) -> {typ} {{\n    return {typ}.fromTableValue(unicode_data.{fn}(cp))\n  }}\n\n")
            api.append(f"  /// Returns the value for the packed number `value` from `unicode_data.{fn}`. An unknown number gives `{fallback}`.\n  @inlineAlways\n  pub fn fromTableValue(value: u32) -> {typ} {{\n    return match value {{\n")
            api.extend(f"      {value} => {typ}.{variant}\n" for variant, value in zip(variants, numbers) if variant != fallback)
            api.append(f"      _ => {typ}.{fallback}\n    }}\n  }}\n")
            if fn == "lineBreak":
                api.append(f"\n  /// Returns the row and column of the class in `unicode_data.linePairs`.\n  @inlineAlways\n"
                           f"  pub fn tableIndex(self: Self) -> usize {{\n    return match self {{\n")
                api.extend(f"      {typ}.{variant} => {i}\n" for i, variant in enumerate(variants))
                api.append("    }\n  }\n")
            if fn == "combiningClass":
                api.append(f"\n  /// Returns the numeric combining class, from 0 to 254. Canonical ordering sorts marks by it.\n"
                           f"  @inlineAlways\n  pub fn number(self: Self) -> u8 {{\n    return match self {{\n")
                api.extend(f"      {typ}.{variant} => {value}\n" for variant, value in zip(variants, numbers))
                api.append("    }\n  }\n")
            api.append("}\n\n")
    for size in (2, 4):
        parts = [f"u32.shiftLeft(u8.toU32(data[index + {i}]), {(size - i - 1) * 8})" if i + 1 < size else f"u8.toU32(data[index + {i}])" for i in range(size)]
        # Laid out as `silk format` writes it.
        expression = " | ".join(parts) if size == 2 else " | ".join(parts[:2]) + "".join(f"\n    | {part}" for part in parts[2:])
        data.append(f"/// Returns the big-endian unsigned {size * 8}-bit number at byte `index` of `data`.\n"
                    f"@inlineAlways\npub fn be{size * 8}(data: &[u8], index: usize) -> u32 {{\n  return {expression}\n}}\n\n")
    data.append(byte_function("linePairs", line_pairs(enums),
        "/// Returns the untailored line breaking decision for each pair of `LineBreak` classes, indexed by\n"
        "/// `left.tableIndex() * classes + right.tableIndex()`: 0 when the rules must decide, 1 for no\n/// break, 2 for a break.\n"))
    data.append(byte_function("decompositions", b"".join(struct.pack(">II", *pair) for pair in pairs),
        "/// Returns the one-step canonical decompositions as pairs of big-endian 32-bit scalars. Entry 0 is\n"
        "/// empty, and a second scalar of 0 marks a singleton decomposition.\n"))
    data.append(byte_function("compositions", b"".join(struct.pack(">III", *row) for row in compositions),
        "/// Returns the primary composites as rows of three big-endian 32-bit scalars, sorted by first and\n"
        "/// second scalar: first, second and composite. Hangul syllables are not in the table.\n"))
    offsets, members = [], []
    for scripts in sets:
        offsets.append(len(members))
        members.extend(scripts)
    offsets.append(len(members))
    data.append(byte_function("scriptSetOffsets", b"".join(struct.pack(">I", value) for value in offsets),
        "/// Returns the start of each Script_Extensions set in `scriptSetMembers` as big-endian 32-bit\n"
        "/// numbers. Set `index` covers members `offsets[index]` up to `offsets[index + 1]`.\n"))
    data.append(byte_function("scriptSetMembers", b"".join(struct.pack(">I", value) for value in members),
        "/// Returns the scripts of all Script_Extensions sets as big-endian 32-bit ISO 15924 tags.\n"))
    out = ROOT / "stdlib/silk/text"
    data, api = wrap_docs("".join(data)), wrap_docs("".join(api))
    (out / "unicode_data.silk").write_text(data.rstrip("\n") + "\n")
    (out / "unicode_properties.silk").write_text(api.rstrip("\n") + "\n")


DATA_HEADER = """//! Packed Unicode Character Database tables, with data from Unicode 18.0.0.
//!
//! # When to use
//! Use `silk.text.unicode_properties`, `silk.text.unicode_script` and `silk.text.unicode` in
//! application code. Use this module only to read the raw packed values, for example in a custom
//! text algorithm with its own hot loop.
//!
//! # Details
//! Each lookup takes a code point as a `u32` and returns a `u32`. A value past U+10FFFF gets the
//! Unicode default and never traps. The lookups do not allocate. The tables are static byte strings,
//! in two- or three-stage layouts that `scripts/unicode/generate-unicode` chooses for each property.
//!
//! # Gotchas
//! A later generation can change the packed numbers and the layout. Typed values, such as
//! `GeneralCategory.of`, stay stable.
//!
//! @category Text
"""

PROPERTIES_HEADER = """//! Typed Unicode character properties, with data from Unicode 18.0.0.
//!
//! # When to use
//! Use these types to classify characters: for example `GeneralCategory.of(cp)` for the general
//! category or `LineBreak.of(cp)` for the line breaking class. Use `silk.text.unicode_script` for
//! scripts and `silk.text.unicode` for normalization and the Boolean properties.
//!
//! # Details
//! Each property type has an `of` function that takes a code point as a `u32`. A code point with no
//! explicit value, or a value past U+10FFFF, gets the Unicode default and never traps. The lookups
//! do not allocate. The variant names are the Unicode property value aliases.
//!
//! # Examples
//! ## Classify a character
//! ```silk
//! import silk.text.unicode_properties { GeneralCategory, CanonicalCombiningClass }
//!
//! pub fn main() -> i32 {
//!   if GeneralCategory.of(0x41) != GeneralCategory.Lu {
//!     return 1
//!   }
//!   // U+0301 COMBINING ACUTE ACCENT sits above the base character.
//!   if CanonicalCombiningClass.of(0x301).number() != 230 {
//!     return 1
//!   }
//!   return 0
//! }
//! ```
//!
//! @category Text
"""


if __name__ == "__main__":
    generate()
