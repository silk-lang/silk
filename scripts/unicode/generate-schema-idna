#!/usr/bin/env python3
"""Generate pinned JSON Schema IDNA tables; no Python or network dependency at runtime."""
import argparse
import ast
import hashlib
from pathlib import Path
import struct
import urllib.request

ROOT = Path(__file__).resolve().parents[2]
CACHE = ROOT / "build/unicode/idna-16.0.0"
OUTPUT = ROOT / "stdlib/silk/json/schema_format_idna_data.silk"
SOURCES = {
    "IdnaMappingTable.txt": (
        "https://www.unicode.org/Public/idna/16.0.0/IdnaMappingTable.txt",
        "6db2ef4ed35f3b3de74ebc2e00404a9607f76d499f576b8d4043cf14f1ed175c",
    ),
    "idnadata.py": (
        "https://raw.githubusercontent.com/kjd/idna/v3.11/idna/idnadata.py",
        "486f2385a184e778a20fa078f69b76a704effd4bc295c89613e379e28476a785",
    ),
}


def fetch(name, offline):
    url, expected = SOURCES[name]
    target = CACHE / name
    if target.exists():
        data = target.read_bytes()
    else:
        if offline:
            raise SystemExit(f"missing pinned IDNA input: {target}")
        data = urllib.request.urlopen(url, timeout=60).read()
    if hashlib.sha256(data).hexdigest() != expected:
        raise SystemExit(f"IDNA checksum mismatch: {name}")
    if not target.exists():
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(data)
    return data


def mapping_tables(data):
    rows, pool = bytearray(), bytearray()
    statuses = {"valid": 0, "deviation": 0, "ignored": 1, "mapped": 2, "disallowed": 3}
    previous = -1
    for line in data.decode("utf-8").splitlines():
        line = line.split("#", 1)[0].strip()
        if not line:
            continue
        fields = [field.strip() for field in line.split(";")]
        bounds = fields[0].split("..")
        start, end = int(bounds[0], 16), int(bounds[-1], 16)
        if start != previous + 1 or end < start:
            raise ValueError("IDNA mapping ranges are not a complete ordered partition")
        previous = end
        status = statuses[fields[1]]
        replacement = b""
        if status == 2:
            replacement = "".join(chr(int(cp, 16)) for cp in fields[2].split()).encode("utf-8")
        # Little-endian start:u32, pool offset:u32, status:u8, byte length:u16.
        rows.extend(struct.pack("<IIBH", start, len(pool), status, len(replacement)))
        pool.extend(replacement)
    if previous != 0x10FFFF:
        raise ValueError("IDNA mapping table does not cover every Unicode code point")
    return bytes(rows), bytes(pool)


def valid_ranges(data):
    # Parse literals only: downloaded Python source is never executed.
    tree = ast.parse(data)
    assignments = [node for node in tree.body if isinstance(node, ast.Assign)]
    values = {}
    for node in assignments:
        for target in node.targets:
            if isinstance(target, ast.Name) and target.id in {"__version__", "codepoint_classes"}:
                values[target.id] = ast.literal_eval(node.value)
    if values["__version__"] != "16.0.0":
        raise ValueError("IDNA property and mapping Unicode versions differ")
    packed = bytearray()
    previous = 0
    for value in values["codepoint_classes"]["PVALID"]:
        start, end = value >> 32, value & 0xFFFFFFFF
        if start < previous or start >= end or end > 0x110000:
            raise ValueError("invalid IDNA PVALID range")
        previous = end
        packed.extend(struct.pack("<II", start, end))
    return bytes(packed)


def byte_function(name, data):
    # Static byte literals avoid allocations and large array-expression ASTs.
    escaped = "".join(f"\\x{byte:02x}" for byte in data)
    return f"fn {name}() -> &'static [u8] {{ return b\"{escaped}\" }}\n"


