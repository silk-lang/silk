e }\n'
LOOKUPS = "fn word(b: &[u8], i: usize) -> u32 {\n  return u8.toU32(b[i]) + u8.toU32(b[i + 1]) * 256 + u8.toU32(b[i + 2]) * 65536 + u8.toU32(b[i + 3]) * 16777216\n}\n/// Returns the table row for a Unicode scalar, for use by `status` and `replacement`.\npub fn row(cp: u32) -> usize {\n  let b = mappings()\n  let mut lo: usize = 0\n  let mut hi = b.length / 11\n  while lo + 1 < hi {\n    let mid = lo + (hi - lo) / 2\n    if word(b, mid * 11) <= cp { lo = mid } else { hi = mid }\n  }\n  return lo * 11\n}\n/// Returns 0 for unchanged, 1 for ignored, 2 for mapped, and 3 for disallowed scalars.\npub fn status(row: usize) -> u8 { return mappings()[row + 8] }\n/// Returns the UTF-8 replacement of a mapped row; the returned view is static.\npub fn replacement(row: usize) -> string<'static> {\n  let b = mappings()\n  let start = u32.toUsize(word(b, row + 4))\n  let length = u8.toUsize(b[row + 9]) + u8.toUsize(b[row + 10]) * 256\n  return unsafe String.fromUtf8Unchecked(Slice.view<u8>(mappedText(), start, length))\n}\n/// Returns the IDNA2008 PVALID property, excluding characters requiring contextual checks.\npub fn pvalid(cp: u32) -> bool {\n  let b = ranges()\n  let mut lo: usize = 0\n  let mut hi = b.length / 8\n  while lo < hi {\n    let mid = lo + (hi - lo) / 2\n    if cp < word(b, mid * 8) { hi = mid }\n    else if cp >= word(b, mid * 8 + 4) { lo = mid + 1 }\n    else { return true }\n  }\n  return false\n}"


def main():
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--offline", action="store_true", help="use only hash-checked cached inputs")
    parser.add_argument("--check", action="store_true", help="fail if generated source is stale")
    args = parser.parse_args()
    rows, pool = mapping_tables(fetch("IdnaMappingTable.txt", args.offline))
    ranges = valid_ranges(fetch("idnadata.py", args.offline))
    text = HEADER.rstrip("\n") + "\n\n"
    text += byte_function("mappings", rows) + byte_function("mappedText", pool)
    text += byte_function("ranges", ranges) + LOOKUPS.rstrip("\n") + "\n"
    generated = text.encode("utf-8")
    if args.check:
        if not OUTPUT.exists() or OUTPUT.read_bytes() != generated:
            raise SystemExit(f"stale generated IDNA output: {OUTPUT.relative_to(ROOT)}")
    else:
        OUTPUT.parent.mkdir(parents=True, exist_ok=True)
        OUTPUT.write_bytes(generated)


if __name__ == "__main__":
    main()
