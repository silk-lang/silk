#!/usr/bin/env python3
"""Populate build/unicode/18.0.0 from checksum-pinned Unicode release files."""
import argparse
import hashlib
from pathlib import Path
import urllib.request

ROOT = Path(__file__).resolve().parents[2]
VERSION = "18.0.0"
CACHE = ROOT / "build/unicode" / VERSION
BASE = f"https://www.unicode.org/Public/{VERSION}/ucd/"


def fetch():
    for line in (ROOT / "scripts/unicode/unicode-18.0.0.sha256").read_text().splitlines():
        digest, name = line.split()
        path = CACHE / name
        if path.exists():
            data = path.read_bytes()
        else:
            with urllib.request.urlopen(BASE + name, timeout=120) as response:
                data = response.read()
        actual = hashlib.sha256(data).hexdigest()
        if actual != digest:
            raise SystemExit(f"SHA256 mismatch for {name}: expected {digest}, got {actual}; remove a corrupt cache file explicitly before retrying")
        if not path.exists():
            path.parent.mkdir(parents=True, exist_ok=True)
            temporary = path.with_suffix(path.suffix + ".download")
            temporary.write_bytes(data)
            temporary.replace(path)
    return CACHE


if __name__ == "__main__":
    argparse.ArgumentParser(description=__doc__).parse_args()
    print(fetch())
