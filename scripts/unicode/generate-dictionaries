#!/usr/bin/env python3
"""Pack pinned ICU Southeast Asian dictionaries; no ICU build/runtime required."""
import argparse
import hashlib
from pathlib import Path
import re
import struct
import urllib.request

ROOT = Path(__file__).resolve().parents[2]
REVISION = "049e0d6a420629ac7db77256987d083a563287b5"  # ICU release-78.1
CACHE = ROOT / "build/icu" / REVISION
BASE = f"https://raw.githubusercontent.com/unicode-org/icu/{REVISION}/"
DICTIONARIES = {
    "thai": ("thaidict", "3166abde40c0f44ab91c28f5ce96d7d1472cb7882e1c0bda0a72f8f69dba4274"),
    "lao": ("laodict", "3c876934a3fa81031d2333525eafaca6a7c9f842e3b98f18c38880420afb5d36"),
    "khmer": ("khmerdict", "87bee2d17cd5148aa36957eb05409eefc124de8ad519b81b789298ef3e60b5d9"),
    "myanmar": ("burmesedict", "61d8abc3d9102b2f9bf0c9f44db0d7ab89b18172d8cd26832e4c83174bd8673b"),
}
SOURCES = {
    "LICENSE": "e55522d81edc687a341a4411e0776e54ca654e90147f354a90458aaced4116af",
    "icu4c/source/common/dictbe.cpp": "7ff35464a40669eb77ef4931f0fe6a041392f12603f07908af309dda3e22a022",
    "icu4c/source/common/dictionarydata.cpp": "cb84f0fff65be65425a6be6b4871cd464862c705d7e7244f91d770b0bd7b1820",
    "icu4c/source/test/testdata/rbbitst.txt": "da3a58dda1494e09bc49a8740762b1dd6c8e0ee83f92a988514802141d23ed84",
    "icu4c/source/data/brkitr/rules/line.txt": "58e2e33076da2ad5503f4c5b2f19160a92c9a9a8b092621e1e37a4d1ae57fba2",
}
SOURCES.update({f"icu4c/source/data/brkitr/dictionaries/{name}.txt": sha
                for name, sha in DICTIONARIES.values()})


def fetch(path, offline):
    target = CACHE / path
    if not target.exists():
        if offline:
            raise SystemExit(f"missing pinned ICU input: {target}")
        data = urllib.request.urlopen(BASE + path, timeout=60).read()
        if hashlib.sha256(data).hexdigest() != SOURCES[path]:
            raise SystemExit(f"ICU checksum mismatch: {path}")
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(data)
    data = target.read_bytes()
    if hashlib.sha256(data).hexdigest() != SOURCES[path]:
        raise SystemExit(f"ICU checksum mismatch: {target}")
    return data


def packed_dictionary(data):
    # A minimal acyclic scalar trie preserves every terminal and prefix. Its node
    # order is deterministic postorder; equivalent suffixes share one node.
    trie = {}
    word_count = 0
    for line in data.decode("utf-8-sig").splitlines():
        word = line.split("#", 1)[0].strip()
        if not word:
            continue
        if any(c.isspace() for c in word):
            raise ValueError(f"unexpected weighted/whitespace dictionary entry: {word!r}")
        node = trie
        for c in word:
            if ord(c) > 0xffff:
                raise ValueError("dictionary encoding requires BMP scalars")
            node = node.setdefault(ord(c), {})
        node[None] = True
        word_count += 1
    registry, nodes = {}, []
    max_candidates = 0

    def intern(node, terminals=0):
        nonlocal max_candidates
        terminal = None in node
        terminals += terminal
        max_candidates = max(max_candidates, terminals)
        edges = tuple((cp, intern(node[cp], terminals)) for cp in sorted(k for k in node if k is not None))
        key = (terminal, edges)
        if key not in registry:
            registry[key] = len(nodes)
            nodes.append(key)
        return registry[key]

    root = intern(trie)
    # PossibleWord's fixed 20-slot stack must cover every nested candidate path.
    if max_candidates > 20:
        raise ValueError(f"ICU PossibleWord capacity exceeded: {max_candidates}")
    node_bytes, edge_bytes = bytearray(), bytearray()
    for terminal, edges in nodes:
        node_bytes.extend(struct.pack(">IHB", len(edge_bytes) // 6, len(edges), terminal))
        for cp, child in edges:
            edge_bytes.extend(struct.pack(">HI", cp, child))
    return root, bytes(node_bytes), bytes(edge_bytes), word_count, max_candidates


def byte_function(name, data, doc):
    # Byte literals stay out of the compiler's array-expression tree.
    return (doc + f"pub fn {name}() -> &'static [u8] {{\n  return b\"" +
            "".join(f"\\x{b:02x}" for b in data) + "\"\n}\n")


def publish(path, data, check):
    target = ROOT / path
    if check:
        if not target.exists() or target.read_bytes() != data:
            raise SystemExit(f"stale generated dictionary output: {path}")
    else:
        target.parent.mkdir(parents=True, exist_ok=True)
        target.write_bytes(data)


def reference_fixtures(source):
    # Whole no-space reference cases, not outputs computed by the port.
    # Line numbers refer to the checksum-pinned rbbitst.txt. The Myanmar
    # entries are complete dictionary spans between spaces in lines 1457-60;
    # RBBI's surrounding whitespace/punctuation rules are not this API.
    lines = source.decode("utf-8-sig").splitlines()
    starts = [1318, 1347, 1389, 1401, 1402, 1406, 1410, 1414, 1418, 1422,
              1435, 1436, 1437, 1438, 1441, 1442, 1443, 1444, 1447]
    starts += [1474, 1475, 1476, 1478, 1480, 1481, 1482, 1483, 1484,
               1485, 1486, 1487, 1488, 1489, 1490, 1491, 1492, 1493,
               1495, 1496, 1497]
    cases = []
    for line_number in starts:
        at = line_number - 1
        raw = lines[at]
        while "</data>" not in raw:
            at += 1
            raw += lines[at]
        raw = raw.split("<data>", 1)[1].split("</data>", 1)[0]
        raw = re.sub(r"\\u([0-9a-fA-F]{4})", lambda m: chr(int(m[1], 16)), raw)
        raw = raw.replace("\\", "").replace("<200>", "•")
        cases.append((f"rbbitst.txt:{line_number}", raw))
    myanmar = [
        (1457, "လူ•တိုင်း•သည်"), (1457, "တူညီ"), (1457, "လွတ်လပ်•သော"),
        (1457, "ဂုဏ်•သိ•က္•ခါ•ဖြ•င့်"), (1458, "တူညီ•လွတ်လပ်•သော"),
        (1458, "အ•ခွ•င့်•အရေး•များ•ဖြ•င့်"), (1458, "မွေး•ဖွား•လာ•သူများ"),
        (1460, "ထို•သူ•တို့သည်"), (1460, "အချင်းချင်း"),
        (1460, "မေတ္တာ•ထား၍"), (1460, "ဆက်ဆံ•ကျ•င့်•သုံး"),
    ]
    for line_number, marked in myanmar:
        if marked not in lines[line_number - 1]:
            raise ValueError(f"reference fragment absent at {line_number}")
        cases.append((f"rbbitst.txt:{line_number} dictionary span", marked))
    out = ["// THIS FILE IS GENERATED by scripts/unicode/generate-dictionaries. Do not edit it.\n",
           f"// Expected boundaries copied from ICU 78.1 {REVISION} rbbitst.txt.\n",
           "// Unicode License v3; see licenses/icu.txt. No implementation-generated expectations.\n",
           f"pub fn count() -> usize {{\n  return {len(cases)}\n}}\n\n",
           "pub fn text(index: usize) -> string<'static> {\n  return match index {\n"]
    offsets = []
    for i, (origin, marked) in enumerate(cases):
        words = [word.encode() for word in marked.split("•") if word]
        if any(any(chr(c).isspace() for c in word if c < 128) for word in words):
            raise ValueError(f"reference is not a contiguous dictionary span: {origin}")
        boundaries = [0]
        for word in words:
            boundaries.append(boundaries[-1] + len(word))
        data = b"".join(words)
        if i:
            out.append("\n")
        out.append(f"    // {origin}\n    {i} => \"" + "".join(c if ord(c) < 128 else f"\\u{{{ord(c):x}}}" for c in data.decode()) + "\"\n")
        offsets.append(b"".join(struct.pack(">I", n) for n in boundaries))
    out.append("    _ => \"\"\n  }\n}\n\n")
    out.append("pub fn offsets(index: usize) -> &'static [u8] {\n  return match index {\n")
    for i, data in enumerate(offsets):
        out.append(f"    {i} => b\"" + "".join(f"\\x{b:02x}" for b in data) + "\"\n")
    out.append("    _ => b\"\"\n  }\n}\n\n")
    out.append("pub fn source(index: usize) -> string<'static> {\n  return match index {\n")
    for i, (origin, _) in enumerate(cases):
        out.append(f'    {i} => "{origin}"\n')
    out.append('    _ => "unknown fixture"\n  }\n}\n')
    return "".join(out).encode()


def generate(check=False, offline=False):
    inputs = {path: fetch(path, offline) for path in SOURCES}
    for language, (name, checksum) in DICTIONARIES.items():
        root, nodes, edges, count, candidates = packed_dictionary(inputs[f"icu4c/source/data/brkitr/dictionaries/{name}.txt"])
        title = LANGUAGES[language]
        header = (f"//! The ICU {title} word dictionary for `silk.text.word_dictionary`, as a packed minimal trie.\n"
                  "//!\n//! # When to use\n"
                  "//! Use `IcuDictionary` in `silk.text.word_dictionary`, which reads this data. Use this module only to\n"
                  "//! read the packed trie directly.\n//!\n//! # Details\n"
                  f"//! The data is `{name}.txt` of ICU release 78.1: {count} words in {len(nodes) // 7} nodes. A node record is\n"
                  "//! seven bytes: the index of its first edge (big-endian u32), its edge count (u16) and 1 when a word\n"
                  "//! ends there (u8). An edge record is six bytes: a BMP scalar (u16) and the index of its child node\n"
                  "//! (u32). The edges of a node are sorted by scalar.\n//!\n//! @category Text\n\n"
                  "// THIS FILE IS GENERATED by scripts/unicode/generate-dictionaries. Do not edit it.\n"
                  f"// ICU 78.1 {REVISION}; {name}.txt SHA256 {checksum}.\n"
                  "// Unicode License v3 and dictionary notices: licenses/icu.txt.\n"
                  f"// Maximum nested candidates {candidates}.\n\n")
        content = (header + "/// Returns the index of the root node of the trie.\n"
                   + f"pub fn root() -> usize {{\n  return {root}\n}}\n\n"
                   + byte_function("nodes", nodes, "/// Returns the node records of the trie, seven bytes each.\n") + "\n"
                   + byte_function("edges", edges, "/// Returns the edge records of the trie, six bytes each.\n"))
        publish(f"stdlib/silk/text/word_dictionary_{language}.silk", content.encode(), check)
        print(f"{language}: {count} words, {len(nodes) + len(edges)} packed bytes")
    # Preserve the complete pinned license, including Unicode v3, legacy ICU,
    # Lao and Burmese notices verbatim rather than risk truncating a condition.
    publish("licenses/icu.txt", inputs["LICENSE"], check)
    publish("corpus/native/unicode-word-dictionary/imports/icu_reference.silk",
            reference_fixtures(inputs["icu4c/source/test/testdata/rbbitst.txt"]), check)


LANGUAGES = {"thai": "Thai", "lao": "Lao", "khmer": "Khmer", "myanmar": "Burmese (Myanmar)"}

if __name__ == "__main__":
    parser = argparse.ArgumentParser(description=__doc__)
    parser.add_argument("--check", action="store_true", help="compare generated outputs without writing")
    parser.add_argument("--offline", action="store_true", help="require verified cached inputs, never download")
    args = parser.parse_args()
    generate(args.check, args.offline)
