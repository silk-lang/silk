import GitHub
import GitHub { Publication }
import History { Entry, Record }
import Http { HttpError, Http, Response }
import Problem { Problem }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.bool
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.num.i32
import silk.core.result { Result }
import silk.text.string { String }
import silk.testing.testing { AssertionError, Testing }
import silk.num.usize
import silk.collections.list { List }

struct Reply {
  url: string<'static>,
  body: string<'static>,
  status: i32,
}

struct Replies<'a> {
  values: &'a [Reply],
  cursor: usize,
  wrongUrl: bool,
}

impl<'a> Http for Replies<'a> {
  effect fn get(self: &mut Self, url: string) -> Response
  ! Problem | HttpError | OutOfMemoryError ? &mut Allocator {
    if self.cursor >= self.values.length {
      self.wrongUrl = true
      fail Problem { message: "Unexpected extra HTTP request in GitHub test." }
    }
    let reply = &self.values[self.cursor]
    if reply.url != "" && reply.url != url { self.wrongUrl = true }
    self.cursor = self.cursor + usize.ONE
    let mut body = Bytes.make()
    run Bytes.append(&mut body, String.utf8Bytes(reply.body))
    return Response { status: reply.status, body: move body }
  }
}

effect fn selectionClaims() -> () ! Problem | HttpError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let responses = [
    Reply { url: "https://api.github.com/repos/silk-lang/silk/releases/latest",
      body: "{\"tag_name\":\"v2.0.0\",\"draft\":false,\"prerelease\":false,\"assets\":[{\"name\":\"changes-snapshot.toml\"}]}", status: 200 },
    Reply { url: "https://api.github.com/repos/owner/repo/releases/tags/v2.1.0-beta.2%2Babc",
      body: "{\"tag_name\":\"v2.1.0-beta.2+abc\",\"draft\":false,\"prerelease\":true,\"assets\":[{\"name\":\"changes-snapshot.toml\"}]}", status: 200 },
  ]
  let mut http = Replies { values: &responses, cursor: usize.ZERO, wrongUrl: false }
  let latest = run GitHub.resolve("silk-lang/silk", "compiler", "", "1.0.0") |> Effect.provideMut<Http>(&mut http)
  run Testing.expect(String.view(&latest.version) == "2.0.0", "stable baseline prefers latest stable without dev discovery")
  let explicit = run GitHub.resolve("owner/repo", "packages/雪 +%2F", "2.1.0-beta.2+abc", "2.0.0") |> Effect.provideMut<Http>(&mut http)
  run Testing.expect(String.view(&explicit.version) == "2.1.0-beta.2+abc", "explicit prerelease preserves exact build identity")
  run Testing.expect(!http.wrongUrl && http.cursor == 2, "selection uses latest stable or exact encoded-tag API")
}

test effect fn githubSelectsStableOrExactPublishedTag() -> ()
! Problem | HttpError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run selectionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn developmentClaims() -> () ! Problem | HttpError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let responses = [
    Reply { url: "https://api.github.com/repos/owner/repo/releases?per_page=100&page=1",
      body: "[{\"tag_name\":\"v2.0.0\",\"draft\":false,\"prerelease\":false},{\"tag_name\":\"v9.0.0\",\"draft\":true,\"prerelease\":false},{\"tag_name\":\"bootstrap-native-seed\",\"draft\":false,\"prerelease\":false},{\"tag_name\":\"v3.0.0-beta.1\",\"draft\":false,\"prerelease\":true},{\"tag_name\":\"v2.1.0-dev.2+bbbbbbbbbbbb\",\"draft\":false,\"prerelease\":true,\"assets\":[{\"name\":\"changes-snapshot.toml\"}]}]", status: 200 },
    Reply { url: "https://api.github.com/repos/owner/repo/releases/tags/v2.1.0-dev.2%2Bbbbbbbbbbbbb",
      body: "{\"tag_name\":\"v2.1.0-dev.2+bbbbbbbbbbbb\",\"draft\":false,\"prerelease\":true,\"assets\":[{\"name\":\"changes-snapshot.toml\"}]}", status: 200 },
    Reply { url: "https://api.github.com/repos/owner/repo/releases/latest", body: "{}", status: 404 },
    Reply { url: "https://api.github.com/repos/owner/repo/releases?per_page=100&page=1",
      body: "[{\"tag_name\":\"v0.1.0-dev.8624+5081812\",\"draft\":false,\"prerelease\":true},{\"tag_name\":\"v0.1.0-dev.9999+zzzzzzzzzzzz\",\"draft\":false,\"prerelease\":true},{\"tag_name\":\"v0.1.0-dev.1+aaaaaaaaaaaa\",\"draft\":false,\"prerelease\":true,\"assets\":[{\"name\":\"changes-snapshot.toml\"}]}]", status: 200 },
    Reply { url: "https://api.github.com/repos/owner/repo/releases/tags/v0.1.0-dev.1%2Baaaaaaaaaaaa",
      body: "{\"tag_name\":\"v0.1.0-dev.1+aaaaaaaaaaaa\",\"draft\":false,\"prerelease\":true,\"assets\":[{\"name\":\"changes-snapshot.toml\"}]}", status: 200 },
    Reply { url: "https://api.github.com/repos/owner/repo/releases?per_page=100&page=1",
      body: "[{\"tag_name\":\"v2.1.0-dev.2+bbbbbbbbbbbb\",\"draft\":false,\"prerelease\":true},{\"tag_name\":\"v2.1.0\",\"draft\":false,\"prerelease\":false,\"assets\":[{\"name\":\"changes-snapshot.toml\"}]}]", status: 200 },
    Reply { url: "https://api.github.com/repos/owner/repo/releases/tags/v2.1.0",
      body: "{\"tag_name\":\"v2.1.0\",\"draft\":false,\"prerelease\":false,\"assets\":[{\"name\":\"changes-snapshot.toml\"}]}", status: 200 },
  ]
  let mut http = Replies { values: &responses, cursor: usize.ZERO, wrongUrl: false }
  let dev = run GitHub.resolve("owner/repo", "", "", "2.1.0-dev.1+aaaaaaaaaaaa") |> Effect.provideMut<Http>(&mut http)
  run Testing.expect(String.view(&dev.version) == "2.1.0-dev.2+bbbbbbbbbbbb", "installed dev follows newest eligible dev, excluding drafts, seeds and beta")
  let first = run GitHub.resolve("owner/repo", "", "", "0.0.0") |> Effect.provideMut<Http>(&mut http)
  run Testing.expect(String.view(&first.version) == "0.1.0-dev.1+aaaaaaaaaaaa", "no stable release permits preannouncement dev discovery")
  let promoted = run GitHub.resolve("owner/repo", "", "", "2.1.0-dev.2+bbbbbbbbbbbb") |> Effect.provideMut<Http>(&mut http)
  run Testing.expect(String.view(&promoted.version) == "2.1.0", "installed dev follows a newer stable publication")
  run Testing.expect(!http.wrongUrl && http.cursor == 7, "dev discovery selects highest precedence regardless of list order or older missing assets")
}

test effect fn githubDiscoversDevelopmentAndStablePromotion() -> ()
! Problem | HttpError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run developmentClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn emptyListingClaims() -> () ! Problem | HttpError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let listing = "https://api.github.com/repos/owner/repo/releases?per_page=100&page=1"
  let responses = [
    Reply { url: listing, body: "[]", status: 200 },
    Reply { url: listing, body: "[]", status: 200 },
    Reply { url: listing,
      body: "[{\"tag_name\":\"v0.1.0-dev.8+9782666e694b\",\"draft\":false,\"prerelease\":true}]", status: 200 },
    Reply { url: "https://api.github.com/repos/owner/repo/releases/tags/v0.1.0-dev.8%2B9782666e694b",
      body: "{\"tag_name\":\"v0.1.0-dev.8+9782666e694b\",\"draft\":false,\"prerelease\":true,\"assets\":[{\"name\":\"changes-snapshot.toml\"}]}", status: 200 },
  ]
  let mut http = Replies { values: &responses, cursor: usize.ZERO, wrongUrl: false }
  let found = run GitHub.resolve("owner/repo", "", "", "0.1.0-dev.6+1aed5da1a342") |> Effect.provideMut<Http>(&mut http)
  run Testing.expect(String.view(&found.version) == "0.1.0-dev.8+9782666e694b", "an empty release listing is requested again")
  run Testing.expect(!http.wrongUrl && http.cursor == 4, "empty listings are retried only until releases appear")

  let empty = [
    Reply { url: listing, body: "[]", status: 200 },
    Reply { url: listing, body: "[]", status: 200 },
    Reply { url: listing, body: "[]", status: 200 },
    Reply { url: listing, body: "[]", status: 200 },
    Reply { url: listing, body: "[]", status: 200 },
  ]
  let mut none = Replies { values: &empty, cursor: usize.ZERO, wrongUrl: false }
  let attempted = run Effect.result(GitHub.resolve("owner/repo", "", "", "0.1.0-dev.6+1aed5da1a342") |> Effect.provideMut<Http>(&mut none))
  match move attempted {
    Result<Publication, Problem | HttpError | OutOfMemoryError>.Success { value: unexpected } => {
      run Testing.expect(false, "a release listing that stays empty must fail")
    }
    Result<Publication, Problem | HttpError | OutOfMemoryError>.Failure { error } => match move error {
      Problem expected => {}
      HttpError unexpected => { run Testing.expect(false, "an empty listing is not a transport failure") }
      OutOfMemoryError allocation => { fail move allocation }
    }
  }
  run Testing.expect(!none.wrongUrl && none.cursor == 5, "an empty listing is requested five times in all")
}

test effect fn githubRetriesEmptyReleaseListings() -> ()
! Problem | HttpError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run emptyListingClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn rejectResolution(repository: string, directory: string, to: string, body: string<'static>, status: i32, requests: usize)
-> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let responses = [Reply { url: "", body: body, status: status }]
  let mut http = Replies { values: &responses, cursor: usize.ZERO, wrongUrl: false }
  let attempted = run Effect.result(GitHub.resolve(repository, directory, to, "1.0.0") |> Effect.provideMut<Http>(&mut http))
  match move attempted {
    Result<Publication, Problem | HttpError | OutOfMemoryError>.Success { value: unexpected } => {
      run Testing.expect(false, "invalid GitHub discovery must fail rather than manufacture a publication")
    }
    Result<Publication, Problem | HttpError | OutOfMemoryError>.Failure { error } => match move error {
      Problem expected => {}
      HttpError unexpected => { run Testing.expect(false, "HTTP response validation must not be reported as TLS or trust failure") }
      OutOfMemoryError allocation => { fail move allocation }
    }
  }
  run Testing.expect(http.cursor == requests && !http.wrongUrl, "invalid local selectors fail before network access; remote failures do not retry or fall back")
}

effect fn invalidSelectorClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let valid = "{\"tag_name\":\"v2.0.0\",\"draft\":false,\"prerelease\":false}"
  run rejectResolution("https://github.com/owner/repo", "", "", valid, 200, 0)
  run rejectResolution("owner", "", "", valid, 200, 0)
  run rejectResolution("owner/repo/extra", "", "", valid, 200, 0)
  run rejectResolution("owner/..", "", "", valid, 200, 0)
  run rejectResolution("/repo", "", "", valid, 200, 0)
  run rejectResolution("owner/repo?token=secret", "", "", valid, 200, 0)
  run rejectResolution("owner/repo", "../compiler", "", valid, 200, 0)
  run rejectResolution("owner/repo", "compiler/./src", "", valid, 200, 0)
  run rejectResolution("owner/repo", "/compiler", "", valid, 200, 0)
  run rejectResolution("owner/repo", "compiler/", "", valid, 200, 0)
  run rejectResolution("owner/repo", "a//b", "", valid, 200, 0)
  run rejectResolution("owner/repo", "a\\b", "", valid, 200, 0)
  run rejectResolution("owner/repo", "a\nb", "", valid, 200, 0)
  run rejectResolution("owner/repo", "", "v2.0.0", valid, 200, 0)
  run rejectResolution("owner/repo", "", "2.0.0/../main", valid, 200, 0)
  run rejectResolution("owner/repo", "", "02.0.0", valid, 200, 0)
}

test effect fn githubRejectsUnsafePathsAndMalformedTargetsBeforeFetching() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run invalidSelectorClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn metadataClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  run rejectResolution("owner/repo", "", "", "{", 200, 1)
  run rejectResolution("owner/repo", "", "", "[]", 200, 1)
  run rejectResolution("owner/repo", "", "", "{\"tag_name\":12,\"draft\":false,\"prerelease\":false}", 200, 1)
  run rejectResolution("owner/repo", "", "", "{\"tag_name\":\"v2.0.0\",\"draft\":false}", 200, 1)
  run rejectResolution("owner/repo", "", "", "{\"tag_name\":\"v2.0.0\",\"draft\":\"false\",\"prerelease\":false}", 200, 1)
  run rejectResolution("owner/repo", "", "", "{\"tag_name\":\"v2.0.0\",\"draft\":false,\"prerelease\":0}", 200, 1)
  run rejectResolution("owner/repo", "", "", "{\"tag_name\":\"v2.0.0\",\"draft\":false,\"prerelease\":false,\"tag_name\":\"v3.0.0\"}", 200, 1)
  run rejectResolution("owner/repo", "", "2.0.0", "{\"tag_name\":\"v2.0.0\",\"draft\":true,\"prerelease\":false}", 200, 1)
  run rejectResolution("owner/repo", "", "", "{\"tag_name\":\"v2.0.0\",\"draft\":false,\"prerelease\":true}", 200, 1)
  run rejectResolution("owner/repo", "", "", "{\"tag_name\":\"v2.0.0-beta.1\",\"draft\":false,\"prerelease\":false}", 200, 1)
  run rejectResolution("owner/repo", "", "", "{\"tag_name\":\"release-2.0.0\",\"draft\":false,\"prerelease\":false}", 200, 1)
  run rejectResolution("owner/repo", "", "", "{\"tag_name\":\"v2.0\",\"draft\":false,\"prerelease\":false}", 200, 1)
  run rejectResolution("owner/repo", "", "2.0.0+abc", "{\"tag_name\":\"v2.0.0+def\",\"draft\":false,\"prerelease\":false}", 200, 1)
  run rejectResolution("owner/repo", "", "2.0.0", "{\"tag_name\":\"bootstrap-native-2.0.0\",\"draft\":false,\"prerelease\":false}", 200, 1)
  run rejectResolution("owner/repo", "", "2.0.0", "{\"tag_name\":\"v2.0.0\",\"draft\":false,\"prerelease\":false,\"assets\":[]}", 200, 1)
  run rejectResolution("owner/repo", "", "2.0.0", "{\"tag_name\":\"v2.0.0\",\"draft\":false,\"prerelease\":false,\"assets\":[{\"name\":\"changes-snapshot.toml\"},{\"name\":\"changes-snapshot.toml\"}]}", 200, 1)
  let valid = "{\"tag_name\":\"v2.0.0\",\"draft\":false,\"prerelease\":false}"
  run rejectResolution("owner/repo", "", "2.0.0", valid, 200, 1)
  run rejectResolution("owner/repo", "", "2.0.0", valid, 404, 1)
  run rejectResolution("owner/repo", "", "", valid, 403, 1)
  run rejectResolution("owner/repo", "", "", valid, 429, 1)
  run rejectResolution("owner/repo", "", "", valid, 500, 1)
  run rejectResolution("owner/repo", "", "", valid, 302, 1)
}

test effect fn githubRejectsUnpublishedAmbiguousOrUnstableMetadata() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run metadataClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

fn targetMetadata() -> string<'static> {
  return "{\"tag_name\":\"v1.1.0\",\"draft\":false,\"prerelease\":false,\"assets\":[{\"name\":\"changes-snapshot.toml\",\"browser_download_url\":\"https://attacker.invalid/do-not-follow\"}]}"
}

fn baselineMetadata() -> string<'static> {
  return "{\"tag_name\":\"v1.1.0-dev.1+aaaaaaaaaaaa\",\"draft\":false,\"prerelease\":true,\"assets\":[{\"name\":\"changes-snapshot.toml\"}]}"
}

fn targetSnapshot() -> string<'static> {
  return "format = 1\nschema = 'silk.changes.snapshot'\npackage = 'example'\nversion = '1.1.0'\nkind = 'stable'\ncommit = 'bbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbbb'\nfloor = '1.0.0'\n[[changes]]\nid = 'first'\nbump = 'minor'\nsummary = 'Already installed'\n[[changes]]\nid = 'second'\nbump = 'patch'\nsummary = 'New fix'\nmigration = 'Update config'\n"
}

fn baselineSnapshot() -> string<'static> {
  return "format = 1\nschema = 'silk.changes.snapshot'\npackage = 'example'\nversion = '1.1.0-dev.1+aaaaaaaaaaaa'\nkind = 'dev'\ncommit = 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'\nfloor = '1.0.0'\n[[changes]]\nid = 'first'\nbump = 'minor'\nsummary = 'Already installed'\n"
}

effect fn comparison(from: string) -> List<Record>
! Problem | HttpError | OutOfMemoryError ? &mut Http | &mut Allocator {
  let publication = run GitHub.resolve("owner/repo", "compiler", "1.1.0", from)
  return run GitHub.query(&publication, "example", from)
}

effect fn snapshotClaims() -> () ! Problem | HttpError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let responses = [
    Reply { url: "https://api.github.com/repos/owner/repo/releases/tags/v1.1.0", body: targetMetadata(), status: 200 },
    Reply { url: "https://github.com/owner/repo/releases/download/v1.1.0/changes-snapshot.toml", body: targetSnapshot(), status: 200 },
    Reply { url: "https://api.github.com/repos/owner/repo/releases/tags/v1.1.0-dev.1%2Baaaaaaaaaaaa", body: baselineMetadata(), status: 200 },
    Reply { url: "https://github.com/owner/repo/releases/download/v1.1.0-dev.1%2Baaaaaaaaaaaa/changes-snapshot.toml", body: baselineSnapshot(), status: 200 },
  ]
  let mut http = Replies { values: &responses, cursor: usize.ZERO, wrongUrl: false }
  let records = run comparison("1.1.0-dev.1+aaaaaaaaaaaa") |> Effect.provideMut<Http>(&mut http)
  let items = List<Record>.asSlice(&records)
  run Testing.expect(items.length == 1, "stable promotion returns the target comparison")
  let entries = List<Entry>.asSlice(&items[0].entries)
  run Testing.expect(entries.length == 1 && String.view(&entries[0].id) == "second", "unchanged consumed dev notes are not repeated")
  run Testing.expect(String.view(&entries[0].migration) == "Update config", "snapshot comparison retains authoritative migration guidance")
  run Testing.expect(!http.wrongUrl && http.cursor == 4, "each snapshot uses its own exact release; metadata URLs never control the request host")
}

test effect fn githubComparesExactReleaseAssetsAcrossDevPromotion() -> ()
! Problem | HttpError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run snapshotClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn floorClaims() -> () ! Problem | HttpError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let responses = [
    Reply { url: "https://api.github.com/repos/owner/repo/releases/tags/v1.1.0", body: targetMetadata(), status: 200 },
    Reply { url: "https://github.com/owner/repo/releases/download/v1.1.0/changes-snapshot.toml", body: targetSnapshot(), status: 200 },
  ]
  let mut http = Replies { values: &responses, cursor: usize.ZERO, wrongUrl: false }
  let records = run comparison("1.0.0") |> Effect.provideMut<Http>(&mut http)
  let items = List<Record>.asSlice(&records)
  run Testing.expect(items.length == 1 && List<Entry>.length(&items[0].entries) == 2, "coverage floor reports all target entries")
  run Testing.expect(!http.wrongUrl && http.cursor == 2, "exact coverage floor needs no imaginary published baseline")
}

test effect fn githubCoverageFloorDoesNotRequirePublishedBaseline() -> ()
! Problem | HttpError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run floorClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn rejectComparison(responses: &[Reply], from: string, requests: usize) -> ()
! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut http = Replies { values: responses, cursor: usize.ZERO, wrongUrl: false }
  let attempted = run Effect.result(comparison(from) |> Effect.provideMut<Http>(&mut http))
  match move attempted {
    Result<List<Record>, Problem | HttpError | OutOfMemoryError>.Success { value: unexpected } => {
      run Testing.expect(false, "missing or invalid snapshots must not become empty or partial history")
    }
    Result<List<Record>, Problem | HttpError | OutOfMemoryError>.Failure { error } => match move error {
      Problem expected => {}
      HttpError unexpected => { run Testing.expect(false, "snapshot validation is not a TLS failure") }
      OutOfMemoryError allocation => { fail move allocation }
    }
  }
  run Testing.expect(!http.wrongUrl && http.cursor == requests, "failure reaches the independently required snapshot boundary")
}

effect fn rejectBaseline(body: string<'static>, status: i32) -> ()
! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let responses = [
    Reply { url: "https://api.github.com/repos/owner/repo/releases/tags/v1.1.0", body: targetMetadata(), status: 200 },
    Reply { url: "https://github.com/owner/repo/releases/download/v1.1.0/changes-snapshot.toml", body: targetSnapshot(), status: 200 },
    Reply { url: "https://api.github.com/repos/owner/repo/releases/tags/v1.1.0-dev.1%2Baaaaaaaaaaaa", body: baselineMetadata(), status: 200 },
    Reply { url: "https://github.com/owner/repo/releases/download/v1.1.0-dev.1%2Baaaaaaaaaaaa/changes-snapshot.toml", body: body, status: status },
  ]
  run rejectComparison(&responses, "1.1.0-dev.1+aaaaaaaaaaaa", 4)
}

effect fn snapshotFailureClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  run rejectBaseline("", 404)
  run rejectBaseline("", 403)
  run rejectBaseline("", 500)
  run rejectBaseline("not TOML", 200)
  run rejectBaseline("format = 1\nschema = 'silk.changes.snapshot'\npackage = 'wrong'\nversion = '1.1.0-dev.1+aaaaaaaaaaaa'\nkind = 'dev'\ncommit = 'aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa'\nfloor = '1.0.0'\nchanges = []\n", 200)
  run rejectBaseline("format = 1\nschema = 'silk.changes.snapshot'\npackage = 'example'\nversion = '1.1.0-dev.1+cccccccccccc'\nkind = 'dev'\ncommit = 'cccccccccccccccccccccccccccccccccccccccc'\nfloor = '1.0.0'\nchanges = []\n", 200)
  let missingTarget = [
    Reply { url: "https://api.github.com/repos/owner/repo/releases/tags/v1.1.0", body: targetMetadata(), status: 200 },
    Reply { url: "https://github.com/owner/repo/releases/download/v1.1.0/changes-snapshot.toml", body: "", status: 404 },
  ]
  run rejectComparison(&missingTarget, "1.0.0", 2)
  let mismatchedTarget = [
    Reply { url: "https://api.github.com/repos/owner/repo/releases/tags/v1.1.0", body: targetMetadata(), status: 200 },
    Reply { url: "https://github.com/owner/repo/releases/download/v1.1.0/changes-snapshot.toml", body: baselineSnapshot(), status: 200 },
  ]
  run rejectComparison(&mismatchedTarget, "1.0.0", 2)
  let missingBaselineRelease = [
    Reply { url: "https://api.github.com/repos/owner/repo/releases/tags/v1.1.0", body: targetMetadata(), status: 200 },
    Reply { url: "https://github.com/owner/repo/releases/download/v1.1.0/changes-snapshot.toml", body: targetSnapshot(), status: 200 },
    Reply { url: "https://api.github.com/repos/owner/repo/releases/tags/v1.1.0-dev.1%2Baaaaaaaaaaaa", body: "", status: 404 },
  ]
  run rejectComparison(&missingBaselineRelease, "1.1.0-dev.1+aaaaaaaaaaaa", 3)
}

test effect fn githubRejectsMissingAndMismatchedTargetAndExactBaselineSnapshots() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run snapshotFailureClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn latestDevelopment() -> List<Record>
! Problem | HttpError | OutOfMemoryError ? &mut Http | &mut Allocator {
  let publication = run GitHub.resolve("owner/repo", "", "", "1.1.0-dev.1+aaaaaaaaaaaa")
  return run GitHub.query(&publication, "example", "1.1.0-dev.1+aaaaaaaaaaaa")
}

effect fn latestDevFailureClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let responses = [
    Reply { url: "https://api.github.com/repos/owner/repo/releases?per_page=100&page=1",
      body: "[{\"tag_name\":\"v1.1.0-dev.2+bbbbbbbbbbbb\",\"draft\":false,\"prerelease\":true,\"assets\":[{\"name\":\"changes-snapshot.toml\"}]},{\"tag_name\":\"v1.0.0\",\"draft\":false,\"prerelease\":false,\"assets\":[{\"name\":\"changes-snapshot.toml\"}]}]", status: 200 },
    Reply { url: "https://api.github.com/repos/owner/repo/releases/tags/v1.1.0-dev.2%2Bbbbbbbbbbbbb",
      body: "{\"tag_name\":\"v1.1.0-dev.2+bbbbbbbbbbbb\",\"draft\":false,\"prerelease\":true,\"assets\":[{\"name\":\"changes-snapshot.toml\"}]}", status: 200 },
    Reply { url: "https://github.com/owner/repo/releases/download/v1.1.0-dev.2%2Bbbbbbbbbbbbb/changes-snapshot.toml", body: "", status: 404 },
  ]
  let mut http = Replies { values: &responses, cursor: usize.ZERO, wrongUrl: false }
  let attempted = run Effect.result(latestDevelopment() |> Effect.provideMut<Http>(&mut http))
  match move attempted {
    Result<List<Record>, Problem | HttpError | OutOfMemoryError>.Success { value: unexpected } => {
      run Testing.expect(false, "missing latest dev snapshot cannot silently fall back to stable history")
    }
    Result<List<Record>, Problem | HttpError | OutOfMemoryError>.Failure { error } => match move error {
      Problem expected => {}
      HttpError unexpected => { run Testing.expect(false, "missing dev asset is not a TLS failure") }
      OutOfMemoryError allocation => { fail move allocation }
    }
  }
  run Testing.expect(!http.wrongUrl && http.cursor == 3, "latest dev failure occurs at the selected exact snapshot without stable fallback")
}

test effect fn githubMissingLatestDevSnapshotIsAnError() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run latestDevFailureClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

struct PagedReleases {
  cursor: usize,
  wrongUrl: bool,
}

impl Http for PagedReleases {
  effect fn get(self: &mut Self, url: string) -> Response
  ! Problem | HttpError | OutOfMemoryError ? &mut Allocator {
    let mut body = Bytes.make()
    if self.cursor == 0 {
      if url != "https://api.github.com/repos/owner/repo/releases?per_page=100&page=1" { self.wrongUrl = true }
      run Bytes.append(&mut body, b"[{\"tag_name\":\"v1.0.0\",\"draft\":false,\"prerelease\":false}")
      let mut index = usize.ONE
      while index < 100 {
        run Bytes.append(&mut body, b",{\"tag_name\":\"bootstrap-native-seed\",\"draft\":true,\"prerelease\":false}")
        index = index + usize.ONE
      }
      run Bytes.append(&mut body, b"]")
    } else {
      if self.cursor == 1 {
        if url != "https://api.github.com/repos/owner/repo/releases?per_page=100&page=2" { self.wrongUrl = true }
        run Bytes.append(&mut body, b"[{\"tag_name\":\"v1.1.0-dev.10+bbbbbbbbbbbb\",\"draft\":false,\"prerelease\":true},{\"tag_name\":\"v1.1.0-dev.9+aaaaaaaaaaaa\",\"draft\":false,\"prerelease\":true}]")
      } else {
        if self.cursor != 2 || url != "https://api.github.com/repos/owner/repo/releases/tags/v1.1.0-dev.10%2Bbbbbbbbbbbbb" { self.wrongUrl = true }
        run Bytes.append(&mut body, b"{\"tag_name\":\"v1.1.0-dev.10+bbbbbbbbbbbb\",\"draft\":false,\"prerelease\":true,\"assets\":[{\"name\":\"changes-snapshot.toml\"}]}")
      }
    }
    self.cursor = self.cursor + usize.ONE
    return Response { status: 200, body: move body }
  }
}

effect fn paginationClaims() -> () ! Problem | HttpError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut http = PagedReleases { cursor: usize.ZERO, wrongUrl: false }
  let publication = run GitHub.resolve("owner/repo", "", "", "1.1.0-dev.8+aaaaaaaaaaaa") |> Effect.provideMut<Http>(&mut http)
  run Testing.expect(String.view(&publication.version) == "1.1.0-dev.10+bbbbbbbbbbbb", "highest numeric dev counter on a later page wins over earlier stable and lexical dev ordering")
  run Testing.expect(!http.wrongUrl && http.cursor == 3, "eligible first page does not stop discovery before later pages")
}

test effect fn githubDiscoversHighestVersionAcrossPages() -> ()
! Problem | HttpError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run paginationClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn ambiguousDevelopmentClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let responses = [
    Reply { url: "https://api.github.com/repos/owner/repo/releases?per_page=100&page=1",
      body: "[{\"tag_name\":\"v1.1.0-dev.2+aaaaaaaaaaaa\",\"draft\":false,\"prerelease\":true},{\"tag_name\":\"v1.1.0-dev.2+bbbbbbbbbbbb\",\"draft\":false,\"prerelease\":true}]", status: 200 },
  ]
  let mut http = Replies { values: &responses, cursor: usize.ZERO, wrongUrl: false }
  let attempted = run Effect.result(GitHub.resolve("owner/repo", "", "", "1.1.0-dev.1+aaaaaaaaaaaa") |> Effect.provideMut<Http>(&mut http))
  match move attempted {
    Result<Publication, Problem | HttpError | OutOfMemoryError>.Success { value: unexpected } => {
      run Testing.expect(false, "equal precedence with different full identities requires an exact target")
    }
    Result<Publication, Problem | HttpError | OutOfMemoryError>.Failure { error } => match move error {
      Problem expected => {}
      HttpError unexpected => { run Testing.expect(false, "ambiguous identity is not a TLS failure") }
      OutOfMemoryError allocation => { fail move allocation }
    }
  }
  run Testing.expect(!http.wrongUrl && http.cursor == 1, "ambiguous discovery does not choose either conflicting asset")
}

test effect fn githubRejectsAmbiguousDiscoveryMetadata() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run ambiguousDevelopmentClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
