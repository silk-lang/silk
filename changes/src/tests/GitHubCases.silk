import GitHub
import GitHub { Publication }
import History { Entry, Record }
import Http { Http, Response }
import Problem { Problem }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.bool
import silk.bytes { Bytes }
import silk.effect { Effect }
import silk.i32
import silk.result { Result }
import silk.string { String }
import silk.testing { AssertionError, Testing }
import silk.usize
import silk.vector { Vector }

struct Reply {
  url: string<'static>
  body: string<'static>
  status: i32
}

struct Replies<'a> {
  values: &'a [Reply]
  cursor: usize
  wrongUrl: bool
}

impl<'a> Http for Replies<'a> {
  effect fn get(self: &mut Self, url: string) -> Response
  ! Problem | OutOfMemoryError ? &mut Allocator {
    if self.cursor >= self.values.length {
      self.wrongUrl = true
      fail Problem { message: "Unexpected extra HTTP request in GitHub test." }
    }
    let reply = &self.values[self.cursor]
    if reply.url != "" && reply.url != url { self.wrongUrl = true }
    self.cursor = self.cursor + usize.ONE
    let mut body = Bytes.make()
    run Bytes.append(&mut body, String.utf8Bytes(reply.body))
    return Response { status: reply.status, body: move body }
  }
}

effect fn selectionClaims() -> () ! Problem | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let responses = [
    Reply { url: "https://api.github.com/repos/silk-lang/silk/releases/latest",
      body: "{\"tag_name\":\"v2.0.0\",\"draft\":false,\"prerelease\":false}", status: 200 },
    Reply { url: "https://api.github.com/repos/owner/repo/releases/tags/v2.1.0-beta.2%2Babc",
      body: "{\"tag_name\":\"v2.1.0-beta.2+abc\",\"draft\":false,\"prerelease\":true}", status: 200 },
    Reply { url: "https://api.github.com/repos/owner/repo/releases/tags/v2.0.0",
      body: "{\"tag_name\":\"v2.0.0\",\"draft\":false,\"prerelease\":false}", status: 200 },
  ]
  let mut http = Replies { values: &responses, cursor: usize.ZERO, wrongUrl: false }
  let latest = run GitHub.resolve("silk-lang/silk", "compiler", "") |> Effect.provideMut<Http>(&mut http)
  run Testing.expect(String.view(&latest.version) == "2.0.0", "latest stable selects the published version")
  run Testing.expect(String.view(&latest.historyBase) == "https://raw.githubusercontent.com/silk-lang/silk/v2.0.0/compiler/.changes/releases/",
    "compiler history is pinned to the selected release tag, not the default branch")
  let explicit = run GitHub.resolve("owner/repo", "packages/雪 +%2F", "2.1.0-beta.2+abc") |> Effect.provideMut<Http>(&mut http)
  run Testing.expect(String.view(&explicit.version) == "2.1.0-beta.2+abc", "explicit prerelease preserves exact build identity")
  run Testing.expect(String.view(&explicit.historyBase) == "https://raw.githubusercontent.com/owner/repo/v2.1.0-beta.2%2Babc/packages/%E9%9B%AA%20%2B%252F/.changes/releases/",
    "tag and directory bytes are encoded once; literal percent is not interpreted as an existing escape")
  let root = run GitHub.resolve("owner/repo", "", "2.0.0") |> Effect.provideMut<Http>(&mut http)
  run Testing.expect(String.view(&root.historyBase) == "https://raw.githubusercontent.com/owner/repo/v2.0.0/.changes/releases/",
    "repository-root packages do not introduce a second path separator")
  run Testing.expect(!http.wrongUrl && http.cursor == 3, "release selection uses the actual latest or exact encoded-tag API")
}

test effect fn githubSelectsStableOrExactPublishedTag() -> ()
! Problem | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run selectionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn rejectResolution(repository: string, directory: string, to: string, body: string<'static>, status: i32, requests: usize)
-> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let responses = [Reply { url: "", body: body, status: status }]
  let mut http = Replies { values: &responses, cursor: usize.ZERO, wrongUrl: false }
  let attempted = run Effect.result(GitHub.resolve(repository, directory, to) |> Effect.provideMut<Http>(&mut http))
  match move attempted {
    Result<Publication, Problem | OutOfMemoryError>.Success { value: unexpected } => {
      run Testing.expect(false, "invalid GitHub discovery must fail rather than manufacture a publication")
    }
    Result<Publication, Problem | OutOfMemoryError>.Failure { error } => match move error {
      Problem expected => {}
      OutOfMemoryError allocation => { fail move allocation }
    }
  }
  run Testing.expect(http.cursor == requests && !http.wrongUrl, "invalid local selectors fail before network access; remote failures do not retry or fall back")
}

effect fn invalidSelectorClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let valid = "{\"tag_name\":\"v2.0.0\",\"draft\":false,\"prerelease\":false}"
  run rejectResolution("https://github.com/owner/repo", "", "", valid, 200, 0)
  run rejectResolution("owner", "", "", valid, 200, 0)
  run rejectResolution("owner/repo/extra", "", "", valid, 200, 0)
  run rejectResolution("owner/..", "", "", valid, 200, 0)
  run rejectResolution("/repo", "", "", valid, 200, 0)
  run rejectResolution("owner/repo?token=secret", "", "", valid, 200, 0)
  run rejectResolution("owner/repo", "../compiler", "", valid, 200, 0)
  run rejectResolution("owner/repo", "compiler/./src", "", valid, 200, 0)
  run rejectResolution("owner/repo", "/compiler", "", valid, 200, 0)
  run rejectResolution("owner/repo", "compiler/", "", valid, 200, 0)
  run rejectResolution("owner/repo", "a//b", "", valid, 200, 0)
  run rejectResolution("owner/repo", "a\\b", "", valid, 200, 0)
  run rejectResolution("owner/repo", "a\nb", "", valid, 200, 0)
  run rejectResolution("owner/repo", "", "v2.0.0", valid, 200, 0)
  run rejectResolution("owner/repo", "", "2.0.0/../main", valid, 200, 0)
  run rejectResolution("owner/repo", "", "02.0.0", valid, 200, 0)
}

test effect fn githubRejectsUnsafePathsAndMalformedTargetsBeforeFetching() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run invalidSelectorClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn metadataClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  run rejectResolution("owner/repo", "", "", "{", 200, 1)
  run rejectResolution("owner/repo", "", "", "[]", 200, 1)
  run rejectResolution("owner/repo", "", "", "{\"tag_name\":12,\"draft\":false,\"prerelease\":false}", 200, 1)
  run rejectResolution("owner/repo", "", "", "{\"tag_name\":\"v2.0.0\",\"draft\":false}", 200, 1)
  run rejectResolution("owner/repo", "", "", "{\"tag_name\":\"v2.0.0\",\"draft\":\"false\",\"prerelease\":false}", 200, 1)
  run rejectResolution("owner/repo", "", "", "{\"tag_name\":\"v2.0.0\",\"draft\":false,\"prerelease\":0}", 200, 1)
  run rejectResolution("owner/repo", "", "", "{\"tag_name\":\"v2.0.0\",\"draft\":false,\"prerelease\":false,\"tag_name\":\"v3.0.0\"}", 200, 1)
  run rejectResolution("owner/repo", "", "2.0.0", "{\"tag_name\":\"v2.0.0\",\"draft\":true,\"prerelease\":false}", 200, 1)
  run rejectResolution("owner/repo", "", "", "{\"tag_name\":\"v2.0.0\",\"draft\":false,\"prerelease\":true}", 200, 1)
  run rejectResolution("owner/repo", "", "", "{\"tag_name\":\"v2.0.0-beta.1\",\"draft\":false,\"prerelease\":false}", 200, 1)
  run rejectResolution("owner/repo", "", "", "{\"tag_name\":\"release-2.0.0\",\"draft\":false,\"prerelease\":false}", 200, 1)
  run rejectResolution("owner/repo", "", "", "{\"tag_name\":\"v2.0\",\"draft\":false,\"prerelease\":false}", 200, 1)
  run rejectResolution("owner/repo", "", "2.0.0+abc", "{\"tag_name\":\"v2.0.0+def\",\"draft\":false,\"prerelease\":false}", 200, 1)
  let valid = "{\"tag_name\":\"v2.0.0\",\"draft\":false,\"prerelease\":false}"
  run rejectResolution("owner/repo", "", "", valid, 404, 1)
  run rejectResolution("owner/repo", "", "2.0.0", valid, 404, 1)
  run rejectResolution("owner/repo", "", "", valid, 403, 1)
  run rejectResolution("owner/repo", "", "", valid, 429, 1)
  run rejectResolution("owner/repo", "", "", valid, 500, 1)
  run rejectResolution("owner/repo", "", "", valid, 302, 1)
}

test effect fn githubRejectsUnpublishedAmbiguousOrUnstableMetadata() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run metadataClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn historyClaims() -> () ! Problem | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let responses = [
    Reply { url: "https://api.github.com/repos/owner/repo/releases/latest",
      body: "{\"tag_name\":\"v1.1.0\",\"draft\":false,\"prerelease\":false}", status: 200 },
    Reply { url: "https://raw.githubusercontent.com/owner/repo/v1.1.0/.changes/releases/1.1.0.toml",
      body: "format = 1\npackage = 'example'\nfrom = '1.1.0-beta.2+abc'\nversion = '1.1.0'\nbase = '1.0.0'\n[[changes]]\nid = 'first'\nbump = 'minor'\nsummary = 'Already installed'\n[[changes]]\nid = 'second'\nbump = 'patch'\nsummary = 'New fix'\nmigration = 'Update config'\n", status: 200 },
    Reply { url: "https://raw.githubusercontent.com/owner/repo/v1.1.0/.changes/releases/1.1.0-beta.2%2Babc.toml",
      body: "format = 1\npackage = 'example'\nfrom = '1.0.0'\nversion = '1.1.0-beta.2+abc'\nbase = '1.0.0'\n[[changes]]\nid = 'first'\nbump = 'minor'\nsummary = 'Already installed'\n", status: 200 },
  ]
  let mut http = Replies { values: &responses, cursor: usize.ZERO, wrongUrl: false }
  let publication = run GitHub.resolve("owner/repo", "", "") |> Effect.provideMut<Http>(&mut http)
  let records = run GitHub.query(&publication, "example", "1.1.0-beta.2+abc") |> Effect.provideMut<Http>(&mut http)
  let items = Vector<Record>.asSlice(&records)
  run Testing.expect(items.length == 1, "stable promotion returns its release record")
  let entries = Vector<Entry>.asSlice(&items[0].entries)
  run Testing.expect(entries.length == 1 && String.view(&entries[0].id) == "second", "remote prerelease baseline excludes already installed changes")
  run Testing.expect(String.view(&entries[0].migration) == "Update config", "remote TOML retains authoritative migration notes")
  run Testing.expect(!http.wrongUrl && http.cursor == 3, "all records including the prerelease baseline use the single selected release tag")
}

test effect fn githubReadsCompleteTagPinnedHistoryIncludingPrereleaseBaseline() -> ()
! Problem | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run historyClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn rejectHistory(body: string<'static>, status: i32) -> ()
! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let publication = Publication { version: run String.copy("1.2.0"),
    historyBase: run String.copy("https://raw.githubusercontent.com/owner/repo/v1.2.0/.changes/releases/") }
  let responses = [
    Reply { url: "https://raw.githubusercontent.com/owner/repo/v1.2.0/.changes/releases/1.2.0.toml",
      body: "format = 1\npackage = 'example'\nfrom = '1.1.0'\nversion = '1.2.0'\nbase = '1.1.0'\nchanges = []\n", status: 200 },
    Reply { url: "https://raw.githubusercontent.com/owner/repo/v1.2.0/.changes/releases/1.1.0.toml", body: body, status: status },
  ]
  let mut http = Replies { values: &responses, cursor: usize.ZERO, wrongUrl: false }
  let attempted = run Effect.result(GitHub.query(&publication, "example", "1.0.0") |> Effect.provideMut<Http>(&mut http))
  match move attempted {
    Result<Vector<Record>, Problem | OutOfMemoryError>.Success { value: unexpected } => {
      run Testing.expect(false, "remote predecessor failure must not return empty or partial history")
    }
    Result<Vector<Record>, Problem | OutOfMemoryError>.Failure { error } => match move error {
      Problem expected => {}
      OutOfMemoryError allocation => { fail move allocation }
    }
  }
  run Testing.expect(!http.wrongUrl && http.cursor == 2, "history failure occurs at the required predecessor at the selected tag")
}

effect fn incompleteHistoryClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  run rejectHistory("", 404)
  run rejectHistory("", 403)
  run rejectHistory("", 500)
  run rejectHistory("not TOML", 200)
  run rejectHistory("format = 1\npackage = 'wrong'\nfrom = '1.0.0'\nversion = '1.1.0'\nbase = '1.0.0'\nchanges = []\n", 200)
  run rejectHistory("format = 1\npackage = 'example'\nfrom = '1.0.0'\nversion = '1.1.1'\nbase = '1.0.0'\nchanges = []\n", 200)
}

test effect fn githubNeverReturnsPartialHistoryOnMissingOrInvalidPredecessors() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run incompleteHistoryClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}
