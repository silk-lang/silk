import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.bool
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.text.string { String }
import silk.testing.testing { Testing, AssertionError }
import silk.toml.scanner { TomlError }
import Change as Changes
import Change { Change }
import Manifest as Manifests
import Problem { Problem }
import Version
import Version { Bump }

effect fn expectBump(current: string, kind: Bump, expected: string) -> ()
! Problem | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let actual = run Version.bump(current, kind) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(String.view(&actual) == expected, "release arithmetic differs from the expected decimal version")
}

effect fn rejectVersion(current: string) -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let result = run Effect.result(Version.bump(current, Bump.Patch) |> Effect.provideMut<Allocator>(&mut allocator))
  match move result {
    Result<String, Problem | OutOfMemoryError>.Success { value } => {
      run Testing.expect(false, "invalid version unexpectedly produced a release")
    }
    Result<String, Problem | OutOfMemoryError>.Failure { error } => {
      match move error {
        Problem problem => { return () }
        OutOfMemoryError failure => { fail move failure }
      }
    }
  }
}

effect fn rejectChange(source: string) -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let result = run Effect.result(Changes.parse(source) |> Effect.provideMut<Allocator>(&mut allocator))
  match move result {
    Result<Change, Problem | OutOfMemoryError>.Success { value } => {
      run Testing.expect(false, "malformed changeset unexpectedly parsed")
    }
    Result<Change, Problem | OutOfMemoryError>.Failure { error } => {
      match move error {
        Problem problem => { return () }
        OutOfMemoryError failure => { fail move failure }
      }
    }
  }
}

effect fn expectManifestEdit(source: string, expected: string) -> ()
! Problem | TomlError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let owned = run String.copy(source) |> Effect.provideMut<Allocator>(&mut allocator)
  let manifest = run Manifests.parse(move owned) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(String.view(&manifest.name) == "demo", "manifest selected the wrong package name")
  run Testing.expect(String.view(&manifest.version) == "1.2.3", "manifest selected the wrong package version")
  let edited = run Manifests.replaceVersion(&manifest, "2.0.0") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(String.view(&edited) == expected, "version replacement modified bytes outside the package.version token")
}

test effect fn decimalCarryBeyondMachineIntegers() -> ()
! Problem | OutOfMemoryError | AssertionError<'static> {
  run expectBump("1.2.1299", Bump.Patch, "1.2.1300")
  run expectBump("1.999999999999999999999999999999.7", Bump.Minor, "1.1000000000000000000000000000000.0")
  run expectBump("999999999999999999999999999999.8.9", Bump.Major, "1000000000000000000000000000000.0.0")
}

test effect fn zeroMajorUsesLiteralBumpsAndDropsValidatedMetadata() -> ()
! Problem | OutOfMemoryError | AssertionError<'static> {
  run expectBump("0.9.9+build.007-a", Bump.Patch, "0.9.10")
  run expectBump("0.9.9", Bump.Minor, "0.10.0")
  run expectBump("0.9.9", Bump.Major, "1.0.0")
}

test effect fn invalidSemverCannotBecomeARelease() -> () ! OutOfMemoryError | AssertionError<'static> {
  run rejectVersion("01.2.3")
  run rejectVersion("1.02.3")
  run rejectVersion("1.2.03")
  run rejectVersion("1.2")
  run rejectVersion("1..3")
  run rejectVersion("1.2.3.4")
  run rejectVersion("1.2.3+")
  run rejectVersion("1.2.3+.build")
  run rejectVersion("1.2.3+build.")
  run rejectVersion("1.2.3+build..7")
  run rejectVersion("1.2.3+build_7")
}

test effect fn changesetCrLfKeepsInternalMarkdownBytes() -> ()
! Problem | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let parsed = run Changes.parse("---\r\nbump: minor\r\n---\r\n\r\n## Fix\r\n\r\n- item\r\n  continuation\r\n\r\n```silk\r\n  code()\r\n```\r\n") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(parsed.bump == Bump.Minor, "CRLF metadata selected the wrong bump")
  run Testing.expect(String.view(&parsed.summary) == "## Fix\r\n\r\n- item\r\n  continuation\r\n\r\n```silk\r\n  code()\r\n```", "CRLF parsing altered internal Markdown")
  let rendered = run Changes.render(Bump.Minor, String.view(&parsed.summary), "") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(String.view(&rendered) == "---\nbump: minor\n---\n\n## Fix\r\n\r\n- item\r\n  continuation\r\n\r\n```silk\r\n  code()\r\n```\n", "rendering must normalize only frontmatter and summary edges")
}

test effect fn malformedAndEmptyChangesetsAreRejected() -> () ! OutOfMemoryError | AssertionError<'static> {
  run rejectChange("")
  run rejectChange("---")
  run rejectChange("---\n---\nSummary")
  run rejectChange("---\nbump:\n---\nSummary")
  run rejectChange("---\nbump: PATCH\n---\nSummary")
  run rejectChange("---\npackage: patch\n---\nSummary")
  run rejectChange("---\nbump: patch\nbump: major\n---\nSummary")
  run rejectChange("---\nbump: patch")
  run rejectChange("---\nbump: patch\n---")
  run rejectChange("---\r\nbump: patch\r\n---\r\n \t\r\n")
}

test effect fn quotedTableVersionPreservesCommentsAndMultilineDecoys() -> ()
! Problem | TomlError | OutOfMemoryError | AssertionError<'static> {
  run expectManifestEdit(
    "# version = '1.2.3'\r\n[\"package\"]\r\nname = 'demo'\r\nnotes = '''\r\n[package]\r\nversion = '1.2.3'\r\n'''\r\n'version'  =  '1.2.3' # keep 1.2.3\r\n[other]\r\nversion = '1.2.3'\r\n",
    "# version = '1.2.3'\r\n[\"package\"]\r\nname = 'demo'\r\nnotes = '''\r\n[package]\r\nversion = '1.2.3'\r\n'''\r\n'version'  =  \"2.0.0\" # keep 1.2.3\r\n[other]\r\nversion = '1.2.3'\r\n"
  )
}

test effect fn dottedVersionDoesNotMatchAnIndivisibleQuotedKey() -> ()
! Problem | TomlError | OutOfMemoryError | AssertionError<'static> {
  run expectManifestEdit(
    "\"package.version\" = '1.2.3'\npackage.name = 'demo'\n\"package\" . 'version' = \"\"\"1.2.3\"\"\" # retain\nother.package.version = '1.2.3'\n",
    "\"package.version\" = '1.2.3'\npackage.name = 'demo'\n\"package\" . 'version' = \"2.0.0\" # retain\nother.package.version = '1.2.3'\n"
  )
}

test effect fn inlinePackageVersionIgnoresNestedInlineAndArrayDecoys() -> ()
! Problem | TomlError | OutOfMemoryError | AssertionError<'static> {
  run expectManifestEdit(
    "other = { package = { version = '1.2.3' } }\npackage = { name = 'demo', dependencies = [{ version = '1.2.3' }], 'version' = '1.2.3', note = 'version = 1.2.3' } # keep\n",
    "other = { package = { version = '1.2.3' } }\npackage = { name = 'demo', dependencies = [{ version = '1.2.3' }], 'version' = \"2.0.0\", note = 'version = 1.2.3' } # keep\n"
  )
}

test effect fn arrayTablesAndNestedHeadersDoNotCapturePackageVersion() -> ()
! Problem | TomlError | OutOfMemoryError | AssertionError<'static> {
  run expectManifestEdit(
    "[[tools]]\nversion = '1.2.3'\n[tools.package]\nname = 'decoy'\nversion = '1.2.3'\n[[tools]]\nversion = '1.2.3'\n[tools.details]\nversion = '1.2.3'\n[package]\nname = 'demo'\nversion = '1.2.3'\n[[examples]]\nversion = '1.2.3'\n[examples.package]\nversion = '1.2.3'\n",
    "[[tools]]\nversion = '1.2.3'\n[tools.package]\nname = 'decoy'\nversion = '1.2.3'\n[[tools]]\nversion = '1.2.3'\n[tools.details]\nversion = '1.2.3'\n[package]\nname = 'demo'\nversion = \"2.0.0\"\n[[examples]]\nversion = '1.2.3'\n[examples.package]\nversion = '1.2.3'\n"
  )
}
