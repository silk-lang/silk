import History
import History { Entry, Record }
import Problem { Problem }
import Text
import Version { Bump }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.bool
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.num.i32
import silk.system.filesystem_native { OsFileSystem }
import silk.core.result { Result }
import silk.text.string { String }
import silk.testing.testing { AssertionError, Testing }
import silk.num.u8
import silk.num.usize
import silk.collections.list { List }

effect fn codecClaims() -> () ! Problem | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let source = "format = 1\npackage = 'example'\nfrom = '1.9.0'\nversion = '1.10.0-beta.2'\nbase = '1.9.0'\n\n[[changes]]\nid = '1.10.0-beta.2/manual name.md'\nbump = 'minor'\nsummary = \"\"\"\n雪\n\\\"quoted\\\" \\\\ slash\\t\\r\"\"\"\nmigration = \"\"\"\nline one\nline two\\u0001\"\"\"\n\n[[changes]]\nid = '1.10.0-beta.2/unknown.md'\nbump = 'patch'\nsummary = 'Unknown impact'\n"
  let record = run History.parse(source)
  let encoded = run History.encode(&record)
  let restored = run History.parse(String.view(&encoded))
  run Testing.expect(String.view(&restored.packageName) == "example", "codec preserves package identity")
  run Testing.expect(String.view(&restored.fromVersion) == "1.9.0", "codec preserves predecessor")
  run Testing.expect(String.view(&restored.version) == "1.10.0-beta.2", "codec accepts semantic rather than lexical ordering")
  run Testing.expect(String.view(&restored.baseVersion) == "1.9.0", "codec preserves stable base")
  let entries = List<Entry>.asSlice(&restored.entries)
  run Testing.expect(entries.length == 2, "codec preserves both changes")
  run Testing.expect(String.view(&entries[0].id) == "1.10.0-beta.2/manual name.md", "IDs are opaque data including slashes and spaces")
  run Testing.expect(String.view(&entries[0].summary) == "雪\n\"quoted\" \\ slash\t\r", "TOML quoting preserves Unicode and every Markdown byte")
  run Testing.expect(Text.starts(String.view(&entries[0].migration), "line one\nline two"), "migration keeps multiline content")
  run Testing.expect(Text.byte(String.view(&entries[0].migration), String.byteLength(String.view(&entries[0].migration)) - usize.ONE) == 1,
    "TOML controls survive encoding and decoding")
  run Testing.expect(String.view(&entries[1].migration) == "", "omitted TOML migration means no action")
  let notes = run History.render(&restored)
  run Testing.expect(Text.starts(String.view(&notes), "## 1.10.0-beta.2\n\n### Minor\n\n- 雪\n  \"quoted\" \\ slash\t\r\n  - **Migration:** line one\n    line two"),
    "render retains Unicode and multiline summary and migration bodies")
  run Testing.expect(Text.ends(String.view(&notes), "\n\n### Patch\n\n- Unknown impact\n\n"),
    "render groups bump levels and leaves out empty migration notes")
  let empty = run History.parse("format = 0x0_1\npackage = 'example'\nfrom = '1.0.0'\nversion = '1.1.0'\nbase = '1.0.0'\nchanges = []\n")
  let emptyEncoded = run History.encode(&empty)
  let emptyRestored = run History.parse(String.view(&emptyEncoded))
  run Testing.expect(List<Entry>.length(&emptyRestored.entries) == usize.ZERO, "empty TOML releases remain parseable")
}

test effect fn historyCodecPreservesMarkdownAndUnknownMigration() -> ()
! Problem | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run codecClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn edgeClaims() -> () ! Problem | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let summary = "\n\n雪 ' '' ''' '''' \" \"\" \"\"\" \"\"\"\" \\ \\\\\nend\\\n\r\r\nlast\n\n"
  let mut controls = Bytes.make()
  run Bytes.append(&mut controls, b"controls:")
  let mut byte = 0
  while byte < 32 {
    let raw = [i32.toU8(byte)]
    run Bytes.append(&mut controls, &raw)
    byte = byte + 1
  }
  let del = [u8.toU8(127)]
  run Bytes.append(&mut controls, &del)
  run Bytes.append(&mut controls, b"\n\n")
  let mut entries = List<Entry>.make()
  run List<Entry>.append(&mut entries, Entry {
    id: run String.copy("1.1.0/edge.md"), bump: Bump.Minor, updated: false,
    summary: run String.copy(summary), migration: unsafe String.fromBytesUnchecked(move controls),
  })
  run List<Entry>.append(&mut entries, Entry {
    id: run String.copy("1.1.0/terminal.md"), bump: Bump.Patch, updated: false,
    summary: run String.copy("'''\"\"\""), migration: run String.copy("end\\"),
  })
  let record = Record {
    packageName: run String.copy("example"), fromVersion: run String.copy("1.0.0"),
    version: run String.copy("1.1.0"), baseVersion: run String.copy("1.0.0"), entries: move entries,
  }
  let encoded = run History.encode(&record)
  let restored = run History.parse(String.view(&encoded))
  let entry = &List<Entry>.asSlice(&restored.entries)[0]
  run Testing.expect(String.view(&entry.summary) == "\n\n雪 ' '' ''' '''' \" \"\" \"\"\" \"\"\"\" \\ \\\\\nend\\\n\r\r\nlast\n\n",
    "multiline TOML preserves delimiter runs, terminal backslashes, CR/LF, and leading/trailing newlines exactly")
  let migration = String.view(&entry.migration)
  run Testing.expect(String.byteLength(migration) == 44 && Text.starts(migration, "controls:") && Text.ends(migration, "\n\n"),
    "control-byte migration retains its independent prefix, length, and trailing newlines")
  byte = 0
  while byte < 32 {
    run Testing.expect(Text.byte(migration, i32.toUsize(byte + 9)) == byte, "every ASCII control survives TOML encoding")
    byte = byte + 1
  }
  run Testing.expect(Text.byte(migration, 41) == 127, "DEL is escaped and restored rather than emitted as invalid TOML")
  let terminal = &List<Entry>.asSlice(&restored.entries)[1]
  run Testing.expect(String.view(&terminal.summary) == "'''\"\"\"" && String.view(&terminal.migration) == "end\\",
    "terminal delimiter runs and a final backslash cannot consume the TOML closing delimiter")
}

test effect fn historyTomlPreservesDelimiterNewlineAndControlEdges() -> ()
! Problem | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run edgeClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn rejects(source: string) -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let attempted = run Effect.result(History.parse(source))
  match move attempted {
    Result<Record, Problem | OutOfMemoryError>.Success { value: unexpected } => {
      run Testing.expect(false, "malformed archive must fail with Problem")
    }
    Result<Record, Problem | OutOfMemoryError>.Failure { error } => match move error {
      Problem expected => {}
      OutOfMemoryError allocation => { fail move allocation }
    }
  }
}

effect fn validationClaims() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  run rejects("{")
  run rejects("{\"format\":1,\"package\":\"x\",\"from\":\"1.0.0\",\"version\":\"1.1.0\",\"base\":\"1.0.0\",\"changes\":[]}")
  run rejects("format = 1\nformat = 1\npackage = 'x'\nfrom = '1.0.0'\nversion = '1.1.0'\nbase = '1.0.0'\nchanges = []\n")
  run rejects("format = 2\npackage = 'x'\nfrom = '1.0.0'\nversion = '1.1.0'\nbase = '1.0.0'\nchanges = []\n")
  run rejects("format = 1.0\npackage = 'x'\nfrom = '1.0.0'\nversion = '1.1.0'\nbase = '1.0.0'\nchanges = []\n")
  run rejects("format = '1'\npackage = 'x'\nfrom = '1.0.0'\nversion = '1.1.0'\nbase = '1.0.0'\nchanges = []\n")
  run rejects("format = 1\npackage = 7\nfrom = '1.0.0'\nversion = '1.1.0'\nbase = '1.0.0'\nchanges = []\n")
  run rejects("format = 1\npackage = ' '\nfrom = '1.0.0'\nversion = '1.1.0'\nbase = '1.0.0'\nchanges = []\n")
  run rejects("format = 1\npackage = 'x'\nfrom = '1.10.0-beta.10'\nversion = '1.10.0-beta.2'\nbase = '1.9.0'\nchanges = []\n")
  run rejects("format = 1\npackage = 'x'\nfrom = '1.0.0+a'\nversion = '1.0.0+b'\nbase = '1.0.0'\nchanges = []\n")
  run rejects("format = 1\npackage = 'x'\nfrom = '1.0.0'\nversion = '../1.1.0'\nbase = '1.0.0'\nchanges = []\n")
  run rejects("format = 1\npackage = 'x'\nfrom = '1.0.0'\nversion = '1.1.0'\nbase = '1.0.0-beta.1'\nchanges = []\n")
  run rejects("format = 1\npackage = 'x'\nfrom = '1.0.0'\nversion = '1.2.0'\nbase = '1.1.0'\nchanges = []\n")
  run rejects("format = 1\npackage = 'x'\nfrom = '1.0.0'\nversion = '1.1.0'\nbase = '1.0.0'\nchanges = {}\n")
  run rejects("format = 1\npackage = 'x'\nfrom = '1.0.0'\nversion = '1.1.0'\nbase = '1.0.0'\n")
  run rejects("format = 1\npackage = 'x'\nfrom = '1.0.0'\nversion = '1.1.0'\nbase = '1.0.0'\nchanges = [7]\n")
  run rejects("format = 1\npackage = 'x'\nfrom = '1.0.0'\nversion = '1.1.0'\nbase = '1.0.0'\n[[changes]]\nid = 'a'\nbump = 'patch'\nsummary = 'a'\nmigration = false\n")
  run rejects("format = 1\npackage = 'x'\nfrom = '1.0.0'\nversion = '1.1.0'\nbase = '1.0.0'\n[[changes]]\nid = 'a'\nbump = 'patch'\nsummary = 'a'\nmigration = ''\n")
  run rejects("format = 1\npackage = 'x'\nfrom = '1.0.0'\nversion = '1.1.0'\nbase = '1.0.0'\n[[changes]]\nid = 'a'\nbump = 'patch'\nsummary = 'a'\nmigration = ' '\n")
  run rejects("format = 1\npackage = 'x'\nfrom = '1.0.0'\nversion = '1.1.0'\nbase = '1.0.0'\n[[changes]]\nid = 'a'\nbump = 'patch'\nsummary = 'a'\n[[changes]]\nid = 'a'\nbump = 'minor'\nsummary = 'b'\n")
}

test effect fn historyRejectsInvalidSchemaPrecedenceAndDuplicateIds() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run validationClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

fn temporaryRoot() -> string<'static> {
  static if Intrinsic.targetOperatingSystem() == "darwin" { return "/private/tmp" }
  else { return "/tmp" }
}

effect fn entry(id: string, summary: string) -> Entry ! OutOfMemoryError ? &mut Allocator {
  return Entry { id: run String.copy(id), bump: Bump.Minor, updated: false,
    summary: run String.copy(summary), migration: String.make() }
}

effect fn store(root: &Path, from: string, version: string, base: string, first: string, second: string) -> ()
! Problem | FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let mut entries = List<Entry>.make()
  if first != "" { run List<Entry>.append(&mut entries, run entry(first, "First")) }
  if second != "" { run List<Entry>.append(&mut entries, run entry(second, "Second")) }
  let record = Record { packageName: run String.copy("example"), fromVersion: run String.copy(from),
    version: run String.copy(version), baseVersion: run String.copy(base), entries: move entries }
  let encoded = run History.encode(&record)
  let location = run History.path(root, version)
  run FileSystem.writeFile(&location, String.utf8Bytes(String.view(&encoded)))
}

effect fn rejectedQuery(root: &Path, name: string, from: string, to: string) -> ()
! FileError | OutOfMemoryError | AssertionError<'static> ? &mut FileSystem | &mut Allocator {
  let attempted = run Effect.result(History.query(root, name, from, to))
  match move attempted {
    Result<List<Record>, Problem | FileError | OutOfMemoryError>.Success { value: unexpected } => {
      run Testing.expect(false, "query must fail explicitly instead of reporting incomplete or unrelated changes")
    }
    Result<List<Record>, Problem | FileError | OutOfMemoryError>.Failure { error } => match move error {
      Problem expected => {}
      FileError file => { fail move file }
      OutOfMemoryError allocation => { fail move allocation }
    }
  }
}

effect fn queryClaims(root: &Path) -> ()
! Problem | FileError | OutOfMemoryError | AssertionError<'static> ? &mut FileSystem | &mut Allocator {
  let changes = run Path.join(root, ".changes")
  run FileSystem.createDirectory(&changes)
  let releases = run Path.join(&changes, "releases")
  run FileSystem.createDirectory(&releases)
  let archivePath = run History.path(root, "1.10.1")
  let archiveName = unsafe String.fromUtf8Unchecked(Path.rawBytes(&archivePath))
  run Testing.expect(Text.ends(archiveName, "/.changes/releases/1.10.1.toml"), "history uses only TOML archive paths")
  let initial = "a.md"
  let added = "b.md"
  let reused = "c.md"
  run store(root, "1.9.0", "1.10.0-beta.2", "1.9.0", initial, "")
  run store(root, "1.10.0-beta.2", "1.10.0-beta.10", "1.9.0", initial, added)
  run store(root, "1.10.0-beta.10", "1.10.0", "1.9.0", initial, added)
  run store(root, "1.10.0", "1.10.1", "1.10.0", reused, "")
  let complete = run History.query(root, "example", "1.9.0", "1.10.1")
  let all = List<Record>.asSlice(&complete)
  run Testing.expect(all.length == 2, "cumulative prerelease records are omitted after stable promotion includes their entries")
  run Testing.expect(String.view(&all[0].version) == "1.10.1" && String.view(&all[1].version) == "1.10.0", "history returns newest first")
  run Testing.expect(List<Entry>.length(&all[0].entries) == 1 && List<Entry>.length(&all[1].entries) == 2,
    "independent filenames identify distinct changes across releases")
  run rejectedQuery(root, "example", "1.10.0-beta.5", "1.10.1")
  let exact = run History.query(root, "example", "1.10.0-beta.2", "1.10.0-beta.10")
  let exactRecords = List<Record>.asSlice(&exact)
  run Testing.expect(exactRecords.length == 1 && List<Entry>.length(&exactRecords[0].entries) == 1,
    "numeric prerelease identifiers compare numerically and exact baseline entries are excluded")
  run rejectedQuery(root, "example", "9.0.0", "9.0.0+metadata")
  run rejectedQuery(root, "example", "1.10.1", "1.9.0")
  run rejectedQuery(root, "other-package", "1.9.0", "1.10.1")
  let lock = run Path.join(&changes, ".lock")
  run FileSystem.createDirectory(&lock)
  run rejectedQuery(root, "example", "1.9.0", "1.10.1")
  run rejectedQuery(root, "example", "1.10.1", "1.10.1")
  let lockedLoad = run History.load(root, "1.10.1")
  run Testing.expect(String.view(&lockedLoad.version) == "1.10.1", "release owner may load an archive while holding its lock")
  run FileSystem.removeDirectory(&lock)
  let middle = run History.path(root, "1.10.0-beta.10")
  run FileSystem.removeFile(&middle)
  run rejectedQuery(root, "example", "1.9.0", "1.10.1")
  run store(root, "1.10.0-beta.2", "1.10.0-beta.10", "1.9.0", initial, added)
  let baseline = run History.path(root, "1.10.0-beta.2")
  run FileSystem.removeFile(&baseline)
  run rejectedQuery(root, "example", "1.10.0-beta.5", "1.10.1")
}

effect fn isolatedQuery() -> ()
! Problem | FileError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut files = run OsFileSystem.make(temporaryRoot())
  let parent = run Path.root()
  let root = run FileSystem.createTemporaryDirectory(&parent, b"changeset-history-")
    |> Effect.provideMut<FileSystem>(&mut files)
  let attempted = run Effect.result(queryClaims(&root)) |> Effect.provideMut<FileSystem>(&mut files)
  let cleaned = run Effect.result(FileSystem.removeDirectoryRecursively(&root)) |> Effect.provideMut<FileSystem>(&mut files)
  match move attempted {
    Result<(), Problem | FileError | OutOfMemoryError | AssertionError<'static>>.Success { value: completed } => {
      match move cleaned {
        Result<(), FileError | OutOfMemoryError>.Success { value: removed } => {}
        Result<(), FileError | OutOfMemoryError>.Failure { error } => { fail move error }
      }
    }
    Result<(), Problem | FileError | OutOfMemoryError | AssertionError<'static>>.Failure { error } => {
      drop cleaned
      fail move error
    }
  }
}

test effect fn historyQueryDeduplicatesAndRequiresCompleteCoverage() -> ()
! Problem | FileError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run isolatedQuery() |> Effect.provideMut<Allocator>(&mut allocator)
}
