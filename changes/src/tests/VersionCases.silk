import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.bool
import silk.core.effect { Effect }
import silk.num.i32
import silk.core.result { Result }
import silk.text.string { String }
import silk.testing.testing { Testing, AssertionError }
import Problem { Problem }
import Version
import Version { Bump }

effect fn expectOrder(left: string, right: string, expected: i32) -> ()
! Problem | AssertionError<'static> {
  let actual = run Version.compare(left, right)
  run Testing.expect(actual == expected, "SemVer precedence differs from the expected ordering")
}

effect fn expectRelease(current: string, target: string, tag: string, expected: string) -> ()
! Problem | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let actual = run Version.release(current, target, tag) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(String.view(&actual) == expected, "release transition differs from the expected version")
}

effect fn rejectSemver(text: string) -> () ! AssertionError<'static> {
  let result = run Effect.result(Version.validate(text))
  match move result {
    Result<(), Problem>.Success { value } => {
      run Testing.expect(false, "malformed SemVer unexpectedly validated")
    }
    Result<(), Problem>.Failure { error } => { return () }
  }
}

effect fn rejectComparison(left: string, right: string) -> () ! AssertionError<'static> {
  let result = run Effect.result(Version.compare(left, right))
  match move result {
    Result<i32, Problem>.Success { value } => {
      run Testing.expect(false, "comparison must validate both inputs before ignoring metadata")
    }
    Result<i32, Problem>.Failure { error } => { return () }
  }
}

effect fn rejectRelease(current: string, target: string, tag: string) -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let result = run Effect.result(Version.release(current, target, tag) |> Effect.provideMut<Allocator>(&mut allocator))
  match move result {
    Result<String, Problem | OutOfMemoryError>.Success { value } => {
      run Testing.expect(false, "invalid release transition unexpectedly succeeded")
    }
    Result<String, Problem | OutOfMemoryError>.Failure { error } => {
      match move error {
        Problem problem => { return () }
        OutOfMemoryError failure => { fail move failure }
      }
    }
  }
}

test effect fn semverSpecificationPrecedenceExamples() -> () ! Problem | AssertionError<'static> {
  run expectOrder("1.0.0-alpha", "1.0.0-alpha.1", -1)
  run expectOrder("1.0.0-alpha.1", "1.0.0-alpha.beta", -1)
  run expectOrder("1.0.0-alpha.beta", "1.0.0-beta", -1)
  run expectOrder("1.0.0-beta", "1.0.0-beta.2", -1)
  run expectOrder("1.0.0-beta.2", "1.0.0-beta.11", -1)
  run expectOrder("1.0.0-beta.11", "1.0.0-rc.1", -1)
  run expectOrder("1.0.0-rc.1", "1.0.0", -1)
  run expectOrder("1.0.0", "1.0.0-rc.1", 1)
  run expectOrder("1.0.0-beta.11", "1.0.0-beta.2", 1)
  run expectOrder("1.0.0-alpha.1", "1.0.0-alpha", 1)
  run expectOrder("1.0.0-alpha.beta", "1.0.0-alpha.1", 1)
  run expectOrder("1.0.0-beta", "1.0.0-alpha.beta", 1)
  run expectOrder("1.0.0-alpha", "1.0.0-alpha", 0)
  run expectOrder("1.0.0", "2.0.0", -1)
  run expectOrder("2.0.0", "2.1.0", -1)
  run expectOrder("2.1.0", "2.1.1", -1)
}

test effect fn metadataDoesNotParticipateInPrecedence() -> () ! Problem | AssertionError<'static> {
  run expectOrder("1.2.3+001", "1.2.3+other.009-a", 0)
  run expectOrder("1.2.3-beta.9+001", "1.2.3-beta.9+999", 0)
  run expectOrder("1.2.3+alpha-beta", "1.2.3", 0)
  run expectOrder("1.2.3-0+000", "1.2.3-alpha", -1)
  run expectOrder("1.2.3-A", "1.2.3-a", -1)
  run expectOrder("1.2.3--", "1.2.3-0", 1)
  run Version.validate("1.2.3-00a.0.a-b+007.00a.-")
  run Testing.expect(Version.core("1.2.3-beta.9+build") == "1.2.3", "core must omit prerelease and metadata")
  run Testing.expect(Version.core("1.2.3+build-beta") == "1.2.3", "core must omit metadata containing a hyphen")
  run Testing.expect(Version.core("1.2.3") == "1.2.3", "stable core must remain unchanged")
  run Testing.expect(Version.isPrerelease("1.2.3-beta.9+build"), "prerelease suffix must be detected")
  run Testing.expect(Version.isPrerelease("1.2.3+build-beta") == false, "hyphens in metadata must not imply prerelease")
}

test effect fn arbitraryMagnitudeHasNumericPrecedence() -> () ! Problem | AssertionError<'static> {
  run expectOrder("999999999999999999999999999999.0.0", "1000000000000000000000000000000.0.0", -1)
  run expectOrder("1.999999999999999999999999999999.0", "1.1000000000000000000000000000000.0", -1)
  run expectOrder("1.0.999999999999999999999999999999", "1.0.1000000000000000000000000000000", -1)
  run expectOrder("1.0.0-beta.999999999999999999999999999999", "1.0.0-beta.1000000000000000000000000000000", -1)
  run expectOrder("1.0.0-999999999999999999999999999999", "1.0.0-a", -1)
}

test effect fn taggedReleasesIncrementPromoteAndSwitchMonotonically() -> ()
! Problem | OutOfMemoryError | AssertionError<'static> {
  run expectRelease("1.2.3", "1.3.0", "beta", "1.3.0-beta.1")
  run expectRelease("1.3.0-beta.9", "1.3.0", "beta", "1.3.0-beta.10")
  run expectRelease("1.3.0-beta.0", "1.3.0", "beta", "1.3.0-beta.1")
  run expectRelease("1.3.0-beta.9+001", "1.3.0", "beta", "1.3.0-beta.10")
  run expectRelease("1.3.0-beta.9", "1.3.0", "rc", "1.3.0-rc.1")
  run expectRelease("1.3.0-rc.9", "2.0.0", "beta", "2.0.0-beta.1")
  run expectRelease("1.3.0-rc.9+build", "1.3.0", "", "1.3.0")
  run expectRelease("1.3.0-arbitrary.prerelease.shape", "1.3.0", "", "1.3.0")
  run expectRelease("1.3.0-arbitrary.prerelease.shape", "2.0.0", "beta", "2.0.0-beta.1")
  run expectRelease("1.3.0+build.001", "1.3.0", "", "1.3.0")
  run expectRelease("1.3.0", "1.3.0", "", "1.3.0")
  run expectRelease("1.3.0", "2.0.0", "", "2.0.0")
  run expectRelease("1.3.0", "2.0.0", "Preview-2", "2.0.0-Preview-2.1")
  run expectRelease("1.3.0-beta.999999999999999999999999999999", "1.3.0", "beta", "1.3.0-beta.1000000000000000000000000000000")
  run expectRelease("999999999999999999999999999999.0.0", "1000000000000000000000000000000.0.0", "beta", "1000000000000000000000000000000.0.0-beta.1")
}

test effect fn prereleaseBumpsUseLiteralCoreArithmetic() -> ()
! Problem | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let patch = run Version.bump("0.9.9-beta.9+001", Bump.Patch) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(String.view(&patch) == "0.9.10", "patch must increment core and drop all suffixes")
  let minor = run Version.bump("0.9.9-alpha", Bump.Minor) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(String.view(&minor) == "0.10.0", "minor must increment literally even before 1.0.0")
  let major = run Version.bump("0.9.9-0", Bump.Major) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(String.view(&major) == "1.0.0", "major must increment literally even before 1.0.0")
}

test effect fn malformedPrereleaseAndMetadataIdentifiersAreRejected() -> () ! AssertionError<'static> {
  run rejectSemver("1.2.3-")
  run rejectSemver("1.2.3-.alpha")
  run rejectSemver("1.2.3-alpha.")
  run rejectSemver("1.2.3-alpha..1")
  run rejectSemver("1.2.3-01")
  run rejectSemver("1.2.3-alpha.01")
  run rejectSemver("1.2.3-alpha.01.beta")
  run rejectSemver("1.2.3-alpha.01+001")
  run rejectSemver("1.2.3-alpha_beta")
  run rejectSemver("1.2.3-béta")
  run rejectSemver("1.2.3-alpha+")
  run rejectSemver("1.2.3-alpha+build..001")
  run rejectSemver("1.2.3-alpha+build+001")
  run rejectSemver("1.2.3-alpha+build_001")
  run rejectSemver("1.2.3-alpha+build\n")
}

test effect fn taggedReleaseRefusesInvalidShapesAndNonIncreasingTransitions() -> ()
! OutOfMemoryError | AssertionError<'static> {
  run rejectRelease("1.3.0-rc.1", "1.3.0", "beta")
  run rejectRelease("1.3.0", "1.3.0", "beta")
  run rejectRelease("2.0.0", "1.3.0", "")
  run rejectRelease("2.0.0", "1.3.0", "beta")
  run rejectRelease("1.3.0-beta", "1.3.0", "beta")
  run rejectRelease("1.3.0-beta.one", "1.3.0", "beta")
  run rejectRelease("1.3.0-beta.1.extra", "1.3.0", "beta")
  run rejectRelease("1.3.0-beta.01", "1.3.0", "beta")
  run rejectRelease("1.3.0-1.2", "1.3.0", "beta")
  run rejectRelease("1.2.3", "1.3.0", "beta.1")
  run rejectRelease("1.2.3", "1.3.0", "1")
  run rejectRelease("1.2.3", "1.3.0", "1beta")
  run rejectRelease("1.2.3", "1.3.0", "-beta")
  run rejectRelease("1.2.3", "1.3.0", "beta_1")
  run rejectRelease("1.2.3", "1.3.0", "béta")
  run rejectRelease("1.2.3", "1.3.0", "beta+build")
  run rejectRelease("1.2.3", "1.3.0+build", "beta")
  run rejectRelease("1.2.3", "1.3.0-beta.1", "")
  run rejectRelease("1.2.3", "01.3.0", "")
  run rejectRelease("not-semver", "1.3.0", "beta")
}

test effect fn comparisonValidatesBothInputsEvenWhenPrecedenceIsDecidable() -> () ! AssertionError<'static> {
  run rejectComparison("1.2.3+bad_001", "1.2.3")
  run rejectComparison("1.2.3", "1.2.3+bad_001")
  run rejectComparison("1.0.0", "2.0.0-beta.01")
  run rejectComparison("1.2.3", "1.2.3+")
}
