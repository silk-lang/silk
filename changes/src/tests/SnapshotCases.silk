import History
import History { Entry }
import Problem { Problem }
import Snapshot
import Text
import Version { Bump }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.bool
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.text.string { String }
import silk.testing.testing { AssertionError, Testing }
import silk.num.usize
import silk.collections.list { List }

const COMMIT: string<'static> = "abcdef0123456789abcdef0123456789abcdef01"

effect fn entry(id: string, migration: string) -> Entry ! OutOfMemoryError ? &mut Allocator {
  return Entry { id: run String.copy(id), bump: Bump.Minor, summary: run String.copy("A change."),
    migration: run String.copy(migration), updated: false }
}

effect fn snapshot(version: string, migration: string, include: bool) -> Snapshot.Record
! OutOfMemoryError ? &mut Allocator {
  let mut entries = List<Entry>.make()
  if include { run List<Entry>.append(&mut entries, run entry("random.md", migration)) }
  let mut kind = "stable"
  if Snapshot.isDev(version) { kind = "dev" }
  return Snapshot.Record { packageName: run String.copy("example"), version: run String.copy(version),
    kind: run String.copy(kind), commit: run String.copy(COMMIT), floor: run String.copy("0.0.0"), entries: move entries }
}

effect fn comparisons() -> () ! Problem | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let baseline = run snapshot("0.1.0-dev.8+abcdef012345", "Use the new call.", true)
  let stable = run snapshot("0.1.0", "Use the new call.", true)
  let promoted = run Snapshot.compare(&baseline, move stable, "example")
  run Testing.expect(List<History.Record>.length(&promoted) == usize.ZERO,
    "stable collection retains pending filename identity and does not repeat prior dev notes")
  let edited = run snapshot("0.1.0-dev.9+abcdef012345", "Also migrate stored values.", true)
  let changes = run Snapshot.compare(&baseline, move edited, "example")
  let records = List<History.Record>.asSlice(&changes)
  run Testing.expect(records.length == usize.ONE, "same-ID content edits remain observable")
  let entries = List<Entry>.asSlice(&records[0].entries)
  run Testing.expect(entries.length == usize.ONE && entries[0].updated
    && String.view(&entries[0].migration) == "Also migrate stored values.", "edited guidance is classified without changing its authored content")
  let markdown = run History.render(&records[0])
  run Testing.expect(Text.starts(String.view(&markdown), "## 0.1.0-dev.9+abcdef012345"), "query output retains exact dev metadata")
  let removed = run snapshot("0.1.0-dev.10+abcdef012345", "", false)
  let noRevert = run Snapshot.compare(&baseline, move removed, "example")
  run Testing.expect(List<History.Record>.length(&noRevert) == usize.ZERO, "removing notes is not a fabricated code revert")
  let known = run snapshot("0.1.0", "Use the new call.", true)
  let floor = run Snapshot.fromFloor(move known, "example", "0.0.0")
  run Testing.expect(List<History.Record>.length(&floor) == usize.ONE, "coverage floor needs no imaginary published asset")
  let unsupported = run snapshot("0.1.0", "", true)
  let rejected = run Effect.result(Snapshot.fromFloor(move unsupported, "example", "0.0.1"))
  match move rejected {
    Result<List<History.Record>, Problem | OutOfMemoryError>.Success { value } => {
      run Testing.expect(false, "an unsupported baseline must not silently become empty knowledge")
    }
    Result<List<History.Record>, Problem | OutOfMemoryError>.Failure { error } => match move error {
      Problem failure => {}
      OutOfMemoryError failure => { fail move failure }
    }
  }
}

effect fn codec() -> () ! Problem | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let version = run Snapshot.devVersion("0.1.0", "999999999999999999999", COMMIT)
  run Testing.expect(String.view(&version) == "0.1.0-dev.999999999999999999999+abcdef012345", "dev counters are exact decimal text, not machine-sized arithmetic")
  let original = run snapshot(String.view(&version), "Unicode 雪 and \"quotes\".\nNext line.", true)
  let encoded = run Snapshot.encode(&original)
  let restored = run Snapshot.parse(String.view(&encoded))
  run Testing.expect(String.view(&restored.commit) == COMMIT && String.view(&restored.floor) == "0.0.0", "snapshot retains authoritative source and coverage identities")
  run Testing.expect(String.view(&List<Entry>.asSlice(&restored.entries)[0].migration) == "Unicode 雪 and \"quotes\".\nNext line.", "snapshot codec preserves authored guidance bytes")
  let malformed = "format=1\nschema='silk.changes.snapshot'\npackage='example'\nversion='0.1.0-dev.1+000000000000'\nkind='dev'\ncommit='abcdef0123456789abcdef0123456789abcdef01'\nfloor='0.0.0'\nchanges=[]\n"
  let rejected = run Effect.result(Snapshot.parse(malformed))
  match move rejected {
    Result<Snapshot.Record, Problem | OutOfMemoryError>.Success { value } => {
      run Testing.expect(false, "snapshot version hash must match its full commit")
    }
    Result<Snapshot.Record, Problem | OutOfMemoryError>.Failure { error } => match move error {
      Problem failure => {}
      OutOfMemoryError failure => { fail move failure }
    }
  }
  let left = run snapshot("0.1.0-dev.1+abcdef012345", "First guidance", true)
  let mut right = run snapshot("0.1.0-dev.1+0123456789ab", "Changed guidance", true)
  right.commit = run String.copy("0123456789abcdef0123456789abcdef01234567")
  let exact = run Snapshot.compare(&left, move right, "example")
  run Testing.expect(List<History.Record>.length(&exact) == usize.ONE,
    "same SemVer precedence with different metadata still compares exact snapshot content")
}

test effect fn immutableSnapshotsClassifyIdentityAndContent() -> () ! Problem | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run comparisons() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn immutableSnapshotCodecValidatesExactIdentity() -> () ! Problem | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run codec() |> Effect.provideMut<Allocator>(&mut allocator)
}
