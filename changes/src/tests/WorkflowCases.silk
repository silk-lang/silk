import Change as Changes
import Dependency
import Dependency { Origin, Target }
import History
import History { Entry, Record }
import Problem { Problem }
import Release
import Version { Bump }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.bool
import silk.bytes { Bytes }
import silk.effect { Effect }
import silk.filesystem { FileError, FileSystem, Path }
import silk.os_filesystem { OsFileSystem }
import silk.result { Result }
import silk.string { String }
import silk.testing { AssertionError, Testing }
import silk.toml_scanner { TomlError }
import silk.usize
import silk.vector { Vector }

fn temporaryRoot() -> &'static [u8] {
  static if Intrinsic.targetOperatingSystem() == "darwin" { return b"/private/tmp" }
  else { return b"/tmp" }
}

effect fn pending(root: &Path, name: string, bump: Bump, summary: string, migration: string) -> ()
! Problem | FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let directory = run Path.join(root, ".changes")
  run FileSystem.createDirectoriesRecursively(&directory)
  let path = run Path.join(&directory, name)
  let text = run Changes.render(bump, summary, migration)
  run FileSystem.writeFile(&path, String.ownedUtf8Bytes(&text))
}

effect fn release(root: &Path, tag: string, expected: string) -> ()
! Problem | FileError | TomlError | OutOfMemoryError | AssertionError<'static>
? &mut FileSystem | &mut Allocator {
  let actual = run Release.version(root, tag)
  run Testing.expect(String.view(&actual) == expected, "release lifecycle selected the wrong version")
}

effect fn queryTarget(target: &Target) -> Vector<Record>
! Problem | FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  return match &target.origin {
    Origin.Local { directory } => run History.query(&directory, String.view(&target.packageName),
      String.view(&target.fromVersion), String.view(&target.toVersion))
    Origin.GitHub { repository, directory } => {
      fail Problem { message: "This local workflow requires an explicit checkout." }
    }
  }
}

effect fn rejectedTarget(result: Result<Target, Problem | FileError | TomlError | OutOfMemoryError>) -> ()
! FileError | TomlError | OutOfMemoryError | AssertionError<'static> {
  match move result {
    Result.Success { value } => { run Testing.expect(false, "an invalid upgrade target must be rejected") }
    Result.Failure { error } => match move error {
      Problem rejected => {}
      FileError failure => { fail move failure }
      TomlError failure => { fail move failure }
      OutOfMemoryError failure => { fail move failure }
    }
  }
}

effect fn claims(root: &Path) -> ()
! Problem | FileError | TomlError | OutOfMemoryError | AssertionError<'static>
? &mut FileSystem | &mut Allocator {
  let candidate = run Path.join(root, "candidate")
  run FileSystem.createDirectory(&candidate)
  let manifest = run Path.join(&candidate, "silk.toml")
  run FileSystem.writeFile(&manifest, b"[package]\nname = 'example-library'\nversion = '1.0.0'\nsource-root = 'src'\n")
  run pending(&candidate, "change.md", Bump.Minor, "Introduce async reads.", "Await read() instead of reading synchronously.")
  run release(&candidate, "beta", "1.1.0-beta.1")
  run release(&candidate, "beta", "1.1.0-beta.1")
  // Reuse the same pending filename: identities must include first release, not filename alone.
  run pending(&candidate, "change.md", Bump.Patch, "Correct timeout behavior.", "")
  run release(&candidate, "beta", "1.1.0-beta.2")
  run pending(&candidate, "breaking.md", Bump.Major, "Remove legacy reads.", "Use the asynchronous reader.")
  run release(&candidate, "beta", "2.0.0-beta.1")
  run release(&candidate, "rc", "2.0.0-rc.1")
  let refused = run Effect.result(Release.version(&candidate, "beta"))
  match move refused {
    Result<String, Problem | FileError | TomlError | OutOfMemoryError>.Success { value } => {
      run Testing.expect(false, "a prerelease channel transition must not decrease precedence")
    }
    Result<String, Problem | FileError | TomlError | OutOfMemoryError>.Failure { error } => {
      match move error {
        Problem failure => {}
        FileError failure => { fail move failure }
        TomlError failure => { fail move failure }
        OutOfMemoryError failure => { fail move failure }
      }
    }
  }
  run release(&candidate, "", "2.0.0")
  run release(&candidate, "", "2.0.0")
  let notes = run History.query(&candidate, "example-library", "1.0.0", "2.0.0")
  let releases = Vector<Record>.asSlice(&notes)
  run Testing.expect(releases.length == usize.ONE, "promotion must report each cumulative prerelease change only once")
  let entries = Vector<Entry>.asSlice(&releases[0].entries)
  run Testing.expect(entries.length == 3, "all prerelease changes must survive promotion, including reused filenames")
  run Testing.expect(String.view(&entries[0].migration) == "Await read() instead of reading synchronously.", "migration must survive prerelease carry-forward")
  run Testing.expect(String.view(&entries[1].migration) == "", "unspecified migration must remain unknown")
  let incremental = run History.query(&candidate, "example-library", "1.1.0-beta.1", "2.0.0")
  let incrementalReleases = Vector<Record>.asSlice(&incremental)
  run Testing.expect(incrementalReleases.length == usize.ONE, "query must keep the final publication")
  run Testing.expect(Vector<Entry>.length(&incrementalReleases[0].entries) == 2, "query must exclude changes already installed in the prerelease baseline")

  let installed = run Path.join(root, "installed")
  run FileSystem.createDirectory(&installed)
  let installedManifest = run Path.join(&installed, "silk.toml")
  run FileSystem.writeFile(&installedManifest, b"[package]\nname = 'example-library'\nversion = '1.0.0'\nsource-root = 'src'\n")
  let consumer = run Path.join(root, "consumer")
  run FileSystem.createDirectory(&consumer)
  let consumerManifest = run Path.join(&consumer, "silk.toml")
  run FileSystem.writeFile(&consumerManifest, b"[package]\nname = 'consumer'\nversion = '9.9.9'\nsilk-version = '2.3.0'\nsource-root = 'src'\n[dependencies]\nreader = { path = '../installed', package = 'example-library' }\n")
  let target = run Dependency.resolve(&consumer, "reader", "../candidate", "", "")
  run Testing.expect(String.view(&target.fromVersion) == "1.0.0", "dependency alias baseline comes from installed manifest")
  run Testing.expect(String.view(&target.toVersion) == "2.0.0", "candidate source provides target version")
  let byName = run Dependency.resolve(&consumer, "example-library", "../candidate", "1.1.0-beta.1", "")
  run Testing.expect(String.view(&byName.fromVersion) == "1.1.0-beta.1", "explicit baseline overrides installed version")
  let selected = run queryTarget(&target)
  run Testing.expect(Vector<Record>.length(&selected) == usize.ONE, "resolved dependency source must supply real filtered release notes")
  let wrong = run Effect.result(Dependency.resolve(&consumer, "reader", ".", "", ""))
  match move wrong {
    Result<Dependency.Target, Problem | FileError | TomlError | OutOfMemoryError>.Success { value } => {
      run Testing.expect(false, "candidate source must belong to the selected dependency")
    }
    Result<Dependency.Target, Problem | FileError | TomlError | OutOfMemoryError>.Failure { error } => {
      match move error {
        Problem failure => {}
        FileError failure => { fail move failure }
        TomlError failure => { fail move failure }
        OutOfMemoryError failure => { fail move failure }
      }
    }
  }
  run rejectedTarget(run Effect.result(Dependency.resolve(&consumer, "reader", "", "", "")))

  let compiler = run Path.join(root, "compiler-history")
  run FileSystem.createDirectory(&compiler)
  let compilerManifest = run Path.join(&compiler, "silk.toml")
  run FileSystem.writeFile(&compilerManifest, b"[package]\nname = 'silk-compiler'\nversion = '2.3.0'\n")
  run pending(&compiler, "ownership.md", Bump.Minor, "Require explicit ownership.", "Borrow the input at this boundary.")
  run release(&compiler, "", "2.4.0")
  run pending(&compiler, "diagnostic.md", Bump.Patch, "Correct diagnostic locations.", "")
  run release(&compiler, "", "2.4.1")

  let compilerTarget = run Dependency.resolve(&consumer, "", "../compiler-history", "", "2.4.0")
  let compilerNotes = run queryTarget(&compilerTarget)
  let compilerReleases = Vector<Record>.asSlice(&compilerNotes)
  run Testing.expect(String.view(&compilerTarget.fromVersion) == "2.3.0", "compiler baseline is the project's recorded version, not its package version or running compiler")
  run Testing.expect(compilerReleases.length == usize.ONE && String.view(&compilerReleases[0].version) == "2.4.0", "explicit target excludes later compiler releases present in the checkout")
  let compilerEntries = Vector<Entry>.asSlice(&compilerReleases[0].entries)
  run Testing.expect(String.view(&compilerEntries[0].migration) == "Borrow the input at this boundary.", "compiler upgrade queries retain migration guidance")

  let afterUpgrade = run Dependency.resolve(&consumer, "", "../compiler-history", "2.4.0", "")
  let remaining = run queryTarget(&afterUpgrade)
  let remainingReleases = Vector<Record>.asSlice(&remaining)
  run Testing.expect(remainingReleases.length == usize.ONE && String.view(&remainingReleases[0].version) == "2.4.1", "explicit baseline overrides the recorded compiler version")
  run rejectedTarget(run Effect.result(Dependency.resolve(&consumer, "", "../compiler-history", "2.4.1", "2.4.0")))
  run rejectedTarget(run Effect.result(Dependency.resolve(&consumer, "", "../compiler-history", "", "3.0.0")))

  run FileSystem.writeFile(&consumerManifest, b"[package]\nname = 'consumer'\nversion = '9.9.9'\n")
  run rejectedTarget(run Effect.result(Dependency.resolve(&consumer, "", "../compiler-history", "", "")))
  let supplied = run Dependency.resolve(&consumer, "", "../compiler-history", "2.4.0", "2.4.1")
  let suppliedNotes = run queryTarget(&supplied)
  run Testing.expect(Vector<Record>.length(&suppliedNotes) == usize.ONE, "an explicit baseline permits older projects without silk-version to be inspected")
}

effect fn isolated() -> ()
! Problem | FileError | TomlError | OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut files = run OsFileSystem.make(temporaryRoot())
  let parent = run Path.root()
  let root = run FileSystem.createTemporaryDirectory(&parent, b"changeset-workflow")
    |> Effect.provideMut<FileSystem>(&mut files)
  let result = run Effect.result(claims(&root)) |> Effect.provideMut<FileSystem>(&mut files)
  let cleanup = run Effect.result(FileSystem.removeDirectoryRecursively(&root)) |> Effect.provideMut<FileSystem>(&mut files)
  match move result {
    Result<(), Problem | FileError | TomlError | OutOfMemoryError | AssertionError<'static>>.Success { value } => {
      match move cleanup {
        Result<(), FileError | OutOfMemoryError>.Success { value: cleaned } => {}
        Result<(), FileError | OutOfMemoryError>.Failure { error } => { fail move error }
      }
    }
    Result<(), Problem | FileError | TomlError | OutOfMemoryError | AssertionError<'static>>.Failure { error } => {
      drop cleanup
      fail move error
    }
  }
}

test effect fn taggedReleasesRetainMigrationsAndResolveUpgradeTargets() -> ()
! Problem | FileError | TomlError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  run isolated() |> Effect.provideMut<Allocator>(&mut allocator)
}
