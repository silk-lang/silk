import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.bool
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.text.string { String }
import silk.testing.testing { Testing, AssertionError }
import Change as Changes
import Change { Change }
import Problem { Problem }
import Version { Bump }

effect fn expectParts(source: string, summary: string, migration: string) -> ()
! Problem | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let parsed = run Changes.parse(source) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(parsed.bump == Bump.Patch, "migration parsing changed bump metadata")
  run Testing.expect(String.view(&parsed.summary) == summary, "migration boundary changed the summary bytes")
  run Testing.expect(String.view(&parsed.migration) == migration, "migration notes differ from the supplied body")
}

effect fn rejectSource(source: string) -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let result = run Effect.result(Changes.parse(source) |> Effect.provideMut<Allocator>(&mut allocator))
  match move result {
    Result<Change, Problem | OutOfMemoryError>.Success { value } => {
      run Testing.expect(false, "invalid migration section unexpectedly parsed")
    }
    Result<Change, Problem | OutOfMemoryError>.Failure { error } => {
      match move error {
        Problem problem => { return () }
        OutOfMemoryError failure => { fail move failure }
      }
    }
  }
}

effect fn rejectRender(summary: string, migration: string) -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let result = run Effect.result(Changes.render(Bump.Patch, summary, migration) |> Effect.provideMut<Allocator>(&mut allocator))
  match move result {
    Result<String, Problem | OutOfMemoryError>.Success { value } => {
      run Testing.expect(false, "ambiguous or empty migration input unexpectedly rendered")
    }
    Result<String, Problem | OutOfMemoryError>.Failure { error } => {
      match move error {
        Problem problem => { return () }
        OutOfMemoryError failure => { fail move failure }
      }
    }
  }
}

test effect fn omissionIsNotAnExplicitNoImpactClaim() -> ()
! Problem | OutOfMemoryError | AssertionError<'static> {
  run expectParts("---\nbump: patch\n---\n\nRepair behavior.\n", "Repair behavior.", "")
  run expectParts("---\nbump: patch\n---\nRepair behavior.\n\n## Migration\n\nNo consumer changes are required.\n", "Repair behavior.", "No consumer changes are required.")
  let mut allocator = Allocator.systemAllocatorProvider()
  let omitted = run Changes.render(Bump.Patch, "Repair behavior.", "") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(String.view(&omitted) == "---\nbump: patch\n---\n\nRepair behavior.\n", "omitted migration fabricated a section or claim")
}

test effect fn migrationRenderingHasCanonicalBoundaryAndLosslessBodies() -> ()
! Problem | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let rendered = run Changes.render(Bump.Patch, "  Réparer 日本語\r\n\r\n- first\r\n  second  ", "\r\nRenommer café → thé.\r\n\r\n```silk\r\n  upgrade()\r\n```\r\n") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(String.view(&rendered) == "---\nbump: patch\n---\n\nRéparer 日本語\r\n\r\n- first\r\n  second\n\n## Migration\n\nRenommer café → thé.\r\n\r\n```silk\r\n  upgrade()\r\n```\n", "rendering changed Unicode, CRLF, or canonical section boundaries")
  run expectParts(String.view(&rendered), "Réparer 日本語\r\n\r\n- first\r\n  second", "Renommer café → thé.\r\n\r\n```silk\r\n  upgrade()\r\n```")
  run expectParts("---\r\nbump: patch\r\n---\r\nRésumé\r\n\r\n## Migration\r\n\r\nÉtape un\r\n  étape deux\r\n", "Résumé", "Étape un\r\n  étape deux")
}

test effect fn emptyAndDuplicateMigrationSectionsFail() -> () ! OutOfMemoryError | AssertionError<'static> {
  run rejectSource("---\nbump: patch\n---\nSummary\n## Migration")
  run rejectSource("---\nbump: patch\n---\nSummary\n## Migration\n \t\r\n")
  run rejectSource("---\nbump: patch\n---\nSummary\n## Migration\nFirst\n## Migration\nSecond")
  run rejectSource("---\nbump: patch\n---\n## Migration\nNotes without summary")
  run rejectRender("Summary", " \t\r\n")
  run rejectRender("Summary\n## Migration\nEmbedded", "Separate")
  run rejectRender("Summary", "First\n## Migration\nSecond")
  run rejectRender("Summary\n```silk\nunfinished()", "Would be swallowed by the fence")
}

test effect fn fencedExamplesDoNotBecomeMigrationSections() -> ()
! Problem | OutOfMemoryError | AssertionError<'static> {
  run expectParts("---\nbump: patch\n---\nSummary\n````markdown\n## Migration\n```\n## Migration\n~~~~\n## Migration\n```` trailing\n## Migration\n`````\n\n## Migration\nActual notes", "Summary\n````markdown\n## Migration\n```\n## Migration\n~~~~\n## Migration\n```` trailing\n## Migration\n`````", "Actual notes")
  run expectParts("---\nbump: patch\n---\nSummary\n   ~~~~ markdown\n## Migration\n~~~\n## Migration\n   ~~~~~\t\n## Migration\nReal notes\n\n~~~\n## Migration\n~~~", "Summary\n   ~~~~ markdown\n## Migration\n~~~\n## Migration\n   ~~~~~", "Real notes\n\n~~~\n## Migration\n~~~")
  run expectParts("---\nbump: patch\n---\nSummary\n```markdown\n## Migration\nUnclosed example", "Summary\n```markdown\n## Migration\nUnclosed example", "")
  let mut allocator = Allocator.systemAllocatorProvider()
  let rendered = run Changes.render(Bump.Patch, "Example:\n```markdown\n## Migration\n```", "Use:\n~~~markdown\n## Migration\n~~~") |> Effect.provideMut<Allocator>(&mut allocator)
  run expectParts(String.view(&rendered), "Example:\n```markdown\n## Migration\n```", "Use:\n~~~markdown\n## Migration\n~~~")
}

test effect fn headingRecognitionRespectsColumnAndMarkdownBoundaries() -> ()
! Problem | OutOfMemoryError | AssertionError<'static> {
  run expectParts("---\nbump: patch\n---\nSummary\n  ## Migration\n### Migration\n## Migrations\n## Migration details\n> ## Migration\n\n## Migration  ###\t\nActual notes", "Summary\n  ## Migration\n### Migration\n## Migrations\n## Migration details\n> ## Migration", "Actual notes")
  run expectParts("---\nbump: patch\n---\nSummary\n```not`a-fence\n## Migration\nActual notes", "Summary\n```not`a-fence", "Actual notes")
  run expectParts("---\nbump: patch\n---\nSummary\n    ```\n## Migration\nActual notes", "Summary\n    ```", "Actual notes")
}
