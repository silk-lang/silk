//! Single-package changesets with a nonempty Markdown summary and optional migration notes.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.bool
import silk.num.i32
import silk.text.string { String }
import silk.num.usize
import Problem { Problem }
import Text
import Version { Bump }
import Version

/// One release contribution, without a package name until monorepo support is designed.
pub struct Change {
  pub bump: Bump,
  pub summary: String,
  /// Empty means consumers need no action.
  pub migration: String,
}

fn lineEnd(text: string, start: usize) -> usize {
  let length = String.byteLength(text)
  let mut end = start
  while end < length {
    if Text.byte(text, end) == 10 { break }
    end = end + usize.ONE
  }
  return end
}

// Removes only CR from a CRLF line ending, never whitespace inside a metadata line.
fn line<'a>(text: string<'a>, start: usize, end: usize) -> string<'a> {
  if end > start {
    if Text.byte(text, end - usize.ONE) == 13 {
      return Text.part(text, start, end - usize.ONE)
    }
  }
  return Text.part(text, start, end)
}

struct Sections {
  heading: usize,
  content: usize,
  openFence: bool,
}

fn horizontalSpace(value: i32) -> bool {
  return value == 32 || value == 9
}

fn migrationHeading(text: string) -> bool {
  let prefix = "## Migration"
  if Text.starts(text, prefix) == false { return false }
  let length = String.byteLength(text)
  let mut cursor = String.byteLength(prefix)
  if cursor == length { return true }
  if horizontalSpace(Text.byte(text, cursor)) == false { return false }
  while cursor < length {
    if horizontalSpace(Text.byte(text, cursor)) == false { break }
    cursor = cursor + usize.ONE
  }
  while cursor < length {
    if Text.byte(text, cursor) != 35 { break }
    cursor = cursor + usize.ONE
  }
  while cursor < length {
    if horizontalSpace(Text.byte(text, cursor)) == false { return false }
    cursor = cursor + usize.ONE
  }
  return true
}

// Scan the original lines, not trimmed lines: headings are reserved only at column zero.
// Markdown fences allow up to three leading spaces. A shorter fence, another marker,
// or a closing candidate with an info string cannot terminate an existing fence.
effect fn sections(text: string) -> Sections ! Problem {
  let length = String.byteLength(text)
  let mut heading = length
  let mut content = length
  let mut fenceMarker = 0
  let mut fenceLength = usize.ZERO
  let mut start = usize.ZERO
  while start < length {
    let end = lineEnd(text, start)
    let current = line(text, start, end)
    let count = String.byteLength(current)
    let mut indent = usize.ZERO
    while indent < count && indent < 4 {
      if Text.byte(current, indent) != 32 { break }
      indent = indent + usize.ONE
    }
    if indent < count && indent < 4 {
      let marker = Text.byte(current, indent)
      if marker == 96 || marker == 126 {
        let mut after = indent
        while after < count {
          if Text.byte(current, after) != marker { break }
          after = after + usize.ONE
        }
        let runLength = after - indent
        if fenceLength != usize.ZERO {
          if marker == fenceMarker && runLength >= fenceLength {
            let mut clean = true
            let mut cursor = after
            while cursor < count {
              if horizontalSpace(Text.byte(current, cursor)) == false { clean = false }
              cursor = cursor + usize.ONE
            }
            if clean { fenceLength = usize.ZERO }
          }
        } else {
          if runLength >= 3 {
            let mut valid = true
            let mut cursor = after
            while cursor < count {
              if marker == 96 && Text.byte(current, cursor) == 96 { valid = false }
              cursor = cursor + usize.ONE
            }
            if valid {
              fenceMarker = marker
              fenceLength = runLength
            }
          }
        }
      }
    }
    if fenceLength == usize.ZERO && migrationHeading(current) {
      if heading != length { fail Problem { message: "changeset must contain at most one ## Migration section" } }
      heading = start
      content = end
      if end < length { content = end + usize.ONE }
    }
    if end == length { break }
    start = end + usize.ONE
  }
  return Sections { heading: heading, content: content, openFence: fenceLength != usize.ZERO }
}

/// Parses three-line frontmatter using LF or CRLF. Exactly one `bump:` field is required.
/// A column-zero `## Migration` heading outside fenced code separates optional migration notes.
/// Missing notes remain unspecified; an explicit empty or duplicate section fails. Body-edge
/// whitespace is trimmed; internal Markdown, Unicode, and line endings remain unchanged.
pub effect fn parse(text: string) -> Change ! Problem | OutOfMemoryError ? &mut Allocator {
  let length = String.byteLength(text)
  let openingEnd = lineEnd(text, usize.ZERO)
  if line(text, usize.ZERO, openingEnd) != "---" {
    fail Problem { message: "changeset must begin with a --- frontmatter delimiter" }
  }
  if openingEnd == length { fail Problem { message: "changeset is missing bump metadata" } }
  let metadataStart = openingEnd + usize.ONE
  let metadataEnd = lineEnd(text, metadataStart)
  let metadata = line(text, metadataStart, metadataEnd)
  if Text.starts(metadata, "bump:") == false {
    fail Problem { message: "changeset frontmatter must contain only a bump field" }
  }
  let prefixLength = String.byteLength("bump:")
  let kind = run Version.parseBump(Text.trim(Text.part(metadata, prefixLength, String.byteLength(metadata))))
  if metadataEnd == length { fail Problem { message: "changeset is missing its closing frontmatter delimiter" } }
  let closingStart = metadataEnd + usize.ONE
  let closingEnd = lineEnd(text, closingStart)
  if line(text, closingStart, closingEnd) != "---" {
    fail Problem { message: "changeset requires exactly one metadata line followed by ---" }
  }
  if closingEnd == length { fail Problem { message: "changeset summary must not be empty" } }
  let body = Text.part(text, closingEnd + usize.ONE, length)
  let boundaries = run sections(body)
  let summary = Text.trim(Text.part(body, usize.ZERO, boundaries.heading))
  if String.byteLength(summary) == usize.ZERO { fail Problem { message: "changeset summary must not be empty" } }
  let migration = Text.trim(Text.part(body, boundaries.content, String.byteLength(body)))
  if boundaries.heading < String.byteLength(body) && String.byteLength(migration) == usize.ZERO {
    fail Problem { message: "an explicit ## Migration section must not be empty" }
  }
  let ownedSummary = run String.copy(summary)
  let ownedMigration = run String.copy(migration)
  return Change { bump: kind, summary: move ownedSummary, migration: move ownedMigration }
}

/// Emits canonical LF frontmatter and an optional `## Migration` section.
/// Empty migration means consumers need no action; whitespace-only notes fail.
/// Summary and migration must be separate arguments, without reserved headings outside fences.
/// Only body-edge whitespace is removed; internal Markdown is preserved byte for byte.
pub effect fn render(kind: Bump, summary: string, migration: string) -> String ! Problem | OutOfMemoryError ? &mut Allocator {
  let body = Text.trim(summary)
  if String.byteLength(body) == usize.ZERO { fail Problem { message: "changeset summary must not be empty" } }
  let boundaries = run sections(body)
  if boundaries.heading < String.byteLength(body) {
    fail Problem { message: "pass migration notes separately instead of embedding a ## Migration section in the summary" }
  }
  let notes = Text.trim(migration)
  if String.byteLength(migration) != usize.ZERO && String.byteLength(notes) == usize.ZERO {
    fail Problem { message: "migration notes must not be whitespace-only" }
  }
  if String.byteLength(notes) != usize.ZERO {
    if boundaries.openFence {
      fail Problem { message: "close the summary's fenced code block before adding migration notes" }
    }
    let noteBoundaries = run sections(notes)
    if noteBoundaries.heading < String.byteLength(notes) {
      fail Problem { message: "migration notes must not contain another ## Migration section" }
    }
  }
  let mut output = run String.copy("---\nbump: ")
  run String.append(&mut output, Version.label(kind))
  run String.append(&mut output, "\n---\n\n")
  run String.append(&mut output, body)
  if String.byteLength(notes) != usize.ZERO {
    run String.append(&mut output, "\n\n## Migration\n\n")
    run String.append(&mut output, notes)
  }
  run String.append(&mut output, "\n")
  return move output
}
