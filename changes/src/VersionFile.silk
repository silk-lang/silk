//! Canonical package-relative version modules, shared by release writes and validation.
import Problem { Problem }
import Text
import Version
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.bool
import silk.collections.bytes { Bytes }
import silk.system.filesystem { DirectoryInfo, FileError, FileInfo, FileSystem, Path }
import silk.num.i32
import silk.core.option { Option }
import silk.core.result { Result }
import silk.text.string { InvalidUtf8, String }
import silk.num.usize

fn changesState(component: string) -> bool {
  if String.byteLength(component) != 8 { return false }
  let mut index = usize.ZERO
  while index < 8 {
    let mut byte = Text.byte(component, index)
    if byte >= 65 && byte <= 90 { byte = byte + 32 }
    if byte != Text.byte(".changes", index) { return false }
    index = index + usize.ONE
  }
  return true
}

/// Rejects non-normalized paths, platform escapes, and changes' own transaction state.
pub effect fn validatePath(relative: string) -> () ! Problem {
  let length = String.byteLength(relative)
  if length <= 5 || Text.ends(relative, ".silk") == false {
    fail Problem { message: "release.version-file must name a package-relative .silk source file." }
  }
  let mut start = usize.ZERO
  let mut index = usize.ZERO
  while index <= length {
    if index == length || Text.byte(relative, index) == 47 {
      let component = Text.part(relative, start, index)
      if component == "" || component == "." || component == ".." || changesState(component) {
        fail Problem { message: "release.version-file must be normalized, stay inside the package, and avoid .changes state." }
      }
      start = index + usize.ONE
    } else {
      let byte = Text.byte(relative, index)
      if byte < 32 || byte == 127 || byte == 92 || byte == 58 {
        fail Problem { message: "changes.version-file contains an unsafe path byte." }
      }
    }
    index = index + usize.ONE
  }
}

/// The version is validated before insertion into a byte literal; SemVer needs no escaping.
pub effect fn render(version: string) -> String ! Problem | OutOfMemoryError ? &mut Allocator {
  run Version.validate(version)
  let prefix = "// Auto-generated by silk change version. Do not edit.\npub fn value() -> &'static [u8] {\n  return b\""
  let suffix = "\"\n}\n"
  let mut source = Bytes.make()
  run Bytes.reserveExact(&mut source, String.byteLength(prefix) + String.byteLength(version) + String.byteLength(suffix))
  run Bytes.append(&mut source, String.utf8Bytes(prefix))
  run Bytes.append(&mut source, String.utf8Bytes(version))
  run Bytes.append(&mut source, String.utf8Bytes(suffix))
  return unsafe String.fromBytesUnchecked(move source)
}

/// Uses the provider's confinement and symlink policy. Never creates unjournaled parents.
pub effect fn path(root: &Path, relative: string) -> Path
! Problem | FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  run validatePath(relative)
  let destination = run Path.join(root, relative)
  let parent = match move run Path.parent(&destination) {
    Option<Path>.Some { value } => move value
    Option<Path>.None => { fail Problem { message: "Version source must have an existing parent directory." } }
  }
  match move run FileSystem.stat(&parent) {
    DirectoryInfo directory => {}
    FileInfo file => { fail Problem { message: "Version source parent must be a directory." } }
  }
  return move destination
}

/// Missing sources are permitted before the first version operation, never for publication.
/// Existing content must be exactly our generated source for the current manifest version.
pub effect fn read(root: &Path, relative: string, version: string, required: bool) -> Option<String>
! Problem | FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  if relative == "" { return Option<String>.None }
  let destination = run path(root, relative)
  if (run FileSystem.exists(&destination)) == false {
    if required { fail Problem { message: "The configured version source is missing; prepare and commit it before publication." } }
    return Option<String>.None
  }
  let bytes = run FileSystem.readFile(&destination)
  let source = match move String.fromBytes(move bytes) {
    Result<String, InvalidUtf8>.Success { value } => move value
    Result<String, InvalidUtf8>.Failure { error } => {
      fail Problem { message: "The configured version source is not canonical generated UTF-8 source." }
    }
  }
  let expected = run render(version)
  if String.view(&source) != String.view(&expected) {
    fail Problem { message: "The configured version source differs from the generated current version; refusing to overwrite manual or stale source." }
  }
  return Option<String>.Some { value: move source }
}
