//! Native authenticated HTTPS with explicit PEM trust and an 8 MiB response ceiling.
//!
//! Requests go through `silk.http.client_native.NativeHttp`. Trust comes from SSL_CERT_FILE or
//! the platform PEM bundle and is checked on the first request. At most five redirects, each
//! authenticating its own destination; HTTPS downgrades, credentials in a Location, and
//! cross-origin credentials are refused. No proxies, retries, or caches.
import Http { Http, HttpError, Response }
import Problem { Problem }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.effect { Effect }
import silk.system.host_input { HostInput, HostInputError }
import silk.http.client { Http as Client, HttpCause, HttpError as ClientError, Request }
import silk.http.client_native { NativeHttp }
import silk.core.result { Result }
import silk.text.string { String }
import silk.num.u16
import silk.num.usize

const MAX_BODY_BYTES: usize = 8388608
const MAX_REDIRECTS: usize = 5

/// Owns the native client and its trust configuration, never a borrowed environment value.
pub struct Native {
  http: NativeHttp<'static>,
}

/// Selects SSL_CERT_FILE or the platform PEM bundle without reading files or opening sockets.
/// Relative caller paths are anchored to the captured native working directory.
pub effect fn make() -> Native
! Problem | HostInputError | OutOfMemoryError ? &mut HostInput | &mut Allocator {
  let configured = run Effect.result(NativeHttp<'static>.fromEnvironment())
  return match move configured {
    Result.Success { value } => Native { http: value.maxBodyBytes(MAX_BODY_BYTES).maxRedirects(MAX_REDIRECTS) }
    Result.Failure { error } => match move error {
      ClientError failure => { fail Problem { message: failure.message } }
      HostInputError failure => { fail move failure }
      OutOfMemoryError exhausted => { fail move exhausted }
    }
  }
}

fn secure(url: string) -> bool {
  let bytes = String.utf8Bytes(url)
  let prefix = b"https://"
  if bytes.length < prefix.length { return false }
  let mut index = usize.ZERO
  while index < prefix.length {
    if bytes[index] != prefix[index] { return false }
    index = index + usize.ONE
  }
  return true
}

impl Http for Native {
  effect fn get(self: &mut Self, url: string) -> Response
  ! Problem | HttpError | OutOfMemoryError ? &mut Allocator {
    if !secure(url) { fail Problem { message: "Release history requires authenticated HTTPS." } }
    let result = run Effect.result(Client.send(Request.get(url)) |> Effect.provideMut<Client>(&mut self.http))
    return match move result {
      Result.Success { value } => {
        let status = u16.toI32(value.status())
        return Response { status: status, body: value.intoBody() }
      }
      Result.Failure { error } => match move error {
        OutOfMemoryError exhausted => { fail move exhausted }
        ClientError failure => {
          let ClientError { kind, message, status, cause } = move failure
          return match move cause {
            HttpCause.Tls { error: connection } => { fail HttpError.Tls { error: move connection } }
            HttpCause.Trust { error: trust } => { fail HttpError.Trust { error: move trust } }
            _ => { fail Problem { message: message } }
          }
        }
      }
    }
  }
}
