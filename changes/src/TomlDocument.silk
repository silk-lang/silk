//! Formatted TOML output for release manifests, records, and snapshots.
import Problem { Problem }
import silk.core.effect { Effect }
import silk.core.result { Result }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.text.string { String }
import silk.toml.format { TomlFormat }
import silk.toml.scanner { TomlError }

/// Formats TOML while preserving comments and value spellings. Invalid input fails with `Problem`;
/// allocation failure returns `OutOfMemoryError`. The input remains unchanged.
pub effect fn format(source: string) -> String
  ! Problem | OutOfMemoryError
  ? &mut Allocator {
  return match move run Effect.result(TomlFormat.format(source)) {
    Result<String, TomlError | OutOfMemoryError>.Success { value } => move value
    Result<String, TomlError | OutOfMemoryError>.Failure { error } => match move error {
      TomlError _invalid => {
        fail Problem { message: "Cannot write invalid TOML." }
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
}
