//! Native `silk change` adapter, including compiler/dependency upgrade history from GitHub.
//!
//! Author: `silk change minor "Change behavior" --migration "Update callers as follows..."`.
//! Summaries are one line. Migration notes are only for changes that consumers must act on.
//! Commit pending .changes/*.md alongside source. `status --tag beta` previews a prerelease;
//! `version --tag beta` starts/advances it. `version --tag rc` switches channels; `version`
//! promotes to stable. Pending changes are consumed at each step; earlier prerelease notes carry
//! forward to promotion. A new larger bump can raise the prerelease's target core version.
//!
//! Commit silk.toml, CHANGELOG.md, .changes/releases/*.toml, and removed pending files together.
//! TOML release records are authoritative. Each release regenerates the Markdown changelog;
//! manual Markdown edits are overwritten. Edit release records to correct published notes.
//! Optional [release] version-file generates a committed .silk version module in the same journal.
//! `release [--json]` exports read-only publication metadata for the current prepared release;
//! it requires consumed pending notes and complete supported TOML history. It never publishes to Git.
//! `snapshot --commit SHA [--dev N] [--json]` exports an immutable, read-only release snapshot.
//! Dev snapshots project the next stable version without consuming pending notes or editing files.
//! `since` starts at package.silk-version and discovers an eligible published compiler release.
//! `since mylib` starts at that direct dependency's installed version; --to selects an exact release.
//! `since 1.2.0` keeps querying this package's local history. --source selects a checkout or snapshot
//! TOML file relative to the consuming project root. Snapshot baselines are sibling <version>.toml
//! files, except the exact coverage floor. Checkout snapshots live in .changes/snapshots.
//! --from overrides compiler/dependency baselines. Dev versions never fall back to stable history.
//! --json is structured output for agents. Missing history is an error, never 'no changes'.
//!
//! Root discovery: silk change [--dir PATH] <command>. Select a package, not a virtual workspace.
//! Recover only after stopping other writers. Library consumers can import changeset.Release
//! or changeset.History; the native compiler calls runHost with its ambient allocator.
//! Tests: `silk test --root src/tests.silk --no-cache`.
import Dependency
import Dependency { Origin, Target }
import GitHub
import History
import History { Record }
import Http { Http, HttpError, reportError }
import HttpNative
import Problem { Problem }
import Release
import Release { Pending }
import Text
import Version
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.bool
import silk.cli.command { Command, CommandLine, Opt }
import silk.cli.parse { Cli, Parsed, Variable }
import silk.collections.bytes { Bytes }
import silk.collections.slice { Slice }
import silk.core.effect { Effect }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.text.format { Format }
import silk.system.host_input { HostInput, HostInputError }
import silk.num.i32
import silk.json.output { JsonOutput }
import silk.core.option { Option }
import silk.system.filesystem_machine { MachineFileSystem }
import silk.system.random_native { OsRandom }
import silk.io.writer_native { StderrWriter, StdoutWriter }
import silk.system.random { Random }
import silk.core.result { Result }
import silk.text.string { String, InvalidUtf8 }
import silk.toml.scanner { TomlError }
import silk.toml.value { Toml, Value }
import silk.num.usize
import silk.collections.list { List }
import silk.io.writer { Writer, WriterError }

/// The `silk change` command line.
struct ChangeLine {
  pub dir: Option<Bytes>,
  pub command: ChangeAction,
}

/// The commands of `silk change`.
union ChangeAction {
  Patch { pub summary: String, pub migration: Option<String> },
  Minor { pub summary: String, pub migration: Option<String> },
  Major { pub summary: String, pub migration: Option<String> },
  Status { pub tag: Option<String> },
  Version { pub tag: Option<String> },
  Release { pub json: bool },
  Snapshot { pub commit: String, pub dev: Option<String>, pub json: bool },
  Since {
    pub selector: Option<String>,
    pub to: Option<String>,
    pub from: Option<String>,
    pub source: Option<String>,
    pub json: bool,
  },
  Recover,
}

impl CommandLine for ChangeLine {
  static fn command() -> Command<ChangeLine> {
    return Command<ChangeLine>.make(
      "silk change",
      "Record release notes and prepare releases. No Git operations.\nEach patch, minor or major creates an independent .changes/<random>.md file.\nTOML records in .changes/releases are authoritative; commit them with the changelog.\nCHANGELOG.md is regenerated on each release; manual edits will be overwritten.\nOptional [release] version-file generates a committed package-relative .silk module.\nHTTPS uses SSL_CERT_FILE when set, otherwise the platform PEM certificate bundle.",
    )
      |> Command.option("dir", Opt.about("The package; at a virtual workspace root, a member"))
      |> Command.subcommand("command")
  }
}

impl CommandLine for ChangeAction {
  static fn command() -> Command<ChangeAction> {
    return Command<ChangeAction>.make("", "")
      |> Command.variant("Patch", "Record a patch change")
      |> Command.variant("Minor", "Record a minor change")
      |> Command.variant("Major", "Record a major change")
      |> Command.variant("Status", "Preview the next version and the pending changes")
      |> Command.variant(
        "Version",
        "Consume the pending changes and write the next version; without --tag, promote a prerelease to stable",
      )
      |> Command.variant(
        "Release",
        "Export read-only publication metadata of the prepared release, Markdown notes by default",
      )
      |> Command.variant(
        "Snapshot",
        "Export an immutable, read-only release snapshot as TOML, without consuming pending notes",
      )
      |> Command.variant(
        "Since",
        "List the changes after a compiler, dependency or package version, from package.silk-version by default",
      )
      |> Command.variant("Recover", "Roll back interrupted writes; stop all other writers first")
      |> Command.arg("summary", Opt.about("One line for the release notes") |> Opt.required)
      |> Command.option(
        "migration",
        Opt.about("What consumers must change in code or builds, only when they must"),
      )
      |> Command.option("tag", Opt.about("A SemVer prerelease channel, such as beta or rc"))
      |> Command.option("json", Opt.about("Write JSON for agents"))
      |> Command.option(
        "commit",
        Opt.about("The full 40-character lowercase hexadecimal source commit") |> Opt.required,
      )
      |> Command.option(
        "dev",
        Opt.about("Project a dev release with this positive decimal counter"),
      )
      |> Command.arg("selector", Opt.about("A version of this package, or a dependency name"))
      |> Command.option("to", Opt.about("The exact release to end at, build metadata included"))
      |> Command.option("from", Opt.about("The compiler or dependency baseline"))
      |> Command.option(
        "source",
        Opt.about("A checkout or snapshot TOML file, relative to the project root"),
      )
  }
}

// The text of `value`, or "" when it is not given.
fn textOf(value: &Option<String>) -> string {
  return match &value.* {
    Option<String>.Some { value: given } => String.view(&given)
    Option<String>.None => ""
  }
}

// Fails when `value` is given but empty.
effect fn nonempty(value: &Option<String>, message: string<'static>) -> ()
  ! Problem {
  if Option<String>.isSome(value) && textOf(value) == "" {
    fail Problem { message: message }
  }
}

effect fn summaryReminder(summary: string) -> ()
  ! WriterError {
  let mut multiline = false
  let mut index = usize.ZERO
  while index < String.byteLength(summary) {
    if Text.byte(summary, index) == 10 {
      multiline = true
    }
    index = index + usize.ONE
  }
  if multiline == false && String.byteLength(summary) <= 160 {
    return ()
  }
  let mut stderr = StderrWriter.make()
  run Writer.writeAll(
    b"silk change: keep the summary to one short line; details belong in the docs.\n",
  )
    |> Effect.provideMut<Writer>(&mut stderr)
}

effect fn addCommand(
  root: &Path,
  label: string,
  summary: &String,
  migration: &Option<String>,
) -> i32
  ! Problem | FileError | TomlError | OutOfMemoryError | WriterError
  ? &mut FileSystem | &mut Random | &mut Allocator | &mut Writer {
  let kind = run Version.parseBump(label)
  let guidance = textOf(migration)
  if Option<String>.isSome(migration) && Text.trim(guidance) == "" {
    fail Problem { message: "An explicit --migration value must not be empty." }
  }
  let path = run Release.add(root, kind, String.view(summary), guidance)
  run Format.format(
    "Created {path}\n",
    &.{ path: Option<string>.unwrapOr(Path.view(&path), "<non-UTF-8 path>") },
  )
  run summaryReminder(String.view(summary))
  return 0
}

effect fn releaseCommand(root: &Path, chosen: &Option<String>, apply: bool) -> i32
  ! Problem | FileError | TomlError | OutOfMemoryError | WriterError
  ? &mut FileSystem | &mut Allocator | &mut Writer {
  run nonempty(chosen, "--tag requires a nonempty prerelease identifier.")
  let tag = textOf(chosen)
  if apply {
    let next = run Release.version(root, tag)
    run Format.format("Version: {version}\n", &.{ version: String.view(&next) })
    return 0
  }
  let plan = run Release.plan(root, tag)
  let pending = List<Pending>.asSlice(&plan.pending)
  run Format.format(
    "{name}: {current} -> {next}\n",
    &.{
      name: String.view(&plan.manifest.name),
      current: String.view(&plan.manifest.version),
      next: String.view(&plan.release.version),
    },
  )
  let mut migrating = usize.ZERO
  let mut at = usize.ZERO
  while at < pending.length {
    run Format.format(
      "  {bump} {path}\n",
      &.{
        bump: Version.label(pending[at].bump),
        path: Option<string>.unwrapOr(Path.name(&pending[at].path), "<non-UTF-8 path>"),
      },
    )
    if pending[at].hasMigration {
      migrating = migrating + usize.ONE
    }
    at = at + usize.ONE
  }
  if pending.length == usize.ZERO {
    run Writer.writeAll(b"No pending changes.\n")
  }
  if migrating == usize.ONE {
    run Writer.writeAll(b"1 pending change needs consumers to migrate.\n")
  } else if migrating > usize.ONE {
    run Format.format(
      "{count} pending changes need consumers to migrate.\n",
      &.{ count: migrating },
    )
  }
  return 0
}

effect fn snapshotCommand(root: &Path, commit: &String, dev: &Option<String>, json: bool) -> i32
  ! Problem | FileError | TomlError | OutOfMemoryError | WriterError
  ? &mut FileSystem | &mut Allocator | &mut Writer {
  if String.view(commit) == "" {
    fail Problem { message: "Snapshot option values must not be empty." }
  }
  run nonempty(dev, "Snapshot option values must not be empty.")
  run Release.writeSnapshot(root, String.view(commit), textOf(dev), json)
  return 0
}

effect fn queryTarget(target: &mut Target) -> List<Record>
  ! Problem | HttpError | FileError | HostInputError | OutOfMemoryError
  ? &mut FileSystem | &mut HostInput | &mut Allocator {
  return match &target.origin {
    Origin.Local { .. } => run Dependency.queryLocal(&target.*)
    Origin.Snapshot { .. } => run Dependency.queryLocal(&target.*)
    Origin.GitHub { repository, directory } => {
      let mut http = run HttpNative.make()
      let publication = run GitHub.resolve(
        String.view(&repository),
        String.view(&directory),
        String.view(&target.toVersion),
        String.view(&target.fromVersion),
      )
        |> Effect.provideMut<Http>(&mut http)
      let records = run GitHub.query(
        &publication,
        String.view(&target.packageName),
        String.view(&target.fromVersion),
      )
        |> Effect.provideMut<Http>(&mut http)
      target.toVersion = move publication.version
      return move records
    }
  }
}

effect fn sinceCommand(
  root: &Path,
  selector: &Option<String>,
  to: &Option<String>,
  from: &Option<String>,
  source: &Option<String>,
  json: bool,
) -> i32
  ! Problem | HttpError | FileError | TomlError | HostInputError | OutOfMemoryError | WriterError
  ? &mut FileSystem | &mut HostInput | &mut Allocator | &mut Writer {
  run nonempty(selector, "An explicit since selector must not be empty.")
  run nonempty(to, "since option values must not be empty.")
  run nonempty(from, "since option values must not be empty.")
  run nonempty(source, "since option values must not be empty.")
  let mut target = run Dependency.resolve(
    root,
    textOf(selector),
    textOf(source),
    textOf(from),
    textOf(to),
  )
  let records = run queryTarget(&mut target)
  let releases = List<Record>.asSlice(&records)
  let mut at = usize.ZERO
  if json {
    run Writer.writeAll(b"{\"package\":")
    run JsonOutput.writeString(String.view(&target.packageName))
    run Writer.writeAll(b",\"from\":")
    run JsonOutput.writeString(String.view(&target.fromVersion))
    run Writer.writeAll(b",\"to\":")
    run JsonOutput.writeString(String.view(&target.toVersion))
    run Writer.writeAll(b",\"releases\":[")
    while at < releases.length {
      if at != usize.ZERO {
        run Writer.writeAll(b",")
      }
      let encoded = run History.encodeJson(&releases[at])
      run Writer.writeAll(String.ownedUtf8Bytes(&encoded))
      at = at + usize.ONE
    }
    run Writer.writeAll(b"]}\n")
  } else {
    run Format.format(
      "# {name}: changes after {from} through {to}\n\n",
      &.{
        name: String.view(&target.packageName),
        from: String.view(&target.fromVersion),
        to: String.view(&target.toVersion),
      },
    )
    if releases.length == usize.ZERO {
      run Writer.writeAll(b"No new recorded change entries in this range.\n")
    }
    while at < releases.length {
      let rendered = run History.render(&releases[at])
      run Writer.writeAll(String.ownedUtf8Bytes(&rendered))
      at = at + usize.ONE
    }
  }
  return 0
}

effect fn requireRecoveryPackage(root: &Path) -> ()
  ! Problem | FileError | TomlError | OutOfMemoryError
  ? &mut FileSystem | &mut Allocator {
  let manifest = run Path.join(root, "silk.toml")
  let source = run FileSystem.readFile(&manifest)
  let parsed = run Effect.result(Toml.parse(Bytes.asSlice(&source)))
  let document = match move parsed {
    Result<Value, TomlError | OutOfMemoryError>.Success { value } => move value
    Result<Value, TomlError | OutOfMemoryError>.Failure { error } => match move error {
      // Recovery must be able to restore a manifest left partially written.
      TomlError _invalid => {
        return ()
      }
      OutOfMemoryError exhausted => {
        fail move exhausted
      }
    }
  }
  if let Option<&Value>.None = move Toml.field(&document, "package") {
    if let Option<&Value>.Some { value: _ } = move Toml.field(&document, "workspace") {
      fail Problem {
        message: "This is a virtual workspace, not a release package. Select a member with silk change --dir PATH, or run from a member directory.",
      }
    }
  }
}

effect fn command() -> i32
  ! Problem | HttpError | FileError | TomlError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut FileSystem | &mut Random | &mut Allocator | &mut Writer {
  let owned = run HostInput.arguments()
  let args = List<Bytes>.asSlice(&owned)
  if args.length <= 2 {
    run Cli.writeHelp<ChangeLine>("")
    return 0
  }

  // `silk change ...`: the parser skips `change` as the program name.
  let none: [Variable<'static>; 0] = []
  let parsed = run Cli.parseBytes<ChangeLine>(
    Slice.view<Bytes>(args, usize.ONE, args.length - usize.ONE),
    &none,
  )
  let line = match move parsed {
    Parsed.Run { value } => move value
    Parsed.Help { command } => {
      run Cli.writeHelp<ChangeLine>(command)
      return 0
    }
    Parsed.Version => {
      run Cli.writeHelp<ChangeLine>("")
      return 0
    }
    Parsed.Failed { error } => {
      let mut stderr = StderrWriter.make()
      run Cli.writeError(&error) |> Effect.provideMut<Writer>(&mut stderr)
      run Writer.writeAll(b"Run silk change --help for usage.\n")
        |> Effect.provideMut<Writer>(&mut stderr)
      return 2
    }
  }
  let cwd = run HostInput.workingDirectory()
  let mut start = run workingPath(Bytes.asSlice(&cwd))
  if let Option<Bytes>.Some { value: selected } = &line.dir {
    let path = match String.fromUtf8(Bytes.asSlice(&selected)) {
      Result<string, InvalidUtf8>.Success { value } => value
      Result<string, InvalidUtf8>.Failure { error: _ } => {
        fail Problem { message: "Arguments must be valid UTF-8." }
      }
    }
    if path == "" {
      fail Problem { message: "--dir requires a nonempty path." }
    }
    let resolved = run Dependency.resolvePath(&start, path)
    start = move resolved
  }
  let root = run Release.discover(&start)
  return match &line.command {
    ChangeAction.Patch { summary, migration } => run addCommand(
      &root,
      "patch",
      &summary,
      &migration,
    )
    ChangeAction.Minor { summary, migration } => run addCommand(
      &root,
      "minor",
      &summary,
      &migration,
    )
    ChangeAction.Major { summary, migration } => run addCommand(
      &root,
      "major",
      &summary,
      &migration,
    )
    ChangeAction.Status { tag } => run releaseCommand(&root, &tag, false)
    ChangeAction.Version { tag } => run releaseCommand(&root, &tag, true)
    ChangeAction.Release { json } => {
      run Release.writeRelease(&root, json)
      return 0
    }
    ChangeAction.Snapshot { commit, dev, json } => run snapshotCommand(&root, &commit, &dev, json)
    ChangeAction.Since { selector, to, from, source, json } => run sinceCommand(
      &root,
      &selector,
      &to,
      &from,
      &source,
      json,
    )
    ChangeAction.Recover => {
      run requireRecoveryPackage(&root)
      run Release.recover(&root)
      run Writer.writeAll(b"Recovery complete. Inspect your working tree before trying again.\n")
      return 0
    }
  }
}

static if Intrinsic.targetOperatingSystem() == "windows" {
  import silk.platform.windows.path { WindowsPath }
}

effect fn workingPath(bytes: &[u8]) -> Path
  ! FileError | OutOfMemoryError
  ? &mut Allocator {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    return run WindowsPath.fromNativeBytes(bytes)
  } else {
    return run Path.fromBytes(bytes)
  }
}

effect fn program() -> i32
  ! Problem | HttpError | FileError | TomlError | HostInputError | OutOfMemoryError | WriterError
  ? &mut HostInput | &mut Allocator {
  let mut files = run MachineFileSystem.make()
  let mut random = OsRandom.make()
  let mut stdout = StdoutWriter.make()
  return run command()
    |> Effect.provideMut<FileSystem>(&mut files)
    |> Effect.provideMut<Random>(&mut random)
    |> Effect.provideMut<Writer>(&mut stdout)
}

effect fn report(
  error: Problem
    | HttpError
    | FileError
    | TomlError
    | HostInputError
    | OutOfMemoryError
    | WriterError,
) -> ()
  ! WriterError
  ? &mut Writer {
  // Only a write that fails partway can leave .changes/.lock behind; other failures need no recovery.
  let mut interrupted = false
  match move error {
    Problem problem => {
      run Format.format("silk change: {message}\n", &.{ message: problem.message })
    }
    HttpError failure => {
      run Writer.writeAll(b"silk change: ")
      run reportError(&failure)
    }
    FileError failure => {
      interrupted = true
      run Format.format(
        "silk change: filesystem operation {operation} failed (reason {reason}).\n",
        &.{ operation: failure.operation.code, reason: failure.reason.code },
      )
    }
    TomlError failure => {
      run Format.format(
        "silk change: invalid TOML at byte {offset}.\n",
        &.{ offset: failure.offset },
      )
    }
    HostInputError _failure => {
      run Writer.writeAll(b"silk change: could not read process arguments or working directory.\n")
    }
    OutOfMemoryError _failure => {
      interrupted = true
      run Writer.writeAll(b"silk change: allocation failed.\n")
    }
    WriterError _failure => {
      run Writer.writeAll(b"silk change: could not write command output.\n")
    }
  }
  if !interrupted {
    return ()
  }
  run Writer.writeAll(
    b"If .changes/.lock remains after a failed write, stop other writers and run silk change [--dir PATH] recover for the affected package.\n",
  )
}

pub effect fn runHost() -> i32
  ? &mut HostInput | &mut Allocator {
  let outcome = run Effect.result(program())
  return match move outcome {
    Result<
      i32,
      Problem | HttpError | FileError | TomlError | HostInputError | OutOfMemoryError | WriterError
    >.Success {
      value
    } => value
    Result<
      i32,
      Problem | HttpError | FileError | TomlError | HostInputError | OutOfMemoryError | WriterError
    >.Failure {
      error
    } => {
      let mut stderr = StderrWriter.make()
      let reported = run Effect.result(report(move error) |> Effect.provideMut<Writer>(&mut stderr))
      drop reported
      return 1
    }
  }
}
