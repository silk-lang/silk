//! Resolves upgrade baselines separately from local or published release-history sources.
//! No selector means the compiler recorded in package.silk-version, never the running compiler.
//! Dependencies use their installed manifests; remote origins must be explicitly declared.
import Problem { Problem }
import History
import Manifest
import Snapshot
import Text
import Version
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.bool
import silk.mem.box { Box }
import silk.collections.bytes { Bytes }
import silk.system.filesystem { FileError, FileSystem, Path }
import silk.num.i32
import silk.option { Option }
import silk.text.string { String }
import silk.toml.scanner { TomlError }
import silk.toml.value { Toml, Value, TomlChild }
import silk.num.usize
import silk.collections.list { List }

pub union Origin {
  Local { pub directory: Path },
  Snapshot { pub path: Path },
  GitHub { pub repository: String, pub directory: String },
}

pub struct Target {
  pub origin: Origin,
  pub packageName: String,
  pub fromVersion: String,
  /// Empty only for unresolved remote release discovery.
  pub toVersion: String,
}

struct Package<'a> {
  name: string<'a>,
  version: string<'a>,
}


effect fn document(root: &Path) -> Value
! FileError | TomlError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let manifest = run Path.join(root, "silk.toml")
  let bytes = run FileSystem.readFile(&manifest)
  return run Toml.parse(Bytes.asSlice(&bytes))
}

effect fn package<'a>(value: &'a Value) -> Package<'a> ! Problem {
  let name = match move Toml.asString(Toml.fieldAt(Toml.field(value, "package"), "name")) {
    Option<string>.Some { value: text } => text
    Option<string>.None => {
      if let Option<&Value>.None = move Toml.field(value, "package") {
        if let Option<&Value>.Some { value: _ } = move Toml.field(value, "workspace") {
          fail Problem { message: "This is a virtual workspace, not a release package. Select a member with silk change --dir PATH, or run from a member directory." }
        }
      }
      fail Problem { message: "History source needs a package.name string." }
    }
  }
  if name == "" { fail Problem { message: "History source package name is empty." } }
  let version = match move Toml.asString(Toml.fieldAt(Toml.field(value, "package"), "version")) {
    Option<string>.Some { value: text } => text
    Option<string>.None => { fail Problem { message: "History source needs a package.version string." } }
  }
  run Version.validate(version)
  return Package { name: name, version: version }
}

/// Normalizes a user-supplied relative or absolute directory against an explicit base.
pub effect fn resolvePath(base: &Path, value: string) -> Path
! FileError | OutOfMemoryError ? &mut Allocator {
  if String.byteLength(value) > usize.ZERO {
    if Text.byte(value, usize.ZERO) == 47 {
      let root = run Path.root()
      return run Path.resolve(&root, Text.part(value, usize.ONE, String.byteLength(value)))
    }
  }
  return run Path.resolve(base, value)
}

effect fn dependencyPath(root: &Path, entry: &Value) -> Path
! Problem | FileError | OutOfMemoryError ? &mut Allocator {
  let path = match move Toml.asString(Toml.field(entry, "path")) {
    Option<string>.Some { value } => value
    Option<string>.None => { fail Problem { message: "Dependency must declare a local path to its silk.toml directory." } }
  }
  if path == "" { fail Problem { message: "Dependency path must not be empty." } }
  return run resolvePath(root, path)
}

effect fn checkedDependency(entry: &Value, directory: &Path) -> Value
! Problem | FileError | TomlError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let value = run document(directory)
  let found = run package(&value)
  let expectedField = Toml.field(entry, "package")
  match move expectedField {
    Option<&Value>.Some { value: constraint } => {
      let expected = match move Toml.asString(Option<&Value>.some(constraint)) {
        Option<string>.Some { value: text } => text
        Option<string>.None => { fail Problem { message: "Dependency package constraint must be a string." } }
      }
      if expected != found.name {
        fail Problem { message: "Dependency package constraint does not match its manifest name." }
      }
    }
    Option<&Value>.None => {}
  }
  return move value
}

effect fn installed(root: &Path, owner: &Value, selector: string) -> Value
! Problem | FileError | TomlError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let dependencies = match move Toml.field(owner, "dependencies") {
    Option<&Value>.Some { value } => value
    Option<&Value>.None => { fail Problem { message: "No dependencies declared; omit the name to query compiler upgrades, or pass a version for this package." } }
  }
  if let Option<&Value>.Some { value } = move Toml.field(dependencies, selector) {
    let directory = run dependencyPath(root, value)
    let document = run checkedDependency(value, &directory)
    return move document
  }
  let mut found = Option<Value>.none()
  match &dependencies.* {
    Value.Table { entries, kind } => {
      let values = Box<List<TomlChild>>.get(&entries)
      let members = List<TomlChild>.asSlice(&values[0])
      let mut at = usize.ZERO
      while at < members.length {
        if let TomlChild.Member { entry } = &members[at] {
          let directory = run dependencyPath(root, &entry.value)
          let document = run checkedDependency(&entry.value, &directory)
          let candidate = run package(&document)
          if candidate.name == selector {
            if let Option<Value>.Some { value: _ } = &found {
              fail Problem { message: "Dependency package name is ambiguous; use its manifest alias." }
            }
            found = Option<Value>.some(move document)
          }
        }
        at = at + usize.ONE
      }
    }
    _ => { fail Problem { message: "dependencies must be a TOML table." } }
  }
  return match move found {
    Option<Value>.Some { value } => move value
    Option<Value>.None => { fail Problem { message: "No direct dependency matches that alias or package name." } }
  }
}

effect fn snapshotPath(directory: &Path, version: string) -> Path
! FileError | OutOfMemoryError ? &mut Allocator {
  let mut filename = run String.copy(version)
  run String.append(&mut filename, ".toml")
  return run Path.join(directory, String.view(&filename))
}

effect fn snapshotTarget(path: Path, expected: string, baseline: String, to: string) -> Target
! Problem | FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let snapshot = run Snapshot.read(&path)
  if String.view(&snapshot.packageName) != expected {
    fail Problem { message: "Candidate snapshot belongs to a different package." }
  }
  if to != "" && to != String.view(&snapshot.version) {
    fail Problem { message: "Snapshot version does not exactly match --to." }
  }
  if (run Version.compare(String.view(&baseline), String.view(&snapshot.version))) > 0 {
    fail Problem { message: "The history baseline must not be newer than the target version." }
  }
  return Target {
    origin: Origin.Snapshot { path: move path },
    packageName: move snapshot.packageName, fromVersion: move baseline, toVersion: move snapshot.version,
  }
}

effect fn localTarget<'a>(directory: Path, selected: Package<'a>, baseline: String, to: string) -> Target
! Problem | FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let mut target = selected.version
  if to != "" { target = to }
  let snapshots = run Path.join(&directory, ".changes/snapshots")
  let snapshot = run snapshotPath(&snapshots, target)
  // Published projections need not match the unmodified checkout manifest.
  if run FileSystem.exists(&snapshot) {
    return run snapshotTarget(move snapshot, selected.name, move baseline, target)
  }
  if Snapshot.isDev(target) || Snapshot.isDev(String.view(&baseline)) {
    fail Problem { message: "Dev upgrade queries require exact published snapshots in .changes/snapshots; stable history is not a substitute." }
  }
  if (run Version.compare(target, selected.version)) > 0 {
    fail Problem { message: "The requested target is newer than the selected history checkout." }
  }
  if (run Version.compare(String.view(&baseline), target)) > 0 {
    fail Problem { message: "The history baseline must not be newer than the target version." }
  }
  return Target {
    origin: Origin.Local { directory: move directory },
    packageName: run String.copy(selected.name), fromVersion: move baseline, toVersion: run String.copy(target),
  }
}

/// Reads local stable history or exact immutable snapshots. Snapshot baselines are sibling
/// <version>.toml files; only the target's exact coverage floor needs no baseline asset.
pub effect fn queryLocal(target: &Target) -> List<History.Record>
! Problem | FileError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  return match &target.origin {
    Origin.Local { directory } => run History.query(&directory, String.view(&target.packageName),
      String.view(&target.fromVersion), String.view(&target.toVersion))
    Origin.Snapshot { path } => {
      let snapshot = run Snapshot.read(&path)
      if String.view(&snapshot.version) != String.view(&target.toVersion) {
        fail Problem { message: "Snapshot version changed after target resolution." }
      }
      if String.view(&target.fromVersion) == String.view(&snapshot.floor) {
        return run Snapshot.fromFloor(move snapshot, String.view(&target.packageName), String.view(&target.fromVersion))
      }
      let directory = match move run Path.parent(&path) {
        Option<Path>.Some { value } => move value
        Option<Path>.None => { fail Problem { message: "Snapshot source must have a parent directory." } }
      }
      let baselinePath = run snapshotPath(&directory, String.view(&target.fromVersion))
      let baseline = run Snapshot.read(&baselinePath)
      if String.view(&baseline.version) != String.view(&target.fromVersion) {
        fail Problem { message: "Baseline snapshot does not match the exact requested version." }
      }
      return run Snapshot.compare(&baseline, move snapshot, String.view(&target.packageName))
    }
    Origin.GitHub { repository, directory } => {
      fail Problem { message: "Published GitHub sources require the remote query resolver." }
    }
  }
}

effect fn checkout(root: &Path, source: string, expected: string, baseline: String, to: string) -> Target
! Problem | FileError | TomlError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let directory = run resolvePath(root, source)
  let length = String.byteLength(source)
  if length >= 5 {
    if Text.part(source, length - 5, length) == ".toml" {
      return run snapshotTarget(move directory, expected, move baseline, to)
    }
  }
  let contents = run document(&directory)
  let selected = run package(&contents)
  if selected.name != expected {
    fail Problem { message: "Candidate history source belongs to a different package." }
  }
  return run localTarget(move directory, move selected, move baseline, to)
}

effect fn remoteTarget(repository: string, directory: string, name: string, baseline: String, to: string) -> Target
! Problem | OutOfMemoryError ? &mut Allocator {
  if to != "" {
    if (run Version.compare(String.view(&baseline), to)) > 0 {
      fail Problem { message: "The history baseline must not be newer than the target version." }
    }
  }
  return Target {
    origin: Origin.GitHub { repository: run String.copy(repository), directory: run String.copy(directory) },
    packageName: run String.copy(name), fromVersion: move baseline, toVersion: run String.copy(to),
  }
}

/// Empty selector selects compiler upgrades; a version selects this package's local history.
/// A dependency alias/name selects installed metadata and its declared GitHub release source.
/// source overrides discovery with a checkout or snapshot TOML file; from overrides the baseline.
pub effect fn resolve(root: &Path, selector: string, source: string, from: string, to: string) -> Target
! Problem | FileError | TomlError | OutOfMemoryError ? &mut FileSystem | &mut Allocator {
  let owner = run document(root)
  let own = run package(&owner)
  if to != "" { run Version.validate(to) }
  if selector == "" {
    let mut baseline = String.make()
    if from != "" {
      run Version.validate(from)
      baseline = run String.copy(from)
    } else {
      let recorded = match move Toml.asString(Toml.fieldAt(Toml.field(&owner, "package"), "silk-version")) {
        Option<string>.Some { value } => value
        Option<string>.None => {
          fail Problem { message: "Compiler upgrade history needs package.silk-version; supply --from VERSION if it is not recorded." }
        }
      }
      run Version.validate(recorded)
      baseline = run String.copy(recorded)
    }
    if source != "" { return run checkout(root, source, "silk-compiler", move baseline, to) }
    return run remoteTarget("silk-lang/silk", "compiler", "silk-compiler", move baseline, to)
  }
  let initial = Text.byte(selector, usize.ZERO)
  if initial >= 48 && initial <= 57 {
    if from != "" { fail Problem { message: "A version selector already supplies the baseline; omit --from." } }
    run Version.validate(selector)
    let baseline = run String.copy(selector)
    if source != "" { return run checkout(root, source, own.name, move baseline, to) }
    let directory = run Path.fromBytes(Path.rawBytes(root))
    return run localTarget(move directory, move own, move baseline, to)
  }
  let dependency = run installed(root, &owner, selector)
  let selected = run package(&dependency)
  let mut baseline = String.make()
  if from == "" {
    baseline = run String.copy(selected.version)
  } else {
    run Version.validate(from)
    baseline = run String.copy(from)
  }
  if source != "" { return run checkout(root, source, selected.name, move baseline, to) }
  let configuration = Manifest.releaseTable(&dependency)
  let repository = match move Toml.asString(Toml.fieldAt(move configuration, "repository")) {
    Option<string>.Some { value } => value
    Option<string>.None => {
      fail Problem { message: "Dependency has no published history source. Declare [release] repository = \"owner/repo\" in its manifest, or supply --source PATH." }
    }
  }
  let mut directory = ""
  if let Option<&Value>.Some { value } = move Toml.fieldAt(Manifest.releaseTable(&dependency), "directory") {
    directory = match move Toml.asString(Option<&Value>.some(value)) {
      Option<string>.Some { value: text } => text
      Option<string>.None => { fail Problem { message: "release.directory must be a relative directory string." } }
    }
  }
  return run remoteTarget(repository, directory, selected.name, move baseline, to)
}
