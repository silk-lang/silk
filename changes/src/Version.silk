//! SemVer validation, precedence, and arbitrary-precision release arithmetic.
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.bool
import silk.num.i32
import silk.text.string { String }
import silk.num.usize
import Problem { Problem }
import Text

/// Release magnitude. Major zero follows the same literal arithmetic as every other major.
pub enum Bump {
  Patch,
  Minor,
  Major,
}


/// Accepts only the lowercase release labels used in changeset metadata.
pub effect fn parseBump(text: string) -> Bump ! Problem {
  if text == "patch" { return Bump.Patch }
  if text == "minor" { return Bump.Minor }
  if text == "major" { return Bump.Major }
  fail Problem { message: "bump must be patch, minor, or major" }
}

/// Returns the canonical metadata label.
pub fn label(bump: Bump) -> string<'static> {
  return match bump {
    Bump.Patch => "patch"
    Bump.Minor => "minor"
    Bump.Major => "major"
  }
}

/// Larger ranks take precedence when several changes contribute to one release.
pub fn rank(bump: Bump) -> i32 {
  return match bump {
    Bump.Patch => 1
    Bump.Minor => 2
    Bump.Major => 3
  }
}

fn digit(value: i32) -> bool {
  return value >= 48 && value <= 57
}

// Returns the first byte after one nonempty, canonical decimal component.
effect fn componentEnd(text: string, start: usize) -> usize ! Problem {
  let length = String.byteLength(text)
  let mut end = start
  while end < length {
    if digit(Text.byte(text, end)) == false { break }
    end = end + usize.ONE
  }
  if end == start { fail Problem { message: "version requires three numeric SemVer components" } }
  if end - start > usize.ONE && Text.byte(text, start) == 48 {
    fail Problem { message: "SemVer numeric components must not have leading zeros" }
  }
  return end
}

fn letter(value: i32) -> bool {
  return (value >= 65 && value <= 90) || (value >= 97 && value <= 122)
}

fn numeric(text: string) -> bool {
  let length = String.byteLength(text)
  if length == usize.ZERO { return false }
  let mut index = usize.ZERO
  while index < length {
    if digit(Text.byte(text, index)) == false { return false }
    index = index + usize.ONE
  }
  return true
}

fn identifierEnd(text: string, start: usize) -> usize {
  let length = String.byteLength(text)
  let mut end = start
  while end < length {
    if Text.byte(text, end) == 46 { break }
    end = end + usize.ONE
  }
  return end
}

fn suffixEnd(text: string, start: usize) -> usize {
  let length = String.byteLength(text)
  let mut end = start
  while end < length {
    if Text.byte(text, end) == 43 { break }
    end = end + usize.ONE
  }
  return end
}

effect fn validateIdentifiers(text: string, start: usize, end: usize, prerelease: bool) -> () ! Problem {
  let mut index = start
  let mut identifierStart = start
  let mut allDigits = true
  while index < end {
    let value = Text.byte(text, index)
    if value == 46 {
      if index == identifierStart { fail Problem { message: "SemVer identifiers must not be empty" } }
      if prerelease && allDigits && index - identifierStart > usize.ONE && Text.byte(text, identifierStart) == 48 {
        fail Problem { message: "numeric prerelease identifiers must not have leading zeros" }
      }
      identifierStart = index + usize.ONE
      allDigits = true
    } else {
      if digit(value) == false {
        allDigits = false
        if letter(value) == false && value != 45 {
          fail Problem { message: "SemVer identifiers permit only ASCII letters, digits, and hyphens" }
        }
      }
    }
    index = index + usize.ONE
  }
  if identifierStart == end { fail Problem { message: "SemVer identifiers must not be empty" } }
  if prerelease && allDigits && end - identifierStart > usize.ONE && Text.byte(text, identifierStart) == 48 {
    fail Problem { message: "numeric prerelease identifiers must not have leading zeros" }
  }
  return ()
}

/// Validates SemVer 2.0.0 without allocation or machine-integer conversion.
/// Core and numeric prerelease identifiers forbid leading zeros; metadata permits them.
pub effect fn validate(text: string) -> () ! Problem {
  let length = String.byteLength(text)
  let majorEnd = run componentEnd(text, usize.ZERO)
  if majorEnd == length { fail Problem { message: "version requires three numeric SemVer components" } }
  if Text.byte(text, majorEnd) != 46 { fail Problem { message: "version requires three numeric SemVer components" } }
  let minorEnd = run componentEnd(text, majorEnd + usize.ONE)
  if minorEnd == length { fail Problem { message: "version requires three numeric SemVer components" } }
  if Text.byte(text, minorEnd) != 46 { fail Problem { message: "version requires three numeric SemVer components" } }
  let coreEnd = run componentEnd(text, minorEnd + usize.ONE)
  if coreEnd == length { return () }
  let suffix = Text.byte(text, coreEnd)
  if suffix == 45 {
    let end = suffixEnd(text, coreEnd + usize.ONE)
    run validateIdentifiers(text, coreEnd + usize.ONE, end, true)
    if end < length { run validateIdentifiers(text, end + usize.ONE, length, false) }
  } else {
    if suffix != 43 { fail Problem { message: "invalid SemVer suffix" } }
    run validateIdentifiers(text, coreEnd + usize.ONE, length, false)
  }
  return ()
}

/// Borrows the major.minor.patch portion. Precondition: text has passed validate.
pub fn core<'a>(text: string<'a>) -> string<'a> {
  let length = String.byteLength(text)
  let mut end = usize.ZERO
  while end < length {
    let value = Text.byte(text, end)
    if value == 45 || value == 43 { break }
    end = end + usize.ONE
  }
  return Text.part(text, usize.ZERO, end)
}

/// Reports whether a prerelease suffix exists. Precondition: text has passed validate.
pub fn isPrerelease(text: string) -> bool {
  let end = String.byteLength(core(text))
  return end < String.byteLength(text) && Text.byte(text, end) == 45
}

fn lexicalCompare(left: string, right: string) -> i32 {
  let leftLength = String.byteLength(left)
  let rightLength = String.byteLength(right)
  let mut index = usize.ZERO
  while index < leftLength && index < rightLength {
    let leftByte = Text.byte(left, index)
    let rightByte = Text.byte(right, index)
    if leftByte < rightByte { return -1 }
    if leftByte > rightByte { return 1 }
    index = index + usize.ONE
  }
  if leftLength < rightLength { return -1 }
  if leftLength > rightLength { return 1 }
  return 0
}

fn decimalCompare(left: string, right: string) -> i32 {
  let leftLength = String.byteLength(left)
  let rightLength = String.byteLength(right)
  if leftLength < rightLength { return -1 }
  if leftLength > rightLength { return 1 }
  return lexicalCompare(left, right)
}

fn compareValidated(left: string, right: string) -> i32 {
  let leftCore = core(left)
  let rightCore = core(right)
  let leftCoreLength = String.byteLength(leftCore)
  let rightCoreLength = String.byteLength(rightCore)
  let mut leftStart = usize.ZERO
  let mut rightStart = usize.ZERO
  while leftStart < leftCoreLength {
    let leftEnd = identifierEnd(leftCore, leftStart)
    let rightEnd = identifierEnd(rightCore, rightStart)
    let order = decimalCompare(Text.part(leftCore, leftStart, leftEnd), Text.part(rightCore, rightStart, rightEnd))
    if order != 0 { return order }
    if leftEnd == leftCoreLength { break }
    leftStart = leftEnd + usize.ONE
    rightStart = rightEnd + usize.ONE
  }
  let leftPrerelease = leftCoreLength < String.byteLength(left) && Text.byte(left, leftCoreLength) == 45
  let rightPrerelease = rightCoreLength < String.byteLength(right) && Text.byte(right, rightCoreLength) == 45
  if leftPrerelease == false {
    if rightPrerelease { return 1 }
    return 0
  }
  if rightPrerelease == false { return -1 }
  let leftSuffix = Text.part(left, leftCoreLength + usize.ONE, suffixEnd(left, leftCoreLength + usize.ONE))
  let rightSuffix = Text.part(right, rightCoreLength + usize.ONE, suffixEnd(right, rightCoreLength + usize.ONE))
  let leftLength = String.byteLength(leftSuffix)
  let rightLength = String.byteLength(rightSuffix)
  leftStart = usize.ZERO
  rightStart = usize.ZERO
  while leftStart < leftLength && rightStart < rightLength {
    let leftEnd = identifierEnd(leftSuffix, leftStart)
    let rightEnd = identifierEnd(rightSuffix, rightStart)
    let leftIdentifier = Text.part(leftSuffix, leftStart, leftEnd)
    let rightIdentifier = Text.part(rightSuffix, rightStart, rightEnd)
    let leftNumeric = numeric(leftIdentifier)
    let rightNumeric = numeric(rightIdentifier)
    if leftNumeric && rightNumeric == false { return -1 }
    if rightNumeric && leftNumeric == false { return 1 }
    let mut order = 0
    if leftNumeric {
      order = decimalCompare(leftIdentifier, rightIdentifier)
    } else {
      order = lexicalCompare(leftIdentifier, rightIdentifier)
    }
    if order != 0 { return order }
    if leftEnd == leftLength {
      if rightEnd == rightLength { return 0 }
      return -1
    }
    if rightEnd == rightLength { return 1 }
    leftStart = leftEnd + usize.ONE
    rightStart = rightEnd + usize.ONE
  }
  return 0
}

/// Validates both versions and returns -1, 0, or 1 by SemVer precedence.
/// Build metadata never affects precedence. Numeric identifiers have unbounded magnitude.
pub effect fn compare(left: string, right: string) -> i32 ! Problem {
  run validate(left)
  run validate(right)
  return compareValidated(left, right)
}

fn incrementedDigit(value: i32) -> string<'static> {
  return match value {
    48 => "1"
    49 => "2"
    50 => "3"
    51 => "4"
    52 => "5"
    53 => "6"
    54 => "7"
    55 => "8"
    _ => "9"
  }
}

// Appends arbitrary-precision decimal arithmetic directly into the final output.
// No numeric component is converted to a machine integer, so magnitude cannot overflow.
effect fn appendIncremented(output: &mut String, component: string) -> () ! OutOfMemoryError ? &mut Allocator {
  let length = String.byteLength(component)
  let mut pivot = length
  while pivot > usize.ZERO {
    if Text.byte(component, pivot - usize.ONE) != 57 { break }
    pivot = pivot - usize.ONE
  }
  if pivot == usize.ZERO {
    run String.append(&mut output.*, "1")
  } else {
    run String.append(&mut output.*, Text.part(component, usize.ZERO, pivot - usize.ONE))
    run String.append(&mut output.*, incrementedDigit(Text.byte(component, pivot - usize.ONE)))
  }
  let mut index = pivot
  while index < length {
    run String.append(&mut output.*, "0")
    index = index + usize.ONE
  }
  return ()
}

/// Validates any SemVer and literally increments the selected core component.
/// Smaller components reset; prerelease and build metadata are omitted.
/// Decimal magnitude is unbounded, including for major-zero versions.
pub effect fn bump(current: string, kind: Bump) -> String ! Problem | OutOfMemoryError ? &mut Allocator {
  run validate(current)
  let currentCore = core(current)
  let majorEnd = identifierEnd(currentCore, usize.ZERO)
  let minorStart = majorEnd + usize.ONE
  let minorEnd = identifierEnd(currentCore, minorStart)
  let patchStart = minorEnd + usize.ONE
  let coreEnd = String.byteLength(currentCore)
  let mut output = String.make()
  if kind == Bump.Major {
    run appendIncremented(&mut output, Text.part(current, usize.ZERO, majorEnd))
    run String.append(&mut output, ".0.0")
  } else {
    if kind == Bump.Minor {
      run String.append(&mut output, Text.part(current, usize.ZERO, minorStart))
      run appendIncremented(&mut output, Text.part(current, minorStart, minorEnd))
      run String.append(&mut output, ".0")
    } else {
      run String.append(&mut output, Text.part(current, usize.ZERO, patchStart))
      run appendIncremented(&mut output, Text.part(current, patchStart, coreEnd))
    }
  }
  return move output
}

effect fn validateTag(tag: string) -> () ! Problem {
  let length = String.byteLength(tag)
  if length == usize.ZERO { fail Problem { message: "release tag must not be empty" } }
  if letter(Text.byte(tag, usize.ZERO)) == false {
    fail Problem { message: "release tag must begin with an ASCII letter" }
  }
  let mut index = usize.ONE
  while index < length {
    let value = Text.byte(tag, index)
    if letter(value) == false && digit(value) == false && value != 45 {
      fail Problem { message: "release tag must be one ASCII letter, digit, or hyphen identifier" }
    }
    index = index + usize.ONE
  }
  return ()
}

/// Constructs a strictly newer release, except stable core normalization may be a no-op.
/// targetCore must be a valid major.minor.patch without prerelease or metadata.
/// Empty tag promotes to targetCore; other tags must start with an ASCII letter.
/// A new core or tag starts at tag.1. Same-core tagged transitions require an existing
/// tag.N shape with a canonical decimal N; the same tag increments N without a size limit.
/// Arbitrary prereleases may be promoted or replaced on a newer core, never guessed at.
pub effect fn release(current: string, targetCore: string, tag: string) -> String
! Problem | OutOfMemoryError ? &mut Allocator {
  run validate(current)
  run validate(targetCore)
  if core(targetCore) != targetCore {
    fail Problem { message: "release target must be a stable SemVer core without metadata" }
  }
  let mut counter = Text.part(current, usize.ZERO, usize.ZERO)
  if tag != "" {
    run validateTag(tag)
    if core(current) == targetCore && isPrerelease(current) {
      let start = String.byteLength(targetCore) + usize.ONE
      let suffix = Text.part(current, start, suffixEnd(current, start))
      let tagEnd = identifierEnd(suffix, usize.ZERO)
      if tagEnd == String.byteLength(suffix) {
        fail Problem { message: "tagged continuation requires an existing tag.N prerelease" }
      }
      let previousTag = Text.part(suffix, usize.ZERO, tagEnd)
      run validateTag(previousTag)
      let previousCounter = Text.part(suffix, tagEnd + usize.ONE, String.byteLength(suffix))
      if numeric(previousCounter) == false {
        fail Problem { message: "tagged continuation requires an existing tag.N prerelease" }
      }
      if previousTag == tag { counter = previousCounter }
    }
  }
  let mut output = run String.copy(targetCore)
  if tag != "" {
    run String.append(&mut output, "-")
    run String.append(&mut output, tag)
    run String.append(&mut output, ".")
    if counter == "" {
      run String.append(&mut output, "1")
    } else {
      run appendIncremented(&mut output, counter)
    }
  }
  let order = compareValidated(String.view(&output), current)
  if order < 0 || (order == 0 && (tag != "" || isPrerelease(current))) {
    fail Problem { message: "release transition must increase SemVer precedence" }
  }
  return move output
}
