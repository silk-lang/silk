//! Owned, bounded HTTPS responses for authoritative release metadata and history.
import Problem { Problem }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.bytes { Bytes }
import silk.tls.connection { ConnectionError }
import silk.tls.client { TlsError, ProtocolReason, TlsLimitKind }
import silk.tls.certificate_path { ValidationLocation, ValidationClass, ValidationReason }
import silk.tls.certificate { DecodeReason }
import silk.tls.trust_snapshot { TrustSourceError }
import silk.io.writer { Writer, WriterError }
import silk.format { Format }
import silk.option { Option }

pub struct Response {
  pub status: i32,
  pub body: Bytes,
}

/// HTTP failures remain status values; the native provider follows bounded HTTPS redirects.
pub service Http {
  effect fn get(url: string) -> Response
  ! Problem | HttpError | OutOfMemoryError ? &mut Http | &mut Allocator
}

/// A native trust or TLS failure with the complete boundary evidence.
pub union HttpError {
  /// TLS negotiation, authentication, or connection I/O failed.
  Tls { pub error: ConnectionError },
  /// The configured authority bundle could not be loaded atomically.
  Trust { pub error: TrustSourceError },
}

/// Writes the failed boundary and certificate-path evidence without losing the typed cause.
pub effect fn reportError(error: &HttpError) -> () ! WriterError ? &mut Writer {
  match & error.* {
    HttpError.Tls {error: connection} => run reportConnection(&connection)
    HttpError.Trust {error: trust} => run Writer.writeAll(b"Could not load the PEM trust bundle; set SSL_CERT_FILE to a readable regular PEM bundle of trusted authorities.\n")
  }
}

effect fn reportConnection(error: &ConnectionError) -> () ! WriterError ? &mut Writer {
  match & error.* {
    ConnectionError.HandshakeTimeout => run Writer.writeAll(b"HandshakeTimeout\n")
    ConnectionError.Io {error: io} => run Writer.writeAll(b"Io\n")
    ConnectionError.Tls {error: tls} => {
      match & tls {
        TlsError.CertificatePath {error: path} => {
          run Format.format("CertificatePath kind={kind} reason={reason} offset={offset}\n", &.{kind: validationClassName(path.kind), reason: validationReasonName(path.reason), offset: path.offset})
          if let Option.Some {value} = &path.detailReason { run Format.format("detailReason={reason}\n", &.{reason: validationReasonName(value)}) }
          match & path.location {
            ValidationLocation.Leaf => run Writer.writeAll(b"Leaf\n")
            ValidationLocation.Call => run Writer.writeAll(b"Call\n")
            ValidationLocation.Anchor {index} => run Format.format("Anchor {index}\n", &.{index: index})
            ValidationLocation.Intermediate {index} => run Format.format("Intermediate {index}\n", &.{index: index})
          }
        }
        TlsError.PeerAlert {code} => run Format.format("PeerAlert {code}\n", &.{code: code})
        TlsError.ProtocolViolation {reason} => run Format.format("ProtocolViolation {reason}\n", &.{reason: protocolReasonName(reason)})
        TlsError.CertificateDecode {error: decode} => run Format.format("CertificateDecode {reason} at {offset}\n", &.{reason: decodeReasonName(decode.reason), offset: decode.offset})
        TlsError.UnsupportedProfile => run Writer.writeAll(b"UnsupportedProfile\n")
        TlsError.CertificateIdentity {error: identity} => run Writer.writeAll(b"CertificateIdentity\n")
        TlsError.CertificateVerify {error: signature} => run Writer.writeAll(b"CertificateVerify\n")
        TlsError.BadRecordMac => run Writer.writeAll(b"BadRecordMac\n")
        TlsError.Finished => run Writer.writeAll(b"Finished\n")
        TlsError.LimitExceeded {kind, limit} => run Format.format("LimitExceeded {kind} {limit}\n", &.{kind: tlsLimitName(kind), limit: limit})
        TlsError.InvalidState {operation} => run Writer.writeAll(b"InvalidState\n")
        TlsError.EmptyBuffer => run Writer.writeAll(b"EmptyBuffer\n")
        TlsError.HandshakeTruncated => run Writer.writeAll(b"HandshakeTruncated\n")
        TlsError.Truncated => run Writer.writeAll(b"Truncated\n")
        TlsError.NoApplicationProtocol => run Writer.writeAll(b"NoApplicationProtocol\n")
      }
    }
  }
}

fn validationClassName(value: ValidationClass) -> string<'static> {
 return match value {
  ValidationClass.InvalidInput => "InvalidInput"
  ValidationClass.Rejected => "Rejected"
  ValidationClass.ResourceLimit => "ResourceLimit"
 }
}

fn validationReasonName(value: ValidationReason) -> string<'static> {
 return match value {
  ValidationReason.UnsupportedVersion => "UnsupportedVersion"
  ValidationReason.UnsupportedAlgorithm => "UnsupportedAlgorithm"
  ValidationReason.UnsupportedParameters => "UnsupportedParameters"
  ValidationReason.UnsupportedExtension => "UnsupportedExtension"
  ValidationReason.UnsupportedConstraint => "UnsupportedConstraint"
  ValidationReason.UnsupportedPolicy => "UnsupportedPolicy"
  ValidationReason.InvalidKey => "InvalidKey"
  ValidationReason.InvalidSignature => "InvalidSignature"
  ValidationReason.InvalidSerial => "InvalidSerial"
  ValidationReason.InvalidUsage => "InvalidUsage"
  ValidationReason.InvalidBasicConstraints => "InvalidBasicConstraints"
  ValidationReason.InvalidName => "InvalidName"
  ValidationReason.InvalidTime => "InvalidTime"
  ValidationReason.DuplicateExtension => "DuplicateExtension"
  ValidationReason.IssuerMismatch => "IssuerMismatch"
  ValidationReason.NameConstraintViolation => "NameConstraintViolation"
  ValidationReason.PathLengthExceeded => "PathLengthExceeded"
  ValidationReason.Cycle => "Cycle"
  ValidationReason.NoIssuer => "NoIssuer"
  ValidationReason.NoValidPath => "NoValidPath"
  ValidationReason.SizeOverflow => "SizeOverflow"
 }
}

fn protocolReasonName(value: ProtocolReason) -> string<'static> {
 return match value {
  ProtocolReason.Record => "Record"
  ProtocolReason.UnexpectedMessage => "UnexpectedMessage"
  ProtocolReason.InvalidLength => "InvalidLength"
  ProtocolReason.Extension => "Extension"
  ProtocolReason.ServerHello => "ServerHello"
  ProtocolReason.HelloRetryRequest => "HelloRetryRequest"
  ProtocolReason.CompatibilityCcs => "CompatibilityCcs"
  ProtocolReason.CertificateRequest => "CertificateRequest"
  ProtocolReason.Certificate => "Certificate"
  ProtocolReason.PostHandshake => "PostHandshake"
  ProtocolReason.InternalState => "InternalState"
 }
}

fn tlsLimitName(value: TlsLimitKind) -> string<'static> {
 return match value {
  TlsLimitKind.HandshakeBodyBytes => "HandshakeBodyBytes"
  TlsLimitKind.HandshakeBytes => "HandshakeBytes"
  TlsLimitKind.HandshakeMessages => "HandshakeMessages"
  TlsLimitKind.PeerCertificates => "PeerCertificates"
  TlsLimitKind.CertificateBytes => "CertificateBytes"
  TlsLimitKind.CertificateTotalBytes => "CertificateTotalBytes"
  TlsLimitKind.CookieBytes => "CookieBytes"
  TlsLimitKind.ExtensionBytes => "ExtensionBytes"
  TlsLimitKind.EmptyRecords => "EmptyRecords"
  TlsLimitKind.PostHandshakeControls => "PostHandshakeControls"
  TlsLimitKind.Tickets => "Tickets"
  TlsLimitKind.TicketBytes => "TicketBytes"
  TlsLimitKind.Arithmetic => "Arithmetic"
  TlsLimitKind.Alpn => "Alpn"
  TlsLimitKind.CertificateDecode => "CertificateDecode"
  TlsLimitKind.CertificateSanDecode => "CertificateSanDecode"
  TlsLimitKind.CertificateIdentity => "CertificateIdentity"
  TlsLimitKind.CertificatePath => "CertificatePath"
  TlsLimitKind.CertificateProfile => "CertificateProfile"
 }
}

fn decodeReasonName(value: DecodeReason) -> string<'static> {
 return match value {
  DecodeReason.EmptyInput => "EmptyInput"
  DecodeReason.PemSyntax => "PemSyntax"
  DecodeReason.Base64 => "Base64"
  DecodeReason.TrailingData => "TrailingData"
  DecodeReason.Truncated => "Truncated"
  DecodeReason.Tag => "Tag"
  DecodeReason.Length => "Length"
  DecodeReason.Integer => "Integer"
  DecodeReason.Boolean => "Boolean"
  DecodeReason.BitString => "BitString"
  DecodeReason.Oid => "Oid"
  DecodeReason.SetOrder => "SetOrder"
  DecodeReason.DefaultValue => "DefaultValue"
  DecodeReason.Time => "Time"
  DecodeReason.Schema => "Schema"
  DecodeReason.StringEncoding => "StringEncoding"
  DecodeReason.Version => "Version"
  DecodeReason.PemLabel => "PemLabel"
  DecodeReason.InputBytes => "InputBytes"
  DecodeReason.CertificateBytes => "CertificateBytes"
  DecodeReason.TotalDerBytes => "TotalDerBytes"
  DecodeReason.Certificates => "Certificates"
  DecodeReason.FieldBytes => "FieldBytes"
  DecodeReason.Extensions => "Extensions"
  DecodeReason.Depth => "Depth"
  DecodeReason.Nodes => "Nodes"
  DecodeReason.SizeOverflow => "SizeOverflow"
 }
}
