//! Owned, bounded HTTPS responses for authoritative release metadata and history.
import Problem { Problem }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.bytes { Bytes }

pub struct Response {
  pub status: i32
  pub body: Bytes
}

/// HTTP status codes remain values, including redirects and remote failures.
pub service Http {
  effect fn get(url: string) -> Response
  ! Problem | OutOfMemoryError ? &mut Http | &mut Allocator
}
