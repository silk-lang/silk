//! Byte-oriented views used by the on-disk text formats.
import silk.core.bool
import silk.num.i32
import silk.core.result { Result }
import silk.collections.slice { Slice }
import silk.text.string { String, InvalidUtf8 }
import silk.num.u8
import silk.num.usize

pub fn part<'a>(text: string<'a>, start: usize, end: usize) -> string<'a> {
  let bytes = Slice.view<u8>(String.utf8Bytes(text), start, end - start)
  return Result<string, InvalidUtf8>.unwrapOr(String.fromUtf8(bytes), "")
}

pub fn byte(text: string, index: usize) -> i32 {
  return u8.toI32(String.utf8Bytes(text)[index])
}

pub fn space(value: i32) -> bool {
  return value == 32 || value == 9 || value == 10 || value == 13
}

pub fn trim<'a>(text: string<'a>) -> string<'a> {
  let mut start = usize.ZERO
  let mut end = String.byteLength(text)
  while start < end {
    if space(byte(text, start)) == false { break }
    start = start + usize.ONE
  }
  while start < end {
    if space(byte(text, end - usize.ONE)) == false { break }
    end = end - usize.ONE
  }
  return part(text, start, end)
}

pub fn starts(text: string, prefix: string) -> bool {
  let length = String.byteLength(prefix)
  if String.byteLength(text) < length { return false }
  return part(text, usize.ZERO, length) == prefix
}

pub fn ends(text: string, suffix: string) -> bool {
  let length = String.byteLength(text)
  let count = String.byteLength(suffix)
  if length < count { return false }
  return part(text, length - count, length) == suffix
}
