//! Discovers published GitHub releases and compares their immutable snapshot assets.
import History { Record }
import Snapshot
import Http { HttpError, Http }
import Problem { Problem }
import Text
import Version
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.core.bool
import silk.mem.box { Box }
import silk.collections.bytes { Bytes }
import silk.core.effect { Effect }
import silk.num.i32
import silk.json.scanner { JsonError }
import silk.json.value { Json, JsonChild, Value }
import silk.option { Option }
import silk.core.result { Result }
import silk.text.string { String }
import silk.num.usize
import silk.collections.list { List }

/// Exact published identity and the release asset selected from validated metadata.
pub struct Publication {
  pub version: String,
  repository: String,
  snapshotUrl: String,
}

fn unreserved(value: i32) -> bool {
  return (value >= 65 && value <= 90) || (value >= 97 && value <= 122)
    || (value >= 48 && value <= 57) || value == 45 || value == 46 || value == 95 || value == 126
}

// Encode original UTF-8 bytes exactly once, including literal percent signs and SemVer '+'.
effect fn appendComponent(output: &mut String, text: string) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut start = usize.ZERO
  let mut index = usize.ZERO
  let length = String.byteLength(text)
  while index < length {
    let value = Text.byte(text, index)
    if !unreserved(value) {
      run String.append(&mut output.*, Text.part(text, start, index))
      run String.append(&mut output.*, "%")
      let high = i32.toUsize(value / 16)
      let low = i32.toUsize(value % 16)
      run String.append(&mut output.*, Text.part("0123456789ABCDEF", high, high + usize.ONE))
      run String.append(&mut output.*, Text.part("0123456789ABCDEF", low, low + usize.ONE))
      start = index + usize.ONE
    }
    index = index + usize.ONE
  }
  run String.append(&mut output.*, Text.part(text, start, length))
}

effect fn validateComponent(component: string) -> () ! Problem {
  if component == "" || component == "." || component == ".." {
    fail Problem { message: "GitHub history paths require nonempty components other than '.' and '..'." }
  }
  let mut index = usize.ZERO
  while index < String.byteLength(component) {
    let value = Text.byte(component, index)
    if value < 32 || value == 127 || value == 92 {
      fail Problem { message: "GitHub history paths must not contain control bytes or backslashes." }
    }
    index = index + usize.ONE
  }
}

effect fn validateDirectory(directory: string) -> () ! Problem {
  if directory == "" { return () }
  let length = String.byteLength(directory)
  let mut start = usize.ZERO
  let mut index = usize.ZERO
  while index < length {
    if Text.byte(directory, index) == 47 {
      run validateComponent(Text.part(directory, start, index))
      start = index + usize.ONE
    }
    index = index + usize.ONE
  }
  run validateComponent(Text.part(directory, start, length))
}

effect fn validateRepository(repository: string) -> () ! Problem {
  let length = String.byteLength(repository)
  let mut separator = length
  let mut index = usize.ZERO
  while index < length {
    let value = Text.byte(repository, index)
    if value == 47 {
      if separator != length {
        fail Problem { message: "GitHub history repository must be an owner/repository pair, not a URL or path." }
      }
      separator = index
    } else {
      if !unreserved(value) || value == 126 {
        fail Problem { message: "GitHub history repository permits only ASCII letters, digits, hyphens, underscores, and dots." }
      }
    }
    index = index + usize.ONE
  }
  if separator == length {
    fail Problem { message: "GitHub history repository must declare both owner and repository." }
  }
  run validateComponent(Text.part(repository, usize.ZERO, separator))
  run validateComponent(Text.part(repository, separator + usize.ONE, length))
}


effect fn requiredBool(document: &Value, key: string) -> bool ! Problem {
  return match move Json.field(document, key) {
    Option<&Value>.Some { value } => match &value.* {
      Value.Bool { value: flag } => flag
      _ => { fail Problem { message: "GitHub release metadata requires boolean draft and prerelease fields." } }
    }
    Option<&Value>.None => { fail Problem { message: "GitHub release metadata requires boolean draft and prerelease fields." } }
  }
}

effect fn releaseDocument(bytes: &Bytes) -> Value ! Problem | OutOfMemoryError ? &mut Allocator {
  return match move run Effect.result(Json.parse(Bytes.asSlice(bytes))) {
    Result<Value, JsonError | OutOfMemoryError>.Success { value } => move value
    Result<Value, JsonError | OutOfMemoryError>.Failure { error } => match move error {
      JsonError invalid => { fail Problem { message: "GitHub release metadata is not valid JSON (including duplicate keys)." } }
      OutOfMemoryError allocation => { fail move allocation }
    }
  }
}

effect fn requiredString<'a>(document: &'a Value, key: string) -> string<'a> ! Problem {
  return match move Json.asString(Json.field(document, key)) {
    Option<string>.Some { value } => value
    Option<string>.None => { fail Problem { message: "GitHub release metadata is missing a required string field." } }
  }
}

effect fn array<'a>(document: &'a Value) -> &'a [JsonChild] ! Problem {
  return match &document.* {
    Value.Array { values } => {
      let boxed = Box<List<JsonChild>>.get(&values)
      return List<JsonChild>.asSlice(&boxed[0])
    }
    _ => { fail Problem { message: "GitHub release metadata requires an array." } }
  }
}

effect fn item<'a>(child: &'a JsonChild) -> &'a Value ! Problem {
  return match &child.* {
    JsonChild.Item { value } => &value
    _ => { fail Problem { message: "GitHub release metadata contains an invalid array item." } }
  }
}

effect fn successful(status: i32) -> () ! Problem {
  if status == 404 { fail Problem { message: "A required published GitHub release or changes-snapshot.toml asset is missing." } }
  if status == 403 || status == 429 { fail Problem { message: "GitHub release access was denied or rate limited." } }
  if status != 200 { fail Problem { message: "GitHub release access failed with an unsuccessful HTTP status." } }
}

effect fn publication(repository: string, document: &Value, exact: string, stable: bool) -> Publication
! Problem | OutOfMemoryError ? &mut Allocator {
  let tag = run requiredString(document, "tag_name")
  if !Text.starts(tag, "v") {
    fail Problem { message: "GitHub release tags must be the complete version prefixed with 'v'; bootstrap seeds are not releases." }
  }
  let version = Text.part(tag, usize.ONE, String.byteLength(tag))
  run Version.validate(version)
  if exact != "" && version != exact {
    fail Problem { message: "GitHub returned a release tag different from the exact requested version." }
  }
  if run requiredBool(document, "draft") {
    fail Problem { message: "Draft GitHub releases cannot supply published upgrade history." }
  }
  let prerelease = run requiredBool(document, "prerelease")
  if prerelease != Version.isPrerelease(version) {
    fail Problem { message: "GitHub release prerelease metadata disagrees with its version." }
  }
  if stable && prerelease { fail Problem { message: "GitHub latest did not identify a published stable release." } }

  // Never trust a metadata-supplied host or path. The native HTTP provider follows
  // bounded, authenticated GitHub asset redirects from this constructed URL.
  let mut url = run String.copy("https://github.com/")
  run String.append(&mut url, repository)
  run String.append(&mut url, "/releases/download/")
  run appendComponent(&mut url, tag)
  run String.append(&mut url, "/changes-snapshot.toml")
  let assetsValue = match move Json.field(document, "assets") {
    Option<&Value>.Some { value } => value
    Option<&Value>.None => { fail Problem { message: "Published GitHub release has no changes-snapshot.toml asset." } }
  }
  let assets = run array(assetsValue)
  let mut found = false
  let mut index = usize.ZERO
  while index < assets.length {
    let asset = run item(&assets[index])
    if (run requiredString(asset, "name")) == "changes-snapshot.toml" {
      if found { fail Problem { message: "Published GitHub release has duplicate changes-snapshot.toml assets." } }
      // GitHub may spell '+' literally or as %2B in browser_download_url. We
      // deliberately do not request that untrusted value; the tag above is exact.
      found = true
    }
    index = index + usize.ONE
  }
  if !found { fail Problem { message: "Published GitHub release has no changes-snapshot.toml asset." } }
  return Publication { version: run String.copy(version), repository: run String.copy(repository), snapshotUrl: move url }
}

effect fn endpoint(repository: string, suffix: string) -> String ! OutOfMemoryError ? &mut Allocator {
  let mut url = run String.copy("https://api.github.com/repos/")
  run String.append(&mut url, repository)
  run String.append(&mut url, suffix)
  return move url
}

effect fn appendDecimal(output: &mut String, number: usize) -> () ! OutOfMemoryError ? &mut Allocator {
  if number >= 10 { run appendDecimal(&mut output.*, number / 10) }
  let digit = number % 10
  run String.append(&mut output.*, Text.part("0123456789", digit, digit + usize.ONE))
}

// Only the canonical snapshot channel participates in automatic discovery. Historical
// bootstrap tags used shorter hashes and unrelated counters; they are not upgrade targets.
fn discoverableDev(version: string) -> bool {
  if !Snapshot.isDev(version) { return false }
  let start = String.byteLength(Version.core(version)) + 5
  let length = String.byteLength(version)
  if length <= start + 13 { return false }
  let end = length - 13
  if Text.byte(version, start) == 48 || Text.byte(version, end) != 43 { return false }
  let mut index = start
  while index < end {
    let byte = Text.byte(version, index)
    if byte < 48 || byte > 57 { return false }
    index = index + usize.ONE
  }
  index = end + usize.ONE
  while index < length {
    let byte = Text.byte(version, index)
    if !((byte >= 48 && byte <= 57) || (byte >= 97 && byte <= 102)) { return false }
    index = index + usize.ONE
  }
  return true
}

// GitHub's release listing sometimes answers 200 with an empty list, most often right
// after a release is published. An empty first page is requested again before it counts.
const EMPTY_LISTING_ATTEMPTS: usize = 5

// Publication timestamps do not define upgrade order: reservations and backports
// can appear first. Compare every eligible version across every discovery page.
effect fn discover(repository: string) -> Publication
! Problem | HttpError | OutOfMemoryError ? &mut Http | &mut Allocator {
  let mut page = usize.ONE
  let mut selected = String.make()
  let mut ambiguous = false
  let mut attempts = usize.ZERO
  while true {
    let mut url = run endpoint(repository, "/releases?per_page=100&page=")
    run appendDecimal(&mut url, page)
    let response = run Http.get(String.view(&url))
    run successful(response.status)
    let document = run releaseDocument(&response.body)
    let releases = run array(&document)
    attempts = attempts + usize.ONE
    if page == usize.ONE && releases.length == usize.ZERO && attempts < EMPTY_LISTING_ATTEMPTS { continue }
    let mut index = usize.ZERO
    while index < releases.length {
      let release = run item(&releases[index])
      if !(run requiredBool(release, "draft")) {
        let tag = run requiredString(release, "tag_name")
        if Text.starts(tag, "v") {
          let version = Text.part(tag, usize.ONE, String.byteLength(tag))
          run Version.validate(version)
          if !Version.isPrerelease(version) || discoverableDev(version) {
            if String.view(&selected) == "" {
              selected = run String.copy(version)
            } else {
              let order = run Version.compare(version, String.view(&selected))
              if order == 0 && version != String.view(&selected) { ambiguous = true }
              if order > 0 {
                selected = run String.copy(version)
                ambiguous = false
              }
            }
          }
        }
      }
      index = index + usize.ONE
    }
    if releases.length < 100 { break }
    page = page + usize.ONE
  }
  if String.view(&selected) == "" { fail Problem { message: "No published stable or dev GitHub release is available." } }
  if ambiguous {
    fail Problem { message: "GitHub releases have ambiguous highest-precedence versions with different build metadata; choose an exact --to version." }
  }
  // Fetch the winning exact release only after selection, so historical releases
  // without snapshots do not prevent discovery of a newer snapshot-bearing release.
  return run resolve(repository, "", String.view(&selected), "")
}

/// Explicit targets preserve full SemVer identity. Dev baselines follow the highest
/// eligible dev/stable version; stable baselines prefer stable, then dev if none exists.
/// `directory` identifies the configured package, not a path into the release asset.
pub effect fn resolve(repository: string, directory: string, to: string, from: string) -> Publication
! Problem | HttpError | OutOfMemoryError ? &mut Http | &mut Allocator {
  run validateRepository(repository)
  run validateDirectory(directory)
  if from != "" { run Version.validate(from) }
  if to == "" && Snapshot.isDev(from) { return run discover(repository) }
  if to != "" { run Version.validate(to) }
  let mut url = run endpoint(repository, "/releases/")
  if to == "" {
    run String.append(&mut url, "latest")
  } else {
    run String.append(&mut url, "tags/v")
    run appendComponent(&mut url, to)
  }
  let response = run Http.get(String.view(&url))
  if to == "" && response.status == 404 { return run discover(repository) }
  run successful(response.status)
  let document = run releaseDocument(&response.body)
  return run publication(repository, &document, to, to == "")
}

effect fn snapshot(publication: &Publication) -> Snapshot.Record
! Problem | HttpError | OutOfMemoryError ? &mut Http | &mut Allocator {
  let response = run Http.get(String.view(&publication.snapshotUrl))
  run successful(response.status)
  return run Snapshot.decode(move response.body, String.view(&publication.version))
}

/// Both sides come from their own exact published release assets. Only an exact
/// target coverage floor avoids fetching a baseline release that need not exist.
pub effect fn query(publication: &Publication, packageName: string, from: string) -> List<Record>
! Problem | HttpError | OutOfMemoryError ? &mut Http | &mut Allocator {
  run Version.validate(from)
  let target = run snapshot(publication)
  if from == String.view(&target.floor) { return run Snapshot.fromFloor(move target, packageName, from) }
  let baselinePublication = run resolve(String.view(&publication.repository), "", from, from)
  let baseline = run snapshot(&baselinePublication)
  return run Snapshot.compare(&baseline, move target, packageName)
}
