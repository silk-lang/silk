//! Process-fatal internal invariant failures. No diagnostic, allocation, or query publication.

import silk.mem.pointer {Pointer}
import silk.num.isize
import silk.num.usize

static if Intrinsic.targetOperatingSystem() == "windows" {
  unsafe extern "C" fn GetStdHandle(selector: u32) -> ?*mut u8
  @foreign(noCapture: ("buffer", "written", "overlapped"))
  unsafe extern "C" fn WriteFile(handle: ?*mut u8, buffer: ?[*]const u8, count: u32, written: *mut u32, overlapped: ?*mut u8) -> i32
  import silk.num.u32
  import silk.collections.slice {Slice}
} else {
  @foreign(noCapture: ("buffer",))
  unsafe extern "C" fn write(fd: i32, buffer: ?[*]const u8, count: usize) -> isize
  unsafe extern "C" fn abort() -> ()
}

fn writeBytes(bytes: &[u8]) -> () {
  static if Intrinsic.targetOperatingSystem() == "windows" {
    let handle = unsafe GetStdHandle(4294967284)
    let mut offset: usize = 0
    while offset < bytes.length {
      let mut count = bytes.length - offset
      if count > 2147483647 { count = 2147483647 }
      let mut written: u32 = 0
      let pointer = Pointer.fromSlice(Slice.view(bytes, offset, count))
      if unsafe WriteFile(handle, pointer, usize.toU32(count), Pointer.fromMutRef(&mut written), Pointer.null<u8>()) == 0 { return () }
      if written == 0 || u32.toUsize(written) > count { return () }
      offset = offset + u32.toUsize(written)
    }
  } else {
  let _written = unsafe write(2, Pointer.fromSlice<u8>(bytes), bytes.length)
  }
  return ()
}

/// Aborts at the violated invariant, before it can become a cached program verdict.
pub fn panic(reason: &[u8]) -> never {
  writeBytes(b"Internal compiler error: ")
  writeBytes(reason)
  writeBytes(b". This is a compiler bug, please report it.\n")
  static if Intrinsic.targetOperatingSystem() == "windows" {
    Intrinsic.trap("Internal compiler error")
  } else {
    unsafe abort()
  }
  // abort never returns; keep the source contract divergent without a compiler intrinsic.
  return panic(reason)
}
