//! Process-fatal internal invariant failures. No diagnostic, allocation, or query publication.

import silk.pointer {Pointer}
import silk.isize
import silk.usize

unsafe extern "C" fn write(fd: i32, buffer: ?[*]const u8, count: usize) -> isize
with Intrinsic.foreign(noCapture: ("buffer",))
unsafe extern "C" fn abort() -> ()

fn writeBytes(bytes: &[u8]) -> () {
  let written = unsafe write(2, Pointer.fromSlice<u8>(bytes), bytes.length)
  return ()
}

/// Aborts at the violated invariant, before it can become a cached program verdict.
pub fn panic(reason: &[u8]) -> never {
  writeBytes(b"Internal compiler error: ")
  writeBytes(reason)
  writeBytes(b". This is a compiler bug, please report it.\n")
  unsafe abort()
  // abort never returns; keep the source contract divergent without a compiler intrinsic.
  return panic(reason)
}
