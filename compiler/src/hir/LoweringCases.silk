effect fn checkElseIfChain() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let module = run lowerBodyOf(
    "fn main(a: bool, b: bool) -> i32 { if a { } else if b { } else { } }",
  )
  // The outer conditional is appended last, so the chained one precedes it in the arena.
  let outerIndex = findLastKind(&module, Sought.Conditional)
  run Testing.expect(outerIndex < Module.length(&module), "the body holds a conditional")
  if let Node.ConditionalStatement {
    condition: ignoredCondition,
    thenBranch: ignoredThen,
    elseBranch,
  } = Module.node(&module, HirId {index: outerIndex}) {
    run Testing.expect(elseBranch.present, "a written `else` keeps its branch")
    match Module.node(&module, elseBranch.id) {
      Node.ConditionalStatement {
        condition: ignoredInnerCondition,
        thenBranch: ignoredInnerThen,
        elseBranch: innerElse,
      } => {
        run Testing.expect(
          innerElse.present,
          "an `else if` chain nests: the chained conditional is the else branch",
        )
        match Module.node(&module, innerElse.id) {
          Node.Block {statements: ignoredStatements} => {}
          _ => { run Testing.expect(false, "the final `else` is a block") }
        }
      }
      _ => { run Testing.expect(false, "the else branch of an `else if` is a conditional") }
    }
  } else {
    run Testing.expect(false, "the outermost statement is a conditional")
  }
  let defects = run Hir.verify(&module)
  run Testing.expect(
    Vector.length<Defect>(&defects) == usize.ZERO,
    "the lowered module satisfies every flat invariant",
  )
  drop defects
  drop module
  return ()
}

test effect fn elseIfChainsNestTheirConditionals() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkElseIfChain() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn checkInvalidStatement() -> ()
! OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let module = run lowerBodyOf("fn main() -> i32 { ] 7 }")
  let invalid = findKind(&module, Sought.InvalidStatement)
  run Testing.expect(invalid < Module.length(&module), "a damaged statement keeps its place")
  let range = Module.causeRange(&module, HirId {index: invalid})
  run Testing.expect(range.length > usize.ZERO, "it records why it is damaged")
  let healthy = findKind(&module, Sought.IntegerLiteral)
  run Testing.expect(
    healthy < Module.length(&module),
    "the healthy statement after it survives the damage",
  )
  let defects = run Hir.verify(&module)
  run Testing.expect(
    Vector.length<Defect>(&defects) == usize.ZERO,
    "the lowered module satisfies every flat invariant",
  )
  drop defects
  drop module
  return ()
}

test effect fn invalidStatementsRetainHealthySiblings() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkInvalidStatement() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn checkSubordinateDuration() -> ()
! OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  // The lexer applies the subordinate-range rule, so the lowering sees an invalid literal token.
  let rejected = run lowerExpression(
    "fn main() -> i32 { return 1h90m }",
    NodeKind.DurationLiteralExpression,
  )
  run Testing.expect(
    findKind(&rejected, Sought.InvalidExpression) < Module.length(&rejected),
    "a subordinate component beyond its range does not lower to a duration",
  )
  run Testing.expect(
    hasCause(&rejected, CauseCode.InvalidLiteralEncoding),
    "the rejected literal records why it is not a duration",
  )
  drop rejected
  let leading = run lowerExpression(
    "fn main() -> i32 { return 90m }",
    NodeKind.DurationLiteralExpression,
  )
  run Testing.expect(
    findKind(&leading, Sought.DurationLiteral) < Module.length(&leading),
    "a leading component names a whole amount, so `90m` stays a duration",
  )
  let defects = run Hir.verify(&leading)
  run Testing.expect(
    Vector.length<Defect>(&defects) == usize.ZERO,
    "the lowered module satisfies every flat invariant",
  )
  drop defects
  drop leading
  return ()
}

test effect fn durationsRejectOutOfRangeSubordinates() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkSubordinateDuration() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn checkPrecedenceShape() -> ()
! OutOfMemoryError | WriterError | AssertionError<'static>
? &mut Allocator {
  let module = run lowerExpressionOf(
    "fn main(a: i32) -> i32 { return -a.b * 2 + 1 }",
    NodeKind.InfixExpression,
  )
  let rendered = run Hir.render(&module)
  let expected = String.utf8Bytes(
    """documentation none
declarations [#8]

nodes 9
#0 Name 33..34
  text: "a"
#1 IdentifierExpression 33..34
  name: #0
  binding: none
#2 Name 35..36
  text: "b"
#3 FieldExpression 33..36
  subject: #1
  field: #2
#4 PrefixExpression 32..36
  operator: Negate
  operatorAnchor: 32..33
  operand: #3
#5 IntegerLiteral 39..40
  sign: Positive
  magnitude: 2
  radix: Decimal
  suffix: none
#6 InfixExpression 32..40
  operator: Multiply
  operatorAnchor: 37..38
  left: #4
  right: #5
#7 IntegerLiteral 43..44
  sign: Positive
  magnitude: 1
  radix: Decimal
  suffix: none
#8 InfixExpression 32..44
  operator: Add
  operatorAnchor: 41..42
  left: #6
  right: #7

causes 0

diagnostics 0
""",
  )
  run Testing.expect(
    bytesEqual(Vector.asSlice<u8>(&rendered), expected),
    "`-a.b * 2 + 1` groups as `((-(a.b)) * 2) + 1`, postorder in the arena",
  )
  drop rendered
  let defects = run Hir.verify(&module)
  run Testing.expect(
    Vector.length<Defect>(&defects) == usize.ZERO,
    "the lowered module satisfies every flat invariant",
  )
  drop defects
  drop module
  return ()
}

test effect fn precedenceSurvivesLowering() -> ()
! OutOfMemoryError | WriterError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkPrecedenceShape() |> Effect.provideMut<Allocator>(&mut allocator)
}

// ---------------------------------------------------------------------------
// Declarations and module assembly
// ---------------------------------------------------------------------------

/// Lowers a whole source file into a module, as the executable's `hir` dump would.
effect fn lowerSource(source: string<'static>) -> Module ! OutOfMemoryError ? &mut Allocator {
  let tree = run ParserCases.parseWithAllocator(source)
  let module = run Lower.lower(&tree)
  drop tree
  return move module
}

/// Returns the identity of the module's declaration at `offset` among its top-level declarations.
fn declarationAt(module: &Module, offset: usize) -> HirId {
  return Module.child(module, module.declarations, offset)
}

/// Returns the owner key of the declaration node `id`, or a damaged key when `id` is not one.
fn ownerOf(module: &Module, id: HirId) -> OwnerKey {
  if let Node.Declaration {owner, ..} = Module.node(module, id) {
    return owner
  }
  return OwnerKey {kind: OwnerKind.Damaged, name: SymbolRef.absent(), occurrence: usize.ZERO}
}

/// Reports whether `name` is present and interns exactly `expected`.
fn symbolIs(module: &Module, name: SymbolRef, expected: string<'static>) -> bool {
  if !name.present {
    return false
  }
  return bytesEqual(Module.text(module, name.symbol), String.utf8Bytes(expected))
}

/// Returns the members of `id`'s body, or the empty range when its body holds none.
fn membersOf(module: &Module, id: HirId) -> Range {
  if let Node.Declaration {body, ..} = Module.node(module, id) {
    if let Node.MembersBody {members} = Module.node(module, body) {
      return members
    }
  }
  return Range.empty()
}

effect fn checkOwnerKeys() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let module = run lowerSource(
    "fn same() -> () { return () }\nfn same() -> () { return () }\nstruct same {}\n",
  )
  run Testing.expect(
    module.declarations.length == usize.add(0, 3),
    "three top-level declarations lower into three declaration nodes",
  )
  let first = ownerOf(&module, declarationAt(&module, usize.ZERO))
  let second = ownerOf(&module, declarationAt(&module, usize.ONE))
  let third = ownerOf(&module, declarationAt(&module, usize.add(0, 2)))
  run Testing.expect(
    first.kind == OwnerKind.Function && symbolIs(&module, first.name, "same") && first.occurrence == usize.ZERO,
    "the first function takes occurrence zero",
  )
  run Testing.expect(
    second.kind == OwnerKind.Function && second.occurrence == usize.ONE,
    "a same-named sibling takes the next occurrence",
  )
  run Testing.expect(
    third.kind == OwnerKind.Struct && third.occurrence == usize.ZERO,
    "a different kind with the same name restarts at occurrence zero",
  )
  run Testing.expect(
    first.name.symbol.index == second.name.symbol.index,
    "same-named siblings share one interned name symbol",
  )
  drop module
  return ()
}

test effect fn sameNameSiblingsTakeDistinctOccurrences() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkOwnerKeys() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn checkImplementationKey() -> ()
! OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let module = run lowerSource(
    "impl Eq for Point {\n  fn eq(self: &Self) -> bool { return true }\n}\nimpl Point {\n  fn size(self: &Self) -> usize { return 0 }\n}\n",
  )
  let paired = ownerOf(&module, declarationAt(&module, usize.ZERO))
  let inherent = ownerOf(&module, declarationAt(&module, usize.ONE))
  run Testing.expect(
    paired.kind == OwnerKind.Implementation && symbolIs(&module, paired.name, "Eq for Point"),
    "an interface implementation names itself `subject for target`",
  )
  run Testing.expect(
    inherent.kind == OwnerKind.Implementation && symbolIs(&module, inherent.name, "Point"),
    "an inherent implementation names itself by its subject alone",
  )
  let members = membersOf(&module, declarationAt(&module, usize.ZERO))
  run Testing.expect(members.length == usize.ONE, "the implementation body holds its one function")
  let member = ownerOf(&module, Module.child(&module, members, usize.ZERO))
  run Testing.expect(
    member.kind == OwnerKind.Function && symbolIs(&module, member.name, "eq") && member.occurrence == usize.ZERO,
    "a member key is scoped to its implementation, so it restarts at occurrence zero",
  )
  let defects = run Hir.verify(&module)
  run Testing.expect(
    Vector.length<Defect>(&defects) == usize.ZERO,
    "a module of two implementations satisfies every flat invariant",
  )
  drop defects
  drop module
  return ()
}

test effect fn implementationsNameTheirSubjectAndTarget() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkImplementationKey() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn checkConditionalArms() -> ()
! OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let module = run lowerSource(
    "static if DEBUG {\n  fn on() -> () { return () }\n} else {\n  fn off() -> () { return () }\n}\n",
  )
  run Testing.expect(
    module.declarations.length == usize.ONE,
    "a static conditional is one top-level declaration",
  )
  let conditional = declarationAt(&module, usize.ZERO)
  let key = ownerOf(&module, conditional)
  run Testing.expect(
    key.kind == OwnerKind.Conditional && !key.name.present,
    "a static conditional names nothing",
  )
  let mut thenBranch = HirId {index: usize.ZERO}
  let mut elseBranch = HirRef.absent()
  if let Node.Declaration {body, ..} = Module.node(&module, conditional) {
    if let Node.ConditionalBody {thenBranch: found, elseBranch: other}
      = Module.node(&module, body) {
      thenBranch = found
      elseBranch = other
    }
  }
  run Testing.expect(elseBranch.present, "a written `else` arm is retained beside the `then` arm")
  let thenMembers = membersOf(&module, thenBranch)
  let elseMembers = membersOf(&module, elseBranch.id)
  run Testing.expect(
    thenMembers.length == usize.ONE && elseMembers.length == usize.ONE,
    "both arms lower their members, including the one the condition will not select",
  )
  let taken = ownerOf(&module, Module.child(&module, thenMembers, usize.ZERO))
  let skipped = ownerOf(&module, Module.child(&module, elseMembers, usize.ZERO))
  run Testing.expect(
    symbolIs(&module, taken.name, "on") && symbolIs(&module, skipped.name, "off"),
    "each arm keeps the declaration it actually wrote",
  )
  let mut thenIsThen = false
  if let Node.Declaration {header, ..} = Module.node(&module, thenBranch) {
    if let Node.GroupHeader {branch} = Module.node(&module, header) {
      thenIsThen = branch == GroupBranch.Then
    }
  }
  run Testing.expect(thenIsThen, "the first arm records the `Then` branch")
  drop module
  return ()
}

test effect fn staticConditionalsLowerBothArms() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkConditionalArms() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn checkVariantBraces() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let module = run lowerSource("union Shape {\n  Dot,\n  Empty {},\n  Circle {r: f64},\n}\n")
  let mut variants = Range.empty()
  if let Node.Declaration {header, ..} = Module.node(&module, declarationAt(&module, usize.ZERO)) {
    if let Node.UnionHeader {name: ignoredName, isPublic: ignoredPublic, generics: ignoredGenerics, variants: found}
      = Module.node(&module, header) {
      variants = found
    }
  }
  run Testing.expect(variants.length == usize.add(0, 3), "three variants lower into three nodes")
  let mut unitHasBraces = true
  let mut emptyHasBraces = false
  let mut emptyFields = usize.ONE
  let mut payloadFields = usize.ZERO
  if let Node.Variant {name: ignoredUnitName, fields: ignoredUnitFields, braces}
    = Module.node(&module, Module.child(&module, variants, usize.ZERO)) {
    unitHasBraces = braces
  }
  if let Node.Variant {name: ignoredEmptyName, fields, braces: emptyBraces}
    = Module.node(&module, Module.child(&module, variants, usize.ONE)) {
    emptyHasBraces = emptyBraces
    emptyFields = fields.length
  }
  if let Node.Variant {name: ignoredCircleName, fields: circleFields, braces: ignoredCircleBraces}
    = Module.node(&module, Module.child(&module, variants, usize.add(0, 2))) {
    payloadFields = circleFields.length
  }
  run Testing.expect(!unitHasBraces, "a unit variant writes no field block")
  run Testing.expect(
    emptyHasBraces && emptyFields == usize.ZERO,
    "an empty field block stays distinct from a unit variant",
  )
  run Testing.expect(payloadFields == usize.ONE, "a payload variant keeps its declared field")
  drop module
  return ()
}

test effect fn unionVariantsRecordTheirFieldBlock() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkVariantBraces() |> Effect.provideMut<Allocator>(&mut allocator)
}

/// Returns the `///` block interned on declaration `id`.
fn documentationOf(module: &Module, id: HirId) -> SymbolRef {
  if let Node.Declaration {documentation, ..} = Module.node(module, id) {
    return documentation
  }
  return SymbolRef.absent()
}

effect fn checkDocumentation() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let documented = run lowerSource(
    "//! The module.\n//! Second line.\n\n/// The function.\n/// Second line.\nfn work() -> () { return () }\n",
  )
  run Testing.expect(
    documented.documentation.present,
    "a leading `//!` block becomes the module's documentation",
  )
  run Testing.expect(
    symbolIs(&documented, documented.documentation, "//! The module.\n//! Second line."),
    "the module block interns every comment it spans, joined as written",
  )
  let attached = documentationOf(&documented, declarationAt(&documented, usize.ZERO))
  run Testing.expect(
    symbolIs(&documented, attached, "/// The function.\n/// Second line."),
    "a `///` block attaches to the declaration that follows it",
  )
  drop documented
  let undocumented = run lowerSource(
    "\n/// Detached by a blank line.\n\nfn work() -> () { return () }\n",
  )
  run Testing.expect(
    !undocumented.documentation.present,
    "a file with no `//!` block documents nothing",
  )
  run Testing.expect(
    !documentationOf(&undocumented, declarationAt(&undocumented, usize.ZERO)).present,
    "a blank line detaches a `///` block from the declaration after it",
  )
  drop undocumented
  let detached = run lowerSource("//! The module.\n\nfn work() -> () { return () }\n")
  run Testing.expect(
    detached.documentation.present,
    "a blank line after the module block does not detach it from the module",
  )
  drop detached
  return ()
}

test effect fn moduleDocumentationIsInterned() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkDocumentation() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn checkDiagnosticsCopied() -> ()
! OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let source = "fn work( -> () { return () }\n"
  let module = run lowerSource(source)
  run Testing.expect(
    Vector.length<Hir.Diagnostic>(&module.diagnostics) > usize.ZERO,
    "a parser diagnostic is copied into the module",
  )
  let first = Vector.get<Hir.Diagnostic>(&module.diagnostics, usize.ZERO)
  // The missing `)` is inserted at the start of the `->` token that follows the open list.
  let bytes = String.utf8Bytes(source)
  let mut arrow = usize.ZERO
  while arrow < bytes.length && bytes[arrow] != 45 {
    arrow = arrow + usize.ONE
  }
  run Testing.expect(
    first.code == CauseCode.MissingToken && first.span.start == arrow && first.span.end == arrow,
    "the copied diagnostic keeps its code and its insertion point in module coordinates",
  )
  let enclosing = Module.span(&module, declarationAt(&module, usize.ZERO))
  run Testing.expect(
    enclosing.start <= first.span.start && first.span.end <= enclosing.end,
    "the diagnostic falls inside the declaration that encloses it, so its owner is derivable",
  )
  let defects = run Hir.verify(&module)
  run Testing.expect(
    Vector.length<Defect>(&defects) == usize.ZERO,
    "a damaged source still lowers into a consistent arena",
  )
  drop defects
  drop module
  return ()
}

test effect fn parserDiagnosticsReachTheModule() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkDiagnosticsCopied() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn checkBroadModule() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let module = run lowerSource(
    """import a.b {C as D}
pub struct Point<T> {
  pub x: i32
  y: T
}
pub union Shape {
  Circle {r: f64},
  Dot,
}
pub enum(u8) Color {
  Red = 1,
  Blue,
}
tuple Pair<T>(i32, T)
pub type Alias<T> = Vector<T>
role Reader
pub const LIMIT: usize = 10
param DEBUG: bool = false where DEBUG
export "C" static counter: i32 = 0
module with module.property(name: "v")
pub service Clock {
  effect fn now() -> u64
}
interface Eq {
  fn eq(self: &Self) -> bool
  operator == fn same(self: &Self) -> bool
}
impl Eq for Point {
  eq: Point.eq
  fn eq(self: &Self) -> bool { return true }
}
extern "C" fn puts(text: *const u8) -> i32
pub effect fn main() -> () { return () }
""",
  )
  run Testing.expect(
    Vector.length<Hir.Diagnostic>(&module.diagnostics) == usize.ZERO,
    "a syntactically clean file records no frontend diagnostic",
  )
  run Testing.expect(
    Vector.length<Cause>(&module.causes) == usize.ZERO,
    "a syntactically clean file lowers with no recovery cause",
  )
  run Testing.expect(
    module.declarations.length == usize.add(0, 16),
    "every top-level declaration of the file lowers into its own declaration node",
  )
  run Testing.expect(
    Vector.length<Span>(&module.spans) == Module.length(&module),
    "every node carries exactly one span",
  )
  run Testing.expect(
    Vector.length<Range>(&module.nodeCauses) == Module.length(&module),
    "every node carries exactly one cause run",
  )
  let defects = run Hir.verify(&module)
  run Testing.expect(
    Vector.length<Defect>(&defects) == usize.ZERO,
    "children precede parents and every reference is in range across a broad module",
  )
  drop defects
  drop module
  return ()
}

test effect fn aBroadModuleSatisfiesEveryFlatInvariant() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkBroadModule() |> Effect.provideMut<Allocator>(&mut allocator)
}

// ---------------------------------------------------------------------------
// Canonical encoding and fingerprints
// ---------------------------------------------------------------------------

/// Reports whether the declaration at `left` of one source encodes as the one at `right` of another.
effect fn sameHeader(
  first: &Module,
  left: usize,
  second: &Module,
  right: usize,
) -> bool
! OutOfMemoryError
? &mut Allocator {
  let a = run Fingerprint.header(first, declarationAt(first, left))
  let b = run Fingerprint.header(second, declarationAt(second, right))
  let answer = bytesEqual(Vector.asSlice<u8>(&a), Vector.asSlice<u8>(&b))
  drop a
  drop b
  return answer
}

/// Reports whether two declarations' body encodings agree.
effect fn sameBody(
  first: &Module,
  left: usize,
  second: &Module,
  right: usize,
) -> bool
! OutOfMemoryError
? &mut Allocator {
  let a = run Fingerprint.body(first, declarationAt(first, left))
  let b = run Fingerprint.body(second, declarationAt(second, right))
  let answer = bytesEqual(Vector.asSlice<u8>(&a), Vector.asSlice<u8>(&b))
  drop a
  drop b
  return answer
}

effect fn checkIntegerFingerprintContent() -> ()
! OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let decimal = run lowerSource("""fn work() -> i32 { return 18446744073709551616 }
""")
  let separated = run lowerSource("""fn work() -> i32 { return 18_446_744_073_709_551_616 }
""")
  let hexadecimal = run lowerSource("""fn work() -> i32 { return 0x1_0000_0000_0000_0000 }
""")
  let changed = run lowerSource("""fn work() -> i32 { return 18446744073709551617 }
""")
  run Testing.expect(
    run sameBody(&decimal, usize.ZERO, &separated, usize.ZERO),
    "separators do not change an exact integer fingerprint",
  )
  run Testing.expect(
    !(run sameBody(&decimal, usize.ZERO, &hexadecimal, usize.ZERO)),
    "the written radix distinguishes equal magnitudes",
  )
  run Testing.expect(
    !(run sameBody(&decimal, usize.ZERO, &changed, usize.ZERO)),
    "a change beyond u64 changes the exact integer fingerprint",
  )
  return ()
}

effect fn checkFloatFingerprintContent() -> ()
! OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let decimal = run lowerSource("""fn work() -> f64 { return 184467440737095516160000.0e-4 }
""")
  let separated = run lowerSource("""fn work() -> f64 { return 184_467_440_737_095_516_160_000.0e-4 }
""")
  let changed = run lowerSource("""fn work() -> f64 { return 184467440737095516160001.0e-4 }
""")
  run Testing.expect(
    run sameBody(&decimal, usize.ZERO, &separated, usize.ZERO),
    "digit separators do not change the floating fingerprint",
  )
  run Testing.expect(
    !(run sameBody(&decimal, usize.ZERO, &changed, usize.ZERO)),
    "a coefficient change beyond u64 changes the floating fingerprint",
  )
  return ()
}

test effect fn floatingFingerprintKeepsExactDigits() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkFloatFingerprintContent() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn integerFingerprintsKeepExactContent() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkIntegerFingerprintContent() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn checkReorderingKeepsBytes() -> ()
! OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let straight = run lowerSource("""fn alpha() -> i32 { return 1 }
fn beta() -> i32 { return 2 }
""")
  let swapped = run lowerSource("""fn beta() -> i32 { return 2 }
fn alpha() -> i32 { return 1 }
""")
  let padded = run lowerSource("""fn alpha() -> i32 {  return 1 }

// between declarations
fn beta() -> i32 { return 2 }
""")
  run Testing.expect(
    run sameHeader(&straight, usize.ZERO, &swapped, usize.ONE),
    "reordering two uniquely named declarations leaves `alpha`'s header bytes alone",
  )
  run Testing.expect(
    run sameBody(&straight, usize.ZERO, &swapped, usize.ONE),
    "reordering two uniquely named declarations leaves `alpha`'s body bytes alone",
  )
  run Testing.expect(
    run sameHeader(&straight, usize.ONE, &swapped, usize.ZERO),
    "reordering leaves `beta`'s header bytes alone too, so neither one paid for the move",
  )
  run Testing.expect(
    run sameBody(&straight, usize.ONE, &swapped, usize.ZERO),
    "reordering leaves `beta`'s body bytes alone too",
  )
  let straightDigest = run Fingerprint.moduleDigest(&straight)
  let swappedDigest = run Fingerprint.moduleDigest(&swapped)
  let paddedDigest = run Fingerprint.moduleDigest(&padded)
  run Testing.expect(
    !bytesEqual(&straightDigest, &swappedDigest),
    "the module digest sees the declaration order that the per-declaration digests ignore",
  )
  run Testing.expect(
    bytesEqual(&straightDigest, &paddedDigest),
    "trivia between declarations never reaches the module digest",
  )
  drop straight
  drop swapped
  drop padded
  return ()
}

test effect fn reorderingMovesOnlyTheModuleDigest() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkReorderingKeepsBytes() |> Effect.provideMut<Allocator>(&mut allocator)
}

/// Lowers one baseline declaration once and compares each half against focused edits of it.
effect fn checkDeclarationHalves() -> ()
! OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let plain = run lowerSource("""fn work(value: i32) -> i32 { return value }
""")
  let padded = run lowerSource("""
// a leading comment
fn work(  value : i32 )  ->  i32  {
  // inside
  return value
}

""")
  run Testing.expect(
    run sameHeader(&plain, usize.ZERO, &padded, usize.ZERO),
    "comments and spacing never reach the header bytes",
  )
  run Testing.expect(
    run sameBody(&plain, usize.ZERO, &padded, usize.ZERO),
    "comments and spacing never reach the body bytes",
  )
  drop padded
  let crowded = run lowerSource("""fn unrelated(first: i64, second: u8) -> u8 { return second }
fn work(value: i32) -> i32 { return value }
""")
  run Testing.expect(
    run sameHeader(&plain, usize.ZERO, &crowded, usize.ONE),
    "interning other declarations' strings first does not move `work`'s header bytes",
  )
  run Testing.expect(
    run sameBody(&plain, usize.ZERO, &crowded, usize.ONE),
    "a symbol frames its interned text, so its index never reaches the body bytes",
  )
  drop crowded
  let bodyEdit = run lowerSource("""fn work(value: i32) -> i32 { return 0 }
""")
  run Testing.expect(
    run sameHeader(&plain, usize.ZERO, &bodyEdit, usize.ZERO),
    "editing only the return expression leaves the header bytes identical",
  )
  run Testing.expect(
    !(run sameBody(&plain, usize.ZERO, &bodyEdit, usize.ZERO)),
    "editing the return expression changes the body bytes",
  )
  drop bodyEdit
  let retyped = run lowerSource("""fn work(value: i64) -> i32 { return value }
""")
  run Testing.expect(
    !(run sameHeader(&plain, usize.ZERO, &retyped, usize.ZERO)),
    "changing a parameter type changes the header bytes",
  )
  run Testing.expect(
    run sameBody(&plain, usize.ZERO, &retyped, usize.ZERO),
    "the body reaches its parameter by ordinal, so retyping it leaves the body bytes alone",
  )
  drop retyped
  let id = declarationAt(&plain, usize.ZERO)
  let headerBytes = run Fingerprint.header(&plain, id)
  let bodyBytes = run Fingerprint.body(&plain, id)
  run Testing.expect(
    Vector.length<u8>(&headerBytes) > usize.ZERO
      && Vector.length<u8>(&bodyBytes) > usize.ZERO,
    "both halves encode to a non-empty frame sequence",
  )
  run Testing.expect(
    !bytesEqual(Vector.asSlice<u8>(&headerBytes), Vector.asSlice<u8>(&bodyBytes)),
    "the domain frame keeps a header from ever colliding with a body",
  )
  let headerHash = run Fingerprint.headerDigest(&plain, id)
  let bodyHash = run Fingerprint.bodyDigest(&plain, id)
  run Testing.expect(
    !bytesEqual(&headerHash, &bodyHash),
    "the two digests answer for the two halves they were asked about",
  )
  let mut hex = Vector.make<u8>()
  run Fingerprint.appendHex(&mut hex, &headerHash)
  run Testing.expect(
    Vector.length<u8>(&hex) == usize.add(0, 64),
    "a 32-byte SHA-256 digest spells as 64 hexadecimal digits",
  )
  drop hex
  drop headerBytes
  drop bodyBytes
  drop plain
  return ()
}

test effect fn declarationHalvesEncodeOnlyTheirOwnContent() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkDeclarationHalves() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn checkDamagedBodiesAreStable() -> ()
! OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let damaged = run lowerSource("""fn work() -> i32 { ] 0 }
""")
  let shifted = run lowerSource("""fn other() -> i32 { return 1 }
fn work() -> i32 { ] 0 }
""")
  run Testing.expect(
    Vector.length<Cause>(&damaged.causes) > usize.ZERO,
    "the fixture body reaches statement recovery",
  )
  run Testing.expect(
    run sameBody(&damaged, usize.ZERO, &shifted, usize.ONE),
    "a recovery cause frames only its code, so a damaged body encodes the same bytes anywhere in its file",
  )
  run Testing.expect(
    run sameHeader(&damaged, usize.ZERO, &shifted, usize.ONE),
    "a damaged declaration's header bytes do not depend on its file position",
  )
  let healthy = run lowerSource("""fn work() -> i32 { 0 }
""")
  run Testing.expect(
    !(run sameBody(&damaged, usize.ZERO, &healthy, usize.ZERO)),
    "a recovery cause is content, so a damaged body never matches the repaired one",
  )
  drop damaged
  drop shifted
  drop healthy
  return ()
}

test effect fn aDamagedBodyEncodesStableBytes() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkDamagedBodiesAreStable() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn checkBindersUseOrdinals() -> ()
! OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let first = run lowerSource("""fn work(a: i32, b: i32) -> i32 { return a }
""")
  let second = run lowerSource("""fn work(b: i32, a: i32) -> i32 { return a }
""")
  run Testing.expect(
    !(run sameBody(&first, usize.ZERO, &second, usize.ZERO)),
    "the same spelling bound to a different parameter ordinal changes the body bytes",
  )
  drop first
  drop second
  return ()
}

test effect fn bindersEncodeAsPreorderOrdinals() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkBindersUseOrdinals() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn checkQuotedTextEscapes() -> ()
! OutOfMemoryError | WriterError | AssertionError<'static>
? &mut Allocator {
  let module = run lowerSource(
    "/// One \"quoted\" line.\n/// Second line.\nconst greeting: string = \"say \\\"hi\\\"\\n\"\n",
  )
  let rendered = run Hir.render(&module)
  let expected = String.utf8Bytes(
    """documentation none
declarations [#7]

nodes 8
#0 Name 46..54
  text: "greeting"
#1 Name 56..62
  text: "string"
#2 Path 56..62
  segments: [#1]
#3 NamedType 56..62
  path: #2
  hasMode: false
  mode: Shared
#4 ConstantHeader 40..79
  name: #0
  isPublic: false
  annotation: #3
#5 TextLiteral 65..79
  value: "say \\"hi\\"\\n"
#6 InitializerBody 40..79
  value: #5
#7 Declaration 40..79
  owner: Constant "greeting" #0
  documentation: "/// One \\"quoted\\" line.\\n/// Second line."
  header: #4
  body: #6

causes 0

diagnostics 0
""",
  )
  run Testing.expect(
    bytesEqual(Vector.asSlice<u8>(&rendered), expected),
    "a quote and a line break inside interned text escape, so every field stays on one line",
  )
  drop rendered
  let mut payload = SymbolRef.absent()
  if let Node.TextLiteral {value: text} = Module.node(&module, HirId {index: usize.add(0, 5)}) {
    payload = SymbolRef.of(text)
  }
  run Testing.expect(
    symbolIs(&module, payload, "say \"hi\"\n"),
    "the escape is a property of the dump; the interned bytes stay exactly as decoded",
  )
  drop module
  return ()
}

test effect fn quotedTextEscapesInTheDump() -> ()
! OutOfMemoryError | WriterError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkQuotedTextEscapes() |> Effect.provideMut<Allocator>(&mut allocator)
}
