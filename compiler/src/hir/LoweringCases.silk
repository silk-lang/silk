    _ => { run Testing.expect(false, "the binder is the enclosing parameter") }
  }
  let defects = run Hir.verify(&module)
  run Testing.expect(
    Vector.length<Defect>(&defects) == usize.ZERO,
    "the lowered module satisfies every flat invariant",
