  let module = Module.make()
  let defects = run Hir.verify(&module)
  run Testing.expect(
    Vector.length<Defect>(&defects) == usize.ZERO,
    "an empty module satisfies every arena invariant",
  )
  drop defects
  return ()
}

test effect fn emptyModuleVerifies() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run verifyEmpty() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn renderEmpty() -> () ! WriterError | AssertionError<'static> {
  let module = Module.make()
  let rendered = run Hir.render(&module)
  let expected = String.utf8Bytes(
    """documentation none
declarations []

nodes 0

causes 0

diagnostics 0
""",
  )
  run Testing.expect(
    bytesEqual(Vector.asSlice<u8>(&rendered), expected),
    "an empty module renders its section headers only",
  )
  drop rendered
  return ()
}

test effect fn emptyModuleRenders() -> () ! WriterError | AssertionError<'static> {
  return run renderEmpty()
}

/// Appends one node with its span and its (usually empty) recovery-cause run.
effect fn appendNode(module: &mut Module, node: Node, span: Span, causes: Range) -> HirId
! OutOfMemoryError
? &mut Allocator {
  let index = Vector.length<Node>(&module.nodes)
  run Vector.append<Node>(&mut module.nodes, node)
  run Vector.append<Span>(&mut module.spans, span)
  run Vector.append<Range>(&mut module.nodeCauses, causes)
  return HirId {index: index}
}

/// Builds `pub role Clock` reduced to the three nodes this test needs.
effect fn buildModule() -> Module ! OutOfMemoryError ? &mut Allocator {
  let mut module = Module.make()
  let clock = run Module.intern(&mut module, String.utf8Bytes("Clock"))
  let name = run appendNode(
    &mut module,
    Node.Name {text: clock},
    Span.make(9, 14),
    Range.empty(),
  )
  let header = run appendNode(
    &mut module,
    Node.RoleHeader {name: name, isPublic: true},
    Span.make(0, 14),
    Range.empty(),
  )
  let body = run appendNode(&mut module, Node.NoBody, Span.make(14, 14), Range.empty())
  let declaration = run appendNode(
    &mut module,
    Node.Declaration {
      owner: OwnerKey {kind: OwnerKind.Role, name: SymbolRef.of(clock), occurrence: usize.ZERO},
      documentation: SymbolRef.absent(),
      header: header,
      body: body,
    },
    Span.make(0, 14),
    Range.empty(),
  )
  let start = Vector.length<HirId>(&module.children)
  run Vector.append<HirId>(&mut module.children, declaration)
  module.declarations = Range {start: start, length: usize.ONE}
  return move module
}

effect fn renderBuilt() -> ()
! OutOfMemoryError | WriterError | AssertionError<'static>
? &mut Allocator {
  let module = run buildModule()
  let defects = run Hir.verify(&module)
  run Testing.expect(
    Vector.length<Defect>(&defects) == usize.ZERO,
    "a well-formed module reports no defect",
  )
  drop defects
  let rendered = run Hir.render(&module)
  let expected = String.utf8Bytes(
    """documentation none
declarations [#3]

nodes 4
#0 Name 9..14
  text: "Clock"
#1 RoleHeader 0..14
  name: #0
  isPublic: true
#2 NoBody 14..14
#3 Declaration 0..14
  owner: Role "Clock" #0
  documentation: none
  header: #1
  body: #2

causes 0

diagnostics 0
""",
  )
  run Testing.expect(
    bytesEqual(Vector.asSlice<u8>(&rendered), expected),
    "a built module renders one block per node",
  )
  drop rendered
  return ()
}

test effect fn builtModuleRenders() -> ()
! OutOfMemoryError | WriterError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run renderBuilt() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn detectDefects() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut module = run buildModule()
  let forward = run appendNode(
    &mut module,
    Node.MoveExpression {operand: HirId {index: 9}},
    Span.make(0, 0),
    Range.empty(),
  )
  let damaged = run appendNode(
    &mut module,
    Node.MissingType,
    Span.make(0, 0),
    Range.empty(),
  )
  let parent = run appendNode(
    &mut module,
    Node.MoveExpression {operand: HirId {index: 7}},
    Span.make(0, 0),
    Range.empty(),
  )
  let child = run appendNode(&mut module, Node.NoBody, Span.make(0, 0), Range.empty())
  drop child
  let defects = run Hir.verify(&module)
  let found = Vector.asSlice<Defect>(&defects)
  let mut sawOutOfBounds = false
  let mut sawEmptyCauses = false
  let mut sawForward = false
  let mut index = usize.ZERO
  while index < found.length {
    let defect = found[index]
    if defect.violation == Violation.ReferenceOutOfBounds && defect.id.index == forward.index {
      sawOutOfBounds = true
    }
    if defect.violation == Violation.EmptyRecoveryCauses && defect.id.index == damaged.index {
      sawEmptyCauses = true
    }
    if defect.violation == Violation.ChildNotBeforeParent && defect.id.index == parent.index {
      sawForward = true
    }
    index = index + usize.ONE
  }
  run Testing.expect(sawOutOfBounds, "a child identity outside the arena is a defect")
  run Testing.expect(sawEmptyCauses, "a recovery node with no cause is a defect")
  run Testing.expect(sawForward, "a child identity above its parent is a defect")
  drop defects
  return ()
}

test effect fn verifyDetectsBrokenArena() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run detectDefects() |> Effect.provideMut<Allocator>(&mut allocator)
}

// ---------------------------------------------------------------------------
// Draft builder and leaf lowerings
// ---------------------------------------------------------------------------

/// Returns the first node of `kind` in `tree`, or the root when the tree holds none.
fn firstNode(tree: &SyntaxTree, kind: NodeKind) -> NodeId {
  let nodes = Vector.asSlice<SyntaxNode>(&tree.nodes)
  let mut index = usize.ZERO
  while index < nodes.length {
    if nodes[index].kind == kind {
      return NodeId {index: index}
    }
    index = index + usize.ONE
  }
  return tree.root
}

/// Lowers the first expression node of `kind` in `source` into a fresh single-node module.
effect fn lowerExpression(source: string<'static>, kind: NodeKind) -> Module
! OutOfMemoryError
? &mut Allocator {
  let tree = run ParserCases.parseWithAllocator(source)
  let target = firstNode(&tree, kind)
  let mut draft = DraftState.make()
  let mut lowered = HirId {index: usize.ZERO}
  if kind == NodeKind.IntegerLiteralExpression {
    lowered = run Draft.integerLiteral(&mut draft, &tree, target)
  } else if kind == NodeKind.FloatingLiteralExpression {
    lowered = run Draft.floatingLiteral(&mut draft, &tree, target)
  } else if kind == NodeKind.DurationLiteralExpression {
    lowered = run Draft.durationLiteral(&mut draft, &tree, target)
  } else if kind == NodeKind.StaticTextLiteralExpression {
    lowered = run Draft.staticTextLiteral(&mut draft, &tree, target)
  } else if kind == NodeKind.CharacterLiteralExpression {
    lowered = run Draft.characterLiteral(&mut draft, &tree, target)
  } else if kind == NodeKind.BooleanLiteralExpression {
    lowered = run Draft.booleanLiteral(&mut draft, &tree, target)
  } else {
    lowered = run Draft.unitLiteral(&mut draft, &tree, target)
  }
  let mut module = DraftState.finish(move draft)
  let start = Vector.length<HirId>(&module.children)
  run Vector.append<HirId>(&mut module.children, lowered)
  module.declarations = Range {start: start, length: usize.ONE}
  drop tree
  return move module
}

/// Reports whether the last node has this sign, exact decimal magnitude, and written base.
fn expectInteger(module: &Module, sign: Sign, magnitude: string<'static>, radix: Radix) -> bool {
  let last = Module.length(module)
  if last == usize.ZERO {
    return false
  }
  if let Node.IntegerLiteral {sign: foundSign, magnitude: found, radix: foundRadix, ..}
    = Module.node(module, HirId {index: last - usize.ONE}) {
    return foundSign == sign && foundRadix == radix
      && bytesEqual(Module.text(module, found), String.utf8Bytes(magnitude))
  }
  return false
}

/// Reports whether the module's last node carries at least one cause with `code`.
fn hasCause(module: &Module, code: CauseCode) -> bool {
  let last = Module.length(module)
  if last == usize.ZERO {
    return false
  }
  let range = Module.causeRange(module, HirId {index: last - usize.ONE})
  let mut offset = usize.ZERO
  while offset < range.length {
    if Vector.get<Cause>(&module.causes, range.start + offset).code == code {
      return true
    }
    offset = offset + usize.ONE
  }
  return false
}

/// Reports whether the interned bytes of the module's last literal equal `expected`.
fn expectPayload(module: &Module, expected: &[u8], wantBytes: bool) -> bool {
  let last = Module.length(module)
  if last == usize.ZERO {
    return false
  }
  let node = Module.node(module, HirId {index: last - usize.ONE})
  if let Node.TextLiteral {value} = node {
    return !wantBytes && bytesEqual(Module.text(module, value), expected)
  }
  if let Node.BytesLiteral {value} = node {
    return wantBytes && bytesEqual(Module.text(module, value), expected)
  }
  return false
}

effect fn checkIntegerForms() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let hex = run lowerExpression(
    "fn main() -> i32 { return 0xFF }",
    NodeKind.IntegerLiteralExpression,
  )
  run Testing.expect(expectInteger(&hex, Sign.Positive, "255", Radix.Hexadecimal), "0xFF reads as hexadecimal 255")
  drop hex
  let binary = run lowerExpression(
    "fn main() -> i32 { return 0b1010 }",
    NodeKind.IntegerLiteralExpression,
  )
  run Testing.expect(expectInteger(&binary, Sign.Positive, "10", Radix.Binary), "0b1010 reads as binary 10")
  drop binary
  let octal = run lowerExpression(
    "fn main() -> i32 { return 0o17 }",
    NodeKind.IntegerLiteralExpression,
  )
  run Testing.expect(expectInteger(&octal, Sign.Positive, "15", Radix.Octal), "0o17 reads as octal 15")
  drop octal
  let separated = run lowerExpression(
    "fn main() -> i32 { return 1_000_000 }",
    NodeKind.IntegerLiteralExpression,
  )
  run Testing.expect(
    expectInteger(&separated, Sign.Positive, "1000000", Radix.Decimal),
    "a separator groups digits without carrying value",
  )
  drop separated
  return ()
}

test effect fn integerLiteralsDecodeEveryBase() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkIntegerForms() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn checkExactIntegers() -> ()
! OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let module = run lowerExpression(
    "fn main() -> i32 { return 18446744073709551616 }",
    NodeKind.IntegerLiteralExpression,
  )
  run Testing.expect(
    expectInteger(&module, Sign.Positive, "18446744073709551616", Radix.Decimal),
    "a magnitude beyond u64 stays exact authored syntax",
  )
  run Testing.expect(
    !hasCause(&module, CauseCode.InvalidLiteralEncoding),
    "size alone does not damage an integer literal",
  )
  let negative = run lowerExpression(
    "fn main() -> i32 { return -0x1_0000_0000_0000_0000 }",
    NodeKind.IntegerLiteralExpression,
  )
  run Testing.expect(
    expectInteger(&negative, Sign.Negative, "18446744073709551616", Radix.Hexadecimal),
    "a negative hexadecimal integer keeps its sign, base, and exact value",
  )
  let defects = run Hir.verify(&module)
  run Testing.expect(
    Vector.length<Defect>(&defects) == usize.ZERO,
    "an exact large integer leaves a consistent arena",
  )
  drop defects
  drop negative
  drop module
  return ()
}

test effect fn integerMagnitudesRemainExact() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkExactIntegers() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn checkTextLiterals() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let escaped = run lowerExpression(
    """fn main() -> i32 { return "a\\nb\\u{41}" }""",
    NodeKind.StaticTextLiteralExpression,
  )
  run Testing.expect(
    expectPayload(&escaped, String.utf8Bytes("a\nbA"), false),
    "a text literal interns its decoded payload, not its spelling",
  )
  drop escaped
  let byteString = run lowerExpression(
    """fn main() -> i32 { return b"\\x41B" }""",
    NodeKind.StaticTextLiteralExpression,
  )
  run Testing.expect(
    expectPayload(&byteString, String.utf8Bytes("AB"), true),
    "a byte string lowers to a bytes literal",
  )
  drop byteString
  return ()
}

test effect fn textLiteralsInternDecodedBytes() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkTextLiterals() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn checkCharacterLiteral() -> ()
! OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let module = run lowerExpression(
    """fn main() -> i32 { return '\\u{2603}' }""",
    NodeKind.CharacterLiteralExpression,
  )
  let last = Module.length(&module) - usize.ONE
  let mut scalar = u32.add(0, 0)
  if let Node.CharacterLiteral {scalar: found} = Module.node(&module, HirId {index: last}) {
    scalar = found
  }
  run Testing.expect(scalar == u32.add(0, 9731), "an escape denotes one Unicode scalar")
  drop module
  return ()
}

test effect fn characterLiteralDecodesOneScalar() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkCharacterLiteral() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn checkDurationLiteral() -> ()
! OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let module = run lowerExpression(
    "fn main() -> i32 { return 1h30m }",
    NodeKind.DurationLiteralExpression,
  )
  let last = Module.length(&module) - usize.ONE
  let mut components = Range.empty()
  if let Node.DurationLiteral {components: found} = Module.node(&module, HirId {index: last}) {
    components = found
  }
  run Testing.expect(components.length == usize.add(0, 2), "1h30m lowers to two components")
  let mut firstOk = false
  let mut secondOk = false
  if let Node.DurationComponent {magnitude, unit}
    = Module.node(&module, Module.child(&module, components, usize.ZERO)) {
    firstOk = magnitude == 1 && unit == DurationUnit.Hours
  }
  if let Node.DurationComponent {magnitude, unit}
    = Module.node(&module, Module.child(&module, components, usize.ONE)) {
    secondOk = magnitude == 30 && unit == DurationUnit.Minutes
  }
  run Testing.expect(firstOk, "the coarsest component keeps its magnitude and unit")
  run Testing.expect(secondOk, "the finer component follows in written order")
  drop module
  return ()
}

test effect fn durationLiteralKeepsComponents() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkDurationLiteral() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn checkMissingName() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let tree = run ParserCases.parseWithAllocator("struct {}")
  let target = firstNode(&tree, NodeKind.StructDeclaration)
  let mut draft = DraftState.make()
  let name = run Draft.nameIn(&mut draft, &tree, target, true)
  let module = DraftState.finish(move draft)
  let mut isMissing = false
  match Module.node(&module, name) {
    Node.MissingName => { isMissing = true }
    _ => {}
  }
  run Testing.expect(isMissing, "an absent declaration name lowers to MissingName")
  run Testing.expect(
    Module.causeRange(&module, name).length > usize.ZERO,
    "a missing name always records why it is missing",
  )
  drop module
  drop tree
  return ()
}

test effect fn missingNameRecordsACause() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkMissingName() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn checkSharedSymbols() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let tree = run ParserCases.parseWithAllocator(
    "fn value() -> i32 { return 0 }\nfn value() -> i32 { return 1 }",
  )
  let mut draft = DraftState.make()
  let nodes = Vector.asSlice<SyntaxNode>(&tree.nodes)
  let mut first = HirId {index: usize.ZERO}
  let mut second = HirId {index: usize.ZERO}
  let mut seen = usize.ZERO
  let mut index = usize.ZERO
  while index < nodes.length {
    if nodes[index].kind == NodeKind.FunctionDeclaration {
      let lowered = run Draft.callableNameIn(&mut draft, &tree, NodeId {index: index})
      if seen == usize.ZERO {
        first = lowered
      } else {
        second = lowered
      }
      seen = seen + usize.ONE
    }
    index = index + usize.ONE
  }
  let module = DraftState.finish(move draft)
  run Testing.expect(seen == usize.add(0, 2), "both declarations were lowered")
  let mut firstText = Symbol {index: usize.ZERO}
  let mut secondText = Symbol {index: usize.ONE}
  if let Node.Name {text} = Module.node(&module, first) {
    firstText = text
  }
  if let Node.Name {text} = Module.node(&module, second) {
    secondText = text
  }
  run Testing.expect(
    firstText.index == secondText.index,
    "two identical identifiers share one symbol",
  )
  run Testing.expect(
    bytesEqual(Module.text(&module, firstText), String.utf8Bytes("value")),
    "the shared symbol resolves to the written name",
  )
  drop module
  drop tree
  return ()
}

test effect fn identicalNamesShareOneSymbol() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkSharedSymbols() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn checkPathSegments() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let tree = run ParserCases.parseWithAllocator("import silk.vector {Vector}")
  let target = firstNode(&tree, NodeKind.ImportPath)
  let mut draft = DraftState.make()
  let path = run Draft.pathOf(&mut draft, &tree, target, false)
  let module = DraftState.finish(move draft)
  let mut segments = Range.empty()
  if let Node.Path {segments: found} = Module.node(&module, path) {
    segments = found
  }
  run Testing.expect(
    segments.length == usize.add(0, 2),
    "a dotted import path keeps one name per segment",
  )
  let mut firstText = Symbol {index: usize.ZERO}
  if let Node.Name {text} = Module.node(&module, Module.child(&module, segments, usize.ZERO)) {
    firstText = text
  }
  run Testing.expect(
    bytesEqual(Module.text(&module, firstText), String.utf8Bytes("silk")),
    "the first segment keeps its written spelling",
  )
  drop module
  drop tree
  return ()
}

test effect fn pathKeepsOneNamePerSegment() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkPathSegments() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn checkBinderFrames() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let mut draft = DraftState.make()
  let outer = run Draft.internBytes(&mut draft, String.utf8Bytes("value"))
  let inner = run Draft.internBytes(&mut draft, String.utf8Bytes("other"))
  run Draft.pushFrame(&mut draft)
  run Draft.bind(&mut draft, outer, HirId {index: 1})
  run Draft.pushFrame(&mut draft)
  run Draft.bind(&mut draft, outer, HirId {index: 2})
  run Draft.bind(&mut draft, inner, HirId {index: 3})
  run Testing.expect(
    Draft.lookup(&draft, outer).id.index == 2,
    "an inner binding shadows an outer one",
  )
  Draft.popFrame(&mut draft)
  run Testing.expect(
    Draft.lookup(&draft, outer).id.index == 1,
    "closing the frame restores the outer binding",
  )
  run Testing.expect(!Draft.lookup(&draft, inner).present, "a closed frame's binding is gone")
  let module = DraftState.finish(move draft)
  drop module
  return ()
}

test effect fn framesShadowAndRestoreBindings() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkBinderFrames() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn checkRoundedFloat(
  source: string<'static>,
  expectedSpelling: string<'static>,
  expected32: u32,
  expected64: u64,
) -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let module = run lowerExpression(source, NodeKind.FloatingLiteralExpression)
  let id = HirId {index: Module.length(&module) - usize.ONE}
  let mut exact = false
  let mut rounded32 = false
  let mut rounded64 = false
  if let Node.FloatingLiteral {spelling, suffix: ignoredSuffix} = Module.node(&module, id) {
    exact = bytesEqual(Module.text(&module, spelling), String.utf8Bytes(expectedSpelling))
      && Module.causeRange(&module, id).length == usize.ZERO
    if let Result<u32, ParseError>.Success {value}
      = move FloatingLiteral.f32Bits(&module, spelling) {
      rounded32 = value == expected32
    }
    if let Result<u64, ParseError>.Success {value}
      = move FloatingLiteral.f64Bits(&module, spelling) {
      rounded64 = value == expected64
    }
  }
  run Testing.expect(exact && rounded32 && rounded64, "float literal retains exact digits and rounds once")
  drop module
  return ()
}

effect fn checkExactFloatRounding() -> ()
! OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  run checkRoundedFloat(
    "fn value() -> f64 { return 184467440737095516160000.0e-4 }",
    "184467440737095516160000.0e-4",
    1602224128,
    4895412794951729152,
  )
  run checkRoundedFloat(
    "fn value() -> f32 { return 1.000000059604644775390625 }",
    "1.000000059604644775390625",
    1065353216,
    4607182419068452864,
  )
  run checkRoundedFloat(
    "fn value() -> f32 { return 1.000000059604644775390626 }",
    "1.000000059604644775390626",
    1065353217,
    4607182419068452864,
  )
  run checkRoundedFloat(
    "fn value() -> f64 { return -0.0 }",
    "-0.0",
    2147483648,
    9223372036854775808,
  )
  run checkRoundedFloat(
    "fn value() -> f64 { return 1e999999999999999999999999 }",
    "1e999999999999999999999999",
    2139095040,
    9218868437227405312,
  )
  run checkRoundedFloat(
    "fn value() -> f64 { return -1e-999999999999999999999999 }",
    "-1e-999999999999999999999999",
    2147483648,
    9223372036854775808,
  )
  return ()
}

test effect fn floatingLiteralRoundsExactDecimalToBothWidths() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkExactFloatRounding() |> Effect.provideMut<Allocator>(&mut allocator)
}

// ---------------------------------------------------------------------------
// Types, generics, contracts, and constraints
// ---------------------------------------------------------------------------

/// Lowers the first `kind` node of `source` as a type, answering the finished module.
effect fn lowerTypeOf(source: string<'static>, kind: NodeKind) -> Module
! OutOfMemoryError
? &mut Allocator {
  let tree = run ParserCases.parseWithAllocator(source)
  let target = firstNode(&tree, kind)
  let mut draft = DraftState.make()
  let lowered = run LowerType.lowerType(&mut draft, &tree, target)
  let mut module = DraftState.finish(move draft)
  let start = Vector.length<HirId>(&module.children)
  run Vector.append<HirId>(&mut module.children, lowered)
  module.declarations = Range {start: start, length: usize.ONE}
  drop tree
  return move module
}

/// Lowers the contract of the first function declaration of `source`.
effect fn lowerContractOf(source: string<'static>) -> Module
! OutOfMemoryError
? &mut Allocator {
  let tree = run ParserCases.parseWithAllocator(source)
  let target = firstNode(&tree, NodeKind.FunctionDeclaration)
  let mut draft = DraftState.make()
  run Draft.pushFrame(&mut draft)
  let lowered = run LowerType.callableContract(&mut draft, &tree, target, true)
  Draft.popFrame(&mut draft)
  let mut module = DraftState.finish(move draft)
  let start = Vector.length<HirId>(&module.children)
  run Vector.append<HirId>(&mut module.children, lowered)
  module.declarations = Range {start: start, length: usize.ONE}
  drop tree
  return move module
}

/// Returns the node of the module's last-appended root.
fn lastNode(module: &Module) -> Node {
  return Module.node(module, HirId {index: Module.length(module) - usize.ONE})
}

/// Reports whether `id` names a node of the given kind name in `Hir.nodeKindName` terms.
fn isMissingType(module: &Module, id: HirId) -> bool {
  match Module.node(module, id) {
    Node.MissingType => { return true }
    _ => { return false }
  }
}

effect fn checkAppliedTypeRows() -> ()
! OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let module = run lowerTypeOf(
    "fn main(worker: Task<'a & 'b; u8 !Error ?&Clock>) -> i32 { return 0 }",
    NodeKind.AppliedType,
  )
  let mut arguments = HirId {index: usize.ZERO}
  if let Node.AppliedType {arguments: found, ..} = lastNode(&module) {
    arguments = found
  }
  let mut sawFailures = false
  let mut sawRequirements = false
  let mut sawEnvironment = false
  let mut argumentCount = usize.ZERO
  if let Node.TypeArguments {
    arguments: list,
    environment,
    failures,
    requirements,
  } = Module.node(&module, arguments) {
    argumentCount = list.length
    sawEnvironment = environment.present
    sawFailures = failures.present
    sawRequirements = requirements.present
  }
  run Testing.expect(argumentCount == usize.ONE, "the written type argument is retained")
  run Testing.expect(sawEnvironment, "a written lifetime environment stays distinct from an absent one")
  run Testing.expect(sawFailures, "a `!` row lowers into the failures slot")
  run Testing.expect(sawRequirements, "a `?` row lowers into the requirements slot")
  let defects = run Hir.verify(&module)
  run Testing.expect(
    Vector.length<Defect>(&defects) == usize.ZERO,
    "an applied type with rows leaves a consistent arena",
  )
  drop defects
  drop module
  return ()
}

test effect fn appliedTypeKeepsRowsAndEnvironment() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkAppliedTypeRows() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn checkPointerQualifiers() -> ()
! OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let module = run lowerTypeOf(
    "fn main(handle: [*]const align(8) addrspace(3) u8) -> i32 { return 0 }",
    NodeKind.PointerType,
  )
  let mut qualifiers = Range.empty()
  let mut multiplicity = Multiplicity.Single
  let mut access = Access.Mutable
  let mut nullable = true
  if let Node.PointerType {
    access: foundAccess,
    nullable: foundNullable,
    multiplicity: foundMultiplicity,
    qualifiers: found,
    ..
  } = lastNode(&module) {
    qualifiers = found
    multiplicity = foundMultiplicity
    access = foundAccess
    nullable = foundNullable
  }
  run Testing.expect(qualifiers.length == usize.add(0, 2), "both written qualifiers are retained")
  run Testing.expect(multiplicity == Multiplicity.Many, "`[*]` addresses a run of values")
  run Testing.expect(access == Access.Shared, "`const` leaves the pointer read-only")
  run Testing.expect(!nullable, "a pointer without `?` does not admit null")
  let mut value = false
  if let Node.PointerQualifier {value: valueId, ..}
    = Module.node(&module, Module.child(&module, qualifiers, usize.ZERO)) {
    if let Node.IntegerLiteral {magnitude, ..} = Module.node(&module, valueId) {
      value = bytesEqual(Module.text(&module, magnitude), String.utf8Bytes("8"))
    }
  }
  run Testing.expect(value, "a qualifier keeps its written magnitude")
  drop module
  return ()
}

test effect fn pointerTypeKeepsQualifiers() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkPointerQualifiers() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn checkCallableBinders() -> ()
! OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let module = run lowerTypeOf(
    "fn main(apply: for<'a, use 'call> unsafe fn(&'a u8, i32) -> i32) -> i32 { return 0 }",
    NodeKind.CallableType,
  )
  let mut binders = Range.empty()
  let mut parameters = Range.empty()
  let mut isUnsafe = false
  let mut resultId = HirId {index: usize.ZERO}
  if let Node.CallableType {
    isUnsafe: foundUnsafe,
    binders: foundBinders,
    parameters: foundParameters,
    result,
    ..
  } = lastNode(&module) {
    binders = foundBinders
    parameters = foundParameters
    isUnsafe = foundUnsafe
    resultId = result
  }
  run Testing.expect(binders.length == 2, "a `for<'a, use 'call>` binder list keeps its parameters")
  run Testing.expect(parameters.length == usize.add(0, 2), "every operand but the last is a parameter")
  run Testing.expect(isUnsafe, "a written `unsafe` is recorded on the callable type")
  run Testing.expect(!isMissingType(&module, resultId), "the last operand is the result type")
  let mut isLifetime = false
  if let Node.LifetimeParameter {invocationUse, ..}
    = Module.node(&module, Module.child(&module, binders, usize.ZERO)) {
    isLifetime = !invocationUse
  }
  run Testing.expect(isLifetime, "a `'a` binder lowers to an unmarked lifetime parameter")
  let mut isMarked = false
  if let Node.LifetimeParameter {invocationUse, ..}
    = Module.node(&module, Module.child(&module, binders, usize.ONE)) {
    isMarked = invocationUse
  }
  run Testing.expect(isMarked, "a contextual `use 'call` binder lowers to a marked lifetime parameter")
  drop module
  return ()
}

test effect fn callableTypeKeepsBinders() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkCallableBinders() |> Effect.provideMut<Allocator>(&mut allocator)
}

/// Returns the written mode of the parameter at `offset` within `parameters`.
fn parameterModeAt(module: &Module, parameters: Range, offset: usize) -> ParameterMode {
  if let Node.Parameter {mode, ..} = Module.node(module, Module.child(module, parameters, offset)) {
    return mode
  }
  return ParameterMode.Value
}

effect fn checkFullContract() -> ()
! OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let module = run lowerContractOf(
    "pub test static unsafe effect<> fn apply<T>(value: T, mut second: i32, static third: i32, ...) -> i32 !Error ?&Clock where T in Copy { return 0 }",
  )
  let mut generics = Range.empty()
  let mut parameters = Range.empty()
  let mut constraints = Range.empty()
  let mut variadic = false
  let mut isEffect = false
  let mut isTest = false
  let mut isUnsafe = false
  let mut isStatic = false
  let mut hasResult = false
  let mut hasFailures = false
  let mut hasRequirements = false
  let mut effectAnchored = false
  let mut testAnchored = false
  let mut unsafeAnchored = false
  let mut staticAnchored = false
  let mut genericsAnchored = false
  let mut constraintsAnchored = false
  let mut environment = RangeRef.absent()
  if let Node.CallableContract {
    generics: foundGenerics,
    parameters: foundParameters,
    variadic: foundVariadic,
    result,
    failures,
    requirements,
    constraints: foundConstraints,
    isEffect: foundEffect,
    isTest: foundTest,
    isUnsafe: foundUnsafe,
    isStatic: foundStatic,
    environment: foundEnvironment,
    effectAnchor,
    testAnchor,
    unsafeAnchor,
    staticAnchor,
    genericsAnchor,
    constraintsAnchor,
    ..
  } = lastNode(&module) {
    generics = foundGenerics
    parameters = foundParameters
    constraints = foundConstraints
    variadic = foundVariadic
    isEffect = foundEffect
    isTest = foundTest
    isUnsafe = foundUnsafe
    isStatic = foundStatic
    environment = foundEnvironment
    hasResult = result.present
    hasFailures = failures.present
    hasRequirements = requirements.present
    effectAnchored = effectAnchor.present
    testAnchored = testAnchor.present
    unsafeAnchored = unsafeAnchor.present
    staticAnchored = staticAnchor.present
    genericsAnchored = genericsAnchor.present
    constraintsAnchored = constraintsAnchor.present
  }
  run Testing.expect(generics.length == usize.ONE, "the written generic parameter is retained")
  run Testing.expect(
    parameters.length == usize.add(usize.ONE, 2),
    "every written parameter is retained",
  )
  run Testing.expect(variadic, "a trailing `...` marks the list variadic")
  run Testing.expect(isEffect && effectAnchored, "`effect` is recorded with the keyword it was written as")
  run Testing.expect(isTest && testAnchored, "a contextual `test` before `fn` is a test marker")
  run Testing.expect(
    isUnsafe && unsafeAnchored,
    "`unsafe` is recorded with the keyword it was written as",
  )
  run Testing.expect(
    isStatic && staticAnchored,
    "`static` is recorded with the keyword it was written as",
  )
  run Testing.expect(hasResult && hasFailures && hasRequirements, "result and both rows are written")
  run Testing.expect(constraints.length == usize.ONE, "the `where` clause keeps its one constraint")
  run Testing.expect(genericsAnchored && constraintsAnchored, "a written list keeps its own anchor")
  run Testing.expect(
    environment.present && environment.range.length == usize.ZERO,
    "a written but empty `effect<>` environment is present and empty, not absent",
  )
  let mut isMembership = false
  if let Node.MembershipConstraint {..}
    = Module.node(&module, Module.child(&module, constraints, usize.ZERO)) {
    isMembership = true
  }
  run Testing.expect(isMembership, "`T in Copy` lowers to a membership constraint")
  run Testing.expect(
    parameterModeAt(&module, parameters, usize.ZERO) == ParameterMode.Value,
    "an unmarked parameter receives its argument by value",
  )
  run Testing.expect(
    parameterModeAt(&module, parameters, usize.ONE) == ParameterMode.Mutable,
    "a `mut` parameter receives its argument mutably",
  )
  run Testing.expect(
    parameterModeAt(&module, parameters, usize.add(usize.ONE, usize.ONE)) == ParameterMode.Static,
    "a `static` parameter receives its argument statically",
  )
  let defects = run Hir.verify(&module)
  run Testing.expect(
    Vector.length<Defect>(&defects) == usize.ZERO,
    "a full contract leaves a consistent arena",
  )
  drop defects
  drop module
  return ()
}

test effect fn contractKeepsEveryModifierAndClause() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkFullContract() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn checkMissingResultType() -> ()
! OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let module = run lowerTypeOf(
    "fn main(apply: fn(i32)) -> i32 { return 0 }",
    NodeKind.CallableType,
  )
  let mut resultId = HirId {index: usize.ZERO}
  if let Node.CallableType {result, ..} = lastNode(&module) {
    resultId = result
  }
  run Testing.expect(
    isMissingType(&module, resultId),
    "a callable type written with no `->` lowers its result to MissingType",
  )
  run Testing.expect(
    Module.causeRange(&module, resultId).length > usize.ZERO,
    "a missing result type always records why it is missing",
  )
  let defects = run Hir.verify(&module)
  run Testing.expect(
    Vector.length<Defect>(&defects) == usize.ZERO,
    "a callable type with no result leaves a consistent arena",
  )
  drop defects
  drop module
  return ()
}

test effect fn missingResultTypeRecordsACause() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkMissingResultType() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn checkSignedInteger() -> ()
! OutOfMemoryError | WriterError | AssertionError<'static>
? &mut Allocator {
  let negative = run lowerExpression(
    "fn main() -> i32 { return -1 }",
    NodeKind.IntegerLiteralExpression,
  )
  let rendered = run Hir.render(&negative)
  let expected = String.utf8Bytes(
    """documentation none
declarations [#0]

nodes 1
#0 IntegerLiteral 26..28
  sign: Negative
  magnitude: 1
  radix: Decimal
  suffix: none

causes 0

diagnostics 0
""",
  )
  run Testing.expect(
    bytesEqual(Vector.asSlice<u8>(&rendered), expected),
    "the dump names the written sign",
  )
  drop rendered
  drop negative
  return ()
}

test effect fn integerLiteralKeepsItsSign() -> ()
! OutOfMemoryError | WriterError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkSignedInteger() |> Effect.provideMut<Allocator>(&mut allocator)
}

// ---------------------------------------------------------------------------
// Expressions, patterns, statements, and blocks
// ---------------------------------------------------------------------------

/// Lowers the body block of the first function declaration of `source`.
///
/// # Details
///
/// The contract is lowered first with binding enabled, exactly as a declaration lowering will, so
/// a parameter is in scope for every identifier in the body.
effect fn lowerBodyOf(source: string<'static>) -> Module
! OutOfMemoryError
? &mut Allocator {
  let tree = run ParserCases.parseWithAllocator(source)
  let declaration = firstNode(&tree, NodeKind.FunctionDeclaration)
  let mut draft = DraftState.make()
  run Draft.pushFrame(&mut draft)
  let contract = run LowerType.callableContract(&mut draft, &tree, declaration, true)
  let body = run LowerStatement.blockIn(
    &mut draft,
    &tree,
    declaration,
    Draft.nodeSpan(&tree, declaration),
  )
  Draft.popFrame(&mut draft)
  let mut module = DraftState.finish(move draft)
  let start = Vector.length<HirId>(&module.children)
  run Vector.append<HirId>(&mut module.children, contract)
  run Vector.append<HirId>(&mut module.children, body)
  module.declarations = Range {start: start, length: usize.add(usize.ONE, usize.ONE)}
  drop tree
  return move module
}

/// Returns the last node of `kind` in `tree`, which is the outermost one of a nested family.
fn lastSyntaxNode(tree: &SyntaxTree, kind: NodeKind) -> NodeId {
  let nodes = Vector.asSlice<SyntaxNode>(&tree.nodes)
  let mut found = tree.root
  let mut index = usize.ZERO
  while index < nodes.length {
    if nodes[index].kind == kind {
      found = NodeId {index: index}
    }
    index = index + usize.ONE
  }
  return found
}

/// Lowers the outermost expression node of `kind` in `source` with no enclosing frame.
effect fn lowerExpressionOf(source: string<'static>, kind: NodeKind) -> Module
! OutOfMemoryError
? &mut Allocator {
  let tree = run ParserCases.parseWithAllocator(source)
  let target = lastSyntaxNode(&tree, kind)
  let mut draft = DraftState.make()
  let lowered = run LowerExpression.lowerExpression(&mut draft, &tree, target)
  let mut module = DraftState.finish(move draft)
  let start = Vector.length<HirId>(&module.children)
  run Vector.append<HirId>(&mut module.children, lowered)
  module.declarations = Range {start: start, length: usize.ONE}
  drop tree
  return move module
}

/// What one of the searches below is looking for in the arena.
enum Sought {
  InvalidExpression,
  InvalidStatement,
  IntegerLiteral,
  DurationLiteral,
  Conditional,
}

fn matches(node: Node, sought: Sought) -> bool {
  return match sought {
    Sought.InvalidExpression => match node {
      Node.InvalidExpression {retained: ignored1} => true
      _ => false
    }
    Sought.InvalidStatement => match node {
      Node.InvalidStatement {retained: ignored1} => true
      _ => false
    }
    Sought.IntegerLiteral => match node {
      Node.IntegerLiteral {sign: ignored1, magnitude: ignored2, radix: ignored3, suffix: ignored4} =>
        true
      _ => false
    }
    Sought.DurationLiteral => match node {
      Node.DurationLiteral {components: ignored1} => true
      _ => false
    }
    Sought.Conditional => match node {
      Node.ConditionalStatement {condition: ignored1, thenBranch: ignored2, elseBranch: ignored3} =>
        true
      _ => false
    }
  }
}

/// Returns the first node of the module that `sought` names, or the module's length.
fn findKind(module: &Module, sought: Sought) -> usize {
  let mut index = usize.ZERO
  while index < Module.length(module) {
    if matches(Module.node(module, HirId {index: index}), sought) {
      return index
    }
    index = index + usize.ONE
  }
  return Module.length(module)
}

/// Returns the last node of the module that `sought` names, or the module's length.
fn findLastKind(module: &Module, sought: Sought) -> usize {
  let mut found = Module.length(module)
  let mut index = usize.ZERO
  while index < Module.length(module) {
    if matches(Module.node(module, HirId {index: index}), sought) {
      found = index
    }
    index = index + usize.ONE
  }
  return found
}

/// Returns the binder an identifier expression resolved to, or an absent reference.
fn bindingOf(module: &Module, id: usize) -> HirRef {
  if let Node.IdentifierExpression {binding, ..} = Module.node(module, HirId {index: id}) {
    return binding
  }
  return HirRef.absent()
}

/// Reports whether the interned text of the name node `id` equals `expected`.
fn nameIs(module: &Module, id: HirId, expected: string<'static>) -> bool {
  if let Node.Name {text} = Module.node(module, id) {
    return bytesEqual(Module.text(module, text), String.utf8Bytes(expected))
  }
  return false
}

/// Returns the identifier expression at `offset` among the module's identifier expressions.
fn identifierAt(module: &Module, offset: usize) -> usize {
  let mut seen = usize.ZERO
  let mut index = usize.ZERO
  while index < Module.length(module) {
    if let Node.IdentifierExpression {name: ignoredName, binding: ignoredBinding}
      = Module.node(module, HirId {index: index}) {
      if seen == offset {
        return index
      }
      seen = seen + usize.ONE
    }
    index = index + usize.ONE
  }
  return Module.length(module)
}

effect fn checkPatternConditionalSubjectScope() -> ()
! OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let module = run lowerBodyOf(
    "fn main(value: Option) -> i32 { if let Option.Some {value} = value { return 1 } return 0 }",
  )
  let subject = identifierAt(&module, usize.ZERO)
  run Testing.expect(subject < Module.length(&module), "the statement holds one identifier")
  let binding = bindingOf(&module, subject)
  run Testing.expect(binding.present, "the subject resolves to a binder")
  match Module.node(&module, binding.id) {
    Node.Parameter {name, annotation: ignoredAnnotation, mode: ignoredMode} => {
      run Testing.expect(
        nameIs(&module, name, "value"),
        "the subject reads the enclosing parameter, not the binding its own pattern introduces",
      )
    }
    _ => { run Testing.expect(false, "the subject binder is the enclosing parameter") }
  }
  let defects = run Hir.verify(&module)
  run Testing.expect(
    Vector.length<Defect>(&defects) == usize.ZERO,
    "the lowered module satisfies every flat invariant",
  )
  drop defects
  drop module
  return ()
}

test effect fn patternConditionalSubjectsReadTheOuterScope() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkPatternConditionalSubjectScope()
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn checkLetBindingAndShadowing() -> ()
! OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let module = run lowerBodyOf(
    "fn main() -> i32 { let outer = 1 if true { let outer = 2 drop outer } outer }",
  )
  // Identifier 0 is the inner reference, identifier 1 the outer one: the inner block closes first.
  let inner = bindingOf(&module, identifierAt(&module, usize.ZERO))
  let outer = bindingOf(&module, identifierAt(&module, usize.ONE))
  run Testing.expect(inner.present && outer.present, "both references resolve to a `let`")
  run Testing.expect(
    inner.id.index != outer.id.index,
    "an inner block shadows an outer binding of the same name",
  )
  run Testing.expect(
    inner.id.index > outer.id.index,
    "the inner binder is the one appended later",
  )
  let defects = run Hir.verify(&module)
  run Testing.expect(
    Vector.length<Defect>(&defects) == usize.ZERO,
    "the lowered module satisfies every flat invariant",
  )
  drop defects
  drop module
  return ()
}

test effect fn nestedBlocksShadowOuterBindings() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkLetBindingAndShadowing() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn checkUnresolvedIdentifier() -> ()
! OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let module = run lowerBodyOf("fn main() -> i32 { return elsewhere }")
  let identifier = identifierAt(&module, usize.ZERO)
  run Testing.expect(
    !bindingOf(&module, identifier).present,
    "an identifier with no binder in scope stays unresolved for a later phase",
  )
  let defects = run Hir.verify(&module)
  run Testing.expect(
    Vector.length<Defect>(&defects) == usize.ZERO,
    "the lowered module satisfies every flat invariant",
  )
  drop defects
  drop module
  return ()
}

test effect fn unresolvedIdentifiersStayAbsent() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkUnresolvedIdentifier() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn checkMatchArmBinding() -> ()
! OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let module = run lowerBodyOf(
    "fn main(subject: Shape) -> i32 { match subject { Circle {radius} => radius } }",
  )
  // Identifier 0 is the match subject; identifier 1 is the arm result.
  let result = bindingOf(&module, identifierAt(&module, usize.ONE))
  run Testing.expect(result.present, "an arm result resolves to the pattern's binder")
  match Module.node(&module, result.id) {
    Node.BindingPattern {annotation: ignoredAnnotation, name} => {
      run Testing.expect(nameIs(&module, name, "radius"), "the binder is the shorthand binding")
    }
    _ => { run Testing.expect(false, "the binder is a binding pattern") }
  }
  let defects = run Hir.verify(&module)
  run Testing.expect(
    Vector.length<Defect>(&defects) == usize.ZERO,
    "the lowered module satisfies every flat invariant",
  )
  drop defects
  drop module
  return ()
}

test effect fn matchArmPatternsBindTheirNames() -> ()
! OutOfMemoryError | AssertionError<'static> {
