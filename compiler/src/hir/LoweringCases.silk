  drop module
  return ()
}

test effect fn callableBodiesCaptureEnclosingBinders() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkCapturedBinding() |> Effect.provideMut<Allocator>(&mut allocator)
