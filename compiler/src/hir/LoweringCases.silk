  match Module.node(&module, binding.id) {
    Node.Parameter {name, annotation: ignoredAnnotation, mode: ignoredMode} => {
      run Testing.expect(
        nameIs(&module, name, "captured"),
        "the capture resolves to the enclosing parameter",
      )
