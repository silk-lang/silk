//! The one entry point that turns a parsed syntax tree into a finished HIR module.
//!
//! # When to use
//!
//! Call [`lower`] with a borrowed [`SyntaxTree`](parser.SyntaxTree.SyntaxTree). The answer owns
//! everything it refers to, so the caller drops the tree immediately afterwards.
//!
//! # Details
//!
//! This is the port of the module-publication section of the bootstrap `AuthoredLowering`
//! (`packages/compiler/src/AuthoredLowering.ts`, the exported `lower`). It opens one
//! [`Draft`](hir.Draft.Draft), interns the module documentation, lowers every top-level
//! declaration under one key scope, copies the parser's diagnostics into module coordinates, and
//! takes the finished module out of the draft.
//!
//! # Gotchas
//!
//! The bootstrap re-anchors each frontend diagnostic to the declaration that encloses it, because
//! its presentation entries are keyed by anchor path. A flat module records the diagnostic's own
//! span (spec decision 4), and a reporter that wants the enclosing declaration finds it by
//! comparing spans against `Module.spans`, so the anchor is derivable rather than stored.

import hir.Draft
import hir.Draft {Draft as DraftState}
import hir.Hir {Diagnostic as Cause, HirId, Module, Range}
import hir.LowerDeclaration
import hir.LowerDeclaration {Scope}
import parser.Diagnostic {Diagnostic}
import parser.NodeId {NodeId}
import parser.SyntaxTree {SyntaxTree}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.usize
import silk.vector {Vector}

/// Copies every lexical and parser diagnostic of `tree` into the module under construction.
effect fn copyDiagnostics(draft: &mut DraftState, tree: &SyntaxTree) -> ()
! OutOfMemoryError
? &mut Allocator {
  let diagnostics = Vector<Diagnostic>.asSlice(&tree.diagnostics)
  let mut index = usize.ZERO
  while index < diagnostics.length {
    let diagnostic = diagnostics[index]
    run Vector<Cause>.append(
      &mut draft.module.diagnostics,
      Cause {
        span: Draft.diagnosticSpan(diagnostic),
        code: Draft.diagnosticCode(diagnostic),
      },
    )
    index = index + usize.ONE
  }
  return ()
}

/// Lowers one parsed source file into a module that refers to nothing in `tree`.
///
/// # Details
///
/// `SourceFile` is a transparent container: its children become the module's declarations and the
/// root itself yields no HIR node, which is why no lowering function dispatches on that kind.
///
/// Every top-level declaration shares one key scope, so two same-named functions in one file take
/// occurrences zero and one. Members nested inside a declaration get their own scope, which is
/// what makes an owner key depend on the declaration's parent rather than on the whole file.
pub effect fn lower(tree: &SyntaxTree) -> Module ! OutOfMemoryError ? &mut Allocator {
  let mut draft = DraftState.make()
  draft.module.documentation = run LowerDeclaration.moduleDocumentation(&mut draft, tree)
  let mut scope = Scope.make()
  let mark = Draft.beginChildren(&draft)
  let count = Draft.childCount(tree, tree.root)
  let mut index = usize.ZERO
  while index < count {
    let child = Draft.childAt(tree, tree.root, index)
    let lowered = run LowerDeclaration.lowerDeclaration(&mut draft, tree, child, &mut scope)
    run Draft.pushChild(&mut draft, lowered)
    index = index + usize.ONE
  }
  let declarations = run Draft.finishChildren(&mut draft, mark)
  Scope.finish(move scope)
  draft.module.declarations = declarations
  run copyDiagnostics(&mut draft, tree)
  return DraftState.finish(move draft)
}
