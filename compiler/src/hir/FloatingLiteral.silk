//! Exact contextual rounding of an interned HIR floating literal.
//!
//! The HIR spelling contains only ASCII decimal syntax and has no digit separators. The standard
//! library parser compares decimal input with exact IEEE rounding boundaries, including ties,
//! subnormals, infinity and signed zero. Conversion happens only when a consumer demands a width.

import hir.Hir {Module}
import hir.Intern {Symbol}
import silk.f32
import silk.f64
import silk.format {Format, ParseError}
import silk.result {Result}
import silk.string {String}
import silk.u32
import silk.u64

fn text(module: &Module, spelling: Symbol) -> string {
  // Draft.floatingLiteral interns only lexer-validated ASCII decimal bytes.
  unsafe {
    return String.fromUtf8Unchecked(Module.text(module, spelling))
  }
  return ""
}

fn decimal(digits: &[u8]) -> string {
  unsafe {
    return String.fromUtf8Unchecked(digits)
  }
  return ""
}

/// Rounds the exact decimal spelling directly to IEEE binary32 bits.
pub fn f32Bits(module: &Module, spelling: Symbol) -> Result<u32, ParseError> {
  return match move Format.f32Value(text(module, spelling)) {
    Result<f32, ParseError>.Success {value} => Result<u32, ParseError>.succeed(f32.toBits(value))
    Result<f32, ParseError>.Failure {error} => Result<u32, ParseError>.failResult(move error)
  }
}

/// Rounds the exact decimal spelling directly to IEEE binary64 bits.
pub fn f64Bits(module: &Module, spelling: Symbol) -> Result<u64, ParseError> {
  return match move Format.f64Value(text(module, spelling)) {
    Result<f64, ParseError>.Success {value} => Result<u64, ParseError>.succeed(f64.toBits(value))
    Result<f64, ParseError>.Failure {error} => Result<u64, ParseError>.failResult(move error)
  }
}

/// Whether the decimal spelling `digits` rounds to a finite value at binary32 (`narrow`) or
/// binary64. A spelling past the largest finite value rounds to infinity, which no literal denotes
/// (SEM0095). Interned HIR spellings are lexer-validated ASCII decimal bytes.
pub fn finite(digits: &[u8], narrow: bool) -> bool {
  let spelled = decimal(digits)
  if narrow {
    return match move Format.f32Value(spelled) {
      Result<f32, ParseError>.Success {value} => !f32.isInfinite(value)
      Result<f32, ParseError>.Failure {error: _} => true
    }
  }
  return match move Format.f64Value(spelled) {
    Result<f64, ParseError>.Success {value} => !f64.isInfinite(value)
    Result<f64, ParseError>.Failure {error: _} => true
  }
}
