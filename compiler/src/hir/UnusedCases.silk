//! Tests for the unused-local and unused-import warnings `hir.Unused` finds in one module's HIR.

import hir.Hir { Module }
import hir.Lower
import hir.Unused as Unused { Unused as Found, UnusedKind }
import parser.ParserCases
import silk.core.effect { Effect }
import silk.collections.list { List }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.testing.testing { AssertionError, Testing }
import silk.text.string { String }
import silk.num.usize

effect fn lowered(source: string<'static>) -> Module ! OutOfMemoryError ? &mut Allocator {
  let tree = run ParserCases.parseWithAllocator(source)
  let module = run Lower.lower(&tree)
  drop tree
  return move module
}

// The spelling at each finding of `kind` in `source`, in report order, joined by spaces.
effect fn spelled(source: string<'static>, kind: UnusedKind) -> List<u8> ! OutOfMemoryError ? &mut Allocator {
  let module = run lowered(source)
  let found = run Unused.find(&module)
  let text = String.utf8Bytes(source)
  let listed = List<Found>.asSlice(&found)
  let mut joined = List<u8>.make()
  let mut at = usize.ZERO
  while at < listed.length {
    if listed[at].kind == kind {
      if List<u8>.length(&joined) > usize.ZERO { run List<u8>.append(&mut joined, 32) }
      let mut byte = listed[at].span.start
      while byte < listed[at].span.end {
        run List<u8>.append(&mut joined, text[byte])
        byte = byte + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return move joined
}

fn equals(left: &List<u8>, right: &[u8]) -> bool {
  let held = List<u8>.asSlice(left)
  if held.length != right.length { return false }
  let mut at = usize.ZERO
  while at < held.length {
    if held[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn checkLocals() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let source = """fn work(unusedParameter: i32, b: i32) -> i32 {
  let idle = 1
  let _kept = 2
  let mut total = b
  total = total + 1
  let read = 3
  let Pair { left, right } = pair()
  if true {
    let read = 4
    total = total + read
  }
  static for each in items() {
    let inner = each
  }
  return total + left
}
"""
  let found = run spelled(source, UnusedKind.Local)
  run Testing.expect(equals(&found, b"idle read right inner"),
    "unnamed let, pattern and loop-body bindings are unused; parameters, `_` names and assigned or shadowed reads are not")
  return ()
}

effect fn checkImports() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let source = """import a.used
import a.idle
import a.renamed as alias
import b.members { Kept, Dropped, Original as Local }
import c.hybrid as space { Member }
pub import d.published { Shown }

fn work(value: Kept) -> i32 {
  let Member = 1
  return used.size + Member
}
"""
  let found = run spelled(source, UnusedKind.Import)
  run Testing.expect(equals(&found, b"idle alias Dropped Local space Member"),
    "every private binding no name spells is unused, including one only a local of the same name reads")
  return ()
}

effect fn checkSyntaxErrors() -> () ! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let module = run lowered("import a.idle\nfn work( -> i32 { let idle = 1 }\n")
  let found = run Unused.find(&module)
  run Testing.expect(List<Found>.length(&found) == usize.ZERO, "a module with syntax errors reports nothing")
  return ()
}

test effect fn unusedLocalsAreFound() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkLocals() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn unusedImportsAreFound() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkImports() |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn syntaxErrorsReportNoUnusedBinding() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run checkSyntaxErrors() |> Effect.provideMut<Allocator>(&mut allocator)
}
