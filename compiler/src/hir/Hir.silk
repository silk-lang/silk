/// Reports every arena invariant that `module` violates, in node order.
///
/// # When to use
///
/// Use after lowering, and in tests, to prove a module is well formed without a structured-clone
/// publication step. An empty result means the module satisfies every invariant this checks.
///
/// # Details
///
/// The checks are: `spans` and `nodeCauses` have the same length as `nodes`; every child identity
/// is lower than the identity of the node that references it and inside the arena; every child
/// range, cause range, symbol, and top-level declaration identity lies inside its storage; and
/// every `Missing` or `Invalid` node records at least one cause.
///
/// # Gotchas
///
/// This verifies arena consistency, not lowering fidelity. A module that lowers the wrong syntax
/// faithfully into a consistent arena passes.
///
/// It also does not prove that the arena is a forest — that one traversal from `declarations`
/// reaches every node exactly once and that a child's span lies inside its parent's. That needs a
/// per-node owner count threaded through all 132 arms of the field walk, only to exempt
/// [`Node.IdentifierExpression`]'s `binding`, which points at a binder some other node owns.
/// `compiler/scripts/lower-corpus.mjs` proves it from the dump instead, over every fixture,
/// self-hosted source, and standard-library module.
pub effect fn verify(module: &Module) -> Vector<Defect> ! OutOfMemoryError ? &mut Allocator {
  let mut walk = Walk {defects: Vector.make<Defect>(), children: Vector.make<HirId>()}
  if Vector.length<Span>(&module.spans) != Vector.length<Node>(&module.nodes) {
    run Vector.append<Defect>(
      &mut walk.defects,
      Defect {violation: Violation.SpanCountMismatch, id: HirId {index: usize.ZERO}},
    )
  }
  if Vector.length<Range>(&module.nodeCauses) != Vector.length<Node>(&module.nodes) {
    run Vector.append<Defect>(
      &mut walk.defects,
      Defect {violation: Violation.CauseCountMismatch, id: HirId {index: usize.ZERO}},
    )
  }
  if module.declarations.start + module.declarations.length
    > Vector.length<HirId>(&module.children) {
    run Vector.append<Defect>(
      &mut walk.defects,
      Defect {violation: Violation.ReferenceOutOfBounds, id: HirId {index: usize.ZERO}},
    )
  } else {
    let mut declaration = usize.ZERO
    while declaration < module.declarations.length {
      let id = Module.child(module, module.declarations, declaration)
      if id.index >= Vector.length<Node>(&module.nodes) {
        run Vector.append<Defect>(
      &mut walk.defects,
          Defect {violation: Violation.ReferenceOutOfBounds, id: HirId {index: usize.ZERO}},
        )
      }
      declaration = declaration + usize.ONE
    }
  }
  if module.documentation.present {
    if module.documentation.symbol.index >= StringTable.length(&module.strings) {
      run Vector.append<Defect>(
      &mut walk.defects,
        Defect {violation: Violation.ReferenceOutOfBounds, id: HirId {index: usize.ZERO}},
      )
    }
  }
  let mut index = usize.ZERO
  while index < Vector.length<Node>(&module.nodes) {
    if index < Vector.length<Range>(&module.nodeCauses) {
      run verifyCauses(module, index, &mut walk)
    }
    run verifyNode(module, index, &mut walk)
    Vector.clear<HirId>(&mut walk.children)
    index = index + usize.ONE
  }
  return move walk.defects
}

/// The nodes `id` owns, in field order.
///
/// # Details
///
/// This is the verifier's own field walk, so every node kind is covered. A resolved identifier's
/// `binding` names a binder another construct owns, so it is not a child. On a module that
/// [`verify`] accepts, the result is exactly the node's children in the arena forest.
pub effect fn ownedChildren(module: &Module, id: HirId) -> Vector<HirId> ! OutOfMemoryError ? &mut Allocator {
  let mut walk = Walk {defects: Vector.make<Defect>(), children: Vector.make<HirId>()}
  run verifyNode(module, id.index, &mut walk)
  if let Node.IdentifierExpression {binding, ..} = Module.node(module, id) {
    if binding.present {
      let mut owned = Vector.make<HirId>()
      let listed = Vector.asSlice<HirId>(&walk.children)
      let mut at = usize.ZERO
      while at < listed.length {
        if listed[at].index != binding.id.index { run Vector.append<HirId>(&mut owned, listed[at]) }
        at = at + usize.ONE
      }
      return move owned
    }
  }
  return move walk.children
}

/// Returns the stable debug spelling of one violated arena invariant.
pub fn violationName(violation: Violation) -> string<'static> {
  return match violation {
    Violation.SpanCountMismatch => "SpanCountMismatch"
    Violation.CauseCountMismatch => "CauseCountMismatch"
    Violation.ChildNotBeforeParent => "ChildNotBeforeParent"
    Violation.ReferenceOutOfBounds => "ReferenceOutOfBounds"
    Violation.EmptyRecoveryCauses => "EmptyRecoveryCauses"
  }
}

/// Verifies `module` and writes a `violations <count>` section naming every defect it found.
///
/// # When to use
///
/// Call after [`write`] in a dump. A reader that sees `violations 0` knows the arena the dump
/// describes is self-consistent, so any disagreement it finds is its own decoding error.
///
/// # Details
///
/// The section repeats the shape of the `causes` and `diagnostics` sections: a count line, then
/// one `#<id> <Violation>` line per defect in the order [`verify`] reports them. A defect whose
/// violation concerns the arena as a whole rather than one node — [`SpanCountMismatch`] and
/// [`CauseCountMismatch`] — records `#0`, as [`Defect`] documents.
pub effect fn writeViolations(module: &Module) -> ()
! WriterError | OutOfMemoryError
? &mut Writer | &mut Allocator {
  let defects = run verify(module)
  run Writer.writeString("\nviolations ")
  run Format.display(&Vector.length<Defect>(&defects))
  run Writer.writeString("\n")
  let found = Vector.asSlice<Defect>(&defects)
  let mut index = usize.ZERO
  while index < found.length {
    let defect = found[index]
    run Writer.writeString("#")
    run Format.display(&defect.id.index)
    run Writer.writeString(" ")
    run Writer.writeString(violationName(defect.violation))
    run Writer.writeString("\n")
    index = index + usize.ONE
  }
  drop defects
  return ()
}
