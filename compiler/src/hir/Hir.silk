    }
    Node.RoleHeader {name, isPublic: ignored1} => {
      run recordId(module, parent, name, &mut walk.*)
    }
    Node.ConstantHeader {name, isPublic: ignored1, annotation} => {
      run recordId(module, parent, name, &mut walk.*)
