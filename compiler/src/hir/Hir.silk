      run recordId(module, parent, linkage, &mut walk.*)
      run recordRange(module, parent, properties, &mut walk.*)
    }
    Node.NoBody => ()
    Node.CallableBody {block} => {
      run recordRef(module, parent, block, &mut walk.*)
    }
    Node.InitializerBody {value} => {
      run recordRef(module, parent, value, &mut walk.*)
    }
    Node.PackageParameterBody {default, validation} => {
      run recordRef(module, parent, default, &mut walk.*)
