      run recordId(module, parent, annotation, &mut walk.*)
    }
    Node.CallableContract {generics, parameters, variadic: ignored1, result, failures, requirements, constraints, isEffect: ignored2, isTest: ignored3, environment, isUnsafe: ignored4, isStatic: ignored5, effectAnchor: ignored6, testAnchor: ignored7, unsafeAnchor: ignored8, staticAnchor: ignored9, genericsAnchor: ignored10, failuresAnchor: ignored11, constraintsAnchor: ignored12} => {
      run recordRange(module, parent, generics, &mut walk.*)
      run recordRange(module, parent, parameters, &mut walk.*)
      run recordRef(module, parent, result, &mut walk.*)
      run recordRef(module, parent, failures, &mut walk.*)
      run recordRef(module, parent, requirements, &mut walk.*)
      run recordRange(module, parent, constraints, &mut walk.*)
      run recordRangeRef(module, parent, environment, &mut walk.*)
    }
    Node.Property {name, value} => {
      run recordId(module, parent, name, &mut walk.*)
