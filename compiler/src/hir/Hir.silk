    Node.MoveExpression {operand} => {
      run recordId(module, parent, operand, &mut walk.*)
    }
    Node.BorrowExpression {access: ignored1, operand} => {
      run recordId(module, parent, operand, &mut walk.*)
    }
    Node.CallableExpression {contract, body} => {
      run recordId(module, parent, contract, &mut walk.*)
