    Node.UnsafeExpression {operand} => {
      run recordId(module, parent, operand, &mut walk.*)
    }
    Node.CompileErrorExpression {message} => {
      run recordId(module, parent, message, &mut walk.*)
    }
    Node.MatchExpression {access: ignored1, subject, arms} => {
      run recordId(module, parent, subject, &mut walk.*)
