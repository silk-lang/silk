//! The local bindings and imports of one module that nothing names.
//!
//! # When to use
//! Use [`find`] for the unused-local (SEM0252) and unused-import (MOD0007) warnings of one parsed
//! module. It reads the module's HIR alone, so it costs one walk of the node arena, demands no
//! semantic answer, and changes only when the module's own text does.
//!
//! # Details
//! A local is a `let` or `const` name, a `static for` name or a name a pattern binds. Lowering
//! resolves each identifier expression to its lexical binder (`IdentifierExpression.binding`), so
//! a binder that no identifier names is unused. Parameters are not reported: an implementation
//! must accept every parameter its interface or service declares.
//!
//! An import binding is used when a name outside import declarations spells it, other than an
//! identifier that resolves to a local. This counts a field or member with the same spelling as a
//! use, so a reported import is always unused, while an unused one can go unreported.
//! A `pub import` publishes its bindings and is never reported.
//!
//! A name that starts with `_` is never reported. A module with syntax errors reports nothing,
//! because its recovered tree can be missing uses.

import hir.Hir { Diagnostic, HirId, HirRef, Module, Node, PackedNode, RangeRef }
import hir.Intern { StringTable, Symbol }
import lexer.Span { Span }
import silk.mem.allocator { Allocator, OutOfMemoryError }
import silk.collections.list { List }
import silk.core.ownership { Copy }
import silk.num.usize

/// What kind of binding nothing names.
pub enum UnusedKind {
  /// A `let`, `const`, `static for` or pattern binding of a body.
  Local,
  /// A namespace or selected-member binding of a module-private import.
  Import,
}

/// One binding that nothing names.
pub struct Unused {
  pub kind: UnusedKind,
  /// The span of the binding's written name.
  pub span: Span,
}

impl Copy for Unused {}

// One import binding: the name node that binds it and its symbol.
struct Imported {
  name: HirId,
  symbol: Symbol,
}

impl Copy for Imported {}

/// The unused locals and imports of `module`: locals in arena order, then imports in written order.
pub effect fn find(module: &Module) -> List<Unused> ! OutOfMemoryError ? &mut Allocator {
  let mut found = List<Unused>.make()
  if List<Diagnostic>.length(&module.diagnostics) > usize.ZERO { return move found }
  let count = List<PackedNode>.length(&module.nodes)
  // Whether an identifier names each node, and how many names outside imports spell each symbol.
  let mut named = List<bool>.make()
  run List<bool>.appendRepeated(&mut named, false, count)
  let mut spelled = List<u32>.make()
  run List<u32>.appendRepeated(&mut spelled, 0, StringTable.length(&module.strings))
  let mut imports = List<Imported>.make()
  let mut at = usize.ZERO
  while at < count {
    match Module.node(module, HirId { index: at }) {
      Node.Name { text } => { bump(&mut spelled, text, true) }
      Node.IdentifierExpression { name, binding } => {
        if binding.present {
          List<bool>.set(&mut named, binding.id.index, true)
          // The name reads a local, not an import that happens to share its spelling.
          if let Node.Name { text } = Module.node(module, name) { bump(&mut spelled, text, false) }
        }
      }
      // A binder's own name is not a use of an import that shares its spelling.
      Node.BindingStatement { name, .. } => { run uncount(module, &mut spelled, name) }
      Node.BindingPattern { name, .. } => { run uncount(module, &mut spelled, name) }
      Node.Parameter { name, .. } => { run uncount(module, &mut spelled, name) }
      Node.StaticForStatement { binding, .. } => { run uncount(module, &mut spelled, binding) }
      Node.ImportHeader { isPublic, path, alias, members } => {
        run importBindings(module, &mut spelled, &mut imports, isPublic, path, alias, members)
      }
      _ => ()
    }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < count {
    let binder = match Module.node(module, HirId { index: at }) {
      Node.BindingStatement { name, .. } => HirRef.of(name)
      Node.BindingPattern { name, .. } => HirRef.of(name)
      Node.StaticForStatement { binding, .. } => HirRef.of(binding)
      _ => HirRef.absent()
    }
    // A `static for` binds its name node itself; the other binders are named through their node.
    let mut reached = at
    if let Node.StaticForStatement { binding, .. } = Module.node(module, HirId { index: at }) { reached = binding.index }
    if binder.present && !List<bool>.get(&named, reached) && reported(module, binder.id) {
      run List<Unused>.append(&mut found, Unused { kind: UnusedKind.Local, span: Module.span(module, binder.id) })
    }
    at = at + usize.ONE
  }
  let listed = List<Imported>.asSlice(&imports)
  at = usize.ZERO
  while at < listed.length {
    if List<u32>.get(&spelled, listed[at].symbol.index) == 0 && reported(module, listed[at].name) {
      run List<Unused>.append(&mut found, Unused { kind: UnusedKind.Import, span: Module.span(module, listed[at].name) })
    }
    at = at + usize.ONE
  }
  return move found
}

// Counts one more, or one fewer, name that spells `symbol` outside imports.
fn bump(spelled: &mut List<u32>, symbol: Symbol, up: bool) -> () {
  let held = List<u32>.get(&spelled.*, symbol.index)
  if up {
    List<u32>.set(&mut spelled.*, symbol.index, held + 1)
  } else if held > 0 {
    List<u32>.set(&mut spelled.*, symbol.index, held - 1)
  }
}

// Records the bindings of one import header and uncounts the names it writes, which are not uses.
effect fn importBindings(
  module: &Module,
  spelled: &mut List<u32>,
  imports: &mut List<Imported>,
  isPublic: bool,
  path: HirId,
  alias: HirRef,
  members: RangeRef,
) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut last = HirRef.absent()
  if let Node.Path { segments } = Module.node(module, path) {
    let mut at = usize.ZERO
    while at < segments.length {
      let segment = Module.child(module, segments, at)
      run uncount(module, &mut spelled.*, segment)
      last = HirRef.of(segment)
      at = at + usize.ONE
    }
  } else {
    run uncount(module, &mut spelled.*, path)
  }
  if alias.present { run uncount(module, &mut spelled.*, alias.id) }
  // A selective import binds only its members; a namespace binding needs no members or an alias.
  if !isPublic {
    if alias.present {
      run record(module, &mut imports.*, alias.id)
    } else if !members.present && last.present {
      run record(module, &mut imports.*, last.id)
    }
  }
  if members.present {
    let mut at = usize.ZERO
    while at < members.range.length {
      if let Node.ImportMember { name, alias: renamed } = Module.node(module, Module.child(module, members.range, at)) {
        run uncount(module, &mut spelled.*, name)
        if renamed.present { run uncount(module, &mut spelled.*, renamed.id) }
        if !isPublic {
          if renamed.present { run record(module, &mut imports.*, renamed.id) } else { run record(module, &mut imports.*, name) }
        }
      }
      at = at + usize.ONE
    }
  }
}

effect fn uncount(module: &Module, spelled: &mut List<u32>, name: HirId) -> () ! OutOfMemoryError ? &mut Allocator {
  if let Node.Name { text } = Module.node(module, name) { bump(&mut spelled.*, text, false) }
}

effect fn record(module: &Module, imports: &mut List<Imported>, name: HirId) -> () ! OutOfMemoryError ? &mut Allocator {
  if let Node.Name { text } = Module.node(module, name) {
    run List<Imported>.append(&mut imports.*, Imported { name: name, symbol: text })
  }
}

// Whether the binding written at `name` is reported: a written name that does not start with `_`.
fn reported(module: &Module, name: HirId) -> bool {
  if let Node.Name { text } = Module.node(module, name) {
    let spelling = Module.text(module, text)
    return spelling.length > usize.ZERO && spelling[usize.ZERO] != 95
  }
  return false
}
