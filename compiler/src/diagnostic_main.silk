//! Independently bootstrap-built strict inventory entry. The original main source is the target.
//! Usage: diagnostic_main COMPILER_MAIN STDLIB_ROOT VERIFIED_SEED_RECEIPT
import diagnostic.StrictInventory
import diagnostic.StrictInventoryResult {SweepPins}
import driver.ModuleSources as Sources {InvalidBuildComposition, InvalidSourceRoot}
import driver.NativeLinkInput {InvalidNativeLinkInput}
import semantic.DeclarationId {DeclarationId}
import semantic.ModuleId {InvalidModulePath}
import semantic.SourceIndex {RevisionMismatch}
import semantic.Semantic {Semantic}
import semantic.InitialProfile {Input, InitialProfile, Problem as InitialProblem}
import semantic.FinalProfile {FinalProfile, Entry, Problem as FinalProblem}
import semantic.ProfileBinding {RegisteredShape}
import semantic.Target {Target, Id as TargetId}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.effect {Effect}
import silk.filesystem {FileSystem, FileError, Path}
import silk.host_input {HostInput, HostInputError}
import silk.json_value {Json, Value as JsonValue}
import silk.json_scanner {JsonError}
import silk.option {Option}
import silk.os_filesystem {OsFileSystem}
import silk.os_writer {StdoutWriter}
import silk.result {Result}
import silk.sha2 {Sha256}
import silk.string {String}
import silk.toml_scanner {TomlError}
import silk.usize
import silk.vector {Vector}
import silk.writer {Writer, WriterError}

pub struct InvalidInventoryInput {}

fn same(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn argument(index: usize) -> Bytes ! HostInputError | OutOfMemoryError | InvalidInventoryInput
? &mut HostInput | &mut Allocator {
  return match move run HostInput.argument(index) {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => { fail InvalidInventoryInput {} }
  }
}

/// Profile facts come from the consumed receipt, including an explicit boolean debug value.
pub effect fn profile(receipt: &JsonValue) -> FinalProfile
! InvalidInventoryInput | InitialProblem | OutOfMemoryError ? &mut Allocator {
  let target = Json.asString(Json.fieldAt(Json.field(receipt, "profile"), "target"))
  if let Option<string>.Some {value} = move target {
    if !same(String.utf8Bytes(value), b"x86_64-unknown-linux-gnu") { fail InvalidInventoryInput {} }
  } else { fail InvalidInventoryInput {} }
  let optimization = match move Json.asString(Json.fieldAt(Json.field(receipt, "profile"), "optimization")) {
    Option<string>.Some {value} => run Bytes.copy(String.utf8Bytes(value))
    Option<string>.None => { fail InvalidInventoryInput {} }
  }
  let debug = match move Json.fieldAt(Json.field(receipt, "profile"), "debug") {
    Option<&JsonValue>.Some {value: selected} => match &selected.* { JsonValue.Bool {value} => value _ => { fail InvalidInventoryInput {} } }
    _ => { fail InvalidInventoryInput {} }
  }
  let mut input = Input.make()
  input.target = Option.some<Bytes>(run Bytes.copy(b"x86_64-unknown-linux-gnu"))
  input.optimization = Option.some<Bytes>(move optimization)
  input.debug = Option.some<bool>(debug)
  let initial = run InitialProfile.freeze(&input)
  let published = run FinalProfile.publish(move initial, Vector.asSlice<RegisteredShape>(&Vector.make<RegisteredShape>()), Vector.make<Entry>(), Vector.asSlice<DeclarationId>(&Vector.make<DeclarationId>()))
  return match move published {
    Result<FinalProfile, FinalProblem>.Success {value} => move value
    Result<FinalProfile, FinalProblem>.Failure {..} => { fail InvalidInventoryInput {} }
  }
}

fn pinText(value: Option<&JsonValue>, length: usize) -> bool {
  return match move Json.asString(move value) {
    Option<string>.Some {value: text} => {
      let bytes = String.utf8Bytes(text)
      if length == usize.ZERO { return bytes.length > usize.ZERO }
      if bytes.length != length { return false }
      let mut at = usize.ZERO
      while at < bytes.length {
        let digit = bytes[at]
        if !((digit >= 48 && digit <= 57) || (digit >= 97 && digit <= 102)) { return false }
        at = at + usize.ONE
      }
      return true
    }
    _ => false
  }
}

/// Retain only structurally complete pin receipts. Artifact verification remains V03/V04;
/// this diagnostic consumer never promotes a supplied receipt into a verified N0 stage result.
effect fn validateReceipt(receipt: &JsonValue) -> () ! InvalidInventoryInput {
  if Option.unwrapOr<i32>(Json.asI32(Json.field(receipt, "schemaVersion")), 0) != 1 || !pinText(Json.field(receipt, "sourceCommit"), 40) { fail InvalidInventoryInput {} }
  if !pinText(Json.fieldAt(Json.field(receipt, "inputSnapshot"), "archiveSha256"), 64) || !pinText(Json.fieldAt(Json.field(receipt, "inputSnapshot"), "normalizedDigest"), 64) || !pinText(Json.fieldAt(Json.field(receipt, "inputSnapshot"), "compilerDigest"), 64) || !pinText(Json.fieldAt(Json.field(receipt, "inputSnapshot"), "stdlibDigest"), 64) { fail InvalidInventoryInput {} }
  if !pinText(Json.fieldAt(Json.field(receipt, "bootstrap"), "commit"), 40) || !pinText(Json.fieldAt(Json.field(receipt, "bootstrap"), "sha256"), 64) || !pinText(Json.fieldAt(Json.field(receipt, "bootstrap"), "runId"), 0) { fail InvalidInventoryInput {} }
  if !pinText(Json.fieldAt(Json.fieldAt(Json.field(receipt, "toolchain"), "clang"), "sha256"), 64) || !pinText(Json.fieldAt(Json.fieldAt(Json.field(receipt, "toolchain"), "clang"), "version"), 0) || !pinText(Json.fieldAt(Json.fieldAt(Json.field(receipt, "toolchain"), "llvmAr"), "sha256"), 64) || !pinText(Json.fieldAt(Json.fieldAt(Json.field(receipt, "toolchain"), "llvmAr"), "version"), 0) || !pinText(Json.fieldAt(Json.field(receipt, "binary"), "sha256"), 64) { fail InvalidInventoryInput {} }
  return ()
}

effect fn fileArgument(base: &Path, bytes: &[u8]) -> Path
! FileError | OutOfMemoryError ? &mut Allocator {
  if bytes.length > usize.ZERO && bytes[usize.ZERO] == 47 { return run Path.fromBytes(bytes) }
  return run Path.joinBytes(base, bytes)
}

effect fn execute(source: &Path, standardLibrary: &Path, seed: Bytes, producer: &Path) -> i32
! FileError | InvalidModulePath | InvalidSourceRoot | InvalidBuildComposition | InvalidNativeLinkInput | TomlError | OutOfMemoryError | JsonError | InvalidInventoryInput | InitialProblem | WriterError
? &mut FileSystem | &mut Allocator | &mut Writer {
  let receipt = run Json.parse(Bytes.asSlice(&seed))
  run validateReceipt(&receipt)
  let selected = run profile(&receipt)
  let optimization = match move FinalProfile.text(&selected, b"optimization") { Option<&[u8]>.Some {value} => run Bytes.copy(value) _ => { fail InvalidInventoryInput {} } }
  let debug = match move FinalProfile.flag(&selected, b"debug") { Option<bool>.Some {value} => value _ => { fail InvalidInventoryInput {} } }
  let producerBytes = run FileSystem.readFile(producer)
  let pins = SweepPins {producerFile: run Bytes.copy(Path.rawBytes(producer)), producerDigest: Sha256.hash(Bytes.asSlice(&producerBytes)), seedDigest: Sha256.hash(Bytes.asSlice(&seed)), seedReceipt: move seed, optimization: move optimization, debug: debug}
  let libraryCopy = run Path.fromBytes(Path.rawBytes(standardLibrary))
  let mut sources = run Sources.make(source, Option.some<Path>(move libraryCopy))
  let mut store = Semantic.make(run Sources.revision(&sources), Target.forId(TargetId.X8664UnknownLinuxGnu), Option.some<FinalProfile>(move selected))
  let sweep = run StrictInventory.collect(&mut sources, &mut store)
  let output = run StrictInventory.encode(&sweep, &sources, &pins)
  run Writer.writeAll(Bytes.asSlice(&output))
  return StrictInventory.exitCode(&sweep)
}

effect fn program() -> i32
! HostInputError | FileError | InvalidModulePath | InvalidSourceRoot | InvalidBuildComposition | InvalidNativeLinkInput | TomlError | OutOfMemoryError | JsonError | InvalidInventoryInput | InitialProblem | WriterError
? &mut HostInput | &mut Allocator | &mut Writer {
  let count = run HostInput.argumentCount()
  if count != 4 { fail InvalidInventoryInput {} }
  let cwd = run HostInput.workingDirectory()
  let base = run Path.fromBytes(Bytes.asSlice(&cwd))
  let sourceArgument = run argument(1)
  let libraryArgument = run argument(2)
  let seedArgument = run argument(3)
  let producerArgument = run argument(0)
  let source = run fileArgument(&base, Bytes.asSlice(&sourceArgument))
  let standardLibrary = run fileArgument(&base, Bytes.asSlice(&libraryArgument))
  let seedPath = run fileArgument(&base, Bytes.asSlice(&seedArgument))
  let producer = run fileArgument(&base, Bytes.asSlice(&producerArgument))
  let mut files = run OsFileSystem.make(b"/")
  let seed = run FileSystem.readFile(&seedPath) |> Effect.provideMut<FileSystem>(&mut files)
  return run execute(&source, &standardLibrary, move seed, &producer) |> Effect.provideMut<FileSystem>(&mut files)
}

pub effect fn main() -> i32 ! WriterError ? &mut HostInput {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut output = StdoutWriter.make()
  let result = run Effect.result(program() |> Effect.provideMut<Allocator>(&mut allocator) |> Effect.provideMut<Writer>(&mut output))
  return match move result {
    Result<i32, HostInputError | FileError | InvalidModulePath | InvalidSourceRoot | InvalidBuildComposition | InvalidNativeLinkInput | TomlError | OutOfMemoryError | JsonError | InvalidInventoryInput | InitialProblem | WriterError>.Success {value} => value
    Result<i32, HostInputError | FileError | InvalidModulePath | InvalidSourceRoot | InvalidBuildComposition | InvalidNativeLinkInput | TomlError | OutOfMemoryError | JsonError | InvalidInventoryInput | InitialProblem | WriterError>.Failure {..} => {
      // No allocation is needed to invalidate the run. A signal/timeout has no footer at all.
      run Writer.writeAll(b"{\"schema\":\"silk.strict-inventory\",\"version\":1,\"record\":\"footer\",\"coverage_complete\":false,\"strict_success\":false,\"modules\":null,\"functions\":null,\"records\":null,\"expected_records\":null}\n") |> Effect.provideMut<Writer>(&mut output)
      return 3
    }
  }
}
