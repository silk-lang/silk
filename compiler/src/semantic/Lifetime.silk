//! Canonical validity relationships in resolved type and signature facts.
//!
//! # When to use
//! Use [`Lifetime`] to retain the owner of a written or elided lifetime in a type. A lifetime
//! identity records a contract; it does not establish a loan or prove that a borrow is valid. Use
//! [`Intersection`] for a retained environment such as `'call & 'env`. Use [`Numbering`] to
//! canonicalize the caller regions of one selected instance.

import semantic.DeclarationId {DeclarationId}
import semantic.RuntimeEncoding
import silk.allocator {Allocator, OutOfMemoryError}
import silk.pointer {Pointer}
import silk.option {Option}
import silk.result {Result}
import silk.shared {Shared}
import silk.usize
import silk.vector {Vector}

/// A validity atom or the common validity of a canonical finite set of atoms.
pub union Lifetime {
  /// The distinguished program-valid lifetime.
  Static,
  /// A written or header-elided declaration-owned lifetime parameter.
  Parameter {
    /// The declaration that binds this lifetime.
    pub declaration: DeclarationId,
    /// The parameter's position in the declaration's complete binder list.
    pub ordinal: usize,
  },
  /// A borrow region rooted at a source expression in one declaration's checked body.
  /// Safety obligations retain this identity until the abstract borrow checker runs.
  Local {pub declaration: DeclarationId, pub ordinal: usize},
  /// A fresh region of each invocation, bound by the enclosing callable contract's quantifier.
  ///
  /// Quantified contracts do not nest, so the position identifies the binder; the spelling does
  /// not, and two contracts that differ only in binder names are equal.
  Invocation {
    /// The binder's position in the callable's written and elided invocation binders.
    pub ordinal: usize,
  },
  /// Common validity of two or more distinct non-static atoms. Construct with Lifetime.meet.
  Meet {members: Shared<Intersection>},
  /// A caller atom numbered injectively across the complete selected instance's input domain.
  /// Region sharing and meet incidence are retained; raw caller identities are absent.
  Supplied {
    /// The atom's injective canonical position in the instance's complete inputs.
    pub ordinal: usize,
  },
}

/// The common validity of a finite set of regions, as written for a retained environment.
///
/// # Details
///
/// Members are distinct and never `'static`; the empty intersection is `'static`. Order and
/// repetition do not affect identity. Members are atoms: factories flatten meet inputs before
/// publication, and comparisons clone members before releasing their parent's Shared loan.
pub struct Intersection {
  /// The distinct non-static constituent regions.
  pub members: Vector<Member>
}

/// A closed-domain caller-atom renaming transaction. Collection never assigns an ordinal;
/// rewriting uses a frozen injective map. One transaction owns all work counters and draft state.
pub struct Numbering {
  phase: NumberingPhase
  regions: Vector<Member>
  positions: Vector<usize>
  occurrences: Vector<RegionOccurrence>
  sites: usize
  hasUnordered: bool
  fault: Option<CanonicalizationFailure>
  remainingUnits: usize
  remainingStates: usize
  bytesLeft: usize
  active: Vector<StructuralVisit>
  survey: RegionSurvey
}

/// Every region site of a domain in walk order, each with all of its atoms. Two domains of one
/// erased shape walk the same sites, so their surveys compare position by position.
pub struct RegionSurvey {
  atoms: Vector<Shared<Lifetime>>
  widths: Vector<usize>
}

/// A finite closed-domain identity could not be established. No key may be published.
pub enum CanonicalizationFailure { Resource, Cycle, UncollectedAtom }

/// Structural work units, attempted search states and record bytes for one complete domain.
pub const canonicalizationUnits: usize = 32768
pub const canonicalizationStates: usize = 65536
pub const canonicalizationBytes: usize = 8388608

enum NumberingPhase { Inactive, Collecting, Frozen, Surveying }
struct RegionOccurrence {atom: usize site: usize}
struct StructuralVisit {address: usize kind: usize}

/// One constituent region of an [`Intersection`].
// A struct element rather than `Vector<Shared<Lifetime>>`: bootstrap specialization otherwise reads
// this drop path beside `Vector<Shared<Type>>` inside `Type` as polymorphic recursion (SEM0053).
pub struct Member {
  /// The constituent region.
  pub region: Shared<Lifetime>
}

fn addressOf(value: &Lifetime) -> usize {
  return Pointer.address<Lifetime>(Pointer.fromRef<Lifetime>(value))
}

fn sameValue(first: &Lifetime, second: &Lifetime) -> bool {
  return match & first.* {
    Lifetime.Static => match & second.* {
      Lifetime.Static => true
      _ => false
    }
    Lifetime.Parameter {declaration, ordinal} => match & second.* {
      Lifetime.Parameter {declaration: compared, ordinal: position} => DeclarationId.equals(
        &declaration,
        &compared,
      ) && ordinal == position
      _ => false
    }
    Lifetime.Local {declaration, ordinal} => match & second.* {
      Lifetime.Local {declaration: compared, ordinal: position} => DeclarationId.equals(
        &declaration,
        &compared,
      ) && ordinal == position
      _ => false
    }
    Lifetime.Invocation {ordinal} => match & second.* {
      Lifetime.Invocation {ordinal: position} => ordinal == position
      _ => false
    }
    Lifetime.Meet {..} => false
    Lifetime.Supplied {ordinal} => match & second.* {
      Lifetime.Supplied {ordinal: position} => ordinal == position
      _ => false
    }
  }
}

fn valueWith(first: &Lifetime, right: &Shared<Lifetime>) -> bool {
  return Shared.with<Lifetime, bool>(
    right,
    fn(second: &Lifetime) -> bool {
      return sameValue(first, second)
    },
  )
}

fn isStatic(value: &Lifetime) -> bool {
  return match & value.* {
    Lifetime.Static => true
    _ => false
  }
}

fn contains(members: &[Member], candidate: &Shared<Lifetime>) -> bool {
  return memberPosition(members, candidate) < members.length
}

// The position of `candidate` among `members`, or `members.length` when it is absent.
fn memberPosition(members: &[Member], candidate: &Shared<Lifetime>) -> usize {
  let mut at = usize.ZERO
  while at < members.length {
    if Lifetime.equalsShared(&members[at].region, candidate) {
      return at
    }
    at = at + usize.ONE
  }
  return members.length
}

// A borrow region of the caller's body, or a region the caller itself received as an instance.
fn callerRegion(value: &Lifetime) -> bool {
  return match & value.* {
    Lifetime.Local {..} => true
    Lifetime.Supplied {..} => true
    _ => false
  }
}

impl Lifetime {
  /// Reports whether two lifetime handles name the same validity relationship.
  ///
  /// # Details
  ///
  /// Parameters compare owner and position and invocation binders compare position. The same
  /// handle on both sides is compared by address, never by entering it twice.
  pub fn equalsShared(left: &Shared<Lifetime>, right: &Shared<Lifetime>) -> bool {
    if Shared.with<Lifetime, usize>(left, addressOf) == Shared.with<Lifetime, usize>(
      right,
      addressOf,
    ) {
      return true
    }
    let count = Lifetime.atomCount(left)
    if count != Lifetime.atomCount(right) { return false }
    let mut at = usize.ZERO
    while at < count {
      let firstAtom = Lifetime.atomAt(left, at)
      let mut found = false
      let mut other = usize.ZERO
      while !found && other < count {
        let secondAtom = Lifetime.atomAt(right, other)
        if Shared.with<Lifetime, usize>(&firstAtom, addressOf) == Shared.with<Lifetime, usize>(&secondAtom, addressOf) {
          found = true
        } else {
          found = Shared.with<Lifetime, bool>(&firstAtom, fn(first: &Lifetime) -> bool {
            return valueWith(first, &secondAtom)
          })
        }
        other = other + usize.ONE
      }
      if !found { return false }
      at = at + usize.ONE
    }
    return true
  }
}


fn lifetimeMeet(value: &Lifetime) -> Option<Shared<Intersection>> {
  return match &value.* {
    Lifetime.Meet {members} => Option.some<Shared<Intersection>>(Shared.clone<Intersection>(&members))
    _ => Option.none<Shared<Intersection>>()
  }
}

impl Lifetime {
  /// Number of constituent atoms; a scalar has one. No lifetime parent loan survives this call.
  pub fn atomCount(value: &Shared<Lifetime>) -> usize {
    let payload = Shared.with<Lifetime, Option<Shared<Intersection>>>(value, lifetimeMeet)
    if let Option<Shared<Intersection>>.Some {value: members} = move payload {
      return Shared.with<Intersection, usize>(&members, fn(meet: &Intersection) -> usize {
        return Vector.length<Member>(&meet.members)
      })
    }
    return usize.ONE
  }
  /// A cloned constituent handle at an index below atomCount; scalar index zero is itself.
  pub fn atomAt(value: &Shared<Lifetime>, at: usize) -> Shared<Lifetime> {
    let payload = Shared.with<Lifetime, Option<Shared<Intersection>>>(value, lifetimeMeet)
    if let Option<Shared<Intersection>>.Some {value: members} = move payload {
      return Shared.with<Intersection, Shared<Lifetime>>(&members, fn(meet: &Intersection) -> Shared<Lifetime> {
        let listed = Vector.asSlice<Member>(&meet.members)
        return Shared.clone<Lifetime>(&listed[at].region)
      })
    }
    return Shared.clone<Lifetime>(value)
  }
  /// Whether any constituent satisfies an atom classifier, after releasing the parent loan.
  pub fn anyAtom<'env>(value: &Shared<Lifetime>, predicate: fn<'env>(&Lifetime) -> bool) -> bool {
    let count = Lifetime.atomCount(value)
    let mut at = usize.ZERO
    while at < count {
      let atom = Lifetime.atomAt(value, at)
      if Shared.with<Lifetime, bool>(&atom, predicate) { return true }
      at = at + usize.ONE
    }
    return false
  }
  /// Whether every constituent satisfies an atom classifier. A meet is never hidden as Static.
  pub fn allAtoms<'env>(value: &Shared<Lifetime>, predicate: fn<'env>(&Lifetime) -> bool) -> bool {
    let count = Lifetime.atomCount(value)
    let mut at = usize.ZERO
    while at < count {
      let atom = Lifetime.atomAt(value, at)
      if !Shared.with<Lifetime, bool>(&atom, predicate) { return false }
      at = at + usize.ONE
    }
    return true
  }
  /// Assumption-independent common validity: flatten, remove Static, deduplicate and collapse.
  pub effect fn meet(regions: &[Shared<Lifetime>]) -> Shared<Lifetime>
  ! OutOfMemoryError ? &mut Allocator {
    let normalized = run Intersection.of(regions)
    let members = Vector.asSlice<Member>(&normalized.members)
    if members.length == usize.ZERO { return run Shared.make<Lifetime>(Lifetime.Static) }
    if members.length == usize.ONE { return Shared.clone<Lifetime>(&members[usize.ZERO].region) }
    return run Shared.make<Lifetime>(Lifetime.Meet {members: run Shared.make<Intersection>(move normalized)})
  }
}

// The position of `atom` among the substituted atoms, or their count when it is new.
fn substitutedAt(from: &Vector<Shared<Lifetime>>, atom: &Shared<Lifetime>) -> usize {
  let listed = Vector.asSlice<Shared<Lifetime>>(from)
  let mut at = usize.ZERO
  while at < listed.length {
    if Lifetime.equalsShared(&listed[at], atom) { return at }
    at = at + usize.ONE
  }
  return listed.length
}

impl RegionSurvey {
  /// Whether any atom of `region` occurs at a surveyed site.
  pub fn mentionsAny(self: &Self, region: &Shared<Lifetime>) -> bool {
    let count = Lifetime.atomCount(region)
    let mut at = usize.ZERO
    while at < count {
      let atom = Lifetime.atomAt(region, at)
      if substitutedAt(&self.atoms, &atom) != Vector.length<Shared<Lifetime>>(&self.atoms) { return true }
      at = at + usize.ONE
    }
    return false
  }
  /// Whether `other` is an instance of this survey: one substitution of this survey's caller
  /// atoms yields `other` site by site, while every other atom stays itself. A substitution may
  /// merge caller atoms or send them to `'static`; a site whose cardinality changes is not
  /// recognized, so the answer is conservative.
  pub effect fn generalizes(self: &Self, other: &RegionSurvey) -> bool ! OutOfMemoryError ? &mut Allocator {
    let widths = Vector.asSlice<usize>(&self.widths)
    let otherWidths = Vector.asSlice<usize>(&other.widths)
    if widths.length != otherWidths.length { return false }
    let mut site = usize.ZERO
    while site < widths.length {
      if widths[site] != otherWidths[site] { return false }
      site = site + usize.ONE
    }
    let atoms = Vector.asSlice<Shared<Lifetime>>(&self.atoms)
    let otherAtoms = Vector.asSlice<Shared<Lifetime>>(&other.atoms)
    let mut from = Vector.make<Shared<Lifetime>>()
    let mut to = Vector.make<Shared<Lifetime>>()
    let mut at = usize.ZERO
    while at < atoms.length {
      if Shared.with<Lifetime, bool>(&atoms[at], callerRegion) {
        let known = substitutedAt(&from, &atoms[at])
        if known == Vector.length<Shared<Lifetime>>(&from) {
          run Vector.append<Shared<Lifetime>>(&mut from, Shared.clone<Lifetime>(&atoms[at]))
          run Vector.append<Shared<Lifetime>>(&mut to, Shared.clone<Lifetime>(&otherAtoms[at]))
        } else {
          let images = Vector.asSlice<Shared<Lifetime>>(&to)
          if !Lifetime.equalsShared(&images[known], &otherAtoms[at]) { return false }
        }
      } else {
        if !Lifetime.equalsShared(&atoms[at], &otherAtoms[at]) { return false }
      }
      at = at + usize.ONE
    }
    return true
  }
}

impl Intersection {
  /// Forms the canonical intersection of the given regions.
  ///
  /// # Details
  ///
  /// `'static` is the identity and repeated regions collapse, so `'a & 'static & 'a` is `'a`.
  pub effect fn of(regions: &[Shared<Lifetime>]) -> Intersection ! OutOfMemoryError ? &mut Allocator {
    let mut members = Vector.make<Member>()
    let mut at = usize.ZERO
    while at < regions.length {
      let mut atomAt = usize.ZERO
      let atoms = Lifetime.atomCount(&regions[at])
      while atomAt < atoms {
        let candidate = Lifetime.atomAt(&regions[at], atomAt)
        if !Shared.with<Lifetime, bool>(&candidate, isStatic) && !contains(Vector.asSlice<Member>(&members), &candidate) {
          run Vector.append<Member>(&mut members, Member {region: move candidate})
        }
        atomAt = atomAt + usize.ONE
      }
      at = at + usize.ONE
    }
    return Intersection {members: move members}
  }
  /// Copies the member handles without copying the regions.
  pub effect fn copy(self: &Self) -> Intersection ! OutOfMemoryError ? &mut Allocator {
    let mut members = Vector.make<Member>()
    let source = Vector.asSlice<Member>(&self.members)
    let mut at = usize.ZERO
    while at < source.length {
      run Vector.append<Member>(
        &mut members,
        Member {region: Shared.clone<Lifetime>(&source[at].region)},
      )
      at = at + usize.ONE
    }
    return Intersection {members: move members}
  }
  /// Reports whether two intersections contain the same regions.
  pub fn equals(self: &Self, other: &Intersection) -> bool {
    let first = Vector.asSlice<Member>(&self.members)
    let second = Vector.asSlice<Member>(&other.members)
    if first.length != second.length {
      return false
    }
    let mut at = usize.ZERO
    while at < first.length {
      if !contains(second, &first[at].region) {
        return false
      }
      at = at + usize.ONE
    }
    return true
  }
}

fn collecting(value: &Numbering) -> bool { return match value.phase { NumberingPhase.Collecting => true _ => false } }
fn inactive(value: &Numbering) -> bool { return match value.phase { NumberingPhase.Inactive => true _ => false } }
fn surveying(value: &Numbering) -> bool { return match value.phase { NumberingPhase.Surveying => true _ => false } }

// A view of an authenticated normalized environment: no flattening, equality or deduplication.
// Empty means Static; a singleton is its actual atom; a larger set retains the same intersection.
effect fn normalizedEnvironmentRegion(value: &Shared<Intersection>, count: usize) -> Shared<Lifetime>
! OutOfMemoryError ? &mut Allocator {
  if count == usize.ZERO { return run Shared.make<Lifetime>(Lifetime.Static) }
  if count == usize.ONE {
    return Shared.with<Intersection, Shared<Lifetime>>(value, fn(environment: &Intersection) -> Shared<Lifetime> {
      let members = Vector.asSlice<Member>(&environment.members)
      return Shared.clone<Lifetime>(&members[usize.ZERO].region)
    })
  }
  return run Shared.make<Lifetime>(Lifetime.Meet {members: Shared.clone<Intersection>(value)})
}

fn activeCycle(value: &Numbering, address: usize, kind: usize) -> bool {
  let stack = Vector.asSlice<StructuralVisit>(&value.active)
  let mut at = usize.ZERO
  while at < stack.length {
    if stack[at].address == address && stack[at].kind == kind { return true }
    at = at + usize.ONE
  }
  return false
}

impl Numbering {
  /// No region renaming during ordinary simultaneous substitution.
  pub fn inactive() -> Numbering {
    return Numbering {phase: NumberingPhase.Inactive, regions: Vector.make<Member>(), positions: Vector.make<usize>(),
      occurrences: Vector.make<RegionOccurrence>(), sites: usize.ZERO, hasUnordered: false,
      fault: Option.none<CanonicalizationFailure>(), remainingUnits: canonicalizationUnits,
      remainingStates: canonicalizationStates, bytesLeft: canonicalizationBytes, active: Vector.make<StructuralVisit>(),
      survey: RegionSurvey {atoms: Vector.make<Shared<Lifetime>>(), widths: Vector.make<usize>()}}
  }
  /// A draft for all inputs of one closed domain; callers collect every root before freeze.
  pub fn collecting() -> Numbering {
    let mut value = Numbering.inactive()
    value.phase = NumberingPhase.Collecting
    return move value
  }
  /// Records every region site of a domain without renaming it; see [`surveyed`].
  pub fn surveying() -> Numbering {
    let mut value = Numbering.collecting()
    value.phase = NumberingPhase.Surveying
    return move value
  }
  /// The region sites a surveying walk recorded.
  pub fn surveyed(self: Self) -> RegionSurvey {
    let Numbering {phase, regions, positions, occurrences, sites, hasUnordered, fault, remainingUnits, remainingStates,
      bytesLeft, active, survey} = move self
    drop regions
    drop positions
    drop occurrences
    drop active
    return move survey
  }
  pub fn isActive(self: &Self) -> bool { return !inactive(self) }
  pub fn isCollecting(self: &Self) -> bool { return collecting(self) }
  pub fn remainingBytes(self: &Self) -> usize { return self.bytesLeft }
  pub fn failure(self: &Self) -> Option<CanonicalizationFailure> {
    return match &self.fault {
      Option<CanonicalizationFailure>.Some {value: reason} => Option.some<CanonicalizationFailure>(reason)
      Option<CanonicalizationFailure>.None => Option.none<CanonicalizationFailure>()
    }
  }
  fn reject(self: &mut Self, reason: CanonicalizationFailure) -> () {
    let vacant = match &self.fault { Option<CanonicalizationFailure>.None => true _ => false }
    if vacant { self.fault = Option.some<CanonicalizationFailure>(reason) }
    return ()
  }
  /// Charges every attempted structural node and incoming edge, and refuses active-path cycles.
  /// Shared DAG nodes can be visited at several occurrence sites; allocation identity is not output.
  /// Charges a structural collection or candidate-rewrite node/edge before retaining it.
  pub fn units(self: &mut Self, count: usize) -> bool {
    if inactive(&self.*) { return true }
    if let Option<CanonicalizationFailure>.Some {..} = &self.fault { return false }
    if count > self.remainingUnits {
      Numbering.reject(&mut self.*, CanonicalizationFailure.Resource)
      return false
    }
    self.remainingUnits = self.remainingUnits - count
    return true
  }
  pub effect fn enter(self: &mut Self, address: usize, kind: usize) -> bool
  ! OutOfMemoryError ? &mut Allocator {
    if inactive(&self.*) { return true }
    if let Option<CanonicalizationFailure>.Some {..} = &self.fault { return false }
    if self.remainingUnits < 2 { Numbering.reject(&mut self.*, CanonicalizationFailure.Resource)
      return false }
    self.remainingUnits = self.remainingUnits - 2
    // Active-path checks are attempted structural edges too. Charging them before scanning also
    // bounds recursion depth without a timing limit or an unchecked recursive collector.
    let activeCount = Vector.length<StructuralVisit>(&self.active)
    if !Numbering.units(&mut self.*, activeCount) { return false }
    let cycle = activeCycle(&self.*, address, kind)
    if cycle {
      Numbering.reject(&mut self.*, CanonicalizationFailure.Cycle)
      return false
    }
    run Vector.append<StructuralVisit>(&mut self.active, StructuralVisit {address: address, kind: kind})
    return true
  }
  pub fn leave(self: &mut Self) -> () {
    if !inactive(&self.*) {
      let count = Vector.length<StructuralVisit>(&self.active)
      if count != usize.ZERO { Vector.truncate<StructuralVisit>(&mut self.active, count - usize.ONE) }
    }
    return ()
  }
  /// The caller-atom occurrences collected so far; a semantic set takes one before its members.
  pub fn occurrenceMark(self: &Self) -> usize { return Vector.length<RegionOccurrence>(&self.occurrences) }
  /// A semantic set whose members carry caller atoms needs exact search rather than positional
  /// incidence. Members without caller atoms cannot reorder any atom's incidence, so a set such
  /// as a failure union of plain nominals stays positional. Lifetime meet membership alone
  /// remains one incidence site.
  pub fn unorderedSince(self: &mut Self, mark: usize) -> () {
    if collecting(&self.*) && Vector.length<RegionOccurrence>(&self.occurrences) > mark { self.hasUnordered = true }
    return ()
  }
  /// Observe one complete region site, or rewrite every atom through the already frozen map.
  /// A failed draft returns an unpublished handle solely to unwind the ordinary owning walk.
  pub effect fn region(self: &mut Self, region: &Shared<Lifetime>) -> Shared<Lifetime>
  ! OutOfMemoryError ? &mut Allocator {
    if inactive(&self.*) { return Shared.clone<Lifetime>(region) }
    if let Option<CanonicalizationFailure>.Some {..} = &self.fault { return Shared.clone<Lifetime>(region) }
    if surveying(&self.*) {
      let count = Lifetime.atomCount(region)
      let mut at = usize.ZERO
      while at < count {
        run Vector.append<Shared<Lifetime>>(&mut self.survey.atoms, Lifetime.atomAt(region, at))
        at = at + usize.ONE
      }
      run Vector.append<usize>(&mut self.survey.widths, count)
      return Shared.clone<Lifetime>(region)
    }
    let count = Lifetime.atomCount(region)
    if !Numbering.units(&mut self.*, count) { return Shared.clone<Lifetime>(region) }
    let site = self.sites
    if collecting(&self.*) {
      if self.remainingUnits == usize.ZERO { Numbering.reject(&mut self.*, CanonicalizationFailure.Resource)
        return Shared.clone<Lifetime>(region) }
      self.remainingUnits = self.remainingUnits - usize.ONE
      self.sites = self.sites + usize.ONE
    }
    let mut rewritten = Vector.make<Shared<Lifetime>>()
    let mut at = usize.ZERO
    while at < count {
      let atom = Lifetime.atomAt(region, at)
      let affordable = Shared.with<Lifetime, bool>(&atom, fn(held: &Lifetime) -> bool {
        return regionPayload(held, &mut self.*)
      })
      if !affordable { return Shared.clone<Lifetime>(region) }
      if Shared.with<Lifetime, bool>(&atom, callerRegion) {
        let knownRegions = Vector.length<Member>(&self.regions)
        if !Numbering.units(&mut self.*, knownRegions) { return Shared.clone<Lifetime>(region) }
        let mut position = memberPosition(Vector.asSlice<Member>(&self.regions), &atom)
        if collecting(&self.*) {
          if self.remainingUnits == usize.ZERO { Numbering.reject(&mut self.*, CanonicalizationFailure.Resource)
        return Shared.clone<Lifetime>(region) }
          self.remainingUnits = self.remainingUnits - usize.ONE
          if position == Vector.length<Member>(&self.regions) {
            run Vector.append<Member>(&mut self.regions, Member {region: Shared.clone<Lifetime>(&atom)})
            run Vector.append<usize>(&mut self.positions, position)
          }
          run Vector.append<RegionOccurrence>(&mut self.occurrences, RegionOccurrence {atom: position, site: site})
          run Vector.append<Shared<Lifetime>>(&mut rewritten, move atom)
        } else {
          if position == Vector.length<Member>(&self.regions) {
            Numbering.reject(&mut self.*, CanonicalizationFailure.UncollectedAtom)
            return Shared.clone<Lifetime>(region)
          }
          let slots = Vector.asSlice<usize>(&self.positions)
          run Vector.append<Shared<Lifetime>>(&mut rewritten, run Shared.make<Lifetime>(Lifetime.Supplied {ordinal: slots[position]}))
        }
      } else { run Vector.append<Shared<Lifetime>>(&mut rewritten, move atom) }
      at = at + usize.ONE
    }
    if collecting(&self.*) { return Shared.clone<Lifetime>(region) }
    // The map is injective and changes only non-static atoms. Original normalized membership
    // remains distinct, so pure renaming needs neither semantic substitution nor set inference.
    let listed = Vector.asSlice<Shared<Lifetime>>(&rewritten)
    if listed.length == usize.ONE { return Shared.clone<Lifetime>(&listed[usize.ZERO]) }
    let mut members = Vector.make<Member>()
    at = usize.ZERO
    while at < listed.length {
      run Vector.append<Member>(&mut members, Member {region: Shared.clone<Lifetime>(&listed[at])})
      at = at + usize.ONE
    }
    return run Shared.make<Lifetime>(Lifetime.Meet {members: run Shared.make<Intersection>(Intersection {members: move members})})
  }
  /// Renames one authenticated normalized environment as one complete unordered incidence site.
  /// This owning operation preserves cardinality without opening the sealed Meet constructor.
  pub effect fn environment(self: &mut Self, value: &Shared<Intersection>) -> Shared<Intersection>
  ! OutOfMemoryError ? &mut Allocator {
    if inactive(&self.*) { return Shared.clone<Intersection>(value) }
    let members = Shared.with<Intersection, usize>(value, fn(environment: &Intersection) -> usize { return Vector.length<Member>(&environment.members) })
    // Charge the normalized view/result wrappers and all outgoing member edges before allocation.
    if !Numbering.units(&mut self.*, 2) || !Numbering.units(&mut self.*, members) {
      return Shared.clone<Intersection>(value)
    }
    let complete = run normalizedEnvironmentRegion(value, members)
    // One complete unordered environment is one incidence site, not ordered per-member sites.
    let renamed = run Numbering.region(&mut self.*, &complete)
    if collecting(&self.*) { return Shared.clone<Intersection>(value) }
    if let Option<CanonicalizationFailure>.Some {..} = &self.fault { return Shared.clone<Intersection>(value) }
    if !Numbering.units(&mut self.*, members) { return Shared.clone<Intersection>(value) }
    let mut copied = Vector.make<Member>()
    let mut memberAt = usize.ZERO
    while memberAt < members {
      run Vector.append<Member>(&mut copied, Member {region: Lifetime.atomAt(&renamed, memberAt)})
      memberAt = memberAt + usize.ONE
    }
    // Injective renaming preserves original cardinality and non-Static distinctness. In particular,
    // the empty environment stays empty rather than copying the Static view as a constituent.
    return run Shared.make<Intersection>(Intersection {members: move copied})
  }
  /// Freeze either the proved ordered-incidence map or the initial exact-search permutation.
  /// Returns whether unordered structural correlations require exhaustive record search.
  pub effect fn freeze(self: &mut Self) -> Result<bool, CanonicalizationFailure>
  ! OutOfMemoryError ? &mut Allocator {
    if let Option<CanonicalizationFailure>.Some {value: reason} = &self.fault {
      return Result.failResult<bool, CanonicalizationFailure>(reason)
    }
    let count = Vector.length<Member>(&self.regions)
    self.phase = NumberingPhase.Frozen
    if !self.hasUnordered || count < 2 {
      let incidence = run collectIncidence(&mut self.*, count)
      if let Option<CanonicalizationFailure>.Some {value: reason} = &self.fault {
        return Result.failResult<bool, CanonicalizationFailure>(reason)
      }
      let mut order = Vector.make<usize>()
      let mut at = usize.ZERO
      while at < count {
        run Vector.append<usize>(&mut order, at)
        at = at + usize.ONE
      }
      at = usize.ONE
      while at < count {
        let mut position = at
        while position > usize.ZERO {
          let listed = Vector.asSlice<usize>(&order)
          let previousAtom = listed[position - usize.ONE]
          let current = listed[position]
          if !incidenceBefore(&mut self.*, &incidence, current, previousAtom) { break }
          let slots = Vector.asMutSlice<usize>(&mut order)
          let earlier = slots[position - usize.ONE]
          slots[position - usize.ONE] = slots[position]
          slots[position] = earlier
          position = position - usize.ONE
        }
        at = at + usize.ONE
      }
      if let Option<CanonicalizationFailure>.Some {value: reason} = &self.fault {
        return Result.failResult<bool, CanonicalizationFailure>(reason)
      }
      let ranked = Vector.asSlice<usize>(&order)
      let slots = Vector.asMutSlice<usize>(&mut self.positions)
      at = usize.ZERO
      while at < count {
        slots[ranked[at]] = at
        at = at + usize.ONE
      }
      return Result.succeed<bool, CanonicalizationFailure>(false)
    }
    return Result.succeed<bool, CanonicalizationFailure>(true)
  }
  /// Every attempted record candidate, successful or not, consumes one search state.
  pub fn attempt(self: &mut Self) -> bool {
    if self.remainingStates == usize.ZERO { Numbering.reject(&mut self.*, CanonicalizationFailure.Resource)
        return false }
    self.remainingStates = self.remainingStates - usize.ONE
    return true
  }
  /// Charges complete record creation/comparison bytes with checked remaining arithmetic.
  pub fn bytes(self: &mut Self, count: usize) -> bool {
    if inactive(&self.*) { return true }
    if let Option<CanonicalizationFailure>.Some {..} = &self.fault { return false }
    if count > self.bytesLeft { Numbering.reject(&mut self.*, CanonicalizationFailure.Resource)
        return false }
    self.bytesLeft = self.bytesLeft - count
    return true
  }
  /// The next injective assignment; no colors or hashes remove unproved candidates.
  pub fn next(self: &mut Self) -> bool {
    let slots = Vector.asMutSlice<usize>(&mut self.positions)
    if slots.length < 2 { return false }
    let mut pivot = slots.length - usize.ONE
    while pivot > usize.ZERO && slots[pivot - usize.ONE] >= slots[pivot] { pivot = pivot - usize.ONE }
    if pivot == usize.ZERO { return false }
    let mut greater = slots.length - usize.ONE
    while slots[greater] <= slots[pivot - usize.ONE] { greater = greater - usize.ONE }
    let saved = slots[pivot - usize.ONE]
    slots[pivot - usize.ONE] = slots[greater]
    slots[greater] = saved
    let mut first = pivot
    let mut last = slots.length - usize.ONE
    while first < last {
      let previous = slots[first]
      slots[first] = slots[last]
      slots[last] = previous
      first = first + usize.ONE
      last = last - usize.ONE
    }
    return true
  }
}

fn regionPayload(value: &Lifetime, numbering: &mut Numbering) -> bool {
  return match &value.* {
    Lifetime.Parameter {declaration, ..} => {
      if !Numbering.units(&mut numbering.*, DeclarationId.ownerCount(&declaration)) { return false }
      return Numbering.bytes(&mut numbering.*, RuntimeEncoding.declarationPayload(&declaration))
    }
    Lifetime.Local {declaration, ..} => {
      if !Numbering.units(&mut numbering.*, DeclarationId.ownerCount(&declaration)) { return false }
      return Numbering.bytes(&mut numbering.*, RuntimeEncoding.declarationPayload(&declaration))
    }
    _ => true
  }
}

// Ordered incidence is a proof-based fast path. Each atom's incidence is the ascending list of
// distinct sites it occurs at; sites only grow while collecting, so one pass in collection order
// keeps every list sorted. Comparing two lists decides the same order as scanning every site for
// presence: at the first differing entry the smaller site is where only that atom occurs, and an
// atom whose list continues past an equal prefix occurs at a site the other lacks.
struct Incidence {
  starts: Vector<usize>
  ends: Vector<usize>
  sites: Vector<usize>
}

// Every occurrence consumes a work unit while it is bucketed.
effect fn collectIncidence(value: &mut Numbering, count: usize) -> Incidence
! OutOfMemoryError ? &mut Allocator {
  let mut starts = Vector.make<usize>()
  let mut ends = Vector.make<usize>()
  let mut sites = Vector.make<usize>()
  let total = Vector.length<RegionOccurrence>(&value.occurrences)
  if !Numbering.units(&mut value.*, total) {
    return Incidence {starts: move starts, ends: move ends, sites: move sites}
  }
  let mut at = usize.ZERO
  while at < count {
    run Vector.append<usize>(&mut starts, usize.ZERO)
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < total {
    run Vector.append<usize>(&mut sites, usize.ZERO)
    at = at + usize.ONE
  }
  let listed = Vector.asSlice<RegionOccurrence>(&value.occurrences)
  let counts = Vector.asMutSlice<usize>(&mut starts)
  at = usize.ZERO
  while at < total {
    counts[listed[at].atom] = counts[listed[at].atom] + usize.ONE
    at = at + usize.ONE
  }
  let mut offset = usize.ZERO
  at = usize.ZERO
  while at < count {
    let atomCount = counts[at]
    counts[at] = offset
    offset = offset + atomCount
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < count {
    run Vector.append<usize>(&mut ends, Vector.asSlice<usize>(&starts)[at])
    at = at + usize.ONE
  }
  let first = Vector.asSlice<usize>(&starts)
  let filled = Vector.asMutSlice<usize>(&mut ends)
  let slots = Vector.asMutSlice<usize>(&mut sites)
  at = usize.ZERO
  while at < total {
    let atom = listed[at].atom
    let end = filled[atom]
    if end == first[atom] || slots[end - usize.ONE] != listed[at].site {
      slots[end] = listed[at].site
      filled[atom] = end + usize.ONE
    }
    at = at + usize.ONE
  }
  return Incidence {starts: move starts, ends: move ends, sites: move sites}
}

// Every inspected list entry consumes a work unit, including failed comparisons.
fn incidenceBefore(value: &mut Numbering, incidence: &Incidence, first: usize, second: usize) -> bool {
  let starts = Vector.asSlice<usize>(&incidence.starts)
  let ends = Vector.asSlice<usize>(&incidence.ends)
  let sites = Vector.asSlice<usize>(&incidence.sites)
  let mut left = starts[first]
  let mut right = starts[second]
  while true {
    if !Numbering.units(&mut value.*, usize.ONE) { return false }
    if left == ends[first] { return false }
    if right == ends[second] { return true }
    if sites[left] != sites[right] { return sites[left] < sites[right] }
    left = left + usize.ONE
    right = right + usize.ONE
  }
  return false
}
