//! Canonical validity relationships in resolved type and signature facts.
//!
//! # When to use
//! Use [`Lifetime`] to retain the owner of a written or elided lifetime in a type. A lifetime
//! identity records a contract; it does not establish a loan or prove that a borrow is valid. Use
//! [`Intersection`] for a retained environment such as `'call & 'env`. Use [`Numbering`] to
//! canonicalize the caller regions of one selected instance.

import semantic.DeclarationId {DeclarationId}
import semantic.RuntimeEncoding
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.hash {Hash}
import silk.mem.pointer {Pointer}
import silk.option {Option}
import silk.core.result {Result}
import silk.mem.shared {Shared}
import silk.num.u64
import silk.num.usize
import silk.collections.list {List}

/// A validity atom or the common validity of a canonical finite set of atoms.
pub union Lifetime {
  /// The distinguished program-valid lifetime.
  Static,
  /// A written or header-elided declaration-owned lifetime parameter.
  Parameter {
    /// The declaration that binds this lifetime.
    pub declaration: DeclarationId,
    /// The parameter's position in the declaration's complete binder list.
    pub ordinal: usize,
  },
  /// A borrow region rooted at a source expression in one declaration's checked body.
  /// The body's region check resolves this identity.
  Local {
    pub declaration: DeclarationId,
    /// The expression's node, counted from the declaration's anchor.
    pub ordinal: usize,
    /// The position of the inferred lifetime binder of the expression's call or literal that this
    /// region stands for, or `usize.MAX` for the expression's own region. Each binder of one
    /// inference site is its own region, so loans that fill distinct binders stay distinct.
    pub binder: usize,
  },
  /// A fresh region of each invocation, bound by the enclosing callable contract's quantifier.
  ///
  /// Quantified contracts do not nest, so the position identifies the binder; the spelling does
  /// not, and two contracts that differ only in binder names are equal.
  Invocation {
    /// The binder's position in the callable's written and elided invocation binders.
    pub ordinal: usize,
  },
  /// Common validity of two or more distinct non-static atoms. Construct with Lifetime.meet.
  Meet {members: Shared<Intersection>},
  /// A caller atom numbered injectively across the complete selected instance's input domain.
  /// Region sharing and meet incidence are retained; raw caller identities are absent.
  Supplied {
    /// The atom's injective canonical position in the instance's complete inputs.
    pub ordinal: usize,
  },
}

/// The common validity of a finite set of regions, as written for a retained environment.
///
/// # Details
///
/// Members are distinct and never `'static`; the empty intersection is `'static`. Order and
/// repetition do not affect identity. Members are atoms: factories flatten meet inputs before
/// publication, and comparisons clone members before releasing their parent's Shared loan.
pub struct Intersection {
  /// The distinct non-static constituent regions.
  pub members: List<Member>,
}

/// A closed-domain caller-atom renaming transaction. Collection never assigns an ordinal;
/// rewriting uses a frozen injective map. One transaction owns all work counters and draft state.
pub struct Numbering {
  phase: NumberingPhase,
  regions: List<Member>,
  positions: List<usize>,
  occurrences: List<RegionOccurrence>,
  sites: usize,
  hasUnordered: bool,
  // While searching, atoms in rank order, and the first rank of each group of atoms that ordered
  // incidence cannot tell apart; the search permutes atoms only within one group.
  order: List<usize>,
  groups: List<usize>,
  fault: Option<CanonicalizationFailure>,
  remainingUnits: usize,
  remainingStates: usize,
  bytesLeft: usize,
  active: List<StructuralVisit>,
}

/// A finite closed-domain identity could not be established. No key may be published.
pub enum CanonicalizationFailure { Resource, Cycle, UncollectedAtom }

/// Structural work units, attempted search states and record bytes for one complete domain.
pub const canonicalizationUnits: usize = 32768
pub const canonicalizationStates: usize = 65536
pub const canonicalizationBytes: usize = 8388608

enum NumberingPhase { Inactive, Collecting, Frozen }
// An occurrence inside a semantic set is unordered: its site follows the set's storage order.
struct RegionOccurrence {atom: usize, site: usize, ordered: bool}
struct StructuralVisit {address: usize, kind: usize}

/// One constituent region of an [`Intersection`].
// A struct element rather than `List<Shared<Lifetime>>`: bootstrap specialization otherwise reads
// this drop path beside `List<Shared<Type>>` inside `Type` as polymorphic recursion (SEM0053).
pub struct Member {
  /// The constituent region.
  pub region: Shared<Lifetime>,
}

fn addressOf(value: &Lifetime) -> usize {
  return Pointer.address<Lifetime>(Pointer.fromRef<Lifetime>(value))
}

fn sameValue(first: &Lifetime, second: &Lifetime) -> bool {
  return match & first.* {
    Lifetime.Static => match & second.* {
      Lifetime.Static => true
      _ => false
    }
    Lifetime.Parameter {declaration, ordinal} => match & second.* {
      Lifetime.Parameter {declaration: compared, ordinal: position} => DeclarationId.equals(
        &declaration,
        &compared,
      ) && ordinal == position
      _ => false
    }
    Lifetime.Local {declaration, ordinal, binder} => match & second.* {
      Lifetime.Local {declaration: compared, ordinal: position, binder: other} => DeclarationId.equals(
        &declaration,
        &compared,
      ) && ordinal == position && binder == other
      _ => false
    }
    Lifetime.Invocation {ordinal} => match & second.* {
      Lifetime.Invocation {ordinal: position} => ordinal == position
      _ => false
    }
    Lifetime.Meet {..} => false
    Lifetime.Supplied {ordinal} => match & second.* {
      Lifetime.Supplied {ordinal: position} => ordinal == position
      _ => false
    }
  }
}

fn valueWith(first: &Lifetime, right: &Shared<Lifetime>) -> bool {
  return Shared<Lifetime>.with<bool>(
    right,
    fn(second: &Lifetime) -> bool {
      return sameValue(first, second)
    },
  )
}

fn isStatic(value: &Lifetime) -> bool {
  return match & value.* {
    Lifetime.Static => true
    _ => false
  }
}

fn contains(members: &[Member], candidate: &Shared<Lifetime>) -> bool {
  return memberPosition(members, candidate) < members.length
}

// The position of `candidate` among `members`, or `members.length` when it is absent.
fn memberPosition(members: &[Member], candidate: &Shared<Lifetime>) -> usize {
  let mut at = usize.ZERO
  while at < members.length {
    if Lifetime.equalsShared(&members[at].region, candidate) {
      return at
    }
    at = at + usize.ONE
  }
  return members.length
}

// A borrow region of the caller's body, or a region the caller itself received as an instance.
fn callerRegion(value: &Lifetime) -> bool {
  return match & value.* {
    Lifetime.Local {..} => true
    Lifetime.Supplied {..} => true
    _ => false
  }
}

// The instance input a caller atom stands for. Only the region check tells the inferred binders of
// one call or literal apart; lifetimes never decide which code runs (IMPL-007), so an instance key
// numbers each body site once, like the site's own region.
effect fn siteRegion(atom: &Shared<Lifetime>) -> Shared<Lifetime> ! OutOfMemoryError ? &mut Allocator {
  let site = Shared<Lifetime>.with<Option<Lifetime>>(atom, fn(held: &Lifetime) -> Option<Lifetime> {
    if let Lifetime.Local {declaration, ordinal, binder} = &held.* {
      if binder != usize.MAX {
        return Option<Lifetime>.some(Lifetime.Local {declaration: DeclarationId.copy(&declaration), ordinal: ordinal, binder: usize.MAX})
      }
    }
    return Option<Lifetime>.none()
  })
  return match move site {
    Option<Lifetime>.Some {value} => run Shared<Lifetime>.make(move value)
    Option<Lifetime>.None => Shared<Lifetime>.clone(atom)
  }
}

fn containsPosition(positions: &[usize], position: usize) -> bool {
  let mut at = usize.ZERO
  while at < positions.length {
    if positions[at] == position { return true }
    at = at + usize.ONE
  }
  return false
}

impl Lifetime {
  /// Reports whether two lifetime handles name the same validity relationship.
  ///
  /// # Details
  ///
  /// Parameters compare owner and position and invocation binders compare position. The same
  /// handle on both sides is compared by address, never by entering it twice.
  pub fn equalsShared(left: &Shared<Lifetime>, right: &Shared<Lifetime>) -> bool {
    if Shared<Lifetime>.with<usize>(left, addressOf) == Shared<Lifetime>.with<usize>(
      right,
      addressOf,
    ) {
      return true
    }
    let count = Lifetime.atomCount(left)
    if count != Lifetime.atomCount(right) { return false }
    let mut at = usize.ZERO
    while at < count {
      let firstAtom = Lifetime.atomAt(left, at)
      let mut found = false
      let mut other = usize.ZERO
      while !found && other < count {
        let secondAtom = Lifetime.atomAt(right, other)
        if Shared<Lifetime>.with<usize>(&firstAtom, addressOf) == Shared<Lifetime>.with<usize>(&secondAtom, addressOf) {
          found = true
        } else {
          found = Shared<Lifetime>.with<bool>(&firstAtom, fn(first: &Lifetime) -> bool {
            return valueWith(first, &secondAtom)
          })
        }
        other = other + usize.ONE
      }
      if !found { return false }
      at = at + usize.ONE
    }
    return true
  }
}


impl Lifetime {
  /// A hash that two lifetimes share whenever [`equalsShared`] reports them equal: a meet combines
  /// its atoms without regard to order.
  pub fn hash(value: &Shared<Lifetime>) -> u64 {
    let count = Lifetime.atomCount(value)
    if count == usize.ONE { return Shared<Lifetime>.with<u64>(value, atomHash) }
    let mut folded: u64 = 0
    let mut at = usize.ZERO
    while at < count {
      let atom = Lifetime.atomAt(value, at)
      folded = u64.wrappingAdd(folded, Shared<Lifetime>.with<u64>(&atom, atomHash))
      at = at + usize.ONE
    }
    return Hash.combine(Hash.combine(7, usize.toU64(count)), folded)
  }
}

fn atomHash(value: &Lifetime) -> u64 {
  return match & value.* {
    Lifetime.Static => 1
    Lifetime.Parameter {declaration, ordinal} => Hash.combine(Hash.combine(2, DeclarationId.hash(&declaration)), usize.toU64(ordinal))
    Lifetime.Local {declaration, ordinal, binder} => Hash.combine(Hash.combine(Hash.combine(3, DeclarationId.hash(&declaration)),
      usize.toU64(ordinal)), usize.toU64(binder))
    Lifetime.Invocation {ordinal} => Hash.combine(4, usize.toU64(ordinal))
    Lifetime.Meet {..} => 5
    Lifetime.Supplied {ordinal} => Hash.combine(6, usize.toU64(ordinal))
  }
}

fn lifetimeMeet(value: &Lifetime) -> Option<Shared<Intersection>> {
  return match &value.* {
    Lifetime.Meet {members} => Option<Shared<Intersection>>.some(Shared<Intersection>.clone(&members))
    _ => Option<Shared<Intersection>>.none()
  }
}

impl Lifetime {
  /// Number of constituent atoms; a scalar has one. No lifetime parent loan survives this call.
  pub fn atomCount(value: &Shared<Lifetime>) -> usize {
    let payload = Shared<Lifetime>.with<Option<Shared<Intersection>>>(value, lifetimeMeet)
    if let Option<Shared<Intersection>>.Some {value: members} = move payload {
      return Shared<Intersection>.with<usize>(&members, fn(meet: &Intersection) -> usize {
        return List<Member>.length(&meet.members)
      })
    }
    return usize.ONE
  }
  /// A cloned constituent handle at an index below atomCount; scalar index zero is itself.
  pub fn atomAt(value: &Shared<Lifetime>, at: usize) -> Shared<Lifetime> {
    let payload = Shared<Lifetime>.with<Option<Shared<Intersection>>>(value, lifetimeMeet)
    if let Option<Shared<Intersection>>.Some {value: members} = move payload {
      return Shared<Intersection>.with<Shared<Lifetime>>(&members, fn(meet: &Intersection) -> Shared<Lifetime> {
        let listed = List<Member>.asSlice(&meet.members)
        return Shared<Lifetime>.clone(&listed[at].region)
      })
    }
    return Shared<Lifetime>.clone(value)
  }
  /// Whether any constituent satisfies an atom classifier, after releasing the parent loan.
  pub fn anyAtom<'env>(value: &Shared<Lifetime>, predicate: fn<'env>(&Lifetime) -> bool) -> bool {
    let count = Lifetime.atomCount(value)
    let mut at = usize.ZERO
    while at < count {
      let atom = Lifetime.atomAt(value, at)
      if Shared<Lifetime>.with<bool>(&atom, predicate) { return true }
      at = at + usize.ONE
    }
    return false
  }
  /// Whether every constituent satisfies an atom classifier. A meet is never hidden as Static.
  pub fn allAtoms<'env>(value: &Shared<Lifetime>, predicate: fn<'env>(&Lifetime) -> bool) -> bool {
    let count = Lifetime.atomCount(value)
    let mut at = usize.ZERO
    while at < count {
      let atom = Lifetime.atomAt(value, at)
      if !Shared<Lifetime>.with<bool>(&atom, predicate) { return false }
      at = at + usize.ONE
    }
    return true
  }
  /// Assumption-independent common validity: flatten, remove Static, deduplicate and collapse.
  pub effect fn meet(regions: &[Shared<Lifetime>]) -> Shared<Lifetime>
  ! OutOfMemoryError ? &mut Allocator {
    let normalized = run Intersection.of(regions)
    let members = List<Member>.asSlice(&normalized.members)
    if members.length == usize.ZERO { return run Shared<Lifetime>.make(Lifetime.Static) }
    if members.length == usize.ONE { return Shared<Lifetime>.clone(&members[usize.ZERO].region) }
    return run Shared<Lifetime>.make(Lifetime.Meet {members: run Shared<Intersection>.make(move normalized)})
  }
}

impl Intersection {
  /// Forms the canonical intersection of the given regions.
  ///
  /// # Details
  ///
  /// `'static` is the identity and repeated regions collapse, so `'a & 'static & 'a` is `'a`.
  pub effect fn of(regions: &[Shared<Lifetime>]) -> Intersection ! OutOfMemoryError ? &mut Allocator {
    let mut members = List<Member>.make()
    let mut at = usize.ZERO
    while at < regions.length {
      let mut atomAt = usize.ZERO
      let atoms = Lifetime.atomCount(&regions[at])
      while atomAt < atoms {
        let candidate = Lifetime.atomAt(&regions[at], atomAt)
        if !Shared<Lifetime>.with<bool>(&candidate, isStatic) && !contains(List<Member>.asSlice(&members), &candidate) {
          run List<Member>.append(&mut members, Member {region: move candidate})
        }
        atomAt = atomAt + usize.ONE
      }
      at = at + usize.ONE
    }
    return Intersection {members: move members}
  }
  /// Copies the member handles without copying the regions.
  pub effect fn copy(self: &Self) -> Intersection ! OutOfMemoryError ? &mut Allocator {
    let mut members = List<Member>.make()
    let source = List<Member>.asSlice(&self.members)
    let mut at = usize.ZERO
    while at < source.length {
      run List<Member>.append(
        &mut members,
        Member {region: Shared<Lifetime>.clone(&source[at].region)},
      )
      at = at + usize.ONE
    }
    return Intersection {members: move members}
  }
  /// Reports whether two intersections contain the same regions.
  pub fn equals(self: &Self, other: &Intersection) -> bool {
    let first = List<Member>.asSlice(&self.members)
    let second = List<Member>.asSlice(&other.members)
    if first.length != second.length {
      return false
    }
    let mut at = usize.ZERO
    while at < first.length {
      if !contains(second, &first[at].region) {
        return false
      }
      at = at + usize.ONE
    }
    return true
  }
}

fn collecting(value: &Numbering) -> bool { return match value.phase { NumberingPhase.Collecting => true _ => false } }
fn inactive(value: &Numbering) -> bool { return match value.phase { NumberingPhase.Inactive => true _ => false } }

// A view of an authenticated normalized environment: no flattening, equality or deduplication.
// Empty means Static; a singleton is its actual atom; a larger set retains the same intersection.
effect fn normalizedEnvironmentRegion(value: &Shared<Intersection>, count: usize) -> Shared<Lifetime>
! OutOfMemoryError ? &mut Allocator {
  if count == usize.ZERO { return run Shared<Lifetime>.make(Lifetime.Static) }
  if count == usize.ONE {
    return Shared<Intersection>.with<Shared<Lifetime>>(value, fn(environment: &Intersection) -> Shared<Lifetime> {
      let members = List<Member>.asSlice(&environment.members)
      return Shared<Lifetime>.clone(&members[usize.ZERO].region)
    })
  }
  return run Shared<Lifetime>.make(Lifetime.Meet {members: Shared<Intersection>.clone(value)})
}

fn activeCycle(value: &Numbering, address: usize, kind: usize) -> bool {
  let stack = List<StructuralVisit>.asSlice(&value.active)
  let mut at = usize.ZERO
  while at < stack.length {
    if stack[at].address == address && stack[at].kind == kind { return true }
    at = at + usize.ONE
  }
  return false
}

impl Numbering {
  /// No region renaming during ordinary simultaneous substitution.
  pub fn inactive() -> Numbering {
    return Numbering {phase: NumberingPhase.Inactive, regions: List<Member>.make(), positions: List<usize>.make(),
      occurrences: List<RegionOccurrence>.make(), sites: usize.ZERO, hasUnordered: false,
      order: List<usize>.make(), groups: List<usize>.make(), fault: Option<CanonicalizationFailure>.none(), remainingUnits: canonicalizationUnits,
      remainingStates: canonicalizationStates, bytesLeft: canonicalizationBytes, active: List<StructuralVisit>.make()}
  }
  /// A draft for all inputs of one closed domain; callers collect every root before freeze.
  pub fn collecting() -> Numbering {
    let mut value = Numbering.inactive()
    value.phase = NumberingPhase.Collecting
    return move value
  }
  pub fn isActive(self: &Self) -> bool { return !inactive(self) }
  pub fn isCollecting(self: &Self) -> bool { return collecting(self) }
  pub fn remainingBytes(self: &Self) -> usize { return self.bytesLeft }
  pub fn failure(self: &Self) -> Option<CanonicalizationFailure> {
    return match &self.fault {
      Option<CanonicalizationFailure>.Some {value: reason} => Option<CanonicalizationFailure>.some(reason)
      Option<CanonicalizationFailure>.None => Option<CanonicalizationFailure>.none()
    }
  }
  fn reject(self: &mut Self, reason: CanonicalizationFailure) -> () {
    let vacant = match &self.fault { Option<CanonicalizationFailure>.None => true _ => false }
    if vacant { self.fault = Option<CanonicalizationFailure>.some(reason) }
    return ()
  }
  /// Charges every attempted structural node and incoming edge, and refuses active-path cycles.
  /// Shared DAG nodes can be visited at several occurrence sites; allocation identity is not output.
  /// Charges a structural collection or candidate-rewrite node/edge before retaining it.
  pub fn units(self: &mut Self, count: usize) -> bool {
    if inactive(&self.*) { return true }
    if let Option<CanonicalizationFailure>.Some {..} = &self.fault { return false }
    if count > self.remainingUnits {
      Numbering.reject(&mut self.*, CanonicalizationFailure.Resource)
      return false
    }
    self.remainingUnits = self.remainingUnits - count
    return true
  }
  pub effect fn enter(self: &mut Self, address: usize, kind: usize) -> bool
  ! OutOfMemoryError ? &mut Allocator {
    if inactive(&self.*) { return true }
    if let Option<CanonicalizationFailure>.Some {..} = &self.fault { return false }
    if self.remainingUnits < 2 { Numbering.reject(&mut self.*, CanonicalizationFailure.Resource)
      return false }
    self.remainingUnits = self.remainingUnits - 2
    // Active-path checks are attempted structural edges too. Charging them before scanning also
    // bounds recursion depth without a timing limit or an unchecked recursive collector.
    let activeCount = List<StructuralVisit>.length(&self.active)
    if !Numbering.units(&mut self.*, activeCount) { return false }
    let cycle = activeCycle(&self.*, address, kind)
    if cycle {
      Numbering.reject(&mut self.*, CanonicalizationFailure.Cycle)
      return false
    }
    run List<StructuralVisit>.append(&mut self.active, StructuralVisit {address: address, kind: kind})
    return true
  }
  pub fn leave(self: &mut Self) -> () {
    if !inactive(&self.*) {
      let count = List<StructuralVisit>.length(&self.active)
      if count != usize.ZERO { List<StructuralVisit>.truncate(&mut self.active, count - usize.ONE) }
    }
    return ()
  }
  /// The caller-atom occurrences collected so far; a semantic set takes one before its members.
  pub fn occurrenceMark(self: &Self) -> usize { return List<RegionOccurrence>.length(&self.occurrences) }
  /// A semantic set whose members carry caller atoms needs exact search rather than positional
  /// incidence. Members without caller atoms cannot reorder any atom's incidence, so a set such
  /// as a failure union of plain nominals stays positional. Lifetime meet membership alone
  /// remains one incidence site.
  pub fn unorderedSince(self: &mut Self, mark: usize) -> () {
    let total = List<RegionOccurrence>.length(&self.occurrences)
    if !collecting(&self.*) || total <= mark { return () }
    self.hasUnordered = true
    // Each nested set marks its own occurrences again; the work stays bounded by the budget.
    if !Numbering.units(&mut self.*, total - mark) { return () }
    let listed = List<RegionOccurrence>.asMutSlice(&mut self.occurrences)
    let mut at = mark
    while at < total {
      listed[at].ordered = false
      at = at + usize.ONE
    }
    return ()
  }
  /// Observe one complete region site, or rewrite every atom through the already frozen map.
  /// A failed draft returns an unpublished handle solely to unwind the ordinary owning walk.
  pub effect fn region(self: &mut Self, region: &Shared<Lifetime>) -> Shared<Lifetime>
  ! OutOfMemoryError ? &mut Allocator {
    if inactive(&self.*) { return Shared<Lifetime>.clone(region) }
    if let Option<CanonicalizationFailure>.Some {..} = &self.fault { return Shared<Lifetime>.clone(region) }
    let count = Lifetime.atomCount(region)
    if !Numbering.units(&mut self.*, count) { return Shared<Lifetime>.clone(region) }
    let site = self.sites
    if collecting(&self.*) {
      if self.remainingUnits == usize.ZERO { Numbering.reject(&mut self.*, CanonicalizationFailure.Resource)
        return Shared<Lifetime>.clone(region) }
      self.remainingUnits = self.remainingUnits - usize.ONE
      self.sites = self.sites + usize.ONE
    }
    let mut rewritten = List<Shared<Lifetime>>.make()
    // The caller atoms this site already named: a site's inferred binders are one atom here.
    let mut named = List<usize>.make()
    let mut at = usize.ZERO
    while at < count {
      let atom = Lifetime.atomAt(region, at)
      let affordable = Shared<Lifetime>.with<bool>(&atom, fn(held: &Lifetime) -> bool {
        return regionPayload(held, &mut self.*)
      })
      if !affordable { return Shared<Lifetime>.clone(region) }
      if Shared<Lifetime>.with<bool>(&atom, callerRegion) {
        let knownRegions = List<Member>.length(&self.regions)
        if !Numbering.units(&mut self.*, knownRegions) { return Shared<Lifetime>.clone(region) }
        let caller = run siteRegion(&atom)
        let mut position = memberPosition(List<Member>.asSlice(&self.regions), &caller)
        let repeated = containsPosition(List<usize>.asSlice(&named), position)
        if collecting(&self.*) {
          if self.remainingUnits == usize.ZERO { Numbering.reject(&mut self.*, CanonicalizationFailure.Resource)
        return Shared<Lifetime>.clone(region) }
          self.remainingUnits = self.remainingUnits - usize.ONE
          if position == List<Member>.length(&self.regions) {
            run List<Member>.append(&mut self.regions, Member {region: move caller})
            run List<usize>.append(&mut self.positions, position)
          }
          if !repeated {
            run List<RegionOccurrence>.append(&mut self.occurrences, RegionOccurrence {atom: position, site: site, ordered: true})
            run List<usize>.append(&mut named, position)
          }
        } else {
          if position == List<Member>.length(&self.regions) {
            Numbering.reject(&mut self.*, CanonicalizationFailure.UncollectedAtom)
            return Shared<Lifetime>.clone(region)
          }
          if !repeated {
            let slots = List<usize>.asSlice(&self.positions)
            run List<Shared<Lifetime>>.append(&mut rewritten, run Shared<Lifetime>.make(Lifetime.Supplied {ordinal: slots[position]}))
            run List<usize>.append(&mut named, position)
          }
        }
      } else { run List<Shared<Lifetime>>.append(&mut rewritten, move atom) }
      at = at + usize.ONE
    }
    if collecting(&self.*) { return Shared<Lifetime>.clone(region) }
    // The map is injective on sites and changes only non-static atoms, so the renamed members stay
    // distinct and pure renaming needs neither semantic substitution nor set inference.
    let listed = List<Shared<Lifetime>>.asSlice(&rewritten)
    if listed.length == usize.ONE { return Shared<Lifetime>.clone(&listed[usize.ZERO]) }
    let mut members = List<Member>.make()
    at = usize.ZERO
    while at < listed.length {
      run List<Member>.append(&mut members, Member {region: Shared<Lifetime>.clone(&listed[at])})
      at = at + usize.ONE
    }
    return run Shared<Lifetime>.make(Lifetime.Meet {members: run Shared<Intersection>.make(Intersection {members: move members})})
  }
  /// Renames one authenticated normalized environment as one complete unordered incidence site.
  /// This owning operation keeps one member per renamed atom without opening the sealed Meet
  /// constructor.
  pub effect fn environment(self: &mut Self, value: &Shared<Intersection>) -> Shared<Intersection>
  ! OutOfMemoryError ? &mut Allocator {
    if inactive(&self.*) { return Shared<Intersection>.clone(value) }
    let members = Shared<Intersection>.with<usize>(value, fn(environment: &Intersection) -> usize { return List<Member>.length(&environment.members) })
    // Charge the normalized view/result wrappers and all outgoing member edges before allocation.
    if !Numbering.units(&mut self.*, 2) || !Numbering.units(&mut self.*, members) {
      return Shared<Intersection>.clone(value)
    }
    let complete = run normalizedEnvironmentRegion(value, members)
    // One complete unordered environment is one incidence site, not ordered per-member sites.
    let renamed = run Numbering.region(&mut self.*, &complete)
    if collecting(&self.*) { return Shared<Intersection>.clone(value) }
    if let Option<CanonicalizationFailure>.Some {..} = &self.fault { return Shared<Intersection>.clone(value) }
    if !Numbering.units(&mut self.*, members) { return Shared<Intersection>.clone(value) }
    // Renaming keeps non-Static distinctness; members of one site share an atom. The empty
    // environment stays empty rather than copying the Static view as a constituent.
    let mut renamedMembers = usize.ZERO
    if members != usize.ZERO { renamedMembers = Lifetime.atomCount(&renamed) }
    let mut copied = List<Member>.make()
    let mut memberAt = usize.ZERO
    while memberAt < renamedMembers {
      run List<Member>.append(&mut copied, Member {region: Lifetime.atomAt(&renamed, memberAt)})
      memberAt = memberAt + usize.ONE
    }
    return run Shared<Intersection>.make(Intersection {members: move copied})
  }
  /// Freeze the ordered-incidence map and, when semantic sets hold caller atoms, the first
  /// exact-search permutation. Returns whether unordered structural correlations require search.
  ///
  /// # Details
  ///
  /// Atoms are ranked by their incidence at ordered sites, which no set's storage order can move.
  /// Atoms whose ordered incidence is equal form one group, and the exact search permutes atoms
  /// only within groups: every candidate set it then compares is still invariant under renaming,
  /// so the least record remains an exact, alpha-invariant key at a fraction of all permutations.
  pub effect fn freeze(self: &mut Self) -> Result<bool, CanonicalizationFailure>
  ! OutOfMemoryError ? &mut Allocator {
    if let Option<CanonicalizationFailure>.Some {value: reason} = &self.fault {
      return Result<bool, CanonicalizationFailure>.failResult(reason)
    }
    let count = List<Member>.length(&self.regions)
    self.phase = NumberingPhase.Frozen
    let incidence = run collectIncidence(&mut self.*, count)
    if let Option<CanonicalizationFailure>.Some {value: reason} = &self.fault {
      return Result<bool, CanonicalizationFailure>.failResult(reason)
    }
    let mut order = List<usize>.make()
    let mut at = usize.ZERO
    while at < count {
      run List<usize>.append(&mut order, at)
      at = at + usize.ONE
    }
    at = usize.ONE
    while at < count {
      let mut position = at
      while position > usize.ZERO {
        let listed = List<usize>.asSlice(&order)
        let previousAtom = listed[position - usize.ONE]
        let current = listed[position]
        if !incidenceBefore(&mut self.*, &incidence, current, previousAtom) { break }
        let slots = List<usize>.asMutSlice(&mut order)
        let earlier = slots[position - usize.ONE]
        slots[position - usize.ONE] = slots[position]
        slots[position] = earlier
        position = position - usize.ONE
      }
      at = at + usize.ONE
    }
    if let Option<CanonicalizationFailure>.Some {value: reason} = &self.fault {
      return Result<bool, CanonicalizationFailure>.failResult(reason)
    }
    // Without sets of caller atoms, equal incidence means the atoms share every site, so any
    // order among them yields the same record.
    let mut search = false
    let mut groups = List<usize>.make()
    if self.hasUnordered && count > usize.ONE {
      run List<usize>.append(&mut groups, usize.ZERO)
      at = usize.ONE
      while at < count {
        let ranked = List<usize>.asSlice(&order)
        let tied = !incidenceBefore(&mut self.*, &incidence, ranked[at - usize.ONE], ranked[at])
        if tied { search = true } else { run List<usize>.append(&mut groups, at) }
        at = at + usize.ONE
      }
      if let Option<CanonicalizationFailure>.Some {value: reason} = &self.fault {
        return Result<bool, CanonicalizationFailure>.failResult(reason)
      }
      // Each group starts in ascending atom order, the first permutation the search visits.
      let mut group = usize.ZERO
      while group < List<usize>.length(&groups) {
        let first = List<usize>.asSlice(&groups)[group]
        let mut last = count
        if group + usize.ONE < List<usize>.length(&groups) { last = List<usize>.asSlice(&groups)[group + usize.ONE] }
        sortSegment(List<usize>.asMutSlice(&mut order), first, last)
        group = group + usize.ONE
      }
    }
    let ranked = List<usize>.asSlice(&order)
    let slots = List<usize>.asMutSlice(&mut self.positions)
    at = usize.ZERO
    while at < count {
      slots[ranked[at]] = at
      at = at + usize.ONE
    }
    self.order = move order
    self.groups = move groups
    return Result<bool, CanonicalizationFailure>.succeed(search)
  }
  /// Every attempted record candidate, successful or not, consumes one search state.
  pub fn attempt(self: &mut Self) -> bool {
    if self.remainingStates == usize.ZERO { Numbering.reject(&mut self.*, CanonicalizationFailure.Resource)
        return false }
    self.remainingStates = self.remainingStates - usize.ONE
    return true
  }
  /// Charges complete record creation/comparison bytes with checked remaining arithmetic.
  pub fn bytes(self: &mut Self, count: usize) -> bool {
    if inactive(&self.*) { return true }
    if let Option<CanonicalizationFailure>.Some {..} = &self.fault { return false }
    if count > self.bytesLeft { Numbering.reject(&mut self.*, CanonicalizationFailure.Resource)
        return false }
    self.bytesLeft = self.bytesLeft - count
    return true
  }
  /// The next injective assignment, permuting atoms only within their incidence groups; no colors
  /// or hashes remove unproved candidates.
  pub fn next(self: &mut Self) -> bool {
    let count = List<usize>.length(&self.order)
    let mut group = List<usize>.length(&self.groups)
    let mut advanced = false
    while !advanced && group > usize.ZERO {
      group = group - usize.ONE
      let first = List<usize>.asSlice(&self.groups)[group]
      let mut last = count
      if group + usize.ONE < List<usize>.length(&self.groups) { last = List<usize>.asSlice(&self.groups)[group + usize.ONE] }
      // A group past its last permutation returns to ascending order and carries to the previous one.
      advanced = nextSegment(List<usize>.asMutSlice(&mut self.order), first, last)
    }
    if !advanced { return false }
    let ranked = List<usize>.asSlice(&self.order)
    let slots = List<usize>.asMutSlice(&mut self.positions)
    let mut at = usize.ZERO
    while at < count {
      slots[ranked[at]] = at
      at = at + usize.ONE
    }
    return true
  }
}

fn regionPayload(value: &Lifetime, numbering: &mut Numbering) -> bool {
  return match &value.* {
    Lifetime.Parameter {declaration, ..} => {
      if !Numbering.units(&mut numbering.*, DeclarationId.ownerCount(&declaration)) { return false }
      return Numbering.bytes(&mut numbering.*, RuntimeEncoding.declarationPayload(&declaration))
    }
    Lifetime.Local {declaration, ..} => {
      if !Numbering.units(&mut numbering.*, DeclarationId.ownerCount(&declaration)) { return false }
      return Numbering.bytes(&mut numbering.*, RuntimeEncoding.declarationPayload(&declaration))
    }
    _ => true
  }
}

// Sorts `values[first..last]` ascending.
fn sortSegment(values: &mut [usize], first: usize, last: usize) -> () {
  let mut at = first + usize.ONE
  while at < last {
    let mut position = at
    while position > first && values[position - usize.ONE] > values[position] {
      let earlier = values[position - usize.ONE]
      values[position - usize.ONE] = values[position]
      values[position] = earlier
      position = position - usize.ONE
    }
    at = at + usize.ONE
  }
  return ()
}

// Advances `values[first..last]` to its next lexicographic permutation. After the last one it
// restores ascending order and returns false.
fn nextSegment(values: &mut [usize], first: usize, last: usize) -> bool {
  if last - first < 2 { return false }
  let mut pivot = last - usize.ONE
  while pivot > first && values[pivot - usize.ONE] >= values[pivot] { pivot = pivot - usize.ONE }
  if pivot > first {
    let mut greater = last - usize.ONE
    while values[greater] <= values[pivot - usize.ONE] { greater = greater - usize.ONE }
    let saved = values[pivot - usize.ONE]
    values[pivot - usize.ONE] = values[greater]
    values[greater] = saved
  }
  let mut low = pivot
  let mut high = last - usize.ONE
  while low < high {
    let previous = values[low]
    values[low] = values[high]
    values[high] = previous
    low = low + usize.ONE
    high = high - usize.ONE
  }
  return pivot > first
}

// Ordered incidence is a proof-based fast path. Each atom's incidence is the ascending list of
// distinct ordered sites it occurs at; sites only grow while collecting, so one pass in collection order
// keeps every list sorted. Comparing two lists decides the same order as scanning every site for
// presence: at the first differing entry the smaller site is where only that atom occurs, and an
// atom whose list continues past an equal prefix occurs at a site the other lacks.
struct Incidence {
  starts: List<usize>,
  ends: List<usize>,
  sites: List<usize>,
}

// Every occurrence consumes a work unit while it is bucketed.
effect fn collectIncidence(value: &mut Numbering, count: usize) -> Incidence
! OutOfMemoryError ? &mut Allocator {
  let mut starts = List<usize>.make()
  let mut ends = List<usize>.make()
  let mut sites = List<usize>.make()
  let total = List<RegionOccurrence>.length(&value.occurrences)
  if !Numbering.units(&mut value.*, total) {
    return Incidence {starts: move starts, ends: move ends, sites: move sites}
  }
  let mut at = usize.ZERO
  while at < count {
    run List<usize>.append(&mut starts, usize.ZERO)
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < total {
    run List<usize>.append(&mut sites, usize.ZERO)
    at = at + usize.ONE
  }
  let listed = List<RegionOccurrence>.asSlice(&value.occurrences)
  let counts = List<usize>.asMutSlice(&mut starts)
  at = usize.ZERO
  while at < total {
    if listed[at].ordered { counts[listed[at].atom] = counts[listed[at].atom] + usize.ONE }
    at = at + usize.ONE
  }
  let mut offset = usize.ZERO
  at = usize.ZERO
  while at < count {
    let atomCount = counts[at]
    counts[at] = offset
    offset = offset + atomCount
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < count {
    run List<usize>.append(&mut ends, List<usize>.asSlice(&starts)[at])
    at = at + usize.ONE
  }
  let first = List<usize>.asSlice(&starts)
  let filled = List<usize>.asMutSlice(&mut ends)
  let slots = List<usize>.asMutSlice(&mut sites)
  at = usize.ZERO
  while at < total {
    let atom = listed[at].atom
    let end = filled[atom]
    if listed[at].ordered && (end == first[atom] || slots[end - usize.ONE] != listed[at].site) {
      slots[end] = listed[at].site
      filled[atom] = end + usize.ONE
    }
    at = at + usize.ONE
  }
  return Incidence {starts: move starts, ends: move ends, sites: move sites}
}

// Every inspected list entry consumes a work unit, including failed comparisons.
fn incidenceBefore(value: &mut Numbering, incidence: &Incidence, first: usize, second: usize) -> bool {
  let starts = List<usize>.asSlice(&incidence.starts)
  let ends = List<usize>.asSlice(&incidence.ends)
  let sites = List<usize>.asSlice(&incidence.sites)
  let mut left = starts[first]
  let mut right = starts[second]
  while true {
    if !Numbering.units(&mut value.*, usize.ONE) { return false }
    if left == ends[first] { return false }
    if right == ends[second] { return true }
    if sites[left] != sites[right] { return sites[left] < sites[right] }
    left = left + usize.ONE
    right = right + usize.ONE
  }
  return false
}
