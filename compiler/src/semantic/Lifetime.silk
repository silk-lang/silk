//! Canonical validity relationships in resolved type and signature facts.
//!
//! # When to use
//! Use [`Lifetime`] to retain the owner of a written or elided lifetime in a type. A lifetime
//! identity records a contract; it does not establish a loan or prove that a borrow is valid.

import semantic.DeclarationId {DeclarationId}
import silk.usize

/// A static lifetime or one lifetime parameter owned by a declaration.
pub union Lifetime {
  /// The distinguished program-valid lifetime.
  Static,
  /// A written or header-elided declaration-owned lifetime parameter.
  Parameter {
    /// The declaration that binds this lifetime.
    pub declaration: DeclarationId,
    /// The parameter's position in the declaration's complete binder list.
    pub ordinal: usize,
  },
}

impl Lifetime {
  /// Reports whether two lifetimes name the same validity relationship.
  pub fn equals(self: &Self, other: &Lifetime) -> bool {
    return match & self.* {
      Lifetime.Static => match & other.* {
        Lifetime.Static => true
        _ => false
      }
      Lifetime.Parameter {declaration, ordinal} => match & other.* {
        Lifetime.Parameter {declaration: compared, ordinal: position} => DeclarationId.equals(
          &declaration,
          &compared,
        ) && ordinal == position
        _ => false
      }
    }
  }
}
