//! Exact representation binders for source-written callable parameter contracts.

import semantic.DeclarationId {DeclarationId}
import semantic.Type {Argument, Type}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.option {Option}
import silk.shared {Shared}
import silk.usize
import silk.vector {Vector}

/// A parameter's rewritten type and the representation slots it introduces, outermost first.
pub struct CallableParameter {
  pub ty: Shared<Type>
  pub slots: Vector<RepresentationSlot>
}

/// One declaration-owned representation and the contract its exact value must satisfy.
pub struct RepresentationSlot {
  pub representation: Shared<Type>
  pub contract: Shared<Type>
}

/// Gives a callable parameter its declaration-owned representation slots, starting at `ordinal`.
/// References retain their access and lifetime; only the referent's representation becomes a
/// specialization input. An Effect contract nested as an Effect's success is itself a use
/// contract, so it receives the next slot and the outer contract names that slot (REP-002).
pub effect fn reify(value: &Shared<Type>, owner: &DeclarationId, ordinal: usize) -> Option<
  CallableParameter,
> ! OutOfMemoryError ? &mut Allocator {
  // A callable or Effect use contract is specialized to its exact representation (Effect note D1).
  if Shared.with<Type, bool>(value, useContract) {
    let representation = run Shared.make<Type>(
      Type.Parameter {declaration: run DeclarationId.copy(owner), ordinal: ordinal},
    )
    let mut slots = Vector.make<RepresentationSlot>()
    run Vector.append<RepresentationSlot>(&mut slots, RepresentationSlot {
      representation: Shared.clone<Type>(&representation), contract: Shared.clone<Type>(value)})
    run nestSuccess(&mut slots, owner, ordinal + usize.ONE)
    return Option.some<CallableParameter>(CallableParameter {ty: move representation, slots: move slots})
  }
  let node = run Type.copy(value)
  match move node {
    Type.Reference {referent, access, lifetime} => {
      let reified = run reify(&referent, owner, ordinal)
      if let Option<CallableParameter>.Some {value: nested} = move reified {
        return Option.some<CallableParameter>(
          CallableParameter {
            ty: run Shared.make<Type>(
              Type.Reference {referent: move nested.ty, access: access, lifetime: move lifetime},
            ),
            slots: move nested.slots,
          },
        )
      }
    }
    _ => ()
  }
  return Option.none<CallableParameter>()
}

/// Gives each callable or Effect use contract written as a nominal argument of `value` a
/// declaration-owned representation slot, numbered from `first` after the slots already listed.
/// Equal written contracts share one slot, so a conformance head that writes one contract for its
/// interface and its provider names one exact representation in both (REP-001).
pub effect fn reifyArguments(value: &Shared<Type>, owner: &DeclarationId, first: usize,
  slots: &mut Vector<RepresentationSlot>) -> Shared<Type> ! OutOfMemoryError ? &mut Allocator {
  let written = run Type.copy(value)
  if let Type.Nominal {declaration, isPublic, arguments} = move written {
    let given = Vector.asSlice<Argument>(&arguments)
    let mut reified = Vector.make<Argument>()
    let mut at = usize.ZERO
    while at < given.length {
      let mut argument = Argument.copy(&given[at])
      if let Argument.Type {value: offered} = &given[at] {
        if Shared.with<Type, bool>(&offered, useContract) {
          argument = Argument.Type {value: run slotFor(&offered, owner, first, &mut slots.*)}
        } else {
          argument = Argument.Type {value: run reifyArguments(&offered, owner, first, &mut slots.*)}
        }
      }
      run Vector.append<Argument>(&mut reified, move argument)
      at = at + usize.ONE
    }
    return run Shared.make<Type>(Type.Nominal {declaration: move declaration, isPublic: isPublic, arguments: move reified})
  }
  return Shared.clone<Type>(value)
}

/// The listed representation whose contract is exactly `contract`, if one was given.
pub effect fn representationOf(slots: &[RepresentationSlot], contract: &Shared<Type>) -> Option<Shared<Type>>
! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < slots.length {
    if run Type.equalsShared(&slots[at].contract, contract) {
      return Option.some<Shared<Type>>(Shared.clone<Type>(&slots[at].representation))
    }
    at = at + usize.ONE
  }
  return Option.none<Shared<Type>>()
}

effect fn slotFor(contract: &Shared<Type>, owner: &DeclarationId, first: usize, slots: &mut Vector<RepresentationSlot>)
-> Shared<Type> ! OutOfMemoryError ? &mut Allocator {
  let listed = run representationOf(Vector.asSlice<RepresentationSlot>(&slots.*), contract)
  if let Option<Shared<Type>>.Some {value} = move listed { return move value }
  let representation = run Shared.make<Type>(Type.Parameter {declaration: run DeclarationId.copy(owner),
    ordinal: first + Vector.length<RepresentationSlot>(&slots.*)})
  run Vector.append<RepresentationSlot>(&mut slots.*, RepresentationSlot {representation: Shared.clone<Type>(&representation),
    contract: Shared.clone<Type>(contract)})
  return move representation
}

// Replaces the last slot's nested Effect success contract with the slot at `ordinal`, and so on
// for the new slot's own contract.
effect fn nestSuccess(slots: &mut Vector<RepresentationSlot>, owner: &DeclarationId, ordinal: usize) -> ()
! OutOfMemoryError ? &mut Allocator {
  let last = Vector.length<RepresentationSlot>(&slots.*) - usize.ONE
  let listed = Vector.asSlice<RepresentationSlot>(&slots.*)
  let contract = Shared.clone<Type>(&listed[last].contract)
  let current = Shared.clone<Type>(&listed[last].representation)
  let copied = run Type.copy(&contract)
  match move copied {
    Type.Effect {mode, environment, success, failure, requirements} => {
      if !Shared.with<Type, bool>(&success, bareEffect) { return () }
      let representation = run Shared.make<Type>(
        Type.Parameter {declaration: run DeclarationId.copy(owner), ordinal: ordinal},
      )
      let outer = run Shared.make<Type>(Type.Effect {mode: mode, environment: move environment,
        success: Shared.clone<Type>(&representation), failure: move failure, requirements: move requirements})
      Vector.set<RepresentationSlot>(&mut slots.*, last, RepresentationSlot {representation: move current, contract: move outer})
      run Vector.append<RepresentationSlot>(&mut slots.*, RepresentationSlot {representation: move representation,
        contract: move success})
      run nestSuccess(&mut slots.*, owner, ordinal + usize.ONE)
    }
    _ => ()
  }
  return ()
}

fn useContract(value: &Type) -> bool {
  return match &value.* { Type.Callable {..} => true Type.Effect {..} => true _ => false }
}

fn bareEffect(value: &Type) -> bool {
  return match &value.* { Type.Effect {..} => true _ => false }
}
