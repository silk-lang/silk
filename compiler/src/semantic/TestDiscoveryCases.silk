//! Test discovery: the catalog of one root's import closure, its descriptors and TEST-001 refusals.
import semantic.Types {TypeTable, Types}
import semantic.Query { Cycle }
import semantic.ModuleId { InvalidModulePath, ModuleId }
import semantic.Rejection { Rejection, RejectionCode }
import semantic.Semantic { Answer, Request, Semantic, TestCatalog, TestEntry }
import semantic.SemanticCaseSupport {
  makeSemantic,
  module,
  offsetOf,
  present,
  rejectionAt,
  sameBytes,
  selectedApplicationOf,
  succeeded
}
import semantic.SourceIndex { NoRejection, RevisionMismatch, SourceIndex }
import semantic.SourceRevision { Revision }
import silk.allocator { Allocator, OutOfMemoryError }
import silk.bytes { Bytes }
import silk.effect { Effect }
import silk.result { Result }
import silk.shared { Shared }
import silk.string { String }
import silk.testing { AssertionError, Testing }
import silk.usize
import silk.vector { Vector }

fn sameCatalogResult(left: &Result<Shared<TestCatalog>, Shared<Rejection>>,
  right: &Result<Shared<TestCatalog>, Shared<Rejection>>) -> bool {
  if let Result<Shared<TestCatalog>, Shared<Rejection>>.Success {value: first} = &left.* {
    if let Result<Shared<TestCatalog>, Shared<Rejection>>.Success {value: second} = &right.* {
      let digest = Shared<TestCatalog>.with<[u8; 32]>(&first, fn(value: &TestCatalog) -> [u8; 32] { return value.digest })
      return Shared<TestCatalog>.with<bool>(&second, fn(value: &TestCatalog) -> bool {
        let mut at = usize.ZERO
        while at < 32 {
          if digest[at] != value.digest[at] { return false }
          at = at + usize.ONE
        }
        return true
      })
    }
  }
  if let Result<Shared<TestCatalog>, Shared<Rejection>>.Failure {error: first} = &left.* {
    if let Result<Shared<TestCatalog>, Shared<Rejection>>.Failure {error: second} = &right.* {
      return Shared<Rejection>.with<bool>(&first, fn(value: &Rejection) -> bool {
        return Shared<Rejection>.with<bool>(&second, fn(other: &Rejection) -> bool {
          return value.code == other.code && value.span.start == other.span.start
            && value.span.end == other.span.end && ModuleId.equals(&value.module, &other.module)
        })
      })
    }
  }
  return false
}

effect fn catalogRevisionClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let root = run module("root.silk")
  let mut revision = run Revision.publish(&Revision.make(), &root,
    &run present("struct Holder {}\nfn candidate() {}\ntest fn kept() {}\n"))
  let mut warm = makeSemantic(run Revision.copy(&revision))
  Semantic.selectDiscovery(&mut warm, ModuleId.copy(&root), Bytes.make())
  let mut request = Request.make()
  let initial = run Semantic.demandTests(&mut warm, &mut request)
  run Testing.expect(match &initial {
    Result<Shared<TestCatalog>, Shared<Rejection>>.Success {value} => Shared<TestCatalog>.with<bool>(
      &value, fn(catalog: &TestCatalog) -> bool { return Vector<TestEntry>.length(&catalog.entries) == usize.ONE })
    _ => false
  }, "catalog fixture begins with one test")
  let variants = [
    "struct Holder {}\ntest fn candidate() {}\ntest fn kept() {}\n",
    "struct Holder {}\ntest fn candidate() { let changed = 123; drop changed }\ntest fn kept() {}\n",
    "// moved\nstruct Holder {}\nfn candidate() {}\ntest fn kept() {}\n",
    "struct Holder {}\ntest fn Holder() {}\nfn candidate() {}\ntest fn kept() {}\n",
    "struct Holder {}\nfn candidate() {}\ntest fn kept() {}\nimpl Holder { test fn hidden() {} }\n",
  ]
  let mut at = usize.ZERO
  while at < 5 {
    revision = run Revision.publish(&revision, &root, &run present(variants[at]))
    run Semantic.update(&mut warm, run Revision.copy(&revision))
    let actual = run Semantic.demandTests(&mut warm, &mut request)
    let mut fresh = makeSemantic(run Revision.copy(&revision))
    Semantic.selectDiscovery(&mut fresh, ModuleId.copy(&root), Bytes.make())
    let mut freshRequest = Request.make()
    let expected = run Semantic.demandTests(&mut fresh, &mut freshRequest)
    run Testing.expect(sameCatalogResult(&actual, &expected),
      "warm catalog digest or exact refusal equals fresh across header/body/trivia/unnamed-impl edits")
    if at == 4 {
      run Testing.expect(rejectedAt(&actual, RejectionCode.InvalidTestDeclaration,
        offsetOf(variants[at], "test fn hidden", usize.ZERO)),
        "a newly added unnamed impl contributes its invalid associated test")
    } else if at < 3 {
      run Testing.expect(match &actual {
        Result<Shared<TestCatalog>, Shared<Rejection>>.Success {value} => Shared<TestCatalog>.with<bool>(
          &value, fn(catalog: &TestCatalog) -> bool {
            let mut count: usize = 2
            if at == 2 { count = usize.ONE }
            return Vector<TestEntry>.length(&catalog.entries) == count
          })
        _ => false
      }, "test qualifier changes update catalog membership without changing written names")
    }
    at = at + usize.ONE
  }
  return ()
}

test effect fn discoveryRevisionTracksHeaderBodyAndNestedMembership() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run catalogRevisionClaims() |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn importedCatalogRevisionClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let root = run module("root.silk")
  let child = run module("child.silk")
  let base = run Revision.publish(&Revision.make(), &root,
    &run present("import child\ntest fn visible() {}\n"))
  let first = run Revision.publish(&base, &child, &run present("struct Holder {}\n"))
  let editedText = "struct Holder {}\nimpl Holder { test fn hidden() {} }\n"
  let edited = run Revision.publish(&first, &child, &run present(editedText))
  let mut warm = makeSemantic(move first)
  Semantic.selectDiscovery(&mut warm, ModuleId.copy(&root), Bytes.make())
  let mut request = Request.make()
  let before = run Semantic.demandTests(&mut warm, &mut request)
  run Testing.expect(match &before {
    Result<Shared<TestCatalog>, Shared<Rejection>>.Success {value} => Shared<TestCatalog>.with<bool>(
      &value, fn(catalog: &TestCatalog) -> bool { return Vector<TestEntry>.length(&catalog.entries) == usize.ONE })
    _ => false
  }, "imported catalog fixture starts with one valid root test")
  run Semantic.update(&mut warm, run Revision.copy(&edited))
  let actual = run Semantic.demandTests(&mut warm, &mut request)
  let mut fresh = makeSemantic(move edited)
  Semantic.selectDiscovery(&mut fresh, ModuleId.copy(&root), Bytes.make())
  let mut freshRequest = Request.make()
  let expected = run Semantic.demandTests(&mut fresh, &mut freshRequest)
  run Testing.expect(sameCatalogResult(&actual, &expected)
    && rejectedAt(&actual, RejectionCode.InvalidTestDeclaration,
      offsetOf(editedText, "test fn hidden", usize.ZERO)),
    "an unnamed impl in an imported module updates the root catalog's exact refusal")
  return ()
}

test effect fn discoveryRevisionTracksImportedUnnamedImpl() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run importedCatalogRevisionClaims() |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn discoveryCatalogsTheRootImportClosureOnce() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run catalogClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// The root reaches `alpha` directly and through `beta`; `silk/` modules and unreached files never
// contribute. Entries are ordered by module, then name.
effect fn catalogClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let root = run module("root.silk")
  let alpha = run module("alpha.silk")
  let beta = run module("beta.silk")
  let unreached = run module("unreached.silk")
  let rootText = """import beta
import alpha
test fn rootCheck() {}
fn countNamed() -> usize {
  let mut total: usize = 0
  static for descriptor in Intrinsic.tests() {
    if Intrinsic.stringEqualsExact(Intrinsic.testInfo(descriptor).name, "first") { total = total + 1 }
  }
  return total
}
fn readLine() -> usize {
  let mut total: usize = 0
  static for descriptor in Intrinsic.tests() { total = total + Intrinsic.testInfo(descriptor).line }
  return total
}
fn bindAll() -> () {
  static for descriptor in Intrinsic.tests() {
    let body = Intrinsic.testFunction(descriptor)
    drop body
  }
  return ()
}
"""
  let alphaText = """fn helper() -> i32 { return 1 }
test fn zeta() {}
test effect fn first() -> () { return () }
"""
  let revision = run Revision.publish(&Revision.make(), &root, &run present(rootText))
  let withAlpha = run Revision.publish(&revision, &alpha, &run present(alphaText))
  let withBeta = run Revision.publish(
    &withAlpha,
    &beta,
    &run present("import alpha\ntest fn middle() {}\n")
  )
  let complete = run Revision.publish(&withBeta, &unreached, &run present("test fn ignored() {}\n"))
  let mut index = SourceIndex.make(run Revision.copy(&complete))
  let mut semantic = makeSemantic(move complete)
  Semantic.selectDiscovery(&mut semantic, ModuleId.copy(&root), run Bytes.copy(b"src"))
  let mut request = Request.make()
  let catalog = match move run Semantic.demandTests(&mut semantic, &mut request) {
    Result<Shared<TestCatalog>, Shared<Rejection>>.Success { value } => move value
    Result<Shared<TestCatalog>, Shared<Rejection>>.Failure { error } => {
      drop error
      run Testing.expect(false, "a valid root has a catalog")
      return ()
    }
  }
  let identities = run Semantic.testIdentities(&catalog)
  let listed = Vector<Bytes>.asSlice(&identities)
  run Testing.expect(listed.length == 4, "each reached project test is cataloged once")
  run Testing.expect(
    sameBytes(Bytes.asSlice(&listed[usize.ZERO]), b"project:alpha/function=first#0")
      && sameBytes(Bytes.asSlice(&listed[usize.ONE]), b"project:alpha/function=zeta#0")
      && sameBytes(Bytes.asSlice(&listed[2]), b"project:beta/function=middle#0")
      && sameBytes(Bytes.asSlice(&listed[3]), b"project:root/function=rootCheck#0"),
    "tests are ordered by module, then name"
  )
  let described = Shared<TestCatalog>.with<bool>(
    &catalog,
    fn(held: &TestCatalog) -> bool {
      let entries = Vector<TestEntry>.asSlice(&held.entries)
      return sameBytes(Bytes.asSlice(&entries[usize.ZERO].name), b"first")
        && sameBytes(Bytes.asSlice(&entries[usize.ZERO].module), b"alpha")
        && sameBytes(Bytes.asSlice(&entries[usize.ZERO].path), b"src/alpha.silk")
    }
  )
  run Testing.expect(described, "an entry records its name, module and package path")
  let counting = run selectedApplicationOf(&mut index, &root, b"countNamed")
  let counted = run Semantic.demandSelectedBody(&mut semantic, &mut request, &counting)
  let binding = run selectedApplicationOf(&mut index, &root, b"bindAll")
  let bound = run Semantic.demandSelectedBody(&mut semantic, &mut request, &binding)
  run Testing.expect(
    succeeded(&counted) && succeeded(&bound),
    "static for over the catalog reads each test's metadata and exact callable"
  )
  // TEST-004: descriptors carry no source position, so `TestInfo` has no `line` member.
  let lining = run selectedApplicationOf(&mut index, &root, b"readLine")
  let lined = run Semantic.demandSelectedBody(&mut semantic, &mut request, &lining)
  let lineStart = offsetOf(rootText, "line }", usize.ZERO)
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<bool>(&lined, fn(value: &Result<Answer, NoRejection>) -> bool {
      return rejectionAt(value, RejectionCode.UnknownProjectedField, lineStart)
    }),
    "a TestInfo has no position member"
  )
  // Moving tests within their file changes no catalog identity, so no runner respecializes.
  let movedAlpha = run Revision.publish(&revision, &alpha, &run present("""fn helper() -> i32 { return 1 }


test fn zeta() {}

    test effect fn first() -> () { return () }
"""))
  let movedBeta = run Revision.publish(&movedAlpha, &beta, &run present("import alpha\n\ntest fn middle() {}\n"))
  let mut moved = makeSemantic(move movedBeta)
  Semantic.selectDiscovery(&mut moved, ModuleId.copy(&root), run Bytes.copy(b"src"))
  let mut movedRequest = Request.make()
  let movedCatalog = match move run Semantic.demandTests(&mut moved, &mut movedRequest) {
    Result<Shared<TestCatalog>, Shared<Rejection>>.Success { value } => move value
    Result<Shared<TestCatalog>, Shared<Rejection>>.Failure { error } => {
      drop error
      run Testing.expect(false, "a moved catalog is valid")
      return ()
    }
  }
  let original = Shared<TestCatalog>.with<[u8; 32]>(&catalog, fn(held: &TestCatalog) -> [u8; 32] { return held.digest })
  let unchanged = Shared<TestCatalog>.with<bool>(&movedCatalog, fn(other: &TestCatalog) -> bool {
    let mut at = usize.ZERO
    while at < 32 {
      if original[at] != other.digest[at] { return false }
      at = at + usize.ONE
    }
    return true
  })
  run Testing.expect(unchanged, "moving tests keeps the catalog identity")
  return ()
}

test effect fn discoveryRejectsInvalidEntriesAndMissingRoots() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run refusalClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

fn rejectedAt(
  result: &Result<Shared<TestCatalog>, Shared<Rejection>>,
  code: RejectionCode,
  start: usize
) -> bool {
  if let Result<Shared<TestCatalog>, Shared<Rejection>>.Failure { error } = &result.* {
    return Shared<Rejection>.with<bool>(
      &error,
      fn(found: &Rejection) -> bool {
        return found.code == code && found.span.start == start
      }
    )
  }
  return false
}

// A discovered invalid entry rejects the catalog at its TEST-001 site, including an associated
// member; a store without a discovery root has no catalog.
effect fn refusalClaims() -> ()
  ! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let root = run module("root.silk")
  let parameterText = "test fn counted(limit: u8) {}\n"
  let memberText = "struct Holder {}\nimpl Holder { test fn member() {} }\n"
  let mut parameterized = makeSemantic(
    run Revision.publish(&Revision.make(), &root, &run present(parameterText))
  )
  Semantic.selectDiscovery(&mut parameterized, ModuleId.copy(&root), Bytes.make())
  let mut request = Request.make()
  let refused = run Semantic.demandTests(&mut parameterized, &mut request)
  run Testing.expect(
    rejectedAt(
      &refused,
      RejectionCode.InvalidTestDeclaration,
      offsetOf(parameterText, "limit: u8", usize.ZERO)
    ),
    "a parameterized test rejects discovery at its parameter"
  )
  let mut associated = makeSemantic(
    run Revision.publish(&Revision.make(), &root, &run present(memberText))
  )
  Semantic.selectDiscovery(&mut associated, ModuleId.copy(&root), Bytes.make())
  let member = run Semantic.demandTests(&mut associated, &mut request)
  run Testing.expect(
    rejectedAt(
      &member,
      RejectionCode.InvalidTestDeclaration,
      offsetOf(memberText, "test fn member", usize.ZERO)
    ),
    "an associated test rejects discovery at its test qualifier"
  )
  let mut ordinary = makeSemantic(
    run Revision.publish(&Revision.make(), &root, &run present("test fn plain() {}\n"))
  )
  let missing = run Semantic.demandTests(&mut ordinary, &mut request)
  run Testing.expect(
    rejectedAt(&missing, RejectionCode.StaticPhaseViolation, usize.ZERO),
    "an ordinary build has no test catalog"
  )
  return ()
}
