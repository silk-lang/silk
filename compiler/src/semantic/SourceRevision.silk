//! Immutable in-memory source mappings and exact source observations.
//!
//! # When to use
//! Use [`Revision`] to hold one source view during a compiler request. Call [`publish`] to make
//! another view after one present or absent mapping changes.
//!
//! # Details
//! A held revision never reads a host filesystem. Every module path resolves to the bytes stored
//! in that revision or to absence, including paths that were not named when it was created.

import semantic.ContentHash {ContentHash}
import semantic.InternIndex {InternIndex}
import semantic.ModuleId {ModuleId}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.option {Option}
import silk.mem.pointer {Pointer}
import silk.mem.shared {Shared}
import silk.num.usize
import silk.collections.list {List}
import silk.collections.slice {Slice}

/// One explicit present or absent mapping in a revision.
struct Mapping {
  id: ModuleId,
  content: Option<Shared<Bytes>>,
  // The digest of the content, hashed once when it is published; zero for absence.
  digest: ContentHash,
}

/// One immutable set of in-memory module contents.
pub struct Revision {
  number: usize,
  mappings: List<Mapping>,
  // Mapping positions by module identity hash, recorded in mapping order.
  lookup: InternIndex,
}

/// The exact bytes or absence observed for one module path.
///
/// # Details
///
/// [`matches`] compares exact content and presence against a later revision. An unrelated source
/// update does not change this observation.
pub struct Observation {
  id: ModuleId,
  content: Option<Shared<Bytes>>,
  digest: ContentHash,
  // The index of the observed mapping in the revision it came from, or `usize.MAX` for an absent
  // path. A later revision usually keeps the mapping at that index, so `matches` tries it before
  // probing the lookup.
  mapping: usize,
}

fn sameBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length {
    return false
  }
  let mut index = usize.ZERO
  while index < left.length {
    if left[index] != right[index] {
      return false
    }
    index = index + usize.ONE
  }
  return true
}

// Source content is immutable inside this actor. Clones retain its allocation so repeated
// authentication of the same publication never rescans the complete file.
fn retainContent(content: &Option<Shared<Bytes>>) -> Option<Shared<Bytes>> {
  return match & content.* {
    Option<Shared<Bytes>>.Some {value} => Option<Shared<Bytes>>.some(Shared<Bytes>.clone(&value))
    Option<Shared<Bytes>>.None => Option<Shared<Bytes>>.none()
  }
}

effect fn publishContent(content: &Option<Bytes>) -> Option<Shared<Bytes>>
! OutOfMemoryError
? &mut Allocator {
  return match & content.* {
    Option<Bytes>.Some {value} => Option<Shared<Bytes>>.some(
      run Shared<Bytes>.make(run Bytes.copy(Bytes.asSlice(&value))),
    )
    Option<Bytes>.None => Option<Shared<Bytes>>.none()
  }
}

// The digest a mapping of `content` keeps.
fn digestOf(content: &Option<Bytes>) -> ContentHash {
  return match &content.* {
    Option<Bytes>.Some {value} => ContentHash.of(Bytes.asSlice(&value))
    Option<Bytes>.None => ContentHash {high: 0, low: 0}
  }
}

fn contentAddress(value: &Bytes) -> usize {
  return Pointer.address<Bytes>(Pointer.fromRef<Bytes>(value))
}

fn compareContent(first: &Bytes, other: &Shared<Bytes>) -> bool {
  return Shared<Bytes>.with<bool>(
    other,
    fn(second: &Bytes) -> bool {
      return sameBytes(Bytes.asSlice(first), Bytes.asSlice(second))
    },
  )
}

fn sameContent(left: &Shared<Bytes>, right: &Shared<Bytes>) -> bool {
  if Shared<Bytes>.with<usize>(left, contentAddress) == Shared<Bytes>.with<usize>(
    right,
    contentAddress,
  ) {
    return true
  }
  return Shared<Bytes>.with<bool>(
    left,
    fn(first: &Bytes) -> bool {
      return compareContent(first, right)
    },
  )
}

effect fn copyContent(content: &Option<Shared<Bytes>>) -> Option<Bytes>
! OutOfMemoryError
? &mut Allocator {
  return match & content.* {
    Option<Shared<Bytes>>.Some {value} => {
      let count = Shared<Bytes>.with<usize>(&value, Bytes.length)
      let mut copied = run Bytes.zeroed(count)
      let target = Bytes.asMutSlice(&mut copied)
      Shared<Bytes>.with<()>(&value, fn(bytes: &Bytes) -> () {
        return Slice.copyInto<u8>(move target, usize.ZERO, Bytes.asSlice(bytes))
      })
      return Option<Bytes>.some(move copied)
    }
    Option<Shared<Bytes>>.None => Option<Bytes>.none()
  }
}

fn mappingAt(revision: &Revision, id: &ModuleId) -> Option<usize> {
  let mappings = List<Mapping>.asSlice(&revision.mappings)
  let mut index = InternIndex.first(&revision.lookup, ModuleId.hash(id))
  while index != usize.MAX {
    if ModuleId.equals(&mappings[index].id, id) {
      return Option<usize>.some(index)
    }
    index = InternIndex.after(&revision.lookup, index)
  }
  return Option<usize>.none()
}

// Appends one mapping and records its module identity.
effect fn appendMapping(mappings: &mut List<Mapping>, lookup: &mut InternIndex, mapping: Mapping) -> ()
! OutOfMemoryError
? &mut Allocator {
  let hashed = ModuleId.hash(&mapping.id)
  run List<Mapping>.append(&mut mappings.*, move mapping)
  run InternIndex.record(&mut lookup.*, hashed)
  return ()
}

impl Revision {
  /// Creates an empty revision in which every module path is absent.
  pub fn make() -> Revision {
    return Revision {number: usize.ZERO, mappings: List<Mapping>.make(), lookup: InternIndex.make()}
  }
  /// Returns the publication number of this held in-memory revision.
  pub fn revisionNumber(self: &Self) -> usize {
    return self.number
  }
  /// Copies a held revision map while retaining its immutable present content and absence.
  pub effect fn copy(self: &Self) -> Revision ! OutOfMemoryError ? &mut Allocator {
    let mut mappings = List<Mapping>.make()
    let mut lookup = InternIndex.make()
    let source = List<Mapping>.asSlice(&self.mappings)
    let mut index = usize.ZERO
    while index < source.length {
      run appendMapping(
        &mut mappings,
        &mut lookup,
        Mapping {
          id: ModuleId.copy(&source[index].id),
          content: retainContent(&source[index].content),
          digest: source[index].digest,
        },
      )
      index = index + usize.ONE
    }
    return Revision {number: self.number, mappings: move mappings, lookup: move lookup}
  }
  /// Publishes a new revision with one path set to exact bytes or explicit absence.
  ///
  /// # Details
  ///
  /// This function copies the map before it changes one entry. `self` remains valid and unchanged
  /// even if the new allocation fails.
  pub effect fn publish(self: &Self, id: &ModuleId, content: &Option<Bytes>) -> Revision
  ! OutOfMemoryError
  ? &mut Allocator {
    let mut next = List<Mapping>.make()
    let mut lookup = InternIndex.make()
    let mappings = List<Mapping>.asSlice(&self.mappings)
    let mut replaced = false
    let mut index = usize.ZERO
    while index < mappings.length {
      let entry = &mappings[index]
      let isTarget = ModuleId.equals(&entry.id, id)
      let mut updated = Option<Shared<Bytes>>.none()
      let mut digest = entry.digest
      if isTarget {
        updated = run publishContent(content)
        digest = digestOf(content)
      } else {
        updated = retainContent(&entry.content)
      }
      run appendMapping(
        &mut next,
        &mut lookup,
        Mapping {id: ModuleId.copy(&entry.id), content: move updated, digest: digest},
      )
      if isTarget {
        replaced = true
      }
      index = index + usize.ONE
    }
    if !replaced {
      run appendMapping(
        &mut next,
        &mut lookup,
        Mapping {id: ModuleId.copy(id), content: run publishContent(content), digest: digestOf(content)},
      )
    }
    return Revision {number: self.number + usize.ONE, mappings: move next, lookup: move lookup}
  }
  /// Makes this revision the one [`publish`] would make from it, without copying the mappings
  /// that stay: for a holder that keeps only the newest revision.
  pub effect fn publishInPlace(self: &mut Self, id: &ModuleId, content: &Option<Bytes>) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
    let updated = run publishContent(content)
    let digest = digestOf(content)
    self.number = self.number + usize.ONE
    if let Option<usize>.Some {value} = move mappingAt(&self.*, id) {
      let mappings = List<Mapping>.asMutSlice(&mut self.mappings)
      mappings[value].content = move updated
      mappings[value].digest = digest
      return ()
    }
    return run appendMapping(&mut self.mappings, &mut self.lookup, Mapping {id: ModuleId.copy(id), content: move updated, digest: digest})
  }
  /// The digest of the bytes this revision holds for one module path, which their publication
  /// hashed; none when it holds none.
  pub fn digestAt(self: &Self, id: &ModuleId) -> Option<ContentHash> {
    if let Option<usize>.Some {value} = move mappingAt(self, id) {
      let mappings = List<Mapping>.asSlice(&self.mappings)
      return match &mappings[value].content {
        Option<Shared<Bytes>>.Some {..} => Option<ContentHash>.some(mappings[value].digest)
        Option<Shared<Bytes>>.None => Option<ContentHash>.none()
      }
    }
    return Option<ContentHash>.none()
  }
  /// Reports whether this revision holds bytes for one module path.
  pub fn presents(self: &Self, id: &ModuleId) -> bool {
    if let Option<usize>.Some {value} = move mappingAt(self, id) {
      let mappings = List<Mapping>.asSlice(&self.mappings)
      return match &mappings[value].content {
        Option<Shared<Bytes>>.Some {value: _} => true
        Option<Shared<Bytes>>.None => false
      }
    }
    return false
  }
  /// Captures the exact stored bytes or absence of one module path.
  ///
  /// # Details
  ///
  /// The observation retains immutable content. It remains valid after another revision is published.
  pub effect fn observe(self: &Self, id: &ModuleId) -> Observation
  ! OutOfMemoryError
  ? &mut Allocator {
    let found = mappingAt(self, id)
    if let Option<usize>.Some {value} = move found {
      // The mapping's identity record is shared, so later matches compare it by address.
      let mappings = List<Mapping>.asSlice(&self.mappings)
      return Observation {id: ModuleId.copy(&mappings[value].id), content: retainContent(&mappings[value].content),
        digest: mappings[value].digest, mapping: value}
    }
    return Observation {id: ModuleId.copy(id), content: Option<Shared<Bytes>>.none(), digest: ContentHash {high: 0, low: 0},
      mapping: usize.MAX}
  }
}

impl Observation {
  /// Copies the captured observation while retaining its immutable content.
  pub effect fn copy(self: &Self) -> Observation ! OutOfMemoryError ? &mut Allocator {
    return Observation {id: ModuleId.copy(&self.id), content: retainContent(&self.content), digest: self.digest, mapping: self.mapping}
  }
  /// Compares two exact source observations, including present bytes or absence.
  pub fn equals(self: &Self, other: &Observation) -> bool {
    if !ModuleId.equals(&self.id, &other.id) {
      return false
    }
    return match & self.content {
      Option<Shared<Bytes>>.Some {value} => match & other.content {
        Option<Shared<Bytes>>.Some {value: compared} => sameContent(&value, &compared)
        Option<Shared<Bytes>>.None => false
      }
      Option<Shared<Bytes>>.None => match & other.content {
        Option<Shared<Bytes>>.Some {value: ignored} => false
        Option<Shared<Bytes>>.None => true
      }
    }
  }
  /// Borrows the canonical module path whose bytes or absence were captured.
  pub fn moduleId(self: &Self) -> &ModuleId {
    return &self.id
  }
  /// Reports whether the observed module had source bytes.
  pub fn isPresent(self: &Self) -> bool {
    return match & self.content {
      Option<Shared<Bytes>>.Some {value: _} => true
      Option<Shared<Bytes>>.None => false
    }
  }
  /// Returns independently owned observed bytes, or absence.
  pub effect fn copyContent(self: &Self) -> Option<Bytes> ! OutOfMemoryError ? &mut Allocator {
    return run copyContent(&self.content)
  }
  /// The digest of the observed bytes, or absence, which their publication hashed.
  pub fn contentDigest(self: &Self) -> Option<ContentHash> {
    return match &self.content {
      Option<Shared<Bytes>>.Some {..} => Option<ContentHash>.some(self.digest)
      Option<Shared<Bytes>>.None => Option<ContentHash>.none()
    }
  }
  /// Reports whether a later revision has the same exact bytes or absence at this module path.
  pub fn matches(self: &Self, revision: &Revision) -> bool {
    let mappings = List<Mapping>.asSlice(&revision.mappings)
    // Mapping identities are unique within a revision, so a mapping of this path at the observed
    // index is the one a lookup would find.
    let mut found = Option<usize>.none()
    if self.mapping < mappings.length && ModuleId.equals(&mappings[self.mapping].id, &self.id) {
      found = Option<usize>.some(self.mapping)
    } else {
      found = mappingAt(revision, &self.id)
    }
    return match & self.content {
      Option<Shared<Bytes>>.Some {value} => match move found {
        Option<usize>.Some {value: index} => match & mappings[index].content {
          Option<Shared<Bytes>>.Some {value: current} => sameContent(&value, &current)
          Option<Shared<Bytes>>.None => false
        }
        Option<usize>.None => false
      }
      Option<Shared<Bytes>>.None => match move found {
        Option<usize>.Some {value: index} => match & mappings[index].content {
          Option<Shared<Bytes>>.Some {value: _} => false
          Option<Shared<Bytes>>.None => true
        }
        Option<usize>.None => true
      }
    }
  }
}
