effect fn selectedBodyDependencyClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("b12-selected-dependencies.silk")
  let source = """
static fn amount(base: i32) -> i32 { return base * 10 + 1 }
static fn broken() -> i32 { return missing }
fn withLocal(value: i32) -> i32 {
  let static scaled = amount(2)
  return scaled + value
}
fn direct(value: i32) -> i32 { return amount(2) + value }
fn caller() -> i32 { return withLocal(21) }
fn generic<T>(value: T) -> T {
  static if true {
    return move value
  }
  return move value
}
"""
  let authored = run present(source)
  let revision = run Revision.publish(&Revision.make(), &id, &authored)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let withLocal = run selectedApplicationOf(&mut index, &id, b"withLocal")
  let genericDeclaration = run requireIndexedIdentity(&mut index, &id, OwnerKind.Function, b"generic", usize.ZERO)
  let mut genericArguments = Vector<Argument>.make()
  run Vector<Argument>.append(&mut genericArguments, Argument.Type {value: run Types.intern(Type.Primitive {name: run Bytes.copy(b"i32")})})
  let genericApplication = run specializationWithArguments(&genericDeclaration, move genericArguments)
  let mut store = makeSemantic(run Revision.copy(&revision))
  let mut request = Request.make()
  let callerBody = run Semantic.demandBody(&mut store, &mut request, &id, b"caller")
  run Testing.expect(succeeded(&callerBody) && starts(Semantic.eventLog(&store), Family.Body) == usize.ONE,
    "typing a caller reads the mixed callee's signature and never demands its body")
  let selected = run Semantic.demandSelectedBody(&mut store, &mut request, &withLocal)
  let shape = run selectedShape(&selected)
  run Testing.expect(sameShape(&shape, usize.ONE, usize.ZERO, usize.ZERO),
    "the selected body embeds the helper result; the uncalled failing helper is never demanded")
  let genericSelected = run Semantic.demandSelectedBody(&mut store, &mut request, &genericApplication)
  run Testing.expect(succeeded(&genericSelected), "a generic selected application types its residual inside its own application")
  let editedSource = """
static fn amount(base: i32) -> i32 { return base * 10 + 2 }
static fn broken() -> i32 { return missing }
fn withLocal(value: i32) -> i32 {
  let static scaled = amount(2)
  return scaled + value
}
fn direct(value: i32) -> i32 { return amount(2) + value }
fn caller() -> i32 { return withLocal(21) }
fn generic<T>(value: T) -> T {
  static if true {
    return move value
  }
  return move value
}
"""
  let edited = run present(editedSource)
  let changed = run Revision.publish(&revision, &id, &edited)
  run Semantic.update(&mut store, run Revision.copy(&changed))
  let mut editedRequest = Request.make()
  let reselected = run Semantic.demandSelectedBody(&mut store, &mut editedRequest, &withLocal)
  let reselectedBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&reselected, checkedBody)
  let mut embedsEdited = false
  if let Option<Shared<TypedBody>>.Some {value: typed} = move reselectedBody {
    embedsEdited = Shared<TypedBody>.with<usize>(&typed, fn(body: &TypedBody) -> usize { return embeddedI32(body, 22) }) == usize.ONE
  }
  run Testing.expect(embedsEdited, "editing the static helper revalidates the selected body and embeds its new result")
  let mut freshEdited = makeSemantic(run Revision.copy(&changed))
  let mut freshEditedRequest = Request.make()
  let freshReselected = run Semantic.demandSelectedBody(&mut freshEdited, &mut freshEditedRequest, &withLocal)
  run Testing.expect(agreesWithFresh(&reselected, &freshReselected), "the revalidated selected body agrees with a fresh store of the same revision")
  let runtimeSource = """
fn amount(base: i32) -> i32 { return base * 10 + 2 }
static fn broken() -> i32 { return missing }
fn withLocal(value: i32) -> i32 {
  let static scaled = amount(2)
  return scaled + value
}
fn direct(value: i32) -> i32 { return amount(2) + value }
fn caller() -> i32 { return withLocal(21) }
fn generic<T>(value: T) -> T {
  static if true {
    return move value
  }
  return move value
}
"""
  let runtimeHelper = run present(runtimeSource)
  let demoted = run Revision.publish(&changed, &id, &runtimeHelper)
  run Semantic.update(&mut store, run Revision.copy(&demoted))
  let mut demotedRequest = Request.make()
  let directMir = run Semantic.demandMir(&mut store, &mut demotedRequest, &id, b"direct")
  run Testing.expect(mirReferenceCount(&store, &directMir) == usize.ONE,
    "removing static from the helper reroutes its caller to an ordinary body with a real call")
  let staticRead = run Semantic.demandSelectedBody(&mut store, &mut demotedRequest, &withLocal)
  let readStart = offsetOf(runtimeSource, "amount(2)", usize.ZERO)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&staticRead, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionAt(answer, RejectionCode.StaticPhaseViolation, readStart)
    }), "a let static initializer calling a runtime function reports a static phase violation at the call")
  let mut freshDemoted = makeSemantic(run Revision.copy(&demoted))
  let mut freshDemotedRequest = Request.make()
  let freshStaticRead = run Semantic.demandSelectedBody(&mut freshDemoted, &mut freshDemotedRequest, &withLocal)
  run Testing.expect(agreesWithFresh(&staticRead, &freshStaticRead), "the demoted selected body agrees with a fresh store of the same revision")
  return ()
}

