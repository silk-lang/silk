effect fn nestedMixedLoopClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("nested-mixed-static-for.silk")
  let source = """static fn values() -> Intrinsic.StaticSequence<i32> {
  let first = Intrinsic.staticSequenceAppend<i32>(Intrinsic.staticSequenceEmpty<i32>(), 20)
  return Intrinsic.staticSequenceAppend<i32>(move first, 22)
}
fn nested() -> i32 {
  let mut count = 0
  static for outer in values() {
    static for inner in values() {count = count + outer + inner}
  }
  return count
}
fn noOuter() -> i32 {
  static for outer in Intrinsic.staticSequenceEmpty<i32>() {
    static for inner in missing() {missing()}
  }
  return 42
}
fn failed() -> i32 {
  static for outer in values() {
    static for inner in values() {
      static if inner == 22 {compileError("late nested")}
    }
  }
  return 42
}
"""
  let authored = run present(source)
  let revision = run Revision.publish(&Revision.make(), &id, &authored)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let mut store = makeSemantic(run Revision.copy(&revision))
  let mut request = Request.make()
  let nested = run selectedApplicationOf(&mut index, &id, b"nested")
  let checked = run Semantic.demandSelectedBody(&mut store, &mut request, &nested)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&checked, staticControlNestedAnswer), "two outer and four inner scopes retain eight exact embedded operands")
  let empty = run selectedApplicationOf(&mut index, &id, b"noOuter")
  let silent = run Semantic.demandSelectedBody(&mut store, &mut request, &empty)
  run Testing.expect(succeeded(&silent), "a zero outer expansion never elaborates its invalid nested body")
  let failing = run selectedApplicationOf(&mut index, &id, b"failed")
  let discarded = run Semantic.demandSelectedBody(&mut store, &mut request, &failing)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&discarded, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return rejectionAt(answer, RejectionCode.SelectedCompileError, offsetOf(source, "compileError(\"late nested\")", usize.ZERO))
  }), "a later nested iteration failure publishes no partial body")
  return ()
}

fn staticControlNestedAnswer(answer: &Result<Answer, NoRejection>) -> bool {
  let held = checkedBody(answer)
  if let Option<Shared<TypedBody>>.Some {value: typed} = move held {
    return Shared<TypedBody>.with<bool>(&typed, staticControlNestedBody)
  }
  return false
}

fn staticControlNestedBody(typed: &TypedBody) -> bool {
let facts = TypedBody.staticIterations(typed)
let mut iterations = usize.ZERO
let mut at = usize.ZERO
while at < facts.length {
  let BodyStaticIteration {nodeStart, nodeEnd, ordinal, ..} = &facts[at]
  if nodeEnd <= nodeStart || ordinal > usize.ONE {return false}
  iterations = iterations + usize.ONE

  at = at + usize.ONE
}
let nodes = TypedBody.nodeSlice(typed)
let mut embedded = usize.ZERO
at = usize.ZERO
while at < nodes.length {
  if let BodyNodeKind.Expression {form: BodyExpression.Embedded {value}, ..} = &nodes[at].kind {
    if !Shared<StaticData>.with<bool>(&value, staticControlNestedInteger) {return false}
    embedded = embedded + usize.ONE
  }
  at = at + usize.ONE
}
return iterations == 6 && embedded == 8
}

fn staticControlNestedInteger(data: &StaticData) -> bool {
  return match &data.* {
    StaticData.Integer {ty, sign, magnitude} => ty == StaticIntegerType.I32 && sign == StaticSign.Positive && (magnitude == 20 || magnitude == 22)
    _ => false
  }
}

fn staticPrefixConstantHasFortyTwo(answer: &Result<Answer, NoRejection>) -> bool {
  return staticControlEmbedsInteger(answer, 42)
}

test effect fn staticPrefixesSupplyLocalQualifiedAndImportedConstants() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("static-prefix-constants.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let numbers = run module("numbers.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """import numbers as Numbers
import numbers {ZERO as importedZero, KIND as importedKind}
const localZero: usize = 0
static fn local() -> i32 {let index = localZero static if index == 0 {return 42} else {return 0}}
static fn qualified() -> i32 {let index = Numbers.ZERO static if index == 0 {return 42} else {return 0}}
static fn imported() -> i32 {let index = importedZero static if index == 0 {return 42} else {return 0}}
static fn afterMutation() -> i32 {let mut index: usize = 0 index = index + 1 static if index == Numbers.ONE {return 42} else {return 0}}
static fn inactive() -> i32 {static if true {return 42} else {let index = Numbers.TRAP return 0}}
struct PrefixRecord {pub value: i32}
static fn prefixZero() -> usize {return 0}
static fn reflectionPrefix() -> i32 {
  let mut found = false
  let initial = prefixZero()
  let empty = Intrinsic.staticSequenceEmpty<i32>()
  static for field in Intrinsic.reflectFields<PrefixRecord>() {
    static if Intrinsic.reflectFieldKind<PrefixRecord, i32>(field) == importedKind {found = true}
  }
  static if found && initial == 0 {return 42} else {return 0}
}
fn reflectionPrefixResult() -> i32 {return reflectionPrefix()}
fn localResult() -> i32 {return local()}
fn qualifiedResult() -> i32 {return qualified()}
fn importedResult() -> i32 {return imported()}
fn afterMutationResult() -> i32 {return afterMutation()}
fn inactiveResult() -> i32 {return inactive()}
static fn reached() -> i32 {let index = Numbers.TRAP static if index == 0 {return 42} else {return 0}}
fn reachedResult() -> i32 {return reached()}
"""
  let definitions = "pub const ZERO: usize = 0\npub const ONE: usize = 1\npub const KIND: u8 = 0\npub const TRAP: usize = compileError(\"reached constant\")\n"
  let authored = run present(source) |> Effect.provideMut<Allocator>(&mut allocator)
  let constants = run present(definitions) |> Effect.provideMut<Allocator>(&mut allocator)
  let initial = run Revision.publish(&Revision.make(), &id, &authored)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&initial, &numbers, &constants)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut index = SourceIndex.make(run Revision.copy(&revision) |> Effect.provideMut<Allocator>(&mut allocator))
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let names = ["localResult", "qualifiedResult", "importedResult", "afterMutationResult", "inactiveResult", "reflectionPrefixResult"]
  let listed: &[string] = &names
  let mut at = usize.ZERO
  while at < listed.length {
    let application = run selectedApplicationOf(&mut index, &id, String.utf8Bytes(listed[at]))
      |> Effect.provideMut<Allocator>(&mut allocator)
    let answer = run Semantic.demandSelectedBody(&mut semantic, &mut request, &application)
      |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
    run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&answer, staticPrefixConstantHasFortyTwo), listed[at])
    at = at + usize.ONE
  }
  let application = run selectedApplicationOf(&mut index, &id, b"reachedResult")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let rejected = run Semantic.demandSelectedBody(&mut semantic, &mut request, &application)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(&rejected, RejectionCode.SelectedCompileError, definitions, "compileError(\"reached constant\")", usize.ZERO),
    "reached constant initialization preserves its CompileError code and exact authored source span",
  )
  return ()
}

fn iterationImmediateRunAnswer(answer: &Result<Answer, NoRejection>) -> bool {
  let held = checkedBody(answer)
  if let Option<Shared<TypedBody>>.Some {value: typed} = move held {
    return Shared<TypedBody>.with<bool>(&typed, iterationImmediateRunBody)
  }
  return false
}

fn iterationImmediateRunBody(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut runs = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Run {access, ..}, ..} = &nodes[at].kind {
      if access != BodyRunAccess.Immediate {return false}
      runs = runs + usize.ONE
    }
    at = at + usize.ONE
  }
  let facts = TypedBody.staticIterations(body)
  return runs == 2 && facts.length == 2
}

test effect fn mixedIterationsRunImmediateEffectsWithoutAdmittingGeneratedCaptures() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run iterationImmediateRunClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn iterationImmediateRunClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("mixed-iteration-immediate-effects.silk")
  let source = """service Pulse {effect fn emit(value: &i32) -> () ? &mut Pulse}
static fn two() -> Intrinsic.StaticSequence<i32> {
  let first = Intrinsic.staticSequenceAppend<i32>(Intrinsic.staticSequenceEmpty<i32>(), 1)
  return Intrinsic.staticSequenceAppend<i32>(move first, 2)
}
effect fn replace(value: &mut i32) -> () {value.* = 42}
effect fn returnBorrow<'a>(value: &'a i32) -> &'a i32 {return value}
effect fn outside() -> () ? &mut Pulse {
  let outsideValue = 42
  static for item in two() {run Pulse.emit(&outsideValue)}
}
effect fn outsideMutable() -> () {
  let mut outsideOwned = 0
  static for item in two() {run replace(&mut outsideOwned)}
}
effect fn silent() -> () ? &mut Pulse {
  static for item in Intrinsic.staticSequenceEmpty<i32>() {run missing(&missingOwner)}
}
effect fn stored() -> () ? &mut Pulse {
  static for item in two() {
    let insideEffect = 42
    let held = Pulse.emit(&insideEffect)
  }
}
fn resultBorrowed() -> () {
  static for item in two() {
    let insideResult = 42
    let held = run returnBorrow(&insideResult)
  }
}
fn borrowed() -> () {
  static for item in two() {
    let insideLoan = 42
    let held = &insideLoan
  }
}
"""
  let authored = run present(source)
  let revision = run Revision.publish(&Revision.make(), &id, &authored)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let outside = run selectedApplicationOf(&mut index, &id, b"outside")
  let checked = run Semantic.demandSelectedBody(&mut semantic, &mut request, &outside)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&checked, iterationImmediateRunAnswer),
    "two exact iteration occurrences immediately execute their service call while borrowing outside storage")
  let mutableOutside = run selectedApplicationOf(&mut index, &id, b"outsideMutable")
  let checkedMutable = run Semantic.demandSelectedBody(&mut semantic, &mut request, &mutableOutside)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&checkedMutable, iterationImmediateRunAnswer),
    "two exact iteration occurrences execute an exclusive outside-owner reborrow without storing its call extent")
  let silent = run selectedApplicationOf(&mut index, &id, b"silent")
  let untouched = run Semantic.demandSelectedBody(&mut semantic, &mut request, &silent)
  run Testing.expect(succeeded(&untouched), "an empty iteration never elaborates its invalid run or borrow")
  let stored = run selectedApplicationOf(&mut index, &id, b"stored")
  let retained = run Semantic.demandSelectedBody(&mut semantic, &mut request, &stored)
  let resultBorrowed = run selectedApplicationOf(&mut index, &id, b"resultBorrowed")
  let resultLoan = run Semantic.demandSelectedBody(&mut semantic, &mut request, &resultBorrowed)
  let borrowed = run selectedApplicationOf(&mut index, &id, b"borrowed")
  let generated = run Semantic.demandSelectedBody(&mut semantic, &mut request, &borrowed)
  run Testing.expect(succeeded(&retained) && succeeded(&resultLoan) && succeeded(&generated),
    "a stored Effect, a borrowed run result and a plain loan of generated locals stay inside their occurrence")
  return ()
}
