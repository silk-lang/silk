effect fn selectedArmDiagnosticClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("b12-selected-diagnostic.silk")
  let source = """
fn quiet() -> i32 {
  static if false {
    return missing
  }
  return 0
}
fn loud() -> i32 {
  static if true {
    return missing
  }
  return 0
}
fn sealed(value: isize) -> usize {
  let widened = Intrinsic.isizeToUsize(value)
  static if true {
    return widened
  }
  return 0
}
pub struct Gate {}
impl Gate {
  fn base() -> i32 { return 1 }
  fn member() -> i32 {
    static if true {
      return Gate.base()
    }
    return 0
  }
}
"""
  let authored = run present(source)
  let revision = run Revision.publish(&Revision.make(), &id, &authored)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let quiet = run selectedApplicationOf(&mut index, &id, b"quiet")
  let loud = run selectedApplicationOf(&mut index, &id, b"loud")
  let sealed = run selectedApplicationOf(&mut index, &id, b"sealed")
  let mut store = makeSemantic(run Revision.copy(&revision))
  let mut request = Request.make()
  let inactive = run Semantic.demandSelectedBody(&mut store, &mut request, &quiet)
  let active = run Semantic.demandSelectedBody(&mut store, &mut request, &loud)
  let missingStart = offsetOf(source, "missing", usize.ONE)
  run Testing.expect(succeeded(&inactive), "an unknown name in the inactive arm is not resolved")
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&active, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionAt(answer, RejectionCode.UnknownName, missingStart)
    }), "the same unknown name in the selected arm reports its exact code and span")
  let sealedBody = run Semantic.demandSelectedBody(&mut store, &mut request, &sealed)
  run Testing.expect(succeeded(&sealedBody), "the sealed Intrinsic namespace qualifies a runtime call in a selected body")
  let member = run selectedApplicationOf(&mut index, &id, b"member")
  let memberBody = run Semantic.demandSelectedBody(&mut store, &mut request, &member)
  run Testing.expect(succeeded(&memberBody), "an impl member's selected body routes runtime names like a module function")
  return ()
}

test effect fn selectedRoutingCoversContainersAndModules() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run selectedRoutingContainerClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// Which body a function's MIR lowered: 0 when it demanded none, 1 for the declaration's abstract
// body (a later abstract demand reuses it), 2 for a selected body (that demand starts anew).
effect fn loweredBodyKind(store: &mut Semantic, id: &ModuleId, name: &[u8]) -> usize
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let mut request = Request.make()
  let initial = starts(Semantic.eventLog(&store.*), Family.Body)
  let mir = run Semantic.demandMir(&mut store.*, &mut request, id, name)
  drop mir
  let before = starts(Semantic.eventLog(&store.*), Family.Body)
  if before != initial + usize.ONE { return usize.ZERO }
  let declared = run Semantic.demandBody(&mut store.*, &mut request, id, name)
  drop declared
  if starts(Semantic.eventLog(&store.*), Family.Body) == before { return usize.ONE }
  return 2
}

effect fn selectedRoutingContainerClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let library = run module("routinglibrary.silk")
  let id = run module("b12-selected-containers.silk")
  let librarySource = run present("pub static fn amount(base: i32) -> i32 { return base * 10 + 1 }\n")
  let source = """
import routinglibrary as Library
struct Box { value: i32 }
fn qualified(value: i32) -> i32 { return Library.amount(2) + value }
fn inUnsafe() -> i32 {
  unsafe {
    static if true {
      return 1
    }
  }
  return 0
}
fn inIfLet(box: Box) -> i32 {
  if let Box {value} = move box {
    let static scaled = 3
    return scaled
  }
  return 0
}
fn inMatch(flag: bool) -> i32 {
  match flag {
    _ => {
      static if true {
        return 1
      }
    }
  }
  return 0
}
fn inClosure() -> i32 {
  let inner = fn() -> i32 {
    static if true {
      return 1
    }
    return 0
  }
  return 0
}
fn hidden() -> i32 { return missing }
fn pick() -> i32 {
  static if false {
    return hidden()
  }
  return 0
}
"""
  let authored = run present(source)
  let withLibrary = run Revision.publish(&Revision.make(), &library, &librarySource)
  let revision = run Revision.publish(&withLibrary, &id, &authored)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let qualified = run selectedApplicationOf(&mut index, &id, b"qualified")
  let inIfLet = run selectedApplicationOf(&mut index, &id, b"inIfLet")
  let inMatch = run selectedApplicationOf(&mut index, &id, b"inMatch")
  let mut store = makeSemantic(run Revision.copy(&revision))
  let mut request = Request.make()
  let qualifiedMir = run Semantic.demandMir(&mut store, &mut request, &id, b"qualified")
  run Testing.expect(succeeded(&qualifiedMir) && mirReferenceCount(&store, &qualifiedMir) == usize.ZERO,
    "on a fresh store, an imported static helper routes its caller and creates no runtime reference")
  let qualifiedBody = run Semantic.demandSelectedBody(&mut store, &mut request, &qualified)
  let qualifiedShape = run selectedShape(&qualifiedBody)
  run Testing.expect(sameShape(&qualifiedShape, usize.ONE, usize.ZERO, usize.ZERO),
    "the imported static helper's result is one embedded value with no runtime call")
  let unsafeKind = run loweredBodyKind(&mut store, &id, b"inUnsafe")
  let unsafeMir = run Semantic.demandMir(&mut store, &mut request, &id, b"inUnsafe")
  run Testing.expect(unsafeKind == 2 && succeeded(&unsafeMir),
    "a static if inside an unsafe block routes and its decision is selected")
  // The selected member MIR demanded is exactly the application's own: demanding it again is a
  // cache hit.
  let ifLetKind = run loweredBodyKind(&mut store, &id, b"inIfLet")
  let ifLetBodies = starts(Semantic.eventLog(&store), Family.Body)
  let ifLetSelected = run Semantic.demandSelectedBody(&mut store, &mut request, &inIfLet)
  run Testing.expect(ifLetKind == 2 && starts(Semantic.eventLog(&store), Family.Body) == ifLetBodies
      && succeeded(&ifLetSelected),
    "a let static inside an if-let body routes MIR to its selected body, which types the if-let")
  let matchKind = run loweredBodyKind(&mut store, &id, b"inMatch")
  let matchBodies = starts(Semantic.eventLog(&store), Family.Body)
  let matchSelected = run Semantic.demandSelectedBody(&mut store, &mut request, &inMatch)
  run Testing.expect(matchKind == 2 && starts(Semantic.eventLog(&store), Family.Body) == matchBodies
      && succeeded(&matchSelected) && bodyFact(&matchSelected, usize.ZERO) + bodyFact(&matchSelected, usize.ONE) == usize.ONE,
    "a static if inside a match-arm block routes MIR to its selected body, whose bare bool match keeps that block arm")
  let closureKind = run loweredBodyKind(&mut store, &id, b"inClosure")
  run Testing.expect(closureKind == usize.ONE,
    "a static if inside a nested closure does not route the enclosing function")
  let bodiesBefore = starts(Semantic.eventLog(&store), Family.Body)
  let signaturesBefore = starts(Semantic.eventLog(&store), Family.Signature)
  let pickMir = run Semantic.demandMir(&mut store, &mut request, &id, b"pick")
  run Testing.expect(succeeded(&pickMir) && starts(Semantic.eventLog(&store), Family.Body) == bodiesBefore + usize.ONE
      && starts(Semantic.eventLog(&store), Family.Signature) == signaturesBefore + usize.ONE,
    "a private callee named only in an inactive arm has neither its header nor its body demanded")
  return ()
}

test effect fn selectedTypeSelectionReadsReflectedKinds() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run selectedReflectionClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// A static evaluation failure surfaced as StaticViolation whose fault is Unsupported for a missing
// intrinsic operation, at exactly `start`.
fn unsupportedKindAt(answer: &Result<Answer, NoRejection>, start: usize) -> bool {
  if let Option<Shared<Rejection>>.Some {value: problem} = move rejection(answer) {
    return Shared<Rejection>.with<bool>(&problem, unsupportedKindFailure) && Shared<Rejection>.with<bool>(&problem, fn(found: &Rejection) -> bool {
      return found.span.start == start
    })
  }
  return false
}

fn unsupportedKindFailure(found: &Rejection) -> bool {
  if found.code != RejectionCode.Unsupported { return false }
  return match &found.staticFailure {
    Option<StaticDiagnostic>.Some {value} => value.fault == StaticExecutionFault.Unsupported && value.code.length == usize.ZERO && match &value.missing {
      Option<StaticMissingFact>.Some {value: fact} => fact == StaticMissingFact.IntrinsicOperation
      Option<StaticMissingFact>.None => false
    }
    Option<StaticDiagnostic>.None => false
  }
}

// Embedded u8 values with this magnitude, as a reflected kind code is embedded.
fn embeddedU8(body: &TypedBody, magnitude: u64) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Embedded {value}, ..} = &nodes[at].kind {
      let matches = Shared<StaticData>.with<bool>(&value, fn(data: &StaticData) -> bool {
        return match & data.* {
          StaticData.Integer {ty, sign, magnitude: found} => ty == StaticIntegerType.U8 && sign == StaticSign.Positive && found == magnitude
          _ => false
        }
      })
      if matches { count = count + usize.ONE }
    }
    at = at + usize.ONE
  }
  return count
}

// Integer literal nodes whose source starts at `start`.
fn literalsAt(body: &TypedBody, anchor: &Anchor, start: usize) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Integer {..}, ..} = &nodes[at].kind {
      if Anchor.span(anchor, nodes[at].origin.location).start == start { count = count + usize.ONE }
    }
    at = at + usize.ONE
  }
  return count
}

// The arm literals one selected body retained: (starting at `kept`, starting at `dropped`).
effect fn selectedLiterals(store: &mut Semantic, answer: &Shared<Result<Answer, NoRejection>>, kept: usize, dropped: usize) -> bool
! Cycle | OutOfMemoryError ? &mut Allocator {
  let anchor = match move run answerAnchor(&mut store.*, answer) { Option<Anchor>.Some {value} => move value _ => { return false } }
  let body = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value: typed} = move body {
    return Shared<TypedBody>.with<bool>(&typed, fn(checked: &TypedBody) -> bool {
      return literalsAt(checked, &anchor, kept) == usize.ONE && literalsAt(checked, &anchor, dropped) == usize.ZERO
    })
  }
  return false
}

fn selectedU8(answer: &Shared<Result<Answer, NoRejection>>, magnitude: u64) -> bool {
  let body = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value: typed} = move body {
    return Shared<TypedBody>.with<bool>(&typed, fn(checked: &TypedBody) -> bool {
      return embeddedU8(checked, magnitude) == usize.ONE
    })
  }
  return false
}

// The same two operations `silk.reflect` declares.
fn reflectionWrapperText() -> string<'static> {
  return """pub struct Reflect {}
impl Reflect {
  pub static fn typeOf<Owner>() -> Intrinsic.Type<Owner> {
    return Intrinsic.reflectType<Owner>()
  }
  pub static fn typeKind<Owner>(descriptor: Intrinsic.Type<Owner>) -> u8 {
    return Intrinsic.reflectTypeKind<Owner>(descriptor)
  }
}
"""
}

// Publishes the reflection wrapper module and one program module importing it.
effect fn reflectionRevision(id: &ModuleId, source: string<'static>) -> Revision
! InvalidModulePath | OutOfMemoryError
? &mut Allocator {
  let wrapper = run module("reflection.silk")
  let wrapperSource = run present(reflectionWrapperText())
  let authored = run present(source)
  let withWrapper = run Revision.publish(&Revision.make(), &wrapper, &wrapperSource)
  return run Revision.publish(&withWrapper, id, &authored)
}

effect fn selectedReflectionClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("b12-selected-reflection.silk")
  let source = """import reflection { Reflect }
struct Named { value: i32 }
tuple Pair(i32, i32)
fn weight<T>() -> i32 {
  static if Reflect.typeKind<T>(Reflect.typeOf<T>()) == Reflect.typeKind<Named>(Reflect.typeOf<Named>()) {
    return 40
  } else {
    return 2
  }
}
"""
  let revision = run reflectionRevision(&id, source)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let weightDeclaration = run requireIndexedIdentity(&mut index, &id, OwnerKind.Function, b"weight", usize.ZERO)
  let named = run requireIndexedIdentity(&mut index, &id, OwnerKind.Struct, b"Named", usize.ZERO)
  let pair = run requireIndexedIdentity(&mut index, &id, OwnerKind.Tuple, b"Pair", usize.ZERO)
  let mut namedArguments = Vector<Argument>.make()
  run Vector<Argument>.append(&mut namedArguments, Argument.Type {value: run Types.intern(Type.Nominal {declaration: move named, isPublic: false, arguments: Vector<Argument>.make()})})
  let weightNamed = run specializationWithArguments(&weightDeclaration, move namedArguments)
  let mut pairArguments = Vector<Argument>.make()
  run Vector<Argument>.append(&mut pairArguments, Argument.Type {value: run Types.intern(Type.Nominal {declaration: move pair, isPublic: false, arguments: Vector<Argument>.make()})})
  let weightPair = run specializationWithArguments(&weightDeclaration, move pairArguments)
  let mut store = makeSemantic(run Revision.copy(&revision))
  let mut request = Request.make()
  let selectedNamed = run Semantic.demandSelectedBody(&mut store, &mut request, &weightNamed)
  let selectedPair = run Semantic.demandSelectedBody(&mut store, &mut request, &weightPair)
  let fortyStart = offsetOf(source, "40", usize.ZERO)
  let twoStart = offsetOf(source, "return 2", usize.ZERO) + 7
  let namedArm = run selectedLiterals(&mut store, &selectedNamed, fortyStart, twoStart)
  let pairArm = run selectedLiterals(&mut store, &selectedPair, twoStart, fortyStart)
  run Testing.expect(namedArm && pairArm,
    "one generic body selects a different static arm for each type argument's reflected kind")
  return ()
}

test effect fn reflectedKindCodesMatchTheLibrary() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run reflectionCodeClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn reflectionCodeClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("b12-reflection-codes.silk")
  let source = """import reflection { Reflect }
struct Named { value: i32 }
tuple Pair(i32, i32)
fn namedCode() -> u8 { return Reflect.typeKind<Named>(Reflect.typeOf<Named>()) }
fn pairCode() -> u8 { return Reflect.typeKind<Pair>(Reflect.typeOf<Pair>()) }
fn scalarCode() -> u8 { return Reflect.typeKind<i32>(Reflect.typeOf<i32>()) }
"""
  let revision = run reflectionRevision(&id, source)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let namedCode = run selectedApplicationOf(&mut index, &id, b"namedCode")
  let pairCode = run selectedApplicationOf(&mut index, &id, b"pairCode")
  let scalarCode = run selectedApplicationOf(&mut index, &id, b"scalarCode")
  let wrapperText = reflectionWrapperText()
  let mut store = makeSemantic(run Revision.copy(&revision))
  let mut request = Request.make()
  let namedSelected = run Semantic.demandSelectedBody(&mut store, &mut request, &namedCode)
  let pairSelected = run Semantic.demandSelectedBody(&mut store, &mut request, &pairCode)
  let codes = selectedU8(&namedSelected, 0) && selectedU8(&pairSelected, usize.toU64(usize.ONE))
  run Testing.expect(codes, "reflected kind codes match silk.reflect: a named struct is 0 and a positional tuple is 1")
  let scalarSelected = run Semantic.demandSelectedBody(&mut store, &mut request, &scalarCode)
  let scalarStart = offsetOf(wrapperText, "Intrinsic.reflectTypeKind<Owner>", usize.ZERO)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&scalarSelected, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return unsupportedKindAt(answer, scalarStart)
    }), "a non-aggregate owner has no kind code: an Unsupported static evaluation at the reflection call, never a fallback code")
  return ()
}

test effect fn reflectedDescriptorsStayOutOfRuntimeCode() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run reflectionBoundaryClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn reflectionBoundaryClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("b12-reflection-boundaries.silk")
  let source = """import reflection { Reflect }
struct Named { value: i32 }
fn leak() -> Intrinsic.Type<Named> { return missing }
fn hold(descriptor: Intrinsic.Type<Named>) -> i32 { return 0 }
fn embeds() -> i32 {
  let leaked = Reflect.typeOf<Named>()
  return 0
}
fn direct() -> i32 {
  let described = Intrinsic.reflectType<Named>()
  return 0
}
fn directKind() -> u8 { return Intrinsic.reflectTypeKind<Named>(Intrinsic.reflectType<Named>()) }
"""
  let revision = run reflectionRevision(&id, source)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let leakDeclaration = run requireIndexedIdentity(&mut index, &id, OwnerKind.Function, b"leak", usize.ZERO)
  let holdDeclaration = run requireIndexedIdentity(&mut index, &id, OwnerKind.Function, b"hold", usize.ZERO)
  let embeds = run selectedApplicationOf(&mut index, &id, b"embeds")
  let mut store = makeSemantic(run Revision.copy(&revision))
  let mut request = Request.make()
  let leakSignature = run Semantic.demandSignatureOf(&mut store, &mut request, &leakDeclaration)
  let holdSignature = run Semantic.demandSignatureOf(&mut store, &mut request, &holdDeclaration)
  // The violation anchors at the authored phase-only type, not at the declaration.
  let leakStart = offsetOf(source, "Intrinsic.Type<Named>", usize.ZERO)
  let holdStart = offsetOf(source, "Intrinsic.Type<Named>", usize.ONE)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&leakSignature, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionAt(answer, RejectionCode.StaticPhaseViolation, leakStart)
    }) && Shared<Result<Answer, NoRejection>>.with<bool>(&holdSignature, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionAt(answer, RejectionCode.StaticPhaseViolation, holdStart)
    }), "a runtime signature cannot return or accept a phase-only descriptor")
  let embedded = run Semantic.demandSelectedBody(&mut store, &mut request, &embeds)
  let embedStart = offsetOf(source, "Reflect.typeOf<Named>()", usize.ZERO)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&embedded, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionAt(answer, RejectionCode.StaticPhaseViolation, embedStart)
    }), "a descriptor reaching runtime code through selection is a static phase violation")
  let direct = run Semantic.demandBody(&mut store, &mut request, &id, b"direct")
  let directStart = offsetOf(source, "Intrinsic.reflectType<Named>()", usize.ZERO)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&direct, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionAt(answer, RejectionCode.StaticPhaseViolation, directStart)
    }), "a reflection intrinsic called by a runtime body is a static phase violation at the call")
  let directKind = run Semantic.demandBody(&mut store, &mut request, &id, b"directKind")
  let directKindStart = offsetOf(source, "Intrinsic.reflectTypeKind<Named>", usize.ZERO)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&directKind, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionAt(answer, RejectionCode.StaticPhaseViolation, directKindStart)
    }), "a runtime kind reflection is a static phase violation at its own call, before its argument")
  return ()
}

test effect fn internedIdentityHashesFollowEquality() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run internedIdentityHashClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// Hashed interning compares only entries recorded under the probe's hash, so equal values must
// share one: lifetime-distinct borrows are one runtime layout type. Colliding entries are
// presented oldest first, as a scan of the table would meet them.
effect fn internedIdentityHashClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let referent = run Types.intern(Type.Primitive {name: run Bytes.copy(b"i32")})
  let lasting = run Types.intern(Type.Reference {referent: Shared<Type>.clone(&referent), access: Access.Shared,
    lifetime: run Shared<Lifetime>.make(Lifetime.Static)})
  let fresh = run Types.intern(Type.Reference {referent: Shared<Type>.clone(&referent), access: Access.Shared,
    lifetime: run Shared<Lifetime>.make(Lifetime.Invocation {ordinal: usize.ZERO})})
  let runtimeEqual = run Type.runtimeEqualsShared(&lasting, &fresh)
  let exactEqual = run Type.equalsShared(&lasting, &fresh)
  run Testing.expect(runtimeEqual && !exactEqual && Type.hash(&lasting) == Type.hash(&fresh),
    "lifetime-distinct borrows are one runtime type with one hash")
  let mut index = InternIndex.make()
  run InternIndex.record(&mut index, 7)
  run InternIndex.record(&mut index, 9)
  run InternIndex.record(&mut index, 7)
  run InternIndex.record(&mut index, 7)
  let oldest = InternIndex.first(&index, 7)
  let middle = InternIndex.after(&index, oldest)
  let newest = InternIndex.after(&index, middle)
  run Testing.expect(oldest == usize.ZERO && middle == 2 && newest == 3 && InternIndex.after(&index, newest) == usize.MAX
    && InternIndex.first(&index, 9) == usize.ONE && InternIndex.after(&index, usize.ONE) == usize.MAX
    && InternIndex.first(&index, 5) == usize.MAX, "colliding entries are presented oldest first and other hashes stay apart")
  let id = run module("hashed-module-index.silk")
  let source = "fn twice(value: i32) -> i32 { return value }\nfn twice(value: bool) -> bool { return value }\nfn single() -> i32 { return 1 }\n"
  let unit = run SourceUnit.parse(&id, usize.ONE, run Bytes.copy(String.utf8Bytes(source)))
  let moduleIndex = run ModuleIndex.build(&unit, false)
  let declarations = ModuleIndex.listDeclarations(&moduleIndex)
  run Testing.expect(SourceUnit.diagnosticCount(&unit) == usize.ZERO && declarations.length == 3,
    "the fixture parses cleanly and indexes its three functions")
  let mut located = true
  let mut at = usize.ZERO
  while at < declarations.length {
    if let Option<usize>.Some {value: found} = move ModuleIndex.ordinalOf(&moduleIndex, &declarations[at].identity) {
      located = located && found == at
    } else {
      located = false
    }
    at = at + usize.ONE
  }
  run Testing.expect(located && declarations[usize.ZERO].ambiguous && declarations[usize.ONE].ambiguous
    && !declarations[2].ambiguous, "every declaration is found at its own ordinal and only same-key siblings are ambiguous")
  let firstTop = ModuleIndex.firstEnclosed(&moduleIndex, usize.MAX)
  let secondTop = ModuleIndex.nextEnclosed(&moduleIndex, firstTop)
  let thirdTop = ModuleIndex.nextEnclosed(&moduleIndex, secondTop)
  let localFound = match move ModuleIndex.ordinalAtLocal(&moduleIndex, declarations[usize.ONE].local) {
    Option<usize>.Some {value} => value == usize.ONE
    Option<usize>.None => false
  }
  run Testing.expect(firstTop == usize.ZERO && secondTop == usize.ONE && thirdTop == 2
    && ModuleIndex.nextEnclosed(&moduleIndex, thirdTop) == usize.MAX
    && ModuleIndex.firstEnclosed(&moduleIndex, usize.ZERO) == usize.MAX && localFound,
    "module-level declarations enclose in source order, a function without nested declarations encloses none, and local nodes find their declarations")
  let collisions = ModuleIndex.listCollisions(&moduleIndex)
  let mut twiceMembers = usize.ZERO
  if let Option<Shared<NameObservation>>.Some {value: bucket} = move ModuleIndex.cachedName(&moduleIndex, b"twice") {
    twiceMembers = Shared<NameObservation>.with<usize>(&bucket, fn(observed: &NameObservation) -> usize {
      return NameObservation.listMembers(observed).length
    })
  }
  let missing = match move ModuleIndex.cachedName(&moduleIndex, b"thrice") {
    Option<Shared<NameObservation>>.Some {..} => false
    Option<Shared<NameObservation>>.None => true
  }
  run Testing.expect(collisions.length == usize.ONE && collisions[usize.ZERO].first == usize.ZERO
    && collisions[usize.ZERO].second == usize.ONE && twiceMembers == 2 && missing,
    "same-name bindings collide once and their cached bucket holds both while an absent name has none")
  return ()
}

test effect fn selectedBodiesRetainExactDemandsAcrossRuntimeFamilies() -> ()
! CanonicalizationFailure | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run selectedCorrespondenceClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// An erased family never skips exact selected-body validation. Complete recipe sharing occurs
// only after closing MIR; these body-lazy demands prove the earlier semantic boundary.
effect fn selectedCorrespondenceClaims() -> ()
! CanonicalizationFailure | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("b12-selected-correspondence.silk")
  let source = """
static fn amount(base: i32) -> i32 { return base * 10 + 1 }
fn tagged<'a>(value: &'a i32) -> i32 {
  let static scaled = amount(2)
  static if true {
    return scaled
  }
  return 0
}
fn site(value: &i32) -> i32 { return 0 }
"""
  let authored = run present(source)
  let revision = run Revision.publish(&Revision.make(), &id, &authored)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let tagged = run requireIndexedIdentity(&mut index, &id, OwnerKind.Function, b"tagged", usize.ZERO)
  let site = run requireIndexedIdentity(&mut index, &id, OwnerKind.Function, b"site", usize.ZERO)
  let mut staticArguments = Vector<Argument>.make()
  run Vector<Argument>.append(&mut staticArguments, Argument.Lifetime {value: run Shared<Lifetime>.make(Lifetime.Static)})
  let first = run specializationWithArguments(&tagged, move staticArguments)
  let mut siteArguments = Vector<Argument>.make()
  run Vector<Argument>.append(&mut siteArguments, Argument.Lifetime {value: run Shared<Lifetime>.make(Lifetime.Parameter {
    declaration: move site, ordinal: usize.ZERO,
  })})
  let second = run specializationWithArguments(&tagged, move siteArguments)
  let firstKey = run requiredCanonicalKey(run InstanceKey.function(run SpecializationApplication.copy(&first)))
  let secondKey = run requiredCanonicalKey(run InstanceKey.function(run SpecializationApplication.copy(&second)))
  run Testing.expect(InstanceKey.sameRuntimeBase(&firstKey, &secondKey) && !run SpecializationApplication.equals(&first, &second),
    "two lifetime-distinct semantic applications belong to one erased runtime family")
  let firstCopy = run SpecializationApplication.copy(&first)
  let copiedEqual = run SpecializationApplication.equals(&first, &firstCopy)
  run Testing.expect(InstanceKey.runtimeHash(&firstKey) == InstanceKey.runtimeHash(&secondKey) && copiedEqual
    && SpecializationApplication.hash(&first) == SpecializationApplication.hash(&firstCopy),
    "hashed instance and application lookups find one runtime family and one exact application")
  let mut store = makeSemantic(run Revision.copy(&revision))
  let mut request = Request.make()
  let bodies = starts(Semantic.eventLog(&store), Family.Body)
  let firstMir = run Semantic.demandApplicationMir(&mut store, &mut request, &first)
  let mut secondRequest = Request.make()
  let secondMir = run Semantic.demandApplicationMir(&mut store, &mut secondRequest, &second)
  run Testing.expect(succeeded(&firstMir) && succeeded(&secondMir) && starts(Semantic.eventLog(&store), Family.Body) == bodies + 2
    && assignsInteger(&store, &firstMir, b"21") && assignsInteger(&store, &secondMir, b"21"),
    "each exact application lowers its selected body and independently embeds the static helper's value 21")
  return ()
}

test effect fn staticParametersSelectInstancesAndKeepRuntimeLanes() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run staticParameterClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// The reference a lowered function makes to an instance of `callee`, if any.
fn referenceTo(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, callee: &DeclarationId) -> Option<InstanceKey> {
  let index = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: at} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, at) {
      let references = Vector<MirReference>.asSlice(&function.references)
      let mut reference = usize.ZERO
      while reference < references.length {
        let identity = InstanceKey.identity(&references[reference].key)
        if Shared<DeclarationId>.with<bool>(&identity, fn(found: &DeclarationId) -> bool { return DeclarationId.equals(found, callee) }) {
          return Option<InstanceKey>.some(InstanceKey.copy(&references[reference].key))
        }
        reference = reference + usize.ONE
      }
    }
  }
  return Option<InstanceKey>.none()
}

// Whether any statement of a lowered function satisfies `check`.
fn anyMirStatement(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, check: fn(&MirStatement) -> bool) -> bool {
  let index = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: at} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, at) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut blockAt = usize.ZERO
      while blockAt < blocks.length {
        let statements = Vector<MirStatement>.asSlice(&blocks[blockAt].statements)
        let mut statementAt = usize.ZERO
        while statementAt < statements.length {
          if check(&statements[statementAt]) { return true }
          statementAt = statementAt + usize.ONE
        }
        blockAt = blockAt + usize.ONE
      }
    }
  }
  return false
}

// Whether a lowered function assigns a two-field aggregate of exactly these integer literals, in
// canonical field order: a static array materialized at its use.
fn materializesIntegerPair(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, first: &[u8], second: &[u8]) -> bool {
  return anyMirStatement(
    store,
    answer,
    fn(statement: &MirStatement) -> bool {
      if let MirStatement.Assign {value: MirRvalue.Aggregate {fields}, ..} = &statement.* {
        let listed = Vector<MirAggregateField>.asSlice(&fields)
        return listed.length == 2 && listed[usize.ZERO].index == usize.ZERO && listed[usize.ONE].index == usize.ONE
          && integerOperand(&listed[usize.ZERO].value, first) && integerOperand(&listed[usize.ONE].value, second)
      }
      return false
    },
  )
}

// Whether a lowered function assigns exactly this integer literal: an embedded enum value.
fn assignsInteger(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, text: &[u8]) -> bool {
  return anyMirStatement(
    store,
    answer,
    fn(statement: &MirStatement) -> bool {
      if let MirStatement.Assign {value: MirRvalue.Use {value}, ..} = &statement.* {
        return integerOperand(&value, text)
      }
      return false
    },
  )
}

fn mirParameterCount(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> usize {
  let index = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: at} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, at) {
      return Vector<Shared<Type>>.length(&function.parameters)
    }
  }
  return usize.MAX
}

// Source arity and the original static slot indices of one resolved signature.
fn signatureShape(answer: &Result<Answer, NoRejection>, arity: usize, slot: usize) -> bool {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome {
      let slots = Vector<usize>.asSlice(&signature.staticSlots)
      return Vector<Shared<Type>>.length(&signature.parameters) == arity && slots.length == usize.ONE && slots[usize.ZERO] == slot
    }
  }
  return false
}

// Whether a key's application carries exactly one static integer of `ty` at `ordinal`.
effect fn keyStaticInteger(key: &InstanceKey, ordinal: usize, ty: StaticIntegerType, magnitude: u64) -> bool ! OutOfMemoryError ? &mut Allocator {
  let application = run InstanceKey.selected(key)
  let slots = Vector<StaticSlot>.asSlice(&application.statics)
  if slots.length != usize.ONE || slots[usize.ZERO].ordinal != ordinal { return false }
  return Shared<StaticData>.with<bool>(&slots[usize.ZERO].value, fn(data: &StaticData) -> bool {
    return match & data.* {
      StaticData.Integer {ty: found, sign, magnitude: amount} => found == ty && sign == StaticSign.Positive && amount == magnitude
      _ => false
    }
  })
}

// STATIC-009: a struct or tuple may hold a phase-only field, and a type that holds one at any depth
// stays static. A runtime parameter or result of such a type is a static phase violation at its
// authored type, and a static value of it cannot be embedded in a runtime body; the same struct in a
// static function's contract is accepted. Lifetimes never decide the answer, so signatures whose
// types differ only in regions share one walk and still reject at their own authored types.
test effect fn phaseOnlyFieldsStayStatic() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run phaseOnlyFieldClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn phaseOnlyFieldClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("phase-only-fields.silk")
  let source = """struct Plan { parts: Intrinsic.StaticSequence<i32> mode: i32 }
struct Outer { inner: Plan }
tuple Pair(Plan)
struct GenericPlan<T> { parts: Intrinsic.StaticSequence<T> }
struct Plain { value: i32 }
struct Recursive<'a> { next: &'a Recursive<'a> }
static fn make() -> Plan { return Plan { parts: Intrinsic.staticSequenceEmpty<i32>(), mode: 1 } }
fn read(input: Plan) -> i32 { return 1 }
fn give() -> Plan { return make() }
fn nested(wrapped: Outer) -> i32 { return 1 }
fn bind() -> i32 { let held = make() return 0 }
effect fn failPlan() -> i32 ! Plan { return 0 }
fn tupleInput(pair: Pair) -> i32 { return 0 }
fn genericInput<T>(generic: GenericPlan<T>) -> i32 { return 0 }
fn ordinary(plain: Plain) -> i32 { return 0 }
fn recursive<'a>(recursive: Recursive<'a>) -> i32 { return 0 }
fn borrowedFirst<'a>(first: &'a Plan) -> i32 { return 0 }
fn borrowedSecond<'b>(second: &'b Plan) -> i32 { return 0 }
"""
  let authored = run present(source)
  let revision = run Revision.publish(&Revision.make(), &id, &authored)
  let mut store = makeSemantic(run Revision.copy(&revision))
  let mut request = Request.make()
  let borrowedFirst = run Semantic.demandSignature(&mut store, &mut request, &id, b"borrowedFirst")
  let walks = starts(Semantic.eventLog(&store), Family.PhaseOnly)
  let borrowedSecond = run Semantic.demandSignature(&mut store, &mut request, &id, b"borrowedSecond")
  run Testing.expect(walks != usize.ZERO && starts(Semantic.eventLog(&store), Family.PhaseOnly) == walks
    && Shared<Result<Answer, NoRejection>>.with<bool>(&borrowedFirst, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionAt(answer, RejectionCode.StaticPhaseViolation, offsetOf(source, "first: &'a Plan", usize.ZERO) + 7)
    }) && Shared<Result<Answer, NoRejection>>.with<bool>(&borrowedSecond, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionAt(answer, RejectionCode.StaticPhaseViolation, offsetOf(source, "second: &'b Plan", usize.ZERO) + 8)
    }), "types that differ only in regions share one phase walk and reject at each authored type")
  let identity = run Semantic.demandIdentity(&mut store, &mut request, &id, b"Plan")
  let mut shaped = false
  let nominal = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&identity, nominalResult)
  if let Option<Shared<Type>>.Some {value: applied} = move nominal {
    let parts = run Semantic.demandMemberShape(&mut store, &mut request, &id, b"Plan", usize.ZERO, &applied)
    shaped = succeeded(&parts)
  }
  run Testing.expect(shaped, "a struct field may hold a phase-only sequence")
  let maker = run Semantic.demandSignature(&mut store, &mut request, &id, b"make")
  run Testing.expect(succeeded(&maker), "a static function may return a struct that holds a phase-only field")
  let read = run Semantic.demandSignature(&mut store, &mut request, &id, b"read")
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&read, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return rejectionAt(answer, RejectionCode.StaticPhaseViolation, offsetOf(source, "input: Plan", usize.ZERO) + 7)
  }), "a runtime parameter cannot hold a struct with a phase-only field")
  let give = run Semantic.demandSignature(&mut store, &mut request, &id, b"give")
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&give, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return rejectionAt(answer, RejectionCode.StaticPhaseViolation, offsetOf(source, "-> Plan { return make", usize.ZERO) + 3)
  }), "a runtime result cannot be a struct with a phase-only field")
  let nested = run Semantic.demandSignature(&mut store, &mut request, &id, b"nested")
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&nested, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return rejectionAt(answer, RejectionCode.StaticPhaseViolation, offsetOf(source, "wrapped: Outer", usize.ZERO) + 9)
  }), "a phase-only field is found through a nested struct")
  let failed = run Semantic.demandSignature(&mut store, &mut request, &id, b"failPlan")
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&failed, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return rejectionAt(answer, RejectionCode.StaticPhaseViolation, offsetOf(source, "! Plan", usize.ZERO) + 2)
  }), "a runtime failure cannot hold a phase-only field")
  let pair = run Semantic.demandSignature(&mut store, &mut request, &id, b"tupleInput")
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&pair, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return rejectionAt(answer, RejectionCode.StaticPhaseViolation, offsetOf(source, "pair: Pair", usize.ZERO) + 6)
  }), "a phase-only field is found through a tuple")
  let generic = run Semantic.demandSignature(&mut store, &mut request, &id, b"genericInput")
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&generic, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return rejectionAt(answer, RejectionCode.StaticPhaseViolation, offsetOf(source, "generic: GenericPlan", usize.ZERO) + 9)
  }), "an open generic application retains phase-only fields")
  let ordinary = run Semantic.demandSignature(&mut store, &mut request, &id, b"ordinary")
  run Testing.expect(succeeded(&ordinary), "a runtime struct with ordinary fields remains valid")
  let recursive = run Semantic.demandSignature(&mut store, &mut request, &id, b"recursive")
  run Testing.expect(succeeded(&recursive), "recursive runtime fields terminate the phase scan")
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let binding = run selectedApplicationOf(&mut index, &id, b"bind")
  let bind = run Semantic.demandSelectedBody(&mut store, &mut request, &binding)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&bind, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return rejectionAt(answer, RejectionCode.StaticPhaseViolation, offsetOf(source, "make() return 0", usize.ZERO))
  }), "a static result holding a phase-only field cannot be embedded in a runtime body")
  return ()
}

effect fn staticParameterClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("b12-static-parameters.silk")
  let source = """fn scaled(static factor: i32, value: i32) -> i32 { return factor * value }
fn twice(value: i32) -> i32 { return scaled(2, value) }
fn thrice(value: i32) -> i32 { return scaled(3, value) }
fn again(value: i32) -> i32 { return scaled(2, value) + 1 }
fn wrongKind(value: i32) -> i32 { return scaled(true, value) }
fn runtimeOperand(value: i32) -> i32 { return scaled(value, value) }
fn counted(static count: usize, value: i32) -> i32 { return value }
fn sized(value: i32) -> i32 { return counted(2, value) }
struct Box {}
impl Box { fn scaledBy(self: Self, static factor: i32, value: i32) -> i32 { return value } }
fn viaMethod(box: Box, value: i32) -> i32 { return box.scaledBy(2, value) }
"""
  let authored = run present(source)
  let revision = run Revision.publish(&Revision.make(), &id, &authored)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let wrongKind = run selectedApplicationOf(&mut index, &id, b"wrongKind")
  let runtimeOperand = run selectedApplicationOf(&mut index, &id, b"runtimeOperand")
  let mut store = makeSemantic(run Revision.copy(&revision))
  let mut request = Request.make()
  let twiceMir = run Semantic.demandMir(&mut store, &mut request, &id, b"twice")
  run Testing.expect(succeeded(&twiceMir) && starts(Semantic.eventLog(&store), Family.Body) == usize.ONE,
    "a caller's selected body supplies the static argument and lowers without demanding the callee's body")
  let thriceMir = run Semantic.demandMir(&mut store, &mut request, &id, b"thrice")
  let againMir = run Semantic.demandMir(&mut store, &mut request, &id, b"again")
  let twiceKey = soleReference(&store, &twiceMir)
  let thriceKey = soleReference(&store, &thriceMir)
  let againKey = soleReference(&store, &againMir)
  let mut distinct = false
  let mut reused = false
  let mut slotted = false
  let mut calleeLanes = false
  let mut calleeEmbeds = false
  if let Option<InstanceKey>.Some {value: two} = &twiceKey {
    if let Option<InstanceKey>.Some {value: three} = &thriceKey {
      distinct = !InstanceKey.sameRuntimeBase(&two, &three) && run keyStaticInteger(&three, usize.ZERO, StaticIntegerType.I32, 3)
    }
    if let Option<InstanceKey>.Some {value: repeated} = &againKey {
      reused = InstanceKey.sameRuntimeBase(&two, &repeated)
    }
    slotted = run keyStaticInteger(&two, usize.ZERO, StaticIntegerType.I32, 2)
    let callee = run InstanceKey.selected(&two)
    let calleeMir = run Semantic.demandApplicationMir(&mut store, &mut request, &callee)
    calleeLanes = succeeded(&calleeMir) && mirParameterCount(&store, &calleeMir) == usize.ONE
    let calleeBody = run Semantic.demandSelectedBody(&mut store, &mut request, &callee)
    let typed = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&calleeBody, checkedBody)
    if let Option<Shared<TypedBody>>.Some {value: body} = move typed {
      calleeEmbeds = Shared<TypedBody>.with<usize>(&body, fn(checked: &TypedBody) -> usize { return embeddedI32(checked, 2) }) == usize.ONE
    }
  }
  run Testing.expect(slotted, "the call's instance carries the static value 2 at its original parameter index 0")
  run Testing.expect(distinct && reused, "factors 2 and 3 select distinct instances; the same factor reuses one")
  run Testing.expect(calleeLanes, "the selected callee lowers one runtime lane for its one runtime parameter")
  run Testing.expect(calleeEmbeds, "the callee reads its static parameter as an embedded constant, with no local")
  let scaledSignature = run signatureNamed(&mut store, &mut request, &mut index, &id, b"scaled", usize.ZERO)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&scaledSignature, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return signatureShape(answer, 2, usize.ZERO)
    }), "source arity keeps both parameters and records the static one at its original index")
  let wrong = run Semantic.demandSelectedBody(&mut store, &mut request, &wrongKind)
  let wrongStart = offsetOf(source, "true", usize.ZERO)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&wrong, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionAt(answer, RejectionCode.TypeMismatch, wrongStart)
    }), "a static argument of the wrong kind is a type mismatch at the argument")
  let operand = run Semantic.demandSelectedBody(&mut store, &mut request, &runtimeOperand)
  let operandStart = offsetOf(source, "scaled(value", usize.ZERO) + 7
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&operand, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionAt(answer, RejectionCode.StaticPhaseViolation, operandStart)
    }), "a runtime operand in a static slot is a static phase violation at the operand")
  let sizedMir = run Semantic.demandMir(&mut store, &mut request, &id, b"sized")
  let sizedKey = soleReference(&store, &sizedMir)
  let mut usizeSlot = false
  if let Option<InstanceKey>.Some {value: counted} = &sizedKey {
    usizeSlot = run keyStaticInteger(&counted, usize.ZERO, StaticIntegerType.Usize, 2)
  }
  run Testing.expect(succeeded(&sizedMir) && usizeSlot,
    "a static argument is checked as its declared type: 2 for a usize slot is a usize value")
  let method = run Semantic.demandBody(&mut store, &mut request, &id, b"viaMethod")
  let methodStart = offsetOf(source, "box.scaledBy", usize.ZERO)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&method, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionAt(answer, RejectionCode.Unsupported, methodStart)
    }), "a receiver call cannot supply static arguments yet: an explicit gap at the call, not a dropped value")
  return ()
}

test effect fn staticAggregatesMaterializeAndSelectInstances() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run staticAggregateClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn staticAggregateClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("b12-static-aggregates.silk")
  let source = """fn tabled(static table: [i32; 2], index: usize) -> i32 {
  let local = table
  return local[index]
}
fn second(index: usize) -> i32 { return tabled([4, 5], index) }
fn secondAgain(index: usize) -> i32 { return tabled([4, 5], index) + 1 }
fn short(index: usize) -> i32 { return tabled([4], index) }
struct Pair { left: i32 }
impl Intrinsic.Drop for Pair { fn drop(self: &mut Pair) -> () { return () } }
fn paired(static items: [Pair; 1]) -> i32 { return 0 }
fn records() -> i32 { return paired([Pair { left: 1 }]) }
enum Mode { Fast, Slow }
fn moded(static mode: Mode) -> Mode { return mode }
fn slow() -> Mode { return moded(Mode.Slow) }
fn fast() -> Mode { return moded(Mode.Fast) }
fn localArray(index: usize) -> i32 {
  let static table = [7, 8]
  let local = table
  return local[index]
}
"""
  let authored = run present(source)
  let revision = run Revision.publish(&Revision.make(), &id, &authored)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let tabledDeclaration = run requireIndexedIdentity(&mut index, &id, OwnerKind.Function, b"tabled", usize.ZERO)
  let modedDeclaration = run requireIndexedIdentity(&mut index, &id, OwnerKind.Function, b"moded", usize.ZERO)
  let shortCaller = run selectedApplicationOf(&mut index, &id, b"short")
  let recordsCaller = run selectedApplicationOf(&mut index, &id, b"records")
  let mut store = makeSemantic(run Revision.copy(&revision))
  let mut request = Request.make()
  let secondMir = run Semantic.demandMir(&mut store, &mut request, &id, b"second")
  let againMir = run Semantic.demandMir(&mut store, &mut request, &id, b"secondAgain")
  let secondKey = referenceTo(&store, &secondMir, &tabledDeclaration)
  let againKey = referenceTo(&store, &againMir, &tabledDeclaration)
  let referencesCallee = match &secondKey {
    Option<InstanceKey>.Some {..} => true
    Option<InstanceKey>.None => false
  }
  run Testing.expect(succeeded(&secondMir) && referencesCallee, "a caller passing a static array lowers and references its selected callee")
  let mut calleeLowers = false
  let mut embedsArray = false
  let mut sharesArray = false
  if let Option<InstanceKey>.Some {value: key} = &secondKey {
    let callee = run InstanceKey.selected(&key)
    let calleeMir = run Semantic.demandApplicationMir(&mut store, &mut request, &callee)
    calleeLowers = succeeded(&calleeMir)
    embedsArray = materializesIntegerPair(&store, &calleeMir, b"4", b"5")
    if let Option<InstanceKey>.Some {value: repeated} = &againKey { sharesArray = InstanceKey.sameRuntimeBase(&key, &repeated) }
  }
  run Testing.expect(calleeLowers, "the selected callee reading a static array lowers without a gap")
  run Testing.expect(embedsArray, "the selected callee materializes the static array [4, 5] as an aggregate of its integer fields")
  run Testing.expect(sharesArray, "equal static arrays select one shared instance")
  let slowMir = run Semantic.demandMir(&mut store, &mut request, &id, b"slow")
  let fastMir = run Semantic.demandMir(&mut store, &mut request, &id, b"fast")
  let slowKey = referenceTo(&store, &slowMir, &modedDeclaration)
  let fastKey = referenceTo(&store, &fastMir, &modedDeclaration)
  let mut embedsEnum = false
  let mut distinctEnums = false
  if let Option<InstanceKey>.Some {value: key} = &slowKey {
    let callee = run InstanceKey.selected(&key)
    let calleeMir = run Semantic.demandApplicationMir(&mut store, &mut request, &callee)
    embedsEnum = succeeded(&calleeMir) && assignsInteger(&store, &calleeMir, b"1")
    if let Option<InstanceKey>.Some {value: other} = &fastKey { distinctEnums = !InstanceKey.sameRuntimeBase(&key, &other) }
  }
  run Testing.expect(embedsEnum, "the selected callee materializes Mode.Slow as its representation integer 1")
  run Testing.expect(distinctEnums, "Mode.Slow and Mode.Fast select distinct instances")
  let localMir = run Semantic.demandMir(&mut store, &mut request, &id, b"localArray")
  run Testing.expect(succeeded(&localMir) && materializesIntegerPair(&store, &localMir, b"7", b"8"),
    "a static local array is constructed in its static root and materialized at its runtime use")
  let shortBody = run Semantic.demandSelectedBody(&mut store, &mut request, &shortCaller)
  let shortStart = offsetOf(source, "[4]", usize.ZERO)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&shortBody, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionAt(answer, RejectionCode.ArrayLengthMismatch, shortStart)
    }), "a static array argument of the wrong length is an array length mismatch at the argument")
  let recordsBody = run Semantic.demandSelectedBody(&mut store, &mut request, &recordsCaller)
  let recordStart = offsetOf(source, "Pair { left: 1 }", usize.ZERO)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&recordsBody, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionAt(answer, RejectionCode.StaticViolation, recordStart)
    }), "a static array element whose struct a sealed Drop names is a static violation at the element")
  return ()
}

// Whether a lowered function assigns a negative integer operand with exactly these magnitude digits.
fn assignsNegativeInteger(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, text: &[u8]) -> bool {
  return anyMirStatement(
    store,
    answer,
    fn(statement: &MirStatement) -> bool {
      if let MirStatement.Assign {value: MirRvalue.Use {value: MirOperand.Integer {decimal, negative, ..}}, ..} = &statement.* {
        return negative && sameBytes(Bytes.asSlice(&decimal), text)
      }
      return false
    },
  )
}

// Whether a lowered function assigns a float operand with exactly these MIR (f64-widened) bits.
fn assignsFloat(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, bits: u64) -> bool {
  return anyMirStatement(
    store,
    answer,
    fn(statement: &MirStatement) -> bool {
      if let MirStatement.Assign {value: MirRvalue.Use {value: MirOperand.Float {bits: actual, ..}}, ..} = &statement.* {
        return actual == bits
      }
      return false
    },
  )
}

// Whether a lowered function builds a text descriptor over exactly these program-lifetime bytes.
fn assignsStaticText(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, text: &[u8], count: &[u8]) -> bool {
  return anyMirStatement(
    store,
    answer,
    fn(statement: &MirStatement) -> bool {
      if let MirStatement.Assign {value: MirRvalue.Slice {data: MirOperand.StaticBytes {bytes}, count: length}, ..} = &statement.* {
        return sameBytes(Bytes.asSlice(&bytes), text) && integerOperand(&length, count)
      }
      return false
    },
  )
}

test effect fn runtimeConstantReadsLowerToPublishedValues() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run runtimeConstantClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn runtimeConstantClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("runtime-constants.silk")
  let text = """const limit: u8 = 255
const least: i8 = -128
const half: f32 = 1.5
const greeting: string<'static> = "hi"
fn byte() -> u8 { return limit }
fn minimum() -> i8 { return least }
fn ratio() -> f32 { return half }
fn greet() -> string<'static> { return greeting }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let byte = run Semantic.demandMir(&mut store, &mut request, &id, b"byte")
  let minimum = run Semantic.demandMir(&mut store, &mut request, &id, b"minimum")
  let ratio = run Semantic.demandMir(&mut store, &mut request, &id, b"ratio")
  let greet = run Semantic.demandMir(&mut store, &mut request, &id, b"greet")
  run Testing.expect(succeeded(&byte) && assignsInteger(&store, &byte, b"255")
    && succeeded(&minimum) && assignsNegativeInteger(&store, &minimum, b"128"),
    "integer constant reads lower to their exact published magnitude and sign")
  run Testing.expect(succeeded(&ratio) && assignsFloat(&store, &ratio, 0x3FF8000000000000),
    "an f32 constant read widens its published f32 bits exactly to the MIR f64 pattern")
  run Testing.expect(succeeded(&greet) && assignsStaticText(&store, &greet, b"hi", b"2"),
    "a text constant read builds a descriptor over its published bytes")
  return ()
}

// The application of a one-static-parameter fixture function with an i32 value at `ordinal`.
effect fn staticI32Root(index: &mut SourceIndex, id: &ModuleId, name: &[u8], ordinal: usize, magnitude: u64) -> SpecializationApplication
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let mut application = run selectedApplicationOf(&mut index.*, id, name)
  let value = run Shared<StaticData>.make(StaticData.Integer {ty: StaticIntegerType.I32, sign: StaticSign.Positive, magnitude: magnitude})
  run Vector<StaticSlot>.append(&mut application.statics, StaticSlot {ordinal: ordinal, value: move value})
  return move application
}

// A certified closure with exactly this many nodes and edges.
fn certifiedShape(closure: &StaticClosure, nodes: usize, edges: usize) -> bool {
  return match &closure.* {
    StaticClosure.Certified {evidence} => Vector<SpecializationApplication>.length(&evidence.nodes) == nodes && Vector<ClosureEdge>.length(&evidence.edges) == edges
    _ => false
  }
}

fn isWitnessEdge(edge: &SpecializationEdge) -> bool {
  return match &edge.* {
    SpecializationEdge.Witness => true
    _ => false
  }
}

fn certifiedWitnessEdge(closure: &StaticClosure) -> bool {
  if let StaticClosure.Certified {evidence} = &closure.* {
    let edges = Vector<ClosureEdge>.asSlice(&evidence.edges)
    let mut at = usize.ZERO
    while at < edges.length {
      if isWitnessEdge(&edges[at].edge) { return true }
      at = at + usize.ONE
    }
  }
  return false
}

test effect fn finiteStaticChainsCertifyCompleteClosures() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run finiteClosureClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn finiteClosureClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("b12-finite-closure.silk")
  let source = """fn countdown(static n: i32) -> i32 {
  static if n == 0 {
    return 0
  } else {
    return countdown(n - 1)
  }
}
fn ping(static n: i32) -> i32 {
  static if n == 0 {
    return 0
  } else {
    return pong(n - 1)
  }
}
fn pong(static n: i32) -> i32 {
  static if n == 0 {
    return 1
  } else {
    return ping(n - 1)
  }
}
fn toggle(static flag: i32) -> i32 { return toggle(1 - flag) }
"""
  let authored = run present(source)
  let revision = run Revision.publish(&Revision.make(), &id, &authored)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let countdown = run staticI32Root(&mut index, &id, b"countdown", usize.ZERO, 3)
  let ping = run staticI32Root(&mut index, &id, b"ping", usize.ZERO, 3)
  let toggle = run staticI32Root(&mut index, &id, b"toggle", usize.ZERO, 1)
  let mut store = makeSemantic(run Revision.copy(&revision))
  let mut request = Request.make()
  let counted = run Semantic.closeStaticChain(&mut store, &mut request, &countdown, 8)
  run Testing.expect(certifiedShape(&counted, 4, 3), "countdown 3 -> 0 certifies four nodes and three edges")
  let tight = run Semantic.closeStaticChain(&mut store, &mut request, &countdown, 2)
  run Testing.expect(closureRefused(&tight, RejectionCode.StaticRecursionNotProven, 2),
    "the same finite chain is NotProven under an insufficient budget: the budget is not a proof")
  let mutual = run Semantic.closeStaticChain(&mut store, &mut request, &ping, 8)
  run Testing.expect(certifiedShape(&mutual, 4, 3), "a mutual changing-static chain certifies every reached node")
  let cycle = run Semantic.closeStaticChain(&mut store, &mut request, &toggle, 8)
  run Testing.expect(certifiedShape(&cycle, 2, 2), "a two-value static toggle is a finite strongly connected closure")
  return ()
}

test effect fn unclosedStaticChainsStayUnadmitted() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run unclosedClosureClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn unclosedClosureClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("b12-unclosed-closure.silk")
  let source = """fn grow(static n: i32) -> i32 { return grow(n + 1) }
fn hidden(static n: i32, flag: bool) -> i32 {
  if flag {
    return hidden(n, false)
  }
  return hidden(n + 1, flag)
}
fn nested<T>(static n: i32) -> i32 {
  static if n == 0 {
    return 0
  } else {
    return nested<[T; 1]>(n - 1)
  }
}
fn plain(value: i32) -> i32 { return value }
"""
  let authored = run present(source)
  let revision = run Revision.publish(&Revision.make(), &id, &authored)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let grow = run staticI32Root(&mut index, &id, b"grow", usize.ZERO, 0)
  let hidden = run staticI32Root(&mut index, &id, b"hidden", usize.ZERO, 0)
  let nestedDeclaration = run requireIndexedIdentity(&mut index, &id, OwnerKind.Function, b"nested", usize.ZERO)
  let mut nestedArguments = Vector<Argument>.make()
  run Vector<Argument>.append(&mut nestedArguments, Argument.Type {value: run Types.intern(Type.Primitive {name: run Bytes.copy(b"i32")})})
  let mut nested = run specializationWithArguments(&nestedDeclaration, move nestedArguments)
  let two = run Shared<StaticData>.make(StaticData.Integer {ty: StaticIntegerType.I32, sign: StaticSign.Positive, magnitude: 2})
  run Vector<StaticSlot>.append(&mut nested.statics, StaticSlot {ordinal: usize.ZERO, value: move two})
  let mut store = makeSemantic(run Revision.copy(&revision))
  let mut request = Request.make()
  let plainMir = run Semantic.demandMir(&mut store, &mut request, &id, b"plain")
  let mirsBefore = starts(Semantic.eventLog(&store), Family.Mir)
  let growing = run Semantic.closeStaticChain(&mut store, &mut request, &grow, 3)
  run Testing.expect(closureRefused(&growing, RejectionCode.StaticRecursionNotProven, 3),
    "an ever-changing static value is NotProven at the budget with its pending path, never admitted")
  let hiddenGrowth = run Semantic.closeStaticChain(&mut store, &mut request, &hidden, 3)
  run Testing.expect(closureRefused(&hiddenGrowth, RejectionCode.StaticRecursionNotProven, 3),
    "growth in a second runtime arm after a repeated key keeps the closure open")
  let typed = run Semantic.closeStaticChain(&mut store, &mut request, &nested, 8)
  run Testing.expect(closureRefused(&typed, RejectionCode.ExpandingSpecialization, usize.ZERO),
    "a finite static counter does not excuse a growing type argument")
  let mut again = Request.make()
  let mirsAfter = starts(Semantic.eventLog(&store), Family.Mir)
  let plainAgain = run Semantic.demandMir(&mut store, &mut again, &id, b"plain")
  run Testing.expect(succeeded(&plainMir) && succeeded(&plainAgain) && mirsAfter > mirsBefore
      && starts(Semantic.eventLog(&store), Family.Mir) == mirsAfter,
    "failed transactions publish nothing and leave an unrelated cached lowering intact")
  return ()
}

// A refused build whose specialization path starts at `first` and whose related site is the
// changing-static edge that opened the closure transaction, in `opening` at `related`.
// The path is read from its first application outside the runtime that roots the build.
fn buildRefused(built: &BackendBuild, runtime: &ModuleId, code: RejectionCode, first: &DeclarationId, opening: &ModuleId,
  related: usize) -> bool {
  return match &built.* {
    BackendBuild.Rejected {first: diagnostic, ..} => Shared<Rejection>.with<bool>(&diagnostic, fn(found: &Rejection) -> bool {
      let path = Vector<SpecializationApplication>.asSlice(&found.specialization)
      let mut start = usize.ZERO
      while start < path.length
        && ModuleId.equals(DeclarationId.moduleId(SpecializationApplication.bodyDeclaration(&path[start])), runtime) {
        start = start + usize.ONE
      }
      let opened = match &found.related {
        Option<RelatedSite>.Some {value: site} => ModuleId.equals(&site.module, opening) && site.span.start == related
        Option<RelatedSite>.None => false
      }
      return found.code == code && opened && path.length > start + usize.ONE
        && DeclarationId.equals(SpecializationApplication.bodyDeclaration(&path[start]), first)
    })
    _ => false
  }
}

// A build refused as NotProven in `module`, naming the opening edge in `opening` at `start`.
fn refusedAcross(built: &BackendBuild, module: &ModuleId, opening: &ModuleId, start: usize) -> bool {
  return match &built.* {
    BackendBuild.Rejected {first: diagnostic, ..} => Shared<Rejection>.with<bool>(&diagnostic, fn(found: &Rejection) -> bool {
      let opened = match &found.related {
        Option<RelatedSite>.Some {value: site} => ModuleId.equals(&site.module, opening) && site.span.start == start
        Option<RelatedSite>.None => false
      }
      return found.code == RejectionCode.StaticRecursionNotProven && ModuleId.equals(&found.module, module) && opened
    })
    _ => false
  }
}

test effect fn refusedStaticChainsRefuseTheBuild() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run refusedBuildClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn refusedBuildClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("b12-refused-build.silk")
  let source = """union Outcome { Value { value: i32 }, Stop }
fn grow(static n: i32) -> i32 { return grow(n + 1) }
fn spiral(static n: i32, flag: bool) -> Outcome {
  if flag {
    return match move spiral(n + 1, flag) {
      Outcome.Stop => Outcome.Stop
      _ => Outcome.Stop
    }
  }
  return Outcome.Value { value: 0 }
}
pub fn main() -> i32 { return grow(0) }
"""
  let authored = run present(source)
  let revision = run Revision.publish(&Revision.make(), &id, &authored)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let main = run requireIndexedIdentity(&mut index, &id, OwnerKind.Function, b"main", usize.ZERO)
  let spiral = run staticI32Root(&mut index, &id, b"spiral", usize.ZERO, 0)
  let mut store = makeSemantic(run withEntryRuntime(&revision))
  let mut request = Request.forApplication(ModuleId.copy(&id))
  let built = run buildApplication(&mut store, &mut request, 3)
  let runtime = run entryRuntime()
  run Testing.expect(buildRefused(&built, &runtime, RejectionCode.StaticRecursionNotProven, &main, &id, offsetOf(source, "grow(n + 1)", usize.ZERO)),
    "main -> grow(0) refuses the build as NotProven, with the path from main and the opening edge's span")
  // The growing call sits only on the path that returns the failure variant. It is still a lowered
  // successor, so the chain keeps growing and is NotProven at the budget with its path.
  let failing = run Semantic.closeStaticChain(&mut store, &mut request, &spiral, 2)
  run Testing.expect(closureRefused(&failing, RejectionCode.StaticRecursionNotProven, 2),
    "growth on the path that returns a failure variant is still a successor: NotProven at the budget with its path")
  return ()
}

// The opening-site claims build their own programs, independent of the main -> grow build.
test effect fn refusedStaticChainsKeepTheirOpeningSites() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run openingSiteClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn openingSiteClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let entry = run module("b12-related-entry.silk")
  let helper = run module("chainhelper.silk")
  let entryText = """import chainhelper as Helper
fn relay(static n: i32) -> i32 {
  static if n == 1 {
    return Helper.grow(n)
  } else {
    return relay(n + 1)
  }
}
pub fn main() -> i32 { return relay(0) }
"""
  let entrySource = run present(entryText)
  let helperSource = run present("pub fn grow(static n: i32) -> i32 { return grow(n + 1) }\n")
  let first = run Revision.publish(&Revision.make(), &entry, &entrySource)
  let both = run Revision.publish(&first, &helper, &helperSource)
  let mut crossStore = makeSemantic(run withEntryRuntime(&both))
  let mut crossRequest = Request.forApplication(ModuleId.copy(&entry))
  let crossing = run buildApplication(&mut crossStore, &mut crossRequest, 3)
  run Testing.expect(refusedAcross(&crossing, &helper, &entry, offsetOf(entryText, "relay(n + 1)", usize.ZERO)),
    "a refusal in the helper module names the opening edge with its own module and span")
  let growthId = run module("b12-refused-growth.silk")
  let growthSource = """fn mixed<T>(static n: i32) -> i32 {
  static if n == 0 {
    return mixed<[T; 1]>(1)
  } else {
    return mixed<T>(n - 1)
  }
}
pub fn main() -> i32 { return mixed<i32>(1) }
"""
  let growthAuthored = run present(growthSource)
  let growthRevision = run Revision.publish(&Revision.make(), &growthId, &growthAuthored)
  let mut growthIndex = SourceIndex.make(run Revision.copy(&growthRevision))
  let mixed = run requireIndexedIdentity(&mut growthIndex, &growthId, OwnerKind.Function, b"mixed", usize.ZERO)
  let mut growthStore = makeSemantic(run withEntryRuntime(&growthRevision))
  let mut growthRequest = Request.forApplication(ModuleId.copy(&growthId))
  let growing = run buildApplication(&mut growthStore, &mut growthRequest, staticClosureNodes)
  let runtime = run entryRuntime()
  run Testing.expect(buildRefused(&growing, &runtime, RejectionCode.ExpandingSpecialization, &mixed, &growthId, offsetOf(growthSource, "mixed<T>(n - 1)", usize.ZERO)),
    "type growth found inside a closure transaction keeps the opening edge's span and its growing path")
  return ()
}

test effect fn staticChainsKeepWitnessEdgesAndBuild() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run witnessClosureClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn witnessClosureClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("b12-witness-closure.silk")
  let source = """interface Step { fn step(value: Self) -> i32 }
struct Unit {}
impl Step for Unit { fn step(value: Self) -> i32 { return 1 } }
fn walk(static n: i32, item: Unit) -> i32 {
  static if n == 0 {
    return Step.step(move item)
  } else {
    return walk(n - 1, move item)
  }
}
pub fn main() -> i32 { return walk(2, Unit {}) }
"""
  let authored = run present(source)
  let revision = run Revision.publish(&Revision.make(), &id, &authored)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let walk = run staticI32Root(&mut index, &id, b"walk", usize.ZERO, 2)
  let mut store = makeSemantic(run withEntryRuntime(&revision))
  let mut request = Request.make()
  let closure = run Semantic.closeStaticChain(&mut store, &mut request, &walk, 8)
  run Testing.expect(certifiedShape(&closure, 4, 3) && certifiedWitnessEdge(&closure),
    "a chain's witness-resolved successor is a node, reached by an edge that keeps Witness provenance")
  let mut buildRequest = Request.forApplication(ModuleId.copy(&id))
  let built = run buildApplication(&mut store, &mut buildRequest, staticClosureNodes)
  let module = match &built { BackendBuild.Module {..} => true _ => false }
  run Testing.expect(module, "a build admits the certified changing-static chain and emits its module")
  return ()
}

test effect fn staticCheckedCallSelectsCanonicalInherentBody() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("static-inherent.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """
static fn value() -> u32 { return 99 }
struct Scope {}
impl Scope {
  static fn value() -> u32 { return 7 }
}
static fn selected() -> u32 { return Scope.value() }
const result: u32 = selected()
"""
  let mut semantic = run staticSemantic(&id, source, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let result = run Semantic.demandInitializer(&mut semantic, &mut request, &id, b"result")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<bool>(&result, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return constantInteger(answer, b"7")
    }) && starts(Semantic.eventLog(&semantic), Family.Body) == 2,
    "source static calls execute the checked inherent body and record both reached bodies",
  )
  return ()
}

test effect fn staticArithmeticReportsOperationCodeAndSpan() -> ()
! InvalidModulePath | OutOfMemoryError | StaticDiagnostic | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("static-arithmetic.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = "static fn add(value: u32) -> u32 { return value + 1 }\nstatic fn divide(value: u32) -> u32 { return value / 0 }\n"
  let mut semantic = run staticSemantic(&id, source, MachineTarget.forId(TargetId.Aarch64AppleDarwin))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut staticDependencies = Vector<Dependency>.make()
  let mut machine = run StaticExecution.make(Semantic.staticPort(&mut semantic, &mut staticDependencies), &id, StaticExecution.Limits {steps: 32, depth: 4, valueBytes: 512})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let max = run Shared<StaticData>.make(StaticData.Integer {ty: StaticIntegerType.U32, sign: StaticSign.Positive, magnitude: 4294967295})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let one = run Shared<StaticData>.make(StaticData.Integer {ty: StaticIntegerType.U32, sign: StaticSign.Positive, magnitude: 1})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let overflow = run Effect.result(StaticExecution.demand(&mut machine, b"add", &[move max], Span.make(usize.ZERO, usize.ZERO)))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(staticExecutionSourceFault(&overflow, StaticExecutionFault.Overflow, b"SEM0176", offsetOf(source, "+", usize.ZERO)), "overflow names the authored operator and static diagnostic code")
  let division = run Effect.result(StaticExecution.demand(&mut machine, b"divide", &[move one], Span.make(usize.ZERO, usize.ZERO)))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(staticExecutionSourceFault(&division, StaticExecutionFault.DivisionByZero, b"SEM0176", offsetOf(source, "/", usize.ZERO)), "division by zero names the authored operator and static diagnostic code")
  return ()
}

test effect fn staticCallsDistinguishCyclesLimitsAndCheckedFailures() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | StaticDiagnostic | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("static-failures.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """static fn cycle(value: u32) -> u32 { return cycle(value) }
static fn descend(value: u32) -> u32 { return descend(value + 1) }
static fn spin(value: u32) -> u32 { while true {} return value }
static fn badField(boxed: Box) -> u32 { let mut result = boxed result.value = 1 return 0 }
fn runtime(value: u32) -> u32 { return value }
static fn badCall(value: u32) -> u32 { return runtime(value) }
static fn skipped(value: u32) -> bool { return false && broken(value) }
static fn broken(value: u32) -> bool { return missing }
static fn reported(value: u32) -> u32 { compileError("invalid static value") }
static fn terminal(value: u32) -> never { compileError("terminal failure") }
static fn forwarded(value: u32) -> u32 { terminal(value) }
struct Box { value: u32 }
"""
  let mut semantic = run staticSemantic(&id, source, MachineTarget.forId(TargetId.Aarch64AppleDarwin))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut staticDependencies = Vector<Dependency>.make()
  let mut machine = run StaticExecution.make(Semantic.staticPort(&mut semantic, &mut staticDependencies), &id, StaticExecution.Limits {steps: 100, depth: 2, valueBytes: 1024})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let input = run Shared<StaticData>.make(StaticData.Integer {ty: StaticIntegerType.U32, sign: StaticSign.Positive, magnitude: 1})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let args = [move input]
  let span = Span.make(usize.ZERO, usize.ZERO)
  let cycle = run Effect.result(StaticExecution.demand(&mut machine, b"cycle", &args, span))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(staticExecutionFailedWith(&cycle, StaticExecutionFault.Cycle) && staticExecutionTraceHas(&cycle, usize.ONE), "equal active call reports its ordered trace")
  let depth = run Effect.result(StaticExecution.demand(&mut machine, b"descend", &args, span))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(staticExecutionFailedWith(&depth, StaticExecutionFault.DepthLimit) && staticExecutionTraceHas(&depth, 2), "distinct recursive calls exhaust depth")
  let skipped = run StaticExecution.demand(&mut machine, b"skipped", &args, span)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared<StaticData>.with<bool>(&skipped, fn(value: &StaticData) -> bool {
    return match &value.* {
      StaticData.Boolean {value: chosen} => !chosen
      _ => false
    }
  }), "short circuit leaves the invalid function uncalled")
  let sameCycle = run Effect.result(StaticExecution.demand(&mut machine, b"cycle", &args, span))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(staticExecutionFailedWith(&sameCycle, StaticExecutionFault.Cycle), "typed failure leaves the call retryable")
  let steps = run Effect.result(StaticExecution.demand(&mut machine, b"spin", &args, span))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(staticExecutionFailedWith(&steps, StaticExecutionFault.StepLimit), "loop exhausts the step budget")
  let invalid = run Effect.result(StaticExecution.demand(&mut machine, b"badField", &args, span))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    staticExecutionBodyRejection(&invalid, RejectionCode.StaticPhaseViolation, offsetOf(source, "result.value", usize.ZERO)),
    "evaluator preserves the checked body's field-mutation rejection and source span",
  )
  drop machine
  let mut reportedMachine = run StaticExecution.make(
    Semantic.staticPort(&mut semantic, &mut staticDependencies),
    &id,
    StaticExecution.Limits {steps: 16, depth: 2, valueBytes: 1024},
  ) |> Effect.provideMut<Allocator>(&mut allocator)
  let reported = run Effect.result(StaticExecution.demand(&mut reportedMachine, b"reported", &args, span))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    staticExecutionCallFault(
      &reported,
      StaticExecutionFault.CompileError,
      b"SEM0177",
      offsetOf(source, "compileError", usize.ZERO),
      String.utf8Bytes("compileError(\"invalid static value\")").length,
    ),
    "checked compileError reports its selected source diagnostic",
  )
  drop reportedMachine
  let mut forwardedMachine = run StaticExecution.make(
    Semantic.staticPort(&mut semantic, &mut staticDependencies),
    &id,
    StaticExecution.Limits {steps: 16, depth: 3, valueBytes: 1024},
  ) |> Effect.provideMut<Allocator>(&mut allocator)
  let forwarded = run Effect.result(StaticExecution.demand(&mut forwardedMachine, b"forwarded", &args, span))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    staticExecutionCallFault(
      &forwarded,
      StaticExecutionFault.CompileError,
      b"SEM0177",
      offsetOf(source, "compileError(\"terminal failure\")", usize.ZERO),
      String.utf8Bytes("compileError(\"terminal failure\")").length,
    ),
    "a checked never-returning call terminates its enclosing static body",
  )
  drop forwardedMachine
  let mut request = Request.make()
  let runtime = run Semantic.demandBody(&mut semantic, &mut request, &id, b"badCall")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsFrom(&runtime, RejectionCode.StaticPhaseViolation, offsetOf(source, "runtime(value)", usize.ZERO)),
    "a runtime call in a static body rejects at its authored call before evaluation",
  )
  return ()
}

fn staticBodyExpressionAt(answer: &Result<Answer, NoRejection>, anchor: &Option<Anchor>, start: usize) -> HirId {
  let anchored = match &anchor.* { Option<Anchor>.Some {value} => Anchor.copy(&value) _ => { return HirId {index: usize.MAX} } }
  return match &answer.* {
    Result<Answer, NoRejection>.Success {value} => match &value.outcome {
      Outcome.Success {value: Value.Body {body, ..}} => Shared<TypedBody>.with<HirId>(
        &body,
        fn(checked: &TypedBody) -> HirId {
          let nodes = TypedBody.nodeSlice(checked)
          let mut at = usize.ZERO
          while at < nodes.length {
            if Anchor.span(&anchored, nodes[at].origin.location).start == start {
              if let BodyNodeKind.Expression {..} = &nodes[at].kind { return Anchor.hir(&anchored, nodes[at].origin.node) }
            }
            at = at + usize.ONE
          }
          return HirId {index: usize.MAX}
        },
      )
      _ => HirId {index: usize.MAX}
    }
    _ => HirId {index: usize.MAX}
  }
}

test effect fn staticRetainedValueLimitRejectsPublication() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | StaticDiagnostic | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("static-value-limit.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """
static fn identity(value: u32) -> u32 { return value }
static fn texts() -> u32 {
  let mut at: u32 = 0
  while at < 3 {
    let text = "abcdefghijklmnopqrstuvwx"
    at = at + 1
  }
  return 7
}
static fn returned() -> string<'static> { return "abcdefghijklmnopqrstuvwx" }
static fn alias() -> string<'static> { return returned() }
static fn resumed(supplied: string<'static>) -> string<'static> { return supplied }
static fn wide() -> [u32; 8] { return [1, 2, 3, 4, 5, 6, 7, 8] }
"""
  let textLiteral = "\"abcdefghijklmnopqrstuvwx\""
  let literalStart = offsetOf(source, textLiteral, usize.ONE)
  let mut semantic = run staticSemantic(&id, source, MachineTarget.forId(TargetId.Aarch64AppleDarwin))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut staticDependencies = Vector<Dependency>.make()
  let mut machine = run StaticExecution.make(Semantic.staticPort(&mut semantic, &mut staticDependencies), &id, StaticExecution.Limits {steps: 20, depth: 4, valueBytes: 32})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let input = run Shared<StaticData>.make(StaticData.Integer {ty: StaticIntegerType.U32, sign: StaticSign.Positive, magnitude: 1})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let args = [move input]
  let first = run StaticExecution.demand(&mut machine, b"identity", &args, Span.make(usize.ZERO, usize.ZERO))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let repeated = run StaticExecution.demand(&mut machine, b"identity", &args, Span.make(usize.ZERO, usize.ZERO))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared<StaticData>.with<bool>(&first, fn(value: &StaticData) -> bool {
    return staticSharedIntegerIs(value, 1)
  }) && Shared<StaticData>.with<bool>(&repeated, fn(value: &StaticData) -> bool {
    return staticSharedIntegerIs(value, 1)
  }), "equal static arguments reuse a completed result")
  let two = run Shared<StaticData>.make(StaticData.Integer {ty: StaticIntegerType.U32, sign: StaticSign.Positive, magnitude: 2})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let different = [move two]
  let attempted = run Effect.result(StaticExecution.demand(&mut machine, b"identity", &different, Span.make(usize.ZERO, usize.ZERO)))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(staticExecutionFailedWith(&attempted, StaticExecutionFault.ValueLimit), "distinct result exceeds retained value budget")
  drop machine
  let mut arrayDependencies = Vector<Dependency>.make()
  let mut arrayMachine = run StaticExecution.make(Semantic.staticPort(&mut semantic, &mut arrayDependencies), &id, StaticExecution.Limits {steps: 64, depth: 4, valueBytes: 48})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let noArrayArguments = Vector<Shared<StaticData>>.make()
  let wide = run Effect.result(StaticExecution.demand(&mut arrayMachine, b"wide", Vector<Shared<StaticData>>.asSlice(&noArrayArguments), Span.make(usize.ZERO, usize.ZERO)))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(staticExecutionFailedWith(&wide, StaticExecutionFault.ValueLimit), "constructing a static array is charged to the retained value budget")
  drop arrayMachine
  let mut textDependencies = Vector<Dependency>.make()
  let mut textMachine = run StaticExecution.make(Semantic.staticPort(&mut semantic, &mut textDependencies), &id, StaticExecution.Limits {steps: 128, depth: 4, valueBytes: 64})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let noArguments = Vector<Shared<StaticData>>.make()
  let repeatedText = run Effect.result(StaticExecution.demand(&mut textMachine, b"texts", Vector<Shared<StaticData>>.asSlice(&noArguments), Span.make(usize.ZERO, usize.ZERO)))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(staticExecutionFailedWith(&repeatedText, StaticExecutionFault.ValueLimit), "retained text provenance exhausts the cumulative value budget without publishing a value")
  drop textMachine
  let mut returnedDependencies = Vector<Dependency>.make()
  let mut returnedMachine = run StaticExecution.make(Semantic.staticPort(&mut semantic, &mut returnedDependencies), &id, StaticExecution.Limits {steps: 32, depth: 4, valueBytes: 64})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let returned = run StaticExecution.demand(&mut returnedMachine, b"alias", Vector<Shared<StaticData>>.asSlice(&noArguments), Span.make(usize.ZERO, usize.ZERO))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let origin = StaticExecution.textOrigin(&returnedMachine, &returned)
  let returnedOriginMatches = match move origin {
    Option<Span>.Some {value: returnedOrigin} => returnedOrigin.start == literalStart
    Option<Span>.None => false
  }
  run Testing.expect(returnedOriginMatches, "returned text aliases preserve the authored origin without a second budget charge")
  drop returnedMachine
  let mut rootRequest = Request.make()
  let literalBody = run Semantic.demandBody(&mut semantic, &mut rootRequest, &id, b"returned")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let resumedBody = run Semantic.demandBody(&mut semantic, &mut rootRequest, &id, b"resumed")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let literalAnchor = run answerAnchor(&mut semantic, &literalBody) |> Effect.provideMut<Allocator>(&mut allocator)
  let resumedAnchor = run answerAnchor(&mut semantic, &resumedBody) |> Effect.provideMut<Allocator>(&mut allocator)
  let literalId = Shared<Result<Answer, NoRejection>>.with<HirId>(&literalBody, fn(answer: &Result<Answer, NoRejection>) -> HirId {
    return staticBodyExpressionAt(answer, &literalAnchor, literalStart)
  })
  let resumedId = Shared<Result<Answer, NoRejection>>.with<HirId>(&resumedBody, fn(answer: &Result<Answer, NoRejection>) -> HirId {
    return staticBodyExpressionAt(answer, &resumedAnchor, offsetOf(source, "supplied }", usize.ZERO))
  })
  let checkedLiteralRoot = Shared<Result<Answer, NoRejection>>.with<Option<StaticExecution.CheckedRoot>>(
    &literalBody, StaticExecution.checkedRoot,
  )
  let literalRoot = match move checkedLiteralRoot {
    Option<StaticExecution.CheckedRoot>.Some {value: checkedLiteral} => move checkedLiteral
    Option<StaticExecution.CheckedRoot>.None => {
      run Testing.expect(false, "the text literal has a checked root")
      return ()
    }
  }
  let checkedResumedRoot = Shared<Result<Answer, NoRejection>>.with<Option<StaticExecution.CheckedRoot>>(
    &resumedBody, StaticExecution.checkedRoot,
  )
  let resumedRoot = match move checkedResumedRoot {
    Option<StaticExecution.CheckedRoot>.Some {value: checkedResumed} => move checkedResumed
    Option<StaticExecution.CheckedRoot>.None => {
      run Testing.expect(false, "the supplied text reference has a checked root")
      return ()
    }
  }
  let mut rootDependencies = Vector<Dependency>.make()
  let mut rootMachine = run StaticExecution.make(Semantic.staticPort(&mut semantic, &mut rootDependencies), &id, StaticExecution.Limits {steps: 32, depth: 4, valueBytes: 64})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let noBindings = Vector<StaticExecution.Binding>.make()
  let literalValue = run StaticExecution.evaluate(&mut rootMachine, &literalRoot, Vector<StaticExecution.Binding>.asSlice(&noBindings), literalId)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let suppliedModule = ModuleId.copy(&id)
  let supplied = [StaticExecution.Binding {
    module: move suppliedModule,
    binder: resumedId,
    value: StaticValue.copy(&literalValue),
  }]
  let resumedValue = run StaticExecution.evaluate(&mut rootMachine, &resumedRoot, &supplied, resumedId)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let resumedOriginValue = StaticExecution.textOrigin(&rootMachine, &resumedValue)
  let resumedOriginMatches = match move resumedOriginValue {
    Option<Span>.Some {value: resumedOrigin} => resumedOrigin.start == literalStart
    Option<Span>.None => false
  }
  run Testing.expect(resumedOriginMatches, "literal roots and supplied aliases publish with one retained provenance charge")
  let exhausted = run Effect.result(StaticExecution.evaluate(&mut rootMachine, &literalRoot, Vector<StaticExecution.Binding>.asSlice(&noBindings), literalId))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(staticExecutionFailedWith(&exhausted, StaticExecutionFault.ValueLimit), "releasing an origin-held supplied alias preserves the live charge for later roots")
  return ()
}

test effect fn staticCallCacheIncludesCheckedGenericApplication() -> ()
! InvalidModulePath | OutOfMemoryError | StaticDiagnostic | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("static-generic-key.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = "static fn phantom<T>(value: u32) -> u32 { return value }\n"
  let bytes = run Bytes.copy(String.utf8Bytes(source))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unit = run SourceUnit.parse(&id, usize.ONE, move bytes) |> Effect.provideMut<Allocator>(&mut allocator)
  let index = run ModuleIndex.build(&unit, false) |> Effect.provideMut<Allocator>(&mut allocator)
  let declarations = ModuleIndex.listDeclarations(&index)
  let header = run StaticFunction.select(&unit, &index, &declarations[usize.ZERO].identity)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let selected = match move header {
    Result<SelectedStaticFunction, StaticHeaderRejection>.Success {value} => move value
    Result<SelectedStaticFunction, StaticHeaderRejection>.Failure {error: _} => {
      run Testing.expect(false, "generic static function has a selectable header")
      return ()
    }
  }
  let integer = run specializationPrimitive(b"u32") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let boolean = run specializationPrimitive(b"bool") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let firstApplication = run specializationOf(&selected.declaration, &integer)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let otherApplication = run specializationOf(&selected.declaration, &boolean)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = run staticSemantic(&id, source, MachineTarget.forId(TargetId.Aarch64AppleDarwin))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut staticDependencies = Vector<Dependency>.make()
  let mut machine = run StaticExecution.make(Semantic.staticPort(&mut semantic, &mut staticDependencies), &id, StaticExecution.Limits {steps: 20, depth: 4, valueBytes: 32})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let input = run Shared<StaticData>.make(StaticData.Integer {ty: StaticIntegerType.U32, sign: StaticSign.Positive, magnitude: 1})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let args = [move input]
  let span = Span.make(usize.ZERO, usize.ZERO)
  let first = run StaticExecution.demandApplication(&mut machine, &firstApplication, b"phantom", &args, span)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let repeated = run StaticExecution.demandApplication(&mut machine, &firstApplication, b"phantom", &args, span)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared<StaticData>.with<bool>(&first, fn(value: &StaticData) -> bool {
    return staticSharedIntegerIs(value, 1)
  }) && Shared<StaticData>.with<bool>(&repeated, fn(value: &StaticData) -> bool {
    return staticSharedIntegerIs(value, 1)
  }), "equal checked applications reuse one static result")
  let other = run Effect.result(StaticExecution.demandApplication(&mut machine, &otherApplication, b"phantom", &args, span))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(staticExecutionFailedWith(&other, StaticExecutionFault.ValueLimit), "different generic arguments have separate cache entries")
  let operation = DeclarationId.copy(&selected.declaration)
  let implementation = DeclarationId.copy(&selected.declaration)
  let selectedOperation = SpecializationApplication {
    target: SpecializationTarget.Operation {
      contract: Shared<Type>.clone(&integer),
      provider: Shared<Type>.clone(&boolean),
      operation: move operation,
      implementation: move implementation,
    },
    argumentOrdinals: Vector<usize>.make(),
    scopes: Vector<ScopeBinding>.make(),
    arguments: Vector<Argument>.make(),
    statics: Vector<StaticSlot>.make(),
  }
  let operationSpan = Span.make(usize.ONE, usize.ONE + usize.ONE)
  let rejectedOperation = run Effect.result(StaticExecution.demandApplication(&mut machine, &selectedOperation, b"phantom", &args, operationSpan))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    staticExecutionCallFault(&rejectedOperation, StaticExecutionFault.StaticPhaseViolation, b"SEM0176", usize.ONE, usize.ONE),
    "interface operations cannot be called during static evaluation",
  )
  return ()
}

test effect fn staticUnsuffixedPointerLiteralsUseSelectedTarget() -> ()
! InvalidModulePath | OutOfMemoryError | StaticDiagnostic | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("static-pointer-literals.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """static fn wideUnsigned() -> usize { return 4294967296 }
static fn wideSigned() -> isize { return 2147483648 }
static fn echo(value: usize) -> usize { return value }
static fn callEcho() -> usize { return echo(4294967296) }
static fn sumWord() -> usize { return 1 + 2 }
static fn callSum() -> usize { return echo(1 + 2) }
static fn nested() -> usize { return (1 + 2) + (3 + 4) }
"""
  let mut nativeSemantic = run staticSemantic(&id, source, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut wasmSemantic = run staticSemantic(&id, source, MachineTarget.forId(TargetId.Wasm32UnknownUnknown))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut nativeDependencies = Vector<Dependency>.make()
  let mut wasmDependencies = Vector<Dependency>.make()
  let mut native = run StaticExecution.make(Semantic.staticPort(&mut nativeSemantic, &mut nativeDependencies), &id, StaticExecution.Limits {steps: 64, depth: 3, valueBytes: 256})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut wasm = run StaticExecution.make(Semantic.staticPort(&mut wasmSemantic, &mut wasmDependencies), &id, StaticExecution.Limits {steps: 64, depth: 3, valueBytes: 256})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let args = Vector<Shared<StaticData>>.make()
  let span = Span.make(usize.ZERO, usize.ZERO)
  let unsigned = run StaticExecution.demand(&mut native, b"wideUnsigned", Vector<Shared<StaticData>>.asSlice(&args), span)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let signed = run StaticExecution.demand(&mut native, b"wideSigned", Vector<Shared<StaticData>>.asSlice(&args), span)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let forwarded = run StaticExecution.demand(&mut native, b"callEcho", Vector<Shared<StaticData>>.asSlice(&args), span)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let summed = run StaticExecution.demand(&mut native, b"sumWord", Vector<Shared<StaticData>>.asSlice(&args), span)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let forwardedSum = run StaticExecution.demand(&mut native, b"callSum", Vector<Shared<StaticData>>.asSlice(&args), span)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared<StaticData>.with<bool>(&unsigned, fn(value: &StaticData) -> bool {
    return match & value.* {
      StaticData.Integer {ty, magnitude, ..} => ty == StaticIntegerType.Usize && magnitude == 4294967296
      _ => false
    }
  }) && Shared<StaticData>.with<bool>(&signed, fn(value: &StaticData) -> bool {
    return match & value.* {
      StaticData.Integer {ty, magnitude, ..} => ty == StaticIntegerType.Isize && magnitude == 2147483648
      _ => false
    }
  }) && Shared<StaticData>.with<bool>(&forwarded, fn(value: &StaticData) -> bool {
    return match & value.* {
      StaticData.Integer {ty, magnitude, ..} => ty == StaticIntegerType.Usize && magnitude == 4294967296
      _ => false
    }
  }), "unsuffixed return and call-argument literals use the declared pointer-sized type on a 64-bit target")
  run Testing.expect(Shared<StaticData>.with<bool>(&summed, fn(value: &StaticData) -> bool {
    return match & value.* {
      StaticData.Integer {ty, magnitude, ..} => ty == StaticIntegerType.Usize && magnitude == 3
      _ => false
    }
  }) && Shared<StaticData>.with<bool>(&forwardedSum, fn(value: &StaticData) -> bool {
    return match & value.* {
      StaticData.Integer {ty, magnitude, ..} => ty == StaticIntegerType.Usize && magnitude == 3
      _ => false
    }
  }), "arithmetic operands inherit the return or parameter integer type")
  let unsigned32 = run Effect.result(StaticExecution.demand(&mut wasm, b"wideUnsigned", Vector<Shared<StaticData>>.asSlice(&args), span))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let signed32 = run Effect.result(StaticExecution.demand(&mut wasm, b"wideSigned", Vector<Shared<StaticData>>.asSlice(&args), span))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let forwarded32 = run Effect.result(StaticExecution.demand(&mut wasm, b"callEcho", Vector<Shared<StaticData>>.asSlice(&args), span))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    staticExecutionBodyRejection(&unsigned32, RejectionCode.IntegerOutOfRange, offsetOf(source, "4294967296", usize.ZERO)) &&
    staticExecutionBodyRejection(&signed32, RejectionCode.IntegerOutOfRange, offsetOf(source, "2147483648", usize.ZERO)) &&
    staticExecutionBodyRejection(&forwarded32, RejectionCode.IntegerOutOfRange, offsetOf(source, "4294967296", 1)),
    "the checked bodies reject values outside the wasm32 pointer-sized ranges",
  )
  let sum32 = run StaticExecution.demand(&mut wasm, b"sumWord", Vector<Shared<StaticData>>.asSlice(&args), span)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let forwardedSum32 = run StaticExecution.demand(&mut wasm, b"callSum", Vector<Shared<StaticData>>.asSlice(&args), span)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared<StaticData>.with<bool>(&sum32, fn(value: &StaticData) -> bool {
    return match & value.* {
      StaticData.Integer {ty, magnitude, ..} => ty == StaticIntegerType.Usize && magnitude == 3
      _ => false
    }
  }) && Shared<StaticData>.with<bool>(&forwardedSum32, fn(value: &StaticData) -> bool {
    return match & value.* {
      StaticData.Integer {ty, magnitude, ..} => ty == StaticIntegerType.Usize && magnitude == 3
      _ => false
    }
  }), "arithmetic uses usize on wasm32 as well as native64")
  let nested32 = run StaticExecution.demand(&mut wasm, b"nested", Vector<Shared<StaticData>>.asSlice(&args), span)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared<StaticData>.with<bool>(&nested32, fn(value: &StaticData) -> bool {
    return match & value.* {
      StaticData.Integer {ty, magnitude, ..} => ty == StaticIntegerType.Usize && magnitude == 10
      _ => false
    }
  }), "nested arithmetic operands inherit the pointer-sized return type on wasm32")
  return ()
}

test effect fn staticFunctionHeaderIsDemandedWithoutRunningItsBody() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("static-header.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = "static fn valid(value: u32) -> u32 { return value }\nfn runtime() -> u32 { return 1 }\nstatic fn broken() -> u32 { return missing }\n"
  let bytes = run Bytes.copy(String.utf8Bytes(source)) |> Effect.provideMut<Allocator>(&mut allocator)
  let unit = run SourceUnit.parse(&id, usize.ONE, move bytes)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let index = run ModuleIndex.build(&unit, false) |> Effect.provideMut<Allocator>(&mut allocator)
  let declarations = ModuleIndex.listDeclarations(&index)
  let valid = run StaticFunction.select(&unit, &index, &declarations[usize.ZERO].identity)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let selectedHeader = match move valid {
    Result<SelectedStaticFunction, StaticHeaderRejection>.Success {value} => Vector<HirId>.length(&value.parameters) == usize.ONE
    _ => false
  }
  run Testing.expect(selectedHeader, "static header selects its body and parameter binder")
  let broken = run StaticFunction.select(&unit, &index, &declarations[2].identity)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let selectedBroken = match move broken {
    Result<SelectedStaticFunction, StaticHeaderRejection>.Success {value: _} => true
    _ => false
  }
  run Testing.expect(selectedBroken, "uncalled body is not evaluated")
  let runtime = run StaticFunction.select(&unit, &index, &declarations[usize.ONE].identity)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let rejectedRuntime = match move runtime {
    Result<SelectedStaticFunction, StaticHeaderRejection>.Failure {error} => error.fault == StaticHeaderFault.RuntimeFunction
    _ => false
  }
  run Testing.expect(rejectedRuntime, "runtime function is not a static call target")
  return ()
}

test effect fn staticCallRejectsCheckedBodyFailure() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("static-checked-body.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """static fn invalid() -> u32 {
  let value: bool = 7
  return value
}
static fn caller() -> u32 { return invalid() }
"""
  let mut semantic = run staticSemantic(&id, source, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut dependencies = Vector<Dependency>.make()
  let mut machine = run StaticExecution.make(Semantic.staticPort(&mut semantic, &mut dependencies), &id, StaticExecution.Limits {steps: 32, depth: 4, valueBytes: 64})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let arguments = Vector<Shared<StaticData>>.make()
  let span = Span.make(usize.ZERO, usize.ZERO)
  let attempted = run Effect.result(StaticExecution.demand(&mut machine, b"caller", Vector<Shared<StaticData>>.asSlice(&arguments), span))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    staticExecutionBodyRejection(&attempted, RejectionCode.AssignmentTypeMismatch, offsetOf(source, "7", usize.ZERO)),
    "a rejected checked body never executes from raw HIR",
  )
  return ()
}

fn staticFaultIs(answer: &Result<StaticData, StaticFault>, expected: StaticFault) -> bool {
  return match &answer.* {
    Result<StaticData, StaticFault>.Failure {error} => error == expected
    _ => false
  }
}

fn staticBooleanIs(answer: &Result<StaticData, StaticFault>, expected: bool) -> bool {
  return match &answer.* {
    Result<StaticData, StaticFault>.Success {value: StaticData.Boolean {value}} => value == expected
    _ => false
  }
}

fn staticFloatBitsAre(answer: &Result<StaticData, StaticFault>, expected: u64) -> bool {
  return match &answer.* {
    Result<StaticData, StaticFault>.Success {value: StaticData.Float {bits, ..}} => bits == expected
    _ => false
  }
}

fn staticIsText(answer: &Option<StaticData>) -> bool {
  return match &answer.* {
    Option<StaticData>.Some {value: StaticData.Text {..}} => true
    _ => false
  }
}

fn staticIsNone(answer: &Option<StaticData>) -> bool {
  return match &answer.* {
    Option<StaticData>.None => true
    _ => false
  }
}

fn staticOptionIntegerIs(answer: &Option<StaticData>, ty: StaticIntegerType, magnitude: u64) -> bool {
  return match &answer.* {
    Option<StaticData>.Some {value: StaticData.Integer {ty: found, sign, magnitude: amount}} => found == ty && sign == StaticSign.Positive && amount == magnitude
    _ => false
  }
}

fn staticOptionFloatBitsAre(answer: &Option<StaticData>, ty: StaticFloatType, bits: u64) -> bool {
  return match &answer.* {
    Option<StaticData>.Some {value: StaticData.Float {ty: found, bits: payload}} => found == ty && payload == bits
    _ => false
  }
}

fn staticIsUnit(value: &StaticData) -> bool {
  return match &value.* {
    StaticData.Unit => true
    _ => false
  }
}

fn staticHasUnitField(answer: &Option<StaticData>) -> bool {
  return match &answer.* {
    Option<StaticData>.Some {value} => match move StaticValue.field(&value, usize.ZERO) {
      Option<Shared<StaticData>>.Some {value: field} => Shared<StaticData>.with<bool>(&field, staticIsUnit)
      Option<Shared<StaticData>>.None => false
    }
    Option<StaticData>.None => false
  }
}

fn enumMemberIs(answer: &Result<Answer, NoRejection>, ordinal: usize, sign: StaticSign, magnitude: u64) -> bool {
  return match &answer.* {
    Result<Answer, NoRejection>.Success {value} => match &value.outcome {
      Outcome.Success {value: Value.Members {members, ..}} => {
        let entries = Vector<Member>.asSlice(&members)
        if ordinal >= entries.length {
          return false
        }
        return match &entries[ordinal].discriminant {
          Option<EnumCase>.Some {value: selected} => selected.sign == sign && selected.magnitude == magnitude
          Option<EnumCase>.None => false
        }
      }
      _ => false
    }
    _ => false
  }
}

test effect fn staticIntegerArithmeticUsesExactBoundsAndTraps() -> () ! AssertionError<'static> {
  let max = StaticData.Integer {ty: StaticIntegerType.U8, sign: StaticSign.Positive, magnitude: 255}
  let one = StaticData.Integer {ty: StaticIntegerType.U8, sign: StaticSign.Positive, magnitude: 1}
  let zero = StaticData.Integer {ty: StaticIntegerType.U8, sign: StaticSign.Positive, magnitude: 0}
  let overflow = StaticValue.infix(InfixOperator.Add, &max, &one, 64)
  let zeroDivision = StaticValue.infix(InfixOperator.Divide, &one, &zero, 64)
  run Testing.expect(staticFaultIs(&overflow, StaticFault.Overflow), "static u8 addition must reject overflow")
  run Testing.expect(staticFaultIs(&zeroDivision, StaticFault.DivisionByZero), "static division must reject zero")
  let minusSeven = StaticData.Integer {ty: StaticIntegerType.I8, sign: StaticSign.Negative, magnitude: 7}
  let two = StaticData.Integer {ty: StaticIntegerType.I8, sign: StaticSign.Positive, magnitude: 2}
  let quotient = StaticValue.infix(InfixOperator.Divide, &minusSeven, &two, 64)
  let remainder = StaticValue.infix(InfixOperator.Remainder, &minusSeven, &two, 64)
  run Testing.expect(staticIntegerIs(&quotient, StaticSign.Negative, 3), "signed static division truncates toward zero")
  run Testing.expect(staticIntegerIs(&remainder, StaticSign.Negative, 1), "signed static remainder takes the dividend sign")
  let minimum = StaticData.Integer {ty: StaticIntegerType.I8, sign: StaticSign.Negative, magnitude: 128}
  let minusOne = StaticData.Integer {ty: StaticIntegerType.I8, sign: StaticSign.Negative, magnitude: 1}
  let invalidRemainder = StaticValue.infix(InfixOperator.Remainder, &minimum, &minusOne, 64)
  run Testing.expect(staticFaultIs(&invalidRemainder, StaticFault.Overflow), "MIN remainder -1 traps")
  let wasm = MachineTarget.forId(TargetId.Wasm32UnknownUnknown)
  let native = MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)
  let rejected32 = StaticValue.integer(StaticIntegerType.Usize, StaticSign.Positive, 4294967296, wasm.pointerBits())
  let accepted64 = StaticValue.integer(StaticIntegerType.Usize, StaticSign.Positive, 4294967296, native.pointerBits())
  run Testing.expect(staticIsNone(&rejected32), "usize rejects values outside the frozen 32-bit target")
  run Testing.expect(staticOptionIntegerIs(&accepted64, StaticIntegerType.Usize, 4294967296), "usize accepts the same value on a frozen 64-bit target")
  let rejectedSigned32 = StaticValue.integer(StaticIntegerType.Isize, StaticSign.Positive, 2147483648, wasm.pointerBits())
  let acceptedSigned64 = StaticValue.integer(StaticIntegerType.Isize, StaticSign.Positive, 2147483648, native.pointerBits())
  let minimumSigned32 = StaticValue.integer(StaticIntegerType.Isize, StaticSign.Negative, 2147483648, wasm.pointerBits())
  run Testing.expect(staticIsNone(&rejectedSigned32), "isize rejects positive values above the frozen 32-bit maximum")
  run Testing.expect(staticOptionIntegerIs(&acceptedSigned64, StaticIntegerType.Isize, 2147483648), "isize accepts the same positive value on a frozen 64-bit target")
  run Testing.expect(!staticIsNone(&minimumSigned32), "isize admits the negative 32-bit minimum")
  return ()
}

test effect fn staticValueReuseIsIdentityFree() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let first = run Shared<StaticData>.make(StaticData.Boolean {value: true})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let retained = StaticValue.copy(&first)
  let equivalent = run Shared<StaticData>.make(StaticData.Boolean {value: true})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let different = run Shared<StaticData>.make(StaticData.Boolean {value: false})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let sameRetained = run StaticValue.equals(&first, &retained)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let sameSeparate = run StaticValue.equals(&first, &equivalent)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let differs = run StaticValue.equals(&first, &different)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(sameRetained && sameSeparate && !differs, "static reuse compares values, not allocation handles")
  let seven = run Shared<StaticData>.make(StaticData.Integer {ty: StaticIntegerType.I8, sign: StaticSign.Positive, magnitude: 7})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let alias = StaticValue.copy(&seven)
  let five = run Shared<StaticData>.make(StaticData.Integer {ty: StaticIntegerType.I8, sign: StaticSign.Positive, magnitude: 5})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let selfSum = StaticValue.infixShared(InfixOperator.Add, &seven, &alias, 64)
  let distinctSum = StaticValue.infixShared(InfixOperator.Add, &seven, &five, 64)
  let negated = StaticValue.prefixShared(PrefixOperator.Negate, &seven, 64)
  run Testing.expect(staticIntegerIs(&selfSum, StaticSign.Positive, 14), "an aliased value can be used on both sides of an operator")
  run Testing.expect(staticIntegerIs(&distinctSum, StaticSign.Positive, 12), "distinct shared values can be combined")
  run Testing.expect(staticIntegerIs(&negated, StaticSign.Negative, 7), "prefix operators accept a shared value")
  return ()
}

// Runtime identity bytes agree with semantic equality wherever no lifetime is erased.
effect fn expectStaticIdentity(left: StaticData, right: StaticData, owner: &DeclarationId, same: bool) -> ()
! OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let first = run Shared<StaticData>.make(move left)
  let second = run Shared<StaticData>.make(move right)
  let runtime = run StaticValue.runtimeEquals(&first, &second, owner)
  let semantic = run StaticValue.equals(&first, &second)
  run Testing.expect(runtime == same && semantic == same, "static runtime identity matches the expected distinction and semantic equality")
  return ()
}

// A lifetime-only difference is semantic identity but erases from runtime identity.
effect fn expectLifetimeOnlyIdentity(left: StaticData, right: StaticData, owner: &DeclarationId) -> ()
! OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let first = run Shared<StaticData>.make(move left)
  let second = run Shared<StaticData>.make(move right)
  let runtime = run StaticValue.runtimeEquals(&first, &second, owner)
  let semantic = run StaticValue.equals(&first, &second)
  run Testing.expect(runtime && !semantic, "values differing only by a lifetime are semantically distinct and runtime equal")
  return ()
}

effect fn staticNestedArray(outer: &Shared<Type>, inner: &Shared<Type>, last: u64) -> StaticData ! OutOfMemoryError ? &mut Allocator {
  let mut rows = Vector<Shared<StaticData>>.make()
  run Vector<Shared<StaticData>>.append(&mut rows, run Shared<StaticData>.make(run staticArray(inner, 1, 2)))
  run Vector<Shared<StaticData>>.append(&mut rows, run Shared<StaticData>.make(run staticArray(inner, 1, last)))
  let built = StaticValue.aggregate(Shared<Type>.clone(outer), Option<usize>.none(), move rows)
  return match move built {
    Option<StaticData>.Some {value} => move value
    Option<StaticData>.None => StaticData.Unit
  }
}

effect fn staticU8(magnitude: u64) -> Shared<StaticData> ! OutOfMemoryError ? &mut Allocator {
  return run Shared<StaticData>.make(StaticData.Integer {ty: StaticIntegerType.U8, sign: StaticSign.Positive, magnitude: magnitude})
}

effect fn staticPairFields(first: u64, second: u64) -> Vector<Shared<StaticData>> ! OutOfMemoryError ? &mut Allocator {
  let mut fields = Vector<Shared<StaticData>>.make()
  run Vector<Shared<StaticData>>.append(&mut fields, run staticU8(first))
  run Vector<Shared<StaticData>>.append(&mut fields, run staticU8(second))
  return move fields
}

effect fn staticArray(ty: &Shared<Type>, first: u64, second: u64) -> StaticData ! OutOfMemoryError ? &mut Allocator {
  let built = StaticValue.aggregate(Shared<Type>.clone(ty), Option<usize>.none(), run staticPairFields(first, second))
  return match move built {
    Option<StaticData>.Some {value} => move value
    Option<StaticData>.None => StaticData.Unit
  }
}

effect fn staticRecord(ty: &Shared<Type>, first: u64, second: u64) -> StaticData ! OutOfMemoryError ? &mut Allocator {
  return StaticValue.record(Shared<Type>.clone(ty), run staticPairFields(first, second))
}

effect fn staticVariant(ty: &Shared<Type>, ordinal: usize, payload: u64) -> StaticData ! OutOfMemoryError ? &mut Allocator {
  let mut fields = Vector<Shared<StaticData>>.make()
  run Vector<Shared<StaticData>>.append(&mut fields, run staticU8(payload))
  return StaticValue.unionVariant(Shared<Type>.clone(ty), ordinal, move fields)
}

effect fn staticEnum(declaration: &DeclarationId, member: usize) -> StaticData ! OutOfMemoryError ? &mut Allocator {
  return StaticData.Enum {
    declaration: run Shared<DeclarationId>.make(DeclarationId.copy(declaration)),
    member: member, representation: StaticIntegerType.U8, sign: StaticSign.Positive, magnitude: 0,
  }
}

effect fn staticTextValue(spelling: &[u8]) -> StaticData ! OutOfMemoryError ? &mut Allocator {
  let decoded = StaticValue.text(run Bytes.copy(spelling))
  return match move decoded {
    Option<StaticData>.Some {value} => move value
    Option<StaticData>.None => StaticData.Unit
  }
}

test effect fn staticValueRuntimeIdentityCoversEveryKind() -> ()
! InvalidModulePath | Cycle | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run staticValueRuntimeIdentityClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn staticValueRuntimeIdentityClaims() -> ()
! InvalidModulePath | Cycle | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("static-identity.silk")
  let source = run present("enum Alpha { First, Second }\nenum Beta { First }\nstruct Pair { left: u8, right: u8 }\nunion Choice { A { value: u8 }, B { value: u8 } }\n")
  let revision = run Revision.publish(&Revision.make(), &id, &source)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let alpha = run requireIndexedIdentity(&mut index, &id, OwnerKind.Enumeration, b"Alpha", usize.ZERO)
  let beta = run requireIndexedIdentity(&mut index, &id, OwnerKind.Enumeration, b"Beta", usize.ZERO)
  let pair = run requireIndexedIdentity(&mut index, &id, OwnerKind.Struct, b"Pair", usize.ZERO)
  let byte = run Types.intern(Type.Primitive {name: run Bytes.copy(b"u8")})
  let arrayType = run Types.intern(Type.Array {element: Shared<Type>.clone(&byte), extent: run Bytes.copy(b"2")})
  let pairType = run Types.intern(Type.Nominal {declaration: DeclarationId.copy(&pair), isPublic: false, arguments: Vector<Argument>.make()})
  let choice = run requireIndexedIdentity(&mut index, &id, OwnerKind.Union, b"Choice", usize.ZERO)
  let choiceType = run Types.intern(Type.Nominal {declaration: move choice, isPublic: false, arguments: Vector<Argument>.make()})
  run expectStaticIdentity(StaticData.Unit, StaticData.Unit, &pair, true)
  run expectStaticIdentity(StaticData.Unit, StaticData.Boolean {value: false}, &pair, false)
  run expectStaticIdentity(StaticData.Boolean {value: true}, StaticData.Boolean {value: false}, &pair, false)
  run expectStaticIdentity(StaticData.Character {scalar: 0x1f600}, StaticData.Character {scalar: 0x1f600}, &pair, true)
  run expectStaticIdentity(StaticData.Character {scalar: 97}, StaticData.Character {scalar: 98}, &pair, false)
  run expectStaticIdentity(
    StaticData.Integer {ty: StaticIntegerType.I8, sign: StaticSign.Positive, magnitude: 5},
    StaticData.Integer {ty: StaticIntegerType.I8, sign: StaticSign.Positive, magnitude: 5}, &pair, true)
  run expectStaticIdentity(
    StaticData.Integer {ty: StaticIntegerType.U8, sign: StaticSign.Positive, magnitude: 5},
    StaticData.Integer {ty: StaticIntegerType.I8, sign: StaticSign.Positive, magnitude: 5}, &pair, false)
  run expectStaticIdentity(
    StaticData.Integer {ty: StaticIntegerType.I8, sign: StaticSign.Negative, magnitude: 5},
    StaticData.Integer {ty: StaticIntegerType.I8, sign: StaticSign.Positive, magnitude: 5}, &pair, false)
  run expectStaticIdentity(
    StaticData.Float {ty: StaticFloatType.F32, bits: 0}, StaticData.Float {ty: StaticFloatType.F32, bits: 0x80000000}, &pair, false)
  run expectStaticIdentity(
    StaticData.Float {ty: StaticFloatType.F32, bits: 0x7fc00000}, StaticData.Float {ty: StaticFloatType.F32, bits: 0x7fc12345}, &pair, false)
  run expectStaticIdentity(
    StaticData.Float {ty: StaticFloatType.F32, bits: 0x3f800000}, StaticData.Float {ty: StaticFloatType.F64, bits: 0x3f800000}, &pair, false)
  run expectStaticIdentity(
    StaticData.Float {ty: StaticFloatType.F64, bits: 0x7ff8000000001234}, StaticData.Float {ty: StaticFloatType.F64, bits: 0x7ff8000000001234}, &pair, true)
  run expectStaticIdentity(run staticEnum(&alpha, 0), run staticEnum(&alpha, 0), &pair, true)
  run expectStaticIdentity(run staticEnum(&alpha, 0), run staticEnum(&beta, 0), &pair, false)
  run expectStaticIdentity(run staticEnum(&alpha, 0), run staticEnum(&alpha, 1), &pair, false)
  run expectStaticIdentity(run staticTextValue(b"ab"), run staticTextValue(b"ab"), &pair, true)
  run expectStaticIdentity(run staticTextValue(b"ab"), run staticTextValue(b"ba"), &pair, false)
  run expectStaticIdentity(run staticTextValue(b"a"), run staticTextValue(b"ab"), &pair, false)
  run expectStaticIdentity(run staticArray(&arrayType, 1, 2), run staticArray(&arrayType, 1, 2), &pair, true)
  run expectStaticIdentity(run staticArray(&arrayType, 1, 2), run staticArray(&arrayType, 2, 1), &pair, false)
  run expectStaticIdentity(run staticArray(&arrayType, 1, 2), run staticRecord(&pairType, 1, 2), &pair, false)
  run expectStaticIdentity(run staticRecord(&pairType, 1, 2), run staticRecord(&pairType, 1, 2), &pair, true)
  run expectStaticIdentity(run staticVariant(&choiceType, 0, 1), run staticVariant(&choiceType, 1, 1), &pair, false)
  let nestedType = run Types.intern(Type.Array {element: Shared<Type>.clone(&arrayType), extent: run Bytes.copy(b"2")})
  run expectStaticIdentity(run staticNestedArray(&nestedType, &arrayType, 2), run staticNestedArray(&nestedType, &arrayType, 2), &pair, true)
  run expectStaticIdentity(run staticNestedArray(&nestedType, &arrayType, 2), run staticNestedArray(&nestedType, &arrayType, 3), &pair, false)
  let mut staticRegion = Vector<Argument>.make()
  run Vector<Argument>.append(&mut staticRegion, Argument.Lifetime {value: run Shared<Lifetime>.make(Lifetime.Static)})
  let mut ownRegion = Vector<Argument>.make()
  run Vector<Argument>.append(&mut ownRegion, Argument.Lifetime {value: run Shared<Lifetime>.make(Lifetime.Parameter {
    declaration: DeclarationId.copy(&pair), ordinal: usize.ZERO,
  })})
  let staticHolder = run Types.intern(Type.Nominal {declaration: DeclarationId.copy(&pair), isPublic: false, arguments: move staticRegion})
  let ownHolder = run Types.intern(Type.Nominal {declaration: DeclarationId.copy(&pair), isPublic: false, arguments: move ownRegion})
  run expectLifetimeOnlyIdentity(run staticRecord(&staticHolder, 1, 2), run staticRecord(&ownHolder, 1, 2), &pair)
  return ()
}

test effect fn staticFloatIdentityKeepsSignedZeroAndUnorderedNaN() -> () ! AssertionError<'static> {
  let plusZero = StaticData.Float {ty: StaticFloatType.F32, bits: 0}
  let minusZero = StaticData.Float {ty: StaticFloatType.F32, bits: 0x80000000}
  let equal = StaticValue.infix(InfixOperator.Equals, &plusZero, &minusZero, 64)
  run Testing.expect(staticBooleanIs(&equal, true), "signed zeros compare equal")
  let nan = StaticData.Float {ty: StaticFloatType.F32, bits: 0x7fc00000}
  let payload32 = StaticValue.floating(StaticFloatType.F32, 0x7fc12345)
  let payload64 = StaticValue.floating(StaticFloatType.F64, 0x7ff8000000001234)
  run Testing.expect(staticOptionFloatBitsAre(&payload32, StaticFloatType.F32, 0x7fc12345), "f32 NaN payload survives static bit admission")
  run Testing.expect(staticOptionFloatBitsAre(&payload64, StaticFloatType.F64, 0x7ff8000000001234), "f64 NaN payload survives static bit admission")
  let unordered = StaticValue.infix(InfixOperator.LessThan, &nan, &plusZero, 64)
  let unequal = StaticValue.infix(InfixOperator.NotEquals, &nan, &nan, 64)
  run Testing.expect(staticBooleanIs(&unordered, false), "NaN is unordered")
  run Testing.expect(staticBooleanIs(&unequal, true), "NaN differs from itself")
  let negated = StaticValue.prefix(PrefixOperator.Negate, &plusZero, 64)
  run Testing.expect(staticFloatBitsAre(&negated, 0x80000000), "negating zero preserves its sign bit")
  return ()
}

test effect fn scalarEnumDemandChecksDiscriminantSequence() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let entry = run module("enum-values.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "struct Empty {}\nstruct Resource {}\nimpl Intrinsic.Drop for Resource {}\nenum(i8) Exit { Start, Rewind = -2, Next }\nenum(u8) Separated { Ten = 1_0 }\nenum(u8) Named { Same, Same }\nenum(u8) Duplicate { First = 1, Second = 1 }\nenum(u8) Range { Bad = 256 }\nenum(u8) Overflow { Max = 255, Next }\nenum(u8) Negative { Bad = -1 }\n"
  let source = run present(text) |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let emptyIdentity = run Semantic.demandIdentity(&mut semantic, &mut request, &entry, b"Empty")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let emptyType = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&emptyIdentity, nominalResult)
  let mut pureNominalUnsupported = false
  if let Option<Shared<Type>>.Some {value: ty} = move emptyType {
    let unsupported = StaticValue.aggregate(Shared<Type>.clone(&ty), Option<usize>.none(), Vector<Shared<StaticData>>.make())
    let record = StaticValue.record(Shared<Type>.clone(&ty), Vector<Shared<StaticData>>.make())
    let tupleValue = StaticValue.tupleValue(Shared<Type>.clone(&ty), Vector<Shared<StaticData>>.make())
    let variant = StaticValue.unionVariant(Shared<Type>.clone(&ty), usize.ZERO, Vector<Shared<StaticData>>.make())
    let optional = StaticValue.optionalVariant(move ty, usize.ZERO, Vector<Shared<StaticData>>.make())
    pureNominalUnsupported = staticIsNone(&unsupported) && !StaticValue.pure(&record) && !StaticValue.pure(&tupleValue) && !StaticValue.pure(&variant) && !StaticValue.pure(&optional)
  }
  let resourceIdentity = run Semantic.demandIdentity(&mut semantic, &mut request, &entry, b"Resource")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let resourceType = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&resourceIdentity, nominalResult)
  let implementations = run Semantic.demandImplementations(&mut semantic, &mut request, &entry)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let hasDropHead = Shared<Result<Answer, NoRejection>>.with<usize>(&implementations, headCount) == usize.ONE
  let mut cleanupNominalRejected = false
  if let Option<Shared<Type>>.Some {value: ty} = move resourceType {
    let unsupported = StaticValue.aggregate(move ty, Option<usize>.none(), Vector<Shared<StaticData>>.make())
    cleanupNominalRejected = staticIsNone(&unsupported)
  }
  run Testing.expect(pureNominalUnsupported && hasDropHead && cleanupNominalRejected, "source-backed cleanup nominal and unproven pure nominal are Unsupported until M2.5")
  let valid = run Semantic.demandMembers(&mut semantic, &mut request, &entry, b"Exit")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&valid, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return enumMemberIs(answer, 0, StaticSign.Positive, 0) && enumMemberIs(answer, 1, StaticSign.Negative, 2) && enumMemberIs(answer, 2, StaticSign.Negative, 1)
  }), "enum members retain exact explicit and implicit discriminants")
  let separated = run Semantic.demandMembers(&mut semantic, &mut request, &entry, b"Separated")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&separated, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return enumMemberIs(answer, 0, StaticSign.Positive, 10)
  }), "decimal enum discriminants accept separators")
  let duplicate = run Semantic.demandMembers(&mut semantic, &mut request, &entry, b"Duplicate")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsRelated(&duplicate, RejectionCode.DuplicateEnumDiscriminant, offsetOf(text, "Second = 1", usize.ZERO) + 9, offsetOf(text, "First = 1", usize.ZERO) + 8), "duplicate enum values relate both discriminants")
  let duplicateName = run Semantic.demandMembers(&mut semantic, &mut request, &entry, b"Named")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsRelated(&duplicateName, RejectionCode.DuplicateEnumMember, offsetOf(text, "Same", 1), offsetOf(text, "Same", usize.ZERO)), "duplicate enum names relate both name tokens")
  let outOfRange = run Semantic.demandMembers(&mut semantic, &mut request, &entry, b"Range")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsFrom(&outOfRange, RejectionCode.EnumDiscriminantOutOfRange, offsetOf(text, "256", usize.ZERO)), "explicit enum values stay in representation range")
  let overflow = run Semantic.demandMembers(&mut semantic, &mut request, &entry, b"Overflow")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsFrom(&overflow, RejectionCode.EnumImplicitOverflow, offsetOf(text, "Next", 1)), "implicit enum successor cannot overflow")
  let negative = run Semantic.demandMembers(&mut semantic, &mut request, &entry, b"Negative")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsFrom(&negative, RejectionCode.UnsignedEnumNegative, offsetOf(text, "-1", usize.ZERO)), "unsigned enum rejects a negative discriminant")
  return ()
}

test effect fn staticValueMatchesResolvedType() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let boolName = run Bytes.copy(b"bool") |> Effect.provideMut<Allocator>(&mut allocator)
  let boolType = run Types.intern(Type.Primitive {name: move boolName})
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let staticLifetime = run Shared<Lifetime>.make(Lifetime.Static)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let stringType = run Types.intern(Type.String {lifetime: move staticLifetime})
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let boolean = run Shared<StaticData>.make(StaticData.Boolean {value: true})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let textBytes = run Bytes.copy(b"hello") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = run Shared<StaticData>.make(StaticData.Text {bytes: move textBytes})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let acceptsBool = run StaticValue.matchesType(&boolean, &boolType)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let rejectsBoolAsString = run StaticValue.matchesType(&boolean, &stringType)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let acceptsString = run StaticValue.matchesType(&text, &stringType)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(acceptsBool && !rejectsBoolAsString && acceptsString,
    "resolved primitive and string types admit only matching static scalars")
  let extent = run Bytes.copy(b"2") |> Effect.provideMut<Allocator>(&mut allocator)
  let arrayType = run Types.intern(Type.Array {
    element: Shared<Type>.clone(&boolType), extent: move extent,
  }) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut fields = Vector<Shared<StaticData>>.make()
  run Vector<Shared<StaticData>>.append(&mut fields, Shared<StaticData>.clone(&boolean))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run Shared<StaticData>.make(StaticData.Boolean {value: false})
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Vector<Shared<StaticData>>.append(&mut fields, move second)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let acceptedArray = StaticValue.aggregate(Shared<Type>.clone(&arrayType), Option<usize>.none(), move fields)
  let array = match move acceptedArray {
    Option<StaticData>.Some {value} => run Shared<StaticData>.make(move value)
      |> Effect.provideMut<Allocator>(&mut allocator)
    Option<StaticData>.None => { return run Testing.expect(false, "pure fixed array constructs") }
  }
  let acceptsArray = run StaticValue.matchesType(&array, &arrayType)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut wrongFields = Vector<Shared<StaticData>>.make()
  run Vector<Shared<StaticData>>.append(&mut wrongFields, Shared<StaticData>.clone(&boolean))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let wrongElement = run Shared<StaticData>.make(StaticData.Integer {
    ty: StaticIntegerType.U32, sign: StaticSign.Positive, magnitude: 1,
  }) |> Effect.provideMut<Allocator>(&mut allocator)
  run Vector<Shared<StaticData>>.append(&mut wrongFields, move wrongElement)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mismatchedArray = StaticValue.aggregate(Shared<Type>.clone(&arrayType), Option<usize>.none(), move wrongFields)
  let wrongArray = match move mismatchedArray {
    Option<StaticData>.Some {value} => run Shared<StaticData>.make(move value)
      |> Effect.provideMut<Allocator>(&mut allocator)
    Option<StaticData>.None => { return run Testing.expect(false, "wrong child still constructs") }
  }
  let rejectsWrongChild = run StaticValue.matchesType(&wrongArray, &arrayType)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(acceptsArray && !rejectsWrongChild,
    "fixed-array admission compares every child with the canonical element type")
  return ()
}

test effect fn staticTextAndAggregateRejectBorrowedStorage() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let validBytes = run Bytes.copy(b"ok") |> Effect.provideMut<Allocator>(&mut allocator)
  let valid = StaticValue.text(move validBytes)
  run Testing.expect(staticIsText(&valid), "static text admits valid UTF-8")
  let mut copiedText = false
  if let Option<StaticData>.Some {value} = move valid {
    let shared = run Shared<StaticData>.make(move value) |> Effect.provideMut<Allocator>(&mut allocator)
    let copied = run StaticValue.textBytes(&shared) |> Effect.provideMut<Allocator>(&mut allocator)
    if let Option<Bytes>.Some {value: bytes} = move copied {
      copiedText = sameBytes(Bytes.asSlice(&bytes), b"ok")
    }
  }
  run Testing.expect(copiedText, "shared static text can be copied for a diagnostic")
  let mut invalidBytes = run Bytes.copy(b"ok") |> Effect.provideMut<Allocator>(&mut allocator)
  let mut raw = Bytes.asMutSlice(&mut invalidBytes)
  raw[usize.ZERO] = 255
  let invalid = StaticValue.text(move invalidBytes)
  run Testing.expect(staticIsNone(&invalid), "static text rejects invalid UTF-8")
  let unitType = run Types.intern(Type.Unit) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let extent = run Bytes.copy(b"1") |> Effect.provideMut<Allocator>(&mut allocator)
  let arrayType = run Types.intern(Type.Array {element: Shared<Type>.clone(&unitType), extent: move extent})
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let constructionType = Shared<Type>.clone(&arrayType)
  let mut fields = Vector<Shared<StaticData>>.make()
  let mut constructionFields = Vector<Shared<StaticData>>.make()
  let unitValue = run Shared<StaticData>.make(StaticData.Unit)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Vector<Shared<StaticData>>.append(&mut fields, Shared<StaticData>.clone(&unitValue))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Vector<Shared<StaticData>>.append(&mut constructionFields, move unitValue)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let aggregate = StaticValue.aggregate(move arrayType, Option<usize>.none(), move fields)
  run Testing.expect(staticHasUnitField(&aggregate), "static aggregate projection returns a reusable value")
  let constructed = StaticValue.fixedArray(move constructionType, move constructionFields)
  let mut constructionOnly = false
  if let Option<StaticData>.Some {value} = move constructed {
    constructionOnly = !StaticValue.pure(&value)
  }
  run Testing.expect(constructionOnly, "a configuration array is construction-only before Shape admission")
  let environment = run Shared<Intersection>.make(Intersection {members: Vector<LifetimeMember>.make()})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let requirements = run Shared<Row>.make(Row.empty())
    |> Effect.provideMut<Allocator>(&mut allocator)
  let deferred = Type.Effect {
    mode: CallableMode.Shared,
    environment: move environment,
    success: Shared<Type>.clone(&unitType),
    failure: Shared<Type>.clone(&unitType),
    requirements: move requirements,
  }
  let forbiddenEffect = StaticValue.intrinsicallyForbidden(&deferred)
  run Testing.expect(forbiddenEffect, "an Effect cannot enter static aggregate storage")
  let deferredType = run Types.intern(move deferred) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let emptyExtent = run Bytes.copy(b"0") |> Effect.provideMut<Allocator>(&mut allocator)
  let deferredArray = run Types.intern(Type.Array {element: move deferredType, extent: move emptyExtent})
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let forbiddenAggregate = StaticValue.aggregate(move deferredArray, Option<usize>.none(), Vector<Shared<StaticData>>.make())
  run Testing.expect(staticIsNone(&forbiddenAggregate), "an empty array of Effects is not a static aggregate")
  let lifetime = run Shared<Lifetime>.make(Lifetime.Static) |> Effect.provideMut<Allocator>(&mut allocator)
  let borrowed = Type.Reference {referent: move unitType, access: Access.Shared, lifetime: move lifetime}
  let forbiddenBorrow = StaticValue.intrinsicallyForbidden(&borrowed)
  run Testing.expect(forbiddenBorrow, "a borrow cannot enter static aggregate storage")
  return ()
}

test effect fn selectedTargetChecksPointerSizedLiteralMagnitudes() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let entry = run module("target-literals.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "fn localContext() -> usize { let value: usize = 4294967296 return value }\nfn returnContext() -> usize { return 4294967296 }\nfn signed() -> isize { return 2147483648 }\nfn minimum() -> isize { return -2147483648 }\nfn fixed() -> u64 { return 4294967296 }\nfn maximum() -> usize { return 4294967295 }\n"
  let source = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut wasm = Semantic.traced(
    run Revision.copy(&revision) |> Effect.provideMut<Allocator>(&mut allocator),
    MachineTarget.forId(TargetId.Wasm32UnknownUnknown),
    Option<FinalProfile>.none(),
  )
  let mut native = Semantic.traced(
    move revision,
    MachineTarget.forId(TargetId.X8664UnknownLinuxGnu),
    Option<FinalProfile>.none(),
  )
  let mut wasmRequest = Request.make()
  let mut nativeRequest = Request.make()
  let wasmLocal = run Semantic.demandBody(&mut wasm, &mut wasmRequest, &entry, b"localContext")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let wasmReturn = run Semantic.demandBody(&mut wasm, &mut wasmRequest, &entry, b"returnContext")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let wasmSigned = run Semantic.demandBody(&mut wasm, &mut wasmRequest, &entry, b"signed")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let wasmMinimum = run Semantic.demandBody(&mut wasm, &mut wasmRequest, &entry, b"minimum")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let wasmFixed = run Semantic.demandBody(&mut wasm, &mut wasmRequest, &entry, b"fixed")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let wasmMaximum = run Semantic.demandBody(&mut wasm, &mut wasmRequest, &entry, b"maximum")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let nativeLocal = run Semantic.demandBody(&mut native, &mut nativeRequest, &entry, b"localContext")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let nativeReturn = run Semantic.demandBody(&mut native, &mut nativeRequest, &entry, b"returnContext")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let nativeSigned = run Semantic.demandBody(&mut native, &mut nativeRequest, &entry, b"signed")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsFrom(&wasmLocal, RejectionCode.IntegerOutOfRange, offsetOf(text, "4294967296", 0)),
    "wasm32 rejects the annotated usize above its maximum at the literal",
  )
  run Testing.expect(
    rejectsFrom(&wasmReturn, RejectionCode.IntegerOutOfRange, offsetOf(text, "4294967296", 1)),
    "wasm32 rejects the return-context usize above its maximum at the literal",
  )
  run Testing.expect(
    rejectsFrom(&wasmSigned, RejectionCode.IntegerOutOfRange, offsetOf(text, "2147483648", 0)),
    "wasm32 rejects the signed isize above its maximum at the literal",
  )
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<AnswerView>(&wasmMaximum, inspect).success &&
      Shared<Result<Answer, NoRejection>>.with<AnswerView>(&wasmMinimum, inspect).success &&
      Shared<Result<Answer, NoRejection>>.with<AnswerView>(&wasmFixed, inspect).success,
    "wasm32 accepts its usize maximum, its signed minimum and a wide fixed u64",
  )
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<AnswerView>(&nativeLocal, inspect).success &&
      Shared<Result<Answer, NoRejection>>.with<AnswerView>(&nativeReturn, inspect).success &&
      Shared<Result<Answer, NoRejection>>.with<AnswerView>(&nativeSigned, inspect).success,
    "a 64-bit target accepts the same pointer-sized magnitudes",
  )
  return ()
}

test effect fn closedOperatorsKeepExactOperandsAndRuntimeOrder() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let entry = run module("closed-operators.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "fn add(left: i32, right: i32) -> i32 { return left + right }\nfn literalRight(left: u8) -> u8 { return left + 1 }\nfn literalLeft(right: u8) -> u8 { return 1 + right }\nfn equal(left: bool, right: bool) -> bool { return left == right }\nfn bitwise(left: u16, right: u16) -> u16 { return left ^ right }\nfn pointerSized(left: usize, right: usize) -> usize { return left + right }\nfn mismatch(left: i32, right: u8) -> i32 { return left + right }\nfn noOrder(left: bool, right: bool) -> bool { return left < right }\nfn noNegate(value: u8) -> u8 { return -value }\nfn contextual(value: usize) -> usize { return value + 7 }\n"
  let source = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let add = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"add")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let literalRight = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"literalRight")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let literalLeft = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"literalLeft")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let equal = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"equal")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let bitwise = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"bitwise")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let pointerSized = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"pointerSized")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mismatch = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"mismatch")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let noOrder = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"noOrder")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let noNegate = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"noNegate")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let contextual = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"contextual")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<AnswerView>(&add, inspect).success &&
    Shared<Result<Answer, NoRejection>>.with<AnswerView>(&literalRight, inspect).success &&
    Shared<Result<Answer, NoRejection>>.with<AnswerView>(&literalLeft, inspect).success &&
    Shared<Result<Answer, NoRejection>>.with<AnswerView>(&equal, inspect).success &&
    Shared<Result<Answer, NoRejection>>.with<AnswerView>(&bitwise, inspect).success &&
    Shared<Result<Answer, NoRejection>>.with<AnswerView>(&pointerSized, inspect).success,
    "closed operators accept exact scalar operands and contextual integer literals",
  )
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<AnswerView>(&contextual, inspect).success,
    "an in-range contextual usize participates in a selected-target operator",
  )
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<bool>(&mismatch, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionCode(answer, RejectionCode.MissingOperator)
    }) &&
    Shared<Result<Answer, NoRejection>>.with<bool>(&noOrder, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionCode(answer, RejectionCode.MissingOperator)
    }) &&
    Shared<Result<Answer, NoRejection>>.with<bool>(&noNegate, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionCode(answer, RejectionCode.MissingOperator)
    }),
    "closed operators reject unlike numeric types and unsupported scalar operations",
  )
  return ()
}

fn interfaceOperandsRemainOrdered(body: &TypedBody, concrete: bool) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.InterfaceCall {implementation, arguments, ..}, ..} = &nodes[at].kind {
      let values = Vector<BodyNodeId>.asSlice(&arguments)
      if values.length != usize.add(1, 1) || values[usize.ZERO].index >= nodes.length || values[usize.ONE].index >= nodes.length {
        return false
      }
      let witness = match &implementation {
        Option<Shared<DeclarationId>>.Some {value: _} => true
        Option<Shared<DeclarationId>>.None => false
      }
      let bodies = TypedBody.runtimeBodies(body)
      let mut required = bodies.length == usize.ZERO
      if concrete {
        required = bodies.length == usize.ONE
      }
      return witness == concrete && required && nodes[values[usize.ZERO].index].origin.location.start < nodes[values[usize.ONE].index].origin.location.start
    }
    at = at + usize.ONE
  }
  return false
}

test effect fn boundOperatorsSelectOneBoundOrConcreteCall() -> ()
  ! FileError
    | HostInputError
    | InvalidModulePath
    | OutOfMemoryError
    | Cycle
    | RevisionMismatch
    | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let entry = run module("bound-operators.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "import silk.ops { Add }\nstruct Solo {}\nimpl Add<Solo, Solo> for Solo { fn add(left: Self, right: Solo) -> Solo { return move left } }\nfn concrete(left: Solo, right: Solo) -> Solo { return move left + move right }\nfn bounded<T: Add<T, T>>(left: T, right: T) -> T { return move left + move right }\ninterface Plain { fn add(left: Self, right: Self) -> Self }\nstruct Bare {}\nimpl Plain for Bare { fn add(left: Self, right: Self) -> Self { return left } }\nfn unmarked(left: Bare, right: Bare) -> Bare { return left + right }\n"
  let source = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let published = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run withOperatorInterfaces(&published)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let concrete = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"concrete")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let bounded = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"bounded")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let unmarked = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"unmarked")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let concreteTyped = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(
    &concrete, checkedBody,
  )
  let boundTyped = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(
    &bounded, checkedBody,
  )
  let concreteOrder = match move concreteTyped {
    Option<Shared<TypedBody>>.Some {value} => Shared<TypedBody>.with<bool>(&value, fn(body: &TypedBody) -> bool {
      return interfaceOperandsRemainOrdered(body, true)
    })
    Option<Shared<TypedBody>>.None => false
  }
  let boundOrder = match move boundTyped {
    Option<Shared<TypedBody>>.Some {value} => Shared<TypedBody>.with<bool>(&value, fn(body: &TypedBody) -> bool {
      return interfaceOperandsRemainOrdered(body, false)
    })
    Option<Shared<TypedBody>>.None => false
  }
  run Testing.expect(
    concreteOrder && boundOrder &&
    Shared<Result<Answer, NoRejection>>.with<bool>(&unmarked, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionCode(answer, RejectionCode.MissingOperator)
    }),
    "operator selection keeps source operand order and uses only the operator's bound interface",
  )
  return ()
}

test effect fn operatorsBindToSealedIntrinsicInterfaces() -> ()
  ! FileError
    | HostInputError
    | InvalidModulePath
    | OutOfMemoryError
    | Cycle
    | RevisionMismatch
    | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let entry = run module("sealed-operators.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "struct Solo {}\nimpl Intrinsic.Add<Solo, Solo> for Solo { fn add(left: Self, right: Solo) -> Solo { return move left } }\nfn concrete(left: Solo, right: Solo) -> Solo { return move left + move right }\nfn bounded<T: Intrinsic.Add<T, T>>(left: T, right: T) -> T { return move left + move right }\nfn scalar() -> i32 { return bounded<i32>(40, 2) }\npub type Add = Intrinsic.Add\npub type Order = Intrinsic.Order\nfn alias<T: Add<T, T>>(left: T, right: T) -> T { return move left + move right }\nfn ordered<T: Order>(left: &T, right: &T) -> bool { return left < right }\nfn ranked() -> bool { let left = 1 let right = 2 return ordered<i32>(&left, &right) }\nfn directSum() -> i32 { return Intrinsic.Add<i32, i32>.add(40, 2) }\npub type Ordering = Intrinsic.Ordering\nfn orderingValue() -> i32 { let choice: Ordering = Ordering.Less return match choice { Ordering.Less => 42\nOrdering.Equal => 0\nOrdering.Greater => 1 } }\nfn unknown<T: Intrinsic.Plus<T, T>>(value: T) -> i32 { return 0 }\n"
  let source = run present(text) |> Effect.provideMut<Allocator>(&mut allocator)
  let published = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run withSealedOperatorInterfaces(&published)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let invalid = run module("sealed-invalid.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let invalidText = "impl Intrinsic.Add<i32, i32> for i32 { add: Intrinsic.i32Add }"
  let invalidSource = run present(invalidText) |> Effect.provideMut<Allocator>(&mut allocator)
  let withInvalid = run Revision.publish(&revision, &invalid, &invalidSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let imported = run module("sealed-import.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let importText = "import intrinsic.operators { Add }\nfn refused<T: Add<T, T>>(value: T) -> T { return move value }"
  let importSource = run present(importText) |> Effect.provideMut<Allocator>(&mut allocator)
  let complete = run Revision.publish(&withInvalid, &imported, &importSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move complete)
  let mut request = Request.make()
  let concrete = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"concrete")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let bounded = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"bounded")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let scalar = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"scalar")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let alias = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"alias")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let ordered = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"ordered")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let ranked = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"ranked")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let directSum = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"directSum")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let orderingValue = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"orderingValue")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unknown = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"unknown")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let misplaced = run Semantic.demandImplementations(&mut semantic, &mut request, &invalid)
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let importAnswer = run Semantic.demandSignature(
    &mut semantic,
    &mut request,
    &imported,
    b"refused"
  )
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let concreteOrder = match move Shared<
    Result<Answer, NoRejection>
  >.with<Option<Shared<TypedBody>>>(&concrete, checkedBody) {
    Option<Shared<TypedBody>>.Some {
      value
    } => Shared<TypedBody>.with<bool>(
      &value,
      fn(body: &TypedBody) -> bool {
        return interfaceOperandsRemainOrdered(body, true)
      }
    )
    Option<Shared<TypedBody>>.None => false
  }
  let boundOrder = match move Shared<
    Result<Answer, NoRejection>
  >.with<Option<Shared<TypedBody>>>(&bounded, checkedBody) {
    Option<Shared<TypedBody>>.Some {
      value
    } => Shared<TypedBody>.with<bool>(
      &value,
      fn(body: &TypedBody) -> bool {
        return interfaceOperandsRemainOrdered(body, false)
      }
    )
    Option<Shared<TypedBody>>.None => false
  }
  run Testing.expect(
    concreteOrder && boundOrder,
    "an operator binds to its sealed Intrinsic interface for a source conformance and a bound"
  )
  run Testing.expect(
    succeeded(&scalar),
    "a bound applied at a scalar selects the sealed scalar conformance"
  )
  run Testing.expect(
    succeeded(&alias),
    "a public unapplied alias forwards Intrinsic.Add type arguments"
  )
  run Testing.expect(
    succeeded(&ordered) && succeeded(&ranked),
    "generic less-than uses the sealed Order bound and its scalar conformance"
  )
  run Testing.expect(
    succeeded(&directSum),
    "an explicitly applied sealed interface qualifies its ordinary operation call"
  )
  run Testing.expect(
    succeeded(&orderingValue),
    "a public alias of the sealed enum supplies values and match patterns"
  )
  run Testing.expect(
    rejectsSpan(&unknown, RejectionCode.UnknownOperation, text, "Intrinsic.Plus", usize.ZERO),
    "a member the sealed module does not declare is unknown at its spelling"
  )
  run Testing.expect(
    rejectsSpan(&misplaced, RejectionCode.ConformanceOwner, invalidText, invalidText, usize.ZERO),
    "IMPL-004 rejects a scalar conformance outside the sealed interface module"
  )
  run Testing.expect(
    rejectsSpan(
      &importAnswer,
      RejectionCode.MissingModule,
      importText,
      "intrinsic.operators",
      usize.ZERO
    ),
    "INTR-007 rejects an import even when the sealed source is already present"
  )
  return ()
}

fn singleOperatorIdentity(answer: &Result<Answer, NoRejection>) -> Option<Shared<DeclarationId>> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Operations {operations}} = &value.outcome {
      let listed = Vector<Shared<DeclarationId>>.asSlice(&operations)
      if listed.length == usize.ONE { return Option<Shared<DeclarationId>>.some(Shared<DeclarationId>.clone(&listed[0])) }
    }
  }
  return Option<Shared<DeclarationId>>.none()
}

fn borrowedOperatorBindings(value: &Vector<Binding>, operation: &DeclarationId, left: &Shared<Lifetime>, right: &Shared<Lifetime>, firstOriginal: usize) -> bool {
  let learned = Vector<Binding>.asSlice(value)
  if learned.length != 2 { return false }
  let mut slot = usize.ZERO
  while slot < learned.length {
    let mut original = firstOriginal
    if slot != usize.ZERO { original = usize.ONE - firstOriginal }
    if learned[slot].ordinal != original || !Shared<DeclarationId>.with<bool>(&learned[slot].declaration,
      fn(identity: &DeclarationId) -> bool { return DeclarationId.equals(identity, operation) }) { return false }
    if let Argument.Lifetime {value: region} = &learned[slot].value {
      if slot == usize.ZERO {
        if !Lifetime.equalsShared(&region, left) { return false }
      } else if !Lifetime.equalsShared(&region, right) { return false }
    } else { return false }
    slot = slot + usize.ONE
  }
  return true
}

fn borrowedOperatorOperandRegion(node: &BodyNode) -> Option<Shared<Lifetime>> {
  return match &node.kind {
    BodyNodeKind.Expression {ty, ..} => Shared<Type>.with<Option<Shared<Lifetime>>>(&ty, receiverReferenceRegion)
    _ => Option<Shared<Lifetime>>.none()
  }
}

fn borrowedOperatorCall(body: &TypedBody, expected: &Shared<DeclarationId>, concrete: bool, borrowedResult: bool, firstOriginal: usize) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form: BodyExpression.InterfaceCall {operation, implementation, arguments, bindings, ..}} = &nodes[at].kind {
      if !Shared<DeclarationId>.with<bool>(expected, fn(identity: &DeclarationId) -> bool {
        return DeclarationId.equals(identity, &operation)
      }) { return false }
      let bodies = TypedBody.runtimeBodies(body)
      match &implementation {
        Option<Shared<DeclarationId>>.Some {value} => {
          if !concrete || bodies.length != usize.ONE || !DeclarationId.named(&bodies[0], b"equals") { return false }
          let retained = Shared<DeclarationId>.with<bool>(&value,
            fn(identity: &DeclarationId) -> bool { return DeclarationId.equals(identity, &bodies[0]) })
          if !retained { return false }
        }
        Option<Shared<DeclarationId>>.None => {
          if concrete || bodies.length != usize.ZERO { return false }
        }
      }
      let supplied = Vector<BodyNodeId>.asSlice(&arguments)
      if supplied.length != 2 || supplied[0].index >= nodes.length || supplied[1].index >= nodes.length { return false }
      if nodes[supplied[0].index].origin.location.start >= nodes[supplied[1].index].origin.location.start { return false }
      let first = borrowedOperatorOperandRegion(&nodes[supplied[0].index])
      let second = borrowedOperatorOperandRegion(&nodes[supplied[1].index])
      if let Option<Shared<Lifetime>>.Some {value: left} = move first {
        if let Option<Shared<Lifetime>>.Some {value: right} = move second {
          if Lifetime.equalsShared(&left, &right) { return false }
          let caller = TypedBody.declarationId(body)
          let firstOwned = Shared<Lifetime>.with<bool>(&left, fn(region: &Lifetime) -> bool {
            return match &region.* { Lifetime.Parameter {declaration, ordinal} => DeclarationId.equals(&declaration, caller) && ordinal == usize.ZERO _ => false }
          })
          let secondOwned = Shared<Lifetime>.with<bool>(&right, fn(region: &Lifetime) -> bool {
            return match &region.* { Lifetime.Parameter {declaration, ordinal} => DeclarationId.equals(&declaration, caller) && ordinal == usize.ONE _ => false }
          })
          if !firstOwned || !secondOwned { return false }
          let exact = Shared<Vector<Binding>>.with<bool>(&bindings, fn(value: &Vector<Binding>) -> bool {
            return borrowedOperatorBindings(value, &operation, &left, &right, firstOriginal)
          })
          if !exact { return false }
          if borrowedResult {
            let resultRegion = Shared<Type>.with<Option<Shared<Lifetime>>>(&ty, receiverReferenceRegion)
            if let Option<Shared<Lifetime>>.Some {value} = move resultRegion { return Lifetime.equalsShared(&value, &left) }
            return false
          }
          return Shared<Type>.with<bool>(&ty, fn(result: &Type) -> bool {
            return match &result.* { Type.Primitive {name} => sameBytes(Bytes.asSlice(&name), b"bool") _ => false }
          })
        }
      }
      return false
    }
    at = at + usize.ONE
  }
  return false
}

fn borrowedOperatorEvidence(answer: &Shared<Result<Answer, NoRejection>>, expected: &Shared<DeclarationId>, concrete: bool, borrowedResult: bool, firstOriginal: usize) -> bool {
  let typed = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move typed {
    return Shared<TypedBody>.with<bool>(&value, fn(body: &TypedBody) -> bool {
      return borrowedOperatorCall(body, expected, concrete, borrowedResult, firstOriginal)
    })
  }
  return false
}

test effect fn borrowedOperatorsInferOnlyTheirLifetimes() -> ()
  ! FileError
    | HostInputError
    | InvalidModulePath
    | OutOfMemoryError
    | Cycle
    | RevisionMismatch
    | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let entry = run module("borrowed-operators.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let contracts = run module("keys.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let equalModule = run module("intrinsic/operators.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let contractText = """import silk.equal { Equal }
pub struct Key { pub value: i32 }
impl Equal for Key {
  fn equals(left: &Self, right: &Self) -> bool { return left.value == right.value }
}
"""
  let text = """import silk.equal { Equal }
import keys { Key }
fn bounded<'x, 'y, K: Equal>(left: &'x K, right: &'y K) -> bool { return left == right }
fn concrete<'x, 'y>(left: &'x Key, right: &'y Key) -> bool { return left == right }
fn wrongAccess<'x, 'y, K: Equal>(left: &'x mut K, right: &'y K) -> bool { return left == right }
"""
  let contractSource = run present(contractText) |> Effect.provideMut<Allocator>(&mut allocator)
  let source = run present(text) |> Effect.provideMut<Allocator>(&mut allocator)
  let r1 = run Revision.publish(&Revision.make(), &contracts, &contractSource) |> Effect.provideMut<Allocator>(&mut allocator)
  let r2 = run Revision.publish(&r1, &entry, &source) |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run withOperatorInterfaces(&r2) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let equalOperations = run Semantic.demandOperations(&mut semantic, &mut request, &equalModule, b"Equal") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let equal = Shared<Result<Answer, NoRejection>>.with<Option<Shared<DeclarationId>>>(&equalOperations, singleOperatorIdentity)
  let bounded = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"bounded") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let concrete = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"concrete") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  if let Option<Shared<DeclarationId>>.Some {value} = move equal {
    run Testing.expect(borrowedOperatorEvidence(&bounded, &value, false, false, usize.ZERO)
      && borrowedOperatorEvidence(&concrete, &value, true, false, usize.ZERO),
      "borrowed generic and concrete operators keep their original target, distinct canonical lifetime bindings and operand order")
  } else { run Testing.expect(false, "Equal publishes exactly one operation") }
  let wrongAccess = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"wrongAccess") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&wrongAccess, RejectionCode.MissingOperator, text, "==", 2),
    "operand inference preserves reference access")
  return ()
}

test effect fn librarySpellingCannotSupplyAnOperatorInterface() -> ()
  ! FileError
    | HostInputError
    | InvalidModulePath
    | OutOfMemoryError
    | Cycle
    | RevisionMismatch
    | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let entry = run module("ordinary-operator-interface.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let ordinary = run module("silk/ops.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let ordinarySource = run present(
    "pub interface Add<Right, Output> { fn add(left: Self, right: Right) -> Output }"
  )
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """import silk.ops { Add }
struct Solo {}
impl Add<Solo, Solo> for Solo { fn add(left: Self, right: Solo) -> Solo { return move left } }
fn concrete(left: Solo, right: Solo) -> Solo { return move left + move right }
fn bounded<T: Add<T, T>>(left: T, right: T) -> T { return move left + move right }
"""
  let source = run present(text) |> Effect.provideMut<Allocator>(&mut allocator)
  let r1 = run Revision.publish(&Revision.make(), &ordinary, &ordinarySource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let r2 = run Revision.publish(&r1, &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run withSealedOperatorInterfaces(&r2)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let concrete = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"concrete")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let bounded = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"bounded")
    |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsSpan(&concrete, RejectionCode.MissingOperator, text, "+", 0)
      && rejectsSpan(&bounded, RejectionCode.MissingOperator, text, "+", 1),
    "an ordinary Add declaration gains no operator privilege from its library path or member spelling"
  )
  return ()
}

test effect fn competingOperatorConformancesRejectWithoutResultContextChoice() -> ()
  ! FileError
    | HostInputError
    | InvalidModulePath
    | OutOfMemoryError
    | Cycle
    | RevisionMismatch
    | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let entry = run module("competing-operators.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "import silk.ops { Add }\nstruct Double {}\nimpl Add<Double, Double> for Double { fn add(left: Self, right: Double) -> Double { return left } }\nimpl Add<Double, bool> for Double { fn add(left: Self, right: Double) -> bool { return false } }\nfn competing(left: Double, right: Double) -> Double { return left + right }\n"
  let source = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let published = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run withOperatorInterfaces(&published)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let competing = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"competing")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<bool>(&competing, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionCode(answer, RejectionCode.AmbiguousOperator)
    }),
    "two conformances of the bound interface for the same operands reject without result context choice",
  )
  return ()
}

