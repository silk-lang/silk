effect fn selectedArmDiagnosticClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let id = run module("b12-selected-diagnostic.silk")
  let source = """
fn quiet() -> i32 {
  static if false {
    return missing
  }
  return 0
}
fn loud() -> i32 {
  static if true {
    return missing
  }
  return 0
}
"""
  let authored = run present(source)
  let revision = run Revision.publish(&Revision.make(), &id, &authored)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let quiet = run selectedApplicationOf(&mut index, &id, b"quiet")
  let loud = run selectedApplicationOf(&mut index, &id, b"loud")
  let mut store = makeSemantic(run Revision.copy(&revision))
  let mut request = Request.make()
  let inactive = run Semantic.demandSelectedBody(&mut store, &mut request, &quiet)
  let active = run Semantic.demandSelectedBody(&mut store, &mut request, &loud)
  let missingStart = offsetOf(source, "missing", usize.ONE)
  run Testing.expect(succeeded(&inactive), "an unknown name in the inactive arm is not resolved")
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&active, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionAt(answer, RejectionCode.UnknownName, missingStart)
    }), "the same unknown name in the selected arm reports its exact code and span")
  return ()
}

test effect fn selectedRoutingCoversContainersAndModules() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run selectedRoutingContainerClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Which body a function's MIR lowered: 0 when it demanded none, 1 for the declaration's abstract
// body (a later abstract demand reuses it), 2 for a selected body (that demand starts anew).
effect fn loweredBodyKind(store: &mut Semantic, id: &ModuleId, name: &[u8]) -> usize
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError
? &mut Allocator {
  let mut request = Request.make()
  let initial = starts(Semantic.eventLog(&store.*), Family.Body)
  let mir = run Semantic.demandMir(&mut store.*, &mut request, id, name)
  drop mir
  let before = starts(Semantic.eventLog(&store.*), Family.Body)
  if before != initial + usize.ONE { return usize.ZERO }
  let declared = run Semantic.demandBody(&mut store.*, &mut request, id, name)
  drop declared
  if starts(Semantic.eventLog(&store.*), Family.Body) == before { return usize.ONE }
  return 2
}

effect fn selectedRoutingContainerClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let library = run module("routinglibrary.silk")
  let id = run module("b12-selected-containers.silk")
  let librarySource = run present("pub static fn amount(base: i32) -> i32 { return base * 10 + 1 }\n")
  let source = """
import routinglibrary as Library
struct Box { value: i32 }
fn qualified(value: i32) -> i32 { return Library.amount(2) + value }
fn inUnsafe() -> i32 {
  unsafe {
    static if true {
      return 1
    }
  }
  return 0
}
fn inIfLet(box: Box) -> i32 {
  if let Box {value} = move box {
    let static scaled = 3
    return scaled
  }
  return 0
}
fn inMatch(flag: bool) -> i32 {
  match flag {
    _ => {
      static if true {
        return 1
      }
    }
  }
  return 0
}
fn inClosure() -> i32 {
  let inner = fn() -> i32 {
    static if true {
      return 1
    }
    return 0
  }
  return 0
}
fn hidden() -> i32 { return missing }
fn pick() -> i32 {
  static if false {
    return hidden()
  }
  return 0
}
"""
  let authored = run present(source)
  let withLibrary = run Revision.publish(&Revision.make(), &library, &librarySource)
  let revision = run Revision.publish(&withLibrary, &id, &authored)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let qualified = run selectedApplicationOf(&mut index, &id, b"qualified")
  let inIfLet = run selectedApplicationOf(&mut index, &id, b"inIfLet")
  let inMatch = run selectedApplicationOf(&mut index, &id, b"inMatch")
  let mut store = makeSemantic(run Revision.copy(&revision))
  let mut request = Request.make()
  let qualifiedMir = run Semantic.demandMir(&mut store, &mut request, &id, b"qualified")
  run Testing.expect(succeeded(&qualifiedMir) && mirReferenceCount(&store, &qualifiedMir) == usize.ZERO,
    "on a fresh store, an imported static helper routes its caller and creates no runtime reference")
  let qualifiedBody = run Semantic.demandSelectedBody(&mut store, &mut request, &qualified)
  let qualifiedShape = run selectedShape(&qualifiedBody)
  run Testing.expect(sameShape(&qualifiedShape, usize.ONE, usize.ZERO, usize.ZERO),
    "the imported static helper's result is one embedded value with no runtime call")
  let unsafeKind = run loweredBodyKind(&mut store, &id, b"inUnsafe")
  let unsafeMir = run Semantic.demandMir(&mut store, &mut request, &id, b"inUnsafe")
  run Testing.expect(unsafeKind == 2 && succeeded(&unsafeMir),
    "a static if inside an unsafe block routes and its decision is selected")
  // The selected member MIR demanded is exactly the application's own: demanding it again is a
  // cache hit.
  let ifLetKind = run loweredBodyKind(&mut store, &id, b"inIfLet")
  let ifLetBodies = starts(Semantic.eventLog(&store), Family.Body)
  let ifLetSelected = run Semantic.demandSelectedBody(&mut store, &mut request, &inIfLet)
  run Testing.expect(ifLetKind == 2 && starts(Semantic.eventLog(&store), Family.Body) == ifLetBodies
      && succeeded(&ifLetSelected),
    "a let static inside an if-let body routes MIR to its selected body, which types the if-let")
  let matchKind = run loweredBodyKind(&mut store, &id, b"inMatch")
  let matchBodies = starts(Semantic.eventLog(&store), Family.Body)
  let matchSelected = run Semantic.demandSelectedBody(&mut store, &mut request, &inMatch)
  run Testing.expect(matchKind == 2 && starts(Semantic.eventLog(&store), Family.Body) == matchBodies
      && succeeded(&matchSelected) && bodyFact(&matchSelected, usize.ZERO) + bodyFact(&matchSelected, usize.ONE) == usize.ONE,
    "a static if inside a match-arm block routes MIR to its selected body, whose bare bool match keeps that block arm")
  let closureKind = run loweredBodyKind(&mut store, &id, b"inClosure")
  run Testing.expect(closureKind == usize.ONE,
    "a static if inside a nested closure does not route the enclosing function")
  let bodiesBefore = starts(Semantic.eventLog(&store), Family.Body)
  let signaturesBefore = starts(Semantic.eventLog(&store), Family.Signature)
  let pickMir = run Semantic.demandMir(&mut store, &mut request, &id, b"pick")
  run Testing.expect(succeeded(&pickMir) && starts(Semantic.eventLog(&store), Family.Body) == bodiesBefore + usize.ONE
      && starts(Semantic.eventLog(&store), Family.Signature) == signaturesBefore + usize.ONE,
    "a private callee named only in an inactive arm has neither its header nor its body demanded")
  return ()
}

test effect fn selectedTypeSelectionReadsReflectedKinds() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run selectedReflectionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// A static evaluation failure surfaced as StaticViolation whose fault is Unsupported for a missing
// intrinsic operation, at exactly `start`.
fn unsupportedKindAt(answer: &Result<Answer, NoRejection>, start: usize) -> bool {
  if let Option<Shared<Rejection>>.Some {value: problem} = move rejection(answer) {
    return Shared.with<Rejection, bool>(&problem, unsupportedKindFailure) && Shared.with<Rejection, bool>(&problem, fn(found: &Rejection) -> bool {
      return found.span.start == start
    })
  }
  return false
}

fn unsupportedKindFailure(found: &Rejection) -> bool {
  if found.code != RejectionCode.StaticViolation { return false }
  return match &found.staticFailure {
    Option<StaticDiagnostic>.Some {value} => value.fault == StaticExecutionFault.Unsupported && match &value.missing {
      Option<StaticMissingFact>.Some {value: fact} => fact == StaticMissingFact.IntrinsicOperation
      Option<StaticMissingFact>.None => false
    }
    Option<StaticDiagnostic>.None => false
  }
}

// Embedded u8 values with this magnitude, as a reflected kind code is embedded.
fn embeddedU8(body: &TypedBody, magnitude: u64) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Embedded {value}, ..} = &nodes[at].kind {
      let matches = Shared.with<StaticData, bool>(&value, fn(data: &StaticData) -> bool {
        return match & data.* {
          StaticData.Integer {ty, sign, magnitude: found} => ty == StaticIntegerType.U8 && sign == StaticSign.Positive && found == magnitude
          _ => false
        }
      })
      if matches { count = count + usize.ONE }
    }
    at = at + usize.ONE
  }
  return count
}

// Integer literal nodes whose source starts at `start`.
fn literalsAt(body: &TypedBody, start: usize) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Integer {..}, ..} = &nodes[at].kind {
      if nodes[at].origin.span.start == start { count = count + usize.ONE }
    }
    at = at + usize.ONE
  }
  return count
}

// The arm literals one selected body retained: (starting at `kept`, starting at `dropped`).
fn selectedLiterals(answer: &Shared<Result<Answer, NoRejection>>, kept: usize, dropped: usize) -> bool {
  let body = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value: typed} = move body {
    return Shared.with<TypedBody, bool>(&typed, fn(checked: &TypedBody) -> bool {
      return literalsAt(checked, kept) == usize.ONE && literalsAt(checked, dropped) == usize.ZERO
    })
  }
  return false
}

fn selectedU8(answer: &Shared<Result<Answer, NoRejection>>, magnitude: u64) -> bool {
  let body = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value: typed} = move body {
    return Shared.with<TypedBody, bool>(&typed, fn(checked: &TypedBody) -> bool {
      return embeddedU8(checked, magnitude) == usize.ONE
    })
  }
  return false
}

// The same two operations `silk.reflect` declares.
fn reflectionWrapperText() -> string<'static> {
  return """pub struct Reflect {}
impl Reflect {
  pub static fn typeOf<Owner>() -> Intrinsic.Type<Owner> {
    return Intrinsic.reflectType<Owner>()
  }
  pub static fn typeKind<Owner>(descriptor: Intrinsic.Type<Owner>) -> u8 {
    return Intrinsic.reflectTypeKind<Owner>(descriptor)
  }
}
"""
}

// Publishes the reflection wrapper module and one program module importing it.
effect fn reflectionRevision(id: &ModuleId, source: string<'static>) -> Revision
! InvalidModulePath | OutOfMemoryError
? &mut Allocator {
  let wrapper = run module("reflection.silk")
  let wrapperSource = run present(reflectionWrapperText())
  let authored = run present(source)
  let withWrapper = run Revision.publish(&Revision.make(), &wrapper, &wrapperSource)
  return run Revision.publish(&withWrapper, id, &authored)
}

effect fn selectedReflectionClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let id = run module("b12-selected-reflection.silk")
  let source = """import reflection { Reflect }
struct Named { value: i32 }
tuple Pair(i32, i32)
fn weight<T>() -> i32 {
  static if Reflect.typeKind<T>(Reflect.typeOf<T>()) == Reflect.typeKind<Named>(Reflect.typeOf<Named>()) {
    return 40
  } else {
    return 2
  }
}
"""
  let revision = run reflectionRevision(&id, source)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let weightDeclaration = run requireIndexedIdentity(&mut index, &id, OwnerKind.Function, b"weight", usize.ZERO)
  let named = run requireIndexedIdentity(&mut index, &id, OwnerKind.Struct, b"Named", usize.ZERO)
  let pair = run requireIndexedIdentity(&mut index, &id, OwnerKind.Tuple, b"Pair", usize.ZERO)
  let mut namedArguments = Vector.make<Argument>()
  run Vector.append<Argument>(&mut namedArguments, Argument.Type {value: run Shared.make<Type>(Type.Nominal {declaration: move named, isPublic: false, arguments: Vector.make<Argument>()})})
  let weightNamed = run specializationWithArguments(&weightDeclaration, move namedArguments)
  let mut pairArguments = Vector.make<Argument>()
  run Vector.append<Argument>(&mut pairArguments, Argument.Type {value: run Shared.make<Type>(Type.Nominal {declaration: move pair, isPublic: false, arguments: Vector.make<Argument>()})})
  let weightPair = run specializationWithArguments(&weightDeclaration, move pairArguments)
  let mut store = makeSemantic(run Revision.copy(&revision))
  let mut request = Request.make()
  let selectedNamed = run Semantic.demandSelectedBody(&mut store, &mut request, &weightNamed)
  let selectedPair = run Semantic.demandSelectedBody(&mut store, &mut request, &weightPair)
  let fortyStart = offsetOf(source, "40", usize.ZERO)
  let twoStart = offsetOf(source, "return 2", usize.ZERO) + 7
  let namedArm = selectedLiterals(&selectedNamed, fortyStart, twoStart)
  let pairArm = selectedLiterals(&selectedPair, twoStart, fortyStart)
  run Testing.expect(namedArm && pairArm,
    "one generic body selects a different static arm for each type argument's reflected kind")
  return ()
}

test effect fn reflectedKindCodesMatchTheLibrary() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run reflectionCodeClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn reflectionCodeClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let id = run module("b12-reflection-codes.silk")
  let source = """import reflection { Reflect }
struct Named { value: i32 }
tuple Pair(i32, i32)
fn namedCode() -> u8 { return Reflect.typeKind<Named>(Reflect.typeOf<Named>()) }
fn pairCode() -> u8 { return Reflect.typeKind<Pair>(Reflect.typeOf<Pair>()) }
fn scalarCode() -> u8 { return Reflect.typeKind<i32>(Reflect.typeOf<i32>()) }
"""
  let revision = run reflectionRevision(&id, source)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let namedCode = run selectedApplicationOf(&mut index, &id, b"namedCode")
  let pairCode = run selectedApplicationOf(&mut index, &id, b"pairCode")
  let scalarCode = run selectedApplicationOf(&mut index, &id, b"scalarCode")
  let wrapperText = reflectionWrapperText()
  let mut store = makeSemantic(run Revision.copy(&revision))
  let mut request = Request.make()
  let namedSelected = run Semantic.demandSelectedBody(&mut store, &mut request, &namedCode)
  let pairSelected = run Semantic.demandSelectedBody(&mut store, &mut request, &pairCode)
  let codes = selectedU8(&namedSelected, 0) && selectedU8(&pairSelected, usize.toU64(usize.ONE))
  run Testing.expect(codes, "reflected kind codes match silk.reflect: a named struct is 0 and a positional tuple is 1")
  let scalarSelected = run Semantic.demandSelectedBody(&mut store, &mut request, &scalarCode)
  let scalarStart = offsetOf(wrapperText, "Intrinsic.reflectTypeKind<Owner>", usize.ZERO)
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&scalarSelected, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return unsupportedKindAt(answer, scalarStart)
    }), "a non-aggregate owner has no kind code: an Unsupported static evaluation at the reflection call, never a fallback code")
  return ()
}

test effect fn reflectedDescriptorsStayOutOfRuntimeCode() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run reflectionBoundaryClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn reflectionBoundaryClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let id = run module("b12-reflection-boundaries.silk")
  let source = """import reflection { Reflect }
struct Named { value: i32 }
fn leak() -> Intrinsic.Type<Named> { return missing }
fn hold(descriptor: Intrinsic.Type<Named>) -> i32 { return 0 }
fn embeds() -> i32 {
  let leaked = Reflect.typeOf<Named>()
  return 0
}
fn direct() -> i32 {
  let described = Intrinsic.reflectType<Named>()
  return 0
}
fn directKind() -> u8 { return Intrinsic.reflectTypeKind<Named>(Intrinsic.reflectType<Named>()) }
"""
  let revision = run reflectionRevision(&id, source)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let leakDeclaration = run requireIndexedIdentity(&mut index, &id, OwnerKind.Function, b"leak", usize.ZERO)
  let holdDeclaration = run requireIndexedIdentity(&mut index, &id, OwnerKind.Function, b"hold", usize.ZERO)
  let embeds = run selectedApplicationOf(&mut index, &id, b"embeds")
  let mut store = makeSemantic(run Revision.copy(&revision))
  let mut request = Request.make()
  let leakSignature = run Semantic.demandSignatureOf(&mut store, &mut request, &leakDeclaration)
  let holdSignature = run Semantic.demandSignatureOf(&mut store, &mut request, &holdDeclaration)
  let leakStart = offsetOf(source, "fn leak", usize.ZERO)
  let holdStart = offsetOf(source, "fn hold", usize.ZERO)
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&leakSignature, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionAt(answer, RejectionCode.StaticPhaseViolation, leakStart)
    }) && Shared.with<Result<Answer, NoRejection>, bool>(&holdSignature, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionAt(answer, RejectionCode.StaticPhaseViolation, holdStart)
    }), "a runtime signature cannot return or accept a phase-only descriptor")
  let embedded = run Semantic.demandSelectedBody(&mut store, &mut request, &embeds)
  let embedStart = offsetOf(source, "Reflect.typeOf<Named>()", usize.ZERO)
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&embedded, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionAt(answer, RejectionCode.StaticPhaseViolation, embedStart)
    }), "a descriptor reaching runtime code through selection is a static phase violation")
  let direct = run Semantic.demandBody(&mut store, &mut request, &id, b"direct")
  let directStart = offsetOf(source, "Intrinsic.reflectType<Named>()", usize.ZERO)
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&direct, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionAt(answer, RejectionCode.StaticPhaseViolation, directStart)
    }), "a reflection intrinsic called by a runtime body is a static phase violation at the call")
  let directKind = run Semantic.demandBody(&mut store, &mut request, &id, b"directKind")
  let directKindStart = offsetOf(source, "Intrinsic.reflectTypeKind<Named>", usize.ZERO)
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&directKind, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionAt(answer, RejectionCode.StaticPhaseViolation, directKindStart)
    }), "a runtime kind reflection is a static phase violation at its own call, before its argument")
  return ()
}

test effect fn internedIdentityHashesFollowEquality() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run internedIdentityHashClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// Hashed interning compares only entries recorded under the probe's hash, so equal values must
// share one: lifetime-distinct borrows are one runtime layout type. Colliding entries are
// presented oldest first, as a scan of the table would meet them.
effect fn internedIdentityHashClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let referent = run Shared.make<Type>(Type.Primitive {name: run Bytes.copy(b"i32")})
  let lasting = run Shared.make<Type>(Type.Reference {referent: Shared.clone<Type>(&referent), access: Access.Shared,
    lifetime: run Shared.make<Lifetime>(Lifetime.Static)})
  let fresh = run Shared.make<Type>(Type.Reference {referent: Shared.clone<Type>(&referent), access: Access.Shared,
    lifetime: run Shared.make<Lifetime>(Lifetime.Invocation {ordinal: usize.ZERO})})
  let runtimeEqual = run Type.runtimeEqualsShared(&lasting, &fresh)
  let exactEqual = run Type.equalsShared(&lasting, &fresh)
  run Testing.expect(runtimeEqual && !exactEqual && Type.hash(&lasting) == Type.hash(&fresh),
    "lifetime-distinct borrows are one runtime type with one hash")
  let mut index = InternIndex.make()
  run InternIndex.record(&mut index, 7)
  run InternIndex.record(&mut index, 9)
  run InternIndex.record(&mut index, 7)
  run InternIndex.record(&mut index, 7)
  let oldest = InternIndex.first(&index, 7)
  let middle = InternIndex.after(&index, oldest)
  let newest = InternIndex.after(&index, middle)
  run Testing.expect(oldest == usize.ZERO && middle == 2 && newest == 3 && InternIndex.after(&index, newest) == usize.MAX
    && InternIndex.first(&index, 9) == usize.ONE && InternIndex.after(&index, usize.ONE) == usize.MAX
    && InternIndex.first(&index, 5) == usize.MAX, "colliding entries are presented oldest first and other hashes stay apart")
  let id = run module("hashed-module-index.silk")
  let source = "fn twice(value: i32) -> i32 { return value }\nfn twice(value: bool) -> bool { return value }\nfn single() -> i32 { return 1 }\n"
  let unit = run SourceUnit.parse(&id, usize.ONE, run Bytes.copy(String.utf8Bytes(source)))
  let moduleIndex = run ModuleIndex.build(&unit)
  let declarations = ModuleIndex.listDeclarations(&moduleIndex)
  run Testing.expect(SourceUnit.diagnosticCount(&unit) == usize.ZERO && declarations.length == 3,
    "the fixture parses cleanly and indexes its three functions")
  let mut located = true
  let mut at = usize.ZERO
  while at < declarations.length {
    if let Option<usize>.Some {value: found} = move ModuleIndex.ordinalOf(&moduleIndex, &declarations[at].identity) {
      located = located && found == at
    } else {
      located = false
    }
    at = at + usize.ONE
  }
  run Testing.expect(located && declarations[usize.ZERO].ambiguous && declarations[usize.ONE].ambiguous
    && !declarations[2].ambiguous, "every declaration is found at its own ordinal and only same-key siblings are ambiguous")
  let firstTop = ModuleIndex.firstEnclosed(&moduleIndex, usize.MAX)
  let secondTop = ModuleIndex.nextEnclosed(&moduleIndex, firstTop)
  let thirdTop = ModuleIndex.nextEnclosed(&moduleIndex, secondTop)
  let localFound = match move ModuleIndex.ordinalAtLocal(&moduleIndex, declarations[usize.ONE].local) {
    Option<usize>.Some {value} => value == usize.ONE
    Option<usize>.None => false
  }
  let prefixFound = match move ModuleIndex.deepestPrefixOf(&moduleIndex, &declarations[2].identity) {
    Option<usize>.Some {value} => value == 2
    Option<usize>.None => false
  }
  run Testing.expect(firstTop == usize.ZERO && secondTop == usize.ONE && thirdTop == 2
    && ModuleIndex.nextEnclosed(&moduleIndex, thirdTop) == usize.MAX
    && ModuleIndex.firstEnclosed(&moduleIndex, usize.ZERO) == usize.MAX && localFound && prefixFound,
    "module-level declarations enclose in source order, a function without nested declarations encloses none, and local nodes and identity prefixes find their declarations")
  let collisions = ModuleIndex.listCollisions(&moduleIndex)
  let mut twiceMembers = usize.ZERO
  if let Option<Shared<NameObservation>>.Some {value: bucket} = move ModuleIndex.cachedName(&moduleIndex, b"twice") {
    twiceMembers = Shared.with<NameObservation, usize>(&bucket, fn(observed: &NameObservation) -> usize {
      return NameObservation.listMembers(observed).length
    })
  }
  let missing = match move ModuleIndex.cachedName(&moduleIndex, b"thrice") {
    Option<Shared<NameObservation>>.Some {..} => false
    Option<Shared<NameObservation>>.None => true
  }
  run Testing.expect(collisions.length == usize.ONE && collisions[usize.ZERO].first == usize.ZERO
    && collisions[usize.ZERO].second == usize.ONE && twiceMembers == 2 && missing,
    "same-name bindings collide once and their cached bucket holds both while an absent name has none")
  return ()
}

test effect fn selectedBodiesRetainExactDemandsAcrossRuntimeFamilies() -> ()
! CanonicalizationFailure | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run selectedCorrespondenceClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// An erased family never skips exact selected-body validation. Complete recipe sharing occurs
// only after closing MIR; these body-lazy demands prove the earlier semantic boundary.
effect fn selectedCorrespondenceClaims() -> ()
! CanonicalizationFailure | InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let id = run module("b12-selected-correspondence.silk")
  let source = """
static fn amount(base: i32) -> i32 { return base * 10 + 1 }
fn tagged<'a>(value: &'a i32) -> i32 {
  let static scaled = amount(2)
  static if true {
    return scaled
  }
  return 0
}
fn site(value: &i32) -> i32 { return 0 }
"""
  let authored = run present(source)
  let revision = run Revision.publish(&Revision.make(), &id, &authored)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let tagged = run requireIndexedIdentity(&mut index, &id, OwnerKind.Function, b"tagged", usize.ZERO)
  let site = run requireIndexedIdentity(&mut index, &id, OwnerKind.Function, b"site", usize.ZERO)
  let mut staticArguments = Vector.make<Argument>()
  run Vector.append<Argument>(&mut staticArguments, Argument.Lifetime {value: run Shared.make<Lifetime>(Lifetime.Static)})
  let first = run specializationWithArguments(&tagged, move staticArguments)
  let mut siteArguments = Vector.make<Argument>()
  run Vector.append<Argument>(&mut siteArguments, Argument.Lifetime {value: run Shared.make<Lifetime>(Lifetime.Parameter {
    declaration: move site, ordinal: usize.ZERO,
  })})
  let second = run specializationWithArguments(&tagged, move siteArguments)
  let firstKey = run requiredCanonicalKey(run InstanceKey.function(run SpecializationApplication.copy(&first)))
  let secondKey = run requiredCanonicalKey(run InstanceKey.function(run SpecializationApplication.copy(&second)))
  run Testing.expect(InstanceKey.sameRuntimeBase(&firstKey, &secondKey) && !run SpecializationApplication.equals(&first, &second),
    "two lifetime-distinct semantic applications belong to one erased runtime family")
  let firstCopy = run SpecializationApplication.copy(&first)
  let copiedEqual = run SpecializationApplication.equals(&first, &firstCopy)
  run Testing.expect(InstanceKey.runtimeHash(&firstKey) == InstanceKey.runtimeHash(&secondKey) && copiedEqual
    && SpecializationApplication.hash(&first) == SpecializationApplication.hash(&firstCopy),
    "hashed instance and application lookups find one runtime family and one exact application")
  let mut store = makeSemantic(run Revision.copy(&revision))
  let mut request = Request.make()
  let bodies = starts(Semantic.eventLog(&store), Family.Body)
  let firstMir = run Semantic.demandApplicationMir(&mut store, &mut request, &first)
  let mut secondRequest = Request.make()
  let secondMir = run Semantic.demandApplicationMir(&mut store, &mut secondRequest, &second)
  run Testing.expect(succeeded(&firstMir) && succeeded(&secondMir) && starts(Semantic.eventLog(&store), Family.Body) == bodies + 3
    && assignsInteger(&store, &firstMir, b"21") && assignsInteger(&store, &secondMir, b"21"),
    "each exact application lowers its selected body and independently embeds the static helper's value 21")
  return ()
}

test effect fn staticParametersSelectInstancesAndKeepRuntimeLanes() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run staticParameterClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

// The reference a lowered function makes to an instance of `callee`, if any.
fn referenceTo(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, callee: &DeclarationId) -> Option<InstanceKey> {
  let index = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: at} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, at) {
      let references = Vector.asSlice<MirReference>(&function.references)
      let mut reference = usize.ZERO
      while reference < references.length {
        let identity = InstanceKey.identity(&references[reference].key)
        if Shared.with<DeclarationId, bool>(&identity, fn(found: &DeclarationId) -> bool { return DeclarationId.equals(found, callee) }) {
          return Option.some<InstanceKey>(InstanceKey.copy(&references[reference].key))
        }
        reference = reference + usize.ONE
      }
    }
  }
  return Option.none<InstanceKey>()
}

// Whether any statement of a lowered function satisfies `check`.
fn anyMirStatement(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, check: fn(&MirStatement) -> bool) -> bool {
  let index = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: at} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, at) {
      let blocks = Vector.asSlice<MirBlock>(&function.blocks)
      let mut blockAt = usize.ZERO
      while blockAt < blocks.length {
        let statements = Vector.asSlice<MirStatement>(&blocks[blockAt].statements)
        let mut statementAt = usize.ZERO
        while statementAt < statements.length {
          if check(&statements[statementAt]) { return true }
          statementAt = statementAt + usize.ONE
        }
        blockAt = blockAt + usize.ONE
      }
    }
  }
  return false
}

// Whether a lowered function assigns a two-field aggregate of exactly these integer literals, in
// canonical field order: a static array materialized at its use.
fn materializesIntegerPair(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, first: &[u8], second: &[u8]) -> bool {
  return anyMirStatement(
    store,
    answer,
    fn(statement: &MirStatement) -> bool {
      if let MirStatement.Assign {value: MirRvalue.Aggregate {fields}, ..} = &statement.* {
        let listed = Vector.asSlice<MirAggregateField>(&fields)
        return listed.length == 2 && listed[usize.ZERO].index == usize.ZERO && listed[usize.ONE].index == usize.ONE
          && integerOperand(&listed[usize.ZERO].value, first) && integerOperand(&listed[usize.ONE].value, second)
      }
      return false
    },
  )
}

// Whether a lowered function assigns exactly this integer literal: an embedded enum value.
fn assignsInteger(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, text: &[u8]) -> bool {
  return anyMirStatement(
    store,
    answer,
    fn(statement: &MirStatement) -> bool {
      if let MirStatement.Assign {value: MirRvalue.Use {value}, ..} = &statement.* {
        return integerOperand(&value, text)
      }
      return false
    },
  )
}

fn mirParameterCount(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> usize {
  let index = Shared.with<Result<Answer, NoRejection>, Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: at} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, at) {
      return Vector.length<Shared<Type>>(&function.parameters)
    }
  }
  return usize.MAX
}

// Source arity and the original static slot indices of one resolved signature.
fn signatureShape(answer: &Result<Answer, NoRejection>, arity: usize, slot: usize) -> bool {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome {
      let slots = Vector.asSlice<usize>(&signature.staticSlots)
      return Vector.length<Shared<Type>>(&signature.parameters) == arity && slots.length == usize.ONE && slots[usize.ZERO] == slot
    }
  }
  return false
}

// Whether a key's application carries exactly one static integer of `ty` at `ordinal`.
effect fn keyStaticInteger(key: &InstanceKey, ordinal: usize, ty: StaticIntegerType, magnitude: u64) -> bool ! OutOfMemoryError ? &mut Allocator {
  let application = run InstanceKey.selected(key)
  let slots = Vector.asSlice<StaticSlot>(&application.statics)
  if slots.length != usize.ONE || slots[usize.ZERO].ordinal != ordinal { return false }
  return Shared.with<StaticData, bool>(&slots[usize.ZERO].value, fn(data: &StaticData) -> bool {
    return match & data.* {
      StaticData.Integer {ty: found, sign, magnitude: amount} => found == ty && sign == StaticSign.Positive && amount == magnitude
      _ => false
    }
  })
}

effect fn staticParameterClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let id = run module("b12-static-parameters.silk")
  let source = """fn scaled(static factor: i32, value: i32) -> i32 { return factor * value }
fn twice(value: i32) -> i32 { return scaled(2, value) }
fn thrice(value: i32) -> i32 { return scaled(3, value) }
fn again(value: i32) -> i32 { return scaled(2, value) + 1 }
fn wrongKind(value: i32) -> i32 { return scaled(true, value) }
fn runtimeOperand(value: i32) -> i32 { return scaled(value, value) }
fn counted(static count: usize, value: i32) -> i32 { return value }
fn sized(value: i32) -> i32 { return counted(2, value) }
struct Box {}
impl Box { fn scaledBy(self: Self, static factor: i32, value: i32) -> i32 { return value } }
fn viaMethod(box: Box, value: i32) -> i32 { return box.scaledBy(2, value) }
"""
  let authored = run present(source)
  let revision = run Revision.publish(&Revision.make(), &id, &authored)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let wrongKind = run selectedApplicationOf(&mut index, &id, b"wrongKind")
  let runtimeOperand = run selectedApplicationOf(&mut index, &id, b"runtimeOperand")
  let mut store = makeSemantic(run Revision.copy(&revision))
  let mut request = Request.make()
  let twiceMir = run Semantic.demandMir(&mut store, &mut request, &id, b"twice")
  run Testing.expect(succeeded(&twiceMir) && starts(Semantic.eventLog(&store), Family.Body) == usize.ONE,
    "a caller's selected body supplies the static argument and lowers without demanding the callee's body")
  let thriceMir = run Semantic.demandMir(&mut store, &mut request, &id, b"thrice")
  let againMir = run Semantic.demandMir(&mut store, &mut request, &id, b"again")
  let twiceKey = soleReference(&store, &twiceMir)
  let thriceKey = soleReference(&store, &thriceMir)
  let againKey = soleReference(&store, &againMir)
  let mut distinct = false
  let mut reused = false
  let mut slotted = false
  let mut calleeLanes = false
  let mut calleeEmbeds = false
  if let Option<InstanceKey>.Some {value: two} = &twiceKey {
    if let Option<InstanceKey>.Some {value: three} = &thriceKey {
      distinct = !InstanceKey.sameRuntimeBase(&two, &three) && run keyStaticInteger(&three, usize.ZERO, StaticIntegerType.I32, 3)
    }
    if let Option<InstanceKey>.Some {value: repeated} = &againKey {
      reused = InstanceKey.sameRuntimeBase(&two, &repeated)
    }
    slotted = run keyStaticInteger(&two, usize.ZERO, StaticIntegerType.I32, 2)
    let callee = run InstanceKey.selected(&two)
    let calleeMir = run Semantic.demandApplicationMir(&mut store, &mut request, &callee)
    calleeLanes = succeeded(&calleeMir) && mirParameterCount(&store, &calleeMir) == usize.ONE
    let calleeBody = run Semantic.demandSelectedBody(&mut store, &mut request, &callee)
    let typed = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&calleeBody, checkedBody)
    if let Option<Shared<TypedBody>>.Some {value: body} = move typed {
      calleeEmbeds = Shared.with<TypedBody, usize>(&body, fn(checked: &TypedBody) -> usize { return embeddedI32(checked, 2) }) == usize.ONE
    }
  }
  run Testing.expect(slotted, "the call's instance carries the static value 2 at its original parameter index 0")
  run Testing.expect(distinct && reused, "factors 2 and 3 select distinct instances; the same factor reuses one")
  run Testing.expect(calleeLanes, "the selected callee lowers one runtime lane for its one runtime parameter")
  run Testing.expect(calleeEmbeds, "the callee reads its static parameter as an embedded constant, with no local")
  let scaledSignature = run signatureNamed(&mut store, &mut request, &mut index, &id, b"scaled", usize.ZERO)
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&scaledSignature, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return signatureShape(answer, 2, usize.ZERO)
    }), "source arity keeps both parameters and records the static one at its original index")
  let wrong = run Semantic.demandSelectedBody(&mut store, &mut request, &wrongKind)
  let wrongStart = offsetOf(source, "true", usize.ZERO)
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&wrong, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionAt(answer, RejectionCode.TypeMismatch, wrongStart)
    }), "a static argument of the wrong kind is a type mismatch at the argument")
  let operand = run Semantic.demandSelectedBody(&mut store, &mut request, &runtimeOperand)
  let operandStart = offsetOf(source, "scaled(value", usize.ZERO) + 7
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&operand, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionAt(answer, RejectionCode.StaticPhaseViolation, operandStart)
    }), "a runtime operand in a static slot is a static phase violation at the operand")
  let sizedMir = run Semantic.demandMir(&mut store, &mut request, &id, b"sized")
  let sizedKey = soleReference(&store, &sizedMir)
  let mut usizeSlot = false
  if let Option<InstanceKey>.Some {value: counted} = &sizedKey {
    usizeSlot = run keyStaticInteger(&counted, usize.ZERO, StaticIntegerType.Usize, 2)
  }
  run Testing.expect(succeeded(&sizedMir) && usizeSlot,
    "a static argument is checked as its declared type: 2 for a usize slot is a usize value")
  let method = run Semantic.demandBody(&mut store, &mut request, &id, b"viaMethod")
  let methodStart = offsetOf(source, "box.scaledBy", usize.ZERO)
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&method, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionAt(answer, RejectionCode.Unsupported, methodStart)
    }), "a receiver call cannot supply static arguments yet: an explicit gap at the call, not a dropped value")
  return ()
}

test effect fn staticAggregatesMaterializeAndSelectInstances() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run staticAggregateClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn staticAggregateClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let id = run module("b12-static-aggregates.silk")
  let source = """fn tabled(static table: [i32; 2], index: usize) -> i32 {
  let local = table
  return local[index]
}
fn second(index: usize) -> i32 { return tabled([4, 5], index) }
fn secondAgain(index: usize) -> i32 { return tabled([4, 5], index) + 1 }
fn short(index: usize) -> i32 { return tabled([4], index) }
struct Pair { left: i32 }
fn paired(static items: [Pair; 1]) -> i32 { return 0 }
fn records() -> i32 { return paired([Pair { left: 1 }]) }
enum Mode { Fast, Slow }
fn moded(static mode: Mode) -> Mode { return mode }
fn slow() -> Mode { return moded(Mode.Slow) }
fn fast() -> Mode { return moded(Mode.Fast) }
fn localArray(index: usize) -> i32 {
  let static table = [7, 8]
  let local = table
  return local[index]
}
"""
  let authored = run present(source)
  let revision = run Revision.publish(&Revision.make(), &id, &authored)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let tabledDeclaration = run requireIndexedIdentity(&mut index, &id, OwnerKind.Function, b"tabled", usize.ZERO)
  let modedDeclaration = run requireIndexedIdentity(&mut index, &id, OwnerKind.Function, b"moded", usize.ZERO)
  let shortCaller = run selectedApplicationOf(&mut index, &id, b"short")
  let recordsCaller = run selectedApplicationOf(&mut index, &id, b"records")
  let mut store = makeSemantic(run Revision.copy(&revision))
  let mut request = Request.make()
  let secondMir = run Semantic.demandMir(&mut store, &mut request, &id, b"second")
  let againMir = run Semantic.demandMir(&mut store, &mut request, &id, b"secondAgain")
  let secondKey = referenceTo(&store, &secondMir, &tabledDeclaration)
  let againKey = referenceTo(&store, &againMir, &tabledDeclaration)
  let referencesCallee = match &secondKey {
    Option<InstanceKey>.Some {..} => true
    Option<InstanceKey>.None => false
  }
  run Testing.expect(succeeded(&secondMir) && referencesCallee, "a caller passing a static array lowers and references its selected callee")
  let mut calleeLowers = false
  let mut embedsArray = false
  let mut sharesArray = false
  if let Option<InstanceKey>.Some {value: key} = &secondKey {
    let callee = run InstanceKey.selected(&key)
    let calleeMir = run Semantic.demandApplicationMir(&mut store, &mut request, &callee)
    calleeLowers = succeeded(&calleeMir)
    embedsArray = materializesIntegerPair(&store, &calleeMir, b"4", b"5")
    if let Option<InstanceKey>.Some {value: repeated} = &againKey { sharesArray = InstanceKey.sameRuntimeBase(&key, &repeated) }
  }
  run Testing.expect(calleeLowers, "the selected callee reading a static array lowers without a gap")
  run Testing.expect(embedsArray, "the selected callee materializes the static array [4, 5] as an aggregate of its integer fields")
  run Testing.expect(sharesArray, "equal static arrays select one shared instance")
  let slowMir = run Semantic.demandMir(&mut store, &mut request, &id, b"slow")
  let fastMir = run Semantic.demandMir(&mut store, &mut request, &id, b"fast")
  let slowKey = referenceTo(&store, &slowMir, &modedDeclaration)
  let fastKey = referenceTo(&store, &fastMir, &modedDeclaration)
  let mut embedsEnum = false
  let mut distinctEnums = false
  if let Option<InstanceKey>.Some {value: key} = &slowKey {
    let callee = run InstanceKey.selected(&key)
    let calleeMir = run Semantic.demandApplicationMir(&mut store, &mut request, &callee)
    embedsEnum = succeeded(&calleeMir) && assignsInteger(&store, &calleeMir, b"1")
    if let Option<InstanceKey>.Some {value: other} = &fastKey { distinctEnums = !InstanceKey.sameRuntimeBase(&key, &other) }
  }
  run Testing.expect(embedsEnum, "the selected callee materializes Mode.Slow as its representation integer 1")
  run Testing.expect(distinctEnums, "Mode.Slow and Mode.Fast select distinct instances")
  let localMir = run Semantic.demandMir(&mut store, &mut request, &id, b"localArray")
  run Testing.expect(succeeded(&localMir) && materializesIntegerPair(&store, &localMir, b"7", b"8"),
    "a static local array is constructed in its static root and materialized at its runtime use")
  let shortBody = run Semantic.demandSelectedBody(&mut store, &mut request, &shortCaller)
  let shortStart = offsetOf(source, "[4]", usize.ZERO)
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&shortBody, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionAt(answer, RejectionCode.ArrayLengthMismatch, shortStart)
    }), "a static array argument of the wrong length is an array length mismatch at the argument")
  let recordsBody = run Semantic.demandSelectedBody(&mut store, &mut request, &recordsCaller)
  let recordStart = offsetOf(source, "Pair { left: 1 }", usize.ZERO)
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&recordsBody, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionAt(answer, RejectionCode.Unsupported, recordStart)
    }), "a static array element that static execution cannot construct is a named Unsupported gap at the element")
  return ()
}

// Whether a lowered function assigns a negative integer operand with exactly these magnitude digits.
fn assignsNegativeInteger(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, text: &[u8]) -> bool {
  return anyMirStatement(
    store,
    answer,
    fn(statement: &MirStatement) -> bool {
      if let MirStatement.Assign {value: MirRvalue.Use {value: MirOperand.Integer {decimal, negative, ..}}, ..} = &statement.* {
        return negative && sameBytes(Bytes.asSlice(&decimal), text)
      }
      return false
    },
  )
}

// Whether a lowered function assigns a float operand with exactly these MIR (f64-widened) bits.
fn assignsFloat(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, bits: u64) -> bool {
  return anyMirStatement(
    store,
    answer,
    fn(statement: &MirStatement) -> bool {
      if let MirStatement.Assign {value: MirRvalue.Use {value: MirOperand.Float {bits: actual, ..}}, ..} = &statement.* {
        return actual == bits
      }
      return false
    },
  )
}

// Whether a lowered function builds a text descriptor over exactly these program-lifetime bytes.
fn assignsStaticText(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, text: &[u8], count: &[u8]) -> bool {
  return anyMirStatement(
    store,
    answer,
    fn(statement: &MirStatement) -> bool {
      if let MirStatement.Assign {value: MirRvalue.Slice {data: MirOperand.StaticBytes {bytes}, count: length}, ..} = &statement.* {
        return sameBytes(Bytes.asSlice(&bytes), text) && integerOperand(&length, count)
      }
      return false
    },
  )
}

test effect fn runtimeConstantReadsLowerToPublishedValues() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run runtimeConstantClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn runtimeConstantClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let id = run module("runtime-constants.silk")
  let text = """const limit: u8 = 255
const least: i8 = -128
const half: f32 = 1.5
const greeting: string<'static> = "hi"
fn byte() -> u8 { return limit }
fn minimum() -> i8 { return least }
fn ratio() -> f32 { return half }
fn greet() -> string<'static> { return greeting }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let byte = run Semantic.demandMir(&mut store, &mut request, &id, b"byte")
  let minimum = run Semantic.demandMir(&mut store, &mut request, &id, b"minimum")
  let ratio = run Semantic.demandMir(&mut store, &mut request, &id, b"ratio")
  let greet = run Semantic.demandMir(&mut store, &mut request, &id, b"greet")
  run Testing.expect(succeeded(&byte) && assignsInteger(&store, &byte, b"255")
    && succeeded(&minimum) && assignsNegativeInteger(&store, &minimum, b"128"),
    "integer constant reads lower to their exact published magnitude and sign")
  run Testing.expect(succeeded(&ratio) && assignsFloat(&store, &ratio, 0x3FF8000000000000),
    "an f32 constant read widens its published f32 bits exactly to the MIR f64 pattern")
  run Testing.expect(succeeded(&greet) && assignsStaticText(&store, &greet, b"hi", b"2"),
    "a text constant read builds a descriptor over its published bytes")
  return ()
}

// The application of a one-static-parameter fixture function with an i32 value at `ordinal`.
effect fn staticI32Root(index: &mut SourceIndex, id: &ModuleId, name: &[u8], ordinal: usize, magnitude: u64) -> SpecializationApplication
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let mut application = run selectedApplicationOf(&mut index.*, id, name)
  let value = run Shared.make<StaticData>(StaticData.Integer {ty: StaticIntegerType.I32, sign: StaticSign.Positive, magnitude: magnitude})
  run Vector.append<StaticSlot>(&mut application.statics, StaticSlot {ordinal: ordinal, value: move value})
  return move application
}

// A certified closure with exactly this many nodes and edges.
fn certifiedShape(closure: &StaticClosure, nodes: usize, edges: usize) -> bool {
  return match &closure.* {
    StaticClosure.Certified {evidence} => Vector.length<SpecializationApplication>(&evidence.nodes) == nodes && Vector.length<ClosureEdge>(&evidence.edges) == edges
    _ => false
  }
}

fn isWitnessEdge(edge: &SpecializationEdge) -> bool {
  return match &edge.* {
    SpecializationEdge.Witness => true
    _ => false
  }
}

fn certifiedWitnessEdge(closure: &StaticClosure) -> bool {
  if let StaticClosure.Certified {evidence} = &closure.* {
    let edges = Vector.asSlice<ClosureEdge>(&evidence.edges)
    let mut at = usize.ZERO
    while at < edges.length {
      if isWitnessEdge(&edges[at].edge) { return true }
      at = at + usize.ONE
    }
  }
  return false
}

test effect fn finiteStaticChainsCertifyCompleteClosures() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run finiteClosureClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn finiteClosureClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let id = run module("b12-finite-closure.silk")
  let source = """fn countdown(static n: i32) -> i32 {
  static if n == 0 {
    return 0
  } else {
    return countdown(n - 1)
  }
}
fn ping(static n: i32) -> i32 {
  static if n == 0 {
    return 0
  } else {
    return pong(n - 1)
  }
}
fn pong(static n: i32) -> i32 {
  static if n == 0 {
    return 1
  } else {
    return ping(n - 1)
  }
}
fn toggle(static flag: i32) -> i32 { return toggle(1 - flag) }
"""
  let authored = run present(source)
  let revision = run Revision.publish(&Revision.make(), &id, &authored)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let countdown = run staticI32Root(&mut index, &id, b"countdown", usize.ZERO, 3)
  let ping = run staticI32Root(&mut index, &id, b"ping", usize.ZERO, 3)
  let toggle = run staticI32Root(&mut index, &id, b"toggle", usize.ZERO, 1)
  let mut store = makeSemantic(run Revision.copy(&revision))
  let mut request = Request.make()
  let counted = run Semantic.closeStaticChain(&mut store, &mut request, &countdown, 8)
  run Testing.expect(certifiedShape(&counted, 4, 3), "countdown 3 -> 0 certifies four nodes and three edges")
  let tight = run Semantic.closeStaticChain(&mut store, &mut request, &countdown, 2)
  run Testing.expect(closureRefused(&tight, RejectionCode.StaticRecursionNotProven, 2),
    "the same finite chain is NotProven under an insufficient budget: the budget is not a proof")
  let mutual = run Semantic.closeStaticChain(&mut store, &mut request, &ping, 8)
  run Testing.expect(certifiedShape(&mutual, 4, 3), "a mutual changing-static chain certifies every reached node")
  let cycle = run Semantic.closeStaticChain(&mut store, &mut request, &toggle, 8)
  run Testing.expect(certifiedShape(&cycle, 2, 2), "a two-value static toggle is a finite strongly connected closure")
  return ()
}

test effect fn unclosedStaticChainsStayUnadmitted() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run unclosedClosureClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn unclosedClosureClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let id = run module("b12-unclosed-closure.silk")
  let source = """fn grow(static n: i32) -> i32 { return grow(n + 1) }
fn hidden(static n: i32, flag: bool) -> i32 {
  if flag {
    return hidden(n, false)
  }
  return hidden(n + 1, flag)
}
fn nested<T>(static n: i32) -> i32 {
  static if n == 0 {
    return 0
  } else {
    return nested<[T; 1]>(n - 1)
  }
}
fn plain(value: i32) -> i32 { return value }
"""
  let authored = run present(source)
  let revision = run Revision.publish(&Revision.make(), &id, &authored)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let grow = run staticI32Root(&mut index, &id, b"grow", usize.ZERO, 0)
  let hidden = run staticI32Root(&mut index, &id, b"hidden", usize.ZERO, 0)
  let nestedDeclaration = run requireIndexedIdentity(&mut index, &id, OwnerKind.Function, b"nested", usize.ZERO)
  let mut nestedArguments = Vector.make<Argument>()
  run Vector.append<Argument>(&mut nestedArguments, Argument.Type {value: run Shared.make<Type>(Type.Primitive {name: run Bytes.copy(b"i32")})})
  let mut nested = run specializationWithArguments(&nestedDeclaration, move nestedArguments)
  let two = run Shared.make<StaticData>(StaticData.Integer {ty: StaticIntegerType.I32, sign: StaticSign.Positive, magnitude: 2})
  run Vector.append<StaticSlot>(&mut nested.statics, StaticSlot {ordinal: usize.ZERO, value: move two})
  let mut store = makeSemantic(run Revision.copy(&revision))
  let mut request = Request.make()
  let plainMir = run Semantic.demandMir(&mut store, &mut request, &id, b"plain")
  let mirsBefore = starts(Semantic.eventLog(&store), Family.Mir)
  let growing = run Semantic.closeStaticChain(&mut store, &mut request, &grow, 3)
  run Testing.expect(closureRefused(&growing, RejectionCode.StaticRecursionNotProven, 3),
    "an ever-changing static value is NotProven at the budget with its pending path, never admitted")
  let hiddenGrowth = run Semantic.closeStaticChain(&mut store, &mut request, &hidden, 3)
  run Testing.expect(closureRefused(&hiddenGrowth, RejectionCode.StaticRecursionNotProven, 3),
    "growth in a second runtime arm after a repeated key keeps the closure open")
  let typed = run Semantic.closeStaticChain(&mut store, &mut request, &nested, 8)
  run Testing.expect(closureRefused(&typed, RejectionCode.ExpandingSpecialization, usize.ZERO),
    "a finite static counter does not excuse a growing type argument")
  let mut again = Request.make()
  let mirsAfter = starts(Semantic.eventLog(&store), Family.Mir)
  let plainAgain = run Semantic.demandMir(&mut store, &mut again, &id, b"plain")
  run Testing.expect(succeeded(&plainMir) && succeeded(&plainAgain) && mirsAfter > mirsBefore
      && starts(Semantic.eventLog(&store), Family.Mir) == mirsAfter,
    "failed transactions publish nothing and leave an unrelated cached lowering intact")
  return ()
}

// A refused build whose specialization path starts at `first` and whose related site is the
// changing-static edge that opened the closure transaction, in `opening` at `related`.
fn buildRefused(built: &BackendBuild, code: RejectionCode, first: &DeclarationId, opening: &ModuleId, related: usize) -> bool {
  return match &built.* {
    BackendBuild.Rejected {first: diagnostic, ..} => Shared.with<Rejection, bool>(&diagnostic, fn(found: &Rejection) -> bool {
      let path = Vector.asSlice<SpecializationApplication>(&found.specialization)
      let opened = match &found.related {
        Option<RelatedSite>.Some {value: site} => ModuleId.equals(&site.module, opening) && site.span.start == related
        Option<RelatedSite>.None => false
      }
      return found.code == code && opened && path.length > usize.ONE
        && DeclarationId.equals(SpecializationApplication.bodyDeclaration(&path[usize.ZERO]), first)
    })
    _ => false
  }
}

// A build refused as NotProven in `module`, naming the opening edge in `opening` at `start`.
fn refusedAcross(built: &BackendBuild, module: &ModuleId, opening: &ModuleId, start: usize) -> bool {
  return match &built.* {
    BackendBuild.Rejected {first: diagnostic, ..} => Shared.with<Rejection, bool>(&diagnostic, fn(found: &Rejection) -> bool {
      let opened = match &found.related {
        Option<RelatedSite>.Some {value: site} => ModuleId.equals(&site.module, opening) && site.span.start == start
        Option<RelatedSite>.None => false
      }
      return found.code == RejectionCode.StaticRecursionNotProven && ModuleId.equals(&found.module, module) && opened
    })
    _ => false
  }
}

test effect fn refusedStaticChainsRefuseTheBuild() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run refusedBuildClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn refusedBuildClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let id = run module("b12-refused-build.silk")
  let source = """union Outcome { Value { value: i32 }, Stop }
fn grow(static n: i32) -> i32 { return grow(n + 1) }
fn spiral(static n: i32, flag: bool) -> Outcome {
  if flag {
    return match move spiral(n + 1, flag) {
      Outcome.Stop => Outcome.Stop
      _ => Outcome.Stop
    }
  }
  return Outcome.Value { value: 0 }
}
pub fn main() -> i32 { return grow(0) }
"""
  let authored = run present(source)
  let revision = run Revision.publish(&Revision.make(), &id, &authored)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let main = run requireIndexedIdentity(&mut index, &id, OwnerKind.Function, b"main", usize.ZERO)
  let spiral = run staticI32Root(&mut index, &id, b"spiral", usize.ZERO, 0)
  let mut store = makeSemantic(run Revision.copy(&revision))
  let mut request = Request.make()
  let built = run Semantic.buildMain(&mut store, &mut request, &id, 3)
  run Testing.expect(buildRefused(&built, RejectionCode.StaticRecursionNotProven, &main, &id, offsetOf(source, "grow(n + 1)", usize.ZERO)),
    "main -> grow(0) refuses the build as NotProven, with the path from main and the opening edge's span")
  // The growing call sits only on the path that returns the failure variant. It is still a lowered
  // successor, so the chain keeps growing and is NotProven at the budget with its path.
  let failing = run Semantic.closeStaticChain(&mut store, &mut request, &spiral, 2)
  run Testing.expect(closureRefused(&failing, RejectionCode.StaticRecursionNotProven, 2),
    "growth on the path that returns a failure variant is still a successor: NotProven at the budget with its path")
  return ()
}

// The opening-site claims build their own programs, independent of the main -> grow build.
test effect fn refusedStaticChainsKeepTheirOpeningSites() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run openingSiteClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn openingSiteClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let entry = run module("b12-related-entry.silk")
  let helper = run module("chainhelper.silk")
  let entryText = """import chainhelper as Helper
fn relay(static n: i32) -> i32 {
  static if n == 1 {
    return Helper.grow(n)
  } else {
    return relay(n + 1)
  }
}
pub fn main() -> i32 { return relay(0) }
"""
  let entrySource = run present(entryText)
  let helperSource = run present("pub fn grow(static n: i32) -> i32 { return grow(n + 1) }\n")
  let first = run Revision.publish(&Revision.make(), &entry, &entrySource)
  let both = run Revision.publish(&first, &helper, &helperSource)
  let mut crossStore = makeSemantic(move both)
  let mut crossRequest = Request.make()
  let crossing = run Semantic.buildMain(&mut crossStore, &mut crossRequest, &entry, 3)
  run Testing.expect(refusedAcross(&crossing, &helper, &entry, offsetOf(entryText, "relay(n + 1)", usize.ZERO)),
    "a refusal in the helper module names the opening edge with its own module and span")
  let growthId = run module("b12-refused-growth.silk")
  let growthSource = """fn mixed<T>(static n: i32) -> i32 {
  static if n == 0 {
    return mixed<[T; 1]>(1)
  } else {
    return mixed<T>(n - 1)
  }
}
pub fn main() -> i32 { return mixed<i32>(1) }
"""
  let growthAuthored = run present(growthSource)
  let growthRevision = run Revision.publish(&Revision.make(), &growthId, &growthAuthored)
  let mut growthIndex = SourceIndex.make(run Revision.copy(&growthRevision))
  let mixed = run requireIndexedIdentity(&mut growthIndex, &growthId, OwnerKind.Function, b"mixed", usize.ZERO)
  let mut growthStore = makeSemantic(run Revision.copy(&growthRevision))
  let mut growthRequest = Request.make()
  let growing = run Semantic.buildMain(&mut growthStore, &mut growthRequest, &growthId, staticClosureNodes)
  run Testing.expect(buildRefused(&growing, RejectionCode.ExpandingSpecialization, &mixed, &growthId, offsetOf(growthSource, "mixed<T>(n - 1)", usize.ZERO)),
    "type growth found inside a closure transaction keeps the opening edge's span and its growing path")
  return ()
}

test effect fn staticChainsKeepWitnessEdgesAndBuild() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run witnessClosureClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn witnessClosureClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let id = run module("b12-witness-closure.silk")
  let source = """interface Step { fn step(value: Self) -> i32 }
struct Unit {}
impl Step for Unit { fn step(value: Self) -> i32 { return 1 } }
fn walk(static n: i32, item: Unit) -> i32 {
  static if n == 0 {
    return Step.step(move item)
  } else {
    return walk(n - 1, move item)
  }
}
pub fn main() -> i32 { return walk(2, Unit {}) }
"""
  let authored = run present(source)
  let revision = run Revision.publish(&Revision.make(), &id, &authored)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let walk = run staticI32Root(&mut index, &id, b"walk", usize.ZERO, 2)
  let mut store = makeSemantic(run Revision.copy(&revision))
  let mut request = Request.make()
  let closure = run Semantic.closeStaticChain(&mut store, &mut request, &walk, 8)
  run Testing.expect(certifiedShape(&closure, 4, 3) && certifiedWitnessEdge(&closure),
    "a chain's witness-resolved successor is a node, reached by an edge that keeps Witness provenance")
  let mut buildRequest = Request.make()
  let built = run Semantic.buildMain(&mut store, &mut buildRequest, &id, staticClosureNodes)
  let module = match &built { BackendBuild.Module {..} => true _ => false }
  run Testing.expect(module, "a build admits the certified changing-static chain and emits its module")
  return ()
}

