test effect fn operatorBodiesShareOneDiscovery() -> ()
  ! FileError
    | HostInputError
    | InvalidModulePath
    | OutOfMemoryError
    | Cycle
    | RevisionMismatch
    | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let entry = run module("entry.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """import silk.ops { Add }
struct Meters { value: i32 }
impl Add<Meters, Meters> for Meters { fn add(left: Self, right: Meters) -> Meters { return move left } }
fn first(a: Meters, b: Meters, c: Meters) -> Meters { return move a + move b + move c }
fn second(a: Meters, b: Meters) -> Meters { return move a + move b }
"""
  let source = run present(text) |> Effect.provideMut<Allocator>(&mut allocator)
  let published = run Revision.publish(&Revision.make(), &entry, &source) |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run withOperatorInterfaces(&published) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let first = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"first") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"second") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<bool>(&first, operatorBodyHasSharedDiscovery) &&
    Shared<Result<Answer, NoRejection>>.with<bool>(&second, operatorBodyHasSharedDiscovery) &&
    starts(Semantic.eventLog(&semantic), Family.OperatorInterfaces) == usize.ONE,
    "operator bodies share one discovery query",
  )
  return ()
}

fn operatorBodyHasSharedDiscovery(answer: &Result<Answer, NoRejection>) -> bool {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Body {..}} = &value.outcome {
      let dependencies = Vector<Dependency>.asSlice(&value.dependencies)
      let mut shared = false
      let mut at = usize.ZERO
      while at < dependencies.length {
        if dependencies[at].family == Family.OperatorInterfaces { shared = true }
        at = at + usize.ONE
      }
      return shared
    }
  }
  return false
}

fn bodyIntegersHaveType(body: &TypedBody, spelling: &[u8], count: usize) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut found = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form: BodyExpression.Integer {..}} = &nodes[at].kind {
      let matches = Shared<Type>.with<bool>(&ty, fn(value: &Type) -> bool {
        return match &value.* {
          Type.Primitive {name} => sameBytes(Bytes.asSlice(&name), spelling)
          _ => false
        }
      })
      if !matches { return false }
      found = found + usize.ONE
    }
    at = at + usize.ONE
  }
  return found == count
}

fn bodyRootConstantHasPrimitiveType(body: &TypedBody, spelling: &[u8]) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let root = TypedBody.rootNode(body)
  if root.index < nodes.length {
    if let BodyNodeKind.Expression {ty, form: BodyExpression.Constant {..}} = &nodes[root.index].kind {
      return Shared<Type>.with<bool>(&ty, fn(found: &Type) -> bool {
        return match &found.* {
          Type.Primitive {name} => sameBytes(Bytes.asSlice(&name), spelling)
          _ => false
        }
      })
    }
  }
  return false
}

test effect fn staticFunctionControlUsesArgumentsAndCheckedLocals() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run staticFunctionControlClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn staticFunctionControlClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("static-function-control.silk")
  let source = """struct Plan { parts: Intrinsic.StaticSequence<i32> mode: i32 }
struct Mixed {pub count: i32 pub enabled: bool}
struct Empty {}
static fn pick(input: bool) -> i32 {
  let chosen = input
  static if chosen {return 42} else {return 0}
}
static fn quiet(input: bool) -> i32 {
  static if input {return 42} else {compileError("quiet selected arm")}
}
static fn failedPrefix() -> i32 {
  compileError("control prefix")
  static if true {return 42} else {return 0}
}
static fn changed(input: bool) -> i32 {
  let mut chosen = false
  chosen = input
  static if chosen {return 42} else {return 0}
}
static fn nestedControl() -> i32 {
  let mut count = 0
  static if true {count = count + 1 static if count == 1 {count = count + 1}}
  static if count == 2 {return 42} else {return 0}
}
static fn early(input: bool) -> i32 {
  if input {return 42}
  let mut count = 0
  static if count == 0 {return 7} else {return 1}
}
static fn plan() -> i32 {
  let held = Plan {parts: Intrinsic.staticSequenceEmpty<i32>(), mode: 42}
  static if held.mode == 42 {return 42} else {return 0}
}
static fn values() -> Intrinsic.StaticSequence<i32> {
  let first = Intrinsic.staticSequenceAppend<i32>(Intrinsic.staticSequenceEmpty<i32>(), 20)
  return Intrinsic.staticSequenceAppend<i32>(move first, 22)
}
static fn total() -> i32 {
  let mut result = 0
  static for value in values() {result = result + value}
  static if result == 42 {return result} else {return 0}
}
static fn fieldKind<Owner, Value>(field: Intrinsic.Field<Owner, Value>) -> u8 {
  return Intrinsic.reflectFieldKind<Owner, Value>(field)
}
static fn fieldCount<T>() -> i32 {
  let mut count = 0
  static for field in Intrinsic.reflectFields<T>() {
    static if fieldKind(field) == 0 {count = count + 1}
  }
  return count
}
static fn empty() -> i32 {
  static for value in Intrinsic.staticSequenceEmpty<i32>() {missing()}
  return 42
}
fn positive() -> i32 {return pick(true)}
fn negative() -> i32 {return pick(false)}
fn quietTrue() -> i32 {return quiet(true)}
fn quietFalse() -> i32 {return quiet(false)}
fn prefixFailure() -> i32 {return failedPrefix()}
fn mutatedTrue() -> i32 {return changed(true)}
fn mutatedFalse() -> i32 {return changed(false)}
fn nested() -> i32 {return nestedControl()}
fn earlyTrue() -> i32 {return early(true)}
fn earlyFalse() -> i32 {return early(false)}
fn phaseLocal() -> i32 {return plan()}
fn sum() -> i32 {return total()}
fn reflectedFields() -> i32 {return fieldCount<Mixed>()}
fn emptyFields() -> i32 {return fieldCount<Empty>()}
fn silentBody() -> i32 {return empty()}
static fn varying() -> i32 {
  let mut count = 0
  let mut total = 0
  while count < 2 {
    static if count == 0 {total = total + 22} else {total = total + 20}
    count = count + 1
  }
  return total
}
fn changedDecision() -> i32 {return varying()}
fn runtime(input: bool) -> i32 {static if input {return 42} else {return 0}}
"""
  let authored = run present(source)
  let revision = run Revision.publish(&Revision.make(), &id, &authored)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let mut store = makeSemantic(run Revision.copy(&revision))
  let mut request = Request.make()
  let nameArray = ["positive", "negative", "quietTrue", "mutatedTrue", "mutatedFalse", "nested", "earlyTrue", "earlyFalse", "phaseLocal", "sum", "reflectedFields", "emptyFields", "silentBody"]
  let expectedArray: [u64; 13] = [42, 0, 42, 42, 0, 42, 42, 7, 42, 42, 2, 0, 42]
  let names: &[string] = &nameArray
  let expected: &[u64] = &expectedArray
  let mut at = usize.ZERO
  while at < names.length {
    let name = names[at]
    let wanted = expected[at]
    let application = run selectedApplicationOf(&mut index, &id, String.utf8Bytes(name))
    let body = run Semantic.demandSelectedBody(&mut store, &mut request, &application)
    let value = Shared<Result<Answer, NoRejection>>.with<bool>(&body, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return staticControlEmbedsInteger(answer, wanted)
    })
    run Testing.expect(value, name)
    at = at + usize.ONE
  }
  let prefix = run selectedApplicationOf(&mut index, &id, b"prefixFailure")
  let prefixFailure = run Semantic.demandSelectedBody(&mut store, &mut request, &prefix)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&prefixFailure, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return rejectionAt(answer, RejectionCode.SelectedCompileError, offsetOf(source, "compileError(\"control prefix\")", usize.ZERO))
  }), "a checked prefix retains its reached CompileError diagnostic")
  let quiet = run selectedApplicationOf(&mut index, &id, b"quietFalse")
  let quietFailure = run Semantic.demandSelectedBody(&mut store, &mut request, &quiet)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&quietFailure, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return rejectionAt(answer, RejectionCode.SelectedCompileError, offsetOf(source, "compileError(\"quiet selected arm\")", usize.ZERO))
  }), "only a selected static arm contributes its CompileError")
  let runtime = run selectedApplicationOf(&mut index, &id, b"runtime")
  let refused = run Semantic.demandSelectedBody(&mut store, &mut request, &runtime)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&refused, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return rejectionAt(answer, RejectionCode.StaticPhaseViolation, offsetOf(source, "input {return 42} else {return 0}}", usize.ZERO))
  }), "runtime locals cannot become static conditions")
  let varying = run selectedApplicationOf(&mut index, &id, b"changedDecision")
  let inconsistent = run Semantic.demandSelectedBody(&mut store, &mut request, &varying)
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&inconsistent, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return rejectionAt(answer, RejectionCode.Unsupported, offsetOf(source, "count == 0 {total", usize.ZERO))
  }), "changing a checked static decision never publishes the wrong result 44")
  return ()
}

fn staticControlEmbedsInteger(answer: &Result<Answer, NoRejection>, expected: u64) -> bool {
  let held = checkedBody(answer)
  if let Option<Shared<TypedBody>>.Some {value: typed} = move held {
    return Shared<TypedBody>.with<bool>(&typed, fn(body: &TypedBody) -> bool {
      return staticControlBodyEmbeds(body, expected)
    })
  }
  return false
}

fn staticControlBodyEmbeds(body: &TypedBody, expected: u64) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Embedded {value: embedded}, ..} = &nodes[at].kind {
      if Shared<StaticData>.with<bool>(&embedded, fn(data: &StaticData) -> bool {
        return match &data.* {
          StaticData.Integer {ty, sign, magnitude} => ty == StaticIntegerType.I32 && sign == StaticSign.Positive && magnitude == expected
          _ => false
        }
      }) {return true}
    }
    at = at + usize.ONE
  }
  return false
}

test effect fn nestedMixedLoopsRetainIndependentIterationContexts() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
