fn staticIntegerIs(answer: &Result<StaticData, StaticFault>, sign: StaticSign, magnitude: u64) -> bool {
  return match &answer.* {
    Result<StaticData, StaticFault>.Success {value: StaticData.Integer {sign: foundSign, magnitude: foundMagnitude, ..}} => foundSign == sign && foundMagnitude == magnitude
    _ => false
  }
}

// U5 mixed specialization cases stay together so U6 can add its constant cases independently.
fn mixedFailedWith(
  answer: &Result<MixedBodyResult, MixedDiagnostic | StaticDiagnostic | OutOfMemoryError>,
  expected: MixedFault,
) -> bool {
  return match &answer.* {
    Result<MixedBodyResult, MixedDiagnostic | StaticDiagnostic | OutOfMemoryError>.Failure {error} => match &error {
      MixedDiagnostic {fault, ..} => fault == expected
      _ => false
    }
    _ => false
  }
}

fn mixedRetainsOnlySelectedName(unit: &SourceUnit, body: &MixedBodyResult) -> bool {
  let obligations = Vector<MixedObligation>.asSlice(&body.obligations)
  let mut selected = false
  let mut inactive = false
  let mut at = usize.ZERO
  while at < obligations.length {
    if let MixedObligation.Expression {syntax} = &obligations[at] {
      if let Node.IdentifierExpression {name, ..} = Module.node(&unit.authored, syntax) {
        if let Node.Name {text} = Module.node(&unit.authored, name) {
          let spelling = Module.text(&unit.authored, text)
          if sameBytes(spelling, b"value") { selected = true }
          if sameBytes(spelling, b"missing") { inactive = true }
        }
      }
    }
    at = at + usize.ONE
  }
  return selected && !inactive
}

effect fn mixedApplication<'source>(machine: &MixedBody.Machine<'source>, name: &[u8]) -> SpecializationApplication
! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let found = run MixedBody.applicationNamed(machine, name)
  if let Option<SpecializationApplication>.Some {value} = move found {
    return move value
  }
  run Testing.expect(false, "the mixed fixture declares the named function")
  return run mixedApplication(machine, name)
}

// A copy of a fixture application with static values at parameter positions 0..n. The mixed
// fixtures declare their static parameters first.
effect fn mixedStatics(application: &SpecializationApplication, values: &[Shared<StaticData>]) -> SpecializationApplication
! OutOfMemoryError ? &mut Allocator {
  let mut copied = run SpecializationApplication.copy(application)
  let mut statics = Vector<StaticSlot>.make()
  let mut at = usize.ZERO
  while at < values.length {
    run Vector<StaticSlot>.append(&mut statics, StaticSlot {ordinal: at, value: StaticValue.copy(&values[at])})
    at = at + usize.ONE
  }
  copied.statics = move statics
  return move copied
}

test effect fn mixedSelectionErasesStaticLanesAndInactiveArm() -> ()
! InvalidModulePath | OutOfMemoryError | MixedDiagnostic | StaticDiagnostic | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("mixed-selected.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """type Flag = bool
fn choose(static enabled: Flag, value: u32) -> u32 {
  let static selected = enabled
  static if selected { return value } else { return missing }
}
fn hold(static flags: [bool; 2]) -> u32 { return 1 }
"""
  let bytes = run Bytes.copy(String.utf8Bytes(source)) |> Effect.provideMut<Allocator>(&mut allocator)
  let unit = run SourceUnit.parse(&id, usize.ONE, move bytes) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(SourceUnit.diagnosticCount(&unit) == usize.ZERO, "both static arms parse")
  let mut semantic = run staticSemantic(&id, source, MachineTarget.forId(TargetId.Aarch64AppleDarwin))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut dependencies = Vector<Dependency>.make()
  let mut machine = run MixedBody.make(Semantic.staticPort(&mut semantic, &mut dependencies), &id, StaticExecution.Limits {steps: 64, depth: 4, valueBytes: 256}, 32)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let enabled = run Shared<StaticData>.make(StaticData.Boolean {value: true})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let args = [move enabled]
  let chooseApplication1 = run mixedApplication(&machine, b"choose") |> Effect.provideMut<Allocator>(&mut allocator)
  let chooseApplication1Statics = run mixedStatics(&chooseApplication1, &args) |> Effect.provideMut<Allocator>(&mut allocator)
  let selected = run MixedBody.specialize(&mut machine, &chooseApplication1Statics)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Vector<HirId>.length(&selected.runtimeParameters) == usize.ONE && Vector<StaticExecution.Binding>.length(&selected.staticBindings) == 2, "static parameter and binding have no runtime lanes")
  let retained = match &selected.root {
    MixedResidual.Block {statements} => Vector<Shared<MixedResidual>>.length(&statements) > usize.ZERO
    _ => false
  }
  run Testing.expect(retained && mixedRetainsOnlySelectedName(&unit, &selected), "selected value work remains and inactive missing work is erased")
  let boolName = run Bytes.copy(b"bool") |> Effect.provideMut<Allocator>(&mut allocator)
  let boolType = run Types.intern(Type.Primitive {name: move boolName})
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let extent = run Bytes.copy(b"2") |> Effect.provideMut<Allocator>(&mut allocator)
  let arrayType = run Types.intern(Type.Array {
    element: move boolType,
    extent: move extent,
  }) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut fields = Vector<Shared<StaticData>>.make()
  let first = run Shared<StaticData>.make(StaticData.Boolean {value: true})
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Vector<Shared<StaticData>>.append(&mut fields, move first)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run Shared<StaticData>.make(StaticData.Boolean {value: false})
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Vector<Shared<StaticData>>.append(&mut fields, move second)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let arrayTypeForMismatch = Shared<Type>.clone(&arrayType)
  let admitted = StaticValue.aggregate(move arrayType, Option<usize>.none(), move fields)
  let array = match move admitted {
    Option<StaticData>.Some {value} => run Shared<StaticData>.make(move value)
      |> Effect.provideMut<Allocator>(&mut allocator)
    Option<StaticData>.None => { return run Testing.expect(false, "array is a pure static argument") }
  }
  let arrayArgs = [move array]
  let holdApplication2 = run mixedApplication(&machine, b"hold") |> Effect.provideMut<Allocator>(&mut allocator)
  let holdApplication2Statics = run mixedStatics(&holdApplication2, &arrayArgs) |> Effect.provideMut<Allocator>(&mut allocator)
  let held = run MixedBody.specialize(&mut machine, &holdApplication2Statics)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Vector<StaticExecution.Binding>.length(&held.staticBindings) == usize.ONE,
    "resolved signature admits a pure fixed-array static parameter")
  let mut wrongFields = Vector<Shared<StaticData>>.make()
  let wrongFirst = run Shared<StaticData>.make(StaticData.Boolean {value: true})
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Vector<Shared<StaticData>>.append(&mut wrongFields, move wrongFirst)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let wrongSecond = run Shared<StaticData>.make(StaticData.Integer {
    ty: StaticIntegerType.U32, sign: StaticSign.Positive, magnitude: 1,
  }) |> Effect.provideMut<Allocator>(&mut allocator)
  run Vector<Shared<StaticData>>.append(&mut wrongFields, move wrongSecond)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let wrongArray = StaticValue.aggregate(move arrayTypeForMismatch, Option<usize>.none(), move wrongFields)
  if let Option<StaticData>.Some {value} = move wrongArray {
    let wrongShared = run Shared<StaticData>.make(move value) |> Effect.provideMut<Allocator>(&mut allocator)
    let wrongArrayArgs = [move wrongShared]
    let holdApplication3 = run mixedApplication(&machine, b"hold") |> Effect.provideMut<Allocator>(&mut allocator)
    let holdApplication3Statics = run mixedStatics(&holdApplication3, &wrongArrayArgs) |> Effect.provideMut<Allocator>(&mut allocator)
    let rejected = run Effect.result(MixedBody.specialize(&mut machine, &holdApplication3Statics))
      |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
    run Testing.expect(mixedFailedWith(&rejected, MixedFault.InvalidStaticArgument),
      "an array carrying the right type identity still checks each element")
  } else {
    run Testing.expect(false, "wrong-element array reaches static parameter validation")
  }
  let wrong = run Shared<StaticData>.make(StaticData.Integer {ty: StaticIntegerType.U32, sign: StaticSign.Positive, magnitude: 1})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let wrongArgs = [move wrong]
  let chooseApplication4 = run mixedApplication(&machine, b"choose") |> Effect.provideMut<Allocator>(&mut allocator)
  let chooseApplication4Statics = run mixedStatics(&chooseApplication4, &wrongArgs) |> Effect.provideMut<Allocator>(&mut allocator)
  let invalid = run Effect.result(MixedBody.specialize(&mut machine, &chooseApplication4Statics))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(mixedFailedWith(&invalid, MixedFault.InvalidStaticArgument), "aliased static argument retains its declared type")
  return ()
}

test effect fn mixedSelectedFailureAndRuntimeControlAreEager() -> ()
! InvalidModulePath | OutOfMemoryError | MixedDiagnostic | StaticDiagnostic | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("mixed-failures.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """static fn helper() -> u32 { return 1 }
fn invalid(static enabled: bool) -> u32 { static if enabled { return missing } else { return 2 } }
fn disabled(static enabled: bool) -> u32 { static if enabled { compileError("disabled") } return 3 }
fn runtimeGuard(runtime: bool) -> u32 { if runtime { compileError("bad") } return 1 }
fn ordinary() -> u32 {
  let enabled = true
  static if enabled { return 1 }
  return 2
}
fn escape() -> u32 { return helper }
"""
  let mut semantic = run staticSemantic(&id, source, MachineTarget.forId(TargetId.Aarch64AppleDarwin))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut dependencies = Vector<Dependency>.make()
  let mut machine = run MixedBody.make(Semantic.staticPort(&mut semantic, &mut dependencies), &id, StaticExecution.Limits {steps: 64, depth: 4, valueBytes: 256}, 32)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let emptyArguments = Vector<Shared<StaticData>>.make()
  let yes = run Shared<StaticData>.make(StaticData.Boolean {value: true})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let no = run Shared<StaticData>.make(StaticData.Boolean {value: false})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let active = [move yes]
  let inactive = [move no]
  let invalidApplication5 = run mixedApplication(&machine, b"invalid") |> Effect.provideMut<Allocator>(&mut allocator)
  let invalidApplication5Statics = run mixedStatics(&invalidApplication5, &active) |> Effect.provideMut<Allocator>(&mut allocator)
  let invalid = run Effect.result(MixedBody.specialize(&mut machine, &invalidApplication5Statics))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let selectedUnknown = match &invalid {
    Result<MixedBodyResult, MixedDiagnostic | StaticDiagnostic | OutOfMemoryError>.Failure {error} => match &error {
      MixedDiagnostic {fault, code, span, ..} => fault == MixedFault.UnknownName &&
        code == RejectionCode.UnknownName && span.start == offsetOf(source, "missing", usize.ZERO) &&
        span.end == span.start + 7
      _ => false
    }
    _ => false
  }
  run Testing.expect(selectedUnknown, "selected unknown name keeps its code and authored span")
  let invalidApplication6 = run mixedApplication(&machine, b"invalid") |> Effect.provideMut<Allocator>(&mut allocator)
  let invalidApplication6Statics = run mixedStatics(&invalidApplication6, &inactive) |> Effect.provideMut<Allocator>(&mut allocator)
  let accepted = run MixedBody.specialize(&mut machine, &invalidApplication6Statics)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Vector<MixedBody.Obligation>.length(&accepted.obligations) > usize.ZERO, "inactive unknown name stays undemanded")
  let disabledApplication7 = run mixedApplication(&machine, b"disabled") |> Effect.provideMut<Allocator>(&mut allocator)
  let disabledApplication7Statics = run mixedStatics(&disabledApplication7, &inactive) |> Effect.provideMut<Allocator>(&mut allocator)
  let quiet = run MixedBody.specialize(&mut machine, &disabledApplication7Statics)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Vector<MixedBody.Obligation>.length(&quiet.obligations) > usize.ZERO, "inactive compileError stays silent")
  let disabledApplication8 = run mixedApplication(&machine, b"disabled") |> Effect.provideMut<Allocator>(&mut allocator)
  let disabledApplication8Statics = run mixedStatics(&disabledApplication8, &active) |> Effect.provideMut<Allocator>(&mut allocator)
  let loud = run Effect.result(MixedBody.specialize(&mut machine, &disabledApplication8Statics))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let selectedError = match &loud {
    Result<MixedBodyResult, MixedDiagnostic | StaticDiagnostic | OutOfMemoryError>.Failure {error} => match &error {
      StaticDiagnostic {fault, code, span, ..} => fault == StaticExecutionFault.CompileError &&
        sameBytes(code, b"SEM0177") &&
        span.start == offsetOf(source, "compileError(\"disabled\")", usize.ZERO) &&
        span.end == span.start + 24
      _ => false
    }
    _ => false
  }
  run Testing.expect(selectedError, "selected compileError terminates specialization")
  let runtimeGuardApplication9 = run mixedApplication(&machine, b"runtimeGuard") |> Effect.provideMut<Allocator>(&mut allocator)
  let runtimeGuardApplication9Statics = run mixedStatics(&runtimeGuardApplication9, Vector<Shared<StaticData>>.asSlice(&emptyArguments)) |> Effect.provideMut<Allocator>(&mut allocator)
  let guarded = run Effect.result(MixedBody.specialize(&mut machine, &runtimeGuardApplication9Statics))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let compileErrorReached = match &guarded {
    Result<MixedBodyResult, MixedDiagnostic | StaticDiagnostic | OutOfMemoryError>.Failure {error} => match &error {
      StaticDiagnostic {fault, code, span, ..} => fault == StaticExecutionFault.CompileError &&
        sameBytes(code, b"SEM0177") &&
        span.start == offsetOf(source, "compileError(\"bad\")", usize.ZERO) &&
        span.end == span.start + 19
      _ => false
    }
    _ => false
  }
  run Testing.expect(compileErrorReached, "runtime control cannot suppress selected compileError")
  let ordinaryApplication10 = run mixedApplication(&machine, b"ordinary") |> Effect.provideMut<Allocator>(&mut allocator)
  let ordinaryApplication10Statics = run mixedStatics(&ordinaryApplication10, Vector<Shared<StaticData>>.asSlice(&emptyArguments)) |> Effect.provideMut<Allocator>(&mut allocator)
  let ordinary = run Effect.result(MixedBody.specialize(&mut machine, &ordinaryApplication10Statics))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let runtimeLocalRejected = match &ordinary {
    Result<MixedBodyResult, MixedDiagnostic | StaticDiagnostic | OutOfMemoryError>.Failure {error} => match &error {
      MixedDiagnostic {fault, code, span, ..} => fault == MixedFault.CheckedRootRejected &&
        code == RejectionCode.StaticPhaseViolation &&
        span.start == offsetOf(source, "enabled { return 1 }", usize.ZERO) &&
        span.end == span.start + 7
      _ => false
    }
    _ => false
  }
  run Testing.expect(runtimeLocalRejected, "ordinary local stays runtime despite literal initializer")
  let escapeApplication11 = run mixedApplication(&machine, b"escape") |> Effect.provideMut<Allocator>(&mut allocator)
  let escapeApplication11Statics = run mixedStatics(&escapeApplication11, Vector<Shared<StaticData>>.asSlice(&emptyArguments)) |> Effect.provideMut<Allocator>(&mut allocator)
  let escaped = run Effect.result(MixedBody.specialize(&mut machine, &escapeApplication11Statics))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(mixedFailedWith(&escaped, MixedFault.StaticCallableEscape), "static callable cannot escape into runtime")
  return ()
}

test effect fn mixedConditionalNamesFollowTheSelectedModuleArm() -> ()
! InvalidModulePath | OutOfMemoryError | MixedDiagnostic | StaticDiagnostic | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("mixed-conditional.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """static if true {
  const gatedLimit: u32 = 4
  fn gatedCall(value: u32) -> u32 { return value }
} else {
  const absentLimit: u32 = 5
}
fn routed(static enabled: bool) -> u32 { static if enabled { return gatedCall(gatedLimit) } else { return 2 } }
fn absent(static enabled: bool) -> u32 { static if enabled { return absentLimit } else { return 2 } }
"""
  let mut semantic = run staticSemantic(&id, source, MachineTarget.forId(TargetId.Aarch64AppleDarwin))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut dependencies = Vector<Dependency>.make()
  let mut machine = run MixedBody.make(Semantic.staticPort(&mut semantic, &mut dependencies), &id, StaticExecution.Limits {steps: 64, depth: 4, valueBytes: 256}, 32)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let yes = run Shared<StaticData>.make(StaticData.Boolean {value: true})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let active = [move yes]
  let routedApplication = run mixedApplication(&machine, b"routed") |> Effect.provideMut<Allocator>(&mut allocator)
  let routedStatics = run mixedStatics(&routedApplication, &active) |> Effect.provideMut<Allocator>(&mut allocator)
  let routed = run Effect.result(MixedBody.specialize(&mut machine, &routedStatics))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let selected = match &routed {
    Result<MixedBodyResult, MixedDiagnostic | StaticDiagnostic | OutOfMemoryError>.Success {..} => true
    _ => false
  }
  run Testing.expect(selected, "runtime names declared in the selected module arm route like unconditional declarations")
  let absentApplication = run mixedApplication(&machine, b"absent") |> Effect.provideMut<Allocator>(&mut allocator)
  let absentStatics = run mixedStatics(&absentApplication, &active) |> Effect.provideMut<Allocator>(&mut allocator)
  let unavailable = run Effect.result(MixedBody.specialize(&mut machine, &absentStatics))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let inactive = match &unavailable {
    Result<MixedBodyResult, MixedDiagnostic | StaticDiagnostic | OutOfMemoryError>.Failure {error} => match &error {
      MixedDiagnostic {fault, code, span, ..} => fault == MixedFault.UnknownName &&
        code == RejectionCode.UnknownName && span.start == offsetOf(source, "absentLimit", usize.ONE) &&
        span.end == span.start + 11
      _ => false
    }
    _ => false
  }
  run Testing.expect(inactive, "an inactive-only module declaration is unavailable to a selected runtime body")
  return ()
}

test effect fn mixedGrowthFailurePublishesNoResidualBody() -> ()
! InvalidModulePath | OutOfMemoryError | MixedDiagnostic | StaticDiagnostic | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("mixed-growth.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """fn runtime() -> u32 { return 1 }
fn grow() -> u32 {
  let first = runtime()
  return first
}
fn small() -> u32 { return runtime() }
"""
  let sourceBytes = run Bytes.copy(String.utf8Bytes(source)) |> Effect.provideMut<Allocator>(&mut allocator)
  let unit = run SourceUnit.parse(&id, usize.ONE, move sourceBytes) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = run staticSemantic(&id, source, MachineTarget.forId(TargetId.Aarch64AppleDarwin))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut dependencies = Vector<Dependency>.make()
  let mut machine = run MixedBody.make(Semantic.staticPort(&mut semantic, &mut dependencies), &id, StaticExecution.Limits {steps: 32, depth: 4, valueBytes: 128}, 2)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let emptyArguments = Vector<Shared<StaticData>>.make()
  let growApplication12 = run mixedApplication(&machine, b"grow") |> Effect.provideMut<Allocator>(&mut allocator)
  let growApplication12Statics = run mixedStatics(&growApplication12, Vector<Shared<StaticData>>.asSlice(&emptyArguments)) |> Effect.provideMut<Allocator>(&mut allocator)
  let failed = run Effect.result(MixedBody.specialize(&mut machine, &growApplication12Statics))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(mixedFailedWith(&failed, MixedFault.ResidualGrowth), "residual growth fails before publication")
  let smallApplication13 = run mixedApplication(&machine, b"small") |> Effect.provideMut<Allocator>(&mut allocator)
  let smallApplication13Statics = run mixedStatics(&smallApplication13, Vector<Shared<StaticData>>.asSlice(&emptyArguments)) |> Effect.provideMut<Allocator>(&mut allocator)
  let recovered = run MixedBody.specialize(&mut machine, &smallApplication13Statics)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let selectedStart = offsetOf(source, "fn small", usize.ZERO)
  let obligations = Vector<MixedObligation>.asSlice(&recovered.obligations)
  let mut onlySelected = obligations.length > usize.ZERO
  let mut runtimeCalls = usize.ZERO
  let mut at = usize.ZERO
  while at < obligations.length {
    if let MixedObligation.RuntimeCall {..} = &obligations[at] {
      runtimeCalls = runtimeCalls + usize.ONE
    }
    let syntax = match &obligations[at] {
      MixedObligation.Expression {syntax} => syntax
      MixedObligation.RuntimeCall {syntax} => syntax
    }
    if Module.span(&unit.authored, syntax).start < selectedStart { onlySelected = false }
    at = at + usize.ONE
  }
  let oneStatement = match &recovered.root {
    MixedResidual.Block {statements} => Vector<Shared<MixedResidual>>.length(&statements) == usize.ONE
    _ => false
  }
  run Testing.expect(onlySelected && runtimeCalls == usize.ONE && oneStatement &&
    Vector<StaticExecution.Binding>.length(&recovered.staticBindings) == usize.ZERO,
    "failed growth leaves no residual work in a later specialization")
  return ()
}

test effect fn mixedInactiveArmStillReportsSyntaxErrors() -> ()
! InvalidModulePath | OutOfMemoryError | MixedDiagnostic | StaticDiagnostic | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("mixed-syntax.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """fn broken(static enabled: bool) -> u32 {
  static if enabled { return 1 } else { return ( }
}
fn healthy(static enabled: bool) -> u32 {
  static if enabled { return 1 } else { return 2 }
}
"""
  let mut semantic = run staticSemantic(&id, source, MachineTarget.forId(TargetId.Aarch64AppleDarwin))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut dependencies = Vector<Dependency>.make()
  let mut machine = run MixedBody.make(Semantic.staticPort(&mut semantic, &mut dependencies), &id, StaticExecution.Limits {steps: 16, depth: 2, valueBytes: 64}, 8)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let enabled = run Shared<StaticData>.make(StaticData.Boolean {value: true})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let args = [move enabled]
  let broken = run mixedApplication(&machine, b"broken") |> Effect.provideMut<Allocator>(&mut allocator)
  let brokenStatics = run mixedStatics(&broken, &args) |> Effect.provideMut<Allocator>(&mut allocator)
  let rejected = run Effect.result(MixedBody.specialize(&mut machine, &brokenStatics))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(mixedSyntaxRejected(&rejected, offsetOf(source, "( }", usize.ZERO), offsetOf(source, "fn healthy", usize.ZERO)),
    "both arms are parsed before static selection, and the parser's own code reports the discarded arm")
  let healthy = run mixedApplication(&machine, b"healthy") |> Effect.provideMut<Allocator>(&mut allocator)
  let healthyStatics = run mixedStatics(&healthy, &args) |> Effect.provideMut<Allocator>(&mut allocator)
  let selected = run Effect.result(MixedBody.specialize(&mut machine, &healthyStatics))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let succeeded = match &selected {
    Result<MixedBody.Body, MixedDiagnostic | StaticDiagnostic | OutOfMemoryError>.Success {..} => true
    _ => false
  }
  run Testing.expect(succeeded,
    "a sibling declaration's syntax error is not this body's input")
  return ()
}

// The selected body of `bind` in a module whose other declarations are `text`'s remainder.
effect fn phaseBoundBind(text: string) -> Shared<Result<Answer, NoRejection>>
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let entry = run module("phase-bound.silk")
  let source = run present(text)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let declaration = run requireIndexedIdentity(&mut index, &entry, OwnerKind.Function, b"bind", usize.ZERO)
  let application = run specializationWithArguments(&declaration, Vector<Argument>.make())
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  return run Semantic.demandSelectedBody(&mut semantic, &mut request, &application)
}

test effect fn phaseOnlyBindingIgnoresAWellFormedSibling() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let text = """struct Plan { parts: Intrinsic.StaticSequence<i32> mode: i32 }
static fn make() -> Plan { return Plan { parts: Intrinsic.staticSequenceEmpty<i32>(), mode: 1 } }
fn bind() -> i32 { let held = make() return 0 }
struct Anchored<'a> { plan: Plan at: &'a i32 }
"""
  let answer = run phaseBoundBind(text) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&answer, RejectionCode.StaticPhaseViolation, text, "make()", usize.ONE),
    "a runtime binding cannot hold a phase-only sequence, whatever else the module declares")
  return ()
}

test effect fn phaseOnlyBindingIgnoresAMalformedSibling() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let text = """struct Plan { parts: Intrinsic.StaticSequence<i32> mode: i32 }
static fn make() -> Plan { return Plan { parts: Intrinsic.staticSequenceEmpty<i32>(), mode: 1 } }
fn bind() -> i32 { let held = make() return 0 }
struct Anchored<'a> { plan: Plan, at: &'a i32 }
"""
  let answer = run phaseBoundBind(text) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&answer, RejectionCode.StaticPhaseViolation, text, "make()", usize.ONE),
    "a sibling's syntax error leaves the body's own diagnosis; the module rejection is MODULE-004's")
  return ()
}

// A syntax rejection at the discarded arm, `from` up to the next declaration at `before`.
fn mixedSyntaxRejected(answer: &Result<MixedBody.Body, MixedDiagnostic | StaticDiagnostic | OutOfMemoryError>, from: usize, before: usize) -> bool {
  return match &answer.* {
    Result<MixedBody.Body, MixedDiagnostic | StaticDiagnostic | OutOfMemoryError>.Failure {error} => match &error {
      MixedDiagnostic {fault, code, span, ..} => fault == MixedFault.InvalidSyntax &&
        (code == RejectionCode.UnexpectedToken || code == RejectionCode.MissingToken) && span.start >= from && span.end <= before
      _ => false
    }
    _ => false
  }
}

fn staticCheckedRootSource<'borrow, 'source>(port: &'borrow StaticPort<'source>, cursor: &AuthoredCursor) -> Option<&'borrow Module> {
  return StaticPort<'source>.authoredAtCursor(port, cursor)
}

test effect fn reachedStaticRootKeepsContextualTypesAndOriginalSource() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("reached-root.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = "fn ordinary() { let static selected: usize = 1 + 2 }"
  let mut semantic = run staticSemantic(&id, source, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut dependencies = Vector<Dependency>.make()
  let mut port = Semantic.staticPort(&mut semantic, &mut dependencies)
  let cursor = run StaticPort.authoredCursor(&mut port, &id)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut expression = HirId {index: usize.MAX}
  if let Option<AuthoredCursor>.Some {value: selected} = move cursor {
    if let Option<&Module>.Some {value: hir} = move staticCheckedRootSource(&port, &selected) {
      let mut at = usize.ZERO
      while at < Vector<Node>.length(&hir.nodes) {
        let candidate = HirId {index: at}
        if let Node.InfixExpression {..} = Module.node(hir, candidate) {
          expression = candidate
        }
        at = at + usize.ONE
      }
    }
  }
  run Testing.expect(expression.index != usize.MAX, "selected static expression has an authored HIR ID")
  let primitiveName = run Bytes.copy(b"usize") |> Effect.provideMut<Allocator>(&mut allocator)
  let expected = run Types.intern(Type.Primitive {name: move primitiveName})
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let binders = Vector<StaticRootBinder>.make()
  let answer = run StaticPort.demandCheckedRoot(
    &mut port,
    &id,
    Option<usize>.some(usize.ZERO),
    expression,
    StaticRootExpectation.Resolved {ty: move expected, mismatchCode: RejectionCode.TypeMismatch},
    Vector<StaticRootBinder>.asSlice(&binders),
  ) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let checkedAnswerBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(
    &answer,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value: body} = move checkedAnswerBody {
    run Testing.expect(Shared<TypedBody>.with<bool>(&body, fn(checked: &TypedBody) -> bool {
      return bodyIntegersHaveType(checked, b"usize", 2)
    }), "reached expression gives both literals the contextual usize type")
  } else {
    run Testing.expect(false, "reached expression has a checked body and source")
  }
}

test effect fn reachedCompileErrorKeepsCheckedMessageAndReportsDiagnostic() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | StaticDiagnostic | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("compile-error-root.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """fn ordinary() {
  let static selected: u32 = compileError("disabled")
}
"""
  let mut semantic = run staticSemantic(&id, source, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut dependencies = Vector<Dependency>.make()
  let mut port = Semantic.staticPort(&mut semantic, &mut dependencies)
  let cursor = run StaticPort.authoredCursor(&mut port, &id)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut expression = HirId {index: usize.MAX}
  let start = offsetOf(source, "compileError", usize.ZERO)
  if let Option<AuthoredCursor>.Some {value: selected} = move cursor {
    if let Option<&Module>.Some {value: hir} = move staticCheckedRootSource(&port, &selected) {
      let mut at = usize.ZERO
      while at < Vector<Node>.length(&hir.nodes) {
        let candidate = HirId {index: at}
        if let Node.CompileErrorExpression {..} = Module.node(hir, candidate) {
          if Module.span(hir, candidate).start == start { expression = candidate }
        }
        at = at + usize.ONE
      }
    }
  }
  run Testing.expect(expression.index != usize.MAX, "selected compileError has an authored HIR ID")
  let typeName = run Bytes.copy(b"u32") |> Effect.provideMut<Allocator>(&mut allocator)
  let expected = run Types.intern(Type.Primitive {name: move typeName})
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let binders = Vector<StaticRootBinder>.make()
  let answer = run StaticPort.demandCheckedRoot(
    &mut port, &id, Option<usize>.some(usize.ZERO), expression,
    StaticRootExpectation.Resolved {ty: move expected, mismatchCode: RejectionCode.TypeMismatch},
    Vector<StaticRootBinder>.asSlice(&binders),
  ) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let checkedBodyValue = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(
    &answer, checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value: body} = move checkedBodyValue {
    run Testing.expect(Shared<TypedBody>.with<bool>(&body, fn(checked: &TypedBody) -> bool {
      let nodes = TypedBody.nodeSlice(checked)
      let root = TypedBody.rootNode(checked)
      if root.index < nodes.length {
        if let BodyNodeKind.Expression {form: BodyExpression.CompileError {message}, ..} = &nodes[root.index].kind {
          return message.index < root.index
        }
      }
      return false
    }), "compileError keeps a checked message operand in its typed body")
  } else {
    run Testing.expect(false, "compileError root has a checked body")
  }
  let checked = Shared<Result<Answer, NoRejection>>.with<Option<StaticExecution.CheckedRoot>>(
    &answer, StaticExecution.checkedRoot,
  )
  if let Option<StaticExecution.CheckedRoot>.Some {value: root} = move checked {
    let mut machine = run StaticExecution.make(move port, &id, StaticExecution.Limits {steps: 16, depth: 2, valueBytes: 64})
      |> Effect.provideMut<Allocator>(&mut allocator)
    let bindings = Vector<StaticExecution.Binding>.make()
    let attempted = run Effect.result(StaticExecution.evaluate(
      &mut machine, &root, Vector<StaticExecution.Binding>.asSlice(&bindings), expression,
    )) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
    run Testing.expect(staticExecutionCallFault(
      &attempted,
      StaticExecutionFault.CompileError,
      b"SEM0177",
      start,
      String.utf8Bytes("compileError(\"disabled\")").length,
    ), "selected compileError reports its authored diagnostic")
  } else {
    run Testing.expect(false, "compileError has checked evaluation facts")
  }
}

test effect fn integerExtentContextsLiteralTreeButKeepsConstantType() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("integer-extent-root.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """const small: u8 = 7
fn ordinary() {
  let static literal = 4294967296
  let static combined = 4294967296 + 1
  let static selected = small
}
"""
  let mut semantic = run staticSemantic(&id, source, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut dependencies = Vector<Dependency>.make()
  let mut port = Semantic.staticPort(&mut semantic, &mut dependencies)
  let cursor = run StaticPort.authoredCursor(&mut port, &id)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut literal = HirId {index: usize.MAX}
  let mut combined = HirId {index: usize.MAX}
  let mut constant = HirId {index: usize.MAX}
  let literalStart = offsetOf(source, "4294967296", usize.ZERO)
  let combinedStart = offsetOf(source, "4294967296", usize.ONE)
  let constantStart = offsetOf(source, "small", usize.ONE)
  if let Option<AuthoredCursor>.Some {value: selected} = move cursor {
    if let Option<&Module>.Some {value: hir} = move staticCheckedRootSource(&port, &selected) {
      let mut at = usize.ZERO
      while at < Vector<Node>.length(&hir.nodes) {
        let candidate = HirId {index: at}
        let start = Module.span(hir, candidate).start
        if let Node.IntegerLiteral {..} = Module.node(hir, candidate) {
          if start == literalStart { literal = candidate }
        }
        if let Node.InfixExpression {..} = Module.node(hir, candidate) {
          if start == combinedStart { combined = candidate }
        }
        if let Node.IdentifierExpression {..} = Module.node(hir, candidate) {
          if start == constantStart { constant = candidate }
        }
        at = at + usize.ONE
      }
    }
  }
  run Testing.expect(literal.index != usize.MAX && combined.index != usize.MAX && constant.index != usize.MAX, "extent operands have authored HIR IDs")
  let binders = Vector<StaticRootBinder>.make()
  let literalAnswer = run StaticPort.demandCheckedRoot(
    &mut port, &id, Option<usize>.none(), literal,
    StaticRootExpectation.IntegerExtent,
    Vector<StaticRootBinder>.asSlice(&binders),
  ) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let constantAnswer = run StaticPort.demandCheckedRoot(
    &mut port, &id, Option<usize>.none(), constant,
    StaticRootExpectation.IntegerExtent,
    Vector<StaticRootBinder>.asSlice(&binders),
  ) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let combinedAnswer = run StaticPort.demandCheckedRoot(
    &mut port, &id, Option<usize>.none(), combined,
    StaticRootExpectation.IntegerExtent,
    Vector<StaticRootBinder>.asSlice(&binders),
  ) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let literalBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(
    &literalAnswer, checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value: body} = move literalBody {
    run Testing.expect(Shared<TypedBody>.with<bool>(&body, fn(checked: &TypedBody) -> bool {
      return bodyIntegersHaveType(checked, b"u64", usize.ONE)
    }), "bare extent integer retains enough width for target admission")
  } else {
    run Testing.expect(false, "bare extent integer has a checked body")
  }
  let combinedBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(
    &combinedAnswer, checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value: body} = move combinedBody {
    run Testing.expect(Shared<TypedBody>.with<bool>(&body, fn(checked: &TypedBody) -> bool {
      return bodyIntegersHaveType(checked, b"u64", 2)
    }), "all-literal extent arithmetic retains wide operand types")
  } else {
    run Testing.expect(false, "all-literal extent arithmetic has a checked body")
  }
  let constantBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(
    &constantAnswer, checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value: body} = move constantBody {
    run Testing.expect(Shared<TypedBody>.with<bool>(&body, fn(checked: &TypedBody) -> bool {
      return bodyRootConstantHasPrimitiveType(checked, b"u8")
    }), "extent constant keeps its declared type")
  } else {
    run Testing.expect(false, "extent constant has a checked body")
  }
}

test effect fn reachedStaticRootFindsOwnerAndDefersConstantValue() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("constant-root.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = "const count: usize = 8\nfn ordinary() { let static selected: usize = count }"
  let mut semantic = run staticSemantic(&id, source, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut dependencies = Vector<Dependency>.make()
  let mut port = Semantic.staticPort(&mut semantic, &mut dependencies)
  let cursor = run StaticPort.authoredCursor(&mut port, &id)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut expression = HirId {index: usize.MAX}
  if let Option<AuthoredCursor>.Some {value: selected} = move cursor {
    if let Option<&Module>.Some {value: hir} = move staticCheckedRootSource(&port, &selected) {
      let mut at = usize.ZERO
      while at < Vector<Node>.length(&hir.nodes) {
        let candidate = HirId {index: at}
        if let Node.IdentifierExpression {binding, ..} = Module.node(hir, candidate) {
          if !binding.present {
            expression = candidate
          }
        }
        at = at + usize.ONE
      }
    }
  }
  run Testing.expect(expression.index != usize.MAX, "static initializer has an authored constant reference")
  let primitiveName = run Bytes.copy(b"usize") |> Effect.provideMut<Allocator>(&mut allocator)
  let expected = run Types.intern(Type.Primitive {name: move primitiveName})
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let binders = Vector<StaticRootBinder>.make()
  let answer = run StaticPort.demandCheckedRoot(
    &mut port,
    &id,
    Option<usize>.none(),
    expression,
    StaticRootExpectation.Resolved {ty: move expected, mismatchCode: RejectionCode.TypeMismatch},
    Vector<StaticRootBinder>.asSlice(&binders),
  ) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let checkedAnswerBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(
    &answer,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value: body} = move checkedAnswerBody {
    run Testing.expect(Shared<TypedBody>.with<bool>(&body, fn(checked: &TypedBody) -> bool {
      let nodes = TypedBody.nodeSlice(checked)
      let root = TypedBody.rootNode(checked)
      if root.index < nodes.length {
        if let BodyNodeKind.Expression {form: BodyExpression.Constant {..}, ..} = &nodes[root.index].kind {
          return true
        }
      }
      return false
    }), "reached constant reference keeps a checked declaration and type")
  } else {
    run Testing.expect(false, "constant reference has a checked body and source")
  }
  drop port
  let edges = Vector<Dependency>.asSlice(&dependencies)
  let mut typeEdge = false
  let mut valueEdge = false
  let mut at = usize.ZERO
  while at < edges.length {
    if edges[at].family == Family.Constant {
      typeEdge = true
    }
    if edges[at].family == Family.Initializer {
      valueEdge = true
    }
    at = at + usize.ONE
  }
  run Testing.expect(typeEdge && !valueEdge, "typing a constant reference defers its initializer")
}

test effect fn reachedQualifiedConstantKeepsCanonicalTypeWithoutValueDemand() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let entry = run module("qualified-root.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let helper = run module("helper.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let entrySource = run present("import helper as Helper\nfn ordinary() { let static selected: usize = Helper.count }")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let helperSource = run present("pub const count: usize = 8")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run Revision.publish(&Revision.make(), &entry, &entrySource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&first, &helper, &helperSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = Semantic.traced(move revision, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option<FinalProfile>.none())
  let mut dependencies = Vector<Dependency>.make()
  let mut port = Semantic.staticPort(&mut semantic, &mut dependencies)
  let cursor = run StaticPort.authoredCursor(&mut port, &entry)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut expression = HirId {index: usize.MAX}
  if let Option<AuthoredCursor>.Some {value: selected} = move cursor {
    if let Option<&Module>.Some {value: hir} = move staticCheckedRootSource(&port, &selected) {
      let mut at = usize.ZERO
      while at < Vector<Node>.length(&hir.nodes) {
        let candidate = HirId {index: at}
        if let Node.FieldExpression {..} = Module.node(hir, candidate) {
          expression = candidate
        }
        at = at + usize.ONE
      }
    }
  }
  run Testing.expect(expression.index != usize.MAX, "qualified constant has an authored expression")
  let primitiveName = run Bytes.copy(b"usize") |> Effect.provideMut<Allocator>(&mut allocator)
  let expected = run Types.intern(Type.Primitive {name: move primitiveName})
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let binders = Vector<StaticRootBinder>.make()
  let answer = run StaticPort.demandCheckedRoot(
    &mut port,
    &entry,
    Option<usize>.none(),
    expression,
    StaticRootExpectation.Resolved {ty: move expected, mismatchCode: RejectionCode.TypeMismatch},
    Vector<StaticRootBinder>.asSlice(&binders),
  ) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let checkedAnswerBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(
    &answer,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value: body} = move checkedAnswerBody {
    let constant = Shared<TypedBody>.with<Option<Shared<DeclarationId>>>(
      &body,
      fn(checked: &TypedBody) -> Option<Shared<DeclarationId>> {
        let nodes = TypedBody.nodeSlice(checked)
        let root = TypedBody.rootNode(checked)
        if root.index < nodes.length {
          if let BodyNodeKind.Expression {form: BodyExpression.Constant {declaration}, ..} = &nodes[root.index].kind {
            return Option<Shared<DeclarationId>>.some(Shared<DeclarationId>.clone(&declaration))
          }
        }
        return Option<Shared<DeclarationId>>.none()
      },
    )
    if let Option<Shared<DeclarationId>>.Some {value: declaration} = move constant {
      run Testing.expect(Shared<DeclarationId>.with<bool>(&declaration, fn(identity: &DeclarationId) -> bool {
        return ModuleId.equals(DeclarationId.moduleId(identity), &helper)
      }), "qualified constant retains the imported declaration identity")
    } else {
      run Testing.expect(false, "qualified constant has a checked declaration identity")
    }
  } else {
    run Testing.expect(false, "qualified constant has a checked body")
  }
  drop port
  let edges = Vector<Dependency>.asSlice(&dependencies)
  let mut typeEdge = false
  let mut valueEdge = false
  let mut at = usize.ZERO
  while at < edges.length {
    if ModuleId.equals(Semantic.dependencyModule(&semantic, &edges[at]), &helper) && edges[at].family == Family.Constant {
      typeEdge = true
    }
    if edges[at].family == Family.Initializer {
      valueEdge = true
    }
    at = at + usize.ONE
  }
  run Testing.expect(typeEdge && !valueEdge, "qualified typing observes the imported header without its value")
}

test effect fn reachedStaticRootsReuseCheckedBinderTypes() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("static-binders.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = "fn ordinary(static value: usize) { let static first: usize = value + 1 let static second: usize = first + 2 }"
  let mut semantic = run staticSemantic(&id, source, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut dependencies = Vector<Dependency>.make()
  let mut port = Semantic.staticPort(&mut semantic, &mut dependencies)
  let cursor = run StaticPort.authoredCursor(&mut port, &id)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut parameter = HirId {index: usize.MAX}
  let mut roots = Vector<HirId>.make()
  let mut bindings = Vector<HirId>.make()
  let mut annotations = Vector<HirId>.make()
  if let Option<AuthoredCursor>.Some {value: selected} = move cursor {
    if let Option<&Module>.Some {value: hir} = move staticCheckedRootSource(&port, &selected) {
      let mut at = usize.ZERO
      while at < Vector<Node>.length(&hir.nodes) {
        let candidate = HirId {index: at}
        match Module.node(hir, candidate) {
          Node.Parameter {mode, ..} => {
            if mode == ParameterMode.Static {
              parameter = candidate
            }
          }
          Node.BindingStatement {isStatic, annotation, ..} => {
            if isStatic && annotation.present {
              run Vector<HirId>.append(&mut bindings, candidate)
                |> Effect.provideMut<Allocator>(&mut allocator)
              run Vector<HirId>.append(&mut annotations, annotation.id)
                |> Effect.provideMut<Allocator>(&mut allocator)
            }
          }
          Node.InfixExpression {..} => {
            run Vector<HirId>.append(&mut roots, candidate)
              |> Effect.provideMut<Allocator>(&mut allocator)
          }
          _ => ()
        }
        at = at + usize.ONE
      }
    }
  }
  run Testing.expect(
    parameter.index != usize.MAX && Vector<HirId>.length(&roots) == 2 && Vector<HirId>.length(&bindings) == 2,
    "mixed body retains a static parameter and two annotated static bindings",
  )
  let mut visible = Vector<StaticRootBinder>.make()
  run Vector<StaticRootBinder>.append(&mut visible, StaticRootBinder.Parameter {syntax: parameter})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run StaticPort.demandCheckedRoot(
    &mut port,
    &id,
    Option<usize>.some(usize.ZERO),
    Vector<HirId>.get(&roots, usize.ZERO),
    StaticRootExpectation.Annotation {syntax: Vector<HirId>.get(&annotations, usize.ZERO)},
    Vector<StaticRootBinder>.asSlice(&visible),
  ) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Vector<StaticRootBinder>.append(&mut visible, StaticRootBinder.Binding {
    syntax: Vector<HirId>.get(&bindings, usize.ZERO),
    checked: Shared<Result<Answer, NoRejection>>.clone(&first),
  }) |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run StaticPort.demandCheckedRoot(
    &mut port,
    &id,
    Option<usize>.some(usize.ZERO),
    Vector<HirId>.get(&roots, usize.ONE),
    StaticRootExpectation.Annotation {syntax: Vector<HirId>.get(&annotations, usize.ONE)},
    Vector<StaticRootBinder>.asSlice(&visible),
  ) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let checkedAnswerBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(
    &second,
    checkedBody,
  )
  if let Option<Shared<TypedBody>>.Some {value: body} = move checkedAnswerBody {
    run Testing.expect(Shared<TypedBody>.with<bool>(&body, fn(checked: &TypedBody) -> bool {
      return TypedBody.localSlice(checked).length == 2 && bodyIntegersHaveType(checked, b"usize", 1)
    }), "later static expression uses checked parameter and prior binding types")
  } else {
    run Testing.expect(false, "later static expression has a checked body")
  }
}

test effect fn reachedStaticRootRejectsPriorBinderWithWrongContext() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("static-prior-context.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """fn ordinary() {
  let static first: u8 = 1
  let static second: u8 = first
}
"""
  let mut semantic = run staticSemantic(&id, source, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut dependencies = Vector<Dependency>.make()
  let mut port = Semantic.staticPort(&mut semantic, &mut dependencies)
  let cursor = run StaticPort.authoredCursor(&mut port, &id)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut firstBinding = HirId {index: usize.MAX}
  let mut initializer = HirId {index: usize.MAX}
  let mut secondRoot = HirId {index: usize.MAX}
  let bindingStart = offsetOf(source, "let static first", usize.ZERO)
  let rootStart = offsetOf(source, "first", usize.ONE)
  if let Option<AuthoredCursor>.Some {value: selected} = move cursor {
    if let Option<&Module>.Some {value: hir} = move staticCheckedRootSource(&port, &selected) {
      let mut at = usize.ZERO
      while at < Vector<Node>.length(&hir.nodes) {
        let candidate = HirId {index: at}
        if Module.span(hir, candidate).start == bindingStart {
          if let Node.BindingStatement {initializer: written, ..} = Module.node(hir, candidate) {
            firstBinding = candidate
            initializer = written
          }
        }
        if Module.span(hir, candidate).start == rootStart {
          if let Node.IdentifierExpression {..} = Module.node(hir, candidate) {
            secondRoot = candidate
          }
        }
        at = at + usize.ONE
      }
    }
  }
  run Testing.expect(
    firstBinding.index != usize.MAX && initializer.index != usize.MAX && secondRoot.index != usize.MAX,
    "annotated static binding and later reference retain authored IDs",
  )
  let typeName = run Bytes.copy(b"u64") |> Effect.provideMut<Allocator>(&mut allocator)
  let u64Type = run Types.intern(Type.Primitive {name: move typeName})
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut binders = Vector<StaticRootBinder>.make()
  let wrong = run StaticPort.demandCheckedRoot(
    &mut port, &id, Option<usize>.some(usize.ZERO), initializer,
    StaticRootExpectation.Resolved {ty: move u64Type, mismatchCode: RejectionCode.TypeMismatch},
    Vector<StaticRootBinder>.asSlice(&binders),
  ) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let wrongBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&wrong, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value: body} = move wrongBody {
    run Testing.expect(Shared<TypedBody>.with<bool>(&body, fn(checked: &TypedBody) -> bool {
      return bodyIntegersHaveType(checked, b"u64", 1)
    }), "prior initializer was independently checked under the wrong type")
  } else {
    run Testing.expect(false, "wrong-context prior initializer has a checked body")
  }
  run Vector<StaticRootBinder>.append(&mut binders, StaticRootBinder.Binding {
    syntax: firstBinding,
    checked: Shared<Result<Answer, NoRejection>>.clone(&wrong),
  }) |> Effect.provideMut<Allocator>(&mut allocator)
  let later = run StaticPort.demandCheckedRoot(
    &mut port, &id, Option<usize>.some(usize.ZERO), secondRoot,
    StaticRootExpectation.Inferred,
    Vector<StaticRootBinder>.asSlice(&binders),
  ) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsFrom(&later, RejectionCode.AssignmentTypeMismatch, offsetOf(source, "u8", usize.ZERO)),
    "a prior root checked as u64 cannot stand in for its written u8 binding",
  )
}

test effect fn staticFunctionsExecuteLocalControlAndFiniteRecursion() -> ()
! InvalidModulePath | OutOfMemoryError | StaticDiagnostic | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("static-control.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """static fn countTo(limit: u32) -> u32 { let mut current: u32 = 0 while current < limit { current = current + 1 if current == 2 { continue } if current == limit { break } } return current }
static fn sumTo(limit: u32) -> u32 { if limit == 0 { return 0 } return limit + sumTo(limit - 1) }
static fn doubled(value: u32) -> u32 { return value + value }
static fn text() -> string<'static> { return "ok" }
static fn echo(value: string) -> string { return value }
"""
  let mut semantic = run staticSemantic(&id, source, MachineTarget.forId(TargetId.Aarch64AppleDarwin))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut staticDependencies = Vector<Dependency>.make()
  let mut machine = run StaticExecution.make(Semantic.staticPort(&mut semantic, &mut staticDependencies), &id, StaticExecution.Limits {steps: 200, depth: 16, valueBytes: 1024})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let four = run Shared<StaticData>.make(StaticData.Integer {ty: StaticIntegerType.U32, sign: StaticSign.Positive, magnitude: 4})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let args = [move four]
  let counted = run StaticExecution.demand(&mut machine, b"countTo", &args, Span.make(usize.ZERO, usize.ZERO))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared<StaticData>.with<bool>(&counted, fn(value: &StaticData) -> bool {
    return staticSharedIntegerIs(value, 4)
  }), "static while replaces a whole local value")
  let summed = run StaticExecution.demand(&mut machine, b"sumTo", &args, Span.make(usize.ZERO, usize.ZERO))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared<StaticData>.with<bool>(&summed, fn(value: &StaticData) -> bool {
    return staticSharedIntegerIs(value, 10)
  }), "finite recursion returns a canonical result")
  let doubled = run StaticExecution.demand(&mut machine, b"doubled", &args, Span.make(usize.ZERO, usize.ZERO))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared<StaticData>.with<bool>(&doubled, fn(value: &StaticData) -> bool {
    return staticSharedIntegerIs(value, 8)
  }), "a reused argument can occupy both operator positions")
  let noArgs = Vector<Shared<StaticData>>.make()
  let textResult = run StaticExecution.demand(&mut machine, b"text", Vector<Shared<StaticData>>.asSlice(&noArgs), Span.make(usize.ZERO, usize.ZERO))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let copiedText = run StaticValue.textBytes(&textResult) |> Effect.provideMut<Allocator>(&mut allocator)
  let textMatches = match move copiedText {
    Option<Bytes>.Some {value} => sameBytes(Bytes.asSlice(&value), b"ok")
    Option<Bytes>.None => false
  }
  run Testing.expect(textMatches, "a checked static string return is admitted through its resolved signature")
  let textArgument = [Shared<StaticData>.clone(&textResult)]
  let echoed = run StaticExecution.demand(&mut machine, b"echo", &textArgument, Span.make(usize.ZERO, usize.ZERO))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let echoedBytes = run StaticValue.textBytes(&echoed) |> Effect.provideMut<Allocator>(&mut allocator)
  let echoedMatches = match move echoedBytes {
    Option<Bytes>.Some {value} => sameBytes(Bytes.asSlice(&value), b"ok")
    Option<Bytes>.None => false
  }
  run Testing.expect(echoedMatches, "an elided string lifetime admits a pure static argument and return")
  let wrongArgument = run Shared<StaticData>.make(StaticData.Integer {ty: StaticIntegerType.I32, sign: StaticSign.Positive, magnitude: 4})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let badArgs = [move wrongArgument]
  let wrongInput = run Effect.result(StaticExecution.demand(&mut machine, b"doubled", &badArgs, Span.make(usize.ZERO, usize.ZERO)))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(staticExecutionFailedWith(&wrongInput, StaticExecutionFault.InvalidValue), "static argument must match its declared parameter type")
  return ()
}

// STATIC-005: a struct whose fields are pure and that no sealed Drop names is a static value; its
// fields read back by declaration order. A struct some `impl Drop` names violates the static phase.
test effect fn staticStructValuesReadFields() -> ()
! InvalidModulePath | OutOfMemoryError | StaticDiagnostic | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("static-struct.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """struct Plan { mode: i32 }
static fn make() -> Plan { return Plan { mode: 42 } }
static fn total() -> i32 { let plan = make() return plan.mode }
struct Pair { first: i32 second: i32 }
static fn reordered() -> i32 { let pair = Pair { second: 2, first: 40 } return pair.first + pair.second }
struct Guarded { value: i32 }
impl Intrinsic.Drop for Guarded { fn drop(self: &mut Guarded) -> () { return () } }
static fn guarded() -> i32 { let held = Guarded { value: 1 } return held.value }
"""
  let mut semantic = run staticSemantic(&id, source, MachineTarget.forId(TargetId.Aarch64AppleDarwin))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut staticDependencies = Vector<Dependency>.make()
  let mut machine = run StaticExecution.make(Semantic.staticPort(&mut semantic, &mut staticDependencies), &id, StaticExecution.Limits {steps: 200, depth: 16, valueBytes: 1024})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let empty = Vector<Shared<StaticData>>.make()
  let total = run StaticExecution.demand(&mut machine, b"total", Vector<Shared<StaticData>>.asSlice(&empty), Span.make(usize.ZERO, usize.ZERO))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared<StaticData>.with<bool>(&total, fn(value: &StaticData) -> bool {
    return staticSharedIntegerIs(value, 42)
  }), "a field of a struct returned by a static call reads its constructed value")
  let reordered = run StaticExecution.demand(&mut machine, b"reordered", Vector<Shared<StaticData>>.asSlice(&empty), Span.make(usize.ZERO, usize.ZERO))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared<StaticData>.with<bool>(&reordered, fn(value: &StaticData) -> bool {
    return staticSharedIntegerIs(value, 42)
  }), "initializers written out of order still bind their declared fields")
  let guarded = run Effect.result(StaticExecution.demand(&mut machine, b"guarded", Vector<Shared<StaticData>>.asSlice(&empty), Span.make(usize.ZERO, usize.ZERO)))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(staticExecutionFailedWith(&guarded, StaticExecutionFault.StaticPhaseViolation),
    "a struct that a sealed Drop names is not admitted as a static value")
  return ()
}

fn staticExecutionFailedWith(
  answer: &Result<Shared<StaticData>, StaticDiagnostic | OutOfMemoryError>,
  expected: StaticExecutionFault,
) -> bool {
  return match &answer.* {
    Result<Shared<StaticData>, StaticDiagnostic | OutOfMemoryError>.Failure {error} => match &error {
      StaticDiagnostic {fault, ..} => fault == expected
      _ => false
    }
    _ => false
  }
}

fn staticExecutionNeedsConstant(
  answer: &Result<Shared<StaticData>, StaticDiagnostic | OutOfMemoryError>,
  sourceModule: &ModuleId,
  expression: HirId,
  expected: &DeclarationId,
) -> bool {
  return match &answer.* {
    Result<Shared<StaticData>, StaticDiagnostic | OutOfMemoryError>.Failure {error} => match &error {
      StaticDiagnostic {needed, ..} => match &needed {
        Option<StaticExecution.Needed>.Some {value} => {
          return ModuleId.equals(&value.module, sourceModule) && value.expression.index == expression.index &&
            Shared<DeclarationId>.with<bool>(&value.declaration, fn(selected: &DeclarationId) -> bool {
              return DeclarationId.equals(selected, expected)
            })
        }
        Option<StaticExecution.Needed>.None => false
      }
      _ => false
    }
    _ => false
  }
}

fn staticExecutionBodyRejection(
  answer: &Result<Shared<StaticData>, StaticDiagnostic | OutOfMemoryError>,
  code: RejectionCode,
  start: usize,
) -> bool {
  return match &answer.* {
    Result<Shared<StaticData>, StaticDiagnostic | OutOfMemoryError>.Failure {error} => match &error {
      StaticDiagnostic {fault, rejection, ..} => {
        if fault != StaticExecutionFault.Unsupported { return false }
        return match &rejection {
          Option<Shared<Rejection>>.Some {value} => Shared<Rejection>.with<bool>(&value, fn(found: &Rejection) -> bool {
            return found.code == code && found.span.start == start && found.span.end > start
          })
          Option<Shared<Rejection>>.None => false
        }
      }
      _ => false
    }
    _ => false
  }
}

fn staticExecutionMissingFact(
  answer: &Result<Shared<StaticData>, StaticDiagnostic | OutOfMemoryError>,
  expected: StaticMissingFact,
  start: usize,
) -> bool {
  return match &answer.* {
    Result<Shared<StaticData>, StaticDiagnostic | OutOfMemoryError>.Failure {error} => match &error {
      StaticDiagnostic {fault, missing, span, ..} => match &missing {
        Option<StaticMissingFact>.Some {value} => fault == StaticExecutionFault.Unsupported && value == expected && span.start == start
        Option<StaticMissingFact>.None => false
      }
      _ => false
    }
    _ => false
  }
}

test effect fn staticCheckedConstantRetryKeepsSelectedModule() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | StaticDiagnostic | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let entry = run module("constant-entry.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let helper = run module("helper.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let entryText = """import helper as Helper
fn ordinary() { let static selected: usize = Helper.count }
"""
  let helperText = """pub const count: usize = 8
"""
  let entrySource = run present(entryText) |> Effect.provideMut<Allocator>(&mut allocator)
  let helperSource = run present(helperText) |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run Revision.publish(&Revision.make(), &entry, &entrySource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&first, &helper, &helperSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = Semantic.traced(move revision, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option<FinalProfile>.none())
  let mut dependencies = Vector<Dependency>.make()
  let mut port = Semantic.staticPort(&mut semantic, &mut dependencies)
  let cursor = run StaticPort.authoredCursor(&mut port, &entry)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut expression = HirId {index: usize.MAX}
  if let Option<AuthoredCursor>.Some {value: selected} = move cursor {
    if let Option<&Module>.Some {value: hir} = move StaticPort.authoredAtCursor(&port, &selected) {
      let mut at = usize.ZERO
      while at < Vector<Node>.length(&hir.nodes) {
        let candidate = HirId {index: at}
        if let Node.FieldExpression {..} = Module.node(hir, candidate) {
          if Module.span(hir, candidate).start == offsetOf(entryText, "Helper.count", usize.ZERO) {
            expression = candidate
          }
        }
        at = at + usize.ONE
      }
    }
  }
  run Testing.expect(expression.index != usize.MAX, "the qualified constant has an authored expression")
  let expectedIdentity = run StaticPort.resolveRootDeclaration(
    &mut port, &helper, b"count", Span.make(usize.ZERO, usize.ZERO),
  ) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let selectedConstant = match move expectedIdentity {
    Result<DeclarationId, Shared<Rejection>>.Success {value} => move value
    Result<DeclarationId, Shared<Rejection>>.Failure {error: _} => {
      run Testing.expect(false, "the helper has one selected constant declaration")
      return ()
    }
  }
  let primitiveName = run Bytes.copy(b"usize") |> Effect.provideMut<Allocator>(&mut allocator)
  let expected = run Types.intern(Type.Primitive {name: move primitiveName})
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let binders = Vector<StaticRootBinder>.make()
  let answer = run StaticPort.demandCheckedRoot(
    &mut port,
    &entry,
    Option<usize>.none(),
    expression,
    StaticRootExpectation.Resolved {ty: move expected, mismatchCode: RejectionCode.TypeMismatch},
    Vector<StaticRootBinder>.asSlice(&binders),
  ) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let checked = Shared<Result<Answer, NoRejection>>.with<Option<StaticExecution.CheckedRoot>>(
    &answer,
    StaticExecution.checkedRoot,
  )
  if let Option<StaticExecution.CheckedRoot>.Some {value: root} = move checked {
    let mut machine = run StaticExecution.make(move port, &entry, StaticExecution.Limits {steps: 32, depth: 4, valueBytes: 64})
      |> Effect.provideMut<Allocator>(&mut allocator)
    let empty = Vector<StaticExecution.Binding>.make()
    let needed = run Effect.result(StaticExecution.evaluate(&mut machine, &root, Vector<StaticExecution.Binding>.asSlice(&empty), expression))
      |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
    run Testing.expect(
      staticExecutionNeedsConstant(&needed, &entry, expression, &selectedConstant),
      "constant retry preserves both authored source and checked selected module",
    )
    let value = run Shared<StaticData>.make(StaticData.Integer {ty: StaticIntegerType.Usize, sign: StaticSign.Positive, magnitude: 8})
      |> Effect.provideMut<Allocator>(&mut allocator)
    let suppliedModule = ModuleId.copy(&entry)
    let supplied = [StaticExecution.Binding {module: move suppliedModule, binder: expression, value: move value}]
    let resumed = run StaticExecution.evaluate(&mut machine, &root, &supplied, expression)
      |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
    run Testing.expect(Shared<StaticData>.with<bool>(&resumed, fn(actual: &StaticData) -> bool {
      return match &actual.* {
        StaticData.Integer {ty, magnitude, ..} => ty == StaticIntegerType.Usize && magnitude == 8
        _ => false
      }
    }), "supplying the reached constant resumes within the same machine")
    return ()
  }
  run Testing.expect(false, "the qualified constant has an authenticated checked root")
  return ()
}

test effect fn staticRootExpressionRequiresCheckedTypeFacts() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | StaticDiagnostic | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("static-root-check.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let other = run module("static-root-other.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """static fn typed() -> u32 { return 1 }
static fn value() -> u32 { return 2 }
static fn bound(flag: bool) -> bool { return flag }
"""
  let otherSource = """static fn typed() -> u32 { return 1 }
static fn value() -> usize { return 2 }
"""
  let entrySource = run present(source) |> Effect.provideMut<Allocator>(&mut allocator)
  let helperSource = run present(otherSource) |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run Revision.publish(&Revision.make(), &id, &entrySource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&first, &other, &helperSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = Semantic.traced(move revision, MachineTarget.forId(TargetId.Aarch64AppleDarwin), Option<FinalProfile>.none())
  let mut request = Request.make()
  let foreign = run Semantic.demandBody(&mut semantic, &mut request, &other, b"value")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let checked = run Semantic.demandBody(&mut semantic, &mut request, &id, b"typed")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let valueChecked = run Semantic.demandBody(&mut semantic, &mut request, &id, b"value")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let boundChecked = run Semantic.demandBody(&mut semantic, &mut request, &id, b"bound")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut dependencies = Vector<Dependency>.make()
  let mut machine = run StaticExecution.make(Semantic.staticPort(&mut semantic, &mut dependencies), &id, StaticExecution.Limits {steps: 8, depth: 2, valueBytes: 128})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let cursor = run StaticExecution.sourceCursor(&mut machine, &id)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let length = match move StaticExecution.authoredLength(&machine, &cursor) {
    Option<usize>.Some {value} => value
    Option<usize>.None => usize.ZERO
  }
  let mut literal = Option<HirId>.none()
  let mut at = usize.ZERO
  while at < length {
    let candidate = HirId {index: at}
    if let Option<Node>.Some {value: node} = move StaticExecution.authoredNode(&machine, &cursor, candidate) {
      if let Node.IntegerLiteral {..} = node {
        if let Option<Span>.Some {value: span} = move StaticExecution.authoredSpan(&machine, &cursor, candidate) {
          if span.start == offsetOf(source, "2 }", usize.ZERO) {
            literal = Option<HirId>.some(candidate)
            break
          }
        }
      }
    }
    at = at + usize.ONE
  }
  if let Option<HirId>.Some {value: selected} = move literal {
    let checkedValue = Shared<Result<Answer, NoRejection>>.with<Option<StaticExecution.CheckedRoot>>(&checked, StaticExecution.checkedRoot)
    if let Option<StaticExecution.CheckedRoot>.Some {value: body} = move checkedValue {
      let mut bindings = Vector<StaticExecution.Binding>.make()
      let firstModule = ModuleId.copy(&id)
      let firstValue = run Shared<StaticData>.make(StaticData.Boolean {value: true})
        |> Effect.provideMut<Allocator>(&mut allocator)
      run Vector<StaticExecution.Binding>.append(&mut bindings, StaticExecution.Binding {
        module: move firstModule,
        binder: selected,
        value: move firstValue,
      }) |> Effect.provideMut<Allocator>(&mut allocator)
      let attempted = run Effect.result(StaticExecution.evaluate(&mut machine, &body, Vector<StaticExecution.Binding>.asSlice(&bindings), selected))
        |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
      run Testing.expect(
        staticExecutionMissingFact(&attempted, StaticMissingFact.CheckedExpression, offsetOf(source, "2 }", usize.ZERO)),
        "a root literal without its own checked fact cannot silently select u32",
      )
      let valueRoot = Shared<Result<Answer, NoRejection>>.with<Option<StaticExecution.CheckedRoot>>(&valueChecked, StaticExecution.checkedRoot)
      if let Option<StaticExecution.CheckedRoot>.Some {value: valueBody} = move valueRoot {
        let mut nextBindings = Vector<StaticExecution.Binding>.make()
        let nextModule = ModuleId.copy(&id)
        let nextValue = run Shared<StaticData>.make(StaticData.Boolean {value: false})
          |> Effect.provideMut<Allocator>(&mut allocator)
        run Vector<StaticExecution.Binding>.append(&mut nextBindings, StaticExecution.Binding {
          module: move nextModule,
          binder: selected,
          value: move nextValue,
        }) |> Effect.provideMut<Allocator>(&mut allocator)
        let resumed = run Effect.result(StaticExecution.evaluate(&mut machine, &valueBody, Vector<StaticExecution.Binding>.asSlice(&nextBindings), selected))
          |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
        let repeated = run Effect.result(StaticExecution.evaluate(&mut machine, &valueBody, Vector<StaticExecution.Binding>.asSlice(&bindings), selected))
          |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
        run Testing.expect(staticExecutionInteger(&resumed, StaticIntegerType.U32, 2),
          "a literal ignores a supplied binding at the same HIR position")
        run Testing.expect(staticExecutionInteger(&repeated, StaticIntegerType.U32, 2),
          "a repeated literal still ignores a supplied binding")
      } else {
        run Testing.expect(false, "the value fixture has a checked body")
      }
      let mut reference = Option<HirId>.none()
      let mut binder = Option<HirId>.none()
      let mut next = usize.ZERO
      while next < length {
        let candidate = HirId {index: next}
        if let Option<Node>.Some {value: node} = move StaticExecution.authoredNode(&machine, &cursor, candidate) {
          if let Node.IdentifierExpression {binding, ..} = node {
            if binding.present {
              if let Option<Span>.Some {value: span} = move StaticExecution.authoredSpan(&machine, &cursor, candidate) {
                if span.start == offsetOf(source, "return flag", usize.ZERO) + 7 {
                  reference = Option<HirId>.some(candidate)
                  binder = Option<HirId>.some(binding.id)
                }
              }
            }
          }
        }
        next = next + usize.ONE
      }
      if let Option<HirId>.Some {value: reached} = move reference {
        if let Option<HirId>.Some {value: selectedBinder} = move binder {
          let boundRoot = Shared<Result<Answer, NoRejection>>.with<Option<StaticExecution.CheckedRoot>>(&boundChecked, StaticExecution.checkedRoot)
          if let Option<StaticExecution.CheckedRoot>.Some {value: boundBody} = move boundRoot {
            let falseValue = run Shared<StaticData>.make(StaticData.Boolean {value: false}) |> Effect.provideMut<Allocator>(&mut allocator)
            let trueValue = run Shared<StaticData>.make(StaticData.Boolean {value: true}) |> Effect.provideMut<Allocator>(&mut allocator)
            let falseModule = ModuleId.copy(&id)
            let trueModule = ModuleId.copy(&id)
            let first = [StaticExecution.Binding {module: move falseModule, binder: selectedBinder, value: move falseValue}]
            let second = [StaticExecution.Binding {module: move trueModule, binder: selectedBinder, value: move trueValue}]
            let falseResult = run Effect.result(StaticExecution.evaluate(&mut machine, &boundBody, &first, reached))
              |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
            let trueResult = run Effect.result(StaticExecution.evaluate(&mut machine, &boundBody, &second, reached))
              |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
            run Testing.expect(staticExecutionBoolean(&falseResult, false) && staticExecutionBoolean(&trueResult, true),
              "failed and successful root bindings expire before another root evaluation")
          } else {
            run Testing.expect(false, "the bound fixture has a checked body")
          }
        } else {
          run Testing.expect(false, "the reached identifier has a parameter binder")
        }
      } else {
        run Testing.expect(false, "the bound fixture has a reached identifier")
      }
    } else {
      run Testing.expect(false, "typed fixture has a checked body")
    }
    let otherCursor = run StaticExecution.sourceCursor(&mut machine, &other)
      |> Effect.provideMut<Allocator>(&mut allocator)
    let collides = match move StaticExecution.authoredNode(&machine, &otherCursor, selected) {
      Option<Node>.Some {value} => match move value {
        Node.IntegerLiteral {..} => true
        _ => false
      }
      _ => false
    }
    let foreignValue = Shared<Result<Answer, NoRejection>>.with<Option<StaticExecution.CheckedRoot>>(&foreign, StaticExecution.checkedRoot)
    if let Option<StaticExecution.CheckedRoot>.Some {value: foreignRoot} = move foreignValue {
      let bindings = Vector<StaticExecution.Binding>.make()
      let attempted = run Effect.result(StaticExecution.evaluate(&mut machine, &foreignRoot, Vector<StaticExecution.Binding>.asSlice(&bindings), selected))
        |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
      run Testing.expect(
        collides && staticExecutionMissingFact(&attempted, StaticMissingFact.CheckedSource, usize.ZERO),
        "a colliding HIR index from another source cannot authorize root evaluation",
      )
    } else {
      run Testing.expect(false, "foreign fixture has a checked body")
    }
  } else {
    run Testing.expect(false, "static root fixture contains its integer literal")
  }
  return ()
}

fn staticExecutionInteger(
  answer: &Result<Shared<StaticData>, StaticDiagnostic | OutOfMemoryError>,
  expectedType: StaticIntegerType,
  expectedMagnitude: u64,
) -> bool {
  return match &answer.* {
    Result<Shared<StaticData>, StaticDiagnostic | OutOfMemoryError>.Success {value} =>
      Shared<StaticData>.with<bool>(&value, fn(data: &StaticData) -> bool {
        return match &data.* {
          StaticData.Integer {ty, sign, magnitude} =>
            ty == expectedType && sign == StaticSign.Positive && magnitude == expectedMagnitude
          _ => false
        }
      })
    _ => false
  }
}

fn staticExecutionBoolean(
  answer: &Result<Shared<StaticData>, StaticDiagnostic | OutOfMemoryError>,
  expected: bool,
) -> bool {
  return match &answer.* {
    Result<Shared<StaticData>, StaticDiagnostic | OutOfMemoryError>.Success {value} =>
      Shared<StaticData>.with<bool>(&value, fn(data: &StaticData) -> bool {
        return match &data.* {
          StaticData.Boolean {value: actual} => actual == expected
          _ => false
        }
      })
    _ => false
  }
}

fn staticExecutionTraceHas(
  answer: &Result<Shared<StaticData>, StaticDiagnostic | OutOfMemoryError>,
  expected: usize,
) -> bool {
  return match &answer.* {
    Result<Shared<StaticData>, StaticDiagnostic | OutOfMemoryError>.Failure {error} => match &error {
      StaticDiagnostic {trace, ..} => Vector<StaticTraceStep>.length(&trace) == expected
      _ => false
    }
    _ => false
  }
}

fn staticSiteIs(site: &Option<DeclarationId>, module: &ModuleId, name: &[u8]) -> bool {
  return match &site.* {
    Option<DeclarationId>.Some {value} => ModuleId.equals(DeclarationId.moduleId(&value), module) &&
      DeclarationId.named(&value, name)
    Option<DeclarationId>.None => false
  }
}

fn staticExecutionSourceFault(
  answer: &Result<Shared<StaticData>, StaticDiagnostic | OutOfMemoryError>,
  expected: StaticExecutionFault,
  code: &[u8],
  offset: usize,
) -> bool {
  return match &answer.* {
    Result<Shared<StaticData>, StaticDiagnostic | OutOfMemoryError>.Failure {error} => match &error {
      StaticDiagnostic {fault, code: actualCode, span, ..} => fault == expected && sameBytes(actualCode, code) && span.start == offset && span.end == offset + usize.ONE
      _ => false
    }
    _ => false
  }
}

fn staticExecutionCallFault(
  answer: &Result<Shared<StaticData>, StaticDiagnostic | OutOfMemoryError>,
  expected: StaticExecutionFault,
  expectedCode: &[u8],
  offset: usize,
  width: usize,
) -> bool {
  return match &answer.* {
    Result<Shared<StaticData>, StaticDiagnostic | OutOfMemoryError>.Failure {error} => match &error {
      StaticDiagnostic {fault, code, span, ..} => fault == expected && sameBytes(code, expectedCode) && span.start == offset && span.end == offset + width
      _ => false
    }
    _ => false
  }
}

test effect fn staticCallsResolveImportedDeclarationsAndHeldEdits() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | StaticDiagnostic | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let entry = run module("static-import-entry.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let helper = run module("helper.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let entryText = """import helper { value as selected, hidden, runtime }
import helper as Helper
static fn direct() -> u32 { return selected() }
static fn qualified() -> u32 { return Helper.value() }
static fn privateCall() -> u32 { return hidden() }
static fn runtimeCall() -> u32 { return runtime() }
"""
  let entrySource = run present(entryText) |> Effect.provideMut<Allocator>(&mut allocator)
  let helperSource = run present("""pub static fn value() -> u32 { return 7 }
static fn hidden() -> u32 { return 1 }
pub fn runtime() -> u32 { return 1 }
""")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run Revision.publish(&Revision.make(), &entry, &entrySource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&first, &helper, &helperSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(run Revision.copy(&revision) |> Effect.provideMut<Allocator>(&mut allocator))
  let mut staticDependencies = Vector<Dependency>.make()
  let mut machine = run StaticExecution.make(Semantic.staticPort(&mut semantic, &mut staticDependencies), &entry, StaticExecution.Limits {steps: 64, depth: 8, valueBytes: 256})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let args = Vector<Shared<StaticData>>.make()
  let empty = Vector<Shared<StaticData>>.asSlice(&args)
  let span = Span.make(usize.ZERO, usize.ZERO)
  let direct = run StaticExecution.demand(&mut machine, b"direct", empty, span)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let qualified = run StaticExecution.demand(&mut machine, b"qualified", empty, span)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared<StaticData>.with<bool>(&direct, fn(value: &StaticData) -> bool {
    return staticSharedIntegerIs(value, 7)
  }) && Shared<StaticData>.with<bool>(&qualified, fn(value: &StaticData) -> bool {
    return staticSharedIntegerIs(value, 7)
  }), "aliased and qualified imports select the helper's static body")
  let hidden = run Effect.result(StaticExecution.demand(&mut machine, b"privateCall", empty, span))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let runtime = run Effect.result(StaticExecution.demand(&mut machine, b"runtimeCall", empty, span))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    staticExecutionBodyRejection(&hidden, RejectionCode.PrivateMember, offsetOf(entryText, "hidden", usize.ZERO)) &&
    staticExecutionBodyRejection(&runtime, RejectionCode.StaticPhaseViolation, offsetOf(entryText, "runtime()", usize.ZERO)),
    "private and runtime callees keep their checked source rejections",
  )
  drop machine
  let recorded = Vector<Dependency>.asSlice(&staticDependencies)
  let mut reachedBody = false
  let mut at = usize.ZERO
  while at < recorded.length {
    if recorded[at].family == Family.Body && ModuleId.equals(Semantic.dependencyModule(&semantic, &recorded[at]), &helper) {
      let found = run Semantic.dependencyDeclaration(&mut semantic, &recorded[at])
        |> Effect.provideMut<Allocator>(&mut allocator)
      if let Option<DeclarationId>.Some {value: declaration} = move found {
        if DeclarationId.named(&declaration, b"value") {
          reachedBody = true
        }
      }
    }
    at = at + usize.ONE
  }
  run Testing.expect(reachedBody, "a reached imported static body has a canonical query dependency")
  let changed = run present("""pub static fn value() -> u32 { return 9 }
static fn hidden() -> u32 { return 1 }
pub fn runtime() -> u32 { return 1 }
""")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let updated = run Revision.publish(&revision, &helper, &changed)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Semantic.update(&mut semantic, move updated) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut freshDependencies = Vector<Dependency>.make()
  let mut freshMachine = run StaticExecution.make(Semantic.staticPort(&mut semantic, &mut freshDependencies), &entry, StaticExecution.Limits {steps: 64, depth: 8, valueBytes: 256})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let replaced = run StaticExecution.demand(&mut freshMachine, b"direct", empty, span)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared<StaticData>.with<bool>(&replaced, fn(value: &StaticData) -> bool {
    return staticSharedIntegerIs(value, 9)
  }), "a fresh demand reads the edited helper body")
  return ()
}

test effect fn staticCallsDetectCrossModuleCycles() -> ()
! InvalidModulePath | OutOfMemoryError | StaticDiagnostic | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let alpha = run module("alpha.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let beta = run module("beta.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let alphaText = """import beta as Beta
pub static fn ping() -> u32 { return Beta.pong() }
"""
  let betaText = """import alpha as Alpha
pub static fn pong() -> u32 { return Alpha.ping() }
"""
  let alphaSource = run present(alphaText) |> Effect.provideMut<Allocator>(&mut allocator)
  let betaSource = run present(betaText) |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run Revision.publish(&Revision.make(), &alpha, &alphaSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&first, &beta, &betaSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut dependencies = Vector<Dependency>.make()
  let mut machine = run StaticExecution.make(Semantic.staticPort(&mut semantic, &mut dependencies), &alpha, StaticExecution.Limits {steps: 64, depth: 8, valueBytes: 256})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let args = Vector<Shared<StaticData>>.make()
  let attempted = run Effect.result(StaticExecution.demand(
    &mut machine,
    b"ping",
    Vector<Shared<StaticData>>.asSlice(&args),
    Span.make(usize.ZERO, usize.ZERO),
  )) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    staticExecutionCallFault(&attempted, StaticExecutionFault.Cycle, b"SEM0178", offsetOf(betaText, "Alpha.ping()", usize.ZERO), 12) &&
    staticExecutionTraceHas(&attempted, 2),
    "cross-module recursion uses canonical callee identity and reports the authored call",
  )
  let mut sitesMatch = false
  if let Result<Shared<StaticData>, StaticDiagnostic | OutOfMemoryError>.Failure {error} = &attempted {
    if let StaticDiagnostic {site, trace, ..} = &error {
      let path = Vector<StaticTraceStep>.asSlice(&trace)
      if path.length == 2 {
        let firstExternal = match &path[usize.ZERO].site {
          Option<DeclarationId>.None => true
          _ => false
        }
        sitesMatch = firstExternal && staticSiteIs(&site, &beta, b"pong") &&
          staticSiteIs(&path[usize.ONE].site, &alpha, b"ping")
      }
    }
  }
  run Testing.expect(sitesMatch, "the primary site belongs to the foreign callee and each trace site belongs to its caller")
  let external = run Effect.result(StaticExecution.demand(
    &mut machine, b"missing", Vector<Shared<StaticData>>.asSlice(&args), Span.make(usize.ONE, usize.ONE),
  )) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(staticExecutionFailedWith(&external, StaticExecutionFault.Unavailable),
    "an external missing demand reports its ordinary unavailable fault")
  if let Result<Shared<StaticData>, StaticDiagnostic | OutOfMemoryError>.Failure {error} = &external {
    if let StaticDiagnostic {site, ..} = &error {
      run Testing.expect(!staticSiteIs(&site, &alpha, b"ping"),
        "an external demand cannot attribute its authored position to the previously active body")
    }
  }
  return ()
}

test effect fn staticTextFailuresRetainForeignOriginOwner() -> ()
! InvalidModulePath | OutOfMemoryError | StaticDiagnostic | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let caller = run module("static-text-caller.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let provider = run module("provider.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let callerText = """import provider as Provider
pub static fn inspect() -> u8 { return Intrinsic.staticTextByteAt(Provider.text(), 99) }
"""
  let providerText = """pub static fn text() -> string<'static> { return "abc" }
"""
  let callerSource = run present(callerText) |> Effect.provideMut<Allocator>(&mut allocator)
  let providerSource = run present(providerText) |> Effect.provideMut<Allocator>(&mut allocator)
  let first = run Revision.publish(&Revision.make(), &caller, &callerSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&first, &provider, &providerSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut dependencies = Vector<Dependency>.make()
  let mut machine = run StaticExecution.make(Semantic.staticPort(&mut semantic, &mut dependencies), &caller,
    StaticExecution.Limits {steps: 80, depth: 8, valueBytes: 256})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let args = Vector<Shared<StaticData>>.make()
  let attempted = run Effect.result(StaticExecution.demand(&mut machine, b"inspect",
    Vector<Shared<StaticData>>.asSlice(&args), Span.make(usize.ZERO, usize.ZERO)))
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut retained = false
  if let Result<Shared<StaticData>, StaticDiagnostic | OutOfMemoryError>.Failure {error} = &attempted {
    if let StaticDiagnostic {fault, span, site, origin, originSite, byteOffset, ..} = &error {
      let originMatches = match &origin {
        Option<Span>.Some {value} => value.start == offsetOf(providerText, "\"abc\"", usize.ZERO)
        Option<Span>.None => false
      }
      let byteMatches = match &byteOffset {
        Option<u64>.Some {value} => value == 99
        Option<u64>.None => false
      }
      retained = fault == StaticExecutionFault.InvalidValue &&
        span.start == offsetOf(callerText, "Intrinsic.staticTextByteAt", usize.ZERO) &&
        staticSiteIs(&site, &caller, b"inspect") &&
        originMatches && staticSiteIs(&originSite, &provider, b"text") && byteMatches
    }
  }
  run Testing.expect(retained, "a static text failure keeps the caller span and the foreign literal's declaration")
  return ()
}

test effect fn movedStaticIterationsRetainSelectionAndExecution() -> ()
  ! InvalidModulePath
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
    | StaticDiagnostic
    | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run movedIterationClaims() |> Effect.provideMut<Types>(&mut typeTable)
    |> Effect.provideMut<Allocator>(&mut allocator)
}

struct IterationPair {
  first: BodyStaticIteration
  second: BodyStaticIteration
}

impl Copy for IterationPair {}

fn iterationPair(body: &TypedBody) -> Option<IterationPair> {
  let facts = TypedBody.staticIterations(body)
  if facts.length != 2 {
    return Option<IterationPair>.none()
  }
  return Option<IterationPair>.some(IterationPair { first: facts[0], second: facts[1] })
}

fn sameIteration(left: BodyStaticIteration, right: BodyStaticIteration) -> bool {
  return left.syntax == right.syntax && left.ordinal == right.ordinal
    && left.nodeStart == right.nodeStart
    && left.nodeEnd == right.nodeEnd
    && left.localStart == right.localStart
    && left.localEnd == right.localEnd
}

effect fn movedIterationClaims() -> ()
  ! InvalidModulePath
    | Cycle
    | RevisionMismatch
    | OutOfMemoryError
    | StaticDiagnostic
    | AssertionError<'static>
  ? &mut Allocator | &mut Types {
  let id = run module("relative-static-iterations.silk")
  let beforeText = """
fn padding() -> i32 { return 0 }
static fn sequence() -> Intrinsic.StaticSequence<i32> {
  let initial = Intrinsic.staticSequenceEmpty<i32>()
  let first = Intrinsic.staticSequenceAppend<i32>(move initial, 3)
  return Intrinsic.staticSequenceAppend<i32>(move first, 7)
}
static fn sum() -> i32 {
  let mut total = 0
  static for element in sequence() { total = total + element }
  return total
}
"""
  let afterText = """
fn padding() -> i32 {
  let changed = 11
  return changed
}
static fn sequence() -> Intrinsic.StaticSequence<i32> {
  let initial = Intrinsic.staticSequenceEmpty<i32>()
  let first = Intrinsic.staticSequenceAppend<i32>(move initial, 3)
  return Intrinsic.staticSequenceAppend<i32>(move first, 7)
}
static fn sum() -> i32 {
  let mut total = 0
  static for element in sequence() { total = total + element }
  return total
}
"""
  let first = run Revision.publish(&Revision.make(), &id, &run present(beforeText))
  let mut index = SourceIndex.make(run Revision.copy(&first))
  let application = run selectedApplicationOf(&mut index, &id, b"sum")
  let mut store = makeSemantic(run Revision.copy(&first))
  let mut request = Request.make()
  let before = run Semantic.demandSelectedBody(&mut store, &mut request, &application)
  let beforeAnchor = run answerAnchor(&mut store, &before)
  let beforeBody = Shared<
    Result<Answer, NoRejection>
  >.with<Option<Shared<TypedBody>>>(&before, checkedBody)
  let mut dependencies = Vector<Dependency>.make()
  let mut machine = run StaticExecution.make(
    Semantic.staticPort(&mut store, &mut dependencies),
    &id,
    StaticExecution.defaultLimits()
  )
  let arguments = Vector<Shared<StaticData>>.make()
  let original = run StaticExecution.demand(
    &mut machine,
    b"sum",
    Vector<Shared<StaticData>>.asSlice(&arguments),
    Span.make(usize.ZERO, usize.ZERO)
  )
  run Testing.expect(
    Shared<StaticData>.with<bool>(
      &original,
      fn(value: &StaticData) -> bool {
        return staticSharedIntegerIs(value, 10)
      }
    ),
    "the original selected static iterations execute both sequence elements"
  )
  drop machine
  let updated = run Revision.publish(&first, &id, &run present(afterText))
  run Semantic.update(&mut store, move updated)
  let after = run Semantic.demandSelectedBody(&mut store, &mut request, &application)
  let afterAnchor = run answerAnchor(&mut store, &after)
  let afterBody = Shared<
    Result<Answer, NoRejection>
  >.with<Option<Shared<TypedBody>>>(&after, checkedBody)
  let mut stable = false
  if let Option<Shared<TypedBody>>.Some { value: prior } = &beforeBody {
    if let Option<Shared<TypedBody>>.Some { value: current } = &afterBody {
      let a = Shared<TypedBody>.with<Option<IterationPair>>(&prior, iterationPair)
      let b = Shared<TypedBody>.with<Option<IterationPair>>(&current, iterationPair)
      if let Option<IterationPair>.Some { value: left } = &a {
        if let Option<IterationPair>.Some { value: right } = &b {
          stable = left.first.ordinal == usize.ZERO && left.second.ordinal == usize.ONE
            && left.first.nodeEnd > left.first.nodeStart
            && left.second.nodeEnd > left.second.nodeStart
            && sameIteration(left.first, right.first)
            && sameIteration(left.second, right.second)
        }
      }
    }
  }
  let mut shifted = false
  if let Option<Anchor>.Some { value: prior } = &beforeAnchor {
    if let Option<Anchor>.Some { value: current } = &afterAnchor {
      shifted = current.first.index > prior.first.index && current.token > prior.token
    }
  }
  run Testing.expect(
    stable && shifted,
    "stored static-for syntax and exact generated ranges stay equal after an earlier declaration moves their HIR and byte anchors"
  )
  let mut repeated = run StaticExecution.make(
    Semantic.staticPort(&mut store, &mut dependencies),
    &id,
    StaticExecution.defaultLimits()
  )
  let result = run StaticExecution.demand(
    &mut repeated,
    b"sum",
    Vector<Shared<StaticData>>.asSlice(&arguments),
    Span.make(usize.ZERO, usize.ZERO)
  )
  run Testing.expect(
    Shared<StaticData>.with<bool>(
      &result,
      fn(value: &StaticData) -> bool {
        return staticSharedIntegerIs(value, 10)
      }
    ),
    "the evaluator resolves relative occurrence syntax against the new source and executes both iterations (STATIC-005)"
  )
}

test effect fn selectedStaticIfArmResolvesOrdinaryFacts() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | StaticDiagnostic | MixedDiagnostic | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let entry = run module("selected-arm.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
fn helper() -> i32 { return 7 }
fn selected() -> i32 {
  static if true {
    let value: i32 = helper()
    return value
  } else {
    let invalid: Missing = missing()
    return invalid
  }
}
static fn sequence() -> Intrinsic.StaticSequence<i32> {
  let initial = Intrinsic.staticSequenceEmpty<i32>()
  let first = Intrinsic.staticSequenceAppend<i32>(move initial, 3)
  return Intrinsic.staticSequenceAppend<i32>(move first, 7)
}
fn first(value: i32) -> i32 { return value }
fn second(value: i32) -> i32 { return value }
fn expanded(flag: bool) -> i32 {
  let mut outer = 0
  static for element in sequence() {
    let local = element
    static if element == 3 { outer = outer + first(local) }
    else { outer = outer + second(local) }
    if flag { outer = outer + local }
  }
  return outer
}
fn empty() -> i32 {
  static for element in Intrinsic.staticSequenceEmpty<i32>() { missing(element) }
  return 0
}
fn borrowed(source: &i32) -> i32 {
  let mut total = 0
  static for element in sequence() { total = total + source.* + element }
  return total
}
fn later() -> i32 {
  let mut outer = 0
  static for element in sequence() {
    static if element == 7 { compileError("late") }
    else { outer = outer + element }
  }
  return outer
}
fn ordinaryArray() -> i32 {
  static for element in [3, 7] { missing(element) }
  return 0
}
fn generatedBorrow() -> i32 {
  static for element in sequence() { let loan = &element }
  return 0
}
fn escapedBorrow() -> i32 {
  let outside = 0
  let mut slot = &outside
  static for element in sequence() {
    let inside = element
    slot = &inside
  }
  return slot.*
}
fn leaked() -> Intrinsic.StaticSequence<i32> { return sequence() }
service PhaseCapability<T> {}
struct PhaseRows<?R> {}
effect fn failedPhase() -> i32 ! Intrinsic.StaticSequence<i32> { return 0 }
effect fn requiredPhase() -> i32 ? &PhaseCapability<Intrinsic.StaticSequence<i32>> { return 0 }
fn rowPhase(value: PhaseRows<&PhaseCapability<Intrinsic.StaticSequence<i32>>>) -> i32 { return 0 }
fn nestedEffectPhase(value: once Effect<'static; i32 ? &PhaseCapability<Intrinsic.StaticSequence<i32>>>) -> i32 { return 0 }
const guardKind: u8 = 0
static fn kind() -> u8 { return 0 }
fn constantGuard() -> i32 {
  static if kind() != guardKind { compileError("kind") }
  return 0
}
"""
  let source = run present(text) |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut index = SourceIndex.make(run Revision.copy(&revision) |> Effect.provideMut<Allocator>(&mut allocator))
  let declaration = run requireIndexedIdentity(&mut index, &entry, OwnerKind.Function, b"selected", usize.ZERO)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let application = run specializationWithArguments(&declaration, Vector<Argument>.make())
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let body = run Semantic.demandSelectedBody(&mut semantic, &mut request, &application)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<AnswerView>(&body, inspect).success,
    "the selected arm resolves its typed local and helper call without demanding the invalid arm",
  )
  let guard = run selectedApplicationOf(&mut index, &entry, b"constantGuard")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let guarded = run Semantic.demandSelectedBody(&mut semantic, &mut request, &guard)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared<Result<Answer, NoRejection>>.with<AnswerView>(&guarded, inspect).success,
    "a selected condition reads a module constant the selection has not resolved yet",
  )
  run staticForSelectionClaims(&mut semantic, &mut index, &mut request, &entry, text)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  return ()
}

// Each claim uses the actor's one source revision/store. Evaluation proves the sequence itself;
// the body proof checks actual ordinary occurrences, and MIR must be a genuine Value.Mir.
effect fn staticForSelectionClaims(store: &mut Semantic, index: &mut SourceIndex, request: &mut Request,
  id: &ModuleId, text: string) -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | StaticDiagnostic | MixedDiagnostic | AssertionError<'static>
? &mut Allocator | &mut Types {
  run Testing.expect(run evaluatedStaticSequence(&mut store.*, id), "sealed sequence evaluation keeps exact i32 elements in order 3 then 7")
  let source = run SourceIndex.demand(&mut index.*, id)
  let cursor = match move run SourceIndex.authoredCursor(&mut index.*, &source, id) {
    Option<AuthoredCursor>.Some {value} => move value
    _ => { fail InvalidModulePath {} }
  }
  let expandedFor = "static for element in sequence() {\n    let local = element\n    static if element == 3 { outer = outer + first(local) }\n    else { outer = outer + second(local) }\n    if flag { outer = outer + local }\n  }"
  let borrowedFor = "static for element in sequence() { total = total + source.* + element }"
  let expanded = run selectedApplicationOf(&mut index.*, id, b"expanded")
  let body = run Semantic.demandSelectedBody(&mut store.*, &mut request.*, &expanded)
  let expandedAnchor = run answerAnchor(&mut store.*, &body)
  let typed = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&body, checkedBody)
  let authentic = match move typed {
    Option<Shared<TypedBody>>.Some {value} => Shared<TypedBody>.with<bool>(&value,
      fn(typed: &TypedBody) -> bool {
        return staticIterationShape(typed) && staticIterationAuthoredFor(typed, &expandedAnchor, &index.*, &cursor,
          SpecializationApplication.bodyDeclaration(&expanded), text, expandedFor)
      })
    Option<Shared<TypedBody>>.None => false
  }
  run Testing.expect(authentic, "two original-for occurrences embed distinct elements, bind fresh locals, select distinct canonical callees and preserve the outer slot and runtime branch")
  let mir = run Semantic.demandMir(&mut store.*, &mut request.*, id, b"expanded")
  let realMir = match move Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&mir, selectedMirIndex) {
    Option<usize>.Some {..} => true
    Option<usize>.None => false
  }
  run Testing.expect(realMir,
    "selected scalar iterations lower to real ordinary MIR")
  let empty = run selectedApplicationOf(&mut index.*, id, b"empty")
  let emptyBody = run Semantic.demandSelectedBody(&mut store.*, &mut request.*, &empty)
  let emptyTyped = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&emptyBody, checkedBody)
  let emptyExact = match move emptyTyped {
    Option<Shared<TypedBody>>.Some {value} => Shared<TypedBody>.with<bool>(&value, emptyStaticIterationShape)
    Option<Shared<TypedBody>>.None => false
  }
  run Testing.expect(emptyExact, "an empty sealed sequence produces a real body with no iterations or missing callee")
  let borrowed = run selectedApplicationOf(&mut index.*, id, b"borrowed")
  let borrowedBody = run Semantic.demandSelectedBody(&mut store.*, &mut request.*, &borrowed)
  let borrowedAnchor = run answerAnchor(&mut store.*, &borrowedBody)
  let borrowedTyped = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&borrowedBody, checkedBody)
  let borrowedExact = match move borrowedTyped {
    Option<Shared<TypedBody>>.Some {value} => Shared<TypedBody>.with<bool>(&value,
      fn(typed: &TypedBody) -> bool {
        return borrowedStaticIterationShape(typed, &borrowedAnchor, text) && staticIterationAuthoredFor(typed, &borrowedAnchor, &index.*, &cursor,
          SpecializationApplication.bodyDeclaration(&borrowed), text, borrowedFor)
      })
    Option<Shared<TypedBody>>.None => false
  }
  run Testing.expect(borrowedExact, "both selected iterations read the original borrowed input without creating a generated loan")
  let later = run selectedApplicationOf(&mut index.*, id, b"later")
  let rejected = run Semantic.demandSelectedBody(&mut store.*, &mut request.*, &later)
  run Testing.expect(rejectsSpan(&rejected, RejectionCode.SelectedCompileError, text, "compileError(\"late\")", usize.ZERO),
    "a later iteration failure rejects the whole selected body instead of publishing the first iteration")
  let array = run selectedApplicationOf(&mut index.*, id, b"ordinaryArray")
  let arrayBody = run Semantic.demandSelectedBody(&mut store.*, &mut request.*, &array)
  run Testing.expect(rejectsSpan(&arrayBody, RejectionCode.StaticViolation, text, "[3, 7]", usize.ZERO),
    "a runtime array never acquires the sealed static iterable contract")
  let borrow = run selectedApplicationOf(&mut index.*, id, b"generatedBorrow")
  let borrowBody = run Semantic.demandSelectedBody(&mut store.*, &mut request.*, &borrow)
  run Testing.expect(succeeded(&borrowBody), "a loan of storage one occurrence generates stays inside that occurrence")
  let escape = run selectedApplicationOf(&mut index.*, id, b"escapedBorrow")
  let escapeBody = run Semantic.demandSelectedBody(&mut store.*, &mut request.*, &escape)
  run Testing.expect(rejectsSpan(&escapeBody, RejectionCode.Unsupported, text, "&inside", usize.ZERO),
    "a loan of generated storage written to an outside place keeps the occurrence-identity boundary")
  let leak = run Semantic.demandSignature(&mut store.*, &mut request.*, id, b"leaked")
  run Testing.expect(rejectsSpan(&leak, RejectionCode.StaticPhaseViolation, text, "Intrinsic.StaticSequence<i32>", usize.ONE),
    "a sequence has no runtime result layout")
  let failure = run Semantic.demandSignature(&mut store.*, &mut request.*, id, b"failedPhase")
  let requirements = run Semantic.demandSignature(&mut store.*, &mut request.*, id, b"requiredPhase")
  let rowArgument = run Semantic.demandSignature(&mut store.*, &mut request.*, id, b"rowPhase")
  let nestedEffect = run Semantic.demandSignature(&mut store.*, &mut request.*, id, b"nestedEffectPhase")
  run Testing.expect(rejectsSpan(&failure, RejectionCode.StaticPhaseViolation, text, "Intrinsic.StaticSequence<i32>", 2),
    "a runtime failure channel cannot retain a phase-only sequence")
  run Testing.expect(rejectsSpan(&requirements, RejectionCode.StaticPhaseViolation, text,
    "? &PhaseCapability<Intrinsic.StaticSequence<i32>>", usize.ZERO),
    "a runtime requirement capability cannot retain a phase-only type argument")
  run Testing.expect(rejectsSpan(&rowArgument, RejectionCode.StaticPhaseViolation, text,
    "PhaseRows<&PhaseCapability<Intrinsic.StaticSequence<i32>>>", usize.ZERO) &&
    rejectsSpan(&nestedEffect, RejectionCode.StaticPhaseViolation, text,
    "once Effect<'static; i32 ? &PhaseCapability<Intrinsic.StaticSequence<i32>>>", usize.ZERO),
    "nested row arguments and Effect requirements retain the phase boundary at their authored types")
  run Testing.expect(run staticForGrowthBudget(&mut store.*, id, text),
    "a global residual budget refuses the second occurrence before any selected body is published")
  return ()
}

effect fn staticForGrowthBudget(store: &mut Semantic, id: &ModuleId, text: string) -> bool
! OutOfMemoryError | StaticDiagnostic | MixedDiagnostic ? &mut Allocator | &mut Types {
  let mut dependencies = Vector<Dependency>.make()
  let mut machine = run MixedBody.make(Semantic.staticPort(&mut store.*, &mut dependencies), id,
    StaticExecution.Limits {steps: 512, depth: 8, valueBytes: 4096}, 8)
  let named = run MixedBody.applicationNamed(&machine, b"expanded")
  let application = match move named {
    Option<SpecializationApplication>.Some {value} => move value
    Option<SpecializationApplication>.None => { return false }
  }
  let failed = run Effect.result(MixedBody.specialize(&mut machine, &application))
  let expected = offsetOf(text, "let local = element", usize.ZERO)
  return match &failed {
    Result<MixedBodyResult, MixedDiagnostic | StaticDiagnostic | OutOfMemoryError>.Failure {error} => {
      return match &error {
        MixedDiagnostic {fault, span, occurrence, ..} => {
          let second = match &occurrence { Option<MixedBody.IterationOccurrence>.Some {value} => value.ordinal == usize.ONE Option<MixedBody.IterationOccurrence>.None => false }
          return fault == MixedFault.ResidualGrowth && span.start == expected && span.end == expected + String.utf8Bytes("let local = element").length && second
        }
        _ => false
      }
    }
    _ => false
  }
}

effect fn evaluatedStaticSequence(store: &mut Semantic, id: &ModuleId) -> bool
! OutOfMemoryError | StaticDiagnostic ? &mut Allocator | &mut Types {
  let mut dependencies = Vector<Dependency>.make()
  let mut machine = run StaticExecution.make(Semantic.staticPort(&mut store.*, &mut dependencies), id,
    StaticExecution.Limits {steps: 128, depth: 8, valueBytes: 4096})
  let empty = Vector<Shared<StaticData>>.make()
  let value = run StaticExecution.demand(&mut machine, b"sequence", Vector<Shared<StaticData>>.asSlice(&empty), Span.make(usize.ZERO, usize.ZERO))
  return Shared<StaticData>.with<bool>(&value, staticSequenceValues)
}

fn staticIterationI32(value: &StaticData, expected: u64) -> bool {
  return match &value.* {
    StaticData.Integer {ty, sign, magnitude} => ty == StaticIntegerType.I32 && sign == StaticSign.Positive && magnitude == expected
    _ => false
  }
}

fn staticSequenceValues(value: &StaticData) -> bool {
  if let StaticData.Sequence {ty, elements, ..} = &value.* {
    let exact = Shared<Type>.with<Option<Shared<Type>>>(&ty, CheckedIntrinsic.staticSequenceElement)
    let isI32 = match move exact {
      Option<Shared<Type>>.Some {value: element} => Shared<Type>.with<bool>(&element, fn(shape: &Type) -> bool { return witnessPrimitive(shape, b"i32") })
      Option<Shared<Type>>.None => false
    }
    let entries = Vector<Shared<StaticData>>.asSlice(&elements)
    if !isI32 || entries.length != 2 { return false }
    return Shared<StaticData>.with<bool>(&entries[usize.ZERO], fn(data: &StaticData) -> bool { return staticIterationI32(data, 3) }) &&
      Shared<StaticData>.with<bool>(&entries[usize.ONE], fn(data: &StaticData) -> bool { return staticIterationI32(data, 7) })
  }
  return false
}

fn iterationInteger(nodes: &[BodyNode], node: BodyNodeId, magnitude: u64) -> bool {
  if node.index >= nodes.length { return false }
  if let BodyNodeKind.Expression {ty, form: BodyExpression.Embedded {value}} = &nodes[node.index].kind {
    return Shared<Type>.with<bool>(&ty, fn(shape: &Type) -> bool { return witnessPrimitive(shape, b"i32") }) &&
      Shared<StaticData>.with<bool>(&value, fn(data: &StaticData) -> bool { return staticIterationI32(data, magnitude) })
  }
  return false
}

fn staticIterationAuthoredFor(body: &TypedBody, anchor: &Option<Anchor>, index: &SourceIndex, cursor: &AuthoredCursor,
  owner: &DeclarationId, text: string, written: string) -> bool {
  if !DeclarationId.equals(TypedBody.declarationId(body), owner) { return false }
  let anchored = match &anchor.* { Option<Anchor>.Some {value} => Anchor.copy(&value) _ => { return false } }
  let expected = offsetOf(text, written, usize.ZERO)
  if expected == usize.MAX { return false }
  let end = expected + String.utf8Bytes(written).length
  let facts = TypedBody.staticIterations(body)
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < facts.length {
    let BodyStaticIteration {syntax: node, ..} = &facts[at]
    let syntax = Anchor.hir(&anchored, node)
    let selected = SourceIndex.authoredNode(index, cursor, syntax)
    let actualFor = match &selected {
      Option<Node>.Some {value: Node.StaticForStatement {..}} => true
      _ => false
    }
    if !actualFor { return false }
    let span = match move SourceIndex.authoredSpan(index, cursor, syntax) {
      Option<Span>.Some {value} => value
      _ => { return false }
    }
    if span.start != expected || span.end != end { return false }
    count = count + usize.ONE

    at = at + usize.ONE
  }
  return count == 2
}

fn emptyStaticIterationShape(body: &TypedBody) -> bool {
  return TypedBody.staticIterations(body).length == usize.ZERO && directCalls(body) == usize.ZERO
}

fn staticBorrowedInputType(value: &Type) -> bool {
  if let Type.Reference {access, referent, ..} = &value.* {
    return access == Access.Shared && Shared<Type>.with<bool>(&referent, isI32)
  }
  return false
}

fn borrowedStaticIterationShape(body: &TypedBody, anchor: &Option<Anchor>, text: string) -> bool {
  let locals = TypedBody.localSlice(body)
  let authored = offsetOf(text, "source: &i32", usize.ZERO)
  let parameter = match &anchor.* {
    Option<Anchor>.Some {value} => Anchor.span(&value, locals[usize.ZERO].origin.location)
    Option<Anchor>.None => { return false }
  }
  if locals.length < usize.ONE || locals[usize.ZERO].mutable ||
    parameter.start != authored || parameter.end != authored + 6 ||
    !Shared<Type>.with<bool>(&locals[usize.ZERO].ty, staticBorrowedInputType) { return false }
  let facts = TypedBody.staticIterations(body)
  let nodes = TypedBody.nodeSlice(body)
  let mut ordinal = usize.ZERO
  let mut original = usize.MAX
  let mut priorEnd = usize.ZERO
  let mut at = usize.ZERO
  while at < facts.length {
    let BodyStaticIteration {syntax, ordinal: selected, nodeStart, nodeEnd, ..} = &facts[at]
    if selected != ordinal || nodeStart < priorEnd || nodeEnd > nodes.length { return false }
    if ordinal == usize.ZERO { original = syntax }
    else if syntax != original { return false }
    let mut reads = usize.ZERO
    let mut elements = usize.ZERO
    let mut magnitude: u64 = 3
    if ordinal == usize.ONE { magnitude = 7 }
    let mut nodeAt = nodeStart
    while nodeAt < nodeEnd {
      if iterationInteger(nodes, BodyNodeId {index: nodeAt}, magnitude) { elements = elements + usize.ONE }
      if let BodyNodeKind.Expression {ty, form: BodyExpression.Dereference {value}} = &nodes[nodeAt].kind {
        if !Shared<Type>.with<bool>(&ty, isI32) || value.index >= nodes.length { return false }
        if let BodyNodeKind.Expression {form: BodyExpression.Local {local}, ..} = &nodes[value.index].kind {
          if local.index != usize.ZERO { return false }
        } else { return false }
        reads = reads + usize.ONE
      }
      if let BodyNodeKind.Expression {form: BodyExpression.Borrow {..}, ..} = &nodes[nodeAt].kind { return false }
      nodeAt = nodeAt + usize.ONE
    }
    if reads != usize.ONE || elements != usize.ONE { return false }
    priorEnd = nodeEnd
    ordinal = ordinal + usize.ONE

    at = at + usize.ONE
  }
  return ordinal == 2
}

union StaticIterationNodeEvidence {
  Other,
  Invalid,
  Bound { initializer: BodyNodeId },
  Called { argument: BodyNodeId },
  Branched { condition: BodyNodeId },
  Written { target: BodyNodeId },
}

fn staticIterationApplicationMatches(application: &Shared<SpecializationApplication>,
  declared: &DeclarationId) -> bool {
  return Shared<SpecializationApplication>.with<bool>(application,
    fn(selected: &SpecializationApplication) -> bool {
      return DeclarationId.equals(SpecializationApplication.bodyDeclaration(selected), declared) &&
        Vector<Argument>.length(&selected.arguments) == usize.ZERO &&
        Vector<StaticSlot>.length(&selected.statics) == usize.ZERO
    })
}

fn staticIterationNodeEvidence(node: &BodyNode, expected: &[u8], owner: &DeclarationId,
  expectedLocal: usize) -> StaticIterationNodeEvidence {
  match &node.kind {
    BodyNodeKind.LocalBinding {local, initializer} => {
      if local.index != expectedLocal { return StaticIterationNodeEvidence.Invalid }
      return StaticIterationNodeEvidence.Bound {initializer: initializer}
    }
    BodyNodeKind.Expression {form: BodyExpression.DirectCall {declaration, application, arguments, ..}, ..} => {
      if !DeclarationId.named(&declaration, expected) ||
        !ModuleId.equals(DeclarationId.moduleId(&declaration), DeclarationId.moduleId(owner)) {
        return StaticIterationNodeEvidence.Invalid
      }
      if !staticIterationApplicationMatches(&application, &declaration) {
        return StaticIterationNodeEvidence.Invalid
      }
      let values = Vector<BodyNodeId>.asSlice(&arguments)
      if values.length != usize.ONE { return StaticIterationNodeEvidence.Invalid }
      return StaticIterationNodeEvidence.Called {argument: values[usize.ZERO]}
    }
    BodyNodeKind.Branch {condition, ..} => {
      return StaticIterationNodeEvidence.Branched {condition: condition}
    }
    BodyNodeKind.PlaceAssignment {target, ..} => {
      return StaticIterationNodeEvidence.Written {target: target}
    }
    _ => { return StaticIterationNodeEvidence.Other }
  }
}

fn staticIterationLocalIs(body: &TypedBody, id: BodyNodeId, expected: usize) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  if id.index >= nodes.length { return false }
  return match &nodes[id.index].kind {
    BodyNodeKind.Expression {form: BodyExpression.Local {local}, ..} => local.index == expected
    _ => false
  }
}

fn staticIterationShape(body: &TypedBody) -> bool {
  let facts = TypedBody.staticIterations(body)
  let nodes = TypedBody.nodeSlice(body)
  let locals = TypedBody.localSlice(body)
  let mut ordinal = usize.ZERO
  let mut original = usize.MAX
  let mut priorNodeEnd = usize.ZERO
  let mut priorLocalEnd = usize.ZERO
  let mut firstLocal = usize.MAX
  let mut at = usize.ZERO
  while at < facts.length {
    let BodyStaticIteration {syntax, ordinal: selected, nodeStart, nodeEnd, localStart, localEnd} = &facts[at]
    if selected != ordinal || nodeStart < priorNodeEnd || localStart < priorLocalEnd || nodeEnd > nodes.length ||
      localEnd > locals.length || localEnd != localStart + usize.ONE { return false }
    if ordinal == usize.ZERO {
      original = syntax
      firstLocal = localStart
    }
    else if syntax != original || localStart == firstLocal { return false }
    let mut magnitude: u64 = 3
    let mut expected: &'static [u8] = b"first"
    if ordinal == usize.ONE {
      magnitude = 7
      expected = b"second"
    }
    let mut bound = usize.ZERO
    let mut called = usize.ZERO
    let mut branch = usize.ZERO
    let mut assignments = usize.ZERO
    let mut nodeAt = nodeStart
    while nodeAt < nodeEnd {
      let evidence = staticIterationNodeEvidence(&nodes[nodeAt], expected,
        TypedBody.declarationId(body), localStart)
      match move evidence {
        StaticIterationNodeEvidence.Invalid => { return false }
        StaticIterationNodeEvidence.Bound {initializer} => {
          if !iterationInteger(TypedBody.nodeSlice(body), initializer, magnitude) { return false }
          bound = bound + usize.ONE
        }
        StaticIterationNodeEvidence.Called {argument} => {
          if !staticIterationLocalIs(body, argument, localStart) { return false }
          called = called + usize.ONE
        }
        StaticIterationNodeEvidence.Branched {condition} => {
          if !staticIterationLocalIs(body, condition, usize.ZERO) { return false }
          branch = branch + usize.ONE
        }
        StaticIterationNodeEvidence.Written {target} => {
          if !staticIterationLocalIs(body, target, usize.ONE) { return false }
          assignments = assignments + usize.ONE
        }
        StaticIterationNodeEvidence.Other => {}
      }
      nodeAt = nodeAt + usize.ONE
    }
    if bound != usize.ONE || called != usize.ONE || branch != usize.ONE || assignments != 2 { return false }
    priorNodeEnd = nodeEnd
    priorLocalEnd = localEnd
    ordinal = ordinal + usize.ONE

    at = at + usize.ONE
  }
  return ordinal == 2
}

fn embeddedI32(body: &TypedBody, magnitude: u64) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.Embedded {value}, ..} = &nodes[at].kind {
      let matches = Shared<StaticData>.with<bool>(&value, fn(data: &StaticData) -> bool {
        return match & data.* {
          StaticData.Integer {ty, sign, magnitude: found} => ty == StaticIntegerType.I32 && sign == StaticSign.Positive && found == magnitude
          _ => false
        }
      })
      if matches { count = count + usize.ONE }
    }
    at = at + usize.ONE
  }
  return count
}

fn bindingsAndErrors(body: &TypedBody) -> usize {
  let nodes = TypedBody.nodeSlice(body)
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    match & nodes[at].kind {
      BodyNodeKind.LocalBinding {..} => { count = count + usize.ONE }
      BodyNodeKind.Expression {form: BodyExpression.CompileError {..}, ..} => { count = count + usize.ONE }
      _ => ()
    }
    at = at + usize.ONE
  }
  return count
}

// Selected body shape: Embedded 21 count, direct-call count, binding/compileError count, Checked.
effect fn selectedShape(answer: &Shared<Result<Answer, NoRejection>>) -> Vector<usize> ! OutOfMemoryError ? &mut Allocator {
  let mut shape = Vector<usize>.make()
  let body = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value: typed} = move body {
    run Vector<usize>.append(&mut shape, Shared<TypedBody>.with<usize>(&typed, fn(value: &TypedBody) -> usize { return embeddedI32(value, 21) }))
    run Vector<usize>.append(&mut shape, Shared<TypedBody>.with<usize>(&typed, directCalls))
    run Vector<usize>.append(&mut shape, Shared<TypedBody>.with<usize>(&typed, bindingsAndErrors))
    let unchecked = Shared<TypedBody>.with<bool>(&typed, borrowNotChecked)
    if unchecked { run Vector<usize>.append(&mut shape, usize.ZERO) } else { run Vector<usize>.append(&mut shape, usize.ONE) }
  }
  return move shape
}

// Exactly one embedded i32 of this magnitude, no direct call, no local or error node, and a
// selected body the borrow stage proves like any other.
fn selectedEmbedsOnly(answer: &Shared<Result<Answer, NoRejection>>, magnitude: u64) -> bool {
  let body = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value: typed} = move body {
    return Shared<TypedBody>.with<bool>(&typed, fn(checked: &TypedBody) -> bool {
      return embeddedI32(checked, magnitude) == usize.ONE && directCalls(checked) == usize.ZERO
        && bindingsAndErrors(checked) == usize.ZERO && !borrowNotChecked(checked)
    })
  }
  return false
}

fn sameShape(shape: &Vector<usize>, embedded: usize, calls: usize, bindings: usize) -> bool {
  let values = Vector<usize>.asSlice(shape)
  return values.length == 4 && values[usize.ZERO] == embedded && values[usize.ONE] == calls && values[2] == bindings && values[3] == usize.ONE
}

test effect fn selectedBodiesRouteStaticWorkAndEmbedValues() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run selectedBodyRoutingClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn selectedBodyRoutingClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("b12-selected-routing.silk")
  let source = """
static fn amount(base: i32) -> i32 { return base * 10 + 1 }
fn withLocal(value: i32) -> i32 {
  let static scaled = amount(2)
  return scaled + value
}
fn direct(value: i32) -> i32 { return amount(2) + value }
fn wordBits() -> i32 {
  static if Intrinsic.targetPointerBits() == 64 {
    return 64
  } else {
    compileError("this program requires a 64-bit target")
  }
}
static fn tagged<T>(base: i32) -> i32 { return base * 2 }
fn scaled<T>() -> i32 { return tagged<T>(21) }
"""
  let authored = run present(source)
  let revision = run Revision.publish(&Revision.make(), &id, &authored)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let scaledDeclaration = run requireIndexedIdentity(&mut index, &id, OwnerKind.Function, b"scaled", usize.ZERO)
  let mut wordArguments = Vector<Argument>.make()
  run Vector<Argument>.append(&mut wordArguments, Argument.Type {value: run Types.intern(Type.Primitive {name: run Bytes.copy(b"i32")})})
  let scaledWord = run specializationWithArguments(&scaledDeclaration, move wordArguments)
  let mut flagArguments = Vector<Argument>.make()
  run Vector<Argument>.append(&mut flagArguments, Argument.Type {value: run Types.intern(Type.Primitive {name: run Bytes.copy(b"bool")})})
  let scaledFlag = run specializationWithArguments(&scaledDeclaration, move flagArguments)
  let withLocal = run selectedApplicationOf(&mut index, &id, b"withLocal")
  let direct = run selectedApplicationOf(&mut index, &id, b"direct")
  let wordBits = run selectedApplicationOf(&mut index, &id, b"wordBits")
  let mut store = makeSemantic(run Revision.copy(&revision))
  let mut request = Request.make()
  let abstractLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"withLocal")
  let abstractBits = run Semantic.demandBody(&mut store, &mut request, &id, b"wordBits")
  let staticLocalStart = offsetOf(source, "let static scaled", usize.ZERO)
  let abstractLocalRejects = Shared<Result<Answer, NoRejection>>.with<bool>(&abstractLocal, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionAt(answer, RejectionCode.Unsupported, staticLocalStart)
    })
  run Testing.expect(abstractLocalRejects && succeeded(&abstractBits),
    "the abstract body defers a static local but selects a closed target condition without reaching compileError")
  let selectedLocal = run Semantic.demandSelectedBody(&mut store, &mut request, &withLocal)
  let selectedDirect = run Semantic.demandSelectedBody(&mut store, &mut request, &direct)
  let selectedBits = run Semantic.demandSelectedBody(&mut store, &mut request, &wordBits)
  let localShape = run selectedShape(&selectedLocal)
  let directShape = run selectedShape(&selectedDirect)
  let bitsShape = run selectedShape(&selectedBits)
  run Testing.expect(sameShape(&localShape, usize.ONE, usize.ZERO, usize.ZERO),
    "a let static read is one embedded i32 21 with no runtime local or helper call, and so is borrow-checked")
  run Testing.expect(sameShape(&directShape, usize.ONE, usize.ZERO, usize.ZERO),
    "a direct static-helper call is one embedded i32 21 with no runtime call, and so is borrow-checked")
  run Testing.expect(sameShape(&bitsShape, usize.ZERO, usize.ZERO, usize.ZERO),
    "only the selected target arm is typed; the inactive compileError arm leaves no node")
  let genericBodies = starts(Semantic.eventLog(&store), Family.Body)
  let selectedWord = run Semantic.demandSelectedBody(&mut store, &mut request, &scaledWord)
  let wordBodies = starts(Semantic.eventLog(&store), Family.Body)
  let selectedFlag = run Semantic.demandSelectedBody(&mut store, &mut request, &scaledFlag)
  let flagBodies = starts(Semantic.eventLog(&store), Family.Body)
  run Testing.expect(selectedEmbedsOnly(&selectedWord, 42),
    "scaled<i32> closes its static call with i32: one embedded 42 and no runtime call or local")
  run Testing.expect(selectedEmbedsOnly(&selectedFlag, 42),
    "scaled<bool> closes its static call with bool: one embedded 42 and no runtime call or local")
  run Testing.expect(wordBodies == genericBodies + 2,
    "the first application starts its selected body and the static helper's one checked body")
  run Testing.expect(flagBodies == wordBodies + 2,
    "the distinct bool application starts its selected body and its separately checked generic helper body")
  let repeatedWord = run Semantic.demandSelectedBody(&mut store, &mut request, &scaledWord)
  let repeatedFlag = run Semantic.demandSelectedBody(&mut store, &mut request, &scaledFlag)
  run Testing.expect(selectedEmbedsOnly(&repeatedWord, 42) && selectedEmbedsOnly(&repeatedFlag, 42)
      && starts(Semantic.eventLog(&store), Family.Body) == flagBodies,
    "repeating either equal generic application reuses its selected caller and checked helper without new body demands")
  let bodies = starts(Semantic.eventLog(&store), Family.Body)
  let again = run Semantic.demandSelectedBody(&mut store, &mut request, &withLocal)
  run Testing.expect(succeeded(&again) && starts(Semantic.eventLog(&store), Family.Body) == bodies,
    "equal semantic applications reuse one selected body")
  let localMir = run Semantic.demandMir(&mut store, &mut request, &id, b"withLocal")
  let directMir = run Semantic.demandMir(&mut store, &mut request, &id, b"direct")
  let bitsMir = run Semantic.demandMir(&mut store, &mut request, &id, b"wordBits")
  run Testing.expect(mirReferenceCount(&store, &localMir) == usize.ZERO && mirReferenceCount(&store, &directMir) == usize.ZERO
      && mirReferenceCount(&store, &bitsMir) == usize.ZERO,
    "member MIR lowers the selected bodies: no static helper instance or reference is created")
  return ()
}

