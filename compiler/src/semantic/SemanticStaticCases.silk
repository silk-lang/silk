test effect fn nominalMembersAndRequestedCompositeShapes() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("shapes.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  // A written but undeclared lifetime fails only when its member is demanded: it never needs
  // resolving to know a declaration's lifetime arity. A field type name does, so `Missing` makes
  // every application of `Held` and `Maybe` reject while their identities stay available.
  let shapesText = "struct Node { next: Node }\nstruct Box<T> {\n value: T\n deferred: &'undeclared i32\n}\nunion Choice<T> { None, Some { payload: T }, Broken { payload: &'undeclared i32 } }\ntuple Pair(i32, bool)\nenum State { Start, Done }\nfn boxed() -> Box<bool> { return () }\nfn boxedAgain() -> Box<bool> { return () }\nfn chosen() -> Choice<bool> { return () }\nfn array() -> [Node; 0] { return () }\nconst COUNT: u32 = 0\nfn pending() -> [Node; COUNT] { return () }\nstruct Held<T> {\n value: T\n deferred: Missing\n}\nunion Maybe<T> { None, Broken { payload: Missing } }\nfn held() -> Held<bool> { return () }\nfn maybe() -> Maybe<bool> { return () }\n"
  let source = run present(shapesText)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let node = run Semantic.demandIdentity(&mut semantic, &mut request, &entry, b"Node")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let recursive = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &node,
    nominalResult,
  )
  if let Option<Shared<Type>>.Some {value: nodeType} = move recursive {
    let names = run Semantic.demandMembers(&mut semantic, &mut request, &entry, b"Node")
      |> Effect.provideMut<Allocator>(&mut allocator)
    let shape = run Semantic.demandMemberShape(
      &mut semantic,
      &mut request,
      &entry,
      b"Node",
      0,
      &nodeType,
    )
      |> Effect.provideMut<Allocator>(&mut allocator)
    run Testing.expect(
      Shared.with<Result<Answer, NoRejection>, AnswerView>(&names, inspect).success && Shared.with<
        Result<Answer, NoRejection>,
        bool,
      >(&shape, shapeFirstIsNominal),
      "recursive nominal identity and written member type terminate without layout",
    )
  } else {
    run Testing.expect(false, "recursive nominal identity resolves")
  }
  let boxed = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"boxed")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let boxType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &boxed,
    signatureResult,
  )
  if let Option<Shared<Type>>.Some {value: applied} = move boxType {
    let names = run Semantic.demandMembers(&mut semantic, &mut request, &entry, b"Box")
      |> Effect.provideMut<Allocator>(&mut allocator)
    let value = run Semantic.demandMemberShape(
      &mut semantic,
      &mut request,
      &entry,
      b"Box",
      0,
      &applied,
    )
      |> Effect.provideMut<Allocator>(&mut allocator)
    let deferred = run Semantic.demandMemberShape(
      &mut semantic,
      &mut request,
      &entry,
      b"Box",
      1,
      &applied,
    )
      |> Effect.provideMut<Allocator>(&mut allocator)
    run Testing.expect(
      Shared.with<Result<Answer, NoRejection>, bool>(
        &names,
        fn(answer: &Result<Answer, NoRejection>) -> bool {
          return memberNames(answer, b"value", b"deferred")
        },
      ),
      "member names survive an unrelated invalid field",
    )
    run Testing.expect(
      Shared.with<Result<Answer, NoRejection>, bool>(&value, shapeFirstIsBool),
      "applied field type substitutes T",
    )
    run Testing.expect(
      Shared.with<Result<Answer, NoRejection>, bool>(
        &deferred,
        fn(answer: &Result<Answer, NoRejection>) -> bool {
          return rejectionSpells(answer, RejectionCode.UnknownLifetime, String.utf8Bytes(shapesText), b"'undeclared")
        },
      ),
      "an arity-independent invalid field rejects only when its member is requested",
    )
    let sameShapeStarts = starts(Semantic.eventLog(&semantic), Family.MemberShape)
    let sameShapeHits = hits(Semantic.eventLog(&semantic), Family.MemberShape)
    let separatelyWritten = run Semantic.demandSignature(
      &mut semantic,
      &mut request,
      &entry,
      b"boxedAgain",
    )
      |> Effect.provideMut<Allocator>(&mut allocator)
    let secondApplication = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
      &separatelyWritten,
      signatureResult,
    )
    if let Option<Shared<Type>>.Some {value: separatelyDerived} = move secondApplication {
      let repeated = run Semantic.demandMemberShape(
        &mut semantic,
        &mut request,
        &entry,
        b"Box",
        0,
        &separatelyDerived,
      )
        |> Effect.provideMut<Allocator>(&mut allocator)
      run Testing.expect(
        Shared.with<Result<Answer, NoRejection>, bool>(&repeated, shapeFirstIsBool) && starts(
          Semantic.eventLog(&semantic),
          Family.MemberShape,
        ) == sameShapeStarts && hits(Semantic.eventLog(&semantic), Family.MemberShape) > sameShapeHits,
        "equal separately derived nominal applications reuse one member-shape fact",
      )
    } else {
      run Testing.expect(false, "the second generic nominal application resolves")
    }
  } else {
    run Testing.expect(false, "generic nominal application resolves")
  }
  let chosen = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"chosen")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let choiceType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &chosen,
    signatureResult,
  )
  if let Option<Shared<Type>>.Some {value: applied} = move choiceType {
    let names = run Semantic.demandMembers(&mut semantic, &mut request, &entry, b"Choice")
      |> Effect.provideMut<Allocator>(&mut allocator)
    let empty = run Semantic.demandMemberShape(
      &mut semantic,
      &mut request,
      &entry,
      b"Choice",
      0,
      &applied,
    )
      |> Effect.provideMut<Allocator>(&mut allocator)
    let some = run Semantic.demandMemberShape(
      &mut semantic,
      &mut request,
      &entry,
      b"Choice",
      1,
      &applied,
    )
      |> Effect.provideMut<Allocator>(&mut allocator)
    run Testing.expect(
      Shared.with<Result<Answer, NoRejection>, AnswerView>(&names, inspect).success && Shared.with<
        Result<Answer, NoRejection>,
        usize,
      >(&empty, shapeCount) == 0 && Shared.with<Result<Answer, NoRejection>, bool>(
        &some,
        shapeFirstIsBool,
      ),
      "union variant payload is selected and substituted independently",
    )
  } else {
    run Testing.expect(false, "generic union application resolves")
  }
  let pair = run Semantic.demandIdentity(&mut semantic, &mut request, &entry, b"Pair")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let tupleType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &pair,
    nominalResult,
  )
  if let Option<Shared<Type>>.Some {value: applied} = move tupleType {
    let position = run Semantic.demandMemberShape(
      &mut semantic,
      &mut request,
      &entry,
      b"Pair",
      1,
      &applied,
    )
      |> Effect.provideMut<Allocator>(&mut allocator)
    run Testing.expect(
      Shared.with<Result<Answer, NoRejection>, bool>(&position, shapeFirstIsBool),
      "tuple position resolves its selected written type",
    )
  } else {
    run Testing.expect(false, "tuple identity resolves")
  }
  let enumeration = run Semantic.demandIdentity(&mut semantic, &mut request, &entry, b"State")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let enumType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
    &enumeration,
    nominalResult,
  )
  if let Option<Shared<Type>>.Some {value: applied} = move enumType {
    let names = run Semantic.demandMembers(&mut semantic, &mut request, &entry, b"State")
      |> Effect.provideMut<Allocator>(&mut allocator)
    let case = run Semantic.demandMemberShape(
      &mut semantic,
      &mut request,
      &entry,
      b"State",
      0,
      &applied,
    )
      |> Effect.provideMut<Allocator>(&mut allocator)
    run Testing.expect(
      Shared.with<Result<Answer, NoRejection>, bool>(
        &names,
        fn(answer: &Result<Answer, NoRejection>) -> bool {
          return memberNames(answer, b"Start", b"Done")
        },
      ) && Shared.with<Result<Answer, NoRejection>, usize>(&case, shapeCount) == 0,
      "enum names are ordered and scalar cases have no payload",
    )
  } else {
    run Testing.expect(false, "enum identity resolves")
  }
  let array = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"array")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let pending = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"pending")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&array, signatureIsZeroNominalArray) &&
      Shared.with<Result<Answer, NoRejection>, bool>(&pending, signatureIsZeroNominalArray),
    "literal and named constant extents select the same canonical array type",
  )
  let held = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"held")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let maybe = run Semantic.demandSignature(&mut semantic, &mut request, &entry, b"maybe")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let heldIdentity = run Semantic.demandIdentity(&mut semantic, &mut request, &entry, b"Held")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let heldNames = run Semantic.demandMembers(&mut semantic, &mut request, &entry, b"Held")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let heldArity = Shared.with<Result<Answer, NoRejection>, bool>(
    &held,
    fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionSpells(answer, RejectionCode.UnknownName, String.utf8Bytes(shapesText), b"Missing")
    },
  )
  let maybeArity = rejectsAt(&maybe, RejectionCode.UnknownName)
  let identityView = Shared.with<Result<Answer, NoRejection>, AnswerView>(&heldIdentity, inspect)
  let namesView = Shared.with<Result<Answer, NoRejection>, AnswerView>(&heldNames, inspect)
  run Testing.expect(
    heldArity && maybeArity && identityView.success && namesView.success,
    "an application needs its field type names for lifetime arity while identity and member names stay lazy",
  )
  return ()
}

