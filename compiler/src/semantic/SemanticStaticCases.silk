}

test effect fn staticArithmeticReportsOperationCodeAndSpan() -> ()
! InvalidModulePath | OutOfMemoryError | StaticDiagnostic | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("static-arithmetic.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = "static fn add(value: u32) -> u32 { return value + 1 }\nstatic fn divide(value: u32) -> u32 { return value / 0 }\n"
  let mut semantic = run staticSemantic(&id, source, MachineTarget.forId(TargetId.Aarch64AppleDarwin))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut staticDependencies = Vector.make<Dependency>()
  let mut machine = run StaticExecution.make(Semantic.staticPort(&mut semantic, &mut staticDependencies), &id, StaticExecution.Limits {steps: 32, depth: 4, valueBytes: 512})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let max = run Shared.make<StaticData>(StaticData.Integer {ty: StaticIntegerType.U32, sign: StaticSign.Positive, magnitude: 4294967295})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let one = run Shared.make<StaticData>(StaticData.Integer {ty: StaticIntegerType.U32, sign: StaticSign.Positive, magnitude: 1})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let overflow = run Effect.result(StaticExecution.demand(&mut machine, b"add", &[move max], Span.make(usize.ZERO, usize.ZERO)))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(staticExecutionSourceFault(&overflow, StaticExecutionFault.Overflow, b"SEM0176", offsetOf(source, "+", usize.ZERO)), "overflow names the authored operator and static diagnostic code")
  let division = run Effect.result(StaticExecution.demand(&mut machine, b"divide", &[move one], Span.make(usize.ZERO, usize.ZERO)))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(staticExecutionSourceFault(&division, StaticExecutionFault.DivisionByZero, b"SEM0176", offsetOf(source, "/", usize.ZERO)), "division by zero names the authored operator and static diagnostic code")
  return ()
}

test effect fn staticCallsDistinguishCyclesLimitsAndCheckedFailures() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | StaticDiagnostic | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("static-failures.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """static fn cycle(value: u32) -> u32 { return cycle(value) }
static fn descend(value: u32) -> u32 { return descend(value + 1) }
static fn spin(value: u32) -> u32 { while true {} return value }
static fn badField(boxed: Box) -> u32 { let mut result = boxed result.value = 1 return 0 }
fn runtime(value: u32) -> u32 { return value }
static fn badCall(value: u32) -> u32 { return runtime(value) }
static fn skipped(value: u32) -> bool { return false && broken(value) }
static fn broken(value: u32) -> bool { return missing }
static fn reported(value: u32) -> u32 { compileError("invalid static value") }
static fn terminal(value: u32) -> never { compileError("terminal failure") }
static fn forwarded(value: u32) -> u32 { terminal(value) }
struct Box { value: u32 }
"""
  let mut semantic = run staticSemantic(&id, source, MachineTarget.forId(TargetId.Aarch64AppleDarwin))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut staticDependencies = Vector.make<Dependency>()
  let mut machine = run StaticExecution.make(Semantic.staticPort(&mut semantic, &mut staticDependencies), &id, StaticExecution.Limits {steps: 100, depth: 2, valueBytes: 1024})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let input = run Shared.make<StaticData>(StaticData.Integer {ty: StaticIntegerType.U32, sign: StaticSign.Positive, magnitude: 1})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let args = [move input]
  let span = Span.make(usize.ZERO, usize.ZERO)
  let cycle = run Effect.result(StaticExecution.demand(&mut machine, b"cycle", &args, span))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(staticExecutionFailedWith(&cycle, StaticExecutionFault.Cycle) && staticExecutionTraceHas(&cycle, usize.ONE), "equal active call reports its ordered trace")
  let depth = run Effect.result(StaticExecution.demand(&mut machine, b"descend", &args, span))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(staticExecutionFailedWith(&depth, StaticExecutionFault.DepthLimit) && staticExecutionTraceHas(&depth, 2), "distinct recursive calls exhaust depth")
  let skipped = run StaticExecution.demand(&mut machine, b"skipped", &args, span)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared.with<StaticData, bool>(&skipped, fn(value: &StaticData) -> bool {
    return match &value.* {
      StaticData.Boolean {value: chosen} => !chosen
      _ => false
    }
  }), "short circuit leaves the invalid function uncalled")
  let sameCycle = run Effect.result(StaticExecution.demand(&mut machine, b"cycle", &args, span))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(staticExecutionFailedWith(&sameCycle, StaticExecutionFault.Cycle), "typed failure leaves the call retryable")
  let steps = run Effect.result(StaticExecution.demand(&mut machine, b"spin", &args, span))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(staticExecutionFailedWith(&steps, StaticExecutionFault.StepLimit), "loop exhausts the step budget")
  let invalid = run Effect.result(StaticExecution.demand(&mut machine, b"badField", &args, span))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    staticExecutionBodyRejection(&invalid, RejectionCode.StaticPhaseViolation, offsetOf(source, "result.value", usize.ZERO)),
    "evaluator preserves the checked body's field-mutation rejection and source span",
  )
  drop machine
  let mut reportedMachine = run StaticExecution.make(
    Semantic.staticPort(&mut semantic, &mut staticDependencies),
    &id,
    StaticExecution.Limits {steps: 16, depth: 2, valueBytes: 1024},
  ) |> Effect.provideMut<Allocator>(&mut allocator)
  let reported = run Effect.result(StaticExecution.demand(&mut reportedMachine, b"reported", &args, span))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    staticExecutionCallFault(
      &reported,
      StaticExecutionFault.CompileError,
      b"SEM0177",
      offsetOf(source, "compileError", usize.ZERO),
      String.utf8Bytes("compileError(\"invalid static value\")").length,
    ),
    "checked compileError reports its selected source diagnostic",
  )
  drop reportedMachine
  let mut forwardedMachine = run StaticExecution.make(
    Semantic.staticPort(&mut semantic, &mut staticDependencies),
    &id,
    StaticExecution.Limits {steps: 16, depth: 3, valueBytes: 1024},
  ) |> Effect.provideMut<Allocator>(&mut allocator)
  let forwarded = run Effect.result(StaticExecution.demand(&mut forwardedMachine, b"forwarded", &args, span))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    staticExecutionCallFault(
      &forwarded,
      StaticExecutionFault.CompileError,
      b"SEM0177",
      offsetOf(source, "compileError(\"terminal failure\")", usize.ZERO),
      String.utf8Bytes("compileError(\"terminal failure\")").length,
    ),
    "a checked never-returning call terminates its enclosing static body",
  )
  drop forwardedMachine
  let mut request = Request.make()
  let runtime = run Semantic.demandBody(&mut semantic, &mut request, &id, b"badCall")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsFrom(&runtime, RejectionCode.StaticPhaseViolation, offsetOf(source, "runtime(value)", usize.ZERO)),
    "a runtime call in a static body rejects at its authored call before evaluation",
  )
  return ()
}

fn staticBodyExpressionAt(answer: &Result<Answer, NoRejection>, start: usize) -> HirId {
  return match &answer.* {
    Result<Answer, NoRejection>.Success {value} => match &value.outcome {
      Outcome.Success {value: Value.Body {body, ..}} => Shared.with<TypedBody, HirId>(
        &body,
        fn(checked: &TypedBody) -> HirId {
          let nodes = TypedBody.nodeSlice(checked)
          let mut at = usize.ZERO
          while at < nodes.length {
            if nodes[at].origin.span.start == start {
              if let BodyNodeKind.Expression {..} = &nodes[at].kind { return nodes[at].origin.syntax }
            }
            at = at + usize.ONE
          }
          return HirId {index: usize.MAX}
        },
      )
      _ => HirId {index: usize.MAX}
    }
    _ => HirId {index: usize.MAX}
  }
}

test effect fn staticRetainedValueLimitRejectsPublication() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | StaticDiagnostic | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("static-value-limit.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """
static fn identity(value: u32) -> u32 { return value }
static fn texts() -> u32 {
  let mut at: u32 = 0
  while at < 3 {
    let text = "abcdefghijklmnopqrstuvwx"
    at = at + 1
  }
  return 7
}
static fn returned() -> string<'static> { return "abcdefghijklmnopqrstuvwx" }
static fn alias() -> string<'static> { return returned() }
static fn resumed(supplied: string<'static>) -> string<'static> { return supplied }
static fn wide() -> [u32; 8] { return [1, 2, 3, 4, 5, 6, 7, 8] }
"""
  let textLiteral = "\"abcdefghijklmnopqrstuvwx\""
  let literalStart = offsetOf(source, textLiteral, usize.ONE)
  let mut semantic = run staticSemantic(&id, source, MachineTarget.forId(TargetId.Aarch64AppleDarwin))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut staticDependencies = Vector.make<Dependency>()
  let mut machine = run StaticExecution.make(Semantic.staticPort(&mut semantic, &mut staticDependencies), &id, StaticExecution.Limits {steps: 20, depth: 4, valueBytes: 32})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let input = run Shared.make<StaticData>(StaticData.Integer {ty: StaticIntegerType.U32, sign: StaticSign.Positive, magnitude: 1})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let args = [move input]
  let first = run StaticExecution.demand(&mut machine, b"identity", &args, Span.make(usize.ZERO, usize.ZERO))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let repeated = run StaticExecution.demand(&mut machine, b"identity", &args, Span.make(usize.ZERO, usize.ZERO))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared.with<StaticData, bool>(&first, fn(value: &StaticData) -> bool {
    return staticSharedIntegerIs(value, 1)
  }) && Shared.with<StaticData, bool>(&repeated, fn(value: &StaticData) -> bool {
    return staticSharedIntegerIs(value, 1)
  }), "equal static arguments reuse a completed result")
  let two = run Shared.make<StaticData>(StaticData.Integer {ty: StaticIntegerType.U32, sign: StaticSign.Positive, magnitude: 2})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let different = [move two]
  let attempted = run Effect.result(StaticExecution.demand(&mut machine, b"identity", &different, Span.make(usize.ZERO, usize.ZERO)))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(staticExecutionFailedWith(&attempted, StaticExecutionFault.ValueLimit), "distinct result exceeds retained value budget")
  drop machine
  let mut arrayDependencies = Vector.make<Dependency>()
  let mut arrayMachine = run StaticExecution.make(Semantic.staticPort(&mut semantic, &mut arrayDependencies), &id, StaticExecution.Limits {steps: 64, depth: 4, valueBytes: 48})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let noArrayArguments = Vector.make<Shared<StaticData>>()
  let wide = run Effect.result(StaticExecution.demand(&mut arrayMachine, b"wide", Vector.asSlice<Shared<StaticData>>(&noArrayArguments), Span.make(usize.ZERO, usize.ZERO)))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(staticExecutionFailedWith(&wide, StaticExecutionFault.ValueLimit), "constructing a static array is charged to the retained value budget")
  drop arrayMachine
  let mut textDependencies = Vector.make<Dependency>()
  let mut textMachine = run StaticExecution.make(Semantic.staticPort(&mut semantic, &mut textDependencies), &id, StaticExecution.Limits {steps: 128, depth: 4, valueBytes: 64})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let noArguments = Vector.make<Shared<StaticData>>()
  let repeatedText = run Effect.result(StaticExecution.demand(&mut textMachine, b"texts", Vector.asSlice<Shared<StaticData>>(&noArguments), Span.make(usize.ZERO, usize.ZERO)))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(staticExecutionFailedWith(&repeatedText, StaticExecutionFault.ValueLimit), "retained text provenance exhausts the cumulative value budget without publishing a value")
  drop textMachine
  let mut returnedDependencies = Vector.make<Dependency>()
  let mut returnedMachine = run StaticExecution.make(Semantic.staticPort(&mut semantic, &mut returnedDependencies), &id, StaticExecution.Limits {steps: 32, depth: 4, valueBytes: 64})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let returned = run StaticExecution.demand(&mut returnedMachine, b"alias", Vector.asSlice<Shared<StaticData>>(&noArguments), Span.make(usize.ZERO, usize.ZERO))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let origin = StaticExecution.textOrigin(&returnedMachine, &returned)
  let returnedOriginMatches = match move origin {
    Option<Span>.Some {value: returnedOrigin} => returnedOrigin.start == literalStart
    Option<Span>.None => false
  }
  run Testing.expect(returnedOriginMatches, "returned text aliases preserve the authored origin without a second budget charge")
  drop returnedMachine
  let mut rootRequest = Request.make()
  let literalBody = run Semantic.demandBody(&mut semantic, &mut rootRequest, &id, b"returned")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let resumedBody = run Semantic.demandBody(&mut semantic, &mut rootRequest, &id, b"resumed")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let literalId = Shared.with<Result<Answer, NoRejection>, HirId>(&literalBody, fn(answer: &Result<Answer, NoRejection>) -> HirId {
    return staticBodyExpressionAt(answer, literalStart)
  })
  let resumedId = Shared.with<Result<Answer, NoRejection>, HirId>(&resumedBody, fn(answer: &Result<Answer, NoRejection>) -> HirId {
    return staticBodyExpressionAt(answer, offsetOf(source, "supplied }", usize.ZERO))
  })
  let checkedLiteralRoot = Shared.with<Result<Answer, NoRejection>, Option<StaticExecution.CheckedRoot>>(
    &literalBody, StaticExecution.checkedRoot,
  )
  let literalRoot = match move checkedLiteralRoot {
    Option<StaticExecution.CheckedRoot>.Some {value: checkedLiteral} => move checkedLiteral
    Option<StaticExecution.CheckedRoot>.None => {
      run Testing.expect(false, "the text literal has a checked root")
      return ()
    }
  }
  let checkedResumedRoot = Shared.with<Result<Answer, NoRejection>, Option<StaticExecution.CheckedRoot>>(
    &resumedBody, StaticExecution.checkedRoot,
  )
  let resumedRoot = match move checkedResumedRoot {
    Option<StaticExecution.CheckedRoot>.Some {value: checkedResumed} => move checkedResumed
    Option<StaticExecution.CheckedRoot>.None => {
      run Testing.expect(false, "the supplied text reference has a checked root")
      return ()
    }
  }
  let mut rootDependencies = Vector.make<Dependency>()
  let mut rootMachine = run StaticExecution.make(Semantic.staticPort(&mut semantic, &mut rootDependencies), &id, StaticExecution.Limits {steps: 32, depth: 4, valueBytes: 64})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let noBindings = Vector.make<StaticExecution.Binding>()
  let literalValue = run StaticExecution.evaluate(&mut rootMachine, &literalRoot, Vector.asSlice<StaticExecution.Binding>(&noBindings), literalId)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let suppliedModule = run ModuleId.copy(&id) |> Effect.provideMut<Allocator>(&mut allocator)
  let supplied = [StaticExecution.Binding {
    module: move suppliedModule,
    binder: resumedId,
    value: StaticValue.copy(&literalValue),
  }]
  let resumedValue = run StaticExecution.evaluate(&mut rootMachine, &resumedRoot, &supplied, resumedId)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let resumedOriginValue = StaticExecution.textOrigin(&rootMachine, &resumedValue)
  let resumedOriginMatches = match move resumedOriginValue {
    Option<Span>.Some {value: resumedOrigin} => resumedOrigin.start == literalStart
    Option<Span>.None => false
  }
  run Testing.expect(resumedOriginMatches, "literal roots and supplied aliases publish with one retained provenance charge")
  let exhausted = run Effect.result(StaticExecution.evaluate(&mut rootMachine, &literalRoot, Vector.asSlice<StaticExecution.Binding>(&noBindings), literalId))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(staticExecutionFailedWith(&exhausted, StaticExecutionFault.ValueLimit), "releasing an origin-held supplied alias preserves the live charge for later roots")
  return ()
}

test effect fn staticCallCacheIncludesCheckedGenericApplication() -> ()
! InvalidModulePath | OutOfMemoryError | StaticDiagnostic | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("static-generic-key.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = "static fn phantom<T>(value: u32) -> u32 { return value }\n"
  let bytes = run Bytes.copy(String.utf8Bytes(source))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unit = run SourceUnit.parse(&id, usize.ONE, move bytes) |> Effect.provideMut<Allocator>(&mut allocator)
  let index = run ModuleIndex.build(&unit) |> Effect.provideMut<Allocator>(&mut allocator)
  let declarations = ModuleIndex.listDeclarations(&index)
  let header = run StaticFunction.select(&unit, &index, &declarations[usize.ZERO].identity)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let selected = match move header {
    Result<SelectedStaticFunction, StaticHeaderRejection>.Success {value} => value
    Result<SelectedStaticFunction, StaticHeaderRejection>.Failure {error: _} => {
      run Testing.expect(false, "generic static function has a selectable header")
      return ()
    }
  }
  let integer = run specializationPrimitive(b"u32") |> Effect.provideMut<Allocator>(&mut allocator)
  let boolean = run specializationPrimitive(b"bool") |> Effect.provideMut<Allocator>(&mut allocator)
  let firstApplication = run specializationOf(&selected.declaration, &integer)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let otherApplication = run specializationOf(&selected.declaration, &boolean)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = run staticSemantic(&id, source, MachineTarget.forId(TargetId.Aarch64AppleDarwin))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut staticDependencies = Vector.make<Dependency>()
  let mut machine = run StaticExecution.make(Semantic.staticPort(&mut semantic, &mut staticDependencies), &id, StaticExecution.Limits {steps: 20, depth: 4, valueBytes: 32})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let input = run Shared.make<StaticData>(StaticData.Integer {ty: StaticIntegerType.U32, sign: StaticSign.Positive, magnitude: 1})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let args = [move input]
  let span = Span.make(usize.ZERO, usize.ZERO)
  let first = run StaticExecution.demandApplication(&mut machine, &firstApplication, b"phantom", &args, span)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let repeated = run StaticExecution.demandApplication(&mut machine, &firstApplication, b"phantom", &args, span)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared.with<StaticData, bool>(&first, fn(value: &StaticData) -> bool {
    return staticSharedIntegerIs(value, 1)
  }) && Shared.with<StaticData, bool>(&repeated, fn(value: &StaticData) -> bool {
    return staticSharedIntegerIs(value, 1)
  }), "equal checked applications reuse one static result")
  let other = run Effect.result(StaticExecution.demandApplication(&mut machine, &otherApplication, b"phantom", &args, span))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(staticExecutionFailedWith(&other, StaticExecutionFault.ValueLimit), "different generic arguments have separate cache entries")
  let operation = run DeclarationId.copy(&selected.declaration) |> Effect.provideMut<Allocator>(&mut allocator)
  let implementation = run DeclarationId.copy(&selected.declaration) |> Effect.provideMut<Allocator>(&mut allocator)
  let selectedOperation = SpecializationApplication {
    target: SpecializationTarget.Operation {
      contract: Shared.clone<Type>(&integer),
      provider: Shared.clone<Type>(&boolean),
      operation: move operation,
      implementation: move implementation,
    },
    argumentOrdinals: Vector.make<usize>(),
    scopes: Vector.make<ScopeBinding>(),
    arguments: Vector.make<Argument>(),
    statics: Vector.make<StaticSlot>(),
  }
  let operationSpan = Span.make(usize.ONE, usize.ONE + usize.ONE)
  let rejectedOperation = run Effect.result(StaticExecution.demandApplication(&mut machine, &selectedOperation, b"phantom", &args, operationSpan))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    staticExecutionCallFault(&rejectedOperation, StaticExecutionFault.StaticPhaseViolation, b"SEM0176", usize.ONE, usize.ONE),
    "interface operations cannot be called during static evaluation",
  )
  return ()
}

test effect fn staticUnsuffixedPointerLiteralsUseSelectedTarget() -> ()
! InvalidModulePath | OutOfMemoryError | StaticDiagnostic | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("static-pointer-literals.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """static fn wideUnsigned() -> usize { return 4294967296 }
static fn wideSigned() -> isize { return 2147483648 }
static fn echo(value: usize) -> usize { return value }
static fn callEcho() -> usize { return echo(4294967296) }
static fn sumWord() -> usize { return 1 + 2 }
static fn callSum() -> usize { return echo(1 + 2) }
static fn nested() -> usize { return (1 + 2) + (3 + 4) }
"""
  let mut nativeSemantic = run staticSemantic(&id, source, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut wasmSemantic = run staticSemantic(&id, source, MachineTarget.forId(TargetId.Wasm32UnknownUnknown))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut nativeDependencies = Vector.make<Dependency>()
  let mut wasmDependencies = Vector.make<Dependency>()
  let mut native = run StaticExecution.make(Semantic.staticPort(&mut nativeSemantic, &mut nativeDependencies), &id, StaticExecution.Limits {steps: 64, depth: 3, valueBytes: 256})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut wasm = run StaticExecution.make(Semantic.staticPort(&mut wasmSemantic, &mut wasmDependencies), &id, StaticExecution.Limits {steps: 64, depth: 3, valueBytes: 256})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let args = Vector.make<Shared<StaticData>>()
  let span = Span.make(usize.ZERO, usize.ZERO)
  let unsigned = run StaticExecution.demand(&mut native, b"wideUnsigned", Vector.asSlice<Shared<StaticData>>(&args), span)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let signed = run StaticExecution.demand(&mut native, b"wideSigned", Vector.asSlice<Shared<StaticData>>(&args), span)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let forwarded = run StaticExecution.demand(&mut native, b"callEcho", Vector.asSlice<Shared<StaticData>>(&args), span)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let summed = run StaticExecution.demand(&mut native, b"sumWord", Vector.asSlice<Shared<StaticData>>(&args), span)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let forwardedSum = run StaticExecution.demand(&mut native, b"callSum", Vector.asSlice<Shared<StaticData>>(&args), span)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared.with<StaticData, bool>(&unsigned, fn(value: &StaticData) -> bool {
    return match & value.* {
      StaticData.Integer {ty, magnitude, ..} => ty == StaticIntegerType.Usize && magnitude == 4294967296
      _ => false
    }
  }) && Shared.with<StaticData, bool>(&signed, fn(value: &StaticData) -> bool {
    return match & value.* {
      StaticData.Integer {ty, magnitude, ..} => ty == StaticIntegerType.Isize && magnitude == 2147483648
      _ => false
    }
  }) && Shared.with<StaticData, bool>(&forwarded, fn(value: &StaticData) -> bool {
    return match & value.* {
      StaticData.Integer {ty, magnitude, ..} => ty == StaticIntegerType.Usize && magnitude == 4294967296
      _ => false
    }
  }), "unsuffixed return and call-argument literals use the declared pointer-sized type on a 64-bit target")
  run Testing.expect(Shared.with<StaticData, bool>(&summed, fn(value: &StaticData) -> bool {
    return match & value.* {
      StaticData.Integer {ty, magnitude, ..} => ty == StaticIntegerType.Usize && magnitude == 3
      _ => false
    }
  }) && Shared.with<StaticData, bool>(&forwardedSum, fn(value: &StaticData) -> bool {
    return match & value.* {
      StaticData.Integer {ty, magnitude, ..} => ty == StaticIntegerType.Usize && magnitude == 3
      _ => false
    }
  }), "arithmetic operands inherit the return or parameter integer type")
  let unsigned32 = run Effect.result(StaticExecution.demand(&mut wasm, b"wideUnsigned", Vector.asSlice<Shared<StaticData>>(&args), span))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let signed32 = run Effect.result(StaticExecution.demand(&mut wasm, b"wideSigned", Vector.asSlice<Shared<StaticData>>(&args), span))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let forwarded32 = run Effect.result(StaticExecution.demand(&mut wasm, b"callEcho", Vector.asSlice<Shared<StaticData>>(&args), span))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    staticExecutionBodyRejection(&unsigned32, RejectionCode.IntegerOutOfRange, offsetOf(source, "4294967296", usize.ZERO)) &&
    staticExecutionBodyRejection(&signed32, RejectionCode.IntegerOutOfRange, offsetOf(source, "2147483648", usize.ZERO)) &&
    staticExecutionBodyRejection(&forwarded32, RejectionCode.IntegerOutOfRange, offsetOf(source, "4294967296", 1)),
    "the checked bodies reject values outside the wasm32 pointer-sized ranges",
  )
  let sum32 = run StaticExecution.demand(&mut wasm, b"sumWord", Vector.asSlice<Shared<StaticData>>(&args), span)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let forwardedSum32 = run StaticExecution.demand(&mut wasm, b"callSum", Vector.asSlice<Shared<StaticData>>(&args), span)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared.with<StaticData, bool>(&sum32, fn(value: &StaticData) -> bool {
    return match & value.* {
      StaticData.Integer {ty, magnitude, ..} => ty == StaticIntegerType.Usize && magnitude == 3
      _ => false
    }
  }) && Shared.with<StaticData, bool>(&forwardedSum32, fn(value: &StaticData) -> bool {
    return match & value.* {
      StaticData.Integer {ty, magnitude, ..} => ty == StaticIntegerType.Usize && magnitude == 3
      _ => false
    }
  }), "arithmetic uses usize on wasm32 as well as native64")
  let nested32 = run StaticExecution.demand(&mut wasm, b"nested", Vector.asSlice<Shared<StaticData>>(&args), span)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared.with<StaticData, bool>(&nested32, fn(value: &StaticData) -> bool {
    return match & value.* {
      StaticData.Integer {ty, magnitude, ..} => ty == StaticIntegerType.Usize && magnitude == 10
      _ => false
    }
  }), "nested arithmetic operands inherit the pointer-sized return type on wasm32")
  return ()
}

test effect fn staticFunctionHeaderIsDemandedWithoutRunningItsBody() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("static-header.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = "static fn valid(value: u32) -> u32 { return value }\nfn runtime() -> u32 { return 1 }\nstatic fn broken() -> u32 { return missing }\n"
  let bytes = run Bytes.copy(String.utf8Bytes(source)) |> Effect.provideMut<Allocator>(&mut allocator)
  let unit = run SourceUnit.parse(&id, usize.ONE, move bytes)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let index = run ModuleIndex.build(&unit) |> Effect.provideMut<Allocator>(&mut allocator)
  let declarations = ModuleIndex.listDeclarations(&index)
  let valid = run StaticFunction.select(&unit, &index, &declarations[usize.ZERO].identity)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let selectedHeader = match move valid {
    Result<SelectedStaticFunction, StaticHeaderRejection>.Success {value} => Vector.length<HirId>(&value.parameters) == usize.ONE
    _ => false
  }
  run Testing.expect(selectedHeader, "static header selects its body and parameter binder")
  let broken = run StaticFunction.select(&unit, &index, &declarations[2].identity)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let selectedBroken = match move broken {
    Result<SelectedStaticFunction, StaticHeaderRejection>.Success {value: _} => true
    _ => false
  }
  run Testing.expect(selectedBroken, "uncalled body is not evaluated")
  let runtime = run StaticFunction.select(&unit, &index, &declarations[usize.ONE].identity)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let rejectedRuntime = match move runtime {
    Result<SelectedStaticFunction, StaticHeaderRejection>.Failure {error} => error.fault == StaticHeaderFault.RuntimeFunction
    _ => false
  }
  run Testing.expect(rejectedRuntime, "runtime function is not a static call target")
  return ()
}

test effect fn staticCallRejectsCheckedBodyFailure() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let id = run module("static-checked-body.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let source = """static fn invalid() -> u32 {
  let value: bool = 7
  return value
}
static fn caller() -> u32 { return invalid() }
"""
  let mut semantic = run staticSemantic(&id, source, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut dependencies = Vector.make<Dependency>()
  let mut machine = run StaticExecution.make(Semantic.staticPort(&mut semantic, &mut dependencies), &id, StaticExecution.Limits {steps: 32, depth: 4, valueBytes: 64})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let arguments = Vector.make<Shared<StaticData>>()
  let span = Span.make(usize.ZERO, usize.ZERO)
  let attempted = run Effect.result(StaticExecution.demand(&mut machine, b"caller", Vector.asSlice<Shared<StaticData>>(&arguments), span))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    staticExecutionBodyRejection(&attempted, RejectionCode.TypeMismatch, offsetOf(source, "7", usize.ZERO)),
    "a rejected checked body never executes from raw HIR",
  )
  return ()
}

fn staticFaultIs(answer: &Result<StaticData, StaticFault>, expected: StaticFault) -> bool {
  return match &answer.* {
    Result<StaticData, StaticFault>.Failure {error} => error == expected
    _ => false
  }
}

fn staticBooleanIs(answer: &Result<StaticData, StaticFault>, expected: bool) -> bool {
  return match &answer.* {
    Result<StaticData, StaticFault>.Success {value: StaticData.Boolean {value}} => value == expected
    _ => false
  }
}

fn staticFloatBitsAre(answer: &Result<StaticData, StaticFault>, expected: u64) -> bool {
  return match &answer.* {
    Result<StaticData, StaticFault>.Success {value: StaticData.Float {bits, ..}} => bits == expected
    _ => false
  }
}

fn staticIsText(answer: &Option<StaticData>) -> bool {
  return match &answer.* {
    Option<StaticData>.Some {value: StaticData.Text {..}} => true
    _ => false
  }
}

fn staticIsNone(answer: &Option<StaticData>) -> bool {
  return match &answer.* {
    Option<StaticData>.None => true
    _ => false
  }
}

fn staticOptionIntegerIs(answer: &Option<StaticData>, ty: StaticIntegerType, magnitude: u64) -> bool {
  return match &answer.* {
    Option<StaticData>.Some {value: StaticData.Integer {ty: found, sign, magnitude: amount}} => found == ty && sign == StaticSign.Positive && amount == magnitude
    _ => false
  }
}

fn staticOptionFloatBitsAre(answer: &Option<StaticData>, ty: StaticFloatType, bits: u64) -> bool {
  return match &answer.* {
    Option<StaticData>.Some {value: StaticData.Float {ty: found, bits: payload}} => found == ty && payload == bits
    _ => false
  }
}

fn staticIsUnit(value: &StaticData) -> bool {
  return match &value.* {
    StaticData.Unit => true
    _ => false
  }
}

fn staticHasUnitField(answer: &Option<StaticData>) -> bool {
  return match &answer.* {
    Option<StaticData>.Some {value} => match move StaticValue.field(&value, usize.ZERO) {
      Option<Shared<StaticData>>.Some {value: field} => Shared.with<StaticData, bool>(&field, staticIsUnit)
      Option<Shared<StaticData>>.None => false
    }
    Option<StaticData>.None => false
  }
}

fn enumMemberIs(answer: &Result<Answer, NoRejection>, ordinal: usize, sign: StaticSign, magnitude: u64) -> bool {
  return match &answer.* {
    Result<Answer, NoRejection>.Success {value} => match &value.outcome {
      Outcome.Success {value: Value.Members {members, ..}} => {
        let entries = Vector.asSlice<Member>(&members)
        if ordinal >= entries.length {
          return false
        }
        return match &entries[ordinal].discriminant {
          Option<EnumCase>.Some {value: selected} => selected.sign == sign && selected.magnitude == magnitude
          Option<EnumCase>.None => false
        }
      }
      _ => false
    }
    _ => false
  }
}

test effect fn staticIntegerArithmeticUsesExactBoundsAndTraps() -> () ! AssertionError<'static> {
  let max = StaticData.Integer {ty: StaticIntegerType.U8, sign: StaticSign.Positive, magnitude: 255}
  let one = StaticData.Integer {ty: StaticIntegerType.U8, sign: StaticSign.Positive, magnitude: 1}
  let zero = StaticData.Integer {ty: StaticIntegerType.U8, sign: StaticSign.Positive, magnitude: 0}
  let overflow = StaticValue.infix(InfixOperator.Add, &max, &one, 64)
  let zeroDivision = StaticValue.infix(InfixOperator.Divide, &one, &zero, 64)
  run Testing.expect(staticFaultIs(&overflow, StaticFault.Overflow), "static u8 addition must reject overflow")
  run Testing.expect(staticFaultIs(&zeroDivision, StaticFault.DivisionByZero), "static division must reject zero")
  let minusSeven = StaticData.Integer {ty: StaticIntegerType.I8, sign: StaticSign.Negative, magnitude: 7}
  let two = StaticData.Integer {ty: StaticIntegerType.I8, sign: StaticSign.Positive, magnitude: 2}
  let quotient = StaticValue.infix(InfixOperator.Divide, &minusSeven, &two, 64)
  let remainder = StaticValue.infix(InfixOperator.Remainder, &minusSeven, &two, 64)
  run Testing.expect(staticIntegerIs(&quotient, StaticSign.Negative, 3), "signed static division truncates toward zero")
  run Testing.expect(staticIntegerIs(&remainder, StaticSign.Negative, 1), "signed static remainder takes the dividend sign")
  let minimum = StaticData.Integer {ty: StaticIntegerType.I8, sign: StaticSign.Negative, magnitude: 128}
  let minusOne = StaticData.Integer {ty: StaticIntegerType.I8, sign: StaticSign.Negative, magnitude: 1}
  let invalidRemainder = StaticValue.infix(InfixOperator.Remainder, &minimum, &minusOne, 64)
  run Testing.expect(staticFaultIs(&invalidRemainder, StaticFault.Overflow), "MIN remainder -1 traps")
  let wasm = MachineTarget.forId(TargetId.Wasm32UnknownUnknown)
  let native = MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)
  let rejected32 = StaticValue.integer(StaticIntegerType.Usize, StaticSign.Positive, 4294967296, wasm.pointerBits())
  let accepted64 = StaticValue.integer(StaticIntegerType.Usize, StaticSign.Positive, 4294967296, native.pointerBits())
  run Testing.expect(staticIsNone(&rejected32), "usize rejects values outside the frozen 32-bit target")
  run Testing.expect(staticOptionIntegerIs(&accepted64, StaticIntegerType.Usize, 4294967296), "usize accepts the same value on a frozen 64-bit target")
  let rejectedSigned32 = StaticValue.integer(StaticIntegerType.Isize, StaticSign.Positive, 2147483648, wasm.pointerBits())
  let acceptedSigned64 = StaticValue.integer(StaticIntegerType.Isize, StaticSign.Positive, 2147483648, native.pointerBits())
  let minimumSigned32 = StaticValue.integer(StaticIntegerType.Isize, StaticSign.Negative, 2147483648, wasm.pointerBits())
  run Testing.expect(staticIsNone(&rejectedSigned32), "isize rejects positive values above the frozen 32-bit maximum")
  run Testing.expect(staticOptionIntegerIs(&acceptedSigned64, StaticIntegerType.Isize, 2147483648), "isize accepts the same positive value on a frozen 64-bit target")
  run Testing.expect(!staticIsNone(&minimumSigned32), "isize admits the negative 32-bit minimum")
  return ()
}

test effect fn staticValueReuseIsIdentityFree() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let first = run Shared.make<StaticData>(StaticData.Boolean {value: true})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let retained = StaticValue.copy(&first)
  let equivalent = run Shared.make<StaticData>(StaticData.Boolean {value: true})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let different = run Shared.make<StaticData>(StaticData.Boolean {value: false})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let sameRetained = run StaticValue.equals(&first, &retained)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let sameSeparate = run StaticValue.equals(&first, &equivalent)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let differs = run StaticValue.equals(&first, &different)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(sameRetained && sameSeparate && !differs, "static reuse compares values, not allocation handles")
  let seven = run Shared.make<StaticData>(StaticData.Integer {ty: StaticIntegerType.I8, sign: StaticSign.Positive, magnitude: 7})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let alias = StaticValue.copy(&seven)
  let five = run Shared.make<StaticData>(StaticData.Integer {ty: StaticIntegerType.I8, sign: StaticSign.Positive, magnitude: 5})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let selfSum = StaticValue.infixShared(InfixOperator.Add, &seven, &alias, 64)
  let distinctSum = StaticValue.infixShared(InfixOperator.Add, &seven, &five, 64)
  let negated = StaticValue.prefixShared(PrefixOperator.Negate, &seven, 64)
  run Testing.expect(staticIntegerIs(&selfSum, StaticSign.Positive, 14), "an aliased value can be used on both sides of an operator")
  run Testing.expect(staticIntegerIs(&distinctSum, StaticSign.Positive, 12), "distinct shared values can be combined")
  run Testing.expect(staticIntegerIs(&negated, StaticSign.Negative, 7), "prefix operators accept a shared value")
  return ()
}

// Runtime identity bytes agree with semantic equality wherever no lifetime is erased.
effect fn expectStaticIdentity(left: StaticData, right: StaticData, owner: &DeclarationId, same: bool) -> ()
! OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let first = run Shared.make<StaticData>(move left)
  let second = run Shared.make<StaticData>(move right)
  let runtime = run StaticValue.runtimeEquals(&first, &second, owner)
  let semantic = run StaticValue.equals(&first, &second)
  run Testing.expect(runtime == same && semantic == same, "static runtime identity matches the expected distinction and semantic equality")
  return ()
}

// A lifetime-only difference is semantic identity but erases from runtime identity.
effect fn expectLifetimeOnlyIdentity(left: StaticData, right: StaticData, owner: &DeclarationId) -> ()
! OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let first = run Shared.make<StaticData>(move left)
  let second = run Shared.make<StaticData>(move right)
  let runtime = run StaticValue.runtimeEquals(&first, &second, owner)
  let semantic = run StaticValue.equals(&first, &second)
  run Testing.expect(runtime && !semantic, "values differing only by a lifetime are semantically distinct and runtime equal")
  return ()
}

effect fn staticNestedArray(outer: &Shared<Type>, inner: &Shared<Type>, last: u64) -> StaticData ! OutOfMemoryError ? &mut Allocator {
  let mut rows = Vector.make<Shared<StaticData>>()
  run Vector.append<Shared<StaticData>>(&mut rows, run Shared.make<StaticData>(run staticArray(inner, 1, 2)))
  run Vector.append<Shared<StaticData>>(&mut rows, run Shared.make<StaticData>(run staticArray(inner, 1, last)))
  let built = StaticValue.aggregate(Shared.clone<Type>(outer), Option.none<usize>(), move rows)
  return match move built {
    Option<StaticData>.Some {value} => move value
    Option<StaticData>.None => StaticData.Unit
  }
}

effect fn staticU8(magnitude: u64) -> Shared<StaticData> ! OutOfMemoryError ? &mut Allocator {
  return run Shared.make<StaticData>(StaticData.Integer {ty: StaticIntegerType.U8, sign: StaticSign.Positive, magnitude: magnitude})
}

effect fn staticPairFields(first: u64, second: u64) -> Vector<Shared<StaticData>> ! OutOfMemoryError ? &mut Allocator {
  let mut fields = Vector.make<Shared<StaticData>>()
  run Vector.append<Shared<StaticData>>(&mut fields, run staticU8(first))
  run Vector.append<Shared<StaticData>>(&mut fields, run staticU8(second))
  return move fields
}

effect fn staticArray(ty: &Shared<Type>, first: u64, second: u64) -> StaticData ! OutOfMemoryError ? &mut Allocator {
  let built = StaticValue.aggregate(Shared.clone<Type>(ty), Option.none<usize>(), run staticPairFields(first, second))
  return match move built {
    Option<StaticData>.Some {value} => move value
    Option<StaticData>.None => StaticData.Unit
  }
}

effect fn staticRecord(ty: &Shared<Type>, first: u64, second: u64) -> StaticData ! OutOfMemoryError ? &mut Allocator {
  return StaticValue.record(Shared.clone<Type>(ty), run staticPairFields(first, second))
}

effect fn staticVariant(ty: &Shared<Type>, ordinal: usize, payload: u64) -> StaticData ! OutOfMemoryError ? &mut Allocator {
  let mut fields = Vector.make<Shared<StaticData>>()
  run Vector.append<Shared<StaticData>>(&mut fields, run staticU8(payload))
  return StaticValue.unionVariant(Shared.clone<Type>(ty), ordinal, move fields)
}

effect fn staticEnum(declaration: &DeclarationId, member: usize) -> StaticData ! OutOfMemoryError ? &mut Allocator {
  return StaticData.Enum {
    declaration: run Shared.make<DeclarationId>(run DeclarationId.copy(declaration)),
    member: member, representation: StaticIntegerType.U8, sign: StaticSign.Positive, magnitude: 0,
  }
}

effect fn staticTextValue(spelling: &[u8]) -> StaticData ! OutOfMemoryError ? &mut Allocator {
  let decoded = StaticValue.text(run Bytes.copy(spelling))
  return match move decoded {
    Option<StaticData>.Some {value} => move value
    Option<StaticData>.None => StaticData.Unit
  }
}

test effect fn staticValueRuntimeIdentityCoversEveryKind() -> ()
! InvalidModulePath | Cycle | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run staticValueRuntimeIdentityClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn staticValueRuntimeIdentityClaims() -> ()
! InvalidModulePath | Cycle | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let id = run module("static-identity.silk")
  let source = run present("enum Alpha { First, Second }\nenum Beta { First }\nstruct Pair { left: u8, right: u8 }\nunion Choice { A { value: u8 }, B { value: u8 } }\n")
  let revision = run Revision.publish(&Revision.make(), &id, &source)
  let mut index = SourceIndex.make(run Revision.copy(&revision))
  let alpha = run requireIndexedIdentity(&mut index, &id, OwnerKind.Enumeration, b"Alpha", usize.ZERO)
  let beta = run requireIndexedIdentity(&mut index, &id, OwnerKind.Enumeration, b"Beta", usize.ZERO)
  let pair = run requireIndexedIdentity(&mut index, &id, OwnerKind.Struct, b"Pair", usize.ZERO)
  let byte = run Shared.make<Type>(Type.Primitive {name: run Bytes.copy(b"u8")})
  let arrayType = run Shared.make<Type>(Type.Array {element: Shared.clone<Type>(&byte), extent: run Bytes.copy(b"2")})
  let pairType = run Shared.make<Type>(Type.Nominal {declaration: run DeclarationId.copy(&pair), isPublic: false, arguments: Vector.make<Argument>()})
  let choice = run requireIndexedIdentity(&mut index, &id, OwnerKind.Union, b"Choice", usize.ZERO)
  let choiceType = run Shared.make<Type>(Type.Nominal {declaration: move choice, isPublic: false, arguments: Vector.make<Argument>()})
  run expectStaticIdentity(StaticData.Unit, StaticData.Unit, &pair, true)
  run expectStaticIdentity(StaticData.Unit, StaticData.Boolean {value: false}, &pair, false)
  run expectStaticIdentity(StaticData.Boolean {value: true}, StaticData.Boolean {value: false}, &pair, false)
  run expectStaticIdentity(StaticData.Character {scalar: 0x1f600}, StaticData.Character {scalar: 0x1f600}, &pair, true)
  run expectStaticIdentity(StaticData.Character {scalar: 97}, StaticData.Character {scalar: 98}, &pair, false)
  run expectStaticIdentity(
    StaticData.Integer {ty: StaticIntegerType.I8, sign: StaticSign.Positive, magnitude: 5},
    StaticData.Integer {ty: StaticIntegerType.I8, sign: StaticSign.Positive, magnitude: 5}, &pair, true)
  run expectStaticIdentity(
    StaticData.Integer {ty: StaticIntegerType.U8, sign: StaticSign.Positive, magnitude: 5},
    StaticData.Integer {ty: StaticIntegerType.I8, sign: StaticSign.Positive, magnitude: 5}, &pair, false)
  run expectStaticIdentity(
    StaticData.Integer {ty: StaticIntegerType.I8, sign: StaticSign.Negative, magnitude: 5},
    StaticData.Integer {ty: StaticIntegerType.I8, sign: StaticSign.Positive, magnitude: 5}, &pair, false)
  run expectStaticIdentity(
    StaticData.Float {ty: StaticFloatType.F32, bits: 0}, StaticData.Float {ty: StaticFloatType.F32, bits: 0x80000000}, &pair, false)
  run expectStaticIdentity(
    StaticData.Float {ty: StaticFloatType.F32, bits: 0x7fc00000}, StaticData.Float {ty: StaticFloatType.F32, bits: 0x7fc12345}, &pair, false)
  run expectStaticIdentity(
    StaticData.Float {ty: StaticFloatType.F32, bits: 0x3f800000}, StaticData.Float {ty: StaticFloatType.F64, bits: 0x3f800000}, &pair, false)
  run expectStaticIdentity(
    StaticData.Float {ty: StaticFloatType.F64, bits: 0x7ff8000000001234}, StaticData.Float {ty: StaticFloatType.F64, bits: 0x7ff8000000001234}, &pair, true)
  run expectStaticIdentity(run staticEnum(&alpha, 0), run staticEnum(&alpha, 0), &pair, true)
  run expectStaticIdentity(run staticEnum(&alpha, 0), run staticEnum(&beta, 0), &pair, false)
  run expectStaticIdentity(run staticEnum(&alpha, 0), run staticEnum(&alpha, 1), &pair, false)
  run expectStaticIdentity(run staticTextValue(b"ab"), run staticTextValue(b"ab"), &pair, true)
  run expectStaticIdentity(run staticTextValue(b"ab"), run staticTextValue(b"ba"), &pair, false)
  run expectStaticIdentity(run staticTextValue(b"a"), run staticTextValue(b"ab"), &pair, false)
  run expectStaticIdentity(run staticArray(&arrayType, 1, 2), run staticArray(&arrayType, 1, 2), &pair, true)
  run expectStaticIdentity(run staticArray(&arrayType, 1, 2), run staticArray(&arrayType, 2, 1), &pair, false)
  run expectStaticIdentity(run staticArray(&arrayType, 1, 2), run staticRecord(&pairType, 1, 2), &pair, false)
  run expectStaticIdentity(run staticRecord(&pairType, 1, 2), run staticRecord(&pairType, 1, 2), &pair, true)
  run expectStaticIdentity(run staticVariant(&choiceType, 0, 1), run staticVariant(&choiceType, 1, 1), &pair, false)
  let nestedType = run Shared.make<Type>(Type.Array {element: Shared.clone<Type>(&arrayType), extent: run Bytes.copy(b"2")})
  run expectStaticIdentity(run staticNestedArray(&nestedType, &arrayType, 2), run staticNestedArray(&nestedType, &arrayType, 2), &pair, true)
  run expectStaticIdentity(run staticNestedArray(&nestedType, &arrayType, 2), run staticNestedArray(&nestedType, &arrayType, 3), &pair, false)
  let mut staticRegion = Vector.make<Argument>()
  run Vector.append<Argument>(&mut staticRegion, Argument.Lifetime {value: run Shared.make<Lifetime>(Lifetime.Static)})
  let mut ownRegion = Vector.make<Argument>()
  run Vector.append<Argument>(&mut ownRegion, Argument.Lifetime {value: run Shared.make<Lifetime>(Lifetime.Parameter {
    declaration: run DeclarationId.copy(&pair), ordinal: usize.ZERO,
  })})
  let staticHolder = run Shared.make<Type>(Type.Nominal {declaration: run DeclarationId.copy(&pair), isPublic: false, arguments: move staticRegion})
  let ownHolder = run Shared.make<Type>(Type.Nominal {declaration: run DeclarationId.copy(&pair), isPublic: false, arguments: move ownRegion})
  run expectLifetimeOnlyIdentity(run staticRecord(&staticHolder, 1, 2), run staticRecord(&ownHolder, 1, 2), &pair)
  return ()
}

test effect fn staticFloatIdentityKeepsSignedZeroAndUnorderedNaN() -> () ! AssertionError<'static> {
  let plusZero = StaticData.Float {ty: StaticFloatType.F32, bits: 0}
  let minusZero = StaticData.Float {ty: StaticFloatType.F32, bits: 0x80000000}
  let equal = StaticValue.infix(InfixOperator.Equals, &plusZero, &minusZero, 64)
  run Testing.expect(staticBooleanIs(&equal, true), "signed zeros compare equal")
  let nan = StaticData.Float {ty: StaticFloatType.F32, bits: 0x7fc00000}
  let payload32 = StaticValue.floating(StaticFloatType.F32, 0x7fc12345)
  let payload64 = StaticValue.floating(StaticFloatType.F64, 0x7ff8000000001234)
  run Testing.expect(staticOptionFloatBitsAre(&payload32, StaticFloatType.F32, 0x7fc12345), "f32 NaN payload survives static bit admission")
  run Testing.expect(staticOptionFloatBitsAre(&payload64, StaticFloatType.F64, 0x7ff8000000001234), "f64 NaN payload survives static bit admission")
  let unordered = StaticValue.infix(InfixOperator.LessThan, &nan, &plusZero, 64)
  let unequal = StaticValue.infix(InfixOperator.NotEquals, &nan, &nan, 64)
  run Testing.expect(staticBooleanIs(&unordered, false), "NaN is unordered")
  run Testing.expect(staticBooleanIs(&unequal, true), "NaN differs from itself")
  let negated = StaticValue.prefix(PrefixOperator.Negate, &plusZero, 64)
  run Testing.expect(staticFloatBitsAre(&negated, 0x80000000), "negating zero preserves its sign bit")
  return ()
}

test effect fn scalarEnumDemandChecksDiscriminantSequence() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("enum-values.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "struct Empty {}\nstruct Resource {}\nimpl Drop for Resource {}\nenum(i8) Exit { Start, Rewind = -2, Next }\nenum(u8) Separated { Ten = 1_0 }\nenum(u8) Named { Same, Same }\nenum(u8) Duplicate { First = 1, Second = 1 }\nenum(u8) Range { Bad = 256 }\nenum(u8) Overflow { Max = 255, Next }\nenum(u8) Negative { Bad = -1 }\n"
  let source = run present(text) |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let emptyIdentity = run Semantic.demandIdentity(&mut semantic, &mut request, &entry, b"Empty")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let emptyType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&emptyIdentity, nominalResult)
  let mut pureNominalUnsupported = false
  if let Option<Shared<Type>>.Some {value: ty} = move emptyType {
    let unsupported = StaticValue.aggregate(Shared.clone<Type>(&ty), Option.none<usize>(), Vector.make<Shared<StaticData>>())
    let record = StaticValue.record(Shared.clone<Type>(&ty), Vector.make<Shared<StaticData>>())
    let tupleValue = StaticValue.tupleValue(Shared.clone<Type>(&ty), Vector.make<Shared<StaticData>>())
    let variant = StaticValue.unionVariant(Shared.clone<Type>(&ty), usize.ZERO, Vector.make<Shared<StaticData>>())
    let optional = StaticValue.optionalVariant(move ty, usize.ZERO, Vector.make<Shared<StaticData>>())
    pureNominalUnsupported = staticIsNone(&unsupported) && !StaticValue.pure(&record) && !StaticValue.pure(&tupleValue) && !StaticValue.pure(&variant) && !StaticValue.pure(&optional)
  }
  let resourceIdentity = run Semantic.demandIdentity(&mut semantic, &mut request, &entry, b"Resource")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let resourceType = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(&resourceIdentity, nominalResult)
  let implementations = run Semantic.demandImplementations(&mut semantic, &mut request, &entry)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let hasDropHead = Shared.with<Result<Answer, NoRejection>, usize>(&implementations, headCount) == usize.ONE
  let mut cleanupNominalRejected = false
  if let Option<Shared<Type>>.Some {value: ty} = move resourceType {
    let unsupported = StaticValue.aggregate(move ty, Option.none<usize>(), Vector.make<Shared<StaticData>>())
    cleanupNominalRejected = staticIsNone(&unsupported)
  }
  run Testing.expect(pureNominalUnsupported && hasDropHead && cleanupNominalRejected, "source-backed cleanup nominal and unproven pure nominal are Unsupported until M2.5")
  let valid = run Semantic.demandMembers(&mut semantic, &mut request, &entry, b"Exit")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&valid, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return enumMemberIs(answer, 0, StaticSign.Positive, 0) && enumMemberIs(answer, 1, StaticSign.Negative, 2) && enumMemberIs(answer, 2, StaticSign.Negative, 1)
  }), "enum members retain exact explicit and implicit discriminants")
  let separated = run Semantic.demandMembers(&mut semantic, &mut request, &entry, b"Separated")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&separated, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return enumMemberIs(answer, 0, StaticSign.Positive, 10)
  }), "decimal enum discriminants accept separators")
  let duplicate = run Semantic.demandMembers(&mut semantic, &mut request, &entry, b"Duplicate")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsRelated(&duplicate, RejectionCode.DuplicateEnumDiscriminant, offsetOf(text, "Second = 1", usize.ZERO) + 9, offsetOf(text, "First = 1", usize.ZERO) + 8), "duplicate enum values relate both discriminants")
  let duplicateName = run Semantic.demandMembers(&mut semantic, &mut request, &entry, b"Named")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsRelated(&duplicateName, RejectionCode.DuplicateEnumMember, offsetOf(text, "Same", 1), offsetOf(text, "Same", usize.ZERO)), "duplicate enum names relate both name tokens")
  let outOfRange = run Semantic.demandMembers(&mut semantic, &mut request, &entry, b"Range")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsFrom(&outOfRange, RejectionCode.EnumDiscriminantOutOfRange, offsetOf(text, "256", usize.ZERO)), "explicit enum values stay in representation range")
  let overflow = run Semantic.demandMembers(&mut semantic, &mut request, &entry, b"Overflow")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsFrom(&overflow, RejectionCode.EnumImplicitOverflow, offsetOf(text, "Next", 1)), "implicit enum successor cannot overflow")
  let negative = run Semantic.demandMembers(&mut semantic, &mut request, &entry, b"Negative")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsFrom(&negative, RejectionCode.UnsignedEnumNegative, offsetOf(text, "-1", usize.ZERO)), "unsigned enum rejects a negative discriminant")
  return ()
}

test effect fn staticValueMatchesResolvedType() -> () ! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let boolName = run Bytes.copy(b"bool") |> Effect.provideMut<Allocator>(&mut allocator)
  let boolType = run Shared.make<Type>(Type.Primitive {name: move boolName})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let staticLifetime = run Shared.make<Lifetime>(Lifetime.Static)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let stringType = run Shared.make<Type>(Type.String {lifetime: move staticLifetime})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let boolean = run Shared.make<StaticData>(StaticData.Boolean {value: true})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let textBytes = run Bytes.copy(b"hello") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = run Shared.make<StaticData>(StaticData.Text {bytes: move textBytes})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let acceptsBool = run StaticValue.matchesType(&boolean, &boolType)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let rejectsBoolAsString = run StaticValue.matchesType(&boolean, &stringType)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let acceptsString = run StaticValue.matchesType(&text, &stringType)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(acceptsBool && !rejectsBoolAsString && acceptsString,
    "resolved primitive and string types admit only matching static scalars")
  let extent = run Bytes.copy(b"2") |> Effect.provideMut<Allocator>(&mut allocator)
  let arrayType = run Shared.make<Type>(Type.Array {
    element: Shared.clone<Type>(&boolType), extent: move extent,
  }) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut fields = Vector.make<Shared<StaticData>>()
  run Vector.append<Shared<StaticData>>(&mut fields, Shared.clone<StaticData>(&boolean))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run Shared.make<StaticData>(StaticData.Boolean {value: false})
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Vector.append<Shared<StaticData>>(&mut fields, move second)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let acceptedArray = StaticValue.aggregate(Shared.clone<Type>(&arrayType), Option.none<usize>(), move fields)
  let array = match move acceptedArray {
    Option<StaticData>.Some {value} => run Shared.make<StaticData>(move value)
      |> Effect.provideMut<Allocator>(&mut allocator)
    Option<StaticData>.None => { return run Testing.expect(false, "pure fixed array constructs") }
  }
  let acceptsArray = run StaticValue.matchesType(&array, &arrayType)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut wrongFields = Vector.make<Shared<StaticData>>()
  run Vector.append<Shared<StaticData>>(&mut wrongFields, Shared.clone<StaticData>(&boolean))
    |> Effect.provideMut<Allocator>(&mut allocator)
  let wrongElement = run Shared.make<StaticData>(StaticData.Integer {
    ty: StaticIntegerType.U32, sign: StaticSign.Positive, magnitude: 1,
  }) |> Effect.provideMut<Allocator>(&mut allocator)
  run Vector.append<Shared<StaticData>>(&mut wrongFields, move wrongElement)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mismatchedArray = StaticValue.aggregate(Shared.clone<Type>(&arrayType), Option.none<usize>(), move wrongFields)
  let wrongArray = match move mismatchedArray {
    Option<StaticData>.Some {value} => run Shared.make<StaticData>(move value)
      |> Effect.provideMut<Allocator>(&mut allocator)
    Option<StaticData>.None => { return run Testing.expect(false, "wrong child still constructs") }
  }
  let rejectsWrongChild = run StaticValue.matchesType(&wrongArray, &arrayType)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(acceptsArray && !rejectsWrongChild,
    "fixed-array admission compares every child with the canonical element type")
  return ()
}

test effect fn staticTextAndAggregateRejectBorrowedStorage() -> ()
! OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let validBytes = run Bytes.copy(b"ok") |> Effect.provideMut<Allocator>(&mut allocator)
  let valid = StaticValue.text(move validBytes)
  run Testing.expect(staticIsText(&valid), "static text admits valid UTF-8")
  let mut copiedText = false
  if let Option<StaticData>.Some {value} = move valid {
    let shared = run Shared.make<StaticData>(move value) |> Effect.provideMut<Allocator>(&mut allocator)
    let copied = run StaticValue.textBytes(&shared) |> Effect.provideMut<Allocator>(&mut allocator)
    if let Option<Bytes>.Some {value: bytes} = move copied {
      copiedText = sameBytes(Bytes.asSlice(&bytes), b"ok")
    }
  }
  run Testing.expect(copiedText, "shared static text can be copied for a diagnostic")
  let mut invalidBytes = run Bytes.copy(b"ok") |> Effect.provideMut<Allocator>(&mut allocator)
  let mut raw = Bytes.asMutSlice(&mut invalidBytes)
  raw[usize.ZERO] = 255
  let invalid = StaticValue.text(move invalidBytes)
  run Testing.expect(staticIsNone(&invalid), "static text rejects invalid UTF-8")
  let unitType = run Shared.make<Type>(Type.Unit) |> Effect.provideMut<Allocator>(&mut allocator)
  let extent = run Bytes.copy(b"1") |> Effect.provideMut<Allocator>(&mut allocator)
  let arrayType = run Shared.make<Type>(Type.Array {element: Shared.clone<Type>(&unitType), extent: move extent})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let constructionType = Shared.clone<Type>(&arrayType)
  let mut fields = Vector.make<Shared<StaticData>>()
  let mut constructionFields = Vector.make<Shared<StaticData>>()
  let unitValue = run Shared.make<StaticData>(StaticData.Unit)
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Vector.append<Shared<StaticData>>(&mut fields, Shared.clone<StaticData>(&unitValue))
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Vector.append<Shared<StaticData>>(&mut constructionFields, move unitValue)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let aggregate = StaticValue.aggregate(move arrayType, Option.none<usize>(), move fields)
  run Testing.expect(staticHasUnitField(&aggregate), "static aggregate projection returns a reusable value")
  let constructed = StaticValue.fixedArray(move constructionType, move constructionFields)
  let mut constructionOnly = false
  if let Option<StaticData>.Some {value} = move constructed {
    constructionOnly = !StaticValue.pure(&value)
  }
  run Testing.expect(constructionOnly, "a configuration array is construction-only before Shape admission")
  let environment = run Shared.make<Intersection>(Intersection {members: Vector.make<LifetimeMember>()})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let requirements = run Shared.make<Row>(Row.empty())
    |> Effect.provideMut<Allocator>(&mut allocator)
  let deferred = Type.Effect {
    mode: CallableMode.Shared,
    environment: move environment,
    success: Shared.clone<Type>(&unitType),
    failure: Shared.clone<Type>(&unitType),
    requirements: move requirements,
  }
  let forbiddenEffect = StaticValue.intrinsicallyForbidden(&deferred)
  run Testing.expect(forbiddenEffect, "an Effect cannot enter static aggregate storage")
  let deferredType = run Shared.make<Type>(move deferred) |> Effect.provideMut<Allocator>(&mut allocator)
  let emptyExtent = run Bytes.copy(b"0") |> Effect.provideMut<Allocator>(&mut allocator)
  let deferredArray = run Shared.make<Type>(Type.Array {element: move deferredType, extent: move emptyExtent})
    |> Effect.provideMut<Allocator>(&mut allocator)
  let forbiddenAggregate = StaticValue.aggregate(move deferredArray, Option.none<usize>(), Vector.make<Shared<StaticData>>())
  run Testing.expect(staticIsNone(&forbiddenAggregate), "an empty array of Effects is not a static aggregate")
  let lifetime = run Shared.make<Lifetime>(Lifetime.Static) |> Effect.provideMut<Allocator>(&mut allocator)
  let borrowed = Type.Reference {referent: move unitType, access: Access.Shared, lifetime: move lifetime}
  let forbiddenBorrow = StaticValue.intrinsicallyForbidden(&borrowed)
  run Testing.expect(forbiddenBorrow, "a borrow cannot enter static aggregate storage")
  return ()
}

test effect fn selectedTargetChecksPointerSizedLiteralMagnitudes() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("target-literals.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "fn localContext() -> usize { let value: usize = 4294967296 return value }\nfn returnContext() -> usize { return 4294967296 }\nfn signed() -> isize { return 2147483648 }\nfn minimum() -> isize { return -2147483648 }\nfn fixed() -> u64 { return 4294967296 }\nfn maximum() -> usize { return 4294967295 }\n"
  let source = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut wasm = Semantic.make(
    run Revision.copy(&revision) |> Effect.provideMut<Allocator>(&mut allocator),
    MachineTarget.forId(TargetId.Wasm32UnknownUnknown),
    Option.none<FinalProfile>(),
  )
  let mut native = Semantic.make(
    move revision,
    MachineTarget.forId(TargetId.X8664UnknownLinuxGnu),
    Option.none<FinalProfile>(),
  )
  let mut wasmRequest = Request.make()
  let mut nativeRequest = Request.make()
  let wasmLocal = run Semantic.demandBody(&mut wasm, &mut wasmRequest, &entry, b"localContext")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let wasmReturn = run Semantic.demandBody(&mut wasm, &mut wasmRequest, &entry, b"returnContext")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let wasmSigned = run Semantic.demandBody(&mut wasm, &mut wasmRequest, &entry, b"signed")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let wasmMinimum = run Semantic.demandBody(&mut wasm, &mut wasmRequest, &entry, b"minimum")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let wasmFixed = run Semantic.demandBody(&mut wasm, &mut wasmRequest, &entry, b"fixed")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let wasmMaximum = run Semantic.demandBody(&mut wasm, &mut wasmRequest, &entry, b"maximum")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let nativeLocal = run Semantic.demandBody(&mut native, &mut nativeRequest, &entry, b"localContext")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let nativeReturn = run Semantic.demandBody(&mut native, &mut nativeRequest, &entry, b"returnContext")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let nativeSigned = run Semantic.demandBody(&mut native, &mut nativeRequest, &entry, b"signed")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsFrom(&wasmLocal, RejectionCode.IntegerOutOfRange, offsetOf(text, "4294967296", 0)),
    "wasm32 rejects the annotated usize above its maximum at the literal",
  )
  run Testing.expect(
    rejectsFrom(&wasmReturn, RejectionCode.IntegerOutOfRange, offsetOf(text, "4294967296", 1)),
    "wasm32 rejects the return-context usize above its maximum at the literal",
  )
  run Testing.expect(
    rejectsFrom(&wasmSigned, RejectionCode.IntegerOutOfRange, offsetOf(text, "2147483648", 0)),
    "wasm32 rejects the signed isize above its maximum at the literal",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&wasmMaximum, inspect).success &&
      Shared.with<Result<Answer, NoRejection>, AnswerView>(&wasmMinimum, inspect).success &&
      Shared.with<Result<Answer, NoRejection>, AnswerView>(&wasmFixed, inspect).success,
    "wasm32 accepts its usize maximum, its signed minimum and a wide fixed u64",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&nativeLocal, inspect).success &&
      Shared.with<Result<Answer, NoRejection>, AnswerView>(&nativeReturn, inspect).success &&
      Shared.with<Result<Answer, NoRejection>, AnswerView>(&nativeSigned, inspect).success,
    "a 64-bit target accepts the same pointer-sized magnitudes",
  )
  return ()
}

test effect fn closedOperatorsKeepExactOperandsAndRuntimeOrder() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("closed-operators.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "fn add(left: i32, right: i32) -> i32 { return left + right }\nfn literalRight(left: u8) -> u8 { return left + 1 }\nfn literalLeft(right: u8) -> u8 { return 1 + right }\nfn equal(left: bool, right: bool) -> bool { return left == right }\nfn bitwise(left: u16, right: u16) -> u16 { return left ^ right }\nfn pointerSized(left: usize, right: usize) -> usize { return left + right }\nfn mismatch(left: i32, right: u8) -> i32 { return left + right }\nfn noOrder(left: bool, right: bool) -> bool { return left < right }\nfn noNegate(value: u8) -> u8 { return -value }\nfn contextual(value: usize) -> usize { return value + 7 }\n"
  let source = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let add = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"add")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let literalRight = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"literalRight")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let literalLeft = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"literalLeft")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let equal = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"equal")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let bitwise = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"bitwise")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let pointerSized = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"pointerSized")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mismatch = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"mismatch")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let noOrder = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"noOrder")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let noNegate = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"noNegate")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let contextual = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"contextual")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&add, inspect).success &&
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&literalRight, inspect).success &&
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&literalLeft, inspect).success &&
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&equal, inspect).success &&
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&bitwise, inspect).success &&
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&pointerSized, inspect).success,
    "closed operators accept exact scalar operands and contextual integer literals",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&contextual, inspect).success,
    "an in-range contextual usize participates in a selected-target operator",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&mismatch, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionCode(answer, RejectionCode.MissingOperator)
    }) &&
    Shared.with<Result<Answer, NoRejection>, bool>(&noOrder, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionCode(answer, RejectionCode.MissingOperator)
    }) &&
    Shared.with<Result<Answer, NoRejection>, bool>(&noNegate, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionCode(answer, RejectionCode.MissingOperator)
    }),
    "closed operators reject unlike numeric types and unsupported scalar operations",
  )
  return ()
}

fn interfaceOperandsRemainOrdered(body: &TypedBody, concrete: bool) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {form: BodyExpression.InterfaceCall {implementation, arguments, ..}, ..} = &nodes[at].kind {
      let values = Vector.asSlice<BodyNodeId>(&arguments)
      if values.length != usize.add(1, 1) || values[usize.ZERO].index >= nodes.length || values[usize.ONE].index >= nodes.length {
        return false
      }
      let witness = match &implementation {
        Option<Shared<DeclarationId>>.Some {value: _} => true
        Option<Shared<DeclarationId>>.None => false
      }
      let bodies = TypedBody.runtimeBodies(body)
      let mut required = bodies.length == usize.ZERO
      if concrete {
        required = bodies.length == usize.ONE
      }
      return witness == concrete && required && nodes[values[usize.ZERO].index].origin.span.start < nodes[values[usize.ONE].index].origin.span.start
    }
    at = at + usize.ONE
  }
  return false
}

test effect fn markedOperatorsSelectOneBoundOrConcreteCall() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("marked-operators.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "interface Sum { operator + fn sum(left: Self, right: Self) -> Self }\nstruct Solo {}\nimpl Sum for Solo { fn sum(left: Self, right: Self) -> Self { return left } }\nfn concrete(left: Solo, right: Solo) -> Solo { return left + right }\nfn bounded<T: Sum>(left: T, right: T) -> T { return left + right }\ninterface Plain { fn add(left: Self, right: Self) -> Self }\nstruct Bare {}\nimpl Plain for Bare { fn add(left: Self, right: Self) -> Self { return left } }\nfn unmarked(left: Bare, right: Bare) -> Bare { return left + right }\n"
  let source = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let concrete = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"concrete")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let bounded = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"bounded")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let unmarked = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"unmarked")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let concreteTyped = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &concrete, checkedBody,
  )
  let boundTyped = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(
    &bounded, checkedBody,
  )
  let concreteOrder = match move concreteTyped {
    Option<Shared<TypedBody>>.Some {value} => Shared.with<TypedBody, bool>(&value, fn(body: &TypedBody) -> bool {
      return interfaceOperandsRemainOrdered(body, true)
    })
    Option<Shared<TypedBody>>.None => false
  }
  let boundOrder = match move boundTyped {
    Option<Shared<TypedBody>>.Some {value} => Shared.with<TypedBody, bool>(&value, fn(body: &TypedBody) -> bool {
      return interfaceOperandsRemainOrdered(body, false)
    })
    Option<Shared<TypedBody>>.None => false
  }
  run Testing.expect(
    concreteOrder && boundOrder &&
    Shared.with<Result<Answer, NoRejection>, bool>(&unmarked, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionCode(answer, RejectionCode.MissingOperator)
    }),
    "marked operator selection keeps source operand order and excludes unmarked operations",
  )
  return ()
}

fn singleOperatorIdentity(answer: &Result<Answer, NoRejection>) -> Option<Shared<DeclarationId>> {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Operations {operations}} = &value.outcome {
      let listed = Vector.asSlice<Shared<DeclarationId>>(&operations)
      if listed.length == usize.ONE { return Option.some<Shared<DeclarationId>>(Shared.clone<DeclarationId>(&listed[0])) }
    }
  }
  return Option.none<Shared<DeclarationId>>()
}

fn borrowedOperatorBindings(value: &Vector<Binding>, operation: &DeclarationId, left: &Shared<Lifetime>, right: &Shared<Lifetime>, firstOriginal: usize) -> bool {
  let learned = Vector.asSlice<Binding>(value)
  if learned.length != 2 { return false }
  let mut slot = usize.ZERO
  while slot < learned.length {
    let mut original = firstOriginal
    if slot != usize.ZERO { original = usize.ONE - firstOriginal }
    if learned[slot].ordinal != original || !Shared.with<DeclarationId, bool>(&learned[slot].declaration,
      fn(identity: &DeclarationId) -> bool { return DeclarationId.equals(identity, operation) }) { return false }
    if let Argument.Lifetime {value: region} = &learned[slot].value {
      if slot == usize.ZERO {
        if !Lifetime.equalsShared(&region, left) { return false }
      } else if !Lifetime.equalsShared(&region, right) { return false }
    } else { return false }
    slot = slot + usize.ONE
  }
  return true
}

fn borrowedOperatorOperandRegion(node: &BodyNode) -> Option<Shared<Lifetime>> {
  return match &node.kind {
    BodyNodeKind.Expression {ty, ..} => Shared.with<Type, Option<Shared<Lifetime>>>(&ty, receiverReferenceRegion)
    _ => Option.none<Shared<Lifetime>>()
  }
}

fn borrowedOperatorCall(body: &TypedBody, expected: &Shared<DeclarationId>, concrete: bool, borrowedResult: bool, firstOriginal: usize) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form: BodyExpression.InterfaceCall {operation, implementation, arguments, bindings, ..}} = &nodes[at].kind {
      if !Shared.with<DeclarationId, bool>(expected, fn(identity: &DeclarationId) -> bool {
        return DeclarationId.equals(identity, &operation)
      }) { return false }
      let bodies = TypedBody.runtimeBodies(body)
      match &implementation {
        Option<Shared<DeclarationId>>.Some {value} => {
          if !concrete || bodies.length != usize.ONE || !DeclarationId.named(&bodies[0], b"equal") { return false }
          let retained = Shared.with<DeclarationId, bool>(&value,
            fn(identity: &DeclarationId) -> bool { return DeclarationId.equals(identity, &bodies[0]) })
          if !retained { return false }
        }
        Option<Shared<DeclarationId>>.None => {
          if concrete || bodies.length != usize.ZERO { return false }
        }
      }
      let supplied = Vector.asSlice<BodyNodeId>(&arguments)
      if supplied.length != 2 || supplied[0].index >= nodes.length || supplied[1].index >= nodes.length { return false }
      if nodes[supplied[0].index].origin.span.start >= nodes[supplied[1].index].origin.span.start { return false }
      let first = borrowedOperatorOperandRegion(&nodes[supplied[0].index])
      let second = borrowedOperatorOperandRegion(&nodes[supplied[1].index])
      if let Option<Shared<Lifetime>>.Some {value: left} = move first {
        if let Option<Shared<Lifetime>>.Some {value: right} = move second {
          if Lifetime.equalsShared(&left, &right) { return false }
          let caller = TypedBody.declarationId(body)
          let firstOwned = Shared.with<Lifetime, bool>(&left, fn(region: &Lifetime) -> bool {
            return match &region.* { Lifetime.Parameter {declaration, ordinal} => DeclarationId.equals(&declaration, caller) && ordinal == usize.ZERO _ => false }
          })
          let secondOwned = Shared.with<Lifetime, bool>(&right, fn(region: &Lifetime) -> bool {
            return match &region.* { Lifetime.Parameter {declaration, ordinal} => DeclarationId.equals(&declaration, caller) && ordinal == usize.ONE _ => false }
          })
          if !firstOwned || !secondOwned { return false }
          let exact = Shared.with<Vector<Binding>, bool>(&bindings, fn(value: &Vector<Binding>) -> bool {
            return borrowedOperatorBindings(value, &operation, &left, &right, firstOriginal)
          })
          if !exact { return false }
          if borrowedResult {
            let resultRegion = Shared.with<Type, Option<Shared<Lifetime>>>(&ty, receiverReferenceRegion)
            if let Option<Shared<Lifetime>>.Some {value} = move resultRegion { return Lifetime.equalsShared(&value, &left) }
            return false
          }
          return Shared.with<Type, bool>(&ty, fn(result: &Type) -> bool {
            return match &result.* { Type.Primitive {name} => sameBytes(Bytes.asSlice(&name), b"bool") _ => false }
          })
        }
      }
      return false
    }
    at = at + usize.ONE
  }
  return false
}

fn borrowedOperatorEvidence(answer: &Shared<Result<Answer, NoRejection>>, expected: &Shared<DeclarationId>, concrete: bool, borrowedResult: bool, firstOriginal: usize) -> bool {
  let typed = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move typed {
    return Shared.with<TypedBody, bool>(&value, fn(body: &TypedBody) -> bool {
      return borrowedOperatorCall(body, expected, concrete, borrowedResult, firstOriginal)
    })
  }
  return false
}

test effect fn borrowedOperatorsInferOnlyTheirLifetimesAndProveBounds() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("borrowed-operators.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let contracts = run module("keys.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let contractText = """pub interface Equality { operator == fn equal(left: &Self, right: &Self) -> bool }
pub struct Key { pub value: i32 }
impl Equality for Key {
  fn equal(left: &Self, right: &Self) -> bool { return left.value == right.value }
}
pub interface Pick { operator + fn first<'b, 'a>(left: &'a Self, right: &'b Self) -> &'a Self }
pub interface Ordered { operator + fn ordered<'a, 'b: 'a>(left: &'a Self, right: &'b Self) -> &'a Self }
pub interface Fixed { operator == fn fixed(left: &'static Self, right: &'static Self) -> bool }
pub interface Risky { operator == unsafe fn risky(left: &Self, right: &Self) -> bool }
pub interface Repeated { operator == fn repeated<'a>(left: &'a Self, right: &'a Self) -> bool }
"""
  let text = """import keys { Equality, Key, Pick, Ordered, Fixed, Risky, Repeated }
fn bounded<'x, 'y, K: Equality>(left: &'x K, right: &'y K) -> bool { return left == right }
fn concrete<'x, 'y>(left: &'x Key, right: &'y Key) -> bool { return left == right }
fn returned<'x, 'y, K: Pick>(left: &'x K, right: &'y K) -> &'x K { return left + right }
fn proven<'x, 'y: 'x, K: Ordered>(left: &'x K, right: &'y K) -> &'x K { return left + right }
fn missing<'x, 'y, K: Ordered>(left: &'x K, right: &'y K) -> &'x K { return left + right }
fn staticOperands<K: Fixed>(left: &'static K, right: &'static K) -> bool { return left == right }
fn localOperands<'x, 'y, K: Fixed>(left: &'x K, right: &'y K) -> bool { return left == right }
fn wrongAccess<'x, 'y, K: Equality>(left: &'x mut K, right: &'y K) -> bool { return left == right }
fn unsafeOperand<'x, 'y, K: Risky>(left: &'x K, right: &'y K) -> bool { return left == right }
fn repeated<'x, 'y, K: Repeated>(left: &'x K, right: &'y K) -> bool { return left == right }
fn authorized<'x, 'y, K: Risky>(left: &'x K, right: &'y K) -> bool { unsafe { return left == right } }
"""
  let contractSource = run present(contractText) |> Effect.provideMut<Allocator>(&mut allocator)
  let source = run present(text) |> Effect.provideMut<Allocator>(&mut allocator)
  let r1 = run Revision.publish(&Revision.make(), &contracts, &contractSource) |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&r1, &entry, &source) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let equalOperations = run Semantic.demandOperations(&mut semantic, &mut request, &contracts, b"Equality") |> Effect.provideMut<Allocator>(&mut allocator)
  let pickOperations = run Semantic.demandOperations(&mut semantic, &mut request, &contracts, b"Pick") |> Effect.provideMut<Allocator>(&mut allocator)
  let orderedOperations = run Semantic.demandOperations(&mut semantic, &mut request, &contracts, b"Ordered") |> Effect.provideMut<Allocator>(&mut allocator)
  let riskyOperations = run Semantic.demandOperations(&mut semantic, &mut request, &contracts, b"Risky") |> Effect.provideMut<Allocator>(&mut allocator)
  let equal = Shared.with<Result<Answer, NoRejection>, Option<Shared<DeclarationId>>>(&equalOperations, singleOperatorIdentity)
  let pick = Shared.with<Result<Answer, NoRejection>, Option<Shared<DeclarationId>>>(&pickOperations, singleOperatorIdentity)
  let ordered = Shared.with<Result<Answer, NoRejection>, Option<Shared<DeclarationId>>>(&orderedOperations, singleOperatorIdentity)
  let risky = Shared.with<Result<Answer, NoRejection>, Option<Shared<DeclarationId>>>(&riskyOperations, singleOperatorIdentity)
  let bounded = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"bounded") |> Effect.provideMut<Allocator>(&mut allocator)
  let concrete = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"concrete") |> Effect.provideMut<Allocator>(&mut allocator)
  let returned = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"returned") |> Effect.provideMut<Allocator>(&mut allocator)
  let proven = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"proven") |> Effect.provideMut<Allocator>(&mut allocator)
  if let Option<Shared<DeclarationId>>.Some {value} = move equal {
    run Testing.expect(borrowedOperatorEvidence(&bounded, &value, false, false, usize.ZERO)
      && borrowedOperatorEvidence(&concrete, &value, true, false, usize.ZERO),
      "borrowed generic and concrete operators keep their original target, distinct canonical lifetime bindings and operand order")
  } else { run Testing.expect(false, "Equality publishes exactly one operator") }
  if let Option<Shared<DeclarationId>>.Some {value} = move pick {
    run Testing.expect(borrowedOperatorEvidence(&returned, &value, false, true, usize.ONE),
      "a borrowed operator result retains the first operand lifetime at original ordinal one, independently of operand order")
  } else { run Testing.expect(false, "Pick publishes exactly one operator") }
  if let Option<Shared<DeclarationId>>.Some {value} = move ordered {
    run Testing.expect(borrowedOperatorEvidence(&proven, &value, false, true, usize.ZERO),
      "caller premises independently prove the instantiated operation lifetime bound")
  } else { run Testing.expect(false, "Ordered publishes exactly one operator") }
  let missing = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"missing") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&missing, RejectionCode.Unsupported, text, "+", 2),
    "an operation lifetime obligation is never assumed as its own proof")
  let staticOperands = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"staticOperands") |> Effect.provideMut<Allocator>(&mut allocator)
  let staticBody = Shared.with<Result<Answer, NoRejection>, Option<Shared<TypedBody>>>(&staticOperands, checkedBody)
  run Testing.expect(match move staticBody { Option<Shared<TypedBody>>.Some {..} => true _ => false },
    "fixed static operands still select their exact contract")
  let localOperands = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"localOperands") |> Effect.provideMut<Allocator>(&mut allocator)
  let wrongAccess = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"wrongAccess") |> Effect.provideMut<Allocator>(&mut allocator)
  let unsafeOperand = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"unsafeOperand") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&localOperands, RejectionCode.MissingOperator, text, "==", 3)
    && rejectsSpan(&wrongAccess, RejectionCode.MissingOperator, text, "==", 4)
    && rejectsSpan(&unsafeOperand, RejectionCode.UnsafeAcknowledgement, text, "==", 5),
    "operand inference preserves fixed static lifetimes, reference access and unsafe admission")
  let repeated = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"repeated") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&repeated, RejectionCode.MissingOperator, text, "==", 6),
    "a repeated operation lifetime is inferred jointly and cannot bind independently to incompatible caller parameters")
  let authorized = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"authorized") |> Effect.provideMut<Allocator>(&mut allocator)
  if let Option<Shared<DeclarationId>>.Some {value} = move risky {
    run Testing.expect(borrowedOperatorEvidence(&authorized, &value, false, false, usize.ZERO),
      "an authorized unsafe body retains the selected operation and canonical loan bindings")
  } else { run Testing.expect(false, "Risky publishes exactly one operator") }
  return ()
}

test effect fn competingMarkedOperatorsRejectWithoutResultContextChoice() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("competing-operators.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "interface Sum { operator + fn sum(left: Self, right: Self) -> Self }\ninterface Other { operator + fn other(left: Self, right: Self) -> bool }\nstruct Double {}\nimpl Sum for Double { fn sum(left: Self, right: Self) -> Self { return left } }\nimpl Other for Double { fn other(left: Self, right: Self) -> bool { return false } }\nfn competing(left: Double, right: Double) -> Double { return left + right }\ninterface ScalarAdd { operator + fn add(left: Self, right: Self) -> Self }\nimpl ScalarAdd for i32 { fn add(left: Self, right: Self) -> Self { return left } }\nfn builtinCompetes(left: i32, right: i32) -> i32 { return left + right }\n"
  let source = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let competing = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"competing")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let builtinCompetes = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"builtinCompetes")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&competing, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionCode(answer, RejectionCode.AmbiguousOperator)
    }) &&
    Shared.with<Result<Answer, NoRejection>, bool>(&builtinCompetes, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionCode(answer, RejectionCode.AmbiguousOperator)
    }),
    "same-operand interface suppliers and builtin/interface suppliers reject without result context choice",
  )
  return ()
}

test effect fn namespaceImportsExposeOnlyNameableOperatorInterfaces() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let math = run module("math.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let model = run module("model.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let imported = run module("imported.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let hidden = run module("hidden.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mathSource = run present("pub interface Sum { operator + fn sum(left: Self, right: Self) -> Self }\n")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let modelSource = run present("import math { Sum }\npub struct Vector {}\nimpl Sum for Vector { fn sum(left: Self, right: Self) -> Self { return left } }\n")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let importedSource = run present("import math\nimport model { Vector }\nfn combine(left: Vector, right: Vector) -> Vector { return left + right }\n")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let hiddenSource = run present("import model { Vector }\nfn combine(left: Vector, right: Vector) -> Vector { return left + right }\n")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let r1 = run Revision.publish(&Revision.make(), &math, &mathSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let r2 = run Revision.publish(&r1, &model, &modelSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let r3 = run Revision.publish(&r2, &imported, &importedSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&r3, &hidden, &hiddenSource)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let visible = run Semantic.demandBody(&mut semantic, &mut request, &imported, b"combine")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let invisible = run Semantic.demandBody(&mut semantic, &mut request, &hidden, b"combine")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, AnswerView>(&visible, inspect).success,
    "namespace imports make public operator interfaces eligible",
  )
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&invisible, fn(answer: &Result<Answer, NoRejection>) -> bool {
      return rejectionCode(answer, RejectionCode.MissingOperator)
    }),
    "an unimported operator interface is not eligible",
  )
  return ()
}

test effect fn operatorDiscoverySharesEvidenceAndInvalidatesNamespaceEdits() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("entry.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let math = run module("math.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """import math as Math
fn first() -> i32 { return 1 + 2 + 3 }
fn second() -> i32 { return 4 + 5 }
"""
  let source = run present(text) |> Effect.provideMut<Allocator>(&mut allocator)
  let initialMath = run present("""pub interface Unmarked {}
""") |> Effect.provideMut<Allocator>(&mut allocator)
  let r1 = run Revision.publish(&Revision.make(), &entry, &source) |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&r1, &math, &initialMath) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(run Revision.copy(&revision) |> Effect.provideMut<Allocator>(&mut allocator))
  let mut request = Request.make()
  let first = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"first") |> Effect.provideMut<Allocator>(&mut allocator)
  let second = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"second") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    Shared.with<Result<Answer, NoRejection>, bool>(&first, operatorBodyHasSharedDiscovery) &&
    Shared.with<Result<Answer, NoRejection>, bool>(&second, operatorBodyHasSharedDiscovery) &&
    starts(Semantic.eventLog(&semantic), Family.OperatorInterfaces) == usize.ONE,
    "operator bodies share one discovery query rather than repeating namespace/name scans",
  )
  let changed = run present("""pub interface Unmarked {}
pub interface Sum { operator + fn sum(left: Self, right: Self) -> Self }
impl Sum for i32 { fn sum(left: Self, right: Self) -> Self { return left } }
""") |> Effect.provideMut<Allocator>(&mut allocator)
  let updated = run Revision.publish(&revision, &math, &changed) |> Effect.provideMut<Allocator>(&mut allocator)
  Semantic.revise(&mut semantic, move updated)
  let replaced = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"second") |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsFrom(&replaced, RejectionCode.AmbiguousOperator, offsetOf(text, "+", 2)) &&
    starts(Semantic.eventLog(&semantic), Family.OperatorInterfaces) == 2,
    "an added namespace operator invalidates the cached interface list and keeps the expression span",
  )
  return ()
}

fn operatorBodyHasSharedDiscovery(answer: &Result<Answer, NoRejection>) -> bool {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Body {..}} = &value.outcome {
      let dependencies = Vector.asSlice<Dependency>(&value.dependencies)
      let mut shared = false
      let mut at = usize.ZERO
      while at < dependencies.length {
        if dependencies[at].family == Family.Name { return false }
        if dependencies[at].family == Family.OperatorInterfaces { shared = true }
        at = at + usize.ONE
      }
      return shared
    }
  }
  return false
}

test effect fn operatorWithoutProviderOwnedOperandHasExplicitBoundary() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("unanchored-operator.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "struct Left {}\ninterface Unanchored { operator + fn combine(left: Left, right: Left) -> Self }\nfn combine(left: Left, right: Left) -> Left { return left + right }\n"
  let source = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let checked = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"combine")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsFrom(&checked, RejectionCode.Unsupported, offsetOf(text, "+", 1)),
    "an operator with no provider-owned operand cannot discover a provider-only implementation",
  )
  return ()
}

test effect fn staticOperatorOperandWaitsForStaticEvaluation() -> ()
! InvalidModulePath | OutOfMemoryError | Cycle | RevisionMismatch | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let entry = run module("static-operator.silk")
    |> Effect.provideMut<Allocator>(&mut allocator)
  let text = "interface StaticAdd { operator + fn add(left: Self, static right: Self) -> Self }\nfn combine<T: StaticAdd>(left: T, right: T) -> T { return left + right }\n"
  let source = run present(text)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let revision = run Revision.publish(&Revision.make(), &entry, &source)
    |> Effect.provideMut<Allocator>(&mut allocator)
  let mut semantic = makeSemantic(move revision)
  let mut request = Request.make()
  let checked = run Semantic.demandBody(&mut semantic, &mut request, &entry, b"combine")
    |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(
    rejectsFrom(&checked, RejectionCode.Unsupported, offsetOf(text, "+", 1)),
    "a runtime operator call cannot supply an evaluator-only static operand, and the gap is anchored on its operator use",
  )
  return ()
}

fn bodyIntegersHaveType(body: &TypedBody, spelling: &[u8], count: usize) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut found = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form: BodyExpression.Integer {..}} = &nodes[at].kind {
      let matches = Shared.with<Type, bool>(&ty, fn(value: &Type) -> bool {
        return match &value.* {
          Type.Primitive {name} => sameBytes(Bytes.asSlice(&name), spelling)
          _ => false
        }
      })
      if !matches { return false }
      found = found + usize.ONE
    }
    at = at + usize.ONE
  }
  return found == count
}

fn bodyRootConstantHasPrimitiveType(body: &TypedBody, spelling: &[u8]) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let root = TypedBody.rootNode(body)
  if root.index < nodes.length {
    if let BodyNodeKind.Expression {ty, form: BodyExpression.Constant {..}} = &nodes[root.index].kind {
      return Shared.with<Type, bool>(&ty, fn(found: &Type) -> bool {
        return match &found.* {
          Type.Primitive {name} => sameBytes(Bytes.asSlice(&name), spelling)
          _ => false
        }
      })
    }
  }
  return false
}
