//! Sealed heterogeneous descriptors preserve nominal identity, substitution and visibility.
import semantic.Types {TypeTable, Types}
import lexer.Span {Span}
import hir.Hir {Access, OwnerKind}
import semantic.ContentHash {ContentHash}
import semantic.DeclarationId {DeclarationId, OwnerStep}
import semantic.Intrinsic as CheckedIntrinsic
import semantic.Lifetime {Lifetime}
import semantic.ModuleId {InvalidModulePath, ModuleId}
import semantic.Query {Cycle}
import semantic.Rejection {Rejection, RejectionCode}
import semantic.Semantic {Answer, Dependency, Request, Semantic, StaticPort}
import semantic.SemanticCaseSupport {makeSemantic, module, present, sameBytes, rejectionCode}
import semantic.SourceIndex {NoRejection, RevisionMismatch}
import semantic.SourceRevision {Revision}
import semantic.StaticExecution
import semantic.StaticExecution {Diagnostic as StaticDiagnostic, Fault as StaticExecutionFault}
import semantic.StaticValue
import semantic.StaticValue {IntegerType as StaticIntegerType, Value as StaticData, Sign as StaticSign}
import semantic.Type {Argument, Type}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.effect {Effect}
import silk.core.option {Option}
import silk.core.result {Result}
import silk.mem.shared {Shared}
import silk.mem.interned {Interned}
import silk.text.string {String}
import silk.testing.testing {AssertionError, Testing}
import silk.num.usize
import silk.collections.list {List}
import silk.collections.slice {Slice}

test effect fn reflectedFieldCollectionsRetainExactCapabilities() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | StaticDiagnostic | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run reflectedFieldClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn reflectedFieldClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | StaticDiagnostic | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("field-reflection.silk")
  let owner = run module("reflected_owner.silk")
  let ownerText = """pub struct Bag<T> {pub first: T, pub enabled: bool, secret: i32}
"""
  let source = """import reflected_owner {Bag}
struct Local<T> {pub first: T, pub enabled: bool, secret: i32}
struct Other {pub first: i32}
struct Empty {}
tuple Pair(i32, bool)
static fn own() -> Intrinsic.Fields<Local<i32>> {return Intrinsic.reflectFields<Local<i32>>()}
static fn foreign() -> Intrinsic.Fields<Bag<i32>> {return Intrinsic.reflectFields<Bag<i32>>()}
static fn other() -> Intrinsic.Fields<Other> {return Intrinsic.reflectFields<Other>()}
static fn empty() -> Intrinsic.Fields<Empty> {return Intrinsic.reflectFields<Empty>()}
static fn positions() -> Intrinsic.Fields<Pair> {return Intrinsic.reflectFields<Pair>()}
"""
  let owned = run present(ownerText)
  let authored = run present(source)
  let revision = run Revision.publish(&Revision.make(), &owner, &owned)
  let revisionWithRoot = run Revision.publish(&revision, &id, &authored)
  let mut semantic = makeSemantic(move revisionWithRoot)
  let mut dependencies = List<Dependency>.make()
  let mut machine = run StaticExecution.make(Semantic.staticPort(&mut semantic, &mut dependencies), &id,
    StaticExecution.Limits {steps: 512, depth: 32, valueBytes: 65536})
  let noArguments = List<Interned<StaticData>>.make()
  let arguments = List<Interned<StaticData>>.asSlice(&noArguments)
  let span = Span.make(usize.ZERO, usize.ZERO)
  let local = run StaticExecution.demand(&mut machine, b"own", arguments, span)
  let foreign = run StaticExecution.demand(&mut machine, b"foreign", arguments, span)
  let other = run StaticExecution.demand(&mut machine, b"other", arguments, span)
  let empty = run StaticExecution.demand(&mut machine, b"empty", arguments, span)
  let positional = run StaticExecution.demand(&mut machine, b"positions", arguments, span)
  run Testing.expect(Interned<StaticData>.with<usize>(&local, StaticValue.sequenceLength) == 3,
    "a declaring module reflects its three fields in declaration order")
  run Testing.expect(Interned<StaticData>.with<usize>(&foreign, StaticValue.sequenceLength) == 2,
    "a foreign reflector never receives the private field or its label")
  run Testing.expect(Interned<StaticData>.with<usize>(&empty, StaticValue.sequenceLength) == usize.ZERO,
    "an empty aggregate retains a valid empty heterogeneous collection")
  run Testing.expect(fieldMetadata(&local, usize.ZERO, 0, "first", "own", true) &&
    fieldMetadata(&local, usize.ONE, 0, "enabled", "own", false) &&
    fieldMetadata(&local, 2, 0, "secret", "own", true),
    "each descriptor retains its exact substituted Value and original reflecting declaration")
  run Testing.expect(fieldMetadata(&foreign, usize.ZERO, 0, "first", "foreign", true) &&
    fieldMetadata(&foreign, usize.ONE, 0, "enabled", "foreign", false),
    "visibility filtering preserves source ordinals and the foreign reflector authority")
  run Testing.expect(fieldMetadata(&positional, usize.ZERO, 1, "", "positions", true) &&
    fieldMetadata(&positional, usize.ONE, 1, "", "positions", false),
    "positional descriptors retain stable ordinals without a source label")
  let first = collectionField(&local, usize.ZERO)
  let alternate = collectionField(&other, usize.ZERO)
  if let Option<Interned<StaticData>>.Some {value: left} = move first {
    if let Option<Interned<StaticData>>.Some {value: right} = move alternate {
      run Testing.expect(run StaticValue.equals(&left, &StaticValue.copy(&left)),
        "copying a descriptor preserves its immutable authorization and exact identity")
      run Testing.expect(!run StaticValue.equals(&left, &right),
        "equal field shapes from distinct nominal owners never share projection authority")
      run descriptorLabelEqualityClaims(&left)
      return ()
    }
  }
  run Testing.expect(false, "both nonempty collections contain their first descriptor")
  return ()
}

effect fn descriptorLabelEqualityClaims(original: &Interned<StaticData>) -> ()
! OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let held = Interned<StaticData>.with<Option<StaticValue.FieldParts>>(original, StaticValue.fieldParts)
  let parts = match move held {
    Option<StaticValue.FieldParts>.Some {value} => move value
    _ => {run Testing.expect(false, "the reflected element retains its sealed field metadata") return ()}
  }
  // Each new value has a distinct outer handle, so equality must inspect the label itself.
  let aliased = run descriptorWithLabel(&parts, Shared<Bytes>.clone(&parts.label))
  let sameBytes = run Shared<Bytes>.make(run StaticValue.copySharedBytes(&parts.label))
  let separate = run descriptorWithLabel(&parts, move sameBytes)
  let differentBytes = run Shared<Bytes>.make(run Bytes.copy(b"different"))
  let different = run descriptorWithLabel(&parts, move differentBytes)
  run Testing.expect(run StaticValue.equals(original, &aliased),
    "separate descriptor values retaining one label handle compare without nested inspection")
  run Testing.expect(run StaticValue.equals(original, &separate),
    "independently allocated labels with equal bytes retain descriptor identity")
  run Testing.expect(!run StaticValue.equals(original, &different),
    "distinct label bytes cannot acquire the original descriptor identity")
}

effect fn descriptorWithLabel(parts: &StaticValue.FieldParts, label: Shared<Bytes>) -> Interned<StaticData>
! OutOfMemoryError ? &mut Allocator {
  let held = StaticValue.reflectedField(Interned<Type>.clone(&parts.ty), parts.ordinal, parts.kind,
    move label, Interned<DeclarationId>.clone(&parts.authorization))
  let value = match move held {
    Option<StaticData>.Some {value} => move value
    _ => {return run Interned<StaticData>.make(StaticData.Unit)}
  }
  return run Interned<StaticData>.make(move value)
}

fn collectionField(collection: &Interned<StaticData>, ordinal: usize) -> Option<Interned<StaticData>> {
  return Interned<StaticData>.with<Option<Interned<StaticData>>>(collection, |value: &StaticData| -> Option<Interned<StaticData>> {
    return StaticValue.sequenceElement(value, ordinal)
  })
}

fn fieldMetadata(collection: &Interned<StaticData>, ordinal: usize, kind: u8, label: string,
  authorization: string, integer: bool) -> bool {
  let held = collectionField(collection, ordinal)
  if let Option<Interned<StaticData>>.Some {value: field} = move held {
    let parts = Interned<StaticData>.with<Option<StaticValue.FieldParts>>(&field, StaticValue.fieldParts)
    if let Option<StaticValue.FieldParts>.Some {value: descriptor} = move parts {
      let types = Interned<Type>.with<Option<CheckedIntrinsic.FieldTypes>>(&descriptor.ty, CheckedIntrinsic.fieldTypes)
      if let Option<CheckedIntrinsic.FieldTypes>.Some {value: selected} = move types {
        let valueMatches = Interned<Type>.with<bool>(&selected.value, |ty: &Type| -> bool {
          return reflectedValueType(ty, integer)
        })
        let labelMatches = Shared<Bytes>.with<bool>(&descriptor.label, |bytes: &Bytes| -> bool {
          return sameBytes(Bytes.asSlice(bytes), String.utf8Bytes(label))
        })
        let authorityMatches = Interned<DeclarationId>.with<bool>(&descriptor.authorization, |identity: &DeclarationId| -> bool {
          return DeclarationId.named(identity, String.utf8Bytes(authorization))
        })
        return descriptor.ordinal == ordinal && descriptor.kind == kind && valueMatches && labelMatches && authorityMatches
      }
    }
  }
  return false
}

fn reflectedValueType(ty: &Type, integer: bool) -> bool {
  if let Type.Primitive {name} = &ty.* {
    if integer {return sameBytes(Bytes.asSlice(&name), b"i32")}
    return sameBytes(Bytes.asSlice(&name), b"bool")
  }
  return false
}

test effect fn sealedFieldsCannotBeConstructedOrReturnedThroughAliases() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run reflectionAdmissionClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn reflectionAdmissionClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("field-admission.silk")
  let source = run present("""struct Owner {pub value: i32}
type FieldAlias = Intrinsic.Field<Owner, i32>
type FieldsAlias = Intrinsic.Fields<Owner>
static fn field() -> Intrinsic.Field<Owner, i32> {return Intrinsic.Field<Owner, i32>{}}
static fn fields() -> Intrinsic.Fields<Owner> {return Intrinsic.Fields<Owner>{}}
static fn aliasField() -> FieldAlias {return FieldAlias{}}
static fn aliasFields() -> FieldsAlias {return FieldsAlias{}}
fn leakedField() -> FieldAlias {return missing}
fn leakedFields() -> FieldsAlias {return missing}
""")
  let revision = run Revision.publish(&Revision.make(), &id, &source)
  let mut store = makeSemantic(move revision)
  let mut request = Request.make()
  let names = ["field", "fields", "aliasField", "aliasFields", "leakedField", "leakedFields"]
  let declared: &[string] = &names
  let mut at = usize.ZERO
  while at < declared.length {
    let name = declared[at]
    let answer = run Semantic.demandBody(&mut store, &mut request, &id, String.utf8Bytes(name))
    let mut expected = RejectionCode.NotType
    if at >= 4 {expected = RejectionCode.StaticPhaseViolation}
    run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&answer, |value: &Result<Answer, NoRejection>| -> bool {
      return rejectionCode(value, expected)
    }), "a sealed field capability needs compiler admission and stays phase-only behind aliases")
    at = at + usize.ONE
  }
  return ()
}

test effect fn scalarEnumReflectionPreservesDiscriminantsAndNames() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | StaticDiagnostic | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run enumReflectionClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn enumReflectionClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | StaticDiagnostic | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("enum-reflection.silk")
  let authored = run present("""enum(i16) Mode { Low = -7, High = 300 }
static fn members() -> Intrinsic.StaticSequence<Mode> { return Intrinsic.reflectEnumMembers<Mode>() }
static fn name() -> string<'static> { return Intrinsic.reflectEnumLabel<Mode>(Mode.High) }
static fn low() -> i16 { return Intrinsic.reflectEnumValue<Mode, i16>(Mode.Low) }
static fn wrongRepresentation() -> i32 { return Intrinsic.reflectEnumValue<Mode, i32>(Mode.Low) }
static fn identity() -> string<'static> { return Intrinsic.reflectDeclarationName<Mode>(Intrinsic.reflectType<Mode>()) }
static fn kind() -> u8 { return Intrinsic.reflectTypeKind<Mode>(Intrinsic.reflectType<Mode>()) }
""")
  let revision = run Revision.publish(&Revision.make(), &id, &authored)
  let mut semantic = makeSemantic(move revision)
  let mut dependencies = List<Dependency>.make()
  let mut machine = run StaticExecution.make(Semantic.staticPort(&mut semantic, &mut dependencies), &id,
    StaticExecution.Limits {steps: 512, depth: 32, valueBytes: 65536})
  let noArguments = List<Interned<StaticData>>.make()
  let arguments = noArguments.asSlice()
  let span = Span.make(0, 0)
  let members = run StaticExecution.demand(&mut machine, b"members", arguments, span)
  run Testing.expect(StaticValue.sequenceLength(Interned<StaticData>.get(&members)) == 2, "enum reflection includes each declared value")
  let first = StaticValue.sequenceElement(Interned<StaticData>.get(&members), 0)
  let last = StaticValue.sequenceElement(Interned<StaticData>.get(&members), 1)
  if let Option<Interned<StaticData>>.Some {value} = move first {
    run Testing.expect(Interned<StaticData>.with<bool>(&value, |data: &StaticData| -> bool {
      return match &data.* { StaticData.Enum {member, sign, magnitude, ..} => member == 0 && sign == StaticSign.Negative && magnitude == 7 _ => false }
    }), "negative discriminants retain their sign and declaration ordinal")
  } else { run Testing.expect(false, "the first enum value is present") }
  if let Option<Interned<StaticData>>.Some {value} = move last {
    run Testing.expect(Interned<StaticData>.with<bool>(&value, |data: &StaticData| -> bool {
      return match &data.* { StaticData.Enum {member, magnitude, ..} => member == 1 && magnitude == 300 _ => false }
    }), "sparse discriminants retain their value")
  } else { run Testing.expect(false, "the last enum value is present") }
  let name = run StaticExecution.demand(&mut machine, b"name", arguments, span)
  let named = run StaticValue.textBytes(&name)
  if let Option<Bytes>.Some {value} = move named { run Testing.expect(sameBytes(value.asSlice(), b"High"), "enum labels name declarations, not numeric values") }
  else { run Testing.expect(false, "the enum label is text") }
  let low = run StaticExecution.demand(&mut machine, b"low", arguments, span)
  run Testing.expect(Interned<StaticData>.with<bool>(&low, |data: &StaticData| -> bool {
    return match &data.* { StaticData.Integer {ty, sign, magnitude} => ty == StaticIntegerType.I16 && sign == StaticSign.Negative && magnitude == 7 _ => false }
  }), "an enum value's discriminant is an integer of its representation")
  let refused = run Effect.result(StaticExecution.demand(&mut machine, b"wrongRepresentation", arguments, span))
  let invalid = match &refused {
    Result<Interned<StaticData>, StaticDiagnostic | OutOfMemoryError>.Failure {error: StaticDiagnostic {fault, ..}} => fault == StaticExecutionFault.InvalidValue
    _ => false
  }
  run Testing.expect(invalid, "a discriminant is read only as the enum's representation")
  let identity = run StaticExecution.demand(&mut machine, b"identity", arguments, span)
  let text = run StaticValue.textBytes(&identity)
  let mut expected = Bytes.make()
  run ModuleId.appendPackage(&id, &mut expected)
  run expected.append(b"/enum-reflection.silk/Mode")
  if let Option<Bytes>.Some {value} = move text { run Testing.expect(sameBytes(value.asSlice(), expected.asSlice()), "declaration names include package and module identity") }
  else { run Testing.expect(false, "the declaration name is text") }
  let kind = run StaticExecution.demand(&mut machine, b"kind", arguments, span)
  run Testing.expect(Interned<StaticData>.with<bool>(&kind, |data: &StaticData| -> bool {
    return match &data.* { StaticData.Integer {magnitude, ..} => magnitude == 7 _ => false }
  }), "scalar enums have a distinct reflected type kind")
}

test effect fn unionPrivateFieldDetectsVariantFieldsAndPointsAtDeclaration() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | StaticDiagnostic | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run unionPrivateFieldClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn unionPrivateFieldClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | StaticDiagnostic | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("union-private.silk")
  let source = """union AllPub { First { pub x: i32 }, Second { pub y: bool } }
union LaterPrivate { First { pub x: i32 }, Second { pub a: i32, hidden: u8 } }
static fn nonePrivate() -> string<'static> { return Intrinsic.reflectPrivateField<AllPub>(Intrinsic.reflectType<AllPub>()) }
static fn firstPrivate() -> string<'static> { return Intrinsic.reflectPrivateField<LaterPrivate>(Intrinsic.reflectType<LaterPrivate>()) }
static fn reportPrivate() -> () {
  let field = Intrinsic.reflectPrivateField<LaterPrivate>(Intrinsic.reflectType<LaterPrivate>())
  return Intrinsic.staticTextErrorAt(field, 0, 6, "private variant field")
}
"""
  let authored = run present(source)
  let revision = run Revision.publish(&Revision.make(), &id, &authored)
  let mut semantic = makeSemantic(move revision)
  let mut dependencies = List<Dependency>.make()
  let mut machine = run StaticExecution.make(Semantic.staticPort(&mut semantic, &mut dependencies), &id,
    StaticExecution.Limits {steps: 512, depth: 32, valueBytes: 65536})
  let noArguments = List<Interned<StaticData>>.make()
  let arguments = noArguments.asSlice()
  let span = Span.make(0, 0)
  let nonePrivate = run StaticExecution.demand(&mut machine, b"nonePrivate", arguments, span)
  if let Option<Bytes>.Some {value} = move run StaticValue.textBytes(&nonePrivate) {
    run Testing.expect(sameBytes(value.asSlice(), b""), "all-public union has no private field")
  } else { run Testing.expect(false, "nonePrivate evaluates to text") }
  let firstPrivate = run StaticExecution.demand(&mut machine, b"firstPrivate", arguments, span)
  if let Option<Bytes>.Some {value} = move run StaticValue.textBytes(&firstPrivate) {
    run Testing.expect(sameBytes(value.asSlice(), b"hidden"), "later variant private field name is returned")
  } else { run Testing.expect(false, "firstPrivate evaluates to text") }
  let reported = run Effect.result(StaticExecution.demand(&mut machine, b"reportPrivate", arguments, span))
  let failed = match &reported {
    Result<Interned<StaticData>, StaticDiagnostic | OutOfMemoryError>.Failure {error: StaticDiagnostic {fault, rejection, ..}} =>
      fault == StaticExecutionFault.CompileError && hasRejection(&rejection)
    _ => false
  }
  run Testing.expect(failed, "errorAt on private variant field produces a located compile error")
  // Verify StaticPort.fieldNameSite resolves directly to `hidden` in `LaterPrivate`.
  let mut steps = List<OwnerStep>.make()
  run List<OwnerStep>.append(&mut steps, OwnerStep {kind: OwnerKind.Union, name: Option<Bytes>.some(run Bytes.copy(b"LaterPrivate")), occurrence: 0})
  let decl = run DeclarationId.fromParts(ModuleId.copy(&id), move steps)
  let unionTy = run Types.intern(Type.Nominal {declaration: move decl, isPublic: false, arguments: List<Argument>.make()})
  let mut portDependencies = List<Dependency>.make()
  let mut port = Semantic.staticPort(&mut semantic, &mut portDependencies)
  let site = run StaticPort.fieldNameSite(&mut port, &unionTy, b"hidden", 0, 6)
  if let Option<StaticExecution.LocatedSite>.Some {value: located} = move site {
    let raw = String.utf8Bytes(source)
    let matched = sameBytes(Slice.view<u8>(raw, located.span.start, located.span.end - located.span.start), b"hidden")
    run Testing.expect(matched, "fieldNameSite locates the private variant field identifier")
  } else { run Testing.expect(false, "fieldNameSite returns a location for union variant fields") }
}

fn hasRejection(rejection: &Option<Shared<Rejection>>) -> bool {
  return match &rejection.* {
    Option<Shared<Rejection>>.Some {..} => true
    Option<Shared<Rejection>>.None => false
  }
}

fn readPairWords(value: &Interned<StaticData>) -> [u64; 2] {
  let mut out: [u64; 2] = [0, 0]
  let mut idx: usize = 0
  while idx < 2 {
    let child = Interned<StaticData>.with<Option<Interned<StaticData>>>(value, |data: &StaticData| -> Option<Interned<StaticData>> {
      return StaticValue.field(data, idx)
    })
    if let Option<Interned<StaticData>>.Some {value: item} = move child {
      out[idx] = Interned<StaticData>.with<u64>(&item, |data: &StaticData| -> u64 {
        return match &data.* { StaticData.Integer {magnitude, ..} => magnitude _ => 0 }
      })
    }
    idx = idx + 1
  }
  return out
}

fn samePairWords(a: [u64; 2], b: [u64; 2]) -> bool {
  return a[0] == b[0] && a[1] == b[1]
}

test effect fn reflectTypeIdDistinguishesNominalsAndArgumentsAndErasesLifetimes() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | StaticDiagnostic | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run reflectTypeIdClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn reflectTypeIdClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | StaticDiagnostic | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let modA = run module("mod_a.silk")
  let modB = run module("mod_b.silk")
  let root = run module("type-id.silk")
  let itemText = """pub struct Item { pub value: i32 }
"""
  let rootText = """import mod_a {Item as ItemA}
import mod_b {Item as ItemB}
struct Box<T> { pub inner: T }
struct Pair<A, B> { pub a: A, pub b: B }
static fn idA() -> [u64; 2] { return Intrinsic.reflectTypeId<ItemA>(Intrinsic.reflectType<ItemA>()) }
static fn idB() -> [u64; 2] { return Intrinsic.reflectTypeId<ItemB>(Intrinsic.reflectType<ItemB>()) }
static fn boxI32() -> [u64; 2] { return Intrinsic.reflectTypeId<Box<i32>>(Intrinsic.reflectType<Box<i32>>()) }
static fn boxU64() -> [u64; 2] { return Intrinsic.reflectTypeId<Box<u64>>(Intrinsic.reflectType<Box<u64>>()) }
static fn pairAB() -> [u64; 2] { return Intrinsic.reflectTypeId<Pair<i32, bool>>(Intrinsic.reflectType<Pair<i32, bool>>()) }
static fn pairBA() -> [u64; 2] { return Intrinsic.reflectTypeId<Pair<bool, i32>>(Intrinsic.reflectType<Pair<bool, i32>>()) }
static fn pairAB2() -> [u64; 2] { return Intrinsic.reflectTypeId<Pair<i32, bool>>(Intrinsic.reflectType<Pair<i32, bool>>()) }
static fn openId<T>() -> [u64; 2] { return Intrinsic.reflectTypeId<T>(Intrinsic.reflectType<T>()) }
"""
  let mut revision = run Revision.publish(&Revision.make(), &modA, &run present(itemText))
  revision = run Revision.publish(&revision, &modB, &run present(itemText))
  revision = run Revision.publish(&revision, &root, &run present(rootText))
  let mut semantic = makeSemantic(move revision)
  let mut dependencies = List<Dependency>.make()
  let mut machine = run StaticExecution.make(Semantic.staticPort(&mut semantic, &mut dependencies), &root,
    StaticExecution.Limits {steps: 512, depth: 32, valueBytes: 65536})
  let noArguments = List<Interned<StaticData>>.make()
  let arguments = noArguments.asSlice()
  let span = Span.make(0, 0)
  let a = readPairWords(&run StaticExecution.demand(&mut machine, b"idA", arguments, span))
  let b = readPairWords(&run StaticExecution.demand(&mut machine, b"idB", arguments, span))
  run Testing.expect(!samePairWords(a, b), "same-named structs in distinct modules produce distinct TypeIds")
  let bi = readPairWords(&run StaticExecution.demand(&mut machine, b"boxI32", arguments, span))
  let bu = readPairWords(&run StaticExecution.demand(&mut machine, b"boxU64", arguments, span))
  run Testing.expect(!samePairWords(bi, bu), "distinct generic type arguments produce distinct TypeIds")
  let pab = readPairWords(&run StaticExecution.demand(&mut machine, b"pairAB", arguments, span))
  let pba = readPairWords(&run StaticExecution.demand(&mut machine, b"pairBA", arguments, span))
  let pab2 = readPairWords(&run StaticExecution.demand(&mut machine, b"pairAB2", arguments, span))
  run Testing.expect(!samePairWords(pab, pba), "argument order affects TypeId")
  run Testing.expect(samePairWords(pab, pab2), "identical instantiations produce identical TypeIds")
  let openResult = run Effect.result(StaticExecution.demand(&mut machine, b"openId", arguments, span))
  let unsupported = match &openResult {
    Result<Interned<StaticData>, StaticDiagnostic | OutOfMemoryError>.Failure {error: StaticDiagnostic {fault, ..}} => fault == StaticExecutionFault.Unsupported
    _ => false
  }
  run Testing.expect(unsupported, "reflectTypeId rejects open type parameters")
  // Verify StaticPort.typeId erases lifetimes (`&'static i32` == `&'a i32`) and rejects open type parameters.
  let i32Ty = run Types.intern(Type.Primitive {name: run Bytes.copy(b"i32")})
  let mut ownerSteps = List<OwnerStep>.make()
  run List<OwnerStep>.append(&mut ownerSteps, OwnerStep {kind: OwnerKind.Struct, name: Option<Bytes>.some(run Bytes.copy(b"f")), occurrence: 0})
  let paramDecl = run DeclarationId.fromParts(ModuleId.copy(&root), move ownerSteps)
  let staticRef = run Types.intern(Type.Reference {
    referent: Interned<Type>.clone(&i32Ty),
    access: Access.Shared,
    lifetime: run Types.internLifetime(Lifetime.Static),
  })
  let namedRef = run Types.intern(Type.Reference {
    referent: move i32Ty,
    access: Access.Shared,
    lifetime: run Types.internLifetime(Lifetime.Parameter {declaration: DeclarationId.copy(&paramDecl), ordinal: 0}),
  })
  let h1 = run StaticPort.typeId(&staticRef, &root)
  let h2 = run StaticPort.typeId(&namedRef, &root)
  let mut sameLifetimeErased = false
  if let Option<ContentHash>.Some {value: left} = h1 {
    if let Option<ContentHash>.Some {value: right} = h2 {
      sameLifetimeErased = ContentHash.equals(left, right)
    }
  }
  run Testing.expect(sameLifetimeErased, "StaticPort.typeId erases lifetime differences")
  let paramTy = run Types.intern(Type.Parameter {declaration: move paramDecl, ordinal: 0})
  let paramId = run StaticPort.typeId(&paramTy, &root)
  let paramNone = match paramId { Option<ContentHash>.None => true _ => false }
  run Testing.expect(paramNone, "StaticPort.typeId returns none for open type parameters")
}
