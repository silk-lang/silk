//! Sealed heterogeneous descriptors preserve nominal identity, substitution and visibility.
import lexer.Span {Span}
import semantic.DeclarationId {DeclarationId}
import semantic.Intrinsic as CheckedIntrinsic
import semantic.ModuleId {InvalidModulePath, ModuleId}
import semantic.Query {Cycle}
import semantic.Rejection {RejectionCode}
import semantic.Semantic {Answer, Dependency, Request, Semantic}
import semantic.SemanticCaseSupport {makeSemantic, module, present, sameBytes, rejectionCode}
import semantic.SourceIndex {NoRejection, RevisionMismatch}
import semantic.SourceRevision {Revision}
import semantic.StaticExecution
import semantic.StaticExecution {Diagnostic as StaticDiagnostic}
import semantic.StaticValue
import semantic.StaticValue {Value as StaticData}
import semantic.Type {Type}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.effect {Effect}
import silk.option {Option}
import silk.result {Result}
import silk.shared {Shared}
import silk.string {String}
import silk.testing {AssertionError, Testing}
import silk.usize
import silk.vector {Vector}

test effect fn reflectedFieldCollectionsRetainExactCapabilities() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | StaticDiagnostic | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run reflectedFieldClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn reflectedFieldClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | StaticDiagnostic | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let id = run module("field-reflection.silk")
  let owner = run module("reflected_owner.silk")
  let ownerText = """pub struct Bag<T> {pub first: T pub enabled: bool secret: i32}
"""
  let source = """import reflected_owner {Bag}
struct Local<T> {pub first: T pub enabled: bool secret: i32}
struct Other {pub first: i32}
struct Empty {}
tuple Pair(i32, bool)
static fn own() -> Intrinsic.Fields<Local<i32>> {return Intrinsic.reflectFields<Local<i32>>()}
static fn foreign() -> Intrinsic.Fields<Bag<i32>> {return Intrinsic.reflectFields<Bag<i32>>()}
static fn other() -> Intrinsic.Fields<Other> {return Intrinsic.reflectFields<Other>()}
static fn empty() -> Intrinsic.Fields<Empty> {return Intrinsic.reflectFields<Empty>()}
static fn positions() -> Intrinsic.Fields<Pair> {return Intrinsic.reflectFields<Pair>()}
"""
  let owned = run present(ownerText)
  let authored = run present(source)
  let revision = run Revision.publish(&Revision.make(), &owner, &owned)
  let revisionWithRoot = run Revision.publish(&revision, &id, &authored)
  let mut semantic = makeSemantic(move revisionWithRoot)
  let mut dependencies = Vector.make<Dependency>()
  let mut machine = run StaticExecution.make(Semantic.staticPort(&mut semantic, &mut dependencies), &id,
    StaticExecution.Limits {steps: 512, depth: 32, valueBytes: 65536})
  let noArguments = Vector.make<Shared<StaticData>>()
  let arguments = Vector.asSlice<Shared<StaticData>>(&noArguments)
  let span = Span.make(usize.ZERO, usize.ZERO)
  let local = run StaticExecution.demand(&mut machine, b"own", arguments, span)
  let foreign = run StaticExecution.demand(&mut machine, b"foreign", arguments, span)
  let other = run StaticExecution.demand(&mut machine, b"other", arguments, span)
  let empty = run StaticExecution.demand(&mut machine, b"empty", arguments, span)
  let positional = run StaticExecution.demand(&mut machine, b"positions", arguments, span)
  run Testing.expect(Shared.with<StaticData, usize>(&local, StaticValue.sequenceLength) == 3,
    "a declaring module reflects its three fields in declaration order")
  run Testing.expect(Shared.with<StaticData, usize>(&foreign, StaticValue.sequenceLength) == 2,
    "a foreign reflector never receives the private field or its label")
  run Testing.expect(Shared.with<StaticData, usize>(&empty, StaticValue.sequenceLength) == usize.ZERO,
    "an empty aggregate retains a valid empty heterogeneous collection")
  run Testing.expect(fieldMetadata(&local, usize.ZERO, 0, "first", "own", true) &&
    fieldMetadata(&local, usize.ONE, 0, "enabled", "own", false) &&
    fieldMetadata(&local, 2, 0, "secret", "own", true),
    "each descriptor retains its exact substituted Value and original reflecting declaration")
  run Testing.expect(fieldMetadata(&foreign, usize.ZERO, 0, "first", "foreign", true) &&
    fieldMetadata(&foreign, usize.ONE, 0, "enabled", "foreign", false),
    "visibility filtering preserves source ordinals and the foreign reflector authority")
  run Testing.expect(fieldMetadata(&positional, usize.ZERO, 1, "", "positions", true) &&
    fieldMetadata(&positional, usize.ONE, 1, "", "positions", false),
    "positional descriptors retain stable ordinals without a source label")
  let first = collectionField(&local, usize.ZERO)
  let alternate = collectionField(&other, usize.ZERO)
  if let Option<Shared<StaticData>>.Some {value: left} = move first {
    if let Option<Shared<StaticData>>.Some {value: right} = move alternate {
      run Testing.expect(run StaticValue.equals(&left, &StaticValue.copy(&left)),
        "copying a descriptor preserves its immutable authorization and exact identity")
      run Testing.expect(!run StaticValue.equals(&left, &right),
        "equal field shapes from distinct nominal owners never share projection authority")
      run descriptorLabelEqualityClaims(&left)
      return ()
    }
  }
  run Testing.expect(false, "both nonempty collections contain their first descriptor")
  return ()
}

effect fn descriptorLabelEqualityClaims(original: &Shared<StaticData>) -> ()
! OutOfMemoryError | AssertionError<'static> ? &mut Allocator {
  let held = Shared.with<StaticData, Option<StaticValue.FieldParts>>(original, StaticValue.fieldParts)
  let parts = match move held {
    Option<StaticValue.FieldParts>.Some {value} => move value
    _ => {run Testing.expect(false, "the reflected element retains its sealed field metadata") return ()}
  }
  // Each new value has a distinct outer handle, so equality must inspect the label itself.
  let aliased = run descriptorWithLabel(&parts, Shared.clone<Bytes>(&parts.label))
  let sameBytes = run Shared.make<Bytes>(run StaticValue.copySharedBytes(&parts.label))
  let separate = run descriptorWithLabel(&parts, move sameBytes)
  let differentBytes = run Shared.make<Bytes>(run Bytes.copy(b"different"))
  let different = run descriptorWithLabel(&parts, move differentBytes)
  run Testing.expect(run StaticValue.equals(original, &aliased),
    "separate descriptor values retaining one label handle compare without nested inspection")
  run Testing.expect(run StaticValue.equals(original, &separate),
    "independently allocated labels with equal bytes retain descriptor identity")
  run Testing.expect(!run StaticValue.equals(original, &different),
    "distinct label bytes cannot acquire the original descriptor identity")
}

effect fn descriptorWithLabel(parts: &StaticValue.FieldParts, label: Shared<Bytes>) -> Shared<StaticData>
! OutOfMemoryError ? &mut Allocator {
  let held = StaticValue.reflectedField(Shared.clone<Type>(&parts.ty), parts.ordinal, parts.kind,
    move label, Shared.clone<DeclarationId>(&parts.authorization))
  let value = match move held {
    Option<StaticData>.Some {value} => move value
    _ => {return run Shared.make<StaticData>(StaticData.Unit)}
  }
  return run Shared.make<StaticData>(move value)
}

fn collectionField(collection: &Shared<StaticData>, ordinal: usize) -> Option<Shared<StaticData>> {
  return Shared.with<StaticData, Option<Shared<StaticData>>>(collection, fn(value: &StaticData) -> Option<Shared<StaticData>> {
    return StaticValue.sequenceElement(value, ordinal)
  })
}

fn fieldMetadata(collection: &Shared<StaticData>, ordinal: usize, kind: u8, label: string,
  authorization: string, integer: bool) -> bool {
  let held = collectionField(collection, ordinal)
  if let Option<Shared<StaticData>>.Some {value: field} = move held {
    let parts = Shared.with<StaticData, Option<StaticValue.FieldParts>>(&field, StaticValue.fieldParts)
    if let Option<StaticValue.FieldParts>.Some {value: descriptor} = move parts {
      let types = Shared.with<Type, Option<CheckedIntrinsic.FieldTypes>>(&descriptor.ty, CheckedIntrinsic.fieldTypes)
      if let Option<CheckedIntrinsic.FieldTypes>.Some {value: selected} = move types {
        let valueMatches = Shared.with<Type, bool>(&selected.value, fn(ty: &Type) -> bool {
          return reflectedValueType(ty, integer)
        })
        let labelMatches = Shared.with<Bytes, bool>(&descriptor.label, fn(bytes: &Bytes) -> bool {
          return sameBytes(Bytes.asSlice(bytes), String.utf8Bytes(label))
        })
        let authorityMatches = Shared.with<DeclarationId, bool>(&descriptor.authorization, fn(identity: &DeclarationId) -> bool {
          return DeclarationId.named(identity, String.utf8Bytes(authorization))
        })
        return descriptor.ordinal == ordinal && descriptor.kind == kind && valueMatches && labelMatches && authorityMatches
      }
    }
  }
  return false
}

fn reflectedValueType(ty: &Type, integer: bool) -> bool {
  if let Type.Primitive {name} = &ty.* {
    if integer {return sameBytes(Bytes.asSlice(&name), b"i32")}
    return sameBytes(Bytes.asSlice(&name), b"bool")
  }
  return false
}

test effect fn sealedFieldsCannotBeConstructedOrReturnedThroughAliases() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  return run reflectionAdmissionClaims() |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn reflectionAdmissionClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator {
  let id = run module("field-admission.silk")
  let source = run present("""struct Owner {pub value: i32}
type FieldAlias = Intrinsic.Field<Owner, i32>
type FieldsAlias = Intrinsic.Fields<Owner>
static fn field() -> Intrinsic.Field<Owner, i32> {return Intrinsic.Field<Owner, i32>{}}
static fn fields() -> Intrinsic.Fields<Owner> {return Intrinsic.Fields<Owner>{}}
static fn aliasField() -> FieldAlias {return FieldAlias{}}
static fn aliasFields() -> FieldsAlias {return FieldsAlias{}}
fn leakedField() -> FieldAlias {return missing}
fn leakedFields() -> FieldsAlias {return missing}
""")
  let revision = run Revision.publish(&Revision.make(), &id, &source)
  let mut store = makeSemantic(move revision)
  let mut request = Request.make()
  let names = ["field", "fields", "aliasField", "aliasFields", "leakedField", "leakedFields"]
  let declared: &[string] = &names
  let mut at = usize.ZERO
  while at < declared.length {
    let name = declared[at]
    let answer = run Semantic.demandBody(&mut store, &mut request, &id, String.utf8Bytes(name))
    let mut expected = RejectionCode.NotType
    if at >= 4 {expected = RejectionCode.StaticPhaseViolation}
    run Testing.expect(Shared.with<Result<Answer, NoRejection>, bool>(&answer, fn(value: &Result<Answer, NoRejection>) -> bool {
      return rejectionCode(value, expected)
    }), "a sealed field capability needs compiler admission and stays phase-only behind aliases")
    at = at + usize.ONE
  }
  return ()
}
