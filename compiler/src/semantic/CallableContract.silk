//! Callable contract compatibility, independent of environment representation and direct targets.

import semantic.Types {Types}
import hir.Hir {Access, CallableMode}
import semantic.CallableWitness
import semantic.CallableWitness {CallableWitness as WitnessRecipe}
import semantic.Lifetime {Intersection, Lifetime}
import semantic.Type {Outlives, Row, Type}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.option {Option}
import silk.result {Result}
import silk.shared {Shared}
import silk.usize
import silk.vector {Vector}

/// Owned contract facts used while comparing two source-callable values.
pub struct CallableContract {
  pub mode: CallableMode
  pub isUnsafe: bool
  pub environment: Shared<Intersection>
  pub invocationBinders: usize
  /// The marked `for<use ...>` binder ordinal, or `usize.MAX`.
  pub invocationUse: usize
  pub invocationBounds: Vector<Outlives>
  pub parameters: Vector<Shared<Type>>
  pub result: Shared<Type>
}

/// A delayed value's retained environment must outlive its promised environment.
pub struct EnvironmentRelation {
  pub source: Shared<Intersection>
  pub target: Shared<Intersection>
}

/// Owned validity obligations from one structurally compatible value comparison.
pub struct ValueRelation {
  pub outlives: Vector<Outlives>
  pub environments: Vector<EnvironmentRelation>
}

/// Validity evidence required by one otherwise compatible callable signature.
pub struct Relation {
  pub required: ValueRelation
  pub provided: Vector<Outlives>
  pub sourceEnvironment: Shared<Intersection>
  pub targetEnvironment: Shared<Intersection>
}

/// A proved structural mismatch, or a comparison outside the implemented relation.
pub enum Failure { Incompatible, Unsupported }

/// Extracts the invocation contract while preserving its exact value representation separately.
pub effect fn ofType(value: &Shared<Type>) -> Option<CallableContract>
! OutOfMemoryError ? &mut Allocator {
  let node = run Type.copy(value)
  return match move node {
    Type.CallableWitnessResult {witness} => {
      let contract = Shared<WitnessRecipe>.with<Shared<Type>>(&witness, CallableWitness.resultType)
      return run ofType(&contract)
    }
    Type.CallableResult {contract, ..} => run ofType(&contract)
    Type.CallableOrigin {contract, ..} => run ofType(&contract)
    Type.CallableView {contract, ..} => run ofType(&contract)
    Type.CallableValue {contract, ..} => run ofType(&contract)
    Type.Callable {mode, isUnsafe, environment, invocationBinders, invocationUse, invocationBounds, parameters, result} =>
      Option<CallableContract>.some(CallableContract {mode: mode, isUnsafe: isUnsafe,
        environment: move environment, invocationBinders: invocationBinders, invocationUse: invocationUse,
        invocationBounds: move invocationBounds, parameters: move parameters, result: move result})
    _ => Option<CallableContract>.none()
  }
}

fn strength(mode: CallableMode) -> usize {
  return match mode { CallableMode.Shared => usize.ZERO CallableMode.Mutable => usize.ONE CallableMode.Once => 2 }
}

struct Reference {
  referent: Shared<Type>
  access: Access
  lifetime: Shared<Lifetime>
  slice: bool
}

effect fn reference(value: &Shared<Type>) -> Option<Reference>
! OutOfMemoryError ? &mut Allocator {
  let node = run Type.copy(value)
  return match move node {
    Type.Reference {referent, access, lifetime} => Option<Reference>.some(Reference {
      referent: move referent, access: access, lifetime: move lifetime,
      slice: false,
    })
    Type.Slice {element, access, lifetime} => Option<Reference>.some(Reference {
      referent: move element, access: access, lifetime: move lifetime, slice: true,
    })
    _ => Option<Reference>.none()
  }
}

// Reference validity is covariant. Exclusive referents remain invariant, and shared
// referents use the same value relation recursively. Other unequal forms remain explicit gaps.
effect fn valueRelation(source: &Shared<Type>, target: &Shared<Type>, required: &mut ValueRelation)
  -> Option<Failure> ! OutOfMemoryError ? &mut Allocator | &mut Types {
  if run Type.equalsShared(source, target) { return Option<Failure>.none() }
  // A delayed Effect result is covariant in its run access: one that may run repeatedly satisfies
  // a once promise. Its retained environment is a proof obligation, independent of its channels.
  let offeredEffect = run Type.copy(source)
  let wantedEffect = run Type.copy(target)
  if let Type.Effect {mode, environment, success, failure, requirements} = move offeredEffect {
    if let Type.Effect {mode: promisedMode, environment: promisedEnvironment, success: promisedSuccess,
      failure: promisedFailure, requirements: promisedRequirements} = move wantedEffect {
      if strength(mode) > strength(promisedMode) { return Option<Failure>.some(Failure.Incompatible) }
      let sameFailure = run Type.equalsShared(&failure, &promisedFailure)
      let sameRow = run Row.equalsShared(&requirements, &promisedRequirements)
      if !sameFailure || !sameRow { return Option<Failure>.some(Failure.Incompatible) }
      run Vector<EnvironmentRelation>.append(&mut required.environments, EnvironmentRelation {
        source: move environment, target: move promisedEnvironment,
      })
      return run valueRelation(&success, &promisedSuccess, &mut required.*)
    }
  }
  let first = run reference(source)
  let second = run reference(target)
  if let Option<Reference>.Some {value: offered} = move first {
    if let Option<Reference>.Some {value: wanted} = move second {
      if offered.slice != wanted.slice || (offered.access == Access.Shared && wanted.access == Access.Mutable) {
        return Option<Failure>.some(Failure.Incompatible)
      }
      let mut failure = Option<Failure>.none()
      if wanted.access == Access.Mutable {
        failure = run valueRelation(&offered.referent, &wanted.referent, &mut required.*)
        match move failure {
          Option<Failure>.Some {value} => { return Option<Failure>.some(value) }
          Option<Failure>.None => ()
        }
        failure = run valueRelation(&wanted.referent, &offered.referent, &mut required.*)
      } else { failure = run valueRelation(&offered.referent, &wanted.referent, &mut required.*) }
      if let Option<Failure>.Some {value} = move failure { return Option<Failure>.some(value) }
      run Vector<Outlives>.append(&mut required.outlives, Outlives {longer: move offered.lifetime, shorter: move wanted.lifetime})
      return Option<Failure>.none()
    }
    return Option<Failure>.some(Failure.Incompatible)
  }
  if Type.hasOpenParameters(source) || Type.hasOpenParameters(target) {
    return Option<Failure>.some(Failure.Unsupported)
  }
  // Distinct primitives are a structural mismatch. Other conversions may be valid but
  // require an argument/result ABI conversion before direct-call admission.
  let firstType = run Type.copy(source)
  let secondType = run Type.copy(target)
  if let Type.Primitive {name} = &firstType {
    if let Type.Primitive {..} = &secondType {
      let bytes = Bytes.asSlice(&name)
      let bottom = b"never"
      let mut matches = bytes.length == bottom.length
      let mut at = usize.ZERO
      while matches && at < bottom.length {
        matches = bytes[at] == bottom[at]
        at = at + usize.ONE
      }
      if matches { return Option<Failure>.some(Failure.Unsupported) }
      return Option<Failure>.some(Failure.Incompatible)
    }
  }
  return Option<Failure>.some(Failure.Unsupported)
}

fn invocation(value: &Lifetime) -> bool {
  return match &value.* { Lifetime.Invocation {..} => true _ => false }
}

/// Compares one stored operand to its selected parameter, retaining every required lifetime
/// and retained-environment relation for the caller's bound proof. Access weakening follows
/// the invocation relation.
pub effect fn compareValue(source: &Shared<Type>, target: &Shared<Type>) -> Result<ValueRelation, Failure>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut required = ValueRelation {outlives: Vector<Outlives>.make(), environments: Vector<EnvironmentRelation>.make()}
  let failure = run valueRelation(source, target, &mut required)
  if let Option<Failure>.Some {value} = move failure {
    return Result<ValueRelation, Failure>.failResult(value)
  }
  return Result<ValueRelation, Failure>.succeed(move required)
}

effect fn appendBounds(bounds: &[Outlives], provided: &mut Vector<Outlives>) -> ()
! OutOfMemoryError ? &mut Allocator {
  let mut at = usize.ZERO
  while at < bounds.length {
    run Vector<Outlives>.append(&mut provided.*, Outlives {
      longer: Shared<Lifetime>.clone(&bounds[at].longer), shorter: Shared<Lifetime>.clone(&bounds[at].shorter)})
    at = at + usize.ONE
  }
}

/// Compares invocation modes, unsafe policy and signature variance; the caller proves the
/// retained environment and returned lifetime obligations against its own declared premises.
pub effect fn compare(source: &CallableContract, target: &CallableContract) -> Result<Relation, Failure>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let offered = Vector<Shared<Type>>.asSlice(&source.parameters)
  let wanted = Vector<Shared<Type>>.asSlice(&target.parameters)
  if offered.length != wanted.length || strength(source.mode) > strength(target.mode)
    || (source.isUnsafe && !target.isUnsafe) { return Result<Relation, Failure>.failResult(Failure.Incompatible) }
  if source.invocationBinders != target.invocationBinders && source.invocationBinders != usize.ZERO {
    return Result<Relation, Failure>.failResult(Failure.Unsupported)
  }
  // A source that assumes its inputs live through a marked invocation needs the same promise.
  if source.invocationUse != usize.MAX && source.invocationUse != target.invocationUse {
    return Result<Relation, Failure>.failResult(Failure.Incompatible)
  }
  let mut required = ValueRelation {outlives: Vector<Outlives>.make(), environments: Vector<EnvironmentRelation>.make()}
  let mut provided = Vector<Outlives>.make()
  let bounds = Vector<Outlives>.asSlice(&source.invocationBounds)
  let mut at = usize.ZERO
  while at < bounds.length {
    let formation = !Lifetime.anyAtom(&bounds[at].longer, invocation)
      && !Lifetime.anyAtom(&bounds[at].shorter, invocation)
    if formation { run Vector<Outlives>.append(&mut provided, Outlives {
      longer: Shared<Lifetime>.clone(&bounds[at].longer), shorter: Shared<Lifetime>.clone(&bounds[at].shorter),
    }) } else { run Vector<Outlives>.append(&mut required.outlives, Outlives {
      longer: Shared<Lifetime>.clone(&bounds[at].longer), shorter: Shared<Lifetime>.clone(&bounds[at].shorter),
    }) }
    at = at + usize.ONE
  }
  at = usize.ZERO
  while at < offered.length {
    let failed = run valueRelation(&wanted[at], &offered[at], &mut required)
    if let Option<Failure>.Some {value} = move failed { return Result<Relation, Failure>.failResult(value) }
    at = at + usize.ONE
  }
  let failed = run valueRelation(&source.result, &target.result, &mut required)
  if let Option<Failure>.Some {value} = move failed { return Result<Relation, Failure>.failResult(value) }
  let premises = Vector<Outlives>.asSlice(&target.invocationBounds)
  run appendBounds(premises, &mut provided)
  return Result<Relation, Failure>.succeed(Relation {required: move required, provided: move provided,
    sourceEnvironment: Shared<Intersection>.clone(&source.environment), targetEnvironment: Shared<Intersection>.clone(&target.environment)})
}
