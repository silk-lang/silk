//! The complete Vector loan-transfer regression uses the actual standard-library contracts.
import driver.ModuleSources as Sources {InvalidBuildComposition, InvalidSourceRoot, MissingManifest, MissingStandardLibrary}
import driver.Packages {InvalidDependency}
import driver.NativeLinkInput {InvalidNativeLinkInput}
import semantic.ModuleId {ModuleId, InvalidModulePath}
import semantic.InitialProfile {Selection as RuntimeRequest}
import semantic.FinalProfile {FinalProfile}
import semantic.Query {Cycle}
import semantic.Rejection {RejectionCode}
import semantic.Semantic {Semantic, Request}
import semantic.SemanticCaseSupport {hasBorrowStatus, rejectsSpan}
import semantic.SourceIndex {RevisionMismatch}
import semantic.Target {Target, Id as TargetId}
import semantic.TypedBody {BorrowStatus}
import semantic.Types {TypeTable, Types}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.bytes {Bytes}
import silk.effect {Effect}
import silk.filesystem {FileSystem, FileError, Path}
import silk.native_host_input {NativeHostInput, HostInputError}
import silk.option {Option}
import silk.os_filesystem {OsFileSystem}
import silk.string {String}
import silk.testing {Testing, AssertionError}
import silk.toml_scanner {TomlError}

test effect fn holderTransferVectorElements() -> ()
! FileError | HostInputError | Cycle | RevisionMismatch | InvalidModulePath | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | TomlError | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  let cwd = run NativeHostInput.workingDirectory() |> Effect.provideMut<Allocator>(&mut allocator)
  let mut files = run OsFileSystem.make(Bytes.asSlice(&cwd)) |> Effect.provideMut<Allocator>(&mut allocator)
  return run vectorTransferClaims() |> Effect.provideMut<FileSystem>(&mut files) |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn vectorTransferClaims() -> ()
! FileError | Cycle | RevisionMismatch | InvalidModulePath | InvalidSourceRoot | InvalidDependency | MissingManifest | InvalidBuildComposition | MissingStandardLibrary | InvalidNativeLinkInput | TomlError | OutOfMemoryError | AssertionError<'static>
? &mut FileSystem | &mut Allocator | &mut Types {
  let path = run Path.make("/compiler/fixtures/holder-transfer-vector.silk")
  let library = run Path.make("/stdlib")
  let mut sources = run Sources.make(&path, Option<Path>.some(move library), b"x86_64-unknown-linux-gnu", b"gnu", false, RuntimeRequest.None)
  let id = ModuleId.copy(Sources.entry(&sources))
  run Sources.preloadProgram(&mut sources, &id)
  let mut store = Semantic.oneShot(run Sources.revision(&sources), Target.forId(TargetId.X8664UnknownLinuxGnu), Option<FinalProfile>.none())
  Semantic.selectPackages(&mut store, run Sources.packageGraph(&sources))
  let bytes = run FileSystem.readFile(&path)
  let text = unsafe { String.fromBytesUnchecked(move bytes) }
  let mut request = Request.make()
  let transferred = run Semantic.demandBody(&mut store, &mut request, &id, b"transferred")
  run Testing.expect(rejectsSpan(&transferred, RejectionCode.AccessDuringLoan, String.view(&text), "vectorOwner", 2),
    "a real Vector element retains its owner after transfer and source destruction (OWN0011)")
  let sourceDropped = run Semantic.demandBody(&mut store, &mut request, &id, b"sourceDropped")
  run Testing.expect(hasBorrowStatus(&sourceDropped, BorrowStatus.Checked),
    "an external referent survives the source Vector while the destination keeps it")
  let before = run Semantic.demandBody(&mut store, &mut request, &id, b"before")
  run Testing.expect(hasBorrowStatus(&before, BorrowStatus.Checked),
    "the owner may end after the destination Vector is read and dropped")
  return ()
}
