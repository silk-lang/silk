//! A 128-bit non-cryptographic hash that names byte content by value.
//!
//! # When to use
//! Use [`ContentHash`] where a revisable store must recognize equal content across revisions
//! without retaining the content itself, such as an emission subject's exact encoding.
//!
//! # Details
//! The hash is MurmurHash3 x64-128 with seed zero, which reads sixteen bytes per step as two
//! little-endian words. Equal bytes always hash equal, on every target. The threat model is
//! accidental collision: among 10^7 hashes in one build, the chance of any collision is about
//! 10^14 / 2^129, below 10^-24.
//!
//! # Gotchas
//! The hash does not resist a deliberately constructed collision. Do not use it where an
//! adversary chooses the content and a collision would matter; use `silk.sha2` there.

import silk.u8
import silk.u64
import silk.usize

/// The 128-bit hash of some byte content.
pub struct ContentHash {
  pub high: u64
  pub low: u64
}

impl Copy for ContentHash {}

const C1: u64 = 9782798678568883157
const C2: u64 = 5545529020109919103

// The little-endian word of `count` bytes at `start`, the rest zero.
fn word(bytes: &[u8], start: usize, count: usize) -> u64 {
  let mut value: u64 = 0
  let mut at = count
  while at > usize.ZERO {
    at = at - usize.ONE
    value = u64.bitOr(u64.shiftLeft(value, 8), u8.toU64(bytes[start + at]))
  }
  return value
}

fn mixFirst(word: u64) -> u64 {
  return u64.wrappingMultiply(u64.rotateLeft(u64.wrappingMultiply(word, C1), 31), C2)
}

fn mixSecond(word: u64) -> u64 {
  return u64.wrappingMultiply(u64.rotateLeft(u64.wrappingMultiply(word, C2), 33), C1)
}

fn finalize(value: u64) -> u64 {
  let first = u64.wrappingMultiply(u64.bitXor(value, u64.shiftRight(value, 33)), 18397679294719823053)
  let second = u64.wrappingMultiply(u64.bitXor(first, u64.shiftRight(first, 33)), 14181476777654086739)
  return u64.bitXor(second, u64.shiftRight(second, 33))
}

impl ContentHash {
  /// Returns the hash of `bytes`.
  pub fn of(bytes: &[u8]) -> ContentHash {
    let mut high: u64 = 0
    let mut low: u64 = 0
    let blocks = bytes.length / 16
    let mut block = usize.ZERO
    while block < blocks {
      let start = block * 16
      high = u64.bitXor(high, mixFirst(word(bytes, start, 8)))
      high = u64.wrappingAdd(u64.rotateLeft(high, 27), low)
      high = u64.wrappingAdd(u64.wrappingMultiply(high, 5), 1390208809)
      low = u64.bitXor(low, mixSecond(word(bytes, start + 8, 8)))
      low = u64.wrappingAdd(u64.rotateLeft(low, 31), high)
      low = u64.wrappingAdd(u64.wrappingMultiply(low, 5), 944331445)
      block = block + usize.ONE
    }
    let tail = blocks * 16
    let remaining = bytes.length - tail
    if remaining > 8 {
      low = u64.bitXor(low, mixSecond(word(bytes, tail + 8, remaining - 8)))
    }
    if remaining > usize.ZERO {
      let mut count = remaining
      if count > 8 {
        count = 8
      }
      high = u64.bitXor(high, mixFirst(word(bytes, tail, count)))
    }
    let length = usize.toU64(bytes.length)
    high = u64.bitXor(high, length)
    low = u64.bitXor(low, length)
    high = u64.wrappingAdd(high, low)
    low = u64.wrappingAdd(low, high)
    high = finalize(high)
    low = finalize(low)
    high = u64.wrappingAdd(high, low)
    low = u64.wrappingAdd(low, high)
    return ContentHash {high: high, low: low}
  }

  /// Whether `left` and `right` are the same hash.
  pub fn equals(left: ContentHash, right: ContentHash) -> bool {
    return left.high == right.high && left.low == right.low
  }
}
