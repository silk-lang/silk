//! A 128-bit hash that names byte content by value.
//!
//! # When to use
//! Use [`ContentHash`] where a revisable store must recognize equal content across revisions
//! without retaining the content itself, such as an emission subject's exact encoding.
//!
//! # Details
//! The hash is SipHash-1-3 with a 128-bit output and a zero key, the function rustc's stable
//! hasher uses for incremental fingerprints. It reads eight bytes per step as one little-endian
//! word. Equal bytes always hash equal, on every target. Among 10^7 hashes, the chance of any
//! accidental collision is about 10^14 / 2^129, below 10^-24, and no practical construction of
//! colliding inputs is known.
//!
//! # Gotchas
//! The key is public, so the hash is not a MAC. Use `silk.sha2` where content must be bound to
//! a published digest.

import silk.ownership {Copy}
import silk.u8
import silk.u64
import silk.usize

/// The 128-bit hash of some byte content.
pub struct ContentHash {
  pub high: u64
  pub low: u64
}

impl Copy for ContentHash {}

// The four lanes of one SipHash state.
struct Lanes {
  v0: u64
  v1: u64
  v2: u64
  v3: u64
}

impl Copy for Lanes {}

// One SipRound.
fn round(lanes: Lanes) -> Lanes {
  let mut v0 = u64.wrappingAdd(lanes.v0, lanes.v1)
  let mut v1 = u64.bitXor(u64.rotateLeft(lanes.v1, 13), v0)
  v0 = u64.rotateLeft(v0, 32)
  let mut v2 = u64.wrappingAdd(lanes.v2, lanes.v3)
  let mut v3 = u64.bitXor(u64.rotateLeft(lanes.v3, 16), v2)
  v0 = u64.wrappingAdd(v0, v3)
  v3 = u64.bitXor(u64.rotateLeft(v3, 21), v0)
  v2 = u64.wrappingAdd(v2, v1)
  v1 = u64.bitXor(u64.rotateLeft(v1, 17), v2)
  v2 = u64.rotateLeft(v2, 32)
  return Lanes {v0: v0, v1: v1, v2: v2, v3: v3}
}

// Absorbs one message word with a single compression round.
fn absorb(lanes: Lanes, word: u64) -> Lanes {
  let mixed = round(Lanes {v0: lanes.v0, v1: lanes.v1, v2: lanes.v2, v3: u64.bitXor(lanes.v3, word)})
  return Lanes {v0: u64.bitXor(mixed.v0, word), v1: mixed.v1, v2: mixed.v2, v3: mixed.v3}
}

// The three finalization rounds.
fn rounds(lanes: Lanes) -> Lanes {
  return round(round(round(lanes)))
}

fn folded(lanes: Lanes) -> u64 {
  return u64.bitXor(u64.bitXor(lanes.v0, lanes.v1), u64.bitXor(lanes.v2, lanes.v3))
}

// The little-endian word of `count` bytes at `start`, the rest zero.
fn word(bytes: &[u8], start: usize, count: usize) -> u64 {
  let mut value: u64 = 0
  let mut at = count
  while at > usize.ZERO {
    at = at - usize.ONE
    value = u64.bitOr(u64.shiftLeft(value, 8), u8.toU64(bytes[start + at]))
  }
  return value
}

/// A hash in progress over bytes appended in order. Appending the same bytes in any split gives the
/// same hash as [`ContentHash.of`] over their concatenation.
pub struct Stream {
  lanes: Lanes
  // The bytes appended since the last absorbed word, little-endian, and how many there are.
  pending: u64
  filled: usize
  // The total length, of which the final word carries the low byte.
  length: usize
}

impl Stream {
  /// Logical input bytes appended so far, excluding the hash's finalization padding.
  pub fn bytesAppended(self: &Self) -> usize {
    return self.length
  }
}

impl ContentHash {
  /// Starts a hash over no bytes.
  pub fn stream() -> Stream {
    // The zero-key initialization; v1 carries the 128-bit output's tweak.
    return Stream {
      lanes: Lanes {
        v0: 8317987319222330741,
        v1: 7237128888997146499,
        v2: 7816392313619706465,
        v3: 8387220255154660723,
      },
      pending: 0,
      filled: usize.ZERO,
      length: usize.ZERO,
    }
  }

  /// Appends one byte.
  pub fn appendByte(stream: &mut Stream, byte: u8) -> () {
    stream.pending = u64.bitOr(stream.pending, u64.shiftLeft(u8.toU64(byte), usize.toU64(stream.filled * 8)))
    stream.filled = stream.filled + usize.ONE
    stream.length = stream.length + usize.ONE
    if stream.filled == 8 {
      stream.lanes = absorb(stream.lanes, stream.pending)
      stream.pending = 0
      stream.filled = usize.ZERO
    }
    return ()
  }

  /// Appends `bytes`, a word at a time once the pending word is complete.
  pub fn append(stream: &mut Stream, bytes: &[u8]) -> () {
    let mut at = usize.ZERO
    while at < bytes.length && stream.filled != usize.ZERO {
      ContentHash.appendByte(&mut stream.*, bytes[at])
      at = at + usize.ONE
    }
    while at + 8 <= bytes.length {
      stream.lanes = absorb(stream.lanes, word(bytes, at, 8))
      stream.length = stream.length + 8
      at = at + 8
    }
    while at < bytes.length {
      ContentHash.appendByte(&mut stream.*, bytes[at])
      at = at + usize.ONE
    }
    return ()
  }

  /// Finishes the hash of every byte appended to `stream`.
  pub fn finish(stream: Stream) -> ContentHash {
    // The final word carries the length's low byte above the remaining bytes.
    let length = u64.shiftLeft(u64.bitAnd(usize.toU64(stream.length), 255), 56)
    let mut lanes = absorb(stream.lanes, u64.bitOr(length, stream.pending))
    lanes = rounds(Lanes {v0: lanes.v0, v1: lanes.v1, v2: u64.bitXor(lanes.v2, 238), v3: lanes.v3})
    let low = folded(lanes)
    lanes = rounds(Lanes {v0: lanes.v0, v1: u64.bitXor(lanes.v1, 221), v2: lanes.v2, v3: lanes.v3})
    return ContentHash {high: folded(lanes), low: low}
  }

  /// Returns the hash of `bytes`.
  pub fn of(bytes: &[u8]) -> ContentHash {
    let mut stream = ContentHash.stream()
    ContentHash.append(&mut stream, bytes)
    return ContentHash.finish(move stream)
  }

  /// Whether `left` and `right` are the same hash.
  pub fn equals(left: ContentHash, right: ContentHash) -> bool {
    return left.high == right.high && left.low == right.low
  }
}
