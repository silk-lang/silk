//! Stable bytes for the modules, declarations and source inputs a store writes to disk.
//!
//! # When to use
//! Use these encoders for anything a semantic store persists for another process to read back.
//! They never hold a process-local ordinal: a module is its three components, a declaration its
//! complete content, and a selector's declaration handle the identity that handle was interned
//! for, which the reading store interns again.
//!
//! # Details
//! Every word is big-endian and every byte run is length-delimited, as `RuntimeEncoding` writes
//! them. A [`Reader`] walks one encoding from its start. Reading bytes that are not an encoding
//! marks the reader failed and gives none; it never panics.

import lexer.Span {Span}
import semantic.DeclarationId {DeclarationId}
import semantic.ModuleId {InvalidModulePath, ModuleId}
import semantic.RuntimeEncoding as Encoding
import semantic.SourceInputs as Inputs {Facet, Selector}
import semantic.SourceLocations {Location}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.collections.bytes {Bytes}
import silk.core.effect {Effect}
import silk.option {Option}
import silk.core.result {Result}
import silk.collections.slice {Slice}
import silk.num.u8
import silk.num.u64
import silk.num.usize

/// A position in one stable encoding being read back.
pub struct Reader {
  at: usize,
  failed: bool,
}

/// A reader at the start of an encoding.
pub fn reader() -> Reader {
  return Reader {at: usize.ZERO, failed: false}
}

/// Whether every read so far succeeded and the reader is at the end of `bytes`.
pub fn finished(bytes: &[u8], reader: &Reader) -> bool {
  return !reader.failed && reader.at == bytes.length
}

/// Whether a read failed.
pub fn failed(reader: &Reader) -> bool {
  return reader.failed
}

/// Reads one word, or marks the reader failed and gives zero.
pub fn readWord(bytes: &[u8], reader: &mut Reader) -> u64 {
  if reader.failed || reader.at > bytes.length || bytes.length - reader.at < 8 {
    reader.failed = true
    return 0
  }
  let mut value: u64 = 0
  let mut index = usize.ZERO
  while index < 8 {
    value = u64.bitOr(u64.shiftLeft(value, 8), u8.toU64(bytes[reader.at + index]))
    index = index + usize.ONE
  }
  reader.at = reader.at + 8
  return value
}

/// Reads one length-delimited field and gives where its bytes lie in `bytes`, or marks the reader
/// failed and gives an empty span.
pub fn readField(bytes: &[u8], reader: &mut Reader) -> Span {
  let length = readWord(bytes, &mut reader.*)
  if reader.failed || length > usize.toU64(bytes.length - reader.at) {
    reader.failed = true
    return Span.make(usize.ZERO, usize.ZERO)
  }
  let start = reader.at
  reader.at = reader.at + u64.toUsize(length)
  return Span.make(start, reader.at)
}

/// The bytes a field read with [`readField`] spans.
pub fn view(bytes: &[u8], span: Span) -> &[u8] {
  return Slice.view<u8>(bytes, span.start, span.end - span.start)
}

/// Appends a module identity: its origin, package and logical path.
pub effect fn module(output: &mut Bytes, value: &ModuleId) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut origin = run ModuleId.copyOrigin(value)
  run Encoding.field(&mut output.*, Bytes.asSlice(&origin))
  let mut package = run ModuleId.copyPackage(value)
  run Encoding.field(&mut output.*, Bytes.asSlice(&package))
  let mut path = run ModuleId.copyPath(value)
  return run Encoding.field(&mut output.*, Bytes.asSlice(&path))
}

/// Reads a module identity [`module`] wrote, or none when the bytes are not a valid one.
pub effect fn readModule(bytes: &[u8], reader: &mut Reader) -> Option<ModuleId> ! OutOfMemoryError ? &mut Allocator {
  let origin = readField(bytes, &mut reader.*)
  let package = readField(bytes, &mut reader.*)
  let path = readField(bytes, &mut reader.*)
  if reader.failed { return Option<ModuleId>.none() }
  return run madeModule(view(bytes, origin), view(bytes, package), view(bytes, path), &mut reader.*)
}

/// As [`readModule`], giving a copy of `known` when the bytes name that module.
pub effect fn readModuleIn(bytes: &[u8], reader: &mut Reader, known: &ModuleId) -> Option<ModuleId> ! OutOfMemoryError ? &mut Allocator {
  let origin = readField(bytes, &mut reader.*)
  let package = readField(bytes, &mut reader.*)
  let path = readField(bytes, &mut reader.*)
  if reader.failed { return Option<ModuleId>.none() }
  if ModuleId.spells(known, view(bytes, origin), view(bytes, package), view(bytes, path)) {
    return Option<ModuleId>.some(ModuleId.copy(known))
  }
  return run madeModule(view(bytes, origin), view(bytes, package), view(bytes, path), &mut reader.*)
}

effect fn madeModule(origin: &[u8], package: &[u8], path: &[u8], reader: &mut Reader) -> Option<ModuleId> ! OutOfMemoryError ? &mut Allocator {
  let made = run Effect.result(ModuleId.make(origin, package, path))
  return match move made {
    Result<ModuleId, InvalidModulePath | OutOfMemoryError>.Success {value} => Option<ModuleId>.some(move value)
    Result<ModuleId, InvalidModulePath | OutOfMemoryError>.Failure {error} => match move error {
      InvalidModulePath {} => {
        reader.failed = true
        return Option<ModuleId>.none()
      }
      OutOfMemoryError {} => { fail OutOfMemoryError {} }
    }
  }
}

/// Appends a declaration identity: its complete content.
pub effect fn declaration(output: &mut Bytes, value: &DeclarationId) -> () ! OutOfMemoryError ? &mut Allocator {
  let mut content = Bytes.make()
  run DeclarationId.appendContent(value, &mut content)
  return run Encoding.field(&mut output.*, Bytes.asSlice(&content))
}

/// Reads a declaration identity [`declaration`] wrote, or none when the bytes are not one.
pub effect fn readDeclaration(bytes: &[u8], reader: &mut Reader) -> Option<DeclarationId>
! OutOfMemoryError ? &mut Allocator {
  let content = readField(bytes, &mut reader.*)
  if reader.failed { return Option<DeclarationId>.none() }
  let found = run declarationIn(bytes, content)
  if let Option<DeclarationId>.None = &found { reader.failed = true }
  return move found
}

/// As [`readDeclaration`], reusing `known` as the declaration's module when the bytes name it.
pub effect fn readDeclarationIn(bytes: &[u8], reader: &mut Reader, known: &ModuleId) -> Option<DeclarationId>
! OutOfMemoryError ? &mut Allocator {
  let content = readField(bytes, &mut reader.*)
  if reader.failed { return Option<DeclarationId>.none() }
  let found = run declarationInModule(bytes, content, known)
  if let Option<DeclarationId>.None = &found { reader.failed = true }
  return move found
}

/// The declaration identity whose content `content` spans in `bytes`, or none when it is not one.
pub effect fn declarationIn(bytes: &[u8], content: Span) -> Option<DeclarationId> ! OutOfMemoryError ? &mut Allocator {
  let made = run Effect.result(DeclarationId.fromContent(view(bytes, content)))
  return run madeDeclaration(move made)
}

/// As [`declarationIn`], reusing `known` as the declaration's module when the content names it.
pub effect fn declarationInModule(bytes: &[u8], content: Span, known: &ModuleId) -> Option<DeclarationId> ! OutOfMemoryError ? &mut Allocator {
  let made = run Effect.result(DeclarationId.fromContentIn(view(bytes, content), known))
  return run madeDeclaration(move made)
}

effect fn madeDeclaration(made: Result<Option<DeclarationId>, InvalidModulePath | OutOfMemoryError>) -> Option<DeclarationId> ! OutOfMemoryError {
  return match move made {
    Result<Option<DeclarationId>, InvalidModulePath | OutOfMemoryError>.Success {value} => move value
    Result<Option<DeclarationId>, InvalidModulePath | OutOfMemoryError>.Failure {error} => match move error {
      InvalidModulePath {} => Option<DeclarationId>.none()
      OutOfMemoryError {} => { fail OutOfMemoryError {} }
    }
  }
}

/// Steps over a module identity [`module`] wrote without building it.
pub fn skipModule(bytes: &[u8], reader: &mut Reader) -> () {
  drop readField(bytes, &mut reader.*)
  drop readField(bytes, &mut reader.*)
  drop readField(bytes, &mut reader.*)
}

/// A source input selector read back. A selector that names a declaration by handle carries a
/// placeholder handle here, and `identity` is the declaration it named, for the reading store to
/// intern and place with [`withHandle`]. A selector read by [`readSelectorDeferred`] leaves
/// `identity` none and `declaration` spanning the declaration's content, for [`declarationIn`].
pub struct ReadSelector {
  pub selector: Selector,
  pub identity: Option<DeclarationId>,
  pub declaration: Span,
}

fn facetCode(facet: Facet) -> u64 {
  return match facet {
    Facet.Alive => 0
    Facet.Identity => 1
    Facet.Arm => 2
    Facet.Import => 3
    Facet.Header => 4
    Facet.Binders => 5
    Facet.Members => 6
    Facet.Fields => 7
    Facet.Operations => 8
    Facet.Parent => 9
    Facet.Body => 10
    Facet.Written => 11
    Facet.Enclosed => 12
    Facet.Directives => 13
  }
}

fn facetOf(code: u64) -> Option<Facet> {
  if code == 0 { return Option<Facet>.some(Facet.Alive) }
  if code == 1 { return Option<Facet>.some(Facet.Identity) }
  if code == 2 { return Option<Facet>.some(Facet.Arm) }
  if code == 3 { return Option<Facet>.some(Facet.Import) }
  if code == 4 { return Option<Facet>.some(Facet.Header) }
  if code == 5 { return Option<Facet>.some(Facet.Binders) }
  if code == 6 { return Option<Facet>.some(Facet.Members) }
  if code == 7 { return Option<Facet>.some(Facet.Fields) }
  if code == 8 { return Option<Facet>.some(Facet.Operations) }
  if code == 9 { return Option<Facet>.some(Facet.Parent) }
  if code == 10 { return Option<Facet>.some(Facet.Body) }
  if code == 11 { return Option<Facet>.some(Facet.Written) }
  if code == 12 { return Option<Facet>.some(Facet.Enclosed) }
  if code == 13 { return Option<Facet>.some(Facet.Directives) }
  return Option<Facet>.none()
}

fn flag(value: bool) -> u64 {
  if value { return 1 }
  return 0
}

/// Appends a source input selector. `identity` is the declaration a handle selector's handle was
/// interned for; a handle selector without one has no stable form, and nothing is appended.
/// Returns whether the selector was appended.
pub effect fn selector(output: &mut Bytes, value: &Selector, identity: Option<&DeclarationId>) -> bool
! OutOfMemoryError ? &mut Allocator {
  match &value.* {
    Selector.Presence => { run Encoding.word(&mut output.*, 0) }
    Selector.Implementations => { run Encoding.word(&mut output.*, 1) }
    Selector.Imports => { run Encoding.word(&mut output.*, 2) }
    Selector.VisibleNames {namespaces, external} => {
      run Encoding.word(&mut output.*, 3)
      run Encoding.word(&mut output.*, flag(namespaces))
      run Encoding.word(&mut output.*, flag(external))
    }
    Selector.Identity {identity: named} => {
      run Encoding.word(&mut output.*, 4)
      run declaration(&mut output.*, &named)
    }
    Selector.Member {ordinal, ..} => {
      let declared = match move identity {
        Option<&DeclarationId>.Some {value: known} => known
        Option<&DeclarationId>.None => { return false }
      }
      run Encoding.word(&mut output.*, 5)
      run declaration(&mut output.*, declared)
      run Encoding.word(&mut output.*, usize.toU64(ordinal))
    }
    Selector.Name {spelling} => {
      run Encoding.word(&mut output.*, 6)
      run Encoding.field(&mut output.*, Bytes.asSlice(&spelling))
    }
    Selector.Selection {spelling} => {
      run Encoding.word(&mut output.*, 7)
      run Encoding.field(&mut output.*, Bytes.asSlice(&spelling))
    }
    Selector.Declaration {facet, ..} => {
      let declared = match move identity {
        Option<&DeclarationId>.Some {value: known} => known
        Option<&DeclarationId>.None => { return false }
      }
      run Encoding.word(&mut output.*, 8)
      run declaration(&mut output.*, declared)
      run Encoding.word(&mut output.*, facetCode(facet))
    }
    Selector.Location {location, ..} => {
      let declared = match move identity {
        Option<&DeclarationId>.Some {value: known} => known
        Option<&DeclarationId>.None => { return false }
      }
      run Encoding.word(&mut output.*, 9)
      run declaration(&mut output.*, declared)
      run Encoding.word(&mut output.*, usize.toU64(location.start))
      run Encoding.word(&mut output.*, usize.toU64(location.end))
    }
    Selector.Prefix {end} => {
      run Encoding.word(&mut output.*, 10)
      run Encoding.word(&mut output.*, usize.toU64(end))
    }
    Selector.Inherents => { run Encoding.word(&mut output.*, 11) }
    Selector.Resolution {path} => {
      run Encoding.word(&mut output.*, 12)
      run Encoding.field(&mut output.*, Bytes.asSlice(&path))
    }
  }
  return true
}

/// Reads a selector [`selector`] wrote, or none when the bytes are not one.
pub effect fn readSelector(bytes: &[u8], reader: &mut Reader) -> Option<ReadSelector> ! OutOfMemoryError ? &mut Allocator {
  return run readSelectorWith(bytes, &mut reader.*, true)
}

/// Reads a selector [`selector`] wrote, leaving the declaration a handle names undecoded.
pub effect fn readSelectorDeferred(bytes: &[u8], reader: &mut Reader) -> Option<ReadSelector> ! OutOfMemoryError ? &mut Allocator {
  return run readSelectorWith(bytes, &mut reader.*, false)
}

// The declaration a handle names: decoded when `decode`, or else only spanned in `declaration`.
effect fn handleDeclaration(bytes: &[u8], reader: &mut Reader, decode: bool, declaration: &mut Span) -> Option<DeclarationId>
! OutOfMemoryError ? &mut Allocator {
  if decode { return run readDeclaration(bytes, &mut reader.*) }
  declaration.* = readField(bytes, &mut reader.*)
  return Option<DeclarationId>.none()
}

effect fn readSelectorWith(bytes: &[u8], reader: &mut Reader, decode: bool) -> Option<ReadSelector> ! OutOfMemoryError ? &mut Allocator {
  let tag = readWord(bytes, &mut reader.*)
  if reader.failed { return Option<ReadSelector>.none() }
  let mut identity = Option<DeclarationId>.none()
  let mut declaration = Span.make(usize.ZERO, usize.ZERO)
  let mut read = Option<Selector>.none()
  if tag == 0 { read = Option<Selector>.some(Selector.Presence) }
  else if tag == 1 { read = Option<Selector>.some(Selector.Implementations) }
  else if tag == 2 { read = Option<Selector>.some(Selector.Imports) }
  else if tag == 3 {
    let namespaces = readWord(bytes, &mut reader.*)
    let external = readWord(bytes, &mut reader.*)
    read = Option<Selector>.some(Selector.VisibleNames {namespaces: namespaces == 1, external: external == 1})
  } else if tag == 4 {
    if let Option<DeclarationId>.Some {value} = move run readDeclaration(bytes, &mut reader.*) {
      read = Option<Selector>.some(Selector.Identity {identity: move value})
    }
  } else if tag == 5 {
    identity = run handleDeclaration(bytes, &mut reader.*, decode, &mut declaration)
    let ordinal = readWord(bytes, &mut reader.*)
    read = Option<Selector>.some(Selector.Member {handle: usize.MAX, ordinal: u64.toUsize(ordinal)})
  } else if tag == 6 || tag == 7 {
    let spelling = readField(bytes, &mut reader.*)
    let copied = run Bytes.copy(view(bytes, spelling))
    if tag == 6 { read = Option<Selector>.some(Selector.Name {spelling: move copied}) }
    else { read = Option<Selector>.some(Selector.Selection {spelling: move copied}) }
  } else if tag == 8 {
    identity = run handleDeclaration(bytes, &mut reader.*, decode, &mut declaration)
    if let Option<Facet>.Some {value: facet} = move facetOf(readWord(bytes, &mut reader.*)) {
      read = Option<Selector>.some(Selector.Declaration {handle: usize.MAX, facet: facet})
    }
  } else if tag == 9 {
    identity = run handleDeclaration(bytes, &mut reader.*, decode, &mut declaration)
    let start = readWord(bytes, &mut reader.*)
    let end = readWord(bytes, &mut reader.*)
    read = Option<Selector>.some(Selector.Location {handle: usize.MAX,
      location: Location {start: u64.toUsize(start), end: u64.toUsize(end)}})
  } else if tag == 10 {
    read = Option<Selector>.some(Selector.Prefix {end: u64.toUsize(readWord(bytes, &mut reader.*))})
  } else if tag == 11 {
    read = Option<Selector>.some(Selector.Inherents)
  } else if tag == 12 {
    let path = readField(bytes, &mut reader.*)
    read = Option<Selector>.some(Selector.Resolution {path: run Bytes.copy(view(bytes, path))})
  }
  if reader.failed { return Option<ReadSelector>.none() }
  return match move read {
    Option<Selector>.Some {value} => Option<ReadSelector>.some(ReadSelector {selector: move value, identity: move identity, declaration: declaration})
    Option<Selector>.None => {
      reader.failed = true
      return Option<ReadSelector>.none()
    }
  }
}

/// `value` with its declaration handle, if it carries one, replaced by `handle`.
pub fn withHandle(value: Selector, handle: usize) -> Selector {
  if let Selector.Member {ordinal, ..} = &value { return Selector.Member {handle: handle, ordinal: ordinal} }
  if let Selector.Declaration {facet, ..} = &value { return Selector.Declaration {handle: handle, facet: facet} }
  if let Selector.Location {location, ..} = &value { return Selector.Location {handle: handle, location: location} }
  return move value
}
