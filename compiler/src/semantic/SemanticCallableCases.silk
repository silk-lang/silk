effect fn effectJoinAdmissionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("effect-join-admission.silk")
  let text = """
struct Missing { code: i32 }
struct Token { value: i32 }
struct First {}
struct Second {}
service Clock { effect fn now() -> i32 ? &Clock }
effect fn failing() -> i32 ! Missing { fail Missing { code: 1 } }
effect fn needing() -> i32 ? &Clock { return run Clock.now() }
effect fn spending(token: Token) -> i32 { return token.value }
effect fn reading(value: &i32) -> i32 { return value.* }
fn failure() -> Effect<'static; i32> { return failing() }
fn requirement() -> Effect<'static; i32> { return needing() }
fn access(token: Token) -> Effect<'static; i32> { return spending(move token) }
fn environment(value: &i32) -> Effect<'static; i32> { return reading(value) }
effect fn writing(value: &mut i32) -> i32 { return value.* }
fn reborrowed(value: &mut i32) -> mut Effect<i32> { return writing(&mut value) }
fn reborrowedShared(value: &mut i32) -> Effect<i32> { return reading(&value) }
fn reborrowedStatic(value: &mut i32) -> mut Effect<'static; i32> { return writing(&mut value) }
fn offset(by: i32, value: &mut i32) -> i32 { return by + value.* }
fn reborrowedCallable(value: &mut i32) -> mut fn(i32) -> i32 { return offset(&mut value) }
fn reborrowedCallableStatic(value: &mut i32) -> mut fn<'static>(i32) -> i32 { return offset(&mut value) }
fn bound() -> i32 {
  let pending: Effect<'static; i32> = failing()
  return 0
}
fn shared(flag: bool) -> Effect<'static; i32> { if flag { return effect { return 1 } } return effect { return 2 } }
fn give(flag: bool) -> Effect<'static; i32> {
  let first = shared(flag)
  return first
}
fn owning(token: Token) -> once Effect<'static; i32> { return effect { let held = move token return held.value } }
fn giveOwned(token: Token) -> once Effect<'static; i32> {
  let first = owning(move token)
  return first
}
fn giveJoin(input: First | Second) -> Effect<'static; i32> {
  let picked = match move input { First {} => effect { return 1 } Second {} => effect { return 2 } }
  return picked
}
fn guarded(input: First | Second) -> i32 {
  return match &input { First {} if match 1 { _ => { return 3 } } => 1 _ => 0 }
}
effect fn two() -> i32 { return 2 }
effect fn byte() -> u8 { return 1 }
effect fn layered() -> Effect<'static; i32> { return two() }
effect fn layeredByte() -> Effect<'static; u8> { return byte() }
effect fn flat<'env, A, E, F, ?R, ?S>(self: once Effect<'env; Effect<'static; A ! F ? S> ! E ? R>) -> A ! E | F ? R | S {
  let inner = run self
  return run inner
}
fn flattened() -> i32 { return run flat(layered()) }
fn wantsInt(pending: once Effect<'static; Effect<'static; i32>>) -> () { drop pending }
fn wrongNested() -> () { wantsInt(layeredByte()) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let failure = run Semantic.demandBody(&mut store, &mut request, &id, b"failure")
  let requirement = run Semantic.demandBody(&mut store, &mut request, &id, b"requirement")
  let access = run Semantic.demandBody(&mut store, &mut request, &id, b"access")
  let environment = run Semantic.demandBody(&mut store, &mut request, &id, b"environment")
  let bound = run Semantic.demandBody(&mut store, &mut request, &id, b"bound")
  run Testing.expect(rejectsSpan(&failure, RejectionCode.ReturnTypeMismatch, text, "failing()", usize.ONE),
    "a returned Effect whose failure the declared result does not cover is a return mismatch")
  run Testing.expect(rejectsSpan(&requirement, RejectionCode.ReturnTypeMismatch, text, "needing()", usize.ONE),
    "a returned Effect needing a requirement the declared result lacks is a return mismatch")
  run Testing.expect(rejectsSpan(&access, RejectionCode.ReturnTypeMismatch, text, "spending(move token)", usize.ZERO),
    "a once Effect does not satisfy a shared declared result")
  run Testing.expect(rejectsSpan(&environment, RejectionCode.ReturnTypeMismatch, text, "reading(value)", usize.ZERO),
    "a returned Effect borrowing a parameter does not outlive a 'static declared result")
  let reborrowed = run Semantic.demandBody(&mut store, &mut request, &id, b"reborrowed")
  let reborrowedShared = run Semantic.demandBody(&mut store, &mut request, &id, b"reborrowedShared")
  let reborrowedStatic = run Semantic.demandBody(&mut store, &mut request, &id, b"reborrowedStatic")
  let writingRetained = run retainsRegionRelation(&mut store, &reborrowed, text, "writing(&mut value)", usize.ZERO)
  let readingRetained = run retainsRegionRelation(&mut store, &reborrowedShared, text, "reading(&value)", usize.ZERO)
  run Testing.expect(writingRetained && readingRetained,
    "a returned Effect holding a reborrow of a parameter's referent relates the reborrow's local loan to the promised environment as an open obligation (BORROW-005)")
  run Testing.expect(rejectsSpan(&reborrowedStatic, RejectionCode.ReturnTypeMismatch, text, "writing(&mut value)", usize.ONE),
    "a reborrow's local loan never meets a 'static promised environment")
  let reborrowedCallable = run Semantic.demandBody(&mut store, &mut request, &id, b"reborrowedCallable")
  let reborrowedCallableStatic = run Semantic.demandBody(&mut store, &mut request, &id, b"reborrowedCallableStatic")
  run Testing.expect(run retainsRegionRelation(&mut store, &reborrowedCallable, text, "offset(&mut value)", usize.ZERO),
    "a returned callable section holding a reborrow relates its local loan to the promised environment as an open obligation (BORROW-005)")
  run Testing.expect(rejectsSpan(&reborrowedCallableStatic, RejectionCode.UnsatisfiedLifetimeBound, text, "offset(&mut value)", usize.ONE),
    "a callable section's reborrow never meets a 'static promised environment")
  run Testing.expect(rejectsSpan(&bound, RejectionCode.AssignmentTypeMismatch, text, "failing()", 2),
    "a declared binding does not admit an Effect whose failure it does not cover")
  let give = run Semantic.demandBody(&mut store, &mut request, &id, b"give")
  let giveOwned = run Semantic.demandBody(&mut store, &mut request, &id, b"giveOwned")
  let giveJoin = run Semantic.demandBody(&mut store, &mut request, &id, b"giveJoin")
  run Testing.expect(rejectsSpan(&giveOwned, RejectionCode.ExplicitMoveRequired, text, "first", 3)
      && succeeded(&give) && succeeded(&giveJoin),
    "a producer's Effect family is Copy exactly when its realized storage is, as a join of Copy alternatives is")
  let guarded = run Semantic.demandBody(&mut store, &mut request, &id, b"guarded")
  run Testing.expect(succeeded(&guarded), "a match guard that always returns is `never` and accepted")
  let flattened = run Semantic.demandBody(&mut store, &mut request, &id, b"flattened")
  let wrongNested = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongNested")
  run Testing.expect(succeeded(&flattened) && rejectsSpan(&wrongNested, RejectionCode.IncompatibleCallableSignature, text, "layeredByte()", usize.ONE),
    "a nested Effect contract admits a producer's Effect family only when that family's contract satisfies it")
  let flatSignature = run Semantic.demandSignature(&mut store, &mut request, &id, b"flat")
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&flatSignature, nestedRepresentationSlots),
    "a nested Effect success contract is its own representation slot, named by the outer contract")
}

// The outer Effect contract's success is exactly the second representation slot, whose own
// contract has a non-Effect success.
fn nestedRepresentationSlots(answer: &Result<Answer, NoRejection>) -> bool {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome {
      let bounds = Vector<Constraint>.asSlice(&signature.constraints)
      if bounds.length != 2 { return false }
      if let Constraint.Represents {contract: outer, ..} = &bounds[usize.ZERO] {
        if let Constraint.Represents {parameter: nested, contract: inner} = &bounds[usize.ONE] {
          return Shared<Type>.with<bool>(&outer, effectSuccessIsSlot) && Shared<Type>.with<bool>(&inner, effectSuccessIsLeaf)
            && Shared<Type>.with<bool>(&nested, typeParameterNode)
        }
      }
    }
  }
  return false
}

fn typeParameterNode(value: &Type) -> bool { return match &value.* { Type.Parameter {..} => true _ => false } }

fn effectNode(value: &Type) -> bool { return match &value.* { Type.Effect {..} => true _ => false } }

fn effectSuccessIsSlot(value: &Type) -> bool {
  return match &value.* { Type.Effect {success, ..} => Shared<Type>.with<bool>(&success, typeParameterNode) _ => false }
}

fn effectSuccessIsLeaf(value: &Type) -> bool {
  return match &value.* { Type.Effect {success, ..} => !Shared<Type>.with<bool>(&success, effectNode) _ => false }
}

// The cases of the function's tag switch when each one calls an Effect literal on the payload its
// own tag selects; `usize.MAX` when any case does not.
effect fn joinDispatch(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> usize ! OutOfMemoryError ? &mut Allocator {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Switch {cases, ..} = &blocks[at].terminator {
          let listed = Vector<MirSwitchCase>.asSlice(&cases)
          let mut item = usize.ZERO
          while item < listed.length {
            let arm = &blocks[listed[item].target]
            let mut tag = usize.ZERO
            let mut found = false
            while tag < listed.length && !found {
              let decimal = run Type.extentText(tag)
              found = sameBytes(Bytes.asSlice(&listed[item].decimal), Bytes.asSlice(&decimal))
              if !found { tag = tag + usize.ONE }
            }
            if !blockReadsPayload(arm, tag) { return usize.MAX }
            if let MirTerminator.Call {callee: MirCallee.Instance {key}, ..} = &arm.terminator {
              if !effectBlockKey(&key) { return usize.MAX }
            } else { return usize.MAX }
            item = item + usize.ONE
          }
          return listed.length
        }
        at = at + usize.ONE
      }
    }
  }
  return usize.ZERO
}

// Whether a block's statements or call arguments address the payload of union tag `tag`.
fn blockReadsPayload(block: &MirBlock, tag: usize) -> bool {
  if let MirTerminator.Call {arguments, ..} = &block.terminator {
    let operands = Vector<MirOperand>.asSlice(&arguments)
    let mut at = usize.ZERO
    while at < operands.length {
      if let MirOperand.Move {place} = &operands[at] { if placeSelects(&place, tag) { return true } }
      if let MirOperand.Copy {place} = &operands[at] { if placeSelects(&place, tag) { return true } }
      at = at + usize.ONE
    }
  }
  let statements = Vector<MirStatement>.asSlice(&block.statements)
  let mut at = usize.ZERO
  while at < statements.length {
    if let MirStatement.Assign {value: MirRvalue.Ref {place, ..}, ..} = &statements[at] {
      if placeSelects(&place, tag) { return true }
    }
    at = at + usize.ONE
  }
  return false
}

fn placeSelects(place: &MirPlace, tag: usize) -> bool {
  let projections = Vector<MirProjection>.asSlice(&place.projections)
  let mut at = usize.ZERO
  while at < projections.length {
    if let MirProjection.Payload {index, ..} = &projections[at] { if index == tag { return true } }
    at = at + usize.ONE
  }
  return false
}

// The calls whose callee can fail, each with its failure edge.
fn edgedCalls(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> usize {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  let mut count = usize.ZERO
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {failure, ..} = &blocks[at].terminator {
          if let Option<MirFailureEdge>.Some {..} = &failure { count = count + usize.ONE }
        }
        at = at + usize.ONE
      }
    }
  }
  return count
}

// The union injections a function's MIR performs.
fn injectCount(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> usize {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  let mut count = usize.ZERO
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        let statements = Vector<MirStatement>.asSlice(&blocks[at].statements)
        let mut position = usize.ZERO
        while position < statements.length {
          if let MirStatement.Assign {value: MirRvalue.Inject {..}, ..} = &statements[position] { count = count + usize.ONE }
          position = position + usize.ONE
        }
        at = at + usize.ONE
      }
    }
  }
  return count
}

fn failDrops(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Fail {..} = &blocks[at].terminator {
          let statements = Vector<MirStatement>.asSlice(&blocks[at].statements)
          let mut position = usize.ZERO
          while position < statements.length {
            if let MirStatement.Drop {..} = &statements[position] { return true }
            position = position + usize.ONE
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}

// The operand count of the first call to an Effect literal's instance, `usize.MAX` without one.
fn effectBlockOperands(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> usize {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, arguments, ..} = &blocks[at].terminator {
          if effectBlockKey(&key) { return Vector<MirOperand>.length(&arguments) }
        }
        at = at + usize.ONE
      }
    }
  }
  return usize.MAX
}

fn effectBlockKey(key: &InstanceKey) -> bool {
  let identity = InstanceKey.identity(key)
  return Shared<DeclarationId>.with<bool>(&identity, fn(value: &DeclarationId) -> bool {
    return DeclarationId.kind(value) == OwnerKind.EffectBlock
  })
}

fn effectBlockApplication(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> Option<Shared<SpecializationApplication>> {
  let index = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, value) {
      let references = Vector<MirReference>.asSlice(&function.references)
      let mut at = usize.ZERO
      while at < references.length {
        if effectBlockKey(&references[at].key) { return InstanceKey.application(&references[at].key) }
        at = at + usize.ONE
      }
    }
  }
  return Option<Shared<SpecializationApplication>>.none()
}

test effect fn genericNamedSectionsInferEachInvocationIndependently() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let text = """
fn select<T>(value: T, enabled: bool) -> T { return move value }
fn main() -> i32 {
  let next = select(true)
  let first = next(41)
  if next(true) { return first + 1 }
  return 0
}
"""
  return run genericNamedSectionClaims(text, b"select", usize.MAX, usize.ZERO, b"bool")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn genericNamedSectionsPreserveSparseSelectedOrdinals() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let text = """
fn choose<A, B>(value: B, stored: A) -> B { drop stored return move value }
fn main() -> i32 {
  let next = choose(3)
  let first = next(41)
  if next(true) { return first + 1 }
  return 0
}
"""
  return run genericNamedSectionClaims(text, b"choose", usize.ZERO, usize.ONE, b"i32")
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn genericNamedSectionClaims(text: string<'static>, target: &[u8], selected: usize,
  deferred: usize, capture: &[u8]) -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("generic-named-section.silk")
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let answer = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&answer) && genericSectionTargets(&store, &answer, target, selected, deferred),
    "one immutable section directly selects both i32 and bool target instances with its stored suffix appended")
  let environment = genericSectionEnvironment(&store, &answer)
  if let Option<Shared<Type>>.Some {value: ty} = move environment {
    let copied = run Types.intern(run Type.copy(&ty))
    let copiedIdentity = run Type.equalsShared(&ty, &copied)
    run Testing.expect(!Type.hasOpenRuntimeParameters(&ty) && copiedIdentity
      && Shared<Type>.with<bool>(&ty, fn(value: &Type) -> bool { return genericSectionBlueprint(value, selected, deferred, capture) }),
      "deferred target variables remain bound metadata while selected caller evidence and capture storage retain their original ordinals")
    let layout = run Semantic.demandLayout(&mut store, &mut request, &id, &ty)
    let index = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&layout, selectedLayoutIndex)
    if let Option<usize>.Some {value: at} = move index {
      if let Option<Shared<BackendLayout>>.Some {value: record} = move Semantic.layoutAt(&store, at) {
        run Testing.expect(Shared<BackendLayout>.with<bool>(&record, fn(value: &BackendLayout) -> bool {
          return genericSectionRecord(value, capture)
        }), "generic section layout stores only its supplied capture, with no deferred argument, code pointer or adapter")
        return ()
      }
    }
  }
  run Testing.expect(false, "the exact generic section environment has a capture-only record layout")
}

fn genericSectionEnvironment(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> Option<Shared<Type>> {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let locals = Vector<MirLocal>.asSlice(&function.locals)
      let mut at = usize.ZERO
      while at < locals.length {
        if Shared<Type>.with<bool>(&locals[at].ty, fn(value: &Type) -> bool {
          return match &value.* { Type.CallableSchema {..} => true _ => false }
        }) { return Option<Shared<Type>>.some(Shared<Type>.clone(&locals[at].ty)) }
        at = at + usize.ONE
      }
    }
  }
  return Option<Shared<Type>>.none()
}

fn genericSectionBlueprint(value: &Type, selected: usize, deferred: usize, capture: &[u8]) -> bool {
  if let Type.CallableSchema {schema, captures, fieldInputs, ..} = &value.* {
    let fields = Vector<Shared<Type>>.asSlice(&captures)
    if fields.length != usize.ONE || Vector<CallableFieldInput>.length(&fieldInputs) != usize.ONE
      || !Shared<Type>.with<bool>(&fields[usize.ZERO], fn(ty: &Type) -> bool { return witnessPrimitive(ty, capture) }) { return false }
    return Shared<SectionSchema>.with<bool>(&schema, fn(recipe: &SectionSchema) -> bool {
      let deferredSlots = Vector<usize>.asSlice(&recipe.deferred)
      let evidence = Vector<Binding>.asSlice(&recipe.selected)
      if deferredSlots.length != usize.ONE || deferredSlots[usize.ZERO] != deferred { return false }
      if selected == usize.MAX { return evidence.length == usize.ZERO }
      return evidence.length == usize.ONE && evidence[usize.ZERO].ordinal == selected
        && genericSectionArgument(&evidence[usize.ZERO].value, b"i32")
    })
  }
  return false
}

fn genericSectionRecord(value: &BackendLayout, capture: &[u8]) -> bool {
  if let LayoutStorage.Record {fields} = &value.storage {
    let stored = Vector<LayoutField>.asSlice(&fields)
    return stored.length == usize.ONE && stored[usize.ZERO].offset == usize.ZERO
      && Shared<Type>.with<bool>(&stored[usize.ZERO].ty, fn(ty: &Type) -> bool { return witnessPrimitive(ty, capture) })
  }
  return false
}

fn genericSectionApplication(value: &SpecializationApplication, target: &[u8], selected: usize, deferred: usize) -> usize {
  if !DeclarationId.named(SpecializationApplication.bodyDeclaration(value), target) { return usize.ZERO }
  let arguments = Vector<Argument>.asSlice(&value.arguments)
  let ordinals = Vector<usize>.asSlice(&value.argumentOrdinals)
  if arguments.length != deferred + usize.ONE || ordinals.length != arguments.length { return usize.ZERO }
  let mut at = usize.ZERO
  while at < ordinals.length {
    if ordinals[at] != at { return usize.ZERO }
    at = at + usize.ONE
  }
  if selected != usize.MAX && !genericSectionArgument(&arguments[selected], b"i32") { return usize.ZERO }
  if genericSectionArgument(&arguments[deferred], b"i32") { return usize.ONE }
  if genericSectionArgument(&arguments[deferred], b"bool") { return 2 }
  return usize.ZERO
}

fn genericSectionTargets(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>,
  target: &[u8], selected: usize, deferred: usize) -> bool {
  let found = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move found {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut integer = false
      let mut boolean = false
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee, arguments, ..} = &blocks[at].terminator {
          let key = match &callee { MirCallee.Instance {key} => &key _ => { return false } }
          let application = match move InstanceKey.application(key) {
            Option<Shared<SpecializationApplication>>.Some {value} => move value
            _ => { return false }
          }
          let kind = Shared<SpecializationApplication>.with<usize>(&application,
            fn(value: &SpecializationApplication) -> usize { return genericSectionApplication(value, target, selected, deferred) })
          let operands = Vector<MirOperand>.asSlice(&arguments)
          if kind == usize.ZERO || operands.length != 2 || !sectionStoredField(&operands[usize.ONE], usize.ZERO) { return false }
          if kind == usize.ONE { integer = true }
          if kind == 2 { boolean = true }
        }
        at = at + usize.ONE
      }
      return integer && boolean
    }
  }
  return false
}

test effect fn genericNamedSectionsCheckInferenceAndBoundsAtTheirSites() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run genericNamedSectionDiagnosticClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn genericNamedSectionDiagnosticClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("generic-section-diagnostics.silk")
  let text = """
interface Permit {}
impl Permit for i32 {}
fn choose<T: Permit>(value: T, enabled: bool) -> T { return move value }
fn fixed<A: Permit, B>(value: B, stored: A) -> B { drop stored return move value }
fn unused<T>(value: i32, enabled: bool) -> i32 { return value }
fn manufacture<T>(value: i32, enabled: bool) -> T { return manufacture<T>(value, enabled) }
fn badDeferred() -> bool {
  let deferredCheck = choose(true)
  let successful = deferredCheck(1)
  return deferredCheck(true)
}
fn badFixed() -> () { let fixedCheck = fixed(true) }
fn badUnused() -> () { let unusedCheck = unused(true) }
fn badResult() -> () { let resultCheck = manufacture(true) }
fn quantifiedStage(callback: for<'a, 'b: 'a> fn<'static>(&'a i32, &'b i32, i32) -> i32) -> () {
  let quantifiedStep = callback(1)
}
fn good() -> i32 { let next = choose(true) return next(42) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let deferred = run Semantic.demandBody(&mut store, &mut request, &id, b"badDeferred")
  let fixed = run Semantic.demandBody(&mut store, &mut request, &id, b"badFixed")
  let unused = run Semantic.demandBody(&mut store, &mut request, &id, b"badUnused")
  let result = run Semantic.demandBody(&mut store, &mut request, &id, b"badResult")
  let quantified = run Semantic.demandBody(&mut store, &mut request, &id, b"quantifiedStage")
  let good = run Semantic.demandMir(&mut store, &mut request, &id, b"good")
  run Testing.expect(rejectsSpan(&deferred, RejectionCode.MissingConformance, text, "deferredCheck(true)", usize.ZERO)
    && rejectsSpan(&fixed, RejectionCode.MissingConformance, text, "fixed(true)", usize.ZERO),
    "a deferred bound is checked after each use while construction-fixed bounds are checked at construction")
  run Testing.expect(rejectsSpan(&unused, RejectionCode.UninferredParameter, text, "unused(true)", usize.ZERO)
    && rejectsSpan(&result, RejectionCode.UninferredParameter, text, "manufacture(true)", usize.ZERO),
    "unused and result-only binders retain SEM0052 at the complete section construction")
  run Testing.expect(succeeded(&good), "failed section inference and bound queries cannot poison a later supported application")
  run Testing.expect(rejectsSpan(&quantified, RejectionCode.Unsupported, text, "callback(1)", usize.ZERO),
    "deferred quantified staging retains its named typed-form gap before unresolved invocation bounds are proved")
}

// Exact key admission must not collapse selected lifetime evidence before recipe planning.
// This actor claim needs no parser/body/build demand and keeps runtime erasure independently true.
test effect fn genericNamedSectionExactIdentityRetainsSelectedAndContractLifetimes() -> ()
! CanonicalizationFailure | InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run genericNamedSectionLifetimeIdentityClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn genericNamedSectionLifetimeIdentityClaims() -> ()
! CanonicalizationFailure | InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("schema-lifetime-identity.silk")
  let mut owners = Vector<OwnerStep>.make()
  run Vector<OwnerStep>.append(&mut owners, OwnerStep {kind: OwnerKind.Function,
    name: Option<Bytes>.some(run Bytes.copy(b"choose")), occurrence: usize.ZERO})
  let owner = run DeclarationId.fromParts(move id, move owners)
  let lasting = run Shared<Lifetime>.make(Lifetime.Static)
  let local = run Shared<Lifetime>.make(Lifetime.Local {declaration: DeclarationId.copy(&owner), ordinal: usize.ZERO})
  let first = run genericSectionLifetimeType(&owner, &lasting, &lasting)
  let repeated = run genericSectionLifetimeType(&owner, &lasting, &lasting)
  let selectedLocal = run genericSectionLifetimeType(&owner, &local, &lasting)
  let contractLocal = run genericSectionLifetimeType(&owner, &lasting, &local)
  let copied = run Types.intern(run Type.copy(&first))
  let repeatEqual = run Type.equalsShared(&first, &repeated)
  let copyEqual = run Type.equalsShared(&first, &copied)
  let selectedEqual = run Type.equalsShared(&first, &selectedLocal)
  let contractEqual = run Type.equalsShared(&first, &contractLocal)
  let selectedRuntime = run Type.runtimeEqualsShared(&first, &selectedLocal)
  let contractRuntime = run Type.runtimeEqualsShared(&first, &contractLocal)
  run Testing.expect(repeatEqual && copyEqual && !selectedEqual && !contractEqual && selectedRuntime && contractRuntime,
    "exact schema identity retains selected lifetimes and free contract validity, while runtime identity erases both and copies remain equal")
  let alphaLeft = run genericSectionCallerAlphaContract(&owner, false)
  let alphaRight = run genericSectionCallerAlphaContract(&owner, true)
  let alphaEqual = run Type.alphaEquivalent(&alphaLeft, &first, &alphaRight, &repeated, 2)
  run Testing.expect(alphaEqual,
    "a caller's swapped impl binder map cannot rename the section blueprint's bound target parameter")
  let mut firstArguments = Vector<Argument>.make()
  run Vector<Argument>.append(&mut firstArguments, Argument.Type {value: Shared<Type>.clone(&first)})
  let firstKey = run requiredCanonicalKey(run InstanceKey.function(run specializationWithArguments(&owner, move firstArguments)))
  let mut secondArguments = Vector<Argument>.make()
  run Vector<Argument>.append(&mut secondArguments, Argument.Type {value: move selectedLocal})
  let secondKey = run requiredCanonicalKey(run InstanceKey.function(run specializationWithArguments(&owner, move secondArguments)))
  let exactEqual = run InstanceKey.sameApplication(&firstKey, &secondKey)
  run Testing.expect(!exactEqual && InstanceKey.sameRuntimeBase(&firstKey, &secondKey),
    "runtime-equal schema arguments remain distinct proof-bearing backend query keys")
  return ()
}

effect fn genericSectionCallerAlphaContract(owner: &DeclarationId, reversed: bool) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut first = usize.ZERO
  let mut second = usize.ONE
  if reversed { first = usize.ONE second = usize.ZERO }
  let mut parameters = Vector<Shared<Type>>.make()
  run Vector<Shared<Type>>.append(&mut parameters, run specializationParameter(owner, first))
  run Vector<Shared<Type>>.append(&mut parameters, run specializationParameter(owner, second))
  let regions = Vector<Shared<Lifetime>>.make()
  return run Types.intern(Type.Callable {mode: CallableMode.Once, isUnsafe: false,
    environment: run Shared<Intersection>.make(run Intersection.of(Vector<Shared<Lifetime>>.asSlice(&regions))), invocationBinders: usize.ZERO, invocationUse: usize.MAX,
    invocationBounds: Vector<Outlives>.make(), parameters: move parameters, result: run Types.intern(Type.Unit)})
}

effect fn genericSectionLifetimeType(owner: &DeclarationId, selectedLifetime: &Shared<Lifetime>, contractLifetime: &Shared<Lifetime>) -> Shared<Type>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let bound = run specializationParameter(owner, usize.ONE)
  let mut parameters = Vector<Shared<Type>>.make()
  run Vector<Shared<Type>>.append(&mut parameters, Shared<Type>.clone(&bound))
  let mut regions = Vector<Shared<Lifetime>>.make()
  run Vector<Shared<Lifetime>>.append(&mut regions, Shared<Lifetime>.clone(contractLifetime))
  let contract = run Types.intern(Type.Callable {mode: CallableMode.Once, isUnsafe: false,
    environment: run Shared<Intersection>.make(run Intersection.of(Vector<Shared<Lifetime>>.asSlice(&regions))), invocationBinders: usize.ZERO, invocationUse: usize.MAX,
    invocationBounds: Vector<Outlives>.make(), parameters: move parameters, result: move bound})
  let mut selected = Vector<Binding>.make()
  run Vector<Binding>.append(&mut selected, Binding {declaration: run Shared<DeclarationId>.make(DeclarationId.copy(owner)),
    ordinal: usize.ZERO, value: Argument.Lifetime {value: Shared<Lifetime>.clone(selectedLifetime)}})
  let mut deferred = Vector<usize>.make()
  run Vector<usize>.append(&mut deferred, usize.ONE)
  let schema = run Shared<SectionSchema>.make(SectionSchema {target: run Shared<DeclarationId>.make(DeclarationId.copy(owner)),
    contract: move contract, selected: move selected, deferred: move deferred})
  return run Type.callableSchema(move schema, Vector<Shared<Type>>.make(), Vector<CallableFieldInput>.make())
}

// This is a type-substitution claim: no parser, source body, backend demand or runtime oracle is
// needed to distinguish a bound target variable from a free caller variable with the same owner.
test effect fn genericNamedSectionSubstitutionKeepsBoundAndFreeOwnersSeparate() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run genericNamedSectionOwnerClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn genericNamedSectionOwnerClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("recursive-schema-owner.silk")
  let mut owners = Vector<OwnerStep>.make()
  run Vector<OwnerStep>.append(&mut owners, OwnerStep {kind: OwnerKind.Function,
    name: Option<Bytes>.some(run Bytes.copy(b"choose")), occurrence: usize.ZERO})
  let owner = run DeclarationId.fromParts(move id, move owners)
  let bound = run specializationParameter(&owner, usize.ZERO)
  let free = run specializationParameter(&owner, usize.ONE)
  let mut parameters = Vector<Shared<Type>>.make()
  run Vector<Shared<Type>>.append(&mut parameters, Shared<Type>.clone(&bound))
  let regions = Vector<Shared<Lifetime>>.make()
  let contract = run Types.intern(Type.Callable {mode: CallableMode.Once, isUnsafe: false,
    environment: run Shared<Intersection>.make(run Intersection.of(Vector<Shared<Lifetime>>.asSlice(&regions))), invocationBinders: usize.ZERO, invocationUse: usize.MAX,
    invocationBounds: Vector<Outlives>.make(), parameters: move parameters, result: move bound})
  let mut selected = Vector<Binding>.make()
  run Vector<Binding>.append(&mut selected, Binding {declaration: run Shared<DeclarationId>.make(DeclarationId.copy(&owner)),
    ordinal: usize.ONE, value: Argument.Type {value: Shared<Type>.clone(&free)}})
  let mut deferred = Vector<usize>.make()
  run Vector<usize>.append(&mut deferred, usize.ZERO)
  let schema = run Shared<SectionSchema>.make(SectionSchema {target: run Shared<DeclarationId>.make(DeclarationId.copy(&owner)),
    contract: move contract, selected: move selected, deferred: move deferred})
  let mut captures = Vector<Shared<Type>>.make()
  run Vector<Shared<Type>>.append(&mut captures, move free)
  let mut inputs = Vector<CallableFieldInput>.make()
  run Vector<CallableFieldInput>.append(&mut inputs, CallableFieldInput.Argument {parameter: usize.ONE})
  let original = run Type.callableSchema(move schema, move captures, move inputs)
  let mut types = Vector<usize>.make()
  let mut lifetimes = Vector<usize>.make()
  let mut rows = Vector<usize>.make()
  run Type.collectOwned(&original, &owner, &mut types, &mut lifetimes, &mut rows)
  let listed = Vector<usize>.asSlice(&types)
  run Testing.expect(listed.length == usize.ONE && listed[usize.ZERO] == usize.ONE,
    "free-variable traversal sees caller B while target A is bound by the section blueprint")
  let mut bindings = Vector<Binding>.make()
  run Vector<Binding>.append(&mut bindings, Binding {declaration: run Shared<DeclarationId>.make(DeclarationId.copy(&owner)),
    ordinal: usize.ZERO, value: Argument.Type {value: run specializationPrimitive(b"i32")}})
  run Vector<Binding>.append(&mut bindings, Binding {declaration: run Shared<DeclarationId>.make(DeclarationId.copy(&owner)),
    ordinal: usize.ONE, value: Argument.Type {value: run specializationPrimitive(b"bool")}})
  let closed = run Type.applyBindings(&original, Vector<Binding>.asSlice(&bindings), true)
  let metadata = Shared<Type>.with<Option<Shared<SectionSchema>>>(&closed, fn(value: &Type) -> Option<Shared<SectionSchema>> {
    return match &value.* { Type.CallableSchema {schema: recipe, ..} => Option<Shared<SectionSchema>>.some(Shared<SectionSchema>.clone(&recipe)) _ => Option<Shared<SectionSchema>>.none() }
  })
  if let Option<Shared<SectionSchema>>.Some {value} = move metadata {
    let correct = Shared<SectionSchema>.with<bool>(&value, fn(recipe: &SectionSchema) -> bool {
      return genericSectionOwnerMetadata(recipe, &owner)
    })
    run Testing.expect(correct && !Type.hasOpenRuntimeParameters(&closed),
      "owner monomorphization closes free evidence and storage without substituting the section's bound parameter or result")
    return ()
  }
  run Testing.expect(false, "owner substitution retains immutable generic section metadata")
}

fn genericSectionOwnerMetadata(recipe: &SectionSchema, owner: &DeclarationId) -> bool {
  let evidence = Vector<Binding>.asSlice(&recipe.selected)
  return evidence.length == usize.ONE && evidence[usize.ZERO].ordinal == usize.ONE
    && genericSectionArgument(&evidence[usize.ZERO].value, b"bool")
    && Shared<Type>.with<bool>(&recipe.contract, fn(contract: &Type) -> bool {
      return genericSectionBoundContract(contract, owner)
    })
}

fn genericSectionBoundContract(contract: &Type, owner: &DeclarationId) -> bool {
  if let Type.Callable {parameters, result, ..} = &contract.* {
    let inputs = Vector<Shared<Type>>.asSlice(&parameters)
    if inputs.length != usize.ONE { return false }
    let parameter = Shared<Type>.with<usize>(&inputs[usize.ZERO], fn(ty: &Type) -> usize {
      return Type.parameterOrdinalOf(ty, owner)
    })
    let resultOrdinal = Shared<Type>.with<usize>(&result, fn(ty: &Type) -> usize {
      return Type.parameterOrdinalOf(ty, owner)
    })
    return parameter == usize.ZERO && resultOrdinal == usize.ZERO
  }
  return false
}

