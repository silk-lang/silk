effect fn instanceRootRequest(store: &Semantic,
  original: &Shared<Result<Answer, NoRejection>>, id: &ModuleId, name: &[u8]) -> SourceInstanceRequest
! InvalidModulePath | OutOfMemoryError ? &mut Allocator {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(original, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let source = match move mirSourceApplication(function) {
        Option<Shared<SpecializationApplication>>.Some {value} => run SpecializationApplication.copyShared(&value)
        _ => { fail InvalidModulePath {} }
      }
      let declaration = SpecializationApplication.bodyDeclaration(&source)
      if !DeclarationId.named(declaration, name) || !ModuleId.equals(DeclarationId.moduleId(declaration), id) {
        fail InvalidModulePath {}
      }
      return SourceInstanceRequest {key: InstanceKey.copy(&function.key),
        sourceOwner: DeclarationId.copy(declaration), span: Span.make(usize.ZERO, usize.ZERO)}
    }
  }
  fail InvalidModulePath {}
}

effect fn sourceRootMir(store: &mut Semantic, request: &mut Request,
  original: &Shared<Result<Answer, NoRejection>>, id: &ModuleId, name: &[u8], observing: bool)
-> Shared<Result<Answer, NoRejection>>
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let source = run instanceRootRequest(&store.*, original, id, name)
  return run Semantic.demandInstanceMir(&mut store.*, &mut request.*, &source.key, &source.sourceOwner, source.span, observing)
}

// Whether the named body is accepted by proven region subtyping alone, retaining no open relation.
effect fn providedProvesRegions(store: &mut Semantic, request: &mut Request, id: &ModuleId, name: string) -> bool
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError
? &mut Allocator | &mut Types {
  let body = run Semantic.demandBody(&mut store.*, &mut request.*, id, String.utf8Bytes(name))
  return succeeded(&body) && regionRelationCount(&body) == usize.ZERO
}

test effect fn plainCallableParameterBorrowedMutableReferentKeepsAccess() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let text = """
fn invoke(callback: &mut mut fn(i32) -> i32) -> i32 { return callback.*(1) }
fn main() -> i32 {
  let mut counter = 40
  let mut change = fn(value: i32) -> i32 { counter = counter + value return counter }
  return invoke(&mut change) + 1
}
"""
  return run plainCallableParameterTargetClaims(text, CallableMode.Mutable, 2)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn plainCallableParameterReferencesRequireExplicitProjection() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
