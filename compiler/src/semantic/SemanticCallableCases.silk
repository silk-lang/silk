effect fn plainCallableProducerCallClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("plain-callable-producer-calls.silk")
  let text = """
fn inc2(value: i32) -> i32 { return value + 2 }
fn add(value: i32, offset: i32) -> i32 { return value + offset }
fn named() -> fn<'static>(i32) -> i32 { return inc2 }
fn buildSection(ignored: i32, offset: i32) -> fn<'static>(i32) -> i32 { return add(offset) }
struct Factory { offset: i32 }
impl Factory {
  fn build(self: &Factory) -> fn<'static>(i32) -> i32 { return add(self.offset) }
}
fn main() -> i32 {
  let producer = named
  let selected = producer()
  let sectionProducer = buildSection(2)
  let sectionResult = sectionProducer(0)
  let factory = Factory { offset: 2 }
  let methodResult = factory.build()
  return selected(10) + sectionResult(10) + methodResult(10) + named()(4)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let entry = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&entry) && sectionInvocationCount(&store, &entry, b"add", false) == 2,
    "stored named and section producers and an inherent method return their original direct environments")
  let section = run Semantic.demandMir(&mut store, &mut request, &id, b"buildSection")
  run Testing.expect(plainCallableMirResult(&store, &section, b"add", usize.ONE, false),
    "invoking a producer section uses the same original result storage as its definition")
}

test effect fn plainOnceCallableReturnsTransferCaptureCleanupExactlyOnce() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
