effect fn allocationAffineClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("allocation-affine.silk")
  let text = """
struct Inner { owner: Intrinsic.Allocation }
struct Outer { inner: Inner }
union Choice { Empty, Owned { owner: Intrinsic.Allocation } }
struct Box<T> { value: T }
impl<T: Intrinsic.Copy> Intrinsic.Copy for Box<T> {}
fn core(value: &Intrinsic.Allocation) -> () { drop value.* return () }
fn nested(value: &Outer) -> () { drop value.* return () }
fn array(value: &([Intrinsic.Allocation; 1])) -> () { drop value.* return () }
fn unioned(value: &Choice) -> () { drop value.* return () }
fn conditional(value: &Box<Intrinsic.Allocation>) -> () { drop value.* return () }
fn scalar(value: &i32) -> () { drop value.* return () }
fn copied(value: &Box<i32>) -> () { drop value.* return () }
fn declared<Allocation: Intrinsic.Copy>(value: &Intrinsic.Allocation) -> () { drop value.* return () }
fn accepts<T: Intrinsic.Copy>(value: T) -> () { return () }
fn applied(value: Intrinsic.Allocation) -> () { return accepts<Intrinsic.Allocation>(move value) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let core = run Semantic.demandBody(&mut store, &mut request, &id, b"core")
  let nested = run Semantic.demandBody(&mut store, &mut request, &id, b"nested")
  let array = run Semantic.demandBody(&mut store, &mut request, &id, b"array")
  let unioned = run Semantic.demandBody(&mut store, &mut request, &id, b"unioned")
  let conditional = run Semantic.demandBody(&mut store, &mut request, &id, b"conditional")
  let declared = run Semantic.demandBody(&mut store, &mut request, &id, b"declared")
  run Testing.expect(rejectsSpan(&core, RejectionCode.BorrowedExtraction, text, "value.*", usize.ZERO), "canonical Allocation is affine")
  run Testing.expect(rejectsSpan(&nested, RejectionCode.BorrowedExtraction, text, "value.*", usize.ONE), "nested source records retain affine core storage")
  run Testing.expect(rejectsSpan(&array, RejectionCode.BorrowedExtraction, text, "value.*", 2), "an array of core owners is affine")
  run Testing.expect(rejectsSpan(&unioned, RejectionCode.BorrowedExtraction, text, "value.*", 3), "a nominal union storing core is affine")
  run Testing.expect(rejectsSpan(&conditional, RejectionCode.BorrowedExtraction, text, "value.*", 4), "an instantiated conditional Copy head cannot prove Allocation Copy")
  run Testing.expect(rejectsSpan(&declared, RejectionCode.BorrowedExtraction, text, "value.*", 7), "same-spelled declared Copy premise cannot redirect or make the canonical core Copy")
  let scalar = run Semantic.demandBody(&mut store, &mut request, &id, b"scalar")
  let copied = run Semantic.demandBody(&mut store, &mut request, &id, b"copied")
  run Testing.expect(succeeded(&scalar) && succeeded(&copied), "ordinary scalar and source conditional Copy remain valid")
  let applied = run Semantic.demandBody(&mut store, &mut request, &id, b"applied")
  run Testing.expect(rejectsSpan(&applied, RejectionCode.Unsupported, text, "accepts<Intrinsic.Allocation>(move value)", usize.ZERO), "generic-call application cannot instantiate a core Copy premise")
  let invalidId = run module("allocation-invalid-copy.silk")
  let invalidText = "struct Fixed<T> { item: T owner: Intrinsic.Allocation }\nimpl<T: Intrinsic.Copy> Intrinsic.Copy for Fixed<T> {}\nfn fixed(value: &Fixed<i32>) -> () { drop value.* return () }"
  let mut invalid = run staticSemantic(&invalidId, invalidText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let fixed = run Semantic.demandBody(&mut invalid, &mut request, &invalidId, b"fixed")
  run Testing.expect(rejectsSpan(&fixed, RejectionCode.InvalidCopyConformance, invalidText, "impl<T: Intrinsic.Copy> Intrinsic.Copy for Fixed<T> {}", usize.ZERO), "a source Copy conformance cannot hide a stored core owner behind another proven field")
  let copyId = run module("allocation-source-copy.silk")
  let copyText = "impl Intrinsic.Copy for Intrinsic.Allocation {}"
  let mut copyStore = run staticSemantic(&copyId, copyText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let copyHead = run Semantic.demandImplementations(&mut copyStore, &mut request, &copyId)
  run Testing.expect(rejectsSpan(&copyHead, RejectionCode.ConformanceOwner, copyText, "impl Intrinsic.Copy for Intrinsic.Allocation {}", usize.ZERO), "source cannot implement Copy for the sealed core")
  let dropId = run module("allocation-source-drop.silk")
  let dropText = "impl Intrinsic.Drop for Intrinsic.Allocation { fn drop(self: &mut Intrinsic.Allocation) -> () { return () } }"
  let mut dropStore = run staticSemantic(&dropId, dropText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let dropHead = run Semantic.demandImplementations(&mut dropStore, &mut request, &dropId)
  run Testing.expect(rejectsSpan(&dropHead, RejectionCode.ConformanceOwner, dropText, "impl Intrinsic.Drop for Intrinsic.Allocation { fn drop(self: &mut Intrinsic.Allocation) -> () { return () } }", usize.ZERO), "source cannot install release authority on the canonical core")
}

test effect fn sealedCoreLayoutsAndCleanup() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run sealedCoreLayoutClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// Whether a layout answer is an eight-byte-aligned record of `count` fields and `size` bytes whose
// last field starts at `last`.
fn coreRecordLayout(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, count: usize, size: usize, last: usize) -> bool {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedLayoutIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<Shared<BackendLayout>>.Some {value: facts} = move Semantic.layoutAt(store, index) {
      return Shared<BackendLayout>.with<bool>(&facts, fn(layout: &BackendLayout) -> bool {
        if let LayoutStorage.Record {fields} = &layout.storage {
          let entries = Vector<LayoutField>.asSlice(&fields)
          return entries.length == count && layout.size == size && layout.alignment == 8
            && entries[usize.ZERO].offset == usize.ZERO && entries[count - usize.ONE].offset == last
        }
        return false
      })
    }
  }
  return false
}

// The sealed C allocator functions one MIR answer declares, counted when they are `wanted`.
fn sealedExterns(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, wanted: SealedFunction) -> usize {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let externs = Vector<Shared<DeclarationId>>.asSlice(&function.externs)
      let mut count = usize.ZERO
      let mut at = usize.ZERO
      while at < externs.length {
        let sealed = Shared<DeclarationId>.with<Option<SealedFunction>>(&externs[at], SealedCore.declarationFunction)
        if let Option<SealedFunction>.Some {value} = move sealed {
          if value == wanted { count = count + usize.ONE }
        }
        at = at + usize.ONE
      }
      return count
    }
  }
  return usize.MAX
}

effect fn sealedCoreLayoutClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("sealed-core-layouts.silk")
  let text = """
struct Token { value: i32 }
impl Intrinsic.Drop for Token { fn drop(self: &mut Token) -> () { return () } }
struct Inner { owner: Intrinsic.Allocation }
struct Outer { inner: Inner }
impl Intrinsic.Drop for Outer { fn drop(self: &mut Outer) -> () { return () } }
fn shapes(core: Intrinsic.Allocation, buffer: Intrinsic.RawBuffer<i32>, slot: Intrinsic.Slot<'static, i32>, shared: Intrinsic.SharedCore<i64>, guarded: Intrinsic.SharedCore<Token>, outer: Outer) -> () { return () }
struct RawBuffer {}
struct Linked { next: Intrinsic.SharedCore<Linked> | Token }
struct Full<T> { buffer: Intrinsic.RawBuffer<T> }
struct Window<'a> { slot: Intrinsic.Slot<'a, i32> }
fn fields(linked: Linked, full: Full<i32>, window: Window<'static>) -> () { return () }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let fields = run Semantic.demandSignature(&mut store, &mut request, &id, b"fields")
  run Testing.expect(succeeded(&fields),
    "a stored storage core contributes only its element types to field lifetimes, past a same-spelled source owner")
  if let Option<Shared<Type>>.Some {value: linked} = move allocationSignatureParameter(&fields, usize.ZERO) {
    let laid = run Semantic.demandLayout(&mut store, &mut request, &id, &linked)
    let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&laid, selectedLayoutIndex)
    run Testing.expect(match move selected { Option<usize>.Some {..} => true _ => false },
      "a structural union of a shared core of its container and a record is laid out")
  } else { run Testing.expect(false, "the recursive container has a checked signature type") }
  let signature = run Semantic.demandSignature(&mut store, &mut request, &id, b"shapes")
  let mut types = Vector<Shared<Type>>.make()
  let mut at = usize.ZERO
  while at < 6 {
    match move allocationSignatureParameter(&signature, at) {
      Option<Shared<Type>>.Some {value} => { run Vector<Shared<Type>>.append(&mut types, move value) }
      Option<Shared<Type>>.None => {
        run Testing.expect(false, "every sealed core shape has a checked signature type")
        return ()
      }
    }
    at = at + usize.ONE
  }
  let shapes = Vector<Shared<Type>>.asSlice(&types)
  run Testing.expect(SealedCore.isCore(&shapes[usize.ZERO], SealedKind.Allocation) && SealedCore.isCore(&shapes[usize.ONE], SealedKind.RawBuffer)
    && SealedCore.isCore(&shapes[2], SealedKind.Slot) && SealedCore.isCore(&shapes[3], SealedKind.SharedCore),
    "the storage core names resolve to their sealed identities in type position")
  let allocation = run Semantic.demandLayout(&mut store, &mut request, &id, &shapes[usize.ZERO])
  let buffer = run Semantic.demandLayout(&mut store, &mut request, &id, &shapes[usize.ONE])
  let slot = run Semantic.demandLayout(&mut store, &mut request, &id, &shapes[2])
  let shared = run Semantic.demandLayout(&mut store, &mut request, &id, &shapes[3])
  run Testing.expect(coreRecordLayout(&store, &allocation, 6, 48, 40) && coreRecordLayout(&store, &buffer, 2, 56, 48)
    && coreRecordLayout(&store, &slot, usize.ONE, 8, usize.ZERO) && coreRecordLayout(&store, &shared, usize.ONE, 8, usize.ZERO),
    "an allocation is six words, a raw buffer its allocation and count, and a slot or shared core one address")
  let sourceOwner = run glueNamedSourceOwner(&mut store, &id, b"shapes")
  let release = run Semantic.demandGlueMir(&mut store, &mut request, &shapes[usize.ZERO], &sourceOwner)
  run Testing.expect(glueFact(&store, &release, usize.ONE) == usize.ONE && sealedExterns(&store, &release, SealedFunction.Free) == usize.ONE,
    "an allocation releases its storage through one sealed free call")
  let adopted = run Semantic.demandGlueMir(&mut store, &mut request, &shapes[usize.ONE], &sourceOwner)
  run Testing.expect(glueFact(&store, &adopted, usize.ZERO) == usize.ONE && glueFact(&store, &adopted, usize.ONE) == usize.ZERO,
    "a raw buffer drops its allocation and never discovers elements")
  let counted = run Semantic.demandGlueMir(&mut store, &mut request, &shapes[3], &sourceOwner)
  let guarded = run Semantic.demandGlueMir(&mut store, &mut request, &shapes[4], &sourceOwner)
  run Testing.expect(glueFact(&store, &counted, 5) == usize.ONE && glueFact(&store, &counted, usize.ZERO) == usize.ONE
    && glueFact(&store, &guarded, usize.ZERO) == 2,
    "a shared core branches on its strong count, and the last handle drops a value needing cleanup before its allocation")
  let outer = run Semantic.demandGlueMir(&mut store, &mut request, &shapes[5], &sourceOwner)
  run Testing.expect(glueFact(&store, &outer, usize.ONE) == usize.ONE && glueFact(&store, &outer, usize.ZERO) == usize.ONE,
    "a source Drop hook runs before the nested core storage it owns is released")
}

test effect fn executionPackagesAdoptDriveAndRelease() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run executionClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn executionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("execution-packages.silk")
  let layoutId = run module("silk/layout.silk")
  let text = """
import silk.layout { Layout }
struct Counter { value: i32 }
fn packageLayout() -> Layout { return Intrinsic.executionLayout<i32, Counter, i64, i32>() }
effect fn finish() -> i32 { return 1 }
fn ready(state: &i64) -> () { return () }
fn adopt<F: once Effect<'static; i32> + Intrinsic.Detached, R: fn<'static>(&i64) -> () + Intrinsic.Detached + Intrinsic.NonParking>(
  allocation: Intrinsic.Allocation, body: F, state: i64, endpoint: R
) -> Intrinsic.Execution<i32> {
  return unsafe Intrinsic.executionFromAllocation<i32, F, i64, R>(move allocation, move body, state, move endpoint)
}
fn adoptAny<F, R>(allocation: Intrinsic.Allocation, body: F, state: i64, endpoint: R) -> Intrinsic.Execution<i32> {
  return unsafe Intrinsic.executionFromAllocation<i32, F, i64, R>(move allocation, move body, state, move endpoint)
}
fn package(allocation: Intrinsic.Allocation) -> Intrinsic.Execution<i32> { return adopt(move allocation, finish(), 7, ready) }
fn release(execution: Intrinsic.Execution<i32>) -> () {
  drop execution
  return ()
}
fn notify(execution: &mut Intrinsic.Execution<i32>) -> bool {
  let reference = Intrinsic.executionRefOf<i32>(&mut execution)
  Intrinsic.executionStore(&reference, 0, Intrinsic.executionLoad(&reference, 1))
  Intrinsic.executionNotify(&reference)
  return Intrinsic.executionLive(&reference)
}
fn completed(state: &mut i32, result: i32) -> () {
  state.* = result
  return ()
}
fn suspended(state: &mut i32, execution: Intrinsic.Execution<i32>) -> () {
  drop execution
  return ()
}
effect fn driveWith<'state, C: once fn(&'state mut i32, i32) -> (), S: once fn(&'state mut i32, Intrinsic.Execution<i32>) -> ()>(
  execution: Intrinsic.Execution<i32>,
  state: &'state mut i32,
  complete: C,
  suspend: S
) -> () {
  return run Intrinsic.executionDrive<i32, &'state mut i32, C, S>(move execution, move state, move complete, move suspend)
}
effect fn drive(execution: Intrinsic.Execution<i32>, state: &mut i32) -> () { return run driveWith(move execution, move state, completed, suspended) }
"""
  let layoutText = "pub struct Layout {\n  pub bytes: usize\n  pub alignment: usize\n}\n"
  let source = run present(text)
  let layoutSource = run present(layoutText)
  let withLayout = run Revision.publish(&Revision.make(), &layoutId, &layoutSource)
  let revision = run Revision.publish(&withLayout, &id, &source)
  let mut store = Semantic.make(move revision, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option<FinalProfile>.none())
  let mut request = Request.make()
  let packageLayout = run Semantic.demandMir(&mut store, &mut request, &id, b"packageLayout")
  let package = run Semantic.demandMir(&mut store, &mut request, &id, b"package")
  let adoption = match move sharedCallbackCalleeApplication(&store, &package, "adopt") {
    Option<Shared<SpecializationApplication>>.Some {value} => run SpecializationApplication.copyShared(&value)
    _ => { return run Testing.expect(false, "an execution package is adopted by its generic site") }
  }
  let adopted = run Semantic.demandApplicationMir(&mut store, &mut request, &adoption)
  let release = run Semantic.demandMir(&mut store, &mut request, &id, b"release")
  let adoptAny = run Semantic.demandBody(&mut store, &mut request, &id, b"adoptAny")
  run Testing.expect(rejectsWith(&adoptAny, RejectionCode.UnsatisfiedExecutableProperty),
    "a package accepts only a detached body and endpoint, even at the unsafe intrinsic (EXEC-004, SEM0139)")
  run Testing.expect(succeeded(&packageLayout) && storageFact(&store, &adopted, usize.ZERO) == usize.ONE
    && functionAddresses(&store, &adopted) == 3 && glueFact(&store, &release, usize.ZERO) == usize.ONE,
    "an execution package measures whole, adoption traps on a layout mismatch and records its start, notification and drop, and a handle drops once")
  let notified = run Semantic.demandMir(&mut store, &mut request, &id, b"notify")
  run Testing.expect(storageFact(&store, &notified, usize.ZERO) == 3 && storageFact(&store, &notified, 3) == 2,
    "a reference traps on a control word other than 0 or 1 and on notifying a dead package, then calls its erased notification and its deferred drop")
  let driven = run Semantic.demandMir(&mut store, &mut request, &id, b"drive")
  let activation = match move sharedCallbackCalleeApplication(&store, &driven, "driveWith") {
    Option<Shared<SpecializationApplication>>.Some {value} => run SpecializationApplication.copyShared(&value)
    _ => { return run Testing.expect(false, "an activation is driven by its generic site") }
  }
  let activated = run Semantic.demandApplicationMir(&mut store, &mut request, &activation)
  run Testing.expect(storageFact(&store, &activated, usize.ZERO) == usize.ONE && storageFact(&store, &activated, 3) == 4,
    "an activation traps unless the package is unstarted or relinquished, then calls its start and either its suspension callback or its completion callback and its drop")
  return ()
}

test effect fn storagePrimitivesFollowTheirContracts() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run storagePrimitiveClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// The function addresses one selected MIR function takes.
fn functionAddresses(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> usize {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut count = usize.ZERO
      let mut at = usize.ZERO
      while at < blocks.length {
        let statements = Vector<MirStatement>.asSlice(&blocks[at].statements)
        let mut step = usize.ZERO
        while step < statements.length {
          if let MirStatement.Assign {value: MirRvalue.FunctionAddress {..}, ..} = &statements[step] { count = count + usize.ONE }
          step = step + usize.ONE
        }
        at = at + usize.ONE
      }
      return count
    }
  }
  return usize.MAX
}

// Counts in one MIR answer: traps (0), calls of sealed C allocator functions (1), failure exits (2)
// or calls (3).
fn storageFact(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, fact: usize) -> usize {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut count = usize.ZERO
      let mut at = usize.ZERO
      while at < blocks.length {
        match &blocks[at].terminator {
          MirTerminator.Trap {..} => { if fact == usize.ZERO { count = count + usize.ONE } }
          MirTerminator.Call {callee, ..} => {
            if fact == 3 { count = count + usize.ONE }
            if fact == usize.ONE {
              if let MirCallee.Extern {declaration, ..} = &callee {
                let sealed = Shared<DeclarationId>.with<Option<SealedFunction>>(&declaration, SealedCore.declarationFunction)
                if let Option<SealedFunction>.Some {..} = move sealed { count = count + usize.ONE }
              }
            }
          }
          MirTerminator.Fail {..} => { if fact == 2 { count = count + usize.ONE } }
          _ => ()
        }
        at = at + usize.ONE
      }
      return count
    }
  }
  return usize.MAX
}

effect fn storagePrimitiveClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("storage-primitives.silk")
  let layoutId = run module("silk/layout.silk")
  let text = """
import silk.layout { Layout }
struct Counter { value: i32 }
fn from(allocation: Intrinsic.Allocation) -> Intrinsic.RawBuffer<i32> { return unsafe Intrinsic.rawBufferFrom<i32>(move allocation, 4) }
fn select<'a>(buffer: &'a mut Intrinsic.RawBuffer<i32>) -> Intrinsic.Slot<'a, i32> { return unsafe Intrinsic.rawBufferSlot<i32>(buffer, 0) }
fn count(buffer: &Intrinsic.RawBuffer<i32>) -> usize { return Intrinsic.rawBufferCount<i32>(buffer) }
fn view(buffer: &Intrinsic.RawBuffer<i32>) -> &[i32] { return unsafe Intrinsic.rawBufferView<i32>(buffer, 0, 1) }
fn take(slot: Intrinsic.Slot<'static, i32>) -> i32 { return unsafe Intrinsic.slotTake<i32>(move slot) }
fn address(slot: Intrinsic.Slot<'static, i32>) -> *mut i32 { return Intrinsic.slotAddress<i32>(move slot) }
fn share(allocation: Intrinsic.Allocation, value: i32) -> Intrinsic.SharedCore<i32> { return unsafe Intrinsic.sharedFromAllocation<i32>(move allocation, value) }
fn clone(core: &Intrinsic.SharedCore<i32>) -> Intrinsic.SharedCore<i32> { return Intrinsic.sharedClone<i32>(core) }
fn bump(value: &mut i32) -> i32 { return 1 }
fn busy() -> i32 { return 0 }
fn access(core: &Intrinsic.SharedCore<i32>) -> i32 { return Intrinsic.sharedWithMut<i32, i32>(core, bump, busy) }
fn swap(counter: &mut Counter) -> i32 { return Intrinsic.replace(counter.value, 2) }
fn bytes(text: string<'static>) -> &'static [u8] { return Intrinsic.stringUtf8Bytes(text) }
fn measure() -> Layout { return Intrinsic.layoutOf<i64>() }
effect fn acquire(layout: Layout) -> Intrinsic.Allocation ! Intrinsic.StorageFailure { return run Intrinsic.systemAllocationAcquire(move layout) }
fn checked(buffer: &Intrinsic.RawBuffer<i32>) -> i32 { return Intrinsic.rawBufferRead<i32>(buffer, 0) }
fn affine(buffer: &Intrinsic.RawBuffer<Counter>) -> Counter { return unsafe Intrinsic.rawBufferRead<Counter>(buffer, 0) }
fn mismatched(buffer: &Intrinsic.RawBuffer<i64>) -> usize { return Intrinsic.rawBufferCount<i32>(buffer) }
fn untyped(buffer: &Intrinsic.RawBuffer<i32>) -> usize { return Intrinsic.rawBufferCount(buffer) }
fn misused(core: &Intrinsic.SharedCore<i32>) -> i32 { return Intrinsic.sharedWithMut<i32, i32>(core, busy, busy) }
fn fixed(value: i32) -> i32 { return Intrinsic.replace(value, 2) }
struct Empty {}
struct Node { next: Intrinsic.SharedCore<Node> | Empty }
fn recursive() -> Layout { return Intrinsic.sharedLayout<Node>() }
fn forward<T, A>(core: &Intrinsic.SharedCore<T>, use: once fn(&mut T) -> A) -> A {
  return Intrinsic.sharedWithMut<T, A>(core, move use, conflict)
}
fn conflict() -> never { return conflict() }
fn inspect<T, A>(value: &mut T, use: once fn(&T) -> A) -> A { return use(&value.*) }
fn inspectImplicit<T, A>(value: &mut T, use: once fn(&T) -> A) -> A { return use(move value) }
fn read(value: &i32) -> i32 { return value.* }
fn readBool(value: &i32) -> bool { return value.* > 0 }
fn sectionAccess(core: &Intrinsic.SharedCore<i32>) -> i32 {
  return forward<i32, i32>(core, inspect<i32, i32>(read))
}
fn sectionBool(core: &Intrinsic.SharedCore<i32>) -> bool {
  return forward<i32, bool>(core, inspect<i32, bool>(readBool))
}
fn booleanUse(value: &mut i32) -> bool { return value.* > 0 }
fn neverUse(value: &mut i32) -> never { return conflict() }
fn sharedUseRejected(core: &Intrinsic.SharedCore<i32>) -> i32 {
  return Intrinsic.sharedWithMut<i32, i32>(core, read, busy)
}
fn resultRejected(core: &Intrinsic.SharedCore<i32>) -> i32 {
  return Intrinsic.sharedWithMut<i32, i32>(core, booleanUse, busy)
}
fn neverUseRejected(core: &Intrinsic.SharedCore<i32>) -> i32 {
  return Intrinsic.sharedWithMut<i32, i32>(core, neverUse, conflict)
}
struct Pair { first: i32 second: i32 }
struct Box<A> { value: A }
fn wrap<A>(value: A) -> Box<A> { return Box<A> { value: move value } }
fn fallback() -> Effect<'static; i32> { return effect { return 0 } }
fn leakEffect<'a>(value: &'a mut Pair) -> Effect<'a; i32> { return effect { return value.first } }
fn escapesEffect<'scope>(core: &'scope Intrinsic.SharedCore<Pair>) -> Effect<'scope; i32> {
  return Intrinsic.sharedWithMut<Pair, Effect<'scope; i32>>(core, leakEffect, fallback)
}
fn leakView<'a>(value: &'a mut Pair) -> &'a mut Pair { return move value }
fn viewConflict<'a>() -> &'a mut Pair { return viewConflict() }
fn escapesView<'scope>(core: &'scope Intrinsic.SharedCore<Pair>) -> &'scope mut Pair {
  return Intrinsic.sharedWithMut<Pair, &'scope mut Pair>(core, leakView, viewConflict)
}
fn leakBox<'a>(value: &'a mut Pair) -> Box<Effect<'a; i32>> {
  let escaped = effect { return value.first }
  return wrap<Effect<'a; i32>>(move escaped)
}
fn boxConflict() -> Box<Effect<'static; i32>> { return wrap<Effect<'static; i32>>(effect { return 0 }) }
fn escapesBox<'scope>(core: &'scope Intrinsic.SharedCore<Pair>) -> Box<Effect<'scope; i32>> {
  return Intrinsic.sharedWithMut<Pair, Box<Effect<'scope; i32>>>(core, leakBox, boxConflict)
}
effect fn leakRun<'a>(value: &'a mut Pair) -> i32 { return value.first }
fn escapesRun<'scope>(core: &'scope Intrinsic.SharedCore<Pair>) -> Effect<'scope; i32> {
  return Intrinsic.sharedWithMut<Pair, Effect<'scope; i32>>(core, leakRun, fallback)
}
fn copiesOut(value: &mut Pair) -> Effect<'static; i32> {
  let copied = value.first
  return effect { return copied }
}
fn keepsCopy(core: &Intrinsic.SharedCore<Pair>) -> Effect<'static; i32> {
  return Intrinsic.sharedWithMut<Pair, Effect<'static; i32>>(core, copiesOut, fallback)
}
fn independent<'a>(value: &'a mut Pair) -> i32 { return value.first }
fn numberConflict() -> i32 { return 0 }
fn keepsIndependent(core: &Intrinsic.SharedCore<Pair>) -> i32 {
  return Intrinsic.sharedWithMut<Pair, i32>(core, independent, numberConflict)
}
fn adopt<'s>(use: once fn(&mut Pair) -> Effect<'s; i32>) -> () {
  drop use
  return ()
}
fn adoptAt<'s>(marker: &'s Pair, use: once fn(&mut Pair) -> Effect<'s; i32>) -> () {
  drop use
  return ()
}
fn leakWritten<'a>(value: &'a mut Pair) -> Effect<'a; i32> { return effect { return value.first } }
fn writtenAdopt<'s>(marker: &'s Pair) -> () { return adopt<'s>(leakWritten) }
fn leakInferred<'a>(value: &'a mut Pair) -> Effect<'a; i32> { return effect { return value.first } }
fn inferredAdopt(marker: &Pair) -> () { return adoptAt(marker, leakInferred) }
fn tally<'s>(marker: &'s Pair, use: once fn(&mut Pair) -> i32) -> () {
  drop use
  return ()
}
fn independentTally(marker: &Pair) -> () { return tally(marker, independent) }
fn viewAt<'s>(marker: &'s Pair, use: once fn(&mut Pair) -> &'s mut Pair) -> () {
  drop use
  return ()
}
fn leakInferredView<'a>(value: &'a mut Pair) -> &'a mut Pair { return move value }
fn inferredView(marker: &Pair) -> () { return viewAt(marker, leakInferredView) }
"""
  let layoutText = "pub struct Layout {\n  pub bytes: usize\n  pub alignment: usize\n}\n"
  let source = run present(text)
  let layoutSource = run present(layoutText)
  let withLayout = run Revision.publish(&Revision.make(), &layoutId, &layoutSource)
  let revision = run Revision.publish(&withLayout, &id, &source)
  let mut store = Semantic.make(move revision, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu), Option<FinalProfile>.none())
  let mut request = Request.make()
  let names = ["from", "select", "count", "view", "take", "address", "share", "clone", "access", "swap", "bytes", "measure", "acquire"]
  let listed: &[string<'static>] = &names
  let mut typed = true
  let mut at = usize.ZERO
  while at < listed.length {
    let answer = run Semantic.demandBody(&mut store, &mut request, &id, String.utf8Bytes(listed[at]))
    typed = typed && succeeded(&answer)
    at = at + usize.ONE
  }
  run Testing.expect(typed, "each storage primitive types against its contract instantiated from its type arguments")
  let checked = run Semantic.demandBody(&mut store, &mut request, &id, b"checked")
  let affine = run Semantic.demandBody(&mut store, &mut request, &id, b"affine")
  let mismatched = run Semantic.demandBody(&mut store, &mut request, &id, b"mismatched")
  let untyped = run Semantic.demandBody(&mut store, &mut request, &id, b"untyped")
  let misused = run Semantic.demandBody(&mut store, &mut request, &id, b"misused")
  let fixed = run Semantic.demandBody(&mut store, &mut request, &id, b"fixed")
  run Testing.expect(rejectsSpan(&checked, RejectionCode.UnsafeAcknowledgement, text, "Intrinsic.rawBufferRead<i32>(buffer, 0)", 0),
    "an unsafe storage primitive needs an acknowledgement")
  run Testing.expect(rejectsSpan(&affine, RejectionCode.MissingConformance, text, "Intrinsic.rawBufferRead<Counter>(buffer, 0)", 0),
    "a read that leaves its storage initialized needs a Copy element")
  run Testing.expect(rejectsSpan(&mismatched, RejectionCode.TypeMismatch, text, "Intrinsic.rawBufferCount<i32>(buffer)", 1),
    "an operand must match the contract instantiated from the written type arguments")
  run Testing.expect(rejectsFrom(&untyped, RejectionCode.TypeArity, offsetOf(text, "Intrinsic.rawBufferCount(buffer)", 0)),
    "an element-generic primitive needs its written type argument")
  run Testing.expect(rejectsSpan(&misused, RejectionCode.TypeMismatch, text, "Intrinsic.sharedWithMut<i32, i32>(core, busy, busy)", 0),
    "shared access needs a use taking the value exclusively")
  run Testing.expect(rejectsSpan(&fixed, RejectionCode.ImmutableAssignment, text, "Intrinsic.replace(value, 2)", 0),
    "a replacement displaces only a mutable place")
  let implicit = run Semantic.demandBody(&mut store, &mut request, &id, b"inspectImplicit")
  run Testing.expect(rejectsSpan(&implicit, RejectionCode.TypeMismatch, text, "use(move value)", usize.ZERO),
    "an exclusive reference does not become shared by transfer; inspection requires an authored reborrow")
  let from = run Semantic.demandMir(&mut store, &mut request, &id, b"from")
  let share = run Semantic.demandMir(&mut store, &mut request, &id, b"share")
  run Testing.expect(storageFact(&store, &from, usize.ZERO) == usize.ONE && storageFact(&store, &from, 3) == usize.ZERO,
    "adopting an allocation as a raw buffer traps on a layout mismatch and calls nothing")
  run Testing.expect(storageFact(&store, &share, usize.ZERO) == usize.ONE,
    "adopting an allocation as a shared core traps on a layout mismatch")
  let acquire = run Semantic.demandMir(&mut store, &mut request, &id, b"acquire")
  run Testing.expect(storageFact(&store, &acquire, usize.ONE) == 2 && sealedExterns(&store, &acquire, SealedFunction.Malloc) == usize.ONE
    && sealedExterns(&store, &acquire, SealedFunction.Free) == usize.ONE,
    "an acquisition calls the sealed malloc once and, like the bootstrap, passes a null result to free once")
  run Testing.expect(storageFact(&store, &acquire, 2) == usize.ONE, "an acquisition refuses through one failure exit")
  let access = run Semantic.demandMir(&mut store, &mut request, &id, b"access")
  run Testing.expect(storageFact(&store, &access, 3) == 2, "shared access invokes its use or its conflict policy")
  let swap = run Semantic.demandMir(&mut store, &mut request, &id, b"swap")
  run Testing.expect(glueFact(&store, &swap, usize.ZERO) == usize.ZERO, "a replacement moves without cleanup")
  let measure = run Semantic.demandMir(&mut store, &mut request, &id, b"measure")
  run Testing.expect(succeeded(&measure), "a measured layout is a closed record value")
  let recursive = run Semantic.demandMir(&mut store, &mut request, &id, b"recursive")
  run Testing.expect(succeeded(&recursive), "a control block measures a value that stores a shared core of itself")

  let selected = run Semantic.demandMir(&mut store, &mut request, &id, b"sectionAccess")
  let selectedBool = run Semantic.demandMir(&mut store, &mut request, &id, b"sectionBool")
  let retained = run sharedCallbackMirChain(&mut store, &mut request, &id, &selected, b"i32", "read")
  let retainedBool = run sharedCallbackMirChain(&mut store, &mut request, &id, &selectedBool, b"bool", "readBool")
  run Testing.expect(succeeded(&selected) && succeeded(&selectedBool) && retained && retainedBool,
    "shared access specializes the original section result, lends the control-block value mutably, and forwards capture field zero to the original callback parameter one")
  let sharedUse = run Semantic.demandBody(&mut store, &mut request, &id, b"sharedUseRejected")
  let wrongResult = run Semantic.demandBody(&mut store, &mut request, &id, b"resultRejected")
  let neverUse = run Semantic.demandBody(&mut store, &mut request, &id, b"neverUseRejected")
  run Testing.expect(rejectsSpan(&sharedUse, RejectionCode.TypeMismatch, text,
    "Intrinsic.sharedWithMut<i32, i32>(core, read, busy)", usize.ZERO),
    "a shared callback input cannot replace the required exclusive storage loan")
  run Testing.expect(rejectsSpan(&wrongResult, RejectionCode.TypeMismatch, text,
    "Intrinsic.sharedWithMut<i32, i32>(core, booleanUse, busy)", usize.ZERO),
    "a concrete callback result must satisfy the storage primitive's promised result")
  run Testing.expect(rejectsSpan(&neverUse, RejectionCode.TypeMismatch, text,
    "Intrinsic.sharedWithMut<i32, i32>(core, neverUse, conflict)", usize.ZERO),
    "never is admitted only for the conflict policy, not as the use callback's result")
  // The use callback's input lives for one invocation (LIFE-004), so a result that depends on it is
  // an incompatible callable (CALLABLE-001) at the callback, before any escape exists (SHARED-003).
  let resultEscape = RejectionCode.IncompatibleCallableSignature
  let effectEscape = run Semantic.demandBody(&mut store, &mut request, &id, b"escapesEffect")
  let viewEscape = run Semantic.demandBody(&mut store, &mut request, &id, b"escapesView")
  let boxEscape = run Semantic.demandBody(&mut store, &mut request, &id, b"escapesBox")
  run Testing.expect(rejectsSpan(&effectEscape, resultEscape, text, "leakEffect", usize.ONE)
    && rejectsSpan(&viewEscape, resultEscape, text, "leakView", usize.ONE)
    && rejectsSpan(&boxEscape, resultEscape, text, "leakBox", usize.ONE),
    "an Effect, a view or an aggregate that retains the access input cannot be the access result")
  let runEscape = run Semantic.demandBody(&mut store, &mut request, &id, b"escapesRun")
  run Testing.expect(rejectsSpan(&runEscape, resultEscape, text, "leakRun", usize.ONE),
    "an effect fn callback stores its input in the Effect it constructs")
  let copy = run Semantic.demandBody(&mut store, &mut request, &id, b"keepsCopy")
  run Testing.expect(rejectsSpan(&copy, RejectionCode.Unsupported, text, "copiesOut", usize.ONE),
    "an Effect that only copies out of the access is no escape; its lifetime-generic Effect-valued deferral stays the named gap")
  let keeps = run Semantic.demandBody(&mut store, &mut request, &id, b"keepsIndependent")
  run Testing.expect(succeeded(&keeps), "a callback whose result does not mention its input's lifetime is the access result")
  let written = run Semantic.demandBody(&mut store, &mut request, &id, b"writtenAdopt")
  let inferredUse = run Semantic.demandBody(&mut store, &mut request, &id, b"inferredAdopt")
  let independentUse = run Semantic.demandBody(&mut store, &mut request, &id, b"independentTally")
  run Testing.expect(rejectsSpan(&written, RejectionCode.IncompatibleCallableSignature, text, "leakWritten", usize.ONE),
    "against a written quantified parameter, a result retaining the invocation input is an incompatible callable")
  run Testing.expect(rejectsSpan(&inferredUse, RejectionCode.UnsatisfiedLifetimeBound, text, "adoptAt(marker, leakInferred)", usize.ZERO),
    "against a parameter the call infers, it is the call's unsatisfied lifetime relation (LIFE-002)")
  run Testing.expect(succeeded(&independentUse), "a callback whose result is independent of its input satisfies the parameter")
  let inferredView = run Semantic.demandBody(&mut store, &mut request, &id, b"inferredView")
  run Testing.expect(rejectsSpan(&inferredView, RejectionCode.TypeArgumentInference, text, "viewAt(marker, leakInferredView)", usize.ZERO),
    "a returned view of the input is still the call's failed inference, as before")
}

// Follow the actual wrapper edge: demanding only the generic source body would not exercise
// the storage plan prepared for a captured section's concrete result and original application.
effect fn sharedCallbackMirChain(store: &mut Semantic, request: &mut Request, id: &ModuleId,
  entry: &Shared<Result<Answer, NoRejection>>, primitive: &[u8], reader: string) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  let forward = match move sharedCallbackCalleeApplication(&store.*, entry, "forward") {
    Option<Shared<SpecializationApplication>>.Some {value} => run SpecializationApplication.copyShared(&value)
    _ => { return false }
  }
  if !sharedCallbackApplication(&forward, id, b"forward", primitive) { return false }
  let invoked = run Semantic.demandApplicationMir(&mut store.*, &mut request.*, &forward)
  if !sharedCallbackStorageMir(&store.*, &invoked, id, primitive, String.utf8Bytes(reader)) { return false }
  let section = match move sharedCallbackCalleeApplication(&store.*, &invoked, "inspect") {
    Option<Shared<SpecializationApplication>>.Some {value} => run SpecializationApplication.copyShared(&value)
    _ => { return false }
  }
  if !sharedCallbackApplication(&section, id, b"inspect", primitive) { return false }
  let inspected = run Semantic.demandApplicationMir(&mut store.*, &mut request.*, &section)
  if !sharedCallbackInspectMir(&store.*, &inspected, id, primitive, String.utf8Bytes(reader)) { return false }
  let selected = match move sharedCallbackCalleeApplication(&store.*, &inspected, reader) {
    Option<Shared<SpecializationApplication>>.Some {value} => run SpecializationApplication.copyShared(&value)
    _ => { return false }
  }
  if !sharedCallbackTarget(SpecializationApplication.bodyDeclaration(&selected), id, String.utf8Bytes(reader)) { return false }
  let read = run Semantic.demandApplicationMir(&mut store.*, &mut request.*, &selected)
  return sharedCallbackReadMir(&store.*, &read, primitive)
}

fn sharedCallbackApplication(value: &SpecializationApplication, id: &ModuleId, name: &[u8], primitive: &[u8]) -> bool {
  if !sharedCallbackTarget(SpecializationApplication.bodyDeclaration(value), id, name) { return false }
  let supplied = Vector<Argument>.asSlice(&value.arguments)
  let ordinals = Vector<usize>.asSlice(&value.argumentOrdinals)
  if supplied.length != ordinals.length { return false }
  let mut element = usize.ZERO
  let mut result = usize.ZERO
  let mut at = usize.ZERO
  while at < supplied.length {
    if ordinals[at] == usize.ZERO {
      if !genericSectionArgument(&supplied[at], b"i32") { return false }
      element = element + usize.ONE
    }
    if ordinals[at] == usize.ONE {
      if !genericSectionArgument(&supplied[at], primitive) { return false }
      result = result + usize.ONE
    }
    at = at + usize.ONE
  }
  return element == usize.ONE && result == usize.ONE
}

fn sharedCallbackCalleeApplication(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, name: string)
  -> Option<Shared<SpecializationApplication>> {
  let selected = providedCallee(store, answer, name)
  if let Option<InstanceKey>.Some {value} = move selected { return InstanceKey.application(&value) }
  return Option<Shared<SpecializationApplication>>.none()
}

fn sharedCallbackStorageMir(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, id: &ModuleId,
  primitive: &[u8], reader: &[u8]) -> bool {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      if !Shared<Type>.with<bool>(&function.result, fn(value: &Type) -> bool { return witnessPrimitive(value, primitive) }) { return false }
      let locals = Vector<MirLocal>.asSlice(&function.locals)
      let mut captured = false
      let mut local = usize.ZERO
      while local < locals.length {
        if let MirLocalKind.Parameter {index: parameter} = &locals[local].kind {
          if parameter == usize.ONE {
            captured = Shared<Type>.with<bool>(&locals[local].ty, fn(value: &Type) -> bool {
              return sharedCallbackSection(value, id, primitive, reader)
            })
          }
        }
        local = local + usize.ONE
      }
      if !captured { return false }
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut uses = usize.ZERO
      let mut policies = usize.ZERO
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, arguments, destination, normal, failure, ..} = &blocks[at].terminator {
          let application = InstanceKey.application(&key)
          if let Option<Shared<SpecializationApplication>>.Some {value} = move application {
            let inspect = Shared<SpecializationApplication>.with<bool>(&value, fn(call: &SpecializationApplication) -> bool {
              return sharedCallbackApplication(call, id, b"inspect", primitive)
            })
            let conflict = Shared<SpecializationApplication>.with<bool>(&value, fn(call: &SpecializationApplication) -> bool {
              return sharedCallbackTarget(SpecializationApplication.bodyDeclaration(call), id, b"conflict")
            })
            let inputs = Vector<MirOperand>.asSlice(&arguments)
            if inspect {
              if inputs.length != 2 || destination.local >= locals.length { return false }
              if !Shared<Type>.with<bool>(&locals[destination.local].ty, fn(value: &Type) -> bool { return witnessPrimitive(value, primitive) }) { return false }
              if !sharedCallbackLoan(function, &inputs[usize.ZERO]) || !sharedCallbackCapture(function, &inputs[usize.ONE]) { return false }
              uses = uses + usize.ONE
            }
            if conflict {
              if inputs.length != usize.ZERO || destination.local >= locals.length || normal >= blocks.length { return false }
              if !Shared<Type>.with<bool>(&locals[destination.local].ty, Type.isNever) { return false }
              if Vector<MirStatement>.length(&blocks[normal].statements) != usize.ZERO { return false }
              if !sharedCallbackUnreachable(&blocks[normal]) { return false }
              if let Option<MirFailureEdge>.Some {..} = &failure { return false }
              policies = policies + usize.ONE
            }
          }
        }
        at = at + usize.ONE
      }
      return uses == usize.ONE && policies == usize.ONE
    }
  }
  return false
}

fn sharedCallbackSection(value: &Type, id: &ModuleId, primitive: &[u8], reader: &[u8]) -> bool {
  if let Type.CallableSchema {schema, captures, fieldInputs, ..} = &value.* {
    let fields = Vector<Shared<Type>>.asSlice(&captures)
    let slots = Vector<CallableFieldInput>.asSlice(&fieldInputs)
    if fields.length != usize.ONE || slots.length != usize.ONE { return false }
    if let CallableFieldInput.Argument {parameter} = &slots[usize.ZERO] {
      if parameter != usize.ONE { return false }
    } else { return false }
    let selected = Shared<SectionSchema>.with<bool>(&schema, fn(recipe: &SectionSchema) -> bool {
      return sharedCallbackSchemaSelected(recipe, id, primitive)
    })
    return selected && Shared<Type>.with<bool>(&fields[usize.ZERO], fn(capture: &Type) -> bool {
      return sharedCallbackReader(capture, id, reader)
    })
  }
  return false
}

fn sharedCallbackUnreachable(value: &MirBlock) -> bool {
  return match &value.terminator { MirTerminator.Unreachable {..} => true _ => false }
}

fn sharedCallbackReader(value: &Type, id: &ModuleId, reader: &[u8]) -> bool {
  return match &value.* {
    Type.CallableSchema {schema, captures, fieldInputs, ..} => Vector<Shared<Type>>.length(&captures) == usize.ZERO
      && Vector<CallableFieldInput>.length(&fieldInputs) == usize.ZERO
      && Shared<SectionSchema>.with<bool>(&schema, fn(recipe: &SectionSchema) -> bool {
        return sharedCallbackSchemaTarget(recipe, id, reader)
      })
    Type.CallableValue {application, captures, fieldInputs, ..} => Vector<Shared<Type>>.length(&captures) == usize.ZERO
      && Vector<CallableFieldInput>.length(&fieldInputs) == usize.ZERO
      && Shared<SpecializationApplication>.with<bool>(&application, fn(call: &SpecializationApplication) -> bool {
        return sharedCallbackTarget(SpecializationApplication.bodyDeclaration(call), id, reader)
      })
    _ => false
  }
}

// A descriptor may be snapshotted before storage expansion. Only unprojected copies/moves
// retain the original parameter identity; a same-typed unrelated local cannot establish it.
fn sharedCallbackParameter(function: &MirFunction, start: usize, parameter: usize) -> bool {
  let locals = Vector<MirLocal>.asSlice(&function.locals)
  let blocks = Vector<MirBlock>.asSlice(&function.blocks)
  let mut local = start
  let mut steps = usize.ZERO
  while local < locals.length && steps < locals.length {
    if let MirLocalKind.Parameter {index} = &locals[local].kind { return index == parameter }
    let mut source = usize.MAX
    let mut assignments = usize.ZERO
    let mut at = usize.ZERO
    while at < blocks.length {
      let statements = Vector<MirStatement>.asSlice(&blocks[at].statements)
      let mut item = usize.ZERO
      while item < statements.length {
        if let MirStatement.Assign {destination, value: MirRvalue.Use {value}, ..} = &statements[item] {
          if destination.local == local && Vector<MirProjection>.length(&destination.projections) == usize.ZERO {
            match &value {
              MirOperand.Copy {place} => { if Vector<MirProjection>.length(&place.projections) == usize.ZERO { source = place.local
                  assignments = assignments + usize.ONE } }
              MirOperand.Move {place} => { if Vector<MirProjection>.length(&place.projections) == usize.ZERO { source = place.local
                  assignments = assignments + usize.ONE } }
              _ => ()
            }
          }
        }
        item = item + usize.ONE
      }
      at = at + usize.ONE
    }
    if assignments != usize.ONE { return false }
    local = source
    steps = steps + usize.ONE
  }
  return false
}

fn sharedCallbackCapture(function: &MirFunction, value: &MirOperand) -> bool {
  return match &value.* {
    MirOperand.Copy {place} => sharedCallbackCapturePlace(function, &place)
    MirOperand.Move {place} => sharedCallbackCapturePlace(function, &place)
    _ => false
  }
}

fn sharedCallbackCapturePlace(function: &MirFunction, value: &MirPlace) -> bool {
  let projections = Vector<MirProjection>.asSlice(&value.projections)
  if projections.length != usize.ONE { return false }
  if let MirProjection.Field {index} = &projections[usize.ZERO] {
    return index == usize.ZERO && sharedCallbackParameter(function, value.local, usize.ONE)
  }
  return false
}

fn sharedCallbackLoan(function: &MirFunction, value: &MirOperand) -> bool {
  if let MirOperand.Copy {place} = &value.* {
    let locals = Vector<MirLocal>.asSlice(&function.locals)
    if place.local >= locals.length || Vector<MirProjection>.length(&place.projections) != usize.ZERO { return false }
    if !Shared<Type>.with<bool>(&locals[place.local].ty, sharedCallbackMutableI32) { return false }
    let blocks = Vector<MirBlock>.asSlice(&function.blocks)
    let mut at = usize.ZERO
    while at < blocks.length {
      let statements = Vector<MirStatement>.asSlice(&blocks[at].statements)
      let mut item = usize.ZERO
      while item < statements.length {
        if let MirStatement.Assign {destination, value: MirRvalue.Ref {access, place: source}, ..} = &statements[item] {
          if destination.local == place.local && access == Access.Mutable {
            let projections = Vector<MirProjection>.asSlice(&source.projections)
            if projections.length != 2 || !mirProjectionIsDeref(&projections[usize.ZERO]) { return false }
            if let MirProjection.Field {index} = &projections[usize.ONE] {
              return index == SealedCore.ordinal(SealedField.BlockValue) && sharedCallbackControlBlock(function, source.local)
            }
            return false
          }
        }
        item = item + usize.ONE
      }
      at = at + usize.ONE
    }
  }
  return false
}

fn sharedCallbackControlBlock(function: &MirFunction, local: usize) -> bool {
  let blocks = Vector<MirBlock>.asSlice(&function.blocks)
  let mut at = usize.ZERO
  while at < blocks.length {
    let statements = Vector<MirStatement>.asSlice(&blocks[at].statements)
    let mut item = usize.ZERO
    while item < statements.length {
      if let MirStatement.Assign {destination, value: MirRvalue.Use {value: MirOperand.Copy {place}}, ..} = &statements[item] {
        if destination.local == local {
          let projections = Vector<MirProjection>.asSlice(&place.projections)
          if projections.length != 2 || !mirProjectionIsDeref(&projections[usize.ZERO]) { return false }
          if let MirProjection.Field {index} = &projections[usize.ONE] {
            return index == SealedCore.ordinal(SealedField.CoreBlock) && sharedCallbackParameter(function, place.local, usize.ZERO)
          }
          return false
        }
      }
      item = item + usize.ONE
    }
    at = at + usize.ONE
  }
  return false
}

fn sharedCallbackI32(value: &Type) -> bool { return witnessPrimitive(value, b"i32") }

fn sharedCallbackMutableI32(value: &Type) -> bool {
  if let Type.Reference {referent, access, ..} = &value.* {
    return access == Access.Mutable && Shared<Type>.with<bool>(&referent, sharedCallbackI32)
  }
  return false
}

fn sharedCallbackInspectMir(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, id: &ModuleId,
  primitive: &[u8], reader: &[u8]) -> bool {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      if !Shared<Type>.with<bool>(&function.result, fn(value: &Type) -> bool { return witnessPrimitive(value, primitive) }) { return false }
      let locals = Vector<MirLocal>.asSlice(&function.locals)
      let mut captured = false
      let mut lent = false
      let mut local = usize.ZERO
      while local < locals.length {
        if let MirLocalKind.Parameter {index: parameter} = &locals[local].kind {
          if parameter == usize.ZERO { lent = Shared<Type>.with<bool>(&locals[local].ty, sharedCallbackMutableI32) }
          if parameter == usize.ONE {
            captured = Shared<Type>.with<bool>(&locals[local].ty, fn(value: &Type) -> bool {
              return sharedCallbackReader(value, id, reader)
            })
          }
        }
        local = local + usize.ONE
      }
      if !lent || !captured { return false }
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, arguments, ..} = &blocks[at].terminator {
          let identity = InstanceKey.identity(&key)
          let target = Shared<DeclarationId>.with<bool>(&identity, fn(value: &DeclarationId) -> bool {
            return sharedCallbackTarget(value, id, reader)
          })
          if target {
            let inputs = Vector<MirOperand>.asSlice(&arguments)
            if inputs.length != usize.ONE { return false }
            return sharedCallbackReaderOperand(function, &inputs[usize.ZERO])
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}

fn sharedCallbackReaderOperand(function: &MirFunction, value: &MirOperand) -> bool {
  return match &value.* {
    MirOperand.Copy {place} => sharedCallbackReaderPlace(function, &place)
    MirOperand.Move {place} => sharedCallbackReaderPlace(function, &place)
    _ => false
  }
}

fn sharedCallbackReaderPlace(function: &MirFunction, value: &MirPlace) -> bool {
  if Vector<MirProjection>.length(&value.projections) != usize.ZERO { return false }
  if sharedCallbackParameter(function, value.local, usize.ZERO) { return true }
  // A shared reborrow may adapt the lent exclusive descriptor without changing its source.
  let blocks = Vector<MirBlock>.asSlice(&function.blocks)
  let mut at = usize.ZERO
  while at < blocks.length {
    let statements = Vector<MirStatement>.asSlice(&blocks[at].statements)
    let mut item = usize.ZERO
    while item < statements.length {
      if let MirStatement.Assign {destination, value: MirRvalue.Ref {access, place}, ..} = &statements[item] {
        if destination.local == value.local && access == Access.Shared {
          let projections = Vector<MirProjection>.asSlice(&place.projections)
          return projections.length == usize.ONE && mirProjectionIsDeref(&projections[usize.ZERO])
            && sharedCallbackParameter(function, place.local, usize.ZERO)
        }
      }
      item = item + usize.ONE
    }
    at = at + usize.ONE
  }
  return false
}

fn sharedCallbackReadMir(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, primitive: &[u8]) -> bool {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      if !Shared<Type>.with<bool>(&function.result, fn(value: &Type) -> bool { return witnessPrimitive(value, primitive) }) { return false }
      let locals = Vector<MirLocal>.asSlice(&function.locals)
      let mut at = usize.ZERO
      while at < locals.length {
        if let MirLocalKind.Parameter {index: parameter} = &locals[at].kind {
          if parameter == usize.ZERO { return Shared<Type>.with<bool>(&locals[at].ty, sharedCallbackSharedI32) }
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}

fn sharedCallbackSharedI32(value: &Type) -> bool {
  if let Type.Reference {referent, access, ..} = &value.* {
    return access == Access.Shared && Shared<Type>.with<bool>(&referent, sharedCallbackI32)
  }
  return false
}

// A callable bound whose environment is omitted elides a declaration lifetime that each call
// infers from its argument, so a closure over caller locals satisfies the bound for that call.
test effect fn callableBoundsAdmitClosuresOverCallerLocals() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run callableBoundClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn callableBoundClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("callable-bound-environment.silk")
  let text = """
fn apply<T, F: once fn(&mut T) -> () + Intrinsic.NonParking>(value: &mut T, use: F) -> () { return use(move value) }
fn applyBare<T, F: once fn(&mut T) -> ()>(value: &mut T, use: F) -> () { return use(move value) }
fn captured() -> i32 {
  let mut first = 1
  let mut completed = 0
  apply(&mut first, fn(entry: &mut i32) -> () {
      completed = entry.*
      return ()
    })
  return completed
}
fn bare() -> i32 {
  let mut first = 1
  let mut completed = 0
  applyBare(&mut first, fn(entry: &mut i32) -> () {
      completed = entry.*
      return ()
    })
  return completed
}
fn closed() -> i32 {
  let mut first = 1
  apply(&mut first, fn(entry: &mut i32) -> () { return () })
  return first
}
effect fn effectful() -> i32 {
  let mut first = 1
  let mut completed = 0
  apply(&mut first, fn(entry: &mut i32) -> () {
      completed = entry.*
      return ()
    })
  return completed
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let captured = run Semantic.demandBody(&mut store, &mut request, &id, b"captured")
  let bare = run Semantic.demandBody(&mut store, &mut request, &id, b"bare")
  let closed = run Semantic.demandBody(&mut store, &mut request, &id, b"closed")
  let effectful = run Semantic.demandBody(&mut store, &mut request, &id, b"effectful")
  run Testing.expect(succeeded(&captured) && succeeded(&bare),
    "a closure over caller locals satisfies an omitted bound environment, with or without a property bound")
  run Testing.expect(succeeded(&closed), "a closure that captures nothing satisfies the same bound")
  run Testing.expect(succeeded(&effectful), "an effect fn caller infers the environment the same way")
}

test effect fn neverAtExpectedValueBoundary() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run neverExpectedValueClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn neverExpectedValueClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("never-expected-value.silk")
  let text = """
struct StopError {}
effect fn stop() -> never ! StopError { fail StopError {} }
effect fn work() -> i32 ! StopError { return run stop() }
effect fn wrong() -> i32 ! StopError { return true }
fn one(value: i32) -> i32 { return value }
fn operand() -> i32 { return one(match 1 { _ => { return 17 } }) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let work = run Semantic.demandBody(&mut store, &mut request, &id, b"work")
  let body = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&work, checkedBody)
  let mut retainedNever = false
  if let Option<Shared<TypedBody>>.Some {value} = move body {
    retainedNever = Shared<TypedBody>.with<bool>(&value, fn(body: &TypedBody) -> bool {
      let nodes = TypedBody.nodeSlice(body)
      let mut at = usize.ZERO
      while at < nodes.length {
        if let BodyNodeKind.Expression {ty, form: BodyExpression.Run {..}} = &nodes[at].kind {
          return Shared<Type>.with<bool>(&ty, Type.isNever)
        }
        at = at + usize.ONE
      }
      return false
    })
  }
  run Testing.expect(retainedNever, "a diverging run satisfies expected i32 without changing its never type")
  let lowered = run Semantic.demandMir(&mut store, &mut request, &id, b"work")
  let index = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&lowered, selectedMirIndex)
  let mut unreachableReturn = false
  if let Option<usize>.Some {value: ordinal} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, ordinal) {
      unreachableReturn = neverCallContinuesUnreachable(function)
    }
  }
  run Testing.expect(unreachableReturn, "the normal continuation of a call producing never is unreachable and carries no result")
  let operand = run Semantic.demandMir(&mut store, &mut request, &id, b"operand")
  run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&operand, pipelineHasMir),
    "a diverging call operand satisfies its parameter and lowers")
  let wrong = run Semantic.demandBody(&mut store, &mut request, &id, b"wrong")
  run Testing.expect(rejectsSpan(&wrong, RejectionCode.ReturnTypeMismatch, text, "true", usize.ZERO),
    "an ordinary incompatible result keeps TypeMismatch at the exact authored value")
}

// A failure whose borrowed payload carries a call's loan region meets the declared union member it
// differs from only in covariant regions, as it meets that member declared alone (UNION-001), whether
// it is failed directly or propagated by `run`.
test effect fn failurePayloadMeetsItsUnionMemberByRegion() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run failureRegionClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn failureRegionClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("failure-union-regions.silk")
  let text = """
pub struct Other {}
pub struct Parser { pub value: i32 }
pub struct Conn { pub parser: Parser }
pub struct Exchange { pub connection: Conn }
pub struct View<'a> { pub data: &'a i32 }
fn head(parser: &Parser) -> View { return View { data: &parser.value } }
effect fn begin<'head>(exchange: &'head mut Exchange) -> i32 ! View<'head> | Other {
  let view = head(&exchange.connection.parser)
  fail move view
}
effect fn foreign<'head>(exchange: &'head mut Exchange) -> i32 ! View<'head> | Other {
  fail Parser { value: 1 }
}
effect fn decode<'h>(view: View<'h>) -> i32 ! View<'h> { fail move view }
effect fn relay<'head>(exchange: &'head mut Exchange) -> i32 ! View<'head> | Other {
  let view = head(&exchange.connection.parser)
  return run decode(move view)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let begin = run Semantic.demandBody(&mut store, &mut request, &id, b"begin")
  let foreign = run Semantic.demandBody(&mut store, &mut request, &id, b"foreign")
  let relay = run Semantic.demandBody(&mut store, &mut request, &id, b"relay")
  run Testing.expect(succeeded(&begin) && rejectsSpan(&foreign, RejectionCode.UndeclaredFailure, text, "Parser { value: 1 }", 0),
    "a payload differing from one union member only in regions is injected as it, and an unrelated payload stays undeclared")
  run Testing.expect(succeeded(&relay), "a run failure differing from one declared member only in regions is covered by it")
  return ()
}

// Whether the one call's normal continuation is an empty unreachable block.
fn neverCallContinuesUnreachable(function: &MirFunction) -> bool {
  let blocks = Vector<MirBlock>.asSlice(&function.blocks)
  let mut continuation = usize.MAX
  let mut at = usize.ZERO
  while at < blocks.length && continuation == usize.MAX {
    if let MirTerminator.Call {normal, ..} = &blocks[at].terminator { continuation = normal }
    at = at + usize.ONE
  }
  if continuation == usize.MAX || Vector<MirStatement>.length(&blocks[continuation].statements) != usize.ZERO { return false }
  return match &blocks[continuation].terminator { MirTerminator.Unreachable {..} => true _ => false }
}

test effect fn effectBlockChannelsAreDerivedAndChecked() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run effectBlockChannelClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn effectBlockChannelClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("effect-block-channels.silk")
  let text = """
struct Missing { code: i32 }
struct Token { value: i32 }
impl Intrinsic.Drop for Token { fn drop(self: &mut Token) -> () { return () } }
effect fn plain() -> i32 ! Missing {
  let pending = effect {
    let inner = fn() -> i32 { fail Missing { code: 1 } }
    return inner()
  }
  return run pending
}
fn leaks() -> i32 {
  let pending = effect { fail Missing { code: 2 } }
  return run pending
}
fn falls(flag: bool) -> i32 {
  let pending = effect { if flag { return 1 } }
  return run pending
}
fn narrower() -> Effect<u8 ! Missing> { return effect { return 1 } }
fn wrong() -> Effect<bool> { return effect { return 7 } }
fn undeclared() -> Effect<i32> { return effect { fail Missing { code: 3 } } }
effect fn owned(code: i32) -> i32 ! Missing {
  let token = Token { value: code }
  let pending = effect {
    if code > 0 { fail Missing { code: code } }
    let held = move token
    return held.value
  }
  return run pending
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let plain = run Semantic.demandBody(&mut store, &mut request, &id, b"plain")
  let leaks = run Semantic.demandBody(&mut store, &mut request, &id, b"leaks")
  let falls = run Semantic.demandBody(&mut store, &mut request, &id, b"falls")
  let closing = offsetOf(text, "{ if flag { return 1 } }", 0) + String.utf8Bytes("{ if flag { return 1 } }").length - usize.ONE
  run Testing.expect(rejectsSpan(&plain, RejectionCode.FailOutsideEffect, text, "fail Missing { code: 1 }", 0)
    && rejectsSpan(&leaks, RejectionCode.UnhandledFailure, text, "run pending", 1)
    && rejectsSpan(&falls, RejectionCode.MissingReturn, text, "}", countBefore(text, closing)),
    "a plain closure in a block has no failure channel, a derived failure must be handled, and a returning block cannot fall through")
  let narrower = run Semantic.demandBody(&mut store, &mut request, &id, b"narrower")
  let wrong = run Semantic.demandBody(&mut store, &mut request, &id, b"wrong")
  let undeclared = run Semantic.demandBody(&mut store, &mut request, &id, b"undeclared")
  run Testing.expect(succeeded(&narrower)
    && rejectsSpan(&wrong, RejectionCode.ReturnTypeMismatch, text, "7", 0)
    && rejectsSpan(&undeclared, RejectionCode.UndeclaredFailure, text, "Missing { code: 3 }", 0),
    "a closed expected Effect supplies a block's channels: a converted block is stored behind it, a return outside its success is a mismatch at the value, and an undeclared failure is reported at its site")
  let owned = run Semantic.demandMir(&mut store, &mut request, &id, b"owned")
  let runner = effectBlockApplication(&store, &owned)
  if let Option<Shared<SpecializationApplication>>.Some {value} = move runner {
    let application = run SpecializationApplication.copyShared(&value)
    let instance = run Semantic.demandApplicationMir(&mut store, &mut request, &application)
    run Testing.expect(failDrops(&store, &instance), "a block's failure exit drops the captured owner it has not moved")
  } else {
    run Testing.expect(false, "the owned block's run references its instance")
  }
}

// How many times `}` occurs before byte `end` in `text`.
fn countBefore(text: string, end: usize) -> usize {
  let bytes = String.utf8Bytes(text)
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < end && at < bytes.length {
    if bytes[at] == 125 { count = count + usize.ONE }
    at = at + usize.ONE
  }
  return count
}

// Whether some `Fail` exit drops a value before failing.
