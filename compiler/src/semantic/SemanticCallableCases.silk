    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn plainCallableAffineArgumentClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("plain-callable-affine-argument.silk")
  let text = """
struct Token { value: i32 }
impl Intrinsic.Drop for Token { fn drop(self: &mut Token) -> () { return () } }
fn consume(callback: once fn<'static>() -> i32) -> i32 { return callback() }
fn bounded<F: once fn<'static>() -> i32>(callback: F) -> i32 { return callback() }
fn plain(token: Token) -> i32 {
  let plainTake = fn() -> i32 { let owned = move token return owned.value }
  let first = consume(plainTake)
  return first + plainTake()
}
fn constrained(token: Token) -> i32 {
  let boundTake = fn() -> i32 { let owned = move token return owned.value }
  let first = bounded(boundTake)
  return first + boundTake()
}
fn borrowed(borrowedTake: &mut once fn<'static>() -> i32) -> i32 {
  return consume(borrowedTake.*)
}
fn invokeMutable(borrowedMut: &mut mut fn<'static>() -> i32) -> i32 { return borrowedMut.*() }
fn descriptor(savedMutable: &mut mut fn<'static>() -> i32) -> i32 {
  return invokeMutable(savedMutable)
}
effect fn bump(counter: &mut i32) -> i32 { counter.* = counter.* + 1 return counter.* }
effect fn spend(token: Token) -> i32 { return token.value }
effect fn runOnce<'env>(pending: once Effect<'env; i32>) -> i32 { return run move pending }
fn lent() -> i32 { let mut count = 1 let lentEffect = bump(&mut count) return run runOnce(lentEffect) }
fn spent(token: Token) -> i32 { let spentEffect = spend(move token) return run runOnce(spentEffect) }
fn lentMutably() -> i32 { let mut count = 1 let mut reused = bump(&mut count) let first = run runOnce(reused) return first + run reused }
effect fn again<'env>(mut pending: mut Effect<'env; i32>, remaining: usize) -> i32 {
  if remaining == 0 { return run pending }
  let first = run runOnce(pending)
  return first + run again(pending, remaining - 1)
}
effect fn immutableLender<'env>(fixed: mut Effect<'env; i32>) -> i32 { return run runOnce(fixed) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let plain = run Semantic.demandBody(&mut store, &mut request, &id, b"plain")
  let bound = run Semantic.demandBody(&mut store, &mut request, &id, b"constrained")
  let borrowed = run Semantic.demandBody(&mut store, &mut request, &id, b"borrowed")
  let descriptor = run Semantic.demandBody(&mut store, &mut request, &id, b"descriptor")
  run Testing.expect(
    rejectsSpan(&plain, RejectionCode.ExplicitMoveRequired, text, "plainTake", usize.ONE)
      && rejectsSpan(&bound, RejectionCode.ExplicitMoveRequired, text, "boundTake", usize.ONE),
    "plain and constrained arguments require an explicit transfer of an affine environment",
  )
  run Testing.expect(
    rejectsSpan(&borrowed, RejectionCode.BorrowedExtraction, text, "borrowedTake.*", usize.ZERO),
    "a borrowed callable projection cannot copy an affine environment into an owned parameter",
  )
  run Testing.expect(
    rejectsSpan(&descriptor, RejectionCode.ExplicitMoveRequired, text, "savedMutable", usize.ONE),
    "a saved mutable callable reference descriptor also requires an explicit transfer",
  )
  let lent = run Semantic.demandBody(&mut store, &mut request, &id, b"lent")
  let spent = run Semantic.demandBody(&mut store, &mut request, &id, b"spent")
  run Testing.expect(
    rejectsSpan(&lent, RejectionCode.ExclusiveBorrowRequiresMutable, text, "lentEffect", usize.ONE)
      && rejectsSpan(&spent, RejectionCode.ExplicitMoveRequired, text, "spentEffect", usize.ONE),
    "a mutable-access Effect place passed by value is lent from a mutable root; a once one needs a move",
  )
  let lentMutably = run Semantic.demandBody(&mut store, &mut request, &id, b"lentMutably")
  let again = run Semantic.demandBody(&mut store, &mut request, &id, b"again")
  let immutableLender = run Semantic.demandBody(&mut store, &mut request, &id, b"immutableLender")
  run Testing.expect(succeeded(&lentMutably) && succeeded(&again)
      && rejectsSpan(&immutableLender, RejectionCode.ExclusiveBorrowRequiresMutable, text, "fixed", usize.ONE),
    "a mutable local or `mut` parameter lends an exclusive Effect view to once and mut targets and keeps it (EFFECT-OWN-002)",
  )
}

test effect fn plainCallableParameterForwardedMutableViewRetainsOriginalEnvironment() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run plainMutableCallableForwardingClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn plainMutableCallableForwardingClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("plain-callable-mutable-forwarding.silk")
  let text = """
fn consume<'env>(mut callback: mut fn<'env>(i32) -> i32) -> i32 { return callback(1) }
fn relay<'env>(mut forwardedView: mut fn<'env>(i32) -> i32) -> i32 {
  let first = consume(forwardedView)
  return first + forwardedView(1)
}
fn named(value: i32) -> i32 { return value + 41 }
fn main() -> i32 {
  let mut count = 40
  let mut change = fn(value: i32) -> i32 { count = count + value return count }
  return relay(move change)
}
fn shared() -> i32 { return relay(named) }
fn staticConsume(mut callback: mut fn<'static>(i32) -> i32) -> i32 { return callback(1) }
fn staticRelay(mut staticView: mut fn<'static>(i32) -> i32) -> i32 { return staticConsume(staticView) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let body = run Semantic.demandBody(&mut store, &mut request, &id, b"relay")
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&body, checkedBody)
  let mut loanChecked = false
  if let Option<Shared<TypedBody>>.Some {value} = move selected {
    loanChecked = Shared<TypedBody>.with<bool>(&value, mutableCallableLoanBody)
  }
  run Testing.expect(loanChecked, "forwarding retains a separate local storage loan, which the borrow walk proves")
  let staticBody = run Semantic.demandBody(&mut store, &mut request, &id, b"staticRelay")
  let staticSelected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&staticBody, checkedBody)
  let mut retained = false
  if let Option<Shared<TypedBody>>.Some {value} = move staticSelected {
    retained = run mutableStaticLoanRegions(&value)
  }
  run Testing.expect(retained, "static capture promises cannot erase the separate local storage loan")
  let caller = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  let namedCaller = run Semantic.demandMir(&mut store, &mut request, &id, b"shared")
  run Testing.expect(succeeded(&caller) && succeeded(&namedCaller),
    "mutable and Shared original targets specialize the same source mutable view contract")
  let application = namedMirApplication(&store, &caller, b"relay")
  if let Option<Shared<SpecializationApplication>>.Some {value} = move application {
    let relay = run Semantic.demandApplicationMir(&mut store, &mut request, &run SpecializationApplication.copyShared(&value))
    let nested = namedMirApplication(&store, &relay, b"consume")
    if let Option<Shared<SpecializationApplication>>.Some {value: consumer} = move nested {
      let invoked = run Semantic.demandApplicationMir(&mut store, &mut request, &run SpecializationApplication.copyShared(&consumer))
      run Testing.expect(succeeded(&relay) && mutableCallableLoanMir(&store, &invoked)
        && glueFact(&store, &invoked, usize.ZERO) == usize.ZERO,
        "the consumer borrows the dereferenced original environment and never drops or snapshots an affine owner")
      return ()
    }
  }
  run Testing.expect(false, "forwarding selects ordinary direct relay and consumer applications")
}

fn mutableCallableLoanBody(body: &TypedBody) -> bool {
  if TypedBody.borrowStatus(body) != BodyBorrowStatus.Checked { return false }
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form: BodyExpression.Borrow {access, ..}} = &nodes[at].kind {
      if access == Access.Mutable && Shared<Type>.with<bool>(&ty, mutableCallableLoanType) { return true }
    }
    at = at + usize.ONE
  }
  return false
}

fn mutableCallableLoanType(value: &Type) -> bool {
  if let Type.CallableView {representation, contract} = &value.* {
    return Shared<Type>.with<bool>(&contract, fn(public: &Type) -> bool {
      return match &public.* { Type.Callable {mode, ..} => mode == CallableMode.Mutable _ => false }
    }) && Shared<Type>.with<bool>(&representation, fn(storage: &Type) -> bool {
      if let Type.Reference {access, lifetime, ..} = &storage.* {
        return access == Access.Mutable && Shared<Lifetime>.with<bool>(&lifetime, callableLoanLocalRegion)
      }
      return false
    })
  }
  return false
}

fn callableLoanLocalRegion(region: &Lifetime) -> bool {
  return match &region.* { Lifetime.Local {..} => true _ => false }
}

effect fn mutableStaticLoanRegions(body: &Shared<TypedBody>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let loan = Shared<TypedBody>.with<Option<Shared<Type>>>(body, mutableBorrowType)
  if let Option<Shared<Type>>.Some {value} = move loan {
    if !Type.containsViewBorrow(&value) { return false }
    let copied = run Type.copy(&value)
    let representation = match move copied { Type.CallableView {representation, ..} => move representation _ => { return false } }
    let contract = Shared<Type>.with<Option<Shared<Type>>>(&value, mutableLoanPublicContract)
    let public = match move contract { Option<Shared<Type>>.Some {value: exposed} => move exposed _ => { return false } }
    let publicType = run Type.copy(&public)
    if let Type.Callable {environment, ..} = move publicType {
      if Shared<Intersection>.with<usize>(&environment, mutableLoanEnvironmentCount) != usize.ZERO { return false }
    } else { return false }
    let storage = run Type.copy(&representation)
    let referent = match move storage { Type.Reference {referent, ..} => move referent _ => { return false } }
    let parameter = run Type.copy(&referent)
    let identity = match move parameter { Type.Parameter {declaration, ..} => move declaration _ => { return false } }
    let representations = Vector<Option<Shared<Type>>>.make()
    let mut regions = Vector<Shared<Lifetime>>.make()
    let known = run Type.retainedRegions(&value, &identity, Vector<Option<Shared<Type>>>.asSlice(&representations), &mut regions)
    let stored = Vector<Shared<Lifetime>>.asSlice(&regions)
    return known && stored.length == usize.ONE && Shared<Lifetime>.with<bool>(&stored[usize.ZERO], callableLoanLocalRegion)
  }
  return false
}

fn mutableLoanPublicContract(value: &Type) -> Option<Shared<Type>> {
  return match &value.* {
    Type.CallableView {contract, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&contract))
    _ => Option<Shared<Type>>.none()
  }
}

fn mutableLoanEnvironmentCount(value: &Intersection) -> usize {
  return Vector<LifetimeMember>.length(&value.members)
}

fn mutableBorrowType(body: &TypedBody) -> Option<Shared<Type>> {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form: BodyExpression.Borrow {..}} = &nodes[at].kind {
      if Shared<Type>.with<bool>(&ty, mutableCallableLoanType) { return Option<Shared<Type>>.some(Shared<Type>.clone(&ty)) }
    }
    at = at + usize.ONE
  }
  return Option<Shared<Type>>.none()
}

fn mutableCallableLoanMir(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let index = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, value) {
      let locals = Vector<MirLocal>.asSlice(&function.locals)
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, arguments, ..} = &blocks[at].terminator {
          let identity = InstanceKey.identity(&key)
          if Shared<DeclarationId>.with<OwnerKind>(&identity, DeclarationId.kind) != OwnerKind.Anonymous { return false }
          let operands = Vector<MirOperand>.asSlice(&arguments)
          if operands.length == usize.ZERO { return false }
          let reference = borrowedCallableFieldLocal(&operands[usize.ZERO])
          let statements = Vector<MirStatement>.asSlice(&blocks[at].statements)
          let mut statement = usize.ZERO
          while statement < statements.length {
            if let MirStatement.Assign {destination, value: MirRvalue.Ref {access, place}, ..} = &statements[statement] {
              let projections = Vector<MirProjection>.asSlice(&place.projections)
              if destination.local == reference && access == Access.Mutable && mutableCallableParameterLocal(&locals[place.local])
                && projections.length == usize.ONE && mirProjectionIsDeref(&projections[usize.ZERO]) { return true }
            }
            statement = statement + usize.ONE
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}

test effect fn plainMutableCallableSectionViewProjectsBeforeStoredArguments() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run plainMutableSectionLoanClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn plainMutableSectionLoanClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("mutable-callable-section-loan.silk")
  let text = """
fn bump(amount: i32, counter: &mut i32) -> i32 { counter.* = counter.* + amount return counter.* }
fn consume<'env>(mut callback: mut fn<'env>(i32) -> i32) -> i32 { return callback(1) }
fn relay<'env>(mut forwarded: mut fn<'env>(i32) -> i32) -> i32 { let first = consume(forwarded) return first + forwarded(1) }
fn main() -> i32 { let mut count = 40 let step = bump(&mut count) return relay(move step) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let caller = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&caller), "a mutable section remains reusable after lending its original storage")
  let selected = namedMirApplication(&store, &caller, b"relay")
  if let Option<Shared<SpecializationApplication>>.Some {value} = move selected {
    let application = run SpecializationApplication.copyShared(&value)
    let relay = run Semantic.demandApplicationMir(&mut store, &mut request, &application)
    let nested = namedMirApplication(&store, &relay, b"consume")
    if let Option<Shared<SpecializationApplication>>.Some {value: consumer} = move nested {
      let consumedApplication = run SpecializationApplication.copyShared(&consumer)
      let invoked = run Semantic.demandApplicationMir(&mut store, &mut request, &consumedApplication)
      run Testing.expect(mutableSectionLoanMir(&store, &invoked) && succeeded(&relay)
        && glueFact(&store, &invoked, usize.ZERO) == usize.ZERO,
        "the original direct target receives Field0 after a descriptor snapshot and Deref, with no environment drop")
      return ()
    }
  }
  run Testing.expect(false, "section forwarding retains ordinary relay and consumer function identities")
}

fn mutableSectionLoanMir(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, value) {
      let locals = Vector<MirLocal>.asSlice(&function.locals)
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, arguments, ..} = &blocks[at].terminator {
          let identity = InstanceKey.identity(&key)
          if !Shared<DeclarationId>.with<bool>(&identity, mutableSectionOriginalTarget) { return false }
          let values = Vector<MirOperand>.asSlice(&arguments)
          if values.length != 2 { return false }
          if let MirOperand.Copy {place} = &values[usize.ONE] {
            let projections = Vector<MirProjection>.asSlice(&place.projections)
            if projections.length != 2 || !mirProjectionIsDeref(&projections[usize.ZERO]) { return false }
            if let MirProjection.Field {index} = &projections[usize.ONE] {
              if index != usize.ZERO { return false }
            } else { return false }
            if !Shared<Type>.with<bool>(&locals[place.local].ty, mutableSectionDescriptor) { return false }
            let statements = Vector<MirStatement>.asSlice(&blocks[at].statements)
            let mut statement = usize.ZERO
            while statement < statements.length {
              if let MirStatement.Assign {destination, value: MirRvalue.Use {value: MirOperand.Copy {place: source}}, ..} = &statements[statement] {
                if destination.local == place.local && Vector<MirProjection>.length(&source.projections) == usize.ZERO
                  && mutableSectionDescriptorComesFromParameter(statements, statement, locals, source.local) { return true }
              }
              statement = statement + usize.ONE
            }
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}

// A source local read already snapshots its descriptor. Follow only unprojected descriptor
// copies before the section snapshot; an environment-value copy cannot establish this origin.
fn mutableSectionDescriptorComesFromParameter(statements: &[MirStatement], before: usize,
  locals: &[MirLocal], local: usize) -> bool {
  if local >= locals.length || !Shared<Type>.with<bool>(&locals[local].ty, mutableSectionDescriptor) { return false }
  if mutableCallableParameterLocal(&locals[local]) { return true }
  let temporary = match &locals[local].kind { MirLocalKind.Temp => true _ => false }
  if !temporary { return false }
  let mut at = before
  while at > usize.ZERO {
    at = at - usize.ONE
    if let MirStatement.Assign {destination, value, ..} = &statements[at] {
      if destination.local == local {
        if let MirRvalue.Use {value: MirOperand.Copy {place}} = &value {
          if Vector<MirProjection>.length(&place.projections) != usize.ZERO { return false }
          return mutableSectionDescriptorComesFromParameter(statements, at, locals, place.local)
        }
        return false
      }
    }
  }
  return false
}

fn mutableCallableParameterLocal(local: &MirLocal) -> bool {
  return match &local.kind { MirLocalKind.Parameter {index} => index == usize.ZERO _ => false }
}

fn mutableSectionOriginalTarget(value: &DeclarationId) -> bool { return DeclarationId.named(value, b"bump") }

fn mutableSectionDescriptor(value: &Type) -> bool {
  return match &value.* { Type.Reference {access, ..} => access == Access.Mutable _ => false }
}

test effect fn plainCallableParameterDistinguishesGuardTransfers() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run plainCallableSourceGuardClaims()
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn plainCallableSourceGuardClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("plain-callable-source-guards.silk")
  let text = """
fn consume(callback: once fn<'static>() -> i32) -> i32 { return callback() }
fn argument(guardedArgument: once fn<'static>() -> i32) -> i32 {
  return match 0 { _ if consume(move guardedArgument) > 0 => 1 _ => 0 }
}
fn invocation(invokedOnce: once fn<'static>() -> i32) -> i32 {
  return match 0 { _ if invokedOnce() > 0 => 1 _ => 0 }
}
fn explicitCallee(movedCallee: once fn<'static>() -> i32) -> i32 {
  return match 0 { _ if (move movedCallee)() > 0 => 1 _ => 0 }
}
fn reused(reusedOnce: once fn<'static>() -> i32) -> i32 {
  let selected = match 0 { _ if reusedOnce() > 0 => 1 _ => 0 }
  return selected + reusedOnce()
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let argument = run Semantic.demandBody(&mut store, &mut request, &id, b"argument")
  let invocation = run Semantic.demandBody(&mut store, &mut request, &id, b"invocation")
  let explicitCallee = run Semantic.demandBody(&mut store, &mut request, &id, b"explicitCallee")
  let reused = run Semantic.demandBody(&mut store, &mut request, &id, b"reused")
  run Testing.expect(
    rejectsSpan(&argument, RejectionCode.GuardConsumesPattern, text, "move guardedArgument", usize.ZERO),
    "a named argument's explicit affine move is rejected before layout even without a literal or callable call",
  )
  run Testing.expect(succeeded(&invocation), "ordinary stored once invocation commits its receiver in a guard")
  run Testing.expect(
    rejectsSpan(&explicitCallee, RejectionCode.GuardConsumesPattern, text, "move movedCallee", usize.ZERO),
    "the receiver exception does not hide an explicit source move nested inside its callee",
  )
  run Testing.expect(
    rejectsSpan(&reused, RejectionCode.UseAfterMove, text, "reusedOnce", 2),
    "an allowed receiver transfer is committed even when the guard resumes dispatch",
  )
}

test effect fn plainCallableParameterRejectsCleanupFreeGuardTransfer() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run plainCallableGuardTransferClaims()
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// Pattern transport is checked before layout. This retained body tests an abstract affine
// representation independently of generic record layout and of any Drop implementation.
effect fn plainCallableGuardTransferClaims() -> ()
! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("plain-callable-guard-transfer.silk")
  let mut owners = Vector<OwnerStep>.make()
  run Vector<OwnerStep>.append(&mut owners, OwnerStep {kind: OwnerKind.Function,
    name: Option<Bytes>.some(run Bytes.copy(b"guarded")), occurrence: usize.ZERO})
  let declaration = run DeclarationId.fromParts(move id, move owners)
  let representation = run Types.intern(Type.Parameter {
    declaration: DeclarationId.copy(&declaration), ordinal: usize.ZERO})
  let boolean = run Types.intern(Type.Primitive {name: run Bytes.copy(b"bool")})
  let origin = BodyOrigin {node: usize.ZERO, location: Location {start: usize.ZERO, end: usize.ONE}}
  let transfer = BodyOrigin {node: 2, location: Location {start: 20, end: 25}}
  let mut nodes = Vector<BodyNode>.make()
  run Vector<BodyNode>.append(&mut nodes, BodyNode {origin: origin,
    kind: BodyNodeKind.Expression {ty: Shared<Type>.clone(&representation),
      form: BodyExpression.Local {local: BodyLocalId {index: usize.ZERO}}}})
  run Vector<BodyNode>.append(&mut nodes, BodyNode {origin: origin,
    kind: BodyNodeKind.Expression {ty: Shared<Type>.clone(&representation),
      form: BodyExpression.PatternBinding {subject: BodyNodeId {index: usize.ZERO},
        path: Vector<BodyPlaceStep>.make(), access: BodyBindingAccess.Moved}}})
  run Vector<BodyNode>.append(&mut nodes, BodyNode {origin: transfer,
    kind: BodyNodeKind.Expression {ty: move representation,
      form: BodyExpression.Move {value: BodyNodeId {index: usize.ONE},
        consumed: Option<BodyConsumedPlace>.some(BodyConsumedPlace {
          root: BodyPlaceRoot.Subject {subject: BodyNodeId {index: usize.ZERO}},
          steps: Vector<BodyPlaceStep>.make()})}}})
  run Vector<BodyNode>.append(&mut nodes, BodyNode {origin: origin,
    kind: BodyNodeKind.Expression {ty: Shared<Type>.clone(&boolean),
      form: BodyExpression.CallableCall {callee: BodyNodeId {index: 2}, mode: CallableMode.Once,
        arguments: Vector<BodyNodeId>.make(), inference: run Shared<DeclarationId>.make(move declaration),
        bindings: run Shared<Vector<Binding>>.make(Vector<Binding>.make()), pipeline: false, constructs: false}}})
  run Vector<BodyNode>.append(&mut nodes, BodyNode {origin: origin,
    kind: BodyNodeKind.Expression {ty: Shared<Type>.clone(&boolean), form: BodyExpression.Boolean {value: false}}})
  let mut indices = Vector<Option<usize>>.make()
  let mut at = usize.ZERO
  while at < 6 { run Vector<Option<usize>>.append(&mut indices, Option<usize>.none()) at = at + usize.ONE }
  let mut guarded = false
  while true {
    let mut arms = Vector<BodyMatchArm>.make()
    let mut guard = Option<BodyNodeId>.none()
    let mut result = BodyNodeId {index: 3}
    if guarded { guard = Option<BodyNodeId>.some(BodyNodeId {index: 3}) result = BodyNodeId {index: 4} }
    run Vector<BodyMatchArm>.append(&mut arms, BodyMatchArm {origin: origin,
      pattern: BodyPattern.Universal, tests: Vector<BodyPatternTest>.make(),
      guard: move guard, result: result, bindings: Vector<BodyNodeId>.make()})
    run Vector<BodyNode>.append(&mut nodes, BodyNode {origin: origin,
      kind: BodyNodeKind.Expression {ty: Shared<Type>.clone(&boolean),
        form: BodyExpression.Match {subject: BodyNodeId {index: usize.ZERO},
          access: BodySubjectAccess.Consume {consumed: Option<BodyConsumedPlace>.some(BodyConsumedPlace {
            root: BodyPlaceRoot.Local {local: BodyLocalId {index: usize.ZERO}}, steps: Vector<BodyPlaceStep>.make()})},
          tags: usize.ONE, domain: usize.ONE, arms: move arms, syntax: BodyMatchSyntax.Match}}})
    let checked = run CaptureAvailability.check(Vector<BodyNode>.asSlice(&nodes),
      Vector<Option<usize>>.asSlice(&indices), BodyNodeId {index: 5}, usize.ONE)
    let valid = match move checked {
      Option<CaptureFailure>.None => !guarded
      Option<CaptureFailure>.Some {value} => guarded
        && value.kind == CaptureFailureKind.GuardConsumed
        && value.origin.location.start == transfer.location.start && value.origin.location.end == transfer.location.end
    }
    run Testing.expect(valid, "a moved pattern transfers after selection, but never provisionally in a guard")
    drop Vector<BodyNode>.remove(&mut nodes, 5)
    if guarded { break }
    guarded = true
  }
}

test effect fn callablePipelineCompletesInputBeforeCapture() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run callablePipelineInputClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn callablePipelineInputClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("callable-pipeline-order.silk")
  let text = """
fn change(value: &mut i32) -> i32 { return Intrinsic.replace(value.*, 42) }
fn main() -> i32 {
  let mut current = 40
  return change(&mut current) |> fn(input: i32) -> i32 { return input + current }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let answer = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&answer) && pipelineInputPrecedesEnvironment(&store, &answer),
    "the input's direct call completes before the anonymous capture aggregate is constructed")
  let target = anonymousMirApplication(&store, &answer)
  run Testing.expect(match move target { Option<Shared<SpecializationApplication>>.Some {..} => true _ => false },
    "a pipeline retains an ordinary direct anonymous target")
}

fn pipelineInputPrecedesEnvironment(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      if blocks.length == usize.ZERO { return false }
      let statements = Vector<MirStatement>.asSlice(&blocks[usize.ZERO].statements)
      let mut at = usize.ZERO
      while at < statements.length {
        if let MirStatement.Assign {value: MirRvalue.Aggregate {..}, ..} = &statements[at] { return false }
        at = at + usize.ONE
      }
      if let MirTerminator.Call {callee: MirCallee.Instance {key}, normal, ..} = &blocks[usize.ZERO].terminator {
        let identity = InstanceKey.identity(&key)
        if !Shared<DeclarationId>.with<bool>(&identity, pipelineChangeDeclaration) { return false }
        return pipelineContinuationConstructsEnvironment(
          Vector<MirStatement>.asSlice(&blocks[normal].statements)) && pipelineChangeCalls(blocks) == usize.ONE
      }
    }
  }
  return false
}

fn pipelineChangeDeclaration(value: &DeclarationId) -> bool { return DeclarationId.named(value, b"change") }

fn pipelineChangeCalls(blocks: &[MirBlock]) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < blocks.length {
    if let MirTerminator.Call {callee: MirCallee.Instance {key}, ..} = &blocks[at].terminator {
      let identity = InstanceKey.identity(&key)
      if Shared<DeclarationId>.with<bool>(&identity, pipelineChangeDeclaration) { count = count + usize.ONE }
    }
    at = at + usize.ONE
  }
  return count
}

fn pipelineContinuationConstructsEnvironment(statements: &[MirStatement]) -> bool {
  let mut at = usize.ZERO
  while at < statements.length {
    if let MirStatement.Assign {value: MirRvalue.Aggregate {..}, ..} = &statements[at] { return true }
    at = at + usize.ONE
  }
  return false
}

