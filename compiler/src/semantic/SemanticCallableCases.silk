effect fn plainCallableReferenceInvocationClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("plain-callable-reference-invocation.silk")
  let text = """
fn implicit(borrowed: &fn<'static>() -> i32) -> i32 { return borrowed() }
fn taking(owned: &mut once fn<'static>() -> i32) -> i32 { return owned.*() }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let implicitCall = run Semantic.demandBody(&mut store, &mut request, &id, b"implicit")
  let projectedTake = run Semantic.demandBody(&mut store, &mut request, &id, b"taking")
  run Testing.expect(
    rejectsSpan(&implicitCall, RejectionCode.NotCallable, text, "borrowed", usize.ONE),
    "a reference descriptor is not callable without a source referent projection",
  )
  run Testing.expect(
    rejectsSpan(&projectedTake, RejectionCode.BorrowedExtraction, text, "owned.*", usize.ZERO),
    "a once invocation cannot move the callable environment out of borrowed storage",
  )
}

