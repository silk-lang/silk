effect fn plainCallableOriginIdentityClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("plain-callable-origin.silk")
  let text = """
fn original(value: i32) -> i32 { return value }
fn different(value: i32) -> i32 { return value + 1 }
fn first() -> fn<'static>(i32) -> i32 { return original }
fn second() -> fn<'static>(i32) -> i32 { return original }
fn other() -> fn<'static>(i32) -> i32 { return different }
fn same<F>(left: F, right: F) -> i32 { drop left drop right return 42 }
fn main() -> i32 { return same(first(), second()) + same(first(), original) }
fn mismatch() -> i32 { return same(first(), other()) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let accepted = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  let mismatch = run Semantic.demandBody(&mut store, &mut request, &id, b"mismatch")
  run Testing.expect(succeeded(&accepted),
    "equal original environments unify across two producers and a directly named value")
  run Testing.expect(rejectsSpan(&mismatch, RejectionCode.TypeMismatch, text, "other()", usize.ONE),
    "equal public contracts cannot unify different original callable targets")
}

