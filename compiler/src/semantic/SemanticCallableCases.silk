  return run contextualGenericDescriptorClaims(text) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn contextualGenericDescriptorClaims(text: string<'static>) -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("contextual-generic-descriptor-section.silk")
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let caller = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&caller), "a shared descriptor section satisfies an exclusive-descriptor argument promise contravariantly")
  if let Option<Shared<SpecializationApplication>>.Some {value} = move namedMirApplication(&store, &caller, b"consume") {
    let application = run SpecializationApplication.copyShared(&value)
    let consumer = run Semantic.demandApplicationMir(&mut store, &mut request, &application)
    run Testing.expect(succeeded(&consumer)
      && contextualGenericSectionTarget(&store, &consumer, usize.MAX, usize.ZERO, false) == usize.ONE,
      "closed operand inference selects the original shared descriptor target with T=i32 despite the argument's exclusive access")
    return ()
  }
  run Testing.expect(false, "the descriptor consumer retains an ordinary exact function application")
}

test effect fn contextualGenericSectionsTransferTheirOwnedCaptureOnce() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
