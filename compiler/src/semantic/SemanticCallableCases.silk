}

effect fn rawOwnedCallableReturnClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("raw-owned-callable-return.silk")
  let text = """
fn rawMutable<'env>(mut unknownMutable: mut fn<'env>() -> i32) -> mut fn<'env>() -> i32 { return move unknownMutable }
fn rawAlias<'env>(mut aliasedInput: mut fn<'env>() -> i32) -> mut fn<'env>() -> i32 {
  let mut heldAlias = move aliasedInput
  return move heldAlias
}
fn rawOnce(unknownOnce: once fn<'static>() -> i32) -> once fn<'static>() -> i32 { return move unknownOnce }
fn nested(outerUnknown: once fn<'static>() -> i32) -> once fn<'static>() -> once fn<'static>() -> i32 {
  return fn() -> once fn<'static>() -> i32 { return move outerUnknown }
}
fn bareMutable(mut bareUnknown: mut fn<'static>() -> i32) -> mut fn<'static>() -> i32 { return bareUnknown }
fn generic<F: mut fn<'static>() -> i32>(mut owned: F) -> mut fn<'static>() -> i32 { return move owned }
fn named() -> i32 { return 42 }
fn known() -> mut fn<'static>() -> i32 { return named }
struct Holder<F: mut fn<'static>() -> i32> { callback: F }
impl<F> Holder<F> {
  fn take(self: Self) -> mut fn<'static>() -> i32 { return move self.callback }
}
fn knownOwner() -> mut fn<'static>() -> i32 { return Holder { callback: named }.take() }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let mutable = run Semantic.demandBody(&mut store, &mut request, &id, b"rawMutable")
  let alias = run Semantic.demandBody(&mut store, &mut request, &id, b"rawAlias")
  let onceAnswer = run Semantic.demandBody(&mut store, &mut request, &id, b"rawOnce")
  let nested = run Semantic.demandBody(&mut store, &mut request, &id, b"nested")
  let bare = run Semantic.demandBody(&mut store, &mut request, &id, b"bareMutable")
  let generic = run Semantic.demandBody(&mut store, &mut request, &id, b"generic")
  let known = run Semantic.demandBody(&mut store, &mut request, &id, b"known")
  let knownOwner = run Semantic.demandBody(&mut store, &mut request, &id, b"knownOwner")
  run Testing.expect(rejectsSpan(&mutable, RejectionCode.UnknownOwnedCallableReturn, text, "move unknownMutable", usize.ZERO)
    && rejectsSpan(&alias, RejectionCode.UnknownOwnedCallableReturn, text, "move heldAlias", usize.ZERO)
    && rejectsSpan(&onceAnswer, RejectionCode.UnknownOwnedCallableReturn, text, "move unknownOnce", usize.ZERO)
    && rejectsSpan(&nested, RejectionCode.UnknownOwnedCallableReturn, text, "move outerUnknown", usize.ZERO),
    "SEM0081 retains the raw owned-callable role through explicit moves and aliases")
  run Testing.expect(rejectsSpan(&bare, RejectionCode.ExplicitMoveRequired, text, "bareUnknown", usize.ONE),
    "a bare affine return retains its preceding OWN0003 transfer rejection")
  run Testing.expect(succeeded(&generic) && succeeded(&known) && succeeded(&knownOwner),
    "authored function and nominal owner F values and known original targets can return through a mutable callable contract")
}

