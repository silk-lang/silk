effect fn opaqueReturnFailureClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("opaque-return-failures.silk")
  let text = """
fn positive(value: i32) -> i32 { return value + 1 }
fn negative(value: i32) -> i32 { return value - 1 }
fn divergent(choice: bool) -> some<Different: fn<'static>(i32) -> i32> Different {
  if choice { return positive }
  return negative
}
fn cycle() -> some<Recursive: fn<'static>() -> i32> Recursive { return cycle() }
fn inlineCycle() -> some<Inline: once fn<'static>() -> i32> Inline {
  let previous = inlineCycle()
  return fn() -> i32 { return previous() }
}
fn missing() -> some<Absent: fn<'static>(i32) -> i32> Absent | i32 { return 42 }
fn wrong() -> some<Wrong: fn<'static>(i32) -> i32> Wrong { return fn(value: bool) -> bool { return value } }
fn deferred() -> some<Pending: Effect<'static; i32>> Pending { return effect { return 42 } }
fn opaqueEffectUse() -> i32 { return run deferred() }
fn anonymousEffectUse() -> i32 {
  let pending = fn() -> i32 { return run deferred() }
  return pending()
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let divergent = run Semantic.demandMir(&mut store, &mut request, &id, b"divergent")
  let cycle = run Semantic.demandMir(&mut store, &mut request, &id, b"cycle")
  let inlineCycle = run Semantic.demandMir(&mut store, &mut request, &id, b"inlineCycle")
  let missing = run Semantic.demandMir(&mut store, &mut request, &id, b"missing")
  let wrong = run Semantic.demandBody(&mut store, &mut request, &id, b"wrong")
  let opaqueEffectUse = run Semantic.demandBody(&mut store, &mut request, &id, b"opaqueEffectUse")
  let anonymousEffectUse = run Semantic.demandBody(&mut store, &mut request, &id, b"anonymousEffectUse")
  run Testing.expect(rejectsSpan(&divergent, RejectionCode.DivergentOpaqueRealization, text,
    "some<Different: fn<'static>(i32) -> i32> Different", usize.ZERO),
    "incompatible returned targets reject at the producer's opaque result")
  run Testing.expect(rejectsRelated(&divergent, RejectionCode.DivergentOpaqueRealization,
    offsetOf(text, "some<Different: fn<'static>(i32) -> i32> Different", usize.ZERO), offsetOf(text, "positive", usize.ONE)),
    "divergence retains the first returned construction as a related source site")
  run Testing.expect(rejectsSpan(&cycle, RejectionCode.OpaqueRealizationCycle, text,
    "some<Recursive: fn<'static>() -> i32> Recursive", usize.ZERO),
    "a recursive forwarding family without a concrete leaf rejects at its opaque result")
  run Testing.expect(rejectsSpan(&inlineCycle, RejectionCode.InlineOpaqueLayoutCycle, text,
    "some<Inline: once fn<'static>() -> i32> Inline", usize.ZERO),
    "a returned environment that captures its own family rejects as an inline layout cycle")
  run Testing.expect(rejectsSpan(&missing, RejectionCode.MissingOpaqueRealization, text,
    "some<Absent: fn<'static>(i32) -> i32> Absent | i32", usize.ZERO),
    "an ordinary union alternative supplies no opaque representation evidence")
  run Testing.expect(rejectsSpan(&wrong, RejectionCode.ReturnTypeMismatch, text,
    "fn(value: bool) -> bool { return value }", usize.ZERO),
    "an invalid offered callable contract rejects at the returned construction")
  run Testing.expect(succeeded(&opaqueEffectUse) && succeeded(&anonymousEffectUse),
    "an opaque Effect result runs through its contract, also from an anonymous body")
}

