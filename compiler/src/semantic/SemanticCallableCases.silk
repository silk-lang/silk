effect fn opaqueReturnStorageClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("opaque-return-storage.silk")
  let text = """
fn add(value: i32, offset: i32) -> i32 { return value + offset }
fn make(offset: i32) -> some<F: fn<'static>(i32) -> i32> F { return add(offset) }
fn discarded(value: i32) -> i32 { return value }
fn early() -> some<Live: fn<'static>(i32) -> i32> Live { return add(20) return discarded }
fn returnedNever() -> some<Exit: fn<'static>(i32) -> i32> Exit {
  return match true { _ => { return add(20) } }
}
fn main() -> i32 {
  let callback = make(20)
  let first = callback(1)
  return first + callback(1)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let entry = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&entry), "an opaque callable result has a finite runtime environment")
  run Testing.expect(sectionInvocationCount(&store, &entry, b"add", false) == 2,
    "each opaque invocation directly calls the original target with the stored suffix")
  let producer = run Semantic.demandMir(&mut store, &mut request, &id, b"make")
  run Testing.expect(succeeded(&producer) && opaqueSectionResult(&store, &producer),
    "the producer returns its exact one-field section environment through the same ABI as its caller")
  let early = run Semantic.demandMir(&mut store, &mut request, &id, b"early")
  run Testing.expect(succeeded(&early) && opaqueSectionResult(&store, &early),
    "an unreachable retained return cannot invent a divergent representation")
  let exits = run Semantic.demandMir(&mut store, &mut request, &id, b"returnedNever")
  run Testing.expect(succeeded(&exits) && opaqueSectionResult(&store, &exits),
    "a never-typed outer operand establishes no leaf beyond its inner returned construction")
  let signature = run Semantic.demandSignature(&mut store, &mut request, &id, b"make")
  let source = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&signature, signatureResult)
  if let Option<Shared<Type>>.Some {value} = move source {
    run Testing.expect(Shared<Type>.with<bool>(&value,
      fn(ty: &Type) -> bool { return match &ty.* { Type.OpaqueRepresentation {..} => true _ => false } }),
      "runtime realization leaves the authored producer family intact")
  } else { run Testing.expect(false, "the producer retains its source result") }
}

fn opaqueSectionResult(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      return Shared<Type>.with<bool>(&function.result, opaqueSectionResultType)
    }
  }
  return false
}

fn opaqueSectionResultType(value: &Type) -> bool {
  if let Type.CallableValue {application, captures, ..} = &value.* {
    return Vector<Shared<Type>>.length(&captures) == usize.ONE
      && Shared<SpecializationApplication>.with<bool>(&application,
        fn(selected: &SpecializationApplication) -> bool {
          return DeclarationId.named(SpecializationApplication.bodyDeclaration(selected), b"add")
        })
  }
  return false
}

