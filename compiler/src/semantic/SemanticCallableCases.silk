effect fn contextualGenericOwnedSectionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("contextual-generic-owned-section.silk")
  let text = """
struct Token { value: i32 }
impl Intrinsic.Drop for Token { fn drop(self: &mut Token) -> () { return () } }
fn select<T>(value: T, token: Token) -> T { drop token return move value }
fn consume<F: once fn<'static>(i32) -> i32>(callback: F) -> i32 { return callback(42) }
fn main(token: Token) -> i32 { let next = select(move token) return consume(move next) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let caller = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&caller) && glueFact(&store, &caller, usize.ZERO) == usize.ZERO,
    "contextual forwarding transfers the once environment without caller cleanup")
  if let Option<Shared<SpecializationApplication>>.Some {value} = move namedMirApplication(&store, &caller, b"consume") {
    let application = run SpecializationApplication.copyShared(&value)
    let consumer = run Semantic.demandApplicationMir(&mut store, &mut request, &application)
    run Testing.expect(succeeded(&consumer) && contextualGenericSectionTarget(&store, &consumer, usize.MAX, usize.ZERO, true) == usize.ONE
      && glueFact(&store, &consumer, usize.ZERO) == usize.ZERO,
      "the consumer moves stored field zero to the original target without dropping the transferred environment")
    if let Option<Shared<SpecializationApplication>>.Some {value: selected} = move namedMirApplication(&store, &consumer, b"select") {
      let target = run SpecializationApplication.copyShared(&selected)
      let implementation = run Semantic.demandApplicationMir(&mut store, &mut request, &target)
      run Testing.expect(succeeded(&implementation) && glueFact(&store, &implementation, usize.ZERO) == usize.ONE,
        "the complete original target owns the sole capture cleanup")
      return ()
    }
  }
  run Testing.expect(false, "contextual once forwarding retains ordinary consumer and target applications")
}

fn genericSectionLocalRegion(value: &Lifetime) -> bool {
  return match &value.* { Lifetime.Local {..} => true _ => false }
}

fn genericSectionLocalLoan(value: &Type) -> bool {
  if let Type.Reference {access, lifetime, ..} = &value.* {
    return access == Access.Mutable && Shared<Lifetime>.with<bool>(&lifetime, genericSectionLocalRegion)
  }
  return false
}

fn genericSectionRetainedLoan(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, ..} = &nodes[at].kind {
      if Shared<Type>.with<bool>(&ty, genericSectionHasLocalLoan) { return true }
    }
    at = at + usize.ONE
  }
  return false
}

fn genericSectionHasLocalLoan(value: &Type) -> bool {
  if let Type.CallableSchema {captures, ..} = &value.* {
    let fields = Vector<Shared<Type>>.asSlice(&captures)
    return fields.length == usize.ONE && Shared<Type>.with<bool>(&fields[usize.ZERO], genericSectionLocalLoan)
  }
  return false
}

