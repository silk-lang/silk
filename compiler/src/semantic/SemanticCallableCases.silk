effect fn opaqueReturnTransferClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("opaque-return-transfers.silk")
  let text = """
fn copied<F: once fn<'static>() -> i32>(owned: F) -> some<Copied: once fn<'static>() -> i32> Copied { return owned }
fn transferred<F: once fn<'static>() -> i32>(taken: F) -> some<Taken: once fn<'static>() -> i32> Taken { return move taken }
fn borrowed<F: once fn<'static>() -> i32>(loan: &F) -> some<Borrowed: once fn<'static>() -> i32> Borrowed { return loan.* }
fn copiedArms<F: once fn<'static>() -> i32>(choice: bool, armOwned: F) -> some<Arms: once fn<'static>() -> i32> Arms {
  return match choice { _ if choice => armOwned _ => armOwned }
}
fn transferredArms<F: once fn<'static>() -> i32>(choice: bool, armTaken: F) -> some<MovedArms: once fn<'static>() -> i32> MovedArms {
  return match choice { _ if choice => move armTaken _ => move armTaken }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let copied = run Semantic.demandBody(&mut store, &mut request, &id, b"copied")
  let transferred = run Semantic.demandBody(&mut store, &mut request, &id, b"transferred")
  let borrowed = run Semantic.demandBody(&mut store, &mut request, &id, b"borrowed")
  let copiedArms = run Semantic.demandBody(&mut store, &mut request, &id, b"copiedArms")
  let transferredArms = run Semantic.demandBody(&mut store, &mut request, &id, b"transferredArms")
  run Testing.expect(rejectsSpan(&copied, RejectionCode.ExplicitMoveRequired, text, "owned", usize.ONE),
    "a producer cannot copy an affine environment out of a retained parameter")
  run Testing.expect(rejectsSpan(&borrowed, RejectionCode.BorrowedExtraction, text, "loan.*", usize.ZERO),
    "a producer cannot extract an affine environment from a borrowed referent")
  run Testing.expect(rejectsSpan(&copiedArms, RejectionCode.ExplicitMoveRequired, text, "armOwned", usize.ONE),
    "each value-producing match arm must transfer its own affine environment")
  let armBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&transferredArms, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value: body} = move armBody {
    run Testing.expect(Shared<TypedBody>.with<bool>(&body, opaqueReturnArmMovesOwners),
      "explicit arm transfers preserve each branch's consumed parameter place")
  } else { run Testing.expect(false, "explicit arm transfers satisfy the opaque callable contract") }
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&transferred, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value: body} = move selected {
    run Testing.expect(Shared<TypedBody>.with<bool>(&body, opaqueReturnMovesOwner),
      "an explicit return move retains the consumed parameter place for cleanup")
  } else { run Testing.expect(false, "a moved opaque construction satisfies its declared contract") }
}

fn opaqueReturnMovesOwner(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Return {value: returned} = &nodes[at].kind {
      if let Option<BodyNodeId>.Some {value} = &returned {
        if opaqueMoveOfLocal(nodes, value, usize.ZERO) { return true }
      }
    }
    at = at + usize.ONE
  }
  return false
}

fn opaqueMoveOfLocal(nodes: &[BodyNode], node: BodyNodeId, owner: usize) -> bool {
  if let BodyNodeKind.Expression {form: BodyExpression.Move {consumed, ..}, ..} = &nodes[node.index].kind {
    if let Option<BodyConsumedPlace>.Some {value: place} = &consumed {
      if let BodyPlaceRoot.Local {local} = &place.root {
        return local.index == owner && Vector<BodyPlaceStep>.length(&place.steps) == usize.ZERO
      }
    }
  }
  return false
}

fn opaqueReturnArmMovesOwners(body: &TypedBody) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Return {value: returned} = &nodes[at].kind {
      if let Option<BodyNodeId>.Some {value} = &returned {
        if let BodyNodeKind.Expression {form: BodyExpression.Match {arms, ..}, ..} = &nodes[value.index].kind {
          let listed = Vector<BodyMatchArm>.asSlice(&arms)
          return listed.length == 2 && opaqueMoveOfLocal(nodes, listed[usize.ZERO].result, usize.ONE)
            && opaqueMoveOfLocal(nodes, listed[usize.ONE].result, usize.ONE)
        }
      }
    }
    at = at + usize.ONE
  }
  return false
}

test effect fn callableReturnFlowExcludesMembersWithExitingGuards() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run returnGuardFlowClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn returnGuardFlowClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("return-guard-flow.silk")
  let text = """
enum Choice { A, B }
enum Only { One }
fn choose(choice: Choice) -> i32 {
  match choice {
    Choice.A if match true { _ if true => { return 11 } _ => false } => { return 22 }
    Choice.A => { return 33 }
    Choice.B => { return 44 }
  }
}
fn exhausted(choice: Only) -> i32 {
  match choice {
    Only.One if match true { _ if true => { return 55 } _ => false } => { return 66 }
    _ => { return 77 }
  }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let source = run Semantic.demandBody(&mut store, &mut request, &id, b"choose")
  let exhausted = run Semantic.demandBody(&mut store, &mut request, &id, b"exhausted")
  let exhaustedBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&exhausted, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value: body} = move exhaustedBody {
    let anchor = match move run Semantic.bodyAnchor(&mut store, &body) {
      Option<Anchor>.Some {value} => move value
      Option<Anchor>.None => {return run Testing.expect(false, "finite guard body has a current source anchor")}
    }
    let values = run ReturnFlow.collect(&body)
    let listed = Vector<BodyNodeId>.asSlice(&values)
    run Testing.expect(listed.length == usize.ONE, "exhausting every finite member excludes a later universal arm")
    if listed.length == usize.ONE {
      let returned = listed[usize.ZERO]
      run Testing.expect(Shared<TypedBody>.with<bool>(&body, fn(value: &TypedBody) -> bool {
        let nodes = TypedBody.nodeSlice(value)
        // Compare projected authored byte spans.
        let written = offsetOf(text, "55", usize.ZERO)
        return Anchor.span(&anchor, nodes[returned.index].origin.location).start == written && Anchor.span(&anchor, nodes[returned.index].origin.location).end == written + 2
      }), "the sole reachable result is the exiting guard operand")
    }
  } else { run Testing.expect(false, "the finite-domain guard control retains a checked body") }
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&source, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value: body} = move selected {
    let anchor = match move run Semantic.bodyAnchor(&mut store, &body) {
      Option<Anchor>.Some {value} => move value
      Option<Anchor>.None => {return run Testing.expect(false, "finite guard body has a current source anchor")}
    }
    let values = run ReturnFlow.collect(&body)
    let listed = Vector<BodyNodeId>.asSlice(&values)
    run Testing.expect(listed.length == 2, "only the exiting guard and the remaining enum member return")
    if listed.length == 2 {
      let first = listed[usize.ZERO]
      let second = listed[usize.ONE]
      let exact = Shared<TypedBody>.with<bool>(&body, fn(value: &TypedBody) -> bool {
        let nodes = TypedBody.nodeSlice(value)
        let firstWritten = offsetOf(text, "11", usize.ZERO)
        let secondWritten = offsetOf(text, "44", usize.ZERO)
        return Anchor.span(&anchor, nodes[first.index].origin.location).start == firstWritten && Anchor.span(&anchor, nodes[first.index].origin.location).end == firstWritten + 2
          && Anchor.span(&anchor, nodes[second.index].origin.location).start == secondWritten && Anchor.span(&anchor, nodes[second.index].origin.location).end == secondWritten + 2
      })
      run Testing.expect(exact, "a terminating guard excludes both its own arm result and later arms for that member")
    }
    return ()
  }
  run Testing.expect(false, "the guard control retains a checked body")
}

test effect fn plainCallableReturnsKeepOriginalStorageAndPublicContracts() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
