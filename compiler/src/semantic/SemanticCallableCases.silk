effect fn qualifiedFunctionValueClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("qualified-values.silk")
  let library = run module("qualified_actor.silk")
  let text = """
import qualified_actor as Actor { Counter as Counter, Box as Box }
enum Choice { A, B }
union Pick<T> { Empty, Full { value: T } }
fn scalarEnum() -> Choice { return Choice.A }
fn staticEnum() -> i32 { let static selected = Choice.A if selected == Choice.A { return 1 } return 0 }
fn emptyVariant() -> Pick<i32> { return Pick<i32>.Empty }
fn makeZero() -> typeof(Counter.zero) { return Counter.zero }
fn main() -> i32 {
  let start = makeZero()
  let next = Actor.next
  let identity = Box<i32>.identity
  return identity(next(start()))
}
fn foreignValue() -> () { let invalid = Actor.foreignValue }
fn privateValue() -> () { let invalid = Counter.hidden }
fn unsafeValue() -> typeof(Actor.unsafeNext) { return Actor.unsafeNext }
fn unsafeInvocation() -> i32 { let unsafeCallback = Actor.unsafeNext return unsafeCallback(1) }
"""
  let libraryText = """
pub struct Counter {}
impl Counter {
  pub fn zero() -> i32 { return 7 }
  fn hidden() -> i32 { return 9 }
}
pub struct Box<T> { value: T }
impl<T> Box<T> { pub fn identity(value: T) -> T { return move value } }
pub fn next(value: i32) -> i32 { return value + 1 }
pub unsafe fn unsafeNext(value: i32) -> i32 { return value + 1 }
pub unsafe extern "C" fn foreignValue() -> i32
"""
  let entrySource = run present(text)
  let librarySource = run present(libraryText)
  let initial = run Revision.publish(&Revision.make(), &id, &entrySource)
  let revision = run Revision.publish(&initial, &library, &librarySource)
  let mut store = makeSemantic(move revision)
  let mut request = Request.make()
  let construct = run Semantic.demandMir(&mut store, &mut request, &id, b"makeZero")
  let entry = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&construct), "qualified construction lowers")
  run Testing.expect(namedValueConstruction(&store, &construct),
    "an imported type qualifier constructs and returns its zero-arity target without executing it")
  run Testing.expect(succeeded(&entry), "qualified invocation lowers")
  run Testing.expect(qualifiedNamedValueTargets(&store, &entry),
    "namespace and applied-owner values retain direct original targets and their complete owner selection")
  let foreign = run Semantic.demandBody(&mut store, &mut request, &id, b"foreignValue")
  let private = run Semantic.demandBody(&mut store, &mut request, &id, b"privateValue")
  let unsafeValue = run Semantic.demandBody(&mut store, &mut request, &id, b"unsafeValue")
  let unsafeCall = run Semantic.demandBody(&mut store, &mut request, &id, b"unsafeInvocation")
  let enumeration = run Semantic.demandBody(&mut store, &mut request, &id, b"scalarEnum")
  let staticEnumeration = run Semantic.demandMir(&mut store, &mut request, &id, b"staticEnum")
  let variant = run Semantic.demandBody(&mut store, &mut request, &id, b"emptyVariant")
  run Testing.expect(succeeded(&enumeration) && succeeded(&staticEnumeration) && succeeded(&variant),
    "a failed inherent function lookup leaves ordinary and static enum values and applied nullary union selectors available")
  run Testing.expect(rejectsSpan(&foreign, RejectionCode.ForeignFunctionNotFirstClass, text, "Actor.foreignValue", usize.ZERO)
    && rejectsSpan(&private, RejectionCode.PrivateMember, text, "hidden", usize.ZERO),
    "value construction retains C callback and imported inherent visibility diagnostics")
  run Testing.expect(succeeded(&unsafeValue)
    && rejectsSpan(&unsafeCall, RejectionCode.UnsafeAcknowledgement, text, "unsafeCallback(1)", usize.ZERO),
    "qualified unsafe targets construct freely and require acknowledgement at the actual invocation")
}

fn qualifiedNamedValueTargets(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut zero = false
      let mut next = false
      let mut identity = false
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee, arguments, ..} = &blocks[at].terminator {
          let key = match &callee { MirCallee.Instance {key} => &key _ => { return false } }
          let application = match move InstanceKey.application(key) {
            Option<Shared<SpecializationApplication>>.Some {value} => move value _ => { return false }
          }
          let kind = Shared<SpecializationApplication>.with<usize>(&application, qualifiedNamedValueTarget)
          let count = Vector<MirOperand>.length(&arguments)
          if kind == usize.ONE && count == usize.ZERO { zero = true }
          else if kind == 2 && count == usize.ONE { next = true }
          else if kind == 3 && count == usize.ONE { identity = true }
          else if kind != 4 || count != usize.ZERO { return false }
        }
        at = at + usize.ONE
      }
      return zero && next && identity
    }
  }
  return false
}

fn qualifiedNamedValueTarget(value: &SpecializationApplication) -> usize {
  let target = SpecializationApplication.bodyDeclaration(value)
  if DeclarationId.named(target, b"zero") { return usize.ONE }
  if DeclarationId.named(target, b"next") { return 2 }
  if DeclarationId.named(target, b"makeZero") { return 4 }
  if DeclarationId.named(target, b"identity") {
    if Vector<Argument>.length(&value.arguments) != usize.ZERO { return usize.ZERO }
    let scopes = Vector<ScopeBinding>.asSlice(&value.scopes)
    if scopes.length != usize.ONE { return usize.ZERO }
    let supplied = Vector<Argument>.asSlice(&scopes[usize.ZERO].arguments)
    let ordinals = Vector<usize>.asSlice(&scopes[usize.ZERO].argumentOrdinals)
    if supplied.length == usize.ONE && ordinals.length == usize.ONE && ordinals[usize.ZERO] == usize.ZERO
      && genericSectionArgument(&supplied[usize.ZERO], b"i32") { return 3 }
  }
  return usize.ZERO
}

