  return change(&mut current) |> (fn(first: i32, last: i32) -> i32 { return current + first + last })(1)
}
fn change(value: &mut i32) -> i32 { return Intrinsic.replace(value.*, 42) }
"""
  return run callablePipelineStageClaims(text) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

