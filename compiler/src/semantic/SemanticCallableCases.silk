effect fn allocationExpressionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("allocation-source-expression.silk")
  let text = """
struct Allocation {}
impl Allocation { fn value() -> i32 { return 1 } }
fn source() -> i32 { return Allocation.value() }
fn blocked() -> Intrinsic.Allocation { return Intrinsic.Allocation {} }
fn shadow<Allocation>() -> i32 { let made = Allocation {} return 1 }
fn ordinary() -> Allocation { return Allocation {} } // ordinary: the source struct
struct Holder<T> { owner: T }
fn typed(value: Intrinsic.Allocation) -> Holder<Intrinsic.Allocation> { return Holder<Intrinsic.Allocation> { owner: move value } }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let source = run Semantic.demandBody(&mut store, &mut request, &id, b"source")
  let sourceBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&source, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move sourceBody {
    run Testing.expect(Shared<TypedBody>.with<bool>(&value, fn(body: &TypedBody) -> bool {
      return bodyCalls(body, &id, usize.ZERO)
    }), "an inherent namespace member resolves the ordinary source Allocation owner")
  } else { run Testing.expect(false, "ordinary source Allocation inherent namespace call is checked") }
  let blocked = run Semantic.demandBody(&mut store, &mut request, &id, b"blocked")
  run Testing.expect(rejectsSpan(&blocked, RejectionCode.NotType, text, "Intrinsic.Allocation {}", usize.ZERO),
    "the sealed Allocation has no raw constructor beside a same-spelled source declaration")
  let shadow = run Semantic.demandBody(&mut store, &mut request, &id, b"shadow")
  run Testing.expect(rejectsSpan(&shadow, RejectionCode.NotType, text, "Allocation {}", 2),
    "a type binder named Allocation has no record constructor")
  let ordinary = run Semantic.demandBody(&mut store, &mut request, &id, b"ordinary")
  run Testing.expect(succeeded(&ordinary), "a source Allocation constructs and returns as an ordinary record")
  let typed = run Semantic.demandBody(&mut store, &mut request, &id, b"typed")
  run Testing.expect(succeeded(&typed), "ordinary Holder construction retains its canonical Allocation argument")
  let genericId = run module("allocation-source-generic.silk")
  let genericText = """
struct Allocation<T> { item: T }
fn supplied() -> i32 { let made = Allocation<i32> { item: 1 } return 1 }
fn inferred() -> i32 { let made = Allocation { item: 1 } return 1 }
"""
  let mut generic = run staticSemantic(&genericId, genericText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let supplied = run Semantic.demandBody(&mut generic, &mut request, &genericId, b"supplied")
  let inferred = run Semantic.demandBody(&mut generic, &mut request, &genericId, b"inferred")
  run Testing.expect(succeeded(&supplied) && succeeded(&inferred),
    "a generic source Allocation constructs with supplied or inferred arguments like any source record")
  let absentId = run module("allocation-no-source-constructor.silk")
  let absentText = "fn absent() -> Intrinsic.Allocation { return Allocation {} }"
  let mut absent = run staticSemantic(&absentId, absentText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let missing = run Semantic.demandBody(&mut absent, &mut request, &absentId, b"absent")
  run Testing.expect(rejectsSpan(&missing, RejectionCode.UnknownType, absentText, "Allocation", usize.ONE),
    "a bare Allocation constructor with no source declaration is an unknown name, not the sealed core")
}

fn allocationZeroArity(answer: &Result<Answer, NoRejection>) -> bool {
  let selected = rejection(answer)
  if let Option<Shared<Rejection>>.Some {value} = move selected {
    return Shared<Rejection>.with<bool>(&value, fn(found: &Rejection) -> bool {
      return found.code == RejectionCode.TypeArity && found.expected == usize.ZERO && found.supplied == usize.ONE
    })
  }
  return false
}

