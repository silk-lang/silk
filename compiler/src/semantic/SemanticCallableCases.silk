effect fn abstractSchemaMutableClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("abstract-schema-mutable.silk")
  let text = """
fn first<A>(value: A, target: &mut i32, last: i32) -> A { target.* = last return move value }
fn invoke<F: fn<'static>(i32, &mut i32) -> i32>(callback: F, target: &mut i32) -> i32 {
  let mut next = callback(&mut target)
  let value = next(40)
  return next(value + 2)
}
fn main(target: &mut i32) -> i32 { return invoke(first(0), &mut target) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let entry = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&entry), "the contextual schema retains a fixed exclusive-reference parameter")
  if let Option<Shared<SpecializationApplication>>.Some {value} = move namedMirApplication(&store, &entry, b"invoke") {
    let application = run SpecializationApplication.copyShared(&value)
    let body = run Semantic.demandApplicationMir(&mut store, &mut request, &application)
    run Testing.expect(succeeded(&body), "the mutable consumer lowers")
    run Testing.expect(abstractStagedSchemaMode(&store, &body, CallableMode.Mutable), "the mutable schema retains exclusive access")
    run Testing.expect(abstractStagedSchemaTargetCount(&store, &body, false) == 2,
      "both mutable invocations append the two stored fields in original target order")
    run Testing.expect(glueFact(&store, &body, usize.ZERO) == usize.ZERO, "the retained descriptor has no owned cleanup")
    let source = run Semantic.demandBody(&mut store, &mut request, &id, b"invoke")
    let typed = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&source, checkedBody)
    if let Option<Shared<TypedBody>>.Some {value: checked} = move typed {
      run Testing.expect(Shared<TypedBody>.with<bool>(&checked, borrowNotChecked),
        "runtime normalization retains the existing explicit borrow-analysis obligation")
    } else { run Testing.expect(false, "mutable staging retains its checked source body") }
    return ()
  }
  run Testing.expect(false, "mutable staging retains the ordinary consumer application")
}

