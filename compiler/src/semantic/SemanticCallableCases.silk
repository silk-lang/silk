effect fn plainCallableReturnCleanupClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("plain-callable-return-cleanup.silk")
  let text = """
struct Token { value: i32 }
impl Intrinsic.Drop for Token { fn drop(self: &mut Token) -> () { return () } }
fn consume(amount: i32, token: Token) -> i32 { drop token return amount }
fn make(token: Token) -> once fn<'static>(i32) -> i32 { return consume(move token) }
fn main() -> i32 { let operation = make(Token { value: 42 }) return operation(42) }
fn abandoned() -> i32 { let unused = make(Token { value: 42 }) return 42 }
fn invalid(token: Token) -> once fn<'static>(i32) -> i32 {
  let owned = consume(move token)
  return owned
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let producer = run Semantic.demandMir(&mut store, &mut request, &id, b"make")
  let entry = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  let target = run Semantic.demandMir(&mut store, &mut request, &id, b"consume")
  let abandoned = run Semantic.demandMir(&mut store, &mut request, &id, b"abandoned")
  run Testing.expect(succeeded(&producer) && succeeded(&entry) && succeeded(&target) && succeeded(&abandoned)
    && sectionInvocationCount(&store, &entry, b"consume", true) == usize.ONE,
    "a returned affine environment retains original storage through transfer, invocation and abandonment")
  run Testing.expect(glueFact(&store, &producer, usize.ZERO) == usize.ZERO
    && glueFact(&store, &entry, usize.ZERO) == usize.ZERO
    && glueFact(&store, &target, usize.ZERO) == usize.ONE
    && glueFact(&store, &abandoned, usize.ZERO) == usize.ONE,
    "producer and invoking caller relinquish cleanup while the target or unused caller owns it once")
  if let Option<Shared<Type>>.Some {value} = move plainCallableMirResultType(&store, &producer) {
  let sourceOwner = run glueSourceOwner(&mut store, &producer)
    let glue = run Semantic.demandGlueMir(&mut store, &mut request, &value, &sourceOwner)
    run Testing.expect(succeeded(&glue) && glueFact(&store, &glue, usize.ZERO) == usize.ONE,
      "the returned environment glue drops its stored capture through ordinary exact child glue")
    let mut members = Vector<Shared<Type>>.make()
    run Vector<Shared<Type>>.append(&mut members, Shared<Type>.clone(&value))
    run Vector<Shared<Type>>.append(&mut members, run Types.intern(Type.Primitive {name: run Bytes.copy(b"i32")}))
    let unionType = run Types.intern(Type.Union {members: move members})
    let unionGlue = run Semantic.demandGlueMir(&mut store, &mut request, &unionType, &sourceOwner)
    run Testing.expect(succeeded(&unionGlue) && run callableUnionGlueSelectsCapturedMember(&store, &unionGlue, &value, &unionType),
      "a callable union drops only its active captured environment through that environment's exact glue")
  } else { run Testing.expect(false, "the plain producer has an exact physical result") }
  let invalid = run Semantic.demandBody(&mut store, &mut request, &id, b"invalid")
  run Testing.expect(rejectsSpan(&invalid, RejectionCode.ExplicitMoveRequired, text, "owned", usize.ONE),
    "a plain return cannot copy a locally owned affine environment (OWN0003)")
}

fn plainCallableMirResultType(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> Option<Shared<Type>> {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      return Option<Shared<Type>>.some(Shared<Type>.clone(&function.result))
    }
  }
  return Option<Shared<Type>>.none()
}

test effect fn rawOwnedCallableReturnKeepsBootstrapIdentityGuard() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
