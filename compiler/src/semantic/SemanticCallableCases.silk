effect fn contextualGenericSectionDiagnosticClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("contextual-generic-section-diagnostics.silk")
  let text = """
interface Permit {}
impl Permit for i32 {}
fn select<T>(value: T, enabled: bool) -> T { return move value }
fn permitted<T: Permit>(value: T, enabled: bool) -> T { return move value }
fn exclusive<T>(value: &'static mut T, enabled: bool) -> () { return () }
fn boolean(callback: fn<'static>(bool) -> bool) -> bool { return callback(true) }
fn mismatch(callback: fn<'static>(i32) -> bool) -> bool { return callback(1) }
fn shared(callback: fn<'static>(&'static i32) -> ()) -> () { return () }
fn badBound() -> bool { let boundSection = permitted(true) return boolean(boundSection) }
fn badSignature() -> bool { let signatureSection = select(true) return mismatch(signatureSection) }
fn badAccess() -> () { let accessSection = exclusive(true) shared(accessSection) }
fn good() -> bool { let validSection = select(true) return boolean(validSection) }
fn repeated<A, B>(value: A, left: B, right: B, last: i32) -> A { drop left drop right return move value }
fn stageRepeated<F: fn<'static>(i32, i32, bool) -> i32>(callback: F) -> i32 {
  let next = callback(1, true)
  return next(42)
}
fn badRepeated() -> i32 { let repeatedSection = repeated(0) return stageRepeated(repeatedSection) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let bound = run Semantic.demandBody(&mut store, &mut request, &id, b"badBound")
  let signature = run Semantic.demandBody(&mut store, &mut request, &id, b"badSignature")
  let access = run Semantic.demandBody(&mut store, &mut request, &id, b"badAccess")
  let good = run Semantic.demandBody(&mut store, &mut request, &id, b"good")
  let repeated = run Semantic.demandBody(&mut store, &mut request, &id, b"badRepeated")
  run Testing.expect(rejectsSpan(&bound, RejectionCode.IncompatibleCallableSignature, text, "boundSection", usize.ONE),
    "a target with an unsatisfied deferred bound cannot satisfy the inferred callable promise at the argument span")
  run Testing.expect(rejectsSpan(&signature, RejectionCode.IncompatibleCallableSignature, text, "signatureSection", usize.ONE),
    "a schema cannot independently choose inconsistent parameter and result types")
  run Testing.expect(rejectsSpan(&access, RejectionCode.IncompatibleCallableSignature, text, "accessSection", usize.ONE),
    "referent inference cannot make an exclusive-reference target accept a shared-reference promise")
  run Testing.expect(succeeded(&good), "failed contextual admission does not specialize or poison another schema")
  run Testing.expect(rejectsSpan(&repeated, RejectionCode.TypeArgumentInference, text, "stageRepeated(repeatedSection)", usize.ZERO),
    "a repeated target binder cannot admit inconsistent stored suffix types through a contextual promise")
}

