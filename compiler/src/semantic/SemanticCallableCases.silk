effect fn genericOwnedSectionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("generic-owned-section.silk")
  let text = """
struct Token { value: i32 }
impl Intrinsic.Drop for Token { fn drop(self: &mut Token) -> () { return () } }
fn choose<T>(value: T, token: Token) -> T { drop token return move value }
fn main(token: Token) -> i32 { let next = choose(move token) return next(42) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let caller = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&caller) && sectionInvocationCount(&store, &caller, b"choose", true) == usize.ONE
    && glueFact(&store, &caller, usize.ZERO) == usize.ZERO,
    "the generic once-section moves its owned field to the original target and retains no caller cleanup")
  let environment = genericSectionEnvironment(&store, &caller)
  if let Option<Shared<Type>>.Some {value: ty} = move environment {
  let sourceOwner = run glueSourceOwner(&mut store, &caller)
    let glue = run Semantic.demandGlueMir(&mut store, &mut request, &ty, &sourceOwner)
    run Testing.expect(succeeded(&glue) && glueFact(&store, &glue, usize.ZERO) == usize.ONE
      && glueFact(&store, &glue, 3) == usize.ZERO && glueFact(&store, &glue, 6) == usize.ONE,
      "an uninvoked generic section's drop glue owns exactly capture field zero")
  } else { run Testing.expect(false, "the generic once-section keeps its exact owned capture environment") }
  if let Option<Shared<SpecializationApplication>>.Some {value} = move namedMirApplication(&store, &caller, b"choose") {
    let application = run SpecializationApplication.copyShared(&value)
    let implementation = run Semantic.demandApplicationMir(&mut store, &mut request, &application)
    run Testing.expect(succeeded(&implementation) && glueFact(&store, &implementation, usize.ZERO) == usize.ONE,
      "the target drops the transferred capture exactly once")
    return ()
  }
  run Testing.expect(false, "owned captures select a complete ordinary function instance")
}

