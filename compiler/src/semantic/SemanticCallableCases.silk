fn payloadBound<'p, 'view, 'wire>(owned: &'p mut Pocket<'view, Wire<'wire>>) -> i32 { return orderedPocket(move owned) }
union Next<'r, C> { More { chain: &'r C }, End }
struct Chain<'r, 't> {
