}

effect fn plainCallableReturnStorageClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("plain-callable-return.silk")
  let text = """
fn inc2(value: i32) -> i32 { return value + 2 }
fn add(value: i32, offset: i32) -> i32 { return value + offset }
fn named() -> fn<'static>(i32) -> i32 { return inc2 }
fn anonymous(offset: i32) -> fn<'static>(i32) -> i32 {
  return fn(value: i32) -> i32 { return value + offset }
}
fn section(offset: i32) -> fn<'static>(i32) -> i32 { return add(offset) }
fn pass<'env>(operation: fn<'env>(i32) -> i32) -> fn<'env>(i32) -> i32 { return operation }
fn main() -> i32 {
  let namedValue = named()
  let anonymousValue = anonymous(2)
  let sectionValue = section(2)
  return namedValue(1) + anonymousValue(1) + sectionValue(1) + pass(inc2)(33)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let entry = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&entry), "plain callable results retain their original direct environment ABI")
  let named = run Semantic.demandMir(&mut store, &mut request, &id, b"named")
  let anonymous = run Semantic.demandMir(&mut store, &mut request, &id, b"anonymous")
  let section = run Semantic.demandMir(&mut store, &mut request, &id, b"section")
  run Testing.expect(plainCallableMirResult(&store, &named, b"inc2", usize.ZERO, false)
    && plainCallableMirResult(&store, &anonymous, b"", usize.ONE, true)
    && plainCallableMirResult(&store, &section, b"add", usize.ONE, false),
    "named, anonymous and section producers return their exact original capture records")
  run Testing.expect(sectionInvocationCount(&store, &entry, b"add", false) == usize.ONE,
    "a plain returned section appends its stored original target argument")
  if let Option<Shared<SpecializationApplication>>.Some {value} = move namedMirApplication(&store, &entry, b"pass") {
    let application = run SpecializationApplication.copyShared(&value)
    let forwarded = run Semantic.demandApplicationMir(&mut store, &mut request, &application)
    run Testing.expect(plainCallableMirResult(&store, &forwarded, b"inc2", usize.ZERO, false),
      "the complete relay application selects its hidden original callable representation")
  } else { run Testing.expect(false, "the relay retains its complete ordinary application") }
  let signature = run Semantic.demandSignature(&mut store, &mut request, &id, b"named")
  let written = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(&signature, signatureResult)
  if let Option<Shared<Type>>.Some {value} = move written {
    run Testing.expect(Shared<Type>.with<bool>(&value, fn(ty: &Type) -> bool {
      return match &ty.* { Type.Callable {..} => true _ => false }
    }), "ordinary callable signatures retain their authored contract without a generative opaque family")
  } else { run Testing.expect(false, "the ordinary source result is retained") }
}

fn plainCallableMirResult(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>,
  target: &[u8], captures: usize, anonymous: bool) -> bool {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      return Shared<Type>.with<bool>(&function.result, fn(value: &Type) -> bool {
        return plainCallableResultType(value, target, captures, anonymous)
      })
    }
  }
  return false
}

fn plainCallableResultType(value: &Type, target: &[u8], captures: usize, anonymous: bool) -> bool {
  if let Type.CallableValue {application, captures: fields, ..} = &value.* {
    if Vector<Shared<Type>>.length(&fields) != captures { return false }
    return Shared<SpecializationApplication>.with<bool>(&application,
      fn(selected: &SpecializationApplication) -> bool {
        let identity = SpecializationApplication.bodyDeclaration(selected)
        if anonymous { return DeclarationId.kind(identity) == OwnerKind.Anonymous }
        return DeclarationId.named(identity, target)
      })
  }
  return false
}

