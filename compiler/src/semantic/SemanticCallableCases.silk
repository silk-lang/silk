effect fn genericConstrainedSectionClaims(text: string<'static>) -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("generic-constrained-section.silk")
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let caller = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&caller), "an authored callable representation's contract exposes its remaining target variables")
  if let Option<Shared<Type>>.Some {value: ty} = move genericSectionEnvironment(&store, &caller) {
    run Testing.expect(!Type.hasOpenRuntimeParameters(&ty) && Shared<Type>.with<bool>(&ty, genericConstrainedSectionBlueprint),
      "both authored binders remain bound schema metadata instead of becoming incomplete runtime arguments")
    return ()
  }
  run Testing.expect(false, "construction retains an exact constrained callable section environment")
}

fn genericConstrainedSectionBlueprint(value: &Type) -> bool {
  if let Type.CallableSchema {schema, captures, ..} = &value.* {
    if Vector<Shared<Type>>.length(&captures) != usize.ONE { return false }
    return Shared<SectionSchema>.with<bool>(&schema, fn(recipe: &SectionSchema) -> bool {
      let deferred = Vector<usize>.asSlice(&recipe.deferred)
      return Vector<Binding>.length(&recipe.selected) == usize.ZERO && deferred.length == 2
        && deferred[usize.ZERO] == usize.ZERO && deferred[usize.ONE] == usize.ONE
    })
  }
  return false
}

effect fn genericHigherOrderSectionClaims(text: string<'static>, target: &[u8]) -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("generic-higher-order-section.silk")
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let caller = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&caller), "written callable parameter shapes still expose target variables after representation reification")
  if let Option<Shared<SpecializationApplication>>.Some {value} = move namedMirApplication(&store, &caller, target) {
    let application = run SpecializationApplication.copyShared(&value)
    let implementation = run Semantic.demandApplicationMir(&mut store, &mut request, &application)
    let direct = match move anonymousMirApplication(&store, &implementation) { Option<Shared<SpecializationApplication>>.Some {..} => true _ => false }
    run Testing.expect(succeeded(&implementation) && direct,
      "the complete higher-order target retains the exact anonymous representation and invokes it directly")
    return ()
  }
  run Testing.expect(false, "a written higher-order section selects an ordinary complete target application")
}

