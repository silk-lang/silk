effect fn effectJoinCleanupClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("effect-join-cleanup.silk")
  let text = """
struct Token { value: i32 }
impl Intrinsic.Drop for Token { fn drop(self: &mut Token) -> () { return () } }
struct First {}
struct Second {}
effect fn withToken(token: Token) -> i32 { return token.value }
fn owned(flag: bool) -> once Effect<'static; i32> {
  if flag { return withToken(Token { value: 1 }) }
  return effect { return 2 }
}
fn abandoned() -> i32 { drop owned(true) return 0 }
fn nested(flag: bool, input: First | Second) -> Effect<'static; i32> {
  if flag { return effect { return 1 } }
  return match move input { First {} => effect { return 2 } Second {} => effect { return 3 } }
}
fn mixed(input: First | Second) -> i32 {
  let picked = match move input { First {} => effect { return 1 } Second {} => 2 }
  return 0
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let owned = run Semantic.demandMir(&mut store, &mut request, &id, b"owned")
  let abandoned = run Semantic.demandMir(&mut store, &mut request, &id, b"abandoned")
  run Testing.expect(succeeded(&abandoned) && glueFact(&store, &abandoned, 6) == usize.ONE,
    "an unrun join is dropped through its storage glue")
  if let Option<Shared<Type>>.Some {value} = move plainCallableMirResultType(&store, &owned) {
  let sourceOwner = run glueSourceOwner(&mut store, &owned)
    let glue = run Semantic.demandGlueMir(&mut store, &mut request, &value, &sourceOwner)
    run Testing.expect(succeeded(&glue) && switchCount(&store, &glue) == usize.ONE && glueFact(&store, &glue, 6) == usize.ONE,
      "join glue switches on the tag and drops only the alternative that owns cleanup")
  } else { run Testing.expect(false, "the owned producer returns its join storage") }
  let nested = run Semantic.demandBody(&mut store, &mut request, &id, b"nested")
  let mixed = run Semantic.demandBody(&mut store, &mut request, &id, b"mixed")
  run Testing.expect(rejectsSpan(&nested, RejectionCode.NestedEffectJoinUnavailable, text,
      "match move input { First {} => effect { return 2 } Second {} => effect { return 3 } }", 0)
    && rejectsSpan(&mixed, RejectionCode.IncompatibleMatchResults, text, "match move input { First {} => effect { return 1 } Second {} => 2 }", 0),
    "re-injecting a returned join is the named nested-join gap, and an Effect cannot join a value")
}

test effect fn effectJoinsAdmitOnlyCoveredEffects() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
