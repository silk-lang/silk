// Unbounded owned contents may be captured for finite body use. Their validity remains an
// explicit obligation, and substitution must not hide a concrete loan behind the parameter.
test effect fn genericOwnedCapturesRetainLocalContentsAndSubstitutedLoans() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let text = """
fn pair<T>(first: T, second: T) -> T { drop second return move first }
fn borrow<'a>(value: &'a i32) -> i32 { return value.* }
fn choose<T>(left: T, right: T) -> T {
  let finish = pair(move right)
  return finish(move left)
}
"""
  return run genericLocalContentsClaims(text, b"choose", false) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn abstractCallableStagesRetainNewlySubstitutedCaptureLoans() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let text = """
fn borrow<'a>(value: &'a i32) -> i32 { return value.* }
fn choose<T, F: once fn(T, T) -> T>(callback: F, left: T, right: T) -> T {
  let finish = callback(move right)
  return finish(move left)
}
"""
  return run genericLocalContentsClaims(text, b"choose", true) |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn genericLocalContentsClaims(text: string<'static>, name: &[u8], staged: bool) -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("generic-local-contents.silk")
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let answer = run Semantic.demandBody(&mut store, &mut request, &id, name)
  let body = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move body {
    let section = Shared<TypedBody>.with<Option<Shared<Type>>>(&value, genericLocalContentsSection)
    if let Option<Shared<Type>>.Some {value: environment} = move section {
      let checked = Shared<TypedBody>.with<bool>(&value,
        fn(body: &TypedBody) -> bool { return genericLocalContentsObligation(body, &environment) })
      run Testing.expect(checked, "generic capture retains exact T, once mode, a local region and a non-premise Contents obligation")
      let signature = run Semantic.demandSignature(&mut store, &mut request, &id, name)
      run Testing.expect(Shared<Result<Answer, NoRejection>>.with<bool>(&signature, genericLocalContentsNoPremise),
        "body-local Contents obligations never become universally usable declaration premises")
      if staged {
        run Testing.expect(run genericLocalStageRetainsBaseRegion(&environment, &signature),
          "abstract staging retains its declared base environment alongside the new local contents obligation")
      }
      let captured = Shared<Type>.with<Option<Shared<Type>>>(&environment, genericLocalContentsCapture)
      if let Option<Shared<Type>>.Some {value: parameter} = move captured {
        let binder = match move run Type.copy(&parameter) {
          Type.Parameter {declaration, ordinal} => Binding {declaration: run Shared<DeclarationId>.make(move declaration),
            ordinal: ordinal, value: Argument.Type {value: run Types.intern(Type.Unit)}}
          _ => { run Testing.expect(false, "the capture retains its original parameter")
            return () }
        }
        let owner = DeclarationId.copyShared(&binder.declaration)
        let borrowSignature = run Semantic.demandSignature(&mut store, &mut request, &id, b"borrow")
        let borrow = match move slotOf(&borrowSignature, usize.ZERO) {
          Option<Shared<Type>>.Some {value: borrowedSlot} => move borrowedSlot
          _ => { run Testing.expect(false, "a written borrow signature supplies real retained region evidence")
            return () }
        }
        let region = match move Shared<Type>.with<Option<Shared<Lifetime>>>(&borrow, genericLocalContentsBorrowRegion) {
          Option<Shared<Lifetime>>.Some {value: borrowRegion} => move borrowRegion
          _ => { run Testing.expect(false, "the written reference retains its lifetime binder")
            return () }
        }
        let mut bindings = Vector<Binding>.make()
        run Vector<Binding>.append(&mut bindings, Binding {declaration: Shared<DeclarationId>.clone(&binder.declaration),
          ordinal: binder.ordinal, value: Argument.Type {value: Shared<Type>.clone(&borrow)}})
        let selected = run Type.applyBindings(&environment, Vector<Binding>.asSlice(&bindings), true)
        let representations = Vector<Option<Shared<Type>>>.make()
        let mut regions = Vector<Shared<Lifetime>>.make()
        let known = run Type.retainedRegions(&selected, &owner, Vector<Option<Shared<Type>>>.asSlice(&representations), &mut regions)
        run Testing.expect(known && (!staged || Shared<Type>.with<bool>(&selected, genericLocalContentsIsStage)) && genericLocalContentsRegions(Vector<Shared<Lifetime>>.asSlice(&regions), &region),
          "substitution reveals the concrete capture loan while retaining the conservative local-only restriction")
        if !staged {
          let copied = run Type.copy(&environment)
          if let Type.CallableValue {application, contract, captures, fieldInputs, ..} = move copied {
            let target = run SpecializationApplication.copyShared(&application)
            let identity = SpecializationApplication.bodyDeclaration(&target)
            let blueprint = run Type.renameParameters(&contract, &owner, identity)
            let mut selectedEvidence = Vector<Binding>.make()
            run Vector<Binding>.append(&mut selectedEvidence, Binding {
              declaration: run Shared<DeclarationId>.make(DeclarationId.copy(identity)), ordinal: usize.ZERO,
              value: Argument.Type {value: Shared<Type>.clone(&parameter)}})
            let schema = run Type.callableSchema(run Shared<SectionSchema>.make(SectionSchema {
              target: run Shared<DeclarationId>.make(DeclarationId.copy(identity)), contract: move blueprint,
              selected: move selectedEvidence, deferred: Vector<usize>.make()}), move captures, move fieldInputs)
            let closedSchema = run Type.applyBindings(&schema, Vector<Binding>.asSlice(&bindings), true)
            let mut schemaRegions = Vector<Shared<Lifetime>>.make()
            let schemaKnown = run Type.retainedRegions(&closedSchema, &owner,
              Vector<Option<Shared<Type>>>.asSlice(&representations), &mut schemaRegions)
            run Testing.expect(schemaKnown && genericLocalContentsRegions(Vector<Shared<Lifetime>>.asSlice(&schemaRegions), &region),
              "schema substitution rebuilds the capture environment while the original target blueprint remains bound")
          } else { run Testing.expect(false, "the original exact section can retain a schema blueprint") }
        }
        let mut members = Vector<Shared<Type>>.make()
        run Vector<Shared<Type>>.append(&mut members, Shared<Type>.clone(&parameter))
        run Vector<Shared<Type>>.append(&mut members, move borrow)
        let mixed = run Types.intern(Type.Union {members: move members})
        let mut retained = Vector<Shared<Lifetime>>.make()
        let complete = run Type.retainedRegions(&mixed, &owner, Vector<Option<Shared<Type>>>.asSlice(&representations), &mut retained)
        run Testing.expect(!complete && genericLocalContentsContains(Vector<Shared<Lifetime>>.asSlice(&retained), &region),
          "an unknown earlier union member does not suppress a later concrete retained loan")
        return ()
      }
    }
  }
  run Testing.expect(false, "generic section body is admitted with retained contents evidence")
}

fn genericLocalContentsSection(body: &TypedBody) -> Option<Shared<Type>> {
  let nodes = TypedBody.nodeSlice(body)
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form} = &nodes[at].kind {
      let constructed = match &form { BodyExpression.Aggregate {..} => true BodyExpression.StagedCallable {..} => true _ => false }
      if constructed && (Shared<Type>.with<bool>(&ty, exactCallableValue) || Shared<Type>.with<bool>(&ty, genericLocalContentsIsStage)) { return Option<Shared<Type>>.some(Shared<Type>.clone(&ty)) }
    }
    at = at + usize.ONE
  }
  return Option<Shared<Type>>.none()
}

fn genericLocalContentsCapture(value: &Type) -> Option<Shared<Type>> {
  return match &value.* {
    Type.CallableValue {captures, ..} => genericLocalContentsField(&captures)
    Type.CallableStage {captures, ..} => genericLocalContentsField(&captures)
    _ => Option<Shared<Type>>.none()
  }
}

fn genericLocalContentsField(captures: &Vector<Shared<Type>>) -> Option<Shared<Type>> {
  let fields = Vector<Shared<Type>>.asSlice(captures)
  if fields.length == usize.ONE { return Option<Shared<Type>>.some(Shared<Type>.clone(&fields[usize.ZERO])) }
  return Option<Shared<Type>>.none()
}

fn genericLocalContentsContract(value: &Type) -> bool {
  if let Type.Callable {mode, environment, ..} = &value.* {
    return mode == CallableMode.Once && Shared<Intersection>.with<bool>(&environment, genericLocalContentsIntersection)
  }
  return false
}

fn genericLocalContentsIntersection(value: &Intersection) -> bool {
  let members = Vector<LifetimeMember>.asSlice(&value.members)
  let mut at = usize.ZERO
  while at < members.length {
    if Shared<Lifetime>.with<bool>(&members[at].region, genericSectionLocalRegion) { return true }
    at = at + usize.ONE
  }
  return false
}

fn genericLocalContentsObligation(body: &TypedBody, environment: &Shared<Type>) -> bool {
  if !borrowNotChecked(body) { return false }
  let exact = Shared<Type>.with<bool>(environment, genericLocalContentsMode)
  let capture = match move Shared<Type>.with<Option<Shared<Type>>>(environment, genericLocalContentsCapture) {
    Option<Shared<Type>>.Some {value} => move value _ => { return false }
  }
  let stage = TypedBody.checkingStage(body)
  if let BodyStage.ContractTyped {obligations} = &stage.* {
    let entries = Vector<BodySafetyObligation>.asSlice(&obligations)
    let mut at = usize.ZERO
    while at < entries.length {
      if let BodySafetyObligation.Contents {subject, region, origin} = &entries[at] {
        let parameter = sameRepresentationParameter(&subject, &capture) && Shared<Type>.with<bool>(&subject,
          fn(ty: &Type) -> bool { return Type.parameterOrdinalOf(ty, TypedBody.declarationId(body)) == usize.ZERO })
        let local = Shared<Lifetime>.with<bool>(&region, fn(ty: &Lifetime) -> bool {
          return match &ty.* { Lifetime.Local {declaration, ordinal} => ordinal == origin.node
            && DeclarationId.equals(&declaration, TypedBody.declarationId(body)) _ => false }
        })
        if parameter && local { return exact }
      }
      at = at + usize.ONE
    }
  }
  return false
}

fn genericLocalContentsBorrowRegion(value: &Type) -> Option<Shared<Lifetime>> {
  return match &value.* { Type.Reference {lifetime, ..} => Option<Shared<Lifetime>>.some(Shared<Lifetime>.clone(&lifetime)) _ => Option<Shared<Lifetime>>.none() }
}

fn genericLocalContentsNoPremise(answer: &Result<Answer, NoRejection>) -> bool {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Signature {signature}} = &value.outcome {
      let constraints = Vector<Constraint>.asSlice(&signature.constraints)
      let parameters = Vector<Shared<Type>>.asSlice(&signature.typeParameters)
      if parameters.length == usize.ZERO { return false }
      let mut at = usize.ZERO
      while at < constraints.length {
        if let Constraint.Contents {subject, ..} = &constraints[at] {
          if sameRepresentationParameter(&subject, &parameters[usize.ZERO]) { return false }
        }
        at = at + usize.ONE
      }
      return true
    }
  }
  return false
}

fn genericLocalContentsMode(value: &Type) -> bool {
  return match &value.* { Type.CallableValue {contract, ..} => Shared<Type>.with<bool>(&contract, genericLocalContentsContract) Type.CallableStage {contract, ..} => Shared<Type>.with<bool>(&contract, genericLocalContentsContract) _ => false }
}

fn genericLocalContentsIsStage(value: &Type) -> bool {
  return match &value.* { Type.CallableStage {base, ..} => Shared<Type>.with<bool>(&base, genericLocalContentsIsParameter) _ => false }
}

fn genericLocalContentsIsParameter(value: &Type) -> bool {
  return match &value.* { Type.Parameter {..} => true _ => false }
}

fn genericLocalContentsContains(regions: &[Shared<Lifetime>], wanted: &Shared<Lifetime>) -> bool {
  let mut at = usize.ZERO
  while at < regions.length {
    if Lifetime.equalsShared(&regions[at], wanted) { return true }
    at = at + usize.ONE
  }
  return false
}

fn genericLocalContentsRegions(regions: &[Shared<Lifetime>], wanted: &Shared<Lifetime>) -> bool {
  let mut local = false
  let mut at = usize.ZERO
  while at < regions.length {
    if Shared<Lifetime>.with<bool>(&regions[at], genericSectionLocalRegion) { local = true }
    at = at + usize.ONE
  }
  return local && genericLocalContentsContains(regions, wanted)
}

test effect fn genericLocalCaptureCannotEstablishStaticCallablePromise() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("generic-local-capture-promise.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
fn keep<T>(value: i32, held: T) -> i32 { drop held return value }
fn require<F: once fn<'static>(i32) -> i32>(callback: F) -> i32 { return callback(42) }
fn refuse<T>(held: T) -> i32 {
  let unresolved = keep(move held)
  return require(move unresolved)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let answer = run Semantic.demandBody(&mut store, &mut request, &id, b"refuse") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&answer, RejectionCode.Unsupported, text, "move unresolved", usize.ZERO),
    "local owned contents do not silently become a public static environment promise")
}

test effect fn nestedGenericLocalCaptureKeepsPublicEscapeGap() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("nested-generic-local-capture.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
fn keep<T>(value: i32, held: T) -> i32 { drop held return value }
fn wrap<A>(value: i32, packet: A) -> i32 { drop packet return value }
fn require<F: once fn<'static>(i32) -> i32>(callback: F) -> i32 { return callback(42) }
fn refuse<T>(held: T) -> i32 {
  let inner = keep(move held)
  let packet = .{callback: move inner}
  let outer = wrap(move packet)
  return require(move outer)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu)) |> Effect.provideMut<Allocator>(&mut allocator)
  let mut request = Request.make()
  let answer = run Semantic.demandBody(&mut store, &mut request, &id, b"refuse") |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
  run Testing.expect(rejectsSpan(&answer, RejectionCode.Unsupported, text, "move outer", usize.ZERO),
    "stored aggregate wrappers preserve the unresolved inner callable contents gap at the public promise")
}

test effect fn genericOwnedCaptureTransfersCleanupToOriginalTarget() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run genericLocalCaptureCleanupClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn genericLocalCaptureCleanupClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("generic-local-capture-cleanup.silk")
  let text = """
struct Token { value: i32 }
impl Intrinsic.Drop for Token { fn drop(self: &mut Token) -> () { return () } }
fn pair<T>(first: T, second: T) -> T { drop second return move first }
fn choose<T>(left: T, right: T) -> T {
  let finish = pair(move right)
  return finish(move left)
}
fn main(left: Token, right: Token) -> Token { return choose(move left, move right) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let caller = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  if let Option<Shared<SpecializationApplication>>.Some {value} = move namedMirApplication(&store, &caller, b"choose") {
    let application = run SpecializationApplication.copyShared(&value)
    let selected = run Semantic.demandApplicationMir(&mut store, &mut request, &application)
    run Testing.expect(succeeded(&caller) && succeeded(&selected) && glueFact(&store, &selected, usize.ZERO) == usize.ZERO
      && sectionInvocationCount(&store, &selected, b"pair", true) == usize.ONE,
      "the generic once section moves its field directly to the original pair target without residual caller cleanup")
    if let Option<Shared<SpecializationApplication>>.Some {value: pair} = move namedMirApplication(&store, &selected, b"pair") {
      let target = run SpecializationApplication.copyShared(&pair)
      let implementation = run Semantic.demandApplicationMir(&mut store, &mut request, &target)
      run Testing.expect(succeeded(&implementation) && glueFact(&store, &implementation, usize.ZERO) == usize.ONE,
        "the original target owns exactly the second captured token's drop")
      return ()
    }
  }
  run Testing.expect(false, "the generic owned capture has complete ordinary caller and target applications")
}

// The unknown base F has its own declared environment; adding a local T capture must keep it.
effect fn genericLocalStageRetainsBaseRegion(environment: &Shared<Type>, signature: &Shared<Result<Answer, NoRejection>>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let base = Shared<Type>.with<Option<Shared<Type>>>(environment, fn(value: &Type) -> Option<Shared<Type>> {
    return match &value.* { Type.CallableStage {base, ..} => Option<Shared<Type>>.some(Shared<Type>.clone(&base))
      _ => Option<Shared<Type>>.none() }
  })
  if let Option<Shared<Type>>.Some {value: parameter} = move base {
    let contract = Shared<Result<Answer, NoRejection>>.with<Option<Shared<Type>>>(signature,
      fn(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
        if let Result<Answer, NoRejection>.Success {value} = &answer.* {
          if let Outcome.Success {value: Value.Signature {signature: header}} = &value.outcome {
            let bounds = Vector<Constraint>.asSlice(&header.constraints)
            let mut at = usize.ZERO
            while at < bounds.length {
              if let Constraint.Represents {parameter: declared, contract} = &bounds[at] {
                if sameRepresentationParameter(&parameter, &declared) { return Option<Shared<Type>>.some(Shared<Type>.clone(&contract)) }
              }
              at = at + usize.ONE
            }
          }
        }
        return Option<Shared<Type>>.none()
      })
    if let Option<Shared<Type>>.Some {value: declared} = move contract {
      let owner = match move run Type.copy(&parameter) {
        Type.Parameter {declaration, ..} => move declaration _ => { return false }
      }
      let representations = Vector<Option<Shared<Type>>>.make()
      let mut original = Vector<Shared<Lifetime>>.make()
      let mut retained = Vector<Shared<Lifetime>>.make()
      if !run Type.retainedRegions(&declared, &owner, Vector<Option<Shared<Type>>>.asSlice(&representations), &mut original) { return false }
      if !run Type.retainedRegions(environment, &owner, Vector<Option<Shared<Type>>>.asSlice(&representations), &mut retained) { return false }
      let regions = Vector<Shared<Lifetime>>.asSlice(&original)
      if regions.length == usize.ZERO { return false }
      let mut at = usize.ZERO
      while at < regions.length {
        if !genericLocalContentsContains(Vector<Shared<Lifetime>>.asSlice(&retained), &regions[at]) { return false }
        at = at + usize.ONE
      }
      return true
    }
  }
  return false
}

// A generic section's blueprint remains deferred when the consumer's promise is compared. Its
// newly supplied suffix must then select original target slots before runtime layout or calls.
test effect fn abstractCallableStagingSelectsSchemaSuffixEvidence() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run abstractSchemaStagingClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn abstractSchemaStagingClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("abstract-schema-staging.silk")
  let text = """
fn first<A, B>(value: A, ignored: B, last: i32) -> A { drop ignored return move value }
fn invoke<F: fn<'static>(i32, i32) -> i32>(callback: F) -> i32 {
  let next = callback(2)
  return next(40)
}
fn main() -> i32 { return invoke(first(0)) }
fn invokeOnce<F: once fn<'static>(i32, i32) -> i32>(callback: F) -> i32 {
  let next = callback(2)
  return next(40)
}
fn mainOnce() -> i32 { return invokeOnce(first(0)) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let entry = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&entry), "the comparison promise leaves the original section blueprint available")
  let selected = namedMirApplication(&store, &entry, b"invoke")
  if let Option<Shared<SpecializationApplication>>.Some {value} = move selected {
    let application = run SpecializationApplication.copyShared(&value)
    let body = run Semantic.demandApplicationMir(&mut store, &mut request, &application)
    run Testing.expect(succeeded(&body), "the closed abstract parameter stages its original schema")
    run Testing.expect(abstractStagedSchemaStorage(&store, &body),
      "the exact environment retains two captures, fixes original B and leaves only A deferred")
    run Testing.expect(abstractStagedSchemaTargetCount(&store, &body, false) == usize.ONE,
      "the direct original target receives the leading value, newly stored argument, then original suffix")
  } else { run Testing.expect(false, "the consumer retains its complete ordinary application") }
  let onceEntry = run Semantic.demandMir(&mut store, &mut request, &id, b"mainOnce")
  run Testing.expect(succeeded(&onceEntry), "a shared section satisfies a consuming comparison promise")
  if let Option<Shared<SpecializationApplication>>.Some {value} = move namedMirApplication(&store, &onceEntry, b"invokeOnce") {
    let application = run SpecializationApplication.copyShared(&value)
    let body = run Semantic.demandApplicationMir(&mut store, &mut request, &application)
    run Testing.expect(succeeded(&body) && abstractStagedSchemaMode(&store, &body, CallableMode.Shared)
      && abstractStagedSchemaTargetCount(&store, &body, false) == usize.ONE && abstractSchemaBaseTransfer(&store, &body),
      "the promised once transport moves the base while exact shared storage copies its suffix on invocation")
  } else { run Testing.expect(false, "the consuming promise retains its ordinary consumer application") }
}

fn abstractStagedSchemaMode(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, mode: CallableMode) -> bool {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let locals = Vector<MirLocal>.asSlice(&function.locals)
      let mut at = usize.ZERO
      while at < locals.length {
        let selected = Shared<Type>.with<bool>(&locals[at].ty,
          fn(value: &Type) -> bool { return abstractStagedSchemaModeType(value, mode) })
        if selected { return true }
        at = at + usize.ONE
      }
    }
  }
  return false
}

fn abstractStagedSchemaModeType(value: &Type, mode: CallableMode) -> bool {
  if let Type.CallableSchema {schema, captures, ..} = &value.* {
    return Vector<Shared<Type>>.length(&captures) == 2 && Shared<SectionSchema>.with<bool>(&schema,
      fn(value: &SectionSchema) -> bool { return abstractSchemaRecipeMode(value, mode) })
  }
  return false
}

fn abstractSchemaRecipeMode(value: &SectionSchema, mode: CallableMode) -> bool {
  return Shared<Type>.with<bool>(&value.contract,
    fn(value: &Type) -> bool { return match &value.* { Type.Callable {mode: actual, ..} => actual == mode _ => false } })
}

fn abstractSchemaBaseTransfer(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        let statements = Vector<MirStatement>.asSlice(&blocks[at].statements)
        let mut step = usize.ZERO
        while step < statements.length {
          if let MirStatement.Assign {value: MirRvalue.Aggregate {fields}, ..} = &statements[step] {
            let values = Vector<MirAggregateField>.asSlice(&fields)
            if values.length == 2 {
              if let MirOperand.Move {place} = &values[usize.ZERO].value {
                if Vector<MirProjection>.length(&place.projections) == usize.ONE
                  && lastProjectionCode(&place.projections) == usize.ZERO { return true }
              }
            }
          }
          step = step + usize.ONE
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}

fn abstractStagedSchemaStorage(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let locals = Vector<MirLocal>.asSlice(&function.locals)
      let mut at = usize.ZERO
      while at < locals.length {
        if Shared<Type>.with<bool>(&locals[at].ty, abstractStagedSchemaType) { return true }
        at = at + usize.ONE
      }
    }
  }
  return false
}

fn abstractStagedSchemaType(value: &Type) -> bool {
  if let Type.CallableSchema {schema, captures, fieldInputs, ..} = &value.* {
    let fields = Vector<CallableFieldInput>.asSlice(&fieldInputs)
    if Vector<Shared<Type>>.length(&captures) != 2 || fields.length != 2 { return false }
    let original = match &fields[usize.ZERO] {
      CallableFieldInput.Argument {parameter} => parameter == 2 _ => false }
    let appended = match &fields[usize.ONE] {
      CallableFieldInput.Argument {parameter} => parameter == usize.ONE _ => false }
    return original && appended && Shared<SectionSchema>.with<bool>(&schema, abstractStagedSchemaEvidence)
  }
  return false
}

fn abstractStagedSchemaEvidence(value: &SectionSchema) -> bool {
  let deferred = Vector<usize>.asSlice(&value.deferred)
  let selected = Vector<Binding>.asSlice(&value.selected)
  if deferred.length != usize.ONE || deferred[usize.ZERO] != usize.ZERO
    || selected.length != usize.ONE || selected[usize.ZERO].ordinal != usize.ONE { return false }
  return match &selected[usize.ZERO].value {
    Argument.Type {value: supplied} => Shared<Type>.with<bool>(&supplied, abstractStagedI32)
    _ => false
  }
}

fn abstractStagedI32(value: &Type) -> bool {
  return match &value.* { Type.Primitive {name} => sameBytes(Bytes.asSlice(&name), b"i32") _ => false }
}

fn abstractStagedSchemaTargetCount(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, consumes: bool) -> usize {
  let mut count = usize.ZERO
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, arguments, ..} = &blocks[at].terminator {
          let identity = InstanceKey.identity(&key)
          let target = Shared<DeclarationId>.with<bool>(&identity, fn(value: &DeclarationId) -> bool {
            return DeclarationId.named(value, b"first")
          })
          let supplied = Vector<MirOperand>.asSlice(&arguments)
          if target && supplied.length == 3
            && genericStagingOperand(&supplied[usize.ONE], usize.ONE, consumes)
            && genericStagingOperand(&supplied[2], usize.ZERO, consumes) {
            count = count + usize.ONE
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return count
}

