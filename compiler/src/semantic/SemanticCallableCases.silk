effect fn namedFunctionValueClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("named-function-values.silk")
  let text = """
fn namedZero() -> i32 { return 7 }
fn makeNamedZero() -> typeof(namedZero) { return namedZero }
fn main() -> i32 { let callback = makeNamedZero() return callback() }
unsafe fn unsafeNamedZero() -> i32 { return 7 }
fn storeUnsafeNamed() -> typeof(unsafeNamedZero) { return unsafeNamedZero }
fn invokeUnsafeNamed() -> i32 { let callback = unsafeNamedZero return callback() }
unsafe extern "C" fn foreignNamedZero() -> i32
fn storeForeignNamed() -> () { let invalid = foreignNamedZero }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let construct = run Semantic.demandMir(&mut store, &mut request, &id, b"makeNamedZero")
  let invoke = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&construct) && namedValueConstruction(&store, &construct),
    "returning typeof(namedZero) constructs an empty environment without invoking its zero-arity target")
  run Testing.expect(succeeded(&invoke) && namedValueDirectCalls(&store, &invoke),
    "a returned named value calls its original ordinary function with no hidden environment operand or adapter")
  let unsafeConstruction = run Semantic.demandBody(&mut store, &mut request, &id, b"storeUnsafeNamed")
  let unsafeInvocation = run Semantic.demandBody(&mut store, &mut request, &id, b"invokeUnsafeNamed")
  let foreign = run Semantic.demandBody(&mut store, &mut request, &id, b"storeForeignNamed")
  run Testing.expect(succeeded(&unsafeConstruction)
    && rejectsSpan(&unsafeInvocation, RejectionCode.UnsafeAcknowledgement, text, "callback()", usize.ONE),
    "even a zero-arity unsafe function requires acknowledgement only when its stored value is invoked")
  run Testing.expect(rejectsSpan(&foreign, RejectionCode.ForeignFunctionNotFirstClass, text, "foreignNamedZero", usize.ONE),
    "a zero-arity foreign function cannot become an ordinary stored callable (SEM0189)")
}

fn genericNamedValueTargets(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let found = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move found {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut integer = false
      let mut boolean = false
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee, arguments, ..} = &blocks[at].terminator {
          let key = match &callee { MirCallee.Instance {key} => &key _ => { return false } }
          let application = match move InstanceKey.application(key) {
            Option<Shared<SpecializationApplication>>.Some {value} => move value
            _ => { return false }
          }
          let kind = Shared<SpecializationApplication>.with<usize>(&application,
            fn(value: &SpecializationApplication) -> usize {
              return genericSectionApplication(value, b"namedIdentity", usize.MAX, usize.ZERO)
            })
          if kind == usize.ZERO || Vector<MirOperand>.length(&arguments) != usize.ONE { return false }
          if kind == usize.ONE { integer = true }
          if kind == 2 { boolean = true }
        }
        at = at + usize.ONE
      }
      return integer && boolean
    }
  }
  return false
}

