effect fn abstractSchemaCleanupClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("abstract-schema-cleanup.silk")
  let text = """
struct Token { value: i32 }
impl Intrinsic.Drop for Token { fn drop(self: &mut Token) -> () { return () } }
fn first<A, B>(value: A, ignored: B, last: i32) -> A { drop ignored return move value }
fn invoke<F: fn<'static>(i32, Token) -> i32>(callback: F, token: Token, choice: i32) -> i32 {
  let next = callback(move token)
  return next(match choice {
    _ if choice == 0 => { return 9 }
    _ => 40
  })
}
fn main(token: Token, choice: i32) -> i32 { return invoke(first(0), move token, choice) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let entry = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&entry), "the abstract schema accepts an affine trailing operand")
  if let Option<Shared<SpecializationApplication>>.Some {value} = move namedMirApplication(&store, &entry, b"invoke") {
    let application = run SpecializationApplication.copyShared(&value)
    let body = run Semantic.demandApplicationMir(&mut store, &mut request, &application)
    run Testing.expect(succeeded(&body), "the affine consumer lowers")
    run Testing.expect(abstractStagedSchemaMode(&store, &body, CallableMode.Once), "the affine schema is once")
    run Testing.expect(abstractStagedSchemaTargetCount(&store, &body, true) == usize.ONE, "the affine schema moves fields in original target order")
    run Testing.expect(glueFact(&store, &body, usize.ZERO) == usize.ONE
      && run abstractSchemaExitGlue(&store, &body),
      "early return drops one whole realized schema through its exact glue key, while normal invocation transfers it")
    if let Option<Shared<SpecializationApplication>>.Some {value: selected} = move namedMirApplication(&store, &body, b"first") {
      let target = run SpecializationApplication.copyShared(&selected)
      let implementation = run Semantic.demandApplicationMir(&mut store, &mut request, &target)
      run Testing.expect(succeeded(&implementation) && glueFact(&store, &implementation, usize.ZERO) == usize.ONE,
        "the original target owns the sole normal-path Token cleanup")
      return ()
    }
  }
  run Testing.expect(false, "the affine schema retains complete consumer and original target applications")
}

effect fn abstractSchemaExitGlue(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let locals = Vector<MirLocal>.asSlice(&function.locals)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Return {..} = &blocks[at].terminator {
          let statements = Vector<MirStatement>.asSlice(&blocks[at].statements)
          let mut nine = false
          let mut exact = false
          let mut step = usize.ZERO
          while step < statements.length {
            if let MirStatement.Assign {destination, value: MirRvalue.Use {value: MirOperand.Integer {decimal, negative, ..}}, ..} = &statements[step] {
              if destination.local == usize.ZERO && !negative && sameBytes(Bytes.asSlice(&decimal), b"9") { nine = true }
            }
            if let MirStatement.Drop {destination, glue, ..} = &statements[step] {
              let ty = &locals[destination.local].ty
              if Vector<MirProjection>.length(&destination.projections) == usize.ZERO
                && Shared<Type>.with<bool>(ty, fn(value: &Type) -> bool { return abstractStagedSchemaModeType(value, CallableMode.Once) }) {
                if let Option<Shared<Type>>.Some {value: glueType} = move InstanceKey.glueType(&glue) {
                  exact = run Type.equalsShared(ty, &glueType)
                }
              }
            }
            step = step + usize.ONE
          }
          if nine && exact { return true }
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}

