}

effect fn plainCallableViewPermissionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("plain-callable-view.silk")
  let text = """
fn inc2(value: i32) -> i32 { return value + 2 }
fn returnedOnce() -> once fn<'static>(i32) -> i32 { return inc2 }
fn useShared<F: fn<'static>(i32) -> i32>(callback: F) -> i32 { return callback(40) }
fn main() -> i32 { let taken = returnedOnce() return taken(40) }
fn denied() -> i32 { let refused = returnedOnce() return useShared(move refused) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let body = run Semantic.demandBody(&mut store, &mut request, &id, b"main")
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&body, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move selected {
    run Testing.expect(Shared<TypedBody>.with<bool>(&value, plainReturnedOnceView),
      "the returned value retains Once permissions over its original Shared storage")
  } else { run Testing.expect(false, "the weaker public view has a checked body") }
  let entry = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  let producer = run Semantic.demandMir(&mut store, &mut request, &id, b"returnedOnce")
  run Testing.expect(succeeded(&entry) && plainCallableMirResult(&store, &producer, b"inc2", usize.ZERO, false),
    "source consuming permission retains the original Shared named target ABI")
  let denied = run Semantic.demandBody(&mut store, &mut request, &id, b"denied")
  run Testing.expect(rejectsSpan(&denied, RejectionCode.TypeArgumentInference, text, "useShared(move refused)", usize.ZERO),
    "a public Once result cannot gain Shared permission from its capable hidden target")
}

fn plainReturnedOnceView(body: &TypedBody) -> bool {
  let locals = TypedBody.localSlice(body)
  if locals.length != usize.ONE { return false }
  return Shared<Type>.with<bool>(&locals[usize.ZERO].ty, plainOnceViewType)
}

fn plainOnceViewType(value: &Type) -> bool {
  if let Type.CallableView {representation, contract} = &value.* {
    return Shared<Type>.with<bool>(&contract, fn(ty: &Type) -> bool {
      return match &ty.* { Type.Callable {mode, ..} => mode == CallableMode.Once _ => false }
    }) && Shared<Type>.with<bool>(&representation, plainSharedOriginType)
  }
  return false
}

fn plainSharedOriginType(ty: &Type) -> bool {
  if let Type.CallableValue {contract, ..} = &ty.* {
    return Shared<Type>.with<bool>(&contract,
      fn(source: &Type) -> bool { return match &source.* { Type.Callable {mode, ..} => mode == CallableMode.Shared _ => false } })
  }
  return false
}

