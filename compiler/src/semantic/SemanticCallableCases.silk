// An omitted bound environment is a generated binder of the declaration's contract. Construction,
// field projection and the member shape complete the same binder list, so the inferred
// application keeps one argument per binder.
effect fn callableBoundEnvironmentClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("callable-bound-environment.silk")
  let text = """
struct Runner<F: fn(i32) -> i32> { apply: F }
fn double(value: i32) -> i32 { return value * 2 }
fn constructed() -> i32 {
  let runner = Runner { apply: double }
  return runner.apply(2)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let constructed = run Semantic.demandBody(&mut store, &mut request, &id, b"constructed")
  run Testing.expect(succeeded(&constructed),
    "a struct whose callable bound omits its environment is constructed and its field called through one binder list")
}

