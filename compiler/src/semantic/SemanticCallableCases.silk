effect fn callablePipelineArityClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("callable-pipeline-arity.silk")
  let text = """
fn binary(left: i32, right: i32) -> i32 { return left + right }
fn named() -> i32 { let pending = 2 |> binary return pending(1) }
fn literal() -> i32 {
  let pending = 2 |> fn(left: i32, right: i32) -> i32 { return left + right }
  return pending(1)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let named = run Semantic.demandBody(&mut store, &mut request, &id, b"named")
  let literal = run Semantic.demandBody(&mut store, &mut request, &id, b"literal")
  run Testing.expect(rejectsSpan(&named, RejectionCode.CallArity, text, "2 |> binary", usize.ZERO)
    && rejectsSpan(&literal, RejectionCode.CallArity, text,
      "2 |> fn(left: i32, right: i32) -> i32 { return left + right }", usize.ZERO),
    "PIPE-001 invokes a unary target rather than supplying a trailing argument to a binary target")
}

test effect fn callablePipelineDropsTransferredInputOnCalleeExit() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run callablePipelineExitClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn callablePipelineExitClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static>
? &mut Allocator | &mut Types {
  let id = run module("callable-pipeline-exit.silk")
  let text = """
struct Token { value: i32 }
impl Intrinsic.Drop for Token { fn drop(self: &mut Token) -> () { return () } }
fn main(token: Token, choice: i32) -> i32 {
  return (move token) |> match choice {
    _ if choice == 0 => { return 9 }
    _ => fn(value: Token) -> i32 { return value.value }
  }
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let answer = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&answer) && pipelineCalleeExitDropsInput(&store, &answer),
    "an early callee exit drops the input already transferred into pipeline temporary storage")
}

fn pipelineCalleeExitDropsInput(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut dropLocal = usize.MAX
      let mut inputLocal = usize.MAX
      let mut drops = usize.ZERO
      let mut exits = false
      let mut at = usize.ZERO
      while at < blocks.length {
        let statements = Vector<MirStatement>.asSlice(&blocks[at].statements)
        let mut step = usize.ZERO
        while step < statements.length {
          if let MirStatement.Drop {destination, ..} = &statements[step] {
            drops = drops + usize.ONE
            if Vector<MirProjection>.length(&destination.projections) == usize.ZERO {
              dropLocal = destination.local
            }
          }
          step = step + usize.ONE
        }
        if let MirTerminator.Return {..} = &blocks[at].terminator {
          if pipelineExitDropsTemporary(Vector<MirStatement>.asSlice(&blocks[at].statements),
            Vector<MirLocal>.asSlice(&function.locals)) { exits = true }
        }
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, arguments, ..} = &blocks[at].terminator {
          let operands = Vector<MirOperand>.asSlice(&arguments)
          if anonymousFunctionKey(&key) && operands.length == 2 {
            if let MirOperand.Move {place} = &operands[usize.ONE] {
              if Vector<MirProjection>.length(&place.projections) == usize.ZERO { inputLocal = place.local }
            }
          }
        }
        at = at + usize.ONE
      }
      return exits && drops == usize.ONE && dropLocal != usize.MAX && dropLocal == inputLocal
    }
  }
  return false
}

fn pipelineExitDropsTemporary(statements: &[MirStatement], locals: &[MirLocal]) -> bool {
  let mut returnsNine = false
  let mut dropsInput = false
  let mut at = usize.ZERO
  while at < statements.length {
    if let MirStatement.Assign {destination, value: MirRvalue.Use {value: MirOperand.Integer {decimal, negative, ..}}, ..} = &statements[at] {
      let digits = Bytes.asSlice(&decimal)
      if destination.local == usize.ZERO && !negative && digits.length == usize.ONE && digits[usize.ZERO] == 57 {
        returnsNine = true
      }
    }
    if let MirStatement.Drop {destination, ..} = &statements[at] {
      let temporary = match &locals[destination.local].kind { MirLocalKind.Temp => true _ => false }
      if temporary { dropsInput = true }
    }
    at = at + usize.ONE
  }
  return returnsNine && dropsInput
}

test effect fn stagedCallableParameterNormalizesSharedEnvironment() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
