}

effect fn plainCallableViewStagingClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("plain-callable-view-staging.silk")
  let text = """
fn add3(first: i32, middle: i32, last: i32) -> i32 { return first + middle + last }
fn make() -> once fn<'static>(i32, i32, i32) -> i32 { return add3 }
fn useShared<F: fn<'static>(i32) -> i32>(callback: F) -> i32 { return callback(1) }
fn main() -> i32 { let staged = make()(2, 3) return staged(1) }
fn denied() -> i32 { let refused = make()(2, 3) return useShared(move refused) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let body = run Semantic.demandBody(&mut store, &mut request, &id, b"main")
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&body, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move selected {
    run Testing.expect(Shared<TypedBody>.with<bool>(&value, plainStagedOnceView),
      "staging retains the public Once promise over Shared physical storage and ordered supplied fields")
  } else { run Testing.expect(false, "the returned view staging control has a checked body") }
  let entry = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&entry) && plainStagedOriginalCall(&store, &entry),
    "the original target receives the invocation argument followed by stored fields zero and one")
  let denied = run Semantic.demandBody(&mut store, &mut request, &id, b"denied")
  run Testing.expect(rejectsSpan(&denied, RejectionCode.TypeArgumentInference, text, "useShared(move refused)", usize.ZERO),
    "staging cannot strengthen a returned Once promise to Shared")
}

fn plainStagedOnceView(body: &TypedBody) -> bool {
  let locals = TypedBody.localSlice(body)
  if locals.length != usize.ONE { return false }
  return Shared<Type>.with<bool>(&locals[usize.ZERO].ty, plainStagedOnceType)
}

fn plainStagedOnceType(value: &Type) -> bool {
  if !plainOnceViewType(value) { return false }
  if let Type.CallableView {representation, ..} = &value.* {
    return Shared<Type>.with<bool>(&representation, plainStagedOriginalFields)
  }
  return false
}

fn plainStagedOriginalFields(value: &Type) -> bool {
  if let Type.CallableValue {captures, fieldInputs, ..} = &value.* {
    let inputs = Vector<CallableFieldInput>.asSlice(&fieldInputs)
    return Vector<Shared<Type>>.length(&captures) == 2 && inputs.length == 2
      && genericStagingInput(&inputs[usize.ZERO], usize.ONE)
      && genericStagingInput(&inputs[usize.ONE], 2)
  }
  return false
}

fn plainStagedOriginalCall(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, arguments, ..} = &blocks[at].terminator {
          let identity = InstanceKey.identity(&key)
          let original = Shared<DeclarationId>.with<bool>(&identity,
            fn(value: &DeclarationId) -> bool { return DeclarationId.named(value, b"add3") })
          let operands = Vector<MirOperand>.asSlice(&arguments)
          if original && operands.length == 3 {
            return sectionStoredField(&operands[usize.ONE], usize.ZERO)
              && sectionStoredField(&operands[2], usize.ONE)
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}

