effect fn callableUnionStorageClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("callable-union-storage.silk")
  let text = """
fn add(value: i32) -> i32 { return value + 2 }
type Add = typeof(add)
fn selected() -> Add | i32 { return add }
fn spelled(value: Add | i32) -> i32 { return 0 }
fn reversed(value: i32 | Add) -> i32 { return 0 }
fn main() -> i32 { return match move selected() { Add callback => callback(40) i32 value => value } }
fn selectedEffect() -> some<F: Effect<'static; i32>> F | i32 { return effect { return 42 } }
fn pending() -> i32 { drop selectedEffect() return 0 }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let selected = run Semantic.demandBody(&mut store, &mut request, &id, b"selected")
  let body = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&selected, checkedBody)
  let mut tag = usize.MAX
  if let Option<Shared<TypedBody>>.Some {value} = move body { tag = Shared<TypedBody>.with<usize>(&value, firstUnionInjectTag) }
  let producer = run Semantic.demandMir(&mut store, &mut request, &id, b"selected")
  let caller = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(tag < 2 && callableUnionInjectionMir(&store, &producer, tag)
    && succeeded(&caller), "an exact named environment is injected and recovered without changing its original target")
  let original = namedMirApplication(&store, &caller, b"add")
  run Testing.expect(match move original { Option<Shared<SpecializationApplication>>.Some {..} => true _ => false },
    "the recovered callable invokes the original ordinary function instance")
  let spelled = run parameterLayout(&mut store, &mut request, &id, b"spelled")
  let reversed = run parameterLayout(&mut store, &mut request, &id, b"reversed")
  run Testing.expect(spelled != usize.MAX && spelled == reversed,
    "callable union members use one canonical tag and layout order across authored spellings")
  let pending = run Semantic.demandMir(&mut store, &mut request, &id, b"pending")
  run Testing.expect(succeeded(&pending), "an Effect family member of a union is stored and dropped like a callable member")
}

fn callableUnionInjectionMir(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, tag: usize) -> bool {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let locals = Vector<MirLocal>.asSlice(&function.locals)
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        let statements = Vector<MirStatement>.asSlice(&blocks[at].statements)
        let mut step = usize.ZERO
        while step < statements.length {
          if let MirStatement.Assign {value: MirRvalue.Inject {tag: selectedTag, value: MirOperand.Move {place}}, ..} = &statements[step] {
            if selectedTag != tag || Vector<MirProjection>.length(&place.projections) != usize.ZERO { return false }
            let original = Shared<Type>.with<bool>(&locals[place.local].ty,
              fn(value: &Type) -> bool { return plainCallableResultType(value, b"add", usize.ZERO, false) })
            if !original { return false }
            return emptyCallableUnionConstruction(statements, step, place.local)
          }
          step = step + usize.ONE
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}

fn emptyCallableUnionConstruction(statements: &[MirStatement], before: usize, local: usize) -> bool {
  let mut at = usize.ZERO
  while at < before {
    if let MirStatement.Assign {destination, value: MirRvalue.Aggregate {fields}, ..} = &statements[at] {
      if destination.local == local && Vector<MirAggregateField>.length(&fields) == usize.ZERO { return true }
    }
    at = at + usize.ONE
  }
  return false
}

effect fn callableUnionGlueSelectsCapturedMember(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>,
  environment: &Shared<Type>, unionType: &Shared<Type>) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
  let canonical = match move run Type.canonicalUnionMembers(unionType) {
    Option<Vector<Shared<Type>>>.Some {value} => move value _ => { return false }
  }
  let members = Vector<Shared<Type>>.asSlice(&canonical)
  let mut tag = usize.ZERO
  while tag < members.length {
    if run Type.equalsShared(&members[tag], environment) { break }
    tag = tag + usize.ONE
  }
  if members.length != 2 || tag == members.length { return false }
  let decimal = run Type.extentText(tag)
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut drops = usize.ZERO
      let mut dispatched = false
      let mut at = usize.ZERO
      while at < blocks.length {
        drops = drops + callableUnionBlockDropCount(&blocks[at])
        if let MirTerminator.Switch {cases, otherwise, ..} = &blocks[at].terminator {
          let selectedCases = Vector<MirSwitchCase>.asSlice(&cases)
          if selectedCases.length != usize.ONE || selectedCases[usize.ZERO].negative
            || !sameBytes(Bytes.asSlice(&selectedCases[usize.ZERO].decimal), Bytes.asSlice(&decimal)) { return false }
          let arm = selectedCases[usize.ZERO].target
          if arm == otherwise || callableUnionBlockDropCount(&blocks[otherwise]) != usize.ZERO { return false }
          dispatched = run callableUnionDropBlock(&blocks[arm], environment, tag)
        }
        at = at + usize.ONE
      }
      return dispatched && drops == usize.ONE
    }
  }
  return false
}

fn callableUnionBlockDropCount(block: &MirBlock) -> usize {
  let statements = Vector<MirStatement>.asSlice(&block.statements)
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < statements.length {
    if let MirStatement.Drop {..} = &statements[at] { count = count + usize.ONE }
    at = at + usize.ONE
  }
  return count
}

effect fn callableUnionDropBlock(block: &MirBlock, environment: &Shared<Type>, tag: usize) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let statements = Vector<MirStatement>.asSlice(&block.statements)
  let mut at = usize.ZERO
  while at < statements.length {
    if let MirStatement.Drop {glue, destination, ..} = &statements[at] {
      let dropped = match move InstanceKey.glueType(&glue) {
        Option<Shared<Type>>.Some {value} => move value _ => { return false }
      }
      if !run Type.equalsShared(&dropped, environment) { return false }
      let projections = Vector<MirProjection>.asSlice(&destination.projections)
      if projections.length == usize.ZERO { return false }
      if let MirProjection.Payload {index, ty} = &projections[projections.length - usize.ONE] {
        return index == tag && run Type.equalsShared(&ty, environment)
      }
      return false
    }
    at = at + usize.ONE
  }
  return false
}

// `&mut value` of an immutable binding holding `&mut P` reborrows its referent even where an
// inferred `&mut P` parameter supplies no reference context (BORROW-005); an immutable owner
