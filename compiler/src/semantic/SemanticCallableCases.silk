    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn anonymousContractsUseEnclosingPremises() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let text = """
interface Handler<A> {}
struct Wrap<A, H: Handler<A>> {
  value: A
  handler: H
}
struct Plain {}
impl Handler<i32> for Plain {}
fn count<T>(value: &T) -> i32 { return 4 }
fn viewed<A, H: Handler<A>>(wrapped: Wrap<A, H>, fallback: i32) -> i32 {
  let measure = fn(view: &Wrap<A, H>) -> i32 { return fallback }
  let result = measure(&wrapped)
  drop wrapped
  return result
}
fn counted<A, H: Handler<A>>(wrapped: Wrap<A, H>, fallback: i32) -> i32 {
  let measure = fn(view: &A) -> i32 { return fallback + count<Wrap<A, H>>(&wrapped) }
  return measure(&wrapped.value)
}
fn main() -> i32 {
  let first = viewed<i32, Plain>(Wrap<i32, Plain> {value: 1, handler: Plain {}}, 9)
  return first + counted<i32, Plain>(Wrap<i32, Plain> {value: 1, handler: Plain {}}, 5)
}
"""
  return run anonymousEnclosingPremisesClaims(text)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn anonymousEnclosingPremisesClaims(text: string<'static>) -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("anonymous-enclosing-premises.silk")
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let caller = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&caller), "both generic callers lower")
  let viewed = run applicationLowers(&mut store, &mut request, &caller, b"viewed")
  run Testing.expect(viewed, "an anonymous parameter type applies `Wrap<A, H>` under the enclosing `H: Handler<A>`")
  let counted = run applicationLowers(&mut store, &mut request, &caller, b"counted")
  run Testing.expect(counted, "an explicit argument in an anonymous body applies `Wrap<A, H>` under the enclosing `H: Handler<A>`")
}

effect fn applicationLowers(store: &mut Semantic, request: &mut Request, caller: &Shared<Result<Answer, NoRejection>>, name: &[u8]) -> bool
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError ? &mut Allocator | &mut Types {
  if let Option<Shared<SpecializationApplication>>.Some {value} = move namedMirApplication(&store.*, caller, name) {
    let application = run SpecializationApplication.copyShared(&value)
    let target = run Semantic.demandApplicationMir(&mut store.*, &mut request.*, &application)
    return succeeded(&target)
  }
  return false
}

effect fn stagedCallableParameterClaims(text: string<'static>, environmentMode: CallableMode, movesSuffix: bool) -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("staged-callable-parameter.silk")
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let caller = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&caller), "the exact callable specializes the staging parameter")
  let selected = namedMirApplication(&store, &caller, b"invoke")
  if let Option<Shared<SpecializationApplication>>.Some {value} = move selected {
    let application = run SpecializationApplication.copyShared(&value)
    let target = run Semantic.demandApplicationMir(&mut store, &mut request, &application)
    run Testing.expect(succeeded(&target) && stagedParameterRuntimeTypes(&store, &target)
      && stagedAnonymousFields(&store, &target, environmentMode, movesSuffix),
      "the abstract stage becomes an aggregate and direct original call with independent environment and suffix modes")
    let nested = anonymousMirApplication(&store, &target)
    if let Option<Shared<SpecializationApplication>>.Some {value: original} = move nested {
      let literal = run SpecializationApplication.copyShared(&original)
      let implementation = run Semantic.demandApplicationMir(&mut store, &mut request, &literal)
      run Testing.expect(anonymousTargetParameter(&store, &implementation, environmentMode, 3),
        "the original target retains its actual environment ABI after representation binding")
      if movesSuffix {
        run Testing.expect(glueFact(&store, &caller, usize.ZERO) == usize.ZERO
          && glueFact(&store, &target, usize.ZERO) == usize.ZERO
          && glueFact(&store, &implementation, usize.ZERO) == usize.ONE,
          "the stored affine suffix is dropped once by the original body after both transfers")
      }
      return ()
    }
  }
  run Testing.expect(false, "staging keeps an ordinary function target without an adapter or code pointer")
}

test effect fn stagedCallableParameterRetainsRepeatedArgumentOrdinals() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run stagedCallableParameterOrdinalClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn stagedCallableParameterOrdinalClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("repeated-staged-parameter.silk")
  let text = """
fn invoke<F: fn<'static>(i32, i32, i32) -> i32>(callback: F) -> i32 {
  let earlier = callback(3)
  let later = earlier(2)
  return later(1)
}
fn main() -> i32 {
  let add = fn(first: i32, second: i32, third: i32) -> i32 { return first * 100 + second * 10 + third }
  return invoke(add)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let caller = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&caller), "the constrained representation specializes repeated staging")
  let selected = namedMirApplication(&store, &caller, b"invoke")
  if let Option<Shared<SpecializationApplication>>.Some {value} = move selected {
    let application = run SpecializationApplication.copyShared(&value)
    let target = run Semantic.demandApplicationMir(&mut store, &mut request, &application)
    run Testing.expect(succeeded(&target) && stagedParameterRuntimeTypes(&store, &target)
      && repeatedStagedAnonymousArguments(&store, &target),
      "capture order stores third then second while the direct target receives first, second, third")
    return ()
  }
  run Testing.expect(false, "the constrained staging caller retains its exact specialization")
}

fn repeatedStagedAnonymousArguments(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let locals = Vector<MirLocal>.asSlice(&function.locals)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, arguments, ..} = &blocks[at].terminator {
          let operands = Vector<MirOperand>.asSlice(&arguments)
          if anonymousFunctionKey(&key) && operands.length == 4 {
            return stagedReceiver(&operands[usize.ZERO], locals, CallableMode.Shared)
              && sectionStoredField(&operands[2], 2) && sectionStoredField(&operands[3], usize.ONE)
          }
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}

fn stagedParameterRuntimeTypes(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let locals = Vector<MirLocal>.asSlice(&function.locals)
      let mut at = usize.ZERO
      while at < locals.length {
        if Shared<Type>.with<bool>(&locals[at].ty, fn(value: &Type) -> bool {
          return match &value.* { Type.CallableStage {..} => true _ => false }
        }) { return false }
        at = at + usize.ONE
      }
      return true
    }
  }
  return false
}

test effect fn stagedCallableParameterForwardsIntoPlainCallableParameter() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run stagedCallableParameterForwardingClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn stagedCallableParameterForwardingClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("forwarded-staged-parameter.silk")
  let text = """
fn relay(callback: fn<'static>(i32) -> i32) -> i32 { return callback(1) }
fn invoke<F: fn<'static>(i32, i32) -> i32>(callback: F) -> i32 {
  let next = callback(2)
  return relay(next)
}
fn main() -> i32 {
  let add = fn(first: i32, last: i32) -> i32 { return first + last }
  return invoke(add)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let caller = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&caller), "the source constrained callable specializes its staged owner")
  let selected = namedMirApplication(&store, &caller, b"invoke")
  if let Option<Shared<SpecializationApplication>>.Some {value} = move selected {
    let application = run SpecializationApplication.copyShared(&value)
    let owner = run Semantic.demandApplicationMir(&mut store, &mut request, &application)
    run Testing.expect(succeeded(&owner) && stagedParameterRuntimeTypes(&store, &owner),
      "the staging owner normalizes its abstract recipe before forwarding its environment")
    let forwarded = namedMirApplication(&store, &owner, b"relay")
    if let Option<Shared<SpecializationApplication>>.Some {value: relay} = move forwarded {
      let next = run SpecializationApplication.copyShared(&relay)
      let target = run Semantic.demandApplicationMir(&mut store, &mut request, &next)
      run Testing.expect(succeeded(&target) && stagedParameterRuntimeTypes(&store, &target)
        && stagedAnonymousFields(&store, &target, CallableMode.Shared, false),
        "a plain callable parameter receives the closed staged environment and directly invokes its original target")
      return ()
    }
  }
  run Testing.expect(false, "both source callable parameters retain ordinary exact function applications")
}

test effect fn effectLiteralsRunTheirInstanceWithTheirEnvironment() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run effectLiteralClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn effectLiteralClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("effect-literals.silk")
  let text = """
struct Missing { code: i32 }
struct Offline {}
fn block() -> i32 {
  let base = 40
  let pending = effect { return base + 2 }
  return run pending
}
effect fn fallible(code: i32) -> i32 ! Missing | Offline {
  let pending = effect {
    if code > 1 { fail Offline {} }
    if code > 0 { fail Missing { code: code } }
    return code
  }
  return run pending
}
fn anonymous() -> i32 {
  let add = effect fn(value: i32) -> i32 { return value + 1 }
  return run add(1)
}
fn mutableRecipe() -> i32 {
  let mut recipe = effect { return 1 }
  return run recipe
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let block = run Semantic.demandMir(&mut store, &mut request, &id, b"block")
  let fallible = run Semantic.demandMir(&mut store, &mut request, &id, b"fallible")
  let anonymous = run Semantic.demandMir(&mut store, &mut request, &id, b"anonymous")
  run Testing.expect(effectBlockOperands(&store, &block) == usize.ONE && failureFact(&store, &block, 2) == usize.ZERO,
    "running a stored Effect block calls the block's instance with its environment")
  run Testing.expect(effectBlockOperands(&store, &fallible) == usize.ONE && failureFact(&store, &fallible, 2) == usize.ONE,
    "a block's derived failures give its run a failure edge")
  let runner = effectBlockApplication(&store, &fallible)
  if let Option<Shared<SpecializationApplication>>.Some {value} = move runner {
    let application = run SpecializationApplication.copyShared(&value)
    let instance = run Semantic.demandApplicationMir(&mut store, &mut request, &application)
    run Testing.expect(failureFact(&store, &instance, usize.ZERO) == usize.ONE && failureFact(&store, &instance, usize.ONE) == 2,
      "the block's instance fails through its out-slot with the join of its failures")
  } else {
    run Testing.expect(false, "the fallible block's run references its instance")
  }
  run Testing.expect(effectBlockOperands(&store, &anonymous) == 2,
    "running an invoked anonymous effect fn calls its instance with its environment and argument")
  let mutableRecipe = run Semantic.demandBody(&mut store, &mut request, &id, b"mutableRecipe")
  run Testing.expect(rejectsSpan(&mutableRecipe, RejectionCode.MutableEffectRecipe, text, "let mut recipe = effect { return 1 }", usize.ZERO),
    "a mutable binding of a shared Effect reports SEM0068 at the statement (CALLABLE-003)")
}

fn characterInitializerFact(answer: &Shared<Result<Answer, NoRejection>>, integer: bool, kind: StaticIntegerType, scalar: u32) -> bool {
  return Shared<Result<Answer, NoRejection>>.with<bool>(answer, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return characterInitializerValue(answer, integer, kind, scalar)
  })
}

fn characterInitializerValue(answer: &Result<Answer, NoRejection>, integer: bool, kind: StaticIntegerType, scalar: u32) -> bool {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Initializer {value: selected}} = &value.outcome {
      return Shared<StaticData>.with<bool>(&selected, fn(data: &StaticData) -> bool { return characterEmbeddedValue(data, integer, kind, scalar) })
    }
  }
  return false
}

fn characterSubtractMirOrder(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let index = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, value) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        let statements = Vector<MirStatement>.asSlice(&blocks[at].statements)
        let mut statement = usize.ZERO
        while statement < statements.length {
          if let MirStatement.Assign {value: MirRvalue.Binary {operation, left, right}, ..} = &statements[statement] {
            if operation == InfixOperator.Subtract { return integerOperand(&left, b"5") && integerOperand(&right, b"2") }
          }
          statement = statement + usize.ONE
        }
        at = at + usize.ONE
      }
    }
  }
  return false
}

fn characterCallsMirOrder(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let index = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, value) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut block = usize.ZERO
      let mut phase = usize.ZERO
      while phase < 2 {
        if block >= blocks.length { return false }
        if let MirTerminator.Call {callee: MirCallee.Instance {key}, normal, ..} = &blocks[block].terminator {
          let identity = InstanceKey.identity(&key)
          let mut expected = b"leftValue"
          if phase == usize.ONE { expected = b"rightValue" }
          if !Shared<DeclarationId>.with<bool>(&identity, fn(value: &DeclarationId) -> bool { return DeclarationId.named(value, expected) }) { return false }
          block = normal
          phase = phase + usize.ONE
        } else { return false }
      }
      return true
    }
  }
  return false
}

test effect fn characterLiteralsRetainExactContextualAndStaticValues() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run characterLiteralClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn characterLiteralClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  // Numeric suffix fields exist in HIR, but the current source frontend does not produce them.
  // Pin that exact refusal; this is not a witness of suffix-present semantic driver policy.
  let mut suffixLexer = Lexer.make(b"65u8")
  let suffixToken = run Stream.take(&mut suffixLexer)
  let suffixRefused = match move suffixToken {
    Option<Token>.Some {value: Token.InvalidDurationLiteral {span, diagnostic: LexicalDiagnostic.UnknownDurationUnit {spelling, span: reason}}} =>
      span.start == usize.ZERO && span.end == 4 && spelling.start == 2 && spelling.end == 3 && reason.start == 2 && reason.end == 3
    _ => false
  }
  run Testing.expect(suffixRefused, "65u8 remains an invalid duration token with an unknown unit u at bytes 2..3")
  let id = run module("contextual-character.silk")
  let text = """
fn ascii() -> char { return 'A' }
fn unicode() -> char { return 'é' }
fn byte() -> u8 { return 'A' }
fn zero() -> u8 { return '\\0' }
fn wide() -> u64 { return 'Ā' }
fn word() -> usize { return '😀' }
fn compared(value: u8) -> bool { return value == 'é' && 'é' == value }
fn lambdaWide() -> u16 { return 'λ' }
fn signedWide() -> i16 { return 'λ' }
fn tooLambda() -> u8 { return 'λ' }
fn noCoercion(heldCharacter: char) -> u8 { return heldCharacter }
fn wrongFloat() -> f64 { return 'F' }
struct Marker {}
fn wrongNominal() -> Marker { return 'N' }
fn firstInteger() -> bool { return 65 == 'A' }
fn firstCharacter() -> bool { return 'A' == 65 }
fn charLocal(value: char) -> bool { return value == 'A' && 'A' == value }
fn overflowCompare(value: u8) -> bool { return value == 'λ' }
fn integerContext(value: u8) -> bool { return 5 == value }
fn floatContext(value: f32) -> bool { return 0.5 == value }
fn difference() -> i32 { return 5 - 2 }
fn leftValue() -> i32 { return 5 }
fn rightValue() -> i32 { return 2 }
fn orderedCalls() -> i32 { return leftValue() - rightValue() }
static fn staticDifference() -> i32 { return 5 - 2 }
const exactDifference: i32 = staticDifference()
fn tooWide() -> u8 { return 'Ā' }
fn tooSigned() -> i8 { return '\u{80}' }
fn wrong() -> bool { return 'Q' }
static fn staticByte() -> u8 { return 'A' }
const evaluated: u8 = staticByte()
const nonAscii: char = 'é'
fn readsNonAscii() -> char { return nonAscii }
fn picked() -> char { return 'P' }
fn sameCharacter(left: char, right: char) -> bool { return left == right }
fn callsWithCharacters() -> bool { return sameCharacter(picked(), 'P') }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.Wasm32UnknownUnknown))
  let mut request = Request.make()
  let ascii = run Semantic.demandBody(&mut store, &mut request, &id, b"ascii")
  let unicode = run Semantic.demandBody(&mut store, &mut request, &id, b"unicode")
  let byte = run Semantic.demandBody(&mut store, &mut request, &id, b"byte")
  let zero = run Semantic.demandBody(&mut store, &mut request, &id, b"zero")
  let wide = run Semantic.demandBody(&mut store, &mut request, &id, b"wide")
  let word = run Semantic.demandBody(&mut store, &mut request, &id, b"word")
  let compared = run Semantic.demandBody(&mut store, &mut request, &id, b"compared")
  run Testing.expect(characterBodyFact(&ascii, b"char", false, StaticIntegerType.U8, 65, usize.ONE)
    && characterBodyFact(&unicode, b"char", false, StaticIntegerType.U8, 233, usize.ONE)
    && characterBodyFact(&byte, b"u8", true, StaticIntegerType.U8, 65, usize.ONE)
    && characterBodyFact(&zero, b"u8", true, StaticIntegerType.U8, 0, usize.ONE)
    && characterBodyFact(&wide, b"u64", true, StaticIntegerType.U64, 256, usize.ONE)
    && characterBodyFact(&word, b"usize", true, StaticIntegerType.Usize, 0x1f600, usize.ONE)
    && characterBodyFact(&compared, b"u8", true, StaticIntegerType.U8, 233, 2),
    "authored character scalars retain exact char or contextual integer types and values, including a 32-bit target word")
  let lambdaWide = run Semantic.demandBody(&mut store, &mut request, &id, b"lambdaWide")
  let signedWide = run Semantic.demandBody(&mut store, &mut request, &id, b"signedWide")
  let tooLambda = run Semantic.demandBody(&mut store, &mut request, &id, b"tooLambda")
  let noCoercion = run Semantic.demandBody(&mut store, &mut request, &id, b"noCoercion")
  let wrongFloat = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongFloat")
  let wrongNominal = run Semantic.demandBody(&mut store, &mut request, &id, b"wrongNominal")
  run Testing.expect(characterBodyFact(&lambdaWide, b"u16", true, StaticIntegerType.U16, 955, usize.ONE)
    && characterBodyFact(&signedWide, b"i16", true, StaticIntegerType.I16, 955, usize.ONE)
    && rejectsSpan(&tooLambda, RejectionCode.IntegerOutOfRange, text, "'λ'", 2)
    && rejectsSpan(&noCoercion, RejectionCode.ReturnTypeMismatch, text, "heldCharacter", usize.ONE)
    && rejectsSpan(&wrongFloat, RejectionCode.ReturnTypeMismatch, text, "'F'", usize.ZERO)
    && rejectsSpan(&wrongNominal, RejectionCode.ReturnTypeMismatch, text, "'N'", usize.ZERO),
    "immediate signed and unsigned contexts admit codepoints; typed char values and noninteger contexts retain exact mismatch spans")
  let firstInteger = run Semantic.demandBody(&mut store, &mut request, &id, b"firstInteger")
  let firstCharacter = run Semantic.demandBody(&mut store, &mut request, &id, b"firstCharacter")
  let charLocal = run Semantic.demandBody(&mut store, &mut request, &id, b"charLocal")
  let overflowCompare = run Semantic.demandBody(&mut store, &mut request, &id, b"overflowCompare")
  run Testing.expect(characterBodyFact(&firstInteger, b"i32", true, StaticIntegerType.I32, 65, usize.ONE),
    "an all-literal pair keeps its first integer default")
  run Testing.expect(rejectsSpan(&firstCharacter, RejectionCode.TypeMismatch, text, "65", usize.ONE),
    "an all-literal pair keeps its first character default and rejects the bare incompatible integer")
  run Testing.expect(characterBodyFact(&charLocal, b"char", false, StaticIntegerType.U8, 65, 2),
    "both character-local comparisons retain Character scalars")
  run Testing.expect(rejectsSpan(&overflowCompare, RejectionCode.IntegerOutOfRange, text, "'λ'", 3),
    "a declared u8 driver rejects the exact overflowing character literal")
  let integerContext = run Semantic.demandBody(&mut store, &mut request, &id, b"integerContext")
  let floatContext = run Semantic.demandBody(&mut store, &mut request, &id, b"floatContext")
  run Testing.expect(succeeded(&integerContext) && succeeded(&floatContext),
    "existing declared integer and float operand contexts remain accepted")
  let difference = run Semantic.demandMir(&mut store, &mut request, &id, b"difference")
  let ordered = run Semantic.demandMir(&mut store, &mut request, &id, b"orderedCalls")
  let exactDifference = run Semantic.demandInitializer(&mut store, &mut request, &id, b"exactDifference")
  run Testing.expect(characterSubtractMirOrder(&store, &difference) && characterCallsMirOrder(&store, &ordered)
    && characterInitializerFact(&exactDifference, true, StaticIntegerType.I32, 3),
    "noncommutative all-literal subtraction retains left 5 and right 2, evaluates to 3, and declared calls retain authored order")
  let tooWide = run Semantic.demandBody(&mut store, &mut request, &id, b"tooWide")
  let tooSigned = run Semantic.demandBody(&mut store, &mut request, &id, b"tooSigned")
  let wrong = run Semantic.demandBody(&mut store, &mut request, &id, b"wrong")
  run Testing.expect(rejectsSpan(&tooWide, RejectionCode.IntegerOutOfRange, text, "'Ā'", usize.ONE)
    && rejectsSpan(&tooSigned, RejectionCode.IntegerOutOfRange, text, "'\u{80}'", usize.ZERO)
    && rejectsSpan(&wrong, RejectionCode.ReturnTypeMismatch, text, "'Q'", usize.ZERO),
    "unsigned and signed range overflow and noninteger mismatches retain exact authored literal spans")
  let evaluated = run Semantic.demandInitializer(&mut store, &mut request, &id, b"evaluated")
  let nonAscii = run Semantic.demandInitializer(&mut store, &mut request, &id, b"nonAscii")
  run Testing.expect(characterInitializerFact(&evaluated, true, StaticIntegerType.U8, 65)
    && characterInitializerFact(&nonAscii, false, StaticIntegerType.U8, 233),
    "checked contextual static execution returns integer data while default non-ASCII char remains Character")
  let readsNonAscii = run Semantic.demandBody(&mut store, &mut request, &id, b"readsNonAscii")
  run Testing.expect(characterBodyFact(&readsNonAscii, b"char", false, StaticIntegerType.U8, 233, usize.ONE),
    "a runtime char constant read embeds its Character scalar at type char")
  let callsWithCharacters = run Semantic.demandMir(&mut store, &mut request, &id, b"callsWithCharacters")
  run Testing.expect(succeeded(&callsWithCharacters), "char is a runtime call argument and result type")
}

fn durationValue(data: &StaticData, nanoseconds: u64) -> bool {
  return match &data.* {
    StaticData.Integer {ty, magnitude, ..} => ty == StaticIntegerType.U64 && magnitude == nanoseconds
    _ => false
  }
}

// Counts embedded `u64` values equal to `nanoseconds` in one checked body.
fn durationBodyValue(body: &TypedBody, nanoseconds: u64) -> bool {
  let nodes = TypedBody.nodeSlice(body)
  let mut matching = usize.ZERO
  let mut at = usize.ZERO
  while at < nodes.length {
    if let BodyNodeKind.Expression {ty, form: BodyExpression.Embedded {value}} = &nodes[at].kind {
      let typed = Shared<Type>.with<bool>(&ty, fn(found: &Type) -> bool { return witnessPrimitive(found, b"u64") })
      let exact = Shared<StaticData>.with<bool>(&value, fn(data: &StaticData) -> bool { return durationValue(data, nanoseconds) })
      if typed && exact { matching = matching + usize.ONE }
    }
    at = at + usize.ONE
  }
  return matching == usize.ONE
}

fn durationBodyFact(answer: &Shared<Result<Answer, NoRejection>>, nanoseconds: u64) -> bool {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(answer, checkedBody)
  if let Option<Shared<TypedBody>>.Some {value} = move selected {
    return Shared<TypedBody>.with<bool>(&value, fn(body: &TypedBody) -> bool { return durationBodyValue(body, nanoseconds) })
  }
  return false
}

fn durationInitializerValue(answer: &Result<Answer, NoRejection>, nanoseconds: u64) -> bool {
  if let Result<Answer, NoRejection>.Success {value} = &answer.* {
    if let Outcome.Success {value: Value.Initializer {value: selected}} = &value.outcome {
      return Shared<StaticData>.with<bool>(&selected, fn(data: &StaticData) -> bool { return durationValue(data, nanoseconds) })
    }
  }
  return false
}

fn durationInitializerFact(answer: &Shared<Result<Answer, NoRejection>>, nanoseconds: u64) -> bool {
  return Shared<Result<Answer, NoRejection>>.with<bool>(answer, fn(answer: &Result<Answer, NoRejection>) -> bool {
    return durationInitializerValue(answer, nanoseconds)
  })
}

test effect fn durationLiteralsAreExactU64Nanoseconds() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run durationLiteralClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// DURATION-001: every component scales exactly and the sum is a context-independent `u64`.
effect fn durationLiteralClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("duration-literals.silk")
  let text = """
fn mixed() -> u64 { return 1h30m15s }
fn largest() -> u64 { return 18446744073709551615ns }
fn overflow() -> u64 { return 30501w }
fn narrowed() -> i32 { return 5s }
const timeout: u64 = 2ms
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.Wasm32UnknownUnknown))
  let mut request = Request.make()
  let mixed = run Semantic.demandBody(&mut store, &mut request, &id, b"mixed")
  let largest = run Semantic.demandBody(&mut store, &mut request, &id, b"largest")
  run Testing.expect(durationBodyFact(&mixed, 5415000000000) && durationBodyFact(&largest, u64.MAX),
    "components scale exactly and the largest total embeds the u64 maximum")
  let overflow = run Semantic.demandBody(&mut store, &mut request, &id, b"overflow")
  let narrowed = run Semantic.demandBody(&mut store, &mut request, &id, b"narrowed")
  run Testing.expect(rejectsSpan(&overflow, RejectionCode.DurationOutOfRange, text, "30501w", usize.ZERO)
    && rejectsSpan(&narrowed, RejectionCode.ReturnTypeMismatch, text, "5s", usize.ONE),
    "an exact total beyond u64 rejects at the literal, and context never retypes a duration")
  let timeout = run Semantic.demandInitializer(&mut store, &mut request, &id, b"timeout")
  run Testing.expect(durationInitializerFact(&timeout, 2000000), "a u64 constant evaluates its duration literal")
}

effect fn allocationLike(origin: &[u8], package: &[u8], path: &[u8], kind: OwnerKind, occurrence: usize, parent: bool) -> Shared<Type>
! InvalidModulePath | OutOfMemoryError ? &mut Allocator | &mut Types {
  let module = run ModuleId.make(origin, package, path)
  let mut owners = Vector<OwnerStep>.make()
  if parent { run Vector<OwnerStep>.append(&mut owners, OwnerStep {kind: OwnerKind.Struct,
    name: Option<Bytes>.some(run Bytes.copy(b"Parent")), occurrence: usize.ZERO}) }
  run Vector<OwnerStep>.append(&mut owners, OwnerStep {kind: kind,
    name: Option<Bytes>.some(run Bytes.copy(b"Allocation")), occurrence: occurrence})
  return run Types.intern(Type.Nominal {declaration: run DeclarationId.fromParts(move module, move owners),
    isPublic: true, arguments: Vector<Argument>.make()})
}

test effect fn allocationCanonicalIdentityAndTypeShadowing() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  return run allocationCanonicalClaims() |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

effect fn allocationCanonicalClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let first = run module("allocation-first.silk")
  let second = run module("allocation-second.silk")
  let text = "struct Allocation {}\nfn plain(value: Intrinsic.Allocation) -> () { return () }\nfn shadow<Allocation>(value: Intrinsic.Allocation) -> () { return () }\nfn excess(value: Intrinsic.Allocation<i32>) -> () { return () }\nfn user(value: Allocation) -> () { return () }\n" // ordinary: user declarations
  let firstSource = run present(text)
  let secondSource = run present("fn plain(value: Intrinsic.Allocation) -> () { return () }")
  let withFirst = run Revision.publish(&Revision.make(), &first, &firstSource)
  let revision = run Revision.publish(&withFirst, &second, &secondSource)
  let mut store = makeSemantic(move revision)
  let mut request = Request.make()
  let plain = run Semantic.demandSignature(&mut store, &mut request, &first, b"plain")
  let other = run Semantic.demandSignature(&mut store, &mut request, &second, b"plain")
  let shadow = run Semantic.demandSignature(&mut store, &mut request, &first, b"shadow")
  let canonical = run SealedCore.allocation()
  let emptyBindings = Vector<Binding>.make()
  let copied = run Types.intern(run Type.copy(&canonical))
  let applied = run Type.applyBindings(&canonical, Vector<Binding>.asSlice(&emptyBindings), true)
  let mut index = usize.ZERO
  while index < 3 {
    let mut answer = Shared<Result<Answer, NoRejection>>.clone(&plain)
    if index == usize.ONE { answer = Shared<Result<Answer, NoRejection>>.clone(&other) }
    if index == 2 { answer = Shared<Result<Answer, NoRejection>>.clone(&shadow) }
    let selected = allocationSignatureParameter(&answer, usize.ZERO)
    if let Option<Shared<Type>>.Some {value} = move selected {
      run Testing.expect((run Type.equalsShared(&value, &canonical)) && SealedCore.isCore(&value, SealedKind.Allocation),
        "Intrinsic.Allocation has one compiler-authenticated identity across source modules, a same-spelled source declaration and a same-spelled binder")
    } else { run Testing.expect(false, "Allocation signature parameter is available") }
    index = index + usize.ONE
  }
  let user = run Semantic.demandSignature(&mut store, &mut request, &first, b"user")
  if let Option<Shared<Type>>.Some {value} = move allocationSignatureParameter(&user, usize.ZERO) {
    run Testing.expect(!SealedCore.isCore(&value, SealedKind.Allocation) && !(run Type.equalsShared(&value, &canonical)),
      "a bare Allocation names the ordinary source declaration, not the sealed core")
  } else { run Testing.expect(false, "source Allocation signature parameter is available") }
  run Testing.expect((run Type.equalsShared(&canonical, &copied)) && (run Type.equalsShared(&canonical, &applied)),
    "copying and ordinary bindings retain Allocation identity")
  let owned = run Type.copy(&canonical)
  if let Type.Nominal {declaration, ..} = &owned {
    let originalKey = run Type.runtimeEncoding(&canonical, &declaration)
    let copiedKey = run Type.runtimeEncoding(&copied, &declaration)
    let appliedKey = run Type.runtimeEncoding(&applied, &declaration)
    run Testing.expect(sameBytes(Bytes.asSlice(&originalKey), Bytes.asSlice(&copiedKey))
      && sameBytes(Bytes.asSlice(&originalKey), Bytes.asSlice(&appliedKey)),
      "runtime encoding preserves complete sealed declaration identity through copies and bindings")
  } else { run Testing.expect(false, "Allocation uses existing Nominal representation") }
  let excess = run Semantic.demandSignature(&mut store, &mut request, &first, b"excess")
  run Testing.expect(rejectsSpan(&excess, RejectionCode.TypeArity, text, "i32", usize.ZERO)
    && Shared<Result<Answer, NoRejection>>.with<bool>(&excess, allocationZeroArity),
    "Allocation accepts zero supplied type arguments and points at the offending argument")
  let sourceLike = run allocationLike(b"file", b"silk", b"silk/core", OwnerKind.Struct, usize.ZERO, false)
  let packageLike = run allocationLike(b"compiler-sealed-core", b"other", b"silk/core", OwnerKind.Struct, usize.ZERO, false)
  let pathLike = run allocationLike(b"compiler-sealed-core", b"silk", b"other/core", OwnerKind.Struct, usize.ZERO, false)
  let kindLike = run allocationLike(b"compiler-sealed-core", b"silk", b"silk/core", OwnerKind.Union, usize.ZERO, false)
  let occurrenceLike = run allocationLike(b"compiler-sealed-core", b"silk", b"silk/core", OwnerKind.Struct, usize.ONE, false)
  let parentLike = run allocationLike(b"compiler-sealed-core", b"silk", b"silk/core", OwnerKind.Struct, usize.ZERO, true)
  run Testing.expect(!SealedCore.isCore(&sourceLike, SealedKind.Allocation)
    && !SealedCore.isCore(&packageLike, SealedKind.Allocation)
    && !SealedCore.isCore(&pathLike, SealedKind.Allocation)
    && !SealedCore.isCore(&kindLike, SealedKind.Allocation)
    && !SealedCore.isCore(&occurrenceLike, SealedKind.Allocation)
    && !SealedCore.isCore(&parentLike, SealedKind.Allocation)
    && !(run Type.equalsShared(&canonical, &sourceLike)),
    "same spelling/path alone cannot forge the reserved origin, package, owner kind, occurrence or complete chain")
}

test effect fn allocationConstructionRefusesAndInherentLookupStaysOrdinary() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
