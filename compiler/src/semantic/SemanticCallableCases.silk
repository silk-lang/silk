}

effect fn genericOwnedStagingClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("generic-owned-staging.silk")
  let text = """
struct Token { value: i32 }
impl Intrinsic.Drop for Token { fn drop(self: &mut Token) -> () { return () } }
fn select<T>(value: T, token: Token, enabled: bool) -> T { drop token return move value }
fn main(token: Token) -> i32 {
  let base = select(true)
  let staged = base(move token)
  return staged(42)
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let caller = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&caller) && genericStagingCalls(&store, &caller, true, false)
    && glueFact(&store, &caller, usize.ZERO) == usize.ZERO,
    "staging transfers a moved capture to the original target exactly once, leaving no caller cleanup")
  if let Option<Shared<Type>>.Some {value: ty} = move genericStagingEnvironment(&store, &caller) {
  let sourceOwner = run glueSourceOwner(&mut store, &caller)
    let glue = run Semantic.demandGlueMir(&mut store, &mut request, &ty, &sourceOwner)
    run Testing.expect(succeeded(&glue) && glueFact(&store, &glue, usize.ZERO) == usize.ONE,
      "an unused staged environment drops its owned capture through ordinary capture glue")
  } else { run Testing.expect(false, "owned staging retains its exact capture record") }
  if let Option<Shared<SpecializationApplication>>.Some {value} = move namedMirApplication(&store, &caller, b"select") {
    let application = run SpecializationApplication.copyShared(&value)
    let target = run Semantic.demandApplicationMir(&mut store, &mut request, &application)
    run Testing.expect(succeeded(&target) && glueFact(&store, &target, usize.ZERO) == usize.ONE,
      "the invoked original target owns the sole moved-capture cleanup")
    return ()
  }
  run Testing.expect(false, "owned staging has an ordinary complete target application")
}

// A named value has storage but no hidden receiver ABI. Construction must not execute its target.
fn namedValueConstruction(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let index = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, value) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut empty = false
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {..} = &blocks[at].terminator { return false }
        let statements = Vector<MirStatement>.asSlice(&blocks[at].statements)
        let mut statementAt = usize.ZERO
        while statementAt < statements.length {
          if let MirStatement.Assign {value: MirRvalue.Aggregate {fields}, ..} = &statements[statementAt] {
            if Vector<MirAggregateField>.length(&fields) == usize.ZERO { empty = true }
          }
          statementAt = statementAt + usize.ONE
        }
        at = at + usize.ONE
      }
      return empty
    }
  }
  return false
}

fn namedValueDirectCalls(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> bool {
  let index = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value} = move index {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, value) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut constructor = false
      let mut original = false
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee, arguments, ..} = &blocks[at].terminator {
          if let MirCallee.Instance {key} = &callee {
            let identity = InstanceKey.identity(&key)
            let creates = Shared<DeclarationId>.with<bool>(&identity,
              fn(value: &DeclarationId) -> bool { return DeclarationId.named(value, b"makeNamedZero") })
            let invokes = Shared<DeclarationId>.with<bool>(&identity,
              fn(value: &DeclarationId) -> bool { return DeclarationId.named(value, b"namedZero") })
            if (!creates && !invokes) || Vector<MirOperand>.length(&arguments) != usize.ZERO { return false }
            if creates { constructor = true }
            if invokes { original = true }
          } else { return false }
        }
        at = at + usize.ONE
      }
      return constructor && original
    }
  }
  return false
}

test effect fn namedFunctionValuesConstructEmptyEnvironmentsAndReturnExactTypes() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
