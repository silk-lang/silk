effect fn genericMutableSectionClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("generic-mutable-section.silk")
  let text = """
fn edit<T>(amount: T, counter: &mut i32) -> T { counter.* = counter.* + 1 return move amount }
fn main() -> i32 {
  let mut counter = 0
  let mut next = edit(&mut counter)
  let first = next(40)
  return first + next(2)
}
fn conflicting() -> i32 {
  let mut lockedCounter = 0
  let mut locked = edit(&mut lockedCounter)
  lockedCounter = 3
  return locked(1)
}
fn released() -> i32 {
  let mut heldCounter = 0
  let mut held = edit(&mut heldCounter)
  let value = held(1)
  heldCounter = 3
  return value
}
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let caller = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  let conflict = run Semantic.demandBody(&mut store, &mut request, &id, b"conflicting")
  let released = run Semantic.demandBody(&mut store, &mut request, &id, b"released")
  run Testing.expect(succeeded(&caller) && sectionInvocationCount(&store, &caller, b"edit", false) == 2,
    "generic mutable sections repeatedly pass their retained original exclusive descriptor")
  run Testing.expect(rejectsRelated(&conflict, RejectionCode.AccessDuringLoan, offsetOf(text, "lockedCounter = 3", usize.ZERO),
    offsetOf(text, "&mut lockedCounter", usize.ZERO)),
    "writing the captured root while the section can still be invoked is OWN0011 (CALLABLE-003)")
  let releasedBody = Shared<Result<Answer, NoRejection>>.with<Option<Shared<TypedBody>>>(&released, checkedBody)
  let retainedLoan = match move releasedBody {
    Option<Shared<TypedBody>>.Some {value} => Shared<TypedBody>.with<bool>(&value, genericSectionRetainedLoan)
    _ => false
  }
  run Testing.expect(retainedLoan,
    "the stored exclusive local descriptor remains visible in the section's capture")
  if let Option<Shared<Type>>.Some {value: ty} = move genericSectionEnvironment(&store, &caller) {
  let sourceOwner = run glueSourceOwner(&mut store, &caller)
    let glue = run Semantic.demandGlueMir(&mut store, &mut request, &ty, &sourceOwner)
    run Testing.expect(succeeded(&glue) && glueFact(&store, &glue, usize.ZERO) == usize.ZERO
      && glueFact(&store, &glue, 6) == usize.ZERO,
      "borrowed generic section capture glue never drops its referent")
    return ()
  }
  run Testing.expect(false, "a mutable generic section retains its capture record")
}

