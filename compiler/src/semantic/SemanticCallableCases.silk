    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

// The schema is shared by the consumer instances. Inspect their retained MIR rather than
// choosing an executable target from the comparison contract used during admission.
effect fn contextualGenericSectionClaims(text: string<'static>, selected: usize, deferred: usize) -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("contextual-generic-section.silk")
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let caller = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&caller), "closed consumers admit the exact reusable section environment")
  let environment = genericSectionEnvironment(&store, &caller)
  if let Option<Shared<Type>>.Some {value: ty} = move environment {
    run Testing.expect(!Type.hasOpenRuntimeParameters(&ty)
      && Shared<Type>.with<bool>(&ty, fn(value: &Type) -> bool {
        return genericSectionBlueprint(value, selected, deferred, b"bool")
      }), "consumer inference leaves the original target binder deferred and the physical capture unchanged")
  } else { run Testing.expect(false, "contextual admission retains the original schema value") }
  let mut integer = false
  let mut boolean = false
  let selectedMir = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&caller, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selectedMir {
    let mut applications = Vector<Shared<SpecializationApplication>>.make()
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(&store, index) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee, ..} = &blocks[at].terminator {
          if let MirCallee.Instance {key} = &callee {
            if let Option<Shared<SpecializationApplication>>.Some {value} = move InstanceKey.application(&key) {
              run Vector<Shared<SpecializationApplication>>.append(&mut applications, move value)
            } else { run Testing.expect(false, "consumer calls retain ordinary complete function applications") }
          } else { run Testing.expect(false, "consumer calls are direct") }
        }
        at = at + usize.ONE
      }
    }
    let consumers = Vector<Shared<SpecializationApplication>>.asSlice(&applications)
    let mut at = usize.ZERO
    while at < consumers.length {
      let application = run SpecializationApplication.copyShared(&consumers[at])
      let implementation = run Semantic.demandApplicationMir(&mut store, &mut request, &application)
      run Testing.expect(succeeded(&implementation), "each exact consumer lowers its section from closed invocation operands")
      let kind = contextualGenericSectionTarget(&store, &implementation, selected, deferred, false)
      run Testing.expect(kind != usize.ZERO, "each consumer calls select directly with the stored suffix appended")
      if kind == usize.ONE { integer = true }
      if kind == 2 { boolean = true }
      at = at + usize.ONE
    }
  }
  run Testing.expect(integer && boolean, "one schema selects independent i32 and bool original-target instances across consumers")
}

fn contextualGenericSectionTarget(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>,
  selected: usize, deferred: usize, moved: bool) -> usize {
  let selectedMir = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selectedMir {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee, arguments, ..} = &blocks[at].terminator {
          let key = match &callee { MirCallee.Instance {key} => &key _ => { return usize.ZERO } }
          let application = match move InstanceKey.application(key) {
            Option<Shared<SpecializationApplication>>.Some {value} => move value _ => { return usize.ZERO }
          }
          let kind = Shared<SpecializationApplication>.with<usize>(&application,
            fn(value: &SpecializationApplication) -> usize { return genericSectionApplication(value, b"select", selected, deferred) })
          let operands = Vector<MirOperand>.asSlice(&arguments)
          if kind == usize.ZERO || operands.length != 2 || !sectionCaptureOperand(&operands[usize.ONE], moved) {
            return usize.ZERO
          }
          return kind
        }
        at = at + usize.ONE
      }
    }
  }
  return usize.ZERO
}

