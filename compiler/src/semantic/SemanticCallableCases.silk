effect fn effectJoinRunClaims() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("effect-join-runs.silk")
  let text = """
struct Missing { code: i32 }
struct First {}
struct Second {}
fn choose(input: First | Second, base: i32) -> Effect<'static; i32> {
  return match move input {
    First {} => effect { return base + 1 }
    Second {} => effect { return 2 }
  }
}
fn chosen() -> i32 { return run choose(First {}, 1) }
effect fn one() -> i32 { return 1 }
fn returned(flag: bool) -> Effect<'static; i32 ! Missing> {
  if flag { return one() }
  return effect { fail Missing { code: 2 } }
}
effect fn ranReturned(flag: bool) -> i32 ! Missing { return run returned(flag) }
effect fn declared() -> i32 ! Missing {
  let pending: Effect<'static; i32 ! Missing> = effect { return 3 }
  return run pending
}
service Clock {}
fn keep(pending: once Effect<'static; i32 ! Missing ? &mut Clock>) -> i32 { drop pending return 0 }
fn narrower() -> i32 { return keep(one()) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let narrower = run Semantic.demandBody(&mut store, &mut request, &id, b"narrower")
  run Testing.expect(succeeded(&narrower),
    "an Effect argument with fewer failures and requirements fills a wider use contract")
  let choose = run Semantic.demandMir(&mut store, &mut request, &id, b"choose")
  let chosen = run Semantic.demandMir(&mut store, &mut request, &id, b"chosen")
  run Testing.expect(injectCount(&store, &choose) == 2, "each arm stores its own Effect block under its tag in the join")
  run Testing.expect((run joinDispatch(&store, &chosen)) == 2,
    "running a returned join switches on its tag: each case calls a block on that tag's payload")
  let ran = run Semantic.demandMir(&mut store, &mut request, &id, b"ranReturned")
  run Testing.expect(switchCount(&store, &ran) == usize.ONE && edgedCalls(&store, &ran) == usize.ONE,
    "joined returns run under the declared failure: only the alternative that can fail has a failure edge")
  let declared = run Semantic.demandMir(&mut store, &mut request, &id, b"declared")
  run Testing.expect(effectBlockOperands(&store, &declared) == usize.ONE && switchCount(&store, &declared) == usize.ZERO,
    "a declared binding stores one exact Effect as itself and runs its block directly")
  let layeredId = run module("effect-success-run.silk")
  let layeredText = """effect fn two() -> i32 { return 2 }
effect fn layered() -> Effect<'static; i32> { return two() }
pub fn main() -> i32 { return run (run layered()) }
"""
  let mut layeredStore = run applicationSemantic(&layeredId, layeredText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut layeredRequest = Request.forApplication(ModuleId.copy(&layeredId))
  let built = run buildApplication(&mut layeredStore, &mut layeredRequest, staticClosureNodes)
  let emitted = match &built { BackendBuild.Module {..} => true _ => false }
  run Testing.expect(emitted, "running an effect fn's Effect success realizes the run result through its join's storage")
  let composedId = run module("effect-composed-family-success.silk")
  let composedText = """service Counter {
  effect fn get() -> i32 ? &Counter
}
struct Cell { n: i32 }
impl Cell {
  effect fn getImpl(self: &Self) -> i32 { return self.n }
}
impl Counter for Cell { get: Cell.getImpl }
effect fn two() -> i32 { return 2 }
effect fn outer() -> Effect<'static; i32> ? &Counter {
  let ignored = run Counter.get()
  return two()
}
effect fn bind<'env, ?S, A, P, E, ?R>(self: once Effect<'env; A ! E ? R>, provider: &'env P) -> A ! E ? Without<R, S>
where &'env P provides S from R {
  let bound = Intrinsic.bindRequirement<S>(move self, provider)
  return run bound
}
pub fn main() -> i32 {
  let cell = Cell { n: 1 }
  let inner = run bind<Counter>(outer(), &cell)
  return run inner
}
"""
  let mut composedStore = run applicationSemantic(&composedId, composedText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut composedRequest = Request.forApplication(ModuleId.copy(&composedId))
  let composedBuilt = run buildApplication(&mut composedStore, &mut composedRequest, staticClosureNodes)
  let composedEmitted = match &composedBuilt { BackendBuild.Module {..} => true _ => false }
  run Testing.expect(composedEmitted, "a composed run whose success is an Effect family stores that success without widening")
  let nestedId = run module("effect-nested-family.silk")
  let nestedText = """effect fn two() -> i32 { return 2 }
fn nested() -> Effect<'static; Effect<'static; i32>> { return effect { return two() } }
pub fn main() -> i32 {
  let inner = run nested()
  return run inner
}
"""
  let mut nestedStore = run applicationSemantic(&nestedId, nestedText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut nestedRequest = Request.forApplication(ModuleId.copy(&nestedId))
  let nestedBuilt = run buildApplication(&mut nestedStore, &mut nestedRequest, staticClosureNodes)
  let nestedEmitted = match &nestedBuilt { BackendBuild.Module {..} => true _ => false }
  run Testing.expect(nestedEmitted, "a declared Effect success is a family of its own, so a held inner Effect has storage")
  let anonymousId = run module("effect-anonymous-construction.silk")
  let anonymousText = """struct Token { value: i32 }
impl Intrinsic.Drop for Token { fn drop(self: &mut Token) -> () { return () } }
fn spend(token: Token) -> i32 { return token.value }
pub fn main() -> i32 {
  let token = Token { value: 40 }
  let consumed = effect fn(extra: i32) -> i32 { return spend(move token) + extra }
  let pending = consumed(2)
  let base = 1
  let shared = effect fn(extra: i32) -> i32 { return base + extra }
  let again = shared(1)
  let mut count = 0
  let mut counting = effect fn(extra: i32) -> i32 {
    count = count + extra
    return count
  }
  let mut bumped = counting(5)
  let first = run pending
  let second = run again
  let third = run bumped
  return first - second + third - 3
}
"""
  let mut anonymousStore = run applicationSemantic(&anonymousId, anonymousText, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut anonymousRequest = Request.forApplication(ModuleId.copy(&anonymousId))
  let anonymousBody = run Semantic.demandBody(&mut anonymousStore, &mut anonymousRequest, &anonymousId, b"main")
  run Testing.expect(constructedRunMode(&anonymousBody, 2, CallableMode.Once)
    && constructedRunMode(&anonymousBody, 5, CallableMode.Shared)
    && constructedRunMode(&anonymousBody, 8, CallableMode.Mutable),
    "an anonymous effect fn's constructed Effect owns a once callee and follows a shared or exclusive loan of any other")
  let anonymousBuilt = run buildApplication(&mut anonymousStore, &mut anonymousRequest, staticClosureNodes)
  let anonymousEmitted = match &anonymousBuilt { BackendBuild.Module {..} => true _ => false }
  run Testing.expect(anonymousEmitted, "stored anonymous effect fn invocations lower and run through their callee environment")
}

test effect fn effectJoinsCleanOnlyTheStoredAlternative() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
