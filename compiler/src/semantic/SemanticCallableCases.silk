fn select<T>(value: T, enabled: bool) -> T { return move value }
fn integer<F: fn<'static>(i32) -> i32>(callback: F) -> i32 { return callback(41) }
fn boolean<F: fn<'static>(bool) -> bool>(callback: F) -> bool { return callback(true) }
fn plain(callback: fn<'static>(i32) -> i32) -> i32 { return callback(1) }
fn main() -> i32 {
  let next = select(true)
  let first = integer(next)
  if boolean(next) { return first + plain(next) }
  return 0
}
"""
  return run contextualGenericSectionClaims(text, usize.MAX, usize.ZERO)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

test effect fn contextualGenericSectionsWaitForLaterOperandInference() -> ()
