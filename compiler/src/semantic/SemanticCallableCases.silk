effect fn genericStagingClaims(text: string<'static>, selected: bool, twoTypes: bool) -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("generic-staging.silk")
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let caller = run Semantic.demandMir(&mut store, &mut request, &id, b"main")
  run Testing.expect(succeeded(&caller) && genericStagingCalls(&store, &caller, false, twoTypes),
    "stages directly call the original complete target and append field one before field zero")
  if let Option<Shared<Type>>.Some {value: ty} = move genericStagingEnvironment(&store, &caller) {
    run Testing.expect(!Type.hasOpenRuntimeParameters(&ty) && Shared<Type>.with<bool>(&ty,
      fn(value: &Type) -> bool { return genericStagingMetadata(value, selected) }),
      "staging keeps original binder ordinals, selected evidence and capture construction order without publishing a fresh inference owner")
    let layout = run Semantic.demandLayout(&mut store, &mut request, &id, &ty)
    let selectedLayout = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(&layout, selectedLayoutIndex)
    if let Option<usize>.Some {value: index} = move selectedLayout {
      if let Option<Shared<BackendLayout>>.Some {value} = move Semantic.layoutAt(&store, index) {
        run Testing.expect(Shared<BackendLayout>.with<bool>(&value, genericStagingRecord),
          "staging lays out only bool then i32 captures, without an adapter, code pointer or nested section environment")
        return ()
      }
    }
  }
  run Testing.expect(false, "a generic stage retains its exact two-capture record layout")
}

fn genericStagingFieldCount(value: &Type) -> usize {
  return match &value.* {
    Type.CallableSchema {captures, ..} => Vector<Shared<Type>>.length(&captures)
    Type.CallableValue {captures, ..} => Vector<Shared<Type>>.length(&captures)
    _ => usize.ZERO
  }
}

fn genericStagingEnvironment(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>) -> Option<Shared<Type>> {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let locals = Vector<MirLocal>.asSlice(&function.locals)
      let mut at = usize.ZERO
      while at < locals.length {
        if Shared<Type>.with<usize>(&locals[at].ty, genericStagingFieldCount) == 2 {
          return Option<Shared<Type>>.some(Shared<Type>.clone(&locals[at].ty))
        }
        at = at + usize.ONE
      }
    }
  }
  return Option<Shared<Type>>.none()
}

fn genericStagingInput(value: &CallableFieldInput, parameter: usize) -> bool {
  return match &value.* { CallableFieldInput.Argument {parameter: at} => at == parameter _ => false }
}

fn genericStagingMetadata(value: &Type, selected: bool) -> bool {
  if let Type.CallableValue {application, captures, fieldInputs, ..} = &value.* {
    if !selected || !genericStagingCaptureOrder(&captures, &fieldInputs) { return false }
    return Shared<SpecializationApplication>.with<bool>(&application, fn(target: &SpecializationApplication) -> bool {
      return Vector<ScopeBinding>.length(&target.scopes) == usize.ZERO && Vector<StaticSlot>.length(&target.statics) == usize.ZERO
        && genericSectionApplication(target, b"select", usize.ZERO, usize.ZERO) == usize.ONE
    })
  }
  if let Type.CallableSchema {schema, captures, fieldInputs, ..} = &value.* {
    if selected || !genericStagingCaptureOrder(&captures, &fieldInputs) { return false }
    return Shared<SectionSchema>.with<bool>(&schema, fn(recipe: &SectionSchema) -> bool {
      let evidence = Vector<Binding>.asSlice(&recipe.selected)
      let deferred = Vector<usize>.asSlice(&recipe.deferred)
      return evidence.length == usize.ZERO && deferred.length == usize.ONE && deferred[usize.ZERO] == usize.ZERO
    })
  }
  return false
}

fn genericStagingCaptureOrder(captures: &Vector<Shared<Type>>, fieldInputs: &Vector<CallableFieldInput>) -> bool {
  let inputs = Vector<CallableFieldInput>.asSlice(fieldInputs)
  return Vector<Shared<Type>>.length(captures) == 2 && inputs.length == 2
    && genericStagingInput(&inputs[usize.ZERO], 2) && genericStagingInput(&inputs[usize.ONE], usize.ONE)
}

fn genericStagingRecord(value: &BackendLayout) -> bool {
  if let LayoutStorage.Record {fields} = &value.storage {
    let listed = Vector<LayoutField>.asSlice(&fields)
    return listed.length == 2 && listed[usize.ZERO].offset == usize.ZERO && listed[usize.ONE].offset == 4
      && Shared<Type>.with<bool>(&listed[usize.ZERO].ty, fn(ty: &Type) -> bool { return witnessPrimitive(ty, b"bool") })
      && Shared<Type>.with<bool>(&listed[usize.ONE].ty, fn(ty: &Type) -> bool { return witnessPrimitive(ty, b"i32") })
  }
  return false
}

fn genericStagingCalls(store: &Semantic, answer: &Shared<Result<Answer, NoRejection>>, moved: bool, twoTypes: bool) -> bool {
  let selected = Shared<Result<Answer, NoRejection>>.with<Option<usize>>(answer, selectedMirIndex)
  let mut integer = false
  let mut boolean = false
  if let Option<usize>.Some {value: index} = move selected {
    if let Option<&MirFunction>.Some {value: function} = move Semantic.mirAt(store, index) {
      let blocks = Vector<MirBlock>.asSlice(&function.blocks)
      let mut at = usize.ZERO
      while at < blocks.length {
        if let MirTerminator.Call {callee, arguments, ..} = &blocks[at].terminator {
          let key = match &callee { MirCallee.Instance {key} => &key _ => { return false } }
          let application = match move InstanceKey.application(key) {
            Option<Shared<SpecializationApplication>>.Some {value} => move value _ => { return false }
          }
          let kind = Shared<SpecializationApplication>.with<usize>(&application,
            fn(value: &SpecializationApplication) -> usize { return genericSectionApplication(value, b"select", usize.MAX, usize.ZERO) })
          let values = Vector<MirOperand>.asSlice(&arguments)
          if kind == usize.ZERO || values.length != 3 || !genericStagingOperand(&values[usize.ONE], usize.ONE, moved)
            || !genericStagingOperand(&values[2], usize.ZERO, moved) { return false }
          if kind == usize.ONE { integer = true }
          if kind == 2 { boolean = true }
        }
        at = at + usize.ONE
      }
    }
  }
  return integer && boolean == twoTypes
}

fn genericStagingOperand(value: &MirOperand, field: usize, moved: bool) -> bool {
  if moved {
    if let MirOperand.Move {place} = &value.* {
      return Vector<MirProjection>.length(&place.projections) == usize.ONE && lastProjectionCode(&place.projections) == field
    }
    return false
  }
  return sectionStoredField(value, field)
}

test effect fn genericSectionsStageOwnedCapturesWithOneCleanupOwner() -> ()
! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
