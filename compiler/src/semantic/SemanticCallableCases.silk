effect fn openReborrowClaims() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let id = run module("open-reference-reborrow.silk")
  let text = """
fn edit<P>(value: &mut P) -> () { return () }
fn forward<P>(value: &mut P) -> () { return edit(&mut value) }
fn owned(value: i32) -> () { return edit(&mut value) }
"""
  let mut store = run staticSemantic(&id, text, MachineTarget.forId(TargetId.X8664UnknownLinuxGnu))
  let mut request = Request.make()
  let forward = run Semantic.demandBody(&mut store, &mut request, &id, b"forward")
  let owned = run Semantic.demandBody(&mut store, &mut request, &id, b"owned")
  run Testing.expect(succeeded(&forward) && rejectsSpan(&owned, RejectionCode.ExclusiveBorrowRequiresMutable, text, "&mut value", 1),
    "an exclusive binding reborrows for an inferred reference parameter, and an immutable owner stays refused")
  return ()
}

// A generic binding in the shape of `Effect.bindRequirementOwned` serves its key from the owned
// provider inside its own instance, whose row is then empty; the provider type keys the callee.
test effect fn ownedProviderServesGenericBinding() -> ()
! InvalidModulePath | Cycle | RevisionMismatch | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut typeTable = TypeTable.make()
  let id = run module("owned-providers.silk") |> Effect.provideMut<Allocator>(&mut allocator)
  let text = """
effect<'env> fn bindOwned<'env, ?S, A, P: 'env, E, ?R>(self: once Effect<'env; A ! E ? R>, provider: P) -> A ! E ? Without<R, S>
where P provides S from R {
  let bound = Intrinsic.bindRequirementOwned<S>(move self, move provider)
  return run bound
}
service Counter {
  effect fn get() -> i32 ? &Counter
  effect fn bump() -> () ? &mut Counter
}
struct Cell { value: i32 }
effect fn get(self: &Cell) -> i32 { return self.value }
effect fn bump(self: &mut Cell) -> () { self.value = self.value + 1 }
impl Counter for Cell { get: Cell.get bump: Cell.bump }
effect fn both() -> i32 ? &mut Counter {
  run Counter.bump()
  return run Counter.get()
}
fn owned() -> i32 { return run bindOwned<Counter>(both(), Cell { value: 1 }) }
struct Full { code: i32 }
service Sink {
  effect fn put() -> () ! Full ? &mut Sink
  effect fn settle() -> () ! Full ? &mut Sink
}
effect fn put(self: &mut Cell) -> () { self.value = self.value + 1 }
effect fn settle(self: &mut Cell) -> () ! Full { if self.value > 9 { fail Full { code: self.value } } }
impl Sink for Cell { put: Cell.put settle: Cell.settle }
effect fn drain() -> () ! Full ? &mut Sink {
  run Sink.put()
  run Sink.settle()
}
effect fn sinking() -> i32 ! Full {
  let mut cell = Cell { value: 1 }
  run Intrinsic.bindRequirementMut<Sink>(drain(), &mut cell)
  run Intrinsic.bindRequirementMut<Sink>(Sink.put(), &mut cell)
  return cell.value
}
interface Produce { effect<'env> fn produce<'env>(source: &'env Self) -> i32 ? &mut Sink }
struct Maker { base: i32 }
impl Produce for Maker {
  effect<'env> fn produce<'env>(source: &'env Self) -> i32 ? &mut Sink {
    run Sink.put()
    return source.base
  }
}
effect fn producedFrom<S: Produce>(source: &S) -> i32 {
  let mut cell = Cell { value: 1 }
  return run Intrinsic.bindRequirementMut<Sink>(Produce.produce(source), &mut cell)
}
effect fn produced() -> i32 {
  let maker = Maker { base: 3 }
  return run producedFrom(&maker)
}
effect fn prefixedOperation() -> i32 ? &Counter { return run Counter.get<i32>() }
struct Guard { value: i32 }
impl Intrinsic.Drop for Guard { fn drop(self: &mut Guard) -> () { return () } }
effect fn guardPut(self: &mut Guard) -> () { self.value = self.value + 1 }
effect fn guardSettle(self: &mut Guard) -> () ! Full { if self.value > 9 { fail Full { code: self.value } } }
impl Sink for Guard { put: Guard.guardPut settle: Guard.guardSettle }
effect fn guarded() -> i32 ! Full {
  run bindOwned<Sink>(drain(), Guard { value: 1 })
  return 0
}
fn lasting<T: 'static>(value: T) -> i32 { return 0 }
fn shortLived() -> i32 {
  let local = 1
  return lasting(&local)
}
fn pair<'borrow, 'value: 'borrow>(target: &'borrow mut i32, value: &'value i32) -> i32 { return value.* }
fn loaned(target: &mut i32) -> i32 {
  let local = 7
  return pair(move target, &local)
}
fn forever<'value: 'static>(value: &'value i32) -> i32 { return value.* }
fn transient() -> i32 {
  let local = 3
  return forever(&local)
}
struct Lent<'inner> { value: &'inner mut i32 }
effect fn lend<'outer, 'callback, A, E, ?R>(
  target: &'outer mut i32,
  callback: for<'call, 'view: 'call> once fn<'callback>(&'call mut Lent<'view>) -> once Effect<'call; A ! E ? R>,
) -> A ! E ? R {
  let mut lent = Lent<'outer> {value: move target}
  let use = effect fn(owned: &mut Lent<'outer>) -> A ! E ? R { return run callback(move owned) }
  return run use(&mut lent)
}
struct Wire<'t> { transport: &'t mut i32 }
struct Nest<'r, 't> { wire: &'r mut Wire<'t> }
fn readNest<'call, 'view: 'call, 'deep: 'view>(nest: &'call mut Nest<'view, 'deep>) -> i32 { return nest.wire.transport.* }
fn invokeNest<'p, 'view, 'deep>(
  owned: &'p mut Nest<'view, 'deep>,
  callback: for<'call, 'outer: 'call, 'inner: 'outer> fn<'static>(&'call mut Nest<'outer, 'inner>) -> i32,
) -> i32 {
  return callback(move owned)
}
fn storedField() -> i32 {
  let mut value = 42
  let mut wire = Wire {transport: &mut value}
  let mut nest = Nest {wire: &mut wire}
  return invokeNest(&mut nest, readNest)
}
struct Holder<'t> { value: &'t i32 }
struct Pane<'r, 'x, 't> {
  body: &'r mut i32
  tail: &'x mut Holder<'t>
}
fn readPane<'call, 'view: 'call, 'slot: 'call, 'deep: 'view>(pane: &'call mut Pane<'view, 'slot, 'deep>) -> i32 {
  return pane.body.* + pane.tail.value.*
}
fn throughPane<'view, 'slot, 'deep: 'view>(
  body: &'view mut i32,
  tail: &'slot mut Holder<'deep>,
  callback: for<'call, 'outer: 'call, 'held: 'call, 'inner: 'outer> fn<'static>(&'call mut Pane<'outer, 'held, 'inner>) -> i32,
) -> i32 {
  let mut pane = Pane<'view, 'slot, 'deep> {body: move body, tail: move tail}
  let use = fn(owned: &mut Pane<'view, 'slot, 'deep>) -> i32 { return callback(move owned) }
  return use(&mut pane)
}
fn enclosingBound() -> i32 {
  let mut value = 30
  let deep = 12
  let mut holder = Holder {value: &deep}
  return throughPane(&mut value, &mut holder, readPane)
}
