fn invoke(callback: fn<'static>(i32, i32) -> i32) -> i32 {
  let next = callback(2)
  return next(1)
}
fn main() -> i32 {
  let base = 40
  let add = fn(first: i32, last: i32) -> i32 { return base + first + last }
  return invoke(add)
}
"""
  return run stagedCallableParameterClaims(text, CallableMode.Shared, false)
    |> Effect.provideMut<Types>(&mut typeTable) |> Effect.provideMut<Allocator>(&mut allocator)
}

