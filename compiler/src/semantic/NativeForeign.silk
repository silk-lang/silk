//! Closed scalar C function-pointer contract admission, independent of source callable storage.

import hir.Hir {HirId, Module, Node, Range}
import semantic.ForeignContract {ForeignContract, Locality, Memory}
import silk.option {Option}
import silk.usize

fn equal(actual: &[u8], expected: &[u8]) -> bool {
  if actual.length != expected.length { return false }
  let mut at = usize.ZERO
  while at < actual.length {
    if actual[at] != expected[at] { return false }
    at = at + usize.ONE
  }
  return true
}
fn name(hir: &Module, id: HirId, expected: &[u8]) -> bool {
  return match Module.node(hir, id) { Node.Name {text} => equal(Module.text(hir, text), expected) _ => false }
}
fn text(hir: &Module, id: HirId, expected: &[u8]) -> bool {
  return match Module.node(hir, id) { Node.TextLiteral {value} => equal(Module.text(hir, value), expected) _ => false }
}
pub fn contract(hir: &Module, properties: Range) -> Option<ForeignContract> {
  return readContract(hir, properties, false)
}

/// Reads a declaration contract, including the external module and name properties.
/// Module properties describe linkage and do not change the callable's memory behavior.
pub fn declarationContract(hir: &Module, properties: Range) -> Option<ForeignContract> {
  return readContract(hir, properties, true)
}

fn readContract(hir: &Module, properties: Range, declaration: bool) -> Option<ForeignContract> {
  let mut result = ForeignContract.conservative()
  let mut memory = false
  let mut locality = false
  let mut at = usize.ZERO
  while at < properties.length {
    if let Node.PropertyClause {namespace, operation, properties: fields} = Module.node(hir, Module.child(hir, properties, at)) {
      if !name(hir, namespace, b"Intrinsic") || !name(hir, operation, b"foreign") { return Option<ForeignContract>.none() }
      let mut field = usize.ZERO
      while field < fields.length {
        if let Node.Property {name: spelling, value} = Module.node(hir, Module.child(hir, fields, field)) {
          if name(hir, spelling, b"memory") {
            if memory { return Option<ForeignContract>.none() }
            memory = true
            if text(hir, value, b"none") { result.memory = Memory.None }
            else if text(hir, value, b"read") { result.memory = Memory.Read }
            else if text(hir, value, b"write") { result.memory = Memory.Write }
            else if text(hir, value, b"readwrite") { result.memory = Memory.ReadWrite }
            else { return Option<ForeignContract>.none() }
          } else if name(hir, spelling, b"locality") {
            if locality { return Option<ForeignContract>.none() }
            locality = true
            if text(hir, value, b"arguments") { result.locality = Locality.Arguments }
            else if text(hir, value, b"external") { result.locality = Locality.External }
            else { return Option<ForeignContract>.none() }
          } else if declaration && (name(hir, spelling, b"module") || name(hir, spelling, b"name")) {
            // The declaration reader checks values, duplicates, direction and target support.
          } else { return Option<ForeignContract>.none() }
        } else { return Option<ForeignContract>.none() }
        field = field + usize.ONE
      }
    } else { return Option<ForeignContract>.none() }
    at = at + usize.ONE
  }
  if result.memory == Memory.None { result.locality = Locality.External }
  return Option<ForeignContract>.some(result)
}

fn letter(byte: u8) -> bool { return (byte >= 65 && byte <= 90) || (byte >= 97 && byte <= 122) || byte == 95 }
fn digit(byte: u8) -> bool { return byte >= 48 && byte <= 57 }
fn lowerHex(byte: u8) -> bool { return digit(byte) || (byte >= 97 && byte <= 102) }
fn startsWith(text: &[u8], prefix: &[u8]) -> bool {
  if text.length < prefix.length { return false }
  let mut at = usize.ZERO
  while at < prefix.length {
    if text[at] != prefix[at] { return false }
    at = at + usize.ONE
  }
  return true
}

/// Whether `symbol` is an ASCII identifier native linkers accept unquoted (FFI-005): a letter or
/// underscore, then letters, digits, underscores, or a `$` after the first byte (`close$NOCANCEL`).
pub fn validSymbol(symbol: &[u8]) -> bool {
  if symbol.length == usize.ZERO || !letter(symbol[usize.ZERO]) { return false }
  let mut at = usize.ONE
  while at < symbol.length {
    let byte = symbol[at]
    if !letter(byte) && !digit(byte) && byte != 36 { return false }
    at = at + usize.ONE
  }
  return true
}

/// Whether a WebAssembly import or export name is nonempty and contains no NUL byte.
pub fn validWasmName(symbol: &[u8]) -> bool {
  if symbol.length == usize.ZERO { return false }
  let mut at = usize.ZERO
  while at < symbol.length {
    if symbol[at] == 0 { return false }
    at = at + usize.ONE
  }
  return true
}

/// Whether `symbol` names a process entry that the selected runtime defines (`main`, `_start`).
pub fn entrySymbol(symbol: &[u8]) -> bool {
  return equal(symbol, b"main") || equal(symbol, b"_start")
}

/// Whether `symbol` is reserved by the compiler or its runtime (FFI-005): a process entry, the
/// foreign unwind personality, a content-addressed instance symbol (`silk_` and 32 lowercase hex
/// digits), the raw process entry, execution-storage and suspension hooks, or any `__silk_` or
/// `silk_…__` spelling.
pub fn reservedSymbol(symbol: &[u8]) -> bool {
  if entrySymbol(symbol) || equal(symbol, b"silk_raw_process_entry") { return true }
  if startsWith(symbol, b"__silk_") || startsWith(symbol, b"silk_suspend_") || startsWith(symbol, b"silk_execution_storage_") {
    return true
  }
  if !startsWith(symbol, b"silk_") { return false }
  if symbol.length >= 7 && symbol[symbol.length - 1] == 95 && symbol[symbol.length - 2] == 95 { return true }
  if symbol.length != 37 { return false }
  let mut at: usize = 5
  while at < symbol.length {
    if !lowerHex(symbol[at]) { return false }
    at = at + usize.ONE
  }
  return true
}
