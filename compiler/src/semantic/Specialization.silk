//! Closed semantic applications and finite admission of requested runtime specializations.
//!
//! # When to use
//! A caller first checks a source body against its abstract contract and selects concrete
//! conformance evidence. Intern the resulting closed application here; then enter each demanded
//! call path before following it. This module does not discover executable roots or emit code.

import semantic.Types {Types, TypeTable}
import semantic.DeclarationId {DeclarationId, OwnerStep}
import semantic.Lifetime {CanonicalizationFailure, Lifetime, Numbering}
import semantic.ModuleId {InvalidModulePath, ModuleId}
import semantic.RuntimeEncoding
import semantic.RuntimeEncoding {Coordinates}
import silk.collections.bytes {Bytes}
import silk.collections.hash {Hash}
import semantic.StaticValue
import semantic.StaticValue {Value as StaticData}
import semantic.Type {Argument, Binding, Row, Type}
import hir.Hir {Access}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.core.option {Option}
import silk.core.effect {Effect}
import silk.testing.testing {AssertionError, Testing}
import silk.core.ownership {Copy}
import silk.mem.pointer {Pointer}
import silk.core.result {Result}
import silk.mem.interned {Interned}
import silk.num.usize
import silk.collections.list {List}

/// A concrete function body or a selected interface operation and its exact witness.
pub union Target {
  Named {pub declaration: DeclarationId},
  Operation {
    pub contract: Interned<Type>,
    pub provider: Interned<Type>,
    pub operation: DeclarationId,
    pub implementation: DeclarationId,
  },
}

/// One application after call inference and conformance selection have completed.
/// Lifetime arguments are retained here for semantic validity and erased only in runtime equality.
/// A selected instance's application numbers its caller regions canonically ([`Numbering`]).
pub struct Application {
  pub target: Target,
  pub arguments: List<Argument>,
  /// Original declaration ordinals paired with the own arguments; never compacted or renumbered.
  pub argumentOrdinals: List<usize>,
  /// Supplied enclosing environments in lexical owner order, excluding derived `Self`.
  /// Each supplied argument is complete. A contract-independent inherent owner slot may be
  /// absent; it must not be replaced with an arbitrary type or an open argument. Body uses of
  /// an absent slot remain open and cannot acquire a runtime layout.
  pub scopes: List<ScopeBinding>,
  /// Complete static argument values at the target's original static parameter indices, in
  /// authored order. A static parameter has no runtime lane, so its value is part of identity.
  pub statics: List<StaticSlot>,
}

/// One static argument value paired with its original parameter index in the target.
pub struct StaticSlot {
  pub ordinal: usize,
  pub value: Interned<StaticData>,
}

impl StaticSlot {
  /// The first ordinal of a literal's enclosing static locals: a `static for` binder or a
  /// `let static` value, numbered by their order around the literal after the owner's own
  /// `static` parameters. Each unrolled iteration's literal is then its own instance.
  // 2^31, so the base fits a 32-bit `usize` as well.
  pub fn localBase() -> usize { return 2147483648 }

  /// Whether `ordinal` holds an enclosing static local rather than a `static` parameter.
  pub fn isLocal(ordinal: usize) -> bool { return ordinal >= StaticSlot.localBase() }
}

fn numberingDeclaration(value: &DeclarationId, numbering: &mut Numbering) -> bool {
  if !Numbering.units(&mut numbering.*, DeclarationId.ownerCount(value)) { return false }
  return Numbering.bytes(&mut numbering.*, RuntimeEncoding.declarationPayload(value))
}

effect fn copyStatics(slots: &[StaticSlot]) -> List<StaticSlot> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = run List<StaticSlot>.makeWithCapacity(slots.length)
  let mut at = usize.ZERO
  while at < slots.length {
    run List<StaticSlot>.append(&mut copied, StaticSlot {ordinal: slots[at].ordinal, value: StaticValue.copy(&slots[at].value)})
    at = at + usize.ONE
  }
  return move copied
}

/// Arguments for one actual enclosing declaration, preserving original binder ownership.
pub struct ScopeBinding {
  pub owner: Interned<DeclarationId>,
  pub arguments: List<Argument>,
  pub argumentOrdinals: List<usize>,
  /// The owner's static argument values, as its own application holds them. A nested literal
  /// is specialized by them exactly as by the owner's type arguments; empty when the owner has
  /// no static parameters or the scope is still formal.
  pub statics: List<StaticSlot>,
}

/// Positions in this pool's semantic and lifetime-erased runtime identity tables.
pub struct Identity {
  pub semantic: usize,
  pub runtime: usize,
}

impl Copy for Identity {}

/// Interns requested applications without discovering any other program roots.
pub struct Pool {
  semantic: List<Application>,
  runtime: List<Application>,
  // The runtime encoding of each `runtime` entry, made once when the entry is added: two
  // applications are runtime-equal exactly when these encodings are equal.
  runtimeEncodings: List<Bytes>,
}

/// The active request path. One caller owns the path while visiting its requested callees.
pub struct Admission {
  active: List<Step>,
}

struct Step {
  application: Application,
  edge: Edge,
}

/// Operand transport already validated by the witness header comparison.
/// This evidence belongs to the call edge, never canonical target identity.
pub union OperandPass {
  Value,
  Borrow {pub access: Access, pub lifetimeOrdinal: usize},
}

impl Copy for OperandPass {}

/// How a requested application was reached from its parent on the active path.
pub union Edge {
  Direct,
  Witness,
  /// A Drop hook selected by the cleanup of `owner`, the value a function dropped.
  Cleanup {pub owner: Interned<Type>},
}

/// Whether a requested application is concrete and its bounded identity was established.
pub union Decision {
  Entered,
  Open,
  /// The bounded identity transaction could not establish this application. This is a resource
  /// or canonicalization refusal, never a claim that the reachable specialization graph is infinite.
  NotProven {pub reason: CanonicalizationFailure},
}

effect fn copyArgument(value: &Argument) -> Argument ! OutOfMemoryError ? &mut Allocator {
  return match & value.* {
    Argument.Type {value: ty} => Argument.Type {value: Interned<Type>.clone(&ty)}
    Argument.Lifetime {value: lifetime} => Argument.Lifetime {
      value: Interned<Lifetime>.clone(&lifetime),
    }
    Argument.Row {value: row} => Argument.Row {value: Interned<Row>.clone(&row)}
  }
}

effect fn copyOrdinals(values: &[usize]) -> List<usize> ! OutOfMemoryError ? &mut Allocator {
  let mut output = run List<usize>.makeWithCapacity(values.length)
  run List<usize>.appendSlice(&mut output, values)
  return move output
}

effect fn copyArguments(values: &[Argument]) -> List<Argument> ! OutOfMemoryError ? &mut Allocator {
  let mut output = run List<Argument>.makeWithCapacity(values.length)
  let mut at = usize.ZERO
  while at < values.length {
    run List<Argument>.append(&mut output, run copyArgument(&values[at]))
    at = at + usize.ONE
  }
  return move output
}

impl ScopeBinding {
  pub effect fn copy(self: &Self) -> ScopeBinding ! OutOfMemoryError ? &mut Allocator {
    return ScopeBinding {owner: Interned<DeclarationId>.clone(&self.owner),
      arguments: run copyArguments(List<Argument>.asSlice(&self.arguments)),
      argumentOrdinals: run copyOrdinals(List<usize>.asSlice(&self.argumentOrdinals)),
      statics: run copyStatics(List<StaticSlot>.asSlice(&self.statics))}
  }
  /// A copy of the owner's static values alone.
  pub effect fn staticsCopy(self: &Self) -> List<StaticSlot> ! OutOfMemoryError ? &mut Allocator {
    return run copyStatics(List<StaticSlot>.asSlice(&self.statics))
  }
}

// Gives `closed`'s scope for enclosing `owner` the owner's static `values`, adding that scope when
// `owner` encloses `closed`'s body and the application holds none for it.
effect fn closeStatics(closed: &mut Application, owner: &Interned<DeclarationId>, values: &[StaticSlot]) -> ()
! OutOfMemoryError ? &mut Allocator {
  if values.length == usize.ZERO { return () }
  let scopes = List<ScopeBinding>.asMutSlice(&mut closed.scopes)
  let mut at = usize.ZERO
  while at < scopes.length {
    if sameOwner(&scopes[at].owner, owner) {
      if List<StaticSlot>.length(&scopes[at].statics) == usize.ZERO { scopes[at].statics = run copyStatics(values) }
      return ()
    }
    at = at + usize.ONE
  }
  let encloses = Interned<DeclarationId>.with<bool>(owner, fn(id: &DeclarationId) -> bool {
    return !DeclarationId.equals(id, body(&closed.*)) && DeclarationId.isPrefixOf(id, body(&closed.*))
  })
  if !encloses { return () }
  return run List<ScopeBinding>.append(&mut closed.scopes, ScopeBinding {owner: Interned<DeclarationId>.clone(owner),
    arguments: List<Argument>.make(), argumentOrdinals: List<usize>.make(), statics: run copyStatics(values)})
}

fn sameOwner(left: &Interned<DeclarationId>, right: &Interned<DeclarationId>) -> bool {
  let first = Interned<DeclarationId>.with<usize>(left, fn(id: &DeclarationId) -> usize {
    return Pointer.address<DeclarationId>(Pointer.fromRef<DeclarationId>(id))
  })
  let second = Interned<DeclarationId>.with<usize>(right, fn(id: &DeclarationId) -> usize {
    return Pointer.address<DeclarationId>(Pointer.fromRef<DeclarationId>(id))
  })
  if first == second { return true }
  return Interned<DeclarationId>.with<bool>(left, fn(id: &DeclarationId) -> bool { return sameOwnerRight(id, right) })
}

fn sameOwnerRight(left: &DeclarationId, right: &Interned<DeclarationId>) -> bool {
  return Interned<DeclarationId>.with<bool>(right, fn(other: &DeclarationId) -> bool { return DeclarationId.equals(left, other) })
}

fn sameOrdinals(left: &[usize], right: &[usize]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

fn ordered(ordinals: &[usize], count: usize) -> bool {
  if ordinals.length != count { return false }
  let mut at = usize.ONE
  while at < ordinals.length {
    if ordinals[at - usize.ONE] >= ordinals[at] { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn copyApplication(value: &Application) -> Application ! OutOfMemoryError ? &mut Allocator {
  let target = match & value.target {
    Target.Named {declaration} => Target.Named {declaration: DeclarationId.copy(&declaration)}
    Target.Operation {contract, provider, operation, implementation} => Target.Operation {
      contract: Interned<Type>.clone(&contract),
      provider: Interned<Type>.clone(&provider),
      operation: DeclarationId.copy(&operation),
      implementation: DeclarationId.copy(&implementation),
    }
  }
  let mut arguments = List<Argument>.make()
  let listed = List<Argument>.asSlice(&value.arguments)
  let mut at = usize.ZERO
  while at < listed.length {
    run List<Argument>.append(&mut arguments, run copyArgument(&listed[at]))
    at = at + usize.ONE
  }
  let mut scopes = List<ScopeBinding>.make()
  let enclosing = List<ScopeBinding>.asSlice(&value.scopes)
  at = usize.ZERO
  while at < enclosing.length {
    run List<ScopeBinding>.append(&mut scopes, run ScopeBinding.copy(&enclosing[at]))
    at = at + usize.ONE
  }
  return Application {target: move target, arguments: move arguments,
    argumentOrdinals: run copyOrdinals(List<usize>.asSlice(&value.argumentOrdinals)), scopes: move scopes,
    statics: run copyStatics(List<StaticSlot>.asSlice(&value.statics))}
}

fn closedArgument(value: &Argument) -> bool {
  return match & value.* {
    Argument.Type {value: ty} => !Type.hasOpenRuntimeParameters(&ty)
    Argument.Lifetime {..} => true
    Argument.Row {value: row} => !Row.hasOpenRuntimeParameters(&row)
  }
}

fn closed(value: &Application) -> bool {
  if let Target.Operation {contract, provider, ..} = &value.target {
    if Type.hasOpenRuntimeParameters(&contract) || Type.hasOpenRuntimeParameters(&provider) {
      return false
    }
  }
  let arguments = List<Argument>.asSlice(&value.arguments)
  if !ordered(List<usize>.asSlice(&value.argumentOrdinals), arguments.length) { return false }
  let statics = List<StaticSlot>.asSlice(&value.statics)
  let mut staticAt = usize.ONE
  while staticAt < statics.length {
    if statics[staticAt - usize.ONE].ordinal >= statics[staticAt].ordinal { return false }
    staticAt = staticAt + usize.ONE
  }
  let scopes = List<ScopeBinding>.asSlice(&value.scopes)
  let mut scopeAt = usize.ZERO
  while scopeAt < scopes.length {
    let owner = &scopes[scopeAt].owner
    if Interned<DeclarationId>.with<bool>(owner, fn(id: &DeclarationId) -> bool {
      return DeclarationId.equals(id, body(value))
    }) { return false }
    let mut before = usize.ZERO
    while before < scopeAt {
      if sameOwner(owner, &scopes[before].owner) { return false }
      before = before + usize.ONE
    }
    let given = List<Argument>.asSlice(&scopes[scopeAt].arguments)
    // A scope carries type arguments, static values, or both; one with neither is not a scope.
    let held = List<StaticSlot>.asSlice(&scopes[scopeAt].statics)
    if (given.length == usize.ZERO && held.length == usize.ZERO)
      || !ordered(List<usize>.asSlice(&scopes[scopeAt].argumentOrdinals), given.length) { return false }
    let mut heldAt = usize.ONE
    while heldAt < held.length {
      if held[heldAt - usize.ONE].ordinal >= held[heldAt].ordinal { return false }
      heldAt = heldAt + usize.ONE
    }
    let mut index = usize.ZERO
    while index < given.length {
      if !closedArgument(&given[index]) { return false }
      index = index + usize.ONE
    }
    scopeAt = scopeAt + usize.ONE
  }
  let mut at = usize.ZERO
  while at < arguments.length {
    if !closedArgument(&arguments[at]) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn body(value: &Application) -> &DeclarationId {
  return match & value.target {
    Target.Named {declaration} => &declaration
    Target.Operation {implementation, ..} => &implementation
  }
}

effect fn sameType(left: &Interned<Type>, right: &Interned<Type>, runtime: bool) -> bool
! OutOfMemoryError
? &mut Allocator | &mut Types {
  if runtime {
    return run Type.runtimeEqualsShared(left, right)
  }
  return run Type.equalsShared(left, right)
}

effect fn sameArgument(left: &Argument, right: &Argument, runtime: bool) -> bool
! OutOfMemoryError
? &mut Allocator | &mut Types {
  return match & left.* {
    Argument.Type {value} => match & right.* {
      Argument.Type {value: compared} => run sameType(&value, &compared, runtime)
      _ => false
    }
    Argument.Lifetime {value} => match & right.* {
      Argument.Lifetime {value: compared} => runtime || Lifetime.equalsShared(&value, &compared)
      _ => false
    }
    Argument.Row {value} => match & right.* {
      Argument.Row {value: compared} => {
        if runtime {
          return run Row.runtimeEqualsShared(&value, &compared)
        }
        return run Row.equalsShared(&value, &compared)
      }
      _ => false
    }
  }
}

effect fn sameTarget(left: &Target, right: &Target, runtime: bool) -> bool
! OutOfMemoryError
? &mut Allocator | &mut Types {
  return match & left.* {
    Target.Named {declaration} => match & right.* {
      Target.Named {declaration: compared} => DeclarationId.equals(&declaration, &compared)
      _ => false
    }
    Target.Operation {contract, provider, operation, implementation} => match & right.* {
      Target.Operation {
        contract: otherContract,
        provider: otherProvider,
        operation: otherOperation,
        implementation: otherImplementation,
      } => {
        if !DeclarationId.equals(&operation, &otherOperation) || !DeclarationId.equals(
          &implementation,
          &otherImplementation,
        ) {
          return false
        }
        if !run sameType(&contract, &otherContract, runtime) {
          return false
        }
        return run sameType(&provider, &otherProvider, runtime)
      }
      _ => false
    }
  }
}

fn applicationArgumentCount(value: &Application) -> usize {
  let mut count = List<Argument>.length(&value.arguments)
  let scopes = List<ScopeBinding>.asSlice(&value.scopes)
  let mut at = usize.ZERO
  while at < scopes.length { count = count + List<Argument>.length(&scopes[at].arguments) at = at + usize.ONE }
  return count
}

fn applicationArgumentAt(value: &Application, at: usize) -> Option<Argument> {
  let own = List<Argument>.asSlice(&value.arguments)
  if at < own.length { return Option<Argument>.some(Argument.copy(&own[at])) }
  let mut position = at - own.length
  let scopes = List<ScopeBinding>.asSlice(&value.scopes)
  let mut scopeAt = usize.ZERO
  while scopeAt < scopes.length {
    let supplied = List<Argument>.asSlice(&scopes[scopeAt].arguments)
    if position < supplied.length { return Option<Argument>.some(Argument.copy(&supplied[position])) }
    position = position - supplied.length
    scopeAt = scopeAt + usize.ONE
  }
  return Option<Argument>.none()
}

fn argumentKind(value: &Argument) -> usize {
  return match &value.* {
    Argument.Type {..} => usize.ZERO
    Argument.Lifetime {..} => usize.ONE
    Argument.Row {..} => 2
  }
}

fn argumentHash(value: &Argument) -> u64 {
  return match &value.* {
    Argument.Type {value: ty} => Type.hash(&ty)
    _ => usize.toU64(argumentKind(value))
  }
}

fn sameArgumentKinds(left: &[Argument], right: &[Argument]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if argumentKind(&left[at]) != argumentKind(&right[at]) { return false }
    at = at + usize.ONE
  }
  return true
}

fn sameApplicationShape(left: &Application, right: &Application) -> bool {
  let target = match &left.target {
    Target.Named {declaration} => match &right.target {
      Target.Named {declaration: other} => DeclarationId.equals(&declaration, &other) _ => false }
    Target.Operation {operation, implementation, ..} => match &right.target {
      Target.Operation {operation: other, implementation: selected, ..} =>
        DeclarationId.equals(&operation, &other) && DeclarationId.equals(&implementation, &selected) _ => false }
  }
  if !target || !sameOrdinals(List<usize>.asSlice(&left.argumentOrdinals), List<usize>.asSlice(&right.argumentOrdinals))
    || !sameArgumentKinds(List<Argument>.asSlice(&left.arguments), List<Argument>.asSlice(&right.arguments)) { return false }
  let scopes = List<ScopeBinding>.asSlice(&left.scopes)
  let other = List<ScopeBinding>.asSlice(&right.scopes)
  if scopes.length != other.length { return false }
  let mut at = usize.ZERO
  while at < scopes.length {
    if !sameOwner(&scopes[at].owner, &other[at].owner)
      || !sameOrdinals(List<usize>.asSlice(&scopes[at].argumentOrdinals), List<usize>.asSlice(&other[at].argumentOrdinals))
      || !sameArgumentKinds(List<Argument>.asSlice(&scopes[at].arguments), List<Argument>.asSlice(&other[at].arguments))
      || !sameStaticOrdinals(List<StaticSlot>.asSlice(&scopes[at].statics), List<StaticSlot>.asSlice(&other[at].statics)) { return false }
    at = at + usize.ONE
  }
  return sameStaticOrdinals(List<StaticSlot>.asSlice(&left.statics), List<StaticSlot>.asSlice(&right.statics))
}

fn sameStaticOrdinals(statics: &[StaticSlot], values: &[StaticSlot]) -> bool {
  if statics.length != values.length { return false }
  let mut at = usize.ZERO
  while at < statics.length {
    if statics[at].ordinal != values[at].ordinal { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn sameApplicationStatics(left: &Application, right: &Application) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  return run sameStaticSlots(List<StaticSlot>.asSlice(&left.statics), List<StaticSlot>.asSlice(&right.statics))
}

effect fn sameStaticSlots(first: &[StaticSlot], second: &[StaticSlot]) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  if first.length != second.length { return false }
  let mut at = usize.ZERO
  while at < first.length {
    if first[at].ordinal != second[at].ordinal || !run StaticValue.equals(&first[at].value, &second[at].value) { return false }
    at = at + usize.ONE
  }
  return true
}

// Exact static payloads, as Application.encodeInto writes them. Matching permanent handles
// need no traversal, and the common application with no statics encodes nothing.
effect fn sameStaticEncodings(first: &[StaticSlot], second: &[StaticSlot], owner: &DeclarationId) -> bool
! OutOfMemoryError ? &mut Allocator {
  if first.length != second.length { return false }
  let mut at = usize.ZERO
  while at < first.length {
    if first[at].ordinal != second[at].ordinal { return false }
    if !Interned<StaticData>.same(&first[at].value, &second[at].value) {
      let mut leftCoordinates = RuntimeEncoding.coordinates()
      let mut rightCoordinates = RuntimeEncoding.coordinates()
      let left = run StaticValue.encoding(&first[at].value, owner, true, &mut leftCoordinates)
      let right = run StaticValue.encoding(&second[at].value, owner, true, &mut rightCoordinates)
      if !RuntimeEncoding.equals(Bytes.asSlice(&left), Bytes.asSlice(&right)) { return false }
    }
    at = at + usize.ONE
  }
  return true
}

effect fn sameApplication(left: &Application, right: &Application, runtime: bool) -> bool
! OutOfMemoryError
? &mut Allocator | &mut Types {
  if runtime {
    let first = run Application.runtime(left)
    let second = run Application.runtime(right)
    return RuntimeEncoding.equals(Bytes.asSlice(&first), Bytes.asSlice(&second))
  }
  if !run sameTarget(&left.target, &right.target, runtime) {
    return false
  }
  if !sameOrdinals(List<usize>.asSlice(&left.argumentOrdinals), List<usize>.asSlice(&right.argumentOrdinals)) { return false }
  if !run sameApplicationStatics(left, right) { return false }
  let scopes = List<ScopeBinding>.asSlice(&left.scopes)
  let compared = List<ScopeBinding>.asSlice(&right.scopes)
  if scopes.length != compared.length { return false }
  let mut scopeAt = usize.ZERO
  while scopeAt < scopes.length {
    if !sameOwner(&scopes[scopeAt].owner, &compared[scopeAt].owner) || !sameOrdinals(
      List<usize>.asSlice(&scopes[scopeAt].argumentOrdinals), List<usize>.asSlice(&compared[scopeAt].argumentOrdinals)) { return false }
    if !run sameStaticSlots(List<StaticSlot>.asSlice(&scopes[scopeAt].statics), List<StaticSlot>.asSlice(&compared[scopeAt].statics)) { return false }
    let given = List<Argument>.asSlice(&scopes[scopeAt].arguments)
    let other = List<Argument>.asSlice(&compared[scopeAt].arguments)
    if given.length != other.length { return false }
    let mut index = usize.ZERO
    while index < given.length {
      if !run sameArgument(&given[index], &other[index], runtime) { return false }
      index = index + usize.ONE
    }
    scopeAt = scopeAt + usize.ONE
  }
  let first = List<Argument>.asSlice(&left.arguments)
  let second = List<Argument>.asSlice(&right.arguments)
  if first.length != second.length {
    return false
  }
  let mut at = usize.ZERO
  while at < first.length {
    if !run sameArgument(&first[at], &second[at], runtime) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

struct OperationInputs {
  contract: Interned<Type>,
  provider: Interned<Type>,
}

struct ScopeInputs {
  owner: Interned<DeclarationId>,
  count: usize,
}

fn failedNumberingApplication(numbering: &Numbering) -> Result<Application, CanonicalizationFailure> {
  let reason = match move Numbering.failure(numbering) {
    Option<CanonicalizationFailure>.Some {value} => value
    _ => CanonicalizationFailure.UncollectedAtom
  }
  return Result<Application, CanonicalizationFailure>.failResult(reason)
}

impl Application {
  /// Copies the original body declaration; the copy shares the declaration's record.
  pub fn copyBodyDeclaration(source: &Interned<Application>) -> DeclarationId {
    let copied = copyApplicationDeclaration(source, false)
    return match move copied {
      Option<DeclarationId>.Some {value} => move value
      _ => absurd<DeclarationId>()
    }
  }
  /// Copies the complete application using scalar/shared reads under short borrows.
  pub effect fn copyShared(source: &Interned<Application>) -> Application ! OutOfMemoryError ? &mut Allocator {
    let copiedDeclaration = copyApplicationDeclaration(source, false)
    let copiedBody = match move copiedDeclaration {
      Option<DeclarationId>.Some {value} => move value
      _ => { return absurd<Application>() }
    }
    let selectedOperation = copyApplicationDeclaration(source, true)
    let mut target = Target.Named {declaration: move copiedBody}
    if let Option<DeclarationId>.Some {value: operation} = move selectedOperation {
      let inputs = Interned<Application>.with<Option<OperationInputs>>(source, fn(value: &Application) -> Option<OperationInputs> {
        return match &value.target {
          Target.Operation {contract, provider, ..} => Option<OperationInputs>.some(OperationInputs {contract: Interned<Type>.clone(&contract), provider: Interned<Type>.clone(&provider)})
          _ => Option<OperationInputs>.none()
        }
      })
      let bodyOwner = match move target { Target.Named {declaration} => move declaration _ => { return absurd<Application>() } }
      let found = match move inputs { Option<OperationInputs>.Some {value} => move value _ => { return absurd<Application>() } }
      target = Target.Operation {contract: move found.contract, provider: move found.provider, operation: move operation, implementation: move bodyOwner}
    }
    let count = Interned<Application>.with<usize>(source, fn(value: &Application) -> usize { return List<Argument>.length(&value.arguments) })
    let mut arguments = run List<Argument>.makeWithCapacity(count)
    let mut ordinals = run List<usize>.makeWithCapacity(count)
    let mut at = usize.ZERO
    while at < count {
      let value = Interned<Application>.with<Argument>(source, fn(value: &Application) -> Argument { let given = List<Argument>.asSlice(&value.arguments)
        return Argument.copy(&given[at]) })
      let ordinal = Interned<Application>.with<usize>(source, fn(value: &Application) -> usize { return List<usize>.asSlice(&value.argumentOrdinals)[at] })
      run List<Argument>.append(&mut arguments, move value)
      run List<usize>.append(&mut ordinals, ordinal)
      at = at + usize.ONE
    }
    let scopeCount = Interned<Application>.with<usize>(source, fn(value: &Application) -> usize { return List<ScopeBinding>.length(&value.scopes) })
    let mut scopes = run List<ScopeBinding>.makeWithCapacity(scopeCount)
    at = usize.ZERO
    while at < scopeCount {
      let info = Interned<Application>.with<ScopeInputs>(source, fn(value: &Application) -> ScopeInputs {
        let listed = List<ScopeBinding>.asSlice(&value.scopes)
        let scope = &listed[at]
        return ScopeInputs {owner: Interned<DeclarationId>.clone(&scope.owner), count: List<Argument>.length(&scope.arguments)}
      })
      let mut values = run List<Argument>.makeWithCapacity(info.count)
      let mut slots = run List<usize>.makeWithCapacity(info.count)
      let mut index = usize.ZERO
      while index < info.count {
        let value = Interned<Application>.with<Argument>(source, fn(value: &Application) -> Argument {
          let listed = List<ScopeBinding>.asSlice(&value.scopes)
          let scope = &listed[at]
          let given = List<Argument>.asSlice(&scope.arguments)
          return Argument.copy(&given[index])
        })
        let ordinal = Interned<Application>.with<usize>(source, fn(value: &Application) -> usize {
          let listed = List<ScopeBinding>.asSlice(&value.scopes)
          let scope = &listed[at]
          return List<usize>.asSlice(&scope.argumentOrdinals)[index]
        })
        run List<Argument>.append(&mut values, move value)
        run List<usize>.append(&mut slots, ordinal)
        index = index + usize.ONE
      }
      let scopeStaticCount = Interned<Application>.with<usize>(source, fn(value: &Application) -> usize {
        let listed = List<ScopeBinding>.asSlice(&value.scopes)
        return List<StaticSlot>.length(&listed[at].statics)
      })
      let mut scopeStatics = run List<StaticSlot>.makeWithCapacity(scopeStaticCount)
      index = usize.ZERO
      while index < scopeStaticCount {
        let slot = Interned<Application>.with<StaticSlot>(source, fn(value: &Application) -> StaticSlot {
          let listed = List<ScopeBinding>.asSlice(&value.scopes)
          let held = List<StaticSlot>.asSlice(&listed[at].statics)
          return StaticSlot {ordinal: held[index].ordinal, value: StaticValue.copy(&held[index].value)}
        })
        run List<StaticSlot>.append(&mut scopeStatics, move slot)
        index = index + usize.ONE
      }
      run List<ScopeBinding>.append(&mut scopes, ScopeBinding {owner: move info.owner, arguments: move values, argumentOrdinals: move slots,
        statics: move scopeStatics})
      at = at + usize.ONE
    }
    let staticCount = Interned<Application>.with<usize>(source, fn(value: &Application) -> usize { return List<StaticSlot>.length(&value.statics) })
    let mut statics = run List<StaticSlot>.makeWithCapacity(staticCount)
    at = usize.ZERO
    while at < staticCount {
      let slot = Interned<Application>.with<StaticSlot>(source, fn(value: &Application) -> StaticSlot {
        let listed = List<StaticSlot>.asSlice(&value.statics)
        return StaticSlot {ordinal: listed[at].ordinal, value: StaticValue.copy(&listed[at].value)}
      })
      run List<StaticSlot>.append(&mut statics, move slot)
      at = at + usize.ONE
    }
    return Application {target: move target, arguments: move arguments, argumentOrdinals: move ordinals, scopes: move scopes, statics: move statics}
  }
  /// Counts free own and enclosing arguments in semantic traversal order, including phantom inputs.
  pub fn argumentCount(self: &Self) -> usize { return applicationArgumentCount(self) }
  /// Whether the application or any enclosing scope supplies a static value.
  pub fn hasStatics(self: &Self) -> bool {
    if List<StaticSlot>.length(&self.statics) != usize.ZERO { return true }
    let scopes = List<ScopeBinding>.asSlice(&self.scopes)
    let mut at = usize.ZERO
    while at < scopes.length {
      if List<StaticSlot>.length(&scopes[at].statics) != usize.ZERO { return true }
      at = at + usize.ONE
    }
    return false
  }
  /// Reads one free own or enclosing argument without borrowing the application.
  pub fn argumentAt(self: &Self, at: usize) -> Option<Argument> { return applicationArgumentAt(self, at) }
  /// Compares declaration, slot and argument-kind structure before binder-aware evidence comparison.
  pub fn sameShape(left: &Self, right: &Self) -> bool { return sameApplicationShape(left, right) }
  /// Compares selected static payloads after application/type borrows have been released.
  pub effect fn staticEquals(left: &Self, right: &Self) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
    return run sameApplicationStatics(left, right)
  }
  /// Number of semantic type positions: argument slots followed by operation contract/provider.
  pub fn typeCount(self: &Self) -> usize {
    let count = applicationArgumentCount(self)
    return match &self.target { Target.Operation {..} => count + 2 _ => count }
  }
  /// Type evidence at one semantic position; lifetime and row argument positions have no type.
  pub fn typeAt(self: &Self, at: usize) -> Option<Interned<Type>> {
    let count = applicationArgumentCount(self)
    if at < count {
      let selected = applicationArgumentAt(self, at)
      if let Option<Argument>.Some {value: Argument.Type {value}} = move selected {
        return Option<Interned<Type>>.some(move value)
      }
      return Option<Interned<Type>>.none()
    }
    if let Target.Operation {contract, provider, ..} = &self.target {
      if at == count { return Option<Interned<Type>>.some(Interned<Type>.clone(&contract)) }
      if at == count + usize.ONE { return Option<Interned<Type>>.some(Interned<Type>.clone(&provider)) }
    }
    return Option<Interned<Type>>.none()
  }
  /// Copies one selected application without changing its semantic arguments.
  pub effect fn copy(self: &Self) -> Application ! OutOfMemoryError ? &mut Allocator {
    return run copyApplication(self)
  }
  /// One exact canonical projection shared by backend equality, interning, symbols and admission.
  /// All validity lifetimes are erased; union and requirement-row members have canonical order.
  pub effect fn runtime(self: &Self) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    let mut coordinates = RuntimeEncoding.coordinates()
    return run Application.encoding(self, false, &mut coordinates)
  }
  pub effect fn encoding(self: &Self, exact: bool, coordinates: &mut Coordinates) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
    if coordinates.exceeded { return Bytes.make() }
    let mut output = Bytes.make()
    // Encodings are rarely shorter than this; growing from empty would reallocate repeatedly.
    run Bytes.reserveExact(&mut output, 128)
    run Application.encodeInto(self, &mut output, exact, &mut coordinates.*)
    return move output
  }
  /// Appends what [`Application.encoding`] returns to `output`.
  pub effect fn encodeInto(self: &Self, output: &mut Bytes, exact: bool, coordinates: &mut Coordinates) -> ()
  ! OutOfMemoryError
  ? &mut Allocator {
    if coordinates.exceeded { return () }
    let begin = Bytes.length(&output.*)
    let owner = Application.bodyDeclaration(self)
    match & self.target {
      Target.Named {declaration} => {
        run RuntimeEncoding.recordWord(&mut output.*, 0, &mut coordinates.*)
        run RuntimeEncoding.recordDeclaration(&mut output.*, &declaration, &mut coordinates.*)
      }
      Target.Operation {contract, provider, operation, implementation} => {
        run RuntimeEncoding.recordWord(&mut output.*, 1, &mut coordinates.*)
        run RuntimeEncoding.recordDeclaration(&mut output.*, &operation, &mut coordinates.*)
        run RuntimeEncoding.recordDeclaration(&mut output.*, &implementation, &mut coordinates.*)
        let contractBytes = run Type.encoding(&contract, owner, exact, &mut coordinates.*)
        let providerBytes = run Type.encoding(&provider, owner, exact, &mut coordinates.*)
        run RuntimeEncoding.recordField(&mut output.*, Bytes.asSlice(&contractBytes), &mut coordinates.*)
        run RuntimeEncoding.recordField(&mut output.*, Bytes.asSlice(&providerBytes), &mut coordinates.*)
      }
    }
    let listed = List<Argument>.asSlice(&self.arguments)
    let ordinals = List<usize>.asSlice(&self.argumentOrdinals)
    run RuntimeEncoding.recordWord(&mut output.*, usize.toU64(listed.length), &mut coordinates.*)
    let mut at = usize.ZERO
    while at < listed.length {
      run RuntimeEncoding.recordWord(&mut output.*, usize.toU64(ordinals[at]), &mut coordinates.*)
      let start = run RuntimeEncoding.openField(&mut output.*)
      run Argument.encodeInto(&mut output.*, &listed[at], owner, exact, &mut coordinates.*)
      RuntimeEncoding.closeField(&mut output.*, start, &mut coordinates.*)
      at = at + usize.ONE
    }
    let scopes = List<ScopeBinding>.asSlice(&self.scopes)
    run RuntimeEncoding.recordWord(&mut output.*, usize.toU64(scopes.length), &mut coordinates.*)
    at = usize.ZERO
    while at < scopes.length {
      let affordable = Interned<DeclarationId>.with<bool>(&scopes[at].owner,
        fn(identity: &DeclarationId) -> bool { return RuntimeEncoding.recordPayload(&mut coordinates.*, RuntimeEncoding.declarationPayload(identity)) })
      if !affordable { Bytes.truncate(&mut output.*, begin)
        return () }
      let scopeOwner = DeclarationId.copyShared(&scopes[at].owner)
      run RuntimeEncoding.recordDeclaration(&mut output.*, &scopeOwner, &mut coordinates.*)
      let values = List<Argument>.asSlice(&scopes[at].arguments)
      let slots = List<usize>.asSlice(&scopes[at].argumentOrdinals)
      run RuntimeEncoding.recordWord(&mut output.*, usize.toU64(values.length), &mut coordinates.*)
      let mut index = usize.ZERO
      while index < values.length {
        run RuntimeEncoding.recordWord(&mut output.*, usize.toU64(slots[index]), &mut coordinates.*)
        let start = run RuntimeEncoding.openField(&mut output.*)
        run Argument.encodeInto(&mut output.*, &values[index], &scopeOwner, exact, &mut coordinates.*)
        RuntimeEncoding.closeField(&mut output.*, start, &mut coordinates.*)
        index = index + usize.ONE
      }
      let scopeStatics = List<StaticSlot>.asSlice(&scopes[at].statics)
      run RuntimeEncoding.recordWord(&mut output.*, usize.toU64(scopeStatics.length), &mut coordinates.*)
      index = usize.ZERO
      while index < scopeStatics.length {
        run RuntimeEncoding.recordWord(&mut output.*, usize.toU64(scopeStatics[index].ordinal), &mut coordinates.*)
        let encoding = run StaticValue.encoding(&scopeStatics[index].value, owner, exact, &mut coordinates.*)
        run RuntimeEncoding.recordField(&mut output.*, Bytes.asSlice(&encoding), &mut coordinates.*)
        index = index + usize.ONE
      }
      at = at + usize.ONE
    }
    // Static values have no runtime lane, so every one is part of the runtime instance identity.
    let statics = List<StaticSlot>.asSlice(&self.statics)
    run RuntimeEncoding.recordWord(&mut output.*, usize.toU64(statics.length), &mut coordinates.*)
    at = usize.ZERO
    while at < statics.length {
      run RuntimeEncoding.recordWord(&mut output.*, usize.toU64(statics[at].ordinal), &mut coordinates.*)
      let encoding = run StaticValue.encoding(&statics[at].value, owner, exact, &mut coordinates.*)
      run RuntimeEncoding.recordField(&mut output.*, Bytes.asSlice(&encoding), &mut coordinates.*)
      at = at + usize.ONE
    }
    return ()
  }
  /// Replaces arguments written in a caller's abstract binders with that caller's instance inputs.
  pub effect fn substitute(self: &Self, caller: &Application) -> Application
  ! OutOfMemoryError ? &mut Allocator | &mut Types {
    let bindings = run Application.bindings(caller)
    return run Application.applyBindings(self, List<Binding>.asSlice(&bindings))
  }
  /// Gives the scope for enclosing `owner` the owner's static `values`, adding that scope when the
  /// application holds none for it.
  pub effect fn closeStatics(self: &mut Self, owner: &Interned<DeclarationId>, values: &[StaticSlot]) -> ()
  ! OutOfMemoryError ? &mut Allocator {
    return run closeStatics(&mut self.*, owner, values)
  }
  /// Applies recorded owner-qualified evidence simultaneously to own and enclosing inputs.
  pub effect fn applyBindings(self: &Self, given: &[Binding]) -> Application
  ! OutOfMemoryError ? &mut Allocator | &mut Types {
    let target = match &self.target {
      Target.Operation {contract, provider, operation, implementation} => Target.Operation {
        contract: run Type.applyBindings(&contract, given, true),
        provider: run Type.applyBindings(&provider, given, true),
        operation: DeclarationId.copy(&operation), implementation: DeclarationId.copy(&implementation),
      }
      Target.Named {declaration} => Target.Named {declaration: DeclarationId.copy(&declaration)}
    }
    let mut arguments = List<Argument>.make()
    let own = List<Argument>.asSlice(&self.arguments)
    let mut at = usize.ZERO
    while at < own.length {
      run List<Argument>.append(&mut arguments, run Argument.applyBindings(&own[at], given, true))
      at = at + usize.ONE
    }
    let mut scopes = List<ScopeBinding>.make()
    let enclosing = List<ScopeBinding>.asSlice(&self.scopes)
    at = usize.ZERO
    while at < enclosing.length {
      let mut values = List<Argument>.make()
      let previous = List<Argument>.asSlice(&enclosing[at].arguments)
      let mut index = usize.ZERO
      while index < previous.length {
        run List<Argument>.append(&mut values, run Argument.applyBindings(&previous[index], given, true))
        index = index + usize.ONE
      }
      run List<ScopeBinding>.append(&mut scopes, ScopeBinding {owner: Interned<DeclarationId>.clone(&enclosing[at].owner), arguments: move values,
        argumentOrdinals: run copyOrdinals(List<usize>.asSlice(&enclosing[at].argumentOrdinals)),
        statics: run copyStatics(List<StaticSlot>.asSlice(&enclosing[at].statics))})
      at = at + usize.ONE
    }
    return Application {target: move target, arguments: move arguments,
      argumentOrdinals: run copyOrdinals(List<usize>.asSlice(&self.argumentOrdinals)), scopes: move scopes,
      statics: run copyStatics(List<StaticSlot>.asSlice(&self.statics))}
  }
  /// Charges copied declaration payloads before exact-record encoders snapshot an application.
  pub fn copiedPayloadFits(self: &Self, coordinates: &mut Coordinates) -> bool {
    if !RuntimeEncoding.recordPayload(&mut coordinates.*, RuntimeEncoding.declarationPayload(body(self))) { return false }
    if let Target.Operation {operation, ..} = &self.target {
      return RuntimeEncoding.recordPayload(&mut coordinates.*, RuntimeEncoding.declarationPayload(&operation))
    }
    return true
  }
  /// Charges local metadata before copying it; graph children have their own node/edge costs.
  pub fn numberingCost(self: &Self, numbering: &mut Numbering) -> bool {
    if !Numbering.units(&mut numbering.*, List<Argument>.length(&self.arguments)) { return false }
    if !Numbering.units(&mut numbering.*, List<usize>.length(&self.argumentOrdinals)) { return false }
    if !Numbering.units(&mut numbering.*, List<ScopeBinding>.length(&self.scopes)) { return false }
    if !Numbering.units(&mut numbering.*, List<StaticSlot>.length(&self.statics)) { return false }
    if !numberingDeclaration(body(self), &mut numbering.*) { return false }
    if let Target.Operation {operation, ..} = &self.target {
      if !numberingDeclaration(&operation, &mut numbering.*) { return false }
    }
    let scopes = List<ScopeBinding>.asSlice(&self.scopes)
    let mut at = usize.ZERO
    while at < scopes.length {
      if !Numbering.units(&mut numbering.*, List<Argument>.length(&scopes[at].arguments)) { return false }
      if !Numbering.units(&mut numbering.*, List<usize>.length(&scopes[at].argumentOrdinals)) { return false }
      if !Numbering.units(&mut numbering.*, List<StaticSlot>.length(&scopes[at].statics)) { return false }
      let affordable = Interned<DeclarationId>.with<bool>(&scopes[at].owner,
        fn(identity: &DeclarationId) -> bool { return numberingDeclaration(identity, &mut numbering.*) })
      if !affordable { return false }
      at = at + usize.ONE
    }
    return true
  }
  /// Renames every actual input through the complete frozen domain: operation evidence, own
  /// arguments, enclosing scopes in lexical order, then static aggregate type evidence.
  pub effect fn numberRegions(self: &Self, numbering: &mut Numbering) -> Result<Application, CanonicalizationFailure>
  ! OutOfMemoryError ? &mut Allocator | &mut Types {
    if !Numbering.units(&mut numbering.*, 2) || !Application.numberingCost(self, &mut numbering.*) {
      return failedNumberingApplication(&numbering.*)
    }
    let owner = body(self)
    let mut target = Target.Named {declaration: DeclarationId.copy(owner)}
    if let Target.Operation {contract, provider, operation, implementation} = &self.target {
      let numberedContract = run Type.numberRegions(&contract, owner, &mut numbering.*)
      let numberedProvider = run Type.numberRegions(&provider, owner, &mut numbering.*)
      target = Target.Operation {contract: move numberedContract, provider: move numberedProvider,
        operation: DeclarationId.copy(&operation), implementation: DeclarationId.copy(&implementation)}
    }
    let mut arguments = List<Argument>.make()
    let own = List<Argument>.asSlice(&self.arguments)
    let mut at = usize.ZERO
    while at < own.length {
      run List<Argument>.append(&mut arguments, run Argument.numberRegions(&own[at], owner, &mut numbering.*))
      let numberingFailure1 = Numbering.failure(&numbering.*)
      if let Option<CanonicalizationFailure>.Some {value: reason} = move numberingFailure1 {
        return Result<Application, CanonicalizationFailure>.failResult(reason)
      }
      at = at + usize.ONE
    }
    let mut scopes = List<ScopeBinding>.make()
    let enclosing = List<ScopeBinding>.asSlice(&self.scopes)
    at = usize.ZERO
    while at < enclosing.length {
      if !Numbering.units(&mut numbering.*, 2) {
      return failedNumberingApplication(&numbering.*)
    }
      let mut values = List<Argument>.make()
      let previous = List<Argument>.asSlice(&enclosing[at].arguments)
      let mut index = usize.ZERO
      while index < previous.length {
        run List<Argument>.append(&mut values, run Argument.numberRegions(&previous[index], owner, &mut numbering.*))
        let numberingFailure2 = Numbering.failure(&numbering.*)
        if let Option<CanonicalizationFailure>.Some {value: reason} = move numberingFailure2 {
          return Result<Application, CanonicalizationFailure>.failResult(reason)
        }
        index = index + usize.ONE
      }
      let mut scopeStatics = List<StaticSlot>.make()
      let held = List<StaticSlot>.asSlice(&enclosing[at].statics)
      index = usize.ZERO
      while index < held.length {
        let numbered = run StaticValue.numberRegions(&held[index].value, owner, &mut numbering.*)
        run List<StaticSlot>.append(&mut scopeStatics, StaticSlot {ordinal: held[index].ordinal, value: move numbered})
        index = index + usize.ONE
      }
      run List<ScopeBinding>.append(&mut scopes, ScopeBinding {owner: Interned<DeclarationId>.clone(&enclosing[at].owner), arguments: move values,
        argumentOrdinals: run copyOrdinals(List<usize>.asSlice(&enclosing[at].argumentOrdinals)), statics: move scopeStatics})
      let numberingFailure3 = Numbering.failure(&numbering.*)
      if let Option<CanonicalizationFailure>.Some {value: reason} = move numberingFailure3 {
        return Result<Application, CanonicalizationFailure>.failResult(reason)
      }
      at = at + usize.ONE
    }
    let numberingFailure4 = Numbering.failure(&numbering.*)
    if let Option<CanonicalizationFailure>.Some {value: reason} = move numberingFailure4 {
      return Result<Application, CanonicalizationFailure>.failResult(reason)
    }
    let mut statics = List<StaticSlot>.make()
    let previousStatics = List<StaticSlot>.asSlice(&self.statics)
    at = usize.ZERO
    while at < previousStatics.length {
      let numbered = run StaticValue.numberRegions(&previousStatics[at].value, owner, &mut numbering.*)
      let numberingFailure5 = Numbering.failure(&numbering.*)
      if let Option<CanonicalizationFailure>.Some {value: reason} = move numberingFailure5 {
        return Result<Application, CanonicalizationFailure>.failResult(reason)
      }
      run List<StaticSlot>.append(&mut statics, StaticSlot {ordinal: previousStatics[at].ordinal, value: move numbered})
      at = at + usize.ONE
    }
    return Result<Application, CanonicalizationFailure>.succeed(Application {target: move target, arguments: move arguments,
      argumentOrdinals: run copyOrdinals(List<usize>.asSlice(&self.argumentOrdinals)), scopes: move scopes,
      statics: move statics})
  }
  /// The exact simultaneous binding environment for signature, body and layout substitution.
  pub effect fn bindings(self: &Self) -> List<Binding> ! OutOfMemoryError ? &mut Allocator | &mut Types {
    let mut output = List<Binding>.make()
    let owner = run Types.internDeclaration(DeclarationId.copy(body(self)))
    let values = List<Argument>.asSlice(&self.arguments)
    let ordinals = List<usize>.asSlice(&self.argumentOrdinals)
    let mut at = usize.ZERO
    while at < values.length {
      run List<Binding>.append(&mut output, Binding {declaration: Interned<DeclarationId>.clone(&owner),
        ordinal: ordinals[at], value: Argument.copy(&values[at])})
      at = at + usize.ONE
    }
    let scopes = List<ScopeBinding>.asSlice(&self.scopes)
    at = usize.ZERO
    while at < scopes.length {
      let given = List<Argument>.asSlice(&scopes[at].arguments)
      let slots = List<usize>.asSlice(&scopes[at].argumentOrdinals)
      let mut index = usize.ZERO
      while index < given.length {
        run List<Binding>.append(&mut output, Binding {declaration: Interned<DeclarationId>.clone(&scopes[at].owner),
          ordinal: slots[index], value: Argument.copy(&given[index])})
        index = index + usize.ONE
      }
      at = at + usize.ONE
    }
    return move output
  }
  /// Original dense ordinals for declarations whose own binder list has no restated owner slots.
  pub effect fn denseOrdinals(count: usize) -> List<usize> ! OutOfMemoryError ? &mut Allocator {
    let mut output = List<usize>.make()
    let mut at = usize.ZERO
    while at < count {
      run List<usize>.append(&mut output, at)
      at = at + usize.ONE
    }
    return move output
  }
  /// A hash for interning: [`Application.hash`] mixed with the allocation of every own and scope
  /// argument and operation target type, which are interned.
  pub fn internHash(self: &Self) -> u64 {
    let mut hashed = Application.hash(self)
    if let Target.Operation {contract, provider, ..} = &self.target {
      hashed = Hash.combine(hashed, usize.toU64(Interned<Type>.address(&contract)))
      hashed = Hash.combine(hashed, usize.toU64(Interned<Type>.address(&provider)))
    }
    hashed = mixArgumentAddresses(hashed, List<Argument>.asSlice(&self.arguments))
    let scopes = List<ScopeBinding>.asSlice(&self.scopes)
    let mut at = usize.ZERO
    while at < scopes.length {
      hashed = Hash.combine(hashed, usize.toU64(Interned<DeclarationId>.address(&scopes[at].owner)))
      hashed = mixArgumentAddresses(hashed, List<Argument>.asSlice(&scopes[at].arguments))
      at = at + usize.ONE
    }
    return hashed
  }
  /// Whether every own and scope argument and operation target type of both is the same
  /// allocation, the cheap half of an interning comparison.
  pub fn sameArgumentHandles(left: &Self, right: &Self) -> bool {
    if let Target.Operation {contract, provider, ..} = &left.target {
      if let Target.Operation {contract: compared, provider: served, ..} = &right.target {
        if !Interned<Type>.same(&contract, &compared) || !Interned<Type>.same(&provider, &served) { return false }
      } else { return false }
    }
    if !sameArgumentAddresses(List<Argument>.asSlice(&left.arguments), List<Argument>.asSlice(&right.arguments)) { return false }
    let scopes = List<ScopeBinding>.asSlice(&left.scopes)
    let others = List<ScopeBinding>.asSlice(&right.scopes)
    if scopes.length != others.length { return false }
    let mut at = usize.ZERO
    while at < scopes.length {
      if !Interned<DeclarationId>.same(&scopes[at].owner, &others[at].owner) { return false }
      if !sameArgumentAddresses(List<Argument>.asSlice(&scopes[at].arguments), List<Argument>.asSlice(&others[at].arguments)) { return false }
      at = at + usize.ONE
    }
    return true
  }
  /// Whether corresponding static values have identical exact encodings in this application's
  /// declaration context. Interning uses this in addition to semantic equality, since a static
  /// value's semantic type comparison can identify values whose exact type evidence differs.
  pub effect fn sameStaticInputs(left: &Self, right: &Self) -> bool ! OutOfMemoryError ? &mut Allocator {
    let owner = Application.bodyDeclaration(left)
    if !run sameStaticEncodings(List<StaticSlot>.asSlice(&left.statics), List<StaticSlot>.asSlice(&right.statics), owner) { return false }
    let scopes = List<ScopeBinding>.asSlice(&left.scopes)
    let other = List<ScopeBinding>.asSlice(&right.scopes)
    if scopes.length != other.length { return false }
    let mut at = usize.ZERO
    while at < scopes.length {
      if !run sameStaticEncodings(List<StaticSlot>.asSlice(&scopes[at].statics), List<StaticSlot>.asSlice(&other[at].statics), owner) { return false }
      at = at + usize.ONE
    }
    return true
  }
  /// Compares full source validity and selected operation evidence.
  pub effect fn equals(left: &Self, right: &Self) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
    return run sameApplication(left, right, false)
  }
  /// Returns a hash that two applications share whenever [`equals`] reports them equal.
  ///
  /// # Details
  ///
  /// The hash reads the target declarations, argument ordinals and kinds, the scope and static
  /// counts, and [`Type.hash`] of each own type argument.
  pub fn hash(self: &Self) -> u64 {
    let mut hashed = match &self.target {
      Target.Named {declaration} => Hash.combine(Hash.mix(&Hash.seed(0), 1), DeclarationId.hash(&declaration))
      Target.Operation {operation, implementation, ..} => Hash.combine(
        Hash.combine(Hash.mix(&Hash.seed(0), 2), DeclarationId.hash(&operation)),
        DeclarationId.hash(&implementation),
      )
    }
    let ordinals = List<usize>.asSlice(&self.argumentOrdinals)
    let mut at = usize.ZERO
    while at < ordinals.length {
      hashed = Hash.combine(hashed, usize.toU64(ordinals[at]))
      at = at + usize.ONE
    }
    hashed = Hash.combine(hashed, usize.toU64(List<ScopeBinding>.length(&self.scopes)))
    let statics = List<StaticSlot>.asSlice(&self.statics)
    hashed = Hash.combine(hashed, usize.toU64(statics.length))
    at = usize.ZERO
    while at < statics.length {
      hashed = Hash.combine(Hash.combine(hashed, usize.toU64(statics[at].ordinal)), StaticValue.hash(&statics[at].value))
      at = at + usize.ONE
    }
    let arguments = List<Argument>.asSlice(&self.arguments)
    hashed = Hash.combine(hashed, usize.toU64(arguments.length))
    at = usize.ZERO
    while at < arguments.length {
      hashed = Hash.combine(hashed, argumentHash(&arguments[at]))
      at = at + usize.ONE
    }
    return hashed
  }
  /// Returns a hash of the target declarations and static values alone, which every comparison
  /// of two applications reads exactly, whatever binder map relates their type arguments.
  pub fn identityHash(self: &Self) -> u64 {
    let mut hashed = match &self.target {
      Target.Named {declaration} => Hash.combine(Hash.mix(&Hash.seed(0), 1), DeclarationId.hash(&declaration))
      Target.Operation {operation, implementation, ..} => Hash.combine(
        Hash.combine(Hash.mix(&Hash.seed(0), 2), DeclarationId.hash(&operation)),
        DeclarationId.hash(&implementation),
      )
    }
    let statics = List<StaticSlot>.asSlice(&self.statics)
    hashed = Hash.combine(hashed, usize.toU64(statics.length))
    let mut at = usize.ZERO
    while at < statics.length {
      hashed = Hash.combine(Hash.combine(hashed, usize.toU64(statics[at].ordinal)), StaticValue.hash(&statics[at].value))
      at = at + usize.ONE
    }
    let scopes = List<ScopeBinding>.asSlice(&self.scopes)
    at = usize.ZERO
    while at < scopes.length {
      let held = List<StaticSlot>.asSlice(&scopes[at].statics)
      let mut index = usize.ZERO
      while index < held.length {
        hashed = Hash.combine(Hash.combine(hashed, usize.toU64(held[index].ordinal)), StaticValue.hash(&held[index].value))
        index = index + usize.ONE
      }
      at = at + usize.ONE
    }
    return hashed
  }
  /// Compares code identities after lifetime erasure only.
  pub effect fn runtimeEquals(left: &Self, right: &Self) -> bool ! OutOfMemoryError ? &mut Allocator | &mut Types {
    return run sameApplication(left, right, true)
  }

  /// Whether all type, row, and selected-operation evidence is concrete for runtime use.
  /// Lifetime validity remains the responsibility of source typing and conformance proof.
  pub fn isRuntimeClosed(self: &Self) -> bool {
    return closed(self)
  }
  /// The concrete body requested by this application.
  pub fn bodyDeclaration(self: &Self) -> &DeclarationId {
    return body(self)
  }
}

impl Pool {
  pub fn make() -> Pool {
    return Pool {semantic: List<Application>.make(), runtime: List<Application>.make(), runtimeEncodings: List<Bytes>.make()}
  }
  /// Returns no identity when source selection has left a type or row abstract.
  pub effect fn intern(self: &mut Self, application: &Application) -> Option<Identity>
  ! OutOfMemoryError
  ? &mut Allocator | &mut Types {
    if !closed(application) {
      return Option<Identity>.none()
    }
    let semantic = List<Application>.asSlice(&self.semantic)
    let mut semanticAt = usize.ZERO
    while semanticAt < semantic.length {
      if run sameApplication(&semantic[semanticAt], application, false) {
        break
      }
      semanticAt = semanticAt + usize.ONE
    }
    if semanticAt == semantic.length {
      run List<Application>.append(&mut self.semantic, run copyApplication(application))
    }
    let probe = run Application.runtime(application)
    let encodings = List<Bytes>.asSlice(&self.runtimeEncodings)
    let mut runtimeAt = usize.ZERO
    while runtimeAt < encodings.length {
      if RuntimeEncoding.equals(Bytes.asSlice(&encodings[runtimeAt]), Bytes.asSlice(&probe)) {
        break
      }
      runtimeAt = runtimeAt + usize.ONE
    }
    if runtimeAt == encodings.length {
      run List<Application>.append(&mut self.runtime, run copyApplication(application))
      run List<Bytes>.append(&mut self.runtimeEncodings, move probe)
    }
    return Option<Identity>.some(Identity {semantic: semanticAt, runtime: runtimeAt})
  }
  pub fn semanticCount(self: &Self) -> usize {
    return List<Application>.length(&self.semantic)
  }
  pub fn runtimeCount(self: &Self) -> usize {
    return List<Application>.length(&self.runtime)
  }
}

impl Admission {

  pub fn make() -> Admission {
    return Admission {active: List<Step>.make()}
  }

  /// Whether [`enter`] can decide `application` at all; otherwise it answers `Decision.Open`.
  pub fn closed(application: &Application) -> bool {
    return closed(application)
  }

  /// A copy of the active request path for a nested closure transaction.
  pub effect fn copy(self: &Self) -> Admission ! OutOfMemoryError ? &mut Allocator {
    let mut active = List<Step>.make()
    let listed = List<Step>.asSlice(&self.active)
    let mut at = usize.ZERO
    while at < listed.length {
      run List<Step>.append(&mut active, Step {application: run copyApplication(&listed[at].application), edge: Edge.copy(&listed[at].edge)})
      at = at + usize.ONE
    }
    return Admission {active: move active}
  }
  /// The active applications from the outermost ancestor to the innermost.
  pub effect fn path(self: &Self) -> List<Application> ! OutOfMemoryError ? &mut Allocator {
    let mut path = List<Application>.make()
    let listed = List<Step>.asSlice(&self.active)
    let mut at = usize.ZERO
    while at < listed.length {
      run List<Application>.append(&mut path, run copyApplication(&listed[at].application))
      at = at + usize.ONE
    }
    return move path
  }

  /// Records an active request while the caller discovers its complete finite graph.
  pub effect fn enterChain(self: &mut Self, application: &Application, edge: Edge) -> () ! OutOfMemoryError ? &mut Allocator | &mut Types {
    run List<Step>.append(&mut self.active, Step {application: run copyApplication(application), edge: move edge})
    return ()
  }
  /// Checks an uncanonicalized producer application using the existing bounded structural
  /// identity collector. Complete finite graph discovery, not an ancestry shape heuristic,
  /// establishes finite specialization. The caller retains its transaction's graph-size bound.
  pub effect fn enter(self: &mut Self, application: &Application, edge: Edge) -> Decision
  ! OutOfMemoryError ? &mut Allocator | &mut Types {
    let mut numbering = Numbering.collecting()
    match move run Application.numberRegions(application, &mut numbering) {
      Result<Application, CanonicalizationFailure>.Success {value} => { drop value }
      Result<Application, CanonicalizationFailure>.Failure {error: reason} => { return Decision.NotProven {reason: reason} }
    }
    if let Option<CanonicalizationFailure>.Some {value: reason} = move Numbering.failure(&numbering) {
      return Decision.NotProven {reason: reason}
    }
    return run Admission.enterCanonical(&mut self.*, application, move edge)
  }
  /// Enters a key that already passed the bounded complete InstanceKey canonicalization.
  /// Canonicalization can also form open diagnostic keys, so runtime closedness remains required.
  /// Exact visited-definition maps close recursion; their completed graph supplies finiteness.
  pub effect fn enterCanonical(self: &mut Self, application: &Application, edge: Edge) -> Decision
  ! OutOfMemoryError ? &mut Allocator | &mut Types {
    if !closed(application) { return Decision.Open }
    run Admission.enterChain(&mut self.*, application, move edge)
    return Decision.Entered
  }

  /// Finishes one entered application after its requested children have been checked.
  pub fn leave(self: &mut Self) -> () {
    let count = List<Step>.length(&self.active)
    if count > usize.ZERO {
      List<Step>.truncate(&mut self.active, count - usize.ONE)
    }
  }
}



fn typeArgumentCount(arguments: &[Argument]) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < arguments.length {
    if let Argument.Type {..} = &arguments[at] { count = count + usize.ONE }
    at = at + usize.ONE
  }
  return count
}

impl Edge {
  /// Copies the path evidence without reading a body or resolving new conformance evidence.
  pub fn copy(self: &Self) -> Edge {
    return match & self.* {
      Edge.Direct => Edge.Direct
      Edge.Witness => Edge.Witness
      Edge.Cleanup {owner} => Edge.Cleanup {owner: Interned<Type>.clone(&owner)}
    }
  }
  /// Exact bytes of the edge's kind and the types it carries, as a build record compares them.
  /// Types are encoded within `owner`, the declaration of the instance whose MIR holds the edge.
  pub effect fn recordBytes(self: &Self, owner: &DeclarationId) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    let mut output = Bytes.make()
    match & self.* {
      Edge.Direct => { run RuntimeEncoding.word(&mut output, 0) }
      Edge.Witness => { run RuntimeEncoding.word(&mut output, 1) }
      Edge.Cleanup {owner: dropped} => {
        run RuntimeEncoding.word(&mut output, 3)
        let mut coordinates = RuntimeEncoding.coordinates()
        let encoded = run Type.encoding(&dropped, owner, true, &mut coordinates)
        run RuntimeEncoding.field(&mut output, Bytes.asSlice(&encoded))
      }
    }
    return move output
  }
}

// The declaration an application copy reads: its body, or its selected operation.
fn selectedDeclaration<'a>(value: &'a Application, operation: bool) -> Option<&'a DeclarationId> {
  if !operation { return Option<&DeclarationId>.some(body(value)) }
  return match &value.target {
    Target.Operation {operation: selected, ..} => Option<&DeclarationId>.some(&selected)
    Target.Named {..} => Option<&DeclarationId>.none()
  }
}

fn applicationDeclaration(value: &Application, operation: bool) -> Option<DeclarationId> {
  return match move selectedDeclaration(value, operation) {
    Option<&DeclarationId>.Some {value: selected} => Option<DeclarationId>.some(DeclarationId.copy(selected))
    Option<&DeclarationId>.None => Option<DeclarationId>.none()
  }
}

fn copyApplicationDeclaration(source: &Interned<Application>, operation: bool) -> Option<DeclarationId> {
  return Interned<Application>.with<Option<DeclarationId>>(source, fn(value: &Application) -> Option<DeclarationId> {
    return applicationDeclaration(value, operation)
  })
}

fn absurd<T>() -> T {
  return Intrinsic.trap("an internal invariant failed")
}

fn argumentAddress(value: &Argument) -> u64 {
  return match &value.* {
    Argument.Type {value: held} => usize.toU64(Interned<Type>.address(&held))
    Argument.Lifetime {value: held} => usize.toU64(Interned<Lifetime>.address(&held))
    Argument.Row {value: held} => usize.toU64(Interned<Row>.address(&held))
  }
}

fn mixArgumentAddresses(hashed: u64, arguments: &[Argument]) -> u64 {
  let mut mixed = Hash.combine(hashed, usize.toU64(arguments.length))
  let mut at = usize.ZERO
  while at < arguments.length {
    mixed = Hash.combine(mixed, argumentAddress(&arguments[at]))
    at = at + usize.ONE
  }
  return mixed
}

fn sameArgumentAddresses(left: &[Argument], right: &[Argument]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if argumentAddress(&left[at]) != argumentAddress(&right[at]) { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn descentExample(body: &DeclarationId, argument: &Interned<Type>) -> Application ! OutOfMemoryError ? &mut Allocator {
  let mut arguments = List<Argument>.make()
  run List<Argument>.append(&mut arguments, Argument.Type {value: Interned<Type>.clone(argument)})
  let mut ordinals = List<usize>.make()
  run List<usize>.append(&mut ordinals, 0)
  return Application {target: Target.Named {declaration: DeclarationId.copy(body)}, arguments: move arguments, argumentOrdinals: move ordinals,
    scopes: List<ScopeBinding>.make(), statics: List<StaticSlot>.make()}
}

effect fn finiteAdmissionClaims() -> () ! InvalidModulePath | OutOfMemoryError | AssertionError<'static> ? &mut Allocator | &mut Types {
  let body = run DeclarationId.fromParts(run ModuleId.make(b"memory", b"finite", b"walk.silk"), List<OwnerStep>.make())
  let scalar = run Types.intern(Type.Primitive {name: run Bytes.copy(b"i32")})
  let scalarCall = run descentExample(&body, &scalar)
  let mut arguments = List<Argument>.make()
  run List<Argument>.append(&mut arguments, Argument.Type {value: Interned<Type>.clone(&scalar)})
  let nested = run Types.intern(Type.Nominal {declaration: DeclarationId.copy(&body), isPublic: true, arguments: move arguments})
  let nestedCall = run descentExample(&body, &nested)
  let mut admission = Admission.make()
  let initial = run Admission.enter(&mut admission, &scalarCall, Edge.Direct)
  let grown = run Admission.enterCanonical(&mut admission, &nestedCall, Edge.Direct)
  let repeated = run Admission.enterCanonical(&mut admission, &scalarCall, Edge.Direct)
  run Testing.expect(match move initial { Decision.Entered => true _ => false }, "a complete bounded raw application may enter graph discovery")
  run Testing.expect(match move grown { Decision.Entered => true _ => false }, "type growth alone cannot reject a possibly finite specialization graph")
  run Testing.expect(match move repeated { Decision.Entered => true _ => false }, "the exact visited-definition map closes recursive components after admission")
  let parameter = run Types.intern(Type.Parameter {declaration: DeclarationId.copy(&body), ordinal: 0})
  let openCall = run descentExample(&body, &parameter)
  let open = run Admission.enterCanonical(&mut admission, &openCall, Edge.Direct)
  run Testing.expect(match move open { Decision.Open => true _ => false }, "finite graph discovery still refuses unresolved runtime type arguments")
  let before = run Admission.path(&admission)
  let mut large = Interned<Type>.clone(&scalar)
  let lifetime = run Types.internLifetime(Lifetime.Static)
  let mut depth = usize.ZERO
  while depth < 400 {
    let current = move large
    large = run Types.intern(Type.Reference {referent: move current, access: Access.Shared, lifetime: Interned<Lifetime>.clone(&lifetime)})
    depth = depth + usize.ONE
  }
  let oversized = run descentExample(&body, &large)
  let bounded = run Admission.enter(&mut admission, &oversized, Edge.Direct)
  run Testing.expect(match move bounded { Decision.NotProven {reason: CanonicalizationFailure.Resource} => true _ => false },
    "deep structural growth stops at the existing identity resource budget without claiming infinite specialization")
  let after = run Admission.path(&admission)
  run Testing.expect(List<Application>.length(&before) == List<Application>.length(&after), "a resource refusal publishes no active application frame")
}

test effect fn frontierFiniteAdmissionPreservesClosednessAndIdentityBounds() -> () ! InvalidModulePath | OutOfMemoryError | AssertionError<'static> {
  let mut allocator = Allocator.systemAllocatorProvider()
  let mut types = TypeTable.make()
  run finiteAdmissionClaims() |> Effect.provideMut<Types>(&mut types) |> Effect.provideMut<Allocator>(&mut allocator)
}
