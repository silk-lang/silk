//! Closed semantic applications and finite admission of requested runtime specializations.
//!
//! # When to use
//! A caller first checks a source body against its abstract contract and selects concrete
//! conformance evidence. Intern the resulting closed application here; then enter each demanded
//! call path before following it. This module does not discover executable roots or emit code.

import semantic.DeclarationId {DeclarationId, Part as DeclarationPart, Projection as DeclarationProjection, OwnerStep}
import semantic.Lifetime {Lifetime, Numbering}
import semantic.ModuleId {InvalidModulePath, ModuleId}
import semantic.RuntimeEncoding
import semantic.RuntimeEncoding {Coordinates}
import silk.bytes {Bytes}
import silk.effect {Effect}
import semantic.Query {Cycle}
import semantic.Semantic {Answer, Outcome, Request, Semantic, Value}
import semantic.SourceIndex {NoRejection, RevisionMismatch}
import semantic.StaticValue
import semantic.StaticValue {Value as StaticData}
import semantic.Type {Argument, Binding, Row, Type}
import hir.Hir {Access, OwnerKind}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.option {Option}
import silk.pointer {Pointer}
import silk.result {Result}
import silk.shared {Shared}
import silk.usize
import silk.vector {Vector}

/// A concrete function body or a selected interface operation and its exact witness.
pub union Target {
  Named {pub declaration: DeclarationId},
  Operation {
    pub contract: Shared<Type>,
    pub provider: Shared<Type>,
    pub operation: DeclarationId,
    pub implementation: DeclarationId,
  },
}

/// One application after call inference and conformance selection have completed.
/// Lifetime arguments are retained here for semantic validity and erased only in runtime equality.
/// A selected instance's application numbers its caller regions canonically ([`Numbering`]).
pub struct Application {
  pub target: Target
  pub arguments: Vector<Argument>
  /// Original declaration ordinals paired with the own arguments; never compacted or renumbered.
  pub argumentOrdinals: Vector<usize>
  /// Supplied enclosing environments in lexical owner order, excluding derived `Self`.
  /// Each supplied argument is complete. A contract-independent inherent owner slot may be
  /// absent; it must not be replaced with an arbitrary type or an open argument. Body uses of
  /// an absent slot remain open and cannot acquire a runtime layout.
  pub scopes: Vector<ScopeBinding>
  /// Complete static argument values at the target's original static parameter indices, in
  /// authored order. A static parameter has no runtime lane, so its value is part of identity.
  pub statics: Vector<StaticSlot>
}

/// One static argument value paired with its original parameter index in the target.
pub struct StaticSlot {
  pub ordinal: usize
  pub value: Shared<StaticData>
}

effect fn copyStatics(slots: &[StaticSlot]) -> Vector<StaticSlot> ! OutOfMemoryError ? &mut Allocator {
  let mut copied = Vector.make<StaticSlot>()
  let mut at = usize.ZERO
  while at < slots.length {
    run Vector.append<StaticSlot>(&mut copied, StaticSlot {ordinal: slots[at].ordinal, value: StaticValue.copy(&slots[at].value)})
    at = at + usize.ONE
  }
  return move copied
}

/// Arguments for one actual enclosing declaration, preserving original binder ownership.
pub struct ScopeBinding {
  pub owner: Shared<DeclarationId>
  pub arguments: Vector<Argument>
  pub argumentOrdinals: Vector<usize>
}

/// Positions in this pool's semantic and lifetime-erased runtime identity tables.
pub struct Identity {
  pub semantic: usize
  pub runtime: usize
}

impl Copy for Identity {}

/// Interns requested applications without discovering any other program roots.
pub struct Pool {
  semantic: Vector<Application>
  runtime: Vector<Application>
}

/// The active request path. One caller owns the path while visiting its requested callees.
pub struct Admission {
  active: Vector<Step>
}

struct Step {
  application: Application
  edge: Edge
}

/// A concrete struct field selected and resolved under its owning nominal application.
pub struct FieldDescent {
  owner: Shared<Type>
  field: Shared<Type>
}

/// Operand transport already validated by the witness header comparison.
/// This evidence belongs to the call edge, never canonical target identity.
pub union OperandPass {
  Value,
  Borrow {pub access: Access, pub lifetimeOrdinal: usize},
}

impl Copy for OperandPass {}

/// How a requested application was reached from its parent on the active path.
pub union Edge {
  Direct,
  Witness,
  FieldWitness {pub field: FieldDescent},
  /// A Drop hook selected by the cleanup of `owner`, the value a function dropped.
  Cleanup {pub owner: Shared<Type>},
}

/// A finite request, a repeated runtime identity, or the exact path that grows recursively.
pub union Decision {
  Entered,
  Reused {pub ancestor: usize},
  Open,
  Rejected {pub path: Vector<Application>},
  /// The nearest active application of the same target differs only in static values. Non-static
  /// growth was already ruled out; admission needs a finite closure certificate for this edge.
  ChangingStatic {pub ancestor: usize},
}

effect fn copyArgument(value: &Argument) -> Argument ! OutOfMemoryError ? &mut Allocator {
  return match & value.* {
    Argument.Type {value: ty} => Argument.Type {value: Shared.clone<Type>(&ty)}
    Argument.Lifetime {value: lifetime} => Argument.Lifetime {
      value: Shared.clone<Lifetime>(&lifetime),
    }
    Argument.Row {value: row} => Argument.Row {value: Shared.clone<Row>(&row)}
  }
}

effect fn copyOrdinals(values: &[usize]) -> Vector<usize> ! OutOfMemoryError ? &mut Allocator {
  let mut output = Vector.make<usize>()
  let mut at = usize.ZERO
  while at < values.length {
    run Vector.append<usize>(&mut output, values[at])
    at = at + usize.ONE
  }
  return move output
}

effect fn copyArguments(values: &[Argument]) -> Vector<Argument> ! OutOfMemoryError ? &mut Allocator {
  let mut output = Vector.make<Argument>()
  let mut at = usize.ZERO
  while at < values.length {
    run Vector.append<Argument>(&mut output, run copyArgument(&values[at]))
    at = at + usize.ONE
  }
  return move output
}

impl ScopeBinding {
  pub effect fn copy(self: &Self) -> ScopeBinding ! OutOfMemoryError ? &mut Allocator {
    return ScopeBinding {owner: Shared.clone<DeclarationId>(&self.owner),
      arguments: run copyArguments(Vector.asSlice<Argument>(&self.arguments)),
      argumentOrdinals: run copyOrdinals(Vector.asSlice<usize>(&self.argumentOrdinals))}
  }
}

fn sameOwner(left: &Shared<DeclarationId>, right: &Shared<DeclarationId>) -> bool {
  let first = Shared.with<DeclarationId, usize>(left, fn(id: &DeclarationId) -> usize {
    return Pointer.address<DeclarationId>(Pointer.fromRef<DeclarationId>(id))
  })
  let second = Shared.with<DeclarationId, usize>(right, fn(id: &DeclarationId) -> usize {
    return Pointer.address<DeclarationId>(Pointer.fromRef<DeclarationId>(id))
  })
  if first == second { return true }
  return Shared.with<DeclarationId, bool>(left, fn(id: &DeclarationId) -> bool { return sameOwnerRight(id, right) })
}

fn sameOwnerRight(left: &DeclarationId, right: &Shared<DeclarationId>) -> bool {
  return Shared.with<DeclarationId, bool>(right, fn(other: &DeclarationId) -> bool { return DeclarationId.equals(left, other) })
}

fn sameOrdinals(left: &[usize], right: &[usize]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + usize.ONE
  }
  return true
}

fn ordered(ordinals: &[usize], count: usize) -> bool {
  if ordinals.length != count { return false }
  let mut at = usize.ONE
  while at < ordinals.length {
    if ordinals[at - usize.ONE] >= ordinals[at] { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn copyApplication(value: &Application) -> Application ! OutOfMemoryError ? &mut Allocator {
  let target = match & value.target {
    Target.Named {declaration} => Target.Named {declaration: run DeclarationId.copy(&declaration)}
    Target.Operation {contract, provider, operation, implementation} => Target.Operation {
      contract: Shared.clone<Type>(&contract),
      provider: Shared.clone<Type>(&provider),
      operation: run DeclarationId.copy(&operation),
      implementation: run DeclarationId.copy(&implementation),
    }
  }
  let mut arguments = Vector.make<Argument>()
  let listed = Vector.asSlice<Argument>(&value.arguments)
  let mut at = usize.ZERO
  while at < listed.length {
    run Vector.append<Argument>(&mut arguments, run copyArgument(&listed[at]))
    at = at + usize.ONE
  }
  let mut scopes = Vector.make<ScopeBinding>()
  let enclosing = Vector.asSlice<ScopeBinding>(&value.scopes)
  at = usize.ZERO
  while at < enclosing.length {
    run Vector.append<ScopeBinding>(&mut scopes, run ScopeBinding.copy(&enclosing[at]))
    at = at + usize.ONE
  }
  return Application {target: move target, arguments: move arguments,
    argumentOrdinals: run copyOrdinals(Vector.asSlice<usize>(&value.argumentOrdinals)), scopes: move scopes,
    statics: run copyStatics(Vector.asSlice<StaticSlot>(&value.statics))}
}

fn closedArgument(value: &Argument) -> bool {
  return match & value.* {
    Argument.Type {value: ty} => !Type.hasOpenRuntimeParameters(&ty)
    Argument.Lifetime {..} => true
    Argument.Row {value: row} => !Row.hasOpenRuntimeParameters(&row)
  }
}

fn closed(value: &Application) -> bool {
  if let Target.Operation {contract, provider, ..} = &value.target {
    if Type.hasOpenRuntimeParameters(&contract) || Type.hasOpenRuntimeParameters(&provider) {
      return false
    }
  }
  let arguments = Vector.asSlice<Argument>(&value.arguments)
  if !ordered(Vector.asSlice<usize>(&value.argumentOrdinals), arguments.length) { return false }
  let statics = Vector.asSlice<StaticSlot>(&value.statics)
  let mut staticAt = usize.ONE
  while staticAt < statics.length {
    if statics[staticAt - usize.ONE].ordinal >= statics[staticAt].ordinal { return false }
    staticAt = staticAt + usize.ONE
  }
  let scopes = Vector.asSlice<ScopeBinding>(&value.scopes)
  let mut scopeAt = usize.ZERO
  while scopeAt < scopes.length {
    let owner = &scopes[scopeAt].owner
    if Shared.with<DeclarationId, bool>(owner, fn(id: &DeclarationId) -> bool {
      return DeclarationId.equals(id, body(value))
    }) { return false }
    let mut before = usize.ZERO
    while before < scopeAt {
      if sameOwner(owner, &scopes[before].owner) { return false }
      before = before + usize.ONE
    }
    let given = Vector.asSlice<Argument>(&scopes[scopeAt].arguments)
    if given.length == usize.ZERO || !ordered(Vector.asSlice<usize>(&scopes[scopeAt].argumentOrdinals), given.length) { return false }
    let mut index = usize.ZERO
    while index < given.length {
      if !closedArgument(&given[index]) { return false }
      index = index + usize.ONE
    }
    scopeAt = scopeAt + usize.ONE
  }
  let mut at = usize.ZERO
  while at < arguments.length {
    if !closedArgument(&arguments[at]) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

fn body(value: &Application) -> &DeclarationId {
  return match & value.target {
    Target.Named {declaration} => &declaration
    Target.Operation {implementation, ..} => &implementation
  }
}

effect fn sameType(left: &Shared<Type>, right: &Shared<Type>, runtime: bool) -> bool
! OutOfMemoryError
? &mut Allocator {
  if runtime {
    return run Type.runtimeEqualsShared(left, right)
  }
  return run Type.equalsShared(left, right)
}

effect fn sameArgument(left: &Argument, right: &Argument, runtime: bool) -> bool
! OutOfMemoryError
? &mut Allocator {
  return match & left.* {
    Argument.Type {value} => match & right.* {
      Argument.Type {value: compared} => run sameType(&value, &compared, runtime)
      _ => false
    }
    Argument.Lifetime {value} => match & right.* {
      Argument.Lifetime {value: compared} => runtime || Lifetime.equalsShared(&value, &compared)
      _ => false
    }
    Argument.Row {value} => match & right.* {
      Argument.Row {value: compared} => {
        if runtime {
          return run Row.runtimeEqualsShared(&value, &compared)
        }
        return run Row.equalsShared(&value, &compared)
      }
      _ => false
    }
  }
}

effect fn sameTarget(left: &Target, right: &Target, runtime: bool) -> bool
! OutOfMemoryError
? &mut Allocator {
  return match & left.* {
    Target.Named {declaration} => match & right.* {
      Target.Named {declaration: compared} => DeclarationId.equals(&declaration, &compared)
      _ => false
    }
    Target.Operation {contract, provider, operation, implementation} => match & right.* {
      Target.Operation {
        contract: otherContract,
        provider: otherProvider,
        operation: otherOperation,
        implementation: otherImplementation,
      } => {
        if !DeclarationId.equals(&operation, &otherOperation) || !DeclarationId.equals(
          &implementation,
          &otherImplementation,
        ) {
          return false
        }
        if !run sameType(&contract, &otherContract, runtime) {
          return false
        }
        return run sameType(&provider, &otherProvider, runtime)
      }
      _ => false
    }
  }
}

fn applicationArgumentCount(value: &Application) -> usize {
  let mut count = Vector.length<Argument>(&value.arguments)
  let scopes = Vector.asSlice<ScopeBinding>(&value.scopes)
  let mut at = usize.ZERO
  while at < scopes.length { count = count + Vector.length<Argument>(&scopes[at].arguments) at = at + usize.ONE }
  return count
}

fn applicationArgumentAt(value: &Application, at: usize) -> Option<Argument> {
  let own = Vector.asSlice<Argument>(&value.arguments)
  if at < own.length { return Option.some<Argument>(Argument.copy(&own[at])) }
  let mut position = at - own.length
  let scopes = Vector.asSlice<ScopeBinding>(&value.scopes)
  let mut scopeAt = usize.ZERO
  while scopeAt < scopes.length {
    let supplied = Vector.asSlice<Argument>(&scopes[scopeAt].arguments)
    if position < supplied.length { return Option.some<Argument>(Argument.copy(&supplied[position])) }
    position = position - supplied.length
    scopeAt = scopeAt + usize.ONE
  }
  return Option.none<Argument>()
}

fn argumentKind(value: &Argument) -> usize {
  return match &value.* {
    Argument.Type {..} => usize.ZERO
    Argument.Lifetime {..} => usize.ONE
    Argument.Row {..} => 2
  }
}

fn sameArgumentKinds(left: &[Argument], right: &[Argument]) -> bool {
  if left.length != right.length { return false }
  let mut at = usize.ZERO
  while at < left.length {
    if argumentKind(&left[at]) != argumentKind(&right[at]) { return false }
    at = at + usize.ONE
  }
  return true
}

fn sameApplicationShape(left: &Application, right: &Application) -> bool {
  let target = match &left.target {
    Target.Named {declaration} => match &right.target {
      Target.Named {declaration: other} => DeclarationId.equals(&declaration, &other) _ => false }
    Target.Operation {operation, implementation, ..} => match &right.target {
      Target.Operation {operation: other, implementation: selected, ..} =>
        DeclarationId.equals(&operation, &other) && DeclarationId.equals(&implementation, &selected) _ => false }
  }
  if !target || !sameOrdinals(Vector.asSlice<usize>(&left.argumentOrdinals), Vector.asSlice<usize>(&right.argumentOrdinals))
    || !sameArgumentKinds(Vector.asSlice<Argument>(&left.arguments), Vector.asSlice<Argument>(&right.arguments)) { return false }
  let scopes = Vector.asSlice<ScopeBinding>(&left.scopes)
  let other = Vector.asSlice<ScopeBinding>(&right.scopes)
  if scopes.length != other.length { return false }
  let mut at = usize.ZERO
  while at < scopes.length {
    if !sameOwner(&scopes[at].owner, &other[at].owner)
      || !sameOrdinals(Vector.asSlice<usize>(&scopes[at].argumentOrdinals), Vector.asSlice<usize>(&other[at].argumentOrdinals))
      || !sameArgumentKinds(Vector.asSlice<Argument>(&scopes[at].arguments), Vector.asSlice<Argument>(&other[at].arguments)) { return false }
    at = at + usize.ONE
  }
  let statics = Vector.asSlice<StaticSlot>(&left.statics)
  let values = Vector.asSlice<StaticSlot>(&right.statics)
  if statics.length != values.length { return false }
  at = usize.ZERO
  while at < statics.length {
    if statics[at].ordinal != values[at].ordinal { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn sameApplicationStatics(left: &Application, right: &Application) -> bool
! OutOfMemoryError ? &mut Allocator {
  let first = Vector.asSlice<StaticSlot>(&left.statics)
  let second = Vector.asSlice<StaticSlot>(&right.statics)
  if first.length != second.length { return false }
  let mut at = usize.ZERO
  while at < first.length {
    if first[at].ordinal != second[at].ordinal || !run StaticValue.equals(&first[at].value, &second[at].value) { return false }
    at = at + usize.ONE
  }
  return true
}

effect fn sameApplication(left: &Application, right: &Application, runtime: bool) -> bool
! OutOfMemoryError
? &mut Allocator {
  if runtime {
    let first = run Application.runtime(left)
    let second = run Application.runtime(right)
    return RuntimeEncoding.equals(Bytes.asSlice(&first), Bytes.asSlice(&second))
  }
  if !run sameTarget(&left.target, &right.target, runtime) {
    return false
  }
  if !sameOrdinals(Vector.asSlice<usize>(&left.argumentOrdinals), Vector.asSlice<usize>(&right.argumentOrdinals)) { return false }
  if !run sameApplicationStatics(left, right) { return false }
  let scopes = Vector.asSlice<ScopeBinding>(&left.scopes)
  let compared = Vector.asSlice<ScopeBinding>(&right.scopes)
  if scopes.length != compared.length { return false }
  let mut scopeAt = usize.ZERO
  while scopeAt < scopes.length {
    if !sameOwner(&scopes[scopeAt].owner, &compared[scopeAt].owner) || !sameOrdinals(
      Vector.asSlice<usize>(&scopes[scopeAt].argumentOrdinals), Vector.asSlice<usize>(&compared[scopeAt].argumentOrdinals)) { return false }
    let given = Vector.asSlice<Argument>(&scopes[scopeAt].arguments)
    let other = Vector.asSlice<Argument>(&compared[scopeAt].arguments)
    if given.length != other.length { return false }
    let mut index = usize.ZERO
    while index < given.length {
      if !run sameArgument(&given[index], &other[index], runtime) { return false }
      index = index + usize.ONE
    }
    scopeAt = scopeAt + usize.ONE
  }
  let first = Vector.asSlice<Argument>(&left.arguments)
  let second = Vector.asSlice<Argument>(&right.arguments)
  if first.length != second.length {
    return false
  }
  let mut at = usize.ZERO
  while at < first.length {
    if !run sameArgument(&first[at], &second[at], runtime) {
      return false
    }
    at = at + usize.ONE
  }
  return true
}

// Whether two applications of one target are runtime-equal apart from their static values.
effect fn sameExceptStatics(left: &Application, right: &Application) -> bool
! OutOfMemoryError
? &mut Allocator {
  let mut first = run copyApplication(left)
  let mut second = run copyApplication(right)
  first.statics = Vector.make<StaticSlot>()
  second.statics = Vector.make<StaticSlot>()
  return run sameApplication(&first, &second, true)
}

fn opaqueEffect(value: &Type) -> bool {
  return match & value.* {
    Type.OpaqueRepresentation {contract, ..} => Shared.with<Type, bool>(
      &contract,
      fn(typeContract: &Type) -> bool {
        return match & typeContract.* {
          Type.Effect {..} => true
          _ => false
        }
      },
    )
    _ => false
  }
}

fn selectedField(answer: &Result<Answer, NoRejection>) -> Option<Shared<Type>> {
  return match & answer.* {
    Result<Answer, NoRejection>.Success {value} => match & value.outcome {
      Outcome.Success {value: Value.MemberShape {types}} => {
        let selected = Vector.asSlice<Shared<Type>>(&types)
        if selected.length == usize.ONE {
          return Option.some<Shared<Type>>(Shared.clone<Type>(&selected[0]))
        }
        return Option.none<Shared<Type>>()
      }
      _ => Option.none<Shared<Type>>()
    }
    Result<Answer, NoRejection>.Failure {error: _} => Option.none<Shared<Type>>()
  }
}

fn witnesses(edge: &Edge) -> bool {
  return match & edge.* {
    Edge.Direct => false
    Edge.Witness => true
    Edge.FieldWitness {..} => true
    Edge.Cleanup {..} => false
  }
}

effect fn provesField(edge: &Edge, outer: &Shared<Type>, inner: &Shared<Type>) -> bool
! OutOfMemoryError
? &mut Allocator {
  if let Edge.FieldWitness {field} = &edge.* {
    if !run Type.runtimeEqualsShared(outer, &field.owner) {
      return false
    }
    if run Type.runtimeEqualsShared(outer, inner) {
      return false
    }
    if run Type.runtimeEqualsShared(inner, &field.field) {
      return true
    }
    return run Type.strictRuntimeSubterm(inner, &field.field)
  }
  return false
}

effect fn fieldOnPath(
  active: &[Step],
  ancestor: usize,
  edge: &Edge,
  outer: &Shared<Type>,
  inner: &Shared<Type>,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  if run provesField(edge, outer, inner) {
    return true
  }
  let mut at = ancestor + usize.ONE
  while at < active.length {
    if run provesField(&active[at].edge, outer, inner) {
      return true
    }
    at = at + usize.ONE
  }
  return false
}

// A concrete witness may move through a bounded helper to a strictly smaller structural type.
// Other type arguments must stay fixed or descend; hidden Effect families may change when some
// concrete argument strictly descends. Rows and exact named representations never grant descent.
effect fn witnessDescent(
  ancestor: &Application,
  requested: &Application,
  active: &[Step],
  ancestorAt: usize,
  edge: &Edge,
) -> bool ! OutOfMemoryError ? &mut Allocator {
  let ancestorBindings = run Application.bindings(ancestor)
  let requestedBindings = run Application.bindings(requested)
  let first = Vector.asSlice<Binding>(&ancestorBindings)
  let second = Vector.asSlice<Binding>(&requestedBindings)
  if first.length != second.length {
    return false
  }
  let mut strict = false
  let mut at = usize.ZERO
  while at < first.length {
    if first[at].ordinal != second[at].ordinal || !sameOwner(&first[at].declaration, &second[at].declaration) { return false }
    if run sameArgument(&first[at].value, &second[at].value, true) {
      at = at + usize.ONE
      continue
    }
    if let Argument.Type {value: outer} = &first[at].value {
      if let Argument.Type {value: inner} = &second[at].value {
        if run Type.strictRuntimeSubterm(&inner, &outer) {
          strict = true
          at = at + usize.ONE
          continue
        }
        if run fieldOnPath(active, ancestorAt, edge, &outer, &inner) {
          strict = true
          at = at + usize.ONE
          continue
        }
        if Shared.with<Type, bool>(&outer, opaqueEffect) && Shared.with<Type, bool>(
          &inner,
          opaqueEffect,
        ) {
          at = at + usize.ONE
          continue
        }
      }
    }
    return false
  }
  return strict
}

struct OperationInputs {
  contract: Shared<Type>
  provider: Shared<Type>
}

struct ScopeInputs {
  owner: Shared<DeclarationId>
  count: usize
}

impl Application {
  /// Copies the complete application using scalar/shared reads under short borrows.
  pub effect fn copyShared(source: &Shared<Application>) -> Application ! OutOfMemoryError ? &mut Allocator {
    let copiedDeclaration = run copyApplicationDeclaration(source, false)
    let copiedBody = match move copiedDeclaration {
      Option<DeclarationId>.Some {value} => move value
      _ => { return absurd<Application>() }
    }
    let selectedOperation = run copyApplicationDeclaration(source, true)
    let mut target = Target.Named {declaration: move copiedBody}
    if let Option<DeclarationId>.Some {value: operation} = move selectedOperation {
      let inputs = Shared.with<Application, Option<OperationInputs>>(source, fn(value: &Application) -> Option<OperationInputs> {
        return match &value.target {
          Target.Operation {contract, provider, ..} => Option.some<OperationInputs>(OperationInputs {contract: Shared.clone<Type>(&contract), provider: Shared.clone<Type>(&provider)})
          _ => Option.none<OperationInputs>()
        }
      })
      let bodyOwner = match move target { Target.Named {declaration} => move declaration _ => { return absurd<Application>() } }
      let found = match move inputs { Option<OperationInputs>.Some {value} => move value _ => { return absurd<Application>() } }
      target = Target.Operation {contract: move found.contract, provider: move found.provider, operation: move operation, implementation: move bodyOwner}
    }
    let count = Shared.with<Application, usize>(source, fn(value: &Application) -> usize { return Vector.length<Argument>(&value.arguments) })
    let mut arguments = Vector.make<Argument>()
    let mut ordinals = Vector.make<usize>()
    let mut at = usize.ZERO
    while at < count {
      let value = Shared.with<Application, Argument>(source, fn(value: &Application) -> Argument { let given = Vector.asSlice<Argument>(&value.arguments)
        return Argument.copy(&given[at]) })
      let ordinal = Shared.with<Application, usize>(source, fn(value: &Application) -> usize { return Vector.asSlice<usize>(&value.argumentOrdinals)[at] })
      run Vector.append<Argument>(&mut arguments, move value)
      run Vector.append<usize>(&mut ordinals, ordinal)
      at = at + usize.ONE
    }
    let scopeCount = Shared.with<Application, usize>(source, fn(value: &Application) -> usize { return Vector.length<ScopeBinding>(&value.scopes) })
    let mut scopes = Vector.make<ScopeBinding>()
    at = usize.ZERO
    while at < scopeCount {
      let info = Shared.with<Application, ScopeInputs>(source, fn(value: &Application) -> ScopeInputs {
        let listed = Vector.asSlice<ScopeBinding>(&value.scopes)
        let scope = &listed[at]
        return ScopeInputs {owner: Shared.clone<DeclarationId>(&scope.owner), count: Vector.length<Argument>(&scope.arguments)}
      })
      let mut values = Vector.make<Argument>()
      let mut slots = Vector.make<usize>()
      let mut index = usize.ZERO
      while index < info.count {
        let value = Shared.with<Application, Argument>(source, fn(value: &Application) -> Argument {
          let listed = Vector.asSlice<ScopeBinding>(&value.scopes)
          let scope = &listed[at]
          let given = Vector.asSlice<Argument>(&scope.arguments)
          return Argument.copy(&given[index])
        })
        let ordinal = Shared.with<Application, usize>(source, fn(value: &Application) -> usize {
          let listed = Vector.asSlice<ScopeBinding>(&value.scopes)
          let scope = &listed[at]
          return Vector.asSlice<usize>(&scope.argumentOrdinals)[index]
        })
        run Vector.append<Argument>(&mut values, move value)
        run Vector.append<usize>(&mut slots, ordinal)
        index = index + usize.ONE
      }
      run Vector.append<ScopeBinding>(&mut scopes, ScopeBinding {owner: move info.owner, arguments: move values, argumentOrdinals: move slots})
      at = at + usize.ONE
    }
    let staticCount = Shared.with<Application, usize>(source, fn(value: &Application) -> usize { return Vector.length<StaticSlot>(&value.statics) })
    let mut statics = Vector.make<StaticSlot>()
    at = usize.ZERO
    while at < staticCount {
      let slot = Shared.with<Application, StaticSlot>(source, fn(value: &Application) -> StaticSlot {
        let listed = Vector.asSlice<StaticSlot>(&value.statics)
        return StaticSlot {ordinal: listed[at].ordinal, value: StaticValue.copy(&listed[at].value)}
      })
      run Vector.append<StaticSlot>(&mut statics, move slot)
      at = at + usize.ONE
    }
    return Application {target: move target, arguments: move arguments, argumentOrdinals: move ordinals, scopes: move scopes, statics: move statics}
  }
  /// Counts free own and enclosing arguments in semantic traversal order, including phantom inputs.
  pub fn argumentCount(self: &Self) -> usize { return applicationArgumentCount(self) }
  /// Reads one free own or enclosing argument without borrowing the application.
  pub fn argumentAt(self: &Self, at: usize) -> Option<Argument> { return applicationArgumentAt(self, at) }
  /// Compares declaration, slot and argument-kind structure before binder-aware evidence comparison.
  pub fn sameShape(left: &Self, right: &Self) -> bool { return sameApplicationShape(left, right) }
  /// Compares selected static payloads after application/type borrows have been released.
  pub effect fn staticEquals(left: &Self, right: &Self) -> bool ! OutOfMemoryError ? &mut Allocator {
    return run sameApplicationStatics(left, right)
  }
  /// Number of semantic type positions: argument slots followed by operation contract/provider.
  pub fn typeCount(self: &Self) -> usize {
    let count = applicationArgumentCount(self)
    return match &self.target { Target.Operation {..} => count + 2 _ => count }
  }
  /// Type evidence at one semantic position; lifetime and row argument positions have no type.
  pub fn typeAt(self: &Self, at: usize) -> Option<Shared<Type>> {
    let count = applicationArgumentCount(self)
    if at < count {
      let selected = applicationArgumentAt(self, at)
      if let Option<Argument>.Some {value: Argument.Type {value}} = move selected {
        return Option.some<Shared<Type>>(move value)
      }
      return Option.none<Shared<Type>>()
    }
    if let Target.Operation {contract, provider, ..} = &self.target {
      if at == count { return Option.some<Shared<Type>>(Shared.clone<Type>(&contract)) }
      if at == count + usize.ONE { return Option.some<Shared<Type>>(Shared.clone<Type>(&provider)) }
    }
    return Option.none<Shared<Type>>()
  }
  /// Copies one selected application without changing its semantic arguments.
  pub effect fn copy(self: &Self) -> Application ! OutOfMemoryError ? &mut Allocator {
    return run copyApplication(self)
  }
  /// One exact canonical projection shared by backend equality, interning, symbols and admission.
  /// All validity lifetimes are erased; union and requirement-row members have canonical order.
  pub effect fn runtime(self: &Self) -> Bytes ! OutOfMemoryError ? &mut Allocator {
    let mut coordinates = RuntimeEncoding.coordinates()
    return run Application.encoding(self, false, &mut coordinates)
  }
  pub effect fn encoding(self: &Self, exact: bool, coordinates: &mut Coordinates) -> Bytes
  ! OutOfMemoryError
  ? &mut Allocator {
    let mut output = Bytes.make()
    let owner = Application.bodyDeclaration(self)
    match & self.target {
      Target.Named {declaration} => {
        run RuntimeEncoding.word(&mut output, 0)
        run RuntimeEncoding.declaration(&mut output, &declaration)
      }
      Target.Operation {contract, provider, operation, implementation} => {
        run RuntimeEncoding.word(&mut output, 1)
        run RuntimeEncoding.declaration(&mut output, &operation)
        run RuntimeEncoding.declaration(&mut output, &implementation)
        let contractBytes = run Type.encoding(&contract, owner, exact, &mut coordinates.*)
        let providerBytes = run Type.encoding(&provider, owner, exact, &mut coordinates.*)
        run RuntimeEncoding.field(&mut output, Bytes.asSlice(&contractBytes))
        run RuntimeEncoding.field(&mut output, Bytes.asSlice(&providerBytes))
      }
    }
    let listed = Vector.asSlice<Argument>(&self.arguments)
    let ordinals = Vector.asSlice<usize>(&self.argumentOrdinals)
    run RuntimeEncoding.word(&mut output, usize.toU64(listed.length))
    let mut at = usize.ZERO
    while at < listed.length {
      run RuntimeEncoding.word(&mut output, usize.toU64(ordinals[at]))
      let encoding = run Argument.encoding(&listed[at], owner, exact, &mut coordinates.*)
      run RuntimeEncoding.field(&mut output, Bytes.asSlice(&encoding))
      at = at + usize.ONE
    }
    let scopes = Vector.asSlice<ScopeBinding>(&self.scopes)
    run RuntimeEncoding.word(&mut output, usize.toU64(scopes.length))
    at = usize.ZERO
    while at < scopes.length {
      let scopeOwner = run DeclarationId.copyShared(&scopes[at].owner)
      run RuntimeEncoding.declaration(&mut output, &scopeOwner)
      let values = Vector.asSlice<Argument>(&scopes[at].arguments)
      let slots = Vector.asSlice<usize>(&scopes[at].argumentOrdinals)
      run RuntimeEncoding.word(&mut output, usize.toU64(values.length))
      let mut index = usize.ZERO
      while index < values.length {
        run RuntimeEncoding.word(&mut output, usize.toU64(slots[index]))
        let encoding = run Argument.encoding(&values[index], &scopeOwner, exact, &mut coordinates.*)
        run RuntimeEncoding.field(&mut output, Bytes.asSlice(&encoding))
        index = index + usize.ONE
      }
      at = at + usize.ONE
    }
    // Static values have no runtime lane, so every one is part of the runtime instance identity.
    let statics = Vector.asSlice<StaticSlot>(&self.statics)
    run RuntimeEncoding.word(&mut output, usize.toU64(statics.length))
    at = usize.ZERO
    while at < statics.length {
      run RuntimeEncoding.word(&mut output, usize.toU64(statics[at].ordinal))
      let encoding = run StaticValue.encoding(&statics[at].value, owner, exact, &mut coordinates.*)
      run RuntimeEncoding.field(&mut output, Bytes.asSlice(&encoding))
      at = at + usize.ONE
    }
    return move output
  }
  /// Replaces arguments written in a caller's abstract binders with that caller's instance inputs.
  pub effect fn substitute(self: &Self, caller: &Application) -> Application
  ! OutOfMemoryError ? &mut Allocator {
    let bindings = run Application.bindings(caller)
    return run Application.applyBindings(self, Vector.asSlice<Binding>(&bindings))
  }
  /// Applies recorded owner-qualified evidence simultaneously to own and enclosing inputs.
  pub effect fn applyBindings(self: &Self, given: &[Binding]) -> Application
  ! OutOfMemoryError ? &mut Allocator {
    let target = match &self.target {
      Target.Operation {contract, provider, operation, implementation} => Target.Operation {
        contract: run Type.applyBindings(&contract, given, true),
        provider: run Type.applyBindings(&provider, given, true),
        operation: run DeclarationId.copy(&operation), implementation: run DeclarationId.copy(&implementation),
      }
      Target.Named {declaration} => Target.Named {declaration: run DeclarationId.copy(&declaration)}
    }
    let mut arguments = Vector.make<Argument>()
    let own = Vector.asSlice<Argument>(&self.arguments)
    let mut at = usize.ZERO
    while at < own.length {
      run Vector.append<Argument>(&mut arguments, run Argument.applyBindings(&own[at], given, true))
      at = at + usize.ONE
    }
    let mut scopes = Vector.make<ScopeBinding>()
    let enclosing = Vector.asSlice<ScopeBinding>(&self.scopes)
    at = usize.ZERO
    while at < enclosing.length {
      let mut values = Vector.make<Argument>()
      let previous = Vector.asSlice<Argument>(&enclosing[at].arguments)
      let mut index = usize.ZERO
      while index < previous.length {
        run Vector.append<Argument>(&mut values, run Argument.applyBindings(&previous[index], given, true))
        index = index + usize.ONE
      }
      run Vector.append<ScopeBinding>(&mut scopes, ScopeBinding {owner: Shared.clone<DeclarationId>(&enclosing[at].owner), arguments: move values,
        argumentOrdinals: run copyOrdinals(Vector.asSlice<usize>(&enclosing[at].argumentOrdinals))})
      at = at + usize.ONE
    }
    return Application {target: move target, arguments: move arguments,
      argumentOrdinals: run copyOrdinals(Vector.asSlice<usize>(&self.argumentOrdinals)), scopes: move scopes,
      statics: run copyStatics(Vector.asSlice<StaticSlot>(&self.statics))}
  }
  /// Renames the caller regions of every input through `numbering`, in canonical order: an
  /// operation's contract and provider, own arguments, then enclosing scopes in lexical order.
  ///
  /// # Details
  ///
  /// This is the region part of an instance's canonical identity; see [`Numbering`]. Ordinals,
  /// scope owners and static values are kept. The caller's static roots evaluate a static value
  /// once per body, without instance bindings or loans, and a pure static value holds no
  /// reference, slice, pointer or callable, so it names no caller region.
  pub effect fn numberRegions(self: &Self, numbering: &mut Numbering) -> Application
  ! OutOfMemoryError ? &mut Allocator {
    let owner = body(self)
    let mut target = Target.Named {declaration: run DeclarationId.copy(owner)}
    if let Target.Operation {contract, provider, operation, implementation} = &self.target {
      let numberedContract = run Type.numberRegions(&contract, owner, &mut numbering.*)
      let numberedProvider = run Type.numberRegions(&provider, owner, &mut numbering.*)
      target = Target.Operation {contract: move numberedContract, provider: move numberedProvider,
        operation: run DeclarationId.copy(&operation), implementation: run DeclarationId.copy(&implementation)}
    }
    let mut arguments = Vector.make<Argument>()
    let own = Vector.asSlice<Argument>(&self.arguments)
    let mut at = usize.ZERO
    while at < own.length {
      run Vector.append<Argument>(&mut arguments, run Argument.numberRegions(&own[at], owner, &mut numbering.*))
      at = at + usize.ONE
    }
    let mut scopes = Vector.make<ScopeBinding>()
    let enclosing = Vector.asSlice<ScopeBinding>(&self.scopes)
    at = usize.ZERO
    while at < enclosing.length {
      let mut values = Vector.make<Argument>()
      let previous = Vector.asSlice<Argument>(&enclosing[at].arguments)
      let mut index = usize.ZERO
      while index < previous.length {
        run Vector.append<Argument>(&mut values, run Argument.numberRegions(&previous[index], owner, &mut numbering.*))
        index = index + usize.ONE
      }
      run Vector.append<ScopeBinding>(&mut scopes, ScopeBinding {owner: Shared.clone<DeclarationId>(&enclosing[at].owner), arguments: move values,
        argumentOrdinals: run copyOrdinals(Vector.asSlice<usize>(&enclosing[at].argumentOrdinals))})
      at = at + usize.ONE
    }
    return Application {target: move target, arguments: move arguments,
      argumentOrdinals: run copyOrdinals(Vector.asSlice<usize>(&self.argumentOrdinals)), scopes: move scopes,
      statics: run copyStatics(Vector.asSlice<StaticSlot>(&self.statics))}
  }
  /// The exact simultaneous binding environment for signature, body and layout substitution.
  pub effect fn bindings(self: &Self) -> Vector<Binding> ! OutOfMemoryError ? &mut Allocator {
    let mut output = Vector.make<Binding>()
    let owner = run Shared.make<DeclarationId>(run DeclarationId.copy(body(self)))
    let values = Vector.asSlice<Argument>(&self.arguments)
    let ordinals = Vector.asSlice<usize>(&self.argumentOrdinals)
    let mut at = usize.ZERO
    while at < values.length {
      run Vector.append<Binding>(&mut output, Binding {declaration: Shared.clone<DeclarationId>(&owner),
        ordinal: ordinals[at], value: Argument.copy(&values[at])})
      at = at + usize.ONE
    }
    let scopes = Vector.asSlice<ScopeBinding>(&self.scopes)
    at = usize.ZERO
    while at < scopes.length {
      let given = Vector.asSlice<Argument>(&scopes[at].arguments)
      let slots = Vector.asSlice<usize>(&scopes[at].argumentOrdinals)
      let mut index = usize.ZERO
      while index < given.length {
        run Vector.append<Binding>(&mut output, Binding {declaration: Shared.clone<DeclarationId>(&scopes[at].owner),
          ordinal: slots[index], value: Argument.copy(&given[index])})
        index = index + usize.ONE
      }
      at = at + usize.ONE
    }
    return move output
  }
  /// Original dense ordinals for declarations whose own binder list has no restated owner slots.
  pub effect fn denseOrdinals(count: usize) -> Vector<usize> ! OutOfMemoryError ? &mut Allocator {
    let mut output = Vector.make<usize>()
    let mut at = usize.ZERO
    while at < count {
      run Vector.append<usize>(&mut output, at)
      at = at + usize.ONE
    }
    return move output
  }
  /// Compares full source validity and selected operation evidence.
  pub effect fn equals(left: &Self, right: &Self) -> bool ! OutOfMemoryError ? &mut Allocator {
    return run sameApplication(left, right, false)
  }
  /// Compares code identities after lifetime erasure only.
  pub effect fn runtimeEquals(left: &Self, right: &Self) -> bool ! OutOfMemoryError ? &mut Allocator {
    return run sameApplication(left, right, true)
  }
  /// Whether two applications share their target, binding layout and static values, and every
  /// non-type binding is runtime-equal: only their type arguments may differ.
  pub effect fn sameNonTypeArguments(older: &Self, newer: &Self) -> bool ! OutOfMemoryError ? &mut Allocator {
    if !DeclarationId.equals(body(older), body(newer)) { return false }
    if let Target.Operation {..} = &newer.target {
      if !run sameTarget(&older.target, &newer.target, true) { return false }
    }
    if !run sameApplicationStatics(older, newer) { return false }
    let olderBindings = run Application.bindings(older)
    let newerBindings = run Application.bindings(newer)
    let first = Vector.asSlice<Binding>(&olderBindings)
    let second = Vector.asSlice<Binding>(&newerBindings)
    if first.length != second.length { return false }
    let mut at = usize.ZERO
    while at < first.length {
      if first[at].ordinal != second[at].ordinal || !sameOwner(&first[at].declaration, &second[at].declaration) { return false }
      if !typeArgument(&first[at].value) || !typeArgument(&second[at].value) {
        if !run sameArgument(&first[at].value, &second[at].value, true) { return false }
      }
      at = at + usize.ONE
    }
    return true
  }
  /// Whether all type, row, and selected-operation evidence is concrete for runtime use.
  /// Lifetime validity remains the responsibility of source typing and conformance proof.
  pub fn isRuntimeClosed(self: &Self) -> bool {
    return closed(self)
  }
  /// The concrete body requested by this application.
  pub fn bodyDeclaration(self: &Self) -> &DeclarationId {
    return body(self)
  }
}

impl Pool {
  pub fn make() -> Pool {
    return Pool {semantic: Vector.make<Application>(), runtime: Vector.make<Application>()}
  }
  /// Returns no identity when source selection has left a type or row abstract.
  pub effect fn intern(self: &mut Self, application: &Application) -> Option<Identity>
  ! OutOfMemoryError
  ? &mut Allocator {
    if !closed(application) {
      return Option.none<Identity>()
    }
    let semantic = Vector.asSlice<Application>(&self.semantic)
    let mut semanticAt = usize.ZERO
    while semanticAt < semantic.length {
      if run sameApplication(&semantic[semanticAt], application, false) {
        break
      }
      semanticAt = semanticAt + usize.ONE
    }
    if semanticAt == semantic.length {
      run Vector.append<Application>(&mut self.semantic, run copyApplication(application))
    }
    let runtime = Vector.asSlice<Application>(&self.runtime)
    let mut runtimeAt = usize.ZERO
    while runtimeAt < runtime.length {
      if run sameApplication(&runtime[runtimeAt], application, true) {
        break
      }
      runtimeAt = runtimeAt + usize.ONE
    }
    if runtimeAt == runtime.length {
      run Vector.append<Application>(&mut self.runtime, run copyApplication(application))
    }
    return Option.some<Identity>(Identity {semantic: semanticAt, runtime: runtimeAt})
  }
  pub fn semanticCount(self: &Self) -> usize {
    return Vector.length<Application>(&self.semantic)
  }
  pub fn runtimeCount(self: &Self) -> usize {
    return Vector.length<Application>(&self.runtime)
  }
}

impl FieldDescent {
  /// Resolves one actual struct field under its concrete owner application. No unrelated nominal
  /// type can provide a field edge, and a failed member demand supplies no evidence.
  pub effect fn fromMember(
    semantic: &mut Semantic,
    request: &mut Request,
    declaration: &DeclarationId,
    owner: &Shared<Type>,
    member: usize,
  ) -> Option<FieldDescent>
  ! Cycle | InvalidModulePath | RevisionMismatch | OutOfMemoryError
  ? &mut Allocator {
    if DeclarationId.kind(declaration) != OwnerKind.Struct || !Shared.with<Type, bool>(
      owner,
      fn(value: &Type) -> bool {
        return match & value.* {
          Type.Nominal {declaration: selected, ..} => DeclarationId.equals(&selected, declaration)
          _ => false
        }
      },
    ) {
      return Option.none<FieldDescent>()
    }
    let answer = run Semantic.demandMemberShape(
      &mut semantic.*,
      &mut request.*,
      DeclarationId.moduleId(declaration),
      DeclarationId.spelling(declaration),
      member,
      owner,
    )
    let field = Shared.with<Result<Answer, NoRejection>, Option<Shared<Type>>>(
      &answer,
      selectedField,
    )
    if let Option<Shared<Type>>.Some {value: selected} = move field {
      if run Type.runtimeEqualsShared(owner, &selected) {
        return Option.none<FieldDescent>()
      }
      return Option.some<FieldDescent>(
        FieldDescent {owner: Shared.clone<Type>(owner), field: move selected},
      )
    }
    return Option.none<FieldDescent>()
  }
}

impl Admission {
  pub fn make() -> Admission {
    return Admission {active: Vector.make<Step>()}
  }
  /// A copy of the active path, so a closure transaction checks growth from the same ancestors.
  pub effect fn copy(self: &Self) -> Admission ! OutOfMemoryError ? &mut Allocator {
    let mut active = Vector.make<Step>()
    let listed = Vector.asSlice<Step>(&self.active)
    let mut at = usize.ZERO
    while at < listed.length {
      run Vector.append<Step>(&mut active, Step {application: run copyApplication(&listed[at].application), edge: Edge.copy(&listed[at].edge)})
      at = at + usize.ONE
    }
    return Admission {active: move active}
  }
  /// The active applications from the outermost ancestor to the innermost.
  pub effect fn path(self: &Self) -> Vector<Application> ! OutOfMemoryError ? &mut Allocator {
    let mut path = Vector.make<Application>()
    let listed = Vector.asSlice<Step>(&self.active)
    let mut at = usize.ZERO
    while at < listed.length {
      run Vector.append<Application>(&mut path, run copyApplication(&listed[at].application))
      at = at + usize.ONE
    }
    return move path
  }
  /// The edges that reached the active applications, in [`Admission.path`] order.
  pub effect fn edges(self: &Self) -> Vector<Edge> ! OutOfMemoryError ? &mut Allocator {
    let mut edges = Vector.make<Edge>()
    let listed = Vector.asSlice<Step>(&self.active)
    let mut at = usize.ZERO
    while at < listed.length {
      run Vector.append<Edge>(&mut edges, Edge.copy(&listed[at].edge))
      at = at + usize.ONE
    }
    return move edges
  }
  /// Follows an edge already covered by finite evidence: a changing-static closure certificate or
  /// a cleanup measure.
  pub effect fn enterChain(self: &mut Self, application: &Application, edge: Edge) -> () ! OutOfMemoryError ? &mut Allocator {
    run Vector.append<Step>(&mut self.active, Step {application: run copyApplication(application), edge: move edge})
    return ()
  }
  /// Checks the active path before following this application's body. Field descent requires an
  /// actual resolved member edge; direct calls alone cannot change recursive arguments.
  pub effect fn enter(self: &mut Self, application: &Application, edge: Edge) -> Decision
  ! OutOfMemoryError
  ? &mut Allocator {
    if !closed(application) {
      return Decision.Open
    }
    let active = Vector.asSlice<Step>(&self.active)
    // The nearest matching frame decides first. Returning to an older, larger application after
    // a witness descent is growth along the intervening cycle, even if that older key is cached.
    let mut at = active.length
    while at > usize.ZERO {
      at = at - usize.ONE
      if run sameFamily(&active[at].application, application) {
        if run sameApplication(&active[at].application, application, true) {
          return Decision.Reused {ancestor: at}
        }
        if run sameExceptStatics(&active[at].application, application) {
          return Decision.ChangingStatic {ancestor: at}
        }
        // Re-entry whose arguments all equal or sit strictly inside the ancestor's descends a
        // finite structure (bootstrap `structurallyDescending`).
        if run descends(&active[at].application, application) { break }
        let mut witness = witnesses(&edge)
        let mut pathAt = at + usize.ONE
        while pathAt < active.length {
          witness = witness || witnesses(&active[pathAt].edge)
          pathAt = pathAt + usize.ONE
        }
        if !witness || !run witnessDescent(&active[at].application, application, active, at, &edge) {
          let mut path = Vector.make<Application>()
          pathAt = at
          while pathAt < active.length {
            run Vector.append<Application>(
              &mut path,
              run copyApplication(&active[pathAt].application),
            )
            pathAt = pathAt + usize.ONE
          }
          run Vector.append<Application>(&mut path, run copyApplication(application))
          return Decision.Rejected {path: move path}
        }
      }
      // An argument-free application's body selects the same descendants on every path, so
      // older frames cannot feed growth below it: a recursion through it returns to it as reuse.
      if argumentFree(&active[at].application) { break }
    }
    run Vector.append<Step>(
      &mut self.active,
      Step {application: run copyApplication(application), edge: move edge},
    )
    return Decision.Entered
  }
  /// Finishes one entered application after its requested children have been checked.
  pub fn leave(self: &mut Self) -> () {
    let count = Vector.length<Step>(&self.active)
    if count > usize.ZERO {
      Vector.truncate<Step>(&mut self.active, count - usize.ONE)
    }
  }
}

// Every runtime type argument, paired by declaration ordinal, equals the ancestor's or is a strict
// runtime subterm of it, and at least one is strict.
effect fn descends(older: &Application, newer: &Application) -> bool ! OutOfMemoryError ? &mut Allocator {
  let next = Vector.asSlice<Argument>(&newer.arguments)
  let nextOrdinals = Vector.asSlice<usize>(&newer.argumentOrdinals)
  let previous = Vector.asSlice<Argument>(&older.arguments)
  let previousOrdinals = Vector.asSlice<usize>(&older.argumentOrdinals)
  if typeArgumentCount(next) != typeArgumentCount(previous) { return false }
  let mut strict = false
  let mut at = usize.ZERO
  while at < next.length && at < nextOrdinals.length {
    if let Argument.Type {value: current} = &next[at] {
      let mut paired = false
      let mut other = usize.ZERO
      while other < previous.length && other < previousOrdinals.length {
        if previousOrdinals[other] == nextOrdinals[at] {
          if let Argument.Type {value: prior} = &previous[other] {
            paired = true
            if !run Type.runtimeEqualsShared(&prior, &current) {
              if !run Type.strictRuntimeSubterm(&current, &prior) { return false }
              strict = true
            }
          }
        }
        other = other + usize.ONE
      }
      if !paired { return false }
    }
    at = at + usize.ONE
  }
  return strict
}

// One recursion family: a declaration together with the target declarations of the exact
// callable representations it receives (bootstrap `recursionFamily`). Targets are finite, so a
// family is; a provider's distinct callable selects a different body and is not re-entry.
effect fn sameFamily(left: &Application, right: &Application) -> bool ! OutOfMemoryError ? &mut Allocator {
  if !DeclarationId.equals(body(left), body(right)) { return false }
  let previous = Vector.asSlice<Argument>(&left.arguments)
  let previousOrdinals = Vector.asSlice<usize>(&left.argumentOrdinals)
  let next = Vector.asSlice<Argument>(&right.arguments)
  let nextOrdinals = Vector.asSlice<usize>(&right.argumentOrdinals)
  let mut at = usize.ZERO
  while at < next.length && at < nextOrdinals.length {
    if let Argument.Type {value: current} = &next[at] {
      let mut other = usize.ZERO
      while other < previous.length && other < previousOrdinals.length {
        if previousOrdinals[other] == nextOrdinals[at] {
          if let Argument.Type {value: prior} = &previous[other] {
            if !run sameCallableTarget(&prior, &current) { return false }
          }
        }
        other = other + usize.ONE
      }
    }
    at = at + usize.ONE
  }
  return true
}

effect fn sameCallableTarget(left: &Shared<Type>, right: &Shared<Type>) -> bool ! OutOfMemoryError ? &mut Allocator {
  let leftTarget = Shared.with<Type, Option<Shared<Application>>>(left, callableTarget)
  let rightTarget = Shared.with<Type, Option<Shared<Application>>>(right, callableTarget)
  return match &leftTarget {
    Option<Shared<Application>>.Some {value: prior} => match &rightTarget {
      Option<Shared<Application>>.Some {value: current} => run sameTargetBody(&prior, &current)
      Option<Shared<Application>>.None => false
    }
    Option<Shared<Application>>.None => match &rightTarget { Option<Shared<Application>>.Some {..} => false _ => true }
  }
}

// Extract each declaration before inspecting the other application: both handles may alias.
effect fn sameTargetBody(left: &Shared<Application>, right: &Shared<Application>) -> bool
! OutOfMemoryError ? &mut Allocator {
  let first = run copyApplicationDeclaration(left, false)
  let second = run copyApplicationDeclaration(right, false)
  if let Option<DeclarationId>.Some {value: previous} = move first {
    if let Option<DeclarationId>.Some {value: current} = move second {
      return DeclarationId.equals(&previous, &current)
    }
  }
  return false
}

fn callableTarget(value: &Type) -> Option<Shared<Application>> {
  return match &value.* {
    Type.CallableValue {application, ..} => Option.some<Shared<Application>>(Shared.clone<Application>(&application))
    _ => Option.none<Shared<Application>>()
  }
}

fn argumentFree(application: &Application) -> bool {
  return Vector.length<Argument>(&application.arguments) == usize.ZERO
    && Vector.length<ScopeBinding>(&application.scopes) == usize.ZERO
    && Vector.length<StaticSlot>(&application.statics) == usize.ZERO
}

fn typeArgument(value: &Argument) -> bool {
  return match &value.* { Argument.Type {..} => true _ => false }
}

fn typeArgumentCount(arguments: &[Argument]) -> usize {
  let mut count = usize.ZERO
  let mut at = usize.ZERO
  while at < arguments.length {
    if let Argument.Type {..} = &arguments[at] { count = count + usize.ONE }
    at = at + usize.ONE
  }
  return count
}

impl Edge {
  /// Copies the path evidence without reading a body or resolving new conformance evidence.
  pub fn copy(self: &Self) -> Edge {
    return match & self.* {
      Edge.Direct => Edge.Direct
      Edge.Witness => Edge.Witness
      Edge.FieldWitness {field} => Edge.FieldWitness {
        field: FieldDescent {
          owner: Shared.clone<Type>(&field.owner),
          field: Shared.clone<Type>(&field.field),
        },
      }
      Edge.Cleanup {owner} => Edge.Cleanup {owner: Shared.clone<Type>(&owner)}
    }
  }
}

fn applicationDeclarationProjection(value: &Application, part: DeclarationPart, owner: usize, offset: usize, operation: bool) -> Option<
  DeclarationProjection,
> {
  if !operation { return Option.some<DeclarationProjection>(DeclarationId.project(body(value), part, owner, offset)) }
  return match &value.target {
    Target.Operation {operation: selected, ..} => Option.some<DeclarationProjection>(DeclarationId.project(&selected, part, owner, offset))
    Target.Named {..} => Option.none<DeclarationProjection>()
  }
}

effect fn copyApplicationDeclaration(source: &Shared<Application>, operation: bool) -> Option<DeclarationId>
! OutOfMemoryError
? &mut Allocator {
  let mut components = Vector.make<Bytes>()
  let mut section = usize.ZERO
  while section < 3 {
    let mut part = DeclarationPart.Path
    if section == usize.ZERO {
      part = DeclarationPart.Origin
    }
    if section == usize.ONE {
      part = DeclarationPart.Package
    }
    let measured = Shared.with<Application, Option<DeclarationProjection>>(
      source,
      fn(value: &Application) -> Option<DeclarationProjection> {
        return applicationDeclarationProjection(value, part, usize.MAX, usize.MAX, operation)
      },
    )
    let count = match move measured {
      Option<DeclarationProjection>.Some {value: field} => field.length
      Option<DeclarationProjection>.None => {
        return Option.none<DeclarationId>()
      }
    }
    let mut bytes = run Bytes.zeroed(count)
    let target = Bytes.asMutSlice(&mut bytes)
    let mut offset = usize.ZERO
    while offset < count {
      let selected = Shared.with<Application, Option<DeclarationProjection>>(
        source,
        fn(value: &Application) -> Option<DeclarationProjection> {
          return applicationDeclarationProjection(value, part, usize.MAX, offset, operation)
        },
      )
      match move selected {
        Option<DeclarationProjection>.Some {value: field} => {
          target[offset] = field.byte
        }
        Option<DeclarationProjection>.None => {
          return absurd<Option<DeclarationId>>()
        }
      }
      offset = offset + usize.ONE
    }
    run Vector.append<Bytes>(&mut components, move bytes)
    section = section + usize.ONE
  }
  let measured = Shared.with<Application, Option<DeclarationProjection>>(
    source,
    fn(value: &Application) -> Option<DeclarationProjection> {
      return applicationDeclarationProjection(value, DeclarationPart.Owners, usize.MAX, usize.MAX, operation)
    },
  )
  let count = match move measured {
    Option<DeclarationProjection>.Some {value: field} => field.length
    Option<DeclarationProjection>.None => {
      return absurd<Option<DeclarationId>>()
    }
  }
  let mut owners = Vector.make<OwnerStep>()
  let mut at = usize.ZERO
  while at < count {
    let selected = Shared.with<Application, Option<DeclarationProjection>>(
      source,
      fn(value: &Application) -> Option<DeclarationProjection> {
        return applicationDeclarationProjection(value, DeclarationPart.Owners, at, usize.MAX, operation)
      },
    )
    let step = match move selected {
      Option<DeclarationProjection>.Some {value: field} => field
      Option<DeclarationProjection>.None => {
        return absurd<Option<DeclarationId>>()
      }
    }
    let mut name = Option.none<Bytes>()
    if step.named {
      let mut bytes = run Bytes.zeroed(step.length)
      let target = Bytes.asMutSlice(&mut bytes)
      let mut offset = usize.ZERO
      while offset < step.length {
        let selected = Shared.with<Application, Option<DeclarationProjection>>(
          source,
          fn(value: &Application) -> Option<DeclarationProjection> {
            return applicationDeclarationProjection(value, DeclarationPart.Owners, at, offset, operation)
          },
        )
        match move selected {
          Option<DeclarationProjection>.Some {value: field} => {
            target[offset] = field.byte
          }
          Option<DeclarationProjection>.None => {
            return absurd<Option<DeclarationId>>()
          }
        }
        offset = offset + usize.ONE
      }
      name = Option.some<Bytes>(move bytes)
    }
    run Vector.append<OwnerStep>(
      &mut owners,
      OwnerStep {kind: step.kind, occurrence: step.occurrence, name: move name},
    )
    at = at + usize.ONE
  }
  let path = match move Vector.pop<Bytes>(&mut components) {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => {
      return absurd<Option<DeclarationId>>()
    }
  }
  let package = match move Vector.pop<Bytes>(&mut components) {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => {
      return absurd<Option<DeclarationId>>()
    }
  }
  let origin = match move Vector.pop<Bytes>(&mut components) {
    Option<Bytes>.Some {value} => move value
    Option<Bytes>.None => {
      return absurd<Option<DeclarationId>>()
    }
  }
  let assembled = run Effect.result(ModuleId.fromParts(move origin, move package, move path))
  let module = match move assembled {
    Result<ModuleId, InvalidModulePath>.Success {value} => move value
    Result<ModuleId, InvalidModulePath>.Failure {error: _} => { return absurd<Option<DeclarationId>>() }
  }
  return Option.some<DeclarationId>(DeclarationId.fromParts(move module, move owners))
}

fn absurd<T>() -> T {
  let boom = 1 / 0
  return absurd<T>()
}
