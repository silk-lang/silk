//! Finite representation evidence for ordinary opaque producer applications.
//! Producer bodies supply exact leaves or forwarding families. Solving the graph never demands
//! another producer query, so recursive forwarding can acquire a concrete leaf without a query cycle.

import semantic.Types {Types}
import lexer.Span {Span}
import semantic.Type {Type}
import silk.allocator {Allocator, OutOfMemoryError}
import silk.option {Option}
import silk.result {Result}
import silk.shared {Shared}
import silk.usize
import silk.vector {Vector}

/// One reachable returned representation, preserving its source location.
pub struct Evidence {
  pub ty: Shared<Type>
  pub span: Span
}

/// A complete producer family and the evidence gathered from its selected checked body.
pub struct Producer {
  pub family: Shared<Type>
  pub anchor: Span
  pub evidence: Vector<Evidence>
}

/// One representation selected by all reachable returns of a producer.
pub struct Realization {
  pub family: Shared<Type>
  pub storage: Shared<Type>
}

/// The existing language reasons a finite producer graph cannot establish one representation.
pub enum FailureKind { Divergent, Cycle, Missing }

/// An anchored graph rejection; the semantic query retains the producer's source module.
pub struct Failure {
  pub kind: FailureKind
  pub producer: usize
}

struct Leaves {
  values: Vector<Shared<Type>>
}

/// Finds a complete semantic family, including selected validity and enclosing owner evidence.
pub effect fn indexOf(producers: &[Producer], family: &Shared<Type>) -> Option<usize>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut at = usize.ZERO
  while at < producers.length {
    if run Type.equalsShared(&producers[at].family, family) { return Option<usize>.some(at) }
    at = at + usize.ONE
  }
  return Option<usize>.none()
}

fn opaque(value: &Type) -> bool { return match &value.* { Type.OpaqueRepresentation {..} => true _ => false } }

effect fn insert(values: &mut Vector<Shared<Type>>, value: &Shared<Type>) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let listed = Vector<Shared<Type>>.asSlice(&values.*)
  let mut at = usize.ZERO
  while at < listed.length {
    if run Type.equalsShared(&listed[at], value) { return false }
    at = at + usize.ONE
  }
  run Vector<Shared<Type>>.append(&mut values.*, Shared<Type>.clone(value))
  return true
}

// Only zero-leaf forwarding vertices participate. Reaching the starting vertex distinguishes
// membership of a leafless recursive component from an upstream producer with missing evidence.
effect fn cyclic(producers: &[Producer], leaves: &[Leaves], start: usize) -> bool
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut pending = Vector<usize>.make()
  run Vector<usize>.append(&mut pending, start)
  let mut at = usize.ZERO
  while at < Vector<usize>.length(&pending) {
    let selected = Vector<usize>.get(&pending, at)
    let evidence = Vector<Evidence>.asSlice(&producers[selected].evidence)
    let mut edge = usize.ZERO
    while edge < evidence.length {
      let target = run indexOf(producers, &evidence[edge].ty)
      if let Option<usize>.Some {value} = move target {
        if Vector<Shared<Type>>.length(&leaves[value].values) == usize.ZERO {
          if value == start { return true }
          let seen = Vector<usize>.asSlice(&pending)
          let mut previous = usize.ZERO
          let mut known = false
          while previous < seen.length {
            if seen[previous] == value { known = true }
            previous = previous + usize.ONE
          }
          if !known { run Vector<usize>.append(&mut pending, value) }
        }
      }
      edge = edge + usize.ONE
    }
    at = at + usize.ONE
  }
  return false
}

/// Propagates concrete leaves to a fixed point, preserving exact semantic identity.
/// Storage capture recursion is validated separately after these forwarding leaves are known.
pub effect fn solve(producers: &[Producer]) -> Result<Vector<Realization>, Failure>
! OutOfMemoryError ? &mut Allocator | &mut Types {
  let mut leaves = Vector<Leaves>.make()
  let mut at = usize.ZERO
  while at < producers.length {
    let mut values = Vector<Shared<Type>>.make()
    let evidence = Vector<Evidence>.asSlice(&producers[at].evidence)
    let mut edge = usize.ZERO
    while edge < evidence.length {
      if !Shared<Type>.with<bool>(&evidence[edge].ty, opaque) { drop run insert(&mut values, &evidence[edge].ty) }
      edge = edge + usize.ONE
    }
    run Vector<Leaves>.append(&mut leaves, Leaves {values: move values})
    at = at + usize.ONE
  }
  let mut changed = true
  while changed {
    changed = false
    at = usize.ZERO
    while at < producers.length {
      let mut additions = Vector<Shared<Type>>.make()
      let evidence = Vector<Evidence>.asSlice(&producers[at].evidence)
      let mut edge = usize.ZERO
      while edge < evidence.length {
        let target = run indexOf(producers, &evidence[edge].ty)
        if let Option<usize>.Some {value} = move target {
          let existing = Vector<Leaves>.asSlice(&leaves)
          let values = Vector<Shared<Type>>.asSlice(&existing[value].values)
          let mut leaf = usize.ZERO
          while leaf < values.length {
            run Vector<Shared<Type>>.append(&mut additions, Shared<Type>.clone(&values[leaf]))
            leaf = leaf + usize.ONE
          }
        }
        edge = edge + usize.ONE
      }
      let listed = Vector<Shared<Type>>.asSlice(&additions)
      let mut leaf = usize.ZERO
      while leaf < listed.length {
        let mut slots = Vector<Leaves>.asMutSlice(&mut leaves)
        if run insert(&mut slots[at].values, &listed[leaf]) { changed = true }
        leaf = leaf + usize.ONE
      }
      at = at + usize.ONE
    }
  }
  let values = Vector<Leaves>.asSlice(&leaves)
  // Diagnose a reachable leafless recursive component before its upstream missing producer.
  at = usize.ZERO
  while at < producers.length {
    if Vector<Shared<Type>>.length(&values[at].values) == usize.ZERO
      && run cyclic(producers, values, at) {
      return Result<Vector<Realization>, Failure>.failResult(Failure {kind: FailureKind.Cycle, producer: at})
    }
    at = at + usize.ONE
  }
  let mut output = Vector<Realization>.make()
  at = usize.ZERO
  while at < producers.length {
    let selected = Vector<Shared<Type>>.asSlice(&values[at].values)
    if selected.length > usize.ONE {
      return Result<Vector<Realization>, Failure>.failResult(Failure {kind: FailureKind.Divergent, producer: at})
    }
    if selected.length == usize.ZERO {
      return Result<Vector<Realization>, Failure>.failResult(Failure {kind: FailureKind.Missing, producer: at})
    }
    run Vector<Realization>.append(&mut output, Realization {
      family: Shared<Type>.clone(&producers[at].family), storage: Shared<Type>.clone(&selected[usize.ZERO])})
    at = at + usize.ONE
  }
  return Result<Vector<Realization>, Failure>.succeed(move output)
}
