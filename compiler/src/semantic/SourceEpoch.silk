//! One immutable source mapping and its ready parsed payloads for independent semantic workers.
//!
//! The driver finishes its lazy host snapshot before making this epoch. No epoch operation reads
//! a filesystem: a missing mapping stays absent for this epoch. Target/profile/application are
//! held by the worker registry, not by this syntax-only cache. Keep an epoch handle, not just its
//! address, whenever its identity authenticates an imported result.
import semantic.Published {Published}
import semantic.SourceRevision {Revision}
import semantic.SourceIndex {ParsedSource}
import semantic.SourceUnit {SourceUnit}
import semantic.ModuleId {ModuleId}
import silk.concurrency.sync {Mutex}
import silk.collections.list {List}
import silk.core.option {Option}
import silk.mem.allocator {Allocator, OutOfMemoryError}
import silk.num.usize

struct ParsedSlot {
  ready: Option<Published<ParsedSource>>,
  offered: Option<SourceUnit>,
}
struct Epoch {
  revision: Revision,
  // Fixed capacity and length, allocated before publication. Taking an offered parse and
  // cloning/installing a ready payload never allocates or runs a provider under this mutex.
  parsed: Mutex<List<ParsedSlot>>,
}
pub struct SourceEpoch { held: Published<Epoch> }

fn sameBytes(left: &[u8], right: &[u8]) -> bool {
  if left.length != right.length { return false }
  let mut at: usize = 0
  while at < left.length {
    if left[at] != right[at] { return false }
    at = at + 1
  }
  return true
}

impl SourceEpoch {
  pub effect fn make(revision: Revision) -> Self ! OutOfMemoryError ? &mut Allocator {
    let count = Revision.mappingCount(&revision)
    let mut slots = run List<ParsedSlot>.makeWithCapacity(count)
    let mut at: usize = 0
    while at < count {
      run List<ParsedSlot>.append(&mut slots, ParsedSlot {ready: Option<Published<ParsedSource>>.none(), offered: Option<SourceUnit>.none()})
      at = at + 1
    }
    return Self {held: run Published<Epoch>.make(Epoch {revision: move revision,
      parsed: run Mutex<List<ParsedSlot>>.make(move slots)})}
  }
  pub fn clone(self: &Self) -> Self { return Self {held: Published<Epoch>.clone(&self.held)} }
  pub fn same(left: &Self, right: &Self) -> bool { return Published<Epoch>.same(&left.held, &right.held) }
  pub fn identity(self: &Self) -> usize { return Published<Epoch>.address(&self.held) }
  pub fn revision(self: &Self) -> &Revision { return &Published<Epoch>.get(&self.held).revision }

  /// Returns only a complete parse/index publication. A concurrent miss may compute twice;
  /// neither parser runs under the cache lock, and a failure never reserves a visible answer.
  pub fn parsed(self: &Self, id: &ModuleId) -> Option<Published<ParsedSource>> {
    let epoch = Published<Epoch>.get(&self.held)
    if let Option<usize>.Some {value: at} = move Revision.mappingSlot(&epoch.revision, id) {
      let guard = Mutex<List<ParsedSlot>>.lock(&epoch.parsed)
      if let Option<Published<ParsedSource>>.Some {value} = &List<ParsedSlot>.asSlice(guard.get())[at].ready {
        return Option<Published<ParsedSource>>.some(Published<ParsedSource>.clone(&value))
      }
    }
    return Option<Published<ParsedSource>>.none()
  }
  /// Keeps a fully built payload only when its module and exact bytes belong to this epoch.
  /// On a race, returns the first completed publication. Refusal leaves every existing slot intact.
  pub fn keep(self: &Self, source: &Published<ParsedSource>) -> Option<Published<ParsedSource>> {
    let unit = ParsedSource.sourceUnit(Published<ParsedSource>.get(source))
    let epoch = Published<Epoch>.get(&self.held)
    let at = match move Revision.mappingSlot(&epoch.revision, &unit.id) {
      Option<usize>.Some {value} => value
      _ => { return Option<Published<ParsedSource>>.none() }
    }
    let bytes = match move Revision.content(&epoch.revision, &unit.id) {
      Option<&[u8]>.Some {value} => value
      _ => { return Option<Published<ParsedSource>>.none() }
    }
    if !sameBytes(bytes, SourceUnit.bytes(unit)) { return Option<Published<ParsedSource>>.none() }
    let mut guard = Mutex<List<ParsedSlot>>.lock(&epoch.parsed)
    let held = guard.getMut()
    let slots = List<ParsedSlot>.asMutSlice(&mut held.*)
    if let Option<Published<ParsedSource>>.Some {value} = &slots[at].ready {
      return Option<Published<ParsedSource>>.some(Published<ParsedSource>.clone(&value))
    }
    let unused = Intrinsic.replace(slots[at].offered, Option<SourceUnit>.none())
    slots[at].ready = Option<Published<ParsedSource>>.some(Published<ParsedSource>.clone(source))
    drop guard
    drop unused
    return Option<Published<ParsedSource>>.some(Published<ParsedSource>.clone(source))
  }
  /// Accepts an existing driver parse only after exact byte authentication. This does not index
  /// declarations or publish a ready source. Replaced/unused payloads drop after unlocking.
  pub fn offerParsed(self: &Self, unit: SourceUnit) -> () {
    let epoch = Published<Epoch>.get(&self.held)
    let at = match move Revision.mappingSlot(&epoch.revision, &unit.id) {
      Option<usize>.Some {value} => value
      _ => { return () }
    }
    let bytes = match move Revision.content(&epoch.revision, &unit.id) {
      Option<&[u8]>.Some {value} => value
      _ => { return () }
    }
    if !sameBytes(bytes, SourceUnit.bytes(&unit)) { return () }
    let mut guard = Mutex<List<ParsedSlot>>.lock(&epoch.parsed)
    let held = guard.getMut()
    let slots = List<ParsedSlot>.asMutSlice(&mut held.*)
    if let Option<Published<ParsedSource>>.Some {..} = &slots[at].ready { drop guard return () }
    if let Option<SourceUnit>.Some {..} = &slots[at].offered { drop guard return () }
    slots[at].offered = Option<SourceUnit>.some(move unit)
  }
  /// Moves an authenticated offered parse to one worker; other workers may parse the same exact
  /// bytes concurrently, but only complete publications can subsequently be shared.
  pub fn takeParsed(self: &Self, id: &ModuleId) -> Option<SourceUnit> {
    let epoch = Published<Epoch>.get(&self.held)
    let at = match move Revision.mappingSlot(&epoch.revision, id) {
      Option<usize>.Some {value} => value
      _ => { return Option<SourceUnit>.none() }
    }
    let mut guard = Mutex<List<ParsedSlot>>.lock(&epoch.parsed)
    let held = guard.getMut()
    let slots = List<ParsedSlot>.asMutSlice(&mut held.*)
    return Intrinsic.replace(slots[at].offered, Option<SourceUnit>.none())
  }
}
